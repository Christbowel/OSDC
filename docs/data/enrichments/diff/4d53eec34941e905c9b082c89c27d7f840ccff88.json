uringTest(t, utilfeature.DefaultFeatureGate, features.EnableCelExpressions, true)","+\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.RequireCelExpressionOptIn, false)","+","+\tcases := map[string]struct {","+\t\titems string","+\t\twant  string","+\t}{","+\t\t\"a whole expression\":            {items: `\"$(context.appName)\"`, want: `\"web\"`},","+\t\t\"a whole expression for a list\": {items: `\"$([context.appName, \\\"west\\\"])\"`, want: `[\"web\",\"west\"]`},","+\t\t\"expressions inside a list\":     {items: `[\"$(context.appName)-east\", \"$(context.namespace)\"]`, want: `[\"web-east\",\"prod\"]`},","+\t\t\"no expression\":                 {items: `[\"a\", 1]`, want: `[\"a\", 1]`},","+\t}","+\tfor name, tc := range cases {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tsteps := []wfTypesv1alpha1.WorkflowStep{{","+\t\t\t\tWorkflowStepBase: wfTypesv1alpha1.WorkflowStepBase{Name: \"scale\", Type: \"scale-component\"},","+\t\t\t\tForEach:          &wfTypesv1alpha1.ForEach{Items: &apiextensionsv1.JSON{Raw: []byte(tc.items)}},","+\t\t\t}}","+\t\t\taf := &appfile.Appfile{Name: \"web\", Namespace: \"prod\"}","+\t\t\trequire.NoError(t, resolveWorkflowStepSources(af, steps, nil))","+\t\t\trequire.JSONEq(t, tc.want, string(steps[0].ForEach.Items.Raw))","+\t\t})","+\t}","+}","+","+func TestResolveWorkflowStepSourcesRecordsAStepOnce(t *testing.T) {","+\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.EnableCelExpressions, true)","+\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.RequireCelExpressionOptIn, false)","+","+\tsource := func(key, output string) *v1beta1.SourceDefinition {","+\t\treturn &v1beta1.SourceDefinition{Spec: v1beta1.SourceDefinitionSpec{","+\t\t\tSchematic: &common.Schematic{CUE: &common.CUE{","+\t\t\t\tTemplate: \"parameter: {}\\n$internal: {key: \\\"\" + key + \"\\\", keyInputs: []}\\noutput: \" + output,","+\t\t\t}},","+\t\t}}","+\t}","+\taf := &appfile.Appfile{","+\t\tName:      \"web\",","+\t\tNamespace: \"prod\",","+\t\tSources:   []v1beta1.ApplicationSource{{Name: \"app\", Type: \"app-info\"}, {Name: \"inv\", Type: \"inventory\"}},","+\t\tRelatedSourceDefinitions: map[string]*v1beta1.SourceDefinition{","+\t\t\t\"app-info\":  source(\"app-info\", `{component: \"web\"}`),","+\t\t\t\"inventory\": source(\"inventory\", `{regions: [\"east\", \"west\"]}`),","+\t\t},","+\t}","+\tsteps := []wfTypesv1alpha1.WorkflowStep{{","+\t\tWorkflowStepBase: wfTypesv1alpha1.WorkflowStepBase{","+\t\t\tName:       \"scale\",","+\t\t\tType:       \"scale-component\",","+\t\t\tProperties: &runtime.RawExtension{Raw: []byte(`{\"component\":\"$(source.app.component)\"}`)},","+\t\t},","+\t\tForEach: &wfTypesv1alpha1.ForEach{Items: &apiextensionsv1.JSON{Raw: []byte(`\"$(source.inv.regions)\"`)}},","+\t}}","+\tvar records []map[string]sources.SourceResolutionStatus","+\trecord := func(name, _ string, resolved map[string]sources.SourceResolutionStatus) {","+\t\trequire.Equal(t, \"scale\", name)","+\t\trecords = append(records, resolved)","+\t}","+\trequire.NoError(t, resolveWorkflowStepSources(af, steps, record))","+\trequire.JSONEq(t, `{\"component\":\"web\"}`, string(steps[0].Properties.Raw))","+\trequire.JSONEq(t, `[\"east\",\"west\"]`, string(steps[0].ForEach.Items.Raw))","+","+\t// A reader is recorded under its step name, and a second record replaces the first,","+\t// so what the properties read and what forEach.items read must arrive together.","+\trequire.Len(t, records, 1)","+\trequire.Contains(t, records[0], \"app\", \"the properties' read\")","+\trequire.Contains(t, records[0], \"inv\", \"forEach.items' read\")","+\trequire.Contains(t, records[0][\"app\"].ConsumedFields, \"component\")","+\trequire.Contains(t, records[0][\"inv\"].ConsumedFields, \"regions\")","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"pkg/definition/cuetest/checks_test.go","lines":["@@ -17,8 +17,10 @@ limitations unde