 \"inventory\"}},","+\t\t\tWorkflow: &v1beta1.Workflow{","+\t\t\t\tSteps: []wfv1alpha1.WorkflowStep{{","+\t\t\t\t\tWorkflowStepBase: wfv1alpha1.WorkflowStepBase{Name: \"scale\", Type: \"scale-component\"},","+\t\t\t\t\tForEach:          &wfv1alpha1.ForEach{Items: &apiextensionsv1.JSON{Raw: []byte(items)}},","+\t\t\t\t}},","+\t\t\t},","+\t\t},","+\t}","+}","+","+func TestValidateSourcesForEachItems(t *testing.T) {","+\tscheme := runtime.NewScheme()","+\t_ = v1beta1.AddToScheme(scheme)","+\tinventory := &v1beta1.SourceDefinition{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"inventory\", Namespace: \"default\"},","+\t\tSpec: v1beta1.SourceDefinitionSpec{Schematic: &common.Schematic{CUE: &common.CUE{Template: `","+schema: {","+  clusters: [...{name: string}]","+  region:   string","+  extra?:   [...string]","+}","+output: {clusters: [], region: \"eu\"}","+parameter: {}","+`}}},","+\t}","+\thandler := &ValidatingHandler{Client: fake.NewClientBuilder().WithScheme(scheme).WithObjects(inventory).Build()}","+","+\tcases := map[string]struct {","+\t\titems string","+\t\twant  string","+\t}{","+\t\t\"a list-typed read\":                   {items: `\"$(source.inv.clusters)\"`},","+\t\t\"expressions inside a literal list\":   {items: `[\"$(source.inv.region)\", \"west\"]`},","+\t\t\"a literal list\":                      {items: `[\"east\", \"west\"]`},","+\t\t\"a string-typed read\":                 {items: `\"$(source.inv.region)\"`, want: \"spec.workflow.steps[0].forEach.items\"},","+\t\t\"text around an expression\":           {items: `\"x-$(source.inv.region)\"`, want: \"forEach.items expects list\"},","+\t\t\"a read that may be absent\":           {items: `\"$(source.inv.extra)\"`, want: \"source.inv.extra may be absent and feeds forEach.items\"},","+\t\t\"a guarded read that may be absent\":   {items: `\"$(has(source.inv.extra) ? source.inv.extra : [])\"`},","+\t\t\"a path the schema does not have\":     {items: `\"$(source.inv.nosuch)\"`, want: \"spec.workflow.steps[0].f