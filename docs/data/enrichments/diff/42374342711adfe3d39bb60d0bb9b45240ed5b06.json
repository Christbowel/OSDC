\t*copy;","+\tu_char\t*o;","+\tsize_t\t needed, padded, padding;","+\tint\t n;","+","+\tif (size > SIZE_MAX - 3)","+\t\treturn (NULL);","+\tpadding = (4 - size % 4) % 4;","+\tif (padding == 3)","+\t\treturn (NULL);","+\tpadded = size + padding;","+\tneeded = padded / 4 * 3;","+\tif (needed > limit || needed > INT_MAX)","+\t\treturn (NULL);","+","+\tcopy = xmalloc(padded + 1);","+\tmemcpy(copy, data, size);","+\tmemset(copy + size, '=', padding);","+\tcopy[padded] = '\\0';","+","+\tif (needed == 0)","+\t\to = xmalloc(1);","+\telse","+\t\to = xmalloc(needed);","+\tn = b64_pton(copy, o, needed);","+\tfree(copy);","+\tif (n < 0) {","+\t\tfree(o);","+\t\treturn (NULL);","+\t}","+\t*osize = n;","+\treturn (o);","+}","+","+/* Decompress a payload. */","+#ifdef HAVE_LIBZ","+static u_char *","+image_zlib_decode(const u_char *data, size_t size, size_t expected,","+    size_t limit)","+{","+\tu_char\t*r;","+\tuLongf\t rsize;","+","+\tif (expected == 0 ||","+\t    expected > limit ||","+\t    size > limit ||","+\t    expected > ULONG_MAX ||","+\t    size > ULONG_MAX)","+\t\treturn (NULL);","+\trsize = expected;","+","+\tr = xmalloc(expected);","+\tif (uncompress(r, &rsize, data, size) != Z_OK || rsize != expected) {","+\t\tfree(r);","+\t\treturn (NULL);","+\t}","+\treturn (r);","+}","+#else","+static u_char *","+image_zlib_decode(__unused const u_char *data, __unused size_t size,","+    __unused size_t expected, __unused size_t limit)","+{","+\treturn (NULL);","+}","+#endif","+","+/* Decode PNG data into RGBA pixels. */","+#ifdef HAVE_LIBPNG","+u_char *","+image_png_decode(const u_char *data, size_t size, size_t limit, int z,","+    size_t expected, u_int *width, u_int *height)","+{","+\tpng_image\t pi;","+\tu_char\t\t*r = NULL, *p = NULL;","+","+\tif (size == 0 || size > limit)","+\t\treturn (NULL);","+\tif (z) {","+\t\tr = image_zlib_decode(data, size, expected, limit);","+\t\tif (r == NULL)","+\t\t\treturn (NULL);","+\t\tdata = r;","+\t\tsize = expected;","+\t}","+","+\tmemset(&pi, 0, sizeof pi);","+\tpi.version = PNG_IMAGE_VERSION;","+\tif (!png_image_begin_read_from_memory(&pi, data, size))","+\t\tgoto out;","+\tpi.format = PNG_FORMAT_RGBA;","+","+\tif (pi.width == 0 ||","+\t    pi.height == 0 ||","+\t    (uint64_t)pi.width * pi.height > limit / 4)","+\t\tgoto out;","+\tp = xmalloc(PNG_IMAGE_SIZE(pi));","+","+\tif (!png_image_finish_read(&pi, NULL, p, 0, NULL)) {","+\t\tfree(p);","+\t\tp = NULL;","+\t\tgoto out;","+\t}","+","+\t*width = pi.width;","+\t*height = pi.height;","+","+out:","+\tpng_image_free(&pi);","+\tfree(r);","+\treturn (p);","+}","+#else","+u_char *","+image_png_decode(__unused const u_char *data, __unused size_t size,","+    __unused size_t limit, __unused int z, __unused size_t expected,","+    __unused u_int *width, __unused u_int *height)","+{","+\treturn (NULL);","+}","+#endif","+","+/* Decode raw RGB or RGBA data. */","+u_char *","+image_raw_decode(const u_char *data, size_t size, size_t limit, u_int format,","+    u_int width, u_int height, int z)","+{","+\tu_char\t*r = NULL, *o;","+\tsize_t\t expected, i, j;","+\tu_int\t bytes;","+","+\tif (format != 24 && format != 32)","+\t\treturn (NULL);","+","+\tif (width == 0 ||","+\t    height == 0 ||","+\t    size > limit ||","+\t    (uint64_t)width * height > limit / 4)","+\t\treturn (NULL);","+\tbytes = (format == 24 ? 3 : 4);","+\texpected = (size_t)width * height * bytes;","+","+\tif (z) {","+\t\tr = image_zlib_decode(data, size, expected, limit);","+\t\tif (r == NULL)","+\t\t\treturn (NULL);","+\t\tdata = r;","+\t} else {","+\t\tif (size != expected)","+\t\t\treturn (NULL);","+\t}","+","+\tif (bytes == 4) {","+\t\tif (r != NULL)","+\t\t\treturn (r);","+\t\to = xmalloc(expected);","+\t\tmemcpy(o, data, expected);","+\t\treturn (o);","+\t}","+","+\to = xmalloc((size_t)width * height * 4);","+\tfor (i = j = 0; i < expected; i += 3, j += 4) {","+\t\to[j + 0] = data[i + 0];","+\t\to[j + 1] = data[i + 1];","+\t\to[j + 2] = data[i + 2];","+\t\to[j + 3] = 255;","+\t}","+\tfree(r);","+\treturn (o);","+}"],"additions":208,"deletions":0,"truncated":false},{"path":"image-grid.c","lines":["@@ -23,6 +23,9 @@"," "," #include \"tmux.h\""," ","+/* Next image placement index. */","+static uint64_t next_image_placement_index;","+"," /* A run of cells on one grid line. */"," struct image_span {"," \tu_int\t\t\t x;","@@ -41,17 +44,19 @@ TAILQ_HEAD(image_spans, image_span);"," /* Spans on one grid line. */"," struct image_line {"," \tstruct image_spans\t spans;","+\tint\t\t\t in_region; /* Inside the current scroll region. */"," };"," "," /* A placement of an image, may be across multiple lines */"," struct image_placement {"," \tstruct image_store\t\t*store;"," \tstruct image\t\t\t*image;","+\tuint64_t\t\t\t index;"," \tstruct image_spans\t\t spans;"," ","-\t/* Original column and first source column not yet placed. */"," \tu_int\t\t\t\t x;"," \tu_int\t\t\t\t recover_from;","+\tint\t\t\t\t scroll; /* -1 unchecked, 0 fixed, 1 moving. */"," "," \tTAILQ_ENTRY(image_placement)\t entry;"," };","@@ -67,6 +72,16 @@ TAILQ_HEAD(image_stores, image_store);"," /* All current placements. */"," static struct image_stores image_stores = TAILQ_HEAD_INITIALIZER(image_stores);"," ","+/* Images saved while grid lines are moved. */","+struct image_saved {","+\tu_int\t\t\t  dy;","+\tu_int\t\t\t  py;","+\tu_int\t\t\t  ny;","+\tu_int\t\t\t  hsize;","+\tint\t\t\t  scroll;","+\tstruct image_line\t**lines;","+};","+"," /* A shared placements copied when duplicating lines. */"," struct image_copy_map {"," \tstruct image_placement\t*source;","@@ -88,7 +103,7 @@ struct image_recover_row {"," \tu_int\t\t\t source_y;"," };"," ","-/* A backend to draw an image. */","+/* Image backend callbacks. */"," struct image_backend {"," \tconst char\t*name;"," \tint\t\t(*get_flags)(struct tty *);","@@ -100,6 +115,7 @@ struct image_backend {"," \tvoid\t\t(*start_draw)(struct tty *, u_int, u_int, u_int, u_int);"," \tvoid\t\t(*flush)(struct tty *);"," \tvoid\t\t(*free)(struct tty *);","+\t