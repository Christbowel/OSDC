utdown and expiry happen while the watch is outside select.","+type shutdownWatchStream struct {","+\t*mockWatchServer","+\tonEvent func(*resourcepb.WatchEvent)","+}","+","+func (s *shutdownWatchStream) Send(event *resourcepb.WatchEvent) error {","+\ts.onEvent(event)","+\treturn s.mockWatchServer.Send(event)","+}","+","+func TestWatchShutdownPreservesInvalidation(t *testing.T) {","+\tfor _, trigger := range []string{\"shutdown\", \"invalidation before shutdown\", \"invalidation after shutdown\"} {","+\t\tt.Run(trigger, func(t *testing.T) {","+\t\t\tsrv := newWatchTestServer(t, watchTestServerOpts{})","+\t\t\texpiry := srv.watchExpiry","+\t\t\tctx, cancel := context.WithTimeout(authlib.WithAuthInfo(t.Context(), newWatchTestUser()), 5*time.Second)","+\t\t\tdefer cancel()","+\t\t\tstream := &shutdownWatchStream{mockWatchServer: newMockWatchServer(ctx), onEvent: func(event *resourcepb.WatchEvent) {","+\t\t\t\tif event.Type == resourcepb.WatchEvent_ADDED {","+\t\t\t\t\t// Stop cancels this context before draining writes and closing NATS.","+\t\t\t\t\t// Keep the client context live, as it is during gRPC shutdown.","+\t\t\t\t\tif trigger == \"invalidation before shutdown\" {","+\t\t\t\t\t\texpiry.Invalidate()","+\t\t\t\t\t}","+\t\t\t\t\tsrv.cancel()","+\t\t\t\t\tif trigger == \"invalidation after shutdown\" {","+\t\t\t\t\t\texpiry.Invalidate()","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}}","+\t\t\treq := &resourcepb.WatchRequest{Options: &resourcepb.ListOptions{Key: &resourcepb.ResourceKey{","+\t\t\t\tGroup: watchTestGroup, Resource: watchTestResource, Namespace: watchTestNamespace,","+\t\t\t}}, SendInitialEvents: true, AllowWatchBookmarks: true}","+\t\t\tdone := make(chan error, 1)","+\t\t\tgo func() {","+\t\t\t\tdefer close(done)","+\t\t\t\tdone <- srv.Watch(req, stream)","+\t\t\t}()","+\t\t\tt.Cleanup(func() { cancel(); <-done })","+\t\t\trequireNatsRecoveryEvent(t, stream.mockWatchServer, resourcepb.WatchEvent_BOOKMARK)","+\t\t\trequire.NoError(t, createTestPlaylist(ctx, srv))","+\t\t\tselect {","+\t\t\tcase err := <-done:","+\t\t\t\tif trigger == \"shutdown\" {","+\t\t\t\t\trequire.NoError(t, err, \"shutdown alone must end the watch without a 410\")","+\t\t\t\t} else {","+\t\t\t\t\trequire.True(t, IsResourceVersionExpired(err), \"shutdown must preserve a pending expiry: %v\", err)","+\t\t\t\t}","+\t\t\tcase <-ctx.Done():","+\t\t\t\tt.Fatal(\"watch did not stop with the storage server\")","+\t\t\t}","+\t\t\trequire.NoError(t, ctx.Err(), \"client transport must still be live\")","+\t\t\trequire.ErrorIs(t, srv.ctx.Err(), context.Canceled)","+\t\t\trequire.NoError(t, srv.Watch(req, newMockWatchServer(ctx)), \"a draining server must not start another watch\")","+\t\t})","+\t}"],"additions":79,"deletions":11,"truncated":false}],"additions":204,"deletions":52,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-09-30T15:46:43.254507+00:00"}