    assert_empty Nokogiri::HTML5.fragment(html).css(\"img\")","+  end","+end if Rails::HTML::Sanitizer.html5_support?",""],"additions":18,"deletions":0,"truncated":false}],"additions":45,"deletions":11,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-13T17:02:31.795458+00:00"}