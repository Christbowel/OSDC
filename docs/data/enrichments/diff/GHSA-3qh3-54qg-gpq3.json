{"id":"GHSA-3qh3-54qg-gpq3","axis":"advisories","repo":"silverstripe/silverstripe-framework","sha":"693c948bae13dd2a854489baa575123ca3e60155","parsed":{"files":[{"path":"lang/en.yml","lines":["@@ -174,6 +174,7 @@ en:","     Save: Save","     Saved: 'Saved {name} {link}'","   SilverStripe\\Forms\\GridField\\GridFieldDetailForm_ItemRequest:","+    CreatePermissionsFailure: 'It seems you don''t have the necessary permissions to create \"{ObjectTitle}\"'","     EditPermissionsFailure: 'It seems you don''t have the necessary permissions to edit \"{ObjectTitle}\"'","     NEW: 'Add new record'","     NEXT: 'Go to next record'"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Forms/GridField/GridFieldDetailForm_ItemRequest.php","lines":["@@ -821,6 +821,17 @@ public function httpError($errorCode, $errorMessage = null)","      */","     protected function saveFormIntoRecord($data, $form)","     {","+        if (!$this->record->ID","+            && (!$this->record->hasMethod('canCreate') || !$this->record->canCreate(null, $this->getCreateContext()))","+        ) {","+            $this->httpError(403, _t(","+                __CLASS__ . '.CreatePermissionsFailure',","+                'It seems you don\\'t have the necessary permissions to create \"{ObjectTitle}\"',","+                ['ObjectTitle' => $this->getModelName()]","+            ));","+            return null;","+        }","+","         $list = $this->gridField->getList();"," ","         // Check object matches the correct classname"],"additions":11,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormCreatePermissionTest.php","lines":["@@ -0,0 +1,89 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use SilverStripe\\Dev\\CSSContentParser;","+use SilverStripe\\Dev\\FunctionalTest;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormCreatePermissionTest\\CreateRestrictedController;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormCreatePermissionTest\\CreateRestrictedObject;","+","+class GridFieldDetailFormCreatePermissionTest extends FunctionalTest","+{","+    protected static $extra_dataobjects = [","+        CreateRestrictedObject::class,","+    ];","+","+    protected static $extra_controllers = [","+        CreateRestrictedController::class,","+    ];","+","+    protected static $disable_themes = true;","+","+    public static function provideDoSaveNewRecord(): array","+    {","+        return [","+            'member without create permission' => [","+                'permission' => 'CMS_ACCESS_LeftAndMain',","+                'expectedStatusCode' => 403,","+                'expectedNumCreated' => 0,","+            ],","+            'member with create permission' => [","+                'permission' => CreateRestrictedObject::CREATE_PERMISSION,","+                'expectedStatusCode' => 200,","+                'expectedNumCreated' => 1,","+            ],","+        ];","+    }","+","+    /**","+     * The row count is asserted against every row in the table rather than against rows matching the","+     * posted title, because the form a member without create permission is served is readonly and so","+     * posts no field values - a bypassed create writes a row with a blank title, which a title filter","+     * would not see.","+     */","+    #[DataProvider('provideDoSaveNewRecord')]","+    public function testDoSaveNewRecord(string $permission, int $expectedStatusCode, int $expectedNumCreated): void","+    {","+        $this->logInWithPermission($permission);","+        $formUrl = $this->getItemEditFormUrl('new');","+        $title = 'Created via a crafted doSave submission';","+        $numRecordsBefore = CreateRestrictedObject::get()->count();","+","+        $response = $this->post($formUrl, ['Title' => $title, 'action_doSave' => 1]);","+","+        $numCreated = CreateRestrictedObject::get()->count() - $numRecordsBefore;","+        $this->assertSame($expectedNumCreated, $numCreated);","+        $this->assertSame($expectedStatusCode, $response->getStatusCode());","+    }","+","+    /**","+     * Editing an existing record only requires canEdit(), so the create gate must not","+     * interfere with it.","+     */","+    public function testDoSaveExistingRecord(): void","+    {","+        $this->logInWithPermission('CMS_ACCESS_LeftAndMain');","+        $record = new CreateRestrictedObject(['Title' => 'Original title']);","+        $record->write();","+        $formUrl = $this->getItemEditFormUrl($record->ID . '/edit');","+","+        $response = $this->post($formUrl, ['Title' => 'Edited title', 'action_doSave' => 1]);","+","+        $this->assertFalse($response->isError());","+        $this->assertSame('Edited title', CreateRestrictedObject::get()->byID($record->ID)->Title);","+    }","+","+    /**","+     * Get the URL the ItemEditForm posts back to, as a browser would from the rendered form.","+     */","+    private function getItemEditFormUrl(string $item): string","+    {","+        $url = 'GridFieldDetailFormCreatePermissionTest_Controller/Form/field/testfield/item/' . $item;","+        $response = $this->get($url);","+        $this->assertFalse($response->isError());","+        $parser = new CSSContentParser($response->getBody());","+        $form = $parser->getBySelector('#Form_ItemEditForm');","+        return (string) $form[0]['action'];","+    }","+}"],"additions":89,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormCreatePermissionTest/CreateRestrictedController.php","lines":["@@ -0,0 +1,44 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormCreatePermissionTest;","+","+use SilverStripe\\Control\\Controller;","+use SilverStripe\\Dev\\TestOnly;","+use SilverStripe\\Forms\\FieldList;","+use SilverStripe\\Forms\\Form;","+use SilverStripe\\Forms\\GridField\\GridField;","+use SilverStripe\\Forms\\GridField\\GridFieldAddNewButton;","+use SilverStripe\\Forms\\GridField\\GridFieldDetailForm;","+use SilverStripe\\Forms\\GridField\\GridFieldEditButton;","+use SilverStripe\\Forms\\GridField\\GridFieldToolbarHeader;","+","+class CreateRestrictedController extends Controller implements TestOnly","+{","+    private static $allowed_actions = ['Form'];","+","+    protected $template = 'BlankPage';","+","+    public function __construct()","+    {","+        parent::__construct();","+        $controller = Controller::curr();","+        if ($controller) {","+            $this->setRequest($controller->getRequest());","+        }","+    }","+","+    public function Link($action = null)","+    {","+        return Controller::join_links('GridFieldDetailFormCreatePermissionTest_Controller', $action, '/');","+    }","+","+    public function Form()","+    {","+        $field = new GridField('testfield', 'testfield', CreateRestrictedObject::get());","+        $field->getConfig()->addComponent(new GridFieldToolbarHeader());","+        $field->getConfig()->addComponent(new GridFieldAddNewButton('toolbar-header-right'));","+        $field->getConfig()->addComponent(new GridFieldEditButton());","+        $field->getConfig()->addComponent(new GridFieldDetailForm($this, 'Form'));","+        return new Form($this, 'Form', new FieldList($field), new FieldList());","+    }","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormCreatePermissionTest/CreateRestrictedObject.php","lines":["@@ -0,0 +1,42 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormCreatePermissionTest;","+","+use SilverStripe\\Dev\\TestOnly;","+use SilverStripe\\ORM\\DataObject;","+use SilverStripe\\Security\\Permission;","+","+/**","+ * A model whose create permission is stricter than its edit permission, which is the","+ * scenario where the server-side create authorisation of GridFieldDetailForm matters.","+ */","+class CreateRestrictedObject extends DataObject implements TestOnly","+{","+    public const CREATE_PERMISSION = 'GRIDFIELD_CREATE_RESTRICTED_OBJECT';","+","+    private static $table_name = 'GridFieldDetailFormCreatePermissionTest_CreateRestrictedObject';","+","+    private static $db = [","+        'Title' => 'Varchar',","+    ];","+","+    public function canView($member = null)","+    {","+        return true;","+    }","+","+    public function canEdit($member = null)","+    {","+        return true;","+    }","+","+    public function canCreate($member = null, $context = [])","+    {","+        return Permission::check(CreateRestrictedObject::CREATE_PERMISSION, 'any', $member);","+    }","+","+    public function canDelete($member = null)","+    {","+        return true;","+    }","+}",""],"additions":42,"deletions":0,"truncated":false}],"additions":187,"deletions":0,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-17T18:43:13.388523+00:00"}