loyment.environment\", Values: []string{\"prod\", \"staging\"}},","+\t}","+\tmetricsReader := &metricsmocks.Reader{}","+\tts := initializeTestServer(t, HandlerOptions.MetricsQueryService(metricsReader))","+","+\tmetricsReader.On(\"GetDimensions\", mock.Anything).Return(configured, nil).Once()","+\tmetricsReader.On(","+\t\t\"GetCallRates\",","+\t\tmock.Anything,","+\t\tmock.MatchedBy(func(p *metricstore.CallRateQueryParameters) bool {","+\t\t\treturn p.Filters[\"deployment.environment\"] == \"prod\"","+\t\t}),","+\t).Return(&metrics.MetricFamily{}, nil).Once()","+","+\tvar response metrics.MetricFamily","+\trequire.NoError(t, getJSON(","+\t\tts.server.URL+\"/api/metrics/calls?service=svc&filter=deployment.environment:prod\",","+\t\t&response,","+\t))","+}","+","+func TestMetricsFilterGetDimensionsError(t *testing.T) {","+\tfor _, endpoint := range []string{\"calls\", \"latencies\", \"errors\"} {","+\t\tt.Run(endpoint, func(t *testing.T) {","+\t\t\tmetricsReader := &metricsmocks.Reader{}","+\t\t\tts := initializeTestServer(t, HandlerOptions.MetricsQueryService(metricsReader))","+\t\t\tmetricsReader.","+\t\t\t\tOn(\"GetDimensions\", mock.Anything).","+\t\t\t\tReturn(nil, assert.AnError).","+\t\t\t\tOnce()","+","+\t\t\tvar response any","+\t\t\terr := getJSON(ts.server.URL+\"/api/metrics/\"+endpoint+\"?service=svc&quantile=0.95&filter=k8s.cluster:foo\", &response)","+","+\t\t\tvar httpErr *HTTPError","+\t\t\trequire.ErrorAs(t, err, &httpErr)","+\t\t\tassert.Equal(t, http.StatusInternalServerError, httpErr.StatusCode)","+\t\t\tassert.Contains(t, httpErr.Body, assert.AnError.Error())","+\t\t\tmetricsReader.AssertExpectations(t)","+\t\t})","+\t}","+}","+","+func TestMetricsFilterRequestOnBackendWithoutDimensions(t *testing.T) {","+\t// A backend that advertises no dimensions must reject filter requests","+\t// with 501; otherwise the operator would silently get an unfiltered","+\t// response when they intended to filter.","+\tfor _, endpoint := range []string{\"calls\", \"errors\", \"latencies\"} {","+\t\tt.Run(endpoint, func(t *testing.T) {","+\t\t\tmetricsReader := &metricsmocks.Reader{}","+\t\t\tts := initializeTestServer(t, HandlerOptions.MetricsQueryService(metricsReader))","+\t\t\tmetricsReader.On(\"GetDimensions\", mock.Anything).Return(nil, nil).Once()","+","+\t\t\tresp, err := http.Get(ts.server.URL + \"/api/metrics/\" + endpoint + \"?service=svc&quantile=0.95&filter=anything:x\")","+\t\t\trequire.NoError(t, err)","+\t\t\tdefer resp.Body.Close()","+\t\t\tassert.Equal(t, http.StatusNotImplemented, resp.StatusCode)","+\t\t\tbody, err := io.ReadAll(resp.Body)","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Contains(t, string(body), \"metric filtering is not supported by this backend\")","+\t\t\tmetricsReader.AssertExpectations(t)","+\t\t\tassert.Len(t, metricsReader.Calls, 1, \"unsupported filters must not execute a metrics query\")","+\t\t})","+\t}"," }"," "," // getJSON fetches a JSON document from a server via HTTP GET"],"additions":319,"deletions":7,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/query_parser.go","lines":["@@ -9,7 +9,9 @@ import ("," \t\"fmt\""," \t\"math\""," \t\"net/http\"","+\t\"net/url\""," \t\"strconv\"","+\t\"strings\""," \t\"time\""," "," \t\"github.com/jaegertracing/jaeger/internal/jptrace\"","@@ -23,6 +25,7 @@ const ("," \tendTimeParam     = \"end\""," \tprettyPrintParam = \"prettyPrint\""," \trawParam         = \"raw\"","+\tfilterParam      = \"filter\""," )"," "," type (","@@ -95,7 +98,7 @@ func (p *queryParser) parseDependenciesQueryParams(r *http.Request) (dqp depende"," //"," //\tquery ::= services , [ '&' optionalParams ]"," //\toptionalParams := param | param '&' optionalParams","-//\tparam ::=  groupByOperation | endTs | lookback | step | ratePer | spanKinds","+//\tparam ::=  groupByOperation | endTs | lookback | step | ratePer | spanKinds | filters"," //\tservices ::= service | service '&' services"," //\tservice ::= 'service=' strValue"," //\tgroupByOperation ::= 'groupByOperation=' boolValue","@@ -106,8 +109,13 @@ func (p *queryParser) parseDependenciesQueryParams(r *http.Request) (dqp depende"," //\tspanKinds ::= spanKind | spanKind '&' spanKinds"," //\tspanKind ::= 'spanKind=' spanKindType"," //\tspanKindType ::= \"unspecified\" | \"internal\" | \"server\" | \"client\" | \"producer\" | \"consumer\"","+//\tfilters ::= filter | filter '&' filters","+//\tfilter ::= 'filter=' strValue ':' strValue (pre-configured dimension name and value, e.g. deployment.environment:prod)"," func (p *queryParser) parseMetricsQueryParams(r *http.Request) (bqp metricstore.BaseQueryParameters, err error) {","-\tquery := r.URL.Query()","+\tquery, err := url.ParseQuery(r.URL.RawQuery)","+\tif err != nil {","+\t\treturn bqp, fmt.Errorf(\"invalid query: %w\", err)","+\t}"," \tservices, ok := query[serviceParam]"," \tif !ok {"," \t\treturn bqp, newParseError(errors.New(\"please provide at least one service name\"), serviceParam)","@@ -139,13 +147,41 @@ func (p *queryParser) parseMetricsQueryParams(r *http.Request) (bqp metricstore."," \tif err != nil {"," \t\treturn bqp, err"," \t}","+\tfilters, err := parseMetricFilters(query[filterParam])","+\tif err != nil {","+\t\treturn bqp, newParseError(err, filterParam)","+\t}"," \tbqp.EndTime = &endTs"," \tbqp.Lookback = &lookback"," \tbqp.Step = &step"," \tbqp.RatePer = &ratePer","+\tbqp.Filters = filters"," \treturn bqp, err"," }"," ","+// parseMetricFilters parses repeated `filter=key:value` query params into a","+// dimension map. Returns nil (not an empty map) when no filters are supplied","+// so downstream code can distinguish \"no filtering\" cleanly.","+func parseMetricFilters(raw []string) (map[string]string, error) {","+\tif len(raw) == 0 {","+\t\treturn nil, nil","+\t}","+\tout := make(map[string]string, len(raw))","+\tfor _, kv := range raw {","+\t\tidx := strings.Index(kv, \":\")","+\t\tif idx <= 0 || idx == len(kv)-1 {","+\t\t\treturn nil, fmt.Errorf(\"malformed filter %q, expecting key:value\", kv)","+\t\t}","+\t\tkey := kv[:idx]","+\t\tval := kv[idx+1:]","+\t\tif _, dup := out[key]; dup {","+\t\t\treturn nil, fmt.Errorf(\"duplicate filter key %q\", key)","+\t\t}","+\t\tout[key] = val","+\t}","+\treturn out, nil","+}","+"," // parseTime parses the time parameter of an HTTP request that is represented as a number of units since"," // epoch, which toTime (time.UnixMilli or time.UnixMicro) converts to a time. Converting this way rather than"," // multiplying by a time.Duration keeps large values from overflowing."],"additions":38,"deletions":2,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/query_parser_test.go","lines":["@@ -128,6 +128,69 @@ func TestParseRepeatedSpanKinds(t *testing.T) {"," \t}, mqp.SpanKinds)"," }"," ","+func TestParseFiltersSingle(t *testing.T) {","+\trequest, err := http.NewRequest(http.MethodGet, \"x?service=foo&filter=deployment.environment:prod\", http.NoBody)","+\trequire.NoError(t, err)","+\tparser := &queryParser{timeNow: time.Now}","+\tmqp, err := parser.parseMetricsQueryParams(request)","+\trequire.NoError(t, err)","+\tassert.Equal(t, map[string]string{\"deployment.environment\": \"prod\"}, mqp.Filters)","+}","+","+func TestParseFiltersRepeated(t *testing.T) {","+\tq := \"x?service=foo&filter=deployment.environment:prod&filter=k8s.cluster:us-west-1\"","+\trequest, err := http.NewRequest(http.MethodGet, q, http.NoBody)","+\trequire.NoError(t, err)","+\tparser := &queryParser{timeNow: time.Now}","+\tmqp, err := parser.parseMetricsQueryParams(request)","+\trequire.NoError(t, err)","+\tassert.Equal(t, map[string]string{","+\t\t\"deployment.environment\": \"prod\",","+\t\t\"k8s.cluster\":            \"us-west-1\",","+\t}, mqp.Filters)","+}","+","+func TestParseFiltersWithColonInValue(t *testing.T) {","+\t// A value containing a colon is preserved verbatim — split only on the first ':'.","+\tq := \"x?service=foo&filter=region:us:west-1\"","+\trequest, err := http.NewRequest(http.MethodGet, q, http.NoBody)","+\trequire.NoError(t, err)","+\tparser := &queryParser{timeNow: time.Now}","+\tmqp, err := parser.parseMetricsQueryParams(request)","+\trequire.NoError(t, err)","+\tassert.Equal(t, map[string]string{\"region\": \"us:west-1\"}, mqp.Filters)","+}","+","+func TestParseFiltersOmittedYieldsNil(t *testing.T) {","+\trequest, err := http.NewRequest(http.MethodGet, \"x?service=foo\", http.NoBody)","+\trequire.NoError(t, err)","+\tparser := &queryParser{timeNow: time.Now}","+\tmqp, err := parser.parseMetricsQueryParams(request)","+\trequire.NoError(t, err)","+\tassert.Nil(t, mqp.Filters)","+}","+","+func TestParseFiltersMalformed(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname string","+\t\traw  string","+\t}{","+\t\t{\"missing colon\", \"x?service=foo&filter=keyonly\"},","+\t\t{\"empty key\", \"x?service=foo&filter=:value\"},","+\t\t{\"empty value\", \"x?service=foo&filter=key:\"},","+\t\t{\"duplicate key\", \"x?service=foo&filter=k:v1&filter=k:v2\"},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\trequest, err := http.NewRequest(http.MethodGet, tc.raw, http.NoBody)","+\t\t\trequire.NoError(t, err)","+\t\t\tparser := &queryParser{timeNow: time.Now}","+\t\t\t_, err = parser.parseMetricsQueryParams(request)","+\t\t\trequire.Error(t, err)","+\t\t\tassert.ErrorContains(t, err, \"filter\")","+\t\t})","+\t}","+}","+"," func TestParameterErrors(t *testing.T) {"," \tts := initializeTestServer(t)"," "],"additions":63,"deletions":0,"truncated":false},{"path":"docs/rfc/0021-spm-dimension-filtering.md","lines":["@@ -0,0 +1,464 @@","+# RFC 0021: SPM Dimension Filtering","+","+- **Status:** Draft","+- **Author:** [ChaitanyaD48](https://github.com/ChaitanyaD48)","+- **Created:** 2026-05-15","+- **Last Updated:** 2026-11-01","+- **Issue:** [#7433: Filter metrics on page by tag](https://github.com/jaegertracing/jaeger/issues/7433)","+","+## Abstract","+","+We propose backend API support and operator-declared dimension filtering","+for Prometheus-backed Service Performance Monitoring (SPM). Operators declare","+filterable dimensions in Jaeger's configuration, clients retrieve those","+declarations through a new endpoint, and selected values become exact-match","+PromQL label selectors. This partially addresses #7433. UI integration and","+Elasticsearch/OpenSearch filtering remain separate work.","+","+## 1. Motivation","+","+The Service Performance Monitoring (SPM) page in the Jaeger UI surfaces","+call-rate, error-rate, and latency metrics aggregated by service. Today the","+only filterable axis (beyond service name and span kind) is the time range.","+Operators who emit metrics for multiple environments — `prod`, `staging`,","+`dev` — into a single Prometheus backend cannot scope the SPM view to one","+environment. The community workaround has been to run a duplicate Jaeger","+deployment per environment, which is operationally expensive and defeats the","+purpose of a centralised observability stack.","+","+[#7433](https://github.com/jaegertracing/jaeger/issues/7433) requests SPM","+filtering with API changes and support for Prometheus and","+Elasticsearch/OpenSearch. This RFC covers the backend API and Prometheus","+portion: filtering metrics by configured dimensions such as deployment","+environment. It does not complete the issue. UI integration,","+Elasticsearch/OpenSearch filtering, and dynamic discovery of dimensions or","+their values are outside this proposal's implementation scope.","+","+### Why PromQL Constrains the Design","+","+PromQL is not SQL. A query like","+","+```","+sum(rate(calls{service_name=\"cart\"}[5m])) by (service_name)","+```","+","+can only filter on labels that exist on the stored time series. The","+spanmetrics connector aggregates spans using its default dimensions and any","+additional attributes listed in its","+[`dimensions:`](https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/connector/spanmetricsconnector#configurations)","+configuration. An attribute discarded during aggregation cannot be","+recovered by a later metrics query. Additional filterable attributes must","+therefore be preserved as dimensions when generating span metrics.","+","+Prometheus supports discovering existing label names and values through its","+[HTTP API](https://prometheus.io/docs/prometheus/latest/querying/api/#querying-metadata).","+Dynamic discovery is possible for retained labels; it cannot recover","+discarded attributes. This proposal chooses operator-declared dimensions","+to provide a server-side allowlist and optional bounded value lists without","+adding discovery queries.","+","+### Backend Asymmetry","+","+Elasticsearch/OpenSearch and ClickHouse can query stored span attributes,","+but wiring these filters into their metric queries is separate work. This","+proposal adds shared API types while implementing filtering only in the","+Prometheus reader. Other readers return an empty dimension list. The API","+contract is that the backend advertises which dimensions are filterable,","+and clients send filters that match the advertised set.","+","+## 2. Proposed Design","+","+We propose a **pre-configured** dimension-filter capability for Prometheus","+metrics, including the environment-filtering use case described in #7433.","+","+### Mechanism","+","+1. **Operator declares the filterable dimensions in the Jaeger backend","+   YAML**, under the Prometheus metric backend:","+","+   ```yaml","+   metric_backends:","+     some_metrics_storage:","+       prometheus:","+         endpoint: http://prometheus:9090","+         extra_dimensions:","+           - name: deployment.environment","+             display_name: Environment","+             values: [prod, staging, dev]","+   ```","+","+   The same names must already appear in the spanmetrics connector's","+   `dimensions:` list — this is the operator's responsibility and is","+   identical in spirit to the existing requirement that span-kind and","+   service-name labels exist on the metrics.","+","+   Configuration validation rejects names that translate to the reserved","+   labels `service_name`, `span_kind`, `status_code`, `span_name`, `job`,","+   `instance`, `le`, or `__name__`, and names that collide after","+   dot-to-underscore translation. Leading, trailing, or consecutive dots and","+   underscores (including mixed pairs such as `._`) are rejected so label","+   selectors match exported labels with either setting of","+   `PermissiveLabelSanitization`. Allowed-value lists must not contain empty","+   strings. An omitted or empty list still permits free-text values.","+","+2. **The Jaeger Query backend exposes the declared dimensions** via a new","+   endpoint:","+","+   ```","+   GET /api/metrics/dimensions","+   → [","+       { \"name\": \"deployment.environment\",","+         \"displayName\": \"Environment\",","+         \"values\": [\"prod\", \"staging\", \"dev\"] }"],"additions":112,"deletions":0,"truncated":false}],"additions":613,"deletions":10,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-11-10T17:06:35.034244+00:00"}