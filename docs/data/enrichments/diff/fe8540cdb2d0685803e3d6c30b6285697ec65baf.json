e.GetDimensions(r.Context())","+\tif aH.handleError(w, err, http.StatusInternalServerError) {","+\t\treturn","+\t}","+\tif dims == nil {","+\t\tdims = []metricstore.Dimension{}","+\t}","+\taH.writeJSON(w, r, dims)","+}","+","+// validateMetricFilters checks the requested filter keys against the configured","+// dimensions and (when configured) their allowed values.","+func validateMetricFilters(filters map[string]string, dims []metricstore.Dimension) error {","+\tif len(dims) == 0 {","+\t\treturn fmt.Errorf(\"metric filtering is not supported by this backend (no dimensions configured): %w\", errors.ErrUnsupported)","+\t}","+\tbyName := make(map[string]metricstore.Dimension, len(dims))","+\tfor _, d := range dims {","+\t\tbyName[d.Name] = d","+\t}","+\tfor _, k := range slices.Sorted(maps.Keys(filters)) {","+\t\tv := filters[k]","+\t\td, ok := byName[k]","+\t\tif !ok {","+\t\t\tnames := make([]string, 0, len(dims))","+\t\t\tfor _, dim := range dims {","+\t\t\t\tnames = append(names, dim.Name)","+\t\t\t}","+\t\t\treturn fmt.Errorf(\"unknown filter dimension %q; configured: %v\", k, names)","+\t\t}","+\t\tif len(d.Values) > 0 {","+\t\t\tif !slices.Contains(d.Values, v) {","+\t\t\t\treturn fmt.Errorf(\"value %q not allowed for filter %q; allowed: %v\", v, k, d.Values)","+\t\t\t}","+\t\t\tcontinue","+\t\t}","+\t\tif !filterValueRegex.MatchString(v) {","+\t\t\treturn fmt.Errorf(\"invalid value for filter %q (control characters, quotes, and backslashes are not allowed)\", k)","+\t\t}","+\t}","+\treturn nil","+}","+"," func (*APIHandler) deduplicateDependencies(dependencies []model.DependencyLink) []ui.DependencyLink {"," \ttype Key struct {"," \t\tparent string","@@ -325,7 +390,7 @@ func (aH *APIHandler) handleError(w http.ResponseWriter, err error, statusCode i"," \tif err == nil {"," \t\treturn false"," \t}","-\tif errors.Is(err, disabled.ErrDisabled) {","+\tif errors.Is(err, disabled.ErrDisabled) || errors.Is(err, errors.ErrUnsupported) {"," \t\tstatusCode = http.Status