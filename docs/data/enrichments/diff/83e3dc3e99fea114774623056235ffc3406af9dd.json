{"id":"83e3dc3e99fea114774623056235ffc3406af9dd","axis":"silent","repo":"rancher/rancher","sha":"83e3dc3e99fea114774623056235ffc3406af9dd","parsed":{"files":[{"path":"pkg/auth/providers/cognito/cognito.go","lines":["@@ -33,13 +33,14 @@ func Configure(ctx context.Context, mgmtCtx *config.ScaledContext, userMGR user."," \tp := &CognitoProvider{"," \t\tGenOIDCProvider: genericoidc.GenOIDCProvider{"," \t\t\tOpenIDCProvider: baseoidc.OpenIDCProvider{","-\t\t\t\tName:        Name,","-\t\t\t\tType:        client.CognitoConfigType,","-\t\t\t\tCTX:         ctx,","-\t\t\t\tAuthConfigs: mgmtCtx.Management.AuthConfigs(\"\"),","-\t\t\t\tSecrets:     mgmtCtx.Wrangler.Core.Secret(),","-\t\t\t\tUserMGR:     userMGR,","-\t\t\t\tTokenMgr:    tokenMgr,","+\t\t\t\tName:         Name,","+\t\t\t\tType:         client.CognitoConfigType,","+\t\t\t\tCTX:          ctx,","+\t\t\t\tAuthConfigs:  mgmtCtx.Management.AuthConfigs(\"\"),","+\t\t\t\tSecrets:      mgmtCtx.Wrangler.Core.Secret(),","+\t\t\t\tUserMGR:      userMGR,","+\t\t\t\tTokenMgr:     tokenMgr,","+\t\t\t\tUserSearcher: common.NewUserSearcher(mgmtCtx.Management.Users(\"\").Controller().Lister()),"," \t\t\t},"," \t\t},"," \t}"],"additions":8,"deletions":7,"truncated":false},{"path":"pkg/auth/providers/common/usersearch.go","lines":["@@ -0,0 +1,185 @@","+package common","+","+import (","+\t\"fmt\"","+\t\"slices\"","+\t\"strings\"","+\t\"unicode\"","+","+\tapiv3 \"github.com/rancher/rancher/pkg/apis/management.cattle.io/v3\"","+\t\"github.com/sirupsen/logrus\"","+\t\"golang.org/x/text/runes\"","+\t\"golang.org/x/text/transform\"","+\t\"golang.org/x/text/unicode/norm\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/labels\"","+)","+","+// UserLister lists v3.User resources, normally from an informer cache.","+type UserLister interface {","+\tList(namespace string, selector labels.Selector) ([]*apiv3.User, error)","+}","+","+// UserSearcher resolves principals from the v3.User resources Rancher has","+// already created. Providers whose identity provider offers no user lookup use","+// it to return the real principals of users that have logged in or been","+// provisioned, rather than only a principal built from the search key.","+type UserSearcher struct {","+\tusers UserLister","+}","+","+// NewUserSearcher returns a UserSearcher backed by the given lister.","+func NewUserSearcher(users UserLister) *UserSearcher {","+\treturn &UserSearcher{users: users}","+}","+","+// SearchPrincipals returns the user principals owned by provider that belong to","+// users matching searchKey, ordered by principal ID. A user contributes a","+// principal only if it carries a principal ID for provider, so users known to","+// Rancher through some other provider are left out. A search key that is empty","+// or only whitespace matches nothing, to avoid returning every user.","+func (s *UserSearcher) SearchPrincipals(provider, searchKey string) ([]apiv3.Principal, error) {","+\tqueryKey := strings.ToLower(searchKey)","+\tnormalizedQueryKey := normalizeSearchKey(queryKey)","+","+\t// A key that normalizes to nothing, because it is empty or only","+\t// whitespace, is contained in every name and would return every user.","+\tif normalizedQueryKey == \"\" {","+\t\treturn nil, nil","+\t}","+","+\tusers, err := s.users.List(\"\", labels.NewSelector())","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"listing users for search %q: %w\", searchKey, err)","+\t}","+","+\tprefix := provider + \"_\" + UserPrincipalType + \"://\"","+","+\tvar principals []apiv3.Principal","+\tfor _, user := range users {","+\t\t// Users of other providers cannot contribute a principal, so skip them","+\t\t// before normalizing their display name to match it.","+\t\tif !hasPrincipalWithPrefix(user, prefix) {","+\t\t\tcontinue","+\t\t}","+","+\t\tif !userMatchesSearchKey(user, queryKey, normalizedQueryKey) {","+\t\t\tcontinue","+\t\t}","+","+\t\tfor _, principalID := range user.PrincipalIDs {","+\t\t\tif !strings.HasPrefix(principalID, prefix) {","+\t\t\t\tcontinue","+\t\t\t}","+","+\t\t\tprincipals = append(principals, apiv3.Principal{","+\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: principalID},","+\t\t\t\tDisplayName:   user.DisplayName,","+\t\t\t\tPrincipalType: UserPrincipalType,","+\t\t\t\tProvider:      provider,","+\t\t\t})","+\t\t}","+\t}","+","+\t// The lister iterates the informer cache in no particular order, so sort to","+\t// keep repeated searches in the same order.","+\tslices.SortFunc(principals, func(a, b apiv3.Principal) int {","+\t\treturn strings.Compare(a.Name, b.Name)","+\t})","+","+\treturn principals, nil","+}","+","+// PrincipalsWithFallback returns the principals of provider's users matching","+// searchKey, followed by fallback unless one of them already has its ID.","+// Providers whose identity provider offers no user lookup call this with a","+// principal built from the search key, so an admin can still enter an external","+// ID by hand for an identity Rancher has not seen yet. A nil searcher yields","+// only the fallback.","+func PrincipalsWithFallback(searcher *UserSearcher, provider, searchKey string, fallback apiv3.Principal) ([]apiv3.Principal, error) {","+\tvar principals []apiv3.Principal","+","+\tif searcher != nil {","+\t\tknown, err := searcher.SearchPrincipals(provider, searchKey)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tprincipals = known","+\t}","+","+\tif !ContainsPrincipal(principals, fallback.Name) {","+\t\tprincipals = append(principals, fallback)","+\t}","+","+\treturn principals, nil","+}","+","+func hasPrincipalWithPrefix(user *apiv3.User, prefix string) bool {","+\treturn slices.ContainsFunc(user.PrincipalIDs, func(id string) bool {","+\t\treturn strings.HasPrefix(id, prefix)","+\t})","+}","+","+// ContainsPrincipal reports whether principals holds a principal with the given","+// resource name.","+func ContainsPrincipal(principals []apiv3.Principal, name string) bool {","+\treturn slices.ContainsFunc(principals, func(p apiv3.Principal) bool {","+\t\treturn p.Name == name","+\t})","+}","+","+// UserMatchesSearchKey reports whether the user's resource name, login username","+// or display name matches searchKey. The search key is expected to be lower","+// case. Whitespace and diacritics are ignored so that a display name can be","+// found however it is typed.","+//","+// Callers that test many users against one search key should normalize the key","+// once with normalizeSearchKey and call userMatchesSearchKey instead.","+func UserMatchesSearchKey(user *apiv3.User, searchKey string) bool {","+\treturn userMatchesSearchKey(user, searchKey, normalizeSearchKey(searchKey))","+}","+","+// userMatchesSearchKey takes both the raw search key, matched against the user's","+// resource name, and its normalized form, matched against the login username and","+// display name.","+func userMatchesSearchKey(user *apiv3.User, searchKey, normalizedSearchKey string) bool {","+\t// Every name contains the empty string, so a key that normalized to nothing","+\t// is no search rather than a match on everything.","+\tif normalizedSearchKey == \"\" {","+\t\treturn false","+\t}","+","+\tnormalizedDisplayName := normalizeSearchKey(user.DisplayName)","+","+\treturn strings.HasPrefix(user.ObjectMeta.Name, searchKey) ||","+\t\tstrings.Contains(strings.ToLower(normalizeWhitespace(user.Username)), normalizedSearchKey) ||","+\t\tstrings.Contains(normalizedDisplayName, normalizedSearchKey)","+}","+","+func normalizeSearchKey(s string) string {","+\treturn strings.ToLower(normalizeWhitespace(SimplifyString(s)))","+}","+","+func normalizeWhitespace(s string) string {","+\treturn strings.Join(strings.Fields(s), \"\")","+}","+","+// SimplifyString transforms unicode characters in the string by replacing","+// the characters.","+//","+// The set of characters that is replaced (unicode.Mn) is here","+//","+//\thttps://www.compart.com/en/unicode/category/Mn","+func SimplifyString(s string) string {","+\tt := transform.Chain(norm.NFD, runes.Remove(runes.In(unicode.Mn)), norm.NFC)","+\tresult, _, err := transform.String(t, s)","+","+\t// This shouldn't really happen, as the rune transformer is very forgiving","+\t// and bad things get changed to �","+\tif err != nil {","+\t\tlogrus.Errorf(\"failed to simplify string %q: %s\", s, err)","+\t\treturn s","+\t}","+","+\treturn result","+}"],"additions":185,"deletions":0,"truncated":false},{"path":"pkg/auth/providers/common/usersearch_test.go","lines":["@@ -0,0 +1,259 @@","+package common_test","+","+import (","+\t\"errors\"","+\t\"testing\"","+","+\tapiv3 \"github.com/rancher/rancher/pkg/apis/management.cattle.io/v3\"","+\t\"github.com/rancher/rancher/pkg/auth/providers/common\"","+\t\"github.com/rancher/rancher/pkg/generated/norman/management.cattle.io/v3/fakes\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/labels\"","+)","+","+func TestUserSearcherSearchPrincipals(t *testing.T) {","+\tt.Parallel()","+","+\tusers := []*apiv3.User{","+\t\t{","+\t\t\t// OIDC user: no Username, opaque subject in the provider principal.","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-oidc1\"},","+\t\t\tDisplayName:  \"Test UserOne\",","+\t\t\tPrincipalIDs: []string{\"genericoidc_user://sub-0001\", \"local://u-oidc1\"},","+\t\t},","+\t\t{","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-oidc2\"},","+\t\t\tDisplayName:  \"Test UserTwo\",","+\t\t\tPrincipalIDs: []string{\"genericoidc_user://sub-0002\", \"local://u-oidc2\"},","+\t\t},","+\t\t{","+\t\t\t// SCIM-provisioned Okta user.","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-okta1\"},","+\t\t\tDisplayName:  \"testuser2@example.com\",","+\t\t\tPrincipalIDs: []string{\"okta_user://abc-uuid-1\", \"local://u-okta1\"},","+\t\t},","+\t\t{","+\t\t\t// Purely local user, no external principal.","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-local1\"},","+\t\t\tUsername:     \"svcadmin\",","+\t\t\tDisplayName:  \"Service Admin\",","+\t\t\tPrincipalIDs: []string{\"local://u-local1\"},","+\t\t},","+\t\t{","+\t\t\t// Hybrid user: local login plus an external principal.","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-admin\"},","+\t\t\tUsername:     \"admin\",","+\t\t\tDisplayName:  \"Default Admin\",","+\t\t\tPrincipalIDs: []string{\"genericoidc_user://sub-0009\", \"local://u-admin\"},","+\t\t},","+\t\t{","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-accent\"},","+\t\t\tDisplayName:  \"Émile Dubois\",","+\t\t\tPrincipalIDs: []string{\"genericoidc_user://sub-0003\", \"local://u-accent\"},","+\t\t},","+\t}","+","+\tsearcher := common.NewUserSearcher(&fakes.UserListerMock{","+\t\tListFunc: func(namespace string, selector labels.Selector) ([]*apiv3.User, error) {","+\t\t\treturn users, nil","+\t\t},","+\t})","+","+\ttests := []struct {","+\t\tname      string","+\t\tprovider  string","+\t\tsearchKey string","+\t\twant      []apiv3.Principal","+\t}{","+\t\t{","+\t\t\tname:      \"matches display name of a provider user\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"testu\",","+\t\t\twant: []apiv3.Principal{","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0001\"},","+\t\t\t\t\tDisplayName:   \"Test UserOne\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0002\"},","+\t\t\t\t\tDisplayName:   \"Test UserTwo\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:      \"match is case insensitive and ignores whitespace\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"test user\",","+\t\t\twant: []apiv3.Principal{","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0001\"},","+\t\t\t\t\tDisplayName:   \"Test UserOne\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0002\"},","+\t\t\t\t\tDisplayName:   \"Test UserTwo\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:      \"match ignores diacritics\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"emile\",","+\t\t\twant: []apiv3.Principal{","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0003\"},","+\t\t\t\t\tDisplayName:   \"Émile Dubois\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:      \"hybrid user is returned under the external provider\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"Default Admin\",","+\t\t\twant: []apiv3.Principal{","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0009\"},","+\t\t\t\t\tDisplayName:   \"Default Admin\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:      \"matches the local login username of a hybrid user\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"admin\",","+\t\t\twant: []apiv3.Principal{","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"genericoidc_user://sub-0009\"},","+\t\t\t\t\tDisplayName:   \"Default Admin\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"genericoidc\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:      \"only principals owned by the requested provider are returned\",","+\t\t\tprovider:  \"okta\",","+\t\t\tsearchKey: \"testuser2\",","+\t\t\twant: []apiv3.Principal{","+\t\t\t\t{","+\t\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"okta_user://abc-uuid-1\"},","+\t\t\t\t\tDisplayName:   \"testuser2@example.com\",","+\t\t\t\t\tPrincipalType: \"user\",","+\t\t\t\t\tProvider:      \"okta\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:      \"user without a principal for the provider is skipped\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"svcadmin\",","+\t\t\twant:      nil,","+\t\t},","+\t\t{","+\t\t\tname:      \"no match returns nothing\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"nobody\",","+\t\t\twant:      nil,","+\t\t},","+\t\t{","+\t\t\tname:      \"empty search key returns nothing\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"\",","+\t\t\twant:      nil,","+\t\t},","+\t\t{","+\t\t\tname:      \"whitespace search key returns nothing\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"   \",","+\t\t\twant:      nil,","+\t\t},","+\t\t{","+\t\t\tname:      \"long whitespace search key returns nothing\",","+\t\t\tprovider:  \"genericoidc\",","+\t\t\tsearchKey: \"          \",","+\t\t\twant:      nil,","+\t\t},","+\t}","+","+\tfor _, test := range tests {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\tgot, err := searcher.SearchPrincipals(test.provider, test.searchKey)","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Equal(t, test.want, got)","+\t\t})","+\t}","+}","+","+func TestUserSearcherSearchPrincipalsOrder(t *testing.T) {","+\tt.Parallel()","+","+\t// The informer cache iterates in no particular order, so the lister can","+\t// hand back matching users in any order.","+\tusers := []*apiv3.User{","+\t\t{","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-oidc3\"},","+\t\t\tDisplayName:  \"Test UserThree\",","+\t\t\tPrincipalIDs: []string{\"genericoidc_user://sub-0003\"},","+\t\t},","+\t\t{","+\t\t\tObjectMeta:   metav1.ObjectMeta{Name: \"u-oidc1\"},","+\t\t\tDisplayName:  \"Test UserOne\",","+\t\t\tPrincipalIDs: []string{\"genericoidc_user://sub-0001\"},","+\t\t},","+\t\t{","+\t\t\tObjec