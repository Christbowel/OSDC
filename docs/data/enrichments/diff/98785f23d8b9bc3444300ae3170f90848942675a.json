{"id":"98785f23d8b9bc3444300ae3170f90848942675a","axis":"silent","repo":"TryGhost/Ghost","sha":"98785f23d8b9bc3444300ae3170f90848942675a","parsed":{"files":[{"path":".github/codecov.yml","lines":["@@ -5,9 +5,12 @@ coverage:","     patch: false","     project:","       default: false","+      # The better-auth lane reaches code the legacy engine skips, such as","+      # apps, so the e2e status counts both lanes.","       e2e-tests:","         flags:","           - e2e-tests","+          - e2e-better-auth-tests","         threshold: 0.2%","       unit-tests:","         flags:","@@ -18,6 +21,8 @@ coverage:"," flags:","   e2e-tests:","     carryforward: true","+  e2e-better-auth-tests:","+    carryforward: true","   # ghost's unit tests only run when it's affected, so most PRs carry","   # the last report forward.","   unit-tests:"],"additions":5,"deletions":0,"truncated":false},{"path":".github/workflows/ci.yml","lines":["@@ -1097,7 +1097,9 @@ jobs:"," ","   # The e2e API suites under auth:engine=better-auth, until the legacy engine goes","   # (docs/plans/better-auth-migration.md §7). One Node leg: the engine, not the","-  # runtime, is what differs from job_acceptance-tests.","+  # runtime, is what differs from job_acceptance-tests. Collecting coverage turns","+  # strict mode off (test/utils/strict-mode.ts), so where coverage is collected a","+  # second leg runs without it and keeps one strict run.","   job_better-auth-tests:","     runs-on: ${{ (github.repository_owner == 'TryGhost' && github.repository != 'TryGhost/Ghost') && 'ubuntu-latest-4-cores' || 'ubuntu-latest' }}","     needs: [job_setup]","@@ -1125,9 +1127,14 @@ jobs:","           --health-interval=2s","           --health-timeout=5s","           --health-retries=60","+    strategy:","+      fail-fast: false","+      matrix:","+        coverage: ${{ fromJSON(needs.job_setup.outputs.coverage_enabled == 'true' && '[true, false]' || '[false]') }}","     env:","       NX_CLOUD_ACCESS_TOKEN: ${{ (github.event_name == 'push' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)) && secrets.NX_CLOUD_ACCESS_TOKEN || '' }}","-    name: E2E API tests (better-auth, mysql8)","+      COVERAGE_ENABLED: ${{ matrix.coverage }}","+    name: E2E API tests (better-auth, mysql8${{ matrix.coverage && ', coverage' || '' }})","     steps:","       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","       - uses: ./.github/actions/setup-node-pnpm","@@ -1149,7 +1156,12 @@ jobs:","           } >> \"$GITHUB_ENV\""," ","       - name: E2E API tests (better-auth)","-        run: pnpm nx run ghost:test:e2e:better-auth","+        run: |","+          if [ \"$COVERAGE_ENABLED\" = \"true\" ]; then","+            pnpm nx run ghost:test:ci:e2e:better-auth","+          else","+            pnpm nx run ghost:test:e2e:better-auth","+          fi"," ","       - name: Check for unexpected file changes","         run: |","@@ -1160,6 +1172,12 @@ jobs:","             exit 1","           fi"," ","+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2","+        if: env.COVERAGE_ENABLED == 'true'","+        with:","+          name: e2e-better-auth-coverage","+          path: ghost/coverage-e2e-better-auth/cobertura-coverage.xml","+","   job_legacy-tests:","     runs-on: ubuntu-latest","     needs: [job_setup]","@@ -2697,7 +2715,7 @@ jobs:"," ","   job_coverage:","     name: Coverage","-    needs: [job_setup, job_acceptance-tests, job_unit-tests]","+    needs: [job_setup, job_acceptance-tests, job_better-auth-tests, job_unit-tests]","     if: always() && needs.job_setup.outputs.coverage_enabled == 'true'","     runs-on: ubuntu-latest","     steps:","@@ -2718,6 +2736,23 @@ jobs:","           files: ghost/coverage-e2e/cobertura-coverage.xml,ghost/coverage-integration/cobertura-coverage.xml","           disable_search: true"," ","+      # Its own flag, so a failed better-auth run carries its last report","+      # forward instead of dropping its lines from e2e-tests' upload.","+      - name: Restore E2E (better-auth) coverage","+        if: contains(needs.job_better-auth-tests.result, 'success')","+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2","+        with:","+          name: e2e-better-auth-coverage","+          path: ghost/coverage-e2e-better-auth","+","+      - name: Upload E2E (better-auth) test coverage","+        if: contains(needs.job_better-auth-tests.result, 'success')","+        uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1","+        with:","+          flags: e2e-better-auth-tests","+          files: ghost/coverage-e2e-better-auth/cobertura-coverage.xml","+          disable_search: true","+","       # The unit job only uploads this artifact when ghost was among the","       # affected projects, so a missing artifact is expected, not an error.","       - name: Restore Unit coverage"],"additions":39,"deletions":4,"truncated":false},{"path":"ghost/core/server/auth/app-token-prefix.ts","lines":["@@ -0,0 +1,5 @@","+/**","+ * Every app token starts with this, under any auth engine, so the Admin API can tell one apart","+ * from other Bearer credentials before it knows which engine issued it.","+ */","+export const APP_TOKEN_PREFIX = 'ghost_app_';"],"additions":5,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/README.md","lines":["@@ -113,6 +113,8 @@ until Phase 4.","   does, and a successful save deletes it, so a token saves once."," - `routes.ts`: the Better Auth paths that matchers, limiters and","   `disabledPaths` refer to. A mistyped path matches nothing, silently.","+- `plugins/apps.ts`: the OAuth provider and `jwt` plugins that issue app","+  tokens. See [App tokens](#app-tokens)."," "," Ghost mounts at the subdirectory, so on a subdirectory install requests reach"," Better Auth as `/blog/ghost/api/admin/auth/...`. `basePath` therefore carries","@@ -174,6 +176,45 @@ whose password hasn't changed since still carry their old hash there, unread."," > without rolling the migrations back locks out or reverts anyone whose"," > password changed since. Plan §8 has the recovery."," ","+## App tokens","+","+Apps are to get Admin API tokens from `@better-auth/oauth-provider`, under","+`better-auth` only.","+","+- The provider and the `jwt` plugin it signs with are registered only when the","+  `apps` labs flag is on at boot and their in-development tables exist, so a","+  site that boots without the flag sees no change to sign-in or session reads.","+  Plugins are fixed at boot: turning the flag on or off takes effect at the","+  next restart, and until then a site that turned it off keeps the provider's","+  hooks. The `jwt` plugin sets no header on session reads.","+- Boot reads the flag before remote flags load, so it must come from config","+  or the Labs setting. A flag turned on only through remote flags never","+  registers the provider, however often Ghost restarts.","+- Opaque access tokens carry the `ghost_app_` prefix. The provider registers","+  no scopes, `openid` included, so it issues no ID tokens; an ID token would","+  last 5 minutes. Nobody manages clients through the provider's endpoints","+  (`clientPrivileges` refuses every action), and none registers itself.","+- Neither plugin's routes are mounted. Ghost issues and validates app tokens","+  through the provider's server API, so every path either plugin declares is","+  in `disabledPaths` (`appOAuthDisabledPaths`): token, authorize,","+  introspection, revocation, userinfo, end-session, consent, registration and","+  client management, `jwt`'s session JWT (`/token`) and signing keys","+  (`/jwks`), and the metadata the provider serves from `onRequest`","+  (`/.well-known/oauth-authorization-server`,","+  `/.well-known/openid-configuration`), so it advertises nothing. The list is","+  read from the plugins, so a route an upgrade adds is disabled too; a test","+  fails if one takes a path parameter, which `disabledPaths` can't match.","+- The provider supports no standard grant (`grantTypes` is empty), so its","+  token endpoint refuses every grant even when called on the server.","+- Registering the provider adds its hooks to every site with the flag on: a","+  request whose body carries `oauth_query` must carry the provider's","+  signature, a response that sets a session cookie resumes a pending","+  authorization (there never is one), and deleting a session runs back-channel","+  logout for clients that registered a URI (none does).","+","+The provider's per-IP rate limits don't apply: the `customStorage` limiter","+allows every path it doesn't map.","+"," ## Running Better Auth locally"," "," On MySQL, as the Docker dev setup uses, only the engine needs switching (on","@@ -183,6 +224,15 @@ SQLite Ghost stays on `legacy`):"," auth__engine=better-auth pnpm dev:up"," ```"," ","+Apps need the `apps` flag on when Ghost boots, as well as the engine:","+","+```bash","+auth__engine=better-auth labs__apps=true pnpm dev:up","+```","+","+The e2e API suites run apps under `pnpm nx run ghost:test:e2e:better-auth`,","+which sets both.","+"," Or set `\"auth\": {\"engine\": \"better-auth\"}` in `ghost/config.local.json`. Legacy"," session cookies are not read, so staff sign in again once, and again after"," switching back to `legacy`. Sign-in pins each session to the admin origin, so"],"additions":50,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/create-auth.ts","lines":["@@ -7,6 +7,7 @@ import { CLIENT_IP_HEADER } from './client-ip';"," import { createKnexAdapter } from './knex-adapter';"," import { rateLimitStorage, type Limiters } from './rate-limit';"," import { ghostSso } from './plugins/sso';","+import { appOAuthDisabledPaths, appOAuthPlugins } from './plugins/apps';"," import {","   DEVICE_TRUST_COOKIE,","   ghostDeviceVerification,","@@ -57,6 +58,11 @@ export type CreateAuthDeps = {","   sendDeviceVerificationCode(message: DeviceVerificationCode): Promise<void>;","   /** The legacy session's origin rule (Origin, else Referer, else the admin URL) */","   getRequestOrigin(headers: Headers): string | null;","+  /**","+   * Registers the OAuth provider and jwt plugins, which issue app tokens. Plugins are","+   * fixed at boot, so this is the `apps` flag then, and only once their tables exist.","+   */","+  apps: boolean;"," };"," "," type SessionPins = { userId?: string; verified?: boolean; origin?: string | null };","@@ -101,6 +107,7 @@ export function createAuth(deps: CreateAuthDeps) {","   const adminOrigin = urlUtils.getAdminOrigin();","   // The cookie lives on the admin origin, so its security follows the admin URL","   const ssl = urlUtils.isSSL(adminOrigin);","+  const appPlugins = deps.apps ? appOAuthPlugins({ adminOrigin }) : [];"," ","   return betterAuth({","     // Also Better Auth's only trusted origin, matching the legacy login-CSRF check","@@ -155,6 +162,7 @@ export function createAuth(deps: CreateAuthDeps) {","       ROUTES.changeEmail,","       ROUTES.deleteUser,","       ROUTES.signInSocial,","+      ...appOAuthDisabledPaths(appPlugins),","     ],","     hooks: {","       // A password change ends every other session, as PUT /users/password does","@@ -232,6 +240,7 @@ export function createAuth(deps: CreateAuthDeps) {","         emailLimiter: deps.limiters.verificationEmail,","         sendCode: deps.sendDeviceVerificationCode,","       }),","+      ...appPlugins,","     ],","     telemetry: { enabled: false },","     logger: {"],"additions":9,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/index.ts","lines":["@@ -3,6 +3,7 @@ import * as security from '@tryghost/security';"," import { defineService } from '../../../kernel/define-service';"," import { createAuth, type GhostAuth } from './create-auth';"," import { createSignInCodeEmail } from '../emails/sign-in-code';","+import { APP_OAUTH_TABLES } from './plugins/apps';"," "," export type { GhostAuth } from './create-auth';"," ","@@ -17,6 +18,21 @@ export default defineService('Better Auth', async (): Promise<GhostAuth> => {","   const { GhostMailer } = require('../../lib/mail');","   const { t } = require('../../../shared/i18n');","   const { blogIcon } = require('../../lib/image');","+  const labs = require('../../../shared/labs');","+  const { getTables } = require('../../data/schema/commands');","+","+  // In-development tables exist only in development and testing databases","+  const hasAppTables = async () => {","+    const tables: string[] = await getTables(knex);","+    const missing = APP_OAUTH_TABLES.filter((table) => !tables.includes(table));","+    if (missing.length) {","+      logging.warn(","+        `Apps are turned on, but their tables are missing, so apps can't open: ${missing.join(', ')}`,","+      );","+    }","+    return !missing.length;","+  };","+  const apps = labs.isSet('apps') && (await hasAppTables());"," ","   const auth = createAuth({","     db: knex,","@@ -55,6 +71,7 @@ export default defineService('Better Auth', async (): Promise<GhostAuth> => {","     }),","     getRequestOrigin: (headers) =>","       require('../session').default.getOriginOfRequest({ headers: Object.fromEntries(headers) }),","+    apps,","   });","   // betterAuth() defers its setup to this promise; awaiting it fails boot, not the first request","   await auth.$context;"],"additions":17,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/plugins/apps.ts","lines":["@@ -0,0 +1,64 @@","+import type { BetterAuthPlugin } from 'better-auth';","+import { jwt } from 'better-auth/plugins';","+import { oauthProvider, type OAuthOptions, type Scope } from '@better-auth/oauth-provider';","+import { ghostJwtSchema, ghostOAuthProviderSchema } from '../ghost-models';","+import { APP_TOKEN_PREFIX } from '../../app-token-prefix';","+","+/** The tables the provider and jwt plugins need; neither is registered without them. */","+export const APP_OAUTH_TABLES: readonly string[] = [","+  ...Object.values(ghostOAuthProviderSchema).map(({ modelName }) => modelName),","+  ghostJwtSchema.jwks.modelName,","+];","+","+export type AppProviderOptions = {","+  /** Better Auth's `baseURL`: the admin origin */","+  adminOrigin: string;","+};","+","+/** The provider's options. */","+export function appProviderOptions({ adminOrigin }: AppProviderOptions) {","+  // No client can reach the authorize endpoint, so neither page is ever shown","+  const adminPage = `${adminOrigin}/ghost/`;","+  return {","+    schema: ghostOAuthProviderSchema,","+    loginPage: adminPage,","+    consentPage: adminPage,","+    // Ghost holds every token to the installation's approved scopes itself","+    scopes: [],","+    // Ghost issues every token itself, so the token endpoint accepts no grant and the","+    // authorize endpoint answers 404","+    grantTypes: [],","+    // Provider-wide; ID tokens are only for apps","+    idTokenExpiresIn: 300,","+    prefix: { opaqueAccessToken: APP_TOKEN_PREFIX },","+    // Clients are written by Ghost; nobody manages them through the provider's endpoints","+    clientPrivileges: () => false,","+  } satisfies OAuthOptions<Scope[]>;","+}","+","+/** The provider and the jwt plugin it signs with, registered only while apps can use them. */","+export function appOAuthPlugins(options: AppProviderOptions) {","+  return [","+    jwt({ schema: ghostJwtSchema, disableSettingJwtHeader: true }),","+    oauthProvider(appProviderOptions(options)),","+  ] as const;","+}","+","+/**","+ * The provider and jwt routes left mounted. Ghost issues and validates app tokens through the","+ * provider's server API, so it serves none of them.","+ */","+export const APP_OAUTH_MOUNTED_PATHS: readonly string[] = [];","+","+/**","+ * Every path the plugins declare but the mounted ones, so a route an upgrade adds is disabled","+ * too. Server-only paths are included: the provider serves its metadata paths from `onRequest`.","+ */","+export function appOAuthDisabledPaths(plugins: readonly BetterAuthPlugin[]): string[] {","+  const paths = plugins.flatMap((plugin) =>","+    Object.values(plugin.endpoints ?? {}).map((endpoint) => endpoint.path),","+  );","+  return [...new Set(paths)].filter(","+    (path): path is string => !!path && !APP_OAUTH_MOUNTED_PATHS.includes(path),","+  );","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"ghost/package.json","lines":["@@ -58,9 +58,10 @@","     \"test:unit\": \"vitest run\",","     \"test:integration\": \"vitest run -c vitest.config.db.ts --project integration --project integration-migrations\",","     \"test:e2e\": \"vitest run -c vitest.config.db.ts --project e2e --project e2e-api --project e2e-isolated\",","-    \"test:e2e:better-auth\": \"auth__engine=better-auth vitest run -c vitest.config.db.ts --project e2e-api --project e2e-isolated\",","+    \"test:e2e:better-auth\": \"auth__engine=better-auth labs__apps=true vitest run -c vitest.config.db.ts --project e2e-api --project e2e-isolated\",","     \"test:legacy\": \"vitest run -c vitest.config.db.ts --project legacy\",","     \"test:ci:e2e\": \"COVERAGE_LANE=e2e pnpm test:e2e --coverage\",","+    \"test:ci:e2e:better-auth\": \"COVERAGE_LANE=e2e-better-auth pnpm test:e2e:better-auth --coverage\",","     \"test:ci:integration\": \"COVERAGE_LANE=integration pnpm test:integration --coverage\",","     \"test:ci:unit\": \"vitest run --coverage --coverage.reportsDirectory=coverage-unit --coverage.reporter=cobertura --coverage.reporter=text-summary\",","     \"test:int:slow\": \"pnpm test:integration\",","@@ -372,6 +373,15 @@","           \"{projectRoot}/coverage-e2e/cobertura-coverage.xml\"","         ]","       },","+      \"test:ci:e2e:better-auth\": {","+        \"dependsOn\": [","+          \"build:assets\",","+          \"^build\"","+        ],","+        \"outputs\": [","+          \"{projectRoot}/coverage-e2e-better-auth/cobertura-coverage.xml\"","+        ]","+      },","       \"test:ci:integration\": {","         \"dependsOn\": [","           \"build:assets\","],"additions":11,"deletions":1,"truncated":false},{"path":"ghost/test/e2e-api/admin/credential-passwords.test.ts","lines":["@@ -52,6 +52,7 @@ function betterAuth() {","     isEmailMfaRequired: () => false,","     sendDeviceVerificationCode: async () => {},","     getRequestOrigin: (headers) => headers.get('origin'),","+    apps: false,","   });","   const origin = urlUtils.getAdminOrigin();"," "],"additions":1,"deletions":0,"truncated":false},{"path":"ghost/test/integration/auth/app-oauth-provider.test.ts","lines":["@@ -0,0 +1,200 @@","+import assert from 'node:assert/strict';","+import * as security from '@tryghost/security';","+import { knex } from '../../../core/server/data/db';","+import config from '../../../core/shared/config';","+import urlUtils from '../../../core/shared/url-utils';","+import { createAuth } from '../../../core/server/auth/better-auth/create-auth';","+import {","+  APP_OAUTH_MOUNTED_PATHS,","+  appOAuthPlugins,","+} from '../../../core/server/auth/better-auth/plugins/apps';","+","+// @ts-expect-error Test utilities do not have type definitions.","+import testUtils from '../../utils';","+","+const allow = () => ({ consume: async () => ({ allowed: true as const }), reset: async () => {} });","+const limiters = {","+  globalBlock: allow,","+  globalReset: allow,","+  userLogin: allow,","+  userReset: allow,","+  sendVerificationCode: allow,","+  userVerification: allow,","+  verificationEmail: allow,","+};","+","+function build({ apps }: { apps: boolean }) {","+  return createAuth({","+    db: knex,","+    secret: 'a'.repeat(64),","+    sessionMaxAgeMs: config.get('admin:sessionMaxAgeMs'),","+    urlUtils,","+    password: security.password,","+    logger: { debug() {}, info() {}, warn() {}, error() {} },","+    limiters,","+    sendPasswordResetEmail: async () => {},","+    isStaffDeviceVerificationEnabled: () => false,","+    isEmailMfaRequired: () => false,","+    sendDeviceVerificationCode: async () => {},","+    getRequestOrigin: (headers) => headers.get('origin'),","+    apps,","+  });","+}","+","+type AppRoute = { method: string; path: string; serverOnly: boolean };","+","+/** Every route the provider and jwt plugins declare, one per method */","+function appRoutes(): AppRoute[] {","+  return appOAuthPlugins({ adminOrigin: urlUtils.getAdminOrigin() }).flatMap((plugin) =>","+    Object.values(plugin.endpoints).flatMap(({ path, options }) => {","+      if (!path) {","+        return [];","+      }","+      const methods = Array.isArray(options.method) ? options.method : [options.method];","+      const serverOnly = options.metadata?.SERVER_ONLY === true;","+      return methods.map((method: string) => ({ method, path, serverOnly }));","+    }),","+  );","+}","+","+describe(\"Better Auth's OAuth provider for apps\", function () {","+  const owner = testUtils.DataGenerator.Content.users[0];","+  const origin = urlUtils.getAdminOrigin();","+  const url = (path: string) => `${origin}${urlUtils.getSubdir()}/ghost/api/admin/auth${path}`;","+","+  beforeAll(testUtils.teardownDb);","+  beforeAll(testUtils.setup('users:roles'));","+","+  afterEach(async function () {","+    await knex('oauth_clients').del();","+    await knex('oauth_jwks').del();","+    await knex('user_sessions').del();","+  });","+","+  async function signIn(auth: ReturnType<typeof build>) {","+    const response = await auth.handler(","+      new Request(url('/sign-in/email'), {","+        method: 'POST',","+        headers: { 'content-type': 'application/json', origin },","+        body: JSON.stringify({ email: owner.email, password: owner.password }),","+      }),","+    );","+    assert.equal(response.status, 200);","+    return {","+      response,","+      cookie: response.headers","+        .getSetCookie()","+        .map((c) => c.split(';')[0])","+        .join('; '),","+    };","+  }","+","+  describe('without apps', function () {","+    it('serves none of the provider routes and sends no JWT on session reads', async function () {","+      const auth = build({ apps: false });","+      const { cookie } = await signIn(auth);","+","+      for (const { method, path } of appRoutes()) {","+        const response = await auth.handler(","+          new Request(url(path.replace(/:[^/]+/g, 'x')), {","+            method,","+            headers: {","+              cookie,","+              origin,","+              ...(method === 'GET' ? {} : { 'content-type': 'application/json' }),","+            },","+            ...(method === 'GET' ? {} : { body: '{}' }),","+          }),","+        );","+        assert.equal(response.status, 404, `${method} ${path}`);","+      }","+      const session = await auth.handler(new Request(url('/get-session'), { headers: { cookie } }));","+      assert.equal(session.status, 200);","+      assert.equal(session.headers.get('set-auth-jwt'), null);","+    });","+  });","+","+  describe('with apps', function () {","+    it('registers no OpenID scope, so it serves no OpenID configuration', async function () {","+      const auth = build({ apps: true });","+","+      await assert.rejects(auth.api.getOpenIdConfig(), { statusCode: 404 });","+    });","+","+    it('serves none of the provider or jwt routes, signed in or not', async function () {","+      const auth = build({ apps: true });","+      const { cookie } = await signIn(auth);","+","+      const disabled = appRoutes().filter(({ path }) => !APP_OAUTH_MOUNTED_PATHS.includes(path));","+      assert.ok(disabled.length > 0);","+      for (const { method, path } of disabled) {","+        const requestPath = path.replace(/:[^/]+/g, 'x');","+        for (const variant of [requestPath, `${requestPath}/`, requestPath.toUpperCase()]) {","+          for (const headers of [{}, { cookie }] as Array<Record<string, string>>) {","+            const response = await auth.handler(","+              new Request(url(variant), {","+                method,","+                headers: {","+                  origin,","+                  ...headers,","+                  ...(method === 'GET' ? {} : { 'content-type': 'application/json' }),","+                },","+                ...(method === 'GET' ? {} : { body: '{}' }),","+              }),","+            );","+            assert.equal(response.status, 404, `${method} ${variant}`);","+          }","+        }","+      }","+      assert.equal((await knex('oauth_clients').count({ count: '*' }))[0].count, 0);","+      assert.equal((await knex('oauth_jwks').count({ count: '*' }))[0].count, 0);","+    });","+","+    it('leaves no provider or jwt route mounted that is neither disabled nor deliberately kept', async function () {","+      const auth = build({ apps: true });","+      const disabledPaths: string[] = auth.options.disabledPaths ?? [];","+","+      assert.deepEqual(APP_OAUTH_MOUNTED_PATHS, [] as string[]);","+      for (const { path, serverOnly } of appRoutes()) {","+        if (serverOnly || APP_OAUTH_MOUNTED_PATHS.includes(path)) {","+          continue;","+        }","+        // disabledPaths compares whole paths, so it can't disable a route with a parameter","+        assert.ok(!path.includes(':'), `${path} takes a parameter`);","+        assert.ok(disabledPaths.includes(path), `${path} is mounted`);","+      }","+    });","+","+    it('supports none of the standard grants', async function () {","+      const auth = build({ apps: true });","+","+      for (const grantType of ['authorization_code', 'client_credentials', 'refresh_token']) {","+        await assert.rejects(","+          auth.api.oauth2Token({","+            body: {","+              grant_type: grantType,","+              client_id: 'any',","+              client_secret: 'any',","+              code: 'any',","+              refresh_token: 'any',","+            },","+          } as never),","+          (err: { body?: { error?: string } }) => err.body?.error === 'unsupported_grant_type',","+          grantType,","+        );","+      }","+    });","+","+    it('sends no JWT on session reads and serves no session JWT', async function () {","+      const auth = build({ apps: true });","+      const { cookie } = await signIn(auth);","+","+      const session = await auth.handler(new Request(url('/get-session'), { headers: { cookie } }));","+      const jwtToken = await auth.handler(new Request(url('/token'), { headers: { cookie } }));","+","+      assert.equal(session.status, 200);","+      assert.equal(session.headers.get('set-auth-jwt'), null);","+      assert.equal(jwtToken.status, 404);","+    });","+  });","+});"],"additions":200,"deletions":0,"truncated":false},{"path":"ghost/test/integration/auth/create-auth.test.ts","lines":["@@ -49,6 +49,7 @@ describe.skipIf(isSQLite)('Better Auth instance', function () {","       sendDeviceVerificationCode: async () => {},","       getRequestOrigin: (headers) =>","         legacySession.getOriginOfRequest({ headers: Object.fromEntries(headers) } as never),","+      apps: false,","     });","   }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/auth/better-auth/client-ip.test.ts","lines":["@@ -66,6 +66,7 @@ describe('setClientIPHeader', function () {","       isEmailMfaRequired: () => false,","       sendDeviceVerificationCode: async () => {},","       getRequestOrigin: (headers) => headers.get('origin'),","+      apps: false,","     });","     const { options } = await auth.$context;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/auth/better-auth/create-auth.test.ts","lines":["@@ -47,6 +47,7 @@ function deps({","     isEmailMfaRequired: () => false,","     sendDeviceVerificationCode: async () => {},","     getRequestOrigin: (headers) => headers.get('origin'),","+    apps: false,","   };"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/auth/better-auth/index.test.ts","lines":["@@