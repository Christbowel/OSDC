urce,","+        string $fq_classlike_name,","+        string $method_name,","+        string $called_fq_classlike_name,","+        PhpParser\\Node\\Expr\\MethodCall $stmt,","+        Context $context,","+        CodeLocation $code_location,","+    ): ?int {","+        foreach (self::$handlers[strtolower($fq_classlike_name)] ?? [] as $class_handler) {","+            $result = $class_handler(new MethodCapabilitiesProviderEvent(","+                $statements_source,","+                $fq_classlike_name,","+                strtolower($method_name),","+                $called_fq_classlike_name,","+                $stmt,","+                $context,","+                $code_location,","+            ));","+","+            if ($result !== null) {","+                return $result;","+            }","+        }","+","+        return null;","+    }","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"src/Psalm/Plugin/EventHandler/Event/MethodCapabilitiesProviderEvent.php","lines":["@@ -0,0 +1,86 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Psalm\\Plugin\\EventHandler\\Event;","+","+use PhpParser;","+use Psalm\\CodeLocation;","+use Psalm\\Context;","+use Psalm\\StatementsSource;","+","+/**","+ * @psalm-immutable","+ * @api","+ */","+final class MethodCapabilitiesProviderEvent","+{","+    /**","+     * @param lowercase-string $method_name_lowercase","+     * @internal","+     * @psalm-mutation-free","+     */","+    public function __construct(","+        private readonly StatementsSource $source,","+        private readonly string $fq_classlike_name,","+        private readonly string $method_name_lowercase,","+        private readonly string $called_fq_classlike_name,","+        private readonly PhpParser\\Node\\Expr\\MethodCall $stmt,","+        private readonly Context $context,","+        private readonly CodeLocation $code_location,","+    ) {","+    }","+","+    public function getSource(): StatementsSource","+    {","+        return $this->