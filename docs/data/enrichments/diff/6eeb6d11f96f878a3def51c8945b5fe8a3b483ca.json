,"@@ -705,9 +712,10 @@ struct KeyGenContext {"," };"," extern KeyGenContext key_gen_ctx;"," ","-// Generate a variable length key string from the given int64 val. The","-// order of the keys is preserved. The key could be anywhere from 8 to","-// max_key_len * 8 bytes.","+// Generate a key string from the given int64 val. With","+// --structured_key_value, StructuredKey() returns a 12- or 20-byte key (see","+// db_stress_structured_key_value.h). Otherwise, the order of the keys is","+// preserved and the key can be anywhere from 8 to max_key_len * 8 bytes."," // The algorithm picks the length based on the"," // offset of the val within a configured window and the distribution of the"," // number of keys of various lengths in that window. For example, if x, y, x are","@@ -716,6 +724,9 @@ extern KeyGenContext key_gen_ctx;"," // {(x-1),0}..{(x-1),(y-1)},{(x-1),(y-1),0}..{(x-1),(y-1),(z-1)} and so on."," // Additionally, a trailer of 0-7 bytes could be appended."," inline std::string Key(int64_t val) {","+  if (FLAGS_structured_key_value) {","+    return StructuredKey(static_cast<uint64_t>(val));","+  }","   uint64_t window = key_gen_ctx.window;","   size_t levels = key_gen_ctx.weights.size();","   std::string key;","@@ -754,6 +765,9 @@ inline std::string Key(int64_t val) {"," "," // Given a string key, map it to an index into the expected values buffer"," inline bool GetIntVal(std::string big_endian_key, uint64_t* key_p) {","+  if (FLAGS_structured_key_value) {","+    return StructuredKeyToIndex(big_endian_key, key_p);","+  }","   size_t size_key = big_endian_key.size();","   std::vector<uint64_t> prefixes;"," ","@@ -796,6 +810,10 @@ inline bool GetIntVal(std::string big_endian_key, uint64_t* key_p) {"," // expected values buffer."," inline bool GetFirstIntValInPrefix(std::string big_endian_prefix,","                                    uint64_t* key_p) {","+  if (FLAGS_structured_key_value) {","+    *key_p = StructuredKeyLowerBound(big_endian_prefix);","+    return true;","+  }","   size_t size_key = big_endian_prefix.size();","   // Pad with zeros to make it a multiple of 8. This function may be called","   // with a prefix, in which case we return the first index that falls"],"additions":21,"deletions":3,"truncated":false},{"path":"db_stress_tool/db_stress_compaction_filter.h","lines":["@@ -149,18 +149,10 @@ class DbStressCompactionFilter : public CompactionFilter {","     if (value.size() < sizeof(uint32_t)) {","       return false;","     }","-    const uint32_t value_base = GetValueBase(value);","+    char expected[kValueMaxLen];","     const size_t expected_size =","-        ((value_base % kRandomValueMaxFactor) + 1) * FLAGS_value_size_mult;","-    if (value.size() != expected_size) {","-      return false;","-    }","-    for (size_t i = sizeof(uint32_t); i < value.size(); ++i) {","-      if (value[i] != static_cast<char>(value_base ^ i)) {","-        return false;","-      }","-    }","-    return true;","+        GenerateValue(GetValueBase(value), expected, sizeof(expected));","+    return value == Slice(expected, expected_size);","   }"," ","   Decision FilterMergeBeforeFilter(const Slice& key, ValueType value_type,"],"additions":3,"deletions":11,"truncated":false},{"path":"db_stress_tool/db_stress_gflags.cc","lines":["@@ -794,6 +794,39 @@ DEFINE_int32(read_index, -1,"," DEFINE_bool(use_full_external_table, false,","             \"Use the simple full external table test factory.\");"," ","+DEFINE_string(table_factory_uri, \"\",","+              \"URI of a TableFactory to create with \"","+              \"TableFactory::CreateFromString(), such as one registered with \"","+              \"ObjectLibrary. Replaces the block-based table factory, so the \"","+              \"block-based table flags, the shared block cache and the filter \"","+              \"policy do not apply to it. A non-block-based factory requires \"","+              \"--compaction_ttl=0 and --periodic_compaction_seconds=0. Empty \"","+              \"means none.\");","+","+DEFINE_bool(structured_key_value, false,","+            \"Generate schema-like keys and versioned row values instead of \"","+            \"the default keys and values. See \"","+            \"db_stress_structured_key_value.h for the formats.\");","+","+DEFINE_uint64(structured_keys_per_key_space, 4096,","+              \"Number of consecutive key indexes in each key space of \"","+              \"structured_key_value.\");","+","+DEFINE_uint64(structured_key_fanout, 16,","+              \"Number of keys that share the first 8-byte field of a two-field \"","+              \"structured_key_value key.\");","+","+DEFINE_string(structured_key_space_type_weights, \"2,3,2\",","+              \"Comma-separated weights of the key-space types of \"","+              \"structured_key_value, at most 8. Type 0 key spaces have \"","+              \"single-field keys, the other types two-field keys.\");","+","+DEFINE_string(structured_value_version_weights,","+              \"1:30,2:30,3:20,4:3,5:8,6:4,7:3,128:2\",","+              \"Comma-separated version:weight pairs of the row versions of \"","+              \"structured_key_value values. Versions are in [1, 255], and a \"","+              \"version that is a multiple of 4 has an opaque layout.\");","+"," DEFINE_bool(test_backward_scan, true,","             \"Test backward iteration (Prev, SeekForPrev) in stress tests.\");"," ","@@ -1300,10 +1333,16 @@ DEFINE_bool(in_place_update, false, \"On true, does inplace update in memtable\");"," "," DEFINE_string(memtablerep, \"skip_list\", \"\");"," ","+// db_stress_tool.cc further limits the prefix size to the shortest key of the","+// configured key generator."," inline static bool ValidatePrefixSize(const char* flagname, int32_t value) {","-  if (value < -1 || value > 8) {","-    fprintf(stderr, \"Invalid value for --%s: %d. -1 <= PrefixSize <= 8\\n\",","-            flagname, value);","+  if (value < -1 ||","+      value > static_cast<int32_t>(","+                  ROCKSDB_NAMESPACE::kStructuredSingleFieldKeySize)) {","+    fprintf(","+        stderr, \"Invalid value for --%s: %d. -1 <= PrefixSize <= %d\\n\",","+        flagname, value,","+        static_cast<int32_t>(ROCKSDB_NAMESPACE::kStructuredSingleFieldKeySize));","     return false;","   }","   return true;"],"additions":42,"deletions":3,"truncated":false},{"path":"db_stress_tool/db_stress_structured_key_value.cc","lines":["@@ -0,0 +1,328 @@","+//  Copyright (c) Meta Platforms, Inc. and affiliates.","+//  This source code is licensed under both the GPLv2 (found in the","+//  COPYING file in the root directory) and Apache 2.0 License","+//  (found in the LICENSE.Apache file in the root directory).","+","+#ifdef GFLAGS","+#include \"db_stress_tool/db_stress_structured_key_value.h\"","+","+#include <algorithm>","+#include <cassert>","+#include <cstring>","+#include <limits>","+","+#include \"util/cast_util.h\"","+#include \"util/coding_lean.h\"","+","+namespace ROCKSDB_NAMESPACE {","+","+StructuredKeyValueContext structured_kv_ctx;","+","+namespace {","+","+constexpr uint64_t kValueVersionSeed = 0x5bd1e995;","+constexpr uint32_t kTimeMultiplier = 2654435761u;","+constexpr size_t kMaxFieldSize = 40;","+constexpr size_t kMinOpaqueValueSize = 8;","+constexpr uint8_t kField1NullFlag = 1;","+constexpr uint8_t kField2NullFlag = 2;","+","+// The splitmix64 finalizer, which spreads key-space indexes and value bases","+// evenly over the weights.","+uint64_t Mix(uint64_t x) {","+  x += 0x9E3779B97F4A7C15ULL;","+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;","+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;","+  return x ^ (x >> 31);","+}","+","+size_t PickWeighted(const std::vector<uint64_t>& weight_sums, uint64_t hash) {","+  assert(!weight_sums.empty() && weight_sums.back() > 0);","+  const uint64_t point = hash % weight_sums.back();","+  return static_cast<size_t>(","+      std::upper_bound(weight_sums.begin(), weight_sums.end(), point) -","+      weight_sums.begin());","+}","+","+uint32_t KeySpaceType(uint64_t key_space) {","+  return static_cast<uint32_t>(PickWeighted(","+      structured_kv_ctx.key_space_type_weight_sums, Mix(key_space)));","+}","+","+void AppendBigEndian(uint64_t value, size_t bytes, std::string* out) {","+  for (size_t i = bytes; i > 0; --i) {","+    out->push_back(static_cast<char>((value >> (8 * (i - 1))) & 0xffu));","+  }","+}","+","+uint64_t DecodeBigEndian(const char* data, size_t bytes) {","+  uint64_t value = 0;","+  for (size_t i = 0; i < bytes; ++i) {","+    unsigned char byte;","+    std::memcpy(&byte, data + i, 1);","+    value = (value << 8) | byte;","+  }","+  return value;","+}","+","+void PutByte(char* out, uint8_t byte) { std::memcpy(out, &byte, 1); }","+","+// Parses \"w0,w1,...\" into running sums of the weights.","+Status ParseWeights(const std::string& text, size_t max_entries,","+                    std::vector<uint64_t>* weight_sums) {","+  weight_sums->clear();","+  uint64_t sum = 0;","+  size_t pos = 0;","+  while (pos <= text.size()) {","+    const size_t end = std::min(text.find(',', pos), text.size());","+    const std::string entry = text.substr(pos, end - pos);","+    if (entry.empty() ||","+        entry.find_first_not_of(\"0123456789\") != std::string::npos ||","+        entry.size() > 9) {","+      return Status::InvalidArgument(\"Bad weight\", entry);","+    }","+    sum += std::stoull(entry);","+    weight_sums->push_back(sum);","+    pos = end + 1;","+  }","+  if (weight_sums->size() > max_entries) {","+    return Status::InvalidArgument(\"Too many weights\", text);","+  }","+  if (sum == 0) {","+    return Status::InvalidArgument(\"Weights must not all be zero\", text);","+  }","+  return Status::OK();","+}","+","+// Parses \"version:weight,...\" into versions and running sums of the weights.","+Status ParseVersionWeights(const std::string& text,","+                           std::vector<uint8_t>* versions,","+                           std::vector<uint64_t>* weight_sums) {","+  versions->clear();","+  std::string weights;","+  size_t pos = 0;","+  while (pos <= text.size()) {","+    const size_t end = std::min(text.find(',', pos), text.size());","+    const std::string entry = text.substr(pos, end - pos);","+    const size_t colon = entry.find(':');","+    const std::string version = entry.substr(0, colon);","+    if (colon == std::string::npos || version.empty() ||","+        version.find_first_not_of(\"0123456789\") != std::string::npos ||","+        version.size() > 3) {","+      return Status::InvalidArgument(\"Bad version weight\", entry);","+    }","+    const uint64_t parsed = std::stoull(version);","+    if (parsed < 1 || parsed > std::numeric_limits<uint8_t>::max()) {","+      return Status::InvalidArgument(\"Version must be in [1, 255]\", entry);","+    }","+    versions->push_back(static_cast<uint8_t>(parsed));","+    if (!weights.empty()) {","+      weights.push_back(',');","+    }","+    weights.append(entry.substr(colon + 1));","+    pos = end + 1;","+  }","+  return ParseWeights(weights, versions->size(), weight_sums);","+}","+","+size_t FieldSize(uint64_t factor) {","+  return std::min(kMaxFieldSize, static_cast<size_t>(factor) *","+                                     structured_kv_ctx.value_size_mult / 2);","+}","+","+size_t AppendField(uint32_t value_base, uint32_t field, size_t size, char* v) {","+  PutByte(v, static_cast<uint8_t>(size));","+  for (size_t i = 0; i < size; ++i) {","+    PutByte(v + 1 + i, static_cast<uint8_t>(value_base + 31 * field +","+                                            7 * static_cast<uint32_t>(i)));","+  }","+  return size + 1;","+}","+","+}  // namespace","+","+Status InitStructuredKeyValueContext(uint64_t keys_per_key_space,","+                                     uint64_t key_fanout,","+                                     const std::string& key_space_type_weights,","+                                     const std::string& value_version_weights,","+                                     size_t value_size_mult, int64_t max_key) {","+  StructuredKeyValueContext ctx;","+  if (keys_per_key_space == 0 ||","+      keys_per_key_space > std::numeric_limits<uint32_t>::max()) {","+    return Status::InvalidArgument(","+        \"structured_keys_per_key_space must be in [1, 2^32)\");","+  }","+  if (key_fanout == 0 || key_fanout > std::numeric_limits<uint32_t>::max()) {","+    return Status::InvalidArgument(","+        \"structured_key_fanout must be in [1, 2^32)\");","+  }","+  const uint64_t last_key_space =","+      max_key > 0 ? lossless_cast<uint64_t>(max_key - 1) / keys_per_key_space","+                  : 0;","+  if (last_key_space >= (uint64_t{1} << 32) / kMaxStructuredKeySpaceTypes) {","+    return Status::InvalidArgument(","+        \"max_key / structured_keys_per_key_space is too large for 4-byte \"","+        \"key-space ids\");","+  }","+  ctx.keys_per_key_space = keys_per_key_space;","+  ctx.key_fanout = key_fanout;","+  ctx.value_size_mult = value_size_mult;","+  Status s = ParseWeights(key_space_type_weights, kMaxStructuredKeySpaceTypes,","+                          &ctx.key_space_type_weight_sums);","+  if (s.ok()) {","+    s = ParseVersionWeights(value_version_weights, &ctx.value_versions,","+                            &ctx.value_version_weight_sums);","+  }","+  if (s.ok()) {","+    structured_kv_ctx = std::move(ctx);","+  }","+  return s;","+}","+","+std::string StructuredKey(uint64_t key_index) {","+  const uint64_t key_space = key_index / structured_kv_ctx.keys_per_key_space;","+  const uint64_t offset = key_index % structured_kv_ctx.keys_per_key_space;","+  const uint32_t type = KeySpaceType(key_space);","+  std::string key;","+  key.reserve(kStructuredTwoFieldKeySize);","+  AppendBigEndian(key_space * kMaxStructuredKeySpaceTypes + type,","+                  kStructuredKeySpaceIdSize, &key);","+  if (type == 0) {","+    AppendBigEndian(offset, sizeof(uint64_t), &key);","+  } else {","+    AppendBigEndian(offset / structured_kv_ctx.key_fanout, sizeof(uint64_t),","+                    &key);","+    AppendBigEndian(offset % structured_kv_ctx.key_fanout, sizeof(uint64_t),","+                    &key);","+  }","+  return key;","+}","+","+bool StructuredKeyToIndex(const Slice& key, uint64_t* key_index) {","+  if (key.size() < kStructuredKeySpaceIdSize) {","+    return false;","+  }","+  const uint64_t id = DecodeBigEndian(key.data(), kStructuredKeySpaceIdSize);","+  const uint64_t key_space = id / kMaxStructuredKeySpaceTypes;","+  const uint64_t type = id % kMaxStructuredKeySpaceTypes;","+  if (type != KeySpaceType(key_space)) {","+    return false;","+  }","+  const char* fields = key.data() + kStructuredKeySpaceIdSize;","+  uint64_t offset = 0;","+  if (type == 0) {","+    if (key.size() != kStructuredSingleFieldKeySize) {","+      return false;","+    }","+    offset = DecodeBigEndian(fields, sizeof(uint64_t));","+  } else {","+    if (key.size() != kStructuredTwoFieldKeySize) {","+      return false;","+    }","+    const uint64_t high = DecodeBigEndian(fields, sizeof(uint64_t));","+    const uint64_t low =","+        DecodeBigEndian(fields + sizeof(uint64_t), sizeof(uint64_t));","+    if (low >= structured_kv_ctx.key_fanout ||","+        high >= structured_kv_ctx.keys_per_key_space) {","+      return false;","+    }","+    offset = high * structured_kv_ctx.key_fanout + low;","+  }","+  if (offset >= structured_kv_ctx.keys_per_key_space) {","+    return false;","+  }","+  *key_index = key_space * structured_kv_ctx.keys_per_key_space + offset;","+  return true;","+}","+","+uint64_t StructuredKeyLowerBound(const Slice& key) {","+  const uint64_t keys_per_key_space = structured_kv_ctx.keys_per_key_space;","+  const uint64_t fanout = structured_kv_ctx.key_fanout;","+  // Pads the key with zeros to the longest key, which only moves it down to","+  // the first key it is a prefix of.","+  char padded[kStructuredTwoFieldKeySize] = {};","+  std::memcpy(padded, key.data(),","+              std::min(key.size(