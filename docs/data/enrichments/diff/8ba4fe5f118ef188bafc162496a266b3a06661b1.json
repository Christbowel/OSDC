apture_sizes\": [1, 4],","+            },","+            **kwargs,","+        ) as runner:","+            worker = _get_hisparse_worker(runner)","+            assert worker.host_caches","+            assert not any(cache.is_cuda for cache in worker.host_caches)","+            engine_core = runner.llm.llm_engine.engine_core.engine_core","+            model_runner = engine_core.model_executor.driver_worker.worker.model_runner","+            caches = {","+                name: (","+                    cache.dtype,","+                    cache.device.type,","+                    tuple(cache.shape),","+                    cache.untyped_storage().nbytes(),","+                )","+                for name, cache in model_runner.kv_caches_by_layer.items()","+            }","+            outputs = [","+                runner.generate_greedy([prompt], max_tokens=16)[0] for prompt in prompts","+            ]","+            return model_runner.kv_cache_config.num_blocks, caches, outputs","+","+    prompts = [[1000 + i % 64 for i in range(2500)], [7, 8, 9]]","+    num_blocks, extensible_caches, extensible = run(enable_extensible_kv_cache=True)","+    _, fixed_caches, fixed = run(","+        enable_extensible_kv_cache=False, num_gpu_blocks_override=num_blocks","+    )","+","+    assert extensible_caches == fixed_caches","+    assert extensible == fixed","+","+"," @pytest.mark.skipif(","     not current_platform.is_cuda(), reason=\"HiSparse requires NVIDIA CUDA\""," )"],"additions":81,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_attn_utils.py","lines":["@@ -533,7 +533,7 @@ def prepare_kv_cache_views(self, *args):","     )","     pools = []"," ","-    def allocate(*args):","+    def allocate(*args, **kwargs):","         pools.append(args[-1])","         if shared:","             args[-1].shared_region = region"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/v1/worker/test_gpu_warmup_blocks.py","lines":["@@ -110,6 +110,7 @@ def _make_runner(","     