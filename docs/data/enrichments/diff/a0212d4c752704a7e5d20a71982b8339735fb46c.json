packages/runner build-prod"," **Gotchas / Notes**"," "," - This package is deprecated in favor of `@packages/app`. Do not add new features here; migrate to `@packages/app` instead.","-- Tests were moved to `@packages/app`; running `cypress:open` or `cypress:run` from this package will error.","+- The runner's Cypress tests were moved to `@packages/app`; running `cypress:open` or `cypress:run` from this package will error. `test/unit` holds vitest specs for `injection/main.ts`. They mock its collaborators, so the real injection is only exercised end to end by the driver's Cypress specs, such as `aut_window_patches.cy.ts`, `cy/timers.cy.ts` and `origin/integrity.cy.ts`."," - Nx implicit dependencies on `@packages/driver`, `@packages/reporter`, and `@packages/config` mean any change in those packages invalidates the runner's Nx cache and triggers a rebuild."," - `dom.js` uses webpack-specific loaders and cannot be imported directly by Vite."," "],"additions":4,"deletions":1,"truncated":false},{"path":"packages/runner/injection/main.ts","lines":["rename from packages/runner/injection/main.js","rename to packages/runner/injection/main.ts","@@ -11,13 +11,20 @@ import { createTimers } from './timers'"," import { patchXmlHttpRequest } from './patches/xmlHttpRequest'"," import { patchElementIntegrity } from './patches/integrity'"," ","-const Cypress = window.Cypress = parent.Cypress","-","-if (!Cypress) {","-  throw new Error('Something went terribly wrong and we cannot proceed. We expected to find the global \\","-Cypress in the parent window but it is missing. This should never happen and likely is a bug. Please open an issue.')","+// The driver mixes its event emitter onto Cypress at runtime, which the","+// `Window.Cypress` typing doesn't reflect, so check for it to narrow.","+function assertParentCypress (Cypress: Cypress.Cypress | undefined): asserts Cypress is typeof globalThis.Cypress {","+  if (!Cypress || typeof Cypress !== 'object' || !('removeAllListeners' in Cypress)) {","+    throw new Error('The script Cypress injects into this page did not find a usable Cypress runner at `window.parent.Cypress`, so Cypress cannot control this page.\\n\\nThis is likely a bug in Cypress. Open an issue that includes the steps that led to this error: https://on.cypress.io/new-issue')","+  }"," }"," ","+assertParentCypress(parent.Cypress)","+","+// Keep this as one statement: the server's integration specs detect full","+// injection by finding `window.Cypress=parent.Cypress` in the minified bundle.","+const Cypress = window.Cypress = parent.Cypress","+"," patchXmlHttpRequest(window)"," "," // Strip SRI from <script>/<link> in the primary AUT frame so proxy-rewritten first-party","@@ -26,11 +33,9 @@ if (Cypress.config('removeSRIAttributes')) {","   patchElementIntegrity(window)"," }"," ","-// We wrap timers in the injection code because if we do it in the driver (like","-// we used to do), any uncaught errors thrown in the timer callbacks would","-// get picked up by the top frame's 'error' handler instead of the AUT's.","-// We need to wrap the timer callbacks in the AUT itself for errors to","-// propagate properly.","+// Timers are wrapped here rather than in the driver so that uncaught errors","+// thrown in timer callbacks reach the AUT's 'error' handler instead of the","+// top frame's."," const timers = createTimers()"," "," Cypress.removeAllListeners('app:timers:reset')"],"additions":15,"deletions":10,"truncated":false},{"path":"packages/runner/package.json","lines":["@@ -17,6 +17,7 @@","     \"cypress:run\": \"echo \\\"These tests have been moved to @packages/app. \\\" && exit 1\",","     \"postinstall\": \"echo '@packages/runner needs: yarn build'\",","     \"lint\": \"eslint\",","+    \"test\": \"vitest run\",","     \"tslint\": \"tslint --config ../ts/tslint.json --project .\",","     \"watch\": \"node ../../scripts/run-webpack --watch --progress\"","   },","@@ -40,11 +41,13 @@","     \"cross-env\": \"7.0.3\",","     \"eslint\": \"^10.14.0\",","     \"jiti\": \"^2.4.2\",","+    \"jsdom\": \"^26.0.0\",","     \"lodash\": \"^4.17.21\",","     \"mobx\": \"6.13.6\",","     \"react\": \"18.3.1\",","     \"react-dom\": \"18.3.1\",","     \"rimraf\": \"^6.1.1\",","+    \"vitest\": \"^3.2.4\",","     \"webpack\": \"^5.88.2\",","     \"webpack-cli\": \"^5.1.4\"","   },"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/runner/test/unit/injection/main.spec.ts","lines":["@@ -0,0 +1,166 @@","+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'","+","+const { calls, timers } = vi.hoisted(() => {","+  const calls: string[] = []","+","+  return {","+    calls,","+    timers: {","+      reset: vi.fn(),","+      pause: vi.fn(),","+      wrap: vi.fn(() => calls.push('timers.wrap')),","+    },","+  }","+})","+","+vi.mock('../../../injection/timers', () => {","+  return {","+    createTimers: vi.fn(() => {","+      calls.push('createTimers')","+","+      return timers","+    }),","+  }","+})","+","+vi.mock('../../../injection/patches/xmlHttpRequest', () => {","+  return {","+    patchXmlHttpRequest: vi.fn((win) => {","+      calls.push(`patchXmlHttpRequest:${win === window}`)","+    }),","+  }","+})","+","+vi.mock('../../../injection/patches/integrity', () => {","+  return {","+    patchElementIntegrity: vi.fn((win) => {","+      calls.push(`patchElementIntegrity:${win === window}`)","+    }),","+  }","+})","+","+const MISSING_CYPRESS_MESSAGE = 'The script Cypress injects into this page did not find a usable Cypress runner at `window.parent.Cypress`, so Cypress cannot control this page.\\n\\nThis is likely a bug in Cypress. Open an issue that includes the steps that led to this error: https://on.cypress.io/new-issue'","+","+// Stands in for the driver's Cypress, which has the event emitter mixed in,","+// recording each call so the spec can assert the order they happen in.","+const createParentCypress = (config: Record<string, unknown>) => {","+  return {","+    config: vi.fn((key: string) => config[key]),","+    on: vi.fn((event: string, handler: unknown) => {","+      calls.push(`on:${event}:${handler === timers.reset ? 'reset' : handler === timers.pause ? 'pause' : 'other'}`)","+    }),","+    removeAllListeners: vi.fn((event: string) => {","+      calls.push(`removeAllListeners:${event}`)","+    }),","+    action: vi.fn((event: string, win: unknown) => {","+      calls.push(`action:${event}:${win === window}`)","+    }),","+  }","+}","+","+const loadInjection = () => import('../../../injection/main')","+","+describe('injection/main', () => {","+  beforeEach(() => {","+    vi.resetModules()","+    calls.length = 0","+  })","+","+  afterEach(() => {","+    vi.unstubAllGlobals()","+    Reflect.deleteProperty(window, 'Cypress')","+  })","+","+  describe('with Cypress on the parent window', () => {","+    it('runs the startup steps in order, announcing the window last', async () => {","+      vi.stubGlobal('parent', { Cypress: createParentCypress({ removeSRIAttributes: true }) })","+","+      await loadInjection()","+","+      expect(calls).toEqual([","+        'patchXmlHttpRequest:true',","+        'patchElementIntegrity:true',","+        'createTimers',","+        'removeAllListeners:app:timers:reset',","+        'removeAllListeners:app:timers:pause',","+        'on:app:timers:reset:reset',","+        'on:app:timers:pause:pause',","+        'timers.wrap',","+        'action:app:window:before:load:true',","+      ])","+    })","+","+    it('exposes the parent window\\'s Cypress on the AUT window', async () => {","+      const Cypress = createParentCypress({ removeSRIAttributes: false })","+","+      vi.stubGlobal('parent', { Cypress })","+","+      await loadInjection()","+","+      expect(window.Cypress).toBe(Cypress)","+    })","+","+    it('leaves the integrity attribute alone when removeSRIAttributes is false', async () => {","+      const Cypress = createParentCypress({ removeSRIAttributes: false })","+","+      vi.stubGlobal('parent', { Cypress })","+","+      await loadInjection()","+","+      expect(Cypress.config).toHaveBeenCalledWith('removeSRIAttributes')","+      expect(calls).not.toContain('patchElementIntegrity:true')","+      expect(calls).toContain('patchXmlHttpRequest:true')","+    })","+","+    // The parent's Cypress outlives each AUT page load, so without this the","+    // handlers from earlier pages would keep driving their stale timers.","+    it('replaces the timer listeners left by an earlier page load', async () => {","+      const Cypress = createParentCypress({ removeSRIAttributes: false })","+","+      vi.stubGlobal('parent', { Cypress })","+","+      await loadInjection()","+      vi.resetModules()","+      await loadInjection()","+","+      expect(Cypress.removeAllListeners).toHaveBeenCalledTimes(4)","+      expect(Cypress.on).toHaveBeenCalledTimes(4)","+","+      const secondLoad = calls.slice(calls.lastIndexOf('createTimers'))","+","+      expect(secondLoad.indexOf('removeAllListeners:app:timers:reset')).toBeLessThan(secondLoad.indexOf('on:app:timers:reset:reset'))","+      expect(secondLoad.indexOf('removeAllListeners:app:timers:pause')).toBeLessThan(secondLoad.indexOf('on:app:timers:pause:pause'))","+    })","+  })","+","+  describe('without a usable Cypress on the parent window', () => {","+    it('throws before patching anything when Cypress is missing', async () => {","+      vi.stubGlobal('parent', {})","+","+      await expect(loadInjection()).rejects.toThrow(MISSING_CYPRESS_MESSAGE)","+      expect(calls).toEqual([])","+      expect(window.Cypress).toBeUndefined()","+    })","+","+    it('throws before patching anything when Cypress lacks the driver\\'s event emitter', async () => {","+      vi.stubGlobal('parent', {","+        Cypress: {","+          config: vi.fn(() => false),","+          action: vi.fn(),","+        },","+      })","+","+      await expect(loadInjection()).rejects.toThrow(MISSING_CYPRESS_MESSAGE)","+      expect(calls).toEqual([])","+      expect(window.Cypress).toBeUndefined()","+    })","+","+    it('throws before patching anything when Cypress is not an object', async () => {","+      vi.stubGlobal('parent', { Cypress: 'loaded' })","+","+      await expect(loadInjection()).rejects.toThrow(MISSING_CYPRESS_MESSAGE)","+      expect(calls).toEqual([])","+      expect(window.Cypress).toBeUndefined()","+    })","+  })","+})"],"additions":166,"deletions":0,"truncated":false},{"path":"packages/runner/vitest.config.ts","lines":["@@ -0,0 +1,8 @@","+import { defineConfig } from 'vitest/config'","+","+export default defineConfig({","+  test: {","+    include: ['test/unit/**/*.spec.ts'],","+    environment: 'jsdom',","+  },","+})"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/runner/webpack.config.ts","lines":["@@ -85,7 +85,7 @@ const mainInjectionConfig: webpack.Configuration = {","   ...getSimpleConfig(),","   mode: 'production',","   entry: {","-    injection: [path.resolve(__dirname, 'injection/main.js')],","+    injection: [path.resolve(__dirname, 'injection/main.ts')],","   },","   output: {","     path: path.resolve(__dirname, 'dist'),",""],"additions":1,"deletions":1,"truncated":false}],"additions":199,"deletions":13,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-27T19:02:52.565295+00:00"}