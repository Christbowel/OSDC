        filename: \"main.js\",","+        library: { type: \"commonjs2\" },","+      },","+      plugins: [","+        {","+          apply(compiler) {","+            rspack.lazyCompilationMiddleware(compiler);","+            compiler.hooks.compilation.tap(\"LazyBarrel\", compilation => {","+              compilation.hooks.stillValidModule.tap(\"LazyBarrel\", module => {","+                if (path.basename(module.identifier()) === \"barrel.js\") {","+                  restoredBarrels++;","+                }","+              });","+            });","+          },","+        },","+      ],","+    };","+  },","+  async build(context) {","+    const manager = context.getCompiler();","+    for (let run = 0; run < 2; run++) {","+      if (run > 0) {","+        // A new compiler restores the module cache instead of the incremental graph.","+        await manager.close();","+        manager.createCompiler();","+      }","+      const stats = await manager.build();","+      expect(restoredBarrels).toBe(run);","+      expect(stats.toJson({ all: false, errors: true }).errors).toEqual([]);","+      const output = { exports: {} };","+      new Function(","+        \"module\",","+        stats.compilation.getAsset(\"main.js\").source.source(),","+      )(output);","+      expect(output.exports.default).toBe(\"value\");","+    }","+  },","+};"],"additions":78,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/lazy-barrel/basic/index.js","lines":["@@ -1,5 +1,5 @@"," import { b as a, cc } from \"./named-barrel\";","-import { b as c, d } from \"./mixed-barrel\";","+import localDefault, { b as c, d } from \"./mixed-barrel\";"," import { b } from \"./star-barrel\";"," import * as nested from \"./nested-barrel\";"," ","@@ -9,5 +9,6 @@ it(\"should correct build\", () => {","   expect(b).toBe('b');","   expect(c).toBe('c');","   expect(d).toBe('d');","+  expect(localDefault()).toBe('default');","   expect(nested.a).toBe('b');"," })"],"additions":2,"deletions":1,"trun