","+          changingMember.get('transient_id'),","+        );","+        await membersAgent","+          .post('/api/member/email/')","+          .header('X-Forwarded-For', ip)","+          .body({ email: `new-address-${i}@test.com`, identity })","+          .expectStatus(status);","+      };","+","+      for (let i = 0; i < sendLimit; i++) {","+        await changeEmail(member, i, `10.0.0.${i + 1}`, 201);","+      }","+","+      // A new IP address and recipient do not get the same member a new budget","+      await changeEmail(member, sendLimit, '10.0.1.1', 429);","+","+      await changeEmail(otherMember, 0, '10.0.0.1', 201);","+    });","+","+    it('Will keep a member email change budget across a completed email change', async function () {","+      const sendLimit = configUtils.config.get('spam').member_email_update.freeRetries + 1;","+      const member = await membersService.api.members.create({","+        email: 'email-change-before@test.com',","+      });","+      const alias = 'email-change-after@test.com';","+","+      const changeEmail = async (email, status) => {","+        const current = await membersService.api.members.get({ id: member.id });","+        const identity = await membersService.api.getMemberIdentityToken(","+          current.get('transient_id'),","+        );","+        await membersAgent","+          .post('/api/member/email/')","+          .body({ email, identity })","+          .expectStatus(status);","+      };","+","+      for (let i = 0; i < sendLimit - 1; i++) {","+        await changeEmail(`email-change-victim-${i}@test.com`, 201);","+      }","+      await changeEmail(alias, 201);","+","+      // Confirm the change to the alias with the link the endpoint emails","+      const link = await membersService.api.getMagicLink(alias, 'updateEmail', {","+        oldEmail: member.get('email'),","+      });","+      const token = new URL(link).searchParams.get('token');","+      await membersService.api.getMemberDataFromMagicLinkToken(token);","+","+      const changed = await membersService.api.members.get({ id: member.id });","+      assert.equal(changed.get('email'), alias);","+","+      // A token for the new email is the same member, with the same spent budget","+      await changeEmail('email-change-victim-next@test.com', 429);","+    });","+","+    it('Will not let forged identity tokens spend a member email change budget', async function () {","+      const sendLimit = configUtils.config.get('spam').member_email_update.freeRetries + 1;","+      const member = await membersService.api.members.create({","+        email: 'email-change-forged@test.com',","+      });","+      const forged = jwt.sign({ sub: member.get('email') }, 'not-the-site-key');","+","+      for (let i = 0; i <= sendLimit; i++) {","+        await membersAgent","+          .post('/api/member/email/')","+          .header('X-Forwarded-For', `10.0.2.${i + 1}`)","+          .body({ email: `forged-address-${i}@test.com`, identity: forged })","+          .expectStatus(401);","+      }","+","+      const identity = await membersService.api.getMemberIdentityToken(member.get('transient_id'));","+      await membersAgent","+        .post('/api/member/email/')","+        .body({ email: 'forged-address-real@test.com', identity })","+        .expectStatus(201);","+    });","+","     it('Will rate limit member enumeration', async function () {","       // +1 because this is a retry count, so we have one request + the retries, then blocked","       const userLoginRateLimit = configUtils.config.get('spam').member_login.freeRetries + 1;"],"additions":90,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/services/members/middleware.test.js","lines":["@@ -245,6 +245,51 @@ describe('Members Service Middleware', function () {","     }","   });"," ","+  describe('loadIdentityTokenMember', function () {","+    afterEach(function () {","+      sinon.restore();","+    });","+","+    const run = async (body, getByToken) => {","+      sinon.restore();","+      sinon.stub(membersService, 'api').get(() => ({ members: { getByToken } }));","+      const req = { body };","+      const next = sinon.stub();","+","+      await membersMiddleware.loadIdentityTokenMember(req, {}, next);","+","+      sinon.assert.calledOnceWithExactly(next);","+      return req.identityTokenMemberId;","+    };","+","+    it('sets the id of the member a verified token names', async function () {","+      const getByToken = sinon.stub().resolves({ id: 'member-id' });","+","+      assert.equal(await run({ identity: 'token' }, getByToken), 'member-id');","+      sinon.assert.calledOnceWithExactly(getByToken, 'token');","+    });","+","+    it('sets null when the token does not verify', async function () {","+      const getByToken = sinon.stub().rejects(new Error('invalid signature'));","+","+      assert.equal(await run({ identity: 'forged' }, getByToken), null);","+    });","+","+    it('sets null when the token names no member', async function () {","+      const getByToken = sinon.stub().resolves(null);","+","+      assert.equal(await run({ identity: 'token' }, getByToken), null);","+    });","+","+    it('sets null without a token', async function () {","+      const getByToken = sinon.stub();","+","+      assert.equal(await run({}, getByToken), null);","+      assert.equal(await run({ identity: { sub: 'member@example.com' } }, getByToken), null);","+      sinon.assert.notCalled(getByToken);","+    });","+  });","+","   describe('updateMemberNewsletters', function () {","     // let oldMembersService;","     let req;"],"additions":45,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/web/shared/middleware/api/spam-prevention.test.ts","lines":["@@ -14,6 +14,7 @@ type FactoryName =","   | 'upgradeBlock'","   | 'upgradeApiBlock'","   | 'staffInviteBlock'","+  | 'memberEmailUpdateBlock'","   | 'globalBlock'","   | 'globalReset'","   | 'userLogin'","@@ -42,6 +43,7 @@ const factories: Array<{","   { name: 'upgradeB