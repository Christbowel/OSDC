has(PatternLabel)","+}","+","+// IsInternalLabel reports whether name is one of the labels that label name APIs do not return.","+func IsInternalLabel(name string) bool {","+\tswitch name {","+\tcase AggregatedMetricLabel, PatternLabel, TimeShardLabel:","+\t\treturn true","+\t}","+\treturn false","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"pkg/util/constants/internal_streams_test.go","lines":["@@ -0,0 +1,39 @@","+package constants","+","+import (","+\t\"slices\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestIsInternalStream(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tlabels   []string","+\t\texpected bool","+\t}{","+\t\t{labels: []string{\"app\"}, expected: false},","+\t\t{labels: []string{\"app\", TimeShardLabel}, expected: false},","+\t\t{labels: []string{\"app\", AggregatedMetricLabel}, expected: true},","+\t\t{labels: []string{\"app\", PatternLabel}, expected: true},","+\t} {","+\t\thas := func(name string) bool { return slices.Contains(tc.labels, name) }","+\t\trequire.Equal(t, tc.expected, IsInternalStream(has), \"labels %v\", tc.labels)","+\t\trequire.Equal(t, tc.expected, IsPatternIngesterStream(has), \"labels %v\", tc.labels)","+\t}","+}","+","+func TestIsInternalLabel(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname     string","+\t\texpected bool","+\t}{","+\t\t{name: \"app\", expected: false},","+\t\t{name: BackfillLabel, expected: false},","+\t\t{name: AggregatedMetricLabel, expected: true},","+\t\t{name: PatternLabel, expected: true},","+\t\t{name: TimeShardLabel, expected: true},","+\t} {","+\t\trequire.Equal(t, tc.expected, IsInternalLabel(tc.name), \"label %s\", tc.name)","+\t}","+}",""],"additions":39,"deletions":0,"truncated":false}],"additions":188,"deletions":121,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-29T15:19:58.829738+00:00"}