+class MethodInvocationContextCachedValuesSpec extends Specification {","+","+    void \"an invocation that sees the metadata of its method asks the method for the values it keeps\"() {","+        given:","+        def metadata = metadata()","+        def kept = new Object()","+        ExecutableMethod method = [","+            getAnnotationMetadata   : { metadata },","+            getCachedValue          : { Class key, java.util.function.Function factory -> kept },","+            getCachedAnnotationValue: { Class type -> AnnotationValue.builder(Marked).value(\"kept\").build() },","+            getCachedAnnotation     : { Class type -> null }","+        ] as ExecutableMethod","+        MethodInvocationContext context = invocation(method, metadata)","+","+        expect:","+        context.getCachedValue(Object, m -> new Object()).is(kept)","+        context.getCachedAnnotationValue(Marked).stringValue().get() == \"kept\"","+        context.getCachedAnnotation(Marked) == null","+    }","+","+    void \"an invocation with metadata of its own computes the values\"() {","+        given:","+        def methodMetadata = metadata()","+        def invocationMetadata = metadata()","+        ExecutableMethod method = [","+            getAnnotationMetadata: { methodMetadata },","+            getCachedValue       : { Class key, java.util.function.Function factory -> throw new AssertionError(\"asked the method\") }","+        ] as ExecutableMethod","+        MethodInvocationContext context = invocation(method, invocationMetadata)","+","+        expect:","+        context.getCachedValue(String, m -> m.is(context) ? \"invocation\" : \"other\") == \"invocation\"","+        context.getCachedAnnotationValue(Marked).stringValue().get() == \"marked\"","+","+        when:","+        context.getCachedAnnotation(Marked)","+","+        then:","+        // computed for the invocation: no builder is registered for the annotation","+        thrown(IllegalStateException)","+    }","+","+    pr