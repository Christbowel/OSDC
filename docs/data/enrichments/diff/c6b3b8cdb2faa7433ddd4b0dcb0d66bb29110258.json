{"id":"c6b3b8cdb2faa7433ddd4b0dcb0d66bb29110258","axis":"silent","repo":"foundry-rs/foundry","sha":"c6b3b8cdb2faa7433ddd4b0dcb0d66bb29110258","parsed":{"files":[{"path":"crates/cheatcodes/spec/src/symbolic.rs","lines":["@@ -7,6 +7,11 @@ sol! {","         function createBytes(string calldata name) external returns (bytes memory value);","         function createBytes(uint256 len, string calldata name) external returns (bytes memory value);","         function createCalldata(string calldata name) external returns (bytes memory value);","+        function createCalldata(string calldata name, bool includeViewAndPureFunctions) external returns (bytes memory value);","+        function createCalldata(string calldata filename, string calldata name) external returns (bytes memory value);","+        function createCalldata(string calldata filename, string calldata name, bool includeViewAndPureFunctions) external returns (bytes memory value);","+        function createCalldata(address target) external returns (bytes memory value);","+        function createCalldata(address target, bool includeViewAndPureFunctions) external returns (bytes memory value);","         function createInt(uint256 bits, string calldata name) external returns (int256 value);","         function createString(string calldata name) external returns (string memory value);","         function createString(uint256 len, string calldata name) external returns (string memory value);"],"additions":5,"deletions":0,"truncated":false},{"path":"crates/cheatcodes/src/state.rs","lines":["@@ -1,7 +1,7 @@"," //! Cheatcode state shared by both execution engines."," "," use crate::{","-    CheatcodeAnalysis, CheatsConfig, ExpectedCallTracker, Wallets,","+    CheatcodeAnalysis, CheatsConfig, Error, ExpectedCallTracker, Wallets,","     evm::mock::{MockCallDataContext, MockCallReturnData},","     inspector::ArbitraryStorage,"," };","@@ -147,6 +147,32 @@ impl CheatcodesCore {","     pub fn arbitrary_storage(&mut self) -> &mut ArbitraryStorage {","         self.arbitrary_storage.get_or_insert_with(ArbitraryStorage::default)","     }","+","+    /// Answers the calls to `callee` whose calldata starts with `calldata` with `returns` in","+    /// order, and reverts every later call.","+    pub fn mock_call_sequence(&mut self, callee: Address, calldata: Bytes, returns: &[Bytes]) {","+        // A mock repeats its last return, so two reverting ends show if a call reached the first.","+        let end = MockCallReturnData {","+            reverts: true,","+            data: Error::encode(\"mocked call sequence has no more returns\"),","+        };","+        let queue = returns","+            .iter()","+            .map(|data| MockCallReturnData { reverts: false, data: data.clone() })","+            .chain([end.clone(), end])","+            .collect();","+        self.mocked_calls","+            .entry(callee)","+            .or_default()","+            .insert(MockCallDataContext { calldata, value: None }, queue);","+    }","+","+    /// Returns whether a call to `callee` ran past the returns of a","+    /// [`Self::mock_call_sequence`] or of any other mock of `callee` with a single return, or","+    /// `None` when the mocks were cleared.","+    pub fn mock_call_sequence_exhausted(&self, callee: Address) -> Option<bool> {","+        self.mocked_calls.get(&callee).map(|mocks| mocks.values().any(|queue| queue.len() < 2))","+    }"," }"," "," /// Contains additional, test specific resources that should be kept for the duration of the test"],"additions":27,"deletions":1,"truncated":false},{"path":"crates/evm/symbolic/README.md","lines":["@@ -806,6 +806,11 @@ interface Svm {","     function createString(uint256 length, string calldata name) external returns (string memory);","     function createBytes4(string calldata name) external returns (bytes4);","     function createCalldata(string calldata name) external returns (bytes memory);","+    function createCalldata(string calldata name, bool includeViewAndPureFunctions) external returns (bytes memory);","+    function createCalldata(string calldata filename, string calldata name) external returns (bytes memory);","+    function createCalldata(string calldata filename, string calldata name, bool includeViewAndPureFunctions) external returns (bytes memory);","+    function createCalldata(address target) external returns (bytes memory);","+    function createCalldata(address target, bool includeViewAndPureFunctions) external returns (bytes memory);","     function enableSymbolicStorage(address target) external;","     function setArbitraryStorage(address target) external;","     function snapshotStorage(address target) external returns (uint256);","@@ -819,6 +824,26 @@ passes. Forge itself leaves the address empty, so a symbolic address that may"," denote it sees an ordinary account, and a symbolic call that may reach a helper"," selector there reports incomplete."," ","+`createCalldata` looks up the ABI of a project contract or interface by name, by","+source file and name, or by the deployed code at a concrete address. Like Halmos,","+it forks one path for each calldata shape: empty calldata, a selector outside the","+ABI followed by 1024 arbitrary bytes for `fallback`, and each function with","+symbolic arguments. View and pure functions are left out unless","+`includeViewAndPureFunctions` is true. Dynamic arguments use the same named and","+default lengths as test parameters. The fallback bytes are cut to fit","+`symbolic.max_calldata_bytes`. An unknown or ambiguous name, a function whose","+calldata does not fit, or an ABI type that symbolic calldata does not support","+makes the result incomplete.","+","+Concrete replay answers each helper call with the return data that the solver","+model gives it, in call order. The counterexample records this data as","+`svm_returns` in the JSON result, the replay artifact, and the generated","+regression test. If a replay makes more helper calls than the failing path did,","+Forge does not confirm the counterexample. Replay answers helper calls by","+position and does not check which helper a call names. Symbolic invariant replay","+does not answer helper calls yet, so an invariant counterexample that uses them","+reports incomplete.","+"," Forge also treats several `vm.random*` cheatcodes as symbolic value creators when"," running symbolically. Dynamic byte and string creators use the same dynamic ABI"," bounds as function arguments."],"additions":25,"deletions":0,"truncated":false},{"path":"crates/evm/symbolic/assets/symbolic-counterexample.schema.json","lines":["@@ -214,6 +214,13 @@","         },","         \"raw_args\": {","           \"type\": [\"string\", \"null\"]","+        },","+        \"svm_returns\": {","+          \"type\": \"array\",","+          \"items\": {","+            \"type\": \"string\",","+            \"pattern\": \"^0x([0-9a-fA-F]{2})*$\"","+          }","         }","       }","     }"],"additions":7,"deletions":0,"truncated":false},{"path":"crates/evm/symbolic/assets/symbolic-result.schema.json","lines":["@@ -461,6 +461,13 @@","         },","         \"value\": {","           \"type\": [\"string\", \"null\"]","+        },","+        \"svm_returns\": {","+          \"type\": \"array\",","+          \"items\": {","+            \"type\": \"string\",","+            \"pattern\": \"^0x([0-9a-fA-F]{2})*$\"","+          }","         }","       }","     },"],"additions":7,"deletions":0,"truncated":false},{"path":"crates/evm/symbolic/src/abi.rs","lines":["@@ -158,6 +158,67 @@ impl SymbolicCalldata {","         Ok(out)","     }"," ","+    /// Builds the calldata shapes of a contract ABI, as Halmos `createCalldata` does: empty","+    /// calldata for `receive` and `fallback`, a selector outside the ABI with arbitrary bytes for","+    /// `fallback`, and each function with symbolic arguments. View and pure functions are left","+    /// out unless `include_view` is set.","+    pub(super) fn contract_variants(","+        abi: &JsonAbi,","+        include_view: bool,","+        config: &SymbolicConfig,","+        cx: &mut SymCx,","+        prefix: &str,","+    ) -> Result<Vec<Self>, SymbolicError> {","+        let max_len = config.max_calldata_bytes as usize;","+        if max_len < 4 {","+            return Err(SymbolicError::Unsupported(","+                \"symbolic calldata size exceeds configured max\",","+            ));","+        }","+        let empty = Self {","+            bytes: SymBytes::empty(cx),","+            inputs: Vec::new(),","+            constraints: Vec::new(),","+            size: None,","+        };","+","+        let mut builder = SymbolicAbiBuilder { config, cx };","+        let mut state = SymbolicAbiState::default();","+        let bytes = (0..CREATE_CALLDATA_FALLBACK_LEN.min(max_len))","+            .map(|idx| builder.fresh_byte(&mut state, &format!(\"{prefix}_fallback_{idx}\"), false))","+            .collect();","+        let bytes = SymBytes::exprs(cx, bytes);","+        let selector = bytes.right_aligned_word(cx, 0, 4);","+        for function in abi.functions() {","+            let selector = SymBoolExpr::eq_word_const(","+                cx,","+                &selector,","+                U256::from_be_slice(function.selector().as_slice()),","+            );","+            state.constraints.push(selector.not(cx));","+        }","+        let fallback =","+            Self { bytes, inputs: Vec::new(), constraints: state.constraints, size: None };","+","+        let mut variants = vec![empty, fallback];","+        for (idx, function) in abi.functions().enumerate() {","+            if include_view","+                || !matches!(","+                    function.state_mutability,","+                    StateMutability::Pure | StateMutability::View","+                )","+            {","+                variants.extend(Self::variants_with_prefix(","+                    function,","+                    config,","+                    cx,","+                    &format!(\"{prefix}_{idx}\"),","+                )?);","+            }","+        }","+        Ok(variants)","+    }","+","     pub(super) fn call_data(&self, cx: &mut SymCx) -> SymCalldata {","         match &self.size {","             Some(size) => SymCalldata::with_size_word(self.bytes.clone(), size.clone()),","@@ -165,6 +226,15 @@ impl SymbolicCalldata {","         }","     }"," ","+    /// Returns this calldata ABI-encoded as a single `bytes` value.","+    pub(super) fn abi_encoded_bytes(&self, cx: &mut SymCx) -> SymBytes {","+        let value = SymbolicAbiValue::Bytes {","+            len: SymExpr::constant(cx, U256::from(self.bytes.len())),","+            bytes: self.bytes.clone(),","+        };","+        encode_sequence(cx, [&value])","+    }","+","     /// Returns symbolic calldata constraints.","     pub(super) fn constraints(&self) -> &[SymBoolExpr] {","         &self.constraints"],"additions":70,"deletions":0,"truncated":false},{"path":"crates/evm/symbolic/src/consts.rs","lines":["@@ -4,7 +4,8 @@ use std::time::Duration;"," // HD wallet key derivation"," pub(crate) const DEFAULT_DERIVATION_PATH_PREFIX: &str = \"m/44'/60'/0'/0/\";"," pub(crate) const MAX_REMEMBER_KEYS: u32 = 64;","-pub(crate) const SYMBOLIC_VM_COMPAT_ADDRESS: Address =","+/// Address of the Halmos-style symbolic VM helpers (`svm.*`).","+pub const SYMBOLIC_VM_COMPAT_ADDRESS: Address =","     address!(\"0xF3993A62377BCd56AE39D773740A5390411E8BC9\");"," "," // Symbolic exponentiation limits","@@ -14,6 +15,9 @@ pub(crate) const CONCRETE_BASE_SYMBOLIC_EXPONENT_LIMIT: u64 = 256;"," // ABI encoding lengths"," pub(crate) const ERROR_DATA_MIN_LEN: usize = 68; // selector (4) + offset (32) + length (32)"," ","+// `svm.createCalldata` fallback calldata: a selector and the 1024 arbitrary bytes Halmos uses.","+pub(crate) const CREATE_CALLDATA_FALLBACK_LEN: usize = 4 + 1024;","+"," // Precompile address layout"," pub(crate) const PRECOMPILE_ADDRESS_LEADING_ZEROS: usize = 19;"," "],"addi