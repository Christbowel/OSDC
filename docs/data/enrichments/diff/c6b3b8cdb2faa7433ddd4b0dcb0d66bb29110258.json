   )?;","+                known_contracts","+                    .find_by_deployed_code_exact(&code)","+                    .map(|(_, contract)| &contract.abi)","+                    .ok_or(SymbolicError::Unsupported(","+                        \"symbolic svm.createCalldata unknown contract\",","+                    ))?","+            }","+            CreateCalldataTarget::Name => {","+                let name = read_abi_string_arg(","+                    &mut self.cx,","+                    &state.memory,","+                    args_offset,","+                    0,","+                    \"symbolic svm.createCalldata name\",","+                )?;","+                contract_abi(known_contracts, None, &name)?","+            }","+            CreateCalldataTarget::FileAndName => {","+                let file = read_abi_string_arg(","+                    &mut self.cx,","+                    &state.memory,","+                    args_offset,","+                    0,","+                    \"symbolic svm.createCalldata file name\",","+                )?;","+                let name = read_abi_string_arg(","+                    &mut self.cx,","+                    &state.memory,","+                    args_offset,","+                    1,","+                    \"symbolic svm.createCalldata name\",","+                )?;","+                contract_abi(known_contracts, Some(&file), &name)?","+            }","+        };","+        let include_view = view_flag","+            && !read_abi_constrained_word_arg(","+                &mut self.cx,","+                state,","+                args_offset,","+                target.words(),","+                \"symbolic svm.createCalldata view flag\",","+            )?","+            .is_zero();","+","+        let id = state.next_symbol;","+        state.next_symbol += 1;","+        // Positional `array_lengths` entries size the test function's own parameters.","+        let config = SymbolicConfig { array_lengths: Vec::new(),