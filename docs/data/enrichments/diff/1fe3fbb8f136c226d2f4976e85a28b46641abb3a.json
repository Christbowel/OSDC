The query context parameters from sys.query_context_parameters, or undefined when they could not be loaded (an","+ * older Druid or no access to sys tables)","+ */","+export const useQueryContextParameters = () => {","+  return useContext(QueryContextParametersContext);","+};"],"additions":50,"deletions":0,"truncated":false},{"path":"web-console/src/druid-models/query-context/query-context.tsx","lines":["@@ -70,6 +70,32 @@ export const DEFAULT_SERVER_QUERY_CONTEXT: QueryContext = {","   includeAllCounters: false,"," };"," ","+/**","+ * A query context parameter, as a row of `sys.query_context_parameters`","+ */","+export interface QueryContextParameterMetadata {","+  name: string;","+  type: string;","+  description: string;","+  default_value: string | null;","+  default_description: string | null;","+  effective_value: string | null;","+  effective_source:","+    | 'BUILT_IN'","+    | 'RUNTIME_PROPERTY'","+    | 'DEFAULT_CONTEXT_PROPERTY'","+    | 'BROKER_DYNAMIC_CONFIG'","+    | 'UNAUTHORIZED'","+    | null;","+  deprecation: string | null;","+  /** The query languages that can provide the parameter, such as SQL or JSON (native queries) */","+  query_languages: string[] | null;","+}","+","+export const QUERY_CONTEXT_PARAMETERS_QUERY = `SELECT \"name\", \"type\", \"description\", \"default_value\", \"default_description\", \"effective_value\", \"effective_source\", \"deprecation\", \"query_languages\"","+FROM sys.query_context_parameters","+WHERE \"visibility\" = 'PUBLIC'`;","+"," export interface QueryWithContext {","   queryString: string;","   queryContext?: QueryContext;"],"additions":26,"deletions":0,"truncated":false},{"path":"web-console/src/editor-completions/query-context-parameter-completions.spec.ts","lines":["@@ -0,0 +1,203 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+import type { QueryContextParameterMetadata } from '../druid-models';","+","+import {","+  getQueryContextCompletions,","+  queryContextDescriptionToDocMarkdown,","+  resolveDocsLink,","+} from './query-context-parameter-completions';","+","+describe('query-context-parameter-completions', () => {","+  describe('getQueryContextCompletions', () => {","+    const parameter: QueryContextParameterMetadata = {","+      name: 'p',","+      type: 'Long',","+      description: 'D.',","+      default_value: null,","+      default_description: null,","+      effective_value: null,","+      effective_source: null,","+      deprecation: null,","+      query_languages: ['JSON', 'SQL'],","+    };","+    const property = '${druid.x}';","+","+    // Only the combinations that sys.query_context_parameters returns","+    it.each<[string, Partial<QueryContextParameterMetadata>, string]>([","+      [","+        'built-in',","+        { default_value: '1', effective_value: '1', effective_source: 'BUILT_IN' },","+        'Default: `1`',","+      ],","+      [","+        'built-in without CONFIG read access',","+        { default_value: '1', effective_source: 'UNAUTHORIZED' },","+        'Default: `1` (built-in; the Broker may override it)',","+      ],","+      [","+        'default query context',","+        { default_value: '1', effective_value: '2', effective_source: 'DEFAULT_CONTEXT_PROPERTY' },","+        'Default: `2` (default query context; built-in: `1`)',","+      ],","+      [","+        'Broker dynamic config',","+        { default_value: '1', effective_value: '2', effective_source: 'BROKER_DYNAMIC_CONFIG' },","+        'Default: `2` (Broker dynamic config; built-in: `1`)',","+      ],","+      [","+        'runtime property',","+        { default_value: property, effective_value: '5', effective_source: 'RUNTIME_PROPERTY' },","+        'Default: `5` (runtime property `druid.x`)',","+      ],","+      [","+        'runtime property overridden by the default query context',","+        {","+          default_value: property,","+          effective_value: '6',","+          effective_source: 'DEFAULT_CONTEXT_PROPERTY',","+        },","+        'Default: `6` (default query context; runtime property `druid.x`)',","+      ],","+      [","+        'runtime property that is not set',","+        { default_value: property },","+        'Default: value of runtime property `druid.x`',","+      ],","+      [","+        'runtime property without CONFIG read access',","+        { default_value: property, effective_source: 'UNAUTHORIZED' },","+        'Default: value of runtime property `druid.x` (the Broker may override it)',","+      ],","+      ['described', { default_description: 'auto' }, 'Default: auto'],","+      [","+        'described without CONFIG read access',","+        { default_description: 'auto', effective_source: 'UNAUTHORIZED' },","+        'Default: auto (the Broker may override it)',","+      ],","+    ])('shows a default that is %s', (_, overrides, expected) => {","+      expect(getQueryContextCompletions(false, [{ ...parameter, ...overrides }])[0].doc).toEqual({","+        name: 'p',","+        descriptionMarkdown: `Type: \\`Long\\`\\n\\n${expected}\\n\\nD.`,","+      });","+    });","+","+    it('sorts a deprecated parameter after the others and notes the deprecation', () => {","+      const [completion] = getQueryContextCompletions(false, [","+        { ...parameter, deprecation: 'Use `q` instead.' },","+      ]);","+      expect(completion.boost).toEqual(40);","+      expect(completion.doc?.descriptionMarkdown).toEqual(","+        'Type: `Long`\\n\\nD.\\n\\n*Deprecated*: Use `q` instead.',","+      );","+    });","+","+    it('does not suggest parameters that SQL can not provide', () => {","+      expect(","+        getQueryContextCompletions(false, [","+          { ...parameter, name: 'useCache' },","+          { ...parameter, name: 'bySegment', query_languages: ['JSON'] },","+        ]).map(c => c.label),","+      ).toEqual(['useCache']);","+    });","+","+    it('quotes a parameter name that needs it unless a quote is being typed', () => {","+      const queryContextParameters = [{ ...parameter, name: 'my-key' }];","+      expect(getQueryContextCompletions(false, queryContextParameters).map(c => c.label)).toEqual([","+        '\"my-key\"',","+      ]);","+      expect(getQueryContextCompletions(true, queryContextParameters).map(c => c.label)).toEqual([","+        'my-key',","+      ]);","+    });","+  });","+","+  describe('resolveDocsLink', () => {","+    it('resolves links relative to the querying docs to the docs site', () => {","+      const docs = 'https://druid.apache.org/docs/latest';","+      expect(resolveDocsLink('dart.md')).toEqual(`${docs}/querying/dart`);","+      expect(resolveDocsLink('./filters.md#null-filter')).toEqual(","+        `${docs}/querying/filters#null-filter`,","+      );","+      expect(resolveDocsLink('../multi-stage-query/reference.md#joins')).toEqual(","+        `${docs}/multi-stage-query/reference#joins`,","+      );","+      expect(resolveDocsLink('../configuration/index.md#broker')).toEqual(","+        `${docs}/configuration/#broker`,","+      );","+      // Anchors as the docs site makes them","+      expect(","+        resolveDocsLink('../configuration/index.md#Guardrails for materialization of subqueries'),","+      ).toEqual(`${docs}/configuration/#guardrails-for-materialization-of-subqueries`);","+      expect(resolveDocsLink('https://example.com/x')).toEqual('https://example.com/x');","+    });","+","+    it('does not resolve links to an anchor of the same page or to other schemes', () => {","+      expect(resolveDocsLink('#limits')).toBeUndefined();","+      expect(resolveDocsLink('javascript:alert(1)')).toBeUndefined();","+      expect(resolveDocsLink('http://example.com/x')).toBeUndefined();","+    });","+  });","+","+  describe('queryContextDescriptionToDocMarkdown', () => {","+    it('turns links into docs links and HTML into line breaks and list items', () => {","+      expect(","+        queryContextDescriptionToDocMarkdown(","+          'Uses [lookups](lookups.md#reverse) for `IN`, see [limits](#limits).<br /><br />Options:<ul><li>`a`: first</li><li>`b`: second</li></ul>Done.',","+        ),","+      ).toEqual(","+        'Uses [lookups](https://druid.apache.org/docs/latest/querying/lookups#reverse) for `IN`, see limits.\\n\\nOptions:\\n- `a`: first\\n- `b`: second\\nDone.',","+      );","+    });","+","+    it('converts links whose text is a code span and leaves brackets in code spans alone', () => {","+      expect(","+        queryContextDescriptionToDocMarkdown(","+          'An [`indexSpec`](../ingestion/ingestion-spec.md#indexspec) for `ARRAY[1](2)`, see [`this`](#section).',","+        ),","+      ).toEqual(","+        'An [`indexSpec`](https://druid.apache.org/docs/latest/ingestion/ingestion-spec#indexspec) for `ARRAY[1](2)`, see `this`.',","+      );","+    });","+","+    it('keeps code spans as they are and converts code tags, strong text and entities', () => {","+      expect(","+        queryContextDescriptionToDocMarkdown(","+          '**Deprecated.** Threads are named `processing_<queryId>`; use <code>&#124;&#124;</code> &amp; more.',","+        ),","+      ).toEqual('*Deprecated.* Threads are named `processing_<queryId>`; use `||` & more.');","+    });","+","+    it('drops tags that removing another tag leaves behind', () => {","+      expect(queryContextDescriptionToDocMarkdown('a <<b>i>tag</i> b')).toEqual('a tag b');","+    });","+","+    it('decodes hex entities and leaves entities that are not code points as they are', () => {","+      expect(queryContextDescriptionToDocMarkdown('a &#x7C; b &#99999999; c &#0;')).toEqual(","+        'a | b &#99999999; c &#0;',","+      );","+    });","+","+    it('decodes entities once', () => {","+      expect(","+        queryContextDescriptionToDocMarkdown('Use <code>&amp;lt;</code> for &amp;lt;.'),","+      ).toEqual('Use `&lt;` for &lt;.');","+    });","+  });","+});"],"additions":203,"deletions":0,"truncated":false},{"path":"web-console/src/editor-completions/query-context-parameter-completions.ts","lines":["@@ -0,0 +1,301 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+import { C, RefName } from 'druid-query-toolkit';","+","+import type { QueryContextParameterMetadata } from '../druid-models';","+import { DEFAULT_SERVER_QUERY_CONTEXT } from '../druid-models';","+import { getLink } from '../links';","+","+import type { EditorCompletion } from './editor-completion';","+","+/**","+ * The query context parameter names to suggest after SET: the parameters loaded from sys.query_context_parameters, or","+ * the well-known context keys when they are not loaded","+ */","+export function getQueryContextCompletions(","+  quote: boolean,","+  queryContextParameters: readonly QueryContextParameterMetadata[] | undefined,","+): EditorCompletion[] {","+  if (!queryContextParameters?.length) {","+    return Object.keys(DEFAULT_SERVER_QUERY_CONTEXT).map(key => ({","+      label: quote ? key : contextKeyLabel(key),","+      boost: 50,","+      detail: 'context',","+    }));","+  }","+","+  let completions = PARAMETER_COMPLETIONS.get(queryContextParameters);","+  if (!completions) {","+    completions = buildParameterCompletions(queryContextParameters);","+    PARAMETER_COMPLETIONS.set(queryContextParameters, completions);","+  }","+  return quote ? completions.afterQuote : completions.bare;","+}","+","+interface ParameterCompletions {","+  /** For typing after a double quote: the names as they are */","+  afterQuote: EditorCompletion[];","+  /** Otherwise: the names, quoted where needed */","+  bare: EditorCompletion[];","+}","+","+/**","+ * The completions of each loaded list of parameters, built on first use: the docs only change when the parameters are","+ * loaded again (a new list)","+ */","+const PARAMETER_COMPLETIONS = new WeakMap<","+  readonly QueryContextParameterMetadata[],","+  ParameterCompletions","+>();","+","+function buildParameterCompletions(","+  queryContextParameters: readonly QueryContextParameterMetadata[],","+): ParameterCompletions {","+  // Parameters that SQL can't provide, such as bySegment, which SQL queries ignore, are not suggested after SET","+  const afterQuote = queryContextParameters","+    .filter(parameter => !parameter.query_languages || parameter.query_languages.includes('SQL'))","+    .map(parameter => ({","+      label: parameter.name,","+      // Deprecated parameters sort after the others","+      boost: parameter.deprecation ? 40 : 50,","+      detail: 'context',","+      doc: {","+        name: parameter.name,","+        descriptionMarkdown: queryContextParameterDocMarkdown(parameter),","+      },","+    }));","+  return {","+    afterQuote,","+    bare: afterQuote.map(completion => ({","+      ...completion,","+      label: contextKeyLabel(completion.label),","+    })),","+  };","+}","+","+const HTML_ENTITIES: Record<string, string> = {","+  amp: '&',","+  lt: '<',","+  gt: '>',","+  quot: '\"',","+  apos: \"'\",","+  nbsp: ' ',","+};","+","+function decodeHtmlEntities(text: string): string {","+  return text.replace(/&(#x[\\da-f]+|#\\d+|[a-z]+);/gi, (entity, code: string) => {","+    if (code.startsWith('#')) {","+      const codePoint = /^#x/i.test(code) ? parseInt(code.slice(2), 16) : Number(code.slice(1));","+      // An entity that is not a valid code point is left as it is","+      return codePoint > 0 && codePoint <= 0x10ffff ? String.fromCodePoint(codePoint) : entity;","+    }","+    return HTML_ENTITIES[code.toLowerCase()] ?? entity;","+  });","+}","+","+/**","+ * The docs URL of a link in a parameter description. The descriptions come from the Druid docs, where links are","+ * relative to the page they appear on, but they are written so that relative links resolve from querying/","+ * (ParameterDocumentationGeneratorTest checks that they do). A link to an anchor of the same page can not be resolved"],"additions":115,"deletions":0,"truncated":false}],"additions":506,"deletions":17,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-04T16:06:05.686482+00:00"}