\"]);","+        let statement = Statement::unnamed(vec![], vec![column(\"a\"), column(\"b\")]);","+        assert!(Row::new(statement, body).is_err());","+    }","+","+    #[test]","+    fn matching_data_row_field_count_is_accepted() {","+        let body = data_row(2, &[b\"x\", b\"y\"]);","+        let statement = Statement::unnamed(vec![], vec![column(\"a\"), column(\"b\")]);","+        assert!(Row::new(statement, body).is_ok());","+    }","+}",""],"additions":78,"deletions":4,"truncated":false}],"additions":78,"deletions":4,"truncated":false,"file_count":1},"error":null,"fetched_at":"2026-08-25T09:18:21.458584+00:00"}