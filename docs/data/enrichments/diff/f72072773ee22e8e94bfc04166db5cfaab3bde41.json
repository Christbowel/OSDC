names:","+        if scope.comparator == \"NOT IN\":","+            return","+        scope_filter = \"name = '' AND name != ''\"","+    else:","+        values = \", \".join(repr(value) for value in names)","+        scope_filter = f\"name {scope.comparator} ({values})\"","+    scoped_filter = f\"{message.filter} AND {scope_filter}\" if message.filter else scope_filter","+    setattr(g, SCOPED_REGISTERED_MODEL_FILTER, scoped_filter)","+    _set_request_field(message, \"filter\", scoped_filter)","+","+"," def _scope_experiment_ids(message, allow_missing: bool) -> list[str] | None:","     field = message.DESCRIPTOR.fields_by_name[\"experiment_ids\"]","     has_experiment_ids = _raw_request_has_field(field)","@@ -3843,6 +3877,7 @@ def _scope_logged_model_query() -> None:"," "," REQUEST_SCOPE_FUNCTIONS = {","     SearchExperiments: _scope_experiment_search_query,","+    SearchRegisteredModels: _scope_registered_model_search_query,","     BatchGetTraces: _scope_batch_trace_query,","     BatchGetTraceInfos: _scope_batch_trace_query,","     SearchLoggedModels: _scope_logged_model_query,"],"additions":49,"deletions":14,"truncated":false},{"path":"mlflow/server/handlers.py","lines":["@@ -349,7 +349,11 @@","     UpdateWebhook,","     WebhookService,"," )","-from mlflow.server._request_keys import SCOPED_EXPERIMENT_FILTER, SCOPED_EXPERIMENT_IDS","+from mlflow.server._request_keys import (","+    SCOPED_EXPERIMENT_FILTER,","+    SCOPED_EXPERIMENT_IDS,","+    SCOPED_REGISTERED_MODEL_FILTER,","+)"," from mlflow.server._search_limits import translate_scoped_search_limits"," from mlflow.server.artifact_transfer import (","     reject_proxied_artifact_download,","@@ -1204,6 +1208,10 @@ def _get_scoped_experiment_filter() -> str | None:","     return getattr(g, SCOPED_EXPERIMENT_FILTER, None) if has_request_context() else None"," "," ","+def _get_scoped_registered_model_filter() -> str | None:","+    return getattr(g, SCOPED_REGISTERED_MODEL_FILTER, None) if has_request_context() el