 [","-        (","-            \"registered-models\",","-            handlers._search_registered_models,","-            \"registered_model\",","-            \"registered_models\",","-            \"GET\",","-        ),","         (","             \"model-versions\",","             handlers._search_model_versions,","@@ -2061,6 +2060,107 @@ async def workspace_middleware(request, call_next):","         assert len(statements[0][1]) > 999"," "," ","+@pytest.mark.parametrize(\"grant\", [\"named\", \"wildcard-deny\"])","+def test_registered_model_search_reports_backend_limits_without_retry(","+    large_scope_search_setup, monkeypatch, grant","+):","+    auth_store, _, registry, role, username, password = large_scope_search_setup","+    values = [f\"scope-{index}\" for index in range(500)]","+    if grant == \"wildcard-deny\":","+        auth_store.add_role_permission(role.id, \"registered_model\", \"*\", READ.name)","+    with auth_store.ManagedSessionMaker(read_only=False) as session:","+        session.add_all([","+            SqlRolePermission(","+                role_id=role.id,","+                resource_type=\"registered_model\",","+                resource_pattern=value,","+                permission=DENY.name if grant == \"wildcard-deny\" else READ.name,","+            )","+            for value in values","+        ])","+    caller_filter = f\"name IN ({', '.join(repr(value) for value in values[:500])})\"","+    statements = []","+","+    def guard_parameters(conn, cursor, statement, parameters, context, executemany):","+        if not executemany and len(parameters) > 999:","+            statements.append((statement, parameters))","+            # Simulate a historical SQLite budget on Python versions without setlimit().","+            raise OperationalError(","+                statement, parameters, sqlite3.OperationalError(\"too many SQL variables\")","+            )","+","+    event.listen(registry.engine, \"before_cursor_execute\", guard_parameters)","+    s