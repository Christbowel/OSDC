draw. BeforeDraw removes identities","+        // with invalid contents or missing history, so BeforeTargetDraw requests a full repaint.","+        _expired.Clear();","+        foreach (var pair in _buffers)","+            if (!pair.Key.IsValid || pair.Value < _revision - (ulong)_history.Count)","+                _expired.Add(pair.Key);","+        foreach (var expired in _expired)","+            _buffers.Remove(expired);","+        _expired.Clear();","+","+        _partialPresentation = partialPresentation;","+        _buffer = partialPresentation.Buffer;","+        // Replay uses uninflated rectangles to prevent repeated antialiasing inflation.","+        // The finalized pixel rectangles describe this frame to the presentation backend.","+        tracker.CopyUninflatedRects(_frameUninflatedDirtyRects);","+        tracker.CopyRects(_frameDirtyRects);","+    }","+","+    /// <summary>","+    /// This hook needs to be called before drawing to the actual render target","+    /// It expands the current dirty rect tracker to contain all the rects we actually need","+    /// to repaint and passes those to partial presentation feature","+    /// </summary>","+    public void BeforeTargetDraw(IDirtyRectTracker tracker, LtrbRect bounds, Matrix? outputTransform = null)","+    {","+        var partialPresentation = _partialPresentation","+            ?? throw new InvalidOperationException(\"BeforeDraw must be called before BeforeTargetDraw.\");","+","+        // Trackers can cache their finalized regions. Rebuilding from the saved scene","+        // dirty rectangles lets finalization include all rectangles from the current frame and history.","+        tracker.Initialize(bounds);","+","+        // An unfamiliar or invalid buffer needs a full repaint. Otherwise, its contents","+        // already include its recorded revision, so only later scene changes need replay.","+        if (_buffer is not { IsValid: true } || !_buffers.TryGetValue(_buffer, out var revision))","+      