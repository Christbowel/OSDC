{"id":"e509ffb94361c36cbecf02801225089253fc0d49","axis":"silent","repo":"vllm-project/vllm","sha":"e509ffb94361c36cbecf02801225089253fc0d49","parsed":{"files":[{"path":".buildkite/test_areas/lm_eval.yaml","lines":["@@ -476,6 +476,7 @@ steps:","       - vllm/model_executor/layers/mamba/ops/ssu_dispatch.py","       - vllm/model_executor/layers/mamba/ops/replayssm_config.py","       - vllm/model_executor/layers/mamba/ops/selective_state_update_replayssm_output_only.py","+      - vllm/model_executor/layers/mamba/ops/selective_state_update_replayssm_spec.py","       - vllm/model_executor/warmup/kernel_warmup.py","       - vllm/model_executor/warmup/replayssm_warmup.py","       - vllm/v1/attention/backends/mamba_attn.py"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/features/automatic_prefix_caching.md","lines":["@@ -63,6 +63,8 @@ FlashInfer ReplaySSM has these limits:"," - The logical replay buffer cannot exceed 16 tokens. For speculative decoding, it must contain at least `1 + num_speculative_tokens` tokens."," - Pipeline parallelism, microbatching, and KV connectors are not supported."," ","+With `--mamba-backend triton` (for example on ROCm), ReplaySSM also supports speculative decoding with or without prefix caching. It has the same speculative-decoding buffer requirement and parallelism limits, has no 16-token buffer cap, and does not support stochastic rounding.","+"," Prefix reuse still requires a shared prefix with a saved Mamba checkpoint. The matching rules for hybrid Mamba models above also apply."," "," ## Example workloads"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/evals/gsm8k/configs/Nemotron-3-Super-120B-A12B-FP8-ReplaySSM-align-MI355.yaml","lines":["@@ -3,22 +3,20 @@ accuracy_threshold: 0.93"," num_questions: 1319"," num_fewshot: 5"," startup_max_wait_seconds: 1200","+min_acceptance_length: 2.0"," expect_prefix_cache_hits: true"," env:","-  VLLM_USE_V2_MODEL_RUNNER: \"1\"","   VLLM_ROCM_USE_AITER: \"1\"","-# 608 divides each 4864-token page and fits in the 663-token shared few-shot prefix.","+# 654 divides each 5232-token page and fits in the 663-token shared few-shot prefix."," server_args: >-","   --enforce-eager","   --max-model-len 4096","   --tensor-parallel-size 2","   --enable-expert-parallel","   --dtype bfloat16","-  --mamba-backend triton","-  --moe-backend triton","-  --attention-backend ROCM_AITER_FA","   --mamba-ssm-cache-dtype float16","   --use-replayssm","   --replayssm-buffer-len 16","   --enable-prefix-caching","-  --prefix-match-unit 608","+  --prefix-match-unit 654","+  --speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":5}'"],"additions":4,"deletions":6,"truncated":false},{"path":"tests/kernels/mamba/test_replayssm_spec_decode_mamba2.py","lines":["@@ -0,0 +1,180 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Speculative decoding with the Triton Mamba2 ReplaySSM kernels.","+","+The kernels follow FlashInfer's `checkpointing_ssu` ring contract and are","+driven here by the tracker transition of `_postprocess_replayssm_kernel`.","+Over many verify steps with random acceptance, every verified output and every","+materialized prefix state must match a plain recurrence over the accepted","+tokens.","+\"\"\"","+","+import pytest","+import torch","+import torch.nn.functional as F","+","+from vllm.model_executor.layers.mamba.ops.selective_state_update_replayssm_spec import (  # noqa: E501","+    replayssm_materialize,","+    selective_state_update_replayssm_spec,","+)","+from vllm.utils.torch_utils import set_random_seed","+from vllm.v1.attention.backends.utils import NULL_BLOCK_ID","+from vllm.v1.worker.replayssm_utils import _cuda_i64_ptrs, _cuda_i64_slot_strides","+","+NHEADS, HEADDIM, NGROUPS, DSTATE = 8, 64, 2, 128","+","+","+def _step_ref(S, x, dt, A, B, C, D):","+    \"\"\"One token of the exact recurrence on fp32 `S` (nheads, dim, dstate).\"\"\"","+    ratio = S.shape[0] // B.shape[0]","+    B = B.float().repeat_interleave(ratio, 0)","+    C = C.float().repeat_interleave(ratio, 0)","+    dt = dt.float()[:, None, None]","+    S = S * torch.exp(A[:, None, None] * dt) + dt * x.float()[:, :, None] * B[:, None]","+    return S, torch.einsum(\"hdn,hn->hd\", S, C) + D[:, None] * x.float()","+","+","+@pytest.mark.parametrize(","+    \"state_dtype,act_dtype\",","+    [","+        (torch.float32, torch.float32),","+        (torch.float32, torch.bfloat16),","+        (torch.float16, torch.bfloat16),","+    ],","+)","+@pytest.mark.parametrize(\"num_spec,max_window\", [(1, 4), (5, 16), (3, 4)])","+def test_replayssm_spec_decode_matches_recurrence(","+    state_dtype, act_dtype, num_spec, max_window","+):","+    set_random_seed(0)","+    device = \"cuda\"","+    T = 1 + num_spec","+    ring_len = max_window + T","+    batch, num_slots, num_steps = 4, 8, 24","+    exact = state_dtype == act_dtype == torch.float32","+    rtol, atol = (1e-4, 1e-3) if exact else (2e-2, 5e-2)","+","+    A = -torch.rand(NHEADS, device=device) - 0.5","+    dt_bias = torch.rand(NHEADS, device=device) - 2.0","+    D = torch.randn(NHEADS, device=device)","+    state = torch.randn(num_slots, NHEADS, HEADDIM, DSTATE, device=device).to(","+        state_dtype","+    )","+    x_cache = torch.randn(num_slots, NHEADS, ring_len, HEADDIM, device=device).to(","+        act_dtype","+    )","+    B_cache = torch.randn(num_slots, NGROUPS, ring_len, DSTATE, device=device).to(","+        act_dtype","+    )","+    dt_cache = torch.rand(num_slots, NHEADS, ring_len, device=device)","+    # Rows 1, 3, 4 and 6 hold requests; the last decode row is CUDA-graph padding.","+    slots = torch.tensor([3, 1, 6, 4, NULL_BLOCK_ID], device=device, dtype=torch.int32)","+    ring_start = torch.randint(0, ring_len, (num_slots,), device=device)","+    ring_start = ring_start.to(torch.int32)","+    num_committed = torch.zeros(num_slots, device=device, dtype=torch.int32)","+    true_state = {s: state[s].float() for s in slots[:batch].tolist()}","+    pad_x = torch.randn(NHEADS, HEADDIM, device=device).to(act_dtype)","+","+    for _ in range(num_steps):","+        seqlens = torch.randint(1, T + 1, (batch,)).tolist()","+        cu_seqlens = torch.tensor(","+            [0, *torch.tensor(seqlens).cumsum(0).tolist(), sum(seqlens)],","+            device=device,","+            dtype=torch.int32,","+        )","+        total = sum(seqlens) + 1","+        x = torch.randn(total, NHEADS, HEADDIM, device=device).to(act_dtype)","+        x[-1] = pad_x","+        dt = torch.randn(total, NHEADS, device=device).to(act_dtype)","+        B = torch.randn(total, NGROUPS, DSTATE, device=device).to(act_dtype)","+        C = torch.randn(total, NGROUPS, DSTATE, device=device).to(act_dtype)","+        out = torch.zeros_like(x)","+        prev_start, prev_committed = ring_start.clone(), num_committed.clone()","+        selective_state_update_replayssm_spec(","+            state,","+            x_cache,","+            B_cache,","+            dt_cache,","+            ring_start,","+            num_committed,","+            x,","+            dt[..., None].expand(-1, -1, HEADDIM),","+            A[:, None, None].expand(-1, HEADDIM, DSTATE),","+            B,","+            C,","+            out,","+            cu_seqlens=cu_seqlens,","+            max_seqlen=T,","+            state_batch_indices=slots,","+            D=D[:, None].expand(-1, HEADDIM),","+            dt_bias=dt_bias[:, None].expand(-1, HEADDIM),","+            dt_softplus=True,","+        )","+        assert out[-1].eq(0).all(), \"padded row must not be written\"","+","+        for b, slot in enumerate(slots[:batch].tolist()):","+            bos, seqlen = int(cu_seqlens[b]), seqlens[b]","+            accepted = int(torch.randint(1, seqlen + 1, ()))","+            S = true_state[slot]","+            for t in range(bos, bos + seqlen):","+                S, y = _step_ref(","+                    S, x[t], F.softplus(dt[t].float() + dt_bias), A, B[t], C[t], D","+                )","+                torch.testing.assert_close(out[t].float(), y, rtol=rtol, atol=atol)","+                if t == bos + accepted - 1:","+                    true_state[slot] = S","+            # Tracker transition of _postprocess_replayssm_kernel.","+            if int(prev_committed[slot]) + seqlen > max_window:","+                ring_start[slot] = (prev_start[slot] + prev_committed[slot]) % ring_len","+                num_committed[slot] = accepted","+            else:","+                num_committed[slot] = prev_committed[slot] + accepted","+","+    # Publishing a prefix snapshot replays the committed ring entries onto the","+    # checkpoint in another slot; layer 0 has no work and must be skipped.","+    live = slots[:batch].long()","+    dst_slots = [2, 5, 7, NULL_BLOCK_ID]","+    src = torch.full((2, 8), NULL_BLOCK_ID, device=device, dtype=torch.int32)","+    dst = src.clone()","+    src[1, :batch] = slots[:batch]","+    dst[1, :batch] = torch.tensor(dst_slots, device=device)","+    active = torch.full((8,), -1, device=device, dtype=torch.int32)","+    active[:batch] = torch.arange(batch, device=device).flip(0)","+    before = state.clone()","+    tables = [","+        (_cuda_i64_ptrs([t, t]), _cuda_i64_slot_strides([t, t]))","+        for t in (state, x_cache, B_cache, dt_cache)","+    ]","+    (s_ptrs, s_strides), (x_ptrs, x_strides), (B_ptrs, B_strides) = tables[:3]","+    dt_ptrs, dt_strides = tables[3]","+    replayssm_materialize(","+        s_ptrs,","+        s_strides,","+        x_ptrs,","+        x_strides,","+        B_ptrs,","+        B_strides,","+        dt_ptrs,","+        dt_strides,","+        _cuda_i64_ptrs([A, A]),","+        src,","+        dst,","+        ring_start[live].contiguous(),","+        num_committed[live].contiguous(),","+        active,","+        num_reqs=batch,","+        state_dtype=state_dtype,","+        input_dtype=act_dtype,","+        matrixA_dtype=torch.float32,","+        num_heads=NHEADS,","+        dim=HEADDIM,","+        dstate=DSTATE,","+        heads_per_group=NHEADS // NGROUPS,","+        ring_buffer_len=ring_len,","+    )","+    for slot, dst_slot in zip(live.tolist(), dst_slots[:-1]):","+        torch.testing.assert_close(","+            state[dst_slot].float(), true_state[slot], rtol=rtol, atol=atol","+        )","+    untouched = [s for s in range(num_slots) if s not in dst_slots]","+    assert state[untouched].equal(before[untouched])"],"additions":180,"deletions":0,"truncated":false},{"path":"tests/kernels/mamba/test_ssu_dispatch.py","lines":["@@ -85,6 +85,7 @@ def _replayssm_mixer(kv_cache, ring_start, committed, A):","         replayssm_buffer_len=16,","         A=A,","         mamba_config=MambaConfig(backend=MambaBackendEnum.FLASHINFER),","+        use_flashinfer_replayssm=True,","     )"," "," ","@@ -667,7 +668,7 @@ def test_replayssm_mixer_selects_mtp_layout(","     mixer.ssm_state_size = 8","     mixer.num_spec = 3","     mixer.use_replayssm = True","-    mixer.use_flashinfer_replayssm = True","+    mixer.use_flashinfer_replayssm = mixer.use_replayssm_trackers = True","     mixer.replayssm_buffer_len = 16","     mixer.mamba_config = MambaConfig(backend=MambaBackendEnum.FLASHINFER)","     mixer.cache_config = SimpleNamespace(mamba_block_size=16, mamba_cache_mode=\"none\")"],"additions":2,"deletions":1,"truncated":false},{"path":"tests/test_config.py","lines":["@@ -158,6 +158,47 @@ def test_flashinfer_replayssm_validates_config(","         VllmConfig.validate_mamba_cached_kernel(config)"," "," ","+@pytest.mark.parametrize(","+    (\"buffer_len\", \"stochastic_rounding\", \"pp_size\", \"error\"),","+    [","+        (16, False, 1, None),","+        (3, False, 1, \"--replayssm-buffer-len >= 1 \\\\+ num_speculative_tokens\"),","+        (16, True, 1, \"does not support --enable-mamba-cache-stochastic-rounding\"),","+        (16, False, 2, \"pipeline_parallel_size=1\"),","+    ],","+    ids=[\"accepted\", \"short-buffer\", \"stochastic-rounding\", \"pp\"],","+)","+def test_triton_replayssm_spec_decode_validates_config(","+    buffer_len, stochastic_rounding, pp_size, error","+):","+    config = SimpleNamespace(","+        cache_config=SimpleNamespace(","+            use_replayssm=True,","+            mamba_cache_mode=\"align\",","+            replayssm_buffer_len=buffer_len,","+        ),","+        num_speculative_tokens=3,","+        model_config=SimpleNamespace(","+            supports_replayssm=True,","+            architecture=\"NemotronHForCausalLM\",","+            dtype=torch.float16,","+        ),","+        mamba_config=SimpleNamespace(","+            backend=MambaBackendEnum.TRITON,","+            enable_stochastic_rounding=stochastic_rounding,","+        ),","+        parallel_config=SimpleNamespace(","+            pipeline_parallel_size=pp_size, use_ubatching=False","+        ),","+        kv_transfer_config=None,","+    )","+    if error:","+        with pytest.raises(ValueError, match=error):","+            VllmConfig.validate_mamba_cached_kernel(config)","+    else:","+        VllmConfig.validate_mamba_cached_kernel(config)","+","+"," def _write_json(path: Path, value: object) -> None:","     path.parent.mkdir(parents=True, exist_ok=True)","     path.write_text(json.dumps(value), encoding=\"utf-8\")"],"additions":41,"deletions":0,"truncated":false},{"path":"tests/v1/attention/test_mamba_metadata_builder.py","lines":["@@ -25,6 +25,7 @@ def _make_vllm_config(","     )","     return SimpleNamespace(","         use_flashinfer_replayssm=False,","+        use_replayssm_trackers=False,","         cache_config=SimpleNamespace(","             block_size=block_size,","             mamba_cache_mode=\"none\","],"additions":1,"deletions":0,"truncated":false},{"path":"tests/v1/attention/test_replayssm_metadata_builder.py","lines":["@@ -21,6 +21,7 @@"," from vllm.config import SpeculativeConfig"," from vllm.config.compilation import CUDAGraphMode"," from vllm.config.mamba import MambaBackendEnum","+from vllm.model_executor.layers.mamba.mamba_utils import MambaStateShapeCalculator"," from vllm.v1.kv_cache_interface import MambaSpec"," "," BLOCK_SIZE = 16","@@ -40,20 +41,17 @@ def _make_mamba_spec(","     num_speculative_tokens: int = 0,","     mamba_cache_mode: str = \"none\","," ) -> MambaSpec:","-    ring_buffer_len = buffer_len + (","-        1 + num_speculative_tokens","-        if mamba_backend == MambaBackendEnum.FLASHINFER","-        else 0","+    shapes = MambaStateShapeCalculator.append_replayssm_ring(","+        ((1, 1), (1, 1, 1)),","+        n_groups=1,","+        tp_world_size=1,","+        logical_window=buffer_len,","+        backend=mamba_backend,","+        num_speculative_tokens=num_speculative_tokens,","     )","-    replayssm_shapes = (","-        (1, ring_buffer_len, 1),","-        (1, ring_buffer_len),","-        (1, ring_buffer_len, 1),","-    )","-    base_shapes = ((1, 1), (1, 1, 1))","     return MambaSpec(","         block_size=BLOCK_SIZE,","-        shapes=(*base_shapes, *replayssm_shapes),","+        shapes=shapes,","         dtypes=(torch.float32,) * 5,","         mamba_cache_mode=mamba_cache_mode,","     )","@@ -148,14 +146,20 @@ def test_spec_decode_single_token_chunk_synthesizes_acceptance_metadata():","     assert meta.num_accepted_tokens.tolist() == [1]"," "," ","-def test_flashinfer_replayssm_state_indices_are_stable_for_full_cudagraph():","-    checkpointing_ssu = pytest.importorskip(\"flashinfer.mamba.checkpointing_ssu\")","-    if not hasattr(checkpointing_ssu, \"allocate_checkpointing_ssu_scratch\"):","-        pytest.skip(\"requires FlashInfer ReplaySSM autotuning support\")","+@pytest.mark.parametrize(","+    \"mamba_backend\", [MambaBackendEnum.TRITON, MambaBackendEnum.FLASHINFER]","+)","+def test_replayssm_tracker_state_indices_are_stable_for_full_cudagraph(","+    mamba_backend,","+):","+    if mamba_backend == MambaBackendEnum.FLASHINFER:","+        checkpointing_ssu = pytest.importorskip(\"flashinfer.mamba.checkpointing_ssu\")","+        if not hasattr(checkpointing_ssu, \"allocate_checkpointing_ssu_scratch\"):","+            pytest.skip(\"requires FlashInfer ReplaySSM autotuning support\")"," ","     builder = _create_replayssm_builder(","         16,","-        mamba_backend=MambaBackendEnum.FLASHINFER,","+        mamba_backend=mamba_backend,","         num_speculative_tokens=3,","     )","     builder.compilation_config.cudagraph_mode = CUDAGraphMode.FULL","@@ -185,3 +189,4 @@ def test_flashinfer_replayssm_state_indices_are_stable_for_full_cudagraph():","     assert second_indices is not None","     assert second_indices.data_ptr() == first_ptr","     assert torch.equal(second_indices, second.state_indices_tensor_d[:, 0])","+    assert second.write_pos_d is None and second.bc_pre_scratch is None"],"additions":21,"deletions":16,"truncated":false},{"path":"tests/v1/e2e/test_replayssm_decode.py","lines":["@@ -92,6 +92,7 @@ def _check_replayssm_parity(","     mamba_backend: str = \"triton\",","     prompts: list[str] = PROMPTS,","     name_1: str = \"replayssm\",","+    speculative_config: dict | None = None,"," ):","     # Compare logprobs, not greedy ids: ReplaySSM's fp arithmetic can flip a","     # near-tie. Baseline and ReplaySSM run at the same TP, so TP numerics are","@@ -102,6 +103,8 @@ def _check_replayssm_parity(","         enable_prefix_caching=False,","         tensor_parallel_size=tensor_parallel_size,","         mamba_backend=mamba_backend,","+        speculative_config=speculative_config,","+        disable_log_stats=speculative_config is None,","     )","     with vllm_runner(model_name, **common) as llm:","         baseline = llm.generate_greedy_logprobs(prompts, max_tokens=32, num_logprobs=5)","@@ -109,6 +112,9 @@ def _check_replayssm_parity(","         model_name, use_replayssm=True, replayssm_buffer_len=16, **common","     ) as llm:","         replay = llm.generate_greedy_logprobs(prompts, max_tokens=32, num_logprobs=5)","+       