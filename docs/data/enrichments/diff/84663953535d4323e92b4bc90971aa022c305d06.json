 are required for generating and signing HTP Ops libraries."," ```"," > $env:OPENCL_SDK_ROOT=\"C:\\Qualcomm\\OpenCL_SDK\\2.3.2\"","-> $env:HEXAGON_SDK_ROOT=\"C:\\Qualcomm\\Hexagon_SDK\\6.6.0.0\"","-> $env:HEXAGON_TOOLS_ROOT=\"C:\\Qualcomm\\Hexagon_SDK\\6.6.0.0\\tools\\HEXAGON_Tools\\19.0.07\"","+> $env:HEXAGON_SDK_ROOT=\"C:\\Qualcomm\\Hexagon_SDK\\6.7.0.0\"","+> $env:HEXAGON_TOOLS_ROOT=\"C:\\Qualcomm\\Hexagon_SDK\\6.7.0.0\\tools\\HEXAGON_Tools\\21.0.04\""," > $env:HEXAGON_HTP_CERT=\"c:\\Users\\MyUsers\\Certs\\ggml-htp-v1.pfx\""," > $env:WINDOWS_SDK_BIN=\"C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.26100.0\""," "],"additions":6,"deletions":6,"truncated":false},{"path":"ggml/src/ggml-hexagon/CMakeLists.txt","lines":["@@ -21,6 +21,7 @@ message(STATUS \"hexagon: using ${HEXAGON_SDK_ROOT} and ${HEXAGON_TOOLS_ROOT} for"," "," include(${HEXAGON_SDK_ROOT}/build/cmake/hexagon_fun.cmake)"," include(ExternalProject)","+find_package(Python3 REQUIRED COMPONENTS Interpreter)"," "," option(GGML_HEXAGON_HTP_DEBUG  \"ggml-hexagon: enable HTP debug output\" OFF)"," set(GGML_HEXAGON_HTP_BUILD_TYPE \"Release\" CACHE STRING \"ggml-hexagon: HTP skel build type (Release, RelWithDebInfo, Debug)\")","@@ -74,7 +75,8 @@ function(build_htp_skel V)","             -DHEXAGON_TOOLS_ROOT=${HEXAGON_TOOLS_ROOT}","             -DHEXAGON_HTP_DEBUG=${GGML_HEXAGON_HTP_DEBUG}","             -DDSP_VERSION=${V}","-            -DPREBUILT_LIB_DIR=\"toolv19_${V}\")","+            -DPython3_EXECUTABLE=${Python3_EXECUTABLE}","+            -DPREBUILT_LIB_DIR=\"toolv21_${V}\")","     list(APPEND HTP_SKELS ${CMAKE_CURRENT_BINARY_DIR}/libggml-htp-${V}.so)","     list(APPEND HTP_PROJECTS htp-${V})","     set(HTP_SKELS ${HTP_SKELS} PARENT_SCOPE)","@@ -85,6 +87,7 @@ build_htp_skel(v73)"," build_htp_skel(v75)"," build_htp_skel(v79)"," build_htp_skel(v81)","+build_htp_skel(v85)"," "," # Install Hexagon skels required at runtime"," install(FILES ${HTP_SKELS} TYPE LIB)"],"additions":4,"deletions":1,"truncated":false},{"path":"ggml/src/ggml-hexagon/ggml-hexagon.cpp","lines":["@@ -8399,9 +8399,9 @@ static void ggml_hexagon_init(ggml_backend_reg * reg) {","             if (opt_arch < 73) {","                 GGML_LOG_WARN(\"ggml-hex: Hexagon arch v%d is under supported range, capping at v73\\n\", opt_arch);","                 opt_arch = 73;","-            } else if (opt_arch > 81) {","-                GGML_LOG_WARN(\"ggml-hex: Hexagon arch v%d is over supported range, capping at v81\\n\", opt_arch);","-                opt_arch = 81;","+            } else if (opt_arch > 85) {","+                GGML_LOG_WARN(\"ggml-hex: Hexagon arch v%d is over supported range, capping at v85\\n\", opt_arch);","+                opt_arch = 85;","             }","         }","     } else {"],"additions":3,"deletions":3,"truncated":false},{"path":"ggml/src/ggml-hexagon/htp/CMakeLists.txt","lines":["@@ -53,9 +53,17 @@ target_compile_definitions(${HTP_LIB} PRIVATE","     $<IF:$<BOOL:${HEXAGON_HTP_DEBUG}>,HTP_DEBUG=1,NDEBUG=1>","     $<IF:$<BOOL:${HEXAGON_HTP_DEBUG}>,FARF_HIGH=1,>)"," ","-"," build_idl(htp_iface.idl ${HTP_LIB})"," "," set_target_properties(${HTP_LIB} PROPERTIES EXPORT_COMPILE_COMMANDS ON)"," ","+if (NOT Python3_EXECUTABLE)","+    find_package(Python3 REQUIRED COMPONENTS Interpreter)","+endif()","+","+add_custom_command(TARGET ${HTP_LIB} POST_BUILD","+    COMMAND ${CMAKE_COMMAND} -E echo \"Adding SWIV section $<TARGET_FILE_NAME:${HTP_LIB}>\"","+    COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/htp-swiv.py -i $<TARGET_FILE:${HTP_LIB}> -o $<TARGET_FILE:${HTP_LIB}>","+    VERBATIM)","+"," install(TARGETS ${HTP_LIB})"],"additions":9,"deletions":1,"truncated":false},{"path":"ggml/src/ggml-hexagon/htp/htp-swiv.py","lines":["@@ -0,0 +1,512 @@","+#!/usr/bin/env python3","+","+import argparse","+import logging","+import os","+import shutil","+import struct","+import sys","+import tempfile","+import zlib","+","+ELF_MAGIC = b'\\x7fELF'","+ELF_CLASS_INDEX = 4","+ELFCLASS32 = 1","+ELFCLASS64 = 2","+ELF_VERSION_INDEX = 6","+EV_CURRENT = 1","+MAX_PHDR_COUNT = 100","+","+LOAD_TYPE = 0x1","+","+SHT_NOBITS = 8","+","+SWIV_MAGIC = b'SWIV'","+SWIV_SEG_SIZE_MIN = 16","+# SHT_LOUSER plus ASCII \"SWIV\".","+SWIV_SECTION_TYPE = 0xD3574956","+","+logger = logging.getLogger(\"htp-swiv\")","+","+","+class Elf_Ehdr_common:","+    s = struct.Struct('16sHHI')","+","+    def __init__(self, data):","+        unpacked_data = (Elf_Ehdr_common.s).unpack(data)","+        self.e_ident = unpacked_data[0]","+        self.e_type = unpacked_data[1]","+        self.e_machine = unpacked_data[2]","+        self.e_version = unpacked_data[3]","+","+","+class Elf32_Ehdr:","+    s = struct.Struct('16sHHIIIIIHHHHHH')","+","+    def __init__(self, data):","+        unpacked_data = (Elf32_Ehdr.s).unpack(data)","+        self.e_ident = unpacked_data[0]","+        self.e_type = unpacked_data[1]","+        self.e_machine = unpacked_data[2]","+        self.e_version = unpacked_data[3]","+        self.e_entry = unpacked_data[4]","+        self.e_phoff = unpacked_data[5]","+        self.e_shoff = unpacked_data[6]","+        self.e_flags = unpacked_data[7]","+        self.e_ehsize = unpacked_data[8]","+        self.e_phentsize = unpacked_data[9]","+        self.e_phnum = unpacked_data[10]","+        self.e_shentsize = unpacked_data[11]","+        self.e_shnum = unpacked_data[12]","+        self.e_shstrndx = unpacked_data[13]","+","+    def get_packed_data(self):","+        values = [self.e_ident,","+                  self.e_type,","+                  self.e_machine,","+                  self.e_version,","+                  self.e_entry,","+                  self.e_phoff,","+                  self.e_shoff,","+                  self.e_flags,","+                  self.e_ehsize,","+                  self.e_phentsize,","+                  self.e_phnum,","+                  self.e_shentsize,","+                  self.e_shnum,","+                  self.e_shstrndx","+                  ]","+","+        return (Elf32_Ehdr.s).pack(*values)","+","+","+class Elf32_Phdr:","+    s = struct.Struct('I' * 8)","+","+    def __init__(self, data):","+        unpacked_data = (Elf32_Phdr.s).unpack(data)","+        self.p_type = unpacked_data[0]","+        self.p_offset = unpacked_data[1]","+        self.p_vaddr = unpacked_data[2]","+        self.p_paddr = unpacked_data[3]","+        self.p_filesz = unpacked_data[4]","+        self.p_memsz = unpacked_data[5]","+        self.p_flags = unpacked_data[6]","+        self.p_align = unpacked_data[7]","+","+    def get_packed_data(self):","+        values = [self.p_type,","+                  self.p_offset,","+                  self.p_vaddr,","+                  self.p_paddr,","+                  self.p_filesz,","+                  self.p_memsz,","+                  self.p_flags,","+                  self.p_align","+                  ]","+","+        return (Elf32_Phdr.s).pack(*values)","+","+","+class Elf32_Shdr:","+    s = struct.Struct('I' * 10)","+","+    def __init__(self, data):","+        unpacked_data = (Elf32_Shdr.s).unpack(data)","+        self.sh_name = unpacked_data[0]","+        self.sh_type = unpacked_data[1]","+        self.sh_flags = unpacked_data[2]","+        self.sh_addr = unpacked_data[3]","+        self.sh_offset = unpacked_data[4]","+        self.sh_size = unpacked_data[5]","+        self.sh_link = unpacked_data[6]","+        self.sh_info = unpacked_data[7]","+        self.sh_addralign = unpacked_data[8]","+        self.sh_entsize = unpacked_data[9]","+        self.sh_name_str = \"\"","+","+    def get_packed_data(self):","+        values = [self.sh_name,","+                  self.sh_type,","+                  self.sh_flags,","+                  self.sh_addr,","+                  self.sh_offset,","+                  self.sh_size,","+                  self.sh_link,","+                  self.sh_info,","+                  self.sh_addralign,","+                  self.sh_entsize]","+","+        return (Elf32_Shdr.s).pack(*values)","+","+","+class Elf64_Ehdr:","+    s = struct.Struct('16sHHIQQQIHHHHHH')","+","+    def __init__(self, data):","+        unpacked_data = (Elf64_Ehdr.s).unpack(data)","+        self.e_ident = unpacked_data[0]","+        self.e_type = unpacked_data[1]","+        self.e_machine = unpacked_data[2]","+        self.e_version = unpacked_data[3]","+        self.e_entry = unpacked_data[4]","+        self.e_phoff = unpacked_data[5]","+        self.e_shoff = unpacked_data[6]","+        self.e_flags = unpacked_data[7]","+        self.e_ehsize = unpacked_data[8]","+        self.e_phentsize = unpacked_data[9]","+        self.e_phnum = unpacked_data[10]","+        self.e_shentsize = unpacked_data[11]","+        self.e_shnum = unpacked_data[12]","+        self.e_shstrndx = unpacked_data[13]","+","+    def get_packed_data(self):","+        values = [self.e_ident,","+                  self.e_type,","+                  self.e_machine,","+                  self.e_version,","+                  self.e_entry,","+                  self.e_phoff,","+                  self.e_shoff,","+                  self.e_flags,","+                  self.e_ehsize,","+                  self.e_phentsize,","+                  self.e_phnum,","+                  self.e_shentsize,","+                  self.e_shnum,","+                  self.e_shstrndx","+                  ]","+","+        return (Elf64_Ehdr.s).pack(*values)","+","+","+class Elf64_Phdr:","+    s = struct.Struct('IIQQQQQQ')","+","+    def __init__(self, data):","+        unpacked_data = (Elf64_Phdr.s).unpack(data)","+        self.p_type = unpacked_data[0]","+        self.p_flags = unpacked_data[1]","+        self.p_offset = unpacked_data[2]","+        self.p_vaddr = unpacked_data[3]","+        self.p_paddr = unpacked_data[4]","+        self.p_filesz = unpacked_data[5]","+        self.p_memsz = unpacked_data[6]","+        self.p_align = unpacked_data[7]","+","+    def get_packed_data(self):","+        values = [self.p_type,","+                  self.p_flags,","+                  self.p_offset,","+                  self.p_vaddr,","+                  self.p_paddr,","+                  self.p_filesz,","+                  self.p_memsz,","+                  self.p_align","+                  ]","+","+        return (Elf64_Phdr.s).pack(*values)","+","+","+class Elf64_Shdr:","+    s = struct.Struct('IIQQQQIIQQ')","+","+    def __init__(self, data):","+        unpacked_data = (Elf64_Shdr.s).unpack(data)","+        self.sh_name = unpacked_data[0]","+        self.sh_type = unpacked_data[1]","+        self.sh_flags = unpacked_data[2]","+        self.sh_addr = unpacked_data[3]","+        self.sh_offset = unpacked_data[4]","+        self.sh_size = unpacked_data[5]","+        self.sh_link = unpacked_data[6]","+        self.sh_info = unpacked_data[7]","+        self.sh_addralign = unpacked_data[8]","+        self.sh_entsize = unpacked_data[9]","+        self.sh_name_str = \"\"","+","+    def get_packed_data(self):","+        values = [self.sh_name,","+                  self.sh_type,","+                  self.sh_flags,","+                  self.sh_addr,","+                  self.sh_offset,","+                  self.sh_size,","+                  self.sh_link,","+                  self.sh_info,","+                  self.sh_addralign,","+                  self.sh_entsize]","+","+        return (Elf64_Shdr.s).pack(*values)","+","+","+class SWIV_Seg:","+    s = struct.Struct('4sIQ')","+","+    def __init__(self):","+        self.magic = SWIV_MAGIC","+        self.crc = 0","+        self.padding = 0","+","+    def get_packed_data(self):","+        values = [self.magic,","+                  self.crc,","+                  self.padding","+                  ]","+","+        return (SWIV_Seg.s).pack(*values)","+","+","+def is_elf64(elf_header):","+    return elf_header.e_ident[ELF_CLASS_INDEX] == ELFCLASS64","+","+","+def verify_elf_header(elf_header):","+    ident = elf_header.e_ident","+    return (ident.startswith(ELF_MAGIC)","+            and ident[ELF_CLASS_INDEX] in (ELFCLASS32, ELFCLASS64)","+            and ident[ELF_VERSION_INDEX] == EV_CURRENT)","+","+","+def file_copy_offset(in_fp, in_off, out_fp, out_off, num_bytes):","+    in_fp.seek(in_off)","+    read_in = in_fp.read(num_bytes)","+    out_fp.seek(out_off)","+    out_fp.write(read_in)","+","+    return num_bytes","+","+","+def preprocess_elf_file(elf_file_name):","+    with open(elf_file_name, 'rb') as elf_fp:","+        elf_header = Elf_Ehdr_common(elf_fp.read(Elf_Ehdr_common.s.size))","+","+        if verify_elf_header(elf_header) is False:","+            raise RuntimeError(\"Input ELF verification failed : \" + elf_file_name)","+","+        elf_fp.seek(0)","+","+        if is_elf64(elf_header):","+            elf_header = Elf64_Ehdr(elf_fp.read(Elf64_Ehdr.s.size))","+        else:","+            elf_header = Elf32_Ehdr(elf_fp.read(Elf32_Ehdr.s.size))","+","+        phdr_table = []","+","+        phdr_size = elf_header.e_phentsize","+","+        file_offset = elf_header.e_phoff","+        elf_fp.seek(file_offset)","+","+        for _ in range(elf_header.e_phnum):","+            if is_elf64(elf_header):","+                phdr_table.append(Elf64_Phdr(elf_fp.read(phdr_size)))","+            else:","+                phdr_table.append(Elf32_Phdr(elf_fp.read(phdr_size)))","+","+    return [elf_header, phdr_table]","+","+","+def process_section_header(elf_file_name):","+    with open(elf_file_name, 'rb') as elf_fp:","+        elf_header = Elf_Ehdr_common(elf_fp.read(Elf_Ehdr_common.s.size))","+","+        if verify_elf_header(elf_header) is False:","+            raise RuntimeError(\"Input ELF verification failed : \" + elf_file_name)","+","+        elf_fp.seek(0)","+","+        if is_elf64(elf_header):","+            elf_header = Elf64_Ehdr(elf_fp.read(Elf64_Ehdr.s.size))","+        else:","+            elf_header = Elf32_Ehdr(elf_fp.read(Elf32_Ehdr.s.size))","+","+        shdr_table = []","+","+        shdr_size = elf_header.e_shentsize","+        elf_fp.seek(elf_header.e_shoff)","+","+        for _ in range(elf_header.e_shnum):","+            if is_elf64(elf_header):","+                shdr_table.append(Elf64_Shdr(elf_fp.read(shdr_size)))","+            else:","+                shdr_table.append(Elf32_Shdr(elf_fp.read(shdr_size)))","+","+    return shdr_table","+","+","+def crc32_update_file(elf_fp, offset, size, crc):","+    elf_fp.seek(offset)","+    remaining = size","+    while remaining > 0:","+        chunk = elf_fp.read(min(1024 * 1024, remaining))","+        if not chunk:","+            raise RuntimeError(\"Unexpected EOF while calculating CRC\")","+        crc = zlib.crc32(chunk, crc)","+        remaining -= len(chunk)","+    return crc","+","+","+def crc32_update_zeros(size, crc):","+    zero_chunk = b'\\x00' * min(1024 * 1024, size)","+    remaining = size","+    while remaining > 0:","+        chunk = zero_chunk[:min(len(zero_chunk), remaining)]","+        crc = zlib.crc32(chunk, crc)","+        remaining -= len(chunk)","+    return crc","+","+","+def crc32_calculate(elf_fp, phdr_table):","+    crc = 0","+","+    # SWIV validates loadable segment contents, including BSS as zeros.","+    for curr_phdr in phdr_table:","+        if curr_phdr.p_type != LOAD_TYPE:","+            continue","+","+        crc = crc32_update_file(elf_fp, curr_phdr.p_offset, curr_phdr.p_filesz, crc)","+","+        zero_size = curr_phdr.p_memsz - curr_phdr.p_filesz","+        if zero_size > 0:","+            crc = crc32_update_zeros(zero_size, crc)","+","+    crc &= 0xffffffff","+    logger.info(\"calculated CRC: %#x\", crc)","+","+    return crc","+","+","+def verify_swiv_seg(elf_in_fp, offset):","+","+    elf_in_fp.seek(offset)","+    swiv_seg = SWIV_Seg()","+    unpacked_data = (SWIV_Seg.s).unpack(elf_in_fp.read(SWIV_SEG_SIZE_MIN))","+    swiv_seg.magic = unpacked_data[0]","+","+    return swiv_seg.magic == SWIV_MAGIC","+","+","+def same_output_file(input_elf, output_elf):","+    try:","+      