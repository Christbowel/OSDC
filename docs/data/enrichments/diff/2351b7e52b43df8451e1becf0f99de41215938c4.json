y.","+\t\t\tlibraryelements.ProvideService(","+\t\t\t\tsetting.NewCfg(),","+\t\t\t\tdatabase,","+\t\t\t\tnil,","+\t\t\t\tfolders,","+\t\t\t\tfeaturemgmt.WithFeatures(),","+\t\t\t\tac,","+\t\t\t\t&legacyCheckDashboards{},","+\t\t\t\tnil,","+\t\t\t\tnil,","+\t\t\t)","+\t\t\tctx := identity.WithRequester(t.Context(), &identity.StaticRequester{","+\t\t\t\tType:           types.TypeAccessPolicy,","+\t\t\t\tUserUID:        \"rpc-caller\",","+\t\t\t\tNamespace:      \"org-12\",","+\t\t\t\tIsGrafanaAdmin: true,","+\t\t\t})","+\t\t\tgot, err := s.LegacyCheck(ctx, &authzextv1.LegacyCheckRequest{","+\t\t\t\tNamespace: \"org-12\",","+\t\t\t\tSubject:   \"user:checked-user\",","+\t\t\t\tExpression: &authzextv1.LegacyExpression{","+\t\t\t\t\tNode: &authzextv1.LegacyExpression_Permission{","+\t\t\t\t\t\tPermission: &authzextv1.LegacyPermission{","+\t\t\t\t\t\t\tAction: libraryelements.ActionLibraryPanelsRead,","+\t\t\t\t\t\t\tScopes: []string{\"library.panels:uid:panel\"},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.True(t, proto.Equal(tc.want, got), \"want %v, got %v\", tc.want, got)","+\t\t\tgrants := map[string][]string{","+\t\t\t\tlibraryelements.ActionLibraryPanelsRead: {\"folders:uid:parent\"},","+\t\t\t}","+\t\t\tif tc.folderVisible {","+\t\t\t\tgrants[folder.ActionFoldersRead] = []string{\"folders:uid:parent\"}","+\t\t\t}","+\t\t\trequire.Equal(t, &identity.StaticRequester{","+\t\t\t\tType:           types.TypeUser,","+\t\t\t\tUserID:         1,","+\t\t\t\tUserUID:        \"checked-user\",","+\t\t\t\tOrgID:          12,","+\t\t\t\tNamespace:      \"org-12\",","+\t\t\t\tIsGrafanaAdmin: false,","+\t\t\t\tCacheKey:       \"org-12:user:checked-user\",","+\t\t\t\tPermissions:    map[int64]map[string][]string{12: grants},","+\t\t\t}, folders.requester)","+\t\t})","+\t}","+}","+","+type legacyCheckFolders struct {","+\tfolder.Service","+\tac        accesscontrol.AccessControl","+\trequester identity.Requester","+}","+","+func (s *legacyCheckFolders) Get(","+\tctx context.Context,","+\tquery *folder.GetFolderQuery,","+) (*folder.Folder, error) {","+\ts.requester = query.SignedInUser","+\tallowed, err := s.ac.Evaluate(ctx, query.SignedInUser,","+\t\taccesscontrol.EvalPermission(folder.ActionFoldersRead, \"folders:uid:parent\"))","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tif !allowed {","+\t\treturn nil, folder.ErrAccessDenied","+\t}","+\treturn &folder.Folder{","+\t\tID:    42, //nolint:staticcheck // Exercise legacy folder ID resolution.","+\t\tUID:   \"parent\",","+\t\tOrgID: query.OrgID,","+\t\tTitle: \"Parent\",","+\t}, nil","+}","+","+func (s *legacyCheckFolders) GetParents(","+\tcontext.Context,","+\tfolder.GetParentsQuery,","+) ([]*folder.Folder, error) {","+\treturn nil, nil","+}","+","+type legacyCheckDashboards struct {","+\tdashboards.DashboardService","+}","+","+func (s *legacyCheckDashboards) GetDashboardsByLibraryPanelUID(","+\tcontext.Context,","+\tstring,","+\tint64,","+) ([]*dashboards.DashboardRef, error) {","+\treturn nil, nil","+}"],"additions":182,"deletions":0,"truncated":false},{"path":"pkg/services/authz/rbac/legacy_resolvers.go","lines":["@@ -0,0 +1,200 @@","+package rbac","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"slices\"","+","+\t\"github.com/grafana/authlib/types\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/folder\"","+)","+","+// WithLegacyScopeResolvers returns a new service instance that shares existing","+// dependencies and live resolver registrations with embedded Access Control.","+// Captured Grafana services belong to this process, so callbacks may only serve","+// namespaces produced by its namespace mapper. Standalone AuthZ needs its own providers.","+func (s *Service) WithLegacyScopeResolvers(","+\tresolvers *accesscontrol.ScopeResolverRegistry,","+\tnamespace types.NamespaceFormatter,","+) *Service {","+\tservice := *s","+\tservice.legacyScopeResolvers = resolvers","+\tservice.legacyScopeNamespace = namespace","+","+\treturn &service","+}","+","+type legacyScopeRequest struct {","+\tnamespace    types.NamespaceInfo","+\tidentityType types.IdentityType","+\tuserUID      string","+\tskipCache    bool","+}","+","+// Evaluate the original expression first. If it denies access, resolve its","+// scopes and evaluate again, matching Access Control's two-pass behavior.","+func (s *Service) evaluateLegacyWithResolvers(","+\tctx context.Context,","+\tevaluator accesscontrol.Evaluator,","+\tpermissions map[string][]string,","+\thasAnyPermissions bool,","+\tskipScopeResolution bool,","+\treq legacyScopeRequest,","+) (bool, error) {","+\tif !hasAnyPermissions {","+\t\treturn false, nil","+\t}","+","+\tif evaluator.Evaluate(permissions) {","+\t\treturn true, nil","+\t}","+","+\tif skipScopeResolution || !s.legacyScopeResolvers.HasResolvers() {","+\t\treturn false, nil","+\t}","+","+\tresolved, err := evaluator.MutateScopes(ctx, s.newLegacyScopeMutator(req, permissions))","+","+\tswitch {","+\tcase errors.Is(err, accesscontrol.ErrResolverNotFound):","+\t\treturn false, nil","+\tcase err != nil:","+\t\treturn false, fmt.Errorf(\"could not evaluate legacy expression: %w\", err)","+\tdefault:","+\t\treturn resolved.Evaluate(permissions), nil","+\t}","+}","+","+func (s *Service) validateLegacyScopeNamespace(ns types.NamespaceInfo) error {","+\tif s.legacyScopeResolvers == nil {","+\t\treturn nil","+\t}","+","+\tif s.legacyScopeNamespace == nil || s.legacyScopeNamespace(ns.OrgID) != ns.Value {","+\t\treturn errors.New(\"namespace does not belong to embedded scope resolvers\")","+\t}","+","+\treturn nil","+}","+","+func (s *Service) newLegacyScopeMutator(","+\treq legacyScopeRequest,","+\tpermissions map[string][]string,","+) accesscontrol.ScopeAttributeMutator {","+\t// TODO: this will be redeifned in the next follow up PR","+\t// https://github.com/grafana/identity-access-team/issues/2436","+\t// Resolve repeated scopes once per check. Results are not reused across","+\t// requests, avoiding tenant/subject cache keys and invalidation here.","+\tresolved := make(map[string][]string)","+\tvar requester identity.Requester","+","+\treturn func(ctx context.Context, scope string) ([]string, error) {","+\t\tif err := s.validateLegacyScopeNamespace(req.namespace); err != nil {","+\t\t\treturn nil, err","+\t\t}","+","+\t\tif scopes, ok := resolved[scope]; ok {","+\t\t\treturn slices.Clone(scopes), nil","+\t\t}","+","+\t\tresolver, ok := s.legacyScopeResolvers.Get(accesscontrol.ScopePrefix(scope))","+\t\tif !ok {","+\t\t\treturn nil, accesscontrol.ErrResolverNotFound","+\t\t}","+","+\t\tif requester == nil {","+\t\t\tvar err error","+\t\t\trequester, err = s.legacyResolverRequester(ctx, req, permissions)","+\t\t\tif err != nil {","+\t\t\t\treturn nil, err","+\t\t\t}","+\t\t}","+","+\t\t// The authenticated RPC caller can be a service acting for another user.","+\t\t// Resolvers must observe the checked subject, never that caller's privileges.","+\t\tctx = identity.WithRequester(ctx, requester)","+","+\t\tscopes, err := resolver.Resolve(ctx, req.namespace.OrgID, scope)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"could not resolve %v: %w\", scope, err)","+\t\t}","+","+\t\tresolved[scope] = slices.Clone(scopes)","+","+\t\treturn scopes, nil","+\t}","+}","+","+func (s *Service) legacyResolverRequester(","+\tctx context.Context,","+\treq legacyScopeRequest,","+\tpermissions map[string][]string,","+) (identity.Requester, error) {","+\trequester := &identity.StaticRequester{","+\t\tType:      req.identityType,","+\t\tUserUID:   req.userUID,","+\t\tOrgID:     req.namespace.OrgID,","+\t\tNamespace: req.namespace.Value,","+\t\tCacheKey:  fmt.Sprintf(\"%s:%s\", req.namespace.Value, types.NewTypeID(req.identityType, req.userUID)),","+\t}","+","+\tswitch req.identityType {","+\tcase types.TypeUser, types.TypeServiceAccount:","+\t\tidentifiers, err := s.getUserIdentifiers(ctx, req.namespace, req.userUID, req.skipCache)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"could not get user identifiers: %w\", err)","+\t\t}","+","+\t\trole, err := s.getUserBasicRoleWithCache(ctx, req.namespace, identifiers, req.skipCache)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"could not get user basic role: %w\", err)","+\t\t}","+","+\t\trequester.UserID = identifiers.ID","+\t\trequester.UserUID = identifiers.UID","+\t\trequester.OrgRole = identity.RoleType(role.Role)","+\t\trequester.IsGrafanaAdmin = role.IsAdmin","+\tcase types.TypeAnonymous:","+\t\trequester.OrgRole = identity.RoleType(s.settings.AnonOrgRole)","+\tcase types.TypeRenderService:","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"unsupported identity type: %s\", req.identityType)","+\t}","+","+\tgrants := make(map[string][]string, len(permissions)+1)","+\tfor action, scopes := range permissions {","+\t\tgrants[action] = slices.Clone(scopes)","+\t}","+","+\t// Library-panel resolution can perform folder visibility checks as the","+\t// subject. Load that action explicitly instead of fetching a full snapshot.","+\tif _, ok := grants[folder.ActionFoldersRead]; !ok {","+\t\tcheckUnrelatedPermissions := false","+\t\tscopes, _, err := s.getLegacyIdentityScopes(","+\t\t\tctx,","+\t\t\treq.namespace,","+\t\t\treq.identityType,","+\t\t\treq.userUID,","+\t\t\tfolder.ActionFoldersRead,","+\t\t\tcheckUnrelatedPermissions,","+\t\t\treq.skipCache,","+\t\t)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"could not get legacy identity scopes: %w\", err)","+\t\t}","+","+\t\tif len(scopes) > 0 {","+\t\t\tgrants[folder.ActionFoldersRead] = scopes","+\t\t}","+\t}","+","+\trequester.Permissions = map[int64]map[string][]string{","+\t\treq.namespace.OrgID: grants,","+\t}","+","+\treturn requester, nil","+}"],"additions":200,"deletions":0,"truncated":false},{"path":"pkg/services/authz/rbac/legacy_resolvers_test.go","lines":["@@ -0,