jection(() => GraphQLPhoneNumber.parseValue(value));","+      });","+","+      test('parseLiteral', () => {","+        expectFastRejection(() =>","+          GraphQLPhoneNumber.parseLiteral({ value, kind: Kind.STRING }, {}),","+        );","+      });","+    });","+","     describe('support more countries', () => {","       test('support Singapore numbers - 10 digits', () => {","         expect(() => {",""],"additions":24,"deletions":0,"truncated":false}],"additions":33,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-29T15:18:37.346941+00:00"}