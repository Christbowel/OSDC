{"id":"55b2baafe8c9a399c44199d32fcb20f280e352bc","axis":"silent","repo":"grafana/grafana","sha":"55b2baafe8c9a399c44199d32fcb20f280e352bc","parsed":{"files":[{"path":"pkg/router/auth.go","lines":["@@ -27,7 +27,7 @@ func (r *GrafanaRouter) authenticate(w http.ResponseWriter, req *http.Request) *"," "," \tvar err error"," \terrorType := \"authentication_failure\"","-\tswitch token := req.Header.Get(\"X-Access-Token\"); {","+\tswitch token := req.Header.Get(accessTokenHeader); {"," \tcase token == \"\":"," \t\terr = apierrors.NewUnauthorized(\"missing access token header\")"," \t\terrorType = \"missing_token\""],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/router/cloud_settings.go","lines":["@@ -79,8 +79,11 @@ func cloudSettingsNamespaceAuthorizer(ctx context.Context, attr authorizer.Attri"," type cloudPluginContext struct{}"," "," func (cloudPluginContext) PluginContextForApp(ctx context.Context, id string, settings *backend.AppInstanceSettings) (context.Context, backend.PluginContext, error) {","-\tns := request.NamespaceValue(ctx)","-\tif ns == \"\" || ns == \"*\" {","+\tinfo, ok := request.RequestInfoFrom(ctx)","+\tif !ok {","+\t\treturn ctx, backend.PluginContext{}, fmt.Errorf(\"missing request info\")","+\t}","+\tif info.Namespace == \"\" {"," \t\treturn ctx, backend.PluginContext{}, fmt.Errorf(\"a concrete namespace is required\")"," \t}"," \tuser, err := identity.GetRequester(ctx)","@@ -88,7 +91,9 @@ func (cloudPluginContext) PluginContextForApp(ctx context.Context, id string, se"," \t\treturn ctx, backend.PluginContext{}, err"," \t}"," \treturn ctx, backend.PluginContext{","-\t\tNamespace: ns, PluginID: id, AppInstanceSettings: settings,","+\t\tNamespace:  info.Namespace, // the tenant identity","+\t\tAPIVersion: info.APIVersion,","+\t\tPluginID:   id, AppInstanceSettings: settings,"," \t\tUser: adapters.BackendUserFromSignedInUser(user),"," \t}, nil"," }"],"additions":8,"deletions":3,"truncated":false},{"path":"pkg/router/cloud_settings_auth.go","lines":["@@ -0,0 +1,111 @@","+package router","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+","+\tauthnlib \"github.com/grafana/authlib/authn\"","+\tauthlib \"github.com/grafana/authlib/types\"","+\t\"k8s.io/apiserver/pkg/endpoints/request\"","+","+\t\"github.com/grafana/grafana-plugin-sdk-go/backend\"","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+)","+","+const accessTokenHeader = \"X-Access-Token\"","+","+// newV2AuthenticationMiddleware authenticates v2 calls to a plugin the way","+// v3 calls are (see v3.WithAuthentication): each request carries an access","+// token exchanged for the caller, with the plugin ID as its audience, scoped to","+// the request's namespace. Missing caller credentials fail the request, except","+// for Grafana's own service identity, which uses the service token. A nil","+// exchanger leaves requests unauthenticated, as for v3.","+func newV2AuthenticationMiddleware(pluginID string, exchanger authnlib.TokenExchanger) backend.HandlerMiddleware {","+\treturn backend.HandlerMiddlewareFunc(func(next backend.Handler) backend.Handler {","+\t\tif exchanger == nil {","+\t\t\treturn next","+\t\t}","+\t\treturn &v2AuthenticationHandler{","+\t\t\tBaseHandler: backend.NewBaseHandler(next),","+\t\t\tpluginID:    pluginID,","+\t\t\texchanger:   exchanger,","+\t\t}","+\t})","+}","+","+type v2AuthenticationHandler struct {","+\tbackend.BaseHandler","+\tpluginID  string","+\texchanger authnlib.TokenExchanger","+}","+","+func (h *v2AuthenticationHandler) CheckHealth(ctx context.Context, req *backend.CheckHealthRequest) (*backend.CheckHealthResult, error) {","+\tif req != nil {","+\t\tif err := h.authenticate(ctx, req.PluginContext.Namespace, req); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t}","+\treturn h.BaseHandler.CheckHealth(ctx, req)","+}","+","+func (h *v2AuthenticationHandler) CallResource(ctx context.Context, req *backend.CallResourceRequest, sender backend.CallResourceResponseSender) error {","+\tif req != nil {","+\t\tif err := h.authenticate(ctx, req.PluginContext.Namespace, req); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+\treturn h.BaseHandler.CallResource(ctx, req, sender)","+}","+","+// audiences returns the API group being requested, from the request info in","+// ctx, and the plugin ID when it differs: a plugin accepts tokens for either.","+func audiences(ctx context.Context, pluginID string) []string {","+\tif info, ok := request.RequestInfoFrom(ctx); ok && info.APIGroup != \"\" && info.APIGroup != pluginID {","+\t\treturn []string{info.APIGroup, pluginID}","+\t}","+\treturn []string{pluginID}","+}","+","+// authenticate sets the exchanged token on the request's headers, replacing any","+// the caller sent.","+func (h *v2AuthenticationHandler) authenticate(ctx context.Context, namespace string, req backend.ForwardHTTPHeaders) error {","+\tcaller, ok := authlib.AuthInfoFrom(ctx)","+\tif !ok || caller == nil {","+\t\treturn errors.New(\"plugin token exchange: caller auth info is required\")","+\t}","+\t// An empty subject token requests Grafana's own service token.","+\tsubjectToken := \"\"","+\tif !identity.IsServiceIdentity(ctx) {","+\t\t// Prefer the access token to preserve an existing delegation chain.","+\t\tsubjectToken = caller.GetAccessToken()","+\t\tif subjectToken == \"\" {","+\t\t\tsubjectToken = caller.GetIDToken()","+\t\t}","+\t\tif subjectToken == \"\" {","+\t\t\treturn errors.New(\"plugin token exchange: caller access or ID token is required\")","+\t\t}","+\t}","+\tif caller.GetNamespace() == \"\" {","+\t\treturn errors.New(\"plugin token exchange: caller namespace is required\")","+\t}","+\tif namespace == \"\" {","+\t\tnamespace = caller.GetNamespace()","+\t} else if !authlib.NamespaceMatches(caller.GetNamespace(), namespace) {","+\t\treturn errors.New(\"plugin token exchange: caller namespace does not cover the requested namespace\")","+\t}","+\trsp, err := h.exchanger.Exchange(ctx, authnlib.TokenExchangeRequest{","+\t\tNamespace:    namespace,","+\t\tAudiences:    audiences(ctx, h.pluginID),","+\t\tSubjectToken: subjectToken,","+\t})","+\tif err != nil {","+\t\treturn fmt.Errorf(\"cloud plugin token exchange: %w\", err)","+\t}","+\tif rsp == nil || rsp.Token == \"\" {","+\t\treturn errors.New(\"cloud plugin token exchange: empty access token\")","+\t}","+\treq.SetHTTPHeader(accessTokenHeader, rsp.Token)","+","+\treturn nil","+}"],"additions":111,"deletions":0,"truncated":false},{"path":"pkg/router/cloud_settings_auth_test.go","lines":["@@ -0,0 +1,154 @@","+package router","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+\t\"testing/synctest\"","+\t\"time\"","+","+\tauthnlib \"github.com/grafana/authlib/authn\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/backend\"","+\t\"github.com/sony/gobreaker/v2\"","+\t\"github.com/stretchr/testify/require\"","+\t\"k8s.io/apiserver/pkg/endpoints/request\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/plugins\"","+\t\"github.com/grafana/grafana/pkg/services/user\"","+)","+","+type recordingExchanger struct {","+\treqs []authnlib.TokenExchangeRequest","+\terr  error","+}","+","+func (e *recordingExchanger) Exchange(_ context.Context, r authnlib.TokenExchangeRequest) (*authnlib.TokenExchangeResponse, error) {","+\te.reqs = append(e.reqs, r)","+\tif e.err != nil {","+\t\treturn nil, e.err","+\t}","+\treturn &authnlib.TokenExchangeResponse{Token: \"exchanged\"}, nil","+}","+","+func TestV2AuthenticationMiddleware(t *testing.T) {","+\tcallerCtx := func(access, id string) context.Context {","+\t\treturn identity.WithRequester(context.Background(), &user.SignedInUser{","+\t\t\tNamespace: \"stacks-1\", AccessToken: access, IDToken: id,","+\t\t})","+\t}","+\tvar gotHeader string","+\tnext := backend.CheckHealthHandlerFunc(func(_ context.Context, req *backend.CheckHealthRequest) (*backend.CheckHealthResult, error) {","+\t\tgotHeader = req.GetHTTPHeader(accessTokenHeader)","+\t\treturn &backend.CheckHealthResult{}, nil","+\t})","+\thandler := func(ex authnlib.TokenExchanger) backend.CheckHealthHandler {","+\t\th, err := backend.HandlerFromMiddlewares(&backend.Handlers{CheckHealthHandler: next}, newV2AuthenticationMiddleware(\"my-app\", ex))","+\t\trequire.NoError(t, err)","+\t\treturn h","+\t}","+\thealth := func(h backend.CheckHealthHandler, ctx context.Context, ns string) error {","+\t\treq := &backend.CheckHealthRequest{PluginContext: backend.PluginContext{Namespace: ns}}","+\t\treq.SetHTTPHeader(accessTokenHeader, \"caller-supplied\")","+\t\t_, err := h.CheckHealth(ctx, req)","+\t\treturn err","+\t}","+","+\tt.Run(\"exchanges the caller's access token for the plugin audience\", func(t *testing.T) {","+\t\tex := &recordingExchanger{}","+\t\trequire.NoError(t, health(handler(ex), callerCtx(\"at\", \"id\"), \"stacks-1\"))","+\t\trequire.Equal(t, \"exchanged\", gotHeader)","+\t\trequire.Equal(t, []authnlib.TokenExchangeRequest{{Namespace: \"stacks-1\", Audiences: []string{\"my-app\"}, SubjectToken: \"at\"}}, ex.reqs)","+\t})","+\tt.Run(\"adds the requested group when it differs from the plugin ID\", func(t *testing.T) {","+\t\tex := &recordingExchanger{}","+\t\tctx := request.WithRequestInfo(callerCtx(\"at\", \"\"), &request.RequestInfo{APIGroup: \"my-app.grafana.app\"})","+\t\trequire.NoError(t, health(handler(ex), ctx, \"stacks-1\"))","+\t\trequire.Equal(t, []string{\"my-app.grafana.app\", \"my-app\"}, ex.reqs[0].Audiences)","+\t})","+\tt.Run(\"does not repeat a group equal to the plugin ID\", func(t *testing.T) {","+\t\tex := &recordingExchanger{}","+\t\tctx := request.WithRequestInfo(callerCtx(\"at\", \"\"), &request.RequestInfo{APIGroup: \"my-app\"})","+\t\trequire.NoError(t, health(handler(ex), ctx, \"stacks-1\"))","+\t\trequire.Equal(t, []string{\"my-app\"}, ex.reqs[0].Audiences)","+\t})","+\tt.Run(\"falls back to the ID token\", func(t *testing.T) {","+\t\tex := &recordingExchanger{}","+\t\trequire.NoError(t, health(handler(ex), callerCtx(\"\", \"id\"), \"\"))","+\t\trequire.Equal(t, \"id\", ex.reqs[0].SubjectToken)","+\t\trequire.Equal(t, \"stacks-1\", ex.reqs[0].Namespace)","+\t})","+\tt.Run(\"rejects a namespace the caller does not cover\", func(t *testing.T) {","+\t\tex := &recordingExchanger{}","+\t\trequire.Error(t, health(handler(ex), callerCtx(\"at\", \"\"), \"stacks-2\"))","+\t\trequire.Empty(t, ex.reqs)","+\t})","+\tt.Run(\"rejects a caller without tokens\", func(t *testing.T) {","+\t\tex := &recordingExchanger{}","+\t\trequire.Error(t, health(handler(ex), callerCtx(\"\", \"\"), \"stacks-1\"))","+\t\trequire.Empty(t, ex.reqs)","+\t})","+\tt.Run(\"rejects a missing caller\", func(t *testing.T) {","+\t\trequire.Error(t, health(handler(&recordingExchanger{}), context.Background(), \"stacks-1\"))","+\t})","+\tt.Run(\"fails the request when the exchange fails\", func(t *testing.T) {","+\t\trequire.Error(t, health(handler(&recordingExchanger{err: errors.New(\"boom\")}), callerCtx(\"at\", \"\"), \"stacks-1\"))","+\t})","+\tt.Run(\"nil exchanger leaves the request untouched\", func(t *testing.T) {","+\t\tgotHeader = \"\"","+\t\trequire.NoError(t, health(handler(nil), context.Background(), \"stacks-1\"))","+\t\trequire.Equal(t, \"caller-supplied\", gotHeader)","+\t})","+}","+","+func TestCloudPluginContextFromRequestInfo(t *testing.T) {","+\tctx := identity.WithRequester(context.Background(), &user.SignedInUser{Namespace: \"stacks-1\"})","+\tctx = request.WithRequestInfo(ctx, &request.RequestInfo{APIVersion: \"v0alpha1\", Namespace: \"stacks-1\"})","+\t_, pCtx, err := cloudPluginContext{}.PluginContextForApp(ctx, \"my-app\", nil)","+\trequire.NoError(t, err)","+\trequire.Equal(t, \"v0alpha1\", pCtx.APIVersion)","+\trequire.Equal(t, \"stacks-1\", pCtx.Namespace)","+}","+","+type unavailableHealthClient struct {","+\tplugins.Client","+\tcalls int","+}","+","+func (c *unavailableHealthClient) CheckHealth(context.Context, *backend.CheckHealthRequest) (*backend.CheckHealthResult, error) {","+\tc.calls++","+\treturn nil, plugins.ErrPluginUnavailable","+}","+","+// A token exchange failure says nothing about the plugin, so it must not settle","+// the breaker's half-open trial as a success.","+func TestV2AuthenticationFailureLeavesHalfOpenBreakerAlone(t *testing.T) {","+\tsynctest.Test(t, func(t *testing.T) {","+\t\tplugin := &unavailableHealthClient{}","+\t\texchanger := &recordingExchanger{}","+\t\tb := &PluginBackend{pluginID: \"my-app\", deps: PluginDependencies{","+\t\t\tSettings:       SettingsDependencies{AuthenticateV2: true},","+\t\t\tTokenExchanger: exchanger,","+\t\t}}","+\t\tclient, err := b.settingsPluginClient(plugin)","+\t\trequire.NoError(t, err)","+","+\t\tcb := newGroupBreaker(\"plugin\")","+\t\tctx := withClientBreaker(identity.WithRequester(t.Context(), &user.SignedInUser{Namespace: \"stacks-1\", AccessToken: \"at\"}), cb)","+\t\treq := func() error {","+\t\t\t_, err := client.CheckHealth(ctx, &backend.CheckHealthRequest{PluginContext: backend.PluginContext{Namespace: \"stacks-1\"}})","+\t\t\treturn err","+\t\t}","+\t\tfor range breakerOpenAfter {","+\t\t\trequire.ErrorIs(t, req(), plugins.ErrPluginUnavailable)","+\t\t}","+\t\trequire.Equal(t, gobreaker.StateOpen, cb.State())","+","+\t\ttime.Sleep(breakerOpenFor + time.Second)","+\t\texchanger.err = errors.New(\"exchange failed\")","+\t\tcalls := plugin.calls","+\t\trequire.ErrorContains(t, req(), \"plugin token exchange\")","+\t\trequire.Equal(t, calls, plugin.calls, \"the plugin is not called without a token\")","+\t\trequire.Equal(t, gobreaker.StateHalfOpen, cb.State(), \"the failed exchange did not close the breaker\")","+\t})","+}"],"additions":154,"deletions":0,"truncated":false},{"path":"pkg/router/loader_factory.go","lines":["@@ -136,6 +136,7 @@ func ProvideCloudRoutesLoader("," \t\tSettings: SettingsDependencies{"," \t\t\tLegacyStore:         settings.LegacyStore,"," \t\t\tReadOnly:            true,","+\t\t\tAuthenticateV2:      true,"," \t\t\tAccessChecker:       cloudSettingsAcce