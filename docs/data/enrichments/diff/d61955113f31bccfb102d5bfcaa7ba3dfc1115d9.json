"," \tif pageSizeStr != \"\" {"," \t\tpageSize, err := strconv.Atoi(pageSizeStr)"," \t\tif err != nil || pageSize < 0 {","-\t\t\treturn tracestore.Pagination{}, present, fmt.Errorf(\"malformed parameter %s: %s\", paramPageSize, pageSizeStr)","+\t\t\treturn querysvc.Pagination{}, present, fmt.Errorf(\"malformed parameter %s: %s\", paramPageSize, pageSizeStr)"," \t\t}"," \t\tpagination.PageSize = pageSize"," \t}","@@ -135,11 +134,9 @@ func parseFindTracesQuery(q url.Values) (*querysvc.TraceQueryParams, error) {"," \toperationName, _ := getQueryParam(q, paramOperationName, paramOperationNameDeprecated)"," "," \tqueryParams := &querysvc.TraceQueryParams{","-\t\tTraceQueryParams: tracestore.TraceQueryParams{","-\t\t\tServiceName:   serviceName,","-\t\t\tOperationName: operationName,","-\t\t\tAttributes:    pcommon.NewMap(),","-\t\t},","+\t\tServiceName:   serviceName,","+\t\tOperationName: operationName,","+\t\tAttributes:    pcommon.NewMap(),"," \t}"," \tif attrsParam := q.Get(paramAttributes); attrsParam != \"\" {"," \t\tvar attrsMap map[string]string"],"additions":5,"deletions":8,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/apiv3/query_parser_test.go","lines":["@@ -14,6 +14,7 @@ import ("," \t\"go.opentelemetry.io/collector/pdata/pcommon\""," "," \texpression \"github.com/jaegertracing/jaeger-idl/query/expression/v1\"","+\t\"github.com/jaegertracing/jaeger/cmd/jaeger/internal/extension/jaegerquery/querysvc\""," \t\"github.com/jaegertracing/jaeger/internal/storage/v2/api/tracestore\""," )"," ","@@ -147,12 +148,12 @@ func TestParseFindTracesQuery(t *testing.T) {"," \t\tq.Set(paramPageToken, \"opaque-cursor\")"," \t\tgot, err = parseFindTracesQuery(q)"," \t\trequire.NoError(t, err)","-\t\tassert.Equal(t, &tracestore.Pagination{PageSize: 10, PageToken: \"opaque-cursor\"}, got.Pagination)","+\t\tassert.Equal(t, &querysvc.Pagination{PageSize: 10, PageToken: \"opaque-cursor\"}, got.Pagination)"," "," \t\tq.Del(paramPageSize)"," \t\tgot, err = parseFindTracesQuery(q)"," \t\trequire.NoError(t, err)","-\t\tassert.Equal(t, &tracestore.Pagination{PageToken: \"opaque-cursor\"}, got.Pagination,","+\t\tassert.Equal(t, &querysvc.Pagination{PageToken: \"opaque-cursor\"}, got.Pagination,"," \t\t\t\"a token alone is still a paginated request; the missing page size is the query service's refusal\")"," \t})"," ","@@ -445,7 +446,7 @@ func TestParseFindSpansQuery(t *testing.T) {"," "," \t\tgot, err := parseFindSpansQuery(q)"," \t\trequire.NoError(t, err)","-\t\tassert.Equal(t, tracestore.Pagination{PageSize: 10, PageToken: \"opaque-cursor\"}, got.Pagination)","+\t\tassert.Equal(t, querysvc.Pagination{PageSize: 10, PageToken: \"opaque-cursor\"}, got.Pagination)"," \t})"," "," \tt.Run(\"pagination parameters are optional\", func(t *testing.T) {"],"additions":4,"deletions":3,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/grpc_handler.go","lines":["@@ -140,17 +140,15 @@ func (g *GRPCHandler) FindTraces(r *api_v2.FindTracesRequest, stream api_v2.Quer"," \t\treturn status.Errorf(codes.InvalidArgument, \"missing query\")"," \t}"," \tqueryParams := querysvc.TraceQueryParams{","-\t\tTraceQueryParams: tracestore.TraceQueryParams{","-\t\t\tServiceName:   query.ServiceName,","-\t\t\tOperationName: query.OperationName,","-\t\t\tAttributes:    convertTagsToAttributes(query.Tags),","-\t\t\tStartTimeMin:  query.StartTimeMin,","-\t\t\tStartTimeMax:  query.StartTimeMax,","-\t\t\tDurationMin:   query.DurationMin,","-\t\t\tDurationMax:   query.DurationMax,","-\t\t\tSearchDepth:   int(query.SearchDepth),","-\t\t},","-\t\tRawTraces: query.RawTraces,","+\t\tServiceName:   query.ServiceName,","+\t\tOperationName: query.OperationName,","+\t\tAttributes:    convertTagsToAttributes(query.Tags),","+\t\tStartTimeMin:  query.StartTimeMin,","+\t\tStartTimeMax:  query.StartTimeMax,","+\t\tDurationMin:   query.DurationMin,","+\t\tDurationMax:   query.DurationMax,","+\t\tSearchDepth:   int(query.SearchDepth),","+\t\tRawTraces:     query.RawTraces,"," \t}"," \tfindTracesIter := g.queryService.FindTraces(stream.Context(), queryParams)"," \ttraces, err := v1adapter.V1TracesFromSeq2(findTracesIter)"],"additions":9,"deletions":11,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/mcptools/internal/handlers/search_traces.go","lines":["@@ -173,17 +173,15 @@ func (h *searchTracesHandler) buildQuery(input types.SearchTracesInput) (querysv"," \t}"," "," \treturn querysvc.TraceQueryParams{","-\t\tTraceQueryParams: tracestore.TraceQueryParams{","-\t\t\tServiceName:   input.ServiceName,","-\t\t\tOperationName: input.SpanName,","-\t\t\tAttributes:    attributes,","-\t\t\tStartTimeMin:  minStartTime,","-\t\t\tStartTimeMax:  maxStartTime,","-\t\t\tDurationMin:   durationMin,","-\t\t\tDurationMax:   durationMax,","-\t\t\tSearchDepth:   searchDepth,","-\t\t},","-\t\tRawTraces: false,","+\t\tServiceName:   input.ServiceName,","+\t\tOperationName: input.SpanName,","+\t\tAttributes:    attributes,","+\t\tStartTimeMin:  minStartTime,","+\t\tStartTimeMax:  maxStartTime,","+\t\tDurationMin:   durationMin,","+\t\tDurationMax:   durationMax,","+\t\tSearchDepth:   searchDepth,","+\t\tRawTraces:     false,"," \t}, nil"," }"," "],"additions":9,"deletions":11,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/conversion.go","lines":["@@ -0,0 +1,105 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package querysvc","+","+import (","+\t\"fmt\"","+","+\t\"github.com/jaegertracing/jaeger/internal/storage/v2/api/tracestore\"","+)","+","+// This file turns the request a caller sends into the query a reader receives. The two are","+// different types on purpose, so every default, clamp and check lands here and never on the","+// caller's request; conversion_test.go checks by reflection that every field is carried across.","+","+// toReaderQuery checks the fields every trace search carries whichever filtering model it uses,","+// and returns the query in the reader's shape with DefaultSearchDepth applied where the caller","+// left the bound unset and an oversized page clamped rather than refused (RFC 0014 §4, AIP-158).","+// The API handlers only translate their wire shape into the request; what a query must satisfy","+// is decided here, once.","+func (q TraceQueryParams) toReaderQuery() (tracestore.TraceQueryParams, error) {","+\tquery := tracestore.TraceQueryParams{","+\t\tServiceName:   q.ServiceName,","+\t\tOperationName: q.OperationName,","+\t\tAttributes:    q.Attributes,","+\t\tStartTimeMin:  q.StartTimeMin,","+\t\tStartTimeMax:  q.StartTimeMax,","+\t\tDurationMin:   q.DurationMin,","+\t\tDurationMax:   q.DurationMax,","+\t\tSearchDepth:   q.SearchDepth,","+\t\tFilter:        q.Filter,","+\t}","+\tif q.StartTimeMin.IsZero() || q.StartTimeMax.IsZero() {","+\t\treturn query, fmt.Errorf(\"%w: min and max start time are required\", ErrQueryInvalid)","+\t}","+\tif !q.StartTimeMin.Before(q.StartTimeMax) {","+\t\treturn query, fmt.Errorf(\"%w: min start time must be before max start time\", ErrQueryInvalid)","+\t}","+\tif q.DurationMin < 0 || q.DurationMax < 0 {","+\t\treturn query, fmt.Errorf(\"%w: min and max duration cannot be negative\", ErrQueryInvalid)","+\t}","+\tif q.DurationMin > 0 && q.DurationMax > 0 && q.DurationMax < q.DurationMin {","+\t\treturn query, fmt.Errorf(\"%w: max duration cannot be less than min duration\", ErrQueryInvalid)","+\t}","+\tif q.SearchDepth < 0 || q.SearchDepth > tracestore.MaxSearchDepth {","+\t\treturn query, fmt.Errorf(\"%w: search depth must be in [0, %d]\", ErrQueryInvalid, tracestore.MaxSearchDepth)","+\t}","+\tif q.Pagination == nil {","+\t\tif q.SearchDepth == 0 {","+\t\t\tquery.SearchDepth = DefaultSearchDepth","+\t\t}","+\t\treturn query, nil","+\t}","+\tif !PaginationGate.IsEnabled() {","+\t\treturn query, fmt.Errorf(\"%w: enable the %q feature gate to use it\",","+\t\t\tErrPaginationDisabled, PaginationGate.ID())","+\t}","+\t// A page size replaces the search depth rather than falling back to it (RFC 0014 §4).","+\tif q.SearchDepth != 0 {","+\t\treturn query, fmt.Errorf(\"%w: it cannot be combined with search depth\",","+\t\t\ttracestore.ErrPaginationInvalid)","+\t}","+\tif q.Pagination.PageSize <= 0 {","+\t\treturn query, fmt.Errorf(\"%w: page size is required whenever pagination is present\",","+\t\t\ttracestore.ErrPaginationInvalid)","+\t}","+\tquery.Pagination = &tracestore.Pagination{","+\t\tPageSize:  min(q.Pagination.PageSize, tracestore.MaxPageSize),","+\t\tPageToken: q.Pagination.PageToken,","+\t}","+\treturn query, nil","+}","+","+// toReaderQuery is the span-search counterpart of TraceQueryParams.toReaderQuery: it checks the","+// time window, applies the pagination gate, and fills in or clamps the page size. A page token is","+// what makes the request a paginated one, and that is what the feature gate governs. The page","+// size is only the bound (RFC 0016 §6): unset means DefaultPageSize, as an omitted size does on","+// Elasticsearch, and an oversized one is clamped rather than refused (RFC 0014 §4). The filter","+// and the reader's capabilities are prepareSpanSearchQuery's, since they depend on the backend.","+func (q SpanQueryParams) toReaderQuery() (tracestore.SpanQueryParams, error) {","+\tquery := tracestore.SpanQueryParams{","+\t\tStartTimeMin: q.StartTimeMin,","+\t\tStartTimeMax: q.StartTimeMax,","+\t\tFilter:       q.Filter,","+\t\tPagination: tracestore.Pagination{","+\t\t\tPageSize:  q.Pagination.PageSize,","+\t\t\tPageToken: q.Pagination.PageToken,","+\t\t},","+\t}","+\tif q.StartTimeMin.IsZero() || q.StartTimeMax.IsZero() {","+\t\treturn query, fmt.Errorf(\"%w: start_time_min and start_time_max are required\", ErrQueryInvalid)","+\t}","+\tif !q.StartTimeMin.Before(q.StartTimeMax) {","+\t\treturn query, fmt.Errorf(\"%w: start_time_min must be before start_time_max\", ErrQueryInvalid)","+\t}","+\tif q.Pagination.PageToken != \"\" && !PaginationGate.IsEnabled() {","+\t\treturn query, fmt.Errorf(\"%w: enable the %q feature gate to use it\",","+\t\t\tErrPaginationDisabled, PaginationGate.ID())","+\t}","+\tif q.Pagination.PageSize == 0 {","+\t\tquery.Pagination.PageSize = DefaultPageSize","+\t}","+\tquery.Pagination.PageSize = min(query.Pagination.PageSize, tracestore.MaxPageSize)","+\treturn query, nil","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/conversion_test.go","lines":["@@ -0,0 +1,131 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package querysvc","+","+import (","+\t\"reflect\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/collector/pdata/pcommon\"","+","+\texpression \"github.com/jaegertracing/jaeger-idl/query/expression/v1\"","+\t\"github.com/jaegertracing/jaeger/internal/storage/v2/api/tracestore\"","+)","+","+// The request types and the reader's query types are converted field by field, so a field added","+// to either side compiles without being carried across. These tests walk the fields by reflection","+// so that such a field fails a test instead: a request field must reach the reader's query under","+// the same name unless it is listed as request-only, and a reader field must have a request field","+// that feeds it.","+","+// requestOnlyTraceFields are the trace request fields that have no counterpart in the reader's","+// query. Each is asserted to be absent from tracestore.TraceQueryParams, so the list cannot hide a","+// field that gained one.","+var requestOnlyTraceFields = map[string]bool{","+\t\"RawTraces\": true, // presentation, applied after the reader answers","+}","+","+// distinctValue returns a value of the field's type that is not the zero value and stays inside","+// the range toReaderQuery accepts alongside a bare time window. A field of a type this function","+// does not know fails the test, which is the point: the new field needs a generator and a mapping.","+func distinctValue(t *testing.T, field reflect.StructField) reflect.Value {","+\tt.Helper()","+\tswitch field.Type {","+\tcase reflect.TypeOf(\"\"):","+\t\treturn reflect.ValueOf(field.Name)","+\tcase reflect.TypeOf(0):","+\t\treturn reflect.ValueOf(7)","+\tcase reflect.TypeOf(true):","+\t\treturn reflect.ValueOf(true)","+\tcase reflect.TypeOf(time.Duration(0)):","+\t\treturn reflect.ValueOf(7 * time.Millisecond)","+\tcase reflect.TypeOf(time.Time{}):","+\t\t// Inside the base window, so it is valid as either bound.","+\t\treturn reflect.ValueOf(testWindowStart.Add(30 * time.Second))","+\tcase reflect.TypeOf(pcommon.Map{}):","+\t\tm := pcommon.NewMap()","+\t\tm.PutStr(\"k\", \"v\")","+\t\treturn reflect.ValueOf(m)","+\tcase reflect.TypeOf((*expression.Call)(nil)):","+\t\treturn reflect.ValueOf(serviceIs(\"cart\"))","+\tcase reflect.TypeOf((*Pagination)(nil)):","+\t\treturn reflect.ValueOf(&Pagination{PageSize: 7, PageToken: \"token\"})","+\tcase reflect.TypeOf(Pagination{}):","+\t\treturn reflect.ValueOf(Pagination{PageSize: 7, PageToken: \"token\"})","+\t}","+\tt.Fatalf(\"no distinct value for field %s of type %s; add one and map the field\", field.Name, field.Type)","+\treturn reflect.Value{}","+}","+","+// assertCarried checks that the request field reached the reader's query. Pagination is the one","+// field whose type differs between the two, so it is compared member by member.","+func assertCarried(t *testing.T, field reflect.StructField, want, got reflect.Value) {","+\tt.Helper()","+\tif field.Name != \"Pagination\" {","+\t\tassert.Equal(t, want.Interface(), got.Interface(), field.Name)","+\t\treturn","+\t}","+\twant, got = reflect.Indirect(want), reflect.Indirect(got)","+\trequire.True(t, got.IsValid(), \"Pagination reached the reader as nil\")","+\tassert.Equal(t, want.FieldByName(\"PageSize\").Interface(), got.FieldByName(\"PageSize\").Interface())","+\tassert.Equal(t, want.FieldByName(\"PageToken\").Interface(), got.FieldByName(\"PageToken\").Interface())","+}","+","+func TestTraceQueryParams_EveryFieldReachesTheReader(t *testing.T) {","+\tenablePagination(t)","+\trequestType := reflect.TypeOf(TraceQueryParams{})","+\treaderType := reflect.TypeOf(tracestore.TraceQueryParams{})","+","+\tfor i := 0; i < requestType.NumField(); i++ {","+\t\tfield := requestType.Field(i)","+\t\tt.Run(field.Name, func(t *testing.T) {","+\t\t\tif requestOnlyTraceFields[field.Name] {","+\t\t\t\t_, ok := readerType.FieldByName(field.Name)","+\t\t\t\tassert.False(t, ok, \"%s is listed as request-only but the reader's query has it\", field.Name)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequest := TraceQueryParams{StartTimeMin: testWindowStart, StartTimeMax: testWindowEnd}","+\t\t\treflect.ValueOf(&request).Elem().Field(i).Set(distinctValue(t, field))","+","+\t\t\tquery, err := request.toReaderQuery()","+\t\t\trequire.NoError(t, err)","+\t\t\tgot := reflect.ValueOf(query).FieldByName(field.Name)","+\t\t\trequire.True(t, got.IsValid(), \"the reader's query has no field %s\", field.Name)","+\t\t\tassertCarried(t, field, reflect.ValueOf(request).Field(i), got)","+\t\t})","+\t}","+\tfor i := 0; i < readerType.NumField(); i++ {","+\t\tname := readerType.Field(i).Name","+\t\t_, ok := requestType.FieldByName(name)","+\t\tassert.True(t, ok, \"the reader's query field %s has no request field feeding it\", name)","+\t}","+}","+","+func TestSpanQueryParams_EveryFieldReachesTheReader(t *testing.T) {","+\tenablePagination(t)","+\trequestType := reflect.TypeOf(SpanQueryParams{})","+\treaderType := reflect.TypeOf(tracestore.SpanQueryParams{})","+","+\tfor i := 0; i < requestType.NumField(); i++ {","+\t\tfield := requestType.Field(i)","+\t\tt.Run(field.Name, func(t *testing.T) {","+\t\t\trequest := SpanQueryParams{StartTimeMin: testWindowStart, StartTimeMax: testWindowEnd}","+\t\t\treflect.ValueOf(&request).Elem().Field(i).Set(distinctValue(t, field))","+","+\t\t\tquery, err := request.toReaderQuery()","+\t\t\trequire.NoError(t, err)","+\t\t\tgot := reflect.ValueOf(query).FieldByName(field.Name)","+\t\t\trequire.True(t, got.IsValid(), \"the reader's query has no field %s\", field.Name)","+\t\t\tassertCarried(t, field, reflect.ValueOf(request).Field(i), got)","+\t\t})","+\t}","+\tfor i := 0; i < readerType.NumField(); i++ {","+\t\tname := readerType.Field(i).Name","+\t\t_, ok := requestType.FieldByName(name)","+\t\tassert.True(t, ok, \"the reader's query field %s has no request field feeding it\", name)","+\t}","+}"],"additions":131,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/filter.go","lines":["@@ -36,7 +36,7 @@ var StructuredFiltersGate = featuregate.GlobalRegistry().MustRegister("," // ignored, because dropping a predicate would answer with every trace in the time range."," var ErrFilterDisabled = errors.New(\"the structured query filter is disabled\")"," ","-// queryToReaderShape returns the query in the shape the reader declared it can serve, immediately","+// queryToReaderCapabilities returns the query in the shape the reader declared it can serve, immediately"," // before dispatch."," //"," // A reader that cannot paginate has no field to read PageSize from, so PageSize is folded into","@@ -47,7 +47,7 @@ var ErrFilterDisabled = errors.New(\"the structured query filter is disabled\")"," // A reader that declares filter support gets the filter itself, once every level and operator"," // it uses is one the reader listed. A reader that declares none gets the filter rewritten into"," // the legacy predicate fields (ToLegacyShape), or a refusal where they cannot carry it.","-func queryToReaderShape(","+func queryToReaderCapabilities("," \tquery tracestore.TraceQueryParams,"," \tcaps tracestore.SearchCapabilities,"," ) (tracestore.TraceQueryParams, error) {"],"additions":2,"deletions":2,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/filter_test.go"