{"id":"d61955113f31bccfb102d5bfcaa7ba3dfc1115d9","axis":"silent","repo":"jaegertracing/jaeger","sha":"d61955113f31bccfb102d5bfcaa7ba3dfc1115d9","parsed":{"files":[{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/apiv3/grpc_handler.go","lines":["@@ -92,16 +92,14 @@ func traceQueryParams(query *api_v3.TraceQueryParameters) (querysvc.TraceQueryPa"," \t\treturn querysvc.TraceQueryParams{}, status.Error(codes.InvalidArgument, \"missing query\")"," \t}"," \tqueryParams := querysvc.TraceQueryParams{","-\t\tTraceQueryParams: tracestore.TraceQueryParams{","-\t\t\tServiceName:   query.GetServiceName(),","-\t\t\tOperationName: query.GetOperationName(),","-\t\t\tAttributes:    jptrace.PlainMapToPcommonMap(query.GetAttributes()),","-\t\t\tSearchDepth:   int(query.GetSearchDepth()),","-\t\t\tStartTimeMin:  query.GetStartTimeMin(),","-\t\t\tStartTimeMax:  query.GetStartTimeMax(),","-\t\t\tDurationMin:   query.GetDurationMin(),","-\t\t\tDurationMax:   query.GetDurationMax(),","-\t\t},","+\t\tServiceName:   query.GetServiceName(),","+\t\tOperationName: query.GetOperationName(),","+\t\tAttributes:    jptrace.PlainMapToPcommonMap(query.GetAttributes()),","+\t\tSearchDepth:   int(query.GetSearchDepth()),","+\t\tStartTimeMin:  query.GetStartTimeMin(),","+\t\tStartTimeMax:  query.GetStartTimeMax(),","+\t\tDurationMin:   query.GetDurationMin(),","+\t\tDurationMax:   query.GetDurationMax(),"," \t}"," \tif protoFilter := query.GetFilter(); protoFilter != nil {"," \t\tfilter, err := expressionproto.FromProto(protoFilter)","@@ -111,7 +109,7 @@ func traceQueryParams(query *api_v3.TraceQueryParameters) (querysvc.TraceQueryPa"," \t\tqueryParams.Filter = filter"," \t}"," \tif pagination := query.GetPagination(); pagination != nil {","-\t\tqueryParams.Pagination = &tracestore.Pagination{","+\t\tqueryParams.Pagination = &querysvc.Pagination{"," \t\t\tPageSize:  int(pagination.GetPageSize()),"," \t\t\tPageToken: pagination.GetPageToken(),"," \t\t}","@@ -152,10 +150,8 @@ func spanQueryPara