{"id":"ffe56634e71962411976a783019a227618d54d3c","axis":"silent","repo":"pnpm/pnpm","sha":"ffe56634e71962411976a783019a227618d54d3c","parsed":{"files":[{"path":".changeset/hoisted-filtered-install-missing-projects.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.deps-restorer\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+With `nodeLinker: hoisted`, `pnpm install --filter` in a sparse checkout now drops previously installed workspace projects that are missing from disk from the hoisted `node_modules` tree. It no longer recreates `node_modules` inside a missing project's directory. Packages that only the missing project used are also removed from the root `node_modules`."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_filters/warm_install.rs","lines":["@@ -281,6 +281,115 @@ fn filtered_install_succeeds_under_sparse_checkout_when_unselected_catalog_impor","     );"," }"," ","+#[test]","+fn filtered_hoisted_install_drops_projects_missing_from_disk() {","+    for frozen in [false, true] {","+        let fixture = WorkspaceFixture::new();","+        fixture.append_workspace_yaml(\"nodeLinker: hoisted\\n\");","+        let project_1 = fixture.project(","+            \"project-1\",","+            \"project-1\",","+            ManifestDeps { prod: &[(DEP, \"100.0.0\")], ..Default::default() },","+        );","+        fixture.project(","+            \"project-2\",","+            \"project-2\",","+            ManifestDeps { prod: &[(HELLO, \"1.0.0\")], ..Default::default() },","+        );","+        let project_3 = fixture.project(","+            \"project-3\",","+            \"project-3\",","+            ManifestDeps {","+                prod: &[","+                    (DEP, \"100.1.0\"),","+                    (PARENT, \"100.0.0\"),","+                    (\"local-pkg\", \"file:../../local-pkg\"),","+                    (\"project-2\", \"workspace:*\"),","+                ],","+                ..Default::default()","+            },","+        );","+        let local_pkg = fixture.workspace.join(\"local-pkg\");","+        fs::create_dir(&local_pkg).expect(\"create local-pkg\");","+        fs::write(","+            local_pkg.join(\"package.json\"),","+            serde_json::json!({","+                \"name\": \"local-pkg\",","+                \"version\": \"1.0.0\",","+                \"dependencies\": { NO_DEPS: \"1.0.0\" },","+            })","+            .to_string(),","+        )","+        .expect(\"write local-pkg/package.json\");","+","+        fixture.run([\"install\"]);","+        assert!(project_3.join(\"node_modules\").exists());","+        assert!(","+            fixture.workspace","+                .join(\"node_modules\")","+                .join(PARENT)","+                .is_dir(),","+        );","+        assert!(fixture.workspace.join(\"node_modules/local-pkg\").is_dir());","+        assert!(","+            fixture.workspace","+                .join(\"node_modules\")","+                .join(NO_DEPS)","+                .is_dir(),","+        );","+","+        fs::remove_dir_all(&project_3).expect(\"take project-3 off disk\");","+        if frozen {","+            fixture.run([","+                \"--filter\",","+                \"project-1\",","+                \"--filter\",","+                \"project-2\",","+                \"install\",","+                \"--frozen-lockfile\",","+            ]);","+        } else {","+            set_dependency(&project_1, \"dependencies\", CATALOG_FOO, \"1.0.0\");","+            fixture.run([\"--filter\", \"project-1\", \"--filter\", \"project-2\", \"install\"]);","+        }","+","+        assert!(","+            !project_3.exists(),","+            \"filtered hoisted install (frozen={frozen}) must not recreate missing project directory\",","+        );","+        for removed in [PARENT, \"local-pkg\", NO_DEPS] {","+            assert!(","+                !fixture.workspace","+                    .join(\"node_modules\")","+                    .join(removed)","+                    .exists(),","+                \"exclusive package {removed} of missing project must be pruned from root node_modules (frozen={frozen})\",","+            );","+        }","+        assert!(","+            fixture.workspace","+                .join(\"node_modules\")","+                .join(HELLO)","+                .is_dir(),","+            \"selected project dependency must remain hoisted (frozen={frozen})\",","+        );","+        let current = fixture.current();","+        assert!(","+            !current.importers.contains_key(\"packages/project-3\"),","+            \"current lockfile must drop missing importer (frozen={frozen})\",","+        );","+        assert!(!has_snapshot(&current, PARENT, \"100.0.0\"));","+        assert!(!has_snapshot(&current, NO_DEPS, \"1.0.0\"));","+        let wanted = fixture.wanted();","+        assert!(","+            wanted.importers.contains_key(\"packages/project-3\"),","+            \"wanted lockfile must preserve missing importer (frozen={frozen})\",","+        );","+        assert!(has_snapshot(&wanted, PARENT, \"100.0.0\"));","+        assert!(has_snapshot(&wanted, NO_DEPS, \"1.0.0\"));","+    }","+}","+"," #[test]"," fn filtered_repeat_install_re_resolves_when_transitive_injected_dependency_changes() {","     let fixture = WorkspaceFixture::new();"],"additions":109,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/multiple_importers.rs","lines":["@@ -198,9 +198,11 @@ fn filtered_install_resolves_against_projects_missing_from_disk() {"," /// and puts nothing in the directory of a project missing from disk."," #[test]"," fn filtered_install_links_nothing_into_projects_missing_from_disk() {","-    let full_checkout = filtered_install_after_bump(ProjectThree::OnDisk, InstallMode::Link);","-    let sparse_checkout = filtered_install_after_bump(ProjectThree::OffDisk, InstallMode::Link);","-    assert_eq!(sparse_checkout, full_checkou