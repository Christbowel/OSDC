ectRoot = '/projects/my-app';","+","+const writeProject = (dependencies?: Record<string, string>) =>","+  vol.fromJSON({","+    [`${projectRoot}/package.json`]: JSON.stringify({ name: 'template', dependencies }),","+    [`${projectRoot}/app.json`]: JSON.stringify({ expo: { name: 'template' } }),","+  });","+","+const readAppJson = () => JSON.parse(String(vol.readFileSync(`${projectRoot}/app.json`)));","+","+afterEach(() => {","+  vol.reset();","+  jest.clearAllMocks();","+});","+","+describe(assertSwiftPMSupportedAsync, () => {","+  it.each(['0.87.4', '^0.85.0', '~0.76.9', '>=0.80.0 <0.90.0'])(","+    'rejects React Native %s',","+    async (reactNative) => {","+      writeProject({ 'react-native': reactNative });","+","+      await expect(assertSwiftPMSupportedAsync(projectRoot, 'template')).rejects.toThrow(","+        SwiftPMUnsupportedError","+      );","+    }","+  );","+","+  it.each(['0.88.0', '^0.88.0-rc.3', '0.89.1', '0.0.0-20261001-abc', 'workspace:*', 'latest'])(","+    'allows React Native %s',","+    async (reactNative) => {","+      writeProject({ 'react-native': reactNative });","+","+      await expect(assertSwiftPMSupportedAsync(projectRoot, 'template')).resolves.toBeUndefined();","+    }","+  );","+","+  it('allows a project without a react-native dependency', async () => {","+    writeProject({ expo: '^57.0.0' });","+","+    await expect(assertSwiftPMSupportedAsync(projectRoot, 'template')).resolves.toBeUndefined();","+  });","+","+  it('allows a project without dependencies', async () => {","+    writeProject();","+","+    await expect(assertSwiftPMSupportedAsync(projectRoot, 'template')).resolves.toBeUndefined();","+  });","+","+  it('allows a project without a package.json', async () => {","+    vol.fromJSON({ [`${projectRoot}/app.json`]: '{}' });","+","+    await expect(assertSwiftPMSupportedAsync(projectRoot, 'template')).resolves.toBeUndefined();","+  });","+","+  describe('error message', () => {","+    const setCwd = (cwd: string) => jest.s