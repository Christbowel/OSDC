{"id":"1ce2e4b5867e3d4bffc4eacf988abc010cce9788","axis":"silent","repo":"pnpm/pnpm","sha":"1ce2e4b5867e3d4bffc4eacf988abc010cce9788","parsed":{"files":[{"path":".changeset/empty-dir-env-unset.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+pnpm now treats an empty `XDG_CONFIG_HOME`, `XDG_CACHE_HOME`, `XDG_DATA_HOME`, or `PNPM_HOME` as unset and uses the default directory. An empty value made pnpm read and write its global config, auth file, and cache in a `pnpm` directory under the current working directory."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/pnpr-empty-config-env-unset.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now treats an empty `XDG_CONFIG_HOME` or `LOCALAPPDATA` as unset when it looks for its global `config.yaml`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config-dir/src/lib.rs","lines":["@@ -14,7 +14,7 @@ use std::path::{"," /// `os` is a [`std::env::consts::OS`] string (`\"macos\"`, `\"windows\"`,"," /// `\"linux\"`, ...). `home` is a thunk so the (potentially I/O-bound)"," /// home-dir lookup is skipped whenever an env var short-circuits the","-/// resolution.","+/// resolution. An empty env value counts as unset."," pub fn config_dir(","     app_name: &str,","     os: &str,","@@ -22,11 +22,11 @@ pub fn config_dir(","     local_app_data: Option<&str>,","     home: impl FnOnce() -> Option<PathBuf>,"," ) -> Option<PathBuf> {","-    if let Some(xdg_config_home) = xdg_config_home {","+    if let Some(xdg_config_home) = xdg_config_home.filter(|value| !value.is_empty()) {","         return Some(Path::new(xdg_config_home).join(app_name));","     }","     if os == \"windows\"","-        && let Some(local_app_data) = local_app_data","+        && let Some(local_app_data) = local_app_data.filter(|value| !value.is_empty())","     {","         return Some(Path::new(local_app_data).join(app_name).join(\"config\"));","     }"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/config-dir/src/tests.rs","lines":["@@ -22,6 +22,12 @@ fn prefers_xdg_config_home_on_every_os_without_consulting_home() {","     }"," }"," ","+#[test]","+fn empty_env_values_count_as_unset() {","+    let dir = config_dir(\"pnpr\", \"windows\", Some(\"\"), Some(\"\"), home(r\"C:\\Users\\u\"));","+    assert_eq!(dir, Some(Path::new(r\"C:\\Users\\u\").join(\".config\").join(\"pnpr\")));","+}","+"," #[test]"," fn macos_uses_library_preferences() {","     let dir = config_dir(\"pnpr\", \"macos\", None, None, home(\"/Users/u\"));"],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/defaults.rs","lines":["@@ -179,9 +179,7 @@ pub fn default_config_dir<Sys>() -> Option<PathBuf>"," where","     Sys: EnvVar + GetHomeDir,"," {","-    if let Some(config_home) =","-        read_dir_env::<Sys>(\"PNPM_CONFIG_HOME\").filter(|value| !value.is_empty())","-    {","+    if let Some(config_home) = read_dir_env::<Sys>(\"PNPM_CONFIG_HOME\") {","         return Some(PathBuf::from(config_home));","     }","     let xdg_config_home = read_dir_env::<Sys>(\"XDG_CONFIG_HOME\");"],"additions":1,"deletions":3,"truncated":false},{"path":"pnpm/crates/config/src/defaults/tests.rs","lines":["@@ -590,3 +590,36 @@ fn empty_pnpm_config_home_falls_back_to_xdg() {","         Some(PathBuf::from(\"/other/config\").join(\"pnpm\")),","     );"," }","+","+#[test]","+#[cfg_attr(","+    not(any(target_os = \"macos\", target_os = \"linux\")),","+    ignore = \"asserts the macOS and Linux default directories\"","+)]","+fn empty_dir_env_vars_fall_back_to_platform_defaults() {","+    struct EmptyDirEnvs;","+    impl EnvVar for EmptyDirEnvs {","+        fn var(name: &str) -> Option<String> {","+            matches!(name, \"XDG_CONFIG_HOME\" | \"XDG_CACHE_HOME\" | \"XDG_DATA_HOME\" | \"PNPM_HOME\")","+                .then(String::new)","+        }","+    }","+    impl GetHomeDir for EmptyDirEnvs {","+        fn home_dir() -> Option<PathBuf> {","+            Some(PathBuf::from(\"/home/test-user\"))","+        }","+    }","+    let home = PathBuf::from(\"/home/test-user\");","+    let (config_dir, cache_dir, pnpm_home_dir) = if cfg!(target_os = \"macos\") {","+        (","+            home.join(\"Library/Preferences/pnpm\"),","+            home.join(\"Library/Caches/pnpm\"),","+            home.join(\"Library/pnpm\"),","+        )","+    } else {","+        (home.join(\".config/pnpm\"), home.join(\".cache/pnpm\"), home.join(\".local/share/pnpm\"))","+    };","+    assert_eq!(default_config_dir::<EmptyDirEnvs>(), Some(config_dir));","+    assert_eq!(default_cache_dir::<EmptyDirEnvs>(), cache_dir);","+    assert_eq!(default_pnpm_home_dir::<EmptyDirEnvs>(), Some(pnpm_home_dir));","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/windows_path_env.rs","lines":["@@ -61,8 +61,7 @@ pub(crate) fn ensure_windows_dir_envs_on<Sys: EnvVar>(","     if dirs_with_fallback","         .iter()","         .copied()","-        .map(Sys::var)","-        .any(|variable| variable.is_none())","+        .any(|name| dir_env_on::<Sys>(os, name).is_none())","     {","         expand_if_set::<Sys>(\"LOCALAPPDATA\")?;","     }","@@ -77,7 +76,7 @@ pub(crate) fn ensure_windows_home_dir_env_on<Sys: EnvVar>(","     }","     let name = [\"PNPM_HOME\", \"XDG_DATA_HOME\"]","         .into_iter()","-        .find(|name| Sys::var(name).is_some())","+        .find(|name| dir_env_on::<Sys>(os, name).is_some())","         .unwrap_or(\"LOCALAPPDATA\");","     expand_if_set::<Sys>(name)"," }","@@ -87,9 +86,16 @@ pub(crate) fn ensure_windows_home_dir_env_on<Sys: EnvVar>("," /// On failure the original value is returned. [`ensure_windows_dir_envs`]"," /// reports that failure before the path is used to create a directory."," pub(crate) fn read_dir_env<Sys: EnvVar>(name: &str) -> Option<String> {","-    let value = Sys::var(name)?;","+    dir_env_on::<Sys>(std::env::consts::OS, name)","+}","+","+/// [`read_dir_env`] for `os`. A value that is empty before or after","+/// expansion counts as unset.","+fn dir_env_on<Sys: EnvVar>(os: &str, name: &str) -> Option<String> {","+    let value = non_empty_var::<Sys>(name)?;","     // `ensure_windows_dir_envs` rejects an unexpanded reference before this path is used.","-    Some(expand_dir_env(std::env::consts::OS, name, &value, Sys::var).unwrap_or(value))","+    let expanded = expand_dir_env(os, name, &value, Sys::var).unwrap_or(value);","+    Some(expanded).filter(|expanded| !expanded.is_empty())"," }"," "," pub(crate) fn expand_dir_env(","@@ -106,12 +112,16 @@ pub(crate) fn expand_dir_env("," }"," "," fn expand_if_set<Sys: EnvVar>(name: &str) -> Result<(), UnexpandedWindowsEnvVar> {","-    let Some(value) = Sys::var(name) else {","+    let Some(value) = non_empty_var::<Sys>(name) else {","         return Ok(());","     };","     expand_dir_env(\"windows\", name, &value, Sys::var).map(|_| ())"," }"," ","+fn non_empty_var<Sys: EnvVar>(name: &str) -> Option<String> {","+    Sys::var(name).filter(|value| !value.is_empty())","+}","+"," const MAX_EXPANSIONS: usize = 32;"," /// The longest value Windows allows in an environment variable, in UTF-16"," /// code units. A self-referencing value such as `X=%X%%X%` never repeats, so"],"additions":16,"deletions":6,"truncated":false},{"path":"pnpm/crates/config/src/windows_path_env/tests.rs","lines":["@@ -212,3 +212,37 @@ fn empty_expanded_pnpm_config_home_validates_the_xdg_fallback() {","     let error = ensure_windows_dir_envs_on::<EmptyConfigHome>(\"windows\").unwrap_err();","     assert_eq!(error.variable, \"XDG_CONFIG_HOME\");"," }","+","+#[test]","+fn an_empty_pnpm_home_validates_the_data_home_fallback() {","+    struct EmptyPnpmHome;","+    impl EnvVar for EmptyPnpmHome {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"PNPM_HOME\" => Some(String::new()),","+                \"XDG_DATA_HOME\" => Some(r\"%MISSING%\\data\".to_owned()),","+                _ => None,","+            }","+        }","+    }","+    let error = ensure_windows_home_dir_env_on::<EmptyPnpmHome>(\"windows\").unwrap_err();","+    assert_eq!(error.variable, \"XDG_DATA_HOME\");","+}","+","+#[test]","+fn a_config_home_that_expands_to_empty_validates_the_local_app_data_fallback() {","+    struct EmptyExpandedConfigHome;","+    impl EnvVar for EmptyExpandedConfigHome {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"XDG_CONFIG_HOME\" => Some(\"%EMPTY%\".to_owned()),","+                \"EMPTY\" => Some(String::new()),","+                \"PNPM_HOME\" | \"XDG_CACHE_HOME\" | \"XDG_STATE_HOME\" => Some(r\"C:\\tools\".to_owned()),","+                \"LOCALAPPDATA\" => Some(r\"%MISSING%\\Local\".to_owned()),","+                _ => None,","+            }","+        }","+    }","+    let error = ensure_windows_dir_envs_on::<EmptyExpandedConfigHome>(\"windows\").unwrap_err();","+    assert_eq!(error.variable, \"LOCALAPPDATA\");","+}",""],"additions":34,"deletions":0,"truncated":false}],"additions":103,"deletions":12,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-23T19:31:20.797025+00:00"}