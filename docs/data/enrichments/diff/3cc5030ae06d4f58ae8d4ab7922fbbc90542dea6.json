{"id":"3cc5030ae06d4f58ae8d4ab7922fbbc90542dea6","axis":"silent","repo":"pnpm/pnpm","sha":"3cc5030ae06d4f58ae8d4ab7922fbbc90542dea6","parsed":{"files":[{"path":".changeset/agent-skills-local-deps.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` and `pnpm approve` now discover, link, and prune agent skills from `workspace:*`, `link:`, and local directory `file:` direct dependencies."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/permissions.rs","lines":["@@ -20,7 +20,7 @@ use clap::{Args, Subcommand};"," use miette::{Context, IntoDiagnostic, Report};"," use pnpm_config::{Config, PermissionCapability, SkillsPermission, is_ci};"," use pnpm_package_manager::{","-    allow_build_key_from_ignored_build, resync_installed_agent_skills, skill_approval_options,","+    resync_installed_agent_skills, skill_approval_key, skill_approval_options,"," };"," use pnpm_reporter::{Reporter, emit_global_warning};"," use pnpm_workspace_manifest_writer::set_skills_dirs;","@@ -89,7 +89,7 @@ pub(crate) fn pending_permissions(config: &Config) -> miette::Result<PendingPerm","         .flat_map(|modules| modules.pending_skills.iter().flatten());","     for dep_path in pending_skills {","         by_package","-            .entry(allow_build_key_from_ignored_build(dep_path.as_str()))","+            .entry(skill_approval_key(dep_path.as_str()))","             .or_default()","             .insert(PermissionCapability::Skills);","     }"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/permissions/decisions.rs","lines":["@@ -6,7 +6,7 @@ use indexmap::IndexSet;"," use miette::IntoDiagnostic;"," use pnpm_config::SkillsPermission;"," use pnpm_modules_yaml::{Host, write_modules_manifest};","-use pnpm_package_manager::allow_build_key_from_ignored_build;","+use pnpm_package_manager::{allow_build_key_from_ignored_build, skill_approval_key};"," use pnpm_reporter::Reporter;"," use pnpm_workspace_manifest_writer::{PermissionValue, set_permissions};"," use std::{","@@ -177,23 +177,35 @@ pub(super) fn decisions_by_approval(","         .collect()"," }"," ","+fn is_decided(decisions: &Decisions, dep_path: &str, capability: PermissionCapability) -> bool {","+    match capability {","+        PermissionCapability::Build => decisions","+            .get(&allow_build_key_from_ignored_build(dep_path))","+            .is_some_and(|decided| decided.build.is_some()),","+        PermissionCapability::Skills => {","+            decisions","+                .get(&skill_approval_key(dep_path))","+                .is_some_and(|decided| decided.skills.is_some())","+                || decisions","+                    .get(&allow_build_key_from_ignored_build(dep_path))","+                    .is_some_and(|decided| decided.skills.is_some())","+        }","+    }","+}","+"," /// Drop the decided entries from `.modules.yaml`'s pending build scripts"," /// and agent skills."," pub(super) fn clear_decided(scan: IgnoredBuildsScan, decisions: &Decisions) -> miette::Result<()> {","     let Some(mut modules) = scan.modules_manifest else { return Ok(()) };","-    let decided = |dep_path: &str, capability: PermissionCapability| {","-        decisions","-            .get(&allow_build_key_from_ignored_build(dep_path))","-            .is_some_and(|decided| match capability {","-                PermissionCapability::Build => decided.build.is_some(),","-                PermissionCapability::Skills => decided.skills.is_some(),","-            })","-    };","     if let Some(ignored) = modules.ignored_builds.as_mut() {","-        ignored.retain(|dep_path| !decided(dep_path.as_str(), PermissionCapability::Build));","+        ignored.retain(|dep_path| {","+            !is_decided(decisions, dep_path.as_str(), PermissionCapability::Build)","+        });","     }","     if let Some(pending) = modules.pending_skills.as_mut() {","-        pending.retain(|dep_path| !decided(dep_path.as_str(), PermissionCapability::Skills));","+        pending.retain(|dep_path| {","+            !is_decided(decisions, dep_path.as_str(), PermissionCapability::Skills)","+        });","     }","     if modules.ignored_builds.as_ref().is_some_and(IndexSet::is_empty) {","         modules.ignored_builds = None;"],"additions":23,"deletions":11,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/permissions/tests.rs","lines":["@@ -377,3 +377,49 @@ fn clear_decided_removes_decided_entries_from_modules_manifest() {","     assert!(updated.ignored_builds.is_none());","     assert!(updated.pending_skills.is_none());"," }","+","+#[test]","+fn pending_permissions_and_clear_decided_key_local_directory_skills_by_package_name() {","+    let dir = tempfile::tempdir().unwrap();","+    let config = config_awaiting(","+        &dir,","+        &[","+            \"@example/my-skills@link:packages/my-skills\",","+            \"@example/file-skills@file:../file-skills\",","+            \"tar-skills@file:./tar-skills.tgz\",","+        ],","+    );","+","+    let actual = super::pending_permissions(&config).unwrap();","+    assert_eq!(","+        actual.by_package,","+        pending(&[","+            (\"@example/file-skills\", &[Skills]),","+            (\"@example/my-skills\", &[Skills]),","+            (\"tar-skills@file:./tar-skills.tgz\", &[Skills]),","+        ]),","+    );","+","+    let mut decisions = BTreeMap::new();","+    decisions.insert(","+        \"@example/my-skills\".to_string(),","+        decided(None, Some(SkillsPermission::All(true))),","+    );","+    decisions.insert(","+        \"@example/file-skills\".to_string(),","+        decided(None, Some(SkillsPermission::All(false))),","+    );","+    super::decisions::clear_decided(actual.scan, &decisions).unwrap();","+","+    let updated = pnpm_modules_yaml::read_modules_manifest::<pnpm_modules_yaml::Host>(","+        &dir.path().join(\"node_modules\"),","+    )","+    .unwrap()","+    .unwrap();","+    assert_eq!(","+        updated.pending_skills,","+        Some(indexmap::IndexSet::from([pnpm_modules_yaml::DepPath::from(","+            \"tar-skills@file:./tar-skills.tgz\".to_string(),","+        )])),","+    );","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/agent_skills.rs","lines":["@@ -2,6 +2,8 @@"," //! approval on install, linked into the agent skill directories once"," //! `permissions` approves them, and pruned once it no longer does."," ","+mod local_deps;","+"," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"," use pnpm_testing_utils::bin::{AddMockedRegistry, CommandTempCwd};"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/agent_skills/local_deps.rs","lines":["@@ -0,0 +1,390 @@","+use super::{output_of, pending_skills, pnpm};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::CommandTempCwd;","+use std::{fs, path::Path};","+","+fn write_skill_package(dir: &Path, name: Option<&str>, skills: &[&str]) {","+    fs::create_dir_all(dir).expect(\"create skill package dir\");","+    if let Some(name) = name {","+        let manifest = serde_json::json!({ \"name\": name, \"version\": \"1.0.0\" });","+        fs::write(dir.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+    }","+    for skill in skills {","+        let skill_dir = dir.join(\"skills\").join(skill);","+        fs::create_dir_all(&skill_dir).expect(\"create skill dir\");","+        fs::write(skill_dir.join(\"SKILL.md\"), format!(\"---\\nname: {skill}\\n---\\n\"))","+            .expect(\"write SKILL.md\");","+    }","+}","+","+#[test]","+fn workspace_star_links_approves_and_prunes_skills_for_subproject_and_root() {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write pnpm-workspace.yaml\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"root\", \"private\": true }).to_string(),","+    )","+    .expect(\"write root package.json\");","+    write_skill_package(","+        &workspace.join(\"packages/my-skills\"),","+        Some(\"@example/my-skills\"),","+        &[\"demo-skill\"],","+    );","+    let app_dir = workspace.join(\"packages/app\");","+    fs::create_dir_all(&app_dir).expect(\"create packages/app\");","+    fs::write(","+        app_dir.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"@example/my-skills\": \"workspace:*\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write app package.json\");","+    fs::create_dir_all(workspace.join(\".agents/skills\")).expect(\"create .agents/skills\");","+","+    let output = output_of(pnpm(&workspace).with_arg(\"install\"));","+    assert!(output.contains(\"Agent skills awaiting approval: @example/my-skills.\"), \"{output}\");","+    assert_eq!(","+        pending_skills(&workspace),","+        Some(vec![\"@example/my-skills@link:packages/my-skills\".to_string()]),","+    );","+    assert!(!workspace.join(\".agents/skills/demo-skill\").exists());","+","+    pnpm(&workspace)","+        .with_args([\"approve\", \"@example/my-skills\"])","+        .assert()","+        .success();","+","+    assert!(workspace.join(\".agents/skills/demo-skill/SKILL.md\").is_file());","+    assert_eq!(pending_skills(&workspace), None);","+    assert_eq!(","+        fs::read_to_string(workspace.join(\".agents/skills/.gitignore\")).expect(\"read .gitignore\"),","+        \"# pnpm\\n/demo-skill\\n# pnpm end\\n\",","+    );","+","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let revoked = fs::read_to_string(&yaml_path)","+        .expect(\"read workspace yaml\")","+        .replace(\"skills: true\", \"skills: false\");","+    fs::write(&yaml_path, revoked).expect(\"write revoked workspace yaml\");","+","+    pnpm(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!workspace.join(\".agents/skills/demo-skill\").exists());","+    assert_eq!(pending_skills(&workspace), None);","+    drop(harness);","+}","+","+#[test]","+fn injected_workspace_dependency_links_and_prunes_skills() {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        concat!(","+            \"packages:\\n  - packages/*\\n\",","+            \"dedupeInjectedDeps: false\\n\",","+            \"permissions:\\n  '@example/my-skills':\\n    skills: true\\n\",","+        ),","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"root\", \"private\": true }).to_string(),","+    )","+    .expect(\"write root package.json\");","+    write_skill_package(","+        &workspace.join(\"packages/my-skills\"),","+        Some(\"@example/my-skills\"),","+        &[\"injected-skill\"],","+    );","+    let app_dir = workspace.join(\"packages/app\");","+    fs::create_dir_all(&app_dir).expect(\"create packages/app\");","+    fs::write(","+        app_dir.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"@example/my-skills\": \"workspace:*\" },","+            \"dependenciesMeta\": { \"@example/my-skills\": { \"injected\": true } },","+        })","+        .to_string(),","+    )","+    .expect(\"write app package.json\");","+    fs::create_dir_all(workspace.join(\".agents/skills\")).expect(\"create .agents/skills\");","+","+    pnpm(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(workspace.join(\".agents/skills/injected-skill/SKILL.md\").is_file());","+","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let revoked = fs::read_to_string(&yaml_path)","+        .expect(\"read workspace yaml\")","+        .replace(\"skills: true\", \"skills: false\");","+    fs::write(&yaml_path, revoked).expect(\"write revoked workspace yaml\");","+","+    pnpm(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!workspace.join(\".agents/skills/injected-skill\").exists());","+    drop(harness);","+}","+","+#[test]","+fn link_and_aliased_file_directory_dependencies_approve_link_and_prune() {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    let parent = workspace.parent().expect(\"workspace parent\");","+    let linked_ext = parent.join(\"linked-skills-only\");","+    let file_ext = parent.join(\"file-skills-pkg\");","+    write_skill_package(&linked_ext, None, &[\"shared-skill\"]);","+    write_skill_package(&file_ext, Some(\"@example/file-skills\"), &[\"shared-skill\"]);","+","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": {","+                \"@example/linked-skills\": \"link:../linked-skills-only\",","+                \"@app/custom-alias\": \"file:../file-skills-pkg\",","+            },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    fs::create_dir_all(workspace.join(\".agents/skills\")).expect(\"create .agents/skills\");","+","+    pnpm(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!workspace.join(\".agents/skills/shared-skill\").exists());","+","+    pnpm(&workspace)","+        .with_args([\"approve\", \"--all\"])","+        .assert()","+        .success();","+","+    assert!(","+        workspace","+            .join(\".agents/skills/pnpm-@example+linked-skills-shared-skill/SKILL.md\")","+            .is_file(),","+    );","+    assert!(","+        workspace.join(\".agents/skills/pnpm-@app+custom-alias-shared-skill/SKILL.md\").is_file(),","+    );","+","+    pnpm(&workspace)","+        .with_args([\"remove\", \"@example/linked-skills\"])","+        .assert()","+        .success();","+","+    assert!(!workspace.join(\".agents/skills/pnpm-@example+linked-skills-shared-skill\").exists());","+    assert!(workspace.join(\".agents/skills/shared-skill/SKILL.md\").is_file());","+    drop(harness);","+}","+","+#[test]","+fn workspace_skills_link_across_hoisted_gvs_and_per_project_lockfiles() {","+    for extra_yaml in [\"nodeLinker: hoisted\\n\", \"enableGlobalVirtualStore: true\\n\"] {","+        let harness = CommandTempCwd::init().add_mocked_registry();","+        let workspace = harness.workspace.clone();","+        fs::write(","+            workspace.join(\"pnpm-workspace.yaml\"),","+            format!(","+                \"packages:\\n  - packages/*\\n{extra_yaml}permissions:\\n  '@example/my-skills':\\n    skills: true\\n\",","+            ),","+        )","+        .expect(\"write pnpm-workspace.yaml\");","+        fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"root\",\"private\":true}\"#)","+            .expect(\"write root package.json\");","+        write_skill_package(","+            &workspace.join(\"packages/my-skills\"),","+            Some(\"@example/my-skills\"),","+            &[\"demo-skill\"],","+        );","+        let app_dir = workspace.join(\"packages/app\");","+        fs::create_dir_all(&app_dir).expect(\"create packages/app\");","+        fs::write(","+            app_dir.join(\"package.json\"),","+            r#\"{\"name\":\"app\",\"dependencies\":{\"@example/my-skills\":\"workspace:*\"}}\"#,","+        )","+        .expect(\"write app package.json\");","+        fs::create_dir_all(workspace.join(\".agents/skills\")).expect(\"create .agents/skills\");","+","+        pnpm(&workspace)","+            .with_arg(\"install\")","+            .assert()","+            .success();","+        assert!(","+            workspace.join(\".agents/skills/demo-skill/SKILL.md\").is_file(),","+            \"failed for config:\\n{extra_yaml}\",","+        );","+        drop(harness);","+    }","+","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nsharedWorkspaceLockfile: false\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"root\",\"private\":true}\"#)","+        .expect(\"write root package.json\");","+    write_skill_package(","+        &workspace.join(\"packages/my-skills\"),","+        Some(\"@example/my-skills\"),","+        &[\"demo-skill\"],","+    );","+    let app_dir = workspace.join(\"packages/app\");","+    fs::create_dir_all(app_dir.join(\".agents/skills\")).expect(\"create app .agents/skills\");","+    fs::write(","+        app_dir.join(\"package.json\"),","+        r#\"{\"name\":\"app\",\"dependencies\":{\"@example/my-skills\":\"workspace:*\"}}\"#,","+    )","+    .expect(\"write app package.json\");","+","+    pnpm(&app_dir)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!app_dir.join(\".agents/skills/demo-skill\").exists());","+","+    pnpm(&app_dir)","+        .with_args([\"approve\", \"@example/my-skills\"])","+        .assert()","+        .success();","+    assert!(app_dir.join(\".agents/skills/demo-skill/SKILL.md\").is_file());","+    drop(harness);","+}","+","+#[test]","+fn local_tarball_dependency_is_not_approved_by_bare_package_name() {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    let pkg_src = workspace","+        .parent()","+        .expect(\"workspace parent\")","+        .join(\"tarball-src\");","+    write_skill_package(&pkg_src, Some(\"@example/my-skills\"), &[\"tar-skill\"]);","+","+    pnpm(&pkg_src)","+        .with_args([\"pack\", \"--pack-destination\"])","+        .with_arg(&workspace)","+        .assert()","+        .success();","+","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"permissions:\\n  '@example/my-skills':\\n    skills: true\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\",","+            \"dependencies\": { \"@example/my-skills\": \"file:./example-my-skills-1.0.0.tgz\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    fs::create_dir_all(workspace.join(\".agents/skills\")).expect(\"create .agents/skills\");","+","+    pnpm(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!workspace.join(\".agents/skills/tar-skill\").exists());","+    assert_eq!(","+        pending_skills(&workspace),","+        Some(vec![\"@example/my-skills@file:example-my-skills-1.0.0.tgz\".to_string()]),","+    );","+    drop(harness);","+}","+","+#[test]","+fn scoped_dir_skill_named_skills_and_dot_prefixed_link_approve_and_prune_on_revoke() {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - 'packages/@example/*'\\n  - packages/*\\nskills:\\n  dirs:\\n    - .agents/skills\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"root\",\"private\":true}\"#)","+        .expect(\"write root package.json\");","+","+    write_skill_package(","+        &workspace.join(\"packages/@example/my-skills\"),","+        Some(\"my-skills\"),","+        &[\"skills\"],","+    );","+    write_skill_package(&workspace.join(\".dot-pkg\"), Some(\"dot-skills\"), &[\"dot-guide\"]);","+","+    let app_a = workspace.join(\"packages/app-a\");","+    let app_b = workspace.join(\"packages/app-b\");","+    fs::create_dir_all(&app_a).expect(\"create app-a\");","+    fs::create_dir_all(&app_b).expect(\"create app-b\");","+    fs::write(","+        app_a.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app-a\",","+            \"dependencies\": {","+                \"my-skills\": \"workspace:*\",","+                \"dot-skills\": \"link:../../.dot-pkg\",","+            },","+        })","+        .to_string(),","+    )","+    .expect(\"write app-a package.json\");","+    fs::write(","+        app_b.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app-b\",","+            \"dependencies\": { \"my-skills\": \"workspace:*\" },","+            \"dependenciesMeta\": { \"my-skills\": { \"injected\": true } },","+        })","+        .to_string(),","+    )","+    .expect(\"write app-b package.json\");","+    fs::create_dir_all(workspace.join(\".agents/skills\")).expect(\"create .agents/skills\");","+","+    pnpm(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    pnpm(&workspace)","+        .with_args([\"approve\", \"my-skills\", \"dot-skills\"])","+        .assert()","+        .success();","+","+    assert!(workspace.join(\".agents/skills/skills/SKILL.md\").is_file());","+    assert!(workspace.join(\".agents/skills/dot-guide/SKILL.md\").is_file());","+","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let revoked = fs::read_to_string(&yaml_path)","+        .expect(\"read workspace yaml\")","+        .replace(\"skills: true\", \"skills: false\");","+    fs::write(&y