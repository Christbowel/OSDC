{"id":"1033f774a866e36146e3c5da7d4d95fb59bc5d71","axis":"silent","repo":"vimeo/psalm","sha":"1033f774a866e36146e3c5da7d4d95fb59bc5d71","parsed":{"files":[{"path":"config.xsd","lines":["@@ -107,10 +107,24 @@","     <xs:complexType name=\"TaintAnalysisType\">","         <xs:choice maxOccurs=\"unbounded\">","             <xs:element name=\"ignoreFiles\" minOccurs=\"0\" maxOccurs=\"1\" type=\"IgnoreFilesType\" />","+            <xs:element name=\"taints\" minOccurs=\"0\" maxOccurs=\"1\" type=\"CustomTaintsType\" />","         </xs:choice>","         <xs:anyAttribute processContents=\"skip\" />","     </xs:complexType>"," ","+    <xs:complexType name=\"CustomTaintsType\">","+        <xs:sequence>","+            <xs:element name=\"taint\" minOccurs=\"0\" maxOccurs=\"unbounded\" type=\"CustomTaintType\" />","+        </xs:sequence>","+    </xs:complexType>","+","+    <xs:complexType name=\"CustomTaintType\">","+        <xs:sequence>","+            <xs:element name=\"alias\" minOccurs=\"0\" maxOccurs=\"unbounded\" type=\"NameAttributeType\" />","+        </xs:sequence>","+        <xs:attribute name=\"name\" type=\"xs:string\" use=\"required\" />","+    </xs:complexType>","+","     <xs:complexType name=\"NameAttributeType\">","         <xs:attribute name=\"name\" type=\"xs:string\" use=\"required\" />","         <xs:anyAttribute processContents=\"skip\" />"],"additions":14,"deletions":0,"truncated":false},{"path":"docs/running_psalm/configuration.md","lines":["@@ -766,6 +766,25 @@ Optional. Allows you to specify a list of constants that should emit the [`Forbi"," </forbiddenConstants>"," ```"," ","+#### &lt;taintAnalysis&gt;","+Optional. Settings of the [security analysis](../security_analysis/index.md):","+- `<ignoreFiles>`: the files and directories whose taint paths are not reported (see","+  [Avoiding files in taint paths](../security_analysis/avoiding_false_positives.md#avoiding-files-in-taint-paths)).","+- `<taints>`: custom taints, which the annotations can then name without a plugin registering them. Each can be added","+  to aliases of built-in taints (`input`, `tainted`, `input_except_sleep`) with `<alias>` (see","+  [Custom taints declared in the configuration](../security_analysis/custom_taint_sources.md#custom-taints-declared-in-the-configuration)).","+","+```xml","+<taintAnalysis>","+  <taints>","+    <taint name=\"nosql_json\">","+      <alias name=\"input\" />","+    </taint>","+    <taint name=\"session_id\" />","+  </taints>","+</taintAnalysis>","+```","+"," ## Accessing Psalm configuration in plugins"," "," Plugins can access or modify the global configuration in plugins using"],"additions":19,"deletions":0,"truncated":false},{"path":"docs/security_analysis/custom_taint_sources.md","lines":["@@ -16,6 +16,31 @@ In the below example the `input` taint type is specified as a standin for input"," function getQueryParam(string $name) : string {}"," ```"," ","+## Custom taints declared in the configuration","+","+Custom taints can be declared in `psalm.xml`, so that the annotations can name them without a plugin registering","+them:","+","+```xml","+<taintAnalysis>","+  <taints>","+    <taint name=\"nosql_json\">","+      <alias name=\"input\" />","+    </taint>","+    <taint name=\"session_id\" />","+  </taints>","+</taintAnalysis>","+```","+","+A taint added to the alias `input` with `<alias name=\"input\" />` is a kind of user input like the built-in ones:","+`@psalm-taint-source input`, `$_GET` and the other built-in sources of user input give it, `@psalm-taint-sink input`","+and `@psalm-taint-escape input` name it, and what removes every other kind of user input removes it too (a value of a","+type that can't hold user input, such as a literal string or a number). `tainted` and `input_except_sleep` can be","+named the same way. A taint without an alias, like `session_id` above, only comes from the annotations naming it","+(`@psalm-taint-source session_id`), and only reaches the sinks naming it.","+","+A taint's name is a word (letters, digits, `_` and `-`) other than those of the built-in taints.","+"," ## Custom taint plugin"," "," For example this plugin treats all variables named `$bad_data` as taint sources."],"additions":25,"deletions":0,"truncated":false},{"path":"src/Psalm/Codebase.php","lines":["@@ -652,6 +652,35 @@ private function reportTaintRegistrationError(string $err, ?CodeLocation $locati","         throw new RuntimeException($err);","     }"," ","+    /**","+     * Registers the custom taints psalm.xml declares (`<taintAnalysis><taints>`), and adds each to the aliases of","+     * built-in taints it names. Called before scanning, once the taints of a previous run are restored (see","+     * importCustomTaints()).","+     *","+     * @internal","+     * @psalm-capabilities read-props|write-this-props|write-props|write-refs","+     */","+    public function registerConfigTaints(): void","+    {","+        foreach ($this->config->custom_taints as $taint_type => $aliases) {","+            $taint = $this->getOrRegisterTaint($taint_type);","+","+            foreach ($aliases as $alias) {","+                $this->taint_map[$alias] = ($this->taint_map[$alias] ?? 0) | $taint;","+            }","+        }","+    }","+","+    /**","+     * The taints of user input, those of `input`: the built-in kinds, and the custom taints psalm.xml adds to it","+     *","+     * @psalm-mutation-free","+     */","+    public function getInputTaints(): int","+    {","+        return $this->taint_map['input'] ?? TaintKind::ALL_INPUT;","+    }","+","     /**","      * Register an alias taint name based on one or more pre-existing taints.","      *"],"additions":29,"deletions":0,"truncated":false},{"path":"src/Psalm/Config.php","lines":["@@ -49,6 +49,7 @@"," use Psalm\\Plugin\\PluginInterface;"," use Psalm\\Progress\\Progress;"," use Psalm\\Progress\\VoidProgress;","+use Psalm\\Type\\TaintKind;"," use RuntimeException;"," use SimpleXMLElement;"," use Symfony\\Component\\Filesystem\\Path;","@@ -58,6 +59,7 @@"," use stdClass;"," "," use function array_key_exists;","+use function array_keys;"," use function array_merge;"," use function array_pad;"," use function array_pop;","@@ -477,6 +479,13 @@ final class Config"," ","     private ?TaintAnalysisFileFilter $taint_analysis_ignored_files = null;"," ","+    /**","+     * The custom taints declared in `<taintAnalysis><taints>` => the aliases of built-in taints each is added to","+     *","+     * @var array<string, list<string>>","+     */","+    public array $custom_taints = [];","+","     /**","      * @var bool whether to emit a backtrace of emitted issues to stderr","      */","@@ -1320,6 +1329,10 @@ private static function fromXmlAndPaths(","             );","         }"," ","+        if (isset($config_xml->taintAnalysis->taints->taint)) {","+            $config->loadCustomTaints($config_xml->taintAnalysis->taints->taint);","+        }","+","         if (isset($config_xml->fileExtensions->extension)) {","             $config->file_extensions = [];"," ","@@ -1545,6 +1558,52 @@ public function safeSetCustomErrorLevel(string $issue_key, string $error_level):","         }","     }"," ","+    /**","+     * @throws ConfigException if a taint's name isn't one, is a built-in taint's or is declared twice, or if an alias","+     *  isn't one of those of the built-in taints","+     */","+    private function loadCustomTaints(SimpleXMLElement $taints): void","+    {","+        // the aliases of built-in taints: the names of more than one kind","+        $aliases = [];","+        foreach (TaintKind::TAINT_NAMES as $name => $kinds) {","+            if (($kinds & ($kinds - 1)) !== 0) {","+                $aliases[$name] = true;","+            }","+        }","+","+        /** @var SimpleXMLElement $taint */","+        foreach ($taints as $taint) {","+            $name = (string) $taint['name'];","+            // a word, like the taints of the annotations, which can't start like a conditional taint or a complement","+            if (preg_match('/^[A-Za-z_][\\w-]*$/', $name) !== 1) {","+                throw new ConfigException('Invalid custom taint name \"' . $name . '\"');","+            }","+","+            if (isset(TaintKind::TAINT_NAMES[$name])) {","+                throw new ConfigException('The custom taint \"' . $name . '\" has the name of a built-in taint');","+            }","+","+            if (isset($this->custom_taints[$name])) {","+                throw new ConfigException('The custom taint \"' . $name . '\" is declared twice');","+            }","+","+            $this->custom_taints[$name] = [];","+            /** @var SimpleXMLElement $alias */","+            foreach ($taint->alias as $alias) {","+                $alias_name = (string) $alias['name'];","+                if (!isset($aliases[$alias_name])) {","+                    throw new ConfigException(","+                        'The custom taint \"' . $name . '\" can only be added to an alias of built-in taints ('","+                        . implode(', ', array_keys($aliases)) . '), not to \"' . $alias_name . '\"',","+                    );","+                }","+","+                $this->custom_taints[$name][] = $alias_name;","+            }","+        }","+    }","+","     /**","      * @throws ConfigException if a Config file could not be found","      */"],"additions":59,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/ProjectAnalyzer.php","lines":["@@ -243,6 +243,8 @@ public function __construct(","             }","         }"," ","+        $this->codebase->registerConfigTaints();","+","         $this->config->processPluginFileExtensions($this);"," ","         if ($this->config::INIT_PROJECT_FILES_NOW) {","@@ -543,7 +545,7 @@ public function consolidateAnalyzedData(): void"," ","     public function trackTaintedInputs(): void","     {","-        $this->codebase->taint_flow_graph = new TaintFlowGraph();","+        $this->codebase->taint_flow_graph = new TaintFlowGraph($this->codebase->getInputTaints());","     }"," ","     public function trackUnusedSuppressions(): void"],"additions":3,"deletions":1,"truncated":false},{"path":"src/Psalm/Internal/Codebase/TaintFlowGraph.php","lines":["@@ -120,6 +120,13 @@ final class TaintFlowGraph extends DataFlowGraph","      */","     private const GENERATOR_SEND_CALL_DEPTH = 8;"," ","+    /**","+     * The built-in kinds of user input every value able to hold user input can hold: those not tied to a type (see","+     * Union::getTaintsToRemove()). What has them all has the custom taints psalm.xml adds to `input` too.","+     */","+    private const GENERIC_INPUT = TaintKind::ALL_INPUT","+        & ~(TaintKind::NUMERIC_ONLY | TaintKind::BOOL_ONLY | TaintKind::ARRAY_ONLY);","+","     /** @var array<string, DataFlowNode> */","     private array $sources = [];"," ","@@ -248,6 +255,20 @@ final class TaintFlowGraph extends DataFlowGraph","      */","     private array $despecialized_calls = [];"," ","+    /**","+     * The custom taints psalm.xml adds to `input`: the built-in sources of user input give them, and what removes","+     * every other kind of user input removes them (see withCustomInputTaints())","+     */","+    private readonly int $custom_input_taints;","+","+    /**","+     * @param int $input_taints the taints of user input (see Codebase::getInputTaints())","+     */","+    public function __construct(int $input_taints = TaintKind::ALL_INPUT)","+    {","+        $this->custom_input_taints = $input_taints & ~TaintKind::ALL_INPUT;","+    }","+","     /**","      * Whether the taint nodes of a call to $storage at $call_location are specialized to the call site,","      * so that taint flowing into one call does not flow out of the other calls.","@@ -472,7 +493,24 @@ public function addPath(","             return;","         }"," ","-        parent::addPath($from, $to, $path_type, $added_taints, $removed_taints);","+        parent::addPath(","+            $from,","+            $to,","+            $path_type,","+            $this->withCustomInputTaints($added_taints),","+            $this->withCustomInputTaints($removed_taints),","+        );","+    }","+","+    /**","+     * $taints with the custom taints psalm.xml adds to `input`, when they are every kind of user input not tied to a","+     * type (see GENERIC_INPUT)","+     *","+     * @psalm-mutation-free","+     */","+    private function withCustomInputTaints(int $taints): int","+    {","+        return ($taints & self::GENERIC_INPUT) === self::GENERIC_INPUT ? $taints | $this->custom_input_taints : $taints;","     }"," ","     /**","@@ -506,7 +544,7 @@ public function addGeneratorSend(DataFlowNode $sent_node, array $generator_nodes","      */","     public function addSource(DataFlowNode $node): void","     {","-        $this->sources[$node->id] = $node;","+        $this->sources[$node->id] = $node->setTaints($this->withCustomInputTaints($node->taints));","     }"," ","     /**","@@ -514,6 +552,7 @@ public function addSource(DataFlowNode $node): void","      */","     public function addSink(DataFlowNode $node): void","     {","+        $node = $node->setTaints($this->withCustomInputTaints($node->taints));","         $this->sinks[$node->id] = $node;","         // in the rare case the sink is the _next_ node, this is necessary","         $this->nodes[$node->id] = $node;"],"additions":41,"deletions":2,"truncated":false},{"path":"src/Psalm/Internal/Fork/InitAnalyzerTask.php","lines":["@@ -26,7 +26,7 @@ public function run(Channel $channel, Cancellation $cancellation): mixed","         $file_reference_provider = $codebase->file_reference_provider;"," ","         if ($codebase->taint_flow_graph) {","-            $codebase->taint_flow_graph = new TaintFlowGraph();","+            $codebase->taint_flow_graph = new TaintFlowGraph($codebase->getInputTaints());","         }"," ","         // workers only report the references they found themselves"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/Config/ConfigTest.php","lines":["@@ -1364,6 +1364,152 @@ public function tearDown(): void","         }","     }"," ","+    /**","+     * @return array<string, array{0: string, 1: string|null}>","+     * @psalm-pure","+     */","+    public function providerCustomTaintsOfTheConfig(): array","+    {","+        $functions = '<?php","+            /** @psalm-taint-sink nosql_json $query */","+            function find(string $query): void {}","+","+            /** @psalm-taint-sink session_id $id */","+            function resume(string $id): void {}","+","+            /** @psalm-taint-source input */","+            function read(): string {","+                return \"\";","+            }","+","+            /** @psalm-taint-source session_id */","+            function cookie(): string {","+                return \"\";","+            }","+","+            /** @psalm-taint-escape html */","+            function escapeHtml(string $text): string {","+                return $text;","+            }","+","+            /** @psalm-taint-escape input */","+            function validate(string $text): string {","+                return $text;","+            }","+            ';","+","+        return [","+            'a taint added to input comes from the user input' => [","+                $functions . 'find((string) $_GET[\"q\"]);',","+                'TaintedCustom',","+            ],","+            'a taint added to input comes from the sources of input' => [","+                $functions . 'find(read());',","+                'TaintedCustom',","+            ],","+            'a number holds no taint added to input' => [","+                $functions . 'find((string) (int) $_GET[\"q\"]);',","+                null,","+            ],","+            'escaping another kind keeps a taint added to input' => [","+                $functions . 'find(escapeHtml((string) $_GET[\"q\"]));',","+                'TaintedCustom',","+            ],","+            'escaping input escapes a taint added to it' => [","+                $functions . 'find(validate((string) $_GET[\"q\"]));',","+                null,","+            ],","+            'a taint without alias comes from where it is named' => [","+                $functions . 'resume(cookie());',","+                'TaintedCustom',","+            ],","+            'a taint without alias does not come from the user input' => [","+                $functions . 'resume((string) $_GET[\"q\"]);',","+                null,","+            ],","+            'a taint without alias reaches only the sinks naming it' => [","+                $functions . 'echo cookie();',","+                null,","+            ],","+        ];","+    }","+","+    /**","+     * @dataProvider providerCustomTaintsOfTheConfig","+     */","+    public function testCustomTaintsOfTheConfig(string $code, ?string $error): void","+    {","+        $this->project_analyzer = $this->getProjectAnalyzerWithConfig(","+            TestConfig::loadFromXML(","+                dirname(__DIR__, 2),","+                '<?xml version=\"1.0\"?>","+                <psalm>","+                    <projectFiles>","+                        <directory name=\"src\" />","+                    </projectFiles>","+                    <taintAnalysis>","+                        <taints>","+                            <taint name=\"nosql_json\">","+                                <alias name=\"input\" />","+                            </taint>","+                            <taint name=\"session_id\" />","+                        </taints>","+                    </taintAnalysis>","+                </psalm>',","+            ),","+        );","+        $this->project_analyzer->trackTaintedInputs();","+","+        $file_path = (string) getcwd() . '/src/somefile.php';","+        $this->addFile($file_path, $code);","+","+        if ($error !== null) {","+            $this->expectException(CodeException::class);","+            $this->expectExceptionMessageMatches('/\\b' . $error . '\\b/');","+        }","+","+        $this->analyzeFile($file_path, new Context());","+    }","+","+    /**","+     * @return array<string, array{0: string, 1: string}>","+     * @psalm-pure","+     */","+    public function providerInvalidCustomTaintsOfTheConfig(): array","+    {","+        return [","+            'the name of a built-in taint' => ['<taint name=\"html\" />', 'has the name of a built-in taint'],","+            'not a word' => ['<taint name=\"~html\" />', 'Invalid custom taint name'],","+            'declared twice' => ['<taint name=\"a\" /><taint name=\"a\" />', 'is declared twice'],","+            'added to a built-in kind' => [","+                '<taint name=\"a\"><alias name=\"html\" /></taint>',","+                'can only be added to an alias of built-in taints',","+            ],","+        ];","+    }","+","+    /**","+     * @dataProvider providerInvalidCustomTaintsOfTheConfig","+     */","+    public function testInvalidCustomTaintsOfTheConfig(string $taints, string $error): void","+    {","+        $this->expectException(ConfigException::class);","+        $this->expectExceptionMessage($error);","+","+        Config::loadFromXML(","+            dirname(__DIR__, 2),","+            '<?xml version=\"1.0\"?>","+            <psalm>","+                <projectFiles>","+                    <directory name=\"src\" />","+                </projectFiles>","+                <taintAnalysis>","+                    <taints>' . $taints . '</taints>","+                </taintAnalysis>","+            </psalm>',","+        );","+    }","+","     public function testGlobals(): void","     {","         $this->project_analyzer = $this->getProjectAnalyzerWithConfig(",""],"additions":146,"deletions":0,"truncated":false}],"additions":337,"deletions":4,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-12T18:19:24.484643+00:00"}