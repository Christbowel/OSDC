warding\", remoteAddr: \"192.0.2.10:1234\", forwardedFor: \"127.0.0.1\", wantLocal: false},","+\t\t{name: \"local proxy for local client\", remoteAddr: \"127.0.0.1:1234\", forwardedFor: \"127.0.0.1\", wantLocal: true},","+\t\t{name: \"local proxy for remote client\", remoteAddr: \"127.0.0.1:1234\", forwardedFor: \"192.0.2.10\", wantLocal: false},","+\t\t{name: \"local proxy with spoofed chain\", remoteAddr: \"127.0.0.1:1234\", forwardedFor: \"127.0.0.1, 192.0.2.10\", wantLocal: false},","+\t}","+","+\tfor _, test := range tests {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\tengine := gin.New()","+\t\t\tif err := engine.SetTrustedProxies([]string{\"127.0.0.1\", \"::1\"}); err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t\tengine.RemoteIPHeaders = []string{\"X-Forwarded-For\"}","+\t\t\tengine.GET(\"/\", func(c *gin.Context) {","+\t\t\t\tif IsLocalRequest(c) {","+\t\t\t\t\tc.Status(http.StatusNoContent)","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tc.Status(http.StatusUnauthorized)","+\t\t\t})","+","+\t\t\trequest := httptest.NewRequest(http.MethodGet, \"/\", nil)","+\t\t\trequest.RemoteAddr = test.remoteAddr","+\t\t\tif test.forwardedFor != \"\" {","+\t\t\t\trequest.Header.Set(\"X-Forwarded-For\", test.forwardedFor)","+\t\t\t}","+\t\t\trecorder := httptest.NewRecorder()","+\t\t\tengine.ServeHTTP(recorder, request)","+","+\t\t\twantStatus := http.StatusUnauthorized","+\t\t\tif test.wantLocal {","+\t\t\t\twantStatus = http.StatusNoContent","+\t\t\t}","+\t\t\tif recorder.Code != wantStatus {","+\t\t\t\tt.Fatalf(\"status = %d, want %d\", recorder.Code, wantStatus)","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":74,"deletions":0,"truncated":false},{"path":"kernel/server/proxy/fixedport.go","lines":["@@ -22,6 +22,7 @@ import ("," \t\"net\""," \t\"net/http\""," \t\"net/http/httputil\"","+\t\"net/url\""," "," \t\"github.com/siyuan-note/logging\""," \t\"github.com/siyuan-note/siyuan/kernel/util\"","@@ -37,10 +38,7 @@ func InitFixedPortService(host string, certPath, keyPath string) {"," \t\taddr := host + \":\" + util.FixedPort"," "," \t\t// 启动一个固定 6806 端口的反向代理服务器，这样浏览器扩展才能直接使用 127.0.0.1:6806，不用配置端口","-\t\tproxy := httputil.NewSingleHostReverseProxy(util.ServerURL)","-\t\tproxy.Transport = &http.Transport{","-\t\t\tTLSClientConfig: &tls.Config{InsecureSkipVerify: true},","-\t\t}","+\t\tproxy := newFixedPortReverseProxy(util.ServerURL)"," "," \t\tif \"\" != certPath {"," \t\t\tlogging.LogInfof(\"fixed port service [%s] is running (HTTP/HTTPS dual mode)\", addr)","@@ -65,3 +63,16 @@ func InitFixedPortService(host string, certPath, keyPath string) {"," \t\tlogging.LogInfof(\"fixed port service [%s] is stopped\", addr)"," \t}"," }","+","+func newFixedPortReverseProxy(target *url.URL) *httputil.ReverseProxy {","+\treturn &httputil.ReverseProxy{","+\t\tRewrite: func(request *httputil.ProxyRequest) {","+\t\t\trequest.SetURL(target)","+\t\t\trequest.Out.Host = request.In.Host","+\t\t\trequest.SetXForwarded()","+\t\t},","+\t\tTransport: &http.Transport{","+\t\t\tTLSClientConfig: &tls.Config{InsecureSkipVerify: true},","+\t\t},","+\t}","+}"],"additions":15,"deletions":4,"truncated":false},{"path":"kernel/server/proxy/fixedport_test.go","lines":["@@ -0,0 +1,85 @@","+// SiYuan - Refactor your thinking","+// Copyright (c) 2020-present, b3log.org","+//","+// This program is free software: you can redistribute it and/or modify","+// it under the terms of the GNU Affero General Public License as published by","+// the Free Software Foundation, either version 3 of the License, or","+// (at your option) any later version.","+//","+// This program is distributed in the hope that it will be useful,","+// but WITHOUT ANY WARRANTY; without even the implied warranty of","+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the","+// GNU Affero General Public License for more details.","+//","+// You should have received a copy of the GNU Affero General Public License","+// along with this program.  If not, see <https://www.gnu.org/licenses/>.","+","+package proxy","+","+import (","+\t\"net\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"testing\"","+)","+","+func TestFixedPortReverseProxyRebuildsForwardedHeaders(t *testing.T) {","+\trequestInfo := make(chan http.Header, 1)","+\thostInfo := make(chan string, 1)","+\tbackend := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {","+\t\trequestInfo <- request.Header.Clone()","+\t\thostInfo <- request.Host","+\t\twriter.WriteHeader(http.StatusNoContent)","+\t}))","+\tdefer backend.Close()","+","+\tproxy := httptest.NewServer(newFixedPortReverseProxy(mustParseURL(t, backend.URL)))","+\tdefer proxy.Close()","+","+\trequest, err := http.NewRequest(http.MethodGet, proxy.URL+\"/api/system/getWorkspaceInfo\", nil)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\trequest.Host = \"192.0.2.1:6806\"","+\trequest.Header.Set(\"Forwarded\", \"for=127.0.0.1\")","+\trequest.Header.Set(\"X-Forwarded-For\", \"127.0.0.1\")","+\trequest.Header.Set(\"X-Forwarded-Host\", \"127.0.0.1:6806\")","+\trequest.Header.Set(\"X-Forwarded-Proto\", \"https\")","+","+\tresponse, err := http.DefaultClient.Do(request)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tresponse.Body.Close()","+\tif response.StatusCode != http.StatusNoContent {","+\t\tt.Fatalf(\"proxy returned %d, want %d\", response.StatusCode, http.StatusNoContent)","+\t}","+","+\theaders := <-requestInfo","+\tforwardedFor := headers.Get(\"X-Forwarded-For\")","+\tif ip := net.ParseIP(forwardedFor); ip == nil || !ip.IsLoopback() {","+\t\tt.Fatalf(\"X-Forwarded-For = %q, want proxy client loopback address\", forwardedFor)","+\t}","+\tif actual := headers.Get(\"X-Forwarded-Host\"); actual != request.Host {","+\t\tt.Fatalf(\"X-Forwarded-Host = %q, want %q\", actual, request.Host)","+\t}","+\tif actual := headers.Get(\"X-Forwarded-Proto\"); actual != \"http\" {","+\t\tt.Fatalf(\"X-Forwarded-Proto = %q, want http\", actual)","+\t}","+\tif actual := headers.Get(\"Forwarded\"); actual != \"\" {","+\t\tt.Fatalf(\"Forwarded = %q, want empty\", actual)","+\t}","+\tif actual := <-hostInfo; actual != request.Host {","+\t\tt.Fatalf(\"Host = %q, want %q\", actual, request.Host)","+\t}","+}","+","+func mustParseURL(t *testing.T, rawURL string) *url.URL {","+\tt.Helper()","+\tparsed, err := url.Parse(rawURL)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\treturn parsed","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"kernel/server/serve.go","lines":["@@ -138,6 +138,11 @@ var ("," func Serve(fastMode bool, cookieKey string) {"," \tgin.SetMode(gin.ReleaseMode)"," \tginServer := gin.New()","+\tif err := ginServer.SetTrustedProxies([]string{\"127.0.0.1\", \"::1\"}); err != nil {","+\t\tlogging.LogFatalf(logging.ExitCodeSecurityRisk, \"set trusted proxies failed: %s\", err)","+\t}","+\tginServer.ForwardedByClientIP = true","+\tginServer.RemoteIPHeaders = []string{\"X-Forwarded-For\"}"," \tginServer.MaxMultipartMemory = 1024 * 1024 * 32 // 插入较大的资源文件时内存占用较大 https://github.com/siyuan-note/siyuan/issues/5023"," \tginServer.Use("," \t\tmodel.ControlConcurrency, // 请求串行化 Concurrency control when requesting the kernel API https://github.com/siyuan-note/siyuan/issues/9939",""],"additions":5,"deletions":0,"truncated":false}],"additions":209,"deletions":6,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-09-04T12:52:31.075594+00:00"}