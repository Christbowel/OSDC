VWXYZ0123456789'","+    expect(generateRandomString(16, charset)).not.toBe(generateRandomString(16, charset))","+  })","+})","+","+describe('generateRandomBase64', () => {","+  it('returns base64 that decodes to the requested number of bytes', () => {","+    const result = generateRandomBase64(60)","+    expect(result).toMatch(/^[A-Za-z0-9+/]+={0,2}$/)","+    expect(atob(result)).toHaveLength(60)","+  })","+})"],"additions":42,"deletions":0,"truncated":false},{"path":"apps/studio/lib/random.ts","lines":["@@ -0,0 +1,15 @@","+const randomByte = () => crypto.getRandomValues(new Uint8Array(1))[0]","+","+/** Uniform random integer in [0, max) for max <= 256, using rejection sampling to avoid modulo bias. */","+const randomIndex = (max: number) => {","+  const limit = 256 - (256 % max)","+  let value = randomByte()","+  while (value >= limit) value = randomByte()","+  return value % max","+}","+","+export const generateRandomString = (length: number, charset: string) =>","+  Array.from({ length }, () => charset[randomIndex(charset.length)]).join('')","+","+export const generateRandomBase64 = (byteLength: number) =>","+  btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(byteLength))))"],"additions":15,"deletions":0,"truncated":false},{"path":"apps/studio/package.json","lines":["@@ -114,7 +114,6 @@","     \"effect\": \"4.0.0-rc.112\",","     \"file-saver\": \"^2.0.5\",","     \"fuse.js\": \"^7.4.0\",","-    \"generate-password-browser\": \"^1.1.0\",","     \"gqlmin\": \"^0.3.1\",","     \"graphiql\": \"^5.2.2\",","     \"html-to-image\": \"^1.11.13\",","@@ -140,7 +139,6 @@","     \"openapi-typescript-helpers\": \"0.0.14\",","     \"papaparse\": \"^5.3.1\",","     \"radix-ui\": \"catalog:\",","-    \"randombytes\": \"^2.1.0\",","     \"react\": \"catalog:\",","     \"react-data-grid\": \"7.0.0-beta.47\",","     \"react-day-picker\": \"^9.11.1\",","@@ -196,7 +194,6 @@","     \"@types/mime-db\": \"^1.43.5\",","     \"@types/node\": \"catalog:\",","     \"@types