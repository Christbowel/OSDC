g_service.utils import _get_store"],"additions":70,"deletions":7,"truncated":false},{"path":"mlflow/assistant/providers/openai_compatible.py","lines":["@@ -321,6 +321,13 @@ def _auth_headers(self, api_key: str | None) -> dict[str, str]:","             return {\"Authorization\": f\"Bearer {api_key}\"}","         return {}"," ","+    def _request_kwargs(self, chat_url: str) -> dict[str, Any]:","+        \"\"\"Extra keyword arguments for the chat-completions request to ``chat_url``.","+","+        Raise ``ProviderNotConfiguredError`` to end the turn with that message instead.","+        \"\"\"","+        return {}","+","     def check_connection(self, echo: Callable[[str], None] | None = None) -> None:","         if self._list_models_fn is None:","             # Presets without a backend listing strategy (e.g. the in-server","@@ -466,6 +473,11 @@ async def astream(","         tools = build_tools_schema()"," ","         headers = self._auth_headers(api_key)","+        try:","+            request_kwargs = self._request_kwargs(chat_url)","+        except ProviderNotConfiguredError as e:","+            yield Event.from_error(f\"Cannot connect to {self._display_name}: {e}\")","+            return"," ","         try:","             async with aiohttp.ClientSession() as session:","@@ -516,6 +528,7 @@ async def astream(","                             json=payload,","                             headers=headers,","                             timeout=aiohttp.ClientTimeout(total=300),","+                            **request_kwargs,","                         ) as resp:","                             if resp.status != 200:","                                 body = await resp.text()"],"additions":13,"deletions":0,"truncated":false},{"path":"mlflow/environment_variables.py","lines":["@@ -1944,6 +1944,13 @@ def _split_strip(s: str) -> list[str]:","     \"_MLFLOW_INTERNAL_GATEWAY_AUTH_TOKEN\", str, None"," )"," ","+#: Internal env var set by ``mlflow server`` for its worker processes when uvicorn terminates TLS","+#: itself (``--uvicorn-opts`` with ``--ssl-keyfile``/``--ssl-certfile``), so that server","+#: self-calls (see ``mlflow.server.asgi_utils.get_server_self_url``) use HTTPS. Not set behind a","+#: TLS-terminating proxy, where the listener itself speaks plain HTTP.","+#: (default: ``False``)","+_MLFLOW_SERVER_TLS_LISTENER = _BooleanEnvironmentVariable(\"_MLFLOW_SERVER_TLS_LISTENER\", False)","+"," # Short-lived, user-scoped credential the MLflow Assistant injects into a tool subprocess so the"," # tool's MLflow API calls authenticate as the session owner. It is an HMAC-signed value (see"," # mlflow.server.assistant.delegation), not a raw secret, so a leaked value only impersonates that"],"additions":7,"deletions":0,"truncated":false},{"path":"mlflow/server/__init__.py","lines":["@@ -25,6 +25,7 @@","     _MLFLOW_IN_JOB_EXECUTOR,","     _MLFLOW_INTERNAL_GATEWAY_AUTH_TOKEN,","     _MLFLOW_SERVER_BOOT_ID,","+    _MLFLOW_SERVER_TLS_LISTENER,","     _MLFLOW_SGI_NAME,","     MLFLOW_ARTIFACTS_PRESIGNED_ONLY,","     MLFLOW_FLASK_SERVER_SECRET_KEY,","@@ -335,6 +336,19 @@ def _build_gunicorn_command(gunicorn_opts, host, port, workers, app_name):"," _UVICORN_LOG_CONFIG = Path(__file__).parent / \"uvicorn_log_config.yaml\""," "," ","+def _uvicorn_opts_enable_tls(uvicorn_opts: str | None) -> bool:","+    \"\"\"Whether ``--uvicorn-opts`` makes uvicorn terminate TLS itself.","+","+    Uvicorn serves HTTPS as soon as either ``--ssl-keyfile`` or ``--ssl-certfile`` is given.","+    \"\"\"","+    opts = shlex.split(uvicorn_opts) if uvicorn_opts else []","+    return any(","+        opt == flag or opt.startswith(f\"{flag}=\")","+        for opt in opts","+        for flag in (\"--ssl-keyfile\", \"--ssl-certfile\")","+    )","+","+"," def _build_uvicorn_command(","     uvicorn_opts, host, port, workers, app_name, env_file=None, is_factory=False"," ):","@@ -635,6 +649,14 @@ def _run_server(","             else tempfile.mkdtemp()","         )"," ","+    # Whether server self-calls (e.g. the Assistant's gateway provider) must speak HTTPS to the","+    # listener; see mlflow.server.asgi_utils.get_server_self_url. Written for every launch this","+    # command owns, so a value inherited from the environment (a parent server that terminates","+    # TLS) cannot make a child server without TLS call itself over HTTPS.","+    env_map[_MLFLOW_SERVER_TLS_LISTENER.name] = (","+        \"true\" if using_uvicorn and _uvicorn_opts_enable_tls(uvicorn_opts) else \"false\"","+    )","+","     server_proc = _exec_cmd(","         full_command,","         extra_env=env_map,"],"additions":22,"deletions":0,"truncated":false},{"path":"mlflow/server/asgi_utils.py","lines":["@@ -1,9 +1,12 @@"," from __future__ import annotations"," ","+import ipaddress"," import os"," "," from starlette.requests import Request as StarletteRequest"," ","+from mlflow.environment_variables import _MLFLOW_SERVER_TLS_LISTENER","+"," "," def get_routed_asgi_path(request: StarletteRequest) -> str:","     \"\"\"Return the routed ASGI path for a FastAPI request.","@@ -24,9 +27,58 @@ def get_routed_asgi_path(request: StarletteRequest) -> str:"," "," "," def get_server_base_url(request: StarletteRequest) -> str:","-    \"\"\"Base URL for self-calls to this server (``request.base_url`` + ``--static-prefix``).\"\"\"","+    \"\"\"Base URL of this server as the client addressed it, plus ``--static-prefix``.","+","+    ``request.base_url`` comes from the client-supplied ``Host`` header, so this is the URL to","+    show to and hand back to the caller, but never a destination for server-internal","+    credentials: a caller can point it anywhere. Self-calls that carry such credentials use","+    :func:`get_server_self_url`.","+    \"\"\"","     # Imported lazily to keep this module's own import graph light.","     from mlflow.server.handlers import STATIC_PREFIX_ENV_VAR"," ","     static_prefix = os.environ.get(STATIC_PREFIX_ENV_VAR, \"\").rstrip(\"/\")","     return str(request.base_url).rstrip(\"/\") + static_prefix","+","+","+def _self_call_host(host: str) -> str:","+    \"\"\"The host part of a self-call URL for the local address ``host``.","+","+    A wildcard bind address is reachable only via loopback, an IPv4-mapped IPv6 address is the","+    IPv4 address it wraps, and an IPv6 literal needs brackets in a URL. A non-IP value (a","+    hostname reported by the ASGI server, e.g. Starlette's test client) is used as is.","+    \"\"\"","+    try:","+        ip = ipaddress.ip_address(host)","+    except ValueError:","+        return host","+    if ip.is_unspecified:","+        ip = ipaddress.ip_address(\"::1\" if ip.version == 6 else \"127.0.0.1\")","+    elif ip.version == 6 and ip.ipv4_mapped is not None:","+        ip = ip.ipv4_mapped","+    return f\"[{ip}]\" if ip.version == 6 else str(ip)","+","+","+def get_server_self_url(request: StarletteRequest) -> str | None:","+    \"\"\"URL at which this server reaches itself: the local address the request arrived on, plus","+    ``--static-prefix``. ``None`` when the ASGI server reports no address (e.g. a unix socket).","+","+    The address is the ASGI ``server`` entry (the server's own end of the accepted connection),","+    never the client-supplied ``Host`` header, so a self-call that carries server-internal","+    credentials (the MLflow Assistant's gateway provider authenticates with the internal gateway","+    token) cannot be pointed at a host of the caller's choosing. The call goes to the server","+    socket directly, bypassing any TLS-terminating proxy in front of the server: plain HTTP, or","+    HTTPS when uvicorn terminates TLS itself (``_MLFLOW_SERVER_TLS_LISTENER``, set by","+    ``mlflow server`` from its ``--uvicorn-opts``).","+    \"\"\"","+    # Imported lazily to keep this module's own import graph light.","+    from mlflow.server.handlers import STATIC_PREFIX_ENV_VAR","+","+    scope = getattr(request, \"scope\", None)","+    server = scope.get(\"server\") if isinstance(scope, dict) else None","+    if not (isinstance(server, (tuple, list)) and len(server) == 2 and server[0] and server[1]):","+        return None","+    host, port = server","+    scheme = \"https\" if _MLFLOW_SERVER_TLS_LISTENER.get() else \"http\"","+    static_prefix = os.environ.get(STATIC_PREFIX_ENV_VAR, \"\").rstrip(\"/\")","+    return f\"{scheme}://{_self_call_host(str(host))}:{int(port)}{static_prefix}\""],"additions":53,"deletions":1,"truncated":false},{"path":"mlflow/server/assistant/api.py","lines":["@@ -40,11 +40,12 @@","     assistant_sandbox_enabled,","     clear_config_cache,"," )","+from mlflow.assistant.providers.mlflow_gateway import set_server_url"," from mlflow.assistant.providers.tool_executor import is_remote_caller, set_remote_caller"," from mlflow.assistant.skill_installer import install_skills, list_installed_skills"," from mlflow.assistant.types import EventType"," from mlflow.environment_variables import MLFLOW_ENABLE_REMOTE_ASSISTANT","-from mlflow.server.asgi_utils import get_server_base_url","+from mlflow.server.asgi_utils import get_server_base_url, get_server_self_url"," from mlflow.server.assistant.gateway_permissions import ensure_assistant_gateway_use_permission"," from mlflow.server.assistant.identity import (","     BASIC_AUTH_CHALLENGE_HEADERS,","@@ -60,6 +61,7 @@","     terminate_session_process,"," )"," from mlflow.server.handlers import _add_static_prefix","+from mlflow.utils.workspace_utils import WORKSPACE_HEADER_NAME"," "," _logger = logging.getLogger(__name__)"," ","@@ -656,6 +658,17 @@ async def event_generator() -> AsyncGenerator[str, None]:","             yield Event.from_error(message).to_sse_event()","             return","         if provider.name == MlflowGatewayProvider.GATEWAY_PROVIDER_NAME:","+            # The provider calls the in-server gateway with the server's internal gateway token,","+            # so that call goes to the server's own address. The tracking URI above derives from","+            # the client's Host header, which a caller could point at a host they control. The","+            # call still presents this request's Host header, which the server's Host allowlist","+            # has already admitted, and its workspace header, so the gateway resolves the same","+            # workspace as this request.","+            set_server_url(","+                get_server_self_url(request),","+                host_header=request.headers.get(\"host\"),","+                workspace_header=request.headers.get(WORKSPACE_HEADER_NAME),","+            )","             # The in-server gateway enforces a per-endpoint USE permission. The Assistant's","             # managed endpoints are created outside the HTTP route that would grant it, so","             # authorize this caller for them before the turn calls the gateway."],"additions":14,"deletions":1,"truncated":false},{"path":"tests/assistant/providers/test_mlflow_gateway_provider.py","lines":["@@ -3,10 +3,14 @@"," from unittest import mock"," "," import pytest","+from packaging.version import Version"," "," from mlflow.assistant.config import set_config_user"," from mlflow.assistant.providers import MlflowGatewayProvider, list_providers","+from mlflow.assistant.providers.base import ProviderNotConfiguredError","+from mlflow.assistant.providers.mlflow_gateway import set_server_url"," from mlflow.gateway.constants import MLFLOW_GATEWAY_AUTH_HEADER","+from mlflow.utils.workspace_utils import WORKSPACE_HEADER_NAME"," "," "," def _gateway_provider():","@@ -98,6 +102,96 @@ def test_auth_headers_omit_gateway_token_without_user(monkeypatch, reset_config_","     assert MLFLOW_GATEWAY_AUTH_HEADER not in _gateway_provider()._auth_headers(None)"," "," ","+@pytest.fixture","+def reset_server_url():","+    set_server_url(None)","+    yield","+    set_server_url(None)","+","+","+def test_chat_url_comes_from_the_bound_server_url_not_the_tracking_uri(reset_server_url):","+    # The chat call carries the internal gateway token, so it goes to the server's own address;","+    # the tracking URI derives from the client's Host header (GHSA-98p3-crmr-mxcx).","+    set_server_url(\"http://127.0.0.1:5000\")","+","+    chat_url = MlflowGatewayProvider._build_chat_url(None, \"http://10.attacker.example:8080\")","+","+    assert chat_url == \"http://127.0.0.1:5000/gateway/mlflow/v1/chat/completions\"","+","+","+def test_chat_url_is_unresolved_without_a_bound_server_url(reset_server_url):","+    assert MlflowGatewayProvider._build_chat_url(None, \"http://10.attacker.example:8080\") is None","+","+","+def test_auth_headers_present_the_bound_host_header(reset_server_url):","+    # The self-call reaches the server at its own address but presents the Host header of the","+    # request that triggered it, which the server's Host allowlist has already admitted.","+    set_server_url(\"http://127.0.0.1:5000\", host_header=\"mlflow.internal:5000\")","+","+    assert _gateway_provider()._auth_headers(None)[\"Host\"] == \"mlflow.internal:5000\"","+","+","+def test_auth_headers_omit_host_header_without_a_bound_one(reset_server_url):","+    set_server_url(\"http://127.0.0.1:5000\")","+","+    assert \"Host\" not in _gateway_provider()._auth_headers(None)","+","+","+def test_request_kwargs_verify_tls_against_the_bound_host_name(reset_server_url):","+    # On a TLS listener the HTTPS self-call goes to the server's address, whose certificate","+    # names the host clients connect to; verify it against the inbound Host name.","+    set_server_url(\"https://127.0.0.1:5000\", host_header=\"mlflow.internal:5000\")","+","+    kwargs = _gateway_provider()._request_kwargs(","+        \"https://127.0.0.1:5000/gateway/mlflow/v1/chat/completions\"","+    )","+","+    assert kwargs == {\"server_hostname\": \"mlflow.internal\"}","+","+","+@pytest.mark.parametrize(","+    (\"url\", \"host_header\"),","+    [","+        (\"http://127.0.0.1:5000\", \"mlflow.internal:5000\"),","+        (\"https://127.0.0.1:5000\", None),","+    ],","+)","+def test_request_kwargs_empty_for_plain_http_or_without_a_bound_host(","+    reset_server_url, url, host_header","+):","+    set_server_url(url, host_header=host_header)","+","+    assert _gateway_provider()._request_kwargs(f\"{url}/gateway/mlflow/v1/chat/completions\") == {}","+","+","+def test_auth_headers_present_the_bound_workspace_header(reset_server_url):","+    # The self-call carries the inbound request's workspace header, so the gateway resolves the","+    # same (non-default) workspace instead of falling back to the default one.","+    set_server_url(\"http://127.0.0.1:5000\", workspace_header=\"team-a\")","+","+    assert _gateway_provider()._auth_headers(None)[WORKSPACE_HEADER_NAME] == \"team-a\"","+","+","+def test_auth_headers_omit_workspace_header_without_a_bound_one(reset_server_url):","+    set_server_url(\"http://127.0.0.1:5000\", host_header=\"mlflow.internal:5000\")","+","+    assert WORKSPACE_HEADER_NAME not in _gateway_provider()._auth_headers(None)","+","+","+def test_request_kwargs_reject_tls_self_call_on_old_aiohttp(monkeypatch, reset_server_url):","+    # Before aiohttp 3.9 there is no way to verify the certificate against the inbound host name","+    # while connecting to the server's address, so refuse clearly instead of failing the handshake.","+    monkeypatch.setattr(","+        \"mlflow.assistant.providers.mlflow_gateway._AIOHTTP_VERSION\", Version(\"3.8.6\")","+    )","+    set_server_url(\"https://127.0.0.1:5000\", host_header=\"mlflow.internal:5000\")","+","+    with pytest.raises(ProviderNotConfiguredError, match=\"aiohttp>=3.9\"):","+        _gateway_provider()._request_kwargs(","+            \"https://127.0.0.1:5000/gateway/mlflow/v1/chat/completions\"","+        )","+","+"," def test_check_connection_raises_when_no_backend_probe():","     # The provider has no backend listing strategy, so check_connection","     # must surface that explicitly rather than silently returning OK —"],"additions":94,"deletions":0,"truncated":false},{"path":"tests/server/assistant/test_api.py","lines":["@@ -1,3 +1,4 @@","+import base64"," import os"," import shutil"," import subprocess","@@ -10,6 +11,7 @@"," import pytest"," from fastapi import APIRouter, FastAPI, HTTPException"," from fastapi.testclient import TestClient","+from packaging.version import Version"," from starlette.requests import Request"," from uvicorn.middleware.proxy_headers import ProxyHeadersMiddleware"," ","@@ -24,6 +26,11 @@","     ProviderNotConfiguredError,"," )"," from mlflow.assistant.types import Event, Message, ToolUseBlock","+from mlflow.environment_variables import (","+    _MLFLOW_INTERNAL_GATEWAY_AUTH_TOKEN,","+    _MLFLOW_SERVER_TLS_LISTENER,","+)","+from mlflow.gateway.constants import MLFLOW_GATEWAY_AUTH_HEADER"," from mlflow.server.assistant.api import (","     _BLOCK_REMOTE_ACCESS_ERROR_MSG,","     PermissionDecision,","@@ -37,6 +44,7 @@"," )"," from mlflow.server.assistant.session import SESSION_DIR, SessionManager, save_process_pid"," from mlflow.utils.os import is_windows","+from mlflow.utils.workspace_utils import WORKSPACE_HEADER_NAME"," "," "," class MockProvider(AssistantProvider):","@@ -1222,6 +1230,98 @@ async def test_stream_tracking_uri_includes_static_prefix(monkeypatch):","     assert provider.captured[\"tracking_uri\"] == \"http://localhost:5000/myprefix\""," "," ","+@pytest.mark.parametrize(\"tls_listener\", [False, True])","+def test_stream_gateway_provider_calls_the_server_itself_not_the_client_host(","+    monkeypatch, tls_listener","+):","+    \"\"\"The gateway provider sends the server's internal gateway token with its chat call, so","+    that call must go to the server's own address even when the caller spoofs the Host header","+    (GHSA-98p3-crmr-mxcx). The tracking URI handed to the provider still follows the Host header.","+    \"\"\"","+    monkeypatch.setenv(_MLFLOW_INTERNAL_GATEWAY_AUTH_TOKEN.name, \"internal-secret\")","+    if tls_listener:","+        monkeypatch.setenv(_MLFLOW_SERVER_TLS_LISTENER.name, \"true\")","+    app = FastAPI()","+    app.include_router(assistant_router)","+    provider = MlflowGatewayProvider()","+    calls: list[tuple[str, dict[str, str], dict[str, Any]]] = []","+","+    class _Rejected:","+        status = 500","+","+        async def text(self):","+            return \"unreachable\"","+","+    class _FakePost:","+        def __init__(self, url, kwargs):","+            calls.append((url, kwargs.get(\"headers\") or {}, kwargs))","+","+        async def __aenter__(self):","+            return _Rejected()","+","+        async def __aexit__(self, *exc):","+            return False","+","+    with (","+        patch(\"mlflow.server.assistant.api.list_providers\", return_value=[provider]),","+        patch(\"mlflow.server.assistant.api._get_selected_provider\", return_value=provider),","+        patch(\"mlflow.server.assistant.api._is_localhost\", return_value=True),","+        patch(\"mlflow.server.assistant.api.resolve_authenticated_username\", return_value=\"alice\"),","+        patch(\"mlflow.server.assistant.api.ensure_assistant_gateway_use_permission\"),","+        patch.object(MlflowGatewayProvider, \"list_models\", return_value=[\"chat-endpoint\"]),","+        patch(","+            \"aiohttp.ClientSession.post\",","+            new=lambda self, url, **kwargs: _FakePost(url, kwargs),","+        ),","+    ):","+        client = TestClient(app, base_url=\"http://127.0.0.1:5000\")","+        r = client.post(\"/ajax-api/3.0/mlflow/assistant/message\", json={\"message\": \"Hi\"})","+        response = client.get(","+            r.json()[\"stream_url\"],","+            headers={\"Host\": \"10.attacker.example:8080\", WORKSPACE_HEADER_NAME: \"team-a\"},","+        )","+","+    assert response.status_code == 200","+    ((url, headers, kwargs),) = calls","+    scheme = \"https\" if tls_listener else \"http\"","+    assert url == f\"{scheme}://127.0.0.1:5000/gateway/mlflow/v1/chat/completions\"","+    credential = base64.b64encode(b\"alice:internal-secret\").decode(\"ascii\")","+    assert headers[MLFLOW_GATEWAY_AUTH_HEADER] == f\"Basic {credential}\"","+    # The destination is what matters. The Host header is the inbound request's own, which the","+    # server's Host allowlist already admitted, so a custom --allowed-hosts keeps admitting it.","+    assert headers[\"Host\"] == \"10.attacker.example:8080\"","+    # On a TLS listener the certificate is verified against that inbound name, not the address.","+    assert kwargs.get(\"server_hostname\") == (\"10.attacker.example\" if tls_listener else None)","+    # The inbound workspace header rides along, so the gateway resolves the same workspace.","+    assert headers[WORKSPACE_HEADER_NAME] == \"team-a\"","+","+","+def test_stream_gateway_provider_reports_old_aiohttp_on_a_tls_listener(monkeypatch):","+    monkeypatch.setenv(_MLFLOW_SERVER_TLS_LISTENER.name, \"true\")","+    monkeypatch.setattr(","+        \"mlflow.assistant.providers.mlflow_gateway._AIOHTTP_VERSION\", Version(\"3.8.6\")","+    )","+    app = FastAPI()","+    app.include_router(assistant_router)","+    provider = MlflowGatewayProvider()","+","+    with (","+        patch(\"mlflow.server.assistant.api.list_providers\", return_value=[provider]),","+        patch(\"mlflow.server.assistant.api._get_selected_provider\", return_value=provider),","+        patch(\"mlflow.server.assistant.api._is_localhost\", return_value=True),","+        patch(\"mlflow.server.assistant.api.ensure_assistant_gateway_use_permission\"),","+        patch.object(MlflowGatewayProvider, \"list_models\", return_value=[\"chat-endpoint\"]),","+        patch(\"aiohttp.ClientSession.post\", side_effect=AssertionError(\"must not be called\")),","+    ):","+        client = TestClient(app, base_url=\"http://127.0.0.1:5000\")","+        r = client.post(\"/ajax-api/3.0/mlflow/assistant/message\", json={\"message\": \"Hi\"})","+        response = client.get(r.json()[\"stream_url\"])","+","+    assert response.status_code == 200","+    assert \"event: error\" in response.text","+    assert \"aiohttp>=3.9\" in response.text","+","+"," @pytest.mark.asyncio"," async def test_stream_forwards_tool_decision_when_no_pending_message():","     \"\"\"A genuine resume (decision delivered, no new message) still forwards the"],"additions":100,"deletions":0,"truncated":false},{"path":"tests/server/test_asgi_utils.py","lines":["@@ -0,0 +1,57 @@","+import pytest","+from starlette.requests import Request","+","+from mlflow.server.asgi_utils import get_server_base_url, get_server_self_url","+","+","+def _request(server, host_header=b\"10.attacker.example:8080\"):","+    return Request({","+        \"type\": \"http\",","+        \"method\": \"GET\",","+        \"scheme\": \"http\",","+        \"path\": \"/ajax-api/3.0/mlflow/assistant/sessions/abc/stream\",","+        \"query_string\": b\"\",","+        \"headers\": [(b\"host\", host_header)],","+        \"server\": server,","+        \"client\": (\"10.0.0.9\", 50000),","+    })","+","+","+@pytest.mark.parametrize(","+    (\"server\", \"expected\"),","+    [","+        ((\"127.0.0.1\", 5000), \"http://127.0.0.1:5000\"),","+        ((\"0.0.0.0\", 5000), \"http://127.0.0.1:5000\"),","+        ((\"10.0.0.5\", 5000), \"http://10.0.0.5:5000\"),","+        ((\"::1\", 5000), \"http://[::1]:5000\"),","+        ((\"::\", 5000), \"http://[::1]:5000\"),","+        ((\"fd00::5\", 5000), \"http://[fd00::5]:5000\"),","+        ((\"::ffff:10.0.0.5\", 5000), \"http://10.0.0.5:5000\"),","+        ((\"testserver\", 80), \"http://testserver:80\"),","+    ],","+)","+def test_get_server_self_url_uses_the_server_address_not_the_host_header(server, expected):","+    \"\"\"A self-call carries server-internal credentials, so a client-chosen Host header must not","+    be able to redirect it (GHSA-98p3-crmr-mxcx); the client-facing base URL keeps following it.","+    \"\"\"","+    request = _request(server)","+","+    assert get_server_base_url(request) == \"http://10.attacker.example:8080\"","+    assert get_server_self_url(request) == expected","+","+","+def test_get_server_self_url_appends_static_prefix(monkeypatch):","+    monkeypatch.setenv(\"_MLFLOW_STATIC_PREFIX\", \"/mlflow/\")","+","+    assert get_server_self_url(_request((\"127.0.0.1\", 5000))) == \"http://127.0.0.1:5000/mlflow\"","+","+","+def test_get_server_self_url_uses_https_when_the_listener_terminates_tls(monkeypatch):","+    monkeypatch.setenv(\"_MLFLOW_SERVER_TLS_LISTENER\", \"true\")","+","+    assert get_server_self_url(_request((\"127.0.0.1\", 5000))) == \"https://127.0.0.1:5000\"","+","+","+@pytest.mark.parametrize(\"server\", [None, (\"/tmp/mlflow.sock\", None)])","+def test_get_server_self_url_is_none_without_a_server_address(server):","+    assert get_server_self_url(_request(server)) is None"],"additions":57,"deletions":0,"truncated":false},{"path":"tests/server/test_init.py","lines":["@@ -14,6 +14,7 @@","     _MLFLOW_AUTH_ADMIN_BOOTSTRAPPED,","     _MLFLOW_IN_JOB_EXECUTOR,","     _MLFLOW_SERVER_BOOT_ID,","+    _MLFLOW_SERVER_TLS_LISTENER,","     _MLFLOW_SGI_NAME,","     MLFLOW_ARTIFACTS_PRESIGNED_ONLY,","     MLFLOW_FLASK_SERVER_SECRET_KEY,","@@ -193,6 +194,19 @@ def test_build_uvicorn_command_with_env_file():","     assert env_file_path_idx < app_name_idx"," "," ","+@pytest.mark.parametrize(","+    (\"uvicorn_opts\", \"expected\"),","+    [","+        (None, False),","+        (\"--log-level debug\", False),","+        (\"--ssl-keyfile key.pem --ssl-certfile cert.pem\", True),","+        (\"--ssl-certfile=cert.pem\", True),","+    ],","+)","+def test_uvicorn_opts_enable_tls(uvicorn_opts, expected):","+    assert server._uvicorn_opts_enable_tls(uvicorn_opts) is expected","+","+"," def test_run_server(mock_exec_cmd, monkeypatch):","     monkeypatch.setenv(\"MLFLOW_SERVER_ENABLE_JOB_EXECUTION\", \"false\")","     with mock.patch(\"sys.platform\", return_value=\"linux\"):","@@ -209,6 +223,38 @@ def test_run_server(mock_exec_cmd, monkeypatch):","     mock_exec_cmd.assert_called_once()"],"additions":14,"deletions":0,"truncated":false}],"additions":444,"deletions":9,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-23T14:15:21.551315+00:00"}