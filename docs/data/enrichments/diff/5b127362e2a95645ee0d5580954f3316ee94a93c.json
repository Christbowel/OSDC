{"id":"5b127362e2a95645ee0d5580954f3316ee94a93c","axis":"silent","repo":"microsoft/onnxruntime","sha":"5b127362e2a95645ee0d5580954f3316ee94a93c","parsed":{"files":[{"path":"docs/moe-cpu-offload/qmoe_offload.md","lines":["@@ -120,11 +120,19 @@ session creation with `ORT_INVALID_ARGUMENT`."," | `session.moe.offload.async_max_tokens` | Non-negative integer | `8` | Token threshold separating hybrid doorbell decode (`rows <= async_max_tokens`) from GPU streaming DMA prefill (`rows > async_max_tokens`). |"," | `session.moe.offload.prefill_wave_experts` | Positive integer | `32` | Maximum experts per compaction/DMA wave during prefill (further bounded by `device_working_bytes`). |"," | `session.moe.offload.skip_zero_cold_doorbell` | `\"0\"`, `\"1\"` | `\"0\"` | Complete zero-cold partial-residency decode calls on the GPU without staging activations/indices to pinned host memory or dispatching CPU expert work (`ORT_QMOE_SKIP_ZERO_COLD_DOORBELL=1` environment fallback when the session option is unset). Applies to static placement (`resident_promotions == 0`) with cross-layer promotions disabled. Setting `ORT_QMOE_OFFLOAD_TELEMETRY=1` prints per-layer JSON counters (`layer_calls`, `zero_cold_short_circuits`, `cpu_doorbell_wakeups`, `cold_routes`) to `stderr` at session destruction. |","+| `session.moe.offload.tail_substitution_threshold` | Finite non-negative float | `0.0` | Opt-in approximate routing for decode tiles of 1..16 rows that are also at most `async_max_tokens` rows (default `8`) and have `k <= 32` (`ORT_QMOE_TAIL_SUBSTITUTION_THRESHOLD` fallback; other shapes silently skip substitution): replace cold tail experts (`rank >= min_rank`) with the highest-probability unselected GPU-resident experts when `effective_gap <= threshold` (`sqrt(prob_gap * max(0, scale_gap))` when `normalize_routing_weights=1` and `min_rank > 0`, otherwise `prob_gap`; `scale_gap` is computed from the route's retained scale, so it respects the pruning normalization mode) and `scale_within_bound` (`orig_scale <= max(25 * threshold, 0.05)` when `normalize_routing_weights=1` and `min_rank > 0`, otherwise always true), preserving untouched dominant weights (`0..min_rank-1`). With `normalize_routing_weights=1`, renormalize across the substituted tail mass (`row_scales[rank]`); with `normalize_routing_weights=0`, multiply each substituted route's incoming scale by `exp(replacement_logit - original_logit)`, preserving any post-pruning scaling from `ORT_QMOE_RENORM_AFTER_PRUNE=1`. Zero disables substitution. |","+| `session.moe.offload.tail_substitution_min_rank` | Integer `0 <= min_rank < k` when enabled | `6` | First eligible zero-based top-$k$ rank for tail substitution (`ORT_QMOE_TAIL_SUBSTITUTION_MIN_RANK` fallback). |"," | `session.moe.offload.popularity_file` | Relative or absolute path | `\"\"` | Optional path to `expert-profile.bin` (`STRP` v1 format). Relative paths resolve against the model directory. |"," | `session.moe.offload.source_root` | Relative or absolute path | Model directory | Root directory used to resolve external weight files and relative profile paths. |"," | `session.moe.offload.derived_cache_dir` | Relative or absolute path | `\"\"` | Optional directory for derived cache artifacts. |"," | `session.moe.offload.node_overrides` | Semicolon-separated spec | `\"\"` | Optional per-node overrides (`\"node_name:max_resident_slots=<N>,device_expert_bytes=<B>\"`). |"," ","+Session configuration entries take precedence over their environment fallbacks.","+Environment values are read through ORT's platform environment API, including for","+the CUDA plugin EP on Windows; unset or empty environment values use the documented defaults.","+","+Tail substitution tuning (Qwen3.8-Flash-Next RC5, `k = 10`, 256 experts, 46.7% GPU residency, S=8 speculative decode, RTX 4090 + AVX2 host): `tail_substitution_min_rank = 2` is far more effective than the `k`-relative default of `6`, because a substituted route stays GPU-resident while skipping a cold route only drops work. At `min_rank = 2`, `threshold = 0.01 / 0.02 / 0.04` removed 58% / 75% / 84% of cold experts per step and raised decode from 24.5 to 47.7 / 62.6 / 77.3 tok/s, with MMLU-Pro accuracy within noise of exact routing (`threshold = 0.04`: 165 / 200 versus 162 / 200 exact, 3.7x decode throughput). `min_rank <= 1` or `threshold >= 0.08` was less faithful to the exact greedy token stream. Combining substitution with `min_expert_weight` (tail skipping) added no measurable speed on top of substitution alone, and tail skipping also prunes prefill routes.","+"," ### 3.2 Standalone Python Usage Example"," "," ```python"],"additions":8,"deletions":0,"truncated":false},{"path":"include/onnxruntime/core/session/onnxruntime_session_options_config_keys.h","lines":["@@ -1051,6 +1051,8 @@ static const char* const kOrtSessionOptionsMoeOffloadMinExpertWeight = \"session."," // - \"0\": prune both GPU-resident and CPU-cold tail experts whose routing probability is below `min_expert_weight`."," // Overrides ORT_QMOE_SKIP_TAIL_COLD_ONLY."," static const char* const kOrtSessionOptionsMoeOffloadSkipTailColdOnly = \"session.moe.offload.skip_tail_cold_only\";","+static const char* const kOrtSessionOptionsMoeOffloadTailSubstitutionThreshold = \"session.moe.offload.tail_substitution_threshold\";","+static const char* const kOrtSessionOptionsMoeOffloadTailSubstitutionMinRank = \"session.moe.offload.tail_substitution_min_rank\";"," static const char* const kOrtSessionOptionsMoeOffloadPopularityFile = \"session.moe.offload.popularity_file\";"," static const char* const kOrtSessionOptionsMoeOffloadNodeOverrides = \"session.moe.offload.node_overrides\";"," static const char* const kOrtSessionOptionsMoeOffloadSourceRoot = \"session.moe.offload.source_root\";"],"additions":2,"deletions":0,"truncated":false},{"path":"onnxruntime/contrib_ops/cuda/moe/qmoe_kernels.cu","lines":["@@ -169,7 +169,7 @@ __global__ void QMoEOffloadClassifyKernel(","     bool skip_zero_cold, volatile uint64_t* doorbell_done_host,","     QMoEOffloadTelemetry* telemetry,","     float* topk_scales_for_cold_prune, float min_cold_expert_weight,","-    int top_k_for_cold_prune) {","+    int top_k_for_cold_prune, const float* topk_scales_for_telemetry) {","   const int row = blockIdx.x * blockDim.x + threadIdx.x;","   int exp = 0;","   int slot = -1;","@@ -197,6 +197,10 @@ __global__ void QMoEOffloadClassifyKernel(","     hit_compact[row] = slot < 0 ? dummy_slot : slot;","     if (row < route_count) {","       hit_flag[row] = (slot >= 0) || skipped_tail;","+      if (telemetry != nullptr && row < 256) {","+        telemetry->last_indices[row] = exp;","+        telemetry->last_weights[row] = (topk_scales_for_telemetry != nullptr) ? topk_scales_for_telemetry[row] : 0.0f;","+      }","     }","   }","   const bool has_doorbell = (doorbell_seq_dev != nullptr && doorbell_req_host != nullptr && gridDim.x == 1);","@@ -323,7 +327,7 @@ cudaError_t LaunchQMoEOffloadClassify(","     bool skip_zero_cold, volatile uint64_t* doorbell_done_host,","     QMoEOffloadTelemetry* telemetry,","     float* topk_scales_for_cold_prune, float min_cold_expert_weight,","-    int top_k_for_cold_prune) {","+    int top_k_for_cold_prune, const float* topk_scales_for_telemetry) {","   if (row_count <= 0) return cudaSuccess;","   if (doorbell_seq_dev != nullptr && doorbell_req_host != nullptr && row_count <= 256) {","     QMoEOffloadClassifyKernel<<<1, 256, 0, stream>>>(","@@ -333,7 +337,7 @@ cudaError_t LaunchQMoEOffloadClassify(","         reinterpret_cast<uint4*>(host_input_out), input_vec4_count,","         doorbell_seq_dev, doorbell_req_host, doorbell_tile_rows_host, tile_rows,","         skip_zero_cold, doorbell_done_host, telemetry,","-        topk_scales_for_cold_prune, min_cold_expert_weight, top_k_for_cold_prune);","+        topk_scales_for_cold_prune, min_cold_expert_weight, top_k_for_cold_prune, topk_scales_for_telemetry);","     return cudaGetLastError();","   }","   const int blocks = row_count / 128 + (row_count % 128 != 0);","@@ -342,11 +346,182 @@ cudaError_t LaunchQMoEOffloadClassify(","       unit_scales, identity_permutation, k_for_source_rows,","       host_indices_out, reinterpret_cast<const uint4*>(input_dev),","       reinterpret_cast<uint4*>(host_input_out), input_vec4_count,","-      nullptr, nullptr, nullptr, tile_rows, false, nullptr, nullptr,","-      topk_scales_for_cold_prune, min_cold_expert_weight, top_k_for_cold_prune);","+      nullptr, nullptr, nullptr, tile_rows, false, nullptr, telemetry,","+      topk_scales_for_cold_prune, min_cold_expert_weight, top_k_for_cold_prune, topk_scales_for_telemetry);","+  return cudaGetLastError();","+}","+","+template <typename T>","+__global__ void QMoETailSubstitutionKernel(","+    const T* logits, float* topk_scales, int* topk_indices, const int* expert_slot,","+    int num_experts, int k, int min_rank, float threshold, bool normalize_scales,","+    QMoEOffloadTelemetry* telemetry) {","+  const int row = blockIdx.x;","+  const int lane = threadIdx.x;","+  const T* row_logits = logits + static_cast<size_t>(row) * num_experts;","+  int* row_indices = topk_indices + row * k;","+  float* row_scales = topk_scales + row * k;","+  float row_max = -FLT_MAX;","+  for (int expert = lane; expert < num_experts; expert += 32) {","+    row_max = fmaxf(row_max, static_cast<float>(row_logits[expert]));","+  }","+  for (int offset = 16; offset > 0; offset /= 2) {","+    row_max = fmaxf(row_max, __shfl_down_sync(0xffffffffu, row_max, offset));","+  }","+  row_max = __shfl_sync(0xffffffffu, row_max, 0);","+  float row_sum = 0.0f;","+  for (int expert = lane; expert < num_experts; expert += 32) {","+    row_sum += expf(static_cast<float>(row_logits[expert]) - row_max);","+  }","+  for (int offset = 16; offset > 0; offset /= 2) {","+    row_sum += __shfl_down_sync(0xffffffffu, row_sum, offset);","+  }","+  row_sum = __shfl_sync(0xffffffffu, row_sum, 0);","+  if (!isfinite(row_max) || !isfinite(row_sum) || row_sum <= 0.0f) return;","+","+  extern __shared__ uint32_t selected[];","+  const int mask_words = num_experts / 32 + (num_experts % 32 != 0);","+  for (int word = lane; word < mask_words; word += 32) selected[word] = 0;","+  __syncwarp();","+  int cold_before = 0;","+  for (int rank = lane; rank < k; rank += 32) {","+    const int expert = row_indices[rank];","+    if (expert < 0) continue;  // Pruned by SoftmaxTopK.","+    atomicOr(selected + expert / 32, uint32_t{1} << (expert % 32));","+    cold_before += expert_slot[expert] < 0;","+  }","+  __syncwarp();","+  for (int offset = 16; offset > 0; offset /= 2) {","+    cold_before += __shfl_down_sync(0xffffffffu, cold_before, offset);","+  }","+  cold_before = __shfl_sync(0xffffffffu, cold_before, 0);","+","+  int substitutions = 0;","+  uint32_t sub_rank_mask = 0u;","+  float sub_orig_scale_mass = 0.0f;","+  for (int rank = min_rank; rank < k; ++rank) {","+    const int expert = row_indices[rank];","+    if (expert < 0 || expert_slot[expert] >= 0) continue;","+    float best_logit = -FLT_MAX;","+    int best_expert = num_experts;","+    for (int candidate = lane; candidate < num_experts; candidate += 32) {","+      if (expert_slot[candidate] < 0 ||","+          (selected[candidate / 32] & (uint32_t{1} << (candidate % 32))) != 0) continue;","+      const float value = static_cast<float>(row_logits[candidate]);","+      if (value > best_logit || (value == best_logit && candidate < best_expert)) {","+        best_logit = value;","+        best_expert = candidate;","+      }","+    }","+    for (int offset = 16; offset > 0; offset /= 2) {","+      const float other_logit = __shfl_down_sync(0xffffffffu, best_logit, offset);","+      const int other_expert = __shfl_down_sync(0xffffffffu, best_expert, offset);","+      if (lane + offset < 32 &&","+          (other_logit > best_logit || (other_logit == best_logit && other_expert < best_expert))) {","+        best_logit = other_logit;","+        best_expert = other_expert;","+      }","+    }","+    best_logit = __shfl_sync(0xffffffffu, best_logit, 0);","+    best_expert = __shfl_sync(0xffffffffu, best_expert, 0);","+    const float expert_logit = static_cast<float>(row_logits[expert]);","+    const float original_probability = expf(expert_logit - row_max) / row_sum;","+    const float replacement_probability = expf(best_logit - row_max) / row_sum;","+    // The retained scale already reflects SoftmaxTopK's pruning and normalization mode, so compare against it rather","+    // than renormalizing over the experts that happen to survive.","+    const float orig_scale = row_scales[rank];","+    const float repl_scale = orig_scale * expf(best_logit - expert_logit);","+    const float prob_gap = original_probability - replacement_probability;","+    const float scale_gap = orig_scale - repl_scale;","+    const float effective_gap =","+        (normalize_scales && min_rank > 0 && prob_gap > 0.0f)","+            ? sqrtf(prob_gap * fmaxf(0.0f, scale_gap))","+            : prob_gap;","+    const bool scale_within_bound =","+        !normalize_scales || min_rank == 0 || orig_scale <= fmaxf(threshold * 25.0f, 0.050f);","+    if (best_expert < num_experts && effective_gap <= threshold && scale_within_bound) {","+      if (lane == 0) {","+        row_indices[rank] = best_expert;","+        if (!normalize_scales) {","+          row_scales[rank] = repl_scale;","+        }","+        selected[expert / 32] &= ~(uint32_t{1} << (expert % 32));","+        selected[best_expert / 32] |= uint32_t{1} << (best_expert % 32);","+      }","+      sub_rank_mask |= (uint32_t{1} << rank);","+      sub_orig_scale_mass += orig_scale;","+      ++substitutions;","+      __syncwarp();","+    }","+  }","+  if (substitutions == 0) return;","+","+  if (normalize_scales) {","+    float sub_max = -FLT_MAX;","+    for (int rank = lane; rank < k; rank += 32) {","+      if ((sub_rank_mask & (uint32_t{1} << rank)) != 0u) {","+        sub_max = fmaxf(sub_max, static_cast<float>(row_logits[row_indices[rank]]));","+      }","+    }","+    for (int offset = 16; offset > 0; offset /= 2) {","+      sub_max = fmaxf(sub_max, __shfl_down_sync(0xffffffffu, sub_max, offset));","+    }","+    sub_max = __shfl_sync(0xffffffffu, sub_max, 0);","+    float sub_sum = 0.0f;","+    for (int rank = lane; rank < k; rank += 32) {","+      if ((sub_rank_mask & (uint32_t{1} << rank)) != 0u) {","+        sub_sum += expf(static_cast<float>(row_logits[row_indices[rank]]) - sub_max);","+      }","+    }","+    for (int offset = 16; offset > 0; offset /= 2) {","+      sub_sum += __shfl_down_sync(0xffffffffu, sub_sum, offset);","+    }","+    sub_sum = __shfl_sync(0xffffffffu, sub_sum, 0);","+    const float mass = (substitutions == k) ? 1.0f : sub_orig_scale_mass;","+    const float sub_denom = fmaxf(sub_sum, kTopKNormalizeEpsilon);","+    for (int rank = lane; rank < k; rank += 32) {","+      if ((sub_rank_mask & (uint32_t{1} << rank)) != 0u) {","+        row_scales[rank] = mass * expf(static_cast<float>(row_logits[row_indices[rank]]) - sub_max) / sub_denom;","+      }","+    }","+  }","+  if (lane == 0 && telemetry != nullptr) {","+    telemetry->substituted_routes_count[row] += substitutions;","+    telemetry->zero_cold_conversions_count[row] += cold_before == substitutions;","+  }","+}","+","+template <typename T>","+cudaError_t LaunchQMoETailSubstitutionImpl(","+    const T* logits, float* topk_scales, int* topk_indices, const int* expert_slot,","+    int num_rows, int num_experts, int k, int min_rank, float threshold,","+    bool normalize_scales, cudaStream_t stream, QMoEOffloadTelemetry* telemetry) {","+  if (num_rows <= 0 || num_rows > kQMoETailSubstitutionMaxRows || k <= 0 || k > 32 || k > num_experts || min_rank < 0 || min_rank >= k ||","+      threshold <= 0.0f || logits == nullptr || topk_scales == nullptr ||","+      topk_indices == nullptr || expert_slot == nullptr) return cudaErrorInvalidValue;","+  const size_t mask_bytes = static_cast<size_t>(num_experts / 32 + (num_experts % 32 != 0)) * sizeof(uint32_t);","+  QMoETailSubstitutionKernel<<<num_rows, 32, mask_bytes, stream>>>(","+      logits, topk_scales, topk_indices, expert_slot, num_experts, k, min_rank, threshold,","+      normalize_scales, telemetry);","   return cudaGetLastError();"," }"," ","+cudaError_t LaunchQMoETailSubstitution(","+    const half* logits, float* topk_scales, int* topk_indices, const int* expert_slot,","+    int num_rows, int num_experts, int k, int min_rank, float threshold,","+    bool normalize_scales, cudaStream_t stream, QMoEOffloadTelemetry* telemetry) {","+  return LaunchQMoETailSubstitutionImpl(logits, topk_scales, topk_indices, expert_slot, num_rows,","+                                        num_experts, k, min_rank, threshold, normalize_scales, stream, telemetry);","+}","+","+cudaError_t LaunchQMoETailSubstitution(","+    const __nv_bfloat16* logits, float* topk_scales, int* topk_indices, const int* expert_slot,","+    int num_rows, int num_experts, int k, int min_rank, float threshold,","+    bool normalize_scales, cudaStream_t stream, QMoEOffloadTelemetry* telemetry) {","+  return LaunchQMoETailSubstitutionImpl(logits, topk_scales, topk_indices, expert_slot, num_rows,","+                                        num_experts, k, min_rank, threshold, normalize_scales, stream, telemetry);","+}","+"," cudaError_t LaunchQMoEOffloadMerge(","     const half* wave_output, const half* cpu_rows, const int* hit_flag, half* contributions,","     int route_count, int hidden_size, int tile_rows, int k, cudaStream_t stream,"],"additions":180,"deletions":5,"truncated":false},{"path":"onnxruntime/contrib_ops/cuda/moe/qmoe_kernels.h","lines":["@@ -12,12 +12,19 @@ namespace onnxruntime {"," namespace contrib {"," namespace cuda {"," ","+// Largest decode tile (rows) that tail expert substitution handles; covers speculative verify steps.","+constexpr int kQMoETailSubstitutionMaxRows = 16;","+"," struct QMoEOffloadTelemetry {","   uint64_t layer_calls;","   uint64_t zero_cold_short_circuits;","   uint64_t cold_routes;","+  uint64_t substituted_routes_count[kQMoETailSubstitutionMaxRows];","+  uint64_t zero_cold_conversions_count[kQMoETailSubstitutionMaxRows];","   int last_route_count;","   int last_cold_count;","+  int last_indices[256];","+  float last_weights[256];"," };"," "," void LaunchSoftmaxTopK(","@@ -118,8 +125,16 @@ cudaError_t LaunchQMoEOffloadClassify(","     bool skip_zero_cold = false, volatile uint64_t* doorbell_done_host = nullptr,","     QMoEOffloadTelemetry* telemetry = nullptr,","     float* topk_scales_for_cold_prune = nullptr, float min_cold_expert_weight = 0.0f,","-    int top_k_for_cold_prune = 0);","-","+    int top_k_for_cold_prune = 0, const float* topk_scales_for_telemetry = nullptr);","+","+cudaError_t LaunchQMoETailSubstitution(","+    const half* logits, float* topk_scales, int* topk_indices, const int* expert_slot,","+    int num_rows, int num_experts, int k, int min_rank, float threshold,","+    bool normalize_scales, cudaStream_t stream, QMoEOffloadTelemetry* telemetry = nullptr);","+cudaError_t LaunchQMoETailSubstitution(","+    const __nv_bfloat16* logits, float* topk_scales, int* topk_indices, const int* expert_slot,","+    int num_rows, int num_experts, int k, int min_rank, float threshold,","+    bool normalize_scales, cudaStream_t stream, QMoEOffloadTelemetry* telemetry = nullptr);"," cudaError_t LaunchQMoEOffloadMerge(","     const half* wave_output, const half* cpu_rows, const int* hit_flag, half* contributions,","     int route_count, int hidden_size, int tile_rows, int k, cudaStream_t stream,"],"additions":17,"deletions":2,"truncated":false},{"path":"onnxruntime/contrib_ops/cuda/moe/qmoe_offload.cc","lines":["@@ -13,6 +13,7 @@"," #include <algorithm>"," #include <atomic>"," #include <chrono>","+#include <cinttypes>"," #include <cmath>"," #include <condition_variable>"," #include <cstring>","@@ -3136,21 +3137,47 @@ QMoEOffload::~QMoEOffload() {","   if (offload_telemetry_ && decode_stat