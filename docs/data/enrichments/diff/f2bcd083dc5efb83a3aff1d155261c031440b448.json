}\"","+                   INTERFACE_LINK_LIBRARIES \"${ZSTD_PRIVATE_LIBRARIES}\"","+                   INTERFACE_LINK_OPTIONS \"${ZSTD_STATIC_LDFLAGS_OTHER}\")","+else ()","+    message(STATUS \"Zstandard support is disabled\")","+endif ()","+"," add_subdirectory(\"${CMAKE_SOURCE_DIR}/deps\")"," "," # Update linker flags for the allocator","@@ -362,6 +396,7 @@ unset(USE_TLS CACHE)"," unset(USE_RDMA CACHE)"," unset(BUILD_TLS CACHE)"," unset(BUILD_RDMA CACHE)","+unset(BUILD_ZSTD CACHE)"," unset(BUILD_MALLOC CACHE)"," unset(USE_JEMALLOC CACHE)"," unset(BUILD_TLS_MODULE CACHE)"],"additions":35,"deletions":0,"truncated":false},{"path":"src/CMakeLists.txt","lines":["@@ -12,6 +12,9 @@ list(APPEND SERVER_LIBS \"fpconv\")"," list(APPEND SERVER_LIBS \"hdr_histogram\")"," list(APPEND SERVER_LIBS \"ffc\")"," list(APPEND SERVER_LIBS \"lz4\")","+if (USE_ZSTD)","+    list(APPEND SERVER_LIBS \"valkey_zstd\")","+endif ()"," valkey_build_and_install_bin(valkey-server \"${VALKEY_SERVER_SRCS}\" \"${VALKEY_SERVER_LDFLAGS}\" \"${SERVER_LIBS}\"","                              \"redis-server\")"," add_dependencies(valkey-server generate_commands_def)"],"additions":3,"deletions":0,"truncated":false},{"path":"src/Makefile","lines":["@@ -33,6 +33,7 @@ ifneq ($(OPTIMIZATION),-O0)"," endif"," DEPENDENCY_TARGETS=libvalkey linenoise hdr_histogram fpconv lz4"," NODEPS:=clean distclean","+CLEAN_ONLY := $(if $(MAKECMDGOALS),$(if $(filter-out $(NODEPS),$(MAKECMDGOALS)),,yes))"," "," # Default settings"," STD=-pedantic","@@ -258,6 +259,46 @@ endif"," # Include paths to dependencies"," FINAL_CFLAGS+= -I../deps/libvalkey/include -I../deps/linenoise -I../deps/hdr_histogram -I../deps/fpconv -I../deps/fast_float -I../deps/lz4"," ","+# Zstandard support is disabled by default.","+BUILD_ZSTD ?= no","+","+ifneq ($(CLEAN_ONLY),yes)","+ifneq ($(filter $(BUILD_ZSTD),yes no),$(BUILD_ZSTD))","+$(error BUILD_ZSTD must be yes or no)","+endif","+endif","+","+ifeq ($(BUILD_ZSTD),yes)","+ifneq ($(CLEAN_ONLY),yes)","+if