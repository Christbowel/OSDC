MEMAP_NAME_LEN 64","-HT_START_KEY_DEFN(namenum_key)","-HT_DEF_KEY_FIELD_CHAR_ARRAY(name, NAMEMAP_NAME_LEN)","-HT_END_KEY_DEFN(NAMENUM_KEY)","+","+/* 1 << NAMEMAP_HT_BITS buckets; chains grow beyond that many names. */","+#define NAMEMAP_HT_BITS 10","+","+/*","+ * A name, held once: it is an element of the name->number table and its","+ * |name| is the string stored in the number->names stack, which owns it.","+ * Nothing changes after the entry has been added, and entries are only","+ * freed with the namemap, so the table is read without a lock.","+ */","+typedef struct namemap_entry_st {","+    OSSL_QUEUE_MEMBER(namenum);","+    uint64_t hash; /* of the folded key */","+    size_t keylen; /* strlen(name), at most NAMEMAP_NAME_LEN */","+    int number;","+    char name[1]; /* as registered, NUL terminated */","+} NAMEMAP_ENTRY;","+","+DEFINE_QUEUE_OF(namenum, NAMEMAP_ENTRY);","+DEFINE_HTABLE_OF(namenum, NAMEMAP_ENTRY, NAMEMAP_HT_BITS);","+DEFINE_HTABLE_RCU_OF(namenum, NAMEMAP_ENTRY);","+","+/*","+ * Names compare case insensitively, by clearing the bit that tells an upper","+ * from a lower case letter. Two names are the same when their keys, the","+ * first NAMEMAP_NAME_LEN characters folded this way, are.","+ */","+#if defined(CHARSET_EBCDIC) && !defined(CHARSET_EBCDIC_TEST)","+#define NAMEMAP_FOLD 0xbfU","+#else","+#define NAMEMAP_FOLD 0xdfU","+#endif","+","+/*","+ * Keys are hashed and compared a word at a time. The words are read in the","+ * host's byte order, which is as good as any: neither a word nor a hash","+ * leaves the process.","+ */","+static ossl_inline uint64_t namemap_fold64(const char *p)","+{","+    uint64_t w;","+","+    memcpy(&w, p, sizeof(w));","+    return w & (NAMEMAP_FOLD * 0x0101010101010101ULL);","+}","+","+static ossl_inline uint32_t namemap_fold32(const char *p)","+{","+    uint32_t w;","+","+    memcpy(&w, p, sizeof(w));","+    return w & (NAMEMAP_FOLD * 0x01010101U);","+}","+","+/*","+ * The folded key of a name shorter than a word