;","+","+    if (e->hash != hash || e->keylen != keylen)","+        return 0;","+    if (keylen < sizeof(uint64_t))","+        return namemap_fold_short(e->name, keylen)","+            == namemap_fold_short(name, keylen);","+    for (i = 0; i + sizeof(uint64_t) < keylen; i += sizeof(uint64_t))","+        if (namemap_fold64(e->name + i) != namemap_fold64(name + i))","+            return 0;","+    return namemap_fold64(e->name + keylen - sizeof(uint64_t))","+        == namemap_fold64(name + keylen - sizeof(uint64_t));","+}"," "," /*-","  * The namemap itself","@@ -34,17 +149,21 @@ struct ossl_namemap_st {","     /* Flags */","     unsigned int stored : 1; /* If 1, it's stored in a library context */"," ","-    HT *namenum_ht; /* Name->number mapping */","-","     CRYPTO_RWLOCK *lock;","     STACK_OF(NAMES) *numnames;"," ","     TSAN_QUALIFIER int max_number; /* Current max number */","+","+    /*","+     * Name->number mapping. Added to under |lock|, held for writing; read","+     * without a lock.","+     */","+    OSSL_HTABLE(namenum) namenum_ht;"," };"," "," static void name_string_free(char *name)"," {","-    OPENSSL_free(name);","+    OPENSSL_free(OSSL_CONTAINER_OF(name, NAMEMAP_ENTRY, name));"," }"," "," static void names_free(NAMES *n)","@@ -139,19 +258,15 @@ int ossl_namemap_doall_names(const OSSL_NAMEMAP *namemap, int number,","     return i > 0;"," }"," ","-int ossl_namemap_name2num(const OSSL_NAMEMAP *namemap, const char *name)","-{","-    if (name == NULL)","-        return 0;","-    return ossl_namemap_name2num_n(namemap, name, strlen(name));","-}","-","-int ossl_namemap_name2num_n(const OSSL_NAMEMAP *namemap,","+/*","+ * The number of the name whose key is the first |name_len| characters of","+ * |name|, or 0. All of them are read, so there must be no NUL among them.","+ */","+static ossl_inline int namemap_find(const OSSL_NAMEMAP *namemap,","     const char *name, size_t name_len)"," {","-    int number = 0;","-    HT_VALUE *val;","-    NAMENUM_KEY key;