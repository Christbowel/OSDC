 be locked */","-static int numname_insert(OSSL_NAMEMAP *namemap, int number,","-    const char *name)","+/*","+ * Add |name| to the names of |number|, or as the first name of a new number","+ * if that is 0. The stack takes ownership of the entry that |name| is part","+ * of. This function is not thread safe, the namemap must be locked.","+ */","+static int numname_insert(OSSL_NAMEMAP *namemap, int number, char *name)"," {","     NAMES *names;","-    char *tmpname;"," ","     if (number > 0) {","         names = sk_NAMES_value(namemap->numnames, number - 1);","@@ -217,25 +359,19 @@ static int numname_insert(OSSL_NAMEMAP *namemap, int number,","             return 0;","     }"," ","-    if ((tmpname = OPENSSL_strdup(name)) == NULL)","-        goto err;","-","-    if (!sk_OPENSSL_STRING_push(names, tmpname))","-        goto err;","-    tmpname = NULL;","-","     if (number <= 0) {","-        if (!sk_NAMES_push(namemap->numnames, names))","-            goto err;","+        /* Reserve the slot first, so that the pushes below cannot fail */","+        if (!sk_OPENSSL_STRING_reserve(names, 1)","+            || !sk_NAMES_push(namemap->numnames, names)) {","+            sk_OPENSSL_STRING_free(names);","+            return 0;","+        }","         number = sk_NAMES_num(namemap->numnames);","     }","-    return number;"," ","-err:","-    if (number <= 0)","-        sk_OPENSSL_STRING_pop_free(names, name_string_free);","-    OPENSSL_free(tmpname);","-    return 0;","+    if (!sk_OPENSSL_STRING_push(names, name))","+        return 0;","+    return number;"," }"," "," /* This function is not thread safe, the namemap must be locked */","@@ -243,32 +379,31 @@ static int namemap_add_name(OSSL_NAMEMAP *namemap, int number,","     const char *name)"," {","     int ret;","-    HT_VALUE val = { 0 };","-    NAMENUM_KEY key;","+    size_t len = strlen(name);","+    NAMEMAP_ENTRY *e;"," ","     /* If it already exists, we don't add it */","     if ((ret = ossl_namemap_name2num(namemap