{"id":"f01f7ef65d6dbafc158d5bdd9d09ed56a8a886e1","axis":"silent","repo":"apache/airflow","sha":"f01f7ef65d6dbafc158d5bdd9d09ed56a8a886e1","parsed":{"files":[{"path":"airflow-core/newsfragments/76007.significant.rst","lines":["@@ -0,0 +1,22 @@","+Setting a Variable to ``None`` from a task is deprecated","+","+``Variable.set(key, None)`` (and ``Variable.aset``) in the Task SDK has always stored the","+string ``\"None\"``. It still does, but now emits a ``DeprecatedVariableNoneValueWarning`` and","+will be an error in a future release. Pass ``\"None\"`` explicitly to keep the current behavior,","+or use ``serialize_json=True`` to store a JSON ``null``.","+","+The Execution API version ``2027-02-28`` and the supervisor schema version ``2027-02-28`` make","+the Variable value non-nullable. A successful read never carried a null value, so this only","+changes the documented type. Clients pinned to an older version can still set a Variable to","+null, which keeps storing ``\"None\"``.","+","+* Types of change","+","+  * [ ] Dag changes","+  * [ ] Config changes","+  * [x] API changes","+  * [ ] CLI changes","+  * [x] Behaviour changes","+  * [ ] Plugin changes","+  * [ ] Dependency changes","+  * [x] Code interface changes"],"additions":22,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/datamodels/variable.py","lines":["@@ -26,13 +26,13 @@ class VariableResponse(StrictBaseModel):","     \"\"\"Variable schema for responses with fields that are needed for Runtime.\"\"\""," ","     key: str","-    val: str | None = Field(alias=\"value\")","+    val: str = Field(alias=\"value\")"," "," "," class VariablePostBody(StrictBaseModel):","     \"\"\"Request body schema for creating variables.\"\"\""," ","-    value: str | None = Field(alias=\"val\")","+    value: str = Field(alias=\"val\")","     description: str | None = Field(default=None)"," "," "],"additions":2,"deletions":2,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/versions/__init__.py","lines":["@@ -71,11 +71,17 @@"," from airflow.api_fastapi.execution_api.versions.v2027_02_28 import (","     AddDagProcessorJobEndpoints,","     AddExecutionTimeoutToTIRunContext,","+    MakeVariableValueNonNullable,"," )"," "," bundle = VersionBundle(","     HeadVersion(),","-    Version(\"2027-02-28\", AddDagProcessorJobEndpoints, AddExecutionTimeoutToTIRunContext),","+    Version(","+        \"2027-02-28\",","+        AddDagProcessorJobEndpoints,","+        AddExecutionTimeoutToTIRunContext,","+        MakeVariableValueNonNullable,","+    ),","     Version(","         \"2026-10-30\",","         AddArgBindingsToTIRunContext,"],"additions":7,"deletions":1,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/versions/v2027_02_28.py","lines":["@@ -17,9 +17,18 @@"," "," from __future__ import annotations"," ","-from cadwyn import ResponseInfo, VersionChange, convert_response_to_previous_version_for, endpoint, schema","+from cadwyn import (","+    RequestInfo,","+    ResponseInfo,","+    VersionChange,","+    convert_request_to_next_version_for,","+    convert_response_to_previous_version_for,","+    endpoint,","+    schema,","+)"," "," from airflow.api_fastapi.execution_api.datamodels.taskinstance import TIRunContext","+from airflow.api_fastapi.execution_api.datamodels.variable import VariablePostBody, VariableResponse"," "," "," class AddDagProcessorJobEndpoints(VersionChange):","@@ -52,3 +61,25 @@ class AddExecutionTimeoutToTIRunContext(VersionChange):","     def remove_execution_timeout_field(response: ResponseInfo) -> None:  # type: ignore[misc]","         \"\"\"Strip ``execution_timeout`` from the run context for older clients.\"\"\"","         response.body.pop(\"execution_timeout\", None)","+","+","+class MakeVariableValueNonNullable(VersionChange):","+    \"\"\"","+    Make the Variable value non-nullable in reads and writes.","+","+    A Variable read never returned null; a missing Variable is a 404. Setting a Variable to null","+    stored the string ``\"None\"``. Older clients may still send null, which keeps doing that.","+    \"\"\"","+","+    description = __doc__","+","+    instructions_to_migrate_to_previous_version = (","+        schema(VariableResponse).field(\"val\").had(type=str | None),","+        schema(VariablePostBody).field(\"value\").had(type=str | None),","+    )","+","+    @convert_request_to_next_version_for(VariablePostBody)  # type: ignore[arg-type]","+    def store_null_value_as_none_string(request: RequestInfo) -> None:","+        \"\"\"Keep the old behavior of storing ``str(None)`` when an older client sets null.\"\"\"","+        if \"val\" in request.body and request.body[\"val\"] is None:","+            request.body[\"val\"] = \"None\""],"additions":32,"deletions":1,"truncated":false},{"path":"airflow-core/tests/unit/api_fastapi/execution_api/versions/v2027_02_28/test_variables.py","lines":["@@ -0,0 +1,65 @@","+# Licensed to the Apache Software Foundation (ASF) under one","+# or more contributor license agreements.  See the NOTICE file","+# distributed with this work for additional information","+# regarding copyright ownership.  The ASF licenses this file","+# to you under the Apache License, Version 2.0 (the","+# \"License\"); you may not use this file except in compliance","+# with the License.  You may obtain a copy of the License at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+from __future__ import annotations","+","+import pytest","+from sqlalchemy import select","+","+from airflow.models.variable import Variable","+","+from tests_common.test_utils.db import clear_db_variables","+","+pytestmark = pytest.mark.db_test","+","+PREVIOUS_VERSION = \"2026-10-30\"","+","+","+@pytest.fixture(autouse=True)","+def setup_method():","+    clear_db_variables()","+    yield","+    clear_db_variables()","+","+","+class TestVariableValueNonNullableVersioning:","+    \"\"\"The Variable value became non-nullable in the 2027-02-28 API version.\"\"\"","+","+    @pytest.mark.parametrize(\"body\", [{\"value\": None}, {\"val\": None}])","+    def test_old_version_put_null_stores_none_string(self, client, session, body):","+        client.headers[\"Airflow-API-Version\"] = PREVIOUS_VERSION","+","+        response = client.put(\"/execution/variables/var_null\", json=body)","+","+        assert response.status_code == 201, response.json()","+        var = session.scalars(select(Variable).where(Variable.key == \"var_null\")).one()","+        assert var.val == \"None\"","+","+    @pytest.mark.parametrize(\"body\", [{\"value\": \"real\"}, {\"val\": \"real\"}])","+    def test_old_version_put_value_is_stored_unchanged(self, client, session, body):","+        client.headers[\"Airflow-API-Version\"] = PREVIOUS_VERSION","+","+        response = client.put(\"/execution/variables/var_real\", json=body)","+","+        assert response.status_code == 201, response.json()","+        var = session.scalars(select(Variable).where(Variable.key == \"var_real\")).one()","+        assert var.val == \"real\"","+","+    def test_head_put_null_returns_422(self, client):","+        response = client.put(\"/execution/variables/var_null\", json={\"value\": None})","+","+        assert response.status_code == 422","+        assert response.json()[\"detail\"][0][\"type\"] == \"string_type\""],"additions":65,"deletions":0,"truncated":false},{"path":"go-sdk/pkg/execution/client.go","lines":["@@ -168,29 +168,11 @@ func (c *CoordinatorClient) GetVariable(ctx context.Context, key string) (string"," \t\treturn \"\", fmt.Errorf(\"decoding variable result: %w\", err)"," \t}"," ","-\tif result.Value == nil {","-\t\treturn \"\", fmt.Errorf(\"%w: %q\", sdk.VariableNotFound, key)","-\t}","-"," \t// TODO: register secret-named variables with a SecretsMasker so the"," \t// returned value is automatically redacted from subsequent task logs,"," \t// matching Python's airflow.models.variable.Variable.get behaviour."," ","-\tswitch v := result.Value.(type) {","-\tcase string:","-\t\treturn v, nil","-\tdefault:","-\t\t// Airflow Variables are stored as strings, but the supervisor","-\t\t// decodes msgpack into native Go types — a supervisor that","-\t\t// returns a list/map/number means the caller stored JSON.","-\t\t// Re-encode it so UnmarshalJSONVariable still works uniformly","-\t\t// across HTTP and coordinator modes.","-\t\tb, err := json.Marshal(v)","-\t\tif err != nil {","-\t\t\treturn \"\", fmt.Errorf(\"marshaling variable value: %w\", err)","-\t\t}","-\t\treturn string(b), nil","-\t}","+\treturn result.Value, nil"," }"," "," // UnmarshalJSONVariable gets a variable and unmarshals its JSON value."],"additions":1,"deletions":19,"truncated":false},{"path":"go-sdk/pkg/execution/genmodels/models.gen.go","lines":["@@ -1494,7 +1494,7 @@ type PutVariable struct {"," \tType string `msgpack:\"type,omitempty\"`"," "," \t// Value corresponds to the JSON schema field \"value\".","-\tValue interface{} `msgpack:\"value\"`","+\tValue string `msgpack:\"value\"`"," }"," "," type RenderedFields map[string]JsonValue","@@ -1865,40 +1865,23 @@ type TaskInstance struct {"," \tTryNumber int `msgpack:\"try_number\"`"," }"," ","-type Warnings []interface{}","-","-type TriggerKwargs map[string]interface{}","-"," type TaskInstanceState string"," ","-type VersionData map[string]interface{}","-"," const TaskInstanceStateAwaitingInput TaskInstanceState = \"awaiting_input\""," const TaskInstanceStateDeferred TaskInstanceState = \"deferred\"","-const TaskInstanceStateSkipped TaskInstanceState = \"skipped\"","-const TaskInstanceStateUpstreamFailed TaskInstanceState = \"upstream_failed\"","