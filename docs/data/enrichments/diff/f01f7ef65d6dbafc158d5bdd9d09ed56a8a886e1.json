visorTIRunContext),","+        Version(","+            \"2027-02-28\",","+            AddExecutionTimeoutToSupervisorTIRunContext,","+            MakeSupervisorVariableValueNonNullable,","+        ),","         Version(","             \"2026-10-30\",","             AddArgBindingsToSupervisorTIRunContext,"],"additions":6,"deletions":1,"truncated":false},{"path":"task-sdk/src/airflow/sdk/execution_time/schema/versions/v2027_02_28.py","lines":["@@ -26,9 +26,10 @@"," "," from __future__ import annotations"," ","-from cadwyn import VersionChange, schema","+from cadwyn import RequestInfo, VersionChange, convert_request_to_next_version_for, schema"," ","-from airflow.sdk.api.datamodels._generated import TIRunContext","+from airflow.sdk.api.datamodels._generated import TIRunContext, VariableResponse","+from airflow.sdk.execution_time.comms import PutVariable"," "," "," class AddExecutionTimeoutToSupervisorTIRunContext(VersionChange):","@@ -44,3 +45,27 @@ class AddExecutionTimeoutToSupervisorTIRunContext(VersionChange):","     instructions_to_migrate_to_previous_version = (","         schema(TIRunContext).field(\"execution_timeout\").didnt_exist,","     )","+","+","+class MakeSupervisorVariableValueNonNullable(VersionChange):","+    \"\"\"","+    Make the Variable value non-nullable in ``VariableResult`` and ``PutVariable``.","+","+    The supervisor-schema mirror of the execution API's ``MakeVariableValueNonNullable``,","+    named apart so the two migrations are not confused.","+    \"\"\"","+","+    description = __doc__","+","+    instructions_to_migrate_to_previous_version = (","+        # VariableResult (and TIRunContext.variables) inherit the field from the generated","+        # VariableResponse, and Cadwyn only changes a field on the class that declares it.","+        schema(VariableResponse).field(\"value\").had(type=str | None),","+        schema(PutVariable).field(\"value\").had(type=str | None),","+    )","+","+    @convert_request_to_next_version_for(PutVariabl