ng $collectionId, string $documen"," ","         $permissions = Permission::aggregate($permissions, $allowedPermissions);"," ","+        // Whether the caller supplied permissions. Inherited permissions (from an existing","+        // document) may legitimately name roles the caller does not hold, so the grant","+        // role-check below must run only on supplied permissions — matching Update.","+        $callerProvidedPermissions = !\\is_null($permissions);","+","         $collectionTableId = 'database_' . $database->getSequence() . '_collection_' . $collection->getSequence();"," ","         // If no permission, upsert permission from the old document if present (update scenario) else add default permission (create scenario)","@@ -175,7 +180,7 @@ public function action(string $databaseId, string $collectionId, string $documen"," ","         // Users can only manage their own roles, API keys and Admin users can manage any","         $roles = $authorization->getRoles();","-        if (!$isAPIKey && !$isPrivilegedUser && !\\is_null($permissions)) {","+        if (!$isAPIKey && !$isPrivilegedUser && $callerProvidedPermissions) {","             foreach ([PermissionType::Read, PermissionType::Create, PermissionType::Update, PermissionType::Delete] as $type) {","                 foreach ($permissions as $permission) {","                     $permission = Permission::parse($permission);"],"additions":6,"deletions":1,"truncated":false},{"path":"tests/e2e/Services/Databases/DatabasesBase.php","lines":["@@ -1500,6 +1500,174 @@ public function testDisableCollection(): void","         $this->assertTrue($response['body']['enabled']);","     }"," ","+    /**","+     * Regression: increment/decrement must honor the collection `enabled` flag like every","+     * other document action. Before the fix these two endpoints skipped the enabled gate,","+     * so a client session kept mutating numeric attributes in a disabled collection.","+     */","+    public function testDisabledCollectionBlocksIncrement(): void","+    {","+        if ($this->getSide() !== 'client') {","+            $this->markTestSkipped('The enabled gate only applies to non-privileged (client) callers');","+        }","+","+        $databaseId = $this->setupDatabase()['databaseId'];","+","+        // A self-contained collection the acting client user can create and update in.","+        $collection = $this->client->call(Client::METHOD_POST, $this->getContainerUrl($databaseId), [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $this->getProject()['apiKey'],","+        ], [","+            $this->getContainerIdParam() => Id::unique(),","+            'name' => 'Counters',","+            'permissions' => [","+                Permission::create(Role::users()),","+                Permission::read(Role::users()),","+            ],","+            $this->getSecurityParam() => true,","+        ]);","+        $this->assertEquals(201, $collection['headers']['status-code']);","+        $collectionId = $collection['body']['$id'];","+","+        if ($this->getSupportForAttributes()) {","+            $attribute = $this->createAttribute($databaseId, $collectionId, 'integer', [","+                'key' => 'count',","+                'required' => false,","+            ]);","+            $this->assertEquals(202, $attribute['headers']['status-code']);","+            $this->waitForAllAttributes($databaseId, $collectionId);","+        }","+","+        // Create a document while the collection is enabled, owned by the acting user.","+        $document = $this->client->call(Client::METHOD_POST, $this->getRecordUrl($databaseId, $collectionId), array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()), [","+            $this->getRecordIdParam() => Id::unique(),","+            'data' => [","+                'count' => 1,","+            ],","+            'permissions' => [","+                Permission::read(Role::user($this->getUser()['$id'])),","+                Permission::update(Role::user($this->getUser()['$id'])),","+                Permission::delete(Role::user($this->getUser()['$id'])),","+            ],","+        ]);","+        $this->assertEquals(201, $document['headers']['status-code']);","+        $documentId = $document['body']['$id'];","+","+        // Increment works while the collection is enabled.","+        $response = $this->client->call(Client::METHOD_PATCH, $this->getRecordUrl($databaseId, $collectionId, $documentId) . '/count/increment', array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()), ['value' => 1]);","+        $this->assertEquals(200, $response['headers']['status-code']);","+        $this->assertEquals(2, $response['body']['count']);","+","+        // Disable the collection (keep its permissions and document security intact).","+        $disable = $this->client->call(Client::METHOD_PUT, $this->getContainerUrl($databaseId, $collectionId), array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $this->getProject()['apiKey']","+        ]), [","+            'name' => 'Counters',","+            'permissions' => [","+                Permission::create(Role::users()),","+                Permission::read(Role::users()),","+            ],","+            'enabled' => false,","+            $this->getSecurityParam() => true,","+        ]);","+        $this->assertEquals(200, $disable['headers']['status-code']);","+        $this->assertFalse($disable['body']['enabled']);","+","+        // Test for FAILURE: increment and decrement must be refused on the disabled","+        // collection, exactly like create/update/delete/get (404).","+        $increment = $this->client->call(Client::METHOD_PATCH, $this->getRecordUrl($databaseId, $collectionId, $documentId) . '/count/increment', array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()), ['value' => 1]);","+        $this->assertEquals(404, $increment['headers']['status-code']);","+","+        $decrement = $this->client->call(Client::METHOD_PATCH, $this->getRecordUrl($databaseId, $collectionId, $documentId) . '/count/decrement', array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()), ['value' => 1]);","+        $this->assertEquals(404, $decrement['headers']['status-code']);","+    }","+","+    /**","+     * Regression: upsert must only role-check permissions the caller **supplied**, not","+     * permissions **inherited** from the existing document (parity with update). Before the","+     * fix, a non-privileged user with update permission upserting a shared document whose","+     * stored permissions named roles they do not hold was refused (USER_UNAUTHORIZED), even","+     * when they sent no permissions of their own.","+     */","+    public function testUpsertDoesNotRevalidateInheritedPermissions(): void","+    {","+        if ($this->getSide() !== 'client') {","+            $this->markTestSkipped('The caller-role check only applies to non-privileged (client) callers');","+        }","+","+        $databaseId = $this->setupDatabase()['databaseId'];","+        $userId = $this->getUser()['$id'];","+        $otherId = 'other' . \\uniqid();","+","+        // Collection with document-level security so the document's own permissions govern.","+        $collection = $this->client->call(Client::METHOD_POST, $this->getContainerUrl($databaseId), [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $this->getProject()['apiKey'],","+        ], [","+            $this->getContainerIdParam() => Id::unique(),","+            'name' => 'Shared',","+            'permissions' => [Permission::create(Role::users())],","+            $this->getSecurityParam() => true,","+        ]);","+        $this->assertEquals(201, $collection['headers']['status-code']);","+        $collectionId = $collection['body']['$id'];","+","+        if ($this->getSupportForAttributes()) {","+            $attribute = $this->createAttribute($databaseId, $collectionId, 'string', [","+                'key' => 'title',","+                'size' => 64,","+                'required' => false,","+            ]);","+            $this->assertEquals(202, $attribute['headers']['status-code']);","+            $this->waitForAllAttributes($databaseId, $collectionId);","+        }","+","+        // Create the document with the privileged key so it can carry roles the acting user","+        // does not hold: the user may update it, but its read/delete name someone else.","+        $documentId = Id::unique();","+        $created = $this->client->call(Client::METHOD_POST, $this->getRecordUrl($databaseId, $collectionId), [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $this->getProject()['apiKey'],","+        ], [","+            $this->getRecordIdParam() => $documentId,","+            'data' => ['title' => 'v1'],","+            'permissions' => [","+                Permission::read(Role::user($otherId)),","+                Permission::update(Role::user($userId)),","+                Permission::delete(Role::user($otherId)),","+            ],","+        ]);","+        $this->assertEquals(201, $created['headers']['status-code']);","+","+        // The acting user upserts (PUT) without supplying permissions. The inherited","+        // read/delete(other) must NOT be re-checked against the caller's roles.","+        $upsert = $this->client->call(Client::METHOD_PUT, $this->getRecordUrl($databaseId, $collectionId, $documentId), array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()), [","+            'data' => ['title' => 'v2'],","+        ]);","+        $this->assertEquals(200, $upsert['headers']['status-code']);","+        $this->assertEquals('v2', $upsert['body']['title']);","+    }","+","     public function testCreateAttributes(): void","     {","         if (!$this->getSupportForAttributes()) {"],"additions":168,"deletions":0,"truncated":false},{"path":"tests/e2e/Services/Databases/Embeddings/GuestEmbeddingsTest.php","lines":["@@ -0,0 +1,37 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Tests\\E2E\\Services\\Databases\\Embeddings;","+","+use Tests\\E2E\\Client;","+use Tests\\E2E\\Scopes\\ProjectCustom;","+use Tests\\E2E\\Scopes\\Scope;","+use Tests\\E2E\\Scopes\\SideClient;","+","+/**","+ * Regression: embeddings generation is paid/backed compute with no per-resource","+ * permission gate, so an unauthenticated (guest) caller must not reach it. Before","+ * the fix the guests role held `embeddings.write`, letting anyone who knew a public","+ * project ID burn the embedding backend. The scope check runs in the init hook, so","+ * the refusal happens before any backend call.","+ */","+final class GuestEmbeddingsTest extends Scope","+{","+    use ProjectCustom;","+    use SideClient;","+","+    public function testGuestCannotGenerateEmbeddings(): void","+    {","+        // No session, no key: a pure guest request.","+        $response = $this->client->call(Client::METHOD_POST, '/embeddings/text', [","+            'origin' => 'http://localhost',","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], [","+            'texts' => ['regression check'],","+        ]);","+","+        $this->assertEquals(401, $response['headers']['status-code']);","+    }","+}",""],"additions":37,"deletions":0,"truncated":false}],"additions":231,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-22T13:45:28.841570+00:00"}