viders/provider_test_utils.h\""," #include \"test/providers/cpu/activation/activation_op_test.h\"","+#include <cmath>"," #include <random>","+#include <type_traits>"," #include <test/util/include/default_providers.h>"," "," #if defined(USE_DNNL)","@@ -168,5 +170,62 @@ TEST_F(ActivationOpTest, QuickGelu) {","   }"," }"," ","+#if defined(USE_CUDA)","+template <typename T>","+static void CheckCudaQuickGeluPrecision() {","+  if (!DefaultCudaExecutionProvider()) GTEST_SKIP() << \"CUDA EP unavailable\";","+  for (float alpha : {1.0f, 1.702f, -1.702f, 0.0f}) {","+    SCOPED_TRACE(alpha);","+    std::vector<T> input;","+    std::vector<T> expected;","+    // Include float exp's subnormal/underflow region while the fused product is representable.","+    for (float value : {-128.0f, -108.0f, -104.0f, -100.0f, -96.0f, -88.0f, -87.5f, -87.0f,","+                        -80.0f, -64.0f, -60.0f, -52.0f, -32.0f, -24.0f, -20.0f, -16.0f, -12.0f, -8.0f, -4.0f,","+                        -1.0f, -0.125f, 0.0f, 0.125f, 1.0f, 4.0f, 8.0f,","+                        12.0f, 16.0f, 20.0f, 24.0f, 32.0f, 52.0f, 60.0f, 64.0f, 80.0f,","+                        87.0f, 87.5f, 88.0f, 96.0f, 100.0f, 104.0f, 108.0f, 128.0f}) {","+      input.emplace_back(value);","+      const double scaled = static_cast<double>(value) * static_cast<double>(alpha);","+      const double exponent = std::exp(-std::abs(scaled));","+      const double sigmoid = scaled >= 0 ? 1.0 / (1.0 + exponent) : exponent / (1.0 + exponent);","+      const double result = static_cast<double>(value) * sigmoid;","+      if constexpr (std::is_same_v<T, double>) {","+        expected.emplace_back(result);","+      } else {","+        expected.emplace_back(static_cast<float>(result));","+      }","+    }","+    OpTester tester(\"QuickGelu\", 1, kMSDomain);","+    tester.AddAttribute(\"alpha\", alpha);","+    const std::vector<int64_t> dimensions{static_cast<int64_t>(input.size())};","+    tester.AddInput<T>(\"X\", dimensions, input);","+    tester.AddOutput<T>(\"Y\", dimensions, expected);","+    tester.SetOutputAbsErr(\"Y\", 0.0f);","+    tester.SetOutputRelErr(\"Y\", std::is_same_v<T, double> ? 2e-14f : 2e-6f);","+    SessionOptions options;","+    ORT_THROW_IF_ERROR(options.config_options.AddConfigEntry(\"session.disable_cpu_ep_fallback\", \"1\"));","+    std::vector<std::unique_ptr<IExecutionProvider>> providers;","+    providers.push_back(DefaultCudaExecutionProvider());","+    tester.Run(options, OpTester::ExpectResult::kExpectSuccess, \"\", {}, nullptr, &providers);","+  }","+}","+","+TEST_F(ActivationOpTest, CudaQuickGeluFloatPrecision) {","+  CheckCudaQuickGeluPrecision<float>();","+}","+","+TEST_F(ActivationOpTest, CudaQuickGeluDoublePrecision) {","+  CheckCudaQuickGeluPrecision<double>();","+}","+","+TEST_F(ActivationOpTest, CudaQuickGeluFloat16Precision) {","+  CheckCudaQuickGeluPrecision<MLFloat16>();","+}","+","+TEST_F(ActivationOpTest, CudaQuickGeluBFloat16Precision) {","+  CheckCudaQuickGeluPrecision<BFloat16>();","+}","+#endif","+"," }  // namespace test"," }  // namespace onnxruntime"],"additions":59,"deletions":0,"truncated":false},{"path":"onnxruntime/test/contrib_ops/moe_test.cc","lines":["@@ -147,6 +147,115 @@ static void RunMoETest(const std::vector<float>& input, const std::vector<float>"," "," // TODO(wy): Add python parity tests that can serve as examples. Need cutlass upgrade to build cutlass extensions to"," // add weights preprocesser to onnxruntime_pybind_quant.cc","+template <typename ElementType>","+static void RunCudaReluSquaredMoETest(int minimum_cuda_arch, int expert_weight_bits = 0) {","+  if (!HasCudaEnvironment(minimum_cuda_arch)) {","+    GTEST_SKIP() << \"CUDA architecture does not support the test element type\";","+  }","+","+  constexpr int num_rows = 2;","+  constexpr int num_experts = 2;","+  constexpr int hidden_size = 128;","+  constexpr int inter_size = 128;","+  std::vector<ElementType> input(num_rows * hidden_size);","+  std::vector<ElementType> expected(input.size());","+  std::vector<ElementType> fc1(num_experts * inter_size * hidden_size, ElementType(0.0f));","+  std::vector<ElementType> fc2(num_experts * hidden_size * inter_size, ElementType(0.0f));","+  std::vector<ElementType> fc1_bias(num_experts * inter_size);","+  std::vector<ElementType> fc2_bias(num_experts * hidden_size);","+","+  for (int expert = 0; expert < num_experts; ++expert) {","+    for (int channel = 0; channel < hidden_size; ++channel) {","+      const int diagonal = expert * hidden_size * inter_size + channel * hidden_size + channel;","+      fc1[diagonal] = ElementType(static_cast<float>(expert + 1));","+      fc2[diagonal] = ElementType(1.0f);","+      fc1_bias[expert * inter_size + channel] = ElementType(expert == 0 ? 0.5f : -0.5f);","+      fc2_bias[expert * hidden_size + channel] = ElementType(expert == 0 ? 0.25f : -0.25f);","+    }","+  }","+  for (int row = 0; row < num_rows; ++row) {","+    for (int channel = 0; channel < hidden_size; ++channel) {","+      const float value = static_cast<float>((channel + row) % 8 - 3) * 0.5f;","+      input[row * hidden_size + channel] = ElementType(value);","+      const float first = std::max(0.0f, value + 0.5f);","+      const float second = std::max(0.0f, 2.0f * value - 0.5f);","+      expected[row * hidden_size + channel] = ElementType(0.5f * (first * first + second * second));","+    }","+  }","+","+  OpTester tester(expert_weight_bits == 0 ? \"MoE\" : \"QMoE\", 1, onnxruntime::kMSDomain);","+  tester.AddAttribute<int64_t>(\"k\", 2);","+  tester.AddAttribute<std::string>(\"activation_type\", \"relu2\");","+  tester.AddAttribute<int64_t>(\"normalize_routing_weights\", 1);","+  tester.AddInput<ElementType>(\"input\", {num_rows, hidden_size}, input);","+  tester.AddInput<ElementType>(\"router_probs\", {num_rows, num_experts},","+                               std::vector<ElementType>(num_rows * num_experts, ElementType(0.5f)));","+  if (expert_weight_bits == 0) {","+    tester.AddInput<ElementType>(\"fc1_experts_weights\", {num_experts, inter_size, hidden_size}, fc1);","+    tester.AddInput<ElementType>(\"fc1_experts_bias\", {num_experts, inter_size}, fc1_bias);","+    tester.AddInput<ElementType>(\"fc2_experts_weights\", {num_experts, hidden_size, inter_size}, fc2);","+    tester.AddInput<ElementType>(\"fc2_experts_bias\", {num_experts, hidden_size}, fc2_bias);","+  } else {","+    ASSERT_TRUE(expert_weight_bits == 4 || expert_weight_bits == 8);","+    const int pack_size = 8 / expert_weight_bits;","+    const int zero_point = 1 << (expert_weight_bits - 1);","+    const uint8_t packed_zero = expert_weight_bits == 4 ? 0x88 : 0x80;","+    std::vector<uint8_t> quantized_fc1(num_experts * hidden_size * inter_size / pack_size, packed_zero);","+    std::vector<uint8_t> quantized_fc2(quantized_fc1.size(), packed_zero);","+    for (int expert = 0; expert < num_experts; ++expert) {","+      for (int channel = 0; channel < hidden_size; ++channel) {","+        const int diagonal = expert * hidden_size * inter_size / pack_size +","+                             channel * inter_size / pack_size + channel / pack_size;","+        const int shift = (channel % pack_size) * expert_weight_bits;","+        const uint8_t mask = static_cast<uint8_t>(((1 << expert_weight_bits) - 1) << shift);"],"additions":61,"deletions":0,"truncated":false}],"additions":248,"deletions":59,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-10-15T13:23:43.263156+00:00"}