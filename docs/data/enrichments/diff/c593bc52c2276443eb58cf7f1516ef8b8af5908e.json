nt check mode requires storage version v2.0.0 or higher.\",","+      \"paths\": [","+        \"test/optimizer/remove_redundant_order_keys_deferred.test\"","+      ]","+    },","     {","       \"reason\": \"The AT clause is only serialized with storage version v2.0.0 or higher.\",","       \"paths\": ["],"additions":6,"deletions":0,"truncated":false},{"path":"test/issues/general/test_26957.test","lines":["@@ -0,0 +1,69 @@","+# name: test/issues/general/test_26957.test","+# description: Statistics propagation skips functions over a parameter invalidated by filter pushdown","+# group: [general]","+","+statement ok","+CREATE TABLE table1 (id INTEGER, vec FLOAT[3]);","+","+statement ok","+PREPARE myquery AS SELECT id FROM table1 WHERE array_cosine_distance(vec, ?::FLOAT[3]) <= ?;","+","+query I","+EXECUTE myquery('[1.1, 2.1, 3.1]', 0.01);","+----","+","+statement ok","+INSERT INTO table1 VALUES (1, [1.1, 2.1, 3.1]), (2, [3, 2, 1]), (3, NULL);","+","+query I","+EXECUTE myquery('[1.1, 2.1, 3.1]', 0.01);","+----","+1","+","+query I","+EXECUTE myquery('[3, 2, 1]', 0.01);","+----","+2","+","+query I","+EXECUTE myquery(NULL, 0.01);","+----","+","+statement error","+EXECUTE myquery('[1, 2]', 0.01);","+----","+the size of the array must match the destination type","+","+statement error","+EXECUTE myquery('[1, NULL, 3]', 0.01);","+----","+right argument can not contain NULL values","+","+query I","+EXECUTE myquery('[1.1, 2.1, 3.1]', 0.01);","+----","+1","+","+statement ok","+PREPARE distance AS SELECT list(id ORDER BY id) FROM table1 WHERE array_distance($1::FLOAT[3], vec) < 1;","+","+query I","+EXECUTE distance([3, 2, 1]);","+----","+[2]","+","+statement ok","+PREPARE inner_product AS SELECT list(id ORDER BY id) FROM table1 WHERE array_inner_product(vec, ?::FLOAT[3]) > 2;","+","+query I","+EXECUTE inner_product([1, 0, 0]);","+----","+[2]","+","+statement ok","+PREPARE extract AS SELECT list(id ORDER BY id) FROM table1 WHERE list_extract(?::INTEGER[], 1) = id;","+","+query I","+EXECUTE extract([2, 3]);","+----","+[2]"],"additions":69,"deletions":0,"truncated":false},{"path":"test/optimizer/bound_function_identity.cpp","lines":["@@ -187,7 +187,7 @@ TEST_CASE(\"Optimizer-introduced constant_or_null keeps its definition\", \"[optimi"," \tcon.BeginTransaction();"," \tauto functions = PlanIdentityFunctions(con, \"SELECT i * 0 FROM integers\");"," \tauto &fun = RequireIdentityFunction(functions, \"constant_or_null\");","-\t// the bind derives the return type from the leading constant","+\t// the return type is the type of the leading constant"," \tREQUIRE(fun.return_type == LogicalType::INTEGER);"," \tREQUIRE(fun.arguments.size() == 2);"," \tcon.Rollback();"],"additions":1,"deletions":1,"truncated":false},{"path":"test/optimizer/pushdown/volatile_filter_aggregate_distinct.test","lines":["@@ -0,0 +1,162 @@","+# name: test/optimizer/pushdown/volatile_filter_aggregate_distinct.test","+# description: Volatile filters do not move across GROUP BY or DISTINCT","+# group: [pushdown]","+","+statement ok","+CREATE TABLE agg(p INTEGER, x INTEGER);","+","+statement ok","+INSERT INTO agg VALUES (1, 10), (1, 20), (1, 30), (1, 40);","+","+statement ok","+CREATE SEQUENCE s1 START 1;","+","+query I","+SELECT SUM(x) FROM agg GROUP BY p HAVING nextval('s1') <= p + 1;","+----","+100","+","+query I","+SELECT currval('s1');","+----","+1","+","+statement ok","+INSERT INTO agg VALUES (2, 50), (2, 60), (3, 70), (3, 80);","+","+statement ok","+CREATE SEQUENCE s2 START 1;","+","+query I","+SELECT count(*) FROM (SELECT p FROM agg GROUP BY p HAVING nextval('s2') + p - p <= 2);","+----","+2","+","+query I","+SELECT currval('s2');","+----","+3","+","+statement ok","+CREATE TABLE dd(a INTEGER, b VARCHAR);","+","+statement ok","+INSERT INTO dd VALUES (1, 'x'), (1, 'x'), (2, 'y'), (2, 'y'), (3, 'z');","+","+statement ok","+CREATE SEQUENCE s4 START 1;","+","+query I","+SELECT count(*) FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s4') <= 2;","+----","+2","+","+query I","+SELECT currval('s4');","+----","+3","+","+statement ok","+CREATE SEQUENCE s5 START 1;","+","+query I","+SELECT count(*) FROM (SELECT DISTINCT a, b FROM dd) q WHERE nextval('s5') + a - a <= 2;","+----","+2","+","+statement ok","+CREATE SEQUENCE s6 START 1;","+","+query II","+SELECT count(*), min(a) FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s6') <= 2 AND a >= 2;","+----","+2\t2","+","+query I","+SELECT currval('s6');","+----","+2","+","+statement ok","+CREATE SEQUENCE s9 START 1;","+","+statement ok","+CREATE SEQUENCE s11 START 1;","+","+query I","+SELECT count(*) FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s9') > 0 AND nextval('s11') > 0 AND a >= 1;","+----","+3","+","+query II","+SELECT currval('s9'), currval('s11');","+----","+3\t3","+","+statement ok","+CREATE SEQUENCE s10 START 1;","+","+query I","+SELECT count(*) FROM (SELECT DISTINCT ON (a) a, b FROM dd) q WHERE nextval('s10') <= 2;","+----","+2","+","+query I","+SELECT currval('s10');","+----","+3","+","+statement ok","+CREATE SEQUENCE s7 START 1;","+","+query I","+SELECT count(*) FROM (SELECT a FROM dd UNION SELECT a FROM dd) q WHERE nextval('s7') <= 2;","+----","+2","+","+statement ok","+CREATE SEQUENCE s8 START 1;","+","+query I","+SELECT count(*) FROM (SELECT a FROM dd INTERSECT SELECT a FROM dd) q WHERE nextval('s8') <= 2;","+----","+2","+","+# filters that are not volatile are still pushed below the DISTINCT and the GROUP BY","+","+statement ok","+PRAGMA explain_output = OPTIMIZED_ONLY;","+","+query II","+EXPLAIN SELECT * FROM (SELECT DISTINCT a FROM dd) q WHERE nextval('s6') <= 9 AND a >= 2;","+----","+logical_opt\t<REGEX>:.*nextval.*Distinct.*Filters: a >= 2.*","+","+query II","+EXPLAIN SELECT p FROM agg GROUP BY p HAVING nextval('s1') <= 9 AND p >= 2;","+----","+logical_opt\t<REGEX>:.*nextval.*Aggregate.*Filters: p >= 2.*","+","+# a volatile filter inside a DISTINCT subquery stays below the DISTINCT when it is pulled up through a join","+","+statement ok","+CREATE TABLE halves AS SELECT 0.5::DOUBLE AS a FROM range(100);","+","+statement ok","+CREATE TABLE half AS SELECT 0.5::DOUBLE AS a;","+","+query II","+EXPLAIN SELECT count(*) FROM (SELECT DISTINCT a FROM halves WHERE random() < a) d JOIN half USING (a);","+----","+logical_opt\t<REGEX>:.*Distinct.*random\\(\\) < a.*","+","+statement ok","+SET threads = 1;","+","+statement ok","+SELECT setseed(0.42);","+","+query I","+SELECT count(*) FROM (SELECT DISTINCT a FROM halves WHERE random() < a) d JOIN half USING (a);","+----","+1"],"additions":162,"deletions":0,"truncated":false},{"path":"test/optimizer/remove_redundant_order_keys_deferred.test","lines":["@@ -0,0 +1,135 @@","+# name: test/optimizer/remove_redundant_order_keys_deferred.test","+# description: Deferred unique keys can hold duplicates until commit, so the keys behind them are kept (issue #26986)","+# group: [optimizer]","+","+statement ok","+CREATE TABLE pk(a INTEGER PRIMARY KEY DEFERRED, b INTEGER);","+","+statement ok","+CREATE TABLE uk(a INTEGER UNIQUE DEFERRED NOT NULL, b INTEGER);","+","+statement ok","+CREATE TABLE ck(a INTEGER, c INTEGER, b INTEGER, PRIMARY KEY (a, c) DEFERRED);","+","+statement ok","+CREATE TABLE immediate(a INTEGER PRIMARY KEY, b INTEGER);","+","+statement ok","+CREATE TABLE mixed(a INTEGER PRIMARY KEY DEFERRED, c INTEGER UNIQUE NOT NULL, b INTEGER);","+","+statement ok","+BEGIN TRANSACTION;","+","+statement ok","+INSERT INTO pk VALUES (1, 10), (1, 20);","+","+statement ok","+INSERT INTO uk VALUES (1, 10), (1, 20);","+","+statement ok","+INSERT INTO ck VALUES (1, 1, 10), (1, 1, 20);","+","+statement ok","+INSERT INTO mixed VALUES (1, 2, 10), (1, 1, 20);","+","+foreach table pk uk","+","+query II","+EXPLAIN SELECT b FROM {table} ORDER BY a, b DESC","+----","+physical_plan\t<REGEX>:.*b DESC.*","+","+query I","+SELECT b FROM {table} ORDER BY a, b DESC","+----","+20","+10","+","+query II","+SELECT b, rank() OVER (ORDER BY a, b DESC) AS r FROM {table} ORDER BY b","+----","+10\t2","+20\t1","+","+query II","+EXPLAIN SELECT b, row_number() OVER (PARTITION BY a, b) AS rn FROM {table} ORDER BY b","+----","+physical_plan\t<REGEX>:.*PARTITION BY a, b\\).*","+","+query II","+SELECT b, row_number() OVER (PARTITION BY a, b) AS rn FROM {table} ORDER BY b","+----","+10\t1","+20\t1","+","+# a second row with the same partition keys is numbered within the same partition","+statement ok","+INSERT INTO {table} VALUES (1, 10);","+","+query II","+SELECT b, row_number() OVER (PARTITION BY a, b) AS rn FROM {table} ORDER BY b, rn","+----","+10\t1","+10\t2","+20\t1","+","+endloop","+","+query I","+SELECT b FROM ck ORDER BY a, c, b DESC","+----","+20","+10","+","+query II","+EXPLAIN SELECT b, row_number() OVER (PARTITION BY a, c, b) AS rn FROM ck ORDER BY b","+----","+physical_plan\t<REGEX>:.*PARTITION BY a, c, b\\).*","+","+query II","+SELECT b, row_number() OVER (PARTITION BY a, c, b) AS rn FROM ck ORDER BY b","+----","+10\t1","+20\t1","+","+statement ok","+INSERT INTO ck VALUES (1, 1, 10);","+","+query II","+SELECT b, row_number() OVER (PARTITION BY a, c, b) AS rn FROM ck ORDER BY b, rn","+----","+10\t1","+10\t2","+20\t1","+","+# an immediate primary key still erases the keys behind it","+query II","+EXPLAIN SELECT b FROM immediate ORDER BY a, b DESC","+----","+physical_plan\t<!REGEX>:.*b DESC.*","+","+# in a table with both, only the immediate key erases the keys behind it","+query II","+EXPLAIN SELECT b FROM mixed ORDER BY a, b DESC","+----","+physical_plan\t<REGEX>:.*b DESC.*","+","+query I","+SELECT b FROM mixed ORDER BY a, b DESC","+----","+20","+10","+","+query II","+EXPLAIN SELECT b FROM mixed ORDER BY c, b DESC","+----","+physical_plan\t<!REGEX>:.*b DESC.*","+","+query I","+SELECT b FROM mixed ORDER BY c, b DESC","+----","+20","+10","+","+statement ok","+ROLLBACK"],"additions":135,"deletions":0,"truncated":false},{"path":"test/optimizer/statistics/statistics_all_null_comparison.test","lines":["@@ -0,0 +1,121 @@","+# name: test/optimizer/statistics/statistics_all_null_comparison.test","+# description: A comparison that statistics prove TRUE or NULL, with an operand that folds to NULL over a column that is NULL in every row","+# group: [statistics]","+","+require parquet","+","+statement ok","+CREATE TABLE products(version VARCHAR);","+","+statement ok","+INSERT INTO products VALUES (NULL), (NULL), (NULL);","+","+statement ok","+CREATE TABLE ints(i INTEGER);","+","+statement ok","+INSERT INTO ints VALUES (NULL), (NULL);","+","+statement ok","+CREATE TABLE other(x VARCHAR);","+","+statement ok","+INSERT INTO other VALUES ('1'), ('2');","+","+statement ok","+COPY products TO '{TEST_DIR}/all_null_products.parquet';","+","+# a condition that is always NULL keeps no row, so the scan is replaced by an empty result","+statement ok","+SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};","+","+statement ok","+PRAGMA explain_output = 'physical_only';","+","+query II","+EXPLAIN SELECT count(*) FROM products WHERE split_part(version, '.', 1) <> '0';","+----","+physical_plan\t<REGEX>:.*EMPTY_RESULT.*","+","+query II","+EXPLAIN SELECT count(*) FROM products WHERE (CASE WHEN version IS NOT NULL THEN 'a' END) <> '0';","+----","+physical_plan\t<REGEX>:.*EMPTY_RESULT.*","+","+query I","+SELECT count(*) FROM products WHERE split_part(version, '.', 1) <> '0';","+----","+0","+","+query I","+SELECT count(*) FROM products WHERE (CASE WHEN version IS NOT NULL THEN 'a' END) <> '0';","+----","+0","+","+query I","+SELECT count(*) FROM products WHERE split_part(version, '.', 1) = '0';","+----","+0","+","+query I","+SELECT count(*) FROM products WHERE split_part(version, '.', 1) < '0';","+----","+0","+","+query I","+SELECT count(*) FROM ints WHERE (CASE WHEN i IS NOT NULL THEN 1 END) <> 0;","+----","+0","+","+query I","+SELECT count(*) FROM '{TEST_DIR}/all_null_products.parquet' WHERE split_part(version, '.', 1) <> '0';","+----","+0","+","+# the comparison is NULL in a projection","+query I","+SELECT split_part(version, '.', 1) <> '0' FROM products;","+----","+NULL","+NULL","+NULL","+","+# the folded comparison is a BOOLEAN NULL, so it can be stored in a BOOLEAN column","+statement ok","+CREATE TABLE comparison_results AS SELECT split_part(version, '.', 1) <> '0' AS c FROM products;","+","+query III","+SELECT typeof(c), count(*), count(c) FROM comparison_results GROUP BY ALL;","+----","+BOOLEAN\t3\t0","+","+query I","+SELECT count(*) FROM (SELECT version FROM products GROUP BY version HAVING split_part(version, '.', 1) <> '0');","+----","+0","+","+# as a join condition","+query I","+SELECT count(*) FROM products p JOIN other o ON split_part(p.version, '.', 1) <> '0' OR o.x = 'z';"],"additions":99,"deletions":0,"truncated":false}],"additions":610,"deletions":42,"truncated":true,"file_count":19},"error":null,"fetched_at":"2026-10-26T14:32:41.727250+00:00"}