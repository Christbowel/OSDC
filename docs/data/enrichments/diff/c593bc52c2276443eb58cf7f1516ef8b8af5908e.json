    \"AS name, (i % 10 = 0)::TINYINT AS flag FROM range(6000) t(i)\")","+\t             ->HasError());","+\t// with a string view column the filters stay above the scan, which also returns the columns they read. The test","+\t// factory returns every column and ignores pushed down filters, so each query reads both columns.","+\tduckdb::vector<string> queries {","+\t    \"SELECT name, count(*) FROM %s WHERE flag < 1 AND name IN ('VPG', 'ISUZU', 'SMART', 'LUCID', 'LOTUS') \"","+\t    \"GROUP BY 1 ORDER BY 1\",","+\t    \"SELECT name, flag, count(*) FROM %s WHERE flag < 1 AND name IN ('VPG', 'ISUZU', 'SMART', 'LUCID', 'LOTUS') \"","+\t    \"GROUP BY ALL ORDER BY ALL\",","+\t    \"SELECT * FROM %s WHERE flag < 1 AND name IN ('VPG', 'ISUZU', 'SMART', 'LUCID', 'LOTUS') ORDER BY ALL LIMIT 3\"};","+\t// without unused_columns, a scan of every column has an empty projection list","+\tfor (auto disabled_optimizers : {\"\", \"unused_columns\"}) {","+\t\tREQUIRE(!con.Query(StringUtil::Format(\"SET disabled_optimizers = '%s'\", disabled_optimizers))->HasError());","+\t\tfor (auto &query : queries) {","+\t\t\tINFO(query << \" without \" << disabled_optimizers);","+\t\t\tauto factory = MakeArrowFactory(con, \"SELECT * FROM src\", true);","+\t\t\tcon.TableFunction(\"arrow_scan\", {}, {}, ArrowTestHelper::ConstructArrowScan(*factory))","+\t\t\t    ->CreateView(\"data\", true, true);","+\t\t\tauto result = con.Query(StringUtil::Format(query, \"data\"));","+\t\t\tREQUIRE(!result->HasError());","+\t\t\tauto expected = con.Query(StringUtil::Format(query, \"src\"));","+\t\t\tREQUIRE(!expected->HasError());","+\t\t\tREQUIRE(result->Equals(*expected));","+\t\t}","+\t}","+}","+"," // Hand-built Arrow columns that DuckDB's own Arrow export never produces, scanned through a factory that records"," // the filters the producer receives. The Arrow scan never re-applies a pushed filter, so a filter the producer"," // ignores shows up as extra rows."],"additions":31,"deletions":0,"truncated":false