_to_fp4"," ","     return per_token_cast_to_fp4(x, use_ue8m0=True, gran_k=32, use_packed_ue8m0=True)"," "," ","+def _quant_k(x: torch.Tensor, kv_dtype: str):","+    \"\"\"Quantize [N, D] rows as the indexer cache stores K.","+","+    Returns (values, packed UE8M0 scales [N] int32, dequantized fp32). MXFP4","+    packs D/2 bytes (viewed as int8) with one scale per 32 elements; FP8 is","+    e4m3 with one power-of-two scale per row, stored as four equal UE8M0","+    bytes (the SM100 FP8 indexer cache layout).\"\"\"","+    if kv_dtype == \"mxfp4\":","+        from vllm.third_party.deep_gemm.utils import cast_back_from_fp4","+","+        fp, sf = _quant_fp4(x)","+        deq = cast_back_from_fp4(fp, sf, gran_k=32, use_packed_ue8m0=True)","+        return fp.view(torch.int8), sf.view(-1), deq.float()","+    amax = x.float().abs().amax(dim=-1).clamp(min=1e-4)","+    exp = torch.ceil(torch.log2(amax / 448.0)).to(torch.int32)","+    scale = torch.exp2(exp.float())","+    values = (x.float() / scale[:, None]).to(torch.float8_e4m3fn)","+    ue8m0 = ((exp + 127).to(torch.int64) * 0x01010101).to(torch.int32)","+    return values, ue8m0, values.float() * scale[:, None]","+","+","+def _quant_q(x: torch.Tensor, kv_dtype: str):","+    \"\"\"Quantize [N, D] Q rows as the indexer passes them: MXFP4 like K, or","+    FP8 e4m3 with unit UE8M0 scales (FP8 Q folds its scale into the weights,","+    see ``mqa_logits_mx_inputs``).\"\"\"","+    if kv_dtype == \"mxfp4\":","+        return _quant_k(x, kv_dtype)","+    values = x.to(torch.float8_e4m3fn)","+    unit = torch.full((x.shape[0],), 0x7F7F7F7F, dtype=torch.int32, device=x.device)","+    return values, unit, values.float()","+","+","+@pytest.mark.parametrize(\"kv_dtype\", [\"mxfp4\", \"fp8\"])"," @pytest.mark.parametrize(\"capture\", [False, True])","-def test_sparse_mqa_logits_prefill_matches_dense_masked(capture: bool):","+def test_sparse_mqa_logits_prefill_matches_dense_masked(capture: bool, kv_dtype: str):","     \"\"\"The sparse-