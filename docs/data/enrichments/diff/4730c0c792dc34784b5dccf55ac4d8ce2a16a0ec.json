\t// flush-then-delete our created chains","-\t\t// these sometimes fail due to \"Device or resource busy\" or because they are optional given the iptables cfg","+\t}","+\t// Flush, then delete, our created chains. These sometimes fail due to","+\t// \"Device or resource busy\" or because they are optional given the iptables config.","+\tdeleteFlushCmds := [][]string{"," \t\t{\"-t\", \"mangle\", \"-F\", ChainInpodPrerouting},"," \t\t{\"-t\", \"mangle\", \"-F\", ChainInpodOutput},"," \t\t{\"-t\", \"nat\", \"-F\", ChainInpodPrerouting},"," \t\t{\"-t\", \"nat\", \"-F\", ChainInpodOutput},"," \t\t{\"-t\", \"raw\", \"-F\", ChainInpodPrerouting},"," \t\t{\"-t\", \"raw\", \"-F\", ChainInpodOutput},","+\t}","+","+\tdeleteCmds := [][]string{"," \t\t{\"-t\", \"mangle\", \"-X\", ChainInpodPrerouting},"," \t\t{\"-t\", \"mangle\", \"-X\", ChainInpodOutput},"," \t\t{\"-t\", \"nat\", \"-X\", ChainInpodPrerouting},","@@ -149,15 +157,30 @@ func (cfg *IptablesConfigurator) executeDeleteCommands(log *istiolog.Scope) {"," \t\t{\"-t\", \"raw\", \"-X\", ChainInpodOutput},"," \t}"," ","+\t// Usually, ISTIO_POSTRT exists only on the host netns, but in Kata, we also place it in the pod netns, so we need to delete it there too.","+\tif kata {","+\t\tdeleteJumpsCmds = append(deleteJumpsCmds,","+\t\t\t[]string{\"-t\", \"nat\", \"-D\", \"POSTROUTING\", \"-j\", ChainHostPostrouting},","+\t\t)","+\t\tdeleteFlushCmds = append(deleteFlushCmds,","+\t\t\t[]string{\"-t\", \"nat\", \"-F\", ChainHostPostrouting},","+\t\t)","+\t\tdeleteCmds = append(deleteCmds,","+\t\t\t[]string{\"-t\", \"nat\", \"-X\", ChainHostPostrouting},","+\t\t)","+\t}","+"," \tiptablesVariant := []dep.IptablesVersion{}"," \tiptablesVariant = append(iptablesVariant, cfg.iptV)"," ","-\tif cfg.cfg.EnableIPv6 {","+\tif cfg.cfg.EnableIPv6 && !kata {"," \t\tiptablesVariant = append(iptablesVariant, cfg.ipt6V)"," \t}"," ","+\tcmds := append(deleteJumpsCmds, append(deleteFlushCmds, deleteCmds...)...)","+"," \tfor _, iptVer := range iptablesVariant {","-\t\tfor _, cmd := range deleteCmds {","+\t\tfor _, cmd := range cmds {"," \t\t\t_, _ = cfg.ext.Run(log, true, iptablesconstants.IPTables, &iptVer, nil, cmd...)"," \t\t}"," \t}","@@ -166,6 +189,11 @@ func (cfg *IptablesConfigurator) executeDeleteCommands(log *istiolog.Scope) {"," // Setup iptables rules for in-pod mode. Ideally this should be an idempotent function."," // NOTE that this expects to be run from within the pod network namespace!"," func (cfg *IptablesConfigurator) CreateInpodRules(log *istiolog.Scope, podOverrides config.PodLevelOverrides) error {","+\t// Kata pods take a completely separate path -- see iptables_kata.go.","+\tif podOverrides.Kata {","+\t\treturn cfg.createInpodRulesKata(log, podOverrides)","+\t}","+"," \t// Append our rules here"," \tbuilder := cfg.AppendInpodRules(podOverrides)"," "],"additions":36,"deletions":8,"truncated":false},{"path":"cni/pkg/iptables/iptables_e2e_linux_test.go","lines":["@@ -60,7 +60,7 @@ func TestIdempotentEquivalentInPodRerun(t *testing.T) {"," \t\t\t\tt.Fatalf(\"failed to setup iptables configurator: %v\", err)"," \t\t\t}"," \t\t\tdefer func() {","-\t\t\t\tassert.NoError(t, iptConfiguratorPod.DeleteInpodRules(log))","+\t\t\t\tassert.NoError(t, iptConfiguratorPod.DeleteInpodRules(log, tt.podOverrides))"," \t\t\t\tresidueExists, deltaExists := iptablescapture.VerifyIptablesState(log, iptConfiguratorPod.ext, builder, &iptConfiguratorPod.iptV, &iptConfiguratorPod.ipt6V)"," \t\t\t\tassert.Equal(t, residueExists, false)"," \t\t\t\tassert.Equal(t, deltaExists, true)","@@ -72,7 +72,7 @@ func TestIdempotentEquivalentInPodRerun(t *testing.T) {"," "," \t\t\tt.Log(\"Starting cleanup\")"," \t\t\t// Cleanup, should work","-\t\t\tassert.NoError(t, iptConfiguratorPod.DeleteInpodRules(log))","+\t\t\tassert.NoError(t, iptConfiguratorPod.DeleteInpodRules(log, tt.podOverrides))"," \t\t\tresidueExists, deltaExists = iptablescapture.VerifyIptablesState(log, iptConfiguratorPod.ext, builder, &iptConfiguratorPod.iptV, &iptConfiguratorPod.ipt6V)"," \t\t\tassert.Equal(t, residueExists, false)"," \t\t\tassert.Equal(t, deltaExists, true)","@@ -108,7 +108,7 @@ func TestIdempotentUnequalInPodRerun(t *testing.T) {"," \t\t\t}"," "," \t\t\tdefer func() {","-\t\t\t\tassert.NoError(t, iptConfiguratorPod.DeleteInpodRules(log))","+\t\t\t\tassert.NoError(t, iptConfiguratorPod.DeleteInpodRules(log, tt.podOverrides))"," \t\t\t\tresidueExists, deltaExists := iptablescapture.VerifyIptablesState(log, iptConfiguratorPod.ext, builder, &iptConfiguratorPod.iptV, &iptConfiguratorPod.ipt6V)"," \t\t\t\tassert.Equal(t, residueExists, true)"," \t\t\t\tassert.Equal(t, deltaExists, true)"],"additions":3,"deletions":3,"truncated":false},{"path":"cni/pkg/iptables/iptables_kata.go","lines":["@@ -0,0 +1,370 @@","+//go:build linux","+","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//\thttp://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+package iptables","+","+import (","+\t\"fmt\"","+\t\"net/netip\"","+\t\"strings\"","+","+\t\"github.com/vishvananda/netlink\"","+\t\"golang.org/x/sys/unix\"","+","+\t\"istio.io/istio/cni/pkg/config\"","+\tistiolog \"istio.io/istio/pkg/log\"","+\t\"istio.io/istio/tools/istio-iptables/pkg/builder\"","+)","+","+const kataTapIface = \"tap0_kata\"","+","+type kataInpodConfig struct {","+\tpodGatewayV4 netip.Addr","+\tpodInterface string","+\tpodIPv4      []netip.Addr","+}","+","+// createInpodRulesKata is the kata-mode counterpart to","+// (*IptablesConfigurator).CreateInpodRules. It runs inside the pod netns.","+func (cfg *IptablesConfigurator) createInpodRulesKata(log *istiolog.Scope, podOverrides config.PodLevelOverrides) error {","+\tif len(podOverrides.VirtualInterfaces) > 0 {","+\t\treturn fmt.Errorf(\"kata mode does not support virtual interfaces: %v\", podOverrides.VirtualInterfaces)","+\t}","+","+\t// Capture the CNI-provided default gateway to SNAT kubelet probe traffic so replies","+\t// from the guest return through the pod network namespace.","+\tgatewayV4, _, podInterface := discoverDefaultGateway()","+\tif gatewayV4.IsUnspecified() {","+\t\treturn fmt.Errorf(\"kata mode requires a default gateway for probe SNAT\")","+\t}","+\tif podInterface == \"\" {","+\t\treturn fmt.Errorf(\"kata mode requires an interface for the default route\")","+\t}","+\tpodIPv4, podIPv6 := discoverPodIPs()","+\tif len(podIPv6) > 0 {","+\t\treturn fmt.Errorf(\"kata mode does not support IPv6 pod addresses: %v\", podIPv6)","+\t}","+\tkataCfg := kataInpodConfig{","+\t\tpodGatewayV4: gatewayV4,","+\t\tpodInterface: podInterface,","+\t\tpodIPv4:      podIPv4,","+\t}","+","+\tipv4Configurator := *cfg","+\tipv4Config := *cfg.cfg","+\tipv4Config.EnableIPv6 = false","+\tipv4Configurator.cfg = &ipv4Config","+","+\t// DNS interception requires DNATing VM-originated DNS queries to","+\t// 127.0.0.1:15053 (ztunnel's DNS proxy). The packet arrives on","+\t// tap0_kata with dst=kube-dns; route_localnet must be enabled for the","+\t// kernel to route loopback addresses on a non-loopback ingress iface.","+\tif err := writeSysctl(\"/proc/sys/net/ipv4/conf/all/route_localnet\", \"1\"); err != nil {","+\t\tlog.Warnf(\"kata mode: failed to enable route_localnet (DNS interception may fail): %v\", err)","+\t}","+","+\tb := ipv4Configurator.appendInpodRulesKata(podOverrides, kataCfg)","+","+\tif err := ipv4Configurator.addLoopbackRoute(); err != nil {","+\t\treturn err","+\t}","+\tif err := ipv4Configurator.addInpodMarkIPRule(); err != nil {","+\t\treturn err","+\t}","+","+\tlog.Debug(\"Adding iptables rules (kata mode)\")","+\tif err := ipv4Configurator.executeCommands(log, b); err != nil {","+\t\tlog.Errorf(\"failed to apply iptables rules: %v\", err)","+\t\treturn err","+\t}","+\treturn nil","+}","+","+// appendInpodRulesKata builds the complete in-pod iptables rule set for a","+// kata pod. This is a from-scratch replacement for AppendInpodRules.","+func (cfg *IptablesConfigurator) appendInpodRulesKata(","+\tpodOverrides config.PodLevelOverrides,","+\tkataCfg kataInpodConfig,","+) *builder.IptablesRuleBuilder {","+\tvar redirectDNS bool","+\tswitch podOverrides.DNSProxy {","+\tcase config.PodDNSUnset:","+\t\tredirectDNS = cfg.cfg.RedirectDNS","+\tcase config.PodDNSEnabled:","+\t\tredirectDNS = true","+\tcase config.PodDNSDisabled:","+\t\tredirectDNS = false","+\t}","+","+\t// The policy-routing rule for this mark sends traffic to the local","+\t// route in table 100.","+\tinpodTproxyMark := fmt.Sprintf(\"0x%x\", config.InpodTProxyMark) + \"/\" + fmt.Sprintf(\"0x%x\", config.InpodTProxyMask)","+","+\tinpodMark := fmt.Sprintf(\"0x%x\", config.InpodMark) + \"/\" + fmt.Sprintf(\"0x%x\", config.InpodMask)","+","+\tb := builder.NewIptablesRuleBuilder(config.GetConfig(cfg.cfg))","+","+\t// Top-level jumps into our custom chains.","+","+\tb.AppendRuleV4(\"PREROUTING\", \"mangle\", \"-j\", ChainInpodPrerouting)","+\tb.AppendRuleV4(\"OUTPUT\", \"mangle\", \"-j\", ChainInpodOutput)","+\tif redirectDNS {","+\t\tb.AppendRuleV4(\"PREROUTING\", \"raw\", \"-j\", ChainInpodPrerouting)","+\t\tb.AppendRuleV4(\"OUTPUT\", \"raw\", \"-j\", ChainInpodOutput)","+\t}","+\tb.AppendRuleV4(\"PREROUTING\", \"nat\", \"-j\", ChainInpodPrerouting)","+","+\t// Kubelet HTTP/TCP probes arrive at eth0 with src HostProbeSNATAddress","+\t// (a fixed link-local address set by the host-side Istio CNI rules).","+\t// They must continue to the guest through tap0_kata, so exclude them","+\t// from the local-routing mark applied below.","+\t// The matching POSTROUTING SNAT further down rewrites the source to","+\t// the CNI-provided gateway so the guest can route the reply back.","+\tb.AppendRuleV4(","+\t\tChainInpodPrerouting, \"mangle\",","+\t\t\"-s\", cfg.cfg.HostProbeSNATAddress.String(),","+\t\t\"-p\", \"tcp\",","+\t\t\"-j\", \"ACCEPT\",","+\t)","+\t// Mark TCP traffic entering on the default-route interface for local delivery to ztunnel.","+\t// The policy rule for 0x111 uses table 100, whose local default route","+\t// points to lo.","+\tb.AppendRuleV4(ChainInpodPrerouting, \"mangle\",","+\t\t\"-i\", kataCfg.podInterface,","+\t\t\"-p\", \"tcp\",","+\t\t\"-j\", \"MARK\",","+\t\t\"--set-xmark\", inpodTproxyMark,","+\t)","+","+\t// Replies for ztunnel-originated connections return from the guest on","+\t// tap0_kata. Match packets with a local socket so policy routing sends","+\t// them back to ztunnel rather than through normal forwarding.","+\tb.AppendRuleV4(ChainInpodPrerouting, \"mangle\",","+\t\t\"-p\", \"tcp\",","+\t\t\"-m\", \"socket\",","+\t\t\"-j\", \"MARK\",","+\t\t\"--set-xmark\", inpodTproxyMark,","+\t)","+","+\tif redirectDNS {","+\t\t// VM-originated TCP and UDP DNS: DNAT to 127.0.0.1:15053.","+\t\t// route_localnet=1 (set in createInpodRulesKata) is required.","+\t\tb.AppendRuleV4(ChainInpodPrerouting, \"nat\",","+\t\t\t\"-i\", kataTapIface,","+\t\t\t\"-p\", \"udp\",","+\t\t\t\"-m\", \"udp\",","+\t\t\t\"--dport\", \"53\",","+\t\t\t\"-j\", \"DNAT\",","+\t\t\t\"--to-destination\", fmt.Sprintf(\"127.0.0.1:%d\", config.DNSCapturePort),","+\t\t)","+\t\tb.AppendRuleV4(ChainInpodPrerouting, \"nat\",","+\t\t\t\"-i\", kataTapIface,","+\t\t\t\"-p\", \"tcp\",","+\t\t\t\"--dport\", \"53\",","+\t\t\t\"-j\", \"DNAT\",","+\t\t\t\"--to-destination\", fmt.Sprintf(\"127.0.0.1:%d\", config.DNSCapturePort),","+\t\t)","+\t\t// Mark UDP replies from the upstream DNS server so policy routing","+\t\t// delivers them to ztunnel's DNS proxy socket rather than forwarding","+\t\t// them through tap0_kata to the guest.","+\t\tb.AppendRuleV4(ChainInpodPrerouting, \"mangle\",","+\t\t\t\"-i\", kataCfg.podInterface,","+\t\t\t\"-p\", \"udp\",","+\t\t\t\"--sport\", \"53\",","+\t\t\t\"-j\", \"MARK\",","+\t\t\t\"--set-xmark\", inpodTproxyMark,","+\t\t)","+\t}","+","+\t// Redirect VM-originated TCP traffic arriving on tap0_kata to ztunnel's","+\t// outbound port. Port 53 traffic is handled by the earlier DNS rules.","+\tb.AppendRuleV4(ChainInpodPrerouting, \"nat\",","+\t\t\"-i\", kataTapIface,","+\t\t\"-p\", \"tcp\",","+\t\t\"-j\", \"REDIRECT\",","+\t\t\"--to-ports\", fmt.Sprint(config.ZtunnelOutboundPort),","+\t)","+","+\t// Rewrite the source of kubelet probes to the CNI-provided gateway as","+\t// they leave through tap0_kata. The guest already uses this address as","+\t// its default gateway, so probe replies return to the pod netns.","+\tif kataCfg.podGatewayV4.IsValid() {","+\t\tb.AppendRuleV4(","+\t\t\t\"POSTROUTING\", \"nat\",","+\t\t\t\"-j\", ChainHostPostrouting,","+\t\t)","+\t\tb.AppendRuleV4(","+\t\t\tChainHostPostrouting, \"nat\",","+\t\t\t\"-s\", cfg.cfg.HostProbeSNATAddress.String(),","+\t\t\t\"-o\", kataTapIface,","+\t\t\t\"-j\", \"SNAT\",","+\t\t\t\"--to-source\", kataCfg.podGatewayV4.String(),","+\t\t)","+\t}","+\t// ztunnel may connect to this pod's own HBONE listener through the pod","+\t// IP. Mark those connections for local delivery instead of routing them","+\t// through tap0_kata into the guest.","+\tfor _, ip := range kataCfg.podIPv4 {","+\t\tb.AppendRuleV4(","+\t\t\tChainInpodOutput, \"mangle\",","+\t\t\t\"-d\", ip.String()+\"/32\",","+\t\t\t\"-p\", \"tcp\",","+\t\t\t\"--dport\", fmt.Sprint(config.ZtunnelInboundPort),","+\t\t\t\"-j\", \"MARK\",","+\t\t\t\"--set-xmark\", inpodTproxyMark,","+\t\t)","+\t}","+","+\tif !podOverrides.IngressMode {","+\t\t// Kubelet-probe ACCEPT in nat PRERT (mirror of the mangle ACCEPT","+\t\t// above, needed so the nat REDIRECT below doesn't swallow probes).","+\t\tb.AppendRuleV4(","+\t\t\tChainInpodPrerouting, \"nat\",","+\t\t\t\"-s\", cfg.cfg.HostProbeSNATAddress.String(),","+\t\t\t\"-p\", \"tcp\",","+\t\t\t\"-m\", \"tcp\",","+\t\t\t\"-j\", \"ACCEPT\",","+\t\t)","+\t\t// Wildcard REDIRECT to ztunnel plaintext port (15006). Skip 15008","+\t\t// which reaches ztunnel's HBONE listener via lo without REDIRECT.","+\t\tb.AppendRuleV4(","+\t\t\tChainInpodPrerouting, \"nat\",","+\t\t\t\"!\", \"-d\", \"127.0.0.1/32\",","+\t\t\t\"-p\", \"tcp\",","+\t\t\t\"!\", \"--dport\", fmt.Sprint(config.ZtunnelInboundPort),","+\t\t\t\"-m\", \"mark\", \"!\",","+\t\t\t\"--mark\", inpodMark,","+\t\t\t\"-j\", \"REDIRECT\",","+\t\t\t\"--to-ports\", fmt.Sprint(config.ZtunnelInboundPlaintextPort),","+\t\t)","+\t}","+","+\tif redirectDNS {","+\t\t// DNS conntrack-zone separation for ztunnel's proxy-to-upstream","+\t\t// DNS forwarding. The normal OUTPUT redirect is not needed because","+\t\t// workload DNS originates in the guest and enters through tap0_kata;","+\t\t// ztunnel's own DNS traffic carries mark 0x539.","+\t\t// See https://github.com/istio/istio/issues/33469","+\t\tb.AppendRuleV4(","+\t\t\tChainInpodOutput, \"raw\",","+\t\t\t\"-p\", \"udp\",","+\t\t\t\"-m\", \"mark\",","+\t\t\t\"--mark\", inpodMark,","+\t\t\t\"-m\", \"udp\",","+\t\t\t\"--dport\", \"53\",","+\t\t\t\"-j\", \"CT\",","+\t\t\t\"--zone\", \"1\",","+\t\t)","+\t\tb.AppendRuleV4(","+\t\t\tChainInpodPrerouting, \"raw\",","+\t\t\t\"-p\", \"udp\",","+\t\t\t\"-m\", \"mark\", \"!\",","+\t\t\t\"--mark\", inpodMark,","+\t\t\t\"-m\", \"udp\",","+\t\t\t\"--sport\", \"53\",","+\t\t\t\"-j\", \"CT\",","+\t\t\t\"--zone\", \"1\",","+\t\t)","+\t}","+","+\treturn b","+}","+","+// discoverDefaultGateway returns the IPv4 and IPv6 default-route gateways,","+// along with the IPv4 default-route interface, in the current netns. It is","+// used for Kata-mode probe SNAT and host-facing traffic interception.","+func discoverDefaultGateway() (netip.Addr, netip.Addr, string) {","+\tvar v4, v6 netip.Addr","+\tvar v4Interface string","+\tfor _, family := range []int{unix.AF_INET, unix.AF_INET6} {","+\t\troutes, err := netlink.RouteList(nil, family)","+\t\tif err != nil {","+\t\t\tlog.Debugf(\"failed to list routes for family %d: %v\", family, err)","+\t\t\tcontinue","+\t\t}","+\t\tfor _, r := range routes {","+\t\t\t// Default route: no Dst (or zero-length network).","+\t\t\tif r.Dst != nil && r.Dst.IP != nil && !r.Dst.IP.IsUnspecified() {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif r.Gw == nil {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\taddr, ok := netip.AddrFromSlice(r.Gw)","+\t\t\tif !ok {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\taddr = addr.Unmap()","+\t\t\tif family == unix.AF_INET && !v4.IsValid() {","+\t\t\t\tv4 = addr","+\t\t\t\tlink, err := netlink.LinkByIndex(r.LinkIndex)","+\t\t\t\tif err != nil {","+\t\t\t\t\tlog.Debugf(\"failed to find default-route interface %d: %v\", r.LinkIndex, err)","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tv4Interface = link.Attrs().Name","+\t\t\t} else if family == unix.AF_INET6 && !v6.IsValid() {","+\t\t\t\tv6 = addr","+\t\t\t}","+\t\t}","+\t}","+\treturn v4, v6, v4Interface","+}","+","+// discoverPodIPs returns non-loopback, non-link-local IPv4 and IPv6 addresses","+// from non-tap interfaces in the current netns. It is used for Kata self-","+// hairpin handling, where ztunnel-originated HBONE traffic to the pod's own IP","+// must be delivered locally instead of routed through tap0_kata to the guest.","+func discoverPodIPs() ([]netip.Addr, []netip.Addr) {","+\tvar v4, v6 []netip.Addr","+\tlinks, err := netlink.LinkList()","+\tif err != nil {","+\t\tlog.Warnf(\"failed to list links: %v\", err)","+\t\treturn v4, v6","+\t}","+","+\tfor _, link := range links {","+\t\tname := link.Attrs().Name","+\t\tif name == \"lo\" || strings.HasPrefix(name, \"tap\") {","+\t\t\tcontinue","+\t\t}","+\t\tfor _, family := range []int{unix.AF_INET, unix.AF_INET6} {","+\t\t\taddrs, err := netlink.AddrList(link, family)","+\t\t\tif err != nil {","+\t\t\t\tlog.Debugf(\"failed to list addresses for %s family %d: %v\", name, family, err)","+\t\t\t