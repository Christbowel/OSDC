{"id":"a8818a56824b6c6ff0444ca4cdd54663850519f4","axis":"silent","repo":"envoyproxy/envoy","sha":"a8818a56824b6c6ff0444ca4cdd54663850519f4","parsed":{"files":[{"path":"changelogs/current/minor_behavior_changes/listener__lds-sotw-track-resources.rst","lines":["@@ -0,0 +1,8 @@","+A State-of-the-World (SotW) Listener Discovery Service (LDS) update now removes only the listeners","+that were previously received through LDS, instead of every dynamic listener that is not part of the","+update. Listeners that other components add are therefore no longer removed when a SotW LDS update","+arrives, and a listener whose name differs from its resource name, such as an entry of a filesystem","+collection, is no longer drained and added again on every SotW update. This behavior can be reverted","+by setting ``envoy.reloadable_features.lds_sotw_track_resources`` to ``false``. Independently of","+this runtime guard, LDS now generates the name of a listener that it receives without a name, so","+one update can add several such listeners instead of rejecting all but the first as duplicates."],"additions":8,"deletions":0,"truncated":false},{"path":"source/common/listener_manager/BUILD","lines":["@@ -179,17 +179,21 @@ envoy_cc_library(","     srcs = [\"lds_api.cc\"],","     hdrs = [\"lds_api.h\"],","     deps = [","+        \"//envoy/common:random_generator_interface\",","         \"//envoy/config:subscription_factory_interface\",","         \"//envoy/config:subscription_interface\",","         \"//envoy/init:manager_interface\",","         \"//envoy/server:listener_manager_interface\",","         \"//source/common/common:cleanup_lib\",","         \"//source/common/config:api_version_lib\",","-        \"//source/common/config:resource_type_helper_lib\",","+        \"//source/common/config:opaque_resource_decoder_lib\",","+        \"//source/common/config:resource_name_lib\",","         \"//source/common/config:utility_lib\",","         \"//source/common/grpc:common_lib\",","         \"//source/common/init:target_lib\",","         \"//source/common/protobuf:utility_lib\",","+        \"//source/common/runtime:runtime_features_lib\",","+        \"@abseil-cpp//absl/container:flat_hash_set\",","         \"@abseil-cpp//absl/container:node_hash_set\",","         \"@envoy_api//envoy/admin/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\","],"additions":5,"deletions":1,"truncated":false},{"path":"source/common/listener_manager/lds_api.cc","lines":["@@ -9,37 +9,67 @@"," #include \"source/common/common/assert.h\""," #include \"source/common/common/cleanup.h\""," #include \"source/common/config/api_version.h\"","+#include \"source/common/config/opaque_resource_decoder_impl.h\"","+#include \"source/common/config/resource_name.h\""," #include \"source/common/config/utility.h\""," #include \"source/common/grpc/common.h\""," #include \"source/common/protobuf/utility.h\"","+#include \"source/common/runtime/runtime_features.h\""," "," #include \"absl/container/node_hash_set.h\""," #include \"absl/strings/str_join.h\""," "," namespace Envoy {"," namespace Server {","+namespace {","+","+// Generates a UUID name for a listener without one, as the listener manager would, so that a SotW","+// update can remove the listener by that name.","+class ListenerResourceDecoder","+    : public Config::OpaqueResourceDecoderImpl<envoy::config::listener::v3::Listener> {","+public:","+  ListenerResourceDecoder(ProtobufMessage::ValidationVisitor& validation_visitor,","+                          Random::RandomGenerator& random)","+      : OpaqueResourceDecoderImpl(validation_visitor, \"name\"), random_(random) {}","+","+  // Config::OpaqueResourceDecoder","+  Protobuf::Arena::UniquePtr<Protobuf::Message> decodeResource(const Protobuf::Any& resource,","+                                                               Protobuf::Arena& arena) override {","+    Protobuf::Arena::UniquePtr<Protobuf::Message> message =","+        OpaqueResourceDecoderImpl::decodeResource(resource, arena);","+    auto& listener = Protobuf::DynamicCastMessage<envoy::config::listener::v3::Listener>(*message);","+    if (listener.name().empty()) {","+      listener.set_name(random_.uuid());","+    }","+    return message;","+  }","+","+private:","+  Random::RandomGenerator& random_;","+};","+","+} // namespace"," "," LdsApiImpl::LdsApiImpl(const envoy::config::core::v3::ConfigSource& lds_config,","                        const xds::core::v3::ResourceLocator* lds_resources_locator,","                        Upstream::ClusterManager& cm, Init::Manager& init_manager,","                        Stats::Scope& scope, ListenerManager& lm,","-                       ProtobufMessage::ValidationVisitor& validation_visitor)","+                       ProtobufMessage::ValidationVisitor& validation_visitor,","+                       Random::RandomGenerator& random)","     : listener_manager_(lm), scope_(scope.createScope(\"listener_manager.lds.\")),","-      resource_type_helper_(validation_visitor, \"name\"),","+      resource_decoder_(std::make_shared<ListenerResourceDecoder>(validation_visitor, random)),","       init_target_(\"LDS\", [this]() { subscription_->start({}); }) {","-  const auto resource_name = resource_type_helper_.getResourceName();","+  const auto resource_name = Config::getResourceName<envoy::config::listener::v3::Listener>();","   if (lds_resources_locator == nullptr) {","-    subscription_ =","-        THROW_OR_RETURN_VALUE(cm.subscriptionFactory().subscriptionFromConfigSource(","-                                  lds_config, Grpc::Common::typeUrl(resource_name), *scope_, *this,","-                                  resource_type_helper_.resourceDecoder(), {}),","-                              Config::SubscriptionPtr);","+    subscription_ = THROW_OR_RETURN_VALUE(cm.subscriptionFactory().subscriptionFromConfigSource(","+                                              lds_config, Grpc::Common::typeUrl(resource_name),","+                                              *scope_, *this, resource_decoder_, {}),","+                                          Config::SubscriptionPtr);","   } else {","-    subscription_ =","-        THROW_OR_RETURN_VALUE(cm.subscriptionFactory().collectionSubscriptionFromUrl(","-                                  *lds_resources_locator, lds_config, resource_name, *scope_, *this,","-                                  resource_type_helper_.resourceDecoder()),","-                              Config::SubscriptionPtr);","+    subscription_ = THROW_OR_RETURN_VALUE(","+        cm.subscriptionFactory().collectionSubscriptionFromUrl(","+            *lds_resources_locator, lds_config, resource_name, *scope_, *this, resource_decoder_),","+        Config::SubscriptionPtr);","   }","   init_manager.add(init_target_);"," }","@@ -54,6 +84,8 @@ LdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& added_","   // We do all listener removals before adding the new listeners. This allows adding a new","   // listener with the same address as a listener that is to be removed. Do not change the order.","   for (const auto& removed_listener : removed_resources) {","+    // SotW listeners whose TTL expires are removed here, so they are no longer tracked.","+    sotw_listener_names_.erase(removed_listener);","     if (listener_manager_.removeListener(removed_listener)) {","       ENVOY_LOG(info, \"lds: remove listener '{}'\", removed_listener);","       any_applied = true;","@@ -121,6 +153,28 @@ LdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& added_"," "," absl::Status LdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& resources,","                                         const std::string& version_info) {","+  absl::flat_hash_set<std::string> next_sotw_listener_names;","+  next_sotw_listener_names.reserve(resources.size());","+  for (const auto& resource : resources) {","+    next_sotw_listener_names.insert(","+        Protobuf::DynamicCastMessage<envoy::config::listener::v3::Listener>(","+            resource.get().resource())","+            .name());","+  }","+","+  // Other components may add listeners, so only remove the listeners received via SotW.","+  if (Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.lds_sotw_track_resources\")) {","+    Protobuf::RepeatedPtrField<std::string> to_remove;","+    for (const std::string& listener_name : sotw_listener_names_) {","+      if (!next_sotw_listener_names.contains(listener_name)) {","+        to_remove.Add(std::string(listener_name));","+      }","+    }","+    absl::Status status = onConfigUpdate(resources, to_remove, version_info);","+    sotw_listener_names_ = std::move(next_sotw_listener_names);","+    return status;","+  }","+","   // We need to keep track of which listeners need to remove.","   // Specifically, it's [listeners we currently have] - [listeners found in the response].","   absl::node_hash_set<std::string> listeners_to_remove;","@@ -137,7 +191,11 @@ absl::Status LdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourc","   for (const auto& listener : listeners_to_remove) {","     *to_remove_repeated.Add() = listener;","   }","-  return onConfigUpdate(resources, to_remove_repeated, version_info);","+  absl::Status status = onConfigUpdate(resources, to_remove_repeated, version_info);","+  // Track the names even if unused, so enabling the guard at runtime doesn't leak listeners. Store","+  // them after the call, since it untracks the listeners that it removes.","+  sotw_listener_names_ = std::move(next_sotw_listener_names);","+  return status;"," }"," "," void LdsApiImpl::onConfigUpdateFailed(Envoy::Config::ConfigUpdateFailureReason reason,"],"additions":72,"deletions":14,"truncated":false},{"path":"source/common/listener_manager/lds_api.h","lines":["@@ -2,6 +2,7 @@"," "," #include <functional>"," ","+#include \"envoy/common/random_generator.h\""," #include \"envoy/config/core/v3/config_source.pb.h\""," #include \"envoy/config/listener/v3/listener.pb.h\""," #include \"envoy/config/listener/v3/listener.pb.validate.h\"","@@ -13,9 +14,10 @@"," #include \"envoy/stats/scope.h\""," "," #include \"source/common/common/logger.h\"","-#include \"source/common/config/resource_type_helper.h\""," #include \"source/common/init/target_impl.h\""," ","+#include \"absl/container/flat_hash_set.h\"","+"," namespace Envoy {"," namespace Server {"," ","@@ -29,7 +31,8 @@ class LdsApiImpl : public LdsApi,","   LdsApiImpl(const envoy::config::core::v3::ConfigSource& lds_config,","              const xds::core::v3::ResourceLocator* lds_resources_locator,","              Upstream::ClusterManager& cm, Init::Manager& init_manager, Stats::Scope& scope,","-             ListenerManager& lm, ProtobufMessage::ValidationVisitor& validation_visitor);","+             ListenerManager& lm, ProtobufMessage::ValidationVisitor& validation_visitor,","+             Random::RandomGenerator& random);"," ","   // Server::LdsApi","   std::string versionInfo() const override { return system_version_info_; }","@@ -48,8 +51,11 @@ class LdsApiImpl : public LdsApi,","   std::string system_version_info_;","   ListenerManager& listener_manager_;","   Stats::ScopeSharedPtr scope_;","-  const Config::ResourceTypeHelper<envoy::config::listener::v3::Listener> resource_type_helper_;","+  const Config::OpaqueResourceDecoderSharedPtr resource_decoder_;","   Init::TargetImpl init_target_;","+  // The names of the listeners that the last SotW update delivered, without the ones whose TTL","+  // expired since.","+  absl::flat_hash_set<std::string> sotw_listener_names_;"," };"," "," } // namespace Server"],"additions":9,"deletions":3,"truncated":false},{"path":"source/common/listener_manager/listener_manager_impl.h","lines":["@@ -96,7 +96,8 @@ class ProdListenerComponentFactory : public ListenerComponentFactory,","     return std::make_unique<LdsApiImpl>(","         lds_config, lds_resources_locator, server_.clusterManager(), server_.initManager(),","         *server_.stats().rootScope(), server_.listenerManager(),","-        server_.messageValidationContext().dynamicValidationVisitor());","+        server_.messageValidationContext().dynamicValidationVisitor(),","+        server_.api().randomGenerator());","   }","   absl::StatusOr<Filter::NetworkFilterFactoriesList> createNetworkFilterFactoryList(","       const Protobuf::RepeatedPtrField<envoy::config::listener::v3::Filter>& filters,"],"additions":2,"deletions":1,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -125,6 +125,10 @@ RUNTIME_GUARD(envoy_reloadable_features_json_formatter_omit_empty_values);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_add_verification_status_header);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_sanitize_payload_headers_filter_wide);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_select_key_by_x5t);","+// A SotW LDS update removes only the listeners received through LDS, so it no longer removes the","+// listeners that other components add. Disable to remove every dynamic listener not in the","+// update.","+RUNTIME_GUARD(envoy_reloadable_features_lds_sotw_track_resources);"," RUNTIME_GUARD(envoy_reloadable_features_limit_json_parser_nesting_depth);"," RUNTIME_GUARD(envoy_reloadable_features_listener_filter_reentrant_continue_guard);"," RUNTIME_GUARD(envoy_reloadable_features_listener_in_place_address_update);"],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/listener_managers/validation_listener_manager/validation_listener_manager.h","lines":["@@ -22,7 +22,8 @@ class ValidationListenerComponentFactory : public ListenerComponentFactory {","     return std::make_unique<LdsApiImpl>(","         lds_config, lds_resources_locator, parent_.clusterManager(), parent_.initManager(),","         *parent_.stats().rootScope(), parent_.listenerManager(),","-        parent_.messageValidationContext().dynamicValidationVisitor());","+        parent_.messageValidationContext().dynamicValidationVisitor(),","+        parent_.api().randomGenerator());","   }","   absl::StatusOr<Filter::NetworkFilterFactoriesList> createNetworkFilterFactoryList(","       const Protobuf::RepeatedPtrField<envoy::config::listener::v3::Filter>& filters,"],"additions":2,"deletions":1,"truncated":false},{"path":"test/common/listener_manager/BUILD","lines":["@@ -258,8 +258,10 @@ envoy_cc_test(","     ],","     rbe_pool = {\"build\": \"linux_x64_small\"},","     deps = [","+        \"//source/common/config:decoded_resource_lib\",","         \"//source/common/listener_manager:lds_api_lib\",","         \"//source/common/protobuf:utility_lib\",","+        \"//test/mocks:common_lib\",","         \"//test/mocks/config:config_mocks\",","         \"//test/mocks/config:xds_manager_mocks\",","         \"//test/mocks/init:init_mocks\",","@@ -268,6 +270,7 @@ envoy_cc_test(","         \"//test/mocks/upstream:upstream_mocks\",","         \"//test/test_common:environment_lib\",","         \"//test/test_common:status_utility_lib\",","+        \"//test/test_common:test_runtime_lib\",","         \"//test/test_common:utility_lib\",","         \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/config/listener/v3:pkg_cc_proto\","],"additions":3,"deletions":0,"truncated":false},{"path":"test/common/listener_manager/lds_api_test.cc","lines":["@@ -4,9 +4,11 @@"," #include \"envoy/config/listener/v3/listener.pb.h\""," #include \"envoy/service/discovery/v3/discovery.pb.h\""," ","+#include \"source/common/config/decoded_resource_impl.h\""," #include \"source/common/listener_manager/lds_api.h\""," #include \"source/common/protobuf/utility.h\""," ","+#include \"test/mocks/common.h\""," #include \"test/mocks/config/mocks.h\""," #include \"test/mocks/config/xds_manager.h\""," #include \"test/mocks/init/mocks.h\"","@@ -15,6 +17,7 @@"," #include \"test/mocks/upstream/mocks.h\""," #include \"test/test_common/environment.h\""," #include \"test/test_common/status_utility.h\"","+#include \"test/test_common/test_runtime.h\""," #include \"test/test_common/utility.h\""," "," #include \"gmock/gmock.h\"","@@ -35,14 +38,20 @@ class LdsApiTest : public testing::Test {","     ON_CALL(init_manager_, add(_)).WillByDefault([this](const Init::Target& target) {","       init_target_handle_ = target.createHandle(\"test\");","     });","+    setSotwTracking(false);","+  }","+","+  void setSotwTracking(bool enabled) {","+    scoped_runtime_.mergeValues(","+        {{\"envoy.reloadable_features.lds_sotw_track_resources\", enabled ? \"true\" : \"false\"}});","   }"," ","   void setup() {","     envoy::config::core::v3::ConfigSource lds_config;","     EXPECT_CALL(init_manager_, add(_));","-    lds_ =","-        std::make_unique<LdsApiImpl>(lds_config, nullptr, cluster_manager_, init_manager_,","-                                     *store_.rootScope(), listener_manager_, validation_visitor_);","+    lds_ = std::make_unique<LdsApiImpl>(lds_config, nullptr, cluster_manager_, init_manager_,","+                                        *store_.rootScope(), listener_manager_, validation_visitor_,","+                                        random_);","     EXPECT_CALL(*cluster_manager_.subscription_factory_.subscription_, start(_));","     init_target_handle_->initialize(init_watcher_);","     lds_callbacks_ = cluster_manager_.subscription_factory_.callbacks_;","@@ -90,6 +99,23 @@ class LdsApiTest : public testing::Test {","     return listener;","   }"," ","+  envoy::config::listener::v3::Listener buildListenerWithoutAName(const std::string& address) {","+    envoy::config::listener::v3::Listener listener = buildListener(address);","+    listener.clear_name();","+    return listener;","+  }","+","+  // Decodes the listeners with the decoder that LDS gives its subscription.","+  std::unique_ptr<Config::DecodedResourcesWrapper>","+  decodeListeners(const std::vector<envoy::config::listener::v3::Listener>& listeners) {","+    Protobuf::RepeatedPtrField<Protobuf::Any> resources;","+    for (const auto& listener : listeners) {","+      std::ignore = resources.Add()->PackFrom(listener);","+    }","+    return *Config::DecodedResourcesWrapper::create(","+        *cluster_manager_.subscription_factory_.resource_decoder_, resources, \"\");","+  }","+","   NiceMock<Config::MockXdsManager> xds_manager_;","   std::shared_ptr<NiceMock<Config::MockGrpcMux>> grpc_mux_;","   NiceMock<Upstream::MockClusterManager> cluster_manager_;","@@ -101,6 +127,8 @@ class LdsApiTest : public testing::Test {","   Config::SubscriptionCallbacks* lds_callbacks_{};","   std::unique_ptr<LdsApiImpl> lds_;","   NiceMock<ProtobufMessage::MockValidationVisitor> validation_visitor_;","+  Random::MockRandomGenerator random_;","+  TestScopedRuntime scoped_runtime_;"," "," private:","   std::list<NiceMock<Network::MockListenerConfig>> listeners_;","@@ -484,6 +512,232 @@ TEST_F(LdsApiTest, ReplacingListenerWithSameAddress) {","   EXPECT_OK(lds_callbacks_->onConfigUpdate(decoded_resources_2.refvec_, response2.version_info()));"," }"," ","+// LDS names the listeners that it receives without a name, so one update adds all of them, and","+// keeps the names of the other listeners.","+TEST_F(LdsApiTest, NamesListenersWithoutAName) {","+  InSequence s;","+  setup();","+","+  EXPECT_CALL(random_, uuid())","+      .WillOnce(Return(\"generated_name_1\"))","+      .WillOnce(Return(\"generated_name_2\"));","+  const auto update =","+      decodeListeners({buildListenerWithoutAName(\"address1\"), buildListener(\"listener1\"),","+                       buildListenerWithoutAName(\"address2\")});","+  makeListenersAndExpectCall({});","+  expectAdd(\"generated_name_1\", {}, true);","+  expectAdd(\"listener1\", {}, true);","+  expectAdd(\"generated_name_2\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_CALL(init_watcher_, ready());","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(update->refvec_, \"0\"));","+}","+","+// The runtime guard keeps the listeners of other components on a SotW update, and removes only the","+// received listeners that the update leaves out.","+TEST_F(LdsApiTest, SotwTrackingRuntimeGuardKeepsListenersOfOtherComponents) {","+  InSequence s;","+  setSotwTracking(true);","+  setup();","+","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());","+  expectAdd(\"listener1\", {}, true);","+  expectAdd(\"listener2\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_CALL(init_watcher_, ready());","+  const auto first_update =","+      TestUtility::decodeResources({buildListener(\"listener1\"), buildListener(\"listener2\")});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(first_update.refvec_, \"0\"));","+","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());","+  EXPECT_CALL(listener_manager_, removeListener(\"listener1\")).WillOnce(Return(true));","+  expectAdd(\"listener2\", {}, false);","+  expectAdd(\"listener3\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  const auto second_update =","+      TestUtility::decodeResources({buildListener(\"listener2\"), buildListener(\"listener3\")});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(second_update.refvec_, \"1\"));","+  EXPECT_EQ(\"1\", lds_->versionInfo());","+}","+","+// With the guard disabled, a SotW update removes every listener not in it.","+TEST_F(LdsApiTest, SotwTrackingRuntimeGuardDisabledRemovesAllMissingListeners) {","+  InSequence s;","+  setup();","+","+  makeListenersAndExpectCall({});","+  expectAdd(\"listener1\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_CALL(init_watcher_, ready());","+  const auto first_update = TestUtility::decodeResources({buildListener(\"listener1\")});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(first_update.refvec_, \"0\"));","+","+  makeListenersAndExpectCall({\"listener1\", \"other_listener\"});","+  // The removal order depends on the hash set iteration order.","+  std::vector<std::string> removed;","+  EXPECT_CALL(listener_manager_, removeListener(_))","+      .Times(2)","+      .WillRepeatedly([&removed](const std::string& name) {","+        removed.push_back(name);","+        return true;","+      });","+  expectAdd(\"listener2\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  const auto second_update = TestUtility::decodeResources({buildListener(\"listener2\")});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(second_update.refvec_, \"1\"));","+  EXPECT_THAT(removed, testing::UnorderedElementsAre(\"listener1\", \"other_listener\"));","+}","+","+// Listeners received while the guard was disabled are still tracked.","+TEST_F(LdsApiTest, SotwTrackingEnabledAtRuntimeRemovesPreviouslyReceivedListeners) {","+  InSequence s;","+  setup();","+","+  makeListenersAndExpectCall({});","+  expectAdd(\"listener1\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_CALL(init_watcher_, ready());","+  const auto first_update = TestUtility::decodeResources({buildListener(\"listener1\")});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(first_update.refvec_, \"0\"));","+","+  setSotwTracking(true);","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());","+  EXPECT_CALL(listener_manager_, removeListener(\"listener1\")).WillOnce(Return(true));","+  expectAdd(\"listener2\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  const auto second_update = TestUtility::decodeResources({buildListener(\"listener2\")});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(second_update.refvec_, \"1\"));","+}","+","+// A SotW update removes a listener by its own name, which can differ from its resource name, and","+// keeps it while the updates deliver it.","+TEST_F(LdsApiTest, SotwTrackingRemovesListenersByTheirNames) {","+  InSequence s;","+  setSotwTracking(true);","+  setup();","+","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());","+  expectAdd(\"listener1\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_CALL(init_watcher_, ready());","+  const auto first_update = TestUtility::decodeResources<envoy::config::listener::v3::Listener>(","+      {{\"collection/entry\", buildListener(\"listener1\")}});","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(first_update.refvec_, \"0\"));","+","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());","+  expectAdd(\"listener1\", {}, false);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(first_update.refvec_, \"1\"));","+","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());","+  EXPECT_CALL(listener_manager_, removeListener(\"listener1\")).WillOnce(Return(true));","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_OK(lds_callbacks_->onConfigUpdate({}, \"2\"));","+}","+","+// A listener whose resource name differs from its name stays tracked while the guard is disabled.","+TEST_F(LdsApiTest, SotwTrackingDisabledTracksListenersByTheirNames) {","+  InSequence s;","+  setup();","+  const auto update = TestUtility::decodeResources<envoy::config::listener::v3::Listener>(","+      {{\"collection/entry\", buildListener(\"listener1\")}});","+  makeListenersAndExpectCall({});","+  expectAdd(\"listener1\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_CALL(init_watcher_, ready());","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(update.refvec_, \"0\"));","+","+  // The removal path compares resource names, so it removes the listener and adds it again.","+  makeListenersAndExpectCall({\"listener1\"});","+  EXPECT_CALL(listener_manager_, removeListener(\"listener1\")).WillOnce(Return(true));","+  expectAdd(\"listener1\", {}, true);","+  EXPECT_CALL(listener_manager_, endListenerUpdate(_));","+  EXPECT_OK(lds_callbacks_->onConfigUpdate(update.refvec_, \"1\"));","+","+  setSotwTracking(true);","+  EXPECT_CALL(listener_manager_, beginListenerUpdate());",