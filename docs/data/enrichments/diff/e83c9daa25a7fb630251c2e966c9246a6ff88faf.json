{"id":"e83c9daa25a7fb630251c2e966c9246a6ff88faf","axis":"silent","repo":"vllm-project/vllm","sha":"e83c9daa25a7fb630251c2e966c9246a6ff88faf","parsed":{"files":[{"path":"tests/kernels/attention/test_rocm_dsv41_indexer_shardq.py","lines":["@@ -0,0 +1,211 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"ShardQ split of the ROCm FP8 sparse-indexer prefill (DeepSeek-V4.1).","+","+One GPU plays every TP rank: each rank scores its zigzag tokens, which must","+select what the replicated run selects for them, including a candidate","+consumer whose candidate rows of other ranks hold junk; the exchange then puts","+every row back in token order. Rows compare as sets: the top-k order within a","+row depends on the batch shape.\"\"\"","+","+from types import SimpleNamespace","+","+import numpy as np","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_rocm(), reason=\"ROCm-specific tests\"","+)","+","+HEADS, DIM, PAGE, TOPK = 32, 128, 64, 512","+MAX_MODEL_LEN = 1 << 16","+# More candidate positions than TOPK, so no row picks among masked ties.","+CAND_COLS, CAND_BLOCK = 128, 8","+PREFIX = \"indexer\"","+# (cached context, new rows) per request, in two chunks of 2 + 1 requests.","+REQUESTS = [(0, 1500), (400, 300), (0, 2600)]","+CHUNKS = [(0, 2), (2, 3)]","+ROWS = sum(new for _, new in REQUESTS)","+","+","+@pytest.fixture(autouse=True)","+def _aiter(monkeypatch):","+    from vllm._aiter_ops import rocm_aiter_ops","+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import mqa_logits_module","+    from vllm.v1.worker.workspace import (","+        init_workspace_manager,","+        is_workspace_manager_initialized,","+    )","+","+    monkeypatch.setattr(rocm_aiter_ops, \"_AITER_ENABLED\", True)","+    if mqa_logits_module() is None:","+        pytest.skip(\"AITER's MQA logits module is not installed\")","+    if not is_workspace_manager_initialized():","+        init_workspace_manager(torch.device(\"cuda\"))","+","+","+def _cache(ratio: int):","+    \"\"\"Queries, weights, a paged K cache, its block tables and key counts.\"\"\"","+    from aiter import dtypes","+","+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import (","+        indexer_k_quant_and_cache_triton,","+    )","+","+    torch.manual_seed(ratio)","+    q = (torch.randn(ROWS, HEADS, DIM, device=\"cuda\") * 0.5).to(dtypes.fp8)","+    weights = torch.randn(ROWS, HEADS, device=\"cuda\")","+    keys = [(ctx + new) // ratio for ctx, new in REQUESTS]","+    pages = [(n + PAGE - 1) // PAGE for n in keys]","+    perm = torch.randperm(sum(pages), device=\"cuda\").int().split(pages)","+    tables = torch.zeros(len(REQUESTS), max(pages), dtype=torch.int32, device=\"cuda\")","+    slots = []","+    for i, (n, row) in enumerate(zip(keys, perm)):","+        tables[i, : len(row)] = row","+        pos = torch.arange(n, device=\"cuda\")","+        slots.append(tables[i, pos // PAGE].long() * PAGE + pos % PAGE)","+    kv = torch.zeros(sum(pages), PAGE, DIM + 4, dtype=torch.uint8, device=\"cuda\")","+    k = torch.randn(sum(keys), DIM, dtype=torch.bfloat16, device=\"cuda\")","+    indexer_k_quant_and_cache_triton(k, kv, torch.cat(slots), 128, \"ue8m0\")","+    return ratio, q, weights, kv, tables, keys","+","+","+def _chunks(cache, tokens: np.ndarray):","+    \"\"\"The prefill chunks of `tokens` (ascending ids into all the rows),","+    numbered compactly, as the indexer builder chunks a ShardQ split.\"\"\"","+    from vllm.v1.attention.backends.mla.indexer import (","+        DeepseekV32IndexerPrefillChunkMetadata,","+    )","+","+    ratio, _, _, _, tables, keys = cache","+    starts = np.cumsum([0] + [new for _, new in REQUESTS])","+    req = np.searchsorted(starts, tokens, side=\"right\") - 1","+    chunks, row = [], 0","+    for lo, hi in CHUNKS:","+        mine = (req >= lo) & (req < hi)","+        cu = torch.tensor([0, *keys[lo:hi]], device=\"cuda\").cumsum(0).int()","+        r = req[mine]","+        pos = torch.from_numpy(tokens[mine] - starts[r] + np.array(REQUESTS)[r, 0])","+        ks = cu[torch.from_numpy(r - lo).cuda()]","+        ke = ks + (pos.cuda() + 1) // ratio","+        chunks.append(","+            DeepseekV32IndexerPrefillChunkMetadata(","+                block_table=tables[lo:hi],","+                cu_seqlen_ks=ks.int(),","+                cu_seqlen_ke=ke.int(),","+                cu_seq_lens=cu,","+                token_to_seq=torch.repeat_interleave(","+                    torch.arange(hi - lo, dtype=torch.int32, device=\"cuda\"),","+                    torch.tensor(keys[lo:hi], device=\"cuda\"),","+                ),","+                total_seq_lens=int(cu[-1]),","+                max_seqlen_k=int((ke - ks).max()),","+                token_start=row,","+                token_end=row + int(mine.sum()),","+                num_reqs=hi - lo,","+            )","+        )","+        row += int(mine.sum())","+    return chunks","+","+","+def _run(monkeypatch, cache, split=None, tokens=None, cand=None, write=False):","+    \"\"\"One indexer layer over all the rows, or over a rank's ShardQ `tokens`.\"\"\"","+    from vllm.config import CUDAGraphMode","+    from vllm.v1.attention.backends.mla.indexer import (","+        DeepseekV32IndexerMetadata,","+        DeepseekV32IndexerPrefillMetadata,","+    )","+    from vllm.v1.attention.ops import rocm_aiter_mla_sparse","+","+    ratio, q, weights, kv, _, _ = cache","+    indices = None if tokens is None else torch.from_numpy(tokens).cuda()","+    chunks = _chunks(cache, np.arange(ROWS) if tokens is None else tokens)","+    metadata = DeepseekV32IndexerMetadata(","+        seq_lens=torch.empty(0, device=\"cuda\"),","+        max_seq_len=0,","+        slot_mapping=torch.empty(0, dtype=torch.int64, device=\"cuda\"),","+        num_decodes=0,","+        num_decode_tokens=0,","+        num_prefills=len(REQUESTS),","+        num_prefill_tokens=ROWS,","+        prefill=DeepseekV32IndexerPrefillMetadata(","+            chunks, shardq_gather_indices=indices, shardq_split=split","+        ),","+    )","+    context = SimpleNamespace(","+        attn_metadata={PREFIX: metadata},","+        no_compile_layers={PREFIX: SimpleNamespace(gather_shardq_topk=True)},","+        cudagraph_runtime_mode=CUDAGraphMode.NONE,","+    )","+    monkeypatch.setattr(rocm_aiter_mla_sparse, \"get_forward_context\", lambda: context)","+    out = torch.full((ROWS, TOPK), -7, dtype=torch.int32, device=\"cuda\")","+    rocm_aiter_mla_sparse.rocm_aiter_sparse_attn_indexer(","+        torch.empty(ROWS, 1, device=\"cuda\"),","+        PREFIX,","+        kv,","+        q,","+        None,","+        weights,","+        128,","+        \"ue8m0\",","+        TOPK,","+        DIM,","+        MAX_MODEL_LEN,","+        max(c.total_seq_lens for c in chunks),","+        out,","+        skip_k_cache_insert=True,","+        compress_ratio=ratio,","+        candidate_blocks=cand,","+        candidate_block_size=CAND_BLOCK if cand is not None else 0,","+        candidate_write=write,","+    )","+    return out","+","+","+@pytest.mark.parametrize(\"world\", [2, 4])","+def test_shardq_split_matches_replicated(monkeypatch, world):","+    from vllm.v1.attention.ops import rocm_aiter_mla_sparse","+    from vllm.v1.attention.ops.shardq import ShardQSplit, zigzag_split","+","+    def sets(t):","+        return t.sort(dim=-1).values","+","+    two, one = _cache(2), _cache(1)","+    ref_cand = torch.empty(ROWS, CAND_COLS, dtype=torch.int32, device=\"cuda\")","+    # The ratio-2 layer, then the candidate source and a consumer.","+    ref = (","+        _run(monkeypatch, two),","+        _run(monkeypatch, one, cand=ref_cand, write=True),","+        _run(monkeypatch, one, cand=ref_cand),","+    )","+    token_ids, counts = zigzag_split(np.array([new for _, new in REQUESTS]), world)","+    split = ShardQSplit(0, token_ids, counts)","+    for rank in range(world):","+        start = counts[:rank].sum()","+        tokens = token_ids[start : start + counts[rank]]","+        mine = torch.from_numpy(tokens).cuda()","+        gathered: list[torch.Tensor] = []","+","+        def all_gatherv(local, dim, sizes, gathered=gathered):","+            gathered.append(local.clone())","+            # The other ranks' rows, so the exchange can be checked whole.","+            return ref[len(gathered) - 1][torch.from_numpy(token_ids).cuda()]","+","+        group = SimpleNamespace(rank_in_group=rank, all_gatherv=all_gatherv)","+        monkeypatch.setattr(rocm_aiter_mla_sparse, \"get_tp_group\", lambda g=group: g)","+        # Rows of other ranks hold junk, never the replicated selection.","+        cand = torch.randint(0, 400, ref_cand.shape, dtype=torch.int32, device=\"cuda\")","+        outs = (","+            _run(monkeypatch, two, split, tokens),","+            _run(monkeypatch, one, split, tokens, cand, write=True),","+            _run(monkeypatch, one, split, tokens, cand),","+        )","+        assert len(gathered) == 3","+        for local, out, want in zip(gathered, outs, ref):","+            assert torch.equal(sets(local), sets(want[mine]))","+            assert torch.equal(sets(out), sets(want))","+        assert torch.equal(sets(cand[: len(mine)]), sets(ref_cand[mine]))"],"additions":211,"deletions":0,"truncated":false},{"path":"tests/kernels/attention/test_rocm_paged_mxfp4_indexer.py","lines":["@@ -12,6 +12,7 @@"," import itertools"," import types"," ","+import numpy as np"," import pytest"," import torch"," ","@@ -41,6 +42,7 @@","     plan_gather_launches,","     plan_prefill_chunks,"," )","+from vllm.v1.attention.ops import rocm_aiter_mla_sparse"," from vllm.v1.attention.ops import rocm_paged_mxfp4_indexer as ops"," from vllm.v1.worker.workspace import init_workspace_manager, reset_workspace_manager"," ","@@ -205,9 +207,11 @@ def _block_maxima(scores):"," def _forward_context(monkeypatch, metadata):","     context = types.SimpleNamespace(","         attn_metadata={\"indexer\": metadata},","+        no_compile_layers={\"indexer\": types.SimpleNamespace(gather_shardq_topk=True)},","         cudagraph_runtime_mode=CUDAGraphMode.NONE,","     )","-    monkeypatch.setattr(ops, \"get_forward_context\", lambda: context)","+    for module in (ops, rocm_aiter_mla_sparse):","+        monkeypatch.setattr(module, \"get_forward_context\", lambda: context)"," "," "," def _decode_metadata(case, rows, ratio, query_lens, world=1, rank=0):","@@ -249,8 +253,10 @@ def _decode_metadata(case, rows, ratio, query_lens, world=1, rank=0):"," "," "," def _prefill_metadata(","-    case, rows, ratio, chunk_bounds, query_start_loc, gather_rows, gather","+    case, rows, ratio, chunk_bounds, query_start_loc, gather_rows, gather, split=None"," ):","+    \"\"\"`split`: (ShardQ split, this rank's token indices) when `rows` and","+    the bounds are a rank's tokens, numbered compactly.\"\"\"","     chunks = []","     for req_lo, req_hi, t0, t1 in chunk_bounds:","         ends = torch.tensor(","@@ -268,6 +274,7 @@ def _prefill_metadata(","                 token_start=t0,","                 token_end=t1,","                 num_reqs=req_hi - req_lo,","+                req_start=req_lo,","             )","         )","     seq_lens = torch.tensor(case.seq_lens)","@@ -290,7 +297,12 @@ def _prefill_metadata(","         num_decode_tokens=0,","         num_prefills=len(case.seq_lens),","         num_prefill_tokens=len(rows),","-        prefill=types.SimpleNamespace(chunks=chunks),","+        prefill=types.SimpleNamespace(","+            chunks=chunks,","+            shardq_split=split and split[0],","+            shardq_gather_indices=split and split[1],","+            shardq_rows=None,","+        ),","         prefill_plans=plans,","         gather_launches=plan_gather_launches(chunks, plans, gather_rows),","     )","@@ -789,3 +801,101 @@ def all_gather(local, dim, rank=rank, exchange=exchange, pending=pending):","                         case.block_table[[req for req, _ in rows]],","                         case.cache[ratio].shape[1],","                     )","+","+","+@pytest.mark.parametrize(\"world\", [2, 4])","+@pytest.mark.parametrize(\"gather\", [True, False], ids=[\"gather\", \"dense\"])","+def test_prefill_shardq_split_matches_replicated(monkeypatch, world, gather):","+    \"\"\"Each TP rank scores its ShardQ tokens: the ratio-2 layer, the candidate","+    source, and a consumer whose candidate rows of other ranks hold junk must","+    select what the replicated run selects for them, and the exchange puts","+    every row back in token order. Rows compare as sets: the top-k order","+    within a row depends on the batch shape.\"\"\"","+    from vllm.v1.attention.ops.shardq import ShardQSplit, zigzag_split","+","+    set_random_seed(0)","+    # The first request is too short to reach every rank.","+    seq_lens, new_tokens = [1400, 900, 1600], [2, 500, 1600]","+    chunk_bounds = [(0, 2, 0, 502), (2, 3, 502, 1302), (2, 3, 1302, 2102)]","+    case = _Case(seq_lens, 128)","+    rows = [","+        (req, n - q + i)","+        for req, (n, q) in enumerate(zip(seq_lens, new_tokens))","+        for i in range(q)","+    ]","+    num_rows = len(rows)","+    query_start_loc = [0, *itertools.accumulate(new_tokens)]","+    q, q_scale, weights, _ = _queries(num_rows)","+    hidden = torch.empty(num_rows, 1, device=DEVICE)","+    token_ids, counts = zigzag_split(np.array(new_tokens), world)","+    split = ShardQSplit(0, token_ids, counts)","+","+    def layers(tokens, pool):","+        \"\"\"The three layers over `tokens` (all rows when None).\"\"\"","+        meta_rows, bounds, qsl, shardq = rows, chunk_bounds, query_start_loc, None","+        if tokens is not None:","+            meta_rows = [rows[t] for t in tokens]","+            compact = np.searchsorted(tokens, [b[2:] for b in chunk_bounds])","+            bounds = [","+                (lo, hi, t0, t1)","+                for (lo, hi, _, _), (t0, t1) in zip(chunk_bounds, compact)","+                if t1 > t0","+            ]","+            qsl = np.searchsorted(tokens, query_start_loc).tolist()","+            shardq = (split, torch.from_numpy(tokens).to(DEVICE))","+","+        def run(op, ratio, *args, **kwargs):","+            metadata = _prefill_metadata(","+                case, meta_rows, ratio, bounds, qsl, 128, gather, shardq","+            )","+            _forward_context(monkeypatch, metadata)","+            out = torch.full((num_rows, TOPK), 7, dtype=torch.int32, device=DEVICE)","+            op(hidden, \"indexer\", case.cache[ratio], q, q_scale, weights, TOPK,","+               HEAD_DIM, MAX_LEN // ratio, out, *args, **kwargs)  # fmt: skip","+            return out","+","+        return (","+            run(ops.rocm_mxfp4_sparse_attn_indexer, 2, compress_ratio=2),","+            run(","+                ops.rocm_mxfp4_sparse_attn_indexer,","+                1,","+                compress_ratio=1,","+                candidate_blocks=pool,","+                candidate_block_size=CAND_BLOCK,","+                candidate_write=True,","+            ),","+            run(","+                ops.rocm_mxfp4_sparse_mqa_indexer,","+                1,","+                1,","+                pool,","+                CAND_BLOCK,","+                POOL_BLOCKS * CAND_BLOCK,","+            ),","+        )","+","+    def sets(t):","+        return t.sort(dim=-1).values","+","+    ref_pool = torch.empty(num_rows, POOL_BLOCKS, dtype=torch.int32, device=DEVICE)","+    ref = layers(None, ref_pool)","+    for rank in range(world):","+        start = counts[:rank].sum()","+        tokens = token_ids[start : start + counts[rank]]","+        mine = torch.from_numpy(tokens).to(DEVICE)","+        gathered: list[torch.Tensor] = []","+","+        def all_gatherv(local, dim, sizes, gathered=gathered):","+            gathered.append(local.clone())","+            # The other ranks' rows, so the exchange can be checked whole.","+            return ref[len(gathered) - 1][torch.from_numpy(token_ids).to(DEVICE)]","+","+        group = types.SimpleNamespace(rank_in_group=rank, all_gatherv=all_gatherv)","+        monkeypatch.setattr(rocm_aiter_mla_sparse, \"get_tp_group\", lambda g=group: g)","+        pool = torch.randint(0, 200, ref_pool.shape, dtype=torch.int32, device=DEVICE)","+        outs = layers(tokens, pool)","+        assert len(gathered) == 3","+        for local, out, want in zip(gathered, outs, ref):","+            assert torch.equal(sets(local), sets(want[mine]))","+            assert torch.equal(sets(out), sets(want))","+        assert torch.equal(sets(pool[: len(tokens)]), sets(ref_pool[mine]))"],"additions":113,"deletions":3,"truncated":false},{"path":"tests/v1/attention/test_rocm_paged_mxfp4_indexer_plan.py","lines":["@@ -44,7 +44,7 @@"," from vllm.v1.kv_cache_interface import MLAAttentionSpec"," "," ","-def _chunk(block_table, token_start, token_end, row_ends):","+def _chunk(block_table, req_start, token_start, token_end, row_ends):","     ends = torch.tensor(row_ends, dtype=torch.int32)","     return DeepseekV32IndexerPrefillChunkMetadata(","         block_table=block_table,","@@ -57,6 +57,7 @@ def _chunk(block_table, token_start, token_end, row_ends):","         token_start=token_start,","         token_end=token_end,","         num_reqs=block_table.shape[0],","+        req_start=req_start,","     )"," "," ","@@ -66,9 +67,9 @@ def _chunk(block_table, token_start, token_end, row_ends):"," SEQ_LENS = torch.tensor([40, 10, 12, 21, 64])"," BLOCK_TABLE = torch.arange(20, dtype=torch.int32).view(5, 4)"," CHUNKS = [","-    _chunk(BLOCK_TABLE[1:4], 1, 12, list(range(11))),","-    _chunk(BLOCK_TABLE[4:5], 12, 15, [29, 30, 30]),","-    _chunk(BLOCK_TABLE[4:5], 15, 18, [31, 31, 32]),","+    _chunk(BLOCK_TABLE[1:4], 1, 1, 12, list(range(11))),","+    _chunk(BLOCK_TABLE[4:5], 4, 12, 15, [29, 30, 30]),","+    _chunk(BLOCK_TABLE[4:5], 4, 15, 18, [31, 31, 32]),"," ]"," "," ","@@ -453,3 +454,45 @@ def test_decode_metadata_matches_torch_path(monkeypatch, cls, ratio, adaptive):","             assert torch.equal(a, b) and a.data_ptr() == buf.data_ptr()","         assert out.decode.block_table.shape == ref.decode.block_table.shape","         assert out.decode.requires_padding == ref.decode.requires_padding","+","+","+def test_prefill_plans_on_shardq_query_ranges(monkeypatch):","+    \"\"\"Under ShardQ the chunks cover this rank's tokens, so they are planned on","+    the renumbered query ranges; the rank holds none of the first request.\"\"\"","+    chunks = [","+        _chunk(BLOCK_TABLE[0:2], 0, 0, 3, [1, 2, 3]),","+        _chunk(BLOCK_TABLE[2:3], 2, 3, 7, [1, 2, 3, 4]),","+    ]","+    base = DeepseekV32IndexerMetadata(","+        seq_lens=SEQ_LENS[:3],","+        max_seq_len=64,","+        slot_mapping=torch.zeros(16),","+        num_decodes=0,","+        num_decode_tokens=0,","+        num_prefills=3,","+        num_prefill_tokens=16,","+        prefill=types.SimpleNamespace(","+            chunks=chunks,","+            shardq_query_start_loc_cpu=torch.tensor([0, 0, 3, 7], dtype=torch.int32),","+        ),","+    )","+    monkeypatch.setattr(DeepseekV32IndexerMetadataBuilder, \"build\", lambda *a: base)","+    builder = object.__new__(RocmMxfp4IndexerMetadataBuilder)","+    builder.__dict__.update(","+        compress_ratio=2,","+        context_lens_buffer=torch.zeros(3, dtype=torch.int32),","+        candidate_block_size=0,","+        min_gather_width=None,","+        device=torch.device(\"cpu\"),","+    )","+    query_start_loc = torch.tensor([0, 2, 8, 16], dtype=torch.int32)","+    cm = types.SimpleNamespace(","+        num_reqs=3,","+        seq_lens=SEQ_LENS[:3],","+        seq_lens_cpu_upper_bound=SEQ_LENS[:3],","+        query_start_loc=query_start_loc,","+        query_start_loc_cpu=query_start_loc,","+    )","+    plans = builder.build(0, cm).prefill_plans","+    assert [p.requests for p in plans] =