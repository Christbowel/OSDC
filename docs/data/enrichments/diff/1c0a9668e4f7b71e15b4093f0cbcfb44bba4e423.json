       }","     },","   };"],"additions":12,"deletions":5,"truncated":false},{"path":"sdk/core/core-rest-pipeline/src/policies/bearerTokenAuthenticationPolicy.ts","lines":["@@ -9,6 +9,7 @@ import { createTokenCycler } from \"../util/tokenCycler.js\";"," import { logger as coreLogger } from \"../log.js\";"," import type { RestError } from \"../restError.js\";"," import { isRestError } from \"../restError.js\";","+import { disposeResponseBody } from \"@typespec/ts-http-runtime/internal/util\";"," "," /**","  * The programmatic identifier of the bearerTokenAuthenticationPolicy.","@@ -263,6 +264,7 @@ export function bearerTokenAuthenticationPolicy(","           );","           // Send updated request and handle response for RestError","           if (shouldSendRequest) {","+            await disposeResponseBody(response);","             [response, error] = await trySendRequest(request, next);","           }","         } else if (callbacks.authorizeRequestOnChallenge) {","@@ -277,6 +279,7 @@ export function bearerTokenAuthenticationPolicy("," ","           // Send updated request and handle response for RestError","           if (shouldSendRequest) {","+            await disposeResponseBody(response);","             [response, error] = await trySendRequest(request, next);","           }"," ","@@ -306,6 +309,7 @@ export function bearerTokenAuthenticationPolicy(","               );","               // Send updated request and handle response for RestError","               if (shouldSendRequest) {","+                await disposeResponseBody(response);","                 [response, error] = await trySendRequest(request, next);","               }","             }"],"additions":4,"deletions":0,"truncated":false},{"path":"sdk/core/core-rest-pipeline/src/policies/wrapAbortSignalLikePolicy.ts","lines":["@@ -3,6 +3,8 @@"," "," import { type PipelinePolicy } from \"../pipeline.js\";"," import { wrapAbortSignalLike } from \"#platform/wrapAbortSignal\";","+import type { PipelineResponse } from \"../interfaces.js\";","+import { cleanupOnRequestResponseCompletion } from \"../util/cleanupOnCompletion.js\";"," "," export const wrapAbortSignalLikePolicyName = \"wrapAbortSignalLikePolicy\";"," ","@@ -20,12 +22,18 @@ export function wrapAbortSignalLikePolicy(): PipelinePolicy {","         return next(request);","       }"," ","-      const { abortSignal, cleanup } = wrapAbortSignalLike(request.abortSignal);","+      const originalAbortSignal = request.abortSignal;","+      const { abortSignal, cleanup } = wrapAbortSignalLike(originalAbortSignal);","       request.abortSignal = abortSignal;","+      let response: PipelineResponse | undefined;","       try {","-        return await next(request);","+        response = await next(request);","+        return response;","       } finally {","-        cleanup?.();","+        request.abortSignal = originalAbortSignal;","+        if (cleanup) {","+          cleanupOnRequestResponseCompletion(response, cleanup);","+        }","       }","     },","   };"],"additions":11,"deletions":3,"truncated":false},{"path":"sdk/core/core-rest-pipeline/src/util/cleanupOnCompletion.ts","lines":["@@ -0,0 +1,76 @@","+// Copyright (c) Microsoft Corporation.","+// Licensed under the MIT License.","+","+import {","+  getRequestCompletion,","+  getResponseBodyCompletion,","+} from \"@typespec/ts-http-runtime/internal/util\";","+import { logger } from \"../log.js\";","+","+/**","+ * Runs the cleanup callback associated with the response and its request once they are complete.","+ */","+export function cleanupOnRequestResponseCompletion(","+  response:","+    | {","+        readableStreamBody?: {","+          readable: boolean;","+          once(event: string, listener: () => void): unknown;","+          removeListener(event: string, listener: () => void): unknown;","+        };","+      }","+    | undefined,","+  cleanup: () => void,","+): void {","+  const stream = response?.readableStreamBody;","+  const requestCompletion = response ? getRequestCompletion(response) : undefined;","+  const browserResponseCompletion = response ? getResponseBodyCompletion(response) : undefined;","+  let requestDone = requestCompletion === undefined;","+  let nodeResponseDone = !stream || !stream.readable;","+  let browserResponseDone = browserResponseCompletion === undefined;","+  let cleanedUp = false;","+  const cleanupIfComplete = (): void => {","+    if (cleanedUp || !requestDone || !nodeResponseDone || !browserResponseDone) {","+      return;","+    }","+    cleanedUp = true;","+    cleanup();","+  };","+  const onResponseComplete = (): void => {","+    stream?.removeListener(\"end\", onResponseComplete);","+    stream?.removeListener(\"close\", onResponseComplete);","+    stream?.removeListener(\"error\", onResponseComplete);","+    nodeResponseDone = true;","+    try {","+      cleanupIfComplete();","+    } catch (error: unknown) {","+      logger.warning(\"Error cleaning up after response stream completion\", error);","+    }","+  };","+  if (!nodeResponseDone && stream) {","+    stream.once(\"end\", onResponseComplete);","+    stream.once(\"close\", onResponseComplete);","+    stream.once(\"error\", onResponseComplete);","+  }","+  if (requestCompletion) {","+    requestCompletion","+      .then(() => {","+        requestDone = true;","+        return cleanupIfComplete();","+      })","+      .catch((error: unknown) => {","+        logger.warning(\"Error cleaning up after request completion\", error);","+      });","+  }","+  if (browserResponseCompletion) {","+    browserResponseCompletion","+      .then(() => {","+        browserResponseDone = true;","+        return cleanupIfComplete();","+      })","+      .catch((error: unknown) => {","+        logger.warning(\"Error cleaning up after response body completion\", error);","+      });","+  }","+  cleanupIfComplete();","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"sdk/core/core-rest-pipeline/test/internal/bearerTokenAuthenticationPolicy.spec.ts","lines":["@@ -1381,6 +1381,10 @@ describe(\"BearerTokenAuthenticationPolicy\", function () {","       }),","     };","     const request = defaultRequest();","+    const cancel = vi.fn();","+    const browserStreamBody = {","+      cancel,","+    } as unknown as NonNullable<PipelineResponse[\"browserStreamBody\"]>;"," ","     // CAE challenge with valid claims","     const caeResponse: PipelineResponse = {","@@ -1389,6 +1393,7 @@ describe(\"BearerTokenAuthenticationPolicy\", function () {","       }),","       request,","       status: 401,","+      browserStreamBody,","     };"," ","     const successResponse: PipelineResponse = {","@@ -1408,6 +1413,7 @@ describe(\"BearerTokenAuthenticationPolicy\", function () {","     const response = await policy.sendRequest(request, next);","     assert.equal(response.status, 200);","     expect(next).toHaveBeenCalledTimes(2);","+    expect(cancel).toHaveBeenCalledOnce();","   });"," ","   it(\"handles custom challenge then CAE challenge when scopes is a string\", async function () {"],"additions":6,"deletions":0,"truncated":false},{"path":"sdk/core/core-rest-pipeline/test/internal/browser/fetchHttpClient.spec.ts","lines":["@@ -150,6 +150,34 @@ describe(\"FetchHttpClient\", function () {","     await expect(readAll()).rejects.toMatchObject({ name: \"AbortError\" });","   });"," ","+  it(\"keeps a legacy abort signal connected until a browser response stream is canceled\", async function () {","+    const removeEventListener = vi.fn();","+    const abortSignal: AbortSignalLike = {","+      aborted: false,","+      addEventListener: vi.fn(),","+      removeEventListener,","+    };","+    const responseBody = new ReadableStream({","+      pull(): void {","+        // Keep the response pending until the caller cancels it.","+      },","+    });","+    vi.mocked(fetch).mockResolvedValue(new Response(responseBody, { status: 200 }));","+    const request = createPipelineRequest({","+      url: \"https://localhost/legacy-abort-stream\",","+      abortSignal,","+      enableBrowserStreams: true,","+      streamResponseStatusCodes: new Set([200]),","+    });","+","+    const response = await createDefaultHttpClient().sendRequest(request);","+","+    expect(removeEventListener).not.toHaveBeenCalled();","+    await response.browserStreamBody?.cancel();","+    await Promise.resolve();","+    expect(removeEventListener).toHaveBeenCalledOnce();","+  });","+","   it(\"shouldn't be affected by requests cancelled late\", async function () {","     const blob = new Blob();","     const mockedResponse = new Response(blob, { status: 200 });"],"additions":28,"deletions":0,"truncated":false},{"path":"sdk/core/core-rest-pipeline/test/internal/cleanupOnCompletion.spec.ts","lines":["@@ -0,0 +1,184 @@","+// Copyright (c) Microsoft Corporation.","+// Licensed under the MIT License.","+","+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";","+import {","+  getRequestCompletion,","+  getResponseBodyCompletion,","+} from \"@typespec/ts-http-runtime/internal/util\";","+import { cleanupOnRequestResponseCompletion } from \"../../src/util/cleanupOnCompletion.js\";","+import { logger } from \"../../src/log.js\";","+","+vi.mock(import(\"@typespec/ts-http-runtime/internal/util\"), async (importOriginal) => {","+  const original = await importOriginal();","+  return {","+    ...original,","+    getRequestCompletion: vi.fn(original.getRequestCompletion),","+    getResponseBodyCompletion: vi.fn(original.getResponseBodyCompletion),","+  };","+});","+","+function deferred(): { promise: Promise<void>; resolve: () => void } {","+  let resolveCompletion!: () => void;","+  const promise = new Promise<void>((resolve) => {","+    resolveCompletion = resolve;","+  });","+  return { promise, resolve: resolveCompletion };","+}","+","+function createResponseStream(): {","+  stream: {","+    readable: boolean;","+    once(event: string, listener: () => void): void;","+    removeListener(event: string): void;","+  };","+  complete(event?: string): void;","+} {","+  const listeners = new Map<string, () => void>();","+  const stream = {","+    readable: true,","+    once(event: string, listener: () => void) {","+      listeners.set(event, listener);","+    },","+    removeListener(event: string) {","+      listeners.delete(event);","+    },","+  };","+  return {","+    stream,","+    complete(event = \"end\") {","+      stream.readable = false;","+      listeners.get(event)?.();","+    },","+  };","+}","+","+describe(\"cleanupOnRequestResponseCompletion\", () => {","+  beforeEach(() => {","+    vi.mocked(getRequestCompletion).mockReset();","+    vi.mocked(getResponseBodyCompletion).mockReset();","+  });","+","+  afterEach(() => {","+    vi.restoreAllMocks();","+  });","+","+  it.each([","+    {","+      completionType: \"request\",","+      getCompletion: getRequestCompletion,","+      message: \"Error cleaning up after request completion\",","+    },","+    {","+      completionType: \"response body\",","+      getCompletion: getResponseBodyCompletion,","+      message: \"Error cleaning up after response body completion\",","+    },","+  ])(\"logs cleanup errors after $completionType completion\", async ({ getCompletion, message }) => {","+    const completion = deferred();","+    vi.mocked(getCompletion).mockReturnValueOnce(completion.promise);","+    const failure = new Error(\"cleanup failed\");","+    const cleanup = vi.fn(() => {","+      throw failure;","+    });","+    const warning = vi.spyOn(logger, \"warning\").mockImplementation(() => {});","+","+    cleanupOnRequestResponseCompletion({}, cleanup);","+    expect(cleanup).not.toHaveBeenCalled();","+","+    completion.resolve();","+    await completion.promise;","+    await Promise.resolve();","+","+    expect(cleanup).toHaveBeenCalledOnce();","+    expect(warning).toHaveBeenCalledExactlyOnceWith(message, failure);","+  });","+","+  it.each([\"end\", \"close\", \"error\"])(","+    \"logs cleanup errors when the response stream completes last via %s\",","+    (event) => {","+      const responseStream = createResponseStream();","+      const failure = new Error(\"cleanup failed\");","+      const cleanup = vi.fn(() => {","+        throw failure;","+      });","+      const warning = vi.spyOn(logger, \"warning\").mockImplementation(() => {});","+","+      cleanupOnRequestResponseCompletion({ readableStreamBody: responseStream.stream }, cleanup);","+","+      expect(() => responseStream.complete(event)).not.toThrow();","+      expect(cleanup).toHaveBeenCalledOnce();","+      expect(warning).toHaveBeenCalledExactlyOnceWith(","+        \"Error cleaning up after response stream completion\",","+        failure,","+      );","+","+      responseStream.complete(event);","+      expect(cleanup).toHaveBeenCalledOnce();","+      expect(warning).toHaveBeenCalledOnce();","+    },","+  );","+","+  it(\"waits for response stream completion\", async () => {","+    const responseStream = createResponseStream();","+    const response = { readableStreamBody: responseStream.stream };","+    const cleanup = vi.fn();","+","+    cleanupOnRequestResponseCompletion(response, cleanup);","+    expect(cleanup).not.toHaveBeenCalled();","+","+    responseStream.complete();","+    await Promise.resolve();","+    expect(cleanup).toHaveBeenCalledOnce();","+  });","+","+  it(\"waits for request completion when the response is already complete\", async () => {","+    const response = {};","+    const requestCompletion = deferred();","+    vi.mocked(getRequestCompletion).mockReturnValueOnce(requestCompletion.promise);","+    const cleanup = vi.fn();","+","+    cleanupOnRequestResponseCompletion(response, cleanup);","+    await Promise.resolve();","+    expect(cleanup).not.toHaveBeenCalled();","+","+    requestCompletion.resolve();","+    await requestCompletion.promise;","+    expect(cleanup).toHaveBeenCalledOnce();","+  });","+","+  it.each([\"request\", \"response\"])(","+    \"waits for both completions when the %s completes first\",","+    async (firstCompletion) => {","+      const responseStream = createResponseStream();","+      const response = { readableStreamBody: responseStream.stream };","+      const requestCompletion = deferred();","+      vi.mocked(getRequestCompletion).mockReturnValueOnce(requestCompletion.promise);","+      const cleanup = vi.fn();","+","+      cleanupOnRequestResponseCompletion(response, cleanup);","+      expect(cleanup).not.toHaveBeenCalled();","+","+      if (firstCompletion === \"request\") {","+        requestCompletion.resolve();","+      } else {","+        responseStream.complete();","+      }","+      await Promise.resolve();","+      expect(cleanup).not.toHaveBeenCalled();","+","+      if (firstCompletion === \"request\") {","+        responseStream.complete();","+      } else {","+        requestCompletion.resolve();","+      }","+      await requestCompletion.promise;","+      expect(cleanup).toHaveBeenCalledOnce();","+","+      responseStream.complete();","+      requestCompletion.resolve();","+      await Promise.resolve();","+      expect(cleanup).toHaveBeenCalledOnce();","+    },","+  );","+});"],"additions":184,"deletions":0,"truncated":false},{"path":"sdk/core/core-rest-pipeline/test/internal/wrapAbortSignalLikePolicy.spec.ts","lines":["@@ -4,6 +4,8 @@"," import { describe, it, expect, vi, afterEach } from \"vitest\";"," import { wrapAbortSignalLikePolicy } from \"../../src/policies/wrapAbortSignalLikePolicy.js\";"," import { createPipelineRequest } from \"../../src/pipelineRequest.js\";","+import { createHttpHeaders } from \"../../src/httpHeaders.js\";","+import type { PipelineResponse, SendRequest } from \"../../src/interfaces.js\";"," import type { AbortSignalLike } from \"@azure/abort-controller\";"," "," describe(\"wrapAbortSignalLikePolicy\", () => {","@@ -13,7 +15,7 @@ describe(\"wrapAbortSignalLikePolicy\", () => {"," ","   it(\"should wrap AbortSignalLike with native AbortSignal\", async () => {","     const policy = wrapAbortSignalLikePolicy();","-    const nextSpy = vi.fn().mockResolvedValue({ status: 200 });","+    let receivedSignal: AbortSignalLike | undefined;"," ","     // Create a mock AbortSignalLike","     const mockAbortSignalLike: AbortSignalLike = {","@@ -26,21 +28,30 @@ describe(\"wrapAbortSignalLikePolicy\", () => {","       url: \"https://example.com\",","       abortSignal: mockAbortSignalLike,","     });","+    const response: PipelineResponse = {","+      status: 200,","+      headers: createHttpHeaders(),","+      request,","+    };","+    const nextSpy = vi.fn<SendRequest>().mockImplementation((nextRequest) => {","+      receivedSignal = nextRequest.abortSignal;","+      return Promise.resolve(response);","+    });"," ","     const result = await policy.sendRequest(request, nextSpy);"," ","     expect(nextSpy).toHaveBeenCalledTimes(1);","-    // The abortSignal should be replaced with a native AbortSignal","-    expect(nextSpy.mock.calls[0][0].abortSignal).toBeInstanceOf(AbortSignal);","-    expect(result).toEqual({ status: 200 });","+    expect(receivedSignal).toBeInstanceOf(AbortSignal);","+    expect(result).toBe(response);","     expect(mockAbortSignalLike.addEventListener).toHaveBeenCalledOnce();","     expect(mockAbortSignalLike.removeEventListener).toHaveBeenCalledOnce();","+    expect(request.abortSignal).toBe(mockAbortSignalLike);","   });"," ","-  it(\"should clean up even if next handler throws\", async () => {","+  it(\"should restore the original AbortSignalLike if next handler throws\", async () => {","     const policy = wrapAbortSignalLikePolicy();","     const error = new Error(\"Test error\");","-    const nextSpy = vi.fn().mockRejectedValue(error);","+    const nextSpy = vi.fn<SendRequest>().mockRejectedValue(error);"," ","     const mockAbortSignalLike: AbortSignalLike = {","       aborted: false,","@@ -55,7 +66,6 @@ describe(\"wrapAbortSignalLikePolicy\", () => {"," ","     await expect(policy.sendRequest(request, nextSpy)).rejects.toThrow(error);"," ","-    // Verify cleanup still happened despite error","-    expect(mockAbortSignalLike.removeEventListener).toHaveBeenCalled();","+    expect(request.abortSignal).toBe(mockAbortSignalLike);","   });"," });"],"additions":18,"deletions":8,"truncated":false},{"path":"sdk/core/ts-http-runtime/CHANGELOG.md","lines":["@@ -10,6 +10,7 @@"," "," ### Bugs Fixed"," ","+- Release discarded response streams before redirects and retries, preserve cancellation and abort-signal cleanup across buffered and streamed responses, reject prematurely closed Node upload and buffered response streams, prevent unhandled Node upload errors during teardown, and honor method overrides when converting 303 redirects to GET. [#40251](https://github.com/Azure/azure-sdk-for-js/issues/40251)"," - Binary request bodies supplied as `ArrayBuffer`, `DataView`, or typed arrays other than `Uint8Array` are now sent as their original bytes instead of being JSON serialized. [#40382](https://github.com/Azure/azure-sdk-for-js/pull/40382)"," - Client requests now look up the `content-type` and `accept` entries of the `headers` request option without regard to how the header name is capitalized. Only the all lower case spellings were found before, so `headers: { \"Content-Type\": \"application/xml\" }` and `headers: { \"Accept\": \"text/plain\" }` were replaced by the default `application/json`. Both entries are now read back from the headers that will be sent, so the same value decides the header and how the body is encoded: a header name given under two spellings resolves to the last one in the object, a `content-type` value that is not a string, such as a number, is used as its string form rather than ignored, and a padded value selects the encoding of its trimmed form. [#39791](https://github.com/Azure/azure-sdk-for-js/pull/39791)"," "],"additions":1,"deletions":0,"truncated":false},{"path":"sdk/core/ts-http-runtime/review/ts-http-runtime-internal-util-node.api.md","lines":["@@