{"id":"d702e934c17c90c57470d7743de52bb05c48f29b","axis":"silent","repo":"pnpm/pnpm","sha":"d702e934c17c90c57470d7743de52bb05c48f29b","parsed":{"files":[{"path":".changeset/validate-no-proxy-setting.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/config.reader\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Reject unsupported types for the `noProxy` setting in workspace and global configuration. Strings and booleans remain valid, and `null` leaves the setting unset. Previously, unsupported values could reach proxy resolution without a validation error."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_settings.rs","lines":["@@ -19,10 +19,7 @@ use super::{","     naming_cases::to_camel_case,","     note_declared_registries,","     resolve_configured_state_dir,","-    workspace_yaml::{","-        parse_settings_file,","-        read_workspace_document,","-    },","+    workspace_yaml::read_workspace_document,"," };"," "," impl Config {","@@ -291,7 +288,7 @@ fn read_env_workspace_yaml<Sys: EnvVar>(","         return Ok((env_dir, None));","     };","     let settings = WorkspaceSettings::read_document(document, settings_read, |text, path| {","-        parse_settings_file::<Sys, WorkspaceSettings>(text, path)","+        WorkspaceSettings::read_valid_with::<Sys>(text, path)","     })?;","     Ok((env_dir, Some(settings)))"," }"],"additions":2,"deletions":5,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/error.rs","lines":["@@ -14,6 +14,9 @@ use super::{"," #[derive(Debug, Display, Error, Diagnostic)]"," #[non_exhaustive]"," pub enum LoadWorkspaceYamlError {","+    #[display(\"The \\\"noProxy\\\" setting should be a boolean or string, but got {received_type}\")]","+    #[diagnostic(code(ERR_PNPM_INVALID_SETTING))]","+    InvalidNoProxy { received_type: &'static str },","     #[display(\"Failed to read pnpm-workspace.yaml at {}: {source}\", path.display())]","     ReadFile {","         path: PathBuf,"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/settings.rs","lines":["@@ -10,6 +10,7 @@ use super::{","     ConfigDependency,","     Deserialize,","     Deserializer,","+    EnvVar,","     HashMap,","     HoistingLimits,","     IndexMap,","@@ -850,15 +851,18 @@ impl WorkspaceSettings {","         read_workspace_document(dir)?","             .map(|document| {","                 Self::read_document(document, settings_read, |text, path| {","-                    Self::read_valid(text, path)","+                    Self::read_valid_with::<SystemEnv>(text, path)","                 })","             })","             .transpose()","     }"," ","     /// Parse and validate the text of the `pnpm-workspace.yaml` at `path`.","-    fn read_valid(text: &str, path: &Path) -> Result<Self, LoadWorkspaceYamlError> {","-        let settings = parse_settings_file::<SystemEnv, Self>(text, path)?;","+    pub(crate) fn read_valid_with<Sys: EnvVar>(","+        text: &str,","+        path: &Path,","+    ) -> Result<Self, LoadWorkspaceYamlError> {","+        let settings = parse_settings_file::<Sys, Self>(text, path)?;","         settings.validate_all_sections()?;","         settings.reject_repo_controlled_trust_material(path)?;","         Ok(settings)"],"additions":7,"deletions":3,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests.rs","lines":["@@ -138,4 +138,6 @@ mod env_placeholders;"," "," mod readable_settings;"," ","+mod no_proxy;","+"," mod side_effects_cache_exclude;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/no_proxy.rs","lines":["@@ -0,0 +1,139 @@","+use super::{","+    Config,","+    EnvVar,","+    GetHomeDir,","+    LoadWorkspaceYamlError,","+    WORKSPACE_MANIFEST_FILENAME,","+    WorkspaceSettings,","+    fs,","+};","+use crate::api::{","+    EnvVarOs,","+    GetCurrentDir,","+    LinkProbe,","+};","+use std::{","+    ffi::OsString,","+    io,","+    path::{","+        Path,","+        PathBuf,","+    },","+    sync::OnceLock,","+};","+","+#[test]","+fn rejects_invalid_no_proxy_types() {","+    for (value, expected_type) in","+        [(\"123\", \"number\"), (\"[]\", \"array\"), (\"{host: localhost}\", \"object\")]","+    {","+        let dir = tempfile::tempdir().unwrap();","+        fs::write(dir.path().join(WORKSPACE_MANIFEST_FILENAME), format!(\"noProxy: {value}\\n\"))","+            .unwrap();","+        let error = WorkspaceSettings::load_at(dir.path()).unwrap_err();","+        dbg!(&error);","+        let prefix = r#\"The \"noProxy\" setting should be a boolean or string, but got\"#;","+        assert_eq!(error.to_string(), format!(\"{prefix} {expected_type}\"));","+    }","+}","+","+#[test]","+fn accepts_no_proxy_strings_booleans_and_null() {","+    for value in [\"true\", \"false\", \"''\", \"'null'\", \"'localhost,127.0.0.1'\", \"null\"] {","+        let dir = tempfile::tempdir().unwrap();","+        fs::write(dir.path().join(WORKSPACE_MANIFEST_FILENAME), format!(\"noProxy: {value}\\n\"))","+            .unwrap();","+        let settings = WorkspaceSettings::load_at(dir.path()).unwrap().unwrap();","+        let expected = serde_saphyr::from_str::<Option<serde_json::Value>>(value).unwrap();","+        assert_eq!(settings.no_proxy, expected);","+    }","+}","+","+#[test]","+fn skips_invalid_no_proxy_without_dropping_other_settings() {","+    let mut settings: WorkspaceSettings =","+        serde_saphyr::from_str(\"noProxy: [localhost]\\nregistry: https://registry.example/\\n\")","+            .unwrap();","+    settings.drop_invalid_sections();","+    assert_eq!(settings.no_proxy, None);","+    assert_eq!(settings.registry.as_deref(), Some(\"https://registry.example/\"));","+}","+","+#[test]","+fn global_no_proxy_is_validated_and_can_be_skipped() {","+    let dir = tempfile::tempdir().unwrap();","+    fs::write(","+        dir.path().join(crate::workspace_yaml::GLOBAL_CONFIG_YAML_FILENAME),","+        \"noProxy: [localhost]\\nregistry: https://registry.example/\\n\",","+    )","+    .unwrap();","+    let error = crate::TrustedSettings::load_global(dir.path()).unwrap_err();","+    dbg!(&error);","+    assert!(matches!(error, LoadWorkspaceYamlError::InvalidNoProxy { received_type: \"array\" }));","+    let trusted =","+        crate::TrustedSettings::load_global_reading(dir.path(), crate::SettingsRead::Readable)","+            .unwrap()","+            .unwrap();","+    assert_eq!(trusted.settings.no_proxy, None);","+    assert_eq!(trusted.settings.registry.as_deref(), Some(\"https://registry.example/\"));","+}","+","+#[test]","+fn env_workspace_override_validates_no_proxy() {","+    let env_workspace = tempfile::tempdir().unwrap();","+    let cwd_dir = tempfile::tempdir().unwrap();","+    fs::write(","+        env_workspace.path().join(WORKSPACE_MANIFEST_FILENAME),","+        \"noProxy: [localhost]\\nregistry: https://registry.example/\\n\",","+    )","+    .unwrap();","+    static ENV_WORKSPACE_PATH: OnceLock<OsString> = OnceLock::new();","+    ENV_WORKSPACE_PATH","+        .set(","+            env_workspace","+                .path()","+                .as_os_str()","+                .to_owned(),","+        )","+        .expect(\"set once\");","+    struct EnvWorkspaceHost;","+    impl EnvVar for EnvWorkspaceHost {","+        fn var(_: &str) -> Option<String> {","+            None","+        }","+    }","+    impl EnvVarOs for EnvWorkspaceHost {","+        fn var_os(name: &str) -> Option<OsString> {","+            (name == \"PNPM_CONFIG_WORKSPACE_DIR\").then(|| {","+                ENV_WORKSPACE_PATH","+                    .get()","+                    .expect(\"initialized\")","+                    .clone()","+            })","+        }","+    }","+    impl GetHomeDir for EnvWorkspaceHost {","+        fn home_dir() -> Option<PathBuf> {","+            None","+        }","+    }","+    impl GetCurrentDir for EnvWorkspaceHost {","+        fn current_dir() -> io::Result<PathBuf> {","+            std::env::current_dir()","+        }","+    }","+    impl LinkProbe for EnvWorkspaceHost {","+        fn can_link_between_dirs(_: &Path, _: &Path) -> bool {","+            false","+        }","+    }","+","+    let error = Config::default().current::<EnvWorkspaceHost>(cwd_dir.path()).unwrap_err();","+    assert!(matches!(error, LoadWorkspaceYamlError::InvalidNoProxy { received_type: \"array\" }));","+","+    let readable = Config { settings_read: crate::SettingsRead::Readable, ..Config::default() }","+        .current::<EnvWorkspaceHost>(cwd_dir.path())","+        .unwrap();","+    assert_eq!(readable.proxy.no_proxy, None);","+    assert_eq!(readable.registry, \"https://registry.example/\");","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/validation.rs","lines":["@@ -19,8 +19,9 @@ use super::{"," };"," "," impl WorkspaceSettings {","-    /// Validate every post-parse section (`registries`, `tasks`, `pipelines`).","+    /// Validate every post-parse section (`noProxy`, `registries`, `tasks`, `pipelines`).","     pub(super) fn validate_all_sections(&self) -> Result<(), LoadWorkspaceYamlError> {","+        self.validate_no_proxy()?;","         self.validate_registries()?;","         self.validate_tasks()?;","         self.validate_pipelines()","@@ -30,6 +31,9 @@ impl WorkspaceSettings {","     /// unreadable section does not take the file's other settings with it","     /// (see [`crate::Config::settings_read`]).","     pub(super) fn drop_invalid_sections(&mut self) {","+        if self.validate_no_proxy().is_err() {","+            self.no_proxy = None;","+        }","         if self.validate_registries().is_err() {","             self.registries = None;","         }","@@ -41,6 +45,19 @@ impl WorkspaceSettings {","         }","     }"," ","+    pub(super) fn validate_no_proxy(&self) -> Result<(), LoadWorkspaceYamlError> {","+        let received_type = match self.no_proxy.as_ref() {","+            None","+            | Some(","+                serde_json::Value::Null | serde_json::Value::String(_) | serde_json::Value::Bool(_),","+            ) => return Ok(()),","+            Some(serde_json::Value::Number(_)) => \"number\",","+            Some(serde_json::Value::Array(_)) => \"array\",","+            Some(serde_json::Value::Object(_)) => \"object\",","+        };","+        Err(LoadWorkspaceYamlError::InvalidNoProxy { received_type })","+    }","+","     /// Reject a `registries` map pnpm would read as something other than what","     /// it says. See [`registries::validate`] for the rules.","     ///"],"additions":18,"deletions":1,"truncated":false},{"path":"pnpm11/config/reader/src/getOptionsFromRootManifest.ts","lines":["@@ -18,6 +18,7 @@ import type {"," } from '@pnpm/types'"," import { map as mapValues } from 'ramda'"," ","+import { normalizeProxySettings } from './proxySettings.js'"," import { translateRegistrySettings } from './registrySettings.js'"," import { replaceEnvInSettings } from './replaceEnvInSettings.js'"," import {","@@ -117,14 +118,6 @@ export function getOptionsFromPnpmSettings (","   return settings"," }"," ","-/** A null proxy leaves the key unset, so a proxy from a lower-priority config file still applies. */","-function normalizeProxySettings (settings: OptionsFromRootManifest): void {","-  for (const key of ['httpProxy', 'httpsProxy'] as const) {","-    if (settings[key] == null) delete settings[key]","-    else assertString(settings[key], key)","-  }","-}","-"," function toGetOptionsFromPnpmSettingsOptions (","   manifestOrOpts: ProjectManifest | GetOptionsFromPnpmSettingsOptions | undefined"," ): GetOptionsFromPnpmSettingsOptions {"],"additions":1,"deletions":8,"truncated":false},{"path":"pnpm11/config/reader/src/proxySettings.ts","lines":["@@ -0,0 +1,19 @@","+import { PnpmError } from '@pnpm/error'","+","+import { assertString, renderReceivedType } from './settingAssertions.js'","+","+/** Null proxy settings leave lower-priority configuration values in place. */","+export function normalizeProxySettings (","+  settings: { httpProxy?: string, httpsProxy?: string, noProxy?: string | boolean }","+): void {","+  for (const key of ['httpProxy', 'httpsProxy', 'noProxy'] as const) {","+    const value = settings[key]","+    if (value == null) {","+      delete settings[key]","+    } else if (key !== 'noProxy') {","+      assertString(value, key)","+    } else if (typeof value !== 'string' && typeof value !== 'boolean') {","+      throw new PnpmError('INVALID_SETTING', `The \"noProxy\" setting should be a boolean or string, but got ${renderReceivedType(value)}`)","+    }","+  }","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"pnpm11/config/reader/test/noProxy.test.ts","lines":["@@ -0,0 +1,29 @@","+import { expect, test } from '@jest/globals'","+import type { PnpmSettings } from '@pnpm/types'","+","+import { getOptionsFromPnpmSettings } from '../src/getOptionsFromRootManifest.js'","+","+test.each([","+  [123, 'number'],","+  [['localhost'], 'array'],","+  [{ host: 'localhost' }, 'object'],","+])('rejects invalid noProxy value %j', (value: unknown, receivedType: string) => {","+  expect(() => getOptionsFromPnpmSettings(process.cwd(), {","+    noProxy: value,","+  } as unknown as PnpmSettings)).toThrow(expect.objectContaining({","+    code: 'ERR_PNPM_INVALID_SETTING',","+    message: `The \"noProxy\" setting should be a boolean or string, but got ${receivedType}`,","+  }))","+})","+","+test.each([true, false, '', 'null', 'localhost,127.0.0.1'])('accepts noProxy %j', (value) => {","+  const options = getOptionsFromPnpmSettings(process.cwd(), { noProxy: value })","+  expect(options.noProxy).toBe(value)","+})","+","+test('treats null noProxy as unset', () => {","+  const options = getOptionsFromPnpmSettings(process.cwd(), {","+    noProxy: null,","+  } as unknown as PnpmSettings)","+  expect(Object.hasOwn(options, 'noProxy')).toBe(false)","+})",""],"additions":29,"deletions":0,"truncated":false}],"additions":227,"deletions":17,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-21T16:31:59.905606+00:00"}