,"+\t\t\t\t}","+\t\t\t\tbody, err := plogotlp.NewExportRequestFromLogs(logs).MarshalProto()","+\t\t\t\trequire.NoError(t, err)","+","+\t\t\t\t// send the push request","+\t\t\t\treq := httptest.NewRequest(http.MethodPost, \"/otlp/v1/logs\", bytes.NewReader(body))","+\t\t\t\treq = req.WithContext(user.InjectOrgID(t.Context(), \"test\"))","+\t\t\t\treq.Header.Set(\"Content-Type\", \"application/x-protobuf\")","+\t\t\t\tresponse := httptest.NewRecorder()","+\t\t\t\td.OTLPPushHandler(response, req)","+\t\t\t\trequire.Equal(t, tc.status, response.Code, response.Body.String())","+","+\t\t\t\t// if the push is expected to fail, ingesters should not receive any data","+\t\t\t\tif tc.status != http.StatusNoContent {","+\t\t\t\t\trequire.Nil(t, ing.Peek())","+\t\t\t\t\treturn","+\t\t\t\t}","+","+\t\t\t\t// read the data pushed to mock ingester and verify it","+\t\t\t\tgot := ing.Peek()","+\t\t\t\trequire.NotNil(t, got)","+\t\t\t\trequire.Len(t, got.Streams, 1)","+\t\t\t\trequire.Equal(t, `{service_name=\"test-service\"}`, got.Streams[0].Labels)","+\t\t\t\trequire.Len(t, got.Streams[0].Entries, 2)","+\t\t\t\tfor i, entry := range got.Streams[0].Entries {","+\t\t\t\t\trequire.Equal(t, fmt.Sprint(i), entry.Line)","+\t\t\t\t\trequire.True(t, at.Add(time.Duration(i)*time.Second).Equal(entry.Timestamp))","+\t\t\t\t\trequire.ElementsMatch(t, []logproto.LabelAdapter{","+\t\t\t\t\t\t{Name: \"entry_key\", Value: \"entry\"},","+\t\t\t\t\t\t{Name: \"resource_key\", Value: \"resource\"},","+\t\t\t\t\t\t{Name: \"scope_key\", Value: \"scope\"},","+\t\t\t\t\t}, entry.StructuredMetadata)","+\t\t\t\t}","+\t\t\t\tif tc.kafkaEnabled {","+\t\t\t\t\trequire.Len(t, producer.records, 1)","+\t\t\t\t\tvar nested logproto.InternalStreamAdapter","+\t\t\t\t\tif deferExpansion {","+\t\t\t\t\t\trequire.NoError(t, nested.Unmarshal(producer.records[0].Value))","+\t\t\t\t\t\trequire.Equal(t, []logproto.LabelAdapter{{Name: \"resource_key\", Value: \"resource\"}}, nested.ResourceLogs[0].Attrs)","+\t\t\t\t\t\tre