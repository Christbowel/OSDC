gs := plog.NewLogs()","+\t\t\tif tc.service != \"\" {","+\t\t\t\tresource := logs.ResourceLogs().AppendEmpty()","+\t\t\t\tresource.Resource().Attributes().PutStr(\"service.name\", tc.service)","+\t\t\t\tscope := resource.ScopeLogs().AppendEmpty()","+\t\t\t\tfor i, r := range tc.records {","+\t\t\t\t\tlogRecord := scope.LogRecords().AppendEmpty()","+\t\t\t\t\tlogRecord.SetTimestamp(pcommon.Timestamp(now.Add(-r.age).UnixNano()))","+\t\t\t\t\tlogRecord.Body().SetStr(fmt.Sprintf(\"entry-%d\", i))","+\t\t\t\t\tlogRecord.Attributes().PutStr(\"route\", r.route)","+\t\t\t\t}","+\t\t\t}","+\t\t\tbody, err := plogotlp.NewExportRequestFromLogs(logs).MarshalProto()","+\t\t\trequire.NoError(t, err)","+","+\t\t\tvar want []forwardedEntry","+\t\t\tfor _, i := range tc.accepted {","+\t\t\t\tr := tc.records[i]","+\t\t\t\twant = append(want, forwardedEntry{","+\t\t\t\t\tlabels:    fmt.Sprintf(\"{route=%q, service_name=%q}\", r.route, tc.service),","+\t\t\t\t\tline:      fmt.Sprintf(\"entry-%d\", i),","+\t\t\t\t\ttimestamp: now.Add(-r.age).UnixNano(),","+\t\t\t\t})","+\t\t\t}","+","+\t\t\tfor _, deferExpansion := range []bool{false, true} {","+\t\t\t\tt.Run(fmt.Sprintf(\"deferExpansion=%t\", deferExpansion), func(t *testing.T) {","+\t\t\t\t\tvar cfg Config","+\t\t\t\t\tflagext.DefaultValues(&cfg)","+\t\t\t\t\tlim := &validation.Limits{}","+\t\t\t\t\tflagext.DefaultValues(lim)","+\t\t\t\t\tlim.SetGlobalOTLPConfig(cfg.OTLPConfig)","+\t\t\t\t\tlim.OTLPConfig.LogAttributes = []push.AttributesConfig{{Action: push.IndexLabel, Attributes: []string{\"route\"}}}","+\t\t\t\t\tlim.DiscoverLogLevels = false","+\t\t\t\t\tif tc.maxValueLength > 0 {","+\t\t\t\t\t\tlim.MaxLabelValueLength = tc.maxValueLength","+\t\t\t\t\t}","+\t\t\t\t\ting := &mockIngester{}","+\t\t\t\t\tdistributors, _ := prepareButDontStart(t, 1, 3, lim, func(string) (ring_client.PoolClient, error) { return ing, nil })","+\t\t\t\t\td := distributors[0]","+\t\t\t\t\td.cfg.OTLPConfig.DeferAttributeExpansion = deferExpansion","+\t\t\t