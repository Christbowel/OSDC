{"id":"b619cf4c5a56caca56958ce368d594c8bc76d9f0","axis":"silent","repo":"pnpm/pnpm","sha":"b619cf4c5a56caca56958ce368d594c8bc76d9f0","parsed":{"files":[{"path":".changeset/fast-update-lockfile-format.md","lines":["@@ -0,0 +1,6 @@","+---","+\"pacquet\": patch","+\"@pnpm/napi\": patch","+---","+","+`pnpm install` with `lockfile.format: v13` now writes `pnpm-lock.yaml` in the v13 format when it updates an existing v9 lockfile without resolving, for example after a dependency is removed. Such an install used to keep the v9 format."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/napi-lockfile-format.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/napi\": minor","+---","+","+The install options accept `lockfileFormat`, which applies the `lockfile.format` setting to the install. Set it to `\"v13\"` to write `pnpm-lock.yaml` in the experimental `lockfileVersion: '13.0'` format."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/config.rs","lines":["@@ -99,6 +99,8 @@ pub struct ConfigOverlay {","     pub offline: Option<bool>,","     pub lockfile: Option<bool>,","     pub prefer_frozen_lockfile: Option<bool>,","+    /// `lockfile.format` — the format the wanted lockfile is written in.","+    pub lockfile_format: Option<pnpm_lockfile::LockfileFormat>,","     pub dedupe_peer_dependents: Option<bool>,","     pub dedupe_peers: Option<bool>,","     pub add_missing_peer_types: Option<bool>,"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/config/overlay.rs","lines":["@@ -128,6 +128,9 @@ pub(super) fn apply_install_flags(config: &mut Config, overlay: &ConfigOverlay)","     if let Some(value) = overlay.prefer_frozen_lockfile {","         config.prefer_frozen_lockfile = value;","     }","+    if let Some(value) = overlay.lockfile_format {","+        config.lockfile_format = value;","+    }"," }"," "," /// Deduplication and peer-resolution settings."],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/install/options.rs","lines":["@@ -52,6 +52,9 @@ pub struct InstallOptions {","     pub lockfile_only: Option<bool>,","     pub frozen_lockfile: Option<bool>,","     pub prefer_frozen_lockfile: Option<bool>,","+    /// `lockfileFormat` — the format the wanted lockfile is written in:","+    /// `\"v9\"` or the experimental `\"v13\"`. The `lockfile.format` setting.","+    pub lockfile_format: Option<String>,","     pub prefer_offline: Option<bool>,","     pub offline: Option<bool>,","     pub virtual_store_dir_max_length: Option<u32>,"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/install/overlay.rs","lines":["@@ -77,6 +77,7 @@ fn build_layout_overlay(","         virtual_store_dir_max_length: options.virtual_store_dir_max_length.map(u64::from),","         enable_global_virtual_store: options.enable_global_virtual_store,","         global_virtual_store_dir: options.global_virtual_store_dir.as_ref().map(PathBuf::from),","+        lockfile_format: parse_lockfile_format(options.lockfile_format.as_deref())?,","         ..overlay","     })"," }","@@ -334,6 +335,20 @@ fn parse_link_workspace_packages(","         .transpose()"," }"," ","+fn parse_lockfile_format(","+    value: Option<&str>,","+) -> napi::Result<Option<pnpm_lockfile::LockfileFormat>> {","+    value","+        .map(|value| match value {","+            \"v9\" => Ok(pnpm_lockfile::LockfileFormat::V9),","+            \"v13\" => Ok(pnpm_lockfile::LockfileFormat::V13),","+            _ => Err(napi::Error::from_reason(format!(","+                r#\"invalid lockfileFormat {value:?} (expected \"v9\" or \"v13\")\"#,","+            ))),","+        })","+        .transpose()","+}","+"," pub(crate) fn parse_import_method(value: &str) -> Option<pnpm_config::PackageImportMethod> {","     match value {","         \"auto\" => Some(pnpm_config::PackageImportMethod::Auto),"],"additions":15,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/install/tests.rs","lines":["@@ -99,6 +99,7 @@ fn install_options() -> InstallOptions {","         lockfile_only: None,","         frozen_lockfile: None,","         prefer_frozen_lockfile: None,","+        lockfile_format: None,","         prefer_offline: None,","         offline: None,","         virtual_store_dir_max_length: None,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/install/tests/configuration.rs","lines":["@@ -118,3 +118,29 @@ fn resolved_config_applies_add_missing_peer_types() {","         );","     }"," }","+","+#[test]","+fn resolved_config_applies_lockfile_format() {","+    let dir = tempfile::tempdir().expect(\"tempdir\");","+","+    for (lockfile_format, expected) in [","+        (Some(\"v13\"), pnpm_lockfile::LockfileFormat::V13),","+        (Some(\"v9\"), pnpm_lockfile::LockfileFormat::V9),","+        (None, pnpm_lockfile::LockfileFormat::V9),","+    ] {","+        let mut options = install_options();","+        options.lockfile_format = lockfile_format.map(str::to_string);","+        let overlay = build_overlay(&options, false).expect(\"overlay\");","+        assert_eq!(resolve_config(dir.path(), &overlay).expect(\"config\").lockfile_format, expected);","+    }","+}","+","+#[test]","+fn an_unknown_lockfile_format_is_rejected() {","+    let mut options = install_options();","+    options.lockfile_format = Some(\"v10\".to_string());","+    let Err(error) = build_overlay(&options, false) else {","+        panic!(r#\"lockfileFormat \"v10\" must be rejected\"#);","+    };","+    assert!(error.reason.contains(\"invalid lockfileFormat\"), \"{}\", error.reason);","+}"],"additions":26,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/install/tests/lockfile.rs","lines":["@@ -47,3 +47,115 @@ fn lockfile_records_overrides_in_declaration_order() {","     let aaa = lockfile.find(\"aaa-unmatched\").expect(\"aaa override recorded\");","     assert!(zzz < aaa, \"overrides must keep declaration order (zzz before aaa), got:\\n{lockfile}\");"," }","+","+#[test]","+fn lockfile_format_selects_the_written_lockfile_version() {","+    let registry = TestRegistry::start();","+    for (lockfile_format, expected_version) in [(Some(\"v13\"), \"13.0\"), (None, \"9.0\")] {","+        let temp_dir = tempfile::tempdir().expect(\"tempdir\");","+        let project_dir = temp_dir.path().join(\"project\");","+        std::fs::create_dir(&project_dir).expect(\"create project dir\");","+        std::fs::write(project_dir.join(\"package.json\"), \"{}\\n\").expect(\"write package.json\");","+","+        let project_dir_string = project_dir.to_string_lossy().into_owned();","+        let mut options = install_options();","+        options.dir = project_dir_string.clone();","+        options.projects = vec![NodeApiProject {","+            root_dir: project_dir_string,","+            manifest: serde_json::json!({","+                \"dependencies\": {","+                    \"@pnpm.e2e/foo\": \"100.0.0\"","+                }","+            }),","+            dependency_manifest: None,","+        }];","+        options.store_dir = Some(","+            temp_dir","+                .path()","+                .join(\"store\")","+                .to_string_lossy()","+                .into_owned(),","+        );","+        options.registries =","+            Some(HashMap::from([(\"default\".to_string(), registry.url().to_string())]));","+        options.lockfile_format = lockfile_format.map(str::to_string);","+","+        run_install_inner(&options, None, EngineMode::Install(None)).expect(\"install\");","+","+        let lockfile =","+            std::fs::read_to_string(project_dir.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+        assert_eq!(","+            lockfile_version(&lockfile),","+            Some(expected_version),","+            \"lockfileFormat {lockfile_format:?} must write lockfileVersion {expected_version}, got:\\n{lockfile}\",","+        );","+    }","+}","+","+/// Removing a dependency is absorbed by the fast lockfile update, which","+/// writes the loaded lockfile instead of a freshly resolved one.","+#[test]","+fn lockfile_format_applies_to_a_fast_updated_lockfile() {","+    let registry = TestRegistry::start();","+    let temp_dir = tempfile::tempdir().expect(\"tempdir\");","+    let project_dir = temp_dir.path().join(\"project\");","+    std::fs::create_dir(&project_dir).expect(\"create project dir\");","+    std::fs::write(project_dir.join(\"package.json\"), \"{}\\n\").expect(\"write package.json\");","+","+    let project_dir_string = project_dir.to_string_lossy().into_owned();","+    let project = |manifest: serde_json::Value| NodeApiProject {","+        root_dir: project_dir_string.clone(),","+        manifest,","+        dependency_manifest: None,","+    };","+    let mut options = install_options();","+    options.dir = project_dir_string.clone();","+    options.projects = vec![project(serde_json::json!({","+        \"dependencies\": {","+            \"@pnpm.e2e/foo\": \"100.0.0\",","+            \"@pnpm.e2e/bar\": \"100.0.0\"","+        }","+    }))];","+    options.store_dir = Some(","+        temp_dir","+            .path()","+            .join(\"store\")","+            .to_string_lossy()","+            .into_owned(),","+    );","+    options.registries = Some(HashMap::from([(\"default\".to_string(), registry.url().to_string())]));","+    run_install_inner(&options, None, EngineMode::Install(None)).expect(\"install with v9\");","+","+    options.projects = vec![project(serde_json::json!({","+        \"dependencies\": {","+            \"@pnpm.e2e/foo\": \"100.0.0\"","+        }","+    }))];","+    options.lockfile_format = Some(\"v13\".to_string());","+    run_install_inner(&options, None, EngineMode::Install(None)).expect(\"install with v13\");","+","+    let lockfile =","+        std::fs::read_to_string(project_dir.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert_eq!(lockfile_version(&lockfile), Some(\"13.0\"), \"got:\\n{lockfile}\");","+    assert!(","+        !lockfile.contains(\"@pnpm.e2e/bar\"),","+        \"the removed dependency is gone, got:\\n{lockfile}\",","+    );","+}","+","+/// The `lockfileVersion` of a lockfile in either the YAML (`9.0`) or the","+/// JSON-shaped (`13.0`) format.","+fn lockfile_version(lockfile: &str) -> Option<&str> {","+    lockfile","+        .lines()","+        .find_map(|line| {","+            line.trim()","+                .strip_prefix(\"lockfileVersion: \")","+                .or_else(|| line.trim().strip_prefix(r#\"\"lockfileVersion\": \"#))","+        })","+        .map(|value| {","+            value","+                .trim_end_matches(',')","+                .trim_matches(['\\'', '\"'])","+        })","+}"],"additions":112,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization/commit.rs","lines":["@@ -353,7 +353,8 @@ pub(super) fn save_relinked_wanted_lockfile(","         && let Some(updated) = save.loaded_wanted_lockfile","     {","         updated","-            .save_to_path(","+            .save_to_path_as(","+                config.lockfile_format,","                 &save.workspace_root.join(config.wanted_lockfile_name()),","                 config.symlinked_lockfile(),","             )"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/npm/napi/index.d.ts","lines":["@@ -142,6 +142,13 @@ export interface InstallOptions extends SharedEngineOptions {","   lockfileOnly?: boolean","   frozenLockfile?: boolean","   preferFrozenLockfile?: boolean","+  /**","+   * The format the wanted lockfile is written in (the `lockfile.format`","+   * setting). `'v13'` writes the experimental `lockfileVersion: '13.0'`","+   * format. When omitted, the `lockfile.format` setting of","+   * `pnpm-workspace.yaml` applies, which defaults to `'v9'`.","+   */","+  lockfileFormat?: 'v9' | 'v13'","   packageImportMethod?: 'auto' | 'hardlink' | 'copy' | 'clone'","   preferOffline?: boolean","   offline?: boolean",""],"additions":7,"deletions":0,"truncated":false}],"additions":182,"deletions":1,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-19T17:58:20.292210+00:00"}