{"id":"039f74759ca230415b95556939217c6510d2ba77","axis":"silent","repo":"numpy/numpy","sha":"039f74759ca230415b95556939217c6510d2ba77","parsed":{"files":[{"path":"doc/release/upcoming_changes/32564.compatibility.rst","lines":["@@ -0,0 +1,9 @@","+StringDType NaN-like inequality comparisons","+-------------------------------------------","+Inequality comparisons involving a NaN-like ``StringDType`` missing value now","+return ``True``, matching floating-point NaN behavior. Previously, both equality","+and inequality returned ``False``. Equality and ordered comparisons still","+return ``False`` for NaN-like missing values.","+","+Filtering with ``arr[arr != \"excluded\"]`` therefore retains NaN-like missing","+values. To exclude them, use ``arr[(~np.isnan(arr)) & (arr != \"excluded\")]``."],"additions":9,"deletions":0,"truncated":false},{"path":"doc/release/upcoming_changes/32564.improvement.rst","lines":["@@ -0,0 +1,14 @@","+StringDType missing-value handling","+----------------------------------","+NumPy's array equality assertions now handle matching missing values in","+``StringDType`` arrays whose sentinel is a NumPy floating-point NaN, such as","+``numpy.float32(\"nan\")``. Previously, these assertions could incorrectly","+report unequal arrays.","+","+For `numpy.unique`, requesting indices, inverse indices, or counts now handles","+NaN-like sentinels consistently: ``equal_nan=True`` groups missing entries,","+while ``equal_nan=False`` keeps them separate. With ``return_index=True``, the","+index returned for grouped missing values now identifies their first occurrence.","+","+Comparisons also correctly distinguish ``None``-like missing values from empty","+strings."],"additions":14,"deletions":0,"truncated":false},{"path":"doc/source/user/basics.strings.rst","lines":["@@ -149,6 +149,13 @@ sort to the end of the array:","   >>> np.sort(arr)","   array(['hello', 'world', nan], dtype=StringDType(na_object=nan))"," ","+Comparisons also follow floating-point NaN semantics: equality and ordered","+comparisons involving a NaN-like sentinel return ``False``, while inequality","+returns ``True``.","+","+  >>> arr != \"hello\"","+  array([False,  True,  True])","+"," String Missing Data Sentinels"," +++++++++++++++++++++++++++++"," "],"additions":7,"deletions":0,"truncated":false},{"path":"numpy/_core/src/multiarray/stringdtype/dtype.c","lines":["@@ -545,7 +545,7 @@ _compare_impl(void *a, void *b, PyArray_StringDTypeObject *descr_a,","                 // nan-like nulls sort to the end even in a descending","                 // sort, matching how NaN sorts for floats","                 if (a_is_null) {","-                    return 1;","+                    return b_is_null ? 0 : 1;","                 }","                 else if (b_is_null) {","                     return -1;"],"additions":1,"deletions":1,"truncated":false},{"path":"numpy/_core/src/umath/stringdtype_ufuncs.cpp","lines":["@@ -506,8 +506,8 @@ string_comparison_strided_loop(PyArrayMethod_Context *context, char *const data[","         LOAD_TWO_INPUT_STRINGS(ufunc_name);","         if (NPY_UNLIKELY(s1_isnull || s2_isnull)) {","             if (has_nan_na) {","-                // s1 or s2 is NA","-                *out = NPY_FALSE;","+                // Like floating-point NaN, only not_equal is true for NA.","+                *out = eq_or_ne && res_for_ne;","                 goto next_step;","             }","             else if (has_null && !has_string_na) {","@@ -518,6 +518,7 @@ string_comparison_strided_loop(PyArrayMethod_Context *context, char *const data[","                     else {","                         *out = res_for_ne;","                     }","+                    goto next_step;","                 }","                 else {","                     npy_gil_error(PyExc_ValueError,"],"additions":3,"deletions":2,"truncated":false},{"path":"numpy/_core/tests/test_stringdtype.py","lines":["@@ -985,6 +985,40 @@ def test_comparisons(string_list, dtype, op, o_dtype):","     assert_array_equal(res, orres)"," "," ","+@pytest.mark.parametrize(\"op\", comparison_operators)","+def test_nan_like_comparisons(nan_like_na_object, op):","+    na = nan_like_na_object","+    dtype = StringDType(na_object=na)","+    left = np.array([na, \"a\", na, \"a\", \"b\"], dtype=dtype)","+    right = np.array([\"a\", na, na, \"a\", \"a\"], dtype=dtype)","+    numeric_left = np.array([np.nan, 0, np.nan, 0, 1])","+    numeric_right = np.array([0, np.nan, np.nan, 0, 0])","+    assert_array_equal(op(left, right), op(numeric_left, numeric_right))","+    assert_array_equal(op(left, \"a\"), op(numeric_left, 0))","+","+","+@pytest.mark.parametrize(\"op\", comparison_operators)","+@pytest.mark.parametrize(\"na_object\", [None, object()], ids=[\"None\", \"object\"])","+def test_non_string_na_comparisons(dtype, op):","+    na = dtype.na_object","+    left = np.array([\"\", na, \"x\", na, \"\", \"x\"], dtype=dtype)","+    right = np.array([na, \"\", na, na, \"\", \"x\"], dtype=dtype)","+    if op not in (np.equal, np.not_equal):","+        with pytest.raises(ValueError, match=\"not supported for null values\"):","+            op(left, right)","+        with pytest.raises(ValueError, match=\"not supported for null values\"):","+            op(left, \"\")","+        assert_array_equal(op(left[4:], right[4:]), op([\"\", \"x\"], [\"\", \"x\"]))","+        return","+    equal = np.array([False, False, False, True, True, True])","+    equal_empty = np.array([True, False, False, False, True, False])","+    if op is np.not_equal:","+        equal, equal_empty = ~equal, ~equal_empty","+    assert_array_equal(op(left, right), equal)","+    assert_array_equal(op(left, \"\"), equal_empty)","+    assert_array_equal(op(\"\", left), equal_empty)","+","+"," def test_isnan(dtype, string_list):","     if not hasattr(dtype, \"na_object\"):","         pytest.skip(\"no na support\")","@@ -1100,6 +1134,13 @@ def test_sort(strings, arr_sorted):","     test_sort(strings, arr_sorted)"," "," ","+@pytest.mark.parametrize(\"descending\", [True, False])","+def test_sort_nan_like_stability(nan_like_na_object, descending):","+    dtype = StringDType(na_object=nan_like_na_object)","+    arr = np.array([nan_like_na_object] * 2, dtype=dtype)","+    assert_array_equal(np.argsort(arr, stable=True, descending=descending), [0, 1])","+","+"," @pytest.mark.parametrize(\"strings\", SORT_STRINGS)"," def test_sort_descending(dtype, strings, stable):","     \"\"\"Test that descending sorts reverse the ascending order.\"\"\""],"additions":41,"deletions":0,"truncated":false},{"path":"numpy/lib/_arraysetops_impl.py","lines":["@@ -386,9 +386,11 @@ def _unique1d(ar, return_index=False, return_inverse=False,","         aux = ar","     mask = np.empty(aux.shape, dtype=np.bool)","     mask[:1] = True","-    if (equal_nan and aux.shape[0] > 0 and aux.dtype.kind in \"cfmM\" and","-            np.isnan(aux[-1])):","-        if aux.dtype.kind == \"c\":  # for complex all NaNs are considered equivalent","+    # Keep the last element typed so isnan handles StringDType's NA sentinel.","+    if (equal_nan and aux.shape[0] > 0 and aux.dtype.kind in \"cfmMT\" and","+            np.isnan(aux[-1:])[0]):","+        if aux.dtype.kind in \"cT\":","+            # Complex NaNs and StringDType's NaN-like sentinels are equivalent.","             aux_firstnan = np.searchsorted(np.isnan(aux), True, side='left')","         else:","             aux_firstnan = np.searchsorted(aux, aux[-1], side='left')"],"additions":5,"deletions":3,"truncated":false},{"path":"numpy/lib/tests/test_arraysetops.py","lines":["@@ -5,6 +5,7 @@"," "," import numpy as np"," from numpy import ediff1d, intersect1d, isin, setdiff1d, setxor1d, union1d, unique","+from numpy._core.tests._natype import pd_NA"," from numpy.dtypes import StringDType"," from numpy.exceptions import AxisError"," from numpy.testing import (","@@ -631,6 +632,13 @@ def test_manyways(self):"," "," class TestUnique:"," ","+    @pytest.fixture(","+  