{"id":"be5f17a84731c728fb814341da93822c53ccfb53","axis":"silent","repo":"grafana/loki","sha":"be5f17a84731c728fb814341da93822c53ccfb53","parsed":{"files":[{"path":"docs/sources/shared/configuration.md","lines":["@@ -973,6 +973,12 @@ kafka_config:","   # CLI flag: -kafka.tracing-enabled","   [tracing_enabled: <boolean> | default = false]"," ","+  # The highest ApiVersions request version the Kafka client sends. The default","+  # keeps franz-go >= 1.22 compatible with backends that close the connection on","+  # ApiVersions v5 (WarpStream). 0 to use the franz-go default.","+  # CLI flag: -kafka.api-versions-max-version","+  [api_versions_max_version: <int> | default = 4]","+"," dataobj:","   builder:","     logsobj_builder:"],"additions":6,"deletions":0,"truncated":false},{"path":"pkg/kafka/client/api_versions_test.go","lines":["@@ -0,0 +1,141 @@","+package client","+","+import (","+\t\"context\"","+\t\"maps\"","+\t\"slices\"","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/stretchr/testify/require\"","+\t\"github.com/twmb/franz-go/pkg/kfake\"","+\t\"github.com/twmb/franz-go/pkg/kgo\"","+\t\"github.com/twmb/franz-go/pkg/kmsg\"","+","+\t\"github.com/grafana/loki/v3/pkg/kafka\"","+\t\"github.com/grafana/loki/v3/pkg/kafka/testkafka\"","+)","+","+// recordAPIVersions returns the versions of every ApiVersions request the cluster receives.","+func recordAPIVersions(cluster *kfake.Cluster) func() []int16 {","+\tvar (","+\t\tmu       sync.Mutex","+\t\tversions []int16","+\t)","+\tcluster.ControlKey(kmsg.ApiVersions.Int16(), func(req kmsg.Request) (kmsg.Response, error, bool) {","+\t\tcluster.KeepControl()","+\t\tmu.Lock()","+\t\tversions = append(versions, req.GetVersion())","+\t\tmu.Unlock()","+\t\treturn nil, nil, false","+\t})","+\treturn func() []int16 {","+\t\tmu.Lock()","+\t\tdefer mu.Unlock()","+\t\treturn slices.Clone(versions)","+\t}","+}","+","+// TestClientsCapAPIVersions checks that the reader and writer clients send ApiVersions","+// at the configured cap. The lower cap proves the option is wired in, since","+// franz-go v1.21.x sends v4 anyway.","+func TestClientsCapAPIVersions(t *testing.T) {","+\ttests := []struct {","+\t\tname       string","+\t\tmaxVersion int","+\t\twant       int16","+\t}{","+\t\t{name: \"default\", maxVersion: kafka.DefaultAPIVersionsMaxVersion, want: kafka.DefaultAPIVersionsMaxVersion},","+\t\t{name: \"lower cap\", maxVersion: 3, want: 3},","+\t\t{name: \"too high is capped at the default\", maxVersion: 65539, want: kafka.DefaultAPIVersionsMaxVersion},","+\t}","+","+\tnewClients := map[string]func(cfg kafka.Config) (*kgo.Client, error){","+\t\t\"reader\": func(cfg kafka.Config) (*kgo.Client, error) {","+\t\t\treturn NewReaderClient(\"test-reader\", cfg, log.NewNopLogger(), prometheus.NewRegistry())","+\t\t},","+\t\t\"writer\": func(cfg kafka.Config) (*kgo.Client, error) {","+\t\t\treturn NewWriterClient(\"test-writer\", cfg, log.NewNopLogger(), prometheus.NewRegistry())","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tfor clientName, newClient := range newClients {","+\t\t\tt.Run(tt.name+\"/\"+clientName, func(t *testing.T) {","+\t\t\t\tcluster, cfg := testkafka.CreateCluster(t, 1, \"test\")","+\t\t\t\tseen := recordAPIVersions(cluster)","+","+\t\t\t\tcfg.APIVersionsMaxVersion = tt.maxVersion","+\t\t\t\tclient, err := newClient(cfg)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tt.Cleanup(client.Close)","+","+\t\t\t\trequire.NoError(t, client.Ping(context.Background()))","+","+\t\t\t\tversions := seen()","+\t\t\t\trequire.NotEmpty(t, versions)","+\t\t\t\tfor _, v := range versions {","+\t\t\t\t\trequire.Equal(t, tt.want, v)","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}","+","+// recordRequestVersions returns the highest version of each request type the cluster receives.","+func recordRequestVersions(cluster *kfake.Cluster) func() map[int16]int16 {","+\tvar (","+\t\tmu       sync.Mutex","+\t\tversions = map[int16]int16{}","+\t)","+\tcluster.Control(func(req kmsg.Request) (kmsg.Response, error, bool) {","+\t\tcluster.KeepControl()","+\t\tmu.Lock()","+\t\tversions[req.Key()] = max(versions[req.Key()], req.GetVersion())","+\t\tmu.Unlock()","+\t\treturn nil, nil, false","+\t})","+\treturn func() map[int16]int16 {","+\t\tmu.Lock()","+\t\tdefer mu.Unlock()","+\t\treturn maps.Clone(versions)","+\t}","+}","+","+// TestAPIVersionsCapChangesNoOtherRequest checks that the cap changes only the","+// ApiVersions request: every other request uses the same version as without the cap.","+func TestAPIVersionsCapChangesNoOtherRequest(t *testing.T) {","+\trequestVersions := func(t *testing.T, maxVersion int) map[int16]int16 {","+\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)","+\t\tt.Cleanup(cancel)","+","+\t\tcluster, cfg := testkafka.CreateCluster(t, 1, \"test\")","+\t\tseen := recordRequestVersions(cluster)","+\t\tcfg.APIVersionsMaxVersion = maxVersion","+","+\t\twriter, err := NewWriterClient(\"test-writer\", cfg, log.NewNopLogger(), prometheus.NewRegistry())","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(writer.Close)","+\t\trequire.NoError(t, writer.ProduceSync(ctx, &kgo.Record{Topic: \"test\", Value: []byte(\"x\")}).FirstErr())","+","+\t\treader, err := NewReaderClient(\"test-reader\", cfg, log.NewNopLogger(), prometheus.NewRegistry(),","+\t\t\tkgo.ConsumePartitions(map[string]map[int32]kgo.Offset{\"test\": {0: kgo.NewOffset().AtStart()}}))","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(reader.Close)","+\t\trequire.Equal(t, 1, reader.PollFetches(ctx).NumRecords())","+","+\t\treturn seen()","+\t}","+","+\tuncapped := requestVersions(t, 0)","+\tcapped := requestVersions(t, 3)","+\trequire.Equal(t, int16(3), capped[kmsg.ApiVersions.Int16()])","+","+\tdelete(uncapped, kmsg.ApiVersions.Int16())","+\tdelete(capped, kmsg.ApiVersions.Int16())","+\trequire.NotEmpty(t, capped)","+\trequire.Equal(t, uncapped, capped)","+}"],"additions":141,"deletions":0,"truncated":false},{"path":"pkg/kafka/client/reader_client.go","lines":["@@ -25,6 +25,8 @@ const ("," //"," // The returned Client utilizes the standard set of *kprom.Metrics, prefixed with"," // `MetricsPrefix`","+//","+// Passing kgo.MaxVersions in opts replaces the ApiVersions cap."," func NewReaderClient(component string, kafkaCfg kafka.Config, logger log.Logger, reg prometheus.Registerer, opts ...kgo.Opt) (*kgo.Client, error) {"," \tmetrics := NewClientMetrics(component, reg, kafkaCfg.EnableKafkaHistograms)"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/kafka/client/writer_client.go","lines":["@@ -221,6 +221,8 @@ func commonKafkaClientOptions(cfg kafka.Config, metrics *kprom.Metrics, logger l"," \t\topts = append(opts, kgo.WithHooks(metrics))"," \t}"," ","+\topts = append(opts, kafka.APIVersionsMaxVersionOpts(cfg.APIVersionsMaxVersion)...)","+"," \treturn opts"," }"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/kafka/config.go","lines":["@@ -29,6 +29,7 @@ var ("," \tErrInvalidProducerMaxRecordSizeBytes           = fmt.Errorf(\"the configured producer max record size bytes must be a value between %d and %d\", minProducerRecordDataBytesLimit, MaxProducerRecordDataBytesLimit)"," \tErrInvalidProducerMaxInflightRequestsPerBroker = errors.New(\"the configured producer max inflight requests per broker must be greater than or equal to 1\")"," \tErrInvalidProducerLinger                       = errors.New(\"the configured producer linger must be greater than or equal to 0\")","+\tErrInvalidAPIVersionsMaxVersion                = fmt.Errorf(\"the configured ApiVersions max version must be between 0 and %d (0 uses the franz-go default)\", DefaultAPIVersionsMaxVersion)"," )"," "," // Config holds the generic config for the Kafka backend.","@@ -64,6 +65,8 @@ type Config struct {"," "," \tEnableKafkaHistograms bool `yaml:\"enable_kafka_histograms\"`"," \tTracingEnabled        bool `yaml:\"tracing_enabled\"`","+","+\tAPIVersionsMaxVersion int `yaml:\"api_versions_max_version\"`"," }"," "," type ClientConfig struct {","@@ -87,6 +90,7 @@ func (cfg *Config) RegisterFlagsWithPrefix(prefix string, f *flag.FlagSet) {"," \tf.StringVar(&cfg.Topic, prefix+\".topic\", \"\", \"The Kafka topic name.\")"," \tf.DurationVar(&cfg.DialTimeout, prefix+\".dial-timeout\", 2*time.Second, \"The maximum time allowed to open a connection to a Kafka broker.\")"," \tf.DurationVar(&cfg.WriteTimeout, prefix+\".write-timeout\", 10*time.Second, \"How long to wait for an incoming write request to be successfully committed to the Kafka backend.\")","+\tf.IntVar(&cfg.APIVersionsMaxVersion, prefix+\".api-versions-max-version\", DefaultAPIVersionsMaxVersion, apiVersionsMaxVersionUsage)"," "," \tf.StringVar(&cfg.SASLUsername, prefix+\".sasl-username\", \"\", \"The SASL username for authentication to Kafka using the PLAIN mechanism. Both username and password must be set.\")"," \tf.Var(&cfg.SASLPassword, prefix+\".sasl-password\", \"The SASL password for authentication to Kafka using the PLAIN mechanism. Both username and password must be set.\")","@@ -147,6 +151,9 @@ func (cfg *Config) Validate() error {"," \tif (cfg.SASLUsername == \"\") != (cfg.SASLPassword.String() == \"\") {"," \t\treturn ErrInconsistentSASLUsernameAndPassword"," \t}","+\tif cfg.APIVersionsMaxVersion < 0 || cfg.APIVersionsMaxVersion > DefaultAPIVersionsMaxVersion {","+\t\treturn ErrInvalidAPIVersionsMaxVersion","+\t}"," "," \treturn nil"," }"],"additions":7,"deletions":0,"truncated":false},{"path":"pkg/kafka/config_test.go","lines":["@@ -137,3 +137,50 @@ func TestProducerLingerMustBeValid(t *testing.T) {"," \t\t})"," \t}"," }","+","+// TestAPIVersionsMaxVersionMustBeValid checks that caps from 0 to the default are","+// accepted and everything else is rejected.","+func TestAPIVersionsMaxVersionMustBeValid(t *testing.T) {","+\ttests := []struct {","+\t\tname        string","+\t\tvalue       int","+\t\texpectedErr error","+\t}{","+\t\t{","+\t\t\tname:  \"the default is valid\",","+\t\t\tvalue: DefaultAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:  \"zero is valid, and uses the franz-go default\",","+\t\t\tvalue: 0,","+\t\t},","+\t\t{","+\t\t\tname:        \"negative is invalid\",","+\t\t\tvalue:       -1,","+\t\t\texpectedErr: ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:        \"above the default is invalid\",","+\t\t\tvalue:       DefaultAPIVersionsMaxVersion + 1,","+\t\t\texpectedErr: ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:        \"above int16 is invalid\",","+\t\t\tvalue:       40000,","+\t\t\texpectedErr: ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tcfg := validProducerConfig()","+\t\t\tcfg.APIVersionsMaxVersion = tt.value","+","+\t\t\terr := cfg.Validate()","+\t\t\tif tt.expectedErr != nil {","+\t\t\t\trequire.ErrorIs(t, err, tt.expectedErr)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t})","+\t}","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"pkg/kafka/versions.go","lines":["@@ -0,0 +1,35 @@","+package kafka","+","+import (","+\t\"github.com/twmb/franz-go/pkg/kgo\"","+\t\"github.com/twmb/franz-go/pkg/kmsg\"","+\t\"github.com/twmb/franz-go/pkg/kversion\"","+)","+","+// DefaultAPIVersionsMaxVersion is the highest ApiVersions request version the","+// Kafka clients send by default.","+//","+// franz-go >= 1.22 sends ApiVersions v5 first. WarpStream agents close the","+// connection on v5 instead of replying UNSUPPORTED_VERSION, so the client","+// can't fall back on its own. franz-go 1.21.x already sends v4, so the cap","+// changes nothing there.","+const DefaultAPIVersionsMaxVersion = 4","+","+const apiVersionsMaxVersionUsage = \"The highest ApiVersions request version the Kafka client sends. \" +","+\t\"The default keeps franz-go >= 1.22 compatible with backends that close the connection on ApiVersions v5 (WarpStream). \" +","+\t\"0 to use the franz-go default.\"","+","+// APIVersionsMaxVersionOpts returns the client options that cap ApiVersions at","+// maxVersion, or none if maxVersion is 0 or less. Values above","+// DefaultAPIVersionsMaxVersion are capped at it, for callers that don't","+// validate their config.","+func APIVersionsMaxVersionOpts(maxVersion int) []kgo.Opt {","+\tif maxVersion <= 0 {","+\t\treturn nil","+\t}","+\tmaxVersion = min(maxVersion, DefaultAPIVersionsMaxVersion)","+\t// kversion.Stable() is franz-go's default, so only ApiVersions changes.","+\tversions := kversion.Stable()","+\tversions.SetMaxKeyVersion(kmsg.ApiVersions.Int16(), int16(maxVersion))","+\treturn []kgo.Opt{kgo.MaxVersions(versions)}","+}"],"additions":35,"deletions":0,"truncated":false},{"path":"pkg/logline/builder/config.go","lines":["@@ -96,8 +96,16 @@ type KafkaConfig struct {"," \t// same identity instead of triggering a rebalance. Defaults to"," \t// os.Hostname() when empty."," \tInstanceID string `yaml:\"instance_id\"`","+","+\t// APIVersionsMaxVersion is apiVersionsMaxVersionUnset until ApplyDefaultsFrom","+\t// fills it, so unset can be told apart from 0, which uses the franz-go default.","+\tAPIVersionsMaxVersion int `yaml:\"api_versions_max_version\"`"," }"," ","+// apiVersionsMaxVersionUnset marks KafkaConfig.APIVersionsMaxVersion as not set,","+// so ApplyDefaultsFrom takes the root value.","+const apiVersionsMaxVersionUnset = -1","+"," func (c *KafkaConfig) RegisterFlagsWithPrefix(prefix string, f *flag.FlagSet) {"," \t// The cluster-level flags default to empty so ApplyDefaultsFrom can tell"," \t// \"unset\" from \"deliberately set to the same value as the root config\".","@@ -124,6 +132,8 @@ func (c *KafkaConfig) RegisterFlagsWithPrefix(prefix string, f *flag.FlagSet) {"," \tf.StringVar(&c.InstanceID, prefix+\".instance-id\", \"\","," \t\t\"Kafka static-membership ID (defaults to os.Hostname() if empty). \"+"," \t\t\t\"Pod restarts within session-timeout rejoin without rebalance.\")","+\tf.IntVar(&c.APIVersionsMaxVersion, prefix+\".api-versions-max-version\", apiVersionsMaxVersionUnset,","+\t\t\"Kafka ApiVersions max version. Defaults to the root kafka_config value. See -kafka.api-versions-max-version.\")"," }"," "," // ApplyDefaultsFrom fills every unset field from Loki's root kafka_config.","@@ -151,6 +161,9 @@ func (c *KafkaConfig) ApplyDefaultsFrom(root kafka.Config) {"," \tif c.DialTimeout == 0 {"," \t\tc.DialTimeout = root.DialTimeout"," \t}","+\tif c.APIVersionsMaxVersion == apiVersionsMaxVersionUnset {","+\t\tc.APIVersionsMaxVersion = root.APIVersionsMaxVersion","+\t}"," \t// SASL is a pair. Taking the username from one source and the password"," \t// from another would produce a credential that was never configured"," \t// anywhere, so inherit both or neither.","@@ -185,6 +198,9 @@ func (c *KafkaConfig) Validate() error {"," \tif c.SessionTimeout < 0 {"," \t\treturn fmt.Errorf(\"session_timeout must be non-negative, got %v\", c.SessionTimeout)"," \t}","+\tif c.APIVersionsMaxVersion < 0 || c.APIVersionsMaxVersion > kafka.DefaultAPIVersionsMaxVersion {","+\t\treturn kafka.ErrInvalidAPIVersionsMaxVersion","+\t}"," "," \t// InstanceID defaults to os.Hostname() so each pod gets a stable static-"," \t// membership identity for kgo.InstanceID without explicit configuration."],"additions":16,"deletions":0,"truncated":false},{"path":"pkg/logline/builder/config_test.go","lines":["@@ -532,6 +532,73 @@ func TestKafkaApplyDefaultsFrom(t *testing.T) {"," \t\trequire.Empty(t, cfg.SASLPassword.String())"," \t\trequire.ErrorIs(t, cfg.Validate(), kafka.ErrInconsistentSASLUsernameAndPassword)"," \t})","+","+\tt.Run(\"api versions cap is inherited only when unset\", func(t *testing.T) {","+\t\troot := kafka.Config{APIVersionsMaxVersion: 3}","+","+\t\tunset := KafkaConfig{APIVersionsMaxVersion: apiVersionsMaxVersionUnset}","+\t\tunset.ApplyDefaultsFrom(root)","+\t\trequire.Equal(t, 3, unset.APIVersionsMaxVersion)","+","+\t\tdisabled := KafkaConfig{APIVersionsMaxVersion: 0}","+\t\tdisabled.ApplyDefaultsFrom(root)","+\t\trequire.Equal(t, 0, disabled.APIVersionsMaxVersion, \"0 must not be overwritten\")","+","+\t\texplicit := KafkaConfig{APIVersionsMaxVersion: 2}","+\t\texplicit.ApplyDefaultsFrom(root)","+\t\trequire.Equal(t, 2, explicit.APIVersionsMaxVersion)","+\t})","+}","+","+// TestKafkaAPIVersionsMaxVersionMustBeValid checks that the logline builder accepts","+// caps from 0 to the default and rejects everything else.","+func TestKafkaAPIVersionsMaxVersionMustBeValid(t *testing.T) {","+\ttests := []struct {","+\t\tname        string","+\t\tvalue       int","+\t\texpectedErr error","+\t}{","+\t\t{","+\t\t\tname:  \"the default is valid\",","+\t\t\tvalue: kafka.DefaultAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:  \"zero is valid, and uses the franz-go default\",","+\t\t\tvalue: 0,","+\t\t},","+\t\t{","+\t\t\tname:        \"unset is invalid, as ApplyDefaultsFrom must fill it first\",","+\t\t\tvalue:       apiVersionsMaxVersionUnset,","+\t\t\texpectedErr: kafka.ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:        \"negative is invalid\",","+\t\t\tvalue:       -2,","+\t\t\texpectedErr: kafka.ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:        \"above the default is invalid\",","+\t\t\tvalue:       kafka.DefaultAPIVersionsMaxVersion + 1,","+\t\t\texpectedErr: kafka.ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t\t{","+\t\t\tname:        \"above int16 is invalid\",","+\t\t\tvalue:       40000,","+\t\t\texpectedErr: kafka.ErrInvalidAPIVersionsMaxVersion,","+\t\t},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tcfg := KafkaConfig{Address: \"b:9092\", Topic: \"t\", APIVersionsMaxVersion: tt.value}","+","+\t\t\terr := cfg.Validate()","+\t\t\tif tt.expectedErr != nil {","+\t\t\t\trequire.ErrorIs(t, err, tt.expectedErr)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t})","+\t}"," }"," "," func TestK