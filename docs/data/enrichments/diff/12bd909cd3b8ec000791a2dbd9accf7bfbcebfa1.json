 {","+          \"target\": \"smithy.api#String\"","+        },","+        \"widgets\": {","+          \"target\": \"com.amazonaws.testpaginated#WidgetList\"","+        },","+        \"choices\": {","+          \"target\": \"com.amazonaws.testpaginated#ChoiceList\"","+        },","+        \"matrix\": {","+          \"target\": \"com.amazonaws.testpaginated#ThingMatrix\"","+        }","+      },","+      \"traits\": {","+        \"smithy.api#output\": {}","+      }","+    },","+    \"com.amazonaws.testpaginated#ChoiceList\": {","+      \"type\": \"list\",","+      \"member\": {","+        \"target\": \"com.amazonaws.testpaginated#TestUnion\"","+      }","+    },","+    \"com.amazonaws.testpaginated#TestUnion\": {","+      \"type\": \"union\",","+      \"members\": {","+        \"text\": {","+          \"target\": \"smithy.api#String\"","+        }","+      }","+    },","+    \"com.amazonaws.testpaginated#ThingMatrix\": {","+      \"type\": \"list\",","+      \"member\": {","+        \"target\": \"com.amazonaws.testpaginated#ThingList\"","+      }","+    },","+    \"com.amazonaws.testpaginated#WidgetList\": {","+      \"type\": \"list\",","+      \"member\": {","+        \"target\": \"com.amazonaws.testpaginated#Widget\"","+      }","+    },","+    \"com.amazonaws.testpaginated#Widget\": {","+      \"type\": \"structure\",","+      \"members\": {","+        \"id\": {","+          \"target\": \"smithy.api#String\"","+        }","+      }","+    }","+  }","+}"],"additions":337,"deletions":0,"truncated":false},{"path":"generator/SmithyDotNet/SmithyDotNet.Generator/Generation/GenerationContext.cs","lines":["@@ -23,6 +23,23 @@ public record OperationError(StructureShape Shape, ShapeId Id);"," /// </summary>"," public record Operation(string Name, OperationShape Shape, StructureShape Input, StructureShape Output, IReadOnlyList<OperationError> Errors);"," ","+/// <summary>","+/// A paginated operation with its trait resolved and token/items members mapped to .NET property names.","+/// <see cref=\"ItemsProperty\"/> is the leaf member name (the generated enumerable's name), while","+/// <see cref=\"ItemsPath\"/> and <see cref=\"OutputTokenProperty\"/> are full accessor paths off the","+/// response — they contain dots when the trait uses a dotted path (e.g. \"DistributionList.NextMarker\").","+/// </summary>","+public record PaginatedOperation(","+    Operation Operation,","+    PaginatedTrait Trait,","+    string InputTokenProperty,","+    string OutputTokenProperty,","+    string? PageSizeProperty,","+    string? ItemsProperty,","+    string? ItemsPath,","+    string? ItemsElementType","+);","+"," /// <summary>"," /// Aggregates everything code writers need about a single service: derived names,"," /// detected protocol, resolved operations, and partitioned reachable shapes.","@@ -121,6 +138,12 @@ public class GenerationContext","     /// <summary>All operations with their input/output/error shapes resolved.</summary>","     public IReadOnlyList<Operation> Operations { get; }"," ","+    /// <summary>Operations carrying <c>@paginated</c>, with token/items members resolved to .NET property names. Sorted by operation name.</summary>","+    public IReadOnlyList<PaginatedOperation> PaginatedOperations { get; }","+","+    /// <summary>Whether the service has any paginated operations.</summary>","+    public bool HasPaginators => PaginatedOperations.Count > 0;","+","     /// <summary>Reachable structures excluding input, output, and error shapes, keyed by shape ID. Sorted by shape ID for deterministic output.</summary>","     public IReadOnlyDictionary<ShapeId, StructureShape> Structures { get; }"," ","@@ -198,6 +221,7 @@ public GenerationContext(ServiceIndex index, SdkVersionManifest manifest, Servic","         ServiceAuthSchemes = ModeledAuth.ServiceSchemes(index.Service);","         SupportsSigV4 = AuthSchemeMapping.ContainsSigV4(ServiceAuthSchemes);","         OperationsWithModeledAuth = ModeledAuth.OperationOverrides(Operations);","+  