ials for","+\t// multiple registries into one secret. For nodeGroups caches the named Secret must","+\t// exist in the download job namespace (localModel.jobNamespace); for pvcRef caches","+\t// it must exist in this cache's namespace, where the import Job runs. Credentials","+\t// from serviceAccountName and storage are not used for oci:// sources.","+\t//","+\t// Trust boundary: a namespaced nodeGroups cache can name any dockerconfigjson Secret","+\t// already present in the shared job namespace by that Secret's metadata.name.","+\t// There is no extra ownership check; knowing the name is enough. Secrets are not","+\t// copied from the cache namespace. Prefer pvcRef (import Job in the cache namespace)","+\t// when tenants must not share the cluster job-namespace credential store.","+\t// +optional","+\t// +listType=map","+\t// +listMapKey=name","+\t// +kubebuilder:validation:MaxItems=1","+\t// +kubebuilder:validation:XValidation:rule=\"self.all(s, s.name != '')\",message=\"imagePullSecrets.name must be non-empty\"","+\tImagePullSecrets []corev1.LocalObjectReference `json:\"imagePullSecrets,omitempty\"`"," \t// +optional"," \tStorage *LocalModelStorageSpec `json:\"storage,omitempty\"`"," }"],"additions":23,"deletions":0,"truncated":false},{"path":"pkg/apis/serving/v1alpha1/local_model_node_types.go","lines":["@@ -16,7 +16,10 @@ limitations under the License."," "," package v1alpha1"," ","-import metav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+import (","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+)"," "," type LocalModelInfo struct {"," \t// Original StorageUri","@@ -34,6 +37,16 @@ type LocalModelInfo struct {"," \t// ServiceAccountName specifies the service account to use for credential lookup."," \t// +optional"," \tServiceAccountName string `json:\"serviceAccountName,omitempty\"`","+\t// ImagePullSecrets is a single kubernetes.io/dockerconfigjson secret in the","+\t// download job namespace used to authenticate OCI