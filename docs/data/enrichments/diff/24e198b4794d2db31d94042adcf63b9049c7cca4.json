de\", \"22\")));","+    assert_eq!(parse_runtime_spec(\"node@tool:22\"), Some((\"node\", \"22\")));","+    assert_eq!(parse_runtime_spec(\"bun@tool:1.3\"), Some((\"bun\", \"1.3\")));","+    assert_eq!(parse_package_manager_spec(\"bun@tool:1.3\"), None);","+    assert_eq!(parse_package_manager_spec(\"yarn@tool:4\"), Some((PackageManager::Yarn, \"4\")));","+    assert_eq!(parse_package_manager_spec(\"yarn@runtime:6\"), Some((PackageManager::Yarn, \"6\")));","+    assert_eq!(parse_package_manager_spec(\"npm@tool:11\"), None);"," ","     // A specifier that locates a package names what to install, whether it","     // spells out a protocol or uses the GitHub shorthand."],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/shims.rs","lines":["@@ -6,12 +6,13 @@ use super::{","     record_package_manager_shims, remove_native_shim, scan_global_packages,","     virtual_shim_bins_to_restore, virtual_shim_owner, virtual_shim_restoration_owners,"," };","+use pnpm_tool_protocol::is_tool_specifier;"," "," /// Link `pkgs`' bins into the global bin dir in the shape selected by the"," /// `globalShims` record: bins of an enabled providing package become"," /// context-aware shims, everything else gets direct shims. The runtime","-/// names only count when actually installed through the `runtime:`","-/// protocol, so an npm package that happens to be called `node` is not","+/// names only count when actually installed through the `tool:` /","+/// `runtime:` protocol, so an npm package that happens to be called `node` is not"," /// elevated."," pub(super) fn link_global_bins(","     config: &Config,","@@ -41,7 +42,7 @@ pub(super) fn link_global_bins(","                     && (!pnpm_package_manifest::is_runtime_alias(name)","                         || dependencies","                             .iter()","-                            .any(|(alias, spec)| alias == name && spec.starts_with(\"runtime:\")))","+                            .any(|(alias, spec)| alias == name && is_tool_specifier(spec)))","             })","         });","     migrate_legacy_shims(global_bin_dir).into_diagnostic().wrap_err(\"migrate the global shims\")?;"],"additions":4,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/src/engine_pm/selector.rs","lines":["@@ -14,6 +14,7 @@ use pnpm_package_manifest::{","     package_manager_spec::{is_version_request, split_spec},"," };"," use pnpm_rust_toolchain::Channel;","+use pnpm_tool_protocol::strip_tool_protocol;"," "," /// The install selector for `request`, or `None` when it names no tool"," /// pnpm manages and the request stands as written.","@@ -23,6 +24,17 @@ use pnpm_rust_toolchain::Channel;"," #[must_use]"," pub(crate) fn tool_install_selector(request: &str) -> Option<String> {","     let (name, version_spec) = split_request(request);","+    // Yarn's lines come from different sources, so `yarn@tool:4` maps the","+    // way `yarn@4` does.","+    if name == PackageManager::Yarn.name()","+        && let Some(version_spec) = strip_tool_protocol(version_spec)","+    {","+        if !is_version_request(version_spec) {","+            return None;","+        }","+        let bare = format!(\"{name}@{version_spec}\");","+        return Some(tool_install_selector(&bare).unwrap_or(bare));","+    }","     // A specifier that locates a package — `node@runtime:22`, an explicit","     // `yarn@npm:@yarnpkg/cli-dist@4`, `yarn@yarnpkg/berry` — already says","     // what to install, and rewriting it would nest one locator inside"],"additions":12,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/engine_pm/selector/tests.rs","lines":["@@ -30,6 +30,23 @@ fn archive_published_tools_go_through_the_runtime_protocol() {","     assert_eq!(tool_install_selector(\"deno\").as_deref(), Some(\"deno@runtime:latest\"));"," }"," ","+/// `yarn@tool:<range>` names a Yarn line the way `yarn@<range>` does,","+/// wherever that line is published.","+#[test]","+fn yarn_tool_requests_map_like_bare_ver