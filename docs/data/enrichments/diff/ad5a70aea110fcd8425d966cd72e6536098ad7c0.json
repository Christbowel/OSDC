id};","+","+fn compute_pipeline(","+    device: &wgpu::Device,","+    module: &wgpu::ShaderModule,","+    constants: &[(&str, f64)],","+) -> wgpu::ComputePipeline {","+    device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {","+        label: None,","+        layout: None,","+        module,","+        entry_point: None,","+        compilation_options: wgpu::PipelineCompilationOptions {","+            constants,","+            ..Default::default()","+        },","+        cache: None,","+    })","+}","+","+/// Workgroup size limits must be checked after override values are applied.","+#[test]","+fn workgroup_size_from_override() {","+    let (device, _queue) = wgpu::Device::noop(&Default::default());","+","+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {","+        label: None,","+        source: wgpu::ShaderSource::Wgsl(","+            \"","+            override size: u32 = 1;","+            @compute @workgroup_size(size) fn main() {}","+            \"","+            .into(),","+        ),","+    });","+","+    valid(&device, || compute_pipeline(&device, &module, &[]));","+    valid(&device, || {","+        compute_pipeline(&device, &module, &[(\"size\", 64.0)])","+    });","+    fail(","+        &device,","+        || compute_pipeline(&device, &module, &[(\"size\", 1024.0)]),","+        Some(\"must be less or equal to the per-dimension limit\"),","+    );","+}","+","+#[test]","+fn unknown_override() {","+    let (device, _queue) = wgpu::Device::noop(&Default::default());","+","+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {","+        label: None,","+        source: wgpu::ShaderSource::Wgsl(\"@compute @workgroup_size(1) fn main() {}\".into()),","+    });","+","+    fail(","+        &device,","+        || compute_pipeline(&device, &module, &[(\"nonexistent\", 1.0)]),","+        Some(\"pipeline constant error\"),","+    );","+}","+","+#[test]","+fn missing_override_value_in_render_pipeline() {","+