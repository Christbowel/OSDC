_job_id, CompactionServiceJobStatus::kUseLocal);","     return CompactionServiceJobStatus::kUseLocal;","   }","+","+  // The worker checks that its per-key placement matches this compaction's.","+  // As a backstop, never install a proximal-level output when this compaction","+  // has no proximal level. Nothing has been imported yet, so fall back to","+  // local compaction as above.","+  if (!compaction->SupportsPerKeyPlacement() &&","+      std::any_of(compaction_result.output_files.begin(),","+                  compaction_result.output_files.end(),","+                  [](const CompactionServiceOutputFile& file) {","+                    return file.is_proximal_level_output;","+                  })) {","+    ROCKS_LOG_WARN(db_options_.info_log,","+                   \"[%s] [JOB %d] Remote compaction returned proximal-level \"","+                   \"output, but this compaction has no proximal level; \"","+                   \"falling back to local compaction\",","+                   compaction->column_family_data()->GetName().c_str(),","+                   job_id_);","+    compaction_result.status.PermitUncheckedError();","+    db_options_.compaction_service->OnInstallation(","+        response.scheduled_job_id, CompactionServiceJobStatus::kUseLocal);","+    return CompactionServiceJobStatus::kUseLocal;","+  }","   sub_compact->status = compaction_result.status;","   if (!sub_compact->status.ok()) {","     ROCKS_LOG_WARN(db_options_.info_log,","@@ -1105,6 +1138,13 @@ void CompactionServiceCompactionJob::Prepare(","   if (compaction_input_.has_end) {","     end = compaction_input_.end;","   }","+  // CompactionJob::Prepare() replaces the floor for a kBottommostFiles","+  // compaction. The worker always rebuilds the compaction as a manual one, so","+  // the primary's floor is kept.","+  assert(compact_->compaction->compaction_reason() !=","+         CompactionReason::kBottommostFiles);","+  preserve_time_min_seqno_floor_ =","+      compaction_input_.preserve_time_min_seqno_floor;","   CompactionJob::Prepare(std::make_pair(begin, end), compaction_progress,","                          compaction_progress_writer);"," }","@@ -1396,6 +1436,29 @@ static std::unordered_map<std::string, OptionTypeInfo> cs_input_type_info = {","      {offsetof(struct CompactionServiceInput, min_manifest_file_size),","       OptionType::kUInt64T, OptionVerificationType::kNormal,","       OptionTypeFlags::kNone}},","+    {\"preserve_internal_time_seconds\",","+     {offsetof(struct CompactionServiceInput, preserve_internal_time_seconds),","+      OptionType::kUInt64T, OptionVerificationType::kNormal,","+      OptionTypeFlags::kNone}},","+    {\"preclude_last_level_data_seconds\",","+     {offsetof(struct CompactionServiceInput, preclude_last_level_data_seconds),","+      OptionType::kUInt64T, OptionVerificationType::kNormal,","+      OptionTypeFlags::kNone}},","+    {\"preserve_time_min_seqno_floor\",","+     {offsetof(struct CompactionServiceInput, preserve_time_min_seqno_floor),","+      OptionType::kUInt64T, OptionVerificationType::kNormal,","+      OptionTypeFlags::kNone}},","+    {\"proximal_level\",","+     {offsetof(struct CompactionServiceInput, proximal_level), OptionType::kInt,","+      OptionVerificationType::kNormal, OptionTypeFlags::kNone}},","+    {\"proximal_output_range_type\",","+     {offsetof(struct CompactionServiceInput, proximal_output_range_type),","+      OptionType::kInt, OptionVerificationType::kNormal,","+      OptionTypeFlags::kNone}},","+    {\"keep_in_last_level_through_seqno\",","+     {offsetof(struct CompactionServiceInput, keep_in_last_level_through_seqno),","+      OptionType::kUInt64T, OptionVerificationType::kNormal,","+      OptionTypeFlags::kNone}},"," };"," "," static std::unordered_map<std::string, OptionTypeInfo>"],"additions":63,"deletions":0,"truncated":false},{"path":"db/compaction/compaction_service_test.cc","lines":["@@ -16,6 +16,7 @@"," #include \"db/blob/blob_log_sequential_reader.h\""," #include \"db/compaction/compaction_outputs.h\""," #include \"db/db_test_util.h\"","+#include \"env/composite_env_wrapper.h\""," #include \"file/file_util.h\""," #include \"file/filename.h\""," #include \"file/random_access_file_reader.h\"","@@ -27,6 +28,8 @@"," #include \"rocksdb/utilities/options_util.h\""," #include \"table/block_based/block_based_table_factory.h\""," #include \"table/unique_id_impl.h\"","+#include \"test_util/mock_time_env.h\"","+#include \"util/defer.h\""," #include \"utilities/merge_operators/string_append/stringappend.h\""," "," namespace ROCKSDB_NAMESPACE {","@@ -4287,6 +4290,180 @@ TEST_F(CompactionServiceTest, Snapshot) {","   db_->ReleaseSnapshot(s1);"," }"," ","+// Later compactions take write times only from their input files, so every","+// output file needs its seqno->time mapping.","+static void AssertFilesHaveSeqnoToTimeMapping(DB* db) {","+  TablePropertiesCollection props;","+  ASSERT_OK(db->GetPropertiesOfAllTables(&props));","+  ASSERT_FALSE(props.empty());","+  for (const auto& [file_name, file_props] : props) {","+    ASSERT_FALSE(file_props->seqno_to_time_mapping.empty()) << file_name;","+  }","+}","+","+// With the real preclude_last_level_data_seconds option, recently written data","+// stays out of the last level, in a remote compaction as in a local one.","+TEST_F(CompactionServiceTest, PrecludeLastLevelKeepsRecentData) {","+  const int kNumTrigger = 4;","+  const int kNumKeys = 100;","+  Options options = CurrentOptions();","+  options.compaction_style = kCompactionStyleUniversal;","+  options.last_level_temperature = Temperature::kCold;","+  options.level0_file_num_compaction_trigger = kNumTrigger;","+  options.num_levels = 7;","+  options.preclude_last_level_data_seconds = 10000;","+","+  auto write_and_compact = [&]() {","+    for (int i = 0; i < kNumTrigger; i++) {","+      for (int j = 0; j < kNumKeys; j++) {","+        ASSERT_OK(Put(Key(j * kNumTrigger + i), \"v\" + std::to_string(i)));","+      }","+      ASSERT_OK(Flush());","+    }","+    ASSERT_OK(dbfull()->TEST_WaitForCompact());","+  };","+","+  DestroyAndReopen(options);","+  write_and_compact();","+  ASSERT_EQ(\"0,0,0,0,0,1\", FilesPerLevel());","+  ASSERT_EQ(GetSstSizeHelper(Temperature::kCold), 0);","+  AssertFilesHaveSeqnoToTimeMapping(db_.get());","+","+  ReopenWithCompactionService(&options);","+  write_and_compact();","+  ASSERT_GE(GetCompactionService()->GetCompactionNum(), 1);","+  // The worker's per-key placement matched the primary's, so the remote","+  // result was installed rather than redone locally.","+  ASSERT_EQ(CompactionServiceJobStatus::kSuccess,","+            GetCompactionService()->GetFinalCompactionServiceJobStatus());","+  ASSERT_EQ(\"0,0,0,0,0,1\", FilesPerLevel());","+  ASSERT_EQ(GetSstSizeHelper(Temperature::kCold), 0);","+  AssertFilesHaveSeqnoToTimeMapping(db_.get());","+}","+","+// If the worker's per-key placement differs from the primary's, the worker","+// declines the job and the compaction runs locally.","+TEST_F(CompactionServiceTest, PerKeyPlacementMismatchFallsBackToLocal) {","+  const int kNumTrigger = 4;","+  const int kNumKeys = 100;","+  Options options = CurrentOptions();","+  options.compaction_style = kCompactionStyleUniversal;","+  options.last_level_temperature = Temperature::kCold;","+  options.level0_file_num_compaction_trigger = kNumTrigger;","+  options.num_levels = 7;","+  options.preclude_last_level_data_seconds = 10000;","+  ReopenWithCompactionService(&options);","+","+  std::atomic<int> altered{0};","+  SyncPoint::GetInstance()->SetCallBack(","+      \"CompactionServiceJob::ProcessKeyValueCompactionWithCompactionService\",","+      [&](void* arg) {","+        auto* input = static_cast<CompactionServiceInput*>(arg);","+        if (input->proximal_level > 0) {","+          input->keep_in_last_level_through_seqno += 1;","+          altered++;","+        }","+      });","+  std::atomic<int> mismatches{0};","+  SyncPoint::GetInstance()->SetCallBack(","+      \"DBImplSecondary::CompactWithoutInstallation:PerKeyPlacementCheck\",","+      [&](void* arg) {","+        if (*static_cast<bool*>(arg)) {","+          mismatches++;","+        }","+      });","+  SyncPoint::GetInstance()->EnableProcessing();","+","+  for (int i = 0; i < kNumTrigger; i++) {","+    for (int j = 0; j < kNumKeys; j++) {","+      ASSERT_OK(Put(Key(j * kNumTrigger + i), \"v\" + std::to_string(i)));","+    }","+    ASSERT_OK(Flush());","+  }","+  ASSERT_OK(dbfull()->TEST_WaitForCompact());","+  SyncPoint::GetInstance()->DisableProcessing();","+  SyncPoint::GetInstance()->ClearAllCallBacks();","+","+  ASSERT_GE(altered.load(), 1);","+  ASSERT_EQ(mismatches.load(), altered.load());","+  // Only the jobs that were not altered were installed from the worker.","+  auto* my_cs = GetCompactionService();","+  ASSERT_EQ(my_cs->GetOnInstallationCount(),","+            my_cs->GetCompactionNum() - altered.load());","+  ASSERT_EQ(\"0,0,0,0,0,1\", FilesPerLevel());","+  ASSERT_EQ(GetSstSizeHelper(Temperature::kCold), 0);","+}","+","+// The primary never installs a proximal-level output for a compaction without","+// a proximal level. It redoes the compaction locally instead.","+TEST_F(CompactionServiceTest, UnexpectedProximalOutputFallsBackToLocal) {","+  Options options = CurrentOptions();","+  options.disable_auto_compactions = true;","+  ReopenWithCompactionService(&options);","+  GenerateTestData();","+","+  CompactionServiceResult result;","+  result.status = Status::OK();","+  CompactionServiceOutputFile file;","+  file.file_name = \"000123.sst\";","+  file.file_size = 1;","+  file.marked_for_compaction = false;","+  file.is_proximal_level_output = true;","+  result.output_files.push_back(file);","+  std::string result_str;","+  ASSERT_OK(result.Write(&result_str));","+  auto my_cs = GetCompactionService();","+  my_cs->OverrideWaitResult(result_str);","+","+  std::string start_str = Key(15);","+  std::string end_str = Key(45);","+  Slice start(start_str);","+  Slice end(end_str);","+  ASSERT_OK(db_->CompactRange(CompactRangeOptions(), &start, &end));","+  VerifyTestData();","+  ASSERT_EQ(1, my_cs->GetOnInstallationCount());","+  ASSERT_EQ(CompactionServiceJobStatus::kUseLocal,","+            my_cs->GetFinalCompactionServiceJobStatus());","+}","+","+// With preserve_internal_time_seconds, a remote compaction keeps the sequence","+// numbers of recent writes in the bottommost level, as a local one does.","+TEST_F(CompactionServiceTest, PreserveInternalTimeKeepsRecentSeqnos) {","+  Options options = CurrentOptions();","+  options.preserve_internal_time_seconds = 10000;","+","+  auto write_and_compact = [&](SequenceNumber* largest_seqno) {","+    for (int i = 0; i < 10; i++) {","+      ASSERT_OK(Put(Key(i), \"value\"));","+    }","+    ASSERT_OK(Flush());","+    CompactRangeOptions cro;","+    cro.bottommost_level_compaction = BottommostLevelCompaction::kForce;","+    ASSERT_OK(db_->CompactRange(cro, nullptr, nullptr));","+    std::vector<LiveFileMetaData> files;","+    db_->GetLiveFilesMetaData(&files);","+    *largest_seqno = 0;","+    for (const auto& f : files) {","+      if (f.column_family_name == kDefaultColumnFamilyName) {","+        *largest_seqno = std::max(*largest_seqno, f.largest_seqno);","+      }","+    }","+  };","+","+  DestroyAndReopen(options);","+  SequenceNumber local_largest_seqno = 0;","+  write_and_compact(&local_largest_seqno);","+  ASSERT_GT(local_largest_seqno, 0U);","+  AssertFilesHaveSeqnoToTimeMapping(db_.get());","+","+  ReopenWithCompactionService(&options);","+  SequenceNumber remote_largest_seqno = 0;","+  write_and_compact(&remote_largest_seqno);","+  ASSERT_GE(GetCompactionService()->GetCompactionNum(), 1);","+  ASSERT_GT(remote_largest_seqno, 0U);","+  AssertFilesHaveSeqnoToTimeMapping(db_.get());","+}","+"," TEST_F(CompactionServiceTest, PrecludeLastLevel) {","   const int kNumTrigger = 4;","   const int kNumLevels = 7;","@@ -7093,6 +7270,89 @@ TEST_F(SessionTmpDirTest, CompactionUsesSessionTmpDir) {","   }"," }"," ","+// A bottommost file written before preserve_internal_time_seconds was enabled","+// has an empty seqno->time mapping. Once the DB-wide mapping ages it out of the","+// preserve window, the file is marked for a kBottommostFiles compaction. The","+// remote compaction of it must zero its sequence numbers as a local one does,","+// or the file is marked again after every rewrite.","+TEST_F(CompactionServiceTest, BottommostFileWithEmptySeqnoTimeMapping) {","+  auto mock_clock = std::make_shared<MockSystemClock>(env_->GetSystemClock());","+  mock_clock->SetCurrentTime(10000000);","+  mock_clock->InstallTimedWaitFixCallback();","+  std::unique_ptr<Env> mock_env(new CompositeEnvWrapper(env_, mock_clock));","+  SyncPoint::GetInstance()->SetCallBack(","+      \"DBImpl::StartPeriodicTaskScheduler:Init\", [&](void* arg) {","+        static_cast<PeriodicTaskScheduler*>(arg)->TEST_OverrideTimer(","+            mock_clock.get());","+      });","+","+  // Counts executed compactions: with a BOTTOM thread pool, the picker runs","+  // twice for one forwarded bottommost compaction.","+  class BottommostCompactionCounter : public EventListener {","+   public:","+    void OnCompactionCompleted(DB* /*db*/,","+                               const CompactionJobInfo& ci) override {","+      if (ci.compaction_reason == CompactionReason::kBottommostFiles) {","+        count.fetch_add(1);","+      }","+    }","+    std::atomic<int> count{0};","+  };","+  auto bottommost_compactions = std::make_shared<BottommostCompactionCounter>();","+","+  const int kNumLevels = 7;","+  Options options = CurrentOptions();","+  options.env = mock_env.get();","+  options.num_levels = kNumLevels;","+  options.level0_file_num_compaction_trigger = 4;","+  options.listeners.push_back(bottommost_compactions);","+  std::shared_ptr<Statistics> compactor_statistics = CreateDBStatistics();","+  auto compaction_service = std::make_shared<MyTestCompactionService>(","+      dbname_, options, compactor_statistics, remote_listeners,","+      remote_table_properties_collector_factories);","+  options.compaction_service = compaction_service;","+  // The DB uses mock_env and mock_clock, so close it before they go out of","+  // scope, also when an assertion fails.","+  Defer close_db([this]() {","+    Close();","+    SyncPoint::GetInstance()->DisableProcessing();","+    SyncPoint::GetInstance()->ClearAllCallBacks();","+  });","+  SyncPoint::GetInstance()->EnableProcessing();","+  DestroyAndReopen(options);","+","+  ASSERT_OK(Put(\"keeplow\", \"v\"));","+  const Snapshot* protect = db_->GetSnapshot();","+  ASSERT_OK(Put(\"aged\", \"v\"));","+  ASSERT_OK(Flush());","+  MoveFilesToLevel(kNumLevels - 1);","+  ASSERT_EQ(1, NumTableFilesAtLevel(kNumLevels - 1));","+","+  ASSERT_OK(db_->SetOptions({{\"preserve_internal_time_seconds\", \"10000\"}}));","+  for (int i = 0; i < 100; i++) {","+    ASSERT_OK(Put(\"hot\", \"v\" + std::to_string(i)));","+    dbfull()->TEST_WaitForPeriodicTaskRun(","+        [&] { mock_clock->MockSleepForSeconds(200); });","+  }","+","+  ASSERT_EQ(bottommost_compactions->count.load(), 0);","+  const int compactions_before = compaction_service->GetCompactionNum();","+  db_->ReleaseSnapshot(protect);","+","+  // A looping file would keep this wait from returning.","+  ASSERT_OK(dbfull()->TEST_WaitForCompact());","+","+  ASSERT_EQ(bottommost_compactions->count.load(), 1);","+  ASSERT_EQ(compaction_service->GetCompactionNum(), compactions_before + 1);","+  std::vector<LiveFileMetaData> files;","+  db_->GetLiveFilesMetaData(&files);","+  for (const auto& f : files) {","+    if (f.level == kNumLevels - 1) {","+      ASSERT_EQ(f.largest_seqno, 0U);","+    }","+  }","+}","+"," }  // namespace ROCKSDB_NAMESPACE"," "," int main(int argc, char** argv) {"],"additions":260,"deletions":0,"truncated":false},{"path":"db/db_impl/db_impl_secondary.cc","lines":["@@ -1838,7 +1838,18 @@ Status DBImplSecondary::CompactWithoutInstallation(","   }","   Status s;"," ","-  const auto& mutable_cf_options = cfd->GetLatestMutableCFOptions();","+  // DB::OpenAndCompact() runs this compaction in a secondary instance, which","+  // is otherwise read-only, so SanitizeCfOptions() zeroed preserve/preclude.","+  // But this compaction writes output files and decides data placement, so it","+  // needs the primary's values: for per-key placement, for which sequence","+  // numbers may be zeroed, and for the seqno->time mapping written to output","+  // files. Only this local copy is changed; the CF's own options stay","+  // sanitized as a read-only DB requires.","+  MutableCFOptions mutable_cf_options = cfd->GetLatestMutableCFOptions();","+  mutable_cf_options.preserve_internal_time_seconds =","+      input.preserve_internal_time_seconds;","+  mutable_cf_options.preclude_last_level_data_seconds =","+      input.preclude_last_level_data_seconds;"," ","   // TODO(hx235): Resuming compaction is currently incompatible with","   // output hash verification (enabled via paranoid_file_checks=true or","@@ -1955,6 +1966,39 @@ Status DBImplSecondary::CompactWithoutInstallation(","   assert(c != nullptr);","   c->FinalizeInputInfo(version);"," ","+  // The worker re-derives per-key placement from its own MANIFEST view, which","+  // can be newer than the primary's input version. The primary installs","+  // proximal-level outputs according to its own decisions, so decline on any","+  // disagreement and let the CompactionService fall back to local compaction.","+  // A proximal_level of 0 means an older primary that sent no decisions.","+  bool placement_mismatch =","+      input.proximal_level != 0 &&","+      (c->GetProximalLevel() != input.proximal_level ||","+       static_cast<int>(c->GetProximalOutputRangeType()) !=","+           input.proximal_output_range_type ||","+       c->GetKeepInLastLevelThroughSeqno() !=","+           input.keep_in_last_level_through_seqno);","+  TEST_SYNC_POINT_CALLBACK(","+      \"DBImplSecondary::CompactWithoutInstallation:PerKeyPlacementCheck\",","+      &placement_mismatch);","+  if (placement_mismatch) {","+    ROCKS_LOG_WARN(","+        immutable_db_options_.info_log,","+        \"[%s] Remote compaction per-key placement differs from the \"","+        \"primary's (proximal level %d vs %d, range type %d vs %d, \"","+        \"keep in last level through seqno %\" PRIu64 \" vs %\" PRIu64","+        \"); declining so the job can fall back to local compaction.\",","+        cfd->GetName().c_str(), c->GetProximalLevel(), input.proximal_level,","+        static_cast<int>(c->GetProximalOutputRangeType()),","+        input.proximal_output_range_type, c->GetKeepInLastLevelThroughSeqno(),","+        input.keep_in_last_level_through_seqno);","+    s = Status::Incomplete(","+        \"Remote compaction worker's per-key placement differs from the \"","+        \"primary's\");","+    c->ReleaseCompactionFiles(s);","+    return s;","+  }","+","   LogBuffer log_buffer(InfoLogLevel::INFO_LEVEL,","                        immutable_db_options_.info_log.get());"," "],"additions":45,"deletions":1,"truncated":false},{"path":"unreleased_history/bug_fixes/remote_compaction_tiering_options.md","lines":["@@ -0,0 +1 @@","+Fixed remote compaction ignoring `preclude_last_level_data_seconds` and `preserve_internal_time_seconds`, which caused recent data to be written to the last level and recent sequence numbers to be zeroed. Takes effect once both the primary and the compaction worker are upgraded.",""],"additions":1,"deletions":0,"truncated":false}],"additions":406,"deletions":4,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-30T15:56:11.087401+00:00"}