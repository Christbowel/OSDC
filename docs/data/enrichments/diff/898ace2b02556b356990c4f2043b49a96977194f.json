{"id":"898ace2b02556b356990c4f2043b49a96977194f","axis":"silent","repo":"facebook/rocksdb","sha":"898ace2b02556b356990c4f2043b49a96977194f","parsed":{"files":[{"path":"db/column_family.cc","lines":["@@ -475,6 +475,9 @@ ColumnFamilyOptions SanitizeCfOptions(const ImmutableDBOptions& db_options,","                     result.preclude_last_level_data_seconds > 0)) {","     // With no writes coming in, we don't need periodic SeqnoToTime entries.","     // Existing SST files may or may not have that info associated with them.","+    // Remote compaction runs in a secondary (read-only) instance but writes","+    // files, so it restores both from the primary. See","+    // DBImplSecondary::CompactWithoutInstallation().","     ROCKS_LOG_WARN(","         db_options.info_log.get(),","         \"preserve_internal_time_seconds and preclude_last_level_data_seconds \""],"additions":3,"deletions":0,"truncated":false},{"path":"db/compaction/compaction_job.cc","lines":["@@ -407,11 +407,14 @@ void CompactionJob::Prepare(","   // being re-marked forever (infinite compaction loop). Other compaction","   // reasons keep the per-input-file boundary so their seqno-zeroing behavior is","   // unchanged. When preserve/preclude is inactive the version value is","-  // kMaxSequenceNumber, making this a no-op.","+  // kMaxSequenceNumber, making this a no-op. A remote compaction worker does","+  // not know the reason or the live mapping; it gets this boundary from the","+  // primary in CompactionServiceInput.","   if (c->compaction_reason() == CompactionReason::kBottommostFiles) {","-    preserve_time_min_seqno = std::max(preserve_time_min_seqno,","-                                       storage_info->GetPreserveTimeMinSeqno());","+    preserve_time_min_seqno_floor_ = storage_info->GetPreserveTimeMinSeqno();","   }","+  preserve_time_min_seqno =","+      std::max(preserve_time_min_seqno, preserve_time_min_seqno_floor_);"," ","   // Preserve sequence numbers for preserved write times and snapshots, though","   // the specific sequence number of the earliest snapshot can be zeroed."],"additions":6,"deletions":3,"truncated":false},{"path":"db/compaction/compaction_job.h","lines":["@@ -242,6 +242,10 @@ class CompactionJob {"," ","   CompactionJobStats* job_stats_;"," ","+  // Lower bound for the minimal sequence number whose write time is","+  // preserved. See Prepare().","+  SequenceNumber preserve_time_min_seqno_floor_ = 0;","+","  private:","   friend class CompactionJobTestBase;"," ","@@ -687,6 +691,24 @@ struct CompactionServiceInput {","   uint64_t min_manifest_file_number = 0;","   uint64_t min_manifest_file_size = 0;"," ","+  // The primary's values. The worker opens the DB as a secondary, which","+  // sanitizes them to 0 as a read-only DB. They are sent here rather than","+  // re-read from the OPTIONS file so that they always arrive together with","+  // preserve_time_min_seqno_floor: a preserve window without that floor would","+  // bring back the kBottommostFiles compaction loop.","+  uint64_t preserve_internal_time_seconds = 0;","+  uint64_t preclude_last_level_data_seconds = 0;","+  // The primary's lower bound for the minimal sequence number whose write time","+  // is preserved: the version-carried preserve boundary for a kBottommostFiles","+  // compaction, 0 otherwise.","+  SequenceNumber preserve_time_min_seqno_floor = 0;","+  // The primary's per-key placement decisions. The worker declines the job if","+  // its own Compaction differs. proximal_level is Compaction::kInvalidLevel","+  // when per-key placement is off, and 0 only from an older primary.","+  int proximal_level = 0;","+  int proximal_output_range_type = 0;","+  SequenceNumber keep_in_last_level_through_seqno = 0;","+","   // serialization interface to read and write the object","   static Status Read(const std::string& data_str, CompactionServiceInput* obj);","   Status Write(std::string* output);"],"additions":22,"deletions":0,"truncated":false},{"path":"db/compaction/