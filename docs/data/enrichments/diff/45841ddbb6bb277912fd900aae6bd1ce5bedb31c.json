"-","-            NTRUParameters ntruParams = Utils.ntruParamsLookup(keyInfo.getAlgorithm().getAlgorithm());","-","-            return new NTRUPublicKeyParameters(ntruParams, keyEnc);","         }","     }"," ","@@ -569,28 +578,36 @@ AsymmetricKeyParameter getPublicKeyParameters(SubjectPublicKeyInfo keyInfo, Obje"," ","         static DilithiumPublicKeyParameters getPublicKeyParams(DilithiumParameters dilithiumParams, ASN1BitString publicKeyData)","         {","+            byte[] keyEnc = publicKeyData.getOctets();","+","+            // the raw key, as written, is tried first: its leading bytes can read as a DER header covering the","+            // rest, so only a length other than the raw key's says the key is wrapped","             try","             {","-                ASN1Primitive obj = ASN1Primitive.fromByteArray(publicKeyData.getOctets());","+                return new DilithiumPublicKeyParameters(dilithiumParams, keyEnc);","+            }","+            catch (IllegalArgumentException e)","+            {","+                ASN1Primitive obj;","+                try","+                {","+                    obj = ASN1Primitive.fromByteArray(keyEnc);","+                }","+                catch (IOException ex)","+                {","+                    throw e;","+                }","+","                 if (obj instanceof ASN1Sequence)","                 {","                     ASN1Sequence keySeq = ASN1Sequence.getInstance(obj);"," ","-                    return new DilithiumPublicKeyParameters(dilithiumParams,","+                    return new DilithiumPublicKeyParameters(dilithiumParams, Arrays.concatenate(","                         ASN1OctetString.getInstance(keySeq.getObjectAt(0)).getOctets(),","-                        ASN1OctetString.getInstance(keySeq.getObjectAt(1)).getOctets());","+                        ASN1OctetString.getInstance(keySeq.getObjectAt(1)).getOctets()));","                 }","-                else","-                {","-  