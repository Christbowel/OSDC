,"-            }","-            catch (Exception e)","-            {","-                // we're a raw encoding","-                return new DilithiumPublicKeyParameters(dilithiumParams, publicKeyData.getOctets());","+                return new DilithiumPublicKeyParameters(dilithiumParams, ASN1OctetString.getInstance(obj).getOctets());","             }","         }","     }"," ","     private static class BIKEConverter","-            extends SubjectPublicKeyInfoConverter","+        extends SubjectPublicKeyInfoConverter","     {","         AsymmetricKeyParameter getPublicKeyParameters(SubjectPublicKeyInfo keyInfo, Object defaultParams)","-                throws IOException","+            throws IOException","         {","+            BIKEParameters bikeParams = Utils.bikeParamsLookup(keyInfo.getAlgorithm().getAlgorithm());","+            byte[] keyEnc = keyInfo.getPublicKeyData().getOctets();","+","+            // the raw key, as written, is tried first: its leading bytes can read as an OCTET STRING header","+            // covering the rest, so only a length other than the raw key's says the key is wrapped","             try","             {","-                byte[] keyEnc = ASN1OctetString.getInstance(keyInfo.parsePublicKey()).getOctets();","-","-                BIKEParameters bikeParams = Utils.bikeParamsLookup(keyInfo.getAlgorithm().getAlgorithm());","-","                 return new BIKEPublicKeyParameters(bikeParams, keyEnc);","             }","-            catch (Exception e)","+            catch (IllegalArgumentException e)","             {","-                byte[] keyEnc = keyInfo.getPublicKeyData().getOctets();","-","-                BIKEParameters bikeParams = Utils.bikeParamsLookup(keyInfo.getAlgorithm().getAlgorithm());","-","-                return new BIKEPublicKeyParameters(bikeParams, keyEnc);","+                ASN1Primitive obj;","+                try","+                {","+                    obj = ASN1Primitive.fromByteArray(keyEnc);","+                }","+                catch (IOException ex)","+                {","+                    throw e;","+                }","+                if (!(obj instanceof ASN1OctetString))","+                {","+                    throw e;","+                }","+                return new BIKEPublicKeyParameters(bikeParams, ASN1OctetString.getInstance(obj).getOctets());","             }","         }","     }"],"additions":67,"deletions":28,"truncated":false},{"path":"core/src/test/java/org/bouncycastle/pqc/crypto/test/AllTests.java","lines":["@@ -29,6 +29,7 @@ public static Test suite()","         suite.addTestSuite(FrodoKEMVectorTest.class);","         suite.addTestSuite(SABERVectorTest.class);","         suite.addTestSuite(NTRUTest.class);","+        suite.addTestSuite(RawPublicKeyEncodingTest.class);","         suite.addTestSuite(NTRUParametersTest.class);","         suite.addTestSuite(FalconTest.class);","         suite.addTestSuite(MLKEMTest.class);"],"additions":1,"deletions":0,"truncated":false},{"path":"core/src/test/java/org/bouncycastle/pqc/crypto/test/RawPublicKeyEncodingTest.java","lines":["@@ -0,0 +1,150 @@","+package org.bouncycastle.pqc.crypto.test;","+","+import java.security.SecureRandom;","+","+import junit.framework.TestCase;","+import org.bouncycastle.asn1.ASN1Encodable;","+import org.bouncycastle.asn1.DEROctetString;","+import org.bouncycastle.asn1.DERSequence;","+import org.bouncycastle.asn1.x509.AlgorithmIdentifier;","+import org.bouncycastle.asn1.x509.SubjectPublicKeyInfo;","+import org.bouncycastle.crypto.params.AsymmetricKeyParameter;","+import org.bouncycastle.pqc.crypto.ntru.NTRUKeyGenerationParameters;","+import org.bouncycastle.pqc.crypto.ntru.NTRUKeyPairGenerator;","+import org.bouncycastle.pqc.crypto.ntru.NTRUParameters;","+import org.bouncycastle.pqc.crypto.ntru.NTRUPublicKeyParameters;","+import org.bouncycastle.pqc.crypto.util.PublicKeyFactory;","+import org.bouncycastle.pqc.crypto.util.SubjectPublicKeyInfoFactory;","+import org.bouncycastle.pqc.legacy.bike.BIKEKeyGenerationParameters;","+import org.bouncycastle.pqc.legacy.bike.BIKEKeyPairGenerator;","+import org.bouncycastle.pqc.legacy.bike.BIKEParameters;","+import org.bouncycastle.pqc.legacy.bike.BIKEPublicKeyParameters;","+import org.bouncycastle.pqc.legacy.crystals.dilithium.DilithiumKeyGenerationParameters;","+import org.bouncycastle.pqc.legacy.crystals.dilithium.DilithiumKeyPairGenerator;","+import org.bouncycastle.pqc.legacy.crystals.dilithium.DilithiumParameters;","+import org.bouncycastle.pqc.legacy.crystals.dilithium.DilithiumPublicKeyParameters;","+import org.bouncycastle.util.Arrays;","+","+/**","+ * NTRU, Dilithium and BIKE public keys are written raw into the SubjectPublicKeyInfo BIT STRING, and the","+ * draft form that wrapped them in an OCTET STRING is still read. A raw key is random bytes, so it can begin","+ * with bytes that read as an OCTET STRING header whose length covers exactly the rest - about once in 2^32","+ * keys - and must still be read as the raw key: such an NTRU key used to be rejected, and such a Dilithium","+ * or BIKE key loaded as a different, shorter key. The prefix is forced onto real keys here; none of the","+ * three binds its public key bytes to anything a decoder checks.","+ */","+public class RawPublicKeyEncodingTest","+    extends TestCase","+{","+    private static final SecureRandom RANDOM = new SecureRandom();","+","+    public void testNTRU()","+        throws Exception","+    {","+        NTRUParameters[] parameterSets = { NTRUParameters.ntruhps2048509, NTRUParameters.ntruhps2048677,","+            NTRUParameters.ntruhps4096821, NTRUParameters.ntruhps40961229, NTRUParameters.ntruhrss701,","+            NTRUParameters.ntruhrss1373 };","+","+        for (int i = 0; i != parameterSets.length; i++)","+        {","+            NTRUKeyPairGenerator kpGen = new NTRUKeyPairGenerator();","+            kpGen.init(new NTRUKeyGenerationParameters(RANDOM, parameterSets[i]));","+            NTRUPublicKeyParameters pub = (NTRUPublicKeyParameters)kpGen.generateKeyPair().getPublic();","+","+            checkEncodings(parameterSets[i].getName(), SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(pub), pub.getEncoded());","+        }","+    }","+","+    public void testDilithium()","+        throws Exception","+    {","+        DilithiumParameters[] parameterSets = { DilithiumParameters.dilithium2, DilithiumParameters.dilithium3,","+            DilithiumParameters.dilithium5 };","+","+        for (int i = 0; i != parameterSets.length; i++)","+        {","+            DilithiumKeyPairGenerator kpGen = new DilithiumKeyPairGenerator();","+            kpGen.init(new DilithiumKeyGenerationParameters(RANDOM, parameterSets[i]));","+            DilithiumPublicKeyParameters pub = (DilithiumPublicKeyParameters)kpGen.generateKeyPair().getPublic();","+            SubjectPublicKeyInfo spki = SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(pub);","+            String name = parameterSets[i].getName();","+","+            checkEncodings(name, spki, pub.getEncoded());","+","+            // the draft SEQUENCE { rho, t1 } form","+            DERSequence seq = new DERSequence(new ASN1Encodable[]{ new DEROctetString(pub.getRho()), new DEROctetString(pub.getT1()) });","+            checkLoads(name + \" SEQUENCE\", new SubjectPublicKeyInfo(spki.getAlgorithm(), seq.getEncoded()), pub.getEncoded());","+        }","+    }","+","+    public void testBIKE()","+        throws Exception","+    {","+        BIKEParameters[] parameterSets = { BIKEParameters.bike128, BIKEParameters.bike192, BIKEParameters.bike256 };","+","+        for (int i = 0; i != parameterSets.length; i++)","+        {","+            BIKEKeyPairGenerator kpGen = new BIKEKeyPairGenerator();","+            kpGen.init(new BIKEKeyGenerationParameters(RANDOM, parameterSets[i]));","+            BIKEPublicKeyParameters pub = (BIKEPublicKeyParameters)kpGen.generateKeyPair().getPublic();","+","+            checkEncodings(parameterSets[i].getName(), SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(pub), pub.getEncoded());","+        }","+    }","+","+    private static void checkEncodings(String name, SubjectPublicKeyInfo spki, byte[] raw)","+        throws Exception","+    {","+        AlgorithmIdentifier algId = spki.getAlgorithm();","+","+        // as written, and the draft OCTET STRING form","+        assertTrue(name, Arrays.areEqual(raw, spki.getPublicKeyData().getOctets()));","+        checkLoads(name + \" raw\", spki, raw);","+        checkLoads(name + \" wrapped\", new SubjectPublicKeyInfo(algId, new DEROctetString(raw).getEncoded()), raw);","+","+        // a raw key whose first bytes read as an OCTET STRING of everything after them","+        byte[] misleading = Arrays.clone(raw);","+        misleading[0] = 0x04;","+        misleading[1] = (byte)0x82;","+        misleading[2] = (byte)((raw.length - 4) >> 8);","+        misleading[3] = (byte)(raw.length - 4);","+        checkLoads(name + \" raw that reads as an OCTET STRING\", new SubjectPublicKeyInfo(algId, misleading), misleading);","+","+        // a key of the wrong length is refused, raw or wrapped, rather than loaded short","+        checkRejected(name + \" short raw\", new SubjectPublicKeyInfo(algId, Arrays.copyOf(raw, raw.length - 1)));","+        checkRejected(name + \" short wrapped\", new SubjectPublicKeyInfo(algId, new DEROctetString(Arrays.copyOf(raw, raw.length - 1)).getEncoded()));","+    }","+","+    private static void checkLoads(String label, SubjectPublicKeyInfo spki, byte[] expected)","+        throws Exception","+    {","+        AsymmetricKeyParameter key = PublicKeyFactory.createKey(spki);","+        byte[] encoded;","+        if (key instanceof NTRUPublicKeyParameters)","+        {","+            encoded = ((NTRUPublicKeyParameters)key).getEncoded();","+        }","+        else if (key instanceof DilithiumPublicKeyParameters)","+        {","+            encoded = ((DilithiumPublicKeyParameters)key).getEncoded();","+        }","+        else","+        {","+            encoded = ((BIKEPublicKeyParameters)key).getEncoded();","+        }","+        assertTrue(label + \": loaded a different key\", Arrays.areEqual(expected, encoded));","+    }","+","+    private static void checkRejected(String label, SubjectPublicKeyInfo spki)","+    {","+        try","+        {","+            PublicKeyFactory.createKey(spki);","+            fail(label + \": accepted\");","+        }","+        catch (Exception e)","+        {","+            // expected","+        }","+    }","+}"],"additions":150,"deletions":0,"truncated":false},{"path":"docs/releasenotes.md","lines":["@@ -207,6 +207,7 @@ Date: 2026, TBD"," - SNTRU Prime and NTRU LPRime sign-extended the last byte of a public key or ciphertext encoding when its final value spans two bytes, which happens for most parameter sets, so an encoding with that byte at 0x80 or above decoded to different values than the reference implementation's. Only non-canonical encodings were affected, since a valid one's last byte is below 0x40: a malformed public key was encapsulated against a different polynomial than the reference would use, and a malformed ciphertext is rejected either way."," - SNTRU Prime and NTRU LPRime decapsulation derived the implicit-rejection secret for an invalid ciphertext from the ciphertext it re-encrypted from the decrypted message, where the NTRU Prime specification and reference implementation hash the ciphertext received, and NTRU LPRime also hashed it under the prefix used for a valid ciphertext. The re-encryption depends only on the decrypted message, so two invalid ciphertexts that decrypted to the same message gave the same secret - for example a valid ciphertext with its confirmation hash changed in two different ways - and anyone able to compare decapsulation results under one key could tell whether two chosen ciphertexts decrypt to the same message: the plaintext-checking oracle implicit rejection exists to deny. NTRU LPRime before 1.85 put the received rounded polynomial and T in the hash, which limited the collisions to ciphertexts differing only in the confirmation hash. The rejection secret now depends only on rho and the received ciphertext, and secrets for valid ciphertexts are unchanged. Keys used for a single decapsulation, as in SSH's sntrup761x25519-sha512 key exchange, are not exposed."," - NTRU+ decapsulation never reported a rejected ciphertext. The NTRU+ reference implementation rejects explicitly, returning failure with a zeroed secret, and NTRUPlusKEMExtractor discarded the failure and returned the secret as a shared key, so every invalid ciphertext gave the same all-zero secret, which anyone can compute. Worse, when the message decoding check failed, a sign error in its port of the reference's unsigned failure flag left the real secret derived from the decrypted message in place with only the low bit of each byte cleared. Either way anyone able to submit ciphertexts to a key could tell from the result whether, and to what, a chosen ciphertext decrypts. extractSecret() now throws IllegalArgumentException for a rejected ciphertext, which the BCPQC provider reports as a DecapsulateException from javax.crypto.KEM and an InvalidKeyException from Cipher.unwrap(). Ciphertexts and public keys with a coefficient of q or more are now also refused as non-canonical encodings, as the reference implementation does. Secrets for valid ciphertexts are unchanged.","+- The NTRU, Dilithium and BIKE public key decoders read a SubjectPublicKeyInfo as the wrapped OCTET STRING form of the drafts whenever its bytes parsed as one, though BC writes these keys raw. A raw key is random bytes and about one in 2^32 begins with bytes that read as an OCTET STRING header covering the rest: such an NTRU key was rejected, and such a Dilithium or BIKE key loaded as a different, shorter key, since neither key class checked the length it was given. The raw form is now tried first and the wrapped form only for content that is not a raw key's length, and the Dilithium and BIKE public key classes now reject an encoding of the wrong length. The jdk1.4 NTRU decoder, which read only the wrapped form and so not the keys BC writes, now reads both."," - The BC provider registered no key info converter for the NTRU LPRime, Streamlined NTRU Prime and NTRU+ OIDs, although core's key factories handle all of them, so BouncyCastleProvider.getPublicKey() and getPrivateKey() returned null for such a SubjectPublicKeyInfo or PrivateKeyInfo, and their keys and certificates could not be decoded through the standard provider's CertificateFactory or KeyFactory, only through BCPQC. The twelve NTRU Prime and three NTRU+ parameter-set OIDs are now bridged in loadPQCKeys(), as the other BCPQC KEMs already were (github PR #2438)."," - PGPLiteralData.getFileName() and LiteralDataPacket.getFileName() threw an IllegalArgumentException for a file name that was not valid UTF-8, which the file name need not be and which a damaged ciphertext produces, since the literal data header is read before any integrity check. The high-level OpenPGPMessageProcessor reads the file name for every message, so such a message could not be read through it at all, and a damaged one failed with this unchecked exception instead of the integrity check. A malformed sequence in the file name is now decoded as U+FFFD, as it now is in SignerUserID.getID(); valid names decode exactly as before, and getRawFileName() and getRawID() still return the exact bytes (github #2549)."],"additions":1,"deletions":0,"truncated":false}],"additions":333,"deletions":89,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-04T16:06:01.649562+00:00"}