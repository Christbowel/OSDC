{"id":"GHSA-mghf-wjfp-p5xm","axis":"advisories","repo":"bytecodealliance/wasmtime","sha":"222ff3a65dab9aa7011f8c246937751a0bac5abd","parsed":{"files":[{"path":"RELEASES.md","lines":["@@ -1,3 +1,24 @@","+## 48.0.7","+","+Released 2026-10-19.","+","+### Fixed","+","+* wasi-http: Guests can add conflicting content lengths to messages","+  [GHSA-r8xh-cgf7-392j](https://github.com/bytecodealliance/wasmtime/security/advisories/GHSA-r8xh-cgf7-392j)","+* wasi-http p3: forwarded trailers aren't checked against `is_forbidden_header` hook","+  [GHSA-jxcf-8qw5-5c33](https://github.com/bytecodealliance/wasmtime/security/advisories/GHSA-jxcf-8qw5-5c33)","+* wasi-http p3: Guests can set incorrect content-length for spliced response bodies","+  [GHSA-9prg-84vf-g5fc](https://github.com/bytecodealliance/wasmtime/security/advisories/GHSA-9prg-84vf-g5fc)","+* Cranelift backend on aarch64 can jump to incorrect target on large Wasm `br_table` instruction","+  [GHSA-mghf-wjfp-p5xm](https://github.com/bytecodealliance/wasmtime/security/advisories/GHSA-mghf-wjfp-p5xm)","+* Update rustls to 0.23.46","+  [#14768](https://github.com/bytecodealliance/wasmtime/pull/14768)","+*  Panic lowering a host-created component model stream into a guest that expects a different payload type.","+  [GHSA-9pvw-hwfg-92h5](https://github.com/bytecodealliance/wasmtime/security/advisories/GHSA-9pvw-hwfg-92h5)","+","+--------------------------------------------------------------------------------","+"," ## 48.0.6"," "," Released 2026-10-14."],"additions":21,"deletions":0,"truncated":false},{"path":"cranelift/codegen/src/isa/aarch64/inst.isle","lines":["@@ -5194,14 +5194,18 @@"," ;; Helper for emitting `MInst.JTSequence` instructions."," ;; Emit the compound instruction that does:"," ;;","-;; b.hs default","-;; csel rB, xzr, rIndex, hs","+;; mov rB, #N            ; N = number of non-default targets","+;; csel rB, rIndex, rB, lo ; clamp out-of-bounds indices to N"," ;; csdb"," ;; adr rA, jt"," ;; ldrsw rB, [rA, rB, uxtw #2]"," ;; add rA, rA, rB"," ;; br rA","-;; [jt entries]","+;; jt: [N target entries] [default entry]","+;;","+;; The flags must be set by a comparison of `rIndex` against `N`.","+;; There is deliberately no conditional branch to the default target:","+;; its range would be limited, and the inline jump table may be large."," ;;"," ;; This must be *one* instruction in the vcode because"," ;; we cannot allow regalloc to insert any spills/fills"],"additions":7,"deletions":3,"truncated":false},{"path":"cranelift/codegen/src/isa/aarch64/inst/emit.rs","lines":["@@ -3177,25 +3177,28 @@ impl MachInstEmit for Inst {","                 // emission time, because we cannot allow the regalloc to insert spills/reloads in","                 // the middle; we depend on hardcoded PC-rel addressing below."," ","-                // Branch to default when condition code from prior comparison indicates.","-                let br =","-                    enc_conditional_br(BranchTarget::Label(default), CondBrKind::Cond(Cond::Hs));","-","-                // No need to inform the sink's branch folding logic about this branch, because it","-                // will not be merged with any other branch, flipped, or elided (it is not preceded","-                // or succeeded by any other branch). Just emit it with the label use.","-                let default_br_offset = sink.cur_offset();","-                sink.use_label_at_offset(default_br_offset, default, LabelUse::Branch19);","-                sink.put4(br);","-","-                // Overwrite the index with a zero when the above","-                // branch misspeculates (Spectre mitigation). Save the","-                // resulting index in rtmp2.","+                // The default target is stored as the last entry in the","+                // jump table (at index `targets.len()`), and we clamp the","+                // index to that entry when it is out of bounds. This avoids","+                // any conditional branch to the default target: such a","+                // branch would have limited range, and the inline jump","+                // table that follows it can be arbitrarily large.","+                //","+                // The flags are set by a prior comparison of `ridx` against","+                // `targets.len()`; \"lo\" (unsigned less-than) means in-bounds.","+                let default_index = u64::try_from(targets.len()).unwrap();","+                for inst in Inst::load_constant(rtmp2, default_index) {","+                    inst.emit(sink, emit_info, state);","+                }","+                // Clamp the index: in-bounds indices are kept, and","+                // out-of-bounds indices select the default entry. This is","+                // also the Spectre mitigation, since there is no","+                // conditional branch to mispredict.","                 let inst = Inst::CSel {","                     rd: rtmp2,","-                    cond: Cond::Hs,","-                    rn: zero_reg(),","-                    rm: ridx,","+                    cond: Cond::Lo,","+                    rn: ridx,","+                    rm: rtmp2.to_reg(),","                 };","                 inst.emit(sink, emit_info, state);","                 // Prevent any data value speculation if spectre mitigations are","@@ -3236,9 +3239,10 @@ impl MachInstEmit for Inst {","                     targets: vec![],","                 };","                 inst.emit(sink, emit_info, state);","-                // Emit jump table (table of 32-bit offsets).","+                // Emit jump table (table of 32-bit offsets), with the","+                // default target as the final entry.","                 let jt_off = sink.cur_offset();","-                for &target in targets.iter() {","+                for &target in targets.iter().chain(core::iter::once(&default)) {","                     let word_off = sink.cur_offset();","                     // off_into_table is an addend here embedded in the label to be later patched","                     // at the end of codegen. The offset is initially relative to this jump table"],"additions":23,"deletions":19,"truncated":false},{"path":"cranelift/codegen/src/isa/aarch64/inst/mod.rs","lines":["@@ -2762,29 +2762,17 @@ impl Inst {","                 let rtmp1 = pretty_print_reg(rtmp1.to_reg());","                 let rtmp2 = pretty_print_reg(rtmp2.to_reg());","                 let default_target = BranchTarget::Label(default).pretty_print(0);","+                let num_targets = targets.len();","                 format!(","-                    concat!(","-                        \"b.hs {} ; \",","-                        \"csel {}, xzr, {}, hs ; \",","-                        \"csdb ; \",","-                        \"adr {}, pc+16 ; \",","-                        \"ldrsw {}, [{}, {}, uxtw #2] ; \",","-                        \"add {}, {}, {} ; \",","-                        \"br {} ; \",","-                        \"jt_entries {:?}\"","-                    ),","-                    default_target,","-                    rtmp2,","-                    ridx,","-                    rtmp1,","-                    rtmp2,","-                    rtmp1,","-                    rtmp2,","-                    rtmp1,","-                    rtmp1,","-                    rtmp2,","-                    rtmp1,","-                    targets","+                    \"mov {rtmp2}, #{num_targets} ; \\","+                     csel {rtmp2}, {ridx}, {rtmp2}, lo ; \\","+                     csdb ; \\","+                     adr {rtmp1}, pc+16 ; \\","+                     ldrsw {rtmp2}, [{rtmp1}, {rtmp2}, uxtw #2] ; \\","+                     add {rtmp1}, {rtmp1}, {rtmp2} ; \\","+                     br {rtmp1} ; \\","+                     jt_entries {targets:?} ; \\","+                     default {default_target}\"","                 )","             }","             &Inst::LoadExtNameGot { rd, ref name } => {","@@ -2993,8 +2981,8 @@ impl MachInstLabelUse for LabelUse {","     /// Perform the patch.","     fn patch(self, buffer: &mut [u8], use_offset: CodeOffset, label_offset: CodeOffset) {","         let pc_rel = (label_offset as i64) - (use_offset as i64);","-        debug_assert!(pc_rel <= self.max_pos_range() as i64);","-        debug_assert!(pc_rel >= -(self.max_neg_range() as i64));","+        assert!(pc_rel <= self.max_pos_range() as i64);","+        assert!(pc_rel >= -(self.max_neg_range() as i64));","         let pc_rel = pc_rel as u32;","         let insn_word = u32::from_le_bytes([buffer[0], buffer[1], buffer[2], buffer[3]]);","         let mask = match self {"],"additions":12,"deletions":24,"truncated":false},{"path":"cranelift/codegen/src/isa/aarch64/lower/isle.rs","lines":["@@ -627,8 +627,8 @@ impl Context for IsleContext<'_, '_, MInst, AArch64Backend> {","     fn targets_jt_space(&mut self, elements: &BoxVecMachLabel) -> CodeOffset {","         // calculate the number of bytes needed for the jumptable sequence:","         // 4 bytes per instruction, with 8 instructions base + the size of","-        // the jumptable more.","-        (4 * (8 + elements.len())).try_into().unwrap()","+        // the jumptable more (including the default entry).","+        (4 * (8 + elements.len() + 1)).try_into().unwrap()","     }"," ","     fn min_fp_value(&mut self, signed: bool, in_bits: u8, out_bits: u8) -> Reg {"],"additions":2,"deletions":2,"truncated":false},{"path":"cranelift/filetests/filetests/isa/aarch64/bti.clif","lines":["@@ -32,9 +32,9 @@ block5(v5: i32):"," ; VCode:"," ;   bti c"," ; block0:","-;   emit_island 44","+;   emit_island 48"," ;   subs wzr, w0, #3","-;   b.hs label4 ; csel x11, xzr, x0, hs ; csdb ; adr x10, pc+16 ; ldrsw x11, [x10, x11, uxtw #2] ; add x10, x10, x11 ; br x10 ; jt_entries [MachLabel(3), MachLabel(2), MachLabel(1)]","+;   mov x11, #3 ; csel x11, x0, x11, lo ; csdb ; adr x10, pc+16 ; ldrsw x11, [x10, x11, uxtw #2] ; add x10, x10, x11 ; br x10 ; jt_entries [MachLabel(