vider_identity_match(","+        &self,","+        current_node_id: &NodeId,","+        cached_node_id: &NodeId,","+    ) -> CacheMatch {","+        let current = self.cache_owner_node_id(current_node_id);","+        let cached = self.cache_owner_node_id(cached_node_id);","+        if current == cached {","+            return CacheMatch::Match;","+        }","+        let mut pending = VecDeque::new();","+        let root_match = self.computed_provider_match(current, cached, &mut pending);","+        if root_match != CacheMatch::Match || pending.is_empty() {","+            return root_match;","+        }","+        let mut compared = HashSet::default();","+        let mut verdict = CacheMatch::Match;","+        while let Some((current, cached)) = pending.pop_front() {","+            let current = self.cache_owner_node_id(current);","+            let cached = self.cache_owner_node_id(cached);","+            if current == cached || !compared.insert((current, cached)) {","+                continue;","+            }","+            match self.computed_provider_match(current, cached, &mut pending) {","+                CacheMatch::NoMatch => return CacheMatch::NoMatch,","+                CacheMatch::Ambiguous => verdict = CacheMatch::Ambiguous,","+                CacheMatch::Match => {}","+            }","+        }","+        verdict","+    }","+","+    fn computed_provider_match<'a>(","+        &'a self,","+        current: &'a NodeId,","+        cached: &'a NodeId,","+        pending: &mut VecDeque<(&'a NodeId, &'a NodeId)>,","+    ) -> CacheMatch {","+        let (Some(current_path), Some(cached_path)) =","+            (self.caches.node_dep_paths.get(current), self.caches.node_dep_paths.get(cached))","+        else {","+            return CacheMatch::Ambiguous;","+        };","+        if current_path != cached_path {","+            return CacheMatch::NoMatch;","+        }","+        if index_of_dep_path_suffix(current_path.as_str()).peers_index.is_none() {","+        