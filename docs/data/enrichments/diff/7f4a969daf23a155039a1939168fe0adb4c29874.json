Context.SetData(\"APP_CONTEXT_BASE_DIRECTORY\", previousBaseDirectory);","+            Environment.CurrentDirectory = currentDirectory;","+        }","+    }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"src/tests/tracing/eventpipe/native/containers/NativeContainerTests.csproj","lines":["@@ -0,0 +1,7 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+  <ItemGroup>","+    <Compile Include=\"NativeContainerTests.cs\" />","+    <CMakeProjectReference Include=\"CMakeLists.txt\" />","+    <ProjectReference Include=\"$(TestLibraryProjectPath)\" />","+  </ItemGroup>","+</Project>"],"additions":7,"deletions":0,"truncated":false},{"path":"src/tests/tracing/eventpipe/native/containers/dn-fwd-list-tests.c","lines":["rename from src/mono/mono/eventpipe/test/dn-fwd-list-tests.c","rename to src/tests/tracing/eventpipe/native/containers/dn-fwd-list-tests.c","@@ -1,10 +1,13 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+"," #if defined(_MSC_VER) && defined(_DEBUG)"," #define _CRTDBG_MAP_ALLOC"," #include <stdlib.h>"," #include <crtdbg.h>"," #endif"," ","-#include <eglib/test/test.h>","+#include \"test.h\""," #include <containers/dn-fwd-list.h>"," "," ","@@ -718,7 +721,7 @@ test_fwd_list_reverse (void)"," \tdn_fwd_list_reverse (list);"," "," \tDN_FWD_LIST_FOREACH_BEGIN (void *, data, list) {","-\t\tif (POINTER_TO_INT32 (data) != count - 1)","+\t\tif (POINTER_TO_INT32 (data) != (int32_t)count - 1)"," \t\t\treturn FAILED (\"reverse failed #1\");"," \t\tcount--;"," \t} DN_FWD_LIST_FOREACH_END;","@@ -866,7 +869,7 @@ test_fwd_list_iterator (void)"," \t\tdn_fwd_list_insert_after (dn_fwd_list_end (list), INT32_TO_POINTER (i));"," "," \tDN_FWD_LIST_FOREACH_BEGIN (void *, data, list) {","-\t\tif (POINTER_TO_INT32 (data) != count)","+\t\tif (POINTER_TO_INT32 (data) != (int32_t)count)"," \t\t\treturn FAILED (\"foreach iterator failed #1\");"," \t\tcount++;"," \t} DN_FWD_LIST_FOREAC