ErrorInfo, ErrorResponse","+","+pytestmark = pytest.mark.skip_global_cleanup","+","+","+@pytest.mark.parametrize(","+    (\"status_code\", \"expected_type\"),","+    [","+        (400, \"invalid_request_error\"),","+        (401, \"authentication_error\"),","+        (403, \"permission_error\"),","+        (404, \"not_found_error\"),","+        (413, \"request_too_large\"),","+        (418, \"invalid_request_error\"),","+        (422, \"invalid_request_error\"),","+        (429, \"rate_limit_error\"),","+        (500, \"api_error\"),","+        (501, \"api_error\"),","+        (503, \"overloaded_error\"),","+    ],","+)","+def test_error_type_is_translated_to_anthropic_vocabulary(","+    status_code: int, expected_type: str","+):","+    response = translate_error_response(","+        ErrorResponse(","+            error=ErrorInfo(","+                message=\"boom\",","+                # Deliberately use an internal type name to prove it is ignored.","+                type=\"NotFoundError\",","+                code=status_code,","+            )","+        )","+    )","+    assert response.status_code == status_code","+    assert json.loads(response.body) == {","+        \"type\": \"error\",","+        \"error\": {\"type\": expected_type, \"message\": \"boom\"},","+    }","+","+","+@pytest.mark.parametrize(","+    (\"status_code\", \"expected_type\"),","+    [","+        (404, \"not_found_error\"),","+        (429, \"rate_limit_error\"),","+        (503, \"overloaded_error\"),","+        (500, \"api_error\"),","+    ],","+)","+@pytest.mark.asyncio","+async def test_stream_error_event_uses_translated_type(","+    status_code: int, expected_type: str","+):","+    \"\"\"The SSE error path must translate ``error.type`` the same way as the","+    non-streaming path, reusing the ErrorResponse status code.\"\"\"","+    from vllm.entrypoints.anthropic.serving import AnthropicServingMessages","+","+    async def fake_generator():","+        yield ErrorResponse(","+            error=ErrorInfo(","+                message=\"boom\",","+                type=\"InternalError\",","+                code=status_code,","+            )","+        )","+","+    # The converter's error path does not touch instance attributes, so","+    # __new__ bypasses __init__ safely here.","+    converter = AnthropicServingMessages.__new__(AnthropicServingMessages)","+    events = [e async for e in converter.message_stream_converter(fake_generator())]","+    error_events = [e for e in events if e.startswith(\"event: error\")]","+    assert len(error_events) == 1","+    payload_line = [","+        line for line in error_events[0].splitlines() if line.startswith(\"data: \")","+    ][0]","+    payload = json.loads(payload_line[len(\"data: \") :])","+    assert payload[\"type\"] == \"error\"","+    assert payload[\"error\"][\"type\"] == expected_type","+    assert payload[\"error\"][\"message\"] == \"boom\"","+","+","+@pytest.mark.asyncio","+async def test_stream_mid_stream_exception_maps_to_api_error():","+    \"\"\"An exception raised mid-stream (not an ErrorResponse) surfaces as","+    ``api_error`` in the SSE error event.\"\"\"","+    from vllm.entrypoints.anthropic.serving import AnthropicServingMessages","+","+    async def failing_generator():","+        raise RuntimeError(\"kaboom\")","+        yield  # pragma: no cover - make this an async generator","+","+    converter = AnthropicServingMessages.__new__(AnthropicServingMessages)","+    events = [e async for e in converter.message_stream_converter(failing_generator())]","+    error_events = [e for e in events if e.startswith(\"event: error\")]","+    assert len(error_events) == 1","+    payload_line = [","+        line for line in error_events[0].splitlines() if line.startswith(\"data: \")","+    ][0]","+    payload = json.loads(payload_line[len(\"data: \") :])","+    assert payload[\"error\"][\"type\"] == \"api_error\"","+    assert payload[\"error\"][\"message\"] == \"kaboom\""],"additions":111,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/anthropic/api_router.py","lines":["@@ -14,6 +14,7 @@","     AnthropicErrorResponse,","     AnthropicMessagesRequest,","     AnthropicMessagesResponse,","+    translate_error_type,"," )"," from vllm.entrypoints.anthropic.serving import AnthropicServingMessages"," from vllm.entrypoints.serve.engine.protocol import ErrorResponse","@@ -39,7 +40,7 @@ def messages(request: Request) -> AnthropicServingMessages:"," def translate_error_response(response: ErrorResponse) -> JSONResponse:","     anthropic_error = AnthropicErrorResponse(","         error=AnthropicError(","-            type=response.error.type,","+            type=translate_error_type(response.error.code),","             message=response.error.message,","         )","     )"],"additions":2,"deletions":1,"truncated":false},{"path":"vllm/entrypoints/anthropic/protocol.py","lines":["@@ -3,6 +3,7 @@"," \"\"\"Pydantic models for Anthropic API protocol.\"\"\""," "," import time","+from http import HTTPStatus"," from typing import Annotated, Any, Literal"," "," from pydantic import BaseModel, Field, field_validator, model_validator","@@ -28,6 +29,30 @@ class AnthropicErrorResponse(BaseModel):","     error: AnthropicError"," "," ","+# Anthropic SDKs dispatch on ``error.type``, which must use Anthropic's own","+# vocabulary rather than vLLM's internal/Python error class names.","+_ANTHROPIC_ERROR_TYPE_BY_STATUS: dict[int, str] = {","+    HTTPStatus.BAD_REQUEST.value: \"invalid_request_error\",","+    HTTPStatus.UNAUTHORIZED.value: \"authentication_error\",","+    HTTPStatus.FORBIDDEN.value: \"permission_error\",","+    HTTPStatus.NOT_FOUND.value: \"not_found_error\",","+    HTTPStatus.REQUEST_ENTITY_TOO_LARGE.value: \"request_too_large\",","+    HTTPStatus.TOO_MANY_REQUESTS.value: \"rate_limit_error\",","+    # vLLM reports overload (e.g. QueueOverflowError) as HTTP 503.","+    HTTPStatus.SERVICE_UNAVAILABLE.value: \"overloaded_error\",","+}","+","+","+def translate_error_type(status_code: int) -> str:","+    \"\"\"Translate an HTTP status code to Anthropic's ``error.type`` vocabulary.\"\"\"","+    error_type = _ANTHROPIC_ERROR_TYPE_BY_STATUS.get(status_code)","+    if error_type is not None:","+        return error_type","+    if status_code >= HTTPStatus.INTERNAL_SERVER_ERROR.value:","+        return \"api_error\"","+    return \"invalid_request_error\"","+","+"," class AnthropicUsage(BaseModel):","     \"\"\"Token usage information.\"\"\""," "],"additions":25,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/anthropic/serving.py","lines":["@@ -34,6 +34,7 @@","     AnthropicTool,","     AnthropicToolChangeDefinition,","     AnthropicUsage,","+    translate_error_type,"," )"," from vllm.entrypoints.generate.base.protocol import (","     JsonSchemaResponseFormat,","@@ -49,7 +50,7 @@"," )"," from vllm.entrypoints.openai.chat_completion.serving import OpenAIServingChat"," from vllm.entrypoints.openai.models.serving import OpenAIServingModels","-from vllm.entrypoints.serve.engine.protocol import ErrorResponse, UsageInfo","+from vllm.entrypoints.serve.engine.protocol import ErrorInfo, ErrorResponse, UsageInfo"," from vllm.entrypoints.serve.exception_handling.utils import sanitize_message"," from vllm.entrypoints.serve.utils.request_logger import RequestLogger"," from vllm.logger import init_logger","@@ -61,6 +62,16 @@"," logger = init_logger(__name__)"," "," ","+class _StreamError(Exception):","+    \"\"\"Carries the ErrorInfo from an upstream ErrorResponse through the stream","+    converter so the SSE ``error`` event can reuse its status code to pick the","+    Anthropic error type.\"\"\"","+","+    def __init__(self, error_info: ErrorInfo) -> None:","+        super().__init__(error_info.message)","+        self.error_info = error_info","+","+"," def _build_anthropic_usage(","     usage: UsageInfo | None,"," ) -> AnthropicUsage:","@@ -1018,7 +1029,7 @@ def stop_and_flush() -> list[str]:"," ","             async for origin_chunk in generator:","                 if isinstance(origin_chunk, ErrorResponse):","-                    raise RuntimeError(origin_chunk.error.message)","+                    raise _StreamError(origin_chunk.error)","                 if first_item:","                     chunk = AnthropicStreamEvent(","                         type=\"message_start\",","@@ -1218,11 +1229,19 @@ def stop_and_flush() -> list[str]:","             logger.exception(\"Error in message stream converter.\")","             for event in stop_active_block():","                 yield event","+            if isinstance(e, _StreamError):","+                # Reuse the ErrorResponse status code so the SSE error event","+                # uses the same Anthropic vocabulary as the non-streaming","+                # path (e.g. overloaded_error, not_found_error). The message","+                # was already sanitized by create_error_response upstream.","+                error_type = translate_error_type(e.error_info.code)","+                message = e.error_info.message","+            else:","+                error_type = \"api_error\"","+                message = sanitize_message(str(e))","             error_response = AnthropicStreamEvent(","                 type=\"error\",","-                error=AnthropicError(","-                    type=\"internal_error\", message=sanitize_message(str(e))","-                ),","+                error=AnthropicError(type=error_type, message=message),","             )","             data = error_response.model_dump_json(exclude_unset=True)","             yield wrap_data_with_event(data, \"error\")",""],"additions":24,"deletions":5,"truncated":false}],"additions":170,"deletions":12,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-23T14:15:06.131783+00:00"}