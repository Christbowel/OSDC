 none. The owner of a resource registers it, from an","+// init function, so nothing here names a specific resource.","+//","+// It panics on a second registration of the same resource: two owners claiming one","+// resource would make what is published depend on init order.","+func RegisterWatchMetadata(gr schema.GroupResource, spec WatchMetadataSpec) {","+\twatchMetadataSpecsMu.Lock()","+\tdefer watchMetadataSpecsMu.Unlock()","+\tif _, ok := watchMetadataSpecs[gr]; ok {","+\t\tpanic(fmt.Sprintf(\"RegisterWatchMetadata: %s is already registered\", gr))","+\t}","+\twatchMetadataSpecs[gr] = spec","+}","+","+// WatchMetadataFor returns the spec registered for gr.","+func WatchMetadataFor(gr schema.GroupResource) (WatchMetadataSpec, bool) {","+\twatchMetadataSpecsMu.RLock()","+\tdefer watchMetadataSpecsMu.RUnlock()","+\tspec, ok := watchMetadataSpecs[gr]","+\treturn spec, ok","+}","+","+// newWatchMetadata returns the notification metadata for a write of the given","+// resource, or nil when no spec is registered for it.","+func newWatchMetadata(gr schema.GroupResource, obj utils.GrafanaMetaAccessor) *resourcepb.NotificationMetadata {","+\tspec, ok := WatchMetadataFor(gr)","+\tif !ok {","+\t\treturn nil","+\t}","+\treturn buildWatchMetadata(spec, obj)","+}","+","+// buildWatchMetadata extracts the metadata spec allows from obj, or nil when obj is nil.","+func buildWatchMetadata(spec WatchMetadataSpec, obj utils.GrafanaMetaAccessor) *resourcepb.NotificationMetadata {","+\tif obj == nil {","+\t\treturn nil","+\t}","+\tm := &resourcepb.NotificationMetadata{","+\t\tLabels:                  filterKeys(obj.GetLabels(), spec.Labels),","+\t\tAnnotations:             filterKeys(obj.GetAnnotations(), spec.Annotations),","+\t\tFinalizers:              filterFinalizers(obj.GetFinalizers(), spec.Finalizers),","+\t\tGeneration:              obj.GetGeneration(),","+\t\tCreationTimestampMillis: timeToMillis(obj.GetCreationTimestamp().Time),","+\t}","+\tif dt := obj.GetDeletionTimestamp(); dt != nil {","+\t\tm.DeletionTimestampMillis = timeToMillis(dt.Time)","+\t}","+\treturn m","+}","+","+// filterKeys keeps only the allowed keys, or nil when none are set.","+func filterKeys(m map[string]string, allowed []string) map[string]string {","+\tvar out map[string]string","+\tfor _, key := range allowed {","+\t\tif v, ok := m[key]; ok {","+\t\t\tif out == nil {","+\t\t\t\tout = make(map[string]string, len(allowed))","+\t\t\t}","+\t\t\tout[key] = v","+\t\t}","+\t}","+\treturn out","+}","+","+// filterFinalizers keeps only the allowed finalizers, or nil when none are set.","+func filterFinalizers(finalizers, allowed []string) []string {","+\tvar out []string","+\tfor _, f := range finalizers {","+\t\tif slices.Contains(allowed, f) {","+\t\t\tif out == nil {","+\t\t\t\tout = make([]string, 0, len(allowed))","+\t\t\t}","+\t\t\tout = append(out, f)","+\t\t}","+\t}","+\treturn out","+}","+","+func timeToMillis(t time.Time) int64 {","+\tif t.IsZero() {","+\t\treturn 0","+\t}","+\treturn t.UnixMilli()","+}"],"additions":114,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/notifier_nats.go","lines":["@@ -287,6 +287,7 @@ func (n *natsNotifier) decode(subject string, data []byte) (Event, bool) {"," \t\tPreviousRV:      notification.PreviousResourceVersion,"," \t\tPreviousAction:  previousAction,"," \t\tPreviousFolder:  notification.PreviousFolder,","+\t\tMetadata:        notification.GetMetadata(),"," \t}, true"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/notifier_nats_integration_test.go","lines":["@@ -18,6 +18,7 @@ import ("," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\""," \t\"google.golang.org/grpc/peer\"","+\t\"google.golang.org/protobuf/proto\""," \t\"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured\""," \t\"k8s.io/apimachinery/pkg/runtime/schema\""," ","@@ -151,6 +152,45 @@ func TestIntegrationNatsWatchNotificationRoundTrip(t *testing.T) {"," \