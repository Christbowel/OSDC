KING, Any, Dict, Iterator, List, Optional, Set"," "," import pyarrow as pa"," import pyarrow.dataset as pds","@@ -256,9 +257,9 @@ def _read_whole_file(","         with fragment_to_read.fragment.open() as file:","             return memoryview(file.read_buffer())"," ","-    def _read_chunk_fragment(","+    def _read_chunk_lines(","         self, fragment_to_read: ReadUnitFragment","-    ) -> Optional[pds.Fragment]:","+    ) -> Optional[memoryview]:","         \"\"\"Fetch a chunk unit's whole lines; ``None`` when it holds no rows.\"\"\"","         unit = fragment_to_read.unit","         with fragment_to_read.fragment.open() as file:","@@ -267,10 +268,18 @@ def _read_chunk_fragment(","                 index=unit.index, chunk_size=self._chunk_size, file_size=file_size","             )","             lines = read_line_aligned(file, start=start, end=end, file_size=file_size)","-        if not lines:","+        return lines or None","+","+    def _read_chunk_fragment(","+        self, fragment_to_read: ReadUnitFragment","+    ) -> Optional[pds.Fragment]:","+        \"\"\"Fetch a chunk unit's whole lines as a fragment; ``None`` when it holds no rows.\"\"\"","+        lines = self._read_chunk_lines(fragment_to_read)","+        if lines is None:","             return None","+        unit = fragment_to_read.unit","         return self._make_chunk_fragment(","-            lines, starts_at_file_start=start == 0, path=unit.source","+            lines, starts_at_file_start=unit.index == 0, path=unit.source","         )"," ","     @override","@@ -292,6 +301,20 @@ def _iter_fragment_tables(","             scanner_kwargs = {**scanner_kwargs, \"columns\": columns}","         yield from super()._iter_fragment_tables(fragment, scanner_kwargs)"," ","+    @override","+    def _on_disk_column_names(self, dataset: pds.Dataset) -> Set[str]:","+        \"\"\"Count a requested column the plan schema lacks as read from the file.","+","+        The plan schema is a sample of the files, so a column absent from it may","+        still be in a file. It is read and null-filled where a file lacks it, by","+        ``_get_scan_schema``, instead of being treated as synthesized and dropped.","+        \"\"\"","+        schema = self._schema","+        planned = set(schema.names) if schema is not None else set()","+        synthesized = {column.name for column in self._synthesized_columns}","+        unsampled = set(self._columns or ()) - planned - synthesized","+        return super()._on_disk_column_names(dataset) | unsampled","+","     @override","     def _get_scan_schema(","         self, fragment: pds.Fragment, scanner_kwargs: dict"],"additions":31,"deletions":8,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/formats/json/__init__.py","lines":["@@ -0,0 +1 @@","+\"\"\"JSON-specific DataSourceV2 datasource, scanner and reader.\"\"\""],"additions":1,"deletions":0,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/formats/json/json_datasource_v2.py","lines":["@@ -0,0 +1,267 @@","+\"\"\"Concrete ``DataSourceV2`` for JSON and JSON Lines files.\"\"\"","+","+from __future__ import annotations","+","+import logging","+from dataclasses import dataclass","+from typing import TYPE_CHECKING, Any, Dict, List, Optional, Tuple","+","+import pyarrow as pa","+import pyarrow.json as pajson","+from typing_extensions import override","+","+from ray.data._internal.datasource_v2.common.arrow_file_scanner import (","+    ArrowFileScanner,","+)","+from ray.data._internal.datasource_v2.common.file_reader import (","+    _ARROW_DEFAULT_BATCH_SIZE,","+)","+from ray.data._internal.datasource_v2.common.line_chunk_file_indexer import (","+    LineChunkFileIndexer,","+)","+from ray.data._internal.datasource_v2.common.line_chunkable_datasource_v2 import (","+    LineChunkableDatasourceV2,","+)","+from ray.data._internal.datasource_v2.common.line_chunkable_file_reader import (","+    LineChunkableFileReader,","+)","+from ray.data._internal.datasource_v2.fo