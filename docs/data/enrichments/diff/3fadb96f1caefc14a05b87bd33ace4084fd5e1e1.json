  budget = MultiModalBudget(","+        VllmConfig(","+            model_config=ctx.model_config,","+            scheduler_config=SchedulerConfig(","+                max_model_len=8192,","+                max_num_batched_tokens=8192,","+                max_num_seqs=8,","+                is_encoder_decoder=False,","+            ),","+        ),","+        MULTIMODAL_REGISTRY,","+        enable_cache=False,","+    )","+    processor = budget.processor","+    info = processor.info","+    assert isinstance(info, MiniCPMV4_6ProcessingInfo)","+    images = []","+    for color in range(num_images):","+        processed = processor(","+            info.image_pattern,","+            mm_items=info.parse_mm_data(","+                {\"image\": [Image.new(\"RGB\", (20000, 100), (color, 0, 0))]}","+            ),","+            hf_processor_mm_kwargs={},","+        )","+        images.append((\"image\", processed[\"mm_kwargs\"][\"image\"][0]))","+        num_embeds = processed[\"mm_placeholders\"][\"image\"][0].get_num_embeds()","+","+    assert num_images * num_embeds <= budget.get_encoder_budget()","+    assert _profiled_patches(budget) >= _batch_patches(images)","+","+","+def test_minicpmv4_6_profile_runs_full_budget_video_when_image_is_primary():","+    ctx = build_model_context(","+        \"openbmb/MiniCPM-V-4_6\",","+        model_config_kwargs={\"max_model_len\": 32768},","+        mm_processor_kwargs={","+            \"images_kwargs\": {\"downsample_mode\": \"4x\", \"max_slice_nums\": 16},","+            \"videos_kwargs\": {\"downsample_mode\": \"16x\", \"max_slice_nums\": 2},","+        },","+        limit_mm_per_prompt={\"image\": 1, \"video\": 1},","+    )","+    budget = MultiModalBudget(","+        VllmConfig(","+            model_config=ctx.model_config,","+            scheduler_config=SchedulerConfig(","+                max_model_len=32768,","+                max_num_batched_tokens=7810,","+                max_num_seqs=8,","+                is_encoder_decoder=Fal