 get_mm_max_toks_per_item(processor, {\"image\": 1}, None)[\"image\"]","+    assert budget == max(lengths)"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_glm5next.py","lines":["@@ -7,7 +7,9 @@"," import torch"," from PIL import Image"," ","+from vllm.config import CacheConfig, SchedulerConfig, VllmConfig"," from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.encoder_budget import MultiModalBudget"," from vllm.multimodal.processing import ProcessorInputs, TimingContext"," "," from ...utils import build_model_context","@@ -87,6 +89,36 @@ def test_rust_engine_profiles_synthetic_patches(monkeypatch, modality, count):","         )"," "," ","+@pytest.mark.parametrize(\"modality\", [\"image\", \"video\"])","+def test_rust_engine_encoder_profile_builds_dummies(monkeypatch, modality):","+    monkeypatch.setenv(\"VLLM_USE_RUST_FRONTEND\", \"1\")","+    ctx = build_model_context(","+        \"zai-org/GLM-5.3-Flash\",","+        model_config_kwargs={\"max_model_len\": 4096},","+        limit_mm_per_prompt={modality: 1},","+    )","+    scheduler_config = SchedulerConfig(","+        max_model_len=4096,","+        max_num_batched_tokens=2048,","+        enable_chunked_prefill=True,","+        is_encoder_decoder=False,","+    )","+    budget = MultiModalBudget(","+        VllmConfig(","+            model_config=ctx.model_config,","+            scheduler_config=scheduler_config,","+            cache_config=CacheConfig(enable_prefix_caching=False),","+        ),","+        MULTIMODAL_REGISTRY,","+        enable_cache=False,","+    )","+","+    items = budget.get_dummy_encoder_profile_inputs(modality)","+","+    assert len(items) == budget.mm_max_items_per_batch[modality]","+    assert all(item_modality == modality for item_modality, _ in items)","+","+"," def _image_info(**kwargs):","     ctx = build_model_context(","         \"zai-org/GLM-5.3-Flash\","],"additions":32,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_minicpm_ocr.py","lines":["@@ -12,15 +12,19 @@"," from types import SimpleNamespace"," "," import numpy as np","+import PIL.Image"," import pytest"," import torch"," ","+from vllm.config import ModelConfig"," from vllm.model_executor.models.minicpm_ocr import (","     _OCR_IMAGE_UPSIZE_KWARGS,","+    _VIDEO_PINNED_UPSIZE_KWARGS,","     MiniCPMOcrMultiModalProcessor,","     MiniCPMOcrProcessingInfo,"," )"," from vllm.model_executor.models.minicpmv4_6 import MiniCPMV4_6MultiModalProcessor","+from vllm.multimodal import MULTIMODAL_REGISTRY"," from vllm.multimodal.parse import ImageSize"," "," pytestmark = pytest.mark.skip_global_cleanup","@@ -283,9 +287,6 @@ def test_placeholder_is_counted_from_target_sizes():","     \"\"\"Token count mirrors `MiniCPMOcrProcessor.replace_image_token`."," ","     That method computes `target_sizes.prod(-1) // token_divisor` per patch.","-    Reproducing it here is what keeps the count right under","-    `adaptive_small_image_upsize`, whose resize target is decided from the","-    pixels and so is invisible to a size-only computation.","     \"\"\"","     info = _make_info()","     # An unsliced image: one row only.","@@ -296,13 +297,7 @@ def test_placeholder_is_counted_from_target_sizes():"," "," "," def test_adaptive_upsize_changes_the_count_without_changing_the_image_size():","-    \"\"\"Two tiers of the same image must yield different placeholders.","-","-    `adaptive_upsize_tier` can send a small image to `scale_resolution` or to","-    `adaptive_upsize_tiny_target_resolution`, and `ImageSize` is identical in","-    both cases. This is exactly the divergence that counting from `image_size`","-    would miss.","-    \"\"\"","+    \"\"\"Two tiers of the same image must yield different placeholders.\"\"\"","     info = _make_info()","     image_size = ImageSize(width=80, height=80)"," ","@@ -342,10 +337,7 @@ def test_placeholder_emits_the_slice_grid_from_the_geometry():"," "," "," def test_placeholder_emits_differing_tiles_one_by_one():","-    \"\"\"`adaptive_tile_upsize` can leave tiles at different resolutions.","-","-    Each slice then gets its own count instead of row 1 repeated.","-    \"\"\"","+    \"\"\"Each slice then gets its own count instead of row 1 repeated.\"\"\"","     info = _make_info()","     image_size = ImageSize(width=1680, height=1120)","     grids, _, _ = info._compute_visual_tokens(image_size, downsample_mode=\"4x\")","@@ -378,13 +370,11 @@ def fake_process_videos(self, mm_data, mm_kwargs):","     processor = _processor_with_merge({})","     processor.process_videos(","         {},","-        {\"downsample_mode\": \"4x\", \"adaptive_small_image_upsize\": True},","+        {\"downsample_mode\": \"4x\", \"small_image_upsize\": \"never\"},","     )"," ","     assert captured[\"downsample_mode\"] == \"4x\"","-    assert captured[\"adaptive_small_image_upsize\"] is False","-    assert captured[\"disable_small_image_upsize\"] is False","-    assert captured[\"adaptive_tile_upsize\"] is False","+    assert captured[\"small_image_upsize\"] == \"always\""," "," "," def test_placeholder_falls_back_when_target_sizes_disagree_with_the_grid():","@@ -578,11 +568,11 @@ def test_scoped_upsize_kwargs_are_promoted_to_the_flat_form():","     silently ignored.","     \"\"\"","     processor = _processor_with_merge(","-        {\"images_kwargs\": {\"adaptive_small_image_upsize\": True}}","+        {\"images_kwargs\": {\"small_image_upsize\": \"never\"}}","     )","     promoted = processor._promote_image_upsize_kwargs({\"max_slice_nums\": 4})"," ","-    assert promoted[\"adaptive_small_image_upsize\"] is True","+    assert promoted[\"small_image_upsize\"] == \"never\"","     assert promoted[\"max_slice_nums\"] == 4"," "," ","@@ -596,8 +586,7 @@ def test_upsize_kwargs_are_kept_out_of_the_video_path():","     processor = _processor_with_merge({})","     mm_kwargs = {","         \"downsample_mode\": \"4x\",","-        \"adaptive_small_image_upsize\": True,","-        \"disable_small_image_upsize\": True,","+        \"small_image_upsize\": \"never\",","     }","     stripped = processor._drop_image_upsize_kwargs(mm_kwargs)"," ","@@ -614,21 +603,209 @@ def test_declared_upsize_kwargs_match_the_transformers_schema():","     vLLM routes a flat kwarg into a scope only when the HF processor declares","     it, so this list is what decides whether a request option is honoured.","     \"\"\"","-    assert set(_OCR_IMAGE_UPSIZE_KWARGS) == {","-        \"disable_small_image_upsize\",","-        \"adaptive_small_image_upsize\",","-        \"adaptive_upsize_font_px\",","-        \"adaptive_upsize_dense_per_kpx\",","-        \"adaptive_upsize_tiny_pixels\",","-        \"adaptive_upsize_tiny_target_resolution\",","-        \"adaptive_tile_upsize\",","-    }","+    assert set(_OCR_IMAGE_UPSIZE_KWARGS) == {\"small_image_upsize\"}","+    image_processing = pytest.importorskip(","+        \"transformers.models.minicpm_ocr.image_processing_minicpm_ocr\"","+    )","+    declared = image_processing.MiniCPMOcrImageProcessorKwargs.__annotations__","+    assert set(_OCR_IMAGE_UPSIZE_KWARGS) <= set(declared)","+    assert set(_VIDEO_PINNED_UPSIZE_KWARGS) <= set(declared)","     # `downsample_mode` / `max_slice_nums` are inherited from 4.6 and already","     # handled there; re-promoting them here would double-apply the resolution.","     assert \"downsample_mode\" not in _OCR_IMAGE_UPSIZE_KWARGS","     assert \"max_slice_nums\" not in _OCR_IMAGE_UPSIZE_KWARGS"," "," ","+def _ocr_processor(mm_processor_kwargs=None, limit_mm_per_prompt=None):","+    pytest.importorskip(\"transformers.models.minicpm_ocr\")","+    model_config = ModelConfig(","+        \"openbmb/MiniCPM-OCR-1.0\",","+        mm_processor_kwargs=mm_processor_kwargs,","+        limit_mm_per_prompt=limit_mm_per_prompt or {\"image\": 1, \"video\": 1},","+    )","+    return model_config, MULTIMODAL_REGISTRY.create_processor(model_config)","+","+","+def _video_item(num_frames: int, width: int, height: int) -> tuple:","+    return (","+        np.zeros((num_frames, height, width, 3), dtype=np.uint8),","+        {","+            \"fps\": 2.0,","+            \"duration\": num_frames / 2.0,","+            \"total_num_frames\": num_frames,","+            \"frames_indices\": list(range(num_frames)),","+            \"video_backend\": \"opencv\",","+            \"do_sample_frames\": False,","+        },","+    )","+","+","+def _num_embeds(processor, modality: str, item, hf_processor_mm_kwargs=None) -> int:","+    pattern = (","+        processor.info.image_pattern","+        if modality == \"image\"","+        else processor.info.video_pattern","+    )","+    processed = processor(","+        pattern,","+        mm_items=processor.info.parse_mm_data({modality: [item]}),","+        hf_processor_mm_kwargs=hf_processor_mm_kwargs or {},","+    )","+    return sum(p.get_num_embeds() for p in processed[\"mm_placeholders\"][modality])","+","+","+@pytest.mark.parametrize(\"mm_processor_kwargs\", [None, {\"small_image_upsize\": \"never\"}])","+@pytest.mark.parametrize((\"width\", \"height\"), [(200, 120), (1265, 1112)])","+def test_video_tokens_match_the_transformers_processor(","+    mm_processor_kwargs, width: int, height: int","+):","+    model_config, processor = _ocr_processor(","+        mm_processor_kwargs, {\"image\": 0, \"video\": 1}","+    )","+    video = _video_item(2, width, height)","+    hf_processor = processor.info.get_hf_processor()","+    reference = hf_processor(","+        text=[hf_processor.video_token],","+        videos=[video[0]],","+        videos_kwargs={\"do_sample_frames\": False},","+        return_tensors=\"pt\",","+    )","+    video_token_id = hf_processor.tokenizer.convert_tokens_to_ids(","+        hf_processor.video_token","+    )","+    budget = processor.info.get_mm_max_tokens_per_item(","+        seq_len=model_config.max_model_len, mm_counts={\"video\": 1}","+    )","+    dummy = processor.get_dummy_mm_inputs({\"video\": 1})","+    dummy_embeds = sum(p.get_num_embeds() for p in dummy[\"mm_placeholders\"][\"video\"])","+","+    assert _num_embeds(processor, \"video\", video) == int(","+        (reference[\"input_ids\"] == video_token_id).sum()","+    )","+    assert budget is not None","+    assert dummy_embeds <= budget[\"video\"]","+","+","+@pytest.mark.parametrize(\"kwargs_on_init\", [True, False])","+def test_scoped_small_image_upsize_matches_the_transformers_processor(","+    kwargs_on_init: bool,","+):","+    kwargs = {\"images_kwargs\": {\"small_image_upsize\": \"never\"}}","+    _, processor = _ocr_processor(","+        kwargs if kwargs_on_init else None, {\"image\": 1, \"video\": 0}","+    )","+    image = PIL.Image.fromarray(np.full((120, 200, 3), 255, dtype=np.uint8))","+    hf_processor = processor.info.get_hf_processor()","+    reference = hf_processor(","+        text=[hf_processor.image_token],","+        images=[image],","+        images_kwargs={\"small_image_upsize\": \"never\"},","+        return_tensors=\"pt\",","+    )","+    image_token_id = hf_processor.tokenizer.convert_tokens_to_ids(","+        hf_processor.image_token","+    )","+","+    assert _num_embeds(","+        processor, \"image\", image, {} if kwargs_on_init else kwargs","+    ) == int((reference[\"input_ids\"] == image_token_id).sum())","+","+","+@pytest.mark.parametrize(","+    \"mm_processor_kwargs\",","+    [","+        None,","+        {\"small_image_upsize\": \"adaptive\"},","+        {\"images_kwargs\": {\"small_image_upsize\": \"adaptive\"}},","+    ],","+)","+def test_image_budget_covers_the_largest_image(mm_processor_kwargs):","+    model_config, processor = _ocr_processor(","+        mm_processor_kwargs, limit_mm_per_prompt={\"image\": 1, \"video\": 0}","+    )","+    budget = processor.info.get_mm_max_tokens_per_item(","+        seq_len=model_config.max_model_len, mm_counts={\"image\": 1}","+    )","+    dummy = processor.get_dummy_mm_inputs({\"image\": 1})","+    dummy_embeds = sum(p.get_num_embeds() for p in dummy[\"mm_placeholders\"][\"image\"])","+    dense_text = np.full((188, 7474, 3), 255, dtype=np.uint8)","+    for y in range(0, 184, 9):","+        for x in range(0, 7471, 8):","+            dense_text[y : y + 4, x : x + 3] = 0","+","+    assert budget is not None","+    assert dummy_embeds <= budget[\"image\"]","+    assert budget[\"image\"] >= _num_embeds(","+        processor, \"image\", PIL.Image.fromarray(dense_text)","+    )","+    dummy_pixels = dummy[\"mm_kwargs\"].get_data()[\"pixel_values\"]","+    for image in (PIL.Image.fromarray(dense_text), PIL.Image.new(\"RGB\", (126, 14334))):","+        processed = processor(","+            processor.info.image_pattern,","+            mm_items=processor.info.parse_mm_data({\"image\": [image]}),","+            hf_processor_mm_kwargs={},","+        )","+        pixels = processed[\"mm_kwargs\"].get_data()[\"pixel_values\"]","+        assert dummy_pixels.shape[-4] * dummy_pixels.shape[-1] >= (","+            pixels.shape[-4] * pixels.shape[-1]","+        )","+","+","+@pytest.mark.parametrize(\"scale_resolution\", [56, 64])","+def test_image_budget_covers_adaptive_tiny_images(scale_resolution):","+    model_config, processor = _ocr_processor(","+        {","+            \"scale_resolution\": scale_resolution,","+            \"max_slice_nums\": 1,","+            \"images_kwargs\": {\"small_image_upsize\": \"adaptive\"},","+        },","+        limit_mm_per_prompt={\"image\": 1, \"video\": 0},","+    )","+    budget = processor.info.get_mm_max_tokens_per_item(","+        seq_len=model_config.max_model_len, mm_counts={\"image\": 1}","+    )","+    dummy = processor.get_dummy_mm_inputs({\"image\": 1})","+    dummy_pixels = dummy[\"mm_kwargs\"].get_data()[\"pixel_values\"]","+","+    assert budget is not None","+    for size in ((196, 1), (1, 196)):","+        processed = processor(","+            processor.info.image_pattern,","+            mm_items=processor.info.parse_mm_data(","+                {\"image\": [PIL.Image.new(\"RGB\", size)]}","+            ),","+            hf_processor_mm_kwargs={},","+        )","+        pixels = processed[\"mm_kwargs\"].get_data()[\"pixel_values\"]","+        num_embeds = processed[\"mm_placeholders\"][\"image\"][0].get_num_embeds()","+        assert budget[\"image\"] >= num_embeds","+        assert dummy_pixels.shape[-4] * dummy_pixels.shape[-1] >= (","+            pixels.shape[-4] * pixels.shape[-1]","+        )","+","+","+@pytest.mark.parametrize(","+    \"hint\", [{\"width\": 32, \"height\": 32}, {\"width\": 64, \"height\": 64}]","+)","+def test_size_hints_do_not_lower_the_adaptive_tiny_image_budget(hint):","+    model_config, processor = _ocr_processor(","+        {","+            \"scale_resolution\": 56,","+            \"max_slice_nums\": 1,","+            \"images_kwargs\": {\"small_image_upsize\": \"adaptive\"},","+        },","+        limit_mm_per_prompt={\"image\": {\"count\": 1, **hint}, \"video\": 0},","+    )","+    budget = processor.info.get_mm_max_tokens_per_item(","+        seq_len=model_config.max_model_len, mm_counts={\"image\": 1}","+    )","+","+    assert budget is not None","+    assert budget[\"image\"] >= _num_embeds(","+        processor, \"image\", PIL.Image.new(\"RGB\", (196, 1))","+    )","+","+"," # --------------------------------------------------------------------------"," # Model wiring"," # --------------------------------------------------------------------------"],"additions":208,"deletions":31,"truncated":false},{"path":"tests/models/multimodal/processing/test_minicpmv.py","lines":["@@ -6,10 +6,16 @@"," import numpy as np"," import pytest"," import torch","+from PIL import Image"," ","+from vllm.config import SchedulerConfig, VllmConfig"," from vllm.model_executor.models.minicpmv import MiniCPMVProcessingInfo","+from vllm.model_executor.models.minicpmv4_6 import MiniCPMV4_6ProcessingInfo"," from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.encoder_budget import MultiModalBudget"," from vllm.multimodal.parse import ImageSize","+from vllm.v1.worker.gpu.mm.encoder_cache import EncoderCache","+from vllm.v1.worker.gpu.mm.encoder_runner import EncoderRunner"," "," from ...utils import build_model_context"," ","@@ -131,3 +137,608 @@ def test_request_slice_limit_matches_image_features(model_id, max_slice_nums):","         results.append(result)"," ","     assert results[0][\"prompt_token_ids\"] == results[1][\"prompt_token_ids\"]","+","+","+def _video_item(num_frames: int, width: int, height: int) -> tuple:","+    return (","+        np.zeros((num_frames, height, width, 3), dtype=np.uint8),","+        {","+            \"fps\": 2.0,","+            \"duration\": num_frames / 2.0,","+            \"total_num_frames\": num_frames,","+            \"frames_indices\": list(range(num_frames)),","+            \"video_backend\": \"opencv\",","+            \"do_sample_frames\": False,","+        },","+    )","+","+","+def _process_video(processor, video: tuple):","+    return processor(","+        processor.info.video_pattern,","+        mm_items=processor.info.parse_mm_data({\"video\": [video]}),","+        hf_processor_mm_kwargs={},","+    )","+","+","+def _num_video_embeds(processor, video: tuple) -> int:","+    processed = _process_video(processor, video)","+    return sum(p.get_num_embeds() for p in processed[\"mm_placeholders\"][\"video\"])","+","+","+def _padded_patches(inputs, modality: str) -> int:","+    key = \"pixel_values\" if modality == \"image\" else \"video_pixel_values\"","+    pixel_values = inputs[\"mm_kwargs\"].get_data()[key]","+    return pixel_values.shape[-4] * pixel_values.shape[-1] // pixel_values.shape[-2]","+","+","+def _batch_patches(items) -> int:","+    shapes = []","+    for modality, item in items:","+        key = \"pixel_values\" if modality == \"image\" else \"video_pixel_values\"","+        pixel_values = item.get_data()[key]","+        assert isinstance(pixel_values, torch.Tensor)","+        shapes.append(pixel_values.shape)","+    if not shapes:","+        return 0","+    num_slices = sum(shape[0] for shape in shapes)","+    return num_slices * max(shape[-1] for shape in shapes) // shapes[0][-2]","+","+","+def _profiled_patches(budget: MultiModalBudget) -> int:","+    split_input = budget.get_dummy_encoder_profile_inputs()","+    profiles = [","+        split_input,","+        budget.get_dummy_encoder_profile_single_input(split_input),","+        *budget.get_dummy_encoder_profile_modality_inputs(split_input),","+    ]","+    return max(_batch_patches(profile) for profile in profiles)","+","+","+@pytest.mark.parametrize(","+    (\"mm_processor_kwargs\", \"image_size\", \"num_tokens\"),","+    [","+        (None, (84, 16726), 797),","+        ({\"max_slice_nums\": 4}, (6803, 60), 429),","+        ({\"images_kwargs\": {\"max_slice_nums\": 1}}, (40, 8000), 113),","+    ],","+)","+def test_minicpmv4_6_image_budget_covers_largest_image(","+    mm_processor_kwargs: dict[str, object] | None,","+    image_size: tuple[int, int],","+    num_tokens: int,","+):","+    ctx = build_model_context(","+        \"openbmb/MiniCPM-V-4_6\",","+        mm_processor_kwargs=mm_processor_kwargs,","+        limit_mm_per_prompt={\"image\": 1, \"video\": 0},","+    )","+    processor = MULTIMODAL_REGISTRY.create_processor(ctx.model_config)","+    info = processor.info","+    assert isinstance(info, MiniCPMV4_6ProcessingInfo)","+    max_tokens = info.get_mm_max_tokens_per_item(","+        seq_len=ctx.model_config.max_model_len, mm_counts={\"image\": 1}","+    )","+    assert max_tokens is not None","+    budget = max_tokens[\"image\"]","+    dummy = processor.get_dummy_mm_inputs({\"image\": 1})","+    processed = processor(","+        info.image_pattern,","+        mm_items=info.parse_mm_data({\"image\": [Image.new(\"RGB\", image_size)]}),","+        hf_processor_mm_kwargs={},","+    )","+","+    assert budget == num_tokens","+    assert dummy[\"mm_placeholders\"][\"image\"][0].get_num_embeds() <= budget","+    assert processed[\"mm_placeholders\"][\"image\"][0].get_num_embeds() == budget","+    assert _padded_patches(dummy, \"image\") >= _padded_patches(processed, \"image\")","+","+","+@pytest.mark.parametrize(\"hint\", [{\"width\": 8192}, {\"height\": 20000}])","+def test_minicpmv4_6_image_dummy_ignores_hints_that_keep_the_largest_input(","+    hint: dict[str, int],","+):","+    ctx = build_model_context(","+        \"openbmb/MiniCPM-V-4_6\",","+        limit_mm_per_prompt={\"image\": {\"count\": 1, **hint}, \"video\": 0},","+    )","+    processor = MULTIMODAL_REGISTRY.create_processor(ctx.model_config)","+    info = processor.info","+    assert isinstance(info, MiniCPMV4_6ProcessingInfo)","+    dummy = processor.get_dummy_mm_inputs({\"image\": 1})","+    processed = processor(","+        info.image_pattern,","+        mm_items=info.parse_mm_data({\"image\": [Image.new(\"RGB\", (84, 16726))]}),","+        hf_processor_mm_kwargs={},","+    )","+","+    assert _padded_patches(dummy, \"image\") >= _padded_patches(processed, \"image\")","+","+","+@pytest.mark.parametrize(","+    (\"max_num_batched_tokens\", \"encoder_budget\", \"video_hint\"),","+    [","+        (2048, 11520, {}),","+        (16384, 16384, {}),","+        (16384, 16384, {\"width\": 8192}),","+        (16384, 16384, {\"height\": 11000}),","+        (24576, 24576, {}),","+        (32768, 32768, {}),","+    ],","+)","+def test_minicpmv4_6_video_profile_covers_largest_scheduled_video(","+    max_num_batched_tokens: int, encoder_budget: int, video_hint: dict[str, int]","+):","+    max_model_len = 32768","+    ctx = build_model_context(","+        \"openbmb/MiniCPM-V-4_6\",","+        model_config_kwargs={\"max_model_len\": max_model_len},","+        limit_mm_per_prompt={\"image\": 0, \"video\": {\"count\": 1, **video_hint}},","+    )","+    scheduler_config = SchedulerConfig(","+        max_model_len=max_model_len,","+        max_num_batched_tokens=max_num_batched_tokens,","+        is_encoder_de