trawURL += \"?\" + params.Encode()","+\t}","+","+\thttpReq, err := http.NewRequestWithContext(ctx, http.MethodGet, rawURL, nil) // #nosec G704 -- region is validated against constants.Regions() above","+\tif err != nil {","+\t\treturn nil, 0, fmt.Errorf(\"failed to build request: %w\", err)","+\t}","+","+\tclient, err := ds.promqlHTTPClient(region, timeout)","+\tif err != nil {","+\t\treturn nil, 0, fmt.Errorf(\"failed to build PromQL HTTP client: %w\", err)","+\t}","+","+\thttpResp, err := client.Do(httpReq) // #nosec G704 -- region is validated against constants.Regions() above","+\tif err != nil {","+\t\treturn nil, 0, backend.DownstreamError(fmt.Errorf(\"request failed: %w\", err))","+\t}","+\tdefer func() { _ = httpResp.Body.Close() }()","+","+\tbody, err := io.ReadAll(httpResp.Body)","+\tif err != nil {","+\t\treturn nil, 0, backend.DownstreamError(fmt.Errorf(\"failed to read response body: %w\", err))","+\t}","+","+\tif len(body) >= 2 && body[0] == 0x1f && body[1] == 0x8b {","+\t\tgz, gzErr := gzip.NewReader(bytes.NewReader(body))","+\t\tif gzErr != nil {","+\t\t\treturn nil, 0, backend.DownstreamError(fmt.Errorf(\"failed to decompress response body: %w\", gzErr))","+\t\t}","+","+\t\tdefer func() { _ = gz.Close() }()","+","+\t\tif body, gzErr = io.ReadAll(gz); gzErr != nil {","+\t\t\treturn nil, 0, backend.DownstreamError(fmt.Errorf(\"failed to decompress response body: %w\", gzErr))","+\t\t}","+\t}","+","+\treturn body, httpResp.StatusCode, nil","+}","+","+func (ds *DataSource) promqlHTTPClient(region string, timeout time.Duration) (*http.Client, error) {","+\tkey := region + \"|\" + timeout.String()","+\tif c, ok := ds.promqlClients.Load(key); ok {","+\t\treturn c.(*http.Client), nil","+\t}","+","+\ttimeouts := httpclient.DefaultTimeoutOptions","+\ttimeouts.Timeout = timeout","+","+\topts := httpclient.Options{","+\t\tTimeouts: &timeouts,","+\t\tSigV4: &httpclient.SigV4Config{","+\t\t\tAuthType:      ds.Settings.AuthType.String(),","+\t\t\tProfile:       ds.Settings.Profile,","+\t\t\tService:       \"monitoring\",","+\t\t\tAccessKey:     ds.Settings.AccessKey,","+\t\t\tSecretKey:     ds.Settings.SecretKey,","+\t\t\tSessionToken:  ds.Settings.SessionToken,","+\t\t\tAssumeRoleARN: ds.Settings.AssumeRoleARN,","+\t\t\tExternalID:    ds.Settings.ExternalID,","+\t\t\tRegion:        region,","+\t\t},","+\t\tMiddlewares: append(httpclient.DefaultMiddlewares(), awsauth.NewSigV4Middleware()),","+\t}","+","+\tif ds.Settings.GrafanaSettings.SecureSocksDSProxyEnabled && ds.Settings.SecureSocksProxyEnabled {","+\t\topts.ProxyOptions = ds.ProxyOpts","+\t}","+","+\tclient, err := NewPromQLHTTPClient(opts)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\tactual, _ := ds.promqlClients.LoadOrStore(key, client)","+\treturn actual.(*http.Client), nil","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"pkg/tsdb/cloudwatch/promql_http_test.go","lines":["@@ -0,0 +1,208 @@","+package cloudwatch","+","+import (","+\t\"bytes\"","+\t\"compress/gzip\"","+\t\"context\"","+\t\"errors\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/url\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/grafana/grafana-aws-sdk/pkg/awsds\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/backend/httpclient\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/tsdb/cloudwatch/models\"","+)","+","+type roundTripFunc func(*http.Request) (*http.Response, error)","+","+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }","+","+func newHTTPResponse(status int, body string) *http.Response {","+\treturn &http.Response{","+\t\tStatusCode: status,","+\t\tBody:       io.NopCloser(strings.NewReader(body)),","+\t\tHeader:     make(http.Header),","+\t}","+}","+","+func TestPromqlSignedGet(t *testing.T) {","+\torig := NewPromQLHTTPClient","+\tt.Cleanup(func() { NewPromQLHTTPClient = orig })","+","+\tdsWith := func(region, endpoin