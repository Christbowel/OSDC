 got.URL.String(),","+\t\t\t\t\"region %q should fall back to the configured region\", region)","+\t\t}","+\t})","+","+\tt.Run(\"a custom endpoint takes precedence over the resolver\", func(t *testing.T) {","+\t\tvar got *http.Request","+\t\tNewPromQLHTTPClient = func(_ httpclient.Options) (*http.Client, error) {","+\t\t\treturn &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {","+\t\t\t\tgot = r","+\t\t\t\treturn newHTTPResponse(http.StatusOK, `{}`), nil","+\t\t\t})}, nil","+\t\t}","+","+\t\tds := dsWith(\"us-east-1\", \"https://custom.example.com/\")","+\t\t_, _, err := ds.promqlSignedGet(context.Background(), \"us-east-1\", \"/api/v1/labels\", nil, time.Second)","+","+\t\trequire.NoError(t, err)","+\t\trequire.NotNil(t, got)","+\t\tassert.Equal(t, \"https://custom.example.com/api/v1/labels\", got.URL.String(),","+\t\t\t\"trailing slash on the custom endpoint should not produce a double slash\")","+\t})","+","+\tt.Run(\"returns the status code and body for non-200 responses\", func(t *testing.T) {","+\t\tNewPromQLHTTPClient = func(_ httpclient.Options) (*http.Client, error) {","+\t\t\treturn &http.Client{Transport: roundTripFunc(func(_ *http.Request) (*http.Response, error) {","+\t\t\t\treturn newHTTPResponse(http.StatusBadRequest, `{\"status\":\"error\"}`), nil","+\t\t\t})}, nil","+\t\t}","+","+\t\tds := dsWith(\"us-east-1\", \"\")","+\t\tbody, status, err := ds.promqlSignedGet(context.Background(), \"us-east-1\", \"/api/v1/query\", nil, time.Second)","+","+\t\trequire.NoError(t, err, \"transport-level success should not be an error even for non-200\")","+\t\tassert.Equal(t, http.StatusBadRequest, status)","+\t\tassert.JSONEq(t, `{\"status\":\"error\"}`, string(body))","+\t})","+","+\tt.Run(\"reuses a cached client for repeated requests with the same region and timeout\", func(t *testing.T) {","+\t\tvar built int","+\t\tNewPromQLHTTPClient = func(_ httpclient.Options) (*http.Client, error) {","+\t\t\tbuilt++","+\t\t\treturn &ht