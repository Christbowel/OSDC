:= fmt.Sprintf(\"%ds\", int64(rateInterval.Seconds()))","+\trateMs := strconv.FormatInt(rateInterval.Milliseconds(), 10)","+\texpr = strings.NewReplacer(","+\t\t\"${__rate_interval_ms}\", rateMs,","+\t\t\"$__rate_interval_ms\", rateMs,","+\t\t\"${__rate_interval}\", rateSeconds,","+\t\t\"$__rate_interval\", rateSeconds,","+\t).Replace(expr)","+","+\ttimeRange := q.TimeRange.To.Sub(q.TimeRange.From)","+\treturn prommodels.InterpolateVariables(expr, q.Interval, calculatedStep, minStep, \"\", timeRange)","+}","+","+type prometheusRangeSeries struct {","+\tMetric     map[string]string `json:\"metric\"`","+\tValues     [][]interface{}   `json:\"values\"`","+\tHistograms [][]interface{}   `json:\"histograms\"`","+}","+","+type prometheusInstantSeries struct {","+\tMetric    map[string]string `json:\"metric\"`","+\tValue     []interface{}     `json:\"value,omitempty\"`","+\tHistogram []interface{}     `json:\"histogram,omitempty\"`","+}","+","+type prometheusRangeResponse struct {","+\tStatus string `json:\"status\"`","+\tData   struct {","+\t\tResult []prometheusRangeSeries `json:\"result\"`","+\t} `json:\"data\"`","+\tError     string   `json:\"error,omitempty\"`","+\tErrorType string   `json:\"errorType,omitempty\"`","+\tWarnings  []string `json:\"warnings,omitempty\"`","+}","+","+type prometheusInstantResponse struct {","+\tStatus string `json:\"status\"`","+\tData   struct {","+\t\tResultType string          `json:\"resultType\"`","+\t\tResult     json.RawMessage `json:\"result\"`","+\t} `json:\"data\"`","+\tError     string   `json:\"error,omitempty\"`","+\tErrorType string   `json:\"errorType,omitempty\"`","+\tWarnings  []string `json:\"warnings,omitempty\"`","+}","+","+func (promResp prometheusInstantResponse) instantSeries() ([]prometheusInstantSeries, error) {","+\tswitch promResp.Data.ResultType {","+\tcase \"scalar\":","+\t\tvar point []interface{}","+\t\tif err := json.Unmarshal(promResp.Data.Result, &point); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\