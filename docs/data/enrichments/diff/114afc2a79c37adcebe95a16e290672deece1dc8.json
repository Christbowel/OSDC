s.rs","lines":["@@ -4,10 +4,16 @@ use crate::cli_args::catalogs::{configured_catalogs, workspace_catalogs};"," use miette::{Context, IntoDiagnostic};"," use pnpm_catalogs_types::Catalogs;"," use pnpm_config::{Config, LinkWorkspacePackages};","-use pnpm_package_manager::{VersionsOverrider, overrides_dependency_rewriter};","+use pnpm_package_manager::{","+    VersionsOverrider, overrides_catalog_reference_rewriter, overrides_dependency_rewriter,","+};"," use pnpm_workspace::{GraphPkg, Project};","+use pnpm_workspace_projects_filter::{","+    FilterWorkspaceProjectsOptions, ProjectDependencies, ProjectSelector,","+};"," use pnpm_workspace_projects_graph::{","-    CreateProjectsGraphOptions, DependencyRewriter, ProjectGraph, create_projects_graph,","+    CreateProjectsGraphOptions, DependencyGroups, DependencyRewriter, GraphProject, ProjectGraph,","+    create_projects_graph,"," };"," use std::path::Path;"," ","@@ -74,3 +80,74 @@ fn build_graph<'p>(","     )","     .graph"," }","+","+/// [`super::recursive_filter_options`] for evaluating `selectors` against","+/// `graph`. A `[<since>]` selector among them reads the dependencies from","+/// [`overridden_project_dependencies`].","+pub(super) fn selector_filter_options(","+    graph: &ProjectGraph<GraphPkg<'_>>,","+    selectors: &[ProjectSelector],","+    config: &Config,","+    prefix: &Path,","+) -> miette::Result<FilterWorkspaceProjectsOptions> {","+    let mut options = super::recursive_filter_options(config, prefix);","+    if selectors.iter().any(|selector| selector.diff.is_some()) {","+        let workspace_dir = config.workspace_dir.as_deref().unwrap_or(prefix);","+        options.project_dependencies =","+            overridden_project_dependencies(graph, config, workspace_dir)?;","+    }","+    Ok(options)","+}","+","+/// Each project's declared dependencies plus every dependency the","+/// overrides rewrite them to, keyed by root directory, for finding the","+/// projects that use a changed catalog entry. `None` when no overrides are","+/// configured.","+///","+/// Both lists count: a range-scoped override can stop or start applying","+/// when the catalog entry it is matched against changes.","+pub(crate) fn overridden_project_dependencies(","+    graph: &ProjectGraph<GraphPkg<'_>>,","+    config: &Config,","+    workspace_dir: &Path,","+) -> miette::Result<Option<ProjectDependencies>> {","+    let catalogs = configured_catalogs(config)?;","+    let Some(rewriter) = overrides_catalog_reference_rewriter(config, &catalogs, workspace_dir)","+        .into_diagnostic()","+        .wrap_err(\"parsing the overrides\")?","+    else {","+        return Ok(None);","+    };","+    Ok(Some(","+        graph","+            .iter()","+            .map(|(dir, node)| (dir.clone(), declared_and_rewritten(node.package, &rewriter)))","+            .collect(),","+    ))","+}","+","+/// Every group, declared and rewritten, is kept apart rather than merged,","+/// so no entry is replaced by a namesake from another group.","+fn declared_and_rewritten(","+    project: GraphPkg<'_>,","+    rewriter: &dyn DependencyRewriter,","+) -> Vec<(String, String)> {","+    let declared = project.dependency_groups(false);","+    let mut rewritten = declared.clone();","+    rewriter.rewrite_dependencies(&project, &mut rewritten);","+    [declared, rewritten]","+        .into_iter()","+        .flat_map(unmerged_dependencies)","+        .collect()","+}","+","+fn unmerged_dependencies(groups: DependencyGroups) -> impl Iterator<Item = (String, String)> {","+    let DependencyGroups { peer, dev, optional, prod } = groups;","+    peer.into_iter()","+        .chain(dev.into_iter().flatten())","+        .chain(optional)","+        .chain(prod)","+}","+","+#[cfg(test)]","+mod tests;"],"additions":79,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/recursive/filter_graphs/tests.rs","lines":["@@ -0,0 +1,98 @@","+use super::overridden_project_dependencies;","+use pnpm_catalogs_types::{Catalog, Catalogs};","+use pnpm_config::Config;","+use pnpm_package_manifest::PackageManifest;","+use pnpm_workspace::{GraphPkg, Project};","+use pnpm_workspace_projects_graph::{ProjectGraph, ProjectGraphNode};","+use serde_json::json;","+use std::{fs, path::Path};","+","+/// The dependencies the changed-catalog check reads for one project with","+/// `manifest`, under `overrides` and a `local` catalog mapping `lib` to","+/// `lib_version`.","+fn checked_dependencies(","+    manifest: &serde_json::Value,","+    overrides: &[(&str, &str)],","+    lib_version: &str,","+) -> Vec<(String, String)> {","+    let tmp = tempfile::tempdir().unwrap();","+    let manifest_path = tmp.path().join(\"package.json\");","+    fs::write(&manifest_path, manifest.to_string()).unwrap();","+    let project = Project {","+        root_dir: tmp.path().to_path_buf(),","+        manifest: PackageManifest::from_path(manifest_path).unwrap(),","+        dependency_manifest: None,","+    };","+    let mut graph: ProjectGraph<GraphPkg<'_>> = ProjectGraph::new();","+    graph.insert(","+        project.root_dir.clone(),","+        ProjectGraphNode { package: GraphPkg { project: &project }, dependencies: Vec::new() },","+    );","+","+    let mut config = Config::new();","+    config.overrides = Some(","+        overrides","+            .iter()","+            .map(|(selector, value)| ((*selector).to_string(), (*value).to_string()))","+            .collect(),","+    );","+    let catalog = Catalog::from([(\"lib\".to_string(), lib_version.to_string())]);","+    config.catalogs = Some(Catalogs::from([","+        (\"local\".to_string(), catalog.clone()),","+        (\"default\".to_string(), catalog),","+    ]));","+","+    overridden_project_dependencies(&graph, &config, Path::new(\"/workspace\"))","+        .unwrap()","+        .expect(\"overrides are configured\")","+        .remove(&project.root_dir)","+        .unwrap()","+}","+","+fn has(dependencies: &[(String, String)], name: &str, spec: &str) -> bool {","+    dependencies","+        .iter()","+        .any(|(dep, dep_spec)| dep == name && dep_spec == spec)","+}","+","+#[test]","+fn keeps_a_rewritten_entry_whose_name_another_group_declares() {","+    let manifest = json!({","+        \"name\": \"app\",","+        \"dependencies\": { \"lib\": \"^1.0.0\" },","+        \"optionalDependencies\": { \"lib\": \"^1.0.0\" },","+    });","+    let dependencies =","+        checked_dependencies(&manifest, &[(\"lib:optional\", \"catalog:local\")], \"^2.0.0\");","+    assert!(has(&dependencies, \"lib\", \"catalog:local\"), \"{dependencies:?}\");","+}","+","+#[test]","+fn keeps_a_peer_entry_a_range_scoped_override_rewrites() {","+    let manifest = json!({","+        \"name\": \"app\",","+        \"dependencies\": { \"lib\": \"^1.0.0\" },","+        \"peerDependencies\": { \"lib\": \"^2.0.0\" },","+    });","+    let dependencies = checked_dependencies(&manifest, &[(\"lib@^2\", \"catalog:local\")], \"^2.0.0\");","+    assert!(has(&dependencies, \"lib\", \"catalog:local\"), \"{dependencies:?}\");","+}","+","+#[test]","+fn keeps_a_declared_catalog_entry_an_override_rewrites() {","+    let manifest = json!({ \"name\": \"app\", \"dependencies\": { \"lib\": \"catalog:\" } });","+    let dependencies = checked_dependencies(&manifest, &[(\"lib@^2\", \"3.0.0\")], \"2.0.0\");","+    assert!(has(&dependencies, \"lib\", \"catalog:\"), \"{dependencies:?}\");","+    assert!(has(&dependencies, \"lib\", \"3.0.0\"), \"{dependencies:?}\");","+}","+","+#[test]","+fn keeps_a_declared_catalog_entry_whose_name_another_group_declares() {","+    let manifest = json!({","+        \"name\": \"app\",","+        \"dependencies\": { \"lib\": \"^1.0.0\" },","+        \"peerDependencies\": { \"lib\": \"catalog:\" },","+    });","+    let dependencies = checked_dependencies(&manifest, &[(\"lib@^2\", \"3.0.0\")], \"2.0.0\");","+    assert!(has(&dependencies, \"lib\", \"catalog:\"), \"{dependencies:?}\");","+}"],"additions":98,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pipeline_selection.rs","lines":["@@ -187,3 +187,40 @@ fn pipeline_dry_run_json_routes_selection_warnings_to_stderr() {","         serde_json::from_slice(&missing_base.get_output().stdout).expect(\"valid dry-run JSON\");","     assert_eq!(base_doc[\"tasks\"][0][\"project\"], \"pkg\");"," }","+","+#[test]","+fn affected_selection_follows_overrides_to_a_changed_catalog_entry() {","+    let root = tempfile::tempdir().unwrap();","+    let fixture = GitRepoFixture::init(root.path(), \"demo\");","+    let workspace_manifest = |lib: &str| {","+        format!(","+            \"packages: [app, other]\\npipelines:\\n  default: [build]\\nchangedFilesIgnorePattern: [pnpm-workspace.yaml]\\noverrides:\\n  lib: 'catalog:local'\\ncatalogs:\\n  local:\\n    lib: {lib}\\n\",","+        )","+    };","+    fixture.write_file(\"package.json\", ROOT_MANIFEST);","+    fixture.write_file(\"pnpm-workspace.yaml\", &workspace_manifest(\"^1.0.0\"));","+    fixture.write_file(","+        \"app/package.json\",","+        r#\"{\"name\":\"app\",\"version\":\"1.0.0\",\"scripts\":{\"build\":\"echo app\"},\"dependencies\":{\"lib\":\"^1.0.0\"}}\"#,","+    );","+    fixture.write_file(","+        \"other/package.json\",","+        r#\"{\"name\":\"other\",\"version\":\"1.0.0\",\"scripts\":{\"build\":\"echo other\"}}\"#,","+    );","+    let base = fixture.commit(\"initial\");","+    fixture.write_file(\"pnpm-workspace.yaml\", &workspace_manifest(\"^1.1.0\"));","+","+    let result = pipeline(","+        &root.path().join(\"demo-src\"),","+        &root.path().join(\"config\"),","+        &[\"--base\", &base, \"--dry-run\", \"--json\"],","+    );","+    let document: serde_json::Value = serde_json::from_slice(&result.get_output().stdout).unwrap();","+    let projects: Vec<&str> = document[\"tasks\"]","+        .as_array()","+        .unwrap()","+        .iter()","+        .filter_map(|task| task[\"project\"].as_str())","+        .collect();","+    assert_eq!(projects, [\"app\"], \"{document}\");","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/run_recursive.rs","lines":["@@ -1106,6 +1106,8 @@ fn sorted_lines(stdout: &[u8]) -> Vec<String> {"," "," mod selection;"," ","+mod since_catalogs;","+"," mod filter_prod_exclusions;"," "," mod task_graph;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/run_recursive/since_catalogs.rs","lines":["@@ -0,0 +1,76 @@","+use super::{CommandExtra, CommandTempCwd, build_writes_marker, fs, json, write_workspace};","+use assert_cmd::assert::OutputAssertExt;","+use std::path::Path;","+","+fn git(cwd: &Path, args: &[&str]) {","+    let output = std::process::Command::new(\"git\")","+        .args(args)","+        .current_dir(cwd)","+        .output()","+        .expect(\"spawn git\");","+    assert!(","+        output.status.success(),","+        \"git {args:?} failed: {}\",","+        String::from_utf8_lossy(&output.stderr),","+    );","+}","+","+#[derive(Debug, PartialEq, Eq)]","+struct Ran {","+    app: bool,","+    other: bool,","+}","+","+/// Commit a workspace of `app`, which declares `lib: <app_lib>`, and","+/// `other`, change the `local` catalog's `lib` from `lib_before` to","+/// `lib_after`, run `-r --filter [HEAD~1] run build`, and return whether","+/// each of `app` and `other` ran.","+fn run_after_catalog_change(","+    app_lib: &str,","+    overrides: &str,","+    (lib_before, lib_after): (&str, &str),","+) -> Ran {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    let mut app = build_writes_marker(\"app\");","+    app[\"dependencies\"] = json!({ \"lib\": app_lib });","+    write_workspace(&workspace, &[(\"app\", app), (\"other\", build_writes_marker(\"other\"))]);","+    let workspace_yaml = workspace.join(\"pnpm-workspace.yaml\");","+    let packages = fs::read_to_string(&workspace_yaml).expect(\"read pnpm-workspace.yaml\");","+    let write_catalog = |lib: &str| {","+        let settings = format!(\"overrides:\\n{overrides}catalogs:\\n  local:\\n    lib: {lib}\\n\");","+        fs::write(&workspace_yaml, format!(\"{packages}{settings}\"))","+            .expect(\"write pnpm-workspace.yaml\");","+    };","+    write_catalog(lib_before);","+    git(&workspace, &[\"init\", \"--initial-branch=main\"]);","+    git(&workspace, &[\"config\", \"user.email\", \"x@y.z\"]);","+    git(&workspace, &[\"config\", \"user.name\", \"xyz\"]);","+    git(&workspace, &[\"add\", \".\"]);","+    git(&workspace, &[\"commit\", \"-m\", \"base\", \"--no-gpg-sign\"]);","+    write_catalog(lib_after);","+    git(&workspace, &[\"commit\", \"-am\", \"bump the catalog\", \"--no-gpg-sign\"]);","+","+    pacquet","+        .with_args([\"-r\", \"--filter\", \"[HEAD~1]\", \"run\", \"build\"])","+        .assert()","+        .success();","+","+    let ran = Ran {","+        app: workspace.join(\"app/ran.txt\").exists(),","+        other: workspace.join(\"other/ran.txt\").exists(),","+    };","+    drop(root);","+    ran","+}","+","+#[test]","+fn diff_selector_selects_projects_using_a_changed_catalog_through_overrides() {","+    let ran = run_after_catalog_change(\"^1.0.0\", \"  lib: 'catalog:local'\\n\", (\"^1.0.0\", \"^1.1.0\"));","+    assert_eq!(ran, Ran { app: true, other: false });","+}","+","+#[test]","+fn diff_selector_selects_a_catalog_dependency_a_range_scoped_override_starts_to_match() {","+    let ran = run_after_catalog_change(\"catalog:local\", \"  lib@^2: 3.0.0\\n\", (\"1.0.0\", \"2.0.0\"));","+    assert_eq!(ran, Ran { app: true, other: false });","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides.rs","lines":["@@ -11,7 +11,9 @@"," //! on the in-memory `Value` only."," "," pub use dependency_matcher::OverriddenDependencyMatcher;","-pub use dependency_rewriter::overrides_dependency_rewriter;","+pub use dependency_rewriter::{","+    overrides_catalog_reference_rewriter, overrides_dependency_rewriter,","+};"," pub(crate) use selectors::{matches_target, parse_declared_range};"," "," mod dependency_matcher;"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides/dependency_rewriter.rs","lines":["@@ -1,4 +1,5 @@"," use crate::overrides::VersionsOverrider;","+use pnpm_catalogs_protocol_parser::parse_catalog_protocol;"," use pnpm_catalogs_types::Catalogs;"," use pnpm_config::Config;"," use pnpm_config_parse_overrides::ParseOverridesError;","@@ -20,6 +21,33 @@ pub fn overrides_dependency_rewriter(","     config: &Config,","     catalogs: &Catalogs,","     workspace_dir: &Path,","+) -> Result<Option<VersionsOverrider>, ParseOverridesError> {","+    build_overrides_rewriter(config, catalogs, workspace_dir, CatalogValues::Dereference)","+}","+","+/// [`overrides_dependency_rewriter`], except that an override whose value","+/// is a `catalog:` reference writes that reference, so the rewritten","+/// dependencies name the catalog entries they resolve through. A","+/// convergence override still writes the entry's version.","+pub fn overrides_catalog_reference_rewriter(","+    config: &Config,","+    catalogs: &Catalogs,","+    workspace_dir: &Path,","+) -> Result<Option<VersionsOverrider>, ParseOverridesError> {","+    build_overrides_rewriter(config, catalogs, workspace_dir, CatalogValues::Keep)","+}","+","+#[derive(Clone, Copy)]","+enum CatalogValues {","+    Dereference,","+    Keep,","+}","+","+fn build_overrides_rewriter(","+    config: &Config,","+    catalogs: &Catalogs,","+    workspace_dir: &Path,","+    catalog_values: CatalogValues,"," ) -> Result<Option<VersionsOverrider>, ParseOverridesError> {","     let Some(map) = config.overrides","         .as_ref()","@@ -27,7 +55,17 @@ pub fn overrides_dependency_rewriter(","     else {","         return Ok(None);","     };","-    let parsed = pnpm_config_parse_overrides::parse_overrides_iter(map.iter(), catalogs)?;","+    let mut parsed = pnpm_config_parse_overrides::parse_overrides_iter(map.iter(), catalogs)?;","+    match catalog_values {","+        CatalogValues::Dereference => {}","+        CatalogValues::Keep => {","+            for (entry, raw_value) in parsed.iter_mut().zip(map.values()) {","+                if !entry.converge && parse_catalog_protocol(raw_value).is_some() {","+                    entry.new_bare_specifier.clone_from(raw_value);","+                }","+            }","+        }","+    }","     let root_dir = config.root_project_manifest_dir(workspace_dir);","     Ok(Some(VersionsOverrider::new(&parsed, root_dir).with_catalogs(catalogs)))"," }"],"additions":39,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides/tests.rs","lines":["@@ -8,6 +8,7 @@ use pnpm_workspace_projects_graph::{"," use serde_json::{Value, json};"," use std::path::{Path, PathBuf};"," ","+mod catalog_references;"," mod specificity;"," "," fn parsed(map: &[(&str, &str)]) -> Vec<pnpm_config_parse_overrides::VersionOverride> {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides/tests/catalog_references.rs","lines":["@@ -0,0 +1,58 @@","+use super::{pairs, prod_only, rewritten};","+use crate::{overrides_catalog_reference_rewriter, overrides_dependency_rewriter};","+use indexmap::IndexMap;","+use pnpm_catalogs_types::{Catalog, Catalogs};","+use pnpm_config::Config;","+use std::path::Path;","+","+fn config_with_overrides(overrides: &[(&str, &str)]) -> Config {","+    let mut config = Config::new();","+    config.overrides = Some(","+        overrides","+            .iter()","+            .map(|(selector, value)| ((*selector).to_string(), (*value).to_string()))","+            .collect::<IndexMap<_, _>>(),","+    );","+    config","+}","+","+fn local_catalog() -> Catalogs {","+    let mut local = Catalog::new();","+    local.insert(\"lib\".to_string(), \"^2.0.0\".to_string());","+    let mut catalogs = Catalogs::new();","+    catalogs.insert(\"local\".to_string(), local);","+    catalogs","+}","+","+#[test]","+fn catalog_reference_rewriter_keeps_the_catalog_reference_of_an_override() {","+    let config = config_with_overrides(&[(\"lib\", \"catalog:local\"), (\"other\", \"^3.0.0\")]);","+    let catalogs = local_catalog();","+    let declared = || prod_only(&[(\"lib\", \"^1.0.0\"), (\"other\", \"^1.0.0\")]);","+","+    let reference_rewriter =","+        overrides_catalog_reference_rewriter(&config, &catalogs, Path::new(\"/workspace\"))","+            .expect(\"parse overrides\")","+            .expect(\"overrides are configured\");","+    assert_eq!(","+        rewritten(&reference_rewriter, \"app\", declared()),","+        pairs(&[(\"lib\", \"catalog:local\"), (\"other\", \"^3.0.0\")]),","+    );","+","+    let resolving_rewriter =","+        overrides_dependency_rewriter(&config, &catalogs, Path::new(\"/workspace\"))","+            .expect(\"parse overrides\")","+            .expect(\"overrides are configured\");","+    assert_eq!(","+        rewritten(&resolving_rewriter, \"app\", declared()),","+        pairs(&[(\"lib\", \"^2.0.0\"), (\"other\", \"^3.0.0\")]),","+    );","+}","+","+#[test]","+fn catalog_reference_rewriter_is_none_without_overrides() {","+    let rewriter =","+        overrides_catalog_reference_rewriter(&Config::new(), &local_catalog(), Path::new(\"/w\"))","+            .expect(\"parse overrides\");","+    assert!(rewriter.is_none());","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace-projects-filter/src/filter.rs","lines":["@@ -6,7 +6,7 @@ pub use with_prod_graph::{"," };"," "," use crate::{","-    get_changed_projects::{GetChangedProjectsOptions, get_changed_projects},","+    get_changed_projects::{GetChangedProjectsOptions, ProjectDependencies, get_changed_projects},","     glob,","     parse_project_selector::{DependencyTraversal, ProjectSelector},"," };","@@ -16,6 +16,7 @@ use pnpm_catalogs_types::Catalogs;"," use pnpm_matcher::create_matcher;"," use pnpm_workspace_projects_graph::{BaseProject, ProjectGraph};"," use std::{","+    borrow::Cow,","     collections::HashMap,","     path::{Component, Path, PathBuf},"," };","@@ -54,6 +55,10 @@ pub struct FilterWorkspaceProjectsOptions {","     /// `changedFilesIgnorePattern`: glob patterns of changed files a","     /// `[<since>]` selector ignores.","     pub changed_files_ignore_pattern: Vec<String>,","+    /// The dependencies a `[<since>]` selector checks for changed catalog","+    /// entries, keyed by root directory. `None` checks the dependencies each","+    /// graph node declares.","+    pub project_dependencies: Option<ProjectDependencies>,"," }"," "," /// Options for [`filter_projects`] / [`filter_projects_by_selector_objects`].","@@ -225,10 +230,15 @@ fn changed_selector_projects<Pkg: BaseProject>(","     selector: &ProjectSelector,","     diff: &str,"," ) -> Result<crate::get_changed_projects::ChangedProjects, FilterError> {","-    let project_dependencies: HashMap<PathBuf, Vec<(String, String)>> = projects_graph","-        .iter()","-        .map(|(dir, node)| (dir.clone(), node.package.merged_dependencies(false)))","-        .collect();","+    let project_dependencies = match &opts.project_dependencies {","+        Some(project_dependencies) => Cow::Borrowed(project_dependencies),","+        None => Cow::Owned(","+            projects_graph","+                .iter()","+                .map(|(dir, node)| (dir.clone(), node.package.merged_dependencies(false)))","+                .collect(),","+        ),","+    };","     get_changed_projects(","         projects_graph.keys().cloned().collect(),","         diff,"],"additions":15,"deletions":5,"truncated":false},{"path":"pnpm/crates/workspace-projects-filter/src/filter/from_projects.rs","lines":["@@ -89,6 +89,7 @@ fn workspace_filter_options(opts: &FilterProjectsOptions) -> FilterWorkspaceProj","         workspace_dir: opts.workspace_dir.clone(),","         test_pattern: opts.test_pattern.clone(),","         changed_files_ignore_pattern: opts.changed_files_ignore_pattern.clone(),","+        project_dependencies: None,","     }"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace-projects-filter/src/filter/tests.rs","lines":["@@ -605,6 +605,7 @@ fn is_subdir_contract() {"," /// upstream's \"select changed packages\" suite. Each builds a real git"," /// repository in a temp directory."," mod changed_packages {","+    mod catalog_overrides;","     mod git_pathnames;"," ","     use super::{TestPkg, graph_project, node_at};"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace-projects-filter/src/filter/tests/changed_packages/catalog_overrides.rs","lines":["@@ -0,0 +1,56 @@","+use super::{TestPkg, commit_all, diff_selector, graph_project, init_repo, selected};","+use crate::filter::FilterWorkspaceProjectsOptions;","+use indexmap::IndexMap;","+use pnpm_workspace_projects_graph::{ProjectGraph, ProjectGraphNode};","+use std::{collections::HashMap, fs, path::Path};","+use tempfile::TempDir;","+","+#[test]","+fn selects_projects_by_the_given_project_dependencies() {","+    let workspace = TempDir::new().expect(\"create tempdir\");","+    let workspace_dir = workspace.path();","+    init_repo(workspace_dir);","+","+    let app_dir = workspace_dir.join(\"packages/app\");","+    let other_dir = workspace_dir.join(\"packages/other\");","+    fs::create_dir_all(&app_dir).expect(\"create app\");","+    fs::create_dir_all(&other_dir).expect(\"create other\");","+    let write_manifest = |lib: &str| {","+        fs::write(","+            workspace_dir.join(\"pnpm-workspace.yaml\"),","+            format!(\"packages:\\n  - 'packages/*'\\ncatalogs:\\n  local:\\n    lib: {lib}\\n\"),","+        )","+        .expect(\"write workspace manifest\");","+    };","+    write_manifest(\"^1.0.0\");","+    commit_all(workspace_dir);","+    write_manifest(\"^1.1.0\");","+","+    let mut graph: ProjectGraph<TestPkg> = IndexMap::new();","+    for (dir, name, deps) in","+        [(&app_dir, \"app\", [(\"lib\", \"^1.0.0\")]), (&other_dir, \"other\", [(\"lib\", \"catalog:local\")])]","+    {","+        graph.insert(","+            dir.clone(),","+            ProjectGraphNode {","+                package: graph_project(&dir.to_string_lossy(), name, &deps),","+                dependencies: Vec::new(),","+            },","+        );","+    }","+    let path_of = |dir: &Path| dir.to_string_lossy().into_owned();","+    let declared = FilterWorkspaceProjectsOptions {","+        workspace_dir: workspace_dir.to_path_buf(),","+        ..Default::default()","+    };","+    assert_eq!(selected(&graph, &[diff_selector(\"HEAD\")], &declared), [path_of(&other_dir)]);","+","+    let overridden = FilterWorkspaceProjectsOptions {","+        project_dependencies: Some(HashMap::from([","+            (app_dir.clone(), vec![(\"lib\".to_string(), \"catalog:local\".to_string())]),","+            (other_dir, vec![(\"lib\".to_string(), \"^2.0.0\".to_string())]),","+        ])),","+        ..declared","+    };","+    assert_eq!(selected(&graph, &[diff_selector(\"HEAD\")], &overridden), [path_of(&app_dir)]);","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace-projects-filter/src/get_changed_projects.rs","lines":["@@ -12,6 +12,10 @@ mod catalogs;"," #[cfg(test)]"," mod tests;"," ","+/// Each project's `(name, specifier)` dependency pairs, keyed by root","+/// directory.","+pub type ProjectDependencies = HashMap<PathBuf, Vec<(String, String)>>;","+"," /// Options for [`get_changed_projects`]."," pub struct GetChangedProjectsOptions<'a> {","     /// Workspace root directory where `pnpm-workspace.yaml` resides.","@@ -21,7 +25,7 @@ pub struct GetChangedProjectsOptions<'a> {","     pub working_dir: Option<&'a Path>,","     pub test_pattern: &'a [String],","     pub changed_files_ignore_pattern: &'a [String],","-    pub project_dependencies: Option<&'a HashMap<PathBuf, Vec<(String, String)>>>,"],"additions":4,"deletions":1