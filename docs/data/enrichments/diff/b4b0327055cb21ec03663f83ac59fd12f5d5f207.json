xt, Func<TState, ValueTask> taskFunc, TState state)","         {","             var currentContext = RuntimeContext.Current;"],"additions":7,"deletions":0,"truncated":false},{"path":"src/Orleans.Runtime/Services/GrainService.cs","lines":["@@ -113,7 +113,9 @@ protected virtual Task StartInBackground()","         /// <returns>A <see cref=\"Task\"/> representing the work performed.</returns>","         public virtual Task Stop()","         {","+#pragma warning disable CA1849 // Derived-service callbacks run on this calling scheduler and complete before the status transition.","             StoppedCancellationTokenSource.Cancel();","+#pragma warning restore CA1849"," ","             LogInformationServiceStopping(Logger, typeName);","             Status = GrainServiceStatus.Stopped;"],"additions":2,"deletions":0,"truncated":false},{"path":"test/Orleans.Core.Tests/Runtime/GrainServiceCancellationTests.cs","lines":["@@ -0,0 +1,94 @@","+using Microsoft.Extensions.DependencyInjection;","+using Microsoft.Extensions.Hosting;","+using Microsoft.Extensions.Logging;","+using NSubstitute;","+using Orleans;","+using Orleans.Hosting;","+using Orleans.Runtime;","+using Orleans.Runtime.ConsistentRing;","+using Orleans.Runtime.Scheduler;","+using TestExtensions;","+using Xunit;","+","+namespace UnitTests.Runtime;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"Runtime\")]","+[TestCategory(\"BVT\"), TestCategory(\"GrainServices\")]","+public class GrainServiceCancellationTests","+{","+    [Theory]","+    [InlineData(false)]","+    [InlineData(true)]","+    public async Task Stop_CancelsInlineBeforeTransitioningToStopped(bool callbackThrows)","+    {","+        using var host = new HostBuilder()","+            .ConfigureLogging(logging => logging.ClearProviders())","+            .UseOrleans(silo => silo.UseLocalhostClustering())","+            .Build();","+        var ring = Substitute.For<IConsistentRingProvider>();","+        var service = new TestGrainService(ring, host.Services.GetRequiredService<SystemTargetShared>());","+        using var shutdown = service.Shutdown;","+        var failure = new InvalidOperationException(\"stop callback failed\");","+        var callbackCount = 0;","+        int callbackThread = 0;","+        TaskScheduler? callbackScheduler = null;","+        IGrainContext? callbackContext = null;","+        var callbackSawStopped = true;","+        using var registration = shutdown.Token.Register(() =>","+        {","+            callbackCount++;","+            callbackThread = Environment.CurrentManagedThreadId;","+            callbackScheduler = TaskScheduler.Current;","+            callbackContext = RuntimeContext.Current;","+            callbackSawStopped = service.IsStopped;","+            if (callbackThrows)","+            {","+                throw failure;","+            }","+        });","+","+        await service.RunOrQueueTask(async () =>","+        {","+            var stoppingThread = Environment.CurrentManagedThreadId;","+            var stoppingScheduler = TaskScheduler.Current;","+            Assert.Same(service, RuntimeContext.Current);","+            Assert.False(service.IsStopped);","+","+            if (callbackThrows)","+            {","+                var exception = Assert.Throws<AggregateException>(() => { _ = service.Stop(); });","+                Assert.Same(failure, Assert.Single(exception.InnerExceptions));","+                Assert.False(service.IsStopped);","+                ring.DidNotReceive().UnSubscribeFromRangeChangeEvents(service);","+            }","+            else","+            {","+                var stopping = service.Stop();","+                Assert.True(stopping.IsCompletedSuccessfully);","+                Assert.True(service.IsStopped);","+            }","+","+            Assert.True(shutdown.IsCancellationRequested);","+            Assert.Equal(1, callbackCount);","+            Assert.Equal(stoppingThread, callbackThread);","+            Assert.Same(stoppingScheduler, callbackScheduler);","+            Assert.Same(service, callbackContext);","+            Assert.False(callbackSawStopped);","+","+            await service.Stop();","+            await service.Stop();","+            Assert.True(service.IsStopped);","+            Assert.Equal(1, callbackCount);","+            ring.Received(1).UnSubscribeFromRangeChangeEvents(service);","+        }).WaitAsync(TimeSpan.FromSeconds(10), TestContext.Current.CancellationToken);","+    }","+","+    private sealed class TestGrainService(IConsistentRingProvider ring, SystemTargetShared shared)","+        : GrainService(GrainId.Create(\"test-stop\", \"scheduler\"), ring, shared)","+    {","+        public CancellationTokenSource Shutdown => StoppedCancellationTokenSource;","+        public bool IsStopped => Status == GrainServiceStatus.Stopped;","+    }","+}"],"additions":94,"deletions":0,"truncated":false},{"path":"test/Orleans.Core.Tests/Runtime/ManagementGrainActivationCountTests.cs","lines":["@@ -0,0 +1,92 @@","+using NSubstitute;","+using Orleans.Runtime;","+using Orleans.Runtime.Management;","+using Orleans.Runtime.MembershipService;","+using Xunit;","+","+namespace UnitTests.Runtime;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"Runtime\")]","+[TestCategory(\"BVT\"), TestCategory(\"Management\")]","+public sealed class ManagementGrainActivationCountTests","+{","+    [Fact]","+    public async Task GetTotalActivationCount_SumsCountsFromEveryActiveSilo()","+    {","+        var (managementGrain, controls) = CreateManagementGrain();","+        controls[0].GetActivationCount(Arg.Any<CancellationToken>()).Returns(Task.FromResult(17));","+        controls[1].GetActivationCount(Arg.Any<CancellationToken>()).Returns(Task.FromResult(25));","+","+        var result = await managementGrain.GetTotalActivationCount(TestContext.Current.CancellationToken);","+","+        Assert.Equal(42, result);","+        foreach (var control in controls)","+        {","+            _ = control.Received(1).GetActivationCount(TestContext.Current.CancellationToken);","+        }","+    }","+","+    [Fact]","+    public async Task GetTotalActivationCount_PropagatesSiloFailure()","+    {","+        var (managementGrain, controls) = CreateManagementGrain();","+        var failure = new InvalidOperationException(\"Silo request failed.\");","+        controls[0].GetActivationCount(Arg.Any<CancellationToken>()).Returns(Task.FromResult(17));","+        _ = controls[1].GetActivationCount(Arg.Any<CancellationToken>()).Returns(Task.FromException<int>(failure));","+","+        var exception = await Assert.ThrowsAsync<InvalidOperationException>(","+            () => managementGrain.GetTotalActivationCount(TestContext.Current.CancellationToken));","+","+        Assert.Same(failure, exception);","+    }","+","+    [Fact]","+    public async Task GetTotalActivationCount_PropagatesSiloCancellation()","+    {","+        var (managementGrain, controls) = CreateManagementGrain();","+        using var siloCancellation = new CancellationTokenSource();","+        siloCancellation.Cancel();","+        controls[0].GetActivationCount(Arg.Any<CancellationToken>()).Returns(Task.FromResult(17));","+        controls[1].GetActivationCount(Arg.Any<CancellationToken>())","+            .Returns(Task.FromCanceled<int>(siloCancellation.Token));","+","+        await Assert.ThrowsAnyAsync<OperationCanceledException>(","+            () => managementGrain.GetTotalActivationCount(TestContext.Current.CancellationToken));","+    }","+","+    private static (ManagementGrain ManagementGrain, ISiloControl[] Controls) CreateManagementGrain()","+    {","+        var firstSilo = SiloAddress.FromParsableString(\"127.0.0.1:11111@1\");","+        var secondSilo = SiloAddress.FromParsableString(\"127.0.0.1:22222@1\");","+        var hosts = new Dictionary<SiloAddress, SiloStatus>","+        {","+            [firstSilo] = SiloStatus.Active,","+            [secondSilo] = SiloStatus.Active","+        };","+        var statusOracle = Substitute.For<ISiloStatusOracle>();","+        statusOracle.GetApproximateSiloStatuses(onlyActive: true).Returns(hosts);","+        var membershipManager = Substitute.For<IMembershipManager>();","+        membershipManager.Refresh(null, Arg.Any<CancellationToken>(), false).Returns(Task.CompletedTask);","+","+        var firstControl = Substitute.For<ISiloControl>();","+        var secondControl = Substitute.For<ISiloControl>();","+        var grainFactory = Substitute.For<IInternalGrainFactory>();","+        grainFactory.GetSystemTarget<ISiloControl>(Constants.SiloControlType, firstSilo).Returns(firstControl);","+        grainFactory.GetSystemTarget<ISiloControl>(Constants.SiloControlType, secondSilo).Returns(secondControl);","+","+        var clusterManifestProvider = Substitute.For<IClusterManifestProvider>();","+        var managementGrain = new ManagementGrain(","+            grainFactory,","+            statusOracle,","+            versionStore: null!,","+            logger: null!,","+            membershipManager,","+            clusterManifestProvider,","+            catalog: null!,","+            grainLocator: null!);","+","+        return (managementGrain, [firstControl, secondControl]);","+    }","+}"],"additions":92,"deletions":0,"truncated":false},{"path":"test/Orleans.Core.Tests/SchedulerTests/OrleansTaskSchedulerBasicTests.cs","lines":["@@ -116,6 +116,113 @@ public async Task Async_Task_Start_ActivationTaskScheduler()","             Assert.Equal(expected, received);","         }"," ","+        [Theory]","+        [InlineData(\"task\", false)]","+        [InlineData(\"task\", true)]","+        [InlineData(\"task-result\", false)]","+        [InlineData(\"task-result\", true)]","+        [InlineData(\"value-task\", false)]","+        [InlineData(\"value-task\", true)]","+        [InlineData(\"action\", false)]","+        public async Task ClosureWorkItem_PropagatesDelegateFailureThroughCompletionTask(string kind, bool delayedFailure)","+        {","+            var expected = new InvalidOperationException(\"Work-item delegate failed.\");","+            var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);","+            var release = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);","+            WorkItemBase workItem;","+            Task completion;","+            switch (kind)","+            {","+                case \"task\":","+                    var asyncItem = new AsyncClosureWorkItem(","+                        () => delayedFailure ? FailAsync() : throw expected, _rootContext);","+                    workItem = asyncItem;","+                    completion = asyncItem.Task;","+                    break;","+                case \"task-result\":","+                    var resultItem = new AsyncClosureWorkItem<int>(","+                        () => delayedFailure ? FailAsync() : throw expected, _rootContext);","+                    workItem = resultItem;","+                    completion = resultItem.Task;","+                    break;","+                case \"value-task\":","+                    var valueTaskItem = new StatefulAsyncClosureWorkItem<Exception>(","+                        failure => delayedFailure ? new ValueTask(FailAsync()) : throw failure,","+                        expected, _rootContext);","+                    workItem = valueTaskItem;","+                    completion = valueTaskItem.Task;","+                    break;","+                case \"action\":","+                    var actionItem = new ClosureWorkItem<Exception>(","+                        static failure => throw failure, expected, null, _rootContext);","+                    workItem = actionItem;","+                    completion = actionItem.Task;","+                    break;","+                default:","+                    throw new ArgumentOutOfRangeException(nameof(kind));","+            }","+","+            _rootContext.Scheduler.QueueWorkItem(workItem);","+            try","+            {","+                if (delayedFailure)","+                {","+                    await started.Task.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken);","+                    Assert.False(completion.IsCompleted);","+                    release.SetResult();","+                }","+","+                var exception = await Assert.ThrowsAsync<InvalidOperationException>(() =>","+                    completion.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken));","+                Assert.Same(expected, exception);","+                Assert.True(completion.IsFaulted);","+                var next = new Task<int>(() => 42);","+                _rootContext.Scheduler.QueueTask(next);","+                Assert.Equal(42, await next.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken));","+            }","+            finally","+            {","+                release.TrySetResult();","+                await completion.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken)","+                    .ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing | ConfigureAwaitOptions.ContinueOnCapturedContext);","+            }","+","+            async Task<int> FailAsync()","+            {","+                started.SetResult();","+                await release.Task;","+                throw expected;","+            }","+        }","+","+        [Theory]","+        [InlineData(\"task\", false)]","+        [InlineData(\"task\", true)]","+        [InlineData(\"result\", false)]","+        [InlineData(\"result\", true)]","+        [InlineData(\"value-task\", false)]","+        [InlineData(\"value-task\", true)]","+        public async Task RunOrQueueTask_PropagatesInlineDelegateFailureThroughCompletionTask(string kind, bool cancellationFailure)","+        {","+            Exception expected = cancellationFailure","+                ? new OperationCanceledException()","+                : new InvalidOperationException(\"Inline delegate failed.\");","+            await _rootContext.QueueTask(async () =>","+            {","+                Assert.Same(_rootContext, RuntimeContext.Current);","+                Task completion = kind switch","+                {","+                    \"task\" => _rootContext.RunOrQueueTask(() => throw expected),","+                    \"result\" => _rootContext.RunOrQueueTaskResult<int>(() => throw expected),","+                    \"value-task\" => _rootContext.RunOrQueueTask<Exception>(static failure => throw failure, expected).AsTask(),","+                    _ => throw new ArgumentOutOfRangeException(nameof(kind))","+                };","+","+                Assert.True(completion.IsFaulted);","+                Assert.Same(expected, await Record.ExceptionAsync(() => completion));","+            }).WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken);","+        }","+","         [Fact]","         public async Task Sched_SimpleFifoTest()","         {"],"additions":107,"deletions":0,"truncated":false},{"path":"test/Orleans.Persistence.FileStorage.Tests/FileGrainStorageBoundaryTests.cs","lines":["@@ -8,6 +8,40 @@ namespace Orleans.Persistence.FileStorage.Tests;"," [TestProvider(\"None\"), TestSuite(\"BVT\"), TestCategory(\"FileStorage\"), TestCategory(\"Persistence\")]"," public sealed class FileGrainStorageBoundaryTests"," {","+    [Theory]","+    [InlineData(\"Read\", false)]","+    [InlineData(\"Read\", true)]","+    [InlineData(\"Write\", false)]","+    [InlineData(\"Write\", true)]","+    [InlineData(\"Clear\", false)]","+    [InlineData(\"Clear\", true)]","+    public async Task NullState_ThrowsBeforeAccessingStoredRecord(string operation, bool useCancellationOverload)","+    {","+        var cancellationToken = TestContext.Current.CancellationToken;","+        using var directory = new TemporaryDirectory();","+        IGrainStorage storage = FileGrainStorageTestContext.CreateStorage(directory.RootDirectory);","+        var grainId = GrainId.Create(\"type\", \"key\");","+        var state = new GrainState<FileStorageTestState>(new FileStorageTestState());","+        await storage.WriteStateAsync(\"state\", grainId, state, cancellationToken);","+        var path = Assert.Single(FileGrainStorageTestContext.GetRecordFiles(directory.RootDirectory));","+        var invalidRecord = \"invalid\"u8.ToArray();","+        await File.WriteAllBytesAsync(path, invalidRecord, cancellationToken);","+","+        var exception = await Assert.ThrowsAsync<ArgumentNullException>(() => (operation, useCancellationOverload) switch","+        {","+            (\"Read\", false) => storage.ReadStateAsync<FileStorageTestState>(\"state\", grainId, null!),","+            (\"Read\", true) => storage.ReadStateAsync<FileStorageTestState>(\"state\", grainId, null!, cancellationToken),","+            (\"Write\", false) => storage.WriteStateAsync<FileStorageTestState>(\"state\", grainId, null!),","+            (\"Write\", true) => storage.WriteStateAsync<FileStorageTestState>(\"state\", grainId, null!, cancellationToken),","+            (\"Clear\", false) => storage.ClearStateAsync<FileStorageTestState>(\"state\", grainId, null!),","+            (\"Clear\", true) => storage.ClearStateAsync<FileStorageTestState>(\"state\", grainId, null!, cancellationToken),","+            _ => throw new InvalidOperationException($\"Unexpected operation '{operation}'.\"),","+        });","+","+        Assert.Equal(\"grainState\", exception.ParamName);","+        Assert.Equal(invalidRecord, await File.ReadAllBytesAsync(path, cancellationToken));","+    }","+","     [Fact]","     public async Task BinaryPayload_RoundTripsWithoutTextConversion()","     {"],"additions":34,"deletions":0,"truncated":false},{"path":"test/Orleans.Placement.Tests/ActivationRebalancingTests/RebalancerEntropyTests.cs","lines":["@@ -0,0 +1,67 @@","+using System.Collections;","+using System.Net;","+using System.Reflection;","+using Orleans.Runtime;","+using Orleans.Runtime.Placement.Rebalancing;","+using Xunit;","+","+namespace UnitTests.ActivationRebalancingTests;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"Placement\")]","+[TestCategory(\"BVT\")]","+public sealed class RebalancerEntropyTests","+{","+    [Fact]","+    public void EqualWeightedLoadsHaveUniformEntropy()","+    {","+        var result = ComputeEntropy([(100L, 10), (100L, 10)], 20, 100);","+","+        Assert.Equal(Math.Log(2d), result, 14);","+    }","+","+    [Fact]","+    public void ActivationWeightsProduceExpectedEntropy()","+    {","+        var result = ComputeEntropy([(100L, 10), (100L, 30)], 40, 100);","+        var expected = -(0.25 * Math.Log(0.25) + 0.75 * Math.Log(0.75));","+","+        Assert.Equal(expected, result, 14);","+    }","+","+    [Fact]","+    public void MemoryWeightsProduceExpectedEntropy()","+    {","+        var result = ComputeEntropy([(100L, 10), (300L, 10)], 20, 100);","+        var expected = -(0.25 * Math.Log(0.25) + 0.75 * Math.Log(0.75));","+","+        Assert.Equal(expected, result, 14);","+    }","+","+    [Fact]","+    public void EmptyLoadRetainsEpsilonContribution()","+    {","+        const double Epsilon = 1e-10;","+        var result = ComputeEntropy([(100L, 10), (100L, 0)], 10, 100);","+","+        Assert.Equal(-Epsilon * Math.Log(Epsilon), result, 14);","+    }","+","+    private static double ComputeEntropy((long MemoryUsage, int ActivationCount)[] values, int totalActivations, double meanMemory)","+    {","+        var statisticsType = typeof(ActivationRebalancerWorker).GetNestedType(\"ResourceStatistics\", BindingFlags.NonPublic)!;","+        var dictionaryType = typeof(Dictionary<,>).MakeGenericType(typeof(SiloAddress), statisticsType);","+        var dictionary = Assert.IsAssignableFrom<IDictionary>(Activator.CreateInstance(dictionaryType));","+        for (var index = 0; index < values.Length; index++)","+        {","+            dictionary.Add(","+                SiloAddress.New(new IPEndPoint(IPAddress.Loopback, 11111 + index), 1),","+                Activator.CreateInstance(statisticsType, values[index].MemoryUsage, values[index].ActivationCount));","+        }","+","+        var method = typeof(ActivationRebalancerWorker).GetMethod(\"ComputeEntropy\", BindingFlags.NonPublic | BindingFlags.Static)!;","+        var result = method.Invoke(null, [dictionaryType.GetProperty(\"Values\")!.GetValue(dictionary), totalActivations, meanMemory]);","+        return Assert.IsType<double>(result);","+    }","+}",""],"additions":67,"deletions":0,"truncated":false}],"additions":441,"deletions":19,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-14T15:14:29.609402+00:00"}