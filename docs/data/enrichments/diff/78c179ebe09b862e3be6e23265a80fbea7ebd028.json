the runtime-filter edges the analysis saw are","+\t//! exactly the edges that run (nullptr when nothing needed resolution or for reschedules).","+\tunique_ptr<PipelineSchedule> resolved_schedule;"," };"," "," static shared_ptr<Event> CreatePipelineScheduleEvent(const PipelineScheduleStage &stage, bool initial_schedule) {","@@ -88,12 +91,22 @@ void Executor::ScheduleEventsInternal(ScheduleEventData &event_data) {"," \tauto &events = event_data.events;"," \tD_ASSERT(events.empty());"," ","-\tauto schedule = BuildPipelineSchedule(event_data.meta_pipelines);","-\tif (schedule->HasCycle()) {","+\tauto schedule = std::move(event_data.resolved_schedule);","+\tconst bool reused_resolved_schedule = schedule != nullptr;","+\tif (!schedule) {","+\t\tschedule = BuildPipelineSchedule(event_data.meta_pipelines);","+\t}","+\tif (schedule->HasCycle(PipelineScheduleGraph::SCHEDULED)) {"," \t\tthrow InternalException(\"Cyclic dependency in pipeline schedule\");"," \t}"," \tif (event_data.initial_schedule && recursive_ctes.empty()) {","-\t\tScheduleRuntimeFilters(*schedule);","+\t\tif (reused_resolved_schedule) {","+\t\t\t// The reused schedule already carries the runtime-filter edges the liveness analysis validated,","+\t\t\t// so only the stale filters need clearing.","+\t\t\tClearRuntimeFilters(*schedule);","+\t\t} else {","+\t\t\tScheduleRuntimeFilters(*schedule);","+\t\t}"," \t}"," \tevents.reserve(schedule->stages.size());"," \tfor (auto &stage : schedule->stages) {","@@ -122,8 +135,10 @@ void Executor::ScheduleEventsInternal(ScheduleEventData &event_data) {"," \t}"," }"," ","-void Executor::ScheduleEvents(const vector<shared_ptr<MetaPipeline>> &meta_pipelines) {","+void Executor::ScheduleEvents(const vector<shared_ptr<MetaPipeline>> &meta_pipelines,","+                              unique_ptr<PipelineSchedule> resolved_schedule) {"," \tScheduleEventData event_data(meta_pipelines, events, true);","+\tevent_data.resolved_schedule = std::move(resolved_schedule);"," \tScheduleEventsInternal(event_data);"," }"," ","@@ -263,7 +278,9 @@ void Executor::InitializeInternal(PhysicalOperator &plan) {"," \t\t// Resolve graph-dependent input modes after every pipeline and dependency has been constructed."," \t\tvector<shared_ptr<MetaPipeline>> to_schedule;"," \t\troot_pipeline->GetMetaPipelines(to_schedule, true, true);","-\t\tstate.ResolveExternalInputs(to_schedule);","+\t\t// Model the runtime-filter ordering edges under the same condition ScheduleRuntimeFilters uses below:","+\t\t// this is the initial schedule, so only recursive CTEs disable them.","+\t\tauto resolved_schedule = state.ResolveExternalInputs(to_schedule, recursive_ctes.empty());"," "," \t\tprofiler->Initialize(plan);"," \t\troot_pipeline->Ready();","@@ -286,7 +303,7 @@ void Executor::InitializeInternal(PhysicalOperator &plan) {"," "," \t\t// finally, verify and schedule"," \t\tVerifyPipelines();","-\t\tScheduleEvents(to_schedule);","+\t\tScheduleEvents(to_schedule, std::move(resolved_schedule));"," \t}"," }"," "],"additions":23,"deletions":6,"truncated":false},{"path":"src/parallel/pipeline.cpp","lines":["@@ -652,6 +652,32 @@ void Pipeline::AddDataflowDependency(shared_ptr<Pipeline> &pipeline) {"," \tpipeline->parents.push_back(weak_ptr<Pipeline>(shared_from_this()));"," }"," ","+void Pipeline::RemoveDataflowDependency(const shared_ptr<Pipeline> &pipeline) {","+\tD_ASSERT(pipeline);","+\tbool found_dependency = false;","+\tfor (auto entry = dataflow_dependencies.begin(); entry != dataflow_dependencies.end(); entry++) {","+\t\tauto dependency = entry->lock();","+\t\tD_ASSERT(dependency);","+\t\tif (RefersToSameObject(*dependency, *pipeline)) {","+\t\t\tdataflow_dependencies.erase(entry);","+\t\t\tfound_dependency = true;","+\t\t\tbreak;","+\t\t}","+\t}","+\tif (!found_dependency) {","+\t\tthrow InternalException(\"Attempted to remove a missing pipeline dataflow dependency\");","+\t}","+\tfor (auto entry = pipeline->parents.begin(); entry != pipeline->parents.end(); entry++) {","+\t\tauto parent = entry->lock();","+\t\tD_ASSERT(parent);","+\t\tif (RefersToSameObject(*parent, *this)) {","+\t\t\tpipeline->parents.erase(entry);","+\t\t\treturn;","+\t\t}","+\t}","+\tthrow InternalException(\"Pipeline dataflow dependency had no matching parent\");","+}","+"," vector<weak_ptr<Pipeline>> Pipeline::GetDependencies() const {"," \treturn dependencies;"," }","@@ -829,11 +855,27 @@ struct CTEPipelineSelection {"," \tbool stream_serialized_candidates = false;"," };"," ","+struct PipelineBufferedConsumerRecord {","+\tPipelineBufferedConsumerRecord(Pipeline &pipeline_p, PhysicalOperator &materialized_source_p,","+\t                               shared_ptr<Pipeline> cte_dependency_p, PhysicalCTE &cte_p, idx_t consumer_idx_p)","+\t    : pipeline(pipeline_p), materialized_source(materialized_source_p), cte_dependency(std::move(cte_dependency_p)),","+\t      cte(cte_p), consumer_idx(consumer_idx_p) {","+\t}","+","+\treference<Pipeline> pipeline;","+\treference<PhysicalOperator> materialized_source;","+\tshared_ptr<Pipeline> cte_dependency;","+\treference<PhysicalCTE> cte;","+\tidx_t consumer_idx;","+\tbool demoted = false;","+};","+"," class PipelineBuildStateData {"," public:"," \tvector<PipelineExternalInputCandidate> external_input_candidates;"," \tvector<CTEPipelineSelection> cte_selections;"," \treference_map_t<PhysicalCTE, idx_t> cte_selection_map;","+\tvector<PipelineBufferedConsumerRecord> buffered_consumers;"," };"," "," struct RemovedOptionalPipelineDependency {","@@ -1022,6 +1064,355 @@ void PipelineBuildState::AddExternalInputCandidate(Pipeline &pipeline, PhysicalO"," \t                                             std::move(cte_dependency), cte, consumer_idx);"," }"," ","+void PipelineBuildState::AddBufferedConsumer(Pipeline &pipeline, PhysicalOperator &materialized_source,","+                                             shared_ptr<Pipeline> cte_dependency, PhysicalCTE &cte,","+                                             idx_t consumer_idx) {","+\tdata->buffered_consumers.emplace_back(pipeline, materialized_source, std::move(cte_dependency), cte, consumer_idx);","+}","+","+//! Deadlock avoidance for buffered exchange consumers. An exchange producer throttles once the exchange buffer is","+//! full. It can only progress when a direct consumer runs it, or when a buffered consumer is draining. A buffered","+//! consumer drains when it can start without waiting on the exchange's own progress, and when its sink chain is","+//! itself live. This computes a least fixed point of stage and exchange liveness over the scheduled and analysis","+//! dependencies and returns a buffered consumer of an exchange that cannot be proven live, if any. Such a consumer","+//! is demoted to the materialized working table, which removes the producer's dependence on it.","+//! Before demoting, the caller tries the optional_candidates: execute-to-execute edges in the dead exchanges'","+//! gating regions. When such an edge is an optional ordering (cross product and union siblings are ordered for","+//! memory, not correctness), removing it can revive the exchange and preserve streaming, which beats falling back","+//! to a full materialization.","+static optional_ptr<PipelineBufferedConsumerRecord>","+FindExchangeStarvedBufferedConsumer(PipelineBuildStateData &data, const PipelineSchedule &schedule,","+                                    vector<pair<reference<Pipeline>, reference<Pipeline>>> &optional_candidates) {","+\tstruct ExchangeLiveness {","+\t\tvector<reference<PipelineBufferedConsumerRecord>> records;","+\t\tbool has_direct = false;","+\t\t//! The producers can run and the buffered consumers can drain, so the producers are never parked forever.","+\t\tbool live = false;","+\t\t//! The exchange can also deliver EOF: live, and every producer's own dataflow inputs can finish. An EOF","+\t\t//! wait must only be discharged by this, never by liveness alone, because a live producer that consumes","+\t\t//! another exchange completes only once that exchange finishes.","+\t\tbool finishes = false;","+\t};","+\treference_map_t<PhysicalCTE, ExchangeLiveness> exchanges;","+\tfor (auto &record : data.buffered_consumers) {","+\t\tif (!record.demoted) {","+\t\t\texchanges[record.cte.get()].records.push_back(record);","+\t\t}","+\t}","+\tif (exchanges.empty()) {","+\t\treturn nullptr;","+\t}","+\t// An exchange with a direct consumer creates a shared spool at the buffer high watermark instead of","+\t// throttling, so its producer never waits on the buffered consumers.","+\tfor (auto &entry : exchanges) {","+\t\tauto &cte = entry.first.get();","+\t\tD_ASSERT(cte.exchange);","+\t\tentry.second.has_direct = cte.exchange->GetConsumerSummary().direct > 0;","+\t}","+\tfor (auto &candidate : data.external_input_candidates) {","+\t\tif (!candidate.UsesExternalInput()) {","+\t\t\tcontinue;","+\t\t}","+\t\tauto entry = exchanges.find(candidate.cte.get());","+\t\tif (entry != exchanges.end()) {","+\t\t\tentry->second.has_direct = true;","+\t\t}","+\t}","+","+\tauto stage_count = schedule.stages.size();","+\t// The exchange a stage's pipeline produces into, if that exchange has active buffered consumers.","+\tauto producing_exchange = [&](const PipelineScheduleStage &stage) -> optional_ptr<ExchangeLiveness> {","+\t\tauto sink = stage.pipeline->GetSink();","+\t\tif (!sink || sink->type != PhysicalOperatorType::CTE) {","+\t\t\treturn nullptr;","+\t\t}","+\t\tauto entry = exchanges.find(sink->Cast<PhysicalCTE>());","+\t\tif (entry == exchanges.end()) {","+\t\t\treturn nullptr;","+\t\t}","+\t\treturn &entry->second;","+\t};","+\t// A consumer's execute only completes after its own producer finalized (the mirrored analysis edge), but for","+\t// liveness that wait resolves whenever the exchange itself is live, so it must not count as a gate. For two","+\t// ordered consumers of one exchange this exclusion is sound only together with the exchange's shared-spool","+\t// rule: with more than one active consumer the producer spools at the high watermark instead of throttling","+\t// (ShouldCreateSharedSpoolLocked), so the pinned later consumer cannot park the producer. Tightening that","+\t// spool rule would reintroduce an ordered-pair deadlock invisible to this analysis.","+\tauto is_own_producer_eof = [&](const PipelineScheduleStage &stage, idx_t dependency) {","+\t\tif (stage.type != PipelineScheduleStageType::EXECUTE) {","+\t\t\treturn false;","+\t\t}","+\t\tauto &target = schedule.stages[dependency];","+\t\tif (target.type != PipelineScheduleStageType::FINISH) {","+\t\t\treturn false;","+\t\t}","+\t\tfor (auto &dataflow : stage.pipeline->GetDataflowDependencies()) {","+\t\t\tauto producer = dataflow.lock();","+\t\t\tif (producer && RefersToSameObject(*producer, *target.pipeline)) {","+\t\t\t\treturn true;","+\t\t\t}","+\t\t}","+\t\treturn false;","+\t};","+\t// Index the execute stages once: the stage array is scanned repeatedly below.","+\treference_map_t<Pipeline, idx_t> execute_stages;","+\tvector<optional_ptr<ExchangeLiveness>> stage_producing_exchange(stage_count, nullptr);","+\tvector<pair<reference<ExchangeLiveness>, idx_t>> producer_execute_stages;","+\tfor (idx_t stage_idx = 0; stage_idx < stage_count; stage_idx++) {","+\t\tauto &stage = schedule.stages[stage_idx];","+\t\tif (stage.type != PipelineScheduleStageType::EXECUTE) {","+\t\t\tcontinue;","+\t\t}","+\t\texecute_stages.emplace(*stage.pipeline, stage_idx);","+\t\tauto exchange = producing_exchange(stage);","+\t\tstage_producing_exchange[stage_idx] = exchange;","+\t\tif (exchange) {","+\t\t\tproducer_execute_stages.emplace_back(*exchange, stage_idx);","+\t\t}","+\t}","+\tauto record_execute_stage = [&](const PipelineBufferedConsumerRecord &record) {","+\t\tauto entry = execute_stages.find(record.pipeline.get());","+\t\treturn entry == execute_stages.end() ? optional_idx() : optional_idx(entry->second);","+\t};","+","+\t// The exchange each active dataflow producer pipeline feeds, for resolving EOF waits.","+\treference_map_t<Pipeline, reference<ExchangeLiveness>> producer_pipeline_exchange;","+\tfor (auto &record : data.buffered_consumers) {","+\t\tif (record.demoted) {","+\t\t\tcontinue;","+\t\t}","+\t\tauto entry = exchanges.find(record.cte.get());","+\t\tD_ASSERT(entry != exchanges.end());","+\t\tproducer_pipeline_exchange.emplace(*record.cte_dependency, entry->second);","+\t}","+","+\tvector<bool> stage_live(stage_count, false);","+\t// An analysis dependency is the mirrored wait on a producer's finalization. It resolves only once the","+\t// producer's exchange can deliver EOF: exchange liveness alone proves the producer can run, not that it can","+\t// finish, because the producer may itself wait on another exchange's EOF. The finish stage's own liveness","+\t// must not be used either, since a dataflow consumer's execute is considered live without its EOF wait.","+\tauto dependencies_live = [&](const PipelineScheduleStage &stage) {","+\t\tfor (auto dependency : stage.dependencies) {","+\t\t\tif (!stage_live[dependency]) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\tfor (auto dependency : stage.analysis_dependencies) {","+\t\t\tif (is_own_producer_eof(stage, dependency)) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tauto target_exchange = producing_exchange(schedule.stages[dependency]);","+\t\t\tif (target_exchange) {","+\t\t\t\tif (!target_exchange->finishes) {","+\t\t\t\t\treturn false;","+\t\t\t\t}","+\t\t\t} else if (!stage_live[dependency]) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t};","+\t// The exchange's producers must be able to run: a live exchange with a producer that is itself gated would","+\t// wrongly resolve the finalization waits of its consumers. Ordering between the exchange's own producer","+\t// pipelines (a UNION's later branches wait on the base pipeline) resolves with the exchange itself and must","+\t// not count as a gate.","+\tauto producers_startable = [&](const ExchangeLiveness &exchange) {","+\t\tfor (auto 