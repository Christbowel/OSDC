mation; this may be done for security reasons.","@@ -126,6 +127,21 @@ public enum StreamReadFeature","      * implementation is used.","      */","     USE_FAST_DOUBLE_PARSER(true),","+","+    /**","+     * Feature that determines whether textual representation of a location","+     * includes a \"Source: REDACTED\" note when {@link #INCLUDE_SOURCE_IN_LOCATION}","+     * is disabled. If this feature is also disabled, the \"Source\" part is omitted","+     * altogether and only line/column/offset information is shown","+     * (for example {@code [line: 4, column: 18]}).","+     *<p>","+     * Has no effect if {@link #INCLUDE_SOURCE_IN_LOCATION} is enabled.","+     *<p>","+     * Feature is enabled by default.","+     *","+     * @since 3.4","+     */","+    INCLUDE_REDACTION_NOTE_IN_LOCATION(true),","     ;"," ","     /**"],"additions":17,"deletions":1,"truncated":false},{"path":"src/main/java/tools/jackson/core/TokenStreamLocation.java","lines":["@@ -246,9 +246,10 @@ public String toString()","         }","         final String srcDesc = sourceDescription();","         StringBuilder sb = new StringBuilder(40 + srcDesc.length())","-                .append(\"[Source: \")","-                .append(srcDesc)","-                .append(\"; \");","+                .append('[');","+        if (!srcDesc.isEmpty()) {","+            sb.append(\"Source: \").append(srcDesc).append(\"; \");","+        }","         return appendOffsetDescription(sb)","                 .append(']')","                 .toString();","@@ -259,9 +260,11 @@ public StringBuilder toString(StringBuilder sb)","         if (this == NA) {","             return sb.append(NO_LOCATION_DESC);","         }","-        sb.append(\"[Source: \")","-                .append(sourceDescription())","-                .append(\"; \");","+        final String srcDesc = sourceDescription();","+        sb.append('[');","+        if (!srcDesc.isEmpty()) {","+            sb.append(\"Source: \").append(srcDesc).append(\"; \");","+        }","         return appendOffsetDescription(sb)","                 .append(']');","     }"],"additions":9,"deletions":6,"truncated":false},{"path":"src/main/java/tools/jackson/core/base/ParserBase.java","lines":["@@ -1281,12 +1281,16 @@ protected ContentReference _contentReference() {","      * and source information is <b>NOT</b> to be included","      * ({@code StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION} disabled).","      *<p>","-     * Default implementation will simply return {@link ContentReference#redacted()}.","+     * Default implementation returns {@link ContentReference#redacted()}, or","+     * {@link ContentReference#redactedWithoutNote()} if","+     * {@link StreamReadFeature#INCLUDE_REDACTION_NOTE_IN_LOCATION} is disabled.","      *","      * @return ContentReference object to use when source is not to be included","      */","     protected ContentReference _contentReferenceRedacted() {","-        return ContentReference.redacted();","+        return isEnabled(StreamReadFeature.INCLUDE_REDACTION_NOTE_IN_LOCATION)","+                ? ContentReference.redacted()","+                : ContentReference.redactedWithoutNote();","     }"," ","     /* Helper method called by name-decoding methods that require storage"],"additions":6,"deletions":2,"truncated":false},{"path":"src/main/java/tools/jackson/core/io/ContentReference.java","lines":["@@ -41,6 +41,15 @@ public class ContentReference","     protected final static ContentReference REDACTED_CONTENT =","             new ContentReference(false, null, ErrorReportConfiguration.defaults());"," ","+    /**","+     * Variant of {@link #REDACTED_CONTENT} for which no source description","+     * (not even the \"REDACTED\" note) is included.","+     *","+     * @since 3.4","+     */","+    protected final static ContentReference REDACTED_CONTENT_NO_NOTE =","+            new ContentReference(false, null, ErrorReportConfiguration.defaults());","+","     /**","      * Reference to the actual underlying content.","      */","@@ -116,6 +125,19 @@ public static ContentReference redacted() {","         return REDACTED_CONTENT;","     }"," ","+    /**","+     * Variant of {@link #redacted()} whose source description is empty,","+     * so that no \"REDACTED\" note is included in location descriptions.","+     *","+     * @return Placeholder instance to use when reference is explicitly blocked","+     *   and its redaction is not to be noted","+     *","+     * @since 3.4","+     */","+    public static ContentReference redactedWithoutNote() {","+        return REDACTED_CONTENT_NO_NOTE;","+    }","+","     public static ContentReference construct(boolean isContentTextual, Object rawContent,","             int offset, int length, ErrorReportConfiguration errorReportConfiguration)","     {","@@ -231,6 +253,9 @@ public String buildSourceDescription() {","      */","     public StringBuilder appendSourceDescription(StringBuilder sb)","     {","+        if (this == REDACTED_CONTENT_NO_NOTE) {","+            return sb;","+        }","         final Object srcRef = getRawContent();"," ","         if (srcRef == null) {"],"additions":25,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/core/unittest/read/loc/SourceLocationNote1158Test.java","lines":["@@ -0,0 +1,118 @@","+package tools.jackson.core.unittest;","+","+import org.junit.jupiter.api.Test;","+","+import tools.jackson.core.*;","+import tools.jackson.core.exc.StreamReadException;","+import tools.jackson.core.io.ContentReference;","+import tools.jackson.core.json.JsonFactory;","+import tools.jackson.core.unittest.async.AsyncTestBase;","+import tools.jackson.core.unittest.testutil.AsyncReaderWrapper;","+","+import static org.junit.jupiter.api.Assertions.*;","+","+class SourceLocationNote1158Test extends AsyncTestBase","+{","+    private final JsonFactory FACTORY = JsonFactory.builder()","+            .disable(StreamReadFeature.INCLUDE_REDACTION_NOTE_IN_LOCATION)","+            .build();","+","+    @Test","+    void omitsRedactionNoteAcrossInputModes() throws Exception","+    {","+        for (int mode : ALL_MODES) {","+            try (JsonParser p = createParser(FACTORY, mode, \"[ ! ]\")) {","+                assertToken(JsonToken.START_ARRAY, p.nextToken());","+                _verifySuppressed(p.currentTokenLocation());","+                _verifySuppressed(p.currentLocation());","+                StreamReadException e = assertThrows(StreamReadException.class, p::nextToken);","+                _verifySuppressed(e.getLocation());","+                assertFalse(e.getMessage().contains(\"Source:\"));","+                assertTrue(e.getMessage().contains(e.getLocation().offsetDescription()));","+            }","+        }","+    }","+","+    @Test","+    void omitsRedactionNoteForAsyncParsers() throws Exception","+    {","+        for (int bytesPerRead : new int[] { 1, 3 }) {","+            try (AsyncReaderWrapper p = asyncForBytes(FACTORY, bytesPerRead,","+                    utf8Bytes(\"[ ! ]\"), 0)) {","+                assertToken(JsonToken.START_ARRAY, p.nextToken());","+                _verifySuppressed(assertThrows(StreamReadException.class, p::nextToken).getLocation());","+            }","+            try (AsyncReaderWrapper p = asyncForByteBuffer(FACTORY, bytesPerRead,","+                    utf8Bytes(\"[ ! ]\"), 0)) {","+                assertToken(JsonToken.START_ARRAY, p.nextToken());","+                _verifySuppressed(assertThrows(StreamReadException.class, p::nextToken).getLocation());","+            }","+        }","+    }","+","+    @Test","+    void configurationIsLocalToFactory() throws Exception","+    {","+        JsonFactory defaults = JsonFactory.builder().build();","+        JsonFactory restored = FACTORY.rebuild()","+                .enable(StreamReadFeature.INCLUDE_REDACTION_NOTE_IN_LOCATION).build();","+        for (JsonFactory f : new JsonFactory[] { defaults, FACTORY, restored, defaults }) {","+            try (JsonParser p = createParser(f, MODE_READER, \"[1]\")) {","+                assertToken(JsonToken.START_ARRAY, p.nextToken());","+                if (f == FACTORY) {","+                    _verifySuppressed(p.currentLocation());","+                } else {","+                    assertTrue(p.currentLocation().toString().contains(\"Source: REDACTED\"));","+                    assertNull(p.currentLocation().contentReference().getRawContent());","+                }","+            }","+        }","+    }","+","+    @Test","+    void explicitlyIncludedSourceStillShown() throws Exception","+    {","+        JsonFactory f = FACTORY.rebuild()","+                .enable(StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION).build();","+        String doc = \"[ ! ]\";","+        try (JsonParser p = f.createParser(ObjectReadContext.empty(), doc)) {","+            assertToken(JsonToken.START_ARRAY, p.nextToken());","+            StreamReadException e = assertThrows(StreamReadException.class, p::nextToken);","+            assertSame(doc, e.getLocation().contentReference().getRawContent());","+            assertTrue(e.getLocation().toString().contains(\"Source: (String)\"));","+            assertFalse(e.getLocation().toString().contains(\"REDACTED\"));","+        }","+    }","+","+    @Test","+    void preservesOffsetsAndStandaloneDescriptions() throws Exception","+    {","+        JsonFactory defaults = JsonFactory.builder().build();","+        for (int mode : ALL_MODES) {","+            try (JsonParser a = createParser(defaults, mode, \"\\n[1]\");","+                    JsonParser b = createParser(FACTORY, mode, \"\\n[1]\")) {","+                assertToken(JsonToken.START_ARRAY, a.nextToken());","+                assertToken(JsonToken.START_ARRAY, b.nextToken());","+                TokenStreamLocation expected = a.currentLocation();","+                TokenStreamLocation actual = b.currentLocation();","+                assertEquals(expected.getLineNr(), actual.getLineNr());","+                assertEquals(expected.getColumnNr(), actual.getColumnNr());","+                assertEquals(expected.getByteOffset(), actual.getByteOffset());","+                assertEquals(expected.getCharOffset(), actual.getCharOffset());","+                assertEquals(expected.offsetDescription(), actual.offsetDescription());","+            }","+        }","+        assertTrue(ContentReference.redacted().buildSourceDescription().startsWith(\"REDACTED\"));","+        assertEquals(\"UNKNOWN\", ContentReference.unknown().buildSourceDescription());","+        assertEquals(\"[No location information]\", TokenStreamLocation.NA.toString());","+    }","+","+    private void _verifySuppressed(TokenStreamLocation location)","+    {","+        assertNull(location.contentReference().getRawContent());","+        assertEquals(\"\", location.sourceDescription());","+        assertEquals(\"[\" + location.offsetDescription() + \"]\", location.toString());","+        assertEquals(\"prefix \" + location.toString(),","+                location.toString(new StringBuilder(\"prefix \")).toString());","+    }","+}",""],"additions":118,"deletions":0,"truncated":false}],"additions":187,"deletions":9,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-23T19:32:02.831185+00:00"}