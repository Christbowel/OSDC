one free().","+static char** PackCommandLine(int32_t count, const char* const* args, int32_t* argc)","+{","+    if (count < 0 || (size_t)count > SIZE_MAX / sizeof(char*))","+    {","+        return NULL;","+    }","+","+    size_t size = (size_t)count * sizeof(char*);","+    for (int32_t i = 0; i < count; i++)","+    {","+        size_t length = strlen(ReadArg(args, i)) + 1;","+        if (length > SIZE_MAX - size)","+        {","+            return NULL;","+        }","+","+        size += length;","+    }","+","+    char** result = (char**)malloc(size);","+    if (result == NULL)","+    {","+        return NULL;","+    }","+","+    // The arguments can also change length between the two loops, so bound each copy by the space","+    // left, keeping one byte for each remaining argument.","+    char* strings = (char*)(result + count);","+    char* end = (char*)result + size;","+    for (int32_t i = 0; i < count; i++)","+    {","+        const char* arg = ReadArg(args, i);","+        size_t length = strnlen(arg, (size_t)(end - strings) - (size_t)(count - i));","+        memcpy(strings, arg, length);","+        strings[length] = '\\0';","+        result[i] = strings;","+        strings += length + 1;","+    }","+","+    *argc = count;","+    return result;","+}","+#endif","+","+#if defined(__linux__) || defined(__sun) || defined(__FreeBSD__)","+// Packs into a single allocation up to maxCount arguments stored back to back as NUL-terminated","+// strings, so that it can be released with one free().","+static char** PackNulSeparatedCommandLine(const char* buffer, size_t length, int32_t maxCount, int32_t* argc)","+{","+    int32_t count = 0;","+    size_t used = 0;","+    while (used < length && count < maxCount)","+    {","+        const char* end = (const char*)memchr(buffer + used, '\\0', length - used);","+        used = end != NULL ? (size_t)(end - buffer) + 1 : length;","+        count++;","+    }","+","+    // count is at most used, which is at most length, so only the final size can overflow.","+    if ((size_t)count > (SIZE_MAX - used - 1) / sizeof(char*))","+    {","+        return NULL;","+    }","+","+    char** result = (char**)malloc((size_t)count * sizeof(char*) + used + 1);","+    if (result == NULL)","+    {","+        return NULL;","+    }","+","+    char* strings = (char*)(result + count);","+    memcpy(strings, buffer, used);","+    strings[used] = '\\0';","+","+    for (int32_t i = 0; i < count; i++)","+    {","+        result[i] = strings;","+        strings += strlen(strings) + 1;","+    }","+","+    *argc = count;","+    return result;","+}","+#endif","+","+#if defined(__FreeBSD__) || defined(__OpenBSD__)","+// Returns a malloc'ed buffer with the sysctl value, or NULL on failure.","+static char* ReadSysctl(int* mib, u_int mibLength, size_t* length)","+{","+    *length = 0;","+    if (sysctl(mib, mibLength, NULL, length, NULL, 0) != 0 || *length == 0)","+    {","+        return NULL;","+    }","+","+    char* buffer = (char*)malloc(*length);","+    if (buffer != NULL && sysctl(mib, mibLength, buffer, length, NULL, 0) != 0)","+    {","+        free(buffer);","+        buffer = NULL;","+    }","+","+    return buffer;","+}","+#endif","+","+#if defined(__HAIKU__)","+extern int __libc_argc;","+extern char** __libc_argv;","+#endif","+","+#if defined(__GLIBC__) || defined(TARGET_ANDROID)","+static int s_initArgc;","+static char** s_initArgv;","+","+// glibc and bionic pass argc, argv and envp to .init_array functions as a non-standard extension,","+// including for libraries loaded with dlopen. Other libcs, such as musl, pass no arguments.","+static void CaptureCommandLine(int argc, char** argv, char** envp)","+{","+    (void)envp;","+    s_initArgc = argc;","+    s_initArgv = argv;","+}","+","+__attribute__((section(\".init_array\"), used))","+static void (*const s_captureCommandLine)(int, char**, char**) = &CaptureCommandLine;","+#endif","+","+char** SystemNative_GetCommandLine(int32_t* argc)","+{","+    *argc = 0;","+","+#if defined(TARGET_BROWSER)","+    static const char* const browserArgs[] = { \"/\" }; // keep in sync with browserVirtualAppBase in minipal_getexepath","+    return PackCommandLine(1, browserArgs, argc);","+#elif defined(__linux__) || defined(__sun)","+#if defined(__GLIBC__) || defined(TARGET_ANDROID)","+    if (s_initArgv != NULL)","+    {","+        // Some command line parsers (e.g. GLib and Qt) move consumed arguments to the end of argv","+        // and replace them with NULL without updating argc.","+        int32_t count = 0;","+        while (count < s_initArgc && s_initArgv[count] != NULL)","+        {","+            count++;","+        }","+","+        return PackCommandLine(count, (const char* const*)s_initArgv, argc);","+    }","+#endif","+","+    int fd;","+#if HAVE_O_CLOEXEC","+    while ((fd = open(\"/proc/self/cmdline\", O_RDONLY | O_CLOEXEC)) < 0 && errno == EINTR);","+#else","+    while ((fd = open(\"/proc/self/cmdline\", O_RDONLY)) < 0 && errno == EINTR);","+#endif","+    if (fd < 0)","+    {","+        return NULL;","+    }","+","+#if !HAVE_O_CLOEXEC","+    fcntl(fd, F_SETFD, FD_CLOEXEC);","+#endif","+","+    size_t capacity = 4096;","+    size_t length = 0;","+    char* buffer = (char*)malloc(capacity);","+    while (buffer != NULL)","+    {","+        ssize_t bytesRead;","+        while ((bytesRead = read(fd, buffer + length, capacity - length)) < 0 && errno == EINTR);","+        if (bytesRead <= 0)","+        {","+            if (bytesRead < 0)","+            {","+                free(buffer);","+                buffer = NULL;","+            }","+            break;","+        }","+","+        length += (size_t)bytesRead;","+        if (length == capacity)","+        {","+            capacity *= 2;","+            char* newBuffer = (char*)realloc(buffer, capacity);","+            if (newBuffer == NULL)","+            {","+                free(buffer);","+            }","+            buffer = newBuffer;","+        }","+    }","+    close(fd);","+","+    if (buffer == NULL)","+    {","+        return NULL;","+    }","+","+    char** result = PackNulSeparatedCommandLine(buffer, length, INT32_MAX, argc);","+    free(buffer);","+    return result;","+#elif defined(__FreeBSD__)","+    int mib[] = { CTL_KERN, KERN_PROC, KERN_PROC_ARGS, getpid() };","+    size_t length;","+    char* buffer = ReadSysctl(mib, 4, &length);","+    if (buffer == NULL)","+    {","+        return NULL;","+    }","+","+    char** result = PackNulSeparatedCommandLine(buffer, length, INT32_MAX, argc);","+    free(buffer);","+    return result;","+#elif defined(__OpenBSD__)","+    int mib[] = { CTL_KERN, KERN_PROC_ARGS, getpid(), KERN_PROC_ARGV };","+    size_t length;","+    char* buffer = ReadSysctl(mib, 4, &length);","+    if (buffer == NULL)","+    {","+        return NULL;","+    }","+","+    // The buffer starts with a NULL-terminated argv array pointing into the rest of the buffer.","+    char** args = (char**)buffer;","+    int32_t count = 0;","+    while (args[count] != NULL)","+    {","+        count++;","+    }","+","+    char** result = PackCommandLine(count, (const char* const*)args, argc);","+    free(buffer);","+    return result;","+#elif defined(__APPLE__)","+    return PackCommandLine(*_NSGetArgc(), (const char* const*)*_NSGetArgv(), argc);","+#elif defined(__HAIKU__)","+    return PackCommandLine(__libc_argc, (const char* const*)__libc_argv, argc);","+#else","+    return NULL;","+#endif","+}"],"additions":279,"deletions":0,"truncated":false},{"path":"src/native/libs/System.Native/pal_process.h","lines":["@@ -243,3 +243,10 @@ PALEXPORT int32_t SystemNative_SchedGetAffinity(int32_t pid, intptr_t* mask);","  * resolving symbolic links. The caller is responsible for releasing the buffer.","  */"," PALEXPORT char* SystemNative_GetProcessPath(void);","+","+/**","+ * Returns the command line arguments of the current process as an array of argc strings,","+ * or NULL if they cannot be obtained. The array and the strings