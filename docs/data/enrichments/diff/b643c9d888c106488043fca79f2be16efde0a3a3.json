re_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 7168))  # large","+    asserts.equals(env, \"high_mem_2core_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 14336))  # enormous"," ","-    # Memory constraint drives selection beyond the base pool.","-    asserts.equals(env, \"large_mem_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 1, 4096))  # 4 GB","-    asserts.equals(env, \"large_mem_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 1, 7168))  # 7 GB","-    asserts.equals(env, \"high_mem_2core_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 2, 14336))  # 14 GB","+    # Anything in between rounds up to the next tier.","+    asserts.equals(env, \"x86_64\", testonly_helpers.choose_pool(POOLS_X86, 0))","+    asserts.equals(env, \"large_mem_2core_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 4096))  # 4 GB"," ","-    # Both constraints must be satisfied simultaneously.","-    asserts.equals(env, \"large_mem_2core_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 2, 7168))","+    # Memory beyond every pool caps to the largest pool.","+    asserts.equals(env, \"high_mem_2core_x86_64\", testonly_helpers.choose_pool(POOLS_X86, 28672))  # 28 GB"," ","     return unittest.end(env)"," ","@@ -62,11 +41,15 @@ _choose_pool_x86_test = unittest.make(_choose_pool_x86_test_impl)"," def _choose_pool_arm_test_impl(ctx):","     env = unittest.begin(ctx)"," ","-    asserts.equals(env, \"default\", testonly_helpers.choose_pool(POOLS_ARM, 1, 0))","-    asserts.equals(env, \"large_memory_2core_arm64\", testonly_helpers.choose_pool(POOLS_ARM, 2, 0))","-    asserts.equals(env, \"large_memory_arm64\", testonly_helpers.choose_pool(POOLS_ARM, 1, 7168))  # 7 GB","-    asserts.equals(env, \"high_mem_2core_arm64\", testonly_helpers.choose_pool(POOLS_ARM, 2, 14336))  # 14 GB","-    asserts.equals(env, \"large_memory_2core_arm64\", testonly_helpers.choose_pool(POOLS_ARM, 2, 7168))","+    asserts.equals(env, \"test_runner_arm64_1core\", testonly_helpers.choose_pool(POOLS_ARM, 3584))  