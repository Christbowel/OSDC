 JOIN with USING passes up the hidden columns of its inputs","+SELECT l.lts, d.k","+FROM using_left l ASOF JOIN (using_right r LEFT JOIN using_keys d USING (k))","+  MATCH_CONDITION (l.lts >= r.rts) USING (k);","+","+-- FVT-ASOF-2-044: a qualified star reads a hidden column from below an ASOF JOIN with USING","+SELECT d.*","+FROM using_left l ASOF JOIN (using_right r LEFT JOIN using_keys d USING (k))","+  MATCH_CONDITION (l.lts >= r.rts) USING (k);","+","+-- FVT-ASOF-2-045: a hidden column from below an ASOF JOIN with USING is a MATCH_CONDITION operand","+SELECT l.lts, x.k","+FROM (using_left l ASOF JOIN (using_right r LEFT JOIN using_keys d USING (k))","+        MATCH_CONDITION (l.lts >= r.rts) USING (k))","+  ASOF JOIN (VALUES (1), (2)) AS x(k) MATCH_CONDITION (d.k >= x.k);","+","+-- FVT-ASOF-2-046: a hidden MATCH_CONDITION column whose table is also on the other side","+SELECT d.k, x.k","+FROM (using_right r LEFT JOIN using_keys d USING (k))","+  ASOF JOIN using_keys x MATCH_CONDITION (d.k >= x.k);","+","+-- FVT-ASOF-2-047: same as FVT-ASOF-2-045, with the hidden column's table also on the other side","+SELECT l.lts, x.k","+FROM (using_left l ASOF JOIN (using_right r LEFT JOIN using_keys d USING (k))","+        MATCH_CONDITION (l.lts >= r.rts) USING (k))","+  ASOF JOIN using_keys x MATCH_CONDITION (d.k >= x.k);","+","+-- FVT-ASOF-2-048: a JOIN above an ASOF JOIN with USING joins on a hidden column of its inputs","+SELECT l.lts, x.k","+FROM (using_left l ASOF JOIN (using_right r LEFT JOIN using_keys d USING (k))","+        MATCH_CONDITION (l.lts >= r.rts) USING (k))","+  JOIN (VALUES (1), (2), (8)) AS x(k) ON d.k = x.k;","+","+-- FVT-ASOF-2-049: a LEFT ASOF JOIN with USING makes a NOT NULL hidden column of its inputs nullable","+SELECT l.lts, d.k","+FROM using_left l LEFT ASOF JOIN (using_right r JOIN using_keys d USING (k))","+  MATCH_CONDITION (l.lts >= r.rts) USING (k);","+","+-- FVT-ASOF-2-050: same as FVT-ASOF-2-046, with the hidden column on the right side. 