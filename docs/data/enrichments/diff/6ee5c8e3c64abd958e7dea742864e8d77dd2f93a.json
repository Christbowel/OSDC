        return $this->decode($json);","+        } catch (JsonBoundExceededException $exception) {","+            throw $exception;","+        } catch (InvalidArgumentException $exception) {","+            throw new UnrecognizedSerializationException(","+                $exception->getMessage(),","+                $exception->getCode(),","+                $exception->getPrevious()","+            );","+        }","+    }","+","     /**","      * Whether a document given to this decoder was rejected for its depth.","      */"],"additions":24,"deletions":0,"truncated":false},{"path":"src/Library/Encryption/Serializer/CompactSerializer.php","lines":["@@ -6,6 +6,7 @@"," "," use Jose\\Component\\Core\\Exception\\InvalidSerializationException;"," use Jose\\Component\\Core\\Exception\\LogicException;","+use Jose\\Component\\Core\\Exception\\UnrecognizedSerializationException;"," use Jose\\Component\\Core\\Util\\Base64UrlSafe;"," use Jose\\Component\\Core\\Util\\BoundedJsonDecoder;"," use Jose\\Component\\Encryption\\JWE;","@@ -14,6 +15,7 @@"," use Throwable;"," use function count;"," use function is_array;","+use function preg_match;"," use function sprintf;"," "," final readonly class CompactSerializer implements JWESerializer","@@ -66,7 +68,7 @@ public function unserialize(string $input): JWE","     {","         $parts = explode('.', $input, 6);","         if (count($parts) !== 5) {","-            throw new InvalidSerializationException('Unsupported input');","+            throw new UnrecognizedSerializationException('Unsupported input');","         }"," ","         $decoder = new BoundedJsonDecoder();","@@ -94,6 +96,9 @@ public function unserialize(string $input): JWE","                 [new Recipient([], $encryptedKey)]","             );","         } catch (Throwable $throwable) {","+            if (preg_match('/^[A-Za-z0-9_-]*\\z/', $parts[0]) !== 1) {","+                throw new UnrecognizedSerializationException('Unsupported input', $throwable->getCode(), $throwable)