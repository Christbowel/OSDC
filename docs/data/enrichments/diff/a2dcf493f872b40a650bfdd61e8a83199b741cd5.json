/apiserver/pkg/apis/cel\""," \t\"k8s.io/apiserver/pkg/authorization/authorizer\""," \tauthorizationcel \"k8s.io/apiserver/pkg/authorization/cel\"","+\tgenericfeatures \"k8s.io/apiserver/pkg/features\""," \tutilfeature \"k8s.io/apiserver/pkg/util/feature\""," \tversionedinformers \"k8s.io/client-go/informers\""," \tcertinformersv1 \"k8s.io/client-go/informers/certificates/v1\"","+\t\"k8s.io/client-go/kubernetes\""," \t\"k8s.io/kubernetes/pkg/auth/authorizer/abac\""," \t\"k8s.io/kubernetes/pkg/auth/nodeidentifier\""," \t\"k8s.io/kubernetes/pkg/features\"","@@ -59,6 +63,7 @@ type Config struct {"," \tWebhookRetryBackoff *wait.Backoff"," "," \tVersionedInformerFactory versionedinformers.SharedInformerFactory","+\tKubeClient               kubernetes.Interface"," "," \t// Optional field, custom dial function used to connect to webhook"," \tCustomDial utilnet.DialFunc","@@ -92,6 +97,19 @@ func (config Config) New(ctx context.Context, serverID string) (authorizer.Autho"," \t\tcompiler:         authorizationcel.NewDefaultCompiler(),"," \t}"," ","+\tif utilfeature.DefaultFeatureGate.Enabled(genericfeatures.ConditionalAuthorization) {","+\t\tvar err error","+\t\tr.builtinConditionsEvaluatorBuilder, err = plugincel.NewAuthorizationConditionsEvaluatorBuilder(","+\t\t\tconfig.VersionedInformerFactory,","+\t\t\tconfig.KubeClient,","+\t\t\tr,","+\t\t\tapiscel.RuntimeCELCostBudget,","+\t\t)","+\t\tif err != nil {","+\t\t\treturn nil, nil, fmt.Errorf(\"failed to construct in-process CEL authorization conditions evaluator, conditions will be evaluated by the webhook: %w\", err)","+\t\t}","+\t}","+"," \tseenTypes := sets.New[authzconfig.AuthorizerType]()"," "," \t// Build and store authorizers which will persist across reloads"],"additions":18,"deletions":0,"truncated":false},{"path":"pkg/kubeapiserver/options/authorization.go","lines":["@@ -22,6 +22,7 @@ import ("," \t\"time\""," "," \tauthorizationcel \"k8s.io/apiserver/pkg/authorization/cel\"","+\t\"k8s.io/client-go/kubernetes\""," "," \t\"github.com/spf13/pflag\""," ","@@ -205,7 +206,7 @@ func (o *BuiltInAuthorizationOptions) AddFlags(fs *pflag.FlagSet) {"," }"," "," // ToAuthorizationConfig convert BuiltInAuthorizationOptions to authorizer.Config","-func (o *BuiltInAuthorizationOptions) ToAuthorizationConfig(versionedInformerFactory versionedinformers.SharedInformerFactory) (*authorizer.Config, error) {","+func (o *BuiltInAuthorizationOptions) ToAuthorizationConfig(versionedInformerFactory versionedinformers.SharedInformerFactory, client kubernetes.Interface) (*authorizer.Config, error) {"," \tif o == nil {"," \t\treturn nil, nil"," \t}","@@ -241,6 +242,7 @@ func (o *BuiltInAuthorizationOptions) ToAuthorizationConfig(versionedInformerFac"," \treturn &authorizer.Config{"," \t\tPolicyFile:               o.PolicyFile,"," \t\tVersionedInformerFactory: versionedInformerFactory,","+\t\tKubeClient:               client,"," \t\tWebhookRetryBackoff:      o.WebhookRetryBackoff,"," "," \t\tReloadFile:                            o.AuthorizationConfigurationFile,"],"additions":3,"deletions":1,"truncated":false},{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/authorizer/conditionsenforcer/conditionsenforcer.go","lines":["@@ -103,6 +103,8 @@ func (c *conditionsEnforcer) Validate(ctx context.Context, a admission.Attribute"," \t\treturn apierrors.NewInternalError(fmt.Errorf(\"did not expect decision %s to be attached to the RequestInfo context, only Allow or conditional allow\", possiblyConditionalDecision.String()))"," \t}"," ","+\t// TODO(luxas): Right now k8s.io/apiserver/pkg/admission/plugin/cel/authorization_conditions.go depends on VersionedAttributes being passed","+\t// as the ConditionsData. Keep doing this, but fix the direct dependency."," \tversionedAttributes, err := admission.NewVersionedAttributes(a, a.GetKind(), o)"," \tif err != nil {"," \t\treturn fmt.Errorf(\"failed to convert objects to request version: %w\", err)"],"additions":2,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/authorization_conditions.go","lines":["@@ -0,0 +1,216 @@","+/*","+Copyright The Kubernetes Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package cel","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"strings\"","+","+\tcelgo \"cel.dev/cel-go/cel\"","+\tceltypes \"cel.dev/cel-go/common/types\"","+\tv1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apiserver/pkg/admission\"","+\tadmissionauthorizer \"k8s.io/apiserver/pkg/admission/plugin/authorizer\"","+\tnamespacematcher \"k8s.io/apiserver/pkg/admission/plugin/webhook/predicates/namespace\"","+\t\"k8s.io/apiserver/pkg/authorization/authorizer\"","+\tapiservercel \"k8s.io/apiserver/pkg/cel\"","+\t\"k8s.io/apiserver/pkg/cel/environment\"","+\t\"k8s.io/client-go/informers\"","+\t\"k8s.io/client-go/kubernetes\"","+)","+","+// NewAuthorizationConditionsEvaluatorBuilder creates a new authorizer.BuiltinConditionsEvaluatorBuilder that can evaluate","+// authorizer.ConditionTypeAuthorizationCEL-typed conditions.","+//","+// apiServerAuthorizer is required, but can be set to nil initially, and then be lazily initialized through the SetAuthorizer function.","+// Only unconditional authorization is supported for compound authorization checks.","+//","+// The builder and the evaluators it builds are not safe for concurrent use.","+//","+// runtimeCELCostBudget is shared by all conditions evaluated by one evaluator from EvaluatorForData, like the","+// per-binding budget of ValidatingAdmissionPolicy.","+// runtimeCELCostBudget was added for testing purpose only. Callers should always use const RuntimeCELCostBudget from k8s.io/apiserver/pkg/apis/cel/config.go as input.","+//","+// Note: the cel compiler construction depends on feature gates and the compatibility version to be initialized.","+func NewAuthorizationConditionsEvaluatorBuilder(informerFactory informers.SharedInformerFactory, client kubernetes.Interface, apiServerAuthorizer authorizer.UnconditionalAuthorizer, runtimeCELCostBudget int64) (*AuthorizationConditionsEvaluatorBuilder, error) {","+\tif informerFactory == nil {","+\t\treturn nil, fmt.Errorf(\"NewAuthorizationConditionsEvaluator: informerFactory is required\")","+\t}","+\tif client == nil {","+\t\treturn nil, fmt.Errorf(\"NewAuthorizationConditionsEvaluator: client is required\")","+\t}","+","+\tb := &AuthorizationConditionsEvaluatorBuilder{","+\t\tcompiler: NewCompiler(environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())),","+\t\tnsmatcher: &namespacematcher.Matcher{","+\t\t\tNamespaceLister: informerFactory.Core().V1().Namespaces().Lister(),","+\t\t\tClient:          client,","+\t\t},","+\t\truntimeCELCostBudget: runtimeCELCostBudget,","+\t}","+\tb.SetAuthorizer(apiServerAuthorizer)","+\treturn b, nil","+}","+","+var _ authorizer.BuiltinConditionsEvaluatorBuilder = &AuthorizationConditionsEvaluatorBuilder{}","+","+type AuthorizationConditionsEvaluatorBuilder struct {","+\tcompiler             Compiler","+\tnsmatcher            *namespacematcher.Matcher","+\tapiServerAuthorizer  authorizer.UnconditionalAuthorizer","+\truntimeCELCostBudget int64","+}","+","+// SetAuthorizer updates the authorizer that is used by subsequent EvaluatorForData calls.","+// Until it is set to a non-nil authorizer, EvaluatorForData fails.","+func (b *AuthorizationConditionsEvaluatorBuilder) SetAuthorizer(apiServerAuthorizer authorizer.UnconditionalAuthorizer) {","+\tb.apiServerAuthorizer = apiServerAuthorizer","+}","+","+// Recognizes returns true for non-empty conditions of type authorizer.ConditionTypeAuthorizationCEL.","+// It's generally valid for condition strings to be empty, if the semantics of the condition is","+// clear from its (required) ID. However, the CEL evaluator cannot evaluate empty condition strings.","+func (b *AuthorizationConditionsEvaluatorBuilder) Recognizes(condition authorizer.Condition) bool {","+\treturn condition.GetType() == authorizer.ConditionTypeAuthorizationCEL && len(strings.TrimSpace(condition.GetCondition())) != 0","+}","+","+func (b *AuthorizationConditionsEvaluatorBuilder) EvaluatorForData(ctx context.Context, data authorizer.ConditionsData) (authorizer.BuiltinConditionsEvaluator, error) {","+\tif data == nil {","+\t\treturn nil, fmt.Errorf(\"programmer error: data is required\")","+\t}","+","+\tapiServerAuthorizer := b.apiServerAuthorizer","+\tif apiServerAuthorizer == nil {","+\t\treturn nil, fmt.Errorf(\"AuthorizationConditionsEvaluatorBuilder hasn't yet been initialized with SetAuthorizer\")","+\t}","+","+\t// TODO(luxas): We know the AuthorizationConditionsEnforcer plugin provides this struct for now, and thus it works.","+\t// However, follow up on lazily calling NewVersionedAttributes, when NewVersionedAttributes and ConvertToGVK accept","+\t// a smaller interface than ObjectInterfaces, such that we could construct a no-op converter at this layer and pass it.","+\tversionedAttrs, ok := data.(*admission.VersionedAttributes)","+\tif !ok {","+\t\treturn nil, fmt.Errorf(\"in-process conditions evaluation only supported when data is of type *admission.VersionedAttributes\")","+\t}","+","+\tadmissionRequest := CreateAdmissionRequest(versionedAttrs, metav1.GroupVersionResource(versionedAttrs.GetResource()), metav1.GroupVersionKind(versionedAttrs.GetKind()))","+","+\tns, err := b.getNamespace(ctx, versionedAttrs)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\t// Like ValidatingAdmissionPolicy, cache authorizer checks for the duration of the request, so that multiple","+\t// conditions doing the same check get a consistent answer and don't each run the whole authorizer chain.","+\tauthz := admissionauthorizer.NewCachingAuthorizer(apiServerAuthorizer)","+\tvarBindings := OptionalVariableBindings{VersionedParams: nil, Authorizer: authz}","+","+\t// we don't support VAP variables, so no compositionCtx is passed, it is anyways optional","+\tactivation, err := newActivation(nil, versionedAttrs, admissionRequest, varBindings, ns, useSchemalessTypeRef())","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\treturn &celAuthorizationConditionsEvaluator{","+\t\tbuilder:           b,","+\t\tactivation:        activation,","+\t\toptionalVarsDecls: OptionalVariableDeclarations{HasParams: false, HasAuthorizer: true},","+\t\tremainingBudget:   b.runtimeCELCostBudget,","+\t}, nil","+}","+","+// getNamespace exactly mirrors the similar logic in VAP","+// TODO(luxas): Try to de-duplicate this with VAP.","+func (b *AuthorizationConditionsEvaluatorBuilder) getNamespace(ctx context.Context, attrs admission.Attributes) (*v1.Namespace, error) {","+\tvar namespace *v1.Namespace","+\tvar err error","+\tnamespaceName := attrs.GetNamespace()","+","+\t// Special case, the namespace object has the namespace of itself (maybe a bug).","+\t// unset it if the incoming object is a namespace","+\tif gvk := attrs.GetKind(); gvk.Kind == \"Namespace\" && gvk.Version == \"v1\" && gvk.Group == \"\" {","+\t\tnamespaceName = \"\"","+\t}","+","+\t// if it is cluster scoped, namespaceName will be empty","+\t// Otherwise, get the Namespace resource.","+\tif namespaceName != \"\" {","+\t\tnamespace, err = b.nsmatcher.GetNamespace(ctx, namespaceName)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t}","+","+\treturn CreateNamespaceObject(namespace), nil","+}","+","+var _ authorizer.BuiltinConditionsEvaluator = &celAuthorizationConditionsEvaluator{}","+","+// celAuthorizationConditionsEvaluator is not safe for concurrent use, as k8s.io/apiserver/pkg/cel/common.SchemalessTypedToVal","+// and admissionauthorizer.NewCachingAuthorizer are not.","+// TODO(luxas): If we can, it'd be nice to be able to make them safe for concurrent use in the future, so we can be concurrent here.","+// At the very minimum, we'd like to be able to parallelize the compilation of the conditions, even if evaluation would have","+// to stay sequential. That'd probably need some slight modifications to this interface though, and is thus postponed.","+type celAuthorizationConditionsEvaluator struct {","+\tbuilder           *AuthorizationConditionsEvaluatorBuilder","+\toptionalVarsDecls OptionalVariableDeclarations","+\tactivation        *evaluationActivation","+\t// remainingBudget is negative once the budget has been exhausted.","+\tremainingBudget int64","+}","+","+func (e *celAuthorizationConditionsEvaluator) EvaluateCondition(ctx context.Context, condition authorizer.Condition) authorizer.ConditionEvaluationResult {","+\tif !e.builder.Recognizes(condition) {","+\t\treturn authorizer.ConditionsEvaluationResultUnevaluatable()","+\t}","+","+\t// Like ValidatingAdmissionPolicy, don't evaluate further expressions once the budget is exhausted.","+\tif e.remainingBudget < 0 {","+\t\treturn authorizer.ConditionEvaluationResultError(&apiservercel.Error{","+\t\t\tType:   apiservercel.ErrorTypeInvalid,","+\t\t\tDetail: \"validation failed due to running out of cost budget, no further validation rules will be run\",","+\t\t\tCause:  apiservercel.ErrOutOfBudget,","+\t\t})","+\t}","+","+\t// TODO(luxas): Add metrics for request-aggregated authorization condition compile and evaluation (both separately).","+\tcompiledExpr := e.builder.compiler.CompileCELExpression(validationCondition(condition.GetCondition()), e.optionalVarsDecls, environment.StoredExpressions)","+","+\t// we don't support VAP variables, so no compositionCtx is passed, it is anyways optional","+\tevalResult, remainingBudget, err := e.activation.Evaluate(ctx, nil, compiledExpr, e.remainingBudget)","+\te.remainingBudget = remainingBudget","+\tif err != nil {","+\t\treturn authorizer.ConditionEvaluationResultError(err)","+\t}","+","+\tif evalResult.Error != nil {","+\t\treturn authorizer.ConditionEvaluationResultError(evalResult.Error)","+\t}","+","+\treturn authorizer.ConditionEvaluationResultBoolean(evalResult.EvalResult == celtypes.True)","+}","+","+type validationCondition string","+","+func (v validationCondition) GetExpression() string {","+\treturn string(v)","+}","+","+func (v validationCondition) ReturnTypes() []*celgo.Type {","+\treturn []*celgo.Type{celgo.BoolType}","+}"],"additions":216,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/authorization_conditions_test.go","lines":["@@ -0,0 +1,416 @@","+/*","+Copyright The Kubernetes Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package cel","+","+import (","+\t\"errors\"","+\t\"testing\"","+","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\t\"k8s.io/apiserver/pkg/admission\"","+\tcelconfig \"k8s.io/apiserver/pkg/apis/cel\"","+\t\"k8s.io/apiserver/pkg/authorization/authorizer\"","+\t\"k8s.io/apiserver/pkg/authorization/authorizerfactory\"","+\tapiservercel \"k8s.io/apiserver/pkg/cel\"","+\t\"k8s.io/client-go/informers\"","+\t\"k8s.io/client-go/kubernetes/fake\"","+)","+","+var (","+\tpodGVK = schema.GroupVersionKind{Group: \"\", Version: \"v1\", Kind: \"Pod\"}","+\tpodGVR = schema.GroupVersionResource{Group: \"\", Version: \"v1\", Resource: \"pods\"}","+)","+","+var defaultNamespace = &corev1.Namespace{","+\tObjectMeta: metav1.ObjectMeta{Name: \"default\", Labels: map[string]string{\"env\": \"prod\"}},","+}","+","+// newTestAuthorizationConditionsEvaluatorBuilder serves namespaces from the fake client, as","+// the informers are never started and the namespace matcher falls back to a live GET.","+func newTestAuthorizationConditionsEvaluatorBuilder(t *testing.T, budget int64, authz authorizer.UnconditionalAuthorizer, namespaces ...runtime.Object) authorizer.BuiltinConditionsEvaluatorBuilder {","+\tt.Helper()","+\tclient := fake.NewClientset(namespaces...)","+\tb, err := NewAuthorizationConditionsEvaluatorBuilder(informers.NewSharedInformerFactory(client, 0), client, authz, budget)","+\tif err != nil {","+\t\tt.Fatalf(\"NewAuthorizationConditionsEvaluatorBuilder failed: %v\", err)","+\t}","+\treturn b","+}","+","+func versioned(t *testing.T, attrs admission.Attributes) *admission.VersionedAttributes {","+\tt.Helper()","+\t// The test objects are already in the requested GVK, so no ObjectInterfaces are needed for conversion.","+\tva, err := admission.NewVersionedAttributes(attrs, attrs.GetKind(), nil)","+\tif err != nil {","+\t\tt.Fatalf(\"NewVersionedAttributes failed: %v\", err)","+\t}","+\treturn va","+}","+","+// evalResultString converts a ConditionEvaluationResult to a human-readable string","+// for use in test assertions.","+func evalResultString(r authorizer.ConditionEvaluationResult) string {","+\tswitch {","+\tcase r.IsUnevaluatable():","+\t\treturn \"Unevaluatable\"","+\tcase r.IsTrue():","+\t\treturn \"True\"","+\tcase r.IsFalse():","+\t\treturn \"False\"","+\tcase r.IsError():","+\t\treturn \"Error\"","+\tdefault:","+\t\treturn \"Unknown\"","+\t}","+}","+","+func podCreateAttributes() admission.Attributes {","+\tobject := &corev1.Pod{","+\t\tTypeMeta: metav1.TypeMeta{Kind: \"Pod\", APIVersion: \"v1\"},","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      \"test-pod\",","+\t\t\tNamespace: \"default\",","+\t\t\tLabels:    map[string]string{\"app\": \"web\"},","+\t\t},","+\t\tSpec: corev1.PodSpec{","+\t\t\tNodeName: \"node1\",","+\t\t},","+\t}","+\treturn admission.NewAttributesRecord(object, nil, podGVK, \"default\", \"test-pod\", podGVR, \"\", admission.Create, &metav1.CreateOptions{}, false, nil)","+}","+","+func podUpdateAttributes() admission.Attributes {","+\toldObject := &corev1.Pod{","+\t\tTypeMeta: metav1.TypeMeta{Kind: \"Pod\", APIVersion: \"v1\"},","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      \"test-pod\",","+\t\t\tNamespace: \"default\",","+\t\t\tLabels:    map[string]string{\"app\": \"web\"},","+\t\t},","+\t\tSpec: corev1.PodSpec{","+\t\t\tNodeName: \"node1\",","+\t\t},","+\t}","+\tnewObject := &corev1.Pod{","+\t\tTypeMeta: metav1.TypeMeta{Kind: \"Pod\", APIVersion: \"v1\"},","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      \"test-pod\",","+\t\t\tNamespace: \"default\",","+\t\t\tLabels:    map[string]string{\"app\": \"web\", \"version\": \"v2\"},","+\t\t},","+\t\tSpec: corev1.PodSpec{","+\t\t\tNodeName: \"node2\",","+\t\t},","+\t}","+\treturn admission.NewAttributesRecord(newObject, oldObject, podGVK, \"default\", \"test-pod\", podGVR, \"\", admission.Update, &metav1.UpdateOptions{}, false, nil)","+}","+","+// celCond creates a CEL-typed condition for use in tests.","+func celCond(id, expr string) authorizer.GenericCondition {","+\treturn authorizer.GenericCondition{","+\t\tID:        id,","+\t\tType:      authorizer.ConditionTypeAuthorizationCEL,","+\t\tCondition: expr,","+\t}","+}","+","+// TestAuthorizationConditionsEvaluator_EvaluateCondition tests the EvaluateCondition","+// method in a table-driven fashion, covering all skip/unevaluatable cases, successful","+// condition evaluations, and error cases.","+func TestAuthorizationConditionsEvaluator_EvaluateCondition(t *testing.T) {","+\ttests := []struct {","+\t\tname       string","+\t\tcondition  authorizer.Condition","+\t\tattrs      admission.Attributes","+\t\tauthz      authorizer.Authorizer","+\t\tcostBudget int64","+\t\twantResult string // \"True\", \"False\", \"Error\", \"Unevaluatable\"","+\t}{","+\t\t// --- Skip / Unevaluatable cases ---","+\t\t{","+\t\t\tname: \"wrong condition type returns Unevaluatable\",","+\t\t\tcondition: authorizer.GenericCondition{","+\t\t\t\tType:      \"some.io/unsupported-type\",","+\t\t\t\tCondition: \"true\",","+\t\t\t},","+\t\t\tattrs:      podCreateAttributes(),","+\t\t\twantResult: \"Unevaluatable\",","+\t\t},","+\t\t{","+\t\t\tname: \"empty condition string returns Unevaluatable\",","+\t\t\tcondition: authorizer.GenericCondition{","+\t\t\t\tType:      authorizer.ConditionTypeAuthorizationCEL,","+\t\t\t\tCondition: \" \",","+\t\t\t},","+\t\t\tattrs:      podCreateAttributes(),","+\t\t\twantResult: \"Unevaluatable\",","+\t\t},","+","+\t\t// --- True evaluations ---","+\t\t{","+\t\t\tname:       \"allow condition: labels.app == 'web' (true)\",","+\t\t\tcondition:  celCond(\"c\", \"'app' in object.metadata.labels && object.metadata.labels.app == 'web'\"),","+\t\t\tattrs:      podCreateAttributes(),","+\t\t\twantResult: \"True\",","+\t\t},","+\t\t{","+\t\t\tname:       \"deny condition: has(object.metadata.labels.app) (true)\",","+\t\t\tcondition:  celCond(\"c\", \"has(object.metadata.labels.app)\"),","+\t\t\tattrs:      podCreateAttributes(),","+\t\t\twantResult: \"True\",","+\t\t},","+\t\t{","+\t\t\tname:       \"request.kind.kind == 'Pod' (true)\",","+\t\t\tcondition:  celCond(\"c\", \"request.kind.kind == 'Pod'\"),","+\t\t\tattrs:      podCreateAttributes(),","+\t\t\twantResult: \"True\",","+\t\t},","+\t\t{","+\t\t\tname:       \"request.namespace == 'default' (true)\",","+\t\t\tcondition:  celCond(\"c\", \"request.namespace == 'defaul