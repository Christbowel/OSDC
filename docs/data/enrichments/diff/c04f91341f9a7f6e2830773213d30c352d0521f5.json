{"id":"c04f91341f9a7f6e2830773213d30c352d0521f5","axis":"silent","repo":"hashicorp/consul","sha":"c04f91341f9a7f6e2830773213d30c352d0521f5","parsed":{"files":[{"path":".changelog/23900.txt","lines":["@@ -0,0 +1,3 @@","+```release-note:security","+xds: escape regex metacharacters in service name, namespace, partition, and trust domain values when building Envoy RBAC SPIFFE match patterns, preventing an intention/authorization bypass via regex injection.","+```"],"additions":3,"deletions":0,"truncated":false},{"path":"agent/xds/rbac.go","lines":["@@ -5,6 +5,7 @@ package xds"," "," import ("," \t\"fmt\"","+\t\"regexp\""," \t\"sort\""," \t\"strings\""," ","@@ -1153,6 +1154,21 @@ func makeSpiffePattern(src rbacService) string {"," \t\thost = src.TrustDomain"," \t}"," ","+\t// Escape regex metacharacters in user-controlled values so they are matched","+\t// literally. Service names, namespaces, and partitions may legitimately","+\t// contain characters such as '.', '|', or '+' which would otherwise be","+\t// interpreted as regex operators and could broaden the RBAC match beyond the","+\t// intended identity, bypassing intention enforcement. The anyPath ('[^/]+')","+\t// values are intentional regex wildcards and must not be escaped.","+\tif ns != anyPath {","+\t\tns = regexp.QuoteMeta(ns)","+\t}","+\tif svc != anyPath {","+\t\tsvc = regexp.QuoteMeta(svc)","+\t}","+\tap = regexp.QuoteMeta(ap)","+\thost = regexp.QuoteMeta(host)","+"," \tid := connect.SpiffeIDService{"," \t\tNamespace: ns,"," \t\tService:   svc,","@@ -1170,8 +1186,10 @@ func makeSpiffePattern(src rbacService) string {"," "," func makeSpiffeMeshGatewayPattern(gwTrustDomain, gwPartition string) string {"," \tid := connect.SpiffeIDMeshGateway{","-\t\tHost:      gwTrustDomain,","-\t\tPartition: gwPartition,","+\t\t// Escape regex metacharacters so user-controlled values are matched","+\t\t// literally rather than being interpreted as regex operators.","+\t\tHost:      regexp.QuoteMeta(gwTrustDomain),","+\t\tPartition: regexp.QuoteMeta(gwPartition),"," \t\t// Datacenter is not verified by RBAC, so we match on any value."," \t\tDatacenter: anyPath,"," \t}"],"additions":20,"deletions":2,"truncated":false},{"path":"agent/xds/rbac_test.go","lines":["@@ -1310,3 +1310,82 @@ func TestJWTClaimsToPrincipals(t *testing.T) {"," \t\t})"," \t}"," }","+","+// TestMakeSpiffePattern_EscapesRegexMetacharacters verifies that regex","+// metacharacters in the source service name and trust domain are escaped when","+// building the Envoy RBAC SPIFFE match pattern, so they are matched literally.","+//","+// Without escaping, a \".\" in a service name acts as the regex \"any character\"","+// wildcard, letting an unintended identity satisfy an intention's RBAC rule","+// (an authorization bypass). This is a behavioral test: it compiles the","+// generated pattern and asserts that crafted identities do NOT match. Unlike","+// the golden fixtures, this cannot be silently regenerated to a passing state","+// if the escaping is ever removed.","+func TestMakeSpiffePattern_EscapesRegexMetacharacters(t *testing.T) {","+\tconst trustDomain = \"test.consul\"","+","+\tcompile := func(service string) *regexp.Regexp {","+\t\tp := makeSpiffePattern(rbacService{","+\t\t\tServiceName: structs.NewServiceName(service, nil),","+\t\t\tTrustDomain: trustDomain,","+\t\t})","+\t\treturn regexp.MustCompile(p)","+\t}","+","+\tspiffeID := func(service string) string {","+\t\treturn fmt.Sprintf(\"spiffe://%s/ns/default/dc/dc1/svc/%s\", trustDomain, service)","+\t}","+","+\tcases := []struct {","+\t\tname         string","+\t\tre           *regexp.Regexp","+\t\tmustMatch    []string","+\t\tmustNotMatch []string","+\t}{","+\t\t{","+\t\t\t// A \".\" in the service name must be matched literally, not as the","+\t\t\t// regex \"any character\" wildcard.","+\t\t\tname:      \"dot in service name is not a wildcard\",","+\t\t\tre:        compile(\"web.api\"),","+\t\t\tmustMatch: []string{spiffeID(\"web.api\")},","+\t\t\tmustNotMatch: []string{","+\t\t\t\tspiffeID(\"web-api\"),","+\t\t\t\tspiffeID(\"webXapi\"),","+\t\t\t\tspiffeID(\"web_api\"),","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\t// A \"|\" must not turn the pattern into an alternation that also","+\t\t\t// matches a completely different service name.","+\t\t\tname:      \"pipe in service name does not create alternation\",","+\t\t\tre:        compile(\"harmless|admin\"),","+\t\t\tmustMatch: []string{spiffeID(\"harmless|admin\")},","+\t\t\tmustNotMatch: []string{","+\t\t\t\tspiffeID(\"admin\"),","+\t\t\t\tspiffeID(\"harmless\"),","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\t// The \".\" in the trust domain must also be matched literally.","+\t\t\tname:      \"dot in trust domain is not a wildcard\",","+\t\t\tre:        compile(\"web\"),","+\t\t\tmustMatch: []string{spiffeID(\"web\")},","+\t\t\tmustNotMatch: []string{","+\t\t\t\t\"spiffe://testXconsul/ns/default/dc/dc1/svc/web\",","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tfor _, id := range tc.mustMatch {","+\t\t\t\tassert.True(t, tc.re.MatchString(id),","+\t\t\t\t\t\"pattern %q should match legitimate identity %q\", tc.re.String(), id)","+\t\t\t}","+\t\t\tfor _, id := range tc.mustNotMatch {","+\t\t\t\tassert.False(t, tc.re.MatchString(id),","+\t\t\t\t\t\"BYPASS: pattern %q must not match crafted identity %q\", tc.re.String(), id)","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":79,"deletions":0,"truncated":false},{"path":"agent/xds/testdata/listeners/terminating-gateway-with-peer-trust-bundle.latest.golden","lines":["@@ -186,7 +186,7 @@","                           \"authenticated\": {","                             \"principalName\": {","                               \"safeRegex\": {","-                                \"regex\": \"^spiffe://1c053652-8512-4373-90cf-5a7f6263a994.consul/ns/default/dc/[^/]+/svc/source$\"","+                                \"regex\": \"^spiffe://1c053652-8512-4373-90cf-5a7f6263a994\\\\.con