{"id":"d4796b2b638f4ed129baf5d76cb78be66742912c","axis":"silent","repo":"oven-sh/bun","sha":"d4796b2b638f4ed129baf5d76cb78be66742912c","parsed":{"files":[{"path":"src/collections/hive_array.rs","lines":["@@ -441,6 +441,11 @@ impl<T, const CAPACITY: usize> Fallback<T, CAPACITY> {","         unsafe { boxed.assume_init() }","     }"," ","+    /// Whether a slot of the inline hive is claimed.","+    pub fn is_in_use(&self) -> bool {","+        self.hive.used.iter_set().next().is_some()","+    }","+","     /// One-shot claim + write. Preferred entry point — no uninit window.","     /// Infallible: spills to a heap `Box<T>` when the inline hive is full.","     #[inline]"],"additions":5,"deletions":0,"truncated":false},{"path":"src/collections/lib.rs","lines":["@@ -14,6 +14,7 @@"," pub mod hive_array;"," pub mod index_sort;"," mod multi_array_list;","+mod once_map;"," pub mod vec_ext;"," // `bounded_array` moved down to `bun_core` (cycle-break for the"," // `bun_string → bun_core` merge — `bun_core::string::immutable` needs it).","@@ -34,6 +35,7 @@ pub use bounded_array::BoundedArray;"," pub use hive_array::{Fallback as HiveArrayFallback, HiveArray, HiveRef, HiveRefHandle, HiveSlot};"," pub use linear_fifo::LinearFifo;"," pub use multi_array_list::MultiArrayList;","+pub use once_map::OnceMap;"," #[doc(hidden)]"," pub use paste::paste as __mal_paste;"," pub use vec_ext::{ByteVecExt, OffsetByteList, VecExt};"],"additions":2,"deletions":0,"truncated":false},{"path":"src/collections/once_map.rs","lines":["@@ -0,0 +1,152 @@","+use core::cell::UnsafeCell;","+","+use bun_ptr::AliasableBox;","+","+use crate::HashMap;","+","+/// Boxed values, inserted through `&self` and removed through `&mut self`.","+pub struct OnceMap<V> {","+    /// Never borrowed while `V::drop` or the caller's code runs.","+    map: UnsafeCell<HashMap<u32, AliasableBox<V>>>,","+}","+","+impl<V> Default for OnceMap<V> {","+    fn default() -> Self {","+        Self {","+            map: UnsafeCell::default(),","+        }","+    }","+}","+","+impl<V> OnceMap<V> {","+    pub fn len(&self) -> usize {","+        // SAFETY: no other borrow of `map` is live between method calls.","+        unsafe { &*self.map.get() }.len()","+    }","+","+    pub fn contains_key(&self, key: u32) -> bool {","+        // SAFETY: as in `len`. Hashing a `u32` runs no code that could reach `map`.","+        unsafe { &*self.map.get() }.contains_key(&key)","+    }","+","+    pub fn get(&self, key: u32) -> Option<&V> {","+        // SAFETY: as in `contains_key`. The value does not move with its slot, and only","+        // `&mut self` drops it.","+        unsafe { (*self.map.get()).get(&key).map(|value| &*value.as_ptr()) }","+    }","+","+    /// Drops `value` if `key` is taken.","+    pub fn get_or_insert(&self, key: u32, value: V) -> &V {","+        // SAFETY: as in `contains_key`. What was handed out points into the boxes, not into `map`.","+        let stored = match unsafe { &mut *self.map.get() }.try_insert(key, AliasableBox::new(value))","+        {","+            Ok(stored) => stored.as_ptr(),","+            Err((stored, rejected)) => {","+                let stored = stored.as_ptr();","+                drop(rejected);","+                stored","+            }","+        };","+        // SAFETY: as in `get`.","+        unsafe { &*stored }","+    }","+","+    /// The values that are in the map now.","+    pub fn snapshot(&self) -> Vec<&V> {","+        // SAFETY: as in `get`.","+        unsafe {","+            let values = (*self.map.get()).values();","+            values.map(|value| &*value.as_ptr()).collect()","+        }","+    }","+","+    /// Does not allocate, but skips or repeats values if the map grows during the walk.","+    pub fn values(&self) -> impl Iterator<Item = &V> {","+        // SAFETY: as in `len`.","+        let capacity = unsafe { &*self.map.get() }.capacity();","+        let values = (0..capacity).filter_map(|slot| {","+            // SAFETY: as in `get`. Each step borrows `map` anew.","+            unsafe {","+                let value = (*self.map.get()).value_in_slot(slot)?;","+                Some(&*value.as_ptr())","+            }","+        });","+        values.take(self.len())","+    }","+","+    pub fn remove(&mut self, key: u32) {","+        self.map.get_mut().remove(&key);","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+    use core::cell::Cell;","+    use std::rc::{Rc, Weak};","+","+    #[test]","+    fn values_stay_valid_while_the_map_grows() {","+        let map = OnceMap::default();","+        let first = map.get_or_insert(1, Cell::new(1));","+        let before = map.snapshot();","+        for key in 2..100 {","+            map.get_or_insert(key, Cell::new(key));","+            first.set(first.get() + 1);","+        }","+        assert_eq!(before.len(), 1);","+        assert_eq!(before[0].get(), 99);","+        assert_eq!(map.get(1).map(Cell::get), Some(99));","+        assert_eq!(map.len(), 99);","+    }","+","+    #[test]","+    fn values_iterator_survives_inserts() {","+        let map = OnceMap::default();","+        for key in 0..6 {","+            map.get_or_insert(key, key);","+        }","+        let in_order: Vec<&u32> = map.values().collect();","+        assert_eq!(in_order, map.snapshot());","+        let mut next = 6;","+        for value in map.values() {","+            for _ in 0..10 {","+                map.get_or_insert(next, next);","+                next += 1;","+            }","+            assert_eq!(map.get(*value), Some(value));","+        }","+    }","+","+    struct InsertsOnDrop(Weak<OnceMap<InsertsOnDrop>>);","+","+    impl Drop for InsertsOnDrop {","+        fn drop(&mut self) {","+            let Some(map) = self.0.upgrade() else { return };","+            for key in 2..50 {","+                map.get_or_insert(key, InsertsOnDrop(Weak::new()));","+            }","+        }","+    }","+","+    #[test]","+    fn get_or_insert_keeps_the_existing_value() {","+        let map = Rc::new(OnceMap::default());","+        let first = map.get_or_insert(1, InsertsOnDrop(Weak::new()));","+        let second = map.get_or_insert(1, InsertsOnDrop(Rc::downgrade(&map)));","+        assert!(core::ptr::eq(first, second));","+        assert_eq!(second.0.strong_count(), 0);","+        assert_eq!(map.len(), 49);","+    }","+","+    #[test]","+    fn remove_drops_the_value() {","+        let value = Rc::new(());","+        let mut map = OnceMap::default();","+        map.get_or_insert(1, Rc::clone(&value));","+        assert_eq!(Rc::strong_count(&value), 2);","+        map.remove(1);","+        assert_eq!(Rc::strong_count(&value), 1);","+        assert!(!map.contains_key(1));","+    }","+}"],"additions":152,"deletions":0,"truncated":false},{"path":"src/collections/zig_hash_map.rs","lines":["@@ -186,6 +186,10 @@ impl<K, V, C> HashMap<K, V, C> {","             inner: self.iter_mut(),","         }","     }","+    /// Slots `0..capacity()` are in iteration order.","+    pub(crate) fn value_in_slot(&self, slot: usize) -> Option<&V> {","+        self.slots.get(slot)?.as_ref().map(|(_, v)| v)","+    }"," }"," "," impl<K, V, C: HashContext<K>> HashMap<K, V, C> {","@@ -436,6 +440,15 @@ impl<K, V, C: HashContext<K>> HashMap<K, V, C> {","         }","     }"," ","+    /// `Err` holds the stored value and the rejected one.","+    pub(crate) fn try_insert(&mut self, key: K, value: V) -> Result<&V, (&V, V)> {","+        let (idx, _) = self.get_or_put_slot(&key);","+        match &mut self.slots[idx] {","+            Some((_, existing)) => Err((existing, value)),","+            vacant => Ok(&vacant.insert((key, value)).1),","+        }","+    }","+","     /// Insert or overwrite.","     #[inline]","     pub fn put(&mut self, key: K, value: V) -> Result<(), bun_alloc::AllocError> {"],"additions":13,"deletions":0,"truncated":false},{"path":"src/jsc/Strong.rs","lines":["@@ -2,8 +2,11 @@"," //! collection. This type implies there is always a valid value held."," //