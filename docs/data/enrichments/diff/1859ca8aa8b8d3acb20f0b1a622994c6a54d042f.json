{"id":"1859ca8aa8b8d3acb20f0b1a622994c6a54d042f","axis":"silent","repo":"rustwasm/wasm-bindgen","sha":"1859ca8aa8b8d3acb20f0b1a622994c6a54d042f","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -5,6 +5,21 @@"," "," ### Added"," ","+* Added a rejection type parameter to `js_sys::Promise<T, E = JsValue>`,","+  mirrored on `JsFuture<T, E>`, `PromiseState<T, E>` and","+  `PromiseWithResolvers<T, E>`. Awaiting a `Promise<T, E>` yields","+  `Result<T, E>`, converting the rejection reason as an `E` the same unchecked","+  way the fulfilled value is converted as a `T`. Both parameters are covariant","+  under `Upcast`; `catch`, `then_with_reject` and the `withResolvers` reject","+  function receive an `E`; `all_tuple` / `all_settled_tuple` carry a shared `E`","+  through; and under `js_sys_unstable_apis`, `Promise::new`, `Promise::reject`","+  and `Promise::any` are typed on the rejection too, `any` as","+  `AggregateError`. The default keeps existing `Promise<T>` code unchanged.","+  `PromiseWithResolvers<T, E>` is invariant in both, since its `resolve` and","+  `reject` functions take them, and `JsFuture<T, E>` is `UnwindSafe` whenever","+  `T` and `E` are.","+  [#5426](https://github.com/wasm-bindgen/wasm-bindgen/pull/5426)","+"," * Added the `--js-string-builtins` CLI flag, importing `static_string`","   constants as [JS String Builtins](https://github.com/WebAssembly/js-string-builtins)","   string constants from `wasm:js/string-constants` instead of defining them in","@@ -232,6 +247,12 @@"," "," ### Fixed"," ","+* `js_sys::Promise::catch_map`'s handler now receives the rejection reason,","+  typed as the promise's `E`, instead of the reason mislabelled as the","+  fulfilled type `T`. A handler on a `Promise<Foo>` written as `|v: Foo|` must","+  take `JsValue`; it was never a `Foo`.","+  [#5426](https://github.com/wasm-bindgen/wasm-bindgen/pull/5426)","+"," * Large JS snippets (`module = \"...\"`, `inline_js`) and","   `typescript_custom_section` expressions such as `include_str!` no longer make","   compilation slow or print \"constant evaluation is taking a long time\""],"additions":21,"deletions":0,"truncated":false},{"path":"crates/cli/tests/reference/async-import.bg.js","lines":["@@ -117,11 +117,11 @@ export function __wbg_static_accessor_WINDOW_d7f903d1508cbdc4() {","     const ret = typeof window === 'undefined' ? undefined : window;","     return isLikeNone(ret) ? 0 : addToExternrefTable0(ret);"," }","-export function __wbg_then_c949d5a25a4e78f8(arg0, arg1, arg2) {","+export function __wbg_then_230c9d737bc3c90b(arg0, arg1, arg2) {","     const ret = arg0.then(arg1, arg2);","     return ret;"," }","-export function __wbg_then_e71170d78fcf8954(arg0, arg1) {","+export function __wbg_then_ce2a321a994ccb81(arg0, arg1) {","     const ret = arg0.then(arg1);","     return ret;"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"crates/cli/tests/reference/async-import.wat","lines":["@@ -40,8 +40,8 @@","   (import \"./reference_test_bg.js\" \"__wbg_static_accessor_GLOBAL_THIS_10fb7dc1ae063179\" (func (;18;) (type 18)))","   (import \"./reference_test_bg.js\" \"__wbg_static_accessor_SELF_0b583911f537483a\" (func (;19;) (type 18)))","   (import \"./reference_test_bg.js\" \"__wbg_static_accessor_WINDOW_d7f903d1508cbdc4\" (func (;20;) (type 18)))","-  (import \"./reference_test_bg.js\" \"__wbg_then_c949d5a25a4e78f8\" (func (;21;) (type 0)))","-  (import \"./reference_test_bg.js\" \"__wbg_then_e71170d78fcf8954\" (func (;22;) (type 1)))","+  (import \"./reference_test_bg.js\" \"__wbg_then_230c9d737bc3c90b\" (func (;21;) (type 0)))","+  (import \"./reference_test_bg.js\" \"__wbg_then_ce2a321a994ccb81\" (func (;22;) (type 1)))","   (import \"./reference_test_bg.js\" \"__wbindgen_generic_0000000000000000\" (func (;23;) (type 13)))","   (import \"./reference_test_bg.js\" \"__wbindgen_generic_0000000000000001\" (func (;24;) (type 13)))","   (import \"./reference_test_bg.js\" \"__wbindgen_generic_0000000000000002\" (func (;25;