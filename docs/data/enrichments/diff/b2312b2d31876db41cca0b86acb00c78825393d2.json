om '@rspack/core';","+import { createFsFromVolume, Volume } from 'memfs';","+import {","+  closeCompiler,","+  createGCTracker,","+  runCompiler,","+} from '@rspack/test-tools/helper/lifecycle';","+","+const tracker = createGCTracker();","+let labels;","+let nextLabel = 0;","+const compiler = rspack({","+  context: import.meta.dirname,","+  mode: 'none',","+  cache: false,","+  entry: Array.from(","+    { length: 4 },","+    (_, i) => `./loader.mjs!data:text/javascript,export default ${i}`,","+  ),","+  output: { path: path.join(import.meta.dirname, 'dist') },","+  plugins: [","+    {","+      apply(compiler) {","+        compiler.hooks.compilation.tap('WorkerReferences', (compilation) => {","+          compiler.webpack.NormalModule.getCompilationHooks(compilation).loader.tap(","+            'WorkerReferences',","+            (context) => {","+              context.trackReference = (data) => {","+                const label = String(nextLabel++);","+                labels.push(label);","+                tracker.track(data, label);","+              };","+            },","+          );","+          compilation.hooks.processAssets.tap('WorkerReferences', () => {","+            // Materialize BindingCell wrappers, retained until rebuild/close.","+            for (const asset of compilation.getAssets()) {","+              assert.equal(typeof asset.info, 'object');","+            }","+          });","+        });","+      },","+    },","+  ],","+});","+compiler.outputFileSystem = createFsFromVolume(new Volume());","+","+async function build() {","+  labels = [];","+  const stats = await runCompiler(compiler);","+  assert.equal(stats.hasErrors(), false, stats.toString({ all: false, errors: true }));","+  assert.equal(labels.length, 4);","+  // Successful compilation alone would also pass if Drop silently leaked refs.","+  for (const label of labels) await tracker.waitForCollection(label);","+}","+","+parentPort.on('message', () => {});","+try {","+  await build();","+  parentPort.postMessage('ready');","+  for (;;) {","+    const [command] = await once(parentPort, 'message');","+    if (command === 'close') break;","+    assert.equal(command, 'build');","+    await build();","+    parentPort.postMessage('built');","+  }","+} finally {","+  await closeCompiler(compiler);","+  parentPort.close();","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"tests/rspack-test/compilerCases/worker-references/workers.mjs","lines":["@@ -0,0 +1,47 @@","+import assert from 'node:assert/strict';","+import { once } from 'node:events';","+import { Worker } from 'node:worker_threads';","+","+export default async function run(mode) {","+  const workers = [];","+  const start = async () => {","+    const worker = new Worker(new URL('./worker.mjs', import.meta.url), {","+      execArgv: [],","+    });","+    workers.push(worker);","+    assert.deepEqual(await once(worker, 'message'), ['ready']);","+    return worker;","+  };","+  const build = async (worker) => {","+    const built = once(worker, 'message');","+    worker.postMessage('build');","+    assert.deepEqual(await built, ['built']);","+  };","+  const close = async (worker) => {","+    const exited = once(worker, 'exit');","+    worker.postMessage('close');","+    assert.deepEqual(await exited, [0]);","+  };","+","+  try {","+    // A initializes the deletion channel first. B keeps the addon loaded while","+    // A's env is destroyed, then drops new references on native build threads.","+    const first = await start();","+    const second = await start();","+    await Promise.all([build(first), build(second)]);","+    if (mode === 'terminate') {","+      // Leave the native compiler and its BindingCell references alive.","+      assert.equal(await first.terminate(), 1);","+    } else {","+      await close(first);","+    }","+    await build(second);","+","+    // A fresh env must get a fresh channel even if Node reuses an env address.","+    const third = await start();","+    await Promise.all([build(second), build(third)]);","+    await Promise.all([close(second), close(third)]);","+  } finally {","+    await Promise.all(workers.map((worker) => worker.terminate()));","+  }","+}",""],"additions":47,"deletions":0,"truncated":false}],"additions":503,"deletions":126,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-10-30T15:55:14.989926+00:00"}