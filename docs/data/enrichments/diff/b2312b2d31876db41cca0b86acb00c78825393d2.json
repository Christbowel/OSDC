ume());","+const writeFile = fs.writeFile.bind(fs);","+fs.writeFile = (...args) => {","+  // Output filesystem callbacks exercise the typed ThreadsafeFunction.","+  if (failWrite) {","+    args.at(-1)(new Error('worker filesystem rejection'));","+  } else {","+    writeFile(...args);","+  }","+};","+compiler.outputFileSystem = fs;","+","+// Keep a listener installed while builds run: once() removes its own listener,","+// and native callbacks alone do not keep the worker event loop alive.","+parentPort.on('message', () => {});","+try {","+  assert.equal((await runCompiler(compiler)).hasErrors(), false);","+  parentPort.postMessage('ready');","+  const [command] = await once(parentPort, 'message');","+  if (command === 'check') {","+    failHook = true;","+    await assert.rejects(runCompiler(compiler), /worker hook rejection/);","+    failHook = false;","+    failWrite = true;","+    await assert.rejects(runCompiler(compiler), /worker filesystem rejection/);","+    failWrite = false;","+    assert.equal((await runCompiler(compiler)).hasErrors(), false);","+    parentPort.postMessage('checked');","+    assert.deepEqual(await once(parentPort, 'message'), ['close']);","+  } else {","+    assert.equal(command, 'close');","+  }","+} finally {","+  await closeCompiler(compiler);","+  parentPort.close();","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"tests/rspack-test/compilerCases/worker-errors/workers.mjs","lines":["@@ -0,0 +1,35 @@","+import assert from 'node:assert/strict';","+import { once } from 'node:events';","+import { Worker } from 'node:worker_threads';","+","+export default async function run() {","+  const workers = [];","+  const start = async () => {","+    const worker = new Worker(new URL('./worker.mjs', import.meta.url), {","+      execArgv: [],","+    });","+    workers.push(worker);","+    assert.deepEqual(await once(worker, 'message'), ['ready']);","+    return worker;","+  };","+  const stop = async (worker) => {","+    const exited =