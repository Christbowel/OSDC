read files relative to their own location, such as `jsdom`, only work this way.","+"," ## Environment variables"," "," Bun loads `.env` files automatically. If `envPrefix` is set, add that prefix to each name in this section."],"additions":4,"deletions":7,"truncated":false},{"path":"packages/adapter-bun/index.d.ts","lines":["@@ -47,10 +47,10 @@ interface AdapterOptions {"," \t\t| 'ipv6Only'"," \t>;"," \t/**","-\t * Pass Bun build options directly for advanced configuration. The generated entrypoint,","-\t * output directory, top-level target, and module format are reserved. Set `compile` to","-\t * create an executable; if it does not specify an outfile, the executable is written to","-\t * `<out>/server`.","+\t * Options for the `Bun.build` call that turns the server into an executable. Set `compile`","+\t * to create one; if it does not specify an outfile, the executable is written to","+\t * `<out>/server`. The entrypoint, output directory, top-level target, and module format","+\t * are reserved. Without `compile`, the server is built by Vite and these options are ignored."," \t * @default {}"," \t */"," \tbuildOptions?: Pick<","@@ -63,7 +63,7 @@ interface AdapterOptions {"," \t\t| 'drop'"," \t\t| 'features'"," \t\t| 'optimizeImports'","-\t\t| 'splitting'","+\t\t| 'external'"," \t\t| 'compile'"," \t>;"," }"],"additions":5,"deletions":5,"truncated":false},{"path":"packages/adapter-bun/index.js","lines":["@@ -1,24 +1,11 @@"," /** @import { Builder } from '@sveltejs/kit' */","-/** @import { BunPlugin } from 'bun' */"," import fs from 'node:fs';"," import path from 'node:path';","+import { fileURLToPath } from 'node:url';"," ","-/**","- * @param {string} dir","- * @returns {{abs: string, rel: string}[]}","- */","-function read_files_recursive(dir) {","-\tif (!fs.existsSync(dir)) return [];","-\treturn fs","-\t\t.readdirSync(dir, { recursive: true, withFileTypes: true })","-\t\t.filter((entry) => entry.isFile())","-\t\t.map((entry) => {","-\t\t\tconst abs = path.reso