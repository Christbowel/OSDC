{"id":"610fee8d845047496bd0713e7adff4d79d08f137","axis":"silent","repo":"pytorch/pytorch","sha":"610fee8d845047496bd0713e7adff4d79d08f137","parsed":{"files":[{"path":"CMakeLists.txt","lines":["@@ -355,6 +355,9 @@ cmake_dependent_option("," cmake_dependent_option(USE_ROCM \"Use ROCm\" ON \"LINUX OR WIN32\" OFF)"," cmake_dependent_option(USE_ROCM_CK_GEMM \"Use ROCm Composable Kernel for GEMMs\" ON \"USE_ROCM;NOT WIN32\" OFF)"," cmake_dependent_option(USE_ROCM_CK_SDPA \"Use ROCm Composable Kernel for SDPA\" ON \"USE_ROCM;NOT WIN32\" OFF)","+# Off by default because enabling gfx12 adds CK SDPA code generation and compile","+# cost to ROCm builds that already target gfx1200/gfx1201.","+cmake_dependent_option(USE_ROCM_CK_SDPA_GFX12 \"Also build ROCm Composable Kernel SDPA for gfx12 (RDNA4)\" OFF \"USE_ROCM_CK_SDPA\" OFF)"," option(CAFFE2_STATIC_LINK_CUDA \"Statically link CUDA libraries\" OFF)"," cmake_dependent_option(USE_CUDNN \"Use cuDNN\" ON \"USE_CUDA\" OFF)"," cmake_dependent_option(USE_STATIC_CUDNN \"Use cuDNN static libraries\" OFF"],"additions":3,"deletions":0,"truncated":false},{"path":"aten/src/ATen/CMakeLists.txt","lines":["@@ -55,6 +55,31 @@ set_bool(AT_CUDNN_ENABLED CAFFE2_USE_CUDNN)"," set_bool(AT_CUSPARSELT_ENABLED CAFFE2_USE_CUSPARSELT)"," set_bool(AT_HIPSPARSELT_ENABLED CAFFE2_USE_HIPSPARSELT)"," ","+# The architectures CK SDPA kernels are built for: the candidates that","+# PYTORCH_ROCM_ARCH also asks for. The CK codegen target families, the ck_sdpa","+# target's HIP_ARCHITECTURES and the runtime check in Context.cpp are all","+# derived from this one list.","+#","+# gfx1200/gfx1201 (RDNA4, WMMA) is opt-in through USE_ROCM_CK_SDPA_GFX12 (OFF by","+# default): those arches are already in the ROCm wheel arch list, so building CK","+# SDPA for them would add code generation and compile cost to existing builds.","+set(AT_ROCM_CK_SDPA_ARCHS \"\")","+if(USE_ROCM AND USE_ROCM_CK_SDPA AND USE_FLASH_ATTENTION)","+  set(_ck_sdpa_candidate_archs gfx942 gfx950)","+  if(USE_ROCM_CK_SDPA_GFX12)","+    list(APPEND _ck_sdpa_candidate_archs gfx1200 gfx1201)","+  endif()","+  foreach(ARCH IN LISTS _ck_sdpa_candidate_archs)","+    if(\"${ARCH}\" IN_LIST PYTORCH_ROCM_ARCH)","+      list(APPEND AT_ROCM_CK_SDPA_ARCHS ${ARCH})","+    endif()","+  endforeach()","+  list(REMOVE_DUPLICATES AT_ROCM_CK_SDPA_ARCHS)","+endif()","+string(REPLACE \";\" \",\" AT_ROCM_CK_SDPA_ARCHS_STR \"${AT_ROCM_CK_SDPA_ARCHS}\")","+# Alongside the other generated ATen headers (see cmake/Codegen.cmake).","+configure_file(ROCmCKSDPAConfig.h.in \"${CMAKE_BINARY_DIR}/aten/src/ATen/ROCmCKSDPAConfig.h\" @ONLY)","+"," configure_file(Config.h.in \"${CMAKE_CURRENT_SOURCE_DIR}/Config.h\")"," # TODO: Do not generate CUDAConfig.h for ROCm BUILDS"," # At the moment, `jit_macros.h` include CUDAConfig.h for both CUDA and HIP builds","@@ -198,21 +223,12 @@ file(GLOB flash_attention_hip_hip CONFIGURE_DEPENDS \"native/transformers/hip/fla"," if(USE_FLASH_ATTENTION)","   # Now building CK by default","   if(USE_ROCM)","-    # CK SDPA only supports gfx942/gfx950. Auto-disable when none of those archs","-    # are in PYTORCH_ROCM_ARCH; otherwise the ck_sdpa target ends up with an","-    # empty HIP_ARCHITECTURES and CMake errors out.","-    if(USE_ROCM_CK_SDPA)","-      set(_have_ck_sdpa_arch FALSE)","-      foreach(ARCH gfx942 gfx950)","-        if(\"${ARCH}\" IN_LIST PYTORCH_ROCM_ARCH)","-          set(_have_ck_sdpa_arch TRUE)","-          break()","-        endif()","-      endforeach()","-      if(NOT _have_ck_sdpa_arch)","-        message(STATUS \"USE_ROCM_CK_SDPA disabled: PYTORCH_ROCM_ARCH (${PYTORCH_ROCM_ARCH}) has no MI3xx arch (gfx942/gfx950)\")","-        caffe2_update_option(USE_ROCM_CK_SDPA OFF)","-      endif()","+    # AT_ROCM_CK_SDPA_ARCHS, resolved at the top of this file, is what CK SDPA","+    # is built for. Auto-disable when it is empty; otherwise the ck_sdpa target","+    # ends up with an empty HIP_ARCHITECTURES and CMake errors out.","+    if(USE_ROCM_CK_SDPA AND NOT AT_ROCM_CK_SDPA_ARCHS)","+      message(STATUS \"USE_ROCM_CK_SDPA disabled: PYTORCH_ROCM_ARCH (${PYTORCH_ROCM_ARCH}) has no arch CK SDPA is built for (gfx942/gfx950; gfx1200/gfx1201 with USE_ROCM_CK_SDPA_GFX12)\")","+      caffe2_update_option(USE_ROCM_CK_SDPA OFF)","     endif()","   endif()","   if(USE_ROCM AND USE_ROCM_CK_SDPA)","@@ -295,23 +311,22 @@ if(USE_FLASH_ATTENTION)","     file(GLOB ck_sdpa_sources_hip CONFIGURE_DEPENDS","          \"native/transformers/hip/flash_attn/ck/*.hip\"","          \"native/transformers/hip/flash_attn/ck/fav_v3/*.hip\")","+    # Take the generated FMHA instances from the blob lists this configure","+    # wrote instead of from the glob: they are generated into the source tree,","+    # which can also hold instances from an earlier configure that asked for","+    # different target families.","+    list(FILTER ck_sdpa_sources_hip EXCLUDE REGEX \"/fmha_[^/]*\\\\.hip$\")","+    list(APPEND ck_sdpa_sources_hip ${CK_FMHA_GENERATED_SOURCES})"," ","     set_source_files_properties(${ck_sdpa_sources_hip} PROPERTIES LANGUAGE HIP)"," ","-    # Only build for MI3xx series architectures as building for all targets takes too long","-    # We will selectively add supported architectures when/if needed","-    set(_ck_sdpa_hip_arches \"\")","-    foreach(ARCH gfx942 gfx950)","-      if(\"${ARCH}\" IN_LIST PYTORCH_ROCM_ARCH)","-        list(APPEND _ck_sdpa_hip_arches ${ARCH})","-      endif()","-    endforeach()","-","     add_library(ck_sdpa STATIC ${ck_sdpa_sources_hip})","     target_compile_options(ck_sdpa PRIVATE $<$<COMPILE_LANGUAGE:HIP>:${CK_SDPA_EXTRA_HIPCC_FLAGS}> ${HIP_CXX_FLAGS})","     set_target_properties(ck_sdpa PROPERTIES","       POSITION_INDEPENDENT_CODE ON","-      HIP_ARCHITECTURES \"${_ck_sdpa_hip_arches}\")","+      # Only the architectures CK SDPA instances were generated for, to limit","+      # build cost.","+      HIP_ARCHITECTURES \"${AT_ROCM_CK_SDPA_ARCHS}\")","     target_compile_definitions(ck_sdpa PUBLIC ${CK_SDPA_EXTRA_HIPCC_OPTIONS})","     target_compile_definitions(ck_sdpa PRIVATE AITER_EMBEDDED_HSA_HEADER=\"aiter_embedded_hsa.h\")","     target_include_directories(ck_sdpa PUBLIC"],"additions":40,"deletions":25,"truncated":false},{"path":"aten/src/ATen/Context.cpp","lines":["@@ -8,6 +8,17 @@"," #include <array>"," #include <cctype>"," #include <string>","+#include <string_view>","+","+#if defined(USE_ROCM) && defined(__has_include) && \\","+    __has_include(<ATen/ROCmCKSDPAConfig.h>)","+#include <ATen/ROCmCKSDPAConfig.h>","+#endif","+#ifndef AT_ROCM_CK_SDPA_ARCHS","+// Non-CMake builds could define USE_ROCM but not generate this header;","+// empty disables the runtime check.","+#define AT_ROCM_CK_SDPA_ARCHS \"\"","+#endif"," "," #include <ATen/cpu/FlushDenormal.h>"," ","@@ -577,9 +588,24 @@ at::BlasBackend Context::blasPreferredBackend() {"," bool Context::ckSDPASupported() {"," #ifdef USE_ROCM","   // CK SDPA is only built for a subset of architectures to limit compile time.","-  static const std::vector<std::string> supported_archs = {","-      \"gfx942\", \"gfx950\",","-  };","+  // AT_ROCM_CK_SDPA_ARCHS is the set this build was compiled for, so the check","+  // stays in step with the build. It is empty when CK SDPA was not built.","+  static const std::vector<std::string> supported_archs = [] {","+    std::vector<std::string> archs;","+    std::string_view rest{AT_ROCM_CK_SDPA_ARCHS};","+    while (!rest.empty()) {","+      const auto comma = rest.find(',');","+      archs.emplace_back(rest.substr(0, comma));","+      if (comma == std::string_view::npos) {","+        break;","+      }","+      rest.remove_prefix(comma + 1);","+    }","+    return archs;","+  }();","+  if (supported_archs.empty()) {","+    return false;","+  }","   for (auto index : c10::irange(detail::getCUDAHooks().deviceCount())) {","     if (!detail::getCUDAHooks().isGPUArch(supported_archs, index)) {","       TORCH_WARN_ONCE("],"additions":29,"deletions":3,"truncated":false},{"path":"aten/src/ATen/ROCmCKSDPAConfig.h.in","lines":["@@ -0,0 +1,10 @@","+#pragma once","+","+// Comma-separated list of the architectures this build compiled ROCm CK SDPA","+// kernels for, empty when CK SDPA was not built. Generated from the same CMake","+// list that drives the codegen targets and HIP_ARCHITECTURES, so the runtime","+// check stays in step with what was built.","+//","+// Keep this generated configuration header out of public headers; include it","+// only from implementation files.","+#define AT_ROCM_CK_SDPA_ARCHS \"@AT_ROCM_CK_SDPA_ARCHS_STR@\""],"additions":10,"deletions":0,"truncated":false},{"path":"aten/src/ATen/native/transformers/hip/flash_attn/ck/CMakeLists.txt","lines":["@@ -5,9 +5,34 @@"," set(CK_FMHA_GENERATE python3 ${CMAKE_CURRENT_LIST_DIR}/generate_compat.py","     ${CMAKE_SOURCE_DIR}/third_party/composable_kernel/example/ck_tile/01_fmha/generate.py)"," ","+# Ask the CK codegen for the architecture families behind AT_ROCM_CK_SDPA_ARCHS.","+# Without --targets the generator falls back to its own default (\"gfx9,gfx950\"),","+# so no instances are emitted for RDNA4 even when the build is configured for it.","+set(_ck_fmha_targets \"\")","+foreach(ARCH IN LISTS AT_ROCM_CK_SDPA_ARCHS)","+  if(ARCH STREQUAL \"gfx942\")","+    list(APPEND _ck_fmha_targets gfx9)","+  elseif(ARCH STREQUAL \"gfx950\")","+    list(APPEND _ck_fmha_targets gfx950)","+  elseif(ARCH MATCHES \"^gfx12\")","+    list(APPEND _ck_fmha_targets gfx12)","+  else()","+    message(FATAL_ERROR \"CK Tile FMHA: no codegen target family known for ${ARCH}\")","+  endif()","+endforeach()","+list(REMOVE_DUPLICATES _ck_fmha_targets)","+if(NOT _ck_fmha_targets)","+  # Guard against an empty resolved list: aten/src/ATen/CMakeLists.txt disables","+  # USE_ROCM_CK_SDPA before reaching here.","+  message(FATAL_ERROR \"CK Tile FMHA: AT_ROCM_CK_SDPA_ARCHS is empty\")","+endif()","+list(JOIN _ck_fmha_targets \",\" _ck_fmha_targets_arg)","+message(STATUS \"CK Tile FMHA codegen targets: ${_ck_fmha_targets_arg}\")","+set(CK_FMHA_TARGETS --targets ${_ck_fmha_targets_arg})","+"," # generate a list of kernels, but not actually emit files at config stage"," execute_process(","-  COMMAND ${CK_FMHA_GENERATE} --optdim=32,64,128,256","+  COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --optdim=32,64,128,256","   --api fwd --receipt 4 --filter \"*_lse*ntrload*nsink*\" --list_blobs ${CMAKE_CURRENT_LIST_DIR}/fwd_blob_list.txt","   RESULT_VARIABLE ret"," )","@@ -17,7 +42,7 @@ if(ret AND NOT ret EQUAL 0)"," endif()"," "," execute_process(","-  COMMAND ${CK_FMHA_GENERATE} --optdim=32,64,128,256","+  COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --optdim=32,64,128,256","   --api fwd_splitkv --receipt 4 --filter \"*psdv*_lse*_nsquant*\" --list_blobs ${CMAKE_CURRENT_LIST_DIR}/fwd_splitkv_blob_list.txt","   RESULT_VARIABLE ret"," )","@@ -27,7 +52,7 @@ if(ret AND NOT ret EQUAL 0)"," endif()"," "," execute_process(","-  COMMAND ${CK_FMHA_GENERATE} --optdim=32,64,128,256","+  COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --optdim=32,64,128,256","   --api fwd_appendkv --receipt 4 --filter \"*psskddv_*\" --list_blobs ${CMAKE_CURRENT_LIST_DIR}/fwd_appendkv_blob_list.txt","   RESULT_VARIABLE ret"," )","@@ -37,7 +62,7 @@ if(ret AND NOT ret EQUAL 0)"," endif()"," "," execute_process(","-  COMMAND ${CK_FMHA_GENERATE}","+  COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS}","   --api bwd --optdim=32,64,128,256 --receipt 4 --filter \"*psdv*@*psd*@*_pd1dv1*_ntrload*\" --list_blobs ${CMAKE_CURRENT_LIST_DIR}/bwd_blob_list.txt","   RESULT_VARIABLE ret"," )","@@ -47,28 +72,31 @@ if(ret AND NOT ret EQUAL 0)"," endif()"," "," # Generate the files for both fwd, fwd_splitkv, fwd_appendkv, and bwd","-execute_process(COMMAND ${CK_FMHA_GENERATE} --api fwd  --optdim=32,64,128,256 --receipt 4 --filter \"*_lse*ntrload*nsink*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+execute_process(COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --api fwd  --optdim=32,64,128,256 --receipt 4 --filter \"*_lse*ntrload*nsink*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+  RESULT_VARIABLE ret"," )"," "," if(ret AND NOT ret EQUAL 0)","   message( FATAL_ERROR \"CK Tile FMHA FAILED to generate FWD kernels.\")"," endif()"," ","-execute_process(COMMAND ${CK_FMHA_GENERATE} --api fwd_splitkv --optdim=32,64,128,256 --receipt 4 --filter \"*psdv*_lse*_nsquant*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+execute_process(COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --api fwd_splitkv --optdim=32,64,128,256 --receipt 4 --filter \"*psdv*_lse*_nsquant*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+  RESULT_VARIABLE ret"," )"," "," if(ret AND NOT ret EQUAL 0)","     message( FATAL_ERROR \"CK Tile FMHA FAILED to generate FWD_SPLITKV kernels.\")"," endif()"," ","-execute_process(COMMAND ${CK_FMHA_GENERATE} --api fwd_appendkv --optdim=32,64,128,256 --receipt 4 --filter \"*psskddv_*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+execute_process(COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --api fwd_appendkv --optdim=32,64,128,256 --receipt 4 --filter \"*psskddv_*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+  RESULT_VARIABLE ret"," )"," "," if(ret AND NOT ret EQUAL 0)","     message( FATAL_ERROR \"CK Tile FMHA FAILED to generate FWD_APPENDKV kernels.\")"," endif()"," ","-execute_process(COMMAND ${CK_FMHA_GENERATE} --api bwd --optdim=32,64,128,256 --receipt 4 --filter \"*psdv*@*psd*@*_pd1dv1*_ntrload*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","+execute_process(COMMAND ${CK_FMHA_GENERATE} ${CK_FMHA_TARGETS} --api bwd --optdim=32,64,128,256 --receipt 4 --filter \"*psdv*@*psd*@*_pd1dv1*_ntrload*\" --output_dir ${CMAKE_CURRENT_LIST_DIR}","   RESULT_VARIABLE ret"," )"," ","@@ -118,3 +146,27 @@ execute_process(COMMAND bash -c \"for file in ${CMAKE_CURRENT_LIST_DIR}/*.cpp; do"," if(ret AND NOT ret EQUAL 0)","   message( FATAL_ERROR \"CK Tile FMHA FAILED to change the generated instances extensions from .cpp to .hpp\")"," endif()","+","+# The instances this configuration asks for. They are generated next to the","+# sources, so the directory can also hold instances from an earlier configure","+# with a different target list; name them from the blob lists written above","+# rather than from all matching files present in the directory.","+set(_ck_fmha_generated \"\")","+foreach(_ck_fmha_api fwd fwd_splitkv fwd_appendkv bwd)","+  file(STRINGS ${CMAKE_CURRENT_LIST_DIR}/${_ck_fmha_api}_blob_list.txt _ck_fmha_blobs)","+  foreach(_ck_fmha_blob IN LISTS _ck_fmha_blobs)","+    get_filename_component(_ck_fmha_name \"${_ck_fmha_blob}\" NAME)","+    string(REGEX REPLACE \"\\\\.cpp$\" \".hip\" _ck_fmha_name \"${_ck_fmha_name}\")","+    # Validate the naming convention the source selection in","+    # aten/src/ATen/CMakeLists.txt relies on.","+    if(NOT _ck_fmha_name MATCHES \"^fmha_.*\\\\.hip$\")","+      message(FATAL_ERROR \"CK Tile FMHA: unexpected generated instance name ${_ck_fmha_name}\")","+    endif()","+    if(NOT EXISTS ${CMAKE_CURRENT_LIST_DIR}/${_ck_fmha_name})","+      message(FATAL_ERROR \"CK Tile FMHA: ${_ck_fmha_name} is listed in ${_ck_fmha_api}_blob_list.txt but was not generated\")","+    endif()","+    list(APPEND _ck_fmha_generated ${CMAKE_CURRENT_LIST_DIR}/${_ck_fmha_name})","+  endforeach()","+endforeach()","+list(REMOVE_DUPLICATES _ck_fmha_generated)","+set(CK_FMHA_GENERATED_SOURCES ${_ck_fmha_generated} PARENT_SCOPE)"],"additions":60,"deletions":8,"truncated":false},{"path":"aten/src/ATen/native/transformers/hip/flash_attn/ck/launch_kernel_pt.hpp","lines":["@@ -14,7 +14,8 @@ __launch_bounds__(Kernel::kBlockSize, MinBlockPerCu)"," #endif","     __global__ void kentry_pt(Args... args)"," {","-#if (defined(__gfx90a__) || defined(__gfx942__) || defined(__gfx950__))","+#if (defined(__gfx90a__) || defined(__gfx942__) || defined(__gfx950__) || \\","+     defined(__gfx1200__) || defined(__gfx1201__))","     Kernel{}(args...);"," #else","     CUDA_KERNEL_ASSERT(false && \"Fatal! Attempting to call a CK SDPA kernel on unsupported hardware\");","@@ -27,7 +28,8 @@ __launch_bounds__(Kernel::kBlockSize, MinBlockPerCu)"," #endif","     __global__ void kentry_pt(Args... args)"," {","-#if (defined(__gfx90a__) || defined(__gfx942__) || defined(__gfx950__))","+#if (defined(__gfx90a__) || defined(__gfx942__) || defined(__gfx950__) || \\","+     defined(__gfx1200__) || defined(__gfx1201__))","     Kernel{}(args...);"," #else","     CUDA_KERNEL_ASSERT(false && \"Fatal! Attempting to call a CK SDPA kernel on unsupported hardware\");"],"additions":4,"deletions":2,"truncated":false},{"path":"cmake/EnvVarForwarding.cmake","lines":["@@ -54,6 +54,7 @@"," #   USE_ROCM_KERNEL_ASSERT=1 enables kernel assert on ROCm"," #   USE_ROCM_CK_GEMM=1       builds the CK GEMM backend on ROCm"," #   USE_ROCM_CK_SDPA=1       builds the CK SDPA backend on ROCm","+#   USE_ROCM_CK_SDPA_GFX12=1 enables CK SDPA for targeted gfx12 architectures"," #   USE_LAYERNORM_FAST_RECIPROCAL  fast reciprocals for layer norm (default on)"," #   USE_MIMALLOC             static-link mimalloc into c10 (default: Windows/AArch64)"," #   USE_CUSTOM_DEBINFO=\"a.cpp;b.cpp\"  build debug info only for the listed files"],"additions":1,"deletions":0,"truncated":false},{"path":"cmake/Summary.cmake","lines":["@@ -129,6 +129,7 @@ function(caffe2_print_configuration_summary)","     message(STATUS \"    USE_FLASH_ATTENTION           : ${USE_FLASH_ATTENTION}\")","     message(STATUS \"    USE_MEM_EFF_ATTENTION         : ${USE_MEM_EFF_ATTENTION}\")","     message(STATUS \"    USE_ROCM_CK_SDPA              : ${USE_ROCM_CK_SDPA}\")","+    message(STATUS \"    USE_ROCM_CK_SDPA_GFX12        : ${USE_ROCM_CK_SDPA_GFX12}\")","     message(STATUS \"    USE_ROCM_CK_GEMM              : ${USE_ROCM_CK_GEMM}\")","     message(STATUS \"    USE_LAYERNORM_FAST_RECIPROCAL : ${USE_LAYERNORM_FAST_RECIPROCAL}\")","     message(STATUS \"    USE_HIPSPARSELT               : ${USE_HIPSPARSELT}\")",""],"additions":1,"deletions":0,"truncated":false}],"additions":148,"deletions":38,"truncated":false,"file_count":8},"error":null,"fe