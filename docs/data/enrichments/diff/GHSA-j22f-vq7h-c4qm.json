{"id":"GHSA-j22f-vq7h-c4qm","axis":"advisories","repo":"sveltejs/devalue","sha":"46dc877b3570dafb1cd3291b9bb48cecef8f7266","parsed":{"files":[{"path":".changeset/tidy-buffers-hide.md","lines":["@@ -0,0 +1,5 @@","+---","+'devalue': patch","+---","+","+fix: serialize only the visible bytes of Node Buffers in `stringify`, `stringifyAsync` and `uneval`, preventing disclosure of unrelated data from their shared allocation pool"],"additions":5,"deletions":0,"truncated":false},{"path":"README.md","lines":["@@ -102,6 +102,19 @@ const json = `{"," const data = devalue.unflatten(JSON.parse(json).data);"," ```"," ","+### Binary data","+","+Node.js `Buffer` values are serialized as `Uint8Array`s containing only the Buffer's visible bytes. Their backing stores are copied, since small Buffers can share an allocation pool containing unrelated, sensitive data. Repeated references to the same Buffer are preserved, but distinct Buffers are given separate backing stores.","+","+For ordinary typed arrays and `DataView`s, devalue serializes the **entire backing `ArrayBuffer`**, preserving shared views and byte offsets. This includes bytes outside a `subarray` or subview. Only serialize these views if their entire backing store is safe to disclose, or copy the intended bytes first:","+","+```js","+const copy = new Uint8Array(new Uint8Array(view.buffer, view.byteOffset, view.byteLength));","+const serialized = devalue.stringify(copy);","+```","+","+This also applies if you explicitly pass `buf.buffer`, or create an ordinary typed array or `DataView` over a Node Buffer's backing store — these values cannot be identified as Node Buffers. To copy a Buffer's contents into an independent typed array, use `new Uint8Array(buf)`.","+"," ## Custom types"," "," You can serialize and deserialize custom types by passing a second argument to `stringify` containing an object of types and their _reducers_, and a second argument to `parse` or `unflatten` containing an object of types and their _revivers_:"],"additions":13,"deletions":0,"truncated":false},{"path":"src/operations.js","lines":["@@ -2,6 +2,7 @@ import { MAX_ARRAY_INDEX } from './constants.js';"," import {"," \tenumerable_symbols,"," \tget_type,","+\tis_buffer,"," \tis_plain_object,"," \tvalid_array_indices"," } from './utils.js';","@@ -76,13 +77,19 @@ const stringify_operations = {"," "," \tentriesOf: (map) => map,"," ","-\tviewInfo: (view) => ({","-\t\tbuffer: view.buffer,","-\t\tbyteOffset: view.byteOffset,","-\t\tbyteLength: view.byteLength,","-\t\tlength: view.length,","-\t\tbufferByteLength: view.buffer.byteLength","-\t}),","+\tviewInfo: (view) => {","+\t\t// Node Buffers may share a pool containing unrelated, sensitive data.","+\t\t// Copy only the visible bytes, without using Buffer's pooling or slice.","+\t\tif (is_buffer(view)) view = new Uint8Array(view);","+","+\t\treturn {","+\t\t\tbuffer: view.buffer,","+\t\t\tbyteOffset: view.byteOffset,","+\t\t\tbyteLength: view.byteLength,","+\t\t\tlength: view.length,","+\t\t\tbufferByteLength: view.buffer.byteLength","+\t\t};","+\t},"," "," \ttoArrayBuffer: (buffer) => buffer,"," "],"additions":14,"deletions":7,"truncated":false},{"path":"src/types.d.ts","lines":["@@ -177,7 +177,10 @@ export interface StringifyOperations {"," \t/**"," \t * Returns the view metadata of a typed array or `DataView` value."," \t * `length` is only meaningful for typed arrays. `buffer` is serialized","-\t * recursively, so it may be a foreign value/handle.","+\t * recursively in full, so it may be a foreign value/handle.","+\t * The default copies Node Buffers into an exact-sized backing buffer with","+\t * byteOffset 0 to avoid exposing unrelated bytes from Node's shared pool.","+\t * Overrides must take equivalent care with pooled views."," \t */"," \tviewInfo(view: any): {"," \t\tbuffer: any;"],"additions":4,"deletions":1,"truncated":false},{"path":"src/uneval.js","lines":["@@ -4,6 +4,7 @@ import {"," \tenumerable_symbols,"," \tescaped,"," \tget_type,","+\tis_buffer,"," \tis_plain_object,"," \tis_primitive,"," \tstringify_key,","@@ -131,7 +132,9 @@ export function uneval(value, replacer) {"," \t\t\t\tcase 'BigInt64Array':"," \t\t\t\tcase 'BigUint64Array':"," \t\t\t\tcase 'DataView':","-\t\t\t\t\twalk(thing.buffer);","+\t\t\t\t\t// A Node Buffer's backing store may be a shared pool. It must","+\t\t\t\t\t// never be visited or hoisted just because a Buffer uses it.","+\t\t\t\t\tif (!is_buffer(thing)) walk(thing.buffer);"," \t\t\t\t\treturn;"," "," \t\t\t\tcase 'ArrayBuffer':","@@ -344,6 +347,8 @@ export function uneval(value, replacer) {"," \t\t\tcase 'Float64Array':"," \t\t\tcase 'BigInt64Array':"," \t\t\tcase 'BigUint64Array': {","+\t\t\t\tif (is_buffer(thing)) thing = new Uint8Array(thing);","+"," \t\t\t\tlet str = `new ${type}`;"," "," \t\t\t\tif (!names.has(thing.buffer)) {","@@ -522,6 +527,8 @@ export function uneval(value, replacer) {"," \t\t\t\tcase 'Float64Array':"," \t\t\t\tcase 'BigInt64Array':"," \t\t\t\tcase 'BigUint64Array': {","+\t\t\t\t\tif (is_buffer(thing)) thing = new Uint8Array(thing);","+"," \t\t\t\t\tlet str = `new ${type}`;"," "," \t\t\t\t\tif (!names.has(thing.buffer)) {"],"additions":8,"deletions":1,"truncated":false},{"path":"src/utils.js","lines":["@@ -55,6 +55,11 @@ export function get_type(thing) {"," \treturn Object.prototype.toString.call(thing).slice(8, -1);"," }"," ","+/** @param {any} thing */","+export function is_buffer(thing) {","+\treturn typeof Buffer !== 'undefined' && Buffer.isBuffer(thing);","+}","+"," /** @param {string} char */"," function get_escaped_char(char) {"," \tswitch (char) {"],"additions":5,"deletions":0,"truncated":false},{"path":"test/buffer.test.js","lines":["@@ -0,0 +1,157 @@","+import { execFileSync } from 'node:child_process';","+import { readFileSync } from 'node:fs';","+import { runInNewContext } from 'node:vm';","+import * as assert from 'uvu/assert';","+import * as uvu from 'uvu';","+import { parse, stringify, stringifyAsync, uneval } from '../index.js';","+","+const serializers = [","+\t[uneval, (source) => (0, eval)(`(${source})`)],","+\t[stringify, parse],","+\t[stringifyAsync, parse]","+];","+","+const sources = {","+\t'Buffer.from': () => Buffer.from([1, 2, 3]),","+\t'Buffer.allocUnsafe': () => {","+\t\tconst buffer = Buffer.allocUnsafe(3);","+\t\tbuffer.set([1, 2, 3]);","+\t\treturn buffer;","+\t},","+\t'Buffer.concat': () => Buffer.concat([Buffer.from([1]), Buffer.from([2, 3])]),","+\t'Buffer.slice': () => Buffer.from([255, 1, 2, 3, 255]).slice(1, 4),","+\t'Buffer.subarray': () => Buffer.from([255, 1, 2, 3, 255]).subarray(1, 4),","+\t'unpooled Buffer subarray': () => {","+\t\tconst buffer = Buffer.alloc(32, 255);","+\t\tbuffer.set([1, 2, 3], 8);","+\t\treturn buffer.subarray(8, 11);","+\t},","+\t'Buffer over an ArrayBuffer': () =>","+\t\tBuffer.from(new Uint8Array([255, 1, 2, 3, 255]).buffer, 1, 3),","+\t'Buffer from a vm context': () => runInNewContext('Buffer.from([1, 2, 3])', { Buffer })","+};","+","+for (const [serialize, deserialize] of serializers) {","+\tconst test = uvu.suite(`${serialize.name}: Node Buffer`);","+","+\tfor (const [name, create] of Object.entries(sources)) {","+\t\ttest(`only serializes the visible bytes of ${name}`, async () => {","+\t\t\tconst value = create();","+\t\t\tassert.ok(value.buffer.byteLength > value.byteLength);","+","+\t\t\tconst serialized = await serialize(value);","+\t\t\tassert.is(","+\t\t\t\tserialized,","+\t\t\t\tserialize === uneval","+\t\t\t\t\t? 'new Uint8Array([1,2,3])'","+\t\t\t\t\t: '[[\"Uint8Array\",1],[\"ArrayBuffer\",\"AQID\"]]'","+\t\t\t);","+","+\t\t\tconst result = deserialize(serialized);","+\t\t\tassert.equal(result, new Uint8Array([1, 2, 3]));","+\t\t\tassert.is(result.byteOffset, 0);","+\t\t\tassert.is(result.buffer.byteLength, 3);","+\t\t});","+\t}","+","+\ttest('does not serialize backing bytes for an empty subarray', async () => {","+\t\tconst value = Buffer.from('SECRET').subarray(3, 3);","+\t\tconst serialized = await serialize(value);","+\t\tassert.is(","+\t\t\tserialized,","+\t\t\tserialize === uneval","+\t\t\t\t? 'new Uint8Array([])'","+\t\t\t\t: '[[\"Uint8Array\",1],[\"ArrayBuffer\",\"\"]]'","+\t\t);","+\t\tassert.is(deserialize(serialized).buffer.byteLength, 0);","+\t});","+","+\ttest('isolates Buffers sharing a pool while preserving repeated references and cycles', async () => {","+\t\t// Use one allocation so the shared backing store is deterministic, even","+\t\t// when Node's current pool is almost exhausted.","+\t\tconst allocation = Buffer.allocUnsafe(128).fill(255);","+\t\tconst first = allocation.subarray(8, 11);","+\t\tconst second = allocation.subarray(24, 26);","+\t\tfirst.set([1, 2, 3]);","+\t\tsecond.set([4, 5]);","+\t\tassert.is(first.buffer, second.buffer);","+","+\t\tconst value = { first, again: first, second };","+\t\tvalue.self = value;","+","+\t\tconst copy = new Uint8Array([1, 2, 3]);","+\t\tconst expected = { first: copy, again: copy, second: new Uint8Array([4, 5]) };","+\t\texpected.self = expected;","+","+\t\tconst serialized = await serialize(value);","+\t\t// Check the output too: uneval must not emit an unused copy of the pool.","+\t\tassert.is(serialized, await serialize(expected));","+","+\t\tconst result = deserialize(serialized);","+\t\tassert.is(result.first, result.again);","+\t\tassert.is(result.self, result);","+\t\tassert.is(result.first.buffer.byteLength, 3);","+\t\tassert.is(result.second.buffer.byteLength, 2);","+\t\tassert.is.not(result.first.buffer, result.second.buffer);","+\t});","+","+\ttest('only serializes file contents from readFileSync', async () => {","+\t\tconst value = readFileSync(new URL('../package.json', import.meta.url));","+\t\tconst serialized = await serialize({ file: value });","+\t\tassert.is(","+\t\t\tserialized,","+\t\t\tserialize === uneval","+\t\t\t\t? `{file:new Uint8Array([${Array.from(value)}])}`","+\t\t\t\t: `[{\"file\":1},[\"Uint8Array\",2],[\"ArrayBuffer\",\"${value.toString('base64')}\"]]`","+\t\t);","+\t\tassert.is(deserialize(serialized).file.buffer.byteLength, value.byteLength);","+\t});","+","+\ttest('preserves shared backing stores for ordinary typed arrays and DataViews', async () => {","+\t\tconst buffer = new Uint8Array([0, 1, 2, 3, 4, 5]).buffer;","+\t\tconst view = new Uint8Array(buffer, 1, 3);","+\t\tconst data = new DataView(buffer, 2, 2);","+\t\tconst result = deserialize(await serialize({ buffer, view, again: view, data }));","+","+\t\tassert.is(result.view, result.again);","+\t\tassert.is(result.view.buffer, result.buffer);","+\t\tassert.is(result.data.buffer, result.buffer);","+\t\tassert.is(result.view.byteOffset, 1);","+\t\tassert.is(result.view.length, 3);","+\t\tassert.is(result.data.byteOffset, 2);","+\t\tassert.is(result.data.byteLength, 2);","+\t\tassert.equal(new Uint8Array(result.buffer), new Uint8Array([0, 1, 2, 3, 4, 5]));","+\t});","+","+\ttest.run();","+}","+","+uvu.test('stringifyAsync only serializes visible Buffer bytes after resolving a promise', async () => {","+\tconst value = Buffer.from([255, 1, 2, 3, 255]).subarray(1, 4);","+\tassert.is(","+\t\tawait stringifyAsync({ data: Promise.resolve(value) }),","+\t\t'[{\"data\":1},[\"Uint8Array\",2],[\"ArrayBuffer\",\"AQID\"]]'","+\t);","+});","+","+uvu.test('serializes typed arrays without Node globals', () => {","+\t// Import in a fresh process so base64 encoding also uses the browser path.","+\texecFileSync(process.execPath, [","+\t\t'--input-type=module',","+\t\t'--eval',","+\t\t`","+\t\t\timport { deepStrictEqual } from 'node:assert';","+\t\t\tglobalThis.Buffer = undefined;","+\t\t\tglobalThis.process = undefined;","+\t\t\tconst { parse, stringify, stringifyAsync, uneval } = await import(","+\t\t\t\t${JSON.stringify(new URL('../index.js', import.meta.url).href)}","+\t\t\t);","+\t\t\tconst value = new Uint8Array([1, 2, 3]);","+\t\t\tdeepStrictEqual((0, eval)(uneval(value)), value);","+\t\t\tdeepStrictEqual(parse(stringify(value)), value);","+\t\t\tdeepStrictEqual(parse(await stringifyAsync(value)), value);","+\t\t`","+\t]);","+});","+","+uvu.test.run();"],"additions":157,"deletions":0,"truncated":false},{"path":"test/operations.test.js","lines":["@@ -409,6 +409,14 @@ suite('handle-based operations', (test) => {"," \t\tassert_parity(new DataView(buffer, 1, 4));"," \t});"," ","+\ttest('only serializes visible Buffer bytes through handles', () => {","+\t\tconst buffer = Buffer.from([255, 1, 2, 3, 255]).subarray(1, 4);","+\t\tassert.is(","+\t\t\tstringify(h(buffer), undefined, { operations: handle_operations }),","+\t\t\t'[[\"Uint8Array\",1],[\"ArrayBuffer\",\"AQID\"]]'","+\t\t);","+\t});","+"," \ttest('repeated references deduplicate via identify despite distinct handles', () => {"," \t\tconst shared = { x: 1 };"," \t\tconst value = { first: shared, second: shared };",""],"additions":8,"deletions":0,"truncated":false}],"additions":214,"deletions":9,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-02T14:42:34.607804+00:00"}