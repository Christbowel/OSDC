ironment. ty uses","+  [uv](https://docs.astral.sh/uv/) to install the script's declared dependencies there","+  and resolves imports from that environment. This requires uv 0.12.3 or newer.","+","+If a script has an inline `[tool.ty]` table, its `project-manager.script` setting","+takes precedence. Otherwise, the script inherits the project's value.","+","+When checking untrusted code with `ty check`, pass `--config 'project-manager.script=\"none\"'`","+to disable script synchronization. To disable both script synchronization and uv workspace","+discovery, set the `TY_UV` environment variable to `off`. `TY_UV` takes precedence over","+`--config`. If your editor marks the workspace as untrusted, ty disables both automatically.","+","+`uv check` sets `TY_UV=1`, so it always enables script synchronization.","+","+**Default value**: `\"none\"`","+","+**Type**: `\"uv\" | \"none\"`","+","+**Example usage**:","+","+=== \"pyproject.toml\"","+","+    ```toml","+    [tool.ty.project-manager]","+    script = \"uv\"","+    ```","+","+=== \"ty.toml\"","+","+    ```toml","+    [project-manager]","+    script = \"uv\"","+    ```","+","+---","+"," ## `src`"," "," ### `exclude`"],"additions":44,"deletions":0,"truncated":false},{"path":"crates/ty/docs/environment.md","lines":["@@ -56,6 +56,9 @@ Python environment for each script with [inline metadata](https://peps.python.or"," When set to `1` or `true`, ty also uses uv to discover the workspace root and its Python"," environment."," ","+Set to `off` to disable all uv integration, including for scripts that set","+`project-manager.script = \"uv\"`. An explicit `TY_UV` takes precedence over ty configuration.","+"," ## Externally-defined variables"," "," ty also reads the following externally defined environment variables:"],"additions":3,"deletions":0,"truncated":false},{"path":"crates/ty/docs/rules.md","lines":["@@ -4977,7 +4977,7 @@ reads the dependency graph and module ownership returned by `uv workspace metada"," installed packages. uv may update the lockfile to match the current dependency declarations. uv"," 0.12.3 or later is required."," ","-For PEP 723 scripts, enable uv script integration with `TY_UV=scripts` or `TY_UV=1`. ty synchronizes","+For PEP 723 scripts, set `project-manager.script = \"uv\"` in your ty configuration. ty synchronizes"," each script's environment and checks imports against its inline `dependencies` list. Declarations"," and environments from the enclosing workspace or other scripts do not apply."," "],"additions":1,"deletions":1,"truncated":false},{"path":"crates/ty/src/args.rs","lines":["@@ -306,7 +306,7 @@ impl CheckCommand {","             }),","             src: Some(SrcOptions {","                 respect_ignore_files,","-                exclude_scripts,","+                exclude_scripts: exclude_scripts.map(RangedValue::cli),","                 exclude: self.exclude.map(|excludes| {","                     RangedValue::cli(excludes.iter().map(RelativeGlobPattern::cli).collect())","                 }),"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/ty/src/lib.rs","lines":["@@ -25,7 +25,10 @@ use ruff_db::system::{OsSystem, System, SystemPath, SystemPathBuf};"," use ruff_db::{STACK_SIZE, max_parallelism};"," use ruff_diagnostics::Applicability;"," use ruff_python_ast::script::ScriptTag;","+use ruff_ranged_value::RangedValue;"," use salsa::Database;","+use ty_combine::Combine;","+use ty_project::metadata::Options;"," use ty_project::metadata::settings::TerminalSettings;"," use ty_project::watch::ProjectWatcher;"," use ty_project::{","@@ -158,17 +161,20 @@ fn run_check(args: CheckCommand) -> anyhow::Result<ExitStatus> {","         .map(|path| SystemPath::absolute(path, &cwd));","     let force_exclude = args.force_exclude();"," ","+    let use_uv = UseUv::from_system(&system);","     let mut project_metadata = match &config_file {","         Some(config_file) => {","             ProjectMetadata::from_config_file(config_file.clone(), &project_p