{"id":"840284fc48973d916a7efacb1d0a7ab17c69a587","axis":"silent","repo":"Azure/azure-sdk-for-js","sha":"840284fc48973d916a7efacb1d0a7ab17c69a587","parsed":{"files":[{"path":"sdk/monitor/monitor-opentelemetry-exporter/CHANGELOG.md","lines":["@@ -9,6 +9,7 @@"," "," ### Bugs Fixed"," ","+- Isolated the Microsoft Entra audience for multi-endpoint exports from the host connection string. Set `APPLICATIONINSIGHTS_MULTI_ENDPOINT_AAD_AUDIENCE` to override the public cloud default for routed telemetry. [#40586](https://github.com/Azure/azure-sdk-for-js/pull/40586)"," - Bounded routed requests and shutdown so a stalled destination cannot indefinitely block queued overflow destinations. Timed-out telemetry remains eligible for offline retry when storage is available. [#40831](https://github.com/Azure/azure-sdk-for-js/pull/40831)"," - Closed exporter-owned connections after each temporary overflow routing request, while preserving connection reuse for cached routes and caller-owned transports. [#40586](https://github.com/Azure/azure-sdk-for-js/pull/40586)"," - Preserved compatible sampler attribute value types for OpenTelemetry 2.x consumers while including the numeric sample-rate attribute in the return type. [#40536](https://github.com/Azure/azure-sdk-for-js/pull/40536)"],"additions":1,"deletions":0,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/README.md","lines":["@@ -194,9 +194,19 @@ Set the same attributes on spans or individual metric data points to route those"," Span events inherit their parent span's routing attributes. Resource and instrumentation-scope"," attributes are not used for metric routing."," ","-For Microsoft Entra ID authentication, set `microsoft.ingestion_auth` to `\"aad\"` and","-provide an exporter `credential`. Otherwise, items use key-only authentication, even if","-a credential is configured. AAD routes without a credential fail.","+For Microsoft Entra ID authentication, pass a `TokenCredential` to the exporter's","+`credential` option and grant the identity the **Monitoring Metrics Publisher** role on each","+destination resource. Setting `microsoft.ingestion_auth` to `\"aad\"` authorizes the exporter","+to send a bearer token to that item's HTTPS endpoint, including a custom endpoint. Other","+items use key-only authentication, even at the same endpoint. An `aad` route without a","+credential fails without preventing independent routes from exporting.","+","+All `aad` routes on an exporter share one identity and audience. The default token scope is","+`https://monitor.azure.com/.default`. For another cloud, set","+`APPLICATIONINSIGHTS_MULTI_ENDPOINT_AAD_AUDIENCE` before constructing the exporter, for","+example to `https://monitor.azure.cn/.default`. The host connection string's `AadAudience`","+does not apply to routed items. Use separate exporters if destinations require different","+identities or audiences."," "," Set `microsoft.multi_endpoint_cloud_role` to specify the cloud role name. It defaults to"," `unknown_service`. Role instances still come from the resource.","@@ -209,8 +219,9 @@ destinations have no offline storage and report a failed export instead."," Shutdown allows 30 seconds for pending routed requests before cancelling them."," Queued overflow destinations that have not started by that deadline report a failed export."," Custom `httpClient` and `retryOptions` are supported, but `pipeline` and `additionalPolicies`","-are not supported in routing mode. Custom HTTP clients must honor request abort signals","-to release their connections when cancelled.","+are rejected in routing mode. A custom HTTP client is shared across destinations. Do not","+add an `Authorization` header, cookie, or other secret indiscriminately, even to key-only","+requests. Leave redirect handling to the exporter and honor request abort signals."," "," ### Sampling"," "],"additions":16,"deletions":5,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/src/Declarations/Constants.ts","lines":["@@ -187,6 +187,9 @@ export const ENV_APPLICATIONINSIGHTS_SDK_STATS_LOGGING = \"APPLICATIONINSIGHTS_SD"," export const ENV_APPLICATIONINSIGHTS_EXPERIMENTAL_FEATURES =","   \"APPLICATIONINSIGHTS_EXPERIMENTAL_FEATURES\";"," ","+/** Microsoft Entra audience for multi-endpoint exports only. @internal */","+export const ENV_MULTI_ENDPOINT_AAD_AUDIENCE = \"APPLICATIONINSIGHTS_MULTI_ENDPOINT_AAD_AUDIENCE\";","+"," /**","  * Gen AI message properties eligible for the opt-in 4 MiB limit.","  * @internal"],"additions":3,"deletions":0,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/src/export/log.ts","lines":["@@ -33,7 +33,7 @@ export class AzureMonitorLogExporter extends AzureMonitorBaseExporter implements","   constructor(options: AzureMonitorExporterOptions = {}) {","     super(options);","     if (this.multiEndpointRouting) {","-      this.routingSender = new RoutingSender(options, this.instrumentationKey, this.aadAudience);","+      this.routingSender = new RoutingSender(options, this.instrumentationKey);","     }","     this._sender = new HttpSender({","       endpointUrl: this.endpointUrl,"],"additions":1,"deletions":1,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/src/export/metric.ts","lines":["@@ -35,7 +35,7 @@ export class AzureMonitorMetricExporter","   constructor(options: AzureMonitorExporterOptions = {}) {","     super(options);","     if (this.multiEndpointRouting) {","-      this.routingSender = new RoutingSender(options, this.instrumentationKey, this.aadAudience);","+      this.routingSender = new RoutingSender(options, this.instrumentationKey);","     }","     this._sender = new HttpSender({","       endpointUrl: this.endpointUrl,"],"additions":1,"deletions":1,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/src/export/trace.ts","lines":["@@ -37,7 +37,7 @@ export class AzureMonitorTraceExporter extends AzureMonitorBaseExporter implemen","   constructor(options: AzureMonitorExp