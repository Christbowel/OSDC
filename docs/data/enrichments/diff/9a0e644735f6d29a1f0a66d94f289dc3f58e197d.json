      <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-test-prometheus-metrics</artifactId>","+            <version>${project.version}</version>","+            <scope>test</scope>","+        </dependency>","+","+        <!-- Minimal test dependencies to *-deployment artifacts for consistent build order; the tests that need one of","+             these extensions force it with setForcedDependencies, so that every other test runs without it -->","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-load-shedding-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-smallrye-health-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-elytron-security-properties-file-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+    </dependencies>","+","+    <build>","+        <plugins>","+            <plugin>","+                <artifactId>maven-compiler-plugin</artifactId>","+                <executions>","+                    <execution>","+                        <id>default-compile</id>","+                        <configuration>","+                            <annotationProcessorPaths>","+                                <path>","+                                    <groupId>io.quarkus</groupId>","+                                    <artifactId>quarkus-extension-processor</artifactId>","+                                    <version>${project.version}</version>","+                                </path>","+                            </annotationProcessorPaths>","+                        </configuration>","+                    </execution>","+                </executions>","+            </plugin>","+        </plugins>","+    </build>","+</project>"],"additions":140,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/micrometer/deployment/src/main/java/io/quarkus/http/ratelimit/micrometer/deployment/HttpRateLimitMicrometerBuildTimeConfig.java","lines":["@@ -0,0 +1,18 @@","+package io.quarkus.http.ratelimit.micrometer.deployment;","+","+import io.quarkus.runtime.annotations.ConfigPhase;","+import io.quarkus.runtime.annotations.ConfigRoot;","+import io.smallrye.config.ConfigMapping;","+import io.smallrye.config.WithDefault;","+import io.smallrye.config.WithName;","+","+@ConfigMapping(prefix = \"quarkus.http.rate-limit\")","+@ConfigRoot(phase = ConfigPhase.BUILD_TIME)","+public interface HttpRateLimitMicrometerBuildTimeConfig {","+    /**","+     * Whether metrics about rate limiting should be published to Micrometer.","+     */","+    @WithDefault(\"true\")","+    @WithName(\"metrics.enabled\")","+    boolean metricsEnabled();","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/micrometer/deployment/src/main/java/io/quarkus/http/ratelimit/micrometer/deployment/HttpRateLimitMicrometerProcessor.java","lines":["@@ -0,0 +1,17 @@","+package io.quarkus.http.ratelimit.micrometer.deployment;","+","+import io.quarkus.arc.deployment.AdditionalBeanBuildItem;","+import io.quarkus.deployment.annotations.BuildProducer;","+import io.quarkus.deployment.annotations.BuildStep;","+import io.quarkus.http.ratelimit.micrometer.runtime.internal.HttpRateLimitMetrics;","+","+public class HttpRateLimitMicrometerProcessor {","+","+    @BuildStep","+    void metrics(HttpRateLimitMicrometerBuildTimeConfig config, BuildProducer<AdditionalBeanBuildItem> beans) {","+        if (!config.metricsEnabled()) {","+            return;","+        }","+        beans.produce(AdditionalBeanBuildItem.builder().addBeanClass(HttpRateLimitMetrics.class).build());","+    }","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/micrometer/deployment/src/test/java/io/quarkus/http/ratelimit/DisabledWithMicrometerTest.java","lines":["@@ -0,0 +1,62 @@","+package io.quarkus.http.ratelimit;","+","+import static io.quarkus.http.ratelimit.MetricsScrape.assertScrape;","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.net.URL;","+","+import jakarta.inject.Inject;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.vertx.core.Vertx;","+","+/**","+ * A disabled extension validates nothing at startup, even when Micrometer instantiates its meter binder.","+ */","+public class DisabledWithMicrometerTest {","+","+    private static final String PREFIX = \"quarkus.http.rate-limit.rules.api.\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest()","+            .withApplicationRoot(jar -> jar.addClasses(TestHttp.class, TestClient.class, TestHttp.Resource.class,","+                    MetricsScrape.class))","+            .overrideRuntimeConfigKey(\"quarkus.http.rate-limit.enabled\", \"false\")","+            // invalid at startup: a rule without a positive limit, and a store timeout of zero","+            .overrideRuntimeConfigKey(\"quarkus.http.rate-limit.store-timeout\", \"0s\")","+            .overrideConfigKey(PREFIX + \"paths\", \"/*\")","+            .overrideConfigKey(PREFIX + \"phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"request-key\", \"ip\")","+            .overrideRuntimeConfigKey(PREFIX + \"permits\", \"0\")","+            .overrideRuntimeConfigKey(PREFIX + \"window\", \"1m\");","+","+    @Inject","+    Vertx vertx;","+","+    @TestHTTPResource","+    URL url;","+","+    TestClient http;","+","+    @BeforeEach","+    void createClient() {","+        http = new TestClient(vertx, url);","+    }","+","+    @AfterEach","+    void closeClient() {","+        http.close();","+    }","+","+    @Test","+    void startsAndRegistersNothing() {","+        assertThat(http.get(\"/x\").statusCode()).isEqualTo(200);","+        assertScrape(http).doesNotHaveMetricNameContaining(\"http_rate_limit_requests\");","+    }","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/micrometer/deployment/src/test/java/io/quarkus/http/ratelimit/LeaseBothPhasesTest.java","lines":["@@ -0,0 +1,90 @@","+package io.quarkus.http.ratelimit;","+","+import static io.quarkus.http.ratelimit.MetricsScrape.assertScrape;","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.assertj.core.api.Assertions.entry;","+","+import java.net.URL;","+import java.util.List;","+","+import jakarta.inject.Inject;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.builder.Version;","+import io.quarkus.http.ratelimit.store.SwitchableTestStore;","+import io.quarkus.maven.dependency.Dependency;","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.vertx.core.Vertx;","+","+/**","+ * A path limited in both phases by two lease rules: an unauthenticated request resolves {@code ip:<addr>} in both","+ * phases, and each rule holds its own chunk under its own policy id.","+ */","+public class LeaseBothPhasesTest {","+","+    private static final String PRE = \"quarkus.http.rate-limit.rules.pre.\";","+    private static final String POST = \"quarkus.http.rate-limit.rules.post.\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = TestHttp.withUsers(SwitchableStoreApp.create(\"local\", MetricsScrape.class))","+            .overrideConfigKey(PRE + \"paths\", \"/*\")","+            .overrideConfigKey(PRE + \"phase\", \"pre-authentication\")","+            .overrideConfigKey(PRE + \"store\", \"switchable\")","+            .overrideRuntimeConfigKey(PRE + \"lease-size\", \"4\")","+            .overrideConfigKey(PRE + \"request-key\", \"ip\")","+            .overrideRuntimeConfigKey(PRE + \"permits\", \"8\")","+            .overrideRuntimeConfigKey(PRE + \"window\", \"1m\")","+            .overrideConfigKey(POST + \"paths\", \"/*\")","+            .overrideConfigKey(POST + \"phase\", \"post-authentication\")","+            .overrideConfigKey(POST + \"store\", \"switchable\")","+            .overrideRuntimeConfigKey(POST + \"lease-size\", \"4\")","+            .overrideConfigKey(POST + \"request-key\", \"principal\")","+            .overrideRuntimeConfigKey(POST + \"permits\", \"8\")","+            .overrideRuntimeConfigKey(POST + \"window\", \"1m\")","+            .setForcedDependencies(","+                    List.of(Dependency.of(\"io.quarkus\", \"quarkus-elytron-security-properties-file-deployment\",","+                            Version.getVersion())));","+","+    @Inject","+    Vertx vertx;","+","+    @TestHTTPResource","+    URL url;","+","+    TestClient http;","+","+    @BeforeEach","+    void createClient() {","+        http = new TestClient(vertx, url);","+    }","+","+    @AfterEach","+    void closeClient() {","+        http.close();","+    }","+","+    @BeforeEach","+    void reset() {","+        SwitchableTestStore.reset();","+    }","+","+    @Test","+    void eachRuleHoldsItsOwnChunk() {","+        assertThat(http.get(\"/x\").statusCode()).isEqualTo(200);","+        assertThat(http.get(\"/x\").statusCode()).isEqualTo(200);","+        // two claims per request (one per rule), each sized 1 then 2; no policy-change reset","+        assertThat(SwitchableTestStore.costs).containsExactly(1L, 1L, 2L, 2L);","+        assertScrape(http)","+                .hasMetricWithLabelsAndValue(\"http_rate_limit_keys\", 1, entry(\"rule\", \"pre\"),","+                        entry(\"phase\", \"pre-authentication\"))","+                .hasMetricWithLabelsAndValue(\"http_rate_limit_keys\", 1, entry(\"rule\", \"post\"),","+                        entry(\"phase\", \"post-authentication\"))","+                .hasMetricWithLabelsAndValue(\"http_rate_limit_lease_stranded_total\", 0,","+                        entry(\"phase\", \"pre-authentication\"));","+    }","+}"],"additions":90,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/micrometer/deployment/src/test/java/io/quarkus/http/ratelimit/LoadSheddingInteractionApp.java","lines":["@@ -0,0 +1,236 @@","+package io.quarkus.http.ratelimit;","+","+import static io.quarkus.http.ratelimit.MetricsScrape.assertScrape;","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.awaitility.Awaitility.await;","+","+import java.net.URL;","+import java.util.ArrayList;","+import java.util.HashMap;","+import java.util.List;","+import java.util.Map;","+import java.util.Optional;","+import java.util.Queue;","+import java.util.concurrent.CompletableFuture;","+import java.util.concurrent.ConcurrentHashMap;","+import java.util.concurrent.ConcurrentLinkedQueue;","+import java.util.concurrent.TimeUnit;","+","+import jakarta.enterprise.event.Observes;","+import jakarta.inject.Singleton;","+","+import io.quarkus.builder.Version;","+import io.quarkus.http.ratelimit.runtime.internal.RateLimitFilter;","+import io.quarkus.maven.dependency.Dependency;","+import io.quarkus.test.QuarkusExtensionTest;","+import io.vertx.core.Vertx;","+import io.vertx.core.buffer.Buffer;","+import io.vertx.core.http.PoolOptions;","+import io.vertx.ext.web.Router;","+import io.vertx.ext.web.RoutingContext;","+import io.vertx.ext.web.client.HttpRequest;","+import io.vertx.ext.web.client.HttpResponse;","+import io.vertx.ext.web.client.WebClient;","+import io.vertx.ext.web.client.WebClientOptions;","+","+/**","+ * The application of the load shedding interaction tests, configured like {@code ExemptPathsSurviveLoadSheddingTest}","+ * in the load shedding extension: a fixed concurrency limit of {@link #LIMIT}, pure load shedding (no priorities) and a","+ * single event loop.","+ * <p>","+ * Routes: {@code /hold} keeps its requests open until {@link #releaseHolds()}, {@code /answer} answers at once, and","+ * {@code /slow} and {@code /auth/*} answer after {@link #SLOW_MILLIS}; all of them run after both rate limit hooks.","+ * A request carrying {@code X-Probe} has the value of {@link RateLimitFilter#SKIP_SAMPLE_KEY}, as load shedding reads it","+ * when the response ends, recorded in {@link #skipSample}.","+ */","+final class LoadSheddingInteractionApp {","+","+    static final int LIMIT = 5;","+","+    static final List<Dependency> DEPENDENCIES = List.of(","+            Dependency.of(\"io.quarkus\", \"quarkus-load-shedding-deployment\", Version.getVersion()),","+            Dependency.of(\"io.quarkus\", \"quarkus-smallrye-health-deployment\", Version.getVersion()));","+","+    // copies of the constants of HttpLoadShedding and LoadSheddingMetrics, the meter names as the Prometheus scrape","+    // shows them: load shedding is only forced into the application, it is not on the test compile classpath","+    static final int LOAD_SHEDDING_PRIORITY = -1_000_000_000;","+    static final String SHED_REQUESTS = \"load_shedding_shed_requests_total\";","+    static final String CURRENT_REQUESTS = \"load_shedding_current_requests\";","+    static final String CURRENT_LIMIT = \"load_shedding_current_limit_requests\";","+    static final String OVERLOAD_STATUS = \"load_shedding_overload_status\";","+","+    static final long SLOW_MILLIS = 100;","+","+    // the permitted /hold requests, held open so that they stay in flight and the overload persists","+    static final Queue<RoutingContext> held = new ConcurrentLinkedQueue<>();","+","+    // X-Probe value -> the skip-sample marking when the response ended; empty when the key was absent","+    static final Map<String, Optional<Object>> skipSample = new ConcurrentHashMap<>();","+","+    private LoadSheddingInteractionApp() {","+    }","+","+    static QuarkusExtensionTest create(Class<?>... classes) {","+        return new QuarkusExtensionTest()","+                .withApplicationRoot(jar -> jar.addClasses(Routes.class, LoadSheddingInteractionApp.class, TestHttp.class,","+                        TestRateLimitClock.class, TestClient.class, MetricsScrape.class).addClasses(classes))","+                .setForcedDependencies(DEPENDENCIES)","+                // the default minimum is above the limits this test uses","+                .overrideConfigKey(\"quarkus.load-shedding.min-limit\", \"1\")","+                .overrideConfigKey(\"quarkus.load-shedding.initial-limit\", \"\" + LIMIT)","+                .overrideConfigKey(\"quarkus.load-shedding.max-limit\", \"\" + LIMIT)","+                .overrideConfigKey(\"quarkus.load-shedding.priority.enabled\", \"false\")","+                // a single event loop handles all incoming requests one after another, so that","+                // the overload check and the following increment of the request counter cannot","+                // interleave and permit more requests than the limit allows","+                .overrideConfigKey(\"quarkus.vertx.event-loops-pool-size\", \"1\");","+    }","+","+    /**","+     * Lets the overload detector adapt the limit at all. The limit starts at its maximum, so it can only decrease, and","+     * it decreases when the estimated queue exceeds {@code beta-factor * (1 + log10(limit))}; with the default factor","+     * of 6 that is more than the limit of 5 itself, which no queue estimate ever reaches. With a factor of 3, the limit","+     * decreases once a request takes at least 2.5 times the lowest latency seen: a 429 of some microseconds taken as the","+     * baseline against a {@code /slow} request does that by a factor of a thousand, while the jitter of {@code /slow}","+     * requests among themselves never comes close.","+     * <p>","+     * A probe resets the lowest latency to that of the request it happens on, every {@code 30 * limit} requests or so by","+     * default, at a jittered count. One that fell on the normal traffic would erase a wrong baseline before it is","+     * compared against, and let a broken marking pass now and then, so probes are pushed out of reach of these tests.","+     */","+    static QuarkusExtensionTest adaptive(QuarkusExtensionTest test) {","+        return test.overrideConfigKey(\"quarkus.load-shedding.alpha-factor\", \"1\")","+                .overrideConfigKey(\"quarkus.load-shedding.beta-factor\", \"3\")","+                .overrideConfigKey(\"quarkus.load-shedding.probe-factor\", \"1000\");","+    }","+","+    static WebClient client(Vertx vertx) {","+        return WebClient.create(vertx, new WebClientOptions().setPipelining(false),","+                new PoolOptions().setHttp1MaxSize(4 * LIMIT));","+    }","+","+    static CompletableFuture<HttpResponse<Buffer>> sendAsync(Vertx vertx, WebClient client, URL url, String path,","+            Map<String, String> headers) {","+        CompletableFuture<HttpResponse<Buffer>> result = new CompletableFuture<>();","+        vertx.runOnContext(ignored -> {","+            HttpRequest<Buffer> request = client.get(url.getPort(), url.getHost(), path);","+            headers.forEach(request::putHeader);","+            request.send().onSuccess(result::complete).onFailure(result::completeExceptionally);","+        });","+        return result;","+    }","+","+    static HttpResponse<Buffer> get(Vertx vertx, WebClient client, URL url, String path, Map<String, String> headers) {","+        return TestHttp.get(vertx, client, url, path, headers);","+    }","+","+    static int status(Vertx vertx, WebClient client, URL url, String path, String clientKey) {","+        return get(vertx, client, url, path, Map.of(\"X-Client\", clientKey)).statusCode();","+    }","+","+    /**","+     * Sends {@link #LIMIT} requests to {@code /hold} and waits until all of them are held, which leaves the application","+     * overloaded until {@link #releaseHolds()}.","+     *","+     * @return the responses to the held requests","+     */","+    static List<CompletableFuture<HttpResponse<Buffer>>> overload(Vertx vertx, WebClient client, URL url,","+            String clientKey) throws InterruptedException {","+        List<CompletableFuture<HttpResponse<Buffer>>> holds = new ArrayList<>();","+        for (int i = 0; i < LIMIT; i++) {","+            holds.add(sendAsync(vertx, client, url, \"/hold\", Map.of(\"X-Client\", clientKey)));","+        }","+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);","+        while (held.size() < LIMIT && System.nanoTime() < deadline) {","+            Thread.sleep(10);","+        }","+        assertThat(held).hasSize(LIMIT);","+        return holds;","+    }","+","+    static void releaseHolds() {","+        RoutingContext ctx;","+        while ((ctx = held.poll()) != null) {","+            RoutingContext request = ctx;","+            request.vertx().runOnContext(ignored -> request.response().end());","+        }","+    }","+","+    /**","+     * Sends 10 requests to {@code /slow}, at most 4 at a time. The detector only adapts the limit on requests that end","+     * while at least half of the limit is in flight; with 4 in flight against a limit of 5, the first two requests of","+     * each round of 4 to end do, so the limit could change here at all.","+     */","+    static void normalTraffic(Vertx vertx, WebClient client, URL url) throws Exception {","+        int sent = 0;","+        while (sent < 10) {","+            List<CompletableFuture<HttpResponse<Buffer>>> round = new ArrayList<>();","+            for (int i = 0; i < 4 && sent < 10; i++, sent++) {","+                round.add(sendAsync(vertx, client, url, \"/slow\", Map.of(\"X-Client\", \"normal\")));","+            }","+            for (CompletableFuture<HttpResponse<Buffer>> response : round) {","+                HttpResponse<Buffer> served = response.get(10, TimeUnit.SECONDS);","+                assertThat(served.statusCode()).isEqualTo(200);","+                assertThat(served.bodyAsString()).isEqualTo(\"slow\");","+            }","+        }","+    }","+","+    /**","+     * Asserts that the detector neither signals an overload nor has adapted its limit, once every request has ended.","+     */","+    static void assertDetectorUndisturbed(Vertx vertx, URL url) {","+        TestClient http = new TestClient(vertx, url);","+        try {","+            // the end handlers run once the response is written, possibly after the client has seen it; the scrape","+            // is itself a request in flight, so 1 means that every other request has ended","+            await().atMost(5, TimeUnit.SECONDS).pollInterval(10, TimeUnit.MILLISECONDS)","+                    .untilAsserted(() -> assertScrape(http).hasMetricWithLabelsAndValue(CURRENT_REQUESTS, 1));","+            assertScrape(http)","+                    .hasMetricWithLabelsAndValue(OVERLOAD_STATUS, 0)","+                    .hasMetricWithLabelsAndValue(CURRENT_LIMIT, LIMIT);","+        } finally {","+            http.close();","+        }","+    }","+","+    static Map<String, String> probe(String id, Map<String, String> headers) {","+        Map<String, String> result = new HashMap<>(headers);","+        result.put(\"X-Probe\", id);","+        return result;","+    }","+","+    // the end handler runs once the response is written, possibly after the client has seen it","+    static Optional<Object> recorded(String id) throws InterruptedException {","+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);","+        while (!skipSample.containsKey(id) && System.nanoTime() < deadline) {","+            Thread.sleep(10);","+        }","+        assertThat(skipSample).containsKey(id);","+        return skipSample.get(id);","+    }","+","+    @Singleton","+    public static class Routes {","+","+        void init(@Observes Router router) {","+            // right after load shedding, so that the end handler sees what load shedding sees","+            router.route().order(LOAD_SHEDDING_PRIORITY + 1).handler(ctx -> {","+                String probe = ctx.request().getHeader(\"X-Probe\");","+                if (probe != null) {","+                    ctx.addEndHandler(","+                            ignored -> skipSample.put(probe, Optional.ofNullable(ctx.get(RateLimitFilter.SKIP_SAMPLE_KEY))));","+                }","+                ctx.next();","+            });","+            router.get(\"/hold\").handler(held::add);","+            router.get(\"/answer\").handler(ctx -> ctx.end(\"answer\"));","+            router.get(\"/slow\").handler(LoadSheddingInteractionApp.Routes::slow);","+            router.get(\"/auth/*\").handler(LoadSheddingInteractionApp.Routes::slow);","+        }","+","+        private static void slow(RoutingContext ctx) {","+            ctx.vertx().setTimer(SLOW_MILLIS, ignored -> ctx.end(\"slow\"));","+        }","+    }","+}"],"additions":236,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/micrometer/deployment/src/test/java/io/quarkus/http/ratelimit/LoadSheddingInteractionFailureTest.java","lines":["@@ -0,0 +1,75 @@","+package io.quarkus.http.ratelimit;","+","+import static io.quarkus.http.ratelimit.LoadSheddingInteractionApp.status;","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.net.URL;","+import java.util.Map;","+","+import jakarta.inject.Inject;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.http.ratelimit.store.SwitchableTestStore;","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.vertx.core.Vertx;","+import io.vertx.ext.web.client.WebClient;","+","+/**","+ * Every terminal response of the limiter skips the latency sample, not only the 429: here the 503 of a failed store"],"additions":22,"deletions":0,"truncated":false}],"additions":610,"deletions":2,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-19T17:59:26.362484+00:00"}