Limits(t *testing.T) {"," \t}"," }"," ","+func TestDistributor_ObserveLimitsServiceShardShadow(t *testing.T) {","+\t// The hash of {foo=\"bar\"}, the stream pushed below.","+\tconst streamHash = 0x90eb45def17f924","+","+\ttests := []struct {","+\t\tname string","+\t\t// shardStreamsEnabled controls the local rate store's sharding. It has","+\t\t// to be true for candidates to be collected at all, see","+\t\t// maybeShardByRate: there is nothing to compare against otherwise.","+\t\tshardStreamsEnabled            bool","+\t\tcheckLimitsAndShardResponse    *limitsproto.CheckLimitsAndShardResponse","+\t\tcheckLimitsAndShardResponseErr error","+\t\texpectDivergence               bool","+\t\texpectUnimplemented            bool","+\t\texpectFailed                   bool","+\t\texpectRejected                 bool","+\t\texpectCompared                 bool","+\t\texpectCapped                   bool","+\t}{{","+\t\t// Shadow mode must not change what is pushed: the push succeeds as it","+\t\t// would with the mode disabled, whatever the RPC does.","+\t\tname:                           \"the whole call fails: the push still succeeds\",","+\t\tshardStreamsEnabled:            true,","+\t\tcheckLimitsAndShardResponseErr: errors.New(\"shadow RPC unavailable\"),","+\t\t// No candidate was observed, which still has to count against the","+\t\t// coverage metrics rather than disappear from them.","+\t\texpectFailed: true,","+\t}, {","+\t\tname:                           \"the service does not support the RPC: reported separately\",","+\t\tshardStreamsEnabled:            true,","+\t\tcheckLimitsAndShardResponseErr: status.Error(codes.Unimplemented, \"unknown method CheckLimitsAndShard\"),","+\t\texpectUnimplemented:            true,","+\t\texpectFailed:                   true,","+\t}, {","+\t\t// The local rate store says one shard, as it has no history for this","+\t\t// stream yet, and the service says three.","+\t\tname:                \"the service asks for a different shard count: recorded as a divergence\",","+\t\tshardStreamsEnabled: true,","+\t\tcheckLimitsAndShardResponse: &limitsproto.CheckLimitsAndShardResponse{","+\t\t\tResults: []*limitsproto.StreamShardResult{{StreamHash: streamHash, Shards: 3}},","+\t\t},","+\t\texpectDivergence: true,","+\t\texpectCompared:   true,","+\t}, {","+\t\tname:                        \"the stream has no result: not compared\",","+\t\tshardStreamsEnabled:         true,","+\t\tcheckLimitsAndShardResponse: &limitsproto.CheckLimitsAndShardResponse{},","+\t\texpectFailed:                true,","+\t}, {","+\t\tname:                \"the service could not check the stream: not compared\",","+\t\tshardStreamsEnabled: true,","+\t\tcheckLimitsAndShardResponse: &limitsproto.CheckLimitsAndShardResponse{","+\t\t\tResults: []*limitsproto.StreamShardResult{{","+\t\t\t\tStreamHash: streamHash,","+\t\t\t\tShards:     1,","+\t\t\t\tStats:      &limitsproto.ShardStats{ShardDecisionContext: uint32(limits.ReasonFailed)},","+\t\t\t}},","+\t\t},","+\t\texpectFailed: true,","+\t}, {","+\t\tname:                \"the answering instance does not own the partition: not compared\",","+\t\tshardStreamsEnabled: true,","+\t\tcheckLimitsAndShardResponse: &limitsproto.CheckLimitsAndShardResponse{","+\t\t\tResults: []*limitsproto.StreamShardResult{{","+\t\t\t\tStreamHash: streamHash,","+\t\t\t\tShards:     1,","+\t\t\t\tStats:      &limitsproto.ShardStats{ShardDecisionContext: uint32(limits.ReasonNotOwned)},","+\t\t\t}},","+\t\t},","+\t\texpectFailed: true,","+\t}, {","+\t\t// A difference in kind rather than in shard count, as the local rate","+\t\t// store never rejects a stream.","+\t\tname:                \"the service rejects the stream: counted separately\",","+\t\tshardStreamsEnabled: true,","+\t\tcheckLimitsAndShardResponse: &limitsproto.CheckLimitsAndShardResponse{","+\t\t\tResults: []*limitsproto.StreamShardResult{{","+\t\t\t\tStreamHash:   streamHash,","+\t\t\t\tShards:       0,","+\t\t\t\tRejectReason: limits.ReasonMaxStreams.String(),","+\t\t\t}},","+\t\t},","+\t\texpectRejected: true,","+\t}, {","+\t\t// A capped count that still matches is a real observation: counted as","+\t\t// compared and capped, but not as a divergence.","+\t\tname:                \"the service caps the count but still agrees: compared and capped\",","+\t\tshardStreamsEnabled: true,","+\t\tcheckLimitsAndShardResponse: &limitsproto.CheckLimitsAndShardResponse{","+\t\t\tResults: []*limitsproto.StreamShardResult{{","+\t\t\t\tStreamHash: streamHash,","+\t\t\t\tShards:     1,","+\t\t\t\tStats:      &limitsproto.ShardStats{ShardDecisionContext: uint32(limits.ReasonStreamShardsCapped)},","+\t\t\t}},","+\t\t},","+\t\texpectCompared: true,","+\t\texpectCapped:   true,","+\t}}","+","+\tfor _, test := range tests {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\tvalidationLimits := &validation.Limits{}","+\t\t\tflagext.DefaultValues(validationLimits)","+\t\t\tvalidationLimits.ShardStreams.LimitsServiceStreamShardingMode = shardstreams.LimitsServiceStreamShardingModeShadow","+\t\t\tvalidationLimits.ShardStreams.Enabled = test.shardStreamsEnabled","+\t\t\tdistributors, _ := prepare(t, 1, 3, validationLimits, nil)","+\t\t\td := distributors[0]","+\t\t\t// Shadow mode shares this switch with the ExceedsLimits check.","+\t\t\td.cfg.IngestLimitsEnabled = true","+","+\t\t\tmockClient := mockIngestLimitsFrontendClient{","+\t\t\t\tt: t,","+\t\t\t\t// Non-nil so that the ExceedsLimits call, which the same","+\t\t\t\t// switch enables, accepts every stream instead of failing on a","+\t\t\t\t// nil response.","+\t\t\t\texceedsLimitsResponse:          &limitsproto.ExceedsLimitsResponse{},","+\t\t\t\tcheckLimitsAndShardResponse:    test.checkLimitsAndShardResponse,","+\t\t\t\tcheckLimitsAndShardResponseErr: test.checkLimitsAndShardResponseErr,","+\t\t\t}","+\t\t\td.ingestLimits = newIngestLimits(&mockClient, prometheus.NewRegistry())","+","+\t\t\tctx = user.InjectOrgID(context.Background(), \"test\")","+\t\t\tresp, err := d.Push(ctx, &logproto.PushRequest{","+\t\t\t\tStreams: []logproto.Stream{{","+\t\t\t\t\tLabels: `{foo=\"bar\"}`,","+\t\t\t\t\tEntries: []logproto.Entry{{","+\t\t\t\t\t\tTimestamp: time.Now(),","+\t\t\t\t\t\tLine:      \"baz\",","+\t\t\t\t\t}},","+\t\t\t\t}},","+\t\t\t})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, success, resp)","+","+\t\t\t// Every counter is asserted, not just the one this case expects to","+\t\t\t// increment. A stream is failed, rejected or compared, never more","+\t\t\t// than one, so double counting has to fail here.","+\t\t\twant := func(b bool) float64 {","+\t\t\t\tif b {","+\t\t\t\t\treturn 1","+\t\t\t\t}","+\t\t\t\treturn 0","+\t\t\t}","+\t\t\tfor _, c := range []struct {","+\t\t\t\tname    string","+\t\t\t\tcounter *prometheus.CounterVec","+\t\t\t\texpect  bool","+\t\t\t}{","+\t\t\t\t{\"divergence\", d.m.limitsServiceShardShadowDivergence, test.expectDivergence},","+\t\t\t\t{\"failed\", d.m.limitsServiceShardShadowFailed, test.expectFailed},","+\t\t\t\t{\"rejected\", d.m.limitsServiceShardShadowRejected, test.expectRejected},","+\t\t\t\t{\"compared\", d.m.limitsServiceShardShadowCompared, test.expectCompared},","+\t\t\t\t{\"capped\", d.m.limitsServiceShardShadowCapped, test.expectCapped},","+\t\t\t} {","+\t\t\t\trequire.Equal(t, want(c.expect), sumCounterVec(t, c.counter), \"counter %s\", c.name)","+\t\t\t}","+","+\t\t\t// The shadow call records the latency it adds whatever its outcome,","+\t\t\t// and the ExceedsLimits call is timed alongside it so the two can be","+\t\t\t// compared. Once each per push.","+\t\t\tvar shard dto.Metric","+\t\t\trequire.NoError(t, d.m.limitsServiceShardDuration.Write(&shard))","+\t\t\trequire.Equal(t, uint64(1), shard.GetHistogram().GetSampleCount())","+\t\t\tvar exceeds dto.Metric","+\t\t\trequire.NoError(t, d.m.limitsServiceExceedsLimitsDuration.Write(&exceeds))","+\t\t\trequire.Equal(t, uint64(1), exceeds.GetHistogram().GetSampleCount())","+\t\t})","+\t}","+}","+","+// sumCounterVec sums a counter vector over all of its series, and returns 0","+// when none were incremented.","+func sumCounterVec(t *testing.T, c prometheus.Collector) float64 {","+\tt.Helper()","+\tch := make(chan prometheus.Metric, 16)","+\tc.Collect(ch)","+\tclose(ch)","+\tvar total float64","+\tfor m := range ch {","+\t\tvar dm dto.Metric","+\t\trequire.NoError(t, m.Write(&dm))","+\t\ttotal += dm.GetCounter().GetValue()","+\t}","+\treturn total","+}","+"," func TestDistributorMaxInflightBytesLimit(t *testing.T) {"," \tvalidationLimits := &validation.Limits{}"," \tflagext.DefaultValues(validationLimits)"],"additions":207,"deletions":3,"truncated":false},{"path":"pkg/distributor/ingest_limits.go","lines":["@@ -20,6 +20,7 @@ import ("," type ingestLimitsFrontendClient interface {"," \tExceedsLimits(context.Context, *proto.ExceedsLimitsRequest) (*proto.ExceedsLimitsResponse, error)"," \tUpdateRates(context.Context, *proto.UpdateRatesRequest) (*proto.UpdateRatesResponse, error)","+\tCheckLimitsAndShard(context.Context, *proto.CheckLimitsAndShardRequest) (*proto.CheckLimitsAndShardResponse, error)"," }"," "],"additions":1,"deletions":0,"truncated":false}],"additions":368,"deletions":107,"truncated":true,"file_count":4},"error":null,"fetched_at":"2026-09-23T14:14:29.480646+00:00"}