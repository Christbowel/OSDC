oto.PushRe"," \t// We also work out the hash value at the same time."," \tstreams := make([]KeyedStream, 0, len(req.Streams))"," ","+\t// Candidates for tenants in shadow mode, see","+\t// shardstreams.Config.LimitsServiceStreamShardingMode. The local rate","+\t// store still shards these streams; the limits service is only asked for","+\t// its opinion. Collected by maybeShardByRate below and observed once after","+\t// the validation loop.","+\tvar shadowCandidates []limitsServiceShardCandidate","+"," \tvar validationErrors util.GroupedErrors"," "," \tnow := time.Now()","@@ -709,7 +618,25 @@ func (d *Distributor) pushWithResolver(ctx context.Context, req *logproto.PushRe"," \t// (e.g. toggle time sharding or use a different desired_rate)."," \tmaybeShardByRate := func(stream logproto.Stream, pushSize int, policy string, shardStreamsCfg shardstreams.Config) {"," \t\tif shardStreamsCfg.Enabled {","-\t\t\tstreams = append(streams, d.shardStream(stream, pushSize, tenantID, policy, shardStreamsCfg)...)","+\t\t\tsharded, shardCount := d.shardStream(stream, pushSize, tenantID, policy, shardStreamsCfg)","+\t\t\tstreams = append(streams, sharded...)","+","+\t\t\tif shardStreamsCfg.LimitsServiceStreamShardingMode == shardstreams.LimitsServiceStreamShardingModeShadow {","+\t\t\t\t// shardCount is shardCountFor's recommendation rather than","+\t\t\t\t// len(sharded), which createShards limits to the number of","+\t\t\t\t// entries and which would look like a difference of opinion","+\t\t\t\t// for a small push on a hot stream. pushSize is passed on as","+\t\t\t\t// it is, so that the limits service sees the same size the","+\t\t\t\t// rate store just used.","+\t\t\t\trateStoreRate, _ := d.rateStore.RateFor(tenantID, stream.Hash)","+\t\t\t\tshadowCandidates = append(shadowCandidates, limitsServiceShardCandidate{","+\t\t\t\t\tstream:          stream,","+\t\t\t\t\tpolicy:          policy,","+\t\t\t\t\trateStoreShards: shardCount,","+\t\t\t\t\trateStoreRate:   rateStoreRate,","+\t\t\t\t\ttotalSize:       uint64(pushSize),","+\t\t\t\t})","+\t\t\t}"," \t\t\treturn"," \t\t}"," \t\tstreams = append(streams, KeyedStream{","@@ -940,7 +867,13 @@ func (d *Distributor) pushWithResolver(ctx context.Context, req *logproto.PushRe"," \t// These limits are checked after the ingestion rate limit as this"," \t// is how it works in ingesters."," \tif d.cfg.IngestLimitsEnabled {","+\t\tif len(shadowCandidates) > 0 {","+\t\t\td.observeLimitsServiceShardShadow(ctx, tenantID, shadowCandidates)","+\t\t}","+","+\t\tenforceTimer := prometheus.NewTimer(d.m.limitsServiceExceedsLimitsDuration)"," \t\taccepted, rejected, err := d.ingestLimits.EnforceLimits(ctx, tenantID, streams)","+\t\tenforceTimer.ObserveDuration()"," \t\tif err == nil && !d.cfg.IngestLimitsDryRunEnabled {"," \t\t\tif len(rejected) > 0 {"," \t\t\t\tdiscardedStreams := make([]logproto.Stream, 0, len(rejected))","@@ -1341,17 +1274,123 @@ func shardStreamByTime(stream logproto.Stream, lbls labels.Labels, timeShardLen"," \t}), true"," }"," ","+// limitsServiceShardCandidate is a logical (pre-shard) stream whose tenant is","+// in shadow mode. rateStoreShards is shardCountFor's recommendation for this","+// push, which is not necessarily the number of streams it produced, see","+// shardStream. totalSize is the same push size the rate store was given.","+type limitsServiceShardCandidate struct {","+\tstream          logproto.Stream","+\tpolicy          string","+\trateStoreShards int","+\trateStoreRate   int64","+\ttotalSize       uint64","+}","+","+// observeLimitsServiceShardShadow asks the ingest-limits service for a shard","+// count for each candidate and compares it against the count the local rate","+// store produced. It never changes what is written.","+//","+// It runs synchronously, on the push path, with a short timeout.","+func (d *Distributor) observeLimitsServiceShardShadow(ctx context.Context, tenantID string, candidates []limitsServiceShardCandidate) {","+\t// Deferred so that every path, success, failure and Unimplemented alike,","+\t// records the latency shadow mode adds.","+\tdefer prometheus.NewTimer(d.m.limitsServiceShardDuration).ObserveDuration()","+","+\tshadowCtx, cancel := context.WithTimeout(ctx, 2*time.Second)","+\tdefer cancel()","+\tresults, err := d.ingestLimits.CheckLimitsAndShard(shadowCtx, tenantID, candidates)","+\tif err != nil {","+\t\t// None of the candidates were observed, so count them all as failed","+\t\t// rather than leaving them out of the coverage metrics.","+\t\td.m.limitsServiceShardShadowFailed.WithLabelValues(tenantID).Add(float64(len(candidates)))","+\t\tif status.Code(err) == codes.Unimplemented {","+\t\t\t// The service predates the RPC, for instance during a rollout.","+\t\t\tlevel.Warn(d.logger).Log(\"msg\", \"shadow mode CheckLimitsAndShard call returned Unimplemented; the limits service may predate this RPC\", \"tenant\", tenantID)","+\t\t\treturn","+\t\t}","+\t\tlevel.Debug(d.logger).Log(\"msg\", \"failed shadow mode CheckLimitsAndShard call\", \"tenant\", tenantID, \"err\", err)","+\t\treturn","+\t}","+\tfor _, c := range candidates {","+\t\tresult, ok := results[c.stream.Hash]","+\t\tswitch {","+\t\tcase !ok,","+\t\t\tresult.GetStats().GetShardDecisionContext() == uint32(limits.ReasonFailed),","+\t\t\tresult.GetStats().GetShardDecisionContext() == uint32(limits.ReasonNotOwned):","+\t\t\t// Not a usable observation: there was no answer, the service could","+\t\t\t// not check the stream, or the instance that answered does not own","+\t\t\t// its partition. Comparing it would report agreement or","+\t\t\t// disagreement that does not exist.","+\t\t\td.m.limitsServiceShardShadowFailed.WithLabelValues(tenantID).Inc()","+\t\tcase result.RejectReason != \"\":","+\t\t\t// A difference in kind rather than in shard count: the local rate","+\t\t\t// store never rejects a stream.","+\t\t\td.m.limitsServiceShardShadowRejected.WithLabelValues(tenantID).Inc()","+\t\tdefault:","+\t\t\tresultShards := int(result.Shards)","+\t\t\tsharding := shardingState(c.rateStoreShards, resultShards)","+\t\t\td.m.limitsServiceShardShadowCompared.WithLabelValues(tenantID, sharding).Inc()","+\t\t\t// Record both rates so their distributions can be compared as","+\t\t\t// heatmaps. Both are sustained rates, before this push is","+\t\t\t// amortized on top.","+\t\t\td.m.limitsServiceShardShadowStreamRate.WithLabelValues(tenantID, \"rate_store\").Observe(float64(c.rateStoreRate))","+\t\t\td.m.limitsServiceShardShadowStreamRate.WithLabelValues(tenantID, \"limits\").Observe(float64(result.GetStats().GetEvaluatedRate()))","+\t\t\tif result.GetStats().GetShardDecisionContext() == uint32(limits.ReasonStreamShardsCapped) {","+\t\t\t\td.m.limitsServiceShardShadowCapped.WithLabelValues(tenantID).Inc()","+\t\t\t}","+\t\t\tif resultShards != c.rateStoreShards {","+\t\t\t\td.m.limitsServiceShardShadowDivergence.WithLabelValues(tenantID, sharding).Inc()","+\t\t\t\t// Record the gap as a positive magnitude tagged by direction,","+\t\t\t\t// so over- and under-sharding are separate distributions.","+\t\t\t\tdirection := \"over\"","+\t\t\t\tmagnitude := resultShards - c.rateStoreShards","+\t\t\t\tif magnitude < 0 {","+\t\t\t\t\tdirection = \"under\"","+\t\t\t\t\tmagnitude = -magnitude","+\t\t\t\t}","+\t\t\t\td.m.limitsServiceShardShadowDivergenceMagnitude.WithLabelValues(tenantID, direction).Observe(float64(magnitude))","+\t\t\t\tlevel.Debug(log.With(util_log.WithUserID(tenantID, d.logger), \"stream\", c.stream.Labels)).Log(","+\t\t\t\t\t\"msg\", \"shard count shadow divergence\",","+\t\t\t\t\t\"rate_store_shards\", c.rateStoreShards,","+\t\t\t\t\t\"limits_service_shards\", resultShards,","+\t\t\t\t\t\"rate_store_rate\", c.rateStoreRate,","+\t\t\t\t\t\"limits_service_rate\", result.GetStats().GetEvaluatedRate(),","+\t\t\t\t)","+\t\t\t}","+\t\t}","+\t}","+}","+","+// shardingState reports which side's decision shards the stream.","+func shardingState(rateStoreShards, limitsShards int) string {","+\trateStoreSharded := rateStoreShards > 1","+\tlimitsSharded := limitsShards > 1","+\tswitch {","+\tcase rateStoreSharded && limitsSharded:","+\t\treturn \"both\"","+\tcase limitsSharded:","+\t\treturn \"limits_only\"","+\tcase rateStoreSharded:","+\t\treturn \"rate_store_only\"","+\tdefault:","+\t\treturn \"neither\"","+\t}","+}","+"," // shardStream shards (divides) the given stream into N smaller streams, where"," // N is the sharding size for the given stream. shardSteam returns the smaller","-// streams and their associated keys for hashing to ingesters.","+// streams and their associated keys for hashing to ingesters, along with the","+// shard count shardCountFor recommended. That count is not necessarily the","+// number of streams returned, as createShards limits the shards to the number","+// of entries."," //"," // The number of shards is limited by the number of entries.","-func (d *Distributor) shardStream(stream logproto.Stream, pushSize int, tenantID string, policy string, shardStreamsCfg shardstreams.Config) []KeyedStream {","+func (d *Distributor) shardStream(stream logproto.Stream, pushSize int, tenantID string, policy string, shardStreamsCfg shardstreams.Config) ([]KeyedStream, int) {"," \tlogger := log.With(util_log.WithUserID(tenantID, d.logger), \"stream\", stream.Labels)"," \tshardCount := d.shardCountFor(logger, &stream, pushSize, tenantID, shardStreamsCfg)"," "," \tif shardCount <= 1 {","-\t\treturn []KeyedStream{{HashKey: lokiring.TokenFor(tenantID, stream.Labels), HashKeyNoShard: stream.Hash, Stream: stream, Policy: policy}}","+\t\treturn []KeyedStream{{HashKey: lokiring.TokenFor(tenantID, stream.Labels), HashKeyNoShard: stream.Hash, Stream: stream, Policy: policy}}, shardCount"," \t}"," "," \td.m.streamShardCount.Inc()","@@ -1359,7 +1398,7 @@ func (d *Distributor) shardStream(stream logproto.Stream, pushSize int, tenantID"," \t\tlevel.Info(logger).Log(\"msg\", \"sharding request\", \"shard_count\", shardCount)"," \t}"," ","-\treturn d.divideEntriesBetween