5,"deletions":15,"truncated":false},{"path":"jstests/noPassthroughWithMongod/query/cbr/cbr_zero_ce_fallback_to_multiplanning.js","lines":["@@ -1,7 +1,8 @@"," /**","- * Test that CBR falls back to multiplanning when a plan contains an index scan whose cardinality","- * estimate is zero. CBR does not reliably pick the better plan when costs rest on a zero estimate,","- * so the candidate plans are handed to the multi-planner instead.","+ * Test that CBR falls back to multiplanning for a plan containing an index scan that sampling","+ * estimates to scan zero keys. A zero estimate from sampling typically means \"no matching data","+ * observed in the sample\" rather than \"truly zero\", so the plan's cost cannot be trusted and the","+ * plan is handed to the multi-planner instead.","  *","  * @tags: [","  *   requires_fcv_90,","@@ -12,10 +13,14 @@ import {","     assertChosenRanker,","     ChosenRanker,","     getPlanStage,","+    getRejectedPlans,","     getWinningPlanFromExplain,","-    PlanRankerReason,"," } from \"jstests/libs/query/analyze_plan.js\";","-import {getPlanRankerConfig, setPlanRankerConfig} from \"jstests/libs/query/cbr_utils.js\";","+import {","+    getPlanRankerConfig,","+    isPlanCosted,","+    setPlanRankerConfig,","+} from \"jstests/libs/query/cbr_utils.js\";"," import {checkSbeFullyEnabled} from \"jstests/libs/query/sbe_util.js\";"," import {after, before, describe, it} from \"jstests/libs/mochalite.js\";"," ","@@ -27,76 +32,64 @@ if (checkSbeFullyEnabled(db)) {"," "," const coll = db[jsTestName()];"," ","-// The query below matches nothing, so its two candidate index scans tie on multi-planner score","-// and the tie is broken by candidate order: the planner enumerates the {a: 1} index first.","-const zeroCEFilter = {a: {$gt: 5000}, b: {$gt: 5000}};","+function scannedIndex(plan) {","+    const ixscan = getPlanStage(plan, \"IXSCAN\");","+    assert.neq(null, ixscan, \"expected an IXSCAN in the plan\", {plan});","+    return ixscan.keyPattern;",