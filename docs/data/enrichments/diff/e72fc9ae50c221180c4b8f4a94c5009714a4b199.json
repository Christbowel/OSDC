side_effect = _consume_at_most(","+        chain([2, 0], repeat(2))","+    )","+","+    runner.run(","+        decoded_tokens=[0, 0, 0, EOS_TOKEN_ID],","+        expected_stored=(0, 1, 2, 3, 4, 5),","+    )","+","+    reduced = _reduce_kv_connector_stats(runner)","+    assert not reduced.get(_ConnectorMetricName.ALLOCATION_FAILURE)","+","+","+@pytest.mark.parametrize(\"async_scheduling\", [True, False])","+def test_chunks_left_unstored_by_a_finished_request_are_reported(","+    request_runner, async_scheduling: bool","+):","+    \"\"\"A finished request is not offered again, so its leftover is a loss.\"\"\"","+    block_size = 4","+    runner = request_runner(","+        block_size=block_size,","+        num_gpu_blocks=10,","+        async_scheduling=async_scheduling,","+    )","+    runner.new_request(token_ids=[0] * (6 * block_size))","+    runner.manager.prepare_store.side_effect = _consume_at_most(chain([2], repeat(0)))","+","+    runner.run(decoded_tokens=[EOS_TOKEN_ID], expected_stored=(0, 1))","+","+    reduced = _reduce_kv_connector_stats(runner)","+    assert reduced[_ConnectorMetricName.ALLOCATION_FAILURE] == 1","+","+","+def test_partially_stored_handoff_is_reported():","+    \"\"\"A hand-off is offered once, so keys the manager leaves are a loss.\"\"\"","+    scheduler = _make_partial_tail_scheduler()","+    _make_partial_tail_request(scheduler)","+    req_status = scheduler._req_status[\"req\"]","+    req_status.group_states[0].block_ids[:] = [11, 12]","+    req_status.group_states[1].block_ids[:] = [0, 21]","+    _as_mock(scheduler.manager.prepare_store).side_effect = _consume_at_most([1])","+","+    output = SimpleNamespace(","+        kv_connector_block_state=KVConnectorBlockState(","+            req_ids=set(),","+            resolve_block_ids={}.__getitem__,","+            boundary_state_offloads={\"req\": [(1, 99, 28)]},","+        )","+    )","+    jobs = _partial_tail_store_jobs(scheduler, output)","+","+    [job] = jobs.values()","+    assert jo