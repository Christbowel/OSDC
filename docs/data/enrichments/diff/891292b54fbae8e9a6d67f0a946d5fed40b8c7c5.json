AppPluginSettings,","+  type HealthCheckResult,","+  HealthStatus,","+  isFetchError,"," } from '@grafana/runtime';"," import {","   getPluginSettings as unstableGetPluginSettings,","@@ -47,3 +51,46 @@ async function backwardsCompatibleUpdatePluginSettings(","   await getBackendSrv().post(`/api/plugins/${pluginId}/settings`, data, { validatePath: true });","   return backwardsCompatibleGetPluginSettings(pluginId);"," }","+","+export async function getAppPluginHealth(","+  pluginId: string,","+  showErrorAlert = false,","+  apiVersion?: string","+): Promise<HealthCheckResult | undefined> {","+  if (typeof stableGetAppPluginHealth === 'function') {","+    return stableGetAppPluginHealth(pluginId, showErrorAlert, apiVersion);","+  }","+","+  return backwardsCompatibleGetAppPluginHealth(pluginId, showErrorAlert);","+}","+","+function isLegacyUnhealthyHealthCheckError(err: unknown): boolean {","+  return (","+    isFetchError<HealthCheckResult>(err) &&","+    err.status === 400 &&","+    (err.data?.status === HealthStatus.Error || err.data?.status === HealthStatus.Unknown)","+  );","+}","+","+async function backwardsCompatibleGetAppPluginHealth(","+  pluginId: string,","+  showErrorAlert = false","+): Promise<HealthCheckResult> {","+  return getBackendSrv()","+    .get<HealthCheckResult>(`/api/plugins/${pluginId}/health`, undefined, undefined, {","+      showErrorAlert,","+      validatePath: true,","+    })","+    .catch((err) => {","+      if (isFetchError(err) && (err.status === 401 || err.status === 403)) {","+        err.isHandled = true;","+        return Promise.reject(err);","+      }","+","+      if (isLegacyUnhealthyHealthCheckError(err)) {","+        return err.data;","+      }","+","+      return Promise.reject(err);","+    });","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"packages/grafana-runtime/src/index.ts","lines":["@@ -126,3 +126,4 @@ export {","   type UseDefaultDataSourceInstanceListItemResult,","   type UseHasDataSourceInstanceResul