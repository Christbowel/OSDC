      put: jest.fn(),","+      datasourceRequest: jest.fn(),","+      request: jest.fn(),","+    };","+    setBackendSrv(backendSrv);","+    logger = {","+      logDebug: jest.fn(),","+      logError: jest.fn(),","+      logInfo: jest.fn(),","+      logMeasurement: jest.fn(),","+      logWarning: jest.fn(),","+    };","+    setLogger('grafana/runtime.plugins.settings', logger);","+    getPluginMetaFromCacheMock.mockResolvedValue(app);","+    backendSrv.get = jest.fn().mockResolvedValue(result);","+  });","+","+  describe('when plugins.useMTPluginSettings flag is enabled', () => {","+    beforeAll(() => {","+      setTestFlags({ [FlagKeys.PluginsUseMTPluginSettings]: true });","+    });","+","+    afterAll(() => {","+      setTestFlags({});","+    });","+","+    describe('getAppPluginHealth', () => {","+      it('should call new apis with default arguments to fetch health result', async () => {","+        const response = await getAppPluginHealth('grafana-exploretraces-app');","+","+        expect(response).toMatchObject({ status: HealthStatus.OK, message: 'All good', details: { set: true } });","+        expect(backendSrv.get).toHaveBeenCalledTimes(1);","+        expect(backendSrv.get).toHaveBeenCalledWith(","+          '/apis/grafana-exploretraces-app/v0alpha1/namespaces/default/app/instance/health',","+          undefined,","+          undefined,","+          {","+            showErrorAlert: false,","+            validatePath: true,","+          }","+        );","+      });","+","+      it('should use supplied showErrorAlert argument to fetch health result', async () => {","+        await getAppPluginHealth('grafana-exploretraces-app', true);","+","+        expect(backendSrv.get).toHaveBeenCalledWith(","+          '/apis/grafana-exploretraces-app/v0alpha1/namespaces/default/app/instance/health',","+          undefined,","+          undefined,","+          {","+            showErrorAlert: true,","+            validatePath: true,","+          }","+        );","+      });","+","+      it('should use supplied apiVersion argument to fetch health result', async () => {","+        await getAppPluginHealth('grafana-exploretraces-app', undefined, 'v1alpha1');","+","+        expect(backendSrv.get).toHaveBeenCalledWith(","+          '/apis/grafana-exploretraces-app/v1alpha1/namespaces/default/app/instance/health',","+          undefined,","+          undefined,","+          {","+            showErrorAlert: false,","+            validatePath: true,","+          }","+        );","+      });","+","+      it('should return an unhealthy health result with details', async () => {","+        backendSrv.get = jest.fn().mockRejectedValue({","+          status: 400,","+          data: { status: 'ERROR', message: 'Invalid credentials', details: { reason: 'credentials' } },","+        });","+","+        const response = await getAppPluginHealth('grafana-exploretraces-app');","+","+        expect(response).toEqual({","+          status: 'ERROR',","+          message: 'Invalid credentials',","+          details: { reason: 'credentials' },","+        });","+        expect(logger.logError).not.toHaveBeenCalled();","+      });","+","+      it('should return an unknown health result', async () => {","+        backendSrv.get = jest.fn().mockRejectedValue({","+          status: 400,","+          data: { status: 'UNKNOWN', message: 'Health unknown' },","+        });","+","+        const response = await getAppPluginHealth('grafana-exploretraces-app');","+","+        expect(response).toEqual({ status: 'UNKNOWN', message: 'Health unknown' });","+      });","+","+      it('should reject a bad request without a health result', async () => {","+        backendSrv.get = jest.fn().mockRejectedValue({","+          status: 400,","+          data: { message: 'Bad request' },","+        });","+","+        await expect(getAppPluginHealth('grafana-exploretraces-app')).rejects.toEqual({","+          status: 400,","+          data: { message: 'Bad request' },","+        