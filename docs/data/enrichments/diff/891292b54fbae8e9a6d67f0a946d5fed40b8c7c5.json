DataSourceInstanceListItem,"," } from '@grafana/plugin-compat/datasources';","-import { getPluginSettings } from '@grafana/plugin-compat/apps';","+import { getAppPluginHealth, getPluginSettings } from '@grafana/plugin-compat/apps';"," "," const ds = await getDataSourceInstance({ uid: 'my-uid' });"," const settings = await getPluginSettings('my-plugin-id');","+const health = await getAppPluginHealth('my-plugin-id');"," "," // `undefined` unless the org default is one of the items."," const items = await getDataSourceInstanceList({ type: 'prometheus' });","@@ -50,5 +49,7 @@ const { isLoading, error, item } = useDefaultDataSourceInstanceListItem(items);"," registerRuntimeDataSourceInstance({ dataSource: new MyRuntimeDataSource('my-plugin-id', 'my-uid') });"," ```"," ","+`getAppPluginHealth` resolves with the health result for both healthy and unhealthy responses. Inspect `health?.status`; authentication, transport, and other non-health failures reject. The k8s path defaults an omitted message to an empty string; legacy health responses are returned unchanged. Known non-app plugins return `undefined` when k8s metadata is available.","+"," On hosts with the async APIs, a data source registered this way is not visible"," to `getDataSourceSrv()`. Look it up with `getDataSourceInstance` instead."],"additions":5,"deletions":4,"truncated":false},{"path":"packages/grafana-plugin-compat/package.json","lines":["@@ -2,7 +2,7 @@","   \"author\": \"Grafana Labs\",","   \"license\": \"Apache-2.0\",","   \"name\": \"@grafana/plugin-compat\",","-  \"version\": \"0.6.0\",","+  \"version\": \"0.7.0\",","   \"private\": true,","   \"description\": \"Compatibility shims that let Grafana plugins adopt new Grafana host APIs across a range of host versions\",","   \"keywords\": ["],"additions":1,"deletions":1,"truncated":false},{"path":"packages/grafana-plugin-compat/src/apps.compat.test.ts","lines":["@@ -1,7 +1,7 @@"," import { type PluginMeta } from '@grafana/data';"," import { type Backen