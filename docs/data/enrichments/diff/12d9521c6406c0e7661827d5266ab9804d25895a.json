{"id":"12d9521c6406c0e7661827d5266ab9804d25895a","axis":"silent","repo":"hashicorp/consul","sha":"12d9521c6406c0e7661827d5266ab9804d25895a","parsed":{"files":[{"path":"agent/consul/internal_endpoint.go","lines":["@@ -756,7 +756,9 @@ func (m *Internal) PeeredUpstreams(args *structs.PartitionSpecificRequest, reply"," \t\t\t\tresult = append(result, vip.Service)"," \t\t\t}"," ","-\t\t\treply.Index, reply.Services = index, result","+\t\t\t// ServiceVIPs carries per-port virtual IPs for multiport peering,","+\t\t\t// which is an enterprise-only feature. CE never populates it.","+\t\t\treply.Index, reply.Services, reply.ServiceVIPs = index, result, nil"," \t\t\treturn nil"," \t\t})"," }"],"additions":3,"deletions":1,"truncated":false},{"path":"agent/consul/internal_endpoint_multiport_ce_test.go","lines":["@@ -0,0 +1,92 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+//go:build !consulent","+","+package consul","+","+import (","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\tmsgpackrpc \"github.com/hashicorp/consul-net-rpc/net-rpc-msgpackrpc\"","+","+\t\"github.com/hashicorp/consul/acl\"","+\t\"github.com/hashicorp/consul/agent/netutil\"","+\t\"github.com/hashicorp/consul/agent/structs\"","+\t\"github.com/hashicorp/consul/sdk/testutil/retry\"","+\t\"github.com/hashicorp/consul/testrpc\"","+)","+","+// TestInternal_PeeredUpstreams_CE pins the CE contract for the peered","+// upstreams read path. Multiport is enterprise-only, so CE must:","+//","+//   - return every peered service unfiltered, and","+//   - leave ServiceVIPs nil.","+//","+// The unfiltered requirement is load bearing. Consul allows dots in service","+// names, so any \"<port>.<service>\" style filtering in CE would silently drop","+// legitimately named services such as \"api.v1\" from every dialing proxy.","+func TestInternal_PeeredUpstreams_CE(t *testing.T) {","+\tif testing.Short() {","+\t\tt.Skip(\"too slow for testing.Short\")","+\t}","+","+\torig := virtualIPVersionCheckInterval","+\tvirtualIPVersionCheckInterval = 50 * time.Millisecond","+\tt.Cleanup(func() { virtualIPVersionCheckInterval = orig })","+","+\tt.Parallel()","+","+\tnetutil.GetAgentBindAddrFunc = netutil.GetMockGetAgentBindAddrFunc(\"0.0.0.0\")","+","+\t_, s1 := testServerWithConfig(t)","+\ttestrpc.WaitForLeader(t, s1.RPC, \"dc1\")","+","+\tstore := s1.fsm.State()","+\tretry.Run(t, func(r *retry.R) {","+\t\t_, entry, err := store.SystemMetadataGet(nil, structs.SystemMetadataVirtualIPsEnabled)","+\t\trequire.NoError(r, err)","+\t\trequire.NotNil(r, entry)","+\t\trequire.Equal(r, \"true\", entry.Value)","+\t})","+","+\t// A plain service, plus dotted service names that a naive per-port filter","+\t// would mistake for synthetic \"<port>.<service>\" projections.","+\tnames := []string{\"web\", \"api.v1\", \"http.web\"}","+\tfor i, name := range names {","+\t\trequire.NoError(t, store.EnsureRegistration(uint64(20+i), &structs.RegisterRequest{","+\t\t\tNode:           \"bar\",","+\t\t\tAddress:        \"127.0.0.2\",","+\t\t\tSkipNodeUpdate: i != 0,","+\t\t\tService: &structs.NodeService{","+\t\t\t\tKind:    structs.ServiceKindConnectProxy,","+\t\t\t\tService: name + \"-proxy\",","+\t\t\t\tID:      name + \"-proxy\",","+\t\t\t\tProxy:   structs.ConnectProxyConfig{DestinationServiceName: name},","+\t\t\t},","+\t\t\tPeerName: \"peer-a\",","+\t\t}))","+\t}","+","+\tcodec := rpcClient(t, s1)","+\targs := structs.PartitionSpecificRequest{","+\t\tDatacenter:     \"dc1\",","+\t\tEnterpriseMeta: *acl.DefaultEnterpriseMeta(),","+\t}","+\tvar out structs.IndexedPeeredServiceList","+\trequire.NoError(t, msgpackrpc.CallWithCodec(codec, \"Internal.PeeredUpstreams\", &args, &out))","+","+\tgot := make([]string, 0, len(out.Services))","+\tfor _, psn := range out.Services {","+\t\tgot = append(got, psn.ServiceName.Name)","+\t}","+","+\trequire.ElementsMatch(t, names, got,","+\t\t\"CE must return every peered service unfiltered, including dotted names\")","+","+\trequire.Nil(t, out.ServiceVIPs,","+\t\t\"ServiceVIPs is an enterprise multiport field and must be nil in CE\")","+}"],"additions":92,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog.go","lines":["@@ -929,6 +929,23 @@ func ensureServiceTxn(tx WriteTxn, idx uint64, node string, preserveIndexes bool"," \t\t}"," \t}"," ","+\t// For imported peered services with multiport, allocate per-port VIPs on the","+\t// consumer side. The base VIP is allocated when the synthetic connect proxy is","+\t// registered (above block), but per-port VIPs must be allocated from the typical","+\t// service instances which carry the Ports field.","+\tif svc.PeerName != \"\" && svc.Kind == structs.ServiceKindTypical {","+\t\tsupported, err := virtualIPsSupported(tx, nil)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif supported {","+\t\t\tsn := structs.ServiceName{Name: svc.Service, EnterpriseMeta: svc.EnterpriseMeta}","+\t\t\tif err := reconcileImportedServicePortVirtualIPs(tx, idx, node, sn, svc); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t}","+"," \tif svc.PeerName == \"\" {"," \t\t// If there's a terminating gateway config entry for this service, populate the tagged addresses"," \t\t// with virtual IP mappings.","@@ -2103,6 +2120,18 @@ func (s *Store) deleteServiceTxn(tx WriteTxn, idx uint64, nodeName, serviceID st"," \t\treturn fmt.Errorf(\"failed to clean up mesh-topology associations for %q: %v\", psn.String(), err)"," \t}"," ","+\tif svc.PeerName != \"\" && svc.ServiceKind == structs.ServiceKindTypical {","+\t\tsupported, err := virtualIPsSupported(tx, nil)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif supported {","+\t\t\tif err := reconcileDeletedImportedServicePortVirtualIPs(tx, idx, psn.ServiceName, svc.PeerName); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t}","+"," \tq := Query{"," \t\tValue:          svc.ServiceName,"," \t\tEnterpriseMeta: *entMeta,"],"additions":29,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog_ce.go","lines":["@@ -117,6 +117,14 @@ func assignServicePortVirtualIPs(_ WriteTxn, _ uint64, _ structs.ServiceName, _"," \treturn nil"," }"," ","+func reconcileImportedServicePortVirtualIPs(_ WriteTxn, _ uint64, _ string, _ structs.ServiceName, _ *structs.NodeService) error {","+\treturn nil","+}","+","+func reconcileDeletedImportedServicePortVirtualIPs(_ WriteTxn, _ uint64, _ structs.ServiceName, _ string) error {","+\treturn nil","+}","+"," func freeServicePortVirtualIPs(_ WriteTxn, _ Query) error {"," \treturn nil"," }"],"additions":8,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog_multiport_ce_test.go","lines":["@@ -0,0 +1,151 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+//go:build !consulent","+","+package state","+","+import (","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/hashicorp/consul/acl\"","+\t\"github.com/hashicorp/consul/agent/netutil\"","+\t\"github.com/hashicorp/consul/agent/structs\"","+)","+","+// Multiport is an enterprise-only feature. These tests pin the CE contract:","+// the per-port virtual IP hooks are no-ops, so registering a service that","+// declares named ports must behave exactly like a single-port service.","+","+func testEnableVirtualIPs(t *testing.T, s *Store) {","+\tt.Helper()","+\tnetutil.GetAgentBindAddrFunc = netutil.GetMockGetAgentBindAddrFunc(\"0.0.0.0\")","+\trequire.NoError(t, s.SystemMetadataSet(0, &structs.SystemMetadataEntry{","+\t\tKey:   structs.SystemMetadataVirtualIPsEnabled,","+\t\tValue: \"true\",","+\t}))","+}","+","+// portVirtualIPTaggedAddresses returns the \"consul-virtual:<port>\" tagged","+// addresses, which only enterprise multiport ever creates.","+func portVirtualIPTaggedAddresses(addrs map[string]structs.ServiceAddress) []string {","+\tvar out []string","+\tfor key := range addrs {","+\t\tif strings.HasPrefix(key, structs.TaggedAddressVirtualIPPrefix+\":\") {","+\t\t\tout = append(out, key)","+\t\t}","+\t}","+\treturn out","+}","+","+// TestCE_PeeredServiceWithPorts_NoPerPortVirtualIPs asserts that an imported","+// peered service declaring named ports gets the ordinary single base virtual","+// IP and no per-port virtual IPs in CE.","+func TestCE_PeeredServiceWithPorts_NoPerPortVirtualIPs(t *testing.T) {","+\ts := testStateStore(t)","+\ttestEnableVirtualIPs(t, s)","+","+\tconst peer = \"peer-a\"","+","+\trequire.NoError(t, s.EnsureRegistration(10, &structs.RegisterRequest{","+\t\tNode:     \"node-a\",","+\t\tPeerName: peer,","+\t\tService: &structs.NodeService{","+\t\t\tKind:    structs.ServiceKindTypical,","+\t\t\tService: \"web\",","+\t\t\tID:      \"web-a\",","+\t\t\tPort:    8080,","+\t\t\tPorts: structs.ServicePorts{","+\t\t\t\t{Name: \"http\", Port: 8080, Default: true},","+\t\t\t\t{Name: \"metrics\", Port: 9090},","+\t\t\t},","+\t\t},","+\t\tEnterpriseMeta: *acl.DefaultEnterpriseMeta(),","+\t}))","+","+\t// The multiport reconcile hook is a no-op in CE, so no per-port tagged","+\t// addresses may be written onto the registered instance.","+\t_, svc, err := s.NodeService(nil, \"node-a\", \"web-a\", nil, peer)","+\trequire.NoError(t, err)","+\trequire.NotNil(t, svc)","+\trequire.Empty(t, portVirtualIPTaggedAddresses(svc.TaggedAddresses),","+\t\t\"CE must not assign per-port virtual IPs for a multiport service\")","+","+\t// And no synthetic \"<port>.<service>\" virtual IP entries may exist.","+\t_, vips, err := s.VirtualIPsForAllImportedServices(nil, *acl.DefaultEnterpriseMeta())","+\trequire.NoError(t, err)","+\tfor _, vip := range vips {","+\t\trequire.NotContains(t, vip.Service.ServiceName.Name, \".\",","+\t\t\t\"CE must not create synthetic per-port virtual IP entries\")","+\t}","+}","+","+// TestCE_SinglePortServiceVirtualIPUnchanged pins the pre-existing single-port","+// behavior: one base virtual IP, one \"consul-virtual\" tagged address, and no","+// per-port entries.","+func TestCE_SinglePortServiceVirtualIPUnchanged(t *testing.T) {","+\ts := testStateStore(t)","+\ttestEnableVirtualIPs(t, s)","+","+\trequire.NoError(t, s.EnsureRegistration(10, &structs.RegisterRequest{","+\t\tNode: \"node-a\",","+\t\tService: &structs.NodeService{","+\t\t\tKind:    structs.ServiceKindConnectProxy,","+\t\t\tService: \"web-sidecar-proxy\",","+\t\t\tID:      \"web-sidecar-proxy\",","+\t\t\tPort:    20000,","+\t\t\tProxy:   structs.ConnectProxyConfig{DestinationServiceName: \"web\"},","+\t\t},","+\t\tEnterpriseMeta: *acl.DefaultEnterpriseMeta(),","+\t}))","+","+\tpsn := structs.PeeredServiceName{","+\t\tServiceName: structs.NewServiceName(\"web\", acl.DefaultEnterpriseMeta()),","+\t}","+\tvip, err := s.VirtualIPForService(psn)","+\trequire.NoError(t, err)","+\trequire.Equal(t, \"240.0.0.1\", vip, \"single-port virtual IP allocation must be unchanged\")","+","+\t_, svc, err := s.NodeService(nil, \"node-a\", \"web-sidecar-proxy\", nil, \"\")","+\trequire.NoError(t, err)","+\trequire.NotNil(t, svc)","+\trequire.Equal(t, \"240.0.0.1\", svc.TaggedAddresses[structs.TaggedAddressVirtualIP].Address)","+\trequire.Empty(t, portVirtualIPTaggedAddresses(svc.TaggedAddresses))","+}","+","+// TestCE_ServicePortVirtualIPHooksAreNoOps calls the enterprise extension","+// points directly and asserts they neither error nor mutate state in CE.","+func TestCE_ServicePortVirtualIPHooksAreNoOps(t *testing.T) {","+\ts := testStateStore(t)","+\ttestEnableVirtualIPs(t, s)","+","+\tsn := structs.NewServiceName(\"web\", acl.DefaultEnterpriseMeta())","+\tsvc := &structs.NodeService{","+\t\tKind:     structs.ServiceKindTypical,","+\t\tService:  \"web\",","+\t\tID:       \"web-a\",","+\t\tPeerName: \"peer-a\",","+\t\tPorts: structs.ServicePorts{","+\t\t\t{Name: \"http\", Port: 8080, Default: true},","+\t\t\t{Name: \"metrics\", Port: 9090},","+\t\t},","+\t\tTaggedAddresses: map[string]structs.ServiceAddress{},","+\t}","+","+\ttx := s.db.WriteTxn(1)","+\tdefer tx.Abort()","+","+\trequire.NoError(t, assignServicePortVirtualIPs(tx, 1, sn, svc))","+\trequire.NoError(t, reconcileImportedServicePortVirtualIPs(tx, 1, \"node-a\", sn, svc))","+\trequire.NoError(t, reconcileDeletedImportedServicePortVirtualIPs(tx, 1, sn, \"peer-a\"))","+\trequire.NoError(t, freeServicePortVirtualIPs(tx, Query{Value: \"web\"}))","+","+\trequire.Empty(t, svc.TaggedAddresses, \"CE hooks must not write per-port tagged addresses\")","+","+\tip, err := s.VirtualIPForServicePort(structs.PeeredServiceName{ServiceName: sn}, \"http\")","+\trequire.NoError(t, err)","+\trequire.Empty(t, ip, \"CE has no per-port virtual IPs\")","+}"],"additions":151,"deletions":0,"truncated":false},{"path":"agent/proxycfg-glue/peered_upstreams.go","lines":["@@ -56,6 +56,9 @@ func (s *serverPeeredUpstreams) Notify(ctx context.Context, req *structs.Partiti"," "," \t\t\treturn index, &structs.IndexedPeeredServiceList{"," \t\t\t\tServices: result,","+\t\t\t\t// ServiceVIPs carries per-port virtual IPs for multiport peering,","+\t\t\t\t// which is an enterprise-only feature. CE never populates it.","+\t\t\t\tServiceVIPs: nil,"," \t\t\t\tQueryMeta: structs.QueryMeta{"," \t\t\t\t\tIndex:   index,"," \t\t\t\t\tBackend: structs.QueryBackendBlocking,"],"additions":3,"deletions":0,"truncated":false},{"path":"agent/proxycfg-glue/peered_upstreams_multiport_ce_test.go","lines":["@@ -0,0 +1,57 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+//go:build !consulent","+","+package proxycfgglue","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/hashicorp/consul/acl\"","+\t\"github.com/hashicorp/consul/agent/consul/state\"","+\t\"github.com/hashicorp/consul/agent/proxycfg\"","+\t\"github.com/hashicorp/consul/agent/structs\"","+)","+","+// TestServerPeeredUpstreams_CE pins the CE contract for the server-side peered","+// upstreams data source: every peered service is returned unfiltered and","+// ServiceVIPs stays nil. See TestInternal_PeeredUpstreams_CE for why the","+// unfiltered guarantee matters for dotted service names.","+func TestServerPeeredUpstreams_CE(t *testing.T) {","+\tconst index uint64 = 123","+","+\tctx, cancel := context.WithCancel(context.Background())","+\tt.Cleanup(cancel)","+","+\tstore := state.NewStateStore(nil)","+\tenableVirtualIPs(t, store)","+","+\tregisterService(t, index, \"peer-a\", \"web\", \"node-a\", store)","+\tregisterService(t, index, \"peer-a\", \"api.v1\", \"node-a\", store)","+\tregisterService(t, index, \"peer-a\", \"http.web\", \"node-a\", store)","+","+\teventCh := make(chan proxycfg.UpdateEvent)","+\tdataSource := ServerPeeredUpstreams(ServerDataSourceDeps{","+\t\tGetStore:    func() Store { return store },","+\t\tACLResolver: newStaticResolver(acl.ManageAll()),","+\t})","+\trequire.NoError(t, dataSource.Notify(ctx, &structs.PartitionSpecificRequest{","+\t\tEnterpriseMeta: *acl.DefaultEnterpriseMeta(),","+\t}, \"\", eventCh))","+","+\tresult := getEventResult[*structs.IndexedPeeredServiceList](t, eventCh)","+","+\tgot := make([]string, 0, len(result.Services))","+\tfor _, psn := range result.Services {","+\t\tgot = append(got, psn.ServiceName.Name)","+\t}","+\trequire.ElementsMatch(t, []string{\"web\", \"api.v1\", \"http.web\"}, got,","+\t\t\"CE must return every peered service unfiltered, including dotted names\")","+","+\trequire.Nil(t, result.ServiceVIPs,","+\t\t\"ServiceVIPs is an enterprise multiport field and must be nil in CE\")","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"agent/proxycfg/connect_proxy.go","lines":["@@ -377,6 +377,29 @@ func (s *handlerConnectProxy) handleUpdate(ctx context.Context, u UpdateEvent, s"," \t\t}"," \t\tsnap.ConnectProxy.PeeredUpstreams = seenUpstreams"," ","+\t\t// Record the locally-assigned virtual IP for each peered upstream (including","+\t\t// synthetic per-port entries) so that the listener generator can emit a","+\t\t// distinct outbound filter chain per named port for multiport peered services.","+\t\t// ServiceVIPs is intentionally decoded independently from Services: upgraded","+\t\t// producers keep the legacy Services list base-only, while older Part A","+\t\t// producers may still include the synthetic entries in both fields.","+\t\tif len(resp.ServiceVIPs) > 0 {","+\t\t\tpeeredPortUpstreamVIPs := make(map[UpstreamID]string, len(resp.ServiceVIPs))","+\t\t\tfor key, vip := range resp.ServiceVIPs {","+\t\t\t\tif vip == \"\" {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tpsn, ok := structs.PeeredServiceNameFromString(key)","+\t\t\t\tif !ok {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tpeeredPortUpstreamVIPs[NewUpstreamIDFromPeeredServiceName(psn)] = vip","+\t\t\t}","+\t\t\tsnap.ConnectProxy.PeeredPortUpstreamVIPs = peeredPortUpstreamVIPs","+\t\t} else {","+\t\t\tsnap.ConnectProxy.PeeredPortUpstreamVIPs = nil","+\t\t}","+"," \t\t//"," \t\t// Clean up data"," \t\t//"],"additions":23,"deletions":0,"truncated":false},{"path":"agent/proxycfg/mesh_gateway.go","lines":["@@ -152,6 +152,7 @@ func (s *handlerMeshGateway) initialize(ctx context.Context) (ConfigSnapshot, er"," \tsnap.MeshGateway.WatchedPeers = make(map[string]context.CancelFunc)"," \tsnap.MeshGateway.PeeringServices = make(map[string]map[structs.ServiceName]PeeringServiceValue)"," \tsnap.MeshGateway.ServicePorts = make(map[structs.ServiceName][]string)","+\ts.initializeEntMeshGatewaySnapshot(&snap)"," "," \t// there is no need to initialize the map of service resolvers as we"," \t// fully rebuild it every time we get updates","@@ -277,6 +278,11 @@ func (s *handlerMeshGateway) handleUpdate(ctx context.Context, u UpdateEvent, sn"," "," \t\t\t\t// always remove the sid from the ServiceGroups when un-watch the service"," \t\t\t\tdelete(snap.MeshGateway.ServiceGroups, sid)","+","+\t\t\t\t// ServicePorts is topology state (the set of named ports), not health","+\t\t\t\t// state. Remove it when the service is genuinely unwatched. Empty","+\t\t\t\t// health responses preserve it; non