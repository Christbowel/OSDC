+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { Disposable } from '../../../../../base/common/lifecycle.js';","+import { localize } from '../../../../../nls.js';","+import { type IAgentHostChatContribution, type IAgentHostChatContributionContext, type IIncomingRequest, type IncomingRequestDisposition, type IOutgoingTurn, type ISendContribution } from '../../../common/agentHostChatContributionsService.js';","+import { AgentMergeConfigKey, agentMergeRootConfigSchema, readAgentMergeSessionState } from '../../../common/agentMerge.js';","+import { readPullRequestOperationMeta } from '../../../common/meta/agentPullRequestOperationMeta.js';","+import { SessionConfigKey } from '../../../common/sessionConfigKeys.js';","+import { IAgentConfigurationService } from '../../agentConfigurationService.js';","+import { AgentHostStateManager, IAgentHostStateManager } from '../../agentHostStateManager.js';","+","+/** Applies PR form automation choices only once its creation turn is admitted. */","+export class PullRequestChatContribution extends Disposable implements IAgentHostChatContribution {","+\tstatic readonly id = 'pullRequest';","+\treadonly order = 150;","+","+\tconstructor(","+\t\tprotected readonly _context: IAgentHostChatContributionContext,","+\t\t@IAgentConfigurationService private readonly _configurationService: IAgentConfigurationService,","+\t\t@IAgentHostStateManager private readonly _stateManager: AgentHostStateManager,","+\t) {","+\t\tsuper();","+\t}","+","+\tonIncomingRequest(request: IIncomingRequest): IncomingRequestDisposition | undefined {","+\t\tconst options = readPullRequestOperationMeta(request.message);","+\t\tif (options?.agentMerge && !this._configurationService.getRootValue(agentMergeRootConfigSchema, AgentMergeConfigKey.Enabled)) {","+\t\t\treturn {","+\t\t\t\tkind: 'reject',","+\t\t\t\terror: { errorType: 'invalidParams', message: localize('agentHost.pullRequestChat.agentMergeDisabled', \"Agent Merge is disabled in the host configuration.\") },","+\t\t\t\tstage: 'validation',","+\t\t\t};","+\t\t}","+\t\treturn undefined;","+\t}","+","+\tonOutgoingTurn(turn: IOutgoingTurn): ISendContribution | undefined {","+\t\tconst options = readPullRequestOperationMeta(turn.message);","+\t\t// Preparation can be cancelled before this hook runs; never configure an idle session.","+\t\tif (!options || this._stateManager.getChatState(turn.chat)?.activeTurn?.id !== turn.turnId) {","+\t\t\treturn undefined;","+\t\t}","+\t\tconst current = readAgentMergeSessionState(this._configurationService.getSessionConfigValues(turn.session));","+\t\tif (options.agentMerge) {","+\t\t\tconst overrides = { ...current?.overrides, ...options.agentMergeOptions };","+\t\t\tthis._configurationService.updateSessionConfig(turn.session, {","+\t\t\t\t[SessionConfigKey.AgentMerge]: { enabled: true, overrides },","+\t\t\t\t[SessionConfigKey.AgentMergeController]: current?.injectedConfiguration ? { injectedConfiguration: current.injectedConfiguration } : {},","+\t\t\t});","+\t\t} else if (current?.enabled) {","+\t\t\tthis._configurationService.updateSessionConfig(turn.session, {","+\t\t\t\t[SessionConfigKey.AgentMerge]: { enabled: false, ...(current.overrides ? { overrides: current.overrides } : {}) },","+\t\t\t});","+\t\t}","+\t\treturn undefined;","+\t}","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/agentMergeController.test.ts","lines":["@@ -26,6 +26,9 @@ import { AgentHostGitHubEndpointService } from '../../node/agentHostGitHubEndpoi"," import { AgentMergeController, firstCredentialFailure, isSamlEnforcementError, parsePullRequestUrl } from '../../node/agentMergeController.js';"," import type { IAgentHostProviderService } from '../../node/agentHostProviderService.js';"," import { AgentHostStateManager } from '../../node/agentHostStateManager.js';","+import { IAgentHostChatContributionContext } from '../../common/agentHostChatContributionsService.js';","+import { createPullRequestOperationMeta } from '../../common/meta/agentPullRequestOperationMeta.js';","+import { PullRequestChatContribution } from '../../node/chatContributions/pullRequest/pullRequestChatContribution.js';"," "," let sessionCounter = 0;"," ","@@ -249,6 +252,58 @@ suite('AgentMergeController', () => {"," \t\t});"," \t});"," ","+\ttest('PR chat preparation cannot capture the base branch or widen foreground permissions', async () => {","+\t\tconst { stateManager, configurationService, session } = createControllerHarness(disposables);","+\t\tconst contribution = disposables.add(new PullRequestChatContribution(new class extends mock<IAgentHostChatContributionContext>() { }(), configurationService, stateManager));","+\t\tconst chat = buildDefaultChatUri(session);","+\t\tconfigurationService.updateSessionConfig(session, {","+\t\t\t[SessionConfigKey.Mode]: 'interactive',","+\t\t\t[SessionConfigKey.AutoApprove]: 'default',","+\t\t});","+\t\tstateManager.setSessionMeta(session, withSessionGitState(undefined, { branchName: 'main', baseBranchName: 'main', uncommittedChanges: 1 }));","+\t\tstateManager.dispatchServerAction(session, { type: ActionType.SessionReady });","+\t\tconst prepared = new DeferredPromise<void>();","+\t\tconst turn = {","+\t\t\tsession, chat, turnId: 'create-pr',","+\t\t\tmessage: {","+\t\t\t\ttext: 'Create a PR', origin: { kind: MessageKind.User },","+\t\t\t\t_meta: createPullRequestOperationMeta({ title: 'PR title', description: '', draft: false, agentMerge: true }),","+\t\t\t},","+\t\t};","+\t\tconst send = (async () => {","+\t\t\tawait prepared.p;","+\t\t\tstateManager.dispatchServerAction(chat, { type: ActionType.ChatTurnStarted, turnId: turn.turnId, startedAt: new Date().toISOString(), message: turn.message });","+\t\t\tcontribution.onOutgoingTurn(turn);","+\t\t})();","+\t\tawait timeout(0);","+\t\tconst beforeDispatch = readAgentMergeSessionState(configurationService.getSessionConfigValues(session));","+\t\tawait prepared.complete();","+\t\tawait send;","+\t\tawait timeout(0);","+\t\tconst values = configurationService.getSessionConfigValues(session);","+\t\tconst duringTurn = {","+\t\t\ttarget: readAgentMergeSessionState(values)?.target,","+\t\t\tmode: values?.[SessionConfigKey.Mode], autoApprove: values?.[SessionConfigKey.AutoApprove],","+\t\t};","+\t\tstateManager.setSessionMeta(session, withSessionGitState(undefined, { branchName: 'feature/new-pr', baseBranchName: 'main' }));","+\t\tconst captured = new DeferredPromise<void>();","+\t\tdisposables.add(stateManager.onDidChangeSessionConfig(event => {","+\t\t\tif (event.session.toString() === session && readAgentMergeSessionState(event.current?.values)?.target) {","+\t\t\t\tvoid captured.complete();","+\t\t\t}","+\t\t}));","+\t\tstateManager.dispatchServerAction(chat, { type: ActionType.ChatTurnComplete, turnId: turn.turnId, duration: 0 });","+\t\tawait captured.p;","+\t\tconst after = readAgentMergeSessionState(configurationService.getSessionConfigValues(session));","+\t\tassert.deepStrictEqual({","+\t\t\tbeforeDispatch, duringTurn, enabled: after?.enabled, capturedBranch: after?.target?.branchName,","+\t\t}, {","+\t\t\tbeforeDispatch: undefined,","+\t\t\tduringTurn: { target: undefined, mode: 'interactive', autoApprove: 'default' },","+\t\t\tenabled: true, capturedBranch: 'feature/new-pr',","+\t\t});","+\t});","+"," \ttest('recovers a session whose persisted git state lost its branch', async () => {"," \t\tconst logService = new NullLogService();"," \t\tconst stateManager = disposables.add(new AgentHostStateManager(logService));"],"additions":55,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/pullRequestChatContribution.test.ts","lines":["@@ -0,0 +1,146 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import assert from 'assert';","+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';","+import { InstantiationService } from '../../../instantiation/common/instantiationService.js';","+import { ServiceCollection } from '../../../instantiation/common/serviceCollection.js';","+import { ILogService, NullLogService } from '../../../log/common/log.js';","+import { AgentMergeConfigKey } from '../../common/agentMerge.js';","+import { IAgentHostChatContributions } from '../../common/agentHostChatContributionsService.js';","+import { AgentHostClientType } from '../../common/agentHostClientInfo.js';","+import { platformSessionSchema } from '../../common/agentHostSchema.js';","+import { createUnknownAgentHostClientTelemetryContext } from '../../common/agentHostTelemetry.js';","+import { createPullRequestOperationMeta, IPullRequestCreateOptions } from '../../common/meta/agentPullRequestOperationMeta.js';","+import { SessionConfigKey } from '../../common/sessionConfigKeys.js';","+import { ActionType } from '../../common/state/sessionActions.js';","+import { buildDefaultChatUri, MessageKind, SessionStatus } from '../../common/state/sessionState.js';","+import { AgentConfigurationService, IAgentConfigurationService } from '../../node/agentConfigurationService.js';","+import { AgentHostChatContributions } from '../../node/agentHostChatContributionsService.js';","+import { AgentHostStateManager, IAgentHostStateManager } from '../../node/agentHostStateManager.js';","+import { PullRequestChatContribution } from '../../node/chatContributions/pullRequest/pullRequestChatContribution.js';","+import { TurnAdmissionContribution } from '../../node/chatContributions/turnAdmission/turnAdmissionContribution.js';","+","+suite('PullRequestChatContribution', () => {","+\tconst store = ensureNoDisposablesAreLeakedInTestSuite();","+\tconst options: IPullRequestCreateOptions = {","+\t\ttitle: 'Create PR', description: '', draft: false, agentMerge: true,","+\t\tagentMergeOptions: { addressReviews: true, fixCI: true, resolveConflicts: false, mergePullRequest: 'never' },","+\t};","+","+\tfunction setup(selected: IPullRequestCreateOptions = options, archived = false) {","+\t\tconst log = new NullLogService();","+\t\tconst state = store.add(new AgentHostStateManager(log));","+\t\tconst config = store.add(new AgentConfigurationService(state, log));","+\t\tconst session = 'copilot:/pull-request-chat';","+\t\tconst chat = buildDefaultChatUri(session);","+\t\tstate.createSession({","+\t\t\tresource: session, provider: 'test', title: 'Test',","+\t\t\tstatus: archived ? SessionStatus.IsArchived : SessionStatus.IsRead,","+\t\t\tcreatedAt: '2026-09-10T00:00:00.000Z', modifiedAt: '2026-09-10T00:00:00.000Z',","+\t\t});","+\t\tstate.setSessionConfig(session, { schema: platformSessionSchema.toProtocol(), values: {} });","+\t\tconfig.updateRootConfig({ [AgentMergeConfigKey.Enabled]: true });","+\t\tconst instantiation = store.add(new InstantiationService(new ServiceCollection(","+\t\t\t[ILogService, log], [IAgentConfigurationService, config], [IAgentHostStateManager, state],","+\t\t), true));","+\t\tconst contributions: IAgentHostChatContributions = store.add(new AgentHostChatContributions(log, instantiation));","+\t\tstore.add(contributions.registerContribution(TurnAdmissionContribution));","+\t\tstore.add(contributions.registerContribution(PullRequestChatContribution));","+\t\tconst turn = {","+\t\t\tsession, chat, turnId: 'create-pr',","+\t\t\tmessage: { text: 'Create a pull request', origin: { kind: MessageKind.User }, _meta: createPullRequestOperationMeta(selected) },","+\t\t};","+\t\tconst incoming = {","+\t\t\t...turn, turnChannel: chat, source: 'direct' as const, clientId: undefined,","+\t\t\tclientContext: createUnknownAgentHostClientTelemetryContext(AgentHostClientType.AgentsWindow),","+\t\t};","+\t\tconst start = () => state.dispatchServerAction(chat, {","+\t\t\ttype: ActionType.ChatTurnStarted, turnId: turn.turnId, startedAt: new Date().toISOString(), message: turn.message,","+\t\t});","+\t\treturn { contributions, state, config, turn, incoming, start };","+\t}","+","+\ttest('admission is read-only and configuration is applied only to the active creation turn', async () => {","+\t\tconst { contributions, config, turn, incoming, start } = setup();","+\t\tconst admission = contributions.incomingRequest(incoming);","+\t\tawait contributions.outgoingTurn(turn);","+\t\tconst beforeDispatch = config.getSessionConfigValues(turn.session)?.[SessionConfigKey.AgentMerge];","+\t\tstart();","+\t\tconst result = await contributions.outgoingTurn(turn);","+\t\tassert.deepStrictEqual({","+\t\t\tadmission, beforeDispatch, message: result.message,","+\t\t\tconfiguration: config.getSessionConfigValues(turn.session),","+\t\t}, {","+\t\t\tadmission: { kind: 'accept' }, beforeDispatch: undefined, message: turn.message,","+\t\t\tconfiguration: {","+\t\t\t\t[SessionConfigKey.AgentMerge]: { enabled: true, overrides: options.agentMergeOptions },","+\t\t\t\t[SessionConfigKey.AgentMergeController]: {},","+\t\t\t},","+\t\t});","+\t});","+","+\ttest('rejected or malformed requests never change session configuration', () => {","+\t\tconst { contributions, config, incoming } = setup(options, true);","+\t\tconst archived = contributions.incomingRequest(incoming);","+\t\tconst allowed = setup();","+\t\tallowed.config.updateRootConfig({ [AgentMergeConfigKey.Enabled]: false });","+\t\tconst disabled = allowed.contributions.incomingRequest(allowed.incoming);","+\t\tconst malformed = allowed.contributions.incomingRequest({","+\t\t\t...allowed.incoming, message: { ...allowed.turn.message, _meta: { 'vscode.pullRequest': { agentMerge: true } } },","+\t\t});","+\t\tassert.deepStrictEqual({","+\t\t\trejected: [archived.kind, disabled.kind, malformed.kind],","+\t\t\tarchivedConfig: config.getSessionConfigValues(incoming.session)?.[SessionConfigKey.AgentMerge],","+\t\t\tdisabledConfig: allowed.config.getSessionConfigValues(allowed.turn.session)?.[SessionConfigKey.AgentMerge],","+\t\t}, { rejected: ['reject', 'reject', 'reject'], archivedConfig: undefined, disabledConfig: undefined });","+\t});","+","+\ttest('a cancelled turn cannot apply delayed configuration', async () => {","+\t\tconst { contributions, config, state, turn, start } = setup();","+\t\tstart();","+\t\tstate.dispatchServerAction(turn.chat, { type: ActionType.ChatTurnCancelled, turnId: turn.turnId, duration: 0 });","+\t\tawait contributions.outgoingTurn(turn);","+\t\tassert.strictEqual(config.getSessionConfigValues(turn.session)?.[SessionConfigKey.AgentMerge], undefined);","+\t});","+","+\ttest('manual creation disables monitoring without discarding saved overrides', async () => {","+\t\tconst { contributions, config, turn, start } = setup({ ...options, agentMerge: false, agentMergeOptions: undefined });","+\t\tconfig.updateSessionConfig(turn.session, { [SessionConfigKey.AgentMerge]: { enabled: true, overrides: options.agentMergeOptions } });","+\t\tstart();","+\t\tawait contributions.outgoingTurn(turn);","+\t\tassert.deepStrictEqual(config.getSessionConfigValues(turn.session)?.[SessionConfigKey.AgentMerge], { enabled: false, overrides: options.agentMergeOptions });","+\t});","+","+\ttest('enabling without form overrides preserves existing session options', async () => {","+\t\tconst { contributions, config, turn, start } = setup({ ...options, agentMergeOptions: undefined });","+\t\tconfig.updateSessionConfig(turn.session, { [SessionConfigKey.AgentMerge]: { enabled: false, overrides: options.agentMergeOptions } });","+\t\tstart();","+\t\tawait contributions.outgoingTurn(turn);","+\t\tassert.deepStrictEqual(config.getSessionConfigValues(turn.session)?.[SessionConfigKey.AgentMerge], { enabled: true, overrides: options.agentMergeOptions });","+\t});","+","+\ttest('ordinary messages leave configuration unchanged', async () => {","+\t\tconst { contributions, config, turn, start } = setup();","+\t\tstart();","+\t\tawait contributions.outgoingTurn({ ...turn, message: { text: 'hello', origin: { kind: MessageKind.User } } });","+\t\tassert.strictEqual(config.getSessionConfigValues(turn.session)?.[SessionConfigKey.AgentMerge], undefined);","+\t});","+","+\ttest('retargeting monitoring preserves the original configuration for eventual restoration', async () => {","+\t\tconst { contributions, config, turn, start } = setup();","+\t\tconst injectedConfiguration = { previous: { mode: 'interactive' }, applied: { mode: 'autopilot' } };","+\t\tconfig.updateSessionConfig(turn.session, {","+\t\t\t[SessionConfigKey.AgentMerge]: { enabled: true },","+\t\t\t[SessionConfigKey.AgentMergeController]: {","+\t\t\t\ttarget: { branchName: 'main', enabledAt: '2026-09-10T00:00:00.000Z', commentWatermark: '2026-09-10T00:00:00.000Z' },","+\t\t\t\tinjectedConfiguration,","+\t\t\t},","+\t\t});","+\t\tstart();","+\t\tawait contributions.outgoingTurn(turn);","+\t\tassert.deepStrictEqual(config.getSessionConfigValues(turn.session)?.[SessionConfigKey.AgentMergeController], { injectedConfiguration });","+\t});","+});"],"additions":146,"deletions":0,"truncated":false},{"path":"src/vs/sessions/SESSIONS.md","lines":["@@ -113,7 +113,7 @@ Sessions and chats expose provider-neutral file changes and changesets. Transpor"," "," Features may extend individual changeset operation descriptors through contribution-owned contracts, keeping feature-specific capabilities out of `ISessionChangeset`. The Changes contribution defines the Create PR operation's preparation and submission contract and owns its form; providers attach that capability only to supported operations and own generation, creation, and transport. Preparation is read-only and returns repository and branch identity for submission to revalidate before mutations. Submission uses confirmed values, saving any Agent Merge configuration as session-only overrides after creation."," ","-The form also supports requesting creation in the originating session's main chat through the normal send lifecycle, without invoking programmatic PR creation. The provider validates the same prepared identity without regenerating details before the message is sent. That message contains the PR details and GitHub merge instructions, while Agent Merge choices are applied through the session configuration API after the message is sent. The Changes contribution remembers form options and the last-used submission method across sessions in profile storage; remembering choices does not itself change session configuration or retain PR content.","+The form also supports requesting creation in the originating session's main chat through the normal send lifecycle, without invoking programmatic PR creation. The provider validates the same prepared identity without regenerating details before the message is sent. That message contains the PR details and GitHub merge instructions; submission choices travel separately as provider-owned request metadata. A host chat contribution applies Agent Merge choices only after the creation turn is admitted and while it is still active, so monitoring cannot capture the old branch during client-side request preparation. The Changes contribution remembers form options and the last-used submission method across sessions in profile storage; remembering choices does not itself change session configuration or retain PR content."," "," Turn-level file changes route through `IChatResponseFileChangesService`. The editor workbench opens its standard multi-diff presentation; the Agents Window registers `SessionsChatResponseFileChangesService` to select its canonical Changes editor. Providers expose the data but do not choose the presentation."," "],"additions":1,"deletions":1,"truncated":false},{"path":"src/vs/sessions/contrib/changes/browser/createPullRequestChatRequest.ts","lines":["@@ -3,11 +3,7 @@","  *  Licensed under the MIT License. See License.txt in the project root for license information.","  *--------------------------------------------------------------------------------------------*/"," ","-import { toErrorMessage } from '../../../../base/common/errorMessage.js';"," import { localize } from '../../../../nls.js';","-import { INotificationService } from '../../../../platform/notification/common/notification.js';","-import { isAgentHostProvider } from '../../../common/agentHostSessionsProvider.js';","-import { ISessionsProvidersService } from '../../../services/sessions/browser/sessionsProvidersService.js';"," import { ChatInteractivity, effectiveChatInteractivity, ISession } from '../../../services/sessions/common/session.js';"," import { ISessionsManagementService } from '../../../services/sessions/common/sessionsManagement.js';"," import { ISessionPullRequestCreation, ISessionPullRequestOptions, SessionPullRequestMergeMethod } from '../common/pullRequestCreation.js';","@@ -15,37 +11,15 @@ import { ISessionPullRequestCreation, ISessionPullRequestOptions, SessionPullReq"," export class CreatePullRequestChatRequest {"," \tconstructor("," \t\t@ISessionsManagementService private readonly sessionsManagementService: ISessionsManagementService,","-\t\t@ISessionsProvidersService private readonly sessionsProvidersService: ISessionsProvidersService,","-\t\t@INotificationService private readonly notificationService: INotificationService,"," \t) { }"," "," \tasync send(session: ISession, options: ISessionPullRequestOptions, creation: ISessionPullRequestCreation): Promise<void> {","-\t\tconst provider = this.sessionsProvidersService.getProvider(session.providerId);","-\t\tif (!provider || !isAgentHostProvider(provider)) {","-\t\t\tthrow new Error(localize('createPR.chat.providerUnavailable', \"The session's agent host pro