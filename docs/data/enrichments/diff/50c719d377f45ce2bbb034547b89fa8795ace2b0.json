ontent = $('.ai-customization-toolbar-content-scrollable');","-\t\tconst toolbarContainer = DOM.append(scrollContent, $('.ai-customization-toolbar-content.sidebar-action-list'));","-\t\tthis._toolbarContentElement = toolbarContainer;","-\t\tconst scrollableElement = this._renderDisposables.add(new DomScrollableElement(scrollContent, {","-\t\t\thorizontal: ScrollbarVisibility.Hidden,","-\t\t\tvertical: ScrollbarVisibility.Auto,","-\t\t\tuseShadows: false,","-\t\t}));","-\t\tthis._scrollableElement = scrollableElement;","-\t\tthis._scrollableDomNode = DOM.append(container, scrollableElement.getDomNode());","-","-\t\tconst toolbar = this._renderDisposables.add(this.instantiationService.createInstance(MenuWorkbenchToolBar, toolbarContainer, Menus.SidebarCustomizations, {","-\t\t\thiddenItemStrategy: HiddenItemStrategy.NoHide,","-\t\t\ttoolbarOptions: { primaryGroup: () => true },","-\t\t\ttelemetrySource: 'sidebarCustomizations',","-\t\t}));","-\t\tthis._toolbar = toolbar;","-","-\t\t// Re-layout when toolbar items change (e.g., Plugins item appearing after extension activation)","-\t\tthis._renderDisposables.add(toolbar.onDidChangeMenuItems(() => {","-\t\t\tthis._scrollableElement?.scanDomNode();","-\t\t\tthis._onDidChangeHeight.fire();","-\t\t\toptions?.onDidChangeLayout?.();","-\t\t}));","-\t}","-","-\tget desiredHeight(): number {","-\t\tconst content = this._toolbarContentElement;","-\t\tif (!content) {","-\t\t\treturn 0;","-\t\t}","-\t\tif (this._collapsed) {","-\t\t\treturn this.collapsedHeight;","-\t\t}","-","-\t\tconst headerHeight = this._headerElement?.offsetHeight ?? 0;","-\t\tconst height = Math.ceil(this._rootVerticalPadding + headerHeight + content.scrollHeight);","-\t\treturn Number.isFinite(height) ? height : 0;","-\t}","-","-\tprivate _setRootPadding(element: HTMLElement, top: number, bottom: number): void {","-\t\telement.style.padding = `${top}px 0 ${bottom}px 0`;","-\t\tthis._rootVerticalPadding = top + bottom;","-\t}","-","-\tprivate _toggleCollapsed(): void {","-\t\tthis._setCollapsed(!this._collapsed);","-\t\tthis.storageService.store(CUSTOMIZATIONS_COLLAPSED_STORAGE_KEY, this._collapsed, StorageScope.PROFILE, StorageTarget.USER);","-\t\tthis._onDidToggleCollapsed.fire(this._collapsed);","-\t\tthis._onDidChangeHeight.fire();","-\t}","-","-\tprivate _setCollapsed(collapsed: boolean): void {","-\t\tif (collapsed && this._scrollableDomNode?.contains(DOM.getActiveElement())) {","-\t\t\tthis._headerElement?.focus();","-\t\t}","-\t\tthis._collapsed = collapsed;","-\t\tthis._headerElement?.classList.toggle('collapsed', collapsed);","-\t\tthis._headerElement?.setAttribute('aria-expanded', String(!collapsed));","-\t\tif (this._scrollableDomNode) {","-\t\t\tthis._scrollableDomNode.style.display = collapsed ? 'none' : '';","-\t\t}","-\t\tthis._updateChevron();","-\t\tthis._renderHeaderTotalCount();","-\t}","-","-\tprivate _updateChevron(): void {","-\t\tif (!this._chevronElement) {","-\t\t\treturn;","-\t\t}","-\t\tthis._chevronElement.className = 'ai-customization-chevron';","-\t\tthis._chevronElement.classList.add(...ThemeIcon.asClassNameArray(this._collapsed ? Codicon.chevronRight : Codicon.chevronDown));","-\t}","-","-\tprivate _renderHeaderTotalCount(): void {","-\t\tif (!this._headerTotalCountElement) {","-\t\t\treturn;","-\t\t}","-\t\tthis._headerTotalCountElement.textContent = this._headerTotalCount > 0 ? `${this._headerTotalCount}` : '';","-\t\tthis._headerTotalCountElement.classList.toggle('hidden', !this._collapsed || this._headerTotalCount === 0);","-\t}","-","-\tlayout(_height: number, _width: number): void {","-\t\tif (this._collapsed) {","-\t\t\treturn;","-\t\t}","-\t\tthis._scrollableElement?.scanDomNode();","-\t}","-","-\tfocus(): void {","-\t\tif (this._collapsed) {","-\t\t\tthis._headerElement?.focus();","-\t\t\treturn;","-\t\t}","-\t\tthis._toolbar?.focus();","-\t}","-}"],"additions":0,"deletions":258,"truncated":false},{"path":"src/vs/sessions/contrib/sessions/browser/customizations.contribution.ts","lines":["@@ -0,0 +1,105 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { Disposable } from '../../../../base/common/lifecycle.js';","+import { autorun } from '../../../../base/common/observable.js';","+import { localize2 } from '../../../../nls.js';","+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';","+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';","+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../../workbench/common/contributions.js';","+import { AICustomizationManagementEditor } from '../../../../workbench/contrib/chat/browser/aiCustomization/aiCustomizationManagementEditor.js';","+import { AICustomizationManagementEditorInput } from '../../../../workbench/contrib/chat/browser/aiCustomization/aiCustomizationManagementEditorInput.js';","+import { ChatContextKeys } from '../../../../workbench/contrib/chat/common/actions/chatContextKeys.js';","+import { ICustomizationHarnessService } from '../../../../workbench/contrib/chat/common/customizationHarnessService.js';","+import { IEditorService } from '../../../../workbench/services/editor/common/editorService.js';","+import { ISessionsService } from '../../../services/sessions/browser/sessionsService.js';","+import { ISession } from '../../../services/sessions/common/session.js';","+import { OPEN_AI_CUSTOMIZATIONS_COMMAND_ID } from './customizationsConstants.js';","+","+async function openCustomizationOverviewPage(editorService: IEditorService, harnessService: ICustomizationHarnessService, sessionsService: ISessionsService): Promise<void> {","+\tconst session = sessionsService.activeSession.get();","+\tif (session) {","+\t\tharnessService.setActiveSession(session.resource);","+\t}","+","+\tconst input = AICustomizationManagementEditorInput.getOrCreate();","+\tinput.setTargetLabels(harnessService.getActiveDescriptor().label, session?.workspace.get()?.folders[0]?.name);","+\tconst pane = await editorService.openEditor(input, { pinned: true });","+\tif (pane instanceof AICustomizationManagementEditor) {","+\t\tpane.showWelcomePage();","+\t}","+}","+","+registerAction2(class extends Action2 {","+\tconstructor() {","+\t\tsuper({","+\t\t\tid: OPEN_AI_CUSTOMIZATIONS_COMMAND_ID,","+\t\t\ttitle: localize2('customizations', \"Customizations\"),","+\t\t\tprecondition: ChatContextKeys.enabled,","+\t\t});","+\t}","+","+\tasync run(accessor: ServicesAccessor): Promise<void> {","+\t\tawait openCustomizationOverviewPage(","+\t\t\taccessor.get(IEditorService),","+\t\t\taccessor.get(ICustomizationHarnessService),","+\t\t\taccessor.get(ISessionsService),","+\t\t);","+\t}","+});","+","+/**","+ * Returns the harness id that matches a given session, or `undefined` if no","+ * harness is registered for it.","+ *","+ * The session's `resource.scheme` is the per-host harness id (e.g. local AHP","+ * uses `agent-host-${provider}` and remote AHP uses `remote-${authority}-${provider}`),","+ * while {@link ISession.sessionType} is the agent provider name shared across","+ * hosts (e.g. `copilotcli`). Lookup therefore prefers the resource scheme so","+ * that an AHP remote session selects its remote harness rather than the local","+ * harness with the same `sessionType`. The `sessionType` is kept as a fallback","+ * for harnesses whose id matches it directly.","+ */","+export function findHarnessIdForSession(session: ISession | undefined, harnessService: ICustomizationHarnessService): string | undefined {","+\tif (!session) {","+\t\treturn undefined;","+\t}","+\tconst schemeId = session.resource.scheme;","+\tif (harnessService.findHarnessById