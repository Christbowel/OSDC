rvice: ICustomizationHarnessService,","-\t\t@IStorageService private readonly storageService: IStorageService,","-\t) {","-\t\tsuper();","-","-\t\tthis._collapsed = this.storageService.getBoolean(CUSTOMIZATIONS_COLLAPSED_STORAGE_KEY, StorageScope.PROFILE, false);","-","-\t\t// Stable wrapper appended once to the parent. Re-renders replace the","-\t\t// wrapper's children only, so the widget keeps its position relative","-\t\t// to sibling parts (e.g. the agent-host-toolbar below it). Without","-\t\t// this, removing+re-appending the rendered root would move it to the","-\t\t// end of the parent on every re-render, stacking adjacent border-tops.","-\t\tthis._wrapper = DOM.append(container, $('.ai-customization-shortcuts-widget'));","-\t\tthis._options = options;","-\t\tthis._renderForCurrentMode();","-\t}","-","-\tprivate _renderForCurrentMode(): void {","-\t\tif (!this._wrapper) {","-\t\t\treturn;","-\t\t}","-\t\tthis._renderDisposables.clear();","-\t\tthis._scrollableElement = undefined;","-\t\tthis._toolbar = undefined;","-\t\tthis._headerElement = undefined;","-\t\tthis._headerTotalCountElement = undefined;","-\t\tthis._chevronElement = undefined;","-\t\tthis._toolbarContentElement = undefined;","-\t\tthis._scrollableDomNode = undefined;","-\t\tthis._rootVerticalPadding = 0;","-\t\tthis._headerTotalCount = 0;","-\t\tDOM.clearNode(this._wrapper);","-\t\tthis._render(this._wrapper, this._options);","-\t\tthis._setCollapsed(this._collapsed);","-\t}","-","-\tprivate _totalCount() {","-\t\treturn derived(reader => {","-\t\t\tthis.harnessService.activeHarness.read(reader);","-\t\t\tthis.harnessService.availableHarnesses.read(reader);","-\t\t\tconst hidden = new Set(this.harnessService.getActiveDescriptor().hiddenSections ?? []);","-\t\t\tlet total = 0;","-\t\t\tfor (const config of CUSTOMIZATION_ITEMS) {","-\t\t\t\tif (config.section && hidden.has(config.section)) {","-\t\t\t\t\tcontinue;","-\t\t\t\t}","-\t\t\t\tif (config.modelSection) {","-\t\t\t\t\ttotal += this.ite