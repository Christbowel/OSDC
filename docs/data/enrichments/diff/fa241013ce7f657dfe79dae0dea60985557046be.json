"-            let is_maintainer = maintainers","-                .iter()","-                .any(|entry| {","-                    entry.get(\"userId\").and_then(serde_json::Value::as_str) == Some(username)","-                });","-            return Ok(is_maintainer);","-        }","-        return Ok(false);","-    }","-    if let Some(tombstone) = storage.read_tombstone(&canonical).await? {","-        return Ok(tombstone.maintainers","-            .iter()","-            .any(|maintainer| maintainer == username));","-    }","-    // Brand new package: initial publish claims the package; cannot unpublish nonexistent package","-    Ok(matches!(action, Action::Publish))","-}","-","-pub(super) async fn authorize_package(","-    state: &AppState,","-    identity: &Identity,","-    source: &RegistrySource,","-    package: &str,","-    action: Action,","-    org: Option<&str>,","-) -> Result<(), RegistryError> {","-    let rules = source_rules(state, source).snapshot();","-    let effective = rules.for_package(package);","-    let list = match action {","-        Action::Access => &effective.access,","-        Action::Publish => &effective.publish,","-        Action::Unpublish => &effective.unpublish,","-    };","-    if list.allows(identity) {","-        return Ok(());","-    }","-    if list.references_owners() && identity.is_authenticated() {","-        let is_owner = is_package_owner(state, identity, package, org, action).await?;","-        if list.allows_with_context(identity, is_owner) {","-            return Ok(());","-        }","-    }","-    match identity {","-        Identity::Anonymous => {","-            Err(RegistryError::Unauthenticated { resource: format!(\"package {package:?}\") })","-        }","-        Identity::User { username, .. } => Err(RegistryError::Forbidden {","-            user: username.clone(),","-            action: action.label(),","-            resource: format!(\"package {package:?}\"),","-        }),","-        _ => Err(RegistryError::Unauthenticated { resource: format!(\"package {package:?}\") }),","-    }","-}"],"additions":4,"deletions":142,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/authentication/package_access.rs","lines":["@@ -0,0 +1,168 @@","+//! Per-package authorization against the `packages:` rules of the registry","+//! a request resolved to.","+","+use std::sync::LazyLock;","+","+use pnpr_error::RegistryError;","+use pnpr_policy::{AccessList, Identity, PackageRules, RuleTable};","+","+use super::{Action, AppState, RegistrySource};","+","+/// The `packages:` rules of the concrete registry a request resolved to.","+/// Authorization is entirely registry-scoped — there is no global,","+/// name-keyed ACL — so every check consults the one registry that serves","+/// the package. The fallback (safe defaults: reads open, publishes need","+/// ownership, destructive writes denied) only fires for a programmatically","+/// built config whose serving tables miss the graph entry.","+fn source_rules<'a>(state: &'a AppState, source: &RegistrySource) -> &'a PackageRules {","+    static SAFE_DEFAULTS: LazyLock<PackageRules> = LazyLock::new(PackageRules::default);","+    match source {","+        RegistrySource::Hosted(name) => {","+            state.inner.config.routing.hosted.get(name).map(|hosted| &hosted.rules)","+        }","+        RegistrySource::Upstream(name) => {","+            state.inner.config.routing.upstreams.get(name).map(|upstream| &upstream.rules)","+        }","+        RegistrySource::Unclaimed | RegistrySource::NotFound => None,","+    }","+    .unwrap_or(&SAFE_DEFAULTS)","+}","+","+/// Check an already-resolved `identity` against the resolved source","+/// registry's per-package rule (the most specific `packages:` entry, its","+/// omitted fields falling back to the registry defaults). Returns `Ok(())`","+/// when the call is allowed; otherwise the appropriate `Unauthenticated` /","+/// `Forbidden` error. The identity is resolved once by [`authenticate`](super::authenticate), so","+/// every handler — including the search endpoint that filters many packages —","+/// authorizes synchronously against it.","+pub(in crate::server) fn authorize(","+    state: &AppState,","+    identity: &Identity,","+    source: &RegistrySource,","+    package: &str,","+    action: Action,","+) -> Result<(), RegistryError> {","+    let rules = source_rules(state, source).snapshot();","+    if permission_list(&rules, package, action).allows(identity) {","+        return Ok(());","+    }","+    Err(denial(identity, package, action))","+}","+","+/// [`authorize_package`] decided against `packument`, the package's document","+/// as read under the package lock, so the decision holds for the write that","+/// lock guards.","+pub(in crate::server) fn authorize_against_packument(","+    state: &AppState,","+    identity: &Identity,","+    source: &RegistrySource,","+    (package, packument): (&str, &serde_json::Value),","+    action: Action,","+) -> Result<(), RegistryError> {","+    let rules = source_rules(state, source).snapshot();","+    let is_owner = identity","+        .user_id()","+        .is_some_and(|user| {","+            state.inner.config.identity.admins.contains(user)","+                || maintainers_include(packument, user)","+        });","+    if permission_list(&rules, package, action).allows_with_context(identity, is_owner) {","+        return Ok(());","+    }","+    Err(denial(identity, package, action))","+}","+","+fn permission_list<'rules>(","+    rules: &'rules RuleTable,","+    package: &str,","+    action: Action,","+) -> &'rules AccessList {","+    let effective = rules.for_package(package);","+    match action {","+        Action::Access => effective.access,","+        Action::Publish => effective.publish,","+        Action::Unpublish => effective.unpublish,","+    }","+}","+","+/// An anonymous caller gets a chance to authenticate (401); an authenticated","+/// caller isn't in the allowed set (403).","+fn denial(identity: &Identity, package: &str, action: Action) -> RegistryError {","+    match identity {","+        Identity::User { username, .. } => RegistryError::Forbidden {","+            user: username.clone(),","+            action: action.label(),","+            resource: format!(\"package {package:?}\"),","+        },","+        _ => RegistryError::Unauthenticated { resource: format!(\"package {package:?}\") },","+    }","+}","+","+fn maintainers_include(packument: &serde_json::Value, user_id: &str) -> bool {","+    packument","+        .get(\"maintainers\")","+        .and_then(serde_json::Value::as_array)","+        .is_some_and(|maintainers| {","+            maintainers","+                .iter()","+                .any(|entry| {","+                    entry.get(\"userId\").and_then(serde_json::Value::as_str) == Some(user_id)","+                })","+        })","+}","+","+async fn is_package_owner(","+    state: &AppState,","+    identity: &Identity,","+    package: &str,","+    org: Option<&str>,","+    action: Action,","+) -> Result<bool, RegistryError> {","+    let Some(username) = identity.user_id() else {","+        return Ok(false);","+    };","+    if state.inner.config.identity.admins.contains(username) {","+        return Ok(true);","+    }","+    let Ok(canonical) =","+        pnpr_package_name::CanonicalPackageName::parse(package, pnpr_package_name::Ecosystem::Npm)","+    else {","+        return Ok(false);","+    };","+    let storage = crate::server::hosted_storage(state, org);","+    // An authorization check reads the current document, never a replica's","+    // copy that may predate a maintainer's removal.","+    if let Some(stored) = storage.read_hosted_document_for_update(&canonical).await? {","+        return Ok(serde_json::from_slice::<serde_json::Value>(&stored.bytes)","+            .is_ok_and(|packument| maintainers_include(&packument, username)));","+    }","+    if let Some(tombstone) = storage.read_tombstone(&canonical).await? {","+        return Ok(tombstone.maintainers","+            .iter()","+            .any(|maintainer| maintainer == username));","+    }","+    // Brand new package: initial publish claims the package; cannot unpublish nonexistent package","+    Ok(matches!(action, Action::Publish))","+}","+","+pub(in crate::server) async fn authorize_package(","+    state: &AppState,","+    identity: &Identity,","+    source: &RegistrySource,","+    package: &str,","+    action: Action,","+    org: Option<&str>,","+) -> Result<(), RegistryError> {","+    let rules = source_rules(state, source).snapshot();","+    let list = permission_list(&rules, package, action);","+    if list.allows(identity) {","+        return Ok(());","+    }","+    if list.references_owners() && identity.is_authenticated() {","+        let is_owner = is_package_owner(state, identity, package, org, action).await?;","+        if list.allows_with_context(identity, is_owner) {","+            return Ok(());","+        }","+    }","+    Err(denial(identity, package, action))","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/organizations.rs","lines":["@@ -1,8 +1,8 @@"," use super::{","     Action, AppState, Body, CanonicalPackageName, DiscoverySource, Ecosystem, FetchOutcome,","     HostedConfig, HostedGate, Identity, Map, RegistryError, RegistrySource, Response, StatusCode,","-    Value, authorize, default_registry_target, discovery_sources, header, hosted_gate,","-    hosted_storage, json, not_found, resolve_registry_source,","+    Value, authorize, authorize_package, default_registry_target, discovery_sources, header,","+    hosted_gate, hosted_storage, json, not_found, resolve_registry_source,"," };"," use axum::response::IntoResponse;"," ","@@ -86,8 +86,20 @@ pub(super) async fn add_hosted_org_packages(","         if !hosted_org_package_is_visible(state, identity, &scan, &name) {","             continue;","         }","-        let writable = authorize(state, identity, &resolved, &name, Action::Publish).is_ok();","-        let permission = if writable { \"write\" } else { \"read\" };","+        let permission = match authorize_package(","+            state,","+            identity,","+            &resolved,","+            &name,","+            Action::Publish,","+            Some(&hosted.org),","+        )","+        .await","+        {","+            Ok(()) => \"write\",","+            Err(RegistryError::Forbidden { .. } | RegistryError::Unauthenticated { .. }) => \"read\",","+            Err(err) => return Err(err),","+        };","         packages.insert(name, Value::String(permission.to_string()));","     }","     Ok(())"],"additions":16,"deletions":4,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_mutation/dist_tags.rs","lines":["@@ -125,6 +125,8 @@ async fn update_dist_tag(","         .map_err(IntoResponse::into_response)?;","     let target = resolve_write_target(state, identity, request.registry, &name)","         .map_err(IntoResponse::into_response)?;","+    // Under the lock, so a maintainer removed meanwhile can no longer move tags.","+    let _packument_guard = state.inner.locks.packages.lock(name.as_str()).await;","     authorize_package(","         state,","         identity,","@@ -137,7 +139,6 @@ async fn update_dist_tag(","     .map_err(IntoResponse::into_response)?;","     let version = parse_tag_target(request.body).map_err(IntoResponse::into_response)?;","     let storage = hosted_storage(state, Some(&target.org));","-    let _packument_guard = state.inner.locks.packages.lock(name.as_str()).await;","     let change =","         TagChange { tag: request.tag, target: version.as_deref(), principal: identity.user_id() };","     match storage.change_dist_tag(&name, change).await {"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing.rs","lines":["@@ -44,9 +44,9 @@ use pnpr_storage::{"," };"," "," use super::{","-    Action, AppState, HostedGate, RegistrySource, WriteTarget,