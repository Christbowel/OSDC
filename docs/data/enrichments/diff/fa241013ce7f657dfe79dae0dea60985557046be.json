e::Tgz","     };","-    Ok((ValidatedPublish { name, incoming, prepared, publisher, tarballs, variants }, target))","+    let registry = target.source.clone();","+    let validated =","+        ValidatedPublish { name, incoming, prepared, publisher, registry, tarballs, variants };","+    Ok((validated, target))"," }"," "," /// Accept a new npm name or preflight an existing package's metadata update.","@@ -228,6 +234,7 @@ pub(in super::super) async fn stage_publish("," ","     let mut base = read_staged_base(&storage, &doc).await?;","     check_staged_tombstone(state, &storage, &doc, base.packument.is_some()).await?;","+    reauthorize_staged(state, &doc, &base)?;","     let publisher = doc.publisher.user_id().map(str::to_string);","     let (merged, without_any) =","         prepare_publish_document(&storage, &mut doc, &mut base, now_iso).await?;","@@ -255,6 +262,22 @@ pub(in super::super) async fn stage_publish(","     })"," }"," ","+/// Repeat the `publish` check against the document read under the package","+/// lock. The first check ran before the lock, so another publish may have","+/// claimed a new name since.","+fn reauthorize_staged(","+    state: &AppState,","+    doc: &ValidatedPublish,","+    base: &StagedBase,","+) -> Result<(), RegistryError> {","+    let Some(packument) = &base.packument else {","+        return Ok(());","+    };","+    let source = RegistrySource::Hosted(doc.registry.clone());","+    let package = (doc.name.as_str(), packument);","+    authorize_against_packument(state, &doc.publisher, &source, package, Action::Publish)","+}","+"," async fn prepare_publish_document(","     storage: &Storage,","     doc: &mut ValidatedPublish,"],"additions":25,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/tests.rs","lines":["@@ -191,3 +191,5 @@ fn semver_validation_is_strict() {"," mod fence;"," "," mod names;","+","+mod owners;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/tests/owners.rs","lines":["@@ -0,0 +1,89 @@","+//! A publish authorized before the package lock is checked again against","+//! the document it is staged onto.","+","+use super::{package_tar, sha512};","+use crate::server::{","+    publishing::{stage_publish, validate_publish_doc},","+    routing::state_and_router,","+};","+use base64::Engine;","+use pnpr_auth::AuthState;","+use pnpr_error::RegistryError;","+use pnpr_fixtures::MockConfigPresets;","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};","+use pnpr_policy::{Identity, PackageRules};","+use pnpr_storage::metadata::{BatchDocument, PublishNotes, ReleaseRecords};","+use serde_json::{Value, json};","+use std::io::Write;","+use tempfile::TempDir;","+","+fn document(version: &str, maintainer: &str) -> Value {","+    json!({","+        \"name\": \"race-pkg\",","+        \"versions\": { version: { \"name\": \"race-pkg\", \"version\": version } },","+        \"dist-tags\": { \"latest\": version },","+        \"maintainers\": [{ \"name\": maintainer, \"userId\": maintainer }],","+    })","+}","+","+/// An npm publish body for `version` of `race-pkg`, its tarball attached.","+fn publish_body(version: &str) -> Value {","+    let manifest = json!({ \"name\": \"race-pkg\", \"version\": version });","+    let tar = package_tar(manifest.to_string().as_bytes());","+    let mut encoder = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());","+    encoder.write_all(&tar).unwrap();","+    let tgz = encoder.finish().unwrap();","+    let mut version_entry = manifest;","+    version_entry[\"dist\"] = json!({ \"integrity\": sha512(&tgz).to_string() });","+    json!({","+        \"name\": \"race-pkg\",","+        \"versions\": { version: version_entry },","+        \"dist-tags\": { \"latest\": version },"],"additions":41,"deletions":0,"truncated":false}],"additions":334,"deletions":162,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-11-12T17:12:45.550781+00:00"}