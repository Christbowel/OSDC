{"id":"fa241013ce7f657dfe79dae0dea60985557046be","axis":"silent","repo":"pnpm/pnpm","sha":"fa241013ce7f657dfe79dae0dea60985557046be","parsed":{"files":[{"path":".changeset/pnpr-owners-publish-default.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+On npm registries, a `packages:` entry without a `publish` list now admits only the package's maintainers. Before, any signed-in account could publish a new version of any package and move its dist-tags. Set `publish: $authenticated` to keep the old behavior. Cargo, PyPI, and OCI registries keep `$authenticated` as the default and reject `$owners`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/.fixtures/config.yaml","lines":["@@ -17,7 +17,7 @@ registries:","     access: $all","     packages:","       # Scopes seeded from the in-repo fixture sources (`pnpr/.fixtures/packages/`).","-      '@foo/*': &default-rules { unpublish: $authenticated }","+      '@foo/*': &default-rules { publish: $authenticated, unpublish: $authenticated }","       '@having/*': *default-rules","       '@jsr/*': *default-rules","       '@pnpm.e2e/*': *default-rules"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/config/src/access.rs","lines":["@@ -1,6 +1,8 @@"," use super::{","-    AccessList, AccessToken, BTreeSet, Deserialize, IndexMap, RegistryError, TeamDirectory, Teams,","+    AccessList, AccessToken, BTreeSet, Deserialize, Ecosystem, IndexMap, RegistryError,","+    TeamDirectory, Teams,"," };","+use pnpr_policy::records_package_owners;"," "," /// One `packages:` map value: `access` / `publish` / `unpublish` are"," /// permission lists (the built-in `$all` / `$authenticated` / `$anonymous`","@@ -143,6 +145,24 @@ pub fn compile_access_list(","     AccessSpec::Many(entries).to_access_list(teams)"," }"," ","+/// Reject `$owners` in a `publish` or `unpublish` list of a registry whose","+/// ecosystem does not [record package owners](records_package_owners).","+pub fn check_owners_supported(","+    ecosystem: Ecosystem,","+    write_lists: [Option<&AccessList>; 2],","+) -> Result<(), String> {","+    let references_owners = write_lists","+        .into_iter()","+        .flatten()","+        .any(AccessList::references_owners);","+    if references_owners && !records_package_owners(ecosystem) {","+        return Err(format!(","+            \"{ecosystem} registries do not record package owners, so `$owners` admits nobody\",","+        ));","+    }","+    Ok(())","+}","+"," /// Compile `auth.admins`, rejecting any entry that is not one account ID."," pub(super) fn build_admins(names: &[String]) -> Result<BTreeSet<String>, RegistryError> {","     names"],"additions":21,"deletions":1,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -4,7 +4,8 @@"," pub mod oidc;"," "," pub use access::{","-    AccessSpec, PackageAccess, compile_access_list, validate_member_name, validate_team_name,","+    AccessSpec, PackageAccess, check_owners_supported, compile_access_list, validate_member_name,","+    validate_team_name,"," };"," pub use artifacts::{ArtifactQuota, ArtifactsFeature, StorageAccess};"," pub use backend_config::{"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/config/src/registry_graph/rules.rs","lines":["@@ -1,6 +1,6 @@"," use super::super::{","     AccessList, AccessSpec, Ecosystem, IndexMap, PackageAccess, PackagePattern, PackageRule,","-    PackageRules, RegistryError, TeamDirectory,","+    PackageRules, RegistryError, TeamDirectory, check_owners_supported,"," };"," "," /// Compile a `registries:` entry's registry-level `access:` value, naming the","@@ -79,7 +79,7 @@ fn compile_package_rule(","     let key = pattern.to_string();","     let key = key.as_str();","     validate_unpublish_supported(registry, ecosystem, key, rule)?;","-    Ok(PackageRule {","+    let rule = PackageRule {","         pattern: pattern.clone(),","         access: compile_rule_access_list(","             registry,","@@ -102,7 +102,