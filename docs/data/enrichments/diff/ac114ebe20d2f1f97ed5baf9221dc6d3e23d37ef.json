{"id":"ac114ebe20d2f1f97ed5baf9221dc6d3e23d37ef","axis":"silent","repo":"pnpm/pnpm","sha":"ac114ebe20d2f1f97ed5baf9221dc6d3e23d37ef","parsed":{"files":[{"path":".changeset/17727-install-without-manifest-fails.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install`, `pnpm ci`, and `pnpm install-test` outside a workspace now fail with `ERR_PNPM_NO_PKG_MANIFEST` when the directory has no `package.json`, `package.json5`, or `package.yaml`. They no longer create a `package.json`, a lockfile, and `node_modules` there [#17727](https://github.com/pnpm/pnpm/issues/17727)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_install.rs","lines":["@@ -29,7 +29,7 @@ use super::{","     pipelines::{","         AddPipeline, DedupePipeline, DeployPipeline, InstallPipeline, PrunePipeline,","         RemovePipeline, UpdatePipeline, apply_install_cli_config, derive_config_root,","-        installed_project_config, keeps_project_lockfiles,","+        ensure_project_manifest, installed_project_config, keeps_project_lockfiles,","         run_dedicated_lockfile_workspace_install, warn_about_config_root,","     },","     prune::PruneArgs,","@@ -275,6 +275,7 @@ fn install_with_config<'a>(","     let dir = ctx.locations.dir;","     let manifest_path = ctx.locations.manifest_path;","     let cfg = (ctx.loaders.config)()?;","+    ensure_project_manifest(cfg, manifest_path)?;","     let reporter = selected_reporter();","     Ok(Box::pin(async move {","         // Applied between `config()` and `State::init`, while","@@ -330,12 +331,16 @@ pub(super) fn ci<'a>(ctx: &RunCtx<'a>, args: CiArgs) -> miette::Result<CommandFu","     let mut install_args = args.install_args;","     install_args.lockfile.frozen = true;"," ","+    // Built before clean so its up-front checks reject the command before","+    // anything is removed.","+    let install = install_with_update_check(ctx, install_args, UpdateCheckPolicy::Skip)?;","+","     // Run clean eagerly before the async future so errors surface","     // immediately. `ci` is not an overridable command, so this is always","     // the built-in clean, never a `clean` script the project declares.","     clean_builtin(ctx, (ctx.loaders.config)()?, false)?;"," ","-    install_with_update_check(ctx, install_args, UpdateCheckPolicy::Skip)","+    Ok(install)"," }"," "," pub(super) fn dlx<'a>(ctx: &RunCtx<'a>, args: DlxArgs) -> miette::Result<CommandFuture<'a>> {"],"additions":7,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install.rs","lines":["@@ -224,7 +224,7 @@ impl InstallArgs {"," ","     async fn run_inner<Reporter: self::Reporter + 'static>(","         self,","-        mut state: State,","+        state: State,","         selection: Option<InstallFamilySelection>,","     ) -> miette::Result<()> {","         state.http_client.set_warning_handler(pnpm_reporter::emit_global_warning::<Reporter>);","@@ -240,12 +240,6 @@ impl InstallArgs {","         } else {","             self.run_local::<Reporter>(&state, link, selection.as_ref()).await?;","         }","-        if !self.materialization.dry_run","-            && state.config.workspace_dir.is_none()","-            && !state.manifest.path().exists()","-        {","-            state.manifest.save().wrap_err(\"saving initialized package.json\")?;","-        }","         // Resolution watch senders must close inline; only inert manifest and lockfile data","         // may outlive the command through background destruction.","         pnpm_fs::background_drop((state.lockfile, state.manifest, selection));"],"additions":1,"deletions":7,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines.rs","lines":["@@ -1,8 +1,8 @@"," pub(crate) use configuration::{","     apply_install_cli_config, derive_config_root, record_no_runtime_flag, warn_about_config_root,"," };","-pub(crate) use install::InstallPipeline;"," pub(in crate::cli_args) use install::run_dedicated_lockfile_workspace_install;","+pub(crate) use install::{InstallPipeline, ensure_project_manifest};"," pub(crate) use maintenance::{DedupePipeline, PrunePipeline};"," pub(crate) use mutation::{AddPipeline, DeployPipeline, RemovePipeline, UpdatePipeline};"," pub(crate) use selection::{WorkspaceScope, select_workspace_projects};"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines/install.rs","lines":["@@ -6,8 +6,38 @@ use super::{","     project_names, select_install_family,"," };"," use crate::cli_args::recursive::{AutoExcludeRoot, select_recursive_projects};","+use derive_more::{Display, Error};","+use miette::Diagnostic;"," use tracing::Instrument as _;"," ","+/// A plain install outside a workspace found no project manifest. Only","+/// `pnpm add` and `pnpm link` create one.","+#[derive(Debug, Display, Error, Diagnostic)]","+#[display(\"No package.json found in {}\", dir.display())]","+#[diagnostic(code(ERR_PNPM_NO_PKG_MANIFEST))]","+pub(crate) struct NoPkgManifest {","+    #[error(not(source))]","+    pub(crate) dir: PathBuf,","+}","+","+/// Fail a non-recursive install outside a workspace that has no manifest","+/// to install from. A workspace root may lack a manifest.","+///","+/// Call it before anything the command writes, removes, or fetches.","+pub(crate) fn ensure_project_manifest(","+    cfg: &Config,","+    manifest_path: &Path,","+) -> Result<(), NoPkgManifest> {","+    let dir = manifest_path.parent().expect(\"manifest path always has a parent dir\");","+    if cfg.recursive","+        || cfg.workspace_dir.is_some()","+        || pnpm_package_manifest::project_manifest_path(dir).is_file()","+    {","+        return Ok(());","+    }","+    Err(NoPkgManifest { dir: dir.to_path_buf() })","+}","+"," /// The reporter-generic body of `pacquet install`: it threads one `Reporter`"," /// type through config-dependency sync, the `updateConfig` hooks, and the"," /// install itself."],"additions":30,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/state.rs","lines":["@@ -252,7 +252,7 @@ impl State {"," /// A missing manifest is never written here: command initialization"," /// precedes argument validation and serves read-only commands, so the"," /// scaffold stays in memory until a command that writes the manifest","-/// (`install`, `add`, `link`) saves it.","+/// (`add`, `link`) saves it."," ///"," /// Inside a workspace, a missing root manifest is tolerated rather"," /// than scaffolded: pnpm installs such a workspace with no root"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/manifest_creation.rs","lines":["@@ -1,7 +1,7 @@"," use assert_cmd::prelude::*;"," use pnpm_testing_utils::{bin::CommandTempCwd, command_env::CommandTestExt};"," use serde_json::Value;","-use std::{env, fs, process::Command};","+use std::{env, fs, path::Path, process::Command};"," "," fn fixture() -> CommandTempCwd<()> {","     let mut fixture = CommandTempCwd::init();","@@ -127,18 +127,41 @@ fn sbom_from_a_lockfile_does_not_invent_manifest_metadata() {"," }"," "," #[test]","-fn install_still_initializes_a_missing_manifest() {","+fn install_without_a_manifest_fails() {","+    for args in [","+        &[\"install\", \"--offline\"][..],","+        &[\"install\", \"--offline\", \"--allow-build=example-pkg\"],","+        &[\"ci\", \"--offline\"],","+        &[\"install-test\", \"--offline\"],","+    ] {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+        let output = pacquet","+            .args(args)","+            .assert()","+            .failure()","+            .get_output()","+            .stderr","+            .clone();","+        let stderr = String::from_utf8_lossy(&output);","+        assert!(stderr.contains(\"ERR_PNPM_NO_PKG_MANIFEST\"), \"{args:?} stderr: {stderr}\");","+        for written in [\"package.json\", \"pnpm-lock.yaml\", \"node_modules\", \"pnpm-workspace.yaml\"] {","+            assert!(!workspace.join(written).exists(), \"{args:?} wrote {written}\");","+        }","+        drop(root);","+    }","+}","+","+#[test]","+fn ci_without_a_manifest_keeps_node_modules() {","     let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+    let installed = workspace.join(\"node_modules/example-pkg/index.js\");","+    fs::create_dir_all(installed.parent().expect(\"parent\")).expect(\"create node_modules\");","+    fs::write(&installed, \"\").expect(\"write installed file\");","     pacquet","-        .args([\"install\", \"--offline\", \"--ignore-scripts\"])","+        .args([\"ci\", \"--offline\"])","         .assert()","-        .success();","-    let manifest: Value = serde_json::from_slice(","-        &fs::read(workspace.join(\"package.json\")).expect(\"install wrote manifest\"),","-    )","-    .expect(\"parse manifest\");","-    assert_eq!(manifest[\"version\"], \"1.0.0\");","-    assert_eq!(manifest[\"license\"], \"ISC\");","+        .failure();","+    assert!(installed.exists(), \"ci removed node_modules before failing\");","     drop(root);"," }"," ","@@ -243,19 +266,37 @@ fn assert_native_build(args: &[&str], exit_code: i32, existing: bool, after_reso","     drop(root);"," }"," ","+/// A plain install fails without a manifest, so it only runs against an","+/// existing one.","+fn manifest_states(args: &[&str]) -> &'static [bool] {","+    if args[0] == \"install\" { &[true] } else { &[false, true] }","+}","+","+/// Give a plain install the manifest it needs, and report whether the","+/// command must leave the directory without one.","+fn prepare_manifest(args: &[&str], workspace: &Path) -> bool {","+    let needs_manifest = args[0] == \"install\";","+    if needs_manifest {","+        fs::write(workspace.join(\"package.json\"), \"{}\").expect(\"write manifest\");","+    }","+    !needs_manifest","+}","+"," #[test]"," fn native_build_runs_with_initialized_manifest_data() {","     for args in NATIVE_COMMANDS {","-        assert_native_build(args, 0, false, false);","-        assert_native_build(args, 0, true, false);","+        for &existing in manifest_states(args) {","+            assert_native_build(args, 0, existing, false);","+        }","     }"," }"," "," #[test]"," fn native_build_failure_is_propagated() {","     for args in NATIVE_COMMANDS {","-        assert_native_build(args, 17, false, false);","-        assert_native_build(args, 17, true, false);","+        for &existing in manifest_states(args) {","+            assert_native_build(args, 17, existing, false);","+        }","     }"," }"," ","@@ -273,8 +314,9 @@ fn native_build_runs_after_resolution_creates_trigger() {","     ];","     for args in commands {","         for exit_code in [0, 17] {","-            assert_native_build(args, exit_code, false, true);","-            assert_native_build(args, exit_code, true, true);","+            for &existing in manifest_states(args) {","+                assert_native_build(args, exit_code, existing, true);","+            }","         }","     }"," }","@@ -283,13 +325,14 @@ fn native_build_runs_after_resolution_creates_trigger() {"," fn native_build_respects_ignore_scripts() {","     for args in NATIVE_COMMANDS {","         let CommandTempCwd { mut pacquet, workspace, root, .. } = native_fixture(17);","+        let leaves_no_manifest = prepare_manifest(args, &workspace);","         pacquet","             .arg(\"--ignore-scripts\")","             .args(*args)","             .assert()","             .success();","         assert!(!workspace.join(\"native-marker\").exists(), \"{args:?} ran a native build\");","-        if args[0] != \"install\" {","+        if leaves_no_manifest {","             assert!(!workspace.join(\"package.json\").exists(), \"{args:?} created a manifest\");","         }","         drop(root);","@@ -323,6 +366,7 @@ fn native_build_is_skipped_when_not_materializing() {","         &[\"dedupe\", \"--offline\", \"--check\"],","     ] {","         let CommandTempCwd { mut pacquet, workspace, root, .. } = native_fixture(17);","+        let leaves_no_manifest = prepare_manifest(args, &workspace);","         let result = pacquet.args(args).assert();","         if args.contains(&\"--check\") {","             let result = result.failure();","@@ -332,7 +376,7 @@ fn native_build_is_skipped_when_not_materializing() {","             result.success();","         }","         assert!(!workspace.join(\"native-marker\").exists(), \"{args:?} ran a native build\");","-        if args != [\"install\", \"--offline\", \"--lockfile-only\"] {","+        if leaves_no_manifest {","             assert!(!workspace.join(\"package.json\").exists(), \"{args:?} created a manifest\");","         }","         drop(root);",""],"additions":62,"deletions":18,"truncated":false}],"additions":107,"deletions":29,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-06T17:00:27.658004+00:00"}