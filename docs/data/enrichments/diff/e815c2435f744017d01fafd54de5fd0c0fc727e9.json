ler lacks the workspace settings permission, or guardrails are not enabled for this deployment or the workspace's organization\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","-            @ApiResponse(responseCode = \"501\", description = \"Guardrail policies are not available yet\", content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class)))})","+            @ApiResponse(responseCode = \"403\", description = \"The caller lacks the workspace settings permission, or guardrails are not enabled for this deployment or the workspace's organization\", content = @Content(schema = @Schema(implementation = ErrorMessage.class)))})","     @RequiredPermissions(WorkspaceUserPermission.WORKSPACE_SETTINGS_CONFIGURE)","     public Response deleteGuardrailPolicy(@PathParam(\"id\") UUID id) {","-        return notImplemented();","-    }","+        featureFlags.checkGuardrailsValidationsEnabled();"," ","-    private static Response notImplemented() {","-        var status = Response.Status.NOT_IMPLEMENTED;","-        return Response.status(status)","-                .entity(new io.dropwizard.jersey.errors.ErrorMessage(status.getStatusCode(), NOT_IMPLEMENTED_MESSAGE))","-                .build();","+        log.info(\"Deleting guardrail policy with id '{}' in workspace '{}'\", id, requestContext.get().getWorkspaceId());","+        service.delete(id);","+        return Response.noContent().build();","     }"," }"],"additions":47,"deletions":24,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/sorting/SortingFactoryGuardrailPolicies.java","lines":["@@ -0,0 +1,14 @@","+package com.comet.opik.api.sorting;","+","+import java.util.List;","+","+import static com.comet.opik.api.sorting.SortableFields.CREATED_AT;","+import static com.comet.opik.api.sorting.SortableFields.LAST_UPDATED_AT;","+import static com.comet.opik.api.sorting.SortableFields.NAME;","+","+public class SortingFactoryGuardrailPolicies extends SortingFactory {","+    @Override","+    public List<String> getSortableFields() {","+        return List.of(NAME, CREATED_AT, LAST_UPDATED_AT);","+    }","+}"],"additions":14,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/GuardrailPolicyDAO.java","lines":["@@ -0,0 +1,121 @@","+package com.comet.opik.domain;","+","+import com.comet.opik.api.GuardrailExecutionScope;","+import com.comet.opik.api.GuardrailPolicy;","+import com.comet.opik.api.GuardrailType;","+import com.comet.opik.infrastructure.db.GuardrailExecutionScopeMapper;","+import com.comet.opik.infrastructure.db.GuardrailPolicyRulesColumnMapper;","+import com.comet.opik.infrastructure.db.JsonNodeArgumentFactory;","+import com.comet.opik.infrastructure.db.UUIDArgumentFactory;","+import com.fasterxml.jackson.databind.JsonNode;","+import org.jdbi.v3.sqlobject.config.RegisterArgumentFactory;","+import org.jdbi.v3.sqlobject.config.RegisterColumnMapper;","+import org.jdbi.v3.sqlobject.config.RegisterConstructorMapper;","+import org.jdbi.v3.sqlobject.customizer.AllowUnusedBindings;","+import org.jdbi.v3.sqlobject.customizer.Bind;","+import org.jdbi.v3.sqlobject.customizer.BindList;","+import org.jdbi.v3.sqlobject.customizer.BindMethods;","+import org.jdbi.v3.sqlobject.customizer.Define;","+import org.jdbi.v3.sqlobject.statement.SqlBatch;","+import org.jdbi.v3.sqlobject.statement.SqlQuery;","+import org.jdbi.v3.sqlobject.statement.SqlUpdate;","+import org.jdbi.v3.stringtemplate4.UseStringTemplateEngine;","+","+import java.util.Collection;","+import java.util.List;","+import java.util.Optional;","+import java.util.Set;","+import java.util.UUID;","+","+@RegisterArgumentFactory(UUIDArgumentFactory.class)","+@RegisterArgumentFactory(JsonNodeArgumentFactory.class)","+@RegisterArgumentFactory(GuardrailExecutionScopeMapper.class)","+@RegisterColumnMapper(GuardrailExecutionScopeMapper.class)","+@RegisterColumnMapper(GuardrailPolicyRulesColumnMapper.class)","+@RegisterConstructorMapper(GuardrailPolicy.class)","+public interface GuardrailPolicyDAO {","+","+    String SELECT_POLICIES = \"\"\"","+            SELECT p.id, p.name, p.description, p.execution_scope, p.created_at, p.created_by, p.last_updated_at,","+                p.last_updated_by,","+                (SELECT JSON_ARRAYAGG(JSON_OBJECT('type', r.type, 'config', r.config))","+                    FROM guardrail_policy_rules r WHERE r.policy_id = p.id) AS rules","+            FROM guardrail_policies p","+            \"\"\";","+","+    @SqlUpdate(\"\"\"","+            INSERT INTO guardrail_policies(id, workspace_id, name, description, execution_scope, created_by,","+                last_updated_by)","+            VALUES (:policy.id, :workspaceId, :policy.name, :policy.description, :policy.executionScope, :userName,","+                :userName)","+            \"\"\")","+    void save(@BindMethods(\"policy\") GuardrailPolicy policy, @Bind(\"workspaceId\") String workspaceId,","+            @Bind(\"userName\") String userName);","+","+    @SqlBatch(\"\"\"","+            INSERT INTO guardrail_policy_rules(id, policy_id, type, config, created_by, last_updated_by)","+            VALUES (:id, :policyId, :type, :config, :userName, :userName)","+            \"\"\")","+    void saveRules(@Bind(\"id\") List<UUID> ids, @Bind(\"policyId\") UUID policyId,","+            @Bind(\"type\") List<GuardrailType> types, @Bind(\"config\") List<JsonNode> configs,","+            @Bind(\"userName\") String userName);","+","+    // last_updated_at is set explicitly: a change to the rules alone leaves this row as it was, and MySQL only","+    // refreshes ON UPDATE columns when a value changes.","+    @SqlUpdate(\"\"\"","+            UPDATE guardrail_policies SET name = :policy.name, description = :policy.description,","+                execution_scope = :policy.executionScope, last_updated_at = CURRENT_TIMESTAMP(6),","+                last_updated_by = :userName","+            WHERE id = :policy.id AND workspace_id = :workspaceId","+            \"\"\")","+    int update(@BindMethods(\"policy\") GuardrailPolicy policy, @Bind(\"workspaceId\") String workspaceId,","+            @Bind(\"userName\") String userName);","+","+    @SqlQuery(SELECT_POLICIES + \"WHERE p.workspace_id = :workspaceId AND p.id = :id\")","+    Optional<GuardrailPolicy> findById(@Bind(\"id\") UUID id, @Bind(\"workspaceId\") String workspaceId);","+","+    // Exact names and the scope each have an index of their own (see migration 000112). The partial name is escaped","+    // with escapeLike, so its '%' and '_' match only themselves.","+    String FILTERS = \"\"\"","+            <if(name)> AND name LIKE CONCAT('%', :name, '%') ESCAPE '!' <endif>","+            <if(names)> AND name IN (<names>) <endif>","+            <if(execution_scope)> AND execution_scope = :executionScope <endif>","+            \"\"\";","+","+    static String escapeLike(String value) {","+        return value.replace(\"!\", \"!!\").replace(\"%\", \"!%\").replace(\"_\", \"!_\");","+    }","+","+    @SqlQuery(\"SELECT COUNT(*) FROM guardrail_policies WHERE workspace_id = :workspaceId \" + FILTERS)","+    @UseStringTemplateEngine","+    @AllowUnusedBindings","+    long count(@Bind(\"workspaceId\") String workspaceId, @Define(\"name\") @Bind(\"name\") String name,","+            @Define(\"names\") @BindList(onEmpty = BindList.EmptyHandling.NULL_VALUE, value = \"names\") Set<String> names,","+            @Define(\"execution_scope\") @Bind(\"executionScope\") GuardrailExecutionScope executionScope);","+","+    /**","+     * The ids of one page, in order. Selects only {@code id} so the rules JSON never enters a sort buffer, as in","+     * the two-step dashboard page fetch (OPIK-6482); {@link #findByIds(Collection, String)} loads the bodies.","+     */","+    @SqlQuery(\"SELECT id FROM guardrail_policies WHERE workspace_id = :workspaceId \" + FILTERS + \"\"\"","+            ORDER BY <if(sort_fields)> <sort_fields>, <endif> id DESC","+            LIMIT :limit OFFSET :offset","+            \"\"\")","+    @UseStringTemplateEngine","+    @AllowUnusedBindings","+    List<UUID> findPageIds(@Bind(\"workspaceId\") String workspaceId, @Define(\"name\") @Bind(\"name\") String name,","+            @Define(\"names\") @BindList(onEmpty = BindList.EmptyHandling.NULL_VALUE, value = \"names\") Set<String> names,","+            @Define(\"execution_scope\") @Bind(\"executionScope\") GuardrailExecutionScope executionScope,","+            @Define(\"sort_fields\") String sortFields, @Bind(\"limit\") int limit, @Bind(\"offset\") int offset);","+","+    @SqlQuery(SELECT_POLICIES + \"WHERE p.workspace_id = :workspaceId AND p.id IN (<ids>)\")","+    @UseStringTemplateEngine","+    List<GuardrailPolicy> findByIds(@BindList(\"ids\") Collection<UUID> ids, @Bind(\"workspaceId\") String workspaceId);","+","+    @SqlUpdate(\"DELETE FROM guardrail_policy_rules WHERE policy_id IN (<policyIds>)\")","+    @UseStringTemplateEngine","+    void deleteRules(@BindList(\"policyIds\") Collection<UUID> policyIds);","+","+    @SqlUpdate(\"DELETE FROM guardrail_policies WHERE workspace_id = :workspaceId AND id = :id\")","+    int delete(@Bind(\"id\") UUID id, @Bind(\"workspaceId\") String workspaceId);","+}"],"additions":121,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/GuardrailPolicyService.java","lines":["@@ -0,0 +1,337 @@","+package com.comet.opik.domain;","+","+import com.comet.opik.api.GuardrailExecutionScope;","+import com.comet.opik.api.GuardrailPolicy;","+import com.comet.opik.api.GuardrailPolicy.GuardrailPolicyPage;","+import com.comet.opik.api.GuardrailPolicyRule;","+import com.comet.opik.api.GuardrailType;","+import com.comet.opik.api.error.EntityAlreadyExistsException;","+import com.comet.opik.api.error.ErrorMessage;","+import com.comet.opik.api.sorting.SortingFactoryGuardrailPolicies;","+import com.comet.opik.api.sorting.SortingField;","+import com.comet.opik.domain.sorting.SortingQueryBuilder;","+import com.comet.opik.infrastructure.auth.RequestContext;","+import com.comet.opik.infrastructure.inference.Question;","+import com.comet.opik.utils.JsonUtils;","+import com.fasterxml.jackson.databind.JsonNode;","+import com.google.inject.ImplementedBy;","+import jakarta.inject.Inject;","+import jakarta.inject.Provider;","+import jakarta.inject.Singleton;","+import jakarta.ws.rs.BadRequestException;","+import jakarta.ws.rs.NotFoundException;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import lombok.extern.slf4j.Slf4j;","+import org.apache.commons.lang3.StringUtils;","+import org.jdbi.v3.core.statement.UnableToExecuteStatementException;","+import ru.vyarus.guicey.jdbi3.tx.TransactionTemplate;","+","+import java.sql.SQLIntegrityConstraintViolationException;","+import java.util.ArrayList;","+import java.util.EnumSet;","+import java.util.HashSet;","+import java.util.LinkedHashSet;","+import java.util.List;","+import java.util.Map;","+import java.util.Optional;","+import java.util.Set;","+import java.util.UUID;","+import java.util.function.Function;","+import java.util.stream.Collectors;","+","+import static com.comet.opik.infrastructure.db.TransactionTemplateAsync.READ_ONLY;","+import static com.comet.opik.infrastructure.db.TransactionTemplateAsync.WRITE;","+","+@ImplementedBy(GuardrailPolicyServiceImpl.class)","+public interface GuardrailPolicyService {","+","+    UUID create(GuardrailPolicy policy);","+","+    GuardrailPolicy findById(UUID id);","+","+    GuardrailPolicyPage find(int page, int size, String name, Set<String> names,","+            GuardrailExecutionScope executionScope, List<SortingField> sortingFields);","+","+    void update(UUID id, GuardrailPolicy policy);","+","+    void delete(UUID id);","+}","+","+@Slf4j","+@Singleton","+@RequiredArgsConstructor(onConstructor_ = @Inject)","+class GuardrailPolicyServiceImpl implements GuardrailPolicyService {","+","+    /**","+     * Each list becomes one choice question over its topics plus \"none of these\", within the service's option","+     * limit.","+     */","+    static final int MAX_TOPICS = Question.ChoiceQuestion.MAX_OPTIONS - 1;","+    static final int MAX_TOPIC_LENGTH = 256;","+    static final String ALLOWED_TOPICS = \"allowed_topics\";","+    static final String RESTRICTED_TOPICS = \"restricted_topics\";","+    private static final Set<GuardrailType> SUPPORTED_TYPES = EnumSet.of(GuardrailType.PII, GuardrailType.TOPIC,","+            GuardrailType.PROMPT_INJECTION);","+    /** The personal data classes the guardrail checks can detect. */","+    private static final Set<String> PII_CLASSES = Set.of(\"CREDIT_CARD\", \"PHONE_NUMBER\", \"EMAIL_ADDRESS\",","+            \"IBAN_CODE\", \"IP_ADDRESS\", \"NRP\", \"LOCATION\", \"PERSON\", \"CRYPTO\", \"MEDICAL_LICENSE\", \"URL\");","+    /** Every topic question adds this option itself, so a topic with the same name would make its answer ambiguous. */","+    private static final String NONE_OF_THESE = \"none of these\";","+    private static final String POLICY_NOT_FOUND = \"Guardrail policy not found\";","+    private static final String POLICY_ALREADY_EXISTS = \"Guardrail policy already exists\";","+","+    private final @NonNull TransactionTemplate template;","+    private final @NonNull Provider<RequestContext> requestContext;","+    private final @NonNull IdGenerator idGenerator;","+    private final @NonNull SortingFactoryGuardrailPolicies sortingFactory;","+    private final @NonNull SortingQueryBuilder sortingQueryBuilder;","+","+    @Override","+    public UUID create(@NonNull GuardrailPolicy policy) {","+        var newPolicy = withValidRules(policy).toBuilder()","+                .id(policy.id() == null ? idGenerator.generateId() : policy.id())","+                .build();","+        IdGenerator.validateVersion(newPolicy.id(), \"guardrail policy\");","+        String workspaceId = requestContext.get().getWorkspaceId();","+        String userName = requestContext.get().getUserName();","+","+        template.inTransaction(WRITE, handle -> {","+            var dao = handle.attach(GuardrailPolicyDAO.class);","+            try {","+                dao.save(newPolicy, workspaceId, userName);","+            } catch (UnableToExecuteStatementException exception) {","+                throw conflictOr(exception);","+            }","+            saveRules(dao, newPolicy, userName);","+            return null;","+        });","+        log.info(\"Created guardrail policy with id '{}', name '{}' in workspace '{}'\", newPolicy.id(),","+                newPolicy.name(), workspaceId);","+        return newPolicy.id();","+    }","+","+    @Override","+    public GuardrailPolicy findById(@NonNull UUID id) {","+        String workspaceId = requestContext.get().getWorkspaceId();","+","+        return template.inTransaction(READ_ONLY, handle -> handle.attach(GuardrailPolicyDAO.class)","+                .findById(id, workspaceId)","+                .orElseThrow(() -> new NotFoundException(POLICY_NOT_FOUND)));","+    }","+","+    @Override","+    public GuardrailPolicyPage find(int page, int size, String name, @NonNull Set<String> names,","+            GuardrailExecutionScope executionScope, @NonNull List<SortingField> sortingFields) {","+        String workspaceId = requestContext.get().getWorkspaceId();","+        String nameTerm = Optional.ofNullable(StringUtils.trimToNull(name))","+                .map(GuardrailPolicyDAO::escapeLike)","+                .orElse(null);","+        String sortingFieldsSql = sortingQueryBuilder.toOrderBySql(sortingFields);","+","+        return template.inTransaction(READ_ONLY, handle -> {","+            var dao = handle.attach(GuardrailPolicyDAO.class);","+            long total = dao.count(workspaceId, nameTerm, names, executionScope);","+            var pageIds = dao.findPageIds(workspaceId, nameTerm, names, executionScope, sortingFieldsSql, size,","+                    (page - 1) * size);","+ 