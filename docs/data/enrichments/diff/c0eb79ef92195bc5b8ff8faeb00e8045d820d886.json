-boundary.tsx","lines":["@@ -0,0 +1,53 @@","+import type { FunctionalComponent } from '@stencil/core';","+import { h } from '@stencil/core';","+import { focusFirstDescendant, focusLastDescendant } from '@utils/focus-trap';","+","+interface OverlayFocusBoundaryProps {","+  /** The overlay host element. */","+  overlay: HTMLElement;","+  /** Whether the boundary renders before or after the overlay content. */","+  edge: 'start' | 'end';","+}","+","+/**","+ * Moves focus off a boundary. Focus arriving from inside the overlay","+ * wraps to the opposite end. Focus arriving from outside enters at the","+ * nearest end.","+ */","+const onBoundaryFocus = (overlay: HTMLElement, ev: FocusEvent, edge: 'start' | 'end') => {","+  /**","+   * Shadow overlays search their slotted content. Scoped overlays search","+   * their wrapper, since the boundaries are siblings of it in the same","+   * tree and would otherwise be found first.","+   */","+  const container = overlay.shadowRoot ? overlay : overlay.querySelector<HTMLElement>('.ion-overlay-wrapper');","+  if (!container) {","+    return;","+  }","+","+  const from = ev.relatedTarget as Node | null;","+  const fromInside =","+    from !== null && from !== overlay && (overlay.contains(from) || overlay.shadowRoot?.contains(from) === true);","+  const focusFirst = edge === 'start' ? !fromInside : fromInside;","+","+  if (focusFirst) {","+    focusFirstDescendant(container, overlay);","+  } else {","+    focusLastDescendant(container, overlay);","+  }","+};","+","+/**","+ * Renders a focusable element before or after an overlay's content that","+ * keeps Tab inside the overlay. The document focus listener in overlays.ts","+ * cannot do this alone, since browsers can move focus past the end of the","+ * page without firing a focus event.","+ */","+export const OverlayFocusBoundary: FunctionalComponent<OverlayFocusBoundaryProps> = ({ overlay, edge }) => (","+  <div","+    class=\"ion-overlay-focus-boundary\"","+    tabIndex={0}","+    aria-hidden=\"true\"","+    onFocus={(ev) => onBoundaryFocus(overlay, ev, edge)}","+  ></div>","+);"],"additions":53,"deletions":0,"truncated":false},{"path":"core/src/utils/overlays.ts","lines":["@@ -248,18 +248,9 @@ const trapKeyboardFocus = (ev: Event, doc: Document) => {"," ","       /**","        * Otherwise, we must be focusing an element","-       * inside of the overlay. The two possible options","-       * here are an input/button/etc or the ion-focus-trap","-       * element. The focus trap element is used to prevent","-       * the keyboard focus from leaving the overlay when","-       * using Tab or screen assistants.","+       * inside of the overlay.","        */","     } else {","-      /**","-       * We do not want to focus the traps, so get the overlay","-       * wrapper element as the traps live outside of the wrapper.","-       */","-","       const overlayRoot = getElementRoot(lastOverlay);","       if (!overlayRoot.contains(target)) {","         return;","@@ -276,41 +267,12 @@ const trapKeyboardFocus = (ev: Event, doc: Document) => {","        * Additionally, if the backdrop was tapped we should not","        * move focus back inside the wrapper as that could cause","        * an interactive elements focus state to activate.","+       *","+       * The focus boundaries outside of the wrapper move","+       * focus back inside on their own.","        */","       if (overlayWrapper.contains(target) || target === overlayRoot.querySelector('ion-backdrop')) {","         lastOverlay.lastFocus = target;","-      } else {","-        /**","-         * Otherwise, we must have focused one of the focus traps.","-         * We need to wrap the focus to either the first element","-         * or the last element.","-         */","-","-        /**","-         * Once we call `focusFirstDescendant` and focus the first","-         * descendant, another focus event will fire which will","-         * cause `lastOverlay.lastFocus` to be updated before","-         * we can run the code after that. We will cache the value","-         * here to avoid that.","-         */","-        const lastFocus = lastOverlay.lastFocus;","-","-        // Focus the first element in the overlay wrapper","-        focusFirstDescendant(overlayWrapper, lastOverlay);","-","-        /**","-         * If the cached last focused element is the","-         * same as the active element, then we need","-         * to wrap focus to the last descendant. This happens","-         * when the first descendant is focused, and the user","-         * presses Shift + Tab. The previous line will focus","-         * the same descendant again (the first one), causing","-         * last focus to equal the active element.","-         */","-        if (lastFocus === doc.activeElement) {","-          focusLastDescendant(overlayWrapper, lastOverlay);","-        }","-        lastOverlay.lastFocus = doc.activeElement as HTMLElement;","       }","     }","   };"],"additions":4,"deletions":42,"truncated":false},{"path":"core/src/utils/test/overlay-focus-boundary.spec.tsx","lines":["@@ -0,0 +1,164 @@","+import { newSpecPage } from '@stencil/core/testing';","+","+import { Alert } from '../../components/alert/alert';","+import { Modal } from '../../components/modal/modal';","+","+/**","+ * Focuses a boundary the way a browser does when Tab lands on it:","+ * `relatedTarget` is the element focus is coming from.","+ */","+const focusBoundary = (boundary: Element, relatedTarget: EventTarget | null) => {","+  boundary.dispatchEvent(new FocusEvent('focus', { relatedTarget }));","+};","+","+describe('overlay focus boundary', () => {","+  describe('shadow overlay', () => {","+    const setup = async () => {","+      const page = await newSpecPage({","+        components: [Modal],","+        html: `","+          <button id=\"outside\">Outside</button>","+          <ion-modal>","+            <button id=\"first\">First</button>","+            <button id=\"last\">Last</button>","+          </ion-modal>","+        `,","+      });","+      const modal = page.body.querySelector('ion-modal')!;","+      const [start, end] = Array.from(modal.shadowRoot!.querySelectorAll('.ion-overlay-focus-boundary'));","+      const outside = page.body.querySelector<HTMLElement>('#outside')!;","+      const first = page.body.querySelector<HTMLElement>('#first')!;","+      const last = page.body.querySelector<HTMLElement>('#last')!;","+      const focusFirst = jest.spyOn(first, 'focus');","+      const focusLast = jest.spyOn(last, 'focus');","+","+      return { modal, start, end, outside, first, last, focusFirst, focusLast };","+    };","+","+    it('should render a boundary before and after the content, hidden from assistive technology', async () => {","+      const { modal, start, end } = await setup();","+      const wrapper = modal.shadowRoot!.querySelector('.ion-overlay-wrapper');","+","+      expect(start.nextElementSibling).toBe(wrapper);","+      expect(wrapper!.nextElementSibling).toBe(end);","+","+      for (const boundary of [start, end]) {","+        expect(boundary.getAttribute('tabindex')).toBe('0');","+        expect(boundary.getAttribute('aria-hidden')).toBe('true');","+      }","+    });","+","+    it('should wrap to the last element when Shift+Tab leaves the first element', async () => {","+      const { start, first, focusFirst, focusLast } = await setup();","+","+      focusBoundary(start, first);","+","+      expect(focusLast).toHaveBeenCalled();","+      expect(focusFirst).not.toHaveBeenCalled();","+    });","+","+    it('should wrap to the first element when Tab leaves the last element', async () => {","+      const { end, last, focusFirst, focusLast } = await setup();","+","+      focusBoundary(end, last);","+","+      expect(focusFirst).toHaveBeenCalled();","+      expect(focusLast).not.toHaveBeenCalled();","+    });","+","+    it('should treat focus from inside the shadow root as coming from inside', async () => {","+      const { modal, start, focusFirst, focusLast } = await setup();","+      const wrapper = modal.shadowRoot!.querySelector('.ion-overlay-wrapper')!;","+","+      focusBoundary(start, wrapper);","+","+      expect(focusLast).toHaveBeenCalled();","+      expect(focusFirst).not.toHaveBeenCalled();","+    });","+","+    it('should enter at the first element when Tab arrives from outside', async () => {","+      const { start, outside, focusFirst, focusLast } = await setup();","+","+      focusBoundary(start, outside);","+","+      expect(focusFirst).toHaveBeenCalled();","+      expect(focusLast).not.toHaveBeenCalled();","+    });","+","+    it('should enter at the last element when Shift+Tab arrives from outside', async () => {","+      const { end, outside, focusFirst, focusLast } = await setup();","+","+      focusBoundary(end, outside);","+","+      expect(focusLast).toHaveBeenCalled();","+      expect(focusFirst).not.toHaveBeenCalled();","+    });","+","+    it('should enter at the first element when Tab leaves the focused overlay host', async () => {","+      const { modal, start, focusFirst, focusLast } = await setup();","+","+      focusBoundary(start, modal);","+","+      expect(focusFirst).toHaveBeenCalled();","+      expect(focusLast).not.toHaveBeenCalled();","+    });","+","+    it('should enter at the nearest end when focus arrives from outside the page', async () => {","+      const { start, end, focusFirst, focusLast } = await setup();","+","+      focusBoundary(start, null);","+      expect(focusFirst).toHaveBeenCalledTimes(1);","+","+      focusBoundary(end, null);","+      expect(focusLast).toHaveBeenCalledTimes(1);","+    });","+  });","+","+  describe('scoped overlay', () => {","+    const setup = async (buttons: string[]) => {","+      const page = await newSpecPage({","+        components: [Alert],","+        html: `<button id=\"outside\">Outside</button><ion-alert></ion-alert>`,","+      });","+      const alert = page.body.querySelector('ion-alert')!;","+      alert.buttons = buttons;","+      await page.waitForChanges();","+","+      const [start, end] = Array.from(alert.querySelectorAll('.ion-overlay-focus-boundary'));","+      const alertButtons = Array.from(alert.querySelectorAll<HTMLElement>('.alert-button'));","+","+      return { page, alert, start, end, alertButtons };","+    };","+","+    it('should search the wrapper so a boundary never focuses another boundary', async () => {","+      const { page, start, end, alertButtons } = await setup(['First', 'Last']);","+      const [first, last] = alertButtons;","+      const outside = page.body.querySelector<HTMLElement>('#outside')!;","+      const focusFirst = jest.spyOn(first, 'focus');","+      const focusLast = jest.spyOn(last, 'focus');","+      const focusStart = jest.spyOn(start as HTMLElement, 'focus');","+      const focusEnd = jest.spyOn(end as HTMLElement, 'focus');","+","+      focusBoundary(start, outside);","+      expect(focusFirst).toHaveBeenCalledTimes(1);","+","+      focusBoundary(start, first);","+      expect(focusLast).toHaveBeenCalledTimes(1);","+","+      focusBoundary(end, last);","+      expect(focusFirst).toHaveBeenCalledTimes(2);","+","+      expect(focusStart).not.toHaveBeenCalled();","+      expect(focusEnd).not.toHaveBeenCalled();","+    });","+","+    it('should focus the overlay host when there is nothing focusable inside', async () => {","+      const { alert, start } = await setup([]);","+      const focusHost = jest.spyOn(alert, 'focus');","+","+      focusBoundary(start, null);","+","+      expect(focusHost).toHaveBeenCalled();","+    });","+  });","+});"],"additions":164,"deletions":0,"truncated":false},{"path":"core/src/utils/test/overlays/overlays.e2e.ts","lines":["@@ -529,5 +529,127 @@ configs({ modes: ['ios'], directions: ['ltr'] }).forEach(({ title, config }) =>","       await expect(wrapper).toHaveAttribute('role', 'dialog');","       await expect(wrapper).toBeFocused();","     });","+","+    [","+      {","+        tagName: 'ion-modal