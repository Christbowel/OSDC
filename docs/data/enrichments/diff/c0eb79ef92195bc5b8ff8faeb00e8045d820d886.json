rget)) {","+                  (window as any).focusedOutside.push(target.id || target.tagName);","+                }","+              },","+              true","+            );","+          }, tagName);","+","+          await pageUtils.pressKeys('Shift+Tab');","+          await expect(lastButton).toBeFocused();","+","+          await pageUtils.pressKeys('Tab');","+          await expect(firstButton).toBeFocused();","+","+          const focusedOutside = await page.evaluate(() => (window as any).focusedOutside);","+          expect(focusedOutside).toEqual([]);","+        });","+","+        test('should let focus leave the overlay when focusTrap is false', async ({ page, pageUtils }) => {","+          await page.setContent(","+            `","+            <button id=\"before\">Before</button>","+            <${tagName} focus-trap=\"false\">${content}</${tagName}>","+          `,","+            config","+          );","+","+          const overlay = page.locator(tagName);","+","+          await overlay.evaluate((el: HTMLIonModalElement | HTMLIonPopoverElement) => el.present());","+          // present() moves focus into the overlay a frame after it resolves","+          await page.waitForFunction(","+            (selector) => document.querySelector(selector)!.contains(document.activeElement),","+            tagName","+          );","+","+          await page.locator('#first').focus();","+          await pageUtils.pressKeys('Shift+Tab');","+","+          await expect(page.locator('#before')).toBeFocused();","+        });","+      });","+    });","+","+    test('should let focus leave a sheet modal below its backdropBreakpoint', async ({ page, pageUtils }) => {","+      await page.setContent(","+        `","+        <button id=\"before\">Before</button>","+        <ion-modal handle=\"false\" initial-breakpoint=\"0.3\" backdrop-breakpoint=\"0.5\">","+          <button id=\"first\">First</button><button id=\"last\">Last</button>","+        </ion-modal>","+        <script>","+          document.querySelector('ion-modal').breakpoints = [0.3, 0.5, 1];","+        </script>","+      `,","+        config","+      );","+","+      const modal = page.locator('ion-modal');","+      const firstButton = page.locator('#first');","+","+      await modal.evaluate((el: HTMLIonModalElement) => el.present());","+      // present() moves focus into the overlay a frame after it resolves","+      await page.waitForFunction(() => document.querySelector('ion-modal')!.contains(document.activeElement));","+      await firstButton.focus();","+      await pageUtils.pressKeys('Shift+Tab');","+","+      await expect(page.locator('#before')).toBeFocused();","+","+      // The focus trap turns back on above the backdropBreakpoint","+      await modal.evaluate((el: HTMLIonModalElement) => el.setCurrentBreakpoint(1));","+      await firstButton.focus();","+      await pageUtils.pressKeys('Shift+Tab');","+","+      await expect(page.locator('#last')).toBeFocused();","+    });","   });"," });",""],"additions":122,"deletions":0,"truncated":false}],"additions":378,"deletions":54,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-17T18:43:56.543194+00:00"}