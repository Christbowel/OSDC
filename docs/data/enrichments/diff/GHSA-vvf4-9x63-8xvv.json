 requires them to be","+  decimal numbers of meters with at most two fractional digits, as RFC 1876","+  section 3 specifies.  They were converted with ``float()``, so ``9.29m``","+  became 928 cm rather than 929 cm and the text and wire forms of the record","+  disagreed, forms such as ``1e3m``, ``1_000m``, ``+10m``, ``nanm``, and","+  ``infm`` were accepted, extra fractional digits were silently dropped, and an","+  altitude outside the representable range was accepted and then failed in","+  ``to_wire()`` with a non-DNS exception.  ``dns.exception.SyntaxError`` is","+  now raised for all of these.","+>>>>>>> a62e1be0 (Constrain WKS bitmap size.)","+"," * The resolver now assigns a new random query id to every query."," "," * For transports that require a 0 query id, set it in a way that does not break"],"additions":19,"deletions":0,"truncated":false},{"path":"tests/test_rdata.py","lines":["@@ -45,6 +45,7 @@"," from dns.rdtypes.ANY.GPOS import GPOS"," from dns.rdtypes.ANY.LOC import LOC"," from dns.rdtypes.ANY.OPT import OPT","+from dns.rdtypes.IN.WKS import WKS"," from tests.util import here"," "," ","@@ -511,6 +512,22 @@ def test_misc_bad_WKS_text(self):","         except dns.exception.SyntaxError as e:","             self.assertIsInstance(e.__cause__, NotImplementedError)"," ","+    def test_wks_bounds(self):","+        rd = dns.rdata.from_text(\"IN\", \"WKS\", \"10.0.0.1 udp 0\")","+        self.assertEqual(rd.bitmap, b\"\\x80\")","+        rd = dns.rdata.from_text(\"IN\", \"WKS\", \"10.0.0.1 udp 65535\")","+        self.assertEqual(len(rd.bitmap), 8192)","+        self.assertEqual(rd.bitmap[-1], 1)","+        with self.assertRaises(dns.exception.SyntaxError):","+            rd = dns.rdata.from_text(\"IN\", \"WKS\", \"10.0.0.1 udp -1\")","+        with self.assertRaises(dns.exception.SyntaxError):","+            rd = dns.rdata.from_text(\"IN\", \"WKS\", \"10.0.0.1 udp 65536\")","+        # test direct invocation of the constructor too","+        rd = WKS(dns.rdataclass.IN, dns.rdatatype.WKS, \"10.0.0.1\", 1, bytes())","+        rd = WKS(dns.rdataclass.IN, dns.rdatatype.WKS, \"10.0.0.1\", 1, bytes(8192))","+        with self.assertRaises(ValueError):","+            WKS(dns.rdataclass.IN, dns.rdatatype.WKS, \"10.0.0.1\", 1, bytes(8193))","+","     def test_GPOS_float_converters(self):","         rd = dns.rdata.from_text(\"in\", \"gpos\", \"49 0 0\")","         self.assertEqual(rd.float_latitude, 49.0)",""],"additions":17,"deletions":0,"truncated":false}],"additions":43,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-14T15:12:31.149381+00:00"}