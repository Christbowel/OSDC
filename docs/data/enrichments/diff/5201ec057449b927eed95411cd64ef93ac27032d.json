   K,","+    V,","+    Rel,","+    BlockTable,","+    SeqLens,","+    CuSeqlensQ,","+    Out,","+    Lse,","+    Gate,","+    Sink,","+    softmax_scale,","+    num_tokens,","+    num_splits,","+    stride_q_t,","+    stride_q_h,","+    stride_kv_blk,","+    stride_kv_slot,","+    stride_kv_h,","+    stride_rel_t,","+    stride_bt,","+    stride_out_t,","+    stride_out_h,","+    stride_lse_h,","+    stride_lse_t,","+    stride_gate,","+    stride_sink,","+    H: tl.constexpr,","+    G: tl.constexpr,","+    D: tl.constexpr,","+    E: tl.constexpr,","+    PAGE: tl.constexpr,","+    WINDOW: tl.constexpr,","+    DRAFT: tl.constexpr,","+    MODE: tl.constexpr,","+    BLOCK_M: tl.constexpr,","+    BLOCK_N: tl.constexpr,","+):","+    TOKENS: tl.constexpr = BLOCK_M // G","+    E_PAD: tl.constexpr = E + 256","+    LOG2E: tl.constexpr = 1.4426950408889634","+    m_tile = tl.program_id(0)","+    kv_head = tl.program_id(1) // num_splits","+    split = tl.program_id(1) % num_splits","+    req = tl.program_id(2)","+    q_start = tl.load(CuSeqlensQ + req)","+    q_len = tl.load(CuSeqlensQ + req + 1) - q_start","+    first_tok = m_tile * TOKENS","+    if first_tok >= q_len:","+        return","+    seqlen_k = tl.load(SeqLens + req)","+    past = seqlen_k - q_len","+","+    rows = tl.arange(0, BLOCK_M)","+    tok = first_tok + rows // G","+    row_valid = (rows < TOKENS * G) & (tok < q_len)","+    head = kv_head * G + rows % G","+    token = (q_start + tok).to(tl.int64)","+    if DRAFT:","+        pos = tl.zeros([BLOCK_M], tl.int32) + seqlen_k - 1","+        pos_lo = seqlen_k - 1","+        pos_hi = seqlen_k - 1","+    else:","+        pos = past + tok","+        pos_lo = past + first_tok","+        pos_hi = past + tl.minimum(first_tok + TOKENS, q_len) - 1","+    # Visible key blocks of the tile, split `split` taking every","+    # `num_splits`-th of them.","+    n_lo = 0","+    if WINDOW > 0:","+        n_lo = tl.maximum(pos_lo - (WINDOW - 1), 0) // BLOCK_N","+    n_hi = tl.minimum(pos_hi + 1, seqlen_k)","+    n_hi = (n_hi + BLOCK_N - 1) // BLOCK_N","+    num_iters = tl.maximum(n_hi - n_lo - split + num_splits - 1, 0) // num_splits","+","+    offs_d = tl.arange(0, D)","+    q = tl.load(","+        Q + token[:, None] * stride_q_t + head[:, None] * stride_q_h + offs_d[None, :],","+        mask=row_valid[:, None],","+        other=0.0,","+    )","+    if not DRAFT:","+        tile_end = tl.minimum((tok // _SHEAR_TILE + 1) * _SHEAR_TILE, q_len)","+        rel_base = (past + tile_end + 127) // 128 * 128 - E_PAD","+        rel_row = Rel + token * stride_rel_t + head * E_PAD - rel_base","+","+    qk_scale = softmax_scale * LOG2E","+    m_i = tl.full([BLOCK_M], float(\"-inf\"), tl.float32)","+    l_i = tl.zeros([BLOCK_M], tl.float32)","+    acc = tl.zeros([BLOCK_M, D], tl.float32)","+    block_table = BlockTable + req.to(tl.int64) * stride_bt","+    kv_off = kv_head * stride_kv_h","+    for i in range(num_iters):","+        n = n_lo + split + i * num_splits","+        keys = n * BLOCK_N + tl.arange(0, BLOCK_N)","+        key_valid = keys < seqlen_k","+        page = tl.load(block_table + keys // PAGE, mask=key_valid, other=0)","+        kv_ptrs = (","+            page.to(tl.int64) * stride_kv_blk + (keys % PAGE) * stride_kv_slot + kv_off","+        )","+        k = tl.load(","+            K + kv_ptrs[None, :] + offs_d[:, None], mask=key_valid[None, :], other=0.0","+        )","+        s = tl.dot(q, k) * qk_scale","+        dist = pos[:, None] - keys[None, :]","+        visible = (dist >= 0) & key_valid[None, :]","+        if WINDOW > 0:","+            visible &= dist < WINDOW","+        if not DRAFT:","+            in_extent = visible & (dist < E) & row_valid[:, None]","+            bias = tl.load(rel_row[:, None] + keys[None, :], mask=in_extent, other=0.0)","+            s += bias.to(tl.float32) * LOG2E","+        s = tl.where(visible, s, float(\"-inf\"))","+        m_new = tl.maximum(m_i, tl.max(s, 1))","+        m_safe = tl.where(m_new == float(\"-inf\"), 0.0, m_new)"],"additions":153,"deletions":0,"truncated":false}],"additions":426,"deletions":88,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-19T17:58:51.822489+00:00"}