ord.into(),","                     VarValue::RepoCargoHome => {","+                        // Setup creates the homes' directory private. Cargo","+                        // would create a missing one that others can read,","+                        // and a later setup would reject it.","+                        match owner_only_directory(&self.cargo_homes()) {","+                            Err(Error::Io(e)) if e.kind() == io::ErrorKind::NotFound => {","+                                return Err(Error::NotInstalled(\"Cargo home\".into()));","+                            }","+                            result => result?,","+                        }","                         let home = self.cargo_home(repo);","                         // Cargo creates a missing home on first use; a link or","                         // a file there would redirect a private one."],"additions":29,"deletions":3,"truncated":false},{"path":"crates/turborepo-tool-install/src/tests.rs","lines":["@@ -477,6 +477,23 @@ fn launchers_run_other_trees_without_an_inherited_environment_and_leave_cargo_ho","         f.store.activate(&root, selection.key()),","         Err(Error::UnsafePath)","     ));","+    // Never a Cargo home whose private parent setup has not created: Cargo","+    // would create both for every user to read.","+    fs::remove_file(f.store.cargo_home(&root)).unwrap();","+    fs::remove_dir(f.store.cargo_homes()).unwrap();","+    assert!(matches!(","+        f.store.activate(&root, selection.key()),","+        Err(Error::NotInstalled(_))","+    ));","+    // Nor one whose parent other users can read.","+    fs::create_dir(f.store.cargo_homes()).unwrap();","+    fs::set_permissions(f.store.cargo_homes(), fs::Permissions::from_mode(0o755)).unwrap();","+    assert!(matches!(","+        f.store.activate(&root, selection.key()),","+        Err(Error::UnsafePath)","+    ));","+    let setup = f.store.begin_setup(repo.path(), Reuse::Sealed);","+    assert!(matches!(setup, Err(Error: