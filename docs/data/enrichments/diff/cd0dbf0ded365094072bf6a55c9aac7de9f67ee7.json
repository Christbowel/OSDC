{"id":"cd0dbf0ded365094072bf6a55c9aac7de9f67ee7","axis":"silent","repo":"leaflet/leaflet","sha":"cd0dbf0ded365094072bf6a55c9aac7de9f67ee7","parsed":{"files":[{"path":".github/workflows/main.yml","lines":["@@ -68,6 +68,7 @@ jobs:"," ","       - run: npm ci","       - run: npm run lint","+      - run: npm run lint:docs","       - run: npm run typecheck","       - run: npm run build","       - run: npm run test:types"],"additions":1,"deletions":0,"truncated":false},{"path":"build/docs-audit.js","lines":["@@ -0,0 +1,243 @@","+// Lists the public API that the reference leaves undocumented: exported classes, functions, values and type members","+// without a JSDoc description, and reference pages without an intro. Also checks that the names in","+// `build/reference.json` exist, that every documented class and namespace is listed in it, and that categories are","+// in sentence case. Exits with 1 on any problem, so that CI catches them.","+","+import {readFileSync} from 'node:fs';","+import {join, relative, resolve} from 'node:path';","+import {API} from 'typescript/sync';","+import {SyntaxKind as SK, getTextOfJSDocComment} from 'typescript/ast';","+","+const COMPILER_OPTIONS = {","+\ttarget: 'es2022', lib: ['es2022', 'dom'], module: 'nodenext', allowJs: true, checkJs: true, strict: true, types: []","+};","+","+// statics every class redeclares for the options and constructor hook machinery documented on `Class`","+const MACHINERY = new Set(['defaultOptions', 'initHooks']);","+// `XDefaults` interfaces repeat the options of `XOptions` as required, for use inside the class","+const DEFAULTS = /Defaults$/;","+const NON_SPACE = /\\S/;","+const CATEGORY_TAG = /@category(?:Description)?[ \\t]+([^\\n*]+)/g;","+const CAPITALIZED = /^[A-Z]/;","+const ALL_CAPS = /^[A-Z]+$/;","+// declarations documented elsewhere: the `Layer` default of an option documented as an \"Interactive layer\" one","+const DOCUMENTED_ELSEWHERE = new Set(['src/layer/LayerBase.js bubblingPointerEvents']);","+","+const dir = resolve(process.argv[2] ?? '.');","+const config = JSON.parse(readFileSync(join(dir, 'build/reference.json'), 'utf8'));","+const api = new API({cwd: dir});","+let checker;","+const problems = new Map();","+","+try {","+\tconst parsed = api.parseJsonConfigFileContent({compilerOptions: COMPILER_OPTIONS, include: ['src']},","+\t\t{configDirectory: dir});","+\tconst snapshot = api.createSnapshot({createPrograms: [{rootFiles: parsed.fileNames, compilerOptions: parsed.options}]});","+\tconst program = snapshot.operation.createdPrograms[0];","+\tchecker = program.getProject().checker;","+\tconst exports = audit([join(dir, 'src/Leaflet.js'), join(dir, 'src/types.ts')].map(f => program.getSourceFile(f)));","+\tcheckConfig(exports, new Map(parsed.fileNames.map(f => [relative(dir, f), readFileSync(f, 'utf8')])));","+} finally {","+\tapi.close();","+}","+","+if (problems.size) {","+\tconsole.log([...problems.values()].sort().join('\\n'));","+\tconsole.log(`\\n${problems.size} documentation problems`);","+\tprocess.exitCode = 1;","+}","+","+function audit([main, types]) {","+\tconst exports = new Map();","+\tfor (const sf of [main, types]) {","+\t\tfor (const sym of checker.getExportsOfModule(checker.getSymbolAtLocation(sf))) {","+\t\t\tif (exports.has(sym.name)) { continue; }","+\t\t\tconst target = resolveAlias(sym);","+\t\t\texports.set(sym.name, {sym: target, decl: declOf(target), fromTypes: sf === types});","+\t\t}","+\t}","+","+\tfor (const [name, {sym, decl, fromTypes}] of exports) {","+\t\tif (!decl || isDeprecated(decl)) { continue; }","+\t\tif (decl.kind === SK.ClassDeclaration) {","+\t\t\tif (!hasDescription(decl)) { report(decl, `${name} class`); }","+\t\t\t// a base class constructor without parameters only runs from `super()`","+\t\t\tconst ctors = decl.members.filter(m => m.kind === SK.Constructor);","+\t\t\tif (ctors.some(c => c.parameters.length) && !ctors.some(hasDescription) &&","+\t\t\t\t!hasTag(decl, 'constructorDescription')) {","+\t\t\t\treport(ctors[0], `${name} constructor`);","+\t\t\t}","+\t\t\tmembers(`${name}#`, checker.getDeclaredTypeOfSymbol(sym), p => inBase(decl, p, true));","+\t\t\tmembers(`${name}.`, checker.getTypeOfSymbol(sym), p => MACHINERY.has(p) || inBase(decl, p, false));","+\t\t} else if (decl.kind === SK.SourceFile) {","+\t\t\tfor (const e of checker.getExportsOfModule(sym)) { member(`${name}.`, resolveAlias(e)); }","+\t\t} else if (decl.kind === SK.InterfaceDeclaration || decl.kind === SK.JSTypeAliasDeclaration ||","+\t\t\tdecl.kind === SK.TypeAliasDeclaration) {","+\t\t\t// types only get documented members when exported for users, i.e. from `types.ts`","+\t\t\tif (fromTypes && !DEFAULTS.test(name)) { members(`${name}.`, checker.getDeclaredTypeOfSymbol(sym)); }","+\t\t} else if (!hasDescription(decl)) {","+\t\t\treport(decl, name);","+\t\t}","+\t}","+","+\tconst pages = [","+\t\t...config.groups.flatMap(g => g.entries.map(e => (typeof e === 'string' ? e : e.name))),","+\t\t...Object.values(config.miniclasses).flat(),","+\t\t...Object.values(config.tables).flatMap(Object.values).flat()","+\t];","+\tfor (const name of pages) {","+\t\tconst decl = config.pseudo[name] ? exports.get(config.pseudo[name][0])?.decl :","+\t\t\texports.get(config.headers[name] ?? name)?.decl;","+\t\tconst doc = decl?.kind === SK.SourceFile ? moduleDoc(decl) : docOf(decl);","+\t\tif (decl && !description(doc)) { report(decl, `${name} page intro`); }","+\t}","+\treturn exports;","+}","+","+function checkConfig(exports, sources) {","+\tconst source = [...sources.values()].join('\\n');","+\tconst configProblem = (msg) => { problems.set(`config: ${msg}`, `${msg}  build/reference.json`); };","+\tconst exported = name => exports.has(name);","+\tconst entries = config.groups.flatMap(g => g.entries.map(e => (typeof e === 'string' ? e : e.name)));","+\tconst pages = new Set([...entries, ...Object.values(config.miniclasses).flat()]);","+\tconst rows = Object.values(config.tables).flatMap(Object.values).flat();","+","+\tfor (const name of pages) {","+\t\tif (!config.pseudo[name] && !config.headers[name] && !exported(name)) { configProblem(`Page ${name} not exported`); }","+\t}","+\tfor (const name of [...rows, ...config.unlisted, ...Object.values(config.pseudo).flat(),","+\t\t...Object.values(config.headers), ...Object.values(config.members).flatMap(Object.values)]) {","+\t\tif (!exported(name)) { configProblem(`${name} not exported`); }","+\t}","+\tconst keyed = ['miniclasses', 'tables', 'categoryOrder', 'members', 'headers', 'pseudo'];","+\tfor (const key of keyed) {","+\t\tfor (const name of Object.keys(config[key] ?? {})) {","+\t\t\tif (!pages.has(name)) { configProblem(`${key} key ${name} is not a page`); }","+\t\t}","+\t}","+\tfor (const name of Object.keys(config.display)) {","+\t\tif (!pages.has(name) && !exported(name)) { configProblem(`display key ${name} not exported`); }","+\t}","+\tfor (const [name, page] of Object.entries(config.fold)) {","+\t\tif (!new RegExp(`\\\\bclass ${name}\\\\b`).test(source)) { configProblem(`fold key ${name} is not a class`); }","+\t\tif (!pages.has(page)) { configProblem(`fold value ${page} is not a page`); }","+\t}","+","+\t// by declaration, since a class can be exported under another name (`LeafletMap as Map`)","+\tconst listed = new Set([...pages, ...rows, ...config.unlisted].map(n => exports.get(n)?.decl));","+\tfor (const [name, {decl}] of exports) {","+\t\tconst doc = decl?.kind === SK.SourceFile ? moduleDoc(decl) : decl?.kind === SK.ClassDeclaration && docOf(decl);","+\t\tif (!listed.has(decl) && description(doc)) { configProblem(`Documented ${name} is neither a page nor unlisted`); }","+\t}","+","+\tconst categories = new Set();","+\tfor (const [file, text] of sources) {","+\t\tfor (const m of text.matchAll(CATEGORY_TAG)) {","+\t\t\tconst category = m[1].trim();","+\t\t\tcategories.add(category);","+\t\t\t// words after the first are lowercase, unless they're names like `DivOverlay` or abbreviations like `URL`","+\t\t\tconst [first, ...rest] = category.split(' ');","+\t\t\tif (!CAPITALIZED.test(first) || rest.some(w => CAPITALIZED.test(w) && !exported(w) && !ALL_CAPS.test(w))) {","+\t\t\t\tconst line = text.slice(0, m.index).split('\\n').length;","+\t\t\t\tproblems.set(`${file}:${line}`, `Category \"${category}\" is not in sentence case  ${file}:${line}`);","+\t\t\t}","+\t\t}","+\t}","+\tfor (const [page, order] of Object.entries(config.categoryOrder ?? {})) {","+\t\tfor (const category of order) {","+\t\t\tif (!categories.has(category)) { configProblem(`categoryOrder of ${page} has unknown category \"${category}\"`); }","+\t\t}","+\t}","+}","+","+function members(prefix, type, skip = () => false) {","+\tfor (const p of checker.getPropertiesOfType(type)) {","+\t\tif (p.name.startsWith('_') || p.name === 'prototype' || skip(p.name)) { continue; }","+\t\tmember(prefix, p);","+\t}","+}","+","+function member(prefix, sym) {","+\tif (sym.name.startsWith('_')) { return; }","+\tconst decls = declsOf(sym).filter(d => d.getSourceFile().fileName.startsWith(join(dir, 'src/')) &&","+\t\t!DOCUMENTED_ELSEWHERE.has(`${relative(dir, d.getSourceFile().fileName)} ${sym.name}`));","+\tif (decls.length && !decls.some(d => hasDescription(d) || isDeprecated(d))) {","+\t\t// named after the class that declares it rather than the first subclass that comes up","+\t\tlet cls = decls[0];","+\t\twhile (cls && cls.kind !== SK.ClassDeclaration) { cls = cls.parent; }","+\t\treport(decls[0], cls ? cls.name.text + prefix.at(-1) + sym.name : prefix + sym.name);","+\t}","+}","+","+// overrides of a member described on an ancestor class, or on the interfaces merged into one (`Layer#onAdd`)","+function inBase(cls, name, instance) {","+\tfor (let c = baseOf(cls); c; c = baseOf(c)) {","+\t\tconst sym = checker.getSymbolAtLocation(c.name);","+\t\tconst type = instance ? checker.getDeclaredTypeOfSymbol(sym) : checker.getTypeOfSymbol(sym);","+\t\tconst p = checker.getPropertyOfType(type, name);","+\t\tif (p && declsOf(p).some(hasDescription)) { return true; }","+\t}","+\treturn false;","+}","+","+// one entry per declaration, since inherited members come up under every subclass","+function report(decl, label) {","+\tconst sf = decl.getSourceFile();","+\tconst start = decl.pos + sf.text.slice(decl.pos, decl.end).search(NON_SPACE);","+\tconst line = sf.text.slice(0, start).split('\\n').length;","+\tconst key = `${sf.fileName}:${start}`;","+\tif (!problems.has(key)) { problems.set(key, `${label}  ${relative(dir, sf.fileName)}:${line}`); }","+}","+","+function baseOf(cls) {","+\tconst ext = cls.heritageClauses?.find(c => c.token === SK.ExtendsKeyword)?.types[0]?.expression;","+\tconst decl = ext && declOf(resolveAlias(checker.getSymbolAtLocation(ext)));","+\treturn decl?.kind === SK.ClassDeclaration ? decl : null;","+}","+","+function resolveAlias(sym) {","+\treturn sym && (sym.flags & 2097152 /* Alias */) ? checker.getAliasedSymbol(sym) : sym;","+}","+","+function declsOf(sym) {","+\treturn (sym?.declarations ?? []).map(d => d.resolve?.() ?? d);","+}","+","+function declOf(sym) {","+\treturn declsOf(sym)[0];","+}","+","+// a variable's JSDoc is on its statement, and that of a `this.x = …` property on its expression statement","+function docsOf(decl) {","+\tlet node = decl;","+\tif (node?.kind === SK.VariableDeclaration) { node = node.parent.parent; }","+\tif (node?.kind === SK.PropertyAccessExpression || node?.kind === SK.BinaryExpression) {","+\t\twhile (node && node.kind !== SK.ExpressionStatement) { node = node.parent; }","+\t}","+\treturn node?.jsDoc ?? [];","+}","+","+function docOf(decl) {","+\treturn docsOf(decl).at(-1);","+}","+","+function moduleDoc(sf) {","+\treturn sf.statements.flatMap(s => s.jsDoc ?? []).find(d => (d.tags ?? []).some(t => t.tagName?.text === 'module'));","+}","+","+function description(doc) {","+\tconst c = doc?.comment;","+\treturn (typeof c === 'string' ? c : getTextOfJSDocComment(c) ?? '').trim();","+}","+","+function hasDescription(decl) {","+\treturn docsOf(decl).some(description);","+}","+","+function hasTag(decl, name) {","+\treturn docsOf(decl).some(d => (d.tags ?? []).some(t => t.tagName?.text === name));","+}","+","+function isDeprecated(decl) {","+\treturn hasTag(decl, 'deprecated');","+}"],"additions":243,"deletions":0,"truncated":false},{"path":"build/reference-ts.js","lines":["@@ -21,7 +21,7 @@ const PARAM_MARKS = /^…|\\?$/g;"," const BLOCK_COMMENT = /\\/\\*.*?\\*\\/\\s*/g;"," const FENCE = /```.*?```/gs;"," ","-let checker, config, pages, ownerOfInterface, lookup;","+let checker, config, pages, tableRows, ownerOfInterface, lookup;"," "," export function tsModel(dir) {"," \t// the compiler resolves source files against its cwd, so a relative ref directory would be resolved twice","@@ -53,6 +53,7 @@ function build(entries) {"," \tconst top = config.groups.flatMap(g => g.entries.map(entryName));"," \tconst minis = Object.entries(config.miniclasses).flatMap(([parent, names]) => names.map(name => ({name, parent})));"," \tpages = new Set([...top, ...minis.map(m => m.name)]);","+\ttableRows = new Set(Object.values(config.tables).flatMap(Object.values).flat());"," "," \t// options and event map interfaces → the page that documents their own members: `XOptions` belongs to `X`,"," \t// one used by classes without their own to the first such class","@@ -78,7 +79,7 @@ function build(entries) {"," \t\t} else if (config.headers[name]) {"," \t\t\traws.push(createNamespace(name, descriptionOf(docOf(lookup(config.headers[name]))), parent));"," \t\t} else if (!decl) {","-\t\t\tconsole.warn(`Reference entry ${name} not found`);","+\t\t\t// `npm run lint:docs` reports it, the build only skips it"," \t\t\treturn;"," \t\t} else if (decl.kind === SK.ClassDeclaration) {"," \t\t\traws.push(classPage(name, decl, parent));","@@ -92,6 +93,12 @@ function build(entries) {"," \t\t\traws.push(valuePage(name, decl));"," \t\t}"," \t\tconst ns = raws.at(-1);","+\t\tconst order = config.categoryOrder?.[name];","+\t\tif (order) {","+\t\t\t// a def