{"id":"ce25b6b151ee23456ff7996a6c3b721321612025","axis":"silent","repo":"TryGhost/Ghost","sha":"ce25b6b151ee23456ff7996a6c3b721321612025","parsed":{"files":[{"path":".dependency-cruiser-known-violations.json","lines":["@@ -484,6 +484,11 @@","     \"from\": \"ghost/core/server/services/identity-tokens/identity-token-service-wrapper.js\",","     \"to\": \"ghost/core/shared/url-utils.ts\"","   },","+  {","+    \"rule\": \"service-dependencies\",","+    \"from\": \"ghost/core/server/services/jobs-service/register-job-handlers.ts\",","+    \"to\": \"ghost/core/server/auth/better-auth/clear-expired-auth-rows-job.ts\"","+  },","   {","     \"rule\": \"service-dependencies\",","     \"from\": \"ghost/core/server/services/jobs-service/register-job-handlers.ts\","],"additions":5,"deletions":0,"truncated":false},{"path":"docs/plans/better-auth-migration.md","lines":["@@ -278,8 +278,8 @@ Auth core.","   the session is created, so the session guard below admits them. The unlock","   only matches a `locked` user, and a user suspended in the meantime is refused."," - A successful `/reset-password` sets a `locked` user `active`, as legacy","-  `doReset` does, so the user can sign in afterwards (step 8, PLA-620). Until","-  then a native reset leaves the user locked.","+  `doReset` does, so the user can sign in afterwards (step 8, PLA-620). It","+  refuses an `inactive` user's token before changing the password."," - After every sign-in: set `last_seen`, and set a `warn-*` status to `active`.","   Both are bookkeeping, so a failure is logged and the sign-in stands."," - `databaseHooks.session.create.before`: refuse non-active users on every path."],"additions":2,"deletions":2,"truncated":false},{"path":"ghost/core/boot.js","lines":["@@ -536,6 +536,7 @@ async function initServices({ ghostServer, config, prometheusClient, jobsService","     contentImport,","     updateCheck,","     signingKeys: signingKeys.service,","+    authCleanup: require('./server/auth/better-auth/cleanup'),","   });","   await jobsService.start();","   debug('End: Register job handlers');","@@ -644,6 +645,14 @@ async function initBackgroundServices({ config }) {","     logging.error(err);","   }"," ","+  try {","+    const authCleanup = require('./server/auth/better-auth/cleanup');","+    await authCleanup.scheduleClearExpiredJob(jobsService);","+  } catch (err) {","+    const logging = require('@tryghost/logging');","+    logging.error(err);","+  }","+","   // Load email analytics recurring jobs. Runs before activitypub.init for the","   // same reason as the schedules above. Each failure is logged rather than","   // thrown so one failed registration cannot hide a sibling's or stop the"],"additions":9,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/README.md","lines":["@@ -78,8 +78,16 @@ until Phase 4.","   while a session is being created can leave a session row, which","   `revokeUserSessions` in the same gap misses. Anything that trusts a session","   or token (the Admin API resolver, revocation, app tokens) must check the","-  user's status too. Server-only: `createVerifiedSession`, which requires the","+  user's status too. A successful `/reset-password` sets a `locked` user","+  `active`, as legacy `doReset` does; it refuses an `inactive` user's token","+  before changing the password, and a suspension that lands during the reset","+  stands. Server-only: `createVerifiedSession`, which requires the","   admin origin, `revokeUserSessions` and `revokeAllSessions`.","+- `cleanup.ts`: the daily `clear-expired-auth-rows` job (plan §4.6), which","+  deletes expired `user_sessions` and `verifications` rows. Better Auth checks","+  expiry on read but never deletes them. It runs under either engine wherever","+  `auth:betterAuthDev` is on, and deletes in batches by primary key, as the","+  `rate_limits` cleanup does, so it doesn't deadlock with live writes."," - `plugins/sso.ts` (`ghostSso`): server-only `createSsoSession`, for the SSO","   adapter hook described below. It applies the passwordless rules above","   (unlocks `locked`, refuses `inactive`) and creates a verified session pinned"],"additions":9,"deletions":1,"truncated":false},{"path":"ghost/core/server/auth/better-auth/cleanup.ts","lines":["@@ -0,0 +1,81 @@","+import logging from '@tryghost/logging';","+import type { Knex } from 'knex';","+import { getAffectedRows } from '../../lib/db-types/affected-rows';","+import { defaultIndexName } from '../../data/schema/lib/default-index-name';","+import type { TableName } from '../../data/schema/schema';","+import type { JobsService } from '../../services/jobs-service/jobs-service';","+import ClearExpiredAuthRowsJob from './clear-expired-auth-rows-job';","+import { usesBetterAuth } from './enabled';","+","+// Better Auth reads expiry on use but never purges these rows (plan §4.6)","+const TABLES = ['user_sessions', 'verifications'] satisfies TableName[];","+const BATCH_SIZE = 500;","+","+type Table = (typeof TABLES)[number];","+","+/**","+ * Deletes expired rows in batches. Reads the ids first, then deletes by","+ * primary key, so it locks rows in the same order as Better Auth's writes; a","+ * DELETE ranging over the expiry index can deadlock with them.","+ */","+export async function clearExpiredAuthRows(","+  knex: Knex,","+  { batchSize = BATCH_SIZE }: { batchSize?: number } = {},","+): Promise<Record<Table, number>> {","+  const deleted = { user_sessions: 0, verifications: 0 };","+","+  for (const table of TABLES) {","+    for (;;) {","+      const now = new Date();","+      const ids: string[] = await knex(table)","+        .where('expires_at', '<', now)","+        .limit(batchSize)","+        .pluck('id');","+","+      if (ids.length === 0) {","+        break;","+      }","+","+      // MySQL may still pick the expiry index for a short id list. SQLite (dev and testing only) reads the hint as a comment","+      const result = await knex.raw(","+        `DELETE /*+ NO_INDEX(${table} ${defaultIndexName(table, 'expires_at')}) */ FROM ?? WHERE ?? IN (${ids.map(() => '?').join(', ')}) AND ?? < ?`,","+        [table, 'id', ...ids, 'expires_at', now],","+      );","+      deleted[table] += getAffectedRows(result);","+","+      if (ids.length < batchSize) {","+        break;","+      }","+    }","+  }","+","+  return deleted;","+}","+","+/** The job handler: a no-op where the tables don't exist */","+export async function clearExpired(): Promise<void> {","+  if (!usesBetterAuth()) {","+    return;","+  }","+  const { knex } = require('../../data/db');","+  const deleted = await clearExpiredAuthRows(knex);","+  logging.info(","+    { system: { event: 'clear_expired_auth_rows.completed', deleted } },","+    `[Background Job] clear-expired-auth-rows removed ${deleted.user_sessions} sessions and ${deleted.verifications} verifications`,","+  );","+}","+","+let scheduled = false;","+","+/** Schedules the daily cleanup under either engine, since sessions outlive a rollback */","+export async function scheduleClearExpiredJob(jobsService: JobsService): Promise<void> {","+  if (scheduled || !usesBetterAuth()) {","+    return;","+  }","+","+  // Random off-peak time (00:00-05:59) so a fleet of sites doesn't run at once","+  const cron = `${Math.floor(Math.random() * 60)} ${Math.floor(Math.random() * 60)} ${Math.floor(Math.random() * 6)} * * *`;","+  logging.info(`[Background Job] clear-expired-auth-rows scheduled at ${cron}`);","+  await jobsService.scheduleRecurring(new ClearExpiredAuthRowsJob(), { cron });","+  scheduled = true;","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/clear-expired-auth-rows-job.ts","lines":["@@ -0,0 +1,5 @@","+import { Job } from '../../services/jobs-service/job';","+","+export default class ClearExpiredAuthRowsJob extends Job {","+  static type = 'clear-expired-auth-rows';","+}"],"additions":5,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/plugins/staff-lifecycle.ts","lines":["@@ -93,6 +93,19 @@ export const ghostStaffLifecycle = (options: StaffLifecycleOptions) => {","       authContext = ctx;","       return {","         options: {","+          emailAndPassword: {","+            // Required by the type; the instance's own options take precedence","+            enabled: true,","+            // As legacy doReset; a user suspended since keeps their status","+            async onPasswordReset({ user }) {","+              await setStatus(","+                await getCurrentAdapter(authContext.adapter),","+                user.id,","+                ['locked'],","+                'active',","+              );","+            },","+          },","           databaseHooks: {","             session: {","               create: {","@@ -135,6 +148,30 @@ export const ghostStaffLifecycle = (options: StaffLifecycleOptions) => {","     },"," ","     hooks: {","+      before: [","+        {","+          // Legacy doReset refuses a suspended user before changing the password","+          matcher: (ctx) => ctx.path === ROUTES.resetPassword,","+          handler: createAuthMiddleware(async (ctx) => {","+            const token: unknown = ctx.body?.token || ctx.query?.token;","+            if (typeof token !== 'string') {","+              return;","+            }","+            const verification = await ctx.context.internalAdapter.findVerificationValue(","+              `reset-password:${token}`,","+            );","+            if (!verification || verification.expiresAt < new Date()) {","+              return;","+            }","+            const user = (await ctx.context.internalAdapter.findUserById(","+              verification.value,","+            )) as StaffUser | null;","+            if (user?.status === 'inactive') {","+              throw refusal('inactive');","+            }","+          }),","+        },","+      ],","       // After the endpoint, so its CSRF check and validation have run","       after: [","         {"],"additions":37,"deletions":0,"truncated":false},{"path":"ghost/core/server/data/schema/schema.ts","lines":["@@ -2856,3 +2856,5 @@ const schema = {"," } satisfies Record<string, TableDefinition>;"," "," export default schema;","+","+export type TableName = keyof typeof schema;"],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/jobs-service/register-job-handlers.ts","lines":["@@ -24,6 +24,7 @@ import type EmailService from '../email-service/email-service';"," import SendEmailJob from '../email-service/jobs/send-email-job';"," import CheckSigningKeysJob from '../signing-keys/check-signing-keys-job';"," import type { SigningKeyService } from '../signing-keys/signing-key-service';","+import ClearExpiredAuthRowsJob from '../../auth/better-auth/clear-expired-auth-rows-job';"," "," // Webmention processing fetches external pages and is triggered by"," // unauthenticated requests, so webmention jobs run in their own lane where a","@@ -66,6 +67,9 @@ interface RegisterJobHandlersDependencies {","   };","   updateCheck: (options: { rethrowErrors: boolean }) => Promise<void>;","   signingKeys: Pick<SigningKeyService, 'check'>;","+  authCleanup: {","+    clearExpired(): Promise<void>;","+  };"," }"," "," export default function registerJobHandlers({","@@ -85,6 +89,7 @@ export default function registerJobHandlers({","   contentImport,","   updateCheck,","   signingKeys,","+  authCleanup,"," }: RegisterJobHandlersDependencies): void {","   // Each email analytics pipeline fetches on its own five-minute tick and the","   // wrapper skips a tick while its previous fetch is still running. The second","@@ -141,6 +146,10 @@ export default function registerJobHandlers({","     await signingKeys.check();","   });"," ","+  jobsService.handle(ClearExpiredAuthRowsJob, async () => {","+    await authCleanup.clearExpired();","+  });","+","   jobsService.handle(","     ProcessWebmentionJob,","     async (job) => {"],"additions":9,"deletions":0,"truncated":false},{"path":"ghost/test/e2e-server/better-auth-upgrade.isolated.test.ts","lines":["@@ -0,0 +1,184 @@","+import assert from 'node:assert/strict';","+import { spawn, type ChildProcess } from 'node:child_process';","+import { once } from 'node:events';","+import { setTimeout as sleep } from 'node:timers/promises';","+import net from 'node:net';","+import path from 'node:path';","+import request from 'supertest';","+","+const { startGhost, fixtureManager, configUtils } = require('../utils/e2e-framework');","+const db = require('../../core/server/data/db');","+const jobsService = require('../../core/server/services/jobs-service');","+const stripe = require('../../core/server/services/stripe');","+const DataGenerator = require('../utils/fixtures/data-generator');","+","+const isSQLite = ['sqlite3', 'better-sqlite3'].includes(db.knex.client.config.client);","+","+const owner = DataGenerator.Content.users[0];","+const GHOST_ROOT = path.join(__dirname, '../..');","+const BOOT_TIMEOUT_MS = 90_000;","+","+type Engine = 'legacy' | 'better-auth';","+","+async function freePort(): Promise<number> {","+  const server = net.createServer().listen(0, '127.0.0.1');","+  await once(server, 'listening');","+  const { port } = server.address() as net.AddressInfo;","+  server.close();","+  await once(server, 'close');","+  return port;","+}","+","+/**","+ * Boots Ghost in its own process on the test database: the engine is chosen","+ * once at module load, so switching it takes a restart, as on a real site","+ */","+async function bootGhost(engine: Engine, contentPath: string, port: number) {","+  const url = `http://127.0.0.1:${port}`;","+  let output = '';","+  const child: ChildProcess = spawn(","+    process.execPath,","+    ['--conditions=source', '--import=tsx', 'index.js'],","+    {","+      cwd: GHOST_ROOT,","+      env: {","+        ...process.env,","+        NODE_ENV: 'testing-mysql',","+        url: `${url}/`,","+        server__port: String(port),","+        paths__contentPath: contentPath,","+        auth__engine: engine,","+        auth__betterAuthDev: 'true',","+        createInDevelopmentTables: 'true',","+        security__staffDeviceVerification: 'false',","+      },","+      stdio: ['ignore', 'pipe', 'pipe'],","+    },","+  );","+  child.stdout?.on('data', (chunk) => (output += chunk));","+  child.stderr?.on('data', (chunk) => (output += chunk));","+","+  const exited = once(child, 'exit').then(([code]) => {","+    throw new Error(`Ghost (${engine}) exited with ${code} during boot:\\n${output}`);","+  });","+  const ready = (async () => {","+    const deadline = Date.now() + BOOT_TIMEOUT_MS;","+    while (Date.now() < deadline && !exitedAlready(child)) {","+      // Bounded, so a stalled response can't outlast the boot deadline","+      const ok = await fetch(`${url}/ghost/api/admin/site/`, {","+        signal: AbortSignal.timeout(Math.max(1, deadline - Date.now())),","+      })","+        .then((res) => res.ok)","+        .catch(() => false);","+      if (ok) {","+        return;","+      }","+      await sleep(250);","+    }","+    throw new Error(`Ghost (${engine}) did not boot in time:\\n${output}`);","+  })();","+  try {","+    await Promise.race([ready, exited]);","+  } catch (err) {","+    child.kill('SIGKILL');","+    throw err;","+  }","+  exited.catch(() => {});","+","+  return {","+    url,","+    async stop() {","+      if (exitedAlready(child)) {","+        return;","+      }","+      const stopped = once(child, 'exit');","+      child.kill('SIGTERM');","+      const timer = setTimeout(() => child.kill('SIGKILL'), 15_000);","+      await stopped;","+      clearTimeout(timer);","+    },","+  };","+}","+","+// A child killed by a signal has a signalCode and no exitCode","+const exitedAlready = (child: ChildProcess) => child.exitCode !== null || child.signalCode !== null;","+","+const cookieOf = (response: request.Response) =>","+  [response.headers['set-cookie']].flat().map((c: string) => c.split(';')[0]);","+","+// Plan §7: a signed-in staff user upgrades to better-auth, signs in once, and a","+// rollback to legacy honours their old session (§8)","+describe.skipIf(isSQLite)('Upgrading auth:engine from legacy to better-auth', function () {","+  let contentPath: string;","+  // One site URL throughout: sessions are pinned to their origin","+  let port: number;","+  let ghost: Awaited<ReturnType<typeof bootGhost>> | undefined;","+","+  const restart = async (engine: Engine) => {","+    await ghost?.stop();","+    ghost = undefined;","+    ghost = await bootGhost(engine, contentPath, port);","+  };","+","+  const signIn = async () => {","+    const response = await request(ghost!.url)","+      .post('/ghost/api/admin/session/')","+      .set('Origin', ghost!.url)","+      .send({ username: owner.email, password: owner.password })","+      .expect(201);","+    return cookieOf(response);","+  };","+","+  const me = (cookie: string[]) =>","+    request(ghost!.url)","+      .get('/ghost/api/admin/users/me/')","+      .set('Origin', ghost!.url)","+      .set('Cookie', cookie);","+","+  beforeAll(async function () {","+    // The test database with fixture users; each engine then boots on it in its own process","+    await startGhost({ backend: true, frontend: false, server: false });","+    await fixtureManager.init('users');","+    contentPath = configUtils.config.get('paths:contentPath');","+    port = await freePort();","+    await jobsService.shutdown();","+  }, BOOT_TIMEOUT_MS);","+","+  afterAll(async function () {","+    await ghost?.stop();","+    try {","+      await jobsService.shutdown();","+    } finally {","+      await stripe.shutdown();","+      await configUtils.restore();","+    }","+  }, 30_000);","+","+  // One test: each step uses the cookies the step before it issued","+  it(","+    'signs in once after the upgrade and keeps the old session for a rollback',","+    async function () {","+      await restart('legacy');","+      const legacyCookie = await signIn();","+      await me(legacyCookie).expect(200);","+","+      // Signed out once; the existing password still works","+      await restart('better-auth');","+      await me(legacyCookie).expect(403);","+      const betterAuthCookie = await signIn();","+      await me(betterAuthCookie).expect(200);","+      // Kept for a rollback; only security events delete legacy rows","+      assert.equal((await db.knex('sessions').where({ user_id: owner.id })).length, 1);","+","+      // Not asked again after a restart","+      await restart('better-auth');","+      await me(betterAuthCookie).expect(200);","+","+      // Rollback honours the old session; sessions since the flip aren't legacy sessions","+      await restart('legacy');","+      await me(legacyCookie).expect(200);","+      await me(betterAuthCookie).expect(403);","+    },","+    4 * BOOT_TIMEOUT_MS,","+  );","+});"],"additions":184,"deletions":0,"truncated":false},{"path":"ghost/test/integration/auth/cleanup.test.ts","lines":["@@ -0,0 +1,133 @@","+import assert from 'node:assert/strict';","+import ObjectId from 'bson-objectid';","+","+const testUtils = require('../../utils');","+const configUtils = require('../../utils/config-utils');","+const db = require('../../../core/server/data/db');","+const { getInstance: getJobsService } = require('../../../core/server/services/jobs-service');","+const ClearExpiredAuthRowsJob =","+  require('../../../core/server/auth/better-auth/clear-expired-auth-rows-job').default;","+// require, not import: cleanup must read the config instance configUtils sets","+const {","+  clearExpiredAuthRows,","+  clearExpired,","+}: typeof import('../../../core/server/auth/better-auth/cleanup') = require('../../../core/server/auth/better-auth/cleanup');","+","+const HOUR = 60 * 60 * 1000;","+","+async function waitFor(check: () => Promise<boolean>, timeoutMs = 5000): Promise<boolean> {","+  const deadline = Date.now() + timeoutMs;","+  while (Date.now() < deadline) {","+    if (await check()) {","+      return true;","+    }","+    await new Promise((resolve) => {","+      setTimeout(resolve, 25);","+    });","+  }","+  return false;","+}","+","+describe('Better Auth expired row cleanup', function () {","+  let userId: string;","+","+  const at = (offsetMs: number) => new Date(Date.now() + offsetMs);","+","+  async function insertSessions(expiries: Date[]) {","+    const ids = expiries.map(() => new ObjectId().toHexString());","+    await db.knex('user_sessions').insert(","+      expiries.map((expiresAt, i) => ({","+        id: ids[i],","+        user_id: userId,","+        token: `token-${ids[i]}`,","+        expires_at: expiresAt,","+        verified: true,","+        created_at: new Date(),","+        updated_at: new Date(),","+      })),","+    );","+    return ids;","+  }","+","+  async function insertVerifications(expiries: Date[]) {","+    const ids = expiries.map(() => new ObjectId().toHexString());","+    await db.knex('verifications').insert(","+      expiries.map((expiresAt, i) => ({","+        id: ids[i],","+        identifier: `reset-password:${ids[i]}`,","+        value: userId,","+        expires_at: expiresAt,","+        created_at: new Date(),","+        updated_at: new Date(),","+      })),","+    );","+    return ids;","+  }","+","+  const ids = (table: string): Promise<string[]> => db.knex(table).orderBy('id').pluck('id');","+","+  beforeAll(async function () {","+    await testUtils.startGhost();","+    userId = (await db.knex('users').first('id')).id;","+  });","+","+  beforeEach(async function () {","+    await db.knex('user_sessions').del();","+    await db.knex('verifications').del();","+  });","+","+  afterEach(async function () {","+    await configUtils.restore();","+  });","+","+  it('deletes expired sessions and verifications, in batches, and keeps the rest', async function () {","+    const [liveSession] = await insertSessions([at(HOUR)]);","+    await insertSessions([at(-HOUR), at(-2 * HOUR), at(-3 * HOUR), at(-4 * HOUR), at(-5 * HOUR)]);","+    const [liveVerification] = await insertVerifications([at(HOUR)]);","+    await insertVerifications([at(-HOUR), at(-2 * HOUR), at(-3 * HOUR)]);","+","+    const deleted = await clearExpiredAuthRows(db.knex, { batchSize: 2 });","+","+    assert.deepEqual(deleted, { user_sessions: 5, verifications: 3 });","+    assert.deepEqual(await ids('user_sessions'), [liveSession]);","+    assert.deepEqual(await ids('verifications'), [liveVerification]);","+  });","+","+  it('deletes nothing when nothing has expired', async function () {","+    await insertSessions([at(HOUR)]);","+    await insertVerifications([at(HOUR)]);","+","+    const deleted = await clearExpiredAuthRows(db.knex);","+","+    assert.deepEqual(deleted, { user_sessions: 0, verifications: 0 });","+    assert.equal((await ids('user_sessions')).length, 1);","+    assert.equal((await ids('verifications')).length, 1);","+  });","+","+  it('runs as the job handler only with auth:betterAuthDev', async function () {","+    await insertSessions([at(-HOUR)]);","+","+    configUtils.set('auth:betterAuthDev', false);","+    await clearExpired();","+    assert.equal((await ids('user_sessions')).length, 1);","+","+    configUtils.set('auth:betterAuthDev', true);","+    await clearExpired();","+    assert.equal((await ids('user_sessions')).length, 0);","+  });","+","+  it('clears expired rows when the job is dispatched', async function () {","+    configUtils.set('auth:betterAuthDev', true);","+    const [liveSession] = await insertSessions([at(HOUR)]);","+    await insertSessions([at(-HOUR)]);","+","+    // dispatch() resolves once the job is enqueued, not when it has run","+    await getJobsService().dispatch(new ClearExpiredAuthRowsJob());","+","+    assert.ok(","+      await waitFor(async () => (await ids('user_sessions')).length === 1),","+      'the dispatched job deletes the expired session',","+    );","+    assert.deepEqual(await ids('user_sessions'), [liveSession]);","+  });","+});"],"additions":133,"deletions":0,"truncated":false},{"path":"ghost/test/unit/boot/init-background-services.test.ts","lines":["@@ -18,6 +18,7 @@ function createBackgroundHarness(environment = 'production') {","   const tinybirdSync = { scheduleJob: sinon.stub().resolves() };","   const milestones = { initAndRun: sinon.stub() };","   const signingKeys = { extras: { scheduleCheckJob: sinon.stub().resolves() } };","+  const authCleanup = { scheduleClearExpiredJob: sinon.stub().resolves() };","   const jobsInstance = {};","   const initBackgroundServices = loadBootFunction(","     'initBackgroundServices',","@@ -36,6 +37,7 @@ function createBackgroundHarness(environment = 'production') {","         scheduleExpiredCompCleanupJob: async () => {},","       },","       './server/services/signing-keys': { default: signingKeys },","+      './server/auth/better-auth/cleanup': authCleanup,","       './server/services/jobs-service': { getInstance: () => jobsInstance },","       './server/services/activitypub': { init: activity },","       './server/services/tinybird-sync': tinybirdSync,","@@ -57,6 +59,7 @@ function createBackgroundHarness(environment = 'production') {","     tinybirdSync,","     milestones,","     signingKeys,","+    authCleanup,","     jobsInstance,","   };"," }","@@ -183,3 +186,25 @@ it('logs signing-key job registration failures and continues background startup'","   );","   sinon.assert.calledOnce(boot.milestones.initAndRun);"," });","+","+it('schedules the expired auth row cleanup on the shared jobs instance', async function () {","+  const boot = createBackgroundHarness();","+","+  await boot.init();","+","+  sinon.assert.calledOnceWithExactly(","+    boot.authCleanup.scheduleClearExpiredJob,","+    sinon.match.same(boot.jobsInstance),","+  );","+});","+","+it('logs a failed auth cleanup schedule and continues background startup', async function () {","+  const boot = createBackgroundHarness();","+  const failure = new Error('auth cleanup registration failed');","+  boot.authCleanup.scheduleClea