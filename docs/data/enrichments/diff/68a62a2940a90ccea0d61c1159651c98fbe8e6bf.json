{"id":"68a62a2940a90ccea0d61c1159651c98fbe8e6bf","axis":"silent","repo":"vllm-project/vllm","sha":"68a62a2940a90ccea0d61c1159651c98fbe8e6bf","parsed":{"files":[{"path":"docs/models/supported_models.md","lines":["@@ -803,6 +803,12 @@ Speech2Text models trained specifically for Automatic Speech Recognition."," !!! note","     `VoxtralForConditionalGeneration` requires `mistral-common[audio]` to be installed."," ","+Some models are supported only via the [Transformers modeling backend](#transformers). The purpose of the table below is to acknowledge models which we officially support in this way. The logs will say that the Transformers modeling backend is being used, and you will see no warning that this is fallback behaviour. This means that, if you have issues with any of the models listed below, please [make an issue](https://github.com/vllm-project/vllm/issues/new/choose) and we'll do our best to fix it!","+","+| Architecture | Models | Example HF Models | [LoRA](../features/lora.md) | [PP](../serving/parallelism_scaling.md) |","+| ------------ | ------ | ----------------- | -------------------- | ------------------------- |","+| `VibeVoiceAsrForConditionalGeneration` | VibeVoice-ASR | `microsoft/VibeVoice-ASR-HF` | ✅︎ | ✅︎ |","+"," #### Realtime Transcription"," "," Speech models that support streaming transcription via the"],"additions":6,"deletions":0,"truncated":false},{"path":"docs/serving/online_serving/speech_to_text.md","lines":["@@ -17,6 +17,17 @@ NOTE: beam search is currently supported in the transcriptions endpoint for enco"," Set the maximum audio file size (in MB) that VLLM will accept, via the"," `VLLM_MAX_AUDIO_CLIP_FILESIZE_MB` environment variable. Default is 25 MB."," ","+Models that transcribe long-form audio in a single pass, such as","+`microsoft/VibeVoice-ASR-HF`, take the whole recording at once, so `--max-model-len`","+must fit the audio and its transcript. Audio longer than 600 seconds also needs","+`VLLM_MAX_AUDIO_DECODE_DURATION_S` raised, and `VLLM_MAX_AUDIO_DECODE_BYTES` too past","+about 45 minutes at 24 kHz. Uncompressed files reach the 25 MB upload limit first.","+vLLM sizes these models for the longest audio those two decode limits and","+`--max-model-len` allow. `--limit-mm-per-prompt '{\"audio\": {\"length\": <samples>}}'`","+changes that size, but not the audio the API accepts.","+","+The Transformers modeling backend needs Transformers 5.23 or later for transcription.","+"," ### Uploading Audio Files"," "," The Transcriptions API supports uploading audio files in various formats including FLAC, MP3, MP4, MPEG, MPGA, M4A, OGG, WAV, and WEBM.","@@ -102,7 +113,8 @@ Currently “verbose_json” response format doesn’t support no_speech_prob."," "," For models with hotword support, `hotwords` takes a comma-separated list of terms"," (names, jargon) to bias recognition toward. Currently, this is supported by","-`FunAudioLLM/Fun-ASR-Nano-2512-vllm` and `OpenMOSS-Team/MOSS-Transcribe-Diarize`.","+`FunAudioLLM/Fun-ASR-Nano-2512-vllm`, `OpenMOSS-Team/MOSS-Transcribe-Diarize`, `microsoft/VibeVoice-ASR-HF` and `hf-audio/MOSS-Transcribe-Diarize-HF` (with `--model-impl transformers`).","+Speaker labels are passed through as generated by the model."," Keep the list short and relevant to the audio: long or unrelated lists can"," degrade accuracy."," "],"additions":13,"deletions":1,"truncated":false},{"path":"tests/entrypoints/speech_to_text/transcription/test_transcription_inter_chunk_spacing.py","lines":["@@ -149,7 +149,7 @@ def get_speech_to_text_config(","         )"," ","     @classmethod","-    def post_process_output(cls, text: str) -> str:","+    def post_process_output(cls, text: str, model_config) -> str:","         return text"," ","     @classmethod"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/entrypoints/speech_to_text/transcription/test_transcription_validation.py","lines":["@@ -8,10 +8,13 @@"," import numpy as np"," import pytest"," import soundfile as sf","+import transformers"," from fastapi import UploadFile","+from packaging.version import Version"," from transformers import WhisperConfig"," "," from tests.utils import ROCM_EXTRA_ARGS, RemoteOpenAIServer","+from vllm.assets.audio import AudioAsset"," from vllm.config import ModelConfig, SpeechToTextConfig"," from vllm.entrypoints.speech_to_text.transcription.protocol import TranscriptionRequest"," from vllm.multimodal.audio import AudioResampler","@@ -141,6 +144,89 @@ async def transcribe_and_check(","     return out_text"," "," ","+@pytest.mark.asyncio","+@pytest.mark.skipif(","+    Version(transformers.__version__) < Version(\"5.23.0.dev0\"),","+    reason=\"Requires `tokenize` on `apply_transcription_request`\",","+)","+async def test_transformers_backend_audio(mary_had_lamb):","+    \"\"\"Serve transcription and diarization for a Transformers backend model.\"\"\"","+    model_name = \"microsoft/VibeVoice-ASR-HF\"","+    server_args = [","+        \"--enforce-eager\",","+        \"--max-model-len\",","+        \"2048\",","+        \"--max-num-batched-tokens\",","+        \"2048\",","+        \"--gpu-memory-utilization\",","+        \"0.85\",","+        *ROCM_EXTRA_ARGS,","+    ]","+    with RemoteOpenAIServer(model_name, server_args) as remote_server:","+        client = remote_server.get_async_client()","+        await transcribe_and_check(","+            client,","+            model_name,","+            mary_had_lamb,","+            language=\"en\",","+            expected_text=\"Mary had a little lamb\",","+            expected_seconds=16,","+        )","+","+        mary_had_lamb.seek(0)","+        response = await client.audio.transcriptions.create(","+            model=model_name, file=mary_had_lamb, response_format=\"diarized_json\"","+        )","+        assert \"Mary had a little lamb\" in response.text","+        assert response.segments","+        assert all(segment.end >= segment.start for segment in response.segments)","+","+","+@pytest.mark.asyncio","+@pytest.mark.skipif(","+    Version(transformers.__version__) < Version(\"5.23.0.dev0\"),","+    reason=\"Requires `tokenize` on `apply_transcription_request`\",","+)","+async def test_transformers_backend_diarization_spans_audio_windows():","+    \"\"\"Speaker labels hold past 30 s, which is where chunking the audio would start","+    a new transcript. `winning_call` follows `mary_had_lamb` and is one speaker.\"\"\"","+    model_name = \"hf-audio/MOSS-Transcribe-Diarize-HF\"","+    target_sr = 16000","+    resampler = AudioResampler(target_sr=target_sr)","+    assets = [AudioAsset(\"mary_had_lamb\"), AudioAsset(\"winning_call\")]","+    audios = [","+        resampler.resample(audio, orig_sr=sr)","+        for audio, sr in (asset.audio_and_sample_rate for asset in assets)","+    ]","+    file = BytesIO()","+    sf.write(file, np.concatenate(audios), target_sr, format=\"WAV\")","+    file.seek(0)","+    file.name = \"conversation.wav\"","+    server_args = [","+        \"--model-impl\",","+        \"transformers\",","+        \"--enforce-eager\",","+        \"--max-model-len\",","+        \"4096\",","+        \"--gpu-memory-utilization\",","+        \"0.85\",","+        *ROCM_EXTRA_ARGS,","+    ]","+","+    with RemoteOpenAIServer(model_name, server_args) as remote_server:","+        client = remote_server.get_async_client()","+        response = await client.audio.transcriptions.create(","+            model=model_name, file=file, response_format=\"diarized_json\"","+        )","+","+    first_audio_s = len(audios[0]) / target_sr","+    first = [s for s in response.segments if s.start < first_audio_s]","+    second = [s for s in response.segments if s.start >= first_audio_s]","+    assert second[-1].end > 30","+    assert len({s.speaker for s in second}) == 1","+    assert {s.speaker for s in first}.isdisjoint(s.speaker for s in second)","+","+"," @pytest.mark.asyncio"," @pytest.mark.parametrize(","     \"model_name\","],"additions":86,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/generation/test_transformers_audio.py","lines":["@@ -133,3 +133,34 @@ def test_transformers_audio_generation(","         name_0=\"hf\",","         name_1=\"vllm\",","     )","+","+","+def test_transformers_audio_mixed_lengths(vllm_runner: type[VllmRunner]):","+    \"\"\"Audios of different lengths encoded in one batch are split into items, whose","+    ragged fields must each stay a batch of one. One prompt holds both audios, as","+    separate requests may not reach the encoder in the same step.\"\"\"","+    model_id = \"microsoft/VibeVoice-ASR-HF\"","+    settings = AUDIO_MODEL_SETTINGS[model_id]","+    target_sr = settings[\"sampling_rate\"]","+    resampler = AudioResampler(target_sr=target_sr)","+","+    assets = [AudioAsset(\"mary_had_lamb\"), AudioAsset(\"winning_call\")]","+    audios = [","+        (resampler.resample(audio, orig_sr=sr), target_sr)","+        for audio, sr in (asset.audio_and_sample_rate for asset in assets)","+    ]","+    placeholder = \"<|object_ref_start|><|box_start|><|object_ref_end|>\"","+    prompt = settings[\"prompt\"].replace(placeholder, placeholder * 2)","+","+    with vllm_runner(","+        model_id,","+        model_impl=\"transformers\",","+        dtype=\"bfloat16\",","+        max_model_len=2048,","+        enforce_eager=True,","+        limit_mm_per_prompt={\"audio\": 2},","+        **settings[\"vllm_runner_kwargs\"],","+    ) as vllm_model:","+        [(_, text)] = vllm_model.generate_greedy([prompt], 256, audios=[audios])","+","+    assert \"lamb\" in text"],"additions":31,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_ming_v3_asr.py","lines":["@@ -215,6 +215,6 @@ def test_streaming_envelope_matches_final_text(chunks, expected):","     deltas.append(processor.process_delta(\"\", True))","     assert \"\".join(deltas) == expected","     assert (","-        MingV3ASRForConditionalGeneration.post_process_output(\"\".join(chunks))","+        MingV3ASRForConditionalGeneration.post_process_output(\"\".join(chunks), None)","         == expected","     )"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/models/multimodal/processing/test_moss_transcribe_diarize.py","lines":["@@ -53,7 +53,7 @@ def test_generation_prompt_appends_hotwords(request_prompt, hotwords, expected):"," "," def test_parse_diarized_transcript_preserves_moss_segments():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0.48][S01]Welcome[1.66][12.26][S02]Ready[13.81]\"","+        \"[0.48][S01]Welcome[1.66][12.26][S02]Ready[13.81]\", None","     )"," ","     assert [","@@ -67,7 +67,7 @@ def test_parse_diarized_transcript_preserves_moss_segments():"," "," def test_parse_diarized_transcript_preserves_overlapping_segments():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0][S01]First speaker[2][1][S02]Second speaker[3]\"","+        \"[0][S01]First speaker[2][1][S02]Second speaker[3]\", None","     )"," ","     assert [","@@ -81,7 +81,7 @@ def test_parse_diarized_transcript_preserves_overlapping_segments():"," "," def test_parse_diarized_transcript_preserves_numeric_text_markers():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0][S01]The [2024] report is ready.[4]\"","+        \"[0][S01]The [2024] report is ready.[4]\", None","     )"," ","     assert [segment.text for segment in segments] == [\"The [2024] report is ready.\"]","@@ -89,7 +89,7 @@ def test_parse_diarized_transcript_preserves_numeric_text_markers():"," "," def test_parse_diarized_transcript_ignores_whitespace_between_segments():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0][S01]Hello[1]\\n [2][S02]Hi[3]\"","+        \"[0][S01]Hello[1]\\n [2][S02]Hi[3]\", None","     )"," ","     assert [(segment.start, segment.end, segment.text) for segment in segments] == [","@@ -100,7 +100,7 @@ def test_parse_diarized_transcript_ignores_whitespace_between_segments():"," "," def test_parse_diarized_transcript_ignores_noise_before_a_segment():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"noise [bad][0.1][S01]Hello[0.9]\"","+        \"noise [bad][0.1][S01]Hello[0.9]\", None","     )"," ","     assert [(segment.start, segment.end, segment.text) for segment in segments] == [","@@ -110,7 +110,7 @@ def test_parse_diarized_transcript_ignores_noise_before_a_segment():"," "," def test_parse_diarized_transcript_preserves_timestamps_before_the_end():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[2][S01]The earlier timestamp is [1] not the end[3]\"","+        \"[2][S01]The earlier timestamp is [1] not the end[3]\", None","     )"," ","     assert [segment.text for segment in segments] == [","@@ -120,7 +120,7 @@ def test_parse_diarized_transcript_preserves_timestamps_before_the_end():"," "," def test_parse_diarized_transcript_skips_empty_segments():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0][S01][1][2][S02]Complete[3]\"","+        \"[0][S01][1][2][S02]Complete[3]\", None","     )"," ","     assert [(segment.speaker, segment.text) for segment in segments] == [","@@ -130,7 +130,7 @@ def test_parse_diarized_transcript_skips_empty_segments():"," "," def test_parse_diarized_transcript_fails_closed_for_incomplete_output():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0][S01]Complete[1][2][S02]Incomplete\"","+        \"[0][S01]Complete[1][2][S02]Incomplete\", None","     )"," ","     assert segments == []","@@ -138,7 +138,7 @@ def test_parse_diarized_transcript_fails_closed_for_incomplete_output():"," "," def test_parse_diarized_transcript_fails_closed_for_trailing_text():","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        \"[0][S01]Complete[1] trailing text\"","+        \"[0][S01]Complete[1] trailing text\", None","     )"," ","     assert segments == []","@@ -147,7 +147,7 @@ def test_parse_diarized_transcript_fails_closed_for_trailing_text():"," def test_parse_diarized_transcript_preserves_overlong_timestamp_markers():","     marker = f\"[{'1' * 33}]\"","     segments = MossTranscribeDiarizeForConditionalGeneration.parse_diarized_transcript(","-        f\"[0][S01]Value {marker}[1]\"","+        f\"[0][S01]Value {marker}[1]\", None","     )"," ","     assert [segment.text for segment in segments] == [f\"Value {marker}\"]"],"additions":10,"deletions":10,"truncated":false},{"path":"tests/models/multimodal/processing/test_transformers_audio.py","lines":["@@ -2,12 +2,19 @@"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," import numpy as np"," import pytest","+import transformers","+from packaging.version import Version"," ","+import vllm.envs as envs"," from vllm.config import ModelConfig","+from vllm.config.speech_to_text import SpeechToTextParams","+from vllm.model_executor.model_loader import get_model_cls","+from vllm.model_executor.models.interfaces import supports_transcription"," from vllm.model_executor.models.transformers.multimodal import (","     MultiModalProcessor as TransformersMultiModalProcessor,"," )"," from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.transformers_utils.processor import cached_processor_from_config"," "," AUDIO_MODEL_SETTINGS = {","     \"ibm-granite/granite-speech-3.3-2b\": {","@@ -168,3 +175,190 @@ def test_unclaimed_fields_warn_rather_than_raise():"," ","     assert owned[\"audio\"] == [\"input_features\"]","     assert owned[\"image\"] == []","+","+","+@pytest.mark.parametrize(","+    (\"model_id\", \"long_form\"),","+    [","+        (\"zai-org/GLM-ASR-Nano-2512\", False),","+        (\"ibm-granite/granite-speech-3.3-2b\", False),","+        (\"Qwen/Qwen3-ASR-1.7B-hf\", True),","+        (\"hf-audio/MOSS-Transcribe-Diarize-HF\", True),","+        (\"microsoft/VibeVoice-ASR-HF\", True),","+    ],","+)","+def test_only_long_form_audio_fills_the_context(model_id, long_form):","+    \"\"\"Audio models keep their usual budget unless they take whole recordings, as","+    sizing them all by the context stops small GPUs from starting.\"\"\"","+    seq_len = 4096","+    mm_processor = MULTIMODAL_REGISTRY.create_processor(","+        ModelConfig(model=model_id, model_impl=\"transformers\")","+    )","+    info = mm_processor.info","+","+    max_tokens_per_item = info.get_mm_max_tokens_per_item(seq_len, {\"audio\": 1})","+    assert max_tokens_per_item is not None","+    max_tokens = max_tokens_per_item[\"audio\"]","+    result = mm_processor(","+        prompt=mm_processor.dummy_inputs.get_dummy_text({\"audio\": 1}),","+        mm_items=info.parse_mm_data(","+            mm_processor.dummy_inputs.get_dummy_mm_data(seq_len, {\"audio\": 1}, {})","+        ),","+        hf_processor_mm_kwargs={},","+    )","+    num_tokens = result[\"mm_placeholders\"][\"audio\"][0].length","+","+    if long_form:","+        assert max_tokens == seq_len","+        assert num_tokens == pytest.approx(seq_len, rel=0.02)","+    else:","+        assert max_tokens != seq_len","+        assert num_tokens <= max_tokens","+","+","+def test_audio_windows_stay_with_their_audio():","+    \"\"\"Processors can split audios into windows, which each item needs all of.\"\"\"","+    mm_processor = MULTIMODAL_REGISTRY.create_processor(","+        ModelConfig(","+            model=\"hf-audio/MOSS-Transcribe-Diarize-HF\", model_impl=\"transformers\"","+        )","+    )","+    audios = [np.zeros(s * 16000, dtype=np.float32) for s in (45, 70)]","+","+    result = mm_processor(","+        prompt=mm_processor.dummy_inputs.get_dummy_text({\"audio\": 2}),","+        mm_items=mm_processor.info.parse_mm_data({\"audio\": audios}),","+        hf_processor_mm_kwargs={},","+    )","+","+    items = result[\"mm_kwargs\"].get(\"audio\", [])","+    assert [len(item[\"input_features\"].data) for item in items if item] == [2, 3]","+","+","+@pytest.mark.parametrize(","+    (\"limit\", \"expected_tokens\"),","+    [({\"count\": 1}, 4500), ({\"count\": 1, \"length\": 24000 * 60}, 450)],","+)","+def test_long_form_audio_limit(limit, expected_tokens):","+    \"\"\"Long-form audio stops at the decode limit unless told otherwise.\"\"\"","+    info = MULTIMODAL_REGISTRY.create_processor(","+        ModelConfig(","+            model=\"microsoft/VibeVoice-ASR-HF\",","+            model_impl=\"transformers\",","+            limit_mm_per_prompt={\"audio\": limit},","+        )","+    ).info","+","+    max_tokens = info.get_mm_max_tokens_per_item(10**6, {\"audio\": 1})","+    assert max_tokens == {\"audio\": expected_tokens}","+","+","+@pytest.mark.parametrize(","+    (\"max_duration_s\", \"max_bytes\", \"expected_tokens\"),","+    [(0, 0, 10**6), (3600, 4 * 24000 * 60, 450)],","+)","+def test_long_form_audio_follows_the_decode_limits(","+    monkeypatch, max_duration_s, max_bytes, expected_tokens","+):","+    \"\"\"Audio past either decode limit is refused, and 0 disables a limit.\"\"\"","+    monkeypatch.setattr(envs, \"VLLM_MAX_AUDIO_DECODE_DURATION_S\", max_duration_s)","+    monkeypatch.setattr(envs, \"VLLM_MAX_AUDIO_DECODE_BYTES\", max_bytes)","+    info = MULTIMODAL_REGISTRY.create_processor(","+        ModelConfig(model=\"microsoft/VibeVoice-ASR-HF\", model_impl=\"transformers\")","+    ).info","+","+    max_tokens = info.get_mm_max_tokens_per_item(10**6, {\"audio\": 1})","+    assert max_tokens == {\"audio\": expected_tokens}","+","+","+@pytest.mark.parametrize(","+    (\"model_id\", \"transcribes\"),","+    [","+        (\"microsoft/VibeVoice-ASR-HF\", True),","+        (\"zai-org/GLM-ASR-Nano-2512\", True),","+        (\"Qwen/Qwen3-ASR-1.7B-hf\", True),","+        (\"ibm-granite/granite-speech-3.3-2b\", False),","+    ],","+)","+def test_transcription_needs_a_transcription_request(model_id, transcribes):","+    model_config = ModelConfig(model=model_id, model_impl=\"transformers\")","+","+    assert supports_transcription(get_model_cls(model_config)) == transcribes","+","+","+def test_transcription_output_strips_a_generated_prefix():","+    model_config = ModelConfig(","+        model=\"nvidia/audio-flamingo-3-hf\", model_impl=\"transformers\"","+    )","+    model_cls = get_model_cls(model_config)","+    text = \"The spoken content of the audio is 'Hello there.'.\"","+","+    assert model_cls.post_process_output(text, model_config) == \"Hello there.\"","+","+","+VIBEVOICE_OUTPUT = (","+    'assistant\\n[{\"Start\":0.0,\"End\":1.5,\"Speaker\":0,\"Content\":\"Hello there.\"},'","+    '{\"Start\":1.62,\"End\":3,\"Speaker\":1,\"Content\":\"Hi!\"},'","+    '{\"Start\":3,\"End\":4,\"Content\":\" \"}]\\n'","+)","+","+","+@pytest.fixture","+def vibevoice():","+    if Version(transformers.__version__) < Version(\"5.23.0.dev0\"):","+        pytest.skip(\"Requires `tokenize` on `apply_transcription_request`\")","+    model_config = ModelConfig(","+        model=\"microsoft/VibeVoice-ASR-HF\", model_impl=\"transformers\"","+    )","+    return get_model_cls(model_config), model_config","+","+","+def test_transcription_config_keeps_uncapped_audio_whole(vibevoice):","+    model_cls, model_config = vibevoice","+","+    stt_config = model_cls.get_speech_to_text_config(model_config, \"transcribe\")","+","+    assert stt_config.max_audio_clip_s is None","+","+","+@pytest.mark.parametrize(\"context\", [\"\", \"Speakers: Ada\"])","+def test_transcription_prompt_matches_hf_processor(vibevoice, context):","+    \"\"\"VLLM never sees the text the HF processor fills in, so the prompt it builds","+    has to tokenize to what the processor would give.\"\"\"","+    model_cls, model_config = vibevoice","+    audio = np.zeros(36000, dtype=np.float32)","+    stt_config = model_cls.get_speech_to_text_config(model_config, \"transcribe\")","+","+    prompt = model_cls.get_generation_prompt(","+        SpeechToTextParams(","+            audio=audio,","+            stt_config=stt_config,","+            model_config=model_config,","+            request_prompt=context,","+        )","+    )","+","+    processor = cached_processor_from_config(model_config)","+    hf_inputs = processor.apply_transcription_request(audio, prompt=context or None)","+    ours = processor.tokenizer.encode(prompt[\"prompt\"], add_special_tokens=False)","+    audio_token_id = processor.audio_token_id","+    hf_ids = hf_inputs[\"input_ids\"][0].tolist()","+    assert ours == [","+        token","+        for i, token in enumerate(hf_ids)","+        if token != audio_token_id or hf_ids[i - 1] != audio_token_id","+    ]","+","+","+def test_transcription_output_parsing(vibevoice):","+    model_cls, model_config = vibevoice","+","+    text = model_cls.post_process_output(VIBEVOICE_OUTPUT, model_config)","+    segments = model_cls.parse_diarized_transcript(VIBEVOICE_OUTPUT, model_config)","+","+    assert text == \"Hello there. Hi!\"","+    assert [(s.start, s.end, s.speaker, s.text) for s in segments] == [","+        (0.0, 1.5, \"0\", \"Hello there.\"),","+        (1.62, 3.0, \"1\", \"Hi!\"),","+    ]","+    assert model_cls.parse_diarized_transcript(\"Hello.\", model_config) == []"],"additions":194,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -1935,6 +1935,9 @@ def check_available_online(","         \"vllm-project/Ilama-3.2-1B\", trust_remote_code=True","     ),","     \"TransformersMultiModalForCausalLM\": _HfExamplesInfo(\"BAAI/Emu3-Chat-hf\"),","+    \"TransformersMultiModalForTranscription\": _HfExamplesInfo(","+        \"microsoft/VibeVoice-ASR-HF\"","+    ),","     \"TransformersMoEForCausalLM\": _HfExamplesInfo(\"allenai/OLMoE-1B-7B-0924\"),","     \"TransformersForMTP\": _HfExamplesInfo(","         \"zai-org/GLM-4.5\","],"additions":3,"deletions":0,"truncated":false},{"path":"vllm/config/m