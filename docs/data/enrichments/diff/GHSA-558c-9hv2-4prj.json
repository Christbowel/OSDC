n %s\", folder)","+                folder.rmdir()","+        try:","+            folder.mkdir()","+        except FileExistsError:","+            created: Final = folder.lstat()","+            if not S_ISDIR(created.st_mode) or (","+                os.name == \"nt\" and created.st_reparse_tag == IO_REPARSE_TAG_MOUNT_POINT","+            ):","+                msg: Final = f\"environment directory is not a real directory: {folder}\"","+                raise NotADirectoryError(msg) from None","+","+","+def write_file(path: Path, data: bytes) -> None:","+    if path.is_symlink() or path.exists():","+        path.unlink()","+    # Exclusive creation rejects links introduced after the old entry was removed.","+    with path.open(\"xb\") as stream:","+        stream.write(data)","+","+"," def ensure_safe_to_do(src: Path, dest: Path) -> None:","     if src == dest:","         msg = f\"source and destination is the same {src}\"","@@ -102,6 +143,8 @@ def __str__(self) -> str:","     \"copy\",","     \"copytree\",","     \"ensure_dir\",","+    \"ensure_within\",","     \"safe_delete\",","     \"symlink\",","+    \"write_file\","," ]"],"additions":44,"deletions":1,"truncated":false},{"path":"tests/unit/create/test_creator.py","lines":["@@ -31,7 +31,7 @@"," from virtualenv.create.pyenv_cfg import PyEnvCfg"," from virtualenv.create.via_global_ref import api"," from virtualenv.create.via_global_ref.builtin.cpython.common import is_mac_os_framework, is_macos_brew","-from virtualenv.info import IS_PYPY, IS_WIN, fs_is_case_sensitive, fs_supports_symlink","+from virtualenv.info import IS_GRAALPY, IS_PYPY, IS_WIN, fs_is_case_sensitive, fs_supports_symlink"," from virtualenv.run import cli_run, session_via_cli"," from virtualenv.run.plugin.creators import CreatorSelector"," from virtualenv.util.error import ProcessCallFailedError","@@ -118,6 +118,94 @@ def test_clear_direct_destination(tmp_path: Path, parent_link: bool) -> None:","     assert (session.creator.dest, marker.exists(), (tar