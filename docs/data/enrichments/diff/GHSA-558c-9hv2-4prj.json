{"id":"GHSA-558c-9hv2-4prj","axis":"advisories","repo":"pypa/virtualenv","sha":"d25f28699eefb1fc34a251e5adf2b5de844c36cd","parsed":{"files":[{"path":"docs/changelog/3431.bugfix.rst","lines":["@@ -0,0 +1,5 @@","+Replace existing symbolic and hard links when writing environment configuration, activation scripts, import hooks, and","+seed launchers. Create generated text files exclusively so a replacement link cannot redirect the final file open.","+Before recreating an environment with the stdlib venv creator, replace executable-directory symlinks and Windows","+junctions with real directories. Remove symbolic and hard links inside that directory before creating interpreter files,","+including when switching from symlinks to copies."],"additions":5,"deletions":0,"truncated":false},{"path":"src/virtualenv/activation/via_template.py","lines":["@@ -5,7 +5,9 @@"," import shlex"," import sys"," from abc import ABC, abstractmethod","-from typing import TYPE_CHECKING","+from typing import TYPE_CHECKING, Final","+","+from virtualenv.util.path import write_file"," "," from .activator import Activator"," ","@@ -63,18 +65,13 @@ def replacements(self, creator: Creator, dest_folder: Path) -> dict[str, str]:","     def _generate(","         self, replacements: dict[str, str], templates: Iterable[str], to_folder: Path, creator: Creator","     ) -> list[Path]:","-        generated = []","+        generated: Final[list[Path]] = []","         for template in templates:","-            text = self.instantiate_template(replacements, template, creator)","-            dest = to_folder / self.as_name(template)","-            # remove the file if it already exists - this prevents permission","-            # errors when the dest is not writable","-            if dest.exists():","-                dest.unlink()","-            # Powershell assumes Windows 1252 encoding when reading files without BOM","-            encoding = \"utf-8-sig\" if str(template).endswith(\".ps1\") else \"utf-8\"","-    