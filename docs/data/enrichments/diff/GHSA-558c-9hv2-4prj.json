port the .hgignore file inside a subdirectory directly, but only if included via the","         # subinclude directive from root, at which point on might as well ignore the directory itself, see","         # https://www.selenic.com/mercurial/hgignore.5.html for more details"],"additions":3,"deletions":3,"truncated":false},{"path":"src/virtualenv/create/pyenv_cfg.py","lines":["@@ -5,6 +5,7 @@"," from collections import OrderedDict"," from typing import TYPE_CHECKING, Final"," ","+from virtualenv.util.path import write_file"," from virtualenv.util.text import collapse_line_boundaries"," "," if TYPE_CHECKING:","@@ -67,7 +68,7 @@ def write(self) -> None:","             LOGGER.debug(\"\\t%r\", line)","             text += line","             text += \"\\n\"","-        self.path.write_bytes(text.encode(\"utf-8\"))","+        write_file(self.path, text.encode(\"utf-8\"))"," ","     def refresh(self) -> OrderedDict[str, str]:","         self.content = self._read_values(self.path)"],"additions":2,"deletions":1,"truncated":false},{"path":"src/virtualenv/create/via_global_ref/api.py","lines":["@@ -7,6 +7,7 @@"," "," from virtualenv.create.creator import Creator, CreatorMeta"," from virtualenv.info import fs_supports_symlink","+from virtualenv.util.path import write_file"," "," if TYPE_CHECKING:","     from argparse import ArgumentParser","@@ -120,10 +121,10 @@ def install_patch(self) -> None:","         if text:","             pth = self.purelib / \"_virtualenv.pth\"","             LOGGER.debug(\"create virtualenv import hook file %s\", pth)","-            pth.write_text(\"import _virtualenv\", encoding=\"utf-8\")","+            write_file(pth, b\"import _virtualenv\")","             dest_path = self.purelib / \"_virtualenv.py\"","             LOGGER.debug(\"create %s\", dest_path)","-            dest_path.write_text(text, encoding=\"utf-8\")","+            write_file(dest_path, text.encode(\"utf-8\"))"," ","     def env_patch_text(self) -> str:","         \"\"\"Patch the distutils package to not be derailed by its configuration files.\"\"\""],"additions":3,"deletions":2,"truncated":false},{"path":"src/virtualenv/create/via_global_ref/venv.py","lines":["@@ -8,7 +8,7 @@"," "," from virtualenv.create.via_global_ref.store import handle_store_python"," from virtualenv.util.error import ProcessCallFailedError","-from virtualenv.util.path import ensure_dir","+from virtualenv.util.path import ensure_dir, ensure_within"," from virtualenv.util.subprocess import run_cmd"," from virtualenv.util.text import collapse_line_boundaries"," ","@@ -49,6 +49,12 @@ def can_create(cls, interpreter: PythonInfo) -> ViaGlobalRefMeta | None:","         return None"," ","     def create(self) -> None:","+        # stdlib venv writes interpreter files, configuration and activation scripts in place, so a planted symlink or","+        # hard link would receive them outside the environment","+        ensure_within(self.dest, self.bin_dir)","+        for path in (self.dest / \"pyvenv.cfg\", self.dest / \".gitignore\", *self.bin_dir.iterdir()):","+            if path.is_symlink() or (path.is_file() and path.stat().st_nlink > 1):","+                path.unlink()","         if self.can_be_inline:","             self.create_inline()","         else:"],"additions":7,"deletions":1,"truncated":false},{"path":"src/virtualenv/seed/embed/via_app_data/pip_install/base.py","lines":["@@ -247,6 +247,10 @@ def _write_script(","         self, names: set[str], shebang: bytes, script_bytes: bytes, filenames: list[str], ext: str","     ) -> None:","         names.add(f\"{self._name}{self.version_info[0]}.{self.version_info[1]}\")","+        for name in names:","+            path: Final = Path(self.target_dir) / (f\"{name}.exe\" if os.name == \"nt\" else name)","+            if path.is_symlink():","+                path.unlink()","         super()._write_script(names, shebang, script_bytes, filenames, ext)"," "," "],"additions":4,"deletions":0,"truncated":false},{"path":"src/virtualenv/ut