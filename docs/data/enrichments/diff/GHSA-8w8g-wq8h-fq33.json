f.repo.path, \"trigger\")","+        os.symlink(os.path.join(\"..\", \"outside\"), trigger)","+        self.assertTrue(os.path.islink(trigger))","+","+        porcelain.checkout(self.repo, file_sha, paths=[b\"trigger\"])","+","+        # The file outside the work tree must be untouched, and the work tree","+        # path must now be a regular file holding the payload.","+        with open(outside) as f:","+            self.assertEqual(\"original\\n\", f.read())","+        self.assertFalse(os.path.islink(trigger))","+        with open(trigger) as f:","+            self.assertEqual(\"payload\\n\", f.read())","+","     def test_checkout_to_head(self) -> None:","         new_sha = self._commit_something_wrong()"," ",""],"additions":38,"deletions":0,"truncated":false}],"additions":52,"deletions":8,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-03T13:26:51.297948+00:00"}