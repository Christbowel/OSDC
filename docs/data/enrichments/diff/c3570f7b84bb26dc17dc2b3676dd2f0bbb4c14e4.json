{"id":"c3570f7b84bb26dc17dc2b3676dd2f0bbb4c14e4","axis":"silent","repo":"akkadotnet/akka.net","sha":"c3570f7b84bb26dc17dc2b3676dd2f0bbb4c14e4","parsed":{"files":[{"path":"docs/articles/clustering/split-brain-resolver.md","lines":["@@ -317,6 +317,22 @@ akka.cluster.split-brain-resolver {"," > [!WARNING]"," > It is recommended to keep `down-all-when-unstable` enabled and not to set it to be longer than `stable-after` because that can cause a delayed SBR decision on partition sides that should be downed, e.g. in the case of a clean network partition followed by continued instability on the side that should be downed. This can result in members being removed in one side but kept on running on the other side."," ","+### Down Self When Quarantined by a Member","+","+When the rest of the cluster downs and removes a node, the other members quarantine it, and they won't talk to that incarnation again. Usually the removed node finds out through gossip and shuts itself down. But a node that was frozen or paused while this happened (for example, a long garbage collection pause or a paused VM) misses that gossip. When it wakes up it sees every other member as unreachable, and with `lease-majority` it may even find the lease free, take it, and down everyone else in its own view. Left alone, it keeps running as a cluster of one, and new nodes can join it.","+","+To prevent that, a node downs itself as soon as a current cluster member quarantines it. It does this right away, without waiting for `stable-after`, and it works with every strategy. A node only learns it was quarantined when it tries to talk to the member that quarantined it, which a woken node does within seconds.","+","+Quarantines from addresses that are not cluster members are ignored, and so are quarantines from members that are leaving, exiting, or already down, so one node that is shutting down can't take others down with it.","+","+This is on by default. To turn it off:","+","+```hocon","+akka.cluster.split-brain-resolver {","+    down-self-when-quarantined-by-member = off","+}","+```","+"," ### How Split Brain Resolver Works"," "," * The SBR actor subscribes itself to all cluster events from the event bus during actor `PreStart`."],"additions":16,"deletions":0,"truncated":false},{"path":"src/core/Akka.API.Tests/verify/CoreAPISpec.ApproveCluster.DotNet.verified.txt","lines":["@@ -427,6 +427,7 @@ namespace Akka.Cluster.SBR","         public static readonly System.Collections.Immutable.ImmutableHashSet<string> AllStrategyNames;","         public SplitBrainResolverSettings(Akka.Configuration.Config config) { }","         public System.TimeSpan DownAllWhenUnstable { get; }","+        public bool DownSelfWhenQuarantinedByMember { get; }","         public System.TimeSpan DowningStableAfter { get; }","         public string DowningStrategy { get; }","         public string KeepMajorityRole { get; }"],"additions":1,"deletions":0,"truncated":false},{"path":"src/core/Akka.API.Tests/verify/CoreAPISpec.ApproveCluster.Net.verified.txt","lines":["@@ -427,6 +427,7 @@ namespace Akka.Cluster.SBR","         public static readonly System.Collections.Immutable.ImmutableHashSet<string> AllStrategyNames;","         public SplitBrainResolverSettings(Akka.Configuration.Config config) { }","         public System.TimeSpan DownAllWhenUnstable { get; }","+        public bool DownSelfWhenQuarantinedByMember { get; }","         public System.TimeSpan DowningStableAfter { get; }","         public string DowningStrategy { get; }","         public string KeepMajorityRole { get; }"],"additions":1,"deletions":0,"truncated":false},{"path":"src/core/Akka.API.Tests/verify/CoreAPISpec.ApproveRemote.DotNet.verified.txt","lines":["@@ -395,8 +395,10 @@ namespace Akka.Remote","     public sealed class ThisActorSystemQuarantinedEvent : Akka.Remote.RemotingLifecycleEvent","     {","         public ThisActorSystemQuarantinedEvent(Akka.Actor.Address localAddress, Akka.Actor.Address remoteAddress) { }","+        public ThisActorSystemQuarantinedEvent(Akka.Actor.Address localAddress, Akka.Actor.Address remoteAddress, long? remoteUid) { }","         public Akka.Actor.Address LocalAddress { get; }","         public Akka.Actor.Address RemoteAddress { get; }","+        public long? RemoteUid { get; }","         public override Akka.Event.LogLevel LogLevel() { }","         public override string ToString() { }","     }"],"additions":2,"deletions":0,"truncated":false},{"path":"src/core/Akka.API.Tests/verify/CoreAPISpec.ApproveRemote.Net.verified.txt","lines":["@@ -395,8 +395,10 @@ namespace Akka.Remote","     public sealed class ThisActorSystemQuarantinedEvent : Akka.Remote.RemotingLifecycleEvent","     {","         public ThisActorSystemQuarantinedEvent(Akka.Actor.Address localAddress, Akka.Actor.Address remoteAddress) { }","+        public ThisActorSystemQuarantinedEvent(Akka.Actor.Address localAddress, Akka.Actor.Address remoteAddress, long? remoteUid) { }","         public Akka.Actor.Address LocalAddress { get; }","         public Akka.Actor.Address RemoteAddress { get; }","+        public long? RemoteUid { get; }","         public override Akka.Event.LogLevel LogLevel() { }","         public override string ToString() { }","     }"],"additions":2,"deletions":0,"truncated":false},{"path":"src/core/Akka.Cluster.Tests.MultiNode/SBR/DownSelfQuarantinedByRemoteSpec.cs","lines":["@@ -0,0 +1,179 @@","+//-----------------------------------------------------------------------","+// <copyright file=\"DownSelfQuarantinedByRemoteSpec.cs\" company=\"Akka.NET Project\">","+//     Copyright (C) 2009-2022 Lightbend Inc. <http://www.lightbend.com>","+//     Copyright (C) 2013-2025 .NET Foundation <https://github.com/akkadotnet/akka.net>","+// </copyright>","+//-----------------------------------------------------------------------","+","+using System;","+using System.Linq;","+using System.Threading.Tasks;","+using Akka.Actor;","+using Akka.Cluster.TestKit;","+using Akka.Configuration;","+using Akka.MultiNode.TestAdapter;","+using Akka.Remote;","+using Akka.Remote.TestKit;","+using FluentAssertions;","+","+namespace Akka.Cluster.Tests.MultiNode.SBR","+{","+    public class DownSelfQuarantinedByRemoteSpecConfig : MultiNodeConfig","+    {","+        public RoleName First { get; }","+        public RoleName Second { get; }","+        public RoleName Third { get; }","+        public RoleName Fourth { get; }","+","+        public DownSelfQuarantinedByRemoteSpecConfig()","+        {","+            First = Role(\"first\");","+            Second = Role(\"second\");","+            Third = Role(\"third\");","+            Fourth = Role(\"fourth\");","+","+            // stable-after is far longer than the time we allow for the quarantined node to go away,","+            // so the normal SBR decision can't be what removes it","+            CommonConfig = ConfigurationFactory.ParseString(@\"","+                akka {","+                    loglevel = INFO","+                    cluster {","+                        downing-provider-class = \"\"Akka.Cluster.SBR.SplitBrainResolverProvider\"\"","+                        split-brain-resolver.active-strategy = keep-majority","+                        split-brain-resolver.stable-after = 30s","+                    }","+                    actor.provider = cluster","+                    test.filter-leeway = 10s","+                }\")","+                .WithFallback(MultiNodeLoggingConfig.LoggingConfig)","+                .WithFallback(DebugConfig(false))","+                .WithFallback(MultiNodeClusterSpec.ClusterConfig());","+        }","+    }","+","+    /// <summary>","+    /// Port of Pekko's <c>DowningWhenOtherHasQuarantinedThisActorSystemSpec</c>, see #9002.","+    /// </summary>","+    public class DownSelfQuarantinedByRemoteSpec : MultiNodeClusterSpec","+    {","+        private readonly DownSelfQuarantinedByRemoteSpecConfig _config;","+","+        public DownSelfQuarantinedByRemoteSpec()","+            : this(new DownSelfQuarantinedByRemoteSpecConfig())","+        {","+        }","+","+        protected DownSelfQuarantinedByRemoteSpec(DownSelfQuarantinedByRemoteSpecConfig config)","+            : base(config, typeof(DownSelfQuarantinedByRemoteSpec))","+        {","+            _config = config;","+        }","+","+        [MultiNodeFact]","+        public async Task DownSelfQuarantinedByRemoteSpecTests()","+        {","+            await Should_JoinCluster();","+            await Should_DownSelf_When_QuarantinedByMember();","+            await Should_NotDownAnyone_When_MemberLeavesGracefully();","+        }","+","+        private async Task Should_JoinCluster()","+        {","+            await AwaitClusterUpAsync(_config.First, _config.Second, _config.Third, _config.Fourth);","+            await EnterBarrierAsync(\"after-1\");","+        }","+","+        private async Task Should_DownSelf_When_QuarantinedByMember()","+        {","+            // dedicated probe, so Identify replies don't get mixed up with quarantine events","+            var quarantineEvents = CreateTestProbe();","+            await RunOnAsync(() =>","+            {","+                Sys.EventStream.Subscribe(quarantineEvents.Ref, typeof(ThisActorSystemQuarantinedEvent));","+                return Task.CompletedTask;","+            }, _config.First, _config.Second);","+            await EnterBarrierAsync(\"subscribed\");","+","+            await RunOnAsync(() =>","+            {","+                var second = Cluster.State.Members.First(m => m.Address.Equals(GetAddress(_config.Second)));","+                RARP.For(Sys).Provider.Transport.Quarantine(second.Address, second.UniqueAddress.Uid);","+                return Task.CompletedTask;","+            }, _config.First);","+            await EnterBarrierAsync(\"quarantined\");","+","+            await RunOnAsync(async () =>","+            {","+                // shorter than stable-after, so this is not the ordinary SBR decision","+                await WithinAsync(TimeSpan.FromSeconds(10), async () =>","+                {","+                    await AwaitAssertAsync(() =>","+                    {","+                        // cluster heartbeats alone don't trigger the refusal, so talk to first directly","+                        Sys.ActorSelection(new RootActorPath(GetAddress(_config.First)) / \"user\")","+                            .Tell(new Identify(null), ActorRefs.NoSender);","+                        Cluster.IsTerminated.Should().BeTrue();","+                    }, interval: TimeSpan.FromMilliseconds(200));","+                });","+","+                var quarantined = await quarantineEvents.ExpectMsgAsync<ThisActorSystemQuarantinedEvent>(TimeSpan.FromSeconds(5));","+                quarantined.RemoteAddress.Should().Be(GetAddress(_config.First));","+            }, _config.Second);","+            await EnterBarrierAsync(\"second-shutdown\");","+","+            await RunOnAsync(async () =>","+            {","+                // first quarantined second, not the other way around","+                await quarantineEvents.ExpectNoMsgAsync(TimeSpan.FromSeconds(1));","+                Cluster.IsTerminated.Should().BeFalse();","+            }, _config.First);","+","+            await RunOnAsync(() =>","+            {","+                Cluster.IsTerminated.Should().BeFalse();","+                return Task.CompletedTask;","+            }, _config.First, _config.Third, _config.Fourth);","+","+            await EnterBarrierAsync(\"after-2\");","+        }","+","+        private async Task Should_NotDownAnyone_When_MemberLeavesGracefully()","+        {","+            var quarantineEvents = CreateTestProbe();","+            await RunOnAsync(() =>","+            {","+                Sys.EventStream.Subscribe(quarantineEvents.Ref, typeof(ThisActorSystemQuarantinedEvent));","+                return Task.CompletedTask;","+            }, _config.First, _config.Fourth);","+            await EnterBarrierAsync(\"subscribed-2\");","+","+            await RunOnAsync(async () =>","+            {","+                await Cluster.LeaveAsync();","+            }, _config.Third);","+","+            await RunOnAsync(async () =>","+            {","+                await WithinAsync(TimeSpan.FromSeconds(20), async () =>","+                {","+                    await AwaitAssertAsync(() =>","+                    {","+                        Cluster.State.Members.Select(m => m.Address).Should().NotContain(GetAddress(_config.Third));","+                    });","+                });","+","+                // try to talk to the node that left: it must not make us down ourselves","+                var sel = Sys.ActorSelection(new RootActorPath(GetAddress(_config.Third)) / \"user\");","+                for (var i = 0; i < 10; i++)","+                {","+                    sel.Tell(new Identify(null), ActorRefs.NoSender);","+                    await quarantineEvents.ExpectNoMsgAsync(TimeSpan.FromMilliseconds(200));","+                }","+","+                Cluster.IsTerminated.Should().BeFalse();","+            }, _config.First, _config.Fourth);","+","+            await EnterBarrierAsync(\"after-3\");","+        }","+    }","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"src/core/Akka.Cluster.Tests.MultiNode/SBR/DownSelfQuarantinedStaleNodeSpec.cs","lines":["@@ -0,0 +1,154 @@","+﻿//-----------------------------------------------------------------------","+// <copyright file=\"DownSelfQuarantinedStaleNodeSpec.cs\" company=\"Akka.NET Project\">","+//     Copyright (C) 2009-2022 Lightbend Inc. <http://www.lightbend.com>","+//     Copyright (C) 2013-2025 .NET Foundation <https://github.com/akkadotnet/akka.net>","+// </copyright>","+//-----------------------------------------------------------------------","+","+using System;","+using System.Collections.Generic;","+using System.Linq;","+using System.Threading.Tasks;","+using Akka.Cluster.TestKit;","+using Akka.Configuration;","+using Akka.MultiNode.TestAdapter;","+using Akka.Remote.TestKit;","+using Akka.Remote.Transport;","+using FluentAssertions;","+","+namespace Akka.Cluster.Tests.MultiNode.SBR","+{","+    public class DownSelfQuarantinedStaleNodeSpecConfig : MultiNodeConfig","+    {","+        public RoleName First { get; }","+        public RoleName Second { get; }","+        public RoleName Third { get; }","+        public RoleName Fourth { get; }","+","+        public DownSelfQuarantinedStaleNodeSpecConfig()","+        {","+            First = Role(\"first\");","+            Second = Role(\"second\");","+            Third = Role(\"third\");","+            Fourth = Role(\"fourth\");","+","+            CommonConfig = ConfigurationFactory.ParseString(@\"","+                akka {","+                    loglevel = INFO","+                    cluster {","+                        downing-provider-class = \"\"Akka.Cluster.SBR.SplitBrainResolverProvider\"\"","+                        split-brain-resolver.active-strategy = keep-majority","+                        split-brain-resolver.stable-after = 5s","+                    }","+                    remote.retry-gate-closed-for = 1s","+","+                    # The blackhole also swallows the peers closing their connections to the stale node, so","+                    # without this the stale node keeps its old associations for the default 120 s pause and","+                    # never makes the new handshake that gets refused. A real paused process still has its","+                    # sockets closed by the OS, so it reconnects as soon as it wakes.","+                    remote.transport-failure-detector.heartbeat-interval = 1s","+                    remote.transport-failure-detector.acceptable-heartbeat-pause = 3s","+","+                    actor.provider = cluster","+                    test.filter-leeway = 10s","+                }\")","+                .WithFallback(MultiNodeLoggingConfig.LoggingConfig)","+                .WithFallback(DebugConfig(false))","+                .WithFallback(MultiNodeClusterSpec.ClusterConfig());","+","+            // fourth stands in for a frozen node: its own SBR must not reach a decision while it is cut off,","+            // so the only thing that can take it down after it reconnects is being quarantined by the others","+            NodeConfig(new List<RoleName> { Fourth }, new List<Config>","+            {","+                ConfigurationFactory.ParseString(\"akka.cluster.split-brain-resolver.stable-after = 120s\")","+            });","+","+            TestTransport = true;","+        }","+    }","+","+    /// <summary>","+    /// A node that the rest of the cluster downed and removed while it was cut off must down itself once it","+    /// reconnects and learns that the others have quarantined it, instead of running on as a cluster of its own.","+    /// See #9002.","+    /// </summary>","+    public class DownSelfQuarantinedStaleNodeSpec : MultiNodeClusterSpec","+    {","+        private readonly DownSelfQuarantinedStaleNodeSpecConfig _config;","+","+        public DownSelfQuarantinedStaleNodeSpec()","+            : this(new DownSelfQuarantinedStaleNodeSpecConfig())","+        {","+        }","+","+        protected DownSelfQuarantinedStaleNodeSpec(DownSelfQuarantinedStaleNodeSpecConfig config)","+            : base(config, typeof(DownSelfQuarantinedStaleNodeSpec))","+        {","+            _config = config;","+        }","+","+        [MultiNodeFact]","+        public async Task Should_DownSelf_When_RemovedByClusterWhileCutOff()","+        {","+            var majority = new[] { _config.First, _config.Second, _config.Third };","+","+            await AwaitClusterUpAsync(_config.First, _config.Second, _config.Third, _config.Fourth);","+            await EnterBarrierAsync(\"cluster-up\");","+","+            await RunOnAsync(async () =>","+            {","+                foreach (var role in majority)","+                    await TestConductor.BlackholeAsync(_config.Fourth, role, ThrottleTransportAdapter.Direction.Both);","+            }, _config.First);","+            await EnterBarrierAsync(\"blackholed\");","+","+            // the majority downs and removes fourth","+            await RunOnAsync(async () =>","+            {","+                await WithinAsync(TimeSpan.FromSeconds(30), async () =>","+                {","+                    await AwaitAssertAsync(() =>","+                    {","+                        Cluster.State.Members.Select(m => m.Address)","+                            .Should().BeEquivalentTo(majority.Select(GetAddress));","+                    });","+                });","+            }, majority);","+            await EnterBarrierAsync(\"fourth-removed\");","+","+            // fourth must still be up here: its own SBR is waiting out its long stable-after","+            await RunOnAsync(() =>","+            {","+                Cluster.IsTerminated.Should().BeFalse();","+                return Task.CompletedTask;","+            }, _config.Fourth);","+            await EnterBarrierAsync(\"fourth-still-up\");","+","+            await RunOnAsync(async () =>","+            {","+                foreach (var role in majority)","+                    await TestConductor.PassThroughAsync(_config.Fourth, role, ThrottleTransportAdapter.Direction.Both);","+            }, _config.First);","+            await EnterBarrierAsync(\"reconnected\");","+","+            await RunOnAsync(async () =>","+            {","+                // well within fourth's own stable-after: only the quarantine can explain this","+                await WithinAsync(TimeSpan.FromSeconds(30), async () =>","+                {","+                    await AwaitAssertAsync(() => Cluster.IsTerminated.Should().BeTrue(),","+                        interval: TimeSpan.FromMilliseconds(250));","+                });","+            }, _config.Fourth);","+","+            await RunOnAsync(() =>","+            {","+                Cluster.IsTerminated.Should().BeFalse();","+                Cluster.State.Members.Select(m => m.Address).Should().BeEquivalentTo(majority.Select(GetAddress));","+                return Task.CompletedTask;","+            }, majority);","+","+            await EnterBarrierAsync(\"done\");","+        }","+    }","+}"],"additions":154,"deletions":0,"truncated":false},{"path":"src/core/Akka.Cluster.Tests/SBR/SplitBrainResolverSpec.cs","lines":["@@ -64,7 +64,8 @@ public static Props Props(","                 IActorRef probe,","                 UniqueAddress selfUniqueAddress,","                 TimeSpan downAllWhenUnstable,","-                TimeSpan tick)","+                TimeSpan tick,","+                bool downSelfWhenQuarantinedByMember = true)","             {","                 return Actor.Props.Create(() => new DowningTestActor(","                     stableAfter,","@@ -72,7 +73,8 @@ public static Props Props(","                     probe,","                     selfUniqueAddress,","                     downAllWhenUnstable,","-                    tick));","+                    tick,","+                    downSelfWhenQuarantinedByMember));","             }"," ","             public DowningTestActor(","@@ -81,15 +83,19 @@ public DowningTestActor(","                 IActorRef probe,","                 UniqueAddress selfUniqueAddress,","                 TimeSpan downAllWhenUnstable,","-                TimeSpan tick)","+                TimeSpan tick,","+                bool downSelfWhenQuarantinedByMember)","                 : base(stableAfter, strategy)","             {","                 Probe = probe;","                 SelfUniqueAddress = selfUniqueAddress;","                 DownAllWhenUnstable = downAllWhenUnstable;","                 Tick = tick;","+                DownSelfWhenQuarantinedByMember = downSelfWhenQuarantinedByMember;","             }"," ","+            public override bool DownSelfWhenQuarantinedByMember { get; }","+","             public IActorRef Probe { get; }"," ","             public new TimeSpan Tick { get; }","@@ -110,12 +116,14 @@ protected override Deadline NewStableDeadline()"," ","             public override void Down(UniqueAddress node, IDecision decision)","             {","-                if (Leader && !downed.Contains(node.Address))","+                // downing itself after being quarantined is allowed on any node, not just the leader","+                var allowed = Leader || decision is DownSelfQuarantinedByRemote;","+                if (allowed && !downed.Contains(node.Address))","                 {","                     downed = downed.Add(node.Address);","                     Probe.Tell(new DownCalled(node.Address));","                 }","-                else if (!Leader)","+                else if (!allowed)","                     Probe.Tell(\"down must only be done by leader\");","             }"," ","@@ -1388,14 +1396,16 @@ public SetupKeepMajority(","                 UniqueAddress selfUniqueAddress,","                 string role,","                 TimeSpan? downAllWhenUnstable = null,","-                TimeSpan? tickInterval = null)","+                TimeSpan? tickInterval = null,","+                bool downSelfWhenQuarantinedByMember = true)","                 : base(","                       owner,","                       stableAfter,","                       new Akka.Cluster.SBR.KeepMajority(role),","                       selfUniqueAddress,","                       downAllWhenUnstable,","-                      tickInterval)","+                      tickInterval,","+                      downSelfWhenQuarantinedByMember)","             {","             }","         }","@@ -1483,7 +1493,8 @@ public Setup(","                 DowningStrategy strategy,","                 UniqueAddress selfUniqueAddress,","                 TimeSpan? downAllWhenUnstable = null,","-                TimeSpan? tickInterval = null)","+                TimeSpan? tickInterval = null,","+                bool downSelfWhenQuarantinedByMember = true)","             {","                 Owner = owner;","                 StableAfter = stableAfter;","@@ -1494,7 +1505,7 @@ public Setup("," ","                 A = owner.Sys.ActorOf(","                   DowningTestActor","-                    .Props(stableAfter, strategy, owner.TestActor, selfUniqueAddress, DownAllWhenUnstable, TickInterval));","+                    .Props(stableAfter, strategy, owner.TestActor, selfUniqueAddress, DownAllWhenUnstable, TickInterval, downSelfWhenQuarantinedByMember));","             }"," ","             public SplitBrainResolverSpec Owner { get; }","@@ -1552,6 +1563,22 @@ public void Tick()","                 A.Tell(SplitBrainResolverBase.Tick.Instance);","             }"," ","+            public void MemberLeft(params Member[] members)","+            {","+                foreach (var m in members)","+                    A.Tell(new ClusterEvent.MemberLeft(m.Copy(MemberStatus.Leaving)));","+            }","+","+            public void QuarantinedBy(Address remoteAddress, long? remoteUid)","+            {","+                A.Tell(new ThisActorSystemQuarantinedEvent(SelfUniqueAddress.Address, remoteAddress, remoteUid));","+            }","+","+            public void QuarantinedBy(Member member)","+            {","+                QuarantinedBy(member.Address, member.UniqueAddress.Uid);","+            }","+","             public void ExpectDownCalled(params Member[] members)","             {","                 Owner.ReceiveN(members.Length).ToImmutableHashSet().Should().BeEquivalentTo(members.Select(m => new DownCalled(m.Address)).ToImmutableHashSet());","@@ -1569,6 +1596,117 @@ public void Stop()","             }","         }"," ","+        #region DownSelfQuarantinedByRemote (#9002)","+","+        [Fact(DisplayName = \"Should_DownSelf_When_QuarantinedByCurrentMember\")]","+        public void Should_DownSelf_When_QuarantinedByCurrentMember()","+        {","+            // B is not the leader: downing itself must not depend on leadership","+            var setup = new SetupKeepMajority(this, TimeSpan.FromMinutes(1), MemberB.UniqueAddress, null);","+            setup.MemberUp(MemberA, MemberB, MemberC);","+            setup.Leader(MemberA);","+            setup.QuarantinedBy(MemberA);","+            setup.ExpectDownCalled(MemberB);","+            setup.Stop();","+        }","+","+        [Fact(DisplayName = \"Should_DownSelf_When_QuarantinedByUnreachableMember_With_LeaseMajority\")]","+        public void Should_DownSelf_When_QuarantinedByUnreachableMember_With_LeaseMajority()","+        {","+            // the stale-node case: B sees everyone else as unreachable and is leader of its own view,","+            // but must not wait for stable-after or the lease once a member has quarantined it","+            var setup = new SetupLeaseMajority(this, TimeSpan.FromMinutes(1), MemberB.UniqueAddress, null,","+                new TestLease(testLeaseSettings, ExtSystem));","+            setup.MemberUp(MemberA, MemberB, MemberC);","+            setup.Leader(MemberB);","+            setup.Unreachable(MemberA, MemberC);","+            setup.QuarantinedBy(MemberA);","+            setup.ExpectDownCalled(MemberB);","+            setup.Stop();","+        }","+","+        [Fact(DisplayName = \"Should_NotDownSelf_When_QuarantinedByNonMember\")]","+        public async Task Should_NotDownSelf_When_QuarantinedByNonMember()","+        {","+            var setup = new SetupKeepMajority(this, TimeSpan.FromMinutes(1), MemberB.UniqueAddress, null);","+            setup.MemberUp(MemberA, MemberB, MemberC);","+            setup.Leader(MemberA);","+            setup.QuarantinedBy(MemberD);","+            await ExpectNoMsgAsync(TimeSpan.FromMilliseconds(300));","+            setup.Stop();","+        }","+","+        [Fact(DisplayName = \"Should_NotDownSelf_When_QuarantinedByOtherIncarnationOfMember\")]","+        public async Task Should_NotDownSelf_When_QuarantinedByOtherIncarnationOfMember()","+      