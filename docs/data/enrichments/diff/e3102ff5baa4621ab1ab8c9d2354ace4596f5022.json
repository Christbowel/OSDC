ding SET clauses (they set configuration, not index names, and pass through unchanged).","+        // After stripping, check whether the remainder starts with LET.","+        List<String> parts = splitIgnoringParentheses(testQuery, \";\");","+        int firstNonSet = 0;","+        while (firstNonSet < parts.size() && startsWithCommandKeyword(parts.get(firstNonSet).strip(), SET_COMMAND_PATTERN)) {","+            firstNonSet++;","+        }","+        if (firstNonSet == 0) {","+            // No leading SET clauses — fast path (original behaviour).","+            if (startsWithCommandKeyword(testQuery.strip(), LET_COMMAND_PATTERN)) {","+                return convertLetQueryToRemoteIndices(testQuery, bothClusterIndices);","+            }","+            return convertSubqueryToRemoteIndices(testQuery, bothClusterIndices, Set.of());","+        }","+        // Reconstruct: SET clauses pass through unchanged; remainder is dispatched normally.","+        String setPrefix = String.join(\";\\n\", parts.subList(0, firstNonSet)) + \";\\n\";","+        String remainder = String.join(\";\", parts.subList(firstNonSet, parts.size())).strip();","+        if (startsWithCommandKeyword(remainder, LET_COMMAND_PATTERN)) {","+            return setPrefix + convertLetQueryToRemoteIndices(remainder, bothClusterIndices);","+        }","+        return setPrefix + convertSubqueryToRemoteIndices(remainder, bothClusterIndices, Set.of());","+    }","+","+    /**","+     * Rewrites index names inside a LET-prefix query for cross-cluster testing.","+     * Real index names in LET binding bodies are converted to remote patterns ({@code *:index,index}).","+     * LET binding names used as FROM sources in subsequent bindings or the main query are left unchanged.","+     * Each {@code LET name = (subquery);} statement declares exactly one binding.","+     */","+    private static String convertLetQueryToRemoteIndices(String testQuery, Set<String> bothClusterIndices) {","+        // Split at the top-level ';' to separate the LET statements from the main query.","+        List<String> parts = splitIgnoringParentheses(testQuery, \";\");","+        int letCount = 0;","+        while (letCount < parts.size() && startsWithCommandKeyword(parts.get(letCount).strip(), LET_COMMAND_PATTERN)) {","+            letCount++;","+        }","+        String mainQuery = String.join(\";\", parts.subList(letCount, parts.size())).strip();","+","+        // First pass: collect all binding names so we can skip rewriting them as remote indices.","+        Set<String> letBindingNames = new HashSet<>();","+        List<String[]> parsedBindings = new ArrayList<>();","+        for (String letStatement : parts.subList(0, letCount)) {","+            // Strip the \"LET\" keyword; what remains is \"name = (body)\".","+            String binding = letStatement.strip().substring(3).strip();","+            int eqIdx = binding.indexOf('=');","+            String name = binding.substring(0, eqIdx).strip();","+            letBindingNames.add(name);","+            parsedBindings.add(new String[] { name, binding.substring(eqIdx + 1).strip() });","+        }","+","+        // Second pass: rewrite each binding body, leaving LET binding name references unchanged.","+        StringBuilder result = new StringBuilder();","+        for (String[] parsedBinding : parsedBindings) {","+            String bodyWithParens = parsedBinding[1];","+            String innerBody = bodyWithParens.startsWith(\"(\") && bodyWithParens.endsWith(\")\")","+                ? bodyWithParens.substring(1, bodyWithParens.length() - 1)","+                : bodyWithParens;","+            String rewrittenBody = convertSubqueryToRemoteIndices(innerBody, bothClusterIndices, letBindingNames);","+            result.append(\"LET \").append(parsedBinding[0]).append(\" = (\").append(rewrittenBody).append(\");\\n\");","+        }","+","+        // Rewrite the main query, treating LET binding names as non-indices.","+        if (mainQuery.isEmpty() == false) {","+            result.append(convertSubqueryToRemoteIndices(mainQuery, bothClusterIndices, letBindingNames));","+        }","+        return result.toString();","+    }","+","+    private static String convertSubqueryToRemoteIndices(String testQuery, Set<String> bothClusterIndices, Set<String> letBindingNames) {","         String query = testQuery;","         // find the main source command, ignoring pipes inside subqueries","         List<String> mainFromCommandAndTheRest = splitIgnoringParentheses(query, \"|\");","@@ -1950,7 +2019,10 @@ public static String convertSubqueryToRemoteIndices(String testQuery, Set<String","         // may contain FROM subqueries that do need rewriting.","         if (startsWithCommandKeyword(mainFrom, ROW_COMMAND_PATTERN)) {","             for (int i = 1; i < mainFromCommandAndTheRest.size(); i++) {","-                mainFromCommandAndTheRest.set(i, rewriteSubqueriesInExpression(mainFromCommandAndTheRest.get(i), bothClusterIndices));","+                mainFromCommandAndTheRest.set(","+                    i,","+                    rewriteSubqueriesInExpression(mainFromCommandAndTheRest.get(i), bothClusterIndices, letBindingNames)","+                );","             }","             return String.join(\" | \", mainFromCommandAndTheRest);","         }","@@ -1976,8 +2048,11 @@ public static String convertSubqueryToRemoteIndices(String testQuery, Set<String","             if (isSubquery(indexPatternOrSubquery)) {","                 // it's a subquery, we need to process it recursively","                 String subquery = indexPatternOrSubquery.strip().substring(1, indexPatternOrSubquery.length() - 1);","-                String transformedSubquery = convertSubqueryToRemoteIndices(subquery, bothClusterIndices);","+                String transformedSubquery = convertSubqueryToRemoteIndices(subquery, bothClusterIndices, letBindingNames);","                 transformed.add(\"(\" + transformedSubquery + \")\");","+            } else if (letBindingNames.contains(unquoteIndexName(indexPatternOrSubquery))) {","+                // This source is a LET binding name, not a real ES index — leave it unchanged.","+                transformed.add(indexPatternOrSubquery);","             } else {","                 // Indices that live on both clusters (enrich source / lookup indices) must become","                 // remote-only (*:index) to avoid double-counting; everything else uses *:index,index.","@@ -1991,7 +2066,10 @@ public static String convertSubqueryToRemoteIndices(String testQuery, Set<String","         // that follow the source command. Non-subquery parenthesised groups (value lists, function","         // arguments, boolean groupings) are left structurally unchanged.","         for (int i = 1; i < mainFromCommandAndTheRest.size(); i++) {","-            mainFromCommandAndTheRest.set(i, rewriteSubqueriesInExpression(mainFromCommandAndTheRest.get(i), bothClusterIndices));","+            mainFromCommandAndTheRest.set(","+                i,","+                rewriteSubqueriesInExpression(mainFromCommandAndTheRest.get(i), bothClusterIndices, letBindingNames)","+            );","         }","         // rebuild the whole query","         mainFromCommandAndTheRest.set(0, transformedFrom);","@@ -2014,8 +2092,9 @@ public static String convertSubqueryToRemoteIndices(String testQuery, Set<String","      * <p>Like {@link #splitIgnoringParentheses}, this method is not string-literal-aware.","      *","      * @param bothClusterIndices see {@link #convertSubqueryToRemoteIndices(String, Set)}.","+     * @param letBindingNames    LET binding names, which are not real indices and must not be rewritten.","      */","-    private static String rewriteSubqueriesInExpression(String segment, Set<String> bothClusterIndices) {","+    private static String rewriteSubqueriesInExpression(String segment, Set<String> bothClusterIndices, Set<String> letBindingNames) {","         StringBuilder result = new StringBuilder();","         int i = 0;","         while (i < segment.length()) {","@@ -2040,11 +2119,11 @@ private static String rewriteSubqueriesInExpression(String segment, Set<String>","                     || startsWithCommandKeyword(strippedContent, ROW_COMMAND_PATTERN)) {","                     // This group is a subquery body — rewrite it recursively.","                     // ROW bodies are returned unchanged by convertSubqueryToRemoteIndices.","-                    rewrittenGroup = \"(\" + convertSubqueryToRemoteIndices(strippedContent, bothClusterIndices) + \")\";","+                    rewrittenGroup = \"(\" + convertSubqueryToRemoteIndices(strippedContent, bothClusterIndices, letBindingNames) + \")\";","                 } else {","                     // Not a direct subquery body (value list, function args, boolean grouping, …).","                     // Recurse into the raw content to catch any nested subquery inside it.","-                    rewrittenGroup = \"(\" + rewriteSubqueriesInExpression(content, bothClusterIndices) + \")\";","+                    rewrittenGroup = \"(\" + rewriteSubqueriesInExpression(content, bothClusterIndices, letBindingNames) + \")\";","                 }","                 result.append(rewrittenGroup);","                 i = j;","@@ -2059,6 +2138,8 @@ private static String rewriteSubqueriesInExpression(String segment, Set<String>","     private static final Pattern FROM_COMMAND_PATTERN = commandPattern(\"from\");","     private static final Pattern TS_COMMAND_PATTERN = commandPattern(\"ts\");","     private static final Pattern ROW_COMMAND_PATTERN = commandPattern(\"row\");","+    private static final Pattern LET_COMMAND_PATTERN = commandPattern(\"let\");","+    private static final Pattern SET_COMMAND_PATTERN = commandPattern(\"set\");"," ","     private static Pattern commandPattern(String keyword) {","         return Pattern.compile(Pattern.quote(keyword) + \"\\\\p{javaWhitespace}\", Pattern.CASE_INSENSITIVE);"],"additions":87,"deletions":6,"truncated":false},{"path":"x-pack/plugin/esql/qa/testFixtures/src/main/resources/named_subquery.csv-spec","lines":["@@ -0,0 +1,328 @@","+// CSV spec for LET-prefix named subquery tests","+","+// -------------------------------------------------------------------","+// Basic LET: single binding used as FROM source","+// -------------------------------------------------------------------","+","+letSingleBinding","+required_capability: named_subquery_let","+","+LET top_langs = (FROM languages | SORT language_code | LIMIT 2)\\;","+FROM top_langs","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+1                     | English","+2                     | French","+;","+","+// -------------------------------------------------------------------","+// LET body contains aggregation (STATS)","+// -------------------------------------------------------------------","+","+letWithStatsInBody","+required_capability: named_subquery_let","+","+LET lang_count = (FROM languages | STATS cnt = COUNT(*))\\;","+FROM lang_count","+| KEEP cnt","+;","+","+cnt:long","+4","+;","+","+// -------------------------------------------------------------------","+// Chained LET bindings: later binding references earlier one","+// -------------------------------------------------------------------","+","+letChainedBindings","+required_capability: named_subquery_let","+","+LET filtered = (FROM languages | WHERE language_code > 1)\\;","+LET top2 = (FROM filtered | SORT language_code | LIMIT 2)\\;","+FROM top2","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+2                     | French","+3                     | Spanish","+;","+","+// -------------------------------------------------------------------","+// LET binding referenced in WHERE ... IN position","+// -------------------------------------------------------------------","+","+letBindingInInSubquery","+required_capability: named_subquery_let","+required_capability: where_in_subquery_without_view","+","+LET low_codes = (FROM languages | WHERE language_code <= 2 | KEEP language_code)\\;","+FROM languages","+| WHERE language_code IN (FROM low_codes)","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+1                     | English","+2                     | French","+;","+","+// -------------------------------------------------------------------","+// Same LET binding used as FROM source and inside IN (FROM binding)","+// -------------------------------------------------------------------","+","+letBindingInFromAndInSubquery","+required_capability: named_subquery_let","+required_capability: where_in_subquery_without_view","+","+LET top_codes = (FROM languages | SORT language_code | LIMIT 3 | KEEP language_code)\\;","+FROM top_codes","+| WHERE language_code IN (FROM top_codes)","+| SORT language_code","+;","+","+language_code:integer","+1","+2","+3","+;","+","+// -------------------------------------------------------------------","+// Multiple LET bindings: one used as FROM source, another in IN position","+// -------------------------------------------------------------------","+","+letMultipleBindingsFromAndIn","+required_capability: named_subquery_let","+required_capability: where_in_subquery_without_view","+","+LET sources = (FROM languages | WHERE language_code > 1 | KEEP language_code, language_name)\\;","+LET filter_codes = (FROM languages | WHERE language_code <= 3 | KEEP language_code)\\;","+FROM sources","+| WHERE language_code IN (FROM filter_codes)","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+2                     | French","+3                     | Spanish","+;","+","+// -------------------------------------------------------------------","+// LET + views: binding body references a stored view","+// -------------------------------------------------------------------","+","+letBodyReferencingView","+required_capability: named_subquery_let","+required_capability: views_with_no_branching","+required_capability: views_crud_as_index_actions","+","+LET high_langs = (FROM view_languages | WHERE language_code > 2 | KEEP language_code, language_name)\\;","+FROM high_langs","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+3                     | Spanish","+4                     | German","+;","+","+// -------------------------------------------------------------------","+// LET + views: stored view whose body contains a LET clause","+// -------------------------------------------------------------------","+","+viewBodyWithLet","+required_capability: named_subquery_let","+required_capability: views_with_no_branching","+required_capability: views_crud_as_index_actions","+","+FROM view_with_let","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+2                     | French","+3                     | Spanish","+4                     | German","+;","+","+// The main query and the view body both declare a binding named `base`.","+// Each scope resolves its own binding: the main one yields code 1, the view's one yields codes 2-4.","+letMainAndViewBindingsWithSameName","+required_capability: named_subquery_let","+required_capability: views_with_no_branching","+required_capability: views_crud_as_index_actions","+","+LET base = (FROM languages | WHERE language_code <= 1)\\;","+FROM base, view_with_let","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+1                     | English","+2                     | French","+3                     | Spanish","+4                     | German","+;","+","+// The main binding shadows the `languages` index only in the main query.","+// view_languages (FROM languages) still reads the real index because view bodies never see the caller's LET scope.","+letMainBindingDoesNotLeakIntoViewBody","+required_capability: named_subquery_let","+required_capability: views_with_no_branching","+required_capability: views_crud_as_index_actions","+","+LET languages = (ROW language_code = 0, language_name = \"Esperanto\")\\;","+FROM languages, view_languages","+| KEEP language_code, language_name","+| SORT language_code","+;","+","+language_code:integer | language_name:keyword","+0                     | Esperanto","+1                     | English","+2                     | French","+3                     | Spanish","+4                     | German","+;","+","+// -------------------------------------------------------------------","+// Chained LET with LIMIT BY and multi-column IN:","+// Top 2 clusters by avg bytes_in; within each, identify the top pod;","+// filter the full dataset to only (cluster, pod) pairs that are top-ranked.","+// Note: a nested \"other\" bucket pattern (relabelling non-top rows via FORK)","+// would require two FORK commands, which exceeds the current single-FORK limit.","+// -------------------------------------------------------------------","+","+letChainedWithLimitByAndMultiColumnIn","+required_capability: named_subquery_let","+required_capability: esql_limit_by","+required_capability: where_in_subquery_without_view","+required_capability: where_in_multi_column_subquery","+","+LET top2_clusters = (","+    FROM k8s","+        | STATS AVG(network.bytes_in) BY cluster","+        | SORT `AVG(network.bytes_in)` DESC","+        | LIMIT 2","+        | KEEP cluster","+)\\;","+LET top1_pod_by_cluster = (","+    FROM k8s","+        | WHERE cluster IN (FROM top2_clusters)","+        | STATS AVG(network.bytes_in) BY cluster, pod","+        | SORT `AVG(network.bytes_in)` DESC","+        | LIMIT 1 BY cluster","+        | KEEP cluster, pod","+)\\;","+FROM k8s","+| WHERE (cluster, pod) IN (FROM top1_pod_by_cluster)","+| STATS AVG(network.bytes_in) BY cluster, pod","+| SORT cluster, pod","+;","+","+AVG(network.bytes_in):double | cluster:keyword | pod:keyword","+605.5625                     | prod            | two","+553.1379310344828            | qa              | two","+;","+","+// -------------------------------------------------------------------","+// Nested \"other\" buckets via FORK at both levels:","+// cluster-level: top 2 by avg bytes → rest become \"other\"","+// pod-level: top 1 per cluster → rest become \"other\"","+// -------------------------------------------------------------------","+","+nestedOtherBuckets","+required_capability: named_subquery_let","+required_capability: fork_v9","+required_capability: esql_limit_by","+required_capability: where_in_subquery_without_view","+required_capability: where_in_multi_column_subquery","+","+LET top2_clusters = (","+    FROM k8s","+        | STATS AVG(network.bytes_in) BY cluster","+        | SORT `AVG(network.bytes_in)` DESC","+        | LIMIT 2","+        | KEEP cluster","+)\\;","+LET top_clusters = (","+    FROM k8s","+        | EVAL cluster = CASE(cluster IN (FROM top2_clusters), cluster, \"Other\"::keyword)","+)\\;","+LET top1_pod_by_cluster = (","+    FROM top_clusters","+        | STATS AVG(network.bytes_in) BY cluster, pod","+        | SORT `AVG(network.bytes_in)` DESC","+        | LIMIT 1 BY cluster","+        | KEEP cluster, pod","+)\\;","+LET top_pods_by_cluster = (","+    FROM top_clusters","+        | EVAL pod = CASE((cluster, pod) IN (FROM top1_pod_by_cluster), pod, \"Other\"::keyword)","+)\\;","+FROM top_pods_by_cluster","+| STATS AVG(network.bytes_in) BY cluster, pod","+| SORT cluster, pod","+;","+","+AVG(network.bytes_in):double | cluster:keyword | pod:keyword","+414.2972972972973            | Other           | Other","+529.25                       | Other           | two","+465.73333333333335           | prod            | Other","+605.5625                     | 