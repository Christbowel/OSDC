{"id":"9dcf7927a3b929dec505dcf0c82ff0a0619323a3","axis":"silent","repo":"aws/aws-sdk-js-v3","sha":"9dcf7927a3b929dec505dcf0c82ff0a0619323a3","parsed":{"files":[{"path":"lib/lib-sns/CHANGELOG.md","lines":["@@ -0,0 +1,4 @@","+# Change Log","+","+All notable changes to this project will be documented in this file.","+See [Conventional Commits](https://conventionalcommits.org) for commit guidelines."],"additions":4,"deletions":0,"truncated":false},{"path":"lib/lib-sns/README.md","lines":["@@ -0,0 +1,150 @@","+# Amazon SNS Message Validator for JavaScript","+","+The **Amazon SNS Message Validator** library allows you to validate that","+incoming HTTP(S) POST messages are valid Amazon SNS notifications. This library","+is standalone and does not depend on an SNS client.","+","+## Installation","+","+Install with npm or yarn:","+","+```","+npm i @aws-sdk/lib-sns","+```","+","+or","+","+```","+yarn add @aws-sdk/lib-sns","+```","+","+## Basic Usage","+","+To validate a message, you can instantiate a `MessageValidator` object and pass","+an SNS message to its `validate` method. The message should be the result of","+calling `JSON.parse` on the body of the HTTP(S) message sent by SNS to your","+endpoint. `validate` returns a promise that resolves with the successfully","+validated SNS message, or rejects with an error.","+","+The message validator checks the `SigningCertURL`, `SignatureVersion`, and","+`Signature` to make sure they are valid and consistent with the message data.","+","+```javascript","+import { MessageValidator } from \"@aws-sdk/lib-sns\";","+","+const validator = new MessageValidator();","+","+try {","+  const message = await validator.validate(message);","+  // message has been validated and its signature checked.","+} catch (err) {","+  // Your message could not be validated.","+}","+```","+","+A Node-style callback is also accepted. The callback takes two arguments, the","+first being an error and the second being the successfully validated SNS","+message.","+","+```javascript","+validator.validate(message, function (err, message) {","+  if (err) {","+    // Your message could not be validated.","+    return;","+  }","+","+  // message has been validated and its signature checked.","+});","+```","+","+## Installation","+","+The SNS Message Validator relies on the Node crypto module and is only designed","+to work on a server, not in a browser. The validation performed is only","+necessary when subscribing HTTP(S) endpoints to a topic.","+","+## About Amazon SNS","+","+[Amazon Simple Notification Service (Amazon SNS)][sns] is a fast, fully-managed,","+push messaging service. Amazon SNS can deliver messages to email, mobile devices","+(i.e., SMS; iOS, Android and FireOS push notifications), Amazon SQS queues, and","+— of course — HTTP/HTTPS endpoints.","+","+With Amazon SNS, you can setup topics to publish custom messages to subscribed","+endpoints. However, SNS messages are used by many of the other AWS services to","+communicate information asynchronously about your AWS resources. Some examples","+include:","+","+- Configuring Amazon S3 Glacier to notify you when a retrieval job is complete.","+- Configuring AWS CloudTrail to notify you when a new log file has been written.","+","+Though you can certainly subscribe your email address to receive SNS messages","+from service events like these, your inbox would fill up rather quickly. There","+is great power, however, in being able to subscribe an HTTP/HTTPS endpoint to","+receive the messages. This allows you to program webhooks for your applications","+to easily respond to various events.","+","+## Handling Messages","+","+### Confirming a Subscription to a Topic","+","+In order to handle a `SubscriptionConfirmation` message, you must use the","+`SubscribeURL` value in the incoming message:","+","+```javascript","+import { MessageValidator } from \"@aws-sdk/lib-sns\";","+","+const validator = new MessageValidator();","+","+try {","+  const message = await validator.validate(message);","+","+  if (message.Type === \"SubscriptionConfirmation\") {","+    await fetch(message.SubscribeURL);","+    // You have confirmed your endpoint subscription","+  }","+} catch (err) {","+  console.error(err);","+}","+```","+","+If an incoming message includes multibyte characters and its encoding is utf8,","+set the encoding on the `validator`.","+","+```javascript","+import { MessageValidator } from \"@aws-sdk/lib-sns\";","+","+const validator = new MessageValidator();","+validator.encoding = \"utf8\";","+```","+","+### Receiving a Notification","+","+To receive a notification, use the same code as the preceding example, but","+check for the `Notification` message type.","+","+```javascript","+if (message.Type === \"Notification\") {","+  // Do whatever you want with the message body and data.","+  console.log(message.MessageId + \": \" + message.Message);","+}","+```","+","+The message body will be a string, and will hold whatever data was published","+to the SNS topic.","+","+### Unsubscribing","+","+Unsubscribing looks the same as subscribing, except the message type will be","+`UnsubscribeConfirmation`.","+","+```javascript","+if (message.Type === \"UnsubscribeConfirmation\") {","+  // Unsubscribed in error? You can resubscribe by visiting the endpoint","+  // provided as the message's SubscribeURL field.","+  await fetch(message.SubscribeURL);","+  // You have re-subscribed your endpoint.","+}","+```","+","+[sns]: http://aws.amazon.com/sns/"],"additions":150,"deletions":0,"truncated":false},{"path":"lib/lib-sns/api-extractor.json","lines":["@@ -0,0 +1,4 @@","+{","+  \"extends\": \"../../api-extractor.lib.json\",","+  \"mainEntryPointFilePath\": \"./dist-types/index.d.ts\"","+}"],"additions":4,"deletions":0,"truncated":false},{"path":"lib/lib-sns/package.json","lines":["@@ -0,0 +1,57 @@","+{","+  \"name\": \"@aws-sdk/lib-sns\",","+  \"version\": \"3.0.0\",","+  \"description\": \"Standalone validator for inbound HTTP(S) Amazon SNS messages\",","+  \"homepage\": \"https://github.com/aws/aws-sdk-js-v3/tree/main/lib/lib-sns\",","+  \"license\": \"Apache-2.0\",","+  \"author\": {","+    \"name\": \"AWS SDK for JavaScript Team\",","+    \"url\": \"https://aws.amazon.com/sdk-for-javascript/\"","+  },","+  \"repository\": {","+    \"type\": \"git\",","+    \"url\": \"https://github.com/aws/aws-sdk-js-v3.git\",","+    \"directory\": \"lib/lib-sns\"","+  },","+  \"files\": [","+    \"dist-*/**\"","+  ],","+  \"main\": \"./dist-cjs/index.js\",","+  \"module\": \"./dist-es/index.js\",","+  \"types\": \"./dist-types/index.d.ts\",","+  \"typesVersions\": {","+    \"<4.5\": {","+      \"dist-types/*\": [","+        \"dist-types/ts3.4/*\"","+      ]","+    }","+  },","+  \"scripts\": {","+    \"build\": \"concurrently 'yarn:build:types' 'yarn:build:es' && yarn build:cjs\",","+    \"build:cjs\": \"node ../../scripts/compilation/inline\",","+    \"build:es\": \"premove dist-es && tsc -p tsconfig.es.json\",","+    \"build:include:deps\": \"yarn g:turbo run build -F=\\\"$npm_package_name\\\"\",","+    \"build:types\": \"premove dist-types && tsc -p tsconfig.types.json\",","+    \"build:types:downlevel\": \"downlevel-dts dist-types dist-types/ts3.4\",","+    \"clean\": \"premove dist-cjs dist-es dist-types\",","+    \"extract:docs\": \"api-extractor run --local\",","+    \"test\": \"yarn g:vitest run\",","+    \"test:watch\": \"yarn g:vitest watch\",","+    \"test:e2e\": \"yarn g:vitest run -c vitest.config.e2e.mts --mode development\",","+    \"test:e2e:watch\": \"yarn g:vitest watch -c vitest.config.e2e.mts\"","+  },","+  \"dependencies\": {","+    \"tslib\": \"^2.6.2\"","+  },","+  \"devDependencies\": {","+    \"@tsconfig/recommended\": \"1.0.1\",","+    \"@types/node\": \"^20.14.8\",","+    \"concurrently\": \"7.0.0\",","+    \"downlevel-dts\": \"0.10.1\",","+    \"premove\": \"4.0.0\",","+    \"typescript\": \"~7.0.2\"","+  },","+  \"engines\": {","+    \"node\": \">=20.0.0\"","+  }","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"lib/lib-sns/src/MessageValidator.spec.ts","lines":["@@ -0,0 +1,413 @@","+import { createSign, generateKeyPairSync, type KeyObject } from \"node:crypto\";","+import { beforeAll, describe, expect, it, vi } from \"vitest\";","+","+import { DEFAULT_HOST_PATTERN, SIGNABLE_KEYS_BY_TYPE } from \"./constants\";","+import { MessageValidator } from \"./MessageValidator\";","+import type { SNSMessage } from \"./types\";","+","+// A signing keypair stands in for an SNS signing cert: the validator verifies","+// the signature against the public key PEM returned by the stubbed fetcher,","+// which reproduces the upstream cert-verify path without an X.509 library.","+let privateKey: KeyObject;","+let certPem: string;","+","+const now = new Date().toISOString();","+","+const invalidMessage = { foo: \"bar\", fizz: \"buzz\" } as unknown as SNSMessage;","+","+const validMessage: SNSMessage = {","+  Type: \"Notification\",","+  MessageId: \"1\",","+  TopicArn: \"arn\",","+  Message: \"A message for you!\",","+  Timestamp: now,","+  SignatureVersion: \"1\",","+  SigningCertURL: \"https://localhost:56789/cert.pem\",","+};","+","+const validSHA256Message: SNSMessage = {","+  ...validMessage,","+  SignatureVersion: \"2\",","+};","+","+const validLambdaMessage: SNSMessage = {","+  Type: \"Notification\",","+  MessageId: \"1\",","+  TopicArn: \"arn\",","+  Subject: null,","+  Message: \"A Lambda message for you!\",","+  Timestamp: now,","+  SignatureVersion: \"1\",","+  SigningCertUrl: \"https://localhost:56789/cert.pem\",","+};","+","+const validSubscriptionControlMessage: SNSMessage = {","+  ...validMessage,","+  Token: \"Nonce\",","+  SubscribeURL: \"https://www.amazonaws.com\",","+  Type: \"SubscriptionConfirmation\",","+};","+","+const validUnsubscriptionControlMessage: SNSMessage = {","+  ...validSubscriptionControlMessage,","+  Type: \"UnsubscribeConfirmation\",","+};","+","+const utf8Message: SNSMessage = {","+  ...validMessage,","+  Message: \"Ａ Ｍｅｓｓａｇｅ Ｆｏｒ ｙｏｕ！\",","+};","+","+const multilineMessage: SNSMessage = {","+  ...validMessage,","+  Message: \"first\\nsecond\",","+  Subject: \"first\\nsecond\",","+};","+","+const shiftedMessage: SNSMessage = {","+  Type:","+    \"MessageId\\nmessage-id-1\" +","+    \"\\nTimestamp\\n2015-10-05T06:41:38.000Z\" +","+    \"\\nTopicArn\\narn:aws:sns:us-east-1:222222222222:topic-b\" +","+    \"\\nType\\nNotification\",","+  MessageId: \"message-id-2\",","+  TopicArn: \"arn:aws:sns:us-east-1:111111111111:topic-a\",","+  Message: \"hello\",","+  Timestamp: \"2015-10-05T06:40:38.000Z\",","+  SignatureVersion: \"2\",","+  SigningCertURL: \"https://localhost:56789/cert.pem\",","+};","+","+const delimitedMessage: SNSMessage = {","+  Type: \"Notification\",","+  MessageId: \"message-id-1\",","+  TopicArn: \"arn:aws:sns:us-east-1:222222222222:topic-b\",","+  Message:","+    \"hello\" +","+    \"\\nMessageId\\nmessage-id-2\" +","+    \"\\nTimestamp\\n2015-10-05T06:40:38.000Z\" +","+    \"\\nTopicArn\\narn:aws:sns:us-east-1:111111111111:topic-a\" +","+    \"\\nType\",","+  Timestamp: \"2015-10-05T06:41:38.000Z\",","+  SignatureVersion: \"2\",","+  SigningCertURL: \"https://localhost:56789/cert.pem\",","+};","+","+const validCertUrl = \"https://sns.us-east-1.amazonaws.com/cert.pem\";","+","+function buildStringToSign(message: SNSMessage, signableKeys: string[]): string {","+  let stringToSign = \"\";","+  for (const key of signableKeys) {","+    if (key in message) {","+      stringToSign += `${key}\\n${message[key] as string}\\n`;","+    }","+  }","+  return stringToSign;","+}","+","+function sign(message: SNSMessage): void {","+  const algorithm = message.SignatureVersion === \"1\" ? \"RSA-SHA1\" : \"RSA-SHA256\";","+  const signer = createSign(algorithm);","+  const signableKeys = SIGNABLE_KEYS_BY_TYPE[message.Type as \"Notification\"];","+  for (const key of signableKeys) {","+    if (key in message) {","+      // Match Lambda: a null Subject is not signed.","+      if (key === \"Subject\" && message[key] === null) {","+        continue;","+      }","+      signer.update(`${key}\\n${message[key] as string}\\n`, \"utf8\");","+    }","+  }","+  message.Signature = signer.sign(privateKey, \"base64\");","+}","+","+const fetcher = () => Promise.resolve(certPem);","+","+function validator(hostPattern?: RegExp, encoding?: BufferEncoding) {","+  return new MessageValidator(hostPattern ?? /^localhost:56789$/, encoding, fetcher);","+}","+","+beforeAll(() => {","+  const pair = generateKeyPairSync(\"rsa\", { modulusLength: 2048 });","+  privateKey = pair.privateKey;","+  certPem = pair.publicKey.export({ type: \"spki\", format: \"pem\" }) as string;","+","+  for (const message of [","+    validMessage,","+    validSHA256Message,","+    validLambdaMessage,","+    validSubscriptionControlMessage,","+    validUnsubscriptionControlMessage,","+    utf8Message,","+    multilineMessage,","+    delimitedMessage,","+  ]) {","+    sign(message);","+  }","+  // shiftedMessage has the same signed bytes as delimitedMessage.","+  shiftedMessage.Signature = delimitedMessage.Signature;","+});","+","+describe(\"validator interface\", () => {","+  it(\"resolves with the validated message\", async () => {","+    const message = await validator().validate(validMessage);","+    expect(message).toBe(validMessage);","+  });","+","+  it(\"supports the legacy callback form\", () =>","+    new Promise<void>((done, fail) => {","+      validator().validate(validMessage, (err, message) => {","+        try {","+          expect(err).toBeNull();","+          expect(message).toBe(validMessage);","+          done();","+        } catch (e) {","+          fail(e);","+        }","+      });","+    }));","+});","+","+describe(\"message validation\", () => {","+  it(\"rejects hashes without all required keys\", async () => {","+    await expect(new MessageValidator().validate(invalidMessage)).rejects.toThrow(\"Message missing required keys.\");","+  });","+","+  it(\"rejects an unsupported Type with embedded field names\", async () => {","+    expect(buildStringToSign(delimitedMessage, SIGNABLE_KEYS_BY_TYPE.Notification)).toEqual(","+      buildStringToSign(shiftedMessage, SIGNABLE_KEYS_BY_TYPE.Notification)","+    );","+    await expect(validator().validate(shiftedMessage)).rejects.toThrow(\"The message Type is not supported.\");","+  });","+","+  it('accepts Lambda payloads with improper \"Url\" casing', async () => {","+    const message = await validator().validate(validLambdaMessage);","+    expect(message.Message).toEqual(\"A Lambda message for you!\");","+  });","+","+  it(\"rejects hashes residing on an invalid domain\", async () => {","+    await expect(new MessageValidator().validate(validMessage)).rejects.toThrow(","+      \"The certificate is located on an invalid domain.\"","+    );","+  });","+","+  it.each([","+    \"http://localhost:56789/cert.pem\",","+    \"https://localhost:56789/cert.txt\",","+    \"https://localhost:56789/cert.pem?v=1\",","+    \"https://localhost:56789/cert.pem#v1\",","+    \"https://user@localhost:56789/cert.pem\",","+    \"https://user:pass@localhost:56789/cert.pem\",","+  ])(\"rejects the certificate URL %s\", async (SigningCertURL) => {","+    await expect(validator().validate({ ...validMessage, SigningCertURL })).rejects.toThrow(","+      \"The certificate is located on an invalid domain.\"","+    );","+  });","+","+  describe(\"default host pattern\", () => {","+    it.each([","+      \"sns.us-east-1.amazonaws.com\",","+      \"sns.ap-southeast-7.amazonaws.com\",","+      \"sns.mx-central-1.amazonaws.com\",","+      \"sns.us-gov-west-1.amazonaws.com\",","+      \"sns.cn-north-1.amazonaws.com.cn\",","+    ])(\"matches %s\", (host) => {","+      expect(DEFAULT_HOST_PATTERN.test(host)).toBe(true);","+    });","+","+    it.each([","+      \"sns.amazonaws.com\",","+      \"sns.us-east.amazonaws.com\",","+      \"sns.foo-bar.amazonaws.com\",","+      \"sns.us-east-1.amazonaws.com.cn\",","+      \"sns.cn-north-1.amazonaws.com\",","+    ])(\"does not match %s\", (host) => {","+      expect(DEFAULT_HOST_PATTERN.test(host)).toBe(false);","+    });","+  });","+","+  describe(\"certificate URL parser differential\", () => {","+    // The host that is validated must be the host that is fetched.","+    const dot = \"sns.us-east-1.amazonaws.com\";","+    it.each([","+      [\"percent-encoded dot\", `https://${dot}%2eattacker.example/cert.pem`],","+      [\"uppercase percent-encoded dot\", `https://${dot}%2Eattacker.example/cert.pem`],","+      [\"ideographic full stop\", `https://${dot}%E3%80%82attacker.example/cert.pem`],","+      [\"cn percent-encoded dot\", \"https://sns.cn-north-1.amazonaws.com.cn%2eattacker.example/cert.pem\"],","+      [\"percent-encoded at sign\", `https://${dot}%40attacker.example/cert.pem`],","+      [\"double-encoded dot\", `https://${dot}%252eattacker.example/cert.pem`],","+      [\"backslash authority\", `https://attacker.example\\\\@${dot}/cert.pem`],","+    ])(\"rejects %s without fetching\", async (_name, SigningCertURL) => {","+      const spy = vi.fn(fetcher);","+      await expect(","+        new MessageValidator(undefined, undefined, spy).validate({ ...validMessage, SigningCertURL })","+      ).rejects.toThrow(\"The certificate is located on an invalid domain.\");","+      expect(spy).not.toHaveBeenCalled();","+    });","+","+    it(\"rejects a non-string SigningCertURL\", async () => {","+      const spy = vi.fn(fetcher);","+      await expect(","+        new MessageValidator(undefined, undefined, spy).validate({","+          ...validMessage,","+          SigningCertURL: 12345 as unknown as string,","+        })","+      ).rejects.toThrow(\"The certificate is located on an invalid domain.\");","+      expect(spy).not.toHaveBeenCalled();","+    });","+  });","+","+  it(\"rejects hashes with an invalid signature type\", async () => {","+    await expect(","+      new MessageValidator(undefined, undefined, fetcher).validate({","+        ...validMessage,","+        SignatureVersion: \"3\",","+        SigningCertURL: validCertUrl,","+      })","+    ).rejects.toThrow(\"The signature version 3 is not supported.\");","+  });","+","+  it(\"verifies the signature of well-structured messages\", async () => {","+    await expect(","+      validator().validate({","+        ...validMessage,","+        Signature: Buffer.from(\"NOT A VALID SIGNATURE\").toString(\"base64\"),","+      })","+    ).rejects.toThrow(\"The message signature is invalid.\");","+  });","+","+  it(\"accepts a valid SignatureVersion 1 message\", async () => {","+    await expect(validator().validate(validMessage)).resolves.toBeDefined();","+  });","+","+  it(\"accepts a valid SignatureVersion 2 message\", async () => {","+    await expect(validator().validate(validSHA256Message)).resolves.toBeDefined();","+  });","+","+  it(\"ignores subscription fields on notifications\", async () => {","+    await expect(","+      validator().validate({ ...validMessage, SubscribeURL: \"https://www.amazonaws.com\", Token: \"not-signed\" })","+    ).resolves.toBeDefined();","+  });","+","+  it(\"allows newlines in message and subject\", async () => {","+    await expect(validator().validate(multilineMessage)).resolves.toBeDefined();","+  });","+","+  it(\"accepts valid messages as JSON strings\", async () => {","+    await expect(validator().validate(JSON.stringify(validMessage))).resolves.toBeDefined();","+  });","+","+  it(\"rejects invalid JSON strings\", async () => {","+    await expect(validator().validate(\"{not json\")).rejects.toThrow(\"Unexpected error while parsing the message.\");","+  });","+","+  it.each([\"null\", \"42\", \"true\", '\"str\"', \"[]\"])(\"rejects non-object JSON %s\", async (json) => {","+    await expect(validator().validate(json)).rejects.toThrow(\"The message must be a JSON object.\");","+  });","+","+  it(\"rejects a non-object message passed directly\", async () => {","+    await expect(validator().validate(null as unknown as SNSMessage)).rejects.toThrow(","+      \"The message must be a JSON object.\"","+    );","+  });","+","+  it.each([","+    [\"Message\", { nested: true }],","+    [\"MessageId\", 1],","+    [\"Subject\", 5],","+    [\"Timestamp\", [\"2015-10-05T06:41:38.000Z\"]],","+    [\"TopicArn\", false],","+  ])(\"rejects a non-string signed field %s\", async (field, value) => {","+    await expect(validator().validate({ ...validMessage, [field]: value })).rejects.toThrow(","+      `The message field \"${field}\" must be a string.`","+    );","+  });","+});","+","+describe(\"certificate timeout\", () => {","+  it(\"passes the default timeout to the certificate fetcher\", async () => {","+    const spy = vi.fn(fetcher);","+    await new MessageValidator(/^localhost:56789$/, undefined, spy).validate(validMessage);","+    expect(spy).toHaveBeenCalledWith(validMessage.SigningCertURL, 10_000);","+  });","+","+  it(\"passes a configured timeout to the certificate fetcher\", async () => {","+    const spy = vi.fn(fetcher);","+    await new MessageValidator(","+      { hostPattern: /^localhost:56789$/, certificateTimeoutMs: 250 },","+      undefined,","+      spy","+    ).validate(validMessage);","+    expect(spy).toHaveBeenCalledWith(validMessage.SigningCertURL, 250);","+  });","+});","+","+describe(\"subscription control message validation\", () => {","+  it(\"rejects subscribe hashes without additional keys\", async () => {","+    await expect(validator().validate({ ...validMessage, Type: \"SubscriptionConfirmation\" })).rejects.toThrow(","+      \"Message missing required keys.\"","+    );","+  });","+","+  it(\"accepts a valid subscription control message\", async () => {","+    await expect(validator().validate(validSubscriptionControlMessage)).resolves.toBeDefined();","+  });","+","+  it(\"accepts a valid unsubscribe control message\", async () => {","+    await expect(validator().validate(validUnsubscriptionControlMessage)).resolves.toBeDefined();","+  });","+","+  it(\"ignores subject fields on subscription messages\", async () => {","+    await expect(","+      validator().validate({ ...validSubscriptionControlMessage, Subject: \"not-signed\" })","+    ).resolves.toBeDefined();","+  });","+","+  it.each([","+    [\"MessageId\", \"value\\ninjection\"],","+    [\"Timestamp\", \"value\\rinjection\"],","+    [\"TopicArn\", \"value\\ninjection\"],","+  ])(\"rejects newlines in %s\", async (field, value) => {","+    await expect(validator().validate({ ...validMessage, [field]: value })).rejects.toThrow(","+      `The message field \"${field}\" must not contain newlines.`","+    );","+  });","+","+  it.each([","+    [\"SubscribeURL\", \"value\\ninjection\"],","+    [\"Token\", \"value\\rinjection\"],","+  ])(\"rejects newlines in %s\", async (field, value) => {","+    await expect(validator().validate({ ...validSubscriptionControlMessage, [field]: value })).rejects.toThrow(","+      `The message field \"${field}\" must not contain newlines.`","+    );","+  });","+});","+","+describe(\"UTF8 message validation\", () => {","+  it(\"accepts a valid UTF8 message\", async () => {","+    await expect(validator(/^localhost:56789$/, \"utf8\").validate(utf8Message)).resolves.toBeDefined();","+  });","+","+  it(\"honors the legacy mutable .encoding property\", async () => {","+    const v = validator();","+    v.encoding = \"utf8\";","+    await expect(v.validate(utf8Message)).resolves.toBeDefined();","+  });","+});","+","+describe(\"invalid signing cert\", () => {","+  it(\"surfaces errors thrown during verification\", async () => {","+    const badFetcher = () => Promise.resolve(\"not a real certificate\");","+    await expect(new MessageValidator(/^localhost:56789$/, \"utf8\", badFetcher).validate(utf8Message)).rejects.toThrow(","+      \"Unexpected error while verifying the message signature.\"","+    );","+  });","+","+  it(\"surfaces certificate retrieval failures\", async () => {","+    const failing = vi.fn(() => Promise.reject(new Error(\"Certificate could not be retrieved\")));","+    await expect(new MessageValidator(/^localhost:56789$/, \"utf8\", failing).validate(validMessage)).rejects.toThrow(","+      \"Certificate could not be retrieved\"","+    );","+  });","+});"],"additions":413,"deletions":0,"truncated":false},{"path":"lib/lib-sns/src/MessageValidator.ts","lines":["@@ -0,0 +1,230 @@","+import { createVerify } from \"node:crypto\";","+","+import { CertificateCache, type CertificateFetcher } from \"./certificate\";","+import {","+  DEFAULT_CERTIFICATE_TIMEOUT_MS,","+  DEFAULT_ENCODING,","+  DEFAULT_HOST_PATTERN,","+  LAMBDA_MESSAGE_KEYS,","+  REQUIRED_KEYS,","+  SIGNABLE_KEYS_BY_TYPE,","+  SUPPORTED_MESSAGE_TYPES,","+} from \"./constants\";","+import { SNSValidationError } from \"./errors\";","+import type { MessageValidatorOptions, SNSMessage, SNSMessageType, ValidationCallback } from \"./types\";","+","+/**","+ * Validates that an inbound HTTP(S) POST is a genuine Amazon SNS message by","+ * checking its signature against the signing certificate SNS advertises.","+ *","+ * Node-only: signature verification relies on `node:crypto`.","+ *","+ * @example","+ * ```typescript","+ * const validator = new MessageValidator();","+ * const message = await validator.validate(JSON.parse(body));","+ * ```","+ *","+ * @public","+ */","+export class MessageValidator {","+  /** Encoding of the signed message fields. Settable for legacy compatibility. */","+  public encoding: BufferEncoding;","+","+  private readonly _hostPattern: RegExp;","+  private readonly _certificates: CertificateCache;","+","+  /**","+   * @param options - Host pattern, encoding, and (internal) certificate fetcher.","+   *   A `RegExp` is also accepted for drop-in compatibility with the","+   *   legacy `sns-validator` constructor.","+   */","+  public constructor(","+    options: MessageValidatorOptions | RegExp = {},","+    encoding?: BufferEncoding,","+    certificateFetcher?: CertificateFetcher","+  ) {","+    const opts: MessageValidatorOptions = options instanceof RegExp ? { hostPattern: options, encoding } : options;","+","+    this._hostPattern = opts.hostPattern ?? DEFAULT_HOST_PATTERN;","+    this.encoding = opts.encoding ?? encoding ?? DEFAULT_ENCODING;","+    this._certificates = new CertificateCache(","+      certificateFetcher,","+      opts.certificateTimeoutMs ?? DEFAULT_CERTIFICATE_TIMEOUT_MS","+    );","+  }","+","+  /**","+   * Validates a message's signature.","+   *","+   * Pass a `cb` for the legacy Node-callback form. Omit it to get a Promise","+   * that resolves with the validated message or rejects with the reason.","+   *","+   * @param hash - The SNS message, either a parsed object or a raw JSON string.","+   * @param cb - Optional Node-style callback.","+   */","+  public validate(hash: SNSMessage | string): Promise<SNSMessage>;","+  public validate(hash: SNSMessage | string, cb: ValidationCallback): void;","+  public validate(hash: SNSMessage | string, cb?: ValidationCallback): Promise<SNSMessage> | void {","+    const promise = this._validate(hash);","+    if (!cb) {","+      return promise;","+    }","+    promise.then(","+      (message) => cb(null, message),","+      (error) => cb(error as Error)","+    );","+  }","+","+  private async _validate(hash: SNSMessage | string): Promise<SNSMessage> {","+    let message: SNSMessage;","+    if (typeof hash === \"string\") {","+      try {","+        message = JSON.parse(hash) as SNSMessage;","+      } catch (e) {","+        throw new SNSValidationError(\"Unexpected error while parsing the message.\", { cause: e });","+      }","+    } else {","+      message = hash;","+    }","+","+    if (typeof message !== \"object\" || message === null || Array.isArray(message)) {","+      throw new SNSValidationError(\"The message must be a JSON object.\");","+    }","+","+    message = convertLambdaMessage(message);","+","+    if (!(\"Type\" in message)) {","+      throw new SNSValidationError(\"Message missing required keys.\");","+    }","+","+    if (!SUPPORTED_MESSAGE_TYPES.includes(message.Type as SNSMessageType)) {","+      throw new SNSValidationError(\"The message Type is not supported.\");","+    }","+","+    if (!validateMessageStructure(message)) {","+      throw new SNSValidationError(\"Message missing required keys.\");","+    }","+","+    const nonStringField = findNonStringSignedValue(message);","+    if (nonStringField !== null) {","+      throw new SNSValidationError(`The message field \"${nonStringField}\" must be a string.`);","+    }","+","+    const fieldWithNewline = validateSignedValues(message);","+    if (fieldWithNewline !== null) {","+      throw new SNSValidationError(`The message field \"${fieldWithNewline}\" must not contain newlines.`);","+    }","+","+    if (!validateUrl(message.SigningCertURL, this._hostPattern)) {","+      throw new SNSValidationError(\"The certificate is located on an invalid domain.\");","+    }","+","+    await this._validateSignature(message);","+    return message;","+  }","+","+  private async _validateSignature(message: SNSMessage): Promise<void> {","+    const signatureVersion = message.SignatureVersion;","+    if (signatureVersion !== \"1\" && signatureVersion !== \"2\") {","+      throw new SNSValidationError(`The signature version ${signatureVersion} is not supported.`);","+    }","+","+    const algorithm = signatureVersion === \"1\" ? \"RSA-SHA1\" : \"RSA-SHA256\";","+    const verifier = createVerify(algorithm);","+    const signableKeys = SIGNABLE_KEYS_BY_TYPE[message.Type as SNSMessageType];","+    for (const key of signableKeys) {","+      if (key in message) {","+        verifier.update(`${key}\\n${message[key] as string}\\n`, this.encoding);","+      }","+    }","+","+    const certificate = await this._certificates.get(message.SigningCertURL!);","+    let verified: boolean;","+    try {","+      verified = verifier.verify(certificate, message.Signature!, \"base64\");","+    } catch (e) {","+      throw new SNSValidationError(\"Unexpected error while verifying the message signature.\", { cause: e });","+    }","+    if (!verified) {","+      throw new SNSValidationError(\"The message signature is invalid.\");","+    }","+  }","+}","+","+/**","+ * Rewrites Lambda's lowercase \"Url\" field names to the canonical \"URL\" names,","+ * and drops a null Subject so it is not treated as present.","+ */","+function convertLambdaMessage(message: SNSMessage): SNSMessage {","+  for (const key of Object.keys(LAMBDA_MESSAGE_KEYS)) {","+    if (key in message) {","+      message[LAMBDA_MESSAGE_KEYS[key]] = message[key];","+    }","+  }","+  if (\"Subject\" in message && message.Subject === null) {","+    delete message.Subject;","+  }","+  return message;","+}","+","+function validateMessageStructure(message: SNSMessage): boolean {","+  for (const key of REQUIRED_KEYS) {","+    if (!(key in message)) {","+      return false;","+    }","+  }","+  const signableKeys = SIGNABLE_KEYS_BY_TYPE[message.Type as SNSMessageType];","+  for (const key of signableKeys) {","+    // Subject is optional on notifications.","+    if (key !== \"Subject\" && !(key in message)) {","+      return false;","+    }","+  }","+  return true;","+}","+","+/**","+ * Returns the first signed field (other than Message/Subject) containing a","+ * newline, or null. SNS does not allow newlines in these fields.","+ */","+function validateSignedValues(message: SNSMessage): string | null {","+  const signableKeys = SIGNABLE_KEYS_BY_TYPE[message.Type as SNSMessageType];","+  for (const key of signableKeys) {","+    if (key in message && key !== \"Message\" && key !== \"Subject\" && /[\\r\\n]/.test(message[key] as string)) {","+      return key;","+    }","+  }","+  return null;","+}","+","+function findNonStringSignedValue(message: SNSMessage): string | null {","+  const signableKeys = SIGNABLE_KEYS_BY_TYPE[message.Type as SNSMessageType];","+  for (const key of signableKeys) {","+    if (key in message && typeof message[key] !== \"string\") {","+      return key;","+    }","+  }","+  return null;","+}","+","+function validateUrl(urlToValidate: string | undefined, hostPattern: RegExp): boolean {","+  if (!urlToValidate) {","+    return false;","+  }","+  let parsed: URL;","+  try {","+    parsed = new URL(urlToValidate);","+  } catch {","+    return false;","+  }","+  return (","+    parsed.protocol === \"https:\" &&","+    !parsed.username &&","+    !parsed.password &&","+    !parsed.search &&","+    !parsed.hash &&","+    parsed.pathname.endsWith(\".pem\") &&","+    hostPattern.test(parsed.host)","+  );","+}"],"additions":230,"deletions":0,"truncated":false},{"path":"lib/lib-sns/src/certificate.spec.ts","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":858,"deletions":0,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-24T20:28:55.154891+00:00"}