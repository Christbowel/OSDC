{"id":"040043f9077638addd42aea9376349010b14ee25","axis":"silent","repo":"pnpm/pnpm","sha":"040043f9077638addd42aea9376349010b14ee25","parsed":{"files":[{"path":".changeset/nested-directory-dependency-freshness.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/lockfile.verification\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm install` now resolves a local directory again after its `package.json` changes when an override or a package extension adds it to the dependencies of a registry package. `pnpm install --frozen-lockfile` fails on a lockfile that still records the old dependencies of such a directory [#17486](https://github.com/pnpm/pnpm/issues/17486)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install.rs","lines":["@@ -1492,3 +1492,148 @@ fn assert_repeat_install_sees_a_changed_injected_directory(","     assert_eq!(recorded, \"100.1.0\", \"the install resolved the edited directory again\");","     install(&[\"--frozen-lockfile\"]);"," }","+","+/// A directory that an override or a package extension gives a registry","+/// package hangs beneath that package, where no importer's walk of its","+/// directory dependencies reaches it. After an edit to it, a frozen install","+/// rejects the lockfile and an install resolves it again","+/// ([pnpm/pnpm#17486](https://github.com/pnpm/pnpm/issues/17486)).","+#[test]","+fn an_edited_injected_directory_beneath_a_registry_package_is_resolved_again() {","+    let declarations = [","+        \"overrides:\\n  '@pnpm.e2e/pkg-with-1-dep>@pnpm.e2e/dep-of-pkg-with-1-dep': workspace:../lib\\n\",","+        \"packageExtensions:\\n  '@pnpm.e2e/pkg-with-1-dep':\\n    dependencies:\\n      lib: workspace:../lib\\n\",","+    ];","+    for declaration in declarations {","+        let fixture = _utils::WorkspaceFixture::new();","+        fixture.append_workspace_yaml(&format!(\"injectWorkspacePackages: true\\n{declaration}\"));","+        let outside = fixture.workspace","+            .parent()","+            .expect(\"the workspace has a parent\")","+            .join(\"lib\");","+        fs::create_dir_all(&outside).expect(\"create the directory outside the workspace\");","+        fs::write(","+            outside.join(\"package.json\"),","+            r#\"{ \"name\": \"lib\", \"version\": \"1.0.0\", \"dependencies\": { \"@pnpm.e2e/foo\": \"100.0.0\" } }\"#,","+        )","+        .expect(\"write the manifest\");","+        fixture.write_root_manifest(","+            \"app\",","+            _utils::ManifestDeps {","+                prod: &[(\"@pnpm.e2e/pkg-with-1-dep\", \"100.0.0\")],","+                .._utils::ManifestDeps::default()","+            },","+        );","+        let install = |args: &[&str]| {","+            fixture.command_at(&fixture.workspace, std::iter::once(&\"install\").chain(args))","+        };","+        _utils::assert_success(&install(&[]));","+","+        _utils::set_dependency(&outside, \"dependencies\", \"@pnpm.e2e/foo\", \"100.1.0\");","+        let frozen = install(&[\"--frozen-lockfile\"]);","+        let stderr = String::from_utf8_lossy(&frozen.stderr);","+        assert!(","+            !frozen.status.success() && stderr.contains(\"ERR_PNPM_OUTDATED_LOCKFILE\"),","+            \"{declaration}: the frozen install must reject the stale lockfile: {stderr}\",","+        );","+        _utils::assert_success(&install(&[]));","+","+        let lockfile = _utils::read_lockfile(&fixture.workspace.join(\"pnpm-lock.yaml\"));","+        let key: pnpm_lockfile::PackageKey =","+            \"lib@file:../lib\".parse().expect(\"parse the package key\");","+        let snapshot = &lockfile.snapshots.as_ref().expect(\"the lockfile has snapshots\")[&key];","+        let child: pnpm_lockfile::PkgName = \"@pnpm.e2e/foo\".parse().expect(\"parse the name\");","+        let recorded = snapshot.dependencies.as_ref().expect(\"lib's dependencies are recorded\")","+            [&child]","+            .to_string();","+        assert_eq!(recorded, \"100.1.0\", \"{declaration}: the install resolved the edited directory\");","+        _utils::assert_success(&install(&[\"--frozen-lockfile\"]));","+    }","+}","+","+/// An install with `optional: false` leaves out a directory reached only","+/// through an optional edge, so an edit to it does not make that frozen","+/// install reject the lockfile.","+#[test]","+fn an_edited_directory_beneath_an_excluded_optional_dependency_passes_frozen_install() {","+    let fixture = _utils::WorkspaceFixture::new();","+    fixture.append_workspace_yaml(","+        \"injectWorkspacePackages: true\\noverrides:\\n  \\","+         '@pnpm.e2e/pkg-with-1-dep>@pnpm.e2e/dep-of-pkg-with-1-dep': workspace:../lib\\n\",","+    );","+    let outside = fixture.workspace","+        .parent()","+        .expect(\"the workspace has a parent\")","+        .join(\"lib\");","+    fs::create_dir_all(&outside).expect(\"create the directory outside the workspace\");","+    fs::write(","+        outside.join(\"package.json\"),","+        r#\"{ \"name\": \"lib\", \"version\": \"1.0.0\", \"dependencies\": { \"@pnpm.e2e/foo\": \"100.0.0\" } }\"#,","+    )","+    .expect(\"write the manifest\");","+    fixture.write_root_manifest(","+        \"app\",","+        _utils::ManifestDeps {","+            optional: &[(\"@pnpm.e2e/pkg-with-1-dep\", \"100.0.0\")],","+            .._utils::ManifestDeps::default()","+        },","+    );","+    let install = |args: &[&str]| {","+        fixture.command_at(&fixture.workspace, std::iter::once(&\"install\").chain(args))","+    };","+    _utils::assert_success(&install(&[]));","+","+    _utils::set_dependency(&outside, \"dependencies\", \"@pnpm.e2e/foo\", \"100.1.0\");","+    fixture.append_workspace_yaml(\"optional: false\\n\");","+    _utils::assert_success(&install(&[\"--frozen-lockfile\"]));","+}","+","+/// A workspace project that publishes from `dist` reads differently through","+/// `file:` (its `dist/package.json`) and `workspace:` (the project","+/// manifest). The lockfile does not record which one the override used, so","+/// an edit to `dist/package.json` alone makes the frozen install reject the","+/// lockfile.","+#[test]","+fn an_edited_publish_directory_beneath_a_registry_package_fails_frozen_install() {","+    let fixture = _utils::WorkspaceFixture::new();","+    fixture.append_workspace_yaml(","+        \"overrides:\\n  \\","+         '@pnpm.e2e/pkg-with-1-dep>@pnpm.e2e/dep-of-pkg-with-1-dep': file:./packages/lib/dist\\n\",","+    );","+    let lib = fixture.workspace.join(\"packages/lib\");","+    let manifest = |foo_version: &str| {","+        format!(","+            r#\"{{ \"name\": \"lib\", \"version\": \"1.0.0\", \"dependencies\": {{ \"@pnpm.e2e/foo\": \"{foo_version}\" }}, \"publishConfig\": {{ \"directory\": \"dist\" }} }}\"#,","+        )","+    };","+    fs::create_dir_all(lib.join(\"dist\")).expect(\"create the publish directory\");","+    fs::write(lib.join(\"package.json\"), manifest(\"100.0.0\")).expect(\"write the project manifest\");","+    fs::write(lib.join(\"dist/package.json\"), manifest(\"100.0.0\"))","+        .expect(\"write the published manifest\");","+    fixture.write_root_manifest(","+        \"app\",","+        _utils::ManifestDeps {","+            prod: &[(\"@pnpm.e2e/pkg-with-1-dep\", \"100.0.0\")],","+            .._utils::ManifestDeps::default()","+        },","+    );","+    let install = |args: &[&str]| {","+        fixture.command_at(&fixture.workspace, std::iter::once(&\"install\").chain(args))","+    };","+    _utils::assert_success(&install(&[]));","+    let lockfile =","+        fs::read_to_string(fixture.workspace.join(\"pnpm-lock.yaml\")).expect(\"read the lockfile\");","+    assert!(","+        lockfile.contains(\"lib@file:packages/lib/dist\"),","+        \"lib is beneath the registry package:\\n{lockfile}\",","+    );","+","+    fs::write(lib.join(\"dist/package.json\"), manifest(\"100.1.0\"))","+        .expect(\"edit the published manifest\");","+    let frozen = install(&[\"--frozen-lockfile\"]);","+    let stderr = String::from_utf8_lossy(&frozen.stderr);","+    assert!(","+        !frozen.status.success() && stderr.contains(\"ERR_PNPM_OUTDATED_LOCKFILE\"),","+        \"the frozen install must reject the stale lockfile: {stderr}\",","+    );","+}"],"additions":145,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness.rs","lines":["@@ -2,8 +2,8 @@ pub(super) mod directory_deps;"," pub(super) mod error;"," pub(super) mod manifest;"," pub(crate) use directory_deps::{","-    ProjectManifestsByDir, dependency_manifests_by_dir, is_declared_local_directory,","-    project_manifests_by_dir, spec_target_and_range,","+    NestedDirectoryPackage, ProjectManifestsByDir, dependency_manifests_by_dir,","+    is_declared_local_directory, project_manifests_by_dir, spec_target_and_range,"," };"," pub(crate) use directory_manifests::DirectoryManifests;"," pub(crate) use error::FreshnessCheckError;","@@ -388,16 +388,26 @@ pub(super) async fn check_lockfile_freshness(","         }));","     }"," ","+    let edges = directory_deps::GraphEdges::installed(inputs.config.optional);","+    let nested = directory_deps::nested_directory_packages(lockfile, edges);","+    let checked: std::collections::HashSet<&str> = inputs.manifests","+        .iter()","+        .map(|(id, _)| id.as_str())","+        .collect();","+    let nested = directory_deps::NestedByImporter::assign(&nested, |importer_id| {","+        checked.contains(importer_id)","+    });","     let directory_manifests = directory_manifests::hooked_directory_manifests(","         lockfile,","         inputs,","-        parsed_overrides_opt.as_deref(),","+        (parsed_overrides_opt.as_deref(), &nested),","     )","     .await?;","     check_importer_freshness(","         lockfile,","         inputs,","         (parsed_overrides_opt.as_deref(), &directory_manifests),","+        &nested,","     )"," }"," ","@@ -409,6 +419,7 @@ fn check_importer_freshness(","         Option<&[pnpm_config_parse_overrides::VersionOverride]>,","         &DirectoryManifests,","     ),","+    nested: &directory_deps::NestedByImporter<'_>,"," ) -> Result<Vec<UnresolvedOptionalDependency>, FreshnessCheckError> {","     let ignored_optional_matcher = ignored_optional_matcher(inputs.config);","     let mut project_manifests = project_manifests_by_dir(","@@ -441,8 +452,8 @@ fn check_importer_freshness(","                 inputs,","                 parsed_overrides,","                 (&ignored_optional_matcher, workspace),","-                importer_id,","-                manifest,","+                (importer_id, manifest),","+                nested.of(importer_id),","             )","         })","         .collect();","@@ -458,8 +469,8 @@ fn check_single_importer(","     inputs: &LockfileFreshnessInputs<'_, '_>,","     parsed_overrides: Option<&[pnpm_config_parse_overrides::VersionOverride]>,","     (ignored_optional_matcher, workspace): (&pnpm_matcher::Matcher, WorkspaceProjects<'_>),","-    importer_id: &str,","-    manifest: &PackageManifest,","+    (importer_id, manifest): (&str, &PackageManifest),","+    nested: &[&NestedDirectoryPackage],"," ) -> Result<Vec<UnresolvedOptionalDependency>, FreshnessCheckError> {","     if inputs.scope.allow_missing_dependency_free_importers","         && !lockfile.importers.contains_key(importer_id)","@@ -467,7 +478,7 @@ fn check_single_importer(","     {","         return Ok(Vec::new());","     }","-    let skipped = check_importer_satisfies(&ImporterSatisfactionCheck {","+    let check = ImporterSatisfactionCheck {","         lockfile,","         lockfile_dir: inputs.lockfile_dir,","         manifest,","@@ -479,7 +490,11 @@ fn check_single_importer(","             frozen_lockfile: inputs.scope.frozen_lockfile,","         },","         parsed_overrides,","-    })?;","+    };","+    let skipped = check_importer_satisfies(&check)?;","+    for package in nested {","+        directory_deps::check_nested_directory_package(&check, package)?;","+    }","     let prefix = manifest","         .path()","         .parent()"],"additions":24,"deletions":9,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps.rs","lines":["@@ -2,12 +2,17 @@ pub(crate) use importer_deps::check_directory_dependencies_freshness;"," pub use injected_manifest::ProjectManifestsByDir;"," pub(super) use injected_manifest::{InjectedDirectory, is_deploy_file_url_key, unhooked_manifest};"," pub(crate) use injected_manifest::{dependency_manifests_by_dir, project_manifests_by_dir};","+pub(crate) use nested::{","+    GraphEdges, NestedByImporter, NestedDirectoryPackage, check_nested_directory_package,","+    nested_directory_packages,","+};"," pub(super) use package::overridden_unhooked_manifest;"," pub(crate) use spec::spec_target_and_range;"," "," mod children;"," mod importer_deps;"," mod injected_manifest;","+mod nested;"," mod package;"," mod peers;"," mod scope;","@@ -18,6 +23,7 @@ mod tests;"," "," use super::manifest::ImporterSatisfactionCheck;"," use crate::install::lockfile_freshness::FreshnessCheckError;","+use injected_manifest::is_deploy_file_url;"," use pnpm_catalogs_types::Catalogs;"," use pnpm_lockfile::StalenessReason;"," use spec::SpecDirs;"],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/injected_manifest.rs","lines":["@@ -272,10 +272,19 @@ pub(in crate::install::lockfile_freshness) fn is_deploy_file_url_key(","     directory: &str,"," ) -> bool {","     matches!(dep_spec.version, pnpm_lockfile::ImporterDepVersion::Alias(_))","-        && matches!(","-            key.suffix.version(),","-            pnpm_lockfile::VersionPart::File(path)","-                if !pnpm_lockfile::is_local_tarball_path(path)","-                    && (path.starts_with(\"///\") || (path.starts_with(\"//\") && path != directory)),","-        )","+        && is_deploy_file_url(key, directory)","+}","+","+/// The key half of [`is_deploy_file_url_key`], for a directory package whose","+/// parent is a package, which records it by key alone.","+pub(in crate::install::lockfile_freshness) fn is_deploy_file_url(","+    key: &pnpm_lockfile::PackageKey,","+    directory: &str,","+) -> bool {","+    matches!(","+        key.suffix.version(),","+        pnpm_lockfile::VersionPart::File(path)","+            if !pnpm_lockfile::is_local_tarball_path(path)","+                && (path.starts_with(\"///\") || (path.starts_with(\"//\") && path != directory)),","+    )"," }"],"additions":15,"deletions":6,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/nested.rs","lines":["@@ -0,0 +1,368 @@","+//! The directory packages a package that is not a directory depends on, such","+//! as a directory an override or a package extension gives a registry","+//! package. An importer's walk descends through directory packages only, so","+//! it never reaches them.","+","+use super::{","+    FreshnessCheckError, ImporterSatisfactionCheck, LocalDepContext, is_deploy_file_url,","+    package::check_single_directory_dep_freshness,","+    scope::{AliasScope, Visited, importer_aliases, snapshot_aliases},","+    spec_dirs,","+};","+use pnpm_lockfile::{","+    Lockfile, LockfileResolution, PackageKey, PkgName, SnapshotDepRef, SnapshotEntry,","+};","+use pnpm_package_manifest::DependencyGroup;","+use std::collections::{HashMap, HashSet};","+","+/// A directory package beneath a package that is not one.","+pub(crate) struct NestedDirectoryPackage {","+    /// The alias a parent depends on it by.","+    pub(in crate::install::lockfile_freshness) alias: String,","+    pub(in crate::install::lockfile_freshness) key: PackageKey,","+    pub(in crate::install::lockfile_freshness) directory: String,","+    /// The aliases of every package above it, which supply its peers with","+    /// the aliases of the importer checking it. Ancestors on different paths","+    /// add up, which only widens the peers the check takes as supplied.","+    ancestor_aliases: AliasScope,","+    /// The importers that reach it.","+    pub(in crate::install::lockfile_freshness) importers: HashSet<String>,","+}","+","+/// Which dependency edges a walk of the lockfile graph follows. An install","+/// without optional dependencies leaves the `optionalDependencies` edges out.","+#[derive(Clone, Copy)]","+pub(crate) enum GraphEdges {","+    All,","+    Required,","+}","+","+impl GraphEdges {","+    pub(crate) fn installed(optional_included: bool) -> Self {","+        if optional_included { GraphEdges::All } else { GraphEdges::Required }","+    }","+}","+","+/// Every [`NestedDirectoryPackage`] in `lockfile` along `edges`.","+pub(crate) fn nested_directory_packages(","+    lockfile: &Lockfile,","+    edges: GraphEdges,","+) -> Vec<NestedDirectoryPackage> {","+    let nested = nested_directory_entries(lockfile, edges);","+    let Some(snapshots) = lockfile.snapshots","+        .as_ref()","+        .filter(|_| !nested.is_empty())","+    else {","+        return Vec::new();","+    };","+    let graph = ReverseGraph::of(lockfile, snapshots, edges);","+    nested","+        .into_iter()","+        .map(|(key, entry)| {","+            let (ancestor_aliases, importers) = graph.ancestors(&key);","+            NestedDirectoryPackage {","+                alias: entry.alias,","+                key,","+                directory: entry.directory.to_string(),","+                ancestor_aliases,","+                importers,","+            }","+        })","+        .collect()","+}","+","+/// A nested directory package as the lockfile's edges reach it.","+struct NestedEntry<'a> {","+    /// The alias a parent depends on it by.","+    alias: String,","+    directory: &'a str,","+}","+","+/// Every nested directory package in `lockfile` along `edges`. Empty,","+/// without reading any snapshot, when the lockfile has no directory package.","+fn nested_directory_entries(","+    lockfile: &Lockfile,","+    edges: GraphEdges,","+) -> HashMap<PackageKey, NestedEntry<'_>> {","+    let (Some(packages), Some(snapshots)) = (&lockfile.packages, &lockfile.snapshots) else {","+        return HashMap::new();","+    };","+    let directories = DirectoryPackages::of(packages);","+    if directories.by_key.is_empty() {","+        return HashMap::new();","+    }","+    snapshots","+        .iter()","+        .filter(|(parent, _)| directories.directory(parent).is_none())","+        .flat_map(|(_, snapshot)| snapshot_dependencies(snapshot, edges))","+        .filter_map(|(alias, child)| {","+            let (key, directory) = directories.nested_child(alias, child)?;","+            Some((key, NestedEntry { alias: alias.to_string(), directory }))","+        })","+        .collect()","+}","+","+/// The nested directory packages each importer's check walks.","+pub(crate) struct NestedByImporter<'n>(HashMap<&'n str, Vec<&'n NestedDirectoryPackage>>);","+","+impl<'n> NestedByImporter<'n> {","+    /// Assigns each of `nested` to the importer with the lowest id among","+    /// those that reach it and that `is_checked` accepts. One that no such","+    /// importer reaches is left out, as its importers are.","+    pub(crate) fn assign(","+        nested: &'n [NestedDirectoryPackage],","+        is_checked: impl Fn(&str) -> bool,","+    ) -> Self {","+        let mut by_importer: HashMap<&str, Vec<_>> = HashMap::new();","+        for package in nested {","+            if let Some(importer_id) = package.importers","+                .iter()","+                .filter(|importer_id| is_checked(importer_id))","+                .min()","+            {","+                by_importer","+                    .entry(importer_id.as_str())","+                    .or_default()","+                    .push(package);","+            }","+        }","+        NestedByImporter(by_importer)","+    }","+","+    pub(crate) fn packages(&self) -> impl Iterator<Item = &'n NestedDirectoryPackage> + '_ {","+        self.0.values().flatten().copied()","+    }","+","+    pub(crate) fn of(&self, importer_id: &str) -> &[&'n NestedDirectoryPackage] {","+        self.0","+            .get(importer_id)","+            .map_or(&[], Vec::as_slice)","+    }","+}","+","+/// The directory packages of a lockfile, by their `packages:` key.","+struct DirectoryPackages<'a> {","+    by_key: HashMap<&'a PackageKey, &'a str>,","+    names: HashSet<&'a PkgName>,","+}","+","+impl<'a> DirectoryPackages<'a> {","+    fn of(packages: &'a HashMap<PackageKey, pnpm_lockfile::PackageMetadata>) -> Self {","+        let by_key: HashMap<&PackageKey, &str> = packages","+            .iter()","+            .filter_map(|(key, metadata)| match &metadata.resolution {","+                LockfileResolution::Directory(resolution) => {","+                    Some((key, resolution.directory.as_str()))","+                }","+                _ => None,","+            })","+            .collect();","+        let names = by_key","+            .keys()","+            .map(|key| &key.name)","+            .collect();","+        DirectoryPackages { by_key, names }","+    }","+","+    /// The directory of `key`'s package. The name is checked first, so a","+    /// key of another package is not stripped of its peers.","+    fn directory(&self, key: &PackageKey) -> Option<&'a str> {","+        if !self.names.contains(&key.name) {","+            return None;","+        }","+        self.by_key","+            .get(&key.without_peer())","+            .copied()","+    }","+","+    /// The entry of a dependency of a package that is not a directory, when","+    /// it is a directory package other than a `pnpm deploy` one. A deploy","+    /// entry is recognized as [`super::is_deploy_file_url_key`] recognizes","+    /// one: an aliased reference to a `file://` key.","+    fn nested_child(","+        &self,","+        alias: &PkgName,","+        child: &SnapshotDepRef,","+    ) -> Option<(PackageKey, &'a str)> {","+        if !self.names.contains(target_name(alias, child)) {","+            return None;","+        }","+        let key = child.resolve(alias)?;","+        let directory = self","+            .directory(&key)","+            .filter(|directory| {","+                !(matches!(child, SnapshotDepRef::Alias(_)) && is_deploy_file_url(&key, directory))","+            })?;","+        Some((key, directory))","+    }","+}","+","+/// Checks `nested` as the importer walk checks a directory package. The","+/// `file:` and `workspace:` declarations can read different manifests (see","+/// [`super::unhooked_manifest`]), and the lockfile does not record which one","+/// the parent used, so the snapshot must match both. Where they differ, a","+/// lockfile the resolver just wrote fails the check: the price of never","+/// accepting a stale one until the lockfile records the declaration","+/// (pnpm/tasks#228).","+pub(crate) fn check_nested_directory_package(","+    check: &ImporterSatisfactionCheck<'_>,","+    nested: &NestedDirectoryPackage,","+) -> Result<(), FreshnessCheckError> {","+    let Some(pkg_meta) = check.lockfile.packages","+        .as_ref()","+        .and_then(|packages| packages.get(&nested.key.without_peer()))","+    else {","+        return Ok(());","+    };","+    let snapshot = check.lockfile.snapshots","+        .as_ref()","+        .and_then(|snapshots| snapshots.get(&nested.key));","+    let dir = check.lockfile_dir.join(&nested.directory);","+    let mut scope = nested.ancestor_aliases.clone();","+    scope.extend(","+        check.lockfile.importers","+            .get(check.importer_id)","+            .into_iter()","+            .flat_map(importer_aliases),","+    );","+    let visited = Visited::new(check.lockfile);","+    let check_declared = |declared_as_file| {","+        let dep = LocalDepContext {","+            name: &nested.alias,","+            declared_as_file,","+            rel_path: &nested.directory,","+            dir: &dir,","+            dirs: spec_dirs(check),","+            catalogs: check.workspace.catalogs,","+        };","+        check_single_directory_dep_freshness(","+            check,","+            &scope,","+            &dep,","+            (&nested.key, snapshot, pkg_meta),","+            &mut visited.clone(),","+        )","+    };","+    let declared_as_workspace = false;","+    let declared_as_file = true;","+    check_declared(declared_as_workspace).and_then(|()| check_declared(declared_as_file))","+}","+","+fn snapshot_dependencies(","+    snapshot: &SnapshotEntry,","+    edges: GraphEdges,","+) -> impl Iterator<Item = (&PkgName, &SnapshotDepRef)> {","+    let optional = match edges {","+        GraphEdges::All => snapshot.optional_dependencies.as_ref(),","+        GraphEdges::Required => None,","+    };","+    [snapshot.dependencies.as_ref(), optional]","+        .into_iter()","+        .flatten()","+        .flatten()","+}","+","+/// The name of the package `child` resolves to, without building its key.","+fn target_name<'a>(alias: &'a PkgName, child: &'a SnapshotDepRef) -> &'a PkgName {","+    match child {","+        SnapshotDepRef::Alias(key) => &key.name,","+        SnapshotDepRef::Plain(_) | SnapshotDepRef::Link(_) => alias,","+    }","+}","+","+/// Who depends on each snapshot.","+struct ReverseGraph<'a> {","+    snapshots: &'a HashMap<PackageKey, SnapshotEntry>,","+    parents: HashMap<PackageKey, Vec<&'a PackageKey>>,","+    importers: HashMap<PackageKey, Vec<&'a str>>,","+}","+","+impl<'a> ReverseGraph<'a> {","+    fn of(","+        lockfile: &'a Lockfile,","+        snapshots: &'a HashMap<PackageKey, SnapshotEntry>,","+        edges: GraphEdges,","+    ) -> Self {","+        ReverseGraph {","+            snapshots,","+            parents: Self::parents(snapshots, edges),","+            importers: Self::importer_roots(lockfile, edges),","+        }","+    }","+","+    fn parents(","+        snapshots: &'a 