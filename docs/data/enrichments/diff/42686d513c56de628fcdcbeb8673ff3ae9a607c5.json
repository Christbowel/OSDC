{"id":"42686d513c56de628fcdcbeb8673ff3ae9a607c5","axis":"silent","repo":"hashicorp/consul","sha":"42686d513c56de628fcdcbeb8673ff3ae9a607c5","parsed":{"files":[{"path":".changelog/24083.txt","lines":["@@ -0,0 +1,15 @@","+```release-note:bug","+connect: When the mesh `TLSMinVersion` is `TLSv1_3` and `TLSMaxVersion` is unset or `TLS_AUTO`, Consul now sets the Envoy maximum TLS version to TLS 1.3. Previously, Envoy upstream connections defaulted to a TLS 1.2 maximum and every handshake failed with `NO_SUPPORTED_VERSIONS_ENABLED`.","+```","+","+```release-note:bug","+connect: The automatically injected post-quantum key-exchange list for TLS 1.3 is now `X25519MLKEM768, X25519, P-256` for Envoy and agent TLS, so peers that only support P-256 keep working after an upgrade. Explicitly configured `ECDHCurves` and `tls_ecdh_curves` are unchanged.","+```","+","+```release-note:improvement","+connect: Writing a mesh config entry whose new or changed `TLS.Outgoing.ECDHCurves` omits `P-256` while TLS 1.2 can be negotiated is rejected, because service mesh certificates use ECDSA P-256 keys and such handshakes fail with `WRONG_CURVE`. Incoming lists and unchanged stored or bootstrapped entries produce a warning instead.","+```","+","+```release-note:improvement","+connect: Writing `ECDHCurves` in the mesh config entry is rejected while any server in any WAN-federated datacenter runs a version older than 2.1.0. Servers log a warning listing agents in the entry's admin partition that are older than 2.1.0 and ignore the setting, and the leader reports their count in the `consul.mesh.pqc_outdated_agents` gauge.","+```"],"additions":15,"deletions":0,"truncated":false},{"path":"agent/config/builder.go","lines":["@@ -842,6 +842,11 @@ func (b *builder) build() (rt RuntimeConfig, err error) {"," \t\t\tif err := entry.Validate(); err != nil {"," \t\t\t\treturn RuntimeConfig{}, fmt.Errorf(\"config_entries.bootstrap[%d]: %w\", i, err)"," \t\t\t}","+\t\t\tif warnEntry, ok := entry.(structs.WarningConfigEntry); ok {","+\t\t\t\tfor _, w := range warnEntry.Warnings() {","+\t\t\t\t\tb.warn(\"config_entries.bootstrap[%d]: %s\", i, w)","+\t\t\t\t}","+\t\t\t}"," \t\t\tconfigEntries = append(configEntries, entry)"," \t\t}"," \t}","@@ -2957,7 +2962,7 @@ func (b *builder) buildTLSConfig(rt RuntimeConfig, t TLS) (tlsutil.Config, error"," \t\t\t} else {"," \t\t\t\t// Automatic curve injection: keep behaviour same as connect mesh"," \t\t\t\tif err, isLessThanTLS13 := dst.TLSMinVersion.LessThan(types.TLSv1_3); err == nil && !isLessThanTLS13 {","-\t\t\t\t\tdst.ECDHCurves = types.DefaultConsulAgentPQCECDHCurves","+\t\t\t\t\tdst.ECDHCurves = append([]types.TLSECDHCurve(nil), types.DefaultConsulAgentPQCECDHCurves...)"," \t\t\t\t}"," \t\t\t}"," \t\t} else {"],"additions":6,"deletions":1,"truncated":false},{"path":"agent/config/builder_test.go","lines":["@@ -886,9 +886,14 @@ func TestBuilder_buildTLSConfig_ECDHCurves(t *testing.T) {"," "," \t\tres, err := b.buildTLSConfig(RuntimeConfig{}, cfg)"," \t\trequire.NoError(t, err)","-\t\trequire.Equal(t, types.DefaultConsulAgentPQCECDHCurves, res.InternalRPC.ECDHCurves)","-\t\trequire.Equal(t, types.DefaultConsulAgentPQCECDHCurves, res.GRPC.ECDHCurves)","+\t\tpqcDefaults := []types.TLSECDHCurve{types.CurveX25519MLKEM768, types.CurveX25519, types.CurveP256}","+\t\trequire.Equal(t, pqcDefaults, res.InternalRPC.ECDHCurves)","+\t\trequire.Equal(t, pqcDefaults, res.GRPC.ECDHCurves)"," \t\trequire.Equal(t, []types.TLSECDHCurve{types.CurveP256}, res.HTTPS.ECDHCurves)","+","+\t\t// The injected slice must not alias the package-level default.","+\t\tres.InternalRPC.ECDHCurves[0] = \"mutated\"","+\t\trequire.Equal(t, pqcDefaults, types.DefaultConsulAgentPQCECDHCurves)"," \t})"," "," \tt.Run(\"safe omit curves on legacy override\", func(t *testing.T) {","@@ -1201,3 +1206,40 @@ func TestBuilder_serviceKindVal(t *testing.T) {"," \t\trequire.Equal(t, structs.ServiceKindTypical, b.serviceKindVal(&s))"," \t})"," }","+","+func TestLoad_BootstrapMeshECDHCurvesWithoutP256Warns(t *testing.T) {","+\tdevMode := true","+\tresult, err := Load(LoadOpts{","+\t\tDevMode: &devMode,","+\t\tHCL: []string{`","+config_entries {","+  bootstrap = [","+    {","+      kind = \"mesh\"","+      tls {","+        incoming {","+          tls_min_version = \"TLSv1_2\"","+          ecdh_curves     = [\"X25519MLKEM768\", \"X25519\"]","+        }","+        outgoing {","+          tls_min_version = \"TLSv1_2\"","+          ecdh_curves     = [\"X25519MLKEM768\", \"X25519\"]","+        }","+      }","+    }","+  ]","+}`},","+\t})","+\trequire.NoError(t, err)","+\trequire.Len(t, result.RuntimeConfig.ConfigEntryBootstrap, 1)","+","+\tvar p256Warnings []string","+\tfor _, w := range result.Warnings {","+\t\tif strings.Contains(w, `does not include \"P-256\"`) {","+\t\t\tp256Warnings = append(p256Warnings, w)","+\t\t}","+\t}","+\trequire.Len(t, p256Warnings, 2)","+\trequire.Contains(t, p256Warnings[0], \"config_entries.bootstrap[0]: mesh TLS.Incoming.ECDHCurves\")","+\trequire.Contains(t, p256Warnings[1], \"config_entries.bootstrap[0]: mesh TLS.Outgoing.ECDHCurves\")","+}"],"additions":44,"deletions":2,"truncated":false},{"path":"agent/consul/config_endpoint.go","lines":["@@ -89,6 +89,16 @@ func (c *ConfigEntry) Apply(args *structs.ConfigEntryRequest, reply *bool) error"," \t\treturn nil"," \t}"," ","+\t// Compatibility checks run only for authorized writes that change the","+\t// stored entry, so they neither leak server details nor block no-ops.","+\t_, currentEntry, err := c.srv.fsm.State().ConfigEntry(nil, args.Entry.GetKind(), args.Entry.GetName(), args.Entry.GetEnterpriseMeta())","+\tif err != nil {","+\t\treturn fmt.Errorf(\"error reading current config entry value: %w\", err)","+\t}","+\tif err := c.checkMeshPQCCompatibility(args.Entry, currentEntry); err != nil {","+\t\treturn err","+\t}","+"," \tresp, err := c.srv.raftApply(structs.ConfigEntryRequestType, args)"," \tif err != nil {"," \t\treturn err"],"additions":10,"deletions":0,"truncated":false},{"path":"agent/consul/config_endpoint_mesh_pqc.go","lines":["@@ -0,0 +1,349 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package consul","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"slices\"","+\t\"sort\"","+\t\"strings\"","+\t\"time\"","+","+\t\"github.com/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/go-metrics\"","+\t\"github.com/hashicorp/go-metrics/prometheus\"","+\t\"github.com/hashicorp/go-version\"","+\t\"github.com/hashicorp/serf/serf\"","+","+\t\"github.com/hashicorp/consul/agent/metadata\"","+\t\"github.com/hashicorp/consul/agent/structs\"","+\t\"github.com/hashicorp/consul/types\"","+)","+","+// minMeshPQCVersion is the first Consul release that stores mesh ECDHCurves and","+// renders post-quantum key exchange settings into Envoy configuration.","+// Pre-releases of this version (for example 2.1.0-rc1) are treated as supported.","+var minMeshPQCVersion = version.Must(version.NewVersion(\"2.1.0\"))","+","+// maxReportedOutdatedAgents bounds the number of node names included in the","+// warning logged when agents cannot apply mesh post-quantum settings.","+const maxReportedOutdatedAgents = 10","+","+// meshPQCMetricsInterval is how often the leader refreshes the","+// mesh.pqc_outdated_agents gauge.","+var meshPQCMetricsInterval = time.Minute","+","+const meshPQCMetricsRoutineName = \"mesh PQC metrics\"","+","+var ConfigEntryGauges = []prometheus.GaugeDefinition{","+\t{","+\t\tName: []string{\"mesh\", \"pqc_outdated_agents\"},","+\t\tHelp: \"Number of alive agents older than 2.1.0 in an admin partition whose mesh config entry enables post-quantum key exchange. Those agents ignore the setting until they are upgraded. Reported by the leader.\",","+\t},","+}","+","+func meshPQCVersionSupported(v *version.Version) bool {","+\tif v == nil {","+\t\treturn false","+\t}","+\treturn !v.Core().LessThan(minMeshPQCVersion)","+}","+","+func meshDirectionalTLSConfigs(entry structs.ConfigEntry) []*structs.MeshDirectionalTLSConfig {","+\tmesh, ok := entry.(*structs.MeshConfigEntry)","+\tif !ok || mesh == nil || mesh.TLS == nil {","+\t\treturn nil","+\t}","+\tvar out []*structs.MeshDirectionalTLSConfig","+\tfor _, cfg := range []*structs.MeshDirectionalTLSConfig{mesh.TLS.Incoming, mesh.TLS.Outgoing} {","+\t\tif cfg != nil {","+\t\t\tout = append(out, cfg)","+\t\t}","+\t}","+\treturn out","+}","+","+// meshEntryConfiguresECDHCurves reports whether the entry is a mesh config entry","+// that explicitly sets ECDHCurves in either direction.","+func meshEntryConfiguresECDHCurves(entry structs.ConfigEntry) bool {","+\tfor _, cfg := range meshDirectionalTLSConfigs(entry) {","+\t\tif len(cfg.ECDHCurves) > 0 {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// meshEntryEnablesPQC reports whether the entry results in post-quantum key","+// exchange settings on 2.1.0+ proxies, either through explicit ECDHCurves or","+// through automatic curve injection for a TLSv1_3 minimum.","+func meshEntryEnablesPQC(entry structs.ConfigEntry) bool {","+\tfor _, cfg := range meshDirectionalTLSConfigs(entry) {","+\t\tif len(cfg.ECDHCurves) > 0 || cfg.TLSMinVersion == types.TLSv1_3 {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// serversSupportMeshECDHCurves returns an error when any alive or failed server","+// in the given datacenters runs a release that does not know about","+// ECDHCurves. Older servers silently drop the field, including when the entry","+// is replicated to secondary datacenters, so a write accepted during a","+// mixed-version window could be lost or diverge between servers. Failed","+// servers count because they can rejoin with the old version.","+func serversSupportMeshECDHCurves(provider checkServersProvider, datacenters []string) error {","+\tvar alive, failed []string","+\tfor _, dc := range datacenters {","+\t\tServersInDCMeetRequirements(provider, dc, func(srv *metadata.Server) (bool, bool) {","+\t\t\tif srv.Status != serf.StatusAlive && srv.Status != serf.StatusFailed {","+\t\t\t\treturn true, true","+\t\t\t}","+\t\t\tif meshPQCVersionSupported(&srv.Build) {","+\t\t\t\treturn true, false","+\t\t\t}","+\t\t\tname := fmt.Sprintf(\"%s/%s (%s)\", srv.Datacenter, srv.ShortName, srv.Build.String())","+\t\t\tif srv.Status == serf.StatusFailed {","+\t\t\t\tfailed = append(failed, name)","+\t\t\t} else {","+\t\t\t\talive = append(alive, name)","+\t\t\t}","+\t\t\t// Keep iterating so every outdated server is reported.","+\t\t\treturn true, false","+\t\t})","+\t}","+\tif len(alive) == 0 && len(failed) == 0 {","+\t\treturn nil","+\t}","+\tsort.Strings(alive)","+\tsort.Strings(failed)","+","+\tvar b strings.Builder","+\tfmt.Fprintf(&b, \"all servers in every datacenter must run Consul %s or later before configuring ECDHCurves in the mesh config entry, \"+","+\t\t\"because older servers drop the field when they store or replicate the entry\", minMeshPQCVersion.String())","+\tif len(alive) > 0 {","+\t\tfmt.Fprintf(&b, \"; servers on older versions: %s\", formatNodeNames(alive, maxReportedOutdatedAgents))","+\t}","+\tif len(failed) > 0 {","+\t\tfmt.Fprintf(&b, \"; failed servers on older versions: %s. Upgrade them, or remove them with 'consul force-leave' if they will not return\",","+\t\t\tformatNodeNames(failed, maxReportedOutdatedAgents))","+\t}","+\treturn errors.New(b.String())","+}","+","+// meshPQCDatacenters returns the local datacenter and every WAN-federated","+// datacenter known to this server.","+func (s *Server) meshPQCDatacenters() []string {","+\tdcs := []string{s.config.Datacenter}","+\tfor _, dc := range s.router.GetDatacenters() {","+\t\tif !slices.Contains(dcs, dc) {","+\t\t\tdcs = append(dcs, dc)","+\t\t}","+\t}","+\treturn dcs","+}","+","+// meshPQCMembers returns the LAN members that render Envoy configuration for","+// proxies in the given admin partition.","+func (s *Server) meshPQCMembers(partition string) ([]serf.Member, error) {","+\treturn s.LANMembers(LANMemberFilter{Partition: partition})","+}","+","+// agentsWithoutMeshPQCSupport returns the sorted, de-duplicated names of alive","+// Consul agents whose version renders Envoy configuration without mesh","+// post-quantum settings.","+func agentsWithoutMeshPQCSupport(members []serf.Member) []string {","+\tvar names []string","+\tfor i := range members {","+\t\tm := &members[i]","+\t\tif m.Status != serf.StatusAlive {","+\t\t\tcontinue","+\t\t}","+\t\tif role := m.Tags[\"role\"]; role != \"consul\" && role != \"node\" {","+\t\t\tcontinue","+\t\t}","+\t\tv, err := metadata.Build(m)","+\t\tif err != nil || v == nil {","+\t\t\tcontinue","+\t\t}","+\t\tif !meshPQCVersionSupported(v) && !slices.Contains(names, m.Name) {","+\t\t\tnames = append(names, m.Name)","+\t\t}","+\t}","+\tsort.Strings(names)","+\treturn names","+}","+","+func formatNodeNames(names []string, limit int) string {","+\tif limit <= 0 || len(names) <= limit {","+\t\treturn strings.Join(names, \", \")","+\t}","+\treturn fmt.Sprintf(\"%s (and %d more)\", strings.Join(names[:limit], \", \"), len(names)-limit)","+}","+","+// checkMeshPQCCompatibility runs after the write is authorized and is known to","+// change the stored entry. It rejects Outgoing curve lists that cannot work","+// with TLS 1.2, rejects ECDHCurves while any server is too old to keep the","+// field, and warns when agents in the entry's partition will ignore it.","+func (c *ConfigEntry) checkMeshPQCCompatibility(updated, current structs.ConfigEntry) error {","+\tmesh, ok := updated.(*structs.MeshConfigEntry)","+\tif !ok {","+\t\treturn nil","+\t}","+\tif err := structs.ValidateMeshOutgoingECDHCurvesUpdate(mesh, current); err != nil {","+\t\treturn err","+\t}","+\tif !meshEntryEnablesPQC(mesh) {","+\t\treturn nil","+\t}","+","+\tif meshEntryConfiguresECDHCurves(mesh) {","+\t\tif err := serversSupportMeshECDHCurves(c.srv, c.srv.meshPQCDatacenters()); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\tpartition := mesh.GetEnterpriseMeta().PartitionOrDefault()","+\tmembers, err := c.srv.meshPQCMembers(partition)","+\tif err != nil {","+\t\tc.logger.Debug(\"unable to list LAN members to check post-quantum TLS support\", \"partition\", partition, \"error\", err)","+\t\treturn nil","+\t}","+\tlogAgentsWithoutMeshPQCSupport(c.logger, partition, members)","+\treturn nil","+}","+","+// logAgentsWithoutMeshPQCSupport logs a warning when alive agents in the","+// partition are too old to apply mesh post-quantum settings. It returns the","+// number of outdated agents.","+func logAgentsWithoutMeshPQCSupport(logger hclog.Logger, partition string, members []serf.Member) int {","+\toutdated := agentsWithoutMeshPQCSupport(members)","+\tif len(outdated) == 0 {","+\t\treturn 0","+\t}","+\tlogger.Warn(\"mesh config entry enables post-quantum TLS key exchange, but some agents run a Consul version that ignores it; \"+","+\t\t\"sidecar proxies and gateways managed by these agents keep their previous TLS settings until the agents are upgraded\",","+\t\t\"partition\", partition,","+\t\t\"min_version\", minMeshPQCVersion.String(),","+\t\t\"count\", len(outdated),","+\t\t\"agents\", formatNodeNames(outdated, maxReportedOutdatedAgents),","+\t)","+\treturn len(outdated)","+}","+","+// meshPQCOutdatedAgentCounts returns, for each partition with a mesh config","+// entry, the number of alive agents that ignore its post-quantum settings.","+// Partitions whose mesh entry does not enable post-quantum key exchange","+// report zero. Partitions whose members could not be listed are returned in","+// failed instead, so callers can keep their last known value.","+func meshPQCOutdatedAgentCounts(entries []structs.ConfigEntry, membersFn func(partition string) ([]serf.Member, error), logger hclog.Logger) (map[string]int, map[string]struct{}) {","+\tcounts := make(map[string]int)","+\tfailed := make(map[string]struct{})","+\tfor _, entry := range entries {","+\t\tmesh, ok := entry.(*structs.MeshConfigEntry)","+\t\tif !ok {","+\t\t\tcontinue","+\t\t}","+\t\tpartition := mesh.GetEnterpriseMeta().PartitionOrDefault()","+\t\tif !meshEntryEnablesPQC(mesh) {","+\t\t\tcounts[partition] = 0","+\t\t\tcontinue","+\t\t}","+\t\tmembers, err := membersFn(partition)","+\t\tif err != nil {","+\t\t\tlogger.Warn(\"unable to list LAN members for post-quantum TLS metrics; keeping the last reported value\",","+\t\t\t\t\"partition\", partition, \"error\", err)","+\t\t\tfailed[partition] = struct{}{}","+\t\t\tcontinue","+\t\t}","+\t\tcounts[partition] = len(agentsWithoutMeshPQCSupport(members))","+\t}","+\treturn counts, failed","+}","+","+// emitMeshPQCOutdatedAgentGauges sets mesh.pqc_outdated_agents for every","+// partition in counts. Partitions in failed keep their previously reported","+// value, which is emitted again so the series does not expire; nothing is","+// emitted for them if no value was reported yet. Partitions reported","+// previously but neither counted nor failed are reset to zero. It returns the","+// value reported for each partition in this round.","+func emitMeshPQCOutdatedAgentGauges(counts map[string]int, failed map[string]struct{}, previous map[string]int, setGauge func(key []string, val float32, labels []metrics.Label)) map[string]int {","+\tkey := []string{\"mesh\", \"pqc_outdated_agents\"}","+\treported := make(map[string]int, len(counts)+len(failed))","+\tfor p, n := range counts {","+\t\treported[p] = n","+\t}","+\tfor p := range failed {","+\t\tif _, counted := counts[p]; counted {","+\t\t\tcontinue","+\t\t}","+\t\tif n, ok := previous[p]; ok {","+\t\t\treported[p] = n","+\t\t}","+\t}","+","+\tpartitions := make([]string, 0, len(reported))","+\tfor p := range reported {","+\t\tpartitions = append(partitions, p)","+\t}","+\tsort.Strings(partitions)","+\tfor _, p := range partitions {","+\t\tsetGauge(key, float32(reported[p]), []metrics.Label{{Name: \"partition\", Value: p}})","+\t}","+","+\tvar removed []string","+\tfor p := range previous {","+\t\tif _, ok := reported[p]; ok {","+\t\t\tcontinue","+\t\t}","+\t\tif _, ok := failed[p]; ok {","+\t\t\tcontinue","+\t\t}","+\t\tremoved = append(removed, p)","+\t}","+\tsort.Strings(removed)","+\tfor _, p := range removed {","+\t\tsetGauge(key, 0, []metrics.Label{{Name: \"partition\", Value: p}})","+\t}","+\treturn reported","+}","+","+// updateMeshPQCOutdatedAgentGauges computes and emits the gauge for every mesh","+// config entry stored on this server.","+func (s *Server) updateMeshPQCOutdatedAgentGauges(previous map[string]int, setGauge func(key []string, val float32, labels []metrics.Label)) map[string]int {","+\t_, entries, err := s.fsm.State().ConfigEntriesByKindAllPartitions(nil, structs.MeshConfig)","+\tif err != nil {","+\t\ts.logger.Debug(\"unable to read mesh config entries for post-quantum TLS metrics\", \"error\", err)","+\t\treturn previous","+\t}","+\tcounts, failed := meshPQCOutdatedAgentCounts(entries, s.meshPQCMembers, s.logger)","+\treturn emitMeshPQCOutdatedAgentGauges(counts, failed, previous, setGauge)","+}","+","+func (s *Server) startMeshPQCMetrics(ctx context.Context) {","+\ts.leaderRoutineManager.Start(ctx, meshPQCMetricsRoutineName, s.runMeshPQCMetrics)","+}","+","+func (s *Server) stopMeshPQCMetrics() {","+\ts.leaderRoutineManager.Stop(meshPQCMetricsRoutineName)","+}","+","+func (s *Server) runMeshPQCMetrics(ctx context.Context) error {","+\tticker := time.NewTicker(meshPQCMetricsInterval)","+\tdefer ticker.Stop()","+","+\tvar reported map[string]int","+\tfor {","+\t\treported = s.updateMeshPQCOutdatedAgentGauges(reported, metrics.SetGaugeWithLabels)","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\t// Stop reporting stale values after losing leadership.","+\t\t\temitMeshPQCOutdatedAgentGauges(nil, nil, reported, metrics.SetGaugeWithLabels)","+\t\t\treturn nil","+\t\tcase <-ticker.C:","+\t\t}","+\t}","+}"],"additions":349,"deletions":0,"truncated":false},{"path":"agent/consul/config_endpoint_mesh_pqc_test.go","lines":["@@ -0,0 +1,765 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package consul","+","+import (","+\t\"bytes\"","+\t\"fmt\"","+\t\"os\"","+\t\"testing\"","+","+\tmsgpackrpc \"github.com/hashicorp/consul-net-rpc/net-rpc-msgpackrpc\"","+\t\"github.com/hashicorp/consul-net-rpc/net/rpc\"","+\t\"github.com/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/go-metrics\"","+\t\"github.com/hashicorp/go-version\"","+\t\"github.com/hashicorp/serf/serf\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/hashicorp/consul/acl\"","+\t\"github.com/hashicorp/consul/agent/metadata\"","+\t\"github.com/hashicorp/consul/agent/structs\"","+\t\"github.com/hashicorp/consul/sdk/testutil/retry\"","+\t\"github.com/hashicorp/consul/testrpc\"","+\t\"github.com/hashicorp/consul/types\"","+)","+","+func TestMeshEntryConfiguresECDHCurves(t *testing.T) {","+\tt.Parallel()","+","+\tcases := map[string]struct {","+\t\tentry structs.ConfigEntry","+\t\twant  bool","+\t}{","+\t\t\"non-mesh entry\": {","+\t\t\tentry: &structs.ServiceConfigEntry{Kind: structs.ServiceDefaults, Name: \"web\"},","+\t\t\twant:  false,","+\t\t},","+\t\t\"mesh entry without TLS\": {","+\t\t\tentry: &structs.MeshConfigEntry{},","+\t\t\twant:  false,","+\t\t},","+\t\t\"mesh entry with TLS but no directions\": {","+\t\t\tentry: &structs.MeshConfigEntry{TLS: &structs.MeshTLSConfig{}},","+\t\t\twant:  false,","+\t\t},","+\t\t\"mesh entry with TLS version only\": {","+\t\t\tentry: &structs.MeshConfigEntry{TLS: &structs.MeshTLSConfig{","+\t\t\t\tIncoming: &structs.MeshDirectionalTLSConfig{TLSMinVersion: types.TLSv1_3},","+\t\t\t}},","+\t\t\twant: false,","+\t\t},","+\t\t\"mesh entry with empty curve list\": {","+\t\t\tentry: &structs.MeshConfigEntry{TLS: &structs.MeshTLSConfig{","+\t\t\t\tOutgoing: &structs.MeshDirectionalTLSConfig{ECDHCurves: []string{}},","+\t\t\t}},","+\t\t\twant: false,","+\t\t},","+\t\t\"mesh entry with incoming curves\": {","+\t\t\tentry: &structs.MeshConfigEntry{TLS: &structs.MeshTLSConfig{","+\t\t\t\tInco