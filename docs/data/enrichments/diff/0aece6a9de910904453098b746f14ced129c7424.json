{"id":"0aece6a9de910904453098b746f14ced129c7424","axis":"silent","repo":"symfony/symfony","sha":"0aece6a9de910904453098b746f14ced129c7424","parsed":{"files":[{"path":"src/Symfony/Bridge/Doctrine/CHANGELOG.md","lines":["@@ -14,6 +14,7 @@ CHANGELOG","  * Add the `EntityExists` constraint for validating that a value references an existing entity","  * Add `CollectionDenormalizer` to denormalize arrays into Doctrine collections","  * Add `before` and `after` to the `doctrine.event_listener` tag to order listeners","+ * Add `MessengerInboxDoctrineSchemaListener` to add the tables of the Messenger inboxes to the Doctrine schema"," "," 8.1"," ---"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bridge/Doctrine/SchemaListener/MessengerInboxDoctrineSchemaListener.php","lines":["@@ -0,0 +1,48 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bridge\\Doctrine\\SchemaListener;","+","+use Doctrine\\ORM\\Tools\\Event\\GenerateSchemaEventArgs;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Inbox\\DoctrineInbox;","+","+/**","+ * Adds the tables of the Messenger inboxes to the Doctrine schema.","+ */","+class MessengerInboxDoctrineSchemaListener extends AbstractSchemaListener","+{","+    /**","+     * @param iterable<mixed, object> $inboxes","+     */","+    public function __construct(","+        private readonly iterable $inboxes,","+    ) {","+    }","+","+    public function postGenerateSchema(GenerateSchemaEventArgs $event): void","+    {","+        $connection = $event->getEntityManager()->getConnection();","+        $schema = $event->getSchema();","+","+        foreach ($this->inboxes as $inbox) {","+            if (!$inbox instanceof DoctrineInbox) {","+                continue;","+            }","+","+            $isSameDatabaseChecker = $this->getIsSameDatabaseChecker($connection);","+            $schema = $this->filterSchemaChanges($schema, $connection, static fn () => $inbox->configureSchema($schema, $connection, $isSameDatabaseChecker));","+        }","+","+        if (method_exists($schema, 'edit') && method_exists($event, 'setSchema')) {","+            $event->setSchema($schema);","+        }","+    }","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"src/Symfony/Bridge/Doctrine/Tests/SchemaListener/MessengerInboxDoctrineSchemaListenerTest.php","lines":["@@ -0,0 +1,55 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bridge\\Doctrine\\Tests\\SchemaListener;","+","+use Doctrine\\DBAL\\Configuration;","+use Doctrine\\DBAL\\DriverManager;","+use Doctrine\\DBAL\\Schema\\Schema;","+use Doctrine\\ORM\\EntityManagerInterface;","+use Doctrine\\ORM\\Tools\\Event\\GenerateSchemaEventArgs;","+use PHPUnit\\Framework\\Attributes\\RequiresPhpExtension;","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Bridge\\Doctrine\\SchemaListener\\MessengerInboxDoctrineSchemaListener;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Inbox\\DoctrineInbox;","+","+#[RequiresPhpExtension('pdo_sqlite')]","+class MessengerInboxDoctrineSchemaListenerTest extends TestCase","+{","+    public function testPostGenerateSchema()","+    {","+        $connection = DriverManager::getConnection(['driver' => 'pdo_sqlite', 'memory' => true]);","+        $entityManager = $this->createStub(EntityManagerInterface::class);","+        $entityManager->method('getConnection')->willReturn($connection);","+        $event = new GenerateSchemaEventArgs($entityManager, new Schema());","+","+        $listener = new MessengerInboxDoctrineSchemaListener([new DoctrineInbox($connection, 'orders_inbox'), new DoctrineInbox($connection, 'invoices_inbox')]);","+        $listener->postGenerateSchema($event);","+","+        $this->assertTrue($event->getSchema()->hasTable('orders_inbox'));","+        $this->assertTrue($event->getSchema()->hasTable('invoices_inbox'));","+    }","+","+    public function testPostGenerateSchemaRespectsSchemaFilter()","+    {","+        $configuration = new Configuration();","+        $configuration->setSchemaAssetsFilter(static fn (string $tableName) => 'messenger_inbox' !== $tableName);","+        $connection = DriverManager::getConnection(['driver' => 'pdo_sqlite', 'memory' => true], $configuration);","+        $entityManager = $this->createStub(EntityManagerInterface::class);","+        $entityManager->method('getConnection')->willReturn($connection);","+        $event = new GenerateSchemaEventArgs($entityManager, new Schema());","+","+        $listener = new MessengerInboxDoctrineSchemaListener([new DoctrineInbox($connection)]);","+        $listener->postGenerateSchema($event);","+","+        $this->assertFalse($event->getSchema()->hasTable('messenger_inbox'));","+    }","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"src/Symfony/Bridge/Doctrine/composer.json","lines":["@@ -36,7 +36,7 @@","         \"symfony/config\": \"^7.4|^8.0\",","         \"symfony/console\": \"^8.1\",","         \"symfony/dependency-injection\": \"^8.2\",","-        \"symfony/doctrine-messenger\": \"^7.4|^8.0\",","+        \"symfony/doctrine-messenger\": \"^8.2\",","         \"symfony/expression-language\": \"^7.4|^8.0\",","         \"symfony/form\": \"^7.4|^8.0\",","         \"symfony/http-kernel\": \"^7.4|^8.0\","],"additions":1,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/Messenger/Bridge/Doctrine/CHANGELOG.md","lines":["@@ -5,6 +5,7 @@ CHANGELOG"," ---"," ","  * Make `DoctrineSender` and `DoctrineTransport` implement `BatchSenderInterface`, inserting several messages per statement","+ * Add `DoctrineInbox` to record the handled messages in a database table"," "," 8.1"," ---"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Bridge/Doctrine/Inbox/DoctrineInbox.php","lines":["@@ -0,0 +1,149 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Inbox;","+","+use Doctrine\\DBAL\\Connection;","+use Doctrine\\DBAL\\Exception\\TableExistsException;","+use Doctrine\\DBAL\\Exception\\UniqueConstraintViolationException;","+use Doctrine\\DBAL\\ParameterType;","+use Doctrine\\DBAL\\Schema\\Column;","+use Doctrine\\DBAL\\Schema\\Index;","+use Doctrine\\DBAL\\Schema\\Name\\Identifier;","+use Doctrine\\DBAL\\Schema\\Name\\UnqualifiedName;","+use Doctrine\\DBAL\\Schema\\PrimaryKeyConstraint;","+use Doctrine\\DBAL\\Schema\\Schema;","+use Doctrine\\DBAL\\Schema\\Table;","+use Doctrine\\DBAL\\Types\\Types;","+use Symfony\\Component\\Messenger\\Exception\\LogicException;","+use Symfony\\Component\\Messenger\\Inbox\\InboxInterface;","+use Symfony\\Component\\Messenger\\Transport\\SetupableTransportInterface;","+","+/**","+ * Records the messages that consumers handle in a database table.","+ *","+ * A message can be recorded only in the database transaction of its handlers, on the connection of the inbox.","+ * The record is committed with the changes of the handlers, or rolled back with them so that a retry handles the message again.","+ * When two workers get the same message, the second worker waits until the transaction of the first one ends.","+ */","+final class DoctrineInbox implements InboxInterface, SetupableTransportInterface","+{","+    /**","+     * @param int   $retention     The number of seconds a record is kept, which must exceed the time a transport can take to redeliver a message","+     * @param float $gcProbability The probability, from 0 to 1, that recording a message removes the expired records of its consumer","+     */","+    public function __construct(","+        private Connection $connection,","+        private string $tableName = 'messenger_inbox',","+        private int $retention = 604800,","+        private float $gcProbability = 0.001,","+    ) {","+    }","+","+    public function record(string $consumer, string $messageId): bool","+    {","+        if (!$this->connection->isTransactionActive()) {","+            throw new LogicException(\\sprintf('Cannot record message \"%s\" for \"%s\" outside of a database transaction. Run the handlers in a transaction on the connection of the inbox, as the \"doctrine_transaction\" middleware does.', $messageId, $consumer));","+        }","+","+        $now = \\DateTimeImmutable::createFromTimestamp(microtime(true));","+","+        // the nested transaction is a savepoint, so that a failed insert doesn't abort the transaction of the handlers on PostgreSQL","+        $this->connection->beginTransaction();","+","+        try {","+            $this->connection->insert($this->tableName, ['consumer' => $consumer, 'message_id' => $messageId, 'handled_at' => $now], ['handled_at' => Types::DATETIME_IMMUTABLE]);","+            $this->connection->commit();","+        } catch (UniqueConstraintViolationException) {","+            $this->connection->rollBack();","+","+            return false;","+        } catch (\\Throwable $e) {","+            $this->connection->rollBack();","+","+            throw $e;","+        }","+","+        if ($this->gcProbability > 0 && (1.0 === $this->gcProbability || (random_int(0, \\PHP_INT_MAX) / \\PHP_INT_MAX) <= $this->gcProbability)) {","+            $this->connection->executeStatement(\"DELETE FROM $this->tableName WHERE consumer = ? AND handled_at < ?\", [$consumer, $now->modify(\\sprintf('-%d seconds', $this->retention))], [ParameterType::STRING, Types::DATETIME_IMMUTABLE]);","+        }","+","+        return true;","+    }","+","+    public function forget(string $consumer, string $messageId): void","+    {","+        $this->connection->delete($this->tableName, ['consumer' => $consumer, 'message_id' => $messageId]);","+    }","+","+    public function setup(): void","+    {","+        $schema = new Schema([], [], $this->connection->createSchemaManager()->createSchemaConfig());","+        $table = $this->configureSchema($schema, $this->connection, static fn (): bool => true)->getTable($this->tableName);","+","+        try {","+            $this->connection->createSchemaManager()->createTable($table);","+        } catch (TableExistsException) {","+        }","+    }","+","+    /**","+     * Adds the table of the inbox to the schema of a connection, when that connection reaches the database of the inbox.","+     *","+     * @param \\Closure(\\Closure(string): mixed): bool $isSameDatabase","+     *","+     * @param-immediately-invoked-callable $isSameDatabase","+     */","+    public function configureSchema(Schema $schema, Connection $forConnection, \\Closure $isSameDatabase): Schema","+    {","+        if ($schema->hasTable($this->tableName)) {","+            return $schema;","+        }","+","+        if ($forConnection !== $this->connection && !$isSameDatabase($this->connection->executeStatement(...))) {","+            return $schema;","+        }","+","+        if (method_exists($schema, 'edit')) {","+            return $schema->edit()->addTable($this->buildSchemaTable())->create();","+        }","+","+        $this->configureSchemaTable($schema->createTable($this->tableName));","+","+        return $schema;","+    }","+","+    private function buildSchemaTable(): Table","+    {","+        return Table::editor()","+            ->setUnquotedName($this->tableName)","+            // MySQL 5.6 only supports 191 characters on an indexed column in utf8mb4 mode","+            ->addColumn(Column::editor()->setUnquotedName('consumer')->setTypeName(Types::STRING)->setLength(190)->setNotNull(true)->create())","+            ->addColumn(Column::editor()->setUnquotedName('message_id')->setTypeName(Types::STRING)->setLength(190)->setNotNull(true)->create())","+            ->addColumn(Column::editor()->setUnquotedName('handled_at')->setTypeName(Types::DATETIME_IMMUTABLE)->setNotNull(true)->create())","+            ->addPrimaryKeyConstraint(new PrimaryKeyConstraint(null, [new UnqualifiedName(Identifier::unquoted('consumer')), new UnqualifiedName(Identifier::unquoted('message_id'))], true))","+            ->addIndex(Index::editor()->setUnquotedColumnNames('consumer', 'handled_at'))","+            ->create();","+    }","+","+    /**","+     * To be removed when doctrine/dbal minimum is bumped to ^4.5.","+     */","+    private function configureSchemaTable(Table $table): void","+    {","+        // MySQL 5.6 only supports 191 characters on an indexed column in utf8mb4 mode","+        $table->addColumn('consumer', Types::STRING, ['length' => 190, 'notnull' => true]);","+        $table->addColumn('message_id', Types::STRING, ['length' => 190, 'notnull' => true]);","+        $table->addColumn('handled_at', Types::DATETIME_IMMUTABLE, ['notnull' => true]);","+        $table->addPrimaryKeyConstraint(new PrimaryKeyConstraint(null, [new UnqualifiedName(Identifier::unquoted('consumer')), new UnqualifiedName(Identifier::unquoted('message_id'))], true));","+        $table->addIndex(['consumer', 'handled_at']);","+    }","+}"],"additions":149,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Bridge/Doctrine/Tests/Inbox/DoctrineInboxIntegrationTest.php","lines":["@@ -0,0 +1,254 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Tests\\Inbox;","+","+use Doctrine\\DBAL\\Configuration;","+use Doctrine\\DBAL\\Connection as DBALConnection;","+use Doctrine\\DBAL\\DriverManager;","+use Doctrine\\DBAL\\Schema\\DefaultSchemaManagerFactory;","+use Doctrine\\DBAL\\Tools\\DsnParser;","+use PHPUnit\\Framework\\Attributes\\RequiresPhpExtension;","+use PHPUnit\\Framework\\TestCase;","+use Psr\\Container\\ContainerInterface;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Inbox\\DoctrineInbox;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Tests\\Fixtures\\DummyMessage;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Transport\\Connection;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Transport\\DoctrineTransport;","+use Symfony\\Component\\Messenger\\Envelope;","+use Symfony\\Component\\Messenger\\Exception\\HandlerFailedException;","+use Symfony\\Component\\Messenger\\Exception\\LogicException;","+use Symfony\\Component\\Messenger\\Exception\\TransportException;","+use Symfony\\Component\\Messenger\\Handler\\HandlersLocator;","+use Symfony\\Component\\Messenger\\MessageBus;","+use Symfony\\Component\\Messenger\\MessageBusInterface;","+use Symfony\\Component\\Messenger\\Middleware\\DispatchAfterCurrentBusMiddleware;","+use Symfony\\Component\\Messenger\\Middleware\\HandleMessageMiddleware;","+use Symfony\\Component\\Messenger\\Middleware\\InboxMiddleware;","+use Symfony\\Component\\Messenger\\Middleware\\MiddlewareInterface;","+use Symfony\\Component\\Messenger\\Middleware\\SendMessageMiddleware;","+use Symfony\\Component\\Messenger\\Middleware\\StackInterface;","+use Symfony\\Component\\Messenger\\Stamp\\DispatchAfterCurrentBusStamp;","+use Symfony\\Component\\Messenger\\Stamp\\MessageIdStamp;","+use Symfony\\Component\\Messenger\\Stamp\\ReceivedStamp;","+use Symfony\\Component\\Messenger\\Stamp\\TransportNamesStamp;","+use Symfony\\Component\\Messenger\\Transport\\InMemory\\InMemoryTransport;","+use Symfony\\Component\\Messenger\\Transport\\Sender\\OutboxSender;","+use Symfony\\Component\\Messenger\\Transport\\Sender\\SenderInterface;","+use Symfony\\Component\\Messenger\\Transport\\Sender\\SendersLocator;","+use Symfony\\Component\\Messenger\\Transport\\Serialization\\PhpSerializer;","+use Symfony\\Contracts\\Service\\ServiceLocatorTrait;","+","+#[RequiresPhpExtension('pdo_sqlite')]","+class DoctrineInboxIntegrationTest extends TestCase","+{","+    private DBALConnection $connection;","+    private DoctrineInboxIntegrationTestSender $outbox;","+    private InMemoryTransport $invoices;","+    private DoctrineInboxIntegrationTestHandler $handler;","+    private MessageBus $bus;","+","+    protected function setUp(): void","+    {","+        $config = new Configuration();","+        $config->setSchemaManagerFactory(new DefaultSchemaManagerFactory());","+","+        $this->connection = DriverManager::getConnection((new DsnParser())->parse(getenv('MESSENGER_DOCTRINE_DSN') ?: 'pdo-sqlite://:memory:'), $config);","+        foreach (['messenger_inbox', 'messenger_messages', 'orders'] as $table) {","+            $this->connection->executeStatement(\"DROP TABLE IF EXISTS $table\");","+        }","+        $this->connection->executeStatement('CREATE TABLE orders (name VARCHAR(255) NOT NULL)');","+","+        $inbox = new DoctrineInbox($this->connection);","+        $inbox->setup();","+        $outbox = new DoctrineTransport(new Connection([], $this->connection), new PhpSerializer());","+        $outbox->setup();","+        $this->outbox = new DoctrineInboxIntegrationTestSender($outbox);","+        $this->invoices = new InMemoryTransport();","+","+        $sendersLocator = new SendersLocator([DoctrineInboxIntegrationTestEvent::class => ['orders']], new DoctrineInboxIntegrationTestLocator([","+            'orders' => fn () => new OutboxSender(new InMemoryTransport(), $this->outbox, 'orders', 'outbox'),","+            'invoices' => fn () => $this->invoices,","+        ]));","+        $inboxMiddleware = new InboxMiddleware(new DoctrineInboxIntegrationTestLocator(['orders' => static fn () => $inbox]));","+        $this->handler = new DoctrineInboxIntegrationTestHandler($this->connection);","+","+        $this->bus = new MessageBus([","+            new DispatchAfterCurrentBusMiddleware($sendersLocator, $inboxMiddleware),","+            new DoctrineInboxIntegrationTestTransactionMiddleware($this->connection),","+            new SendMessageMiddleware($sendersLocator),","+            $inboxMiddleware,","+            new HandleMessageMiddleware(new HandlersLocator([DummyMessage::class => [$this->handler]])),","+        ]);","+        $this->handler->bus = $this->bus;","+    }","+","+    protected function tearDown(): void","+    {","+        foreach (['messenger_inbox', 'messenger_messages', 'orders'] as $table) {","+            $this->connection->executeStatement(\"DROP TABLE IF EXISTS $table\");","+        }","+        $this->connection->close();","+    }","+","+    public function testARedeliveredMessageIsNotHandledAgain()","+    {","+        $this->bus->dispatch($this->createReceivedEnvelope());","+        $this->bus->dispatch($this->createReceivedEnvelope());","+","+        $this->assertSame(1, $this->handler->calls);","+        $this->assertSame(['Hey'], $this->connection->fetchFirstColumn('SELECT name FROM orders'));","+    }","+","+    public function testAFailedMessageIsHandledAgainWhenItIsRetried()","+    {","+        $this->handler->failures = 1;","+","+        try {","+            $this->bus->dispatch($this->createReceivedEnvelope());","+            $this->fail('The handler should have failed.');","+        } catch (HandlerFailedException) {","+        }","+","+        $this->assertSame(0, $this->countRows('orders'));","+        $this->assertSame(0, $this->countRows('messenger_inbox'));","+","+        $this->bus->dispatch($this->createReceivedEnvelope());","+","+        $this->assertSame(2, $this->handler->calls);","+        $this->assertSame(['Hey'], $this->connection->fetchFirstColumn('SELECT name FROM orders'));","+    }","+","+    public function testAMessageDispatchedAfterTheCurrentOneIsNotLostWhenStoringItFails()","+    {","+        $this->handler->dispatch = new Envelope(new DoctrineInboxIntegrationTestEvent(), [new DispatchAfterCurrentBusStamp()]);","+        $this->outbox->failures = 1;","+","+        try {","+            $this->bus->dispatch($this->createReceivedEnvelope());","+            $this->fail('Storing the message should have failed.');","+        } catch (HandlerFailedException) {","+        }","+","+        $this->assertSame(0, $this->countRows('orders'), 'the changes of the handler were rolled back with the inbox record');","+","+        $this->bus->dispatch($this->createReceivedEnvelope());","+        $this->bus->dispatch($this->createReceivedEnvelope());","+","+        $this->assertSame(1, $this->countRows('orders'));","+        $this->assertSame(1, $this->countRows('messenger_messages'));","+    }","+","+    public function testAMessageDispatchedAfterTheCurrentOneToATransportWithoutOutboxIsRefused()","+    {","+        $this->handler->dispatch = new Envelope(new DoctrineInboxIntegrationTestEvent(), [new DispatchAfterCurrentBusStamp(), new TransportNamesStamp(['invoices'])]);","+","+        try {","+            $this->bus->dispatch($this->createReceivedEnvelope());","+            $this->fail('The handler should have failed.');","+        } catch (HandlerFailedException $e) {","+            $this->assertInstanceOf(LogicException::class, $e->getPrevious());","+        }","+","+        $this->assertSame(0, $this->countRows('orders'));","+        $this->assertSame(0, $this->countRows('messenger_inbox'));","+        $this->assertSame([], $this->invoices->getSent());","+    }","+","+    private function createReceivedEnvelope(): Envelope","+    {","+        return new Envelope(new DummyMessage('Hey'), [new ReceivedStamp('orders'), new MessageIdStamp('id-1')]);","+    }","+","+    private function countRows(string $table): int","+    {","+        return (int) $this->connection->fetchOne(\"SELECT COUNT(*) FROM $table\");","+    }","+}","+","+class DoctrineInboxIntegrationTestEvent","+{","+}","+","+class DoctrineInboxIntegrationTestHandler","+{","+    public MessageBusInterface $bus;","+    public ?Envelope $dispatch = null;","+    public int $failures = 0;","+    public int $calls = 0;","+","+    public function __construct(","+        private DBALConnection $connection,","+    ) {","+    }","+","+    public function __invoke(DummyMessage $message): void","+    {","+        ++$this->calls;","+        $this->connection->insert('orders', ['name' => $message->getMessage()]);","+","+        if (null !== $this->dispatch) {","+            $this->bus->dispatch($this->dispatch);","+        }","+","+        if (0 < $this->failures--) {","+            throw new \\RuntimeException('Failure.');","+        }","+    }","+}","+","+class DoctrineInboxIntegrationTestSender implements SenderInterface","+{","+    public int $failures = 0;","+","+    public function __construct(","+        private SenderInterface $sender,","+    ) {","+    }","+","+    public function send(Envelope $envelope): Envelope","+    {","+        if (0 < $this->failures--) {","+            throw new TransportException('Failure.');","+        }","+","+        return $this->sender->send($envelope);","+    }","+}","+","+class DoctrineInboxIntegrationTestTransactionMiddleware implements MiddlewareInterface","+{","+    public function __construct(","+        private DBALConnection $connection,","+    ) {","+    }","+","+    public function handle(Envelope $envelope, StackInterface $stack): Envelope","+    {","+        $this->connection->beginTransaction();","+","+        try {","+            $envelope = $stack->next()->handle($envelope, $stack);","+            $this->connection->commit();","+","+            return $envelope;","+        } catch (\\Throwable $e) {","+            $this->connection->rollBack();","+","+            throw $e;","+        }","+    }","+}","+","+class DoctrineInboxIntegrationTestLocator implements ContainerInterface","+{","+    use ServiceLocatorTrait;","+}"],"additions":254,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Bridge/Doctrine/Tests/Inbox/DoctrineInboxTest.php","lines":["@@ -0,0 +1,175 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Tests\\Inbox;","+","+use Doctrine\\DBAL\\Configuration;","+use Doctrine\\DBAL\\Connection;","+use Doctrine\\DBAL\\DriverManager;","+use Doctrine\\DBAL\\Schema\\DefaultSchemaManagerFactory;","+use Doctrine\\DBAL\\Schema\\Schema;","+use Doctrine\\DBAL\\Tools\\DsnParser;","+use Doctrine\\DBAL\\Types\\Types;","+use PHPUnit\\Framework\\Attributes\\RequiresPhpExtension;","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\Messenger\\Bridge\\Doctrine\\Inbox\\DoctrineInbox;","+use Symfony\\Component\\Messenger\\Exception\\LogicException;","+","+#[RequiresPhpExtension('pdo_sqlite')]","+class DoctrineInboxTest extends TestCase","+{","+    private Connection $connection;","+","+    protected function setUp(): void","+    {","+        $config = new Configuration();","+        $config->setSchemaManagerFactory(new DefaultSchemaManagerFactory());","+","+        $this->connection = DriverManager::getConnection((new DsnParser())->parse(getenv('MESSENGER_DOCTRINE_DSN') ?: 'pdo-sqlite://:memory:'), $config);","+        $this->connection->executeStatement('DROP TABLE IF EXISTS messenger_inbox');","+    }","+","+    protected function tearDown(): void","+    {","+        $this->connection->executeStatement('DROP TABLE IF EXISTS messenger_inbox');","+        $this->connection->close();","+    }","+","+    public function testAMessageIsRecordedOnce()","+    {","+        $inbox = $this->createInbox();","+","+        $this->connection->beginTransaction();","+        $this->assertTrue($inbox->record('orders', 'id-1'));","+        $this->assertFalse($inbox->record('orders', 'id-1'));","+        $this->connection->commit();","+","+        $this->connection->beginTransaction();","+        $this->assertFalse($inbox->record('orders', 'id-1'));","+        $this->connection->rollBack();","+    }","+","+    public function testEachConsumerRecordsTheMessage()","+    {","+        $inbox = $this->createInbox();","+","+        $this->connection->beginTransaction();","+        $this->assertTrue($inbox->record('orders', 'id-1'));","+        $this->assertTrue($inbox->record('invoices', 'id-1'));","+        $this->connection->commit();","+    }","+","+    public function testARolledBackRecordIsDiscarded()","+    {","+        $inbox = $this->createInbox();","+","+        $this->connection->beginTransaction();","+        $this->assertTrue($inbox->record('orders', 'id-1'));","+        $this->connection->rollBack();","+","+        $this->connection->beginTransaction();","+        $this->assertTrue($inbox->record('orders', 'id-1'));","+        $this->connection->commit();","+    }","+","+    public function testTheTransactionStaysUsableAfterAMessageWasRecordedAlready()","+    {","+        $inbox = $this->createInbox();","+","+        $this->connection->beginTransaction();","+        $inbox->record('orders', 'id-1');","+        $this->connection->commit();","+","+        $this->connection->beginTransaction();","+        $this->assertFalse($inbox->record('orders', 'id-1'));","+        $this->assertTrue($inbox->record('orders', 'id-2'));","+        $this->connection->commit();","+","+        $this->assertSame(['id-1', 'id-2'], $this->connection->fetchFirstColumn('SELECT message_id FROM messenger_inbox ORDER BY message_id'));","+    }","+","+    public function testRecordingNeedsATransaction()","+    {","+        $inbox = $this->createInbox();","+","+        $this->expectException(LogicException::class);","+        $this->expectExceptionMessage('Cannot record message \"id-1\" for \"orders\" outside of a database transaction. Run the handlers in a transaction on the connection of the inbox, as the \"doctrine_transaction\" middleware does.');","+","+        $inbox->record('orders', 'id-1');","+    }","+","+    public function testAForgottenMessageCanBeRecordedAgain()","+    {","+        $inbox = $this->createInbox();","+","+        $this->connection->beginTransaction();","+        $inbox->record('orders', 'id-1');","+        $inbox->forget('orders', 'id-1');","+        $this->assertTrue($inbox->record('orders', 'id-1'));","+        $this->connection->commit();","+    }","+","+    public function testRecordingRemovesTheExpiredRecordsOfTheConsumer()","+    {","+        $inbox = $this->createInbox(60, 1.0);","+        $old = new \\DateTimeImmutable('-61 seconds', new \\DateTimeZone('UTC'));","+        $recent = new \\DateTimeImmutable('-59 seconds', new \\DateTimeZone('UTC'));","+","+        $this->connection->insert('messenger_inbox', ['consumer' => 'orders', 'message_id' => 'old', 'handled_at' => $old], ['handled_at' => Types::DATETIME_IMMUTABLE]);","+        $this->connection->insert('messenger_inbox', ['consumer' => 'orders', 'message_id' => 'recent', 'handled_at' => $recent], ['handled_at' => Types::DATETIME_IMMUTABLE]);","+        $this->connection->insert('messenger_inbox', ['consumer' => 'invoices', 'message_id' => 'old', 'handled_at' => $old], ['handled_at' => Types::DATETIME_IMMUTABLE]);","+","+        $this->connection->beginTransaction();","+        $inbox->record('orders', 'new');","+        $this->connection->commit();","+","+        $this->assertSame([['invoices', 'old'], ['orders', 'new'], ['orders', 'recent']], $this->connection->fetchAllNumeric('SELECT consumer, message_id FROM messenger_inbox ORDER BY consumer, message_id'));","+    }","+","+    public function testSetupCanRunAgain()","+    {","+        $inbox = $this->createInbox();","+        $inbox->setup();","+","+        $this->assertTrue($this->connection->createSchemaManager()->tablesExist(['messenger_inbox']));","+    }","+","+    public function testConfigureSchemaAddsTheTable()","+    {","+        $inbox = new DoctrineInbox($this->connection, 'my_inbox');","+","+        $schema = $inbox->configureSchema(new Schema(), $this->connection, static fn () => true);","+","+        $this->assertTrue($schema->hasTable('my_inbox'));","+        $table = $schema->getTable('my_inbox');","+        $this->assertTrue($table->hasColumn('consumer'));","+        $this->assertTrue($table->hasColumn('message_id'));","+        $this->assertTrue($table->hasColumn('handled_at'));","+    }","+","+    public function testConfigureSchemaSkipsAnotherDatabase()","+    {","+        $inbox = new DoctrineInbox($this->connection);","+        $otherConnection = DriverManager::getConnection(['driver' => 'pdo_sqlite', 'memory' => true]);","+","+        $schema = $inbox->configureSchema(new Schema(), $otherConnection, static fn () => false);","+","+        $this->assertFalse($schema->hasTable('messenger_inbox'));","+    }","+","+    private function createInbox(int $retention = 604800, float $gcProbability = 0.0): DoctrineInbox","+    {","+        $inbox = new DoctrineInbox($this->connection, 'messenger_inbox', $retention, $gcProbability);","+        $inbox->setup();","+","+        return $inbox;","+    }","+}"],"additions":175,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/CHANGELOG.md","lines":["@@ -63,6 +63,9 @@ CHANGELOG","  * Add the `messenger.deduplication.lock_factory` option to take the deduplication locks from another lock factory than `lock.factory`"],"additions":0,"deletions":0,"truncated":false}],"additions":684,"deletions":1,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-15T13:23:00.957652+00:00"}