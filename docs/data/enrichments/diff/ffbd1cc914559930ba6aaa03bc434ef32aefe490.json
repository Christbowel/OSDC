,","+\t\t\tcurrent:     currentLimitExceed,","+\t\t\tpeer:        peerLimitExceed,","+\t\t},","+\t}","+\tfor name, spec := range testcases {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tfit, exceeded, negatives, err := IsQuotaFit(spec.current,","+\t\t\t\t[]*v32.ResourceQuotaLimit{spec.peer}, projectLimit)","+","+\t\t\tassert.Equal(t, spec.wantFit, fit)","+\t\t\tif spec.wantErr != nil {","+\t\t\t\tassert.Error(t, err)","+\t\t\t\tassert.Equal(t, spec.wantErr, err)","+\t\t\t} else {","+\t\t\t\tassert.NoError(t, err)","+\t\t\t}","+\t\t\tif spec.wantExceeds != nil {","+\t\t\t\tassert.NotNil(t, exceeded)","+\t\t\t\tassert.Equal(t, spec.wantExceeds, slices.Sorted(maps.Keys(exceeded)))","+\t\t\t} else {","+\t\t\t\tassert.Nil(t, exceeded)","+\t\t\t}","+\t\t\tif spec.wantNegative != nil {","+\t\t\t\tassert.NotNil(t, negatives)","+\t\t\t\tassert.Equal(t, spec.wantNegative, slices.Sorted(maps.Keys(negatives)))","+\t\t\t} else {","+\t\t\t\tassert.Nil(t, negatives)","+\t\t\t}","+\t\t})","+\t}","+}",""],"additions":285,"deletions":0,"truncated":false}],"additions":446,"deletions":54,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-08-22T08:19:21.642949+00:00"}