o/collector/processor/xprocessor => ../../processor/xprocessor","   - go.opentelemetry.io/collector/processor/processorhelper/xprocessorhelper => ../../processor/processorhelper/xprocessorhelper","   - go.opentelemetry.io/collector/processor/processorhelper => ../../processor/processorhelper"],"additions":2,"deletions":0,"truncated":false},{"path":"cmd/otelcorecol/components.go","lines":["@@ -18,6 +18,7 @@ import ("," \t\"go.opentelemetry.io/collector/processor\""," \tbatchprocessor \"go.opentelemetry.io/collector/processor/batchprocessor\""," \tmemorylimiterprocessor \"go.opentelemetry.io/collector/processor/memorylimiterprocessor\"","+\tqueuebatchprocessor \"go.opentelemetry.io/collector/processor/queuebatchprocessor\""," \t\"go.opentelemetry.io/collector/receiver\""," \tnopreceiver \"go.opentelemetry.io/collector/receiver/nopreceiver\""," \totlpreceiver \"go.opentelemetry.io/collector/receiver/otlpreceiver\"","@@ -87,6 +88,7 @@ func components() (otelcol.Factories, error) {"," \tfactories.Processors, err = otelcol.MakeFactoryMap[processor.Factory]("," \t\tbatchprocessor.NewFactory(),"," \t\tmemorylimiterprocessor.NewFactory(),","+\t\tqueuebatchprocessor.NewFactory(),"," \t)"," \tif err != nil {"," \t\treturn otelcol.Factories{}, err","@@ -94,6 +96,7 @@ func components() (otelcol.Factories, error) {"," \tfactories.ProcessorModules = makeModulesMap(factories.Processors, map[component.Type]string{"," \t\tbatchprocessor.NewFactory().Type():         \"go.opentelemetry.io/collector/processor/batchprocessor v0.157.0\","," \t\tmemorylimiterprocessor.NewFactory().Type(): \"go.opentelemetry.io/collector/processor/memorylimiterprocessor v0.157.0\",","+\t\tqueuebatchprocessor.NewFactory().Type():    \"go.opentelemetry.io/collector/processor/queuebatchprocessor v0.157.0\","," \t})"," "," \tfactories.Connectors, err = otelcol.MakeFactoryMap[connector.Factory]("],"additions":3,"deletions":0,"truncated":false},{"path":"cmd/otelcorecol/go.mod","lines":["@@ -26,6 +26,7 @@ require ("," \tgo.opentelemetry.io/collector/processor v1.63.0"," \tgo.opentelemetry.io/collector/processor/batchprocessor v0.157.0"," \tgo.opentelemetry.io/collector/processor/memorylimiterprocessor v0.157.0","+\tgo.opentelemetry.io/collector/processor/queuebatchprocessor v0.157.0"," \tgo.opentelemetry.io/collector/receiver v1.63.0"," \tgo.opentelemetry.io/collector/receiver/nopreceiver v0.157.0"," \tgo.opentelemetry.io/collector/receiver/otlpreceiver v0.157.0","@@ -318,6 +319,8 @@ replace go.opentelemetry.io/collector/processor/batchprocessor => ../../processo"," "," replace go.opentelemetry.io/collector/processor/memorylimiterprocessor => ../../processor/memorylimiterprocessor"," ","+replace go.opentelemetry.io/collector/processor/queuebatchprocessor => ../../processor/queuebatchprocessor","+"," replace go.opentelemetry.io/collector/processor/xprocessor => ../../processor/xprocessor"," "," replace go.opentelemetry.io/collector/processor/processorhelper/xprocessorhelper => ../../processor/processorhelper/xprocessorhelper"],"additions":3,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/Makefile","lines":["@@ -0,0 +1 @@","+include ../../Makefile.Common"],"additions":1,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/README.md","lines":["@@ -0,0 +1,131 @@","+<!-- status autogenerated section -->","+| Status        |           |","+| ------------- |-----------|","+| Stability     | [development]: traces, metrics, logs, profiles   |","+| Distributions | [] |","+| Issues        | [![Open issues](https://img.shields.io/github/issues-search/open-telemetry/opentelemetry-collector?query=is%3Aissue%20is%3Aopen%20label%3Aprocessor%2Fqueuebatch%20&label=open&color=orange&logo=opentelemetry)](https://github.com/open-telemetry/opentelemetry-collector/issues?q=is%3Aopen+is%3Aissue+label%3Aprocessor%2Fqueuebatch) [![Closed issues](https://img.shields.io/github/issues-search/open-telemetry/opentelemetry-collector?query=is%3Aissue%20is%3Aclosed%20label%3Aprocessor%2Fqueuebatch%20&label=closed&color=blue&logo=opentelemetry)](https://github.com/open-telemetry/opentelemetry-collector/issues?q=is%3Aclosed+is%3Aissue+label%3Aprocessor%2Fqueuebatch) |","+| [Code Owners](https://github.com/open-telemetry/opentelemetry-collector-contrib/blob/main/CONTRIBUTING.md#becoming-a-code-owner)    | [@jmacd](https://www.github.com/jmacd), [@iblancasa](https://www.github.com/iblancasa) |","+","+[development]: https://github.com/open-telemetry/opentelemetry-collector/blob/main/docs/component-stability.md#development","+<!-- end autogenerated section -->","+","+The queue/batch processor accepts spans, metrics, logs, or profiles","+and places them into batches, using the [exporterhelper sending queue","+and batch](../../exporter/exporterhelper/README.md#sending-queue) logic","+and configuration.","+","+This component replaces the [batchprocessor](../batchprocessor); see","+[docs/rfcs/batching-migration.md](../../docs/rfcs/batching-migration.md). This","+component improves on the former batch processor while maintaining its","+general behavior. This component uses default settings taken from the","+`batchprocessor` mapped into `exporterhelper` settings:","+","+```yaml","+# The processor will produce and export one batch at a time.","+num_consumers: 1","+","+# The queue is measured in request units.","+sizer: requests","+","+# The queue admits 10 requests.","+queue_size: 10","+","+# Backpressure: The queue blocks the caller when full until","+# canceled.","+block_on_overflow: true","+","+# Error propagation: The caller receives success immediately ","+# after the request enters the queue. Enable to wait for success","+# or failure.","+wait_for_result: false","+","+# These defaults match both batchprocessor and exporterhelper.","+batch: ","+  enabled: true","+  sizer: items","+  min_size: 8192","+  flush_timeout: 200ms","+```","+","+Refer to the [exporterhelper","+documentation](../../exporter/exporterhelper/README.md) for more","+details on this configuration structure. Other than changing the","+default configuration, the entire `queuebatch` functionality is","+available through this processor, including partitioning and storage.","+","+## Examples","+","+The following examples show two capabilities that Collector users","+frequently rely on: batching by client metadata and buffering the","+queue on disk.","+","+### Partitioning with `metadata_keys`","+","+The `metadata_keys` setting enables forming distinct batch for each","+combination of `client.Metadata` values, so that a multi-tenant","+pipeline could batch each tenant's data separately. The queue/batch","+processor offers the same behavior through the","+`batch::partition::metadata_keys` setting.","+","+```yaml","+receivers:","+  otlp:","+    protocols:","+      grpc:","+        # Capture client metadata so it is available for partitioning.","+        include_metadata: true","+","+processors:","+  queuebatch:","+    batch:","+      partition:","+        # Produce one batch per distinct tenant_id value.","+        metadata_keys:","+        - tenant_id","+","+service:","+  pipelines:","+    traces:","+      receivers: [otlp]","+      processors: [queuebatch]","+      exporters: [otlp]","+```","+","+Receivers must be configured with `include_metadata: true` so the","+metadata keys are available to the processor. An empty value and unset","+metadata are treated as distinct cases, and entries are","+case-insensitive.","+","+### Persisting the queue with a storage extension","+","+By default the queue is held in memory, so any buffered data is lost","+if the Collector stops. Set the top-level `storage` field to the ID of","+a [storage extension][filestorage] to persist the queue on disk, so","+that buffered data is recovered and exporting continues after a","+restart.","+","+```yaml","+extensions:","+  file_storage:","+    directory: /var/lib/otelcol/queuebatch","+","+processors:","+  queuebatch:","+    # Persist the queue using the file_storage extension.","+    storage: file_storage","+","+service:","+  extensions: [file_storage]","+  pipelines:","+    logs:","+      receivers: [otlp]","+      processors: [queuebatch]","+      exporters: [otlp]","+```","+","+When `storage` is set there is no in-memory queue. Each request is","+serialized as it enters the queue and read back from disk before","+export. The `wait_for_result` setting is not supported together with","+`storage`.","+","+[filestorage]: https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage"],"additions":131,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/config.go","lines":["@@ -0,0 +1,11 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package queuebatchprocessor // import \"go.opentelemetry.io/collector/processor/queuebatchprocessor\"","+","+import (","+\t\"go.opentelemetry.io/collector/exporter/exporterhelper\"","+)","+","+// Config is queue/batch processor configuration shared with exporterhelper.","+type Config = exporterhelper.QueueBatchConfig"],"additions":11,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/config_test.go","lines":["@@ -0,0 +1,22 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package queuebatchprocessor","+","+import (","+\t\"path/filepath\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"go.opentelemetry.io/collector/confmap/confmaptest\"","+)","+","+func TestUnmarshalConfig(t *testing.T) {","+\tcm, err := confmaptest.LoadConf(filepath.Join(\"testdata\", \"config.yaml\"))","+\trequire.NoError(t, err)","+\tcfg := NewFactory().CreateDefaultConfig()","+\trequire.NoError(t, cm.Unmarshal(&cfg))","+\tassert.Equal(t, createDefaultConfig(), cfg)","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/doc.go","lines":["@@ -0,0 +1,8 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+//go:generate mdatagen metadata.yaml","+","+// Package queuebatchprocessor implements a processor that queues and batches","+// using the same implementation as exporterhelper.","+package queuebatchprocessor // import \"go.opentelemetry.io/collector/processor/queuebatchprocessor\""],"additions":8,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/factory.go","lines":["@@ -0,0 +1,62 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+//go:generate mdatagen metadata.yaml","+","+package queuebatchprocessor // import \"go.opentelemetry.io/collector/processor/queuebatchprocessor\"","+","+import (","+\t\"context\"","+","+\t\"go.opentelemetry.io/collector/component\"","+\t\"go.opentelemetry.io/collector/consumer\"","+\t\"go.opentelemetry.io/collector/consumer/xconsumer\"","+\t\"go.opentelemetry.io/collector/exporter/exporterhelper\"","+\t\"go.opentelemetry.io/collector/processor\"","+\t\"go.opentelemetry.io/collector/processor/queuebatchprocessor/internal/metadata\"","+\t\"go.opentelemetry.io/collector/processor/xprocessor\"","+)","+","+// NewFactory returns a new factory for the queue/batch processor.","+func NewFactory() processor.Factory {","+\treturn xprocessor.NewFactory(","+\t\tmetadata.Type,","+\t\tcreateDefaultConfig,","+\t\txprocessor.WithTraces(createTraces, metadata.TracesStability),","+\t\txprocessor.WithMetrics(createMetrics, metadata.MetricsStability),","+\t\txprocessor.WithLogs(createLogs, metadata.LogsStability),","+\t\txprocessor.WithProfiles(createProfiles, metadata.ProfilesStability),","+\t)","+}","+","+// createDefaultConfig returns the default configuration, modified","+// from exporterhelper.NewDefaultQueueConfig() to enable backpressure,","+// limit concurrency to 1, w/ queue-size 10.","+func createDefaultConfig() component.Config {","+\tcfg := exporterhelper.NewDefaultQueueConfig()","+","+\t// These are all different from exporterhelper.","+\tcfg.BlockOnOverflow = true","+\tcfg.NumConsumers = 1","+\tcfg.QueueSize = 10","+","+\t// Enable batching with default settings.","+\t_ = cfg.Batch.GetOrInsertDefault()","+\treturn &cfg","+}","+","+func createTraces(ctx context.Context, set processor.Settings, cfg component.Config, next consumer.Traces) (processor.Traces, error) {","+\treturn newTracesProcessor(ctx, set, cfg.(*Config), next)","+}","+","+func createMetrics(ctx context.Context, set processor.Settings, cfg component.Config, next consumer.Metrics) (processor.Metrics, error) {","+\treturn newMetricsProcessor(ctx, set, cfg.(*Config), next)","+}","+","+func createLogs(ctx context.Context, set processor.Settings, cfg component.Config, next consumer.Logs) (processor.Logs, error) {","+\treturn newLogsProcessor(ctx, set, cfg.(*Config), next)","+}","+","+func createProfiles(ctx context.Context, set processor.Settings, cfg component.Config, next xconsumer.Profiles) (xprocessor.Profiles, error) {","+\treturn newProfilesProcessor(ctx, set, cfg.(*Config), next)","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"processor/queuebatchprocessor/generated_component_test.go","lines":["@@ -0,0 +1,176 @@","+// Code generated by mdatagen. DO NOT EDIT.","+","+package queuebatchprocessor","+","+import (","+\t\"context\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"go.opentelemetry.io/collector/component\"","+\t\"go.opentelemetry.io/collector/component/componenttest\"","+\t\"go.opentelemetry.io/collector/confmap/confmaptest\"","+\t\"go.opentelemetry.io/collector/consumer/consumertest\"","+\t\"go.opentelemetry.io/collector/pdata/pcommon\"","+\t\"go.opentelemetry.io/collector/pdata/plog\"","+\t\"go.opentelemetry.io/collector/pdata/pmetric\"","+\t\"go.opentelemetry.io/collector/pdata/ptrace\"","+\t\"go.opentelemetry.io/collector/processor\"","+\t\"go.opentelemetry.io/collector/processor/processortest\"","+\t\"go.opente