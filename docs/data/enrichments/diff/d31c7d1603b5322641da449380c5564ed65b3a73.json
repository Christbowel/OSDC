defined {","+  const hasWhitespace = /\\s/.test(url)","+  if (hasWhitespace) {","+    return `${label} can't contain spaces`","+  }","+","+  const hasBackslash = url.includes('\\\\')","+  if (hasBackslash) {","+    return `${label} can't contain backslashes`","+  }","+","+  return undefined","+}","+","+const INVALID_SITE_URL_MESSAGE = 'Please provide a valid URL, such as https://example.com'","+","+const UNSAFE_SITE_URL_PROTOCOLS = ['javascript:', 'data:', 'file:', 'vbscript:']","+","+export function getSiteUrlError(url: string): string | undefined {","+  const characterError = getUrlCharacterError(url, 'Site URL')","+  if (characterError) {","+    return characterError","+  }","+","+  const hasWildcard = url.includes('*')","+  if (hasWildcard) {","+    return \"Site URL can't contain wildcards\"","+  }","+","+  const isParsable = URL.canParse(url)","+  if (!isParsable) {","+    return INVALID_SITE_URL_MESSAGE","+  }","+","+  const { protocol, hostname } = new URL(url)","+  const isUnsafeProtocol = UNSAFE_SITE_URL_PROTOCOLS.includes(protocol)","+  if (isUnsafeProtocol) {","+    return `Site URL can't use the ${protocol} protocol`","+  }","+","+  // `localhost:3000` parses with `localhost:` as its scheme, so require `scheme://`","+  const hasAuthority = url.slice(protocol.length).startsWith('//')","+  const isWebUrl = protocol === 'http:' || protocol === 'https:'","+  const isMissingHost = !hasAuthority || (isWebUrl && hostname.length === 0)","+  if (isMissingHost) {","+    return INVALID_SITE_URL_MESSAGE","+  }","+","+  return undefined","+}","+"," export function normalizeRedirectUrl(url: string): string {","   return url.trim().replace(/\\s*,\\s*$/, '')"," }"],"additions":57,"deletions":2,"truncated":false},{"path":"apps/studio/components/interfaces/Auth/AuthProvidersFormValidation.test.ts","lines":["@@ -0,0 +1,77 @@","+import { describe, expect, it } from 'vitest'","+","+import { PROVIDERS_SCHEMAS } from './AuthProvidersFormValidation'","+","+const URL_FIELDS = [