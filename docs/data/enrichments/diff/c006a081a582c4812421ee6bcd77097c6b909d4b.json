-a\", \"foo\", denyRouteA),","+\t\tnewConfig(\"allow-b\", \"foo\", allowRouteB),","+\t\tnewConfig(\"audit-a\", \"foo\", auditRouteA),","+\t\tnewConfig(\"workload-wide\", \"foo\", workloadWide),","+\t\t// Same route name in a different namespace must be a distinct key.","+\t\tnewConfig(\"allow-a-other-ns\", \"bar\", allowRouteA),","+\t}","+\tauthzPolicies := createFakeAuthorizationPolicies(configs)","+","+\tcases := []struct {","+\t\tname      string","+\t\troute     types.NamespacedName","+\t\twantAllow []string","+\t\twantDeny  []string","+\t}{","+\t\t{","+\t\t\tname:      \"allow and deny targeting the route\",","+\t\t\troute:     types.NamespacedName{Name: \"route-a\", Namespace: \"foo\"},","+\t\t\twantAllow: []string{\"allow-a\"},","+\t\t\twantDeny:  []string{\"deny-a\"},","+\t\t},","+\t\t{","+\t\t\tname:      \"only allow targeting the route\",","+\t\t\troute:     types.NamespacedName{Name: \"route-b\", Namespace: \"foo\"},","+\t\t\twantAllow: []string{\"allow-b\"},","+\t\t},","+\t\t{","+\t\t\tname:      \"route in another namespace is a distinct key\",","+\t\t\troute:     types.NamespacedName{Name: \"route-a\", Namespace: \"bar\"},","+\t\t\twantAllow: []string{\"allow-a-other-ns\"},","+\t\t},","+\t\t{","+\t\t\tname:  \"unknown route has no policies\",","+\t\t\troute: types.NamespacedName{Name: \"missing\", Namespace: \"foo\"},","+\t\t},","+\t\t{","+\t\t\tname:  \"zero value route has no policies\",","+\t\t\troute: types.NamespacedName{},","+\t\t},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tgot := authzPolicies.ListAuthorizationPoliciesForHTTPRoute(tc.route)","+\t\t\tassertPolicyNames(t, \"allow\", got.Allow, tc.wantAllow)","+\t\t\tassertPolicyNames(t, \"deny\", got.Deny, tc.wantDeny)","+\t\t\t// Only ALLOW/DENY are valid for HTTPRoute targetRefs."],"additions":75,"deletions":0,"truncated":false}],"additions":628,"deletions":46,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-01T15:00:11.702