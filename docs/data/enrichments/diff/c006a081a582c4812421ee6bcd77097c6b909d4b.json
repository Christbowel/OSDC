fmt.Errorf(\"unexpected type for HTTPRoute origins: %T\", rawOrigins)","+\t}","+","+\tif len(origins) != len(virtualService.Http) {","+\t\treturn nil, fmt.Errorf(\"HTTPRoute origins count does not equal route count\")","+\t}","+","+\treturn slices.Clone(origins), nil","+}","+","+func sortHTTPRoutesWithOrigins(routes []*istio.HTTPRoute, origins []types.NamespacedName) {","+\ttype routeOriginPair struct {","+\t\troute  *istio.HTTPRoute","+\t\torigin types.NamespacedName","+\t}","+","+\tpairs := make([]routeOriginPair, len(routes))","+\tfor i := range routes {","+\t\tpairs[i] = routeOriginPair{routes[i], origins[i]}","+\t}","+","+\tsort.SliceStable(pairs, func(i, j int) bool {","+\t\treturn httpRouteLess(pairs[i].route, pairs[j].route)","+\t})","+","+\tfor i := range pairs {","+\t\troutes[i] = pairs[i].route","+\t\torigins[i] = pairs[i].origin","+\t}","+}"],"additions":83,"deletions":2,"truncated":false},{"path":"pilot/pkg/config/kube/gateway/route_collections_test.go","lines":["@@ -0,0 +1,224 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package gateway","+","+import (","+\t\"testing\"","+","+\t\"k8s.io/apimachinery/pkg/types\"","+","+\tistio \"istio.io/api/networking/v1alpha3\"","+\t\"istio.io/istio/pilot/pkg/features\"","+\t\"istio.io/istio/pkg/config\"","+\t\"istio.io/istio/pkg/config/constants\"","+\t\"istio.io/istio/pkg/test\"","+)","+","+// uriRoute builds an HTTPRoute with a single URI match of the given type.","+func uriRoute(name string, uri *istio.StringMatch) *istio.HTTPRoute {","+\treturn &istio.HTTPRoute{","+\t\tName:  name,","+\t\tMatch: []*istio.HTTPMatchRequest{{Uri: uri}},","+\t}","+}","+","+func exactURI(v string) *istio.StringMatch {","+\treturn &istio.StringMatch{MatchType: &istio.StringMatch_Exact{Exact: v}}","+}","+","+func prefixURI(v string) *istio.StringMatch {","+\treturn &istio.StringMatch{MatchType: &istio.StringMatch_Prefix{Prefix: v}}","+}","+","+func regexURI(v string) *istio.StringMatch {","+\treturn &istio.StringMatch{MatchType: &istio.StringMatch_Regex{Regex: v}}","+}","+","+func TestCloneHTTPRouteOrigins(t *testing.T) {","+\ttest.SetForTest(t, &features.EnableGatewayAPIHTTPRouteAuth, true)","+\torigins := func(nn ...types.NamespacedName) []types.NamespacedName { return nn }","+\tvs := func(n int) *istio.VirtualService {","+\t\troutes := make([]*istio.HTTPRoute, n)","+\t\tfor i := range routes {","+\t\t\troutes[i] = &istio.HTTPRoute{}","+\t\t}","+\t\treturn &istio.VirtualService{Http: routes}","+\t}","+","+\tcases := []struct {","+\t\tname    string","+\t\tcfg     config.Config","+\t\twant    []types.NamespacedName","+\t\twantErr bool","+\t}{","+\t\t{","+\t\t\t// GRPCRoute / native VirtualService path: no origins recorded in Extra.","+\t\t\t// Fall back to a zero-value origin per route so downstream stays in lockstep.","+\t\t\tname: \"extra absent returns zero-value origins\",","+\t\t\tcfg: config.Config{","+\t\t\t\tSpec: vs(2),","+\t\t\t},","+\t\t\twant: origins(types.NamespacedName{}, types.NamespacedName{}),","+\t\t},","+\t\t{","+\t\t\tname: \"matching length returns origins\",","+\t\t\tcfg: config.Config{","+\t\t\t\tSpec: vs(2),","+\t\t\t\tExtra: map[string]any{","+\t\t\t\t\tconstants.ConfigExtraHTTPRouteOrigins: origins(","+\t\t\t\t\t\ttypes.NamespacedName{Name: \"a\", Namespace: \"ns\"},","+\t\t\t\t\t\ttypes.NamespacedName{Name: \"b\", Namespace: \"ns\"},","+\t\t\t\t\t),","+\t\t\t\t},","+\t\t\t},","+\t\t\twant: origins(","+\t\t\t\ttypes.NamespacedName{Name: \"a\", Namespace: \"ns\"},","+\t\t\t\ttypes.NamespacedName{Name: \"b\", Namespace: \"ns\"},","+\t\t\t),","+\t\t},","+\t\t{","+\t\t\tname: \"wrong type errors\",","+\t\t\tcfg: config.Config{","+\t\t\t\tSpec: vs(1),","+\t\t\t\tExtra: map[string]any{","+\t\t\t\t\tconstants.ConfigExtraHTTPRouteOrigins: []string{\"not-a-namespaced-name\"},","+\t\t\t\t},","+\t\t\t},","+\t\t\twantErr: true,","+\t\t},","+\t\t{","+\t\t\tname: \"length mismatch errors\",","+\t\t\tcfg: config.Config{","+\t\t\t\tSpec: vs(2),","+\t\t\t\tExtra: map[string]any{","+\t\t\t\t\tconstants.ConfigExtraHTTPRouteOrigins: origins(","+\t\t\t\t\t\ttypes.NamespacedName{Name: \"a\", Namespace: \"ns\"},","+\t\t\t\t\t),","+\t\t\t\t},","+\t\t\t},","+\t\t\twantErr: true,","+\t\t},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tgot, err := cloneHTTPRouteOrigins(tc.cfg)","+\t\t\tif tc.wantErr {","+\t\t\t\tif err == nil {","+\t\t\t\t\tt.Fatalf(\"expected error, got nil (origins=%v)\", got)","+\t\t\t\t}","+\t\t\t\tif got != nil {","+\t\t\t\t\tt.Fatalf(\"expected nil origins on error, got %v\", got)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t\t\t}","+\t\t\tif len(got) != len(tc.want) {","+\t\t\t\tt.Fatalf(\"length mismatch: got %d want %d\", len(got), len(tc.want))","+\t\t\t}","+\t\t\tfor i := range tc.want {","+\t\t\t\tif got[i] != tc.want[i] {","+\t\t\t\t\tt.Fatalf(\"origin[%d] = %v, want %v\", i, got[i], tc.want[i])","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+// Mutating the returned slice must not corrupt the origins stored in the source config's Extra","+// field, which is shared with the collection the config came from.","+func TestCloneHTTPRouteOriginsDoesNotAliasSource(t *testing.T) {","+\ttest.SetForTest(t, &features.EnableGatewayAPIHTTPRouteAuth, true)","+\tstored := []types.NamespacedName{","+\t\t{Name: \"a\", Namespace: \"ns\"},","+\t\t{Name: \"b\", Namespace: \"ns\"},","+\t}","+\tcfg := config.Config{","+\t\tSpec: &istio.VirtualService{Http: []*istio.HTTPRoute{{}, {}}},","+\t\tExtra: map[string]any{","+\t\t\tconstants.ConfigExtraHTTPRouteOrigins: stored,","+\t\t},","+\t}","+","+\tgot, err := cloneHTTPRouteOrigins(cfg)","+\tif err != nil {","+\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t}","+\tgot[0] = types.NamespacedName{Name: \"mutated\", Namespace: \"ns\"}","+","+\tif stored[0].Name != \"a\" {","+\t\tt.Fatalf(\"mutating returned origins corrupted source Extra: got %q, want %q\", stored[0].Name, \"a\")","+\t}","+}","+","+func TestSortHTTPRoutesWithOrigins(t *testing.T) {","+\tt.Run(\"lockstep reorder preserves route-origin pairing\", func(t *testing.T) {","+\t\t// Fed out of sorted order. Rank: Exact(3) > Prefix(2) > Regex(1).","+\t\troutes := []*istio.HTTPRoute{","+\t\t\turiRoute(\"a\", prefixURI(\"/a\")),","+\t\t\turiRoute(\"b\", exactURI(\"/b\")),","+\t\t\turiRoute(\"c\", regexURI(\"/c\")),","+\t\t}","+\t\torigins := []types.NamespacedName{","+\t\t\t{Name: \"a\"},","+\t\t\t{Name: \"b\"},","+\t\t\t{Name: \"c\"},","+\t\t}","+","+\t\tsortHTTPRoutesWithOrigins(routes, origins)","+","+\t\t// Expected order by descending rank: b (exact), a (prefix), c (regex).","+\t\twantRoutes := []string{\"b\", \"a\", \"c\"}","+\t\tfor i, name := range wantRoutes {","+\t\t\tif routes[i].Name != name {","+\t\t\t\tt.Fatalf(\"route[%d].Name = %q, want %q\", i, routes[i].Name, name)","+\t\t\t}","+\t\t\t// Each route's origin must have moved with it: by construction the","+\t\t\t// origin name equals the route name.","+\t\t\tif origins[i].Name != name {","+\t\t\t\tt.Fatalf(\"origin[%d] = %q, want %q (origin did not track its route)\", i, origins[i].Name, name)","+\t\t\t}","+\t\t}","+\t\tif len(origins) != len(routes) {","+\t\t\tt.Fatalf(\"len(origins)=%d != len(routes)=%d\", len(origins), len(routes))","+\t\t}","+\t})","+","+\tt.Run(\"stable order for equal-rank routes keeps origins paired\", func(t *testing.T) {","+\t\t// Two routes with identical rank and length: stable sort must keep input order.","+\t\troutes := []*istio.HTTPRoute{","+\t\t\turiRoute(\"first\", prefixURI(\"/same\")),","+\t\t\turiRoute(\"second\", prefixURI(\"/same\")),","+\t\t}","+\t\torigins := []types.NamespacedName{","+\t\t\t{Name: \"first\"},","+\t\t\t{Name: \"second\"},","+\t\t}","+","+\t\tsortHTTPRoutesWithOrigins(routes, origins)","+","+\t\twant := []string{\"first\", \"second\"}","+\t\tfor i, name := range want {","+\t\t\tif routes[i].Name != name {","+\t\t\t\tt.Fatalf(\"route[%d].Name = %q, want %q\", i, routes[i].Name, name)","+\t\t\t}","+\t\t\tif origins[i].Name != name {","+\t\t\t\tt.Fatalf(\"origin[%d] = %q, want %q\", i, origins[i].Name, name)","+\t\t\t}","+\t\t}","+\t})","+}"],"additions":224,"deletions":0,"truncated":false},{"path":"pilot/pkg/features/experimental.go","lines":["@@ -219,6 +219,9 @@ var ("," \tEnableGatewayAPIInferenceExtension = env.Register(\"ENABLE_GATEWAY_API_INFERENCE_EXTENSION\", false,"," \t\t\"If true, support gateway inference extension routing apis\").Get()"," ","+\tEnableGatewayAPIHTTPRouteAuth = env.Register(\"ENABLE_GATEWAY_API_HTTPROUTE_AUTH\", false,","+\t\t\"If true, support targeting Gateway API HTTPRoute resources with AuthorizationPolicy\").Get()","+"," \tEnableWildcardHostServiceEntriesForTLS = env.Register(\"ENABLE_WILDCARD_HOST_SERVICE_ENTRIES_FOR_TLS\", false,"," \t\t\"If enabled, ServiceEntries with wildcard hosts and dynamic dns resolution will be allowed for TLS traffic. \"+"," \t\t\t\"This is a security risk, susceptible to SNI spoofing, and should be used with caution. \"+"],"additions":3,"deletions":0,"truncated":false},{"path":"pilot/pkg/model/authorization.go","lines":["@@ -18,8 +18,10 @@ import ("," \t\"k8s.io/apimachinery/pkg/types\""," "," \tauthpb \"istio.io/api/security/v1beta1\"","+\t\"istio.io/istio/pilot/pkg/features\""," \t\"istio.io/istio/pkg/config/schema/gvk\""," \t\"istio.io/istio/pkg/slices\"","+\t\"istio.io/istio/pkg/util/sets\""," )"," "," type AuthorizationPolicy struct {","@@ -33,11 +35,55 @@ func (ap *AuthorizationPolicy) NamespacedName() types.NamespacedName {"," \treturn types.NamespacedName{Name: ap.Name, Namespace: ap.Namespace}"," }"," ","+func (policy *AuthorizationPolicies) indexHTTPRoutePolicies(authz AuthorizationPolicy) {","+\tif !features.EnableGatewayAPIHTTPRouteAuth {","+\t\treturn","+\t}","+\taction := authz.Spec.GetAction()","+\tisALLOW := action == authpb.AuthorizationPolicy_ALLOW","+\tisDENY := action == authpb.AuthorizationPolicy_DENY","+\tif !isALLOW && !isDENY {","+\t\t// Not a valid action for HTTPRoute targetRefs currently.","+\t\treturn","+\t}","+","+\tseenRefs := sets.New[types.NamespacedName]()","+\tfor _, ref := range GetTargetRefs(authz.Spec) {","+\t\tif !matchesGroupKind(ref, gvk.HTTPRoute) {","+\t\t\tcontinue","+\t\t}","+","+\t\tif ref.GetName() == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\t// Cross namespace references are not supported.","+\t\tif ref.GetNamespace() != \"\" && ref.GetNamespace() != authz.Namespace {","+\t\t\tcontinue","+\t\t}","+","+\t\t// Must target HTTPRoute in own namespace.","+\t\tk := types.NamespacedName{Name: ref.GetName(), Namespace: authz.Namespace}","+\t\tif !seenRefs.InsertContains(k) {","+\t\t\tresult := policy.httpRoutePolicies[k]","+\t\t\tif isALLOW {","+\t\t\t\tresult.Allow = append(result.Allow, authz)","+\t\t\t}","+\t\t\tif isDENY {","+\t\t\t\tresult.Deny = append(result.Deny, authz)","+\t\t\t}","+\t\t\tpolicy.httpRoutePolicies[k] = result","+\t\t}","+\t}","+}","+"," // AuthorizationPolicies organizes AuthorizationPolicy by namespace."," type AuthorizationPolicies struct {"," \t// Maps from namespace to the Authorization policies."," \tNamespaceToPolicies map[string][]AuthorizationPolicy `json:\"namespace_to_policies\"`"," ","+\t// Index for HTTPRoute targeted policy.","+\thttpRoutePolicies map[types.NamespacedName]AuthorizationPoliciesResult","+"," \t// The name of the root namespace. Policy in the root namespace applies to workloads in all namespaces."," \tRootNamespace string `json:\"root_namespace\"`"," }","@@ -46,6 +92,7 @@ type AuthorizationPolicies struct {"," func GetAuthorizationPolicies(env *Environment) *AuthorizationPolicies {"," \tpolicy := &AuthorizationPolicies{"," \t\tNamespaceToPolicies: map[string][]AuthorizationPolicy{},","+\t\thttpRoutePolicies:   map[types.NamespacedName]AuthorizationPoliciesResult{},"," \t\tRootNamespace:       env.Mesh().GetRootNamespace(),"," \t}"," ","@@ -68,6 +115,7 @@ func GetAuthorizationPolicies(env *Environment) *AuthorizationPolicies {"," \t\t\tpolicy.NamespaceToPolicies[config.Namespace] = make([]AuthorizationPolicy, 0, policyCount[config.Namespace])"," \t\t}"," \t\tpolicy.NamespaceToPolicies[config.Namespace] = append(policy.NamespaceToPolicies[config.Namespace], authzConfig)","+\t\tpolicy.indexHTTPRoutePolicies(authzConfig)"," \t}"," "," \treturn policy","@@ -80,6 +128,15 @@ type AuthorizationPoliciesResult struct {"," \tAudit  []AuthorizationPolicy"," }"," ","+// ListAuthorizationPoliciesForHTTPRoute returns authorization policies that explicitly target","+// the given HTTPRoute via targetRef. Limited to ALLOW and DENY actions currently.","+func (policy *AuthorizationPolicies) ListAuthorizationPoliciesForHTTPRoute(route types.NamespacedName) AuthorizationPoliciesResult {","+\tif policy == nil {","+\t\treturn AuthorizationPoliciesResult{}","+\t}","+\treturn policy.httpRoutePolicies[route]","+}","+"," // ListAuthorizationPolicies returns authorization policies applied to the workload in the given namespace."," func (policy *AuthorizationPolicies) ListAuthorizationPolicies(selectionOpts WorkloadPolicyMatcher) AuthorizationPoliciesResult {"," \tconfigs := AuthorizationPoliciesResult{}"],"additions":57,"deletions":0,"truncated":false},{"path":"pilot/pkg/model/authorization_test.go","lines":["@@ -19,16 +19,20 @@ import ("," \t\"reflect\""," \t\"testing\""," ","+\t\"k8s.io/apimachinery/pkg/types\"","+"," \t\"istio.io/api/label\"