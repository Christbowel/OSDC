{"id":"92bb7d9db8904c3d87ac9d0c8f2926ddbd216644","axis":"silent","repo":"pnpm/pnpm","sha":"92bb7d9db8904c3d87ac9d0c8f2926ddbd216644","parsed":{"files":[{"path":".changeset/pnpr-cdn-invalidation.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+Added `cloudflareCdn` to purge cached public packages after publishes, unpublishes, deprecations, and access-rule changes. The Cloudflare cache example serves anonymous cache hits without contacting the registry and limits cached responses to five minutes. [Issue](https://github.com/zkochan/pnpm-tasks/issues/56)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/tests.rs","lines":["@@ -662,10 +662,11 @@ async fn libsql_tokens_persist_scopes_and_kind() {"," #[tokio::test]"," async fn libsql_schema_migrations_refuses_future_version() {","     let backend = local_backend(MaxUsers::Unlimited).await;","+    let future = pnpr_sql::schema::SCHEMA_VERSION + 1;","     backend.pool","         .connect()","         .unwrap()","-        .execute(\"INSERT INTO schema_migrations (version) VALUES (2)\", ())","+        .execute(\"INSERT INTO schema_migrations (version) VALUES (?1)\", [future])","         .await","         .unwrap();"," ","@@ -676,7 +677,7 @@ async fn libsql_schema_migrations_refuses_future_version() {","     .unwrap_err();","     let err_str = err.to_string();","     assert!(","-        err_str.contains(\"schema version 2\"),","+        err_str.contains(&format!(\"schema version {future}\")),","         \"expected error about newer version, got: {err_str}\",","     );"," }"],"additions":3,"deletions":2,"truncated":false},{"path":"pnpr/crates/auth/src/tests.rs","lines":["@@ -1013,22 +1013,26 @@ async fn incompatible_auth_databases_are_refused_without_migration() {"," "," #[tokio::test]"," async fn schema_migrations_refuses_future_schema_version() {","+    let future = pnpr_sql::schema::SCHEMA_VERSION + 1;","     let tmp = tempfile::tempdir().unwrap();","     let path = tmp.path().join(\"tokens.db\");"," ","     {","         let conn = rusqlite::Connection::open(&path).unwrap();","         conn.execute_batch(","-            \"CREATE TABLE schema_migrations (version INTEGER NOT NULL PRIMARY KEY) STRICT;","-             INSERT INTO schema_migrations (version) VALUES (1), (2);\",","+            \"CREATE TABLE schema_migrations (version INTEGER NOT NULL PRIMARY KEY) STRICT;\",","         )","         .unwrap();","+        for version in 1..=future {","+            conn.execute(\"INSERT INTO schema_migrations (version) VALUES (?1)\", [version])","+                .unwrap();","+        }","     }"," ","     let err = TokenStore::open(path).unwrap_err();","     let err_str = err.to_string();","     assert!(","-        err_str.contains(\"schema version 2\"),","+        err_str.contains(&format!(\"schema version {future}\")),","         \"expected error about newer version, got: {err_str}\",","     );"," }"],"additions":7,"deletions":3,"truncated":false},{"path":"pnpr/crates/config/src/cdn.rs","lines":["@@ -0,0 +1,51 @@","+use serde::Deserialize;","+use std::fmt;","+","+/// Credentials for global purges of the Cloudflare zone serving the registry.","+#[derive(Clone, Deserialize)]","+#[serde(rename_all = \"camelCase\", deny_unknown_fields)]","+pub struct CloudflareCdnConfig {","+    pub zone_id: String,","+    pub api_token: String,","+    /// A tag unique to this registry deployment within the zone.","+    pub cache_tag: String,","+}","+","+impl fmt::Debug for CloudflareCdnConfig {","+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {","+        formatter","+            .debug_struct(\"CloudflareCdnConfig\")","+            .field(\"zone_id\", &self.zone_id)","+            .field(\"api_token\", &\"[redacted]\")","+            .field(\"cache_tag\", &self.cache_tag)","+            .finish()","+    }","+}","+","+pub(super) fn build(","+    file: Option<CloudflareCdnConfig>,","+) -> pnpr_error::Result<Option<CloudflareCdnConfig>> {","+    let Some(config) = file else { return Ok(None) };","+    if config.zone_id.len() != 32 || !config.zone_id.bytes().all(|byte| byte.is_ascii_hexdigit()) {","+        return Err(invalid(\"cloudflareCdn.zoneId must be a 32-character hexadecimal zone ID\"));","+    }","+    if config.api_token.is_empty() || !config.api_token.bytes().all(|byte| byte.is_ascii_graphic())","+    {","+        return Err(invalid(\"cloudflareCdn.apiToken must be a nonempty token without whitespace\"));","+    }","+    if config.cache_tag.is_empty()","+        || config.cache_tag.len() > 100","+        || !config.cache_tag","+            .bytes()","+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))","+    {","+        return Err(invalid(","+            \"cloudflareCdn.cacheTag must contain 1 to 100 ASCII letters, digits, hyphens, or underscores\",","+        ));","+    }","+    Ok(Some(config))","+}","+","+fn invalid(reason: &str) -> pnpr_error::RegistryError {","+    pnpr_error::RegistryError::InvalidConfig { reason: reason.to_string() }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/config_file.rs","lines":["@@ -228,6 +228,8 @@ pub(super) struct ConfigFile {","     /// pnpr-only: how pnpr's own package document is served.","     #[serde(default)]","     pub(super) package_documents: Option<PackageDocumentsFile>,","+    #[serde(default)]","+    pub(super) cloudflare_cdn: Option<super::CloudflareCdnConfig>,","     /// pnpr-only: how the release records of hosted versions are logged.","     #[serde(default)]","     pub(super) release_records: Option<ReleaseRecordsFile>,"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -12,6 +12,7 @@ pub use backend_config::{","     TokensConfig, UsersConfig,"," };"," pub use byte_size::{ByteSize, parse_byte_size};","+pub use cdn::CloudflareCdnConfig;"," pub use gc::GcConfig;"," pub use hosted::{HostedConfig, Management};"," pub use ip_network::{IpNetwork, parse_trusted_proxies};","@@ -44,6 +45,7 @@ mod backend_config;"," use backend_config::build_identity_config;"," "," mod byte_size;","+mod cdn;"," "," mod config_file;"," use config_file::{","@@ -239,6 +241,7 @@ pub struct HttpConfig {","     pub metrics: Option<MetricsConfig>,","     /// How pnpr's own package document is served.","     pub package_documents: PackageDocumentsConfig,","+    pub cloudflare_cdn: Option<CloudflareCdnConfig>,"," }"," "," impl HttpConfig {"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/loading.rs","lines":["@@ -308,6 +308,7 @@ fn build_http_config(","         request_timeout,","         metrics: build_metrics_config(file, listen)?,","         package_documents: super::build_package_documents_config(file.package_documents.take())?,","+        cloudflare_cdn: super::cdn::build(file.cloudflare_cdn.take())?,","     })"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/secrets.rs","lines":["@@ -1,6 +1,6 @@"," use std::sync::Arc;"," ","-use pnpm_env_replace::{EnvVar, env_replace_lossy};","+use pnpm_env_replace::{EnvVar, env_replace_lossy, placeholder_ranges};"," use pnpr_error::RegistryError;"," use sha2::{Digest, Sha256};"," ","@@ -251,18 +251,66 @@ fn validate_registry_secrets<Sys: EnvVar>(val: &serde_json::Value) -> Result<(),"," }"," "," pub(crate) fn validate_secret_env_vars<Sys: EnvVar>(raw: &str) -> Result<(), RegistryError> {","-    let Ok(val) = serde_saphyr::from_str::<serde_json::Value>(raw) else {","-        return Ok(());","-    };","-    validate_root_secrets::<Sys>(&val)?;","-    validate_release_record_secrets::<Sys>(&val)?;","-    validate_s3_secrets::<Sys>(&val)?;","-    validate_auth_secrets::<Sys>(&val)?;","-    validate_database_secrets::<Sys>(&val)?;","-    validate_registry_secrets::<Sys>(&val)?;","+    if let Ok(value) = serde_saphyr::from_str(raw) {","+        return validate_secret_fields::<Sys>(&value);","+    }","+    let (expanded, _) = env_replace_lossy::<Sys>(raw);","+    let mut marker = \"__pnpr_unresolved_env__\".to_string();","+    while raw.contains(&marker) || expanded.contains(&marker) {","+        marker.push('_');","+    }","+    for range in placeholder_ranges(raw) {","+        let placeholder = &raw[range.clone()];","+        if env_replace_lossy::<Sys>(placeholder).1.is_empty() {","+            continue;","+        }","+        let mut marked = raw.to_string();","+        marked.replace_range(range, &marker);","+        let (expanded, _) = env_replace_lossy::<Sys>(&marked);","+        let Ok(mut value) = serde_saphyr::from_str(&expanded) else { continue };","+        restore_unresolved_placeholder(&mut value, &marker, placeholder);","+        validate_secret_fields::<Sys>(&value)?;","+    }","     Ok(())"," }"," ","+fn validate_secret_fields<Sys: EnvVar>(val: &serde_json::Value) -> Result<(), RegistryError> {","+    if let Some(token) = val.pointer(\"/cloudflareCdn/apiToken\").and_then(serde_json::Value::as_str)","+    {","+        check_secret_env_field::<Sys>(\"cloudflareCdn.apiToken\", token)?;","+    }","+    validate_root_secrets::<Sys>(val)?;","+    validate_release_record_secrets::<Sys>(val)?;","+    validate_s3_secrets::<Sys>(val)?;","+    validate_auth_secrets::<Sys>(val)?;","+    validate_database_secrets::<Sys>(val)?;","+    validate_registry_secrets::<Sys>(val)?;","+    Ok(())","+}","+","+fn restore_unresolved_placeholder(value: &mut serde_json::Value, marker: &str, placeholder: &str) {","+    match value {","+        serde_json::Value::String(text) => {","+            // Resolved environment values are literal, not another substitution pass.","+            *text = text","+                .replace('\\\\', r\"\\\\\")","+                .replace(\"${\", r\"\\${\")","+                .replace(marker, placeholder);","+        }","+        serde_json::Value::Array(values) => {","+            for value in values {","+                restore_unresolved_placeholder(value, marker, placeholder);","+            }","+        }","+        serde_json::Value::Object(values) => {","+            for value in values.values_mut() {","+                restore_unresolved_placeholder(value, marker, placeholder);","+            }","+        }","+        _ => {}","+    }","+}","+"," fn check_secret_env_field<Sys: EnvVar>(field: &str, raw_val: &str) -> Result<(), RegistryError> {","     let (_, unresolved) = env_replace_lossy::<Sys>(raw_val);","     if !unresolved.is_empty() {"],"additions":58,"deletions":10,"truncated":false},{"path":"pnpr/crates/config/src/tests/file_loading.rs","lines":["@@ -498,6 +498,10 @@ registries:"," #[test]"," fn secret_bearing_fields_reject_unresolved_env_vars() {","     let cases = [","+        (","+            \"cloudflareCdn.apiToken\",","+            \"cloudflareCdn:\\n  apiToken: prefix-${PNPR_TEST_UNRESOLVED_VAR_123}\\n\",","+        ),","         (\"secret\", \"secret: ${PNPR_TEST_UNRESOLVED_VAR_123}\\n\"),","         (\"secrets.cache\", \"secrets:\\n  cache: ${PNPR_TEST_UNRESOLVED_VAR_123}\\n\"),","         (\"secrets.oci\", \"secrets:\\n  oci: ${PNPR_TEST_UNRESOLVED_VAR_123}\\n\"),","@@ -593,3 +597,82 @@ secrets:","     assert_eq!(config.oci_secret.as_ref(), b\"my-explicit-oci-secret-32-bytes!!\");","     assert_eq!(config.cache_secret.len(), 32);"," }","+","+#[test]","+fn unresolved_secret_in_a_flow_mapping_is_rejected() {","+    let yaml = r#\"cloudflareCdn: { zoneId: \"00000000000000000000000000000000\", apiToken: prefix-${PNPR_TEST_UNRESOLVED_VAR_123}, cacheTag: example }\"#;","+    let error = Config::from_yaml_str(yaml, Path::new(\"/x\"), listen(), None).unwrap_err();","+    let reason = error.to_string();","+    assert!(reason.contains(\"PNPR_TEST_UNRESOLVED_VAR_123\"), \"{reason}\");","+    assert!(!reason.contains(\"prefix-\"), \"the credential must not appear in the diagnostic\");","+    let with_default = yaml.replace(","+        \"${PNPR_TEST_UNRESOLVED_VAR_123}\",","+        \"${PNPR_TEST_UNRESOLVED_VAR_123:-fallback}\",","+    );","+    let config = Config::from_yaml_str(&with_default, Path::new(\"/x\"), listen(), None).unwrap();","+    assert_eq!(config.http.cloudflare_cdn.unwrap().api_token, \"prefix-fallback\");","+}","+","+#[test]","+fn optional_nonsecret_variables_in_flow_mappings_remain_optional() {","+    let yaml = r#\"{ storage: ${PNPR_TEST_UNRESOLVED_VAR_123}./store, cloudflareCdn: { zoneId: \"00000000000000000000000000000000\", apiToken: prefix-${PNPR_TEST_UNRESOLVED_VAR_123:-fallback}, cacheTag: example } }\"#;","+    let config = Config::from_yaml_str(yaml, Path::new(\"/x\"), listen(), None).unwrap();","+    assert!(config.storage.hosted_dir.ends_with(\"store\"));","+    assert_eq!(config.http.cloudflare_cdn.unwrap().api_token, \"prefix-fallback\");","+}","+","+#[test]","+fn expanded_yaml_fragments_do_not_hide_unresolved_secrets() {","+    struct FragmentEnv;","+    impl pnpm_env_replace::EnvVar for FragmentEnv {","+        fn var(name: &str) -> Option<String> {","+            (name == \"CONFIG_FRAGMENT\").then(|| \"storage: /tmp/store\".to_string())","+        }","+    }","+    let raw = r#\"${CONFIG_FRAGMENT}","+cloudflareCdn: { zoneId: \"00000000000000000000000000000000\", apiToken: prefix-${CF_TOKEN}, cacheTag: example }","+\"#;","+    let error = crate::secrets::validate_secret_env_vars::<FragmentEnv>(raw).unwrap_err();","+    let message = error.to_string();","+    assert!(message.contains(\"cloudflareCdn.apiToken\"));","+    assert!(message.contains(\"CF_TOKEN\"));","+    assert!(!message.contains(\"prefix-\"));","+    let optional = raw.replace(\"prefix-${CF_TOKEN}\", \"${CF_TOKEN-example-token}\");","+    crate::secrets::validate_secret_env_vars::<FragmentEnv>(&optional).unwrap();","+}","+","+#[test]","+fn unset_yaml_fragments_do_not_hide_unresolved_secrets() {","+    struct EmptyEnv;","+    impl pnpm_env_replace::EnvVar for EmptyEnv {","+        fn var(_: &str) -> Option<String> {","+            None","+        }","+    }","+    let raw = r#\"${UNSET_NON_SECRET}","+cloudflareCdn: { zoneId: \"00000000000000000000000000000000\", apiToken: prefix-${CF_TOKEN}, cacheTag: example }","+\"#;","+    let error = crate::secrets::validate_secret_env_vars::<EmptyEnv>(raw).unwrap_err();","+    assert!(error.to_string().contains(\"cloudflareCdn.apiToken\"));","+    let optional = raw.replace(\"prefix-${CF_TOKEN}\", \"example-token\");","+    crate::secrets::validate_secret_env_vars::<EmptyEnv>(&optional).unwrap();","+}","+","+#[test]","+fn flow_mapping_validation_does_not_expand_resolved_secrets_twice() {","+    struct LiteralEnv;","+    impl pnpm_env_replace::EnvVar for LiteralEnv {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"ROOT_SECRET\" => Some(r\"a-long-root-secret-${INNER}-literal-\\${ESCAPED}\".into()),","+                \"CF_TOKEN\" => Some(\"example-token\".into()),","+                _ => None,","+            }","+        }","+    }","+    let raw = r#\"secret: ${ROOT_SECRET}","+ui: { dir: ${OPTIONAL_DIR} }","+cloudflareCdn: { zoneId: \"00000000000000000000000000000000\", apiToken: ${CF_TOKEN}, cacheTag: example }","+\"#;","+    crate::secrets::validate_secret_env_vars::<LiteralEnv>(raw).unwrap();","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/tests/server_options.rs","lines":["@@ -562,3 +562,19 @@ fn gc_refuses_unknown_keys() {","     let result = Config::from_yaml_str(\"gc:\\n  leese: 1h\\n\", Path::new(\"/config\"), listen(), None);","     assert!(matches!(result, Err(RegistryError::InvalidConfig { .. })), \"{result:?}\");"," }","+","+#[test]","+fn cloudflare_cdn_validates_identifiers_and_redacts_credentials() {","+    let yaml = \"cloudflareCdn:\\n  zoneId: '0123456789abcdef0123456789abcdef'\\n  apiToken: secret-token\\n  cacheTag: example-registry\\n\";","+    let config = Config::from_yaml_str(yaml, Path::new(\"/config\"), listen(), None).unwrap();","+    let cdn = config.http.cloudflare_cdn.unwrap();","+    assert_eq!(cdn.cache_tag, \"example-registry\");","+    assert!(!format!(\"{cdn:?}\").contains(\"secret-token\"));","+    for invalid in [","+        yaml.replace(\"example-registry\", \"bad,tag\"),","+        yaml.replace(\"secret-token\", \"'bad token'\"),","+        yaml.replace(\"0123456789abcdef0123456789abcdef\", \"../other\"),","+    ] {","+        assert!(Config::from_yaml_str(&invalid, Path::new(\"/config\"), listen(), None).is_err());","+    }","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr-fixtures/src/presets.rs","lines":["@@ -181,6 +181,7 @@ pub fn static_serve_config(listen: SocketAddr, storage: PathBuf) -> Config {"," "," fn http_config(listen: SocketAddr) -> pnpr_config::HttpConfig {","     pnpr_config::HttpConfig {","+        cloudflare_cdn: None,","         listen,","         public_url: format!(\"http://{listen}\"),","         cors: CorsConfig::default(),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -249,6 +249,7 @@ const MAX_ARTIFACT_BLOB_BODY_BYTES: usize = 8 * 1024;"," /// under this in practice, with the ceiling guarding against a hostile"," /// client rather than a large workspace."," const MAX_PIPELINE_RUN_BODY_BYTES: usize = 4 * 1024 * 1024;","+mod cdn;"," mod state;"," use state::AppInner;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/cdn.rs","lines":["@@ -0,0 +1,137 @@","+use super::{AppState, RegistryError, ecosystem::sha256_hex};","+use pnpr_config::CloudflareCdnConfig;","+use pnpr_storage::{Storage, metadata::CdnInvalidation};","+use std::{sync::Arc, time::Duration};","+","+pub(super) fn public_tarball_response(","+    mut response: axum::response::Response,","+) -> axum::response::Response {","+    use axum::http::{HeaderValue, header};","+    if response.status().is_success()","+        && response","+            .headers()","+            .get(header::CONTENT_TYPE)","+            .is_some_and(|value| {","+                value == \"application/octet-stream\" || value == \"application/x-tar\"","+            })","+        && !response.headers().contains_key(header::CACHE_CONTROL)","+    {","+        response","+            .headers_mut()","+            .insert(header::CACHE_CONTROL, HeaderValue::from_static(\"public, max-age=300\"));","+    }","+    response","+}","+","+const RETRY_INTERVAL: Duration = Duration::from_secs(5);","+","+pub(super) fn start(state: &AppState) -> Result<(), RegistryError> {","+    let Some(config) = state.inner.config.http.cloudflare_cdn.clone() else { return Ok(()) };","+    let client = reqwest::Client::builder()","+        .redirect(reqwest::redirect::Policy::none())","+        .timeout(Duration::from_secs(15))","+        .build()","+        .map_err(|_| RegistryError::Internal {","+            reason: \"could not initialize CDN invalidation\".to_string(),","+        })?;","+    let weak = Arc::downgrade(&state.inner);","+    tokio::spawn(async move {","+        let mut enabled = false;","+        loop {","+            let Some(inner) = weak.upgrade() else { break };","+            let storage = inner.storage.clone();","+            drop(inner);","+            if !enabled {","+                enabled = subscribe(&storage, &config).await;","+            }","+            if enabled && let Err(reason) = deliver(&storage, &client, &config).await {","+                tracing::error!(%reason, \"CDN purge failed; pending invalidations will be retried\");","+            }","+            tokio::time::sleep(RETRY_INTERVAL).await;","+        }","+    });","+    Ok(())","+}","+","+async fn subscribe(storage: &Storage, config: &CloudflareCdnConfig) -> bool {","+    let target = format!(\"{}:{}\", config.zone_id, config.cache_tag);","+    match storage.enable_cdn_invalidations(&target).await {","+        Ok(()) => true,","+        Err(error) => {","+            tracing::error!(%error, \"could not record CDN startup invalidation; retrying\");","+            false","+        }","+    }","+}","+","+async fn deliver(","+    storage: &Storage,","+    client: &reqwest::Client,","+    config: &CloudflareCdnConfig,","+) -> Result<(), String> {","+    let pending = storage","+        .pending_cdn_invalidations()","+        .await","+        .map_err(|_| \"could not read pending CDN invalidations\".to_string())?;","+    if pending.is_empty() {","+        return Ok(());","+    }","+    let tags = purge_tags(config, &pending);","+    let endpoint =","+        format!(\"https://api.cloudflare.com/client/v4/zones/{}/purge_cache\", config.zone_id);","+    purge(client, &endpoint, &config.api_token, tags).await?;","+    storage","+        .acknowledge_cdn_invalidations(pending)","+        .await","+        .map_err(|_| \"could not acknowledge CDN invalidations\".to_string())?;","+    Ok(())","+}","+","+fn purge_tags(config: &CloudflareCdnConfig, pending: &[CdnInvalidation]) -> Vec<String> {","+    if pending","+        .iter()","+        .any(|event| event.package == \"*\")","+    {","+        return vec![config.cache_tag.clone()];","+    }","+    pending","+        .iter()","+        .map(|event| format!(\"{}-{}\", config.cache_tag, sha256_hex(event.package.as_bytes())))","+        .collect()","+}","+","+async fn purge(","+    client: &reqwest::Client,","+    endpoint: &str,","+    token: &str,","+    tags: Vec<String>,","+) -> Result<(), String> {","+    let response = client","+        .post(endpoint)","+        .bearer_auth(token)","+        .json(&serde_json::json!({ \"tags\": tags }))","+        .send()","+        .await","+        .map_err(|error| format!(\"Cloudflare request failed: {}\", error.without_url()))?;","+    if !response.status().is_success() {","+        return Err(format!(\"Cloudflare returned HTTP {}\", response.status()));","+    }","+    #[derive(serde::Deserialize)]","+    struct Purged {","+        success: bool,","+    }","+    let body = pnpm_network::read_limited_body(response, 64 * 1024).await","+        .map_err(|_| \"could not read Cloudflare response\".to_string())?;","+    if body.truncated {","+        return Err(\"Cloudflare response exceeded 64 KiB\".to_string());","+    }","+    let result: Purged =","+        serde_json::from_slice(&body.bytes).map_err(|_| \"invalid Cloudflare response\".to_string())?;","+    if !result.success {","+        return Err(\"Cloudflare rejected the purge\".to_string());","+    }","+    Ok(())","+}","+","+#[cfg(test)]","+mod tests;"],"additions":137,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/cdn/tests.rs","lines":["@@ -0,0 +1,98 @@","+use super::{CdnInvalidation, CloudflareCdnConfig, purge, purge_tags, sha256_hex};","+","+#[tokio::test]","+async fn purge_requires_a_successful_api_result() {","+    let mut server = mockito::Server::new_async().await;","+    let client = reqwest::Client::builder()","+        .redirect(reqwest::redirect::Policy::none())","+        .build()","+        .unwrap();","+    for (status, body, expected_error) in [","+        (200, r#\"{\"success\":true}\"#, None),","+        (200, r#\"{\"success\":false}\"#, Some(\"Cloudflare rejected the purge\")),","+        (429, r#\"{\"success\":true}\"#, Some(\"Cloudflare returned HTTP 429 Too Many Requests\")),","+        (200, \"invalid\", Some(\"invalid Cloudflare response\")),","+    ] {","+        let mock = server","+            .mock(\"POST\", \"/purge\")","+            .match_header(\"authorization\", \"Bearer test-token\")","+            .match_body(mockito::Matcher::Json(serde_json::json!({\"tags\": [\"example\"]})))","+            .with_status(status)","+            .with_body(body)","+            .create_async()","+            .await;","+        let result = purge(","+            &client,","+            &format!(\"{}/purge\", server.url()),","+            \"test-token\",","+            vec![\"example\".into()],","+        )","+        .await;","+        assert_eq!(","+            result","+                .as_ref()","+                .err()","+                .map(String::as_str),","+            expected_error,","+        );","+        mock.assert_async().await;","+    }","+}","+","+#[test]","+fn package_tags_match_the_worker_and_policy_purges_cover_every_package() {","+    let config = CloudflareCdnConfig {","+        zone_id: \"0\".repeat(32),","+        api_token: \"test-token\".into(),","+        cache_tag: \"example\".into(),","+    };","+    let mut events = vec![CdnInvalidation { package: \"widget\".into(), generation: 1 }];","+    assert_eq!(purge_tags(&config, &events), vec![format!(\"example-{}\", sha256_hex(b\"widget\"))]);","+    events.push(CdnInvalidation { package: \"*\".into(), generation: 2 });","+    assert_eq!(purge_tags(&config, &events), [\"example\"]);","+}","+","+#[tokio::test]","+async fn cdn_public_tarballs_are_cacheable_and_private_responses_stay_private() {","+    use crate::server::{AppState, caller_scoped, state::AppInner, tarball_response};","+    use axum::{body::Body, http::header};","+    use pnpr_config::Config;","+    use pnpr_fixtures::MockConfigPresets;","+    use pnpr_registry::Ecosystem;","+    use std::sync::Arc;","+","+    let temp = tempfile::TempDir::new().unwrap();","+    let mut config =","+        Config::static_serve(\"127.0.0.1:0\".parse().unwrap(), temp.path().to_path_buf());","+    config.http.cloudflare_cdn = Some(CloudflareCdnConfig {","+        zone_id: \"0\".repeat(32),","+        api_token: \"test-token\".into(),","+        cache_tag: \"example\".into(),","+    });","+    let state = AppState {","+        inner: Arc::new(AppInner::new(config, pnpr_auth::AuthState::in_memory(), None).unwrap()),","+    };","+    let response = caller_scoped(","+        &state,","+        Ecosystem::Npm,","+        None,","+        Some(\"widget\"),","+        tarball_response(Body::from(\"archive\"), Some(7)),","+    );","+    assert_eq!(response.headers()[header::CACHE_CONTROL], \"public, max-age=300\");","+    assert_eq!(response.headers()[header::CONTENT_LENGTH], \"7\");","+    let private = crate::server::private_no_cache(tarball_response(Body::empty(), None));","+    assert_eq!(","+        super::public_tarball_response(private).headers()[header::CACHE_CONTROL],","+        \"private, no-store\",","+    );","+}","+","+#[test]","+fn cdn_does_not_add_cache_permission_to_incomplete_json_records() {","+    use axum::{Json, http::header, response::IntoResponse};","+    let response =","+        Json(serde_json::json!({ \"name\": \"widget\", \"version\": \"1.0.0\" })).into_response();","+    let response = super::public_tarball_response(response);","+    assert!(!response.headers().contains_key(header::CACHE_CONTROL));","+}"],"additions":98,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/ecosystem.rs","lines":["@@ -86,6 +86,11 @@ pub(super) fn caller_scoped(","         {","             private_no_cache(response)","         }","+        _ if ecosystem == Ecosystem::Npm","+            && state.inner.config.http.cloudflare_cdn.is_some() =>","+        {","+            super::cdn::public_tarball_response(response)","+        }","         _ => response,","     }"," }"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing.rs","lines":["@@ -88,6 +88,7 @@ pub(super) fn state_and_router(","     // Every router, also one an embedder builds directly, picks up what an","     // interrupted integration of the release record logs left.","     super::release_record_logs::integrate_sequenced_logs(&state);","+    super::cdn::start(&state)?;","     Ok((state, router))"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/server/tar_registry/hosted_tars.rs","lines":["@@ -182,3 +182,24 @@ async fn verify_checks_a_stored_tar_against_its_tar_integrity() {","         report.corrupted_blobs,","     );"," }","+","+#[tokio::test]","+async fn cdn_public_hosted_tar_downloads_are_cacheable() {","+    let tm