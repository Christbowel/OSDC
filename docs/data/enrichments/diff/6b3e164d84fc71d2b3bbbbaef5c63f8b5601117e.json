fig/ConfigEntityValidationTestBase.php","lines":["@@ -29,13 +29,30 @@ abstract class ConfigEntityValidationTestBase extends KernelTestBase {","   /**","    * {@inheritdoc}","    */","-  protected static $modules = ['system'];","+  protected static $modules = [","+    'system',","+    // The language module replaces the language manager. It adds no language","+    // until ::testConfigurableLanguage() creates one.","+    'language',","+  ];"," ","   /**","    * The key-value entry holding the type and the ID of the entity being tested.","    */","   private const string ENTITY_UNDER_TEST = 'config_entity_validation_test.entity_under_test';"," ","+  /**","+   * The langcode of the language that ::testConfigurableLanguage() creates.","+   */","+  private const string CONFIGURABLE_LANGCODE = 'kthxbai';","+","+  /**","+   * The language negotiation settings before ::testConfigurableLanguage().","+   *","+   * FALSE if the configuration did not exist.","+   */","+  private array|false $languageNegotiation;","+","   /**","    * The config entity being tested.","    *","@@ -508,28 +525,24 @@ public function testLangcode(): void {","     $this->assertValidationErrors([","       'langcode' => 'The value you selected is not a valid choice.',","     ]);","+  }"," ","+  /**","+   * Tests that the langcode of a configurable language is accepted.","+   */","+  public function testConfigurableLanguage(): void {","     // If a new configurable language is created with a non-standard langcode,","     // it should be acceptable.","-    $this->enableModules(['language']);","     // The language doesn't exist yet, so it shouldn't be a valid choice.","-    $this->entity->set('langcode', 'kthxbai');","+    $this->entity->set('langcode', self::CONFIGURABLE_LANGCODE);","     $this->assertValidationErrors([","       'langcode' => 'The value you selected is not a valid choice.',","     ]);","-    // Once we create the language, it should be a valid choice.","-    $language = ConfigurableLanguage::createFromLangcode('kthxbai');","-    $language->save();","+    // Once we create the language, it should be a valid choice. Saving it also","+    // writes the language negotiation settings, so keep what they were.","+    $this->languageNegotiation = $this->container->get('config.storage')->read('language.negotiation');","+    ConfigurableLanguage::createFromLangcode(self::CONFIGURABLE_LANGCODE)->save();","     $this->assertValidationErrors([]);","-","-    // The language is a config entity, so it outlives this test method when the","-    // test class shares its environment. Remove it, otherwise the test methods","-    // that follow would validate against a language list this one invented.","-    // Deleting the configuration rather than the entity: deleting the entity","-    // invokes hooks that update the langcode of existing content, and the","-    // subclasses of this class may not install the schema of the entity types","-    // those hooks touch.","-    \\Drupal::configFactory()->getEditable($language->getConfigDependencyName())->delete();","   }"," ","   /**","@@ -814,4 +827,32 @@ protected function getPropertiesWithOptionalValues(): array {","     return $optional_properties;","   }"," ","+  /**","+   * {@inheritdoc}","+   */","+  protected function resetEnvironment(): void {","+    parent::resetEnvironment();","+","+    // Without a shared environment, the parent dropped all the tables.","+    if (!static::sharesEnvironment()) {","+      return;","+    }","+","+    // Remove what ::testConfigurableLanguage() saved, which would otherwise","+    // outlive the test method. Deleting the configuration rather than the","+    // entity: deleting the entity invokes hooks that update the langcode of","+    // existing content, and the subclasses of this class may not install the","+    // schema of the entity types those hooks touch.","+    if (isset($this->languageNegotiation)) {","+      $storage = $this->container->get('config.storage');","+      $storage->delete('language.entity.' . self::CONFIGURABLE_LANGCODE);","+      if ($this->languageNegotiation === FALSE) {","+        $storage->delete('language.negotiation');","+      }","+      else {","+        $storage->write('language.negotiation', $this->languageNegotiation);","+      }","+    }","+  }","+"," }"],"additions":56,"deletions":15,"truncated":false},{"path":"core/tests/Drupal/KernelTests/Core/Entity/DateFormatNoLanguageValidationTest.php","lines":["@@ -0,0 +1,42 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Drupal\\KernelTests\\Core\\Entity;","+","+use Drupal\\TestTools\\Attribute\\ShareEnvironment;","+use PHPUnit\\Framework\\Attributes\\Group;","+use PHPUnit\\Framework\\Attributes\\RunTestsInSeparateProcesses;","+","+/**","+ * Tests validation of date_format entities without the language module.","+ *","+ * The other config entity validation tests run with the language module, which","+ * replaces the language manager. This test ensures validation also works with","+ * the core language manager, as on sites without the language module.","+ */","+#[Group('Entity')]","+#[Group('Validation')]","+#[Group('config')]","+#[RunTestsInSeparateProcesses]","+#[ShareEnvironment]","+class DateFormatNoLanguageValidationTest extends DateFormatValidationTest {","+","+  /**","+   * {@inheritdoc}","+   */","+  protected static function getModulesToEnable($class): array {","+    return array_values(array_diff(parent::getModulesToEnable($class), ['language']));","+  }","+","+  /**","+   * Tests that the language module is not enabled.","+   *","+   * Configurable languages need the language module, so there is nothing to","+   * validate.","+   */","+  public function testConfigurableLanguage(): void {","+    $this->assertFalse($this->container->get('module_handler')->moduleExists('language'));","+  }","+","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"core/tests/Drupal/KernelTests/Core/Entity/EntityViewDisplayValidationTest.php","lines":["@@ 