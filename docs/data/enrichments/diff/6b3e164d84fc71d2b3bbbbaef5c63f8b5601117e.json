ss KernelTestBase extends DrupalTestCase implements ServiceProviderI","    */","   private ?array $environmentTables = NULL;"," ","+  /**","+   * The names of the modules that ::bootKernel() enabled for the test method.","+   *","+   * @var list<string>","+   */","+  private array $bootedModules = [];","+","   /**","    * The key value factory of the container that booted the test method.","    *","@@ -450,7 +457,7 @@ protected function bootKernel(): void {","     // Add this test class as a service provider.","     $GLOBALS['conf']['container_service_providers']['test'] = $this;"," ","-    $modules = self::getModulesToEnable(static::class);","+    $modules = static::getModulesToEnable(static::class);"," ","     // When a module is providing the database driver, then enable that module.","     $connection_info = Database::getConnectionInfo();","@@ -516,6 +523,7 @@ protected function bootKernel(): void {","       'module' => array_fill_keys($modules, 0),","       'theme' => $themes,","     ]);","+    $this->bootedModules = array_values(array_unique($modules));"," ","     $settings = Settings::getAll();","     $settings['php_storage']['default'] = [","@@ -556,8 +564,15 @@ protected function bootKernel(): void {","     $kernel->resetContainer();"," ","     if ($record === NULL) {","+      $extension = $config_storage->read('core.extension');","       try {","         $this->setUpEnvironment();","+        // ::setUpEnvironment() may have rebuilt the container, so read through","+        // the current one.","+        $changes = $this->getCoreExtensionChanges($extension, $this->container->get('config.storage')->read('core.extension'));","+        if ($changes) {","+          throw $this->createModuleListChangeException($changes);","+        }","       }","       catch (\\Throwable $e) {","         // The initial state is half built. Record that, so the test methods","@@ -876,6 +891,19 @@ protected function tearDown(): void {","    *   Whatever ::resetEnvironment() threw, once the failure is recorded.","    */","   protected function tearDownEnvironment(): void {","+    // Check the module list before ::resetEnvironment() runs: restoring the","+    // module list there would not remove what the modules left in the","+    // database, and ::bootKernel() writes the module list again for every test","+    // method anyway.","+    if (static::sharesEnvironment() && $this->environmentTables !== NULL) {","+      try {","+        $this->checkNoModuleWasEnabledOrDisabled();","+      }","+      catch (\\Throwable $e) {","+        $this->invalidateDatabaseState($e->getMessage());","+        throw $e;","+      }","+    }","     try {","       $this->resetEnvironment();","     }","@@ -1037,11 +1065,16 @@ protected function installEntitySchema($entity_type_id): void {","    *   is not applied.","    *","    * @throws \\LogicException","-   *   If any module in $modules is already enabled.","+   *   If any module in $modules is already enabled, or if the test class shares","+   *   its environment.","    * @throws \\RuntimeException","    *   If a module is not enabled after enabling it.","    */","   protected function enableModules(array $modules): void {","+    if (static::sharesEnvironment() && ($new_modules = array_diff($modules, array_keys($this->container->get('module_handler')->getModuleList())))) {","+      sort($new_modules);","+      throw $this->createModuleListChangeException(['enabled' => 'enabled ' . implode(', ', $new_modules)]);","+    }","     // Perform an ExtensionDiscovery scan as this function may receive a","     // profile that is not the current profile, and we don't yet have a cached","     // way to receive inactive profile information.","@@ -1097,11 +1130,15 @@ protected function enableModules(array $modules): void {","    *   removed from the active module list.","    *","    * @throws \\LogicException","-   *   If any module in $modules is already disabled.","+   *   If any module in $modules is already disabled, or if the test class","+   *   shares its environment.","    * @throws \\RuntimeException","    *   If a module is not disabled after disabling it.","    */","   protected function disableModules(array $modules): void {","+    if (static::sharesEnvironment() && $modules) {","+      throw $this->createModuleListChangeException(['disabled' => 'disabled ' . implode(', ', $modules)]);","+    }","     // Unset the list of modules in the extension handler.","     $module_handler = $this->container->get('module_handler');","     $module_filenames = $module_handler->getModuleList();","@@ -1270,6 +1307,77 @@ protected function checkNoTableWasLeftBehind(): void {","     }","   }"," ","+  /**","+   * Fails when a test method left the module list changed.","+   *","+   * Module weights and the install profile are not checked: ::bootKernel()","+   * writes them again for every test method, and a module leaves no data","+   * behind by changing them.","+   *","+   * @see \\Drupal\\TestTools\\Attribute\\ShareEnvironment","+   */","+  protected function checkNoModuleWasEnabledOrDisabled(): void {","+    $changes = $this->getCoreExtensionChanges(","+      ['module' => array_fill_keys($this->bootedModules, 0)],","+      $this->container->get('config.storage')->read('core.extension'),","+    );","+    $changes = array_intersect_key($changes, array_flip(['enabled', 'disabled']));","+    if ($changes) {","+      throw $this->createModuleListChangeException($changes);","+    }","+  }","+","+  /**","+   * Describes how the modules in the core.extension configuration changed.","+   *","+   * The theme list is not compared: ::bootKernel() keeps it between test","+   * methods.","+   *","+   * @param array $before","+   *   The core.extension configuration before the change.","+   * @param array $after","+   *   The core.extension configuration after the change.","+   *","+   * @return array<string, string>","+   *   The changes, keyed by \"enabled\", \"disabled\", \"weights\" and \"profile\". For","+   *   example, ['enabled' => 'enabled field, node'].","+   */","+  protected function getCoreExtensionChanges(array $before, array $after): array {","+    $before_modules = $before['module'] ?? [];","+    $after_modules = $after['module'] ?? [];","+    $changes = [];","+    if ($enabled = array_keys(array_diff_key($after_modules, $before_modules))) {","+      sort($enabled);","+      $changes['enabled'] = 'enabled ' . implode(', ', $enabled);","+    }","+    if ($disabled = array_keys(array_diff_key($before_modules, $after_modules))) {","+      sort($disabled);","+      $changes['disabled'] = 'disabled ' . implode(', ', $disabled);","+    }","+    if (array_diff_assoc(array_intersect_key($after_modules, $before_modules), $before_modules)) {","+      $changes['weights'] = 'changed the module weights';","+    }","+    if (($after['profile'] ?? NULL) !== ($before['profile'] ?? NULL)) {","+      $changes['profile'] = 'changed the install profile';","+    }","+    return $changes;","+  }","+","+  /**","+   * Creates the exception for a change to the modules.","+   *","+   * @param array<string, string> $changes","+   *   The changes, as returned by ::getCoreExtensionChanges().","+   *","+   * @return \\LogicException","+   *   The exception to throw.","+   *","+   * @see \\Drupal\\TestTools\\Attribute\\ShareEnvironment","+   */","+  private function createModuleListChangeException(array $changes): \\LogicException {","+    return new \\LogicException(sprintf('%s %s, which a test class that shares its environment must not do. See \\\\%s.', static::class, implode(' and ', $changes), ShareEnvironment::class));","+  }","+","   /**","    * Reads the record describing the shared database state.","    *"],"additions":111,"deletions":3,"truncated":false},{"path":"core/tests/Drupal/KernelTests/SharedDatabaseStateViolationTest.php","lines":["@@ -24,7 +24,14 @@ class SharedDatabaseStateViolationTest extends KernelTestBase {","   /**","    * {@inheritdoc}","    */","-  protected static $modules = ['system', 'user'];","+  protected static $modules = [","+    'system',","+    'user',","+    // Listed twice, as when more than one class of the hierarchy declares it.","+    // The module list does not change, so every test method has to pass","+    // ::checkNoModuleWasEnabledOrDisabled() in ::tearDown().","+    'user',","+  ];"," ","   /**","    * The name of a table belonging to the initial state.","@@ -62,6 +69,154 @@ protected function setUpEnvironment(): void {","     $connection->insert(self::PROBE_TABLE)->fields(['id' => 1])->execute();","   }"," ","+  /**","+   * Tests how the changes to the modules are described.","+   */","+  public function testCoreExtensionChanges(): void {","+    $extension = $this->container->get('config.storage')->read('core.extension');","+    $added_module = ['field' => 0] + $extension['module'];","+    $changed_weight = ['user' => 1] + $extension['module'];","+    $removed_module = $extension['module'];","+    unset($removed_module['user']);","+","+    $cases = [","+      // The theme list is kept between test methods, so a change to it is not","+      // reported.","+      [[], ['theme' => ['stark' => 0] + $extension['theme']]],","+      [['enabled' => 'enabled field'], ['module' => $added_module]],","+      [['disabled' => 'disabled user'], ['module' => $removed_module]],","+      [['weights' => 'changed the module weights'], ['module' => $changed_weight]],","+      [['profile' => 'changed the install profile'], ['profile' => 'testing']],","+      [","+        ['enabled' => 'enabled field', 'profile' => 'changed the install profile'],","+        ['module' => $added_module, 'profile' => 'testing'],","+      ],","+      [","+        ['enabled' => 'enabled field', 'weights' => 'changed the module weights'],","+        ['module' => ['field' => 0] + $changed_weight],","+      ],","+    ];","+    foreach ($cases as [$expected, $values]) {","+      $this->assertSame($expected, $this->getCoreExtensionChanges($extension, $values + $extension));","+    }","+  }","+","+  /**","+   * Tests that a test method changing the module list is reported.","+   */","+  public function testChangedModuleListInTestMethodIsReported(): void {","+    // Changing the theme list or the weights passes, the module list is the","+    // same.","+    $storage = $this->container->get('config.storage');","+    $extension = $storage->read('core.extension');","+    $changed = $extension;","+    $changed['theme']['stark'] = 0;","+    $changed['module']['user'] = 10;","+    $storage->write('core.extension', $changed);","+    $this->checkNoModuleWasEnabledOrDisabled();","+","+    $changed = $extension;","+    $changed['module']['field'] = 0;","+    $storage->write('core.extension', $changed);","+    $enabled = NULL;","+    try {","+      $this->checkNoModuleWasEnabledOrDisabled();","+    }","+    catch (\\LogicException $e) {","+      $enabled = $e;","+    }","+","+    $changed = $extension;","+    unset($changed['module']['user']);","+    $storage->write('core.extension', $changed);","+    $disabled = NULL;","+    try {","+      $this->checkNoModuleWasEnabledOrDisabled();","+    }","+    catch (\\LogicException $e) {","+      $disabled = $e;","+    }","+    $storage->write('core.extension', $extension);","+","+    $this->assertNotNull($enabled, 'Enabling a module is reported.');","+    $this->assertStringContainsString('enabled field,', $enabled->getMessage());","+    $this->assertNotNull($disabled, 'Disabling a module is reported.');","+    $this->assertStringContainsString('disabled user,', $disabled->getMessage());","+  }","+","+  /**","+   * Tests that enabling or disabling a module fails right away.","+   */","+  public function testEnableAndDisableModulesFail(): void {","+    // Enabling a module that is already enabled changes nothing.","+    $this->enableModules(['user']);","+","+    try {","+      $this->enableModules(['field']);","+      $this->fail('Enabling a module fails.');","+    }","+    catch (\\LogicException $e) {","+      $this->assertStringContainsString('enabled field,', $e->getMessage());","+    }","+    $this->assertFalse($this->container->get('module_handler')->moduleExists('field'));","+","+    try {","+      $this->disableModules(['user']);","+      $this->fail('Disabling a module fails.');","+    }","+    catch (\\LogicException $e) {","+      $this->assertStringContainsString('disabled user,', $e->getMessage());","+    }","+    $this->assertTrue($this->container->get('module_handler')->moduleExists('user'));","+  }","+","+  /**","+   * Tests that the module list is checked before the cleanup runs.","+   *","+   * Restoring the module list in ::resetEnvironment() must not hide the change.","+   */","+  public function testModuleListIsCheckedBeforeReset(): void {","+    $connection = $this->container->get('database');","+    $original = $connection->select(self::STATE_TABLE, 's')","+      ->fields('s', ['status', 'message', 'tables'])","+      ->execute()","+      ->fetchAssoc();","+    $storage = $this->container->get('config.storage');","+    $extension = $storage->read('core.extension');","+    $changed = $extension;","+    $changed['module']['field'] = 0;","+    $storage->write('core.extension', $changed);","+","+    // What ::tearDown() runs. ::resetEnvironment() would throw, so the module","+    // list error shows that the check ran first.","+    $this->failReset = TRUE;","+    $caught = NULL;","+    try {","+      $this->tearDownEnvironment();","+    }","+    catch (\\LogicException $e) {","+      $caught = $e;","+    }","+    $this->failReset = FALSE;","+","+    $record = $connection->select(self::STATE_TABLE, 's')","+      ->fields('s', ['status', 'message'])","+      ->execute()","+      ->fetchAssoc();","+","+    // Put the module list and the record back, otherwise the following test","+    // methods would refuse to run, which is the behavior under test rather","+    // than a failure.","+    $storage->write('core.extension', $extension);","+    $connection->delete(self::STATE_TABLE)->execute();","+    $connection->insert(self::STATE_TABLE)->fields($original)->execute();","+","+    $this->assertNotNull($caught, 'The module list change is reported.');","+    $this->assertStringContainsString('enabled field,', $caught->getMessage());","+    $this->assertSame('invalid', $record['status']);","+    $this->assertStringContainsString('enabled field,', $record['message']);","+  }","+","   /**","    * Tests that dropping a table of the initial state is reported.","    */"],"additions":156,"deletions":1,"truncated":false},{"path":"core/tests/Drupal/TestTools/Attribute/ShareEnvironment.php","lines":["@@ -38,6 +38,21 @@","  *   its own, redeclares \"KernelTestBase::INFRASTRUCTURE_TABLES\" instead.","  * - \"::setUpEnvironment()\" must be deterministic. Random values in the","  *   environment may cause issues.","+ * - \"::setUpEnvironment()\" must not change the modules, their weights or the","+ *   install profile. \"::bootKernel()\" writes the \"core.extension\" configuration","+ *   again for every test method, with the modules of \"static::$modules\" at","+ *   weight 0 and no install profile, so the test methods that follow would not","+ *   see the change. Declare the modules in \"static::$modules\", and set module","+ *   weights and the install profile in \"::setUp()\".","+ * - A test method must not change the module list either, not even for a","+ *   while. The configuration, key value data and cache entries that a module","+ *   leaves behind would be seen by the test methods that follow, without the","+ *   module being enabled. Restoring the module list does not remove them.","+ *   \"::enableModules()\" and \"::disableModules()\" fail, and so does a test","+ *   method that changed the module list in another way, before","+ *   \"::resetEnvironment()\" runs. Declare the modules in \"static::$modules\"","+ *   instead, move the test method to a test class of its own, or do not share","+ *   the environment.","  * - Currently, the test methods share only database state. Every test method","  *   runs in its own process with its own virtual site directory, so a file","  *   written during \"::setUpEnvironment()\" does not exist when the next test",""],"additions":15,"deletions":0,"truncated":false}],"additions":434,"deletions":58,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-28T17:10:18.028033+00:00"}