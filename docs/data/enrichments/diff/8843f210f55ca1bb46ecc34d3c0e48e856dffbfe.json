) {","+        doReturn(Flux.empty()).when(harness.executionService()).killSubflowExecutions(any(), any());","+        doReturn(List.of()).when(harness.executionService()).killLoopSubExecutions(any(), any());","+    }","+","+    @Test","+    void shouldEndKilledWhenANewExecutionIsKillSwitchedOnTheExecutionQueue() {","+        FlowWithSource flow = registeredFlow();","+        Execution execution = Executions.created(flow);","+        killSwitchActive(EvaluationType.KILL);","+","+        Trace trace = harness.run(List.of(execution), ScriptedWorker.succeeding(T0));","+","+        assertThat(harness).as(\"a kill-switched execution that never started must not stay KILLING\").hasExecutionInState(execution, State.Type.KILLED);","+        assertThat(terminatedEvents(trace, execution)).as(\"the execution went through its terminal processing\").isEqualTo(1);","+    }","+","+    @Test","+    void shouldRunTheTerminalProcessingWhenANewExecutionIsCancelledByTheKillSwitchOnTheExecutionQueue() {","+        FlowWithSource flow = registeredFlow();","+        Execution execution = Executions.created(flow);","+        killSwitchActive(EvaluationType.CANCEL);","+","+        Trace trace = harness.run(List.of(execution), ScriptedWorker.succeeding(T0));","+","+        assertThat(harness).hasExecutionInState(execution, State.Type.CANCELLED);","+        assertThat(terminatedEvents(trace, execution)).as(\"the execution went through its terminal processing\").isEqualTo(1);","+    }","+","+    private void killSwitchActive(EvaluationType evaluationType) {","+        when(harness.killSwitchService().evaluate(any(Execution.class))).thenReturn(evaluationType);","+        when(harness.killSwitchService().evaluate(any(ExecutionEvent.class))).thenReturn(evaluationType);","+        when(harness.killSwitchService().evaluate(anyString())).thenReturn(evaluationType);","+    }","+","+    private static long terminatedEvents(Trace trace, Execution execution) {","+        return trace.emitted(\"executionEvent\")","+            .map(e -> e.as(ExecutionEvent.class))","+            .filter(e -> e.executionId().equals(execution.getId()) && e.eventType() == ExecutionEventType.TERMINATED)","+            .count();","+    }","+","+    private FlowWithSource registeredFlow() {","+        FlowWithSource flow = Flows.of(Flows.log(\"a\"));","+        harness.registerFlow(flow);","+        return flow;","+    }","+}"],"additions":84,"deletions":0,"truncated":false},{"path":"executor/src/test/java/io/kestra/executor/testkit/ExecutorTestHarness.java","lines":["@@ -108,8 +108,8 @@","  * Composition root for executor unit tests: the real {@link ExecutorService}, message handlers,","  * processors and {@link DefaultExecutor} wired over in-memory fakes — no Micronaut context, no","  * database, no threads. Collaborators without executor logic ({@link KillSwitchService},","- * {@link QuotaService}, {@link AsyncOperationService}, {@link FlowTriggerService},","- * {@link KillSwitchActionService}) are Mockito mocks exposed for per-test stubbing.","+ * {@link QuotaService}, {@link AsyncOperationService}, {@link FlowTriggerService}) are Mockito","+ * mocks exposed for per-test stubbing.","  */"," public final class ExecutorTestHarness {","     private static final int MAX_STEPS = 500;","@@ -303,7 +303,7 @@ private ExecutorTestHarness() {","             KillSwitchService.class,","             invocation -> \"evaluate\".equals(invocation.getMethod().getName()) ? EvaluationType.PASS : Mockito.RETURNS_DEFAULTS.answer(invocation)","         );","-        this.killSwitchActionService = Mockito.mock(KillSwitchActionService.class);","+        this.killSwitchActionService = new KillSwitchActionService(executionStateStore, killQueue);","         this.workerTaskResultListener = Mockito.mock(WorkerTaskResultListener.class);","         this.workerJobRunningStateStore = Mockito.mock(WorkerJobRunningStateStore.class);","         // a spy so tests can stub namespace/tenant limits while the OSS flow-scope default stays real","@@ -825,10 +825,6 @@ public KillSwitchService killSwitchService() {","         return killSwitchService;","     }"," ","-    public KillSwitchActionService killSwitchActionService() {","-        return killSwitchActionService;","-    }","-","     public WorkerTaskResultListener workerTaskResultListener() {","         return workerTaskResultListener;","     }",""],"additions":3,"deletions":7,"truncated":false}],"additions":110,"deletions":24,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-09T17:51:46.733622+00:00"}