{"id":"e777efdb299d61a891a670b0f0a9d6b58304ca84","axis":"silent","repo":"pnpm/pnpm","sha":"e777efdb299d61a891a670b0f0a9d6b58304ca84","parsed":{"files":[{"path":".changeset/lockfile-dir-default-layout.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+An explicit `lockfileDir` that points to the default lockfile directory keeps the default install behavior [pnpm/tasks#275](https://github.com/pnpm/tasks/issues/275)."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -5034,6 +5034,7 @@ dependencies = [","  \"pnpm-workspace-task-scheduler\",","  \"pnpr-registry\",","  \"pretty_assertions\",","+ \"same-file\",","  \"serde\",","  \"serde-saphyr\",","  \"serde_json\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/lockfile_dir.rs","lines":["@@ -37,7 +37,7 @@ impl LockfileDirArg {","     /// resolves its own `lockfileDir` against.","     pub(crate) fn apply_to(&self, config: &mut Config, dir: &Path) {","         if let Some(lockfile_dir) = self.lockfile_dir.as_deref() {","-            config.pin_lockfile_dir(&dir.join(lockfile_dir));","+            config.pin_lockfile_dir(&dir.join(lockfile_dir), dir);","         }","     }"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pre_command/load_config.rs","lines":["@@ -62,7 +62,7 @@ pub(in crate::cli_args) fn apply_cli_layers(","     if !invocation.global","         && let Some(lockfile_dir) = invocation.lockfile_dir.as_deref()","     {","-        config.pin_lockfile_dir(&dir.join(lockfile_dir));","+        config.pin_lockfile_dir(&dir.join(lockfile_dir), dir);","         if let Some(raw) = lockfile_dir.to_str() {","             push_cli_token(config, \"lockfile-dir\", raw);","         }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pre_command/tests/argv_readers.rs","lines":["@@ -629,3 +629,22 @@ fn a_negated_flag_clears_a_configured_value() {","         assert_eq!(config.offline, expected, \"offline {offline:?} over a configured {configured}\");","     }"," }","+","+#[test]","+fn lockfile_dir_flag_shares_one_lockfile_across_dedicated_projects() {","+    let workspace = Path::new(\"/workspace\");","+    let mut config = Config {","+        dir: workspace.to_path_buf(),","+        workspace_dir: Some(workspace.to_path_buf()),","+        shared_workspace_lockfile: false,","+        ..Config::default()","+    };","+    let invocation =","+        Invocation { lockfile_dir: Some(PathBuf::from(\".\")), ..pre_command_input(workspace) };","+","+    apply_cli_layers(&mut config, &invocation, &ConfigOverrides::default(), workspace)","+        .expect(\"apply cli layers\");","+","+    assert_eq!(config.lockfile_dir.as_deref(), Some(workspace));","+    assert!(config.shares_one_lockfile());","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks/apply.rs","lines":["@@ -10,6 +10,40 @@ struct HookExecutionChanges {","     changed_extra_env: Option<HashMap<String, String>>,"," }"," ","+struct LockfileDirPathsBeforeHook {","+    lockfile_dir: Option<PathBuf>,","+    configured_virtual_store_dir: Option<PathBuf>,","+    node_path_dirs: [PathBuf; 2],","+    hook_node_path: Option<Option<String>>,","+    hook_node_options: Option<Option<String>>,","+    hook_modules_dir: Option<PathBuf>,","+    modules_dir_changed: bool,","+    hook_virtual_store_dir: HookVirtualStoreDir,","+}","+","+#[derive(Clone, Copy)]","+enum HookVirtualStoreDir {","+    Unchanged,","+    Cleared,","+    Set,","+}","+","+struct NodePathRefresh {","+    previous_dirs: [PathBuf; 2],","+    hook_node_path: Option<Option<String>>,","+    hook_node_options: Option<Option<String>>,","+}","+","+impl NodePathRefresh {","+    fn apply_to(self, config: &mut Config) {","+        config.refresh_node_path_after_lockfile_dir_change::<Host>(","+            [&self.previous_dirs[0], &self.previous_dirs[1]],","+            self.hook_node_path,","+            self.hook_node_options,","+        );","+    }","+}","+"," /// `extraBinPaths` / `extraEnv` aren't `WorkspaceSettings` fields, so"," /// `from_value(delta)` ignores them. The hook's values are pulled out"," /// first and assigned directly.","@@ -67,6 +101,8 @@ pub(super) fn apply_hook_delta(","     base_dir: &Path,"," ) -> Result<()> {","     let delta = filter_hook_delta(config, config_delta(input, current));","+    let lockfile_dir_paths_before_hook =","+        lockfile_dir_paths_before_hook(config, input, current, &delta, base_dir);","     // `config_delta` only walks keys present in the hook output, so a","     // `scriptShell` the hook deleted (pnpm: `undefined`, no shell) leaves no","     // trace in the delta.","@@ -75,10 +111,6 @@ pub(super) fn apply_hook_delta(","     if delta.as_object().is_none_or(serde_json::Map::is_empty) && !script_shell_deleted {","         return Ok(());","     }","-    let changed_store_dir = delta","-        .get(\"storeDir\")","-        .and_then(Value::as_str)","-        .map(str::to_owned);","     let execution_changes = hook_execution_changes(&delta)?;","     apply_registry_routing_changes(config, &delta)?;"," ","@@ -90,15 +122,165 @@ pub(super) fn apply_hook_delta(","     config.apply_cli_registries();","     apply_hook_execution_changes(config, execution_changes, script_shell_deleted);","     restore_defaults_of_nulled_settings(config, &delta, base_dir);","+    let node_path_refresh = lockfile_dir_paths_before_hook.map(|paths_before_hook| {","+        apply_lockfile_dir_change(config, paths_before_hook)","+    });","     apply_state_dir_change(config, &delta);","     apply_project_selector_changes(config, &delta, base_dir)?;","     if delta.get(\"shamefullyHoist\").is_some() || config.cli_settings.contains(\"shamefullyHoist\") {","         config.apply_shamefully_hoist_derivation();","     }","-    apply_hook_store_dir(config, changed_store_dir.as_deref(), base_dir)?;","+    apply_hook_store_dir_change(config, &delta, base_dir)?;","+    if let Some(node_path_refresh) = node_path_refresh {","+        node_path_refresh.apply_to(config);","+    }","     Ok(())"," }"," ","+/// Re-anchor the paths that follow the lockfile directory. `NODE_PATH` is","+/// refreshed by the returned value once the store paths are settled.","+fn apply_lockfile_dir_change(","+    config: &mut Config,","+    paths_before_hook: LockfileDirPathsBeforeHook,","+) -> NodePathRefresh {","+    let project_dir = config.dir.clone();","+    let modules_dir = config.modules_dir.clone();","+    let install_state_dir = config.install_state_dir.clone();","+    if let Some(lockfile_dir) = config.lockfile_dir.clone() {","+        if paths_before_hook.lockfile_dir.is_none() {","+            config.lockfile_dir = None;","+        }","+        config.pin_lockfile_dir(&lockfile_dir, &project_dir);","+    }","+    restore_default_lockfile_dir_paths(config, &paths_before_hook, modules_dir, install_state_dir);","+    NodePathRefresh {","+        previous_dirs: paths_before_hook.node_path_dirs,","+        hook_node_path: paths_before_hook.hook_node_path,","+        hook_node_options: paths_before_hook.hook_node_options,","+    }","+}","+","+fn restore_default_lockfile_dir_paths(","+    config: &mut Config,","+    paths_before_hook: &LockfileDirPathsBeforeHook,","+    modules_dir: PathBuf,","+    install_state_dir: PathBuf,","+) {","+    if config.lockfile_dir.is_some() {","+        return;","+    }","+    let configured_virtual_store_dir = paths_before_hook","+        .configured_virtual_store_dir","+        .as_ref();","+    config.modules_dir = modules_dir;","+    let hook_virtual_store_dir = match paths_before_hook.hook_virtual_store_dir {","+        HookVirtualStoreDir::Unchanged => {","+            config.configured_virtual_store_dir = configured_virtual_store_dir.cloned();","+            None","+        }","+        HookVirtualStoreDir::Cleared => {","+            config.configured_virtual_store_dir = None;","+            None","+        }","+        HookVirtualStoreDir::Set => config.configured_virtual_store_dir.clone(),","+    };","+    config.install_state_dir = install_state_dir;","+    if paths_before_hook.lockfile_dir.is_some() {","+        restore_default_lockfile_dir(config, configured_virtual_store_dir, hook_virtual_store_dir);","+    }","+    if let Some(hook_modules_dir) = paths_before_hook.hook_modules_dir.as_ref() {","+        config.modules_dir.clone_from(hook_modules_dir);","+    }","+    if paths_before_hook.modules_dir_changed","+        && (!config.explicit_settings.contains_key(\"virtualStoreDir\")","+            || config.enable_global_virtual_store)","+    {","+        config.install_state_dir = config.modules_dir.join(\".pnpm\");","+    }","+}","+","+fn restore_default_lockfile_dir(","+    config: &mut Config,","+    configured_virtual_store_dir: Option<&PathBuf>,","+    hook_virtual_store_dir: Option<PathBuf>,","+) {","+    let project_dir = config.dir.clone();","+    let lockfile_dir = config.lockfile_dir_for(&project_dir).to_path_buf();","+    let paths_dir = config.workspace_dir.clone().unwrap_or(lockfile_dir);","+    let project_relative_virtual_store_dir = config.explicit_settings","+        .get(\"virtualStoreDir\")","+        .and_then(Value::as_str)","+        .and_then(|raw| {","+            configured_virtual_store_dir.filter(|dir| {","+                !Path::new(raw).is_absolute()","+                    && pnpm_fs::lexical_normalize(dir)","+                        == pnpm_fs::lexical_normalize(&project_dir.join(raw))","+            })","+        });","+    config.anchor_lockfile_paths(&paths_dir);","+    if !config.enable_global_virtual_store","+        && let Some(dir) = project_relative_virtual_store_dir","+    {","+        config.set_virtual_store_dir(dir.clone());","+    }","+    if !config.enable_global_virtual_store","+        && let Some(dir) = hook_virtual_store_dir","+    {","+        config.set_virtual_store_dir(dir);","+    }","+}","+","+fn changed_extra_env_value(input: &Value, current: &Value, key: &str) -> Option<Option<String>> {","+    let before = input","+        .get(\"extraEnv\")","+        .and_then(|env| env.get(key))","+        .and_then(Value::as_str);","+    let after = current","+        .get(\"extraEnv\")","+        .and_then(|env| env.get(key))","+        .and_then(Value::as_str);","+    (before != after).then(|| after.map(str::to_owned))","+}","+","+fn lockfile_dir_paths_before_hook(","+    config: &Config,","+    input: &Value,","+    current: &Value,","+    delta: &Value,","+    base_dir: &Path,","+) -> Option<LockfileDirPathsBeforeHook> {","+    delta","+        .get(\"lockfileDir\")","+        .map(|_| LockfileDirPathsBeforeHook {","+            lockfile_dir: config.lockfile_dir.clone(),","+            configured_virtual_store_dir: config.configured_virtual_store_dir.clone(),","+            node_path_dirs: [","+                config.install_state_dir.join(\"node_modules\"),","+                config.modules_dir.clone(),","+            ],","+            hook_node_path: changed_extra_env_value(input, current, \"NODE_PATH\"),","+            hook_node_options: changed_extra_env_value(input, current, \"NODE_OPTIONS\"),","+            hook_modules_dir: delta","+                .get(\"modulesDir\")","+                .and_then(Value::as_str)","+                .map(|modules_dir| pnpm_fs::lexical_normalize(&base_dir.join(modules_dir))),","+            modules_dir_changed: delta.get(\"modulesDir\").is_some(),","+            hook_virtual_store_dir: match delta.get(\"virtualStoreDir\") {","+                None => HookVirtualStoreDir::Unchanged,","+                Some(Value::Null) => HookVirtualStoreDir::Cleared,","+                Some(_) => HookVirtualStoreDir::Set,","+            },","+        })","+}","+","+fn apply_hook_store_dir_change(config: &mut Config, delta: &Value, base_dir: &Path) -> Result<()> {","+    let changed_store_dir = delta","+        .get(\"storeDir\")","+        .and_then(Value::as_str)","+        .map(str::to_owned);","+    apply_hook_store_dir(config, changed_store_dir.as_deref(), base_dir)","+}","+"," /// Apply the routing a hook rewrote under the `registriesByScope` /"," /// `registriesByPrefix` names it reads it under. `WorkspaceSettings`"," /// reaches the same lookups through its file-shaped `registries` key, which"],"additions":187,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/tests.rs","lines":["@@ -32,6 +32,437 @@ async fn update_config_records_prefer_frozen_lockfile_as_explicit() {","     }"," }"," ","+#[tokio::test]","+async fn update_config_lockfile_dir_reanchors_install_paths() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    fs::write(root.path().join(\"pnpm-workspace.yaml\"), \"\\n\").expect(\"write workspace settings\");","+    fs::write(","+        root.path().join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = 'custom'; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(root.path()).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, root.path()).await","+        .expect(\"run updateConfig hook\");","+","+    let lockfile_dir = root.path().join(\"custom\");","+    assert_eq!(config.lockfile_dir, Some(lockfile_dir.clone()));","+    assert_eq!(config.modules_dir, lockfile_dir.join(\"node_modules\"));","+    assert_eq!(config.install_state_dir, lockfile_dir.join(\"node_modules/.pnpm\"));","+}","+","+#[tokio::test]","+async fn update_config_lockfile_dir_restores_default_workspace_paths() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    fs::write(root.path().join(\"pnpm-workspace.yaml\"), \"lockfileDir: custom\\n\")","+        .expect(\"write workspace settings\");","+    fs::write(","+        root.path().join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = null; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(root.path()).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, root.path()).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.lockfile_dir, None);","+    assert_eq!(config.modules_dir, root.path().join(\"node_modules\"));","+    assert_eq!(config.install_state_dir, root.path().join(\"node_modules/.pnpm\"));","+}","+","+#[tokio::test]","+async fn clearing_lockfile_dir_preserves_project_relative_virtual_store_dir() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    let project = workspace.join(\"packages/app\");","+    fs::create_dir_all(&project).expect(\"create project directory\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nlockfileDir: custom\\n\",","+    )","+    .expect(\"write workspace settings\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = null; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&project).expect(\"load configuration\");","+    let virtual_store_dir = project.join(\"cache\");","+    config.explicit_settings.insert(\"virtualStoreDir\".to_string(), serde_json::json!(\"cache\"));","+    config.set_virtual_store_dir(virtual_store_dir.clone());","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &workspace).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.lockfile_dir, None);","+    assert_eq!(config.install_state_dir, virtual_store_dir);","+}","+","+#[tokio::test]","+async fn update_config_default_lockfile_dir_preserves_project_virtual_store_path() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    let project = workspace.join(\"packages/app\");","+    fs::create_dir_all(&project).expect(\"create project directory\");","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write workspace settings\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = config.workspaceDir + '/.'; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&project).expect(\"load configuration\");","+    let virtual_store_dir = project.join(\"cache\");","+    config.explicit_settings.insert(\"virtualStoreDir\".to_string(), serde_json::json!(\"cache\"));","+    config.set_virtual_store_dir(virtual_store_dir.clone());","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &project).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.lockfile_dir, None);","+    assert_eq!(config.configured_virtual_store_dir, Some(virtual_store_dir.clone()));","+    assert_eq!(config.install_state_dir, virtual_store_dir);","+}","+","+#[tokio::test]","+async fn update_config_default_lockfile_dir_keeps_hook_virtual_store_dir() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    fs::create_dir_all(&workspace).expect(\"create workspace directory\");","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"lockfileDir: custom\\nvirtualStoreDir: old\\n\")","+        .expect(\"write workspace settings\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = config.workspaceDir + '/.'; config.virtualStoreDir = 'new'; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&workspace).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &workspace).await","+        .expect(\"run updateConfig hook\");","+","+    let virtual_store_dir = workspace.join(\"new\");","+    assert_eq!(config.lockfile_dir, None);","+    assert_eq!(config.configured_virtual_store_dir, Some(virtual_store_dir.clone()));","+    assert_eq!(config.install_state_dir, virtual_store_dir);","+}","+","+#[tokio::test]","+async fn update_config_default_lockfile_dir_rederives_state_after_modules_dir_change() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    let project = workspace.join(\"packages/app\");","+    fs::create_dir_all(&project).expect(\"create project directory\");","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write workspace settings\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.modulesDir = 'custom_modules'; config.lockfileDir = config.workspaceDir + '/.'; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&project).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &workspace).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.lockfile_dir, None);","+    assert_eq!(config.modules_dir, workspace.join(\"custom_modules\"));","+    assert_eq!(config.install_state_dir, workspace.join(\"custom_modules/.pnpm\"));","+}","+","+#[tokio::test]","+async fn clearing_lockfile_dir_with_modules_dir_change_reanchors_virtual_store_dir() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    let project = workspace.join(\"packages/app\");","+    fs::create_dir_all(&project).expect(\"create project directory\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nsharedWorkspaceLockfile: false\\nlockfileDir: custom\\nvirtualStoreDir: cache\\n\",","+    )","+    .expect(\"write workspace settings\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = null; config.modulesDir = 'custom_modules'; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&project).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &workspace).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.lockfile_dir, None);","+    assert_eq!(config.modules_dir, workspace.join(\"custom_modules\"));","+    assert_eq!(config.virtual_store_dir(), workspace.join(\"cache\"));","+    assert_eq!(config.install_state_dir, workspace.join(\"cache\"));","+}","+","+#[tokio::test]","+async fn update_config_lockfile_dir_uses_the_invoking_project_as_its_default() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    let project = workspace.join(\"packages/app\");","+    fs::create_dir_all(&project).expect(\"create project directory\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nsharedWorkspaceLockfile: false\\n\",","+    )","+    .expect(\"write workspace settings\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = '.'; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&project).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &workspace).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.lockfile_dir, Some(workspace.clone()));","+    assert_eq!(config.modules_dir, workspace.join(\"node_modules\"));","+    assert!(config.shares_one_lockfile());","+}","+","+#[cfg_attr(not(unix), ignore = \"requires Unix path semantics\")]","+#[tokio::test]","+async fn update_config_lockfile_dir_refreshes_derived_node_path() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    let workspace = root.path().join(\"workspace\");","+    let project = workspace.join(\"packages/app\");","+    let lockfile_dir = workspace.join(\"external\");","+    fs::create_dir_all(&project).expect(\"create project directory\");","+    fs::create_dir_all(&lockfile_dir).expect(\"create lockfile directory\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nlockfileDir: external\\npreferSymlinkedExecutables: true\\n\",","+    )","+    .expect(\"write workspace settings\");","+    fs::write(","+        lockfile_dir.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.lockfileDir = config.workspaceDir; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(&project).expect(\"load configuration\");","+    assert_eq!(","+        config.extra_env.get(\"NODE_PATH\").map(String::as_str),","+        Some(","+            lockfile_dir","+                .join(\"node_modules/.pnpm/node_modules\")","+                .to_str()","+                .unwrap()","+        ),","+    );","+","+    run_update_config_hooks::<SilentReporter>(&mut config, &lockfile_dir).await","+        .expect(\"run updateConfig hook\");","+","+    asser