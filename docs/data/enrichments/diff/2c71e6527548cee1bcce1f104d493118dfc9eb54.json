ncipal(user));","+        ReqContext context = new ReqContext(subject);","+        context.setRealPrincipal(new SingleUserPrincipal(realUser));","+        context.setRemoteAddress(remoteAddress);","+        return context;","+    }","+","+    @Test","+    public void testRealPrincipalWithoutNameIsDenied() {","+        ImpersonationAuthorizer authorizer = mkAuthorizer(\"bob\", Collections.singletonList(\"*\"));","+        ReqContext context = mkContext(null, \"alice\", InetAddress.getLoopbackAddress());","+        assertTrue(context.isImpersonating());","+        assertFalse(authorizer.permit(context, \"execute\", null));","+    }","+","+    @Test","+    public void testRealPrincipalWithoutNameIsDeniedWithNullAclEntry() {","+        ImpersonationAuthorizer authorizer = mkAuthorizer(null, Collections.singletonList(\"*\"));","+        ReqContext context = mkContext(null, \"alice\", InetAddress.getLoopbackAddress());","+        assertFalse(authorizer.permit(context, \"execute\", null));","+    }","+","+    @Test","+    public void testRealPrincipalWithEmptyNameIsDenied() {","+        ImpersonationAuthorizer authorizer = mkAuthorizer(\"\", Collections.singletonList(\"*\"));","+        ReqContext context = mkContext(\"\", \"alice\", InetAddress.getLoopbackAddress());","+        assertTrue(context.isImpersonating());","+        assertFalse(authorizer.permit(context, \"execute\", null));","+    }","+","+    @Test","+    public void testHostListedByAddressSkipsNameLookup() {","+        ImpersonationAuthorizer authorizer = mkAuthorizer(\"bob\", Collections.singletonList(\"192.0.2.10\"));","+        InetAddress remoteAddress = mock(InetAddress.class);","+        when(remoteAddress.getHostAddress()).thenReturn(\"192.0.2.10\");","+        assertTrue(authorizer.permit(mkContext(\"bob\", \"alice\", remoteAddress), \"execute\", null));","+        verify(remoteAddress, never()).getCanonicalHostName();","+        verify(remoteAddress, never()).getHostName();","+    }","+","+    @Test","+    public void testHostListedByName() {","+        ImpersonationAuthorizer authorizer = mkAuthorizer(\"bob\", Collections.singletonList(\"client.example.com\"));","+        InetAddress remoteAddress = mock(InetAddress.class);","+        when(remoteAddress.getHostAddress()).thenReturn(\"192.0.2.10\");","+        when(remoteAddress.getCanonicalHostName()).thenReturn(\"client.example.com\");","+        assertTrue(authorizer.permit(mkContext(\"bob\", \"alice\", remoteAddress), \"execute\", null));","+    }","+","+    @Test","+    public void testUnlistedHostDenied() {","+        ImpersonationAuthorizer authorizer = mkAuthorizer(\"bob\", Collections.singletonList(\"192.0.2.10\"));","+        InetAddress remoteAddress = mock(InetAddress.class);","+        when(remoteAddress.getHostAddress()).thenReturn(\"192.0.2.11\");","+        when(remoteAddress.getCanonicalHostName()).thenReturn(\"other.example.com\");","+        when(remoteAddress.getHostName()).thenReturn(\"other.example.com\");","+        assertFalse(authorizer.permit(mkContext(\"bob\", \"alice\", remoteAddress), \"execute\", null));","+    }","+}"],"additions":108,"deletions":0,"truncated":false},{"path":"storm-server/src/main/java/org/apache/storm/daemon/drpc/DRPC.java","lines":["@@ -29,6 +29,7 @@"," import java.util.concurrent.ConcurrentLinkedQueue;"," import java.util.concurrent.atomic.AtomicLong;"," import java.util.concurrent.atomic.AtomicReference;","+import org.apache.storm.Config;"," import org.apache.storm.DaemonConfig;"," import org.apache.storm.daemon.StormCommon;"," import org.apache.storm.generated.AuthorizationException;","@@ -76,14 +77,21 @@ public class DRPC implements AutoCloseable {","     private final Timer timer = new Timer(\"DRPC-CLEANUP-TIMER\", true);","     private final AtomicLong ctr = new AtomicLong(0);","     private final IAuthorizer auth;","+    private final IAuthorizer impersonationAuth;"," ","     public DRPC(StormMetricsRegistry metricsRegistry, Map<String, Object> conf) {",