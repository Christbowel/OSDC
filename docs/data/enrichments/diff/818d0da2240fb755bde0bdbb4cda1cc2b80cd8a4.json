ction between the two casts dropped it. Checked first so that a chain of casts over the same field","          * does not walk the subtree below every cast.","          */","-        private static boolean referencesMissingFromInputs(LogicalPlan plan) {","+        private static boolean referencesMissingFromInputs(LogicalPlan plan, Set<NameId> nestedPredicateConversions) {","             AttributeSet inputs = plan.inputSet();","             for (Attribute reference : plan.references()) {","-                if (reference.synthetic() && inputs.contains(reference) == false) {","+                if (reference.synthetic()","+                    && inputs.contains(reference) == false","+                    && nestedPredicateConversions.contains(reference.id()) == false) {","                     return true;","                 }","             }"],"additions":34,"deletions":52,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/rules/BindNestedAny.java","lines":["@@ -0,0 +1,314 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.analysis.rules;","+","+import org.elasticsearch.xpack.esql.VerificationException;","+import org.elasticsearch.xpack.esql.analysis.AnalyzerContext;","+import org.elasticsearch.xpack.esql.common.Failure;","+import org.elasticsearch.xpack.esql.core.expression.Alias;","+import org.elasticsearch.xpack.esql.core.expression.Attribute;","+import org.elasticsearch.xpack.esql.core.expression.Expression;","+import org.elasticsearch.xpack.esql.core.expression.FieldAttribute;","+import org.elasticsearch.xpack.esql.core.expression.NameId;","+import org.elasticsearch.xpack.esql.core.expression.ReferenceAttribute;","+import org.elasticsearch.xpack.esql.core.expression.UnresolvedAttribute;","+import org.elasticsearch.xpack.esql.core.expression.UnsupportedAttribute;","+import org.elasticsearch.xpack.esql.core.type.DataType;","+import org.elasticsearch.xpack.esql.core.type.EsField;","+import org.elasticsearch.xpack.esql.core.type.NestedScopeField;","+import org.elasticsearch.xpack.esql.core.type.TypeConflictedField;","+import org.elasticsearch.xpack.esql.core.type.UnionTypeEsField;","+import org.elasticsearch.xpack.esql.core.type.UnsupportedEsField;","+import org.elasticsearch.xpack.esql.expression.function.scalar.nested.NestedAny;","+import org.elasticsearch.xpack.esql.expression.function.scalar.nested.NestedPredicate;","+import org.elasticsearch.xpack.esql.plan.logical.Eval;","+import org.elasticsearch.xpack.esql.plan.logical.Filter;","+import org.elasticsearch.xpack.esql.plan.logical.LogicalPlan;","+import org.elasticsearch.xpack.esql.rule.ParameterizedRule;","+import org.elasticsearch.xpack.esql.session.Configuration;","+","+import java.util.ArrayList;","+import java.util.HashMap;","+import java.util.HashSet;","+import java.util.LinkedHashMap;","+import java.util.List;","+import java.util.Map;","+import java.util.Set;","+","+/**","+ * Binds {@code NESTED_ANY} to the private nested schema and lowers it to a {@link NestedPredicate}. Name resolution ignores","+ * that schema, so {@link #scope} runs while attributes are still unresolved and this rule runs after implicit casting.","+ */","+public final class BindNestedAny extends ParameterizedRule<LogicalPlan, LogicalPlan, AnalyzerContext> {","+    /**","+     * Rewrites nested names inside {@code NESTED_ANY} onto the private schema. Leaves every other name unresolved. A column of the","+     * query with the same name replaces the child, as a later definition does everywhere else, so that is an error.","+     */","+    public static LogicalPlan scope(LogicalPlan plan, List<Attribute> childrenOutput) {","+        if (plan instanceof Eval eval) {","+            return scopeEval(eval, childrenOutput);","+        }","+        return plan.transformExpressionsOnlyUp(NestedAny.class, nested -> scope(nested, childrenOutput, Set.of()));","+    }","+","+    /** Each assignment sees the columns the earlier assignments of the same {@code EVAL} define. */","+    private static LogicalPlan scopeEval(Eval eval, List<Attribute> childrenOutput) {","+        if (eval.fields().stream().noneMatch(field -> field.anyMatch(NestedAny.class::isInstance))) {","+            return eval;","+        }","+        Set<String> assigned = new HashSet<>();","+        List<Alias> fields = new ArrayList<>();","+        for (Alias field : eval.fields()) {","+            fields.add((Alias) field.transformUp(NestedAny.class, nested -> scope(nested, childrenOutput, assigned)));","+            assigned.add(field.name());","+        }","+        return fields.equals(eval.fields()) ? eval : new Eval(eval.source(), eval.child(), fields);","+    }","+","+    private static Expression scope(NestedAny nested, List<Attribute> childrenOutput, Set<String> assigned) {","+        return nested.transformUp(UnresolvedAttribute.class, attribute -> {","+            Attribute field = nestedField(attribute, childrenOutput, assigned);","+            return field == null ? attribute : field;","+        });","+    }","+","+    @Override","+    public LogicalPlan apply(LogicalPlan plan, AnalyzerContext context) {","+        return plan.transformUp(p -> {","+            NestedAny nested = find(p);","+            if (nested == null) {","+                return p;","+            }","+            if (context.minimumVersion().supports(NestedPredicate.VERSION) == false) {","+                throw error(nested, \"NESTED_ANY requires all nodes to support nested predicates\");","+            }","+            if (p instanceof Filter == false && p instanceof Eval == false) {","+                throw error(nested, \"NESTED_ANY is supported in EVAL and WHERE\");","+            }","+            if (p.child