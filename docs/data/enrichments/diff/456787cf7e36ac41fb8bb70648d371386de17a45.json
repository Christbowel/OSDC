uments: [2026, \"worklet\", true])","+  }","+","+  @JS","+  func scheduleWorkletWithArgs(_ worklet: Worklet) throws {","+    worklet.schedule(on: try workletRuntime(), arguments: [2026, \"worklet\", true])","+  }"," ","-    Function(\"scheduleWorklet\") { (worklet: Worklet) in","-      guard let uiRuntime = try appContext?.uiRuntime as? WorkletRuntime else {","-        throw Exceptions.RuntimeLost()","-      }","-      worklet.schedule(on: uiRuntime)","+  /// Runs work on the UI runtime from a thread of the concurrent pool and returns whether it ran on the main thread.","+  @JS(.concurrent)","+  func isUIRuntimeWorkOnMainThread() async throws -> Bool {","+    let uiRuntime = try workletRuntime()","+    return try await uiRuntime.execute {","+      Thread.isMainThread","     }","+  }"," ","-    Function(\"executeWorkletWithArgs\") { (worklet: Worklet) in","-      guard let uiRuntime = try appContext?.uiRuntime as? WorkletRuntime else {","-        throw Exceptions.RuntimeLost()","-      }","-      worklet.execute(on: uiRuntime, arguments: [2026, \"worklet\", true])","+  /// Evaluates the source on the UI runtime, on its thread, and returns the result as a string.","+  @JS(.concurrent)","+  func evaluateOnUIRuntime(_ source: String) async throws -> String {","+    let uiRuntime = try workletRuntime()","+    return try await uiRuntime.execute {","+      try uiRuntime.eval(source).asString()","     }","+  }"," ","-    Function(\"scheduleWorkletWithArgs\") { (worklet: Worklet) in","-      guard let uiRuntime = try appContext?.uiRuntime as? WorkletRuntime else {","-        throw Exceptions.RuntimeLost()","-      }","-      worklet.schedule(on: uiRuntime, arguments: [2026, \"worklet\", true])","+  private func workletRuntime() throws -> WorkletRuntime {","+    guard let uiRuntime = try appContext?.uiRuntime as? WorkletRuntime else {","+      throw Exceptions.RuntimeLost()","     }","+    return uiRuntime","+  }","+}","+","+@SharedObject","+public final class WorkletsTesterCounter: SharedObject {","+  @JS","+  var value = 0","+","+  @JS","+  init(value: Int) {","+    self.value = value","+  }","+","+  @JS","+  func increment() -> Int {","+    value += 1","+    return value","   }"," }"],"additions":57,"deletions":24,"truncated":false},{"path":"apps/bare-expo/modules/worklets-tester/src/WorkletsTesterModule.ts","lines":["@@ -1,11 +1,24 @@","-import { requireOptionalNativeModule, NativeModule } from 'expo';","+import { requireOptionalNativeModule, NativeModule, SharedObject } from 'expo';"," "," type SerializableRef<TValue = unknown> = {","   __serializableRef: true;","   __nativeStateSerializableJSRef: TValue;"," };"," ","+declare class WorkletsTesterCounter extends SharedObject {","+  // A hidden property that native installs. Worklets pass shared objects by this ID.","+  readonly __expo_shared_object_id__: number;","+  constructor(value: number);","+  readonly value: number;","+  increment(): number;","+}","+"," declare class WorkletsTesterModule extends NativeModule {","+  WorkletsTesterCounter: typeof WorkletsTesterCounter;","+","+  isUIRuntimeWorkOnMainThread(): Promise<boolean>;","+  evaluateOnUIRuntime(source: string): Promise<string>;","+","   executeWorklet(worklet: SerializableRef<() => void>): void;","   scheduleWorklet(worklet: SerializableRef<() => void>): void;"," "],"additions":14,"deletions":1,"truncated":false},{"path":"apps/bare-expo/modules/worklets-tester/src/index.ts","lines":["@@ -1,4 +1,5 @@","-import { createSerializable } from 'react-native-worklets';","+import { installOnUIRuntime } from 'expo';","+import { createSerializable, getUIRuntimeHolder } from 'react-native-worklets';"," "," import WorkletsTesterModule from './WorkletsTesterModule';"," ","@@ -19,6 +20,22 @@ export const WorkletsTester = {","     WorkletsTesterModule?.scheduleWorkletWithArgs?.(createSerializable(worklet));","   },"," ","+  installUIRuntime() {","+    installOnUIRuntime(getUIRuntimeHolder());","+  },","+","+  isUIRuntimeWorkOnMainThread(