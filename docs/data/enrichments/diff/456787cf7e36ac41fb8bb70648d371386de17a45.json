runtimePointee,","+        valuePointer: valuePointee","+      )","+    }","+  }","+  guard let jsSerializable else {","+    // Adapter not linked → the extractor returns nil for every value; give an actionable error.","+    if WorkletsProviderRegistry.shared == nil {","+      throw WorkletsNotInstalledException()","+    }","+    throw NotSerializableException(type)","+  }","+  return jsSerializable","+}","+"," internal final class NotSerializableException: GenericException<AnySerializable.Type>, @unchecked Sendable {","   override var reason: String {","     \"Given argument is not an instance of \\(param)\""],"additions":25,"deletions":17,"truncated":false},{"path":"packages/expo-modules-core/ios/Worklets/Core/Serializable.swift","lines":["@@ -1,6 +1,7 @@"," // Copyright 2025-present 650 Industries. All rights reserved."," "," import ExpoModulesCore","+import ExpoModulesJSI"," "," /**","  A protocol for all serializable types from react-native-worklets.","@@ -26,3 +27,14 @@ public class Serializable: AnySerializable {","     self.jsSerializable = jsSerializable","   }"," }","+","+extension Serializable: JavaScriptDecodable {","+  public static var decodableKinds: JavaScriptValueKinds {","+    return .object","+  }","+","+  @JavaScriptActor","+  public static func decode(_ value: borrowing JavaScriptValue, in runtime: borrowing JavaScriptRuntime) throws -> Self {","+    return Self(try extractSerializable(value, in: runtime, as: Self.self))","+  }","+}"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/expo-modules-core/ios/Worklets/Core/Worklet.swift","lines":["@@ -1,6 +1,7 @@"," // Copyright 2025-present 650 Industries. All rights reserved."," "," import ExpoModulesCore","+import ExpoModulesJSI"," "," /**","  A wrapper class for worklets from react-native-worklets.","@@ -41,6 +42,21 @@ public class Worklet: AnySerializable {","   }"," }"," ","+extension Worklet: JavaScriptDecodable {","+  public static var decodableKinds: JavaScriptValueKinds {",