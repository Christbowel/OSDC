{"id":"GHSA-c6hw-5grf-ff96","axis":"advisories","repo":"python-pillow/Pillow","sha":"1d4773e6cea0c4a2814e6d4cdc099bbcf56da6ce","parsed":{"files":[{"path":"Tests/test_file_libtiff.py","lines":["@@ -1215,6 +1215,44 @@ def test_no_rows_per_strip(self) -> None:","             im.load()","         assert im.size == (950, 975)"," ","+    @pytest.mark.parametrize(\"tiled\", (False, True))","+    def test_jpeg_short_strip(self, tiled: bool) -> None:","+        # The JPEG data in the strip/tile only contains 8 of the 256 rows that","+        # RowsPerStrip/TileLength declare. libtiff decodes the rows that exist","+        # and still reports success, so the remaining rows must be cleared","+        # rather than left as uninitialised memory.","+        jpeg = io.BytesIO()","+        Image.new(\"L\", (256, 8), 200).save(jpeg, \"JPEG\")","+        jpeg_data = jpeg.getvalue()","+","+        ifd = TiffImagePlugin.ImageFileDirectory_v2()","+        ifd[TiffImagePlugin.IMAGEWIDTH] = 256","+        ifd[TiffImagePlugin.IMAGELENGTH] = 256","+        ifd[TiffImagePlugin.BITSPERSAMPLE] = 8","+        ifd[TiffImagePlugin.COMPRESSION] = 7  # JPEG","+        ifd[TiffImagePlugin.PHOTOMETRIC_INTERPRETATION] = 1  # BlackIsZero","+        if tiled:","+            ifd[TiffImagePlugin.TILEWIDTH] = 256","+            ifd[TiffImagePlugin.TILELENGTH] = 256","+            ifd[TiffImagePlugin.TILEOFFSETS] = 0","+            ifd[TiffImagePlugin.TILEBYTECOUNTS] = len(jpeg_data)","+            # Point the tile data at the end of the IFD","+            ifd[TiffImagePlugin.TILEOFFSETS] = 8 + len(ifd.tobytes(8))","+        else:","+            ifd[TiffImagePlugin.ROWSPERSTRIP] = 256","+            # Strip offsets is updated by tobytes()","+            ifd[TiffImagePlugin.STRIPOFFSETS] = 0","+            ifd[TiffImagePlugin.STRIPBYTECOUNTS] = len(jpeg_data)","+","+        b = io.BytesIO()","+        ifd.save(b)","+        b.write(jpeg_data)","+","+        with Image.open(b) as im:","+            assert im.tile[0].codec_name == \"libtiff\"","+            assert im.crop((0, 0, 256, 8)).getextrema() == (200, 200)","+            assert im.crop((0, 8, 256, 256)).getextrema() == (0, 0)","+","     def test_orientation(self) -> None:","         with Image.open(\"Tests/images/g4_orientation_1.tif\") as base_im:","             for i in range(2, 9):"],"additions":38,"deletions":0,"truncated":false},{"path":"src/libImaging/TiffDecode.c","lines":["@@ -361,17 +361,24 @@ _decodeTile(","         return -1;","     }"," ","-    state->bytes = tile_bytes_size;","-","     /* realloc to fit whole tile */","     /* malloc check above */","-    new_data = realloc(state->buffer, state->bytes);","+    new_data = realloc(state->buffer, tile_bytes_size);","     if (!new_data) {","         state->errcode = IMAGING_CODEC_MEMORY;","         return -1;","     }","     state->buffer = new_data;"," ","+    if (tile_bytes_size > state->bytes) {","+        // Some codecs (e.g. JPEG, Group 4) succeed on a tile that decodes","+        // to fewer rows than the tile length, leaving the rest of the buffer untouched.","+        // Clear it so that uninitialised memory is not copied into the image.","+        memset(state->buffer + state->bytes, 0, tile_bytes_size - state->bytes);","+    }","+","+    state->bytes = tile_bytes_size;","+","     for (y = state->yoff; y < state->ysize; y += tile_length) {","         int plane;","         for (plane = 0; plane < planes; plane++) {","@@ -438,8 +445,6 @@ _decodeStrip(","         return -1;","     }"," ","-    state->bytes = strip_size;","-","     row_byte_size = TIFFScanlineSize(tiff);"," ","     // if the unpacker calculated row size is > row byte size, (at least) the last","@@ -451,14 +456,22 @@ _decodeStrip("," ","     /* realloc to fit whole strip */","     /* malloc check above */","-    new_data = realloc(state->buffer, state->bytes);","+    new_data = realloc(state->buffer, strip_size);","     if (!new_data) {","         state->errcode = IMAGING_CODEC_MEMOR