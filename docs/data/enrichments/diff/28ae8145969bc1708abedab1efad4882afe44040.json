{"id":"28ae8145969bc1708abedab1efad4882afe44040","axis":"silent","repo":"hashicorp/consul","sha":"28ae8145969bc1708abedab1efad4882afe44040","parsed":{"files":[{"path":".changelog/23647.txt","lines":["@@ -0,0 +1,7 @@","+```release-note:feature","+api-gateway: Auto-register DNS for services exposed via an API Gateway, resolvable at `<service>.api-gateway.consul`. Populates the `gateway-services` catalog mapping for API Gateways and adds DNS SANs to the API Gateway Connect leaf certificate, bringing API Gateway to parity with Ingress Gateway. The feature is version-gated and backfills pre-existing gateways automatically once all servers are upgraded.","+```","+```release-note:feature","+api-gateway: Support zero-touch downstream TLS termination. When `TLS { Enabled = true }` is set on an `api-gateway` config entry with no inline/file-system/SDS certificate, the gateway terminates downstream TLS using its Connect CA leaf certificate (with `*.api-gateway.consul` DNS SANs). Explicitly configured certificates continue to take precedence and are served as SNI overrides alongside the leaf default chain.","+```","+"],"additions":7,"deletions":0,"truncated":false},{"path":".gitignore","lines":["@@ -71,3 +71,4 @@ consul-k8s/"," .vercel"," vendor/"," .claude","+local-testing/"],"additions":1,"deletions":0,"truncated":false},{"path":"agent/consul/gateways/controller_gateways.go","lines":["@@ -901,11 +901,19 @@ func newGatewayMeta(gateway *structs.APIGatewayConfigEntry, bound structs.Config"," \t}"," "," \t// we just clear out the bound state here since we recalculate it entirely","-\t// in the gateway control loop","+\t// in the gateway control loop. Copy config fields from the APIGatewayListener","+\t// so that BoundAPIGatewayListener is self-contained for proxycfg/xds consumers."," \tlisteners := make([]structs.BoundAPIGatewayListener, 0, len(gateway.Listeners))"," \tfor _, listener := range gateway.Listeners {"," \t\tlisteners = append(listeners, structs.BoundAPIGatewayListener{","-\t\t\tName: listener.Name,","+\t\t\tName:                listener.Name,","+\t\t\tHostname:            listener.Hostname,","+\t\t\tPort:                listener.Port,","+\t\t\tProtocol:            listener.Protocol,","+\t\t\tTLS:                 listener.TLS,","+\t\t\tOverride:            listener.Override,","+\t\t\tDefault:             listener.Default,","+\t\t\tMaxRequestHeadersKB: listener.MaxRequestHeadersKB,"," \t\t})"," \t}"," "],"additions":10,"deletions":2,"truncated":false},{"path":"agent/consul/health_endpoint.go","lines":["@@ -222,6 +222,8 @@ func (h *Health) ServiceNodes(args *structs.ServiceSpecificRequest, reply *struc"," \t\tf = h.serviceNodesTagFilter"," \tcase args.Ingress:"," \t\tf = h.serviceNodesIngress","+\tcase args.APIGateway:","+\t\tf = h.serviceNodesAPIGateway"," \tdefault:"," \t\tf = h.serviceNodesDefault"," \t}","@@ -238,9 +240,9 @@ func (h *Health) ServiceNodes(args *structs.ServiceSpecificRequest, reply *struc"," \t\treturn err"," \t}"," ","-\t// If we're doing a connect or ingress query, we need read access to the service","-\t// we're trying to find proxies for, so check that.","-\tif args.Connect || args.Ingress {","+\t// If we're doing a connect, ingress, or API gateway query, we need read access","+\t// to the service we're trying to find proxies for, so check that.","+\tif args.Connect || args.Ingress || args.APIGateway {"," \t\tif authz.ServiceRead(args.ServiceName, &authzContext) != acl.Allow {"," \t\t\treturn acl.ErrPermissionDenied"," \t\t}","@@ -364,6 +366,9 @@ func (h *Health) ServiceNodes(args *structs.ServiceSpecificRequest, reply *struc"," \t\tif args.Ingress {"," \t\t\tkey = \"ingress\""," \t\t}","+\t\tif args.APIGateway {","+\t\t\tkey = \"api-gateway\"","+\t\t}"," "," \t\tmetrics.IncrCounterWithLabels([]string{\"health\", key, \"query\"}, 1,"," \t\t\t[]metrics.Label{{Name: \"service\", Value: args.ServiceName}})","@@ -403,6 +408,10 @@ func (h *Health) serviceNodesIngress(ws memdb.WatchSet, s *state.Store, args *st"," \treturn s.CheckIngressServiceNodes(ws, args.ServiceName, &args.EnterpriseMeta)"," }"," ","+func (h *Health) serviceNodesAPIGateway(ws memdb.WatchSet, s *state.Store, args *structs.ServiceSpecificRequest) (uint64, structs.CheckServiceNodes, error) {","+\treturn s.CheckAPIGatewayServiceNodes(ws, args.ServiceName, &args.EnterpriseMeta)","+}","+"," func (h *Health) serviceNodesTagFilter(ws memdb.WatchSet, s *state.Store, args *structs.ServiceSpecificRequest) (uint64, structs.CheckServiceNodes, error) {"," \t// DEPRECATED (singular-service-tag) - remove this when backwards RPC compat"," \t// with 1.2.x is not required."],"additions":12,"deletions":3,"truncated":false},{"path":"agent/consul/health_endpoint_test.go","lines":["@@ -1496,6 +1496,231 @@ func TestHealth_ServiceNodes_Ingress_ACL(t *testing.T) {"," \trequire.Equal(t, nodes[1].Checks[0].Status, api.HealthPassing)"," }"," ","+// setupAPIGatewayDNSMapping writes, directly into the leader's state store, the","+// api-gateway / http-route / bound-api-gateway config entries needed to","+// materialize a gateway<->service mapping (gateway \"api-gw\" fronting","+// serviceName). This mirrors what the API gateway controller produces, but does","+// so deterministically so the Health.ServiceNodes RPC can be exercised without","+// depending on controller timing.","+func setupAPIGatewayDNSMapping(t *testing.T, s *Server, serviceName string) {","+\tt.Helper()","+\tstore := s.fsm.State()","+","+\tvar idx uint64 = 1","+\tnext := func() uint64 { idx++; return idx }","+","+\trequire.NoError(t, store.EnsureConfigEntry(next(), &structs.ProxyConfigEntry{","+\t\tKind:   structs.ProxyDefaults,","+\t\tName:   structs.ProxyConfigGlobal,","+\t\tConfig: map[string]interface{}{\"protocol\": \"http\"},","+\t}))","+\trequire.NoError(t, store.EnsureConfigEntry(next(), &structs.APIGatewayConfigEntry{","+\t\tKind: structs.APIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.APIGatewayListener{","+\t\t\t{Name: \"http-listener\", Port: 8443, Protocol: structs.ListenerProtocolHTTP},","+\t\t},","+\t}))","+\trequire.NoError(t, store.EnsureConfigEntry(next(), &structs.HTTPRouteConfigEntry{","+\t\tKind:    structs.HTTPRoute,","+\t\tName:    \"route-\" + serviceName,","+\t\tParents: []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\tRules: []structs.HTTPRouteRule{","+\t\t\t{Services: []structs.HTTPService{{Name: serviceName}}},","+\t\t},","+\t}))","+\trequire.NoError(t, store.EnsureConfigEntry(next(), &structs.BoundAPIGatewayConfigEntry{","+\t\tKind: structs.BoundAPIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.BoundAPIGatewayListener{","+\t\t\t{","+\t\t\t\tName:   \"http-listener\",","+\t\t\t\tRoutes: []structs.ResourceReference{{Kind: structs.HTTPRoute, Name: \"route-\" + serviceName}},","+\t\t\t},","+\t\t},","+\t}))","+}","+","+// TestHealth_ServiceNodes_APIGateway verifies that a Health.ServiceNodes query","+// with APIGateway=true resolves the service through the gateway-services mapping","+// and returns the API gateway instances (with their health) that front it, the","+// API gateway analog of TestHealth_ServiceNodes_Ingress.","+func TestHealth_ServiceNodes_APIGateway(t *testing.T) {","+\tif testing.Short() {","+\t\tt.Skip(\"too slow for testing.Short\")","+\t}","+","+\tt.Parallel()","+\tdir1, s1 := testServer(t)","+\tdefer os.RemoveAll(dir1)","+\tdefer s1.Shutdown()","+\tcodec := rpcClient(t, s1)","+\tdefer codec.Close()","+","+\ttestrpc.WaitForLeader(t, s1.RPC, \"dc1\")","+","+\t// Register two API gateway instances with differing health.","+\trequire.NoError(t, s1.fsm.State().EnsureRegistration(10, &structs.RegisterRequest{","+\t\tNode:    \"foo\",","+\t\tAddress: \"127.0.0.1\",","+\t\tService: &structs.NodeService{","+\t\t\tID:      \"api-gw\",","+\t\t\tService: \"api-gw\",","+\t\t\tKind:    structs.ServiceKindAPIGateway,","+\t\t},","+\t\tCheck: &structs.HealthCheck{","+\t\t\tNode:      \"foo\",","+\t\t\tCheckID:   \"foo-api-gw\",","+\t\t\tName:      \"api-gateway\",","+\t\t\tStatus:    api.HealthPassing,","+\t\t\tServiceID: \"api-gw\",","+\t\t},","+\t}))","+\trequire.NoError(t, s1.fsm.State().EnsureRegistration(11, &structs.RegisterRequest{","+\t\tNode:    \"bar\",","+\t\tAddress: \"127.0.0.2\",","+\t\tService: &structs.NodeService{","+\t\t\tID:      \"api-gw\",","+\t\t\tService: \"api-gw\",","+\t\t\tKind:    structs.ServiceKindAPIGateway,","+\t\t},","+\t\tCheck: &structs.HealthCheck{","+\t\t\tNode:      \"bar\",","+\t\t\tCheckID:   \"bar-api-gw\",","+\t\t\tName:      \"api-gateway\",","+\t\t\tStatus:    api.HealthWarning,","+\t\t\tServiceID: \"api-gw\",","+\t\t},","+\t}))","+","+\tsetupAPIGatewayDNSMapping(t, s1, \"db\")","+","+\t// retry to tolerate the API gateway controller idempotently re-reconciling","+\t// the bound-api-gateway entry we wrote directly.","+\tretry.Run(t, func(r *retry.R) {","+\t\tvar out structs.IndexedCheckServiceNodes","+\t\treq := structs.ServiceSpecificRequest{","+\t\t\tDatacenter:  \"dc1\",","+\t\t\tServiceName: \"db\",","+\t\t\tAPIGateway:  true,","+\t\t}","+\t\trequire.NoError(r, msgpackrpc.CallWithCodec(codec, \"Health.ServiceNodes\", &req, &out))","+\t\trequire.Len(r, out.Nodes, 2)","+","+\t\tbyNode := make(map[string]string)","+\t\tfor _, n := range out.Nodes {","+\t\t\tbyNode[n.Node.Node] = n.Checks[0].Status","+\t\t}","+\t\trequire.Equal(r, api.HealthPassing, byNode[\"foo\"])","+\t\trequire.Equal(r, api.HealthWarning, byNode[\"bar\"])","+\t})","+}","+","+// TestHealth_ServiceNodes_APIGateway_ACL verifies that API gateway DNS queries","+// enforce service:read on the fronted service, mirroring the ingress behavior.","+func TestHealth_ServiceNodes_APIGateway_ACL(t *testing.T) {","+\tif testing.Short() {","+\t\tt.Skip(\"too slow for testing.Short\")","+\t}","+","+\tt.Parallel()","+\tdir1, s1 := testServerWithConfig(t, func(c *Config) {","+\t\tc.PrimaryDatacenter = \"dc1\"","+\t\tc.ACLsEnabled = true","+\t\tc.ACLInitialManagementToken = \"root\"","+\t\tc.ACLResolverSettings.ACLDefaultPolicy = \"deny\"","+\t})","+\tdefer os.RemoveAll(dir1)","+\tdefer s1.Shutdown()","+\tcodec := rpcClient(t, s1)","+\tdefer codec.Close()","+","+\ttestrpc.WaitForLeader(t, s1.RPC, \"dc1\", testrpc.WithToken(\"root\"))","+","+\t// Token can read \"db\" and the gateway, but not \"another\".","+\ttoken, err := upsertTestTokenWithPolicyRules(codec, \"root\", \"dc1\", `","+  service \"db\" { policy = \"read\" }","+\tservice \"api-gw\" { policy = \"read\" }","+\tnode_prefix \"\" { policy = \"read\" }`)","+\trequire.NoError(t, err)","+","+\trequire.NoError(t, s1.fsm.State().EnsureRegistration(10, &structs.RegisterRequest{","+\t\tNode:    \"foo\",","+\t\tAddress: \"127.0.0.1\",","+\t\tService: &structs.NodeService{","+\t\t\tID:      \"api-gw\",","+\t\t\tService: \"api-gw\",","+\t\t\tKind:    structs.ServiceKindAPIGateway,","+\t\t},","+\t\tCheck: &structs.HealthCheck{","+\t\t\tNode:      \"foo\",","+\t\t\tCheckID:   \"foo-api-gw\",","+\t\t\tName:      \"api-gateway\",","+\t\t\tStatus:    api.HealthPassing,","+\t\t\tServiceID: \"api-gw\",","+\t\t},","+\t}))","+","+\t// Map both \"db\" and \"another\" behind the gateway.","+\tsetupAPIGatewayDNSMapping(t, s1, \"db\")","+\trequire.NoError(t, s1.fsm.State().EnsureConfigEntry(100, &structs.HTTPRouteConfigEntry{","+\t\tKind:    structs.HTTPRoute,","+\t\tName:    \"route-another\",","+\t\tParents: []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\tRules: []structs.HTTPRouteRule{","+\t\t\t{Services: []structs.HTTPService{{Name: \"another\"}}},","+\t\t},","+\t}))","+\trequire.NoError(t, s1.fsm.State().EnsureConfigEntry(101, &structs.BoundAPIGatewayConfigEntry{","+\t\tKind: structs.BoundAPIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.BoundAPIGatewayListener{","+\t\t\t{","+\t\t\t\tName: \"http-listener\",","+\t\t\t\tRoutes: []structs.ResourceReference{","+\t\t\t\t\t{Kind: structs.HTTPRoute, Name: \"route-db\"},","+\t\t\t\t\t{Kind: structs.HTTPRoute, Name: \"route-another\"},","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t}))","+","+\tvar out structs.IndexedCheckServiceNodes","+","+\t// No token: permission denied.","+\treq := structs.ServiceSpecificRequest{","+\t\tDatacenter:  \"dc1\",","+\t\tServiceName: \"db\",","+\t\tAPIGateway:  true,","+\t}","+\trequire.ErrorContains(t, msgpackrpc.CallWithCodec(codec, \"Health.ServiceNodes\", &req, &out), \"Permission denied\")","+\trequire.Len(t, out.Nodes, 0)","+","+\t// Service not covered by the token's policy: permission denied.","+\treq = structs.ServiceSpecificRequest{","+\t\tDatacenter:   \"dc1\",","+\t\tServiceName:  \"another\",","+\t\tAPIGateway:   true,","+\t\tQueryOptions: structs.QueryOptions{Token: token.SecretID},","+\t}","+\trequire.ErrorContains(t, msgpackrpc.CallWithCodec(codec, \"Health.ServiceNodes\", &req, &out), \"Permission denied\")","+\trequire.Len(t, out.Nodes, 0)","+","+\t// Service covered by the token's policy: allowed.","+\tretry.Run(t, func(r *retry.R) {","+\t\treq = structs.ServiceSpecificRequest{","+\t\t\tDatacenter:   \"dc1\",","+\t\t\tServiceName:  \"db\",","+\t\t\tAPIGateway:   true,","+\t\t\tQueryOptions: structs.QueryOptions{Token: token.SecretID},","+\t\t}","+\t\tvar allowed structs.IndexedCheckServiceNodes","+\t\trequire.NoError(r, msgpackrpc.CallWithCodec(codec, \"Health.ServiceNodes\", &req, &allowed))","+\t\trequire.Len(r, allowed.Nodes, 1)","+\t\trequire.Equal(r, \"foo\", allowed.Nodes[0].Node.Node)","+\t})","+}","+"," func TestHealth_NodeChecks_FilterACL(t *testing.T) {"," \tif testing.Short() {"," \t\tt.Skip(\"too slow for testing.Short\")"],"additions":225,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog.go","lines":["@@ -2924,6 +2924,44 @@ func (s *Store) CheckIngressServiceNodes(ws memdb.WatchSet, serviceName string,"," \treturn maxIdx, results, nil"," }"," ","+// CheckAPIGatewayServiceNodes returns the health check nodes for the API gateways","+// that front the given service. It mirrors CheckIngressServiceNodes but filters on","+// the API gateway service kind, powering DNS resolution for services exposed via","+// an API gateway.","+func (s *Store) CheckAPIGatewayServiceNodes(ws memdb.WatchSet, serviceName string, entMeta *acl.EnterpriseMeta) (uint64, structs.CheckServiceNodes, error) {","+\ttx := s.db.Txn(false)","+\tdefer tx.Abort()","+","+\tmaxIdx, nodes, err := serviceGatewayNodes(tx, ws, serviceName, structs.ServiceKindAPIGateway, entMeta, structs.DefaultPeerKeyword)","+\tif err != nil {","+\t\treturn 0, nil, fmt.Errorf(\"failed gateway nodes lookup: %v\", err)","+\t}","+","+\t// Watch for index changes to the gateway nodes","+\tidx, chans := maxIndexAndWatchChsForServiceNodes(tx, nodes, false)","+\tfor _, ch := range chans {","+\t\tws.Add(ch)","+\t}","+\tmaxIdx = lib.MaxUint64(maxIdx, idx)","+","+\t// De-dup services to lookup","+\tnames := make(map[structs.ServiceName]struct{})","+\tfor _, n := range nodes {","+\t\tnames[n.CompoundServiceName().ServiceName] = struct{}{}","+\t}","+","+\tvar results structs.CheckServiceNodes","+\tfor sn := range names {","+\t\tidx, n, err := checkServiceNodesTxn(tx, ws, sn.Name, false, &sn.EnterpriseMeta, structs.DefaultPeerKeyword)","+\t\tif err != nil {","+\t\t\treturn 0, nil, err","+\t\t}","+\t\tmaxIdx = lib.MaxUint64(maxIdx, idx)","+\t\tresults = append(results, n...)","+\t}","+\treturn maxIdx, results, nil","+}","+"," func (s *Store) checkServiceNodes(ws memdb.WatchSet, serviceName string, connect bool, entMeta *acl.EnterpriseMeta, peerName string) (uint64, structs.CheckServiceNodes, error) {"," \ttx := s.db.Txn(false)"," \tdefer tx.Abort()","@@ -3612,6 +3650,8 @@ func updateGatewayServices(tx WriteTxn, idx uint64, conf structs.ConfigEntry, en"," \t\tnoChange, gatewayServices, err = ingressConfigGatewayServices(tx, gateway, conf, entMeta)"," \tcase structs.TerminatingGateway:"," \t\tnoChange, gatewayServices, err = terminatingConfigGatewayServices(tx, gateway, conf, entMeta)","+\tcase structs.BoundAPIGateway:","+\t\tnoChange, gatewayServices, err = apiGatewayConfigGatewayServices(tx, gateway, conf, entMeta)"," \tdefault:"," \t\treturn fmt.Errorf(\"config entry kind %q does not need gateway-services\", conf.GetKind())"," \t}","@@ -3810,6 +3850,194 @@ func ingressConfigGatewayServices("," \treturn false, gatewayServices, nil"," }"," ","+// apiGatewayConfigGatewayServices constructs a list of GatewayService structs","+// for insertion into the memdb table, specific to API gateways. It is only","+// called on writes to the bound-api-gateway config entry, which the controller","+// materializes after reconciling routes. BoundAPIGatewayListener already carries","+// Port/Protocol/Hostname (copied from the api-gateway listener at reconcile","+// time), so no separate api-gateway entry lookup is needed. The boolean return","+// indicates that there are no changes necessary to the memdb table.","+func apiGatewayConfigGatewayServices(","+\ttx ReadTxn,","+\tgateway structs.ServiceName,","+\tconf structs.ConfigEntry,","+\tentMeta *acl.EnterpriseMeta,","+) (bool, structs.GatewayServices, error) {","+\tboundConf, ok := conf.(*structs.BoundAPIGatewayConfigEntry)","+\tif !ok {","+\t\treturn false, nil, fmt.Errorf(\"unexpected config entry type: %T\", conf)","+\t}","+","+\t// Build the desired set of gateway-service mappings. If the bound entry is","+\t// missing (no routes have bound yet) we fall through with an empty set,","+\t// which truncates any stale mappings.","+\tvar gatewayServices structs.GatewayServices","+\tif boundConf != nil {","+\t\t// De-duplicate by (service, port) since a service may be targeted by","+\t\t// multiple routes or bound on multiple listeners. We merge the hosts.","+\t\ttype svcKey struct {","+\t\t\tname structs.ServiceName","+\t\t\tport int","+\t\t}","+\t\tseen := make(map[svcKey]*structs.GatewayService)","+","+\t\tfor _, boundListener := range boundConf.Listeners {","+\t\t\t// BoundAPIGatewayListener carries Port/Protocol/Hostname copied","+\t\t\t// from the api-gateway listener by the controller at reconcile time.","+\t\t\tprotocol := string(boundListener.Protocol)","+","+\t\t\t// Listener-level hostname (if any) acts as the default host for","+\t\t\t// routed services when the route declares no hostnames.","+\t\t\tvar listenerHosts []string","+\t\t\tif boundListener.Hostname != \"\" {","+\t\t\t\tlistenerHosts = []string{boundListener.Hostname}","+\t\t\t}","+","+\t\t\tfor _, routeRef := range boundListener.Routes {","+\t\t\t\tservices, routeHosts, err := apiGatewayRouteServices(tx, routeRef, entMeta)","+\t\t\t\tif err != nil {","+\t\t\t\t\treturn false, nil, err","+\t\t\t\t}","+","+\t\t\t\thosts := routeHosts","+\t\t\t\tif len(hosts) == 0 {","+\t\t\t\t\thosts = listenerHosts","+\t\t\t\t}","+","+\t\t\t\tfor _, svc := range services {","+\t\t\t\t\tkey := svcKey{name: svc, port: boundListener.Port}","+\t\t\t\t\tif existing, ok := seen[key]; ok {","+\t\t\t\t\t\texisting.Hosts = mergeStringSlices(existing.Hosts, hosts)","+\t\t\t\t\t\tcontinue","+\t\t\t\t\t}","+\t\t\t\t\tmapping := &structs.GatewayService{","+\t\t\t\t\t\tGateway:     gateway,","+\t\t\t\t\t\tService:     svc,","+\t\t\t\t\t\tGatewayKind: structs.ServiceKindAPIGateway,","+\t\t\t\t\t\tPort:        boundListener.Port,","+\t\t\t\t\t\tProtocol:    protocol,","+\t\t\t\t\t\tHosts:       append([]string(nil), hosts...),","+\t\t\t\t\t}","+\t\t\t\t\tseen[key] = mapping","+\t\t\t\t\tgatewayServices = append(gatewayServices, mapping)","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+","+\t// Skip the update if the freshly computed mappings are identical to what's","+\t// already stored, to avoid needless index churn and watch fan-out.","+\texisting, err := gatewayServicesForGateway(tx, gateway)","+\tif err != nil {","+\t\treturn false, nil, err","+\t}","+\tif gatewayServicesEqual(existing, gatewayServices) {","+\t\treturn true, nil, nil","+\t}","+","+\treturn false, gatewayServices, nil","+}","+","+// apiGatewayRouteServices reads a bound route reference (http-route or tcp-route)","+// and returns the set of target services along with any custom hostnames declared","+// on the route (http-routes only).","+func apiGatewayRouteServices(","+\ttx ReadTxn,","+\trouteRef structs.ResourceReference,","+\tentMeta *acl.EnterpriseMeta,","+) ([]structs.ServiceName, []string, error) {","+\trouteEntMeta := routeRef.EnterpriseMeta","+\tif entMeta != nil && routeEntMeta.PartitionOrEmpty() == \"\" && routeEntMeta.NamespaceOrEmpty() == \"\" {","+\t\trouteEntMeta = *entMeta","+\t}","+","+\t_, c, err := configEntryTxn(tx, nil, routeRef.Kind, routeRef.Name, &routeEntMeta)","+\tif err != nil {","+\t\treturn nil, nil, fmt.Errorf(\"failed to get %s %q: %v\", routeRef.Kind, routeRef.Name, err)","+\t}","+\tif c == nil {","+\t\treturn nil, nil, nil","+\t}","+","+\tvar services []structs.ServiceName","+\tvar hosts []string","+","+\tswitch route := c.(type) {","+\tcase *structs.HTTPRouteConfigEntry:","+\t\thosts = route.Hostnames","+\t\tfor _, svc := range route.GetServices() {","+\t\t\tservices = append(services, svc.ServiceName())","+\t\t}","+\tcase *structs.TCPRouteConfigEntry:","+\t\tfor _, svc := range route.GetServices() {","+\t\t\tservices = append(services, svc.ServiceName())","+\t\t}","+\tdefault:","+\t\t// Unknown/unsupported route kind; nothing to map.","+\t\treturn nil, nil, nil","+\t}","+","+\treturn services, hosts, nil","+}","+","+// gatewayServicesForGateway returns the gateway-service mappings currently stored","+// for the given gateway.","+func gatewayServicesForGateway(tx ReadTxn, gateway structs.ServiceName) (structs.GatewayServices, error) {","+\titer, err := tx.Get(tableGatewayServices, indexGateway, gateway)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed gateway services lookup: %v\", err)","+\t}","+\tvar out structs.GatewayServices","+\tfor obj := iter.Next(); obj != nil; obj = iter.Next() {","+\t\tout = append(out, obj.(*structs.GatewayService))","+\t}","+\treturn out, nil","+}","+","+// gatewayServicesEqual reports whether two sets of gateway-service mappings are","+// equivalent, ignoring ordering.","+func gatewayServicesEqual(a, b structs.GatewayServices) bool {","+\tif len(a) != len(b) {","+\t\treturn false","+\t}","+\tmatched := make([]bool, len(b))","+\tfor _, ga := range a {","+\t\tfound := false","+\t\tfor i, gb := range b {","+\t\t\tif matched[i] {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif ga.IsSame(gb) {","+\t\t\t\tmatched[i] = true","+\t\t\t\tfound = true","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t\tif !found {","+\t\t\treturn false","+\t\t}","+\t}","+\treturn true","+}","+","+// mergeStringSlices appends entries from extra into base that are not already","+// present, preserving order.","+func mergeStringSlices(base, extra []string) []string {","+\tfor _, s := range extra {","+\t\texists := false","+\t\tfor _, b := range base {","+\t\t\tif b == s {","+\t\t\t\texists = true","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t\tif !exists {","+\t\t\tbase = append(base, s)","+\t\t}","+\t}","+\treturn base","+}","+"," // terminatingConfigGatewayServices constructs a list of GatewayService structs"," // for insertion into the memdb table, specific to terminating gateways. The"," // boolean returned indicates that there are no changes necessary to the memdb"],"additions":228,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog_apigateway_test.go","lines":["@@ -0,0 +1,200 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package state","+","+import (","+\t\"testing\"","+","+\tmemdb \"github.com/hashicorp/go-memdb\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/hashicorp/consul/agent/structs\"","+)","+","+// TestStateStore_GatewayServices_APIGateway verifies that writing a","+// bound-api-gateway config entry materializes gateway<->service mappings in the","+// gateway-services table (mirroring ingress gateways), which powers DNS","+// auto-registration of services exposed via an API gateway.","+func TestStateStore_GatewayServices_APIGateway(t *testing.T) {","+\ts := testStateStore(t)","+\tws := memdb.NewWatchSet()","+","+\t// Register a node and an api-gateway service instance plus backend services.","+\ttestRegisterNode(t, s, 0, \"node1\")","+\ttestRegisterAPIService(t, s, 1, \"node1\", \"api-gw\")","+\ttestRegisterConnectService(t, s, 2, \"node1\", \"web\")","+\ttestRegisterConnectService(t, s, 3, \"node1\", \"admin\")","+","+\t// Default protocol to http so http-routes are valid.","+\tproxyDefaults := &structs.ProxyConfigEntry{","+\t\tName: structs.ProxyConfigGlobal,","+\t\tKind: structs.ProxyDefaults,","+\t\tConfig: map[string]interface{}{","+\t\t\t\"protocol\": \"http\",","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(4, proxyDefaults))","+","+\t// The api-gateway config entry on its own does not produce any mappings","+\t// because services are only known once routes bind.","+\tapigw := &structs.APIGatewayConfigEntry{","+\t\tKind: structs.APIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.APIGatewayListener{","+\t\t\t{","+\t\t\t\tName:     \"http-listener\",","+\t\t\t\tPort:     8443,","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t},","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(5, apigw))","+","+\t_, res, err := s.GatewayServices(ws, \"api-gw\", nil)","+\trequire.NoError(t, err)","+\trequire.Empty(t, res, \"no mappings expected before any route binds\")","+","+\t// Register an http-route targeting \"web\" with a custom hostname.","+\troute := &structs.HTTPRouteConfigEntry{","+\t\tKind:      structs.HTTPRoute,","+\t\tName:      \"web-route\",","+\t\tParents:   []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\tHostnames: []string{\"web.example.com\"},","+\t\tRules: []structs.HTTPRouteRule{","+\t\t\t{Services: []structs.HTTPService{{Name: \"web\"}}},","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(6, route))","+","+\t// The bound-api-gateway is what the controller materializes and is what","+\t// drives the gateway<->service mapping.","+\tbound := &structs.BoundAPIGatewayConfigEntry{","+\t\tKind: structs.BoundAPIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.BoundAPIGatewayListener{","+\t\t\t{","+\t\t\t\tName:     \"http-listener\",","+\t\t\t\tPort:     8443,","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tRoutes:   []structs.ResourceReference{{Kind: structs.HTTPRoute, Name: \"web-route\"}},","+\t\t\t},","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(7, bound))","+","+\t// Now the mapping should exist with the listener port and route hostname.","+\t_, res, err = s.GatewayServices(ws, \"api-gw\", nil)","+\trequire.NoError(t, err)","+\trequire.Len(t, res, 1)","+\trequire.Equal(t, \"web\", res[0].Service.Name)","+\trequire.Equal(t, structs.ServiceKindAPIGateway, res[0].GatewayKind)","+\trequire.Equal(t, 8443, res[0].Port)","+\trequire.Equal(t, []string{\"web.example.com\"}, res[0].Hosts)","+","+\t// DNS resolution: looking up the backend service should return the gateway node.","+\t_, nodes, err := s.CheckAPIGatewayServiceNodes(memdb.NewWatchSet(), \"web\", nil)","+\trequire.NoError(t, err)","+\trequire.Len(t, nodes, 1)","+\trequire.Equal(t, \"api-gw\", nodes[0].Service.Service)","+","+\t// A service not behind the gateway resolves to nothing.","+\t_, nodes, err = s.CheckAPIGatewayServiceNodes(memdb.NewWatchSet(), \"admin\", nil)","+\trequire.NoError(t, err)","+\trequire.Empty(t, nodes)","+","+\t// Deleting the bound-api-gateway clears the mappings.","+\trequire.NoError(t, s.DeleteConfigEntry(8, structs.BoundAPIGateway, \"api-gw\", nil))","+\t_, res, err = s.GatewayServices(ws, \"api-gw\", nil)","+\trequire.NoError(t, err)","+\trequire.Empty(t, res, \"mappings should be cleared after bound gateway deletion\")","+","+\t_, nodes, err = s.CheckAPIGatewayServiceNodes(memdb.NewWatchSet(), \"web\", nil)","+\trequire.NoError(t, err)","+\trequire.Empty(t, nodes)","+}","+","+// TestStateStore_GatewayServices_APIGateway_MultiRoute verifies that both","+// http-route and tcp-route bound services are mapped, each picking up the","+// correct listener port and protocol.","+func TestStateStore_GatewayServices_APIGateway_MultiRoute(t *testing.T) {","+\ts := testStateStore(t)","+\tws := memdb.NewWatchSet()","+","+\ttestRegisterNode(t, s, 0, \"node1\")","+\ttestRegisterAPIService(t, s, 1, \"node1\", \"api-gw\")","+\ttestRegisterConnectService(t, s, 2, \"node1\", \"web\")","+\ttestRegisterService(t, s, 3, \"node1\", \"tcp-backend\")","+","+\tproxyDefaults := &structs.ProxyConfigEntry{","+\t\tName: structs.ProxyConfigGlobal,","+\t\tKind: structs.ProxyDefaults,","+\t\tConfig: map[string]interface{}{","+\t\t\t\"protocol\": \"http\",","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(4, proxyDefaults))","+","+\tapigw := &structs.APIGatewayConfigEntry{","+\t\tKind: structs.APIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.APIGatewayListener{","+\t\t\t{Name: \"http-listener\", Port: 8443, Protocol: structs.ListenerProtocolHTTP},","+\t\t\t{Name: \"tcp-listener\", Port: 9000, Protocol: structs.ListenerProtocolTCP},","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(5, apigw))","+","+\thttpRoute := &structs.HTTPRouteConfigEntry{","+\t\tKind:    structs.HTTPRoute,","+\t\tName:    \"web-route\",","+\t\tParents: []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\tRules: []structs.HTTPRouteRule{","+\t\t\t{Services: []structs.HTTPService{{Name: \"web\"}}},","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(6, httpRoute))","+","+\ttcpRoute := &structs.TCPRouteConfigEntry{","+\t\tKind:     structs.TCPRoute,","+\t\tName:     \"tcp-route\",","+\t\tParents:  []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\tServices: []structs.TCPService{{Name: \"tcp-backend\"}},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(7, tcpRoute))","+","+\tbound := &structs.BoundAPIGatewayConfigEntry{","+\t\tKind: structs.BoundAPIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.BoundAPIGatewayListener{","+\t\t\t{","+\t\t\t\tName:     \"http-listener\",","+\t\t\t\tPort:     8443,","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tRoutes:   []structs.ResourceReference{{Kind: structs.HTTPRoute, Name: \"web-route\"}},","+\t\t\t},","+\t\t\t{","+\t\t\t\tName:     \"tcp-listener\",","+\t\t\t\tPort:     9000,","+\t\t\t\tProtocol: structs.ListenerProtocolTCP,","+\t\t\t\tRoutes:   []structs.ResourceReference{{Kind: structs.TCPRoute, Name: \"tcp-route\"}},","+\t\t\t},","+\t\t},","+\t}","+\trequire.NoError(t, s.EnsureConfigEntry(8, bound))","+","+\t_, res, err := s.GatewayServices(ws, \"api-gw\", nil)","+\trequire.NoError(t, err)","+\trequire.Len(t, res, 2)","+","+\tbyService := make(map[string]*structs.GatewayService)","+\tfor _, gs := range res {","+\t\tbyService[gs.Service.Name] = gs","+\t}","+\trequire.Contains(t, byService, \"web\")","+\trequire.Contains(t, byService, \"tcp-backend\")","+\trequire.Equal(t, 8443, byService[\"web\"].Port)","+\trequire.Equal(t, \"http\", byService[\"web\"].Protocol)","+\trequire.Equal(t, 9000, byService[\"tcp-backend\"].Port)","+\trequire.Equal(t, \"tcp\", byService[\"tcp-backend\"].Protocol)","+}"],"additions":200,"deletions":0,"truncated":false},{"path":"agent/consul/state/config_entry.go","lines":["@@ -410,11 +410,14 @@ func deleteConfigEntryTxn(tx WriteTxn, idx uint64, kind, name string, entMeta *a"," \t\treturn nil"," \t}"," ","-\t// If the config entry is for terminating or ingress gateways we delete entries from the memdb table","-\t// that associates gateways <-> services.","+\t// If the config entry is for terminating, ingress, or API gateways we delete","+\t// entries from the memdb table that associates gateways <-> services. For API","+\t// gateways, deleting either the api-gateway or the bound-api-gateway should","+\t// clear the rows (the gateway is gone, so no mappings should remain)."," \tsn := structs.NewServiceName(name, entMeta)"," ","-\tif kind == structs.TerminatingGateway || kind == structs.IngressGateway {","+\tif kind == structs.TerminatingGateway || kind == structs.IngressGateway ||","+\t\tkind == structs.APIGateway || kind == structs.BoundAPIGateway {"," \t\tif _, err := tx.DeleteAll(tableGatewayServices, indexGateway, sn); err != nil {"," \t\t\treturn fmt.Errorf(\"failed to truncate gateway services table: %v\", err)"," \t\t}","@@ -489,10 +492,18 @@ func insertConfigEntryWithTxn(tx WriteTxn, idx uint64, conf structs.ConfigEntry)"," \t\treturn fmt.Errorf(\"cannot insert nil config entry\")"," \t}"," ","-\t// If the config entry is for a terminating or ingress gateway we update the memdb table","-\t// that associates gateways <-> services.","+\t// If the config entry is for a terminating, ingress, or API gateway we update","+\t// the memdb table that associates gateways <-> services.","+\t//","+\t// For API gateways the service list is resolved from the routes that bind to","+\t// the gateway and is materialized in the bound-api-gateway config entry. The","+\t// controller copies Port/Protocol/Hostname into BoundAPIGatewayListener at","+\t// reconcile time, so the bound-api-gateway write is the only trigger needed.","+\t// Triggering on the api-gateway write too would produce stale rows (old bound","+\t// listener fields) between the operator's config change and the next reconcile."],"additions":15,"deletions":5,"truncated":false}],"additions":698,"deletions":10,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-09-05T11:49:59.178959+00:00"}