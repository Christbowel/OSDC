ls.get(\"responseMetadata\").get(\"spools\");","+    Assert.assertTrue(hasOutcome(spools, \"APPLIED\"), spools.toString());","+    Assert.assertFalse(hasOutcome(spools, \"REJECTED_BY_GUARD\"), spools.toString());","+","+    JsonNode withoutSpools = postQuery(\"SET useSpools = 'off';\\n\" + query);","+    assertNoError(withoutSpools);","+    Assert.assertEquals(withSpools.get(\"resultTable\").get(\"rows\"), withoutSpools.get(\"resultTable\").get(\"rows\"));","+  }","+","+  private static boolean hasOutcome(JsonNode spools, String outcome) {","+    for (JsonNode substitution : spools.get(\"substitutions\")) {","+      if (substitution.get(\"outcome\").asText().equals(outcome)) {","+        return true;","+      }","+    }","+    return false;","+  }","+","   /// Test a complex with nested spools.","   ///","   /// Don't try to understand the query, just check that the spools are correct."],"additions":74,"deletions":0,"truncated":false},{"path":"pinot-query-planner/src/main/java/org/apache/pinot/query/QueryEnvironment.java","lines":["@@ -84,6 +84,7 @@"," import org.apache.pinot.query.planner.explain.PhysicalExplainPlanVisitor;"," import org.apache.pinot.query.planner.logical.PinotLogicalQueryPlanner;"," import org.apache.pinot.query.planner.logical.RelToPlanNodeConverter;","+import org.apache.pinot.query.planner.logical.SpoolMode;"," import org.apache.pinot.query.planner.logical.TransformationTracker;"," import org.apache.pinot.query.planner.physical.DispatchableSubPlan;"," import org.apache.pinot.query.planner.physical.PinotDispatchPlanner;","@@ -578,8 +579,9 @@ private DispatchableSubPlan toDispatchableSubPlan(RelRoot relRoot, PlannerContex","           _envConfig.getWorkerManager(), requestId, _envConfig.getTableCache());","       return pinotDispatchPlanner.createDispatchableSubPlanV2(plan.getLeft(), plan.getRight());","     }","-    SubPlan plan = PinotLogicalQueryPlanner.makePlan(relRoot, tracker, useSpools(plannerContext.getOptions()),","-        _envConfig.def