{"id":"fe55362b187b1839da022a4939779940d1671e6f","axis":"silent","repo":"mongodb/mongo","sha":"fe55362b187b1839da022a4939779940d1671e6f","parsed":{"files":[{"path":"buildscripts/resmokeconfig/matrix_suites/generated_suites/sharding_auth_audit.yml","lines":["@@ -32,6 +32,7 @@ selector:","     - jstests/sharding/*[aA]uth*.js","     - jstests/sharding/analyze_shard_key/*[aA]uth*.js","     - jstests/sharding/query/**/*[aA]uth*.js","+    - jstests/sharding/migration_blocking_operation/multi_update_coordinator_state_document_privilege_escalation.js","     - jstests/sharding/advance_cluster_time_action_type.js","     - jstests/sharding/query/agg/agg_currentop.js","     - jstests/sharding/internal_txns/internal_client_restrictions.js"],"additions":1,"deletions":0,"truncated":false},{"path":"buildscripts/resmokeconfig/suites/sharding_auth.yml","lines":["@@ -14,6 +14,7 @@ selector:","     - jstests/sharding/*[aA]uth*.js","     - jstests/sharding/analyze_shard_key/*[aA]uth*.js","     - jstests/sharding/query/**/*[aA]uth*.js","+    - jstests/sharding/migration_blocking_operation/multi_update_coordinator_state_document_privilege_escalation.js"," ","     - jstests/sharding/advance_cluster_time_action_type.js","     - jstests/sharding/query/agg/agg_currentop.js"],"additions":1,"deletions":0,"truncated":false},{"path":"etc/backports_required_for_multiversion_tests.yml","lines":["@@ -119,6 +119,8 @@ last-patch:","       ticket: SERVER-134519","     - test_file: jstests/sharding/index_builds/resharding_recipient_buildindex_stepup_deadlock.js","       ticket: SERVER-127745","+    - test_file: jstests/sharding/migration_blocking_operation/multi_update_coordinator_state_document_privilege_escalation.js","+      ticket: SERVER-133600","     - test_file: jstests/sharding/migration_coordinator_basic.js","       ticket: SERVER-136722","     - test_file: jstests/sharding/migration_coordinator_basic.js","@@ -282,6 +284,8 @@ last-continuous:","       ticket: SERVER-127745","     - test_file: jstests/sharding/index_commands_shard_targeting.js","       ticket: SERVER-131386","+    - test_file: jstests/sharding/migration_blocking_operation/multi_update_coordinator_state_document_privilege_escalation.js","+      ticket: SERVER-133600","     - test_file: jstests/sharding/migration_coordinator_basic.js","       ticket: SERVER-136722","     - test_file: jstests/sharding/migration_coordinator_basic.js","@@ -499,6 +503,8 @@ last-lts:","       ticket: SERVER-127745","     - test_file: jstests/sharding/index_commands_shard_targeting.js","       ticket: SERVER-131386","+    - test_file: jstests/sharding/migration_blocking_operation/multi_update_coordinator_state_document_privilege_escalation.js","+      ticket: SERVER-133600","     - test_file: jstests/sharding/migration_coordinator_basic.js","       ticket: SERVER-136722","     - test_file: jstests/sharding/migration_coordinator_basic.js"],"additions":6,"deletions":0,"truncated":false},{"path":"jstests/auth/lib/collection_actions.js","lines":["@@ -0,0 +1,369 @@","+/**","+ * Enumerates the commands that reach a single namespace, each tagged with the ActionTypes the","+ * server requires on that namespace to run it.","+ *","+ * A namespace is not protected by locking down the obvious command that names it: 'find' is also","+ * reachable through '$lookup', an insert is also reachable through 'applyOps' and '$out', and a","+ * definition change is also reachable through 'collMod' or a view. A test that asserts an","+ * authorization rule on a namespace has to cover every one of those paths, and the paths are the","+ * same for every namespace, so they are enumerated here once.","+ *","+ * Entries have the form:","+ *","+ *   {name, actionTypes, db, command, shardOnly}","+ *","+ * 'actionTypes' is the set of actions the command requires *on the namespace under test*, taken","+ * from the server's own authorization checks. It is a set, not a single action: 'update' with","+ * 'upsert: true' requires {update, insert}, '$out' requires {insert, remove}, and a command that","+ * names two namespaces (rename, cloneCollectionAsCapped) requires a different set on each side, so","+ * only the side that touches the namespace under test is listed. Note also that some commands","+ * require actions on a *second* namespace that are not listed here — creating a view over the","+ * namespace needs 'createCollection' on the new view, but only read access on the namespace itself.","+ *","+ * 'db' is the database the command must be run against, which is not necessarily the database","+ * holding the namespace ('bulkWrite', 'applyOps' and 'renameCollection' run against 'admin').","+ * 'shardOnly' marks commands that do not exist on a router.","+ *","+ * Entries carry commands only; the caller decides what to assert about running them, since a","+ * command that is denied on one namespace may be expected to succeed, or to fail with a different","+ * code, on another.","+ *","+ * Example:","+ *","+ *   import {CollectionActions} from \"jstests/auth/lib/collection_actions.js\";","+ *","+ *   const spec = {db: \"config\", coll: \"myStateDocuments\", document: doc, id: doc._id};","+ *   for (const {name, db, command} of CollectionActions.all(spec)) {","+ *       assert.commandFailedWithCode(conn.getDB(db).runCommand(command), ErrorCodes.Unauthorized);","+ *   }","+ */","+","+// Names of the helper namespaces that the rename and clone paths need as their other side, and the","+// view they define. These are arbitrary; a caller only needs to override them if it also uses a","+// collection by that name.","+const kDefaults = {","+    db: \"config\",","+    scratchCollection: \"collectionActionsScratch\",","+    viewName: \"collectionActionsView\",","+    validator: {_id: {$exists: true}},","+};","+","+function resolve(spec) {","+    const resolved = Object.assign({}, kDefaults, spec);","+    assert(resolved.coll, \"CollectionActions requires a 'coll'\", {spec});","+    assert(resolved.document, \"CollectionActions requires a 'document' to write\", {spec});","+    assert(resolved.id !== undefined, \"CollectionActions requires an 'id' to filter on\", {spec});","+    resolved.qualifiedNs = `${resolved.db}.${resolved.coll}`;","+    resolved.qualifiedScratchNs = `${resolved.db}.${resolved.scratchCollection}`;","+    return resolved;","+}","+","+/**","+ * Every command that reaches the namespace, in one flat list. The action-type accessors on","+ * 'CollectionActions' are filters over this.","+ */","+function accessPaths(spec) {","+    const {","+        db,","+        coll,","+        qualifiedNs,","+        qualifiedScratchNs,","+        scratchCollection,","+        viewName,","+        validator,","+        document,","+        id,","+    } = resolve(spec);","+","+    return [","+        // Reads. Each of these returns the contents of the namespace, either as the command's own","+        // target or as a secondary namespace of a pipeline.","+        {name: \"find\", actionTypes: [\"find\"], db, command: {find: coll, filter: {}}},","+        {name: \"count\", actionTypes: [\"find\"], db, command: {count: coll, query: {}}},","+        {name: \"distinct\", actionTypes: [\"find\"], db, command: {distinct: coll, key: \"_id\"}},","+        {","+            name: \"aggregate with an empty pipeline\",","+            actionTypes: [\"find\"],","+            db,","+            command: {aggregate: coll, pipeline: [], cursor: {}},","+        },","+        {","+            name: \"aggregate with a pipeline\",","+            actionTypes: [\"find\"],","+            db,","+            command: {aggregate: coll, pipeline: [{$match: {}}, {$project: {_id: 1}}], cursor: {}},","+        },","+        {","+            name: \"aggregate naming the namespace via $unionWith\",","+            actionTypes: [\"find\"],","+            db,","+            command: {","+                aggregate: 1,","+                pipeline: [{$documents: [{}]}, {$unionWith: {coll: coll, pipeline: []}}],","+                cursor: {},","+            },","+        },","+        {","+            name: \"aggregate naming the namespace via $lookup\",","+            actionTypes: [\"find\"],","+            db,","+            command: {","+                aggregate: 1,","+                pipeline: [","+                    {$documents: [{}]},","+                    {$lookup: {from: coll, localField: \"_id\", foreignField: \"_id\", as: \"joined\"}},","+                ],","+                cursor: {},","+            },","+        },","+        {","+            name: \"aggregate naming the namespace via $graphLookup\",","+            actionTypes: [\"find\"],","+            db,","+            command: {","+                aggregate: 1,","+                pipeline: [","+                    {$documents: [{_id: 1}]},","+                    {","+                        $graphLookup: {","+                            from: coll,","+                            startWith: \"$_id\",","+                            connectFromField: \"_id\",","+                            connectToField: \"_id\",","+                            as: \"reached\",","+                        },","+                    },","+                ],","+                cursor: {},","+            },","+        },","+        {","+            name: \"mapReduce\",","+            actionTypes: [\"find\"],","+            db,","+            command: {","+                mapReduce: coll,","+                map: function () {","+                    emit(this._id, 1);","+                },","+                reduce: function (k, v) {","+                    return 1;","+                },","+                out: {inline: 1},","+            },","+        },","+        {","+            // Only read access on the namespace is required here; 'createCollection' is required on","+            // the view being defined, which is a different namespace. A view would let a later find","+            // read the namespace indirectly.","+            name: \"create view over the namespace\",","+            actionTypes: [\"find\"],","+            db,","+            command: {create: viewName, viewOn: coll, pipeline: []},","+        },","+","+        // Inserts.","+        {","+            name: \"insert\",","+            actionTypes: [\"insert\"],","+            db,","+            command: {insert: coll, documents: [document]},","+        },","+        {","+            name: \"bulkWrite insert\",","+            actionTypes: [\"insert\"],","+            db: \"admin\",","+            command: {","+                bulkWrite: 1,","+                ops: [{insert: 0, document: document}],","+                nsInfo: [{ns: qualifiedNs}],","+            },","+        },","+        {","+            name: \"applyOps insert\",","+            actionTypes: [\"insert\"],","+            db: \"admin\",","+            shardOnly: true,","+            command: {applyOps: [{op: \"i\", ns: qualifiedNs, o: document}]},","+        },","+","+        // Updates. An upsert also requires 'insert', since it can create the document.","+        {","+            name: \"update with upsert\",","+            actionTypes: [\"update\", \"insert\"],","+            db,","+            command: {","+                update: coll,","+                updates: [{q: {_id: id}, u: document, multi: false, upsert: true}],","+            },","+        },","+        {","+            name: \"multi update\",","+            actionTypes: [\"update\"],","+            db,","+            command: {update: coll, updates: [{q: {}, u: {$set: {touched: true}}, multi: true}]},","+        },","+        {","+            // findAndModify always requires 'find', because it returns the document it acted on.","+            name: \"findAndModify with update\",","+            actionTypes: [\"find\", \"update\", \"insert\"],","+            db,","+            command: {findAndModify: coll, query: {_id: id}, update: document, upsert: true},","+        },","+        {","+            name: \"bulkWrite update\",","+            actionTypes: [\"update\", \"insert\"],","+            db: \"admin\",","+            command: {","+                bulkWrite: 1,","+                ops: [{update: 0, filter: {_id: id}, updateMods: document, upsert: true}],","+                nsInfo: [{ns: qualifiedNs}],","+            },","+        },","+        {","+            name: \"applyOps update\",","+            actionTypes: [\"update\"],","+            db: \"admin\",","+            shardOnly: true,","+            command: {applyOps: [{op: \"u\", ns: qualifiedNs, o: document, o2: {_id: id}}]},","+        },","+","+        // Removes.","+        {","+            name: \"delete of all documents\",","+            actionTypes: [\"remove\"],","+            db,","+            command: {delete: coll, deletes: [{q: {}, limit: 0}]},","+        },","+        {","+            name: \"delete of a single document\",","+            actionTypes: [\"remove\"],","+            db,","+            command: {delete: coll, deletes: [{q: {_id: id}, limit: 1}]},","+        },","+        {","+            name: \"findAndModify with remove\",","+            actionTypes: [\"find\", \"remove\"],","+            db,","+            command: {findAndModify: coll, query: {_id: id}, remove: true},","+        },","+        {","+            name: \"bulkWrite delete\",","+            actionTypes: [\"remove\"],","+            db: \"admin\",","+            command: {","+                bulkWrite: 1,","+                ops: [{delete: 0, filter: {_id: id}, multi: false}],","+                nsInfo: [{ns: qualifiedNs}],","+            },","+        },","+        {","+            name: \"applyOps delete\",","+            actionTypes: [\"remove\"],","+            db: \"admin\",","+            shardOnly: true,","+            command: {applyOps: [{op: \"d\", ns: qualifiedNs, o: {_id: id}}]},","+        },","+","+        // Output stages. $out replaces the whole collection, so it holds 'remove' as well as","+        // 'insert'; $merge's actions depend on its mode pair, and 'replace'/'insert' is the mode","+        // that holds both write actions.","+        {","+            name: \"aggregate writing via $out\",","+            actionTypes: [\"insert\", \"remove\"],","+            db,","+            command: {aggregate: 1, pipeline: [{$documents: [document]}, {$out: coll}], cursor: {}},","+        },","+        {","+            name: \"aggregate writing via $merge\",","+            actionTypes: [\"insert\", \"update\"],","+            db,","+            command: {","+                aggregate: 1,","+                pipeline: [","+                    {$documents: [document]},","+                    {$merge: {into: coll, whenMatched: \"replace\", whenNotMatched: \"insert\"}},","+                ],","+                cursor: {},","+            },","+        },","+","+        // Definition changes. collMod can attach a validator that silently rewrites what a later","+        // legitimate write to the namespace is allowed to store, and on a view it redefines what","+        // the view reads.","+        {","+            name: \"collMod\",","+            actionTypes: [\"collMod\"],","+            db,","+            command: {collMod: coll, validator: validator},","+        },","+        {","+            name: \"drop\",","+            actionTypes: [\"dropCollection\"],","+            db,","+            command: {drop: coll},","+        },","+        {","+            // Capping the namespace in place is a definition change like collMod: a later","+            // legitimate write to it can then be silently dropped to keep the collection in size.","+            name: \"convertToCapped\",","+            actionTypes: [\"convertToCapped\"],","+            db,","+            command: {convertToCapped: coll, size: 100000},","+        },","+        {","+            name: \"cloneCollectionAsCapped reading the namespace\",","+            actionTypes: [\"find\"],","+            db,","+            shardOnly: true,","+            command: {cloneCollectionAsCapped: coll, toCollection: scratchCollection, size: 100000},","+        },","+        {","+            name: \"cloneCollectionAsCapped writing the namespace\",","+            actionTypes: [\"insert\", \"createIndex\", \"convertToCapped\"],","+            db,","+            shardOnly: true,","+            command: {cloneCollectionAsCapped: scratchCollection, toCollection: coll, size: 100000},","+        },","+","+        // Renaming moves the namespace's contents somewhere readable, or moves attacker-controlled","+        // contents into the namespace. 'renameCollectionSameDB' on the database is an alternative","+        // to the source-side actions below, so it is not listed as required on the namespace.","+        {","+            name: \"renameCollection away from the namespace\",","+            actionTypes: [\"find\", \"dropCollection\"],","+            db: \"admin\",","+            command: {renameCollection: qualifiedNs, to: qualifiedScratchNs, dropTarget: true},","+        },","+        {","+            name: \"renameCollection onto the namespace\",","+            actionTypes: [\"insert\", \"createIndex\", \"dropCollection\"],","+            db: \"admin\",","+            command: {renameCollection: qualifiedScratchNs, to: qualifiedNs, dropTarget: true},","+        },","+    ];","+}","+","+/**","+ * Only the paths requiring at least one of 'actionTypes' on the namespace. A path that requires","+ * several actions is returned for each of them: '$out' is both an 'insert' path and a 'remove' one.","+ */","+function forActionTypes(actionTypes, spec) {","+    return accessPaths(spec).filter((entry) =>","+        entry.actionTypes.some((action) => actionTypes.includes(action)),","+    );","+}","+","+export const CollectionActions = {","+    all: accessPaths,","+    forActionTypes,","+","+    find: (spec) => forActionTypes([\"find\"], spec),","+    insert: (spec) => forActionTypes([\"insert\"], spec),","+    update: (spec) => forActionTypes([\"update\"], spec),","+    remove: (spec) => forActionTypes([\"remove\"], spec),","+    collMod: (spec) => forActionTypes([\"collMod\"], spec),","+    convertToCapped: (spec) => forActionTypes([\"convertToCapped\"], spec),","+    createIndex: (spec) => forActionTypes([\"createIndex\"], spec),","+    dropCollection: (spec) => forActionTypes([\"dropCollection\"], spec),","+};"],"additions":369,"deletions":0,"truncated":false},{"path":"jstests/sharding/migration_blocking_operation/multi_update_coordinator_state_document_privilege_escalation.js","lines":["@@ -0,0 +1,427 @@","+/**","+ * No user lacking the implicit privilege on the pseudo namespace may reach the","+ * MultiUpdateCoordinator state document namespace, by any access path, however much privilege it","+ * holds on the namespace itself. Writing that namespace escalates privileges: on step-up,","+ * PrimaryOnlyService rebuilds the coordinator under internal authorization and runs the stored","+ * update through the cluster write path, so a forged document naming admin.system.users would","+ * replacement-upsert a root user that the writer is not otherwise authorized to create.","+ *","+ * @tags: [","+ *   # This test runs ShardingTest with a keyFile. The continuous stepdown thread's connection is","+ *   # not authenticated, so replSetGetConfig/reconfig against the config server fail with","+ *   # Unauthorized.","+ *   does_not_support_stepdowns,","+ * ]","+ */","+import {CollectionActions} from \"jstests/auth/lib/collection_actions.js\";","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {ShardingTest} from \"jstests/libs/shardingtest.js\";","+","+const keyFile = \"jstests/libs/key1\";","+","+const dbName = \"victimdb\";","+const collName = \"orders\";","+const namespace = `${dbName}.${collName}`;","+const stateDocumentsNs = \"localMigrationBlockingOperations.multiUpdateCoordinators\";","+const attackerPassword = \"alicepw\";","+const explicitAttackerPassword = \"carolpw\";","+const routerAttackerPassword = \"bobpw\";","+const backupPassword = \"backuppw\";","+const restorePassword = \"restorepw\";","+","+// The strongest form of the attack: a user holding every action the access paths below require","+// directly on the state document namespace, and nothing else. Without the implicit privilege on the","+// pseudo namespace, such a user would be able to take all of them.","+const stateDocumentActions = [","+    \"find\",","+    \"insert\",","+    \"update\",","+    \"remove\",","+    \"collMod\",","+    \"createIndex\",","+    \"dropCollection\",","+    \"convertToCapped\",","+];","+","+// The other namespaces the rename, clone and view access paths need as their other side. Granting","+// full access to them keeps every path failing because of the namespace under test rather than","+// because of the scratch namespace it also touches.","+function otherSidePrivileges() {","+    return [","+        {","+            resource: {db: \"config\", collection: \"collectionActionsScratch\"},","+            actions: stateDocumentActions,","+        },","+        {","+            resource: {db: \"config\", collection: \"collectionActionsView\"},","+            actions: stateDocumentActions.concat([\"createCollection\"]),","+        },","+    ];","+}","+","+// The SCRAM-SHA-256 credentials below correspond to the password \"pwnpass\".","+const forgedStateId = UUID(\"66666666-6666-4666-8666-666666666666\");","+const forgedUser = {","+    _id: \"admin.pwn\",","+    userId: UUID(\"55555555-5555-4555-8555-555555555555\"),","+    user: \"pwn\",","+    db: \"admin\",","+    credentials: {","+        \"SCRAM-SHA-256\": {","+            iterationCount: 15000,","+            salt: \"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGw==\",","+            storedKey: \"LY2mQQqUifrAs4Tdf+1Jza4eJ5KxjGQZwJL1LF5Vths=\",","+            serverKey: \"hVTOjDSFnu6iDCczdMrgFEouO3f1cRFFtxvDx3ufjZY=\",","+        },","+    },","+    roles: [{role: \"root\", db: \"admin\"}],","+    authenticationRestrictions: [],","+};","+","+const forgedStateDocument = {","+    _id: forgedStateId,","+    ns: \"admin.system.users\",","+    updateCommand: {","+        update: \"system.users\",","+        updates: [{q: {_id: \"admin.pwn\"}, u: forgedUser, multi: false, upsert: true}],","+        ordered: false,","+    },","+    isUpsert: true,","+    mutableFields: {phase: \"acquireSession\"},","+};","+","+// Every command that can reach the state document namespace, in either direction. Writing state","+// that the server will later replay with internal authority must be denied no matter which command","+// is used to write it; and the reads matter too, since the stored session id and pending command","+// are not the attacker's to see.","+const deniedCommands = CollectionActions.all({","+    db: \"config\",","+    coll: stateDocumentsNs,","+    document: forgedStateDocument,","+    id: forgedStateId,","+});","+","+describe(\"MultiUpdateCoordinator state document privilege escalation\", function () {","+    let st;","+    let attacker;","+    let forgedStateWasPersisted;","+","+    before(function () {","+        st = new ShardingTest({name: jsTestName(), keyFile: keyFile, shards: {rs0: {nodes: 2}}});","+","+        // The cluster administrator seeds data that the attacker must not be able to reach, and","+        // creates the shard-local user that the attacker controls. clusterManager is not special","+        // here; it is simply a role that holds 'insert' on the shard's 'config' database, which is","+        // what made the escalation below reachable in the original report.","+        authutil.asCluster(st.s, keyFile, () => {","+            assert.commandWorked(st.s.adminCommand({shardCollection: namespace, key: {_id: 1}}));","+            const seedDocuments = [];","+            for (let i = 0; i < 10; ++i) {","+                seedDocuments.push({_id: i, owner: \"victim\", protected: true});","+            }","+            assert.commandWorked(st.s.getDB(dbName).getCollection(collName).insert(seedDocuments));","+        });","+","+        authutil.asCluster(st.rs0.getPrimary(), keyFile, () => {","+            st.rs0","+                .getPrimary()","+                .getDB(\"admin\")","+                .createUser({","+                    user: \"alice\",","+                    pwd: attackerPassword,","+                    roles: [{role: \"clusterManager\", db: \"admin\"}],","+                });","+        });","+","+        attacker = new Mongo(st.rs0.getPrimary().host);","+        assert(","+            attacker.getDB(\"admin\").auth(\"alice\", attackerPassword),","+            \"attacker authentication failed\",","+        );","+    });","+","+    after(function () {","+        st.stop();","+    });","+","+    // The attacker's role must grant no access to the victim data by any path, and no way to write","+    // users. This is the precondition for everything below: if clusterManager could already reach","+    // this data directly, the escalation assertions would prove nothing.","+    describe(\"baseline privileges of a shard-local clusterManager\", function () {","+        function assertUnauthorized(database, command) {","+            assert.commandFailedWithCode(","+                attacker.getDB(database).runCommand(command),","+                ErrorCodes.Unauthorized,","+            );","+        }","+","+        const victimCollectionPaths = CollectionActions.all({","+            db: dbName,","+            coll: collName,","+            document: {_id: -1, injected: true},","+            id: -1,","+        });","+","+        for (const {name, db, command} of victimCollectionPaths) {","+            it(`cannot reach the victim collection via ${name}`, function () {","+                assertUnauthorized(db, command);","+            });","+        }","+","+        // Not swept with CollectionActions: 'admin.system.users' is a restricted namespace, so","+        // several access paths into it are rejected outright rather than with Unauthorized. The","+        // direct write is the one that matters, since it is what the forged state document replays.","+        it(\"cannot write directly to admin.system.users\", function () {","+            assertUnauthorized(\"admin\", {","+                update: \"system.users\",","+                updates: [{q: {_id: \"admin.pwn\"}, u: forgedUser, multi: false, upsert: true}],","+            });","+        });","+    });","+","+    // Sweep every access path with a shard-local user granted all of the actions they require","+    // directly on the namespace, so that each path is denied by the namespace's own rule rather","+    // than by an action the attacker happens to be missing.","+    describe(\"state document namespace is denied to an explicitly privileged shard user\", function () {","+        let explicitAttacker;","+","+        before(function () {","+            authutil.asCluster(st.rs0.getPrimary(), keyFile, () => {","+                const adminDb = st.rs0.getPrimary().getDB(\"admin\");","+                assert.commandWorked(","+                    adminDb.runCommand({","+                        createRole: \"shardStateDocumentWriter\",","+                        privileges: [","+                            {","+                                resource: {db: \"config\", collection: stateDocumentsNs},","+                                actions: stateDocumentActions,","+                            },","+                            ...otherSidePrivileges(),","+                        ],","+                        roles: [],","+                    }),","+                );","+                adminDb.createUser({","+                    user: \"carol\",","+                    pwd: explicitAttackerPassword,","+                    roles: [{role: \"shardStateDocumentWriter\", db: \"admin\"}],","+                });","+            });","+","+            explicitAttacker = new Mongo(st.rs0.getPrimary().host);","+            assert(","+                explicitAttacker.getDB(\"admin\").auth(\"carol\", explicitAttackerPassword),","+                \"explicitly privileged attacker authentication failed\",","+            );","+        });","+","+        for (const {name, db, command} of deniedCommands) {","+            it(`denies ${name}`, function () {","+                assert.commandFailedWithCode(","+                    explicitAttacker.getDB(db).runCommand(command),","+                    ErrorCodes.Unauthorized,","+                );","+            });","+        }","+    });","+","+    // The same denials must hold on the router. A request that originates on mongos reaches the","+    // shard as an internal client, so the router is the only place the user's own privileges are","+    // checked; a shard-only fix would leave this path open. Use a cluster user holding an explicit","+    // privilege on the state document namespace, which is the strongest form of the router-side","+    // attack.","+    describe(\"state document namespace is denied on the router\", function () {","+        let routerAttacker;","+","+        before(function () {","+            authutil.asCluster(st.s, keyFile, () => {","+                const adminDb = st.s.getDB(\"admin\");","+                assert.commandWorked(","+                    adminDb.runCommand({","+                        createRole: \"stateDocumentWriter\",","+                        privileges: [","+                            {","+                                resource: {db: \"config\", collection: stateDocumentsNs},","+                                actions: stateDocumentActions,","+                            },","+                            ...otherSidePrivileges(),","+                        ],","+                        roles: [],","+                    }),","+                );","+                adminDb.createUser({","+                    user: \"bob\",","+                    pwd: routerAttackerPassword,","+                    roles: [{role: \"stateDocumentWriter\", db: \"admin\"}],","+                });","+            });","+","+            routerAttacker = new Mongo(st.s.host);","+            assert(","+                routerAttacker.getDB(\"admin\").auth(\"bob\", routerAttackerPassword),","+                \"router attacker authentication failed\",","+            );","+        });","+","+        for (const {name, db, command, shardOnly} of deniedCommands) {","+            if (shardOnly) {","+                continue;","+            }","+            it(`denies ${name}`, function () {","+                assert.commandFailedWithCode(","+                    routerAttacker.getDB(db).runCommand(command),","+                    ErrorCodes.Unauthorized,","+                );","+            });","+        }","+    });","+","+    // The backup and restore built-in roles hold the implicit privilege, so locking the namespace","+    // down must not break them. These are shard-local users because the state documents live in the","+    // shard's own 'config' database.","+    describe(\"backup and restore roles keep their access\", function () {","+        let backupUser;","+        let restoreUser;","+","+        before(function () {","+            authutil.asCluster(st.rs0.getPrimary(), keyFile, () => {","+                const adminDb = st.rs0.getPrimary().getDB(\"admin\");","+                adminDb.createUser({","+                    user: \"backupUser\",","+                    pwd: backupPassword,","+                    roles: [{role: \"backup\", db: \"admin\"}],","+                });","+                adminDb.createUser({","+                    user: \"restoreUser\",","+                    pwd: restorePassword,","+                    roles: [{role: \"restore\", db: \"admin\"}],","+                });","+            });"],"additions":299,"deletions":0,"truncated":false}],"additions":676,"deletions":0,"truncated":true,"file_count":5},"error":null,"fetched_at