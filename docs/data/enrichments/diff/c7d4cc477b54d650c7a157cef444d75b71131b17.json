ired by these resume boundaries.","+type seededWatchBackend interface {","+\twatchWriteEventsWithSeed(context.Context) (watchSeed, <-chan *WrittenEvent, error)","+}","+","+type watchStartup struct {","+\tstopped     chan struct{}","+\tbroadcaster *broadcaster[*WrittenEvent]","+}","+","+func (s *server) initSeededWatcher(backend seededWatchBackend) {","+\tout := make(chan *WrittenEvent, producerChanSize)","+\tstartup := &watchStartup{stopped: make(chan struct{})}","+\tvar metrics *BroadcasterMetrics","+\tif s.storageMetrics != nil {","+\t\tmetrics = s.storageMetrics.Broadcaster","+\t}","+","+\tvar capture sync.WaitGroup","+\tinitialize := func(ctx context.Context) (cacheSeed[*WrittenEvent], error) {","+\t\tseed, events, err := backend.watchWriteEventsWithSeed(ctx)","+\t\tif err != nil {","+\t\t\tif ctx.Err() == nil {","+\t\t\t\ts.log.Error(\"failed to initialize watch cache\", \"error\", err)","+\t\t\t}","+\t\t\treturn cacheSeed[*WrittenEvent]{}, err","+\t\t}","+\t\ts.mostRecentRV.Store(seed.highestRV)","+\t\tcapture.Go(func() {","+\t\t\tdefer close(out)","+\t\t\tdefer func() {","+\t\t\t\tfor range events {","+\t\t\t\t}","+\t\t\t}()","+\t\t\tfor {","+\t\t\t\tselect {","+\t\t\t\tcase <-ctx.Done():","+\t\t\t\t\treturn","+\t\t\t\tcase event, ok := <-events:","+\t\t\t\t\tif !ok {","+\t\t\t\t\t\treturn","+\t\t\t\t\t}","+\t\t\t\t\tif event == nil || event.PreviousRV < 0 {","+\t\t\t\t\t\tcontinue","+\t\t\t\t\t}","+\t\t\t\t\ts.mostRecentRV.Store(event.ResourceVersion)","+\t\t\t\t\tselect {","+\t\t\t\t\tcase out <- event:","+\t\t\t\t\tcase <-ctx.Done():","+\t\t\t\t\t\treturn","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t\treturn cacheSeed[*WrittenEvent]{","+\t\t\titems: seed.events, initialCacheFloor: seed.initialCacheFloor,","+\t\t}, nil","+\t}","+","+\t// Construction stays asynchronous even if NATS has not entered Run yet.","+\tb := newBroadcasterWithSizes(s.ctx, out, watchChanSize, defaultOverflowCap, metrics, func(e *WrittenEvent) string {","+\t\treturn e.Key.Resource","+\t}, &seededCacheConfig[*WrittenEvent]{","+\t\tidentity:   writtenEventIdentity,","+\t\tinitialize: initialize,","+\t})","+\tstartup.broadcaster = b","+\ts.broadcaster, s.watchStartup = b, startup","+\tgo func() {","+\t\t<-b.terminated","+\t\tcapture.Wait()","+\t\tclose(startup.stopped)","+\t}()","+}"],"additions":82,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/server_watch_test.go","lines":["@@ -0,0 +1,501 @@","+package resource","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"testing/synctest\"","+\t\"time\"","+","+\tauthlib \"github.com/grafana/authlib/types\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/stretchr/testify/require\"","+\t\"google.golang.org/grpc/codes\"","+\t\"google.golang.org/grpc/status\"","+","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/sql/rvmanager\"","+)","+","+func initWatchServer(t *testing.T, backend StorageBackend) *server {","+\tt.Helper()","+\treturn initWatchServerWithSeededWatches(t, backend, true)","+}","+","+func initWatchServerWithSeededWatches(t *testing.T, backend StorageBackend, enabled bool) *server {","+\tt.Helper()","+\tsrv, err := NewUninitializedResourceServer(ResourceServerOptions{","+\t\tBackend: backend, StorageMetrics: ProvideStorageMetrics(prometheus.NewRegistry()), BookmarkFrequency: time.Second,","+\t\tSeededWatchesEnabled: enabled,","+\t})","+\trequire.NoError(t, err)","+\tt.Cleanup(func() {","+\t\tctx, cancel := context.WithTimeout(context.Background(), time.Second)","+\t\tdefer cancel()","+\t\t_ = srv.Stop(ctx)","+\t})","+\trequire.NoError(t, srv.initWatcher())","+\treturn srv","+}","+","+func TestKVWatchSeededWatchesToggle(t *testing.T) {","+\tfor _, enabled := range []bool{false, true} {","+\t\tt.Run(map[bool]string{false: \"disabled\", true: \"enabled\"}[enabled], func(t *testing.T) {","+\t\t\tbackend := setupTestStorageBackend(t, withChannelNotifier)","+\t\t\tbase := snowflakeFromTime(time.Now().Add(-time.Hour))","+\t\t\tsaveWatchEvent(t, backend, durableWatchEvent(base))","+\t\t\tsrv := initWatchServerWithSeededWatches(t, backend, enabled)","+\t\t\tif enabled {","+\t\t\t\trequire.NotNil(t, srv.watchStartup)","+\t\t\t\trequire.NoError(t, srv.watchStartup.broadcaster.waitReady(t.Context()))","+\t\t\t} else {","+\t\t\t\trequire.Nil(t, srv.watchStartup)","+\t\t\t}","+","+\t\t\tctx, cancel := context.WithTimeout(authlib.WithAuthInfo(t.Context(), newWatchTestUser()), 5*time.Second)","+\t\t\tdefer cancel()","+\t\t\treq := bookmarkWatchRequest()","+\t\t\treq.AllowWatchBookmarks = false","+\t\t\treq.Options.Key.Name = \"\"","+\t\t\treq.Since = base - 1","+\t\t\tstream := newMockWatchServer(ctx)","+\t\t\tdone := make(chan error, 1)","+\t\t\tgo func() { done <- srv.Watch(req, stream) }()","+\t\t\tif enabled {","+\t\t\t\tselect {","+\t\t\t\tcase err := <-done:","+\t\t\t\t\trequire.True(t, IsResourceVersionExpired(err), \"expected expiry, got %v\", err)","+\t\t\t\t\trequire.Empty(t, stream.events)","+\t\t\t\tcase <-ctx.Done():","+\t\t\t\t\tt.Fatal(\"seeded watch did not reject the expired cursor\")","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+","+\t\t\trequireMetricEventually(t, srv.storageMetrics.Broadcaster.Subscribers.WithLabelValues(watchTestResource), 1)","+\t\t\tlive := durableWatchEvent(base + 1)","+\t\t\tsaveWatchEvent(t, backend, live)","+\t\t\tbackend.notifier.Publish(live)","+\t\t\tselect {","+\t\t\tcase event := <-stream.events:","+\t\t\t\trequire.Equal(t, resourcepb.WatchEvent_ADDED, event.Type)","+\t\t\t\trequire.Equal(t, live.ResourceVersion, event.Resource.Version)","+\t\t\tcase <-ctx.Done():","+\t\t\t\tt.Fatal(\"unseeded watch did not deliver the live event\")","+\t\t\t}","+\t\t\tcancel()","+\t\t\trequire.NoError(t, <-done)","+\t\t})","+\t}","+}","+","+func TestKVWatchResumeExpiryAndReplay(t *testing.T) {","+\tbackend := setupTestStorageBackend(t)","+\t// Use RVs that round-trip through the supported legacy microsecond format.","+\trv := rvmanager.SnowflakeFromRV(time.Now().Add(-time.Hour).UnixMicro())","+\tfor _, version := range []int64{rv, rv + 4096, rv + 8192} {","+\t\tsaveWatchEvent(t, backend, durableWatchEvent(version))","+\t}","+\tsrv := initWatchServer(t, backend)","+\trequire.NoError(t, srv.watchStartup.broadcaster.waitReady(t.Context()))","+\tfor _, tc := range []struct {","+\t\tname    string","+\t\tsince   int64","+\t\tgroup   string","+\t\texpired bool","+\t}{","+\t\t{name: \"below initial floor\", since: rv - 1, expired: true},","+\t\t{name: \"unobserved group\", since: rv - 1, group: \"never.grafana.app\", expired: true},","+\t\t{name: \"equal initial floor\", since: rv},","+\t\t{name: \"legacy format equality\", since: rvmanager.RVFromSnowflake(rv)},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tctx, cancel := context.WithCancel(authlib.WithAuthInfo(t.Context(), newWatchTestUser()))","+\t\t\tdefer cancel()","+\t\t\treq := bookmarkWatchRequest()","+\t\t\treq.Options.Key.Name = \"\"","+\t\t\tif tc.group != \"\" {","+\t\t\t\treq.Options.Key.Group = tc.group","+\t\t\t}","+\t\t\treq.Since = tc.since","+\t\t\tstream := newMockWatchServer(ctx)","+\t\t\tdone := make(chan error, 1)","+\t\t\tgo func() { done <- srv.Watch(req, stream) }()","+\t\t\tif tc.expired {","+\t\t\t\tselect {","+\t\t\t\tcase err := <-done:","+\t\t\t\t\trequire.Equal(t, codes.OutOfRange, status.Code(err))","+\t\t\t\t\tresult := AsErrorResult(err)","+\t\t\t\t\trequire.EqualValues(t, 410, result.Code)","+\t\t\t\t\trequire.Equal(t, \"Expired\", result.Reason)","+\t\t\t\t\trequire.Empty(t, stream.events, \"expiry must precede objects and bookmarks\")","+\t\t\t\tcase <-time.After(time.Second):","+\t\t\t\t\tt.Fatal(\"expiry did not terminate watch\")","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tfor _, want := range []int64{rv + 4096, rv + 8192} {","+\t\t\t\tselect {","+\t\t\t\tcase event := <-stream.events:","+\t\t\t\t\trequire.Equal(t, resourcepb.WatchEvent_ADDED, event.Type)","+\t\t\t\t\trequire.Equal(t, want, event.Resource.Version)","+\t\t\t\tcase <-time.After(time.Second):","+\t\t\t\t\tt.Fatal(\"missing replay event\")","+\t\t\t\t}","+\t\t\t}","+\t\t\tcancel()","+\t\t\trequire.NoError(t, <-done)","+\t\t})","+\t}","+}","+","+func TestKVWatchSeedReadsPreviousPayloadOnReplay(t *testing.T) {","+\tstore := &countingKV{KV: setupBadgerKV(t)}","+\tbackend := setupTestStorageBackend(t, withKV(store))","+\tcreated := durableWatchEvent(snowflakeFromTime(time.Now().Add(-time.Hour)))","+\tsaveWatchEvent(t, backend, created)","+\tupdated := created","+\tupdated.ResourceVersion++","+\tupdated.PreviousRV = created.ResourceVersion","+\tupdated.Action = DataActionUpdated","+\tsaveWatchEvent(t, backend, updated)","+\tdeleted := updated","+\tdeleted.ResourceVersion++","+\tdeleted.PreviousRV = updated.ResourceVersion","+\tdeleted.Action = DataActionDeleted","+\tsaveWatchEvent(t, backend, deleted)","+","+\tsrv := initWatchServer(t, backend)","+\trequire.NoError(t, srv.watchStartup.broadcaster.waitReady(t.Context()))","+\t_, keysBefore := store.stats()","+\trequire.Equal(t, 3, keysBefore, \"seed loading reads only the cached event payloads\")","+","+\tctx, cancel := context.WithCancel(authlib.WithAuthInfo(t.Context(), newWatchTestUser()))","+\tdefer cancel()","+\tstream := newMockWatchServer(ctx)","+\treq := bookmarkWatchRequest()"],"additions":177,"deletions":0,"truncated":false}],"additions":469,"deletions":44,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-06T14:36:05.608350+00:00"}