{"id":"90a3cb8ade74ed868b44e990178827839fed1e30","axis":"silent","repo":"foundry-rs/foundry","sha":"90a3cb8ade74ed868b44e990178827839fed1e30","parsed":{"files":[{"path":"crates/anvil/tests/it/tempo/configurable_account.rs","lines":["@@ -1,4 +1,4 @@","-//! Gas estimates and impersonation for Tempo configurable accounts (TIP-1107, TIP-1113).","+//! Gas estimates and impersonation for Tempo configurable accounts (TIP-1107, TIP-1111, TIP-1113)."," //!"," //! Owners have not signed when a transaction is estimated or impersonated, so Anvil models their"," //! quorum with placeholder `0x05` approvals, as a Tempo node does for `eth_estimateGas`.","@@ -231,3 +231,72 @@ async fn test_tempo_t14_impersonate_configurable_account() {","         assert_eq!(provider.get_transaction_count(address).await.unwrap(), 3);","     }"," }","+","+/// A configurable account acts as an access key of an EOA (TIP-1111). The EOA authorizes it with","+/// key type `configurable`, and its owners approve the keychain V2 hash","+/// `keccak256(0x04 || tx_hash || root)`, as Tempo and viem sign it, in a `0x05` signature that a","+/// keychain signature wraps for the EOA. The estimate models that quorum from the `keyId` and the","+/// account's witness, and the first such transaction registers the account. A quorum over the","+/// bare transaction hash, which the account's own transactions carry, does not authorize.","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_tempo_t14_configurable_account_as_access_key() {","+    let (_api, handle) =","+        spawn(NodeConfig::test_tempo().with_hardfork(Some(TempoHardfork::T14.into()))).await;","+    let provider = handle.http_provider();","+    let root = handle.dev_accounts().next().unwrap();","+    deal(&provider, root).await;","+    let account = TestConfigurableAccount::fixture();","+","+    let authorize = authorizeKeyCall {","+        keyId: account.address,","+        signatureType: KeychainSignatureType::ConfigurableAccount,","+        config: KeyRestrictions {","+            expiry: u64::MAX,","+            enforceLimits: false,","+            limits: vec![],","+            allowAnyCalls: true,","+            allowedCalls: vec![],","+        },","+    };","+    let mut authorization = request(root, 0);","+    authorization[\"gas\"] = serde_json::json!(U256::from(T5_PRECOMPILE_GAS));","+    authorization[\"calls\"] = serde_json::json!([Call {","+        to: TxKind::Call(ACCOUNT_KEYCHAIN_ADDRESS),","+        value: U256::ZERO,","+        input: authorize.abi_encode().into(),","+    }]);","+    let hash = provider","+        .raw_request::<_, B256>(\"eth_sendTransaction\".into(), (authorization,))","+        .await","+        .unwrap();","+    let receipt =","+        PendingTransactionBuilder::new(provider.root().clone(), hash).get_receipt().await.unwrap();","+    assert!(receipt.status(), \"authorizeKey should succeed: {receipt:?}\");","+","+    let mut simulated = request(root, 1);","+    simulated[\"keyId\"] = serde_json::json!(account.address);","+    simulated[\"configurableAccountSimulation\"] = witness(&account, Some(\"secp256k1\"));","+    simulated[\"configurableAccountSimulation\"][\"signer\"] = serde_json::json!(account.address);","+    let gas = estimate(&provider, simulated).await.unwrap();","+","+    let mut tx = configurable_account_tx(&provider, 1, vec![noop()]).await;","+    tx.gas_limit = gas;","+    let bare = TempoSignature::Keychain(KeychainSignature::new(","+        root,","+        account.approve(tx.signature_hash()).await,","+    ));","+    let error = send_signed_tempo_tx(&provider, tx.clone(), bare).await.unwrap_err();","+    assert!(error.ends_with(\"Failed to recover the signer\"), \"unexpected error: {error}\");","+","+    let keychain_hash = KeychainSignature::signing_hash(tx.signature_hash(), root);","+    let signature = TempoSignature::Keychain(KeychainSignature::new(","+        root,","+        account.approve(keychain_hash).await,","+    ));","+    let receipt = send_signed_tempo_tx(&provider, tx, signature).await.unwrap();","+    assert!(receipt.status(), \"the access key should authorize: {receipt:?}\");","+    assert_eq!(receipt.from, root);","+    assert_eq!(receipt.gas_used, gas);","+    assert_eq!(provider.get_transaction_count(root).await.unwrap(), 2);","+    assert_eq!(config_commitment(&provider, account.address).await, VIEM_CA_COMMITMENT_V0);","+}"],"additions":70,"deletions":1,"truncated":false},{"path":"crates/cast/src/cmd/batch_mktx.rs","lines":["@@ -96,6 +96,11 @@ impl BatchMakeTxArgs {","         }"," ","         let configurable_account = if raw_unsigned || ethsign || tempo_access_key.is_some() {","+            eyre::ensure!(","+                tx.tempo.configurable_access_key.is_none(),","+                \"--tempo.configurable-access-key cannot be combined with --raw-unsigned, \\","+                 --ethsign or a Tempo access key\"","+            );","             None","         } else {","             tempo::resolve_configurable_account::<TempoNetwork>(","@@ -154,7 +159,7 @@ impl BatchMakeTxArgs {","                 .await?;","             tx.sign_with_tempo_wallet(&prepared).await?","         } else if let Some(account) = &configurable_account {","-            let from = account.account();","+            let from = account.sender();","             let Some(mut tx) = confirm_and_build(tx_builder, from, force, lane, false).await?","             else {","                 return Ok(());"],"additions":6,"deletions":1,"truncated":false},{"path":"crates/cast/src/cmd/batch_send.rs","lines":["@@ -80,6 +80,11 @@ impl BatchSendArgs {","             tempo::resolve_session_or_wallet_signer(&tx.tempo, &send_tx.eth.wallet, chain.id())","                 .await?;","         let configurable_account = if unlocked || tempo_access_key.is_some() {","+            eyre::ensure!(","+                tx.tempo.configurable_access_key.is_none(),","+                \"--tempo.configurable-access-key cannot be combined with --unlocked or a Tempo \\","+                 access key\"","+            );","             None","         } else {","             tempo::resolve_configurable_account::<TempoNetwork>(","@@ -120,7 +125,7 @@ impl BatchSendArgs {","             cast_send_with_tempo_wallet(&provider, tx_request, &prepared, &send_opts).await?;","         } else if let Some(account) = &configurable_account {","             let Some(tx_request) =","-                confirm_and_build(builder, account.account(), force, lane, false).await?","+                confirm_and_build(builder, account.sender(), force, lane, false).await?","             else {","                 return Ok(());","             };"],"additions":6,"deletions":1,"truncated":false},{"path":"crates/cast/src/cmd/configurable_key_auth.rs","lines":["@@ -127,6 +127,10 @@ pub(crate) async fn send_keychain_tx_as_configurable_account(","         tx.tempo.sponsor_url.is_none() && !tx.tempo.print_sponsor_hash,","         \"--sponsor-url and --tempo.print-sponsor-hash are not supported for configurable accounts\"","     );","+    eyre::ensure!(","+        tx.tempo.configurable_access_key.is_none(),","+        \"an access key cannot manage the keys of the account it signs for\"","+    );","     eyre::ensure!(","         !send_tx.browser.browser,","         \"browser wallets cannot approve as a configurable account owner\""],"additions":4,"deletions":0,"truncated":false},{"path":"crates/cast/src/cmd/estimate.rs","lines":["@@ -143,6 +143,7 @@ impl EstimateArgs {","                 \"--tempo.configurable-account {account} does not match the sender {from}\"","             );","         }","+        let as_access_key = tx.tempo.configurable_access_key.is_some();","         let simulation_wallet = wallet.clone();","         let (sender, is_browser) = read_only_sender::<N>(&browser, wallet, &tx, chain_id).await?;","         // Share the resolved signer with the configurable account lookup.","@@ -195,8 +196,15 @@ impl EstimateArgs {","             .await?