ny point; it continues on the environment,","+ * where the progress card picks it up. Cloud only, behind the","+ * projectEnvironments feature like the switcher that opens this.","+ */","+","+import { useEffect, useMemo, useState } from 'react'","+import { useNavigate } from '@tanstack/react-router'","+import { AppwriteException, type Models } from '@appwrite.io/console'","+import { toast } from 'sonner'","+import { Button } from '@/components/ui/button'","+import { WizardLayout } from '@/components/global/shared/WizardLayout'","+import { useSessionMigrations } from '@/components/global/providers/SessionMigrationsContext'","+import { useConsoleProfile } from '@/hooks/use-console-profile'","+import {","+  PROJECT_NAME_MAX_LENGTH,","+  useCreateProjectEnvironment,","+  useEnvironmentCopyProgress,","+  useProject,","+} from '@/lib/react-query/hooks'","+import { isValidProjectId } from '@/lib/project-id'","+import {","+  defaultProjectEnvironmentCopySelection,","+  projectEnvironmentCopyResources,","+  type ProjectEnvironmentCopyGroupId,","+  type ProjectEnvironmentCopySelection,","+} from '@/lib/project-environments'","+import { getErrorMessage } from '@/lib/utils/error-formatting'","+import { useT, type Translator } from '@/lib/i18n/translate'","+import { ConnectStep } from './_components/ConnectStep'","+import { CopyProgressStep } from './_components/CopyProgressStep'","+import {","+  DetailsStep,","+  type EnvironmentStartFrom,","+} from './_components/DetailsStep'","+import { ResourcesStep } from './_components/ResourcesStep'","+import { WizardSteps, type WizardStep } from './_components/WizardSteps'","+","+type StepId = 'details' | 'resources' | 'connect' | 'progress'","+","+const STEP_DESCRIPTIONS: Record<StepId, string> = {","+  details: 'Name the environment and choose where it starts.',","+  resources: 'Pick what to copy from the project.',","+  connect: 'Point your app at the new environment.',","+  progress: 'Follow the copy from the project.',","+}","+","+const IN_PROGRESS_COPY_STATUSES = ['pending', 'processing']","+","+/**","+ * Create fails with its own copy for the per-hour creation limit and for the","+ * plan caps, which the server words well enough to show as-is.","+ */","+function getCreateErrorMessage(error: unknown, t: Translator): string {","+  if (error instanceof AppwriteException) {","+    if (error.code === 429) {","+      return t(","+        'Too many environments created for this project in the last hour. Try again later.',","+      )","+    }","+    if (","+      error.type === 'billing_plan_not_allowed' ||","+      error.type === 'billing_additional_resource_not_allowed'","+    ) {","+      return error.message","+    }","+  }","+  return getErrorMessage(error, t('Failed to create environment'))","+}","+","+export function CreateEnvironmentWizardView({","+  projectId,","+}: {","+  projectId: string","+}) {","+  const t = useT()","+  const navigate = useNavigate()","+  const { features } = useConsoleProfile()","+  const { project, projectData } = useProject(projectId)","+  const region = project?.region","+","+  const [step, setStep] = useState<StepId>('details')","+  const [name, setName] = useState('')","+  const [environmentId, setEnvironmentId] = useState<string | undefined>(","+    undefined,","+  )","+  const [startFrom, setStartFrom] = useState<EnvironmentStartFrom>('empty')","+  const [selection, setSelection] = useState<ProjectEnvironmentCopySelection>(","+    defaultProjectEnvironmentCopySelection,","+  )","+  const [nameError, setNameError] = useState<string | undefined>(undefined)","+  const [environment, setEnvironment] = useState<Models.Project | null>(null)","+","+  const createEnvironmentMutation = useCreateProjectEnvironment(","+    projectId,","+    region,","+  )","+  const isCreating = createEnvironmentMutation.isPending","+  const isCopy = startFrom === 'project'","+","+  // The copy is followed only once the environment exists and was asked to copy","+  const migration = useEnvironmentCopyProgress(","+    environment?.$id,","+    isCopy && !!environment,","+  )","+  const copyRunning =","+    !migration || IN_PROGRESS_COPY_STATUSES.includes(migration.status)","+","+  // Hand the copy to the environment's progress card before the wizard is","+  // left: the session outlives the switch of project, so the card shows the","+  // copy at once, finished or not, instead of looking it up on arrival","+  const { addCopyId } = useSessionMigrations(environment?.$id)","+  useEffect(() => {","+    if (environment && migration) addCopyId(environment.$id, migration.$id)","+  }, [environment, migration, addCopyId])","+","+  // Environments are created from the production project: an environment's own","+  // URL here goes to its parent's, and the wizard is Cloud only like the switcher","+  useEffect(() => {","+    if (!features.projectEnvironments) {","+      void navigate({ to: '/projects/$projectId', params: { projectId } })","+      return","+    }","+    if (projectData?.parentId) {","+      void navigate({","+        to: '/projects/$projectId/environments/create',","+        params: { projectId: projectData.parentId },","+        replace: true,","+      })","+    }","+  }, [features.projectEnvironments, projectData?.parentId, projectId, navigate])","+","+  const steps = useMemo<WizardStep[]>(","+    () => [","+      { id: 'details', title: 'Details' },","+      ...(isCopy ? [{ id: 'resources', title: 'Resources' }] : []),","+      { id: 'connect', title: 'Connect' },","+      ...(isCopy ? [{ id: 'progress', title: 'Copy' }] : []),","+    ],","+    [isCopy],","+  )","+","+  // `IdInput` reports a bad id inline but still hands it up, so the wizard is","+  // what keeps a server-side `ProjectId` rejection from being the first signal.","+  const trimmedEnvironmentId = environmentId?.trim() ?? ''","+  const isEnvironmentIdValid = isValidProjectId(trimmedEnvironmentId)","+","+  // What the API is asked to copy; a copy with nothing picked has no meaning","+  const resources = isCopy ? projectEnvironmentCopyResources(selection) : []","+  const isCopyEmpty = isCopy && resources.length === 0","+","+  const trimmedName = name.trim()","+  const isNameValid =","+    trimmedName.length > 0 && trimmedName.length <= PROJECT_NAME_MAX_LENGTH","+  const detailsValid = isNameValid && isEnvironmentIdValid","+","+  const setGroup = (","+    groupId: ProjectEnvironmentCopyGroupId,","+    patch: Partial<{ structure: boolean; data: boolean }>,","+  ) => {","+    setSelection((prev) => ({","+      ...prev,","+      [groupId]: { ...prev[groupId], ...patch },","+    }))","+  }","+","+  const validateName = (): boolean => {","+    if (!trimmedName) {","+      setNameError(t('Name is required'))","+      return false","+    }","+    if (trimmedName.length > PROJECT_NAME_MAX_LENGTH) {","+      setNameError(","+        `${t('Name must be no longer than')} ${PROJECT_NAME_MAX_LENGTH} ${t('characters')}`,","+      )","+      return false","+    }","+    setNameError(undefined)","+    return true","+  }","+","+  const openEnvironment = () => {","+    if (!environment) return","+    void navigate({","+      to: '/projects/$projectId',","+      params: { projectId: environment.$id },","+    })","+  }","+","+  const handleCreate = async () => {","+    if (!validateName() || !isEnvironmentIdValid || isCopyEmpty) return","+","+    try {","+      const created = await createEnvironmentMutation.mutateAsync({","+        environmentId,","+        name: trimmedName,","+        resources,","+      })","+      setEnvironment(created)","+      setStep('connect')","+    } catch (error: unknown) {","+      toast.error(getCreateErrorMessage(error, t))","+    }","+  }","+","+  const handleDetailsContinue = () => {","+    if (!validateName() || !isEnvironmentIdValid) return","+    setStep('resources')","+  }","+","+  const footer = (","+    <div className=\"flex w-full justify-end gap-2\">","+      {step === 'details' && (","+        <>","+          <Button","+            type=\"button\"","+            variant=\"outline\"","+            onClick={() =>","+              void navigate({","+                to: '/projects/$projectId',","+                params: { projectId },","+              })","+            }","+            disabled={isCreating}","+          >","+            {t('Cancel')}","+          </Button>","+          {isCopy ? (","+            <Button","+              type=\"button\"","+              onClick={handleDetailsContinue}","+              disabled={!detailsValid}","+            >","+              {t('Continue')}","+            </Button>","+          ) : (","+            <Button","+              type=\"button\"","+              variant=\"brandCta\"","+              onClick={() => void handleCreate()}","+              disabled={!detailsValid || isCreating}","+            >","+              {t('Create')}","+            </Button>","+          )}","+        </>","+      )}","+      {step === 'resources' && (","+        <>","+          <Button","+            type=\"button\"","+            variant=\"outline\"","+            onClick={() => setStep('details')}","+            disabled={isCreating}","+          >","+            {t('Back')}","+          </Button>","+          <Button","+            type=\"button\"","+            variant=\"brandCta\"","+            onClick={() => void handleCreate()}","+            disabled={!detailsValid || isCopyEmpty || isCreating}","+          >","+            {t('Create')}","+          </Button>","+        </>","+      )}","+      {step === 'connect' &&","+        (isCopy ? (","+          <Button type=\"button\" onClick={() => setStep('progress')}>","+            {t('Continue')}","+          </Button>","+        ) : (","+          <Button type=\"button\" variant=\"brandCta\" onClick={openEnvironment}>","+            {t('Open environment')}","+          </Button>","+        ))}","+      {step === 'progress' &&","+        (copyRunning ? (","+          <Button type=\"button\" variant=\"outline\" onClick={openEnvironment}>","+            {t('Skip')}","+          </Button>","+        ) : (","+          <Button type=\"button\" variant=\"brandCta\" onClick={openEnvironment}>","+            {t('Open environment')}","+          </Button>","+        ))}","+    </div>","+  )","+","+  return (","+    <WizardLayout","+      title={t('Create environment')}","+      description={t(STEP_DESCRIPTIONS[step])}","+      fullscreen","+      useSidebar={false}","+      maxWidth=\"max-w-3xl\"","+      fallbackPath={`/projects/${projectId}`}","+      footer={footer}","+      footerAlign=\"right\"","+      skipInitialFieldFocus={step !== 'details'}","+    >","+      <div className=\"space-y-6\">","+        <WizardSteps steps={steps} current={step} />","+","+        {step === 'details' && (","+          <DetailsStep","+            name={name}","+            onNameChange={(value) => {","+              setName(value)","+              if (nameError) setNameError(undefined)","+            }}","+            nameError={nameError}","+            environmentId={environmentId}","+            onEnvironmentIdChange={setEnvironmentId}","+            startFrom={startFrom}","+            onStartFromChange={setStartFrom}","+            disabled={isCreating}","+          />","+        )}","+","+        {step === 'resources' && (","+          <ResourcesStep","+            selection={selection}","+            onGroupChange={setGroup}","+            isCopyEmpty={isCopyEmpty}","+            disabled={isCreating}","+          />","+        )}","+","+        {step === 'connect' && environment && (","+          <ConnectStep environment={environment} />","+        )}","+","+        {step === 'progress' && environment && (","+          <CopyProgressStep","+            environmentId={environment.$id}","+            sourceName={project?.name || projectId}","+            migration={migration}","+          />","+        )}","+      </div>","+    </WizardLayout>","+  )","+}"],"additions":347,"deletions":0,"truncated":false},{"path":"apps/console/src/components/pages/projects/$projectId/environments/create/_components/ConnectStep.tsx","lines":["@@ -0,0 +1,68 @@","+import { CheckCircle2 } from 'lucide-react'","+import type { Models } from '@appwrite.io/console'","+import { CopyableId } from '@/components/global/shared/CopyableId'","+import { getApiEndpoint } from '@/lib/appwrite/sdk'","+import { useT } from '@/lib/i18n/translate'","+","+function Field({","+  label,","+  children,","+}: {","+  label: string","+  children: React.ReactNode","+}) {","+  return (","+    <div className=\"flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between sm:gap-4\">","+      <dt className=\"text-[12px] font-medium uppercase tracking-wide text-muted-foreground\">","+        {label}","+      </dt>","+      <dd className=\"min-w-0 text-[13px] text-foreground\">{children}</dd>","+    </div>","+  )","+}","+","+/** The new environment is a project of its own: the ID an app uses to talk to it. */","+export function ConnectStep({ environment }: { environment: Models.Project }) {","+  const t = useT()","+","+  return (","+    <div className=\"space-y-4\">","+      <div className=\"rounded-xl border border-border bg-card/50 p-5\">","+        <div className=\"flex items-center gap-3\">","+          <CheckCircle2 className=\"h-5 w-5 shrink-0 text-green-600\" />","+          <h2 className=\"text-[15px] font-semibold text-foreground\">","+            {t('Environment created')}","+          </h2>","+        </div>","+        <p className=\"mt-2 text-[13px] text-muted-foreground\">","+          {t(","+            'An environment is a project of its own. Point an app at it with this project ID; the API endpoint is the one your project already uses.',","+          )}","+        </p>","+        <dl className=\"mt-5 space-y-3\">","+          <Field label={t('Name')}>{environment.name}</Field>","+          <Field label={t('Environment ID')}>","+            <CopyableId","+              id={environment.$id}","+              variant=\"inline\"","+              size=\"md\"","+              copyToastLabel=\"ID\"","+              maxWidth={320}","+              showCopyOnHover={false}","+            />","+          </Field>","+          <Field label={t('API endpoint')}>","+            <CopyableId","+              id={getApiEndpoint(environment.region)}","+              variant=\"inline\"","+              size=\"md\"","+              copyToastLabel=\"Endpoint\"","+              maxWidth={320}","+              showCopyOnHover={false}","+            />","+          </Field>","+        </dl>","+      </div>","+    </div>","+  )","+}"],"additions":68,"deletions":0,"truncated":false},{"path":"apps/console/src/components/pages/projects/$projectId/environments/create/_components/CopyProgressStep.tsx","lines":["@@ -0,0 +1,146 @@","+import { Link } from '@tanstack/react-router'","+import {","+  AlertCircle,","+  CheckCircle2,","+  Clock,","+  Loader2,","+  XCircle,","+} from 'lucide-react'","+import type { Models } from '@appwrite.io/console'","+import { Button } from '@/components/ui/button'","+import { ProgressBarRow } from '@/components/global/shared/ProgressBarRow'","+import {","+  getMigrationErrorMessage,","+  getMigrationResourceBreakdown,","+  type MigrationResourceBreakdownItem,","+} from '@/components/pages/projects/$projectId/settings/migrations/migrationProgress'","+import { migrationProgress } from '@/lib/project-environments'","+import { cn } from '@/lib/utils'","+import { useT } from '@/lib/i18n/translate'","+","+const TONE_ICON: Record<","+  MigrationResourceBreakdownItem['tone'],","+  { icon: typeof Clock; className: string }","+> = {","+  waiting: { icon: Clock, className: 'text-muted-foreground' },","+  processing: { icon: Loader2, className: 'animate-spin text-primary' },","+  success: { icon: CheckCircle2, className: 'text-green-600' },","+  error: { icon: XCircle, className: 'text-destructive' },","+}","+","+interface CopyProgressStepProps {","+  /** The environment being copied into */","+  environmentId: string","+  /** The project it copies from, named for the user */","+  sourceName: string","+  /** Null until the environment lists its copy */","+  migration: Models.Migration | null","+}","+","+/** The copy from the project as it runs, resource type by resource type. */","+export function CopyProgressStep({","+  environmentId,","+  sourceName,","+  migration,","+}: CopyProgressStepProps) {","+  const t = useT()","+  const status = migration?.status","+  const isFailed = status === 'failed'","+  const isCompleted = status === 'completed'","+","+  // The counters say how far the copy got once the worker has reported; before","+  // that the bar shows it has started","+  const progress = !migration","+    ? 0","+    : isCompleted || isFailed","+      ? 100","+      : Math.max(migrationProgress(migration.statusCounters), 5)","+","+  const statusLabel = !migration","+    ? t('Starting the copy')","+    : isCompleted","+      ? t('Copied from the project')","+      : isFailed","+        ? t('Could not copy from the project')","+        : t('Copying from the project')","+","+  const breakdown = migration ? getMigrationResourceBreakdown(migration) : []","+  const errorMessage = isFailed","+    ? getMigrationErrorMessage(migration?.errors)","+    : null","+","+  return (","+    <div className=\"space-y-4\">","+      <div className=\"rounded-xl border border-border bg-card/50 p-5\">","+        <div className=\"flex items-center gap-3\">","+          {isCompleted ? (","+            <CheckCircle2 className=\"h-5 w-5 shrink-0 text-green-600\" />","+          ) : isFailed ? (","+            <AlertCircle className=\"h-5 w-5 shrink-0 text-destructive\" />","+          ) : (","+            <Loader2 className=\"h-5 w-5 shrink-0 animate-spin text-primary\" />","+          )}","+          <div className=\"min-w-0\">","+            <h2 className=\"text-[15px] font-semibold text-foreground\">","+              {statusLabel}","+            </h2>","+            <p className=\"truncate text-[12px] text-muted-foreground\">","+              {sourceName}","+            </p>","+          </div>","+        </div>","+        <div className=\"mt-4\">","+          <ProgressBarRow value={progress} />","+        </div>","+        {errorMessage && (","+          <p className=\"mt-3 text-[12px] text-destructive\">{errorMessage}</p>","+        )}","+        {isFailed && (","+          <Button","+            asChild","+            variant=\"link\"","+            size=\"sm\"","+            className=\"mt-1 h-auto p-0 text-[12px]\"","+          >","+            <Link","+              to=\"/projects/$projectId/settings/migrations\"","+              params={{ projectId: environmentId }}","+            >","+              {t('View details')}","+            </Link>","+          </Button>","+        )}","+      </div>","+","+      {breakdown.length > 0 && (","+        <ul className=\"divide-y divide-border rounded-xl border border-border bg-card/50\">","+          {breakdown.map((item) => {","+            const { icon: Icon, className } = TONE_ICON[item.tone]","+            return (","+              <li","+                key={item.key}","+                className=\"flex items-center gap-3 px-4 py-2.5 text-[13px]\"","+              >","+                <Icon className={cn('h-4 w-4 shrink-0', className)} />","+                <span className=\"min-w-0 flex-1 truncate text-foreground\">","+                  {t(item.label)}","+                </span>","+                <span className=\"shrink-0 tabular-nums text-muted-foreground\">","+                  {item.succeeded} / {item.total}","+                </span>","+              </li>","+            )","+          })}","+        </ul>","+      )}","+","+      {!isCompleted && !isFailed && (","+        <p className=\"text-[12px] text-muted-foreground\">","+          {t(","+            'You can skip this step. The copy keeps running in the background and shows i