{"id":"32de172c6cc60a125b5d4398cd5421b1ec13a4b1","axis":"silent","repo":"comet-ml/comet-llm","sha":"32de172c6cc60a125b5d4398cd5421b1ec13a4b1","parsed":{"files":[{"path":"apps/opik-backend/config.yml","lines":["@@ -2009,6 +2009,9 @@ serviceToggles:","   # Description: Whether or not the backend runs guardrails itself: the checks on opik-inference (POST /v1/private/guardrails/validations) and the guardrail policies API","   guardrailsValidationsEnabled: ${TOGGLE_GUARDRAILS_VALIDATIONS_ENABLED:-\"false\"}","   # Default: false","+  # Description: Whether or not workspaces can train their own guardrail models: the guardrail models API","+  guardrailsTrainingEnabled: ${TOGGLE_GUARDRAILS_TRAINING_ENABLED:-\"false\"}","+  # Default: false","   # Description: Whether or not to enable the trace thread Python evaluator","   traceThreadPythonEvaluatorEnabled: ${TOGGLE_TRACE_THREAD_PYTHON_EVALUATOR_ENABLED:-\"true\"}","   # Default: false","@@ -3002,3 +3005,22 @@ guardrails:","   # Default: 0.4","   # Description: A prompt injection check fails when the probability is at or above this","   promptInjectionThreshold: ${GUARDRAILS_PROMPT_INJECTION_THRESHOLD:-0.4}","+","+# Training data of the guardrail models a workspace trains (the guardrail models API): the limits a member's JSONL upload","+# is held to. The trainer on opik-inference applies the same rules and reads the same variables.","+guardrailsTrainingDataset:","+  # Default: 50","+  # Description: Largest training data file, in MB","+  maxFileSizeMb: ${GUARDRAILS_TRAINING_DATASET_MAX_FILE_SIZE_MB:-50}","+  # Default: 20","+  # Description: Fewest valid rows a file can train on","+  minRows: ${GUARDRAILS_TRAINING_DATASET_MIN_ROWS:-20}","+  # Default: 50000","+  # Description: Most valid rows a file can hold","+  maxRows: ${GUARDRAILS_TRAINING_DATASET_MAX_ROWS:-50000}","+  # Default: 5","+  # Description: Fewest rows of each label, yes and no","+  minRowsPerLabel: ${GUARDRAILS_TRAINING_DATASET_MIN_ROWS_PER_LABEL:-5}","+  # Default: 12000","+  # Description: Longest text of a row, in characters (Unicode code points, as Python's len() counts them); at most 100000","+  maxTextLength: ${GUARDRAILS_TRAINING_DATASET_MAX_TEXT_LENGTH:-12000}"],"additions":22,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/GuardrailModel.java","lines":["@@ -0,0 +1,50 @@","+package com.comet.opik.api;","+","+import com.fasterxml.jackson.annotation.JsonIgnore;","+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;","+import com.fasterxml.jackson.databind.PropertyNamingStrategies;","+import com.fasterxml.jackson.databind.annotation.JsonNaming;","+import io.swagger.v3.oas.annotations.media.Schema;","+import jakarta.annotation.Nullable;","+import jakarta.validation.constraints.NotNull;","+import lombok.Builder;","+","+import java.time.Instant;","+import java.util.List;","+import java.util.UUID;","+","+/**","+ * A model has no status of its own: its state is its runs. Its serving run is its most recent COMPLETED one, null until","+ * one completes, which is what makes the model usable in a rule; its latest run is its most recent one, whose status","+ * the Models tab shows. The database row carries their ids; the services fill in the runs.","+ */","+@Builder(toBuilder = true)","+@JsonIgnoreProperties(ignoreUnknown = true)","+@JsonNaming(PropertyNamingStrategies.SnakeCaseStrategy.class)","+public record GuardrailModel(","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull UUID id,","+        @Schema(description = \"Unique in the workspace, ignoring case; never changes\") @NotNull String name,","+        @Schema(description = \"What the model flags: the question its adapter is trained and served on\") @NotNull String description,","+        @JsonIgnore UUID servingRunId,","+        @JsonIgnore UUID latestRunId,","+        @Schema(description = \"The run checks with the model are served by, its latest completed one; null until one completes, and a model without one cannot be used in a rule\", accessMode = Schema.AccessMode.READ_ONLY) @Nullable GuardrailTrainingRun servingRun,","+        @Schema(description = \"The model's latest run, whose status is the model's\", accessMode = Schema.AccessMode.READ_ONLY) @Nullable GuardrailTrainingRun latestRun,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull Instant createdAt,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull String createdBy,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull Instant lastUpdatedAt,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull String lastUpdatedBy) {","+","+    public static final int NAME_MAX_LENGTH = 255;","+    public static final int DESCRIPTION_MAX_LENGTH = 1000;","+","+    @Builder(toBuilder = true)","+    @JsonIgnoreProperties(ignoreUnknown = true)","+    @JsonNaming(PropertyNamingStrategies.SnakeCaseStrategy.class)","+    public record GuardrailModelPage(","+            List<GuardrailModel> content,","+            int page,","+            int size,","+            long total,","+            List<String> sortableBy) implements Page<GuardrailModel> {","+    }","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/GuardrailModelUpdate.java","lines":["@@ -0,0 +1,15 @@","+package com.comet.opik.api;","+","+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;","+import com.fasterxml.jackson.databind.PropertyNamingStrategies;","+import com.fasterxml.jackson.databind.annotation.JsonNaming;","+import jakarta.validation.constraints.NotBlank;","+import jakarta.validation.constraints.Size;","+import lombok.Builder;","+","+@Builder(toBuilder = true)","+@JsonIgnoreProperties(ignoreUnknown = true)","+@JsonNaming(PropertyNamingStrategies.SnakeCaseStrategy.class)","+public record GuardrailModelUpdate(","+        @NotBlank @Size(max = GuardrailModel.DESCRIPTION_MAX_LENGTH, message = \"cannot exceed {max} characters\") String description) {","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/GuardrailTrainingRun.java","lines":["@@ -0,0 +1,49 @@","+package com.comet.opik.api;","+","+import com.fasterxml.jackson.annotation.JsonIgnore;","+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;","+import com.fasterxml.jackson.databind.JsonNode;","+import com.fasterxml.jackson.databind.PropertyNamingStrategies;","+import com.fasterxml.jackson.databind.annotation.JsonNaming;","+import io.swagger.v3.oas.annotations.media.Schema;","+import jakarta.annotation.Nullable;","+import jakarta.validation.constraints.NotNull;","+import lombok.Builder;","+","+import java.time.Instant;","+import java.util.List;","+import java.util.UUID;","+","+/**","+ * One attempt to train a guardrail model. It carries its workspace because the run worker reads runs across","+ * workspaces and needs each run's workspace for its writes and its S3 keys. Neither the workspace nor the metadata,","+ * which holds opik-inference's job details, is part of the API. The API only returns runs, so every field it shows is","+ * read-only; OpenAPI marks properties, not schemas, so each field says so.","+ */","+@Builder(toBuilder = true)","+@JsonIgnoreProperties(ignoreUnknown = true)","+@JsonNaming(PropertyNamingStrategies.SnakeCaseStrategy.class)","+public record GuardrailTrainingRun(","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull UUID id,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull UUID modelId,","+        @JsonIgnore String workspaceId,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull GuardrailTrainingRunStatus status,","+        @Schema(description = \"Why the run ended failed or cancelled; null otherwise\", accessMode = Schema.AccessMode.READ_ONLY) @Nullable String statusMessage,","+        @Schema(description = \"Which attempt of one training the run is, 1 for the first\", accessMode = Schema.AccessMode.READ_ONLY) @NotNull int attempt,","+        @JsonIgnore JsonNode metadata,","+        @Schema(description = \"When the run reached completed, failed or cancelled; null while it is in flight\", accessMode = Schema.AccessMode.READ_ONLY) @Nullable Instant finishedAt,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull Instant createdAt,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull String createdBy,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull Instant lastUpdatedAt,","+        @Schema(accessMode = Schema.AccessMode.READ_ONLY) @NotNull String lastUpdatedBy) {","+","+    @Builder(toBuilder = true)","+    @JsonIgnoreProperties(ignoreUnknown = true)","+    @JsonNaming(PropertyNamingStrategies.SnakeCaseStrategy.class)","+    public record GuardrailTrainingRunPage(","+            List<GuardrailTrainingRun> content,","+            int page,","+            int size,","+            long total) implements Page<GuardrailTrainingRun> {","+    }","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/GuardrailTrainingRunStatus.java","lines":["@@ -0,0 +1,32 @@","+package com.comet.opik.api;","+","+import com.fasterxml.jackson.annotation.JsonCreator;","+import com.fasterxml.jackson.annotation.JsonValue;","+import lombok.Getter;","+import lombok.RequiredArgsConstructor;","+","+import java.util.Arrays;","+","+/** Spelled in lowercase in the API, like the other guardrail enums; MySQL stores the constant's name. */","+@Getter","+@RequiredArgsConstructor","+public enum GuardrailTrainingRunStatus {","+","+    QUEUED(\"queued\"),","+    RUNNING(\"running\"),","+    COMPLETED(\"completed\"),","+    FAILED(\"failed\"),","+    CANCELLED(\"cancelled\");","+","+    @JsonValue","+    private final String value;","+","+    @JsonCreator","+    public static GuardrailTrainingRunStatus fromString(String value) {","+        return Arrays.stream(values())","+                .filter(status -> status.value.equals(value))","+                .findFirst()","+                .orElseThrow(() -> new IllegalArgumentException(","+                        \"Unknown guardrail training run status '%s'\".formatted(value)));","+    }","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/resources/v1/priv/GuardrailModelsResource.java","lines":["@@ -0,0 +1,243 @@","+package com.comet.opik.api.resources.v1.priv;","+","+import com.codahale.metrics.annotation.Timed;","+import com.comet.opik.api.GuardrailModel;","+import com.comet.opik.api.GuardrailModel.GuardrailModelPage;","+import com.comet.opik.api.GuardrailModelUpdate;","+import com.comet.opik.api.GuardrailTrainingRun;","+import com.comet.opik.api.GuardrailTrainingRun.GuardrailTrainingRunPage;","+import com.comet.opik.api.GuardrailTrainingRunStatus;","+import com.comet.opik.api.error.ErrorMessage;","+import com.comet.opik.api.sorting.SortingFactoryGuardrailModels;","+import com.comet.opik.domain.GuardrailTrainingDataset;","+import com.comet.opik.domain.GuardrailsAccess;","+import com.comet.opik.infrastructure.FeatureFlags;","+import com.comet.opik.infrastructure.auth.RequiredPermissions;","+import com.comet.opik.infrastructure.auth.WorkspaceUserPermission;","+import com.comet.opik.infrastructure.ratelimit.RateLimited;","+import io.swagger.v3.oas.annotations.Operation;","+import io.swagger.v3.oas.annotations.headers.Header;","+import io.swagger.v3.oas.annotations.media.Content;","+import io.swagger.v3.oas.annotations.media.Schema;","+import io.swagger.v3.oas.annotations.parameters.RequestBody;","+import io.swagger.v3.oas.annotations.responses.ApiResponse;","+import io.swagger.v3.oas.annotations.tags.Tag;","+import jakarta.inject.Inject;","+import jakarta.validation.Valid;","+import jakarta.validation.constraints.Min;","+import jakarta.validation.constraints.NotBlank;","+import jakarta.validation.constraints.NotNull;","+import jakarta.validation.constraints.Size;","+import jakarta.ws.rs.Consumes;","+import jakarta.ws.rs.DELETE;","+import jakarta.ws.rs.DefaultValue;","+import jakarta.ws.rs.GET;","+import jakarta.ws.rs.PATCH;","+import jakarta.ws.rs.POST;","+import jakarta.ws.rs.Path;","+import jakarta.ws.rs.PathParam;","+import jakarta.ws.rs.Produces;","+import jakarta.ws.rs.QueryParam;","+import jakarta.ws.rs.ServerErrorException;","+import jakarta.ws.rs.core.MediaType;","+import jakarta.ws.rs.core.Response;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import org.glassfish.jersey.media.multipart.FormDataParam;","+","+import java.io.InputStream;","+import java.util.List;","+import java.util.UUID;","+","+/**","+ * The guardrail models a workspace trains on its own labelled data, and their training runs. Behind the training","+ * toggle and the same organization gate as every guardrails endpoint.","+ *","+ * <p>Training data arrives as a multipart JSONL file and is validated whole before anything is created.</p>","+ *","+ * <p>The services behind the endpoints are not wired in yet: past the gates and validation, every request is a 501","+ * until they are.</p>","+ */","+@Path(\"/v1/private/guardrails/models\")","+@Produces(MediaType.APPLICATION_JSON)","+@Consumes(MediaType.APPLICATION_JSON)","+@Timed","+@RequiredArgsConstructor(onConstructor_ = @Inject)","+@Tag(name = \"Guardrail models\", description = \"Guardrail models a workspace trains on its own labelled data\")","+public class GuardrailModelsResource {","+","+    private static final String FORBIDDEN = \"The caller lacks the workspace settings permission, or guardrail model training is not enabled for this deployment, or guardrails are not enabled for the workspace's organization\";","+    private static final String FORBIDDEN_READ = \"Guardrail model training is not enabled for this deployment, or guardrails are not enabled for the workspace's organization\";","+    private static final String UNAVAILABLE = \"Could not verify with the platform that guardrails are enabled for the workspace's organization; retry later\";","+    private static final String NOT_WIRED = \"Guardrail models are not available yet\";","+    // An annotation needs a constant, so the description gives the defaults; guardrailsTrainingDataset in config.yml sets","+    // the limits that apply.","+    private static final String FILE_DESCRIPTION = \"JSON Lines in UTF-8, one {\\\"text\\\": \\\"...\\\", \\\"label\\\": \\\"yes\\\" | \\\"no\\\"} object per line, yes meaning the text violates. The deployment sets the limits; by default 20 to 50,000 rows, at least 5 per label, up to 12,000 characters each, 50 MB\";","+","+    private final @NonNull GuardrailsAccess guardrailsAccess;","+    private final @NonNull GuardrailTrainingDataset trainingDataset;","+    private final @NonNull FeatureFlags featureFlags;","+    private final @NonNull SortingFactoryGuardrailModels sortingFactory;","+","+    @POST","+    @Consumes(MediaType.MULTIPART_FORM_DATA)","+    @Operation(operationId = \"createGuardrailModel\", summary = \"Create guardrail model\", description = \"Create a guardrail model and start its first training run from a labelled JSONL file\", responses = {","+            @ApiResponse(responseCode = \"201\", description = \"Created\", headers = {","+                    @Header(name = \"Location\", required = true, example = \"${basePath}/v1/private/guardrails/models/{id}\", schema = @Schema(implementation = String.class))}),","+            @ApiResponse(responseCode = \"400\", description = \"Bad Request: the training data's problems, each line's with its number\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"403\", description = FORBIDDEN, content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"409\", description = \"A model with this name already exists\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"429\", description = \"Too many requests\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"503\", description = UNAVAILABLE, content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class)))})","+    @RateLimited","+    @RequiredPermissions(WorkspaceUserPermission.WORKSPACE_SETTINGS_CONFIGURE)","+    public Response createGuardrailModel(","+            // Dropwizard reports a form field's violation as \"The request body ...\", without its name, so each message","+            // names its field.","+            @FormDataParam(\"name\") @NotBlank(message = \"name must not be blank\") @Size(max = GuardrailModel.NAME_MAX_LENGTH, message = \"name cannot exceed {max} characters\") String name,","+            @FormDataParam(\"description\") @NotBlank(message = \"description must not be blank\") @Size(max = GuardrailModel.DESCRIPTION_MAX_LENGTH, message = \"description cannot exceed {max} characters\") String description,","+            @FormDataParam(\"file\") @NotNull @Schema(description = FILE_DESCRIPTION) InputStream file) {","+        checkAccess();","+","+        trainingDataset.validate(file);","+        throw notWired();","+    }","+","+    @GET","+    @Operation(operationId = \"findGuardrailModels\", summary = \"Find guardrail models\", description = \"Find the workspace's guardrail models, each with its serving run and its latest run\", responses = {","+            @ApiResponse(responseCode = \"200\", description = \"Guardrail model page\", content = @Content(schema = @Schema(implementation = GuardrailModelPage.class))),","+            @ApiResponse(responseCode = \"403\", description = FORBIDDEN_READ, content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"503\", description = UNAVAILABLE, content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class)))})","+    public Response findGuardrailModels(","+            @QueryParam(\"page\") @Min(1) @DefaultValue(\"1\") int page,","+            @QueryParam(\"size\") @Min(1) @DefaultValue(\"10\") int size,","+            @QueryParam(\"name\") @Schema(description = \"Filter models by name (partial match, case insensitive)\") String name,","+            @QueryParam(\"usable_only\") @DefaultValue(\"false\") @Schema(description = \"Only the models with a serving run, the ones a rule can use\") boolean usableOnly,","+            @QueryParam(\"latest_run_status\") @Schema(description = \"Filter models by their latest run's status\") GuardrailTrainingRunStatus latestRunStatus,","+            @QueryParam(\"sorting\") String sorting) {","+        checkAccess();","+","+        sortingFactory.newSorting(sorting);","+        throw notWired();","+    }","+","+    @GET","+    @Path(\"/{id}\")","+    @Operation(operationId = \"getGuardrailModelById\", summary = \"Get guardrail model by id\", description = \"Get a guardrail model with its serving run and its latest run\", responses = {","+            @ApiResponse(responseCode = \"200\", description = \"Guardrail model\", content = @Content(schema = @Schema(implementation = GuardrailModel.class))),","+            @ApiResponse(responseCode = \"403\", description = FORBIDDEN_READ, content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"404\", description = \"Guardrail model not found\", content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class))),","+            @ApiResponse(responseCode = \"503\", description = UNAVAILABLE, content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class)))})","+    public Response getGuardrailModelById(@PathParam(\"id\") UUID id) {","+        checkAccess();","+","+        throw notWired();","+    }","+","+    @PATCH","+    @Path(\"/{id}\")","+    @Operation(operationId = \"updateGuardrailModel\", summary = \"Update guardrail model\", description = \"Update a guardrail model's description; its name never changes\", responses = {","+            @ApiResponse(responseCode = \"204\", description = \"No Content\"),","+            @ApiResponse(responseCode = \"403\", description = FORBIDDEN, content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"404\", description = \"Guardrail model not found\", content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class))),","+            @ApiResponse(responseCode = \"422\", description = \"Unprocessable Content\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"503\", description = UNAVAILABLE, content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class)))})","+    @RequiredPermissions(WorkspaceUserPermission.WORKSPACE_SETTINGS_CONFIGURE)","+    public Response updateGuardrailModel(@PathParam(\"id\") UUID id,","+            @RequestBody(content = @Content(schema = @Schema(implementation = GuardrailModelUpdate.class))) @NotNull @Valid GuardrailModelUpdate update) {","+        checkAccess();","+","+        throw notWired();","+    }","+","+    @DELETE","+    @Path(\"/{id}\")","+    @Operation(operationId = \"deleteGuardrailModel\", summary = \"Delete guardrail model\", description = \"Delete a guardrail model and its runs\", responses = {","+            @ApiResponse(responseCode = \"204\", description = \"No Content\"),","+            @ApiResponse(responseCode = \"403\", description = FORBIDDEN, content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"409\", description = \"A policy rule uses the model\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"503\", description = UNAVAILABLE, content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class)))})","+    @RequiredPermissions(WorkspaceUserPermission.WORKSPACE_SETTINGS_CONFIGURE)","+    public Response deleteGuardrailModel(@PathParam(\"id\") UUID id) {","+        checkAccess();","+","+        throw notWired();","+    }","+","+    @POST","+    @Path(\"/{id}/runs\")","+    @Consumes(MediaType.MULTIPART_FORM_DATA)","+    @Operation(operationId = \"retrainGuardrailModel\", summary = \"Retrain guardrail model\", description = \"Start a new training of the model from a labelled JSONL file; the serving run keeps serving until the new one completes\", responses = {","+            @ApiResponse(responseCode = \"201\", description = \"Created\", headers = {","+                    @Header(name = \"Location\", required = true, example = \"${basePath}/v1/private/guardrails/models/{id}/runs/{runId}\", schema = @Schema(implementation = String.class))}),","+            @ApiResponse(responseCode = \"400\", description = \"Bad Request: the training data's problems, each line's with its number\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"403\", description = FORBIDDEN, content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"404\", description = \"Guardrail model not found\", content = @Content(schema = @Schema(implementation = io.dropwizard.jersey.errors.ErrorMessage.class))),","+            @ApiResponse(responseCode = \"409\", description = \"The model has a run in flight\", content = @Content(schema = @Schema(implementation = ErrorMessage.class))),","+            @ApiResponse(responseCode = \"429\", description = \"Too many requests\", content = @Content(schema = @Schema(impl