{"id":"5ded3b30f61d3304ee7b3bc7d69253ed2ef073c2","axis":"silent","repo":"pnpm/pnpm","sha":"5ded3b30f61d3304ee7b3bc7d69253ed2ef073c2","parsed":{"files":[{"path":".changeset/defer-command-manifest-creation.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Commands that do not write the project manifest now leave a missing `package.json` absent. This covers queries such as `pnpm why` and `pnpm outdated`, `pnpm fetch`, `pnpm dedupe --check`, and commands that exit with an error, such as `pnpm rt ls`. These commands used to create one from the initialization template. `pnpm sbom` run from a lockfile alone now reports the root component as `unknown` with version `0.0.0` [pnpm/pnpm#16907](https://github.com/pnpm/pnpm/issues/16907)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install.rs","lines":["@@ -230,7 +230,7 @@ impl InstallArgs {"," ","     async fn run_inner<Reporter: self::Reporter + 'static>(","         self,","-        state: State,","+        mut state: State,","         selection: Option<InstallFamilySelection>,","     ) -> miette::Result<()> {","         state.http_client.set_warning_handler(pnpm_reporter::emit_global_warning::<Reporter>);","@@ -241,15 +241,17 @@ impl InstallArgs {","             return Err(DryRunIncompatibleWithPnpr.into());","         }","         if let Some(target) = pnpr_target::<Reporter>(&state, &link).await? {","-            return Box::pin(install_via_pnpr_inner::<Reporter>(","-                &state,","-                target,","-                selection.as_ref(),","-                link,","-            ))","-            .await;","+            Box::pin(install_via_pnpr_inner::<Reporter>(&state, target, selection.as_ref(), link))","+                .await?;","+        } else {","+            self.run_local::<Reporter>(&state, link, selection.as_ref()).await?;","+        }","+        if !self.materialization.dry_run","+            && state.config.workspace_dir.is_none()","+            && !state.manifest.path().exists()","+        {","+            state.manifest.save().wrap_err(\"saving initialized package.json\")?;","         }","-        self.run_local::<Reporter>(&state, link, selection.as_ref()).await?;","         // Resolution watch senders must close inline; only inert manifest and lockfile data","         // may outlive the command through background destruction.","         pnpm_fs::background_drop((state.lockfile, state.manifest, selection));"],"additions":11,"deletions":9,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/link.rs","lines":["@@ -82,7 +82,8 @@ impl LinkArgs {","             .ok_or_else(|| miette::miette!(\"manifest path has no parent directory\"))?","             .to_path_buf();"," ","-        let mut manifest = PackageManifest::create_if_needed(manifest_path.clone())","+        // A missing manifest is saved only after every link target resolved.","+        let mut manifest = PackageManifest::load_or_init(manifest_path.clone())","             .wrap_err(\"reading the project package.json\")?;"," ","         let root_dir = config.workspace_dir.clone().unwrap_or_else(|| manifest_dir.clone());"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/rebuild.rs","lines":["@@ -9,7 +9,7 @@ use miette::{Context, IntoDiagnostic};"," use pnpm_config::Config;"," use pnpm_modules_yaml::{Host, read_modules_layout, read_modules_manifest};"," use pnpm_package_manager::{ProjectMutation, RebuildOptions, allow_build_key_from_ignored_build};","-use pnpm_package_manifest::DependencyGroup;","+use pnpm_package_manifest::{DependencyGroup, project_manifest_path};"," use pnpm_reporter::Reporter;"," use pnpm_workspace_task_scheduler::{","     ScheduleGraphAsyncOptions, TaskCompletion, schedule_graph_async,","@@ -44,7 +44,7 @@ impl RebuildArgs {","         state: State,","         workspace_selection: Option<InstallFamilySelection>,","     ) -> miette::Result<()> {","-        let selection = resolve_selection(&self.packages, self.pending, state.config)?;","+        let selection = resolve_selection(&self.packages, self.pending, &state)?;","         run_rebuild::<Reporter>(&state, selection, workspace_selection).await","     }"," ","@@ -150,17 +150,16 @@ pub(crate) struct RebuildSelection {"," /// otherwise every build-needing package."," ///"," /// A `pendingBuilds` record is a dep path for a dependency and an","-/// importer id for a workspace project, and both are plain strings on","-/// disk. They are told apart by whether the entry resolves to a","-/// directory with a manifest, which is what an importer id means —","-/// asking the string's shape instead would misread a workspace","-/// directory named `foo@1.0.0` as a dependency and then drop its debt","-/// without running anything.","+/// importer id for a project, and both are plain strings on disk. They","+/// are told apart by [`pending_entry_is_project`] — asking the string's","+/// shape instead would misread a workspace directory named `foo@1.0.0`","+/// as a dependency and then drop its debt without running anything."," fn resolve_selection(","     packages: &[String],","     pending: bool,","-    config: &Config,","+    state: &State,"," ) -> miette::Result<RebuildSelection> {","+    let config = state.config;","     if !packages.is_empty() {","         return Ok(RebuildSelection { names: Some(packages.to_vec()), projects: Vec::new() });","     }","@@ -172,21 +171,11 @@ fn resolve_selection(","         return Ok(RebuildSelection { names: Some(Vec::new()), projects: Vec::new() });","     };","     let lockfile_dir = config.modules_dir_anchor().unwrap_or(&config.modules_dir);","-    // An importer id is always a relative path; a dep path can be","-    // absolute-looking (`/lodash@1.0.0`), and Rust's `Path::join`","-    // replaces the base on an absolute component, so probe only for","-    // relative entries — an absolute one is a dependency by construction.","-    let is_project = |entry: &String| {","-        !Path::new(entry).is_absolute()","-            && lockfile_dir","-                .join(entry)","-                .join(\"package.json\")","-                .is_file()","-    };","+    let active_importer_id = state.active_importer_id();","     let (projects, dep_paths): (Vec<&String>, Vec<&String>) = modules","         .pending_builds","         .iter()","-        .partition(|entry| is_project(entry));","+        .partition(|entry| pending_entry_is_project(lockfile_dir, &active_importer_id, entry));","     Ok(RebuildSelection {","         names: Some(","             dep_paths","@@ -198,6 +187,20 @@ fn resolve_selection(","     })"," }"," ","+/// Whether a `pendingBuilds` entry is an importer id: the active project,","+/// whose manifest may still be the in-memory scaffold of a project that","+/// has none on disk, or a directory with a manifest.","+///","+/// An importer id is always a relative path; a dep path can be","+/// absolute-looking (`/lodash@1.0.0`), and Rust's `Path::join` replaces","+/// the base on an absolute component, so only a relative entry is","+/// probed — an absolute one is a dependency by construction.","+fn pending_entry_is_project(lockfile_dir: &Path, active_importer_id: &str, entry: &str) -> bool {","+    !Path::new(entry).is_absolute()","+        && (entry == active_importer_id","+            || project_manifest_path(&lockfile_dir.join(entry)).is_file())","+}","+"," /// Drive a forced rebuild of the selected packages (or every build-needing"," /// package when `selected_names` is `None`) through the frozen-install"," /// pipeline. Shared by `pacquet rebuild` and the rebuild step of"],"additions":24,"deletions":21,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/sbom/collection.rs","lines":["@@ -219,7 +219,7 @@ fn read_sbom_manifests(","     filter_importer_ids: Option<&[&str]>,"," ) -> (serde_json::Value, Option<serde_json::Value>) {","     let fallback = |importer_id: &str| {","-        if state.active_importer_id() == importer_id {","+        if state.active_importer_id() == importer_id && state.manifest.path().exists() {","             state.manifest.value().clone()","         } else {","             serde_json::json!({})"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/state.rs","lines":["@@ -237,16 +237,19 @@ impl State {","     }"," }"," ","-/// `package.json` loads (or is scaffolded) as usual, but when it is","-/// absent an existing alternate manifest base name (`package.yaml`)","-/// must be loaded rather than shadowed by a scaffolded `package.json`","-/// and saved in its original format.","+/// `package.json` loads as usual, but when it is absent an existing","+/// alternate manifest base name (`package.yaml`) must be loaded rather","+/// than shadowed by a scaffolded `package.json` and saved in its","+/// original format.","+///","+/// A missing manifest is never written here: command initialization","+/// precedes argument validation and serves read-only commands, so the","+/// scaffold stays in memory until a command that writes the manifest","+/// (`install`, `add`, `link`) saves it."," ///"," /// Inside a workspace, a missing root manifest is tolerated rather"," /// than scaffolded: pnpm installs such a workspace with no root","-/// importer and never creates a `package.json` there, so the stand-in","-/// manifest stays in memory only. Commands that save the manifest","-/// (`add`) still persist it through their explicit save.","+/// importer and never creates a `package.json` there."," fn load_or_create_manifest(","     manifest_path: PathBuf,","     config: &Config,","@@ -266,7 +269,7 @@ fn load_or_create_manifest(","         }","     }","     manifest_path","-        .pipe(PackageManifest::create_if_needed)","+        .pipe(PackageManifest::load_or_init)","         .map(|manifest| apply_runtime_on_fail(manifest, config))","         .map_err(InitStateError::Manifest)"," }"],"additions":11,"deletions":8,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -104,6 +104,7 @@ mod lockfile_verification;"," mod login;"," mod loglevel;"," mod logout;","+mod manifest_creation;"," mod minimum_release_age;"," mod modules_dir;"," mod modules_dir_with_subdirectory;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/manifest_creation.rs","lines":["@@ -0,0 +1,388 @@","+use assert_cmd::prelude::*;","+use pnpm_testing_utils::{bin::CommandTempCwd, command_env::CommandTestExt};","+use serde_json::Value;","+use std::{env, fs, process::Command};","+","+fn fixture() -> CommandTempCwd<()> {","+    let mut fixture = CommandTempCwd::init();","+    fixture.pacquet","+        .env(\"PNPM_CONFIG_STORE_DIR\", fixture.root.path().join(\"store\"))","+        .env(\"PNPM_CONFIG_CACHE_DIR\", fixture.root.path().join(\"cache\"));","+    fixture","+}","+","+const LOCKFILE: &str = \"lockfileVersion: '9.0'\\nsettings:\\n  autoInstallPeers: true\\n  excludeLinksFromLockfile: false\\nimporters:\\n  .: {}\\n\";","+","+#[test]","+fn queries_do_not_create_a_manifest() {","+    for args in [&[\"why\", \"foo\"][..], &[\"outdated\"]] {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+        pacquet.args(args).assert().success();","+        assert!(!workspace.join(\"package.json\").exists(), \"{args:?} created a manifest\");","+        drop(root);","+    }","+}","+","+#[test]","+fn rejected_commands_do_not_create_a_manifest() {","+    let cases: &[(&[&str], &str)] = &[","+        (&[\"rt\", \"ls\"], \"ERR_PNPM_RUNTIME_UNKNOWN_SUBCOMMAND\"),","+        (&[\"rt\"], \"ERR_PNPM_RUNTIME_NO_SUBCOMMAND\"),","+        (&[\"rt\", \"set\"], \"ERR_PNPM_MISSING_RUNTIME_NAME\"),","+        (&[\"rt\", \"set\", \"python\"], \"ERR_PNPM_INVALID_RUNTIME_NAME\"),","+        (&[\"audit\"], \"ERR_PNPM_AUDIT_NO_LOCKFILE\"),","+        (&[\"sbom\", \"--sbom-format\", \"cyclonedx\"], \"ERR_PNPM_SBOM_NO_LOCKFILE\"),","+        (&[\"import\"], \"ERR_PNPM_LOCKFILE_NOT_FOUND\"),","+        (&[\"patch\"], \"ERR_PNPM_MISSING_PACKAGE_NAME\"),","+        (&[\"patch-commit\", \"./missing\"], \"ERR_PNPM_INVALID_PATCH_DIR\"),","+        (&[\"patch-remove\"], \"ERR_PNPM_NO_PATCHES_TO_REMOVE\"),","+        (&[\"remove\"], \"ERR_PNPM_MUST_REMOVE_SOMETHING\"),","+        (&[\"remove\", \"foo\"], \"ERR_PNPM_CANNOT_REMOVE_MISSING_DEPS\"),","+    ];","+    for (args, error) in cases {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+        let output = pacquet","+            .args(*args)","+            .assert()","+            .failure()","+            .get_output()","+            .stderr","+            .clone();","+        let stderr = String::from_utf8_lossy(&output);","+        assert!(stderr.contains(error), \"stderr: {stderr}\");","+        assert!(!workspace.join(\"package.json\").exists(), \"{args:?} created a manifest\");","+        drop(root);","+    }","+}","+","+#[test]","+fn dedupe_check_does_not_create_a_manifest() {","+    let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+    let output = pacquet","+        .args([\"dedupe\", \"--check\", \"--offline\"])","+        .assert()","+        .failure()","+        .get_output()","+        .stdout","+        .clone();","+    let stdout = String::from_utf8_lossy(&output);","+    assert!(stdout.contains(\"ERR_PNPM_DEDUPE_CHECK_ISSUES\"), \"stdout: {stdout}\");","+    assert!(!workspace.join(\"package.json\").exists(), \"dedupe --check created a manifest\");","+    assert!(!workspace.join(\"pnpm-lock.yaml\").exists(), \"dedupe --check left a lockfile\");","+    drop(root);","+}","+","+#[test]","+fn missing_link_target_does_not_create_a_manifest() {","+    for in_workspace in [false, true] {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+        if in_workspace {","+            fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages: []\\n\")","+                .expect(\"write rootless workspace\");","+        }","+        let output = pacquet","+            .args([\"link\", \"./missing\"])","+            .assert()","+            .failure()","+            .get_output()","+            .stderr","+            .clone();","+        let stderr = String::from_utf8_lossy(&output);","+        assert!(stderr.contains(\"missing\"), \"stderr: {stderr}\");","+        assert!(!workspace.join(\"package.json\").exists(), \"failed link created a manifest\");","+        drop(root);","+    }","+}","+","+#[test]","+fn fetch_from_a_lockfile_does_not_create_a_manifest() {","+    let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+    fs::write(workspace.join(\"pnpm-lock.yaml\"), LOCKFILE).expect(\"write lockfile\");","+    pacquet","+        .args([\"fetch\", \"--offline\"])","+        .assert()","+        .success();","+    assert!(!workspace.join(\"package.json\").exists(), \"fetch created a manifest\");","+    drop(root);","+}","+","+#[test]","+fn sbom_from_a_lockfile_does_not_invent_manifest_metadata() {","+    let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+    fs::write(workspace.join(\"pnpm-lock.yaml\"), LOCKFILE).expect(\"write lockfile\");","+    let output = pacquet","+        .args([\"sbom\", \"--sbom-format\", \"cyclonedx\"])","+        .assert()","+        .success()","+        .get_output()","+        .stdout","+        .clone();","+    let sbom: Value = serde_json::from_slice(&output).expect(\"parse SBOM\");","+    let component = &sbom[\"metadata\"][\"component\"];","+    assert_eq!(component[\"name\"], \"unknown\");","+    assert_eq!(component[\"version\"], \"0.0.0\");","+    assert!(component.get(\"licenses\").is_none(), \"invented license: {component}\");","+    assert!(!workspace.join(\"package.json\").exists(), \"sbom created a manifest\");","+    drop(root);","+}","+","+#[test]","+fn install_still_initializes_a_missing_manifest() {","+    let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+    pacquet","+        .args([\"install\", \"--offline\", \"--ignore-scripts\"])","+        .assert()","+        .success();","+    let manifest: Value = serde_json::from_slice(","+        &fs::read(workspace.join(\"package.json\")).expect(\"install wrote manifest\"),","+    )","+    .expect(\"parse manifest\");","+    assert_eq!(manifest[\"version\"], \"1.0.0\");","+    assert_eq!(manifest[\"license\"], \"ISC\");","+    drop(root);","+}","+","+#[test]","+fn queries_preserve_existing_manifest_formats() {","+    for (name, contents) in [","+        (\"package.json\", \"{\\\"name\\\":\\\"existing\\\",\\\"private\\\":true}\\n\"),","+        (\"package.json5\", \"{name: 'existing', private: true}\\n\"),","+        (\"package.yaml\", \"name: existing\\nprivate: true\\n\"),","+    ] {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = fixture();","+        fs::write(workspace.join(name), contents).expect(\"write manifest\");","+        pacquet","+            .args([\"why\", \"foo\"])","+            .assert()","+            .success();","+        assert_eq!(fs::read_to_string(workspace.join(name)).unwrap(), contents);","+        if name != \"package.json\" {","+            assert!(!workspace.join(\"package.json\").exists(), \"query shadowed {name}\");","+        }","+        drop(root);","+    }","+}","+","+const NATIVE_COMMANDS: &[&[&str]] = &[","+    &[\"install\", \"--offline\"],","+    &[","+        \"install\",","+        \"--offline\",","+        \"--frozen-lockfile\",","+        \"--trust-lockfile\",","+        \"--pnpr-server\",","+        \"http://127.0.0.1:9\",","+    ],","+    &[\"update\", \"--offline\"],","+    &[\"update\", \"--offline\", \"--no-save\"],","+    &[\"update\", \"--offline\", \"--patches\"],","+    &[\"dedupe\", \"--offline\"],","+    &[\"prune\"],","+];","+","+/// Substitute only the native compiler, leaving lifecycle dispatch and its","+/// error handling to the real CLI. The empty trusted lockfile needs no server.","+fn native_fixture(exit_code: i32) -> CommandTempCwd<()> {","+    let mut fixture = fixture();","+    let bin = fixture.root.path().join(\"bin\");","+    fs::create_dir(&bin).expect(\"create bin directory\");","+    fs::write(","+        bin.join(\"gyp.cjs\"),","+        format!(","+            \"require('fs').writeFileSync('native-marker', JSON.stringify({{args: process.argv.slice(2), version: process.env.npm_package_version}})); process.exit({exit_code});\",","+        ),","+    )","+    .expect(\"write native build substitute\");","+    #[cfg(unix)]","+    crate::_utils::write_executable(","+        &bin.join(\"node-gyp\"),","+        \"#!/bin/sh\\nexec node \\\"$(dirname \\\"$0\\\")/gyp.cjs\\\" \\\"$@\\\"\\n\",","+    );","+    #[cfg(windows)]","+    fs::write(bin.join(\"node-gyp.cmd\"), \"@node \\\"%~dp0gyp.cjs\\\" %*\\r\\n\")","+        .expect(\"write native build launcher\");","+    let path = env::join_paths(","+        std::iter::once(bin).chain(env::split_paths(&env::var_os(\"PATH\").unwrap_or_default())),","+    )","+    .expect(\"join PATH\");","+    fixture.pacquet.env(\"PATH\", path);","+    fs::write(fixture.workspace.join(\"binding.gyp\"), \"{}\").expect(\"write binding.gyp\");","+    fs::write(fixture.workspace.join(\"pnpm-lock.yaml\"), LOCKFILE).expect(\"write lockfile\");","+    fixture","+}","+","+fn assert_native_build(args: &[&str], exit_code: i32, existing: bool, after_resolution: bool) {","+    let CommandTempCwd { mut pacquet, workspace, root, .. } = native_fixture(exit_code);","+    if existing {","+        fs::write(workspace.join(\"package.json\"), r#\"{\"version\":\"2.0.0\"}\"#)","+            .expect(\"write existing manifest\");","+    }","+    if after_resolution {","+        fs::remove_file(workspace.join(\"binding.gyp\")).expect(\"remove initial native trigger\");","+        fs::write(","+            workspace.join(\".pnpmfile.cjs\"),","+            \"exports.hooks = { afterAllResolved(lockfile) { require('fs').writeFileSync(require('path').join(__dirname, 'binding.gyp'), '{}'); return lockfile; } };\",","+        )","+        .expect(\"write native trigger hook\");","+    }","+    let result = pacquet.args(args).assert();","+    if exit_code == 0 {","+        result.success();","+    } else {","+        let result = result.failure();","+        let stderr = String::from_utf8_lossy(&result.get_output().stderr);","+        assert!(stderr.contains(\"ERR_PNPM_EXECUTOR_LIFECYCLE_SCRIPT_FAILED\"), \"{stderr}\");","+        assert!(stderr.contains(\"17\"), \"{stderr}\");","+    }","+    let marker: Value = serde_json::from_slice(","+        &fs::read(workspace.join(\"native-marker\")).expect(\"native build ran\"),","+    )","+    .expect(\"parse native marker\");","+    assert_eq!(marker[\"args\"], serde_json::json!([\"rebuild\"]), \"{args:?}\");","+    assert_eq!(marker[\"version\"], if existing { \"2.0.0\" } else { \"1.0.0\" });","+    drop(root);","+}","+","+#[test]","+fn native_build_runs_with_initialized_manifest_data() {","+    for args in NATIVE_COMMANDS {","+        assert_native_build(args, 0, false, false);","+        assert_native_build(args, 0, true, false);","+    }","+}","+","+#[test]","+fn native_build_failure_is_propagated() {","+    for args in NATIVE_COMMANDS {","+        assert_native_build(args, 17, false, false);","+        assert_native_build(args, 17, true, false);","+    }","+}","+","+#[test]","+fn native_build_runs_after_resolution_creates_trigger() {","+    let commands: &[&[&str]] = &[","+        &[\"install\", \"--offline\", \"--no-frozen-lockfile\", \"--no-prefer-frozen-lockfile\"],","+        &[\"install\", \"--offline\", \"--pnpr-server\", \"http://127.0.0.1:9\"],","+        &[\"update\", \"--offline\"],","+        &[\"update\", \"--offline\", \"--no-save\"],","+        &[\"update\", \"--offline\", \"--patches\"],","+        &[\"update\", \"--offline\", \"--patches\", \"--pnpr-server\", \"http://127.0.0.1:9\"],","+        &[\"dedupe\", \"--offline\"],","+        &[\"prune\", \"--offline\"],","+    ];","+    for args in commands {","+        for exit_code in [0, 17] {","+            assert_native_build(args, exit_code, false, true);","+            assert_native_build(args, exit_code, true, true);","+        }","+    }","+}","+","+#[test]","+fn native_build_respects_ignore_scripts() {","+    for args in NATIVE_COMMANDS {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = native_fixture(17);","+        pacquet","+            .arg(\"--ignore-scripts\")","+            .args(*args)","+            .assert()","+            .success();","+        assert!(!workspace.join(\"native-marker\").exists(), \"{args:?} ran a native build\");","+        if args[0] != \"install\" {","+            assert!(!workspace.join(\"package.json\").exists(), \"{args:?} created a manifest\");","+        }","+        drop(root);","+    }","+}","+","+#[test]","+fn native_build_keeps_rootless_workspace_behavior() {","+    for args in NATIVE_COMMANDS {","+        let CommandTempCwd { mut pacquet, workspace, root, .. } = native_fixture(17);","+        fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages: []\\n\")","+            .expect(\"write rootless workspace\");","+        pacquet.args(*args).assert().success();","+        assert!(!workspace.join(\"native-marker\").exists(), \"{args:?} ran a native build\");","+        assert!(!workspace.join(\"package.json\").exists(), \"{args:?} created a manifest\");","+        drop(root);","+    }","+}","+","+#[test]","+fn native_build_is_skipped_when_not_materializing() {","+    for args in [","+        &[\"install\", \"--offline\", \"--dry-run\"][..],","+        &[\"install\", \"--offline\", \"--lockfile-only\"],","+        &[\"update\", \"--offline\", \"--lockfile-only\"],","+        &[\"update\", \"--offline\", \"--latest\"],","+        &[\"update\", \"--offline\", \"missing\"],","+        &[\"rebuild\"],","+        &[\"rebuild\", \"--pending\"],","+        &[\"dedupe\", \"--offline\", \"--lockfile-only