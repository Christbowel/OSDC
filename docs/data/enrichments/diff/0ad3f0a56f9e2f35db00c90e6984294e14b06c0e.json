block at","+\t// all and the exporter has not opted in to Phase 2 of the batching","+\t// migration RFC. See sendingQueueOptOutEnvVar.","+\timplicit bool","+}","+","+// sendingQueueOptOutEnvVar flips the implicit (undeclared) sending_queue","+// default from \"omitted\" (opt-in, the default) to \"default\" (opt-out). Set","+// it while auditing a repository's exporters one by one, so that generated","+// code and documentation materialize for every exporter without hand-editing","+// every metadata.yaml first. This will become the permanent, hardcoded","+// behavior at the end of Phase 2 of the batching migration RFC","+// (docs/rfcs/batching-migration.md), at which point this flag will be","+// removed.","+const sendingQueueOptOutEnvVar = \"MDATAGEN_SENDING_QUEUE_OPT_OUT\"","+","+func sendingQueueOptOut() bool {","+\tv, ok := os.LookupEnv(sendingQueueOptOutEnvVar)","+\tif !ok {","+\t\treturn false","+\t}","+\toptOut, err := strconv.ParseBool(v)","+\treturn err == nil && optOut","+}","+","+// IsImplicit reports whether this SendingQueue was synthesized because","+// metadata.yaml declared no sending_queue block, as opposed to an explicit","+// `support: omitted` declaration.","+func (sq *SendingQueue) IsImplicit() bool {","+\treturn sq.implicit","+}","+","+type SendingQueueOverrides map[string]any","+","+type parsedSendingQueueOverrides struct {","+\tenabled             bool","+\tenabledPresent      bool","+\tqueue               map[string]any","+\tbatchPresent        bool","+\tbatchEnabled        bool","+\tbatchEnabledPresent bool","+\tbatchOverrides      map[string]any","+}","+","+// SendingQueueTemplateData contains values rendered by the sending queue template.","+type SendingQueueTemplateData struct {","+\tQueueEnabled       bool","+\tWaitForResult      bool","+\tQueueSizer         string","+\tQueueSizerValue    string","+\tQueueSize          int64","+\tBlockOnOverflow    bool","+\tStorageConstructor string","+\tStorageValue       string","+\tNumConsumers      