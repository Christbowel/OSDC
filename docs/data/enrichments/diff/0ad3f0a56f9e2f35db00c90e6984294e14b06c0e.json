, \"func TestComponentDefaultQueueBatchSender(\")","+\trequire.Contains(t, string(generated), \"require.NotEqual(t, optionalQueueType, fieldType.Type\")","+\trequire.Contains(t, string(generated), \"require.NotEqual(t, queueType, fieldType.Type\")","+\trequire.NotContains(t, string(generated), \"internalmetadata.NewDefaultSendingQueueConfig()\")","+}","+","+func TestGenerateSendingQueueNestedBatchOverrides(t *testing.T) {","+\tmd := Metadata{","+\t\tType:   \"test\",","+\t\tStatus: &Status{Class: \"exporter\"},","+\t\tSendingQueue: &SendingQueue{","+\t\t\tSupport: SendingQueueSupportHasOverrides,","+\t\t\tOverrides: SendingQueueOverrides{","+\t\t\t\t\"enabled\": false,","+\t\t\t\t\"batch\": map[string]any{","+\t\t\t\t\t\"enabled\":  false,","+\t\t\t\t\t\"min_size\": int64(123),","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t}","+","+\tgenerated, err := executeTemplate(","+\t\t\"templates/status.go.tmpl\",","+\t\tmd,","+\t\t\"metadata\",","+\t\t\"go.opentelemetry.io/collector\",","+\t\tgetTemplateFuncMap(md, \"go.opentelemetry.io/collector\"),","+\t)","+\trequire.NoError(t, err)","+\t_, err = parser.ParseFile(token.NewFileSet(), \"generated_status.go\", generated, parser.AllErrors)","+\trequire.NoError(t, err)","+\trequire.NotContains(t, string(generated), \"confmap\")","+\trequire.NotContains(t, string(generated), \"panic(\")","+\trequire.Contains(t, string(generated), \"cfg := exporterhelper.NewDefaultQueueConfig()\")","+\trequire.Contains(t, string(generated), \"batchCfg.MinSize = 123\")","+\trequire.NotContains(t, string(generated), \"cfg.QueueSize =\")","+\trequire.Contains(t, string(generated), \"cfg.Batch = configoptional.Default(batchCfg)\")","+\trequire.Contains(t, string(generated), \"return configoptional.Default(cfg)\")","+}","+","+func TestGenerateSendingQueueDefaultFollowsFeatureGate(t *testing.T) {","+\tmd := Metadata{","+\t\tType:         \"test\",","+\t\tStatus:       &Status{Class: \"exporter\"},","+\t\tSendingQueue: &SendingQueue{Support: SendingQueueSup