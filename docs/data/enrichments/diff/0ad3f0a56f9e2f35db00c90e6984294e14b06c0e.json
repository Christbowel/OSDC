 sending_queue.overrides: %w\", err)","+\t}","+\treturn nil","+}","+","+func (sq *SendingQueue) validateDeclaration() error {","+\tswitch sq.Support {","+\tcase SendingQueueSupportDefault:","+\t\tif len(sq.Overrides) != 0 {","+\t\t\treturn errors.New(\"sending_queue.overrides requires support to be has_overrides\")","+\t\t}","+\tcase SendingQueueSupportHasOverrides:","+\t\tif len(sq.Overrides) == 0 {","+\t\t\treturn errors.New(\"sending_queue.overrides is required when support is has_overrides\")","+\t\t}","+\tcase SendingQueueSupportOmitted:","+\t\tif sq.implicit {","+\t\t\t// Not an explicit declaration; no rationale or overrides to check.","+\t\t\treturn nil","+\t\t}","+\t\tvar errs error","+\t\tif strings.TrimSpace(sq.Rationale) == \"\" {","+\t\t\terrs = errors.Join(errs, errors.New(\"sending_queue.rationale is required when support is omitted\"))","+\t\t}","+\t\tif len(sq.Overrides) != 0 {","+\t\t\terrs = errors.Join(errs, errors.New(\"sending_queue.overrides cannot be set when support is omitted\"))","+\t\t}","+\t\treturn errs","+\tdefault:","+\t\treturn fmt.Errorf(\"sending_queue.support must be one of %q, %q, or %q\", SendingQueueSupportDefault, SendingQueueSupportHasOverrides, SendingQueueSupportOmitted)","+\t}","+","+\tparsed, err := sq.Overrides.parse()","+\tif err != nil {","+\t\treturn err","+\t}","+\tif sq.HasOverrides() {","+\t\tvar errs error","+\t\tif !parsed.enabledPresent {","+\t\t\terrs = errors.Join(errs, errors.New(\"sending_queue.overrides.enabled is required when support is has_overrides\"))","+\t\t}","+\t\tif !parsed.batchEnabledPresent {","+\t\t\terrs = errors.Join(errs, errors.New(\"sending_queue.overrides.batch.enabled is required when support is has_overrides\"))","+\t\t}","+\t\tif errs != nil {","+\t\t\treturn errs","+\t\t}","+\t}","+\tif !parsed.enabled && strings.TrimSpace(sq.Rationale) == \"\" {","+\t\treturn errors.New(\"sending_queue.rationale is required when overrides disable the queue\")","+\t}","+\treturn nil","+}","+","+func (