ack: (error: ?Object, path: ?string) => void, // flowlint-line unclear-type: off","+    options: LegacyObject,","+    callback: (error: ?LegacyObject, path: ?string) => void,","   ) => void;"," }"," "],"additions":4,"deletions":4,"truncated":false},{"path":"scripts/js-api/build-types/transforms/flow/__tests__/replaceLegacyObjectWithObject-test.js","lines":["@@ -0,0 +1,49 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ * @flow strict-local","+ * @format","+ */","+","+const replaceLegacyObjectWithObject = require('../replaceLegacyObjectWithObject');","+const {parse, print} = require('flow-transform');","+","+const prettierOptions = {parser: 'babel'};","+","+async function translate(code: string): Promise<string> {","+  const parsed = await parse(code);","+  const result = await replaceLegacyObjectWithObject(parsed);","+  return print(result.ast, result.mutatedCode, prettierOptions);","+}","+","+describe('replaceLegacyObjectWithObject', () => {","+  test('should replace LegacyObject with Object in return annotation', async () => {","+    const code = `function foo(): LegacyObject {}`;","+    const result = await translate(code);","+    expect(result).toMatchInlineSnapshot(`","+      \"function foo(): Object {}","+      \"","+    `);","+  });","+","+  test('should replace LegacyObject with Object in nullable union', async () => {","+    const code = `let foo: ?string | ?LegacyObject;`;","+    const result = await translate(code);","+    expect(result).toMatchInlineSnapshot(`","+      \"let foo: ?string | ?Object;","+      \"","+    `);","+  });","+","+  test('should replace LegacyObject with Object in type alias', async () => {","+    const code = `type Foo = LegacyObject;`;","+    const result = await translate(code);","+    expect(result).toMatchInlineSnapshot(`","+      \"type Foo = Object;","+      \""