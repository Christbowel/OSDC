Service indicesService = getIndicesService();","+        IndexService indexService = createIndex(\"test\", indexSettings(2, 0).build());","+        ShardId first = indexService.getShard(0).shardId();","+        ShardId second = indexService.getShard(1).shardId();","+        ShardId missing = new ShardId(\"missing\", \"_na_\", 0);","+        Map<ShardId, Long> totals = new HashMap<>();","+        TaskLoadAttribution.Target target = indicesService.searchLoad(List.of(first, second, missing), id -> totals.getOrDefault(id, 0L));","+","+        target.charge(100, System.nanoTime());","+        assertSearchLoad(indexService, 50, 50);","+        target.charge(100, System.nanoTime());","+        assertSearchLoad(indexService, 100, 100);","+","+        // the totals are read when the task completes","+        totals.put(first, 3L);","+        totals.put(second, 1L);","+        totals.put(missing, 10L);","+        target.charge(100, System.nanoTime());","+        assertSearchLoad(indexService, 175, 125);","+","+        // only the second shard returned more results","+        totals.put(second, 5L);","+        target.charge(100, System.nanoTime());","+        assertSearchLoad(indexService, 175, 225);","+","+        // no shard returned more results, as for the rest of the previous task","+        target.charge(80, System.nanoTime());","+        assertSearchLoad(indexService, 175, 305);","+    }","+","+    private static void assertSearchLoad(IndexService indexService, long first, long second) {","+        assertEquals(first, indexService.getShard(0).shardSearchStats().totalSearchLoadNanos());","+        assertEquals(second, indexService.getShard(1).shardSearchStats().totalSearchLoadNanos());","+    }","+","     public void testHasShardPredicate() {","         IndicesService indicesService = getIndicesService();","         var hasShardPredicate = indicesService.hasShardPredicate();"],"additions":43,"deletions":0,"truncated":false},{"path":"server/src/test/java/org/elasticsearch/search/stats/ShardSearchStatsTests.java","lines":["@@ -108,6 +108,34 @@ public void testChargingShardsKeepsAllTheTime() {","         assertEquals(nanos, shards.stream().mapToLong(ShardSearchStats::totalSearchLoadNanos).sum());","     }"," ","+    /**","+     * Time charged by weight is shared in proportion to the weights without losing any: a shard with no weight gets none,","+     * and the shards share it equally when they all have none.","+     */","+    public void testChargingShardsByWeight() {","+        SearchStatsSettings searchStatsSettings = new SearchStatsSettings(ClusterSettings.createBuiltInClusterSettings());","+        List<ShardSearchStats> shards = randomList(2, 5, () -> new ShardSearchStats(searchStatsSettings));","+        long[] weights = new long[shards.size()];","+        for (int i = 1; i < weights.length; i++) {","+            weights[i] = randomLongBetween(1, Long.MAX_VALUE / weights.length);","+        }","+        long nanos = randomLongBetween(0, TimeUnit.HOURS.toNanos(1));","+        ShardSearchStats.charge(List.of(), new long[0], nanos, System.nanoTime());","+        ShardSearchStats.charge(shards, weights, nanos, System.nanoTime());","+        assertEquals(nanos, shards.stream().mapToLong(ShardSearchStats::totalSearchLoadNanos).sum());","+        assertEquals(0, shards.get(0).totalSearchLoadNanos());","+        double totalWeight = Arrays.stream(weights).asDoubleStream().sum();","+        for (int i = 1; i < weights.length; i++) {","+            assertEquals(nanos * (weights[i] / totalWeight), shards.get(i).totalSearchLoadNanos(), 1.0);","+        }","+","+        List<ShardSearchStats> unweighted = randomList(1, 5, () -> new ShardSearchStats(searchStatsSettings));","+        ShardSearchStats.charge(unweighted, new long[unweighted.size()], nanos, System.nanoTime());","+        for (ShardSearchStats shard : unweighted) {","+            assertEquals(nanos / unweighted.size(), shard.totalSearchLoadNanos(), 1.0);","+        }","+    }","+