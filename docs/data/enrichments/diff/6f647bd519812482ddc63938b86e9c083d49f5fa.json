// https://github.com/WebKit/WebKit/blob/main/Source/WebKit/UIProcess/WebPageProxy.cpp","+\tinternal sealed class WebContentProcessReloader : IDisposable","+\t{","+\t\t// WebKit's resetRecentCrashCountDelay: a reload stays recent until a page has been loaded for this long.","+\t\tinternal static readonly TimeSpan RecentReloadInterval = TimeSpan.FromSeconds(30);","+","+\t\tprivate readonly BlazorWebViewHandler _handler;","+\t\tprivate readonly WKWebView _webView;","+","+\t\tprivate bool _hasReloadedRecently;","+\t\tprivate long? _lastNavigationFinishedTimestamp;","+\t\tprivate NSObject? _sceneWillEnterForegroundObserver;","+\t\tprivate IDisposable? _movedToWindowSubscription;","+\t\tprivate bool _isDisposed;","+","+\t\tpublic WebContentProcessReloader(BlazorWebViewHandler handler, WKWebView webView)","+\t\t{","+\t\t\t_handler = handler;","+\t\t\t_webView = webView;","+\t\t}","+","+\t\tprivate bool IsWaitingUntilVisible => _sceneWillEnterForegroundObserver is not null;","+","+\t\tpublic void ProcessTerminated()","+\t\t{","+\t\t\tif (_isDisposed)","+\t\t\t{","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\tif (IsVisible())","+\t\t\t{","+\t\t\t\tTryReload();","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\t// WebKit also waits until the page is visible, instead of starting a new web content process for a page","+\t\t\t// nobody sees.","+\t\t\t_handler.Logger.DeferringReloadAfterWebContentProcessTermination();","+\t\t\t_sceneWillEnterForegroundObserver ??= NSNotificationCenter.DefaultCenter.AddObserver(","+\t\t\t\tUIScene.WillEnterForegroundNotification, OnSceneWillEnterForeground);","+\t\t\tWaitForWindowIfNeeded();","+\t\t}","+","+\t\tpublic void NavigationStarted()","+\t\t{","+\t\t\t// Like WebKit, a new navigation replaces the pending reload: it starts a new web content process itself.","+\t\t\tStopWaitingUntilVisible();","+\t\t}","+","+\t\tpublic void NavigationFinished()","+\t\t{","+\t\t\tForgetRecentReloadIfExpired();","+\t\t\t_lastNavigationFinishedTimestamp = _handler.TimeProvider.GetTimestamp();","+\t\t}","+","+\t\tpublic void Dispose()","+\t\t{","+\t\t\t_isDisposed = true;","+\t\t\tStopWaitingUntilVisible();","+\t\t}","+","+\t\t// WebKit's PageClientImpl::isViewVisible on iOS: in a window whose scene is not in the background.","+\t\tprivate bool IsVisible()","+\t\t{","+\t\t\tvar window = _webView.Window;","+\t\t\tif (window is null)","+\t\t\t{","+\t\t\t\treturn false;","+\t\t\t}","+","+\t\t\tvar scene = window.WindowScene;","+\t\t\tif (scene is null)","+\t\t\t{","+\t\t\t\treturn true;","+\t\t\t}","+","+\t\t\treturn scene.ActivationState is not (UISceneActivationState.Background or UISceneActivationState.Unattached);","+\t\t}","+","+\t\tprivate void WaitForWindowIfNeeded()","+\t\t{","+\t\t\tif (_webView.Window is not null || _movedToWindowSubscription is not null)","+\t\t\t{","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\t_movedToWindowSubscription = _webView.OnLoaded(OnMovedToWindow);","+\t\t}","+","+\t\tprivate void OnMovedToWindow()","+\t\t{","+\t\t\t// OnLoaded removes its own observers before calling back.","+\t\t\t_movedToWindowSubscription = null;","+","+\t\t\t// In a window of a background scene, OnSceneWillEnterForeground reloads once the scene comes back.","+\t\t\tif (IsWaitingUntilVisible && IsVisible())","+\t\t\t{","+\t\t\t\tReloadNowThatItIsVisible();","+\t\t\t}","+\t\t}","+","+\t\tprivate void OnSceneWillEnterForeground(NSNotification notification)","+\t\t{","+\t\t\tvar window = _webView.Window;","+\t\t\tif (window is null)","+\t\t\t{","+\t\t\t\tWaitForWindowIfNeeded();","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\t// The scene is still in the background while this is posted, so its state cannot be checked yet.","+\t\t\tif (ReferenceEquals(notification.Object, window.WindowScene))","+\t\t\t{","+\t\t\t\tReloadNowThatItIsVisible();","+\t\t\t}","+\t\t}","+","+\t\tprivate void ReloadNowThatItIsVisible()","+\t\t{","+\t\t\tStopWaitingUntilVisible();","+\t\t\tTryReload();","+\t\t}","+","+\t\tprivate void StopWaitingUntilVisible()","+\t\t{","+\t\t\tif (_sceneWillEnterForegroundObserver is not null)","+\t\t\t{","+\t\t\t\tNSNotificationCenter.DefaultCenter.RemoveObserver(_sceneWillEnterForegroundObserver);","+\t\t\t\t_sceneWillEnterForegroundObserver = null;","+\t\t\t}","+","+\t\t\tif (_movedToWindowSubscription is not null)","+\t\t\t{","+\t\t\t\t_movedToWindowSubscription.Dispose();","+\t\t\t\t_movedToWindowSubscription = null;","+\t\t\t}","+\t\t}","+","+\t\tprivate void TryReload()","+\t\t{","+\t\t\tForgetRecentReloadIfExpired();","+","+\t\t\t// WebKit stops its timer that forgets the last reload here, and starts it again only once a page has loaded.","+\t\t\t_lastNavigationFinishedTimestamp = null;","+","+\t\t\tif (_hasReloadedRecently)","+\t\t\t{","+\t\t\t\t// WebKit skips one reload and then counts from zero again, so a later termination reloads the page again.","+\t\t\t\t_hasReloadedRecently = false;","+\t\t\t\t_handler.Logger.NotReloadingAfterWebContentProcessTermination(RecentReloadInterval);","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\t_hasReloadedRecently = true;","+\t\t\t_handler.Logger.ReloadingAfterWebContentProcessTermination();","+","+\t\t\t// The process ended before the first page was committed, so there is no page to reload. The page that was","+\t\t\t// being loaded is still the web view's URL, and WebKit loads that one again too.","+\t\t\tvar url = _webView.BackForwardList.CurrentItem is null ? _webView.Url : null;","+\t\t\tif (url is not null)","+\t\t\t{","+\t\t\t\tusing var request = new NSUrlRequest(url);","+\t\t\t\t_webView.LoadRequest(request);","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\t_webView.Reload();","+\t\t}","+","+\t\tprivate void ForgetRecentReloadIfExpired()","+\t\t{","+\t\t\tif (_lastNavigationFinishedTimestamp is not null","+\t\t\t\t&& _handler.TimeProvider.GetElapsedTime(_lastNavigationFinishedTimestamp.Value) >= RecentReloadInterval)","+\t\t\t{","+\t\t\t\t_hasReloadedRecently = false;","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":191,"deletions":0,"truncated":false},{"path":"src/BlazorWebView/src/SharedSource/Log.cs","lines":["@@ -67,4 +67,13 @@ internal static partial class Log"," "," \t[LoggerMessage(EventId = 19, Level = LogLevel.Error, Message = \"The StaticContentCacheControlProvider threw an exception for request '{requestUri}'. Falling back to the default Cache-Control header.\")]"," \tpublic static partial void StaticContentCacheControlProviderFailed(this ILogger logger, string requestUri, Exception exception);","+","+\t[LoggerMessage(EventId = 20, Level = LogLevel.Warning, Message = \"Reloading the page because its web content process ended. This starts the Blazor app again.\")]","+\tpublic static partial void ReloadingAfterWebContentProcessTermination(this ILogger logger);","+","+\t[LoggerMessage(EventId = 21, Level = LogLevel.Error, Message = \"The web content process ended again before the reloaded page had been loaded for {interval}. Not reloading it this time, to avoid a crash loop.\")]","+\tpublic static partial void NotReloadingAfterWebContentProcessTermination(this ILogger logger, TimeSpan interval);","+","+\t[LoggerMessage(EventId = 22, Level = LogLevel.Warning, Message = \"The web content process ended while the web view is not visible. The page is reloaded once it is visible again.\")]","+\tpublic static partial void DeferringReloadAfterWebContentProcessTermination(this ILogger logger);"," }"],"additions":9,"deletions":0,"truncated":false},{"path":"src/BlazorWebView/tests/DeviceTests/Elements/BlazorWebViewTests.ProcessTermination.iOS.cs","lines":["@@ -0,0 +1,300 @@","+#nullable enable","+","+using System;","+using System.Diagnostics;","+using System.Runtime.InteropServices;","+using System.Threading.Tasks;","+using Foundation;","+using Microsoft.AspNetCore.Components.WebView;","+using Microsoft.AspNetCore.Components.WebView.Maui;","+using Microsoft.Maui.Controls;","+using Microsoft.Maui.DeviceTests;","+using WebKit;","+using Xunit;","+","+namespace Microsoft.Maui.MauiBlazorWebView.DeviceTests.Elements;","+","+public partial class BlazorWebViewTests","+{","+\tconst string ReloadingEventName = \"ReloadingAfterWebContentProcessTermination\";","+\tconst string NotReloadingEventName = \"NotReloadingAfterWebContentProcessTermination\";","+\tconst string DeferringEventName = \"DeferringReloadAfterWebContentProcessTermination\";","+","+\t[Fact]","+\tpublic Task WebContentProcessTerminationRaisesProcessTerminatedAndReloadsVisiblePage()","+\t{","+\t\tvar testLoggerProvider = new TestLoggerProvider();","+\t\treturn RunBlazorStartupTest(async (handler, webView) =>","+\t\t{","+\t\t\tvar blazorWebView = Assert.IsAssignableFrom<BlazorWebView>(handler.VirtualView);","+\t\t\tvar terminated = new TaskCompletionSource<WebViewProcessTerminatedEventArgs>(TaskCreationOptions.RunContinuationsAsynchronously);","+\t\t\tvoid OnProcessTerminated(object? sender, WebViewProcessTerminatedEventArgs e) => terminated.TrySetResult(e);","+","+\t\t\tblazorWebView.ProcessTerminated += OnProcessTerminated;","+\t\t\ttry","+\t\t\t{","+\t\t\t\tawait webView.AttachAndRun(async () =>","+\t\t\t\t{","+\t\t\t\t\t// Changed by hand, so only a fresh page with a fresh Blazor render shows 'Static' again.","+\t\t\t\t\tawait WebViewHelpers.ExecuteScriptAsync(webView, \"document.getElementById('controlDiv').innerText = 'BeforeTermination'\");","+","+\t\t\t\t\tKillWebContentProcess(webView);","+","+\t\t\t\t\tvar args = await terminated.Task.WaitAsync(TimeSpan.FromSeconds(10));","+\t\t\t\t\tAssert.Same(webView, args.PlatformArgs?.Sender);","+\t\t\t\t\tawait WaitForControlDivAfterReload(webView, \"Static\");","+\t\t\t\t});","+","+\t\t\t\tvar events = testLoggerProvider.GetEvents();","+\t\t\t\tAssert.Single(events, e => e.EventId.Name == ReloadingEventName);","+\t\t\t\tAssert.DoesNotContain(events, e => e.EventId.Name == DeferringEventName);","+\t\t\t}","+\t\t\tfinally","+\t\t\t{","+\t\t\t\tblazorWebView.ProcessTerminated -= OnProcessTerminated;","+\t\t\t}","+\t\t}, testLoggerProvider);","+\t}","+","+\t[Fact]","+\tpublic Task WebContentProcessTerminationReloadsHiddenPageOnceItIsInAWindow()","+\t{","+\t\tvar testLoggerProvider = new TestLoggerProvider();","+\t\treturn RunBlazorStartupTest(async (handler, webView) =>","+\t\t{","+\t\t\tvar blazorWebView = Assert.IsAssignableFrom<BlazorWebView>(handler.VirtualView);","+\t\t\tvar terminated = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);","+\t\t\tvoid OnProcessTerminated(object? sender, WebViewProcessTerminatedEventArgs e) => terminated.TrySetResult();","+","+\t\t\tblazorWebView.ProcessTerminated += OnProcessTerminated;","+\t\t\ttry","+\t\t\t{","+\t\t\t\tawait WebViewHelpers.ExecuteScriptAsync(webView, \"document.getElementById('controlDiv').innerText = 'BeforeTermination'\");","+","+\t\t\t\t// The web view has not been added to a window, so nobody can see it.","+\t\t\t\tKillWebContentProcess(webView);","+\t\t\t\tawait terminated.Task.WaitAsync(TimeSpan.FromSeconds(10));","+","+\t\t\t\tvar events = testLoggerProvider.GetEvents();","+\t\t\t\tAssert.Single(events, e => e.EventId.Name == DeferringEventName);","+\t\t\t\tAssert.DoesNotContain(events, e => e.EventId.Name == ReloadingEventName);","+","+\t\t\t\tawait webView.AttachAndRun(() => WaitForControlDivAfterReload(webView, \"Static\"));","+","+\t\t\t\tAssert.Single(testLoggerProvider.GetEvents(), e => e.EventId.Name == ReloadingEventName);","+\t\t\t}","+\t\t\tfinally","+\t\t\t{","+\t\t\t\tblazorWebView.ProcessTerminated -= OnProcessTerminated;","+\t\t\t}","+\t\t}, testLoggerProvider);","+\t}","+","+\t[Fact]","+\tpublic Task WebContentProcessTerminationRightAfterReloadDoesNotReloadAgain()","+\t{","+\t\tvar testLoggerProvider = new TestLoggerProvider();","+\t\treturn RunBlazorStartupTest(async (handler, webView) =>","+\t\t{","+\t\t\t// Never advanced, so the second termination always comes less than 30 seconds after the reload.","+\t\t\thandler.TimeProvider = new ManualTimeProvider();","+","+\t\t\tvar blazorWebView = Assert.IsAssignableFrom<BlazorWebView>(handler.VirtualView);","+\t\t\tvar terminationCount = 0;","+\t\t\tvar secondTermination = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);","+\t\t\tvoid OnProcessTerminated(object? sender, WebViewProcessTerminatedEventArgs e)","+\t\t\t{","+\t\t\t\tif (++terminationCount == 2)","+\t\t\t\t{","+\t\t\t\t\tsecondTermination.TrySetResult();","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tblazorWebView.ProcessTerminated += OnProcessTerminated;","+\t\t\ttry","+\t\t\t{","+\t\t\t\tawait webView.AttachAndRun(async () =>","+\t\t\t\t{","+\t\t\t\t\tKillWebContentProcess(webView);","+\t\t\t\t\tawait WaitForControlDivAfterReload(webView, \"Static\");","+\t\t\t\t\tawait WaitForPageLoaded(webView);","+","+\t\t\t\t\tKillWebContentProcess(webView);","+\t\t\t\t\tawait secondTermination.Task.WaitAsync(TimeSpan.FromSeconds(10));","+\t\t\t\t});","+","+\t\t\t\tvar events = testLoggerProvider.GetEvents();","+\t\t\t\tAssert.Single(events, e => e.EventId.Name == ReloadingEventName);","+\t\t\t\tAssert.Single(events, e => e.EventId.Name == NotReloadingEventName);","+\t\t\t}","+\t\t\tfinally","+\t\t\t{","+\t\t\t\tblazorWebView.ProcessTerminated -= OnProcessTerminated;","+\t\t\t}","+\t\t}, testLoggerProvider);","+\t}","+","+\t[Fact]","+\tpublic Task WebContentProcessTerminationLongAfterReloadReloadsAgain()","+\t{","+\t\tvar testLoggerProvider = new TestLoggerProvider();","+\t\treturn RunBlazorStartupTest(async (handler, webView) =>","+\t\t{","+\t\t\tvar timeProvider = new ManualTimeProvider();","+\t\t\thandler.TimeProvider = timeProvider;","+","+\t\t\tvar blazorWebView = Assert.IsAssignableFrom<BlazorWebView>(handler.VirtualView);","+\t\t\tvar terminationCount = 0;","+\t\t\tvar secondTermination = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);","+\t\t\tvoid OnProcessTerminated(object? sender, WebViewProcessTerminatedEventArgs e)","+\t\t\t{","+\t\t\t\tif (++terminationCount == 2)","+\t\t\t\t{","+\t\t\t\t\tsecondTermination.TrySetResult();","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tblazorWebView.ProcessTerminated += OnProcessTerminated;","+\t\t\ttry","+\t\t\t{","+\t\t\t\tawait webView.AttachAndRun(async () =>","+\t\t\t\t{","+\t\t\t\t\tKillWebContentProcess(webView);","+\t\t\t\t\tawait WaitForControlDivAfterReload(webView, \"Static\");","+\t\t\t\t\tawait WaitForPageLoaded(webView);","+","+\t\t\t\t\ttimeProvider.Advance(WebContentProcessReloader.RecentReloadInterval);","+","+\t\t\t\t\tawait WebViewHelpers.ExecuteScriptAsync(webView, \"document.getElementById('controlDiv').innerText = 'BeforeTermination'\");","+\t\t\t\t\tKillWebContentProcess(webView);","+\t\t\t\t\tawait secondTermination.Task.WaitAsync(TimeSpan.FromSeconds(10));","+\t\t\t\t\tawait WaitForControlDivAfterReload(webView, \"Static\");","+\t\t\t\t});","+","+\t\t\t\tvar events = testLoggerProvider.GetEvents();","+\t\t\t\tAssert.Equal(2, Array.FindAll(events, e => e.EventId.Name == ReloadingEventName).Length);","+\t\t\t\tAssert.DoesNotContain(events, e => e.EventId.Name == NotReloadingEventName);","+\t\t\t}","+\t\t\tfinally","+\t\t\t{","+\t\t\t\tblazorWebView.ProcessTerminated -= OnProcessTerminated;","+\t\t\t}","+\t\t}, testLoggerProvider);","+\t}","+","+\t[Fact]","+\tpublic Task WebContentProcessTerminationBeforeFirstPageLoadsLoadsThatPageAgain()","+\t{","+\t\tvar testLoggerProvider = new TestLoggerProvider();","+\t\tBlazorWebView? blazorWebView = null;","+\t\tvar hasKilledWebContentProcess = false;","+\t\tvar hadPageAtTermination = true;","+","+\t\t// UrlLoading is raised while WebKit decides whether to start the first navigation, before anything is loaded.","+\t\t// It runs inside a WebKit callback, where a failed assertion would crash the test app, so the test body asserts.","+\t\tvoid OnUrlLoading(object? sender, UrlLoadingEventArgs e)","+\t\t{","+\t\t\tif (!hasKilledWebContentProcess && blazorWebView?.Handler?.PlatformView is WKWebView)","+\t\t\t{","+\t\t\t\thasKilledWebContentProcess = TryKillWebContentProcess((WKWebView)blazorWebView.Handler.PlatformView);","+\t\t\t}","+\t\t}","+","+\t\tvoid OnProcessTerminated(object? sender, WebViewProcessTerminatedEventArgs e) =>","+\t\t\thadPageAtTermination = ((WKWebView)e.PlatformArgs!.Sender).BackForwardList.CurrentItem is not null;","+","+\t\treturn RunBlazorStartupTest(","+\t\t\tasync (handler, webView) =>","+\t\t\t{","+\t\t\t\ttry","+\t\t\t\t{","+\t\t\t\t\tawait webView.AttachAndRun(() => WaitForControlDivAfterReload(webView, \"Static\"));","+","+\t\t\t\t\tAssert.True(hasKilledWebContentProcess);","+\t\t\t\t\tAssert.False(hadPageAtTermination, \"The web content process ended after the first page was loaded, so this test did not cover a termination with no page to reload.\");","+\t\t\t\t\tAssert.Single(testLoggerProvider.GetEvents(), e => e.EventId.Name == ReloadingEventName);","+\t\t\t\t}","+\t\t\t\tfinally","+\t\t\t\t{","+\t\t\t\t\tblazorWebView!.UrlLoading -= OnUrlLoading;","+\t\t\t\t\tblazorWebView.ProcessTerminated -= OnProcessTerminated;","+\t\t\t\t}","+\t\t\t},","+\t\t\ttestLoggerProvider,","+\t\t\twaitForReady: _ => Task.CompletedTask,","+\t\t\tconfigureBlazorWebView: bwv =>","+\t\t\t{","+\t\t\t\tblazorWebView = bwv;","+\t\t\t\tbwv.UrlLoading += OnUrlLoading;","+\t\t\t\tbwv.ProcessTerminated += OnProcessTerminated;","+\t\t\t});","+\t}","+","+\t// Ends the web content process the way the system does when it crashes or reclaims it.","+\t// _webProcessIdentifier is private WebKit API, used only by this test.","+\tstatic void KillWebContentProcess(WKWebView webView) =>","+\t\tAssert.True(TryKillWebContentProcess(webView), \"The web view has no web content process to end.\");","+","+\tstatic bool TryKillWebContentProcess(WKWebView webView)","+\t{","+\t\tvar pid = ((NSNumber)webView.ValueForKey(new NSString(\"_webProcessIdentifier\"))).Int32Value;","+\t\treturn pid > 0 && kill(pid, 9) == 0;","+\t}","+","+\t[DllImport(ObjCRuntime.Constants.libSystemLibrary, SetLastError = true)]","+\tstatic extern int kill(int pid, int signal);","+","+\t// WebViewHelpers.WaitForControlDiv gives up on the first script error, and scripts fail while the","+\t// page is being reloaded.","+\tstatic async Task WaitForControlDivAfterReload(WKWebView webView, string expectedValue)","+\t{","+\t\tvar stopwatch = Stopwatch.StartNew();","+\t\tstring? lastValue = null;","+\t\twhile (stopwatch.Elapsed < TimeSpan.FromSeconds(30))","+\t\t{","+\t\t\ttry","+\t\t\t{","+\t\t\t\tlastValue = await WebViewHelpers.ExecuteScriptAsync(webView,","+\t\t\t\t\t\"document.getElementById('controlDiv') === null ? null : document.getElementById('controlDiv').innerText\");","+\t\t\t\tif (lastValue == expectedValue)","+\t\t\t\t{","+\t\t\t\t\treturn;","+\t\t\t\t}","+\t\t\t}","+\t\t\tcatch (NSErrorException)","+\t\t\t{","+\t\t\t}","+","+\t\t\tawait Task.Delay(250);","+\t\t}","+","+\t\tthrow new TimeoutException($\"controlDiv never became '{expectedValue}' after the reload. Last value: '{lastValue}'.\");","+\t}","+","+\t// Blazor can render before the page finishes loading, and the 30 seconds after a reload only start counting once"],"additions":274,"deletions":0,"truncated":false}],"additions":592,"deletions":3,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-24T20:30:33.684293+00:00"}