{"id":"6f647bd519812482ddc63938b86e9c083d49f5fa","axis":"silent","repo":"dotnet/maui","sha":"6f647bd519812482ddc63938b86e9c083d49f5fa","parsed":{"files":[{"path":"src/BlazorWebView/src/Maui/BlazorWebView.cs","lines":["@@ -113,6 +113,19 @@ public string StartPath"," \t\t/// </summary>"," \t\tpublic event EventHandler<WebViewWebResourceRequestedEventArgs>? WebResourceRequested;"," ","+\t\t/// <summary>","+\t\t/// Raised when the process rendering the web content ends unexpectedly, for example because it crashed or the","+\t\t/// operating system reclaimed it. The page and the UI state of its components are lost.","+\t\t/// <para>","+\t\t/// Currently raised on iOS and Mac Catalyst. There the <see cref=\"BlazorWebView\"/> reloads the page after the","+\t\t/// event, which starts the Blazor app again, so a handler can save state it wants to restore. While the web view","+\t\t/// is not visible (it is not in a window, or its window is in the background), the reload waits until it is.","+\t\t/// If the process ends again before the reloaded page has been loaded for 30 seconds, the page is not reloaded","+\t\t/// that time, to avoid a crash loop.","+\t\t/// </para>","+\t\t/// </summary>","+\t\tpublic event EventHandler<WebViewProcessTerminatedEventArgs>? ProcessTerminated;","+"," \t\t/// <inheritdoc />"," #if ANDROID"," \t\t[System.Runtime.Versioning.SupportedOSPlatform(AndroidSupportedOSPlatformVersion)]","@@ -181,6 +194,24 @@ void IBlazorWebView.BlazorWebViewInitializing(BlazorWebViewInitializingEventArgs"," \t\tvoid IBlazorWebView.BlazorWebViewInitialized(BlazorWebViewInitializedEventArgs args) =>"," \t\t\tBlazorWebViewInitialized?.Invoke(this, args);"," ","+\t\t/// <inheritdoc />","+\t\tvoid IBlazorWebView.ProcessTerminated(WebProcessTerminatedEventArgs args)","+\t\t{","+#if ANDROID","+\t\t\tvar platformArgs = new PlatformWebViewProcessTerminatedEventArgs(args.Sender, args.RenderProcessGoneDetail);","+\t\t\tvar webViewProcessTerminatedEventArgs = new WebViewProcessTerm