 self.assertEqual(","+                args(\"cpp/test_api\", True, \"/reports\"),","+                [","+                    \"-p\",","+                    \"torch.testing._internal.torchci.plugin\",","+                    \"--torchci-report-prefix=/reports/cpp.test_api\",","+                ],","+            )","+            self.assertEqual(args(\"test_type_info\", False, None), [])","+            self.assertEqual(args(\"cpp/test_api\", True, None), [])","         with unittest.mock.patch.object(run_test_module, \"HAS_TORCHCI_REPORTS\", False):","-            self.assertEqual(args(\"/reports\"), [])","+            self.assertEqual(args(\"test_type_info\", False, \"/reports\"), [])","+","+","+# gtest's JSON test list (--gtest_list_tests --gtest_output=json:<file>), with the","+# fields gtest_identities reads.","+_GTEST_LISTING = {","+    \"testsuites\": [","+        {\"name\": \"ModulesTest\", \"testsuite\": [{\"name\": \"Linear\"}]},","+        {\"name\": \"TypedTest/0\", \"testsuite\": [{\"name\": \"Add\", \"type_param\": \"int\"}]},","+        {","+            \"name\": \"Inst/TypedPTest/1\",","+            \"testsuite\": [{\"name\": \"Add\", \"type_param\": \"float\"}],","+        },","+        # gtest doesn't check a custom type name generator's names.","+        {","+            \"name\": \"TypedTest/c10.Half\",","+            \"testsuite\": [{\"name\": \"Add\", \"type_param\": \"Half\"}],","+        },","+        {","+            \"name\": \"Inst/PrimeTest\",","+            \"testsuite\": [","+                {\"name\": \"Returns/0\", \"value_param\": \"2\"},","+                {\"name\": \"Returns/Small\", \"value_param\": \"3\"},","+            ],","+        },","+    ]","+}"," "," "," @unittest.skipIf(IS_WINDOWS, \"Skipping because doesn't work for windows\")","@@ -811,6 +872,61 @@ def test_run_test_survives_a_corrupt_cache(self) -> None:"," "," "," class TestReportHelpers(TestCase):","+    def test_gtest_identities(self) -> None:","+        def cpp(suite: str, case_name: str, declared_case_name: str) -> tuple:","+            return (\"cpp/test_api\", suite, case_name, \"cpp\", declared_case_name)","+","+        self.assertEqual(","+            torchci_report.gtest_identities(\"build/bin/test_api.exe\", _GTEST_LISTING),","+            {","+                \"ModulesTest.Linear\": cpp(\"ModulesTest\", \"Linear\", \"Linear\"),","+                \"TypedTest/0.Add\": cpp(\"TypedTest/0\", \"Add\", \"Add\"),","+                \"Inst/TypedPTest/1.Add\": cpp(\"Inst/TypedPTest/1\", \"Add\", \"Add\"),","+                \"TypedTest/c10.Half.Add\": cpp(\"TypedTest/c10.Half\", \"Add\", \"Add\"),","+                \"Inst/PrimeTest.Returns/0\": cpp(","+                    \"Inst/PrimeTest\", \"Returns/0\", \"Returns\"","+                ),","+                \"Inst/PrimeTest.Returns/Small\": cpp(","+                    \"Inst/PrimeTest\", \"Returns/Small\", \"Returns\"","+                ),","+            },","+        )","+","+    @unittest.skipIf(","+        importlib.util.find_spec(\"pytest_cpp\") is None, \"pytest-cpp isn't installed\"","+    )","+    def test_gtest_item_identity(self) -> None:","+        from pytest_cpp.boost import BoostTestFacade","+        from pytest_cpp.catch2 import Catch2Facade","+        from pytest_cpp.google import GoogleTestFacade","+        from pytest_cpp.plugin import CppItem","+","+        plugin = importlib.import_module(\"torch.testing._internal.torchci.plugin\")","+","+        def list_tests(args: list[str], **kwargs: Any) -> None:","+            listing = Path(args[-1].removeprefix(\"--gtest_output=json:\"))","+            listing.write_text(json.dumps(_GTEST_LISTING))","+","+        # identity reads only the item's binary, name and framework.","+        item = object.__new__(CppItem)","+        item.path, item.facade = Path(\"build/bin/test_api\"), GoogleTestFacade()","+        plugin._gtest_identities.cache_clear()","+        self.addCleanup(plugin._gtest_identities.cache_clear)","+        with unittest.mock.patch(\"subprocess.run\", side_effect=list_tests) as run:","+            item.name = \"TypedTest/c10.Half.Add\"","+            self.assertEqual(","+                plugin.identity(item),","+                (\"cpp/test_api\", \"TypedTest/c10.Half\", \"Add\", \"cpp\", \"Add\"),","+            )","+            item.name = \"Unlisted.Test\"","+            self.assertIsNone(plugin.identity(item))","+            # pytest-cpp's other frameworks don't have gtest's test list.","+            for facade in (BoostTestFacade(), Catch2Facade()):","+                item.facade = facade","+                self.assertIsNone(plugin.identity(item))","+        # Once per binary.","+        run.assert_called_once()","+","     def test_identity_survives_unwrap_errors(self):","         import pytest"," "],"additions":119,"deletions":3,"truncated":false},{"path":"test/torchci/testdata/xdist_report.py","lines":["@@ -0,0 +1,20 @@","+\"\"\"Tests run under xdist with -x (TestReportJsonl.test_xdist_maxfail): one kills","+its worker, and the last one fails.\"\"\"","+","+import os","+","+","+def test_before():","+    pass","+","+","+def test_crash():","+    os._exit(1)","+","+","+def test_after():","+    pass","+","+","+def test_fail_last():","+    raise AssertionError(\"expected failure\")"],"additions":20,"deletions":0,"truncated":false},{"path":"torch/testing/_internal/torchci/README.md","lines":["@@ -63,10 +63,10 @@ physical RAM; it is omitted where neither is available."," |---|---|---|"," | `type` | string | `\"run\"` |"," | `schema_version` | string | `\"0.1\"` |","-| `file` | string | Launched Python file |","-| `suite` | string | Innermost Python class |","+| `file` | string | Launched Python file, or `cpp/<binary>` |","+| `suite` | string | Innermost Python class or gtest suite |"," | `case_name` | string | Collected test name, including generated parameters |","-| `language` | string | `python` |","+| `language` | string | `python` or `cpp` |"," | `declared_case_name` | string | Source test name before generated device, dtype, op, or parameter suffixes |"," | `rerun_number` | int | Execution number within one process, starting at `0` |"," | `outcome` | string | `passed`, `failed`, `error`, `skipped`, `xfailed`, or `xpassed`; `crashed` or `timed_out` for a run recorded by `run_test.py` (below) |","@@ -77,7 +77,9 @@ physical RAM; it is omitted where neither is available."," "," Pytest reruns and flakefinder repeats within one process count up"," `rerun_number`. A test's subtests share its run line, and a failing subtest fails","-it.","+it. For a value-parameterized gtest, `declared_case_name` drops the `/<param>`","+suffix. A gtest whose process crashed is `failed`, with pytest-cpp's message, as in","+junit."," "," A test aliased under a longer name (`test_x_dynamic = TestX.test_x`) reports the"," original's `declared_case_name`, `test_x`."],"additions":6,"deletions":4,"truncated":false},{"path":"torch/testing/_internal/torchci/plugin.py","lines":["@@ -5,10 +5,13 @@"," from __future__ import annotations"," "," import contextlib","+import functools"," import inspect"," import json"," import os","+import subprocess"," import sys","+import tempfile"," import time"," import uuid"," from collections import Counter","@@ -68,8 +71,32 @@ def _guard() -> Iterator[None]:","         _disable(error)"," "," ","+def _is_gtest(item: pytest.Item) -> bool:","+    # pytest-cpp isn't a torch dependency, so check the item's module before","+    # importing it. Its Boost.Test and Catch2 items are CppItems too.","+    if not type(item).__module__.startswith(\"pytest_cpp.\"):","+        return False","+    from pytest_cpp.google import GoogleTestFacade","+","+    return isinstance(getattr(item, \"facade\", None), GoogleTestFacade)","+","+","+@functools.cache","+def _gtest_identities(binary: str) -> dict[str, report.TestId]:","+    # pytest-cpp parses gtest's plain-text test list; gtest's JSON test list has","+    # each test's suite and name as separate fields.","+    with tempfile.TemporaryDirectory(prefix=\"torchci-gtest-\") as tmp:","+        path = os.path.join(tmp, \"tests.json\")","+        args = [binary, \"--gtest_list_tests\", f\"--gtest_output=json:{path}\"]","+        subprocess.run(args, check=True, capture_output=True)","+        with open(path, encoding=\"utf-8\") as listing:","+            return report.gtest_identities(binary, json.load(listing))","+","+"," def identity(item: pytest.Item) -> report.TestId | None:","-    \"\"\"None for an item that isn't a Python test function.\"\"\"","+    \"\"\"None for an item that is neither a Python test function nor a gtest.\"\"\"","+    if _is_gtest(item):","+        return _gtest_identities(str(item.path)).get(item.name)","     if not isinstance(item, pytest.Function):","         return None","     # originalname drops pytest parameters. Unwrapping the function recovers the","@@ -229,9 +256,9 @@ def _finish(self, key: tuple[str, Any], run: _Run) -> None:","         # Cleared before the line is written: a process killed between the two","         # loses the run rather than recording it twice.","         self._publish(None)","-        # No identity: the item isn't a Python test function, its setup report never","-        # arrived (the attempt was interrupted), or, under xdist, the worker's writer","-        # turned itself off and its setup report came without one.","+        # No identity: the item is neither a Python test function nor a gtest, its","+        # setup report never arrived (the attempt was interrupted), or, under xdist,","+        # the worker's writer turned itself off and its setup report came without one.","         if self.file is not None and run.test is not None:","             record = report.run_record(","                 run.test,","@@ -249,6 +276,11 @@ def pytest_sessionfinish(self, session: Session) -> None:","         if _disabled:","             return","         with _guard():","+            # Under xdist, -x stops right after the final failing report, so that","+            # run's teardown report never arrives; its outcome is already known.","+            for key, run in list(self.runs.items()):","+                if run.failed_phase:","+                    self._finish(key, run)","             if self.file is not None:","                 self.file.close()","                 self.file = None"],"additions":36,"deletions":4,"truncated":false},{"path":"torch/testing/_internal/torchci/report.py","lines":["@@ -4,6 +4,7 @@"," "," import json"," import os","+from pathlib import Path"," from typing import Any, NamedTuple"," "," ","@@ -22,6 +23,24 @@ class TestId(NamedTuple):","     declared_case_name: str"," "," ","+def gtest_identities(binary: str, listing: dict[str, Any]) -> dict[str, TestId]:","+    \"\"\"Each test in a gtest binary's JSON test list, by its full name","+    ``<suite>.<test>``, which is also its pytest-cpp item's name.","+","+    gtest adds an instantiation's ``Prefix/`` and a typed suite's ``/<type>`` to","+    the suite, and a value-parameterized test's ``/<param>`` to the test name; the","+    declared name drops that ``/<param>``.\"\"\"","+    file = f\"cpp/{Path(binary).stem}\"","+    identities = {}","+    for suite in listing[\"testsuites\"]:","+        for test in suite[\"testsuite\"]:","+            suite_name, name = suite[\"name\"], test[\"name\"]","+            declared = name.partition(\"/\")[0] if \"value_param\" in test else name","+            test_id = TestId(file, suite_name, name, \"cpp\", declared)","+            identities[f\"{suite_name}.{name}\"] = test_id","+    return identities","+","+"," def report_path(prefix: str, report_uuid: str) -> str:","     \"\"\"``<prefix>-<uuid>.report.jsonl``.\"\"\"","     return f\"{prefix}-{report_uuid}{REPORT_SUFFIX}\"",""],"additions":19,"deletions":0,"truncated":false}],"additions":212,"deletions":15,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-16T14:19:35.145418+00:00"}