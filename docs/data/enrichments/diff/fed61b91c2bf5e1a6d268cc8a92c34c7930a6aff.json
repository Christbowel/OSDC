` reads only those. rspack","+    // doesn't emit the assets it keeps from the previous build.","+    compiler.hooks.assetEmitted.tap(PLUGIN_NAME, (file) => {","+      this.#emitted.add(file);","+    });","+    compiler.hooks.done.tap(PLUGIN_NAME, (stats) => {","+      const reload =","+        this.#record(stats.compilation) && !stats.compilation.errors.length;","+      const clients = this.#devServer?.webSocketServer?.clients;","+      if (reload && clients) {","+        this.#devServer?.sendMessage(clients, 'static-changed');","+      }","+    });","+  }","+","+  /** Whether a browser output outside the page's chunks changed. */","+  #record(compilation: Compilation): boolean {","+    const previous = this.#outputs;","+    const current = new Map<string, string>();","+    const browserFiles = classifyBrowserFiles(compilation);","+    let otherChanged = false;","+    for (const asset of compilation.getAssets()) {","+      if (asset.name.endsWith('.map') || asset.name.includes('.hot-update.')) {","+        continue;","+      }","+      const known = previous?.get(asset.name);","+      const digest =","+        known !== undefined && !this.#emitted.has(asset.name)","+          ? known","+          : createHash('sha1').update(asset.source.buffer()).digest('hex');","+      current.set(asset.name, digest);","+      if (","+        previous &&","+        known !== digest &&","+        !browserFiles.page.has(asset.name) &&","+        !browserFiles.runtime.has(asset.name)","+      ) {","+        otherChanged = true;","+      }","+    }","+    this.#outputs = current;","+    this.#emitted.clear();","+    return otherChanged;","+  }","+}","+","+/**","+ * Splits the chunk files of the page's runtimes into the ones the hot client","+ * updates and the runtime chunks, which change with the compilation hash on","+ * every rebuild. Files of other runtimes (web workers) and the files that","+ * chunks load (auxiliary files) are in neither set.","+ */","+function classifyBrowserFiles(compilation: Compilation): {","+  page: Set<string>;","+  runtime: Set<string>;","+} {","+  const pageRuntimes = new Set<string>();","+  for (const entrypoint of compilation.entrypoints.values()) {","+    for (const chunk of entrypoint.chunks) {","+      chunk.runtime.forEach((runtime) => pageRuntimes.add(runtime));","+    }","+  }","+  const page = new Set<string>();","+  const runtime = new Set<string>();","+  for (const chunk of compilation.chunks) {","+    if (![...chunk.runtime].every((name) => pageRuntimes.has(name))) {","+      continue;","+    }","+    const files =","+      chunk.hasRuntime() &&","+      compilation.chunkGraph.getChunkModules(chunk).length === 0","+        ? runtime","+        : page;","+    chunk.files.forEach((file) => files.add(file));","+  }","+  return { page, runtime };","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"packages/angular-rspack/src/lib/plugins/loaders/dev-client-guard.loader.spec.ts","lines":["@@ -0,0 +1,32 @@","+import type { LoaderContext } from '@rspack/core';","+import { describe, expect, it } from 'vitest';","+import devClientGuardLoader from './dev-client-guard.loader';","+","+describe('devClientGuardLoader', () => {","+  it.each([","+    [","+      '?protocol=ws%3A&port=4200',","+      '/dev-server/client/index.js?protocol=ws%3A&port=4200&ngrs-window-only',","+    ],","+    ['', '/dev-server/client/index.js?ngrs-window-only'],","+  ])(","+    'runs the dev-server entry with the query %j only where a document exists',","+    (resourceQuery, request) => {"],"additions":14,"deletions":0,"truncated":false}],"additions":459,"deletions":113,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-19T17:57:52.705944+00:00"}