{"id":"813cfbb42d34ac98c158eac3dda60398e93cddaa","axis":"silent","repo":"vercel/turbo","sha":"813cfbb42d34ac98c158eac3dda60398e93cddaa","parsed":{"files":[{"path":"crates/turborepo-cli/src/commands/setup.rs","lines":["@@ -10,6 +10,7 @@ use crate::cli::{Args, SetupArgs};"," #[cfg(all(test, target_os = \"macos\"))]"," mod acl;"," mod check;","+mod lock_diagnostics;"," mod no_lock;"," mod plan;"," mod provision;","@@ -64,6 +65,9 @@ pub enum Error {","     )]","     UnclassifiedLibc(turborepo_platform::LibcError),","     #[error(transparent)]","+    #[diagnostic(transparent)]","+    LockDiagnostics(#[from] lock_diagnostics::Error),","+    #[error(transparent)]","     SourcePolicy(#[from] turborepo_setup::source_policy::Error),","     #[error(transparent)]","     Activation(#[from] turborepo_setup::activation::Error),"],"additions":4,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/ci_tests.rs","lines":["@@ -0,0 +1,211 @@","+//! Fresh processes exercise real cached CI detection, parser, discovery,","+//! loopback resolution/provisioning and publication. Never mutate host env.","+use std::{path::Path, process::Command, time::SystemTime};","+","+use super::*;","+","+const CASE: &str = \"TURBO_SETUP_CI_FIXTURE_CASE\";","+","+fn process(case: &str, ci_variable: Option<&str>) {","+    let mut child = Command::new(std::env::current_exe().unwrap());","+    child","+        .env_clear()","+        .env(\"PATH\", std::env::var_os(\"PATH\").unwrap())","+        .env(\"GIT_CONFIG_NOSYSTEM\", \"1\")","+        .env(\"GIT_CONFIG_GLOBAL\", \"/dev/null\")","+        .env(CASE, case)","+        .args([","+            \"--exact\",","+            \"commands::setup::provisioning_tests::first_lock::ci::fixture_process\",","+            \"--nocapture\",","+        ]);","+    if let Some(variable) = ci_variable {","+        child.env(variable, \"1\");","+    }","+    let output = child.output().unwrap();","+    assert!(","+        output.status.success(),","+        \"{case}: {}\\n{}\",","+        String::from_utf8_lossy(&output.stdout),","+        String::from_utf8_lossy(&output.stderr)","+    );","+    assert!(","+        String::from_utf8_lossy(&output.stdout).contains(\"1 passed\"),","+        \"child filter did not run\"","+    );","+}","+","+#[test]","+fn ci_missing_lock_is_actionable_and_read_only() {","+    process(\"missing\", Some(\"CI\"));","+}","+#[test]","+fn ci_stale_lock_names_changed_and_removed_declarations() {","+    process(\"stale\", Some(\"BUILD_NUMBER\"));","+}","+#[test]","+fn ci_valid_lock_provisions_without_rewriting_locks() {","+    process(\"valid\", Some(\"CI\"));","+}","+#[test]","+fn local_setup_still_creates_lock() {","+    process(\"local\", None);","+}","+#[test]","+fn ci_no_frozen_creates_and_updates_lock() {","+    process(\"no-frozen\", Some(\"CI\"));","+}","+#[test]","+fn ci_refresh_requires_explicit_no_frozen() {","+    process(\"refresh\", Some(\"CI\"));","+}","+","+#[derive(Debug, PartialEq, Eq)]","+struct Entry(PathBuf, Vec<u8>, SystemTime, u32);","+fn state(root: &Path) -> Vec<Entry> {","+    super::super::publication_guards::state(root)","+        .into_iter()","+        .map(|(path, bytes)| {","+            let metadata = fs::symlink_metadata(&path).unwrap();","+            use std::os::unix::fs::MetadataExt;","+            Entry(path, bytes, metadata.modified().unwrap(), metadata.mode())","+        })","+        .collect()","+}","+fn text(error: Error) -> String {","+    format!(\"{:?}\", miette::Report::new(error)).replace([' ', '|', '\\n', '\\r'], \"\")","+}","+fn guidance(text: &str) {","+    assert!(text.contains(\"turbosetup--tools-only\"), \"{text}\");","+    assert!(text.contains(\"locally\"), \"{text}\");","+    assert!(","+        text.contains(\"committurbo.lock\") || text.contains(\"committheupdatedturbo.lock\"),","+        \"{text}\"","+    );","+}","+","+#[test]","+fn fixture_process() {","+    let Ok(case) = std::env::var(CASE) else {","+        return;","+    };","+    assert_eq!(turborepo_ci::is_ci(), case != \"local\");","+    match case.as_str() {","+        \"missing\" => {","+            let f = fresh();","+            let u = LoopbackServer::new(routes(&f, \"24.0.0\", \"10.0.0\"), |_| {}).unwrap();","+            let before = state(f.owned.root());","+            let message = text(f.run(&u, &[\"--tools-only\"]).unwrap_err());","+            assert!(","+                message.contains(\"frozenmoderequiresturbo.lock\"),","+                \"{message}\"","+            );","+            guidance(&message);","+            assert_eq!(u.hits(), 0);","+            assert_eq!(state(f.owned.root()), before);","+            untouched(&f);","+        }","+        \"stale\" => {","+            // Added, changed and removed provenance; declaration values remain","+            // syntactically valid so the frozen lock, not discovery, rejects it.","+            for change in [\"node\", \"manager\", \"removed\", \"added\"] {","+                let f = Fixture::new();","+                let (file, field) = match change {","+                    \"node\" => {","+                        fs::write(f.owned.root().join(\".nvmrc\"), \"24.x\\n\").unwrap();","+                        (\".nvmrc\", None)","+                    }","+                    \"manager\" => {","+                        fs::write(","+                            f.owned.root().join(\"package.json\"),","+                            r#\"{\"packageManager\":\"pnpm@10.1.0\"}\"#,","+                        )","+                        .unwrap();","+                        (\"package.json\", Some(\"/packageManager\"))","+                    }","+                    \"removed\" => {","+                        fs::remove_file(f.owned.root().join(\".nvmrc\")).unwrap();","+                        (\".nvmrc\", None)","+                    }","+                    _ => {","+                        fs::write(f.owned.root().join(\".node-version\"), \"24.0.0\\n\").unwrap();","+                        (\".node-version\", None)","+                    }","+                };","+                let u = Upstream::new(&f, false, None);","+                let before = state(f.owned.root());","+                let message = text(f.run(&u, &[\"--tools-only\"]).unwrap_err());","+                assert!(","+                    message.contains(\"turbo.lockdeclarationschanged\"),","+                    \"{message}\"","+                );","+                assert!(message.contains(file), \"{message}\");","+                if let Some(field) = field {","+                    assert!(message.contains(field), \"{message}\");","+                }","+                guidance(&message);","+                assert_eq!(u.hits(), 0);","+                assert_eq!(state(f.owned.root()), before);","+                f.no_execution();","+            }","+        }","+        \"valid\" => {","+            let f = Fixture::new();","+            let u = Upstream::new(&f, false, None);","+            let lock = f.owned.root().join(\"turbo.lock\");","+            let bytes = fs::read(&lock).unwrap();","+            let modified = fs::metadata(&lock).unwrap().modified().unwrap();","+            assert_eq!(f.run(&u, &[\"--tools-only\"]).unwrap(), 0);","+            assert_eq!(u.hits(), 3); // Node artifact + exact pnpm metadata/artifact; no resolution.","+            assert!(f.manifest().is_some());","+            assert_eq!(fs::read(&lock).unwrap(), bytes);","+            assert_eq!(fs::metadata(&lock).unwrap().modified().unwrap(), modified);","+            let before = state(f.owned.root());","+            assert_eq!(f.run(&u, &[\"--tools-only\"]).unwrap(), 0);","+            assert_eq!(u.hits(), 3);","+            assert_eq!(state(f.owned.root()), before);","+            f.no_execution();","+        }","+        \"local\" | \"no-frozen\" => {","+            let f = fresh();","+            let flags = if case == \"local\" {","+                &[\"--tools-only\"][..]","+            } else {","+                LOCAL","+            };","+            let u = LoopbackServer::new(routes(&f, \"24.0.0\", \"10.0.0\"), |_| {}).unwrap();","+            assert_eq!(f.run(&u, flags).unwrap(), 0);","+            assert_eq!(selected(&f).tools()[\"node\"].version, \"24.0.0\");","+            assert!(f.manifest().is_some());","+            untouched(&f);","+            if case == \"no-frozen\" {","+                fs::write(","+                    f.owned.root().join(\"package.json\"),","+                    r#\"{\"packageManager\":\"pnpm@10.1.0\"}\"#,","+                )","+                .unwrap();","+                let u = LoopbackServer::new(routes(&f, \"24.0.0\", \"10.1.0\"), |_| {}).unwrap();","+                assert_eq!(f.run(&u, flags).unwrap(), 0);","+                assert_eq!(selected(&f).tools()[\"pnpm\"].version, \"10.1.0\");","+                untouched(&f);","+            }","+        }","+        \"refresh\" => {","+            let f = fresh();","+            let u = LoopbackServer::new(routes(&f, \"24.0.0\", \"10.0.0\"), |_| {}).unwrap();","+            let before = state(f.owned.root());","+            let message = text(f.run(&u, &[\"--tools-only\", \"--update-lock\"]).unwrap_err());","+            assert!(message.contains(\"--no-frozen--update-lock\"), \"{message}\");","+            assert_eq!(state(f.owned.root()), before);","+            assert_eq!(u.hits(), 0);","+            assert_eq!(","+                f.run(&u, &[\"--tools-only\", \"--no-frozen\", \"--update-lock\"])","+                    .unwrap(),","+                0","+            );","+            assert!(f.owned.root().join(\"turbo.lock\").exists());","+            untouched(&f);","+        }","+        _ => panic!(\"unknown fixture case {case}\"),","+    }","+}"],"additions":211,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/first_lock.rs","lines":["@@ -4,6 +4,8 @@ use sha2::Sha512;"," use super::*;"," "," const LOCAL: &[&str] = &[\"--tools-only\", \"--no-frozen\"];","+#[path = \"ci_tests.rs\"]","+mod ci;"," #[path = \"no_lock_tests.rs\"]"," mod no_lock;"," #[path = \"refresh.rs\"]"],"additions":2,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/lock_diagnostics.rs","lines":["@@ -0,0 +1,61 @@","+//! Read-only lock diagnostics before transports, writers or installation state.","+use std::collections::BTreeSet;","+","+use miette::Diagnostic;","+use turborepo_setup::lock::{Lock, Snapshot};","+","+#[derive(Debug, thiserror::Error, Diagnostic)]","+pub enum Error {","+    #[error(\"frozen mode requires turbo.lock\")]","+    #[diagnostic(help(","+        \"Run `turbo setup --tools-only` locally and commit turbo.lock, then retry CI.\"","+    ))]","+    Missing,","+    #[error(\"turbo.lock declarations changed: {0}\")]","+    #[diagnostic(help(","+        \"Run `turbo setup --tools-only` locally and commit the updated turbo.lock, then retry CI.\"","+    ))]","+    Drift(String),","+}","+","+pub(super) fn matching(snapshot: &Snapshot, lock: &Lock) -> Result<(), super::Error> {","+    if lock.matches_native(snapshot.declarations())? {","+        return Ok(());","+    }","+    let mut changed = BTreeSet::new();","+    for id in snapshot.declarations().keys().chain(lock.tools().keys()) {","+        let current = snapshot","+            .declarations()","+            .get(id)","+            .map(Vec::as_slice)","+            .unwrap_or(&[]);","+        let previous = lock","+            .tools()","+            .get(id)","+            .map(|tool| tool.declarations.as_slice())","+            .unwrap_or(&[]);","+        // Provenance is a set. Include both added and removed locations, so","+        // removing a declaration still names the original file/field.","+        for declaration in current","+            .iter()","+            .filter(|d| !previous.contains(d))","+            .chain(previous.iter().filter(|d| !current.contains(d)))","+        {","+            changed.insert(format!(","+                \"{id}: {}{}\",","+                declaration.file,","+                declaration","+                    .field","+                    .as_ref()","+                    .map(|field| format!(\" ({field})\"))","+                    .unwrap_or_default()","+            ));","+        }","+    }","+    Err(Error::Drift(changed.into_iter().collect::<Vec<_>>().join(\", \")).into())","+}","+","+pub(super) fn frozen(snapshot: &Snapshot) -> Result<(), super::Error> {","+    let lock = snapshot.previous_lock().ok_or(Error::Missing)?;","+    matching(snapshot, lock)","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/provision.rs","lines":["@@ -137,11 +137,7 @@ pub(super) fn plans(","     lock: &turborepo_setup::lock::Lock,"," ) -> Result<Plans, Error> {","     let platform = platform()?;","-    if !lock.matches_native(snapshot.declarations())? {","-        return Err(Error::Unsupported(","-            \"turbo.lock declarations changed; run setup locally and commit the updated lock\",","-        ));","-    }","+    super::lock_diagnostics::matching(snapshot, lock)?;","     if lock","         .tools()","         .keys()","@@ -301,6 +297,9 @@ pub(super) fn run(","     let write = lock_mode == super::LockMode::Write && !force;","     let root = discovery.snapshot_root()?.as_std_path();","     platform()?;","+    if lock_mode == super::LockMode::Frozen {","+        super::lock_diagnostics::frozen(&snapshot)?;","+    }","     if write {","         resolvable(&snapshot)?;","     }"],"additions":4,"deletions":5,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/root/discovery/owned_fixtures.rs","lines":["@@ -61,7 +61,9 @@ fn owned_policy_reaches_actual_parser_root_and_executor_without_success_or_write","     setup::validate_request(&request)?;","     assert!(matches!(","         setup::run(&args, setup_args),","-        Err(setup::Error::Unsupported(_))","+        Err(setup::Error::LockDiagnostics(","+            setup::lock_diagnostics::Error::Missing","+        )) | Err(setup::Error::Unsupported(_)) // Unqualified hosts.","     ));","     fs::write(f.home().join(\".npmrc\"), \"\")?;","     assert_eq!(","@@ -246,7 +248,9 @@ async fn unsupported_unix_artifact_targets_fail_before_loopback_traffic_or_stora","     };","     assert!(matches!(","         setup::run(&args, setup_args),","-        Err(setup::Error::Unsupported(_))","+        Err(setup::Error::LockDiagnostics(","+            setup::lock_diagnostics::Error::Missing","+        )) | Err(setup::Error::Unsupported(_)) // Unqualified hosts.","     ));","     assert!(","         tokio::time::timeout(Duration::from_millis(50), listener.accept())"],"additions":6,"deletions":2,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/root/discovery/tests.rs","lines":["@@ -377,7 +377,9 @@ fn production_run_preserves_disabled_parse_normalization_and_not_implemented() {","     };","     assert!(matches!(","         dispatch(&[\"--frozen\", \"--tools-only\"]),","-        Err(setup::Error::Unsupported(_))","+        Err(setup::Error::LockDiagnostics(","+            setup::lock_diagnostics::Error::Missing","+        )) | Err(setup::Error::Unsupported(_)) // Unqualified hosts.","     ));","     for flags in [&[\"--plan\"][..], &[\"--check\"], &[\"--__test-run\"]] {","         assert!(matches!(dispatch(flags), Err(setup::Error::NotImplemented)));"],"additions":3,"deletions":1,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/uv_tests.rs","lines":["@@ -1,10 +1,6 @@"," //! Python-only parser → discovery → uv lock writer → provisioning fixtures."," //! Fixture uv binaries are installed but never executed by setup.","-use turborepo_setup::{","-    lock::{Lock, reconcile},","-    uv::UvArtifact,","-    uv_resolution::UvTransport,","-};","+use turborepo_setup::{lock::Lock, uv::UvArtifact, uv_resolution::UvTransport};"," "," use super::*;"," ","@@ -136,8 +132,8 @@ fn declaration_changes_update_locally_and_frozen_names_uv() {","     declare(&owned, \"==0.12.*\");","     let bytes = fs::read(owned.root().join(\"turbo.lock\")).unwrap();","     match run(&owned, &upstream, FROZEN) {","-        Err(Error::Reconcile(reconcile::Error::Drift(ids))) => {","-            assert_eq!(ids.into_iter().collect::<Vec<_>>(), [\"uv\"]);","+        Err(Error::LockDiagnostics(lock_diagnostics::Error::Drift(locations))) => {","+            assert_eq!(locations, \"uv: pyproject.toml (tool.uv.required-version)\");","         }","         other => panic!(\"expected named uv drift, got {other:?}\"),","     }"],"additions":3,"deletions":7,"truncated":false},{"path":"crates/turborepo/tests/setup.rs","lines":["@@ -1694,6 +1694,11 @@ fn python_frozen_setup_requires_and_checks_the_uv_lock_read_only() {","         } else {","             &words","         };","-        failure(root, words, ci, r#\"native declarations changed for {\"uv\"}\"#);","+        failure(","+            root,","+            words,","+            ci,","+            \"turbo.lock declarations changed: uv: pyproject.toml (tool.uv.required-version)\",","+        );","     }"," }"],"additions":6,"deletions":1,"truncated":false},{"path":"crates/turborepo/tests/setup_ci.rs","lines":["@@ -0,0 +1,89 @@","+//! Native entrypoint CI diagnostics fail before writes, probes or HTTP.","+#![cfg(all(","+    any(target_arch = \"x86_64\", target_arch = \"aarch64\"),","+    any(target_os = \"macos\", all(target_os = \"linux\", target_env = \"gnu\"))","+))]","+#![allow(clippy::unwrap_used)]","+","+use std::{fs, io, net::TcpListener, path::Path, process::Command};","+","+fn snapshot(root: &Path) -> Vec<(std::path::PathBuf, Vec<u8>, std::time::SystemTime)> {","+    let mut files = vec![];","+    for entry in fs::read_dir(root).unwrap() {","+        let path = entry.unwrap().path();","+        let metadata = fs::symlink_metadata(&path).unwrap();","+        if metadata.is_dir() {","+            files.extend(snapshot(&path));","+        }","+        let bytes = if metadata.is_file() {","+            fs::read(&path).unwrap()","+        } else {","+            vec![]","+        };","+        files.push((path, bytes, metadata.modified().unwrap()));","+    }","+    files.sort();","+    files","+}","+","+#[test]","+fn standalone_ci_missing_and_stale_locks_render_local_repair_guidance_without_writes() {","+    for (lock, declaration) in [(false, \"24.0.0\"), (true, \"24.x\")] {","+        let temp = tempfile::tempdir().unwrap();","+        let root = temp.path();","+        fs::write(","+            root.join(\"turbo.json\"),","+            r#\"{\"futureFlags\":{\"experimentalSetup\":true}}\"#,","+        )","+        .unwrap();","+        fs::write(root.join(\".nvmrc\"), declaration).unwrap();","+        if lock {","+            // The stale declaration must be diagnosed before the executor","+            // considers this unsupported installation kind.","+            fs::write(root.join(\"turbo.lock\"), r#\"{\"schemaVersion\":0,\"tools\":{\"node\":{\"adapter\":\"node\",\"version\":\"24.0.0\",\"declarations\":[{\"file\":\".nvmrc\",\"request\":\"24.0.0\"}],\"installation\":{\"kind\":\"verify-system\",\"executables\":[\"node\"]}}}}\"#).unwrap();","+        }","+        let proxy = TcpListener::bind(\"127.0.0.1:0\").unwrap();","+        proxy.set_nonblocking(true).unwrap();","+        let url = format!(\"http://{}\", proxy.local_addr().unwrap());","+        let before = snapshot(root);","+        let modified = fs::metadata(root).unwrap().modified().unwrap();","+        let output = Command::new(env!(\"CARGO_BIN_EXE_turbo\"))","+            .env_clear()","+            .current_dir(root)","+            .args([\"setup\", \"--tools-only\"])","+            .env(\"CI\", \"1\")","+            .env(\"PATH\", \"\")","+            .env(\"HOME\", root.join(\"home\"))","+            .env(\"TURBO_TELEMETRY_DISABLED\", \"1\")","+            .env(\"DO_NOT_TRACK\", \"1\")","+            .env(\"HTTP_PROXY\", &url)","+            .env(\"HTTPS_PROXY\", &url)","+            .env(\"ALL_PROXY\", &url)","+            .env(\"NO_PROXY\", \"\")","+            .output()","+            .unwrap();","+        assert_eq!(output.status.code(), Some(1));","+        let message = format!(","+            \"{}{}\",","+            String::from_utf8_lossy(&output.stdout),","+            String::from_utf8_lossy(&output.stderr)","+        )","+        .replace([' ', '|', '\\n', '\\r'], \"\");","+        assert!(","+            message.contains(if lock {","+                \"turbo.lockdeclarationschanged:node:.nvmrc\"","+            } else {","+                \"frozenmoderequiresturbo.lock\"","+            }),","+            \"{message}\"","+        );","+        assert!(message.contains(\"turbosetup--tools-only\"), \"{message}\");","+        assert!(","+            message.contains(\"locally\") && message.contains(\"commit\"),","+            \"{message}\"","+        );","+        assert_eq!(snapshot(root), before);","+        assert_eq!(fs::metadata(root).unwrap().modified().unwrap(), modified);","+        assert!(matches!(proxy.accept(), Err(e) if e.kind() == io::ErrorKind::WouldBlock));","+    }","+}",""],"additions":89,"deletions":0,"truncated":false}],"additions":389,"deletions":16,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-14T13:04:28.062739+00:00"}