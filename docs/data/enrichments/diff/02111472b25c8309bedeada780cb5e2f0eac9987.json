e dynamicResolver interface {","+\tGet(gvk schema.GroupVersionKind, namespace, name string) (runtime.Object, error)","+\tEnqueue(gvk schema.GroupVersionKind, namespace, name string) error","+}","+","+type handler struct {","+\tcertificateRotations operationcontrollers.CertificateRotationController","+","+\tbeacons plancontrollers.BeaconClient","+","+\tsecrets corecontrollers.SecretClient","+","+\tstore *plan.Store","+","+\tdynamic dynamicResolver","+","+\tclients *wrangler.CAPIContext","+}","+","+type scope struct {","+\townerKey string","+","+\top        *opv1alpha1.CertificateRotation","+\tnamespace string","+","+\tbeacon     *planv1alpha1.Beacon","+\tclusterObj *unstructured.Unstructured","+\tadapter    ops.Adapter","+}","+","+// Register wires the CertificateRotation status handler.","+func Register(ctx context.Context, clients *wrangler.CAPIContext) {","+\th := &handler{","+\t\tcertificateRotations: clients.Operation.CertificateRotation(),","+\t\tbeacons:              clients.Plan.Beacon(),","+\t\tsecrets:              clients.Core.Secret(),","+\t\tstore:                plan.NewStore(clients.Core.Secret()),","+\t\tdynamic:              clients.Dynamic,","+\t\tclients:              clients,","+\t}","+","+\toperationcontrollers.RegisterCertificateRotationStatusHandler(ctx, clients.Operation.CertificateRotation(), \"\", \"certificate-rotation-handler\", h.OnChange)","+}","+","+// OnChange executes one reconcile pass and requeues while the operation is active.","+func (h *handler) OnChange(op *opv1alpha1.CertificateRotation, status opv1alpha1.CertificateRotationStatus) (opv1alpha1.CertificateRotationStatus, error) {","+\tstatus, err := h.onChange(op, status)","+\tif err != nil {","+\t\treturn status, err","+\t}","+\tstatus = updateStatus(op, status)","+","+\tif equality.Semantic.DeepEqual(op.Status, status) {","+\t\tif ops.IsTerminal(status.Phase) &&","+\t\t\tops.IsExpired(&op.Spec.OperationSpec, &status.OperationStatus) &&","+\t\t\t!planv1alpha1.HasActiveLifecycleHook(op) {","+\t\t\terr = h.certificateRotations.Delete(op.Namespace, op.Name, &metav1.DeleteOptions{})","+\t\t\tif err != nil {","+\t\t\t\treturn status, err","+\t\t\t}","+\t\t\treturn status, generic.ErrSkip","+\t\t}","+","+\t\th.certificateRotations.EnqueueAfter(op.Namespace, op.Name, 5*time.Second)","+\t}","+","+\treturn status, nil","+}","+","+// onChange resolves cluster context, then dispatches phase-specific handlers.","+func (h *handler) onChange(op *opv1alpha1.CertificateRotation, status opv1alpha1.CertificateRotationStatus) (opv1alpha1.CertificateRotationStatus, error) {","+\tif op == nil {","+\t\treturn status, nil","+\t}","+","+\tif op.DeletionTimestamp != nil {","+\t\treturn status, nil","+\t}","+","+\tif ops.IsPaused(&op.Spec.OperationSpec) {","+\t\tlogrus.Debugf(\"[certificaterotation] %s/%s: skipping paused operation\", op.Namespace, op.Name)","+\t\treturn status, nil","+\t}","+","+\tif status.Phase == \"\" {","+\t\tstatus.SetPhase(opv1alpha1.OperationPhasePending)","+\t}","+","+\tgvk := schema.FromAPIVersionAndKind(op.Spec.ClusterRef.APIVersion, op.Spec.ClusterRef.Kind)","+\tref, err := h.dynamic.Get(gvk, op.Spec.ClusterRef.Namespace, op.Spec.ClusterRef.Name)","+\tif apierrors.IsNotFound(err) {","+\t\tkey := fmt.Sprintf(\"apiVersion=%s, kind=%s\", op.Spec.ClusterRef.APIVersion, op.Spec.ClusterRef.Kind)","+\t\tif op.Spec.ClusterRef.Namespace != \"\" {","+\t\t\tkey += fmt.Sprintf(\", namespace=%s\", op.Spec.ClusterRef.Namespace)","+\t\t}","+\t\tkey += fmt.Sprintf(\", name=%s\", op.Spec.ClusterRef.Name)","+\t\tlogrus.Errorf(\"[certificaterotation]: %s/%s failed to find cluster for %s\", op.Namespace, op.Name, key)","+","+\t\topv1alpha1.FailedCondition.True(&status)","+\t\topv1alpha1.FailedCondition.Reason(&status, opv1alpha1.ClusterNotFoundReason)","+\t\topv1alpha1.FailedCondition.Message(&status, fmt.Sprintf(\"cluster %s not found\", key))","+\t\tstatus.SetPhase(opv1alpha1.OperationPhaseFailed)","+\t\treturn status, nil","+\t}","+\tif err != nil {","