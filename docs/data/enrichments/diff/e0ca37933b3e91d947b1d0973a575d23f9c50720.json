: &p256::ecdsa::SigningKey,","+    digest: &B256,","+) -> Result<PrimitiveSignature, p256::ecdsa::Error> {","+    let (r, s) = sign_p256_low_s(key, digest.as_slice())?;","+    let (pub_key_x, pub_key_y) = p256_public_key(key);","+    Ok(PrimitiveSignature::P256(P256SignatureWithPreHash {","+        r,","+        s,","+        pub_key_x,","+        pub_key_y,","+        pre_hash: false,","+    }))","+}","+"," /// Parses a configuration given as JSON, or as the path of a JSON file: `salt`, `version`,"," /// `threshold` and `owners` (each an `owner` and a `weight`), as `cast wallet owners --json`"," /// prints it, with or without its JSON envelope.","@@ -989,7 +1034,7 @@ pub fn linked_account(keystore: &Path) -> Result<Option<(Address, Address)>> {"," #[cfg(test)]"," mod tests {","     use super::*;","-    use alloy_primitives::{address, b256};","+    use alloy_primitives::{address, b256, keccak256};","     use alloy_provider::{ProviderBuilder as AlloyProviderBuilder, mock::Asserter};","     use alloy_signer::SignerSync;","     use alloy_signer_local::PrivateKeySigner;","@@ -1082,6 +1127,21 @@ mod tests {","         assert_eq!((signature.r, signature.s), (r, s));","     }"," ","+    /// P-256 approvals cover the digest itself and stay low-s, which Tempo's verifier requires","+    /// and about half of raw ECDSA signatures are not.","+    #[test]","+    fn p256_approvals_recover_the_owner() {","+        let key = p256::ecdsa::SigningKey::from_slice(&[0x22; 32]).unwrap();","+        for byte in 0..16 {","+            let digest = keccak256([byte]);","+            let signature = sign_p256(&key, &digest).unwrap();","+            assert!(matches!(&signature, PrimitiveSignature::P256(p256) if !p256.pre_hash));","+            assert_eq!(signature.recover_signer(&digest).unwrap(), PASSKEY_OWNER);","+        }","+        assert!(parse_p256_key(\"0x1234\").is_err());","+        assert!(parse_p256_key(&format!(\"0x{}\", \"22\".repeat(32))).is_ok());","+    }","+","     /// The w