      .build()","+                             )","+                             .withImmediateSegmentLoading(true)","+                             .build();","+","+    startSimulation(sim);","+    runCoordinatorCycle();","+    runCoordinatorCycle();","+","+    // Each tier holds 5,000,000,000 bytes: T1 of 10,485,760,000 and T2 of 20,971,520,000","+    verifyValue(Stats.Tier.CACHE_UTILIZATION.getMetricName(), aliasedTier(Tier.T1), 48L);","+    verifyValue(Stats.Tier.CACHE_UTILIZATION.getMetricName(), aliasedTier(Tier.T2), 24L);","+","+    // The alias is the ratio of the summed bytes, not the average of the per-tier percentages","+    verifyValue(","+        Stats.Tier.ALIAS_CACHE_UTILIZATION.getMetricName(),","+        Map.of(Dimension.TIER_ALIAS.reportedName(), ALIAS),","+        32L","+    );","+  }","+","+  @Test","+  public void testCacheUtilizationSkipsTiersWithNoCapacity()","+  {","+    final DruidServer sizedT1 = createHistorical(1, Tier.T1, 10_000);","+    final DruidServer emptyT2 = createHistorical(1, Tier.T2, 0);","+    final CoordinatorSimulation sim =","+        CoordinatorSimulation.builder()","+                             .withSegments(Segments.WIKI_10X1D)","+                             .withServers(sizedT1, emptyT2)","+                             .withRules(datasource, Load.on(ALIAS, 1).forever())","+                             .withDynamicConfig(","+                                 CoordinatorDynamicConfig.builder()","+                                                         .withHistoricalTierAliases(","+                                                             Map.of(ALIAS, Set.of(Tier.T1, Tier.T2))","+                                                         )","+                                                         .withSmartSegmentLoading(true)","+                                                         .build()","+                             )","+                             .withImmediateSegmentLoading(true)","+                             .build();","+","+    startSimulation(sim);","+    runCoordinatorCycle();","+    runCoordinatorCycle();","+","+    verifyValue(Stats.Tier.CACHE_UTILIZATION.getMetricName(), aliasedTier(Tier.T1), 48L);","+    verifyEmitted(Stats.Tier.CACHE_UTILIZATION.getMetricName(), filterByTier(Tier.T2), 0);","+    verifyValue(","+        Stats.Tier.ALIAS_CACHE_UTILIZATION.getMetricName(),","+        Map.of(Dimension.TIER_ALIAS.reportedName(), ALIAS),","+        48L","+    );","+  }","+","+  @Test","+  public void testCacheUtilizationExcludesClones()","+  {","+    final DruidServer sourceT1 = createHistorical(1, Tier.T1, 10_000);","+    // T2 holds only a clone of sourceT1, so it has no managed cache capacity of its own","+    final DruidServer cloneT2 = createHistorical(1, Tier.T2, 20_000);","+    final CoordinatorSimulation sim =","+        CoordinatorSimulation.builder()","+                             .withSegments(Segments.WIKI_10X1D)","+                             .withServers(sourceT1, cloneT2)","+                             .withRules(datasource, Load.on(Tier.T1, 1).forever())","+                             .withDynamicConfig(","+                                 CoordinatorDynamicConfig.builder()","+                                                         .withHistoricalTierAliases(","+                                                             Map.of(ALIAS, Set.of(Tier.T1, Tier.T2))","+                                                         )","+                                                         .withCloneServers(Map.of(cloneT2.getHost(), sourceT1.getHost()))","+                                                         .withSmartSegmentLoading(true)","+                                                         .build()","+                             )","+                             .withImmediateSegmentLoading(true)","+                             .build();","+","+    startSimulation(sim);","+","+    runCoordinatorCycle();","+    verifyValue(Stats.Tier.CACHE_UTILIZATION.getMetricName(), aliasedTier(Tier.T1), 0L);","+","+    runCoordinatorCycle();","+    Assertions.assertEquals(Segments.WIKI_10X1D.size(), cloneT2.getTotalSegments());","+    verifyValue(Stats.Tier.CLONE_COUNT.getMetricName(), aliasedTier(Tier.T2), 1L);","+    verifyValue(Stats.Tier.CACHE_UTILIZATION.getMetricName(), aliasedTier(Tier.T1), 48L);","+    verifyEmitted(Stats.Tier.CACHE_UTILIZATION.getMetricName(), filterByTier(Tier.T2), 0);","+","+    // Counting the clone would give 10,000,000,000 / 31,457,280,000 = 32","+    verifyValue(","+        Stats.Tier.ALIAS_CACHE_UTILIZATION.getMetricName(),","+        Map.of(Dimension.TIER_ALIAS.reportedName(), ALIAS),","+        48L","+    );","+  }","+","   private static Map<String, Object> aliasedTier(String tier)","   {","     return Map.of(Dimension.TIER.reportedName(), tier, Dimension.TIER_ALIAS.reportedName(), ALIAS);","@@ -178,5 +292,8 @@ public void testCapacityMetricsHaveNoAliasWhenNotConfigured()","         filterByTier(Tier.T2),","         expectedCapacity","     );","+","+    verifyEmitted(Stats.Tier.CACHE_UTILIZATION.getMetricName(), filterByTier(Tier.T1), 1);","+    verifyNotEmitted(Stats.Tier.ALIAS_CACHE_UTILIZATION.getMetricName());","   }"," }"],"additions":117,"deletions":0,"truncated":false},{"path":"web-console/src/druid-models/coordinator-dynamic-config/coordinator-dynamic-config.spec.ts","lines":["@@ -0,0 +1,43 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, sof