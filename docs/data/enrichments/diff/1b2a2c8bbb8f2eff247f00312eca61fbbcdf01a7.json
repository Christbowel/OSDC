{"id":"1b2a2c8bbb8f2eff247f00312eca61fbbcdf01a7","axis":"silent","repo":"salvo-rs/salvo","sha":"1b2a2c8bbb8f2eff247f00312eca61fbbcdf01a7","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -67,6 +67,8 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).","   so origin handlers retain their precondition and conditional download behavior."," - Validate CSRF tokens for every unsafe HTTP method by default, including CONNECT","   and extension methods, while preserving explicit skipper overrides.","+- Return HTTP 500 when saving a new or rotated CSRF token fails, instead of","+  exposing an unsaved token and executing the application handler."," - Clean up interrupted multipart uploads and keep temporary files alive until","   the last `FilePart` clone is released."," - Bound multipart parsing to 128 parts and 32 files by default, rejecting count"],"additions":2,"deletions":0,"truncated":false},{"path":"crates/csrf/src/lib.rs","lines":["@@ -18,6 +18,8 @@"," //! work with `salvo-session` crate."," //!"," //! Use [`Csrf::rotation_policy`] to opt into request-level rotation when needed.","+//! If saving a newly issued or rotated token fails, the middleware responds with","+//! HTTP 500 and does not execute downstream handlers or expose the unsaved token."," //!"," //! Read more: <https://salvo.rs>"," #![doc(html_favicon_url = \"https://salvo.rs/favicon-32x32.png\")]","@@ -321,13 +323,14 @@ impl<C: CsrfCipher, S: CsrfStore> Csrf<C, S> {","         req: &mut Request,","         depot: &mut Depot,","         res: &mut Response,","-    ) -> String {","+    ) -> Result<String, S::Error> {","         let (token, proof) = self.cipher.generate();","         if let Err(e) = self.store.save(req, depot, res, &token, &proof).await {","             tracing::error!(error = ?e, \"csrf token save failed\");","+            return Err(e);","         }","         tracing::debug!(\"new csrf token generated\");","-        token","+        Ok(token)","     }"," }"," ","@@ -365,7 +368,12 @@ impl<C: CsrfCipher, S: CsrfStore> Handler for Csrf<C, S> {","                 }"," ","                 let token = if matches!(self.rotation_policy, CsrfRotationPolicy::PerRequest) {","-                    self.issue_token(req, depot, res).await","+                    let Ok(token) = self.issue_token(req, depot, res).await else {","+                        res.status_code(StatusCode::INTERNAL_SERVER_ERROR);","+                        ctrl.skip_rest();","+                        return;","+                    };","+                    token","                 } else {","                     current_token","                 };","@@ -378,7 +386,11 @@ impl<C: CsrfCipher, S: CsrfStore> Handler for Csrf<C, S> {","                     res.status_code(StatusCode::FORBIDDEN);","                     ctrl.skip_rest();","                 } else {","-                    let token = self.issue_token(req, depot, res).await;","+                    let Ok(token) = self.issue_token(req, depot, res).await else {","+                        res.status_code(StatusCode::INTERNAL_SERVER_ERROR);","+                        ctrl.skip_rest();","+                        return;","+                    };","                     depot.insert(CSRF_TOKEN_KEY, token);","                     ctrl.call_next(req, depot, res).await;","                 }","@@ -537,7 +549,7 @@ mod tests {"," ","     #[cfg(feature = \"session-store\")]","     #[tokio::test]","-    async fn test_session_store_without_session_middleware_does_not_panic() {","+    async fn test_session_store_without_session_middleware_returns_server_error() {","         let csrf = Csrf::new(","             BcryptCipher::new(),","             SessionStore::new(),","@@ -547,7 +559,7 @@ mod tests {"," ","         let mut res = TestClient::get(\"http://127.0.0.1:5801\").send(router).await;"," ","-        assert_eq!(res.status_code.unwrap(), StatusCode::OK);","+        assert_eq!(res.status_code.unwrap(), StatusCode::INTERNAL_SERVER_ERROR);","         assert_ne!(res.take_string().await.unwrap(), \"\");","     }"," "],"additions":18,"deletions":6,"truncated":false},{"path":"crates/csrf/tests/token_save_errors.rs","lines":["@@ -0,0 +1,157 @@","+//! Failed token persistence must not expose a token or execute the application.","+","+use std::sync::Arc;","+use std::sync::atomic::{AtomicUsize, Ordering};","+","+use salvo_core::prelude::*;","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_csrf::{Csrf, CsrfCipher, CsrfDepotExt, CsrfRotationPolicy, CsrfStore, HeaderFinder};","+","+struct Cipher;","+impl CsrfCipher for Cipher {","+    fn verify(&self, token: &str, proof: &str) -> bool {","+        proof == format!(\"proof-{token}\")","+    }","+    fn generate(&self) -> (String, String) {","+        (\"new\".into(), \"proof-new\".into())","+    }","+}","+","+struct Store {","+    current: Option<(String, String)>,","+    fail_save: bool,","+    saves: Arc<AtomicUsize>,","+}","+impl CsrfStore for Store {","+    type Error = std::io::Error;","+","+    async fn load<C: CsrfCipher>(","+        &self,","+        _req: &mut Request,","+        _depot: &mut Depot,","+        _cipher: &C,","+    ) -> Option<(String, String)> {","+        self.current.clone()","+    }","+    async fn save(","+        &self,","+        _req: &mut Request,","+        _depot: &mut Depot,","+        _res: &mut Response,","+        _token: &str,","+        _proof: &str,","+    ) -> Result<(), Self::Error> {","+        self.saves.fetch_add(1, Ordering::SeqCst);","+        if self.fail_save {","+            Err(std::io::Error::other(\"store unavailable\"))","+        } else {","+            Ok(())","+        }","+    }","+}","+","+struct Application(Arc<AtomicUsize>);","+#[async_trait]","+impl Handler for Application {","+    async fn handle(","+        &self,","+        _req: &mut Request,","+        depot: &mut Depot,","+        res: &mut Response,","+        _ctrl: &mut FlowCtrl,","+    ) {","+        self.0.fetch_add(1, Ordering::SeqCst);","+        res.render(depot.csrf_token().unwrap().to_owned());","+    }","+}","+","+#[tokio::test]","+async fn token_save_failure_stops_initial_issuance_and_rotation() {","+    for (existing, post) in [(false, false), (true, false), (true, true)] {","+        let called = Arc::new(AtomicUsize::new(0));","+        let saves = Arc::new(AtomicUsize::new(0));","+        let service = Service::new(","+            Router::new()","+                .hoop(","+                    Csrf::new(","+                        Cipher,","+                        Store {","+                            current: existing.then(|| (\"old\".into(), \"proof-old\".into())),","+                            fail_save: true,","+                            saves: saves.clone(),","+                        },","+                        HeaderFinder::new(\"x-csrf-token\"),","+                    )","+                    .rotation_policy(CsrfRotationPolicy::PerRequest),","+                )","+                .goal(Application(called.clone())),","+        );","+        let request = if post {","+            TestClient::post(\"http://localhost/\").add_header(\"x-csrf-token\", \"old\", true)","+        } else {","+            TestClient::get(\"http://localhost/\")","+        };","+        let response = request.send(&service).await;","+        assert_eq!(","+            response.status_code,","+            Some(StatusCode::INTERNAL_SERVER_ERROR)","+        );","+        assert_eq!(saves.load(Ordering::SeqCst), 1);","+        assert_eq!(called.load(Ordering::SeqCst), 0);","+    }","+}","+","+#[tokio::test]","+async fn successful_token_save_still_exposes_the_saved_token() {","+    for (existing, post) in [(false, false), (true, false), (true, true)] {","+        let called = Arc::new(AtomicUsize::new(0));","+        let saves = Arc::new(AtomicUsize::new(0));","+        let service = Service::new(","+            Router::new()","+                .hoop(","+                    Csrf::new(","+                        Cipher,","+                        Store {","+                            current: existing.then(|| (\"old\".into(), \"proof-old\".into())),","+                            fail_save: false,","+                            saves: saves.clone(),","+                        },","+                        HeaderFinder::new(\"x-csrf-token\"),","+                    )","+                    .rotation_policy(CsrfRotationPolicy::PerRequest),","+                )","+                .goal(Application(called.clone())),","+        );","+        let request = if post {","+            TestClient::post(\"http://localhost/\").add_header(\"x-csrf-token\", \"old\", true)","+        } else {","+            TestClient::get(\"http://localhost/\")","+        };","+        let mut response = request.send(&service).await;","+        assert_eq!(response.status_code, Some(StatusCode::OK));","+        assert_eq!(response.take_string().await.unwrap(), \"new\");","+        assert_eq!(saves.load(Ordering::SeqCst), 1);","+        assert_eq!(called.load(Ordering::SeqCst), 1);","+    }","+}","+","+#[cfg(feature = \"session-store\")]","+#[tokio::test]","+async fn missing_session_handler_is_a_server_error() {","+    let called = Arc::new(AtomicUsize::new(0));","+    let service = Service::new(","+        Router::new()","+            .hoop(Csrf::new(","+                Cipher,","+                salvo_csrf::SessionStore::new(),","+                HeaderFinder::new(\"x-csrf-token\"),","+            ))","+            .goal(Application(called.clone())),","+    );","+    let response = TestClient::get(\"http://localhost/\").send(&service).await;","+    assert_eq!(","+        response.status_code,","+        Some(StatusCode::INTERNAL_SERVER_ERROR)","+    );","+    assert_eq!(called.load(Ordering::SeqCst), 0);","+}",""],"additions":157,"deletions":0,"truncated":false}],"additions":177,"deletions":6,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-29T15:20:45.452694+00:00"}