\t\t}"," \t\treturn expr;"],"additions":6,"deletions":1,"truncated":false},{"path":"test/sql/copy/parquet/bloom_filter_interval_saturated.test","lines":["@@ -0,0 +1,81 @@","+# name: test/sql/copy/parquet/bloom_filter_interval_saturated.test","+# description: Bloom filters on INTERVAL columns for intervals whose normalization saturates at the 32 bit month limit","+# group: [parquet]","+","+require parquet","+","+statement ok","+COPY (SELECT (i % 10) * INTERVAL '1 day' AS iv FROM range(2048) t(i)) TO '{TEST_DIR}/bloom_interval_days.parquet' (FORMAT PARQUET);","+","+query I","+SELECT count(*)","+FROM parquet_kv_metadata('{TEST_DIR}/bloom_interval_days.parquet')","+WHERE key = 'duckdb.interval_bloom_filter' AND decode(value) = 'normalized-v1';","+----","+1","+","+# normalizing this constant leaves its days negative, and no stored interval equals it","+query I","+SELECT count(*) FROM '{TEST_DIR}/bloom_interval_days.parquet' WHERE iv = INTERVAL '-178956970 years -8 months -1 day';","+----","+0","+","+query I","+SELECT count(*) FROM '{TEST_DIR}/bloom_interval_days.parquet' WHERE iv IN (INTERVAL '-178956970 years -8 months -1 day', INTERVAL '3 days');","+----","+205","+","+query I","+SELECT bool_or(bloom_filter_excludes) FROM parquet_bloom_probe('{TEST_DIR}/bloom_interval_days.parquet', 'iv', INTERVAL '-178956970 years -8 months -1 day');","+----","+false","+","+# other negative constants are not hashed either","+query I","+SELECT count(*) FROM '{TEST_DIR}/bloom_interval_days.parquet' WHERE iv = INTERVAL '-1 day';","+----","+0","+","+# the normalization of this interval keeps a day in its microseconds, as both months and days saturate","+statement ok","+COPY (","+\tSELECT to_months(2147483646) + to_days(2147483647) + INTERVAL '744 hours' AS iv","+\tUNION ALL SELECT INTERVAL '1 day'","+) TO '{TEST_DIR}/bloom_interval_saturated.parquet' (FORMAT PARQUET);","+","+query I","+SELECT count(*) FROM '{TEST_DIR}/bloom_interval_saturated.parquet' WHERE iv = to_months(2147483646) + to_days(2147483647) + INTERVAL '744 hours';","+----","+1","+","+query I","+SELECT bloom_filter_excludes FROM parquet_bloom_probe('{TEST_DIR}/bloom_interval_saturated.parquet', 'iv', to_months(2147483646) + to_days(2147483647) + INTERVAL '744 hours');","+----","+false","+","+# files of v2.0 hash it with the whole days in the days field, and files of main before this change in the","+# milliseconds field, so a filter on it keeps the row groups of both","+query I","+SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/interval_bloom_saturated_v2_0.parquet', 'iv', to_months(2147483646) + to_days(2147483647) + INTERVAL '744 hours');","+----","+false","+","+query I","+SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/interval_bloom_saturated_v2_0.parquet', 'iv', INTERVAL '50 days');","+----","+true","+","+query I","+SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/interval_bloom_saturated_main.parquet', 'iv', to_months(2147483646) + to_days(2147483647) + INTERVAL '744 hours');","+----","+false","+","+query I","+SELECT count(*) FROM 'data/parquet-testing/interval_bloom_saturated_main.parquet' WHERE iv = to_months(2147483646) + to_days(2147483647) + INTERVAL '744 hours';","+----","+1","+","+query I","+SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/interval_bloom_saturated_main.parquet', 'iv', INTERVAL '50 days');","+----","+true"],"additions":81,"deletions":0,"truncated":false},{"path":"test/sql/copy/parquet/encryption/arrow_compatibility.test","lines":["@@ -53,4 +53,57 @@ SELECT * FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_uniform_"," 17\ttrue"," 18\tfalse"," 19\ttrue","-20\tfalse","\\ No newline at end of file","+20\tfalse","+","+# DataPageV2 pages, generated with parquet-rs 58.3.0 (from duckdb/duckdb#24406)","+query I","+SELECT value FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_uncompressed_required.parquet', encryption_config={footer_key: 'arrow_key_generated_files'});","+----","+7","+9","+11","+13","+","+query I","+SELECT value FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_uncompressed_nullable.parquet', encryption_config={footer_key: 'arrow_key_generated_files'});","+----","+7","+NULL","+11","+13","+","+query I","+SELECT value FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_snappy_required.parquet', encryption_config={footer_key: 'arrow_key_generated_files'});","+----","+7","+9","+11","+13","+","+query I","+SELECT value FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_snappy_nullable.parquet', encryption_config={footer_key: 'arrow_key_generated_files'});","+----","+7","+NULL","+11","+13","+","+# DataPageV2 pages whose values are compressed, generated with parquet-rs 58.4.0 (dictionary disabled)","+query IIII","+SELECT count(*), count(value), sum(value), count(*) FILTER (value = 9) FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_snappy_compressed_required.parquet', encryption_config={footer_key: 'arrow_key_generated_files'});","+----","+4096\t4096\t40960\t1024","+","+query IIII","+SELECT count(*), count(value), sum(value), count(*) FILTER (value = 9) FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_snappy_compressed_nullable.parquet', encryption_config={footer_key: 'arrow_key_generated_files'});","+----","+4096\t3072\t31744\t0","+","+query II","+SELECT file_row_number, value FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/arrow_rust_pme_data_page_v2_snappy_compressed_nullable.parquet', encryption_config={footer_key: 'arrow_key_generated_files'}, file_row_number = true) WHERE file_row_number < 5 ORDER BY file_row_number;","+----","+0\t7","+1\tNULL","+2\t11","+3\t13","+4\t7"],"additions":54,"deletions":1,"truncated":false},{"path":"test/sql/copy/parquet/union_by_name_varchar_blob.test","lines":["@@ -0,0 +1,62 @@","+# name: test/sql/copy/parquet/union_by_name_varchar_blob.test","+# description: A VARCHAR column read as BLOB through union_by_name keeps its UTF-8 bytes","+# group: [parquet]","+","+require parquet","+","+statement ok","+COPY (SELECT 'café' AS p, 1 AS i) TO '{TEST_DIR}/union_text.parquet';","+","+statement ok","+COPY (SELECT encode('café') AS p, 2 AS i) TO '{TEST_DIR}/union_bytes.parquet';","+","+statement ok","+COPY (SELECT 'a\\x41' AS p, 3 AS i) TO '{TEST_DIR}/union_backslash.parquet';","+","+query III","+SELECT i, p, typeof(p) FROM read_parquet(['{TEST_DIR}/union_text.parquet', '{TEST_DIR}/union_bytes.parquet', '{TEST_DIR}/union_backslash.parquet'], union_by_name = true) ORDER BY i;","+----","+1\tcaf\\xC3\\xA9\tBLOB","+2\tcaf\\xC3\\xA9\tBLOB","+3\ta\\x5Cx41\tBLOB","+","+query II","+SELECT i, p = encode('café') FROM read_parquet(['{TEST_DIR}/union_text.parquet', '{TEST_DIR}/union_bytes.parquet'], union_by_name = true) ORDER BY i;","+----","+1\ttrue","+2\ttrue","+","+query I","+SELECT octet_length(p) FROM read_parquet(['{TEST_DIR}/union_backslash.parquet', '{TEST_DIR}/union_bytes.parquet'], union_by_name = true) ORDER BY i;","+----","+5","+5","+","+query I","+SELECT count(*) FROM read_parquet(['{TEST_DIR}/union_text.parquet', '{TEST_DIR}/union_bytes.parquet'], union_by_name = true) WHERE p = encode('café');","+----","+2","+","+# the order of the files, NULL and empty values","+statement ok","+COPY (SELECT * FROM (VALUES (NULL, 4), ('', 5), ('ü', 6)) t(p, i)) TO '{TEST_DIR}/union_nulls.parquet';","+","+query III","+SELECT i, p, octet_length(p) FROM read_parquet(['{TEST_DIR}/union_bytes.parquet', '{TEST_DIR}/union_nulls.parquet'], union_by_name = true) ORDER BY i;","+----","+2\tcaf\\xC3\\xA9\t5","+4\tNULL\tNULL","+5\t(empty)\t0","+6\t\\xC3\\xBC\t2","+","+# COPY into a BLOB column reads the text of the file as its bytes as well","+statement ok","+CREATE TABLE blobs (p BLOB, i INTEGER);","+","+statement ok","+COPY blobs FROM '{TEST_DIR}/union_text.parquet';","+","+query II","+SELECT p, p = encode('café') FROM blobs;","+----","+caf\\xC3\\xA9\ttrue",""],"additions":62,"deletions":0,"truncated":false}],"additions":267,"deletions":36,"truncated":false,"file_count":17},"error":null,"fetched_at":"2026-10-28T14:43:46.996792+00:00"}