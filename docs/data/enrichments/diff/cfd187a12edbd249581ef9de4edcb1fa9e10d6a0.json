plan's","+    // cursors are repositioned, as the yield path does.","+    _yieldPolicy->checkConstraintsValid();"," }"," "," void PlanExecutorSBE::detachFromOperationContext() {","@@ -326,7 +330,7 @@ PlanExecutor::ExecState PlanExecutorSBE::getNextImpl(ObjectType* out, RecordId*","             // The !notifier check is necessary because shouldWaitForInserts can return 'true' when","             // shouldListenForInserts returned 'false' (above) in the case of a deadline becoming","             // \"unexpired\" due to the system clock going backwards.","-            if (!_yieldPolicy || !notifier ||","+            if (!notifier ||","                 !insert_listener::shouldWaitForInserts(_opCtx, _cq.get(), _yieldPolicy.get())) {","                 return PlanExecutor::ExecState::IS_EOF;","             }"],"additions":13,"deletions":9,"truncated":false},{"path":"src/mongo/db/query/plan_yield_policy_sbe.cpp","lines":["@@ -58,7 +58,7 @@ void PlanYieldPolicySBE::restoreState(OperationContext* opCtx,","     for (auto&& root : _yieldingPlans) {","         root->restoreState();","     }","-    uassertIfPathArraynessInvalidated();","+    checkConstraintsValid();"," }"," "," void PlanYieldPolicySBE::MultipleCollectionPathArraynessChecker::","@@ -82,7 +82,7 @@ void PlanYieldPolicySBE::setMultipleCollectionPathArraynessChecker(","     _multipleCollectionsPathArraynessChecker.emplace(std::move(checker));"," }"," ","-void PlanYieldPolicySBE::uassertIfPathArraynessInvalidated() {","+void PlanYieldPolicySBE::checkConstraintsValid() {","     if (_multipleCollectionsPathArraynessChecker) {","         _multipleCollectionsPathArraynessChecker->uassertIfInvalidatedAndSyncEpoch();","     }"],"additions":2,"deletions":2,"truncated":false},{"path":"src/mongo/db/query/plan_yield_policy_sbe.h","lines":["@@ -70,8 +70,14 @@ class PlanYieldPolicySBE final : public PlanYieldPolicy {","      */","     void setMultipleCollectionPathArraynessChecker(MultipleCollectionPathArraynessChecker checker);"