DER: newerFolder,","+          PATH: [newerFolder, '/usr/bin'].join(delimiter),","+        };","+        await handleClientEnv(newerEnv, new EventEmitter());","+        setWorkerEnv.mockClear();","+","+        older.emit('close');","+        await flushMicrotasks();","+","+        expect(setWorkerEnv).not.toHaveBeenCalled();","+        expect(getLiveClientBerryEnv()).toEqual(newerEnv);","+      });","+","+      it(\"leaves a newer client's folders alone when it applies while an older client's disconnect waits\", async () => {","+        let releaseFirstForward: () => void;","+        setWorkerEnv.mockImplementationOnce(","+          () => new Promise<void>((r) => (releaseFirstForward = r))","+        );","+        const older = new EventEmitter();","+        const olderApply = handleClientEnv(yarnEnv, older);","+        await flushMicrotasks();","+        const newerFolder = join(root, 'xfs-0000000b');","+        mkdirSync(newerFolder, { mode: 0o755 });","+        const newerEnv = {","+          BERRY_BIN_FOLDER: newerFolder,","+          PATH: [newerFolder, '/usr/bin'].join(delimiter),","+        };","+        const newerApply = handleClientEnv(newerEnv, new EventEmitter());","+        older.emit('close');","+        releaseFirstForward();","+        await Promise.all([olderApply, newerApply]);","+        await flushMicrotasks();","+","+        expect(setWorkerEnv).toHaveBeenLastCalledWith(newerEnv);","+        expect(getLiveClientBerryEnv()).toEqual(newerEnv);","+      });","+","+      describe('when plugins run in the daemon', () => {","+        beforeEach(() => {","+          (daemonHostsPluginsInProcess as Mock).mockReturnValue(true);","+        });","+","+        it('puts them on the daemon PATH until the client disconnects', async () => {","+          const client = new EventEmitter();","+","+          await handleClientEnv(yarnEnv, client);","+","+          expect(process.env.PATH).toEqual(yarnEnv.PATH);","+","+          client.emit('close');","+          aw