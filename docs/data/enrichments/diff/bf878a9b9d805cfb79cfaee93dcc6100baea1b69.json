,"+        );","+    }","+    let config = load(\"metrics:\\n  listen: 127.0.0.1:9464\\n\").unwrap();","+    let metrics = config.http.metrics.expect(\"metrics is set\");","+    assert_eq!(metrics.listen, Some(\"127.0.0.1:9464\".parse().unwrap()));","+    assert_eq!(metrics.token, None);","+","+    let token = \"a\".repeat(crate::MetricsConfig::MIN_TOKEN_LEN);","+    let config = load(&format!(\"metrics:\\n  token: {token}\\n\")).unwrap();","+    let metrics = config.http.metrics.expect(\"metrics is set\");","+    assert_eq!(metrics.token.as_deref(), Some(token.as_str()));","+    assert!(!format!(\"{metrics:?}\").contains(&token));","+}","+"," #[test]"," fn the_retired_per_surface_policies_are_refused() {","     for yaml in ["],"additions":30,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr-fixtures/src/presets.rs","lines":["@@ -196,6 +196,7 @@ fn with_routing(","             trusted_proxies: Vec::new(),","             trusted_proxy_header: TrustedProxyHeader::default(),","             request_timeout: Some(pnpr_config::HttpConfig::DEFAULT_REQUEST_TIMEOUT),","+            metrics: None,","         },","         storage: pnpr_config::StorageConfig {","             cache_dir: default_cache_dir(&storage),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -163,7 +163,7 @@ use self::{","         PublishTarget, check_publish_tombstone, commit_publishes, publish_package,","         resolve_publish_target_for, serve_batch_publish, stage_publish, validate_publish_doc,","     },","-    routing::router_with_auth_and_osv,","+    routing::{metrics_listener_router, router_with_auth_and_osv, state_and_router},"," };"," "," use axum::{","@@ -298,6 +298,7 @@ pub fn try_router_with_auth(mut config: Config, auth: AuthState) -> pnpr_error::","     // `serve`/`serve_listener`.","     config.features.ensure_a_feature_is_enabled()?;","     config.routing.ensure_valid_registry_graph(config.features.registry.enabled)?;","+    config.http.ensure_valid_metrics()?;","     let osv_index = load_active_osv_index(&config)?;","     router_with_auth_and_osv(config, auth, osv_index)"," }"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/authentication.rs","lines":["@@ -6,7 +6,7 @@ use std::{"," "," use axum::{","     extract::{ConnectInfo, FromRequestParts, Request, State},","-    http::{Method, request::Parts},","+    http::{HeaderMap, Method, header, request::Parts},","     middleware::Next,","     response::{IntoResponse, Response},"," };","@@ -21,6 +21,21 @@ use super::{","     single_authorization_header,"," };"," ","+/// Whether `headers` carry `Authorization: Bearer <expected>`, for an","+/// endpoint authenticated by a configured secret instead of a user token.","+/// Comparing digests keeps the comparison time independent of how much of","+/// the secret a guess gets right.","+pub(super) fn carries_bearer_secret(headers: &HeaderMap, expected: &str) -> bool {","+    headers","+        .get(header::AUTHORIZATION)","+        .and_then(|value| value.to_str().ok())","+        .and_then(|value| value.strip_prefix(\"Bearer \"))","+        .is_some_and(|sent| {","+            super::ecosystem::sha256_hex(expected.as_bytes())","+                == super::ecosystem::sha256_hex(sent.trim().as_bytes())","+        })","+}","+"," /// What the caller is trying to do with a package. Drives which"," /// rule from the access policy applies."," #[derive(Debug, Clone, Copy)]"],"additions":16,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/lifecycle.rs","lines":["@@ -1,6 +1,11 @@","+use std::future::IntoFuture;","+","+use axum::Router;","+use futures_util::FutureExt as _;","+"," use super::{","-    Arc, AuthState, Config, Ecosystem, NodelayTcpListener, PeerAddr, RegistryDocuments, Storage,","-    router_with_auth_and_osv, shutdown_signal,","+    AppState, Arc, AuthState, Config, Ecosystem, NodelayTcpListener, PeerAddr, RegistryDocuments,","+    Storage, metrics_listener_router, shutdown_signal, state_and_router,"," };"," "," /// Load the OSV index only for surfaces that consult it. An artifacts-only","@@ -88,6 +93,7 @@ pub async fn serve(mut config: Config) -> pnpr_error::Result<()> {","     // rather than start a server that only answers `/-/ping`.","     config.features.ensure_a_feature_is_enabled()?;","     config.routing.ensure_valid_registry_graph(config.features.registry.enabled)?;","+    config.http.ensure_valid_metrics()?;","     log_enabled_surfaces(&config);","     let osv_index = load_active_osv_index(&config)?;","     let auth = load_startup_auth(&config).await?;","@@ -96,12 +102,52 @@ pub async fn serve(mut config: Config) -> pnpr_error::Result<()> {","     // should not leave a bound socket behind or put a `pnpr listening` line","     // immediately above the error saying it is not.","     crate::cache_maintenance::spawn_periodic_cache_eviction(&config);","-    let app = router_with_auth_and_osv(config, auth, osv_index)?;","-    let listener = NodelayTcpListener(tokio::net::TcpListener::bind(listen).await?);","+    let (state, app) = state_and_router(config, auth, osv_index)?;","+    let metrics = bind_metrics_listener(state).await?;","+    let listener = tokio::net::TcpListener::bind(listen).await?;","     tracing::info!(%listen, \"pnpr listening\");","-    axum::serve(listener, app.into_make_service_with_connect_info::<PeerAddr>())","-        .with_graceful_shutdown(shutdown_signal())","-        .await?;","+    serve_until_shutdown(listener, app, metrics).await","+}","+","+/// The listener `metrics.listen` names, with the router it serves.","+struct MetricsListener {","+    listener: tokio::net::TcpListener,","+    router: Router,","+}","+","+async fn bind_metrics_listener(state: AppState) -> pnpr_error::Result<Option<MetricsListener>> {","+    let Some(listen) = state.inner.config.http.metrics.as_ref().and_then(|metrics| metrics.listen)","+    else {","+        return Ok(None);","+    };","+    let listener = tokio::net::TcpListener::bind(listen).await","+        .map_err(|err| {","+            std::io::Error::new(err.kind(), format!(\"cannot bind metrics.listen {listen}: {err}\"))","+        })?;","+    tracing::info!(listen = %listener.local_addr()?, \"pnpr serving metrics\");","+    Ok(Some(MetricsListener { listener, router: metrics_listener_router(state) }))","+}","+","+async fn serve_until_shutdown(","+    listener: tokio::net::TcpListener,","+    app: Router,","+    metrics: Option<MetricsListener>,","+) -> pnpr_error::Result<()> {","+    let shutdown = shutdown_signal().shared();","+    let main = axum::serve(","+        NodelayTcpListener(listener),","+        app.into_make_service_with_connect_info::<PeerAddr>(),","+    )","+    .with_graceful_shutdown(shutdown.clone())","+    .into_future();","+    match metrics {","+        None => main.await?,","+        Some(MetricsListener { listener, router }) => {","+            let metrics =","+                axum::serve(listener, router).with_graceful_shutdown(shutdown).into_future();","+            tokio::try_join!(main, metrics)?;","+        }","+    }","     Ok(())"," }"," ","@@ -133,19 +179,15 @@ pub async fn serve_listener(","     let listen = listener.local_addr()?;","     config.features.ensure_a_feature_is_enabled()?;","     config.routing.ensure_valid_registry_graph(config.features.registry.enabled)?;","+    config.http.ensure_valid_metrics()?;","     log_enabled_surfaces(&config);","     let osv_index = load_active_osv_index(&config)?;","     // Load the configured auth backends here too — going through `router`","     // would silently fall back to in-memory auth and ignore a persisted","     // htpasswd / SQLite store or a configured `backend:`.","     let auth = load_startup_auth(&config).await?;","-    let app = router_with_auth_and_osv(config, auth, osv_index)?;","+    let (state, app) = state_and_router(config, auth, osv_index)?;","+    let metrics = bind_metrics_listener(state).await?;","     tracing::info!(%listen, \"pnpr listening\");","-    axum::serve(","-        NodelayTcpListener(listener),","-        app.into_make_service_with_connect_info::<PeerAddr>(),","-    )","-    .with_graceful_shutdown(shutdown_signal())","-    .await?;","-    Ok(())","+    serve_until_shutdown(listener, app, metrics).await"," }"],"additions":57,"deletions":15,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/metrics.rs","lines":["@@ -6,12 +6,12 @@ use std::{"," "," use axum::{","     extract::State,","-    http::{StatusCode, header},","+    http::{HeaderMap, StatusCode, header},","     response::{IntoResponse, Response},"," };"," use dashmap::DashMap;"," ","-use super::AppState;","+use super::{AppState, authentication::carries_bearer_secret};"," "," pub(crate) const DURATION_BUCKETS: [f64; 11] =","     [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0];","@@ -222,11 +222,23 @@ impl ServerMetrics {","     }"," }"," ","-/// Serve Prometheus metrics in standard text format.","-///","-/// Unauthenticated access is intentional to allow telemetry scrapers (such as","-/// Prometheus) to collect server metrics without credentials.","-pub(crate) async fn serve_metrics(State(state): State<AppState>) -> Response {","+/// Serve Prometheus metrics in standard text format, to a caller that sends","+/// `metrics.token` when one is configured.","+pub(crate) async fn serve_metrics(State(state): State<AppState>, headers: HeaderMap) -> Response {","+    let token = state.inner.config.http.metrics","+        .as_ref()","+        .and_then(|metrics| metrics.token.as_deref())","+        .map(str::trim);","+    if let Some(token) = token","+        && !carries_bearer_secret(&headers, token)","+    {","+        return (","+            StatusCode::UNAUTHORIZED,","+            [(header::WWW_AUTHENTICATE, \"Bearer\")],","+            \"a valid metrics bearer token is required\",","+        )","+            .into_response();","+    }","     let rendered = state.inner.metrics.r