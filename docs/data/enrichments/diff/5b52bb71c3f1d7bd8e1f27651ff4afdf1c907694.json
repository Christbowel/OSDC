{"id":"5b52bb71c3f1d7bd8e1f27651ff4afdf1c907694","axis":"silent","repo":"ckeditor/ckeditor5","sha":"5b52bb71c3f1d7bd8e1f27651ff4afdf1c907694","parsed":{"files":[{"path":"scripts-tests/ci/is-ckeditor5-ready-to-release.mjs","lines":["@@ -0,0 +1,65 @@","+/**","+ * @license Copyright (c) 2003-2026, CKSource Holding sp. z o.o. All rights reserved.","+ * For licensing, see LICENSE.md or https://ckeditor.com/legal/ckeditor-licensing-options","+ */","+","+import { beforeEach, describe, expect, it, vi } from 'vitest';","+import * as releaseTools from '@ckeditor/ckeditor5-dev-release-tools';","+import { npm } from '@ckeditor/ckeditor5-dev-utils';","+","+vi.mock( '@ckeditor/ckeditor5-dev-release-tools' );","+vi.mock( '@ckeditor/ckeditor5-dev-utils', () => ( { npm: { checkVersionAvailability: vi.fn() } } ) );","+","+describe( 'scripts/ci/is-ckeditor5-ready-to-release', () => {","+\tbeforeEach( () => {","+\t\tvi.resetModules();","+","+\t\tvi.spyOn( console, 'log' ).mockImplementation( vi.fn() );","+","+\t\t// Unlike the real `process.exit()`, a mocked one does not stop the execution. Throw instead,","+\t\t// so the script cannot run past an exit point.","+\t\tvi.spyOn( process, 'exit' ).mockImplementation( code => {","+\t\t\tthrow new Error( `process.exit( ${ code } )` );","+\t\t} );","+","+\t\tvi.mocked( releaseTools.getLastFromChangelog ).mockReturnValue( '49.0.2' );","+\t} );","+","+\tfunction runScript() {","+\t\treturn import( '../../scripts/ci/is-ckeditor5-ready-to-release.mjs' );","+\t}","+","+\tit( 'reports a stable changelog version that is not on npm as ready to release', async () => {","+\t\tvi.mocked( npm.checkVersionAvailability ).mockResolvedValue( true );","+","+\t\tawait runScript();","+","+\t\texpect( npm.checkVersionAvailability ).toHaveBeenCalledExactlyOnceWith( '49.0.2', 'ckeditor5' );","+\t\texpect( console.log ).toHaveBeenCalledWith( 'CKEditor 5 is ready to release.' );","+\t} );","+","+\tit( 'stops when the changelog version is already on npm (a release commit)', async () => {","+\t\tvi.mocked( npm.checkVersionAvailability ).mockResolvedValue( false );","+","+\t\tawait expect( runScript() ).rejects.toThrow( 'process.exit( 1 )' );","+","+\t\texpect( console.log ).toHaveBeenCalledWith( 'The proposed changelog (49.0.2) version is already published.' );","+\t} );","+","+\tit( 'stops when npm cannot tell if the changelog version is published', async () => {","+\t\tvi.mocked( npm.checkVersionAvailability ).mockRejectedValue( new Error( 'connect ECONNREFUSED' ) );","+","+\t\tawait expect( runScript() ).rejects.toThrow( 'process.exit( 1 )' );","+","+\t\texpect( console.log ).toHaveBeenCalledWith( expect.stringContaining( 'Cannot check if the proposed changelog (49.0.2)' ) );","+\t\texpect( console.log ).not.toHaveBeenCalledWith( 'CKEditor 5 is ready to release.' );","+\t} );","+","+\tit( 'stops for a pre-release changelog version without asking npm', async () => {","+\t\tvi.mocked( releaseTools.getLastFromChangelog ).mockReturnValue( '50.0.0-alpha.0' );","+","+\t\tawait expect( runScript() ).rejects.toThrow( 'process.exit( 1 )' );","+","+\t\texpect( npm.checkVersionAvailability ).not.toHaveBeenCalled();","+\t} );","+} );"],"additions":65,"deletions":0,"truncated":false},{"path":"scripts-tests/release/publishpackages.mjs","lines":["@@ -35,34 +35,76 @@ function findTask( definitions, title ) {"," }"," "," describe( 'scripts/release/publishpackages', () => {","-\tlet task;","+\tlet definitions;"," ","-\tbeforeEach( async () => {","+\t// The CLI arguments are read when the script is imported, so each set of arguments needs a fresh import.","+\tasync function importScript( cliArguments ) {"," \t\tvi.resetModules();","+\t\tvi.mocked( Listr ).mockClear();","+\t\tvi.mocked( parseArguments ).mockReturnValue( cliArguments );","+","+\t\tawait import( '../../scripts/release/publishpackages.mjs' );"," ","+\t\treturn vi.mocked( Listr ).mock.calls[ 0 ][ 0 ];","+\t}","+","+\tbeforeEach( async () => {"," \t\tvi.mocked( fs.readJsonSync ).mock