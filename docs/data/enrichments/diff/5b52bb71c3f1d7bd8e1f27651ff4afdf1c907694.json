editor.com/legal/ckeditor-licensing-options","+ */","+","+import getCdnVersion from './getcdnversion.mjs';","+","+/**","+ * A stable release ZIP is named after its version, for example `ckeditor5-49.0.1`. Other releases use","+ * the channel name, for example `ckeditor5-nightly`.","+ *","+ * @param {String} packageName For example, `ckeditor5` or `ckeditor5-premium-features`.","+ * @param {ReleaseOptions} cliArguments","+ * @param {String} version","+ * @returns {String}","+ */","+export default function getZipName( packageName, cliArguments, version ) {","+\tconst cdnVersion = getCdnVersion( cliArguments, version );","+\tconst isStableRelease = cdnVersion === `staging-v${ version }`;","+","+\treturn `${ packageName }-${ isStableRelease ? version : cdnVersion }`;","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"scripts/release/utils/parsearguments.mjs","lines":["@@ -33,7 +33,8 @@ export default function parseArguments( cliArguments ) {"," \t\t\t'branch',"," \t\t\t'date',"," \t\t\t'npm-tag',","-\t\t\t'packages'","+\t\t\t'packages',","+\t\t\t'release-state'"," \t\t],"," "," \t\tdefault: {","@@ -53,8 +54,10 @@ export default function parseArguments( cliArguments ) {"," \t\t\t),"," \t\t\t'compile-only': false,"," \t\t\tpackages: null,","+\t\t\t'release-state': null,"," \t\t\tbranch: 'release',","-\t\t\t'npm-tag': 'staging',","+\t\t\t// A stable release uses `staging-v<version>`. The version is known only when publishing (see `publishpackages.mjs`).","+\t\t\t'npm-tag': null,"," \t\t\tverbose: false,"," \t\t\tci: false,"," \t\t\texternal: true,","@@ -70,6 +73,7 @@ export default function parseArguments( cliArguments ) {"," "," \treplaceKebabCaseWithCamelCase( options, ["," \t\t'npm-tag',","+\t\t'release-state',"," \t\t'compile-only',"," \t\t'nightly-alpha',"," \t\t'nightly-next',","@@ -117,10 +121,13 @@ export default function parseArguments( cliArguments ) {","  *","  * @property {String} branch='release'","  *","- * @property {String} npmTag='staging'|'ni