{"id":"3f59d25833bc4e592673a92864ce32b07915a30a","axis":"silent","repo":"supabase/supabase","sha":"3f59d25833bc4e592673a92864ce32b07915a30a","parsed":{"files":[{"path":"apps/studio/Dockerfile","lines":["@@ -73,7 +73,8 @@ RUN mkdir -p /srv && \\"," "," # Compile TanStack Start (Vite + Nitro)"," FROM dev AS build-tanstack","-RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter studio run build:tanstack","+# Images serve their own assets, and the pruned context has no upload script.","+RUN SKIP_ASSET_UPLOAD=1 NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter studio run build:tanstack"," "," # Assemble the runtime tree at /srv. Nitro's node-server output is"," # self-contained (`.output/server` bundles the app with its traced"],"additions":2,"deletions":1,"truncated":false},{"path":"apps/studio/asset-cdn.test.ts","lines":["@@ -0,0 +1,130 @@","+import { describe, expect, it } from 'vitest'","+","+import {","+  getAssetCdnOrigin,","+  getCdnUrlForBuiltFile,","+  getTanstackAssetCdnUrl,","+  isWorkerAsset,","+  toCdnAssetUrl,","+} from './asset-cdn'","+","+const CDN = 'https://frontend-assets.supabase.com/studio/tanstack'","+","+describe('getAssetCdnOrigin', () => {","+  it('is disabled outside production', () => {","+    expect(getAssetCdnOrigin({})).toBeUndefined()","+    expect(getAssetCdnOrigin({ VERCEL_ENV: 'preview' })).toBeUndefined()","+  })","+","+  it('is enabled on production deployments', () => {","+    expect(getAssetCdnOrigin({ VERCEL_ENV: 'production' })).toBe(","+      'https://frontend-assets.supabase.com'","+    )","+  })","+","+  it('can be force enabled', () => {","+    expect(getAssetCdnOrigin({ FORCE_ASSET_CDN: '1' })).toBe('https://frontend-assets.supabase.com')","+  })","+","+  it('force disabling wins over a production deployment', () => {","+    expect(getAssetCdnOrigin({ FORCE_ASSET_CDN: '-1', VERCEL_ENV: 'production' })).toBeUndefined()","+  })","+","+  it('uses the staging CDN on staging', () => {","+    expect(","+      getAssetCdnOrigin({ VERCEL_ENV: 'production', NEXT_PUBLIC_ENVIRONMENT: 'staging' })","+    ).toBe('https://frontend-assets.supabase.green')","+  })","+})","+","+describe('getTanstackAssetCdnUrl', () => {","+  it('uses a shared folder under the site name', () => {","+    expect(getTanstackAssetCdnUrl({ VERCEL_ENV: 'production', SITE_NAME: 'supabase-studio' })).toBe(","+      'https://frontend-assets.supabase.com/supabase-studio/tanstack'","+    )","+  })","+","+  it('defaults the site name to studio', () => {","+    expect(getTanstackAssetCdnUrl({ VERCEL_ENV: 'production' })).toBe(CDN)","+  })","+","+  it('is undefined when the CDN is disabled', () => {","+    expect(getTanstackAssetCdnUrl({ SITE_NAME: 'studio' })).toBeUndefined()","+  })","+})","+","+describe('isWorkerAsset', () => {","+  it('matches Vite worker output', () => {","+    expect(isWorkerAsset('_vercel/immutable/initial/nitro/json.worker-BXx3_a-9.js')).toBe(true)","+    expect(isWorkerAsset('_vercel/immutable/initial/nitro/editor.worker-Ab12Cd34.js')).toBe(true)","+  })","+","+  it('does not match regular chunks', () => {","+    expect(isWorkerAsset('_vercel/immutable/initial/nitro/index-BKEvKWTwe3h6KAdk.js')).toBe(false)","+    expect(isWorkerAsset('_vercel/immutable/initial/nitro/worker-utils-Ab12Cd34.js')).toBe(false)","+  })","+})","+","+describe('getCdnUrlForBuiltFile', () => {","+  it('points immutable assets at the CDN', () => {","+    expect(getCdnUrlForBuiltFile('_vercel/immutable/initial/nitro/index-abc123.js', CDN)).toBe(","+      `${CDN}/_vercel/immutable/initial/nitro/index-abc123.js`","+    )","+    expect(getCdnUrlForBuiltFile('_vercel/immutable/initial/nitro/font-abc123.woff2', CDN)).toBe(","+      `${CDN}/_vercel/immutable/initial/nitro/font-abc123.woff2`","+    )","+  })","+","+  it('keeps workers on the host', () => {","+    expect(","+      getCdnUrlForBuiltFile('_vercel/immutable/initial/nitro/json.worker-abc123.js', CDN)","+    ).toBeUndefined()","+  })","+","+  it('keeps files outside the immutable store on the host', () => {","+    expect(getCdnUrlForBuiltFile('assets/index-abc123.js', CDN)).toBeUndefined()","+  })","+","+  it('is undefined when the CDN is disabled', () => {","+    expect(","+      getCdnUrlForBuiltFile('_vercel/immutable/initial/nitro/index-abc123.js', undefined)","+    ).toBeUndefined()","+  })","+})","+","+describe('toCdnAssetUrl', () => {","+  it('strips the base path from manifest URLs', () => {","+    expect(","+      toCdnAssetUrl('/dashboard/_vercel/immutable/initial/nitro/index-abc.js', CDN, '/dashboard')","+    ).toBe(`${CDN}/_vercel/immutable/initial/nitro/index-abc.js`)","+  })","+","+  it('works without a base path', () => {","+    expect(toCdnAssetUrl('/_vercel/immutable/initial/nitro/index-abc.js', CDN)).toBe(","+      `${CDN}/_vercel/immutable/initial/nitro/index-abc.js`","+    )","+  })","+","+  it('leaves other URLs unchanged', () => {","+    expect(toCdnAssetUrl('/dashboard/favicon/favicon.ico', CDN, '/dashboard')).toBe(","+      '/dashboard/favicon/favicon.ico'","+    )","+    expect(toCdnAssetUrl('/other/_vercel/immutable/x.js', CDN, '/dashboard')).toBe(","+      '/other/_vercel/immutable/x.js'","+    )","+    expect(","+      toCdnAssetUrl(","+        '/dashboard/_vercel/immutable/initial/nitro/json.worker-abc.js',","+        CDN,","+        '/dashboard'","+      )","+    ).toBe('/dashboard/_vercel/immutable/initial/nitro/json.worker-abc.js')","+    expect(","+      toCdnAssetUrl(","+        '/dashboard/_vercel/immutable/initial/nitro/index-abc.js',","+        undefined,","+        '/dashboard'","+      )","+    ).toBe('/dashboard/_vercel/immutable/initial/nitro/index-abc.js')","+  })","+})"],"additions":130,"deletions":0,"truncated":false},{"path":"apps/studio/asset-cdn.ts","lines":["@@ -0,0 +1,69 @@","+type Env = Record<string, string | undefined>","+","+/**","+ * Origin of the Cloudflare R2 asset CDN, or `undefined` when assets are served","+ * by the host. Enabled on production deployments or with `FORCE_ASSET_CDN=1`;","+ * `FORCE_ASSET_CDN=-1` (e.g. self-hosted) always disables it.","+ */","+export function getAssetCdnOrigin(env: Env = process.env): string | undefined {","+  if (env.FORCE_ASSET_CDN === '-1') return undefined","+  if (env.FORCE_ASSET_CDN !== '1' && env.VERCEL_ENV !== 'production') return undefined","+","+  return env.NEXT_PUBLIC_ENVIRONMENT === 'staging'","+    ? 'https://frontend-assets.supabase.green'","+    : 'https://frontend-assets.supabase.com'","+}","+","+/**","+ * CDN base for the TanStack build's client assets. The folder is shared by","+ * every deployment rather than keyed by commit: the files under it are","+ * content-hashed, so identical chunks dedupe across deploys, and a tab opened","+ * on an older deployment keeps finding its lazy chunks no matter which","+ * deployment serves the next document. Must match the destination in","+ * `scripts/upload-static-assets.sh`.","+ */","+export function getTanstackAssetCdnUrl(env: Env = process.env): string | undefined {","+  const origin = getAssetCdnOrigin(env)","+  if (!origin) return undefined","+  return `${origin}/${env.SITE_NAME || 'studio'}/tanstack`","+}","+","+/**","+ * Nitro's Vercel immutable store, the only directory uploaded to the CDN.","+ * Anything outside it (public files, non-Vercel builds) stays on the host.","+ */","+const IMMUTABLE_ASSETS_DIR = '_vercel/immutable/'","+","+/**","+ * Web workers (Vite `?worker` output, e.g. graphiql's Monaco workers) must","+ * stay same-origin: browsers refuse to construct a Worker from a cross-origin","+ * script, and the CSP only allows `worker-src 'self' blob: data:`.","+ */","+export function isWorkerAsset(filename: string): boolean {","+  return /\\.worker-[\\w-]+\\.js$/.test(filename)","+}","+","+/**","+ * CDN URL for a built client file, given its path relative to the output root","+ * (`_vercel/immutable/<salt>/nitro/<file>`), or `undefined` to keep the host URL.","+ */","+export function getCdnUrlForBuiltFile(","+  filename: string,","+  cdnUrl: string | undefined","+): string | undefined {","+  if (!cdnUrl || !filename.startsWith(IMMUTABLE_ASSETS_DIR) || isWorkerAsset(filename)) {","+    return undefined","+  }","+  return `${cdnUrl}/${filename}`","+}","+","+/**","+ * Rewrites an absolute asset URL from TanStack Start's manifest","+ * (`${basePath}/_vercel/immutable/...`) to the CDN, returning it unchanged when","+ * it isn't an uploaded asset.","+ */","+export function toCdnAssetUrl(url: string, cdnUrl: string | undefined, basePath = ''): string {","+  const prefix = `${basePath}/`","+  if (!url.startsWith(prefix)) return url","+  return getCdnUrlForBuiltFile(url.slice(prefix.length), cdnUrl) ?? url","+}"],"additions":69,"deletions":0,"truncated":false},{"path":"apps/studio/next.config.ts","lines":["@@ -4,6 +4,7 @@ import bundleAnalyzer from '@next/bundle-analyzer'"," import { withSentryConfig } from '@sentry/nextjs'"," import type { NextConfig } from 'next'"," ","+import { getAssetCdnOrigin } from './asset-cdn'"," import { getCSP } from './csp'"," import {","   getMaintenanceRedirects,","@@ -17,22 +18,10 @@ const withBundleAnalyzer = bundleAnalyzer({"," })"," "," function getAssetPrefix() {","-  // If not force enabled, but not production env, disable CDN","-  if (process.env.FORCE_ASSET_CDN !== '1' && process.env.VERCEL_ENV !== 'production') {","-    return undefined","-  }","+  const assetCdnOrigin = getAssetCdnOrigin()","+  if (!assetCdnOrigin) return undefined"," ","-  // Force disable CDN","-  if (process.env.FORCE_ASSET_CDN === '-1') {","-    return undefined","-  }","-","-  const SUPABASE_ASSETS_URL =","-    process.env.NEXT_PUBLIC_ENVIRONMENT === 'staging'","-      ? 'https://frontend-assets.supabase.green'","-      : 'https://frontend-assets.supabase.com'","-","-  return `${SUPABASE_ASSETS_URL}/${process.env.SITE_NAME}/${process.env.VERCEL_GIT_COMMIT_SHA?.substring(0, 12) ?? 'unknown'}`","+  return `${assetCdnOrigin}/${process.env.SITE_NAME}/${process.env.VERCEL_GIT_COMMIT_SHA?.substring(0, 12) ?? 'unknown'}`"," }"," "," const isPlatform = process.env.NEXT_PUBLIC_IS_PLATFORM === 'true'"],"additions":4,"deletions":15,"truncated":false},{"path":"apps/studio/package.json","lines":["@@ -13,7 +13,7 @@","     \"build:next\": \"next build && if [ \\\"$SKIP_ASSET_UPLOAD\\\" != \\\"1\\\" ]; then ./../../scripts/upload-static-assets.sh; fi\",","     \"start:next\": \"next start -p 8082\",","     \"dev:tanstack\": \"NODE_OPTIONS=--max-old-space-size=8192 vite dev --port ${STUDIO_PORT:-8082}\",","-    \"build:tanstack\": \"vite build --mode ${MODE:-production}\",","+    \"build:tanstack\": \"vite build --mode ${MODE:-production} && if [ \\\"$SKIP_ASSET_UPLOAD\\\" != \\\"1\\\" ]; then ./../../scripts/upload-static-assets.sh tanstack; fi\",","     \"start:tanstack\": \"node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.${MODE:-production} --env-file-if-exists=.env.${MODE:-production}.local .output/server/index.mjs\",","     \"lint\": \"eslint .\",","     \"lint:ratchet\": \"tsx node_modules/eslint-config-supabase/ratchet-eslint-rules.ts --rules-file scripts/ratchet-rules.json --rules-file node_modules/eslint-config-supabase/ratchet-rules.json\","],"additions":1,"deletions":1,"truncated":false},{"path":"apps/studio/server.ts","lines":["@@ -3,11 +3,34 @@"," import './instrument.server.mjs'"," "," import { wrapFetchWithSentry } from '@sentry/tanstackstart-react'","-import handler, { createServerEntry, type ServerEntry } from '@tanstack/react-start/server-entry'","+import { createStartHandler, defaultStreamHandler } from '@tanstack/react-start/server'","+import { createServerEntry, type ServerEntry } from '@tanstack/react-start/server-entry'","+","+import { toCdnAssetUrl } from './asset-cdn'","+","+// Inlined by vite.config.ts so the document (prerendered `_shell.html`) and the","+// client bundle's `renderBuiltUrl` always agree on the CDN base.","+declare const __STUDIO_ASSET_CDN_URL__: string | undefined","+","+const assetCdnUrl = __STUDIO_ASSET_CDN_URL__","+const basePath = process.env.NEXT_PUBLIC_BASE_PATH","+","+const handler = createStartHandler({","+  handler: defaultStreamHandler,","+  ...(assetCdnUrl && {","+    transformAssets: ({ url, kind }) => {","+      const href = toCdnAssetUrl(url, assetCdnUrl, basePath)","+      // Cross-origin module scripts need CORS, and it also keeps error","+      // details (not just \"Script error.\") visible to Sentry.","+      if (href === url || kind === 'css-url') return { href }","+      return { href, crossOrigin: 'anonymous' }","+    },","+  }),","+})"," "," const requestHandler: ServerEntry = wrapFetchWithSentry({","   fetch(request: Request) {","-    return handler.fetch(request)","+    return handler(request)","   },"," })"," "],"additions":25,"deletions":2,"truncated":false},{"path":"apps/studio/vite.config.ts","lines":["@@ -12,6 +12,7 @@ import viteReact from '@vitejs/plugin-react'"," import { nitro } from 'nitro/vite'"," import { defineConfig, loadEnv, type Plugin } from 'vite'"," ","+import { getCdnUrlForBuiltFile, getTanstackAssetCdnUrl } from './asset-cdn'"," import { vercelSpaRoutes } from './scripts/vercel-spa-routes'"," import { getSecurityHeaders } from './security-headers'"," ","@@ -552,6 +553,14 @@ export default defineConfig(({ command, mode }) => {","   // root path. vercel-spa-routes rewrites the browser's prefixed asset URLs","   // to that root path, including assets retained from older deployments.","   const basePath = env.NEXT_PUBLIC_BASE_PATH || undefined","+  // Client JS/CSS (and CSS-referenced fonts/images) load from the R2 asset CDN","+  // on production builds, uploaded by scripts/upload-static-assets.sh. Vite's","+  // base stays `/dashboard` so documents, server functions and API routes stay","+  // on Vercel. The shell's asset tags are rewritten by server.ts. Reads the","+  // process env, not `env`: the upload script only sees the process env, so a","+  // CDN switch set in a `.env*` file must not point the build at assets that","+  // were never uploaded.","+  const assetCdnUrl = command === 'build' ? getTanstackAssetCdnUrl(process.env) : undefined","   const shouldUploadSourceMaps =","     process.env.SKIP_ASSET_UPLOAD !== '1' && !!process.env.SENTRY_AUTH_TOKEN"," ","@@ -646,7 +655,19 @@ export default defineConfig(({ command, mode }) => {","     define: {","       ...publicEnvDefines,","       ...sharedDefines,","+      __STUDIO_ASSET_CDN_URL__: JSON.stringify(assetCdnUrl) ?? 'undefined',","     },","+    ...(assetCdnUrl && {","+      experimental: {","+        // Absolute CDN URLs for client assets referenced from JS and CSS. With","+        // this set, Vite's preload helper resolves a lazy chunk's deps against","+        // the importing chunk's URL, so they follow it to the CDN.","+        renderBuiltUrl(filename: string, { ssr }: { ssr: boolean }) {","+          if (ssr) return","+          return getCdnUrlForBuiltFile(filename, assetCdnUrl)","+        },","+      },","+    }),","     // Circular-dep workaround: pin shared library code into dedicated","     // chunks so per-component chunks don't import from a chunk that","     // (transitively) imports them back."],"additions":21,"deletions":0,"truncated":false},{"path":"apps/www/turbo-build.test.ts","lines":["@@ -181,6 +181,8 @@ function build(env: Partial<NodeJS.ProcessEnv> = {}, rootCommand = false) {","         VERCEL_GIT_COMMIT_SHA: '1111111111111111111111111111111111111111',","         SITE_NAME: 'www',","         ASSET_CDN_S3_ENDPOINT: 'https://example.invalid',","+        AWS_ACCESS_KEY_ID: 'test-access-key-id',","+        AWS_SECRET_ACCESS_KEY: 'test-secret-access-key',","         PATH: `${path.join(fixture, 'node_modules/.bin')}${path.delimiter}${process.env.PATH}`,","         ...env,","       },"],"additions":2,"deletions":0,"truncated":false},{"path":"scripts/upload-static-assets.sh","lines":["@@ -35,6 +35,15 @@ if [[ \"$FORCE_ASSET_CDN\" != \"1\" ]] && [[ \"$VERCEL_ENV\" != \"production\" ]]; then","     exit 0"," fi"," ","+# The build already points at the CDN at this point, so a missing credential","+# must fail the build rather than skip the upload.","+for var in ASSET_CDN_S3_ENDPOINT AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do","+    if [[ -z \"${!var}\" ]]; then","+        echo \"Asset CDN upload is enabled but $var is not set. Set the R2 credentials for this environment, or FORCE_ASSET_CDN=-1 to disable the asset CDN.\"","+        exit 1","+    fi","+done","+"," # Set the cdnBucket variable based on NEXT_PUBLIC_ENVIRONMENT"," if [[ \"$NEXT_PUBLIC_ENVIRONMENT\" == \"staging\" ]]; then","   BUCKET_NAME=\"frontend-assets-staging\"","@@ -59,6 +68,36 @@ if ! command -v aws &> /dev/null; then","     rm awscliv2.zip"," fi"," ","+# TanStack Start builds (Studio): upload Nitro's Vercel immutable store, whose","+# files are content-hashed, to a folder shared by every deployment (see","+# apps/studio/asset-cdn.ts). Shared rather than per-commit so unchanged chunks","+# dedupe and older tabs keep resolving their lazy chunks. The files also stay in","+# the Vercel output: web workers must be served same-origin.","+if [[ \"$1\" == \"tanstack\" ]]; then","+    IMMUTABLE_DIR=\".vercel/output/static/_vercel/immutable\"","+    if [ ! -d \"$IMMUTABLE_DIR\" ]; then","+        echo -e \"${YELLOW}Directory $IMMUTABLE_DIR not found!${NC}\"","+        echo \"Make sure the TanStack build ran for Vercel with immutable static files enabled.\"","+        exit 1","+    fi","+","+    # Names are content hashes, so an existing object never needs replacing:","+    # --size-only skips files a previous deployment already uploaded (the","+    # default mtime check would re-upload every freshly built file). Source","+    # maps are uploaded to Sentry, never published.","+    echo -e \"${YELLOW}Uploading immutable static files to R2...${NC}\"","+    aws s3 sync \"$IMMUTABLE_DIR\" \"s3://$BUCKET_NAME/${SITE_NAME:-studio}/tanstack/_vercel/immutable\" \\","+        --size-only \\","+        --exclude \"*.map\" \\","+        --endpoint-url \"$ASSET_CDN_S3_ENDPOINT\" \\","+        --cache-control \"public,max-age=31536000,immutable\" \\","+        --region auto \\","+        --only-show-errors","+","+    echo -e \"${GREEN}Upload completed successfully!${NC}\"","+    exit 0","+fi","+"," # Check if directory exists"," if [ ! -d \"$STATIC_DIR\" ]; then","     echo -e \"${YELLOW}Directory $STATIC_DIR not found!${NC}\"",""],"additions":39,"deletions":0,"truncated":false}],"additions":293,"deletions":19,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-28T14:42:40.039193+00:00"}