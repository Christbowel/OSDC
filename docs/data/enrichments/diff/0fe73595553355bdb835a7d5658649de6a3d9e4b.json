rememberLoginSectionTitle } from './loginSectionTitle';","+import { contextSrv, RedirectToUrlKey } from './context_srv';","+import {","+  clearLoginSectionTitle,","+  getLoginSectionTitle,","+  rememberLoginDashboardTitle,","+  rememberLoginSectionTitle,","+} from './loginSectionTitle';"," "," const originalSubUrl = config.appSubUrl;"," ","@@ -103,3 +108,102 @@ it('falls back when login tab title preservation is disabled', () => {","   setTestFlags({ [FlagKeys.GrafanaPreserveLoginTabTitle]: false });","   expect(getLoginSectionTitle()).toBeUndefined();"," });","+","+describe('dashboard names', () => {","+  const originalSignedIn = contextSrv.user.isSignedIn;","+  const originalOrgId = contextSrv.user.orgId;","+  const pathname = '/d/abc/api-latency';","+","+  beforeEach(() => {","+    contextSrv.user.isSignedIn = true;","+    contextSrv.user.orgId = 1;","+    setTestFlags({","+      [FlagKeys.GrafanaPreserveLoginTabTitle]: true,","+      [FlagKeys.GrafanaPreserveDashboardLoginTabTitle]: true,","+    });","+    rememberLoginSectionTitle({ id: 'dashboards/browse', text: 'Dashboards' }, pathname);","+    sessionStorage.setItem(RedirectToUrlKey, encodeURIComponent(`/grafana${pathname}?orgId=1`));","+  });","+","+  afterEach(() => {","+    contextSrv.user.isSignedIn = originalSignedIn;","+    contextSrv.user.orgId = originalOrgId;","+  });","+","+  it('uses the actual dashboard name and updates it after a rename', () => {","+    rememberLoginDashboardTitle('Mimir / Writes', pathname);","+    expect(getLoginSectionTitle()).toBe('Mimir / Writes');","+    rememberLoginSectionTitle({ id: 'dashboards/browse', text: 'Dashboards' }, pathname);","+    expect(getLoginSectionTitle()).toBe('Mimir / Writes');","+    rememberLoginDashboardTitle('Mimir / Renamed', pathname);","+    expect(getLoginSectionTitle()).toBe('Mimir / Renamed');","+  });","+","+  it.each([","+    [false, true],","+    [true, false],","+  ])('does not store names with section flag %s and dashboard flag %s', (section, dashboard) => {","+    setTestFlags({","+      [FlagKeys.GrafanaPreserveLoginTabTitle]: section,","+      [FlagKeys.GrafanaPreserveDashboardLoginTabTitle]: dashboard,","+    });","+    rememberLoginDashboardTitle('Sensitive name', pathname);","+    expect(JSON.parse(sessionStorage.getItem('grafana.loginSection')!)).toEqual({","+      navId: 'dashboards/browse',","+      pathname,","+      appSubUrl: '/grafana',","+    });","+  });","+","+  it('does not capture names while signed out', () => {","+    contextSrv.user.isSignedIn = false;","+    rememberLoginDashboardTitle('Sensitive name', pathname);","+    expect(getLoginSectionTitle()).toBe('Dashboards');","+    expect(sessionStorage.getItem('grafana.loginSection')).not.toContain('Sensitive name');","+  });","+","+  it('falls back to the generic label when dashboard retention is disabled', () => {","+    rememberLoginDashboardTitle('Mimir / Writes', pathname);","+    setTestFlags({ [FlagKeys.GrafanaPreserveLoginTabTitle]: true });","+    expect(getLoginSectionTitle()).toBe('Dashboards');","+    rememberLoginSectionTitle({ id: 'dashboards/browse', text: 'Dashboards' }, pathname);","+    expect(sessionStorage.getItem('grafana.loginSection')).not.toContain('Mimir / Writes');","+  });","+","+  it('discards the dashboard name when navigating to another section', () => {","+    rememberLoginDashboardTitle('Mimir / Writes', pathname);","+    rememberLoginSectionTitle({ id: 'explore', text: 'Explore' }, '/explore');","+    rememberLoginDashboardTitle('Wrong section name', '/explore');","+    sessionStorage.setItem(RedirectToUrlKey, encodeURIComponent('/grafana/explore'));","+    expect(getLoginSectionTitle()).toBe('Explore');","+    expect(sessionStorage.getItem('grafana.loginSection')).not.toContain('Mimir / Writes');","+  });","+","+  it('does not associate a name with another dashboard path', () => {","+    rememberLoginDashboardTitle('Wrong dashboard', '/d/other/title');","+    expect(getLoginSectionTitle()).toBe('Dashboards');","+    expect(sessionStorage.getItem('grafana.loginSection')).not.toContain('Wrong dashboard');","+  });","+","+  it('does not reuse a dashboard name for another organization', () => {","+    rememberLoginDashboardTitle('Mimir / Writes', pathname);","+    sessionStorage.setItem(RedirectToUrlKey, encodeURIComponent(`/grafana${pathname}?orgId=2`));","+    expect(getLoginSectionTitle()).toBe('Dashboards');","+    contextSrv.user.orgId = 2;","+    rememberLoginSectionTitle({ id: 'dashboards/browse', text: 'Dashboards' }, pathname);","+    expect(sessionStorage.getItem('grafana.loginSection')).not.toContain('Mimir / Writes');","+  });","+","+  it('clears a remembered name with the existing section cleanup', () => {","+    rememberLoginDashboardTitle('Mimir / Writes', pathname);","+    clearLoginSectionTitle();","+    expect(sessionStorage.getItem('grafana.loginSection')).toBeNull();","+  });","+","+  it('replaces malformed metadata during navigation', () => {","+    sessionStorage.setItem('grafana.loginSection', '{');","+    rememberLoginSectionTitle({ id: 'dashboards/browse', text: 'Dashboards' }, pathname);","+    rememberLoginDashboardTitle('Mimir / Writes', pathname);","+    expect(getLoginSectionTitle()).toBe('Mimir / Writes');","+  });","+});"],"additions":106,"deletions":2,"truncated":false},{"path":"public/app/core/services/loginSectionTitle.ts","lines":["@@ -4,10 +4,18 @@ import { FlagKeys, getFeatureFlagClient } from '@grafana/runtime/internal';"," "," import { getNavTitle } from '../utils/navBarItem-translations';"," ","-import { RedirectToUrlKey } from './context_srv';","+import { contextSrv, RedirectToUrlKey } from './context_srv';"," "," const storageKey = 'grafana.loginSection';"," ","+function readSavedSection() {","+  try {","+    return JSON.parse(window.sessionStorage.getItem(storageKey) ?? 'null');","+  } catch {","+    return undefined;","+  }","+}","+"," export function rememberLoginSectionTitle(node: NavModelItem | undefined, pathname: string) {","   // Only catalogue labels are retained; node.text can contain user-created names.","   while (node && !getNavTitle(node.id)) {","@@ -16,9 +24,19 @@ export function rememberLoginSectionTitle(node: NavModelItem | undefined, pathna"," ","   try {","     if (node?.id) {","+      const saved = readSavedSection();","+      // Chrome updates must not erase a dashboard name captured by its renderer.","+      const dashboard =","+        getFeatureFlagClient().getBooleanValue(FlagKeys.GrafanaPreserveDashboardLoginTabTitle, false) &&","+        saved?.navId === node.id &&","+        saved.pathname === pathname &&","+        saved.appSubUrl === config.appSubUrl &&","+        saved.dashboard?.orgId === contextSrv.user.orgId","+          ? saved.dashboard","+          : undefined;","       window.sessionStorage.setItem(","         storageKey,","-        JSON.stringify({ navId: node.id, pathname, appSubUrl: config.appSubUrl })","+        JSON.stringify({ navId: node.id, pathname, appSubUrl: config.appSubUrl, dashboard })","       );","     } else {","       clearLoginSectionTitle();","@@ -28,6 +46,28 @@ export function rememberLoginSectionTitle(node: NavModelItem | undefined, pathna","   }"," }"," ","+export function rememberLoginDashboardTitle(title: string, pathname: string) {","+  if (","+    !getFeatureFlagClient().getBooleanValue(FlagKeys.GrafanaPreserveLoginTabTitle, false) ||","+    !getFeatureFlagClient().getBooleanValue(FlagKeys.GrafanaPreserveDashboardLoginTabTitle, false) ||","+    !contextSrv.user.isSignedIn","+  ) {","+    return;","+  }","+","+  try {","+    const saved = readSavedSection();","+    if (saved?.navId === 'dashboards/browse' && saved.pathname === pathname && saved.appSubUrl === config.appSubUrl) {","+      window.sessionStorage.setItem(","+        storageKey,","+        JSON.stringify({ ...saved, dashboard: { title, orgId: contextSrv.user.orgId } })","+      );","+    }","+  } catch {","+    // Remembering a dashboard name must not prevent rendering when storage is unavailable.","+  }","+}","+"," export function clearLoginSectionTitle() {","   try {","     window.sessionStorage.removeItem(storageKey);","@@ -36,13 +76,15 @@ export function clearLoginSectionTitle() {","   }"," }"," ","-export function getLoginSectionTitle(): string | undefined {","+export function getLoginSectionTitle(","+  preserveDashboardTitle = getFeatureFlagClient().getBooleanValue(FlagKeys.GrafanaPreserveDashboardLoginTabTitle, false)","+): string | undefined {","   if (!getFeatureFlagClient().getBooleanValue(FlagKeys.GrafanaPreserveLoginTabTitle, false)) {","     return undefined;","   }"," ","   try {","-    const saved = JSON.parse(window.sessionStorage.getItem(storageKey) ?? 'null');","+    const saved = readSavedSection();","     const redirect = window.sessionStorage.getItem(RedirectToUrlKey);","     if (!saved || !redirect || typeof saved.navId !== 'string' || saved.appSubUrl !== config.appSubUrl) {","       return undefined;","@@ -59,7 +101,19 @@ export function getLoginSectionTitle(): string | undefined {","     // Section metadata is saved during navigation, independently of the login redirect.","     // Section metadata is saved during navigation, independently of the login redirect because we need navigationNode.navId to build the title.","     // We only use it when the saved pathname matches the actual redirect destination. It may not match in case user is not logged out from Grafana but when opening a new tab and trying to access a new page while logged out. In that case nothing updated the `grafana.loginSection` yet and so we don't show any title, which is expected.","-    return pathname === saved.pathname ? getNavTitle(saved.navId) : undefined;","+    if (pathname !== saved.pathname) {","+      return undefined;","+    }","+    if (","+      preserveDashboardTitle &&","+      saved.navId === 'dashboards/browse' &&","+      typeof saved.dashboard?.title === 'string' &&","+      saved.dashboard.title &&","+      (!url.searchParams.has('orgId') || Number(url.searchParams.get('orgId')) === saved.dashboard.orgId)","+    ) {","+      return saved.dashboard.title;","+    }","+    return getNavTitle(saved.navId);","   } catch {","     return undefined;","   }"],"additions":59,"deletions":5,"truncated":false},{"path":"public/app/features/dashboard-scene/scene/DashboardSceneRenderer.test.tsx","lines":["@@ -0,0 +1,73 @@","+import { act } from '@testing-library/react';","+import { render } from 'test/test-utils';","+","+import { config, setPluginLinksHook } from '@grafana/runtime';","+import { FlagKeys } from '@grafana/runtime/internal';","+import { setTestFlags } from '@grafana/test-utils/unstable';","+import { contextSrv, RedirectToUrlKey } from 'app/core/services/context_srv';","+import { getLoginSectionTitle } from 'app/core/services/loginSectionTitle';","+","+import { DashboardScene } from './DashboardScene';","+import { DashboardSceneRenderer } from './DashboardSceneRenderer';","+","+setPluginLinksHook(() => ({ links: [], isLoading: false }));","+","+describe('DashboardSceneRenderer login title', () => {","+  const originalSignedIn = contextSrv.user.isSignedIn;","+  const originalSubUrl = config.appSubUrl;","+","+  beforeEach(() => {","+    contextSrv.user.isSignedIn = true;","+    config.appSubUrl = '';","+    sessionStorage.clear();","+    setTestFlags({","+      [FlagKeys.GrafanaPreserveLoginTabTitle]: true,","+      [FlagKeys.GrafanaPreserveDashboardLoginTabTitle]: true,","+    });","+  });","+","+  afterEach(() => {","+    contextSrv.user.isSignedIn = originalSignedIn;","+    config.appSubUrl = originalSubUrl;","+    sessionStorage.clear();","+    act(() => setTestFlags({}));","+  });","+","+  function setup() {","+    const dashboard = new DashboardScene({ uid: 'abc', title: 'Mimir / Writes' });","+    const node = { id: 'dashboards/browse', text: 'Dashboards' };","+    render(<DashboardSceneRenderer model={dashboard} />, {","+      historyOptions: { initialEntries: ['/d/abc/writes'] },","+      preloadedState: { navIndex: { 'dashboards/browse': node } },","+    });","+    sessionStorage.setItem(RedirectToUrlKey, encodeURIComponent('/d/abc/writes'));","+    return dashboard;","+  }","+","+  it('remembers a renamed title without remounting the dashboard', () => {","+    const dashboard = setup();","+    expect(getLoginSectionTitle()).toBe('Mimir / Writes');","+","+    act(() => dashboard.setState({ title: 'Mimir / Reads' }));","+","+    expect(getLoginSectionTitle()).toBe('Mimir / Reads');","+  });","+","+  it('remembers the dashboard title when the original flag becomes enabled', async () => {","+    setTestFlags({","+      [FlagKeys.GrafanaPreserveLoginTabTitle]: false,","+      [FlagKeys.GrafanaPreserveDashboardLoginTabTitle]: true,","+    });","+    setup();","+    expect(sessionStorage.getItem('grafana.loginSection')).toBeNull();","+","+    await act(async () =>","+      setTestFlags({","+        [FlagKeys.GrafanaPreserveLoginTabTitle]: true,","+        [FlagKeys.GrafanaPreserveDashboardLoginTabTitle]: true,","+      })","+    );","+","+    expect(getLoginSectionTitle()).toBe('Mimir / Writes');","+  });","+});"],"additions":73,"deletions":0,"truncated":false},{"path":"public/app/features/dashboard-scene/scene/DashboardSceneRenderer.tsx","lines":["@@ -2,11 +2,16 @@ import { useEffect, useMemo, useRef } from 'react';"," import { useLocation, useParams } from 'react-router-dom-v5-compat';"," "," import { PageLayoutType } from '@grafana/data';"],"additions":0,"deletions":0,"truncated":false}],"additions":446,"deletions":15,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-03T16:48:31.102507+00:00"}