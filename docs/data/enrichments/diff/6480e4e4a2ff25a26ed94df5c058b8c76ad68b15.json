","+  /**","+   * List what the reviewer was asked to remember in conversations on GitHub.","+   *","+   * @param {string[]} params.queries - Queries generated by SDK Query class.","+   * @param {boolean} params.total - When false, the total is not calculated.","+   * @throws {AppwriteException}","+   * @returns {Promise<ReviewLearningList>}","+   */","+  listLearnings(","+    params: { queries?: string[]; total?: boolean } = {},","+  ): Promise<ReviewLearningList> {","+    const payload: Record<string, unknown> = {}","+    if (typeof params.queries !== 'undefined') {","+      payload['queries'] = params.queries","+    }","+    if (typeof params.total !== 'undefined') {","+      payload['total'] = params.total","+    }","+    return this.client.call(","+      'get',","+      this.uri('/reviews/learnings'),","+      this.headers(),","+      payload,","+    )","+  }","+","+  /**","+   * Delete a learning. Later reviews and answers no longer follow it.","+   *","+   * @param {string} params.learningId - Learning ID.","+   * @throws {AppwriteException}","+   * @returns {Promise<unknown>}","+   */","+  deleteLearning(params: { learningId: string }): Promise<unknown> {","+    const apiPath = '/reviews/learnings/{learningId}'.replace(","+      '{learningId}',","+      encodeURIComponent(params.learningId),","+    )","+    return this.client.call(","+      'delete',","+      this.uri(apiPath),","+      { ...this.headers(), 'content-type': 'application/json' },","+      {},","+    )","+  }","+","   private uri(apiPath: string): URL {","     return new URL(this.client.config.endpoint + apiPath)","   }"],"additions":47,"deletions":0,"truncated":false},{"path":"apps/console/src/lib/i18n/dictionaries/he/reviews.ts","lines":["@@ -217,4 +217,20 @@ export const heReviewsDictionary: Record<string, string> = {","   'New repositories will be reviewed': 'מאגרים חדשים ייסקרו',","   'New repositories will not be reviewed': 'מאגרים חדשים לא ייסקרו',","   'Failed to update new repositories