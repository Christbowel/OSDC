{"id":"9f779998d58bb10f1a8084ed05a4fff7909437b8","axis":"silent","repo":"kserve/kserve","sha":"9f779998d58bb10f1a8084ed05a4fff7909437b8","parsed":{"files":[{"path":"pkg/kernelcache/podconfig/registry.go","lines":["@@ -0,0 +1,122 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package podconfig","+","+import (","+\t\"errors\"","+\t\"fmt\"","+\t\"reflect\"","+\t\"strings\"","+","+\tcorev1 \"k8s.io/api/core/v1\"","+\t\"k8s.io/utils/ptr\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+\t\"github.com/kserve/kserve/pkg/kernelcache/registryauth\"","+)","+","+const (","+\tregistryVolume = \"mcv-registry-access\"","+\tregistryPath   = \"/var/run/secrets/mcv-registry\"","+)","+","+// ApplyCaptureRegistry mounts deferred registry access without changing the Pod identity.","+func ApplyCaptureRegistry(pod *corev1.PodSpec, container *corev1.Container, cfg v1beta1.KernelCacheRegistryConfig, secretName string) error {","+\tif err := cfg.Validate(); err != nil {","+\t\treturn err","+\t}","+\tsources := []corev1.VolumeProjection{}","+\tenv := []corev1.EnvVar{}","+\tswitch cfg.Auth.Type {","+\tcase \"\", v1beta1.KernelCacheRegistryAuthTypeNone:","+\tcase v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken:","+\t\tif cfg.Endpoint == \"\" || strings.ContainsAny(cfg.Endpoint, \"/ \\t\\n\") {","+\t\t\treturn errors.New(\"registry.endpoint must be a registry host with optional port\")","+\t\t}","+\t\tif secretName == \"\" {","+\t\t\treturn errors.New(\"capture registry access Secret name is required\")","+\t\t}","+\t\tsources = append(sources, corev1.VolumeProjection{Secret: &corev1.SecretProjection{","+\t\t\tLocalObjectReference: corev1.LocalObjectReference{Name: secretName}, Optional: ptr.To(true),","+\t\t\tItems: []corev1.KeyToPath{{Key: registryauth.AccessKey, Path: registryauth.AccessKey}},","+\t\t}})","+\t\tenv = append(env, corev1.EnvVar{Name: \"MCV_REGISTRY_ACCESS_FILE\", Value: registryPath + \"/\" + registryauth.AccessKey})","+\t\t// The webhook passes the operator-configured endpoint from the kernelcache","+\t\t// section of the inferenceservice-config ConfigMap as the allowlist.","+\t\tenv = append(env, corev1.EnvVar{Name: \"MCV_REGISTRY_ALLOWED_ENDPOINT\", Value: cfg.Endpoint})","+\tdefault:","+\t\treturn fmt.Errorf(\"unsupported registry.auth.type %q\", cfg.Auth.Type)","+\t}","+\tif ref := cfg.CAConfigMapRef; ref != nil {","+\t\tif ref.Name == \"\" || ref.Key == \"\" {","+\t\t\treturn errors.New(\"registry.caConfigMapRef requires name and key\")","+\t\t}","+\t\tsources = append(sources, corev1.VolumeProjection{ConfigMap: &corev1.ConfigMapProjection{LocalObjectReference: corev1.LocalObjectReference{Name: ref.Name}, Optional: ptr.To(true), Items: []corev1.KeyToPath{{Key: ref.Key, Path: \"ca.crt\"}}}})","+\t\tenv = append(env, corev1.EnvVar{Name: \"MCV_REGISTRY_CA_FILE\", Value: registryPath + \"/ca.crt\"})","+\t}","+\tif len(sources) == 0 {","+\t\treturn nil","+\t}","+\tvolume := corev1.Volume{Name: registryVolume, VolumeSource: corev1.VolumeSource{Projected: &corev1.ProjectedVolumeSource{Sources: sources}}}","+\tvolumeExists := false","+\tfor _, existing := range pod.Volumes {","+\t\tif existing.Name == registryVolume {","+\t\t\tif !reflect.DeepEqual(existing, volume) {","+\t\t\t\treturn fmt.Errorf(\"conflicting volume %q\", registryVolume)","+\t\t\t}","+\t\t\tvolumeExists = true","+\t\t}","+\t}","+","+\tvolumeMount := corev1.VolumeMount{Name: registryVolume, MountPath: registryPath, ReadOnly: true}","+\tvolumeMountExists := false","+\tfor _, existing := range container.VolumeMounts {","+\t\tif existing.Name != volumeMount.Name && existing.MountPath != volumeMount.MountPath {","+\t\t\tcontinue","+\t\t}","+\t\tif !reflect.DeepEqual(existing, volumeMount) {","+\t\t\treturn fmt.Errorf(\"conflicting volume mount %q\", registryVolume)","+\t\t}","+\t\tvolumeMountExists = true","+\t}","+","+\tenvToAdd := make([]corev1.EnvVar, 0, len(env))","+\tfor _, desired := range env {","+\t\tfound := false","+\t\tfor _, existing := range container.Env {","+\t\t\tif existing.Name != desired.Name {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif !reflect.DeepEqual(existing, desired) {","+\t\t\t\treturn fmt.Errorf(\"conflicting environment variable %q\", desired.Name)","+\t\t\t}","+\t\t\tfound = true","+\t\t}","+\t\tif !found {","+\t\t\tenvToAdd = append(envToAdd, desired)","+\t\t}","+\t}","+","+\tif !volumeExists {","+\t\tpod.Volumes = append(pod.Volumes, volume)","+\t}","+\tif !volumeMountExists {","+\t\tcontainer.VolumeMounts = append(container.VolumeMounts, volumeMount)","+\t}","+\tcontainer.Env = append(container.Env, envToAdd...)","+\treturn nil","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/podconfig/registry_test.go","lines":["@@ -0,0 +1,150 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package podconfig","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+)","+","+func TestCaptureRegistryProjection(t *testing.T) {","+\tcfg := v1beta1.KernelCacheRegistryConfig{","+\t\tEndpoint: \"registry.example:5000\",","+\t\tAuth: v1beta1.KernelCacheRegistryAuth{","+\t\t\tType:        v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken,","+\t\t\tPushRoleRef: &v1beta1.KernelCacheRegistryRoleRef{Kind: \"ClusterRole\", Name: \"registry-pusher\"},","+\t\t\tPullRoleRef: &v1beta1.KernelCacheRegistryRoleRef{Kind: \"ClusterRole\", Name: \"registry-puller\"},","+\t\t},","+\t\tCAConfigMapRef: &v1beta1.KernelCacheConfigMapKeyRef{Name: \"registry-ca\", Key: \"bundle\"},","+\t}","+\tpod := corev1.PodSpec{ServiceAccountName: \"runtime\"}","+\tcontainer := corev1.Container{Name: \"mcv\"}","+\trequire.NoError(t, ApplyCaptureRegistry(&pod, &container, cfg, \"capture-secret\"))","+\trequire.NoError(t, ApplyCaptureRegistry(&pod, &container, cfg, \"capture-secret\"))","+\trequire.Equal(t, \"runtime\", pod.ServiceAccountName)","+\trequire.Len(t, pod.Volumes, 1)","+\trequire.Len(t, pod.Volumes[0].Projected.Sources, 2)","+\trequire.Len(t, container.VolumeMounts, 1)","+\trequire.Len(t, container.Env, 3)","+\trequire.True(t, container.VolumeMounts[0].ReadOnly)","+\trequire.Equal(t, \"access.json\", pod.Volumes[0].Projected.Sources[0].Secret.Items[0].Key)","+\trequire.True(t, *pod.Volumes[0].Projected.Sources[0].Secret.Optional)","+\trequire.Nil(t, pod.Volumes[0].Projected.Sources[0].ServiceAccountToken)","+\trequire.Nil(t, pod.AutomountServiceAccountToken)","+}","+","+func TestCaptureRegistryCompletesPartialState(t *testing.T) {","+\tcfg := captureRegistryTestConfig()","+\tfullPod := corev1.PodSpec{}","+\tfullContainer := corev1.Container{Name: \"mcv\"}","+\trequire.NoError(t, ApplyCaptureRegistry(&fullPod, &fullContainer, cfg, \"capture-secret\"))","+","+\tt.Run(\"volume only\", func(t *testing.T) {","+\t\tpod := corev1.PodSpec{Volumes: append([]corev1.Volume(nil), fullPod.Volumes...)}","+\t\tcontainer := corev1.Container{Name: \"mcv\"}","+","+\t\trequire.NoError(t, ApplyCaptureRegistry(&pod, &container, cfg, \"capture-secret\"))","+\t\trequire.Equal(t, fullPod.Volumes, pod.Volumes)","+\t\trequire.Equal(t, fullContainer.VolumeMounts, container.VolumeMounts)","+\t\trequire.Equal(t, fullContainer.Env, container.Env)","+\t})","+","+\tt.Run(\"container configuration only\", func(t *testing.T) {","+\t\tpod := corev1.PodSpec{}","+\t\tcontainer := corev1.Container{","+\t\t\tName:         \"mcv\",","+\t\t\tVolumeMounts: append([]corev1.VolumeMount(nil), fullContainer.VolumeMounts...),","+\t\t\tEnv:          append([]corev1.EnvVar(nil), fullContainer.Env...),","+\t\t}","+","+\t\trequire.NoError(t, ApplyCaptureRegistry(&pod, &container, cfg, \"capture-secret\"))","+\t\trequire.Equal(t, fullPod.Volumes, pod.Volumes)","+\t\trequire.Equal(t, fullContainer.VolumeMounts, container.VolumeMounts)","+\t\trequire.Equal(t, fullContainer.Env, container.Env)","+\t})","+}","+","+func TestCaptureRegistryRejectsConflictsWithoutPartialMutation(t *testing.T) {","+\tfor _, test := range []struct {","+\t\tname      string","+\t\tpod       corev1.PodSpec","+\t\tcontainer corev1.Container","+\t\twant      string","+\t}{","+\t\t{","+\t\t\tname: \"volume\",","+\t\t\tpod: corev1.PodSpec{Volumes: []corev1.Volume{{","+\t\t\t\tName: registryVolume, VolumeSource: corev1.VolumeSource{EmptyDir: &corev1.EmptyDirVolumeSource{}},","+\t\t\t}}},","+\t\t\twant: \"conflicting volume\",","+\t\t},","+\t\t{","+\t\t\tname: \"volume mount\",","+\t\t\tcontainer: corev1.Container{VolumeMounts: []corev1.VolumeMount{{","+\t\t\t\tName: \"other\", MountPath: registryPath,","+\t\t\t}}},","+\t\t\twant: \"conflicting volume mount\",","+\t\t},","+\t\t{","+\t\t\tname: \"environment variable\",","+\t\t\tcontainer: corev1.Container{Env: []corev1.EnvVar{{","+\t\t\t\tName: \"MCV_REGISTRY_ALLOWED_ENDPOINT\", Value: \"other.example\",","+\t\t\t}}},","+\t\t\twant: \"conflicting environment variable\",","+\t\t},","+\t} {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\tpodBefore := test.pod.DeepCopy()","+\t\t\tcontainerBefore := test.container.DeepCopy()","+","+\t\t\terr := ApplyCaptureRegistry(&test.pod, &test.container, captureRegistryTestConfig(), \"capture-secret\")","+\t\t\trequire.ErrorContains(t, err, test.want)","+\t\t\trequire.Equal(t, podBefore, &test.pod)","+\t\t\trequire.Equal(t, containerBefore, &test.container)","+\t\t})","+\t}","+}","+","+func captureRegistryTestConfig() v1beta1.KernelCacheRegistryConfig {","+\treturn v1beta1.KernelCacheRegistryConfig{","+\t\tEndpoint: \"registry.example:5000\",","+\t\tAuth: v1beta1.KernelCacheRegistryAuth{","+\t\t\tType:        v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken,","+\t\t\tPushRoleRef: &v1beta1.KernelCacheRegistryRoleRef{Kind: \"ClusterRole\", Name: \"registry-pusher\"},","+\t\t\tPullRoleRef: &v1beta1.KernelCacheRegistryRoleRef{Kind: \"ClusterRole\", Name: \"registry-puller\"},","+\t\t},","+\t\tCAConfigMapRef: &v1beta1.KernelCacheConfigMapKeyRef{Name: \"registry-ca\", Key: \"bundle\"},","+\t}","+}","+","+func TestRegistryCAWithoutAuthentication(t *testing.T) {","+\tcfg := v1beta1.KernelCacheRegistryConfig{","+\t\tAuth:           v1beta1.KernelCacheRegistryAuth{Type: v1beta1.KernelCacheRegistryAuthTypeNone},","+\t\tCAConfigMapRef: &v1beta1.KernelCacheConfigMapKeyRef{Name: \"ca\", Key: \"bundle\"},","+\t}","+\tpod := corev1.PodSpec{}","+\tcontainer := corev1.Container{}","+\trequire.NoError(t, ApplyCaptureRegistry(&pod, &container, cfg, \"\"))","+\trequire.Len(t, container.Env, 1)","+\trequire.Equal(t, \"MCV_REGISTRY_CA_FILE\", container.Env[0].Name)","+\tcfg.Auth.Type = \"invalid\"","+\trequire.Error(t, ApplyCaptureRegistry(&pod, &container, cfg, \"\"))","+}"],"additions":150,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/registryauth/credentials.go","lines":["@@ -0,0 +1,159 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package registryauth","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"strings\"","+\t\"time\"","+","+\tcorev1 \"k8s.io/api/core/v1\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/client-go/kubernetes\"","+\t\"k8s.io/client-go/util/retry\"","+\tcontrollerclient \"sigs.k8s.io/controller-runtime/pkg/client\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+)","+","+// Credentials is called only after the registry reconciler verifies the Pod owner chain.","+// No callback endpoint is registered by this package.","+type Credentials struct {","+\tClient kubernetes.Interface","+}","+","+// IssueForCapture publishes a Secret-bound token using the registry identity","+// scoped to one KernelCacheCapture.","+func (c *Credentials) IssueForCapture(ctx context.Context, pod *corev1.Pod, captureName string, cfg v1beta1.KernelCacheRegistryConfig) (*corev1.Secret, error) {","+\tif captureName == \"\" {","+\t\treturn nil, errors.New(\"registry credential requires a capture name\")","+\t}","+\tif cfg.Auth.Type == \"\" || cfg.Auth.Type == v1beta1.KernelCacheRegistryAuthTypeNone {","+\t\treturn nil, nil","+\t}","+\tprovider, err := NewProvider(c.Client, cfg)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tlive, err := c.Client.CoreV1().Pods(pod.Namespace).Get(ctx, pod.Name, metav1.GetOptions{})","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tif live.UID != pod.UID || live.UID == \"\" || live.DeletionTimestamp != nil {","+\t\treturn nil, apierrors.NewResourceExpired(\"capture Pod is no longer active\")","+\t}","+\tname := accessSecretName(live)","+\tif !strings.HasPrefix(name, AccessNamePrefix) {","+\t\treturn nil, errors.New(\"capture Pod has no registry access Secret reference\")","+\t}","+\tsecrets := c.Client.CoreV1().Secrets(live.Namespace)","+\tsecret, err := secrets.Get(ctx, name, metav1.GetOptions{})","+\tif apierrors.IsNotFound(err) {","+\t\towner := metav1.NewControllerRef(live, corev1.SchemeGroupVersion.WithKind(\"Pod\"))","+\t\t// Access cleanup must not block runtime Pod deletion.","+\t\tblockOwnerDeletion := false","+\t\towner.BlockOwnerDeletion = &blockOwnerDeletion","+\t\tsecret, err = secrets.Create(ctx, &corev1.Secret{","+\t\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\t\tName: name, Namespace: live.Namespace,","+\t\t\t\tLabels:          map[string]string{ManagedLabel: \"true\"},","+\t\t\t\tOwnerReferences: []metav1.OwnerReference{*owner},","+\t\t\t},","+\t\t\tType: corev1.SecretTypeOpaque,","+\t\t\tData: map[string][]byte{AccessKey: []byte(\"{}\")},","+\t\t}, metav1.CreateOptions{})","+\t\tif apierrors.IsAlreadyExists(err) {","+\t\t\tsecret, err = secrets.Get(ctx, name, metav1.GetOptions{})","+\t\t}","+\t}","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tvar updated *corev1.Secret","+\terr = retry.RetryOnConflict(retry.DefaultRetry, func() error {","+\t\tcurrent, err := secrets.Get(ctx, name, metav1.GetOptions{})","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif !ownedByPod(current, live) || current.UID != secret.UID || current.DeletionTimestamp != nil {","+\t\t\treturn errors.New(\"registry access Secret does not belong to this capture Pod\")","+\t\t}","+\t\tvar existing RegistryCredential","+\t\tif json.Unmarshal(current.Data[AccessKey], &existing) == nil &&","+\t\t\texisting.Token != \"\" && existing.Registry == cfg.Endpoint && existing.ExpiresAt.After(time.Now().Add(time.Minute)) {","+\t\t\tupdated = current","+\t\t\treturn nil","+\t\t}","+\t\tcredential, err := provider.GetCredential(ctx, CredentialRequest{","+\t\t\tRegistry:           cfg.Endpoint,","+\t\t\tServiceAccountName: PusherServiceAccountName(captureName),","+\t\t\tSecret:             corev1.ObjectReference{APIVersion: \"v1\", Kind: \"Secret\", Namespace: current.Namespace, Name: current.Name, UID: current.UID},","+\t\t})","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tdata, err := json.Marshal(credential)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif current.Data == nil {","+\t\t\tcurrent.Data = map[string][]byte{}","+\t\t}","+\t\tcurrent.Data[AccessKey] = data","+\t\tupdated, err = secrets.Update(ctx, current, metav1.UpdateOptions{})","+\t\treturn err","+\t})","+\treturn updated, err","+}","+","+// Revoke deletes the bound object; clearing data alone does not revoke a token.","+func Revoke(ctx context.Context, c controllerclient.Client, pod *corev1.Pod) error {","+\tname := accessSecretName(pod)","+\tif name == \"\" {","+\t\treturn nil","+\t}","+\tsecret := &corev1.Secret{}","+\terr := c.Get(ctx, controllerclient.ObjectKey{Namespace: pod.Namespace, Name: name}, secret)","+\tif apierrors.IsNotFound(err) {","+\t\treturn nil","+\t}","+\tif err != nil {","+\t\treturn err","+\t}","+\tif !ownedByPod(secret, pod) {","+\t\treturn errors.New(\"registry access Secret does not belong to this capture Pod\")","+\t}","+\tuid := secret.UID","+\tresourceVersion := secret.ResourceVersion","+\treturn controllerclient.IgnoreNotFound(c.Delete(ctx, secret, controllerclient.Preconditions{","+\t\tUID:             &uid,","+\t\tResourceVersion: &resourceVersion,","+\t}))","+}","+","+func accessSecretName(pod *corev1.Pod) string {","+\treturn pod.Annotations[AccessSecretAnnotation]","+}","+","+func ownedByPod(secret *corev1.Secret, pod *corev1.Pod) bool {","+\towner := metav1.GetControllerOf(secret)","+\treturn pod.UID != \"\" && secret.Labels[ManagedLabel] == \"true\" &&","+\t\towner != nil && owner.APIVersion == \"v1\" && owner.Kind == \"Pod\" && owner.Name == pod.Name && owner.UID == pod.UID","+}"],"additions":159,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/registryauth/credentials_test.go","lines":["@@ -0,0 +1,136 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package registryauth","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+\tauthenticationv1 \"k8s.io/api/authentication/v1\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/types\"","+\t\"k8s.io/client-go/kubernetes/fake\"","+\tclienttesting \"k8s.io/client-go/testing\"","+\tcontrollerfake \"sigs.k8s.io/controller-runtime/pkg/client/fake\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+)","+","+func TestScopedPusherNamesUseSixByteDigest(t *testing.T) {","+\tconst captureName = \"model-kcc-abc123\"","+\tconst expected = \"kernel-cache-pusher-model-kcc-abc123-691719c36ce8\"","+","+\trequire.Equal(t, expected, PusherServiceAccountName(captureName))","+\trequire.Equal(t, expected, PusherRoleBindingName(captureName))","+}","+","+func TestServiceAccountTokenProviderRejectsExpirationBeyondRequestedTTL(