, error)","+}","+","+type NoAuthProvider struct{}","+","+func (NoAuthProvider) GetCredential(context.Context, CredentialRequest) (*RegistryCredential, error) {","+\treturn nil, nil","+}","+","+// ServiceAccountTokenProvider issues short-lived registry credentials through","+// the Kubernetes TokenRequest API.","+type ServiceAccountTokenProvider struct {","+\tClient     kubernetes.Interface","+\tTTLSeconds int64","+}","+","+func NewProvider(c kubernetes.Interface, cfg v1beta1.KernelCacheRegistryConfig) (RegistryAuthProvider, error) {","+\tif err := cfg.Validate(); err != nil {","+\t\treturn nil, err","+\t}","+\tswitch cfg.Auth.Type {","+\tcase \"\", v1beta1.KernelCacheRegistryAuthTypeNone:","+\t\treturn NoAuthProvider{}, nil","+\tcase v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken:","+\t\tttl := cfg.Auth.TokenTTLSeconds","+\t\tif ttl == 0 {","+\t\t\tttl = v1beta1.DefaultKernelCacheRegistryTokenTTLSeconds","+\t\t}","+\t\treturn &ServiceAccountTokenProvider{Client: c, TTLSeconds: ttl}, nil","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"unsupported registry authentication provider %q\", cfg.Auth.Type)","+\t}","+}","+","+func (p *ServiceAccountTokenProvider) GetCredential(ctx context.Context, req CredentialRequest) (*RegistryCredential, error) {","+\tref := req.Secret","+\tif ref.Kind != \"Secret\" || ref.APIVersion != \"v1\" || ref.Namespace == \"\" || ref.Name == \"\" || ref.UID == \"\" || req.Registry == \"\" || req.ServiceAccountName == \"\" {","+\t\treturn nil, errors.New(\"registry access requires an existing Secret name, namespace and UID\")","+\t}","+\tresult, err := p.Client.CoreV1().ServiceAccounts(ref.Namespace).CreateToken(ctx, req.ServiceAccountName, &authenticationv1.TokenRequest{","+\t\tSpec: authenticationv1.TokenRequestSpec{","+\t\t\tExpirationSeconds: &p.TTLSeconds,","+\t\t\tBoundObjectRef:    &authenticationv1.BoundObjectReference{Kind: \"Secret\", APIVersion: \"v1\", Name: ref.Name, UID: ref.UID},","+\t\t},","+\t}, metav1.CreateOptions{})","+\t