).WithObjects(pod, secret).Build()","+\trequests := 0","+\tclient.PrependReactor(\"create\", \"serviceaccounts\", func(action clienttesting.Action) (bool, runtime.Object, error) {","+\t\trequire.Equal(t, \"token\", action.GetSubresource())","+\t\tcreate := action.(clienttesting.CreateAction)","+\t\treq := create.GetObject().(*authenticationv1.TokenRequest)","+\t\trequire.Equal(t, PusherServiceAccountName(captureName), action.(clienttesting.CreateActionImpl).Name)","+\t\trequire.Equal(t, int64(600), *req.Spec.ExpirationSeconds)","+\t\trequire.Equal(t, \"Secret\", req.Spec.BoundObjectRef.Kind)","+\t\trequire.Equal(t, secret.UID, req.Spec.BoundObjectRef.UID)","+\t\trequests++","+\t\treturn true, &authenticationv1.TokenRequest{Status: authenticationv1.TokenRequestStatus{","+\t\t\tToken: \"test-token\", ExpirationTimestamp: metav1.NewTime(time.Now().Add(10 * time.Minute)),","+\t\t}}, nil","+\t})","+\tmanager := &Credentials{Client: client}","+\tcfg := v1beta1.KernelCacheRegistryConfig{","+\t\tEndpoint: \"registry.example:5000\",","+\t\tAuth: v1beta1.KernelCacheRegistryAuth{","+\t\t\tType:        v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken,","+\t\t\tPushRoleRef: &v1beta1.KernelCacheRegistryRoleRef{Kind: \"ClusterRole\", Name: \"registry-pusher\"},","+\t\t\tPullRoleRef: &v1beta1.KernelCacheRegistryRoleRef{Kind: \"ClusterRole\", Name: \"registry-puller\"},","+\t\t},","+\t}","+\tresult, err := manager.IssueForCapture(ctx, pod, captureName, cfg)","+\trequire.NoError(t, err)","+\tvar credential RegistryCredential","+\trequire.NoError(t, json.Unmarshal(result.Data[AccessKey], &credential))","+\trequire.Equal(t, \"test-token\", credential.Token)","+\t_, err = manager.IssueForCapture(ctx, pod, captureName, cfg)","+\trequire.NoError(t, err)","+\trequire.Equal(t, 1, requests)","+\tlive, err := client.CoreV1().Pods(\"team\").Get(ctx, \"runtime\", metav1.GetOptions{})","+\trequire.NoError(t, err)","+\trequire.Equal(t, \"default\", live.Spec.ServiceAccountName)","+\tother :