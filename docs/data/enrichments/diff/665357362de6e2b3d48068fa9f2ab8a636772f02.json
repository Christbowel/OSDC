s":18,"deletions":0,"truncated":false},{"path":"vllm/distributed/kv_transfer/kv_connector/v1/nixl/base_worker.py","lines":["@@ -60,6 +60,7 @@"," )"," from vllm.distributed.kv_transfer.kv_connector.v1.nixl.utils import (","     _NIXL_SUPPORTED_DEVICE,","+    get_dcp_replicated_group_ids,","     get_representative_spec_type,","     zmq_ctx,"," )","@@ -1066,6 +1067,11 @@ def __init__(","             get_representative_spec_type(g.kv_cache_spec)","             for g in self.kv_cache_config.transfer_groups","         )","+        # MLA drafts running at DCP=1 under a DCP target: a DCP peer holds","+        # them in full on every rank.","+        self._dcp_replicated_groups = get_dcp_replicated_group_ids(","+            self.kv_cache_config.transfer_groups","+        )","         # Per-region MLA flag, 1:1 with block_len_per_layer. True -> REPLICATE","         # (MLA), False -> SPLIT (head-sharded full-attn). Mixed only for models","         # combining both (e.g. GQA main + MLA Eagle-3 draft).","@@ -2759,6 +2765,15 @@ def _validate_remote_agent_handshake(","                 \"Hybrid MLA+Mamba NIXL transfers require matching DCP sizes, \"","                 f\"got local={self.dcp_size}, remote={remote_dcp_size}.\"","             )","+        if self._dcp_replicated_groups and (","+            self.dcp_size > 1 or (remote_dcp_size > 1 and self._TRANSFER_MODE != \"pull\")","+        ):","+            raise NotImplementedError(","+                \"NIXL with a DCP-replicated MLA draft cache only supports \"","+                \"pulling from a DCP prefill into a non-DCP decode: \"","+                f\"local DCP={self.dcp_size}, remote DCP={remote_dcp_size}, \"","+                f\"transfer_mode={self._TRANSFER_MODE}.\"","+            )"," ","         tp_ratio = self.transfer_topo.tp_ratio(remote_tp_size)","         block_size_ratio = self.transfer_topo.block_size_ratio("],"additions":15,"deletions":0,"truncated":false},{"path":"vllm/distributed/kv_transfer/kv_connector/v1/