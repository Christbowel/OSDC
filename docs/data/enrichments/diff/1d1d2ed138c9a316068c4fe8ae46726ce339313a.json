 throw new IllegalStateException(\"first attempt\");","+                            }","+                        }).id(\"flaky\")","+                        .to(\"mock:result\").id(\"result\");","+","+                // fails every attempt, so the dead letter channel handles it","+                from(\"direct:broken\").routeId(\"brokenRoute\")","+                        .throwException(new IllegalStateException(\"always\")).id(\"broken\");","+            }","+        };","+    }","+","+    @Test","+    void testRedeliveriesAndFailuresHandled() {","+        template.sendBody(\"direct:flaky\", \"a\");","+        template.sendBody(\"direct:flaky\", \"b\");","+        template.sendBody(\"direct:broken\", \"c\");","+","+        // the route counts the exchanges that completed after a redelivery, the processor each redelivery","+        JsonObject flaky = route(\"flakyRoute\");","+        JsonObject stats = flaky.getMap(\"statistics\");","+        Assertions.assertEquals(2, stats.getLong(\"redeliveries\"));","+        Assertions.assertEquals(0, stats.getLong(\"failuresHandled\"));","+        Assertions.assertEquals(0, stats.getLong(\"exchangesFailed\"));","+        Assertions.assertEquals(0, stats.getLong(\"externalRedeliveries\"));","+        // the redeliveries are counted at the step that was retried, not at the next one","+        Assertions.assertEquals(2, processor(flaky, \"flaky\").getLong(\"redeliveries\"));","+        Assertions.assertEquals(0, processor(flaky, \"result\").getLong(\"redeliveries\"));","+","+        JsonObject broken = route(\"brokenRoute\");","+        stats = broken.getMap(\"statistics\");","+        Assertions.assertEquals(1, stats.getLong(\"failuresHandled\"));","+        Assertions.assertEquals(0, stats.getLong(\"exchangesFailed\"));","+        JsonObject step = processor(broken, \"broken\");","+        Assertions.assertEquals(3, step.getLong(\"exchangesFailed\"));","+        Assertions.assertEquals(2, step.getLong(\"redeliveries\"));","+","+        String text = (String) console().call(DevConsole.MediaType.TEXT,","+                Map.of(RouteDevConsole.FILTER, \"brokenRoute\", RouteDevConsole.PROCESSORS, \"true\"));","+        Assertions.assertTrue(text.contains(\"Failures Handled: 1\"), text);","+        // the processor of the route, indented","+        Assertions.assertTrue(text.contains(\"        Redeliveries: 2\"), text);","+        Assertions.assertTrue(text.contains(\"External Redeliveries: 0\"), text);","+    }","+","+    private JsonObject route(String routeId) {","+        JsonObject out = (JsonObject) console().call(DevConsole.MediaType.JSON,","+                Map.of(RouteDevConsole.FILTER, routeId, RouteDevConsole.PROCESSORS, \"true\"));","+        return (JsonObject) ((JsonArray) out.getCollection(\"routes\")).get(0);","+    }","+","+    private static JsonObject processor(JsonObject route, String id) {","+        for (Object o : route.getCollection(\"processors\")) {","+            JsonObject p = (JsonObject) o;","+            if (id.equals(p.getString(\"id\"))) {","+                return p.getMap(\"statistics\");","+            }","+        }","+        throw new AssertionError(\"No processor \" + id + \" in \" + route);","+    }","+","+    private DevConsole console() {","+        return PluginHelper.getDevConsoleResolver(context).resolveDevConsole(\"route\");","+    }","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-plugin-tui/src/main/java/org/apache/camel/dsl/jbang/core/commands/tui/ProcessorInfo.java","lines":["@@ -29,6 +29,9 @@ class ProcessorInfo {","     int level;","     long total;","     long failed;","+    // the failures the error handler handled, and its redeliveries (CAMEL-26698)","+    long failuresHandled;","+    long redeliveries;","     long meanTime;","     long minTime;","     long maxTime;"],"additions":3,"deletions":0,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-plugin-tui/src/main/java/org/apache/camel/dsl