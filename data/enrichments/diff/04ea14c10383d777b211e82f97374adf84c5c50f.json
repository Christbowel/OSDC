y-codes/recovery-codes-status-query.ts","lines":["@@ -1,4 +1,5 @@"," import { useQuery } from '@tanstack/react-query'","+import { useUser } from 'common'"," "," import { recoveryCodeKeys } from './keys'"," import { handleError } from '@/data/fetchers'","@@ -23,11 +24,13 @@ export type RecoveryCodesError = ResponseError"," export const useRecoveryCodesStatusQuery = <TData = RecoveryCodesStatusData>({","   enabled = true,","   ...options","-}: UseCustomQueryOptions<RecoveryCodesStatusData, RecoveryCodesError, TData> = {}) =>","-  useQuery<RecoveryCodesStatusData, RecoveryCodesError, TData>({","-    queryKey: recoveryCodeKeys.status(),","+}: UseCustomQueryOptions<RecoveryCodesStatusData, RecoveryCodesError, TData> = {}) => {","+  const userId = useUser()?.id","+  return useQuery<RecoveryCodesStatusData, RecoveryCodesError, TData>({","+    queryKey: recoveryCodeKeys.status(userId),","     queryFn: () => getRecoveryCodesStatus(),","     staleTime: 1000 * 60 * 30,","     enabled,","     ...options,","   })","+}"],"additions":6,"deletions":3,"truncated":false},{"path":"apps/studio/hooks/misc/useAccountRecovery.test.tsx","lines":["@@ -0,0 +1,137 @@","+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'","+import { renderHook, waitFor } from '@testing-library/react'","+import { beforeEach, describe, expect, it, vi } from 'vitest'","+","+import { useAccountRecovery } from './useAccountRecovery'","+import { useMfaListFactorsQuery } from '@/data/profile/mfa-list-factors-query'","+import { useProfileIdentitiesQuery } from '@/data/profile/profile-identities-query'","+import { useRecoveryCodesStatusQuery } from '@/data/recovery-codes/recovery-codes-status-query'","+","+const mock = vi.hoisted(() => ({","+  userId: 'user-a',","+  hasSecuritySettings: true,","+  recoveryCodesEnabled: true,","+  passwordEnabled: true,","+  listFactors: vi.fn(),","+  getUser: vi.fn(),","+  getStatus: vi.fn(),","+}))","+","+vi.mock('common', () => ({","+  useFlag: (name: string) =>","+    name === 'enableAuthRecoveryCodes' ? mock.recoveryCodesEnabled : mock.passwordEnabled,","+  useUser: () => (mock.userId ? { id: mock.userId } : null),","+}))","+","+vi.mock('@/hooks/misc/useIsFeatureEnabled', () => ({","+  useIsFeatureEnabled: () => mock.hasSecuritySettings,","+}))","+","+vi.mock('@/lib/gotrue', () => ({","+  auth: {","+    mfa: { listFactors: mock.listFactors, recoveryCodes: { getStatus: mock.getStatus } },","+    getUser: mock.getUser,","+  },","+}))","+","+vi.mock('@/lib/constants', async (importOriginal) => ({","+  ...(await importOriginal<typeof import('@/lib/constants')>()),","+  IS_PLATFORM: true,","+}))","+","+const renderRecovery = () => {","+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } })","+  const wrapper = ({ children }: { children: React.ReactNode }) => (","+    <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>","+  )","+  return renderHook(() => useAccountRecovery(), { wrapper })","+}","+","+describe('useAccountRecovery', () => {","+  beforeEach(() => {","+    vi.clearAllMocks()","+    mock.userId = 'user-a'","+    mock.hasSecuritySettings = true","+    mock.recoveryCodesEnabled = true","+    mock.passwordEnabled = true","+    mock.listFactors.mockResolvedValue({","+      data: { all: [{ factor_type: 'totp', status: 'verified' }] },","+      error: null,","+    })","+    mock.getUser.mockResolvedValue({","+      data: { user: { identities: [{ provider: 'email' }], email: 'person@example.com' } },","+      error: null,","+    })","+    mock.getStatus.mockResolvedValue({ data: { remaining: 0 }, error: null })","+  })","+","+  it('waits for code status before showing a code or factor finding', async () => {","+    let resolveStatus: (value: unknown) => void = () => undefined","+    mock.getStatus.mockReturnValue(new Promise((resolve) => (resolveStatus = resolve)))","+    const { result } = renderRecovery()","+","+    await waitFor(() => expect(mock.getStatus).toHaveBeenCalledOnce())","+    expect(result.current).toMatchObject({ findings: [], isPending: true, isError: false })","+    resolveStatus({ data: { remaining: 0 }, error: null })","+    await waitFor(() => expect(result.current.findings[0]?.id).toBe('recovery-codes-exhausted'))","+    expect(result.current.isPending).toBe(false)","+  })","+","+  it('keeps the password finding independent of unavailable Security settings', async () => {","+    mock.hasSecuritySettings = false","+    mock.getUser.mockResolvedValue({","+      data: { user: { identities: [{ provider: 'github' }], email: 'person@example.com' } },","+      error: null,","+    })","+    const { result } = renderRecovery()","+    await waitFor(() => expect(result.current.findings[0]?.id).toBe('single-oauth-identity'))","+    expect(mock.listFactors).not.toHaveBeenCalled()","+    expect(mock.getStatus).not.toHaveBeenCalled()","+  })","+","+  it('does not treat a failed code read as missing codes', async () => {","+    mock.getStatus.mockResolvedValue({ data: null, error: new Error('Unavailable') })","+    const { result } = renderRecovery()","+    await waitFor(() => expect(result.current.isError).toBe(true))","+    expect(result.current.findings).toEqual([])","+  })","+","+  it('isolates existing callers that omit a user ID', async () => {","+    const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })","+    const { result, rerender } = renderHook(","+      () => ({","+        factors: useMfaListFactorsQuery(),","+        identities: useProfileIdentitiesQuery(),","+        codes: useRecoveryCodesStatusQuery(),","+      }),","+      {","+        wrapper: ({ children }) => (","+          <QueryClientProvider client={client}>{children}</QueryClientProvider>","+        ),","+      }","+    )","+    await waitFor(() => expect(result.current.codes.isSuccess).toBe(true))","+    await waitFor(() => expect(result.current.factors.isSuccess).toBe(true))","+    await waitFor(() => expect(result.current.identities.isSuccess).toBe(true))","+    mock.userId = 'user-b'","+    rerender()","+    expect(result.current.factors.data).toBeUndefined()","+    expect(result.current.identities.data).toBeUndefined()","+    expect(result.current.codes.data).toBeUndefined()","+    await waitFor(() => expect(mock.getStatus).toHaveBeenCalledTimes(2))","+    await waitFor(() => expect(mock.listFactors).toHaveBeenCalledTimes(2))","+    await waitFor(() => expect(mock.getUser).toHaveBeenCalledTimes(2))","+  })","+","+  it('does not reuse findings after the signed-in user changes', async () => {","+    const { result, rerender } = renderRecovery()","+    await waitFor(() => expect(result.current.findings[0]?.id).toBe('recovery-codes-exhausted'))","+","+    mock.userId = 'user-b'","+    mock.getStatus.mockResolvedValue({ data: { remaining: 10 }, error: null })","+    rerender()","+    expect(result.current.findings).toEqual([])","+    await waitFor(() => expect(mock.getStatus).toHaveBeenCalledTimes(2))","+    expect(result.current.findings.map((finding) => finding.id)).toEqual(['single-mfa-factor'])","+  })","+})"],"additions":137,"deletions":0,"truncated":false},{"path":"apps/studio/hooks/misc/useAccountRecovery.ts","lines":["@@ -0,0 +1,80 @@","+import { useFlag, useUser } from 'common'","+","+import { useMfaListFactorsQuery } from '@/data/profile/mfa-list-factors-query'","+import { useProfileIdentitiesQuery } from '@/data/profile/profile-identities-query'","+import { useRecoveryCodesStatusQuery } from '@/data/recovery-codes/recovery-codes-status-query'","+import { useIsFeatureEnabled } from '@/hooks/misc/useIsFeatureEnabled'","+import {","+  evaluateAccountRecovery,","+  type AccountRecoveryInput,","+} from '@/lib/account-recovery/evaluate-account-recovery'","+import { IS_PLATFORM } from '@/lib/constants'","+","+export const useAccountRecovery = ({ enabled = true }: { enabled?: boolean } = {}) => {","+  const userId = useUser()?.id","+  const hasSecuritySettings = useIsFeatureEnabled('account:show_security_settings')","+  const recoveryCodesEnabled = useFlag('enableAuthRecoveryCodes')","+  const passwordEnabled = useFlag('enableAccountPassword')","+  const shouldReadAccount = IS_PLATFORM && enabled && !!userId","+  const identities = useProfileIdentitiesQuery({ enabled: shouldReadAccount })","+  const shouldReadFactors = shouldReadAccount && hasSecuritySettings","+  const factors = useMfaListFactorsQuery({ enabled: shouldReadFactors })","+  const verifiedFactorCount = factors.isSuccess","+    ? factors.data.all.filter(","+        (factor) => factor.status === 'verified' && factor.factor_type !== 'recovery_code'","+      ).length","+    : 0","+  const isSsoAccount =","+    identities.isSuccess &&","+    identities.data.identities.some((identity) => identity.provider.startsWith('sso'))","+  const shouldReadCodes =","+    shouldReadFactors &&","+    recoveryCodesEnabled &&","+    factors.isSuccess &&","+    verifiedFactorCount > 0 &&","+    identities.isSuccess &&","+    !isSsoAccount","+  const codes = useRecoveryCodesStatusQuery({ enabled: shouldReadCodes })","+","+  const isPending =","+    shouldReadAccount &&","+    (identities.isPending ||","+      (shouldReadFactors && factors.isPending) ||","+      (shouldReadCodes && codes.isPending))","+  const isError =","+    shouldReadAccount &&","+    (identities.isError ||","+      (shouldReadFactors && factors.isError) ||","+      (shouldReadCodes && codes.isError))","+","+  let recoveryCodes: AccountRecoveryInput['recoveryCodes'] = { status: 'unknown' }","+  if (shouldReadCodes && codes.isSuccess) {","+    if (codes.data.status === 'unenrolled') recoveryCodes = { status: 'missing' }","+    if (codes.data.status === 'available' && codes.data.data) {","+      recoveryCodes = { status: 'available', remaining: codes.data.data.remaining }","+    }","+  }","+","+  const findings =","+    shouldReadAccount && identities.isSuccess","+      ? evaluateAccountRecovery({","+          identities: identities.data.identities,","+          email: identities.data.email,","+          verifiedFactorCount,","+          recoveryCodes,","+          features: {","+            hasSecuritySettings: hasSecuritySettings && factors.isSuccess,","+            recoveryCodesEnabled,","+            passwordEnabled,","+          },","+        })","+      : []","+","+  const isFetching =","+    shouldReadAccount &&","+    (identities.isFetching ||","+      (shouldReadFactors && factors.isFetching) ||","+      (shouldReadCodes && codes.isFetching))","+","+  return { findings, isPending, isFetching, isError, verifiedFactorCount }","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"apps/studio/lib/account-recovery/evaluate-account-recovery.test.ts","lines":["@@ -0,0 +1,96 @@","+import { describe, expect, it } from 'vitest'","+","+import { evaluateAccountRecovery, type AccountRecoveryInput } from './evaluate-account-recovery'","+","+const base: AccountRecoveryInput = {","+  identities: [{ provider: 'email' }],","+  email: 'person@example.com',","+  verifiedFactorCount: 1,","+  recoveryCodes: { status: 'available', remaining: 8 },","+  features: { hasSecuritySettings: true, recoveryCodesEnabled: true, passwordEnabled: true },","+}","+","+const evaluate = (overrides: Partial<AccountRecoveryInput> = {}) =>","+  evaluateAccountRecovery({ ...base, ...overrides })","+","+describe('evaluateAccountRecovery', () => {","+  it('suppresses all findings for SSO identities', () => {","+    expect(","+      evaluate({ identities: [{ provider: 'sso:provider' }], recoveryCodes: { status: 'missing' } })","+    ).toEqual([])","+  })","+","+  it('finds missing codes with any verified MFA count and suppresses the factor reminder', () => {","+    for (const verifiedFactorCount of [1, 2]) {","+      expect(evaluate({ verifiedFactorCount, recoveryCodes: { status: 'missing' } })).toEqual([","+        { id: 'recovery-codes-missing', severity: 'warning', action: 'generate-codes' },","+      ])","+    }","+    expect(evaluate({ verifiedFactorCount: 0, recoveryCodes: { status: 'missing' } })).toEqual([])","+  })","+","+  it('finds exhausted codes only with one verified MFA factor', () => {","+    expect(evaluate({ recoveryCodes: { status: 'available', remaining: 0 } })).toEqual([","+      {","+        id: 'recovery-codes-exhausted',","+        severity: 'critical',","+        action: 'regenerate-codes',","+        remainingCodes: 0,","+      },","+    ])","+    expect(","+      evaluate({ verifiedFactorCount: 2, recoveryCodes: { status: 'available', remaining: 0 } })","+    ).toEqual([])","+  })","+","+  it('uses the low-code boundary of one through three with one factor', () => {","+    for (const remaining of [1, 2, 3]) {","+      expect(evaluate({ recoveryCodes: { status: 'available', remaining } })).toEqual([","+        {","+          id: 'recovery-codes-low',","+          severity: 'warning',","+          action: 'regenerate-codes',","+          remainingCodes: remaining,","+        },","+      ])","+    }","+    expect(evaluate({ recoveryCodes: { status: 'available', remaining: 4 } })).toEqual([","+      { id: 'single-mfa-factor', severity: 'info', action: 'add-factor' },","+    ])","+    expect(","+      evaluate({ verifiedFactorCount: 2, recoveryCodes: { status: 'available', remaining: 2 } })","+    ).toEqual([])","+  })","+","+  it('waits for known code status before advising on a single MFA factor', () => {","+    expect(evaluate({ recoveryCodes: { status: 'unknown' } })).toEqual([])","+    expect(","+      evaluate({","+        recoveryCodes: { status: 'unknown' },","+        features: { ...base.features, recoveryCodesEnabled: false },","+      })","+    ).toEqual([{ id: 'single-mfa-factor', severity: 'info', action: 'add-factor' }])","+  })","+","+  it('gates security findings but independently advises on a single OAuth sign-in', () => {","+    const identities = [{ provider: 'github' }]","+    expect(","+      evaluate({","+        identities,","+        features: { ...base.features, hasSecuritySettings: false },","+      })","+    ).toEqual([{ id: 'single-oauth-identity', severity: 'warning', action: 'set-password' }])","+    expect(evaluate({ identities: [...identities, { provider: 'google' }] })).toEqual([","+      { id: 'single-mfa-factor', severity: 'info', action: 'add-factor' },","+    ])","+    expect(evaluate({ identities: [{ provider: 'phone' }] })).toEqual([","+      { id: 'single-mfa-factor', severity: 'info', action: 'add-factor' },","+    ])","+    expect(evaluate({ identities, email: undefined })).toEqual([","+      { id: 'single-mfa-factor', severity: 'info', action: 'add-factor' },","+    ])","+    expect(","+      evaluate({ identities, features: { ...base.features, passwordEnabled: false } })","+    ).toEqual([{ id: 'single-mfa-factor', severity: 'info', action: 'add-factor' }])","+  })","+})"],"additions":96,"deletions":0,"truncated":false},{"path":"apps/studio/lib/account-recovery/evaluate-account-recovery.ts","lines":["@@ -0,0 +1,85 @@","+export type AccountRecoveryFinding = {","+  id:","+    | 'recovery-codes-missing'","+    | 'recovery-codes-exhausted'","+    | 'recovery-codes-low'","+    | 'single-mfa-factor'","+    | 'single-oauth-identity'","+  severity: 'critical' | 'warning' | 'info'","+  action: 'generate-codes' | 'regenerate-codes' | 'set-password' | 'add-factor'","+  remainingCodes?: number","+}","+","+export type AccountRecoveryInput = {","+  identities: { provider: string }[]","+  email?: string","+  verifiedFactorCount: number","+  recoveryCodes:","+    | { status: 'unknown' }","+    | { status: 'missing' }","+    | { status: 'available'; remaining: number }","+  features: {","+    hasSecuritySettings: boolean","+    recoveryCodesEnabled: boolean","+    passwordEnabled: boolean","+  }","+}","+","+export const evaluateAccountRecovery = ({","+  identities,","+  email,","+  verifiedFactorCount,","+  recoveryCodes,","+  features,","+}: AccountRecoveryInput): AccountRecoveryFinding[] => {","+  if (identities.some((identity) => identity.provider.startsWith('sso'))) return []","+","+  const findings: AccountRecoveryFinding[] = []","+  const hasOneFactor = verifiedFactorCount === 1","+  let hasCodeFinding = false","+","+  if (features.hasSecuritySettings && features.recoveryCodesEnabled && verifiedFactorCount > 0) {","+    if (recoveryCodes.status === 'missing') {","+      findings.push({","+        id: 'recovery-codes-missing',","+        severity: 'warning',","+        action: 'generate-codes',","+      })","+      hasCodeFinding = true","+    } else if (recoveryCodes.status === 'available' && hasOneFactor) {","+      if (recoveryCodes.remaining === 0) {","+        findings.push({","+          id: 'recovery-codes-exhausted',","+          severity: 'critical',","+          action: 'regenerate-codes',","+          remainingCodes: 0,","+        })","+        hasCodeFinding = true","+      } else if (recoveryCodes.remaining >= 1 && recoveryCodes.remaining <= 3) {","+        findings.push({","+          id: 'recovery-codes-low',","+          severity: 'warning',","+          action: 'regenerate-codes',","+          remainingCodes: recoveryCodes.remaining,","+        })","+        hasCodeFinding = true","+      }","+    }","+  }","+","+  const isCodeStatusUnknown = features.recoveryCodesEnabled && recoveryCodes.status === 'unknown'","+  if (features.hasSecuritySettings && hasOneFactor && !hasCodeFinding && !isCodeStatusUnknown) {","+    findings.push({ id: 'single-mfa-factor', severity: 'info', action: 'add-factor' })","+  }","+","+  const hasOneOAuthIdentity =","+    identities.length === 1 &&","+    identities[0].provider !== 'email' &&","+    identities[0].provider !== 'phone' &&","+    !identities[0].provider.startsWith('sso')","+  if (features.passwordEnabled && email && hasOneOAuthIdentity) {","+    findings.push({ id: 'single-oauth-identity', severity: 'warning', action: 'set-password' })","+  }","+","+  return findings","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"knip.jsonc","lines":["@@ -42,7 +42,6 @@","         // one-off build/codegen scripts, run by hand or from package.json","         \"scripts/**\",","         // dynamically imported","-        \"components/interfaces/ConnectSheet/content/**\",","         \"components/interfaces/ConnectSheet/DirectConnectionExamples.tsx\",","         // data layer templates, copied when adding a new query/mutation","         \"data/__templates/**\",",""],"additions":0,"deletions":1,"truncated":false}],"additions":420,"deletions":11,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-27T15:03:31.936936+00:00"}