 );","+            client.set_poll_interval(remote_poll_interval(chain.into()));","         }"," ","         let provider =","@@ -647,13 +642,37 @@ pub fn get_http_provider(builder: impl AsRef<str>) -> RetryProvider {"," /// Constructs a provider, retaining Alloy's default polling interval for local URLs."," ///"," /// For non-local URLs, the polling interval is 60% of the chain's average block time hint, capped","-/// at 3 seconds before scaling (at most 1.8 seconds). If no hint is available, 3 seconds is used","-/// before scaling.","+/// at 3 seconds before scaling (at most 1.8 seconds) and at least 250 milliseconds. If no hint is","+/// available, 3 seconds is used before scaling."," #[inline]"," pub fn try_get_http_provider(builder: impl AsRef<str>) -> Result<RetryProvider> {","     ProviderBuilder::new(builder.as_ref()).build()"," }"," ","+/// Sets a remote `provider`'s receipt and block polling interval for `chain_id`.","+///","+/// [`ProviderBuilder`] picks the interval from its chain, which is mainnet unless","+/// [`ProviderBuilder::from_config`] found one in the config, so a provider for a faster chain polls","+/// too slowly until this runs. Call it once the chain ID is known, unless the user chose an","+/// interval. Local endpoints keep Alloy's default.","+pub fn set_chain_poll_interval<N: Network>(provider: &impl Provider<N>, chain_id: u64) {","+    let client = provider.client();","+    if !client.is_local() {","+        client.set_poll_interval(remote_poll_interval(Chain::from_id(chain_id)));","+    }","+}","+","+/// Returns 60% of `chain`'s block time hint, or of 3 seconds when the hint is missing or longer,","+/// and at least [`MIN_REMOTE_POLL_INTERVAL`].","+fn remote_poll_interval(chain: Chain) -> Duration {","+    chain","+        .average_blocktime_hint()","+        .map(|hint| hint.min(DEFAULT_UNKNOWN_CHAIN_BLOCK_TIME))","+        .unwrap_or(DEFAULT_UNKNOWN_CHAIN_BLOCK_TIME)","+        .mul_f32(POLL_INTERVAL_BLOCK_TIME_SCALE_FACTOR)","+      