uched.","+type DockerfileWriter struct {","+\tConfig     map[string]string      // build.yaml parsed config","+\tMappings   []DockerfileEnvMapping // ENV variables to keep in sync","+\tDockerfile io.Reader              // Dockerfile content","+\tOutput     io.Writer              // updated Dockerfile","+}","+","+// Run reads the Dockerfile, rewrites the mapped ENV lines and writes the result","+// to Output. Nothing is written to Output if any mapping cannot be applied.","+func (w *DockerfileWriter) Run() error {","+\tif w.Config == nil {","+\t\treturn errors.New(\"nil config\")","+\t}","+\tif w.Dockerfile == nil {","+\t\treturn errors.New(\"nil dockerfile input\")","+\t}","+\tif w.Output == nil {","+\t\treturn errors.New(\"nil output\")","+\t}","+","+\tcontent, err := io.ReadAll(w.Dockerfile)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"failed to read dockerfile: %w\", err)","+\t}","+","+\tlines := strings.Split(string(content), \"\\n\")","+\tfor _, m := range w.Mappings {","+\t\tvalue := w.Config[m.Key]","+\t\tif value == \"\" {","+\t\t\treturn fmt.Errorf(\"%q is missing or empty in build config\", m.Key)","+\t\t}","+\t\tprefix := \"ENV \" + m.Env + \"=\"","+\t\tfound := false","+\t\tfor i, line := range lines {","+\t\t\tif strings.HasPrefix(line, prefix) {","+\t\t\t\tlines[i] = prefix + value","+\t\t\t\tfound = true","+\t\t\t}","+\t\t}","+\t\tif !found {","+\t\t\treturn fmt.Errorf(\"no %q line found in dockerfile\", prefix)","+\t\t}","+\t}","+","+\t_, err = io.WriteString(w.Output, strings.Join(lines, \"\\n\"))","+\treturn err","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"pkg/codegen/buildconfig/dockerfile_writer_test.go","lines":["@@ -0,0 +1,119 @@","+package main_test","+","+import (","+\t\"bytes\"","+\t\"io\"","+\t\"strings\"","+\t\"testing\"","+","+\tmain \"github.com/rancher/rancher/pkg/codegen/buildconfig\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestDockerfileWriterRun(t *testing.T) {","+\tt.Parallel()","+","+\tmappings := []main.DockerfileEnvMapping{","+\t\t{Env: \"CATTLE_MACHINE_VERSION\", Key: \"machineVersion\"},","+\t\t{Env: \"CATTLE_SYSTEM_AGENT_VERSION\", Key: \"systemAgentVersion\"},","+\t}","+\tcfg := map[string]string{","+\t\t\"machineVersion\":     \"v0.2.0\",","+\t\t\"systemAgentVersion\": \"v0.3.0\",","+\t}","+","+\tinput := `FROM scratch","+# keep this comment","+ENV CATTLE_MACHINE_VERSION=v0.1.0","+ENV CATTLE_MACHINE_PROVISION_IMAGE=rancher/machine:${CATTLE_MACHINE_VERSION}","+","+# make sure the version is consistent","+ENV CATTLE_SYSTEM_AGENT_VERSION=v0.1.0","+ENV CATTLE_SYSTEM_AGENT_VERSION_OTHER=untouched","+`","+\texpected := `FROM scratch","+# keep this comment","+ENV CATTLE_MACHINE_VERSION=v0.2.0","+ENV CATTLE_MACHINE_PROVISION_IMAGE=rancher/machine:${CATTLE_MACHINE_VERSION}","+","+# make sure the version is consistent","+ENV CATTLE_SYSTEM_AGENT_VERSION=v0.3.0","+ENV CATTLE_SYSTEM_AGENT_VERSION_OTHER=untouched","+`","+","+\tt.Run(\"replaces mapped lines and preserves the rest\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tout := new(bytes.Buffer)","+\t\tw := main.DockerfileWriter{Config: cfg, Mappings: mappings, Dockerfile: strings.NewReader(input), Output: out}","+\t\trequire.NoError(t, w.Run())","+\t\trequire.Equal(t, expected, out.String())","+\t})","+","+\tt.Run(\"is a no-op when already in sync\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tout := new(bytes.Buffer)","+\t\tw := main.DockerfileWriter{Config: cfg, Mappings: mappings, Dockerfile: strings.NewReader(expected), Output: out}","+\t\trequire.NoError(t, w.Run())","+\t\trequire.Equal(t, expected, out.String())","+\t})","+","+\tt.Run(\"preserves a missing trailing newline\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tout := new(bytes.Buffer)","+\t\tw := main.DockerfileWriter{","+\t\t\tConfig:     map[string]string{\"machineVersion\": \"v0.2.0\"},","+\t\t\tMappings:   mappings[:1],","+\t\t\tDockerfile: strings.NewReader(\"ENV CATTLE_MACHINE_VERSION=v0.1.0\"),","+\t\t\tOutput:     ou