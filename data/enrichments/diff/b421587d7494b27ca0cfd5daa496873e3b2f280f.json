)","+\t})","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"pkg/codegen/buildconfig/main.go","lines":["@@ -3,10 +3,13 @@"," package main"," "," import (","+\t\"bytes\""," \t\"errors\""," \t\"fmt\""," \t\"io\"","+\t\"maps\""," \t\"os\"","+\t\"strings\""," \t\"syscall\""," \t\"text/template\""," ","@@ -29,6 +32,82 @@ func main() {"," \t\tfmt.Fprintln(os.Stderr, err)"," \t\tos.Exit(1)"," \t}","+\tif err := updateToolsSystemImages(cfg); err != nil {","+\t\tfmt.Fprintln(os.Stderr, err)","+\t\tos.Exit(1)","+\t}","+\tif err := updateDockerfiles(cfg); err != nil {","+\t\tfmt.Fprintln(os.Stderr, err)","+\t\tos.Exit(1)","+\t}","+}","+","+// dockerfileTargets lists the Dockerfiles that carry build.yaml-managed ENV lines.","+var dockerfileTargets = []struct {","+\tpath     string","+\tmappings []DockerfileEnvMapping","+}{","+\t{","+\t\tpath: \"package/Dockerfile\",","+\t\tmappings: []DockerfileEnvMapping{","+\t\t\t{Env: \"CATTLE_MACHINE_VERSION\", Key: \"machineVersion\"},","+\t\t\t{Env: \"CATTLE_SYSTEM_AGENT_VERSION\", Key: \"systemAgentVersion\"},","+\t\t\t{Env: \"CATTLE_WINS_AGENT_VERSION\", Key: \"winsAgentVersion\"},","+\t\t},","+\t},","+\t{","+\t\tpath: \"Dockerfile.runtime\",","+\t\tmappings: []DockerfileEnvMapping{","+\t\t\t{Env: \"CATTLE_MACHINE_VERSION\", Key: \"machineVersion\"},","+\t\t},","+\t},","+}","+","+func updateDockerfiles(cfg map[string]string) error {","+\t// The Dockerfiles carry the machine version, which is the tag of machineProvisionImage.","+\t_, machineVersion, ok := strings.Cut(cfg[\"machineProvisionImage\"], \":\")","+\tif !ok || machineVersion == \"\" {","+\t\treturn fmt.Errorf(\"machineProvisionImage %q has no image tag\", cfg[\"machineProvisionImage\"])","+\t}","+\tcfg = maps.Clone(cfg)","+\tcfg[\"machineVersion\"] = machineVersion","+","+\tfor _, target := range dockerfileTargets {","+\t\tin, err := os.ReadFile(target.path)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\t// Render in memory first so a failure never truncates the existing file.","+\t\tbuf := new(bytes.Buffer)","+\t\twriter := DockerfileWriter{","+\t\t\tConfig:     cfg,","+\t\t\tMappings:   target.mappings,","+\t\t\tDockerfile: bytes.NewReader(in),","+\t\t\tOutput:     buf,","+\t\t}","+\t\tif err := writer.Run(); err != nil {","+\t\t\treturn fmt.Errorf(\"%s: %w\", target.path, err)","+\t\t}","+\t\tif err := os.WriteFile(target.path, buf.Bytes(), 0644); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+\treturn nil","+}","+","+const toolsSystemImagesPath = \"pkg/apis/management.cattle.io/v3/tools_system_images.go\"","+","+func updateToolsSystemImages(cfg map[string]string) error {","+\t// Render in memory first so a failure never truncates the existing file.","+\tbuf := new(bytes.Buffer)","+\twriter := ToolsSystemImagesWriter{","+\t\tConfig: cfg,","+\t\tOutput: buf,","+\t}","+\tif err := writer.Run(); err != nil {","+\t\treturn err","+\t}","+\treturn os.WriteFile(toolsSystemImagesPath, buf.Bytes(), 0644)"," }"," "," func loadBuildConfig() (map[string]string, error) {"],"additions":79,"deletions":0,"truncated":false},{"path":"pkg/codegen/buildconfig/tools_images_writer.go","lines":["@@ -0,0 +1,80 @@","+package main","+","+import (","+\t\"bytes\"","+\t\"errors\"","+\t\"fmt\"","+\t\"go/format\"","+\t\"io\"","+\t\"text/template\"","+)","+","+// kubeAPIAuthImageKey is the build.yaml key holding the kube-api-auth image.","+const kubeAPIAuthImageKey = \"defaultKubeAPIAuthImage\"","+","+// toolsSystemImagesTmpl renders pkg/apis/management.cattle.io/v3/tools_system_images.go.","+// The v3 package cannot import pkg/buildconfig (that would pull in all of Rancher","+// through a separate module), so the value is written out as a literal instead.","+//","+// TODO: remove ToolsSystemImages in v2.17, along with the AuthSystemImages type in","+// authn_types.go (and its deepcopy functions), tools_system_images.go and this generator.","+// ToolsSystemImages is marked Deprecated as of v2.16 and Rancher itself no longer reads","+// 