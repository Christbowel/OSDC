() {","     # Check if the oomd.conf drop-in config is loaded.","     assert_in 'Swap Used Limit: 90.00%' \"$(oomctl)\"","     assert_in 'Default Memory Pressure Limit: 60.00%' \"$(oomctl)\"","     assert_in 'Default Memory Pressure Duration: 2s' \"$(oomctl)\""," ","+    local limit_unit=TEST-55-OOMD-reload-limit.service","+    local duration_unit=TEST-55-OOMD-reload-duration.service","+    local limit_path duration_path dump","+","+    # Use explicit overrides equal to the old defaults to distinguish them from inherited values.","+    systemd-run --collect --unit=\"$limit_unit\" \\","+        -p ManagedOOMMemoryPressure=kill -p ManagedOOMMemoryPressureLimit=60% sleep infinity","+    systemd-run --collect --unit=\"$duration_unit\" \\","+        -p ManagedOOMMemoryPressure=kill -p ManagedOOMMemoryPressureDurationSec=2s sleep infinity","+","+    limit_path=\"$(systemctl show -P ControlGroup \"$limit_unit\")\"","+    duration_path=\"$(systemctl show -P ControlGroup \"$duration_unit\")\"","+    # The child shell expands $path.","+    # shellcheck disable=SC2016","+    timeout 1m bash -o pipefail -c '","+        for path; do","+            until oomctl | grep -F \"Path: $path\" >/dev/null; do sleep 1; done","+        done","+    ' _ \"${limit_path:?}\" \"${duration_path:?}\"","+","     # Test oomd reload","     mkdir -p /run/systemd/oomd.conf.d/","     {","@@ -307,9 +335,27 @@ testcase_reload() {","     } >/run/systemd/oomd.conf.d/99-oomd-test.conf"," ","     systemctl reload systemd-oomd.service","-    assert_in 'Swap Used Limit: 80.00%' \"$(oomctl)\"","-    assert_in 'Default Memory Pressure Limit: 55.00%' \"$(oomctl)\"","-    assert_in 'Default Memory Pressure Duration: 5s' \"$(oomctl)\"","+    dump=\"$(oomctl)\"","+    assert_in 'Swap Used Limit: 80.00%' \"$dump\"","+    assert_in 'Default Memory Pressure Limit: 55.00%' \"$dump\"","+    assert_in 'Default Memory Pressure Duration: 5s' \"$dump\"","+    assert_pressure_policy \"$dump\" \"$limit_path\" 60.00% 5s","+    