{"id":"c13b416af020a92fd4c303d0625cf4749794a327","axis":"silent","repo":"pnpm/pnpm","sha":"c13b416af020a92fd4c303d0625cf4749794a327","parsed":{"files":[{"path":".changeset/pnpr-returns-freed-memory.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now returns freed memory to the operating system. On Linux, its resident memory grew to several GB while serving many large packuments at once and stayed there after the requests finished. pnpr also keeps more rendered packuments in its cache, so repeated reads of large packages need less memory and time [#18206](https://github.com/pnpm/pnpm/issues/18206)."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -7106,6 +7106,7 @@ dependencies = [","  \"libc\",","  \"libsql\",","  \"miette 7.6.0\",","+ \"mimalloc\",","  \"mockito\",","  \"node-semver\",","  \"object_store\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/Cargo.toml","lines":["@@ -150,5 +150,9 @@ tokio = { workspace = true, features = [\"test-util\"] }"," [target.'cfg(not(target_family = \"wasm\"))'.dependencies]"," tokio = { workspace = true, features = [\"net\", \"signal\"] }"," ","+# Keep in sync with the `cfg` on `mod allocator` in `src/main.rs`.","+[target.'cfg(all(any(target_os = \"linux\", target_os = \"macos\", target_os = \"windows\"), any(target_arch = \"x86_64\", target_arch = \"aarch64\")))'.dependencies]","+mimalloc = { workspace = true }","+"," [lints]"," workspace = true"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/allocator.rs","lines":["@@ -0,0 +1,34 @@","+use std::ffi::{c_int, c_long};","+","+#[global_allocator]","+static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;","+","+// `mi_option_purge_delay` in `mimalloc.h`. `libmimalloc-sys` binds the","+// options on either side of it but not this one.","+const MI_OPTION_PURGE_DELAY: c_int = 15;","+","+unsafe extern \"C\" {","+    fn mi_option_set_default(option: c_int, value: c_long);","+    fn mi_option_get(option: c_int) -> c_long;","+}","+","+// mimalloc purges freed memory only while a thread is allocating, and by","+// default only after a delay. Memory freed by the last requests of a","+// burst then stays resident for as long as the server is idle. Purging","+// without a delay returns it at once. `MIMALLOC_PURGE_DELAY` overrides","+// this.","+//","+// Call it before the process starts another thread.","+pub(super) fn purge_freed_memory_immediately() {","+    // SAFETY: `mimalloc` links the library that defines this function.","+    // The index is a valid option in mimalloc v2 and v3. The function","+    // writes the option without synchronization, and no other thread","+    // exists yet to read it.","+    unsafe { mi_option_set_default(MI_OPTION_PURGE_DELAY, 0) };","+}","+","+pub(super) fn purge_delay() -> c_long {","+    // SAFETY: `mimalloc` links the library that defines this function, and","+    // the index is a valid option in mimalloc v2 and v3.","+    unsafe { mi_option_get(MI_OPTION_PURGE_DELAY) }","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/main.rs","lines":["@@ -8,6 +8,16 @@ use pnpr_config::{BackendConfig, DatabaseBackend, default_database_path};"," use std::{io::IsTerminal, path::PathBuf};"," use tracing_subscriber::{EnvFilter, util::SubscriberInitExt as _};"," ","+// Rendering a packument makes large, short-lived allocations on many threads.","+// glibc malloc keeps that memory after the requests finish, so the resident","+// size of an idle server stays near its peak. The other targets keep the","+// system allocator until mimalloc's C build is verified there.","+#[cfg(all(","+    any(target_os = \"linux\", target_os = \"macos\", target_os = \"windows\"),","+    any(target_arch = \"x86_64\", target_arch = \"aarch64\"),","+))]","+mod allocator;","+"," #[derive(Debug, Parser)]"," #[command(name = \"pnpr\", version, about = \"pnpm-compatible npm registry server\")]"," struct Args {","@@ -25,6 +35,14 @@ struct Args {"," ","     #[command(flatten)]","     server: ServerArgs,","+","+    /// Print the allocator's purge delay and exit. A test reads it.","+    #[cfg(all(","+        any(target_os = \"linux\", target_os = \"macos\", target_os = \"windows\"),","+        any(target_arch = \"x86_64\", target_arch = \"aarch64\"),","+    ))]","+    #[arg(long, hide = true)]","+    allocator_purge_delay: bool,"," }"," "," #[derive(Debug, Default, Clone, clap::Args)]","@@ -43,10 +61,27 @@ struct StorageArgs {","     cache: Option<PathBuf>,"," }"," ","+fn main() -> miette::Result<()> {","+    #[cfg(all(","+        any(target_os = \"linux\", target_os = \"macos\", target_os = \"windows\"),","+        any(target_arch = \"x86_64\", target_arch = \"aarch64\"),","+    ))]","+    allocator::purge_freed_memory_immediately();","+    run()","+}","+"," #[tokio::main]","-async fn main() -> miette::Result<()> {","+async fn run() -> miette::Result<()> {","     let matches = Args::command().get_matches();","     let mut args = Args::from_arg_matches(&matches).unwrap_or_else(|err| err.exit());","+    #[cfg(all(","+        any(target_os = \"linux\", target_os = \"macos\", target_os = \"windows\"),","+        any(target_arch = \"x86_64\", target_arch = \"aarch64\"),","+    ))]","+    if args.allocator_purge_delay {","+        println!(\"{}\", allocator::purge_delay());","+        return Ok(());","+    }","     let auto_path = Config::auto_config_path();"," ","     let server_args = match args.command.take() {"],"additions":36,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_responses/processing.rs","lines":["@@ -10,13 +10,9 @@ use super::{"," use axum::body::Bytes;"," use chrono::{DateTime, Utc};"," use pnpr_storage::BoundedCache;","-use std::{","-    collections::hash_map::RandomState,","-    hash::BuildHasher,","-    sync::{Arc, Mutex},","-};","+use std::sync::{Arc, Mutex};"," ","-/// Source and rendered response bytes retained by one 