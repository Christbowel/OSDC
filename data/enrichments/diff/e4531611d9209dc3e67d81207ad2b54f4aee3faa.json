ertToTransient(unique_lock<mutex> &block_lock, Metadat"," \t// copy the data to the transient block"," \tmemcpy(new_buffer.GetDataMutable(), old_buffer.Ptr(), block_manager.GetBlockSize());"," ","+\t// the disk block now belongs to the transient block and is rewritten in place by a later","+\t// checkpoint - the old handle must not reload it from disk after its buffer is evicted","+\t{","+\t\tauto old_block_lock = old_block->GetMemory().GetLock();","+\t\told_block->GetMemory().SetDestroyBufferUpon(DestroyBufferUpon::EVICTION);","+\t}","+"," \t// unregister the old block"," \tblock_manager.UnregisterBlock(metadata_block.block_id);"," "],"additions":35,"deletions":20,"truncated":false},{"path":"src/storage/single_file_block_manager.cpp","lines":["@@ -1197,10 +1197,15 @@ void SingleFileBlockManager::ReadBlock(Block &block, bool skip_block_header) con"," "," void SingleFileBlockManager::Read(QueryContext context, Block &block) {"," \tD_ASSERT(block.id >= 0);","-\tD_ASSERT(std::find(free_list.begin(), free_list.end(), block.id) == free_list.end());","+\tD_ASSERT(!BlockIsFreeListed(block.id));"," \tReadAndChecksum(context, block, GetBlockLocation(block.id));"," }"," ","+bool SingleFileBlockManager::BlockIsFreeListed(block_id_t block_id) {","+\tlock_guard<mutex> lock(single_file_block_lock);","+\treturn free_list.find(block_id) != free_list.end();","+}","+"," void SingleFileBlockManager::ReadBlocks(QueryContext context, FileBuffer &buffer, block_id_t start_block,","                                         idx_t block_count) {"," \tD_ASSERT(start_block >= 0);","@@ -1432,11 +1437,11 @@ void SingleFileBlockManager::FileSync() {"," \thandle->Sync();"," }"," ","-void SingleFileBlockManager::UnregisterBlock(block_id_t id) {","-\t// perform the actual unregistration","-\tBlockManager::UnregisterBlock(id);","-\t// check if it is part of the newly free list","-\tlock_guard<mutex> lock(single_file_block_lock);","+void SingleFileBlockManager::ReleaseFreeBlockInUse(unique_lock<mutex> &lock, block_id_t id) {","+\tif (!lock.owns_lock()) {","+\t\tthrow InternalException(\"ReleaseFreeBlockInUse must be called while holding the lock\");","+\t}","+\t// check if the block is part of the newly free list"," \tauto entry = free_blocks_in_use.find(id);"," \tif (entry != free_blocks_in_use.end()) {"," \t\t// it is! move it to the regular free list so the block can be re-used","@@ -1445,6 +1450,27 @@ void SingleFileBlockManager::UnregisterBlock(block_id_t id) {"," \t}"," }"," ","+void SingleFileBlockManager::UnregisterBlock(block_id_t id) {","+\tunique_lock<mutex> lock(single_file_block_lock);","+\t// perform the actual unregistration","+\tBlockManager::UnregisterBlock(id);","+\tReleaseFreeBlockInUse(lock, id);","+}","+","+bool SingleFileBlockManager::UnregisterExpiredBlock(block_id_t id) {","+\t// hold the lock across the live-handle check and the free-list transition: otherwise a","+\t// re-registration and retirement of the block id can interleave between them, and the","+\t// free-list transition would run although a live handle exists","+\t// lock order: single_file_block_lock before blocks_lock, as in AddFreeBlock","+\tunique_lock<mutex> lock(single_file_block_lock);","+\tif (!BlockManager::UnregisterExpiredBlock(id)) {","+\t\t// a newer handle is registered for this block id - the block id is still in use","+\t\treturn false;","+\t}","+\tReleaseFreeBlockInUse(lock, id);","+\treturn true;","+}","+"," void SingleFileBlockManager::TrimFreeBlockRange(block_id_t start, block_id_t end) {"," \tauto block_count = NumericCast<idx_t>(end + 1 - start);"," \tauto offset = BLOCK_START + (NumericCast<idx_t>(start) * GetBlockAllocSize());"],"additions":32,"deletions":6,"truncated":false},{"path":"test/api/CMakeLists.txt","lines":["@@ -27,6 +27,7 @@ set(TEST_API_OBJECTS","     test_external_extension_provider.cpp","     test_extension_setting_autoload.cpp","     test_instance_cache.cpp","+    test_metadata_pin_race.cpp","     test_storage_extension_alias.cpp","     test_storage_extension_remote_path.cpp","     test_static_database_callback.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"test/api/test_metadata_pin_race.cpp","lines":["@@ -0,0 +1,317 @@","+#include \"catch.hpp\"","+#include \"duckdb/catalog/catalog.hpp\"","+#include \"duckdb/common/map.hpp\"","+#include \"duckdb/main/database.hpp\"","+#include \"duckdb/storage/block_manager.hpp\"","+#include \"duckdb/storage/buffer/block_handle.hpp\"","+#include \"duckdb/storage/buffer/buffer_handle.hpp\"","+#include \"duckdb/storage/buffer_manager.hpp\"","+#include \"duckdb/storage/metadata/metadata_manager.hpp\"","+#include \"duckdb/storage/storage_manager.hpp\"","+#include \"test_helpers.hpp\"","+","+#include <atomic>","+#include <chrono>","+#include <map>","+#include <string>","+#include <thread>","+","+using namespace duckdb;","+","+namespace {","+","+struct BlockManagerRefs {","+\tBlockManager *block_manager;","+\tMetadataManager *metadata_manager;","+\tBufferManager *buffer_manager;","+};","+","+BlockManagerRefs GetBlockManagerRefs(DuckDB &db, Connection &con) {","+\tBlockManagerRefs refs;","+\tcon.BeginTransaction();","+\tauto &catalog = Catalog::GetCatalog(*con.context, \"\");","+\trefs.block_manager = &StorageManager::Get(catalog).GetBlockManager();","+\trefs.metadata_manager = &refs.block_manager->GetMetadataManager();","+\trefs.buffer_manager = &refs.block_manager->GetBufferManager();","+\tcon.Commit();","+\treturn refs;","+}","+","+map<block_id_t, shared_ptr<BlockHandle>> SnapshotMetadataHandles(MetadataManager &metadata_manager) {","+\tmap<block_id_t, shared_ptr<BlockHandle>> result;","+\tfor (auto &handle : metadata_manager.GetBlocks()) {","+\t\tif (handle->BlockId() < MAXIMUM_BLOCK) {","+\t\t\tresult[handle->BlockId()] = handle;","+\t\t}","+\t}","+\treturn result;","+}","+","+} // namespace","+","+// When the metadata manager writes to a disk-backed metadata block, ConvertToTransient replaces the","+// registered handle and the next checkpoint rewrites the same disk block in place. Loading the","+// replaced handle from disk could race that rewrite, so it must not read from disk anymore.","+TEST_CASE(\"Pinning a replaced metadata block handle does not read from disk\", \"[storage]\") {","+\tauto path = TestCreatePath(\"metadata_stale_handle.db\");","+\tDeleteDatabase(path);","+\t{","+\t\tDuckDB db(path);","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE t(i INTEGER, s VARCHAR)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"INSERT INTO t SELECT i, repeat('x', 64) FROM range(10000) tbl(i)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t\tauto refs = GetBlockManagerRefs(db, con);","+","+\t\t// run checkpoints until a metadata block handle is replaced in place (same id, new handle)","+\t\tshared_ptr<BlockHandle> stale;","+\t\tfor (idx_t round = 0; round < 200 && !stale; round++) {","+\t\t\tauto before = SnapshotMetadataHandles(*refs.metadata_manager);","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"INSERT INTO t SELECT i, repeat('y', 64) FROM range(1000) tbl(i)\"));","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t\t\tauto after = SnapshotMetadataHandles(*refs.metadata_manager);","+\t\t\tfor (auto &entry : before) {","+\t\t\t\tauto it = after.find(entry.first);","+\t\t\t\tif (it != after.end() && it->second.get() != entry.second.get()) {","+\t\t\t\t\tstale = entry.second;","+\t\t\t\t\tbreak;","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tREQUIRE(stale);","+","+\t\t// unload the stale handle so that pinning it would have to read from disk","+\t\t{","+\t\t\tauto lock = stale->GetMemory().GetLock();","+\t\t\tif (stale->GetMemory().CanUnload() == CanUnloadResult::CAN_UNLOAD) {","+\t\t\t\tstale->GetMemory().Unload(lock);","+\t\t\t}","+\t\t}","+\t\tREQUIRE(stale->GetMemory().GetState() == BlockState::BLOCK_UNLOADED);","+","+\t\t// the stale handle must not load its (possibly rewritten) disk block","+\t\tauto pin = refs.buffer_manager->Pin(stale);","+\t\tREQUIRE(!pin.IsValid());","+\t}","+\tDeleteDatabase(path);","+}","+","+// A handle that was replaced (ConvertToTransient unregisters the id, a later checkpoint registers a","+// new handle for it) must not unregister the newer handle when it is destroyed.","+TEST_CASE(\"A dying stale block handle does not unregister a newer handle\", \"[storage]\") {","+\tauto path = TestCreatePath(\"stale_handle_unregister.db\");","+\tDeleteDatabase(path);","+\t{","+\t\tDuckDB db(path);","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE t(i INTEGER)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t\tauto refs = GetBlockManagerRefs(db, con);","+\t\tauto &block_manager = *refs.block_manager;","+","+\t\t// take a fresh block id so that retiring it goes through the newly-used path","+\t\tauto test_id = block_manager.GetFreeBlockId();","+\t\tauto stale = block_manager.RegisterBlock(test_id);","+\t\t// orphan the handle, like MetadataManager::ConvertToTransient does","+\t\tblock_manager.UnregisterBlock(test_id);","+\t\t// register a new handle for the same block id, like the next checkpoint does","+\t\tauto current = block_manager.RegisterBlock(test_id);","+\t\tREQUIRE(current.get() != stale.get());","+\t\t// retire the block id - the live handle moves it to free_blocks_in_use instead of the","+\t\t// free list, so the block cannot be reused while the handle exists","+\t\tblock_manager.MarkBlockAsModified(test_id);","+\t\tauto free_blocks_before = block_manager.FreeBlocks();","+","+\t\t// destroying the stale handle must leave the newer handle registered and must not","+\t\t// release the block id to the free list","+\t\tstale.reset();","+\t\tREQUIRE(block_manager.FreeBlocks() == free_blocks_before);","+\t\tauto resolved = block_manager.RegisterBlock(test_id);","+\t\tREQUIRE(resolved.get() == current.get());","+","+\t\t// once the last handle dies, the block id must become available again","+\t\tresolved.reset();","+\t\tcurrent.reset();","+\t\tREQUIRE(block_manager.FreeBlocks() == free_blocks_before + 1);","+\t}","+\tDeleteDatabase(path);","+}","+","+// A dying handle's registration check and free-list transition must be atomic: destroying expired","+// handles for a block id while another thread re-registers the same id must never drop the live","+// handle's registration (or release the id to the free list).","+TEST_CASE(\"Concurrent handle destruction does not drop a newer registration\", \"[storage]\") {","+\tauto path = TestCreatePath(\"stale_handle_unregister_race.db\");","+\tDeleteDatabase(path);","+\t{","+\t\tDuckDB db(path);","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE t(i INTEGER)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t\tauto refs = GetBlockManagerRefs(db, con);","+\t\tauto &block_manager = *refs.block_manager;","+","+\t\tconst block_id_t test_id = 2000000;","+\t\tstd::atomic<bool> done {false};","+\t\tstd::atomic<bool> registration_lost {false};","+","+\t\t// churn thread: repeatedly creates and destroys handles for the id - each destruction","+\t\t// runs the expired-registration cleanup that must not touch a newer live handle","+\t\tstd::thread churn([&]() {","+\t\t\twhile (!done) {","+\t\t\t\tauto handle = block_manager.RegisterBlock(test_id);","+\t\t\t\thandle.reset();","+\t\t\t}","+\t\t});","+","+\t\tfor (idx_t i = 0; i < 100000; i++) {","+\t\t\tauto live = block_manager.RegisterBlock(test_id);","+\t\t\t// while 'live' exists, resolving the id must always return the same handle","+\t\t\tauto resolved = block_manager.RegisterBlock(test_id);","+\t\t\tif (resolved.get() != live.get()) {","+\t\t\t\tregistration_lost = true;","+\t\t\t\tbreak;","+\t\t\t}","+\t\t}","+\t\tdone = true;","+\t\tchurn.join();","+\t\tREQUIRE(!registration_lost.load());","+\t}","+\tDeleteDatabase(path);","+}","+","+// Stress test: readers pin metadata block handles that have been replaced by","+// MetadataManager::ConvertToTransient while a checkpoint rewrites the same disk block in place.","+// Without the fix a stale, unloaded handle reads the block from disk; that read can overlap the","+// checkpoint's write of the same block. On filesystems that do not serialize buffered reads","+// against writes (e.g. ext4, tmpfs - unlike XFS) this produces a torn read and a spurious","+// checksum failure that invalidates the database.","+TEST_CASE(\"Stress stale metadata block handle pin against checkpoint rewrite\", \"[storage][.]\") {","+\tauto path = TestCreatePath(\"metadata_pin_race.db\");","+\tif (const char *dir = std::getenv(\"METADATA_PIN_RACE_DIR\")) {","+\t\t// allow redirecting the database to a filesystem on which reads can tear (e.g. tmpfs)","+\t\tpath = std::string(dir) + \"/metadata_pin_race.db\";","+\t}","+\tDeleteDatabase(path);","+\t{","+\t\tDuckDB db(path);","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE t(i INTEGER, s VARCHAR)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"INSERT INTO t SELECT i, repeat('x', 64) FROM range(50000) tbl(i)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t\tauto refs = GetBlockManagerRefs(db, con);","+\t\tauto &metadata_manager = *refs.metadata_manager;","+\t\tauto &buffer_manager = *refs.buffer_manager;","+","+\t\tstd::atomic<bool> done {false};","+\t\tstd::atomic<bool> checkpoint_active {false};","+\t\tstd::atomic<idx_t> corruption_count {0};","+\t\tstd::atomic<idx_t> other_error_count {0};","+\t\tstd::atomic<idx_t> stale_pin_count {0};","+\t\tstd::atomic<idx_t> stale_detected {0};","+\t\tstd::string first_error;","+\t\tmutex error_lock;","+","+\t\t// recently replaced (stale) metadata block handles, newest at the back","+\t\tmutex stale_lock;","+\t\tstd::vector<shared_ptr<BlockHandle>> recent_stale;","+","+\t\tstd::thread writer([&]() {","+\t\t\tConnection wcon(db);","+\t\t\tfor (idx_t i = 0; i < 5000 && !done; i++) {","+\t\t\t\twcon.Query(\"DELETE FROM t WHERE i % 97 = \" + std::to_string(i % 97));","+\t\t\t\twcon.Query(\"INSERT INTO t SELECT i, repeat('y', 64) FROM range(500) tbl(i)\");","+\t\t\t\tcheckpoint_active = true;","+\t\t\t\twcon.Query(\"CHECKPOINT\");","+\t\t\t\tcheckpoint_active = false;","+\t\t\t}","+\t\t\tdone = true;","+\t\t});","+","+\t\t// detects metadata block handles that were replaced in place (same block id, new handle)","+\t\tstd::thread collector([&]() {","+\t\t\tmap<block_id_t, shared_ptr<BlockHandle>> previous;","+\t\t\twhile (!done) {","+\t\t\t\tauto current = SnapshotMetadataHandles(metadata_manager);","+\t\t\t\t{","+\t\t\t\t\tlock_guard<mutex> guard(stale_lock);","+\t\t\t\t\tfor (auto &entry : previous) {","+\t\t\t\t\t\tauto it = current.find(entry.first);","+\t\t\t\t\t\t// the handle is stale if its block id now maps to a different handle, or if","+\t\t\t\t\t\t// the id is gone from the snapshot (converted to a transient block - whose","+\t\t\t\t\t\t// disk block the next flush rewrites in place - or fully freed)","+\t\t\t\t\t\tif (it == current.end() || it->second.get() != entry.second.get()) {","+\t\t\t\t\t\t\tstale_detected++;","+\t\t\t\t\t\t\trecent_stale.push_back(entry.second);","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t\twhile (recent_stale.size() > 64) {","+\t\t\t\t\t\trecent_stale.erase(recent_stale.begin());","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tprevious = std::move(current);","+\t\t\t\tstd::this_thread::sleep_for(std::chrono::microseconds(200));","+\t\t\t}","+\t\t});","+","+\t\tstd::vector<std::thread> readers;","+\t\tfor (idx_t r = 0; r < 8; r++) {","+\t\t\treaders.emplace_back([&]() {","+\t\t\t\twhile (!done) {","+\t\t\t\t\tif (!checkpoint_active) {","+\t\t\t\t\t\tstd::this_thread::sleep_for(std::chrono::microseconds(50));","+\t\t\t\t\t\tcontinue;","+\t\t\t\t\t}","+\t\t\t\t\tstd::vector<shared_ptr<BlockHandle>> targets;","+\t\t\t\t\t{","+\t\t\t\t\t\tlock_guard<mutex> guard(stale_lock);","+\t\t\t\t\t\ttargets = recent_stale;","+\t\t\t\t\t}","+\t\t\t\t\tfor (auto &handle : targets) {","+\t\t\t\t\t\tif (done) {","+\t\t\t\t\t\t\tbreak;","+\t\t\t\t\t\t}","+\t\t\t\t\t\t// unload the handle (if possible) so that pinning would read from disk","+\t\t\t\t\t\t{","+\t\t\t\t\t\t\tauto lock = handle->GetMemory().GetLock();","+\t\t\t\t\t\t\tif (handle->GetMemory().CanUnload() == CanUnloadResult::CAN_UNLOAD) {","+\t\t\t\t\t\t\t\thandle->GetMemory().Unload(lock);","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t\ttry {","+\t\t\t\t\t\t\tauto pin = buffer_manager.Pin(handle);","+\t\t\t\t\t\t\tstale_pin_count++;","+\t\t\t\t\t\t} catch (std::exception &ex) {","+\t\t\t\t\t\t\tErrorData error(ex);","+\t\t\t\t\t\t\t{","+\t\t\t\t\t\t\t\tlock_guard<mutex> guard(error_lock);","+\t\t\t\t\t\t\t\tif (first_error.empty()) {","+\t\t\t\t\t\t\t\t\tfirst_error = error.Message();","+\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tif (error.Type() == ExceptionType::DATA_CORRUPTION) {","+\t\t\t\t\t\t\t\tcorruption_count++;","+\t\t\t\t\t\t\t\tdone = true;","+\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\tother_error_count++;","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t});","+\t\t}","+\t\twriter.join();","+\t\tcollector.join();","+\t\tfor (auto &t : readers) {","+\t\t\tt.join();","+\t\t}","+\t\tfprintf(stderr, \"stale_detected=%llu stale_pins=%llu corruption=%llu other=%llu\\nfirst error: %s\\n\",","+\t\t        (unsigned long long)stale_detected.load(), (unsigned long long)stale_pin_count.load(),","+\t\t        (unsigned long long)corruption_count.load(), (unsigned long long)other_error_count.load(),","+\t\t        first_error.c_str());","+\t\t// no pin may ever observe a checksum failure","+\t\tREQUIRE(corruption_count.load() == 0);","+\t\tREQUIRE(other_error_count.load() == 0);","+\t}","+\tDeleteDatabase(path);","+}",""],"additions":317,"deletions":0,"truncated":false}],"additions":426,"deletions":31,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-09T15:16:02.541503+00:00"}