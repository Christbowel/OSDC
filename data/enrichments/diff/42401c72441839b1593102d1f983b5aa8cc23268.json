ers): array","     {","         // Verify the claims","         $clock = $this->getClock();","@@ -351,7 +355,7 @@ private function verifyClaims(array $claims): array","             new Checker\\NotBeforeChecker(clock: $clock, allowedTimeDrift: $this->allowedTimeDrift),","             new Checker\\ExpirationTimeChecker(clock: $clock, allowedTimeDrift: $this->allowedTimeDrift),","             new Checker\\CallableChecker('aud', fn ($value) => $this->matchesAudience($value)),","-            new Checker\\IssuerChecker($this->issuers),","+            new Checker\\IssuerChecker($issuers),","         ];","         $claimCheckerManager = new ClaimCheckerManager($checkers);"," "],"additions":9,"deletions":5,"truncated":false},{"path":"src/Symfony/Component/Security/Http/CHANGELOG.md","lines":["@@ -4,6 +4,7 @@ CHANGELOG"," 8.2"," ---"," ","+ * Allow the issuers announced by the discovery documents when `OidcTokenHandler` is given an empty list of issuers","  * Log the access tokens rejected by `OidcTokenHandler` at the `debug` level instead of `error`","  * Make `FormLoginAuthenticator` a `ReAuthenticationEntryPointInterface`, sending the user back to the login form with their identifier filled in","  * Add `AuthenticationUtils::getReAuthenticationAttribute()` and `SecurityRequestAttributes::RE_AUTHENTICATION_ATTRIBUTE`, the security attribute the current request is asking a re-authentication for"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Security/Http/Tests/AccessToken/Oidc/OidcTokenHandlerTest.php","lines":["@@ -793,6 +793,76 @@ public function testDiscoveryRejectsAnIssuerThatIsNotAllowed()","         }","     }"," ","+    public function testDiscoveryAcceptsTheIssuerItAnnouncesWhenNoIssuerIsGiven()","+    {","+        $httpClient = new MockHttpClient([","+            new JsonMockResponse(['issuer' => 'https://www.example.com', 'jwks_uri' => 'https://www.example.com/jwks.json']),","+            new JsonMockResponse(['keys' => [array_merg