le.com']], 'array'];","+    }","+","     public function testDiscoveryDocumentsOfEveryClientAreRequestedBeforeTheirJwks()","     {","         // the responses are lazy, so requesting every \".well-known\" document before consuming",""],"additions":70,"deletions":0,"truncated":false}],"additions":174,"deletions":11,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-13T15:28:35.559642+00:00"}