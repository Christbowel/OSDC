{"id":"8abd98a7141c4167f121f47117c8af3d7d9b5d1e","axis":"silent","repo":"microsoft/vscode","sha":"8abd98a7141c4167f121f47117c8af3d7d9b5d1e","parsed":{"files":[{"path":"build/lib/stylelint/vscode-known-variables.json","lines":["@@ -385,6 +385,7 @@"," \t\t\"--vscode-editorWidget-border\","," \t\t\"--vscode-editorWidget-foreground\","," \t\t\"--vscode-editorWidget-resizeBorder\",","+\t\t\"--vscode-editorWordWrapIndicator-foreground\","," \t\t\"--vscode-errorForeground\","," \t\t\"--vscode-extensionBadge-remoteBackground\","," \t\t\"--vscode-extensionBadge-remoteForeground\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/vs/editor/browser/view.ts","lines":["@@ -41,6 +41,7 @@ import { SelectionsOverlay } from './viewParts/selections/selections.js';"," import { ViewCursors } from './viewParts/viewCursors/viewCursors.js';"," import { ViewZones } from './viewParts/viewZones/viewZones.js';"," import { WhitespaceOverlay } from './viewParts/whitespace/whitespace.js';","+import { WordWrapIndicatorOverlay } from './viewParts/wordWrapIndicator/wordWrapIndicator.js';"," import { IEditorConfiguration } from '../common/config/editorConfiguration.js';"," import { EditorOption } from '../common/config/editorOptions.js';"," import { Position } from '../common/core/position.js';","@@ -220,6 +221,7 @@ export class View extends ViewEventHandler {"," \t\tcontentViewOverlays.addDynamicOverlay(new IndentGuidesOverlay(this._context));"," \t\tcontentViewOverlays.addDynamicOverlay(new DecorationsOverlay(this._context));"," \t\tcontentViewOverlays.addDynamicOverlay(new WhitespaceOverlay(this._context));","+\t\tcontentViewOverlays.addDynamicOverlay(new WordWrapIndicatorOverlay(this._context));"," "," \t\tconst marginViewOverlays = new MarginViewOverlays(this._context);"," \t\tthis._viewParts.push(marginViewOverlays);"],"additions":2,"deletions":0,"truncated":false},{"path":"src/vs/editor/browser/viewParts/wordWrapIndicator/wordWrapIndicator.css","lines":["@@ -0,0 +1,10 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+.monaco-editor .wwi {","+\tposition: absolute;","+\tpointer-events: none;","+\tcolor: var(--vscode-editorWordWrapIndicator-foreground);","+}"],"additions":10,"deletions":0,"truncated":false},{"path":"src/vs/editor/browser/viewParts/wordWrapIndicator/wordWrapIndicator.ts","lines":["@@ -0,0 +1,148 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import './wordWrapIndicator.css';","+import { DynamicViewOverlay } from '../../view/dynamicViewOverlay.js';","+import { RenderingContext } from '../../view/renderingContext.js';","+import { ViewContext } from '../../../common/viewModel/viewContext.js';","+import * as viewEvents from '../../../common/viewEvents.js';","+import { EditorOption } from '../../../common/config/editorOptions.js';","+import { IEditorConfiguration } from '../../../common/config/editorConfiguration.js';","+","+/**","+ * U+21A9 - LEFTWARDS ARROW WITH HOOK.","+ */","+const WORD_WRAP_INDICATOR_CHAR_CODE = 0x21A9;","+","+/**","+ * The word wrap indicator overlay renders a small glyph at the wrapping column of every view","+ * line which is soft wrapped, so that a wrapped line can be told apart from a real line break.","+ */","+export class WordWrapIndicatorOverlay extends DynamicViewOverlay {","+","+\tprivate readonly _context: ViewContext;","+\tprivate _options: WordWrapIndicatorOptions;","+\tprivate _renderResult: string[] | null;","+","+\tconstructor(context: ViewContext) {","+\t\tsuper();","+\t\tthis._context = context;","+\t\tthis._options = new WordWrapIndicatorOptions(this._context.configuration);","+\t\tthis._renderResult = null;","+\t\tthis._context.addEventHandler(this);","+\t}","+","+\tpublic override dispose(): void {","+\t\tthis._context.removeEventHandler(this);","+\t\tthis._renderResult = null;","+\t\tsuper.dispose();","+\t}","+","+\t/**","+\t * Whether the overlay paints anything at all. While it does not, every view event can be","+\t * answered with `false`, so the view is never asked to repaint on this overlay's behalf.","+\t */","+\tprivate get _isEnabled(): boolean {","+\t\treturn this._options.wordWrapIndicator && this._options.isWrapping;","+\t}","+","+\t// --- begin event handlers","+","+\tpublic override onConfigurationChanged(e: viewEvents.ViewConfigurationChangedEvent): boolean {","+\t\tconst wasEnabled = this._isEnabled;","+\t\tconst newOptions = new WordWrapIndicatorOptions(this._context.configuration);","+\t\tconst optionsChanged = !this._options.equals(newOptions);","+\t\tthis._options = newOptions;","+\t\treturn (wasEnabled || this._isEnabled) && optionsChanged;","+\t}","+\tpublic override onDecorationsChanged(e: viewEvents.ViewDecorationsChangedEvent): boolean {","+\t\treturn this._isEnabled;","+\t}","+\tpublic override onFlushed(e: viewEvents.ViewFlushedEvent): boolean {","+\t\treturn this._isEnabled;","+\t}","+\tpublic override onLineMappingChanged(e: viewEvents.ViewLineMappingChangedEvent): boolean {","+\t\t// Which lines continue with a wrapped line is decided by the line mapping.","+\t\treturn this._isEnabled;","+\t}","+\tpublic override onLinesChanged(e: viewEvents.ViewLinesChangedEvent): boolean {","+\t\treturn this._isEnabled;","+\t}","+\tpublic override onLinesDeleted(e: viewEvents.ViewLinesDeletedEvent): boolean {","+\t\treturn this._isEnabled;","+\t}","+\tpublic override onLinesInserted(e: viewEvents.ViewLinesInsertedEvent): boolean {","+\t\treturn this._isEnabled;","+\t}","+\tpublic override onScrollChanged(e: viewEvents.ViewScrollChangedEvent): boolean {","+\t\treturn this._isEnabled && e.scrollTopChanged;","+\t}","+\tpublic override onTokensChanged(e: viewEvents.ViewTokensChangedEvent): boolean {","+\t\treturn false;","+\t}","+\tpublic override onZonesChanged(e: viewEvents.ViewZonesChangedEvent): boolean {","+\t\treturn this._isEnabled;","+\t}","+\t// --- end event handlers","+","+\tpublic prepareRender(ctx: RenderingContext): void {","+\t\tif (!this._isEnabled) {","+\t\t\tthis._renderResult = null;","+\t\t\treturn;","+\t\t}","+\t\tthis._renderResult = [];","+\t\tfor (let lineNumber = ctx.viewportData.startLineNumber; lineNumber <= ctx.viewportData.endLineNumber; lineNumber++) {","+\t\t\tconst lineIndex = lineNumber - ctx.viewportData.startLineNumber;","+\t\t\tthis._renderResult[lineIndex] = this._renderLine(ctx, lineNumber);","+\t\t}","+\t}","+","+\tprivate _renderLine(ctx: RenderingContext, lineNumber: number): string {","+\t\tif (!ctx.viewportData.getViewLineContinuesWithWrappedLine(lineNumber)) {","+\t\t\t// The line ends with a real line break, or is the last line of the model.","+\t\t\treturn '';","+\t\t}","+\t\tconst lineHeight = ctx.getLineHeightForLineNumber(lineNumber);","+\t\treturn `<div class=\"wwi\" style=\"left:${this._options.indicatorLeft}px;height:${lineHeight}px;\">${String.fromCharCode(WORD_WRAP_INDICATOR_CHAR_CODE)}</div>`;","+\t}","+","+\tpublic render(startLineNumber: number, lineNumber: number): string {","+\t\tif (!this._renderResult) {","+\t\t\treturn '';","+\t\t}","+\t\tconst lineIndex = lineNumber - startLineNumber;","+\t\tif (lineIndex < 0 || lineIndex >= this._renderResult.length) {","+\t\t\treturn '';","+\t\t}","+\t\treturn this._renderResult[lineIndex];","+\t}","+}","+","+/**","+ * The subset of the editor configuration the overlay reads, snapshotted so that a configuration","+ * change can be told apart from one that leaves the rendered result untouched.","+ */","+class WordWrapIndicatorOptions {","+\tpublic readonly wordWrapIndicator: boolean;","+\tpublic readonly isWrapping: boolean;","+\tpublic readonly indicatorLeft: number;","+","+\tconstructor(config: IEditorConfiguration) {","+\t\tconst options = config.options;","+\t\tconst fontInfo = options.get(EditorOption.fontInfo);","+\t\tconst wrappingColumn = options.get(EditorOption.wrappingInfo).wrappingColumn;","+\t\tthis.wordWrapIndicator = options.get(EditorOption.wordWrapIndicator);","+\t\tthis.isWrapping = wrappingColumn !== -1;","+\t\tthis.indicatorLeft = wrappingColumn * fontInfo.typicalHalfwidthCharacterWidth;","+\t}","+","+\tpublic equals(other: WordWrapIndicatorOptions): boolean {","+\t\treturn (","+\t\t\tthis.wordWrapIndicator === other.wordWrapIndicator","+\t\t\t&& this.isWrapping === other.isWrapping","+\t\t\t&& this.indicatorLeft === other.indicatorLeft","+\t\t);","+\t}","+}"],"additions":148,"deletions":0,"truncated":false},{"path":"src/vs/editor/common/config/editorOptions.ts","lines":["@@ -341,6 +341,11 @@ export interface IEditorOptions {"," \t * Defaults to \"off\"."," \t */"," \twordWrap?: 'off' | 'on' | 'wordWrapColumn' | 'bounded';","+\t/**","+\t * Control whether an indicator is rendered at the wrapping column of soft wrapped lines.","+\t * Defaults to false.","+\t */","+\twordWrapIndicator?: boolean;"," \t/**"," \t * Override the `wordWrap` setting."," \t */","@@ -2919,6 +2924,7 @@ export class EditorLayoutInfoComputer extends ComputedEditorOption<EditorOption."," \t\tconst wordWrap = (wordWrapOverride1 === 'inherit' ? options.get(EditorOption.wordWrap) : wordWrapOverride1);"," "," \t\tconst wordWrapColumn = options.get(EditorOption.wordWrapColumn);","+\t\tconst wordWrapIndicator = options.get(EditorOption.wordWrapIndicator);"," \t\tconst isDominatedByLongLines = env.isDominatedByLongLines;"," "," \t\tconst showGlyphMargin = options.get(EditorOption.glyphMargin);","@@ -3006,7 +3012,9 @@ export class EditorLayoutIn