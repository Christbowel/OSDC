.append(local_token_lora_mapping)"," ","-        res = get_ep_group().dispatch(","-            a1q,","-            topk_weights,","-            topk_ids,","-            is_sequence_parallel=self.is_sequence_parallel,","-            extra_tensors=extra_tensors,","-        )","+        with self._comm_region():","+            res = get_ep_group().dispatch(","+                a1q,","+                topk_weights,","+                topk_ids,","+                is_sequence_parallel=self.is_sequence_parallel,","+                extra_tensors=extra_tensors,","+            )"," ","         if extra_tensors is None:","             assert len(res) == 3","@@ -238,11 +276,12 @@ def finalize(","             apply_router_weight_on_input=apply_router_weight_on_input,","         )"," ","-        get_ep_group().combine_into_output(","-            out,","-            output,","-            is_sequence_parallel=self.is_sequence_parallel,","-        )","+        with self._comm_region():","+            get_ep_group().combine_into_output(","+                out,","+                output,","+                is_sequence_parallel=self.is_sequence_parallel,","+            )"," "," "," class MoEPrepareAndFinalizeNaiveDPEPMonolithic(mk.FusedMoEPrepareAndFinalizeMonolithic):"],"additions":51,"deletions":12,"truncated":false},{"path":"vllm/models/deepseek_v4/amd/model.py","lines":["@@ -82,6 +82,7 @@"," from vllm.platforms import current_platform"," from vllm.platforms.rocm import on_gfx950"," from vllm.sequence import IntermediateTensors","+from vllm.v1.worker.ubatching import dbo_current_ubatch_token_offset"," "," from ..common.mm_preprocess import IMAGE_SENTINEL_BASE_ID"," ","@@ -1228,7 +1229,13 @@ def forward("," ","         if self._mtp_hidden_buffer is not None:","             num_tokens = hidden_states.shape[0]","-            self._mtp_hidden_buffer[:num_tokens].copy_(hidden_states.flatten(1))","+            # Each DBO ubatch owns a different slice of the batch. Writing","+            #