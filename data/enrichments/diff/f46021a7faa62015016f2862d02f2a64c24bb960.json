{"id":"f46021a7faa62015016f2862d02f2a64c24bb960","axis":"silent","repo":"vllm-project/vllm","sha":"f46021a7faa62015016f2862d02f2a64c24bb960","parsed":{"files":[{"path":"tests/kernels/moe/test_naive_dp_ep_dbo.py","lines":["@@ -0,0 +1,118 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+from types import SimpleNamespace","+from unittest.mock import MagicMock, patch","+","+import pytest","+import torch","+","+from vllm.model_executor.layers.fused_moe.prepare_finalize import naive_dp_ep","+from vllm.model_executor.layers.fused_moe.prepare_finalize.naive_dp_ep import (","+    MoEPrepareAndFinalizeNaiveDPEPModular,","+    make_moe_prepare_and_finalize_naive_dp_ep,","+)","+","+","+class _RegionProbe(MoEPrepareAndFinalizeNaiveDPEPModular):","+    def __init__(self) -> None:","+        super().__init__()","+        self.body_ran = False","+","+    def run_comm(self) -> None:","+        with self._comm_region():","+            self.body_ran = True","+","+","+@pytest.fixture","+def dbo_mocks():","+    yield_switch = MagicMock()","+    switch_back = MagicMock()","+    with (","+        patch.object(","+            naive_dp_ep, \"dbo_yield_and_switch_from_compute_to_comm\", yield_switch","+        ),","+        patch.object(naive_dp_ep, \"dbo_switch_to_compute_sync\", switch_back),","+    ):","+        yield {\"yield_switch\": yield_switch, \"switch_back\": switch_back}","+","+","+def _dbo_state(dbo_active: bool, capturing: bool):","+    return (","+        patch.object(naive_dp_ep, \"dbo_enabled\", return_value=dbo_active),","+        patch.object(torch.cuda, \"is_current_stream_capturing\", return_value=capturing),","+    )","+","+","+def test_comm_region_noop_without_dbo(dbo_mocks):","+    probe = _RegionProbe()","+    dbo, capturing = _dbo_state(dbo_active=False, capturing=False)","+    with dbo, capturing:","+        probe.run_comm()","+    assert probe.body_ran","+    dbo_mocks[\"yield_switch\"].assert_not_called()","+    dbo_mocks[\"switch_back\"].assert_not_called()","+","+","+def test_comm_region_handoff_when_dbo_active(dbo_mocks):","+    probe = _RegionProbe()","+    dbo, capturing = _dbo_state(dbo_active=True, capturing=False)","+    with dbo, capturing:","+        probe.run_comm()","+    assert probe.body_ran","+    dbo_mocks[\"yield_switch\"].assert_called_once_with()","+    dbo_mocks[\"switch_back\"].assert_called_once_with()","+","+","+def test_comm_region_skipped_during_graph_capture(dbo_mocks):","+    probe = _RegionProbe()","+    dbo, capturing = _dbo_state(dbo_active=True, capturing=True)","+    with dbo, capturing:","+        probe.run_comm()","+    assert probe.body_ran","+    dbo_mocks[\"yield_switch\"].assert_not_called()","+    dbo_mocks[\"switch_back\"].assert_not_called()","+","+","+def test_comm_region_restores_compute_stream_on_error(dbo_mocks):","+    probe = _RegionProbe()","+    dbo, capturing = _dbo_state(dbo_active=True, capturing=False)","+    with (","+        dbo,","+        capturing,","+        pytest.raises(RuntimeError, match=\"collective failed\"),","+        probe._comm_region(),","+    ):","+        raise RuntimeError(\"collective failed\")","+    dbo_mocks[\"yield_switch\"].assert_called_once_with()","+    dbo_mocks[\"switch_back\"].assert_called_once_with()","+","+","+@pytest.mark.parametrize(\"is_rocm\", [True, False])","+def test_supports_dbo_only_on_rocm(is_rocm):","+    inst = MoEPrepareAndFinalizeNaiveDPEPModular()","+    platform = SimpleNamespace(is_rocm=lambda: is_rocm)","+    with patch.object(naive_dp_ep, \"current_platform\", platform):","+        assert inst.supports_dbo() is is_rocm","+        # supports_async() also drives MK-internal shared-expert overlap, so","+        # it must not change with DBO support.","+        assert not inst.supports_async()","+","+","+@pytest.mark.parametrize(\"is_rocm\", [True, False])","+def test_factory_returns_base_classes(is_rocm):","+    platform = SimpleNamespace(is_rocm=lambda: is_rocm)","+    with patch.object(naive_dp_ep, \"current_platform\", platform):","+        mono = make_moe_prepare_and_finalize_naive_dp_ep(use_monolithic=True)","+        modular = make_moe_prepare_and_finalize_naive_dp_ep(use_monolithic=False)","+    assert type(mono) is naive_dp_ep.MoEPrepareAndFinalizeNaiveDPEPMonolithic","+    assert type(modular) is MoEPrepareAndFinalizeNaiveDPEPModular","+","+","+def test_default_supports_dbo_follows_supports_async():","+    # Classes that do not override supports_dbo() keep the old contract:","+    # DBO only with async prepare/finalize.","+    mono = naive_dp_ep.MoEPrepareAndFinalizeNaiveDPEPMonolithic()","+    assert not mono.supports_async()","+    assert not mono.supports_dbo()","+    with patch.object(type(mono), \"supports_async\", return_value=True):","+        assert mono.supports_dbo()"],"additions":118,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_ubatch_offsets.py","lines":["@@ -0,0 +1,80 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import threading","+from unittest.mock import patch","+","+import numpy as np","+","+from vllm.v1.worker import ubatching","+from vllm.v1.worker.ubatch_utils import maybe_create_ubatch_slices","+from vllm.v1.worker.ubatching import (","+    dbo_current_ubatch_token_offset,","+    make_ubatch_contexts,","+)","+","+","+def test_token_offset_without_dbo_context():","+    assert dbo_current_ubatch_token_offset() == 0","+","+","+def test_token_offset_defaults_to_zero():","+    ready_barrier = threading.Barrier(3)","+    ctxs = make_ubatch_contexts(","+        num_micro_batches=2,","+        compute_stream=object(),","+        comm_stream=object(),","+        forward_contexts=[object(), object()],","+        ready_barrier=ready_barrier,","+    )","+    assert [ctx.token_offset for ctx in ctxs] == [0, 0]","+","+","+def test_token_offset_per_ubatch_thread():","+    compute_stream = object()","+    ready_barrier = threading.Barrier(3)","+    ctxs = make_ubatch_contexts(","+        num_micro_batches=2,","+        compute_stream=compute_stream,","+        comm_stream=object(),","+        forward_contexts=[object(), object()],","+        ready_barrier=ready_barrier,","+        token_offsets=[0, 7],","+    )","+    assert [ctx.token_offset for ctx in ctxs] == [0, 7]","+","+    offsets_seen: dict[int, int] = {}","+","+    def run(ctx: ubatching.UBatchContext) -> None:","+        with ctx:","+            offsets_seen[ctx.id] = dbo_current_ubatch_token_offset()","+","+    # Keep torch.cuda.set_stream out of the way. Patch once here rather than","+    # per thread: a per-thread patch exit would restore the real function","+    # while the other thread is still inside its context.","+    with patch.object(ubatching, \"current_stream\", return_value=compute_stream):","+        threads = [threading.Thread(target=run, args=(ctx,)) for ctx in ctxs]","+        for thread in threads:","+            thread.start()","+        ready_barrier.wait()","+        ctxs[0].cpu_wait_event.set()","+        for thread in threads:","+            thread.join()","+","+    assert offsets_seen == {0: 0, 1: 7}","+","+","+def test_ubatch_slice_bounds_are_python_ints():","+    # The last bound comes from np.cumsum; numpy scalars leaking into the","+    # per-ubatch metadata break Triton argument specialization.","+    ubatch_slices, ubatch_slices_padded = maybe_create_ubatch_slices(","+        should_ubatch=True,","+        num_scheduled_tokens=np.array([5, 9, 6], dtype=np.int32),","+        num_tokens_padded=20,","+        num_reqs_padded=3,","+        num_ubatches=2,","+    )","+    for slices in (ubatch_slices, ubatch_slices_padded):","+        assert slices is not None","+        for s in slices:","+            for bound in (s.token_slice.start, s.token_slice.stop):","+                assert type(bound) is int"],"additions":80,"deletions":0,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -2116,17 +2116,28 @@ def has_blocked_weights():"," ","         if self.parallel_config.use_ubatching:","             a2a_backend = self.parallel_config.all2all_backend","-            assert a2a_backend in [","-                \"deepep_low_latency\",","-                \"deepep_high_throughput\",","-                \"nixl_ep\",","-            ], (","-                \"Microbatching currently only supports the deepep_low_latency, \"","-                \"deepep_high_throughput, and nixl_ep all2all backends. \"","-                f\"{a2a_backend} is not supported. To fix use \"","-                \"--all2all-backend=deepep_low_latency, \"","-                \"--all2all-backend=deepep_high_throughput, or \"","-                \"--all2all-backend=nixl_ep and install the matching kernels.\"","+            if current_platform.is_rocm():","+                supported_backends = [","+                    \"deepep_low_latency\",","+                    \"deepep_high_throughput\",","+                    \"nixl_ep\",","+                    # The naive DP/EP prepare/finalize runs its all-gather /","+                    # reduce-scatter on the comm stream under DBO.","+                    \"allgather_reducescatter\",","+                ]","+            else:","+                # CUDA and other platforms.","+                supported_backends = [","+                    \"deepep_low_latency\",","+                    \"deepep_high_throughput\",","+                    \"nixl_ep\",","+                ]","+            assert a2a_backend in supported_backends, (","+                \"Microbatching currently only supports the \"","+                f\"{', '.join(supported_backends)} all2all backends on this \"","+                f\"platform. {a2a_backend} is not supported. To fix use one of \"","+                f\"{', '.join('--all2all-backend=' + b for b in supported_backends)}\"","+                \" and install the matching kernels.\"","             )"," ","         if not self.instance_id:"],"additions":22,"deletions":11,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/modular_kernel.py","lines":["@@ -258,6 +258,15 @@ def supports_async(self) -> bool:","         \"\"\"","         return False"," ","+    def supports_dbo(self) -> bool:","+        \"\"\"Indicates whether or not this class can run under DBO.","+","+        Defaults to supports_async(). A class whose synchronous prepare and","+        finalize do their own DBO compute/comm handoff can return True here","+        while keeping supports_async() False.","+        \"\"\"","+        return self.supports_async()","+","     def supports_deferred_moe_finalize(self) -> bool:","         \"\"\"Whether ``finalize`` can be skipped for a deferring consumer."," ","@@ -1206,7 +1215,7 @@ def _prepare(","             # We shouldn't be running an a2a kernel that doesn't","             # support async prepare/finalize","             # TODO(lucas): enable in follow-up","-            assert not dbo_enabled()","+            assert not dbo_enabled() or self.prepare_finalize.supports_dbo()"," ","             (","                 a1q,","@@ -1394,7 +1403,7 @@ def _finalize("," ","         \"\"\"","         if not self.prepare_finalize.supports_async():","-            assert not dbo_enabled()","+            assert not dbo_enabled() or self.prepare_finalize.supports_dbo()"," ","             self.prepare_finalize.finalize(","                 output,"],"additions":11,"deletions":2,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/prepare_finalize/naive_dp_ep.py","lines":["@@ -1,5 +1,8 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+from collections.abc import Iterator","+from contextlib import contextmanager","+"," import torch"," "," import vllm.model_executor.layers.fused_moe.modular_kernel as mk","@@ -11,7 +14,13 @@","     TopKWeightAndReduceNoOP,"," )"," from vllm.model_executor.layers.fused_moe.utils impo