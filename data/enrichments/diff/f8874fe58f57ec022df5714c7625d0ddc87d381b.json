{"id":"f8874fe58f57ec022df5714c7625d0ddc87d381b","axis":"silent","repo":"symfony/symfony","sha":"f8874fe58f57ec022df5714c7625d0ddc87d381b","parsed":{"files":[{"path":"src/Symfony/Bundle/FrameworkBundle/CHANGELOG.md","lines":["@@ -4,6 +4,8 @@ CHANGELOG"," 8.2"," ---"," ","+ * Add `KernelBrowser::sendWebhook()` to post a webhook signed as its `webhook.routing` entry expects","+ * Add `WebhookAssertionsTrait` to `KernelTestCase` to assert on the webhooks sent with the `webhook.transport` service","  * Make `MailerAssertionsTrait` and `NotificationAssertionsTrait` see the emails and notifications sent during the previous requests of the test client","  * Add the `kernel.test_state` tag to call a method of a service when a test ends, or to keep a copy of the service before each reset until the test ends","  * Pass the token of `KernelBrowser::loginUser()` with each request, so that stateless firewalls can read it"],"additions":2,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/KernelBrowser.php","lines":["@@ -18,12 +18,14 @@"," use Symfony\\Component\\BrowserKit\\History;"," use Symfony\\Component\\BrowserKit\\Request as DomRequest;"," use Symfony\\Component\\DependencyInjection\\ContainerInterface;","+use Symfony\\Component\\DomCrawler\\Crawler;"," use Symfony\\Component\\HttpFoundation\\Request;"," use Symfony\\Component\\HttpFoundation\\Response;"," use Symfony\\Component\\HttpFoundation\\Session\\SessionInterface;"," use Symfony\\Component\\HttpKernel\\HttpKernelBrowser;"," use Symfony\\Component\\HttpKernel\\KernelInterface;"," use Symfony\\Component\\HttpKernel\\Profiler\\Profile as HttpProfile;","+use Symfony\\Component\\Routing\\Exception\\RouteNotFoundException;"," use Symfony\\Component\\Security\\Core\\User\\UserInterface;"," "," /**","@@ -220,6 +222,39 @@ protected function filterRequest(DomRequest $request): Request","         return $httpRequest;","     }"," ","+    /**","+     * Posts a webhook to the application, signed as the \"webhook.routing\" entry of the given type expects it.","+     *","+     * Only the routing entries that use the generic request parser of the Webhook component are supported.","+     *","+     * @param string               $type    The key of the \"webhook.routing\" entry","+     * @param array<string, mixed> $payload The payload, sent as JSON","+     * @param string|null          $secret  A secret to sign the webhook with instead of the configured one, to check that it is rejected","+     */","+    public function sendWebhook(string $type, string $event, array $payload = [], #[\\SensitiveParameter] ?string $secret = null): Crawler","+    {","+        $container = $this->getContainer();","+","+        if (!$container->has('webhook.test.request_factory')) {","+            throw new \\LogicException(\\sprintf('\"%s\" requires the Webhook component to be enabled. Try running \"composer require symfony/webhook\".', __METHOD__));","+        }","+","+        try {","+            $uri = $container->get('router')->generate('_webhook_controller', ['type' => $type]);","+        } catch (RouteNotFoundException $e) {","+            throw new \\LogicException(\\sprintf('\"%s\" requires the \"_webhook_controller\" route. Did you forget to import \"@FrameworkBundle/Resources/config/routing/webhook.php\" in your routes?', __METHOD__), 0, $e);","+        }","+","+        $request = $container->get('webhook.test.request_factory')->createRequest($uri, $type, $event, $payload, $secret);","+        $server = [];","+","+        foreach ($request->headers->all() as $name => $values) {","+            $server['content-type' === $name ? 'CONTENT_TYPE' : 'HTTP_'.strtoupper(strtr($name, '-', '_'))] = implode(', ', $values);","+        }","+","+        return $this->request('POST', $uri, [], [], $server, $request->getContent());","+    }","+","     /**","      * @param Request $request","      */"],"additions":35,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Test/KernelTestCase.php","lines":["@@ -31,6 +31,7 @@ abstract class KernelTestCase extends TestCase","     use MailerAssertionsTrait;","     use MessengerAssertionsTrait;","     use NotificationAssertionsTrait;","+    use WebhookAssertionsTrait;"," ","     protected static ?string $class = null;","     protected static ?KernelInterface $kernel = null;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Test/WebhookAssertionsTrait.php","lines":["@@ -0,0 +1,106 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bundle\\FrameworkBundle\\Test;","+","+use Symfony\\Component\\Webhook\\Messenger\\SendWebhookMessage;","+use Symfony\\Component\\Webhook\\Server\\TraceableTransport;","+","+/**","+ * Checks the webhooks that the application sent with the \"webhook.transport\" service.","+ */","+trait WebhookAssertionsTrait","+{","+    /**","+     * Asserts the number of webhooks sent, to the given URL when it is not null.","+     */","+    public static function assertWebhookCount(int $count, ?string $url = null, string $message = ''): void","+    {","+        self::assertCount($count, self::getSentWebhooks($url), $message ?: \\sprintf('Failed asserting that %d webhook(s) were sent%s.', $count, null === $url ? '' : ' to \"'.$url.'\"'));","+    }","+","+    /**","+     * Asserts that a webhook was sent to the given URL, with the given event name and payload when they are not null.","+     *","+     * @param array<string, mixed>|null $payload","+     */","+    public static function assertWebhookSent(string $url, ?string $event = null, ?array $payload = null, string $message = ''): void","+    {","+        $webhooks = self::getSentWebhooks($url);","+        $sent = array_map(static fn (SendWebhookMessage $webhook) => \\sprintf('\"%s\" with payload %s', $webhook->getEvent()->getName(), self::encodeWebhookPayload($webhook->getEvent()->getPayload())), $webhooks);","+","+        self::assertNotEmpty(self::filterSentWebhooks($webhooks, $event, $payload), $message ?: \\sprintf('Failed asserting that a %s was sent to \"%s\". %s.', self::describeWebhook($event, $payload), $url, $sent ? 'Webhooks sent to this URL: '.implode(', ', $sent) : 'No webhook was sent to this URL'));","+    }","+","+    /**","+     * Asserts that no webhook was sent to the given URL, with the given event name and payload when they are not null.","+     *","+     * @param array<string, mixed>|null $payload","+     */","+    public static function assertWebhookNotSent(string $url, ?string $event = null, ?array $payload = null, string $message = ''): void","+    {","+        self::assertEmpty(self::filterSentWebhooks(self::getSentWebhooks($url), $event, $payload), $message ?: \\sprintf('Failed asserting that no %s was sent to \"%s\".', self::describeWebhook($event, $payload), $url));","+    }","+","+    /**","+     * Returns the webhooks sent, to the given URL when it is not null, the oldest first.","+     *","+     * @return list<SendWebhookMessage>","+     */","+    public static function getSentWebhooks(?string $url = null): array","+    {","+        $container = static::getContainer();","+","+        if (!$container->has('webhook.transport.traceable')) {","+            static::fail('The Webhook component must be enabled with an HTTP client to make webhook assertions. Did you forget to require symfony/webhook or symfony/http-client?');","+        }","+","+        $transports = $container instanceof TestContainer ? $container->getKeptState('webhook.transport.traceable') : [];","+        $transports[] = $container->get('webhook.transport.traceable');","+        $webhooks = array_merge(...array_map(static fn (TraceableTransport $transport) => $transport->getSentWebhooks(), $transports));","+","+        if (null !== $url) {","+            $webhooks = array_values(array_filter($webhooks, static fn (SendWebhookMessage $webhook) => $url === $webhook->getSubscriber()->getUrl()));","+        }","+","+        return $webhooks;","+    }","+","+    /**","+     * @param list<SendWebhookMessage> $webhooks","+     *","+     * @return list<SendWebhookMessage>","+     */","+    private static function filterSentWebhooks(array $webhooks, ?string $event, ?array $payload): array","+    {","+        return array_values(array_filter($webhooks, static fn (SendWebhookMessage $webhook) => (null === $event || $event === $webhook->getEvent()->getName()) && (null === $payload || $payload == $webhook->getEvent()->getPayload())));","+    }","+","+    private static function describeWebhook(?string $event, ?array $payload): string","+    {","+        $conditions = [];","+","+        if (null !== $event) {","+            $conditions[] = \\sprintf('event \"%s\"', $event);","+        }","+","+        if (null !== $payload) {","+            $conditions[] = 'payload '.self::encodeWebhookPayload($payload);","+        }","+","+        return $conditions ? 'webhook with '.implode(' and ', $conditions) : 'webhook';","+    }","+","+    private static function encodeWebhookPayload(array $payload): string","+    {","+        return json_encode($payload, \\JSON_UNESCAPED_SLASHES | \\JSON_UNESCAPED_UNICODE | \\JSON_PARTIAL_OUTPUT_ON_ERROR);","+    }","+}"],"additions":106,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/Bundle/TestBundle/Controller/WebhookSenderController.php","lines":["@@ -0,0 +1,48 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional\\Bundle\\TestBundle\\Controller;","+","+use Symfony\\Component\\HttpFoundation\\RedirectResponse;","+use Symfony\\Component\\HttpFoundation\\Response;","+use Symfony\\Component\\Messenger\\MessageBusInterface;","+use Symfony\\Component\\RemoteEvent\\RemoteEvent;","+use Symfony\\Component\\Webhook\\Messenger\\SendWebhookMessage;","+use Symfony\\Component\\Webhook\\Server\\TransportInterface;","+use Symfony\\Component\\Webhook\\Subscriber;","+","+class WebhookSenderController","+{","+    public function __construct(","+        private TransportInterface $transport,","+        private MessageBusInterface $bus,","+    ) {","+    }","+","+    public function send(string $event): Response","+    {","+        $this->transport->send(new Subscriber('https://example.com/webhook', 'the-secret'), new RemoteEvent($event, 'order-42', ['order' => 42]));","+","+        return new RedirectResponse('/webhook-sender/sent');","+    }","+","+    public function dispatch(string $event): Response","+    {","+        $this->bus->dispatch(new SendWebhookMessage(new Subscriber('https://example.com/webhook', 'the-secret'), new RemoteEvent($event, 'order-42', ['order' => 42])));","+","+        return new Response('', 202);","+    }","+","+    public function sent(): Response","+    {","+        return new Response('');","+    }","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/WebhookTest.php","lines":["@@ -0,0 +1,145 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional;","+","+use PHPUnit\\Framework\\AssertionFailedError;","+use Symfony\\Component\\Clock\\Test\\ClockSensitiveTrait;","+use Symfony\\Component\\RemoteEvent\\Messenger\\ConsumeRemoteEventMessage;","+use Symfony\\Component\\Webhook\\Messenger\\SendWebhookMessage;","+","+class WebhookTest extends AbstractWebTestCase","+{","+    use ClockSensitiveTrait;","+","+    public function testIncomingWebhooksAreSignedAsTheirRoutingEntryExpects()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $client->sendWebhook('payments', 'payment.succeeded', ['amount' => 42]);","+","+        $this->assertResponseStatusCodeSame(202);","+        $this->assertSame('/webhook/payments', $client->getRequest()->getPathInfo());","+        $this->assertQueuedMessageCount(1, 'async', ConsumeRemoteEventMessage::class);","+","+        $message = $this->getQueuedMessages('async')[0]->getMessage();","+        $this->assertSame('payments', $message->getType());","+        $this->assertSame('payment.succeeded', $message->getEvent()->getName());","+        $this->assertSame(['amount' => 42, 'type' => 'payment.succeeded'], $message->getEvent()->getPayload());","+    }","+","+    public function testIncomingWebhooksSignedWithAnotherSecretAreRejected()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $client->sendWebhook('payments', 'payment.succeeded', ['amount' => 42], 'whsec_'.base64_encode('not the secret'));","+","+        $this->assertResponseStatusCodeSame(406);","+        $this->assertQueuedMessageCount(0, 'async');","+    }","+","+    public function testIncomingWebhooksAreTimestampedByTheClock()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $clock = static::mockTime('2026-10-11 12:00:00');","+        $client->sendWebhook('payments', 'payment.succeeded');","+","+        $this->assertResponseStatusCodeSame(202);","+        $this->assertSame((string) $clock->now()->getTimestamp(), $client->getRequest()->headers->get('Webhook-Timestamp'));","+","+        static::mockTime('+1 hour');","+        $client->reload();","+","+        $this->assertResponseStatusCodeSame(406);","+    }","+","+    public function testSendWebhookRequiresTheWebhookComponent()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook', 'root_config' => 'disabled.yml']);","+","+        $this->expectException(\\LogicException::class);","+        $this->expectExceptionMessage('\"Symfony\\Bundle\\FrameworkBundle\\KernelBrowser::sendWebhook\" requires the Webhook component to be enabled. Try running \"composer require symfony/webhook\".');","+","+        $client->sendWebhook('payments', 'payment.succeeded');","+    }","+","+    public function testSendWebhookRequiresTheWebhookRoutes()","+    {","+        $client = $this->createClient(['test_case' => 'ConfigureContainer']);","+","+        $this->expectException(\\LogicException::class);","+        $this->expectExceptionMessage('\"Symfony\\Bundle\\FrameworkBundle\\KernelBrowser::sendWebhook\" requires the \"_webhook_controller\" route. Did you forget to import \"@FrameworkBundle/Resources/config/routing/webhook.php\" in your routes?');","+","+        $client->sendWebhook('payments', 'payment.succeeded');","+    }","+","+    public function testSentWebhooksCanBeAsserted()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $client->request('GET', '/webhook-sender/send/order.paid');","+","+        $this->assertWebhookCount(1);","+        $this->assertWebhookCount(1, 'https://example.com/webhook');","+        $this->assertWebhookCount(0, 'https://example.org/webhook');","+        $this->assertWebhookSent('https://example.com/webhook');","+        $this->assertWebhookSent('https://example.com/webhook', 'order.paid');","+        $this->assertWebhookSent('https://example.com/webhook', 'order.paid', ['order' => 42]);","+        $this->assertWebhookNotSent('https://example.org/webhook');","+        $this->assertWebhookNotSent('https://example.com/webhook', 'order.refunded');","+        $this->assertWebhookNotSent('https://example.com/webhook', 'order.paid', ['order' => 43]);","+","+        $webhooks = $this->getSentWebhooks();","+        $this->assertCount(1, $webhooks);","+        $this->assertSame('order-42', $webhooks[0]->getEvent()->getId());","+    }","+","+    public function testAssertWebhookSentListsTheWebhooksSentToTheUrl()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $client->request('GET', '/webhook-sender/send/order.paid');","+","+        $this->expectException(AssertionFailedError::class);","+        $this->expectExceptionMessage('Failed asserting that a webhook with event \"order.refunded\" was sent to \"https://example.com/webhook\". Webhooks sent to this URL: \"order.paid\" with payload {\"order\":42}.');","+","+        $this->assertWebhookSent('https://example.com/webhook', 'order.refunded');","+    }","+","+    public function testWebhookAssertionsRequireTheWebhookComponent()","+    {","+        self::bootKernel(['test_case' => 'Webhook', 'root_config' => 'disabled.yml']);","+","+        $this->expectException(AssertionFailedError::class);","+        $this->expectExceptionMessage('The Webhook component must be enabled with an HTTP client to make webhook assertions. Did you forget to require symfony/webhook or symfony/http-client?');","+","+        $this->assertWebhookCount(0);","+    }","+","+    public function testWebhooksSentBeforeARebootAreKept()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $client->request('GET', '/webhook-sender/send/order.paid');","+        $this->assertResponseRedirects('/webhook-sender/sent');","+        $client->followRedirect();","+        $client->request('GET', '/webhook-sender/send/order.refunded');","+","+        $this->assertSame(['order.paid', 'order.refunded'], array_map(static fn (SendWebhookMessage $webhook) => $webhook->getEvent()->getName(), $this->getSentWebhooks()));","+    }","+","+    public function testWebhooksSentByAWorkerAreSeen()","+    {","+        $client = $this->createClient(['test_case' => 'Webhook']);","+        $client->request('GET', '/webhook-sender/dispatch/order.paid');","+","+        $this->assertWebhookCount(0);","+","+        $this->consumeQueuedMessages('async');","+","+        $this->assertWebhookSent('https://example.com/webhook', 'order.paid', ['order' => 42]);","+    }","+}"],"additions":145,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/app/Webhook/bundles.php","lines":["@@ -0,0 +1,16 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+use Symfony\\Bundle\\FrameworkBundle\\FrameworkBundle;","+","+return [","+    new FrameworkBundle(),","+];"],"additions":16,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/app/Webhook/config.yml","lines":["@@ -0,0 +1,17 @@","+imports:","+    - { resource: ../config/default.yml }","+    - { resource: services.yml }","+","+framework:","+    messenger:","+        transports:","+            async: 'in-memory://'","+        routing:","+            Symfony\\Component\\RemoteEvent\\Messenger\\ConsumeRemoteEventMessage: async","+            Symfony\\Component\\Webhook\\Messenger\\SendWebhookMessage: async","+    webhook:","+        http_client: test.webhook_http_client","+        signature_format: standard","+        routing:","+            payments:","+                secret: 'whsec_dGhlLXNlY3JldA=='"],"additions":17,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/app/Webhook/disabled.yml","lines":["@@ -0,0 +1,5 @@","+imports:","+    - { resource: ../config/default.yml }","+","+framework:","+    webhook: false"],"additions":5,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/app/Webhook/routing.yml","lines":["@@ -0,0 +1,15 @@","+webhook:","+    resource: '@FrameworkBundle/Resources/config/routing/webhook.php'","+    prefix: /webhook","+","+webhook_sender_send:","+    path:     /webhook-sender/send/{event}","+    defaults: { _controller: Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional\\Bundle\\TestBundle\\Controller\\WebhookSenderController::send }","+","+webhook_sender_dispatch:","+    path:     /webhook-sender/dispatch/{event}","+    defaults: { _controller: Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional\\Bundle\\TestBundle\\Controller\\WebhookSenderController::dispatch }","+","+webhook_sender_sent:","+    path:     /webhook-sender/sent","+    defaults: { _controller: Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional\\Bundle\\TestBundle\\Controller\\WebhookSenderController::sent }"],"additions":15,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/Functional/app/Webhook/services.yml","lines":["@@ -0,0 +1,7 @@","+services:","+    test.webhook_http_client:","+        class: Symfony\\Component\\HttpClient\\MockHttpClient","+","+    Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional\\Bundle\\TestBundle\\Controller\\WebhookSenderController:","+        public: true","+        arguments: ['@webhook.transport', '@messenger.default_bus']"],"additions":7,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Webhook/CHANGELOG.md","lines":["@@ -4,6 +4,8 @@ CHANGELOG"," 8.2"," ---"," ","+ * Add `TraceableTransport` to record the webhooks sent through a transport","+ * Add `Test\\RequestFactory` to create the requests that the generic request parser accepts","  * Deprecate the `RequestParser` autowiring alias, use the `webhook.request_parser` service or `#[Target('webhook')]` with `RequestParserInterface` instead","  * Add `WebhookBundle`, which provides the `webhook` configuration and the services previously provided by `FrameworkBundle` under `framework.webhook`","  * Add the `webhook.no_private_network` and `webhook.http_client` options"],"additions":2,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Webhook/DependencyInjection/RemoveMissingDependenciesPass.php","lines":["@@ -39,6 +39,7 @@ public function process(ContainerBuilder $container): void"," ","         if (!$container->has((string) $httpClient->getArgument(0))) {","             $container->removeDefinition('webhook.http_client');","+            $container->removeDefinition('webhook.transport.traceable');","             $transport","                 ->setArguments([])","                 ->addError('You cannot use the \"webhook transport\" service since the HttpClient component is not '"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Webhook/Resources/config/webhook.php","lines":["@@ -20,7 +20,9 @@"," use Symfony\\Component\\Webhook\\Server\\JsonBodyConfigurator;"," use Symfony\\Component\\Webhook\\Server\\NativeJsonPayloadSerializer;"," use Symfony\\Component\\Webhook\\Server\\SerializerPayloadSerializer;","+use Symfony\\Component\\Webhook\\Server\\TraceableTransport;"," use Symfony\\Component\\Webhook\\Server\\Transport;","+use Symfony\\Component\\Webhook\\Test\\RequestFactory;"," "," return static function (ContainerConfigurator $container) {","     $container->services()","@@ -89,5 +91,26 @@","                 abstract_arg('user defined parsers'),","                 abstract_arg('message bus'),","             ])","+","+        ->set('webhook.transport.traceable', TraceableTransport::class)","+            ->decorate('webhook.transport')","+            ->args([service('.inner')])","+            ->tag('kernel.reset', ['method' => 'reset'])","+            ->tag('kernel.test_state', ['keep' => true])","+            ->tag('container.remove_if_missing', ['service' => 'test.service_container'])","+","+        ->set('webhook.test.request_factory', RequestFactory::class)","+            ->public()","+            ->args([","+                abstract_arg('secrets'),","+                abstract