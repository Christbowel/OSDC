ces key by key. The listed aliases are","+ * keyed before that merge and listed again after it; the aliases given under a name keep it and are merged by name.","+ *","+ * @internal","+ */","+final readonly class AliasList","+{","+    private const ADDED_UP = \"\\0\";","+","+    private const REPLACED = \"\\1\";","+","+    /**","+     * Keys each listed alias by itself, so that the lists add up.","+     *","+     * @param array<array-key, mixed> $aliases","+     *","+     * @return array<array-key, mixed>","+     */","+    public static function keyToAddUp(array $aliases): array","+    {","+        $keyed = [];","+        foreach ($aliases as $key => $alias) {","+            if (is_int($key) && is_string($alias)) {","+                $key = self::ADDED_UP . $alias;","+            }","+            $keyed[$key] = $alias;","+        }","+","+        return $keyed;","+    }","+","+    /**","+     * Keys each listed alias by its position and records the length of the list, so that the last list replaces the","+     * previous ones.","+     *","+     * @param array<array-key, mixed> $aliases","+     *","+     * @return array<array-key, mixed>","+     */","+    public static function keyToReplace(array $aliases): array","+    {","+        $keyed = [];","+        $length = 0;","+        foreach ($aliases as $key => $alias) {","+            if (is_int($key) && is_string($alias)) {","+                $key = self::REPLACED . $length++;","+            }","+            $keyed[$key] = $alias;","+        }","+        if ($length !== 0) {","+            $keyed[self::REPLACED] = $length;","+        }","+","+        return $keyed;","+    }","+","+    /**","+     * @param array<array-key, mixed> $aliases","+     *","+     * @return array<array-key, mixed>","+     */","+    public static function restore(array $aliases): array","+    {","+        $length = $aliases[self::REPLACED] ?? null;","+        unset($aliases[self::REPLACED]);","+        $restored = [];","+        foreach ($aliases as $key => $alias) {","+            $replaced = is_string($key) && str_starts_with($key, self::REPLACED);","+            if ($replaced && is_int($length) && (int) substr($key, 1) >= $length) {","+                continue;","+            }","+            if ($replaced || (is_string($key) && str_starts_with($key, self::ADDED_UP))) {","+                $restored[] = $alias;","+            } else {","+                $restored[$key] = $alias;","+            }","+        }","+","+        return $restored;","+    }","+}"],"additions":92,"deletions":0,"truncated":false},{"path":"src/Bundle/DependencyInjection/Source/Checker/CheckerAliases.php","lines":["@@ -1,24 +0,0 @@","-<?php","-","-declare(strict_types=1);","-","-namespace Jose\\Bundle\\JoseFramework\\DependencyInjection\\Source\\Checker;","-","-/**","- * The checker lists of a service configured in several places add up, and ConfigurationHelper prepends a copy of the","- * first configuration, so the same alias can be listed more than once.","- *","- * @internal","- */","-final readonly class CheckerAliases","-{","-    /**","-     * @param array<array-key, scalar> $aliases","-     *","-     * @return list<scalar>","-     */","-    public static function unique(array $aliases): array","-    {","-        return array_values(array_unique($aliases));","-    }","-}"],"additions":0,"deletions":24,"truncated":false},{"path":"src/Bundle/DependencyInjection/Source/Checker/ClaimChecker.php","lines":["@@ -4,6 +4,7 @@"," "," namespace Jose\\Bundle\\JoseFramework\\DependencyInjection\\Source\\Checker;"," ","+use Jose\\Bundle\\JoseFramework\\DependencyInjection\\Source\\AliasList;"," use Jose\\Bundle\\JoseFramework\\DependencyInjection\\Source\\Source;"," use Jose\\Bundle\\JoseFramework\\Services\\ClaimCheckerManager;"," use Jose\\Bundle\\JoseFramework\\Services\\ClaimCheckerManagerFactory;","@@ -62,11 +63,16 @@ public function getNodeDefinition(NodeDefinition $node): void","             ->end()","             ->arrayNode('claims