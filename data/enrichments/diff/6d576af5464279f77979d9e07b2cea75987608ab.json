st{}, fmt.Errorf(\"legacy permission namespace does not match evaluation organization\")"," \t}"," \tvar internalID *int64"," \tif id, err := usr.GetInternalID(); err == nil {","@@ -65,7 +73,7 @@ func GetLegacyUserPermissions(ctx context.Context, client legacyclient.Service,"," \tif cfg.IDUseExternalGroupsForGroupsClaim {"," \t\tgroups = usr.GetExternalGroups()"," \t}","-\tresponse, err := client.LegacyGetUserPermissions(ctx, legacypermissions.LegacyPermissionCaller(namespace), legacyclient.LegacyGetUserPermissionsRequest{","+\treturn legacyclient.LegacyGetUserPermissionsRequest{"," \t\tNamespace:        namespace,"," \t\tGlobalOrg:        global,"," \t\tNoOrgMembership:  noOrgMembership,","@@ -77,11 +85,18 @@ func GetLegacyUserPermissions(ctx context.Context, client legacyclient.Service,"," \t\t\tTeamIDs: slices.Clone(usr.GetTeams()), Groups: slices.Clone(groups),"," \t\t\tCacheKey: &cacheKey, RequesterNamespace: &originalNamespace,"," \t\t},","-\t})","+\t}, nil","+}","+","+func loadLegacyUserPermissions(ctx context.Context, client legacyclient.Service, req legacyclient.LegacyGetUserPermissionsRequest) ([]ac.Permission, error) {","+\tif client == nil {","+\t\treturn nil, fmt.Errorf(\"embedded legacy AuthZ client is not configured\")","+\t}","+\tresponse, err := client.LegacyGetUserPermissions(ctx, legacypermissions.LegacyPermissionCaller(req.Namespace), req)"," \tif err != nil {"," \t\treturn nil, errors.Join(ctx.Err(), err)"," \t}","-\tpermissions = make([]ac.Permission, len(response.Permissions))","+\tpermissions := make([]ac.Permission, len(response.Permissions))"," \tfor i, p := range response.Permissions {"," \t\tpermissions[i] = ac.Permission{Action: p.Action, Scope: p.Scope}"," \t}"],"additions":19,"deletions":4,"truncated":false},{"path":"pkg/services/accesscontrol/acimpl/legacy_user_permissions_shadow.go","lines":["@@ -0,0 +1,144 @@","+package acimpl","+","+import (","+\t\"context\"","+\t\"slices\"","+\t\"time\"","+","+\t\"github.com/open-feature/go-sdk/openfeature\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/promauto\"","+\t\"go.opentelemetry.io/otel/trace\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/infra/log\"","+\tac \"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/authz/legacyclient\"","+\t\"github.com/grafana/grafana/pkg/services/authz/rbac/legacypermissions\"","+\t\"github.com/grafana/grafana/pkg/services/featuremgmt\"","+\t\"github.com/grafana/grafana/pkg/services/sqlstore\"","+\t\"github.com/grafana/grafana/pkg/setting\"","+)","+","+func LegacyUserPermissionsShadowEnabled(ctx context.Context) bool {","+\treturn openfeature.NewDefaultClient().Boolean(ctx, featuremgmt.FlagAuthzLegacyUserPermissionsShadow, false, openfeature.TransactionContext(ctx))","+}","+","+// LegacyUserPermissionsShadow compares local permissions without changing the authoritative result.","+type LegacyUserPermissionsShadow struct {","+\tinFlight chan struct{}","+\tduration *prometheus.HistogramVec","+\tresults  *prometheus.CounterVec","+\tskipped  prometheus.Counter","+\tlogger   log.Logger","+}","+","+func NewLegacyUserPermissionsShadow(reg prometheus.Registerer, maxConcurrent int) *LegacyUserPermissionsShadow {","+\tif maxConcurrent < 1 {","+\t\tmaxConcurrent = setting.DefaultLegacyUserPermissionsShadowMaxConcurrent","+\t}","+\tfactory := promauto.With(reg)","+\treturn &LegacyUserPermissionsShadow{","+\t\tinFlight: make(chan struct{}, maxConcurrent),","+\t\tlogger:   log.New(\"accesscontrol.legacy-shadow\"),","+\t\tduration: factory.NewHistogramVec(prometheus.HistogramOpts{","+\t\t\tName:    \"grafana_accesscontrol_user_permissions_duration_milliseconds\",","+\t\t\tHelp:    \"Execution time of permission loaders during shadow comparisons, in milliseconds.\",","+\t\t\tBuckets: prometheus.ExponentialBuckets(0.1, 2, 18),","+\t\t}, []string{\"implementation\"}),","+\t\tresults: factory.NewCounterVec(prometheus.CounterOpts{","+\t\t\tName: \"grafana_accesscontrol_user_permissions_shadow_comparisons_total\",","+\t\t\tHelp: \"Permission shadow comparisons. Errors include loader failures and permission differences.\",","+\t\t}, []string{\"result\"}),","+\t\tskipped: factory.NewCounter(prometheus.CounterOpts{","+\t\t\tName: \"grafana_accesscontrol_user_permissions_shadow_skipped_total\",","+\t\t\tHelp: \"Permission shadow calls skipped because of an active SQL session or the concurrency limit.\",","+\t\t}),","+\t}","+}","+","+func (s *LegacyUserPermissionsShadow) GetUserPermissions(ctx context.Context, client legacyclient.Service, usr identity.Requester, options ac.Options, cfg *setting.Cfg, primary func() ([]ac.Permission, error)) ([]ac.Permission, error) {","+\tif s == nil {","+\t\treturn primary()","+\t}","+\t// A detached read cannot compare the caller's uncommitted transaction state safely.","+\tif session, ok := ctx.Value(sqlstore.ContextSessionKey{}).(*sqlstore.DBSession); ok && session != nil {","+\t\ts.skipped.Inc()","+\t\treturn primary()","+\t}","+\tselect {","+\tcase s.inFlight <- struct{}{}:","+\tdefault:","+\t\ts.skipped.Inc()","+\t\treturn primary()","+\t}","+","+\t// Snapshot requester state before the caller can reuse or modify it.","+\treq, requestErr := legacyUserPermissionsRequest(usr, options, cfg)","+\tstart := time.Now()","+\tpermissions, err := primary()","+\ts.duration.WithLabelValues(\"current\").Observe(float64(time.Since(start)) / float64(time.Millisecond))","+\t// The caller and permission caches can retain the returned slice.","+\texpected := slices.Clone(permissions)","+\t// Copy only trace metadata. Request context values can hold caller-owned SQL sessions.","+\tbackground := trace.ContextWithSpanContext(context.Background(), trace.SpanContextFromContext(ctx))","+\tbackground = legacypermissions.WithPermissionShadow(background)","+\tgo func() {","+\t\tdefer func() {","+\t\t\t<-s.inFlight","+\t\t\tif recovered := recover(); recovered != nil {","+\t\t\t\ts.results.WithLabelValues(\"error\").Inc()","+\t\t\t\ts.logger.Warn(\"Permission shadow call panicked\", \"panic\", recovered)","+\t\t\t}","+\t\t}()","+\t\tshadowCtx, cancel := context.WithTimeout(background, 10*time.Second)","+\t\tdefer cancel()","+\t\tstart := time.Now()","+\t\tvar actual []ac.Permission","+\t\tshadowErr := requestErr","+\t\tif shadowErr == nil {","+\t\t\tactual, shadowErr = loadLegacyUserPermissions(shadowCtx, client, req)","+\t\t}","+\t\ts.duration.WithLabelValues(\"legacy\").Observe(float64(time.Since(start)) / float64(time.Millisecond))","+\t\tif err != nil || shadowErr != nil {","+\t\t\ts.results.WithLabelValues(\"error\").Inc()","+\t\t\ts.logger.FromContext(shadowCtx).Warn(\"Permission shadow comparison failed\", \"namespace\", req.Namespace, \"currentError\", err, \"shadowError\", shadowErr)","+\t\t\treturn","+\t\t}","+\t\tmissing, gained := permissionSetDifference(expected, actual)","+\t\tif len(missing) != 0 || len(gained) != 0 {","+\t\t\ts.results.WithLabelValues(\"error\").Inc()","+\t\t\ts.logger.FromContext(shadowCtx).Warn(\"Permission shadow results differ\", \"namespace\", req.Namespace, \"subject\", req.Identity.UID, \"missing\", missing, \"gained\", gained)","+\t\t\treturn","+\t\t}","+\t\ts.results.WithLabelValues(\"ok\").Inc()","+\t}()","+\treturn permissions, err","+}","+","+type permissionKey struct {","+\tAction string `json:\"action\"`","+\tScope  string `json:\"scope\"`","+}","+","+func permissionSetDifference(expected, actual []ac.Permission) (missing, gained []permissionKey) {","+\toldSet := make(map[permissionKey]struct{}, len(expected))","+\tnewSet := make(map[permissionKey]struct{}, len(actual))","+\tfor _, p := range expected {","+\t\toldSet[permissionKey{p.Action, p.Scope}] = struct{}{}","+\t}","+\tfor _, p := range actual {","+\t\tnewSet[permissionKey{p.Action, p.Scope}] = struct{}{}","+\t}","+\tfor p := range oldSet {","+\t\tif _, ok := newSet[p]; !ok {","+\t\t\tmissing = append(missing, p)","+\t\t}","+\t}","+\tfor p := range newSet {","+\t\tif _, ok := oldSet[p]; !ok {","+\t\t\tgained = append(gained, p)","+\t\t}","+\t}","+\treturn missing, gained","+}"],"additions":144,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/acimpl/legacy_user_permissions_shadow_test.go","lines":["@@ -0,0 +1,232 @@","+package acimpl","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/grafana/authlib/types\"","+\t\"github.com/open-feature/go-sdk/openfeature\"","+\t\"github.com/open-feature/go-sdk/openfeature/memprovider\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/otel/trace\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\tac \"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol/actest\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol/resourcepermissions\"","+\t\"github.com/grafana/grafana/pkg/services/authz/legacyclient\"","+\t\"github.com/grafana/grafana/pkg/services/featuremgmt\"","+\t\"github.com/grafana/grafana/pkg/services/sqlstore\"","+\t\"github.com/grafana/grafana/pkg/setting\"","+)","+","+type shadowLegacyClient struct {","+\tlegacyclient.Service","+\tget func(context.Context, legacyclient.LegacyGetUserPermissionsRequest) (legacyclient.LegacyGetUserPermissionsResponse, error)","+}","+","+func (c shadowLegacyClient) LegacyGetUserPermissions(ctx context.Context, _ types.AuthInfo, req legacyclient.LegacyGetUserPermissionsRequest) (legacyclient.LegacyGetUserPermissionsResponse, error) {","+\treturn c.get(ctx, req)","+}","+","+func shadowRequester() *identity.StaticRequester {","+\treturn &identity.StaticRequester{Type: types.TypeUser, UserID: 1, UserUID: \"user\", OrgID: 1, Namespace: types.OrgNamespaceFormatter(1), Groups: []string{\"group\"}}","+}","+","+func waitForShadow(t *testing.T, s *LegacyUserPermissionsShadow, result string) {","+\tt.Helper()","+\trequire.Eventually(t, func() bool { return testutil.ToFloat64(s.results.WithLabelValues(result)) == 1 }, time.Second, time.Millisecond)","+}","+","+func TestPermissionSetDifference(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname            string","+\t\told, new        []ac.Permission","+\t\tmissing, gained []permissionKey","+\t}{","+\t\t{name: \"empty\"},","+\t\t{name: \"order and duplicates\", old: []ac.Permission{{Action: \"read\", Scope: \"one\"}, {Action: \"write\"}, {Action: \"read\", Scope: \"one\"}}, new: []ac.Permission{{Action: \"write\"}, {Action: \"read\", Scope: \"one\"}}},","+\t\t{name: \"scope differs\", old: []ac.Permission{{Action: \"read\", Scope: \"one\"}}, new: []ac.Permission{{Action: \"read\", Scope: \"two\"}}, missing: []permissionKey{{\"read\", \"one\"}}, gained: []permissionKey{{\"read\", \"two\"}}},","+\t\t{name: \"action differs\", old: []ac.Permission{{Action: \"read\"}}, new: []ac.Permission{{Action: \"write\"}}, missing: []permissionKey{{\"read\", \"\"}}, gained: []permissionKey{{\"write\", \"\"}}},","+\t\t{name: \"wildcard is not equivalent\", old: []ac.Permission{{Action: \"read\", Scope: \"*\"}}, new: []ac.Permission{{Action: \"read\", Scope: \"one\"}}, missing: []permissionKey{{\"read\", \"*\"}}, gained: []permissionKey{{\"read\", \"one\"}}},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tmissing, gained := permissionSetDifference(tc.old, tc.new)","+\t\t\trequire.ElementsMatch(t, tc.missing, missing)","+\t\t\trequire.ElementsMatch(t, tc.gained, gained)","+\t\t})","+\t}","+}","+","+func TestPermissionShadowDoesNotBlockAndSnapshotsInput(t *testing.T) {","+\tregistry := prometheus.NewRegistry()","+\ts := NewLegacyUserPermissionsShadow(registry, 32)","+\ttype requestKey struct{}","+\tctx, cancel := context.WithCancel(context.WithValue(context.Background(), requestKey{}, \"request state\"))","+\tdefer cancel()","+\tspanContext := trace.NewSpanContext(trace.SpanContextConfig{TraceID: trace.TraceID{1}, SpanID: trace.SpanID{1}})","+\tctx = trace.ContextWithSpanContext(ctx, spanContext)","+\tusr := shadowRequester()","+\tpermissions := []ac.Permission{{Action: \"read\", Scope: \"one\"}}","+\trelease := make(chan struct{})","+\tobserved := make(chan legacyclient.LegacyGetUserPermissionsRequest, 1)","+\tclient := shadowLegacyClient{get: func(ctx context.Context, req legacyclient.LegacyGetUserPermissionsRequest) (legacyclient.LegacyGetUserPermissionsResponse, error) {","+\t\t<-release","+\t\tif ctx.Err() != nil {","+\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, ctx.Err()","+\t\t}","+\t\tif deadline, ok := ctx.Deadline(); !ok || time.Until(deadline) > 10*time.Second {","+\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, errors.New(\"shadow timeout is missing\")","+\t\t}","+\t\tif !trace.SpanContextFromContext(ctx).Equal(spanContext) {","+\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, errors.New(\"shadow lost trace metadata\")","+\t\t}","+\t\tif ctx.Value(requestKey{}) != nil {","+\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, errors.New(\"shadow inherited request state\")","+\t\t}","+\t\tobserved <- req","+\t\treturn legacyclient.LegacyGetUserPermissionsResponse{Permissions: []types.Permission{{Action: \"read\", Scope: \"one\"}}}, nil","+\t}}","+\treturned := make(chan struct{})","+\tgo func() {","+\t\t_, _ = s.GetUserPermissions(ctx, client, usr, ac.Options{ReloadCache: true}, setting.NewCfg(), func() ([]ac.Permission, error) { return permissions, nil })","+\t\tclose(returned)","+\t}()","+\tselect {","+\tcase <-returned:","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"The primary call waited for the shadow call\")","+\t}","+\tcancel()","+\tusr.Groups[0] = \"changed\"","+\tusr.UserUID = \"changed\"","+\tpermissions[0].Scope = \"changed\"","+\tclose(release)","+\twaitForShadow(t, s, \"ok\")","+\treq := <-observed","+\trequire.Equal(t, []string{\"group\"}, req.Identity.Groups)","+\trequire.Equal(t, \"user\", req.Identity.UID)","+\trequire.True(t, req.ReloadCache)","+\tfamilies, err := registry.Gather()","+\trequire.NoError(t, err)","+\tfor _, family := range families {","+\t\tif family.GetName() == \"grafana_accesscontrol_user_permissions_duration_milliseconds\" {","+\t\t\trequire.Len(t, family.Metric, 2)","+\t\t\tfor _, metric := range family.Metric {","+\t\t\t\trequire.Equal(t, uint64(1), metric.GetHistogram().GetSampleCount())","+\t\t\t\trequire.Greater(t, metric.GetHistogram().GetSampleSum(), float64(0))","+\t\t\t}","+\t\t}","+\t}","+}","+","+func TestPermissionShadowFailures(t *testing.T) {","+\tfor _, mode := range []string{\"mismatch\", \"shadow error\", \"primary error\", \"missing client\", \"panic\"} {","+\t\tt.Run(mode, func(t *testing.T) {","+\t\t\ts := NewLegacyUserPermissionsShadow(prometheus.NewRegistry(), 32)","+\t\t\tprimaryErr := error(nil)","+\t\t\tif mode == \"primary error\" {","+\t\t\t\tprimaryErr = errors.New(\"primary failed\")","+\t\t\t}","+\t\t\tvar client legacyclient.Service = shadowLegacyClient{get: func(context.Context, legacyclient.LegacyGetUserPermissionsRequest) (legacyclient.LegacyGetUserPermissionsResponse, error) {","+\t\t\t\tif mode == \"panic\" {","+\t\t\t\t\tpanic(\"shadow panic\")","+\t\t\t\t}","+\t\t\t\tif mode == \"shadow error\" {","+\t\t\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, errors.New(\"shadow failed\")","+\t\t\t\t}","+\t\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, nil","+\t\t\t}}","+\t\t\tif mode == \"missing client\" {","+\t\t\t\tclient = nil","+\t\t\t}","+\t\t\twant := []ac.Permission{{Action: \"read\"}}","+\t\t\tgot, err := s.GetUserPermissions(t.Context(), client, shadowRequester(), ac.Options{}, setting.NewCfg(), func() ([]ac.Permission, error) { return want, primaryErr })","+\t\t\trequire.Equal(t, want, got)","+\t\t\trequire.ErrorIs(t, err, primaryErr)","+\t\t\twaitForShadow(t, s, \"error\")","+\t\t})","+\t}","+}","+","+func TestPermissionShadowRouting(t *testing.T) {","+\tfor _, shadow := range []bool{false, true} {","+\t\tfor _, replacement := range []bool{false, true} {","+\t\t\tt.Run(fmt.Sprintf(\"shadow=%t/replacement=%t\", shadow, replacement), func(t *testing.T) {","+\t\t\t\trequire.NoError(t, openfeature.SetProviderAndWait(memprovider.NewInMemoryProvider(map[string]memprovider.InMemoryFlag{","+\t\t\t\t\tfeaturemgmt.FlagAuthzLegacyUserPermissions:       {State: memprovider.Enabled, Variants: map[string]any{\"value\": replacement}, DefaultVariant: \"value\"},","+\t\t\t\t\tfeaturemgmt.FlagAuthzLegacyUserPermissionsShadow: {State: memprovider.Enabled, Variants: map[string]any{\"value\": shadow}, DefaultVariant: \"value\"},","+\t\t\t\t})))","+\t\t\t\tt.Cleanup(func() { require.NoError(t, openfeature.SetProviderAndWait(openfeature.NoopProvider{})) })","+\t\t\t\ts := &Service{","+\t\t\t\t\tcfg: setting.NewCfg(), features: featuremgmt.WithFeatures(),","+\t\t\t\t\tstore:          actest.FakeStore{},","+\t\t\t\t\tactionResolver: resourcepermissions.NewActionSetService(),","+\t\t\t\t\tlegacyShadow:   NewLegacyUserPermissionsShadow(nil, 32),","+\t\t\t\t\tlegacyClient: shadowLegacyClient{get: func(context.Context, legacyclient.LegacyGetUserPermissionsRequest) (legacyclient.LegacyGetUserPermissionsResponse, error) {","+\t\t\t\t\t\treturn legacyclient.LegacyGetUserPermissionsResponse{}, nil","+\t\t\t\t\t}},","+\t\t\t\t}","+\t\t\t\tgot, err := s.GetUserPermissions(t.Context(), shadowRequester(), ac.Options{})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tif shadow || !replacement {","+\t\t\t\t\trequire.Equal(t, []ac.Permission{SharedWithMeFolderPermission}, got)","+\t\t\t\t} else {","+\t\t\t\t\trequire.Empty(t, got)","+\t\t\t\t}","+\t\t\t\tif shadow && replacement {","+\t\t\t\t\twaitForShadow(t, s.legacyShadow, \"error\")","+\t\t\t\t} else {","+\t\t\t\t\trequire.Zero(t, testutil.CollectAndCount(s.legacyShad