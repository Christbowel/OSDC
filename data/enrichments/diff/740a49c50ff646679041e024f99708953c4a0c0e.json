{"id":"740a49c50ff646679041e024f99708953c4a0c0e","axis":"silent","repo":"pnpm/pnpm","sha":"740a49c50ff646679041e024f99708953c4a0c0e","parsed":{"files":[{"path":".changeset/repeat-install-records-gvs-dir.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+A repeat `pnpm install` now links the packages from the new directory after `globalVirtualStoreDir` changes. Before, it reported \"Already up to date\"."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/repeat-install-records-more-settings.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/deps.status\": patch","+\"@pnpm/workspace.state\": patch","+\"@pnpm/exec.commands\": patch","+\"pacquet\": patch","+\"pnpm\": patch","+---","+","+A repeat `pnpm install` now renames the virtual store directories after `virtualStoreDirMaxLength` changes. It now runs the builds it skipped before after `dangerouslyAllowAllBuilds` is turned on. It now verifies the lockfile after `trustLockfile` is turned off. Before, it reported \"Already up to date\" in each of these cases."],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install.rs","lines":["@@ -1286,3 +1286,129 @@ fn repeat_hoisted_install_reports_nothing_broken() {"," ","     drop((root, mock_instance));"," }","+","+/// Install `dependencies`, change one setting in `pnpm-workspace.yaml`, and","+/// install again. The second install must act on the change instead of","+/// reporting the tree up to date","+/// ([pnpm/tasks#219](https://github.com/pnpm/tasks/issues/219)).","+fn install_then_change_setting(","+    dependencies: &serde_json::Value,","+    before: impl FnOnce(&Path),","+    change: impl FnOnce(&Path),","+) -> (CommandTempCwd<AddMockedRegistry>, String) {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": dependencies }).to_string(),","+    )","+    .expect(\"write package.json\");","+    before(&workspace);","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    change(&workspace);","+    let output = pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .output()","+        .expect(\"run the repeat install\");","+    let stdout = String::from_utf8_lossy(&output.stdout).into_owned();","+    assert!(output.status.success(), \"{stdout}\");","+    (harness, stdout)","+}","+","+#[test]","+fn repeat_install_renames_slots_after_a_virtual_store_dir_max_length_change() {","+    let (harness, _) = install_then_change_setting(","+        &serde_json::json!({ \"is-positive\": \"1.0.0\" }),","+        |_| {},","+        |workspace| append_workspace_yaml_key(workspace, \"virtualStoreDirMaxLength\", 10),","+    );","+    let workspace = &harness.workspace;","+    assert_eq!(version_of(workspace, \"node_modules/is-positive\"), \"1.0.0\");","+    let target = workspace","+        .join(\"node_modules/is-positive\")","+        .canonicalize()","+        .expect(\"resolve the direct dependency\");","+    let slot = target","+        .ancestors()","+        .nth(2)","+        .and_then(Path::file_name)","+        .expect(\"the dependency sits in a virtual store slot\")","+        .to_string_lossy()","+        .into_owned();","+    assert_ne!(slot, \"is-positive@1.0.0\", \"the slot must be renamed to fit the new length\");","+    drop(harness);","+}","+","+#[test]","+fn repeat_install_runs_ignored_builds_after_dangerously_allow_all_builds_is_turned_on() {","+    const MARKER: &str = \"node_modules/.pnpm/@pnpm.e2e+pre-and-postinstall-scripts-example@1.0.0\\","+         /node_modules/@pnpm.e2e/pre-and-postinstall-scripts-example/generated-by-postinstall.js\";","+    let (harness, _) = install_then_change_setting(","+        &serde_json::json!({ \"@pnpm.e2e/pre-and-postinstall-scripts-example\": \"1.0.0\" }),","+        |workspace| append_workspace_yaml_key(workspace, \"strictDepBuilds\", false),","+        |workspace| {","+            assert!(!workspace.join(MARKER).exists(), \"the first install must ignore the build\");","+            append_workspace_yaml_key(workspace, \"dangerouslyAllowAllBuilds\", true);","+        },","+    );","+    assert!(harness.workspace.join(MARKER).exists(), \"the newly allowed build must run\");","+    drop(harness);","+}","+","+#[test]","+fn repeat_install_relinks_after_a_global_virtual_store_dir_change() {","+    let (harness, _) = install_then_change_setting(","+        &serde_json::json!({ \"is-positive\": \"1.0.0\" }),","+        |workspace| enable_gvs_in_workspace_yaml(workspace, \"\"),","+        |workspace| append_workspace_yaml_key(workspace, \"globalVirtualStoreDir\", \"../moved-links\"),","+    );","+    let target = harness.workspace","+        .join(\"node_modules/is-positive\")","+        .canonicalize()","+        .expect(\"resolve the direct dependency\");","+    let moved = harness.workspace","+        .join(\"../moved-links\")","+        .canonicalize()","+        .expect(\"the new global virtual store exists\");","+    assert!(target.starts_with(&moved), \"{target:?} must be linked from {moved:?}\");","+    drop(harness);","+}","+","+#[test]","+fn repeat_install_verifies_the_lockfile_after_trust_lockfile_is_turned_off() {","+    let harness = CommandTempCwd::init().add_mocked_registry();","+    let workspace = harness.workspace.clone();","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { \"is-positive\": \"1.0.0\" } }).to_string(),","+    )","+    .expect(\"write package.json\");","+    append_workspace_yaml_key(&workspace, \"trustLockfile\", true);","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&yaml_path).expect(\"read pnpm-workspace.yaml\");","+    fs::write(&yaml_path, yaml.replace(\"trustLockfile: true\", \"trustLockfile: false\"))","+        .expect(\"turn trustLockfile off\");","+    let output = pacquet_in(&workspace)","+        .with_args([\"install\", \"--reporter=ndjson\"])","+        .output()","+        .expect(\"run the repeat install\");","+    let logs = format!(","+        \"{}{}\",","+        String::from_utf8_lossy(&output.stdout),","+        String::from_utf8_lossy(&output.stderr),","+    );","+    assert!(output.status.success(), \"{logs}\");","+    assert!(","+        logs.contains(r#\"\"name\":\"pnpm:lockfile-verification\"\"#),","+        \"the lockfile no install verified must be verified: {logs}\",","+    );","+    drop(harness);","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/deps_status.rs","lines":["@@ -10,6 +10,22 @@ use super::{","     wanted_lockfile_file_has_content,"," };"," ","+/// The workspace-state settings the run check does not compare. Scripts always","+/// run with the default dependency groups. A script runs the same from","+/// whichever store and virtual store `node_modules` was linked from, and","+/// whatever keys the lockfile records. Only an install has to act on a store","+/// location change or re-key the lockfile.","+const RUN_IGNORED_SETTINGS: &[&str] = &[","+    \"dev\",","+    \"optional\",","+    \"production\",","+    \"registryPrefixes\",","+    \"storeDir\",","+    \"virtualStoreDir\",","+    \"virtualStoreDirMaxLength\",","+    \"globalVirtualStoreDir\",","+];","+"," /// Outcome of [`check_deps_status_before_run`]."," #[derive(Debug, Clone, PartialEq, Eq)]"," pub enum RunDepsStatus {","@@ -67,11 +83,7 @@ pub fn check_deps_status_before_run(","     } else {","         Scope::Selected(selected_project_dirs)","     };","-    // A script runs the same from whichever store `node_modules` was linked","-    // from, and whatever keys the lockfile records; only an install has to","-    // act on a store location change or re-key the lockfile.","-    let mut ignored_settings =","-        vec![\"dev\", \"optional\", \"production\", \"registryPrefixes\", \"storeDir\", \"virtualStoreDir\"];","+    let mut ignored_settings = RUN_IGNORED_SETTINGS.to_vec();","     if install_would_run_frozen(check) {","         ignored_settings.push(\"autoDedupe\");","     }"],"additions":17,"deletions":5,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settings.rs","lines":["@@ -7,12 +7,14 @@ pub(crate) use registry_prefixes::{"," "," mod agent_skills;"," mod equivalence;","+mod install_policy;"," mod registry_prefixes;"," mod store_location;"," use agent_skills::agent_skills_settings;"," use equivalence::{","     allow_builds_match, enable_global_virtual_store_match, package_extensions_match,"," };","+use install_policy::install_policy_settings;"," "," use super::{","     Catalogs, Config, IncludedDependencies, LinkWorkspacePackages, NodeLinker,","@@ -109,6 +111,7 @@ impl SettingsComparison<'_> {","             .or_else(|| self.workspace_policy_drift())","             .or_else(|| self.agent_skills_drift())","             .or_else(|| self.store_location_drift())","+            .or_else(|| self.install_policy_drift())","     }","     fn installation_drift(&self) -> Option<&'static str> {","         let recorded = self.recorded;","@@ -394,7 +397,10 @@ fn current_policy_settings(config: &Config) -> WorkspaceStateSettings {","         trust_policy_exclude: config.trust_policy_exclude.clone(),","         trust_policy_ignore_after: config.trust_policy_ignore_after,","         workspace_package_patterns: config.workspace_package_patterns.clone(),","-        ..store_location::store_location_settings(config, agent_skills_settings(config))","+        ..store_location::store_location_settings(","+            config,","+            install_policy_settings(config, agent_skills_settings(config)),","+        )","     }"," }"," "],"additions":7,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settings/install_policy.rs","lines":["@@ -0,0 +1,34 @@","+use super::{Config, SettingsComparison, WorkspaceStateSettings};","+","+/// The settings that decide which builds and lockfile verification an install","+/// runs. An unrecorded value reads as the default.","+/// `dangerouslyAllowAllBuilds` is always recorded, as pnpm v11 records it.","+pub(super) fn install_policy_settings(","+    config: &Config,","+    rest: WorkspaceStateSettings,","+) -> WorkspaceStateSettings {","+    WorkspaceStateSettings {","+        dangerously_allow_all_builds: Some(config.dangerously_allow_all_builds),","+        trust_lockfile: config.trust_lockfile.then_some(true),","+        ..rest","+    }","+}","+","+impl SettingsComparison<'_> {","+    pub(super) fn install_policy_drift(&self) -> Option<&'static str> {","+        let (recorded, live) = (self.recorded, self.live);","+        let differs = |recorded: Option<bool>, live: Option<bool>| {","+            recorded.unwrap_or(false) != live.unwrap_or(false)","+        };","+        [","+            (","+                \"dangerouslyAllowAllBuilds\",","+                differs(recorded.dangerously_allow_all_builds, live.dangerously_allow_all_builds),","+            ),","+            (\"trustLockfile\", differs(recorded.trust_lockfile, live.trust_lockfile)),","+        ]","+        .into_iter()","+        .find(|(key, differs)| *differs && !self.ignored.contains(key))","+        .map(|(key, _)| key)","+    }","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settings/store_location.rs","lines":["@@ -1,10 +1,12 @@"," use super::{Config, SettingsComparison, WorkspaceStateSettings};","+use pnpm_config::default_virtual_store_dir_max_length;"," use std::path::Path;"," ","-/// The configured `storeDir` and `virtualStoreDir` as the directories they","-/// resolve to, the form pnpm v11 records, so a relative and an absolute","-/// spelling of one directory compare equal. A setting that is not configured","-/// stays unset.","+/// The configured `storeDir`, `virtualStoreDir` and `globalVirtualStoreDir`","+/// as the directories they resolve to, the form pnpm v11 records, so a","+/// relative and an absolute spelling of one directory compare equal. A setting","+/// that is not configured stays unset. Also `virtualStoreDirMaxLength`, which","+/// names the virtual store's slots."," pub(super) fn store_location_settings(","     config: &Config,","     rest: WorkspaceStateSettings,","@@ -18,6 +20,9 @@ pub(super) fn store_location_settings(","     let recorded = |dir: &Path| pnpm_fs::lexical_normalize(dir).to_string_lossy().into_owned();","     WorkspaceStateSettings {","         store_dir: configured(\"storeDir\").map(|_| recorded(config.store_dir.root())),","+        global_virtual_store_dir: configured(\"globalVirtualStoreDir\")","+            .map(|_| recorded(&config.global_virtual_store_dir)),","+        virtual_store_dir_max_length: Some(config.virtual_store_dir_max_length),","         // Anchored like a configured `virtualStoreDir` without a global","         // virtual store: under one, `Config::virtual_store_dir` names the","         // global virtual store, which pnpm v11 does not record here.","@@ -36,6 +41,18 @@ impl SettingsComparison<'_> {","         let (recorded, live) = (self.recorded, self.live);","         [","             (\"storeDir\", recorded.store_dir != live.store_dir),","+            (","+                \"globalVirtualStoreDir\",","+                recorded.global_virtual_store_dir != live.global_virtual_store_dir,","+            ),","+            (","+                \"virtualStoreDirMaxLength\",","+                recorded.virtual_store_dir_max_length.unwrap_or_else(","+                    default_virtual_store_dir_max_length,","+                ) != live.virtual_store_dir_max_length.unwrap_or_else(","+                    default_virtual_store_dir_max_length,","+                ),","+            ),","             (\"virtualStoreDir\", recorded.virtual_store_dir != live.virtual_store_dir),","         ]","         .into_iter()"],"additions":21,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/settings_classification.rs","lines":["@@ -91,7 +91,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"config_dependencies\", Through(\"compared by the config-dependencies check\")),","     (\"config_dir\", NotAnInput(\"where the global config is read from\")),","     (\"configured_virtual_store_dir\", Through(\"the configured `virtualStoreDir`, recorded as `virtualStoreDir`\")),","-    (\"dangerously_allow_all_builds\", Unseen(\"turned on, the full install runs the builds it ignored before\")),","+    (\"dangerously_allow_all_builds\", Recorded { key: \"dangerouslyAllowAllBuilds\", change: |config| config.dangerously_allow_all_builds = !config.dangerously_allow_all_builds }),","     (\"dedupe_direct_deps\", Recorded { key: \"dedupeDirectDeps\", change: |config| config.dedupe_direct_deps = !config.dedupe_direct_deps }),","     (\"dedupe_injected_deps\", Recorded { key: \"dedupeInjectedDeps\", change: |config| config.dedupe_injected_deps = !config.dedupe_injected_deps }),","     (\"dedupe_peer_dependents\", Recorded { key: \"dedupePeerDependents\", change: |config| config.dedupe_peer_dependents = !config.dedupe_peer_dependents }),","@@ -136,7 +136,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"global_pnpmfile\", Through(\"the pnpmfile list, compared as `pnpmfiles`\")),","     (\"global_shims\", NotAnInput(\"the global packages, which a project install does not touch\")),","     (\"global_virtual_store_before_loaded\", Through(\"restores `enableGlobalVirtualStore`, which is recorded\")),","-    (\"global_virtual_store_dir\", Unseen(\"a full install relinks the global virtual store to the new directory\")),","+    (\"global_virtual_store_dir\", Recorded { key: \"globalVirtualStoreDir\", change: |config| { config.explicit_settings.insert(\"globalVirtualStoreDir\".into(), \"/links\".into()); config.global_virtual_store_dir = \"/links\".into(); } }),","     (\"hoist\", Through(DERIVED)),","     (\"hoist_pattern\", Recorded { key: \"hoistPattern\", change: |config| config.hoist_pattern = Some(vec![\"foo\".into()]) }),","     (\"hoist_patterns_before_virtual_store_only\", Through(DERIVED)),","@@ -261,7 +261,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"side_effects_cache_write_setting\", NotAnInput(STORE_INTERNALS)),","     (\"skills_dirs\", Recorded { key: \"skills.dirs\", change: |config| config.skills_dirs = Some(vec![\"foo\".into()]) }),","     (\"skip_manifest_obfuscation\", NotAnInput(OTHER_COMMAND)),","-    (\"skip_runtimes\", Unseen(\"turned off, a full install links the runtimes it skipped\")),","+    (\"skip_runtimes\", Unseen(\"turned off, a full install links the runtimes it skipped, while `fresh_install_with_no_runtime_resolves_but_does_not_fetch_the_runtime` pins the fast path keeping them absent\")),","     (\"skip_store_dir_resolution\", NotAnInput(\"how the config loader places the store\")),","     (\"sort\", NotAnInput(CLI_ONLY)),","     (\"source_date_epoch\", NotAnInput(OTHER_COMMAND)),","@@ -286,7 +286,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"tls\", NotAnInput(NETWORK)),","     (\"tls_by_uri\", NotAnInput(NETWORK)),","     (\"tools\", NotAnInput(\"tools are installed by their own step\")),","-    (\"trust_lockfile\", Unseen(\"turned off, a full install verifies a lockfile no install verified\")),","+    (\"trust_lockfile\", Recorded { key: \"trustLockfile\", change: |config| config.trust_lockfile = !config.trust_lockfile }),","     (\"trust_policy\", Recorded { key: \"trustPolicy\", change: |config| { config.explicit_settings.insert(\"trustPolicy\".into(), \"off\".into()); config.trust_policy = TrustPolicy::Off; } }),","     (\"trust_policy_exclude\", Recorded { key: \"trustPolicyExclude\", change: |config| config.trust_policy_exclude = Some(vec![\"foo\".into()]) }),","     (\"trust_policy_exclude_prune\", NotAnInput(\"prunes exclude entries from the workspace manifest\")),","@@ -301,7 +301,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"verify_deps_before_run\", NotAnInput(\"what `pnpm run` does with a stale tree\")),","     (\"verify_store_integrity\", NotAnInput(STORE_INTERNALS)),","     (\"versioning\", NotAnInput(OTHER_COMMAND)),","-    (\"virtual_store_dir_max_length\", Unseen(\"a full install renames the virtual store slots\")),","+    (\"virtual_store_dir_max_length\", Recorded { key: \"virtualStoreDirMaxLength\", change: |config| config.virtual_store_dir_max_length += 1 }),","     (\"virtual_store_only\", NotAnInput(\"only `pnpm fetch` sets it, which does not take the fast path\")),","     (\"workspace_concurrency\", NotAnInput(SCRIPTS)),","     (\"workspace_dir\", Through(\"the workspace root the checks run in\")),"],"additions":5,"deletions":5,"truncated":false},{"path":"pnpm/crates/workspace-state/src/lib.rs","lines":["@@ -201,6 +201,11 @@ pub struct WorkspaceStateSettings {","     pub auto_install_peers: Option<bool>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub catalogs: Option<serde_json::Value>,","+    /// `dangerouslyAllowAllBuilds`. An unset value reads as `false`. Turned","+    /// on, it allows builds the last install ignored, so the next install has","+    /// to run them.","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub dangerously_allow_all_builds: Option<bool>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub dedupe_direct_deps: Option<bool>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","@@ -222,6 +227,11 @@ pub struct WorkspaceStateSettings {","     pub enable_global_virtual_store: Option<bool>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub exclude_links_from_lockfile: Option<bool>,","+    /// The directory a configured `globalVirtualStoreDir` resolves to,","+    /// recorded only when set, for the reason given on [`Self::store_dir`].","+    /// pnpm v11 has no such setting.","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub global_virtual_store_dir: Option<String>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub hoist_pattern: Option<Vec<String>>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","@@ -318,6 +328,10 @@ pub struct WorkspaceStateSettings {","     /// are re-evaluated.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub supported_architectures: Option<serde_json::Value>,","+    /// `trustLockfile`, recorded only while it is on. Turned off, the lockfile","+    /// that no install verified has to be verified.","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub trust_lockfile: Option<bool>,","     /// The lockfile-verification cache is keyed by the trust-policy","     /// settings, like the `minimumReleaseAge*` family: a policy turned","     /// on or an exclude list shrunk must make the workspace state look","@@ -337,6 +351,10 @@ pub struct WorkspaceStateSettings {","     /// only when set, for the reason given on [`Self::store_dir`].","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub virtual_store_dir: Option<String>,","+    /// `virtualStoreDirMaxLength`. An unset value reads as the default. The","+    /// virtual store's slot names are cut to it.","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub virtual_store_dir_max_length: Option<u64>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub workspace_package_patterns: Option<Vec<String>>,"," }"],"additions":18,"deletions":0,"truncated":false},{"path":"pnpm11/dep