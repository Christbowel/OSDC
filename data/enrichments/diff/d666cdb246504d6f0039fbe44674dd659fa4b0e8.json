rce notes were packaged\")","+\t}","+\tfor _, name := range []string{\"config.json\", \"decision_head.json\", \"calibration.json\", \"preprocessor_config.json\", \"video_preprocessor_config.json\", \"hf_quant_config.json\"} {","+\t\tif _, ok := store.blobs[name]; !ok {","+\t\t\tt.Errorf(\"required AutoTrust decision metadata %s was omitted\", name)","+\t\t}","+\t}","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"create/create.go","lines":["@@ -429,6 +429,7 @@ type tensorImportTransformFactory func(rawConfig json.RawMessage) (quantizePolic"," var tensorImportTransformRegistry = map[string]tensorImportTransformFactory{"," \t\"Qwen3_5Model\":                          newPplxImportTransform,"," \t\"KevForDecision\":                        newQwen35DecisionImportTransform,","+\t\"AutoTrustDecision\":                     newQwen35DecisionImportTransform,"," \t\"StrandsDeciderForDecision\":             newQwen35DecisionImportTransform,"," \t\"ClefForDecision\":                       newQwen35DecisionImportTransform,"," \t\"Qwen3_5ForCausalLM\":                    newQwen35ImportTransform,"],"additions":1,"deletions":0,"truncated":false},{"path":"create/inventory.go","lines":["@@ -236,22 +236,21 @@ func SafetensorsConfigFiles(dir string) ([]string, error) {"," \tif err != nil {"," \t\treturn nil, err"," \t}","-\tif !hasSidecar {","+\thasAutoTrustDecisionSidecar := slices.Contains(names, \"decision_head.json\")","+\tif !hasSidecar && !hasAutoTrustDecisionSidecar {"," \t\treturn names, nil"," \t}"," \tcfg, _, err := readSourceModelConfig(dir)"," \tif err != nil {"," \t\treturn nil, err"," \t}","-\tif cfg.Architecture() != \"Qwen3_5Model\" {","+\tautoTrustDecisionSource := cfg.Architecture() == \"AutoTrustDecision\"","+\tqwenDecisionSource := hasSidecar && cfg.Architecture() == \"Qwen3_5Model\"","+\tif !autoTrustDecisionSource && !qwenDecisionSource {"," \t\treturn names, nil"," \t}","-\tformat, err := qwenDecisionFormat(dir)","-\tif err != nil {","-\t\treturn n