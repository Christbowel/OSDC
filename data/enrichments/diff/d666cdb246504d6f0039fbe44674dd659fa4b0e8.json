 < minimum || count > 255 {","+\t\t\t\t\tif err == nil {","+\t\t\t\t\t\tt.Fatalf(\"accepted %d options\", count)","+\t\t\t\t\t}","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tif err != nil {","+\t\t\t\t\tt.Fatalf(\"rejected %d options: %v\", count, err)","+\t\t\t\t}","+\t\t\t\tif got := len(compiled.Request.Rows[0].Question.Options); got != count {","+\t\t\t\t\tt.Fatalf(\"compiled %d of %d options\", got, count)","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestIndependentQwenScoreLevels(t *testing.T) {","+\tfor _, encoding := range []string{\"d3\", \"autotrust-decision\"} {","+\t\tfor _, count := range []int{1, 2, 5, 6, 7, 10, 11} {","+\t\t\tt.Run(fmt.Sprintf(\"%s/%d\", encoding, count), func(t *testing.T) {","+\t\t\t\tlevels := make([]string, count)","+\t\t\t\tfor i := range levels {","+\t\t\t\t\tlevels[i] = fmt.Sprintf(\"%q\", fmt.Sprintf(\"level-%d\", i))","+\t\t\t\t}","+\t\t\t\tinput := fmt.Sprintf(`{\"model\":\"test\",\"state\":\"x\",\"questions\":{\"rating\":{\"type\":\"score\",\"criteria\":[%s]}}}`, strings.Join(levels, \",\"))","+\t\t\t\tvar req Request","+\t\t\t\tif err := json.Unmarshal([]byte(input), &req); err != nil {","+\t\t\t\t\tt.Fatal(err)","+\t\t\t\t}","+\t\t\t\t_, err := Compile(req, encoding)","+\t\t\t\tvalid := count >= 2 && count <= 10","+\t\t\t\tif encoding == \"autotrust-decision\" {","+\t\t\t\t\tvalid = count == 6","+\t\t\t\t}","+\t\t\t\tif (err == nil) != valid {","+\t\t\t\t\tt.Fatalf(\"score levels %d: unexpected error %v\", count, err)","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}"],"additions":69,"deletions":0,"truncated":false},{"path":"decision/d3.go","lines":["@@ -12,6 +12,20 @@ import ("," // encodeD3 retains the publisher's question and option order. The Qwen"," // backbone scores a complete prompt independently for each question."," func encodeD3(req Request, c *Compiled) error {","+\treturn encodeIndependentQwen(req, c, qwenDecisionLimits{minChoices: 1, minScore: 2, maxScore: 10})","+}","+","+func encodeAutoTrustDecision(req Request, c *Compiled) error {","+\treturn encodeIndependentQwen(req, c, qwenDecisionLimits{minChoices: 2, minScore: 6, maxScore: 6})","+}","+","+type qwenDecisionLimits struct {","+\tminChoices int","+\tminScore   int","+\tmaxScore   int","+}","+","+func encodeIndependentQwen(req Request, c *Compiled, limits qwenDecisionLimits) error {"," \tif n := req.Questions.Len(); n < 1 || n > 64 {"," \t\treturn fmt.Errorf(\"questions must contain 1–64 fields\")"," \t}","@@ -39,8 +53,11 @@ func encodeD3(req Request, c *Compiled) error {"," \t\t\treturn fmt.Errorf(\"question %q: %w\", name, err)"," \t\t}"," \t\tif question.Type == \"score\" {","-\t\t\tif len(field.Choices) > 10 {","-\t\t\t\treturn fmt.Errorf(\"question %q: score criteria must contain 2–10 levels\", name)","+\t\t\tif len(field.Choices) < limits.minScore || len(field.Choices) > limits.maxScore {","+\t\t\t\tif limits.minScore == limits.maxScore {","+\t\t\t\t\treturn fmt.Errorf(\"question %q: score criteria must contain exactly %d levels\", name, limits.minScore)","+\t\t\t\t}","+\t\t\t\treturn fmt.Errorf(\"question %q: score criteria must contain %d–%d levels\", name, limits.minScore, limits.maxScore)"," \t\t\t}"," \t\t\tseen := make(map[string]bool, len(descriptions))"," \t\t\tfor _, description := range descriptions {","@@ -62,6 +79,9 @@ func encodeD3(req Request, c *Compiled) error {"," \t\t\t\t}"," \t\t\t}"," \t\t}","+\t\tif question.Type == \"choice\" && len(field.Choices) < limits.minChoices {","+\t\t\treturn fmt.Errorf(\"question %q: choice criteria must contain at least %d options\", name, limits.minChoices)","+\t\t}"," \t\tc.fields = append(c.fields, field)"," \t\tc.Request.Rows = append(c.Request.Rows, llm.ScoreRow{Question: &llm.ScoreQuestion{"," \t\t\tType: question.Type, Instructions: field.Description, Options: descriptions,"],"additions":22,"deletions":2,"truncated":false},{"path":"decision/systemone.go","lines":["@@ -66,7 +66,7 @@ func validateImages(images []api.ImageData) error {"," "," func Compile(req Request, encoding string) (*Compiled, error) {"," \tswitch encoding {","-\tcase \"\", \"tev1\", \"clef\", \"strands\", \"kev\", \"pplx\", \"d3\", \"d1\":","+\tcase \"\", \"tev1\", \"clef\", \"strands\", \"kev\", \"pplx\", \"d3\", \"autotrust-decision\", \"d1\":"," \tdefault:"," \t\treturn nil, fmt.Errorf(\"unsupported decision encoding %q\", encoding)"," \t}","@@ -110,6 +110,13 @@ func Compile(req Request, encoding string) (*Compiled, error) {"," \t\t}"," \t\treturn c, nil"," \t}","+\tif encoding == \"autotrust-decision\" {","+\t\tc := &Compiled{encoding: encoding}","+\t\tif err := encodeAutoTrustDecision(req, c); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\treturn c, nil","+\t}"," \tif err := ValidateLimits(req, encoding); err != nil {"," \t\treturn nil, err"," \t}"],"additions":8,"deletions":1,"truncated":false},{"path":"mlxrunner/model/architectures/architectures.go","lines":["@@ -1,6 +1,7 @@"," package architectures"," "," import (","+\t_ \"github.com/ollama/ollama/mlxrunner/model/autotrustdecision\""," \t_ \"github.com/ollama/ollama/mlxrunner/model/clef\""," \t_ \"github.com/ollama/ollama/mlxrunner/model/cohere2_moe\""," \t_ \"github.com/ollama/ollama/mlxrunner/model/d1\""],"additions":1,"deletions":0,"truncated":false},{"path":"mlxrunner/model/autotrustdecision/config.go","lines":["@@ -0,0 +1,30 @@","+package autotrustdecision","+","+import (","+\t\"encoding/json\"","+\t\"fmt\"","+)","+","+type config struct {","+\tModelType  string `json:\"model_type\"`","+\tMaxChoices int    `json:\"max_choices\"`","+}","+","+func parseConfig(data []byte, head decisionHead) (config, error) {","+\tvar cfg config","+\tif err := json.Unmarshal(data, &cfg); err != nil {","+\t\treturn config{}, fmt.Errorf(\"parse AutoTrust decision config: %w\", err)","+\t}","+\tif cfg.MaxChoices == 0 {","+\t\tchoiceRange := head.Slots.Ranges[\"choice\"]","+\t\tcfg.MaxChoices = choiceRange[1] - choiceRange[0]","+\t\t// The 27B-VL checkpoint supports wide labels despite its compact head.","+\t\tif cfg.ModelType == \"qwen3_5\" {","+\t\t\tcfg.MaxChoices = 256","+\t\t}","+\t}","+\tif cfg.MaxChoices < 2 || cfg.MaxChoices > 256 {","+\t\treturn config{}, fmt.Errorf(\"invalid AutoTrust decision max_choices %d: must be between 2 and 256\", cfg.MaxChoices)","+\t}","+\treturn cfg, nil","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"mlxrunner/model/autotrustdecision/config_test.go","lines":["@@ -0,0 +1,142 @@","+package autotrustdecision","+","+import (","+\t\"encoding/json\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/ollama/ollama/llm\"","+\t\"github.com/ollama/ollama/manifest\"","+\t\"github.com/ollama/ollama/mlxrunner/model\"","+)","+","+func TestParseConfigChoiceDefaults(t *testing.T) {","+\tfor _, tt := range []struct {","+\t\tname       string","+\t\tdata       string","+\t\ttrained    int","+\t\tmaxChoices int","+\t}{","+\t\t{name: \"compact text\", data: `{\"model_type\":\"qwen3_5_text\"}`, trained: 16, maxChoices: 16},","+\t\t{name: \"wide MoE\", data: `{\"model_type\":\"qwen3_5_moe\"}`, trained: 256, maxChoices: 256},","+\t\t{name: \"compact VL\", data: `{\"model_type\":\"qwen3_5\"}`, trained: 16, maxChoices: 256},","+\t\t{name: \"zero uses default\", data: `{\"max_choices\":0}`, trained: 16, maxChoices: 16},","+\t\t{name: \"zero uses VL default\", data: `{\"model_type\":\"qwen3_5\",\"max_choices\":0}`, trained: 16, maxChoices: 256},","+\t\t{name: \"explicit wide inference\", data: `{\"max_choices\":256}`, trained: 16, maxChoices: 256},","+\t\t{name: \"explicit lower VL limit\", data: `{\"model_type\":\"qwen3_5\",\"max_choices\":8}`, trained: 16, maxChoices: 8},","+\t\t{name: \"nested backbone config\", data: `{\"model_type\":\"qwen3_5\",\"text_config\":{\"hidden_size\":5120}}`, trained: 16, maxChoices: 256},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tvar head decisionHead","+\t\t\thead.Slots.Ranges = map[string][2]int{\"choice\": {8, 8 + tt.trained}}","+\t\t\tcfg, err := parseConfig([]byte(tt.data), head)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t\tif cfg.MaxChoices != tt.maxChoices {","+\t\t\t\tt.Fatalf(\"max_choices = %d, want %d\", cfg.MaxChoices, tt.maxChoices)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestLoadModelChoiceLimits(t *testing.T) {","+\tfor _, tt := range []struct {","+\t\tname       string","+\t\tmodelType  string","+\t\ttrained    int","+\t\toverride   int","+\t\tmaxChoices int","+\t}{","+\t\t{name: \"compact text default\", modelType: \"qwen3_5_text\", trained: 16, maxChoices: 16},","+\t\t{name: \"wide MoE default\", modelType: \"qwen3_5_moe_text\", trained: 256, maxChoices: 255},","+\t\t{name: \"compact VL default\", modelType: \"qwen3_5\", trained: 16, maxChoices: 255},","+\t\t{name: \"explicit wide inference\", modelType: \"qwen3_5_text\", trained: 16, override: 256, maxChoices: 255},","+\t\t{name: \"explicit lower VL limit\", modelType: \"qwen3_5\", trained: 16, override: 8, maxChoices: 8},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tt.Setenv(\"OLLAMA_MODELS\", t.TempDir())","+\t\t\tvar head decisionHead","+\t\t\thead.Bias = make([]float32, 8+tt.trained)","+\t\t\thead.VerbalizerIDs = make([]int32, len(head.Bias))","+\t\t\thead.Slots.Verbalizers = make([]string, len(head.Bias))","+\t\t\thead.Slots.Ranges = map[string][2]int{\"noul\": {0, 2}, \"score\": {2, 8}, \"choice\": {8, len(head.Bias)}}","+\t\t\thead.Slots.Template = \"bare-v1\"","+\t\t\tif tt.trained == 256 {","+\t\t\t\thead.Slots.Template = \"bare-v1-wide256\"","+\t\t\t}","+\t\t\tfor i := range head.VerbalizerIDs {","+\t\t\t\thead.VerbalizerIDs[i] = int32(i)","+\t\t\t}","+","+\t\t\tvar added []map[string]any","+\t\t\tfor i := range 256 {","+\t\t\t\tlabel := string(rune('A' + i))","+\t\t\t\tif i >= 26 {","+\t\t\t\t\tlabel = string([]rune{rune('A' + (i-26)/26), rune('A' + (i-26)%26)})","+\t\t\t\t}","+\t\t\t\tadded = append(added, map[string]any{\"id\": i + 8, \"content\": label})","+\t\t\t}","+\t\t\ttokenizer := map[string]any{\"model\": map[string]any{\"type\": \"BPE\", \"vocab\": map[string]int{\"x\": 0}, \"merges\": []string{}}, \"added_tokens\": added}","+\t\t\tbackbone := map[string]any{","+\t\t\t\t\"model_type\": tt.modelType, \"hidden_size\": 8, \"num_hidden_layers\": 1,","+\t\t\t\t\"num_attention_heads\": 1, \"num_key_value_heads\": 1, \"head_dim\": 8, \"vocab_size\": 264,","+\t\t\t\t\"linear_num_value_heads\": 1, \"linear_num_key_heads\": 1, \"linear_key_head_dim\": 8, \"linear_value_head_dim\": 8,","+\t\t\t}","+\t\t\tif tt.override != 0 {","+\t\t\t\tbackbone[\"max_choices\"] = tt.override","+\t\t\t}","+\t\t\troot := &model.Root{Manifest: &manifest.Manifest{}}","+\t\t\tfor name, value := range map[string]any{","+\t\t\t\t\"config.json\": backbone, \"decision_head.json\": head, \"tokenizer.json\": tokenizer,","+\t\t\t\t\"calibration.json\": map[string]any{\"per_kind\": map[string]int{\"choice\": 1, \"noul\": 1, \"score\": 1}},","+\t\t\t} {","+\t\t\t\tdata, err := json.Marshal(value)","+\t\t\t\tif err != nil {","+\t\t\t\t\tt.Fatal(err)","+\t\t\t\t}","+\t\t\t\tlayer, err := manifest.NewLayer(strings.NewReader(string(data)), manifest.MediaTypeImageJSON)","+\t\t\t\tif err != nil {","+\t\t\t\t\tt.Fatal(err)","+\t\t\t\t}","+\t\t\t\tlayer.Name = name","+\t\t\t\troot.Manifest.Layers = append(root.Manifest.Layers, layer)","+\t\t\t}","+\t\t\tloaded, err := newModel(root)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t\tm := loaded.(*Model)","+\t\t\tif len(m.choiceIDs) != tt.maxChoices || len(m.choiceCodes) != tt.maxChoices {","+\t\t\t\tt.Fatalf(\"loaded %d IDs and %d labels, want %d\", len(m.choiceIDs), len(m.choiceCodes), tt.maxChoices)","+\t\t\t}","+\t\t\tq := &llm.ScoreQuestion{Type: \"choice\", Options: make([]string, tt.maxChoices)}","+\t\t\tif _, _, _, _, err := m.prompt(llm.ScoreRequest{}, q); err != nil {","+\t\t\t\tt.Fatalf(\"exact limit: %v\", err)","+\t\t\t}","+\t\t\tq.Options = append(q.Options, \"extra\")","+\t\t\tif _, _, _, _, err := m.prompt(llm.ScoreRequest{}, q); err == nil {","+\t\t\t\tt.Fatal(\"accepted more choices than the resolved limit\")","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestParseConfigRejectsInvalidChoices(t *testing.T) {","+\tfor _, data := range []string{","+\t\t`{\"max_choices\":-1}`,","+\t\t`{\"max_choices\":1}`,","+\t\t`{\"max_choices\":257}`,","+\t\t`{\"max_choices\":2.5}`,","+\t\t`{\"max_choices\":\"256\"}`,","+\t\t`{\"max_choices\":`,","+\t} {","+\t\tt.Run(data, func(t *testing.T) {","+\t\t\tvar head decisionHead","+\t\t\thead.Slots.Ranges = map[string][2]int{\"choice\": {8, 24}}","+\t\t\tif _, err := parseConfig([]byte(data), head); err == nil {","+\t\t\t\tt.Fatalf(\"accepted invalid config %s\", data)","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":142,"deletions":0,"truncated":false},{"path":"mlxrunner/model/autotrustdecision/model.go","lines":["@@ -0,0 +1,159 @@","+// Package autotrustdecision serves AutoTrust slot-readout decision checkpoints.","+package autotrustdecision","+","+import (","+\t\"fmt\"","+\t\"math\"","+\t\"slices\"","+\t\"strings\"","+","+\t\"github.com/ollama/ollama/mlx\"","+\t\"github.com/ollama/ollama/mlxrunner/model\"","+\t\"github.com/ollama/ollama/mlxrunner/model/qwen3_5\"","+)","+","+type decisionHead struct {","+\tBias          []float32 `json:\"bias\"`","+\tVerbalizerIDs []int32   `json:\"verbalizer_ids\"`","+\tSlots         struct {","+\t\tRanges      map[string][2]int `json:\"ranges\"`","+\t\tVerbalizers []string          `json:\"verbalizers\"`","+\t\tTemplate    string            `json:\"template_version\"`","+\t} `json:\"slots\"`","+}","+","+type calibration struct {","+\tPerKind map[string]float32 `json:\"per_kind\"`","+}","+","+type adapterConfig struct {","+\tRank  int     `json:\"r\"`","+\tAlpha float32 `json:\"lora_alpha\"`","+}","+","+type Model struct {","+\t*qwen3_5.Model","+\thead        decisionHead","+\ttemperature map[string]float32","+\tadapter     adapterConfig","+\tchoiceIDs   []int32","+\tchoiceCodes []string","+}","+","+func init() { model.Register(\"AutoTrustDecision\", newModel) }","+","+func newModel(root *model.Root) (model.Model, error) {","+\tvar head decisionHead","+\tif err := root.Manifest.ReadConfigJSON(\"decision_head.json\", &head); err != nil {","+\t\treturn nil, fmt.Errorf(\"read AutoTrust decision head: %w\", err)","+\t}","+\tslots := len(head.VerbalizerIDs)","+\tcompact := slots == 24 && head.Slots.Template == \"bare-v1\"","+\twide := slots == 264 && head.Slots.Template == \"bare-v1-wide256\"","+\tif len(head.Bias) != slots || len(head.Slots.Verbalizers) != slots ||","+\t\t(!compact && !wide) {","+\t\treturn nil, fmt.Errorf(\"unsupported AutoTrust decision slot head\")","+\t}","+\tif head.Slots.Ranges[\"noul\"] != [2]int{0, 2} ||","+\t\thead.Slots.Ranges[\"score\"] != [2]int{2, 8} || head.Slots.Ranges[\"choice\"] != [2]int{8, slots} {","+\t\treturn nil, fmt.Errorf(\"unsupported AutoTrust decision slot ranges\")","+\t}","+\tdata, err := root.Manifest.ReadConfig(\"config.json\")","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"read AutoTrust decision config: %w\", err)","+\t}","+\tcfg, err := parseConfig(data, head)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tvar cal calibration","+\tif err := root.Manifest.ReadConfigJSON(\"calibration.json\", &cal); err != nil {","+\t\treturn nil, fmt.Errorf(\"read AutoTrust decision calibration: %w\", err)","+\t}","+\tfor _, kind := range []string{\"noul\", \"score\", \"choice\"} {","+\t\tt := cal.PerKind[kind]","+\t\tif t <= 0 || math.IsNaN(float64(t)) || math.IsInf(float64(t), 0) {","+\t\t\treturn nil, fmt.Errorf(\"invalid AutoTrust decision %s temperature %g\", kind, t)","+\t\t}","+\t}","+\tbackbone, err := qwen3_5.NewModel(root)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tm := &Model{Model: backbone.(*qwen3_5.Model), head: head, temperature: cal.PerKind}","+\tswitch m.Config.ModelType {","+\tcase \"qwen3_5\", \"qwen3_5_text\", \"qwen3_5_moe\", \"qwen3_5_moe_text\":","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"unsupported AutoTrust decision backbone %q\", m.Config.ModelType)","+\t}","+\tfor _, id := range head.VerbalizerIDs {","+\t\tif id < 0 || id >= m.Config.VocabSize {","+\t\t\treturn nil, fmt.Errorf(\"AutoTrust decision verbalizer token %d is outside the vocabulary\", id)","+\t\t}","+\t}","+\t// A missing adapter config denotes a checkpoint with the adapter fused into","+\t// the backbone. A present but unreadable config must fail model loading.","+\tif _, ok := root.Manifest.ConfigLayer(\"adapter_config.json\"); ok {","+\t\tif err := root.Manifest.ReadConfigJSON(\"adapter_config.json\", &m.adapter); err != nil {","+\t\t\treturn nil, fmt.Errorf(\"read AutoTrust decision adapter config: %w\", err)","+\t\t}","+\t\tif m.adapter.Rank <= 0 || m.adapter.Alpha <= 0 {","+\t\t\treturn nil, fmt.Errorf(\"invalid AutoTrust decision adapter rank %d or alpha %g\", m.adapter.Rank, m.adapter.Alpha)","+\t\t}","+\t}","+\tm.choiceCodes, m.choiceIDs = choiceLabels(m.Tokenizer())","+\t// The System One API accepts at most 255 of the wide head's 256 labels.","+\theadChoices := min(slots-8, 255)","+\tif len(m.choiceIDs) < 255 || !slices.Equal(m.choiceIDs[:headChoices], head.VerbalizerIDs[8:8+headChoices]) {","+\t\treturn nil, fmt.Errorf(\"AutoTrust decision tokenizer choice labels do not match the trained head\")","+\t}","+\tmaxChoices := min(cfg.MaxChoices, len(m.choiceIDs))","+\tm.choiceCodes = m.choiceCodes[:maxChoices]","+\tm.choiceIDs = m.choiceIDs[:maxChoices]","+\treturn m, nil","+}","+","+// The publisher's LoRA applies to the System 1 backbone and lm_head only.","+// Merge into the loaded BF16 tensors before Qwen packs its linear-attention","+// projections. An already fused checkpoint has no adapter tensors.","+func (m *Model) LoadWeights(tensors map[string]*mlx.Array) error {","+\tconst prefix = \"base_model.model.\"","+\tconst aSuffix = \".lora_A.weight\"","+\tpairs := 0","+\tfor name, a := range tensors {","+\t\tif !strings.HasPrefix(name, prefix) || !strings.HasSuffix(name, aSuffix) {","+\t\t\tcontinue","+\t\t}","+\t\tif m.adapter.Rank <= 0 || m.adapter.Alpha <= 0 {","+\t\t\treturn fmt.Errorf(\"AutoTrust decision adapter tensors require adapter_config.json\")","+\t\t}","+\t\tstem := strings.TrimSuffix(strings.TrimPrefix(name, prefix), aSuffix)","+\t\tbaseName := stem + \".weight\"","+\t\tbName := strings.TrimSuffix(name, aSuffix) + \".lora_B.weight\"","+\t\tw, b := tensors[baseName], tensors[bName]","+\t\tif w == nil || b == nil || w.NumDims() != 2 || a.NumDims() != 2 || b.NumDims() != 2 ||","+\t\t\ta.Dim(0) != m.adapter.Rank || b.Dim(1) != m.adapter.Rank ||","+\t\t\ta.Dim(1) != w.Dim(1) || b.Dim(0) != w.Dim(0) {","+\t\t\treturn fmt.Errorf(\"AutoTrust decision adapter pair %s does not match base projection\", stem)","+\t\t}","+\t\t// Each merge finishes before the next pair so its FP32 intermediates","+\t\t// do not accumulate across the checkpoint's adapter projections.","+\t\tupdated := mlx.ScopedEval(func() []*mlx.Array {","+\t\t\treturn []*mlx.Array{mlx.Add(w.AsType(mlx.DTypeFloat32),","+\t\t\t\tmlx.MulScalar(mlx.Matmul(b.AsType(mlx.DTypeFloat32), a.AsType(mlx.DTypeFloat32)), m.adapter.Alpha/float32(m.adapter.Rank))).AsType(w.DType())}","+\t\t})[0]","+\t\ttensors[baseName] = updated","+\t\tdelete(tensors, name)","+\t\tdelete(tensors, bName)","+\t\tpairs++","+\t}","+\tfor name := range tensors {","+\t\tif strings.HasPrefix(name, prefix) && strings.HasSuffix(name, \".lora_B.weight\") {","+\t\t\treturn fmt.Errorf(\"AutoTrust decision adapter %s has no matching A tensor\", name)","+\t\t}","+\t}","+\tif m.adapter.Rank > 0 && pairs == 0 {","+\t\treturn fmt.Errorf(\"AutoTrust decision adapter configuration has no weights\")","+\t}","+\treturn m.Model.LoadWeights(tensors)","+}"],"additions":159,"deletions":0,"truncated":false},{"path":"mlxrunner/model/autotrustdecision/score.go","lines":["@@ -0,0 +1,178 @@","+package autotrustdecision","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"net/http\"","+\t\"slices\"","+\t\"strings\"","+","+\t\"github.com/ollama/ollama/api\"","+\t\"github.com/ollama/ollama/llm\"","+\t\"github.com/ollama/ollama/mlx\"","+\t\"github.com/ollama/ollama/mlxrunner/model\"","+\t\"github.com/ollama/ollama/mlxrunner/tokenizer\"","+)","+","+var _ model.CachedScorer = (*Model)(nil)","+","+// The publisher's bare-v1 prompt has no chat delimiters or generation suffix.","+const imageMarker = \"<|vision_start|><|image_pad|><|vision_end|>\"","+","+// A request body cap alone still permits many tiny images and prompt markers.","+const maxAutoTrustDecisionImages = 64","+","+func choiceLabels(tok *tokenizer.Tokenizer) ([]string, []int32) {","+\tvar codes []string","+\tvar ids []int32","+\tlabels := make([]string, 0, 702)","+\tfor a := 'A'; a <= 'Z'; a++ {","+\t\tlabels = append(labels, string(a))","+\t}","+\tfor a := 'A'; a <= 'Z'; a++ {","+\t\tfor b := 'A'; b <= 'Z'; b++ {","+\t\t\tlabels = append(labels, string(a)+string(b))","+\t\t}","+\t}","+\tfor _, code := range labels {","+\t\tcandidate := tok.Encode(code, false)","+\t\tif len(candidate) != 1 || !slices.Contains(tok.Encode(\"x\\n\"+code+\") y\", false), candidate[0]) {","+\t\t\tcontinue","+\t\t}","+\t\tcodes = append(codes, code)","+\t\tids = append(ids, candidate[0])","+\t\tif len(ids) == 255 {","+\t\t\treturn codes, ids","+\t\t}","+\t}","+\treturn codes, ids","+}","+","+func (m *Model) prompt(input llm.ScoreRequest, q *llm.ScoreQuestion) (string, string, []int32, []float32, error) {","+\tif q == nil {","+\t\treturn \"\", \"\", nil, nil, fmt.Errorf(\"missing AutoTrust decision question\")","+\t}","+\tif len(input.Images) > maxAutoTrustDecisionImages {","+\t\treturn \"\", \"\", nil, nil, fmt.Errorf(\"AutoTrust decision supports at most %d images\", maxAutoTrustDecisionImages)","+\t}","+\tvar options []string","+\tvar ids []int32","+\tvar bias []float32","+\tswitch q.Type {","+\tcase \"noul\":","+\t\tif len(q.Options) != 2 {","+\t\t\treturn \"\", \"\", nil, nil, fmt.Errorf(\"AutoTrust decision noul requires two options\")","+\t\t}","+\t\toptions = []string{\"false\", \"true\"}","+\t\tids = m.head.VerbalizerIDs[:2]","+\t\tbias = m.head.Bias[:2]","+\tcase \"score\":","+\t\tif len(q.Options) != 6 {","+\t\t\treturn \"\", \"\", nil, nil, fmt.Errorf(\"AutoTrust decision score requires six levels\")","+\t\t}","+\t\toptions = []string{\"0\", \"1\", \"2\", \"3\", \"4\", \"5\"}","+\t\tids = m.head.VerbalizerIDs[2:8]","+\t\tbias = m.head.Bias[2:8]","+\tcase \"choice\":","+\t\tmaxChoices := len(m.choiceIDs)","+\t\tif len(q.Options) < 2 || len(q.Options) > maxChoices {","+\t\t\treturn \"\", \"\", nil, nil, fmt.Errorf(\"AutoTrust decision choice requires 2–%d options\", maxChoices)","+\t\t}","+\t\toptions = make([]string, len(q.Options))","+\t\tfor i, option := range q.Options {","+\t\t\toptions[i] = m.choiceCodes[i] + \") \" + option","+\t\t}","+\t\tids = m.choiceIDs[:len(options)]","+\t\tbias = make([]float32, len(options))","+\t\tcopy(bias, m.head.Bias[8:])","+\tdefault:","+\t\treturn \"\", \"\", nil, nil, fmt.Errorf(\"unsupported AutoTrust decision question type %q\", q.Type)","+\t}","+\tprefix := fmt.Sprintf(\"[kind] %s\\n[state] \", q.Type)","+\tif len(input.Images) > 0 {","+\t\tprefix += strings.Repeat(imageMarker, len(input.Images))","+\t}","+\tprefix += input.State + \"\\n[question] \"","+\tfull := prefix + q.Instructions + \"\\n[options]\\n\" + strings.Join(options, \"\\n\") + \"\\n[decision]:\"","+\treturn full, prefix, ids, bias, nil","+}","+","+func (m *Model) prepareRow(input llm.ScoreRequest, q *llm.ScoreQuestion) (*model.PreparedRequest, []model.Segment, []int32, []float32, error) {","+\tfull, prefix, ids, bias, err := m.prompt(input, q)","+\tif err != nil {","+\t\treturn nil, nil, nil, nil, err","+\t}","+\ttok := m.Tokenizer()","+\tif len(input.Images) == 0 {","+\t\tprepared, err := m.PrepareMedia([]model.Segment{{Tokens: tok.Encode(full, false)}})","+\t\tif err != nil {","+\t\t\treturn nil, nil, nil, nil, err","+\t\t}","+\t\twant := tok.Encode(prefix, false)","+\t\tfor prepared.ScorePrefix < len(want) && prepared.ScorePrefix < len(prepared.Tokens) && want[prepared.ScorePrefix] == prepared.Tokens[prepared.ScorePrefix] {","+\t\t\tprepared.ScorePrefix++","+\t\t}","+\t\treturn prepared, nil, ids, bias, nil","+\t}","+\tbefore := fmt.Sprintf(\"[kind] %s\\n[state] \", q.Type)","+\tsegments := []model.Segment{{Tokens: tok.Encode(before, false)}}","+\tfor _, data := range input.Images {","+\t\tsegments = append(segments, model.Segment{Kind: \"image\", Data: data})","+\t}","+\tafter := full[len(before)+len(input.Images)*len(imageMarker):]","+\tsegments = append(segments, model.Segment{Tokens: tok.Encode(after, false)})","+\tprepared, err := m.PrepareMedia(segments)","+\tif err != nil {","+\t\treturn nil, nil, nil, nil, err","+\t}","+\t// The cache still recognizes identical media requests and safe boundaries.","+\t// The text-only prefix boundary is omitted here because multimodal token","+\t// expansion changes it and the caller's images are separate from state.","+\treturn prepared, segments, ids, bias, nil","+}","+","+func (m *Model) finishScore(hidden *mlx.Array, n int, ids []int32, bias []float32, kind string) []float32 {","+\tlast := hidden.Slice(mlx.Slice(), mlx.Slice(n-1, n), mlx.Slice())","+\tselected := m.Model.UnembedCandidates(last, mlx.FromValues(ids, len(ids)))","+\tlogits := mlx.DivScalar(mlx.Add(selected, mlx.FromValues(bias, len(bias))), m.temperature[kind])","+\tmlx.Eval(logits)","+\treturn logits.Floats()","+}","+","+func (m *Model) Score(ctx context.Context, input llm.ScoreRequest, forward model.ScoreForward) (llm.ScoreResponse, error) {","+\tvar result llm.ScoreResponse","+\tcached := 0","+\tresult.CachedTokens = &cached","+\tbadRequest := func(err error) (llm.ScoreResponse, error) {","+\t\treturn result, api.StatusError{StatusCode: http.StatusBadRequest, ErrorMessage: err.Error()}","+\t}","+\tif len(input.Rows) < 1 || len(input.Rows) > 64 || input.MaxTokens < 1 || input.MaxTokens > m.MaxContextLength() {"],"additions":149,"deletions":0,"truncated":false}],