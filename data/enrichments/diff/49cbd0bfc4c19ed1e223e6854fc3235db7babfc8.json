\"ERR_PNPM_ADDING_TO_ROOT\"), \"unexpected stderr: {stderr}\");","+    stderr","+}","+","+const INIT_SUGGESTION: &str = r#\"running \"pnpm init\" to generate a package.json\"#;","+","+#[test]","+fn add_from_a_matched_directory_without_a_manifest_suggests_pnpm_init() {","+    let stderr =","+        add_from_workspace_subdir(\"  - packages/*\\n  - tools/*\\n\", \"packages/project\", &[]);","+    assert!(stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+","+#[test]","+fn add_from_a_matched_directory_without_a_manifest_suggests_pnpm_init_with_one_pattern() {","+    let stderr = add_from_workspace_subdir(\"  - packages/*\\n\", \"packages/project\", &[]);","+    assert!(stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+","+#[test]","+fn add_from_a_directory_outside_the_patterns_keeps_the_root_warning() {","+    let stderr = add_from_workspace_subdir(\"  - packages/*\\n  - tools/*\\n\", \"scripts\", &[]);","+    assert!(!stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+","+#[test]","+fn add_from_a_directory_excluded_by_the_patterns_keeps_the_root_warning() {","+    let stderr = add_from_workspace_subdir(","+        \"  - packages/*\\n  - tools/*\\n  - '!packages/ignored'\\n\",","+        \"packages/ignored\",","+        &[],","+    );","+    assert!(!stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+","+#[test]","+fn add_from_inside_the_modules_dir_keeps_the_root_warning() {","+    let stderr =","+        add_from_workspace_subdir(\"  - '**'\\n  - tools/*\\nmodulesDir: deps\\n\", \"deps/foo\", &[]);","+    assert!(!stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+","+#[test]","+fn add_from_a_matched_directory_suggests_pnpm_init_when_the_modules_dir_is_the_root() {","+    let stderr =","+        add_from_workspace_subdir(\"  - packages/*\\nmodulesDir: .\\n\", \"packages/project\", &[]);","+    assert!(stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+","+#[test]","+fn add_with_dir_at_the_workspace_root_keeps_the_root_warning() {","+    let stderr = add_from_workspace_subdir(","+        \"  - packages/*\\n  - tools/*\\n\",","+        \"packages/project\",","+        &[\"--dir\", \"<root>\"],","+    );","+    assert!(!stderr.contains(INIT_SUGGESTION), \"unexpected stderr: {stderr}\");","+}","+"," #[test]"," fn add_accepts_multiple_local_package_selectors() {","     let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();"],"additions":87,"deletions":0,"truncated":false},{"path":"pnpm11/installing/commands/package.json","lines":["@@ -87,6 +87,7 @@","     \"@pnpm/text.sanitize\": \"workspace:*\",","     \"@pnpm/types\": \"workspace:*\",","     \"@pnpm/workspace.injected-deps-syncer\": \"workspace:*\",","+    \"@pnpm/workspace.package-patterns\": \"workspace:*\",","     \"@pnpm/workspace.project-manifest-reader\": \"workspace:*\",","     \"@pnpm/workspace.project-manifest-writer\": \"workspace:*\",","     \"@pnpm/workspace.projects-filter\": \"workspace:*\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm11/installing/commands/src/add.ts","lines":["@@ -14,6 +14,7 @@ import { safeReadProjectManifestOnly } from '@pnpm/workspace.project-manifest-re"," import { pick } from 'ramda'"," import { renderHelp } from 'render-help'"," ","+import { assertNotAddingToWorkspaceRoot } from './assertNotAddingToWorkspaceRoot.js'"," import type { InstallCommandOptions } from './install.js'"," import { installDeps } from './installDeps.js'"," import { createGlobalPolicyCallbacks } from './resolutionPolicyManifest.js'","@@ -291,24 +292,6 @@ async function addConfigDependencies (opts: AddCommandOptions, params: string[])","   })"," }"," ","-function assertNotAddingToWorkspaceRoot (opts: AddCommandOptions): void {","-  if (","-    !opts.recursive &&","-    opts.workspaceDir === opts.dir &&","-    !opts.ignoreWorkspaceRootCheck &&","-    !opts.workspaceRoot &&","-    opts.workspacePackagePatterns &&","-    opts.workspacePackagePatterns.length > 1","-  ) {","-    throw new PnpmError('ADDING_TO_ROOT',","-      'Running this command will add the dependency to the workspace root, ' +","-      'which might not be what you want - if you really meant it, ' +","-      'make it explicit by running this command again with the -w flag (or --workspace-root). ' +","-      'If you don\\'t want to see this warning anymore, you may set the ignore-workspace-root-check setting to true.'","-    )","-  }","-}","-"," export { parseAllowBuildSelector }"," "," export function parseAllowBuildSelectors ("],"additions":1,"deletions":18,"truncated":false},{"path":"pnpm11/installing/commands/src/assertNotAddingToWorkspaceRoot.ts","lines":["@@ -0,0 +1,59 @@","+import fs from 'node:fs'","+import path from 'node:path'","+","+import { MANIFEST_BASE_NAMES } from '@pnpm/constants'","+import { PnpmError } from '@pnpm/error'","+import { isWorkspaceProjectDir } from '@pnpm/workspace.package-patterns'","+import { isSubdir } from 'is-subdir'","+","+import type { AddCommandOptions } from './add.js'","+","+const ROOT_WORKSPACE_ADD_MESSAGE =","+  'Running this command will add the dependency to the workspace root, ' +","+  'which might not be what you want - if you really meant it, ' +","+  'make it explicit by running this command again with the -w flag (or --workspace-root). ' +","+  'If you don\\'t want to see this warning anymore, you may set the ignore-workspace-root-check setting to true.'","+","+const WORKSPACE_PACKAGE_DIR_ADD_MESSAGE =","+  'Running this command in a workspace package directory without a package manifest will add the dependency to the workspace root, which might not be what you want. ' +","+  'If this directory is meant to be a package, create a package manifest first, for example by running \"pnpm init\" to generate a package.json. ' +","+  'If you really meant it, make it explicit by running this command again with the -w flag (or --workspace-root). ' +","+  'If you don\\'t want to see this warning anymore, you may set the ignore-workspace-root-check setting to true.'","+","+export function assertNotAddingToWorkspaceRoot (opts: AddCommandOptions): void {","+  if (","+    opts.recursive ||","+    opts.workspaceDir !== opts.dir ||","+    opts.ignoreWorkspaceRootCheck ||","+    opts.workspaceRoot","+  ) return","+  if (isUninitializedWorkspaceProjectDir(opts)) {","+    throw new PnpmError('ADDING_TO_ROOT', WORKSPACE_PACKAGE_DIR_ADD_MESSAGE)","+  }","+  if (opts.workspacePackagePatterns && opts.workspacePackagePatterns.length > 1) {","+    throw new PnpmError('ADDING_TO_ROOT', ROOT_WORKSPACE_ADD_MESSAGE)","+  }","+}","+","+/**","+ * `pnpm add` run from a directory that the workspace patterns select but that","+ * has no manifest yet falls back to the workspace root. Such a directory is","+ * most likely a package that was not initialized.","+ */","+function isUninitializedWorkspaceProjectDir (opts: AddCommandOptions): boolean {","+  const { workspaceDir } = opts","+  if (!workspaceDir) return false","+  const invocationDir = (opts.cliOptions.dir as string | undefined) ?? fs.realpathSync(process.cwd())","+  if (invocationDir === workspaceDir) return false","+  if (MANIFEST_BASE_NAMES.some((manifestFileName) => fs.existsSync(path.join(invocationDir, manifestFileName)))) return false","+  const managedDirs = [opts.modulesDir, opts.storeDir, opts.cacheDir]","+    .filter((dir): dir is string => dir != null)","+    .map((dir) => path.resolve(workspaceDir, dir))","+    .filter((managedDir) => !isSubdir(managedDir, workspaceDir))","+  if (managedDirs.some((managedDir) => isSubdir(managedDir, invocationDir))) return false","+  return isWorkspaceProjectDir({","+    workspaceDir,","+    dir: invocationDir,","+    patterns: opts.workspacePackagePatterns ?? ['.'],","+  })","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"pnpm11/installing/commands/tsconfig.json","lines":["@@ -174,6 +174,9 @@","     {","       \"path\": \"../../workspace/injected-deps-syncer\"","     },","+    {","+      \"path\": \"../../workspace/package-patterns\"","+    },","     {","       \"path\": \"../../workspace/project-manifest-reader\"","     },"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm11/pnpm/test/recursive/misc.ts","lines":["@@ -384,6 +384,168 @@ test('adding new dependency in the root should fail if neither --workspace-root","   }"," })"," ","+test('adding a dependency from a workspace-matched directory without a manifest should suggest initializing the package first', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('packages/project', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - '.'","+  - 'packages/*'","+  - '!store/**'","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive'], { cwd: path.resolve('packages/project') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/workspace package directory without a package manifest/)","+  expect(stdout.toString()).toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+","+test('adding a dependency from a directory outside the workspace package patterns should keep the workspace root warning', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('scripts', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - '.'","+  - 'packages/*'","+  - '!store/**'","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive'], { cwd: path.resolve('scripts') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/Running this command will add the dependency to the workspace root/)","+  expect(stdout.toString()).not.toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+","+test('adding a dependency from a directory excluded by the workspace patterns should keep the workspace root warning', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('packages/ignored', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - 'packages/*'","+  - 'tools/*'","+  - '!packages/ignored'","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive'], { cwd: path.resolve('packages/ignored') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/Running this command will add the dependency to the workspace root/)","+  expect(stdout.toString()).not.toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+","+test('adding a dependency from inside the modules directory should keep the workspace root warning', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('deps/foo', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - '**'","+  - 'tools/*'","+modulesDir: deps","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive'], { cwd: path.resolve('deps/foo') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/Running this command will add the dependency to the workspace root/)","+  expect(stdout.toString()).not.toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+","+test('adding a dependency from a workspace-matched directory without a manifest should suggest initializing the package when the modules directory is the workspace root', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('packages/project', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - 'packages/*'","+modulesDir: .","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive'], { cwd: path.resolve('packages/project') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+","+test('adding a dependency from a workspace-matched directory without a manifest should suggest initializing the package in a single-pattern workspace', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('packages/project', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - 'packages/*'","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive'], { cwd: path.resolve('packages/project') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+","+test('adding a dependency with --dir pointing at the workspace root should keep the workspace root warning', async () => {","+  preparePackages([","+    {","+      location: '.',","+      package: {","+        name: 'root',","+      },","+    },","+  ])","+","+  fs.mkdirSync('packages/project', { recursive: true })","+  fs.writeFileSync('pnpm-workspace.yaml', `packages:","+  - 'packages/*'","+  - 'tools/*'","+`, 'utf8')","+","+  const { status, stdout } = execPnpmSync(['add', 'is-positive', '--dir', process.cwd()], { cwd: path.resolve('packages/project') })","+","+  expect(status).toBe(1)","+  expect(stdout.toString()).toMatch(/Running this command will add the dependency to the workspace root/)","+  expect(stdout.toString()).not.toMatch(/running \"pnpm init\" to generate a package\\.json/)","+})","+"," test('--workspace-packages', async () => {","   const projects = preparePackages([",