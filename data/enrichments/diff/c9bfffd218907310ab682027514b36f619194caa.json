{"id":"c9bfffd218907310ab682027514b36f619194caa","axis":"silent","repo":"pnpm/pnpm","sha":"c9bfffd218907310ab682027514b36f619194caa","parsed":{"files":[{"path":".changeset/18261-gvs-esm-loader-require-extensions.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/exec.esm-node-path-loader\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+With `enableGlobalVirtualStore` on, `require.extensions` hooks run again for `require()` calls from a module compiled from a string, such as the module Next.js uses to load `next.config.ts`. A required `.ts` file skipped the registered TypeScript hook. A required `.json` file was parsed as JavaScript [#18261](https://github.com/pnpm/pnpm/issues/18261)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/esm_node_path_loader.rs","lines":["@@ -15,7 +15,12 @@"," //! entry point with the `commonjs` format, which hands it back to the CJS"," //! loader, as Node.js does without `--import`. Entry points ending in `.js`"," //! or without an extension are left alone, because Node.js may detect","-//! module syntax in them.","+//! module syntax in them. A `require()` from a module without a filename","+//! also has no parent URL. Unless the user adds `--conditions=import`, only","+//! the entry point resolves with the `import` condition, so the hook leaves","+//! such a `require()` to `require.extensions`. Some Node.js versions pass","+//! the conditions of a `require()` as a `Set`, so the hook spreads them","+//! before searching."," //!"," //! The hook sources are identical copies of the ones the TypeScript CLI"," //! embeds (`pnpm11/exec/esm-node-path-loader/src/index.ts`) — the two must","@@ -25,7 +30,7 @@ use std::{fmt::Write, sync::LazyLock};"," "," const RESOLVE_HELPERS: &str = r\"const nodePaths = (process.env.NODE_PATH ?? '').split(delimiter).filter(Boolean)"," const isBareSpecifier = (specifier) => !specifier.startsWith('.') && !specifier.startsWith('/') && !specifier.startsWith('#') && !specifier.includes(':')","-const isEntryPointUnknownToEsm = (resolved, context) => context.parentURL === undefined && resolved.format == null && resolved.url.startsWith('file:') && !['', '.js'].includes(extname(new URL(resolved.url).pathname))","+const isEntryPointUnknownToEsm = (resolved, context) => context.parentURL === undefined && [...(context.conditions ?? ['import'])].includes('import') && resolved.format == null && resolved.url.startsWith('file:') && !['', '.js'].includes(extname(new URL(resolved.url).pathname))"," const markUnknownEntryPointAsCommonJs = (resolved, context) => isEntryPointUnknownToEsm(resolved, context) ? { ...resolved, format: 'commonjs' } : resolved\";"," "," /// Fallback for Node.js versions that have `module.register()` but not"],"additions":7,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/esm_node_path_loader/tests.rs","lines":["@@ -58,6 +58,50 @@ fn keep_reapplies_the_flag_only_when_the_previous_value_carried_it() {","     );"," }"," ","+/// Mirrors the TypeScript test `require() from a module compiled from a","+/// string loads ...` in `pnpm11/exec/esm-node-path-loader/test/index.ts`.","+/// A module created with `new Module()` has no filename, so its `require()`","+/// calls reach the resolve hook without a parent URL, like the entry point","+/// does, and resolve relative specifiers from the working directory","+/// (pnpm/pnpm#18261).","+#[test]","+fn require_from_a_module_compiled_from_a_string_keeps_require_extensions() {","+    let ts_hook = r#\"require.extensions['.ts'] = (module, filename) => module._compile('module.exports = \"ts-hook\"', filename)\"#;","+    for (file, contents, hook, expected) in [","+        (\"lib.ts\", \"not JavaScript\", ts_hook, \"ts-hook\"),","+        (\"data.json\", r#\"\"json-loaded\"\"#, \"\", \"json-loaded\"),","+    ] {","+        let dir = tempfile::tempdir().expect(\"create temp dir\");","+        let root = dir.path();","+        fs::write(","+            root.join(\"runner.js\"),","+            format!(","+                r#\"const Module = require('node:module')","+const path = require('node:path')","+{hook}","+const filename = path.join(__dirname, 'compiled.js')","+const compiled = new Module(filename, module)","+compiled.paths = Module._nodeModulePaths(__dirname)","+compiled._compile('module.exports = require(\"./{file}\")', filename)","+console.log(compiled.exports)","+\"#,","+            ),","+        )","+        .expect(\"write runner.js\");","+        fs::write(root.join(file), contents).expect(\"write the required file\");","+","+        let output = Command::new(\"node\")","+            .arg(\"runner.js\")","+            .current_dir(root)","+            .env(\"NODE_OPTIONS\", esm_node_path_loader_import_flag())","+            .output()","+            .expect(\"run node\");","+        assert_eq!(String::from_utf8_lossy(&output.stderr), \"\", \"requiring {file}\");","+        assert!(output.status.success(), \"requiring {file}\");","+        assert_eq!(String::from_utf8_lossy(&output.stdout).trim(), expected);","+    }","+}","+"," /// Mirrors the TypeScript test of the same name in"," /// `pnpm11/exec/esm-node-path-loader/test/index.ts`. The alias hook stands in"," /// for the tsconfig paths hook in pnpm/pnpm#16979. `NODE_OPTIONS` imports"],"additions":44,"deletions":0,"truncated":false},{"path":"pnpm11/exec/esm-node-path-loader/src/index.ts","lines":["@@ -23,7 +23,12 @@","  * such an entry point as CommonJS, which hands it back to the CommonJS","  * loader, as Node.js does without `--import`. Entry points ending in `.js`","  * or without an extension are left alone, because Node.js may detect module","- * syntax in them.","+ * syntax in them. A `require()` from a module without a filename also has no","+ * `parentURL`. Unless the user adds `--conditions=import`, only the entry","+ * point resolves with the `import` condition, so the hook leaves such a","+ * `require()` to `require.extensions`. Some Node.js versions pass the","+ * conditions of a `require()` as a `Set`, so the hook spreads them before","+ * searching.","  *","  * The Rust CLI embeds an identical copy of these sources — the two must","  * stay in sync so both CLIs inject the same `NODE_OPTIONS` value.","@@ -31,7 +36,7 @@"," const RESOLVE_HELPERS = `\\"," const nodePaths = (process.env.NODE_PATH ?? '').split(delimiter).filter(Boolean)"," const isBareSpecifier = (specifier) => !specifier.startsWith('.') && !specifier.startsWith('/') && !specifier.startsWith('#') && !specifier.includes(':')","-const isEntryPointUnknownToEsm = (resolved, context) => context.parentURL === undefined && resolved.format == null && resolved.url.startsWith('file:') && !['', '.js'].includes(extname(new URL(resolved.url).pathname))","+const isEntryPointUnknownToEsm = (resolved, context) => context.parentURL === undefined && [...(context.conditions ?? ['import'])].includes('import') && resolved.format == null && resolved.url.startsWith('file:') && !['', '.js'].includes(extname(new URL(resolved.url).pathname))"," const markUnknownEntryPointAsCommonJs = (resolved, context) => isEntryPointUnknownToEsm(resolved, context) ? { ...resolved, format: 'commonjs' } : resolved"," `"," "],"additions":7,"deletions":2,"truncated":false},{"path":"pnpm11/exec/esm-node-path-loader/test/import-flag.txt","lines":["@@ -1 +1 @@","\\ No newline at end of file","+--import=data:text/javascript,const%20%7B%20register%2C%20registerHooks%20%7D%20%3D%20await%20import%28%27node%3Amodule%27%29%0Aif%20%28registerHooks%29%20%7B%0A%20%20const%20%7B%20delimiter%2C%20extname%20%7D%20%3D%20await%20import%28%27node%3Apath%27%29%0A%20%20const%20%7B%20pathToFileURL%20%7D%20%3D%20await%20import%28%27node%3Aurl%27%29%0A%20%20const%20nodePaths%20%3D%20%28process.env.NODE_PATH%20%3F%3F%20%27%27%29.split%28delimiter%29.filter%28Boolean%29%0A%20%20const%20isBareSpecifier%20%3D%20%28specifier%29%20%3D%3E%20%21specifier.startsWith%28%27.%27%29%20%26%26%20%21specifier.startsWith%28%27%2F%27%29%20%26%26%20%