o all projects that have nx-build-state.json files.","      */","-    fun applyBuildStates(allProjects: List<MavenProject>) {","+    fun applyBuildStates(allProjects: List<MavenProject>, workspaceRoot: File) {","         val startTime = System.currentTimeMillis()","         log.debug(\"Checking ${allProjects.size} projects for build state files...\")"," ","@@ -56,7 +56,7 @@ object BuildStateManager {","         projectsToApply.forEach { (project, stateFile) ->","             try {","                 val buildState = gson.fromJson(stateFile.readText(), BuildState::class.java)","-                BuildStateApplier.applyBuildState(project, buildState, projectHelper)","+                BuildStateApplier.applyBuildState(project, buildState, workspaceRoot, projectHelper)","                 log.debug(\"  Applied build state for ${project.groupId}:${project.artifactId}\")","             } catch (e: Exception) {","                 log.error(\"  Failed to apply build state to ${project.artifactId}: ${e.message}\", e)"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/maven/shared/src/test/kotlin/dev/nx/maven/shared/BuildStateApplierTest.kt","lines":["@@ -0,0 +1,229 @@","+package dev.nx.maven.shared","+","+import org.apache.maven.artifact.DefaultArtifact","+import org.apache.maven.artifact.handler.DefaultArtifactHandler","+import org.apache.maven.model.Build","+import org.apache.maven.model.Model","+import org.apache.maven.project.MavenProject","+import org.apache.maven.project.MavenProjectHelper","+import org.junit.jupiter.api.BeforeEach","+import org.junit.jupiter.api.Test","+import org.junit.jupiter.api.io.TempDir","+import java.io.File","+import java.nio.file.Files","+import kotlin.test.assertEquals","+import kotlin.test.assertNull","+","+class BuildStateApplierTest {","+","+  @TempDir","+  lateinit var tempDir: File","+","+  private lateinit var workspaceRoot: File","+  private lateinit var projectRoot: File","+  private lateinit var outside: File","+  private lateinit var project: MavenProject","+","+  @BeforeEach","+  fun setUp() {","+    workspaceRoot = File(tempDir.canonicalFile, \"workspace\")","+    projectRoot = File(workspaceRoot, \"app\")","+    outside = File(tempDir.canonicalFile, \"outside\")","+    listOf(\"target/classes\", \"target/test-classes\", \"target/generated-sources\", \"src/main/java\").forEach {","+      File(projectRoot, it).mkdirs()","+    }","+    File(workspaceRoot, \"shared-resources\").mkdirs()","+    File(projectRoot, \"target/app.jar\").writeText(\"\")","+    File(projectRoot, \".flattened-pom.xml\").writeText(\"\")","+    outside.mkdirs()","+    File(outside, \"file\").writeText(\"\")","+","+    project = MavenProject(Model().apply {","+      build = Build().apply {","+        directory = File(projectRoot, \"target\").path","+        outputDirectory = File(projectRoot, \"target/classes\").path","+        testOutputDirectory = File(projectRoot, \"target/test-classes\").path","+      }","+    }).apply {","+      file = File(projectRoot, \"pom.xml\")","+      artifact = DefaultArtifact(\"com.example\", \"app\", \"1.0.0\", \"compile\", \"jar\", null, DefaultArtifactHandler(\"jar\"))","+    }","+  }","+","+  private fun artifactInfo(file: String) = ArtifactInfo(file, \"jar\", null, \"com.example\", \"app\", \"1.0.0\")","+","+  private val recordingHelper = object : MavenProjectHelper {","+    override fun attachArtifact(project: MavenProject, artifactFile: File, artifactClassifier: String?) =","+      attachArtifact(project, \"jar\", artifactClassifier, artifactFile)","+","+    override fun attachArtifact(project: MavenProject, artifactType: String, artifactFile: File) =","+      attachArtifact(project, artifactType, null, artifactFile)","+","+    override fun attachArtifact(project: MavenProject, artifactType: String, artifactClassifier: String?, artifactFile: File) {","+      project.addAttachedArtifact(","+        DefaultArtifact(\"com.example\", \"app\", \"1.0.0\", \"compile\", artifactType, artifactClassifier, DefaultArtifactHandler(artifactType))","+          .apply { file = artifactFile }","+      )","+    }","+","+    override fun addResource(project: MavenProject, resourceDirectory: String, includes: List<String>, excludes: List<String>) =","+      throw UnsupportedOperationException()","+","+    override fun addTestResource(project: MavenProject, resourceDirectory: String, includes: List<String>, excludes: List<String>) =","+      throw UnsupportedOperationException()","+  }","+","+  private fun apply(buildState: BuildState, root: File = workspaceRoot) =","+    BuildStateApplier.applyBuildState(project, buildState, root, recordingHelper)","+","+  private fun stateWithEveryPath(dir: String) = BuildState(","+    compileSourceRoots = setOf(dir),","+    testCompileSourceRoots = setOf(dir),","+    resources = setOf(dir),","+    testResources = setOf(dir),","+    outputDirectory = dir,","+    testOutputDirectory = dir,","+    mainArtifact = artifactInfo(\"$dir/file\"),","+    attachedArtifacts = listOf(artifactInfo(\"$dir/file\")),","+    pomFile = \"$dir/file\"","+  )","+","+  private fun assertNothingApplied() {","+    assertEquals(emptyList(), project.compileSourceRoots)","+    assertEquals(emptyList(), project.testCompileSourceRoots)","+    assertEquals(emptyList(), project.resources)","+    assertEquals(emptyList(), project.testResources)","+    assertEquals(File(projectRoot, \"target/classes\").path, project.build.outputDirectory)","+    assertEquals(File(projectRoot, \"target/test-classes\").path, project.build.testOutputDirectory)","+    assertNull(project.artifact.file)","+    assertEquals(emptyList(), project.attachedArtifacts)","+    assertEquals(File(projectRoot, \"pom.xml\"), project.file)","+  }","+","+  @Test","+  fun `applies paths inside the workspace and the build directory`() {","+    apply(","+      BuildState(","+        compileSourceRoots = setOf(\"target/generated-sources\", \"../shared-resources\"),","+        testCompileSourceRoots = setOf(\"src/main/java\"),","+        resources = setOf(\"../shared-resources\"),","+        testResources = setOf(\"target/generated-sources\"),","+        outputDirectory = \"target/generated-sources\",","+        testOutputDirectory = \"target/test-classes\",","+        mainArtifact = artifactInfo(\"target/app.jar\"),","+        attachedArtifacts = listOf(ArtifactInfo(\"target/app.jar\", \"jar\", \"sources\", \"com.example\", \"app\", \"1.0.0\")),","+        pomFile = \".flattened-pom.xml\"","+      )","+    )","+","+    assertEquals(","+      listOf(File(projectRoot, \"target/generated-sources\").path, File(workspaceRoot, \"shared-resources\").path),","+      project.compileSourceRoots","+    )","+    assertEquals(listOf(File(projectRoot, \"src/main/java\").path), project.testCompileSourceRoots)","+    assertEquals(listOf(File(workspaceRoot, \"shared-resources\").path), project.resources.map { it.directory })","+    assertEquals(listOf(File(projectRoot, \"target/generated-sources\").path), project.testResources.map { it.directory })","+    assertEquals(File(projectRoot, \"target/generated-sources\").path, project.build.outputDirectory)","+    assertEquals(File(projectRoot, \"target/test-classes\").path, project.build.testOutputDirectory)","+    assertEquals(File(projectRoot, \"target/app.jar\"), project.artifact.file)","+    assertEquals(listOf(File(projectRoot, \"target/app.jar\")), project.attachedArtifacts.map { it.file })","+    assertEquals(File(projectRoot, \".flattened-pom.xml\"), project.file)","+  }","+","+  @Test","+  fun `applies workspace paths when the workspace root is reached through a symlink`() {","+    val workspaceLink = File(tempDir.canonicalFile, \"workspace-link\")","+    Files.createSymbolicLink(workspaceLink.toPath(), workspaceRoot.toPath())","+","+    apply(","+      BuildState(","+        compileSourceRoots = setOf(\"../shared-resources\"),","+        testCompileSourceRoots = emptySet(),","+        mainArtifact = null,","+        attachedArtifacts = emptyList()","+      ),","+      workspaceLink","+    )","+","+    assertEquals(listOf(File(workspaceRoot, \"shared-resources\").path), project.compileSourceRoots)","+  }","+","+  @Test","+  fun `ignores absolute paths outside the workspace`() {","+    apply(stateWithEveryPath(outside.path))","+    assertNothingApplied()","+  }","+","+  @Test","+  fun `ignores relative paths that escape the workspace`() {","+    apply(stateWithEveryPath(\"../../outside\"))","+    assertNothingApplied()","+  }","+","+  @Test","+  fun `ignores symlinks that leave the workspace`() {","+    Files.createSymbolicLink(File(projectRoot, \"target/link\").toPath(), outside.toPath())","+    apply(stateWithEveryPath(\"target/link\"))","+    assertNothingApplied()","+  }","+","+  @Test","+  fun `ignores symlinks that leave the workspace behind a missing directory`() {","+    Files.createSymbolicLink(File(projectRoot, \"target/link\").toPath(), outside.toPath())","+    apply(stateWithEveryPath(\"target/missing/../link\"))","+    assertNothingApplied()","+  }","+","+  @Test","+  fun `ignores absolute symlinks that leave the workspace behind a missing directory`() {","+    Files.createSymbolicLink(File(projectRoot, \"target/link\").toPath(), outside.toPath())","+    apply(stateWithEveryPath(File(projectRoot, \"target/missing/../link\").path))","+    assertNothingApplied()","+  }","+","+  @Test","+  fun `ignores symlinks that leave the workspace behind a path too long to canonicalize`() {","+    Files.createSymbolicLink(File(projectRoot, \"target/link\").toPath(), outside.toPath())","+    apply(stateWithEveryPath(File(projectRoot, \"target/link\").path + \"/a/..\".repeat(1200)))","+    assertNothingApplied()","+  }","+","+  @Test","+  fun `ignores output directories outside the build directory`() {","+    apply(","+      BuildState(","+        compileSourceRoots = emptySet(),","+        testCompileSourceRoots = emptySet(),","+        outputDirectory = \"src/main/java\",","+