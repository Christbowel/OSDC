.toThrow(","+      `Environment variable $${key} is not set and no fallback was provided. Set $${key} or provide a fallback.`","+    );","+  }","+  process.env[key] = '0012';","+  expect(int(key)).toBe(12);","+  process.env[key] = '-0';","+  expect(int(key)).toBe(-0);","+  process.env[key] = '';","+  expect(string(key, 'fallback')).toBe('');","+  process.env[key] = 'false';","+  expect(boolish(key)).toBe(false);","+  process.env[key] = 'TRUE';","+  expect(boolish(key)).toBe(true);","+});","+","+test('treats null fallbacks as absent', () => {","+  delete process.env[key];","+  for (const read of [string, boolish, int]) {","+    expect(() => read(key, null)).toThrow(","+      `Environment variable $${key} is not set and no fallback was provided. Set $${key} or provide a fallback.`","+    );","+  }","+});","+","+test('treats null environment values as absent', () => {","+  const original = process.env;","+  process.env = { ...original, [key]: null } as unknown as NodeJS.ProcessEnv;","+  try {","+    expect(string(key, 'fallback')).toBe('fallback');","+    expect(int(key, 0)).toBe(0);","+    expect(boolish(key, false)).toBe(false);","+    expect(() => string(key)).toThrow(","+      `Environment variable $${key} is not set and no fallback was provided. Set $${key} or provide a fallback.`","+    );","+  } finally {","+    process.env = original;","+  }","+});"],"additions":72,"deletions":0,"truncated":false},{"path":"packages/@expo/env/src/getenv.ts","lines":["@@ -0,0 +1,31 @@","+/** Read an environment variable at call time, applying a fallback only when it is absent. */","+export function string(name: string, fallback?: string | null): string {","+  const value = process.env[name];","+  if (value != null) return value;","+  if (fallback != null) return '' + fallback;","+  throw new Error(","+    `Environment variable $${name} is not set and no fallback was provided. Set $${name} or provide a fallback.`","+  );","+}","+","+/** Read a strict decimal integer. */","+export function int(name: string, fallback?: number | null): number {","+  const value = string(name, fallback == null ? undefined : '' + fallback);","+  if (!/^-?\\d+$/.test(value)) {","+    throw new Error(","+      `Invalid value for environment variable $${name}: ${JSON.stringify(value)}. Set it to a decimal integer such as \"42\" or \"-42\".`","+    );","+  }","+  return +value;","+}","+","+/** Read a case-insensitive true/false value or an exact 1/0 value. */","+export function boolish(name: string, fallback?: boolean | null): boolean {","+  const value = string(name, fallback == null ? undefined : '' + fallback);","+  const lower = value.toLowerCase();","+  if (lower === 'true' || value === '1') return true;","+  if (lower === 'false' || value === '0') return false;","+  throw new Error(","+    `Invalid value for environment variable $${name}: ${JSON.stringify(value)}. Set it to \"true\", \"false\", \"1\", or \"0\" (case-insensitive).`","+  );","+}"],"additions":31,"deletions":0,"truncated":false},{"path":"packages/@expo/env/src/index.ts","lines":["@@ -1,12 +1,14 @@"," import chalk from 'chalk';","-import { boolish } from 'getenv';"," import console from 'node:console';"," import fs from 'node:fs';"," import path from 'node:path';"," "," import { isIgnoredEnvKey, isLocalEnvKey, isUnsafeAllowedEnvKey } from './constants';","+import { boolish } from './getenv';"," import { parse, expand, type EnvOutput } from './parse';"," ","+export { boolish, int, string } from './getenv';","+"," const debug = require('debug')('expo:env') as typeof console.log;"," "," type EnvBackupStore = WeakMap<EnvOutput, Map<string, string | undefined>>;"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/@expo/fingerprint/cli/src/cli.ts","lines":["@@ -1,8 +1,8 @@"," #!/usr/bin/env node","+import { boolish } from '@expo/env';"," import arg from 'arg';"," import chalk from 'chalk';"," import Debug from 'debug';","-import { boolish } from 'getenv';"," "," import { runLegacyCLIAsync 