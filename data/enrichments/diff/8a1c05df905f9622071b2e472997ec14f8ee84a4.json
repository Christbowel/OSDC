{"id":"8a1c05df905f9622071b2e472997ec14f8ee84a4","axis":"silent","repo":"dotnet/runtime","sha":"8a1c05df905f9622071b2e472997ec14f8ee84a4","parsed":{"files":[{"path":"src/mono/browser/runtime/appsettings.ts","lines":["@@ -0,0 +1,29 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+type AppSettingsConfig = {","+    appsettings?: string[];","+    applicationEnvironment?: string;","+};","+","+export type AppSettingsFileSystem = {","+    readFile(path: string): Uint8Array;","+};","+","+export function getAppSettingsFiles (config: AppSettingsConfig): string[] {","+    const files = config.appsettings?.map(url => url.substring(url.lastIndexOf(\"/\") + 1));","+    return [\"appsettings.json\", `appsettings.${config.applicationEnvironment}.json`]","+        .filter(file => files?.includes(file));","+}","+","+export function getAppSettingsBytes (fs: AppSettingsFileSystem, fileName: string): Uint8Array | undefined {","+    try {","+        return fs.readFile(fileName);","+    } catch (error) {","+        const errnoNoEntry = 44; // ENOENT in Emscripten's errno ABI.","+        if (typeof error === \"object\" && error !== null && \"errno\" in error && error.errno === errnoNoEntry) {","+            return undefined;","+        }","+        throw error;","+    }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"src/mono/browser/runtime/exports-internal.ts","lines":["@@ -22,11 +22,15 @@ import { forceDisposeProxies, get_proxy_counts } from \"./gc-handles\";"," import { mono_wasm_get_func_id_to_name_mappings } from \"./logging\";"," import { monoStringToStringUnsafe } from \"./strings\";"," import { mono_wasm_bind_cs_function } from \"./invoke-cs\";","+import { getAppSettingsFiles, getAppSettingsBytes } from \"./appsettings\";"," "," import { mono_wasm_dump_threads } from \"./pthreads\";"," "," export function export_internal (): any {","     return {","+        getAp