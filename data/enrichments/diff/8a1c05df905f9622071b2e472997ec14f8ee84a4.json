 [InlineData(true, true, false, true, null)]","+    [InlineData(false, false, false, true, \"legacy\")]","+    [InlineData(false, false, false, false, \"memory\")]","+    [InlineData(false, false, false, false, \"cache\")]","+    [InlineData(false, false, false, false, \"null\")]","+    [InlineData(false, false, false, false, \"response\")]","+    [InlineData(false, false, false, false, \"url\")]","+    [InlineData(false, false, false, false, \"empty-file\")]","+    [InlineData(false, false, false, false, \"no-settings\")]","+    public async Task AppSettingsWithoutFilesystem(bool publish, bool includeVfsFiles, bool forceVfs, bool expectedVfs, string? mode)","+    {","+        Configuration config = Configuration.Debug;","+        ProjectInfo info = CopyTestAsset(config, aot: false, TestAsset.WasmBasicTestApp, \"AppSettingsMemoryTest\",","+            insertAtEnd: \"\"\"","+                <Target Name=\"_ReportAppSettingsFilesystemUsage\"","+                        AfterTargets=\"ComputeWasmVfs;_WriteWasmPublishBootJsonPropertyStamp\">","+                  <Message Importance=\"High\" Text=\"Appsettings filesystem usage: $(_WasmFilesystemUsageDetected)\" />","+                </Target>","+                \"\"\");","+        if (!includeVfsFiles)","+            AddItemsPropertiesToProject(info.ProjectFilePath, extraItems: \"\"\"<WasmFilesToIncludeInFileSystem Remove=\"@(WasmFilesToIncludeInFileSystem)\" />\"\"\");","+        if (mode == \"empty-file\")","+            File.WriteAllBytes(Path.Combine(Path.GetDirectoryName(info.ProjectFilePath)!, \"wwwroot\", \"appsettings.Empty.json\"), Array.Empty<byte>());","+        if (forceVfs && !includeVfsFiles)","+        {","+            if (publish)","+                PublishProject(info, config, new PublishOptions(ExtraMSBuildArgs: \"-p:_WasmFilesystemUsageDetected=false -p:PublishTrimmed=false\"));","+            else","+                BuildProject(info, config, new BuildOptions(ExtraMSBuildArgs: \"-p:_WasmFilesystemUsageDetected=false\"));","+        }","+        string args = mode == \"default\" ? string.Empty : $\"-p:_WasmFilesystemUsageDetected={forceVfs.ToString().ToLowerInvariant()}\";","+        if (publish && forceVfs && !includeVfsFiles)","+            args += \" -p:PublishTrimmed=false\";","+        (string _, string buildOutput) = publish","+            ? PublishProject(info, config, new PublishOptions(ExtraMSBuildArgs: args, UseCache: false))","+            : BuildProject(info, config, new BuildOptions(ExtraMSBuildArgs: args, UseCache: false));","+        MatchCollection detection = Regex.Matches(buildOutput, @\"Appsettings filesystem usage: (true|false)\");","+        Assert.NotEmpty(detection);","+        string filesystemUsage = detection[detection.Count - 1].Groups[1].Value;","+        Assert.Equal((includeVfsFiles || forceVfs || mode == \"default\").ToString().ToLowerInvariant(), filesystemUsage);","+","+        BrowserRunOptions options = new(config, TestScenario: \"AppSettingsTest\",","+            BrowserQueryString: new NameValueCollection {","+                { \"settingsVfs\", expectedVfs.ToString().ToLowerInvariant() },","+                { \"legacySettings\", (mode == \"legacy\").ToString().ToLowerInvariant() },","+                { \"settingsDownload\", mode is \"memory\" or \"cache\" ? mode : null },","+                { \"settingsLoader\", mode is \"null\" or \"response\" or \"url\" ? mode : null },","+                { \"applicationEnvironment\", mode == \"empty-file\" ? \"Empty\" : null },","+                { \"noSettings\", mode == \"no-settings\" ? \"true\" : null }","+            });","+        RunResult result = publish","+            ? await RunForPublishWithWebServer(options)","+            : await RunForBuildWithDotnetRun(options);","+        Assert.Contains(result.TestOutput, line => line.Contains($\"'/appsettings.json' exists '{expectedVfs}'\"));","+        Assert.Contains(result.TestOutput, line => line.Contains(\"Appsettings byte API passed\"));","+        Assert.Contains(result.TestOutput, line => line.Contains(\"Appsettings file API passed\"));","+    }","+","     public static IEnumerable<object?[]> LoadAppSettingsBasedOnApplicationEnvironmentData()","     {","         // Defaults","@@ -46,6 +113,7 @@ public AppSettingsTests(ITestOutputHelper output, SharedBuildPerTestClassFixture","             yield return new object?[] { false, \"FromMSBuild\", \"Production\", \"Production\" };"," ","         yield return new object?[] { true, \"FromMSBuild\", \"Development\", \"Development\" };","+        yield return new object?[] { true, null, \"Staging\", \"Staging\" };","     }"," ","     [Theory, TestCategory(\"bundler-friendly\")]","@@ -74,5 +142,11 @@ public async Task LoadAppSettingsBasedOnApplicationEnvironment(bool publish, str","         Assert.Contains(result.TestOutput, m => m.Contains($\"'{browserVirtualAppBase}appsettings.json' exists 'True'\"));","         Assert.Contains(result.TestOutput, m => m.Contains($\"'{browserVirtualAppBase}appsettings.Development.json' exists '{expectedApplicationEnvironment == \"Development\"}'\"));","         Assert.Contains(result.TestOutput, m => m.Contains($\"'{browserVirtualAppBase}appsettings.Production.json' exists '{expectedApplicationEnvironment == \"Production\"}'\"));","+        string expectedFiles = expectedApplicationEnvironment is \"Development\" or \"Production\"","+            ? $\"appsettings.json,appsettings.{expectedApplicationEnvironment}.json\"","+            : \"appsettings.json\";","+        Assert.Contains(result.TestOutput, m => m.Contains($\"Appsettings files: {expectedFiles}\"));","+        Assert.Contains(result.TestOutput, m => m.Contains(\"Appsettings byte API passed\"));","+        Assert.Contains(result.TestOutput, m => m.Contains(\"Appsettings file API passed\"));","     }"," }"],"additions":74,"deletions":0,"truncated":false},{"path":"src/mono/wasm/Wasm.Build.Tests/Blazor/AppsettingsTests.cs","lines":["@@ -55,3 +55,34 @@ await RunForBuildWithDotnetRun(new BlazorRunOptions(","         Assert.True(contentChecked, \"Content of '/appsettings.json' is not matched\");","     }"," }","+","+public class CurrentRuntimeAppsettingsTests : BlazorWasmTestBase","+{","+    public CurrentRuntimeAppsettingsTests(ITestOutputHelper output, SharedBuildPerTestClassFixture buildContext)","+        : base(output, buildContext)","+    {","+        _enablePerTestCleanup = true;","+    }","+","+    [Fact]","+    public async Task InternalApi()","+    {","+        Configuration config = Configuration.Debug;","+        ProjectInfo info = CopyTestAsset(config, aot: false, TestAsset.BlazorBasicTestApp, \"appsettings\");","+        string projectDirectory = Path.GetDirectoryName(info.ProjectFilePath)!;","+        string settings = $\"{{ \\\"Id\\\": \\\"{info.ProjectName}\\\" }}\";","+        File.WriteAllText(Path.Combine(projectDirectory, \"wwwroot\", \"appsettings.json\"), settings);","+        File.WriteAllText(Path.Combine(projectDirectory, \"wwwroot\", \"appsettings.Development.json\"), \"{}\");","+        File.WriteAllText(Path.Combine(projectDirectory, \"wwwroot\", \"appsettings.Production.json\"), \"{}\");","+","+        BlazorBuild(info, config);","+        await RunForBuildWithDotnetRun(new BlazorRunOptions(","+            config,","+            Test: async page => {","+                string[] files = await page.EvaluateAsync<string[]>(\"() => getDotnetRuntime(0).INTERNAL.getAppSettingsFiles()\");","+                Assert.Equal(new[] { \"appsettings.json\", \"appsettings.Development.json\" }, files);","+                string content = await page.EvaluateAsync<string>(\"() => new TextDecoder().decode(getDotnetRuntime(0).INTERNAL.getAppSettingsBytes('appsettings.json'))\");","+                Assert.Equal(settings, content);","+            }));","+    }","+}"],"additions":31,"deletions":0,"truncated":false},{"path":"src/mono/wasm/Wasm.Build.Tests/GenerateWasmBootJsonTests.cs","lines":["@@ -2,10 +2,14 @@"," // The .NET Foundation licenses this file to you under the MIT license."," "," using System;","+using System.Collections;"," using System.Collections.Generic;"," using System.IO;","+using System.Linq;"," using System.Reflection;"," using System.Text.Json;","+using Microsoft.Build.Framework;","+using Microsoft.Build.Utilities;"," using Microsoft.NET.Sdk.WebAssembly;"," using Xunit;"," ","@@ -16,6 +20,87 @@ namespace Wasm.Build.Tests;","     [TestCategory(\"no-workload\")]","     public class GenerateWasmBootJsonTests","     {","+        [Theory]","+        [InlineData(\"v12.0\", false, false, true)]","+        [InlineData(\"v12.0\", false, true, true)]","+        [InlineData(\"v13.0\", false, false, true)]","+        [InlineData(\"v12.0\", true, false, false)]","+        [InlineData(\"v11.0\", false, false, false)]","+        [InlineData(\"v11.0\", false, true, false)]","+        [InlineData(\"v11.0\", true, false, false)]","+        [InlineData(\"v10.0\", false, false, false)]","+        [InlineData(\"v9.0\", true, false, false)]","+        public void AppSettingsManifestVersion(string framework, bool mono, bool filesystemUsage, bool expectAssets)","+        {","+            using var dir = new TempDirectory();","+            string path = Path.Combine(dir.Path, \"boot.json\");","+            var task = new GenerateWasmBootJson","+            {","+                BuildEngine = new TestBuildEngine(),","+                AssemblyPath = typeof(GenerateWasmBootJsonTests).Assembly.Location,","+                Resources = [],","+                Endpoints = [],","+                ConfigurationFiles = [new TaskItem(\"appsettings.json\")],","+                TargetFrameworkVersion = framework,","+                UseMonoRuntime = mono.ToString(),","+                FilesystemUsageDetected = filesystemUsage,","+                OutputPath = path","+            };","+            Assert.True(task.Execute());","+            using JsonDocument document = JsonDocument.Parse(File.ReadAllText(path));","+            JsonElement root = document.RootElement;","+            if (expectAssets)","+            {","+                Assert.False(root.TryGetProperty(\"appsettings\", out _));","+                JsonElement asset = Assert.Single(root.GetProperty(\"resources\").GetProperty(\"appsettings\").EnumerateArray());","+                Assert.Equal(\"../appsettings.json\", asset.GetProperty(\"name\").GetString());","+                Assert.Equal(\"appsettings.json\", asset.GetProperty(\"virtualPath\").GetString());","+                Assert.Equal(filesystemUsage, asset.GetProperty(\"loadIntoVfs\").GetBoolean());","+            }","+            else","+            {","+                Assert.Equal(\"../appsettings.json\", Assert.Single(root.GetProperty(\"appsettings\").EnumerateArray()).GetString());","+                Assert.False(root.GetProperty(\"resources\").TryGetProperty(\"appsettings\", out _));","+            }","+        }","+","+        [Theory]","+        [InlineData(true, false, false)]","+        [InlineData(true, true, false)]","+        [InlineData(true, false, true)]","+        [InlineData(true, true, true)]","+        [InlineData(false, false, false)]","+        [InlineData(false, true, true)]","+        public void AppSettingsAssets(bool useAssets, bool filesystemUsage, bool bundlerFriendly)","+        {","+            string[] names = [\"../appsettings.json\", \"../appsettings.Development.json\"];","+            var config = new BootJsonData { appsettings = names.ToList() };","+            var task = new GenerateWasmBootJson();","+            var helper = new BootJsonBuilderHelper(task.Log, \"0\", false, false, new Version(12, 0), false);","+            string imports = helper.TransformResourcesToAssets(config, bundlerFriendly,","+                useAppSettingsAssets: useAssets, filesystemUsageDetected: filesystemUsage);","+            var assets = Assert.IsType<AssetsData>(config.resources);","+            if (useAssets)","+            {","+                Assert.Null(config.appsettings);","+                Assert.Equal(names, assets.appsettings.Select(asset => asset.name));","+                Assert.Equal(new[] { \"appsettings.json\", \"appsettings.Development.json\" }, assets.appsettings.Select(asset => asset.virtualPath));","+                Assert.All(assets.appsettings, asset => {","+                    Assert.Equal(filesystemUsage, asset.loadIntoVfs);","+                    Assert.Equal(\"no-cache\", asset.cache);","+                    Assert.Equal(bundlerFriendly, asset.resolvedUrl is not null);","+                });","+            }","+            else","+            {","+                Assert.Null(assets.appsettings);","+                Assert.NotNull(config.appsettings);","+                if (!bundlerFriendly)","+                    Assert.Equal(names, config.appsettings);","+            }","+            Assert.Equal(bundlerFriendly, imports.Contains(\"import \"));","+        }","+","         [Fact]","         public void ReadRuntimeConfigFiles_NullMainConfigPath_ReturnsNull()","         {","@@ -152,6 +237,20 @@ public void ReadRuntimeConfigFiles_DevConfigEmptyProperties_DoesNotAlterResult()","             Assert.Equal(\"value1\", result.runtimeOptions.configProperties[\"key1\"].ToString());","         }"," ","+        private sealed class TestBuildEngine : IBuildEngine","+        {","+            public bool ContinueOnError => false;","+            public int LineNumberOfTaskNode => 0;","+            public int ColumnNumberOfTaskNode => 0;","+            public string ProjectFileOfTaskNode => string.Empty;","+            public void LogErrorEvent(BuildErrorEventArgs e) => throw new InvalidOperationException(e.Message);","+            public void LogWarningEvent(BuildWarningEventArgs e) => throw new InvalidOperationException(e.Message);","+            public void LogMessageEvent(BuildMessageEventArgs e) { }","+            public void LogCustomEvent(CustomBuildEventArgs e) { }","+            public bool BuildProjectFile(string projectFileName, string[] targetNames, IDictionary globalProperties, IDictionary targetOutputs)","+                => throw new NotSupportedException();","+        }","+","         private static string WriteRuntimeConfig(string dir, string fileName, Dictionary<string, string>? configProperties)","         {","             string path = Path.Combine(dir, fileName);"],"additions":99,"deletions":0,"truncated":false},{"path":"src/mono/wasm/Wasm.Build.Tests/README.md","lines":["@@ -67,6 +67,54 @@ For this, the builds get cached using `ProjectInfo` as the key."," - `SHOW_BUILD_OUTPUT` - will show the build output to the console"," - `SKIP_PROJECT_CLEANUP` - won't remove the temporary project directories generated for the tests"," ","+## Appsettings coverage","+","+`AppSettingsTests` covers environment selection for build and publish, including","+MSBuild and JavaScript overrides. It also exercises the internal appsettings APIs","+on both CoreCLR and Mono:","+","+- `INTERNAL.getAppSettingsFiles()` returns the manifest-listed VFS filenames for","+  the resolved application environment, with base settings before","+  environment-specific settings and no duplicates.","+- On CoreCLR, `INTERNAL.getAppSettingsBytes(fileName)` returns the downloaded","+  `Uint8Array` retained in JavaScript memory, or `undefined` for an unloaded file.","+  The returned array must be treated as read-only. Managed interop copies it into","+  a managed byte array. Later VFS writes do not change the retained bytes.","+- On Mono, byte access continues to read the current VFS contents.","+","+For CoreCLR applications targeting .NET 12 or later, the manifest contains","+`resources.appsettings` assets with a `loadIntoVfs` flag.","+`_WasmFilesystemUsageDetected` defaults to `true`, preserving existing VFS","+placement, including Blazor versions that read configuration through managed file","+APIs. Explicitly setting it to `false` makes settings available only through the","+internal APIs, unless `WasmFilesToIncludeInFileSystem` items exist: those force the","+flag to `true`. The default can become `false` once IL trimming provides better","+filesystem usage detection. This does not disable filesystem support for other uses.","+","+Older target frameworks and Mono retain the top-level appsettings list.","+CoreCLR also accepts legacy manifests and continues installing those settings","+into VFS while retaining their downloaded bytes.","+","+`AppSettingsWithoutFilesystem` runs in the CoreCLR no-workload lane. Its .NET 12","+browser fixture consumes the generated asset schema and checks the","+filesystem-detection value reported by the real build/publish targets.","+It covers both placement modes, explicit overrides, custom resource loaders, and","+download-before-create. The legacy case converts the generated asset list to","+the old manifest representation before startup.","+","+Manifest-generation theories invoke the task directly to verify .NET 12+ assets,","+the .NET 11 compatibility boundary, and unchanged Mono output. CoreCLR browser","+tests additionally cover .NET 12 project-to-browser manifest generation and","+loading end to end.","+","+The flag-only incremental publish case disables trimming to isolate filesystem","+detection from incremental trimmed assembly staging; fresh-publish cases","+retain trimming. `Blazor.AppsettingsTests` checks that default settings remain","+available through managed VFS access on the template's target framework.","+`Blazor.CurrentRuntimeAppsettingsTests` checks the internal APIs against the","+locally built current runtime, not a released runtime from an older template.","+Managed JSON parsing remains the consumer's responsibility.","+"," ## How to add tests"," "," Blazor specific tests should be located in `Blazor` directory. New test classes are picked up automatically - the per-class Helix work item list is generated from the built test assembly, so there is no list to update. Annotate classes and test methods that only apply to one runtime with `[TestCategory(\"mono\")]` or `[TestCategory(\"coreclr\")]`, and they will be left out of the other flavor's runs. If you are adding a new test to an existing class, make sure it does not prolong the execution time significantly. Tests run on parallel on CI and having one class running much longer than the average prolongs the total execution time."],"additions":48,"deletions":0,"truncated":false},{"path":"src/mono/wasm/testassets/WasmBasicTestApp/App/AppSettingsTest.cs","lines":["@@ -3,13 +3,14 @@"," "," using System;"," using System.IO;","-using System.Text.Json;"," using System.Runtime.InteropServices.JavaScript;"," ","+#nullable enable","+"," public partial class AppSettingsTest"," {","     [JSExport]","-    public static void Run()","+    public static void Run(bool expectVfs, bool inMemory)","     {","         const string browserVirtualAppBase = \"/\"; // keep in sync other places that define browserVirtualAppBase"," ","@@ -17,8 +18,59 @@ public static void Run()","         PrintFileExistence(browserVirtualAppBase + \"appsettings.json\");","         PrintFileExistence(browserVirtualAppBase + \"appsettings.Development.json\");","         PrintFileExistence(browserVirtualAppBase + \"appsettings.Production.json\");","+","+        string[] files = GetAppSettingsFiles();","+        TestOutput.WriteLine($\"Appsettings files: {string.Join(\",\", files)}\");","+        foreach (string file in files)","+        {","+            byte[]? bytes = GetAppSettingsBytes(file);","+            if (bytes is null || (expectVfs && !bytes.AsSpan().SequenceEqual(File.ReadAllBytes(file))))","+                throw new InvalidOperationException($\"Unexpected appsettings bytes for '{file}'.\");","+            if (file == \"appsettings.Empty.json\" && bytes.Length != 0)","+                throw new InvalidOperationException(\"Downloaded empty settings should return an empty array.\");","+        }","+","+        if (GetAppSettingsBytes(\"appsettings.Missing.json\") is not null)","+            throw new InvalidOperationException(\"Missing appsettings should not return bytes.\");","+","+        File.WriteAllBytes(\"appsettings.VfsOnly.json\", Array.Empty<byte>());","+        if (!inMemory && GetAppSettingsBytes(\"appsettings.VfsOnly.json\") is not { Length: 0 })","+            throw new InvalidOperationException(\"Empty appsettings should return an empty array.\");","+        if (inMemory && GetAppSettingsBytes(\"appsettings.VfsOnly.json\") is not null)","+            throw new InvalidOperationException(\"The appsettings map should not read arbitrary VFS files.\");","+","+        byte[]? originalBytes = GetAppSettingsBytes(\"appsettings.json\");","+        File.WriteAllBytes(\"appsettings.json\", new byte[] { 1, 2, 3 });","+        byte[]? expectedBytes = inMemory ? originalBytes : new byte[] { 1, 2, 3 };","+        if (!GetAppSettingsBytes(\"appsettings.json\").AsSpan().SequenceEqual(expectedBytes))","+            throw new InvalidOperationException(\"Unexpected appsettings bytes after a VFS update.\");","+","+        if (inMemory)","+        {","+            if (GetAppSettingsBytes(\"/\") is not null)","+                throw new InvalidOperationException(\"Unknown appsettings should not return bytes.\");","+        }","+        else","+        {","+            try","+            {","+                GetAppSettingsBytes(\"/\");","+                throw new InvalidOperationException(\"Reading a directory should fail.\");","+            }","+            catch (JSException)","+            {","+            }","+        }","+","+        TestOutput.WriteLine(\"Appsettings byte API passed\");","     }"," ","+    [JSImport(\"INTERNAL.getAppSettingsFiles\")]","+    private static partial string[] GetAppSettingsFiles();","+","+    [JSImport(\"INTERNAL.getAppSettingsBytes\")]","+    private static partial byte[]? GetAppSettingsBytes(string fileName);","+","     // Synchronize with AppSettingsTest