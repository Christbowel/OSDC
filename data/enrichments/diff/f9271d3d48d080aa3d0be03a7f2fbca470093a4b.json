{"id":"f9271d3d48d080aa3d0be03a7f2fbca470093a4b","axis":"silent","repo":"pnpm/pnpm","sha":"f9271d3d48d080aa3d0be03a7f2fbca470093a4b","parsed":{"files":[{"path":".changeset/verify-deps-local-directory-manifest.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.status\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+With `verifyDepsBeforeRun`, `pnpm run` and `pnpm exec` now report dependencies as out of date after a dependency is added to the `package.json` of a local directory dependency, such as `\"lib\": \"file:../lib\"`. Before, the command ran without the new dependency installed."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_oracle.rs","lines":["@@ -16,6 +16,7 @@"," //! date without installing again."," "," pub use _utils::*;","+pub use inputs::Input;"," "," use crate::_utils;"," ","@@ -98,6 +99,8 @@ struct Scenario {","     oracle_runs: usize,","     /// A project depends on a local tarball or directory.","     local_file_dependency: bool,","+    /// A project depends on a local directory that is no workspace project.","+    local_directory_dependency: bool,"," }"," "," /// What an install leaves behind that a user can observe: where every","@@ -134,8 +137,14 @@ impl Scenario {","         let fixture = WorkspaceFixture::new();","         fixture.append_workspace_yaml(&layout.workspace_yaml());","         fixture.write_root_manifest(\"root\", ManifestDeps::default());","-        let scenario =","-            Self { driver, fixture, layout, oracle_runs: 0, local_file_dependency: false };","+        let scenario = Self {","+            driver,","+            fixture,","+            layout,","+            oracle_runs: 0,","+            local_file_dependency: false,","+            local_directory_dependency: false,","+        };","         scenario.set_dependencies(\"a\", &json!({ \"@pnpm.e2e/foo\": \"100.0.0\" }));","         scenario.write_manifest(","             \"b\",","@@ -231,8 +240,12 @@ impl Scenario {","     /// `file:` snapshot, which the install fast path does not compare, so both","     /// CLIs refuse it (pnpm/tasks#145). With a shared lockfile, v11 also","     /// refuses the install fast path to refresh injected copies (pnpm/pnpm#15679).","-    /// v11 refuses it over any local file dependency, unchanged or not.","+    /// v11 refuses it over any local file dependency, unchanged or not, and","+    /// both CLIs over a local directory dependency.","     fn offers_next_install_fast_path(&self) -> bool {","+        if self.local_directory_dependency {","+            return false;","+        }","         if self.local_file_dependency && self.next_is_v11() {","             return false;","         }","@@ -1216,8 +1229,8 @@ fn a_scope_route_moved(layout: Layout) {","     }"," }"," ","-/// Edits to `b` that change none of its dependencies, each kept by the next.","-fn manifest_edits_that_change_no_dependency(layout: Layout) {","+/// Edits to `b`, its dependencies first, each kept by the next.","+fn manifest_fields_edited(layout: Layout) {","     let mut scenario = Scenario::new(layout);","     scenario.install(&[]);","     let mut manifest = json!({","@@ -1225,6 +1238,7 @@ fn manifest_edits_that_change_no_dependency(layout: Layout) {","         \"devDependencies\": { \"@pnpm.e2e/bar\": \"100.0.0\" },","     });","     for (field, value, allowed) in [","+        (\"dependencies\", json!({ \"@pnpm.e2e/foo\": \"100.0.0\" }), AllowedRefusal::None),","         (\"description\", json!(\"edited\"), AllowedRefusal::None),","         (\"scripts\", json!({ \"build\": r#\"node -e \"\"\"# }), AllowedRefusal::None),","         (\"version\", json!(\"1.0.1\"), AllowedRefusal::None),","@@ -1235,6 +1249,76 @@ fn manifest_edits_that_change_no_dependency(layout: Layout) {","     }"," }"," ","+/// A local directory dependency of `c` that is no workspace project, then a","+/// dependency added to its manifest.","+fn a_local_directory_edited(layout: Layout) {","+    let mut scenario = Scenario::new(layout);","+    let directory = scenario.workspace().join(\"vendor/local-dir\");","+    let write_manifest = |dependencies: &Value| {","+        let manifest =","+            json!({ \"name\": \"local-dir\", \"version\": \"1.0.0\", \"dependencies\": dependencies });","+        fs::write(directory.join(\"package.json\"), manifest.to_string())","+            .expect(\"write the local directory's manifest\");","+    };","+    fs::create_dir_all(&directory).expect(\"create the local directory\");","+    write_manifest(&json!({}));","+    scenario.set_dependencies(","+        \"c\",","+        &json!({","+            \"a\": \"workspace:*\",","+            \"@pnpm.e2e/bar\": \"100.0.0\",","+            \"local-dir\": \"file:../../vendor/local-dir\",","+        }),","+    );","+    scenario.install(&[]);","+    scenario.local_file_dependency = true;","+    scenario.local_directory_dependency = true;","+    scenario.check_gates();","+    write_manifest(&json!({ \"@pnpm.e2e/foo\": \"100.0.0\" }));","+    scenario.check_gates_after_a_workspace_input_edit();","+}","+","+/// A comment added to the file at `relative`, which changes no setting.","+fn a_comment_added(layout: Layout, relative: &str) {","+    let mut scenario = Scenario::new(layout);","+    scenario.install(&[]);","+    let path = scenario.workspace().join(relative);","+    let mut text = fs::read_to_string(&path).expect(\"read the file\");","+    text.push_str(\"# a comment\\n\");","+    fs::write(&path, text).expect(\"write the file\");","+    scenario.check_gates();","+}","+","+fn a_comment_added_to_the_npmrc(layout: Layout) {","+    a_comment_added(layout, \".npmrc\");","+}","+","+fn a_comment_added_to_the_workspace_manifest(layout: Layout) {","+    a_comment_added(layout, \"pnpm-workspace.yaml\");","+}","+","+fn a_project_added(layout: Layout) {","+    let mut scenario = Scenario::new(layout);","+    scenario.install(&[]);","+    scenario.set_dependencies(\"d\", &json!({ \"@pnpm.e2e/foo\": \"100.0.0\" }));","+    scenario.check_gates_after_a_workspace_input_edit();","+}","+","+const fn edits_of(input: Input) -> fn(Layout) {","+    match input {","+        Input::Manifest => manifest_fields_edited,","+        Input::Lockfile => a_lockfile_swap_that_keeps_an_older_mtime,","+        Input::Pnpmfile => a_pnpmfile_hook_edited,","+        Input::PatchFile => a_patch_added_edited_and_removed,","+        Input::LocalTarball => a_local_tarball_a_hook_adds_then_replaced,","+        Input::LocalDirectory => a_local_directory_edited,","+        Input::Npmrc => a_comment_added_to_the_npmrc,","+        Input::WorkspaceManifest => a_comment_added_to_the_workspace_manifest,","+        Input::ProjectDirectories => a_project_added,","+    }","+}","+","+mod inputs;"," mod lone_project;"," "," macro_rules! matrix {","@@ -1254,22 +1338,29 @@ macro_rules! matrix {","                     filtered_commands_for_every_project_after_a_pull,","                     rewritten_but_unchanged_inputs_keep_the_fast_path,","                     a_manifest_edit_that_keeps_its_mtime,","-                    a_lockfile_swap_that_keeps_an_older_mtime,","                     an_unfiltered_command_after_a_filtered_install_of_another_project,","                     a_root_command_after_an_edit_in_a_project,","                     a_state_without_validation_records,","                     a_production_install_then_every_group,","                     a_workspace_without_a_root_manifest,","                     overrides_edited,","-                    a_pnpmfile_hook_edited,","                     a_pnpmfile_hook_rewriting_a_project_specifier,","                     a_package_extension_of_a_project_then_an_edit,","-                    a_local_tarball_a_hook_adds_then_replaced,","-                    a_patch_added_edited_and_removed,","                     dedupe_peers_toggled,","                     a_workspace_bin_renamed,","                     a_scope_route_moved,","-                    manifest_edits_that_change_no_dependency,","+                );","+","+                matrix!(@inputs","+                    an_edit_to_a_manifest: Manifest,","+                    an_edit_to_a_lockfile: Lockfile,","+                    an_edit_to_a_pnpmfile: Pnpmfile,","+                    an_edit_to_a_patch_file: PatchFile,","+                    an_edit_to_a_local_tarball: LocalTarball,","+                    an_edit_to_a_local_directory: LocalDirectory,","+                    an_edit_to_the_npmrc: Npmrc,","+                    an_edit_to_the_workspace_manifest: WorkspaceManifest,","+                    an_edit_to_the_project_directories: ProjectDirectories,","                 );","             }","         )*","@@ -1282,6 +1373,19 @@ macro_rules! matrix {","             }","         )*","     };","+    (@inputs $($test:ident: $input:ident,)*) => {","+        // Every input has a test: the match fails to compile without one.","+        const _: fn(super::Input) = |input| match input {","+            $(super::Input::$input => {})*","+        };","+","+        $(","+            #[test]","+            fn $test() {","+                super::run_across_drivers(LAYOUT, super::edits_of(super::Input::$input));","+            }","+        )*","+    };"," }"," "," matrix! {"],"additions":114,"deletions":10,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_oracle/inputs.rs","lines":["@@ -0,0 +1,28 @@","+//! The kinds of file a full install reads in the workspace outside","+//! `node_modules`. `repeat_install_read_set` sorts every file a full install","+//! opens into one of them, and the oracle runs an edit scenario for each.","+","+/// A kind of file a full install reads in the workspace outside","+/// `node_modules`.","+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, strum::EnumIter)]","+pub enum Input {","+    /// A project's manifest, recorded in `manifest_files`.","+    Manifest,","+    /// A lockfile, recorded in `files`.","+    Lockfile,","+    /// A pnpmfile, recorded in `pnpmfiles`.","+    Pnpmfile,","+    /// A patch file `patchedDependencies` names, recorded in `files`.","+    PatchFile,","+    /// A local tarball dependency, recorded in `local_dependencies`.","+    LocalTarball,","+    /// A file in a local directory dependency that is not a workspace","+    /// project. `local_dependencies` records the directory.","+    LocalDirectory,","+    /// `.npmrc`.","+    Npmrc,","+    /// `pnpm-workspace.yaml`.","+    WorkspaceManifest,","+    /// A directory project discovery lists.","+    ProjectDirectories,","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_read_set.rs","lines":["@@ -5,21 +5,28 @@"," //! classified here with the reason it needs no record. A file a new input"," //! makes the install read fails the test until it is one or the other."," //!","+//! Each file is of one [`Input`] kind, and every kind must be observed. A new","+//! kind needs an edit scenario in `repeat_install_oracle` to compile.","+//!"," //! The install observed is the full one that runs from the state the previous"," //! install left, the one the fast path replaces. inotify observes its opens:"," //! no filesystem seam reaches every read the install makes."," ","-use crate::_utils::{inotify::record_opens, pacquet_in};","+use crate::{","+    _utils::{inotify::record_opens, pacquet_in},","+    repeat_install_oracle::Input,","+};"," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"," use pnpm_testing_utils::bin::{AddMockedRegistry, CommandTempCwd};"," use pnpm_workspace_state::{WorkspaceState, load_workspace_state};"," use serde_json::{Value, json};"," use std::{","-    collections::BTreeSet,","+    collections::{BTreeMap, BTreeSet},","     fs,","     path::{Path, PathBuf},"," };","+use strum::IntoEnumIterator as _;"," "," const CONFIG: &str = \"the config loader reads it on every command, and \\","     `settings_classification` classifies each setting it holds\";","@@ -27,10 +34,13 @@ const DISCOVERY: &str = \"project discovery lists it, and the fast path compares","     it finds with the recorded ones\";"," "," /// Every path a full install opens that the workspace state does not record,","-/// relative to the workspace, with the reason the fast path needs no record","-/// of it.","-const CLASSIFICATION: &[(&str, &str)] =","-    &[(\".npmrc\", CONFIG), (\"pnpm-workspace.yaml\", CONFIG), (\"packages\", DISCOVERY)];","+/// relative to the workspace, with its kind and the reason the fast path needs","+/// no record of it.","+const CLASSIFICATION: &[(&str, Input, &str)] = &[","+    (\".npmrc\", Input::Npmrc, CONFIG),","+    (\"pnpm-workspace.yaml\", Input::WorkspaceManifest, CONFIG),","+    (\"packages\", Input::ProjectDirectories, DISCOVERY),","+];"," "," /// A workspace that exercises some of the inputs of an install. Its root"," /// `package.json` is a private manifest unless `files` writes one.","@@ -179,7 +189,7 @@ fn source_dirs(dir: &Path) -> Vec<PathBuf> {"," /// lockfiles has a state in each project."," #[derive(Default)]"," struct Records {","-    files: BTreeSet<PathBuf>,","+    files: BTreeMap<PathBuf, Input>,","     /// The recorded local directories that are not workspace projects. The","     /// fast path counts such a directory as changed, so a file in it needs no","     /// record of its own.","@@ -205,16 +215,26 @@ impl Records {","             .map(|(importer, file)| root.join(importer).join(&file.file_name));","         let local = validation.local_dependencies.values();","         let projects = &state.projects;","+        let tarballs: BTreeSet<&String> = local","+            .clone()","+            .flat_map(|deps| &deps.tarballs)","+            .collect();","+        let shared_files = validation.files","+            .keys()","+            .filter(|path| !state.pnpmfiles.contains(path) && !tarballs.contains(path))","+            .map(|path| (PathBuf::from(path), shared_file_input(Path::new(path))));","         self.files.extend(","-            validation.files","-                .keys()","-                .chain(&state.pnpmfiles)","-                .map(PathBuf::from)","-                .chain(manifests)","+            shared_files","+                .chain(","+                    state.pnpmfiles","+                        .iter()","+                        .map(|path| (path.into(), Input::Pnpmfile)),","+                )","+                .chain(manifests.map(|path| (path, Input::Manifest)))","                 .chain(","-                    local","-                        .clone()","-                        .flat_map(|deps| deps.tarballs.iter().map(PathBuf::from)),","+                    tarballs","+                        .iter()","+                        .map(|path| (path.into(), Input::LocalTarball)),","                 ),","         );","         self.blocking_directories.extend(","@@ -225,17 +245,47 @@ impl Records {","         );","     }"," ","-    fn contain(&self, path: &Path) -> bool {","-        self.files.contains(path)","-            || self.blocking_directories","-                .iter()","-                .any(|dir| path.starts_with(dir))","+    /// The kind of the recorded file at `path`, if the states record it.","+    fn input_of(&self, path: &Path) -> Option<Input> {","+        self.files","+            .get(path)","+            .copied()","+            .or_else(|| {","+                self.blocking_directories","+                    .iter()","+                    .any(|dir| path.starts_with(dir))","+                    .then_some(Input::LocalDirectory)","+            })","     }"," }"," ","-/// The workspace-relative paths a full install of `fixture` opens and the","-/// workspace state does not record.","-fn unrecorded_reads(fixture: &Fixture) -> BTreeSet<String> {","+/// The kind of a file `validation.files` records besides the pnpmfiles and","+/// the local tarballs.","+fn shared_file_input(path: &Path) -> Input {","+    if path","+        .file_name()","+        .is_some_and(|name| name == \"pnpm-lock.yaml\")","+    {","+        Input::Lockfile","+    } else if path","+        .extension()","+        .is_some_and(|extension| extension == \"patch\")","+    {","+        Input::PatchFile","+    } else {","+        panic!(\"a recorded file of no known kind: {}\", path.display())","+    }","+}","+","+/// What a full install of a fixture opens: the kind of each recorded file,","+/// and the workspace-relative paths of the files the states do not record.","+#[derive(Default)]","+struct Reads {","+    recorded: BTreeSet<Input>,","+    unrecorded: BTreeSet<String>,","+}","+","+fn reads(fixture: &Fixture) -> Reads {","     let CommandTempCwd { root, workspace, npmrc_info, .. } =","         CommandTempCwd::init().add_mocked_registry();","     let AddMockedRegistry { mock_instance, .. } = npmrc_info;","@@ -256,43 +306,53 @@ fn unrecorded_reads(fixture: &Fixture) -> BTreeSet<String> {","     let opens = record_opens(&source_dirs(&workspace), || {","         install(&[(\"PNPM_CONFIG_OPTIMISTIC_REPEAT_INSTALL\", \"false\")]);","     });","-    let unrecorded = opens","-        .iter()","-        .filter(|path| !records.contain(path))","-        .map(|path| {","-            path.strip_prefix(&workspace)","-                .expect(\"a watched path is in the workspace\")","-                .to_string_lossy()","-                .into_owned()","-        })","-        .collect();","+    let mut reads = Reads::default();","+    for path in opens {","+        if let Some(input) = records.input_of(&path) {","+            reads.recorded.insert(input);","+        } else {","+            let relative =","+                path.strip_prefix(&workspace).expect(\"a watched path is in the workspace\");","+            reads.unrecorded.insert(relative.to_string_lossy().into_owned());","+        }","+    }","     drop((root, mock_instance));","-    unrecorded","+    reads"," }"," "," #[test]"," fn every_file_a_full_install_opens_is_recorded_or_classified() {","-    let classified: BTreeSet<&str> = CLASSIFICATION","+    let classified: BTreeMap<&str, Input> = CLASSIFICATION","         .iter()","-        .map(|(path, _)| *path)","+        .map(|(path, input, _)| (*path, *input))","         .collect();","     let mut seen = BTreeSet::new();","+    let mut observed = BTreeSet::new();","     let mut unclassified = Vec::new();","     for fixture in FIXTURES {","-        for path in unrecorded_reads(fixture) {","-            if !classified.contains(path.as_str()) {","-                unclassified.push(format!(\"{path} ({})\", fixture.name));","+        let reads = reads(fixture);","+        observed.extend(reads.recorded);","+        for path in reads.unrecorded {","+            match classified.get(path.as_str()) {","+                Some(input) => {","+                    observed.insert(*input);","+                }","+                None => unclassified.push(format!(\"{path} ({})\", fixture.name)),","             }","             seen.insert(path);","         }","     }","     let unused: Vec<_> = classified","-        .iter()","+        .keys()","         .filter(|path| !seen.contains(**path))","         .collect();","+    let unobserved: Vec<_> = Input::iter()","+        .filter(|input| !observed.contains(input))","+        .collect();","     assert!(","         unclassified.is_empty(),","         \"a full install opens files the workspace state does not record: {unclassified:#?}\",","     );","     assert!(unused.is_empty(), \"classified files no fixture opens: {unused:?}\");","+    assert!(unobserved.is_empty(), \"inputs no fixture reads: {unobserved:?}\");"," }"],"additions":100,"deletions":40,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/verify_deps_before_run.rs","lines":["@@ -15,7 +15,10 @@ use pnpm_testing_utils::{","     fs::bump_mtime,"," };"," use serde_json::json;","-use std::{fs, path::Path};","+use std::{","+    fs,","+    path::{Path, PathBuf},","+};"," "," fn write_manifest(workspace: &Path, marker: &Path) {","     write_named_manifest(workspace, \"verify-deps-project\", marker);","@@ -2467,3 +2470,131 @@ fn a_pinned_lockfile_dir_starts_an_install() {"," ","     drop(root);"," }","+","+/// Where [`LocalDirectoryFixture`] puts its project.","+#[derive(Clone, Copy)]","+enum ProjectLayout {","+    /// A workspace project, run with `--filter`.","+    Workspace,","+    /// A project without a workspace.","+    Standalone,","+}","+","+/// A project `app` with a dependency on the local directory `lib`, which is no","+/// workspace project. The manifest of `lib` is what the gate has to read: no","+/// validation records it.","+struct LocalDirectoryFixture {","+    root: tempfile::TempDir,","+    workspace: PathBuf,","+    /// Where the commands run: the workspace, or `app` without one.","+    cwd: PathBuf,","+    layout: ProjectLayout,","+}","+","+impl LocalDirectoryFixture {","+    fn new(layout: ProjectLayout) -> Self {","+        let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+        let cwd = match layout {","+            ProjectLayout::Workspace => {","+                fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - app\\n\")","+                    .expect(\"write pnpm-workspace.yaml\");","+                fs::write(","+                    workspace.join(\"package.json\"),","+                    json!({ \"name\": \"root\", \"private\": true }).to_string(),","+                )","+                .expect(\"write the root manifest\");","+                workspace.clone()","+            }","+            ProjectLayout::Standalone => workspace.join(\"app\"),","+        };","+        let app = workspace.join(\"app\");","+        fs::create_dir_all(&app).expect(\"create the project\");","+        fs::write(","+            app.join(\"package.json\"),","+            json!({ \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"lib\": \"file:../lib\" } })","+                .to_string(),","+        )","+        .expect(\"write the project manifest\");","+        let fixture = Self { root, workspace, cwd, layout };","+        fixture.write_directory_manifest(\"lib\", &json!({}));","+        fixture.write_directory_manifest(\"other\", &json!({}));","+        fixture","+    }","+","+    fn write_directory_manifest(&self, name: &str, dependencies: &serde_json::Value) {","+        let dir = self.workspace.join(name);","+        fs::create_dir_all(&dir).expect(\"create the local directory\");","+        let manifest = json!({ \"name\": name, \"version\": \"1.0.0\", \"dependencies\": dependencies });","+        fs::write(dir.join(\"package.json\"), manifest.to_string())","+            .expect(\"write the local directory's manifest\");","+    }","+","+    fn install(&self) {","+        pacquet_in(&self.cwd)","+            .with_arg(\"install\")","+            .assert()","+            .success();","+    }","+","+    fn gated_exec(&self) -> std::process::Output {","+        let mut args = vec![\"--config.verify-deps-before-run=error\"];","+        match self.layout {","+            ProjectLayout::Workspace => args.extend([\"--filter\", \"app\"]),","+            ProjectLayout::Standalone => {}","+        }","+        args.extend([\"exec\", \"node\", \"-e\", \"\"]);","+        pacquet_in(&self.cwd)","+            .with_args(args)","+            .output()","+            .expect(\"spawn pacquet exec\")","+    }","+","+    #[track_caller]","+    fn assert_gate_passes(&self) {","+        let output = self.gated_exec();","+        assert!(output.status.success(), \"{}\", String::from_utf8_lossy(&output.stderr));","+    }","+","+    #[track_caller]","+    fn assert_gate_fails(&self) {","+        let output = self.gated_exec();","+        let stderr = String::from_utf8_lossy(&output.stderr);","+        assert!(","+            !output.status.success(),","+            \"the lockfile lacks the local directory's new dependency\",","+        );","+