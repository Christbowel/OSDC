time.Millisecond)","+\tinstance := &Instance{","+\t\tbrowser: &Browser{},","+\t\tengine:  rod.New().Client(client),","+\t}","+\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)","+\tdefer cancel()","+","+\tstarted := time.Now()","+\t_, _, err := instance.Run(","+\t\tcontextargs.NewWithInput(ctx, \"http://example.com\"),","+\t\tnil,","+\t\tnil,","+\t\t&Options{Timeout: time.Second},","+\t)","+","+\trequire.ErrorIs(t, err, context.DeadlineExceeded)","+\trequire.Less(t, time.Since(started), 200*time.Millisecond)","+}","+","+func TestPageCloseUsesDirectTargetCloseAfterRequestCancellation(t *testing.T) {","+\tclient := &countingCDPClient{events: make(chan *cdp.Event)}","+\tctx, cancel := context.WithCancel(context.Background())","+\tcancel()","+\trodPage := rod.New().Client(client).Context(ctx).PageFromSession(proto.TargetSessionID(\"session-id\"))","+\tpage := &Page{page: rodPage}","+","+\tpage.Close()","+","+\trequire.Equal(t, int32(1), client.calls.Load())","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"pkg/protocols/headless/request.go","lines":["@@ -133,25 +133,14 @@ func extractBaseURLFromActions(steps []*engine.Action) (string, error) {"],"additions":0,"deletions":0,"truncated":false}],"additions":609,"deletions":60,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-14T13:05:41.990845+00:00"}