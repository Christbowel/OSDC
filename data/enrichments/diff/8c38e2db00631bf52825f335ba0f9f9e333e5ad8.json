.to_owned();","         let cache = Arc::new(RwLock::new(","             JwkSetStore::new(jwks, CachePolicy::default(), validation)","@@ -331,7 +341,10 @@ impl OidcDecoder {","     /// Will only ever spawn one task at a single time.","     /// If called while an update task is currently running, will do nothing.","     fn revalidate_cache(&self) {","-        if self.cache_state.begin_revalidation() {","+        if self","+            .cache_state","+            .begin_revalidation_after(OIDC_REVALIDATION_INTERVAL)","+        {","             tracing::info!(\"Spawning Task to re-validate JWKS\");","             let decoder = self.clone();","             tokio::task::spawn(async move {","@@ -412,6 +425,29 @@ impl OidcDecoder {","     }"," }"," ","+fn default_oidc_validation() -> Validation {","+    // Preserve JWK-selected algorithms for the default OIDC builder instead of","+    // jsonwebtoken's HS256-only default. An explicitly supplied Validation keeps","+    // its own (possibly empty) allowlist.","+    Validation {","+        algorithms: vec![","+            Algorithm::HS256,","+            Algorithm::HS384,","+            Algorithm::HS512,","+            Algorithm::ES256,","+            Algorithm::ES384,","+            Algorithm::RS256,","+            Algorithm::RS384,","+            Algorithm::RS512,","+            Algorithm::PS256,","+            Algorithm::PS384,","+            Algorithm::PS512,","+            Algorithm::EdDSA,","+        ],","+        ..Validation::default()","+    }","+}","+"," fn configure_oidc_validation(","     mut validation: Validation,","     issuer: &str,","@@ -456,21 +492,10 @@ impl Debug for DecodingInfo {"," }"," impl DecodingInfo {","     fn new(key: DecodingKey, alg: Algorithm, validation_settings: &Validation) -> Self {","-        let mut validation = Validation::new(alg);","-","-        validation.aud.clone_from(&validation_settings.aud);","-        validation.iss.clone_from(&validation_settings.iss);","-        validation.le