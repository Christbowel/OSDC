on::Value>(&token).is_err());","+","+        let allowed = DecodingInfo::new(","+            DecodingKey::from_secret(secret),","+            Algorithm::HS512,","+            &Validation::new(Algorithm::HS512),","+        );","+        assert!(allowed.decode::<serde_json::Value>(&token).is_ok());","+","+        let default = DecodingInfo::new(","+            DecodingKey::from_secret(secret),","+            Algorithm::HS512,","+            &default_oidc_validation(),","+        );","+        assert!(default.decode::<serde_json::Value>(&token).is_ok());","+","+        let mut validation = Validation::new(Algorithm::HS512);","+        validation.algorithms.clear();","+        let info = DecodingInfo::new(","+            DecodingKey::from_secret(secret),","+            Algorithm::HS512,","+            &validation,","+        );","+        assert!(info.decode::<serde_json::Value>(&token).is_err());","+    }","+","+    #[tokio::test]","+    async fn unknown_kids_share_a_cooldown_and_rotation_remains_possible() {","+        let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();","+        let issuer = format!(\"http://{}\", listener.local_addr().unwrap());","+        let discovery = format!(r#\"{{\"jwks_uri\":\"{issuer}/jwks\"}}\"#);","+        let keys = Arc::new(std::sync::RwLock::new(","+            json!({\"keys\": [{","+                \"kty\": \"oct\", \"kid\": \"initial\", \"alg\": \"HS256\", \"k\": \"c2VjcmV0\"","+            }]})","+            .to_string(),","+        ));","+        let requests = Arc::new(AtomicUsize::new(0));","+        let server_keys = Arc::clone(&keys);","+        let server_requests = Arc::clone(&requests);","+        let server = tokio::spawn(async move {","+            loop {","+                let (stream, _) = listener.accept().await.unwrap();","+                let keys = Arc::clone(&server_keys);","+                let requests = Arc::clone(&server_requests);","+                let discovery = discovery.clone();","+                tokio::spawn(async move {","+                    let service = service_fn(move |req: salvo_core::hyper::Request<_>| {","+                        let body = if req.uri().path() == \"/jwks\" {","+                            requests.fetch_add(1, Ordering::Relaxed);","+                            keys.read().unwrap().clone()","+                        } else {","+                            discovery.clone()","+                        };","+                        async move {","+                            Ok::<_, Infallible>(","+                                Response::builder()","+                                    .status(if body.is_empty() {","+                                        salvo_core::http::StatusCode::SERVICE_UNAVAILABLE","+                                    } else {","+                                        salvo_core::http::StatusCode::OK","+                                    })","+                                    .header(CACHE_CONTROL, \"max-age=3600\")","+                                    .body(Full::new(Bytes::from(body)))","+                                    .unwrap(),","+                            )","+                        }","+                    });","+                    let _ = http1::Builder::new()","+                        .serve_connection(TokioIo::new(stream), service)","+                        .await;","+                });","+            }","+        });","+","+        let tls = rustls::ClientConfig::builder_with_provider(default_rustls_crypto_provider())","+            .with_safe_default_protocol_versions()","+            .unwrap()","+            .with_root_certificates(rustls::RootCertStore::empty())","+            .with_no_client_auth();","+        let connector = HttpsConnectorBuilder::new()","+            .with_tls_config(tls)","+            .https_or_http()","+            .enable_http1()","+            .build();","+        let client = Client::builder(TokioExecutor::new()).build(connector);","+        let decoder = OidcDecoder::builder(issuer)","+            .audience(\"test-client\")","+            .allow_symmetric_jwks(true)","+            .http_client(client)","+            .build()","+            .await","+            .unwrap();","+        assert!(decoder.get_kid_retry(\"initial\").await.is_ok());","+        for kid in [\"missing-a\", \"missing-b\", \"missing-c\"] {","+            assert!(decoder.get_kid_retry(kid).await.is_err());","+        }","+        // One initial fetch and one early refresh, regardless of the number of","+        // distinct misses or clones of the decoder.","+        assert!(decoder.clone().get_kid_retry(\"missing-d\").await.is_err());","+        assert_eq!(requests.load(Ordering::Relaxed), 2);","+","+        *keys.write().unwrap() = json!({\"keys\": [{","+            \"kty\": \"oct\", \"kid\": \"rotated\", \"alg\": \"HS256\", \"k\": \"c2VjcmV0\"","+        }]})","+        .to_string();","+        tokio::time::sleep(OIDC_REVALIDATION_INTERVAL + Duration::from_millis(20)).await;","+        assert!(decoder.get_kid_retry(\"rotated\").await.is_ok());","+        assert_eq!(requests.load(Ordering::Relaxed), 3);","+","+        // Failed refreshes are rate-limited too, while already cached keys keep","+        // working throughout their advertised freshness lifetime.","+        keys.write().unwrap().clear();","+        tokio::time::sleep(OIDC_REVALIDATION_INTERVAL + Duration::from_millis(20)).await;","+        for kid in [\"missing-e\", \"missing-f\", \"missing-g\"] {","+            assert!(decoder.get_kid_retry(kid).await.is_err());","+        }","+        assert_eq!(requests.load(Ordering::Relaxed), 4);","+        assert!(decoder.get_kid_retry(\"rotated\").await.is_ok());","+        server.abort();","+    }","+","     #[test]","     fn test_uses_provided_http_client_without_building_default_client() {","         let resolved ="],"additions":187,"deletions":18,"truncated":false},{"path":"crates/jwt-auth/src/oidc/cache.rs","lines":["@@ -4,7 +4,7 @@ use std::{","     collections::HashMap,","     sync::{","         atomic::{AtomicBool, AtomicU64, Ordering},","-        Arc,","+        Arc, Mutex,","     },","     time::{Duration, Instant},"," };","@@ -114,6 +114,7 @@ pub struct CacheState {","     last_update: AtomicU64,","     is_revalidating: AtomicBool,","     is_error: AtomicBool,","+    last_revalidation: Mutex<Option<Instant>>,"," }"," "," impl CacheState {","@@ -124,6 +125,7 @@ impl CacheState {","             last_update: AtomicU64::new(current_time()),","             is_revalidating: AtomicBool::new(false),","             is_error: AtomicBool::new(false),","+            last_revalidation: Mutex::new(None),","         }","     }","     /// Check is the cache is error","@@ -154,8 +156,30 @@ impl CacheState {","             .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)","             .is_ok()","     }","+","+    pub(super) fn begin_revalidation_after(&self, interval: Duration) -> bool {","+        let mut last = self","+            .last_revalidation","+            .lock()","+            .unwrap_or_else(|poisoned| poisoned.into_inner());","+        if last.is_some_and(|last| last.elapsed() < interval) || !self.begin_revalidation() {","+            return false;","+        }","+        *last = Some(Instant::now());","+        true","+    }","+","     /// Mark the cache as no longer revalidating.","     pub fn finish_revalidation(&self) {","+        let mut last = self","+            .last_revalidation","+            .lock()","+            .unwrap_or_else(|poisoned| poisoned.into_inner());","+        if last.is_some() {","+            // Start the cooldown after the attempt, including failed attempts,","+            // so a slow or failing provider cannot be polled without a break.","+            *last = Some(Instant::now());","+        }","         self.is_revalidating.store(false, Ordering::Release);","     }"," }","@@ -338,4 +362,18 @@ mod tests {","         assert!(!state.is_revalidating());","         assert!(state.begin_revalidation());","     }","+","+    #[test]","+    fn revalidation_cooldown_is_shared_and_expires() {","+        let state = Arc::new(CacheState::new());","+        let clone = Arc::clone(&state);","+        let interval = Duration::from_secs(1);","+        assert!(state.begin_revalidation_after(interval));","+        assert!(!clone.begin_revalidation_after(interval));","+        state.finish_revalidation();","+        assert!(!clone.begin_revalidation_after(interval));","+","+        *state.last_revalidation.lock().unwrap() = Some(Instant::now() - interval);","+        assert!(clone.begin_revalidation_after(interval));","+    }"," }",""],"additions":39,"deletions":1,"truncated":false}],"additions":358,"deletions":32,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-23T14:16:33.068828+00:00"}