common_exception::ErrorCode;","@@ -26,6 +31,9 @@ use databend_common_exception::Result;"," use databend_common_exception::ResultExt;"," use databend_common_metrics::system::set_system_version;"," use databend_common_storage::DataOperator;","+use databend_common_tracing::SignalListener;","+use databend_common_tracing::pipe_file;","+use databend_common_tracing::set_crash_hook;"," use databend_common_tracing::set_panic_hook;"," use databend_common_version::BUILD_INFO;"," use databend_common_version::DATABEND_COMMIT_VERSION;","@@ -69,6 +77,31 @@ pub async fn run_cmd(cmd: &Cmd) -> Result<bool, MainError> {","     Ok(true)"," }"," ","+pub fn run_main(main_entrypoint: impl Future<Output = Result<(), MainError>>) {","+    // Dispatch internal workers before parsing query-server arguments or starting","+    // crash tracking and runtime threads. Workers do not initialize query services.","+    python_worker_entry::try_run();","+","+    let (input, output) = pipe_file().unwrap();","+    set_crash_hook(output);","+    SignalListener::spawn(input, DATABEND_COMMIT_VERSION.to_string());","+","+    ThreadTracker::init();","+","+    match Runtime::with_default_worker_threads(Some(\"main-worker\".to_string())) {","+        Err(cause) => {","+            eprintln!(\"Databend Query start failure, cause: {:?}\", cause);","+            std::process::exit(cause.code() as i32);","+        }","+        Ok(rt) => {","+            if let Err(cause) = rt.block_on(main_entrypoint) {","+                eprintln!(\"Databend Query start failure, cause: {:?}\", cause);","+                std::process::exit(cause.code() as i32);","+            }","+        }","+    }","+}","+"," pub async fn init_services(conf: &InnerConfig, ee_mode: bool) -> Result<(), MainError> {","     let make_error = || \"failed to init services\";"," "],"additions":33,"deletions":0,"truncated":false},{"path":"src/binaries/query/entry/python_worker_entry.rs","lines":["@@ -0,0 +1,36 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+pub fn try_run() {","+    #[cfg(feature = \"python-udf\")]","+    {","+        let mut args = std::env::args_os().skip(1);","+        if args.next().as_deref() != Some(std::ffi::OsStr::new(databend_query::PYTHON_WORKER_ARG)) {","+            return;","+        }","+        let Some(path) = args.next() else {","+            eprintln!(\"Missing Python UDF worker socket path\");","+            std::process::exit(1);","+        };","+        if args.next().is_some() {","+            std::process::exit(1);","+        }","+        databend_common_base::runtime::ThreadTracker::init();","+        let result = databend_query::run_python_udf_worker(path.into());","+        if let Err(error) = &result {","+            eprintln!(\"{error}\");","+        }","+        std::process::exit(if result.is_ok() { 0 } else { 1 });","+    }","+}"],"additions":36,"deletions":0,"truncated":false},{"path":"src/binaries/query/oss_main.rs","lines":["@@ -19,47 +19,23 @@ mod entry;"," "," use clap::Parser;"," use databend_common_base::mem_allocator::TrackingGlobalAllocator;","-use databend_common_base::runtime::Runtime;","-use databend_common_base::runtime::ThreadTracker;"," use databend_common_exception::Result;"," use databend_common_exception::ResultExt;"," use databend_common_license::license_manager::LicenseManager;"," use databend_common_license::license_manager::OssLicenseManager;","-use databend_common_tracing::SignalListener;","-use databend_common_tracing::pipe_file;","-use databend_common_tracing::set_crash_hook;","-use databend_common_version::DATABEND_COMMIT_VERSION;"," use entry::MainError;"," "," use self::cmd::Cmd;"," use crate::entry::init_services;"," use crate::entry::run_cmd;","+use crate::entry::run_main;"," use crate::entry::start_services;"," "," #[global_allocator]"," pub static GLOBAL_ALLOCATOR: TrackingGlobalAllocator = TrackingGlobalAllocator::create();"," "," fn main() {","-    // Crash tracker","-    let (input, output) = pipe_file().unwrap();","-    set_crash_hook(output);","-    SignalListener::spawn(input, DATABEND_COMMIT_VERSION.to_string());","-","-    // Thread tracker","-    ThreadTracker::init();","-","-    match Runtime::with_default_worker_threads(Some(\"main-worker\".to_string())) {","-        Err(cause) => {","-            eprintln!(\"Databend Query start failure, cause: {:?}\", cause);","-            std::process::exit(cause.code() as i32);","-        }","-        Ok(rt) => {","-            if let Err(cause) = rt.block_on(main_entrypoint()) {","-                eprintln!(\"Databend Query start failure, cause: {:?}\", cause);","-                std::process::exit(cause.code() as i32);","-            }","-        }","-    }","+    run_main(main_entrypoint());"," }"," "," async fn main_entrypoint() -> Result<(), MainError> {"],"additions":2,"deletions":26,"truncated":false},{"path":"src/query/config/src/config.rs","lines":["@@ -1914,6 +1914,33 @@ pub struct QueryConfig {","     #[clap(long, value_name = \"VALUE\", default_value = \"true\")]","     pub enable_udf_python_script: bool,"," ","+    /// Maximum Python scalar UDF processes on this node (0 = effective CPU count).","+    #[clap(long, value_name = \"VALUE\", default_value = \"0\")]","+    pub python_udf_max_workers: usize,","+","+    /// Python worker budget shared by a tenant (0 = inherit the node limit).","+    #[clap(long, value_name = \"VALUE\", default_value = \"0\")]","+    pub python_udf_max_workers_per_tenant: usize,","+","+    /// Maximum resident Python workers per query (0 = minimum runtimes plus","+    /// max_threads - 1). Concurrent execution always respects max_threads.","+    #[clap(long, value_name = \"VALUE\", default_value = \"0\")]","+    pub python_udf_max_workers_per_query: usize,","+","+    /// Bound Python worker admission waiters independently of running queries.","+    #[clap(long, value_name = \"VALUE\", default_value = \"128\")]","+    pub python_udf_max_queued_queries: usize,","+","+    #[clap(long, value_name = \"VALUE\", default_value = \"60\")]","+    pub python_udf_queue_timeout_secs: u64,","+","+    #[clap(long, value_name = \"VALUE\", default_value = \"300\")]","+    pub python_udf_execution_timeout_secs: u64,","+","+    /// Recycle idle extra Python workers after this interval; keep one per runtime.","+    #[clap(long, value_name = \"VALUE\", default_value = \"300\")]","+    pub python_udf_worker_idle_timeout_secs: u64,","+","     #[clap(long, value_name = \"VALUE\", default_value = \"true\")]","     pub enable_udf_js_script: bool,"," "],"additions":27,"deletions":0,"truncated":false},{"path":"src/query/script_udf_support/Cargo.toml","lines":["@@ -20,6 +20,7 @@ arrow-ipc = { workspace = true }"," arrow-schema = { workspace = true }"," arrow-select = { workspace = true }"," arrow-udf-runtime = { workspace = true, optional = true }","+async-trait = { workspace = true }"," databend-common-base = { workspace = true }"," databend-common-cache = { workspace = true }"," databend-common-exception = { workspace = true }","@@ -29,13 +30,25 @@ databend-common-pipeline-transforms = { workspace = true }"," databend-common-sql = { workspace = true }"," databend-common-storage = { workspace = true }"," futures = { workspace = true }","+libc = { workspace = true }"," log = { workspace = true }"," parking_lot = { workspace = true }","+serde = { workspace = true }","+serde_json = { workspace = true }"," tokio = { workspace = true }"," toml = { workspace = true }"," uuid = { workspace = true }"," walkdir = { workspace = true }"," zip = { workspace = true }"," ","+[dev-dependencies]","+tokio = { workspace = true, features = [\"test-util\"] }","+","+[[test]]","+name = \"python_worker_process\"","+path = \"tests/python_worker_process.rs\"","+harness = false","+required-features = [\"python-udf\"]","+"," [lints]"," workspace = true"],"additions":13,"deletions":0,"truncated":false},{"path":"src/query/script_udf_support/PERFORMANCE.md","lines":["@@ -0,0 +1,38 @@","+# Python UDF isolation: approximate performance","+","+This comparison uses a single SQL query computing Euclidean GCD for **5 million","+rows**, with both arguments varying per row. Results were independently checked","+with standard-library `math.gcd`; there is no artificial busy loop or sleep.","+","+Both versions used matching release builds (LTO disabled), CPython 3.12, query","+result caching disabled, and identical configuration on a shared 24-logical-CPU","+host. The isolated node capacity was 16 workers. Medians combine two passes in","+opposite server order, with ten samples per case. These are indicative local","+measurements, not production guarantees.","+","+| `max_threads` | Shared interpreter (`main`) | Isolated worker pool | Relative to main | Observed workers |","+|---:|---:|---:|---:|---:|","+| 1 | 5.05 s | 6.43 s | About 27% slower | 1 |","+| 4 | 5.96 s | 1.90 s | About 3.1× faster | 4 |","+| 8 | 6.79 s | 1.75 s | About 3.9× faster | 8 |","+","+## Takeaways","+","+- This is **single-query parallelism**, not eight independent SQL queries. The","+  isolated implementation improves by about 3.7× from one to eight threads.","+  Separate interpreters remove shared-GIL serialization while using more cores;","+  this is not a claim of equal CPU efficiency or universal linear scaling.","+  Shared-host variability is substantial (eight-thread p95 was about 8.22 s on","+  main and 2.15 s with isolation); do not treat these ratios as stable guarantees.","+- A scalar query still starts only one worker, including at `max_threads=8`.","+  Fresh-process startup and IPC remain significant costs for short queries.","+- Worker processes consume additional memory outside the query allocator. CPU","+  sizing and process-count quotas do not replace OS-enforced memory limits.","+- Auto-sizing and budget accounting for 64/128 CPUs have unit coverage. This","+  host does not have 128 CPUs; no 64/128-core performance claim is made here.","+","+To repeat the single-query comparison, run","+`scripts/benchmark/query/python_udf_isolation.py --workload gcd-scaling --threads N`","+for `N=1,4,8` against each version with identical settings. `--gcd-rows` controls","+the input size. See [README.md](README.md#performance-comparison) for the workflow","+and worker-capacity configuration."],"additions":38,"deletions":0,"truncated":false},{"path":"src/query/script_udf_support/README.md","lines":["@@ -0,0 +1,193 @@","+# Script UDF execution","+","+JavaScript and WebAssembly retain their in-process execution paths. With the","+`python-udf` feature, **scalar Python script UDFs** execute in fresh child processes","+of the query executable. The hidden worker entrypoint runs before service","+initialization; workers do not start query servers or load service configuration.","+","+## Isolation and scheduling","+","+- A Python runtime belongs to one local query execution and one UDF definition.","+  It is not cached by function name across SQL executions.","+- Each runtime owns a worker pool. Parallel pipeline transforms can check out","+  different workers, bounded by the query's current `max_threads` and node/tenant","+  capacities. Pools grow only when concurrent batches need them: a scalar query","+  does not start `max_threads` processes. Workers are reused within the execution;","+  no sharing of Python globals between workers is promised.","+- Pipeline construction registers all local Python runtimes with the shared","+  query context. Before starting any worker, the query reserves one minimum","+  worker per runtime together, tenant quota first and node quota second. Every","+  admitted operator can therefore make progress even when expansion is blocked.","+- Additional workers use nonblocking quota acquisition. If extra capacity is","+  unavailable, batches wait for an existing worker, not for incremental quota.","+  Idle extras can be retired to serve another operator or query; busy extras","+  yield on completion when minimum admissions are waiting. Reclaimed workers","+  are killed and reaped, never handed to another SQL execution.","+- Idle extras are also automatically retired after five minutes without a batch,","+  even when there is no capacity pressure or subsequent request. Idle time starts","+  when a successful request returns its worker to the pool, and resets on reuse.","+  Each pool has at most one deadline-driven timer while idle extras exist; the","+  timer does not keep the runtime alive. Busy workers are never idle-expired.","+  The minimum worker per runtime is kept for progress; query completion still","+  terminates all workers immediately, without waiting for idle expiry.","+- The admission queue is bounded. Full queues, queue timeouts, excessive query","+  budgets, and attempts to add runtimes after admission return errors. They never","+  cause unbounded process creation or an impossible resource wait. A repeated","+  occurrence of a function in a separately built physical operator currently","+  counts as another runtime.","+- Workers are started lazily using exec, not fork-without-exec. A worker can","+  process multiple Arrow batches within the same query, but is never handed to a","+  different query after running user code.","+- Completion of the last registered local pipeline, or query cancellation,","+  terminates workers, including their process groups, and reaps them","+  asynchronously on the service runtime. Finishing one fragment does not kill","+  workers still needed by another fragment. Quota and private","+  directories remain alive until the child has actually exited. Starting and","+  exiting workers count against the budget.","+- A failed, cancelled, or timed-out request poisons its runtime. Batches are not"],"additions":47,"deletions":0,"truncated":false}],"additions":555,"deletions":52,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-22T13:46:54.328694+00:00"}