& model,","-                                               const std::shared_ptr<ov::AlignedBuffer>& weights,","-                                               const std::shared_ptr<ov::AlignedBuffer>& origin_weights);","-","     std::variant<std::shared_ptr<ov::AlignedBuffer>, std::reference_wrapper<std::istream>> m_model;","-    std::shared_ptr<ov::ICore> m_core;","-    CacheDecrypt m_cache_decrypt;","-    bool m_decript_from_string;","-    std::shared_ptr<ov::AlignedBuffer> m_origin_weights_buf;","+};","+","+/// HSM blob: Deserializer sections into xml and weights.","+class HsmModelDeserializer final : public ModelDeserializerBase {","+public:","+    struct Sections {","+        std::shared_ptr<ov::AlignedBuffer> xml;      //!< Encrypted when cache encryption is on.","+        std::shared_ptr<ov::AlignedBuffer> weights;  //!< Null when the blob stores no constants.","+    };","+","+    HsmModelDeserializer(Sections sections,","+                         const std::shared_ptr<ov::ICore>& core,","+                         const CacheDecrypt& decrypt_fn,","+                         bool decript_from_string,","+                         const std::string& origin_weights_path = \"\");","+","+    void operator>>(std::shared_ptr<ov::Model>& model) override;","+","+private:","+    Sections m_sections;"," };"," "," }  //  namespace ov::intel_cpu"],"additions":46,"deletions":12,"truncated":false},{"path":"src/plugins/intel_cpu/src/utils/graph_serializer/hsm_common.hpp","lines":["@@ -0,0 +1,58 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+// Wire contract of the CPU HSM blob, shared by HsmReaderHandler and HsmWriterHandler. Keep it free of reader and","+// writer code - the two handlers must stay independent. `hsm` is this plugin's own namespace; the runtime API is","+// spelled runtime::hsm.","+//","+// Layout of the container, in file order (the legacy stream was [DataHeader][Custom data][Blobs][IR] behind a","+// requirements prefix; the manifest now replaces the DataHeader, and the custom data is no longer written):","+//","+//   [ HSM header           ]  32 bytes","+//   [ runtime_requirements ]  common section, checked first so an incompatible blob is rejected before any payload","+//   [ padding              ]","+//   [ weights              ]  page-aligned offset and slot size; may be empty (no constants, or weightless cache)","+//   [ model_struct         ]  page-aligned offset and slot size; IR XML, encrypted when cache encryption is on","+//   [ manifest             ]  one entry per section, starts on a page boundary","+//","+// The XML refers to constants by offset from the start of the weights section.","+","+#pragma once","+","+#include <cstdint>","+","+#include \"openvino/runtime/hsm_format.hpp\"","+","+namespace ov::intel_cpu::hsm {","+","+inline constexpr runtime::hsm::DeviceId device_id = runtime::hsm::cpu_device_id;","+","+struct SectionId {","+    runtime::hsm::DeviceId device{};","+    runtime::hsm::SectionTag tag{};","+};","+","+constexpr uint32_t section_key(runtime::hsm::DeviceId device, runtime::hsm::SectionTag tag) noexcept {","+    return (static_cast<uint32_t>(device) << 24) | (static_cast<uint32_t>(tag.value[0]) << 16) |","+           (static_cast<uint32_t>(tag.value[1]) << 8) | static_cast<uint32_t>(tag.value[2]);","+}","+","+constexpr uint32_t section_key(const SectionId& id) noexcept {","+    return section_key(id.device, id.tag);","+}","+","+/// Core-owned: the string checked by is_runtime_requirements_compatible() on import.","+// CVS-196454: use the common Runtime Requirements codec instead of the plain string.","+inline constexpr SectionId runtime_requirements{runtime::hsm::any_device_id, runtime::hsm::runtime_requirements_tag};","+/// Core-owned, inline.","+// The id algorithm is not defined yet, the writer stores a placeholder and the reader does not use it.","+inline constexpr SectionId model_id{runtime::hsm::any_device_id, runtime::hsm::model_id_tag};","+/// The compiled model's IR XML (encrypted when cache encryption is on), without constants.","+// CVS-196450: replace with the common Model Struct section once its payload is defined.","+// CVS-196452: add the common Compiled Options section; CPU keeps its options in the model rt_info until then.","+inline constexpr SectionId model_struct{device_id, runtime::hsm::model_tag};","+// CVS-196451: replace with the common Weights section once its payload is defined.","+inline constexpr SectionId weights{device_id, runtime::hsm::weights_tag};","+","+}  // namespace ov::intel_cpu::hsm"],"additions":58,"deletions":0,"truncated":false},{"path":"src/plugins/intel_cpu/src/utils/graph_serializer/hsm_reader_handler.cpp","lines":["@@ -0,0 +1,124 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"utils/graph_serializer/hsm_reader_handler.hpp\"","+","+#include <cstddef>","+#include <cstdint>","+#include <map>","+#include <memory>","+#include <string>","+#include <unordered_set>","+#include <utility>","+","+#include \"openvino/core/except.hpp\"","+#include \"openvino/runtime/aligned_buffer.hpp\"","+#include \"openvino/runtime/hsm_format.hpp\"","+#include \"openvino/runtime/hsm_model_id_codec.hpp\"","+#include \"openvino/runtime/hsm_reader.hpp\"","+#include \"openvino/runtime/shared_buffer.hpp\"","+#include \"utils/graph_serializer/hsm_common.hpp\"","+#include \"utils/graph_serializer/serializer.hpp\"","+","+namespace ov::intel_cpu {","+","+namespace {","+","+std::string read_string(const runtime::hsm::Section& section) {","+    std::string value(section.size(), '\\0');","+    OPENVINO_ASSERT(section.read(value.data()), \"[CPU] Cannot import compiled blob: failed to read a section.\");","+    return value;","+}","+","+// Maps the section from the source blob when the bytes are addressable and kept alive by it, otherwise copies.","+std::shared_ptr<ov::AlignedBuffer> read_buffer(const std::shared_ptr<ov::AlignedBuffer>& source_blob,","+                                               const runtime::hsm::Section& section) {","+    if (section.size() == 0) {","+        return nullptr;","+    }","+    if (const auto view = section.view(); source_blob && !view.empty()) {","+        return std::make_shared<ov::SharedBuffer<std::shared_ptr<ov::AlignedBuffer>>>(","+            const_cast<std::byte*>(view.data()),","+            view.size(),","+            source_blob);","+    }","+    auto buffer = std::make_shared<ov::AlignedBuffer>(section.size());","+    OPENVINO_ASSERT(section.read(buffer->get_ptr()), \"[CPU] Cannot import compiled blob: failed to read a section.\");","+    return buffer;","+}","+","+// Rejected before the payload sections that follow are read.","+std::string read_compatible_requirements(const runtime::hsm::Section& section) {","+    // CVS-196454: decode with the common Runtime Requirements codec.","+    OPENVINO_ASSERT(section.size() <= runtime_requirements_max_size,","+                    \"[CPU] Cannot import compiled blob: runtime requirements block is too large.\");","+    auto requirements = read_string(section);","+    OPENVINO_ASSERT(is_runtime_requirements_compatible(requirements),","+                    \"[CPU] Cannot import compiled blob: incompatible runtime requirements, blob: \",","+                    requirements,","+                    \", current: \",","+                    build_runtime_requirements());","+    return requirements;","+}","+","+constexpr uint32_t requirements_key = hsm::section_key(hsm::runtime_requirements);","+constexpr uint32_t model_struct_key = hsm::section_key(hsm::model_struct);","+","+}  // namespace","+","+const std::map<uint32_t, HsmReaderHandler::Decoder> HsmReaderHandler::s_decoders = {","+    {hsm::section_key(hsm::model_id),","+     [](HsmReaderHandler& handler, const runtime::hsm::Section& section) {","+         handler.model_id = runtime::hsm::decode_model_id(section);","+     }},","+    {model_struct_key,","+     [](HsmReaderHandler& handler, const runtime::hsm::Section& section) {","+         handler.model_struct = read_buffer(handler.m_source_blob, section);","+     }},","+    {hsm::section_key(hsm::weights),","+     [](HsmReaderHandler& handler, const runtime::hsm::Section& section) {","+         // TODO: a mapped blob can prefetch these pages here so that reading a cold file overlaps the rest of the","+         // import.","+         handler.weights = read_buffer(handler.m_source_blob, section);","+     }},","+};","+","+HsmReaderHandler::HsmReaderHandler(std::shared_ptr<ov::AlignedBuffer> source_blob)","+    : m_source_blob(std::move(source_blob)) {}","+","+bool HsmReaderHandler::handle_section(const runtime::hsm::ManifestEntry& entry, const runtime::hsm::Section& section) {","+    if (const auto decoder = s_decoders.find(hsm::section_key(entry.device, entry.tag)); decoder != s_decoders.end()) {","+        decoder->second(*this, section);","+        return true;","+    }","+    return false;","+}","+","+void HsmReaderHandler::read_sections(const runtime::hsm::Reader& reader) {","+    // Not left to the manifest order: an incompatible blob is rejected before any payload is read.","+    const auto requirements = reader.section(hsm::runtime_requirements.device, hsm::runtime_requirements.tag.id());","+    OPENVINO_ASSERT(requirements, \"[CPU] Cannot import compiled blob: missing runtime requirements section.\");","+    runtime_requirements = read_compatible_requirements(*requirements);"],"additions":102,"deletions":0,"truncated":false}],"additions":345,"deletions":46,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-03T16:49:38.372531+00:00"}