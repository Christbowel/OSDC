w', \"To inspect the chosen file's changes, press Tab to reach Open Changes in Diff Editor, then Enter or Space.\")"," \t\t\t: sessionWorkingSetUndo"],"additions":1,"deletions":1,"truncated":false},{"path":"src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostCheckpointReview.ts","lines":["@@ -0,0 +1,171 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { raceCancellationError, raceTimeout } from '../../../../../../base/common/async.js';","+import { cancelOnDispose } from '../../../../../../base/common/cancellation.js';","+import { isCancellationError } from '../../../../../../base/common/errors.js';","+import { Event } from '../../../../../../base/common/event.js';","+import { Disposable, IDisposable, toDisposable } from '../../../../../../base/common/lifecycle.js';","+import { ResourceMap, ResourceSet } from '../../../../../../base/common/map.js';","+import { IObservable, IReader, ITransaction, observableValue } from '../../../../../../base/common/observable.js';","+import { isEqual } from '../../../../../../base/common/resources.js';","+import { URI } from '../../../../../../base/common/uri.js';","+import { FileEditKind } from '../../../../../../platform/agentHost/common/state/sessionState.js';","+import { IFileService } from '../../../../../../platform/files/common/files.js';","+import { ILogService } from '../../../../../../platform/log/common/log.js';","+import { IEditSessionEntryDiff } from '../../../common/editing/chatEditingService.js';","+import type { IToolCallFileEdit } from './stateToProgressAdapter.js';","+","+export interface IAgentHostCheckpointReviewFile {","+\treadonly diff: IEditSessionEntryDiff;","+\treadonly nonce: string | undefined;","+}","+","+export interface IAgentHostCheckpointReviewSource {","+\treadonly channel: URI;","+\treadonly ready: boolean;","+\treadonly failed?: boolean;","+\treadonly files: readonly IAgentHostCheckpointReviewFile[];","+}","+","+interface IRestoredReviewFile extends IAgentHostCheckpointReviewFile {","+\treadonly channel: URI;","+}","+","+/** Excludes fully restored revisions during reversible checkpoint preview, without discarding host history. */","+export class AgentHostCheckpointReview extends Disposable {","+\tprivate readonly _sources = new Set<IObservable<IAgentHostCheckpointReviewSource | undefined>>();","+\tprivate readonly _restored = observableValue<readonly IRestoredReviewFile[]>(this, []);","+\tprivate readonly _lifetime = cancelOnDispose(this._store);","+","+\tconstructor(private readonly _fileService: IFileService, private readonly _logService: ILogService) {","+\t\tsuper();","+\t}","+","+\tregisterSource(source: IObservable<IAgentHostCheckpointReviewSource | undefined>): IDisposable {","+\t\tthis._sources.add(source);","+\t\treturn toDisposable(() => this._sources.delete(source));","+\t}","+","+\tproject<T extends IAgentHostCheckpointReviewFile>(channel: URI, files: readonly T[], reader?: IReader): readonly T[] {","+\t\tconst restored = this._restored.read(reader);","+\t\treturn files.filter(file => !restored.some(previous =>","+\t\t\tisEqual(previous.channel, channel)","+\t\t\t&& isEqual(previous.diff.modifiedURI, file.diff.modifiedURI)","+\t\t\t&& isEqual(previous.diff.originalURI, file.diff.originalURI)","+\t\t\t&& isEqual(previous.diff.modifiedSnapshotURI, file.diff.modifiedSnapshotURI)","+\t\t\t&& !!previous.diff.isCreated === !!file.diff.isCreated","+\t\t\t&& !!previous.diff.isDeleted === !!file.diff.isDeleted","+\t\t\t&& previous.nonce === file.nonce));","+\t}","+","+\t/** Prepares visibility for the affected resources, using cumulative history to recognize fully restored revisions. */","+\tasync prepareRestore(checkpoints: readonly { readonly edits: readonly IToolCallFileEdit[] }[], undo: boolean, affectedResources: readonly URI[]): Promise<(tx: ITransaction) => void> {","+\t\tconst targets = new ResourceMap<IToolCallFileEdit>();","+\t\tconst endpoints = new ResourceMap<IToolCallFileEdit>();","+\t\tconst chains = new ResourceMap<IToolCallFileEdit[]>();","+\t\tconst renamed = new ResourceSet();","+\t\tfor (const checkpoint of undo ? [...checkpoints].reverse() : checkpoints) {","+\t\t\tfor (const edit of checkpoint.edits) {","+\t\t\t\tif (edit.kind === FileEditKind.Rename) {","+\t\t\t\t\trenamed.add(edit.resource);","+\t\t\t\t\tif (edit.originalResource) {","+\t\t\t\t\t\trenamed.add(edit.originalResource);","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tif (!endpoints.has(edit.resource)) {","+\t\t\t\t\tendpoints.set(edit.resource, edit);","+\t\t\t\t}","+\t\t\t\tconst chain = chains.get(edit.resource) ?? [];","+\t\t\t\tif (undo) {","+\t\t\t\t\tchain.unshift(edit);","+\t\t\t\t} else {","+\t\t\t\t\tchain.push(edit);","+\t\t\t\t}","+\t\t\t\tchains.set(edit.resource, chain);","+\t\t\t\ttargets.set(edit.resource, edit);","+\t\t\t}","+\t\t}","+\t\tconst affected = new ResourceSet(affectedResources);","+\t\tconst restored = this._restored.get().filter(file => !affected.has(file.diff.modifiedURI));","+\t\tif (undo) {","+\t\t\tconst sources = await Promise.all([...this._sources].map(source => this._whenReady(source)));","+\t\t\tfor (const current of sources) {","+\t\t\t\tif (!current?.ready || current.failed) {","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+\t\t\t\tfor (const file of current.files) {","+\t\t\t\t\ttry {","+\t\t\t\t\t\tconst target = targets.get(file.diff.modifiedURI);","+\t\t\t\t\t\tconst endpoint = endpoints.get(file.diff.modifiedURI);","+\t\t\t\t\t\tif (!target || !endpoint || !affected.has(file.diff.modifiedURI) || renamed.has(file.diff.modifiedURI)) {","+\t\t\t\t\t\t\tcontinue;","+\t\t\t\t\t\t}","+\t\t\t\t\t\t// A peer's or a newer revision must not disappear with this chat's checkpoint.","+\t\t\t\t\t\tif (file.diff.isDeleted","+\t\t\t\t\t\t\t? endpoint.kind !== FileEditKind.Delete || !await this._isContinuous(chains.get(file.diff.modifiedURI)!)","+\t\t\t\t\t\t\t: !endpoint.afterContentUri || !isEqual(endpoint.afterContentUri, file.diff.modifiedSnapshotURI)) {","+\t\t\t\t\t\t\tcontinue;","+\t\t\t\t\t\t}","+\t\t\t\t\t\tif (target.kind === FileEditKind.Create && file.diff.isCreated) {","+\t\t\t\t\t\t\trestored.push({ ...file, channel: current.channel });","+\t\t\t\t\t\t} else if (target.beforeContentUri && !file.diff.isCreated) {","+\t\t\t\t\t\t\tconst [baseline, restoredContent] = await Promise.all([","+\t\t\t\t\t\t\t\tthis._fileService.readFile(file.diff.originalURI),","+\t\t\t\t\t\t\t\tthis._fileService.readFile(target.beforeContentUri),","+\t\t\t\t\t\t\t]);","+\t\t\t\t\t\t\tif (baseline.value.equals(restoredContent.value)) {","+\t\t\t\t\t\t\t\trestored.push({ ...file, channel: current.channel });","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t} catch (error) {","+\t\t\t\t\t\tif (isCancellationError(error)) {","+\t\t\t\t\t\t\tthrow error;","+\t\t\t\t\t\t}","+\t\t\t\t\t\tthis._logService.warn('[AgentHostCheckpointReview] Could not compare the restored checkpoint with its working set', error);","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\treturn tx => this._restored.set(restored, tx);","+\t}","+","+\tprivate async _whenReady(source: IObservable<IAgentHostCheckpointReviewSource | undefined>): Promise<IAgentHostCheckpointReviewSource | undefined> {","+\t\tconst pending = () => source.get()?.ready === false && !source.get()?.failed;","+\t\tif (pending()) {","+\t\t\tconst ready = Event.toPromise(Event.filter(Event.fromObservableLight(source), () => !pending()));","+\t\t\ttry {","+\t\t\t\tawait raceCancellationError(raceTimeout(ready, 30_000, () => ready.cancel()), this._lifetime);","+\t\t\t} finally {","+\t\t\t\tready.cancel();","+\t\t\t}","+\t\t\tif (pending()) {","+\t\t\t\tthis._logService.warn('[AgentHostCheckpointReview] The working set did not finish updating before checkpoint restoration');","+\t\t\t}","+\t\t\tif (source.get()?.failed) {","+\t\t\t\tthis._logService.warn('[AgentHostCheckpointReview] The working set is unavailable during checkpoint restoration');","+\t\t\t}","+\t\t}","+\t\treturn source.get();","+\t}","+","+\tprivate async _isContinuous(edits: readonly IToolCallFileEdit[]): Promise<boolean> {","+\t\tfor (let index = 1; index < edits.length; index++) {","+\t\t\tconst after = edits[index - 1].afterContentUri;","+\t\t\tconst before = edits[index].beforeContentUri;","+\t\t\tif (isEqual(after, before)) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tif (!after || !before) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tconst [previous, current] = await Promise.all([this._fileService.readFile(after), this._fileService.readFile(before)]);","+\t\t\tif (!previous.value.equals(current.value)) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+}"],"additions":171,"deletions":0,"truncated":false},{"path":"src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostEditReview.ts","lines":["@@ -3,14 +3,14 @@","  *  Licensed under the MIT License. See License.txt in the project root for license information.","  *--------------------------------------------------------------------------------------------*/"," ","-import { raceTimeout, Sequencer } from '../../../../../../base/common/async.js';","+import { raceCancellationError, raceTimeout, Sequencer } from '../../../../../../base/common/async.js';"," import { cancelOnDispose, CancellationToken } from '../../../../../../base/common/cancellation.js';"," import { toErrorMessage } from '../../../../../../base/common/errorMessage.js';"," import { CancellationError, isCancellationError } from '../../../../../../base/common/errors.js';"," import { Event } from '../../../../../../base/common/event.js';"," import { Disposable, DisposableStore, IReference } from '../../../../../../base/common/lifecycle.js';"," import { 