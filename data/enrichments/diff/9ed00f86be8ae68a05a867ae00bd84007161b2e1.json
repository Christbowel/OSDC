,","     const int32_t count,","     f32_t* results) {","+    const int32_t block_mask = clamp_mask(mask, count);","     dot7u_bulk_avx512<int8_t, masked_mapper, 4, 1, masked_output>(","-        a, b, dims, pitch, &mask, __builtin_popcount((uint32_t)mask), results);","+        a, b, dims, pitch, &block_mask, __builtin_popcount((uint32_t)block_mask), results);"," }"," "," EXPORT void vec_doti7u_bulk_sparse_2("],"additions":2,"deletions":1,"truncated":false},{"path":"libs/simdvec/native/src/vec/headers/vec_common.h","lines":["@@ -89,6 +89,19 @@ static inline const T* masked_mapper(const T* data, const int32_t i, const int32","     return data + (int64_t)mask_select((uint32_t)offsets[0], i) * pitch;"," }"," ","+// The bits of `mask` that select vectors inside a block of `count` vectors. Masked kernels","+// must score with this mask, so that whatever the mask, they never read vectors or write","+// scores past the end of the block.","+static inline int32_t clamp_mask(const int32_t mask, const int32_t count) {","+    if (count <= 0) {","+        return 0;","+    }","+    if (count >= 32) {","+        return mask;","+    }","+    return (int32_t)((uint32_t)mask & ((1u << count) - 1));","+}","+"," // --- Output mapper functions ---"," // Each output mapper resolves the result slot of the i-th scored vector."," // All share the same signature so they can be passed as a template"],"additions":13,"deletions":0,"truncated":false},{"path":"libs/simdvec/src/test/java/org/elasticsearch/simdvec/SimdVecLibraryBBQTests.java","lines":["@@ -250,6 +250,37 @@ public void testBulkMaskedRejectsHeapSegments() {","         );","     }"," ","+    public void testBulkMaskedIgnoresVectorsPastTheBlock() {","+        assumeTrue(notSupportedMsg(), supported());","+","+        final int count = randomIntBetween(0, Integer.SIZE - 1);","+        final int mask = randomInvalidBulkMask(count);","+        // vectors and scores for all the 32 positions a mask can select, so that scoring past the block fails the","+        // assertions instead of accessing unallocated memory","+        final TestData testData = createTestData(Integer.SIZE, size, type);","+","+        float[] expectedScores = unselectedScores(Integer.SIZE);","+        ScalarOperations.bulkMasked(","+            function,","+            testData.unpackedQueryVector,","+            testData.unpackedIndexVectors,","+            mask & BulkMask.all(count),","+            expectedScores","+        );","+","+        var bulkScoresSeg = unselectedScoresSegment(Integer.SIZE);","+        nativeSimilarityBulkMaskedRaw(","+            testData.indexSegment,","+            testData.querySegment,","+            testData.indexVectorBytes,","+            testData.indexVectorBytes,","+            mask,","+            count,","+            bulkScoresSeg","+        );","+        assertScoresEquals(expectedScores, bulkScoresSeg);","+    }","+","     public void testBulkSparse() {","         assumeTrue(notSupportedMsg(), supported());","         assumeTrue(\"BulkSparse only used in production for D1Q4 (BBQ)\", type == SimdVecLibrary.BBQType.D1Q4);","@@ -486,6 +517,18 @@ void nativeSimilarityBulkMasked(MemorySegment a, MemorySegment b, int dims, int","         }","     }"," ","+    /** Like {@link #nativeSimilarityBulkMasked}, but skipping the mask validation of the public bindings. */","+    void nativeSimilarityBulkMaskedRaw(MemorySegment a, MemorySegment b, int dims, int pitch, int mask, int count, MemorySegment result) {","+        switch (type) {","+            case D1Q1 -> getVectorDistance().dotProductD1Q1BulkMasked_raw(a, b, dims, pitch, mask, count, result);","+            case D1Q4 -> getVectorDistance().dotProductD1Q4BulkMasked_raw(a, b, dims, pitch, mask, count, result);","+            case D2Q2 -> getVectorDistance().dotProductD2Q2BulkMasked_raw(a, b, dims, pitch, mask, count, result);","+            case D2Q4 -> getVectorDistance().dotProductD2Q4BulkMasked_raw(a, b, dims, pitch, mask, count, result);","+