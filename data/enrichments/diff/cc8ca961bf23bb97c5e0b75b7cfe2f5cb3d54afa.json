  void aCachedPageIsReadAndACompressedPageIsLeftAlone() throws IOException {","+        CachedFile cached = new CachedFile(PAGE.getBytes(StandardCharsets.UTF_8), MediaType.TEXT_HTML_TYPE, 0);","+        assertTrue(DevStaticHtml.isFile(cached));","+        DevStaticHtml.Page read = html.read(cached, HttpResponse.ok());","+        assertNotNull(read);","+        assertEquals(PAGE, read.html());","+        assertNull(html.read(new CachedFile(new byte[0], MediaType.IMAGE_PNG_TYPE, 0), HttpResponse.ok()));","+","+        // a pre-compressed sibling, with the media type of the page","+        Path gzip = Files.write(directory.resolve(\"index.html.gz\"), new byte[]{31, -117, 8, 0});","+        assertNull(html.read(new SystemFile(gzip.toFile(), MediaType.TEXT_HTML_TYPE), HttpResponse.ok().header(HttpHeaders.CONTENT_ENCODING, \"gzip\")));","+        assertNull(html.read(cached, HttpResponse.ok().header(HttpHeaders.CONTENT_ENCODING, \"br\")));","+    }","+","     @Test","     void aStreamedPageIsKnownByItsMediaType() {","         StreamedFile streamed = new StreamedFile(new ByteArrayInputStream(PAGE.getBytes(StandardCharsets.UTF_8)), MediaType.TEXT_HTML_TYPE);"],"additions":17,"deletions":0,"truncated":false},{"path":"http-server-netty/src/main/java/io/micronaut/http/server/netty/handler/Compressor.java","lines":["@@ -114,6 +114,10 @@ Session prepare(ChannelHandlerContext ctx, HttpRequest request, HttpResponse res","             // already encoded","             return null;","         }","+        if (code == 206 || response.headers().contains(HttpHeaderNames.CONTENT_RANGE)) {","+            // the Content-Range describes the bytes of the representation as it is","+            return null;","+        }","         if (!request.headers().contains(HttpHeaderNames.ACCEPT_ENCODING)) {","             // without the header there is nothing to iterate","             return null;","@@ -134,6 +138,12 @@ Session prepare(ChannelHandlerContext ctx, HttpRequest request, HttpResponse res","             return null;","         }","         response.headers().add(HttpHeaderNames.CONTENT_ENCODING, encoding.contentEncoding);","+        String entityTag = response.headers().get(HttpHeaderNames.ETAG);","+        if (entityTag != null && !entityTag.startsWith(\"W/\")) {","+            // a strong entity tag names the bytes as they are: the compressed bytes are only a","+            // semantically equivalent representation, as with the gzip module of nginx","+            response.headers().set(HttpHeaderNames.ETAG, \"W/\" + entityTag);","+        }","         Supplier<ChannelHandler> handler = switch (encoding) {","             case BR -> zlibCodecFactory::newBrotliEncoder;","             case ZSTD -> () -> zlibCodecFactory.newZstdEncoder(strategy.getCompressionLevel(), strategy.getMaxZstdEncodeSize());"],"additions":10,"deletions":0,"truncated":false},{"path":"http-server-tck/src/main/java/io/micronaut/http/server/tck/tests/staticresources/PreCompressedStaticResourcesTest.java","lines":["@@ -0,0 +1,476 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.http.server.tck.tests.staticresources;","+","+import io.micronaut.context.annotation.Requires;","+import io.micronaut.context.annotation.Value;","+import io.micronaut.http.HttpResponse;","+import io.micronaut.http.annotation.Controller;","+import io.micronaut.http.annotation.Get;","+import io.micronaut.http.annotation.Post;","+import io.micronaut.http.server.routes.StaticResources;","+import io.micronaut.http.server.types.files.SystemFile;","+import io.micronaut.http.tck.ServerUnderTest;","+import io.micronaut.http.tck.ServerUnderTestProviderUtils;","+import io.micronaut.web.router.builder.HttpRouteBuilder;","+import org.jspecify.annotations.Nullable;","+import io.micronaut.web.router.builder.HttpRoutes;","+import jakarta.inject.Singleton;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.io.TempDir;","+","+import java.io.IOException;","+import java.net.URI;","+import java.io.InputStream;","+import java.net.HttpURLConnection;","+import java.net.URL;","+import java.net.http.HttpHeaders;","+import java.security.GeneralSecurityException;","+import java.security.cert.X509Certificate;","+import javax.net.ssl.HttpsURLConnection;","+import javax.net.ssl.SSLContext;","+import javax.net.ssl.TrustManager;","+import javax.net.ssl.X509TrustManager;","+import java.nio.charset.StandardCharsets;","+import java.nio.file.Files;","+import java.nio.file.Path;","+import java.util.HashMap;","+import java.util.HashSet;","+import java.util.List;","+import java.util.Locale;","+import java.util.Map;","+import java.util.Set;","+","+import static org.junit.jupiter.api.Assertions.assertEquals;","+import static org.junit.jupiter.api.Assertions.assertFalse;","+import static org.junit.jupiter.api.Assertions.assertNotEquals;","+import static org.junit.jupiter.api.Assertions.assertNotNull;","+import static org.junit.jupiter.api.Assertions.assertTrue;","+","+/**","+ * Pre-compressed siblings of static resources, of the configured static resources and of","+ * {@link StaticResources#preCompressed(boolean)}, for the classpath and the file system. The","+ * requests are sent by a plain client, which does not decode the content.","+ */","+@SuppressWarnings({","+    \"java:S5960\", // We're allowed assertions, as these are used in tests only","+    \"checkstyle:MissingJavadocType\",","+    \"checkstyle:DesignForExtension\"","+})","+public class PreCompressedStaticResourcesTest {","+    public static final String SPEC_NAME = \"PreCompressedStaticResourcesTest\";","+    private static final String ROOT_PROPERTY = \"pre-compressed-static-resources.root\";","+    private static final String IDENTITY = \"console.log('identity');\";","+    private static final String BIG = \"console.log('a compressible line of javascript');\\n\".repeat(100);","+","+    /**","+     * The prefixes of the same resources: configured and functional, of the classpath and of the file system.","+     */","+    private static final List<String> PREFIXES = List.of(\"/cfg-cp\", \"/cfg-files\", \"/fn-cp\", \"/fn-files\");","+","+    @TempDir","+    Path tempDir;","+","+    private Path root;","+","+    @BeforeEach","+    void createFiles() throws IOException {","+        root = Files.createDirectories(tempDir.resolve(\"root\"));","+        Files.writeString(root.resolve(\"app.js\"), IDENTITY);","+        Files.writeString(root.resolve(\"app.js.br\"), \"br-bytes\");","+        Files.writeString(root.resolve(\"app.js.gz\"), \"gz-bytes\");","+        Files.writeString(root.resolve(\"plain.txt\"), \"plain\");","+        Files.writeString(root.resolve(\"index.html\"), \"<html>index</html>\");","+        Files.writeString(root.resolve(\"index.html.gz\"), \"gz-index\");","+        Files.writeString(tempDir.resolve(\"outside.js.gz\"), \"outside\");","+        // compressible, above the threshold of compression, with a br sibling only","+        Files.writeString(root.resolve(\"big.js\"), BIG);","+        Files.writeString(root.resolve(\"big.js.br\"), \"big-br\");","+    }","+","+    @Test","+    void theEncodingIsNegotiated() throws Exception {","+        // Accept-Encoding -> expected Content-Encoding, or null for the resource itself","+        List<Negotiation> matrix = List.of(","+            new Negotiation(null, null),","+            new Negotiation(\"br\", \"br\"),","+            new Negotiation(\"gzip\", \"gzip\"),","+            new Negotiation(\"x-gzip\", \"gzip\"),","+            new Negotiation(\"gzip, br\", \"br\"),","+            new Negotiation(\"br;q=0.5, gzip\", \"gzip\"),","+            new Negotiation(\"br;q=0, gzip;q=0.1\", \"gzip\"),","+            new Negotiation(\"*\", \"br\"),","+            new Negotiation(\"*;q=0.5, br;q=0\", \"gzip\"),","+            // no zst sibling: the next acceptable coding","+            new Negotiation(\"zstd, gzip;q=0.5\", \"gzip\"),","+            new Negotiation(\"zstd\", null),","+            new Negotiation(\"deflate\", null),","+            new Negotiation(\"identity\", null),","+            new Negotiation(\"br;q=0.5, identity\", null),","+            new Negotiation(\"gzip, identity;q=0\", \"gzip\"),","+            new Negotiation(\"br;q=0, gzip;q=0\", null),","+            new Negotiation(\"GZIP\", \"gzip\"),","+            new Negotiation(\"br;q=bad\", null)","+        );","+        try (ServerUnderTest server = server()) {","+            for (String prefix : PREFIXES) {","+                for (Negotiation row : matrix) {","+                    String acceptEncoding = row.acceptEncoding();","+                    String expected = row.expected();","+                    Response response = get(server, prefix + \"/app.js\", acceptEncoding == null ? Map.of() : Map.of(\"Accept-Encoding\", acceptEncoding));","+                    String context = prefix + \" \" + acceptEncoding;","+                    assertEquals(200, response.statusCode(), context);","+                    assertEquals(expected, response.headers().firstValue(\"Content-Encoding\").orElse(null), context);","+                    String body = expected == null ? IDENTITY : expected.charAt(0) == 'b' ? \"br-bytes\" : \"gz-bytes\";","+                    assertEquals(body, response.body(), context);","+                    assertTrue(response.headers().firstValue(\"Content-Type\").orElse(\"\").startsWith(\"application/javascript\")","+                        || response.headers().firstValue(\"Content-Type\").orElse(\"\").startsWith(\"text/javascript\"), context);","+                    assertTrue(response.headers().allValues(\"Vary\").stream().anyMatch(v -> v.toLowerCase(Locale.ROOT).contains(\"accept-encoding\")), context);","+                    assertEquals(String.valueOf(body.length()), response.headers().firstValue(\"Content-Length\").orElse(null), context);","+                }","+            }","+        }","+    }","+","+    @Test","+    void theEntityTagsDifferPerEncodingAndAreValidated() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : PREFIXES) {","+                Set<String> tags = new HashSet<>();","+                for (String encoding : new String[]{\"identity\", \"br\", \"gzip\"}) {","+                    Response response = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", encoding));","+                    String tag = response.headers().firstValue(\"ETag\").orElse(null);","+                    assertNotNull(tag, prefix + \" \" + encoding);","+                    assertTrue(tags.add(tag), prefix + \" \" + encoding);","+","+                    Response notModified = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", encoding, \"If-None-Match\", \"\\\"other\\\", \" + tag));","+                    assertEquals(304, notModified.statusCode(), prefix + \" \" + encoding);","+                    assertEquals(\"\", notModified.body());","+                    assertEquals(tag, notModified.headers().firstValue(\"ETag\").orElse(null), prefix + \" \" + encoding);","+                }","+                // the tag of another encoding is another representation","+                Response gzipTagForBr = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"gzip\"));","+                String gzipTag = gzipTagForBr.headers().firstValue(\"ETag\").orElseThrow();","+                Response modified = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"br\", \"If-None-Match\", gzipTag));","+                assertEquals(200, modified.statusCode(), prefix);","+                assertEquals(\"br-bytes\", modified.body(), prefix);","+                // If-None-Match takes precedence over If-Modified-Since","+                String lastModified = modified.headers().firstValue(\"Last-Modified\").orElseThrow();","+                Response both = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"br\", \"If-None-Match\", gzipTag, \"If-Modified-Since\", lastModified));","+                assertEquals(200, both.statusCode(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aRangeIsARangeOfTheResourceItself() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : List.of(\"/cfg-files\", \"/fn-files\")) {","+                Response partial = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"br, gzip\", \"Range\", \"bytes=0-6\"));","+                assertEquals(206, partial.statusCode(), prefix);","+                assertEquals(\"console\", partial.body(), prefix);","+                assertFalse(partial.headers().firstValue(\"Content-Encoding\").isPresent(), prefix);","+            }","+            for (String prefix : List.of(\"/cfg-cp\", \"/fn-cp\")) {","+                // no ranges of a resource in a jar, but never a compressed one","+                Response response = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"br, gzip\", \"Range\", \"bytes=0-6\"));","+                assertFalse(response.headers().firstValue(\"Content-Encoding\").isPresent(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aResourceWithoutSiblingIsServedAsItIs() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : PREFIXES) {","+                Response response = get(server, prefix + \"/plain.txt\", Map.of(\"Accept-Encoding\", \"br, gzip, zstd\"));","+                assertEquals(200, response.statusCode(), prefix);","+                assertEquals(\"plain\", response.body(), prefix);","+                assertFalse(response.headers().firstValue(\"Content-Encoding\").isPresent(), prefix);","+                // a sibling alone is not a resource of the original path","+                assertEquals(404, get(server, prefix + \"/missing.js\", Map.of(\"Accept-Encoding\", \"gzip\")).statusCode(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aForbiddenIdentityWithoutAcceptableSiblingIsTheResource() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : PREFIXES) {","+                // RFC 9110 12.5.3: the header is disregarded rather than answered with 406","+                Response plain = get(server, prefix + \"/plain.txt\", Map.of(\"Accept-Encoding\", \"br, gzip, identity;q=0\"));","+                assertEquals(200, plain.statusCode(), prefix);","+                assertEquals(\"plain\", plain.body(), prefix);","+                Response app = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"zstd, identity;q=0\"));","+                assertEquals(200, app.statusCode(), prefix);","+                assertEquals(IDENTITY, app.body(), prefix);","+                assertFalse(app.headers().firstValue(\"Content-Encoding\").isPresent(), prefix);","+                Response star = get(server, prefix + \"/plain.txt\", Map.of(\"Accept-Encoding\", \"*;q=0\"));","+                assertEquals(200, star.statusCode(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void theIndexPageHasItsSibling() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : PREFIXES) {","+                Response response = get(server, prefix + \"/\", Map.of(\"Accept-Encoding\", \"gzip\"));","+                assertEquals(200, response.statusCode(), prefix);","+                assertEquals(\"gzip\", response.headers().firstValue(\"Content-Encoding\").orElse(null), prefix);","+                assertEquals(\"gz-index\", response.body(), prefix);","+                assertTrue(response.headers().firstValue(\"Content-Type\").orElse(\"\").startsWith(\"text/html\"), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aSiblingDoesNotLeaveTheBase() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : List.of(\"/cfg-files\", \"/fn-files\")) {","+                for (String path : new String[]{\"/%2e%2e/outside.js\", \"/..%2foutside.js\", \"/sub/%2e%2e/%2e%2e/outside.js\"}) {","+                    Response response = get(server, prefix + path, Map.of(\"Accept-Encoding\", \"gzip\"));","+                    assertNotEquals(\"outside\", response.body(), prefix + path);","+                    assertNotEquals(200, response.statusCode(), prefix + path);","+                }","+            }","+        }","+    }","+","+    @Test","+    void theSiblingsAreNotServedUnlessEnabled() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : List.of(\"/cfg-off\", \"/fn-off\")) {","+                Response response = get(server, prefix + \"/app.js\", Map.of(\"Accept-Encoding\", \"br\"));","+                assertEquals(200, response.statusCode(), prefix);","+                assertFalse(response.headers().firstValue(\"ETag\").isPresent(), prefix);","+                // possibly compressed on the fly, but never the sibling","+                assertNotEquals(\"br-bytes\", response.body(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aHeadRequestHasTheHeadersOfTheSibling() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : PREFIXES) {","+                Response response = send(server, prefix + \"/app.js\", \"HEAD\", Map.of(\"Accept-Encoding\", \"br\"));","+                assertEquals(200, response.statusCode(), prefix);","+                assertEquals(\"br\", response.headers().firstValue(\"Content-Encoding\").orElse(null), prefix);","+                assertEquals(\"\", response.body(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void theResourceItselfIsCompressedOnTheFlyUnderAWeakEntityTag() throws Exception {","+        try (ServerUnderTest server = compressingServer()) {","+            for (String prefix : List.of(\"/cfg-files\", \"/fn-files\")) {","+                Response identity = get(server, prefix + \"/big.js\", Map.of(\"Accept-Encoding\", \"identity\"));","+                String tag = identity.headers().firstValue(\"ETag\").orElseThrow();","+                assertFalse(tag.startsWith(\"W/\"), prefix);","+","+                // no gzip sibling: the resource, compressed by the server, is not the bytes of the strong tag","+                Response gzip = get(server, prefix + \"/big.js\", Map.of(\"Accept-Encoding\", \"gzip\"));","+                assertEquals(200, gzip.statusCode(), prefix);","+                if (gzip.headers().firstValue(\"Content-Encoding\").isPresent()) {","+                    assertEquals(\"W/\" + tag, gzip.headers().firstValue(\"ETag\").orElse(null), prefix);","+                    // the client revalidates with the weak tag","+                    Response notModified = get(server, prefix + \"/big.js\", Map.of(\"Accept-Encoding\", \"gzip\", \"If-None-Match\", \"W/\" + tag));","+                    assertEquals(304, notModified.statusCode(), prefix);","+                }","+","+                // the sibling is not compressed again","+                Response br = get(server, prefix + \"/big.js\", Map.of(\"Accept-Encoding\", \"br\"));","+                assertEquals(\"br\", br.headers().firstValue(\"Content-Encoding\").orElse(null), prefix);","+                assertEquals(\"big-br\", br.body(), prefix);","+","+                // a range is a range of the bytes of the resource, never compressed","+                Response partial = get(server, prefix + \"/big.js\", Map.of(\"Accept-Encoding\", \"gzip\", \"Range\", \"bytes=0-6\"));","+                assertEquals(206, partial.statusCode(), prefix);","+                assertEquals(\"console\", partial.body(), prefix);","+                assertFalse(partial.headers().firstValue(\"Content-Encoding\").isPresent(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aRangeWithTheStrongEntityTagInIfRangeIsPartialContent() throws Exception {","+        try (ServerUnderTest server = server()) {","+            for (String prefix : List.of(\"/cfg-files\", \"/fn-files\")) {","+                String tag = get(server, prefix + \"/app.js\", Map.of()).headers().firstValue(\"ETag\").orElseThrow();","+                Response partial = get(server, prefix + \"/app.js\", Map.of(\"Range\", \"bytes=0-6\", \"If-Range\", tag));","+                assertEquals(206, partial.statusCode(), prefix);","+                assertEquals(\"console\", partial.body(), prefix);","+                Response other = get(server, prefix + \"/app.js\", Map.of(\"Range\", \"bytes=0-6\", \"If-Range\", \"\\\"other\\\"\"));","+                assertEquals(200, other.statusCode(), prefix);","+                Response weak = get(server, prefix + \"/app.js\", Map.of(\"Range\", \"bytes=0-6\", \"If-Range\", \"W/\" + tag));","+                assertEquals(200, weak.statusCode(), prefix);","+            }","+        }","+    }","+","+    @Test","+    void aFileResponseToAPostIsNotNotModified() throws Exception {","+        try (ServerUnderTest server = server()) {","+            Response response = send(server, \"/post-file\", \"POST\", Map.of(\"If-None-Match\", \"\\\"post-tag\\\"\"));","+            assertEquals(200, response.statusCode());","+            assertEquals(IDENTITY, response.body());","+            Response get = get(server, \"/post-file\", Map.of(\"If-None-Match\", \"\\\"post-tag\\\"\"));","+            assertEquals(304, get.statusCode());","+        }","+    }","+","+    private ServerUnderTest compressingServer() {","+        return ServerUnderTestProviderUtils.getServerUnderTestProvider().getServer(SPEC_NAME, Map.of(","+            ROOT_PROPERTY, root.toString(),","+            \"micronaut.router.static-resources.cfg-files.mapping\", \"/cfg-files/**\",","+            \"micronaut.router.static-resources.cfg-files.paths\", \"file:\" + root,","+            \"micronaut.router.static-resources.cfg-files.pre-compressed\", true","+        ));","+    }","+","+    private ServerUnderTest server() {","+        return ServerUnderTestProviderUtils.getServerUnderTestProvider().getServer(SPEC_NAME, Map.of(","+            ROOT_PROPERTY, root.toString(),","+            \"micronaut.server.netty.compression-threshold\", Integer.MAX_VALUE,","+            \"micronaut.router.static-resources.cfg-cp.mapping\", \"/cfg-cp/**\",","+            \"micronaut.router.static-resources.cfg-cp.paths\", \"classpath:precompressed\",","+            \"micronaut.router.static-resources.cfg-cp.pre-compressed\", true,","+            \"micronaut.router.static-resources.cfg-files.mapping\", \"/cfg-files/**\",","+            \"micronaut.router.static-resources.cfg-files.paths\", \"file:\" + root,","+            \"micronaut.router.static-resources.cfg-files.pre-compressed\", true,","+            \"micronaut.router.static-resources.cfg-off.mapping\", \"/cfg-off/**\",","+            \"micronaut.router.static-resources.cfg-off.paths\", \"classpath:precompressed\"","+        ));","+    }","+","+    private static Response get(ServerUnderTest server, String path, Map<String, String> headers) throws IOException, GeneralSecurityException {","+        return send(server, path, \"GET\", headers);","+    }","+","+    /**","+     * Sends a request with a plain {@link Http