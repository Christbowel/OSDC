b fn resolve(","+        color: Option<Self>,","+        read_force_color: impl FnOnce() -> Option<OsString>,","+    ) -> Self {","+        let color = color.unwrap_or_default();","+        match color {","+            Self::Always | Self::Never => color,","+            Self::Auto => match read_force_color() {","+                None => Self::Auto,","+                Some(value) if value.is_empty() => Self::Never,","+                Some(_) => Self::Always,","+            },","+        }","+    }","+","+    /// Returns `Some(true)` for [`Self::Always`], `Some(false)` for [`Self::Never`], and `None`","+    /// for [`Self::Auto`].","+    pub const fn as_override(self) -> Option<bool> {","+        match self {","+            Self::Auto => None,","+            Self::Always => Some(true),","+            Self::Never => Some(false),","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use std::ffi::OsString;","+","+    use super::TerminalColor::{self, Always, Auto, Never};","+","+    /// With `auto` or no flag, distinguish an unset, empty, and non-empty `FORCE_COLOR`.","+    #[test]","+    fn force_color_env_is_respected() {","+        assert_eq!(TerminalColor::resolve(None, || None), Auto);","+        assert_eq!(","+            TerminalColor::resolve(None, || Some(OsString::from(\"1\"))),","+            Always","+        );","+        assert_eq!(","+            TerminalColor::resolve(None, || Some(OsString::new())),","+            Never","+        );","+        assert_eq!(","+            TerminalColor::resolve(Some(Auto), || Some(OsString::from(\"0\"))),","+            Always","+        );","+    }","+","+    /// `--color always` and `--color never` select the output mode without reading `FORCE_COLOR`.","+    #[test]","+    fn explicit_color_skips_force_color_lookup() {","+        let read_force_color = || panic!(\"explicit color modes should not read FORCE_COLOR\");","+        assert_eq!(TerminalColor::resolve(Some(Never), read_force_color), Never);","+        assert_eq!(","+            TerminalColor::resolve(Some(Always), read_force_color),","+            Always","+        );","+    }","+}"],"additions":89,"deletions":0,"truncated":false},{"path":"crates/ruff_command_line/src/lib.rs","lines":["@@ -1,4 +1,8 @@","-//! Response-file expansion shared by the Ruff and ty command-line interfaces.","+//! Utilities shared by the Ruff and ty command-line interfaces.","+","+mod color;","+","+pub use color::TerminalColor;"," "," use std::ffi::{OsStr, OsString};"," use std::io;"],"additions":5,"deletions":1,"truncated":false},{"path":"crates/ty/docs/cli.md","lines":["@@ -43,7 +43,7 @@ ty check [OPTIONS] [PATH]..."," </dd><dt id=\"ty-check--color\"><a href=\"#ty-check--color\"><code>--color</code></a> <i>when</i></dt><dd><p>Control when colored output is used</p>"," <p>Possible values:</p>"," <ul>","-<li><code>auto</code>:  Display colors if the output goes to an interactive terminal</li>","+<li><code>auto</code>:  Only display colors if the output goes to an interactive terminal, unless a certain environment variable has been set</li>"," <li><code>always</code>:  Always display colors</li>"," <li><code>never</code>:  Never display colors</li>"," </ul></dd><dt id=\"ty-check--config\"><a href=\"#ty-check--config\"><code>--config</code></a>, <code>-c</code> <i>config-option</i></dt><dd><p>A TOML <code>&lt;KEY&gt; = &lt;VALUE&gt;</code> pair (such as you might find in a <code>ty.toml</code> configuration file)"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/ty/docs/environment.md","lines":["@@ -59,6 +59,12 @@ Used to determine the name of the active Conda environment."," Used to detect the path of an active Conda environment."," If both `VIRTUAL_ENV` and `CONDA_PREFIX` are present, `VIRTUAL_ENV` will be preferred."," ","+### `FORCE_COLOR`","+","+Controls color in `ty check` output, including when piped.","+Any non-empty value forces color, and an empty value disables it.","+`--color always` and `--color never` take