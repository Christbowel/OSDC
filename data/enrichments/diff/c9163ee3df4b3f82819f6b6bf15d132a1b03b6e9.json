 the total file size declared in","+\t// meta.Thanos.Files.","+\tMaxBlockSizeBytes int64","+}","+","+// CheckBlockOnDisk verifies that:","+//","+//  1. The sum of file sizes does not exceed opts.MaxBlockSizeBytes (when set).","+//  2. Every file listed in meta.Thanos.Files exists at blockDir as a regular","+//     file with the declared SizeBytes (meta.json itself is exempt from the","+//     size match because it may be persisted under a different name on disk).","+//  3. block.VerifyBlock succeeds against meta's declared time range.","+//","+// CheckBlockOnDisk does not download the block; callers must materialise","+// the block on disk first.","+func CheckBlockOnDisk(ctx context.Context, logger log.Logger, blockDir string, meta *block.Meta, opts CheckBlockOnDiskOptions) error {","+\tif meta == nil {","+\t\treturn fmt.Errorf(\"missing block metadata\")","+\t}","+","+\tif err := CheckMaxBlockSize(meta.Thanos.Files, opts.MaxBlockSizeBytes); err != nil {","+\t\treturn err","+\t}","+","+\tfor _, f := range meta.Thanos.Files {","+\t\tfi, err := os.Stat(filepath.Join(blockDir, filepath.FromSlash(f.RelPath)))","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"failed to stat %s: %w\", f.RelPath, err)","+\t\t}","+\t\tif !fi.Mode().IsRegular() {","+\t\t\treturn fmt.Errorf(\"not a file: %s\", f.RelPath)","+\t\t}","+\t\tif f.RelPath != block.MetaFilename && fi.Size() != f.SizeBytes {","+\t\t\treturn fmt.Errorf(\"file size mismatch for %s\", f.RelPath)","+\t\t}","+\t}","+","+\tif err := block.VerifyBlock(ctx, logger, blockDir, meta.MinTime, meta.MaxTime, opts.CheckChunks); err != nil {","+\t\treturn fmt.Errorf(\"error validating block: %w\", err)","+\t}","+","+\treturn nil","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"pkg/storage/tsdb/block/blockvalidation/disk_test.go","lines":["@@ -0,0 +1,151 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+package blockvalidation","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"io/fs\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/prometheus/prometheus/model/labels\"","+\t\"github.com/prometheus/prometheus/tsdb/chunks\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/mimir/pkg/storage/tsdb/block\"","+\ttestutil \"github.com/grafana/mimir/pkg/util/test\"","+)","+","+// generateBlockOnDisk writes a real TSDB block under parent, populates","+// meta.Thanos.Files from the on-disk contents (block.GenerateBlockFromSpec","+// leaves Files empty), and returns the block directory along with its meta.","+func generateBlockOnDisk(t *testing.T, parent string) (string, *block.Meta) {","+\tt.Helper()","+\tsamples := []chunks.Sample{","+\t\ttestutil.Sample{TS: 1_000, Val: 1.0},","+\t\ttestutil.Sample{TS: 2_000, Val: 2.0},","+\t\ttestutil.Sample{TS: 3_000, Val: 3.0},","+\t}","+\tmakeChunk := func() chunks.Meta {","+\t\tc, err := chunks.ChunkFromSamples(samples)","+\t\trequire.NoError(t, err)","+\t\treturn c","+\t}","+\tspecs := []*block.SeriesSpec{","+\t\t{Labels: labels.FromStrings(\"__name__\", \"metric_a\"), Chunks: []chunks.Meta{makeChunk()}},","+\t\t{Labels: labels.FromStrings(\"__name__\", \"metric_b\"), Chunks: []chunks.Meta{makeChunk()}},","+\t}","+\tmeta, err := block.GenerateBlockFromSpec(parent, specs)","+\trequire.NoError(t, err)","+\tdir := filepath.Join(parent, meta.ULID.String())","+\tmeta.Thanos.Files = walkBlockFiles(t, dir)","+\treturn dir, meta","+}","+","+// walkBlockFiles enumerates the on-disk block files, returning entries","+// suitable for meta.Thanos.Files: the meta.json entry carries no size, every","+// other entry records the file size.","+func walkBlockFiles(t *testing.T, blockDir string) []block.File {","+\tt.Helper()","+\tvar out []block.File","+\terr := filepath.WalkDir(blockDir, func(path string, d fs.DirEntry, err error) error {","+\t\trequire.NoError(t, err)","+\t\tif d.IsDir() {","+\t\t\treturn nil","+\t\t}","+\t\trel, err := filepath.Rel(blockDir, path)","+\t\trequire.NoError(t, err)","+\t\trel = filepath.ToSlash(rel)","+\t\tif rel == block.MetaFilename {","+\t\t\tout = append(out, block.File{RelPath: rel})","+\t\t\treturn nil","+\t\t}","+\t\tinfo, err := d.Info()","+\t\trequire.NoError(t, err)","+\t\tout = append(out, block.File{RelPath: rel, SizeBytes: info.Size()})","+\t\treturn nil","+\t})","+\trequire.NoError(t, err)","+\treturn out","+}","+","+func TestCheckBlockOnDisk_NilMeta(t *testing.T) {","+\terr := CheckBlockOnDisk(context.Background(), log.NewNopLogger(), t.TempDir(), nil, CheckBlockOnDiskOptions{})","+\trequire.Error(t, err)","+\tassert.Contains(t, err.Error(), \"missing block metadata\")","+}","+","+func TestCheckBlockOnDisk_Valid(t *testing.T) {","+\tdir, meta := generateBlockOnDisk(t, t.TempDir())","+\tctx := context.Background()","+","+\trequire.NoError(t, CheckBlockOnDisk(ctx, log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{CheckChunks: false}))","+\trequire.NoError(t, CheckBlockOnDisk(ctx, log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{CheckChunks: true}))","+}","+","+func TestCheckBlockOnDisk_MissingFile(t *testing.T) {","+\tdir, meta := generateBlockOnDisk(t, t.TempDir())","+\t// Delete the index file declared in meta.","+\trequire.NoError(t, os.Remove(filepath.Join(dir, \"index\")))","+","+\terr := CheckBlockOnDisk(context.Background(), log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{})","+\trequire.Error(t, err)","+\tassert.Contains(t, err.Error(), \"failed to stat index\")","+}","+","+func TestCheckBlockOnDisk_SizeMismatch(t *testing.T) {","+\tdir, meta := generateBlockOnDisk(t, t.TempDir())","+\t// Truncate the first chunks segment so its on-disk size diverges from the declared size.","+\trequire.NoError(t, os.Truncate(filepath.Join(dir, \"chunks\", \"000001\"), 10))","+","+\terr := CheckBlockOnDisk(context.Background(), log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{})","+\trequire.Error(t, err)","+\tassert.Contains(t, err.Error(), \"file size mismatch for chunks/000001\")","+}","+","+func TestCheckBlockOnDisk_NotARegularFile(t *testing.T) {","+\tdir, meta := generateBlockOnDisk(t, t.TempDir())","+\t// Replace the index file with a directory of the same name.","+\tindexPath := filepath.Join(dir, \"index\")","+\trequire.NoError(t, os.Remove(indexPath))","+\trequire.NoError(t, os.Mkdir(indexPath, 0o755))","+","+\terr := CheckBlockOnDisk(context.Background(), log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{})","+\trequire.Error(t, err)","+\tassert.Contains(t, err.Error(), \"not a file: index\")","+}","+","+func TestCheckBlockOnDisk_MaxBlockSizeEnforced(t *testing.T) {","+\tdir, meta := generateBlockOnDisk(t, t.TempDir())","+","+\t// Sum declared file sizes; cap one byte below that to force a rejection.","+\tvar declared int64","+\tfor _, f := range meta.Thanos.Files {","+\t\tdeclared += f.SizeBytes","+\t}","+\trequire.Greater(t, declared, int64(0), \"expected non-zero declared block size\")","+","+\terr := CheckBlockOnDisk(context.Background(), log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{MaxBlockSizeBytes: declared - 1})","+\trequire.Error(t, err)","+\tassert.Equal(t, fmt.Sprintf(MaxBlockSizeBytesFormat, declared-1), err.Error())","+}","+","+func TestCheckBlockOnDisk_VerifyBlockCatchesMangledIndex(t *testing.T) {","+\tdir, meta := generateBlockOnDisk(t, t.TempDir())","+\t// Zero out the first 100 bytes of the index file while preserving its size,","+\t// so the file-size precheck passes and block.VerifyBlock has to catch the","+\t// structural damage.","+\tf, err := os.OpenFile(filepath.Join(dir, \"index\"), os.O_RDWR, 0)","+\trequire.NoError(t, err)","+\t_, err = f.WriteAt(make([]byte, 100), 0)","+\trequire.NoError(t, err)","+\trequire.NoError(t, f.Close())","+","+\terr = CheckBlockOnDisk(context.Background(), log.NewNopLogger(), dir, meta, CheckBlockOnDiskOptions{})","+\trequire.Error(t, err)","+\tassert.Contains(t, err.Error(), \"error validating block\")","+}"],"additions":151,"deletions":0,"truncated":false},{"path":"pkg/storage/tsdb/block/blockvalidation/meta.go","lines":["@@ -0,0 +1,181 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+// Package blockvalidation provides reusable validation routines for TSDB","+// blocks destined for ingestion into a Mimir tenant.","+package blockvalidation","+","+import (","+\t\"errors\"","+\t\"fmt\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/go-kit/log/level\"","+\t\"github.com/grafana/regexp\"","+\t\"github.com/oklog/ulid/v2\"","+","+\t\"github.com/grafana/mimir/pkg/storage/sharding\"","+\t\"github.com/grafana/mimir/pkg/storage/tsdb/block\"","+)","+","+// MaxBlockSizeBytesFormat is the error message format used when a block","+// exceeds the configured maximum size.","+const MaxBlockSizeBytesFormat = \"block exceeds the maximum block size limit of %d bytes\"","+","+// MaxBlockInvalidSizeError reports that the sum of declared file sizes in a","+// block exceeded the configured maximum or overflowed int64.","+//","+// SizeBytes may be negative if the sum overflows int64.","+type MaxBlockInvalidSizeError struct {","+\tLimitBytes int64","+\tSizeBytes  int64","+}","+","+func (e *MaxBlockInvalidSizeError) Error() string {","+\treturn fmt.Sprintf(MaxBlockSizeBytesFormat, e.LimitBytes)","+}","+","+// uploadSource is the value written to meta.Thanos.Source by","+// SanitizeForUpload to mark a block as having entered the cluster via the","+// block-upload API.","+const uploadSource = \"upload\"","+","+// AllowedRelPath matches the relative paths that may appear in","+// meta.Thanos.Files alongside the meta.json file itself. Any other path is","+// rejected by CheckMeta.","+var AllowedRelPath = regexp.MustCompile(`^(index|chunks/\\d{6})$`)","+","+// CheckMetaOptions configures CheckMeta.","+type CheckMetaOptions struct {","+\t// MaxBlockSizeBytes is an upper bound on the sum of file sizes declared","+\t// in meta.Thanos.Files. A value <=0 disables the check.","+\tMaxBlockSizeBytes int64","+}","+","+// CheckMeta runs read-only validation against meta.","+func CheckMeta(meta *block.Meta, opts CheckMetaOptions) error {","+\tif meta == nil {","+\t\treturn errors.New(\"missing block metadata\")","+\t}","+","+\tif meta.Thanos.Downsample.Resolution > 0 {","+\t\treturn errors.New(\"block contains downsampled data\")","+\t}","+","+\tfor l, v := range meta.Thanos.Labels {","+\t\tswitch l {","+\t\tcase block.CompactorShardIDExternalLabel:","+\t\t\tif v == \"\" {","+\t\t\t\t// Empty shard labels are stripped by SanitizeForUpload; accept here.","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif _, _, err := sharding.ParseShardIDLabelValue(v); err != nil {","+\t\t\t\treturn fmt.Errorf(\"invalid %s external label: %q\", block.CompactorShardIDExternalLabel, v)","+\t\t\t}","+\t\tcase block.DeprecatedTenantIDExternalLabel, block.DeprecatedIngesterIDExternalLabel, block.DeprecatedShardIDExternalLabel:","+\t\t\t// Deprecated labels are removed by SanitizeForUpload; accept here.","+\t\t\tcontinue","+\t\tdefault:","+\t\t\treturn fmt.Errorf(\"unsupported external label: %s\", l)","+\t\t}","+\t}","+","+\tfor _, f := range meta.Thanos.Files {","+\t\tif f.RelPath == block.MetaFilename {","+\t\t\tcontinue","+\t\t}","+\t\tif !AllowedRelPath.MatchString(f.RelPath) {","+\t\t\treturn fmt.Errorf(\"file with invalid path: %s\", f.RelPath)","+\t\t}","+\t\tif f.SizeBytes <= 0 {","+\t\t\treturn fmt.Errorf(\"file with invalid size: %s\", f.RelPath)","+\t\t}","+\t}","+","+\tif err := CheckMaxBlockSize(meta.Thanos.Files, opts.MaxBlockSizeBytes); err != nil {","+\t\treturn err","+\t}","+","+\tif meta.Version != block.TSDBVersion1 {","+\t\treturn fmt.Errorf(\"version must be %d\", block.TSDBVersion1)","+\t}","+","+\tif meta.MinTime < 0 || meta.MaxTime < 0 || meta.MaxTime < meta.MinTime {","+\t\treturn fmt.Errorf(\"invalid minTime/maxTime: minTime=%d, maxTime=%d\", meta.MinTime, meta.MaxTime)","+\t}","+","+\tnow := time.Now()","+\tif meta.MinTime > now.UnixMilli() || meta.MaxTime > now.UnixMilli() {","+\t\treturn fmt.Errorf(\"block time(s) greater than the present: minTime=%d (%s), maxTime=%d (%s)\",","+\t\t\tmeta.MinTime, formatTime(time.UnixMilli(meta.MinTime)),","+\t\t\tmeta.MaxTime, formatTime(time.UnixMilli(meta.MaxTime)))","+\t}","+","+\treturn nil","+}","+","+// SanitizeForUpload mutates meta to bring it in line with the conventions","+// the compactor enforces when a block enters the cluster via the","+// block-upload API:","+//","+//   - meta.ULID is overwritten with blockID (the upload's URL parameter)","+//   - empty CompactorShardIDExternalLabel and deprecated external labels are removed","+//   - meta.Compaction.Parents is cleared and Sources is reset to {blockID}","+//   - meta.Thanos.Source is set to \"upload\"","+//","+// SanitizeForUpload performs no validation; callers should run CheckMeta","+// afterwards (or before, to surface issues unaffected by the mutations).","+// Returns immediately when meta is nil.","+func SanitizeForUpload(logger log.Logger, meta *block.Meta, blockID ulid.ULID) {","+\tif meta == nil {","+\t\treturn","+\t}","+","+\tmeta.ULID = blockID","+","+\tfor l, v := range meta.Thanos.Labels {","+\t\tswitch l {","+\t\tcase block.CompactorShardIDExternalLabel:","+\t\t\tif v == \"\" {","+\t\t\t\tlevel.Debug(logger).Log(\"msg\", \"removing empty external label\", \"label\", l)","+\t\t\t\tdelete(meta.Thanos.Labels, l)","+\t\t\t}","+\t\tcase block.DeprecatedTenantIDExternalLabel, block.DeprecatedIngesterIDExternalLabel, block.DeprecatedShardIDExternalLabel:","+\t\t\tlevel.Debug(logger).Log(\"msg\", \"removing unused external label\", \"label\", l, \"value\", v)","+\t\t\tdelete(meta.Thanos.Labels, l)","+\t\t}","+\t}","+","+\tmeta.Compaction.Parents = nil","+\tmeta.Compaction.Sources = []ulid.ULID{blockID}","+\tmeta.Thanos.Source = uploadSource","+}","+","+// CheckMaxBlockSize returns a non-nil error if the sum of file sizes exceeds","+// maxBlockSizeBytes. maxBlockSizeBytes <= 0 disables the check.","+func CheckMaxBlockSize(files []block.File, maxBlockSizeBytes int64) error {","+\tif maxBlockSizeBytes <= 0 {","+\t\treturn nil","+\t}","+","+\tblockSizeBytes := int64(0)","+\tfor _, f := range files {","+\t\tif f.SizeBytes < 0 {","+\t\t\treturn errors.New(\"invalid negative file size in block metadata\")","+\t\t}","+\t\tblockSizeBytes += f.SizeBytes","+\t\tif blockSizeBytes < 0 {","+\t\t\t// overflow","+\t\t\tbreak","+\t\t}","+\t}","+","+\tif blockSizeBytes > maxBlockSizeBytes || blockSizeBytes < 0 {","+\t\treturn &MaxBlockInvalidSizeError{LimitBytes: maxBlockSizeBytes, SizeBytes: blockSizeBytes}","+\t}","+\treturn nil","+}","+","+func formatTime(t time.Time) string {","+\treturn t.UTC().Format(time.RFC3339)","+}"],"additions":181,"deletions":0,"truncated":false},{"path":"pkg/storage/tsdb/block/blockvalidation/meta_test.go","lines":["@@ -0,0 +1,320 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+package blockvalidation","+","+import (","+\tcrypto_rand \"crypto/rand\"","+\t\"errors\"","+\t\"fmt\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/oklog/ulid/v2\"","+\t\"github.com/prometheus/prometheus/tsdb\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/mimir/pkg/storage/tsdb/block\"","+)","+","+// newULID returns a fresh ULID with cryptographic entropy so tests that compare","+// two successive ULIDs always see distinct values.","+func newULID() ulid.ULID {","+\treturn ulid.MustNew(ulid.Now(), crypto_rand.Reader)","+}","+","+func newValidMeta() *block.Meta {","+\tid := newULID()","+\treturn &block.Meta{","+\t\tBlockMeta: tsdb.BlockMeta{","+\t\t\tULID:    id,","+\t\t\tMinTime: 1_000,","+\t\t\tMaxTime: 2_000,","+\t\t\tVersion: block.TSDBVersion1,","+\t\t},","+\t\tThanos: block.ThanosMeta{","+\t\t\tLabels: map[string]string{},","+\t\t\tFiles: []block.File{","+\t\t\t\t{RelPath: \"index\", SizeBytes: 100},","+\t\t\t\t{RelPath: \"chunks/000001\", SizeBytes: 200},","+\t\t\t\t{Re