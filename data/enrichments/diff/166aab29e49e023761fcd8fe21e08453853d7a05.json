{"id":"166aab29e49e023761fcd8fe21e08453853d7a05","axis":"silent","repo":"grafana/grafana","sha":"166aab29e49e023761fcd8fe21e08453853d7a05","parsed":{"files":[{"path":"devenv/dev-dashboards/panel-text/text-panel.json","lines":["@@ -602,6 +602,43 @@","             }","           }","         }","+      },","+      \"panel-7\": {","+        \"kind\": \"Panel\",","+        \"spec\": {","+          \"id\": 7,","+          \"title\": \"Mermaid diagrams\",","+          \"description\": \"\",","+          \"links\": [],","+          \"data\": {","+            \"kind\": \"QueryGroup\",","+            \"spec\": {","+              \"queries\": [],","+              \"transformations\": [],","+              \"queryOptions\": {}","+            }","+          },","+          \"vizConfig\": {","+            \"kind\": \"VizConfig\",","+            \"group\": \"text\",","+            \"version\": \"13.2.0-local\",","+            \"spec\": {","+              \"options\": {","+                \"code\": {","+                  \"language\": \"plaintext\",","+                  \"showLineNumbers\": false,","+                  \"showMiniMap\": false","+                },","+                \"content\": \"## Mermaid diagrams\\n\\n```mermaid\\ngraph TD\\n  A[Query] --> B{Threshold breached?}\\n  B -->|Yes| C[Page on-call]\\n  B -->|No| D[Record metric]\\n```\\n\\n### Sequence\\n\\n```mermaid\\nsequenceDiagram\\n  Grafana->>Datasource: query\\n  Datasource-->>Grafana: frames\\n```\\n\\n### Invalid syntax falls back to the source\\n\\n```mermaid\\ngraph TD\\n  A -->\\n```\\n\",","+                \"mode\": \"markdown\"","+              },","+              \"fieldConfig\": {","+                \"defaults\": {},","+                \"overrides\": []","+              }","+            }","+          }","+        }","       }","     },","     \"layout\": {","@@ -698,6 +735,19 @@","                 \"name\": \"panel-8\"","               }","             }","+          },","+          {","+            