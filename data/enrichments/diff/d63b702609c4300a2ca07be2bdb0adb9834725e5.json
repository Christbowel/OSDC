t\t\t{\"combined\", true, true},","+\t\t} {","+\t\t\tmlxtest.RunSubtest(t, policy.name+\"/\"+path.name, func(t *mlxtest.T) {","+\t\t\t\tmlx.Scoped(func() {","+\t\t\t\t\tm := newDraftRotaryTestModel(t, policy.field)","+\t\t\t\t\tcaches := m.NewCaches()","+\t\t\t\t\tfor _, c := range caches {","+\t\t\t\t\t\tdefer c.Free()","+\t\t\t\t\t}","+\t\t\t\t\tvar oracle draftRotaryOracle","+\t\t\t\t\t// Seed the real caches without invoking either rotary path.","+\t\t\t\t\t// Block-only must not fail because context maintenance is broken.","+\t\t\t\t\tseed := []float32{0.25, -0.5, 0.75, 0.25, -0.5, 1}","+\t\t\t\t\tfor i, c := range caches {","+\t\t\t\t\t\tc.(cache.Attention).Update(&batch.Batch{SeqOffsets: []int32{0}},","+\t\t\t\t\t\t\tmlx.Zeros(mlx.DTypeFloat32, 1, 1, 3, 2), mlx.FromValues(seed, 1, 1, 3, 2))","+\t\t\t\t\t\toracle.keys[i] = make([]float64, len(seed))","+\t\t\t\t\t\tfor _, v := range seed {","+\t\t\t\t\t\t\toracle.values[i] = append(oracle.values[i], float64(v))","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t\tfor round := range 2 {","+\t\t\t\t\t\tstart := caches[0].Offset()","+\t\t\t\t\t\tb := &batch.Batch{SeqOffsets: []int32{int32(start)}}","+\t\t\t\t\t\tvar context, block []float64","+\t\t\t\t\t\tif path.context {","+\t\t\t\t\t\t\tcontext = []float64{1, 2, -3, 1}","+\t\t\t\t\t\t\tb.Hidden = mlx.FromValues([]float32{1, 2, -3, 1}, 1, 2, 2)","+\t\t\t\t\t\t}","+\t\t\t\t\t\tif path.block {","+\t\t\t\t\t\t\tblock = []float64{1, 2, -2, 1, 0.5, -1}","+\t\t\t\t\t\t\tb.InputIDs = mlx.FromValues([]int32{0, 1, 2}, 1, 3)","+\t\t\t\t\t\t\tb.SeqQueryLens = []int32{3}","+\t\t\t\t\t\t}","+\t\t\t\t\t\twant := oracle.forward(context, block, start, policy.noRoPE)","+\t\t\t\t\t\thidden, aux := m.Forward(b, nil, caches)","+\t\t\t\t\t\tlabel := fmt.Sprintf(\"round %d offset %d\", round, start)","+\t\t\t\t\t\tif !path.block {","+\t\t\t\t\t\t\tif hidden != nil || aux != nil {","+\t\t\t\t\t\t\t\tt.Fatal(\"context-only forward returned block hidden states\")","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\tif hidden == nil || aux != hidden {","+\t\t\t\t\t\t\t\tt.Fatal(\"block forward did not return shared hidden/aux states\")","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tcheckDraftRotaryArray(t, label+\" hidden\", hidden, want)","+\t\t\t\t\t\t}","+\t\t\t\t\t\tfor i, c := range caches {","+\t\t\t\t\t\t\tif wantOffset := len(oracle.keys[i]) / 2; c.Offset() != wantOffset {","+\t\t\t\t\t\t\t\tt.Fatalf(\"%s layer %d cache offset=%d want=%d\", label, i, c.Offset(), wantOffset)","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tstate := c.State()","+\t\t\t\t\t\t\tif len(state) != 2 {","+\t\t\t\t\t\t\t\tt.Fatalf(\"%s layer %d state roots=%d want=2\", label, i, len(state))","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tcheckDraftRotaryArray(t, fmt.Sprintf(\"%s layer %d keys\", label, i), state[0], oracle.keys[i])","+\t\t\t\t\t\t\tcheckDraftRotaryArray(t, fmt.Sprintf(\"%s layer %d values\", label, i), state[1], oracle.values[i])","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t})","+\t\t\t})","+\t\t}","+\t}","+}","+","+type windowedDraftTarget struct {","+\t*draftRotaryTarget","+\twindow int","+}","+","+func (t *windowedDraftTarget) DraftWindow() int { return t.window }","+","+func checkDraftWindowValues(t *mlxtest.T, label string, array *mlx.Array, want []float64) {","+\tt.Helper()","+\tarray = mlx.Contiguous(array, false).AsType(mlx.DTypeFloat32)","+\tmlx.Eval(array)","+\tgot := array.Floats()","+\twantFloat := make([]float32, len(want))","+\tfor i, v := range want {","+\t\twantFloat[i] = float32(v)","+\t}","+\tslices.Sort(got)","+\tslices.Sort(wantFloat)","+\tif !slices.Equal(got, wantFloat) {","+\t\tt.Fatalf(\"%s values = %v, want %v\", label, got, wantFloat)","+\t}","+}","+","+func TestDraftWindowCache(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname             string","+\t\ttarget           draftTarget","+\t\tinitial, wrapped [][]float64","+\t}{","+\t\t{","+\t\t\tname: \"default\", target: &draftRotaryTarget{},","+\t\t\tinitial: [][]float64{{2, 3}, {0, 1, 2, 3}},","+\t\t\twrapped: [][]float64{{3, 4}, {0, 1, 2, 3, 4}},","+\t\t},","+\t\t{","+\t\t\tname: \"bounded\", target: &windowedDraftTarget{draftRotaryTarget: &draftRotaryTarget{}, window: 3},","+\t\t\tinitial: [][]float64{{2, 3}, {1, 2, 3}},","+\t\t\twrapped: [][]float64{{3, 4}, {2, 3, 4}},","+\t\t},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tmlxtest.Run(t, func(t *mlxtest.T) {","+\t\t\t\tm := &Model{","+\t\t\t\t\tConfig: &Config{SlidingWindow: 2},","+\t\t\t\t\tLayers: []*Layer{{IsSliding: true}, {IsSliding: false}},","+\t\t\t\t\ttarget: tc.target,","+\t\t\t\t}","+\t\t\t\tcaches := m.NewCaches()","+\t\t\t\tdefer func() {","+\t\t\t\t\tfor _, c := range caches {","+\t\t\t\t\t\tc.Free()","+\t\t\t\t\t}","+\t\t\t\t}()","+\t\t\t\tinitial := &batch.Batch{SeqOffsets: []int32{0}, SeqQueryLens: []int32{4}}","+\t\t\t\tvalues := mlx.FromValues([]float32{0, 1, 2, 3}, 1, 1, 4, 1)","+\t\t\t\tfor i, c := range caches {","+\t\t\t\t\tc.(cache.Attention).Update(initial, values, values)","+\t\t\t\t\tcheckDraftWindowValues(t, fmt.Sprintf(\"initial cache %d\", i), c.(cache.Attention).View(initial).V(), tc.initial[i])","+\t\t\t\t\tc.PrepareSnapshots([]int{4})","+\t\t\t\t\tnext := &batch.Batch{SeqOffsets: []int32{4}, SeqQueryLens: []int32{1}}","+\t\t\t\t\tvalue := mlx.FromValue(float32(4))","+\t\t\t\t\tvalue = mlx.Reshape(value, 1, 1, 1, 1)","+\t\t\t\t\tc.(cache.Attention).Update(next, value, value)","+\t\t\t\t\tcheckDraftWindowValues(t, fmt.Sprintf(\"wrapped cache %d\", i), c.(cache.Attention).View(next).V(), tc.wrapped[i])","+\t\t\t\t\tsnapshots := c.TakeSnapshots()","+\t\t\t\t\tif len(snapshots) != 1 {","+\t\t\t\t\t\tt.Fatalf(\"cache %d snapshots = %d\", i, len(snapshots))","+\t\t\t\t\t}","+\t\t\t\t\tif !c.Restore(snapshots[0], 4) {","+\t\t\t\t\t\tt.Fatalf(\"cache %d could not restore\", i)","+\t\t\t\t\t}","+\t\t\t\t\tif snapshots[0] != nil {","+\t\t\t\t\t\tsnapshots[0].Close()","+\t\t\t\t\t}","+\t\t\t\t\tif c.Offset() != 4 {","+\t\t\t\t\t\tt.Fatalf(\"cache %d offset = %d\", i, c.Offset())","+\t\t\t\t\t}","+\t\t\t\t\tcheckDraftWindowValues(t, fmt.Sprintf(\"restored cache %d\", i), c.(cache.Attention).View(initial).V(), tc.initial[i])","+\t\t\t\t}","+\t\t\t})","+\t\t})","+\t}","+}","+","+type draftRotaryTarget struct {","+\tmodel.Model","+\tembeddings *mlx.Array","+}","+","+func (m *draftRotaryTarget) TokenEmbeddings(ids *mlx.Array) *mlx.Array {","+\treturn m.embeddings.TakeAxis(ids, 0)","+}","+","+func (*draftRotaryTarget) RawLogits(x *mlx.Array) *mlx.Array { return x }","+func (*draftRotaryTarget) SetAuxHiddenLayers([]int)          {}","+func (*draftRotaryTarget) NumLayers() int                    { return 2 }","+","+func newDraftRotaryTestModel(t *mlxtest.T, field string) *Model {","+\tt.Helper()","+\tcfg, err := parseConfig(draftRotaryTestConfig(field))","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tm := &Model{","+\t\tConfig: cfg, Layers: make([]*Layer, cfg.NumHiddenLayers), tensorPrefix: \"draft.\",","+\t\ttarget: &draftRotaryTarget{embeddings: mlx.FromValues([]float32{1, 2, -2, 1, 0.5, -1}, 3, 2)},","+\t}","+\tidentity := mlx.FromValues([]float32{1, 0, 0, 1}, 2, 2)","+\tones := mlx.FromValues([]float32{1, 1}, 2)","+\tzero := mlx.Zeros(mlx.DTypeFloat32, 2, 2)","+\ttensors := map[string]*mlx.Array{","+\t\t\"draft.fc.weight\": identity, \"draft.hidden_norm.weight\": ones, \"draft.norm.weight\": ones,","+\t}","+\tfor i := range m.Layers {","+\t\tprefix := fmt.Sprintf(\"draft.layers.%d.\", i)","+\t\tfor _, name := range []string{\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\"} {","+\t\t\ttensors[prefix+\"self_attn.\"+name+\".weight\"] = identity","+\t\t}","+\t\tfor _, name := range []string{\"input_layernorm\", \"post_attention_layernorm\", \"self_attn.q_norm\", \"self_attn.k_norm\"} {","+\t\t\ttensors[prefix+name+\".weight\"] = ones","+\t\t}","+\t\tfor _, name := range []string{\"gate_proj\", \"up_proj\", \"down_proj\"} {","+\t\t\ttensors[prefix+\"mlp.\"+name+\".weight\"] = zero","+\t\t}","+\t}","+\tif err := m.LoadWeights(tensors); err != nil {","+\t\tt.Fatal(err)","+\t}","+\treturn m","+}","+","+func checkDraftRotaryArray(t *mlxtest.T, label string, array *mlx.Array, want []float64) {","+\tt.Helper()","+\t// Cache state can be a strided view; Floats requires contiguous storage.","+\tarray = mlx.Contiguous(array, false).AsType(mlx.DTypeFloat32)","+\tmlx.Eval(array)","+\tgot := array.Floats()","+\tif len(got) != len(want) {","+\t\tt.Fatalf(\"%s length=%d want=%d\", label, len(got), len(want))","+\t}","+\tfor i, v := range got {","+\t\tif math.IsNaN(float64(v)) || math.Abs(float64(v)-want[i]) > 2e-3*math.Max(1, math.Abs(want[i])) {","+\t\t\tt.Errorf(\"%s[%d]: got %g want %g\", label, i, v, want[i])","+\t\t\treturn","+\t\t}","+\t}","+}","+","+// This two-wide scalar model has identity projections, unit norms, zero MLPs,","+// and a window larger than its history. It does not call production RoPE/SDPA.","+type draftRotaryOracle struct {","+\tkeys, values [2][]float64","+}","+","+func draftRotaryNorm(x []float64) []float64 {","+\tout := make([]float64, len(x))","+\tfor r := 0; r < len(x); r += 2 {","+\t\tinv := 1 / math.Sqrt((x[r]*x[r]+x[r+1]*x[r+1])/2+1e-6)","+\t\tout[r], out[r+1] = x[r]*inv, x[r+1]*inv","+\t}","+\treturn out","+}","+","+func draftRotaryRotate(x []float64, start int) []float64 {","+\tout := slices.Clone(x)","+\tfor r := 0; r < len(x); r += 2 {","+\t\ts, c := math.Sincos(float64(start + r/2))","+\t\tout[r], out[r+1] = x[r]*c-x[r+1]*s, x[r]*s+x[r+1]*c","+\t}","+\treturn out","+}","+","+func (o *draftRotaryOracle) forward(context, block []float64, start int, noRoPE [2]bool) []float64 {","+\tcontextValues := draftRotaryNorm(context)","+\tx := slices.Clone(block)","+\tfor layer := range o.keys {","+\t\tcontextKeys := draftRotaryNorm(contextValues)","+\t\tvalues := draftRotaryNorm(x)","+\t\tq := draftRotaryNorm(values)","+\t\tk := slices.Clone(q)","+\t\tif !noRoPE[layer] {","+\t\t\tcontextKeys = draftRotaryRotate(contextKeys, start)","+\t\t\tq = draftRotaryRotate(q, start+len(context)/2)"