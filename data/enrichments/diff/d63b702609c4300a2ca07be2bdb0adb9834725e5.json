), make([]float32, vocab*rank), make([]float32, rank)","+\t\tfor id := range vocab {","+\t\t\tfor j := range rank {","+\t\t\t\tpred[id*rank+j] = float32(id%3-1) / 32","+\t\t\t\tsucc[id*rank+j] = float32(id%5-2) / 64","+\t\t\t}","+\t\t}","+\t\tfor j := range projection {","+\t\t\tprojection[j] = 0.5","+\t\t}","+\t\tlogits := make([]float32, length*vocab)","+\t\tfor i := range logits {","+\t\t\tlogits[i] = -float32(i%vocab) / 8","+\t\t}","+\t\tm := &model2{Selector: &candidateSelector{","+\t\t\tProjection:  nn.NewLinear(mlx.FromValues(projection, rank, 1).AsType(mlx.DTypeBFloat16), nil),","+\t\t\tPredecessor: mlx.FromValues(pred, vocab, rank).AsType(mlx.DTypeBFloat16),","+\t\t\tSuccessor:   mlx.FromValues(succ, vocab, rank).AsType(mlx.DTypeBFloat16), TopK: k,","+\t\t}}","+\t\tsampler := sample.New(16)","+\t\tdefer sampler.Free()","+\t\tsampler.Add(0, sample.Options{Temperature: 1, UseSeed: true, Seed: 42}, nil)","+\t\ttokens, ids, probs := m.Select(mlx.FromValues([]float32{1, 1, 1}, 1, length, 1).AsType(mlx.DTypeBFloat16), mlx.FromValues(logits, 1, length, vocab).AsType(mlx.DTypeBFloat16), mlx.FromValues([]int32{0}, 1), func(ids, scores *mlx.Array) (*mlx.Array, *mlx.Array) {","+\t\t\ttokens, distribution := sampler.SampleCandidates(0, ids, scores)","+\t\t\treturn tokens, distribution.Probs","+\t\t})","+\t\tmlx.Eval(tokens, ids, probs)","+\t\tpath, support, q := tokens.Ints(), ids.Ints(), mlx.Contiguous(probs, false).Floats()","+\t\tprevious := 0","+\t\tfor row := range length {","+\t\t\tweights, total := make([]float64, k), float64(0)","+\t\t\tfor id := range k {","+\t\t\t\tweights[id] = math.Exp(-float64(id)/8 + float64((previous%3-1)*(id%5-2))/16)","+\t\t\t\ttotal += weights[id]","+\t\t\t}","+\t\t\tfor j, id := range support[row*k : (row+1)*k] {","+\t\t\t\tif id < 0 || id >= k {","+\t\t\t\t\tt.Fatalf(\"unexpected candidate %d\", id)","+\t\t\t\t}","+\t\t\t\tif want := weights[id] / total; math.Abs(float64(q[row*k+j])-want) > 1e-6 {","+\t\t\t\t\tt.Fatalf(\"row %d candidate %d probability=%g want=%g\", row, id, q[row*k+j], want)","+\t\t\t\t}","+\t\t\t}","+\t\t\tif !slices.Contains(support[row*k:(row+1)*k], path[row]) {","+\t\t\t\tt.Fatal(\"selected token outside proposal support\")","+\t\t\t}","+\t\t\tprevious = int(path[row])","+\t\t}","+\t})","+}","+"," func TestDFlash2ConfigValidation(t *testing.T) {"," \tvalid := Config{HiddenSize: 5120, ConvGroupSize: 16, ConvKernelSize: 2, BlockSize: 8, SelectorRank: 256, SelectorTopK: 16, VocabSize: 248320}"," \tfor _, tt := range []struct {"],"additions":83,"deletions":0,"truncated":false},{"path":"mlxrunner/model/dflash/dflash_test.go","lines":["@@ -2,9 +2,11 @@ package dflash"," "," import ("," \t\"encoding/json\"","+\t\"fmt\""," \t\"maps\""," \t\"math\""," \t\"slices\"","+\t\"strings\""," \t\"testing\""," )"," ","@@ -50,6 +52,50 @@ func TestDraftConfigBoundsAndCausality(t *testing.T) {"," \t}"," }"," ","+// Keep the policy in JSON so these tests exercise parsing and loader wiring.","+func draftRotaryTestConfig(noRoPEField string) []byte {","+\treturn []byte(fmt.Sprintf(`{","+\t\t\"hidden_size\": 2, \"num_hidden_layers\": 2,","+\t\t\"num_attention_heads\": 1, \"num_key_value_heads\": 1, \"head_dim\": 2,","+\t\t\"rms_norm_eps\": 0.000001, \"rope_theta\": 10000,","+\t\t\"layer_types\": [\"sliding_attention\", \"full_attention\"], \"sliding_window\": 64,","+\t\t\"dflash_config\": {\"block_size\": 4, \"mask_token_id\": 0, \"target_layer_ids\": [0], \"causal\": false}","+\t\t%s","+\t}`, noRoPEField))","+}","+","+func TestDraftConfigNoRoPELayers(t *testing.T) {","+\tfor _, tt := range []struct {","+\t\tname, field string","+\t\tvalid       bool","+\t}{","+\t\t{\"omitted\", \"\", true},","+\t\t{\"empty\", `,\"no_rope_layers\":[]`, true},","+\t\t{\"first\", `,\"no_rope_layers\":[0]`, true},","+\t\t{\"last\", `,\"no_rope_layers\":[1]`, true},","+\t\t{\"unordered\", `,\"no_rope_layers\":[1,0]`, true},","+\t\t{\"negative\", `,\"no_rope_layers\":[-1]`, false},","+\t\t{\"past_last\", `,\"no_rope_layers\":[2]`, false},","+\t\t{\"invalid_after_valid\", `,\"no_rope_layers\":[0,2]`, false},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\t_, err := parseConfig(draftRotaryTestConfig(tt.field))","+\t\t\tif tt.valid {","+\t\t\t\tif err != nil {","+\t\t\t\t\tt.Fatal(err)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif err == nil {","+\t\t\t\tt.Fatalf(\"parseConfig accepted invalid %s\", tt.field)","+\t\t\t}","+\t\t\tif !strings.Contains(err.Error(), \"no_rope_layers\") {","+\t\t\t\tt.Fatalf(\"error %q does not identify no_rope_layers\", err)","+\t\t\t}","+\t\t})","+\t}","+}","+"," func FuzzDraftConfig(f *testing.F) {"," \tf.Add([]byte(`{\"hidden_size\":32,\"num_hidden_layers\":2,\"num_attention_heads\":4,\"num_key_value_heads\":2,\"head_dim\":8,\"is_causal\":false,\"vocab_size\":64,\"dflash_config\":{\"block_size\":8,\"mask_token_id\":7,\"target_layer_ids\":[1,3],\"conv_group_size\":16,\"conv_kernel_size\":2,\"selector_rank\":4,\"selector_top_k\":2}}`))"," \tf.Add([]byte(`{\"num_hidden_layers\":-1}`))"],"additions":46,"deletions":0,"truncated":false},{"path":"mlxrunner/model/ripple/forward.go","lines":["@@ -0,0 +1,156 @@","+package ripple","+","+import (","+\t\"math\"","+","+\t\"github.com/ollama/ollama/mlx\"","+\t\"github.com/ollama/ollama/mlxrunner/batch\"","+\t\"github.com/ollama/ollama/mlxrunner/cache\"","+\t\"github.com/ollama/ollama/mlxrunner/nn\"","+)","+","+func (m *Model) Forward(b *batch.Batch, caches []cache.Cache) (hidden, auxHidden *mlx.Array) {","+\tif caches != nil && len(caches) < len(m.Layers) {","+\t\tpanic(\"ripple: cache count must cover target layers\")","+\t}","+\tif caches != nil && b.InputIDs.Dim(0) != 1 {","+\t\tpanic(\"ripple: cached batches require one sequence\")","+\t}","+\th := scaleEmbedding(m.EmbedTokens.Forward(b.InputIDs), m.EmbedScale)","+\tseed := h","+\tpositions := mlx.Add(mlx.Reshape(mlx.FromValues(b.SeqOffsets, len(b.SeqOffsets)), int32(len(b.SeqOffsets)), 1), mlx.Arange(0, float64(b.InputIDs.Dim(1)), 1, mlx.DT