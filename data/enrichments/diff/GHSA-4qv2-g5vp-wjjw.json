{"id":"GHSA-4qv2-g5vp-wjjw","axis":"advisories","repo":"silverstripe/silverstripe-framework","sha":"8b6e9c4514cbe37feeaf9ddddf796a3109448187","parsed":{"files":[{"path":"src/Forms/GridField/GridFieldDetailForm_ItemRequest.php","lines":["@@ -826,12 +826,40 @@ protected function saveFormIntoRecord($data, $form)","         // Check object matches the correct classname","         if (isset($data['ClassName']) && $data['ClassName'] != $this->record->ClassName) {","             $newClassName = $data['ClassName'];","+            // The ClassName is read straight from request data, so it must be validated before","+            // it is honoured. Only allow conversion to a class within the list's own hierarchy,","+            // otherwise an attacker could inject an arbitrary DataObject subclass and induce","+            // type confusion or create a record of a type outside the GridField's intended scope.","+            if (!is_a($newClassName, $list->dataClass(), true)) {","+                $this->httpError(403, _t(","+                    __CLASS__ . '.ClassNameNotAllowed',","+                    'Cannot change record type to \"{ClassName}\"',","+                    ['ClassName' => $newClassName]","+                ));","+                return null;","+            }","             // The records originally saved attribute was overwritten by $form->saveInto($record) before.","             // This is necessary for newClassInstance() to work as expected, and trigger change detection","             // on the ClassName attribute","             $this->record->setClassName($this->record->ClassName);","             // Replace $record with a new instance","             $this->record = $this->record->newClassInstance($newClassName);","+            // A ClassName change both creates a record of the new type and writes the form data into it,","+            // so it requires create and edit authorisation on the new class. The only permission check in","+            // doSave() ran against the original class, before the conversion, so it does not cover the new","+            // type - without this an editor could convert a record into a type they cannot create.","+            $canConvert = $this->record->hasMethod('canCreate')","+                && $this->record->canCreate(null, $this->getCreateContext())","+                && $this->record->hasMethod('canEdit')","+                && $this->record->canEdit();","+            if (!$canConvert) {","+                $this->httpError(403, _t(","+                    __CLASS__ . '.ClassNamePermissionFailure',","+                    'It seems you don\\'t have the necessary permissions to save \"{ObjectTitle}\" as \"{ClassName}\"',","+                    ['ObjectTitle' => $this->getModelName(), 'ClassName' => $newClassName]","+                ));","+                return null;","+            }","         }"," ","         // Save form and any extra saved data into this record."],"additions":28,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormItemRequestTest/TestModel.php","lines":["@@ -0,0 +1,29 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest;","+","+use SilverStripe\\Dev\\TestOnly;","+use SilverStripe\\ORM\\DataObject;","+","+/**","+ * Base model used as the dataClass of the GridField list when exercising","+ * the ClassName-change branch of saveFormIntoRecord().","+ */","+class TestModel extends DataObject implements TestOnly","+{","+    private static $table_name = 'GridFieldDetailFormItemRequestTest_TestModel';","+","+    private static $db = [","+        'Name' => 'Varchar',","+    ];","+","+    public function canCreate($member = null, $context = [])","+    {","+        return true;","+    }","+","+    public function canEdit($member = null)","+    {","+        return true;","+    }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormItemRequestTest/TestModelAllowedChild.php","lines":["@@ -0,0 +1,15 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest;","+","+use SilverStripe\\Dev\\TestOnly;","+","+/**","+ * A subclass within the list's hierarchy that the user IS permitted to create","+ * and edit. Used to assert that a legitimate in-hierarchy ClassName change still","+ * succeeds and is not broken by the security fix.","+ */","+class TestModelAllowedChild extends TestModel implements TestOnly","+{","+    private static $table_name = 'GridFieldDetailFormItemRequestTest_TestModelAllowedChild';","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormItemRequestTest/TestModelCreateOnlyChild.php","lines":["@@ -0,0 +1,20 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest;","+","+use SilverStripe\\Dev\\TestOnly;","+","+/**","+ * A subclass within the list's hierarchy that the user may create but may NOT edit.","+ * Used to assert that converting a record into this type is rejected - the conversion","+ * writes the submitted form data into the record, so it requires edit permission too.","+ */","+class TestModelCreateOnlyChild extends TestModel implements TestOnly","+{","+    private static $table_name = 'GridFieldDetailFormItemRequestTest_TestModelCreateOnlyChild';","+","+    public function canEdit($member = null)","+    {","+        return false;","+    }","+}"],"additions":20,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormItemRequestTest/TestModelEditOnlyChild.php","lines":["@@ -0,0 +1,20 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest;","+","+use SilverStripe\\Dev\\TestOnly;","+","+/**","+ * A subclass within the list's hierarchy that the user may edit but may NOT create.","+ * Used to assert that converting an existing record into this type is rejected - the","+ * conversion creates a record of this type, so it requires create permission as well.","+ */","+class TestModelEditOnlyChild extends TestModel implements TestOnly","+{","+    private static $table_name = 'GridFieldDetailFormItemRequestTest_TestModelEditOnlyChild';","+","+    public function canCreate($member = null, $context = [])","+    {","+        return false;","+    }","+}"],"additions":20,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormItemRequestTest/TestModelRestrictedChild.php","lines":["@@ -0,0 +1,25 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest;","+","+use SilverStripe\\Dev\\TestOnly;","+","+/**","+ * A subclass within the list's hierarchy that the user is NOT permitted to","+ * create or edit. Used to assert that a ClassName change re-checks permissions","+ * against the new type rather than the original.","+ */","+class TestModelRestrictedChild extends TestModel implements TestOnly","+{","+    private static $table_name = 'GridFieldDetailFormItemRequestTest_TestModelRestrictedChild';","+","+    public function canCreate($member = null, $context = [])","+    {","+        return false;","+    }","+","+    public function canEdit($member = null)","+    {","+        return false;","+    }","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailFormItemRequestTest/TestUnrelatedModel.php","lines":["@@ -0,0 +1,29 @@","+<?php","+","+namespace SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest;","+","+use SilverStripe\\Dev\\TestOnly;","+use SilverStripe\\ORM\\DataObject;","+","+/**","+ * A DataObject that lives outside the list's class hierarchy. Used to assert","+ * that a ClassName change cannot convert a record to an unrelated type.","+ */","+class TestUnrelatedModel extends DataObject implements TestOnly","+{","+    private static $table_name = 'GridFieldDetailFormItemRequestTest_TestUnrelatedModel';","+","+    private static $db = [","+        'Name' => 'Varchar',","+    ];","+","+    public function canCreate($member = null, $context = [])","+    {","+        return true;","+    }","+","+    public function canEdit($member = null)","+    {","+        return true;","+    }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/php/Forms/GridField/GridFieldDetailForm_ItemRequestTest.php","lines":["@@ -13,14 +13,34 @@"," use SilverStripe\\Forms\\GridField\\GridFieldDetailForm;"," use SilverStripe\\Forms\\GridField\\GridFieldDetailForm_ItemRequest;"," use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestBreadcrumbsController;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestModel;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestModelAllowedChild;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestModelCreateOnlyChild;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestModelEditOnlyChild;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestModelRestrictedChild;"," use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestStatusFlagsObject;","+use SilverStripe\\Forms\\Tests\\GridField\\GridFieldDetailFormItemRequestTest\\TestUnrelatedModel;","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use SilverStripe\\Control\\HTTPResponse_Exception;","+use SilverStripe\\Forms\\FieldList;","+use SilverStripe\\Forms\\Form;","+use SilverStripe\\Forms\\TextField;"," use SilverStripe\\Model\\List\\ArrayList;"," use SilverStripe\\Model\\ArrayData;"," use SilverStripe\\ORM\\FieldType\\DBHTMLText;"," "," class GridFieldDetailForm_ItemRequestTest extends SapphireTest"," {","-    protected $usesDatabase = false;","+    protected $usesDatabase = true;","+","+    protected static $extra_dataobjects = [","+        TestModel::class,","+        TestModelAllowedChild::class,","+        TestModelCreateOnlyChild::class,","+        TestModelEditOnlyChild::class,","+        TestModelRestrictedChild::class,","+        TestUnrelatedModel::class,","+    ];"," ","     public function testItemEditFormThrowsException()","     {","@@ -95,4 +115,127 @@ public function testGetGridFieldItemAdjacencies(): void","             $refl->getValue($itemRequest)","         );","     }","+","+    public static function provideSaveFormRejectsUnauthorisedClassNameChange(): array","+    {","+        return [","+            'class outside the list hierarchy' => [","+                'newClassName' => TestUnrelatedModel::class,","+                'isNewRecord' => false,","+            ],","+            'in-hierarchy class the user cannot create/edit' => [","+                'newClassName' => TestModelRestrictedChild::class,","+                'isNewRecord' => false,","+            ],","+            'existing record converted to a class the user cannot create' => [","+                'newClassName' => TestModelEditOnlyChild::class,","+                'isNewRecord' => false,","+            ],","+            'new record created as a class the user cannot edit' => [","+                'newClassName' => TestModelCreateOnlyChild::class,","+                'isNewRecord' => true,","+            ],","+        ];","+    }","+","+    #[DataProvider('provideSaveFormRejectsUnauthorisedClassNameChange')]","+    public function testSaveFormRejectsUnauthorisedClassNameChange(string $newClassName, bool $isNewRecord): void","+    {","+        $record = new TestModel();","+        $record->Name = 'Original';","+        if (!$isNewRecord) {","+            $record->write();","+        }","+        $recordID = $record->ID;","+","+        $list = TestModel::get();","+        $gridField = new GridField('dummy', 'dummy', $list, new GridFieldConfig_Base());","+        $gridField->setModelClass(TestModel::class);","+        $itemRequest = new GridFieldDetailForm_ItemRequest(","+            $gridField,","+            new GridFieldDetailForm(),","+            $record,","+            new Controller(),","+            ''","+        );","+","+        $form = new Form($itemRequest, 'ItemEditForm', new FieldList(new TextField('Name')), new FieldList());","+","+        // Raw request data injects a ClassName that is never a saveable form field.","+        $data = ['Name' => 'Hacked', 'ClassName' => $newClassName];","+","+        $refl = new ReflectionMethod($itemRequest, 'saveFormIntoRecord');","+        $refl->setAccessible(true);","+","+        $threw = false;","+        try {","+            $refl->invoke($itemRequest, $data, $form);","+        } catch (HTTPResponse_Exception $e) {","+            $threw = true;","+            $this->assertSame(403, $e->getResponse()->getStatusCode());","+        }","+","+        $this->assertTrue($threw);","+","+        if ($isNewRecord) {","+            // A rejected conversion must not persist anything at all.","+            $this->assertCount(0, TestModel::get());","+            return;","+        }","+","+        // The persisted record must NOT have been converted to the injected class.","+        $stored = TestModel::get()->byID($recordID);","+        $this->assertInstanceOf(TestModel::class, $stored);","+        $this->assertSame(TestModel::class, $stored->ClassName);","+        $this->assertSame('Original', $stored->Name);","+    }","+","+    public static function provideSaveFormAllowsPermittedInHierarchyClassNameChange(): array","+    {","+        return [","+            'existing record' => ['isNewRecord' => false],","+            'new record' => ['isNewRecord' => true],","+        ];","+    }","+","+    /**","+     * Sanity check: a legitimate in-hierarchy conversion the user is permitted to make","+     * still works, so the fix does not weaken existing functionality.","+     */","+    #[DataProvider('provideSaveFormAllowsPermittedInHierarchyClassNameChange')]","+    public function testSaveFormAllowsPermittedInHierarchyClassNameChange(bool $isNewRecord): void","+    {","+        $record = new TestModel();","+        $record->Name = 'Original';","+        if (!$isNewRecord) {","+            $record->write();","+        }","+","+        $list = TestModel::get();","+        $gridField = new GridField('dummy', 'dummy', $list, new GridFieldConfig_Base());","+        $gridField->setModelClass(TestModel::class);","+        $itemRequest = new GridFieldDetailForm_ItemRequest(","+            $gridField,","+            new GridFieldDetailForm(),","+            $record,","+            new Controller(),","+            ''","+        );","+","+        $form = new Form($itemRequest, 'ItemEditForm', new FieldList(new TextField('Name')), new FieldList());","+","+        $data = ['Name' => 'Updated', 'ClassName' => TestModelAllowedChild::class];","+        $form->loadDataFrom($data);","+","+        $refl = new ReflectionMethod($itemRequest, 'saveFormIntoRecord');","+        $refl->setAccessible(true);","+        $refl->invoke($itemRequest, $data, $form);","+","+        $storedList = TestModel::get();","+        $this->assertCount(1, $storedList);","+        $stored = $storedList->first();","+        $this->assertInstanceOf(TestModelAllowedChild::class, $stored);","+        $this->assertSame(TestModelAllowedChild::class, $stored->ClassName);","+        $this->assertSame('Updated', $stored->Name);","+    }"," }",""],"additions":144,"deletions":1,"truncated":false}],"additions":310,"deletions":1,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-17T18:43:14.097601+00:00"}