 = () => {","+\t\tconst height = Math.ceil(mainElement.getBoundingClientRect().height);","+\t\tif (height !== reportedHeight) {","+\t\t\treportedHeight = height;","+\t\t\tclient.reportSize(height);","+\t\t}","+\t};","+\tconst observer = new ResizeObserver(reportSize);","+\tobserver.observe(mainElement);","+\tconst subscription = client.hostTransport?.onMessage(message => {","+\t\tif (!isTaskProgressMessage(message)) {","+\t\t\treturn;","+\t\t}","+\t\tdocument.documentElement.lang = message.language;","+\t\tdocument.title = message.title;","+\t\ttitleElement.textContent = message.title;","+\t\tlabelElement.textContent = message.label;","+\t\tconst maximum = Math.max(message.total, 1);","+\t\tprogressElement.setAttribute('aria-valuemax', String(maximum));","+\t\tprogressElement.setAttribute('aria-valuenow', String(message.checked));","+\t\tprogressElement.setAttribute('aria-valuetext', message.label);","+\t\tprogressElement.style.setProperty('--task-progress-ratio', String(message.checked / maximum));","+\t\tmainElement.hidden = false;","+\t\treportSize();","+\t});","+\tclient.hostTransport?.sendMessage({ type: 'ready' });","+\twindow.addEventListener('pagehide', () => {","+\t\tsubscription?.dispose();","+\t\tobserver.disconnect();","+\t\tclient.dispose();","+\t}, { once: true });","+}","+","+void main();"],"additions":49,"deletions":0,"truncated":false},{"path":"extensions/markdown-language-features/markdown-editor-src/taskProgress/taskProgressProtocol.ts","lines":["@@ -0,0 +1,30 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+export interface TaskProgressMessage {","+\treadonly type: 'taskProgress';","+\treadonly checked: number;","+\treadonly total: number;","+\treadonly title: string;","+\treadonly label: string;","+\treadonly language: string;","+}","+","+export function isTaskProgressMessage(message: unknown): message is TaskProgressMessage {","+\tif (typeof message !== 'object' || message === null) {","+\t\treturn false;","+\t}","+\tconst candidate = message as Partial<TaskProgressMessage>;","+\treturn candidate.type === 'taskProgress'","+\t\t&& typeof candidate.checked === 'number'","+\t\t&& Number.isSafeInteger(candidate.checked)","+\t\t&& typeof candidate.total === 'number'","+\t\t&& Number.isSafeInteger(candidate.total)","+\t\t&& candidate.checked >= 0","+\t\t&& candidate.checked <= candidate.total","+\t\t&& typeof candidate.title === 'string'","+\t\t&& typeof candidate.label === 'string'","+\t\t&& typeof candidate.language === 'string';","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"extensions/markdown-language-features/markdown-editor-src/taskProgress/taskProgressProvider.ts","lines":["@@ -0,0 +1,118 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { ListItemAstNode, type AstNode, type EditorModel } from '@vscode/markdown-editor';","+import type { IframeEmbeddedEditorHostTransport, IframeEmbeddedEditorProvider } from '@vscode/markdown-editor/web-editors';","+import { autorun, derived, type IObservable } from '@vscode/observables';","+import type { TaskProgressMessage } from './taskProgressProtocol';","+import type { TaskProgressLabels } from '../../src/preview/webviewInitialState';","+import taskProgressHtml from './taskProgress.html';","+","+interface TaskProgressCounts {","+\treadonly checked: number;","+\treadonly total: number;","+}","+","+export function createTaskProgressProvider(model: EditorModel, labels: TaskProgressLabels): IframeEmbeddedEditorProvider {","+\tconst counts = derived(reader => countTasks(model.document.read(reader)));","+\treturn {","+\t\tid: 'vscode.markdown.taskProgress',","+\t\tselector: { language: 'widget:task-progress' },","+\t\tresolve: async () => ({","+\t\t\thtml: taskProgressHtml,","+\t\t\truntimeKey: 'vscode.markdown.taskProgress',","+\t\t\thostTransport: true,","+\t\t\tinitialHeight: 88,","+\t\t}),","+\t\tcreateHostTransport: () => new TaskProgressHostTransport(counts, labels),","+\t};","+}","+","+export function isTaskProgressLabels(value: unknown): value is TaskProgressLabels {","+\tif (typeof value !== 'object' || value === null) {","+\t\treturn false;","+\t}","+\tconst labels = value as Partial<TaskProgressLabels>;","+\treturn typeof labels.title === 'string'","+\t\t&& typeof labels.summary === 'string'","+\t\t&& typeof labels.language === 'string';","+}","+","+export function countTasks(document: AstNode): TaskProgressCounts {","+\tlet checked = 0;","+\tlet total = 0;","+\tconst pending = [document];","+\twhile (pending.length) {","+\t\tconst node = pending.pop()!;","+\t\tif (node instanceof ListItemAstNode && node.checked !== undefined) {","+\t\t\ttotal++;","+\t\t\tif (node.checked) {","+\t\t\t\tchecked++;","+\t\t\t}","+\t\t}","+\t\tfor (const child of node.children) {","+\t\t\tpending.push(child);","+\t\t}","+\t}","+\treturn { checked, total };","+}","+","+class TaskProgressHostTransport implements IframeEmbeddedEditorHostTransport {","+\treadonly #_listeners = new Set<(message: unknown) => void>();","+\treadonly #_subscription;","+\treadonly #_labels: TaskProgressLabels;","+\t#_counts: TaskProgressCounts = { checked: 0, total: 0 };","+\t#_ready = false;","+\t#_disposed = false;","+","+\tconstructor(counts: IObservable<TaskProgressCounts>, labels: TaskProgressLabels) {","+\t\tthis.#_labels = labels;","+\t\tthis.#_subscription = autorun(reader => {","+\t\t\tconst next = counts.read(reader);","+\t\t\tconst changed = next.checked !== this.#_counts.checked || next.total !== this.#_counts.total;","+\t\t\tthis.#_counts = next;","+\t\t\tif (changed && this.#_ready) {","+\t\t\t\tthis.#_publish();","+\t\t\t}","+\t\t});","+\t}","+","+\treadonly onMessage: IframeEmbeddedEditorHostTransport['onMessage'] = listener => {","+\t\tif (!this.#_disposed) {","+\t\t\tthis.#_listeners.add(listener);","+\t\t}","+\t\treturn { dispose: () => this.#_listeners.delete(listener) };","+\t};","+","+\tsendMessage(message: unknown): void {","+\t\tif (!this.#_disposed && typeof message === 'object' && message !== null && (message as { type?: unknown }).type === 'ready') {","+\t\t\tthis.#_ready = true;","+\t\t\tthis.#_publish();","+\t\t}","+\t}","+","+\t#_publish(): void {","+\t\tconst numbers = new Intl.NumberFormat(this.#_labels.language);","+\t\tconst message: TaskProgressMessage = {","+\t\t\ttype: 'taskProgress',","+\t\t\t...this.#_counts,","+\t\t\ttitle: this.#_labels.title,","+\t\t\tlabel: this.#_labels.summary.replace(/\\{([01])\\}/g, (_, index: string) =>","+\t\t\t\tnumbers.format(index === '0' ? this.#_counts.checked : this.#_counts.total)),","+\t\t\tlanguage: this.#_labels.language,","+\t\t};","+\t\tfor (const listener of this.#_listeners) {","+\t\t\tlistener(message);","+\t\t}","+\t}","+","+\tdispose(): void {","+\t\tif (!this.#_disposed) {","+\t\t\tthis.#_disposed = true;","+\t\t\tthis.#_subscription.dispose();","+\t\t\tthis.#_listeners.clear();","+\t\t}","+\t}","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"extensions/markdown-language-features/package-lock.json","lines":["@@ -10,8 +10,9 @@","       \"license\": \"MIT\",","       \"dependencies\": {","         \"@vscode/extension-telemetry\": \"^0.9.8\",","-        \"@vscode/markdown-editor\": \"0.0.2-119\",","+        \"@vscode/markdown-editor\": \"0.0.2-121\",","         \"@vscode/observables\": \"^0.1.1-0\",","+        \"@vscode/web-editors\": \"^0.0.2-41\",","         \"dompurify\": 