server answer, instead of every client's minute-long","+\t// poll concentrating on the leader.","+\tqueryOptions := structs.QueryOptions{Token: a.tokens.AgentToken(), AllowStale: true}","+\tif blocking {","+\t\tqueryOptions.MinQueryIndex = index","+\t\tqueryOptions.MaxQueryTime = time.Minute","+\t}","+\trequest := &structs.FeatureGateQueryRequest{","+\t\tNode: a.config.NodeName,","+\t\tDCSpecificRequest: structs.DCSpecificRequest{","+\t\t\tDatacenter:     a.config.Datacenter,","+\t\t\tEnterpriseMeta: *a.AgentEnterpriseMeta(),","+\t\t\tQueryOptions:   queryOptions,","+\t\t},","+\t}","+\tctx, cancel := context.WithTimeout(context.Background(), time.Minute+10*time.Second)","+\tdefer cancel()","+","+\tvar reply structs.FeatureGateQueryResponse","+\tif err := a.RPC(ctx, \"Operator.FeatureGateGet\", request, &reply); err != nil {","+\t\treturn index, err","+\t}","+\tpublishClientFeatureGates(store, &reply)","+\t// Block on the newest generation installed, so a lagging server waits to","+\t// catch up rather than handing back an older one.","+\treturn store.Current().StatusIndex, nil","+}","+","+// publishClientFeatureGates installs reply only when it is newer than the cached","+// generation, so a lagging follower cannot roll the cache back.","+func publishClientFeatureGates(store *featuregate.Store, reply *structs.FeatureGateQueryResponse) {","+\tif reply.Uninitialized || len(reply.Features) == 0 {","+\t\t// Only the leader (LastContact == 0) is authoritative that no gate state","+\t\t// exists; a follower may simply not have replayed it yet.","+\t\tif reply.LastContact == 0 {","+\t\t\tstore.Reset(0)","+\t\t}","+\t\treturn","+\t}","+\tfeatures := make(map[string]bool, len(reply.Features))","+\tfor _, feature := range reply.Features {","+\t\tfeatures[feature.Name] = feature.EffectiveEnabled","+\t}","+\tstore.Publish(featuregate.Snapshot{StatusIndex: reply.Index, Features: features})","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"agent/agent_feature_gate_t