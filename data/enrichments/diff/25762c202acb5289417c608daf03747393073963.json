e.all([","+\t\timport(\"./a\"),","+\t\timport(\"./b\"),","+\t\timport(\"./c\")","+\t]);","+\texpect(values.map(value => value.default)).toEqual([\"a\", \"b\", \"c\"]);","+});"],"additions":8,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/optimization/compat-hashed-chunk-ids/min-length.js","lines":["@@ -0,0 +1,9 @@","+const chunks = [","+\timport(\"./a?23\"),","+\timport(\"./a?30\"),","+];","+","+it(\"should extend compat-hashed chunk ids only when shorter prefixes collide\", async () => {","+\tconst values = await Promise.all(chunks);","+\texpect(values.every(value => value.default === \"a\")).toBe(true);","+});"],"additions":9,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/optimization/compat-hashed-chunk-ids/rspack.config.js","lines":["@@ -0,0 +1,45 @@","+const rspack = require('@rspack/core');","+","+const checkChunkIds =","+  (minLength, expectExtended = false) =>","+  (compiler) => {","+    compiler.hooks.done.tap('CheckCompatHashedChunkIds', (stats) => {","+      const ids = stats","+        .toJson({","+          all: false,","+          chunks: true,","+          ids: true,","+        })","+        .chunks.map((chunk) => String(chunk.id));","+","+      expect(new Set(ids).size).toBe(ids.length);","+      for (const id of ids) {","+        expect(id).toMatch(/^[a-z0-9]+$/);","+        expect(id.length).toBeGreaterThanOrEqual(minLength);","+      }","+      if (expectExtended) {","+        expect(ids.some((id) => id.length === minLength)).toBe(true);","+        expect(ids.some((id) => id.length > minLength)).toBe(true);","+      }","+    });","+  };","+","+/** @type {import(\"@rspack/core\").Configuration[]} */","+module.exports = [","+  {","+    optimization: {","+      chunkIds: 'compat-hashed',","+    },","+    plugins: [checkChunkIds(1)],","+  },","+  {","+    entry: './min-length',","+    optimization: {","+      chunkIds: false,","+    },","+    plugins: [","+      new rspack.ids.CompatHashedChunkIdsPlugin({ minLength: 1 }),","+      checkChunkIds(1, true),","+    ],","+  },","+];"],"additions":45,"deletions":0,"truncated":false},{"path":"website/docs/en/config/optimization.mdx","lines":["@@ -38,7 +38,7 @@ The `⁠optimization.avoidEntryIife` option can negatively affect build performa"," ## optimization.chunkIds"," "," <PropertyType","-  type=\"'natural' | 'named' | 'deterministic' | 'size' | 'total-size'\"","+  type=\"false | 'natural' | 'named' | 'deterministic' | 'compat-hashed' | 'size' | 'total-size'\"","   defaultValueList={[","     { defaultValue: \"'named'\", mode: 'development' },","     { defaultValue: \"'deterministic'\", mode: 'production' },","@@ -54,8 +54,10 @@ The following string values are supported:"," | `'natural'`       | Use numeric ids in order of usage.                                                                                                             |"," | `'named'`         | Readable ids for better debugging.                                                                                                             |"," | `'deterministic'` | Short numeric ids which will not be changing between compilation. Good for long term caching. By default a minimum length of 3 digits is used. |","+| `'compat-hashed'` | Use the shortest available prefix of a stable lowercase alphanumeric hash.                                                                     |"," | `'size'`          | Use numeric ids to make the initial download package smaller.                                                                                  |"," | `'total-size'`    | Use numeric ids to make the overall download package smaller.                                                                                  |","+| `false`           | Disable Rspack's built-in chunk id algorithm, allowing a custom plugin to provide chunk ids.                                                   |"," "," ```js title=\"rspack.config.mjs\""," export default {","@@ -65,6 +67,20 @@ export default {"," };"," ```"," ","+The `compat-hashed` option uses the shortest available prefix of a stable lowercase alphanumeric hash as the chunk id, balancing long-term caching, bundle size, and runtime performance.","+","+```js title=\"rspack.config.mjs\"","+export default {","+  optimization: {","+    chunkIds: 'compat-hashed',","+  },","+};","+```","+","+:::tip","+The `compat-hashed` option is available in Rspack 2.2.0 and later.","+:::","+"," ## optimization.concatenateModules"," "," <PropertyType","@@ -375,6 +391,10 @@ export default {"," "," The `compat-hashed` option uses the shortest available prefix of a stable alphanumeric hash as the module id, balancing long-term caching, bundle size, and runtime performance."," ","+:::warning","+`compat-hashed` module ids are case-sensitive and may contain uppercase letters. On case-insensitive file systems, avoid using `[id]` as the only distinguishing placeholder in [Asset module filenames](/config/output#outputassetmodulefilename) or [WebAssembly module filenames](/config/output#outputwebassemblymodulefilename). Prefer `[contenthash]`, or include it alongside `[id]`.","+:::","+"," ```js title=\"rspack.config.mjs\""," const isDev = process.env.NODE_ENV === 'development';"," "],"additions":21,"deletions":1,"truncated":false},{"path":"website/docs/en/plugins/index.mdx","lines":["@@ -13,6 +13,7 @@ Rspack provides several high-performance built-in plugins. They can serve as dro"," Including:"," "," - [CircularCheckRspackPlugin](/plugins/rspack/circular-check-rspack-plugin): Flags circular imports","+- [CompatHashedChunkIdsPlugin](/plugins/rspack/compat-hashed-chunk-ids-plugin): Assigns compact, stable chunk ids using alphanumeric hash prefixes"," - [CompatHashedModuleIdsPlugin](/plugins/rspack/compat-hashed-module-ids-plugin): Assigns compact, stable module ids using alphanumeric hash prefixes"," - [CopyRspackPlugin](/plugins/rspack/copy-rspack-plugin): Copies files or directories to the build output"," - [CssChunkingPlugin](/plugins/rspack/css-chunking-plugin): Splits CSS while preserving import order to avoid style issues"],"additions":1,"deletions":0,"truncated":false},{"path":"website/docs/en/plugins/rspack/compat-hashed-chunk-ids-plugin.mdx","lines":["@@ -0,0 +1,38 @@","+---","+description: 'CompatHashedChunkIdsPlugin assigns compact ids using the shortest available prefixes of stable lowercase alphanumeric hashes to shrink bundles and speed runtime indexing'","+---","+","+import { ApiMeta } from '@components/ApiMeta.tsx';","+","+# CompatHashedChunkIdsPlugin","+","+<ApiMeta specific={['Rspack']} addedVersion=\"2.2.0\" />","+","+`CompatHashedChunkIdsPlugin` hashes chunk contents and assigns the shortest available prefix of each encoded hash. Compared with `deterministic`, it produces more compact ids that preserve stability while reducing bundle size and improving runtime indexing performance. Every character uses `0-9a-z`, making chunk ids safe for case-insensitive file systems. An id is extended only when its shorter prefix is already used.","+","+`optimization.chunkIds: 'compat-hashed'` uses this plugin internally. Use the plugin directly when you need to customize the minimum encoded id length.","+","+```js title=\"rspack.config.mjs\"","+import rspack from '@rspack/core';","+","+export default {","+  optimization: {","+    chunkIds: false,","+  },","+  plugins: [","+    new rspack.ids.CompatHashedChunkIdsPlugin({","+      minLength: 1,","+    }),","+  ],","+};","+```","+","+## Options","+","+### minLength","+","+- **Type:** `number`","+- **Default:** `1`","+- **Range:** Integer from `1` to `13`","+","+The minimum encoded id length. Rspack extends an id one character at a time when its hash prefix is already used. Increasing `minLength` expands the initial id space, reducing prefix collisions and making generated output and caching more stable. The tradeoff is that chunk ids become longer."],"additions":38,"deletions":0,"truncated":false}],"additions":471,"deletions":60,"truncated":true,"file_count":23},"error":null,"fetched_at":"2026-08-25T09:18:31.550127+00:00"}