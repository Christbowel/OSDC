{"id":"f103d705645b9e9e41120a858dbeab911fecf21b","axis":"silent","repo":"envoyproxy/envoy","sha":"f103d705645b9e9e41120a858dbeab911fecf21b","parsed":{"files":[{"path":"api/envoy/extensions/filters/http/gcp_authn/v3/gcp_authn.proto","lines":["@@ -97,7 +97,7 @@ message Audience {","     // Optional custom OAuth scopes for the bound access token request.","     // If empty, the filter will not request scopes explicitly, so the metadata server's default","     // scopes will be used.","-    // When populated, the filter appends \"&scopes=<comma-separated-scopes>\" to the","+    // When populated, the filter appends \"?scopes=<comma-separated-scopes>\" to the","     // metadata server token request. Note that the metadata server replaces default","     // scopes with the provided list rather than appending; to preserve general GCP API","     // access, callers should explicitly include \"https://www.googleapis.com/auth/cloud-platform\"."],"additions":1,"deletions":1,"truncated":false},{"path":"changelogs/current/behavior_changes/gcp_authn__bound-token-post.rst","lines":["@@ -0,0 +1,8 @@","+Bound token requests (:ref:`bound_jwt","+<envoy_v3_api_field_extensions.filters.http.gcp_authn.v3.Audience.bound_jwt>` and","+:ref:`bound_access_token","+<envoy_v3_api_field_extensions.filters.http.gcp_authn.v3.Audience.bound_access_token>`) to the GCP","+metadata server now use HTTP ``POST`` with the full PEM-encoded client certificate chain in the JSON","+request body (``{\"certificate_chain\": \"<PEM>\"}``), replacing the deprecated HTTP ``GET`` request with","+the ``bindCertificateFingerprint`` query parameter.","+"],"additions":8,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/gcp_authn/crypto_utils.cc","lines":["@@ -1,6 +1,7 @@"," #include \"source/extensions/filters/http/gcp_authn/crypto_utils.h\""," "," #include <openssl/bio.h>","+#include <openssl/err.h>"," #include <openssl/mem.h>"," #include <openssl/pem.h>"," #include <openssl/sha2.h>","@@ -48,6 +49,7 @@ CertFingerprinterImpl::getFingerprintFromPem(const std::string& pem) const {","   bssl::UniquePtr<BIO> bio(BIO_new_mem_buf(pem.data(), pem.size()));","   bssl::UniquePtr<X509> cert(PEM_read_bio_X509(bio.get(), nullptr, nullptr, nullptr));","   if (!cert) {","+    ERR_clear_error();","     ENVOY_LOG_MISC(error, \"Failed to parse certificate from PEM\");","     return absl::InvalidArgumentError(\"Failed to parse certificate from PEM\");","   }","@@ -55,6 +57,40 @@ CertFingerprinterImpl::getFingerprintFromPem(const std::string& pem) const {","   return calculateFingerprint(cert.get());"," }"," ","+absl::StatusOr<std::string>","+CertFingerprinterImpl::getCertChainFromPem(const std::string& pem) const {","+  if (pem.empty()) {","+    return absl::InvalidArgumentError(\"Certificate PEM content is empty\");","+  }","+","+  ERR_clear_error();","+  bssl::UniquePtr<BIO> in_bio(BIO_new_mem_buf(pem.data(), pem.size()));","+  bssl::UniquePtr<BIO> out_bio(BIO_new(BIO_s_mem()));","+","+  bool found_cert = false;","+  while (true) {","+    bssl::UniquePtr<X509> cert(PEM_read_bio_X509(in_bio.get(), nullptr, nullptr, nullptr));","+    if (!cert) {","+      break;","+    }","+    found_cert = true;","+    PEM_write_bio_X509(out_bio.get(), cert.get());","+  }","+","+  const uint32_t err = ERR_peek_last_error();","+  ERR_clear_error();","+  if (!found_cert ||","+      !(ERR_GET_LIB(err) == ERR_LIB_PEM && ERR_GET_REASON(err) == PEM_R_NO_START_LINE)) {","+    ENVOY_LOG_MISC(error, \"Failed to parse certificate chain from PEM\");","+    return absl::InvalidArgumentError(\"Failed to parse certificate chain from PEM\");","+  }","+","+  const uint8_t* output = nullptr;","+  size_t length = 0;","+  BIO_mem_contents(out_bio.get(), &output, &length);","+  return std::string(reinterpret_cast<const char*>(output), length);","+}","+"," } // namespace GcpAuthn"," } // namespace HttpFilters"," } // namespace Extensions"],"additions":36,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/gcp_authn/crypto_utils.h","lines":["@@ -13,12 +13,14 @@ class CertFingerprinter {"," public:","   virtual ~CertFingerprinter() = default;","   virtual absl::StatusOr<std::string> getFingerprintFromPem(const std::string& pem) const = 0;","+  virtual absl::StatusOr<std::string> getCertChainFromPem(const std::string& pem) const = 0;"," };"," using CertFingerprinterSharedPtr = std::shared_ptr<const CertFingerprinter>;"," "," class CertFingerprinterImpl : public CertFingerprinter {"," public:","   absl::StatusOr<std::string> getFingerprintFromPem(const std::string& pem) const override;","+  absl::StatusOr<std::string> getCertChainFromPem(const std::string& pem) const override;"," };"," "," } // namespace GcpAuthn"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/gcp_authn/gcp_authn_client.h","lines":["@@ -71,22 +71,26 @@ class GcpAuthnClient {","    *","    * @param audience the Audience proto containing the request details.","    * @param fingerprint the client certificate fingerprint, strictly required.","+   * @param cert_pem the client certificate chain in PEM format, strictly required.","    * @param callbacks the callbacks to be notified when the token fetch completes.","    */","   virtual void","   fetchBoundJwt(const envoy::extensions::filters::http::gcp_authn::v3::Audience& audience,","-                const std::string& fingerprint, Callbacks& callbacks) PURE;","+                const std::string& fingerprint, const std::string& cert_pem,","+                Callbacks& callbacks) PURE;"," ","   /**","    * Fetch a bound Access Token.","    *","    * @param audience the Audience proto containing the request details.","    * @param fingerprint the client certificate fingerprint, strictly required.","+   * @param cert_pem the client certificate chain in PEM format, strictly required.","    * @param callbacks the callbacks to be notified when the token fetch completes.","    */","   virtual void","   fetchBoundAc