Data(\"0\", \"1\", \"2\"), max), BucketConsistencyViolation::kNone);","+}","+","+TEST_F(TimeseriesBucketValidationTest, RejectsIndexEqualToMeasurementCount) {","+    ASSERT_EQ(validate(makeData(\"0\", \"1\", \"3\"), max), BucketConsistencyViolation::kIndexOutOfRange);","+}","+","+TEST_F(TimeseriesBucketValidationTest, RejectsIndexGreaterThanMeasurementCount) {","+    ASSERT_EQ(validate(makeData(\"0\", \"1\", \"10\"), max),","+              BucketConsistencyViolation::kIndexOutOfRange);","+}","+","+TEST_F(TimeseriesBucketValidationTest, RejectsNegativeIndex) {","+    ASSERT_EQ(validate(makeData(\"-1\", \"1\", \"2\"), max), BucketConsistencyViolation::kIndexBadValue);","+}","+","+}  // namespace","+}  // namespace mongo::timeseries"],"additions":67,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor.cpp","lines":["@@ -223,8 +223,8 @@ const char* _describeDocumentValidationResult(Collection::DocumentValidationResu","                            \"log id 11634800.\";","                 case BCV::kIndexOutOfRange:","                     return \"Detected one or more time-series bucket documents with a data field \"","-                           \"index that exceeds the measurement count. Check logs for log id \"","-                           \"11634800.\";","+                           \"index that is not less than the measurement count. Check logs for log \"","+                           \"id 11634800.\";","                 case BCV::kIndexBadValue:","                     return \"Detected one or more time-series bucket documents with a negative or \"","                            \"non-numerical data field index. Check logs for log id 11634800.\";"],"additions":2,"deletions":2,"truncated":false},{"path":"src/mongo/db/validate/validate_timeseries.cpp","lines":["@@ -477,7 +477,7 @@ TimeseriesValidationStatus validateTimeSeriesDataField(const CollectionPtr& coll","                                     metric.fieldNameStringData(),","            