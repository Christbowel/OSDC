{"id":"fc1153eee144b0a49830aba9fadbd994290179af","axis":"silent","repo":"akkadotnet/akka.net","sha":"fc1153eee144b0a49830aba9fadbd994290179af","parsed":{"files":[{"path":"docs/articles/serialization/source-generated-serialization.md","lines":["@@ -522,10 +522,9 @@ public sealed record EventWrapper<T>(","     [property: AkkaField(2)] T Body) : IClosedGenericTestProtocol;"," ```"," ","-The generator names each construction's generated Write, Read, and `SizeOf` methods by folding the","-type arguments into the method name. So `Wrapper<int>` becomes `WriteWrapperInt`. And","-`Wrapper<Pair<int, string>>` becomes `WriteWrapperPairIntString`. This is an implementation detail.","-You never write these names yourself.","+Generated Write, Read, and `SizeOf` method names combine a readable type name with a stable suffix","+from the full type identity, including generic arguments. Types can share a simple name across","+namespaces or containing types. These private method names do not affect manifests or wire bytes."," "," Diagnostics guard this shape. **AKKASG022** fires when a generic definition implements the"," protocol with no closed registrations at all. **AKKASG023** fires when a field uses an","@@ -1125,7 +1124,7 @@ diagnostic was retired with it, and the id stays a permanent gap."," | AKKASG021 | Error | Duplicate closed generic registration | The same closed construction is registered more than once on one serializer. |"," | AKKASG022 | Error | Generic serializable type requires closed generic registrations | A generic `[AkkaSerializable]` type implements the protocol but has no closed registrations. |"," | AKKASG023 | Error | Closed generic field type is not registered | A field uses a closed generic construction that was never registered with `[AkkaSerializable<T>]`. |","-| AKKASG024 | Error | Generated member name collision | Two distinct message types would produce the same generated member name. |","+| AKKASG024 | Error | Generated member name collision | Two distinct type identities produced the same generated member name despite their stable suffixes. Report the generator collision with both declarations. |"," | AKKASG025 | Info | Union member type is not sealed | An undeclared subtype of this (concrete, non-sealed) member will fail serialization if it's ever sent. |"," | AKKASG026 | Error | No matching constructor | No constructor covers every required `[AkkaField]` property, so the type can't be reconstructed. |"," | AKKASG027 | Warning | Constructor parameter not covered by [AkkaField] | A defaulted constructor parameter has no matching `[AkkaField]` property and silently resets on every deserialize. |"],"additions":4,"deletions":5,"truncated":false},{"path":"src/core/Akka.Serialization.V2.Generators/AkkaSerializerGenerator.Diagnostics.cs","lines":["@@ -261,7 +261,7 @@ public sealed partial class AkkaSerializerGenerator","     private static readonly DiagnosticDescriptor DuplicateGeneratedName = new(","         \"AKKASG024\",","         \"Generated member name collision\",","-        \"Serializer '{0}' produces the same generated member name '{1}' for distinct message types {2}; rename one of the types to disambiguate\",","+        \"Serializer '{0}' produces the same generated member name '{1}' for distinct message types {2}; report this generator collision with both type declarations\",","         \"Akka.Serialization.V2\",","         DiagnosticSeverity.Error,","         isEnabledByDefault: true);"],"additions":1,"deletions":1,"truncated":false},{"path":"src/core/Akka.Serialization.V2.Generators/AkkaSerializerGenerator.Emission.cs","lines":["@@ -10,7 +10,9 @@"," using System;"," using System.Collections.Generic;"," using System.Collections.Immutable;","+using System.Globalization;"," using System.Linq;","+using System.Security.Cryptography;"," using System.Text;"," using System.Threading;"," using Microsoft.CodeAnalysis;","@@ -2785,20 +2787,9 @@ private static ValueExpr GetFieldValueExpression(FieldInfo field)"," ","     private static string GetObjectMethodName(TypeMapping mapping)","     {","-        return FoldTypeName(mapping.TypeFullName);","+        return GetGeneratedMethodName(mapping.Key);","     }"," ","-    /// <summary>","-    /// Folds a fully-qualified type name into a compact generated-member identifier the way","-    /// System.Text.Json's <c>GetTypeInfoPropertyName</c> does: namespaces are dropped, each type","-    /// identifier keeps only its simple name, and generic type arguments are concatenated --","-    /// <c>Ns.Wrapper&lt;Ns.OrderRequest&gt;</c> becomes <c>WrapperOrderRequest</c>.","-    /// These names appear in stack traces (WriteWrapperOrderRequest), so compactness matters.","-    /// Flattening is collision-prone by construction (same simple name in two namespaces, marker","-    /// ambiguity); AKKASG024 detects collisions among generated members and fails compilation","-    /// instead of silently emitting duplicates -- the same trade System.Text.Json makes with its","-    /// DuplicateTypeName diagnostic.","-    /// </summary>","     private static string FoldTypeName(string typeFullName)","     {","         var sb = new StringBuilder(typeFullName.Length);","@@ -2854,16 +2845,11 @@ void FlushSegment()"," ","     private static string GetFormatterFieldName(FormatterInfo formatter)","     {","-        return \"_akkaFormatter_\" + SanitizeTypeName(formatter.TargetTypeFullName);","+        return \"_akkaFormatter_\" + SanitizeNonGenericFormatterTypeName(formatter.TargetTypeFullName);","     }"," ","-    private static string SanitizeTypeName(string typeFullName)","+    private static string SanitizeNonGenericFormatterTypeName(string typeFullName)","     {","-        // Used only for formatter field names, whose target types are validated non-generic","-        // (AKKASG011) -- generated METHOD names go through FoldTypeName instead. Escape literal","-        // underscores FIRST so sanitization is collision-free: 'My.Ns.Foo_Bar' -> 'My_Ns_Foo__Bar'","-        // and 'My.Ns.Foo.Bar' -> 'My_Ns_Foo_Bar' stay distinct instead of both collapsing to","-        // 'My_Ns_Foo_Bar' (duplicate generated members).","         return typeFullName","             .Replace(\"global::\", string.Empty)","             .Replace(\"_\", \"__\")","@@ -2873,7 +2859,29 @@ private static string SanitizeTypeName(string typeFullName)"," ","     private static string GetMessageMethodName(MessageInfo message)","     {","-        return FoldTypeName(message.FullyQualifiedName);","+        return GetGeneratedMethodName(message.Key);","+    }","+","+    private static string GetGeneratedMethodName(TypeKey key)","+    {","+        var identity = new StringBuilder();","+        AppendIdentity(key, identity);","+        using var sha256 = SHA256.Create();","+        var hash = sha256.ComputeHash(Encoding.UTF8.GetBytes(identity.ToString()));","+        var name = new StringBuilder(FoldTypeName(key.DisplayName));","+        name.Append('_');","+        for (var i = 0; i < 8; i++)","+            name.Append(hash[i].ToString(\"x2\", CultureInfo.InvariantCulture));","+        return name.ToString();","+    }","+","+    private static void AppendIdentity(TypeKey key, StringBuilder builder)","+    {","+        builder.Append(key.MetadataName.Length.ToString(CultureInfo.InvariantCulture))","+            .Append(':').Append(key.MetadataName)","+            .Append('[').Append(key.TypeArguments.Length.ToString(CultureInfo.InvariantCulture)).Append(']');","+        foreach (var argument in key.TypeArguments)","+            AppendIdentity(argument, builder);","     }"," ","     private static string GetAccessibilityKeyword(Accessibility accessibility)"],"additions":28,"deletions":20,"truncated":false},{"path":"src/core/Akka.Serialization.V2.Generators/AkkaSerializerGenerator.Models.cs","lines":["@@ -205,7 +205,6 @@ public TypeKey(string metadataName, ImmutableArray<TypeKey> typeArguments, strin","         /// <summary>The exact fully-qualified display string