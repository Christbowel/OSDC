ame: \"delegate\", Authorizer: delegate},","+\t)","+\tif err != nil {","+\t\tpanic(err)","+\t}","+\treturn chain","+}","+","+// NewWatchRestrictionAuthorizer only denies non-service watches; other requests","+// require authorization downstream, including when the flag is disabled.","+func NewWatchRestrictionAuthorizer() authorizer.Authorizer {","+\tclient := openfeature.NewDefaultClient()","+\treturn authorizer.AuthorizerFunc(func(ctx context.Context, attr authorizer.Attributes) (authorizer.Decision, string, error) {","+\t\tif !attr.IsResourceRequest() || attr.GetVerb() != \"watch\" {","+\t\t\treturn authorizer.DecisionNoOpinion, \"\", nil","+\t\t}","+\t\tif !client.Boolean(ctx, featuremgmt.FlagGrafanaRestrictWatchToServiceIdentities, false, openfeature.TransactionContext(ctx)) {","+\t\t\treturn authorizer.DecisionNoOpinion, \"\", nil","+\t\t}","+\t\t// In-process informers use Kubernetes loopback credentials, not Grafana service accounts.","+\t\tif user := attr.GetUser(); user != nil && slices.Contains(user.GetGroups(), k8suser.SystemPrivilegedGroup) {","+\t\t\treturn authorizer.DecisionNoOpinion, \"\", nil","+\t\t}","+\t\tif ident, ok := types.AuthInfoFrom(ctx); ok && types.IsIdentityType(ident.GetIdentityType(), types.TypeServiceAccount, types.TypeAccessPolicy) {","+\t\t\treturn authorizer.DecisionNoOpinion, \"\", nil","+\t\t}","+\t\treturn authorizer.DecisionDeny, \"watch is restricted to service identities\", nil","+\t})","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"pkg/services/apiserver/auth/authorizer/watch_test.go","lines":["@@ -0,0 +1,108 @@","+package authorizer","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\t\"github.com/grafana/authlib/authn\"","+\t\"github.com/grafana/authlib/types\"","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/services/featuremgmt\"","+\t\"github.com/grafana/grafana/pkg/services/org\"","+\t\"github.com/stretchr/testify/require\"","+\tk8suser \"k8s.io/