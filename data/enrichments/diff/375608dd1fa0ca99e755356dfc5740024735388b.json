thorizer.Decision, string, error) {","+\t\t\t\t\t\tcalled = true","+\t\t\t\t\t\treturn authorizer.DecisionAllow, \"\", nil","+\t\t\t\t\t})","+\t\t\t\t\tattrs := authorizer.AttributesRecord{Verb: verb, ResourceRequest: true, User: tc.user}","+\t\t\t\t\tdecision, reason, err := WithWatchRestriction(delegate).Authorize(ctx, attrs)","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\tif tc.allowed || verb != \"watch\" {","+\t\t\t\t\t\trequire.Equal(t, authorizer.DecisionAllow, decision)","+\t\t\t\t\t\trequire.True(t, called)","+\t\t\t\t\t} else {","+\t\t\t\t\t\trequire.Equal(t, authorizer.DecisionDeny, decision)","+\t\t\t\t\t\trequire.Contains(t, reason, \"watch is restricted\")","+\t\t\t\t\t\trequire.False(t, called)","+\t\t\t\t\t}","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestWatchRestrictionPreservesAuthorization(t *testing.T) {","+\tfeaturemgmt.WithEnabledFlags(t, featuremgmt.FlagGrafanaRestrictWatchToServiceIdentities)","+\tctx := types.WithAuthInfo(context.Background(), &identity.StaticRequester{Type: types.TypeServiceAccount})","+\tdelegate := authorizer.AuthorizerFunc(func(context.Context, authorizer.Attributes) (authorizer.Decision, string, error) {","+\t\treturn authorizer.DecisionDeny, \"resource permission denied\", nil","+\t})","+\tdecision, reason, err := WithWatchRestriction(delegate).Authorize(ctx, authorizer.AttributesRecord{Verb: \"watch\", ResourceRequest: true})","+\trequire.NoError(t, err)","+\trequire.Equal(t, authorizer.DecisionDeny, decision)","+\trequire.Equal(t, \"resource permission denied\", reason)","+}","+","+func TestWatchRestrictionFlagChangesWithoutRestart(t *testing.T) {","+\tdelegate := authorizer.AuthorizerFunc(func(context.Context, authorizer.Attributes) (authorizer.Decision, string, error) {","+\t\treturn authorizer.DecisionAllow, \"\", nil","+\t})","+\tauth := WithWatchRestriction(delegate)","+\tfor _, enabled := range []bool{false, true, false} {","+\t\tt.Run(map[bool]string{false: \"disabled\", true: \"enabled\"}[en