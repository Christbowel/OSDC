nd_purge);","+  }","+  job_context.Clean();"," }"," "," ColumnFamilyHandle* DBImpl::DefaultColumnFamily() const {","@@ -7424,9 +7436,19 @@ Status DBImpl::Close() {","     return closing_status_;","   }"," ","+  {","+    InstrumentedMutexLock l(&mutex_);","+    if (num_live_file_pins_ > 0) {","+      return Status::Aborted(","+          \"Cannot close DB with pinned live table and blob files.\");","+    }","+    new_pins_blocked_ = true;","+  }","   {","     const Status s = MaybeReleaseTimestampedSnapshotsAndCheck();","     if (!s.ok()) {","+      InstrumentedMutexLock l(&mutex_);","+      new_pins_blocked_ = false;","       return s;","     }","   }"],"additions":38,"deletions":16,"truncated":false},{"path":"db/db_impl/db_impl.h","lines":["@@ -22,6 +22,7 @@"," #include <set>"," #include <string>"," #include <unordered_map>","+#include <unordered_set>"," #include <utility>"," #include <variant>"," #include <vector>","@@ -117,6 +118,48 @@ struct SubsetCheckpointOptionsSnapshot {","   std::vector<ColumnFamilyOptions> cf_options;"," };"," ","+// Asks the next DBImpl::GetLiveFilesStorageInfo() call on this thread,","+// including one reached through wrapper overrides, to keep the table and blob","+// files it lists on disk until `pin` is cleaned up. Only the first such call","+// takes the request. It is fulfilled only if that call succeeds, on a DB that","+// owns its table files and is not being closed. Close() returns Aborted while","+// a pin is held. Cleaning up the pin takes the DB mutex and can delete files.","+// Requires `pin` without cleanups; must be destroyed on the creating thread.","+//","+// Interim: a thread-local, so the request reaches DBImpl through wrapper","+// overrides of the public GetLiveFilesStorageInfo() virtual without changing","+// it. Unsafe for a coroutine that suspends in the request's scope. A follow-up","+// should replace it with public API support that also lets a wrapper hold its","+// own files.","+class LiveFilesPinRequest {","+ public:","+  explicit LiveFilesPinRequest(Cleanable* pin);","+  ~LiveFilesPinRequest();","+  LiveFilesPinRequest(const LiveFilesPinRequest&) = delete;","+  LiveFilesPinRequest& operator=(const LiveFilesPinRequest&) = delete;","+  LiveFilesPinRequest(LiveFilesPinRequest&&) = delete;","+  LiveFilesPinRequest& operator=(LiveFilesPinRequest&&) = delete;","+","+  // Whether `pin` holds the files in pinned_files().","+  bool pinned() const { return pinned_; }","+  // Directory, \"/\" and file name of each held table and blob file.","+  const std::unordered_set<std::string>& pinned_files() const {","+    return pinned_files_;","+  }","+","+ private:","+  friend class DBImpl;","+  static LiveFilesPinRequest* Take();","+  void Fulfill(Cleanable* pin, std::unordered_set<std::string> files);","+","+  static thread_local LiveFilesPinRequest* current_;","+  LiveFilesPinRequest* const previous_;","+  Cleanable* const pin_;","+  bool taken_ = false;","+  bool pinned_ = false;","+  std::unordered_set<std::string> pinned_files_;","+};","+"," // Class to maintain directories for all database paths other than main one."," class Directories {","  public:","@@ -697,12 +740,15 @@ class DBImpl : public DB","   // Shared body of GetLiveFilesStorageInfo and its subset-checkpoint variant.","   // include_cf_ids empty -> no filter; otherwise records skipped CF ids in","   // *excluded_cf_ids (which must be non-null in that case).","+  // A non-null pin_request is fulfilled only if the call succeeds; it requires","+  // empty include_cf_ids.","   Status GetLiveFilesStorageInfoImpl(","       const LiveFilesStorageInfoOptions& opts,","       const std::vector<uint32_t>& include_cf_ids,","       std::vector<LiveFileStorageInfo>* files,","       std::vector<uint32_t>* excluded_cf_ids,","-      SubsetCheckpointOptionsSnapshot* options_snapshot);","+      SubsetCheckpointOptionsSnapshot* options_snapshot,","+      LiveFilesPinRequest* pin_request);"," ","   // Appends kColumnFamilyDrop records to the