runcated":false},{"path":"db/db_secondary_test.cc","lines":["@@ -933,6 +933,30 @@ TEST_F(DBSecondaryTest, InternalCompactionMissingFiles) {","   ASSERT_OK(result.status);"," }"," ","+TEST_F(DBSecondaryTest, LiveFilesPinRequestNotFulfilled) {","+  Options options;","+  options.env = env_;","+  Reopen(options);","+  ASSERT_OK(Put(\"foo\", \"foo_value\"));","+  ASSERT_OK(Flush());","+  Options secondary_options;","+  secondary_options.env = env_;","+  secondary_options.max_open_files = -1;","+  OpenSecondary(secondary_options);","+","+  LiveFilesStorageInfoOptions opts;","+  opts.wal_size_for_flush = std::numeric_limits<uint64_t>::max();","+  std::vector<LiveFileStorageInfo> files;","+  Cleanable pin;","+  {","+    LiveFilesPinRequest pin_request(&pin);","+    ASSERT_OK(db_secondary_->GetLiveFilesStorageInfo(opts, &files));","+    ASSERT_FALSE(pin_request.pinned());","+  }","+  ASSERT_FALSE(files.empty());","+  ASSERT_FALSE(pin.HasCleanups());","+}","+"," TEST_F(DBSecondaryTest, OpenAsSecondary) {","   Options options;","   options.env = env_;"],"additions":24,"deletions":0,"truncated":false},{"path":"db/forward_iterator.cc","lines":["@@ -265,25 +265,9 @@ ForwardIterator::~ForwardIterator() { Cleanup(true); }"," void ForwardIterator::SVCleanup(DBImpl* db, SuperVersion* sv,","                                 bool background_purge_on_iterator_cleanup) {","   if (sv->Unref()) {","-    // Job id == 0 means that this is not our background process, but rather","-    // user thread","-    JobContext job_context(0);","     db->mutex_.Lock();","     sv->Cleanup();","-    db->FindObsoleteFiles(&job_context, false, true);","-    if (background_purge_on_iterator_cleanup) {","-      db->ScheduleBgLogWriterClose(&job_context);","-      db->AddSuperVersionsToFreeQueue(sv);","-      db->SchedulePurge();","-    }","-    db->mutex_.Unlock();","-    if (!background_purge_on_iterator_cleanup) {","-      delete sv;","-    }","-    if (job_context.HaveSomethingToDelete()) {","-      db->Pur