e {","-            auto bank = ov::npuw::weights::bank(bank_name, compiled->get_plugin()->get_core(), \"\");","+            auto bank = ov::npuw::weights::bank(bank_name,","+                                                compiled->get_plugin()->get_core(),","+                                                \"\",","+                                                shared_weight_ctx_per_bank[bank_name]);","             stream&* bank;"," ","             // Encoder embedding models are prefill-only: no kvcache/generate compiled models.","@@ -1894,7 +1943,11 @@ std::shared_ptr<ov::npuw::LLMCompiledModel> ov::npuw::LLMCompiledModel::import_m","     NPUW_ASSERT(compiled_model && \"Couldn't import NPUW compiled model!\");","     read_and_finalize_banks(stream, compiled_model);"," ","-    LOG_INFO(\"Done.\");","+    if (!shared_weight_ctx_per_bank.empty()) {","+        LOG_INFO(\"Done with shared weight contexts: \" << shared_weight_ctx_per_bank.size());","+    } else {","+        LOG_INFO(\"Done.\");","+    }"," ","     return compiled_model;"," }"],"additions":60,"deletions":7,"truncated":false},{"path":"src/plugins/intel_npu/src/plugin/npuw/serialization.cpp","lines":["@@ -16,6 +16,7 @@"," #include \"openvino/op/constant.hpp\""," #include \"openvino/op/util/op_types.hpp\""," #include \"openvino/reference/convert.hpp\"","+#include \"openvino/runtime/remote_tensor.hpp\""," #include \"openvino/runtime/shared_buffer.hpp\""," #include \"openvino/util/file_util.hpp\""," #include \"openvino/util/mmap_object.hpp\""],"additions":1,"deletions":0,"truncated":false},{"path":"src/plugins/intel_npu/src/plugin/npuw/weight_sharing_context_adapter.cpp","lines":["@@ -0,0 +1,508 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"weight_sharing_context_adapter.hpp\"","+","+#include <limits>","+#include <map>","+#include <numeric>","+","+#include \"logging.hpp\"","+#include \"openvino/core/memory_util.hpp\"","+#include \"openvino/core/parallel.hpp\"","+#include \"openvino/runtime/intel_npu/remote_properties.hpp\"","+#include \"openvino/runtime/shared_buffer.hpp\"","+#include \"orc.hpp\"","+#include \"serialization.hpp\"","+#include \"util.hpp\"","+","+using ov::npuw::weights::TransformationWeightContextIDMapper;","+using ov::npuw::weights::WeightSharingContextAccessor;","+","+namespace {","+/* TODO CVS-199040:","+ * Proper implementation of ov::IBufferDescriptor for ov::Tensor.","+ * Once that implemented, the entire struct can be removed","+ */","+struct SharedTensorDescriptor : public ov::IBufferDescriptor {","+    size_t get_id() const override {","+        return m_source_id;","+    }","+","+    size_t get_offset() const override {","+        return m_offset;","+    }","+","+    std::shared_ptr<ov::AlignedBuffer> get_source_buffer() const override {","+        // as long as we store tensor by ourselves,","+        // we can safely create a shared buffer from it every time someone asks for the source buffer.","+        //","+        // I don't want to store the tensor in WeightSharingContextAccessor, because","+        // it is not the responsibility of WeightSharingContextAccessor to manage the lifetime of the tensor.","+        // The CVS-199040 should address the proper handling of tensor lifetimes in this context,","+        // until then we store the tensor here in a temporary place.","+        return std::make_shared<ov::SharedBuffer<ov::Tensor>>(","+            const_cast<char*>(static_cast<const char*>(m_tensor.data())),","+            m_tensor.get_byte_size(),","+            m_tensor);","+    }","+","+    const ov::Tensor& get_tensor() const {","+        return m_tensor;","+    }","+","+    ~SharedTensorDescriptor() = default;","+","+    static std::shared_ptr<SharedTensorDescriptor> create(size_t source_id, size_t offset, const ov::Tensor& tensor) {","+        return std::shared_ptr<SharedTensorDescriptor>(new SharedTensorDescriptor(source_id, offset, tensor));","+    }","+","+private:","+    SharedTensorDescriptor(size_t source_id, size_t offset, const ov::Tensor& tensor)","+        : m_source_id(source_id),","+          m_offset(offset),","+          m_tensor(tensor) {}","+    size_t m_source_id;","+    size_t m_offset;","+    ov::Tensor m_tensor;","+};","+","+// TODO CVS-199040: Preserve the tensor descriptor until ov::Tensor supports IBufferDescriptor.","+// or","+// CVS-199039: In this case we woudln't need for SharedTensorDescriptor at all,","+// the HostTensor could be created directly from the staging buffer obtained by its source_id","+class SharedTensorBuffer final : public ov::SharedBuffer<ov::Tensor> {","+public:","+    using ov::SharedBuffer<ov::Tensor>::SharedBuffer;","+","+    std::shared_ptr<ov::IBufferDescriptor> get_descriptor() const override {","+        if (!m_descriptor) {","+            return {};","+        }","+        return SharedTensorDescriptor::create(m_descriptor->get_id(), m_descriptor->get_offset(), m_shared_object);","+    }","+};","+","+}  // namespace","+","+ov::Tensor ov::npuw::weights::tensor_factory(std::shared_ptr<ov::IRemoteContext> remote_ctx,","+                                             const ov::element::Type& type,","+                                             const ov::Shape& shape,","+                                             std::shared_ptr<ov::AlignedBuffer> staging_buffer_ptr) {","+    if (!remote_ctx) {","+        return staging_buffer_ptr ? ov::Tensor(type, shape, staging_buffer_ptr->get_ptr<char>())","+                                  : ov::Tensor(type, shape);","+    }","+","+    const auto& device = remote_ctx->get_device_name();","+    if (ov::npuw::util::starts_with(device, \"NPU\")) {","+        // TODO CVS-199039, CVS-199076","+        // Cannot create neither a host tensor from preexisting staging buffer nor a remote tensor for NPU remote","+        // context","+        NPUW_ASSERT(!staging_buffer_ptr && \"create_tensor_allocator: NPU remote context cannot use the existing \"","+                                           \"staging buffer for its host tensor creation\");","+    } else if (ov::npuw::util::starts_with(device, \"GPU\")) {","+        // TODO CVS-199039","+        NPUW_ASSERT(!staging_buffer_ptr && \"create_tensor_allocator: GPU remote context cannot use  the existing \"","+                                           \"staging buffer for its host tensor creation\");","+    }","+","+    return ov::make_tensor(remote_ctx->create_host_tensor(type, shape));","+}","+","+ov::Tensor ov::npuw::weights::WeightSharingContextAccessor::tensor_from_shared_buffer(","+    const ov::weight_sharing::WeightBuffer& shared_source) {","+    auto source_descriptor = shared_source->get_descriptor();","+    auto shared_descriptor = std::dynamic_pointer_cast<SharedTensorDescriptor>(source_descriptor);","+    NPUW_ASSERT(shared_descriptor && \"WeightSharingContextAccessor: Failed to cast to SharedTensorDescriptor\");","+    return shared_descriptor->get_tensor();","+}","+","+std::optional<TransformationWeightContextIDMapper::WSContextIDs>","+ov::npuw::weights::TransformationWeightContextIDMapper::get_ov_context_ids(UID_Type uid) const {","+    const auto context_ids = m_ov_context_ids.find(uid);","+    if (context_ids == m_ov_context_ids.end()) {","+        return std::nullopt;","+    }","+    return context_ids->second;","+}","+","+std::tuple<bool, TransformationWeightContextIDMapper::WSContextIDs>","+ov::npuw::weights::TransformationWeightContextIDMapper::get_or_create_ov_context_ids(UID_Type uid) {","+    const auto existing = m_ov_context_ids.find(uid);","+    if (existing != m_ov_context_ids.end()) {","+        return {true, existing->second};","+    }","+    const auto context_ids = create_ov_context_ids(uid);","+    insert_mapping(uid, context_ids);","+    return {false, context_ids};","+}","+","+TransformationWeightContextIDMapper::UID_Type","+ov::npuw::weights::TransformationWeightContextIDMapper::get_transformation_uid(const WSContextIDs& context_ids) const {","+    return m_transformation_uids.at(context_ids);","+}","+","+TransformationWeightContextIDMapper::WSContextIDs","+ov::npuw::weights::TransformationWeightContextIDMapper::create_ov_context_ids(UID_Type uid) {","+    OPENVINO_ASSERT(uid >= 0, \"Transformation UID must be nonnegative: \", uid);","+    return {static_cast<SourceID_Type>(uid) + 1, 0};","+}","+","+TransformationWeightContextIDMapper::WSContextIDs","+ov::npuw::weights::TransformationWeightContextIDMapper::set_ov_context_ids(UID_Type uid) {","+    const auto context_ids = create_ov_context_ids(uid);","+    set_transformation_uid(context_ids);","+    return context_ids;","+}","+","+TransformationWeightContextIDMapper::UID_Type","+ov::npuw::weights::TransformationWeightContextIDMapper::set_transformation_uid(const WSContextIDs& context_ids) {","+    const auto source_id = context_ids.first;","+    OPENVINO_ASSERT(source_id > 0 && source_id - 1 <= static_cast<SourceID_Type>(std::numeric_limits<UID_Type>::max()),","+                    \"Source ID cannot be mapped to a transformation UID: \",","+                    source_id);","+    const auto uid = static_cast<UID_Type>(source_id - 1);","+    insert_mapping(uid, context_ids);","+    return uid;","+}","+","+void ov::npuw::weights::TransformationWeightContextIDMapper::insert_mapping(UID_Type uid,","+                                                                            const WSContextIDs& context_ids) {","+    const auto [forward_it, inserted] = m_ov_context_ids.emplace(uid, context_ids);","+    OPENVINO_ASSERT(forward_it->second == context_ids,","+                    \"Transformation UID already maps to different context IDs: \",","+                    uid);","+    try {","+        m_transformation_uids.emplace(context_ids, uid);","+    } catch (...) {","+        if (inserted) {","+            m_ov_context_ids.erase(forward_it);","+        }","+        throw;","+    }","+}","+","+ov::weight_sharing::WeightBuffer ov::npuw::weights::WeightSharingContextAccessor::create_shared_buffer(","+    ov::weight_sharing::DataID source_id,","+    std::size_t size) {","+    // Create page aligned buffer to satisfy further GPU-NPU memory sharing requirements","+    auto raw = std::make_shared<ov::AlignedBuffer>(size, ov::util::get_system_page_size());","+    return std::make_shared<ov::SharedBuffer<std::shared_ptr<ov::AlignedBuffer>>>(","+        raw->get_ptr<char>(),","+        raw->size(),","+        raw,","+        ov::create_base_descriptor(source_id, 0, raw));","+}","+","+ov::weight_sharing::WeightBuffer ov::npuw::weights::WeightSharingContextAccessor::create_shared_buffer(","+    ov::weight_sharing::DataID source_id,","+    const ov::Tensor& tensor) {","+    return std::make_shared<SharedTensorBuffer>(const_cast<char*>(static_cast<const char*>(tensor.data())),","+                                                tensor.get_byte_size(),","+                                                tensor,","+                                                SharedTensorDescriptor::create(source_id, 0, tensor));","+}","+","+const ov::op::v0::Constant& ov::npuw::weights::WeightSharingContextAccessor::get_transformed_constant(","+    const std::string& device,","+    UID_Type transformation_uid) const {","+    OPENVINO_ASSERT(m_context, \"WeightSharingContextAccessor has no weight sharing context\");","+    auto dev_it = m_transformed_weights_per_device.find(device);","+    OPENVINO_ASSERT(dev_it != m_transformed_weights_per_device.end(),","+                    \"No transformed weights found for device: \",","+                    device);","+    auto iter = dev_it->second.find(transformation_uid);","+    OPENVINO_ASSERT(iter != dev_it->second.end(),","+                    \"Transformed constant not found for transformation UID: \",","+                    transformation_uid,","+                    \", on device: \",","+                    device);","+    return iter->second;","+}","+","+bool ov::npuw::weights::Weigh