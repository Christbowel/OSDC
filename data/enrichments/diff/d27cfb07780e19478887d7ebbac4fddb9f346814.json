ationDataBean subjectConfirmationData = new SubjectConfirmationDataBean();","+        subjectConfirmationData.setAddress(\"http://apache.org\");","+        subjectConfirmationData.setInResponseTo(\"12345\");","+        subjectConfirmationData.setNotAfter(Instant.now().plus(Duration.ofMinutes(5)));","+        subjectConfirmationData.setRecipient(\"http://recipient.apache.org\");","+","+        Response response = createResponse(subjectConfirmationData);","+","+        TokenReplayCache<String> replayCache = new EHCacheTokenReplayCache();","+        try {","+            SAMLSSOResponseValidator validator = createReplayValidator(replayCache);","+","+            SSOValidatorResponse validateSamlResponse = validator.validateSamlResponse(response, true);","+            assertEquals(response.getID(), validateSamlResponse.getResponseId());","+","+            // The same (POST binding) response is replayed","+            try {","+                validator.validateSamlResponse(copyResponse(response), true);","+                fail(\"Expected failure on replayed response\");","+            } catch (WSSecurityException ex) {","+                // expected","+            }","+        } finally {","+            replayCache.close();","+        }","+    }","+","+    // Two copies of the same response are validated concurrently, with the replay cache arranged so","+    // that both threads look the assertion id up before either of them has stored it. Only one of","+    // them may be accepted.","+    @org.junit.Test","+    public void testConcurrentlyReplayedResponseIsAcceptedOnce() throws Exception {","+        SubjectConfirmationDataBean subjectConfirmationData = new SubjectConfirmationDataBean();","+        subjectConfirmationData.setAddress(\"http://apache.org\");","+        subjectConfirmationData.setInResponseTo(\"12345\");","+        subjectConfirmationData.setNotAfter(Instant.now().plus(Duration.ofMinutes(5)));","+        subjectConfirmationData.setRecipient(\"http://recipient.apache.org\");","+","+        Response response = createResponse(subjectConfirmationData);","+","+        final int threads = 2;","+        TokenReplayCache<String> replayCache = new InterleavingTokenReplayCache(threads);","+        ExecutorService executor = Executors.newFixedThreadPool(threads);","+        try {","+            SAMLSSOResponseValidator validator = createReplayValidator(replayCache);","+","+            AtomicInteger accepted = new AtomicInteger();","+            List<Future<?>> futures = new ArrayList<>(threads);","+            for (int t = 0; t < threads; t++) {","+                final Response replayedResponse = copyResponse(response);","+                futures.add(executor.submit(() -> {","+                    try {","+                        validator.validateSamlResponse(replayedResponse, true);","+                        accepted.incrementAndGet();","+                    } catch (WSSecurityException ex) {","+                        // expected for all but one of the submissions","+                    }","+                    return null;","+                }));","+            }","+            for (Future<?> future : futures) {","+                future.get(30, TimeUnit.SECONDS);","+            }","+            assertEquals(\"The replayed response was accepted more than once\", 1, accepted.get());","+        } finally {","+            executor.shutdownNow();","+            replayCache.close();","+        }","+    }","+","+    private SAMLSSOResponseValidator createReplayValidator(TokenReplayCache<String> replayCache) {","+        SAMLSSOResponseValidator validator = new SAMLSSOResponseValidator();","+        validator.setEnforceAssertionsSigned(false);","+        validator.setIssuerIDP(\"http://cxf.apache.org/issuer\");","+        validator.setAssertionConsumerURL(\"http://recipient.apache.org\");","+        validator.setClientAddress(\"http://apache.org\");","+        validator.setRequestId(\"12345\");","+        validator.setSpIdentifier(\"http://service.apache.org\");","+        validator.setReplayCache(replayCache);","+        return validator;","+    }","+","+    // Creates an independent copy of the response (with the same assertion id), as received by","+    // another concurrent request","+    private Response copyResponse(Response response) throws Exception {","+        Document doc = DOMUtils.createDocument();","+        Element responseElement = (Element)doc.importNode(response.getDOM(), true);","+        doc.appendChild(responseElement);","+        return (Response)OpenSAMLUtil.fromDom(responseElement);","+    }","+","+    /**","+     * A replay cache whose contains() call only returns once the expected number of threads have","+     * all called it, so that a non-atomic contains-then-putId replay check lets every one of them","+     * through, whereas putIdIfAbsent accepts exactly one.","+     */","+    private static final class InterleavingTokenReplayCache implements TokenReplayCache<String> {","+        private final TokenReplayCache<String> delegate;","+        private final CyclicBarrier barrier;","+","+        InterleavingTokenReplayCache(int threads) throws Exception {","+            this.delegate = new EHCacheTokenReplayCache();","+            this.barrier = new CyclicBarrier(threads);","+        }","+","+        @Override","+        public boolean contains(String id) {","+            try {","+                barrier.await(10, TimeUnit.SECONDS);","+            } catch (Exception ex) {","+                throw new IllegalStateException(ex);","+            }","+            return delegate.contains(id);","+        }","+","+        @Override","+        public void putId(String id) {","+            delegate.putId(id);","+        }","+","+        @Override","+        public void putId(String id, Instant expiry) {","+            delegate.putId(id, expiry);","+        }","+","+        @Override","+        public boolean putIdIfAbsent(String id, Instant expiry) {","+            return delegate.putIdIfAbsent(id, expiry);","+        }","+","+        @Override","+        public void close() throws java.io.IOException {","+            delegate.close();","+        }","+    }","+","     private Response createResponse(","         SubjectConfirmationDataBean subjectConfirmationData","     ) throws Exception {"],"additions":144,"deletions":0,"truncated":false},{"path":"rt/rs/security/sso/saml/src/test/java/org/apache/cxf/rs/security/saml/sso/TokenReplayCacheTest.java","lines":["@@ -21,9 +21,17 @@"," "," import java.time.Instant;"," import java.time.temporal.ChronoUnit;","+import java.util.ArrayList;"," import java.util.Arrays;"," import java.util.Collection;","+import java.util.List;"," import java.util.UUID;","+import java.util.concurrent.CyclicBarrier;","+import java.util.concurrent.ExecutorService;","+import java.util.concurrent.Executors;","+import java.util.concurrent.Future;","+import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.AtomicIntegerArray;"," "," import org.apache.cxf.rs.security.saml.sso.jcache.JCacheTokenReplayCache;"," ","@@ -31,6 +39,7 @@"," import org.junit.runner.RunWith;"," import org.junit.runners.Parameterized;"," ","+import static org.junit.Assert.assertEquals;"," import static org.junit.Assert.assertFalse;"," import static org.junit.Assert.assertTrue;"," ","@@ -103,6 +112,73 @@ public void testTokenReplayCacheHugeExpiry() throws Exception {","         replayCache.close();","     }"," ","+    @Test","+    public void testTokenReplayCachePutIdIfAbsent() throws Exception {","+        TokenReplayCache<String> replayCache = createCache();","+        try {","+            String id = UUID.randomUUID().toString();","+            assertTrue(replayCache.putIdIfAbsent(id, null));","+            assertTrue(replayCache.contains(id));","+            assertFalse(replayCache.putIdIfAbsent(id, null));","+            assertFalse(replayCache.putIdIfAbsent(id, Instant.now().plusSeconds(100L)));","+","+            // An identifier added with putId() is also seen","+            id = UUID.randomUUID().toString();","+            replayCache.putId(id);","+            assertFalse(replayCache.putIdIfAbsent(id, null));","+","+            // An empty identifier cannot be cached, so is never reported as added","+            assertFalse(replayCache.putIdIfAbsent(null, null));","+            assertFalse(replayCache.putIdIfAbsent(\"\", null));","+            assertFalse(replayCache.contains(\"\"));","+        } finally {","+            replayCache.close();","+        }","+    }","+","+    // Concurrent requests carrying the same identifier must not all be accepted: exactly one","+    // putIdIfAbsent call per identifier may succeed.","+    @Test","+    public void testTokenReplayCacheConcurrentPutIdIfAbsent() throws Exception {","+        TokenReplayCache<String> replayCache = createCache();","+","+        final int threads = 8;","+        final int identifiers = 500;","+        List<String> ids = new ArrayList<>(identifiers);","+        for (int i = 0; i < identifiers; i++) {","+            ids.add(UUID.randomUUID().toString());","+        }","+        AtomicIntegerArray accepted = new AtomicIntegerArray(identifiers);","+        CyclicBarrier barrier = new CyclicBarrier(threads);","+        Instant expiry = Instant.now().plusSeconds(100L);","+","+        ExecutorService executor = Executors.newFixedThreadPool(threads);","+        try {","+            List<Future<?>> futures = new ArrayList<>(threads);","+            for (int t = 0; t < threads; t++) {","+                futures.add(executor.submit(() -> {","+                    barrier.await(10, TimeUnit.SECONDS);","+                    for (int i = 0; i < identifiers; i++) {","+                        if (replayCache.putIdIfAbsent(ids.get(i), expiry)) {","+                            accepted.incrementAndGet(i);","+                        }","+                    }","+                    return null;","+                }));","+            }","+            for (Future<?> future : futures) {","+                future.get(30, TimeUnit.SECONDS);","+            }","+        } finally {","+            executor.shutdownNow();","+            replayCache.close();","+        }","+","+        for (int i = 0; i < identifiers; i++) {","+            assertEquals(\"Identifier \" + i + \" was accepted more than once\", 1, accepted.get(i));","+        }","+    }","+","     private void testTokenReplayCacheInstance(TokenReplayCache<String> replayCache) throws InterruptedException {"," ","         // Test default TTL caches OK",""],"additions":76,"deletions":0,"truncated":false}],"additions":279,"deletions":4,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-26T14:32:13.033262+00:00"}