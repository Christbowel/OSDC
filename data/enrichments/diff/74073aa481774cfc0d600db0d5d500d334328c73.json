ot host dependent","+\tunavailablePlatform, err := image.NewPlatform(\"linux/ppc64le\")","+\trequire.NoError(t, err)","+","+\tsources := map[string]image.Source{","+\t\t\"oci-dir\":     image.OciDirectorySource,","+\t\t\"oci-archive\": image.OciTarballSource,","+\t}","+","+\tfor from, imageSource := range sources {","+\t\tt.Run(from, func(t *testing.T) {","+\t\t\tlocalPath := strings.TrimPrefix(imagetest.PrepareFixtureImage(t, imageSource, \"image-distro-id\"), string(imageSource)+\":\")","+","+\t\t\tt.Run(\"reports the platform from the image config\", func(t *testing.T) {","+\t\t\t\tsrc, err := syft.GetSource(","+\t\t\t\t\tcontext.Background(),","+\t\t\t\t\tlocalPath,","+\t\t\t\t\tsyft.DefaultGetSourceConfig().WithSources(from),","+\t\t\t\t)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tt.Cleanup(func() {","+\t\t\t\t\trequire.NoError(t, src.Close())","+\t\t\t\t})","+","+\t\t\t\tmeta, ok := src.Describe().Metadata.(source.ImageMetadata)","+\t\t\t\trequire.True(t, ok, \"expected image metadata, got %T\", src.Describe().Metadata)","+","+\t\t\t\t// the fixture is built for whatever the local docker daemon runs, so assert against the","+\t\t\t\t// config rather than a fixed platform","+\t\t\t\tassert.NotEmpty(t, meta.OS)","+\t\t\t\tassert.NotEmpty(t, meta.Architecture)","+\t\t\t\tassertConfigPlatform(t, meta.RawConfig, meta.OS, meta.Architecture)","+\t\t\t})","+","+\t\t\tt.Run(\"rejects a platform the image does not match\", func(t *testing.T) {","+\t\t\t\t_, err := syft.GetSource(","+\t\t\t\t\tcontext.Background(),","+\t\t\t\t\tlocalPath,","+\t\t\t\t\tsyft.DefaultGetSourceConfig().WithSources(from).WithPlatform(unavailablePlatform),","+\t\t\t\t)","+\t\t\t\trequire.ErrorContains(t, err, \"linux/ppc64le\")","+\t\t\t})","+\t\t})","+\t}","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"go.mod","lines":["@@ -19,10 +19,10 @@ require ("," \tgithub.com/anchore/go-logger v0.1.1"," \tgithub.com/anchore/go-macholibre v0.1.1"," \tgithub.com/anchore/go-rpmdb v0.2.0",