+    });","+  }","+","+  const phone = (over: Record<string, unknown> = {}) => ({","+    phone: { collect: true, custom_field_key: 'contact_phone', ...over },","+  });","+","+  async function refusal(config: Record<string, unknown>) {","+    const body = await setCheckout(config, 422);","+    return { property: body.errors[0].property, message: body.errors[0].context };","+  }","+","+  beforeAll(async function () {","+    agent = await agentProvider.getAdminAPIAgent();","+    await fixtureManager.init('users');","+    await agent.loginAsOwner();","+","+    const { body } = await agent.get('tiers/?limit=all').expectStatus(200);","+    paidTierId = body.tiers.find((tier: { type: string }) => tier.type === 'paid').id;","+    freeTierId = body.tiers.find((tier: { type: string }) => tier.type === 'free').id;","+  });","+","+  beforeEach(async function () {","+    mockManager.mockLabsEnabled('stripeCheckoutDesign');","+    mockManager.mockLabsEnabled('stripeCheckoutCollection');","+    mockManager.mockLabsEnabled('membersCustomFields');","+    await createField('Contact phone', 'short_text');","+    await createField('Delivery address', 'address');","+  });","+","+  afterEach(async function () {","+    mockManager.restore();","+    await models.Base.knex('stripe_checkout_config_tiers').del();","+    await models.Base.knex('stripe_checkout_config').del();","+    await models.Base.knex('members_metafield_bindings').del();","+    await models.Base.knex('members_metafields').del();","+    await models.Base.knex('actions')","+      .whereIn('resource_type', ['stripe_checkout_config', 'member_custom_field'])","+      .del();","+    await models.Base.knex('products').whereIn('id', [SECOND_TIER_ID, THIRD_TIER_ID]).del();","+  });","+","+  it('starts with no phone number collected', async function () {","+    assert.deepEqual((await readCheckout()).phone, NO_PHONE);","+  });","+","+  it('saves where the phone number lands, and reads it back as saved', async function () {","+    await setCheckout(phone());","+","+    const saved = await readCheckout();","+    assert.deepEqual(saved.phone, { collect: true, custom_field_key: 'contact_phone' });","+","+    await setCheckout(saved);","+    assert.deepEqual(await readCheckout(), saved);","+  });","+","+  it('covers every paid tier unless it names some', async function () {","+    await addPaidTier(SECOND_TIER_ID);","+","+    await setCheckout(phone({ tier_ids: [SECOND_TIER_ID, paidTierId, SECOND_TIER_ID] }));","+    assert.deepEqual(","+      [...(await readCheckout()).phone.tier_ids].sort(),","+      [paidTierId, SECOND_TIER_ID].sort(),","+    );","+","+    await setCheckout(phone());","+    assert.equal((await readCheckout()).phone.tier_ids, undefined);","+  });","+","+  it('keeps its tiers apart from the tiers shipping names', async function () {","+    await addPaidTier(SECOND_TIER_ID);","+    await addPaidTier(THIRD_TIER_ID);","+    await createField('Recipient name', 'short_text');","+","+    await setCheckout({","+      ...phone({ tier_ids: [SECOND_TIER_ID] }),","+      shipping: {","+        collect: true,","+        tier_ids: [THIRD_TIER_ID, paidTierId],","+        address: { custom_field_key: 'delivery_address' },","+        name: { custom_field_key: 'recipient_name' },","+      },","+    });","+","+    const saved = await readCheckout();","+    assert.deepEqual(saved.phone.tier_ids, [SECOND_TIER_ID]);","+    assert.deepEqual([...saved.shipping.tier_ids].sort(), [paidTierId, THIRD_TIER_ID].sort());"],"additions":137,"deletions":0,"truncated":false}],"additions":340,"deletions":62,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-20T14:24:33.302028+00:00"}