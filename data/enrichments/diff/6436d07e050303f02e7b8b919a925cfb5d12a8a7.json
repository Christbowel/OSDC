{"id":"6436d07e050303f02e7b8b919a925cfb5d12a8a7","axis":"silent","repo":"envoyproxy/envoy","sha":"6436d07e050303f02e7b8b919a925cfb5d12a8a7","parsed":{"files":[{"path":"api/envoy/extensions/transport_sockets/tls/cert_selectors/dynamic_modules/v3/dynamic_modules.proto","lines":["@@ -68,14 +68,14 @@ message DynamicModuleTlsCertificateSelector {","   // its certificate validation, and a handshake that selects one that is not provided yet can wait","   // until the module provides or removes it.","   //","-  // A downstream TLS context must set both","-  // :ref:`disable_stateless_session_resumption","-  // <envoy_v3_api_field_extensions.transport_sockets.tls.v3.DownstreamTlsContext.disable_stateless_session_resumption>`","-  // and :ref:`disable_stateful_session_resumption","-  // <envoy_v3_api_field_extensions.transport_sockets.tls.v3.DownstreamTlsContext.disable_stateful_session_resumption>`,","-  // and an upstream TLS context must set :ref:`max_session_keys","+  // The module also selects the certificate of a downstream handshake that resumes a session. A","+  // session that a dynamic certificate established resumes only when the selected certificate has","+  // the same subject common name, subject alternative names and issuer, and the certificate","+  // validation of the TLS context has not changed since. An upstream TLS context must set","+  // :ref:`max_session_keys","   // <envoy_v3_api_field_extensions.transport_sockets.tls.v3.UpstreamTlsContext.max_session_keys>`","-  // to 0, since a resumed session reuses the certificate of the original handshake.","+  // to 0, since a resumed upstream session keeps the client certificate of its original handshake","+  // without asking the module.","   //","   // Defaults to false.","   bool allow_dynamic_certificates = 4;"],"additions":7,"deletions":7,"truncated":false},{"path":"changelogs/current/bug_fixes/tls__session-ticket-without-keys.rst","lines":["@@ -0,0 +1,6 @@","+Fixed a crash when a :ref:`custom TLS certificate selector","+<envoy_v3_api_field_extensions.transport_sockets.tls.v3.CommonTlsContext.custom_tls_certificate_selector>`","+switched a handshake from a TLS context with session ticket keys to one without them, for example","+a context that the selector built before the keys arrived over SDS. Such a handshake now completes","+without a session ticket. The selectors that shipped with earlier Envoy releases were not affected,","+since they only switched to separately built TLS contexts when session resumption was disabled."],"additions":6,"deletions":0,"truncated":false},{"path":"changelogs/current/bug_fixes/tls__unambiguous-session-context-id.rst","lines":["@@ -0,0 +1,9 @@","+Fixed TLS session resumption across server certificates or filter chains whose names differ but","+concatenate to the same bytes, for example the DNS SANs ``a.example`` and ``b.example`` versus","+``a.exampleb.example``. The session context ID that scopes resumption to a TLS context hashed the","+common name and subject alternative names of each certificate, and each server name, without their","+types or lengths. It now hashes the type and length of every field, which changes every session","+context ID once, so a session established before the upgrade, or by an Envoy instance without this","+change that shares the session ticket keys, takes a full handshake. This change can be temporarily","+reverted by setting the runtime guard ``envoy.reloadable_features.unambiguous_tls_session_context_id``","+to ``false``."],"additions":9,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -195,6 +195,7 @@ RUNTIME_GUARD(envoy_reloadable_features_udp_hot_restart_session_handoff);"," RUNTIME_GUARD(envoy_reloadable_features_udp_send_zero_length_datagrams);"," RUNTIME_GUARD(envoy_reloadable_features_udp_set_do_not_fragment);"," RUNTIME_GUARD(envoy_reloadable_features_uhv_allow_malformed_url_encoding);","+RUNTIME_GUARD(envoy_reloadable_features_unambiguous_tls_session_context_id);"," RUNTIME_GUARD(envoy_reloadable_features_upstream_bind_config_fix_port_exhaustion);"," RUNTIME_GUARD(envoy_reloadable_features_upstream_http_filters_correct_stats_prefix);"," RUNTIME_GUARD(envoy_reloadable_features_upstream_wasm_filter_uses_root_scope);"],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/tls/BUILD","lines":["@@ -234,6 +234,7 @@ envoy_cc_library(","     ],","     deps = [","         \":context_lib\",","+        \"//source/common/common:byte_order_lib\",","         \"//source/common/tls/ocsp:ocsp_lib\",","         \"@abseil-cpp//absl/types:span\",","         \"@envoy_api//envoy/admin/v3:pkg_cc_proto\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/tls/server_context_impl.cc","lines":["@@ -19,6 +19,7 @@"," "," #include \"source/common/common/assert.h\""," #include \"source/common/common/base64.h\"","+#include \"source/common/common/byte_order.h\""," #include \"source/common/common/fmt.h\""," #include \"source/common/common/hex.h\""," #include \"source/common/common/utility.h\"","@@ -257,8 +258,44 @@ ServerContextImpl::ServerContextImpl(","   }"," }"," ","+namespace {","+","+// The type of a session context ID field. The values are part of every session context ID, so","+// changing one stops the resumption of the sessions that were established before.","+enum class SessionContextIdField : uint8_t {","+  CommonName = 1,","+  DnsSubjectAltName = 2,","+  UriSubjectAltName = 3,","+  IpSubjectAltName = 4,","+  IssuerDigest = 5,","+  CertificateValidationDigest = 6,","+  ServerName = 7,","+};","+","+// Hashes a field of the session context ID. With prefix_type_and_length, the type and the length","+// of the field precede its bytes, so that no two different sequences of fields hash the same bytes.","+void updateDigestForSessionContextIdField(bssl::ScopedEVP_MD_CTX& md, bool prefix_type_and_length,","+                                          SessionContextIdField field, const void* data,","+                                          size_t length) {","+  int rc;","+  if (prefix_type_and_length) {","+    const uint8_t field_type = static_cast<uint8_t>(field);","+    rc = EVP_DigestUpdate(md.get(), &field_type, sizeof(field_type));","+    RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+    const uint64_t field_length = toEndianness<ByteOrder::BigEndian>(static_cast<uint64_t>(length));","+    rc = EVP_DigestUpdate(md.get(), &field_length, sizeof(field_length));","+    RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+  }","+  rc = EVP_DigestUpdate(md.get(), data, length);","+  RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+}","+","+} // namespace","+"," absl::StatusOr<ServerContextImpl::SessionContextID>"," ServerContextImpl::generateHashForSessionContextId(const std::vector<std::string>& server_names) {","+  const bool prefix_type_and_length = Runtime::runtimeFeatureEnabled(","+      \"envoy.reloadable_features.unambiguous_tls_session_context_id\");","   uint8_t hash_buffer[EVP_MAX_MD_SIZE];","   unsigned hash_length = 0;"," ","@@ -289,9 +326,9 @@ ServerContextImpl::generateHashForSessionContextId(const std::vector<std::string","           return absl::InvalidArgumentError(\"Invalid TLS context has an empty subject CN\");","         }"," ","-        rc =","-            EVP_DigestUpdate(md.get(), ASN1_STRING_get0_data(cn_asn1), ASN1_STRING_length(cn_asn1));","-        RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+        updateDigestForSessionContextIdField(","+            md, prefix_type_and_length, SessionContextIdField::CommonName,","+            ASN1_STRING_get0_data(cn_asn1), ASN1_STRING_length(cn_asn1));","       }"," ","       unsigned san_count = 0;","@@ -302,21 +339,22 @@ ServerContextImpl::generateHashForSessionContextId(const std::vector<std::string","         for (const GENERAL_NAME* san : san_names.get()) {","           switch (san->type) {","           case GEN_IPADD:","-            rc = EVP_DigestUpdate(md.get(), ASN1_STRING_get0_data(san->d.iPAddress),","-                                  ASN1_STRING_length(san->d.iPAddress));","-            RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+            updateDigestForSessionContextIdField(","+                md, prefix_type_and_length, SessionContextIdField::IpSubjectAltName,","+                ASN1_STRING_get0_data(san->d.iPAddress), ASN1_STRING_length(san->d.iPAddress));","             ++san_count;","             break;","           case GEN_DNS:","-            rc = EVP_DigestUpdate(md.get(), ASN1_STRING_get0_data(san->d.dNSName),","-                                  ASN1_STRING_length(san->d.dNSName));","-            RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+            updateDigestForSessionContextIdField(","+                md, prefix_type_and_length, SessionContextIdField::DnsSubjectAltName,","+                ASN1_STRING_get0_data(san->d.dNSName), ASN1_STRING_length(san->d.dNSName));","             ++san_count;","             break;","           case GEN_URI:","-            rc = EVP_DigestUpdate(md.get(), ASN1_STRING_get0_data(san->d.uniformResourceIdentifier),","-                                  ASN1_STRING_length(san->d.uniformResourceIdentifier));","-            RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+            updateDigestForSessionContextIdField(","+                md, prefix_type_and_length, SessionContextIdField::UriSubjectAltName,","+                ASN1_STRING_get0_data(san->d.uniformResourceIdentifier),","+                ASN1_STRING_length(san->d.uniformResourceIdentifier));","             ++san_count;","             break;","           }","@@ -335,18 +373,32 @@ ServerContextImpl::generateHashForSessionContextId(const std::vector<std::string","       RELEASE_ASSERT(hash_length == SHA256_DIGEST_LENGTH,","                      fmt::format(\"invalid SHA256 hash length {}\", hash_length));"," ","-      rc = EVP_DigestUpdate(md.get(), hash_buffer, hash_length);","-      RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+      updateDigestForSessionContextIdField(md, prefix_type_and_length,","+                                           SessionContextIdField::IssuerDigest, hash_buffer,","+                                           hash_length);","     }","   }"," ","-  cert_validator_->updateDigestForSessionId(md, hash_buffer, hash_length);","+  if (prefix_type_and_length) {","+    // The certificate validator hashes settings of varying length, so its digest is one field.","+    bssl::ScopedEVP_MD_CTX validation_md;","+    rc = EVP_DigestInit(validation_md.get(), EVP_sha256());","+    RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+    cert_validator_->updateDigestForSessionId(validation_md, hash_buffer, hash_length);","+    rc = EVP_DigestFinal(validation_md.get(), hash_buffer, &hash_length);","+    RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+    updateDigestForSessionContextIdField(md, prefix_type_and_length,","+                                         SessionContextIdField::CertificateValidationDigest,","+                                         hash_buffer, hash_length);","+  } else {","+    cert_validator_->updateDigestForSessionId(md, hash_buffer, hash_length);","+  }"," ","   // Hash configured SNIs for this context, so that sessions cannot be resumed across different","   // filter chains, even when using the same server certificate.","   for (const auto& name : server_names) {","-    rc = EVP_DigestUpdate(md.get(), name.data(), name.size());","-    RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+    updateDigestForSessionContextIdField(","+        md, prefix_type_and_length, SessionContextIdField::ServerName, name.data(), name.size());","   }"," ","   SessionContextID session_id;","@@ -371,10 +423,11 @@ int ServerContextImpl::sessionTicketProcess(SSL*, uint8_t* key_name, uint8_t* iv"," ","   if (encrypt == 1) {","     // Encrypt","-    RELEASE_ASSERT(!session_ticket_keys_.empty(), \"\");","-    // TODO(ggreenway): validate in SDS that session_ticket_keys_ cannot be empty,","-    // or if we allow it to be emptied, reconfigure the context so this callback","-    // isn't set.","+    // A certificate selector can switch the handshake to a context without keys, which sends no","+    // ticket.","+    if (session_ticket_keys_.empty()) {","+      return 0;","+    }"," ","     const Envoy::Ssl::ServerContextConfig::SessionTicketKey& key = session_ticket_keys_.front();"," "],"additions":74,"deletions":21,"truncated":false},{"path":"source/extensions/transport_sockets/tls/cert_selectors/dynamic_modules/config.cc","lines":["@@ -84,14 +84,6 @@ DynamicModuleTlsCertificateSelectorConfigFactory::createTlsCertificateSelectorFa","   const auto& proto_config =","       MessageUtil::downcastAndValidate<const DynamicModuleTlsCertificateSelectorProto&>(","           config, factory_context.messageValidationVisitor());","-  // The session resumption context of the TLS context does not cover the dynamic certificates.","-  if (proto_config.allow_dynamic_certificates() &&","-      (!tls_config.disableStatelessSessionResumption() ||","-       !tls_config.disableStatefulSessionResumption())) {","-    return absl::InvalidArgumentError(","-        \"Dynamic certificates require both stateless and stateful session resumption to be \"","-        \"disabled\");","-  }","   auto selector_config = loadSelectorConfig(","       proto_config, factory_context, tls_config, false,","       [&tls_config](Stats::Scope& scope,"],"additions":0,"deletions":8,"truncated":false},{"path":"test/common/tls/BUILD","lines":["@@ -51,6 +51,7 @@ envoy_cc_test(","         \"//source/common/tls:context_lib\",","         \"//source/common/tls:server_context_config_lib\",","         \"//source/common/tls:server_context_lib\",","+        \"//source/common/tls:ssl_handshaker_lib\",","         \"//source/common/tls:ssl_socket_lib\",","         \"//source/common/tls:utility_lib\",","         \"//source/common/tls/private_key:private_key_manager_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"test/common/tls/context_impl_test.cc","lines":["@@ -1287,6 +1287,28 @@ TEST_F(SslServerContextImplTicketTest, TicketKeyNone) {","   EXPECT_NO_THROW(loadConfigV2(cfg));"," }"," ","+// A certificate selector can switch the handshake to a context without keys, which sends no","+// ticket.","+TEST_F(SslServerContextImplTicketTest, TicketKeyNoneSendsNoTicket) {","+  const std::string yaml = R\"EOF(","+  common_tls_context:","+    tls_certificates:","+      certificate_chain:","+        filename: \"{{ test_rundir }}/test/common/tls/test_data/unittest_cert.pem\"","+      private_key:","+        filename: \"{{ test_rundir }}/test/common/tls/test_data/unittest_key.pem\"","+)EOF\";","+  envoy::extensions::transport_sockets::tls::v3::DownstreamTlsContext tls_context;","+  TestUtility::loadFromYaml(TestEnvironment::substitute(yaml), tls_context);","+  auto server_context_config =","+      *ServerContextConfigImpl::create(tls_context, factory_context_, {}, false);","+  Envoy::Ssl::ServerContextSharedPtr server_context =","+      *manager_.createSslServerContext(*store_.rootScope(), *server_context_config, nullptr);","+  auto cleanup = cleanUpHelper(server_context);","+  EXPECT_EQ(0, dynamic_cast<ServerContextImpl&>(*server_context)","+                   .sessionTicketProcess(nullptr, nullptr, nullptr, nullptr, nullptr, 1));","+}","+"," TEST_F(SslServerContextImplTicketTest, TicketKeyInlineBytesSuccess) {","   envoy::extensions::transport_sockets::tls::v3::DownstreamTlsContext cfg;","   cfg.mutable_session_ticket_keys()->add_keys()->set_inline_bytes(std::string(80, '\\0'));"],"additions":22,"deletions":0,"truncated":false},{"path":"test/common/tls/ssl_socket_test.cc","lines":["@@ -6168,6 +6168,69 @@ TEST_P(SslSocketTest, TicketSessionResumptionDifferentServerCertDifferentSAN) {","                               version_);"," }"," ","+// Returns the config of a server that issues session tickets with ticket_key_a, with the","+// certificate and the key of the given name in the test data.","+std::string sessionTicketServerCtxYaml(absl::string_view certificate_name) {","+  return fmt::format(R\"EOF(","+  common_tls_context:","+    tls_certificates:","+      certificate_chain:","+        filename: \"{{{{ test_rundir }}}}/test/common/tls/test_data/{0}_cert.pem\"","+      private_key:","+        filename: \"{{{{ test_rundir }}}}/test/common/tls/test_data/{0}_key.pem\"","+  session_ticket_keys:","+    keys:","+      filename: \"{{{{ test_rundir }}}}/test/common/tls/test_data/ticket_key_a\"","+)EOF\",","+                     certificate_name);","+}","+","+// Runs testTicketSessionResumption() for two servers whose names differ but concatenate to the","+// same bytes. Sessions resume across them only when the runtime guard is disabled, which leaves","+// the type and the length of each name out of the session context ID.","+void testTicketSessionResumptionAcrossConcatenatedNames(","+    const std::string& server_ctx_yaml1, const std::vector<std::string>& server_names1,","+    const std::string& server_ctx_yaml2, const std::vector<std::string>& server_names2,","+    const Network::Address::IpVersion ip_version) {","+  const std::string client_ctx_yaml = R\"EOF(","+    common_tls_context:","+  )EOF\";","+  {","+    TestScopedRuntime scoped_runtime;","+    scoped_runtime.mergeValues(","+        {{\"envoy.reloadable_features.unambiguous_tls_session_context_id\", \"false\"}});","+    testTicketSessionResumption(server_ctx_yaml1, server_names1, server_ctx_yaml2, server_names2,","+                                client_ctx_yaml, /*expect_reuse=*/true, ip_version);","+  }","+  testTicketSessionResumption(server_ctx_yaml1, server_names1, server_ctx_yaml2, server_names2,","+                              client_ctx_yaml, /*expect_reuse=*/false, ip_version);","+}","+","+// Sessions cannot be resumed because the SANs of the server certificates are different, even","+// though the two SANs of one certificate concatenate to the SAN of the other.","+TEST_P(SslSocketTest, TicketSessionResumptionDifferentServerCertConcatenatedSans) {","+  testTicketSessionResumptionAcrossConcatenatedNames(","+      sessionTicketServerCtxYaml(\"san_multiple_dns\"), {},","+      sessionTicketServerCtxYaml(\"san_concatenated_dns\"), {}, version_);","+}","+","+// Sessions cannot be resumed because the SAN of one server certificate is a DNS SAN, while the SAN","+// of the other is a URI SAN with the same name.","+TEST_P(SslSocketTest, TicketSessionResumptionDifferentServerCertSanType) {","+  testTicketSessionResumptionAcrossConcatenatedNames(","+      sessionTicketServerCtxYaml(\"san_dns\"), {},","+      sessionTicketServerCtxYaml(\"san_uri_with_dns_name\"), {}, version_);","+}","+","+// Sessions cannot be resumed because the server names are different, even though the two server","+// names of one server concatenate to the server name of the other.","+TEST_P(SslSocketTest, TicketSessionResumptionConcatenatedServerNames) {","+  const std::string server_ctx_yaml = sessionTicketServerCtxYaml(\"san_dns\");","+  testTicketSessionResumptionAcrossConcatenatedNames(","+      server_ctx_yaml, {\"server1.example.com\", \"server2.example.com\"}, server_ctx_yaml,","+      {\"server1.example.comserver2.example.com\"}, version_);","+}","+"," TEST_P(SslSocketTest, SessionResumptionDisabled) {","   const std::string server_ctx_yaml = R\"EOF(","   common_tls_context:"],"additions":63,"deletions":0,"truncated":false},{"path":"test/common/tls/test_data/BUILD","lines":["@@ -52,6 +52,7 @@ CERTS = [","     \"password_protected_cert.pem\",","     \"password_protected_cert_info.h\",","     \"password_protected_certkey.p12\",","+    \"san_concatenated_dns_cert.pem\",","     \"san_dns2_