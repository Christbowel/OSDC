map[time.Time]builder","+// MultiObjectBuilder keeps one [logsobj.Builder] per tenant and ToC window.","+type MultiObjectBuilder struct {","+\tbuilders         map[builderScope]builder"," \tbuilderFactory   builderFactory"," \tmaxBufferedBytes int"," }"," ","-// NewTOCAlignedMultiBuilder creates a new TOC aligned builder group.","-// maxBufferedBytes is the combined upper bound across all window builders;","-func NewTOCAlignedMultiBuilder(builderFactory builderFactory, maxBufferedBytes int) *TOCAlignedMultiBuilder {","-\treturn &TOCAlignedMultiBuilder{","-\t\tbuilders:         make(map[time.Time]builder),","+// builderScope identifies the entries a single builder in a","+// [MultiObjectBuilder] accepts.","+type builderScope struct {","+\ttenant string","+\twindow time.Time","+}","+","+func (s builderScope) String() string {","+\treturn fmt.Sprintf(\"{tenant=%s, window=%s}\", s.tenant, s.window.Format(time.RFC3339))","+}","+","+func compareScopes(a, b builderScope) int {","+\treturn cmp.Or(strings.Compare(a.tenant, b.tenant), a.window.Compare(b.window))","+}","+","+// NewMultiObjectBuilder creates a new builder group scoped by tenant and ToC","+// window. maxBufferedBytes is the combined upper bound across all builders.","+func NewMultiObjectBuilder(builderFactory builderFactory, maxBufferedBytes int) *MultiObjectBuilder {","+\treturn &MultiObjectBuilder{","+\t\tbuilders:         make(map[builderScope]builder),"," \t\tbuilderFactory:   builderFactory,"," \t\tmaxBufferedBytes: maxBufferedBytes,"," \t}"," }"," ","-var _ multiBuilder = (*TOCAlignedMultiBuilder)(nil)","+var _ multiBuilder = (*MultiObjectBuilder)(nil)"," ","-func (m *TOCAlignedMultiBuilder) Append(tenant string, stream logproto.Stream, recTime time.Time) error {","+func (m *MultiObjectBuilder) Append(tenant string, stream logproto.Stream, recTime time.Time) error {"," \t// [stream] might contain entries for multiple time windows => we need to split them to multiple streams, where"," \t// each one only contains the entries for a single time window"," \tstreamsByTimeWindows := make(map[time.Time]logproto.Stream, 1)","@@ -54,40 +68,41 @@ func (m *TOCAlignedMultiBuilder) Append(tenant string, stream logproto.Stream, r"," \t}"," "," \tfor w, stream := range streamsByTimeWindows {","-\t\tb, exists := m.builders[w]","+\t\tscope := builderScope{tenant: tenant, window: w}","+\t\tb, exists := m.builders[scope]"," \t\tif !exists {"," \t\t\tvar err error"," \t\t\tb, err = m.builderFactory.NewBuilder()"," \t\t\tif err != nil {","-\t\t\t\treturn fmt.Errorf(\"error creating logsobj builder for window %s: %w\", w.Format(time.RFC3339), err)","+\t\t\t\treturn fmt.Errorf(\"error creating logsobj builder for scope %s: %w\", scope, err)"," \t\t\t}"," \t\t}"," \t\tif err := b.Append(tenant, stream, recTime); err != nil {","-\t\t\treturn fmt.Errorf(\"append for window %s: %w\", w.Format(time.RFC3339), err)","+\t\t\treturn fmt.Errorf(\"append for scope %s: %w\", scope, err)"," \t\t}"," "," \t\tif !exists {"," \t\t\t// Only store a new builder into the map if append succeeded to avoid empty builders added to the map"," \t\t\t// on Append errors.","-\t\t\tm.builders[w] = b","+\t\t\tm.builders[scope] = b"," \t\t}"," \t}"," "," \treturn nil"," }"," ","-// IsFull reports whether the combined buffered size across all window","-// builders has exceeded the configured target object size.","+// IsFull reports whether the combined buffered size across all builders has","+// exceeded the configured target object size."," //"," // We intentionally compare the *sum* (rather than each individual builder's","-// IsFull) so that a partition that receives records spanning many windows is","-// still bounded to roughly MaxBufferedBytes of buffered memory, rather","-// than K*MaxBufferedBytes.","-func (m *TOCAlignedMultiBuilder) IsFull() bool {","+// IsFull) so that a partition that receives records spanning many tenants and","+// windows is still bounded to roughly MaxBufferedBytes of buffered memory,","+// rather than K*MaxBufferedBytes.","+func (m *MultiObjectBuilder) IsFull() bool {"," \treturn m.GetEstimatedSize() > m.maxBufferedBytes"," }"," ","-func (m *TOCAlignedMultiBuilder) GetEstimatedSize() int {","+func (m *MultiObjectBuilder) GetEstimatedSize() int {"," \tsize := 0"," \tfor _, b := range m.builders {"," \t\tsize += b.GetEstimatedSize()","@@ -95,27 +110,23 @@ func (m *TOCAlignedMultiBuilder) GetEstimatedSize() int {"," \treturn size"," }"," ","-func (m *TOCAlignedMultiBuilder) Reset() {","+func (m *MultiObjectBuilder) Reset() {"," \tclear(m.builders)"," }"," ","-// GetBuilders returns all per-window builders, sorted in ascending order of","+// GetBuilders returns all builders, sorted by tenant and then by ascending"," // window start time."," //"," // A deterministic order keeps flush-time side effects (metastore event","-// writes, offset commits, and any future per-window metrics) predictable","+// writes, offset commits, and any future per-scope metrics) predictable"," // regardless of Go's map iteration randomization, which simplifies both"," // tests and operational reasoning.","-func (m *TOCAlignedMultiBuilder) GetBuilders() []builder {","-\twindows := make([]time.Time, 0, len(m.builders))","-\tfor w := range m.builders {","-\t\twindows = append(windows, w)","-\t}","-\tsort.Slice(windows, func(i, j int) bool { return windows[i].Before(windows[j]) })","+func (m *MultiObjectBuilder) GetBuilders() []builder {","+\tscopes := slices.SortedFunc(maps.Keys(m.builders), compareScopes)"," ","-\tresult := make([]builder, 0, len(m.builders))","-\tfor _, w := range windows {","-\t\tresult = append(result, m.builders[w])","+\tresult := make([]builder, 0, len(scopes))","+\tfor _, s := range scopes {","+\t\tresult = append(result, m.builders[s])"," \t}"," \treturn result"," }"],"additions":49,"deletions":38,"truncated":false},{"path":"pkg/dataobj/builder/multi_builder_test.go","lines":["@@ -18,9 +18,9 @@ func windowEntry(window time.Time, offset time.Duration, line 