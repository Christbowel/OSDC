\Extensionmanager\\Service;","+","+use TYPO3\\CMS\\Core\\Core\\Environment;","+use TYPO3\\CMS\\Core\\Package\\PackageManager;","+use TYPO3\\CMS\\Extensionmanager\\Enum\\UnrecognizedExtensionFolderReason;","+","+/**","+ * Finds folders in the extensions path of a classic mode installation which","+ * the package manager skips, because their composer.json is missing or does","+ * not describe a TYPO3 extension.","+ *","+ * @internal","+ */","+readonly class UnrecognizedExtensionFolderFinder","+{","+    public function __construct(","+        private PackageManager $packageManager,","+    ) {}","+","+    /**","+     * @return array<string, UnrecognizedExtensionFolderReason> keyed by folder name","+     */","+    public function find(): array","+    {","+        $extensionsPath = Environment::getExtensionsPath();","+        if (Environment::isComposerMode() || !is_dir($extensionsPath)) {","+            return [];","+        }","+        $registeredPaths = [];","+        foreach ($this->packageManager->getAvailablePackages() as $package) {","+            $registeredPaths[] = realpath($package->getPackagePath());","+        }","+        $unrecognizedFolders = [];","+        foreach (new \\DirectoryIterator($extensionsPath) as $folder) {","+            if (!$folder->isDir() || str_starts_with($folder->getFilename(), '.')) {","+                continue;","+            }","+            if (in_array(realpath($folder->getPathname()), $registeredPaths, true)) {","+                continue;","+            }","+            $reason = $this->determineReason($folder->getPathname() . '/composer.json');","+            if ($reason !== null) {","+                $unrecognizedFolders[$folder->getFilename()] = $reason;","+            }","+        }","+        ksort($unrecognizedFolders);","+        return $unrecognizedFolders;","+    }","+","+    private function determineReason(string $composerJsonPath): ?UnrecognizedExtensionFolderReason","+    {","+        if (!is_file($composerJsonPath)) {","+            return UnrecognizedExtensionFolderReason::MissingComposerJson;","+        }","+        try {","+            $manifest = json_decode((string)file_get_contents($composerJsonPath), true, 512, JSON_THROW_ON_ERROR);","+        } catch (\\JsonException) {","+            return UnrecognizedExtensionFolderReason::InvalidComposerJson;","+        }","+        if (!is_array($manifest)) {","+            return UnrecognizedExtensionFolderReason::InvalidComposerJson;","+        }","+        if (!str_starts_with((string)($manifest['type'] ?? ''), 'typo3-cms-')) {","+            return UnrecognizedExtensionFolderReason::NoTypo3PackageType;","+        }","+        if (empty($manifest['extra']['typo3/cms']['extension-key'])) {","+            return UnrecognizedExtensionFolderReason::MissingExtensionKey;","+        }","+        if ($this->packageManager->isFrameworkPackage((string)($manifest['name'] ?? ''))) {","+            return null;","+        }","+        $hasVersion = isset($manifest['version']) || isset($manifest['extra']['typo3/cms']['version']);","+        if (!$hasVersion || !isset($manifest['extra']['typo3/cms']['Package']['providesPackages'])) {","+            return UnrecognizedExtensionFolderReason::MissingPackageMetadata;","+        }","+        return null;","+    }","+}"],"additions":95,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Resources/Private/Language/locallang.xlf","lines":["@@ -453,6 +453,39 @@","       <trans-unit id=\"task.updateExtensionListTask.description\">","         <source>Makes regular updates to TER extension list. Recommended interval is once a day.</source>","       </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.title\">","+        <source>Folders not recognized as extensions</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.message\">","+        <source>The following folders in \"%s\" are not loaded as extensions. Every extension needs a composer.json with the type \"typo3-cms-extension\", the extension key, the version and \"providesPackages\" in the section \"extra/typo3/cms\".</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.documentation\">","+        <source>Read more about the required composer.json</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.reason.missingComposerJson\">","+        <source>no composer.json</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.reason.invalidComposerJson\">","+        <source>composer.json is not valid JSON</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.reason.noTypo3PackageType\">","+        <source>composer.json declares no TYPO3 package type such as \"typo3-cms-extension\"</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.reason.missingExtensionKey\">","+        <source>composer.json declares no \"extension-key\" in the section \"extra/typo3/cms\"</source>","+      </trans-unit>","+      <trans-unit id=\"unrecognizedExtensionFolder.reason.missingPackageMetadata\">","+        <source>composer.json declares no version or no \"providesPackages\" in the section \"extra/typo3/cms\"</source>","+      </trans-unit>","+      <trans-unit id=\"report.status.unrecognizedExtensionFolders.title\">","+        <source>Folders in the extension directory</source>","+      </trans-unit>","+      <trans-unit id=\"report.status.unrecognizedExtensionFolders.none.value\">","+        <source>OK</source>","+      </trans-unit>","+      <trans-unit id=\"report.status.unrecognizedExtensionFolders.found.value\">","+        <source>%s folder(s) not recognized as extension</source>","+      </trans-unit>","       <trans-unit id=\"report.status.mainRepository.title\">","         <source>Update status of typo3.org main repository extension list</source>","       </trans-unit>"],"additions":33,"deletions":0,"tr