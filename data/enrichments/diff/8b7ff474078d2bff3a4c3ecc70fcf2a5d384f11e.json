AL_CROSS_PRODUCT:","+\tcase LogicalOperatorType::LOGICAL_DISTINCT:","+\tcase LogicalOperatorType::LOGICAL_WINDOW:","+\tcase LogicalOperatorType::LOGICAL_LIMIT:","+\tcase LogicalOperatorType::LOGICAL_ORDER_BY:","+\tcase LogicalOperatorType::LOGICAL_UNION:","+\tcase LogicalOperatorType::LOGICAL_DUMMY_SCAN:","+\tcase LogicalOperatorType::LOGICAL_EXPRESSION_GET:","+\t\tbreak;","+\tdefault:","+\t\treturn false;","+\t}","+\tbool repeatable = true;","+\tLogicalOperatorVisitor::EnumerateExpressions(op, [&](unique_ptr<Expression> *expr) {","+\t\trepeatable &= !(*expr)->IsVolatile() && !ExpressionBarrier::Contains(**expr);","+\t\tExpressionIterator::VisitExpression<BoundFunctionExpression>(**expr, [&](const BoundFunctionExpression &func) {","+\t\t\trepeatable &= !func.Function().RequiresOrderedExecution();","+\t\t});","+\t});","+\tif (!repeatable) {","+\t\treturn false;","+\t}","+\tfor (auto &child : op.children) {","+\t\tif (!CanRestrictCorrelationDomain(*child, local_ctes)) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+"," DelimJoinCTERewriter::DelimJoinCTERewriter(Binder &binder) : binder(binder) {"," \tauto &config = DBConfig::GetConfig(binder.context);"," \tcte_deliminator_enabled =","@@ -2577,6 +2635,12 @@ BindingReplacementGraph DelimJoinCTERewriter::MaterializeDelimJoinAsCTE(unique_p"," \t\treturn {};"," \t}"," \tgenerated_dedup_cte_indexes.push_back(dedup_cte_index);","+\tunordered_set<TableIndex> local_ctes {dedup_cte_index};","+\tconst bool requires_left_row = join.join_type == JoinType::INNER || join.join_type == JoinType::LEFT ||","+\t                               join.join_type == JoinType::SEMI || join.join_type == JoinType::ANTI ||","+\t                               join.join_type == JoinType::MARK;","+\t// Only RHS partitions are removed; ordinary filter pushdown handles the producer.","+\tconst bool can_restrict_input = requires_left_row && CanRestrictCorrelationDomain(*plan->children[1], local_ctes);"," "," \tplan->children[0]->ResolveOperatorTypes();"," \tauto left_bindings = plan->children[0]->GetColumnBindings();","@@ -2699,6 +2763,9 @@ BindingReplacementGraph DelimJoinCTERewriter::MaterializeDelimJoinAsCTE(unique_p"," \toutput_replacements.Merge(cte_output_replacements);"," \tauto cte = make_uniq<LogicalMaterializedCTE>(cte_name, cte_index, left_column_count, std::move(cte_source),"," \t                                             std::move(cte_child), CTEMaterialize::CTE_MATERIALIZE_DEFAULT);","+\tif (can_restrict_input) {","+\t\tcte->filter_dependency = make_uniq<CTEFilterDependency>(left_cte_ref_index, dedup_child_index);","+\t}"," \tplan = std::move(cte);"," \treturn output_replacements;"," }"],"additions":67,"deletions":0,"truncated":false},{"path":"test/configs/disable_optimizer.json","lines":["@@ -4,6 +4,12 @@","   \"skip_compiled\": \"true\",","   \"inherit_skip_tests\": \"test/configs/stats_dependent_tests.json\",","   \"skip_tests\": [","+    {","+      \"reason\": \"Checks projection evaluation counts after optimizer filter pushdown.\",","+      \"paths\": [","+        \"test/optimizer/pushdown/lateral_projection_evaluation.test\"","+      ]","+    },","     {","       \"reason\": \"Requires the join order optimizer to enforce debug_force_no_cross_product.\",","       \"paths\": ["],"additions":6,"deletions":0,"truncated":false},{"path":"test/optimizer/pushdown/lateral_projection_evaluation.test","lines":["@@ -0,0 +1,33 @@","+# name: test/optimizer/pushdown/lateral_projection_evaluation.test","+# description: Preserve projection evaluation counts when restricting a correlation domain","+# group: [pushdown]","+","+statement ok","+CREATE TABLE vertices AS SELECT i::INTEGER AS id FROM range(1, 101) t(i);","+","+statement ok","+CREATE VIEW walk_rows AS","+SELECT t.id, r.depth","+FROM vertices t,","+LATERAL (","+    WITH RECURSIVE walk(depth) AS (","+        SELECT 0 + t.id * 0","+        UNION ALL","+        SELECT depth + 1 FROM walk WHERE depth < 7","+    )","+    SELECT depth FROM walk","+) r;","+","+statement ok","+CREATE SEQUENCE projected_calls;","+","+# Filter pushdown restricts the input before evaluating the projection on the retained rows.","+query II","+SELECT sum(v), count(*) FROM (SELECT id, nextval('projected_calls') AS v FROM walk_rows) q WHERE id = 3;","+----","+36\t8","+","+query I","+SELECT currval('projected_calls');","+----","+8"],"additions":33,"deletions":0,"truncated":false},{"path":"test/sql/cte/cte_filter_pushdown_predicates.test","lines":["@@ -0,0 +1,111 @@","+# name: test/sql/cte/cte_filter_pushdown_predicates.test","+# description: Copy repeatable conjuncts into materialized CTE producers","+# group: [cte]","+","+statement ok","+SET enable_optimizer=true;","+","+statement ok","+SET debug_verify_serializer=false;","+","+statement ok","+CREATE TABLE strings(s VARCHAR, id INTEGER);","+","+statement ok","+INSERT INTO strings VALUES ('1',1), ('2',2), ('3',3);","+","+# Throwing casts can be copied: each consumer already evaluates them on the producer's rows.","+query I","+WITH c AS MATERIALIZED (SELECT * FROM strings) SELECT count(*) FROM c WHERE s::INTEGER=1;","+----","+1","+","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM strings) SELECT count(*) FROM c WHERE s::INTEGER=1;","+----","+physical_plan\t<REGEX>:[\\s\\S]*CAST\\(s AS INTEGER\\) = 1[\\s\\S]*CAST\\(s AS INTEGER\\) = 1[\\s\\S]*","+","+# The safe conjunct can restrict the producer without copying random().","+query I","+WITH c AS MATERIALIZED (SELECT * FROM strings) SELECT count(*) FROM c WHERE id=1 AND random()<2;","+----","+1","+","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM strings) SELECT count(*) FROM c WHERE id=1 AND random()<2;","+----","+physical_plan\t<REGEX>:[\\s\\S]*Filters: id = 1[\\s\\S]*","+","+# All independent consumers contribute to the disjunction of retained rows.","+query II","+WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT (SELECT count(*) FROM c WHERE id=1 AND random()<2),","+       (SELECT count(*) FROM c WHERE id=2 AND random()<2);","+----","+1\t1","+","+# A consumer without a repeatable conjunct must still see the entire producer.","+query II","+WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT (SELECT count(*) FROM c WHERE id=1 AND random()<2),","+       (SELECT count(*) FROM c WHERE random()<2);","+----","+1\t3","+","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT (SELECT count(*) FROM c WHERE id=1 AND random()<2),","+       (SELECT count(*) FROM c WHERE random()<2);","+----","+physical_plan\t<!REGEX>:[\\s\\S]*Filters: id = 1[\\s\\S]*","+","+statement ok","+CREATE SEQUENCE filter_calls;","+","+query I","+WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT count(*) FROM c WHERE nextval('filter_calls') <= 3;","+----","+3","+","+query I","+SELECT currval('filter_calls');","+----","+3","+","+# Barriers remain at the consumer, including when they wrap a throwing expression.","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT count(*) FROM c WHERE __internal_barrier(id=1);","+----","+physical_plan\t<!REGEX>:[\\s\\S]*Filters: id = 1[\\s\\S]*","+","+query I","+WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT count(*) FROM c WHERE id=1 AND __internal_barrier(s::INTEGER=1);","+----","+1","+","+statement ok","+INSERT INTO strings VALUES ('invalid',4);","+","+# A skipped volatile conjunct can short-circuit a throwing predicate.","+query I","+WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT count(*) FROM c WHERE random()<0 AND s::INTEGER=1;","+----","+0","+","+query I","+WITH c AS MATERIALIZED (SELECT * FROM strings)","+SELECT count(*) FROM c WHERE id=4 AND random()<0 AND s::INTEGER=1;","+----","+0","+","+statement error","+WITH c AS MATERIALIZED (SELECT * FROM strings) SELECT count(*) FROM c WHERE s::INTEGER=1;","+----","+Could not convert string 'invalid'","+","+statement ok","+RESET debug_verify_serializer;"],"additions":111,"deletions":0,"truncated":false},{"path":"test/sql/subquery/lateral/lateral_domain_filter.test","lines":["@@ -0,0 +1,296 @@","+# name: test/sql/subquery/lateral/lateral_domain_filter.test","+# description: Restrict a generated correlation domain through its outer-row consumer","+# group: [lateral]","+","+# Plan assertions use the original planner metadata; disabled and serialized paths are checked below.","+statement ok","+SET enable_optimizer=true;","+","+statement ok","+SET debug_verify_serializer=false;","+","+statement ok","+SET max_execution_time=10000;","+","+statement ok","+CREATE TABLE vertices AS SELECT i::INTEGER AS id FROM range(100) t(i);","+","+statement ok","+CREATE VIEW joined_walk AS","+SELECT input.id, expanded.depth","+FROM vertices input","+CROSS JOIN LATERAL (","+    WITH RECURSIVE walk(depth) AS (","+        SELECT 0 + input.id * 0","+        UNION ALL","+        SELECT depth + 1 FROM walk WHERE depth < 7","+    )","+    SELECT depth FROM walk","+) expanded","+JOIN vertices target ON target.id = expanded.depth + 1;","+","+query I","+SELECT count(*) FROM joined_walk WHERE id = 3;","+----","+8","+","+# The predicate must reach the producer, not just its outer-row CTE scan.","+query II","+EXPLAIN SELECT count(*) FROM joined_walk WHERE id = 3;","+----","+physical_plan\t<REGEX>:[\\s\\S]*Filters: id = 3[\\s\\S]*","+","+query II","+SELECT count(*), sum(depth) FROM joined_walk WHERE id = 3 AND depth > 4;","+----","+3\t18","+","+query I","+SELECT count(*) FROM (SELECT depth, id AS selected FROM joined_walk) q,","+    (VALUES (1), (2)) v(x) WHERE selected = 3;","+----","+16","+","+# Non-key filters retain every needed key, without losing duplicate outer rows.","+statement ok","+CREATE TABLE owners(person INTEGER, class INTEGER);","+","+statement ok","+INSERT INTO owners VALUES (1,10), (1,10), (1,NULL), (2,10), (3,20);","+","+statement ok","+CREATE VIEW owner_walk AS","+SELECT o.person, o.class, w.depth","+FROM owners o, LATERAL (","+    WITH RECURSIVE walk(depth) AS (","+        SELECT 0 + coalesce(o.class, 0) * 0","+        UNION ALL SELECT depth + 1 FROM walk WHERE depth < 2","+    ) SELECT depth FROM walk","+) w JOIN vertices v ON v.id = w.depth;","+","+query II","+SELECT count(*), sum(depth) FROM owner_walk WHERE person = 1;","+----","+9\t9","+","+query II","+EXPLAIN SELECT count(*) FROM owner_walk WHERE person = 1;","+----","+physical_plan\t<REGEX>:[\\s\\S]*Filters: person = 1[\\s\\S]*","+","+# Shared consumers and global windows must retain their complete input.","+query II","+WITH shared AS MATERIALIZED (SELECT * FROM owner_walk)","+SELECT (SELECT count(*) FROM shared WHERE person = 1), (SELECT count(*) FROM shared);","+----","+9\t15","+","+query I","+SELECT count(*) FROM (SELECT *, count(*) OVER () AS n FROM owner_walk) q","+WHERE person = 1 AND n = 15;","+----","+9","+","+query II","+EXPLAIN SELECT count(*) FROM (SELECT * FROM owner_walk LIMIT 1) q WHERE person = 1;","+----","+physical_plan\t<!REGEX>:[\\s\\S]*Filters: person = 1[\\s\\S]*","+","+# A user CTE's unfiltered aggregate consumer needs all rows, including matching keys.","+query II rowsort","+WITH r AS MATERIALIZED (SELECT * FROM owners), d AS (SELECT class, sum(person) AS total FROM r GROUP BY class)","+SELECT r.class, d.total FROM r JOIN d ON r.class IS NOT DISTINCT FROM d.class WHERE r.person = 1;","+----","+10\t4","+10\t4","+NULL\t1","+","+# Lowering remains correct when optional optimizations are disabled.","+foreach setting enable_optimizer debug_disable_optimizer","+","+statement ok","+SET {setting} = false;","+","+query I","+SELECT count(*) FROM joined_walk WHERE id = 3;","+----","+8","+","+statement ok","+SET {setting} = true;","+","+query I","+SELECT count(*) FROM joined_walk WHERE id = 3;","+----","+8","+","+statement ok","+RESET {setting};","+","+endloop","+","+foreach disabled filter_pushdown cte_filter_pusher cte_inlining unused_columns deliminator","+","+statement ok","+SET disabled_optimizers = '{disabled}';","+","+query II","+SELECT count(*), sum(depth) FROM owner_walk WHERE person = 1;","+----