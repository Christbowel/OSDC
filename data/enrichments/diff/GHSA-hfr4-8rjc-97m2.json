{"id":"GHSA-hfr4-8rjc-97m2","axis":"advisories","repo":"rails/rails","sha":"7fe85a72a789eae5ee070ce3ee1dad10a8a5f70c","parsed":{"files":[{"path":"activestorage/CHANGELOG.md","lines":["@@ -1,3 +1,15 @@","+*   Enforce the declared content length on Google Cloud Storage direct uploads.","+","+    The signed URL now requires an `x-goog-content-length-range` header matching the blob's","+    `byte_size`, so Cloud Storage rejects a body of any other size.","+","+    Browsers send the new header, so a bucket's CORS configuration must list","+    `x-goog-content-length-range` in `responseHeader`, or direct uploads from the browser fail.","+","+    [GHSA-hfr4-8rjc-97m2]","+","+    *Mike Dalessio*","+"," *   Sign GCS direct uploads with V2 when `cache_control` is set."," ","     V4 signatures did not bind the Content-Type or Content-MD5 headers, so the uploader could"],"additions":12,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage/service/gcs_service.rb","lines":["@@ -89,14 +89,14 @@ def exist?(key)","       end","     end"," ","-    def url_for_direct_upload(key, expires_in:, checksum:, custom_metadata: {}, **)","+    def url_for_direct_upload(key, expires_in:, checksum:, content_length:, custom_metadata: {}, **)","       instrument :url, key: key do |payload|","         # V2 signatures bind the Content-Type (empty) and Content-MD5 headers. GCS leaves headers","         # other than x-goog-* out of V2 signatures, so the client sends Cache-Control unsigned.","         args = {","           content_md5: checksum,","           expires: expires_in,","-          headers: custom_metadata_headers(custom_metadata),","+          headers: { \"x-goog-content-length-range\" => content_length_range(content_length), **custom_metadata_headers(custom_metadata) },","           method: \"PUT\",","           version: :v2,","         }","@@ -114,10 +114,10 @@ def url_for_direct_upload(key, expires_in:, checksum:, custom_metadata: {}, **)","       end","     end"," ","-    def headers_for_direct_upload(key, checksum:, filename: nil, disposition: nil, custom_metadata: {}, **)","+    def headers_for_direct_upload(key, checksum:, content_length:, filename: nil, disposition: nil, custom_metadata: {}, **)","       content_disposition = content_disposition_with(type: disposition, filename: filename) if filename"," ","-      headers = { \"Content-MD5\" => checksum, \"Content-Disposition\" => content_disposition, **custom_metadata_headers(custom_metadata) }","+      headers = { \"Content-MD5\" => checksum, \"Content-Disposition\" => content_disposition, \"x-goog-content-length-range\" => content_length_range(content_length), **custom_metadata_headers(custom_metadata) }","       if @config[:cache_control].present?","         headers[\"Cache-Control\"] = @config[:cache_control]","       end","@@ -217,5 +217,9 @@ def signer","       def custom_metadata_headers(metadata)","         metadata.transform_keys { |key| \"x-goog-meta-#{key}\" }","       end","+","+      def content_length_range(content_length)","+        \"#{content_length},#{content_length}\"","+      end","   end"," end"],"additions":8,"deletions":4,"truncated":false},{"path":"activestorage/test/controllers/direct_uploads_controller_test.rb","lines":["@@ -84,7 +84,7 @@ class ActiveStorage::GCSDirectUploadsControllerTest < ActionDispatch::Integratio","         assert_equal metadata, details[\"metadata\"]","         assert_equal \"text/plain\", details[\"content_type\"]","         assert_match %r{storage\\.googleapis\\.com/#{@config[:bucket]}}, details[\"direct_upload\"][\"url\"]","-        assert_equal({ \"Content-MD5\" => checksum, \"Content-Disposition\" => \"inline; filename=\\\"hello.txt\\\"; filename*=UTF-8''hello.txt\", \"x-goog-meta-my_key_3\" => \"my_value_3\" }, details[\"direct_upload\"][\"headers\"])","+        assert_equal({ \"Content-MD5\" => checksum, \"Content-Disposition\" => \"inline; filename=\\\"hello.txt\\\"; filename*=UTF-8''hello.txt\", \"x-goog-content-length-range\" => \"6,6\", \"x-goog-meta-my_key_3\" => \"my_value_3\" }, details[\"direct_upload\"][\"headers\"])","       end","     end","   end"],"additions":1,"deletions":1,"truncated":false},{"path":"activestorage/test/service/gcs_public_service_test.rb","lines":["@@ -29,6 +29,7 @@ class ActiveStorage::Service::GCSPublicServiceTest < ActiveSupport::TestCase","       request.body = data","       request.add_field \"Content-Type\", \"\"","       request.add_field \"Content-MD5\", checksum","+      request.add_field \"x-goog-content-length-range\", \"#{data.size},#{data.size}\"","       Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|","         http.request request","       end"],"additions":1,"deletions":0,"truncated":false},{"path":"activestorage/test/service/gcs_service_test.rb","lines":["@@ -24,6 +24,7 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","       request.body = data","       request.add_field \"Content-Type\", \"\"","       request.add_field \"Content-MD5\", checksum","+      request.add_field \"x-goog-content-length-range\", \"#{data.size},#{data.size}\"","       Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|","         http.request request","       end","@@ -33,6 +34,31 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","       @service.delete key","     end"," ","+    test \"directly uploading file larger than the provided content-length does not work\" do","+      key      = SecureRandom.base58(24)","+      data     = \"Some text that is longer than the specified content length\"","+      checksum = OpenSSL::Digest::MD5.base64digest(data)","+      url      = @service.url_for_direct_upload(key, expires_in: 5.minutes, content_type: \"text/plain\", content_length: data.size - 1, checksum: checksum)","+","+      uri = URI.parse url","+      request = Net::HTTP::Put.new uri.request_uri","+      request.body = data","+      @service.headers_for_direct_upload(key, checksum: checksum, content_length: data.size - 1).each do |k, v|","+        request.add_field k, v","+      end","+      request.add_field \"Content-Type\", \"\"","+      upload_result = Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|","+        http.request request","+      end","+","+      assert_equal \"400\", upload_result.code","+      assert_raises ActiveStorage::FileNotFoundError do","+        @service.download(key)","+      end","+    ensure","+      @service.delete key","+    end","+","     test \"direct upload with content disposition\" do","       key      = SecureRandom.base58(24)","       data     = \"Something else entirely!\"","@@ -42,7 +68,7 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","       uri = URI.parse url","       request = Net::HTTP::Put.new uri.request_uri","       request.body = data","-      @service.headers_for_direct_upload(key, checksum: checksum, filename: ActiveStorage::Filename.new(\"test.txt\"), disposition: :attachment).each do |k, v|","+      @service.headers_for_direct_upload(key, checksum: checksum, content_length: data.size, filename: ActiveStorage::Filename.new(\"test.txt\"), disposition: :attachment).each do |k, v|","         request.add_field k, v","       end","       request.add_field \"Content-Type\", \"\"","@@ -69,7 +95,7 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","       uri = URI.parse url","       request = Net::HTTP::Put.new uri.request_uri","       request.body = data","-      headers = service.headers_for_direct_upload(key, checksum: checksum, filename: ActiveStorage::Filename.new(\"test.txt\"), disposition: :attachment)","+      headers = service.headers_for_direct_upload(key, checksum: checksum, content_length: data.size, filename: ActiveStorage::Filename.new(\"test.txt\"), disposition: :attachment)","       assert_equal(\"public, max-age=1800\", headers[\"Cache-Control\"])"," ","       headers.each do |k, v|","@@ -99,7 +125,7 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","       uri = URI.parse url","       request = Net::HTTP::Put.new uri.request_uri","       request.body = data","-      service.headers_for_direct_upload(key, checksum: checksum, filename: ActiveStorage::Filename.new(\"test.png\"), content_type: \"image/png\").each do |k, v|","+      service.headers_for_direct_upload(key, checksum: checksum, content_length: data.size, filename: ActiveStorage::Filename.new(\"test.png\"), content_type: \"image/png\").each do |k, v|","         request.add_field k, v","       end","       request.add_field \"Content-Type\", \"text/html\"","@@ -207,6 +233,7 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","         request.body = data","         request.add_field(\"Content-Type\", \"\")","         request.add_field(\"Content-MD5\", checksum)","+        request.add_field(\"x-goog-content-length-range\", \"#{data.size},#{data.size}\")","         Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|","           http.request request","         end","@@ -251,28 +278,43 @@ class ActiveStorage::Service::GCSServiceDirectUploadSignatureTest < ActiveSuppor","   test \"direct upload with cache control authorizes only an empty Content-Type\" do","     url = @service.url_for_direct_upload(\"key\", expires_in: 5.minutes, content_type: \"text/plain\", content_length: 9, checksum: @checksum)"," ","-    assert authorizes?(url, content_type: \"\", checksum: @checksum)","-    assert_not authorizes?(url, content_type: \"text/html\", checksum: @checksum)","+    assert authorizes?(url, content_type: \"\", checksum: @checksum, content_length_range: \"9,9\")","+    assert_not authorizes?(url, content_type: \"text/html\", checksum: @checksum, content_length_range: \"9,9\")","   end"," ","   test \"direct upload with cache control authorizes only the declared checksum\" do","     url = @service.url_for_direct_upload(\"key\", expires_in: 5.minutes, content_type: \"text/plain\", content_length: 9, checksum: @checksum)"," ","-    assert authorizes?(url, content_type: \"\", checksum: @checksum)","-    assert_not authorizes?(url, content_type: \"\", checksum: OpenSSL::Digest::MD5.base64digest(\"Other text\"))","+    assert authorizes?(url, content_type: \"\", checksum: @checksum, content_length_range: \"9,9\")","+    assert_not authorizes?(url, content_type: \"\", checksum: OpenSSL::Digest::MD5.base64digest(\"Other text\"), content_length_range: \"9,9\")","+  end","+","+  test \"direct upload authorizes only the declared content length\" do","+    url = @service.url_for_direct_upload(\"key\", expires_in: 5.minutes, content_type: \"text/plain\", content_length: 9, checksum: @checksum)","+","+    assert authorizes?(url, content_type: \"\", checksum: @checksum, content_length_range: \"9,9\")","+    assert_not authorizes?(url, content_type: \"\", checksum: @checksum, content_length_range: \"0,1000\")","+    assert_not authorizes?(url, content_type: \"\", checksum: @checksum, content_length_range: nil)","   end"," ","   test \"direct upload headers with cache control include Cache-Control\" do","-    headers = @service.headers_for_direct_upload(\"key\", checksum: @checksum, filename: ActiveStorage::Filename.new(\"test.txt\"), content_type: \"text/plain\")","+    headers = @service.headers_for_direct_upload(\"key\", checksum: @checksum, content_length: 9, filename: ActiveStorage::Filename.new(\"test.txt\"), content_type: \"text/plain\")"," ","     assert_equal \"public, max-age=1800\", headers[\"Cache-Control\"]","   end"," ","+  test \"direct upload headers include the declared content length range\" do","+    headers = @service.headers_for_direct_upload(\"key\", checksum: @checksum, content_length: 9, filename: ActiveStorage::Filename.new(\"test.txt\"), content_type: \"text/plain\")","+","+    assert_equal \"9,9\", headers[\"x-goog-content-length-range\"]","+  end","+","   private","     # Rebuilds the string that GCS verifies a V2 signed PUT URL against.","-    def authorizes?(url, content_type:, checksum:)","+    def authorizes?(url, content_type:, checksum:, content_length_range:)","       query = Rack::Utils.parse_query(URI(url).query)","-      string_to_sign = [\"PUT\", checksum, content_type, query[\"Expires\"], \"/bucket/key\"].join(\"\\n\")","+      extension_headers = content_length_range ? \"x-goog-content-length-range:#{content_length_range}\\n\" : \"\"","+      string_to_sign = [\"PUT\", checksum, content_type, query[\"Expires\"], \"#{extension_headers}/bucket/key\"].join(\"\\n\")"," ","       @signing_key.public_key.verify(OpenSSL::Digest::SHA256.new, Base64.strict_decode64(query[\"Signature\"].to_s), string_to_sign)","     end"],"additions":52,"deletions":10,"truncated":false},{"path":"guides/source/active_storage_overview.md","lines":["@@ -1108,6 +1108,7 @@ Take care to allow:","   * `x-ms-blob-content-disposition` (for Azure Storage only)","   * `x-ms-blob-type` (for Azure Storage only)","   * `Cache-Control` (for GCS, only if `cache_control` is set)","+  * `x-goog-content-length-range` (for GCS)"," "," No CORS configuration is required for the Disk service since it shares your app’s origin."," ","@@ -1139,7 +1140,7 @@ No CORS configuration is required for the Disk service since it shares your app","   {","     \"origin\": [\"https://www.example.com\"],","     \"method\": [\"PUT\"],","-    \"responseHeader\": [\"Content-Type\", \"Content-MD5\", \"Content-Disposition\"],","+    \"responseHeader\": [\"Content-Type\", \"Content-MD5\", \"Content-Disposition\", \"x-goog-content-length-range\"],","     \"maxAgeSeconds\": 3600","   }"," ]",""],"additions":2,"deletions":1,"truncated":false}],"additions":76,"deletions":16,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-11T15:37:40.636932+00:00"}