 $parent['term_id'] ) );","+","+\t\t$this->assertNotWPError( $child, 'The child term could not be inserted.' );","+\t\t$this->assertLessThanOrEqual( 200, strlen( get_term( $child['term_id'] )->slug ) );","+\t}","+","+\t/**","+\t * @ticket 46010","+\t */","+\tpublic function test_terms_with_long_colliding_slugs_should_remain_unique() {","+\t\t$taxonomy = 'wptests_tax';","+\t\tregister_taxonomy( $taxonomy, 'post' );","+","+\t\t// 22 characters percent-encode to exactly 198 bytes, so every name below shares a slug.","+\t\t$prefix = str_repeat( 'あ', 22 );","+","+\t\t$slugs = array();","+\t\tfor ( $i = 1; $i <= 12; $i++ ) {","+\t\t\t$term = wp_insert_term( $prefix . ' ' . str_repeat( 'か', $i ), $taxonomy );","+","+\t\t\t$this->assertNotWPError( $term, \"Term $i could not be inserted.\" );","+","+\t\t\t$slug = get_term( $term['term_id'] )->slug;","+\t\t\t$this->assertLessThanOrEqual( 200, strlen( $slug ), \"Term $i has an overlong slug.\" );","+","+\t\t\t$slugs[] = $slug;","+\t\t}","+","+\t\t$this->assertSame( $slugs, array_unique( $slugs ), 'Duplicate slugs were created.' );","+\t}","+"," \t/** Helpers */"," "," \tpublic function deleted_term_cb( $term, $tt_id, $taxonomy, $deleted_term, $object_ids ) {"],"additions":47,"deletions":0,"truncated":false},{"path":"tests/phpunit/tests/term/wpUniqueTermSlug.php","lines":["@@ -172,4 +172,111 @@ public function test_duplicate_parent_suffixed_slug_should_get_numeric_suffix()"," "," \t\t$this->assertSame( 'dog-animal-2', $slug );"," \t}","+","+\t/**","+\t * The `slug` column in the terms table holds 200 characters.","+\t *","+\t * @ticket 46010","+\t */","+\tpublic function test_parent_suffixed_slug_should_be_truncated_to_the_column_length() {","+\t\t// This name percent-encodes to a 116 character slug, so appending it to itself overflows.","+\t\t$name = 'Категория на продукта';","+\t\t$slug = sanitize_title( $name );","+","+\t\t$parent = self::factory()->term->create(","+\t\t\tarray(","+\t\t\t\t'taxonomy' => 'wptests_tax2',","+\t