tance(Service.class));","+        assertInstanceOf(NamedService.class, injector.getInstance(Key.of(Service.class, NAMED_QUALIFIER)));","+    }","+","+    @Test","+    void emptyNamedProviderWinsOverNamedProvider() {","+        InjectorImpl injector = namedFirst(Injector.create().bindImplicit(EmptyAndNamed.class));","+","+        assertInstanceOf(DefaultService.class, injector.getInstance(Service.class));","+    }","+","+    @Test","+    void defaultClassWinsOverNamedClass() {","+        InjectorImpl injector =","+                namedFirst(Injector.create().bindImplicit(DefaultService.class).bindImplicit(NamedService.class));","+","+        assertInstanceOf(DefaultService.class, injector.getInstance(Service.class));","+    }","+","+    @Test","+    void anInjectFactoryPreservesTheClassQualifier() {","+        InjectorImpl injector = namedFirst(","+                Injector.create().bindImplicit(DefaultService.class).bindImplicit(NamedFactoryService.class));","+","+        assertInstanceOf(DefaultService.class, injector.getInstance(Service.class));","+        Map<String, Service> services = injector.getInstance(new Key<Map<String, Service>>() {});","+        assertInstanceOf(NamedFactoryService.class, services.get(NAMED_QUALIFIER));","+    }","+","+    @Test","+    void repeatedImplicitRegistrationDoesNotCreateAnotherProvider() {","+        Injector injector =","+                Injector.create().bindImplicit(DefaultAndNamed.class).bindImplicit(DefaultAndNamed.class);","+","+        assertInstanceOf(DefaultService.class, injector.getInstance(Service.class));","+        assertEquals(2, injector.getInstance(new Key<List<Service>>() {}).size());","+    }","+","+    @Test","+    void inheritedStaticProvidersAreRegisteredOnce() {","+        Injector injector = Injector.create().bindImplicit(ParentProvider.class).bindImplicit(ChildProvider.class);","+","+        assertEquals(\"parent\", injector.getInstance(String.class));","+        assertEquals(List.of(\"parent\"), injector.getInstance(new Key<List<String>>() {}));","+    }","+","+    @Test","+    void rebindingTheSameInstanceDoesNotDuplicateItsProviders() {","+        InstanceProvider provider = new InstanceProvider();","+        Injector injector = Injector.create()","+                .bindInstance(InstanceProvider.class, provider)","+                .bindInstance(InstanceProvider.class, provider);","+","+        assertEquals(\"instance\", injector.getInstance(String.class));","+        assertEquals(provider, injector.getInstance(InstanceProvider.class));","+        assertEquals(List.of(\"instance\"), injector.getInstance(new Key<List<String>>() {}));","+    }","+","+    @Test","+    void rebindingTheSameSupplierDoesNotDuplicateItsProviders() {","+        Supplier<InstanceProvider> supplier = InstanceProvider::new;","+        Injector injector = Injector.create()","+                .bindSupplier(InstanceProvider.class, supplier)","+                .bindSupplier(InstanceProvider.class, supplier);","+","+        assertEquals(\"instance\", injector.getInstance(String.class));","+        assertEquals(List.of(\"instance\"), injector.getInstance(new Key<List<String>>() {}));","+    }","+","+    @Test","+    void differentProgrammaticFactoriesRemainAmbiguous() {","+        InjectorImpl injector = new InjectorImpl();","+        Key<Service> key = Key.of(Service.class);","+        injector.bind(key, Binding.to(key, args -> new DefaultService(), new Dependency<?>[0]));","+        injector.bind(key, Binding.to(key, args -> new EmptyNamedService(), new Dependency<?>[0]));","+","+        assertThrows(DIException.class, () -> injector.getInstance(Service.class));","+    }","+","+    @Test","+    void registeringTheSameProgrammaticBindingTwiceDoesNotDuplicateIt() {","+        InjectorImpl injector = new InjectorImpl();","+        Key<Service> key = Key.of(Service.class);","+        Binding<Service> binding = Binding.to(key, args -> new DefaultService(), new Dependency<?>[0]);","+        injector.bind(key, binding);","+        injector.bind(key, binding);","+","+        assertInstanceOf(DefaultService.class, injector.getInstance(Service.class));","+        assertEquals(1, injector.getInstance(new Key<List<Service>>() {}).size());","+    }","+","+    @Test","+    void differentCustomInitializersRemainDistinct() throws NoSuchMethodException {","+        InjectorImpl injector = new InjectorImpl();","+        Key<InitializedService> key = Key.of(InitializedService.class);","+        Binding<InitializedService> base =","+                ReflectionUtils.bindingFromConstructor(key, InitializedService.class.getDeclaredConstructor());","+        injector.bind(key, base.initializeWith(tagInitializer(\"first\")));","+        injector.bind(key, base.initializeWith(tagInitializer(\"second\")));","+","+        List<InitializedService> services = injector.getInstance(new Key<List<InitializedService>>() {});","+        assertEquals(","+                Set.of(\"first\", \"second\"), services.stream().map(s -> s.tag).collect(toSet()));","+        assertThrows(DIException.class, () -> injector.getInstance(InitializedService.class));","+    }","+","+    @Test","+    void aCustomInitializerIsDistinctFromItsRawBinding() throws NoSuchMethodException {","+        InjectorImpl injector = new InjectorImpl();","+        Key<InitializedService> key = Key.of(InitializedService.class);","+        Binding<InitializedService> base =","+                ReflectionUtils.bindingFromConstructor(key, InitializedService.class.getDeclaredConstructor());","+        injector.bind(key, base);","+        injector.bind(key, base.initializeWith(tagInitializer(\"custom\")));","+","+        List<InitializedService> services = injector.getInstance(new Key<List<InitializedService>>() {});","+        assertEquals(Set.of(\"raw\", \"custom\"), services.stream().map(s -> s.tag).collect(toSet()));","+        assertThrows(DIException.class, () -> injector.getInstance(InitializedService.class));","+    }","+","+    @Test","+    void generatedInjectionIsDistinctFromTheRawConstructor() throws NoSuchMethodException {","+        InjectorImpl injector = new InjectorImpl();","+        injector.bindInstance(String.class, \"injected\");","+        Key<InitializedService> key = Key.of(InitializedService.class);","+        Binding<InitializedService> rawBinding =","+                ReflectionUtils.bindingFromConstructor(key, InitializedService.class.getDeclaredConstructor());","+        Binding<InitializedService> initializedBinding = ReflectionUtils.generateImplicitBinding(key);","+        injector.bind(key, rawBinding);","+        injector.bind(key, initializedBinding);","+","+        List<InitializedService> services = injector.getInstance(new Key<List<InitializedService>>() {});","+        assertEquals(","+                Set.of(\"raw\", \"injected\"), services.stream().map(s -> s.tag).collect(toSet()));","+        DIException exception = assertThrows(DIException.class, () -> injector.getInstance(InitializedService.class));","+        assertNotEquals(rawBinding.toString(), initializedBinding.toString());","+        assertTrue(exception.getMessage().contains(initializedBinding.toString()), exception.getMessage());","+    }","+","+    private static BindingInitializer<InitializedService> tagInitializer(String tag) {","+        return new BindingInitializer<>(Set.of()) {","+            @Override","+            public Consumer<InitializedService> compile(Function<Dependency<?>, Supplier<?>> compiler) {","+                return service -> service.tag = tag;","+            }","+        };","+    }","+","+    @Test","+    void ambiguityDiagnosticsDoNotInvokeInstanceToString() {","+        Injector injector = Injector.create()","+                .bindInstance(Service.class, new ExplosiveService())","+                .bindInstance(Service.class, new DefaultService());","+","+        DIException exception = assertThrows(DIException.class, () -> injector.getInstance(Service.class));","+   