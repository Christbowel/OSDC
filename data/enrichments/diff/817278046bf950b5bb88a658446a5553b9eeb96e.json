{"id":"817278046bf950b5bb88a658446a5553b9eeb96e","axis":"silent","repo":"envoyproxy/envoy","sha":"817278046bf950b5bb88a658446a5553b9eeb96e","parsed":{"files":[{"path":"changelogs/current/minor_behavior_changes/config__replay-cached-xds-resources.rst","lines":["@@ -0,0 +1,8 @@","+When a new SDS watch is added for a secret name that another watch on the same delta gRPC mux","+(or SotW gRPC mux with ``envoy.reloadable_features.unified_mux`` enabled) already subscribes to,","+and the new watch has not received any update yet, Envoy now delivers the last received version of","+that secret to the new watch instead of waiting for the management server to send it again.","+Previously the new watch received nothing until its ``initial_fetch_timeout`` expired or the server","+pushed a new version, for example after a listener or cluster update that only changed an","+``sds_config``. Other resource types are not cached. This behavior can be temporarily reverted by","+setting the runtime flag ``envoy.reloadable_features.xds_replay_cached_resources`` to ``false``."],"additions":8,"deletions":0,"truncated":false},{"path":"envoy/config/subscription.h","lines":["@@ -73,6 +73,15 @@ class DecodedResource {","    * @return optional ref<envoy::config::core::v3::Metadata> of a resource.","    */","   virtual const OptRef<const envoy::config::core::v3::Metadata> metadata() const PURE;","+","+  /**","+   * @return bool true if the resource was replayed from the xDS client's local cache to a watch","+   *         that joined an already-subscribed name, rather than received from the management","+   *         server. A replay is delivered on its own, never mixed with a server response. A","+   *         rejected replay is not NACKed, so the subscription keeps its initial fetch timeout","+   *         running until a replay is accepted.","+   */","+  virtual bool fromCache() const PURE;"," };"," "," using DecodedResourcePtr = std::unique_ptr<DecodedResource>;"],"additions":9,"deletions":0,"truncated":false},{"path":"source/common/config/decoded_resource_impl.h","lines":["@@ -67,9 +67,9 @@ class DecodedResourceImpl : public DecodedResource {","                             true, inline_entry.version(), std::nullopt, std::nullopt, arena) {}","   DecodedResourceImpl(Protobuf::Arena::UniquePtr<Protobuf::Message> resource,","                       const std::string& name, const std::vector<std::string>& aliases,","-                      const std::string& version)","+                      const std::string& version, bool from_cache = false)","       : resource_(std::move(resource)), has_resource_(true), name_(name), aliases_(aliases),","-        version_(version), ttl_(std::nullopt), metadata_(std::nullopt) {}","+        version_(version), ttl_(std::nullopt), metadata_(std::nullopt), from_cache_(from_cache) {}"," ","   // Config::DecodedResource","   const std::string& name() const override { return name_; }","@@ -81,6 +81,7 @@ class DecodedResourceImpl : public DecodedResource {","   const OptRef<const envoy::config::core::v3::Metadata> metadata() const override {","     return metadata_.has_value() ? makeOptRef(metadata_.value()) : std::nullopt;","   }","+  bool fromCache() const override { return from_cache_; }"," "," private:","   DecodedResourceImpl(OpaqueResourceDecoder& resource_decoder, std::optional<std::string> name,","@@ -105,6 +106,7 @@ class DecodedResourceImpl : public DecodedResource {","   // This is the metadata info under the Resource wrapper.","   // It is intended to be consumed in the xds_config_tracker extension.","   const std::optional<envoy::config::core::v3::Metadata> metadata_;","+  const bool from_cache_{false};"," };"," "," struct DecodedResourcesWrapper {"],"additions":4,"deletions":2,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -228,6 +228,10 @@ RUNTIME_GUARD(envoy_reloadable_features_use_stats_prefix_scope_for_http_filter);"," RUNTIME_GUARD(envoy_reloadable_features_vhds_answered_alias_cache);"," RUNTIME_GUARD(envoy_reloadable_features_vhds_overrides_rds_virtual_hosts_with_same_name);"," RUNTIME_GUARD(envoy_reloadable_features_xds_failover_to_primary_enabled);","+// When a never-notified SDS watch is added for a secret name that another watch on the same mux","+// already subscribes to, replay the last delivered secret to the new watch instead of waiting for","+// the server to resend it.","+RUNTIME_GUARD(envoy_reloadable_features_xds_replay_cached_resources);"," // This is only needed if sharing c-ares query cache across dns clusters."," // Disabled by default for now to prevent behavior changes."," FALSE_RUNTIME_GUARD(envoy_restart_features_shared_cares_dns_resolver);"],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/config_subscription/grpc/BUILD","lines":["@@ -217,15 +217,19 @@ envoy_cc_library(","         \"//envoy/config:custom_config_validators_interface\",","         \"//envoy/config:subscription_interface\",","         \"//envoy/config:xds_config_tracker_interface\",","+        \"//envoy/event:dispatcher_interface\",","         \"//source/common/common:assert_lib\",","         \"//source/common/common:cleanup_lib\",","         \"//source/common/common:minimal_logger_lib\",","+        \"//source/common/common:thread_lib\",","         \"//source/common/common:utility_lib\",","         \"//source/common/config:decoded_resource_lib\",","         \"//source/common/config:resource_name_lib\",","         \"//source/common/config:utility_lib\",","         \"//source/common/config:xds_resource_lib\",","         \"//source/common/protobuf\",","+        \"//source/common/runtime:runtime_features_lib\",","+        \"@envoy_api//envoy/extensions/transport_sockets/tls/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/service/discovery/v3:pkg_cc_proto\",","     ],"," )"],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/config_subscription/grpc/grpc_subscription_impl.cc","lines":["@@ -17,6 +17,18 @@ namespace Config {"," "," constexpr std::chrono::milliseconds UpdateDurationLogThreshold = std::chrono::milliseconds(50);"," ","+namespace {","+","+// A replay of cached resources is delivered on its own, never mixed with a server response.","+bool replayedFromCache(const std::vector<Config::DecodedResourceRef>& resources) {","+  if (resources.empty()) {","+    return false;","+  }","+  return resources.front().get().fromCache();","+}","+","+} // namespace","+"," GrpcSubscriptionImpl::GrpcSubscriptionImpl(GrpcMuxSharedPtr grpc_mux,","                                            SubscriptionCallbacks& callbacks,","                                            OpaqueResourceDecoderSharedPtr resource_decoder,","@@ -95,7 +107,13 @@ void GrpcSubscriptionImpl::accept(const absl::flat_hash_set<std::string>& patter"," absl::Status"," GrpcSubscriptionImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& resources,","                                      const std::string& version_info) {","-  disableInitFetchTimeoutTimer();","+  // A rejected server response is NACKed and stops the timer in onConfigUpdateFailed(), but a","+  // rejected replay is not, and the server will not resend an unchanged resource. Keep the","+  // initial fetch timeout running until a replayed update is accepted.","+  const bool from_cache = replayedFromCache(resources);","+  if (!from_cache) {","+    disableInitFetchTimeoutTimer();","+  }","   // TODO(mattklein123): In the future if we start tracking per-resource versions, we need to","   // supply those versions to onConfigUpdate() along with the xDS response (\"system\")","   // version_info. This way, both types of versions can be tracked and exposed for debugging by","@@ -105,6 +123,9 @@ GrpcSubscriptionImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRe","   if (!status.ok()) {","     return status;","   }","+  if (from_cache) {","+    disableInitFetchTimeoutTimer();","+  }","   std::chrono::milliseconds update_duration = std::chrono::duration_cast<std::chrono::milliseconds>(","       dispatcher_.timeSource().monotonicTime() - start);","   stats_.update_success_.inc();","@@ -127,7 +148,11 @@ absl::Status GrpcSubscriptionImpl::onConfigUpdate(","     const std::vector<Config::DecodedResourceRef>& added_resources,","     const Protobuf::RepeatedPtrField<std::string>& removed_resources,","     const std::string& system_version_info) {","-  disableInitFetchTimeoutTimer();","+  // See the state-of-the-world overload above.","+  const bool from_cache = replayedFromCache(added_resources);","+  if (!from_cache) {","+    disableInitFetchTimeoutTimer();","+  }","   stats_.update_attempt_.inc();","   auto start = dispatcher_.timeSource().monotonicTime();","   absl::Status status =","@@ -135,6 +160,9 @@ absl::Status GrpcSubscriptionImpl::onConfigUpdate(","   if (!status.ok()) {","     return status;","   }","+  if (from_cache) {","+    disableInitFetchTimeoutTimer();","+  }","   std::chrono::milliseconds update_duration = std::chrono::duration_cast<std::chrono::milliseconds>(","       dispatcher_.timeSource().monotonicTime() - start);","   stats_.update_success_.inc();"],"additions":30,"deletions":2,"truncated":false},{"path":"source/extensions/config_subscription/grpc/new_grpc_mux_impl.h","lines":["@@ -107,7 +107,8 @@ class NewGrpcMuxImpl","                       CustomConfigValidators* config_validators,","                       XdsConfigTrackerOptRef xds_config_tracker,","                       EdsResourcesCacheOptRef eds_resources_cache)","-        : watch_map_(type_url, config_validators, eds_resources_cache),","+        : watch_map_(type_url, config_validators, eds_resources_cache, dispatcher,","+                     /*is_delta=*/true),","           sub_state_(type_url, watch_map_, dispatcher, xds_config_tracker) {","       // If eds resources cache is provided, then the type must be ClusterLoadAssignment.","       ASSERT("],"additions":2,"deletions":1,"truncated":false},{"path":"source/extensions/config_subscription/grpc/watch_map.cc","lines":["@@ -1,12 +1,15 @@"," #include \"source/extensions/config_subscription/grpc/watch_map.h\""," ","+#include \"envoy/extensions/transport_sockets/tls/v3/secret.pb.h\""," #include \"envoy/service/discovery/v3/discovery.pb.h\""," "," #include \"source/common/common/cleanup.h\"","+#include \"source/common/common/thread.h\""," #include \"source/common/common/utility.h\""," #include \"source/common/config/decoded_resource_impl.h\""," #include \"source/common/config/utility.h\""," #include \"source/common/config/xds_resource.h\"","+#include \"source/common/runtime/runtime_features.h\""," "," namespace Envoy {"," namespace Config {","@@ -33,6 +36,9 @@ Watch* WatchMap::addWatch(SubscriptionCallbacks& callbacks,"," void WatchMap::forgetWatch(Watch* watch) {","   wildcard_watches_.erase(watch); // may or may not be in there, but we want it gone.","   forgetAccept(watch);","+  // Drop the queued replay so the pointer is not kept after the watch is freed below; a new","+  // watch allocated at the same address must not inherit it.","+  pending_replays_.erase(watch);","   watches_.erase(watch);"," }"," ","@@ -291,14 +297,27 @@ void WatchMap::onConfigUpdate(const std::vector<DecodedResourcePtr>& resources,","       // 3) Otherwise, we can skip onConfigUpdate for this watch.","       if (map_is_single_wildcard || !watch->state_of_the_world_empty_) {","         watch->state_of_the_world_empty_ = true;","+        watch->notified_ = true;","         THROW_IF_NOT_OK(watch->callbacks_.onConfigUpdate({}, version_info));","       }","     } else {","       watch->state_of_the_world_empty_ = false;","+      watch->notified_ = true;","       THROW_IF_NOT_OK(watch->callbacks_.onConfigUpdate(this_watch_updates->second, version_info));","     }","   }"," ","+  // A name absent from a state-of-the-world response is not evicted: for explicitly named","+  // types (EDS, RDS, ...) the server may legitimately send a subset, and the watches that","+  // already hold the resource keep it too. The cache follows what those watches hold.","+  if (replay_enabled_) {","+    for (uint32_t resource_idx = 0; resource_idx < resources.size(); ++resource_idx) {","+      if (interesting_resources[resource_idx]) {","+        cacheResource(*resources[resource_idx], version_info);","+      }","+    }","+  }","+","   if (eds_resources_cache_.has_value()) {","     // Add/update the watched resources to/in the cache.","     // Only resources that have a watcher should be updated.","@@ -385,6 +404,7 @@ void WatchMap::onConfigUpdate(","     if (deferred_removed_during_update_->count(cur_watch) > 0) {","       continue;","     }","+    cur_watch->notified_ = true;","     const auto removed = per_watch_removed.find(cur_watch);","     if (removed == per_watch_removed.end()) {","       // additions only, no removals","@@ -403,16 +423,27 @@ void WatchMap::onConfigUpdate(","     if (deferred_removed_during_update_->count(cur_watch) > 0) {","       continue;","     }","+    cur_watch->notified_ = true;","     THROW_IF_NOT_OK(","         cur_watch->callbacks_.onConfigUpdate({}, resource_to_remove, system_version_info));","   }","   // notify empty update","   if (added_resources.empty() && removed_resources.empty()) {","     for (auto& cur_watch : wildcard_watches_) {","+      cur_watch->notified_ = true;","       THROW_IF_NOT_OK(cur_watch->callbacks_.onConfigUpdate({}, {}, system_version_info));","     }","   }"," ","+  if (replay_enabled_) {","+    for (const auto& resource : decoded_resources) {","+      cacheResource(*resource, resource->version());","+    }","+    for (const auto& name : removed_resources) {","+      cached_resources_.erase(name);","+    }","+  }","+","   if (eds_resources_cache_.has_value()) {","     // Add/update the watched resources to/in the cache.","     for (const auto& resource : decoded_resources) {","@@ -443,8 +474,10 @@ WatchMap::findAdditions(const absl::flat_hash_set<std::string>& newly_added_to_w","       newly_added_to_subscription.insert(name);","       watch_interest_[name] = {watch};","     } else {","-      // Add this watch to the already-existing set at watch_interest_[name]","+      // Add this watch to the already-existing set at watch_interest_[name]. The name is already","+      // subscribed, so the server will not send the resource again for this watch.","       entry->second.insert(watch);","+      queueReplay(watch, name);","     }","   }","   return newly_added_to_subscription;","@@ -463,11 +496,111 @@ WatchMap::findRemovals(const absl::flat_hash_set<std::string>& newly_removed_fro","     entry->second.erase(watch);","     if (entry->second.empty()) {","       watch_interest_.erase(entry);","+      cached_resources_.erase(name);","       newly_removed_from_subscription.insert(name);","     }","   }","+  // A watch that dropped a name before its replay ran must not receive it.","+  if (auto pending = pending_replays_.find(watch); pending != pending_replays_.end()) {","+    for (const auto& name : newly_removed_from_watch) {","+      pending->second.erase(name);","+    }","+    if (pending->second.empty()) {","+      pending_replays_.erase(pending);","+    }","+  }","   return newly_removed_from_subscription;"," }"," ","+const std::string& WatchMap::secretTypeUrl() {","+  CONSTRUCT_ON_FIRST_USE(std::string,","+                         getTypeUrl<envoy::extensions::transport_sockets::tls::v3::Secret>());","+}","+","+void WatchMap::cacheResource(const DecodedResource& resource, const std::string& version) {","+  // Only explicitly named interest is cached: a resource routed through a wildcard or glob","+  // watch has no per-name reference count, and a wildcard subscription is resent in full anyway.","+  if (!resource.hasResource() || !watch_interest_.contains(resource.name())) {","+    return;","+  }","+  // CopyFrom() is not available on MessageLite in lite proto builds. Merging into the freshly","+  // created empty message is equivalent.","+  Protobuf::Arena::UniquePtr<Protobuf::Message> copy =","+      Protobuf::Arena::UnsafeWrapUniquePtr(nullptr, resource.resource().New());","+  copy->CheckTypeAndMergeFrom(resource.resource());","+  cached_resources_.insert_or_assign(resource.name(),","+                                     CachedResource{std::move(copy), resource.aliases(), version});","+}","+","+void WatchMap::queueReplay(Watch* watch, const std::string& name) {","+  // A watch that has already been notified holds a state built from server responses; only a","+  // watch that has never heard anything is caught up from the cache.","+  if (!replay_enabled_ || watch->notified_ || !cached_resources_.contains(name) ||","+      !Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.xds_replay_cached_resources\")) {","+    return;","+  }","+  pending_replays_[watch].insert(name);","+  replay_cb_->scheduleCallbackNextIteration();","+}","+","+void WatchMap::replayCachedResources() {","+  // Take the queue first: a delivery may add or remove watches, and must not disturb this pass.","+  auto pending = std::move(pending_replays_);","+  pending_replays_.clear();","+  for (auto& [watch, names] : pending) {","+    // The watch may have been removed since the replay was queued, or a server response may","+    // have reached it first, in which case the response wins.","+    if (!watches_.contains(watch) || watch->notified_) {","+      continue;","+    }","+    std::vector<DecodedResourcePtr> decoded;","+    std::vector<DecodedResourceRef> refs;","+    std::string version;","+    for (const auto& name : names) {","+      // The entry may be gone if a delta removal followed the join, e.g. a watch added from","+      // inside the removal's own callbacks, which are not told about the removal. The interest","+      // check is defensive: findRemovals() already drops a name the watch stopped watching.","+      auto cached = cached_resources_.find(name);","+      if (cached == cached_resources_.end() || !watch->resource_names_.contains(name)) {","+        continue;","+      }","+      // Merge into an empty message rather than CopyFrom(); see cacheResource().","+      Protobuf::Arena::UniquePtr<Protobuf::Message> copy =","+          Protobuf::Arena::UnsafeWrapUniquePtr(nullptr, cached->second.resource_->New());","+      copy->CheckTypeAndMergeFrom(*cached->second.resource_);","+      decoded.push_back(std::make_unique<DecodedResourceImpl>(","+          std::move(copy), name, cached->second.aliases_, cached->second.version_,","+          /*from_cache=*/true));","+      refs.emplace_back(*decoded.back());","+      version = cached->second.version_;","+    }","+    if (refs.empty()) {","+      continue;","+    }","+    ENVOY_LOG(debug, \"Replaying {} cached {} resource(s) to a late watch\", refs.size(), type_url_);","+    // The resource was accepted when it arrived, and there is no response to NACK, so a failure","+    // here is only logged and the watch keeps waiting. The resources are marked fromCache(), so","+    // GrpcSubscriptionImpl keeps its initial fetch timeout running until a replay is accepted.","+    watch->notified_ = true;","+    TRY_ASSERT_MAIN_THREAD {","+      absl::Status status;","+      if (is_delta_) {","+        status = watch->callbacks_.onConfigUpdate(refs, {}, version);","+      } else {","+        // The watch now holds resources, so a later state-of-the-world update that drops them","+        // must be delivered to it (see the delivery loop in onConfigUpdate()).","+        watch->state_of_the_world_empty_ = false;","+        status = watch->callbacks_.onConfigUpdate(refs, version);","+      }","+      if (!status.ok()) {","+        ENVOY_LOG(warn, \"Replay of cached {} resources rejected: {}\", type_url_, status.message());","+      }","+    }","+    END_TRY","+    CATCH(const EnvoyException& e,","+          { ENVOY_LOG(warn, \"Replay of cached {} resources failed: {}\", type_url_, e.what()); });","+  }","+}","+"," } // namespace Config"," } // namespace Envoy"],"additions":134,"deletions":1,"truncated":false},{"path":"source/extensions/config_subscription/grpc/watch_map.h","lines":["@@ -7,6 +7,7 @@"," #include \"envoy/config/custom_config_validators.h\""," #include \"envoy/config/eds_resources_cache.h\""," #include \"envoy/config/subscription.h\"","+#include \"envoy/event/dispatcher.h\""," #include \"envoy/service/discovery/v3/discovery.pb.h\""," "," #include \"source/common/common/assert.h\"","@@ -36,6 +37,9 @@ struct Watch {","   // Whether the most recent update contained any resources this watch cares about.","   // If true, a new update that also contains no resources can skip this watch.","   bool state_of_the_world_empty_{true};","+  // Whether onConfigUpdate() has ever been called on this watch, by a server response or a","+  // replay. Only a watch that has never been notified receives a cached resource replay.","+  bool notified_{false};","   // Glob patterns this watch accepts via accept() (the \"*\" wildcard and/or","   // \"<prefix>/*\" suffix globs). These affect routing only and never the subscription; a watch that","   // holds any of them is never treated as a catch-all (empty-interest) wildcard watch. This is the","@@ -76,12 +80,24 @@ struct Watch {"," // The WatchMap is responsible to update the cache with the resource contents, and it is"," // up to the specific xDS type subscription handler (i.e., EdsClusterImpl), to fetch"," // the resource from the cache.","+//","+// For SDS only, the WatchMap also keeps the last resource delivered for every explicitly","+// watched name while at least one watch is interested in it. When a watch that has never been","+// notified joins a name that is already subscribed (so no new request is sent and the server","+// will not resend an unchanged resource), the cached resource is replayed to that watch on the","+// next dispatcher iteration through its regular onConfigUpdate(). Wildcard and glob interest is","+// never cached."," class WatchMap : public UntypedConfigUpdateCallbacks, public Logger::Loggable<Logger::Id::config> {"," public:","   WatchMap(const std::string& type_url, CustomConfigValidators* config_validators,","-           EdsResourcesCacheOptRef eds_resources_cache)","+           EdsResourcesCacheOptRef eds_resources_cache, Event::Dispatcher& dispatcher,","+           bool is_delta)","       : type_url_(type_url), config_validators_(config_validators),","-        eds_resources_cache_(eds_resources_cache) {","+        eds_resources_cache_(eds_resources_cache), is_delta_(is_delta),","+        replay_enabled_(type_url == secretTypeUrl()),","+        replay_cb_(replay_enabled_","+                       ? dispatcher.createSchedulableCallback([this] { replayCachedResources(); })","+                       : nullptr) {","     // If eds resources cache is provided, then the type must be ClusterLoadAssignment.","     ASSERT(!eds_resources_cache_.has_value() ||","            (type_url == Config::getTypeUrl<envoy::config::endpoint::v3::ClusterLoadAssignment>()));","@@ -151,7 +167,20 @@ class WatchMap : public UntypedConfigUpdateCallbacks, public Logger::Loggable<Lo","     config_validators_ = config_validators;","   }"," ","+  // For tests: whether a resource is currently cached for the given name.","+  bool hasCachedResourceForTest(const std::string& name) const {","+    return cached_resources_.contains(name);","+  }","+"," private:","+  // The last resource delivered for an explicitly watched name. The resource is an owned copy:","+  // decoded resources are allocated on a per-batch arena and do not outlive the dispatch.","+  struct CachedResource {","+    Protobuf::Arena::UniquePtr<Protobuf::Message> resource_;","+    std::vector<std::string> aliases_;","+    std::string version_;","+  };","+","   void removeDeferredWatches();"," ","   // Erases the watch from every routing structure (wildcard, glob, and named interest).","@@ -178,6 +207,15 @@ class WatchMap : public UntypedConfigUpdateCallbacks, public Logger::Loggable<Lo","   // Returns the union of watch_interest_[resource_name] and wildcard_watches_.","   absl::flat_hash_set<Watch*> watchesInterestedIn(const std::string& resource_name);"," ","+  static const std::string& secretTypeUrl();","+  // Stores a copy of the resource for later replay if its name is explicitly watched.","+  void cacheResource(const DecodedResource& resource, const std::string& version);","+  // Queues a replay of the cached resource for 'name', if any, to 'watch' if it has never been","+  // notified.","+  void queueReplay(Watch* watch, const std::string& name);","+  // Delivers queued replays. Runs from the dispatcher, never from inside an update.","+  void replayCachedResources();","+","   absl::flat_hash_set<std::unique_ptr<Watch>> watches_;"," ","   // Watches whose interest set is currently empty, which is interpreted as \"everything\".","@@ -201,9 +239,23 @@ class WatchMap : public UntypedConfigUpdateCallbacks, public Logger::Loggable<Lo","   // accept every resource named \"P/...\".","   absl::flat_hash_map<std::string, absl::flat_hash_set<Watch*>> accept_prefix_watches_;"," ","+  // Last delivered resource per explicitly watched name; an entry exists only while","+  // watch_interest_ has the name.","+  absl::flat_hash_map<std::string, CachedResource> cached_resources_;","+  // Watches that joined an already-subscribed, cached name and are waiting for the replay,","+  // with the names each one joined.","+  absl::flat_hash_map<Watch*, absl::flat_hash_set<std::string>> pending_replays_;","+","   const std::string type_url_;","   CustomConfigValidators* config_validators_;","   EdsResourcesCacheOptRef eds_resources_cache_;","+  // Whether the owning mux delivers through the delta form of onConfigUpdate(). A replay uses the","+  // same form, so a watch sees exactly what the mux would deliver.","+  const bool is_delta_;","+  // Cache and replay are limited to SDS for now.","+  const bool replay_enabled_;","+  // Only created when replay is enabl