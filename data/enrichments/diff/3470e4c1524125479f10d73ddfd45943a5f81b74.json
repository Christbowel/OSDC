{"id":"3470e4c1524125479f10d73ddfd45943a5f81b74","axis":"silent","repo":"mongodb/mongo","sha":"3470e4c1524125479f10d73ddfd45943a5f81b74","parsed":{"files":[{"path":"jstests/replsets/initial_sync_preserves_initiating_set_marker.js","lines":["@@ -0,0 +1,295 @@","+/**","+ * A node that completes logical initial sync from a sync source whose oplog has not truncated yet","+ * should retain the replica set's 'initiating set' oplog entry as the first entry of its own oplog.","+ *","+ * Change streams rely on that entry to prove that no history has fallen off a node's oplog (see","+ * initCursorAndAssertTsHasNotFallenOff() in collection_scan.cpp). If initial sync does not fetch the","+ * entry from the sync source, the syncing node's oplog begins after it, and a change stream that","+ * starts from before that point fails with ChangeStreamHistoryLost on the syncing node, even though","+ * its sync source could have served it.","+ *","+ * @tags: [requires_replication, multiversion_incompatible]","+ */","+import {configureFailPoint} from \"jstests/libs/fail_point_util.js\";","+import {describe, it} from \"jstests/libs/mochalite.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+","+describe(\"initial sync and the 'initiating set' oplog entry\", function () {","+    const dbName = \"test\";","+    const collName = \"resumability\";","+    const kInitiatingSetMsg = \"initiating set\";","+","+    // Log ids emitted by InitialSyncer::_handleOldestOplogEntryForInitiatingSetResponse().","+    const kRewindLogId = 12195600;","+    const kRewindSkippedTooOldLogId = 12195601;","+    const kRewindDisabledAfterFailureLogId = 12195603;","+","+    function firstOplogEntry(node) {","+        return node.getDB(\"local\").oplog.rs.find().sort({$natural: 1}).limit(1).toArray()[0];","+    }","+","+    // The repl.initialSync.initiatingSetRewind counters on 'node', with absent counters as 0.","+    function rewindMetrics(node) {","+        const metrics =","+            assert.commandWorked(node.adminCommand({serverStatus: 1})).metrics.repl.initialSync","+                .initiatingSetRewind ?? {};","+        return {","+            rewound: metrics.rewound ?? 0,","+            skippedTooOld: metrics.skippedTooOld ?? 0,","+            oldestEntryParseFailures: metrics.oldestEntryParseFailures ?? 0,","+            disabledAfterFailedAttempt: metrics.disabledAfterFailedAttempt ?? 0,","+        };","+    }","+","+    function isInitiatingSetEntry(entry) {","+        return entry.op === \"n\" && entry.o !== undefined && entry.o.msg === kInitiatingSetMsg;","+    }","+","+    /**","+     * Initiates a one-node replica set, writes past its 'initiating set' entry, then adds a","+     * priority 0, non-voting node and lets it initial sync. Returns what the test needs to know","+     * about the new node.","+     */","+    function addNodeToNewReplicaSet({","+        setParameter,","+        changeFcv = false,","+        delaySecs = 0,","+        failFirstBatchOnce = false,","+    }) {","+        const rst = new ReplSetTest({nodes: 1, nodeOptions: {setParameter}});","+        rst.startSet();","+        rst.initiate();","+","+        const primary = rst.getPrimary();","+        const primaryDB = primary.getDB(dbName);","+","+        // The replica set has just been initiated, so the primary's oplog starts at the marker.","+        const markerEntry = firstOplogEntry(primary);","+        assert(isInitiatingSetEntry(markerEntry), \"primary's oplog should start at the marker\", {","+            markerEntry,","+        });","+","+        // Advance the primary's oplog past the marker. Without these writes the marker would still","+        // be the top of the oplog when the new node picks its fetch start point.","+        assert.commandWorked(","+            primaryDB[collName].insert([{_id: 0}, {_id: 1}, {_id: 2}], {writeConcern: {w: 1}}),","+        );","+","+        if (changeFcv) {","+            // Put an FCV transition between the marker and where the new node begins applying.","+            // This is what addShard does: it runs setFCV against the new shard after","+            // replSetInitiate.","+            assert.commandWorked(","+                primary.adminCommand({setFeatureCompatibilityVersion: lastLTSFCV, confirm: true}),","+            );","+            assert.commandWorked(","+                primary.adminCommand({setFeatureCompatibilityVersion: latestFCV, confirm: true}),","+            );","+            assert.commandWorked(primaryDB[collName].insert({_id: 3}, {writeConcern: {w: 1}}));","+        }","+","+        if (delaySecs > 0) {","+            sleep(delaySecs * 1000);","+            assert.commandWorked(primaryDB[collName].insert({_id: 4}, {writeConcern: {w: 1}}));","+        }","+","+        const newNode = rst.add({rsConfig: {priority: 0, votes: 0}, setParameter});","+        if (failFirstBatchOnce) {","+            // Fail the first attempt right before it writes its first batch, which only holds","+            // entries at or before the beginApplyingTimestamp.","+            configureFailPoint(newNode, \"failInitialSyncBeforeApplyingBatch\", {}, {times: 1});","+        }","+        const hangBeforeFinish = configureFailPoint(newNode, \"initialSyncHangBeforeFinish\");","+        rst.reInitiate();","+        hangBeforeFinish.wait();","+        const statusRes = assert.commandWorked(newNode.adminCommand({replSetGetStatus: 1}));","+        const initialSyncStatus = statusRes.initialSyncStatus;","+        hangBeforeFinish.off();","+","+        rst.awaitSecondaryNodes(null, [newNode]);","+        rst.awaitReplication();","+","+        const newNodeFirstEntry = firstOplogEntry(newNode);","+        jsTest.log.info(\"New node finished initial sync\", {initialSyncStatus, newNodeFirstEntry});","+","+        // A resume point from before the replica set existed, as for a change stream that was","+        // already running when the shard that is now being asked to serve it was added.","+        newNode.setSecondaryOk();","+        const changeStreamRes = newNode.getDB(dbName).runCommand({","+            aggregate: collName,","+            pipeline: [","+                {","+                    $changeStream: {","+                        startAtOperationTime: Timestamp(markerEntry.ts.getTime() - 60, 1),","+                    },","+                },","+            ],","+            cursor: {},","+        });","+","+        return {","+            rst,","+            newNode,","+            markerEntry,","+            newNodeFirstEntry,","+            initialSyncStatus,","+            changeStreamRes,","+            metrics: rewindMetrics(newNode),","+        };","+    }","+","+    function assertRewound({newNode, markerEntry, newNodeFirstEntry, initialSyncStatus, metrics}) {","+        assert.docEq(","+            {","+                rewound: 1,","+                skippedTooOld: 0,","+                oldestEntryParseFailures: 0,","+                disabledAfterFailedAttempt: 0,","+            },","+            metrics,","+        );","+        assert(","+            isInitiatingSetEntry(newNodeFirstEntry),","+            \"new node's oplog should start at the marker\",","+            {","+                newNodeFirstEntry,","+            },","+        );","+        assert.eq(markerEntry.ts, newNodeFirstEntry.ts);","+        assert(checkLog.checkContainsOnceJson(newNode, kRewindLogId, {}));","+        assert.eq(","+            markerEntry.ts,","+            initialSyncStatus.initialSyncOplogFetchingStart,","+            \"initial sync should have started fetching at the marker\",","+            {initialSyncStatus},","+        );","+        // writtenNotAppliedOps should match exactly the oplog entries from the marker (where","+        // fetching started) through the beginApplyingTimestamp (where applying starts), both","+        // inclusive: the sync source's own oplog entries in that range plus the local 3 inserts.","+        const expectedWrittenNotAppliedOps = newNode.getDB(\"local\").oplog.rs.countDocuments({","+            ts: {$gte: markerEntry.ts, $lte: initialSyncStatus.initialSyncOplogStart},","+        });","+        assert.eq(","+            expectedWrittenNotAppliedOps,","+            initialSyncStatus.writtenNotAppliedOps,","+            \"expected writtenNotAppliedOps to match the oplog entries written without being \" +","+                \"applied\",","+            {initialSyncStatus, expectedWrittenNotAppliedOps},","+        );","+    }","+","+    it(\"fails to resume a change stream on the new node without the rewind\", function () {","+        const res = addNodeToNewReplicaSet({","+            setParameter: {initialSyncFetchFromInitiatingSetEntry: false},","+        });","+        assert(","+            !isInitiatingSetEntry(res.newNodeFirstEntry),","+            \"new node's oplog should not start at the marker\",","+            {","+                newNodeFirstEntry: res.newNodeFirstEntry,","+            },","+        );","+        assert.commandFailedWithCode(res.changeStreamRes, ErrorCodes.ChangeStreamHistoryLost);","+        assert.docEq(","+            {","+                rewound: 0,","+                skippedTooOld: 0,","+                oldestEntryParseFailures: 0,","+                disabledAfterFailedAttempt: 0,","+            },","+            res.metrics,","+        );","+        res.rst.stopSet();","+    });","+","+    it(\"keeps the marker on the new node so the change stream can resume\", function () {","+        const res = addNodeToNewReplicaSet({","+            setParameter: {initialSyncFetchFromInitiatingSetEntry: true},","+        });","+        assertRewound(res);","+        assert.commandWorked(res.changeStreamRes);","+        res.rst.stopSet();","+    });","+","+    it(\"writes an FCV change in the widened fetch range without applying it\", function () {","+        const res = addNodeToNewReplicaSet({","+            setParameter: {initialSyncFetchFromInitiatingSetEntry: true},","+            changeFcv: true,","+        });","+        assertRewound(res);","+        assert.commandWorked(res.changeStreamRes);","+","+        // The FCV entries must be in the new node's oplog. Had they been applied, initial sync would","+        // have failed.","+        const fcvEntries = res.newNode","+            .getDB(\"local\")","+            .oplog.rs.find({ns: \"admin.system.version\", ts: {$gt: res.markerEntry.ts}})","+            .itcount();","+        assert.gt(fcvEntries, 0, \"expected the FCV oplog entries in the new node's oplog\");","+        res.rst.stopSet();","+    });","+","+    it(\"stops rewinding after an attempt fails while writing the widened range\", function () {","+        const res = addNodeToNewReplicaSet({","+            setParameter: {initialSyncFetchFromInitiatingSetEntry: true, numInitialSyncAttempts: 2},","+            failFirstBatchOnce: true,","+        });","+        assert.eq(","+            1,","+            res.initialSyncStatus.failedInitialSyncAttempts,","+            \"expected one failed attempt\",","+            {","+                initialSyncStatus: res.initialSyncStatus,","+            },","+        );","+        assert(checkLog.checkContainsOnceJson(res.newNode, kRewindDisabledAfterFailureLogId, {}));","+        assert.docEq(","+            {","+                rewound: 1,","+                skippedTooOld: 0,","+                oldestEntryParseFailures: 0,","+                disabledAfterFailedAttempt: 1,","+            },","+            res.metrics,","+        );","+        assert.eq(1, checkLog.getFilteredLogMessages(res.newNode, kRewindLogId, {}).length);","+        assert(","+            !isInitiatingSetEntry(res.newNodeFirstEntry),","+            \"new node's oplog should not start at the marker\",","+            {","+                newNodeFirstEntry: res.newNodeFirstEntry,","+            },","+        );","+        assert.commandFailedWithCode(res.changeStreamRes, ErrorCodes.ChangeStreamHistoryLost);","+        res.rst.stopSet();","+    });","+","+    it(\"does not rewind when the marker is older than the configured bound\", function () {","+        const res = addNodeToNewReplicaSet({","+            setParameter: {","+                initialSyncFetchFromInitiatingSetEntry: true,","+                initialSyncFetchFromInitiatingSetEntryMaxSecs: 1,","+            },","+            delaySecs: 3,","+        });","+        assert(","+            !isInitiatingSetEntry(res.newNodeFirstEntry),","+            \"new node's oplog should not start at the marker\",","+            {","+                newNodeFirstEntry: res.newNodeFirstEntry,","+            },","+        );","+        assert(checkLog.checkContainsOnceJson(res.newNode, kRewindSkippedTooOldLogId, {}));","+        assert.docEq(","+            {","+                rewound: 0,","+                skippedTooOld: 1,","+                oldestEntryParseFailures: 0,","+                disabledAfterFailedAttempt: 0,","+            },","+            res.metrics,","+        );","+        assert.commandFailedWithCode(res.changeStreamRes, ErrorCodes.ChangeStreamHistoryLost);","+        res.rst.stopSet();","+    });","+});"],"additions":295,"deletions":0,"truncated":false},{"path":"jstests/replsets/initial_sync_replSetGetStatus.js","lines":["@@ -202,9 +202,16 @@ assert(","     () => \"Response should have an 'initialSyncStatus' field: \" + tojson(res),"," );"," ","-// It is possible that we update the config document after going through a reconfig. So make sure","-// we account for this.","-assert.gte(endOfCloningRes.initialSyncStatus.appliedOps, 3);","+// The two inserts above are applied. Fetching starts at the beginApplyingTimestamp entry, which is","+// written to the oplog but not applied; older binaries counted it in 'appliedOps' instead. It is","+// also possible that we update the config document after going through a reconfig, so these are","+// lower bounds.","+assert.gte(endOfCloningRes.initialSyncStatus.appliedOps, 2);","+assert.gte(","+    endOfCloningRes.initialSyncStatus.appliedOps +","+        (endOfCloningRes.initialSyncStatus.writtenNotAppliedOps ?? 0),","+    3,","+);"," "," // Assert metrics have progressed in the right direction since the last time we checked the metrics."," assert.gt("],"additions":10,"deletions":3,"truncated":false},{"path":"jstests/replsets/no_progress_updates_during_initial_sync.js","lines":["@@ -150,9 +150,15 @@ assert(","     statusAfterWMaj.initialSyncStatus,","     () => \"Response should have an 'initialSyncStatus' field: \" + tojson(statusAfterWMaj),"," );","-// We should have applied at least 6 documents, not 5, as fetching and applying are inclusive of the","-// sync source's lastApplied.","-assert.gte(statusAfterWMaj.initialSyncStatus.appliedOps, 6);","+// We should have applied at least the 5 documents inserted above. Fetching is inclusive of the sync","+// source's lastApplied, so at least 6 entries were fetched; the one at the beginApplyingTimestamp is","+// written to the oplog but not applied (older binaries counted it in 'appliedOps').","+assert.gte(statusAfterWMaj.initialSyncStatus.appliedOps, 5);","+assert.gte(","+    statusAfterWMaj.initialSyncStatus.appliedOps +","+        (statusAfterWMaj.initialSyncStatus.writtenNotAppliedOps ?? 0),","+    6,","+);"," "," // Turn off the last failpoint and wait for the node to finish initial sync."," assert.commandWorked("],"additions":9,"deletions":3,"truncated":false},{"path":"jstests/replsets/repl_metrics.js","lines":["@@ -66,7 +66,17 @@ const expectedReplSection = {","         \"ops\": 0,","     },","     \"heartBeat\": {\"handleQueueSize\": 0, \"maxSeenHandleQueueSize\": 0},","-    \"initialSync\": {\"completed\": 0, \"failedAttempts\": 0, \"failures\": 0},","+    \"initialSync\": {","+        \"completed\": 0,","+        \"failedAttempts\": 0,","+        \"failures\": 0,","+        \"initiatingSetRewind\": {","+            \"rewound\": 0,","+            \"skippedTooOld\": 0,","+            \"oldestEntryParseFailures\": 0,","+            \"disabledAfterFailedAttempt\": 0,","+        },","+    },","     \"internodeConsistency\": {\"hashMismatch\": {\"insert\": 0, \"update\": 0, \"delete\": 0}},","     \"network\": {","         \"bytes\": 0,"],"additions":11,"deletions":1,"truncated":false},{"path":"src/mongo/db/repl/initial_sync/initial_sync_state.h","lines":["@@ -35,6 +35,8 @@ struct InitialSyncState {","     Timestamp stopTimestamp;  // Referred to as minvalid, or the place we can transition states.","     Timer timer;              // Timer for timing how long each initial sync attempt takes.","     size_t appliedOps = 0;","+    size_t writtenNotAppliedOps = 0;  // Entries at or before the beginApplyingTimestamp, written","+                                      // to the oplog without being applied."," };"," "," }  // namespace repl"],"additions":2,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/initial_sync/initial_syncer.cpp","lines":["@@ -27,6 +27,7 @@"," #include \"mongo/db/repl/oplog.h\""," #include \"mongo/db/repl/oplog_applier_batcher.h\""," #include \"mongo/db/repl/oplog_buffer.h\"","+#include \"mongo/db/repl/oplog_entry.h\""," #include \"mongo/db/repl/oplog_fetcher.h\""," #include \"mongo/db/repl/optime.h\""," #include \"mongo/db/repl/read_concern_args.h\"","@@ -65,6 +66,7 @@"," #include \"mongo/util/timer.h\""," #include \"mongo/util/version/releases.h\""," ","+#include <algorithm>"," #include <functional>"," #include <memory>"," #include <string_view>","@@ -364,6 +366,7 @@ void InitialSyncer::_cancelRemainingWork(WithLock lk) {","     _shutdownComponent(lk, _fCVFetcher);","     _shutdownComponent(lk, _lastOplogEntryFetcher);","     _shutdownComponent(lk, _beginFetchingOpTimeFetcher);","+    _shutdownComponent(lk, _oldestOplogEntryFetcher);","     _shutdownComponent(lk, _fastCountTimestampStoreFetcher);","     _shutdownComponent(lk, _fastCountOldestOplogEntryFetcher);","     (*_attemptExec)->shutdown();","@@ -457,6 +460,8 @@ void InitialSyncer::_appendInitialSyncProgressMinimal(WithLock lk, BSONObjBuilde","         }","     }","     bob->appendNumber(\"appliedOps\", static_cast<long long>(_initialSyncState->appliedOps));","+    bob->appendNumber(\"writtenNotAppliedOps\",","+                      static_cast<long long>(_initialSyncState->writtenNotAppliedOps));","     if (!_initialSyncState->beginApplyingTimestamp.isNull()) {","         bob->append(\"initialSyncOplogStart\", _initialSyncState->beginApplyingTimestamp);","     }","@@ -701,6 +706,7 @@ void InitialSyncer::_startInitialSyncAttemptCallback(","     _opts.resetOptimes();","     _lastApplied = {OpTime(), Date_t()};","     _lastFetched = {};","+    _attemptRewoundToInitiatingSet = false;"," ","     LOGV2_DEBUG(","         21167, 2, \"Resetting the oldest timestamp before starting this initial sync attempt\");","@@ -1109,6 +1115,133 @@ void InitialSyncer::_getBeginFetchingOpTimeCallback(","         initialSyncHangAfterGettingBeginFetchingTimestamp.pauseWhileSet();","     }"," ","+    // Before moving on, check whether the sync source's oplog still begins at the 'initiating set'","+    // entry. See _handleOldestOplogEntryForInitiatingSetResponse().","+    if (initialSyncFetchFromInitiatingSetEntry && !_skipInitiatingSetRewind) {","+        _scheduleGetOldestOplogEntryForInitiatingSet(lock, onCompletionGuard, beginFetchingOpTime);","+    } else {","+        _scheduleFastCountOrBeginApplyingTimestampFetcher(","+            lock, onCompletionGuard, beginFetchingOpTime);","+    }","+}","+","+void InitialSyncer::_scheduleGetOldestOplogEntryForInitiatingSet(","+    WithLock lock,","+    std::shared_ptr<OnCompletionGuard> onCompletionGuard,","+    OpTime beginFetchingOpTime) {","+    // Bound the find the same way the oplog fetcher bounds its initial find on the sync source's","+    // oplog, so that an unresponsive sync source fails this attempt instead of hanging it.","+    const Milliseconds findMaxTime = Seconds(oplogInitialFindMaxSeconds.load());","+    const Milliseconds networkTimeout =","+        findMaxTime + Seconds(oplogNetworkTimeoutBufferSeconds.load());","+    BSONObj query = BSON(","+        \"find\" << NamespaceString::kRsOplogNamespace.coll() << \"sort\" << BSON(\"$natural\" << 1)","+               << \"limit\" << 1 << \"maxTimeMS\" << durationCount<Milliseconds>(findMaxTime)","+               << ReadConcernArgs::kReadConcernFieldName << ReadConcernArgs::kLocal.toBSONInner());","+","+    _oldestOplogEntryFetcher = std::make_unique<Fetcher>(","+        *_attemptExec,","+        _syncSource,","+        NamespaceString::kRsOplogNamespace.dbName(),","+        query,","+        [=, this](const StatusWith<mongo::Fetcher::QueryResponse>& response,","+                  mongo::Fetcher::NextAction*,","+                  mongo::BSONObjBuilder*) mutable {","+            _handleOldestOplogEntryForInitiatingSetResponse(","+                response, onCompletionGuard, beginFetchingOpTime);","+        },","+        ReadPreferenceSetting::secondaryPreferredMetadata(),","+        networkTimeout /* find network timeout */,","+        networkTimeout /* getMore network timeout */,","+        std::make_unique<DefaultRetryStrategy>(numInitialSyncOplogFindAttempts.load()));","+    Status scheduleStatus = _oldestOplogEntryFetcher->schedule();","+    if (!scheduleStatus.isOK()) {","+        _oldestOplogEntryFetcher.reset();","+        onCompletionGuard->setResultAndCancelRemainingWork(lock, scheduleStatus);","+    }","+}","+","+void InitialSyncer::_handleOldestOplogEntryForInitiatingSetResponse(","+    const StatusWith<Fetcher::QueryResponse>& result,","+    std::shared_ptr<OnCompletionGuard> onCompletionGuard,","+    OpTime beginFetchingOpTime) {","+    std::unique_lock lk(_mutex);","+    auto status = _checkForShutdownAndConvertStatus(","+        lk, result.getStatus(), \"error while getting oldest oplog entry from sync source\");","+    if (!status.isOK()) {","+        onCompletionGuard->setResultAndCancelRemainingWork(lk, status);","+        return;","+    }","+","+    // If the sync source's oldest oplog entry is the 'initiating set' entry, its oplog has never","+    // been truncated. Rewinding the beginFetchingTimestamp to that entry makes it the first entry","+    // of this node's oplog too. Change streams rely on it to prove that nothing has fallen off a","+    // node's oplog (see initCursorAndAssertTsHasNotFallenOff() in collection_scan.cpp); without it,","+    // a stream resumed against a freshly initial synced member of a new replica set fails with","+    // ChangeStreamHistoryLost even though the sync source could have served it.","+    //","+    // Only the fetch start moves. The extra entries are all at or before the","+    // beginApplyingTimestamp, so they are written to the oplog but never applied, the same","+    // treatment already given to entries fetched to reconstruct transaction history. In particular,","+    // a 'setFeatureCompatibilityVersion' entry in this range is skipped before it reaches the check","+    // in applyOperation() that rejects FCV changes during initial sync.","+    //","+    // The rewind is best-effort: we keep the beginFetchingTimestamp we already have if the sync","+    // source's oplog has truncated, if its oldest entry cannot be parsed, or if the rewind would","+    // fetch more than 'initialSyncFetchFromInitiatingSetEntryMaxSecs' of additional oplog.","+    const auto& docs = result.getValue().documents;","+    if (!docs.empty()) {","+        try {","+            const OplogEntryParserNonStrict oldestEntry{docs.front()};","+            const auto oldestOpTime = oldestEntry.getOpTime();","+            const bool isInitiatingSetEntry = oldestEntry.getOpType() == OpTypeEnum::kNoop &&","+                oldestEntry.getObject().getStringField(kNewPrimaryMsgField) == kInitiatingSetMsg;","+            const auto rewindSecs = static_cast<long long>(beginFetchingOpTime.getSecs()) -","+                static_cast<long long>(oldestOpTime.getSecs());","+            const auto maxRewindSecs = initialSyncFetchFromInitiatingSetEntryMaxSecs;","+            if (isInitiatingSetEntry && oldestOpTime < beginFetchingOpTime) {","+                if (rewindSecs <= maxRewindSecs) {","+                    LOGV2(12195600,","+                          \"Rewinding the beginFetchingTimestamp to the sync source's 'initiating \"","+                          \"set' oplog entry\",","+                          \"syncSource\"_attr = _syncSource,","+                          \"previousBeginFetchingOpTime\"_attr = beginFetchingOpTime,","+                          \"initiatingSetOpTime\"_attr = oldestOpTime);","+                    beginFetchingOpTime = oldestOpTime;","+                    _attemptRewoundToInitiatingSet = true;","+                    initial_sync_common_stats::incrementInitiatingSetRewindMetric(","+                        initial_sync_common_stats::InitiatingSetRewindOutcome::kRewound);","+                } else {","+                    LOGV2(12195601,","+                          \"Not rewinding the beginFetchingTimestamp to the sync source's \"","+                          \"'initiating set' oplog entry because it is too old\",","+                          \"syncSource\"_attr = _syncSource,","+                          \"beginFetchingOpTime\"_attr = beginFetchingOpTime,","+                          \"initiatingSetOpTime\"_attr = oldestOpTime,","+                          \"rewindSecs\"_attr = rewindSecs,","+                          \"initialSyncFetchFromInitiatingSetEntryMaxSecs\"_attr = maxRewindSecs);","+                    initial_sync_common_stats::incrementInitiatingSetRewindMetric(","+                        initial_sync_common_stats::InitiatingSetRewindOutcome::kSkippedTooOld);","+                }","+            }","+        } catch (const DBException& ex) {","+            LOGV2_WARNING(12195602,","+                          \"Failed to parse the sync source's oldest oplog entry; not rewinding the \"","+                          \"beginFetchingTimestamp\",","+                          \"syncSource\"_attr = _syncSource,","+                          \"error\"_attr = redact(ex));","+            initial_sync_common_stats::incrementInitiatingSetRewindMetric(","+                initial_sync_common_stats::InitiatingSetRewindOutcome::kOldestEntryParseFailure);","+        }","+    }","+","+    _scheduleFastCountOrBeginApplyingTimestampFetcher(lk, onCompletionGuard, beginFetchingOpTime);","+}","+","+void InitialSyncer::_scheduleFastCountOrBeginApplyingTimestampFetcher(","+    WithLock lock,","+    std::shared_ptr<OnCompletionGuard> onCompletionGuard,","+    OpTime beginFetchingOpTime) {","     // When replicated fast count is enabled, beginFetchingTimestamp must be no later than the sync","     // source's persisted fast-count validAsOf so that, after seeding the counts during cloning, we","     // retain the oplog needed to advance them. We discover validAsOf by scanning the sync source's","@@ -1969,10 +2102,17 @@ void InitialSyncer::_getNextApplierBatchCallback(","         OpTime lastApplied = ops.back().getOpTime();","         Date_t lastAppliedWall = ops.back().getWallClockTime();"," ","-        auto numApplied = ops.size();","+        const auto numOpsInBatch = static_cast<std::uint32_t>(ops.size());","+        // The applier skips the entries at or before the beginApplyingTimestamp after writing them","+        // to the oplog.","+        const auto beginApplyingTimestamp = _initialSyncState->beginApplyingTimestamp;","+        const auto numOpsToApply = static_cast<std::uint32_t>(","+            std::count_if(ops.begin(), ops.end(), [&](const OplogEntry& op) {","+                return op.getOpTime().getTimestamp() > beginApplyingTimestamp;","+            }));","         MultiApplier::CallbackFn onCompletionFn = [=, this](const Status& s) {","             return _multiApplierCallback(","-                s, {lastApplied, lastAppliedWall}, 