{"id":"c9b9d41c7aa2663c1847754d22ce8dddfc5ac326","axis":"silent","repo":"mongodb/mongo","sha":"c9b9d41c7aa2663c1847754d22ce8dddfc5ac326","parsed":{"files":[{"path":"jstests/replsets/index_builds/index_build_ledger_fastcount.js","lines":["@@ -0,0 +1,218 @@","+/**","+ * Repro tests for cases where replaying a two-phase index build's commit from after the stable","+ * timestamp would leave local.system.indexBuilds' fast count inconsistent. Recovery restarted the","+ * build inserting a ledger entry and then replayed the commit, deleting the entry without counting","+ * the deletion.","+ *","+ * @tags: [","+ *   primary_driven_index_builds_incompatible,","+ *   requires_mongobridge,","+ *   requires_persistence,","+ *   requires_replication,","+ *   requires_rollbacks,","+ * ]","+ */","+import {configureFailPoint} from \"jstests/libs/fail_point_util.js\";","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+import {IndexBuildTest} from \"jstests/noPassthrough/libs/index_builds/index_build.js\";","+import {RollbackTest} from \"jstests/replsets/libs/rollback_test.js\";","+","+const kReplayingOplogLogId = 21550;","+const kIndexBuildRestartingLogId = 20660;","+","+function validateLedger(node) {","+    const local = node.getDB(\"local\");","+    const res = assert.commandWorked(local.runCommand({validate: \"system.indexBuilds\"}));","+    assert(res.valid, \"validate failed\", {res});","+    assert.eq(local.system.indexBuilds.count(), res.nrecords, \"fast count mismatch\", {res});","+}","+","+function appliedOpTimeTs(node) {","+    return assert.commandWorked(node.adminCommand({replSetGetStatus: 1})).optimes.appliedOpTime.ts;","+}","+","+function lastStableRecoveryTimestamp(node) {","+    return assert.commandWorked(node.adminCommand({replSetGetStatus: 1}))","+        .lastStableRecoveryTimestamp;","+}","+","+function waitForStableCheckpointPast(node, ts) {","+    assert.soon(() => {","+        assert.commandWorked(node.adminCommand({fsync: 1}));","+        return timestampCmp(lastStableRecoveryTimestamp(node), ts) >= 0;","+    });","+}","+","+function commitTimestamp(node, collName) {","+    return node","+        .getDB(\"local\")","+        .oplog.rs.findOne({op: \"c\", \"o.commitIndexBuild\": collName}, {ts: 1}, {ts: -1}).ts;","+}","+","+const toTimestamp = ({$timestamp: {t, i}}) => Timestamp(t, i);","+","+/**","+ * Asserts via the log that 'node' most recently restarted the build on 'test.<collName>' and then","+ * replayed the oplog through its commit, or the test isn't exercising the bug. Returns the replay's","+ * start point.","+ */","+function assertRestartedThenReplayedCommit(node, collName, commitTs) {","+    checkLog.containsJson(node, kReplayingOplogLogId);","+    const log = checkLog.getGlobalLog(node).flatMap((line) => {","+        try {","+            return [JSON.parse(line)];","+        } catch {","+            return [];","+        }","+    });","+    const replayIdx = log.findLastIndex((entry) => entry.id === kReplayingOplogLogId);","+    const restartIdx = log.findLastIndex(","+        (entry) =>","+            entry.id === kIndexBuildRestartingLogId && entry.attr.namespace === `test.${collName}`,","+    );","+    assert.neq(restartIdx, -1, \"index build was not restarted by recovery\");","+    assert.lt(restartIdx, replayIdx, \"index build must restart before oplog replay\");","+","+    const replay = log[replayIdx];","+    const startPoint = toTimestamp(replay.attr.startPoint);","+    const endPoint = toTimestamp(replay.attr.endPoint);","+    assert.gt(timestampCmp(commitTs, startPoint), 0, \"commit must be replayed\", {replay});","+    assert.lte(timestampCmp(commitTs, endPoint), 0, \"commit must be replayed\", {replay});","+    return startPoint;","+}","+","+describe(\"Index build ledger fast count after a clean restart\", function () {","+    before(() => {","+        this.rst = new ReplSetTest({nodes: [{}, {}, {rsConfig: {priority: 0}}]});","+        this.rst.startSet();","+        this.rst.initiate();","+    });","+","+    after(() => {","+        this.rst.stopSet();","+    });","+","+    it(\"counts the replayed commit's delete\", () => {","+        const primary = this.rst.getPrimary();","+        let secondary = this.rst.nodes[2];","+        const db = primary.getDB(\"test\");","+        assert.commandWorked(db.c.insert({a: 1}));","+        this.rst.awaitReplication();","+","+        const hangFp = configureFailPoint(secondary, \"hangAfterIndexBuildDumpsInsertsFromBulk\");","+        const awaitCreate = startParallelShell(() => {","+            assert.commandWorked(db.c.createIndex({a: 1}));","+        }, primary.port);","+        hangFp.wait();","+","+        // Let the stable timestamp and a checkpoint include the startIndexBuild and the ledger","+        // entry.","+        assert.commandWorked(db.c.insert({a: 2}, {writeConcern: {w: 3}}));","+        const ts = appliedOpTimeTs(secondary);","+        waitForStableCheckpointPast(secondary, ts);","+","+        // Let the index build complete with the stable timestamp pinned so the commit isn't stable.","+        configureFailPoint(secondary, \"holdStableTimestampAtSpecificTimestamp\", {timestamp: ts});","+        hangFp.off();","+        awaitCreate();","+        this.rst.awaitReplication();","+        validateLedger(secondary);","+","+        const commitTs = commitTimestamp(secondary, \"c\");","+        assert.gt(timestampCmp(commitTs, ts), 0, \"commit must be after the held stable timestamp\");","+","+        secondary = this.rst.restart(secondary);","+        const startPoint = assertRestartedThenReplayedCommit(secondary, \"c\", commitTs);","+        assert.gte(timestampCmp(startPoint, ts), 0, \"replay must start from the held stable ts\", {","+            startPoint,","+        });","+","+        this.rst.awaitSecondaryNodes(null, [secondary]);","+        this.rst.awaitReplication();","+        assert.eq(secondary.getDB(\"local\").system.indexBuilds.find().itcount(), 0);","+        validateLedger(secondary);","+    });","+});","+","+describe(\"Index build ledger fast count across rollback\", function () {","+    before(() => {","+        this.rollbackTest = new RollbackTest(jsTestName(), undefined, {syncdelay: 1});","+    });","+","+    after(() => {","+        this.rollbackTest.stop();","+    });","+","+    it(\"counts the replayed commit's delete\", () => {","+        let rollbackNode = this.rollbackTest.getPrimary();","+        const db = rollbackNode.getDB(\"test\");","+        assert.commandWorked(db.c.insert({a: 1}));","+        assert.commandWorked(db.other.insert({a: 1}));","+        this.rollbackTest.awaitReplication();","+","+        // Keep another build's entry in the ledger so that it isn't empty when rollback reopens the","+        // catalog, as empty record stores always have their size tracked through recovery. The","+        // tiebreaker isn't replicating, so this build can't commit until after the rollback.","+        const awaitOtherIndex = IndexBuildTest.startIndexBuild(","+            rollbackNode,","+            db.other.getFullName(),","+            {a: 1},","+            {},","+            [ErrorCodes.InterruptedDueToReplStateChange],","+        );","+        const ledger = rollbackNode.getDB(\"local\").system.indexBuilds;","+        assert.soon(() => ledger.find().itcount() === 1);","+","+        IndexBuildTest.pauseIndexBuilds(rollbackNode);","+        const awaitCreateIndex = IndexBuildTest.startIndexBuild(","+            rollbackNode,","+            db.c.getFullName(),","+            {a: 1},","+            {},","+            [],","+            /*commitQuorum=*/ 1,","+        );","+        IndexBuildTest.waitForIndexBuildToScanCollection(db, \"c\", \"a_1\");","+","+        // Let the stable timestamp and a checkpoint include the startIndexBuild and the ledger","+        // entry, so that rollback restarts the build rather than rolling back its start.","+        const ts = appliedOpTimeTs(rollbackNode);","+        waitForStableCheckpointPast(rollbackNode, ts);","+","+        // Hold the stable timestamp before the commit, so that rollback restarts the build and then","+        // replays the commit.","+        const holdFp = configureFailPoint(rollbackNode, \"holdStableTimestampAtSpecificTimestamp\", {","+            timestamp: ts,","+        });","+        IndexBuildTest.resumeIndexBuilds(rollbackNode);","+        awaitCreateIndex();","+        this.rollbackTest.awaitReplication();","+        validateLedger(rollbackNode);","+","+        const commitTs = commitTimestamp(rollbackNode, \"c\");","+        assert.gt(timestampCmp(commitTs, ts), 0, \"commit must be after the held stable timestamp\");","+","+        // The commit is replicated to the sync source, so it is before the common point.","+        rollbackNode = this.rollbackTest.transitionToRollbackOperations();","+        this.rollbackTest.transitionToSyncSourceOperationsBeforeRollback();","+        this.rollbackTest.transitionToSyncSourceOperationsDuringRollback();","+        this.rollbackTest.transitionToSteadyStateOperations();","+        holdFp.off();","+","+        const startPoint = assertRestartedThenReplayedCommit(rollbackNode, \"c\", commitTs);","+        assert.gte(","+            timestampCmp(startPoint, ts),","+            0,","+            \"rollback must recover to at or after the held stable timestamp\",","+            {startPoint, ts},","+        );","+        validateLedger(rollbackNode);","+","+        awaitOtherIndex();","+        rollbackNode.setSecondaryOk();","+        IndexBuildTest.assertIndexesSoon(rollbackNode.getDB(\"test\").other, 2, [\"_id_\", \"a_1\"]);","+        assert.soon(() => rollbackNode.getDB(\"local\").system.indexBuilds.find().itcount() === 0);","+        validateLedger(rollbackNode);","+    });","+});"],"additions":218,"deletions":0,"truncated":false},{"path":"src/mongo/db/index_builds/BUILD.bazel","lines":["@@ -280,6 +280,7 @@ mongo_cc_library(","         \"//src/mongo/db/shard_role\",","         \"//src/mongo/db/shard_role/lock_manager\",","         \"//src/mongo/db/shard_role/lock_manager:exception_util\",","+        \"//src/mongo/db/shard_role/shard_catalog:collection_catalog\",","         \"//src/mongo/db/shard_role/shard_catalog:collection_options\",","         \"//src/mongo/db/storage:journal_flusher\",","     ],"],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/index_builds/index_build_attempts.cpp","lines":["@@ -12,9 +12,11 @@"," #include \"mongo/db/repl/oplog.h\""," #include \"mongo/db/repl/read_concern_args.h\""," #include \"mongo/db/repl/storage_interface.h\"","+#include \"mongo/db/server_recovery.h\""," #include \"mongo/db/session/logical_session_id.h\""," #include \"mongo/db/shard_role/lock_manager/exception_util.h\""," #include \"mongo/db/shard_role/shard_catalog/clustered_collection_util.h\"","+#include \"mongo/db/shard_role/shard_catalog/collection_catalog.h\""," #include \"mongo/db/shard_role/shard_catalog/collection_options.h\""," #include \"mongo/db/shard_role/shard_role.h\""," #include \"mongo/db/shard_role/transaction_resources.h\"","@@ -133,6 +135,15 @@ void incrementAttempts(OperationContext* opCtx) {","         opCtx, kNss, BSONObj(), {BSON(\"$inc\" << BSON(kAttemptsField << 1)), Timestamp()}));"," }"," ","+void trackSizeThroughRecovery(OperationContext* opCtx) {","+    const auto collection = CollectionCatalog::get(opCtx)->lookupCollectionByNamespace(opCtx, kNss);","+    if (!collection) {","+        return;","+    }","+    sizeRecoveryState(opCtx->getServiceContext())","+        .markCollectionAsAlwaysNeedsSizeAdjustment(collection->getRecordStore()->getIdent());","+}","+"," void removeEntry(OperationContext* opCtx, const UUID& buildUUID) {","     removeEntries(opCtx, {buildUUID});"," }"],"additions":11,"deletions":0,"truncated":false},{"path":"src/mongo/db/index_builds/index_build_attempts.h","lines":["@@ -53,6 +53,12 @@ void removeEntries(OperationContext* opCtx, const std::vector<UUID>& buildUUIDs)","  */"," boost::optional<int> read(OperationContext* opCtx, const UUID& buildUUID);"," ","+/**","+ * If it exists, marks the collection's record store so that its size is tracked during replication","+ * recovery.","+ */","+void trackSizeThroughRecovery(OperationContext* opCtx);","+"," }  // namespace two_phase"," "," }  // namespace mongo::index_builds::build_attempts"],"additions":6,"deletions":0,"truncated":false},{"path":"src/mongo/db/index_builds/index_build_attempts_test.cpp","lines":["@@ -6,8 +6,10 @@"," #include \"mongo/bson/bsonobjbuilder.h\""," #include \"mongo/db/client.h\""," #include \"mongo/db/namespace_string.h\"","+#include \"mongo/db/server_recovery.h\""," #include \"mongo/db/service_context.h\""," #include \"mongo/db/shard_role/shard_catalog/catalog_test_fixture.h\"","+#include \"mongo/db/shard_role/shard_catalog/collection_catalog.h\""," #include \"mongo/db/storage/control/journal_flusher.h\""," #include \"mongo/db/storage/write_unit_of_work.h\""," #include \"mongo/platform/atomic.h\"","@@ -162,5 +164,22 @@ TEST_F(IndexBuildAttemptsTest, RemoveEntryDeletesCountWithCallersCommit) {","     EXPECT_EQ(boost::none, read(operationContext(), buildUUID));"," }"," ","+TEST_F(IndexBuildAttemptsTest, RecoveryDeleteUpdatesNumRecords) {","+    // The ledger isn't rolled back to the stable timestamp, so deletes replayed during recovery","+    // remove documents that are counted in the size storer.","+    const auto buildUUID = UUID::gen();","+    EXPECT_TRUE(checkWithinAttemptLimit(operationContext(), buildUUID));","+    trackSizeThroughRecovery(operationContext());","+    {","+        InReplicationRecovery inReplicationRecovery(getServiceContext());","+        WriteUnitOfWork wuow(operationContext());","+        removeEntry(operationContext(), buildUUID);","+        wuow.commit();","+    }","+    const auto collection = CollectionCatalog::get(operationContext())","+                                ->lookupCollectionByNamespace(operationContext(), kNss);","+    EXPECT_EQ(0, collection->numRecords(operationContext()));","+}","+"," }  // namespace"," }  // namespace mongo::index_builds::build_attempts::two_phase"],"additions":19,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/BUILD.bazel","lines":["@@ -2467,6 +2467,7 @@ mongo_cc_unit_test(","         \"//src/mongo/db:server_base\",","         \"//src/mongo/db:service_context_d_test_fixture\",","         \"//src/mongo/db/collection_crud\",","+        \"//src/mongo/db/index_builds:index_build_attempts\",","         \"//src/mongo/db/op_observer\",","         \"//src/mongo/db/s:sharding_runtime_d\",","         \"//src/mongo/db/session:session_catalog_mongod\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/rollback_impl.cpp","lines":["@@ -757,6 +757,8 @@ void RollbackImpl::_runPhaseFromAbortToReconstructPreparedTxns("," ","     _checkForAllIdIndexes(opCtx);"," ","+    index_builds::build_attempts::two_phase::trackSizeThroughRecovery(opCtx);","+","     // Run the recovery process.","     _replicationProcess->getReplicationRecovery()->recoverFromOplog(opCtx, stableTimestamp);","     _listener->onRecoverFromOplog();"],"additions":2,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/rollback_impl_test.cpp","lines":["@@ -13,6 +13,7 @@"," #include \"mongo/db/database_name.h\""," #include \"mongo/db/exec/document_value/value.h\""," #include \"mongo/db/global_catalog/type_shard_identity.h\"","+#include \"mongo/db/index_builds/index_build_attempts.h\""," #include \"mongo/db/namespace_string_util.h\""," #include \"mongo/db/op_observer/op_observer_util.h\""," #include \"mongo/db/record_id.h\"","@@ -27,6 +28,7 @@"," #include \"mongo/db/repl/rollback_test_fixture.h\""," #include \"mongo/db/rss/replicated_storage_service.h\""," #include \"mongo/db/server_options.h\"","+#include \"mongo/db/server_recovery.h\""," #include \"mongo/db/service_context.h\""," #include \"mongo/db/session/logical_session_id.h\""," #include \"mongo/db/session/logical_session_id_gen.h\"","@@ -34,6 +36,7 @@"," #include \"mongo/db/shard_role/lock_manager/d_concurrency.h\""," #include \"mongo/db/shard_role/lock_manager/lock_manager_defs.h\""," #include \"mongo/db/shard_role/shard_catalog/collection.h\"","+#include \"mongo/db/shard_role/shard_catalog/collection_catalog.h\""," #include \"mongo/db/shard_role/shard_catalog/collection_mock.h\""," #include \"mongo/db/shard_role/shard_catalog/collection_options.h\""," #include \"mongo/db/shard_role/shard_catalog/index_descriptor.h\"","@@ -905,6 +908,30 @@ TEST_F(RollbackImplTest, RollbackCallsRecoverFromOplog) {","     ASSERT(_recoveredFromOplog);"," }"," ","+TEST_F(RollbackImplTest, RollbackTracksIndexBuildAttemptsSizeThroughRecoverFromOplog) {","+    ASSERT_TRUE(index_builds::build_attempts::two_phase::createCollection(_opCtx.get()));","+    const auto ident =","+        CollectionCatalog::get(_opCtx.get())","+            ->lookupCollectionByNamespace(_opCtx.get(), NamespaceString::kLocalIndexBuildsNamespace)","+            ->getRecordStore()","+            ->getIdent();","+","+    auto op = makeOpAndRecordId(1);","+    _remoteOplog->setOperations({op});","+    ASSERT_OK(_insertOplogEntry(op.first));","+    ASSERT_OK(_insertOplogEntry(makeOp(2)));","+    _storageInterface->setStableTimestamp(nullptr, Timestamp(1, 1));","+","+    _onRecoverFromOplogFn = [&]() {","+        _recoveredFromOplog = true;","+        ASSERT_TRUE(sizeRecoveryState(_opCtx->getServiceContext())","+                        .collectionAlwaysNeedsSizeAdjustment(ident));","+    };","+","+    ASSERT_OK(_rollback->runRollback(_opCtx.get()));","+    ASSERT(_recoveredFromOplog);","+}","+"," TEST_F(RollbackImplTest,","        RollbackCannotBeShutDownBetweenAbortingAndReconstructingPreparedTransactions) {","     auto op = makeOpAndRecordId(1);"],"additions":27,"deletions":0,"truncated":false},{"path":"src/mongo/db/startup_recovery.cpp","lines":["@@ -815,6 +815,14 @@ void startupRecovery(OperationContext* opCtx,","             index_builds::build_attempts::two_phase::incrementAttempts(opCtx);","         }","     }","+","+    // If the index build attempts collection exists, track size changes to it through oplog replay.","+    // Normally this is skipped because the size storer already stores what the size will be at the","+    // end of replay (due to being an unreplicated table that doesn't get rolled back), but if a","+    // commit/abort is rolled back restarting the index build will write a document that is deleted","+    // by oplog replay and we need to count that delete. The collection may exist even when we","+    // wouldn't create it due to --recoverFromOplogAsStandalone.","+    index_builds::build_attempts::two_phase::trackSizeThroughRecovery(opCtx);"," }"," "," // Returns true if the oplog collection exists. Will always return false if the cached pointer to",""],"additions":8,"deletions":0,"truncated":false}],"additions":293,"deletions":0,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-24T20:30:43.685200+00:00"}