ndas.io.formats.info\",)","+"," from collections.abc import (","     Callable,","     Hashable,"],"additions":2,"deletions":0,"truncated":false},{"path":"pandas/io/__init__.py","lines":["@@ -1,4 +1,4 @@","-# ruff: noqa: TC004","+from importlib import import_module as _import_module"," from typing import TYPE_CHECKING"," "," if TYPE_CHECKING:","@@ -11,3 +11,22 @@"," ","     # mark only those modules as public","     __all__ = [\"formats\", \"json\", \"stata\"]","+","+","+def _lazy_submodules() -> set[str]:","+    # submodules that PEP 810 lazy imports keep out of a plain `import pandas`","+    # on Python 3.15+, so pd.io.<name> would otherwise disappear: the backends","+    # pandas.io.api defers, and pandas.io.common (deferred by core.frame and","+    # io.formats.format)","+    api = _import_module(\"pandas.io.api\")","+    return {\"common\", *(name.rsplit(\".\", 1)[1] for name in api.__lazy_modules__)}","+","+","+def __getattr__(name: str) -> object:","+    if name in _lazy_submodules():","+        return _import_module(f\"pandas.io.{name}\")","+    raise AttributeError(f\"module 'pandas.io' has no attribute '{name}'\")","+","+","+def __dir__() -> list[str]:","+    return sorted({*globals(), *_lazy_submodules()})"],"additions":20,"deletions":1,"truncated":false},{"path":"pandas/io/api.py","lines":["@@ -2,6 +2,25 @@"," Data I/O API"," \"\"\""," ","+__lazy_modules__ = (","+    \"pandas.io.clipboards\",","+    \"pandas.io.excel\",","+    \"pandas.io.feather_format\",","+    \"pandas.io.html\",","+    \"pandas.io.iceberg\",","+    \"pandas.io.json\",","+    \"pandas.io.orc\",","+    \"pandas.io.parquet\",","+    \"pandas.io.parsers\",","+    \"pandas.io.pickle\",","+    \"pandas.io.pytables\",","+    \"pandas.io.sas\",","+    \"pandas.io.spss\",","+    \"pandas.io.sql\",","+    \"pandas.io.stata\",","+    \"pandas.io.xml\",","+)","+"," from pandas.io.clipboards import read_clipboard"," from pandas.io.excel import (","     ExcelFile,"],"additions":19,"deletions":0,"truncated":false},{"path":"pandas/io/formats/format.py","lines":["@@ -5,6 +5,8 @@"," "," from __future__ import annotations"," ","+__lazy_modules__ = (\"pandas.io.common\",)","+"," from collections.abc import (","     Callable,","     Generator,"],"additions":2,"deletions":0,"truncated":false},{"path":"pandas/tests/api/test_api.py","lines":["@@ -4,6 +4,8 @@"," import inspect"," import pathlib"," import pkgutil","+import subprocess","+import sys"," "," import pytest"," ","@@ -607,3 +609,68 @@ def test_attributes_module(module_name):","         except Exception:","             failures.append((module_name, name, type(obj), obj.__module__))","     assert len(failures) == 0, \"\\n\".join(str(e) for e in failures)","+","+","+@pytest.mark.skipif(","+    sys.version_info < (3, 15), reason=\"PEP 810 lazy imports require Python 3.15+\"","+)","+def test_lazy_imports():","+    # `import pandas` should not eagerly import the deferred I/O backends","+    code = (","+        \"import pandas, sys; \"","+        \"assert 'pandas.io.excel' not in sys.modules; \"","+        \"assert 'pandas.testing' not in sys.modules\"","+    )","+    subprocess.check_call([sys.executable, \"-X\", \"lazy_imports=normal\", \"-c\", code])","+","+","+@pytest.mark.skipif(","+    sys.version_info < (3, 15), reason=\"PEP 810 lazy imports require Python 3.15+\"","+)","+def test_lazy_imports_read_csv():","+    # pd.read_csv must only load pandas.io.parsers, not sibling backends","+    code = (","+        \"import pandas as pd, sys\\n\"","+        \"from io import StringIO\\n\"","+        \"pd.read_csv(StringIO('a,b\\\\n1,2'))\\n\"","+        \"assert 'pandas.io.parsers' in sys.modules\\n\"","+        \"import pandas.io.api\\n\"","+        \"siblings = set(pandas.io.api.__lazy_modules__) - {'pandas.io.parsers'}\\n\"","+        \"loaded = [m for m in siblings if m in sys.modules]\\n\"","+        \"assert not loaded, f'unexpectedly loaded: {loaded}'\\n\"","+    )","+    result = subprocess.run(","+        [sys.executable, \"-X\", \"lazy_imports=normal\", \"-c\", code],","+        capture_output=True,","+        text=True,","+        check=False,","+    )","+    assert result.returncode == 0, result.stderr","+","+","+@pytest.mark.skipif(","+    sys.version_info < (3, 15), reason=\"PEP 810 lazy imports require Python 3.15+\"","+)","+def test_lazy_imports_io_namespace():","+    code = (","+        \"import pandas as pd, sys\\n\"","+        # the whole derived set (backends + common) is advertised but none of it","+        # is imported by a plain `import pandas`","+        \"names = pd.io._lazy_submodules()\\n\"","+        \"assert names <= set(dir(pd.io))\\n\"","+        \"assert not any(f'pandas.io.{n}' in sys.modules for n in names)\\n\"","+        \"assert len(set(dir(pd.io))) == len(dir(pd.io))\\n\"","+        # common is deferred by core.frame / io.formats.format, not by io.api","+        \"assert pd.io.common.get_handle is not None\\n\"","+        # accessing one reifies just that submodule, leaving the rest lazy","+        \"_ = pd.io.stata\\n\"","+        \"assert 'pandas.io.stata' in sys.modules\\n\"","+        \"assert 'pandas.io.json' not in sys.modules\\n\"","+    )","+    result = subprocess.run(","+        [sys.executable, \"-X\", \"lazy_imports=normal\", \"-c\", code],","+        capture_output=True,","+        text=True,","+        check=False,","+    )","+    assert result.returncode == 0, result.stderr"],"additions":67,"deletions":0,"truncated":false},{"path":"pandas/tests/test_common.py","lines":["@@ -197,7 +197,10 @@ def test_version_tag():","         ) from err"," "," ","-@pytest.mark.parametrize(\"obj\", [obj for obj in pd.__dict__.values() if callable(obj)])","+# getattr, not pd.__dict__.values(): PEP 810 lazy imports leave non-callable proxies","+@pytest.mark.parametrize(","+    \"obj\", [obj for obj in (getattr(pd, name) for name in dir(pd)) if callable(obj)]","+)"," def test_serializable(obj, temp_file):","     # GH 35611","     unpickled = tm.round