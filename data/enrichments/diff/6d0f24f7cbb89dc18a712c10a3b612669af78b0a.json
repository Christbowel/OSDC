 State,","-    WantedLockfileSelection, deployed_workspace_projects,","+    WantedLockfileSelection, approve_legacy_workspace_project_builds, deployed_workspace_projects,","     get_preferred_versions_from_lockfile_and_manifests, resolve_bool_override, warn,"," };"," use pnpm_lockfile_verification::{VerifyLockfileResolutionsOptions, verify_lockfile_resolutions};","@@ -185,14 +185,14 @@ impl DeployArgs {","         source_hooks: Option<Arc<dyn pnpm_hooks::PnpmfileHooks>>,","         legacy_source: Option<LegacyDeploySource>,","     ) -> miette::Result<()> {","-        let legacy = matches!(&mode, DeployInstallMode::Legacy);","+        let legacy = matches!(&mode, DeployInstallMode::Legacy { .. });","         let config = self.deploy_install_config(","             base_config,","             deploy_dir,","             mode,","             frozen_lockfile,","             source_hooks.is_none(),","-        );","+        )?;","         let pnpmfile_hook = deploy_pnpmfile_hooks(source_hooks, legacy);","         let mut state = State::init(deploy_dir.join(\"package.json\"), config, frozen_lockfile)","             .wrap_err(\"initialize the deploy install state\")?;","@@ -280,7 +280,7 @@ impl DeployArgs {","         mode: DeployInstallMode,","         frozen_lockfile: bool,","         ignore_pnpmfile: bool,","-    ) -> &'static Config {","+    ) -> miette::Result<&'static Config> {","         let node_linker = self.install_args.materialization.node_linker.map_or(","             base_config.node_linker,","             NodeLinkerArg::into_config,","@@ -304,10 +304,21 @@ impl DeployArgs {","         // This applies to every workspace package of the deploy install,","         // whatever the workspace sets; a legacy deploy saves no lockfile,","         // so the setting is not recorded anywhere.","-        if matches!(mode, DeployInstallMode::Legacy) {","+        if let DeployInstallMode::Legacy {","+            workspace_projects,","+            source_lockfile_dir,","+        } = &mode","+        {","             deploy_config.inject_workspace_packages = true;","+            let lockfile_dir = deploy_config.lockfile_dir_for(deploy_dir).to_path_buf();","+            approve_legacy_workspace_project_builds(","+                &mut deploy_config.allow_builds,","+                workspace_projects,","+                &lockfile_dir,","+                source_lockfile_dir,","+            )?;","         }","         apply_shared_deploy_config(&mut deploy_config, deploy_dir, mode);","-        Config::leak(deploy_config)","+        Ok(Config::leak(deploy_config))","     }"," }"],"additions":17,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/lockfile.rs","lines":["@@ -403,13 +403,8 @@ fn finish_deploy_files(","     manifest: Value,","     mut deploy_lockfile: Lockfile,"," ) -> miette::Result<DeployFiles> {","-    let (workspace_manifest, workspace_config) = deploy_workspace_settings(","-        lockfile,","-        config,","-        ctx.lockfile_dir,","-        ctx.deploy_dir,","-        &mut deploy_lockfile,","-    )?;","+    let (workspace_manifest, workspace_config) =","+        deploy_workspace_settings(lockfile, config, ctx, &mut deploy_lockfile)?;"," ","     Ok(DeployFiles {","         manifest,"],"additions":2,"deletions":7,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/peers/deployed_graph/tests.rs","lines":["@@ -177,6 +177,7 @@ fn an_unshadowed_own_dependency_declared_as_a_peer_remains_a_parent_edge() {","         lib_key.clone(),","         super::super::LinkedWorkspaceProject {","             project: crate::cli_args::deploy::ProjectInfo {","+                root_dir: std::path::PathBuf::from(\"/workspace/packages/lib\"),","                 name: Some(\"lib\".to_string()),","                 has_bin: false,","                 peer_dependencies: vec![peer.clone()],"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/tests.rs","lines":["@@ -140,6 +140,7 @@ fn create_file_url_key_prefers_workspace_project_name() {","     projects_by_path.insert(","         ProjectPathKey::new(&project_root),","         ProjectInfo {","+            root_dir: project_root.clone(),","             name: Some(\"workspace-name\".to_string()),","             has_bin: false,","             peer_dependencies: Vec::new(),","@@ -296,6 +297,7 @@ fn deploy_normalizes_registry_specifiers_and_preserves_snapshot_references() {","                 dependency_manifest: None,","             },","             projects_by_path: HashMap::new(),","+            workspace_projects: Vec::new(),","         };","         let result = create_deploy_files(","             &lockfile,"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/workspace_manifest.rs","lines":["@@ -1,6 +1,6 @@"," use super::{","-    Config, HashMap, IntoDiagnostic, Lockfile, Path, PathBuf,","-    install::configured_virtual_store_dir, relative_path,","+    Config, ConvertCtx, HashMap, IntoDiagnostic, Lockfile, Path, PathBuf,","+    approve_workspace_project_builds, install::configured_virtual_store_dir, relative_path,"," };"," use serde_json::{Map, Number, Value};"," use std::collections::{BTreeMap, BTreeSet};","@@ -266,18 +266,18 @@ impl DeployWorkspaceSettings {"," pub(super) fn deploy_workspace_settings(","     lockfile: &Lockfile,","     config: &Config,","-    lockfile_dir: &Path,","-    deploy_dir: &Path,","+    ctx: &ConvertCtx<'_>,","     deploy_lockfile: &mut Lockfile,"," ) -> miette::Result<(Map<String, Value>, DeployWorkspaceSettings)> {","     let mut settings = DeployWorkspaceSettings::from_config(config);","     prune_and_relativize_patched_dependencies(","         lockfile,","         config,","-        (lockfile_dir, deploy_dir),","+        (ctx.lockfile_dir, ctx.deploy_dir),","         deploy_lockfile,","         &mut settings,","     );","+    approve_workspace_project_builds(&mut settings.allow_builds, deploy_lockfile, ctx)?;","     settings.apply_to_lockfile(deploy_lockfile);","     let workspace_manifest = settings.to_workspace_manifest()?;","     Ok((workspace_manifest, settings))"],"additions":5,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/workspace_project_builds.rs","lines":["@@ -0,0 +1,122 @@","+//! `allowBuilds` approvals for the workspace projects a deploy installs as","+//! `file:` dependencies. In the source workspace, a project runs its","+//! scripts without approval. The deploy rewrites the project as a `file:`","+//! dependency, which a name rule in `allowBuilds` does not approve.","+//!","+//! Each approval is the exact dependency path of a discovered workspace","+//! project's root directory. A `file:` dependency on any other directory","+//! stays unapproved. A denial in `allowBuilds` wins over the approval,","+//! whether it names the project's deployed key or the key the source","+//! workspace gives it.","+","+use super::{","+    ConvertCtx, HashMap, IntoDiagnostic, Lockfile, LockfileResolution, PackageKey, PackageMetadata,","+    Path, PathBuf, ProjectInfo, ProjectPathKey, create_file_url_key, lexical_normalize,","+    relative_path,","+};","+use pnpm_package_manager::AllowBuildPolicy;","+","+/// A workspace project a legacy deploy may inject.","+#[derive(Clone)]","+pub(super) struct NamedProjectRoot {","+    pub(super) name: String,","+    pub(super) root_dir: PathBuf,","+}","+","+/// Approves each workspace project in the lockfile of a shared-lockfile","+/// deploy. A package qualifies only when its directory resolution points at","+/// a project root and its key is the one the deploy generates for that root,","+/// so a lockfile entry that redirects a project's key elsewhere does not.","+pub(super) fn approve_workspace_project_builds(","+    allow_builds: &mut HashMap<String, bool>,","+    deploy_lockfile: &Lockfile,","+    ctx: &ConvertCtx<'_>,","+) -> miette::Result<()> {","+    let mut keys = Vec::new();","+    for (package_key, metadata) in deploy_lockfile.packages.iter().flatten() {","+        if let Some(project) = workspace_project_of_package(package_key, metadata, ctx)? {","+            keys.push(ProjectBuildKey {","+                key: package_key.to_string(),","+                source_key: project.name","+                    .as_deref()","+                    .map(|name| injected_project_key(name, &project.root_dir, ctx.lockfile_dir)),","+            });","+        }","+    }","+    approve(allow_builds, keys)","+}","+","+/// Approves each workspace project under the dependency path the resolver of","+/// a legacy deploy gives an injected project: its root relative to","+/// `lockfile_dir`. `source_lockfile_dir` is the lockfile dir of the","+/// workspace the projects come from.","+pub(super) fn approve_legacy_workspace_project_builds(","+    allow_builds: &mut HashMap<String, bool>,","+    workspace_projects: &[NamedProjectRoot],","+    lockfile_dir: &Path,","+    source_lockfile_dir: &Path,","+) -> miette::Result<()> {","+    let keys = workspace_projects","+        .iter()","+        .map(|project| ProjectBuildKey {","+            key: injected_project_key(&project.name, &project.root_dir, lockfile_dir),","+            source_key: Some(injected_project_key(","+                &project.name,","+                &project.root_dir,","+                source_lockfile_dir,","+            )),","+        })","+        .collect();","+    approve(allow_builds, keys)","+}","+","+/// A key to approve, and the key the source workspace gives the same","+/// project, a denial of which also applies to it.","+struct ProjectBuildKey {","+    key: String,","+    source_key: Option<String>,","+}","+","+fn approve(","+    allow_builds: &mut HashMap<String, bool>,","+    keys: Vec<ProjectBuildKey>,","+) -> miette::Result<()> {","+    let source_policy = AllowBuildPolicy::from_approvals(allow_builds, false).into_diagnostic()?;","+    let is_denied = |key: &str| source_policy.check(key) == Some(false);","+    allow_builds.extend(","+        keys.into_iter()","+            .filter(|keys| {","+                !is_denied(&keys.key) && !keys.source_key.as_deref().is_some_and(is_denied)","+            })","+            .map(|keys| (keys.key, true)),","+    );","+    Ok(())","+}","+","+/// The key an install in `lockfile_dir` gives the project as an injected","+/// `file:` dependency.","+fn injected_project_key(name: &str, root_dir: &Path, lockfile_dir: &Path) -> String {","+    format!(\"{name}@file:{}\", relative_path(lockfile_dir, root_dir))","+}","+","+fn workspace_project_of_package<'ctx>(","+    package_key: &PackageKey,","+    metadata: &PackageMetadata,","+    ctx: &ConvertCtx<'ctx>,","+) -> miette::Result<Option<&'ctx ProjectInfo>> {","+    let LockfileResolution::Directory(resolution) = &metadata.resolution else {","+        return Ok(None);","+    };","+    let directory = lexical_normalize(&ctx.deploy_dir.join(&resolution.directory));","+    let Some(project) = ctx.projects_by_path","+        .get(&ProjectPathKey::new(&directory))","+        .filter(|project| project.root_dir == directory)","+    else {","+        return Ok(None);","+    };","+    let key = create_file_url_key(&directory, \"\", ctx.projects_by_path, None)?;","+    Ok((key == *package_key).then_some(project))","+}","+","+#[cfg(test)]","+mod tests;"],"additions":122,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/workspace_project_builds/tests.rs","lines":["@@ -0,0 +1,209 @@","+use std::{","+    collections::{HashMap, HashSet},","+    fmt::Write as _,","+    path::PathBuf,","+};","+","+use pnpm_lockfile::Lockfile;","+use pretty_assertions::assert_eq;","+","+use super::{","+    super::{ProjectInfo, ProjectPathKey, create_file_url_key},","+    ConvertCtx, NamedProjectRoot, approve_legacy_workspace_project_builds,","+    approve_workspace_project_builds,","+};","+","+struct Workspace {","+    _tmp: tempfile::TempDir,","+    root: PathBuf,","+    deploy_dir: PathBuf,","+    projects_by_path: HashMap<ProjectPathKey, ProjectInfo>,","+}","+","+impl Workspace {","+    fn with_project(name: &str) -> Self {","+        let tmp = tempfile::tempdir().expect(\"tempdir\");","+        let root = tmp.path().join(\"workspace\");","+        let project_root = root.join(\"packages\").join(name);","+        let mut projects_by_path = HashMap::new();","+        projects_by_path.insert(","+            ProjectPathKey::new(&project_root),","+            ProjectInfo {","+                root_dir: project_root,","+                name: Some(name.to_string()),","+                has_bin: false,","+                peer_dependencies: Vec::new(),","+                peer_blocks: (None, None),","+                declared_dependencies: HashSet::default(),","+            },","+        );","+        let deploy_dir = root.join(\"deploy\");","+        Self { _tmp: tmp, root, deploy_dir, projects_by_path }","+    }","+","+    /// The key the deploy generates for the directory at `relative_path`","+    /// under the workspace root.","+    fn file_key(&self, relative_path: &str) -> String {","+        create_file_url_key(&self.root.join(relative_path), \"\", &self.projects_by_path, None)","+            .expect(\"create file URL key\")","+            .to_string()","+    }","+","+    /// A deployed lockfile with one directory package per `(key, directory)`","+    /// pair, the directory relative to the deploy dir.","+    fn lockfile(packages: &[(&str, &str)]) -> Lockfile {","+        let mut yaml = String::from(\"lockfileVersion: '9.0'\\nimporters:\\n  .: {}\\npackages:\\n\");","+        for (key, directory) in packages {","+            writeln!(","+                yaml,","+                \"  '{key}':\\n    resolution: {{ type: directory, directory: {directory} }}\",","+            )","+            .expect(\"write to a String\");","+        }","+        serde_saphyr::from_str(&yaml).expect(\"parse lockfile\")","+    }","+","+    fn approve(&self, allow_builds: &[(&str, bool)], lockfile: &Lockfile) -> HashMap<String, bool> {","+        let mut allow_builds = allow_builds","+            .iter()","+            .map(|(key, value)| (key.to_string(), *value))","+            .collect();","+        let deployed_project_root = self.root.join(\"packages/app\");","+        let ctx = ConvertCtx {","+            projects_by_path: &self.projects_by_path,","+            deploy_dir: &self.deploy_dir,","+            lockfile_dir: &self.root,","+            deployed_project_root: &deployed_project_root,","+        };","+        approve_workspace_project_builds(&mut allow_builds, lockfile, &ctx)","+            .expect(\"approve workspace project builds\");","+        allow_builds","+    }","+}","+","+fn approvals(entries: &[(&str, bool)]) -> HashMap<String, bool> {","+    entries","+        .iter()","+        .map(|(key, value)| (key.to_string(), *value))","+        .collect()","+}","+","+#[test]","+fn approves_a_workspace_project_by_its_dependency_path() {","+    let workspace = Workspace::with_project(\"lib\");","+    let lib = workspace.file_key(\"packages/lib\");","+    let lockfile = Workspace::lockfile(&[(&lib, \"../packages/lib\")]);","+","+    let allow_builds = workspace.approve(&[(\"lib\", true)], &lockfile);","+","+    assert_eq!(allow_builds, approvals(&[(\"lib\", true), (&lib, true)]));","+}","+","+#[test]","+fn does_not_approve_a_directory_that_is_not_a_workspace_project() {","+    let workspace = Workspace::with_project(\"lib\");","+    let vendored = workspace.file_key(\"vendor/lib\");","+    let lockfile = Workspace::lockfile(&[(&vendored, \"../vendor/lib\")]);","+","+    assert_eq!(workspace.approve(&[], &lockfile), approvals(&[]));","+}","+","+#[test]","+fn does_not_approve_a_project_key_that_resolves_to_another_directory() {","+    let workspace = Workspace::with_project(\"lib\");","+    let lib = workspace.file_key(\"packages/lib\");","+    let lockfile = Workspace::lockfile(&[(&lib, \"../vendor/lib\")]);","+","+    assert_eq!(workspace.approve(&[], &lockfile), approvals(&[]));","+}","+","+#[test]","+fn keeps_a_denial_of_a_workspace_project() {","+    let workspace = Workspace::with_project(\"lib\");","+    let lib = workspace.file_key(\"packages/lib\");","+    let lockfile = Workspace::lockfile(&[(&lib, \"../packages/lib\")]);","+","+    let allow_builds = workspace.approve(&[(\"lib\", false)], &lockfile);","+","+    assert_eq!(allow_builds, approvals(&[(\"lib\", false)]));","+}","+","+#[test]","+fn keeps_a_denial_of_the_key_the_source_workspace_gives_a_project() {","+    let workspace = Workspace::with_project(\"lib\");","+    let lib = workspace.file_key(\"packages/lib\");","+    let lockfile = Workspace::lockfile(&[(&lib, \"../packages/lib\")]);","+","+    let allow_builds = workspace.approve(&[(\"lib@file:packages/lib\", false)], &lockfile);","+","+    assert_eq!(allow_builds, approvals(&[(\"lib@file:packages/lib\", false)]));","+}","+","+#[test]","+fn keeps_a_source_workspace_denial_of_a_legacy_workspace_project() {","+    let workspace = Workspace::with_project(\"lib\");","+    let workspace_projects = [NamedProjectRoot {","+        name: \"lib\".to_string(),","+        root_dir: workspace.root.join(\"packages/lib\"),","+    }];","+    let mut allow_builds = approvals(&[(\"lib@file:packages/lib\", false)]);","+","+    approve_legacy_workspace_project_builds(","+        &mut allow_builds,","+        &workspace_projects,","+        &workspace.deploy_dir,","+        &workspace.root,","+    )","+    .expect(\"approve legacy workspace project builds\");","+","+    assert_eq!(allow_builds, approvals(&[(\"lib@file:packages/lib\", false)]));","+}","+","+#[test]","+fn approves_a_legacy_workspace_project_relative_to_the_lockfile_dir() {","+    let workspace = Workspace::with_project(\"lib\");","+    let workspace_projects = [","+        NamedProjectRoot { name: \"lib\".to_string(), root_dir: workspace.root.join(\"packages/lib\") },","+        NamedProjectRoot {","+            name: \"denied\".to_string(),","+            root_dir: workspace.root.join(\"packages/denied\"),","+        },","+    ];","+    let mut allow_builds = approvals(&[(\"denied\", false)]);","+","+    approve_legacy_workspace_project_builds(","+        &mut allow_builds,","+        &workspace_projects,","+        &workspace.root,","+        &workspace.root,","+    )","+    .expect(\"approve legacy workspace project builds\");","+","+    assert_eq!(allow_builds, approvals(&[(\"denied\", false), (\"lib@file:packages/lib\", true)]));","+}","+","+#[cfg(unix)]","+#[test]","+fn does_not_approve_a_directory_whose_name_only_prints_like_a_project_root() {","+    use std::{ffi::OsStr, os::unix::ffi::OsStrExt};","+","+    let workspace = Workspace::with_project(\"lib\");","+    let project_root = workspace.root.join(OsStr::from_bytes(b\"lib\\xff\"));","+    let mut projects_by_path = HashMap::new();","+    projects_by_path.insert(","+        ProjectPathKey::new(&project_root),","+        ProjectInfo {","+            root_dir: project_root,","+            name: Some(\"lib\".to_string()),","+            has_bin: false,","+            peer_dependencies: Vec::new(),","+            peer_blocks: (None, None),","+            declared_dependencies: HashSet::default(),","+        },","+    );","+    let workspace = Workspace { projects_by_path, ..workspace };","+    let look_alike = workspace.file_key(\"lib\\u{FFFD}\");","+    let lockfile = Workspace::lockfile(&[(&look_alike, \"../lib\\u{FFFD}\")]);","+","+    assert_eq!(workspace.approve(&[], &lockfile), approvals(&[]));","+}"],"additions":209,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/deploy.rs","lines":["@@ -174,6 +174,7 @@ fn deployed_project_passes_dependency_verification() {","             \"packages\": [\".\"],","             \"peersSuffixMaxLength\": 42,","             \"virtualStoreType\": \"project\",","+            \"allowBuilds\": { workspace_project_key(&workspace, \"lib\"): true },","         }),","     );","     pacquet_cmd(&deploy_dir)","@@ -310,9 +311,13 @@ fn deploy_writes_dependencies_and_allow_builds_sorted_by_name() {","         .as_object()","         .unwrap()","         .keys()","-        .map(String::as_str)","+        .cloned()","+        .collect::<Vec<_>>();","+    let expected_names = lib_names","+        .iter()","+        .flat_map(|name| [name.to_string(), workspace_project_key(&workspace, name)])","         .collect::<Vec<_>>();","-    assert_eq!(allowed_names, lib_names);","+    assert_eq!(allowed_names, expected_names);"," ","     drop((root, mock_instance));"," }","@@ -804,6 +809,14 @@ fn assert_workspace_lockfile_untouched(workspace: &Path, before: &str) {","     assert_eq!(after, before, \"deploy must not rewrite the workspace lockfile\");"," }"," ","+/// The `allowBuilds` key a shared-lockfile deploy writes for the workspace","+/// project in `packages/<dirname>`.","+fn workspace_project_key(workspace: &Path, dirname: &str) -> String {","+    let workspace = dunce::canonicalize(workspace).unwrap();","+    let url = url::Url::from_file_path(workspace.join(\"packages\").join(dirname)).unwrap();","+    format!(\"{dirname}@{url}\")","+}","+"," fn pacquet_cmd(workspace: &Path) -> Command {","     Command::cargo_bin(\"pnpm\").expect(\"find the pnpm binary\").with_current_dir(workspace)"," }","@@ -1147,3 +1160,5 @@ mod local_dependencies;"," mod self_containment;"," "," mod reproducible;","+","+mod workspace_project_builds;"],"additions":17,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/deploy/workspace_project_builds.rs","lines":["@@ -0,0 +1,90 @@","+use super::{","+    AddMockedRegistry, CommandExtra, CommandTempCwd, append_workspace_yaml_key, fs, pacquet_cmd,","+    write_project,","+};","+use assert_cmd::assert::OutputAssertExt;","+use std::path::Path;","+","+const BUILD_SCRIPT: &str = r#\"node -e \"require('fs').writeFileSync('built.txt', '1')\"\"#;","+","+fn write_workspace_with_built_lib(workspace: &Path) {","+    append_workspace_yaml_key(workspace, \"packages\", \"\\n  - packages/*\");","+    write_project(","+        workspace,","+        \"app\",","+        &serde_json::json!({","+            \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"lib\": \"workspace:*\" },","+        }),","+    );","+    write_project(","+        workspace,","+        \"lib\",","+        &serde_json::json!({","+            \"name\": \"lib\", \"version\": \"1.0.0\", \"scripts\": { \"postinstall\": BUILD_SCRIPT },","+        }),","+    );","+}","+","+/// The source install runs the project's build, and the deploy copies the","+/// project's files, so the output is removed to observe the deploy's build.","+fn remove_source_build_output(workspace: &Path) {","+    fs::remove_file(workspace.join(\"packages/lib/built.txt\")).unwrap();","+}","+","+#[test]","+fn deploy_builds_a_workspace_project_it_converts_to_a_file_dependency() {","+    for deploy_args in","+        [[\"--config.node-linker=isolated\"], [\"--config.node-linker=hoisted\"], [\"--legacy\"]]","+    {","+        let CommandTempCwd { root, workspace, npmrc_info, .. } =","+            CommandTempCwd::init().add_mocked_registry();","+        let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+        write_workspace_with_built_lib(&workspace);","+","+        pacquet_cmd(&workspace)","+            .with_arg(\"install\")","+            .assert()","+            .success();","+        remove_source_build_output(&workspace);","+        pacquet_cmd(&workspace)","+            .with_args([\"--filter\", \"app\", \"deploy\", \"--prod\"])","+            .with_args(deploy_args)","+            .with_arg(\"out\")","+            .assert()","+            .success();","+","+        assert!(","+            workspace.join(\"out/node_modules/lib/built.txt\").exists(),","+            \"the deployed workspace project should run its build with {deploy_args:?}\",","+        );","+        drop((root, mock_instance));","+    }","+}","+","+#[test]","+fn deploy_keeps_an_explicit_denial_of_a_workspace_project_build() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace_with_built_lib(&workspace);","+    append_workspace_yaml_key(&workspace, \"allowBuilds\", \"{ lib: false }\");","+","+    pacquet_cmd(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    remove_source_build_output(&workspace);","+    pacquet_cmd(&workspace)","+        .with_args([\"--filter\", \"app\", \"deploy\", \"--prod\", \"out\"])","+        .assert()","+        .success();","+","+    assert!(!workspace.join(\"out/node_modules/lib/built.txt\").exists());","+    let deployed_workspace_manifest =","+        fs::read_to_string(workspace.join(\"out/pnpm-workspace.yaml\")).unwrap();","+    assert!(","+        !deployed_workspace_manifest.contains(\"lib@file:\"),","+        \"a denied project must not be approved by its dependency path:\\n{deployed_workspace_manifest}\",","+    );","+    drop((root, mock_instance));","+}"],"additions":90,"deletions":0,"truncated":false},{"path":"pnpm/docs/cli/deploy.md","lines":["@@ -104,6 +104,10 @@ Since v12.16.0, it checks the source workspace lockfile against [`minimumRelease","   resolved against the deploy directory. With the global virtual store enabled","   or an absolute `virtualStoreDir`, it stays at `node_modules/.pnpm`."," * The `prepare` script of the deployed project is not run.","+* A workspace project that the deploy installs as a `file:` dependency runs","+  its build scripts. pnpm approves it by its dependency path in the","+  [`allowBuilds`](../settings/build.md#allowbuilds) setting. An `allowBuilds`","+  entry that denies the project still applies."," "," ## Reproducible output"," "],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm11/docs/cli/deploy.md","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":515,"deletions":27,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-06T17:00:26.648487+00:00"}