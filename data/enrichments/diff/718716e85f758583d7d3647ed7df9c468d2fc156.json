"+\t\t\t\t\tinput_sel.set_index(i, vector_rows - i - 1);","+\t\t\t\t\tconst auto row = mapped ? input_sel.get_index(i) : i;","+\t\t\t\t\tif (filter.LookupOne(hashes.GetValue(row).GetValue<hash_t>())) {","+\t\t\t\t\t\texpected.push_back(i);","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tconst auto found_count = mapped ? filter.LookupHashes(hashes, input_sel, result_sel, count)","+\t\t\t\t                                : filter.LookupHashes(hashes, result_sel, count);","+\t\t\t\tREQUIRE(found_count == expected.size());","+\t\t\t\tfor (idx_t i = 0; i < found_count; i++) {","+\t\t\t\t\tREQUIRE(result_sel.get_index(i) == expected[i]);","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"test/sql/filter/CMakeLists.txt","lines":["@@ -1,4 +1,4 @@","-add_library_unity(test_filter OBJECT filter_cache.cpp","+add_library_unity(test_filter OBJECT bloom_filter_lookup.cpp filter_cache.cpp","                   prefix_range_filter_lookup.cpp)"," set(UNITTEST_OBJECT_FILES","     ${UNITTEST_OBJECT_FILES} $<TARGET_OBJECTS:test_filter>"],"additions":1,"deletions":1,"truncated":false},{"path":"test/sql/filter/bloom_filter_lookup.cpp","lines":["@@ -0,0 +1,92 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+","+#include \"duckdb/common/vector_operations/vector_operations.hpp\"","+#include \"duckdb/execution/expression_executor.hpp\"","+#include \"duckdb/planner/expression/bound_function_expression.hpp\"","+#include \"duckdb/planner/expression/bound_reference_expression.hpp\"","+#include \"duckdb/planner/filter/table_filter_functions.hpp\"","+","+using namespace duckdb;","+","+TEST_CASE(\"Bloom filter selection preserves NULL policy and mapped rows\", \"[filter][bloom_filter]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto &context = *con.context;","+","+\tVector build_keys(LogicalType::BIGINT, 2);","+\tbuild_keys.SetValue(0, Value(LogicalType::BIGINT));","+\tbuild_keys.SetValue(1, Value::BIGINT(11));","+\tFlatVector::SetSize(build_keys, count_t(2));","+\tVector hashes(LogicalType::HASH, 2);","+\tVectorOperations::Hash(build_keys, hashes, 2);","+\tconst vector<Value> values = {Value::BIGINT(11), Value(LogicalType::BIGINT), Value::BIGINT(22),","+\t                              Value::BIGINT(11), Value(LogicalType::BIGINT), Value::BIGINT(22),","+\t                              Value::BIGINT(11), Value::BIGINT(22)};","+\tconst auto count = values.size();","+\tVector keys(LogicalType::BIGINT, count);","+\tfor (idx_t i = 0; i < count; i++) {","+\t\tkeys.SetValue(i, values[i]);","+\t}","+\tFlatVector::SetSize(keys, count_t(count));","+\tSelectionVector dictionary_sel(count);","+\tSelectionVector input_sel(count);","+\tfor (idx_t i = 0; i < count; i++) {","+\t\tdictionary_sel.set_index(i, (3 * i + 1) % count);","+\t\tinput_sel.set_index(i, count - i - 1);","+\t}","+","+\tfor (bool contains_null_hash : {false, true}) {","+\t\tauto filter = make_shared_ptr<BloomFilter>();","+\t\tfilter->Initialize(context, 2);","+\t\tSelectionVector build_sel(2);","+\t\tbuild_sel.set_index(0, 1);","+\t\tbuild_sel.set_index(1, 0);","+\t\t// With the NULL hash present, only the explicit NULL policy can reject it.","+\t\tfilter->InsertHashes(hashes, build_sel, contains_null_hash ? 2 : 1);","+\t\tfilter->Seal(context);","+\t\tREQUIRE(filter->LookupOne(hashes.GetValue(0).GetValue<hash_t>()) == contains_null_hash);","+\t\tREQUIRE_FALSE(filter->LookupOne(Hash(int64_t(22))));","+","+\t\tfor (bool filters_null_values : {false, true}) {","+\t\t\tvector<unique_ptr<Expression>> children;","+\t\t\tchildren.push_back(make_uniq<BoundReferenceExpression>(LogicalType::BIGINT, 0ULL));","+\t\t\tBoundFunctionExpression expr(","+\t\t\t    BoundScalarFunction(BloomFilterScalarFun::GetFunction(LogicalType::BIGINT)), std::move(children),","+\t\t\t    make_uniq<BloomFilterFunctionData>(filter, filters_null_values, \"k\", LogicalType::BIGINT, 0.0f, 0ULL));","+\t\t\tExpressionExecutor executor(context, expr);","+","+\t\t\tfor (bool dictionary : {false, true}) {","+\t\t\t\tDataChunk input;","+\t\t\t\tinput.Initialize(context, {LogicalType::BIGINT}, count);","+\t\t\t\tif (dictionary) {","+\t\t\t\t\tinput.data[0].Slice(keys, dictionary_sel, count);","+\t\t\t\t} else {","+\t\t\t\t\tinput.data[0].Reference(keys);","+\t\t\t\t}","+\t\t\t\tinput.CheckCardinality(count);","+","+\t\t\t\tfor (bool mapped : {false, true}) {","+\t\t\t\t\tCAPTURE(contains_null_hash, filters_null_values, dictionary, mapped);","+\t\t\t\t\tvector<idx_t> expected_true, expected_false;","+\t\t\t\t\tfor (idx_t i = 0; i < count; i++) {","+\t\t\t\t\t\tconst auto row = mapped ? input_sel.get_index(i) : i;","+\t\t\t\t\t\tconst auto value = input.GetValue(0, row);","+\t\t\t\t\t\tconst auto passed = value.IsNull() ? !filters_null_values : value.GetValue<int64_t>() == 11;","+\t\t\t\t\t\t(passed ? expected_true : expected_false).push_back(row);","+\t\t\t\t\t}","+\t\t\t\t\tSelectionVector true_sel(count), false_sel(count);","+\t\t\t\t\tconst auto true_count =","+\t\t\t\t\t    executor.SelectExpression(input, &true_sel, &false_sel, mapped ? &input_sel : nullptr, count);","+\t\t\t\t\tREQUIRE(true_count == expected_true.size());","+\t\t\t\t\tfor (idx_t i = 0; i < true_count; i++) {","+\t\t\t\t\t\tREQUIRE(true_sel.get_index(i) == expected_true[i]);","+\t\t\t\t\t}","+\t\t\t\t\tfor (idx_t i = 0; i < count - true_count; i++) {","+\t\t\t\t\t\tREQUIRE(false_sel.get_index(i) == expected_false[i]);","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":92,"deletions":0,"truncated":false},{"path":"test/sql/filter/prefix_range_filter_lookup.cpp","lines":["@@ -1,6 +1,7 @@"," #include \"catch.hpp\""," #include \"test_helpers.hpp\""," ","+#include \"duckdb/common/limits.hpp\""," #include \"duckdb/common/vector/flat_vector.hpp\""," #include \"duckdb/planner/expression/bound_function_expression.hpp\""," #include \"duckdb/planner/expression/bound_reference_expression.hpp\"","@@ -128,3 +129,166 @@ TEST_CASE(\"Prefix range filter prune handles all-NULL and missing statistics\", \""," \tauto no_build = make_expr(uninitialized.get(), true);"," \tREQUIRE(prune(*no_build, &all_null) == FilterPropagateResult::NO_PRUNING_POSSIBLE);"," }","+","+static void TestStagedPrefixRangeLookup(ClientContext &context, const vector<Value> &build_values,","+                                        const vector<pair<Value, bool>> &candidates, idx_t max_bits) {","+\tconst auto &type = build_values.front().type();","+\tVector build_keys(type, build_values.size());","+\tfor (idx_t i = 0; i < build_values.size(); i++) {","+\t\tbuild_keys.SetValue(i, build_values[i]);","+\t}","+\tFlatVector::SetSize(build_keys, count_t(build_values.size()));","+\tauto filter = PrefixRangeFilter::CreatePrefixRangeFilter(type);","+\tfilter->Initialize(context, build_values.size(), build_values.front(), build_values.back(), max_bits);","+\tREQUIRE(filter->GetBuildStateSize() >= 2 * 1024 * 1024);","+\tauto build_state = filter->InitializeBuildState(context);","+\tfilter->InsertKeys(build_keys, *build_state);","+\tfilter->MergeBuildState(*build_state);","+","+\tfor (idx_t count : {idx_t(0), idx_t(1), idx_t(127), idx_t(128), idx_t(129), idx_t(STANDARD_VECTOR_SIZE),","+\t                    idx_t(STANDARD_VECTOR_SIZE + 17)}) {","+\t\tfor (bool has_nulls : {false, true}) {","+\t\t\tfor (bool dictionary : {false, true}) {","+\t\t\t\tfor (bool mapped : {false, true}) {","+\t\t\t\t\tCAPTURE(type, count, has_nulls, dictionary, mapped);","+\t\t\t\t\tconst auto vector_rows = count + 19;","+\t\t\t\t\tVector source(type, vector_rows);","+\t\t\t\t\tfor (idx_t i = 0; i < vector_rows; i++) {","+\t\t\t\t\t\tsource.SetValue(i, has_nulls && i % 8 == 7 ? Value(type)","+\t\t\t\t\t\t                                           : candidates[i % candidates.size()].first);","+\t\t\t\t\t}","+\t\t\t\t\tif (count >= 128) {","+\t\t\t\t\t\t// Ensure the sampled rows span both ends of the sparse bitmap.","+\t\t\t\t\t\tconst auto step = count / 16;","+\t\t\t\t\t\tsource.SetValue(dictionary != mapped ? vector_rows - 1 : 0, build_values.front());","+\t\t\t\t\t\tsource.SetValue(dictionary != mapped ? vector_rows - 1 - step : step, build_values.back());","+\t\t\t\t\t}","+\t\t\t\t\tFlatVector::SetSize(source, count_t(vector_rows));","+\t\t\t\t\tSelectionVector dictionary_sel(vector_rows), input_sel(count), result_sel(count);","+\t\t\t\t\tfor (idx_t i = 0; i < vector_rows; i++) {","+\t\t\t\t\t\tdictionary_sel.set_index(i, vector_rows - i - 1);","+\t\t\t\t\t}","+\t\t\t\t\tVector keys(type);","+\t\t\t\t\tif (dictionary) {","+\t\t\t\t\t\tkeys.Slice(source, dictionary_sel, vector_rows);","+\t\t\t\t\t} else {","+\t\t\t\t\t\tkeys.Reference(source);","+\t\t\t\t\t}","+","+\t\t\t\t\tvector<idx_t> expected;","+\t\t\t\t\tfor (idx_t i = 0; i < count; i++) {","+\t\t\t\t\t\tinput_sel.set_index(i, vector_rows - i - 1);","+\t\t\t\t\t\tconst auto row = mapped ? input_sel.get_index(i) : i;","+\t\t\t\t\t\tconst auto value = keys.GetValue(row);","+\t\t\t\t\t\tif (value.IsNull()) {","+\t\t\t\t\t\t\tcontinue;","+\t\t\t\t\t\t}","+\t\t\t\t\t\tfor (const auto &candidate : candidates) {","+\t\t\t\t\t\t\tif (candidate.second && value == candidate.first) {","+\t\t\t\t\t\t\t\texpected.push_back(i);","+\t\t\t\t\t\t\t\tbreak;","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t\tconst auto found_count = mapped ? filter->LookupKeys(keys, input_sel, result_sel, count)","+\t\t\t\t\t                                : filter->LookupKeys(keys, result_sel, count);","+\t\t\t\t\tREQUIRE(found_count == expected.size());","+\t\t\t\t\tfor (idx_t i = 0; i < found_count; i++) {","+\t\t\t\t\t\tREQUIRE(result_sel.get_index(i) == expected[i]);","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}","+","+TEST_CASE(\"Prefix range staged lookup preserves validity and local positions\", \"[filter][prefix_range]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tconstexpr int64_t MIN_KEY = -5;","+\tconstexpr int64_t MAX_KEY = MIN_KEY + (1 << 24) - 1;","+\tconstexpr int64_t MID_KEY = MIN_KEY + (1 << 23);","+","+\tfor (const auto &type : {LogicalType::BIGINT, LogicalType::INTEGER}) {","+\t\tauto value = [&](int64_t key) {","+\t\t\treturn Value::BIGINT(key).DefaultCastAs(type);","+\t\t};","+\t\tTestStagedPrefixRangeLookup(*con.context, {value(MIN_KEY), value(MID_KEY), value(MAX_KEY)},","+\t\t                            {{value(MIN_KEY), true},","+\t\t                             {value(MAX_KEY), true},","+\t\t                             {value(MIN_KEY + 1), false},","+\t\t                             {value(MAX_KEY - 1), false},","+\t\t                             {value(MIN_KEY - 1), false},","+\t\t                             {value(MAX_KEY + 1), false},","+\t\t                             {value(MID_KEY), true}},","+\t\t                            1ULL << 24);","+\t}","+}","+","+TEST_CASE(\"Prefix range staged lookup handles unsigned bounds\", \"[filter][prefix_range]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tconstexpr uint64_t MAX_KEY = NumericLimits<uint64_t>::Maximum() - 1;","+\tconstexpr uint64_t MIN_KEY = MAX_KEY - (1ULL << 24) + 1;","+\tconstexpr uint64_t MID_KEY = MIN_KEY + (1ULL << 23);","+\tauto value = [](uint64_t key) {","+\t\treturn Value::UBIGINT(key);","+\t};","+\tTestStagedPrefixRangeLookup(*con.context, {value(MIN_KEY), value(MID_KEY), value(MAX_KEY)},","+\t                            {{value(MIN_KEY), true},","+\t                             {value(MAX_KEY), true},","+\t                             {value(MIN_KEY + 1), false},","+\t                             {value(MAX_KEY - 1), false},","+\t                             {value(MIN_KEY - 1), false},","+\t                             {value(MAX_KEY + 1), false},","+\t                             {value(MID_KEY), true},","+\t                             {value(0), false}},","+\t                            1ULL << 24);","+}","+","+TEST_CASE(\"Prefix range staged lookup handles coarsened buckets\", \"[filter][prefix_range]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tconstexpr int64_t MIN_KEY = -5;","+\tconstexpr int64_t MAX_KEY = MIN_KEY + (1 << 26) - 1;","+\tconstexpr int64_t MID_KEY = MIN_KEY + (1 << 25);","+\tauto value = [](int64_t key) {","+\t\treturn Value::BIGINT(key);","+\t};","+\t// Four adjacent keys share a bit: collisions may match, but out-of-range keys must not.","+\tTestStagedPrefixRangeLookup(*con.context, {value(MIN_KEY), value(MID_KEY), value(MAX_KEY)},","+\t                            {{value(MIN_KEY), true},","+\t                             {value(MAX_KEY), true},","+\t                             {value(MID_KEY), true},","+\t                             {value(MIN_KEY + 3), true},","+\t                             {value(MIN_KEY + 4), false},","+\t                             {value(MID_KEY - 1), false},","+\t                             {value(MID_KEY + 3), true},","+\t                             {value(MID_KEY + 4), false},","+\t                             {value(MAX_KEY - 3), true},","+\t                             {value(MAX_KEY - 4), false},","+\t                             {value(MIN_KEY - 1), false},","+\t                             {value(MAX_KEY + 1), false}},","+\t                            1ULL << 24);","+}","+","+TEST_CASE(\"Prefix range staged lookup handles string prefixes\", \"[filter][prefix_range]\") {","+\tif (!PrefixRangeFilter::SupportedType(LogicalType::VARCHAR)) {","+\t\treturn;","+\t}","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\t// Suffixes beyond the four-byte prefix do not affect bitmap membership.","+\tTestStagedPrefixRangeLookup(*con.context, {Value(\"a\"), Value(\"amiddle-key-is-long\"), Value(\"b\")},","+\t                            {{Value(\"a\"), true},","+\t                             {Value(\"b\"), true},","+\t                             {Value(\"amiddle-key-is-long\"), true},","+\t                             {Value(\"amid-other\"), true},","+\t                             {Value(string(\"a\\0\\0\\0suffix\", 10)), true},","+\t                             {Value(\"aardvark\"), false},","+\t                             {Value(\"amie\"), false},","+\t                             {Value(\"beyond\"), false},","+\t                             {Value(string(\"a\\0\\0\\1\", 4)), false},","+\t                             {Value(\"\"), false}},","+\t                            1ULL << 25);","+}",""],"additions":164,"deletions":0,"truncated":false}],"additions":466,"deletions":21,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-28T14:43:45.621329+00:00"}