,"+   * latest merged file slice of the located file group, so that its matched clauses see the fields of the target","+   * table. A record the clauses update is replaced with its new version and a record they delete with a delete","+   * record, both at the location and row position the index tagged, and a record none of them accepts is dropped.","+   * A record whose location holds no live record with its key, as a deleted copy in a base file or the bucket of a","+   * bucket index can get it tagged, is replaced with what its not-matched clauses make of it at the same location,","+   * and dropped when none of them accepts it or the write does not order records by commit time. The records of any","+   * other write are returned as they are.","+   */","+  public static <R> HoodieData<HoodieRecord<R>> mergeLocatedExpressionPayloadRecords(HoodieData<HoodieRecord<R>> taggedRecords,","+                                                                                     HoodieWriteConfig config,","+                                                                                     HoodieTable hoodieTable,","+                                                                                     int parallelism) {","+    if (!EXPRESSION_PAYLOAD_CLASS_NAME.equals(config.getPayloadClass())) {","+      return taggedRecords;","+    }","+    HoodieReaderContext<R> readerContext = ((ReaderContextFactory<R>) hoodieTable.getContext()","+        .getReaderContextFactoryForWrite(hoodieTable.getMetaClient(), config.getRecordMerger().getRecordType(), config.getProps())).getContext();","+    readerContext.initRecordMergerForIngestion(config.getProps());","+    HoodieSchema writerSchema = HoodieSchema.parse(config.getWriteSchema());","+    ExistingRecordMerger<R> merger = new ExistingRecordMerger<>(config, hoodieTable, readerContext, writerSchema);","+    TypedProperties notMatchedProps = TypedProperties.copy(config.getProps());","+    notMatchedProps.setProperty(HoodiePayloadProps.PAYLOAD_IS_UPDATE_RECORD_FOR_MOR, \"false\");","+    HoodieData<HoodieRecord<R>> locatedRecords = taggedRecords.filter(HoodieIndexUtils::isLocatedExpressionPayloadRecord);","+    HoodieData<Pair<Pair<String, String>, Option<Set<String>>>> locationsAndKeys = locatedRecords","+        .mapToPair(record -> {","+          Set<String> recordKeys = new HashSet<>();","+          recordKeys.add(record.getRecordKey());","+          return Pair.of(partitionPathAndFileId(record), recordKeys);","+        })","+        .reduceByKey((left, right) -> {","+          left.addAll(right);","+          return left;","+        }, parallelism)","+        .map(entry -> Pair.of(entry.getLeft(), Option.of(entry.getRight())));","+    HoodieData<HoodieRecord<R>> resolvedRecords = locatedRecords.mapToPair(record -> Pair.of(fileGroupAndRecordKey(record), record))","+        .groupByKey()","+        .leftOuterJoin(merger.getExistingRecords(locationsAndKeys, hoodieTable)","+            .mapToPair(record -> Pair.of(fileGroupAndRecordKey(record), record)).groupByKey())","+        .values()","+        .flatMap(entry -> pairWithExistingRecords(entry.getLeft(), entry.getRight()).iterator())","+        .flatMap(entry -> {","+          HoodieRecord<R> incoming = entry.getLeft();","+          if (!entry.getRight().isPresent()) {","+            if (config.getRecordMergeMode() != RecordMergeMode.COMMIT_TIME_ORDERING) {","+              // An insert at the location could lose to the deleted copy of the key the location holds","+              return Collections.emptyIterator();","+            }","+            Option<IndexedRecord> inserted = ((HoodieRecordPayload<?>) incoming.getData()).getInsertValue(writerSchema.toAvroSchema(), notMatchedProps);","+            if (!inserted.isPresent() || inserted.get().equals(HoodieRecord.SENTINEL)) {","+              return Collections.emptyIterator();","+            }","+            HoodieRecord<R> insertRecord = (HoodieRecord<R>) new HoodieAvroIndexedRecord(incoming.getKey(), inserted.get());","+            return Collections.singletonList(tagRecord(insertRecord, incoming.getCurrentLocation())).iterator();","+          }","+          Option<HoodieRecord<R>> mergedOpt = merger.merge(incoming, entry.getRight().get());","+          if (mergedOpt.isPresent() && mergedOpt.get().getData().equals(HoodieRecord.SENTINEL)) {","+            return Collections.emptyIterator();","+          }","+          HoodieRecord<R> resolved = mergedOpt.isPresent()","+              ? mergedOpt.get().newInstance(incoming.getKey()) : merger.createDelete(incoming, entry.getRight().get());","+          return Collections.singletonList(tagRecord(resolved, incoming.getCurrentLocation())).iterator();","+        });","+    return taggedRecords.filter(record -> !isLocatedExpressionPayloadRecord(record)).union(resolvedRecords);","+  }","+","+  /**","+   * Pairs the located records of one record key in one file group with the records the file group holds for the key.","+   * A file group can hold a key more than once, and an index that reads the base file locates the incoming record at","+   * each of its rows, so each such row is paired with the located record at its position. When the positions do not","+   * tell the rows apart, one located record is paired with one record of the key.","+   */","+  private static <R> List<Pair<HoodieRecord<R>, Option<HoodieRecord<R>>>> pairWithExistingRecords(","+      Iterable<HoodieRecord<R>> locatedRecords, Option<Iterable<HoodieRecord<R>>> existingRecords) {","+    HoodieRecord<R> firstLocated = locatedRecords.iterator().next();","+    if (!existingRecords.isPresent()) {","+      return Collections.singletonList(Pair.of(firstLocated, Option.empty()));","+    }","+    Map<Long, HoodieRecord<R>> locatedByPosition = new HashMap<>();","+    for (HoodieRecord<R> located : locatedRecords) {","+      long position = located.getCurrentLocation().getPosition();","+      if (HoodieRecordLocation.isPositionValid(position)) {","+        lo