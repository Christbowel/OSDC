","+            const _: () = {","+                let (major, minor, patch) = UNICODE_VERSION;","+                let (major_, minor_, patch_) = $krate::UNICODE_VERSION;","+                if (","+                    major as u64 != major_ as u64 ||","+                    minor as u64 != minor_ as u64 ||","+                    patch as u64 != patch_ as u64","+                ) {","+                    panic!(","+                        concat!(","+                            stringify!($krate),","+                            \" does not have the correct Unicode version (`rustc_unicode::UNICODE_VERSION`)\"","+                        )","+                    )","+                }","+            };","+        )+","+    }","+}","+","+reexport_and_check!(","+    // tidy-alphabetical-start","+    unicode_ident,","+    unicode_normalization,","+    unicode_properties,","+    unicode_script,","+    unicode_security,","+    unicode_width,","+    // tidy-alphabetical-end","+);"],"additions":56,"deletions":0,"truncated":false},{"path":"src/bootstrap/src/core/builder/cli_paths/snapshots/x_bench.snap","lines":["@@ -97,6 +97,7 @@ expression: bench","     - Set({compiler/rustc_ty_walk})","     - Set({compiler/rustc_type_ir})","     - Set({compiler/rustc_type_ir_macros})","+    - Set({compiler/rustc_unicode})","     - Set({compiler/rustc_windows_rc})"," [Bench] test::CrateRustdoc","     targets: [x86_64-unknown-linux-gnu]"],"additions":1,"deletions":0,"truncated":false},{"path":"src/bootstrap/src/core/builder/cli_paths/snapshots/x_build_compiler.snap","lines":["@@ -79,6 +79,7 @@ expression: build compiler","     - Set({compiler/rustc_ty_walk})","     - Set({compiler/rustc_type_ir})","     - Set({compiler/rustc_type_ir_macros})","+    - Set({compiler/rustc_unicode})","     - Set({compiler/rustc_windows_rc})"," [Build] compile::Assemble","     targets: [x86_64-unknown-linux-gnu]"],"additions":1,"deletions":0,"truncated":false},{"path":"src/bootstrap/src/core/builder/cli_paths/snaps