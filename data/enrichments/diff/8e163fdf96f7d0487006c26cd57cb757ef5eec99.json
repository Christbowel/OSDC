ads limit on your current plan.',","+      );","+    });","+","+    it('falls back to the default message when the configured one is malformed', async () => {","+      withUploadsLimit({ max: 5 * MB, error: 'Uploads are capped at {{ max) }}' });","+      const { result } = renderHook(() => useKoenigFileUpload('file'));","+","+      const uploadResult = await act(","+        async () => await result.current.upload([makeFileOfSize('archive.zip', 6 * MB)]),","+      );","+","+      expect(uploadResult).toBeNull();","+      expect(posted()).toBe(false);","+      expect(result.current.isLoading).toBe(false);","+      expect(result.current.errors[0]?.message).toBe(","+        'This action would exceed the uploads limit on your current plan.',","+      );","+    });","+","+    it('reads the limit on the session-expiry policy the caller asked for', () => {","+      renderHook(() => useKoenigFileUpload('file', { sessionExpiryRedirect: false }));","+","+      expect(useHostLimits).toHaveBeenCalledWith({","+        requestOptions: { sessionExpiryRedirect: false },","+      });","+    });","+  });"," });",""],"additions":124,"deletions":0,"truncated":false}],"additions":213,"deletions":15,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-28T14:42:26.909291+00:00"}