{"id":"b96a68976c873764160ca12355a4e7999934d627","axis":"silent","repo":"vercel/turbo","sha":"b96a68976c873764160ca12355a4e7999934d627","parsed":{"files":[{"path":"Cargo.lock","lines":["@@ -8159,6 +8159,7 @@ dependencies = [","  \"turborepo-run-summary\",","  \"turborepo-scm\",","  \"turborepo-scope\",","+ \"turborepo-setup\",","  \"turborepo-shim\",","  \"turborepo-signals\",","  \"turborepo-task-access\","],"additions":1,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/cli/mod.rs","lines":["@@ -426,14 +426,6 @@ async fn run_main("," ","     let version = get_version();"," ","-    // Initialize telemetry immediately so events are captured from startup.","-    // The shared HTTP client is only activated if telemetry is actually","-    // enabled for this invocation.","-    let telemetry_handle = {","-        let _span = tracing::info_span!(\"telemetry_init\").entered();","-        initialize_deferred_telemetry_client(http_client.clone(), color_config, version)","-    };","-","     let mut command = get_command(&mut cli_args)?;"," ","     // Skip the standalone version banner when the command reports the version","@@ -484,6 +476,16 @@ async fn run_main(","     };"," ","     cli_args.command = Some(command);","+    // Also guard direct/wrapper --skip-infer paths before telemetry activation","+    // or agent-file maintenance; shim handoff validation is not sufficient.","+    if matches!(cli_args.command, Some(Command::Run { .. })) {","+        let base = CommandBase::new(cli_args.clone(), repo_root.clone(), version, color_config)?;","+        run::managed::select(&base)?;","+    }","+    let telemetry_handle = {","+        let _span = tracing::info_span!(\"telemetry_init\").entered();","+        initialize_deferred_telemetry_client(http_client.clone(), color_config, version)","+    };"," ","     maintain_agent_guidance(&repo_root, &cli_args, repo_state.is_some());"," "],"additions":10,"deletions":8,"truncated":false},{"path":"crates/turborepo-cli/src/commands/mod.rs","lines":["@@ -96,6 +96,7 @@ impl CommandBase {","             opts: self.opts.clone(),","             version: self.version,","             api_auth: self.api_auth()?,","+            managed_environment: None,","         })","     }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/run.rs","lines":["@@ -13,6 +13,8 @@ use turborepo_ui::{LogSinks, sender::UISender};"," "," use crate::commands::CommandBase;"," ","+pub(crate) mod managed;","+"," #[derive(Debug, PartialEq, Eq)]"," enum RunOutcome<T> {","     Completed(T),","@@ -56,6 +58,7 @@ pub async fn run(","     subscriber: &TurboSubscriber,","     verbosity: u8,"," ) -> Result<i32, run::Error> {","+    let managed = managed::select(&base)?;","     let signal = get_signal()?;","     let handler = SignalHandler::new(signal);"," ","@@ -101,7 +104,9 @@ pub async fn run("," ","     let mut run_builder = {","         let _span = tracing::info_span!(\"run_builder_new\").entered();","-        RunBuilder::new(base.run_builder_input()?, Some(http_client))?","+        let mut input = base.run_builder_input()?;","+        input.managed_environment = managed;","+        RunBuilder::new(input, Some(http_client))?","     };","     if let Some(qs) = query_server {","         run_builder = run_builder.with_query_server(qs);"],"additions":6,"deletions":1,"truncated":false},{"path":"crates/turborepo-cli/src/commands/run/managed.rs","lines":["@@ -0,0 +1,209 @@","+//! Exact-root strict activation for the Node/pnpm setup-to-run journey.","+//! No provisioning, HTTP, ancestor inventory search or process-global mutation.","+","+use std::{collections::BTreeSet, ffi::OsString, path::Path, sync::Arc};","+","+use turborepo_run::{EnvironmentVariableMap, ManagedEnvironment, ManagedRun};","+use turborepo_setup::execution_identity::{ExecutionContext, Libc};","+","+use crate::commands::setup::authorization::Authorization;","+","+pub(crate) fn select(","+    base: &crate::commands::CommandBase,","+) -> Result<Option<Arc<ManagedRun>>, turborepo_run::Error> {","+    if !base.opts.future_flags.experimental_setup {","+        return Ok(None);","+    }","+    // These initial managed adapters must not probe unprovisioned native tools.","+    let flags = &base.opts.future_flags;","+    for (enabled, marker) in [","+        (flags.experimental_cargo_workspaces, \"Cargo.toml\"),","+        (flags.experimental_python_workspaces, \"pyproject.toml\"),","+        (flags.experimental_go_workspaces, \"go.work\"),","+        (flags.experimental_go_workspaces, \"go.mod\"),","+    ] {","+        if enabled","+            && base.repo_root.join_component(marker).exists()","+            && std::fs::symlink_metadata(base.repo_root.join_component(\"turbo.lock\")).is_ok()","+        {","+            return Err(turborepo_run::Error::ManagedTools(","+                \"initial managed run supports Node/pnpm JS repositories only; use a supported \\","+                 setup adapter\"","+                    .into(),","+            ));","+        }","+    }","+    let user_base = dirs_next::data_local_dir().ok_or_else(|| {","+        turborepo_run::Error::ManagedTools(\"cannot locate setup user state directory\".into())","+    })?;","+    ManagedTools::inspect(","+        base.repo_root.as_std_path(),","+        base.opts.repo_opts.root_turbo_json_path.as_std_path(),","+        true,","+        &user_base,","+        context,","+    )","+    .map_err(turborepo_run::Error::ManagedTools)","+}","+","+pub(crate) struct ManagedTools {","+    authorization: Authorization,","+    inherited_path: Option<OsString>,","+    identity: String,","+}","+","+impl ManagedTools {","+    pub(crate) fn inspect(","+        root: &Path,","+        config: &Path,","+        enabled: bool,","+        user_base: &Path,","+        context: impl FnOnce() -> Result<ExecutionContext, String>,","+    ) -> Result<Option<Arc<ManagedRun>>, String> {","+        // A lock alone must never change unconfigured-repository behavior.","+        if !enabled {","+            return Ok(None);","+        }","+        match std::fs::symlink_metadata(root.join(\"turbo.lock\")) {","+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),","+            Err(error) => return Err(format!(\"cannot read turbo.lock; run turbo setup: {error}\")),","+            Ok(_) => {}","+        }","+        let canonical = root.canonicalize().map_err(|e| e.to_string())?;","+        if config","+            .parent()","+            .and_then(|p| p.canonicalize().ok())","+            .as_deref()","+            != Some(&canonical)","+            || !matches!(","+                config.file_name().and_then(|n| n.to_str()),","+                Some(\"turbo.json\" | \"turbo.jsonc\")","+            )","+        {","+            return Err(","+                \"managed run requires a root turbo.json or turbo.jsonc; run turbo setup\".into(),","+            );","+        }","+        let authorization =","+            Authorization::inspect(&canonical, user_base, context()?).map_err(|e| e.to_string())?;","+        let snapshot = authorization","+            .with_current(|p| p.snapshot().clone())","+            .map_err(|e| e.to_string())?;","+        let identity = snapshot.fingerprint().to_owned();","+        let tools = Arc::new(Self {","+            authorization,","+            inherited_path: std::env::var_os(\"PATH\"),","+            identity,","+        });","+        tools.revalidate()?;","+        Ok(Some(Arc::new(ManagedRun::new(snapshot, tools)?)))","+    }","+}","+","+impl ManagedEnvironment for ManagedTools {","+    fn revalidate(&self) -> Result<EnvironmentVariableMap, String> {","+        self.authorization","+            .with_current(|plan| {","+                let mut overrides = EnvironmentVariableMap::default();","+                let path = plan","+                    .path(self.inherited_path.as_deref())","+                    .map_err(|e| e.to_string())?;","+                overrides.insert(","+                    \"PATH\".into(),","+                    path.into_string().map_err(|_| {","+                        \"managed PATH is not UTF-8; run from a UTF-8 repository path\".to_owned()","+                    })?,","+                );","+                for (key, value) in plan.runtime_env() {","+                    overrides.insert(","+                        key.clone(),","+                        value","+                            .clone()","+                            .into_string()","+                            .map_err(|_| \"managed runtime variable is not UTF-8\".to_owned())?,","+                    );","+                }","+                Ok(overrides)","+            })","+            .map_err(|e| e.to_string())?","+    }","+","+    fn cache_identity(&self) -> &str {","+        &self.identity","+    }","+}","+","+fn qualified_libc(host: Option<turborepo_platform::Libc>) -> Result<Libc, String> {","+    match host {","+        Some(turborepo_platform::Libc::Glibc { version }) => Ok(Libc::Gnu { abi: version }),","+        None if cfg!(target_os = \"macos\") => Ok(Libc::None),","+        _ => Err(\"managed Node/pnpm run is unsupported on this host\".into()),","+    }","+}","+","+/// Conservative native execution identity. No readiness-only/unprobed labels.","+/// These initial adapters are supported only on native macOS and GNU Linux.","+pub(crate) fn context() -> Result<ExecutionContext, String> {","+    if !cfg!(any(target_os = \"macos\", target_os = \"linux\")) {","+        return Err(\"managed Node/pnpm run is unsupported on this host\".into());","+    }","+    // Released Linux binaries are musl-static; their target is not the host's","+    // execution ABI. Use the same bounded, non-executing detection as setup.","+    let libc = qualified_libc(turborepo_platform::host_libc().map_err(|e| e.to_string())?)?;","+    let mut cpu = BTreeSet::from([\"baseline\".into()]);","+    #[cfg(target_arch = \"x86_64\")]","+    for (name, detected) in [","+        (\"avx\", std::is_x86_feature_detected!(\"avx\")),","+        (\"avx2\", std::is_x86_feature_detected!(\"avx2\")),","+        (\"avx512f\", std::is_x86_feature_detected!(\"avx512f\")),","+        (\"sse4.2\", std::is_x86_feature_detected!(\"sse4.2\")),","+    ] {","+        if detected {","+            cpu.insert(name.into());","+        }","+    }","+    #[cfg(target_arch = \"aarch64\")]","+    for (name, detected) in [","+        (\"neon\", std::arch::is_aarch64_feature_detected!(\"neon\")),","+        (\"aes\", std::arch::is_aarch64_feature_detected!(\"aes\")),","+        (\"sve\", std::arch::is_aarch64_feature_detected!(\"sve\")),","+    ] {","+        if detected {","+            cpu.insert(name.into());","+        }","+    }","+    use sysinfo::SystemExt;","+    let system = sysinfo::System::new();","+    let release = system","+        .kernel_version()","+        .ok_or(\"cannot qualify managed host kernel\")?;","+    ExecutionContext::new(","+        turborepo_platform::Platform::current(),","+        libc,","+        format!(","+            \"{}-{}-{release}\",","+            std::env::consts::ARCH,","+            std::env::consts::OS","+        ),","+        cpu,","+    )","+    .map_err(|e| e.to_string())","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn managed_abi_uses_host_glibc_version_and_rejects_musl() {","+        assert_eq!(","+            qualified_libc(Some(turborepo_platform::Libc::Glibc {","+                version: \"2.39\".into(),","+            }))","+            .unwrap(),","+            Libc::Gnu { abi: \"2.39\".into() }","+        );","+        assert!(qualified_libc(Some(turborepo_platform::Libc::Musl)).is_err());","+        assert_eq!(qualified_libc(None).is_ok(), cfg!(target_os = \"macos\"));","+    }","+}"],"additions":209,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup.rs","lines":["@@ -250,7 +250,7 @@ fn run_with_policy(","     // Never claim dependencies are ready: they are skipped until dependency","     // policy and installers exist, even without --tools-only.","     println!(","-        \"Dependencies skipped ({}). No tasks run; managed activation is not enabled.\",","+        \"Dependencies skipped ({}). No tasks run.\",","         if request.tools_only {","             \"--tools-only\"","         } else {"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/managed_run_tests.rs","lines":["@@ -0,0 +1,308 @@","+use std::{path::Path, sync::Arc};","+","+use turborepo_run::{ManagedEnvironment, ManagedRun, builder::RunBuilder};","+use turborepo_signals::SignalHandler;","+use turborepo_telemetry::events::command::CommandEventBuilder;","+","+use super::*;","+use crate::commands::{","+    CommandBase,","+    run::managed::{self, ManagedTools},","+};","+","+fn select(f: &Fixture) -> Result<Option<Arc<ManagedRun>>, String> {","+    ManagedTools::inspect(","+        f.owned.root(),","+        &f.owned.root().join(\"turbo.json\"),","+        true,","+        f.owned.home(),","+        managed::context,","+    )","+}","+","+const NODE_RUNTIME: &str = \"#!/bin/sh\\nprintf '%s\\\\n' \\\"$0\\\" \\\"$PATH\\\" \\\"$TURBO_HASH\\\" \\\"$*\\\" \\","+                            \\\"${RUSTUP_TOOLCHAIN-unset}\\\" > managed-result\\n\";","+","+fn runnable() -> Fixture {","+    let mut f = Fixture::new();","+    f.declare(json!({\"name\":\"repo\",\"private\":true,\"packageManager\":\"pnpm@10.0.0\"}));","+    fs::write(","+        f.owned.root().join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - apps/*\\n\",","+    )","+    .unwrap();","+    fs::write(","+        f.owned.root().join(\"apps/web/package.json\"),","+        r#\"{\"name\":\"web\",\"scripts\":{\"build\":\"node -e 'throw new Error(\\\"not host node\\\")'\"}}\"#,","+    )","+    .unwrap();","+    fs::write(","+        f.owned.root().join(\"pnpm-lock.yaml\"),","+        \"lockfileVersion: '9.0'\\nimporters:\\n  .: {}\\n  apps/web: {}\\n\",","+    )","+    .unwrap();","+    fs::write(f.owned.root().join(\"turbo.json\"),","+        r#\"{\"futureFlags\":{\"experimentalSetup\":true},\"tasks\":{\"build\":{\"cache\":false}},\"noUpdateNotifier\":true}\"#).unwrap();","+    // Managed Node trap doubles as a harmless fixture runtime. pnpm's shim must","+    // dispatch through THIS executable; no host language runtime is required.","+    let prefix = f.lock[\"tools\"][\"node\"][\"installation\"][\"artifacts\"]","+        .as_object()","+        .unwrap()","+        .values()","+        .next()","+        .unwrap()[\"distribution\"][\"rootPrefix\"]","+        .as_str()","+        .unwrap();","+    f.node = archive(prefix, &[(\"bin/node\", NODE_RUNTIME)]);","+    let distribution = f.lock[\"tools\"][\"node\"][\"installation\"][\"artifacts\"]","+        .as_object_mut()","+        .unwrap()","+        .values_mut()","+        .next()","+        .unwrap();","+    distribution[\"distribution\"][\"sha256\"] = json!(format!(\"{:x}\", Sha256::digest(&f.node)));","+    f.save();","+    f","+}","+","+fn input(f: &Fixture, mode: &str) -> turborepo_run::RunBuilderInput {","+    let args = Args::parse_args(vec![","+        \"turbo\".into(),","+        \"run\".into(),","+        \"build\".into(),","+        \"--cwd\".into(),","+        f.owned.root().into(),","+        format!(\"--env-mode={mode}\").into(),","+        \"--ui=stream\".into(),","+        \"--cache=local:rw\".into(),","+    ])","+    .unwrap();","+    let root = turbopath::AbsoluteSystemPathBuf::try_from(f.owned.root()).unwrap();","+    let mut input = CommandBase::new(","+        args,","+        root,","+        \"managed-fixture\",","+        turborepo_ui::ColorConfig::new(true),","+    )","+    .unwrap()","+    .run_builder_input()","+    .unwrap();","+    // CI exports Remote Cache credentials; these fixtures must stay offline.","+    input.api_auth = None;","+    input","+}","+","+fn execute(f: &Fixture, mode: &str, tools: Arc<ManagedRun>) -> String {","+    tokio::runtime::Runtime::new().unwrap().block_on(async {","+        let handler = SignalHandler::new(futures::stream::pending());","+        let mut input = input(f, mode);","+        input.managed_environment = Some(tools);","+        let (run, analytics) = RunBuilder::new(input, None)","+            .unwrap()","+            .build(&handler, CommandEventBuilder::new(\"run\"))","+            .await","+            .unwrap();","+        assert!(analytics.is_none());","+        let result = run.run(None, false).await;","+        handler.close().await;","+        assert_eq!(result.unwrap(), 0);","+    });","+    fs::read_to_string(f.owned.root().join(\"apps/web/managed-result\")).unwrap()","+}","+","+#[test]","+fn setup_then_run_uses_managed_node_pnpm_in_strict_and_loose_modes() {","+    for mode in [\"strict\", \"loose\"] {","+        let f = runnable();","+        let u = Upstream::new(&f, false, None);","+        f.run(&u, FROZEN).unwrap();","+        let tools = select(&f).unwrap().unwrap();","+        let overrides = tools.revalidate().unwrap();","+        let first = std::env::split_paths(std::ffi::OsStr::new(&overrides[\"PATH\"]))","+            .next()","+            .unwrap();","+        assert!(first.starts_with(f.owned.root()));","+        let output = execute(&f, mode, tools);","+        let lines: Vec<_> = output.lines().collect();","+        assert_eq!(","+            Path::new(lines[0]).canonicalize().unwrap(),","+            first.join(\"node\").canonicalize().unwrap()","+        );","+        assert_eq!(","+            std::env::split_paths(std::ffi::OsStr::new(lines[1]))","+                .next()","+                .unwrap(),","+            first","+        );","+        assert!(!lines[2].is_empty());","+        assert!(lines[3].contains(\"pnpm.cjs run build\"));","+        if mode == \"strict\" {","+            assert_eq!(lines[4], \"unset\");","+        } else {","+            assert_eq!(","+                lines[4],","+                std::env::var(\"RUSTUP_TOOLCHAIN\").unwrap_or(\"unset\".into())","+            );","+        }","+        assert_eq!(u.hits(), 3);","+    }","+}","+","+#[test]","+fn actual_task_hashes_are_location_independent_and_bind_verified_artifact_identity() {","+    let mut hashes = vec![];","+    let mut identities = vec![];","+    for variant in [false, false, true] {","+        let mut f = runnable();","+        if variant {","+            let distribution = f.lock[\"tools\"][\"node\"][\"installation\"][\"artifacts\"]","+                .as_object_mut()","+                .unwrap()","+                .values_mut()","+                .next()","+                .unwrap();","+            let prefix = distribution[\"distribution\"][\"rootPrefix\"].as_str().unwrap();","+            f.node = archive(","+                prefix,","+                &[","+                    (\"bin/node\", NODE_RUNTIME),","+                    (\"resource\", \"different verified bytes\"),","+                ],","+            );","+            distribution[\"distribution\"][\"sha256\"] =","+                json!(format!(\"{:x}\", Sha256::digest(&f.node)));","+            f.save();","+        }","+        let u = Upstream::new(&f, false, None);","+        f.run(&u, FROZEN).unwrap();","+        let tools = select(&f).unwrap().unwrap();","+        identities.push(tools.cache_identity().to_owned());","+        hashes.push(","+            execute(&f, \"strict\", tools)","+                .lines()","+                .nth(2)","+                .unwrap()","+                .to_owned(),","+        );","+        assert_eq!(u.hits(), 3);","+    }","+    assert_eq!(identities[0], identities[1]);","+    assert_eq!(hashes[0], hashes[1]);","+    assert_ne!(identities[0], identities[2]);","+    assert_ne!(hashes[0], hashes[2]);","+}","+","+#[test]","+fn concrete_carrier_rejects_an_environment_for_a_different_snapshot() {","+    struct Wrong;","+    impl ManagedEnvironment for Wrong {","+        fn revalidate(&self) -> Result<turborepo_run::EnvironmentVariableMap, String> {","+            panic!(\"mismatched carrier must not use the environment\")","+        }","+        fn cache_identity(&self) -> &str {","+            \"wrong\"","+        }","+    }","+    let f = runnable();","+    let u = Upstream::new(&f, false, None);","+    f.run(&u, FROZEN).unwrap();","+    let tools = select(&f).unwrap().unwrap();","+    assert!(ManagedRun::new(tools.snapshot().clone(), Arc::new(Wrong)).is_err());","+    assert_eq!(u.hits(), 3);","+}","+","+#[test]","+fn declaration_drift_after_selection_fails_before_builder_work_or_task_dispatch() {","+    let f = runnable();","+    let u = Upstream::new(&f, false, None);","+    f.run(&u, FROZEN).unwrap();","+    let tools = select(&f).unwrap().unwrap();","+    fs::write(f.owned.root().join(\".nvmrc\"), \"26.0.0\").unwrap();","+    let error = tokio::runtime::Runtime::new().unwrap().block_on(async {","+        let handler = SignalHandler::new(futures::stream::pending());","+        let mut input = input(&f, \"strict\");","+        input.managed_environment = Some(tools);","+        let result = RunBuilder::new(input, None)","+            .unwrap()","+            .build(&handler, CommandEventBuilder::new(\"run\"))","+            .await;","+        handler.close().await;","+        match result {","+            Err(error) => error.to_string(),","+            Ok(_) => panic!(\"stale run succeeded\"),","+        }","+    });","+    assert!(error.contains(\"run turbo setup locally\"));","+    assert!(error.contains(\"commit the changed turbo.lock\"));","+    assert!(!f.owned.root().join(\"apps/web/managed-result\").exists());","+    assert_eq!(u.hits(), 3);","+}","+","+#[test]","+fn flag_and_exact_lock_root_gate_selection_without_ancestor_fallback_or_host_qualification() {","+    let f = Fixture::new();","+    let config = f.owned.root().join(\"turbo.json\");","+    assert!(","+        ManagedTools::inspect(f.owned.root(), &config, false, f.owned.home(), || panic!(","+            \"disabled repo probed host\"","+        ))","+        .unwrap()","+        .is_none()","+    );","+    let nested = f.owned.root().join(\"apps/web\");","+    assert!(","+        ManagedTools::inspect(","+            &nested,","+            &nested.join(\"turbo.json\"),","+            true,","+            f.owned.home(),","+            || panic!(\"missing exact-root lock probed host\")","+        )","+        .unwrap()","+        .is_none()","+    );","+    assert!(select(&f).is_err()); // Lock exists, but setup never prepared evidence.","+    assert!(!f.owned.home().join(\"turborepo\").exists());","+    assert!(!f.owned.root().join(\".turbo\").exists());","+    fs::write(","+        f.owned.root().join(\"Cargo.toml\"),","+        \"[workspace]\\nmembers = []\\n\",","+    )","+    .unwrap();","+    let mut opts = input(&f, \"strict\").opts;","+    opts.future_flags.experimental_cargo_workspaces = true;","+    let root = turbopath::AbsoluteSystemPathBuf::try_from(f.owned.root()).unwrap();","+    let base = CommandBase::from_opts(opts, root, \"fixture\", turborepo_ui::ColorConfig::new(true));","+    assert!(","+        managed::select(&base)","+            .err()","+            .unwrap()","+            .to_string()","+            .contains(\"Node/pnpm JS\")","+    );","+}","+","+#[test]","+fn managed_overrides_do_not_modify_host_environment_and_damage_never_falls_back() {","+    let f = runnable();","+    let u = Upstream::new(&f, false, None);","+    f.run(&u, FROZEN).unwrap();","+    let before: std::collections::BTreeMap<_, _> = std::env::vars_os().collect();","+    let tools = select(&f).unwrap().unwrap();","+    let environment = tools.revalidate().unwrap();","+    assert_eq!(environment.len(), 1); // PATH only; no unrelated host env exposed.","+    let current = turborepo_tool_install::Store::inspect(f.owned.root())","+        .unwrap()","+        .unwrap();","+    fs::remove_file(