.as_ref())","+    else {","+        return;","+    };","+    let used_entries = importers","+        .values()","+        .flat_map(|importer| {","+            importer.dependencies_by_groups([","+                DependencyGroup::Prod,","+                DependencyGroup::Dev,","+                DependencyGroup::Optional,","+            ])","+        })","+        .filter_map(|(alias, dependency)| {","+            let catalog_name = parse_catalog_protocol(&dependency.specifier)?;","+            let alias = alias.to_string();","+            let entry = previous_catalogs.get(catalog_name)?.get(&alias)?;","+            Some((catalog_name, alias, entry))","+        });","+    for (catalog_name, alias, entry) in used_entries {","+        lockfile.catalogs","+            .get_or_insert_default()","+            .entry(catalog_name.to_string())","+            .or_default()","+            .entry(alias)","+            .or_insert_with(|| entry.clone());","+    }","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/current_lockfile/tests/lockfile.rs","lines":["@@ -55,7 +55,7 @@ fn nested_importer_links_stay_shallow_and_snapshot_links_use_lockfile_base() {"," fn merge_filtered_wanted_lockfile_refreshes_all_importers_when_global_inputs_change() {","     let selected_id = \"packages/selected\".to_string();","     let retained_id = \"packages/retained\".to_string();","-    let removed_id = \"packages/removed\".to_string();","+    let missing_id = \"packages/missing\".to_string();","     let new_id = \"packages/new\".to_string();"," ","     let prior_retained = ProjectSnapshot {","@@ -63,6 +63,10 @@ fn merge_filtered_wanted_lockfile_refreshes_all_importers_when_global_inputs_cha","         dependencies: Some(importer_map(&[(\"retained\", \"1.0.0\"), (\"shared\", \"1.0.0\")])),","         ..Default::default()","     };","+    let prior_missing = ProjectSnapshot {","+        dependencies: Some(importer_map(&[(\"missing\", \"1.0.0\")])),","+     