yPolicy& retry_policy,","+         ProtobufMessage::ValidationVisitor& validation_visitor,","+         Server::Configuration::CommonFactoryContext& common_context) {","+    absl::Status creation_status = absl::OkStatus();","+    auto ret = std::shared_ptr<CustomTestRetryPolicy>(new CustomTestRetryPolicy(","+        retry_policy, validation_visitor, common_context, creation_status));","+    RETURN_IF_NOT_OK(creation_status);","+    return ret;","+  }","+","+  RetryStatePtr createRetryState(Http::RequestHeaderMap&, const Upstream::ClusterInfo&,","+                                 Server::Configuration::CommonFactoryContext&, Event::Dispatcher&,","+                                 Upstream::ResourcePriority,","+                                 OptRef<StreamInfo::StreamInfo> stream_info) const override {","+    last_stream_info_present_ = stream_info.has_value();","+    auto state = std::make_unique<NiceMock<MockRetryState>>();","+    ON_CALL(*state, enabled()).WillByDefault(Return(true));","+    return state;","+  }","+","+  mutable bool last_stream_info_present_{false};","+","+private:","+  using RetryPolicyImpl::RetryPolicyImpl;","+};","+","+class CustomTestRetryPolicyFactory : public RetryPolicyFactory {","+public:","+  absl::StatusOr<RetryPolicyConstSharedPtr>","+  createRetryPolicy(const Protobuf::Message& config,","+                    ProtobufMessage::ValidationVisitor& validation_visitor,","+                    Server::Configuration::CommonFactoryContext& context) override {","+    envoy::config::route::v3::RetryPolicy retry_policy;","+    retry_policy.mutable_num_retries()->set_value(7);","+    retry_policy.set_retry_on(\"5xx\");","+    // Ensure config was unpacked as expected.","+    EXPECT_EQ(config.GetTypeName(), \"google.protobuf.Struct\");","+    return CustomTestRetryPolicy::create(retry_policy, validation_visitor, context);","+  }","+","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<Envoy::Protobuf::Struct>();","+  }","+","+  std::string name() const override { return \"envoy.router.retry_policy.custom_test\"; }","+};","+","+TEST_F(RouteMatcherTest, RetryPolicyTypedConfigDefaultFactory) {","+  const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  retry_policy_typed_config:","+    \"@type\": type.googleapis.com/envoy.config.route.v3.RetryPolicy","+    num_retries: 3","+    per_try_timeout: 1s","+    retry_on: '5xx,gateway-error'","+  routes:","+  - match: {prefix: /typed_override}","+    route:","+      cluster: www","+      retry_policy_typed_config:","+        \"@type\": type.googleapis.com/envoy.config.route.v3.RetryPolicy","+        num_retries: 5","+        per_try_timeout: 2s","+        retry_on: connect-failure","+  - match: {prefix: /regular_override}","+    route:","+      cluster: www","+      retry_policy:","+        num_retries: 2","+        retry_on: reset","+  - match: {prefix: /inherit_vhost}","+    route: {cluster: www}","+  )EOF\";","+","+  factory_context_.cluster_manager_.initializeClusters({\"www\"}, {});","+  TestConfigImpl config(parseRouteConfigurationFromYaml(yaml), factory_context_, true,","+                        creation_status_);","+  ASSERT_TRUE(creation_status_.ok());","+","+  // Route-level retry_policy_typed_config overrides vhost retry_policy_typed_config.","+  const auto typed_override_policy =","+      config.route(genHeaders(\"www.lyft.com\", \"/typed_override\", \"GET\"), 0)","+          ->routeEntry()","+          ->retryPolicy();","+  EXPECT_EQ(std::chrono::milliseconds(2000), typed_override_policy->perTryTimeout());","+  EXPECT_EQ(5U, typed_override_policy->numRetries());","+  EXPECT_EQ(RetryPolicy::RETRY_ON_CONNECT_FAILURE, typed_override_policy->retryOn());","+","+  // Route-level retry_policy overrides vhost retry_policy_typed_config.","+  const auto regular_override_policy =","+      config.route(genHeaders(\"www.lyft.com\", \"/regular_override\", \"GET\"), 0)","+          ->routeEntry()","+          ->retryPolicy();","+  EXPECT_EQ(std::chrono::milliseconds(0), regular_override_policy->perTryTimeout());","+  EXPECT_EQ(2U, regular_override_policy->numRetries());","+  EXPECT_EQ(RetryPolicy::RETRY_ON_RESET, regular_override_policy->retryOn());","+","+  // Route without retry policy inherits vhost retry_policy_typed_config.","+  const auto vhost_policy = config.route(genHeaders(\"www.lyft.com\", \"/inherit_vhost\", \"GET\"), 0)","+                                ->routeEntry()","+                                ->retryPolicy();","+  EXPECT_EQ(std::chrono::milliseconds(1000), vhost_policy->perTryTimeout());","+  EXPECT_EQ(3U, vhost_policy->numRetries());","+  EXPECT_EQ(RetryPolicy::RETRY_ON_5XX | RetryPolicy::RETRY_ON_GATEWAY_ERROR,","+            vhost_policy->retryOn());","+}","+","+TEST_F(RouteMatcherTest, RetryPolicyTypedConfigCustomFactoryAndRetryState) {","+  const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  routes:","+  - match: {prefix: /custom}","+    route:","+      cluster: www","+      retry_policy_typed_config:","+        \"@type\": type.googleapis.com/google.protobuf.Struct","+  )EOF\";","+","+  CustomTestRetryPolicyFactory factory;","+  Registry::InjectFactory<RetryPolicyFactory> registered(factory);","+","+  factory_context_.cluster_manager_.initializeClusters({\"www\"}, {});","+  TestConfigImpl config(parseRouteConfigurationFromYaml(yaml), factory_context_, true,","+                        creation_status_);","+  ASSERT_TRUE(creation_status_.ok());","+","+  const auto policy =","+      config.route(genHeaders(\"www.lyft.com\", \"/custom\", \"GET\"), 0)->routeEntry()->retryPolicy();","+  EXPECT_EQ(7U, policy->numRetries());","+  EXPECT_EQ(RetryPolicy::RETRY_ON_5XX, policy->retryOn());","+","+  Http::TestRequestHeaderMapImpl headers;","+  NiceMock<Upstream::MockClusterInfo> cluster;","+  NiceMock<Event::MockDispatcher> dispatcher;","+  NiceMock<StreamInfo::MockStreamInfo> stream_info;","+  auto retry_state = policy->createRetryState(headers, cluster, factory_context_, dispatcher,","+                                              Upstream::ResourcePriority::Default,","+                                              makeOptRef<StreamInfo::StreamInfo>(stream_info));","+  ASSERT_NE(nullptr, retry_state);","+  EXPECT_TRUE(retry_state->enabled());","+  const auto* custom_policy = dynamic_cast<const CustomTestRetryPolicy*>(policy.get());","+  ASSERT_NE(nullptr, custom_policy);","+  EXPECT_TRUE(custom_policy->last_stream_info_present_);","+}","+","+TEST_F(RouteMatcherTest, RetryPolicyTypedConfigValidationErrors) {","+  factory_context_.cluster_manager_.initializeClusters({\"www\"}, {});","+","+  // Both retry_policy and retry_policy_typed_config on VirtualHost.","+  {","+    const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  retry_policy:","+    num_retries: 2","+  retry_policy_typed_config:","+    \"@type\": type.googleapis.com/envoy.config.route.v3.RetryPolicy","+    num_retries: 3","+  routes:","+  - match: {prefix: /}","+    route: {cluster: www}","+    )EOF\";","+    absl::Status status = absl::OkStatus();","+    TestConfigImpl config(parseRouteConfigurationFromYaml(yaml), factory_context_, false, status);","+    EXPECT_EQ(absl::StatusCode::kInvalidArgument, status.code());","+    EXPECT_THAT(status.message(),","+                testing::HasSubstr(","+                    \"Cannot set both retry_policy and retry_policy_typed_config in VirtualHost.\"));","+  }","+","+  // Both retry_policy and retry_policy_typed_config on RouteAction.","+  {","+    const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  routes:","+  - match: {prefix: /}","+    route:","+      cluster: www","+      retry_policy:","+        num_retries: 2","+      retry_policy_typed_config:","+        \"@type\": type.googleapis.com/envoy.config.route.v3.RetryPolicy","+        num_retries: 3