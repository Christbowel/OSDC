atus error without","+  // throwing EnvoyException.","+  {","+    envoy::config::route::v3::RouteConfiguration route_config;","+    auto* vhost = route_config.add_virtual_hosts();","+    vhost->set_name(\"www\");","+    vhost->add_domains(\"www.lyft.com\");","+    auto* typed_config = vhost->mutable_retry_policy_typed_config();","+    typed_config->set_type_url(\"type.googleapis.com/xds.type.v3.TypedStruct\");","+    typed_config->set_value(std::string(\"\\x80\\xff\\xff\", 3));","+    auto* route = vhost->add_routes();","+    route->mutable_match()->set_prefix(\"/\");","+    route->mutable_route()->set_cluster(\"www\");","+","+    absl::Status status = absl::OkStatus();","+    TestConfigImpl config(route_config, factory_context_, false, status);","+    EXPECT_FALSE(status.ok());","+  }","+","+  // Null RetryPolicy returned by a factory fails closed with InvalidArgument.","+  {","+    class NullRetryPolicyFactory : public RetryPolicyFactory {","+    public:","+      absl::StatusOr<RetryPolicyConstSharedPtr>","+      createRetryPolicy(const Protobuf::Message&, ProtobufMessage::ValidationVisitor&,","+                        Server::Configuration::CommonFactoryContext&) override {","+        return RetryPolicyConstSharedPtr{nullptr};","+      }","+      ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+        return std::make_unique<Envoy::Protobuf::Struct>();","+      }","+      std::string name() const override { return \"envoy.router.retry_policy.null_test\"; }","+    };","+","+    NullRetryPolicyFactory null_factory;","+    Registry::InjectFactory<RetryPolicyFactory> registered(null_factory);","+","+    const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  routes:","+  - match: {prefix: /}","+    route:","+      cluster: www","+      retry_policy_typed_config:","+        \"@type\": type.googleapis.com/google.protobuf.Struct","+    )EOF\";","+    absl::Status status = absl::OkStatus();","+    TestConfigImpl config(parseRouteConfigurationFromYaml(yaml), factory_context_, false, status);","+    EXPECT_EQ(absl::StatusCode::kInvalidArgument, status.code());","+    EXPECT_THAT(status.message(),","+                testing::HasSubstr(\"RetryPolicyFactory returned null policy for type:\"));","+  }","+","+  // Invalid RetryPolicy inside retry_policy_typed_config (max_interval < base_interval).","+  {","+    const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  routes:","+  - match: {prefix: /}","+    route:","+      cluster: www","+      retry_policy_typed_config:","+        \"@type\": type.googleapis.com/envoy.config.route.v3.RetryPolicy","+        retry_back_off:","+          base_interval: 10s","+          max_interval: 1s","+    )EOF\";","+    absl::Status status = absl::OkStatus();","+    TestConfigImpl config(parseRouteConfigurationFromYaml(yaml), factory_context_, false, status);","+    EXPECT_EQ(absl::StatusCode::kInvalidArgument, status.code());","+    EXPECT_THAT(status.message(),","+                testing::HasSubstr(","+                    \"retry_policy.max_interval must greater than or equal to the base_interval\"));","+  }","+","+  // PGV constraint violation inside retry_policy_typed_config (base_interval: 0s).","+  {","+    const std::string yaml = R\"EOF(","+virtual_hosts:","+- domains: [www.lyft.com]","+  name: www","+  routes:","+  - match: {prefix: /}","+    route:","+      cluster: www","+      retry_policy_typed_config:","+        \"@type\": type.googleapis.com/envoy.config.route.v3.RetryPolicy","+        retry_back_off:","+          base_interval: 0s","+    )EOF\";","+    absl::Status status = absl::OkStatus();","+    EXPECT_THROW_WITH_REGEX(","+        TestConfigImpl(parseRouteConfigurationFromYaml(yaml), factory_context_, true, status),","+        ProtoValidationException, \"Proto constraint validation failed\");","+  }","+}","+"," TEST_F(RouteMatcherTest, GrpcRetry) {","   const std::string yaml = R\"EOF