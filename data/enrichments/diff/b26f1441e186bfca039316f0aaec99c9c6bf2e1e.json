err := parseAggregateTargets(section)","+func TestParseAggregateTargets_EnvOverrides(t *testing.T) {","+\tcfg := setting.NewCfg()","+\taddAggregateSection(t, cfg, \"custom\", map[string]string{\"audience\": \"configured-audience\"})","+\tt.Setenv(\"GF_ROUTER_AGGREGATE_CUSTOM_URL\", \"https://env.invalid\")","+\tt.Setenv(\"GF_ROUTER_AGGREGATE_CUSTOM_AUDIENCE\", \"env-audience\")","+\tt.Setenv(\"GF_ROUTER_AGGREGATE_CUSTOM_POLL_INTERVAL\", \"2m\")","+\tt.Setenv(\"GF_ROUTER_AGGREGATE_CUSTOM_INSECURE\", \"true\")","+\ttargets, err := parseAggregateTargets(cfg)"," \trequire.NoError(t, err)","+\trequire.Equal(t, []aggregateTargetConfig{{Name: \"custom\", URL: \"https://env.invalid\", Audience: \"env-audience\", PollInterval: 2 * time.Minute, InsecureSkipVerify: true}}, targets)","+}"," ","-\tbyName := map[string]aggregateTargetConfig{}","-\tfor _, target := range targets {","-\t\tbyName[target.Name] = target","+func TestParseAggregateTargets_InvalidPollInterval(t *testing.T) {","+\tfor _, value := range []string{\"invalid\", \"0s\", \"-1m\"} {","+\t\tt.Run(value, func(t *testing.T) {","+\t\t\tcfg := setting.NewCfg()","+\t\t\taddAggregateSection(t, cfg, \"custom\", map[string]string{\"url\": \"https://example.invalid\", \"poll_interval\": value})","+\t\t\t_, err := parseAggregateTargets(cfg)","+\t\t\trequire.ErrorContains(t, err, \"router.aggregate.custom: poll_interval must be a positive duration\")","+\t\t})"," \t}","-","-\trequire.Equal(t, \"/etc/certs/baas-ca.crt\", byName[\"baas_apiserver\"].CAFile)","-\trequire.False(t, byName[\"baas_apiserver\"].InsecureSkipVerify)","-","-\trequire.Empty(t, byName[\"cloud_app_platform_apiserver\"].CAFile)","-\trequire.True(t, byName[\"cloud_app_platform_apiserver\"].InsecureSkipVerify)"," }"," "," func TestParseAggregateTargets_NoneConfigured(t *testing.T) {","-\tcfg := cfgWithCloudRouterSection(t, map[string]string{})","-\tsection := cfg.SectionWithEnvOverrides(cloudRouterSection)","-","-\ttargets, err := parseAggregateTargets(secti