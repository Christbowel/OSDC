 }","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"pnpr/crates/sql/src/lib.rs","lines":["@@ -7,6 +7,7 @@ extern crate pnpr_error;"," #[macro_use]"," pub mod params;"," pub mod adapter;","+pub mod dialect;"," #[cfg(feature = \"backend-libsql\")]"," pub mod libsql;"," #[cfg(any(feature = \"backend-postgres\", feature = \"backend-mysql\"))]","@@ -14,6 +15,7 @@ pub mod network;"," pub mod schema;"," pub mod sqlite;"," ","+pub use dialect::{Dialect, DialectSql};"," pub use pnpr_config::{LibsqlSettings, SqlBackendSettings};"," pub use pnpr_error::{RegistryError, Result};"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/sql/src/libsql/statements.rs","lines":["@@ -2,7 +2,7 @@"," //! batches."," "," use super::timed_out;","-use crate::adapter::{Connection, Param, Query, Row, Value};","+use crate::adapter::{Connection, Param, Query, Row, Value, reject_nul};"," use pnpr_error::Result;"," use std::cell::{Cell, RefCell};"," use tokio::runtime::Handle;","@@ -180,6 +180,7 @@ async fn collect_rows(mut rows: libsql::Rows) -> Result<Vec<Row>> {"," "," impl Connection for Statements<'_> {","     fn execute(&self, sql: &str, params: &[Param<'_>]) -> Result<()> {","+        reject_nul(params)?;","         if !self.local {","             self.hold(sql, params, classify_sql(sql));","             return Ok(());","@@ -189,6 +190,7 @@ impl Connection for Statements<'_> {","     }"," ","     fn query(&self, sql: &str, params: &[Param<'_>]) -> Result<Vec<Row>> {","+        reject_nul(params)?;","         if !self.local {","             let query = Query::new(sql, params);","             return Ok(self","@@ -206,6 +208,9 @@ impl Connection for Statements<'_> {","                 .map(|query| self.query(query.sql, &query.params))","                 .collect();","         }","+        for query in queries {","+            reject_nul(&query.params)?;","+        }","         for query in queries {","             self.hold(query.sql, &query.params, classify_s