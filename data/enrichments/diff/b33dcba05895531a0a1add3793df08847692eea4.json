{"id":"b33dcba05895531a0a1add3793df08847692eea4","axis":"silent","repo":"pnpm/pnpm","sha":"b33dcba05895531a0a1add3793df08847692eea4","parsed":{"files":[{"path":".changeset/pnpr-mysql-experimental.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+MySQL support for `database.url` is now marked experimental, and pnpr logs a warning at startup when it is configured. SQLite, libSQL, and PostgreSQL stay stable.","+","+pnpr now refuses text that holds a NUL character on every database, so a request that SQLite accepts cannot fail on PostgreSQL.","+","+pnpr instances on different schemas of one PostgreSQL database no longer wait on each other's write and migration locks."],"additions":9,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/tests.rs","lines":["@@ -1019,7 +1019,7 @@ async fn schema_migrations_refuses_future_schema_version() {"," ","     {","         let conn = rusqlite::Connection::open(&path).unwrap();","-        conn.execute_batch(pnpr_sql::schema::MARKER_TABLE).unwrap();","+        conn.execute_batch(pnpr_sql::schema::MARKER_TABLE.sqlite).unwrap();","         for version in 1..=future {","             conn.execute(","                 \"INSERT INTO schema_migrations (version, applied_at) VALUES (?1, 1)\","],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/main.rs","lines":["@@ -4,7 +4,7 @@ use pnpr::{","     Command, Config, ConfigSource, ConfigSubcommand, LogConfig, RegistryError, ServerArgs,","     default_cache_dir, logging::log_subscriber, run_command, serve,"," };","-use pnpr_config::{MetadataBackend, default_metadata_path};","+use pnpr_config::{BackendConfig, MetadataBackend, default_metadata_path};"," use std::{","     io::IsTerminal,","     net::SocketAddr,","@@ -74,6 +74,7 @@ async fn main() -> miette::Result<()> {"," ","     init_logging(&config.logs);","     log_config_source(&source);","+    warn_experimental_database(&config);","     serve(config).await.map_err(|err| redacted_report(&err))"," }"," ","@@ -102,6 +103,7 @@ async fn run_maintenance("," ","     init_logging(&config.logs);","     log_config_source(&source);","+    warn_experimental_database(&config);","     run_command(&config, cmd).await"," }"," ","@@ -191,5 +193,15 @@ fn log_config_source(source: &ConfigSource) {","     }"," }"," ","+fn warn_experimental_database(config: &Config) {","+    let mysql = matches!(config.storage.metadata, MetadataBackend::Mysql(_))","+        || matches!(config.identity.backend, BackendConfig::Mysql(_));","+    if mysql {","+        tracing::warn!(","+            \"MySQL support is experimental; use SQLite, libSQL, or PostgreSQL for production data\",","+        );","+    }","+}","+"," #[cfg(test)]"," mod tests;"],"additions":13,"deletions":1,"truncated":false},{"path":"pnpr/crates/sql/src/adapter.rs","lines":["@@ -1,20 +1,22 @@"," //! What the shared SQL layer needs from a database."," //!"," //! The shared layer runs every statement through [`Connection`], with `?N`","-//! placeholders and the [`Param`] and [`Value`] types, in the subset of SQL","-//! that `SQLite`, libSQL, and `PostgreSQL` share. An [`Adapter`] supplies what","-//! differs between the databases:","+//! placeholders and the [`Param`] and [`Value`] types. A statement is either","+//! in the SQL every [`Dialect`] shares or a [`DialectSql`](crate::dialect::DialectSql)","+//! picked by [`Connection::dialect`]. An [`Adapter`] supplies what differs","+//! between the databases:"," //!"," //! - the connections, opened from its configuration;"," //! - the statements that begin a write or a read transaction;"," //! - which errors are conflicts that a retry of the whole transaction clears;","-//! - placeholders and column types, translated by its [`Connection`];","+//! - placeholders, translated by its [`Connection`];"," //! - where a read runs, the primary or a replica ([`ReadSource`]);"," //! - how statements reach the database: one at a time, or a remote"," //!   database's in batches of one round trip each."," //!"," //! Every method blocks. The shared layer calls them on the blocking pool."," ","+use crate::dialect::Dialect;"," use pnpr_error::{RegistryError, Result};"," use std::{fmt, ops::Deref, time::Instant};"," ","@@ -45,6 +47,10 @@ pub enum Snapshot {"," /// The error of a held statement then surfaces from that later call, which"," /// fails the transaction just the same."," pub trait Connection {","+    fn dialect(&self) -> Dialect {","+        Dialect::Sqlite","+    }","+","     fn lock_schema(&self) -> Result<()> {","         Ok(())","     }","@@ -61,27 +67,10 @@ pub trait Connection {","         Ok(false)","     }"," ","-    /// Dialect-specific step-1 schema DDL script, when it differs from","-    /// [`crate::schema::TABLES`].","-    fn schema_tables(&self) -> Option<String> {","-        None","-    }","-","     fn schema_table_names(&self) -> Result<Vec<Row>> {","         self.query(\"SELECT name FROM sqlite_master WHERE type = 'table'\", &[])","     }"," ","-    /// Dialect-specific `CREATE TABLE` statement for `schema_migrations`, when","-    /// it differs from [`crate::schema::MARKER_TABLE`].","-    fn schema_marker(&self) -> Option<&'static str> {","-        None","-    }","-","-    /// Dialect-specific `CREATE TABLE` statement for `hosted_store`.","-    fn hosted_store_table(&self) -> &'static str {","-        \"CREATE TABLE IF NOT EXISTS hosted_store (singleton INTEGER PRIMARY KEY CHECK (singleton = 1), store_id TEXT NOT NULL) STRICT\"","-    }","-","     /// Run one DDL statement in a migration step. On backends where DDL","     /// commits implicitly (`MySQL`), checks `information_schema` before","     /// `CREATE [UNIQUE] INDEX` and `ALTER TABLE ... ADD COLUMN` so an","@@ -253,6 +242,24 @@ pub enum Param<'value> {","     Blob(&'value [u8]),"," }"," ","+/// Refuse a text parameter holding a NUL character, which `PostgreSQL`","+/// cannot store, so every database accepts the same text.","+///","+/// # Errors","+///","+/// [`Regi