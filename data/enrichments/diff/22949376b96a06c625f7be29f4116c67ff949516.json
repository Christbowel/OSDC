ns AS c","+\t\t\tINNER JOIN sys.tables AS t ON t.object_id = c.object_id","+\t\t\tINNER JOIN sys.types AS ty ON ty.user_type_id = c.user_type_id","+\t\t\tLEFT JOIN sys.default_constraints AS dc ON dc.object_id = c.default_object_id"," \t\t\tLEFT JOIN (","-\t\t\t\tSELECT","-\t\t\t\t\tPK_SET = CASE WHEN CONSTRAINT_NAME LIKE '%pk%' THEN 'PRIMARY' ELSE NULL END,","-\t\t\t\t\tTABLE_NAME,","-\t\t\t\t\tCONSTRAINT_CATALOG,","-\t\t\t\t\tCOLUMN_NAME,","-\t\t\t\t\tCOUNT(*) OVER (PARTITION BY CONSTRAINT_NAME) as PK_COUNT","-\t\t\t\tFROM [${this.knex.client.database()}].INFORMATION_SCHEMA.KEY_COLUMN_USAGE","-\t\t\t) as pk","-\t\t\tON [c].[TABLE_NAME] = [pk].[TABLE_NAME]","-\t\t\tAND [c].[TABLE_CATALOG] = [pk].[CONSTRAINT_CATALOG]","-\t\t\tAND [c].[COLUMN_NAME] = [pk].[COLUMN_NAME]","-\t\t\tAND [pk].[PK_SET] = 'PRIMARY'","-\t\t\tAND [pk].[PK_COUNT] = 1","-\t\t\tINNER JOIN","-\t\t\t\t[${this.knex.client.database()}].INFORMATION_SCHEMA.TABLES as t","-\t\t\tON [c].[TABLE_NAME] = [t].[TABLE_NAME]","-\t\t\tAND [c].[TABLE_CATALOG] = [t].[TABLE_CATALOG]","-\t\t\tAND [t].TABLE_TYPE = 'BASE TABLE'","+\t\t\t\tSELECT ic.object_id, MIN(ic.column_id) AS column_id","+\t\t\t\tFROM sys.indexes AS i","+\t\t\t\tINNER JOIN sys.index_columns AS ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id","+\t\t\t\tWHERE i.is_primary_key = 1","+\t\t\t\tGROUP BY ic.object_id","+\t\t\t\tHAVING COUNT(*) = 1","+\t\t\t) AS pk ON pk.object_id = c.object_id AND pk.column_id = c.column_id","+\t\t\tORDER BY t.name, c.column_id"," \t\t\t`,"," \t\t);"," "," \t\tconst overview: SchemaOverview = {};"," ","+\t\tconst primaryByTable: Record<string, string> = {};","+","+\t\tfor (const column of columns) {","+\t\t\tif (column.column_key === 'PRIMARY') {","+\t\t\t\tprimaryByTable[column.table_name] = column.column_name;","+\t\t\t}","+\t\t}","+"," \t\tfor (const column of columns) {"," \t\t\tif (column.table_name in overview === false) {"," \t\t\t\toverview[column.table_name] = {","-\t\t\t\t\tprimary: columns.find((n