xla/service/buffer_assignment.h\""," "," namespace xla::cpu {"," ","-// Deterministic argument table for a computation emitted as a single kernel.","+// Deterministic parameter regions for a computation emitted as a single kernel."," //","-// Slices of parameters and of operands of all instructions become arguments","-// and slices of all non-parameter instructions become results, including","-// nested tuple elements and instructions of nested non-fusion computations.","-// Thread-local slices are skipped. Entries are deduplicated by (shape, slice)","-// in first-visit order.","+// Each parameter is a disjoint byte region of one allocation. It covers a","+// maximal group of overlapping non empty leaf array slices from the computation","+// and its nested non fusion computations. Thread local slices and tuple index","+// tables are skipped. Read only regions (`arguments`) come before writable","+// regions (`results`), each ordered by first visit. Parameter shapes are","+// `u8[size]`."," //"," // The fingerprint does not use emitters::GetComputationFingerprint, which only"," // describes kernel operands and outputs, not the buffers of intermediate","@@ -47,36 +47,30 @@ class ComputationKernelArguments {","   static absl::StatusOr<ComputationKernelArguments> Create(","       const HloComputation& computation, const BufferAssignment& assignment);"," ","+  // Merges overlapping slices of the same allocation into covering slices,","+  // sorted by allocation index and offset. Empty slices are ignored; adjacent","+  // non overlapping slices remain separate.","+  static std::vector<BufferAllocation::Slice> MergeOverlapping(","+      absl::Span<const BufferAllocation::Slice> slices);","+","   const KernelSpec::Buffers& arguments() const { return arguments_; }","   const KernelSpec::Buffers& results() const { return results_; }"," ","-  // Index of each slice in the buffer table of arguments followed by results.","-  // A slice listed more than once maps to its last posi