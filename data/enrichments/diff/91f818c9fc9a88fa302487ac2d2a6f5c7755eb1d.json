{"id":"91f818c9fc9a88fa302487ac2d2a6f5c7755eb1d","axis":"silent","repo":"foundry-rs/foundry","sha":"91f818c9fc9a88fa302487ac2d2a6f5c7755eb1d","parsed":{"files":[{"path":"Cargo.lock","lines":["@@ -5743,6 +5743,7 @@ dependencies = [","  \"inferno\",","  \"itertools 0.15.0\",","  \"mockall\",","+ \"mpp\",","  \"opener\",","  \"parking_lot\",","  \"path-slash\","],"additions":1,"deletions":0,"truncated":false},{"path":"crates/cheatcodes/src/config.rs","lines":["@@ -207,7 +207,12 @@ impl CheatsConfig {","     ///  - Returns an error if `url_or_alias` is a known alias but references an unresolved env var.","     ///  - Returns an error if `url_or_alias` is not an alias but does not start with a `http` or","     ///    `ws` `scheme` and is not a path to an existing file","+    ///  - Returns an error if network access is disabled.","     pub fn rpc_endpoint(&self, url_or_alias: &str) -> Result<ResolvedRpcEndpoint> {","+        // Every cheatcode that opens a connection to a URL or alias resolves it here.","+        if self.evm_opts.no_network {","+            return Err(fmt_err!(\"network access is disabled\"));","+        }","         if let Some(endpoint) = self.rpc_endpoints.get(url_or_alias) {","             Ok(endpoint.clone().try_resolve())","         } else if let Some(builtin_url) = foundry_config::builtin_rpc_url(url_or_alias) {"],"additions":5,"deletions":0,"truncated":false},{"path":"crates/common/src/provider/mpp/transport.rs","lines":["@@ -147,7 +147,8 @@ impl fmt::Debug for LazyAccountsProvider {"," }"," "," impl LazyAccountsProvider {","-    pub(super) fn new(origin: String) -> Self {","+    /// Create a provider for payments requested by `origin`.","+    pub fn new(origin: String) -> Self {","         Self {","             inner: Arc::new(Mutex::new(HashMap::new())),","             funding_by_challenge: Arc::new(Mutex::new(HashMap::new())),"],"additions":2,"deletions":1,"truncated":false},{"path":"crates/config/src/lib.rs","lines":["@@ -670,6 +670,14 @@ pub struct Config {","     /// Whether to enable script execution protection.","     pub script_execution_protection: bool,"," ","+    /// Whether inline config can only lower the runs, depth, and rejects of fuzz and invariant","+    /// tests and change a few settings that steer them, and must leave every other setting as it","+    /// is. Commands that run generated tests set it, so a test can neither widen its own access,","+    /// write outside the project, nor run unbounded.","+    #[doc(hidden)]","+    #[serde(skip)]","+    pub restrict_inline_config: bool,","+","     /// PRIVATE: This structure may grow, As such, constructing this structure should","     /// _always_ be done using a public constructor or update syntax:","     ///","@@ -924,11 +932,96 @@ impl Config {","         config.invariant.corpus_random_sequence_weight_configured =","             invariant_corpus_random_sequence_weight_configured;","         config.invariant.workers_configured = invariant_workers_configured;","+        config.restrict_inline_config = self.restrict_inline_config;","         config.normalize_hardfork_settings()?;","+        if self.restrict_inline_config","+            && let Some(change) = self.restricted_inline_change(&config)","+        {","+            return Err(Error::from(format!(\"inline config cannot {change} in generated tests\")));","+        }"," ","         Ok(config)","     }"," ","+    /// Returns what a restricted inline config changed that it must not: a raised bound on the work","+    /// of a test, or any setting outside a few that only steer the fuzzer and invariant runs. An","+    /// allowlist, so a new setting, such as a path that Forge writes to, stays fixed.","+    fn restricted_inline_change(&self, inline: &Self) -> Option<String> {","+        let (fuzz, invariant) = (&inline.fuzz, &inline.invariant);","+        // The fuzzer takes no limit on rejects for zero.","+        let rejects = |rejects: u32| if rejects == 0 { u32::MAX } else { rejects };","+        let caps_raised = |base: &FuzzDictionaryConfig, inline: &FuzzDictionaryConfig| {","+            inline.max_fuzz_dictionary_addresses > base.max_fuzz_dictionary_addresses","+                || inline.max_fuzz_dictionary_values > base.max_fuzz_dictionary_values","+                || inline.max_fuzz_dictionary_literals > base.max_fuzz_dictionary_literals","+        };","+        let raised = [","+            (\"fuzz.runs\", fuzz.runs > self.fuzz.runs),","+            (","+                \"fuzz.max_test_rejects\",","+                rejects(fuzz.max_test_rejects) > rejects(self.fuzz.max_test_rejects),","+            ),","+            (\"fuzz.dictionary\", caps_raised(&self.fuzz.dictionary, &fuzz.dictionary)),","+            (","+                \"invariant.dictionary\",","+                caps_raised(&self.invariant.dictionary, &invariant.dictionary),","+            ),","+            (\"invariant.runs\", invariant.runs > self.invariant.runs),","+            (\"invariant.depth\", invariant.depth > self.invariant.depth),","+            (\"invariant.min_depth\", invariant.min_depth > self.invariant.min_depth),","+            (","+                \"invariant.shrink_run_limit\",","+                invariant.shrink_run_limit > self.invariant.shrink_run_limit,","+            ),","+            (","+                \"invariant.max_assume_rejects\",","+                invariant.max_assume_rejects > self.invariant.max_assume_rejects,","+            ),","+        ];","+        if let Some((key, _)) = raised.into_iter().find(|(_, raised)| *raised) {","+            return Some(format!(\"raise `{key}`\"));","+        }","+        let mut allowed = inline.clone();","+        allowed.fuzz.runs = self.fuzz.runs;","+        allowed.fuzz.max_test_rejects = self.fuzz.max_test_rejects;","+        allowed.fuzz.dictionary = self.fuzz.dictionary;","+        allowed.fuzz.show_logs = self.fuzz.show_logs;","+        allowed.invariant.runs = self.invariant.runs;","+        allowed.invariant.depth = self.invariant.depth;","+        allowed.invariant.min_depth = self.invariant.min_depth;","+        allowed.invariant.depth_mode = self.invariant.depth_mode;","+        allowed.invariant.shrink_run_limit = self.invariant.shrink_run_limit;","+        allowed.invariant.max_assume_rejects = self.invariant.max_assume_rejects;","+        allowed.invariant.call_override = self.invariant.call_override;","+        allowed.invariant.dictionary = self.invariant.dictionary;","+        allowed.invariant.max_time_delay = self.invariant.max_time_delay;","+        allowed.invariant.max_block_delay = self.invariant.max_block_delay;","+        allowed.invariant.check_interval = self.invariant.check_interval;","+        allowed.invariant.show_metrics = self.invariant.show_metrics;","+        allowed.invariant.show_solidity = self.invariant.show_solidity;","+        allowed.allow_internal_expect_revert = self.allow_internal_expect_revert;","+        fn changed_key(base: &serde_json::Value, other: &serde_json::Value) -> Option<String> {","+            match (base, other) {","+                (serde_json::Value::Object(base), serde_json::Value::Object(other)) => {","+                    base.keys().chain(other.keys()).find_map(|key| {","+                        let null = serde_json::Value::Null;","+                        let (a, b) =","+                            (base.get(key).unwrap_or(&null), other.get(key).unwrap_or(&null));","+                        changed_key(a, b).map(|rest| {","+                            if rest.is_empty() { key.clone() } else { format!(\"{key}.{rest}\") }","+                        })","+                    })","+                }","+                _ => (base != other).then(String::new),","+            }","+        }","+        let (Ok(base), Ok(allowed)) = (serde_json::to_value(self), serde_json::to_value(&allowed))","+        else {","+            return Some(\"change settings that do not serialize\".to_string());","+        };","+        Some(format!(\"change `{}`\", changed_key(&base, &allowed)?))","+    }","+","     #[doc(hidden)]","     #[deprecated(note = \"use `Config::from_provider` instead\")]","     pub fn try_from<T: Provider>(provider: T) -> Result<Self, ExtractConfigError> {","@@ -3270,6 +3363,7 @@ impl Default for Config {","             networks: Default::default(),","             transaction_timeout: 120,","             additional_compiler_profiles: Default::default(),","+            restrict_inline_config: false,","             compilation_restrictions: Default::default(),","             script_execution_protection: true,","             _non_exhaustive: (),","@@ -9872,6 +9966,40 @@ mod tests {","         assert_eq!(fs::read_to_string(cache).unwrap(), \"existing cache\");","     }"," ","+    #[test]","+    fn restricted_inline_config_only_lowers_limits() {","+        let base = Config::default();","+        let change = |edit: fn(&mut Config)| {","+            let mut inline = base.clone();","+            edit(&mut inline);","+            base.restricted_inline_change(&inline)","+        };","+        assert_eq!(change(|c| c.fuzz.max_test_rejects = 1), None);","+        // Zero takes no limit on rejects.","+        assert_eq!(","+            change(|c| c.fuzz.max_test_rejects = 0),","+            Some(\"raise `fuzz.max_test_rejects`\".into())","+        );","+        assert_eq!(change(|c| c.fuzz.dictionary.dictionary_weight = 0), None);","+        assert_eq!(change(|c| c.fuzz.dictionary.max_fuzz_dictionary_values = 1), None);","+        assert_eq!(","+            change(|c| c.fuzz.dictionary.max_fuzz_dictionary_values = usize::MAX),","+            Some(\"raise `fuzz.dictionary`\".into())","+        );","+        assert_eq!(","+            change(|c| c.invariant.dictionary.max_fuzz_dictionary_literals = usize::MAX),","+            Some(\"raise `invariant.dictionary`\".into())","+        );","+        assert_eq!(","+            change(|c| c.fuzz.fail_on_revert = !c.fuzz.fail_on_revert),","+            Some(\"change `fuzz.fail_on_revert`\".into())","+        );","+        assert_eq!(","+            change(|c| c.invariant.fail_on_revert = !c.invariant.fail_on_revert),","+            Some(\"change `invariant.fail_on_revert`\".into())","+        );","+    }","+","     #[test]","     fn linked_library_policy_settings() {","         figment::Jail::expect_with(|jail| {"],"additions":128,"deletions":0,"truncated":false},{"path":"crates/evm/core/src/opts.rs","lines":["@@ -114,6 +114,11 @@ pub struct EvmOpts {","     /// Enables the FFI cheatcode.","     pub ffi: bool,"," ","+    /// Makes every cheatcode that opens a network connection fail. Only callers set it; config","+    /// cannot.","+    #[serde(skip)]","+    pub no_network: bool,","+","     /// Use the create 2 factory in all cases including tests and non-broadcasting scripts.","     pub always_use_create_2_factory: bool,"," ","@@ -334,6 +339,7 @@ impl Default for EvmOpts {","             initial_balance: U256::default(),","             sender: Address::default(),","             ffi: false,","+            no_network: false,","             always_use_create_2_factory: false,","             verbosity: 0,","             memory_limit: 0,"],"additions":6,"deletions":0,"truncated":false},{"path":"crates/forge/Cargo.toml","lines":["@@ -69,7 +69,7 @@ tempo-alloy.workspace = true"," "," clap = { version = \"4\", features = [\"derive\", \"env\", \"unicode\", \"wrap_help\"] }"," clap_complete.workspace = true","-ctrlc = \"3\"","+ctrlc = { version = \"3\", features = [\"termination\"] }"," dialoguer.workspace = true"," dunce.workspace = true"," flate2.workspace = true","@@ -78,6 +78,7 @@ heck.workspace = true"," indicatif.workspace = true"," inferno = { version = \"0.12\", default-features = false }"," itertools.workspace = true","+mpp.workspace = true"," parking_lot.workspace = true"," regex = { workspace = true, default-features = false }"," revm.workspace = true"],"additions":2,"deletions":1,"truncated":false},{"path":"crates/forge/src/args.rs","lines":["@@ -70,6 +70,7 @@ pub fn run_command(args: Forge) -> Result<()> {","             let outcome = global.block_on(cmd.run())?;","             outcome.ensure_ok(silent)","         }","+        ForgeSubcommand::Properties(cmd) => cmd.run(),","         ForgeSubcommand::Script(cmd) => block_on_command(global, || cmd.run_script()),","         ForgeSubcommand::Coverage(cmd) => {","             if cmd.is_watch() {","@@ -135,6 +136,7 @@ pub fn run_command(args: Forge) -> Result<()> {","         ForgeSubcommand::Inspect(cmd) => cmd.run(),","         ForgeSubcommand::Tree(cmd) => cmd.run(),","         ForgeSubcommand::Geiger(cmd) => global.block_on(cmd.run()),","+        ForgeSubcommand::Exploit(cmd) => global.block_on(cmd.run()),","         ForgeSubcommand::Doc(cmd) => {","             if cmd.is_watch() {","                 block_on_watch(global, watch::watch_doc(cmd))"],"additions":2,"deletions":0,"truncated":false},{"path":"crates/forge/src/cmd/exploit.rs","lines":["@@ -0,0 +1,440 @@","+use clap::{Parser, ValueHint};","+use eyre::{Context, Result, eyre};","+use foundry_cli::{opts::BuildOpts, utils::LoadConfig};","+use foundry_common::{provider::mpp::transport::LazyAccountsProvider, shell};","+use foundry_compilers::utils::source_files_iter;","+use foundry_config::impl_figment_convert;","+use foundry_evm::constants::{CHEATCODE_ADDRESS, HARDHAT_CONSOLE_ADDRESS, MONAD_CHEATCODE_ADDRESS};","+use mpp::client::Fetch;","+use serde::Serialize;","+use serde_json::{Value, json};","+use std::{","+    fmt::Write as _,","+    io::Write as _,","+    path::{Path, PathBuf},","+};","+use url::Url;","+","+use crate::{","+    cmd::properties::{","+        SELECT_ALL_TESTS, Sandbox, TestFile, restrict_config, shorten, stderr, suite_results,","+    },","+    result::{TestResult, TestStatus},","+    traces::{CallKind, TraceKind},","+    workspace::relative_to_root,","+};","+","+/// Tempo Gateway that serves OpenAI-compatible chat completions paid over MPP.","+const DEFAULT_ENDPOINT: &str = \"https://gateway.tempo-dev.workers.dev\";","+","+/// Model used when none is given.","+const DEFAULT_MODEL: &str = \"@cf/zai-org/glm-5.3\";","+","+/// Reply that ends an attempt without a finding.","+const NO_EXPLOIT: &str = \"NO_EXPLOIT\";","+","+/// Longest source file sent to the model.","+const MAX_SOURCE_BYTES: usize = 64_000;","+","+/// CLI arguments for `forge exploit`.","+///","+/// Asks a model served by the Tempo Gateway to find a vulnerability in a contract and prove it","+/// with a Foundry test. Forge compiles and runs every test the model writes and sends compiler","+/// errors and failing results back until a test passes. Requests are paid through the Machine","+/// Payments Protocol from the Tempo account that `cast tempo login` authorized.","+///","+/// The output of every test goes back to the model, so Forge runs the tests as `forge properties`","+/// runs generated tests: in a temporary copy of the project, without `ffi`, network access, RPC","+/// and Etherscan settings, or Forge's environment variables. A test that passes is written to","+/// `test/exploit/` under a name that no file there has yet.","+#[derive(Clone, Debug, Parser)]","+pub struct ExploitArgs {","+    /// The contract source to attack.","+    #[arg(long, value_hint = ValueHint::FilePath, value_name = \"PATH\")]","+    target: PathBuf,","+","+    /// Extra files for the model, such as a specification or related contracts.","+    #[arg(long, value_hint = ValueHint::FilePath, value_name = \"PATH\")]","+    context: Vec<PathBuf>,","+","+    /// Gateway serving `/v1/chat/completions` over MPP.","+    #[arg(long, env = \"FORGE_EXPLOIT_ENDPOINT\", default_value = DEFAULT_ENDPOINT)]","+    endpoint: Url,","+","+    /// Model to ask.","+    #[arg(long, env = \"FORGE_EXPLOIT_MODEL\", default_value = DEFAULT_MODEL)]","+    model: String,","+","+    /// Independent attempts; each later attempt is told which bugs were already proven.","+    #[arg(long, default_value_t = 3)]","+    attempts: usize,","+","+    /// Model replies per attempt, counting each retry after a compiler error or failing test.","+    #[arg(long, default_value_t = 4)]","+    turns: usize,","+","+    /// Most tokens per model reply.","+    #[arg(long, default_value_t = 8_192)]","+    max_tokens: u32,","+","+    #[command(flatten)]","+    build: BuildOpts,","+}","+","+impl_figment_convert!(ExploitArgs, build);","+","+/// A test the model wrote that passes, proving its claimed bug.","+#[derive(Debug, Serialize)]","+struct Finding {","+    attempt: usize,","+    turns: usize,","+    file: PathBuf,","+    tests: Vec<String>,","+    bugs: Vec<String>,","+}","+","+#[derive(Debug, Serialize)]","+struct Report<'a> {","+    target: &'a Path,","+    endpoint: &'a str,","+    model: &'a str,","+    findings: &'a [Finding],","+}","+","+enum Run {","+    Proven(Vec<String>),","+    Rejected(String),","+}","+","+impl ExploitArgs {","+    pub async fn run(self) -> Result<()> {","+        let mut config = self.load_config()?;","+        restrict_config(&mut config, false, false);","+        let root = config.root.clone();","+        let target = root.join(&self.target);","+        let target_rel = relative_to_root(&root, &target);","+        let target_source = read_source(&target)?;","+        let mut context = String::new();","+        for path in &self.context {","+            let path = root.join(path);","+            write!(","+                context,","+                \"\\n\\n--- {} ---\\n{}\",","+                relative_to_root(&root, &path).display(),","+                read_source(&path)?","+            )?;","+        }","+        let remappings =","+            config.get_all_remappings().map(|r| r.to_string()).collect::<Vec<_>>().join(\"\\n\");","+        let mut sources = source_files_iter(&config.src, &[\"sol\"])","+            .map(|path| relative_to_root(&root, &path).display().to_string())","+            .collect::<Vec<_>>();","+        sources.sort();","+        let sources = sources.join(\"\\n\");","+        let mut sandbox = Sandbox::new(&config, vec![])?;","+        sandbox.end_on_interrupt(Vec::new())?;","+        if let Some(errors) = sandbox.build()? {","+            return Err(eyre!(","+                \"the project must compile before Forge looks for exploits: {errors}\"","+            ));","+        }","+","+        let out_dir = config.test.join(\"exploit\");","+        let chat = Chat::new(&self.endpoint, &self.model, self.max_tokens)?;","+        let mut findings = Vec::<Finding>::new();","+        let mut next = 1;","+","+        for attempt in 1..=self.attempts {","+            // Proofs of earlier runs keep their files: each attempt names its test after the first","+            // number that no file has.","+            while out_dir.join(format!(\"Exploit{next}Test.t.sol\")).exists() {","+                next += 1;","+            }","+            let contract = format!(\"Exploit{next}Test\");","+            let file = out_dir.join(format!(\"{contract}.t.sol\"));","+            let file_rel = relative_to_root(&root, &file);","+            let mut prompt = format!(","+                \"Target: {target}\\n\\n{target_source}{context}\\n\\nProject sources:\\n{sources}\\n\\n\\","+                 Remappings:\\n{remappings}\\n\\nWrite the test file at {file}. Name the test \\","+                 contract {contract}.\",","+                target = target_rel.display(),","+                file = file_rel.display(),","+            );","+            if !findings.is_empty() {","+                prompt.push_str(\"\\n\\nThese bugs are already proven; find a different one:\\n\");","+                for bug in findings.iter().flat_map(|f| &f.bugs) {","+                    writeln!(prompt, \"{bug}\")?;","+                }","+            }","+            let mut messages = vec![","+                json!({\"role\": \"system\", \"content\": SYSTEM}),","+                json!({\"role\": \"user\", \"content\": prompt}),","+            ];","+","+            sh_status!(\"Attempt {attempt}/{}: asking {}\", self.attempts, self.model)?;","+            for turn in 1..=self.turns {","+                let reply = chat.complete(&messages).await?;","+                messages.push(json!({\"role\": \"assistant\", \"content\": reply}));","+","+                let Some(code) = solidity_block(&reply) else {","+                    if reply.contains(NO_EXPLOIT) {","+                        sh_status!(\"Attempt {attempt}: the model found no exploit\")?;","+                    } else {","+                        sh_warn!(\"Attempt {attempt}: the reply had no Solidity code block\")?;","+                    }","+                    break;","+                };","+                let feedback = match run_test(&sandbox, &file_rel, code)? {","+                    Run::Proven(tests) => {","+                        std::fs::create_dir_all(&out_dir)?;","+                        std::fs::OpenOptions::new()","+                            .write(true)","+                            .create_new(true)","+                            .open(&file)","+                            .and_then(|mut target| target.write_all(code.as_bytes()))","+                            .wrap_err_with(|| format!(\"failed to write {}\", file_rel.display()))?;","+                        let bugs = bug_tags(code);","+                        sh_status!(\"Attempt {attempt}: proven by {}\", file_rel.display())?;","+                        findings.push(Finding {","+                            attempt,","+                            turns: turn,","+                            file: file_rel.clone(),","+                            tests,","+                            bugs,","+                        });","+                        break;","+                    }","+                    Run::Rejected(feedback) => feedback,","+                };","+                sh_status!(\"Attempt {attempt}, turn {turn}: not proven yet\")?;","+                messages.push(json!({\"role\": \"user\", \"content\": feedback}));","+            }","+        }","+","+        let report_path = config.cache_path.join(\"exploit\").join(\"report.json\");","+        std::fs::create_dir_all(report_path.parent().unwrap())?;","+        let report = Report {","+            target: &target_rel,","+            endpoint: self.endpoint.as_str(),","+            model: &self.model,","+            findings: &findings,","+        };","+        std::fs::write(&report_path, serde_json::to_string_pretty(&report)?)?;","+","+        if shell::is_json() {","+            sh_println!(\"{}\", serde_json::to_string(&report)?)?;","+        } else {","+            for finding in &findings {","+                for bug in &finding.bugs {","+                    sh_println!(\"{}\\t{bug}\", finding.file.display())?;","+                }","+            }","+            sh_status!(","+                \"{} of {} attempts proved an exploit; report in {}\",","+                findings.len(),","+                self.attempts,","+                relative_to_root(&root, &report_path).display()","+            )?;","+        }","+        Ok(())","+    }","+}","+","+const SYSTEM: &str = \"You are a smart contract security researcher auditing a Foundry project. \\","+Find one concrete, exploitable vulnerability in the target contract and prove it with a Foundry \\","+test.","+","+Reply with exactly one solidity fenced code block holding a complete test file:","+- an SPDX line, a pragma compatible with the target, and imports of forge-std/Test.sol and of the \\","+contracts you need, using the project's remappings or paths relative to the test file;","+- one contract with the name you are given, inheriting Test, that deploys everything it needs in \\","+setUp();","+- one or more functions named test_exploit_* that pass only when the exploit works: assert what \\","+the attacker gained or which guarantee broke, never something that holds anyway;","+- each such function successfully calls a function of a target contract that can change its \\","+state; view calls and reverted calls alone do not count;","+- directly above each such function, a comment line \\","+// @bug Contract.function path:line - one sentence saying what is wrong;","+- no ffi, no forks, no network access and no environment variables.","+","+When the test does not compile or does not pass you get the output; reply with the whole fixed \\","+file. If you find no exploitable vulnerability, reply NO_EXPLOIT and nothing else.\";","+","+struct Chat {","+    client: reqwest::Client,","+    provider: LazyAccountsProvider,","+    url: Url,","+    model: String,","+    max_tokens: u32,","+}","+","+impl Chat {","+    fn new(endpoint: &Url, model: &str, max_tokens: u32) -> Result<Self> {","+        let mut base = endpoint.clone();","+        if !base.path().ends_with('/') {","+            base.set_path(&format!(\"{}/\", base.path()));","+        }","+        Ok(Self {","+            client: reqwest::Client::new(),","+            provider: LazyAccountsProvider::new(endpoint.to_string()),","+            url: base.join(\"v1/chat/completions\")?,","+            model: model.to_string(),","+            max_tokens,","+        })","+    }","+","+    async fn complete(&self, messages: &[Value]) -> Result<String> {","+        let body = json!({","+            \"model\": self.model,","+            \"messages\": messages,","+            \"max_tokens\": self.max_tokens,","+        });","+        let response = self","+            .client","+            .post(self.url.clone())","+            .json(&body)","+            .send_with_payment(&self.provider)","+            .await","+            .map_err(|e| eyre!(\"request to {} failed: {e}\", self.url))?;","+        let status = response.status();","+        let text = response.text().await?;","+        if !status.is_success() {","+            return Err(eyre!(\"{} answered {status}: {text}\", self.url));","+        }","+        let value: Value =","+            serde_json::from_str(&text).wrap_err_with(|| format!(\"invalid response: {text}\"))?;","+        let message = &value[\"choices\"][0][\"message\"];","+        message[\"content\"]","+            .as_str()","+            .filter(|content| !content.trim().is_empty())","+            .or_else(|| message[\"reasoning_content\"].as_str())","+            .map(str::to_string)","+            .ok_or_else(|| eyre!(\"response has no message content: {text}\"))","+    }","+}","+","+/// Runs the tests of a model-written file in a fresh copy of the project.","+fn run_test(sandbox: &Sandbox<'_>, file: &Path, code: &str) -> Result<Run> {","+    let test = TestFile { path: file.to_path_buf(), content: code.to_string() };","+    let workspace = sandbox.workspace(&[test])?;","+    let mut command = sandbox.command(workspace.path());","+    command","+        // The traces show which contracts each test calls.","+        .args([\"test\", \"--json\", \"-vvv\", \"--no-network\", \"--restrict-inline-config\"])","+        .arg(\"--match-path\")","+        .arg(file)","+        .args(SELECT_ALL_TESTS)","+        // A fuzzed exploit must not pass on inputs that revert.","+        .env(\"FOUNDRY_FUZZ_FAIL_ON_REVERT\", \"true\");","+    let Some(output) = sandbox.output(&mut command)? else {","+        return Ok(Run::Rejected(","+            \"The tests reached the timeout; they must not loop without end.\".to_string(),","+        ));","+    };","+    if !output.status.success() && output.stdout.is_empty() {","+        return Ok(Run::Rejected(format!(","+            \"The test file did not compile or could not run:\\n{}\",","+            stderr(&output)","+        )));","+    }","+    let results = suite_results(&output)?;","+    let proven = results","+        .iter()","+        .filter(|(_, name, result)| {","+            result.status == TestStatus::Success","+                && name.starts_with(\"test_exploit\")","+                && changes_state(result)","+        })","+        .map(|(_, name, _)| name.clone())","+        .collect::<Vec<_>>();","+    if !proven.is_empty() {","+        return Ok(Run::Proven(proven));","+    }","+","+    let mut feedback = String::from(\"No test_exploit_* test passed, so nothing is proven:\\n\");","+    for (_, name, result) in &results {","+        let _ = write!(feedback, \"\\n{name}: {:?}\", result.status);","+        if let Some(reason) = &result.reason {","+            let _ = write!(feedback, \" ({reason})\");","+        } else if result.status == TestStatus::Success && !changes_state(result) {","+            feedback.push_str(","+                \" (makes no successful call that can change state into another contract, so it \\","+                 cannot show the exploit)\",","+            );","+        }","+        for log in &result.decoded_logs {","+            let _ = write!(feedback, \"\\n  {log}\");","+        }","+    }","+    if results.is_empty() {","+        feedback.push_str(\"\\nNo tests ran; name the functions test_exploit_*.\");","+    }","+    Ok(Run::Rejected(shorten(&feedback)))","+}","+","+/// Returns whether a test makes a successful plain call, which can change the callee's state,","+/// into a contract other than the test, the cheatcodes of any network, and the console. A test","+/// that does not, such as an empty one, one that only reads, or one whose calls all revert, passes","+/// whatever the target does. The tests run in another process, so the network's own list of","+/// cheatcode addresses is not at hand.","+fn changes_state(result: &TestResult) -> bool {","+    result.traces.iter().filter(|(kind, _)| *kind == TraceKind::Execution).any(|(_, arena)| {","+        let nodes = arena.arena.nodes();","+        let test = &nodes[0].trace;","+        test.success","+            && nodes[1..].iter().map(|node| &node.trace).any(|trace| {","+                trace.success","+                    && trace.kind == CallKind::Call","+                    && ![","+                        test.address,","+                        CHEATCODE_ADDRESS,","+                        MONAD_CHEATCODE_ADDRESS,","+                        HARDHAT_CONSOLE_ADDRESS,","+                    ]","+                    .contains(&trace.address)","+            })","+    })","+}","+","+fn solidity_block(reply: &str) -> Option<&str> {","+    let start = reply.find(\"```solidity\").or_else(|| reply.find(\"```sol\"))?;","+    let rest = &reply[start..];","+    let body = &rest[rest.find('\\n')? + 1..];","+    let end = body.find(\"```\").unwrap_or(body.len());","+    let code = body[..end].trim();","+    (!code.is_empty()).then_some(code)","+}","+","+fn bug_tags(code: &str) -> Vec<String> {","+    code.lines()","+        .filter_map(|line| line.trim().strip_prefix(\"//\"))","+        .map(str::trim)","+        .filter(|line| line.starts_with(\"@bug\"))","+        .map(str::to_string)","+        .collect()","+}","+","+fn read_source(path: &Path) -> Result<String> {","+    let mut source = std::fs::read_to_string(path)","+        .wrap_err_with(|| format!(\"failed to read {}\", path.display()))?;","+    if source.len() > MAX_SOURCE_BYTES {","+        source.truncate(source.floor_char_boundary(MAX_SOURCE_BYTES));","+        source.push_str(\"\\n// [truncated]\");","+    }","+    Ok(source)","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn extracts_solidity_block_and_bug_tags() {","+        let reply = \"Here:\\n```solidity\\n// SPDX-License-Identifier: UNLICENSED\\ncontract A {\\n    // @bug Vault.withdraw src/Vault.sol:12 - no reentrancy guard\\n    function test_exploit_reenter() public {}\\n}\\n```\\ndone\";","+        let code = solidity_block(reply).unwrap();","+        assert!(code.starts_with(\"// SPDX\"));","+        assert!(code.ends_with('}'));","+        assert_eq!(bug_tags(code), [\"@bug Vault.withdraw src/Vault.sol:12 - no reentrancy guard\"]);","+        assert_eq!(solidity_block(\"NO_EXPLOIT\"), None);"],"additions":438,"deletions":0,"truncated":false}],"additions":584,"deletions":2,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-30T15:55:40.939677+00:00"}