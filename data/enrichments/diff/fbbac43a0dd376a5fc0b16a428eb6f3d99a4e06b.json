8 +20,26 @@ See our [support policy](https://github.com/Azure/azure-sdk-for-js/blob/main/SUP"," "," ### Prerequisites"," ","+- OpenTelemetry SDK 3.x with `@opentelemetry/api` 1.10.0 or later. Instrumentation packages use the matching 0.300.x release line. See the [OpenTelemetry 3.x migration guide](https://github.com/open-telemetry/opentelemetry-js/blob/main/doc/3.x/migration-guide.md) when upgrading from SDK 2.x."," - An [Azure subscription](https://azure.microsoft.com/free/)"," - An [Application Insights workspace](https://learn.microsoft.com/azure/azure-monitor/app/app-insights-overview/)"," "," ### Distributed Tracing"," ","-Add the exporter to your existing OpenTelemetry Tracer Provider (`NodeTracerProvider` / `BasicTracerProvider`)","+Add the exporter to your existing OpenTelemetry `TracerProvider`. SDK 3.x requires explicit registration of the context manager and propagators, as shown below."," "," ```ts snippet:ReadmeSampleDistributedTracing"," import { AzureMonitorTraceExporter } from \"@azure/monitor-opentelemetry-exporter\";","-import { NodeTracerProvider, BatchSpanProcessor } from \"@opentelemetry/sdk-trace-node\";","+import { TracerProvider, BatchSpanProcessor } from \"@opentelemetry/sdk-trace\";"," import { resourceFromAttributes } from \"@opentelemetry/resources\";"," import { ATTR_SERVICE_NAME } from \"@opentelemetry/semantic-conventions\";","+import { trace, context, propagation } from \"@opentelemetry/api\";","+import { AsyncLocalStorageContextManager } from \"@opentelemetry/context-async-hooks\";","+import {","+  CompositePropagator,","+  W3CTraceContextPropagator,","+  W3CBaggagePropagator,","+} from \"@opentelemetry/core\";"," "," // Create an exporter instance"," const exporter = new AzureMonitorTraceExporter({","@@ -39,20 +47,27 @@ const exporter = new AzureMonitorTraceExporter({"," });"," "," // Create and configure the Node Tracer provider","-const tracerProvider = new NodeTracerProvider({","+const tracerProvider = new TracerProvider({","   resource: resourceFromAttributes({","     [ATTR_SERVICE_NAME]: \"basic-service\",","   }),","   spanProcessors: [","-    new BatchSpanProcessor(exporter, {","+    new BatchSpanProcessor({","+      exporter,","       exportTimeoutMillis: 15000,","       maxQueueSize: 1000,","     }),","   ],"," });"," ","-// Register Tracer Provider as global","-tracerProvider.register();","+// Register tracing, asynchronous context, and W3C propagation","+trace.setGlobalTracerProvider(tracerProvider);","+context.setGlobalContextManager(new AsyncLocalStorageContextManager().enable());","+propagation.setGlobalPropagator(","+  new CompositePropagator({","+    propagators: [new W3CTraceContextPropagator(), new W3CBaggagePropagator()],","+  }),","+);"," ```"," "," ### Metrics","@@ -88,7 +103,7 @@ Add the Log Exporter to your existing OpenTelemetry Logger Provider (`LoggerProv"," ```ts snippet:ReadmeSampleLogs"," import { AzureMonitorLogExporter } from \"@azure/monitor-opentelemetry-exporter\";"," import { BatchLogRecordProcessor, LoggerProvider } from \"@opentelemetry/sdk-logs\";","-import { logs } from \"@opentelemetry/api-logs\";","+import { logs } from \"@opentelemetry/api\";"," "," // Add the Log exporter into the logRecordProcessor and register it with the LoggerProvider"," const exporter = new AzureMonitorLogExporter({","@@ -109,7 +124,7 @@ logs.setGlobalLoggerProvider(loggerProvider);"," After registering the logger provider, emit an OpenTelemetry log record with the availability attributes below. The exporter converts the record to Application Insights availability telemetry."," "," ```ts snippet:ReadmeSampleAvailability","-import { logs } from \"@opentelemetry/api-logs\";","+import { logs } from \"@opentelemetry/api\";"," "," const logger = logs.getLogger(\"availability\");"," logger.emit({","@@ -146,21 +161,34 @@ You can enable sampling to limit the amount of telemetry records you receive. In"," "," ```ts snippet:ReadmeSampleSampling"," import { ApplicationInsightsSampler } from \"@azure/monitor-opentelemetry-exporter\";","-import { NodeTracerProvider } from \"@opentelemetry/sdk-trace-node\";","+import { TracerProvider } from \"@opentelemetry/sdk-trace\";"," import { resourceFromAttributes } from \"@opentelemetry/resources\";"," import { ATTR_SERVICE_NAME } from \"@opentelemetry/semantic-conventions\";","+import { trace, context, propagation } from \"@opentelemetry/api\";","+import { AsyncLocalStorageContextManager } from \"@opentelemetry/context-async-hooks\";","+import {","+  CompositePropagator,","+  W3CTraceContextPropagator,","+  W3CBaggagePropagator,","+} from \"@opentelemetry/core\";"," "," // Sampler expects a sample rate of between 0 and 1 inclusive"," // A rate of 0.75 means approximately 75 % of your traces will be sent"," const aiSampler = new ApplicationInsightsSampler(0.75);","-const provider = new NodeTracerProvider({","+const provider = new TracerProvider({","   sampler: aiSampler,","   resource: resourceFromAttributes({","     [ATTR_SERVICE_NAME]: \"basic-service\",","   }),"," });"," ","-provider.register();","+trace.setGlobalTracerProvider(provider);","+context.setGlobalContextManager(new AsyncLocalStorageContextManager().enable());","+propagation.setGlobalPropagator(","+  new CompositePropagator({","+    propagators: [new W3CTraceContextPropagator(), new W3CBaggagePropagator()],","+  }),","+);"," ```"," "," ## Examples","@@ -214,12 +242,31 @@ If gzip compression fails, the exporter logs a diagnostic warning and sends the"," You can enable debug logging by changing the logging level of your provider."," "," ```ts snippet:EnableDebugLogging","-import { NodeTracerProvider } from \"@opentelemetry/sdk-trace-node\";","-import { diag, DiagConsoleLogger, DiagLogLevel } from \"@opentelemetry/api\";","-","-const provider = new NodeTracerProvider();","+import { TracerProvider } from \"@opentelemetry/sdk-trace\";","+import {","+  diag,","+  DiagConsoleLogger,","+  DiagLogLevel,","+  trace,","+  context,","+  propagation,","+} from \"@opentelemetry/api\";","+import { AsyncLocalStorageContextManager } from \"@opentelemetry/context-async-hooks\";","+import {","+  CompositePropagator,","+  W3CTraceContextPropagator,","+  W3CBaggagePropagator,","+} from \"@opentelemetry/core\";","+","+const provider = new TracerProvider();"," diag.setLogger(new DiagConsoleLogger(), DiagLogLevel.ALL);","-provider.register();","+trace.setGlobalTracerProvider(provider);","+context.setGlobalContextManager(new AsyncLocalStorageContextManager().enable());","+propagation.setGlobalPropagator(","+  new CompositePropagator({","+    propagators: [new W3CTraceContextPropagator(), new W3CBaggagePropagator()],","+  }),","+);"," ```"," "," ### Logging"],"additions":64,"deletions":17,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/eslint.config.mjs","lines":["@@ -0,0 +1,14 @@","+import azsdkEslint from \"@azure/eslint-plugin-azure-sdk\";","+","+export default azsdkEslint.config([","+  {","+    files: [\"package.json\"],","+    rules: {","+      // OpenTelemetry SDK 3.x requires Node.js 22.15.0 or later.","+      \"@azure/azure-sdk/ts-package-json-engine-is-present\": [","+        \"error\",","+        { nodeVersionOverride: \">=22.15.0\" },","+      ],","+    },","+  },","+]);"],"additions":14,"deletions":0,"truncated":false},{"path":"sdk/monitor/monitor-opentelemetry-exporter/package.json","lines":["@@ -2,7 +2,7 @@","   \"name\": \"@azure/monitor-opentelemetry-exporter\",","   \"author\": \"Microsoft Corporation\",","   \"sdk-type\": \"client\",","-  \"version\": \"1.0.0-beta.47\",","+  \"version\": \"1.0.0-beta.48\",","   \"description\": \"Application Insights exporter for the OpenTelemetry JavaScript (Node.js) SDK\",","   \"main\": \"./dist/commonjs/index.js\",","   \"module\": \"./dist/esm/index.js\",","@@ -28,7 +28,7 @@","     \"update-snippets\": \"dev-tool run update-snippets\"","   },","   \"engines\": {","-    \"node\": \">=22.0.0\"","+    \"node\": \">=22.15.0\"","   },","   \"files\": [","     