 result = con.Query(\"SELECT current_setting('my_option')\");","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"default\"}));","+","+\t// setting the default explicitly is not the same as leaving it unset","+\tREQUIRE_NO_FAIL(con.Query(\"SET GLOBAL my_option = 'default'\"));","+\tREQUIRE(bool(config.TryGetCurrentUserSetting(setting_index, value)));","+\tREQUIRE_NO_FAIL(con.Query(\"RESET GLOBAL my_option\"));","+\tREQUIRE(!config.TryGetCurrentUserSetting(setting_index, value));","+\tresult = con.Query(\"SELECT current_setting('my_option')\");","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"default\"}));","+","+\t// RESET clears the session value, so the connection sees the global value again","+\tREQUIRE_NO_FAIL(con.Query(\"SET GLOBAL my_option = 'global'\"));","+\tREQUIRE_NO_FAIL(con.Query(\"SET my_option = 'session'\"));","+\tREQUIRE_NO_FAIL(con.Query(\"RESET my_option\"));","+\tresult = con.Query(\"SELECT current_setting('my_option')\");","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"global\"}));","+","+\t// an option without a default is unset again after RESET, not NULL","+\tconfig.AddExtensionOption(\"my_option_without_default\", \"An option\", LogicalType::BOOLEAN);","+\tREQUIRE_NO_FAIL(con.Query(\"SET my_option_without_default = true\"));","+\tREQUIRE_NO_FAIL(con.Query(\"RESET my_option_without_default\"));","+\tREQUIRE(!con.context->TryGetCurrentSetting(Identifier(\"my_option_without_default\"), value));","+}","+"," TEST_CASE(\"Test every deprecated setting warns when set\", \"[api]\") {"," \tDuckDB db(nullptr);"," \tConnection con(db);",""],"additions":36,"deletions":0,"truncated":false}],"additions":55,"deletions":18,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-12T17:15:07.653418+00:00"}