.2.3.4:443\", \"1.2.3.4:443\");","+  Network::MockIp ip;","+  std::string hostname = \"attempt-host\";","+  std::shared_ptr<const Upstream::MockHostDescription> hd =","+      std::dynamic_pointer_cast<const Upstream::MockHostDescription>(","+          attempt_stream_info.upstreamInfo()->upstreamHost());","+  EXPECT_CALL(*hd, hostname()).WillOnce(ReturnRef(hostname));","+  EXPECT_CALL(*hd, address()).WillOnce(Return(address));","+  EXPECT_CALL(*address, ip()).WillOnce(Return(&ip));","+  EXPECT_CALL(ip, port()).WillOnce(Return(443));","+  EXPECT_CALL(*alternate_protocols_cache_, setAlternatives(expected_origin, _));","+","+  EXPECT_EQ(Http::FilterHeadersStatus::Continue, filter_->encodeHeaders(headers, false));","+  filter_->onDestroy();","+}","+"," TEST_F(FilterTest, ValidAltSvcNullAddress) {","   Http::TestResponseHeaderMapImpl headers{","       {\":status\", \"200\"}, {\"alt-svc\", \"h3-29=\\\":443\\\"; ma=86400, h3=\\\":443\\\"; ma=60\"}};","@@ -173,7 +214,7 @@ TEST_F(FilterTest, ValidAltSvcNullAddress) {","       .WillRepeatedly(ReturnRef(callbacks_.stream_info_));","   callbacks_.stream_info_.upstream_cluster_info_ = info;","   EXPECT_CALL(callbacks_.stream_info_, upstreamClusterInfo()).Times(testing::AtLeast(1));","-  EXPECT_CALL(callbacks_.stream_info_, upstreamInfo()).Times(testing::AtLeast(1));","+  EXPECT_CALL(testing::Const(callbacks_.stream_info_), upstreamInfo()).Times(testing::AtLeast(1));","   // Get the pointer to MockHostDescription.","   std::shared_ptr<const Upstream::MockHostDescription> hd =","       std::dynamic_pointer_cast<const Upstream::MockHostDescription>(","@@ -239,7 +280,7 @@ TEST_F(FilterTest, ValidAltSvcNullIp) {","       .WillRepeatedly(ReturnRef(callbacks_.stream_info_));","   callbacks_.stream_info_.upstream_cluster_info_ = info;","   EXPECT_CALL(callbacks_.stream_info_, upstreamClusterInfo()).Times(testing::AtLeast(1));","-  EXPECT_CALL(callbacks_.stream_info_, upstreamInfo()).Times(testing::AtLeast(1));","+  EXPECT_CALL(testing::C