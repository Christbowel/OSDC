{"id":"afb0727afc2abc616aaea5ccdc09e48ca67284cc","axis":"silent","repo":"envoyproxy/envoy","sha":"afb0727afc2abc616aaea5ccdc09e48ca67284cc","parsed":{"files":[{"path":"api/envoy/extensions/filters/http/alternate_protocols_cache/v3/alternate_protocols_cache.proto","lines":["@@ -16,6 +16,12 @@ option (udpa.annotations.file_status).package_version_status = ACTIVE;"," // [#protodoc-title: Alternate Protocols Cache]"," "," // Configuration for the alternate protocols cache HTTP filter.","+// The filter can run in the HTTP connection manager's filter chain or as an upstream HTTP filter,","+// either in a cluster's :ref:`http_filters <envoy_v3_api_field_extensions.upstreams.http.v3.HttpProtocolOptions.http_filters>`","+// or in the router's :ref:`upstream_http_filters <envoy_v3_api_field_extensions.filters.http.router.v3.Router.upstream_http_filters>`.","+// Running it in a cluster learns alternate protocols only for that cluster, without changing any listener.","+// As an upstream filter it also caches ``alt-svc`` from responses the router discards and retries.","+// In the HTTP connection manager's filter chain it only sees the final response."," // [#extension: envoy.filters.http.alternate_protocols_cache]"," message FilterConfig {","   // This field is ignored: the alternate protocols cache filter will use the"],"additions":6,"deletions":0,"truncated":false},{"path":"changelogs/current/new_features/http3__alternate-protocols-cache-upstream-filter.rst","lines":["@@ -0,0 +1,4 @@","+The :ref:`alternate protocols cache filter <envoy_v3_api_msg_extensions.filters.http.alternate_protocols_cache.v3.FilterConfig>`","+can now be configured as an upstream HTTP filter, in a cluster's ``http_filters`` or the router's ``upstream_http_filters``.","+It caches ``alt-svc`` responses only when the cluster also sets ``alternate_protocols_cache_options``. As an upstream","+filter it also caches ``alt-svc`` from responses the router discards and retries."],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/extensions_metadata.yaml","lines":["@@ -341,8 +341,10 @@ envoy.filters.http.ai_protocol_manager:"," envoy.filters.http.alternate_protocols_cache:","   categories:","   - envoy.filters.http","+  - envoy.filters.http.upstream","   security_posture: unknown","   status: alpha","+  status_upstream: alpha","   type_urls:","   - envoy.extensions.filters.http.alternate_protocols_cache.v3.FilterConfig"," envoy.filters.http.aws_lambda:"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/alternate_protocols_cache/config.cc","lines":["@@ -33,6 +33,8 @@ AlternateProtocolsCacheFilterFactory::createHttpFilterFactoryFromProtoTyped(","  */"," REGISTER_FACTORY(AlternateProtocolsCacheFilterFactory,","                  Server::Configuration::NamedHttpFilterConfigFactory);","+REGISTER_FACTORY(UpstreamAlternateProtocolsCacheFilterFactory,","+                 Server::Configuration::UpstreamHttpFilterConfigFactory);"," "," } // namespace AlternateProtocolsCache"," } // namespace HttpFilters"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/alternate_protocols_cache/config.h","lines":["@@ -29,7 +29,11 @@ class AlternateProtocolsCacheFilterFactory","       Server::Configuration::ExtraFactoryContext& extra_context) override;"," };"," ","+// REGISTER_FACTORY names its symbols after the class, so the upstream registration needs an alias.","+using UpstreamAlternateProtocolsCacheFilterFactory = AlternateProtocolsCacheFilterFactory;","+"," DECLARE_FACTORY(AlternateProtocolsCacheFilterFactory);","+DECLARE_FACTORY(UpstreamAlternateProtocolsCacheFilterFactory);"," "," } // namespace AlternateProtocolsCache"," } // namespace HttpFilters"],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/alternate_protocols_cache/filter.cc","lines":["@@ -37,8 +37,14 @@ Http::FilterHeadersStatus Filter::encodeHeaders(Http::ResponseHeaderMap& headers","   if (alt_svc.empty()) {","     return Http::FilterHeadersStatus::Continue;","   }","+  // Upstream callbacks are only set when the filter runs in an upstream filter chain. Then read","+  // this attempt's own stream info. Otherwise it is a downstream filter, so read the request's.","+  auto upstream_callbacks = encoder_callbacks_->upstreamCallbacks();","+  const StreamInfo::StreamInfo& stream_info = upstream_callbacks.has_value()","+                                                  ? upstream_callbacks->upstreamStreamInfo()","+                                                  : encoder_callbacks_->streamInfo();","   Http::HttpServerPropertiesCacheSharedPtr cache;","-  const auto info = encoder_callbacks_->streamInfo().upstreamClusterInfo();","+  const auto info = stream_info.upstreamClusterInfo();","   if (info) {","     const auto& alternate_options = info->httpProtocolOptions().alternateProtocolsCacheOptions();","     if (alternate_options) {","@@ -67,9 +73,9 @@ Http::FilterHeadersStatus Filter::encodeHeaders(Http::ResponseHeaderMap& headers","   // Envoy routes request to upstream hosts not to origin servers directly. This choice would","   // allow HTTP/3 to be used on a per-upstream host basis, even for origins which are load","   // balanced across them.","-  const auto upstream_info = encoder_callbacks_->streamInfo().upstreamInfo();","+  const auto upstream_info = stream_info.upstreamInfo();","   Upstream::HostDescriptionConstSharedPtr host =","-      upstream_info != nullptr ? upstream_info->upstreamHost() : nullptr;","+      upstream_info.has_value() ? upstream_info->upstreamHost() : nullptr;","   if (host == nullptr) {","     // There is no upstream host, for example when a local reply carrying an alt-svc header is sent","     // before an upstream request was created. Without a host there is no origin to associate the"],"additions":9,"deletions":3,"truncated":false},{"path":"test/extensions/filters/http/alternate_protocols_cache/config_test.cc","lines":["@@ -27,6 +27,