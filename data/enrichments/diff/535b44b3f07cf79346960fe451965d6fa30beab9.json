dle));","+","+    assert!(wait_for_abort(&aborted).await, \"the unanswered check must be aborted\");","+}","+","+/// A check the registry answered before the command finished has already","+/// done its work; settling it changes nothing.","+#[tokio::test]","+async fn a_check_that_already_finished_is_left_alone() {","+    let finished = Arc::new(AtomicBool::new(false));","+    let handle = tokio::spawn({","+        let finished = Arc::clone(&finished);","+        async move { finished.store(true, Ordering::SeqCst) }","+    });","+    while !handle.is_finished() {","+        tokio::task::yield_now().await;","+    }","+","+    settle(Some(handle));","+","+    assert!(finished.load(Ordering::SeqCst), \"the check ran to completion on its own\");","+}","+"," fn state_with_last_check(value: &Value) -> Map<String, Value> {","     let Value::Object(fields) = json!({ \"lastUpdateCheck\": value }) else {","         unreachable!(\"the literal above is an object\")"],"additions":61,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/update_notifier.rs","lines":["@@ -11,8 +11,10 @@ use pnpm_testing_utils::command_env::CommandTestExt;"," use serde_json::Value;"," use std::{","     fs,","+    net::TcpListener,","     path::{Path, PathBuf},","     process::{Command, Output},","+    time::{Duration, Instant},"," };"," "," /// A pnpm the mocked registry can serve as `latest`, far enough ahead that","@@ -122,6 +124,55 @@ fn update_notifier_off_skips_the_check_entirely() {","     drop((root, npmrc_info));"," }"," ","+/// A registry that accepts the connection and never answers. The check","+/// sits in the registry client's timeouts, a minute each; the install has","+/// nothing else to do and does not wait for it. Nothing was learned, so","+/// nothing is recorded and the next install asks again","+/// ([#16839](https://github.com/pnpm/pnpm/issues/16839)).","+#[test]","+fn a_registry_that_never_answers_does_not_hold_the_install() {","+    let Fixture {","+        pacquet,","+        state_dir,","+        root,","+        npmrc_info,","+        ..","+    } = fixture();","+    let listener = TcpListener::bind(\"127.0.0.1:0\").expect(\"bind the silent registry\");","+    let silent_registry =","+        format!(\"http://{}/\", listener.local_addr().expect(\"silent registry address\"));","+    // Every connection is accepted and held open without an answer; the","+    // thread ends with the test process.","+    std::thread::spawn(move || {","+        let mut held = Vec::new();","+        for connection in listener.incoming() {","+            held.extend(connection.ok());","+        }","+    });","+    fs::write(","+        &npmrc_info.npmrc_path,","+        format!(","+            \"registry={silent_registry}\\nstore-dir=../pacquet-store\\ncache-dir=../pacquet-cache\\n\",","+        ),","+    )","+    .expect(\"point .npmrc at the silent registry\");","+","+    let started = Instant::now();","+    let output = install(pacquet, &state_dir);","+    let elapsed = started.elapsed();","+","+    let text = output_text(&output);","+    assert!(output.status.success(), \"install should succeed: {text}\");","+    assert!(","+        elapsed < Duration::from_secs(30),","+        \"the install waited {elapsed:?} on a registry that never answered: {text}\",","+    );","+    assert!(!text.contains(\"Update available!\"), \"nothing was learned: {text}\");","+    assert!(!state_file(&state_dir).exists(), \"an unanswered check records nothing\");","+","+    drop((root, npmrc_info));","+}","+"," /// The recorded timestamp is what keeps the check to once a day, so a"," /// fresh one silences the very next install."," #[test]"],"additions":51,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run.rs","lines":["@@ -2,7 +2,8 @@ pub(super) use fast_path::register_workspace_in_store;"," "," mod fast_path;"," use fast_path::{","-    RepeatInstallVerdict, UpToDateCheck, repeat_install_verdict, report_already_up_to_date,","+  