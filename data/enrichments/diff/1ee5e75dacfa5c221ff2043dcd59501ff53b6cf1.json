{"id":"1ee5e75dacfa5c221ff2043dcd59501ff53b6cf1","axis":"silent","repo":"omniauth/omniauth","sha":"1ee5e75dacfa5c221ff2043dcd59501ff53b6cf1","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -22,6 +22,7 @@ versioned together, so those entries cover all of them."," ### Changed"," - `omniauth.params` now includes params posted to the request phase's form, not just its query string, so they survive the POST-only request phase introduced in 2.0. The `authenticity_token` param is never included (see CVE-2017-18076 under 1.3.2). If your request form posts other fields, they now appear in `omniauth.params` and are stored in the session until the callback. ([#975](https://github.com/omniauth/omniauth/issues/975))"," - `OmniAuth::Builder` builds its middleware stack on the first request and reuses it, instead of rebuilding every strategy on every request. Providers added after the first request are ignored. ([#1083](https://github.com/omniauth/omniauth/issues/1083), [#970](https://github.com/omniauth/omniauth/issues/970))","+- `Strategy#call` sends a request that isn't on the strategy's request or callback path straight to the app, instead of duplicating the strategy for it. It still duplicates it in test mode, with an `other_phase`, with path lambdas, or when the strategy overrides how `#call!` dispatches. ([#1172](https://github.com/omniauth/omniauth/pull/1172))"," - Require Ruby 2.5 or later (was 2.2). ([#1167](https://github.com/omniauth/omniauth/pull/1167))"," - Require Rack 2.2.8 or later (was 2.2.3), rack-protection 2.2.0 or later, and hashie 3.5.2 or later (was 3.4.6)."," - The gem now contains only `lib`, `sig`, the license, the README, the changelog, and the security policy."],"additions":1,"deletions":0,"truncated":false},{"path":"lib/omniauth/strategy.rb","lines":["@@ -75,9 +75,12 @@ def log(level, message)","       OmniAuth.logger.public_send(level, \"(#{name}) #{message}\")","     end"," ","-    # Duplicates this instance and runs #call! on it.","+    # Duplicates this instance and runs #call! on it. A request that can't be","+    # the strategy's goes straight to the app instead, skipping the copy.","     # @param [Hash] The Rack environment.","     def call(env)","+      return @app.call(env) if passthrough?(env)","+","       dup.call!(env)","     end"," ","@@ -324,5 +327,32 @@ def initialize_copy(*args)","       super","       @options = @options.dup","     end","+","+    # True when #call! would only hand env to the app: there's a session, the","+    # path alone decides, and env isn't on the strategy's paths. The","+    # strategy's own path methods check, on a copy that shares its options.","+    def passthrough?(env)","+      return false unless env['rack.session'] && dispatch_by_path?","+      return false if path_probe(env).on_auth_path?","+","+      true","+    end","+","+    # True when OmniAuth's own dispatch runs, with no test mode or","+    # other_phase, and no path lambdas, which would otherwise run twice on","+    # the strategy's own paths.","+    def dispatch_by_path?","+      self.class.default_dispatch? && !OmniAuth.config.test_mode && !respond_to?(:other_phase) &&","+        !options[:request_path].respond_to?(:call) && !options[:callback_path].respond_to?(:call)","+    end","+","+    # A copy like #dup makes, but sharing this instance's options, so the","+    # path methods can memoize on it instead of on this shared instance.","+    def path_probe(env)","+      probe = self.class.allocate","+      instance_variables.each { |ivar| probe.instance_variable_set(ivar, instance_variable_get(ivar)) }","+      probe.instance_variable_set(:@env, env)","+      probe","+    end","   end"," end"],"additions":31,"deletions":1,"truncated":false},{"path":"lib/omniauth/strategy/class_methods.rb","lines":["@@ -1,6 +1,17 @@"," module OmniAuth","   module Strategy","     module ClassMethods","+      DISPATCH_METHODS = %i[call! phase_call options_call? request_call? on_auth_path?].freeze","+","+      # True when requests are dispatched by OmniAuth's own #call! and its","+      # phase checks, so #call can tell which ones would go to the app.","+      # They may live in Strategy or in a module it includes, like Paths.","+      def default_dispatch?","+        return @default_dispatch if instance_variable_defined?(:@default_dispatch)","+","+        @default_dispatch = DISPATCH_METHODS.all? { |m| Strategy.ancestors.include?(instance_method(m).owner) }","+      end","+","       # Returns an inherited set of default options set at the class-level","       # for each strategy.","       def default_options"],"additions":11,"deletions":0,"truncated":false},{"path":"sig/omniauth.rbs","lines":["@@ -298,6 +298,11 @@ module OmniAuth","     module ClassMethods","       @default_options: Options?","       @args: Array[Symbol]?","+      @default_dispatch: bool","+","+      DISPATCH_METHODS: Array[Symbol]","+","+      def default_dispatch?: () -> bool"," ","       def default_options: () -> Options"," ","@@ -333,6 +338,10 @@ module OmniAuth","       def superclass: () -> Class?","       def name: () -> String?","       def class_eval: (String code, ?String file, ?Integer line) -> untyped","+      def instance_method: (Symbol name) -> UnboundMethod","+","+      # Defined by Class.","+      def allocate: () -> Strategy"," ","       private"," ","@@ -523,6 +532,12 @@ module OmniAuth","     def run_hook: (Symbol name) -> void"," ","     def initialize_copy: (*untyped) -> void","+","+    def passthrough?: (env env) -> bool","+","+    def dispatch_by_path?: () -> bool","+","+    def path_probe: (env env) -> Strategy","   end"," ","   module Strategies"],"additions":15,"deletions":0,"truncated":false},{"path":"spec/omniauth/strategy/class_methods_spec.rb","lines":["@@ -16,6 +16,21 @@","     end","   end"," ","+  context 'default_dispatch?' do","+    it 'looks the dispatch methods up once per class' do","+      expect(strategy_class).to receive(:instance_method).exactly(described_class::ClassMethods::DISPATCH_METHODS.size).times.and_call_original","+      expect(strategy_class.default_dispatch?).to be(true)","+      expect(strategy_class.default_dispatch?).to be(true)","+    end","+","+    it 'remembers a false answer too' do","+      overriding = Class.new(strategy_class) { define_method(:call!) { |env| super(env) } }","+      expect(overriding.default_dispatch?).to be(false)","+      expect(overriding).not_to receive(:instance_method)","+      expect(overriding.default_dispatch?).to be(false)","+    end","+  end","+","   context 'args' do","     it 'returns nil when setting args' do","       expect(strategy_class.args(%i[abc])).to be_nil"],"additions":15,"deletions":0,"truncated":false},{"path":"spec/omniauth/strategy_spec.rb","lines":["@@ -401,12 +401,145 @@ def message","   end"," ","   describe '#call' do","-    it 'duplicates and calls' do","+    it 'duplicates and calls on its own paths' do","       klass = Class.new","       klass.send :include, OmniAuth::Strategy","+      klass.option :name, 'dup_test'","       instance = klass.new(app)","       expect(instance).to receive(:dup).and_return(instance)","-      instance.call('rack.session' => {})","+      instance.call(make_env('/auth/dup_test/callback'))","+    end","+","+    context 'with requests that are not the strategy\\'s' do","+      let(:klass) do","+        Class.new do","+          include OmniAuth::Strategy","+","+          option :name, 'pass'","+","+          def request_phase","+            [200, {}, ['request phase']]","+          end","+","+          def callback_phase","+            [200, {}, ['callback phase']]","+          end","+        end","+      end","+      let(:seen) { [] }","+      let(:inner) do","+        ->(env) {","+          seen << env","+          [200, {}, ['app']]","+        }","+      end","+","+      [{}, {:request_path => '/login'}, {:callback_path => '/login/done'}].each do |options|","+        it \"sends them to the app without duplicating the strategy, given #{options}\" do","+          instance = klass.new(inner, options)","+          expect(instance).not_to receive(:dup)","+          env = make_env('/trips/1', 'REQUEST_METHOD' => 'GET')","+          expect(instance.call(env)).to eq([200, {}, ['app']])","+          expect(seen).to eq([env])","+          expect(env).not_to have_key('omniauth.strategy')","+        end","+      end","+","+      it 'still raises NoSessionError when rack.session is nil' do","+        expect { klass.new(inner).call(make_env('/trips/1', 'rack.session' => nil)) }.to raise_error(OmniAuth::NoSessionError)","+      end","+","+      it 'leaves nothing memoized on the shared instance' do","+        instance = klass.new(inner)","+        instance.call(make_env('/trips/1', 'REQUEST_METHOD' => 'GET'))","+        expect(instance.instance_variables).to match_array(%i[@app @env @options])","+        expect(instance.instance_variable_get(:@env)).to be_nil","+      end","+","+      it 'answers every request the way dup.call! does' do","+        configs = [","+          {},","+          {:request_path => '/login', :callback_path => '/login/done'},","+          {:request_path => '/login'},","+          {:path_prefix => '/sso'}","+        ]","+        paths = ['/', '/trips/1', '/auth', '/auth/pass', '/auth/pass/', '/AUTH/Pass', '/auth//pass',","+                 '/auth/pass/callback', '/auth/pass/callback.json', '/auth/pass/callback/x', '/auth/passx',","+                 '/login', '/login/done', '/login/done.json', '/sso/pass', '/sso/pass/callback']","+        configs.product(paths, ['', '/mounted'], %w[GET POST OPTIONS]).each do |options, path, script_name, method|","+          path_info = path.delete_prefix(script_name)","+          instance = klass.new(inner, options)","+          env = make_env(path_info, 'SCRIPT_NAME' => script_name, 'REQUEST_METHOD' => method)","+          reference_env = make_env(path_info, 'SCRIPT_NAME' => script_name, 'REQUEST_METHOD' => method)","+","+          expect(instance.call(env)).to eq(instance.dup.call!(reference_env)), \"#{options} #{script_name}#{path} #{method}\"","+          expect(env.keys).to eq(reference_env.keys), \"#{options} #{script_name}#{path} #{method}\"","+        end","+      end","+","+      shared_examples 'duplicating the strategy' do |path = '/trips/1'|","+        it 'runs them through a copy of the strategy' do","+          expect(instance).to receive(:dup).and_call_original","+          instance.call(make_env(path, 'REQUEST_METHOD' => 'GET'))","+        end","+      end","+","+      context 'when the strategy matches paths itself' do","+        let(:instance) do","+          Class.new(klass) do","+            def on_callback_path?","+              current_path.end_with?('/sso')","+            end","+          end.new(inner)","+        end","+","+        it 'still reaches the strategy on them' do","+          expect(instance.call(make_env('/accounts/sso', 'REQUEST_METHOD' => 'GET'))).to eq([200, {}, ['callback phase']])","+        end","+      end","+","+      %i[call! phase_call options_call? request_call? on_auth_path?].each do |method_name|","+        context \"when the strategy overrides ##{method_name}\" do","+          let(:instance) do","+            Class.new(klass) { define_method(method_name) { |*args| super(*args) } }.new(inner)","+          end","+","+          include_examples 'duplicating the strategy'","+        end","+      end","+","+      context 'when the strategy has an other_phase' do","+        let(:instance) do","+          Class.new(klass) do","+            def other_phase","+              call_app!","+            end","+          end.new(inner)","+        end","+","+        include_examples 'duplicating the strategy'","+      end","+","+      %i[request_path callback_path].each do |option|","+        context \"when :#{option} is a lambda\" do","+          let(:instance) { klass.new(inner, option => ->(env) { env['PATH_INFO'] == '/x' }) }","+","+          include_examples 'duplicating the strategy'","+        end","+      end","+","+      context 'when test mode is on' do","+        let(:instance) { klass.new(inner) }","+","+        around do |example|","+          OmniAuth.config.test_mode = true","+          example.run","+        ensure","+          OmniAuth.config.test_mode = false","+        end","+","+        include_examples 'duplicating the strategy'","+      end","     end"," ","     it 'raises NoSessionError if rack.session isn\\'t set' do",""],"additions":135,"deletions":2,"truncated":false}],"additions":208,"deletions":3,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-21T13:29:23.125896+00:00"}