e.Contains(t, resp.BodyDomains.Fqdns, \"body.example.org\")","+\t})","+","+\tt.Run(\"nothing extracted by default\", func(t *testing.T) {","+\t\tresp := do(t, DefaultOptions)","+\t\trequire.Nil(t, resp.CSPData)","+\t\trequire.Nil(t, resp.BodyDomains)","+\t})","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"common/httpx/option.go","lines":["@@ -42,6 +42,8 @@ type Options struct {"," \tCdnCheck    string"," \tExcludeCdn  bool"," \tExtractFqdn bool","+\t// ExtractCSP extracts the domains of the Content-Security-Policy","+\tExtractCSP bool"," \t// Timeout is the maximum time to wait for the request"," \tTimeout time.Duration"," \t// RetryMax is the maximum number of retries"],"additions":2,"deletions":0,"truncated":false},{"path":"runner/csp_test.go","lines":["@@ -0,0 +1,52 @@","+package runner","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+// -csp-probe probes the domains of the Content-Security-Policy, so it must","+// have them extracted without -efqdn, which also adds the domains of the body.","+func TestCSPProbeExtractsCSPDomains(t *testing.T) {","+\tr, err := New(&Options{CSPProbe: true})","+\trequire.NoError(t, err)","+\tdefer r.Close()","+\trequire.True(t, r.hp.Options.ExtractCSP)","+\trequire.False(t, r.hp.Options.ExtractFqdn)","+}","+","+// Every input with a CSP gets its CSP domains probed, not only the first one,","+// even though the probes of the first one turn -csp-probe off for themselves.","+func TestCSPProbeProbesCSPDomainsOfEveryTarget(t *testing.T) {","+\tcspServer := func(domain string) string {","+\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\t\tw.Header().Set(\"Content-Security-Policy\", \"default-src 'self' https://cdn.\"+domain)","+\t\t}))","+\t\tt.Cleanup(srv.Close)","+\t\treturn strings.TrimPrefix(srv.URL, \"http://\")","+\t}","+","+\toptions := &Options{","+\t\tThreads:         5,","+\t\tRateLimit:       100,","+\t\tRetries:         0,","+\t\tTimeout:         2,","+\t\tMethods:         http.MethodGet,","+\t\tDelay:           -1,","+\t\tCSPProbe:        true,","+\t\tInputTargetHost: []string{cspServer(\"csp-one.invalid\"), cspServer(\"csp-two.invalid\")},","+\t}","+","+\tr, err := New(options)","+\trequire.NoError(t, err)","+\tdefer r.Close()","+\tr.RunEnumeration()","+","+\tfor _, domain := range []string{\"csp-one.invalid\", \"cdn.csp-one.invalid\", \"csp-two.invalid\", \"cdn.csp-two.invalid\"} {","+\t\trequire.True(t, r.seen(domain), \"CSP domain %s was not probed\", domain)","+\t}","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"runner/runner.go","lines":["@@ -230,6 +230,8 @@ func New(options *Options) (*Runner, error) {"," \thttpxOptions.CdnCheck = options.OutputCDN"," \thttpxOptions.ExcludeCdn = runner.excludeCdn"," \thttpxOptions.ExtractFqdn = options.ExtractFqdn","+\t// -csp-probe probes the domains of the CSP, so it needs them extracted","+\thttpxOptions.ExtractCSP = options.CSPProbe"," \tif options.CustomHeaders.Has(\"User-Agent:\") {"," \t\thttpxOptions.RandomAgent = false"," \t} else {","@@ -1770,15 +1772,7 @@ func (r *Runner) process(line targetLine, wg *syncutil.AdaptiveWaitGroup, hp *ht"," \t\t\t\t\t\t\tr.probeTLSNames(result, wg, hp, protocol, scanopts, output)"," \t\t\t\t\t\t}"," \t\t\t\t\t\tif scanopts.CSPProbe && result.CSPData != nil {","-\t\t\t\t\t\t\tscanopts.CSPProbe = false","-\t\t\t\t\t\t\tdomains := result.CSPData.Domains","-\t\t\t\t\t\t\tdomains = append(domains, result.CSPData.Fqdns...)","-\t\t\t\t\t\t\tfor _, tt := range domains {","-\t\t\t\t\t\t\t\tif !r.testAndSet(tt) {","-\t\t\t\t\t\t\t\t\tcontinue","-\t\t\t\t\t\t\t\t}","-\t\t\t\t\t\t\t\tr.process(targetLine{Target: tt}, wg, hp, protocol, scanopts, output)","-\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tr.probeCSPDomains(result, wg, hp, protocol, scanopts, output)"," \t\t\t\t\t\t}"," \t\t\t\t\t}(target, method, prot)"," \t\t\t\t}","@@ -1835,6 +1829,22 @@ func (r *Runner) probeTLSNames(result Result, wg *syncutil.AdaptiveWaitGroup, hp"," \t}"," }"," ","+// probeCSPDomains probes the domains of the CSP of result, for -csp-probe.","+// scanopts is shared by every target, so only the copy given to the probes","+// turns -csp-probe off, which stops them from probing their own CSP domains.","+// The copy is a plain struct copy: ScanOptions.Clone leaves out some fields,","+// such as ExcludeCDN and ProbeAllIPS, which the probes still need.","+func (r *Runner) probeCSPDomains(result Result, wg *syncutil.AdaptiveWaitGroup, hp *httpx.HTTPX, protocol string, scanopts *ScanOptions, output chan Result) {","+\tprobeopts := *scanopts","+\tprobeopts.CSPProbe = false","+\tdomains := append(slices.Clone(result.CSPData.Domains), result.CSPData.Fqdns...)","+\tfor _, domain := range domains {","+\t\tif r.testAndSet(domain) {","+\t\t\tr.process(targetLine{Target: domain}, wg, hp, protocol, &probeopts, output)","+\t\t}","+\t}","+}","+"," // targetsOf returns the targets of an input: the target of a line pinned to an"," // ip, or the targets of a plain input."," func (r *Runner) targetsOf(hp *httpx.HTTPX, line targetLine) chan httpx.Target {",""],"additions":19,"deletions":9,"truncated":false}],"additions":141,"deletions":11,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-07T15:04:05.364529+00:00"}