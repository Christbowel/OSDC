NDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package defkit","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"strings\"","+","+\t\"cuelang.org/go/cue\"","+\t\"cuelang.org/go/cue/ast\"","+\t\"cuelang.org/go/cue/cuecontext\"","+\t\"cuelang.org/go/cue/format\"","+\t\"cuelang.org/go/cue/parser\"","+","+\t\"github.com/oam-dev/kubevela/pkg/definition/inherit\"","+)","+","+// inheritance is what a component or trait declares about the definition it","+// extends.","+type inheritance struct {","+\textends  string","+\tabstract bool","+\t// reference marks a placeholder for a definition installed elsewhere, made","+\t// by ComponentRef or TraitRef. It is extended, never registered.","+\treference bool","+}","+","+// GetExtends returns the name, and pinned revision if any, of the definition","+// this one extends.","+func (i *inheritance) GetExtends() string { return i.extends }","+","+// IsAbstract reports whether the definition may only be extended, not used.","+func (i *inheritance) IsAbstract() bool { return i.abstract }","+","+// writeInheritance writes extends and abstract as attributes.","+func writeInheritance(sb *strings.Builder, i inheritance, indent string) {","+\tif i.extends != \"\" {","+\t\tsb.WriteString(fmt.Sprintf(\"%sextends: %q\\n\", indent, i.extends))","+\t}","+\tif i.abstract {","+\t\tsb.WriteString(fmt.Sprintf(\"%sabstract: true\\n\", indent))","+\t}","+}","+","+// setInheritanceSpec copies extends and abstract into a ToYAML spec.","+func setInheritanceSpec(spec map[string]any, i inheritance) {","+\tif i.extends != \"\" {","+\t\tspec[\"extends\"] = i.extends","+\t}","+\tif i.abstract {","+\t\tspec[\"abstract\"] = true","+\t}","+}","+","+// --- ComponentDefinition ---","+","+// Extends makes the component render on top of parent. The template calls the","+// parent through Super, and its output and outputs merge onto the parent's.","+// Parameters are not inherited: declare the ones this component takes.","+func (c *ComponentDefinition) Extends(parent *ComponentDefinition) *ComponentDefinition {","+\tc.parent = parent","+\tc.inheritance.extends = parent.GetName()","+\treturn c","+}","+","+// ComponentRef refers to a component installed elsewhere, such as a built-in,","+// for Extends. The name may pin a revision, as \"webservice@v3\", and is written","+// into extends as given. Supply the parent's CUE with WithCUE to have Register","+// check the call and EvaluateCUE render the chain; without it, both are left to","+// the cluster.","+func ComponentRef(name string) *ComponentDefinition {","+\tc := NewComponent(name)","+\tc.inheritance.reference = true","+\treturn c","+}","+","+// WithCUE gives a ComponentRef the CUE of the definition it refers to. It is a","+// copy for checking and testing; the cluster resolves the installed one.","+func (c *ComponentDefinition) WithCUE(src string) *ComponentDefinition {","+\tif !c.reference {","+\t\tpanic(fmt.Sprintf(\"defkit: WithCUE is for a ComponentRef; component %s is a definition of its own, so use RawCUE\", c.GetName()))","+\t}","+\tc.setRawCUE(src)","+\treturn c","+}","+","+// Abstract marks the component as one to extend, which an Application may not","+// name directly.","+func (c *ComponentDefinition) Abstract() *ComponentDefinition {","+\tc.inheritance.abstract = true","+\treturn c","+}","+","+// GetParent returns the component this one extends, or nil when it extends","+// nothing or only a name.","+func (c *ComponentDefinition) GetParent() *ComponentDefinition { return c.parent }","+","+// hasDeclaredWorkload reports whether the component names its own workload,","+// rather than taking its parent's.","+func (c *ComponentDefinition) hasDeclaredWorkload() bool {","+\tw := c.workload","+\treturn w.autodetect || w.apiVersion != \"\" || w.kind != \"\"","+}","+","+// validateDefinition refuses to register a reference, and checks the call to a","+// parent with a template the way admission does.","+func (c *ComponentDefinition) validateDefinition() error {","+\tif c.reference {","+\t\treturn errReference(\"ComponentRef\", c.GetName())","+\t}","+\tif c.parent == nil || !hasTemplate(c.parent) {","+\t\treturn nil","+\t}","+\treturn checkCall(c, c.parent, inherit.ComponentSurface)","+}","+","+// componentChain returns the component and every typed ancestor, child first.","+func componentChain(c *ComponentDefinition) ([]inherit.Level, error) {","+\tvar chain []inherit.Level","+\tseen := map[*ComponentDefinition]bool{}","+\tfor d := c; d != nil; d = d.parent {","+\t\tif seen[d] {","+\t\t\treturn nil, fmt.Errorf(\"%s extends itself through %s, so it cannot be rendered\", c.GetName(), d.GetName())","+\t\t}","+\t\tseen[d] = true","+\t\tif !hasTemplate(d) {","+\t\t\treturn nil, fmt.Errorf(\"%s extends %s, which has no template here to render it on; supply it with ComponentRef(%q).WithCUE(...)\",","+\t\t\t\tc.GetName(), d.GetName(), d.GetName())","+\t\t}","+\t\tlevel, err := levelOf(d)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tchain = append(chain, level)","+\t}","+\treturn chain, nil","+}","+","+// --- TraitDefinition ---","+","+// Extends makes the trait render on top of parent. The template calls the","+// parent through Super, and its patch, patchOutputs, outputs and processing","+// merge onto the parent's. Parameters are not inherited.","+func (t *TraitDefinition) Extends(parent *TraitDefinition) *TraitDefinition {","+\tt.parent = parent","+\tt.inheritance.extends = parent.GetName()","+\treturn t","+}","+","+// TraitRef refers to a trait installed elsewhere, for Extends. The name may pin","+// a revision, as \"labels@v2\". Supply the parent's CUE with WithCUE to have","+// Register check the call.","+func TraitRef(name string) *TraitDefinition {","+\tt := NewTrait(name)","+\tt.inheritance.reference = true","+\treturn t","+}","+","+// WithCUE gives a TraitRef the CUE of the definition it refers to. It is a copy","+// for checking and testing; the cluster resolves the installed one.","+func (t *TraitDefinition) WithCUE(src string) *TraitDefinition {","+\tif !t.reference {","+\t\tpanic(fmt.Sprintf(\"defkit: WithCUE is for a TraitRef; trait %s is a definition of its own, so use RawCUE\", t.GetName()))","+\t}","+\tt.setRawCUE(src)","+\treturn t","+}","+","+// Abstract marks the trait as one to extend, which an Application may not","+// name directly.","+func (t *TraitDefinition) Abstract() *TraitDefinition {","+\tt.inheritance.abstract = true","+\treturn t","+}","+","+// GetParent returns the trait this one extends, or nil when it extends","+// nothing or only a name.","+func (t *TraitDefinition) GetParent() *TraitDefinition { return t.parent }","+","+// validateDefinition refuses to register a reference, and checks the call to a","+// parent with a template the way admission does.","+func (t *TraitDefinition) validateDefinition() error {","+\tif t.reference {","+\t\treturn errReference(\"TraitRef\", t.GetName())","+\t}","+\tif t.parent == nil || !hasTemplate(t.parent) {","+\t\treturn nil","+\t}","+\treturn checkCall(t, t.parent, inherit.TraitSurface)","+}","+","+// --- Template ---","+","+// SuperCall is what a child passes its parent, written as `$super: properties`","+// and checked against the parent's parameters.","+type SuperCall struct {","+\tres *Resource","+}","+","+// Set passes a value for one of the parent's parameters. Dotted paths set a","+// field of a struct parameter.","+func (s *SuperCall) Set(path string, v Value) *SuperCall {","+\ts.res.Set(path, v)","+\treturn s","+}","+","+// SetIf passes a value only when the condition holds.","+func (s *SuperCall) SetIf(cond Condition, path string, v Value) *SuperCall {","+\ts.res.SetIf(cond, path, v)","+\treturn s","+}","+","+// Super calls the parent of a definition that extends one. Every child calls","+// it, even with nothing to pass.","+func (t *Template) Super() *SuperCall {","+\tif t.super == nil {","+\t\tt.super = &SuperCall{res: &Resource{}}","+\t}","+\treturn t.super","+}","+","+// Inherit turns merging onto the parent's output wholly on or off. Off, the","+// child produces only what it writes, and reads the parent through SuperOutput.","+func (t *Template) Inherit(enabled bool) *Template {","+\tt.inheritAll = &enabled","+\treturn t","+}","+","+// InheritField turns merging on or off for one surface field, such as","+// \"outputs\" or \"patch\".","+func (t *Template) InheritField(field string, enabled bool) *Template {","+\tif t.inheritFields == nil {","+\t\tt.inheritFields = map[string]bool{}","+\t}","+\tt.inheritFields[field] = enabled","+\treturn t","+}","+","+// SuperOutput reads the parent's rendered output at a dotted path, or the","+// whole output when path is empty.","+func SuperOutput(path string) *Ref { return superRef(\"output\", path) }","+","+// SuperOutputs reads one of the parent's rendered outputs at a dotted path.","+func SuperOutputs(name, path string) *Ref { return superRef(\"outputs.\"+cueLabel(name), path) }","+","+// SuperPatch reads the parent trait's patch at a dotted path.","+func SuperPatch(path string) *Ref { return superRef(\"patch\", path) }","+","+func superRef(field, path string) *Ref {","+\tref := inherit.SuperField + \".\" + field","+\tif path != \"\" {","+\t\tref += \".\" + path","+\t}","+\treturn Reference(ref)","+}","+","+// writeInheritanceBlock writes the template's `$super` call and `$inherit`.","+func (g *CUEGenerator) writeInheritanceBlock(sb *strings.Builder, tpl *Template, depth int) {","+\tindent := strings.Repeat(g.indent, depth)","+\tif s := tpl.super; s != nil {","+\t\tif len(s.res.Ops()) == 0 {","+\t\t\tsb.WriteString(fmt.Sprintf(\"%s%s: %s: {}\\n\", indent, inherit.SuperField, inherit.PropertiesField))","+\t\t} else {","+\t\t\tsb.WriteString(fmt.Sprintf(\"%s%s: %s: {\\n\", indent, inherit.SuperField, inherit.PropertiesField))","+\t\t\tg.writeFieldTree(sb, g.buildFieldTree(s.res.Ops()), depth+1)","+\t\t\tsb.WriteString(fmt.Sprintf(\"%s}\\n\", indent))","+\t\t}","+\t}","+\tif tpl.inheritAll != nil {","+\t\tsb.WriteString(fmt.Sprintf(\"%s$inherit: %v\\n\", indent, *tpl.inheritAll))","+\t}","+\tfor _, field := range sortedKeys(tpl.inheritFields) {","+\t\tsb.WriteString(fmt.Sprintf(\"%s$inherit: %s: %v\\n\", indent, cueLabel(field), tpl.inheritFields[field]))","+\t}","+}","+","+// --- Rendering and checking a chain ---","+","+// errReference refuses to register a placeholder for an installed definition.","+func errReference(constructor, name string) error {","+\treturn fmt.Errorf(\"%s(%q) refers to a definition installed elsewhere, so it is extended, not registered; register the definition that extends it\", constructor, name)","+}","+","+// hasTemplate reports whether a parent can be rendered here: a definition built","+// with defkit always can, a reference only once given its CUE.","+func hasTemplate(def interface {","+\tisReference() bool","+\tHasRawCUE() bool","+}) bool {","+\treturn !def.isReference() || def.HasRawCUE()","+}","+","+func (i *inheritance) isReference() bool { return i.reference }","+","+// cueOf returns the CUE a chain level is taken from: a reference's as supplied,","+// any other definition's as generated.","+func cueOf(def Definition) string {","+\tif r, ok := def.(interface {","+\t\tisReference() bool","+\t\tGetRawCUE() string","+\t}); ok && r.isReference() {","+\t\treturn r.GetRawCUE()","+\t}","+\treturn def.ToCue()","+}","+","+// levelOf returns a definition as one level of a chain: its name and the","+// template the controller stores for it.","+func levelOf(def Definition) (inherit.Level, error) {","+\tbody, err := templateBody(cueOf(def))","+\tif err != nil {","+\t\treturn inherit.Level{}, fmt.Errorf(\"%s %s: %w\", def.DefType(), def.DefName(), err)","+\t}","+\treturn inherit.Level{Name: def.DefName(), Template: body}, nil","+}","+","+// templateBody returns the imports and the contents of a generated","+// definition's template block, which is what a render compiles.","+func templateBody(src string) (string, error) {","+\tf, err := parser.ParseFile(\"definition.cue\", src)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\tvar imports, body []ast.Decl","+\tfor _, decl := range f.Decls {","+\t\tswitch d := decl.(type) {","+\t\tcase *ast.ImportDecl:","+\t\t\timports = append(imports, d)","+\t\tcase *ast.Field:","+\t\t\tif name, _, _ := ast.LabelName(d.Label); name != \"template\" {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tst, ok := d.Value.(*ast.StructLit)","+\t\t\tif !ok {","+\t\t\t\treturn \"\", fmt.Errorf(\"template is not a struct\")","+\t\t\t}","+\t\t\tbody = append(body, st.Elts...)","+\t\t}","+\t}","+\tbs, err := format.Node(&ast.File{Decls: append(imports, body...)})","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\treturn string(bs), nil","+}","+","+// compileOpen compiles a template as admission does, with `context` and","+// `parameter` opened so a template reading them compiles on its own.","+func compileOpen(_ context.Context, src string) (cue.Value, error) {","+\tv := cuecontext.New().CompileString(src + \"\\ncontext: _\\nparameter: _\\n\")","+\treturn v, v.Err()","+}","+","+// compileLevel compiles one level of a render, whose parameter and context","+// files are already joined to it.","+func compileLevel(_ context.Context, src string) (cue.Value, error) {","+\tv := cuecontext.New().CompileString(src)","+\treturn v, v.Err()","+}","+","+// checkCall runs the admission check on a child's call to its parent.","+func checkCall(child, parent Definition, s inherit.Surface) error {","+\tself, err := levelOf(child)","+\tif err != nil {","+\t\treturn err","+\t}","+\tup, err := levelOf(parent)","+\tif err != nil {","+\t\treturn err","+\t}","+\t_, err = inherit.CheckCall(context.Background(), []inherit.Level{self, up}, s, compileOpen)","+\treturn err","+}"],"additions":388,"deletions":0,"truncated":false},{"path":"pkg/definition/defkit/inheritance_test.go","lines":["@@ -0,0 +1,264 @@