c.template.spec.containers[0].image\", defkit.ParamRef(\"image\")))","+\t\t\t})","+\t}","+","+\ttenantWeb := func(parent *defkit.ComponentDefinition) *defkit.ComponentDefinition {","+\t\treturn defkit.NewComponent(\"tenant-web\").","+\t\t\tExtends(parent).","+\t\t\tParams(defkit.String(\"image\"), defkit.String(\"tenant\")).","+\t\t\tTemplate(func(tpl *defkit.Template) {","+\t\t\t\ttpl.Super().Set(\"image\", defkit.ParamRef(\"image\"))","+\t\t\t\ttpl.Output(defkit.NewResource(\"apps/v1\", \"Deployment\").","+\t\t\t\t\tSet(\"metadata.labels[tenant.oam.dev/name]\", defkit.ParamRef(\"tenant\")))","+\t\t\t\ttpl.Outputs(\"tenantConfig\", defkit.NewResource(\"v1\", \"ConfigMap\").","+\t\t\t\t\tSet(\"metadata.name\", defkit.Interpolation(vela.Name(), defkit.Lit(\"-tenant\"))).","+\t\t\t\t\tSet(\"data.tenant\", defkit.ParamRef(\"tenant\")).","+\t\t\t\t\tSet(\"data.parent\", defkit.SuperOutput(\"metadata.name\")))","+\t\t\t})","+\t}","+","+\t// webserviceRef references the built-in webservice, with the CUE it ships.","+\twebserviceRef := func() *defkit.ComponentDefinition {","+\t\tsrc, err := os.ReadFile(\"../../../vela-templates/definitions/internal/component/webservice.cue\")","+\t\tExpect(err).NotTo(HaveOccurred())","+\t\treturn defkit.ComponentRef(\"webservice\").WithCUE(string(src))","+\t}","+","+\ttenantWebservice := func(parent *defkit.ComponentDefinition) *defkit.ComponentDefinition {","+\t\treturn defkit.NewComponent(\"tenant-webservice\").","+\t\t\tExtends(parent).","+\t\t\tParams(defkit.String(\"image\"), defkit.String(\"tenant\")).","+\t\t\tTemplate(func(tpl *defkit.Template) {","+\t\t\t\ttpl.Super().Set(\"image\", defkit.ParamRef(\"image\"))","+\t\t\t\ttpl.Output(defkit.NewResource(\"apps/v1\", \"Deployment\").","+\t\t\t\t\tSet(\"metadata.labels[tenant.oam.dev/name]\", defkit.ParamRef(\"tenant\")))","+\t\t\t})","+\t}","+","+\tContext(\"the header\", func() {","+\t\tIt(\"writes extends and abstract where the spec reads them\", func() {","+\t\t\tvar spec v1beta1.C