     : data.alias;"," ","     return hash({","-      model: { ...data, alias, identityType: 'group', canAddAlias, canEditGroup },","+      model: { ...data, alias, identityType: 'group', canAddAlias, canEditGroup, canEdit: canEditGroup },","       section,","     });","   }"],"additions":1,"deletions":1,"truncated":false},{"path":"ui/app/utils/identity-helpers.js","lines":["@@ -258,6 +258,33 @@ export async function handleUpdate({ api, model, data }) {","   return await api.identity[method](model.itemId, params);"," }"," ","+/**","+ * Update only the given fields of an entity or group. Vault treats update-by-id as a partial update,","+ * so fields that are not sent keep their stored value (an empty array or object clears just that field).","+ * @param {Object} params - Parameters object","+ * @param {Object} params.api - The API service instance","+ * @param {Object} params.model - The show-route model (expects `id` and `identityType`)","+ * @param {Object} params.fields - The fields to change, e.g. `{ policies: ['default'] }`","+ * @returns {Promise<Object>} API response","+ */","+export async function handlePartialUpdate({ api, model, fields }) {","+  const method = model.identityType === 'group' ? 'groupUpdateById' : 'entityUpdateById';","+  return await api.identity[method](model.id, fields);","+}","+","+/**","+ * Refresh the entity/group show route so the tab re-fetches after a partial update. The refresh is scoped to","+ * this route because a bare `router.refresh()` also re-renders `vault.cluster`, which destroys the flash","+ * message that was just queued.","+ * @param {Object} params - Parameters object","+ * @param {Object} params.router - The router service instance","+ * @param {Object} params.model - The show-route model (expects `identityType`)","+ */","+export function refreshIdentityShow({ router, model }) {","+  const section = model.identityType === 'group' ? 'groups' : 'entities';","+  return router.refresh(`vault.cluster.access.identity.${section}.show`);","+}","+"," /**","  * Handle entity/group creation","  * @param {Object} params - Parameters object"],"additions":27,"deletions":0,"truncated":false},{"path":"ui/e2e/tests/readonly/identity-item-actions.spec.ts","lines":["@@ -0,0 +1,88 @@","+/**","+ * Copyright IBM Corp. 2026","+ * SPDX-License-Identifier: BUSL-1.1","+ */","+","+import { expect } from '@playwright/test';","+import { test } from '../../fixtures/demo';","+import { rootApi } from '../../fixtures/root-api';","+","+const ENTITY = 'readonly-actions-entity';","+const MEMBER = 'readonly-actions-member';","+const GROUP = 'readonly-actions-group';","+","+// Seeding is idempotent because Playwright re-runs beforeAll in a fresh worker after a failure.","+test.beforeAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  const upsert = async (type: string, name: string, data = {}) => {","+    await expect(await api.post(`/v1/identity/${type}/name/${name}`, { data })).toBeOK();","+    return (await (await api.get(`/v1/identity/${type}/name/${name}`)).json()).data;","+  };","+  const member = await upsert('entity', MEMBER);","+  await upsert('entity', ENTITY, {","+    disabled: true,","+    policies: ['default'],","+    metadata: { team: 'ui' },","+  });","+  await upsert('group', GROUP, {","+    policies: ['default'],","+    metadata: { team: 'ui' },","+    member_entity_ids: [member.id],","+  });","+  await api.dispose();","+});","+","+// Read-only tokens may view policies, metadata and members, but never see the actions that change them.","+test('read-only user cannot change entity policies, metadata or enabled state', async ({","+  page,","+  playwright,","+}, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  const { data: entity } = await (await api.get(`/v1/identity/entity/name/${ENTITY}`)).json();","+  await api.dispose();","+","+  await test.step('details tab hides the Enable action', async () => {","+    await page.goto(`access/identity/entities/${entity.id}/details`);","+    await expect(page.getByText('is disabled. All associated tokens cannot be used')).toBeVisible();","+    await expect(page.getByRole('button', { name: 'Enable' })).toHaveCount(0);","+  });","+","+  await test.step('policies tab hides the policy management menu', async () => {","+    await page.goto(`access/identity/entities/${entity.id}/policies`);","+    await expect(page.getByText('default', { exact: true })).toBeVisible();","+    await expect(page.getByRole('button', { name: 'Identity policy management options' })).toHaveCount(0);","+  });","+","+  await test.step('metadata tab hides the metadata menu', async () => {","+    await page.goto(`access/identity/entities/${entity.id}/metadata`);","+    await expect(page.getByText('team', { exact: true })).toBeVisible();","+    await expect(page.getByRole('button', { name: 'Metadata options' })).toHaveCount(0);","+  });","+});","+","+test('read-only user cannot change group policies, metadata or members', async ({","+  page,","+  playwright,","+}, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  const { data: group } = await (await api.get(`/v1/identity/group/name/${GROUP}`)).json();","+  await api.dispose();","+","+  await test.step('policies tab hides the policy management menu', async () => {","+    await page.goto(`access/identity/groups/${group.id}/policies`);","+    await expect(page.getByText('default', { exact: true })).toBeVisible();","+    await expect(page.getByRole('button', { name: 'Identity policy management options' })).toHaveCount(0);","+  });","+","+  await test.step('metadata tab hides the metadata menu', async () => {","+    await page.goto(`access/identity/groups/${group.id}/metadata`);","+    await expect(page.getByText('team', { exact: true })).toBeVisible();","+    await expect(page.getByRole('button', { name: 'Metadata options' })).toHaveCount(0);","+  });","+","+  await test.step('members tab hides the member menu', async () => {","+    await page.goto(`access/identity/groups/${group.id}/members`);","+    await expect(page.getByText(group.member_entity_ids[0], { exact: true })).toBeVisible();","+    await expect(page.getByRole('button', { name: 'Identity member options' })).toHaveCount(0);","+  });","+});"],"additions":88,"deletions":0,"truncated":false},{"path":"ui/e2e/tests/superuser/access/identity-item-actions.spec.ts","lines":["@@ -0,0 +1,175 @@","+/**","+ * Copyright IBM Corp. 2026","+ * SPDX-License-Identifier: BUSL-1.1","+ */","+","+import { expect } from '@playwright/test';","+import { test } from '../../../fixtures/demo';","+import { rootApi } from '../../../fixtures/root-api';","+","+import type { APIRequestContext, Page } from '@playwright/test';","+","+// Each test seeds its own entity/group so the tests share no state. Writing by name is an upsert,","+// which keeps seeding idempotent when Playwright re-runs a test in a fresh worker.","+const seed = async (api: APIRequestContext, type: 'entity' | 'group', name: string, data = {}) => {","+  await expect(await api.post(`/v1/identity/${type}/name/${name}`, { data })).toBeOK();","+  return read(api, type, name);","+};","+","+const read = async (api: APIRequestContext, type: 'entity' | 'group', name: string) => {","+  const res = await api.get(`/v1/identity/${type}/name/${name}`);","+  await expect(res).toBeOK();","+  return (await res.json()).data;","+};","+","+// Opens the row action menu, picks the named item and confirms the modal.","+const removeFromRow = async (page: Page, rowText: string, menuName: string, itemName: string) => {","+  const row = page.locator('.list-item-row, .info-table-row', { hasText: rowText });","+  await row.getByRole('button', { name: menuName }).click();","+  await page.getByRole('button', { name: itemName }).click();","+  await page.getByRole('button', { name: 'Confirm' }).click();","+};","+","+test.describe('identity item actions', () => {","+  let api: APIRequestContext;","+","+  test.beforeAll(async ({ playwright }, testInfo) => {","+    api = await rootApi(playwright, testInfo);","+  });","+","+  test.afterAll(async () => {","+    await api.dispose();","+  });","+","+  test('removing a policy from an entity persists and keeps other fields', async ({ page }) => {","+    const entity = await seed(api, 'entity', 'actions-entity-policy', {","+      policies: ['default', 'remove-me'],","+      metadata: { team: 'ui' },","+    });","+","+    await page.goto(`access/identity/entities/${entity.id}/policies`);","+    await expect(page.getByText('remove-me', { exact: true })).toBeVisible();","+","+    await removeFromRow(page, 'remove-me', 'Identity policy management options', 'Remove from entity');","+    await expect(page.getByText(`Successfully removed 'remove-me' policy from ${entity.id}`)).toBeVisible();","+    await expect(page.getByText('remove-me', { exact: true })).toHaveCount(0);","+","+    await page.reload();","+    await expect(page.getByText('default', { exact: true })).toBeVisible();","+    await expect(page.getByText('remove-me', { exact: true })).toHaveCount(0);","+","+    const after = await read(api, 'entity', 'actions-entity-policy');","+    expect(after.policies).toEqual(['default']);","+    expect(after.metadata).toEqual({ team: 'ui' });","+    expect(after.disabled).toBe(false);","+  });","+","+  test('removing a metadata key from an entity persists and keeps other fields', async ({ page }) => {","+    const entity = await seed(api, 'entity', 'actions-entity-metadata', {","+      policies: ['default'],","+      metadata: { keep: 'yes', drop: 'no' },","+    });","+","+    await page.goto(`access/identity/entities/${entity.id}/metadata`);","+    await expect(page.getByText('drop', { exact: true })).toBeVisible();","+","+    await removeFromRow(page, 'drop', 'Metadata options', 'Remove');","+    await expect(page.getByText(\"Successfully removed 'drop' from metadata\")).toBeVisible();","+","+    await page.reload();","+    await expect(page.getByText('keep', { exact: true })).toBeVisible();","+    await expect(page.getByText('drop', { exact: true })).toHaveCount(0);","+","+    const after = await read(api, 'entity', 'actions-entity-metadata');","+    expect(after.metadata).toEqual({ keep: 'yes' });","+    expect(after.policies).toEqual(['default']);","+  });","+","+  test('enabling a disabled entity persists and keeps other fields', async ({ page }) => {","+    const entity = await seed(api, 'entity', 'actions-entity-enable', {","+      disabled: true,","+      policies: ['default'],","+      metadata: { team: 'ui' },","+    });","+","+    await page.goto(`access/identity/entities/${entity.id}/details`);","+    await expect(page.getByText('is disabled. All associated tokens cannot be used')).toBeVisible();","+","+    await page.getByRole('button', { name: 'Enable' }).click();","+    await expect(page.getByText(`Successfully enabled entity: ${entity.id}`)).toBeVisible();","+    await expect(page.getByText('is disabled. All associated tokens cannot be used')).toHaveCount(0);","+","+    await page.reload();","+    await expect(page.getByText('is disabled. All associated tokens cannot be used')).toHaveCount(0);","+","+    const after = await read(api, 'entity', 'actions-entity-enable');","+    expect(after.disabled).toBe(false);","+    expect(after.policies).toEqual(['default']);","+    expect(after.metadata).toEqual({ team: 'ui' });","+  });","+","+  test('removing a policy from a group persists and keeps other fields', async ({ page }) => {","+    const group = await seed(api, 'group', 'actions-group-policy', {","+      policies: ['default', 'remove-me'],","+      metadata: { team: 'ui' },","+    });","+","+    await page.goto(`access/identity/groups/${group.id}/policies`);","+    await expect(page.getByText('remove-me', { exact: true })).toBeVisible();","+","+    await removeFromRow(page, 'remove-me', 'Identity policy management options', 'Remove from group');","+    await expect(page.getByText(`Successfully removed 'remove-me' policy from ${group.id}`)).toBeVisible();","+","+    await page.reload();","+    await expect(page.getByText('default', { exact: true })).toBeVisible();","+    await expect(page.getByText('remove-me', { exact: true })).toHaveCount(0);","+","+    const after = await read(api, 'group', 'actions-group-policy');","+    expect(after.policies).toEqual(['default']);","+    expect(after.metadata).toEqual({ team: 'ui' });","+  });","+","+  test('removing a metadata key from a group persists and keeps other fields', async ({ page }) => {","+    const group = await seed(api, 'group', 'actions-group-metadata', {","+      policies: ['default'],","+      metadata: { keep: 'yes', drop: 'no' },","+    });","+","+    await page.goto(`access/identity/groups/${group.id}/metadata`);","+    await expect(page.getByText('drop', { exact: true })).toBeVisible();","+","+    await removeFromRow(page, 'drop', 'Metadata options', 'Remove');","+    await expect(page.getByText(\"Successfully removed 'drop' from metadata\")).toBeVisible();","+","+    await page.reload();","+    await expect(page.getByText('keep', { exact: true })).toBeVisible();","+    await expect(page.getByText('drop', { exact: true })).toHaveCount(0);","+","+    const after = await read(api, 'group', 'actions-group-metadata');","+    expect(after.metadata).toEqual({ keep: 'yes' });","+    expect(after.policies).toEqual(['default']);","+  });","+","+  test('removing a member from a group persists and keeps other members and fields', async ({ page }) => {","+    const keep = await seed(api, 'entity', 'actions-member-keep');","+    const drop = await seed(api, 'entity', 'actions-member-drop');","+    const group = await seed(api, 'group', 'actions-group-members', {","+      policies: ['default'],","+      member_entity_ids: [keep.id, drop.id],","+    });","+","+    await page.goto(`access/identity/groups/${group.id}/members`);","+    await expect(page.getByText(drop.id, { exact: true })).toBeVisible();","+","+    await removeFromRow(page, drop.id, 'Identity member options', 'Remove');","+    await expect(page.getByText(`Successfully removed '${drop.id}' from the group`)).toBeVisible();","+","+    await page.reload();","+    await expect(page.getByText(keep.id, { exact: true })).toBeVisible();","+    await expect(page.getByText(drop.id, { exact: true })).toHaveCount(0);","+","+    const after = await read(api, 'group', 'actions-group-members');","+    expect(after.member_entity_ids).toEqual([keep.id]);","+    expect(after.policies).toEqual(['default']);","+  });","+});"],"additions":175,"deletions":0,"truncated":false},{"path":"ui/tests/integration/components/identity/item-details-test.js","lines":["@@ -3,12 +3,10 @@","  * SPDX-License-Identifier: BUSL-1.1","  */"," ","-import { resolve } from 'rsvp';","-import EmberObject from '@ember/object';"," import { module, test } from 'qunit';"," import { setupRenderingTest } from 'vault/tests/helpers';"," import { render } from '@ember/test-helpers';","-import hbs from 'htmlbars-inline-precompile';","+import { hbs } from 'ember-cli-htmlbars';"," import sinon from 'sinon';"," import { create } from 'ember-cli-page-object';"," import itemDetails from 'vault/tests/pages/components/identity/item-details';","@@ -19,42 +17,62 @@ module('Integration | Component | identity/item details', function (hooks) {","   setupRenderingTest(hooks);"," ","   hooks.beforeEach(function () {","-    this.owner.lookup('service:flash-messages').registerTypes(['success']);","+    this.flash = this.owner.lookup('service:flash-messages');","+    this.flash.registerTypes(['success', 'danger']);","+    this.successSpy = sinon.spy(this.flash, 'success');","+    this.dangerSpy = sinon.spy(this.flash, 'danger');","+    this.api = this.owner.lookup('service:api');","+    this.router = this.owner.lookup('service:router');","+    this.refreshStub = sinon.stub(this.router, 'refresh');","+    this.entityUpdate = sinon.stub(this.api.identity, 'entityUpdateById')