ken=\"\"; HttpOnly; Max-Age=0; Path=/; SameSite=lax' in response.headers.get(\"set-cookie\")","-","-    @patch(\"airflow.api_fastapi.auth.middlewares.refresh_token.get_auth_manager\")","-    @patch(\"airflow.api_fastapi.auth.middlewares.refresh_token.resolve_user_from_token\")","-    @pytest.mark.asyncio","-    async def test_dispatch_no_refreshed_token(","-        self, mock_resolve_user_from_token, mock_get_auth_manager, middleware, mock_request, mock_user","-    ):","-        mock_request.cookies = {COOKIE_NAME_JWT_TOKEN: \"valid_token\"}","-        mock_resolve_user_from_token.return_value = mock_user","-        mock_auth_manager = MagicMock()","-        mock_get_auth_manager.return_value = mock_auth_manager","-        mock_auth_manager.refresh_user.return_value = None","+    def test_no_token(self, mock_resolve_user, mock_auth_manager):","+        app, _ = _build_app()"," ","-        call_next = AsyncMock(return_value=Response())","-        await middleware.dispatch(mock_request, call_next)","+        response = TestClient(app).get(\"/api/v2/dags\")"," ","-        call_next.assert_called_once_with(mock_request)","-        mock_resolve_user_from_token.assert_called_once_with(\"valid_token\")","+        assert response.status_code == 200","+        assert \"set-cookie\" not in response.headers","+        mock_resolve_user.assert_not_called()","+","+    def test_invalid_token_clears_cookie(self, mock_resolve_user, mock_auth_manager):","+        mock_resolve_user.side_effect = HTTPException(status_code=403, detail=\"Invalid JWT token\")","+        app, seen = _build_app()","+","+        response = TestClient(app, cookies={COOKIE_NAME_JWT_TOKEN: \"invalid_token\"}).get(\"/api/v2/dags\")","+","+        assert response.status_code == 200","+        assert seen[\"user\"] is None","+        assert '_token=\"\"; HttpOnly; Max-Age=0; Path=/; SameSite=lax' in response.headers[\"set-cookie\"]","+        mock_auth_manager.refresh_user.assert_not_called()","+","+    def test_