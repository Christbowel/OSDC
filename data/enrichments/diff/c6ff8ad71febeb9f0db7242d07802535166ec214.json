r/peg/tokenizer/tokenizer.hpp\"","+#include \"duckdb/parser/peg/matcher.hpp\"","+","+namespace duckdb {","+","+//! Matches a dotted name spelled without quotes: 'carlopi.github.io', 'my-website.com'. The tokenizer cuts such a name","+//! into words, '.' and '-' tokens; this matcher glues them back together as long as they touch (no whitespace or","+//! comment in between) and the result is a dotted name (IsDottedName): labels of words joined by single dashes,","+//! separated by single dots. Note that '--' starts a comment for the tokenizer, so a label with two dashes in a row","+//! cannot be spelled unquoted at all; it is not a dotted name either way.","+class DottedNameMatcher : public AtomicMatcher {","+public:","+\tstatic constexpr MatcherType TYPE = MatcherType::VARIABLE;","+","+public:","+\tDottedNameMatcher() : AtomicMatcher(TYPE) {","+\t\tname = \"DottedName\";","+\t}","+","+\tMatcherResult MatchAtomic(MatchState &state) const override {","+\t\tauto token = state.token_iterator.Current();","+\t\tif (!token) {","+\t\t\treturn MatcherResult::Failure();","+\t\t}","+\t\tauto start_offset = token->offset;","+\t\tstring text;","+\t\tidx_t end_offset = start_offset;","+\t\tidx_t token_count = 0;","+\t\twhile (true) {","+\t\t\tauto next = state.token_iterator.Current();","+\t\t\tif (!next || next->offset != end_offset || !IsNamePart(*next)) {","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\ttext += next->text;","+\t\t\tend_offset = next->offset + next->length;","+\t\t\tstate.token_iterator.Advance();","+\t\t\ttoken_count++;","+\t\t}","+\t\tif (token_count == 0 || !IsDottedName(text)) {","+\t\t\treturn MatcherResult::Failure();","+\t\t}","+\t\tstate.UpdateMaxTokenIndex();","+\t\tstate.token_iterator.SetPreviousTokenType(TokenType::IDENTIFIER);","+\t\tif (!state.BuildParseResult()) {","+\t\t\treturn MatcherResult::Success();","+\t\t}","+\t\tstate.FoldIdentifier(text);","+\t\treturn state.AllocateParseResult<IdentifierParseResult>(text, optional_idx(start_offset),","+\t\t                                                        optional_idx(end_offset - start_offset));","+\t}","+","+\tSuggestionType AddSuggestionInternal(MatchState &state) const override {","+\t\treturn SuggestionType::MANDATORY;","+\t}","+","+\tstring ToString() const override {","+\t\treturn \"DOTTED_NAME\";","+\t}","+","+\tvoid InitializeFirstSet(MatcherFirstSet &first_set, const GrammarLiteralTable &table) const override {","+\t\tfirst_set.class_mask = MatcherTokenClass::WORD | MatcherTokenClass::NUMBER;","+\t}","+","+\t//! A dotted name: two or more labels separated by single dots, each label one or more words joined by single","+\t//! dashes, each word one or more letters, digits or '_' (bytes outside ASCII count as letters, so that a name like","+\t//! münchen.de is a name here and gets the manager's answer rather than a syntax error). So no label starts or ends","+\t//! with '-', and no two dashes touch","+\tstatic bool IsDottedName(const string &text) {","+\t\tidx_t label_count = 0;","+\t\tidx_t word_length = 0;","+\t\tfor (idx_t i = 0; i <= text.size(); i++) {","+\t\t\tauto c = i < text.size() ? text[i] : '.';","+\t\t\tif (c == '.' || c == '-') {","+\t\t\t\t// a separator ends a word, which must not be empty","+\t\t\t\tif (word_length == 0) {","+\t\t\t\t\treturn false;","+\t\t\t\t}","+\t\t\t\tword_length = 0;","+\t\t\t\tif (c == '.') {","+\t\t\t\t\tlabel_count++;","+\t\t\t\t}","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tif (!StringUtil::CharacterIsAlpha(c) && !StringUtil::CharacterIsDigit(c) && c != '_' &&","+\t\t\t    static_cast<unsigned char>(c) < 0x80) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tword_length++;","+\t\t}","+\t\treturn label_count >= 2;","+\t}","+","+private:","+\t//! A token that can be part of an unquoted dotted name: a plain word or number, or a lone '.' or '-'","+\tstatic bool IsNamePart(const MatcherToken &token) {","+\t\tif (token.text.empty()) {","+\t\t\treturn false;","+\t\t}","+\t\tswitch (token.type) {","+\t\tcase TokenType::KEYWORD:","+\t\tcase TokenType::IDENTIFIER:","+\t\tcase TokenType::NUMBER_LITERAL:","+\t\t\treturn true;","+\t\tcase TokenType::OPERATOR:","+\t\t\treturn token.text == \".\" || token.text == \"-\";","+\t\tdefault:","+\t\t\treturn false;","+\t\t}","+\t}","+};","+","+} // namespace duckdb"],"additions":114,"deletions":0,"truncated":false},{"path":"src/include/duckdb/parser/peg/matcher/list.hpp","lines":["@@ -1,6 +1,7 @@"," #include \"duckdb/parser/peg/matcher/arithmetic_operator_matcher.hpp\""," #include \"duckdb/parser/peg/matcher/choice_matcher.hpp\""," #include \"duckdb/parser/peg/matcher/end_of_input_matcher.hpp\"","+#include \"duckdb/parser/peg/matcher/dotted_name_matcher.hpp\""," #include \"duckdb/parser/peg/matcher/identifier_matcher.hpp\""," #include \"duckdb/parser/peg/matcher/keyword_matcher.hpp\""," #include \"duckdb/parser/peg/matcher/list_matcher.hpp\""],"additions":1,"deletions":0,"truncated":false},{"path":"src/include/duckdb/parser/peg/peg_rule_id.hpp","lines":["@@ -860,7 +860,7 @@ enum class PEGRuleId : uint32_t {"," \tCreateExtensionRepositoryFromHostStmt,"," \tDropExtensionRepositoryStmt,"," \tExtensionRepositoryName,","-\tExtensionRepositoryHostName,","+\tDottedName,"," \tTableMatchRecognizeClause,"," \tMatchRecognizeBody,"," \tMatchRecognizeClause,"],"additions":1,"deletions":1,"truncated":false},{"path":"src/include/duckdb/parser/peg/transformer/peg_transformer.hpp","lines":["@@ -2175,8 +2175,6 @@ class PEGTransformerFactory {"," \tstatic arena_ptr<TransformResultValue>"," \tFinalizeExtensionRepositoryNameTrampoline(PEGTransformer &transformer, GeneratedTransformProcess &process);"," \tstatic arena_ptr<TransformResultValue>","-\tFinalizeExtensionRepositoryHostNameTrampoline(PEGTransformer &transformer, GeneratedTransformProcess &process);","-\tstatic arena_ptr<TransformResultValue>"," \tFinalizeTableMatchRecognizeClauseTrampoline(PEGTransformer &transformer, GeneratedTransformProcess &process);"," \tstatic arena_ptr<TransformResultValue> FinalizeMatchRecognizeBodyTrampoline(PEGTransformer &transformer,"," \t                                                                            GeneratedTransformProcess &process);","@@ -4059,8 +4057,6 @@ class PEGTransformerFactory {"," \tstatic unique_ptr<SQLStatement> TransformDropExtensionRepositoryStmt(PEGTransformer &transformer,"," \t                                                                     const optional<bool> &if_exists,"," \t                                                                     const Identifier &col_id_or_string);","-\tstatic Identifier TransformExtensionRepositoryHostName(PEGTransformer &transformer, const Identifier &col_id,","-\t                                                       const vector<string> &dot_col_label);"," \tstatic unique_ptr<TableRef> TransformTableMatchRecognizeClause(PEGTransformer &transformer,"," \t                                                               unique_ptr<TableRef> match_recognize_body,"," \t                                                               const optional<TableAlias> &table_alias);"],"additions":0,"deletions":4,"truncated":false},{"path":"src/main/extension/extension_repository_manager.cpp","lines":["@@ -366,10 +366,17 @@ static string RepositoryNameOfFile(const string &file_name) {"," string ExtensionRepositoryManager::NormalizeRepositoryName(const string &name) {"," \tstring result;"," \tif (!TryNormalizeRepositoryName(name, result)) {","+\t\tstring hint;","+\t\tfor (auto c : name) {","+\t\t\tif (static_cast<unsigned char>(c) >= 0x80) {","+\t\t\t\thint = \"\\nAn internationalised host is spelled in its punycode form, 'xn--...', in quotes\";","+\t\t\t\tbreak;","+\t\t\t}","+\t\t}"," \t\tthrow InvalidInputException(\"Invalid extension repository name '%s': names cannot be empty and can only \""," \t\t                            \"contain letters, digits, '_', '-' and '.' (not at the start or the end, and not \"","-\t\t                            \"two in a row)\",","-\t\t                            name);","+\t\t                            \"two in a row)%s\",","+\t\t                            name, hint);"," \t}"," \treturn result;"," }","@@ -390,29 +397,49 @@ static constexpr const idx_t METADATA_FORMAT_VERSION = 1;"," //! and not localhost. A single word is not a host: it would be resolved through search domains to a host the user did"," //! not name. There is no stricter test short of the public suffix list; this one keeps out what is certainly not a"," //! public host","-bool ExtensionRepositoryManager::IsHostName(const string &text) {","-\tidx_t label_count = 0;","-\tidx_t label_start = 0;","-\tfor (idx_t i = 0; i <= text.size(); i++) {","-\t\tif (i < text.size() && text[i] != '.') {","-\t\t\tauto c = text[i];","-\t\t\tif (!StringUtil::CharacterIsAlpha(c) && !StringUtil::CharacterIsDigit(c) && c != '-') {","+//! A host label: one or more words of letters and digits joined by single dashes, so no leading or trailing dash and","+//! no two dashes touching - except the one place two dashes are legitimate, the 'xn--' that opens an internationalised","+//! label in its punycode (A-label) form: 'xn--mnchen-3ya' for 'münchen'","+static bool IsHostLabel(const string &label) {","+\tidx_t start = 0;","+\tif (label.size() > 4 && StringUtil::CIEquals(label.substr(0, 4), \"xn--\")) {","+\t\tstart = 4;","+\t}","+\tidx_t word_length = 0;","+\tfor (idx_t i = start; i <= label.size(); i++) {","+\t\tauto c = i < label.size() ? label[i] : '-';","+\t\tif (c == '-') {","+\t\t\tif (word_length == 0) {"," \t\t\t\treturn false;"," \t\t\t}","+\t\t\tword_length = 0;"," \t\t\tcontinue;"," \t\t}","-\t\t// end of a label","-\t\tif (i == label_start || text[label_start] == '-' || text[i - 1] == '-') {","+\t\tif (!StringUtil::CharacterIsAlpha(c) && !StringUtil::CharacterIsDigit(c)) {"," \t\t\treturn false;"," \t\t}","-\t\tlabel_count++;","-\t\tlabel_start = i + 1;","+\t\tword_length++;","+\t}","+\treturn true;","+}","+","+bool ExtensionRepositoryManager::IsHostName(const string &text) {","+\t// two or more labels separated by single dots, the last one letters only (an IPv4 literal is not a host), and not","+\t// localhost","+\tif (text.empty() || text.front() == '.' || text.back() == '.' || text.find(\"..\") != string::npos) {","+\t\treturn false;"," \t}","-\tif (label_count < 2) {","+\tauto labels = StringUtil::Split(text, '.');","+\tif (labels.size() < 2) {"," \t\treturn false;"," \t}","-\tfor (idx_t i = text.rfind('.') + 1; i < text.size(); i++) {","-\t\tif (!StringUtil::CharacterIsAlpha(text[i])) {","+\tfor (auto &label : labels) {","+\t\tif (!IsHostLabel(label)) {","+\t\t\treturn false;","+\t\t}","+\t}","+\tfor (auto c : labels.back()) {","+\t\tif (!StringUtil::CharacterIsAlpha(c)) {"," \t\t\treturn false;"," \t\t}"," \t}","@@ -533,12 +560,14 @@ ExtensionRepositoryResolution ExtensionRepositoryManager::ResolveRepositoryFromH"," \t// only a name that is a host on the public internet is reached: a single word would resolve through search"," \t// domains to a host the user did not name, an IP literal or localhost is nobody's statement"," \tif (!IsHostName(name)) {","-\t\tthrow InvalidInputException(","-\t\t    \"Cannot create extension repository '%s': '%s' is not a host name. A host has two or \"","-\t\t    \"more labels of letters, digits and '-' separated by dots, the last one letters \"","-\t\t    \"only, and is not localhost\\nUse `WITH PREFIX '<url>'` to name the repository's \"","-\t\t    \"location directly\",","-\t\t    name_p, name);","+\t\tthrow InvalidInputException(\"Cannot create extension repository '%s': '%s' is not a host name. A host has two \"","+\t\t                            \"or more labels separated by \"","+\t\t                            \"dots, each label words of letters and digits joined by single dashes (or a \"","+\t\t                            \"punycode label, 'xn--...'), the \"","+\t\t                            \"last label letters only, and is not localhost\\nUse `WITH PREFIX '<url>'` to name \"","+\t\t