{"id":"0f0682b773b15ff350057a80763cd39d71d71f30","axis":"silent","repo":"systemd/systemd","sha":"0f0682b773b15ff350057a80763cd39d71d71f30","parsed":{"files":[{"path":"NEWS","lines":["@@ -62,6 +62,13 @@ CHANGES WITH 263 in spe:","           SendHostnameUpdates=no setting in the [DHCPv4] and [DHCPv6]","           sections."," ","+        * systemd-networkd now generates an IPv6 link-local address on","+          WireGuard interfaces by default, like on other interfaces.","+          Previously, LinkLocalAddressing= was ignored for WireGuard","+          interfaces, and an IPv6 link-local address could only be assigned","+          with Address=. The previous behaviour may be restored with","+          LinkLocalAddressing=no.","+","         * The \"appStream\" key of","           org.freedesktop.sysupdate1.Target.DescribeFeature() is now an array of","           strings rather than a single optional string.","@@ -122,6 +129,10 @@ CHANGES WITH 263 in spe:","         * As mentioned above, systemd-networkd and networkctl have been merged","           into a single multi-call binary to reduce the installation footprint."," ","+        * As mentioned above, an IPv6 link-local address is now generated on","+          WireGuard interfaces by default. This is useful e.g. for running","+          routing protocols like Babel over the tunnel.","+","         * As mentioned above, the hostname sent by the DHCPv4 and DHCPv6","           clients now follows the system hostname. The new","           SendHostnameUpdates= setting in the [DHCPv4] and [DHCPv6] sections"],"additions":11,"deletions":0,"truncated":false},{"path":"man/systemd.network.xml","lines":["@@ -488,7 +488,10 @@","           <para>Defaults to <option>no</option> when <varname>KeepMaster=</varname> or","           <varname>Bridge=</varname> is set or when the specified","           <varname>MACVLAN=</varname>/<varname>MACVTAP=</varname> has <varname>Mode=passthru</varname>,","-          or <option>ipv6</option> otherwise.</para>","+          or <option>ipv6</option> otherwise. As WireGuard interfaces do not have a hardware address, the","+          kernel generates the IPv6 link-local address on them in the same way as the <literal>random</literal>","+          mode even when <literal>eui64</literal> is used, see","+          <varname>IPv6LinkLocalAddressGenerationMode=</varname> below.</para>"," ","           <para>When IPv4 link-local addressing is enabled, <varname>ARP=</varname> is enabled unless if it","           is explicitly configured.</para>"],"additions":4,"deletions":1,"truncated":false},{"path":"src/network/networkd-ipv6ll.c","lines":["@@ -33,7 +33,7 @@ bool link_ipv6ll_enabled(Link *link) {","         if (link->iftype == ARPHRD_CAN)","                 return false;"," ","-        if (STRPTR_IN_SET(link->kind, \"vrf\", \"wireguard\", \"ipip\", \"gre\", \"sit\", \"vti\", \"nlmon\"))","+        if (STRPTR_IN_SET(link->kind, \"vrf\", \"ipip\", \"gre\", \"sit\", \"vti\", \"nlmon\"))","                 return false;"," ","         if (link->network->bond)","@@ -219,6 +219,8 @@ int link_set_ipv6ll_stable_secret(Link *link) {"," }"," "," int link_set_ipv6ll_addrgen_mode(Link *link, IPv6LinkLocalAddressGenMode mode) {","+        int r;","+","         assert(link);","         assert(link->manager);","         assert(mode >= 0 && mode < _IPV6_LINK_LOCAL_ADDRESS_GEN_MODE_MAX);","@@ -226,7 +228,14 @@ int link_set_ipv6ll_addrgen_mode(Link *link, IPv6LinkLocalAddressGenMode mode) {","         if (mode == link->ipv6ll_address_gen_mode)","                 return 0;"," ","-        return sysctl_write_ip_property_uint32(AF_INET6, link->ifname, \"addr_gen_mode\", mode, manager_get_sysctl_shadow(link->manager));","+        r = sysctl_write_ip_property_uint32(AF_INET6, link->ifname, \"addr_gen_mode\", mode,","+                                            manager_get_sysctl_shadow(link->manager));","+        if (r < 0)","+                return r;","+","+        /* The kernel does not send RTM_NEWLINK message on changing the mode by sysctl. */","+        link->ipv6ll_address_gen_mode = mode;","+        return 0;"," }"," "," static const char* const ipv6_link_local_address_gen_mode_table[_IPV6_LINK_LOCAL_ADDRESS_GEN_MODE_MAX] = {"],"additions":11,"deletions":2,"truncated":false},{"path":"src/network/networkd-link.c","lines":["@@ -2088,7 +2088,10 @@ static int link_admin_state_up(Link *link) {","          * ipv6 mtu on NETDEV_UP, so we need to reset it. */","         (void) link_set_ipv6_mtu(link, LOG_INFO);"," ","-        return 0;","+        /* Some drivers, e.g. WireGuard, reset the IPv6LL address generation mode when the interface is","+         * brought up, so we need to reset it. As the interface is up, the mode is set by sysctl, which","+         * also generates the address. */","+        return link_request_to_set_addrgen_mode(link);"," }"," "," static int link_admin_state_down(Link *link) {"],"additions":4,"deletions":1,"truncated":false},{"path":"src/network/networkd-setlink.c","lines":["@@ -741,7 +741,16 @@ int link_request_to_set_addrgen_mode(Link *link) {","         int r;"," ","         assert(link);","-        assert(link->network);","+","+        if (!link->network)","+                return 0;","+","+        if (!IN_SET(link->state, LINK_STATE_CONFIGURING, LINK_STATE_CONFIGURED))","+                return 0;","+","+        /* CAN devices do not support IPv6. */","+        if (link->iftype == ARPHRD_CAN)","+                return 0;"," ","         if (!socket_ipv6_is_supported())","                 return 0;"],"additions":10,"deletions":1,"truncated":false},{"path":"test/test-network/systemd-networkd-tests.py","lines":["@@ -2667,6 +2667,16 @@ def test_wireguard(self):","         self.networkctl_check_unit('wg98', '25-wireguard-23-peers', '25-wireguard-23-peers')","         self.networkctl_check_unit('wg97', '25-wireguard-no-peer', '25-wireguard-no-peer')"," ","+        # The WireGuard driver disables generating an IPv6LL address every time the interface is brought","+        # up. Check that the address is generated, also after the interface is brought down and up again.","+        ipv6ll = r'inet6 fe80::[0-9a-f:]+/64'","+        self.wait_address('wg97', ipv6ll, scope='link', ipv='-6')","+        self.wait_address('wg98', ipv6ll, scope='link', ipv='-6')","+        check_output('ip link set dev wg97 down')","+        self.wait_address_dropped('wg97', ipv6ll, scope='link', ipv='-6')","+        check_output('ip link set dev wg97 up')","+        self.wait_address('wg97', ipv6ll, scope='link', ipv='-6')","+","         output = check_output('ip -4 address show dev wg99')","         print(output)","         self.assertIn('inet 192.168.124.1/24 scope global wg99', output)","@@ -2800,6 +2810,14 @@ def test_wireguard(self):","         networkctl_reload()","         self.wait_online('wg99:routable', 'wg98:routable', 'wg97:carrier')"," ","+        # Check that the IPv6LL address is dropped when LinkLocalAddressing=no is set.","+        with open(","+            os.path.join(network_unit_dir, '25-wireguard-no-peer.network'), mode='a', encoding='utf-8'","+        ) as f:","+            f.write('\\n[Network]\\nLinkLocalAddressing=no\\n')","+        networkctl_reload()","+        self.wait_address_dropped('wg97', ipv6ll, scope='link', ipv='-6')","+","     def test_geneve(self):","         copy_network_unit('25-geneve.netdev', '26-netdev-link-local-addressing-yes.network')","         start_networkd()",""],"additions":18,"deletions":0,"truncated":false}],"additions":58,"deletions":5,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-24T13:00:08.569265+00:00"}