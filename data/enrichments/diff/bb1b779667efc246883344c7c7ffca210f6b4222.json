eds this.","-  const tarContent = isGzip(tarballBuffer)","-    ? gunzipSync(tarballBuffer, { chunkSize: 128 * 1024 })","-    : (Buffer.isBuffer(tarballBuffer) ? tarballBuffer : Buffer.from(tarballBuffer))","+  const tarContent = decompressTarball(tarballBuffer)","   const { files } = parseTarball(tarContent)","   const filesIndex = new Map() as FilesIndex","   let manifestBuffer: Buffer | undefined","@@ -52,3 +41,24 @@ export function addFilesFromTarball (","     manifest: manifestBuffer ? parseJsonBufferSync(manifestBuffer) as DependencyManifest : undefined,","   }"," }","+","+function decompressTarball (tarballBuffer: Buffer): Buffer {","+  if (isGzip(tarballBuffer)) {","+    // chunkSize 128KB (8x the Node.js default of 16KB) reduces the number of","+    // internal buffer allocations and copies during decompression. Benchmarks","+    // showed ~2.3x faster decompress at 128KB.","+    return gunzipSync(tarballBuffer, { chunkSize: 128 * 1024 })","+  }","+  if (isBzip2(tarballBuffer)) {","+    const decompressed = bz2.decompress(tarballBuffer)","+    return Buffer.from(decompressed.buffer, decompressed.byteOffset, decompressed.byteLength)","+  }","+  // When called from a worker thread, the buffer arrives as a Uint8Array","+  // (structured clone converts Buffer → Uint8Array). parseTarball relies on","+  // Buffer.prototype.toString('utf8', ...) so we must ensure it's a Buffer.","+  return Buffer.isBuffer(tarballBuffer) ? tarballBuffer : Buffer.from(tarballBuffer)","+}","+","+function isBzip2 (buffer: Buffer | Uint8Array): boolean {","+  return buffer.length >= 3 && buffer[0] === 0x42 && buffer[1] === 0x5a && buffer[2] === 0x68","+}"],"additions":23,"deletions":13,"truncated":false},{"path":"pnpm11/store/cafs/test/fixtures/package.tar.bz2","lines":["Binary files /dev/null and b/pnpm11/store/cafs/test/fixtures/package.tar.bz2 differ"],"additions":0,"deletions":0,"truncated":false},{"path":"pnpm11/store/cafs/test/index.ts","lines":["@@ -31,6 +31,18 @@ describe('cafs'