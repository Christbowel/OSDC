n_another_importer() {","     let CommandTempCwd { root, workspace, npmrc_info, .. } =","@@ -194,6 +218,64 @@ fn dedupe_writes_lockfile() {","     drop((root, mock_instance));"," }"," ","+#[test]","+fn dedupe_refreshes_cached_registry_metadata_for_locked_versions() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_recording_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    mock_instance.remove_version_field(\"@pnpm.e2e/deprecated\", \"1.0.0\", \"deprecated\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"dependencies\": {","+                \"@pnpm.e2e/deprecated\": \"1.0.0\",","+            },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+","+    pacquet","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let _ = mock_instance.take_requests();","+","+    let lockfile_path = workspace.join(\"pnpm-lock.yaml\");","+    let lockfile = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","+    eprintln!(\"{lockfile}\");","+    assert!(!lockfile.contains(\"deprecated: This package is deprecated.\"));","+    add_registry_deprecation(","+        &root.path().join(\"registry-storage\"),","+        \"@pnpm.e2e/deprecated\",","+        \"1.0.0\",","+    );","+","+    pacquet_at(&workspace)","+        .with_args([\"dedupe\", \"--lockfile-only\"])","+        .assert()","+        .success();","+","+    let dedupe_requests = mock_instance.take_requests();","+    dbg!(&dedupe_requests);","+    assert!(","+        dedupe_requests","+            .iter()","+            .any(|request| {","+                request.if_none_match.is_some() || request.if_modified_since.is_some()","+            }),","+    );","+    let deduped_lockfile = fs::read_to_string(&lockfile_path).expect(\"read deduped lockfile\");","+    eprintln!(\"{deduped_lockfile}\");","+    assert!(deduped_lockfile.contains(\"deprecated: This package is deprecated.\"));","+    drop((root, mock_instance));","+}","+"," #[test]"," fn dedupe_materializes_node_modules_unless_lockfile_only() {","     let CommandTempCwd {"],"additions":82,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolution.rs","lines":["@@ -164,6 +164,10 @@ impl<'a, Reporter: self::Reporter + 'static> ResolutionContext<'a, Reporter> {","             workspace_packages: self.setup.workspace_packages.clone(),","             update_checksums: self.install.update_checksums,","             update_behavior: resolver_update_behavior(&self.owned.resolution.update_seed_policy),","+            refresh_metadata: matches!(","+                self.owned.resolution.update_seed_policy,","+                super::UpdateSeedPolicy::KeepAllResolveAll,","+            ),","         }","     }"," "],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolve.rs","lines":["@@ -83,6 +83,7 @@ pub(super) struct SharedResolveOptions<'a> {","     /// See [`super::FreshInputs::update_checksums`].","     pub update_checksums: bool,","     pub update_behavior: pnpm_resolving_resolver_base::UpdateBehavior,","+    pub refresh_metadata: bool,"," }"," "," impl SharedResolveOptions<'_> {","@@ -108,6 +109,7 @@ impl SharedResolveOptions<'_> {","             refresh: pnpm_resolving_resolver_base::ResolutionRefreshOptions {","                 update_checksums: self.update_checksums,","                 update: self.update_behavior,","+                refresh_metadata: self.refresh_metadata,","                 ..Default::default()","             },","             policy: pnpm_resolving_resolver_base::ResolutionPolicyOptions {"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-npm-reso