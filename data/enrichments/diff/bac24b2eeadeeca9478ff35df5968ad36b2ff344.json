{"id":"bac24b2eeadeeca9478ff35df5968ad36b2ff344","axis":"silent","repo":"solidjs/solid-start","sha":"bac24b2eeadeeca9478ff35df5968ad36b2ff344","parsed":{"files":[{"path":".changeset/great-hooks-observe.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@solidjs/start\": minor","+---","+","+Add a `serverFunctions.onError` option naming a module that observes and replaces what a server function threw, before it is serialized into the response"],"additions":5,"deletions":0,"truncated":false},{"path":"apps/tests/src/e2e/server-function.test.ts","lines":["@@ -155,4 +155,17 @@ test.describe(\"server-function\", () => {","       );","     }).toPass({ timeout: 15000 });","   });","+","+  test(\"should send the error the onError module returns in place of the thrown one\", async ({","+    page,","+  }) => {","+    await page.goto(\"http://localhost:3000/server-function-on-error\");","+    // Retry the click until it registers post-hydration (clicks aren't auto-retried).","+    await expect(async () => {","+      await page.locator(\"#server-fn-test\").click();","+      await expect(page.locator(\"#server-fn-test\")).toContainText(\"replaced by onError\", {","+        timeout: 1000,","+      });","+    }).toPass({ timeout: 15000 });","+  });"," });"],"additions":13,"deletions":0,"truncated":false},{"path":"apps/tests/src/routes/server-function-on-error.tsx","lines":["@@ -0,0 +1,30 @@","+async function serverFnThrowsReplaceable() {","+  \"use server\";","+","+  // `src/server-fn-error.ts` swaps this one out for a different error before it","+  // is serialized, which is what the client below should end up displaying.","+  throw new Error(\"replace me\");","+}","+","+export default function App() {","+  return (","+    <main>","+      <span","+        id=\"server-fn-test\"","+        onClick={evt => {","+          const el = evt.target as HTMLElement;","+          serverFnThrowsReplaceable().then(","+            () => {","+              el.textContent = \"no error\";","+            },",