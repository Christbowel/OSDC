>assertSame(200, $response['headers']['status-code']);","+        $this->assertSame('funcValue1', $response['body']['funcKey1']);","+        $this->assertSame('funcValue2', $response['body']['funcKey2']);","+","+        // Cleanup","+        $this->updatePrefs([]);","+    }","+","+    public function testUpdatePrefsReplace(): void","+    {","+        $response = $this->updatePrefs(['alpha' => 'a', 'beta' => 'b']);","+","+        $this->assertSame(200, $response['headers']['status-code']);","+        $this->assertSame(['alpha' => 'a', 'beta' => 'b'], $response['body']);","+","+        // Replace with new prefs; previous keys are dropped","+        $response = $this->updatePrefs(['gamma' => 'g']);","+","+        $this->assertSame(200, $response['headers']['status-code']);","+        $this->assertSame(['gamma' => 'g'], $response['body']);","+","+        $response = $this->getPrefs();","+","+        $this->assertSame(200, $response['headers']['status-code']);","+        $this->assertSame(['gamma' => 'g'], $response['body']);","+","+        // Cleanup","+        $this->updatePrefs([]);","+    }","+","+    public function testUpdatePrefsNested(): void","+    {","+        $prefs = [","+            'theme' => 'dark',","+            'notifications' => ['email' => true, 'push' => false],","+            'columns' => ['name', 'status'],","+            'limit' => 25,","+        ];","+","+        $response = $this->updatePrefs($prefs);","+","+        $this->assertSame(200, $response['headers']['status-code']);","+        $this->assertSame($prefs, $response['body']);","+","+        $response = $this->getPrefs();","+","+        $this->assertSame(200, $response['headers']['status-code']);","+        $this->assertSame($prefs, $response['body']);","+","+        // Cleanup","+        $this->updatePrefs([]);","+    }","+","+    public function testUpdatePrefsEmpty(): void","+    {","+        $response = $this->updatePrefs(['toRemove' => 'value']);","+","+        $this->assertSame(200, $