trust. The wildcard promotes every dynamically located fixture","+# repository to full trust, making its local or worktree protection settings","+# eligible before reference protection is initialized.","+cat >trust-all-repositories.config <<EOF","+[safe]","+  directory = *","+EOF"],"additions":32,"deletions":0,"truncated":false},{"path":"gix/tests/gix/repository/config/mod.rs","lines":["@@ -3,6 +3,8 @@ pub(crate) mod config_snapshot;"," #[cfg(feature = \"command\")]"," mod editor;"," mod identity;","+#[cfg(feature = \"worktree-mutation\")]","+mod path_protection;"," mod remote;"," "," #[test]"],"additions":2,"deletions":0,"truncated":false},{"path":"gix/tests/gix/repository/config/path_protection.rs","lines":["@@ -0,0 +1,160 @@","+use gix_testtools::TestResult;","+","+#[test]","+fn repository_sources_respect_the_section_filter() -> TestResult {","+    use gix_sec::Trust;","+","+    #[derive(Debug, Eq, PartialEq)]","+    struct Protections {","+        windows: bool,","+        hfs: bool,","+        ntfs: bool,","+    }","+","+    let fixture = gix_testtools::scripted_fixture_read_only(\"make_path_protection_repos.sh\")?;","+    for source in [\"local\", \"worktree\"] {","+        for value in [\"false\", \"true\", \"invalid\"] {","+            for (options, use_config) in [","+                (crate::restricted().with(Trust::Reduced), false),","+                (crate::restricted().with(Trust::Full), true),","+                (","+                    crate::restricted().with(Trust::Full).filter_config_section(|_| false),","+                    false,","+                ),","+                (","+                    crate::restricted().with(Trust::Reduced).filter_config_section(|_| true),","+                    true,","+                ),","+            ] {","+                let repo = gix::open_opts(fixture.join(format!(\"{source}-{value}\")), options)?;","+                let validate = repo","+                    .checkout_options(gix::worktree::stack::state::attributes::Source::IdMapping)?","+                    .validate;","+                let configured = (use_config && value != \"invalid\").then_some(value == \"true\");","+                let expected = Protections {","+                    windows: configured.unwrap_or(cfg!(windows)),","+                    hfs: configured.unwrap_or(cfg!(target_os = \"macos\")),","+                    ntfs: configured.unwrap_or(true),","+                };","+                assert_eq!(","+                    Protections {","+                        windows: validate.protect_windows,","+                        hfs: validate.protect_hfs,","+                        ntfs: validate.protect_ntfs,","+                    },","+                    expected,","+                    \"{source}-{value}: only eligible settings can replace platform defaults\"","+                );","+                assert_eq!(","+                    repo.refs.prohibit_windows_device_names, expected.windows,","+                    \"{source}-{value}: ref-store initialization must use the same section filter\"","+                );","+                for (name, mode, rejected) in [","+                    (\"GIT~1\", None, expected.ntfs),","+                    (\".git...:stream\", None, expected.ntfs),","+                    (\".gi\\u{200c}t\", None, expected.hfs),","+                    (","+                        \".gi\\u{200c}tmodules\",","+                        Some(gix_validate::path::component::Mode::Symlink),","+                        expected.hfs,","+                    ),","+                    (\"dir\\\\file\", None, expected.windows),","+                ] {","+                    assert_eq!(","+                        gix_validate::path::component(name.into(), mode, validate).is_err(),","+                        rejected,","+                        \"{source}-{value}: path validation retains the selected protections for {name:?}\"","+                    );","+                }","+            }","+        }","+        for value in [\"false\", \"true\"] {","+            let overrides = [","+                format!(\"core.protectHFS={value}\"),","+                format!(\"core.protectNTFS={value}\"),","+                format!(\"gitoxide.core.protectWindows={value}\"),","+            ];","+            let repo = gix::open_opts(","+                fixture.join(format!(\"{source}-invalid\")),","+                crate::restricted()","+                    .with(Trust::Reduced)","+                    .strict_config(true)","+                    .config_overrides(overrides),","+            )?;","+            let validate = repo","+                .checkout_options(gix::worktree::stack::state::attributes::Source::IdMapping)?","+                .validate;","+            assert_eq!(","+                (validate.protect_windows, validate.protect_hfs, validate.protect_ntfs),","+                (value == \"true\", value == \"true\", value == \"true\"),","+                \"{source}: trusted API overrides remain usable under reduced trust\"","+            );","+            assert_eq!(","+                repo.refs.prohibit_windows_device_names,","+                value == \"true\",","+                \"{source}: trusted API overrides also configure the reference store\"","+            );","+        }","+    }","+    Ok(())","+}","+","+#[test]","+fn safe_directory_promotion_updates_reference_protection() -> TestResult {","+    let fixture = gix_testtools::scripted_fixture_read_only(\"make_path_protection_repos.sh\")?;","+    let mut permissions = gix::open::Permissions::isolated();","+    permissions.config.system = true;","+    for source in [\"local\", \"worktree\"] {","+        for value in [\"false\", \"true\"] {","+            let repo = gix::open_opts(","+                fixture.join(format!(\"{source}-{value}\")),","+                crate::restricted()","+                    .with(gix_sec::Trust::Reduced)","+                    .permissions(permissions)","+                    .system_config_path(fixture.join(\"trust-all-repositories.config\")),","+            )?;","+            assert_eq!(","+                repo.git_dir_trust(),","+                gix_sec::Trust::Full,","+                \"the system safe.directory promotes trust\"","+            );","+            assert_eq!(","+                repo.refs.prohibit_windows_device_names,","+                value == \"true\",","+                \"{source}: reference protection uses the final section trust\"","+            );","+        }","+    }","+    Ok(())","+}","+","+#[test]","+fn invalid_values_are_checked_only_in_eligible_sections() -> TestResult {","+    let fixture = gix_testtools::scripted_fixture_read_only(\"make_path_protection_repos.sh\")?;","+    for source in [\"local\", \"worktree\"] {","+        let repo = gix::open_opts(","+            fixture.join(format!(\"{source}-invalid\")),","+            crate::restricted().with(gix_sec::Trust::Reduced).strict_config(true),","+        )?;","+        repo.checkout_options(gix::worktree::stack::state::attributes::Source::IdMapping)?;","+        for key in [\"core.protectHFS\", \"core.protectNTFS\", \"gitoxide.core.protectWindows\"] {","+            let err = gix::open_opts(","+                fixture.join(format!(\"{source}-true\")),","+                crate::restricted()","+                    .with(gix_sec::Trust::Reduced)","+                    .strict_config(true)","+                    .config_overrides([format!(\"{key}=invalid\")]),","+            )","+            .and_then(|repo| {","+                repo.checkout_options(gix::worktree::stack::state::attributes::Source::IdMapping)","+                    .map(|_| ())","+            })","+            .expect_err(\"an eligible malformed protection setting must fail in strict mode\");","+            assert!(","+                err.is_validation(),","+                \"{source}: invalid {key} remains a validation error\"","+            );","+        }","+    }","+    Ok(())","+}",""],"additions":160,"deletions":0,"truncated":false}],"additions":222,"deletions":6,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-24T12:58:20.083863+00:00"}