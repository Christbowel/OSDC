rame provider and host-owned resize,","-full-width, and full-view controls as contributed editors. The guest consumes","-source updates through `WebEditorClient`, renders errors visibly, and preserves","-the iframe across presentation changes. A contributed matching `mermaid` provider","-takes precedence over the built-in renderer. The Mermaid bundle loads lazily.","-Run `node --test scripts/mermaid.browser.test.mts` from this extension directory","-to verify rendering, live updates, error recovery, and presentation controls.","+The `mermaid-markdown-features` extension contributes the Mermaid code block","+editor through `markdown.codeBlockEditorProviders`, sharing its theme and","+settings with the Markdown preview. This extension has no Mermaid renderer of","+its own."," "," ### Rich editor diagnostics"," "],"additions":10,"deletions":9,"truncated":false},{"path":"extensions/markdown-language-features/esbuild.markdownEditor.mts","lines":["@@ -18,8 +18,6 @@ const updatePackageJsonModuleUrl = new URL('./scripts/updateMarkdownEditorPackag"," const updatePackageJsonModulePath = fileURLToPath(updatePackageJsonModuleUrl);"," const taskProgressBuildModuleUrl = new URL('./scripts/buildTaskProgressHtml.mts', import.meta.url);"," const taskProgressBuildModulePath = fileURLToPath(taskProgressBuildModuleUrl);","-const mermaidBuildModuleUrl = new URL('./scripts/buildMermaidHtml.mts', import.meta.url);","-const mermaidBuildModulePath = fileURLToPath(mermaidBuildModuleUrl);"," "," async function updateMarkdownEditorPackageJsonFile(): Promise<unknown> {"," \tconst version = (await stat(updatePackageJsonModulePath)).mtimeMs;","@@ -40,21 +38,10 @@ run({"," \t\tupdatePackageJsonModulePath,"," \t\tfileURLToPath(new URL('./scripts/markdownEditorPackage.mts', import.meta.url)),"," \t\ttaskProgressBuildModulePath,","-\t\tmermaidBuildModulePath,"," \t],"," \tbeforeBuild: updateMarkdownEditorPackageJsonFile,"," \tadditionalOptions: {"," \t\tplugins: [...(editorPackage.directory ? [markdo