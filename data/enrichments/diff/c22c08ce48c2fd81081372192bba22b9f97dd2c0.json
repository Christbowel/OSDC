stImportTime{","+\t\t{NamespacedResource: dashboards, LastImportTime: older},","+\t\t{NamespacedResource: folders, LastImportTime: newer},","+\t\t// Another namespace, which must not count.","+\t\t{NamespacedResource: NamespacedResource{Namespace: \"other\", Group: \"folder.grafana.app\", Resource: \"folders\"}, LastImportTime: newer.Add(time.Hour)},","+\t}}","+\ts := &searchServer{storage: storage}","+","+\tgot, err := s.lastImportTime(t.Context(), GlobalSearchKey(\"ns\"))","+\trequire.NoError(t, err)","+\tassert.Equal(t, newer, got)","+","+\t// A per-resource index still answers with its own import time.","+\tgot, err = s.lastImportTime(t.Context(), dashboards)","+\trequire.NoError(t, err)","+\tassert.Equal(t, older, got)","+","+\ttimes, err := s.getLastImportTimes(t.Context(), []NamespacedResource{GlobalSearchKey(\"ns\"), dashboards})","+\trequire.NoError(t, err)","+\tassert.Equal(t, map[NamespacedResource]time.Time{GlobalSearchKey(\"ns\"): newer, dashboards: older}, times)","+}","+","+func TestLastImportTimeOfGlobalIndexNeverImported(t *testing.T) {","+\ts := &searchServer{storage: &mockStorageBackend{}}","+","+\tgot, err := s.lastImportTime(t.Context(), GlobalSearchKey(\"ns\"))","+\trequire.NoError(t, err)","+\tassert.True(t, got.IsZero())","+}","+","+func TestKeepStandardFieldsOnly(t *testing.T) {","+\tdoc := keepStandardFieldsOnly(&IndexableDocument{","+\t\tTitle:            \"kept\",","+\t\tFields:           map[string]any{\"panel_types\": []string{\"timeseries\"}},","+\t\tSelectableFields: map[string]string{\"spec.title\": \"kept\"},","+\t})","+\tassert.Equal(t, \"kept\", doc.Title)","+\tassert.Empty(t, doc.Fields)","+\tassert.Empty(t, doc.SelectableFields)","+","+\tassert.Nil(t, keepStandardFieldsOnly(nil))","+}","+"," func TestUpdateCopyFieldsSetsGroupResource(t *testing.T) {"," \tdoc := (&IndexableDocument{Key: &resourcepb.ResourceKey{"," \t\tNamespace: \"ns\","],"additions":119,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/searc