{"id":"c22c08ce48c2fd81081372192bba22b9f97dd2c0","axis":"silent","repo":"grafana/grafana","sha":"c22c08ce48c2fd81081372192bba22b9f97dd2c0","parsed":{"files":[{"path":"pkg/setting/setting.go","lines":["@@ -738,6 +738,7 @@ type Cfg struct {"," \tIndexCacheTTL                              time.Duration"," \tIndexMinUpdateInterval                     time.Duration // Don't update index if it was updated less than this interval ago."," \tIndexModificationCacheTTL                  time.Duration // TTL for dedup cache used in ListModifiedSince. 0 disables the cache.","+\tGlobalSearchIndexEnabled                   bool          // Build one index per namespace covering several resource types, alongside the per-resource indexes."," \tMaxFileIndexAge                            time.Duration // Max age of file-based indexes. Index older than this will be rebuilt asynchronously."," \tMinFileIndexBuildVersion                   string        // Minimum version of Grafana that built the file-based index. If index was built with older Grafana, it will be rebuilt asynchronously."," \tIndexSnapshotEnabled                       bool          // Enable remote index snapshots"],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/setting/setting_unified_storage.go","lines":["@@ -232,6 +232,9 @@ func (cfg *Cfg) setUnifiedStorageConfig() {"," \tcfg.IndexCacheTTL = section.Key(\"index_cache_ttl\").MustDuration(10 * time.Minute)"," \tcfg.IndexMinUpdateInterval = section.Key(\"index_min_update_interval\").MustDuration(0)"," \tcfg.IndexModificationCacheTTL = section.Key(\"index_modification_cache_ttl\").MustDuration(0)","+\t// Off by default: this builds a global index per namespace, holding the","+\t// dashboards and folders already covered by their own indexes.","+\tcfg.GlobalSearchIndexEnabled = section.Key(\"global_search_index_enabled\").MustBool(false)"," \tcfg.SprinklesApiServer = section.Key(\"sprinkles_api_server\").String()"," \tcfg.SprinklesApiServerPageLimit = section.Key(\"sprinkles_api_server_page_limit\").MustInt(10000)"," \tcfg.CACertPath = section.Key(\"ca_cert_path\").String()"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/global_search.go","lines":["@@ -1,11 +1,51 @@"," package resource"," "," import (","+\t\"crypto/sha256\"","+\t\"encoding/hex\"","+\t\"encoding/json\""," \t\"slices\""," "," \t\"k8s.io/apimachinery/pkg/runtime/schema\""," )"," ","+// GlobalSearchFieldsHash fingerprints what a namespace-wide index contains: its","+// field set and the resource types it covers. An existing index recording a","+// different value is rebuilt.","+//","+// The field set has to be here: it decides the mapping, and the mapping is part","+// of the stored index. The covered types are here only for now. Without them an","+// index reused after a type is added would never hold that type's existing","+// objects, and one reused after a type is dropped would keep serving them. A full","+// rebuild is the wrong answer to a coverage change, though: adding one type to a","+// long list should index only that type. This has to be replaced by syncing just","+// the types that changed before the index is switched on by default.","+func GlobalSearchFieldsHash() string {","+\tcovered := make([]string, 0, len(GlobalSearchResourceTypes()))","+\tfor _, gr := range GlobalSearchResourceTypes() {","+\t\tcovered = append(covered, gr.String())","+\t}","+\tslices.Sort(covered)","+","+\tpayload := struct {","+\t\tFields  []hashableField `json:\"f\"`","+\t\tCovered []string        `json:\"c\"`","+\t}{","+\t\tFields:  canonicalHashableFields(GlobalSearchFieldDefinitions()),","+\t\tCovered: covered,","+\t}","+","+\tblob, err := json.Marshal(payload)","+\tif err != nil {","+\t\t// Returning nothing disables the rebuild-on-change check, so the log line is","+\t\t// the only sign. See IndexAffectingHash for why this cannot happen today.","+\t\tsearchFieldLogger.Error(\"failed to marshal the namespace-wide search fields for hashing\", \"err\", err)","+\t\treturn \"\"","+\t}","+\tsum := sha256.Sum256(blob)","+\treturn hex.EncodeToString(sum[:])","+}","+"," // GlobalSearchResourceTypes lists the resource types a namespace-wide index"," // covers."," //","@@ -20,6 +60,40 @@ func GlobalSearchResourceTypes() []schema.GroupResource {"," \t}"," }"," ","+// keepStandardFieldsOnly drops what a document carries for its own resource type,","+// leaving the fields every resource has.","+//","+// A namespace-wide index declares no resource-specific fields, so these values","+// would be built, handed over, and dropped by the index, once per document and","+// with a warning each time.","+func keepStandardFieldsOnly(doc *IndexableDocument) *IndexableDocument {","+\tif doc == nil {","+\t\treturn nil","+\t}","+\tdoc.Fields = nil","+\tdoc.SelectableFields = nil","+\treturn doc","+}","+","+// indexSources returns the resource types whose documents belong in the index","+// for key. A namespace-wide index draws from every covered type; every other","+// index draws from its own type only.","+func indexSources(key NamespacedResource) []NamespacedResource {","+\tif !key.IsGlobal() {","+\t\treturn []NamespacedResource{key}","+\t}","+\ttypes := GlobalSearchResourceTypes()","+\tout := make([]NamespacedResource, 0, len(types))","+\tfor _, gr := range types {","+\t\tout = append(out, NamespacedResource{","+\t\t\tNamespace: key.Namespace,","+\t\t\tGroup:     gr.Group,","+\t\t\tResource:  gr.Resource,","+\t\t})","+\t}","+\treturn out","+}","+"," // GlobalSearchFieldDefinitions returns the searchable fields of a"," // namespace-wide index. It starts from the standard set, because such an index"," // holds nothing resource-specific, and differs in two ways:"],"additions":74,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/global_search_lifecycle_test.go","lines":["@@ -0,0 +1,456 @@","+package resource","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"iter\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+// multiTypeStorage answers per resource type, so a test can tell which types an","+// index read from and what each of them returned.","+type multiTypeStorage struct {","+\tmockStorageBackend","+","+\tlive     map[NamespacedResource][]string","+\tlistRVs  map[NamespacedResource]int64","+\tmodified map[NamespacedResource][]*ModifiedResource","+","+\tlisted         []NamespacedResource","+\tmodifiedSince  []NamespacedResource","+\thistoryListed  []NamespacedResource","+\tlastSinceRVSet []int64","+}","+","+func keyOf(k *resourcepb.ResourceKey) NamespacedResource {","+\treturn NamespacedResource{Namespace: k.GetNamespace(), Group: k.GetGroup(), Resource: k.GetResource()}","+}","+","+func (m *multiTypeStorage) ListIterator(_ context.Context, req *resourcepb.ListRequest, cb func(ListIterator) error) (int64, error) {","+\tkey := keyOf(req.GetOptions().GetKey())","+\tm.listed = append(m.listed, key)","+","+\trv := m.listRVs[key]","+\tif rv == 0 {","+\t\trv = 1","+\t}","+\treturn rv, cb(&namedListIterator{names: m.live[key], rv: rv, keysOnly: req.GetKeysOnly()})","+}","+","+// namedListIterator lists objects under their own names and resource version,","+// which is what a caller comparing an index with storage has to see.","+type namedListIterator struct {","+\tnames    []string","+\trv       int64","+\tkeysOnly bool","+\tpos      int","+}","+","+func (i *namedListIterator) Next() bool {","+\ti.pos++","+\treturn i.pos <= len(i.names)","+}","+func (i *namedListIterator) Error() error           { return nil }","+func (i *namedListIterator) ContinueToken() string  { return \"\" }","+func (i *namedListIterator) ResourceVersion() int64 { return i.rv }","+func (i *namedListIterator) Namespace() string      { return \"ns\" }","+func (i *namedListIterator) Name() string           { return i.names[i.pos-1] }","+func (i *namedListIterator) Folder() string         { return \"\" }","+func (i *namedListIterator) Value() []byte {","+\tif i.keysOnly {","+\t\t// A keys-only listing reads no bodies.","+\t\treturn nil","+\t}","+\tname := i.names[i.pos-1]","+\treturn testObjectJSON(name, name)","+}","+","+func (m *multiTypeStorage) ListHistory(_ context.Context, req *resourcepb.ListRequest, _ func(ListIterator) error) (int64, error) {","+\tm.historyListed = append(m.historyListed, keyOf(req.GetOptions().GetKey()))","+\treturn 0, nil","+}","+","+func (m *multiTypeStorage) ListModifiedSince(_ context.Context, key NamespacedResource, sinceRV int64, _ *time.Time) (int64, iter.Seq2[*ModifiedResource, error]) {","+\tm.modifiedSince = append(m.modifiedSince, key)","+\tm.lastSinceRVSet = append(m.lastSinceRVSet, sinceRV)","+","+\tevents := m.modified[key]","+\trv := m.listRVs[key]","+\tif rv == 0 {","+\t\trv = 1","+\t}","+\treturn rv, func(yield func(*ModifiedResource, error) bool) {","+\t\tfor _, e := range events {","+\t\t\tif !yield(e, nil) {","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t}","+}","+","+func globalTestServer(t *testing.T, storage StorageBackend, search *mockSearchBackend) *searchServer {","+\tt.Helper()","+\tserver, err := newSearchServer(SearchOptions{","+\t\tBackend: search,","+\t\tResources: &TestDocumentBuilderSupplier{GroupsResources: map[string]string{","+\t\t\t\"dashboard.grafana.app\": \"dashboards\",","+\t\t\t\"folder.grafana.app\":    \"folders\",","+\t\t}},","+\t\tGlobalIndexEnabled: true,","+\t\tInitMinCount:       1,","+\t}, storage, nil, nil, nil, nil, nil, ProvideIndexMetrics(nil), nil, nil)","+\trequire.NoError(t, err)","+\treturn server","+}","+","+func dashboardType(namespace string) NamespacedResource {","+\treturn NamespacedResource{Namespace: namespace, Group: \"dashboard.grafana.app\", Resource: \"dashboards\"}","+}","+","+func folderType(namespace string) NamespacedResource {","+\treturn NamespacedResource{Namespace: namespace, Group: \"folder.grafana.app\", Resource: \"folders\"}","+}","+","+// indexedNames returns the name of every document handed to the index, by","+// resource type, so a test can see what the index actually holds.","+func indexedNames(t *testing.T, idx *MockResourceIndex) map[NamespacedResource][]string {","+\tt.Helper()","+\tout := map[NamespacedResource][]string{}","+\tfor _, item := range idx.bulkItems {","+\t\trequire.Equal(t, ActionIndex, item.Action, \"unexpected removal\")","+\t\trequire.NotNil(t, item.Doc)","+\t\tkey := keyOf(item.Doc.Key)","+\t\tout[key] = append(out[key], item.Doc.Key.GetName())","+\t}","+\treturn out","+}","+","+func TestGlobalIndexBuildReadsEveryCoveredType(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{","+\t\t\tdashboardType(\"ns\"):    {\"dash-a\", \"dash-b\"},","+\t\t\tfolderType(\"ns\"):       {\"folder-a\"},","+\t\t\tdashboardType(\"other\"): {\"not-mine\"},","+\t\t},","+\t\t// The folder listing is the newer of the two.","+\t\tlistRVs: map[NamespacedResource]int64{dashboardType(\"ns\"): 10, folderType(\"ns\"): 20},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver := globalTestServer(t, storage, search)","+","+\tidx, err := server.build(t.Context(), GlobalSearchKey(\"ns\"), 3, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\tassert.ElementsMatch(t, []NamespacedResource{dashboardType(\"ns\"), folderType(\"ns\")}, storage.listed,","+\t\t\"one listing per covered type, in this namespace only\")","+","+\tassert.Equal(t, map[NamespacedResource][]string{","+\t\tdashboardType(\"ns\"): {\"dash-a\", \"dash-b\"},","+\t\tfolderType(\"ns\"):    {\"folder-a\"},","+\t}, indexedNames(t, idx.(*MockResourceIndex)))","+","+\t// A namespace-wide index holds only live documents, so the pass that restores","+\t// deleted ones does not run.","+\tassert.Empty(t, storage.historyListed)","+}","+","+// The index is only as current as its oldest listing, so a change made while a","+// later listing ran is picked up by the next update rather than missed.","+func TestGlobalIndexBuildReportsTheOldestVersion(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive:    map[NamespacedResource][]string{dashboardType(\"ns\"): {\"dash-a\"}, folderType(\"ns\"): {\"folder-a\"}},","+\t\tlistRVs: map[NamespacedResource]int64{dashboardType(\"ns\"): 30, folderType(\"ns\"): 20},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver := globalTestServer(t, storage, search)","+","+\t_, err := server.build(t.Context(), GlobalSearchKey(\"ns\"), 2, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\trequire.NotNil(t, search.lastUpdater)","+\tidx := &MockResourceIndex{}","+\trv, _, err := search.lastUpdater(t.Context(), idx, 0)","+\trequire.NoError(t, err)","+\tassert.Equal(t, int64(20), rv, \"the oldest of the covered types\")","+}","+","+func TestGlobalIndexUpdateFollowsEveryCoveredType(t *testing.T) {","+\tevent := func(action resourcepb.WatchEvent_Type, key NamespacedResource, name string, rv int64) *ModifiedResource {","+\t\treturn &ModifiedResource{","+\t\t\tAction:          action,","+\t\t\tKey:             resourcepb.ResourceKey{Namespace: key.Namespace, Group: key.Group, Resource: key.Resource, Name: name},","+\t\t\tResourceVersion: rv,","+\t\t\tValue:           testObjectJSON(name, name),","+\t\t}","+\t}","+\tstorage := &multiTypeStorage{","+\t\tmodified: map[NamespacedResource][]*ModifiedResource{","+\t\t\tdashboardType(\"ns\"): {event(resourcepb.WatchEvent_MODIFIED, dashboardType(\"ns\"), \"dash-a\", 11)},","+\t\t\tfolderType(\"ns\"):    {event(resourcepb.WatchEvent_ADDED, folderType(\"ns\"), \"folder-a\", 12)},","+\t\t},","+\t\tlistRVs: map[NamespacedResource]int64{dashboardType(\"ns\"): 11, folderType(\"ns\"): 12},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver := globalTestServer(t, storage, search)","+","+\t_, err := server.build(t.Context(), GlobalSearchKey(\"ns\"), 0, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\tidx := &MockResourceIndex{}","+\t_, docs, err := search.lastUpdater(t.Context(), idx, 5)","+\trequire.NoError(t, err)","+","+\tassert.Equal(t, 2, docs)","+\tassert.ElementsMatch(t, []NamespacedResource{dashboardType(\"ns\"), folderType(\"ns\")}, storage.modifiedSince)","+\tassert.Equal(t, []int64{5, 5}, storage.lastSinceRVSet, \"every type is asked for changes since the same point\")","+\tassert.Equal(t, map[NamespacedResource][]string{","+\t\tdashboardType(\"ns\"): {\"dash-a\"},","+\t\tfolderType(\"ns\"):    {\"folder-a\"},","+\t}, indexedNames(t, idx))","+}","+","+// A delete removes the document. Trash lives in the per-resource index, and a","+// namespace-wide index that kept a deleted document would serve it as a hit.","+func TestGlobalIndexUpdateRemovesDeletedDocuments(t *testing.T) {","+\tdeleted := &ModifiedResource{","+\t\tAction:          resourcepb.WatchEvent_DELETED,","+\t\tKey:             resourcepb.ResourceKey{Namespace: \"ns\", Group: \"dashboard.grafana.app\", Resource: \"dashboards\", Name: \"dash-a\"},","+\t\tResourceVersion: 11,","+\t\tValue:           testObjectJSON(\"dash-a\", \"dash-a\"),","+\t}","+\tstorage := &multiTypeStorage{","+\t\tmodified: map[NamespacedResource][]*ModifiedResource{dashboardType(\"ns\"): {deleted}},","+\t}","+\t// Even where the deployment keeps deleted documents, this index does not.","+\tsearch := &mockSearchBackend{keepsDeletedDocuments: true}","+\tserver := globalTestServer(t, storage, search)","+","+\t_, err := server.build(t.Context(), GlobalSearchKey(\"ns\"), 0, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\tidx := &MockResourceIndex{buildInfo: IndexBuildInfo{Features: featuresForTestIndex(true)}}","+\t_, _, err = search.lastUpdater(t.Context(), idx, 5)","+\trequire.NoError(t, err)","+","+\trequire.Len(t, idx.bulkItems, 1)","+\tassert.Equal(t, ActionDelete, idx.bulkItems[0].Action)","+\tassert.Nil(t, idx.bulkItems[0].Doc, \"no document is kept for a deleted object\")","+\tassert.Equal(t, \"dash-a\", idx.bulkItems[0].Key.GetName())","+}","+","+// Per-resource indexes are unchanged: they read their own type and restore their","+// trash, whatever the namespace-wide index does.","+func TestPerResourceIndexIsUnaffected(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{dashboardType(\"ns\"): {\"dash-a\"}, folderType(\"ns\"): {\"folder-a\"}},","+\t}","+\tsearch := &mockSearchBackend{keepsDeletedDocuments: true}","+\tserver := globalTestServer(t, storage, search)","+","+\tidx, err := server.build(t.Context(), dashboardType(\"ns\"), 1, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\tassert.Equal(t, []NamespacedResource{dashboardType(\"ns\")}, storage.listed)","+\tassert.Equal(t, []NamespacedResource{dashboardType(\"ns\")}, storage.historyListed, \"trash is restored as before\")","+\tassert.Equal(t, map[NamespacedResource][]string{","+\t\tdashboardType(\"ns\"): {\"dash-a\"},","+\t}, indexedNames(t, idx.(*MockResourceIndex)))","+}","+","+func TestGlobalIndexesAreIsolatedByNamespace(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{","+\t\t\tdashboardType(\"a\"): {\"a-dash\"},","+\t\t\tdashboardType(\"b\"): {\"b-dash\"},","+\t\t},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver := globalTestServer(t, storage, search)","+","+\tfor _, namespace := range []string{\"a\", \"b\"} {","+\t\tidx, err := server.build(t.Context(), GlobalSearchKey(namespace), 1, \"test\", false, time.Time{})","+\t\trequire.NoError(t, err)","+","+\t\tfor key := range indexedNames(t, idx.(*MockResourceIndex)) {","+\t\t\tassert.Equal(t, namespace, key.Namespace)","+\t\t}","+\t}","+}","+","+// The document builder writes its own resource type's fields, which this index","+// declares none of, so they are dropped before the index sees them. A","+// per-resource index keeps them.","+func TestGlobalIndexKeepsStandardFieldsOnly(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{dashboardType(\"ns\"): {\"dash-a\"}},","+\t\tmodified: map[NamespacedResource][]*ModifiedResource{dashboardType(\"ns\"): {{","+\t\t\tAction:          resourcepb.WatchEvent_MODIFIED,","+\t\t\tKey:             resourcepb.ResourceKey{Namespace: \"ns\", Group: \"dashboard.grafana.app\", Resource: \"dashboards\", Name: \"dash-b\"},","+\t\t\tResourceVersion: 11,","+\t\t\tValue:           testObjectJSON(\"dash-b\", \"dash-b\"),","+\t\t}}},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver := globalTestServer(t, storage, search)","+","+\tglobal, err := server.build(t.Context(), GlobalSearchKey(\"ns\"), 1, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+\tbuilt := global.(*MockResourceIndex).indexedItems()","+\trequire.Len(t, built, 1)","+\tassert.Empty(t, built[0].Doc.Fields, \"the build drops them\")","+","+\tupdated := &MockResourceIndex{}","+\t_, _, err = search.lastUpdater(t.Context(), updated, 5)","+\trequire.NoError(t, err)","+\trequire.Len(t, updated.indexedItems(), 1)","+\tassert.Empty(t, updated.indexedItems()[0].Doc.Fields, \"so does an update\")","+","+\tperResource, err := server.build(t.Context(), dashboardType(\"ns\"), 1, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+\tkept := perResource.(*MockResourceIndex).indexedItems()","+\trequire.Len(t, kept, 1)","+\tassert.NotEmpty(t, kept[0].Doc.Fields, \"a per-resource index keeps its own fields\")","+}","+","+// The existing lifecycle metrics have to cover this index too, or a build nobody","+// can see is the first sign of trouble.","+func TestGlobalIndexBuildIsVisibleInMetrics(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{dashboardType(\"ns\"): {\"dash-a\"}, folderType(\"ns\"): {\"folder-a\"}},","+\t}","+\tmetrics := ProvideIndexMetrics(prometheus.NewPedanticRegistry())","+\tsearch := &mockSearchBackend{}","+\tserver, err := newSearchServer(SearchOptions{","+\t\tBackend: search,","+\t\tResources: &TestDocumentBuilderSupplier{GroupsResources: map[string]string{","+\t\t\t\"dashboard.grafana.app\": \"dashboards\",","+\t\t\t\"folder.grafana.app\":    \"folders\",","+\t\t}},","+\t\tGlobalIndexEnabled: true,","+\t\tInitMinCount:       1,","+\t}, storage, nil, nil, nil, nil, nil, metrics, nil, nil)","+\trequire.NoError(t, err)","+","+\tkey := GlobalSearchKey(\"ns\")","+\t_, err = server.build(t.Context(), key, 2, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\t// Reported under the index's own key, so it is one series rather than mixed in","+\t// with the per-resource indexes.","+\tlabels := []string{IndexPhaseConvert, IndexPathBuild, key.Group, key.Resource}","+\tassert.Equal(t, 2.0, testutil.ToFloat64(metrics.BuildDocuments.WithLabelValues(labels...)),","+\t\t\"both documents are counted, whichever type they came from\")","+}","+","+// With the index switched off, nothing brings one into existence: not an index","+// the previous run left recorded as open, and not a request that names it.","+func TestGlobalIndexStaysOffWhenSwitchedOff(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{dashboardType(\"ns\"): {\"dash-a\"}},","+\t}","+\tsearch := &mockSearchBackend{openIndexStats: []ResourceStats{","+\t\t{NamespacedResource: dashboardType(\"ns\"), Count: 1},","+\t\t{NamespacedResource: GlobalSearchKey(\"ns\"), Count: 1},","+\t}}","+\tserver, err := newSearchServer(SearchOptions{","+\t\tBackend: search,","+\t\tResources: &TestDocumentBuilderSupplier{GroupsResources: map[string]string{","+\t\t\t\"dashboard.grafana.app\": \"dashboards\",","+\t\t\t\"folder.grafana.app\":    \"folders\",","+\t\t}},","+\t\tGlobalIndexEnabled: false,","+\t\tInitMinCount:       1,","+\t}, storage, nil, nil, nil, nil, nil, ProvideIndexMetrics(nil), nil, nil)","+\trequire.NoError(t, err)","+","+\t_, err = server.buildIndexes(t.Context())","+\trequire.NoError(t, err)","+\tfor _, call := range search.buildIndexCalls {","+\t\tassert.False(t, call.key.IsGlobal(), \"a restored namespace-wide index must not be built while switched off\")","+\t}","+\tassert.NotEmpty(t, search.buildIndexCalls, \"the per-resource index is still built\")","+","+\t_, err = server.getOrCreateIndex(t.Context(), nil, GlobalSearchKey(\"ns\"), \"test\")","+\trequire.Error(t, err)","+\tassert.Nil(t, search.GetIndex(GlobalSearchKey(\"ns\")))","+}","+","+// The update skips a change it has already applied, but each resource type counts","+// its versions on its own, so a dashboard and a folder can share both a name and","+// a version. Both must be applied, and each skipped only when it repeats.","+func TestGlobalIndexUpdateTellsTypesApartWhenSkippingRepeats(t *testing.T) {","+\tsame := func(key NamespacedResource) *ModifiedResource {","+\t\treturn &ModifiedResource{","+\t\t\tAction:          resourcepb.WatchEvent_MODIFIED,","+\t\t\tKey:             resourcepb.ResourceKey{Namespace: key.Namespace, Group: key.Group, Resource: key.Resource, Name: \"shared\"},","+\t\t\tResourceVersion: 11,","+\t\t\tValue:           testObjectJSON(\"shared\", \"shared\"),","+\t\t}","+\t}","+\tstorage := &multiTypeStorage{","+\t\tmodified: map[NamespacedResource][]*ModifiedResource{","+\t\t\tdashboardType(\"ns\"): {same(dashboardType(\"ns\"))},","+\t\t\tfolderType(\"ns\"):    {same(folderType(\"ns\"))},","+\t\t},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver, err := newSearchServer(SearchOptions{","+\t\tBackend: search,","+\t\tResources: &TestDocumentBuilderSupplier{GroupsResources: map[string]string{","+\t\t\t\"dashboard.grafana.app\": \"dashboards\",","+\t\t\t\"folder.grafana.app\":    \"folders\",","+\t\t}},","+\t\tGlobalIndexEnabled: true,","+\t\tInitMinCount:       1,","+\t\t// Switches on the cache that remembers applied changes.","+\t\tIndexModificationCacheTTL: time.Minute,","+\t}, storage, nil, nil, nil, nil, nil, ProvideIndexMetrics(nil), nil, nil)","+\trequire.NoError(t, err)","+","+\t_, err = server.build(t.Context(), GlobalSearchKey(\"ns\"), 0, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\tfirst := &MockResourceIndex{}","+\t_, _, err = search.lastUpdater(t.Context(), first, 5)","+\trequire.NoError(t, err)","+\tassert.Equal(t, map[NamespacedResource][]string{","+\t\tdashboardType(\"ns\"): {\"shared\"},","+\t\tfolderType(\"ns\"):    {\"shared\"},","+\t}, indexedNames(t, first), \"both are applied, not one taken for the other\")","+","+\t// The same changes reported again are skipped for both.","+\tagain := &MockResourceIndex{}","+\t_, _, err = search.lastUpdater(t.Context(), again, 5)","+\trequire.NoError(t, err)","+\tassert.Empty(t, again.indexedItems())","+}","+","+// Identity is the whole key, so two resource types can hold the same name","+// without one replacing the other.","+func TestGlobalIndexKeepsNamesOfDifferentTypesApart(t *testing.T) {","+\tstorage := &multiTypeStorage{","+\t\tlive: map[NamespacedResource][]string{","+\t\t\tdashboardType(\"ns\"): {\"shared-name\"},","+\t\t\tfolderType(\"ns\"):    {\"shared-name\"},","+\t\t},","+\t}","+\tsearch := &mockSearchBackend{}","+\tserver := globalTestServer(t, storage, search)","+","+\tidx, err := server.build(t.Context(), GlobalSearchKey(\"ns\"), 2, \"test\", false, time.Time{})","+\trequire.NoError(t, err)","+","+\tids := map[string]bool{}","+\tfor _, item := range idx.(*MockResourceIndex).bulkItems {","+\t\tids[SearchID(item.Doc.Key)] = true","+\t}","+\tassert.Len(t, ids, 2, fmt.Sprintf(\"two documents, not one: %v\", ids))","+}"],"additions":456,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/global_search_test.go","lines":["@@ -1,7 +1,9 @@"," package resource"," "," import (","+\t\"slices\""," \t\"testing\"","+\t\"time\""," "," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\"","@@ -66,6 +68,123 @@ func TestIndexFieldDefinitions(t *testi