nal class InterceptedDisposeMethod<T> extends InterceptedMethod<T, T> {","+final class InterceptedDisposeMethod<T> extends InterceptedMethod<T, T> implements BeanDefinitionMethodReference<T, T> {"," ","     private final DisposableIntercepted<T> disposableIntercepted;","     private final BeanResolutionContext beanResolutionContext;","@@ -59,6 +61,17 @@ final class InterceptedDisposeMethod<T> extends InterceptedMethod<T, T> {","         this.bean = bean;","     }"," ","+    /**","+     * The definition of the bean whose lifecycle event the chain intercepts, so that an interceptor can keep what it","+     * derives for the event on it, see {@link BeanDefinition#getCachedValue(Class, java.util.function.Function)}.","+     *","+     * @return The intercepted bean definition","+     */","+    @Override","+    public BeanDefinition<T> getBeanDefinition() {","+        return disposableIntercepted;","+    }","+","     /**","      * The callback of the bean, resolved by the executable method that stands for it rather than by looking a","      * name up on the declaring type: the chain declares no arguments, since a callback's arguments are resolved"],"additions":14,"deletions":1,"truncated":false},{"path":"aop/src/main/java/io/micronaut/aop/chain/ConstructorInterceptorChain.java","lines":["@@ -37,6 +37,7 @@"," import java.util.Arrays;"," import java.util.List;"," import java.util.Objects;","+import java.util.Optional;"," "," /**","  * Implementation of {@link InvocationContext} for constructor interception.","@@ -53,6 +54,7 @@ public final class ConstructorInterceptorChain<T> extends AbstractInterceptorCha","      * The constructor that is actually invoked. For a proxied bean this is the generated proxy constructor, which","      * declares the bean's own parameters followed by {@code additionalInterceptorParametersCount} internal ones.","      */","+    private final BeanDefinition<T> beanDefinition;","     private final BeanConstructor<T> beanConstructor;","     /**","      * The constructor made visible to interceptors: the constructor of the intercepted bean type with only the","@@ -70,7 +72,7 @@ public final class ConstructorInterceptorChain<T> extends AbstractInterceptorCha","     /**","      * Default constructor.","      *","-     * @param beanDefinition The bean constructor","+     * @param beanDefinition The bean definition","      * @param beanConstructor The bean constructor","      * @param interceptors The interceptors","      * @param declaredParameters The arguments the bean declares, which interceptors see and may change","@@ -83,6 +85,7 @@ public ConstructorInterceptorChain(","         @Nullable Object[] declaredParameters,","         @Nullable Object[] internalParameters) {","         super(interceptors, declaredParameters);","+        this.beanDefinition = Objects.requireNonNull(beanDefinition, \"Bean definition cannot be null\");","         this.beanConstructor = Objects.requireNonNull(beanConstructor, \"Bean constructor cannot be null\");","         this.internalParameters = internalParameters;","         this.interceptedConstructor = resolveInterceptedConstructor(beanDefinition, beanConstructor, internalParameters);","@@ -139,6 +142,11 @@ public BeanConstructor<T> getConstructor() {","         return interceptedConstructor;","     }"," ","+    @Override","+    public Optional<BeanDefinition<T>> findBeanDefinition() {","+        return Optional.of(beanDefinition);","+    }","+","     /**","      * Internal methods that handles the logic of instantiating a bean that has constructor interception applied.","      *"],"additions":9,"deletions":1,"truncated":false},{"path":"aop/src/main/java/io/micronaut/aop/chain/MethodInterceptorChain.java","lines":["@@ -28,11 +28,13 @@"," import io.micronaut.core.annotation.UsedByGeneratedCode;"," import io.micronaut.core.type.ReturnType;"," import io.micronaut.inject.BeanDefinition;","+import io.micronaut.inject.BeanDefinitionMethodReference;"," import io.micronaut.inject.ExecutableMethod;"," "," import java.lang.reflect.Method;"," import java.util.Collection;"," import java.util.Objects;","+import java.util.Optional;"," "," import static io.micronaut.core.util.ArrayUtils.EMPTY_OBJECT_ARRAY;"," ","@@ -211,6 +213,14 @@ public ExecutableMethod<T, R> getExecutableMethod() {","         return executionHandle;","     }"," ","+    @Override","+    public Optional<BeanDefinition<T>> findBeanDefinition() {","+        // any method that carries its definition answers, the methods standing for a lifecycle event of a bean do","+        return executionHandle instanceof BeanDefinitionMethodReference<T, R> reference","+            ? Optional.of(reference.getBeanDefinition())","+            : Optional.empty();","+    }","+","     /**","      * Internal method that handles the logic for executing {@link InterceptorKind#POST_CONSTRUCT} interception.","      *"],"additions":10,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/aop/compile/LifecycleInterceptorDefinitionSpec.groovy","lines":["@@ -0,0 +1,271 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.aop.compile","+","+import io.micronaut.annotation.processing.test.AbstractTypeElementSpec","+import io.micronaut.context.ApplicationContext","+","+/**","+ * A lifecycle interceptor reaches the definition of the bean whose event it intercepts, and keeps values on it.","+ */","+class LifecycleInterceptorDefinitionSpec extends AbstractTypeElementSpec {","+","+    void 'a lifecycle interceptor keeps what it derives for the event on the intercepted definition'() {","+        given:","+        ApplicationContext context = buildContext('''","+package lifecycledefinition;","+","+import io.micronaut.aop.*;","+import io.micronaut.context.annotation.Prototype;","+import io.micronaut.inject.BeanDefinition;","+import jakarta.annotation.PostConstruct;","+import jakarta.annotation.PreDestroy;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+import java.util.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@Target(ElementType.TYPE)","+@InterceptorBinding(kind = InterceptorKind.POST_CONSTRUCT)","+@InterceptorBinding(kind = InterceptorKind.PRE_DESTROY)","+@interface Tracked {","+}","+","+@Singleton","+@InterceptorBinding(value = Tracked.class, kind = InterceptorKind.POST_CONSTRUCT)","+@InterceptorBinding(value = Tracked.class, kind = InterceptorKind.PRE_DESTROY)","+class TrackingInterceptor implements Interceptor<Object, Object> {","+    final List<BeanDefinition<?>> definitions = new ArrayList<>();","+    final List<Object> plans = new ArrayList<>();","+    int computed;","+","+    @Override","+    public Object intercept(InvocationContext<Object, Object> context) {","+        BeanDefinition<?> definition = ((MethodInvocationContext<?, ?>) context).findBeanDefinition().orElseThrow();","+        definitions.add(definition);","+        plans.add(definition.getCachedValue(Plan.class, d -> {","+            computed++;","+            return new Plan(d.getBeanType().getSimpleName());","+        }));","+        return context.proceed();","+    }","+","+    record Plan(String name) {","+    }","+}","+","+@Prototype","+@Tracked","+class Bean {","+    @PostConstruct","+    void init() {","+    }","+","+    @PreDestroy","+    void destroy() {","+    }","+}","+''')","+        Class<?> beanType = context.classLoader.loadClass('lifecycledefinition.Bean')","+        def interceptor = context.getBean(context.classLoader.loadClass('lifecycledefinition.TrackingInterceptor'))","+","+        when:","+        def first = context.getBean(beanType)","+        def second = context.getBean(beanType)","+        context.destroyBean(first)","+","+        then:","+        interceptor.definitions.size() == 3","+        interceptor.definitions.every { it.is(context.getBeanDefinition(beanType)) }","+        interceptor.computed == 1","+        interceptor.plans.every { it.is(interceptor.plans[0]) }","+        interceptor.plans[0].name() == 'Bean'","+","+        cleanup:","+        context.close()","+    }","+","+    void 'an around advice invocation does not know the definition of the proxied bean'() {","+        given:","+        ApplicationContext context = buildContext('''","+package arounddefinition;","+","+import io.micronaut.aop.*;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+import java.util.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@Target(ElementType.TYPE)","+@Around","+@InterceptorBinding(kind = InterceptorKind.AROUND)","+@interface Watched {","+}","+","+@Singleton","+@InterceptorBinding(value = Watched.class, kind = InterceptorKind.AROUND)","+class WatchingInterceptor implements MethodInterceptor<Object, Object> {","+    final List<Boolean> known = new ArrayList<>();","+","+    @Override","+    public Object intercept(MethodInvocationContext<Object, Object> context) {","+        known.add(context.findBeanDefinition().isPresent());","+        return context.proceed();","+    }","+}","+","+@Singleton","+@Watched","+class Bean {","+    public String work() {","+        return \"w\";","+    }","+}","+''')","+        def bean = context.getBean(context.classLoader.loadClass('arounddefinition.Bean'))","+        def interceptor = context.getBean(context.classLoader.loadClass('arounddefinition.WatchingInterceptor'))","+","+        when:","+        def result = bean.work()","+","+        then:","+        result == 'w'","+        interceptor.known == [false]","+","+        cleanup:","+        context.close()","+    }","+","+    void 'a constructor interceptor reaches the definition of the bean it constructs'() {","+        given:","+        ApplicationContext context = buildContext('''","+package constructordefinition;","+","+import io.micronaut.aop.*;","+import io.micronaut.context.annotation.Prototype;","+import io.micronaut.inject.BeanDefinition;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+import java.util.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@Target(ElementType.TYPE)","+@AroundConstruct","+@interface Built {","+}","+","+@Singleton","+@InterceptorBean(Built.class)","+class BuildingInterceptor implements ConstructorInterceptor<Object> {","+    final List<BeanDefinition<?>> definitions = new ArrayList<>();","+    int computed;","+","+    @Override","+    public Object intercept(ConstructorInvocationContext<Object> context) {","+        BeanDefinition<?> definition = context.findBeanDefinition().orElseThrow();","+        definitions.add(definition);","+        definition.getCachedValue(Plan.class, d -> {","+            computed++;","+            return new Plan();","+        });","+        return context.proceed();","+    }","+","+    static final class Plan {","+    }","+}","+","+@Prototype","+@Built","+class Bean {","+}","+''')","+        Class<?> beanType = context.classLoader.loadClass('constructordefinition.Bean')","+        def interceptor = context.getBean(context.classLoader.loadClass('constructordefinition.BuildingInterceptor'))","+","+        when:","+        context.getBean(beanType)","+        context.getBean(beanType)","+","+        then:","+        interceptor.definitions.size() == 2","+        interceptor.definitions.every { it.is(context.getBeanDefinition(beanType)) }","+        interceptor.computed == 1","+","+        cleanup:","+        context.close()","+    }","+","+    void 'a lifecycle interceptor of a bean of each property reaches the definition the wrappers share'() {","+        given:","+        ApplicationContext context = buildContext('lifecycleeach.Source', '''","+package lifecycleeach;","+","+import io.micronaut.aop.*;","+import io.micronaut.context.annotation.EachProperty;","+import io.micronaut.inject.BeanDefinition;","+import jakarta.annotation.PostConstruct;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+import java.util.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@Target(ElementType.TYPE)","+@InterceptorBinding(kind = InterceptorKind.POST_CONSTRUCT)","+@interface Tracked {","+}","+","+@Singleton","+@InterceptorBinding(value = Tracked.class, kind = InterceptorKind.POST_CONSTRUCT)","+class TrackingInterceptor implements Interceptor<Object, Object> {","+    final List<BeanDefinition<?>> definitions = new ArrayList<>();","+","+    @Override","+    public Object intercept(InvocationContext<Object, Object> context) {","+        definitions.add(((MethodInvocationContext<?, ?>) context).findBeanDefinition().orElseThrow());","+        return context.proceed();","+    }","+}","+","+@EachProperty(\"tracked\")","+@Tracked","+class Each {","+    String value;","+","+    public void setValue(String value) {","+        this.value = value;","+    }","+","+    @PostConstruct","+    void init() {","+    }","+}","+''', false, ['tracked.a.value': 'a', 'tracked.b.value': 'b'])","+        Class<?> beanType = context.classLoader.loadClass('lifecycleeach.Each')","+        def interceptor = context.getBean(context.classLoader.loadClass('lifecycleeach.TrackingInterceptor'))","+","+        when:","+        context.getBeansOfType(beanType)","+","+        then:","+        interceptor.definitions.size() == 2","+        interceptor.definitions[0].is(interceptor.definitions[1])","+        context.getBeanDefinitions(beanType).every { it.getTarget().is(interceptor.definitions[0]) }","+","+        cleanup:","+        context.close()","+    }","+}"],"additions":271,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/cachedvalues/BeanDefinitionCachedValuesSpec.groovy","lines":["@@ -0,0 +1,442 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.inject.cachedvalues","+","+import io.micronaut.annotation.processing.test.AbstractTypeElementSpec","+import io.micronaut.context.ApplicationContext","+import io.micronaut.context.BeanContext","+import io.micronaut.context.BeanContextConfigurable","+import io.micronaut.context.EnvironmentConfigurable","+import io.micronaut.context.RuntimeBeanDefinition","+import io.micronaut.context.env.Environment","+import io.micronaut.context.env.PropertySource","+import io.micronaut.core.order.Ordered","+import io.micronaut.inject.BeanDefinition","+import io.micronaut.inject.BeanDefinitionReference","+import io.micronaut.inject.DelegatingBeanDefinition","+","+/**","+ * The values kept by {@link BeanDefinition#getCachedValue(Class, java.util.function.Function)}.","+ */","+class BeanDefinitionCachedValuesSpec extends AbstractTypeElementSpec {","+","+    private static final String SOURCE = '''","+package test;","+","+import jakarta.inject.Singleton;","+import java.lang.annotation.Retention;","+import java.lang.annotation.RetentionPolicy;","+","+@Retention(RetentionPolicy.RUNTIME)","+@interface Label {","+    String value();","+}","+","+@Singleton","+@Label(\"plain\")","+class Plain {","+}","+","+@Singleton","+@Label(\"${cached.label}\")","+class Placeholder {","+}","+","+@Singleton","+@Label(\"#{ 'evaluated' }\")","+class Evaluated {","+}","+","+@Singleton","+@Label(\"member\")","+class EvaluatedMember {","+    EvaluatedMember(@io.micronaut.context.annotation.Value(\"#{ 1 + 1 }\") int two) {","+    }","+}","+'''","+","+    void \"a value is computed once and kept per key\"() {","+        given:","+        ApplicationContext context = buildContext(SOURCE)","+        BeanDefinition<?> definition = definition(context, 'test.Plain')","+        int calls = 0","+","+        when:","+        def first = definition.getCachedValue(Name, d -> { calls++; new Name(d.stringValue('test.Label').orElseThrow()) })","+        def second = definition.getCachedValue(Name, d -> { calls++; new Name('other') })","+","+        then:","+        first.value() == 'plain'","+        second.is(first)","+        calls == 1","+","+        when: 'another key'","+        def other = definition.getCachedValue(Other, d -> { calls++; new Other() })","+","+        then:","+        definition.getCachedValue(Other, d -> { calls++; new Other() }).is(other)","+        definition.getCachedValue(Name, d -> { calls++; new Name('other') }).is(first)","+        calls == 2","+","+        cleanup:","+        context.close()","+    }","+","+    void \"a null value is kept\"() {","+        given:","+        ApplicationContext context = buildContext(SOURCE)","+        BeanDefinition<?> definition = definition(context, 'test.Plain')","+        int calls = 0","+","+        expect:","+        definition.getCachedValue(Name, d -> { calls++; null }) == null","+        definition.getCachedValue(Name, d -> { calls++; new Name('x') }) == null","+        calls == 1","+","+        cleanup:","+        context.close()","+    }","+","+    void \"a value derived from property placeholders is computed again when the properties change\"() {","+        given:","+        ApplicationContext context = buildContext('test.Source', SOURCE, false, ['cached.label': 'first'])","+        BeanDefinition<?> definition = definition(context, 'test.Placeholder')","+        def factory = { BeanDefinition<?> d -> new Name(d.stringValue('test.Label').orElseThrow()) }","+","+        when:","+        def first = definition.getCachedValue(Name, factory)","+","+        then:","+        first.value() == 'first'","+        definition.getCachedValue(Name, factory).is(first)","+","+        when:","+        context.getEnvironment().addPropertySource(PropertySource.of('override', ['cached.label': 'second'], Ordered.HIGHEST_PRECEDENCE))","+        def second = definition.getCachedValue(Name, factory)","+","+        then:","+        second.value() == 'second'","+        definition.getCachedValue(Name, factory).is(second)","+","+        cleanup:","+        context.close()","+    }","+","+    void \"a value of a definition with evaluated expressions is not kept\"() {","+        given:","+        ApplicationContext context = buildContext(SOURCE)","+        BeanDefinition<?> definition = definition(context, 'test.Evaluated')","+        int calls = 0","+","+        when:","+        definition.getCachedValue(Other, d -> { calls++; new Other() })","+        definition.getCachedValue(Other, d -> { calls++; new Other() })","+","+        then:","+        calls == 2","+","+        cleanup:","+        context.close()","+    }","+","+    void \"an unevaluated value is kept despite evaluated expressions, apart from the value\"() {","+        given:","+        ApplicationContext context = buildContext(SOURCE)","+        BeanDefinition<?> definition = definition(context, 'test.Evaluated')","+        int calls = 0","+","+        when:","+        def first = definition.getCachedUnevaluatedValue(Other, d -> { calls++; new Other() })","+","+        then:","+        definition.getCachedUnevaluatedValue(Other, d -> { calls++; new Other() }).is(first)","+        calls == 1","+","+        when: 'the value under the same key'","+        def value = definition.getCachedValue(Other, d -> { calls++; new Other() })","+","+        then:","+        !value.is(first)","+        calls == 2","+","+        cleanup:","+        context.close()","+    }","+","+    void \"an unevaluated value and a value are kept apart under the same key\"() {","+        given:","+        ApplicationContext context = buildContext(SOURCE)","+        BeanDefinition<?> definition = definition(context, 'test.Plain')","+","+        when:","+        def value = definition.getCachedValue(Other, d -> new Other())","+        def unevaluated = definition.getCachedUnevaluatedValue(Other, d -> new Other())","+","+        then:","+        !value.is(unevaluated)","+        definition.getCachedValue(Other, d -> new Other()).is(value)","+        definition.getCachedUnevaluatedValue(Other, d -> new Other()).is(unevaluated)","+","+        cleanup:","+        context.close()","+    }","+","+    void \"a wrapping definition hands the call to the definition it wraps\"() {","+        given:","+        ApplicationContext context = buildContext('test.Source', '''","+package test;","+","+import io.micronaut.context.annotation.EachProperty;","+","+@EachProperty(\"cached.each\")","+class Each {","+    String value;","+","+    public void setValue(String value) {","+        this.value = value;","+    }","+}","+''', false, ['cached.each.a.value': 'a', 'cached.each.b.value': 'b'])","+        List<BeanDefinition<?>> definitions = context.getBeanDefinitions(context.getClassLoader().loadClass('test.Each')).toList()","+        List<BeanDefinition<?>> seen = []","+","+        when:","+        def first = definitions[0].getCachedValue(Other, d -> { seen << d; new Other() })","+        def second = definitions[1].getCachedValue(Other, d -> { seen << d; new Other() })","+        def unevaluated = definitions[1].getCachedUnevaluatedValue(Other, d -> { seen << d; new Other() })","+","+ 