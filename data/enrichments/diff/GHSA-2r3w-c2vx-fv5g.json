dating tokens', async () => {","+      for (const path of ['/auth-real-legacy', '/auth-real-external']) {","+        for (const cookieName of ['authenticationToken', 'token']) {","+          for (const value of ['j:%7B%7D', 'j:%5B%5D']) {","+            const firstCallCount = firstCalls.length","+            const updateCount = updates.length","+            const response = await fetch(`http://127.0.0.1:${port}/rest/v0${path}`, {","+              headers: { Cookie: `${cookieName}=${value}` },","+            })","+","+            assert.equal(response.status, 401)","+            assert.equal(firstCalls.length, firstCallCount)","+            assert.equal(updates.length, updateCount)","+          }","+        }","+      }","+    })","+","+    it('accepts a valid string token on legacy and external routes', async () => {","+      const updateCount = updates.length","+      for (const path of ['/auth-real-legacy', '/auth-real-external']) {","+        const response = await get(port, path)","+        assert.equal(response.status, 200)","+      }","+      assert.equal(updates.length - updateCount, 2)","+    })","+  })"," })"],"additions":90,"deletions":0,"truncated":false},{"path":"packages/xo-server/src/xo-mixins/authentication.mjs","lines":["@@ -16,6 +16,8 @@ const log = createLogger('xo:authentification')"," "," const noSuchAuthenticationToken = id => noSuchObject(id, 'authenticationToken')"," ","+const isNonEmptyString = value => typeof value === 'string' && value.length !== 0","+"," export default class {","   constructor(app) {","     app.config.watch('authentication', config => {","@@ -51,7 +53,7 @@ export default class {"," ","     // Token authentication provider.","     this.registerAuthenticationProvider(async ({ token: tokenId }, { ip } = {}) => {","-      if (!tokenId) {","+      if (!isNonEmptyString(tokenId)) {","         return","       }"," ","@@ -278,8 +280,13 @@ export default class {","     await db.remove((await db.get()).filter(createPredicate(filter)