{"id":"4749e6c2ae695e7f79d9b498ed6cfcd0dc94225b","axis":"silent","repo":"Azure/azure-sdk-for-net","sha":"4749e6c2ae695e7f79d9b498ed6cfcd0dc94225b","parsed":{"files":[{"path":"sdk/core/Azure.Core/CHANGELOG.md","lines":["@@ -4,6 +4,8 @@"," "," ### Features Added"," ","+- Promoted AKS identity binding support in `WorkloadIdentityCredential` to general availability. `WorkloadIdentityCredentialOptions.IsAzureProxyEnabled` no longer requires suppressing experimental diagnostic `AZID0002`. Identity binding remains opt-in and isn't supported by `DefaultAzureCredential` or `ManagedIdentityCredential`.","+"," ### Breaking Changes"," "," ### Bugs Fixed"],"additions":2,"deletions":0,"truncated":false},{"path":"sdk/core/Azure.Core/README.md","lines":["@@ -51,6 +51,29 @@ We guarantee that all client instance methods are thread-safe and independent of"," "," **NOTE:** Samples in this file apply only to packages that follow [Azure SDK Design Guidelines](https://azure.github.io/azure-sdk/dotnet_introduction.html). Names of such packages usually start with `Azure`."," ","+### Authenticating with AKS identity bindings","+","+AKS identity binding support in `WorkloadIdentityCredential` is generally available","+in Azure.Core 1.64.0 and later. The credential is provided by Azure.Core and retains","+the `Azure.Identity` namespace; a separate Azure.Identity package is not required.","+Identity binding is opt-in and does not require an experimental diagnostic suppression:","+","+```C# Snippet:WorkloadIdentityCredentialWithIdentityBinding","+var credential = new WorkloadIdentityCredential(new WorkloadIdentityCredentialOptions","+{","+    IsAzureProxyEnabled = true  // Enable identity binding mode","+});","+```","+","+`IsAzureProxyEnabled` defaults to `false`. Follow the","+[AKS identity binding setup instructions](https://learn.microsoft.com/azure/aks/identity-bindings)","+to configure the binding, service-account permissions, and workload identity","+webhook settings. Enabling the SDK option does not create resources or grant","+permission to use the managed identity. Use `WorkloadIdentityCredential` directly;","+this mode is not supported by `DefaultAzureCredential` or `ManagedIdentityCredential`.","+The [Azure.Core live tests](https://github.com/Azure/azure-sdk-for-net/blob/main/sdk/core/Azure.Core/tests/IdentityBinding/WorkloadIdentityBindingTests.md) describe validation","+against real AKS resources.","+"," ### Configuring Service Clients Using `ClientOptions`"," "," Azure SDK client libraries typically expose one or more _service client_ types that"],"additions":23,"deletions":0,"truncated":false},{"path":"sdk/core/Azure.Core/api/Azure.Core.net10.0.cs","lines":["@@ -1805,7 +1805,6 @@ public WorkloadIdentityCredentialOptions() { }","         public System.Collections.Generic.IList<string> AdditionallyAllowedTenants { get { throw null; } }","         public string ClientId { get { throw null; } set { } }","         public bool DisableInstanceDiscovery { get { throw null; } set { } }","-        [System.Diagnostics.CodeAnalysis.ExperimentalAttribute(\"AZID0002\")]","         public bool IsAzureProxyEnabled { get { throw null; } set { } }","         public string TenantId { get { throw null; } set { } }","         public string TokenFilePath { get { throw null; } set { } }"],"additions":0,"deletions":1,"truncated":false},{"path":"sdk/core/Azure.Core/api/Azure.Core.net8.0.cs","lines":["@@ -1805,7 +1805,6 @@ public WorkloadIdentityCredentialOptions() { }","         public System.Collections.Generic.IList<string> AdditionallyAllowedTenants { get { throw null; } }","         public string ClientId { get { throw null; } set { } }","         public bool DisableInstanceDiscovery { get { throw null; } set { } }","-        [System.Diagnostics.CodeAnalysis.ExperimentalAttribute(\"AZID0002\")]","         public bool IsAzureProxyEnabled { get { throw null; } set { } }","         public string TenantId { get { throw null; } set { } }","         public string TokenFilePath { get { throw null; } set { } }"],"additions":0,"deletions":1,"truncated":false},{"path":"sdk/core/Azure.Core/src/Identity/Credentials/WorkloadIdentityCredential.cs","lines":["@@ -52,9 +52,7 @@ public WorkloadIdentityCredential(WorkloadIdentityCredentialOptions options)","                 clientAssertionCredentialOptions.MsalClient = options.MsalClient;"," ","                 // Configure Kubernetes token proxy if user opted in","-#pragma warning disable AZID0002 // IsAzureProxyEnabled is experimental","                 if (options.IsAzureProxyEnabled)","-#pragma warning restore AZID0002","                 {","                     var proxyConfig = KubernetesProxyConfig.TryCreate();","                     if (proxyConfig != null)"],"additions":0,"deletions":2,"truncated":false},{"path":"sdk/core/Azure.Core/src/Identity/Credentials/WorkloadIdentityCredentialOptions.cs","lines":["@@ -5,7 +5,6 @@"," "," using System;"," using System.Collections.Generic;","-using System.Diagnostics.CodeAnalysis;"," using System.Runtime.CompilerServices;"," using System.Text;"," ","@@ -46,11 +45,13 @@ public class WorkloadIdentityCredentialOptions : TokenCredentialOptions, ISuppor","         public bool DisableInstanceDiscovery { get; set; }"," ","         /// <summary>","-        /// Enables Azure Kubernetes token proxy mode to work around Entra's limit on federated identity credentials.","+        /// Enables Azure Kubernetes Service identity binding mode to work around Entra's limit on federated identity credentials.","         /// When enabled and proxy configuration environment variables are set, requests are sent to the AKS proxy instead of directly to Entra ID.","-        /// This feature is not supported when using DefaultAzureCredential.","+        /// This feature is not supported when using <see cref=\"DefaultAzureCredential\"/> or <see cref=\"ManagedIdentityCredential\"/>.","         /// </summary>","-        [Experimental(\"AZID0002\")]","+        /// <remarks>","+        /// Defaults to <c>false</c>. The AKS identity binding and Kubernetes permissions must be configured separately.","+        /// </remarks>","         public bool IsAzureProxyEnabled { get; set; }"," ","         /// <summary>"],"additions":5,"deletions":4,"truncated":false},{"path":"sdk/core/Azure.Core/src/Identity/DefaultAzureCredentialFactory.cs","lines":["@@ -336,9 +336,7 @@ public virtual TokenCredential CreateWorkloadIdentityCredential()","             options.ClientId = Options.WorkloadIdentityClientId;","             options.TenantId = Options.TenantId;","             options.Pipeline = Pipeline;","-#pragma warning disable AZID0002 // IsAzureProxyEnabled is experimental","             options.IsAzureProxyEnabled = Options.IsAzureProxyEnabled;","-#pragma warning restore AZID0002"," ","             if (!string.IsNullOrEmpty(Options.WorkloadTokenFilePath))","             {"],"additions":0,"deletions":2,"truncated":false},{"path":"sdk/core/Azure.Core/src/docs/ExperimentalFeatures.md","lines":["@@ -84,30 +84,6 @@ Or in your project file:"," </PropertyGroup>"," ```"," ","-## AZID0002 - Identity: IsAzureProxyEnabled Experimental API","-","-### Description","-","-The `IsAzureProxyEnabled` property on `WorkloadIdentityCredentialOptions` enables the Azure Kubernetes Service proxy for workload identity authentication.","-","-### Affected APIs","-","-- `Azure.Identity.WorkloadIdentityCredentialOptions.IsAzureProxyEnabled`","-","-### Suppression","-","-```csharp","-#pragma warning disable AZID0002","-```","-","-Or in your project file:","-","-```xml","-<PropertyGroup>","-  <NoWarn>$(NoWarn);AZID0002</NoWarn>","-</PropertyGroup>","-```","-"," ## AZID0003 - Identity: TokenRequestCallback Experimental API"," "," ### Description"],"additions":0,"deletions":24,"truncated":false},{"path":"sdk/core/Azure.Core/tests/Identity/WorkloadIdentityCredentialTests.cs","lines":["@@ -12,9 +12,8 @@"," using Azure.Core;"," using Azure.Core.TestFramework;"," using Azure.Core.Tests.Identity.Mock;","-using NUnit.Framework;","-"," using Azure.Identity;","+using NUnit.Framework;"," namespace Azure.Core.Tests.Identity"," {","     public class WorkloadIdentityCredentialTests : CredentialTestBase<WorkloadIdentityCredentialOptions>","@@ -41,9 +40,7 @@ protected virtual TokenCredential CreateProxyTestCredential(bool isAzureProxyEna","                 TenantId = TenantId,","                 ClientId = ClientId,","                 TokenFilePath = \"/fake/path/token\",","-#pragma warning disable AZID0002 // IsAzureProxyEnabled is experimental","                 IsAzureProxyEnabled = isAzureProxyEnabled,","-#pragma warning restore AZID0002","                 MsalClient = mockConfidentialMsalClient,","                 Pipeline = CredentialPipeline.GetInstance(null)","             });"],"additions":1,"deletions":4,"truncated":false},{"path":"sdk/core/Azure.Core/tests/Identity/samples/ReadmeSnippets.cs","lines":["@@ -3,10 +3,9 @@"," "," using System;"," using Azure.Core;","+using Azure.Identity;"," using Azure.Storage.Blobs;"," using NUnit.Framework;","-","-using Azure.Identity;"," namespace Azure.Core.Tests.Identity.Samples"," {","     public class ReadmeSnippets","@@ -66,14 +65,12 @@ public void AuthenticatingWithAuthorityHost()","         [Test]","         public void WorkloadIdentityCredentialWithIdentityBinding()","         {","-#pragma warning disable AZID0002 // IsAzureProxyEnabled is experimental","             #region Snippet:WorkloadIdentityCredentialWithIdentityBinding","             var credential = new WorkloadIdentityCredential(new WorkloadIdentityCredentialOptions","             {","                 IsAzureProxyEnabled = true  // Enable identity binding mode","             });","             #endregion","-#pragma warning restore AZID0002","         }"," ","         [Test]","@@ -82,7 +79,6 @@ public void MigrationToWorkloadIdentityCredential()","             // Verify commented code compiles.","             var fooCredential = new ManagedIdentityCredential(ManagedIdentityId.SystemAssigned);"," ","-#pragma warning disable AZID0002 // IsAzureProxyEnabled is experimental","             #region Snippet:MigrationToWorkloadIdentityCredential","             // Before (no identity binding support):","             // var credential = new ManagedIdentityCredential(ManagedIdentityId.SystemAssigned);","@@ -93,7 +89,6 @@ public void MigrationToWorkloadIdentityCredential()","                 IsAzureProxyEnabled = true","             });","             #endregion","-#pragma warning restore AZID0002","         }","     }"," }"],"additions":1,"deletions":6,"truncated":false},{"path":"sdk/core/Azure.Core/tests/IdentityBinding/Run-WorkloadIdentityBindingTests.ps1","lines":["@@ -0,0 +1,321 @@","+# Copyright (c) Microsoft Corporation. All rights reserved.","+# Licensed under the MIT License.","+","+#Requires -Version 7.4","+","+[CmdletBinding()]","+param(","+    [Parameter(Mandatory)]","+    [string] $SubscriptionId,","+    [Parameter(Mandatory)]","+    [string] $ResourceGroup,","+    [Parameter(Mandatory)]","+    [string] $ClusterName,","+    [Parameter(Mandatory)]","+    [string] $IdentityName","+)","+","+$ErrorActionPreference = 'Stop'","+$PSNativeCommandUseErrorActionPreference = $true","+$repo = (Resolve-Path (Join-Path $PSScriptRoot '..\\..\\..\\..\\..')).Path","+$state = Join-Path $repo \"artifacts\\aks-identity-binding-ga\\live-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"","+New-Item -ItemType Directory -Path $state | Out-Null","+","+$account = az account show --subscription $SubscriptionId --output json | ConvertFrom-Json","+if ($account.environmentName -ne 'AzureCloud') {","+    throw 'This live test requires Azure public cloud.'","+}","+$group = az group show --subscription $SubscriptionId --name $ResourceGroup --output json | ConvertFrom-Json","+if ($group.tags.sample -ne 'workload-identity-proxy') {","+    throw 'Use a dedicated resource group tagged sample=workload-identity-proxy.'","+}","+$deadline = [DateTimeOffset]::UtcNow.AddMinutes(10)","+do {","+    $cluster = az aks show --subscription $SubscriptionId --resource-group $ResourceGroup --name $ClusterName --output json | ConvertFrom-Json","+    if ($cluster.provisioningState -eq 'Succeeded') {","+        break","+    }","+    if ($cluster.provisioningState -notin @('Creating', 'Updating') -or [DateTimeOffset]::UtcNow -ge $deadline) {","+        throw \"Cluster readiness failed: $($cluster.provisioningState).\"","+    }","+    Start-Sleep -Seconds 10","+} while ($true)","+if ($cluster.provisioningState -ne 'Succeeded' -or !$cluster.securityProfile.workloadIdentity.enabled -or !$cluster.oidcIssuerProfile.enabled) {","+    throw 'The cluster must be ready with workload identity and OIDC enabled.'","+}","+if ($cluster.apiServerAccessProfile.enableVnetIntegration) {","+    throw 'AKS identity binding does not support API server VNet integration.'","+}","+$identity = az identity show --subscription $SubscriptionId --resource-group $ResourceGroup --name $IdentityName --output json | ConvertFrom-Json","+if ($identity.tenantId -ne $account.tenantId) {","+    throw 'The identity and cluster subscription must use the same tenant.'","+}","+$bindings = @(az aks identity-binding list --subscription $SubscriptionId --resource-group $ResourceGroup --cluster-name $ClusterName --output json | ConvertFrom-Json)","+if (!($bindings | Where-Object { $_.properties.managedIdentity.resourceId -ieq $identity.id -and $_.properties.provisioningState -eq 'Succeeded' })) {","+    az aks identity-binding create --subscription $SubscriptionId --resource-group $ResourceGroup --cluster-name $ClusterName `","+        --name \"$IdentityName-binding\" --managed-identity-resource-id $identity.id --output none","+}","+$fics = @(az identity federated-credential list --subscription $SubscriptionId --resource-group $ResourceGroup --identity-name $IdentityName --output json | ConvertFrom-Json)","+if ($fics.Count -ne 1 -or $fics[0].name -ne 'aks-identity-binding') {","+    throw 'The negative test requires only the AKS-managed aks-identity-binding FIC; do not add a conventional FIC.'","+}","+$roles = @(az role assignment list --subscription $SubscriptionId --scope $group.id --include-inherited --output json | ConvertFrom-Json)","+if ($roles | Where-Object { $_.principalId -eq $identity.principalId }) {","+    throw 'The direct-upload test identity must not have Azure roles on the test resource group.'","+}","+","+$kubeconfig = Join-Path $state 'kubeconfig'","+az aks get-credentials --subscription $SubscriptionId --resource-group $ResourceGroup --name $ClusterName --admin --file $kubeconfig --output none","+$kube = @('--kubeconfig', $kubeconfig)","+kubectl @kube wait --for=condition=Ready nodes --all --timeout=180s","+$existingNamespace = kubectl @kube get namespace wi-proxy --ignore-not-found --output json","+if ($existingNamespace) {","+    $namespace = $existingNamespace | ConvertFrom-Json","+    if ($namespace.metadata.labels.'app.kubernetes.io/part-of' -ne 'workload-identity-proxy') {","+        throw 'Refusing to overwrite a namespace that is not owned by this test.'","+    }","+}","+","+$publish = Join-Path $state 'publish'","+dotnet publish (Join-Path $PSScriptRoot '..\\Azure.Core.Tests.csproj') --configuration Release `","+    --framework net10.0 --runtime linux-x64 --self-contained false --output $publish --verbosity quiet","+$expectedCoreHash = (Get-FileHash (Join-Path $publish 'Azure.Core.dll') -Algorithm SHA256).Hash","+","+$identityManifest = @\"","+apiVersion: v1","+kind: Namespace","+metadata:","+  name: wi-proxy","+  labels:","+    app.kubernetes.io/part-of: workload-identity-proxy","+---","+apiVersion: v1","+kind: ServiceAccount","+metadata:","+  name: wi-proxy","+  namespace: wi-proxy","+  annotations:","+    azure.workload.identity/client-id: \"$($identity.clientId)\"","+    azure.workload.identity/tenant-id: \"$($identity.tenantId)\"","+---","+apiVersion: rbac.authorization.k8s.io/v1","+kind: ClusterRole","+metadata:","+  name: wi-proxy-$($identity.clientId)","+rules:","+  - verbs: [\"use-managed-identity\"]","+    apiGroups: [\"cid.wi.aks.azure.com\"]","+    resources: [\"$($identity.clientId)\"]","+---","+apiVersion: rbac.authorization.k8s.io/v1","+kind: ClusterRoleBinding","+metadata:","+  name: wi-proxy-$($identity.clientId)","+roleRef:","+  apiGroup: rbac.authorization.k8s.io","+  kind: ClusterRole","+  name: wi-proxy-$($identity.clientId)","+subjects:","+  - kind: ServiceAccount","+    name: wi-proxy","+    namespace: wi-proxy","+\"@","+$identityManifest | kubectl @kube apply --filename -","+kubectl @kube --namespace wi-proxy delete job wi-proxy-enabled wi-proxy-disabled --ignore-not-found --wait=true","+","+$jobTimeoutSeconds = 600","+","+function Get-RemainingJobSeconds {","+    param(","+        [System.Diagnostics.Stopwatch] $Timer,","+        [int] $MaximumSeconds = $jobTimeoutSeconds","+    )","+","+    $remaining = [int][Math]::Floor($jobTimeoutSeconds - $Timer.Elapsed.TotalSeconds)","+    if ($remaining -le 0) {","+        throw \"Live job exceeded its $jobTimeoutSeconds-second lifecycle budget. See redacted logs in $state.\"","+    }","+    return [Math]::Min($remaining, $MaximumSeconds)","+}","+","+$logCollectionFailures = @()","+foreach ($mode in @('enabled', 'disabled')) {","+    $testMethod = if ($mode -eq 'enabled') { 'AuthenticateWithProxy' } else { 'AuthenticateWithoutProxy' }","+    $jobManifest = @\"","+apiVersion: batch/v1","+kind: Job","+metadata:","+  name: wi-proxy-$mode","+  namespace: wi-proxy","+spec:","+  backoffLimit: 0","+  activeDeadlineSeconds: $jobTimeoutSeconds","+  template:","+    metadata:","+      labels:","+        azure.workload.identity/use: \"true\"","+      annotations:","+        azure.workload.identity/use-identity-binding: \"true\"","+    spec:","+      serviceAccountName: wi-proxy","+      restartPolicy: Never","+      nodeSelector:","+        kubernetes.io/os: linux","+        kubernetes.io/arch: amd64","+      securityContext:","+        runAsNonRoot: true","+        runAsUser: 1654","+        runAsGroup: 1654","+        fsGroup: 1654","+        seccompProfile:","+          type: RuntimeDefault","+      containers:","+        - name: app","+          image: mcr.microsoft.com/dotnet/sdk:10.0","+          command: [\"/bin/sh\", \"-c\"]","+          args:","+            - >-","+              while [ ! -f /app/.ready ]; do sleep 1; done;","+              dotnet vstest /app/Azure.Core.Tests.dll","+              --TestCaseFilter:FullyQualifiedName=Azure.Core.Tests.IdentityBinding.WorkloadIdentityBindingLiveTests.$testMethod","+              --TestAdapterPath:/app","+              '--logger:trx;LogFileName=$mode.trx'","+              '--logger:console;verbosity=detailed'","+              --ResultsDirectory:/tmp/test-results;","+              result=`$?;","+              grep -o '<Counters [^>]*/>' /tmp/test-results/$mode.trx;","+              exit \"`$result\"","+          env:","+            - name: ARM_RESOURCE_ID","+              value: \"$($group.id)\"","+            - name: AZURE_TEST_MODE","+              value: Live","+            - name: AZURE_CORE_IDENTITY_BINDING_TESTS","+              value: \"true\"","+            - name: DOTNET_CLI_HOME","+              value: /tmp","+            - name: HOME","+              value: /tmp","+            - name: DOTNET_NOLOGO","+              value: \"true\"","+            - name: DOTNET_CLI_TELEMETRY_OPTOUT","+              value: \"1\"","+            - name: DOTNET_GENERATE_ASPNET_CERTIFICATE","+              value: \"false\"","+          securityContext:","+            readOnlyRootFilesystem: true","+            allowPrivilegeEscalation: false","+            capabilities:","+              drop: [\"ALL\"]","+          resources:","+            requests:","+              cpu: 250m","+              memory: 256Mi","+            limits:","+              cpu: \"2\"","+              memory: 1Gi","+          volumeMounts:","+            - name: app","+              mountPath: /app","+            - name: tmp","+              mountPath: /tmp","+      volumes:","+        - name: app","+          emptyDir: {}","+        - name: tmp","+          emptyDir: {}","+\"@","+    $jobTimer = [System.Diagnostics.Stopwatch]::StartNew()","+    try {","+        $remaining = Get-RemainingJobSeconds $jobTimer","+        $jobManifest | kubectl @kube --request-timeout=\"${remaining}s\" apply --filename -","+        $remaining = Get-RemainingJobSeconds $jobTimer","+        $waitTimeout = Get-RemainingJobSeconds $jobTimer -MaximumSeconds 180","+        kubectl @kube --request-timeout=\"${remaining}s\" --namespace wi-proxy wait --for=create pod --selector \"job-name=wi-proxy-$mode\" --timeout=\"${waitTimeout}s\"","+        $remaining = Get-RemainingJobSeconds $jobTimer","+        $waitTimeout = Get-RemainingJobSeconds $jobTimer -MaximumSeconds 180","+        kubectl @kube --request-timeout=\"${remaining}s\" --namespace wi-proxy wait --for=condition=Ready pod --selector \"job-name=wi-proxy-$mode\" --timeout=\"${waitTimeout}s\"","+        $remaining = Get-RemainingJobSeconds $jobTimer","+        $pod = kubectl @kube --request-timeout=\"${remaining}s\" --namespace wi-proxy get pod --selector \"job-name=wi-proxy-$mode\" --output 'jsonpath={.items[0].metadata.name}'","+        # The emptyDir root is kubelet-owned; do not restore its archived directory metadata.","+        $remaining = Get-RemainingJobSeconds $jobTimer","+        tar -C $publish -cf - . | kubectl @kube --request-timeout=\"${remaining}s\" --namespace wi-proxy exec --stdin $pod --container app -- tar --no-same-owner --no-same-permissions --no-overwrite-dir -xf - -C /app","+        $remaining = Get-RemainingJobSeconds $jobTimer","+        kubectl @kube --request-timeout=\"${remaining}s\" --namespace wi-proxy exec $pod --container app -- touch /app/.ready","+        do {","+            $remaining = Get-RemainingJobSeconds $jobTimer","+            $job = kubectl @kube --request-timeout=\"${remaining}s\" --namespace wi-proxy get job \"wi-proxy-$mode\" --output json | ConvertFrom-Json","+            $failed = @($job.status.conditions | Where-Object { $_.type -in @('Failed', 'FailureTarget') -and $_.status -eq 'True' })","+            if ($failed.Count -gt 0) {","+                throw \"Live job failed: wi-proxy-$mode. See redacted logs in $state.\"","+            }","+            $complete = @($job.status.conditions | Where-Object { $_.type -eq 'Complete' -and $_.status -eq 'True' })","+            if ($complete.Count -gt 0) {","+                break","+            }","+            Start-Sleep -Seconds (Get-RemainingJobSeconds $jobTimer -MaximumSeconds 5)","+        } while ($true)","+    }","+    finally {","+        try {","+            $output = @(kubectl @kube --request-timeout=30s --namespace wi-proxy logs \"job/wi-proxy-$mode\" --container app)","+            $output | Set-Content (Join-Path $state \"$mode.log\") -Encoding utf8","+            # NUnit repeats live console output in the detailed per-test result.","+            $output | Where-Object { $_.TrimStart().StartsWith('{\"scenario\":') } |","+                ForEach-Object { $_.Trim() } | Select-Object -Unique |","+                Set-Content (Join-Path $state \"$mode.jsonl\") -Encoding utf8","+        }","+        catch {","+            $logCollectionFailures += $mode","+            Write-Warning \"Could not collect logs for wi-proxy-${mode}: $($_.Exception.Message)\"","+        }","+    }","+}","+","+if ($logCollectionFailures.Count -gt 0) {","+    throw \"Live job logs are unavailable for: $($logCollectionFailures -join ', '). See the collection warnings.\"","+}","+","+$nunitResults = @{}","+foreach ($mode in @('enabled', 'disabled')) {","+    $results = @(Get-Content (Join-Path $state \"$mode.jsonl\") | ForEach-Object { $_ | ConvertFrom-Json })","+    $expectedScenarios = if ($mode -eq 'enabled') { @('candidate', 'configuration', 'async', 'cache', 'sync', 'concurrent', 'arm-authentication', 'nunit') } else { @('candidate', 'configuration', 'disabled', 'nunit') }","+    if ($results.Count -ne $expectedScenarios.Count -or ($results | Where-Object { $_.passed -ne $true }) -or","+        (Compare-Object $expectedScenarios @($results.scenario))) {","+        throw \"Unexpected or failing results in $mode.jsonl.\"","+    }","+    $candidate = $results | Where-Object { $_.scenario -eq 'candidate' }","+    if ($candidate.details.coreSha256 -ne $expectedCoreHash -or $candidate.details.credentialAssembly -ne 'Azure.Core') {","+        throw 'The pod did not run the Azure.Core candidate published from this worktree.'","+    }","+    $testMethod = if ($mode -eq 'enabled') { 'AuthenticateWithProxy' } else { 'AuthenticateWithoutProxy' }","+    $nunit = $results | Where-Object { $_.scenario -eq 'nunit' }","+    if ($nunit.details.assembly -ne 'Azure.Core.Tests' -or","+        $nunit.details.test -ne \"Azure.Core.Tests.IdentityBinding.WorkloadIdentityBindingLiveTests.$testMethod\") {","+        throw 'The pod did not execute the expected Azure.Core NUnit test.'","+    }","+    $counterLines = @(Get-Content (Join-Path $state \"$mode.log\") | Where-Object { $_.TrimStart().StartsWith('<Counters ') })","+    if ($counterLines.Count -ne 1) {","+        throw \"Expected one genuine TRX result counter in $mode.log.\"","+    }","+    [xml] $counters = $counterLines[0].Trim()","+    if ($counters.Counters.total -ne '1' -or $counters.Counters.executed -ne '1' -or","+        $counters.Counters.passed -ne '1' -or $counters.Counters.failed -ne '0') {","+        throw \"The Azure.Core NUnit test must pass, not be skipped or undiscovered: $mode.\"","+    }","+    $nunitResults[$mode] = @{ test = $nunit.details.test; passed = 1; failed = 0 }","+    Get-Content (Join-Path $state \"$mode.jsonl\")","+}","+$jobs = kubectl @kube --namespace wi-proxy get jobs --output json | ConvertFrom-Json","+$pods = kubectl @kube --namespace wi-proxy get pods --output json | ConvertFrom-Json","+@{","+    testedAt = [DateTimeOffset]::UtcNow.ToString('O')","+    resourceGroup = $group.id","+    cluster = $cluster.name","+    kubernetesVersion = $cluster.currentKubernetesVersion","+    coreSha256 = $expectedCoreHash","+    nunitResults = $nunitResults","+    jobs = @($jobs.items | ForEach-Object { @{ name = $_.metadata.name; succeeded = $_.status.succeeded } })","+    images = @($pods.items.status.containerStatuses.imageID)","+} | ConvertTo-Json -Depth 5 | Set-Content (Join-Path $state 'summary.json') -Encoding utf8","+Write-Host \"Both Azure.Core NUnit live tests and Kubernetes jobs passed. Redacted evidence: $state\""],"additions":321,"deletions":0,"truncated":false},{"path":"sdk/core/Azure.Core/tests/IdentityBinding/WorkloadIdentityBindingLiveTests.cs","lines":["@@ -0,0 +1,55 @@","+// Copyright (c) Microsoft Corporation. All rights reserved.","+// Licensed under the MIT License.","+","+#if NET8_0_OR_GREATER","+using System;","+using System.Text.Json;","+using System.Threading.Tasks;","+using Azure.Core.TestFramework;","+using NUnit.Framework;","+","+namespace Azure.Core.Tests.IdentityBinding","+{","+    [LiveOnly(Reason = \"Requires an AKS pod configured for identity binding.\")]","+    [NonParallelizable]","+    public class WorkloadIdentityBindingLiveTests","+    {","+        [OneTimeSetUp]","+        public void RequireIdentityBindingEnvironment()","+        {","+            if (!string.Equals(Environment.GetEnvironmentVariable(\"AZURE_CORE_IDENTITY_BINDING_TESTS\"), \"true\", StringComparison.OrdinalIgnoreCase))","+            {","+                Assert.Ignore(\"Run with AZURE_CORE_IDENTITY_BINDING_TESTS=true using tests\\\\IdentityBinding\\\\Run-WorkloadIdentityBindingTests.ps1.\");","+            }","+        }","+","+        [Test]","+        public async Task AuthenticateWithProxy()","+        {","+            await RunScenarioAsync(\"enabled\").ConfigureAwait(false);","+        }","+","+        [Test]","+        public async Task AuthenticateWithoutProxy()","+        {","+            await RunScenarioAsync(\"disabled\").ConfigureAwait(false);","+        }","+","+        private static async Task RunScenarioAsync(string mode)","+        {","+            int result = await WorkloadIdentityBindingScenarioRunner.RunAsync(new[] { mode }).ConfigureAwait(false);","+            Assert.That(result, Is.Zero, \"See the redacted scenario results for the authentication failure.\");","+            TestContext.Out.WriteLine(JsonSerializer.Serialize(new","+            {","+                scenario = \"nunit\",","+                passed = true,","+                details = new","+                {","+                    assembly = typeof(WorkloadIdentityBindingLiveTests).Assembly.GetName().Name,","+                    test = TestContext.CurrentContext.Test.FullName","+                }","+            }));","+        }","+    }","+}","+#endif"],"additions":55,"deletions":0,"truncated":false},{"path":"sdk/core/Azure.Core/tests/IdentityBinding/WorkloadIdentityBindingScenarioRunner.cs","lines":["@@ -0,0 +1,298 @@","+// Copyright (c) Microsoft Corporation. All rights reserved.","+// Licensed under the MIT License.","+","+#if NET8_0_OR_GREATER","+using System;","+using System.Collections.Concurrent;","+using System.Diagnostics.Tracing;","+using System.IO;","+using System.Linq;","+using System.Net;","+using System.Net.Http;","+using System.Net.Http.Headers;","+using System.Reflection;","+using System.Security.Cryptography;","+using System.Security.Cryptography.X509Certificates;","+using System.Text.Json;","+using System.Text.RegularExpressions;","+using System.Threading;","+using System.Threading.Tasks;","+using Azure.Core;","+using Azure.Identity;","+","+namespace Azure.Core.Tests.IdentityBinding","+{","+    internal static class WorkloadIdentityBindingScenarioRunner","+    {","+        internal static async Task<int> RunAsync(string[] args)","+        {","+            string scenario = \"configuration\";","+            try","+            {","+                Require(args.Length == 1 && (args[0] == \"enabled\" || args[0] == \"disabled\"),","+                    \"Specify enabled or disabled.\");","+                Require(typeof(WorkloadIdentityCredential).Assembly == typeof(TokenCredential).Assembly,","+                    \"The live tests must exercise the credential implementation in Azure.Core.\");","+                string tenantId = RequiredEnvironmentVariable(\"AZURE_TENANT_ID\");","+                string clientId = RequiredEnvironmentVariable(\"AZURE_CLIENT_ID\");","+                Require(Guid.TryParse(tenantId, out _) && Guid.TryParse(clientId, out _),","+                    \"Tenant and client IDs must be GUIDs.\");","+                Require(!string.IsNullOrWhiteSpace(File.ReadAllText(RequiredEnvironmentVariable(\"AZURE_FEDERATED_TOKEN_FILE\"))),","+                    \"The projected token file must not be empty.\");","+                var authority = new Uri(RequiredEnvironmentVariable(\"AZURE_AUTHORITY_HOST\"));","+                Require(authority.Scheme == Uri.UriSchemeHttps, \"The authority must use HTTPS.\");","+                var proxy = new Uri(RequiredEnvironmentVariable(\"AZURE_KUBERNETES_TOKEN_PROXY\"));","+                Require(proxy.Scheme == Uri.UriSchemeHttps && proxy.UserInfo.Length == 0 &&","+                    proxy.Query.Length == 0 && proxy.Fragment.Length == 0, \"The proxy URL must be HTTPS without credentials, query or fragment.\");"],"additions":46,"deletions":0,"truncated":false}],"additions":454,"deletions":44,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-10-22T13:47:09.887490+00:00"}