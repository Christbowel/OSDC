etween","+                        // comments, we should not apply the concise formatting. Let's call them","+                        // ```","+                        // {   { ... }   }","+                        // ^---       ^---","+                        // pre_sp     post_sp","+                        // ```","+                        let pre_sp = outer_block.span.until(inner_block.span);","+                        let post_sp = inner_block.span.until(outer_block.span);","+                        if contains_comment(context.snippet(pre_sp))","+                            || contains_comment(context.snippet(post_sp))","+                        {","+                            None","+                        } else {","+                            Some(e)","+                        }","+                    }","                     _ => None,","                 }","             }"],"additions":48,"deletions":13,"truncated":false},{"path":"tests/target/cfg_select/cfg_select_edge_cases.rs","lines":["@@ -72,7 +72,11 @@ fn check_match_block_formatting() {"," "," fn cfg_select_comments_that_might_get_lost() {","     cfg_select! {","-        _ => {{ x }}","+        _ => {","+            // after opening brace","+            { x }","+            // before closing brace","+        }","     }","     cfg_select! {","         _ => {{ x }}"],"additions":5,"deletions":1,"truncated":false},{"path":"tests/target/cfg_select/issue_7209.rs","lines":["@@ -3,8 +3,9 @@"," "," fn gettid() -> u64 {","     cfg_select! {","-        any(target_os = \"solaris\", target_os = \"illumos\") => {unsafe {","-            libc::pthread_self() as u64","-        }}","+        any(target_os = \"solaris\", target_os = \"illumos\") => {","+            // On Solaris and Illumos, the `pthread_t` is the OS TID.","+            unsafe { libc::pthread_self() as u64 }","+        }","     }"," }",""],"additions":4,"deletions":3,"truncated":false}],"additions":58,"deletions":18,"truncated":false,"file_count":4}