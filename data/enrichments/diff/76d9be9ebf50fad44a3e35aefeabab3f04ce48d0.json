s":38,"deletions":20,"truncated":false},{"path":"src/main/java/tools/jackson/databind/ser/impl/PropertyBasedObjectIdGenerator.java","lines":["@@ -27,6 +27,21 @@ protected PropertyBasedObjectIdGenerator(Class<?> scope, BeanPropertyWriter prop","         _property = prop;","     }"," ","+    /**","+     * Helper method for finding the property used as the Object Id by given","+     * {@link ObjectIdWriter}, if any (that is, if it uses a property-based generator).","+     *","+     * @return Object Id property, if any; {@code null} if none","+     *","+     * @since 3.3","+     */","+    public static BeanPropertyWriter findIdProperty(ObjectIdWriter oiw) {","+        if ((oiw != null) && (oiw.generator instanceof PropertyBasedObjectIdGenerator pg)) {","+            return pg._property;","+        }","+        return null;","+    }","+","     /**","      * We must override this method, to prevent errors when scopes are the same,","      * but underlying class (on which to access property) is different."],"additions":15,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/databind/objectid/ObjectIdWithViewsAndFilters6410Test.java","lines":["@@ -0,0 +1,406 @@","+package tools.jackson.databind.objectid;","+","+import java.util.ArrayList;","+import java.util.List;","+","+import org.junit.jupiter.api.Test;","+","+import com.fasterxml.jackson.annotation.*;","+","+import tools.jackson.databind.*;","+import tools.jackson.databind.annotation.JsonDeserialize;","+import tools.jackson.databind.annotation.JsonPOJOBuilder;","+import tools.jackson.databind.jsonFormatVisitors.JsonFormatVisitorWrapper;","+import tools.jackson.databind.jsonFormatVisitors.JsonObjectFormatVisitor;","+import tools.jackson.databind.ser.PropertyFilter;","+import tools.jackson.databind.ser.std.SimpleBeanPropertyFilter;","+import tools.jackson.databind.ser.std.SimpleFilterProvider;","+import tools.jackson.databind.testutil.DatabindTestUtil;","+","+import static org.junit.jupiter.api.Assertions.*;","+","+/**","+ * Tests to verify that Object Id property (of {@code PropertyGenerator}) is","+ * considered metadata, not affected by {@code @JsonView} or {@code @JsonFilter}.","+ */","+public class ObjectIdWithViewsAndFilters6410Test extends DatabindTestUtil","+{","+    static class Public {}","+    static class Internal {}","+","+    // Object Id property with a View that excludes it","+    @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+    @JsonPropertyOrder({ \"id\", \"email\", \"other\" })","+    static class Account {","+        @JsonView(Internal.class) public int id;","+        @JsonView(Public.class) public String email;","+        @JsonView(Public.class) public Account other;","+    }","+","+    // Object Id property with no View (excluded by default in 3.x)","+    @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+    @JsonPropertyOrder({ \"id\", \"email\", \"other\" })","+    static class NoViewId {","+        public int id;","+        @JsonView(Public.class) public String email;","+        @JsonView(Public.class) public NoViewId other;","+    }","+","+    @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+    @JsonPropertyOrder({ \"id\", \"email\", \"other\" })","+    static class CreatorAccount {","+        @JsonView(Internal.class) public final int id;","+        @JsonView(Public.class) public String email;","+        @JsonView(Public.class) public CreatorAccount other;","+","+        @JsonCreator","+        CreatorAccount(@JsonProperty(\"id\") int id) { this.id = id; }","+    }","+","+    @JsonFilter(\"idFilter\")","+    @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+    @JsonPropertyOrder({ \"id\", \"email\", \"secret\", \"other\" })","+    static class FilteredAccount {","+        @JsonView(Internal.class) public int id;","+        @JsonView(Public.class) public String email;","+        @JsonView(Public.class) public String secret;","+        @JsonView(Public.class) public FilteredAccount other;","+    }","+","+    // No class-level Object Id: defined via property-level annotation","+    @JsonPropertyOrder({ \"name\", \"id\" })","+    static class NodeIdLast {","+        @JsonView(Public.class) public String name;","+        @JsonView(Internal.class) public int id;","+    }","+","+    @JsonPropertyOrder({ \"id\", \"name\" })","+    static class NodeIdFirst {","+        @JsonView(Internal.class) public int id;","+        @JsonView(Public.class) public String name;","+    }","+","+    @JsonPropertyOrder({ \"first\", \"second\" })","+    static class NodeHolder<T> {","+        @JsonView(Public.class)","+        @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+        public T first;","+","+        @JsonView(Public.class)","+        @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+        public T second;","+    }","+","+    // Creator + Object Id + View on id, with `@JsonUnwrapped` (different code path)","+    static class Name {","+        @JsonView(Public.class) public String first, last;","+    }","+","+    @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+    static class UnwrappedCreatorAccount {","+        @JsonView(Internal.class) public final int id;","+        @JsonView(Public.class) @JsonUnwrapped public Name name;","+","+        @JsonCreator","+        UnwrappedCreatorAccount(@JsonProperty(\"id\") int id) { this.id = id; }","+    }","+","+    // Creator + Object Id + View on id, with External Type Id (different code path)","+    static class Payload {","+        @JsonView(Public.class) public int value;","+    }","+","+    @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+    static class ExtTypeCreatorAccount {","+        @JsonView(Internal.class) public final int id;","+","+        @JsonView(Public.class)","+        @JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.EXTERNAL_PROPERTY,","+                property = \"type\")","+        @JsonSubTypes(@JsonSubTypes.Type(value = Payload.class, name = \"payload\"))","+        public Object payload;","+","+        @JsonCreator","+        ExtTypeCreatorAccount(@JsonProperty(\"id\") int id) { this.id = id; }","+    }","+","+    // Builder with Creator + Object Id + View on id","+    @JsonDeserialize(builder = BuiltAccount.Builder.class)","+    static class BuiltAccount {","+        final int id;","+        final String email;","+","+        BuiltAccount(int id, String email) {","+            this.id = id;","+            this.email = email;","+        }","+","+        @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+        @JsonPOJOBuilder(withPrefix = \"\")","+        static class Builder {","+            final int id;","+            String email;","+","+            @JsonCreator","+            Builder(@JsonView(Internal.class) @JsonProperty(\"id\") int id) { this.id = id; }","+","+            @JsonView(Public.class)","+            public Builder email(String email) { this.email = email; return this; }","+","+            public BuiltAccount build() { return new BuiltAccount(id, email); }","+        }","+    }","+","+    // Builder with Creator + Object Id + View on id, with `@JsonUnwrapped`","+    @JsonDeserialize(builder = BuiltUnwrappedAccount.Builder.class)","+    static class BuiltUnwrappedAccount {","+        final int id;","+        final Name name;","+","+        BuiltUnwrappedAccount(int id, Name name) {","+            this.id = id;","+            this.name = name;","+        }","+","+        @JsonIdentityInfo(generator = ObjectIdGenerators.PropertyGenerator.class, property = \"id\")","+        @JsonPOJOBuilder(withPrefix = \"\")","+        static class Builder {","+            final int id;","+            Name name;","+","+            @JsonCreator","+            Builder(@JsonView(Internal.class) @JsonProperty(\"id\") int id) { this.id = id; }","+","+            @JsonView(Public.class)","+            @JsonUnwrapped","+            public Builder name(Name name) { this.name = name; return this; }","+","+            public BuiltUnwrappedAccount build() { return new BuiltUnwrappedAccount(id, name); }","+        }","+    }","+","+    private final ObjectMapper MAPPER = newJsonMapper();","+","+    private final ObjectMapper EXCLUDE_ID_MAPPER =","+            filterMapper(SimpleBeanPropertyFilter.serializeAllExcept(\"id\", \"secret\"));","+","+    /*","+    /**********************************************************************","+    /* Serialization, Views","+    /**********************************************************************","+     */","+","+    @Test","+    void writeIdExcludedByView() throws Exception","+    {","+        Account a = new Account();","+        a.id = 1;","+        a.email = \"a@x\";","+        a.other = a;","+","+        assertEquals(\"\"\"","+                {\"id\":1,\"email\":\"a@x\",\"other\":1}\"\"\",","+                MAPPER.writerWithView(Public.class).writeValueAsString(a));","+        // and with other view, id still written but not other props","+        assertEquals(\"\"\"","+                {\"id\":1}\"\"\",","+                MAPPER.writerWithView(Internal.class).writeValueAsString(a));","+    }","+","+    @Test","+    void writeIdWithoutViewRoundTrip() throws Exception","+    {","+        NoViewId n = new NoViewId();","+        n.id = 2;","+        n.email = \"n@x\";","+        n.other = n;","+","+        // 3.x defaults to `DEFAULT_VIEW_INCLUSION` disabled: id must still be written","+        assertFalse(MAPPER.isEnabled(MapperFeature.DEFAULT_VIEW_INCLUSION));","+        final String json = MAPPER.writerWithView(Public.class).writeValueAsString(n);","+        assertEquals(\"\"\"","+                {\"id\":2,\"email\":\"n@x\",\"other\":2}\"\"\", json);","+","+        // and must be readable (previously failed with unresolved forward reference)","+        NoViewId result = MAPPER.readerWithView(Public.class)","+                .forType(NoViewId.class)","+                .readValue(json);","+        assertEquals(2, result.id);","+        assertEquals(\"n@x\", result.email);","+        assertSame(result, result.other);","+    }","+","+    // Object Id defined using property-level annotation (contextual path)","+    @Test","+    void writePropertyLevelIdExcludedByView() throws Exception","+    {","+        // id property not first: gets reordered","+        NodeIdLast last = new NodeIdLast();","+        last.id = 3;","+        last.name = \"last\";","+        NodeHolder<NodeIdLast> h1 = new NodeHolder<>();","+        h1.first = last;","+        h1.second = last;","+        assertEquals(\"\"\"","+                {\"first\":{\"id\":3,\"name\":\"last\"},\"second\":3}\"\"\",","+                MAPPER.writerWithView(Public.class).writeValueAsString(h1));","+","+        // id property already first: no reordering","+        NodeIdFirst first = new NodeIdFirst();","+        first.id = 4;","+        first.name = \"first\";","+        NodeHolder<NodeIdFirst> h2 = new NodeHolder<>();","+        h2.first = first;","+        h2.second = first;","+        assertEquals(\"\"\"","+                {\"first\":{\"id\":4,\"name\":\"first\"},\"second\":4}\"\"\",","+                MAPPER.writerWithView(Public.class).writeValueAsString(h2));","+    }","+","+    /*","+    /**********************************************************************","+    /* Serialization, @JsonFilter","+    /**********************************************************************","+     */","+","+    @Test","+    void writeIdExcludedByFilter() throws Exception","+    {","+        FilteredAccount a = new FilteredAccount();","+        a.id = 5;","+        a.email = \"f@x\";","+        a.secret = \"shh\";","+        a.other = a;","+","+        final String json = EXCLUDE_ID_MAPPER.writeValueAsString(a);","+        assertEquals(\"\"\"","+                {\"id\":5,\"email\":\"f@x\",\"other\":5}\"\"\", json);","+        FilteredAccount result = EXCLUDE_ID_MAPPER.readValue(json, FilteredAccount.class);","+        assertEquals(5, result.id);","+        assertNull(result.secret);","+        assertSame(result, result.other);","+","+        // and same with \"include only\" filter not listing id","+        assertEquals(\"\"\"","+                {\"id\":5,\"email\":\"f@x\"}\"\"\",","+                filterMapper(SimpleBeanPropertyFilter.filterOutAllExcept(\"email\"))","+                        .writeValueAsString(a));","+    }","+","+    @Test","+    void writeIdExcludedByViewAndFilter() throws Exception","+    {","+        FilteredAccount a = new FilteredAccount();","+        a.id = 6;","+        a.email = \"vf@x\";","+        a.secret = \"shh\";","+        assertEquals(\"\"\"","+                {\"id\":6,\"email\":\"vf@x\",\"other\":null}\"\"\",","+                EXCLUDE_ID_MAPPER.writerWithView(Public.class).writeValueAsString(a));","+    }","+","+    @Test","+    void schemaIdExcludedByFilter() throws Exception","+    {","+        final List<String> names = new ArrayList<>();","+        EXCLUDE_ID_MAPPER.acceptJsonFormatVisitor(FilteredAccount.class, new JsonFormatVisitorWrapper.Base() {","+            @Override","+            public JsonObjectFormatVisitor expectObjectFormat(JavaType type) {","+                return new JsonObjectFormatVisitor.Base(getContext()) {","+                    @Override","+                    public void optionalProperty(BeanProperty prop) {","+                        names.add(prop.getName());","+                    }","+                };","+            }","+        });","+        assertEquals(List.of(\"id\", \"email\", \"other\"), names);","+    }","+","+    /*","+    /**********************************************************************","+    /* Deserialization, Views","+    /**********************************************************************","+     */","+","+    @Test","+    void readIdExcludedByView() throws Exception","+    {","+        Account a = _publicReader(Account.class).readValue(\"\"\"","+                {\"id\":7,\"email\":\"r@x\",\"other\":7}\"\"\");","+        assertEquals(7, a.id);","+        assertEquals(\"r@x\", a.email);","+        assertSame(a, a.other);","+    }","+","+    @Test","+    void readCreatorIdExcludedByView() throws Exception","+    {","+        final String json = \"\"\"","+                {\"id\":8,\"email\":\"c@x\",\"other\":8}\"\"\";","+        // Previously id was not passed to Creator (or failed, with","+        // `FAIL_ON_UNEXPECTED_VIEW_PROPERTIES`), although Object Id was bound","+        final ObjectReader strict = _publicReader(CreatorAccount.class);","+        for (ObjectReader r : List.of(strict,","+                strict.without(DeserializationFeature.FAIL_ON_UNEXPECTED_VIEW_PROPERTIES))) {","+            CreatorAccount a = r.readValue(json);","+            assertEquals(8, a.id);","+            assertEquals(\"c@x\", a.email);","+            assertSame(a, a.other);","+        }","+    }","+","+    @Test","+    void readUnwrappedCreatorIdExcludedByView() throws Exception","+    {","+        UnwrappedCreatorAccount a = _publicReader(UnwrappedCreatorAccount.class)","+                .readValue(\"\"\"","+                {\"id\":9,\"first\":\"Bob\",\"last\":\"Burger\"}\"\"\");","+        assertEquals(9, a.id);","+        assertEquals(\"Bob\", a.name.first);","+        assertEquals(\"Burger\", a.name.last);","+    }","+","+    @Test","+    void readExternalTypeIdCreatorIdExcludedByView() throws Exception","+    {","+        ExtTypeCreatorAccount a = _publicReader(ExtTypeCreatorAccount.class)","+                .readValue(\"\"\"","+                {\"id\":10,\"type\":\"payload\",\"payload\":{\"value\":42}}\"\"\");","+        assertEquals(10, a.id);","+        assertEquals(42, assertInstanceOf(Payload.class, a.payload).value);","+    }","+","+    @Test","+    void readBuilderCreatorIdExcludedByView() throws Exception","+    {","+        BuiltAccount a = _publicReader(BuiltAccount.class)","+                .readValue(\"\"\"","+                {\"id\":11,\"email\":\"b@x\"}\"\"\");","+        assertEquals(11, a.id);","+        assertEquals(\"b@x\", a.email);","+    }","+","+    @Test","+    void readBuilderUnwrappedCreatorIdExcludedByView() throws Exception","+    {","+        BuiltUnwrappedAccount a = _publicReader(BuiltUnwrappedAccount.class)","+                .readValue(\"\"\"","+                {\"id\":12,\"first\":\"Bob\",\"last\":\"Burger\"}\"\"\");","+        assertEquals(12, a.id);","+        assertEquals(\"Bob\", a.name.first);","+        assertEquals(\"Burger\", a.name.last);","+    }","+","+    private static ObjectMapper filterMapper(PropertyFilter filter) {","+        return jsonMapperBuilder()","+                .filterProvider(new SimpleFilterProvider().addFilter(\"idFilter\", filter))","+                .build();","+    }","+","+    private ObjectReader _publicReader(Class<?> type) {","+        return MAPPER.readerWithView(Public.class)","+                .with(DeserializationFeature.FAIL_ON_UNEXPECTED_VIEW_PROPERTIES)","+                .forType(type);","+    }","+}"],"additions":406,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/databind/ser/filter/JsonFilterTest.java","lines":["@@ -10,6 +10,8 @@"," import tools.jackson.core.TokenStreamContext;"," import tools.jackson.databind.*;"," import tools.jackson.databind.exc.InvalidDefinitionException;","+import tools.jackson.databind.jsonFormatVisitors.JsonFormatVisitorWrapper;","+import tools.jackson.databind.jsonFormatVisitors.JsonObjectFormatVisitor;"," import tools.jackson.databind.ser.FilterProvider;"," import tools.jackson.databind.ser.PropertyWriter;"," import tools.jackson.databind.ser.std.SimpleBeanPropertyFilter;","@@ -190,6 +192,28 @@ 