t}","+}","+","+func TestFolderAccessHandlerTracing(t *testing.T) {","+\tfor _, failure := range []string{\"none\", \"call\", \"result\", \"lookup\"} {","+\t\tt.Run(failure, func(t *testing.T) {","+\t\t\tctx, recorder, parent := newFolderTrace(t)","+\t\t\tctx = identity.WithRequester(ctx, &user.SignedInUser{UserID: 1, OrgID: 1})","+\t\t\tvar mu sync.Mutex","+\t\t\tvar batchContexts []trace.SpanContext","+\t\t\tclient := &subAccessMockClient{batchCheckFunc: func(ctx context.Context, _ authlib.AuthInfo, req authlib.BatchCheckRequest) (authlib.BatchCheckResponse, error) {","+\t\t\t\tmu.Lock()","+\t\t\t\tbatchContexts = append(batchContexts, trace.SpanContextFromContext(ctx))","+\t\t\t\tmu.Unlock()","+\t\t\t\tif failure == \"call\" {","+\t\t\t\t\treturn authlib.BatchCheckResponse{}, errors.New(\"authorization unavailable\")","+\t\t\t\t}","+\t\t\t\tresults := make(map[string]authlib.BatchCheckResult)","+\t\t\t\tfor _, check := range req.Checks {","+\t\t\t\t\tresult := authlib.BatchCheckResult{Allowed: true}","+\t\t\t\t\tif failure == \"result\" && check.CorrelationID == itemErrProbe {","+\t\t\t\t\t\tresult.Error = errors.New(\"probe failed\")","+\t\t\t\t\t}","+\t\t\t\t\tresults[check.CorrelationID] = result","+\t\t\t\t}","+\t\t\t\treturn authlib.BatchCheckResponse{Results: results}, nil","+\t\t\t}}","+\t\t\tvar lookupContext trace.SpanContext","+\t\t\tgetter := tracingFolderGetter{get: func(ctx context.Context, _ string) (runtime.Object, error) {","+\t\t\t\tlookupContext = trace.SpanContextFromContext(ctx)","+\t\t\t\tif failure == \"lookup\" {","+\t\t\t\t\treturn nil, errors.New(\"folder unavailable\")","+\t\t\t\t}","+\t\t\t\treturn &folderv1.Folder{}, nil","+\t\t\t}}","+\t\t\thandler := &subAccessREST{getter: getter, accessClient: client}","+\t\t\tresponder := &recordingResponder{}","+\t\t\th, err := handler.Connect(ctx, \"folder\", nil, responder)","+\t\t\trequire.NoError(t, err)","+\t\t\th.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(\"GET\", \"/folder/access\", nil))","+\t\t\touter := folderSpan(t, recorder, \"folders.subAccessREST.Connect\")","+\t\t\trequire.Equal(t, parent.SpanContext().SpanID(), outer.Parent().SpanID())","+\t\t\trequire.Equal(t, outer.SpanContext(), lookupContext)","+\t\t\tif failure == \"lookup\" {","+\t\t\t\trequire.Error(t, responder.err)","+\t\t\t\trequireFolderSpanError(t, outer)","+\t\t\t\trequire.Empty(t, batchContexts)","+\t\t\t\trequire.Len(t, recorder.Ended(), 1)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.Len(t, batchContexts, len(folderAccessProbeBatches))","+\t\t\trequire.Len(t, recorder.Ended(), len(folderAccessProbeBatches)+1)","+\t\t\tfailedBatches := 0","+\t\t\tfor _, span := range recorder.Ended() {","+\t\t\t\tif span.Name() != \"folders.subAccessREST.checkAccess.BatchCheck\" {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\trequire.Equal(t, \"github.com/grafana/grafana/pkg/registry/apis/folders\", span.InstrumentationScope().Name)","+\t\t\t\trequire.Equal(t, outer.SpanContext().SpanID(), span.Parent().SpanID())","+\t\t\t\trequire.Equal(t, parent.SpanContext().TraceID(), span.SpanContext().TraceID())","+\t\t\t\trequire.Contains(t, batchContexts, span.SpanContext())","+\t\t\t\trequire.Len(t, span.Attributes(), 3)","+\t\t\t\tif span.Status().Code == codes.Error {","+\t\t\t\t\tfailedBatches++","+\t\t\t\t\trequireFolderSpanError(t, span)","+\t\t\t\t}","+\t\t\t}","+\t\t\tif failure == \"none\" {","+\t\t\t\trequire.NoError(t, responder.err)","+\t\t\t\trequire.Zero(t, failedBatches)","+\t\t\t\trequire.Equal(t, codes.Unset, outer.Status().Code)","+\t\t\t} else {","+\t\t\t\trequire.Error(t, responder.err)","+\t\t\t\trequireFolderSpanError(t, outer)","+\t\t\t\tif failure == \"call\" {","+\t\t\t\t\trequire.Equal(t, len(folderAccessProbeBatches), failedBatches)","+\t\t\t\t} else {","+\t\t\t\t\trequire.Equal(t, 1, failedBatches)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestFolderParentsHandlerTracing(t *testing.T) {","+\tfor _, detached := range []bool{false, true} {","+\t\tt.Ru