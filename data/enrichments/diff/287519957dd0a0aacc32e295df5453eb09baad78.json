","+\t}","+}","+","+func TestFolderParentsGetterTracing(t *testing.T) {","+\tfor _, scenario := range []string{\"success\", \"detached\", \"invalid\", \"cycle\", \"general\", \"sharedwithme\"} {","+\t\tt.Run(scenario, func(t *testing.T) {","+\t\t\tctx, recorder, parent := newFolderTrace(t)","+\t\t\tvar lookupContexts []trace.SpanContext","+\t\t\tgetter := tracingFolderGetter{get: func(ctx context.Context, name string) (runtime.Object, error) {","+\t\t\t\tlookupContexts = append(lookupContexts, trace.SpanContextFromContext(ctx))","+\t\t\t\tswitch scenario {","+\t\t\t\tcase \"detached\":","+\t\t\t\t\treturn nil, errors.New(\"parent unavailable\")","+\t\t\t\tcase \"invalid\":","+\t\t\t\t\treturn &metav1.Status{}, nil","+\t\t\t\t}","+\t\t\t\tf := &folderv1.Folder{ObjectMeta: metav1.ObjectMeta{Name: name}}","+\t\t\t\tif name == \"parent\" {","+\t\t\t\t\tancestor := \"root\"","+\t\t\t\t\tif scenario == \"cycle\" {","+\t\t\t\t\t\tancestor = \"folder\"","+\t\t\t\t\t}","+\t\t\t\t\tf.Annotations = map[string]string{utils.AnnoKeyFolder: ancestor}","+\t\t\t\t}","+\t\t\t\treturn f, nil","+\t\t\t}}","+\t\t\tf := &folderv1.Folder{ObjectMeta: metav1.ObjectMeta{","+\t\t\t\tName:        \"folder\",","+\t\t\t\tAnnotations: map[string]string{utils.AnnoKeyFolder: \"parent\"},","+\t\t\t}}","+\t\t\tswitch scenario {","+\t\t\tcase \"general\":","+\t\t\t\tf.Name = folder.GeneralFolderUID","+\t\t\tcase \"sharedwithme\":","+\t\t\t\tf.Name = folder.SharedWithMeFolderUID","+\t\t\t}","+\t\t\tinfo, err := newParentsGetter(getter, 5)(ctx, f)","+\t\t\ttraversal := folderSpan(t, recorder, \"folders.getParents\")","+\t\t\trequire.Len(t, recorder.Ended(), 1)","+\t\t\trequire.Equal(t, parent.SpanContext().SpanID(), traversal.Parent().SpanID())","+\t\t\trequire.Equal(t, parent.SpanContext().TraceID(), traversal.SpanContext().TraceID())","+\t\t\tfor _, lookupContext := range lookupContexts {","+\t\t\t\trequire.Equal(t, traversal.SpanContext(), lookupContext)","+\t\t\t}","+\t\t\tswitch scenario {","+\t\t\