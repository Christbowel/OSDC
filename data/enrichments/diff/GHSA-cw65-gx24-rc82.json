nv\" / \"lib\" / \"python\"","+    if existing:","+        folder.mkdir(parents=True)","+    ensure_within(tmp_path / \"env\", folder)","+    assert folder.is_dir()","+","+","+def test_environment_directories_reject_regular_file(tmp_path: Path) -> None:","+    folder: Final = tmp_path / \"file\"","+    folder.touch()","+    with pytest.raises(NotADirectoryError, match=\"not a real directory\"):","+        ensure_within(tmp_path, folder)","+","+","+def test_environment_directories_reject_parent_components(tmp_path: Path) -> None:","+    with pytest.raises(ValueError, match=\"must remain inside\"):","+        ensure_within(tmp_path, tmp_path / \"..\" / \"folder\")","+","+","+@pytest.mark.skipif(not fs_supports_symlink(), reason=\"symlinks are unavailable\")","+@pytest.mark.parametrize(","+    \"existing\", [pytest.param(False, id=\"missing-target\"), pytest.param(True, id=\"existing-target\")]","+)","+def test_environment_directories_remove_links(tmp_path: Path, caplog: pytest.LogCaptureFixture, existing: bool) -> None:","+    target: Final = tmp_path / \"stored\"","+    if existing:","+        target.mkdir()","+    link: Final = tmp_path / \"link\"","+    link.symlink_to(target, target_is_directory=True)","+    ensure_within(tmp_path, link / \"nested\")","+    assert (","+        link.is_symlink(),","+        link.exists(),","+        target.exists(),","+        f\"replace environment directory link {link}\" in caplog.text,","+    ) == (False, True, existing, True)","+","+","+@pytest.mark.skipif(os.name != \"nt\", reason=\"Windows junctions\")","+def test_environment_directories_report_replaced_junction(tmp_path: Path, caplog: pytest.LogCaptureFixture) -> None:","+    target: Final = tmp_path / \"stored\"","+    target.mkdir()","+    link: Final = tmp_path / \"link\"","+    subprocess.run([\"cmd\", \"/c\", \"mklink\", \"/J\", str(link), str(target)], check=True, capture_output=True)","+    ensure_within(tmp_path, link)","+    assert (link.resolve(), f\"replace environment directory junction {link}\" in caplog.text) == (link, True)","+","+"," def test_run_fail(tmp_path) -> None:","     code, out, err = run_cmd([str(tmp_path)])","     assert err",""],"additions":52,"deletions":1,"truncated":false}],"additions":96,"deletions":7,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-22T13:43:59.298375+00:00"}