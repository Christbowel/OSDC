{"id":"GHSA-cw65-gx24-rc82","axis":"advisories","repo":"pypa/virtualenv","sha":"554d9f9d4f7758f5cf53f993031e29787f1f74c5","parsed":{"files":[{"path":"docs/changelog/3429.bugfix.rst","lines":["@@ -0,0 +1,3 @@","+Replace pre-existing directory symlinks and Windows junctions in the environment's executable and library paths before","+creating files. Links within those paths are replaced even when they point inside the environment. Log replaced links","+and junctions, and reject a non-directory encountered while creating their replacements."],"additions":3,"deletions":0,"truncated":false},{"path":"src/virtualenv/create/via_global_ref/builtin/via_global_self_do.py","lines":["@@ -8,7 +8,7 @@","     ExePathRefToDest,","     RefWhen,"," )","-from virtualenv.util.path import ensure_dir","+from virtualenv.util.path import ensure_within"," "," from .builtin_way import VirtualenvBuiltin"," ","@@ -91,7 +91,7 @@ def create(self) -> None:","             if any(i for i in dirs if i is not directory and directory.parts == i.parts[: len(directory.parts)]):","                 dirs.remove(directory)","         for directory in sorted(dirs):","-            ensure_dir(directory)","+            ensure_within(self.dest, directory)"," ","         self.set_pyenv_cfg()","         self.pyenv_cfg.write()"],"additions":2,"deletions":2,"truncated":false},{"path":"src/virtualenv/create/via_global_ref/venv.py","lines":["@@ -8,7 +8,7 @@"," "," from virtualenv.create.via_global_ref.store import handle_store_python"," from virtualenv.util.error import ProcessCallFailedError","-from virtualenv.util.path import ensure_dir, ensure_within","+from virtualenv.util.path import ensure_within"," from virtualenv.util.subprocess import run_cmd"," from virtualenv.util.text import collapse_line_boundaries"," ","@@ -51,7 +51,8 @@ def can_create(cls, interpreter: PythonInfo) -> ViaGlobalRefMeta | None:","     def create(self) -> None:","         # stdlib venv writes interpreter files, configuration and activation scripts in place, so a planted symlink or","         # hard link would receive them outside the environment","-        ensure_within(self.dest, self.bin_dir)","+        for directory in (self.bin_dir, self.purelib, self.platlib):","+            ensure_within(self.dest, directory)","         for path in (self.dest / \"pyvenv.cfg\", self.dest / \".gitignore\", *self.bin_dir.iterdir()):","             if path.is_symlink() or (path.is_file() and path.stat().st_nlink > 1):","                 path.unlink()","@@ -59,8 +60,6 @@ def create(self) -> None:","             self.create_inline()","         else:","             self.create_via_sub_process()","-        for lib in self.libs:  # ty: ignore[not-iterable]","-            ensure_dir(lib)","         if self.describe is not None:","             self.describe.install_venv_shared_libs(self)","         super().create()"],"additions":3,"deletions":4,"truncated":false},{"path":"tests/unit/create/test_creator.py","lines":["@@ -370,6 +370,42 @@ def test_venv_creator_accepts_plain_destination(tmp_path: Path) -> None:","     assert (session.creator.dest / \"pyvenv.cfg\").is_file()"," "," ","+@pytest.mark.parametrize(","+    \"junction\",","+    [","+        pytest.param(","+            False, id=\"symlink\", marks=pytest.mark.skipif(not fs_supports_symlink(), reason=\"symlinks are unavailable\")","+        ),","+        pytest.param(True, id=\"junction\", marks=pytest.mark.skipif(os.name != \"nt\", reason=\"Windows junctions\")),","+    ],","+)","+@pytest.mark.parametrize(","+    \"creator_name\",","+    [","+        pytest.param(\"builtin\", id=\"builtin\"),","+        pytest.param(","+            \"venv\",","+            id=\"venv\",","+            marks=pytest.mark.skipif(\"venv\" not in CURRENT_CREATORS, reason=\"stdlib venv is unavailable\"),","+        ),","+    ],","+)","+@pytest.mark.parametrize(\"folder\", [pytest.param(\"bin_dir\", id=\"executables\"), pytest.param(\"purelib\", id=\"packages\")])","+def test_creator_replaces