{"id":"cde0c7af32143139a90d57363fde8baae4b9e1a2","axis":"silent","repo":"envoyproxy/envoy","sha":"cde0c7af32143139a90d57363fde8baae4b9e1a2","parsed":{"files":[{"path":"changelogs/current/minor_behavior_changes/rds__unload-removed-ondemand-scoped-route-config.rst","lines":["@@ -0,0 +1,5 @@","+Delta RDS updates that remove a route configuration now unload it for ``on_demand`` scoped routes.","+When a scope's ``route_configuration_name`` appears in ``removed_resources``, Envoy drops the","+scope's RDS provider (unsubscribing once no other scope shares it), clears its cached route","+configuration, and resumes any requests paused on that scope so they re-resolve and start a new","+on-demand fetch. Eager scopes and non-scoped RDS subscriptions continue to ignore removals."],"additions":5,"deletions":0,"truncated":false},{"path":"source/common/rds/rds_route_config_subscription.cc","lines":["@@ -196,11 +196,32 @@ absl::Status RdsRouteConfigSubscription::onConfigUpdate(","     const std::vector<Envoy::Config::DecodedResourceRef>& added_resources,","     const Protobuf::RepeatedPtrField<std::string>& removed_resources, const std::string&) {","   if (!removed_resources.empty()) {","-    // TODO(#2500) when on-demand resource loading is supported, an RDS removal may make sense","-    // (see discussion in #6879), and so we should do something other than ignoring here.","-    ENVOY_LOG(trace,","-              \"Server sent a delta {} update attempting to remove a resource (name: {}). Ignoring.\",","-              rds_type_, removed_resources[0]);","+    // A removal never unpublishes the configuration a provider holds: a","+    // listener cannot run without a route table (see #6879). It is reported to","+    // the owners that registered for it, which lets a route table that was","+    // fetched on demand (an on-demand scoped-RDS scope) be dropped and fetched","+    // again when next needed; owners without such a callback keep the","+    // configuration as before.","+    bool removes_this = false;","+    for (const std::string& name : removed_resources) {","+      if (name == route_config_name_) {","+        removes_this = true;","+        break;","+      }","+    }","+    if (removes_this) {","+      ENVOY_LOG(debug, \"Server sent a delta {} update removing route config '{}'\", rds_type_,","+                route_config_name_);","+      if (const absl::Status status = removal_callback_manager_.runCallbacks(); !status.ok()) {","+        ENVOY_LOG(warn, \"rds: removal callback failed for route config '{}': {}\",","+                  route_config_name_, status.message());","+      }","+    } else {","+      ENVOY_LOG(trace,","+                \"Server sent a delta {} update attempting to remove a resource \"","+                \"(name: {}). Ignoring.\",","+                rds_type_, removed_resources[0]);","+    }","   }","   if (!added_resources.empty()) {","     return onConfigUpdate(added_resources, added_resources[0].get().version());"],"additions":26,"deletions":5,"truncated":false},{"path":"source/common/rds/rds_route_config_subscription.h","lines":["@@ -11,6 +11,7 @@"," #include \"envoy/server/factory_context.h\""," #include \"envoy/stats/scope.h\""," ","+#include \"source/common/common/callback_impl.h\""," #include \"source/common/grpc/common.h\""," #include \"source/common/init/manager_impl.h\""," #include \"source/common/init/target_impl.h\"","@@ -60,6 +61,20 @@ class RdsRouteConfigSubscription : Envoy::Config::SubscriptionCallbacks,"," ","   const Init::Target& initTarget() { return parent_init_target_; }"," ","+  /**","+   * Registers a callback for a delta xDS update that removes this","+   * subscription's RouteConfiguration. Nothing is published on removal: the","+   * configuration a provider already holds stays in place, since a listener","+   * cannot run without a route table. The callback lets an owner that can live","+   * without one, such as a scoped-RDS scope whose route table was fetched on","+   * demand, drop the provider and fetch the configuration again when it is next","+   * needed. Without a callback a removal is ignored, as before.","+   */","+  ABSL_MUST_USE_RESULT Envoy::Common::CallbackHandlePtr","+  addRemovalCallback(std::function<absl::Status()> callback) {","+    return removal_callback_manager_.add(callback);","+  }","+"," protected:","   RdsRouteConfigSubscription(RouteConfigUpdatePtr&& config_update,","                              Envoy::Config::OpaqueResourceDecoderSharedPtr&& resource_decoder,","@@ -122,6 +137,7 @@ class RdsRouteConfigSubscription : Envoy::Config::SubscriptionCallbacks,","   RouteConfigProvider* route_config_provider_{nullptr};","   RouteConfigUpdatePtr config_update_info_;","   Envoy::Config::OpaqueResourceDecoderSharedPtr resource_decoder_;","+  Envoy::Common::CallbackManager<absl::Status> removal_callback_manager_;"," };"," "," using RdsRouteConfigSubscriptionSharedPtr = std::shared_ptr<RdsRouteConfigSubscription>;"],"additions":16,"deletions":0,"truncated":false},{"path":"source/common/router/BUILD","lines":["@@ -358,6 +358,7 @@ envoy_cc_library(","         \"//source/common/config:resource_type_helper_lib\",","         \"//source/common/config:well_known_names\",","         \"//source/common/config:xds_resource_lib\",","+        \"//source/common/event:deferred_task\",","         \"//source/common/init:manager_lib\",","         \"//source/common/init:watcher_lib\",","         \"//source/common/protobuf:utility_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/router/scoped_rds.cc","lines":["@@ -20,6 +20,7 @@"," #include \"source/common/config/resource_name.h\""," #include \"source/common/config/well_known_names.h\""," #include \"source/common/config/xds_resource.h\"","+#include \"source/common/event/deferred_task.h\""," #include \"source/common/init/manager_impl.h\""," #include \"source/common/init/watcher_impl.h\""," #include \"source/common/protobuf/utility.h\"","@@ -254,9 +255,44 @@ void ScopedRdsConfigSubscription::RdsRouteConfigProviderHelper::initRdsConfigPro","     parent_.onRdsConfigUpdate(scope_name_, route_provider_->configCast());","     return absl::OkStatus();","   });","+  if (on_demand_) {","+    rds_removal_callback_handle_ = route_provider_->subscription().addRemovalCallback([this]() {","+      onRouteConfigRemoved();","+      return absl::OkStatus();","+    });","+  }","   parent_.stats_.active_scopes_.inc();"," }"," ","+void ScopedRdsConfigSubscription::RdsRouteConfigProviderHelper::onRouteConfigRemoved() {","+  if (!on_demand_ || route_provider_ == nullptr) {","+    return;","+  }","+  ENVOY_LOG(debug, \"Scope {}: on-demand route configuration removed, unloading\", scope_name_);","+  // Requests paused on the scope are not stranded: they resume, re-resolve the","+  // scope and start a new on-demand fetch.","+  std::vector<std::function<void()>> pending;","+  pending.swap(on_demand_update_callbacks_);","+  // Drop the callback handles before the provider: they are owned by the","+  // provider's subscription.","+  rds_update_callback_handle_.reset();","+  rds_removal_callback_handle_.reset();","+  // The provider is the subscription's only owner and this runs from the","+  // subscription's own update, so the provider is released once the update","+  // has returned. The subscription goes away with the last provider","+  // referencing it, i.e. Envoy unsubscribes from the route configuration","+  // unless another scope still uses it.","+  Event::DeferredTaskUtil::deferredRun(","+      parent_.factory_context_.mainThreadDispatcher(),","+      [provider = std::move(route_provider_)]() mutable { provider.reset(); });","+  route_provider_.reset();","+  parent_.stats_.active_scopes_.dec();","+  parent_.onRdsConfigUpdate(scope_name_, nullptr);","+  for (auto& callback : pending) {","+    callback();","+  }","+}","+"," void ScopedRdsConfigSubscription::RdsRouteConfigProviderHelper::maybeInitRdsConfigProvider() {","   // If the route provider have been initialized, return and wait for rds config update.","   if (route_provider_ != nullptr) {"],"additions":36,"deletions":0,"truncated":false},{"path":"source/common/router/scoped_rds.h","lines":["@@ -165,6 +165,13 @@ class ScopedRdsConfigSubscription : public Envoy::Config::DeltaConfigSubscriptio","     // If route provider has not been initialized, initialize it.","     void maybeInitRdsConfigProvider();"," ","+    // Returns an on-demand scope whose route configuration the server removed","+    // to the state it had before the first request: the RDS provider (and with","+    // it the subscription, once no other scope shares it) is dropped and the","+    // scope's route configuration is cleared, so that the next matching request","+    // fetches it again. A no-op for eager scopes.","+    void onRouteConfigRemoved();","+","     // Initialize route provider and register for rds update.","     void initRdsConfigProvider(","         envoy::extensions::filters::network::http_connection_manager::v3::Rds& rds,","@@ -177,6 +184,7 @@ class ScopedRdsConfigSubscription : public Envoy::Config::DeltaConfigSubscriptio","     // This handle_ is owned by the route config provider's RDS subscription, when the helper","     // destructs, the handle is deleted as well.","     Common::CallbackHandlePtr rds_update_callback_handle_;","+    Common::CallbackHandlePtr rds_removal_callback_handle_;","     std::vector<std::function<void()>> on_demand_update_callbacks_;","   };"," "],"additions":8,"deletions":0,"truncated":false},{"path":"test/common/router/scoped_rds_test.cc","lines":["@@ -2435,6 +2435,139 @@ on_demand: true","   EXPECT_EQ(1UL, on_demand_scopes_.value());"," }"," ","+// A delta RDS removal of a route table fetched on demand unloads it: the scope","+// goes back to its never-fetched state, Envoy unsubscribes from the table, and","+// the next matching request fetches it again. An eager scope keeps its table,","+// as before.","+TEST_F(ScopedRdsTest, OnDemandRouteConfigRemovalUnloadsScope) {","+  setup();","+  init_watcher_.expectReady();","+  context_init_manager_.initialize(init_watcher_);","+  const std::string eager_resource = R\"EOF(","+name: foo_scope","+route_configuration_name: foo_routes","+key:","+  fragments:","+    - string_key: x-foo-key","+)EOF\";","+  const std::string lazy_resource = R\"EOF(","+name: bar_scope","+route_configuration_name: bar_routes","+on_demand: true","+key:","+  fragments:","+    - string_key: x-bar-key","+)EOF\";","+  srdsUpdateWithYaml({eager_resource, lazy_resource}, \"1\");","+  EXPECT_EQ(1UL, active_scopes_.value());","+  EXPECT_EQ(1UL, on_demand_scopes_.value());","+","+  // The on-demand scope is requested and its table fetched.","+  {","+    ScopeKeyPtr scope_key = scope_key_builder_->computeScopeKey(","+        TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-bar-key\"}});","+    getScopedRdsProvider()->onDemandRdsUpdate(std::move(scope_key), event_dispatcher_, [](bool) {});","+  }","+  EXPECT_CALL(event_dispatcher_, post(_));","+  pushRdsConfig({\"foo_routes\", \"bar_routes\"}, \"111\");","+  EXPECT_EQ(2UL, active_scopes_.value());","+  EXPECT_EQ(getScopedRdsProvider()","+                ->config<ScopedConfigImpl>()","+                ->getRouteConfig(scope_key_builder_->computeScopeKey(","+                    TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-bar-key\"}}))","+                ->name(),","+            \"bar_routes\");","+","+  // The server removes bar_routes: the on-demand scope drops its table and","+  // provider.","+  Protobuf::RepeatedPtrField<std::string> removed;","+  *removed.Add() = \"bar_routes\";","+  ASSERT_TRUE(rds_subscription_by_name_.contains(\"bar_routes\"));","+  EXPECT_OK(rds_subscription_by_name_[\"bar_routes\"]->onConfigUpdate({}, removed, \"112\"));","+  // The provider is released once the update that removed its table has","+  // returned (end of the event-loop iteration).","+  server_factory_context_.dispatcher_.clearDeferredDeleteList();","+  EXPECT_EQ(1UL, active_scopes_.value());","+  EXPECT_EQ(1UL, on_demand_scopes_.value());","+  EXPECT_THAT(getScopedRdsProvider()->config<ScopedConfigImpl>()->getRouteConfig(","+                  scope_key_builder_->computeScopeKey(","+                      TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-bar-key\"}})),","+              IsNull());","+","+  // Removing the eager scope's table is ignored, as before.","+  Protobuf::RepeatedPtrField<std::string> removed_eager;","+  *removed_eager.Add() = \"foo_routes\";","+  EXPECT_OK(rds_subscription_by_name_[\"foo_routes\"]->onConfigUpdate({}, removed_eager, \"113\"));","+  EXPECT_EQ(1UL, active_scopes_.value());","+  EXPECT_EQ(getScopedRdsProvider()","+                ->config<ScopedConfigImpl>()","+                ->getRouteConfig(scope_key_builder_->computeScopeKey(","+                    TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-foo-key\"}}))","+                ->name(),","+            \"foo_routes\");","+","+  // The next request on the on-demand scope pauses and starts a new fetch,","+  // which the next push satisfies.","+  bool resumed = false;","+  {","+    ScopeKeyPtr scope_key = scope_key_builder_->computeScopeKey(","+        TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-bar-key\"}});","+    getScopedRdsProvider()->onDemandRdsUpdate(","+        std::move(scope_key), event_dispatcher_,","+        [&resumed](bool scope_exist) { resumed = scope_exist; });","+  }","+  EXPECT_FALSE(resumed);","+  EXPECT_CALL(event_dispatcher_, post(_)).WillOnce([](Event::PostCb cb) { cb(); });","+  pushRdsConfig({\"bar_routes\"}, \"114\");","+  EXPECT_TRUE(resumed);","+  EXPECT_EQ(2UL, active_scopes_.value());","+  EXPECT_EQ(getScopedRdsProvider()","+                ->config<ScopedConfigImpl>()","+                ->getRouteConfig(scope_key_builder_->computeScopeKey(","+                    TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-bar-key\"}}))","+                ->name(),","+            \"bar_routes\");","+}","+","+// A removal that arrives while requests are still paused on the on-demand","+// scope (its table was requested but never delivered) resumes them; they","+// re-resolve the scope like a fresh request.","+TEST_F(ScopedRdsTest, OnDemandRouteConfigRemovalResumesPausedRequests) {","+  setup();","+  init_watcher_.expectReady();","+  context_init_manager_.initialize(init_watcher_);","+  const std::string lazy_resource = R\"EOF(","+name: foo_scope","+route_configuration_name: foo_routes","+on_demand: true","+key:","+  fragments:","+    - string_key: x-foo-key","+)EOF\";","+  srdsUpdateWithYaml({lazy_resource}, \"1\");","+","+  bool resumed = false;","+  {","+    ScopeKeyPtr scope_key = scope_key_builder_->computeScopeKey(","+        TestRequestHeaderMapImpl{{\"Addr\", \"x-foo-key;x-foo-key\"}});","+    getScopedRdsProvider()->onDemandRdsUpdate(","+        std::move(scope_key), event_dispatcher_,","+        [&resumed](bool scope_exist) { resumed = scope_exist; });","+  }","+  EXPECT_EQ(1UL, active_scopes_.value());","+  EXPECT_FALSE(resumed);","+","+  Protobuf::RepeatedPtrField<std::string> removed;","+  *removed.Add() = \"foo_routes\";","+  ASSERT_TRUE(rds_subscription_by_name_.contains(\"foo_routes\"));","+  EXPECT_CALL(event_dispatcher_, post(_)).WillOnce([](Event::PostCb cb) { cb(); });","+  EXPECT_OK(rds_subscription_by_name_[\"foo_routes\"]->onConfigUpdate({}, removed, \"2\"));","+  server_factory_context_.dispatcher_.clearDeferredDeleteList();","+  EXPECT_TRUE(resumed);","+  EXPECT_EQ(0UL, active_scopes_.value());","+  EXPECT_EQ(1UL, on_demand_scopes_.value());","+}","+"," TEST_F(ScopedRdsTest, DanglingSubscriptionOnDemandUpdate) {","   setup();","   std::function<void(bool)> route_config_updated_cb = [](bool) {};",""],"additions":133,"deletions":0,"truncated":false}],"additions":225,"deletions":5,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-26T18:56:13.842606+00:00"}