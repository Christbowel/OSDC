{"id":"50b0582042622660b39dca8914c3238c56c233b2","axis":"silent","repo":"Maplibre/maplibre-gl-js","sha":"50b0582042622660b39dca8914c3238c56c233b2","parsed":{"files":[{"path":"docs/index.md","lines":["@@ -236,6 +236,22 @@ img-src data: blob: 'self' ;"," "," A page with an opaque origin, like one opened from a file or in a sandboxed iframe, downloads the worker and starts it from a `data:` URL, so it also needs `data:` in `worker-src` and the worker's host in `connect-src`, or `blob:` when `setWorkerUrl` is given a `blob:` URL."," ","+On a page that enforces [Trusted Types](https://developer.mozilla.org/en-US/docs/Web/API/Trusted_Types_API) with `require-trusted-types-for 'script'`, pass a policy of yours to `setTrustedTypesPolicy` before creating a map:","+","+```js","+maplibregl.setTrustedTypesPolicy(trustedTypes.createPolicy('my-map', {","+    createHTML: (html) => html,","+    createScriptURL: (url) => {","+        if (!new URL(url, location.href).href.startsWith(`${location.origin}/`)) throw new TypeError(`Blocked script URL ${url}`);","+        return url;","+    }","+}));","+```","+","+`createScriptURL` receives the URL the workers start from. For a worker on another origin that is a `blob:` URL, which this example refuses. `createHTML` receives the attribution of each source, which is sanitized after it is parsed. `Popup.setHTML` assigns its argument as is, so it takes a `TrustedHTML` from your policy.","+","+A worker enforces Trusted Types as well when it starts from a `blob:` URL or when its file is served with the same CSP. A script loaded into such a worker with `importScriptInWorkers` or the deprecated `setRTLTextPlugin` has to be an ES module. Right-to-left text is drawn without a plugin.","+"," ## MapLibre CSS"," "," The CSS referenced in the Quickstart is used to style DOM elements created by MapLibre code. Without the CSS, elements like Popups and Markers won't work."],"additions":16,"deletions":0,"truncated":false},{"path":"src/index.ts","lines":["@@ -17,6 +17,7 @@ import Point from '@mapbox/point-geometry';"," import {MercatorCoordinate} from './geo/mercator_coordinate.ts';"," import {Evented, ErrorEvent, Event, type ErrorEventType, type EventedParentData, type EventTypeMap, type Listener} from './util/evented.ts';"," import {type AddProtocolAction, type AddProtocolResponseData, config} from './util/config.ts';","+import {setTrustedTypesPolicy, type TrustedTypesPolicy} from './util/trusted_types.ts';"," import {rtlMainThreadPluginFactory} from './source/rtl_text_plugin_main_thread.ts';"," import {now, setNow, restoreNow, isTimeFrozen} from './util/time_control.ts';"," import {WorkerPool} from './util/worker_pool.ts';","@@ -425,6 +426,7 @@ export {","     type DashEntry,","     type Painter,","     type WorkerGlobalScopeInterface,","+    type TrustedTypesPolicy,","     setRTLTextPlugin,","     getRTLTextPluginStatus,","     prewarm,","@@ -436,6 +438,7 @@ export {","     setMaxParallelImageRequests,","     getWorkerUrl,","     setWorkerUrl,","+    setTrustedTypesPolicy,","     addProtocol,","     removeProtocol,","     addProjection,"],"additions":3,"deletions":0,"truncated":false},{"path":"src/util/dom.test.ts","lines":["@@ -1,5 +1,6 @@","-import {afterEach, describe, expect, test} from 'vitest';","+import {afterEach, describe, expect, test, vi} from 'vitest';"," import {DOM} from './dom.ts';","+import {setTrustedTypesPolicy} from './trusted_types.ts';"," "," function sanitizeToHTML(input: string): string {","     const container = document.createElement('div');","@@ -32,6 +33,7 @@ describe('DOM', () => {","         afterEach(() => {","             for (const property of clobberedProperties) delete HTMLFormElement.prototype[property];","             clobberedProperties.length = 0;","+            setTrustedTypesPolicy(undefined);","         });"," ","         test('should not fail on empty string', () => {","@@ -196,6 +198,16 @@ describe('DOM', () => {","             expect(output).toBe('<img>');","         });"," ","+        test('should parse the HTML the Trusted Types policy returns', () => {","+            const createHTML = vi.fn().mockReturnValue('<b>from the policy</b>');","+            setTrustedTypesPolicy({createHTML, createScriptURL: vi.fn()});","+","+            const output = sanitizeToHTML('<i>attribution</i>');","+","+            expect(createHTML).toHaveBeenCalledWith('<i>attribution</i>');","+            expect(output).toBe('<b>from the policy</b>');","+        });","+","         test('should remove a form whose named control shadows remove', () => {","             clobberFormProperty('remove');","             const input = '<form onclick=\"alert(1)\"><input name=\"remove\"></form>';"],"additions":13,"deletions":1,"truncated":false},{"path":"src/util/dom.ts","lines":["@@ -1,4 +1,5 @@"," import Point from '@mapbox/point-geometry';","+import {createTrustedHTML} from './trusted_types.ts';"," "," type ScaleReturnValue = {","     x: number;","@@ -153,7 +154,7 @@ export class DOM {","      */","     public static sanitize(str: string): DocumentFragment {","         const parser = new DOMParser();","-        const doc = parser.parseFromString(str, 'text/html');","+        const doc = parser.parseFromString(createTrustedHTML(str), 'text/html');","         const body = doc.body;"," ","         const {querySelectorAll, remove} = getElementInternals();"],"additions":2,"deletions":1,"truncated":false},{"path":"src/util/trusted_types.ts","lines":["@@ -0,0 +1,42 @@","+/**","+ * The methods of a [`TrustedTypePolicy`](https://developer.mozilla.org/en-US/docs/Web/API/TrustedTypePolicy) that the library calls.","+ */","+export type TrustedTypesPolicy = {","+    /** Receives the attribution of a source, which is sanitized after it is parsed. */","+    createHTML: (input: string) => unknown;","+    /** Receives the URL the workers start from, which is a `blob:` URL when the worker is on another origin. */","+    createScriptURL: (input: string) => unknown;","+};","+","+let trustedTypesPolicy: TrustedTypesPolicy | undefined;","+","+/**","+ * Sets the policy the library creates its trusted values with, for a page that enforces","+ * [Trusted Types](https://developer.mozilla.org/en-US/docs/Web/API/Trusted_Types_API).","+ * Call it before creating a map.","+ *","+ * @param policy - A policy from `trustedTypes.createPolicy`, or `undefined` to remove it.","+ * @example","+ * ```ts","+ * setTrustedTypesPolicy(trustedTypes.createPolicy('my-map', {","+ *     createHTML: (html) => html,","+ *     createScriptURL: (url) => {","+ *         if (!new URL(url, location.href).href.startsWith(`${location.origin}/`)) throw new TypeError(`Blocked script URL ${url}`);","+ *         return url;","+ *     }","+ * }));","+ * ```","+ */","+export function setTrustedTypesPolicy(policy: TrustedTypesPolicy | undefined): void {","+    trustedTypesPolicy = policy;","+}","+","+/** Returns the `TrustedHTML` the policy creates for `html`, typed as the string TypeScript's DOM types ask for. */","+export function createTrustedHTML(html: string): string {","+    return trustedTypesPolicy ? trustedTypesPolicy.createHTML(html) as string : html;","+}","+","+/** Returns the `TrustedScriptURL` the policy creates for `url`, typed as the string TypeScript's DOM types ask for. */","+export function createTrustedScriptURL(url: string): string {","+    return trustedTypesPolicy ? trustedTypesPolicy.createScriptURL(url) as string : url;","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"src/util/web_worker.test.ts","lines":["@@ -1,6 +1,7 @@"," import {describe, test, expect, beforeEach, afterEach, vi} from 'vitest';"," import {workerFactory} from './web_worker.ts';"," import {config} from './config.ts';","+import {setTrustedTypesPolicy} from './trusted_types.ts';"," "," describe('workerFactory', () => {","     const originalWorker = (globalThis as any).Worker;","@@ -13,6 +14,7 @@ describe('workerFactory', () => {","     afterEach(() => {","         (globalThis as any).Worker = originalWorker;","         config.WORKER_URL = originalWorkerUrl;","+        setTrustedTypesPolicy(undefined);","         vi.restoreAllMocks();","         vi.unstubAllGlobals();","     });","@@ -164,6 +166,20 @@ describe('workerFactory', () => {","         expect(WorkerSpy).toHaveBeenCalledWith('data:text/javascript;charset=utf-8,self.worker%20%3D%201', {type: 'module'});","     });"," ","+    test('creates the worker from the script URL the Trusted Types policy returns', async () => {","+        const WorkerSpy = vi.fn();","+        (globalThis as any).Worker = WorkerSpy;","+        config.WORKER_URL = '/path/to/worker.mjs';","+        const trustedScriptURL = {};","+        const createScriptURL = vi.fn().mockReturnValue(trustedScriptURL);","+        setTrustedTypesPolicy({createHTML: vi.fn(), createScriptURL});","+","+        await workerFactory();","+","+        expect(createScriptURL).toHaveBeenCalledWith('/path/to/worker.mjs');","+        expect(WorkerSpy.mock.calls[0][0]).toBe(trustedScriptURL);","+    });","+","     test('cross-origin fetch failure rejects the promise', async () => {","         vi.spyOn(globalThis, 'fetch').mockResolvedValue({ok: false, status: 404} as any);","         config.WORKER_URL = 'https://unpkg.com/maplibre-gl/dist/maplibre-gl-worker.cjs';"],"additions":16,"deletions":0,"truncated":false},{"path":"src/util/web_worker.ts","lines":["@@ -1,5 +1,6 @@"," import packageJSON from '../../package.json' with {type: 'json'};"," import {type AddProtocolAction, config} from './config.ts';","+import {createTrustedScriptURL} from './trusted_types.ts';"," "," import type {default as MaplibreWorker} from '../source/worker.ts';"," import type {WorkerSourceConstructor} from '../source/worker_source.ts';","@@ -51,14 +52,15 @@ function isClassicWorkerUrl(url: string): boolean {"," }"," "," function createWorker(url: string, asModule: boolean): Worker {","+    const scriptURL = createTrustedScriptURL(url);","     if (asModule) {","         try {","-            return new Worker(url, {type: 'module'});","+            return new Worker(scriptURL, {type: 'module'});","         } catch (e) {","             console.warn('Module worker not supported, falling back to classic worker', e);","         }","     }","-    return new Worker(url);","+    return new Worker(scriptURL);"," }"," "," async function fetchWorkerCode(url: string): Promise<string> {"],"additions":4,"deletions":2,"truncated":false},{"path":"test/integration/browser/browser.test.ts","lines":["@@ -449,6 +449,16 @@ describe('Browser tests', () => {"," ","     }, 5000);"," ","+    test('Map loads on a page that enforces Trusted Types', {timeout: 20000}, async () => {","+        const port = (server.address() as AddressInfo).port;","+        await page.goto(`http://localhost:${port}/test/integration/browser/fixtures/trusted-types.html`, {waitUntil: 'domcontentloaded'});","+        await page.waitForFunction(() => map.loaded());","+","+        const attribution = await page.evaluate(() => map.getContainer().querySelector('.maplibregl-ctrl-attrib-inner').textContent);","+","+        expect(attribution).toBe('Land | MapLibre');","+    });","+","     test('Movement with transformCameraUpdate and terrain', {retry: 3, timeout: 20000}, async () => {","         await page.evaluate(async () => {","             map.setPitch(52)"],"additions":10,"deletions":0,"truncated":false},{"path":"test/integration/browser/fixtures/trusted-types.html","lines":["@@ -0,0 +1,56 @@","+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+    <title>MapLibre GL JS Trusted Types page</title>","+    <meta charset='utf-8'>","+    <meta http-equiv=\"Content-Security-Policy\" content=\"require-trusted-types-for 'script'; trusted-types app\">","+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","+    <link rel=\"icon\" href=\"about:blank\">","+    <link rel='stylesheet' href='../../../../dist/maplibre-gl.css' />","+    <style>","+        body { margin: 0; padding: 0; }","+        html, body, #map { height: 100%; }","+    </style>","+</head>","+","+<body>","+<div id='map'></div>","+","+<script type='module'>","+import * as maplibregl from '../../../../dist/maplibre-gl-dev.mjs';","+","+maplibregl.setWorkerUrl('../../../../dist/maplibre-gl-worker-dev.mjs');","+maplibregl.setTrustedTypesPolicy(trustedTypes.createPolicy('app', {","+    createHTML: (html) => html,","+    createScriptURL: (url) => url","+}));","+","+window.map = new maplibregl.Map({","+    container: 'map',","+    zoom: 1,","+    center: [0, 0],","+    style: {","+        version: 8,","+        sources: {","+            land: {","+                type: 'geojson',","+                data: `${location.origin}/test/integration/browser/fixtures/land.json`,","+                attribution: '<a href=\"https://example.com\">Land</a>'","+            }","+        },","+        layers: [","+            {","+                id: 'land',","+                type: 'fill',","+                source: 'land',","+                paint: {","+                    'fill-color': '#f0e9e1'","+                }","+            }","+        ]","+    }","+});","+</script>","+","+</body>","+</html>",""],"additions":56,"deletions":0,"truncated":false}],"additions":162,"deletions":4,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-16T17:23:00.158991+00:00"}