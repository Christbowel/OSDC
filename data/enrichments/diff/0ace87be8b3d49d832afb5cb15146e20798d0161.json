{"id":"0ace87be8b3d49d832afb5cb15146e20798d0161","axis":"silent","repo":"open-telemetry/opentelemetry-go","sha":"0ace87be8b3d49d832afb5cb15146e20798d0161","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -86,6 +86,7 @@ See our [versioning policy](VERSIONING.md) for more information about these stab","   `go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc` now interprets its argument","   case-insensitively as well, where a differently-cased value previously reported an unknown","   compressor and fell back to no compression. (#9230)","+- Record diagnostics via the internal logger for recovered retryable export failures in `go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc`, `go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp`, `go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc`, `go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetrichttp`, `go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc`, and `go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp`. (#9281)"," - Prevent underflowed measurements from updating sum, min, or max in exponential histograms in `go.opentelemetry.io/otel/sdk/metric`. (#8077)"," - Report the module's registered version from `Version()` in `go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc`, which also corrects the exporter version sent in the default User-Agent. (#9232)"," - Preserve caller-provided metric data when removing timestamps from output in `go.opentelemetry.io/otel/exporters/stdout/stdoutmetric`. (#8843)"],"additions":1,"deletions":0,"truncated":false},{"path":"exporters/otlp/otlplog/otlploggrpc/client_test.go","lines":["@@ -8,10 +8,13 @@ import ("," \t\"crypto/tls\""," \t\"errors\""," \t\"net\"","+\t\"strings\""," \t\"sync\"","+\t\"sync/atomic\""," \t\"testing\""," \t\"time\""," ","+\t\"github.com/go-logr/logr/funcr\""," \t\"github.com/google/go-cmp/cmp\""," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\"","@@ -33,6 +36,7 @@ import ("," \t\"go.opentelemetry.io/otel/attribute\""," \t\"go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc/internal\""," \t\"go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc/internal/observ\"","+\t\"go.opentelemetry.io/otel/internal/global\""," \t\"go.opentelemetry.io/otel/sdk/instrumentation\""," \t\"go.opentelemetry.io/otel/sdk/log\""," \t\"go.opentelemetry.io/otel/sdk/metric\"","@@ -1381,3 +1385,87 @@ func TestNextExporterIDConcurrentSafe(t *testing.T) {"," \t\tt.Errorf(\"nextExporterID() = %d; want %d\", id, expected)"," \t}"," }","+","+func TestRecoveredRetryDiagnostics(t *testing.T) {","+\tvar (","+\t\tlogMu  sync.Mutex","+\t\tlogged []string","+\t)","+\tlogger := funcr.New(func(prefix, args string) {","+\t\tlogMu.Lock()","+\t\tdefer logMu.Unlock()","+\t\tlogged = append(logged, prefix+\" \"+args)","+\t}, funcr.Options{Verbosity: 10})","+","+\torigLogger := global.GetLogger()","+\tglobal.SetLogger(logger)","+\tt.Cleanup(func() { global.SetLogger(origLogger) })","+","+\tvar ehCalls atomic.Int64","+\torigHandler := otel.GetErrorHandler()","+\totel.SetErrorHandler(otel.ErrorHandlerFunc(func(error) {","+\t\tehCalls.Add(1)","+\t}))","+\tt.Cleanup(func() { otel.SetErrorHandler(origHandler) })","+","+\tt.Run(\"RecoveredRetryableErrorLogsDiagnosticsAndBypassesErrorHandler\", func(t *testing.T) {","+\t\tlogMu.Lock()","+\t\tlogged = nil","+\t\tlogMu.Unlock()","+\t\tehCalls.Store(0)","+","+\t\trCh := make(chan exportResult, 2)","+\t\trCh <- exportResult{","+\t\t\tErr: status.Error(codes.Unavailable, \"transient-recovered-failure\"),","+\t\t}","+\t\trCh <- exportResult{","+\t\t\tResponse: &collogpb.ExportLogsServiceResponse{},","+\t\t}","+","+\t\tclient, coll := clientFactory(t, rCh)","+\t\tt.Cleanup(coll.srv.Stop)","+\t\tctx := context.Background() //nolint:usetesting // required to avoid getting a canceled context at cleanup.","+\t\tt.Cleanup(func() { assert.NoError(t, client.Shutdown(ctx)) })","+","+\t\terr := client.UploadLogs(t.Context(), resourceLogs)","+\t\tassert.NoError(t, err)","+","+\t\tassert.Equal(t, int64(0), ehCalls.Load(), \"otel.ErrorHandler must not be called on recovered retryable error\")","+","+\t\tlogMu.Lock()","+\t\tlogs := strings.Join(logged, \"\\n\")","+\t\tlogMu.Unlock()","+","+\t\tassert.Contains(t, logs, \"retryable error\")","+\t\tassert.Contains(t, logs, \"transient-recovered-failure\")","+\t})","+","+\tt.Run(\"UnrecoveredErrorReturnsErrorWithoutCallingErrorHandler\", func(t *testing.T) {","+\t\tlogMu.Lock()","+\t\tlogged = nil","+\t\tlogMu.Unlock()","+\t\tehCalls.Store(0)","+","+\t\trCh := make(chan exportResult, 1)","+\t\trCh <- exportResult{","+\t\t\tErr: status.Error(codes.InvalidArgument, \"irremediable-bad-request\"),","+\t\t}","+","+\t\tclient, coll := clientFactory(t, rCh)","+\t\tt.Cleanup(coll.srv.Stop)","+\t\tctx := context.Background() //nolint:usetesting // required to avoid getting a canceled context at cleanup.","+\t\tt.Cleanup(func() { assert.NoError(t, client.Shutdown(ctx)) })","+","+\t\terr := client.UploadLogs(t.Context(), resourceLogs)","+\t\tassert.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"irremediable-bad-request\")","+","+\t\tassert.Equal(t, int64(0), ehCalls.Load(), \"UploadLogs returns unrecovered errors directly, not via otel.Handle\")","+","+\t\tlogMu.Lock()","+\t\tlogs := strings.Join(logged, \"\\n\")","+\t\tlogMu.Unlock()","+","+\t\tassert.NotContains(t, logs, \"retryable error\")","+\t})","+}"],"additions":88,"deletions":0,"truncated":false},{"path":"exporters/otlp/otlplog/otlploggrpc/go.mod","lines":["@@ -7,6 +7,7 @@ retract v0.12.0"," "," require ("," \tgithub.com/cenkalti/backoff/v7 v7.0.3","+\tgithub.com/go-logr/logr v1.4.4"," \tgithub.com/google/go-cmp v0.7.0"," \tgithub.com/stretchr/testify v1.12.1"," \tgo.opentelemetry.io/otel v1.47.0","@@ -25,7 +26,6 @@ require ("," "," require ("," \tgithub.com/cespare/xxhash/v2 v2.3.0 // indirect","-\tgithub.com/go-logr/logr v1.4.4 // indirect"," \tgithub.com/go-logr/stdr v