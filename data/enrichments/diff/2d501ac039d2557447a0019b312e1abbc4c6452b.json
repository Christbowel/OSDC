n"," core package, distinguishing it from packages named \"core\" from other sources."," ","+## term-graphics","+* Tracking Issue: [rust-lang/rust#165164](https://github.com/rust-lang/rust/issues/165164)","+","+The `-Z term-graphics` enables the `term.graphics` configuration option to","+control whether Cargo and `rustc` use graphical decorations and source","+snippets in their diagnostic output.","+If the `-Z term-graphics` unstable flag is not enabled, then the","+`term.term-graphics` configuration will be ignored.","+","+","+### Added to Configuration","+","+- Type: boolean","+- Default: auto-detect","+- Environment: `CARGO_TERM_GRAPHICS`","+","+Controls the use of graphical decorations and source snippets in diagnostic","+output. The output when this is `false`, was primarily designed to be usable by","+users relying on Text-To-Speech and Braille displays.","+","+"," # Stabilized and removed features"," "," ## Compile progress"],"additions":22,"deletions":0,"truncated":false},{"path":"src/compiler/mod.rs","lines":["@@ -1311,6 +1311,13 @@ fn add_error_format_and_color(build_runner: &BuildRunner<'_, '_>, cmd: &mut Proc","     {","         json.push_str(\",diagnostic-unicode\");","     }","+","+    if !build_runner.bcx.gctx.shell().graphics()","+        && build_runner.bcx.gctx.cli_unstable().term_graphics","+    {","+        json.push_str(\",diagnostic-no-graphics\");","+    }","+","     if enable_timings {","         json.push_str(\",timings\");","     }"],"additions":7,"deletions":0,"truncated":false},{"path":"src/context/mod.rs","lines":["@@ -954,6 +954,21 @@ impl GlobalContext {","         self.shell()","             .set_unstable_flags_rustc_unicode(self.unstable_flags.rustc_unicode)?;"," ","+        // Without this a user could set `NO_GRAPHICS=1` and be able to use an","+        // unstable feature without it being enabled","+        if !self.unstable_flags.term_graphics {","+            self.shell().set_graphics(true)?;","+        }","+","+        if let S