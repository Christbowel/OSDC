eplicationEnabled(false);","+    assertEquals(Boolean.FALSE, fetchReplicationEnabledStatus());","+","+    setReplicationEnabled(true);","+    assertEquals(Boolean.TRUE, fetchReplicationEnabledStatus());","+  }","+","+  @Test","+  public void testMissingEnabledIsRejectedAndStateUnchanged() throws Exception {","+    assertEquals(Boolean.TRUE, fetchReplicationEnabledStatus());","+","+    var request = new ReplicationApi.SetReplicationEnabled(CORE_NAME);","+    RemoteSolrException ex =","+        expectThrows(","+            RemoteSolrException.class,","+            () -> request.process(solrTestRule.getSolrClient(CORE_NAME)));","+    assertEquals(SolrException.ErrorCode.BAD_REQUEST.code, ex.code());","+","+    assertEquals(Boolean.TRUE, fetchReplicationEnabledStatus());","+  }","+","+  @Test","+  public void testNullEnabledIsRejectedAndStateUnchanged() throws Exception {","+    assertEquals(Boolean.TRUE, fetchReplicationEnabledStatus());","+","+    var request = new ReplicationApi.SetReplicationEnabled(CORE_NAME);","+    request.setEnabled(null);","+    RemoteSolrException ex =","+        expectThrows(","+            RemoteSolrException.class,","+            () -> request.process(solrTestRule.getSolrClient(CORE_NAME)));","+    assertEquals(SolrException.ErrorCode.BAD_REQUEST.code, ex.code());","+","+    assertEquals(Boolean.TRUE, fetchReplicationEnabledStatus());","+  }","+","+  private static void setReplicationEnabled(boolean enabled) throws Exception {","+    var request = new ReplicationApi.SetReplicationEnabled(CORE_NAME);","+    request.setEnabled(enabled);","+    var response = request.process(solrTestRule.getSolrClient(CORE_NAME));","+    assertNull(response.error);","+  }","+","+  private static Boolean fetchReplicationEnabledStatus() throws Exception {","+    var request = new ReplicationApi.FetchReplicationDetails(CORE_NAME);","+    return request.process(solrTestRule.getSolrClient(CORE_NAME)).details.leader.replicationEnabled;","+  }","+}"],"additions":96,"