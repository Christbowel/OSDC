ssModule\" */","-/** @typedef {import(\"../../serialization/ObjectMiddleware\").ObjectDeserializerContext<[CssModuleName[]]>} ObjectDeserializerContext */","-/** @typedef {import(\"../../serialization/ObjectMiddleware\").ObjectSerializerContext<[CssModuleName[]]>} ObjectSerializerContext */","+/** @import { HtmlCssModulesAttributeKind } from \"../../../declarations/WebpackOptions\" */","+/** @typedef {import(\"../../serialization/ObjectMiddleware\").ObjectDeserializerContext<[CssModuleNames | undefined, CssModuleNamesRescan | undefined]>} ObjectDeserializerContext */","+/** @typedef {import(\"../../serialization/ObjectMiddleware\").ObjectSerializerContext<[CssModuleNames | undefined, CssModuleNamesRescan | undefined]>} ObjectSerializerContext */","+","+/**","+ * The page's values naming a class or an id, three numbers each, in one flat","+ * array (a page can have thousands): the value's source span (it is read back","+ * from the page when generating, so a page keeps only offsets), then its kind","+ * (a `CSS_MODULE_NAME_*` constant), whether it is inside `<template>` content","+ * (`CSS_MODULE_NAME_IN_TEMPLATE`), and the quote it is written in shifted","+ * above both (a char code, 0 when unquoted).","+ * @typedef {number[]} CssModuleNames","+ */","+","+/**","+ * What a page that kept no offsets needs to find them again as its parse did.","+ * @typedef {object} CssModuleNamesRescan","+ * @property {number[]=} ignored start offsets of the `webpackIgnore`d elements, whose values stay as written","+ * @property {string=} fragmentContext the context element the page is parsed in, for a page that is a fragment","+ * @property {[string, number][]=} attributes the attributes `module.parser.html.cssModules.attributes` adds, with their kinds","+ */","+","+// A class list (`class`).","+const CSS_MODULE_NAME_CLASS = 0;","+// One id (`id`).","+const CSS_MODULE_NAME_ID = 1;","+// Id references, one or a list (`for`, `aria-labelledby`, `headers`, ...).","+const CSS_MODULE_NAME_