"smol\",","     \"snapshotting\",","     \"snitin\","],"additions":8,"deletions":0,"truncated":false},{"path":"declarations/WebpackOptions.ts","lines":["@@ -1974,6 +1974,13 @@ export type HotUpdateMainFilename = RelativePath;","  */"," export type HtmlChunkFilename = FilenameTemplate;"," ","+/**","+ * How an attribute's value names a class or an id: `class` a class list (like `class`), `id` one id (like `id`), `ids` a list of ids (like `aria-labelledby`), `fragment` a same-page link, `#id` (like `href`), `url` `url(#id)` references (like `fill`).","+ * @since 5.113.0","+ */","+export type HtmlCssModulesAttributeKind =","+\t\"class\" | \"id\" | \"ids\" | \"fragment\" | \"url\";","+"," /**","  * A single favicon `<link>`: either a path string (used as the icon `href`) or an object with the icon `href` plus extra link attributes (`sizes`, `media`, `color`, `type`, `crossorigin`).","  */","@@ -2028,6 +2035,19 @@ export interface HtmlGeneratorOptions {","  */"," export type HtmlParserAs = \"document\" | string;"," ","+/**","+ * How a page's CSS modules rewrite it.","+ * @since 5.113.0","+ */","+export interface HtmlParserCssModules {","+\t/**","+\t * Attributes whose values are rewritten with the page's CSS module names too, each with how its value names a class or an id, besides the built-in ones (`class`, `id`, `for`, `aria-labelledby`, `href=\"#id\"`, `fill=\"url(#id)\"`, `begin=\"id.click\"`, ...); e.g. `{ \"data-target\": \"id\" }`.","+\t */","+\tattributes?: {","+\t\t[k: string]: HtmlCssModulesAttributeKind;","+\t};","+}","+"," /**","  * Parser options for html modules.","  * @publishes plugins/HtmlParserOptions","@@ -2043,13 +2063,18 @@ export interface HtmlParserOptions {"," \t * @since 5.112.0"," \t */"," \tchunkName?: NonEmptyString | import(\"../lib/html/HtmlParser\").HtmlChunkNameFn;","+\t/**","+\t * How a page's CSS modules — `<style module>` bodies and linked stylesheets that are CSS modules — rewrite it.","+\t * @since 5.113.0","+\t */","+\tcssModules?: HtmlParserCssModules;"," \t/**"," \t * Report each HTML parse error the page holds, by its WHATWG or html5lib name: a build error where end of input cuts a tag, comment or doctype short, a build warning for one the parser reads past. Off by default."," \t * @since 5.113.0"," \t */"," \tparseErrors?: boolean;"," \t/**","-\t * Configure extraction of URL-like attribute values (e.g. `<img src>`, `<link href>`, `<script src>`) as webpack dependencies. `true` (default) uses the built-in source list; `false` disables extraction entirely so attributes are left untouched and `<script src>` / `<link rel=\"modulepreload\">` / `<link rel=\"stylesheet\">` no longer become compilation entries; an array lets you customize which `tag`/`attribute` pairs are treated as URLs and how they are bundled. Use the string `\"...\"` inside the array to inline the defaults. Inline `<script>` and `<style>` bodies are always processed; one whose `lang` names another language is a `data:` module typed as that language's files (`<style lang=\"scss\">` as `text/x-scss`, `<script lang=\"ts\">` as `text/typescript`), and any other valid media-type name as `text/x-<lang>`, so a `mimetype` rule runs its loader. A `<style module>` body is a CSS module, and the page's `class` and `id` values are rewritten with the names it and any linked CSS module stylesheet declare, one named as such (`x.module.css`) or marked `<link rel=\"stylesheet\" module>`; a page with neither is left as it is. Use `webpackIgnore` comments or `IgnorePlugin` to skip individual URLs.","+\t * Configure extraction of URL-like attribute values (e.g. `<img src>`, `<link href>`, `<script src>`) as webpack dependencies. `true` (default) uses the built-in source list; `false` disables extraction entirely so attributes are left untouched and `<script src>` / `<link rel=\"modulepreload\">` / `<link rel=\"stylesheet\">` no longer become compilation entries; an array lets you customize which `tag`/`attribute` pairs are treated as URLs and how they are bundled. Use the string `\"...\"` inside the array to inline the defaults. Inline `<script>` and `<style>` bodies are always processed; one whose `lang` names another language is a `data:` module typed as that language's files (`<style lang=\"scss\">` as `text/x-scss`, `<script lang=\"ts\">` as `text/typescript`), and any other valid media-type name as `text/x-<lang>`, so a `mimetype` rule runs its loader. A `<style module>` body is a CSS module, and the page's `class` and `id` values, the ids its `for`, `form`, `list`, `headers`, `itemref`, `popovertarget`, `commandfor`, `interestfor` and `aria-*` reference attributes name, its same-page `href=\"#id\"` links, SVG `url(#id)` references and SMIL `id.event` timings are rewritten with the names it and any linked stylesheet that is a CSS module declare (see `cssModules`); `<style module=\"card\">` or `<link rel=\"stylesheet\" module=\"card\">` names a module, read as `card.btn`; a page with neither is left as it is. Use `webpackIgnore` comments or `IgnorePlugin` to skip individual URLs."," \t */"," \tsources?:"," \t\t| /** Sources to extract as webpack dependencies. Use `\"...\"` to inline the default source list. @minItems 1 */ Array<"],"additions":26,"deletions":1,"truncated":false},{"path":"lib/config/defaults.js","lines":["@@ -1480,7 +1480,7 @@ const applyModuleDefaults = ("," \t\t\t\t// `<style module>` is the same, scoped as a CSS module: the page's"," \t\t\t\t// `class` and `id` are rewritten with its names."," \t\t\t\trules.push({","-\t\t\t\t\tdependency: \"html-style-module\",","+\t\t\t\t\tdependency: \"html-module-style\","," \t\t\t\t\ttype: CSS_MODULE_TYPE_MODULE,"," \t\t\t\t\tparser: {"," \t\t\t\t\t\texportType: \"text\""],"additions":1,"deletions":1,"truncated":false},{"path":"lib/css/CssGenerator.js","lines":["@@ -750,7 +750,7 @@ class CssGenerator extends Generator {"," \t\t\tif ("," \t\t\t\tconnection.dependency &&"," \t\t\t\t(connection.dependency.category === \"html-style\" ||","-\t\t\t\t\tconn