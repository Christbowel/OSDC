s->invscale0            = invscale0;","+    kparams->invscale1            = invscale1;","+","+    kparams->n_threads            = n_threads;","+    kparams->chunks_per_group     = chunks_per_group;","+","+    kparams->dst_nrows_per_chunk  = dst_nrows_per_chunk;","+    kparams->chunks_per_slice     = chunks_per_slice;","+    kparams->total_chunks         = total_chunks;","+    kparams->vtcm_size            = (uint32_t) layout.total_bytes;","+","+    kparams->div_chunks_per_slice = init_fastdiv_values(chunks_per_slice > 0 ? chunks_per_slice : 1);","+    kparams->div_dst_z            = init_fastdiv_values(dst_z > 0 ? dst_z : 1);","+","+    return true;","+}","+"," static bool htp_kparams_solve_concat(","     const struct ggml_hexagon_session * sess,","     const struct ggml_tensor * op,","@@ -3917,6 +4095,31 @@ void htp_opnode_collapse(const struct ggml_hexagon_session * sess, htp_opnode &","         }","         return;","     }","+","+    if (node.opcode == HTP_OP_UPSCALE) {","+        if (node.inputs.empty() || !node.inputs[0] || node.outputs.empty() || !node.outputs[0]) {","+            return;","+        }","+        const struct ggml_tensor * src0 = node.inputs[0];","+        const struct ggml_tensor * dst  = node.outputs[0];","+","+        if ((src0->ne[3] > 1 || dst->ne[3] > 1) &&","+            src0->ne[2] == dst->ne[2] && src0->ne[3] == dst->ne[3] &&","+            src0->nb[3] == (size_t) src0->ne[2] * src0->nb[2] &&","+            dst->nb[3]  == (size_t) dst->ne[2]  * dst->nb[2]) {","+            struct ggml_tensor src0_c = *src0;","+            struct ggml_tensor dst_c  = *dst;","+            src0_c.ne[2] *= src0_c.ne[3];","+            src0_c.ne[3] = 1;","+            src0_c.nb[3] = (size_t) src0_c.ne[2] * src0_c.nb[2];","+            dst_c.ne[2]  *= dst_c.ne[3];","+            dst_c.ne[3]  = 1;","+            dst_c.nb[3]  = (size_t) dst_c.ne[2] * dst_c.nb[2];","+            node.inputs[0]  = node.add_dummy(src0_c);","+            node.outputs[0] = node.add_dummy(dst_c);","+        }","+        return;","+    }"," }"," "," bool htp_kparams_solve(","@@ -3946,6 +4149,9 @@ bool htp_kparams_solve(","         const size_t src2_size = src2 ? hex_round_up(ggml_nbytes(src2), 128) : 0;","         return htp_kparams_solve_matmul_impl(sess, src0, src1, dst, src2 ? src2->nb[1] : 0, src2_size, node.kparams<htp_mm_kernel_params>());","     }","+    if (node.opcode == HTP_OP_UPSCALE) {","+        return htp_kparams_solve_upscale(sess, src0, dst, node.kparams<htp_upscale_kernel_params>());","+    }"," ","     return htp_kparams_solve(sess, node.node, node.kernel_params);"," }","@@ -3956,7 +4162,7 @@ bool htp_kparams_solve(","     void * kparams"," ) {","     const htp_op_code opcode = htp_op_remap(op);","-    if (htp_op_is_unary(opcode) || htp_op_is_glu(opcode)) {","+    if (htp_op_is_unary(opcode) || htp_op_is_glu(opcode) || opcode == HTP_OP_UPSCALE) {","         htp_opnode tmp(opcode, op);","         if (!htp_kparams_solve(sess, tmp)) {","             return false;"],"additions":207,"deletions":1,"truncated":false},{"path":"ggml/src/ggml-hexagon/htp-kparams.h","lines":["@@ -29,6 +29,7 @@"," #include \"htp/ssm-conv.h\""," #include \"htp/sum-rows-ops.h\""," #include \"htp/unary-ops.h\"","+#include \"htp/upscale-ops.h\""," "," #include <type_traits>"," #include <utility>","@@ -134,4 +135,19 @@ bool htp_kparams_solve_unary_mul_glu(","     struct htp_glu_kernel_params * kparams"," );"," ","+bool htp_kparams_solve_upscale(","+    const struct ggml_hexagon_session * sess,","+    const struct ggml_tensor * src0,","+    const struct ggml_tensor * dst,","+    struct htp_upscale_kernel_params * kparams","+);","+","+static inline bool htp_kparams_solve_upscale(","+    const struct ggml_hexagon_session * sess,","+    const struct ggml_tensor * op,","+    struct htp_upscale_kernel_params * kparams","+) {","+    return htp_kparams_solve_upscale(sess, op->src[0], op, kparams);","+}","+"," #endif // HTP_KPARAMS_H"],"additions":16,"deletions":0,"tr