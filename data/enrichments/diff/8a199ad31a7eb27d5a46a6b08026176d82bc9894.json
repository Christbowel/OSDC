* src0->nb[0]) &&","+                                   ((size_t) src_x * src_y <= 0xFFFFu);","+","+    if ((!is_src_contig_row && !is_src_strided_2d) || dst->nb[0] != sizeof(float)) {","+        return false;","+    }","+","+    const int32_t mode_flags = dst->op_params[0];","+    const uint32_t mode_raw  = (uint32_t) (mode_flags & 0xFF);","+    if (mode_raw >= GGML_SCALE_MODE_COUNT) {","+        return false;","+    }","+","+    const bool align_corners = (mode_flags & GGML_SCALE_FLAG_ALIGN_CORNERS) != 0;","+    const bool antialias     = (mode_flags & GGML_SCALE_FLAG_ANTIALIAS) != 0;","+","+    float sf0 = (float) dst_x / (float) src_x;","+    float sf1 = (float) dst_y / (float) src_y;","+    float sf2 = (float) dst_z / (float) src_z;","+    float sf3 = (float) dst_w / (float) src_w;","+    float pixel_offset = 0.5f;","+","+    if (align_corners) {","+        pixel_offset = 0.0f;","+        sf0 = (dst_x > 1 && src_x > 1) ? (float) (dst_x - 1) / (float) (src_x - 1) : sf0;","+        sf1 = (dst_y > 1 && src_y > 1) ? (float) (dst_y - 1) / (float) (src_y - 1) : sf1;","+    }","+","+    const float inv_sf0 = 1.0f / sf0;","+    const float inv_sf1 = 1.0f / sf1;","+    const float inv_sf2 = 1.0f / sf2;","+    const float inv_sf3 = 1.0f / sf3;","+","+    const float filter_radius0 = antialias ? (std::max)(1.0f, inv_sf0) : 0.0f;","+    const float filter_radius1 = antialias ? (std::max)(1.0f, inv_sf1) : 0.0f;","+    const float invscale0      = antialias ? (1.0f / filter_radius0) : 0.0f;","+    const float invscale1      = antialias ? (1.0f / filter_radius1) : 0.0f;","+","+    const uint32_t total_slices = dst_z * dst_w;","+    uint32_t       n_threads    = htp_session_n_threads(sess);","+","+    struct htp_upscale_vtcm_layout layout;","+    uint32_t dst_nrows_per_chunk = 0;","+    while (n_threads > 0) {","+        if (htp_upscale_solve_layout(&layout, src_x, src_y, dst_x, dst_y, inv_sf1, filter_radius1, n_threads,","+                                     htp_session_vtcm_size(sess), &dst_nrows_per_chunk)) {","+            break;","+        }","+        n_threads--;","+    }","+    if (n_threads == 0) {","+        return false;","+    }","+","+    size_t lut_x_size = 0;","+    size_t elem_y_sz  = sizeof(uint32_t);","+    if (mode_raw == HTP_UPSCALE_MODE_BICUBIC) {","+        lut_x_size = hex_round_up(dst_x * sizeof(struct upscale_bicubic_x), 128);","+        elem_y_sz  = sizeof(struct upscale_bicubic_y);","+    } else if (antialias) {","+        lut_x_size = hex_round_up(dst_x * sizeof(struct upscale_antialias_x), 128);","+        elem_y_sz  = sizeof(struct upscale_antialias_y);","+    } else if (mode_raw == HTP_UPSCALE_MODE_BILINEAR) {","+        const uint32_t n_chunks = (dst_x + 31) / 32;","+        lut_x_size = hex_round_up(n_chunks * sizeof(struct upscale_bilinear_x_chunk), 128);","+        elem_y_sz  = sizeof(struct upscale_bilinear_y);","+    } else {","+        lut_x_size = hex_round_up(dst_x * sizeof(uint32_t), 128);","+    }","+    const size_t total_lut_size = lut_x_size + hex_round_up(dst_y * elem_y_sz, 128);","+    if (total_lut_size > HTP_DDR_SPAD_SIZE) {","+        return false;","+    }","+","+    const uint32_t chunks_per_slice = (dst_y + dst_nrows_per_chunk - 1) / dst_nrows_per_chunk;","+    const uint32_t total_chunks     = total_slices * chunks_per_slice;","+","+    n_threads = (std::min)(n_threads, total_chunks > 0 ? total_chunks : 1);","+    htp_upscale_vtcm_layout_build(&layout, src_x, src_y, dst_x, dst_y, dst_nrows_per_chunk, inv_sf1, filter_radius1, n_threads);","+","+    const uint32_t slice_dst_bytes = dst_x * dst_y * sizeof(float);","+    const uint32_t chunk_dst_bytes = dst_x * dst_nrows_per_chunk * sizeof(float);","+    const bool     dst_contig      = (dst->nb[1] == (size_t) dst_x * sizeof(float)) &&","+                                     (dst_z <= 1 || dst->nb[2] == (size_t) dst_y * dst->nb[1]) &&","+                                     (dst_w <= 1 || dst->nb[3] == (size_t) dst_z * dst->nb[2]);","+",