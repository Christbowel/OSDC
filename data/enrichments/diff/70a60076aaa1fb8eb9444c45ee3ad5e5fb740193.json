s[0].is_negative_hits_ = true;","+  auto result = rate_limiter_->requestAllowed(descriptors);","+  EXPECT_TRUE(result.allowed);","+  EXPECT_EQ(1, result.token_bucket_context->remainingTokens());","+  descriptors[0].entries_[0].value_ = \"bob\";","+  descriptors[0].is_negative_hits_ = false;","+  descriptors[0].hits_addend_ = 1;","+  EXPECT_TRUE(rate_limiter_->requestAllowed(descriptors).allowed);","+}","+","+TEST_F(CompletedUsageTest, CompletionValuesCanEvictRequestBuckets) {","+  TestUtility::loadFromYaml(fmt::format(wildcard_descriptor_config_yaml, 5, 1, \"1000s\"),","+                            *descriptors_.Add());","+  initializeWithAtomicTokenBucketDescriptor(std::chrono::milliseconds(1000000), 100, 1, 1);","+  std::vector<RateLimit::Descriptor> alice{{{{\"user\", \"alice\"}}}};","+  const auto original_alice = rate_limiter_->requestAllowed(alice);","+  ASSERT_TRUE(original_alice.allowed);","+  EXPECT_EQ(4, original_alice.token_bucket_context->remainingTokens());","+","+  std::vector<RateLimit::Descriptor> bob{{{{\"user\", \"bob\"}}}};","+  bob[0].hits_addend_ = 2;","+  rate_limiter_->consumeDescriptors(bob);","+  // Completion creates Bob's bucket, evicting Alice from the size-one cache."],"additions":160,"deletions":0,"truncated":false}],"additions":339,"deletions":23,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-09T17:51:39.192421+00:00"}