e grid's filter bar while the gantt is showing.","+export const GANTT_DATE_FILTER_KEYS: ReadonlyArray<FilterableSearchParamsKeys> = [","+  SearchParamsKeys.START_DATE_RANGE,","+  SearchParamsKeys.END_DATE_RANGE,","+];","+","+export const GRAPH_FILTER_KEYS: ReadonlyArray<SearchParamsKeys> = [","+  SearchParamsKeys.GRAPH_OPERATOR,","+  SearchParamsKeys.GRAPH_TASK_GROUP,","+  SearchParamsKeys.GRAPH_TASK_STATE,","+  SearchParamsKeys.GRAPH_MAP_INDEX,","+  SearchParamsKeys.GRAPH_DURATION_GTE,","+];","+","+// The task stream filter has no SearchParamsKeys entries and writes these names straight to the url.","+export const TASK_STREAM_SEARCH_PARAMS = {","+  depth: \"depth\",","+  downstream: \"downstream\",","+  mode: \"mode\",","+  root: \"root\",","+  upstream: \"upstream\",","+} as const;","+","+// The log header (level and source) and the log search read and write these, so a log filter added","+// here is carried across tabs.","+export const LOG_SEARCH_PARAMS = {","+  level: SearchParamsKeys.LOG_LEVEL,","+  search: SearchParamsKeys.LOG_SEARCH,","+  source: SearchParamsKeys.SOURCE,","+} as const;","+","+// A date range filter is listed by its filter key but writes a start and an end key, so resolve","+// those through the same config the filter bar uses.","+export const usePersistentSearchParamKeys = (): ReadonlyArray<string> => {","+  const { getFilterConfig } = useFilterConfigs();","+","+  const gridKeys = [...GRID_FILTER_KEYS, ...GANTT_DATE_FILTER_KEYS].flatMap((key) => {","+    const { endKey, startKey } = getFilterConfig(key);","+","+    return startKey !== undefined && endKey !== undefined ? [startKey, endKey] : [key];","+  });","+","+  return [","+    ...gridKeys,","+    ...GRAPH_FILTER_KEYS,","+    ...Object.values(TASK_STREAM_SEARCH_PARAMS),","+    ...Object.values(LOG_SEARCH_PARAMS),","+  ];","+};","+","+/**","+ * The query for a link that leaves one place on the page for another: `targetSearch` plus every","+ * persistent key in `currentSearch`. A key the tar