{"id":"d71c542fb1d9cd1ceb310a4759591c024cf0d57d","axis":"silent","repo":"langchain-ai/langchainjs","sha":"d71c542fb1d9cd1ceb310a4759591c024cf0d57d","parsed":{"files":[{"path":".changeset/anthropic-mid-conversation-profile.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@langchain/anthropic\": patch","+---","+","+feat(anthropic): declare mid-conversation support in model profiles. Claude Opus 4.8, Opus 5, Opus 5.5, Sonnet 5.5, Haiku 5.5, Fable 5 and 5.1, and Mythos 5 and 5.1 set `midConversationSystemMessages` and `midConversationTools`. Sonnet 5 sets system messages only.","+","+Regenerating the profiles from models.dev also adds Claude Opus 5.5, Sonnet 5.5 and Haiku 5.5, removes Claude Opus 4.1, and lowers Claude Sonnet 4.5's `maxInputTokens` to 200,000."],"additions":7,"deletions":0,"truncated":false},{"path":".changeset/core-mid-conversation-profile.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@langchain/core\": patch","+---","+","+feat(core): add `midConversationSystemMessages` and `midConversationTools` to `ModelProfile`. They say whether a chat model sends a system message after the first turn in place, and whether it can add a tool through a message rather than the request's tool list. Either way the prompt prefix before it stays unchanged."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/openai-mid-conversation-profile.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@langchain/openai\": patch","+---","+","+feat(openai): declare mid-conversation support in model profiles. GPT-4.1, GPT-5.x, GPT-6.x and o3 set `midConversationSystemMessages` and `midConversationTools`. `midConversationTools` is `false` on Chat Completions, since only the Responses API carries an `additional_tools` input item, so `ChatOpenAI` reports it only when it routes to the Responses API. `AzureChatOpenAI` and `AzureChatOpenAIResponses` leave it unset, since it is unverified on Azure's API.","+","+Regenerating the profiles from models.dev also adds GPT-6 Sol, GPT-6 Luna and GPT-6.1 Sol."],"additions":7,"deletions":0,"truncated":false},{"path":"internal/model-profiles/src/config.ts","lines":["@@ -29,6 +29,8 @@ const MODEL_PROFILE_FIELDS = new Set([","   \"videoOutputs\",","   \"toolCalling\",","   \"toolChoice\",","+  \"midConversationSystemMessages\",","+  \"midConversationTools\",","   \"structuredOutput\","," ]);"," "],"additions":2,"deletions":0,"truncated":false},{"path":"internal/model-profiles/src/generator.ts","lines":["@@ -284,6 +284,19 @@ export async function generateModelProfiles(","     profiles[modelName] = finalProfile;","   }"," ","+  // A model that models.dev doesn't list, such as one in limited access, gets","+  // a profile built from its overrides alone.","+  for (const [modelName, modelSpecificOverrides] of Object.entries(","+    modelOverrides","+  )) {","+    if (modelName in profiles) continue;","+    profiles[modelName] = applyOverrides(","+      {},","+      providerOverrides,","+      modelSpecificOverrides","+    );","+  }","+","   const typescriptCode = generateTypeScript(profiles);"," ","   // Validate that the output path is within the monorepo (defensive check)"],"additions":13,"deletions":0,"truncated":false},{"path":"internal/model-profiles/src/tests/generator.test.ts","lines":["@@ -224,6 +224,38 @@ describe(\"generator\", () => {","       expect(content).toContain(\"maxOutputTokens: 8192\");","     });"," ","+    it(\"should build a profile from overrides for a model not in the API\", async () => {","+      const mockProviderData: ProviderMap = {","+        openai: createMockProvider(\"openai\", {","+          \"gpt-4\": createMockModel({","+            id: \"gpt-4\",","+            name: \"gpt-4\",","+          }),","+        }),","+      };","+","+      globalThis.fetch = vi.fn().mockResolvedValue({","+        ok: true,","+        json: async () => mockProviderData,","+      });","+","+      const outputPath = path.join(tempDir, \"models.ts\");","+","+      await generateModelProfiles(","+        \"openai\",","+        { toolCalling: true },","+        { \"unlisted-model\": { midConversationTools: true } },","+        outputPath","+      );","+","+      const content = fs.readFileSync(outputPath, \"utf-8\");","+      const unlisted = content.slice(content.indexOf('\"unlisted-model\"'));","+","+      expect(unlisted).toContain(\"toolCalling: true\");","+      expect(unlisted).toContain(\"midConversationTools: true\");","+      expect(unlisted).not.toContain(\"maxInputTokens\");","+    });","+","     it(\"should handle image inputs\", async () => {","       const mockProviderData: ProviderMap = {","         openai: createMockProvider(\"openai\", {"],"additions":32,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/language_models/profile.ts","lines":["@@ -181,6 +181,29 @@ export interface ModelProfile {","    */","   toolChoice?: boolean;"," ","+  /**","+   * Whether a system message after the first turn is sent where it sits.","+   *","+   * When `true`, the instruction applies from its position onwards, and the","+   * prompt prefix before it stays unchanged. Absent or `false` means the chat","+   * model may move it into the leading system prompt, or the provider may","+   * reject it.","+   */","+  midConversationSystemMessages?: boolean;","+","+  /**","+   * Whether tools can be added mid-conversation.","+   *","+   * The tool is added through a message rather than the request's tool list,","+   * so the prompt prefix before it stays unchanged. Implies","+   * {@link midConversationSystemMessages}.","+   *","+   * The message format is provider-specific. Every provider that sets this","+   * accepts a tool's full definition; some also accept a reference to a tool","+   * already in the request, or can remove a tool.","+   */","+  midConversationTools?: boolean;","+","   /**","    * Whether the model supports structured output generation.","    *"],"additions":23,"deletions":0,"truncated":false},{"path":"libs/providers/langchain-anthropic/profiles.toml"