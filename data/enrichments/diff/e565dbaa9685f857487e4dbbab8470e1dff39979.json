         lockfile_dir: check.lockfile_dir,","-            workspace_root: check.config.workspace_dir.as_deref().unwrap_or(check.lockfile_dir),","+            dirs: SpecDirs {","+                workspace_root: check.config.workspace_dir.as_deref().unwrap_or(check.lockfile_dir),","+                lockfile_dir: check.lockfile_dir,","+                manifests_by_dir: check.workspace.manifests_by_dir,","+            },","             catalogs: check.workspace.catalogs,","         };","         check_single_directory_dep_freshness(check, &dep, snapshot, pkg_meta)?;","@@ -189,7 +219,7 @@ fn workspace_manifest_for_unbuilt_publish_dir(","         {","             return Some(manifest);","         }","-        if candidate == dep.workspace_root {","+        if candidate == dep.dirs.workspace_root {","             return None;","         }","         candidate = candidate.parent()?;","@@ -206,12 +236,13 @@ fn check_single_directory_dep_freshness(","     let Some(snapshot) = snapshot else {","         return Err(dep.outdated());","     };","+    let peers = PeerShadowing::of(&local_manifest, pkg_meta, check.config.auto_install_peers);","     check_local_dep_group_freshness(","         dep,","         &local_manifest,","         DependencyGroup::Prod,","         snapshot.dependencies.as_ref(),","-        false,","+        (false, &peers.shadowed),","     )?;","     if check.config.optional {","         check_local_dep_group_freshness(","@@ -219,97 +250,10 @@ fn check_single_directory_dep_freshness(","             &local_manifest,","             DependencyGroup::Optional,","             snapshot.optional_dependencies.as_ref(),","-            check.optional_exclusions.allow_unresolved,","+            (check.optional_exclusions.allow_unresolved, &HashSet::new()),","         )?;","     }","-    check_local_peer_deps_freshness(dep, &local_manifest, pkg_meta)","-}","-","-/// Compares only the declared peer ranges with the recorded ones. The","-/// resolved peers in the snapshot are