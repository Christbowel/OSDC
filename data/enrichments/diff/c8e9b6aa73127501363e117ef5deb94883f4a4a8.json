io/apimachinery/pkg/runtime\"","+\t\"k8s.io/client-go/kubernetes\"","+\t\"k8s.io/client-go/kubernetes/fake\"","+\tk8stesting \"k8s.io/client-go/testing\"","+","+\tcredentials \"istio.io/istio/pilot/pkg/credentials/kube\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\txdspkg \"istio.io/istio/pilot/pkg/xds\"","+\tv3 \"istio.io/istio/pilot/pkg/xds/v3\"","+\t\"istio.io/istio/pilot/test/xds\"","+\t\"istio.io/istio/pilot/test/xdstest\"","+\t\"istio.io/istio/pkg/cluster\"","+\t\"istio.io/istio/pkg/config/mesh\"","+\t\"istio.io/istio/pkg/config/mesh/meshwatcher\"","+\t\"istio.io/istio/pkg/kube\"","+\t\"istio.io/istio/pkg/security\"","+\t\"istio.io/istio/pkg/test\"","+\t\"istio.io/istio/security/pkg/server/ca/authenticate/kubeauth\"","+)","+","+type remoteGetter map[cluster.ID]kubernetes.Interface","+","+func (r remoteGetter) GetRemoteKubeClient(c cluster.ID) kubernetes.Interface { return r[c] }","+","+func (r remoteGetter) ListClusters() []cluster.ID {","+\tout := []cluster.ID{}","+\tfor k := range r {","+\t\tout = append(out, k)","+\t}","+\treturn out","+}","+","+type headerCreds map[string]string","+","+func (h headerCreds) GetRequestMetadata(context.Context, ...string) (map[string]string, error) {","+\treturn h, nil","+}","+func (h headerCreds) RequireTransportSecurity() bool { return false }","+","+// TestXDSClusterBinding checks that the CLUSTER_ID a proxy claims in node metadata must match the","+// cluster its token was validated against, so it cannot read secrets from another cluster.","+func TestXDSClusterBinding(t *testing.T) {","+\tconst (","+\t\tclusterA = cluster.ID(\"cluster-a\")","+\t\tclusterB = cluster.ID(\"cluster-b\")","+\t)","+\ttokens := map[cluster.ID]string{clusterA: \"token-a\", clusterB: \"token-b\"}","+\tbKey := readFile(filepath.Join(certDir, \"dns/key.pem\"))","+\tbOnly := makeSecret(\"b-only-cert\", map[string]string{","+\t\tcredentials.GenericScrtCert: readFile(filepath.Join(certDir, \"dns/cert-chain.pem\")),","+\t\tcredentials.GenericScrtKey:  bKey,","+\t})","+","+\t// bufconn is plaintext; authenticate like the TLS port does","+\ttest.SetForTest(t, &security.AuthPlaintext, true)","+","+\tclients := map[cluster.ID]kube.Client{}","+\ts := xds.NewFakeDiscoveryServer(t, xds.FakeOptions{","+\t\tDefaultClusterName: clusterA,","+\t\tKubernetesObjectsByCluster: map[cluster.ID][]runtime.Object{","+\t\t\tclusterA: {},","+\t\t\tclusterB: {bOnly},","+\t\t},","+\t\tKubeClientBuilder: func(objects ...runtime.Object) kube.Client {","+\t\t\tc := kube.NewFakeClient(objects...)","+\t\t\tid := clusterA","+\t\t\tif len(objects) > 0 {","+\t\t\t\tid = clusterB","+\t\t\t}","+\t\t\tclients[id] = c","+\t\t\tfc := c.Kube().(*fake.Clientset)","+\t\t\t// the same gateway service account exists and can read its namespace's secrets in both clusters","+\t\t\txds.DisableAuthorizationForSecret(fc)","+\t\t\tfc.PrependReactor(\"create\", \"tokenreviews\", func(action k8stesting.Action) (bool, runtime.Object, error) {","+\t\t\t\ttr := &k8sauth.TokenReview{}","+\t\t\t\tif action.(k8stesting.CreateAction).GetObject().(*k8sauth.TokenReview).Spec.Token == tokens[id] {","+\t\t\t\t\ttr.Status.Authenticated = true","+\t\t\t\t\ttr.Status.User = k8sauth.UserInfo{","+\t\t\t\t\t\tUsername: \"system:serviceaccount:istio-system:istio-ingressgateway\",","+\t\t\t\t\t\tGroups:   []string{\"system:serviceaccounts\"},","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\treturn true, tr, nil","+\t\t\t})","+\t\t\treturn c","+\t\t},","+\t})","+\t// the fake server starts remote clients before the credentials controller registers its informers","+\tclients[clusterB].RunAndWait(test.NewStop(t))","+\ts.Discovery.Authenticators = []security.Authenticator{","+\t\tkubeauth.NewKubeJWTAuthenticator(meshwatcher.NewTestWatcher(mesh.DefaultMeshConfig()),","+\t\t\tclients[clusterA].Kube(), clusterA, nil, remoteGetter{clusterB: clients[clusterB].Kube()}),","+\t}","+","+\tconnect := func(token string, headerCluster, nodeCluster cluster.ID) *xdspkg.AdsTest {","+\t\tconn, err := grpc.NewClient(\"passthrough:///buffcon\",","+\t\t\tgrpc.WithTransportCredentials(insecure.NewCredentials()),","+\t\t\tgrpc.WithPerRPCCredentials(headerCreds{\"authorization\": \"Bearer \" + token, \"clusterid\": string(headerCluster)}),","+\t\t\tgrpc.WithContextDialer(func(context.Context, string) (net.Conn, error) {","+\t\t\t\treturn s.BufListener.Dial()","+\t\t\t}))","+\t\tif err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t\tt.Cleanup(func() { _ = conn.Close() })","+\t\treturn xdspkg.NewAdsTest(t, conn).","+\t\t\tWithID(\"router~1.1.1.1~gw.istio-system~istio-system.svc.cluster.local\").","+\t\t\tWithType(v3.SecretType).","+\t\t\tWithTimeout(10 * time.Second).","+\t\t\tWithMetadata(model.NodeMetadata{ClusterID: nodeCluster, Namespace: \"istio-system\", ServiceAccount: \"istio-ingressgateway\"})","+\t}","+\treq := func() *discovery.DiscoveryRequest {","+\t\treturn &discovery.DiscoveryRequest{ResourceNames: []string{\"kubernetes://b-only-cert\"}}","+\t}","+","+\tt.Run(\"token from A rejected by B\", func(t *testing.T) {","+\t\ta := connect(tokens[clusterA], clusterB, clusterB)","+\t\tif code := status.Code(a.ExpectError(t)); code != codes.Unauthenticated {","+\t\t\tt.Fatalf(\"expected Unauthenticated, got %v\", code)","+\t\t}","+\t})","+\tt.Run(\"proxy in A gets nothing from B\", func(t *testing.T) {","+\t\ta := connect(tokens[clusterA], clusterA, clusterA)","+\t\ta.Request(t, req())","+\t\ta.ExpectNoResponse(t)","+\t})","+\tt.Run(\"proxy in A claiming B is rejected\", func(t *testing.T) {","+\t\ta := connect(tokens[clusterA], clusterA, clusterB)","+\t\ta.Request(t, req())","+\t\tif code := status.Code(a.ExpectError(t)); code != codes.PermissionDenied {","+\t\t\tt.Fatalf(\"expected PermissionDenied, got %v\", code)","+\t\t}","+\t})","+\tt.Run(\"proxy in B gets B secret\", func(t *testing.T) {","+\t\tresp := connect(tokens[clusterB], clusterB, clusterB).RequestResponseAck(t, req())","+\t\tsecrets := xdstest.ExtractTLSSecrets(t, resp.Resources)","+\t\tif len(secrets) != 1 || string(secrets[\"kubernetes://b-only-cert\"].GetTlsCertificate().GetPrivateKey().GetInlineBytes()) != bKey {","+\t\t\tt.Fatalf(\"expected B secret, got %d secrets\", len(secrets))","+\t\t}","+\t})","+}"],"additions":170,"deletions":0,"truncated":false},{"path":"pkg/security/security.go","lines":["@@ -26,6 +26,7 @@ import ("," \t\"google.golang.org/grpc/metadata\""," \t\"google.golang.org/grpc/peer\""," ","+\t\"istio.io/istio/pkg/cluster\""," \t\"istio.io/istio/pkg/env\""," \tistiolog \"istio.io/istio/pkg/log\""," )","@@ -374,6 +375,8 @@ type Caller struct {"," \tIdentities []string"," "," \tKubernetesInfo KubernetesInfo","+\t// ClusterID is the cluster the caller's credential was validated against, if known.","+\tClusterID cluster.ID"," }"," "," // KubernetesInfo defines Kubernetes specific information extracted from the caller."],"additions":3,"deletions":0,"truncated":false},{"path":"releasenotes/notes/xds-cluster-binding.yaml","lines":["@@ -0,0 +1,13 @@","+apiVersion: release-notes/v2","+kind: security-fix","+area: security","+issue: []","+releaseNotes:","+  - |","+    **Fixed** istiod accepting a node metadata `CLUSTER_ID` that differs from the cluster the proxy's token was validated against.","+securityNotes:","+  - |","+    __[GHSA-gf6w-6mxv-5fj4](https://github.com/istio/istio/security/advisories/GHSA-gf6w-6mxv-5fj4)__: In multicluster installations, a proxy could claim another cluster's `CLUSTER_ID` and receive that cluster's `kubernetes://` secrets over SDS.","+    - CVSS Score: 6.3 [AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:N/A:N](https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:N/A:N)","+","+    **Credit**: This vulnerability was discovered and reported by Yonghwa Lee (Xint by Theori)."],"additions":13,"deletions":0,"truncated":false},{"path":"security/pkg/server/ca/authenticate/kubeauth/kube_jwt.go","lines":["@@ -117,7 +117,7 @@ func (a *KubeJWTAuthenticator) authenticateGrpc(ctx context.Context) (*security."," }"," "," func (a *KubeJWT