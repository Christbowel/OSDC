%);"," \t--ck-color-text-disabled: var(--app-text-2);"," \t--ck-color-text-inverse: var(--app-brand-contrast);","+\t--ck-color-text-placeholder: var(--app-text-2);"," "," \t--ck-color-interactive-focus-border-coordinates: var(--app-focus-hsl);"," \t--ck-color-interactive-focus-shadow: hsla(208, 90%, 62%, .4);"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/ckeditor5-ui/docs/framework/theme-customization.md","lines":["@@ -145,6 +145,9 @@ Assuming you finished our {@link getting-started/integrations-cdn/quick-start qu"," \t--ck-color-surface-control: var(--app-surface-1);"," \t--ck-color-surface-container: var(--app-surface-1);"," \t--ck-color-surface-inverse: hsl(252, 7%, 14%);","+\t--ck-color-surface-subtle: var(--app-surface-2);","+\t--ck-color-surface-skeleton: var(--app-surface-2);","+\t--ck-color-surface-skeleton-highlight: var(--app-surface-3);"," "," \t--ck-color-border-control: var(--app-surface-3);"," \t--ck-color-border-container: var(--app-surface-3);","@@ -154,6 +157,7 @@ Assuming you finished our {@link getting-started/integrations-cdn/quick-start qu"," \t--ck-color-text-secondary: hsl(0, 0%, 86%);"," \t--ck-color-text-disabled: var(--app-text-2);"," \t--ck-color-text-inverse: var(--app-brand-contrast);","+\t--ck-color-text-placeholder: var(--app-text-2);"," "," \t--ck-color-interactive-focus-border-coordinates: var(--app-focus-hsl);"," \t--ck-color-interactive-focus-shadow: hsla(208, 90%, 62%, .4);"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/ckeditor5-ui/theme/components/button/button.css","lines":["@@ -46,7 +46,8 @@"," \t--ck-button-on-background-color: var(--ck-color-interactive-selected-surface);"," \t--ck-button-on-hover-background-color: var(--ck-color-interactive-selected-surface-hover);"," \t--ck-button-on-active-background-color: var(--ck-color-interactive-selected-surface-hover);","-\t/* Intentionally hardcoded: no matching semantic disabled surface exists yet. */","+\t/* Intentionally hardcoded: a blue