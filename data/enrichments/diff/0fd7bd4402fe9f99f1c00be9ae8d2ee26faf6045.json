{"id":"0fd7bd4402fe9f99f1c00be9ae8d2ee26faf6045","axis":"silent","repo":"rabbitmq/rabbitmq-server","sha":"0fd7bd4402fe9f99f1c00be9ae8d2ee26faf6045","parsed":{"files":[{"path":"deps/rabbitmq_auth_backend_ldap/Makefile","lines":["@@ -36,7 +36,7 @@ endef"," "," LOCAL_DEPS = eldap public_key"," DEPS = rabbit_common rabbit cuttlefish","-TEST_DEPS = ct_helper rabbitmq_ct_helpers rabbitmq_ct_client_helpers amqp_client","+TEST_DEPS = ct_helper rabbitmq_ct_helpers rabbitmq_ct_client_helpers amqp_client meck"," dep_ct_helper = git https://github.com/extend/ct_helper.git master"," "," DEP_EARLY_PLUGINS = rabbit_common/mk/rabbitmq-early-plugin.mk"],"additions":1,"deletions":1,"truncated":false},{"path":"deps/rabbitmq_auth_backend_ldap/src/rabbit_auth_backend_ldap.erl","lines":["@@ -27,7 +27,7 @@"," %% for tests"," -export([purge_connections/0,","          fill_user_dn_pattern/1, escaped_user_dn/1, simple_bind_fill_pattern/1,","-         fill_dn_with_username/2]).","+         fill_dn_with_username/2, invalid_credentials_refused/1, with_login/4])."," "," -define(L(F, A),  log(\"LDAP \"         ++ F, A))."," -define(L1(F, A), log(\"    LDAP \"     ++ F, A)).","@@ -599,7 +599,7 @@ with_login(Creds, Servers, Opts, Fun, RetriesLeft) ->","                                  {error, invalidCredentials} ->","                                      ?L1(\"bind returned \\\"invalid credentials\\\": ~ts\",","                                          [scrub_dn(UserDN, env(log))]),","-                                     {refused, UserDN, []};","+                                     invalid_credentials_refused(UserDN);","                                  {error, ldap_closed} ->","                                      purge_connection(Creds, Servers, Opts),","                                      with_login(Creds, Servers, Opts, Fun, RetriesLeft - 1);","@@ -921,6 +921,9 @@ dn_lookup(Username, LDAP) ->","             exit(E)","     end."," ","+invalid_credentials_refused(UserDN) ->","+    {refused,