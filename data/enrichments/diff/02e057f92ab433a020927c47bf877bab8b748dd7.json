{"id":"02e057f92ab433a020927c47bf877bab8b748dd7","axis":"silent","repo":"microsoft/vscode","sha":"02e057f92ab433a020927c47bf877bab8b748dd7","parsed":{"files":[{"path":".github/instructions/css-best-practices.instructions.md","lines":["@@ -8,4 +8,4 @@ applyTo: \"**/*.css\""," ## Selectors"," "," - Avoid `:has()` selectors. Because their result depends on descendant state, DOM mutations can invalidate styles on ancestors and cause expensive style recalculation, especially when selectors are broadly scoped. Instead, represent the state explicitly with a class or data attribute on the smallest container you own, and scope selectors to that marker. Add and remove the marker together with the state it represents.","-- Never match the `class` attribute by substring (`[class*=\"…\"]`, `[class^=\"…\"]`, `[class$=\"…\"]`). A single such selector anywhere in the workbench stylesheet defeats Blink's per-class invalidation: every `classList` change then forces a style recalculation for that element, even when no rule references the class that changed. Measured on a 3.7k-node workbench, the ten `[class*=\"monaco-decoration-itemColor\"]` selectors in the Modern UI tab styles alone made a full style recalculation 2.4x slower. When a class carries a generated suffix, have the code that applies it also set a stable marker class (see `DECORATION_LABEL_COLOR_CLASS`) and match that instead.","+- Never add a new match on the `class` attribute by substring (`[class*=\"…\"]`, `[class^=\"…\"]`, `[class$=\"…\"]`). A single such selector anywhere in the workbench stylesheet defeats Blink's per-class invalidation: every `classList` change then forces a style recalculation for that element, even when no rule references the class that changed. Measured on a 3.7k-node workbench, the ten `[class*=\"monaco-decoration-itemColor\"]` selectors in the Modern UI tab styles alone made a full style recalculation 2.4x slower. When a class carries a generated suffix, have the code that applies it also set a stable marker class (see `DECORATION_LABEL_COLOR_CLASS`) and match that instead. Existing `codicon-*` substring selectors are a grandfathered compatibility contract and must only be changed in a dedicated, separately validated codicon migration."],"additions":1,"deletions":1,"truncated":false},{"path":".github/skills/auto-perf-optimize/scratchpad/README.md","lines":["@@ -49,7 +49,9 @@ These are reusable, generic runners. Use them directly or as templates:"," - **`chat-session-switch-smoke.mts`** — Creates multiple chat sessions with","   different content, then repeatedly switches between them via the sessions","   sidebar. Measures per-switch memory growth.","-","+- **`workbench-css-performance.mts`** — Measures Modern UI style and layout","+  cost while resizing, opening/switching/closing editor tabs, and toggling","+  workbench parts. Writes per-round data and medians to `summary.json`."," - **`userDataProfile.mts`** — Utility for managing user-data profiles in","   smoke test runs."," "],"additions":3,"deletions":1,"truncated":false},{"path":".github/skills/auto-perf-optimize/scripts/workbench-css-performance.mts","lines":["@@ -0,0 +1,772 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+/**","+ * Measures Modern UI style and layout cost across resize, tab, and part-toggle","+ * workflows. Writes raw rounds, medians, and screenshots to an output folder.","+ */","+","+import { chromium, type Browser, type CDPSession, type Page } from 'playwright-core';","+import { execFileSync, spawn, type ChildProcess } from 'node:child_process';","+import { createHash } from 'node:crypto';","+import { lstatSync, readFileSync, readlinkSync } from 'node:fs';","+import { mkdir, rm, writeFile } from 'node:fs/promises';","+import http from 'node:http';","+import os from 'node:os';","+import path from 'node:path';","+import process from 'node:process';","+import { setTimeout as timeout } from 'node:timers/promises';","+","+const root = path.resolve(import.meta.dirname, '..', '..', '..', '..');","+const options = parseArgs(process.argv.slice(2));","+const phaseNames = ['resize', 'class-mutations', 'open-tabs', 'switch-tabs', 'close-tabs', 'toggle-parts'] as const;","+","+interface SmokeTestDriver {","+\twhenWorkbenchRestored(): Promise<void>;","+}","+","+declare global {","+\tvar driver: SmokeTestDriver | undefined;","+}","+","+type PhaseName = typeof phaseNames[number];","+","+interface Options {","+\thelp: boolean;","+\tverbose: boolean;","+\tskipPrelaunch: boolean;","+\tkeepOpen: boolean;","+\tport: number;","+\trounds: number;","+\twarmupRounds: number;","+\ttabCount: number;","+\ttabsPerRound: number;","+\tresizesPerRound: number;","+\tswitchesPerRound: number;","+\tpartTogglesPerRound: number;","+\tclassMutationsPerRound: number;","+\toutputDir: string;","+\tworkspace: string;","+\tcodeRoot: string;","+}","+","+interface MetricSnapshot {","+\t[name: string]: number;","+}","+","+interface PhaseResult {","+\tround: number;","+\tphase: PhaseName;","+\twallTimeMs: number;","+\trecalcStyleDurationMs: number;","+\tlayoutDurationMs: number;","+\tscriptDurationMs: number;","+\ttaskDurationMs: number;","+\trecalcStyleCount: number;","+\tlayoutCount: number;","+\ttabCountBefore: number;","+\ttabCountAfter: number;","+}","+","+interface Summary {","+\tcreatedAt: string;","+\terror?: string;","+\toptions: Omit<Options, 'help' | 'verbose' | 'keepOpen'>;","+\tstate: {","+\t\tmodernUIEnabled: boolean;","+\t\tnodeCount: number;","+\t\tinitialTabCount: number;","+\t\tfinalTabCount?: number;","+\t\tclassMutationTargetCount: number;","+\t\tsourceRevision: string;","+\t};","+\tresults: PhaseResult[];","+\taggregate?: Record<PhaseName, Omit<PhaseResult, 'round' | 'phase' | 'tabCountBefore' | 'tabCountAfter'>>;","+}","+","+interface LaunchedCode {","+\tchild: ChildProcess;","+\tfailedBeforeConnect: Promise<Error>;","+\tmarkConnected(): void;","+\tterminate(): Promise<void>;","+}","+","+if (options.help) {","+\tprintHelp();","+\tprocess.exit(0);","+}","+","+await main();","+","+async function main(): Promise<void> {","+\tconst outputDir = path.resolve(options.outputDir);","+\tconst workspace = path.resolve(options.workspace);","+\tconst userDataDir = path.join(os.tmpdir(), `vscode-css-perf-${process.pid}`);","+\tconst extensionsDir = path.join(os.tmpdir(), `vscode-css-perf-ext-${process.pid}`);","+\tconst summary: Summary = {","+\t\tcreatedAt: new Date().toISOString(),","+\t\toptions: {","+\t\t\tskipPrelaunch: options.skipPrelaunch,","+\t\t\tport: options.port,","+\t\t\trounds: options.rounds,","+\t\t\twarmupRounds: options.warmupRounds,","+\t\t\ttabCount: options.tabCount,","+\t\t\ttabsPerRound: options.tabsPerRound,","+\t\t\tresizesPerRound: options.resizesPerRound,","+\t\t\tswitchesPerRound: options.switchesPerRound,","+\t\t\tpartTogglesPerRound: options.partTogglesPerRound,","+\t\t\tclassMutationsPerRound: options.classMutationsPerRound,","+\t\t\toutputDir,","+\t\t\tworkspace,","+\t\t\tcodeRoot: options.codeRoot,","+\t\t},","+\t\tstate: {","+\t\t\tmodernUIEnabled: false,","+\t\t\tnodeCount: 0,","+\t\t\tinitialTabCount: 0,","+\t\t\tclassMutationTargetCount: 0,","+\t\t\tsourceRevision: 'unavailable',","+\t\t},","+\t\tresults: [],","+\t};","+","+\tlet launchedCode: LaunchedCode | undefined;","+\tlet browser: Browser | undefined;","+\tlet session: CDPSession | undefined;","+\tlet processExitError: Error | undefined;","+\ttry {","+\t\tsummary.state.sourceRevision = getSourceRevision();","+\t\tawait transpileClient();","+\t\tif (!options.skipPrelaunch) {","+\t\t\tawait prepareCode();","+\t\t}","+\t\tawait rm(userDataDir, { recursive: true, force: true, maxRetries: 3 });","+\t\tawait rm(extensionsDir, { recursive: true, force: true, maxRetries: 3 });","+\t\tawait mkdir(workspace, { recursive: true });","+\t\tawait mkdir(path.join(userDataDir, 'User'), { recursive: true });","+\t\tawait mkdir(extensionsDir, { recursive: true });","+\t\tawait writeFile(path.join(userDataDir, 'User', 'settings.json'), JSON.stringify({","+\t\t\t'workbench.experimental.modernUI': true,","+\t\t\t'window.density.layout': 'default',","+\t\t\t'workbench.startupEditor': 'none',","+\t\t\t'workbench.editor.enablePreview': false,","+\t\t\t'workbench.editor.showTabs': 'multiple',","+\t\t\t'workbench.editor.wrapTabs': false,","+\t\t\t'workbench.editor.pinnedTabSizing': 'normal',","+\t\t\t'workbench.editor.tabActionLocation': 'right',","+\t\t\t'window.commandCenter': true,","+\t\t}, undefined, '\\t'));","+","+\t\tif (await isCDPAvailable(options.port)) {","+\t\t\tthrow new Error(`Port ${options.port} already exposes CDP.`);","+\t\t}","+","+\t\tlaunchedCode = launchCode(userDataDir, extensionsDir, workspace);","+\t\tbrowser = await connectToCode(options.port, launchedCode.failedBeforeConnect);","+\t\tlaunchedCode.markConnected();","+\t\tconst page = await findWorkbenchPage(browser);","+\t\tsession = await page.context().newCDPSession(page);","+\t\tawait session.send('Performance.enable', { timeDomain: 'timeTicks' });","+\t\tawait page.evaluate(() => globalThis.driver?.whenWorkbenchRestored());","+\t\tawait waitForFrames(page, 4);","+","+\t\tconst initialState = await page.evaluate(() => ({","+\t\t\tmodernUIEnabled: document.querySelector('.monaco-workbench')?.classList.contains('modern-ui-tabs') === true,","+\t\t\tnodeCount: document.querySelectorAll('*').length,","+\t\t\ttabCount: document.querySelectorAll('.tabs-container .tab').length,","+\t\t}));","+\t\tif (!initialState.modernUIEnabled) {","+\t\t\tthrow new Error('Modern UI did not activate from the benchmark profile.');","+\t\t}","+\t\tsummary.state.modernUIEnabled = initialState.modernUIEnabled;","+\t\tsummary.state.nodeCount = initialState.nodeCount;","+\t\tsummary.state.initialTabCount = initialState.tabCount;","+","+\t\tawait ensureTabCount(page, options.tabCount);","+\t\tsummary.state.classMutationTargetCount = await getClassMutationTargetCount(page);","+\t\tawait page.screenshot({ path: path.join(outputDir, '01-warmed-workbench.png') });","+","+\t\tfor (let round = 1; round <= options.warmupRounds; round++) {","+\t\t\tawait runRound(page, session, round, false, summary);","+\t\t}","+","+\t\tfor (let round = 1; round <= options.rounds; round++) {","+\t\t\tawait runRound(page, session, round, true, summary);","+\t\t\tawait writeSummary(outputDir, summary);","+\t\t}","+","+\t\tsummary.state.finalTabCount = await getTabCount(page);","+\t\tsummary.aggregate = aggregateResults(summary.results);","+\t\tawait page.screenshot({ path: path.join(outputDir, '02-final-workbench.png') });","+\t\tawait writeSummary(outputDir, summary);","+\t\tprintSummary(summary);","+\t} catch (error) {","+\t\tsummary.error = error instanceof Error && error.stack ? error.stack : String(error);","+\t\tawait writeSummary(outputDir, summary);","+\t\tthrow error;","+\t} finally {","+\t\tif (browser && !options.keepOpen) {","+\t\t\tconst browserSession = await settleWithin(browser.newBrowserCDPSession(), 2000);","+\t\t\tif (browserSession) {","+\t\t\t\tawait settleWithin(browserSession.send('Browser.close'), 5000);","+\t\t\t\tawait settleWithin(browserSession.detach(), 1000);","+\t\t\t}","+\t\t}","+\t\tawait session?.detach().catch(() => undefined);","+\t\tawait settleWithin(browser?.close() ?? Promise.resolve(), 2000);","+\t\tif (launchedCode && !options.keepOpen) {","+\t\t\tif (!await waitForChildExit(launchedCode.child, 10000)) {","+\t\t\t\tawait launchedCode.terminate();","+\t\t\t\tif (!await waitForChildExit(launchedCode.child, 5000)) {","+\t\t\t\t\tprocessExitError = new Error(`Code process tree did not exit after termination. pid=${launchedCode.child.pid}`);","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tif (!options.keepOpen) {","+\t\t\tawait rm(userDataDir, { recursive: true, force: true, maxRetries: 3 }).catch(() => undefined);","+\t\t\tawait rm(extensionsDir, { recursive: true, force: true, maxRetries: 3 }).catch(() => undefined);","+\t\t}","+\t}","+\tif (processExitError) {","+\t\tsummary.error = processExitError.stack ?? processExitError.message;","+\t\tawait writeSummary(outputDir, summary);","+\t\tthrow processExitError;","+\t}","+}","+","+async function runRound(page: Page, session: CDPSession, round: number, record: boolean, summary: Summary): Promise<void> {","+\tawait ensureTabCount(page, options.tabCount);","+\tawait measurePhase(page, session, round, 'resize', record, summary, () => resizeWindow(page, session));","+\tawait measurePhase(page, session, round, 'class-mutations', record, summary, () => mutateUnreferencedClasses(page));","+\tawait measurePhase(page, session, round, 'open-tabs', record, summary, () => openTabs(page, options.tabsPerRound));","+\tawait measurePhase(page, session, round, 'switch-tabs', record, summary, () => switchTabs(page, options.switchesPerRound));","+\tawait measurePhase(page, session, round, 'close-tabs', record, summary, () => closeTabs(page, options.tabsPerRound));","+\tawait measurePhase(page, session, round, 'toggle-parts', record, summary, () => toggleWorkbenchParts(page, options.partTogglesPerRound));","+}","+","+async function measurePhase(","+\tpage: Page,","+\tsession: CDPSession,","+\tround: number,","+\tphase: PhaseName,","+\trecord: boolean,","+\tsummary: Summary,","+\trun: () => Promise<void>,","+): Promise<void> {","+\tconst tabCountBefore = await getTabCount(page);","+\tconst metricsBefore = await getPerformanceMetrics(session);","+\tconst started = performance.now();","+\tawait run();","+\tawait waitForFrames(page, 2);","+\tconst wallTimeMs = performance.now() - started;","+\tconst metricsAfter = await getPerformanceMetrics(session);","+\tconst result: PhaseResult = {","+\t\tround,","+\t\tphase,","+\t\twallTimeMs,","+\t\trecalcStyleDurationMs: metricDelta(metricsBefore, metricsAfter, 'RecalcStyleDuration') * 1000,","+\t\tlayoutDurationMs: metricDelta(metricsBefore, metricsAfter, 'LayoutDuration') * 1000,","+\t\tscriptDurationMs: metricDelta(metricsBefore, metricsAfter, 'ScriptDuration') * 1000,","+\t\ttaskDurationMs: metricDelta(metricsBefore, metricsAfter, 'TaskDuration') * 1000,","+\t\trecalcStyleCount: metricDelta(metricsBefore, metricsAfter, 'RecalcStyleCount'),","+\t\tlayoutCount: metricDelta(metricsBefore, metricsAfter, 'LayoutCount'),","+\t\ttabCountBefore,","+\t\ttabCountAfter: await getTabCount(page),","+\t};","+\tif (record) {","+\t\tsummary.results.push(result);","+\t\tconsole.log(formatResult(result));","+\t}","+}","+","+async function resizeWindow(page: Page, session: CDPSession): Promise<void> {","+\tconst sizes = [","+\t\t{ width: 1120, height: 760 },","+\t\t{ width: 1540, height: 940 },","+\t];","+\tfor (let index = 0; index < options.resizesPerRound; index++) {","+\t\tconst size = sizes[index % sizes.length];","+\t\tawait session.send('Emulation.setDeviceMetricsOverride', {","+\t\t\twidth: size.width,","+\t\t\theight: size.height,","+\t\t\tdeviceScaleFactor: 1,","+\t\t\tmobile: false,","+\t\t});","+\t\tawait page.waitForFunction(expected => window.innerWidth === expected.width && window.innerHeight === expected.height, size);","+\t\tawait waitForFrames(page, 1);","+\t}","+}","+","+async function openTabs(page: Page, count: number): Promise<void> {","+\tconst initialCount = await getTabCount(page);","+\tfor (let index = 1; index <= count; index++) {","+\t\tawait page.keyboard.press(process.platform === 'darwin' ? 'Meta+N' : 'Control+N');","+\t\tawait waitForTabCount(page, initialCount + index);","+\t}","+}","+","+async function mutateUnreferencedClasses(page: Page): Promise<void> {","+\tawait page.evaluate(iterations => {","+\t\tconst elements = Array.from(document.querySelectorAll<HTMLElement>('.codicon, .predefined-file-icon, .tab-label, .monaco-icon-label'));","+\t\tif (elements.length === 0) {","+\t\t\tthrow new Error('No class mutation targets were found.');","+\t\t}","+\t\tfor (let index = 0; index < iterations; index++) {","+\t\t\tconst className = `css-performance-probe-${index % 2}`;","+\t\t\tfor (const element of elements) {","+\t\t\t\telement.classList.add(className);","+\t\t\t}","+\t\t\tvoid document.body.offsetWidth;","+\t\t\tfor (const element of elements) {","+\t\t\t\telement.classList.remove(className);","+\t\t\t}","+\t\t\tvoid document.body.offsetWidth;","+\t\t}","+\t}, options.classMutationsPerRound);","+}","+","+async function getClassMutationTargetCount(page: Page): Promise<number> {","+\treturn page.locator('.codicon, .predefined-file-icon, .tab-label, .monaco-icon-label').count();","+}","+","+async function switchTabs(page: Page, count: number): Promise<void> {","+\tconst tabs = page.locator('.tabs-container .tab');","+\tconst tabCount = await tabs.count();","+\tif (tabCount < 2) {","+\t\tthrow new Error(`Cannot switch tabs with only ${tabCount} tab(s).`);","+\t}","+\tfor (let index = 0; index < count; index++) {","+\t\tawait tabs.nth(index % tabCount).click();","+\t\tawait page.waitForFunction(expectedIndex => {","+\t\t\tconst candidates = Array.from(document.querySelectorAll('.tabs-container .tab'));","+\t\t\treturn candidates[expectedIndex]?.classList.contains('active') === true;","+\t\t}, index % tabCount);","+\t}","+}","+","+async function closeTabs(page: Page, count: number): Promise<void> {","+\tconst initialCount = await getTabCount(page);","+\tfor (let index = 1; index <= count; index++) {","+\t\tawait page.keyboard.press(process.platform === 'darwin' ? 'Meta+W' : 'Control+W');","+\t\tawait waitForTabCount(page, initialCount - index);","+\t}","+}","+","+async function toggleWorkbenchParts(page: Page, count: number): Promise<void> {","+\tconst initialState = await getWorkbenchVisibilityState(page);","+\tfor (let index = 0; index < count; index++) {","+\t\tawait toggleWorkbenchClass(page, process.platform === 'darwin' ? 'Meta+B' : 'Control+B', 'nosidebar');","+\t\tawait toggleWorkbenchClass(page, process.platform === 'darwin' ? 'Meta+J' : 'Control+J', 'nopanel');","+\t}","+\tconst finalState = await getWorkbenchVisibilityState(page);","+\tif (finalState.sideBarHidden !== initialState.sideBarHidden) {","+\t\tawait toggleWorkbenchClass(page, process.platform === 'darwin' ? 'Meta+B' : 'Control+B', 'nosidebar');","+\t}","+\tif (finalState.panelHidden !== initialState.panelHidden) {","+\t\tawait toggleWorkbenchClass(page, process.platform === 'darwin' ? 'Meta+J' : 'Control+J', 'nopanel');","+\t}","+\tconst restoredState = await getWorkbenchVisibilityState(page);","+\tif (restoredState.sideBarHidden !== initialState.sideBarHidden || restoredState.panelHidden !== initialState.panelHidden) {","+\t\tthrow new Error('Workbench parts did not return to their initial visibility state.');","+\t}","+}","+","+async function toggleWorkbenchClass(page: Page, keybinding: string, className: string): Promise<void> {","+\tconst wasSet = await page.locator('.monaco-workbench').evaluate((workbench, expectedClass) => workbench.classList.contains(expectedClass), className);","+\tawait page.keyboard.press(keybinding);","+\tawait page.waitForFunction(({ expectedClass, expectedState }) => {","+\t\tconst workbench = document.querySelector('.monaco-workbench');","+\t\treturn workbench?.classList.contains(expectedClass) !== expectedState;","+\t}, { expectedClass: className, expectedState: wasSet });","+\tawait waitForFrames(page, 1);","+}","+","+async function getWorkbenchVisibilityState(page: Page): Promise<{ sideBarHidden: boolean; panelHidden: boolean }> {","+\treturn page.locator('.monaco-workbench').evaluate(workbench => ({","+\t\tsideBarHidden: workbench.classList.contains('nosidebar'),","+\t\tpanelHidden: workbench.classList.contains('nopanel'),","+\t}));","+}","+","+async function ensureTabCount(page: Page, expected: number): Promise<void> {","+\tconst current = await getTabCount(page);","+\tif (current < expected) {","+\t\tawait openTabs(page, expected - current);","+\t} else if (current > expected) {","+\t\tawait closeTabs(page, current - expected);","+\t}","+}","+","+async function getTabCount(page: Page): Promise<number> {","+\treturn page.locator('.tabs-container .tab').count();","+}","+","+async function waitForTabCount(page: Page, count: number): Promise<void> {","+\tawait page.waitForFunction(expected => document.querySelectorAll('.tabs-container .tab').length === expected, count);","+\tawait waitForFrames(page, 1);","+}","+","+async function waitForFrames(page: Page, count: number): Promise<void> {","+\tawait page.evaluate(async frameCount => {","+\t\tfor (let index = 0; index < frameCount; index++) {","+\t\t\tawait new Promise<void>(resolve => requestAnimationFrame(() => resolve()));","+\t\t}","+\t}, count);","+}","+","+async function getPerformanceMetrics(session: CDPSession): Promise<MetricSnapshot> {","+\tconst response = await session.send('Performance.getMetrics');","+\treturn Object.fromEntries(response.metrics.map(metric => [metric.name, metric.value]));","+}","+","+function metricDelta(before: MetricSnapshot, after: MetricSnapshot, name: string): number {","+\treturn (after[name] ?? 0) - (before[name] ?? 0);","+}","+","+function aggregateResults(results: PhaseResult[]): Summary['aggregate'] {","+\treturn Object.fromEntries(phaseNames.map(phase => {","+\t\tconst phaseResults = results.filter(result => result.phase === phase);","+\t\treturn [phase, {","+\t\t\twallTimeMs: median(phaseResults.map(result => result.wallTimeMs)),","+\t\t\trecalcStyleDurationMs: median(phaseResults.map(result => result.recalcStyleDurationMs)),","+\t\t\tlayoutDurationMs: median(phaseResults.map(result => result.layoutDurationMs)),","+\t\t\tscriptDurationMs: median(phaseResults.map(result => result.scriptDurationMs)),","+\t\t\ttaskDurationMs: median(phaseResults.map(result => result.taskDurationMs)),","+\t\t\trecalcStyleCount: median(phaseResults.map(result => result.recalcStyleCount)),","+\t\t\tlayoutCount: median(phaseResults.map(result => result.layoutCount)),","+\t\t}];","+\t})) as Summary['aggregate'];","+}","+","+function median(values: number[]): number {","+\tif (values.length === 0) {","+\t\treturn 0;","+\t}","+\tconst sorted = values.toSorted((a, b) => a - b);","+\tconst middle = Math.floor(sorted.length / 2);","+\treturn sorted.length % 2 === 0 ? (sorted[middle - 1] + sorted[middle]) / 2 : sorted[middle];","+}","+","+function formatResult(result: PhaseResult): string {","+\treturn [","+\t\t`round=${result.round}`,","+\t\t`phase=${result.phase}`,","+\t\t`wall=${result.wallTimeMs.toFixed(1)}ms`,","+\t\t`style=${result.recalcStyleDurationMs.toFixed(2)}ms/${result.recalcStyleCount}`,","+\t\t`layout=${result.layoutDurationMs.toFixed(2)}ms/${result.layoutCount}`,","+\t\t`tabs=${result.tabCountBefore}->${result.tabCountAfter}`,","+\t].join(' ');","+}","+","+function printSummary(summary: Summary): void {","+\tconsole.log(`\\nSummary: ${path.join(options.outputDir, 'summary.json')}`);","+\tfor (const phase of phaseNames) {","+\t\tconst result = summary.aggregate?.[phase];","+\t\tif (result) {","+\t\t\tconsole.log(`${phase.padEnd(14)} wall=${result.wallTimeMs.toFixed(1)}ms style=${result.recalcStyleDurationMs.toFixed(2)}ms layout=${result.layoutDurationMs.toFixed(2)}ms`);","+\t\t}","+\t}","+}","+","+async function writeSummary(outputDir: string, summary: Summary): Promise<void> {","+\tawait mkdir(outputDir, { recursive: true });","+\tawait writeFile(path.join(outputDir, 'summary.json'), JSON.stringify(summary, undefined, '\\t'));","+}","+","+function launchCode(userDataDir: string, extensionsDir: string, workspace: string): LaunchedCode {","+\tlet failBeforeConnect: (error: Error) => void = () => undefined;","+\tlet connected = false;","+\tlet terminating = false;","+\tconst failedBeforeConnect = new Promise<Error>(resolve => failBeforeConnect = resolve);","+\tconst args = [","+\t\t'.',","+\t\t'--disable-extension=vscode.vscod