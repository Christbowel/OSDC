{"id":"796ae2e2b6059581cfee7c700a4659c3b554bda5","axis":"silent","repo":"pnpm/pnpm","sha":"796ae2e2b6059581cfee7c700a4659c3b554bda5","parsed":{"files":[{"path":".changeset/lockfile-only-progress.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+`pnpm install --lockfile-only` shows its progress again, counting the packages it resolves."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/lockfile_only.rs","lines":["@@ -565,3 +565,54 @@ fn write_registry_workspace(workspace: &Path, registry: &str) {","     )","     .expect(\"write pnpm-workspace.yaml\");"," }","+","+/// `pacquet install --lockfile-only` fetches nothing, so resolution itself","+/// reports each package it resolves, once, for the progress line.","+#[test]","+fn reports_each_resolved_package_once() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"dependencies\": {","+                \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\",","+            },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+","+    let output = pacquet","+        .with_args([\"install\", \"--lockfile-only\", \"--reporter=ndjson\"])","+        .output()","+        .expect(\"run pacquet install --lockfile-only\");","+    _utils::assert_success(&output);","+    let mut resolved: Vec<String> = _utils::ndjson_records(&output)","+        .into_iter()","+        .filter(|record| {","+            record.get(\"name\").and_then(serde_json::Value::as_str) == Some(\"pnpm:progress\")","+                && record.get(\"status\").and_then(serde_json::Value::as_str) == Some(\"resolved\")","+        })","+        .filter_map(|record| {","+            record","+                .get(\"packageId\")","+                .and_then(serde_json::Value::as_str)","+                .map(str::to_string)","+        })","+        .collect();","+    resolved.sort();","+    assert_eq!(","+        resolved,","+        [\"@pnpm.e2e/dep-of-pkg-with-1-dep@100.1.0\", \"@pnpm.e2e/pkg-with-1-dep@100.0.0\"],","+        \"{output:?}\",","+    );","+","+    drop((root, mock_instance));","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile.rs","lines":["@@ -276,6 +276,13 @@ impl FreshInstallExecution {","     pub(crate) fn fetches_into_store(self) -> bool {","         self.resolve_only == Some(ResolveOnly::FetchIntoStore)","     }","+","+    /// Whether resolution reports each package's `resolved` progress. Every","+    /// other install reports it from the paths that fetch or link the","+    /// package, and a lockfile-only run has none.","+    pub(crate) fn reports_resolved_packages(self) -> bool {","+        self.resolve_only == Some(ResolveOnly::LockfileOnly)","+    }"," }"," "," #[derive(Clone, Copy)]","@@ -616,6 +623,25 @@ fn skipped_optional_log_fn<Reporter: self::Reporter>()","     })"," }"," ","+/// A `pnpm:progress` `resolved` event for each package resolution adds to","+/// the graph, once per package across the walks of an automatic dedupe.","+fn resolved_progress_fn<Reporter: self::Reporter>(","+    requester: String,","+) -> pnpm_resolving_deps_resolver::ResolvedPackageFn {","+    let reported = dashmap::DashSet::<String>::new();","+    Arc::new(move |package_id| {","+        if reported.insert(package_id.to_owned()) {","+            Reporter::emit(&LogEvent::Progress(pnpm_reporter::ProgressLog {","+                level: LogLevel::Debug,","+                message: pnpm_reporter::ProgressMessage::Resolved {","+                    package_id: package_id.to_owned(),","+                    requester: requester.clone(),","+                },","+            }));","+  