{"id":"b9767eabeebea37d4a42d13fc3c28ea399f0fa2e","axis":"silent","repo":"pnpm/pnpm","sha":"b9767eabeebea37d4a42d13fc3c28ea399f0fa2e","parsed":{"files":[{"path":".changeset/patch-commit-keeps-bound-peers.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm patch-commit` keeps the peers a patched package is bound to in the lockfile. It no longer fails with `ERR_PNPM_NEXT_LOCKFILE_NOT_REPRESENTABLE` when the package has an optional peer and `lockfile.format` is `v13`."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/patch-local-directory-dependency.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+A name-only `patchedDependencies` entry now records its patch hash on a `file:` directory dependency or an injected workspace package. `pnpm install --frozen-lockfile` no longer fails with `ERR_PNPM_INCONSISTENT_PATCH_HASH` on the lockfile that `pnpm install` wrote."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/patch-named-registry-package.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm patch` and `pnpm patch-commit` now find a package installed from a `namedRegistries` alias by its version. For example, `pnpm patch foo@1.0.0` patches a dependency declared as `work:1.0.0`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_commit/lockfile_update.rs","lines":["@@ -1,7 +1,9 @@"," use crate::state::State;"," use pnpm_lockfile::{","     Lockfile,","+    PackageMetadata,","     SnapshotEntry,","+    name_version_from_package_key,"," };"," use pnpm_package_manifest::PackageManifest;"," use serde_json::Value;","@@ -22,18 +24,45 @@ impl<'a> DeclaredDeps<'a> {","         }","     }"," ","-    fn contains(&self, name: &str) -> bool {","-        self.deps.is_some_and(|d| d.contains_key(name))","-            || self.opt_deps.is_some_and(|d| d.contains_key(name))","+    fn declares(&self, name: &str) -> bool {","+        self.deps.is_some_and(|d| d.contains_key(name)) || self.declares_optional(name)","+    }","+","+    fn declares_optional(&self, name: &str) -> bool {","+        self.opt_deps.is_some_and(|d| d.contains_key(name))","             || self.peer_deps.is_some_and(|d| d.contains_key(name))","     }"," }"," ","-fn prune_snapshot_edges(snapshot: &mut SnapshotEntry, declared: &DeclaredDeps<'_>) -> bool {","+/// Whether the lockfile records `name` as a peer of the package. Peers are","+/// resolved from the registry's manifest, which a patch does not change, so an","+/// edge to one is kept even when the patched manifest drops it.","+fn is_recorded_peer(metadata: Option<&PackageMetadata>, name: &str) -> bool {","+    metadata.is_some_and(|metadata| {","+        metadata.peer_dependencies","+            .as_ref()","+            .is_some_and(|peers| peers.contains_key(name))","+            || metadata.peer_dependencies_meta","+                .as_ref()","+                .is_some_and(|meta| meta.contains_key(name))","+    })","+}","+","+/// Drops the snapshot's edges that the patched manifest no longer declares.","+/// A snapshot's `optionalDependencies` hold both its optional dependencies and","+/// the optional peers it is bound to.","+fn prune_snapshot_edges(","+    snapshot: &mut SnapshotEntry,","+    declared: &DeclaredDeps<'_>,","+    metadata: Option<&PackageMetadata>,","+) -> bool {","     let mut changed = false;","     if let Some(deps) = &mut snapshot.dependencies {","         let initial_len = deps.len();","-        deps.retain(|name, _| declared.contains(&name.to_string()));","+        deps.retain(|name, _| {","+            let name = name.to_string();","+            declared.declares(&name) || is_recorded_peer(metadata, &name)","+        });","         changed |= deps.len() != initial_len;","         if deps.is_empty() {","             snapshot.dependencies = None;","@@ -42,7 +71,8 @@ fn prune_snapshot_edges(snapshot: &mut SnapshotEntry, declared: &DeclaredDeps<'_","     if let Some(opt_deps) = &mut snapshot.optional_dependencies {","         let initial_len = opt_deps.len();","         opt_deps.retain(|name, _| {","-            declared.opt_deps.is_some_and(|d| d.contains_key(&name.to_string()))","+            let name = name.to_string();","+            declared.declares_optional(&name) || is_recorded_peer(metadata, &name)","         });","         changed |= opt_deps.len() != initial_len;","         if opt_deps.is_empty() {","@@ -63,11 +93,13 @@ fn prune_matching_snapshots(","         return false;","     };","     let mut changed = false;","+    let packages = lockfile.packages.as_ref();","     for (key, snapshot) in snapshots.iter_mut() {","-        if key.name.to_string() == name","-            && (apply_to_all || key.suffix.version().to_string() == version)","-        {","-            changed |= prune_snapshot_edges(snapshot, declared);","+        let metadata_key = key.without_peer();","+        let (key_name, key_version) = name_version_from_package_key(&metadata_key, packages);","+        if key_name == name && (apply_to_all || key_version == version) {","+            let metadata = packages.and_then(|packages| packages.get(&metadata_key));","+            changed |= prune_snapshot_edges(snapshot, declared, metadata);","         }","     }","     changed"],"additions":42,"deletions":10,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/patch.rs","lines":["@@ -947,4 +947,6 @@ mod application;"," "," mod commit;"," ","+mod commit_lockfile;","+"," mod removal;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/patch/application.rs","lines":["@@ -284,6 +284,48 @@ fn git_dependency_patch_applies_on_fresh_and_frozen_install() {","     drop((root, mock_instance));"," }"," ","+#[test]","+fn wildcard_patch_applies_to_a_local_directory_on_fresh_and_frozen_install() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let local_dir = workspace.join(\"local-pkg\");","+    fs::create_dir_all(&local_dir).expect(\"create local package\");","+    fs::write(","+        local_dir.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"is-positive\", \"version\": \"3.1.0\" }).to_string(),","+    )","+    .expect(\"write local package.json\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { \"is-positive\": \"file:./local-pkg\" } }).to_string(),","+    )","+    .expect(\"write package.json\");","+    fs::create_dir_all(workspace.join(\"patches\")).expect(\"create patches dir\");","+    fs::write(workspace.join(\"patches/is-positive.patch\"), MARKER_PATCH).expect(\"write patch file\");","+    append_workspace_yaml_key(","+        &workspace,","+        \"patchedDependencies\",","+        \"\\n  is-positive: patches/is-positive.patch\",","+    );","+","+    pacquet(&workspace, [\"install\", \"--reporter=silent\"]).assert().success();","+    let marker = workspace.join(\"node_modules/is-positive/patched-marker.txt\");","+    assert_eq!(fs::read_to_string(&marker).expect(\"read fresh marker\"), \"patched\\n\");","+    let patch_hash = patch_file_hash(&workspace, \"is-positive.patch\");","+    let snapshots = snapshot_keys(&read_wanted_lockfile(&workspace));","+    assert!(","+        snapshots.contains(&format!(\"is-positive@file:local-pkg(patch_hash={patch_hash})\")),","+        \"snapshots: {snapshots:?}\",","+    );","+","+    remove_dir_if_exists(&workspace.join(\"node_modules\"));","+    pacquet(&workspace, [\"install\", \"--frozen-lockfile\", \"--reporter=silent\"]).assert().success();","+    assert_eq!(fs::read_to_string(&marker).expect(\"read frozen marker\"), \"patched\\n\");","+","+    drop((root, mock_instance));","+}","+"," /// TS: `the patched package is updated if the patch is modified`"," /// (`patch.ts:269`)."," #[test]"],"additions":42,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/patch/commit.rs","lines":["@@ -1,6 +1,5 @@"," use super::{","     AddMockedRegistry,","-    CommandTempCwd,","     fs,","     pacquet,","     remove_dir_if_exists,","@@ -732,126 +731,6 @@ fn patch_commit_ambiguous_bare_name_and_versioned_state_entries_fails() {","     drop((root, mock_instance));"," }"," ","-#[test]","-fn patch_commit_updates_lockfile_when_manifest_dependencies_removed() {","-    let CommandTempCwd { root, workspace, npmrc_info, .. } =","-        CommandTempCwd::init().add_mocked_registry();","-    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","-","-    fs::write(","-        workspace.join(\"package.json\"),","-        serde_json::json!({","-            \"dependencies\": {","-                \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\",","-            },","-        })","-        .to_string(),","-    )","-    .expect(\"write package.json\");","-","-    pacquet(&workspace, [\"install\", \"--reporter=silent\"]).assert().success();","-","-    let lockfile_text =","-        fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","-    assert!(","-        lockfile_text.contains(\"@pnpm.e2e/dep-of-pkg-with-1-dep\"),","-        \"initial lockfile should contain dep-of-pkg-with-1-dep\",","-    );","-","-    pacquet(&workspace, [\"patch\", \"@pnpm.e2e/pkg-with-1-dep@100.0.0\", \"--reporter=silent\"])","-        .assert()","-        .success();","-","-    let edit_dir = workspace.join(\"node_modules/.pnpm_patches/@pnpm.e2e/pkg-with-1-dep@100.0.0\");","-    let edit_manifest_path = edit_dir.join(\"package.json\");","-    let mut manifest: serde_json::Value = serde_json::from_str(","-        &fs::read_to_string(&edit_manifest_path).expect(\"read edit package.json\"),","-    )","-    .expect(\"parse edit package.json\");","-    manifest","-        .as_object_mut()","-        .unwrap()","-        .remove(\"dependencies\");","-    fs::write(&edit_manifest_path