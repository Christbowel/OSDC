  .sign(algorithm)","+","+    fun jwksJson(): String {","+        val encoder = Base64.getUrlEncoder().withoutPadding()","+        val modulus = encoder.encodeToString(","+            publicKey.modulus.toByteArray().dropWhile {","+                it == 0.toByte()","+            }.toByteArray()","+        )","+        val exponent = encoder.encodeToString(publicKey.publicExponent.toByteArray())","+        return \"\"\"{\"keys\":[{\"kty\":\"RSA\",\"alg\":\"RS256\",\"use\":\"sig\",\"kid\":\"$KEY_ID\",\"n\":\"$modulus\",\"e\":\"$exponent\"}]}\"\"\"","+    }","+","+    private companion object {","+        private const val KEY_ID = \"test-jwks-key\"","+    }","+}","+","+/**","+ * Serves [keys] at `/.well-known/jwks.json` over real HTTP, so that verifiers which build their own","+ * `UrlJwkProvider` from an issuer URL can be tested. The [block] receives the issuer URL of the server.","+ */","+internal fun withJwksServer(","+    keys: JwksTestKeys,","+    block: suspend (issuer: String) -> Unit,","+) = runTest {","+    val port = ServerSocket(0).use { it.localPort }","+    val server = embeddedServer(CIO, port = port) {","+        routing {","+            get(\"/.well-known/jwks.json\") {","+                call.respondText(keys.jwksJson(), ContentType.Application.Json)","+            }","+        }","+    }.start(wait = false)","+","+    try {","+        block(\"http://127.0.0.1:$port/\")","+    } finally {","+        server.stopSuspend(gracePeriodMillis = 10, timeoutMillis = 10)","+    }","+}"],"additions":73,"deletions":0,"truncated":false},{"path":"ktor-server/ktor-server-plugins/ktor-server-auth-jwt/jvm/test/io/ktor/server/auth/jwt/TypedJwtAuthTest.kt","lines":["@@ -144,6 +144,43 @@ class TypedJwtAuthTest {","         assertEquals(\"route:InvalidCredentials\", routeResponse.bodyAsText())","     }"," ","+    @Test","+    fun `issuer-only JWK verifier rejects token from a different issuer`() = withJwksServer(jwksKeys) { jwksIssuer ->","+        runTestApplication {","+            val scheme = jwt<JwtUser>(\"typed-jwk\") {","+                verifier(jwksIssuer)","+                validate { credential ->","+                    if (credential.audience.contains(AUDIENCE)) {","+                        JwtUser(credential.payload.subject)","+                    } else {","+                        null","+                    }","+                }","+            }","+","+            routing {","+                authenticateWith(scheme) {","+                    get(\"/profile\") {","+                        call.respondText(call.principal.name)","+                    }","+                }","+            }","+","+            val ok = client.get(\"/profile\") {","+                header(HttpHeaders.Authorization, \"Bearer \" + jwksKeys.token(jwksIssuer, AUDIENCE, subject = \"alice\"))","+            }","+            assertEquals(HttpStatusCode.OK, ok.status)","+            assertEquals(\"alice\", ok.bodyAsText())","+","+            val foreign = client.get(\"/profile\") {","+                header(HttpHeaders.Authorization, \"Bearer \" + jwksKeys.token(\"https://other-issuer/\", AUDIENCE))","+            }","+            assertEquals(HttpStatusCode.Unauthorized, foreign.status)","+        }","+    }","+","+    private val jwksKeys = JwksTestKeys()","+","     private data class JwtUser(val name: String)"," ","     private fun token(",""],"additions":37,"deletions":0,"truncated":false}],"additions":159,"deletions":19,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-25T18:25:20.410090+00:00"}