= 0);","+\t\t\t\tREQUIRE(tokens[0].length == literal.size());","+\t\t\t\tREQUIRE_FALSE(tokens[0].unterminated);","+\t\t\t\tREQUIRE(tokens[1].text == \"42\");","+\t\t\t\tREQUIRE(tokens[1].offset == literal.size() + 1);","+\t\t\t\tREQUIRE(tokens[2].type == terminator);","+\t\t\t}","+\t\t\t{","+\t\t\t\tauto sql = \"'\" + padding + \"\\\\'b' 42\";","+\t\t\t\tvector<MatcherToken> tokens;","+\t\t\t\tTerminatorTokenizerBehavior behavior(sql, tokens, autocomplete);","+\t\t\t\tREQUIRE(escaped_tokenizer.TokenizeInput(behavior) == autocomplete);","+\t\t\t\tREQUIRE(tokens.size() == 3);","+\t\t\t\tREQUIRE(tokens[0].text == sql.substr(0, sql.size() - 3));","+\t\t\t\tREQUIRE(tokens[1].text == \"42\");","+\t\t\t\tREQUIRE(tokens.back().type == terminator);","+\t\t\t}","+\t\t\t{","+\t\t\t\tauto sql = \"1 /*\" + padding + \"/*nested*/\" + padding + \"*/\\n2 \";","+\t\t\t\tvector<MatcherToken> tokens;","+\t\t\t\tTerminatorTokenizerBehavior behavior(sql, tokens, autocomplete);","+\t\t\t\tREQUIRE(tokenizer.TokenizeInput(behavior) == autocomplete);","+\t\t\t\tREQUIRE(tokens.size() == 3);","+\t\t\t\tREQUIRE(tokens[0].text == \"1\");","+\t\t\t\tREQUIRE(tokens[1].text == \"2\");","+\t\t\t\tREQUIRE(tokens[1].preceded_by_newline);","+\t\t\t\tREQUIRE(tokens[1].preceded_by_block_comment);","+\t\t\t\tREQUIRE(tokens.back().type == terminator);","+\t\t\t}","+\t\t\tfor (auto &ending : {\"\", \"\\n\", \"\\r\"}) {","+\t\t\t\tauto sql = \"--\" + padding + ending;","+\t\t\t\tvector<MatcherToken> tokens;","+\t\t\t\tTerminatorTokenizerBehavior behavior(sql, tokens, autocomplete);","+\t\t\t\tbool clean = ending[0] != '\\0';","+\t\t\t\tREQUIRE(tokenizer.TokenizeInput(behavior) == (clean && autocomplete));","+\t\t\t\tREQUIRE(tokens.size() == 1);","+\t\t\t\tREQUIRE(tokens.back().type == (clean ? terminator : TokenType::END_OF_INPUT));","+\t\t\t}","+\t\t\tfor (auto &sql : {\"/*\" + padding, \"$tag$\" + padding + \"$ta\"}) {","+\t\t\t\tvector<MatcherToken> tokens;","+\t\t\t\tTerminatorTokenizerBehavior behavior(sql, tokens, autocomplete);","+\t\t\t\tREQUIRE_FALSE(tokenizer.TokenizeInput(behavior));","+\t\t\t\tREQUIRE(tokens.back().type == TokenType::END_OF_INPUT);","+\t\t\t}","+\t\t\t{","+\t\t\t\tauto sql = \"'\" + padding;","+\t\t\t\tvector<MatcherToken> tokens;","+\t\t\t\tTerminatorTokenizerBehavior behavior(sql, tokens, autocomplete);","+\t\t\t\tREQUIRE(tokenizer.TokenizeInput(behavior) == autocomplete);","+\t\t\t\tREQUIRE(tokens.size() == 2);","+\t\t\t\tREQUIRE(tokens[0].text == sql);","+\t\t\t\tREQUIRE(tokens[0].unterminated);","+\t\t\t\tREQUIRE(tokens.back().type == terminator);","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":87,"deletions":0,"truncated":false},{"path":"test/api/test_grammar_extension.cpp","lines":["@@ -345,6 +345,23 @@ TEST_CASE(\"Grammar literal IDs include category-only words and overlapping categ"," \tREQUIRE_FALSE(table.Lookup(\"missing\").IsKeyword());"," }"," ","+TEST_CASE(\"Literal lookup preserves long grammar literals and category-only words\", \"[api][grammar_extension]\") {","+\tauto literal = string(256, 'a');","+\tauto keyword = string(512, 'b');","+\tauto grammar = ParsedGrammar::Parse(\"LiteralTest <- '\" + literal + \"'\");","+\tconst auto flag = keyword_categories_t::CreateCategory(6);","+\tcase_insensitive_map_t<LiteralInfo> keywords;","+\tkeywords.emplace(keyword, LiteralInfo(0, flag));","+\tGrammarLiteralTable table(grammar, keywords);","+\tREQUIRE(table.Lookup(literal).LiteralId() != 0);","+\tREQUIRE(table.Lookup(StringUtil::Upper(literal)) == table.Lookup(literal));","+\tREQUIRE(table.Lookup(keyword).HasAnyFlags(flag));","+\tREQUIRE(table.Lookup(StringUtil::Upper(keyword)) == table.Lookup(keyword));","+\tREQUIRE(table.Lookup(keyword + \"b\") == LiteralInfo());","+\tREQUIRE(table.Lookup(string(512, 'c')) == LiteralInfo());","+\tREQUIRE(table.Lookup(string(65536, 'a')) == LiteralInfo());","+}","+"," TEST_CASE(\"Grammar literal tables preserve dialect-defined flags\", \"[api][grammar_extension]\") {"," \tauto grammar = ParsedGramma