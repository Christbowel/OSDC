so Admin equals Edit. The trash folder-admin","+// check is handled in the mapper via a set_permissions -> folders:admin route, not a granted action.","+var NotebookViewActions = []string{notebooks.ActionNotebooksRead}","+var NotebookEditActions = append(NotebookViewActions, []string{","+\tnotebooks.ActionNotebooksWrite,","+\tnotebooks.ActionNotebooksDelete,","+}...)","+var NotebookAdminActions = NotebookEditActions"],"additions":17,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/resourcepermissions/service.go","lines":["@@ -27,6 +27,7 @@ import ("," \t\"github.com/grafana/grafana/pkg/services/featuremgmt\""," \t\"github.com/grafana/grafana/pkg/services/folder\""," \t\"github.com/grafana/grafana/pkg/services/licensing\"","+\t\"github.com/grafana/grafana/pkg/services/notebooks\""," \t\"github.com/grafana/grafana/pkg/services/org\""," \t\"github.com/grafana/grafana/pkg/services/pluginsintegration/pluginaccesscontrol\""," \t\"github.com/grafana/grafana/pkg/services/serviceaccounts\"","@@ -870,6 +871,7 @@ func (a *ActionSetSvc) RegisterActionSets(ctx context.Context, pluginID string,"," "," func isActionSetEnabledResource(action string) bool {"," \treturn strings.HasPrefix(action, dashboards.ScopeDashboardsRoot) ||","+\t\tstrings.HasPrefix(action, notebooks.ScopeNotebooksRoot) ||"," \t\tstrings.HasPrefix(action, folder.ScopeFoldersRoot) ||"," \t\tstrings.HasPrefix(action, accesscontrol.AlertingRoutesKind) ||"," \t\tstrings.HasPrefix(action, serviceaccounts.ScopeServiceAccountRoot) ||"],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/resourcepermissions/service_test.go","lines":["@@ -29,6 +29,7 @@ import ("," \t\"github.com/grafana/grafana/pkg/services/datasources\""," \t\"github.com/grafana/grafana/pkg/services/featuremgmt\""," \t\"github.com/grafana/grafana/pkg/services/licensing/licensingtest\"","+\t\"github.com/grafana/grafana/pkg/services/notebooks\""," \t\"github.com/grafana/grafana/pkg/services/org/orgimpl\""," \t\"github.com/grafana/grafana/pkg/services/quota/quotatest\""," \t\"github.com/grafana/grafana/pkg/services/serviceaccounts\"","@@ -835,6 +836,14 @@ func TestIsActionSetEnabledResource_ServiceAccount(t *testing.T) {"," \t})"," }"," ","+func TestIsActionSetEnabledResource_Notebook(t *testing.T) {","+\tt.Run(\"notebooks actions are enabled\", func(t *testing.T) {","+\t\tassert.True(t, isActionSetEnabledResource(notebooks.ScopeNotebooksRoot+\":view\"))","+\t\tassert.True(t, isActionSetEnabledResource(notebooks.ScopeNotebooksRoot+\":edit\"))","+\t\tassert.True(t, isActionSetEnabledResource(notebooks.ScopeNotebooksRoot+\":admin\"))","+\t})","+}","+"," func setupTestEnvironment(t *testing.T, ops Options) (*Service, user.Service, team.Service) {"," \tt.Helper()"," \tservice, userSvc, teamSvc, _ := setupTestEnvironmentWithCfg(t, ops, featuremgmt.WithFeatures())"],"additions":9,"deletions":0,"truncated":false},{"path":"pkg/services/authz/rbac/mapper.go","lines":["@@ -174,6 +174,47 @@ func newDashboardTranslation() translation {"," \treturn dashTranslation"," }"," ","+// newNotebookTranslation creates a translation for notebooks. Notebooks have their own","+// notebooks:* actions and a notebooks:uid: scope, but are folder-scoped like dashboards, so","+// their verbs map onto the folder action sets (folders:view/edit/admin) and folder grants","+// cover them. The notebooks:view/edit/admin object action sets (for per-notebook sharing) are","+// added later together with the notebook resource-permission service.","+func newNotebookTranslation() translation {","+\tnbTranslation := newResourceTranslation(\"notebooks\", \"uid\", true, nil)","+","+\tactionSetMapping := make(map[string][]string)","+\tfor verb, rbacAction := range nbTranslation.verbMapping {","+\t\tvar actionSets []string","+","+\t\t// Notebook creation is only part of the folder action sets, so handle it separately.","+\t\tif rbacAction == \"notebooks:create\" {","+\t\t\tactionSets = append(actionSets, \"folders:edit\")","+\t\t\tactionSets = append(actionSets, \"folders:admin\")","+\t\t}","+\t\t// The permission verbs come from the default translation. set_permissions is never a granted","+\t\t// notebook action (no per-notebook permissions management) — it's mapped to folders:admin only","+\t\t// so the trash folder-admin check (TrashAuthorizer.FolderAdmin) resolves. get_permissions","+\t\t// falls through with no action set (nothing reads a notebook's permission list), so it's denied.","+\t\tif rbacAction == \"notebooks.permissions:write\" {","+\t\t\tactionSets = append(actionSets, \"folders:admin\")","+\t\t}","+","+\t\tif slices.Contains(ossaccesscontrol.NotebookViewActions, rbacAction) {","+\t\t\tactionSets = append(actionSets, \"folders:view\")","+\t\t}","+\t\tif slices.Contains(ossaccesscontrol.NotebookEditActions, rbacAction) {","+\t\t\tactionSets = append(actionSets, \"folders:edit\")","+\t\t}","+\t\tif slices.Contains(ossaccesscontrol.NotebookAdminActions, rbacAction) {","+\t\t\tactionSets = append(actionSets, \"folders:admin\")","+\t\t}","+\t\tactionSetMapping[verb] = actionSets","+\t}","+","+\tnbTranslation.actionSetMapping = actionSetMapping","+\treturn nbTranslation","+}","+"," // newFolderTranslation creates a translation for folders and also maps the actions to action sets"," func newFolderTranslation() translation {"," \tfolderTranslation := newResourceTranslation(\"folders\", \"uid\", true, nil)","@@ -418,6 +459,7 @@ func NewMapperRegistry() MapperRegistry {"," \t\t},"," \t\t\"dashboard.grafana.app\": {"," \t\t\t\"dashboards\":    newDashboardTranslation(),","+\t\t\t\"notebooks\":     newNotebookTranslation(),"," \t\t\t\"librarypanels\": newResourceTranslation(\"library.panels\", \"uid\", true, nil),"," \t\t\t// Annotations subresource for dashboards"," \t\t\t// Uses dashboard scope (dashboards:uid:...) but annotation actions"],"additions":42,"deletions":0,"truncated":false},{"path":"pkg/services/authz/rbac/mapper_test.go","lines":["@@ -259,6 +259,50 @@ func TestMapper_ServiceAccountTranslation_ActionSets(t *testing.T) {"," \t}"," }"," ","+// TestMapperRegistry_Notebooks verifies notebooks have their own notebooks:* actions and a","+// notebooks:uid: scope, and — being folder-scoped like dashboards — map their verbs onto the","+// folder action sets so folder grants cover them.","+func TestMapperRegistry_Notebooks(t *testing.T) {","+\treg := NewMapperRegistry()","+\tmapping, ok := reg.Get(\"dashboard.grafana.app\", \"notebooks\", \"\")","+\trequire.True(t, ok)","+\trequire.NotNil(t, mapping)","+","+\t// Dedicated notebook actions per verb.","+\tfor verb, want := range map[string]string{","+\t\tutils.VerbGet:              \"notebooks:read\",","+\t\tutils.VerbList:             \"notebooks:read\",","+\t\tutils.VerbWatch:            \"notebooks:read\",","+\t\tutils.VerbCreate:           \"notebooks:create\",","+\t\tutils.VerbUpdate:           \"notebooks:write\",","+\t\tutils.VerbPatch:            \"notebooks:write\",","+\t\tutils.VerbDelete:           \"notebooks:delete\",","+\t\tutils.VerbDeleteCollection: \"notebooks:delete\",","+\t} {","+\t\taction, ok := mapping.Action(verb)","+\t\trequire.True(t, ok, \"verb %q should map to an action\", verb)","+\t\tassert.Equal(t, want, action, \"verb %q\", verb)","+\t}","+","+\t// Verbs map onto the folder action sets (read via all three, write/delete/create via edit+admin)","+\t// so folder view/edit/admin grants cover notebooks.","+\tassert.ElementsMatch(t, []string{\"folders:view\", \"folders:edit\", \"folders:admin\"}, mapping.ActionSets(utils.VerbGet))","+\tassert.ElementsMatch(t, []string{\"folders:edit\", \"folders:admin\"}, mapping.ActionSets(utils.VerbCreate))","+\tassert.ElementsMatch(t, []string{\"folders:edit\", \"folders:admin\"}, mapping.ActionSets(utils.VerbDelete))","+\tassert.True(t, mapping.HasFolderSupport())","+","+\t// set_permissions must resolve (to folders:admin) — the trash folder-admin check authorizes","+\t// via this verb, so an unsupported verb here would break trash listing for folder admins.","+\tsetPerms, ok := mapping.Action(utils.VerbSetPermissions)","+\trequire.True(t, ok)","+\tassert.Equal(t, \"notebooks.permissions:write\", setPerms)","+\tassert.ElementsMatch(t, []string{\"folders:admin\"}, mapping.ActionSets(utils.VerbSetPermissions))","+","+\t// Object scope stays in the notebook's own namespace.","+\tassert.Equal(t, \"notebooks:uid:\", mapping.Prefix())","+\tassert.Equal(t, \"notebooks:uid:nb1\", mapping.Scope(\"nb1\"))","+}","+"," // TestMapperRegistry_AlertRules verifies the rules.alerting.grafana.app rule"," // resources map to the alert.rules:* actions, support folder inheritance, use a"," // rules-specific direct-scope prefix (so the per-object check never spuriously"],"additions":44,"deletions":0,"truncated":false},{"path":"pkg/services/authz/rbac/service_test.go","lines":["@@ -242,6 +242,97 @@ func TestService_checkPermission(t *testing.T) {"," \t\t\t},"," \t\t\texpected: false,"," \t\t},","+\t\t{","+\t\t\tname: \"should allow reading a notebook via a folder permission\",","+\t\t\tpermissions: []accesscontrol.Permission{","+\t\t\t\t{","+\t\t\t\t\tScope:      \"folders:uid:parent\",","+\t\t\t\t\tKind:       \"folders\",","+\t\t\t\t\tAttribute:  \"uid\",","+\t\t\t\t\tIdentifier: \"parent\",","+\t\t\t\t},","+\t\t\t},","+\t\t\tfolders: []store.Folder{","+\t\t\t\t{UID: \"parent\"},","+\t\t\t\t{UID: \"child\", ParentUID: new(\"parent\")},","+\t\t\t},","+\t\t\tcheck: checkRequest{","+\t\t\t\tAction:       \"notebooks:read\",","+\t\t\t\tGroup:        \"dashboard.grafana.app\",","+\t\t\t\tResource:     \"notebooks\",","+\t\t\t\tName:         \"some_notebook\",","+\t\t\t\tParentFolder: \"child\",","+\t\t\t},","+\t\t\texpected: true,","+\t\t},","+\t\t{","+\t\t\tname: \"should deny reading a notebook when the folder permission is on an unrelated folder\",","+\t\t\tpermissions: []accesscontrol.Permission{","+\t\t\t\t{","+\t\t\t\t\tScope:      \"folders:uid:other\",","+\t\t\t\t\tKind:       \"folders\",","+\t