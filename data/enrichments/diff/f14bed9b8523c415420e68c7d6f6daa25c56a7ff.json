: The policies to consult, in order. At least one.","     \"\"\"","@@ -427,5 +429,6 @@ def evaluate(","             if trail:","                 reason = f\"{reason} (after {'; '.join(trail)})\"","             return RetryDecision(action=decision.action, retry_delay=decision.retry_delay, reason=reason)","-        # The worker logs this reason as the policy decision; it is not stored, since nothing is retried by it.","+        # The worker logs this reason as the policy decision; it is not stored, since no policy","+        # took a position.","         return RetryDecision(action=RetryAction.DEFAULT, reason=f\"no policy decided ({'; '.join(trail)})\")"],"additions":6,"deletions":3,"truncated":false},{"path":"task-sdk/src/airflow/sdk/execution_time/comms.py","lines":["@@ -869,6 +869,7 @@ class TaskState(BaseModel):","     end_date: datetime | None = None","     type: Literal[\"TaskState\"] = \"TaskState\"","     rendered_map_index: str | None = None","+    retry_reason: str | None = None"," "," "," class SucceedTask(TISuccessStatePayload):"],"additions":1,"deletions":0,"truncated":false},{"path":"task-sdk/src/airflow/sdk/execution_time/schema/schema.json","lines":["@@ -4213,6 +4213,18 @@","           ],","           \"default\": null,","           \"title\": \"Rendered Map Index\"","+        },","+        \"retry_reason\": {","+          \"anyOf\": [","+            {","+              \"type\": \"string\"","+            },","+            {","+              \"type\": \"null\"","+            }","+          ],","+          \"default\": null,","+          \"title\": \"Retry Reason\"","         }","       },","       \"required\": ["],"additions":12,"deletions":0,"truncated":false},{"path":"task-sdk/src/airflow/sdk/execution_time/schema/versions/__init__.py","lines":["@@ -39,11 +39,12 @@ def get_bundle() -> VersionBundle:"," ","     from airflow.sdk.execution_time.schema.versions.v2026_10_30 import (","         AddArgBindingsToSupervisorTIRunContext,","+        AddRetryRea