state.inner.osv_index.as_ref());","+    let bytes = serde_json::to_vec(&tags).expect(\"dist-tags object serializes\");","+    Response::builder()","+        .status(StatusCode::OK)","+        .header(header::CONTENT_TYPE, \"application/json\")","+        .body(Body::from(bytes))","+        .expect(\"static-shape response always builds\")","+}","+","+fn validate_dist_tag(tag: &str) -> Result<(), RegistryError> {","+    if tag.is_empty()","+        || tag","+            .chars()","+            .any(|character| character.is_control() || character.is_whitespace())","+    {","+        return Err(RegistryError::BadRequest { reason: \"invalid dist-tag name\".to_string() });","+    }","+    Ok(())","+}","+","+/// `PUT /-/package/:pkg/dist-tags/:tag` (path-less) or","+/// `PUT /~<name>/-/package/:pkg/dist-tags/:tag` — set a dist-tag. Body is","+/// a JSON-encoded version string (e.g. `\"1.0.0\"`).","+pub(crate) async fn set_dist_tag(","+    state: &AppState,","+    identity: &Identity,","+    registry: Option<&str>,","+    raw_name: &str,","+    tag: &str,","+    body: &[u8],","+) -> Response {","+    if let Err(err) = validate_dist_tag(tag) {","+        return err.into_response();","+    }","+    let mut captured_version = None;","+    let (res, source) = update_dist_tag(state, identity, registry, raw_name, tag, |tags| {","+        let version: String = serde_json::from_slice(body).map_err(RegistryError::Json)?;","+        captured_version = Some(version.clone());","+        tags.insert(tag.to_string(), Value::String(version));","+        Ok(())","+    })","+    .await;","+    if let Some(source) = &source {","+        let actor = identity.username().unwrap_or(\"-\");","+        let version_display = captured_version.as_deref().unwrap_or(\"-\");","+        tracing::info!(","+            target: \"pnpr::audit\",","+            action = \"package.dist_tag_set\",","+            actor = %actor,","+            package = %raw_name,","+            tag = %tag,","+            versio