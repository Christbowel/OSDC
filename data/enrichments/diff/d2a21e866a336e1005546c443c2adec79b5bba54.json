 'zod';","+import supportRequests, { type SupportRequest } from '../../services/support-requests';","+","+const requiredText = (max: number) => z.string().trim().min(1).max(max);","+const optionalText = (max: number) => z.string().trim().min(1).max(max).nullable().optional();","+const optionalUrl = z","+  .url({ protocol: /^https?$/ })","+  .max(2048)","+  .nullable()","+  .optional();","+","+const SupportRequestInput = z","+  .object({","+    name: requiredText(191),","+    email: z.email().max(191),","+    subject: requiredText(255),","+    message: requiredText(10_000),","+    source: z","+      .string()","+      .regex(/^[a-z0-9]+(?:[-_][a-z0-9]+)*$/)","+      .max(50)","+      .nullable()","+      .optional(),","+    page_url: optionalUrl,","+    conversation_url: optionalUrl,","+    transcript: optionalText(100_000),","+  })","+  .strict();","+","+const SupportRequestBody = z.object({","+  support_requests: z.tuple([SupportRequestInput]),","+});","+","+type AddFrame = Frame<{ data: { support_requests: unknown } }>;","+","+function parseSupportRequest(frame: AddFrame) {","+  const result = SupportRequestBody.safeParse(frame.data);","+","+  if (!result.success) {","+    const [issue] = result.error.issues;","+    const field = issue.path.slice(2).join('.');","+","+    throw new errors.ValidationError({","+      message: field ? `Invalid ${field}: ${issue.message}` : 'Invalid support request',","+    });","+  }","+","+  return result.data.support_requests[0];","+}","+","+function requester(frame: AddFrame): { id: string; email: string } {","+  const user = frame.user;","+","+  if (user && typeof user === 'object' && 'get' in user && typeof user.get === 'function') {","+    const id: unknown = user.get('id');","+    const email: unknown = user.get('email');","+","+    if (typeof id === 'string' && typeof email === 'string') {","+      return { id, email };","+    }","+  }","+","+  throw new errors.NoPermissionError({","+    message: 'Support requests can only be sent by a staff user',","+  });","+}","+","+function toSupportRequest(","+  input: z.infer<typeof SupportRequestInput>,","+  staffUser: { id: string; email: string },","+): SupportRequest {","+  return {","+    requestedByUserId: staffUser.id,","+    requestedByEmail: staffUser.email,","+    name: input.name,","+    email: input.email,","+    subject: input.subject,","+    message: input.message,","+    source: input.source ?? null,","+    pageUrl: input.page_url ?? null,","+    conversationUrl: input.conversation_url ?? null,","+    transcript: input.transcript ?? null,","+  };","+}","+","+const controller = {","+  docName: 'support_requests',","+","+  add: {","+    statusCode: 202,","+    headers: {","+      cacheInvalidate: false,","+    },","+    validation(frame: AddFrame) {","+      parseSupportRequest(frame);","+    },","+    permissions: false,","+    async query(frame: AddFrame) {","+      await supportRequests.service.send(","+        toSupportRequest(parseSupportRequest(frame), requester(frame)),","+      );","+    },","+  },","+} satisfies Controller<{ add: AddFrame }>;","+","+export default controller;","+","+module.exports = controller;"],"additions":110,"deletions":0,"truncated":false},{"path":"ghost/core/server/api/endpoints/utils/public-config/config.js","lines":["@@ -14,7 +14,11 @@ const sanitizeHostSettings = (hostSettings) => {","     return hostSettings;","   }"," ","-  return omit(hostSettings, ['export.webhookSecret', 'emailVerification.webhookSecret']);","+  return omit(hostSettings, [","+    'export.webhookSecret',","+    'emailVerification.webhookSecret',","+    'supportRequest.webhookSecret',","+  ]);"," };"," "," const copyPayloadProperties = (target, source, properties) => {"],"additions":5,"deletions":1,"truncated":false},{"path":"ghost/core/server/lib/signed-webhook.ts","lines":["@@ -33,6 +33,32 @@ export function sanitizeWebhookUrl(webhookUrl: string): string {","   }"," }"," ","+/**","+ * Describes a failed delivery for logs without using the error's message,","+ * which the HTTP client fills with the full request URL.","+ */","+export function describeWebhookError(error: unknown): string {","+  if (typeof error !== 'object' || error === null) {","+    return 'unknown error';","+  }","+","+  const response = 'response' in error ? error.response : undefined;","+  if (","+    typeof response === 'object' &&","+    response !== null &&","+    'statusCode' in response &&","+    typeof response.statusCode === 'number'","+  ) {","+    return `HTTP ${response.statusCode}`;","+  }","+","+  if ('code' in error && typeof error.code === 'string') {","+    return error.code;","+  }","+","+  return 'unknown error';","+}","+"," /**","  * Builds the request options for a signed host webhook delivery. When no","  * secret is configured the payload is sent unsigned (the receiver decides"],"additions":26,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/export-requests/export-requests-service.ts","lines":["@@ -1,4 +1,8 @@","-import { buildSignedWebhookRequest, sanitizeWebhookUrl } from '../../lib/signed-webhook';","+import {","+  buildSignedWebhookRequest,","+  describeWebhookError,","+  sanitizeWebhookUrl,","+} from '../../lib/signed-webhook';"," import type { ASYNC_EXPORT_COMPONENTS } from '../../data/exporter/export-components';"," "," type AsyncExportComponents = Record<(typeof ASYNC_EXPORT_COMPONENTS)[number], boolean>;","@@ -112,7 +116,7 @@ export class ExportRequestsService {","     try {","       await this.#request(webhookUrl, requestOptions);","     } catch (error) {","-      const message = error instanceof Error ? error.message : String(error);","+      const message = describeWebhookError(error);","       this.#logging.error(`Failed to request export generation from \"${sanitizedUrl}\": ${message}`);","       throw new errors.InternalServerError({","         statusCode: 502,"],"additions":6,"deletions":2,"truncated":false},{"path":"ghost/core/server/services/service-inventory.yaml","lines":["@@ -13912,6 +13912,84 @@ services:","       - resources","       - failures","     blockers: []","+  support-requests:","+    kind: directory","+    disposition: retain","+    status: auditing","+    migrated: true","+    migration:","+      complexity: straightforward","+      modelImpact: fits","+      reason: >-","+        Added with the initializer: init composes one resource-free instance from config,","+        logging and the request transport. Configuration, signing and delivery happen per","+        request, mirroring export requests, so there is no startup work or cleanup.","+      reviewedAt: c538745fe27d8782fc3a6d847bb626d2b6ff130e","+      sources:","+        - core/server/services/support-requests/index.ts","+        - core/server/services/support-requests/support-requests-service.ts","+        - core/server/api/endpoints/support-requests.ts","+        - core/boot.js","+    entryPoints:","+      - support-requests/index.ts","+    notes: >-","+      Composition-only service that forwards a staff user's support request to the host as a","+      signed webhook. Root-level tests for init, identity and boot ordering are still to be","+      added.","+    contracts:","+      exports:","+        summary: >-","+          The root default-exports the shared initializer with async init and a guarded service","+          getter exposing SupportRequestsService, and re-exports the SupportRequest type.","+          send requires its receiver and resolves undefined after delivery; it does not inspect","+          the response body.","+        sources:","+          - core/server/services/support-requests/index.ts","+          - core/server/services/support-requests/support-requests-service.ts","+        tests:","+          - test/unit/server/services/support-requests/support-requests-service.test.ts","+          - test/e2e-api/admin/support-requests.test.ts","+      construction:","+        summary: >-","+          The factory constructs the service with shared config, logging and @tryghost/request","+          and performs no reads or delivery. Boot awaits init during core startup, after","+          Export Requests. POST /support_requests is the only runtime consumer.","+        sources:","+          - core/server/services/support-requests/index.ts","+          - core/server/api/endpoints/support-requests.ts","+          - core/boot.js","+        tests:","+          - test/e2e-api/admin/support-requests.test.ts","+      configuration:","+        summary: >-","+          hostSettings:supportRequest:webhookUrl, webhookSecret and hostSettings:siteId are read","+          on every send, not at construction. A missing URL is a NotFoundError; a missing secret","+          or site ID is logged and rejected as IncorrectUsageError before any delivery. The","+          secret is omitted from the public config endpoint.","+        sources:","+          - core/server/services/support-requests/support-requests-service.ts","+          - core/server/api/endpoints/utils/public-config/config.js","+        tests:","+          - test/unit/server/services/support-requests/support-requests-service.test.ts","+          - test/unit/server/api/endpoints/utils/public-config/config.test.js","+          - test/e2e-api/admin/support-requests.test.ts","+      failures:","+        summary: >-","+          Delivery uses no retries because a repeated delivery would duplicate the support","+          request. A transport","+          failure is logged with the URL reduced to its origin and surfaces as a generic 502.","+        sources:","+          - core/server/services/support-requests/support-requests-service.ts","+          - core/server/lib/signed-webhook.ts","+        tests:","+          - test/unit/server/services/support-requests/support-requests-service.test.ts","+          - test/e2e-api/admin/support-requests.test.ts","+    unverified:","+      - consumers","+      - startup","+      - lifetime","+      - resources","+    blockers: []","   tags-public:","     kind: directory","     disposition: relocate"],"additions":78,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/support-requests/index.ts","lines":["@@ -0,0 +1,12 @@","+import { defineService } from '../../../kernel/define-service';","+import { SupportRequestsService } from './support-requests-service';","+","+export type { SupportRequest } from './support-requests-service';","+","+export default defineService('Support Requests', () => {","+  const config = require('../../../shared/config');","+  const logging = require('@tryghost/logging');","+  const request = require('@tryghost/request');","+","+  return new SupportRequestsService({ config, logging, request });","+});"],"additions":12,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/support-requests/support-requests-service.ts","lines":["@@ -0,0 +1,126 @@","+import {","+  buildSignedWebhookRequest,","+  describeWebhookError,","+  sanitizeWebhookUrl,","+} from '../../lib/signed-webhook';","+const errors = require('@tryghost/errors');","+","+export interface SupportRequest {","+  requestedByUserId: string;","+  requestedByEmail: string;","+  name: string;","+  email: string;","+  subject: string;","+  message: string;","+  source: string | null;","+  pageUrl: string | null;","+  conversationUrl: string | null;","+  transcript: string | null;","+}","+","+interface SupportRequestBody extends SupportRequest {","+  type: 'support_request';","+  siteId: string;","+}","+","+interface SupportRequestsServiceDependencies {","+  config: {","+    get: (key: string) => unknown;","+  };","+  logging: {","+    info: (message: string) => void;","+    error: (message: string) => void;","+  };","+  request: (url: string, options: ReturnType<typeof buildSignedWebhookRequest>) => Promise<unknown>;","+}","+","+export class SupportRequestsService {","+  #config: SupportRequestsServiceDependencies['config'];","+  #logging: SupportRequestsServiceDependencies['logging'];","+  #request: SupportRequestsServiceDependencies['request'];","+","+  constructor(dependencies: SupportRequestsServiceDependencies) {","+    this.#config = dependencies.config;","+    this.#logging = dependencies.logging;","+    this.#request = dependencies.request;","+  }","+","+  #readSupportRequestConfig() {","+    return {","+      webhookUrl: this.#config.get('hostSettings:supportRequest:webhookUrl'),","+      webhookSecret: this.#config.get('hostSettings:supportRequest:webhookSecret'),","+      siteId: this.#config.get('hostSettings:siteId'),","+    };","+  }","+","+  /**","+   * Sends a staff user's support request to the configured host service.","+   *","+   * The webhook is a shared channel that dispatches on the `type` field of","+   * the event envelope, and the receiver may acknowledge before acting on it,","+   * so a 2xx means \"delivered\", not \"the support request was handled\".","+   */","+  async send(supportRequest: SupportRequest): Promise<void> {","+    const { webhookUrl, webhookSecret, siteId } = this.#readSupportRequestConfig();","+","+    if (typeof webhookUrl !== 'string' || webhookUrl.length === 0) {","+      throw new errors.NotFoundError({","+        message: 'Support requests are not enabled on this site',","+      });","+    }","+","+    if (typeof webhookSecret !== 'string' || webhookSecret.length === 0) {","+      this.#logging.error(","+        'Support request is misconfigured: hostSettings:supportRequest:webhookSecret is missing while hostSettings:supportRequest:webhookUrl is set.',","+      );","+","+      throw new errors.IncorrectUsageError({","+        message: 'Support requests are not configured correctly on this site',","+      });","+    }","+","+    const normalizedSiteId =","+      typeof siteId === 'string' ? siteId : typeof siteId === 'number' ? String(siteId) : '';","+","+    if (normalizedSiteId.length === 0) {","+      this.#logging.error(","+        'Support request is misconfigured: hostSettings:siteId is missing while hostSettings:supportRequest:webhookUrl is set.',","+      );","+","+      throw new errors.IncorrectUsageError({","+        message: 'Support requests are not configured correctly on this site',","+      });","+    }","+","+    const payload: SupportRequestBody = {","+      type: 'support_request',","+      siteId: normalizedSiteId,","+      ...supportRequest,","+    };","+","+    const requestOptions = buildSignedWebhookRequest({","+      payload,","+      secret: webhookSecret,","+      // No retries: the request is not idempotent (a repeated delivery","+      // would duplicate the support request)","+      retryLimit: 0,","+    });","+","+    const sanitizedUrl = sanitizeWebhookUrl(webhookUrl);","+","+    this.#logging.info(`Sending support request to \"${sanitizedUrl}\"`);","+","+    try {","+      await this.#request(webhookUrl, requestOptions);","+    } catch (error) {","+      const message = describeWebhookError(error);","+","+      this.#logging.error(`Failed to send support request to \"${sanitizedUrl}\": ${message}`);","+","+      throw new errors.InternalServerError({","+        statusCode: 502,","+        message: 'Failed to send the support request. Please try again later.',","+      });","+    }","+  }","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/verification/verification-webhook-service.ts","lines":["@@ -1,4 +1,8 @@","-import { buildSignedWebhookRequest, sanitizeWebhookUrl } from '../../lib/signed-webhook';","+import {","+  buildSignedWebhookRequest,","+  describeWebhookError,","+  sanitizeWebhookUrl,","+} from '../../lib/signed-webhook';"," const logging = require('@tryghost/logging');"," const request = require('@tryghost/request');"," const config = require('../../../shared/config');","@@ -92,7 +96,7 @@ export class VerificationWebhookService {","       await this.#request(webhookUrl, requestOptions);","       return true;","     } catch (error) {","-      const message = error instanceof Error ?