39: \"2024-01-01T00:00:00Z\""],"additions":0,"deletions":19,"truncated":false},{"path":"cmd/tempo-cli/tls.go","lines":["@@ -0,0 +1,81 @@","+package main","+","+import (","+\t\"crypto/tls\"","+\t\"crypto/x509\"","+\t\"fmt\"","+\t\"net/http\"","+\t\"os\"","+","+\t\"google.golang.org/grpc\"","+\t\"google.golang.org/grpc/credentials\"","+\t\"google.golang.org/grpc/credentials/insecure\"","+)","+","+type tlsOptions struct {","+\tTLSCert       string `name:\"tls-cert\" type:\"path\" help:\"PEM client certificate file for mTLS; requires --tls-key and TLS\"`","+\tTLSKey        string `name:\"tls-key\" type:\"path\" help:\"PEM private key file for mTLS; requires --tls-cert and TLS\"`","+\tTLSCA         string `name:\"tls-ca\" type:\"path\" help:\"PEM CA certificate bundle to use instead of system trust roots; requires TLS\"`","+\tTLSServerName string `name:\"tls-server-name\" help:\"override the TLS server name for certificate verification and SNI; requires TLS\"`","+}","+","+func (o *tlsOptions) tlsConfig(secure bool) (*tls.Config, error) {","+\tif !secure {","+\t\tif o.TLSCert != \"\" || o.TLSKey != \"\" || o.TLSCA != \"\" || o.TLSServerName != \"\" {","+\t\t\treturn nil, fmt.Errorf(\"TLS options require TLS: use an https:// URL for trace-id, or --secure for other query api commands\")","+\t\t}","+\t\treturn nil, nil","+\t}","+\tif (o.TLSCert == \"\") != (o.TLSKey == \"\") {","+\t\treturn nil, fmt.Errorf(\"--tls-cert and --tls-key must be provided together\")","+\t}","+","+\tcfg := &tls.Config{","+\t\tMinVersion: tls.VersionTLS12,","+\t\tServerName: o.TLSServerName,","+\t}","+\tif o.TLSCA != \"\" {","+\t\tpem, err := os.ReadFile(o.TLSCA)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"reading CA certificate %q: %w\", o.TLSCA, err)","+\t\t}","+\t\tpool := x509.NewCertPool()","+\t\tif !pool.AppendCertsFromPEM(pem) {","+\t\t\treturn nil, fmt.Errorf(\"no valid certificates found in CA bundle %q\", o.TLSCA)","+\t\t}","+\t\tcfg.RootCAs = pool","+\t}","+\tif o.TLSCert != \"\" {","+\t\tcert, err := tls.LoadX509KeyPair(o.TLSCert, o.TLSKey)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"loading client certificate and key %q, %q: %w\", o.TLSCert, o.TLSKey, err)","+\t\t}","+\t\tcfg.Certificates = []tls.Certificate{cert}","+\t}","+\treturn cfg, nil","+}","+","+func (o *tlsOptions) httpTransport(secure bool) (*http.Transport, error) {","+\tcfg, err := o.tlsConfig(secure)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tbase, ok := http.DefaultTransport.(*http.Transport)","+\tif !ok {","+\t\treturn nil, fmt.Errorf(\"unexpected default HTTP transport type %T\", http.DefaultTransport)","+\t}","+\ttransport := base.Clone()","+\ttransport.TLSClientConfig = cfg","+\treturn transport, nil","+}","+","+func (o *tlsOptions) grpcTransportCredentials(secure bool) (grpc.DialOption, error) {","+\tcfg, err := o.tlsConfig(secure)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tif cfg == nil {","+\t\treturn grpc.WithTransportCredentials(insecure.NewCredentials()), nil","+\t}","+\treturn grpc.WithTransportCredentials(credentials.NewTLS(cfg)), nil","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"cmd/tempo-cli/tls_test.go","lines":["@@ -0,0 +1,482 @@","+package main","+","+import (","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"crypto/tls\"","+\t\"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"encoding/pem\"","+\t\"io\"","+\t\"math/big\"","+\t\"net\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/alecthomas/kong\"","+\t\"github.com/gogo/protobuf/proto\"","+\t\"github.com/grafana/tempo/v3/pkg/tempopb\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"google.golang.org/grpc\"","+\t\"google.golang.org/grpc/credentials\"","+\t\"google.golang.org/grpc/metadata\"","+\t\"google.golang.org/grpc/peer\"","+)","+","+func TestTLSOptionsValidation(t *testing.T) {","+\tinvalid := filepath.Join(t.TempDir(), \"invalid.pem\")","+\trequire.NoError(t, os.WriteFile(invalid, []byte(\"not a certificate\"), 0o600))","+\tmissing := filepath.Join(t.TempDir(), \"missing.pem\")","+","+\ttests := []struct {","+\t\tname    string","+\t\toptions tlsOptions","+\t\tsecure  bool","+\t\twantErr string","+\t}{","+\t\t{name: \"plaintext defaults\"},","+\t\t{name: \"TLS defaults\", secure: true},","+\t\t{name: \"certificate without key\", secure: true, options: tlsOptions{TLSCert: invalid}, wantErr: \"--tls-cert and --tls-key must be provided together\"},","+\t\t{name: \"key without certificate\", secure: true, options: tlsOptions{TLSKey: invalid}, wantErr: \"--tls-cert and --tls-key must be provided together\"},","+\t\t{name: \"certificate on plaintext\", options: tlsOptions{TLSCert: invalid, TLSKey: invalid}, wantErr: \"require TLS\"},","+\t\t{name: \"CA on plaintext\", options: tlsOptions{TLSCA: invalid}, wantErr: \"require TLS\"},","+\t\t{name: \"server name on plaintext\", options: tlsOptions{TLSServerName: \"tempo.example.com\"}, wantErr: \"require TLS\"},","+\t\t{name: \"missing CA\", secure: true, options: tlsOptions{TLSCA: missing}, wantErr: \"reading CA certificate\"},","+\t\t{name: \"invalid CA\", secure: true, options: tlsOptions{TLSCA: invalid}, wantErr: \"no valid certificates\"},","+\t\t{name: \"missing certificate\", secure: true, options: tlsOptions{TLSCert: missing, TLSKey: invalid}, wantErr: \"loading client certificate and key\"},","+\t\t{name: \"invalid certificate\", secure: true, options: tlsOptions{TLSCert: invalid, TLSKey: invalid}, wantErr: \"loading client certificate and key\"},","+\t\t{name: \"server name only\", secure: true, options: tlsOptions{TLSServerName: \"tempo.example.com\"}},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tcfg, err := tt.options.tlsConfig(tt.secure)","+\t\t\tif tt.wantErr != \"\" {","+\t\t\t\trequire.ErrorContains(t, err, tt.wantErr)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t\tif !tt.secure {","+\t\t\t\trequire.Nil(t, cfg)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NotNil(t, cfg)","+\t\t\trequire.False(t, cfg.InsecureSkipVerify)","+\t\t\trequire.Equal(t, tt.options.TLSServerName, cfg.ServerName)","+\t\t})","+\t}","+}","+","+type tlsTestPKI struct {","+\toptions tlsOptions","+\tserver  *tls.Config","+}","+","+// Generate short-lived certificates at test time so fixtures never expire in the repository.","+func newTLSTestPKI(t *testing.T) tlsTestPKI {","+\tt.Helper()","+\tdir := t.TempDir()","+\tissue := func(name string, template, parent *x509.Certificate, signer *ecdsa.PrivateKey) tls.Certificate {","+\t\tt.Helper()","+\t\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\t\trequire.NoError(t, err)","+\t\tif parent == nil {","+\t\t\tparent, signer = template, key","+\t\t}","+\t\ttemplate.NotBefore = time.Now().Add(-time.Hour)","+\t\ttemplate.NotAfter = time.Now().Add(time.Hour)","+\t\tder, err := x509.CreateCertificate(rand.Reader, template, parent, &key.PublicKey, signer)","+\t\trequire.NoError(t, err)","+\t\tcertPEM := pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: der})","+\t\tkeyDER, err := x509.MarshalECPrivateKey(key)","+\t\trequire.NoError(t, err)","+\t\tkeyPEM := pem.EncodeToMemory(&pem.Block{Type: \"EC PRIVATE KEY\", Bytes: keyDER})","+\t\trequire.NoError(t, os.WriteFile(filepath.Join(dir, name+\".crt\"), certPEM, 0o600))","+\t\trequire.NoError(t, os.WriteFile(filepath.Join(dir, name+\".key\"), keyPEM, 0o600))","+\t\tcert, err := tls.X509KeyPair(certPEM, keyPEM)","+\t\trequire.NoError(t, err)","+\t\tcert.Leaf, err = x509.ParseCertificate(der)","+\t\trequire.NoError(t, err)","+\t\treturn cert","+\t}","+\tca := issue(\"ca\", &x509.Certificate{","+\t\tSerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: \"tempo-cli test CA\"},","+\t\tIsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign,","+\t}, nil, nil)","+\tcaKey :=