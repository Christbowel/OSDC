      }","     }"," }"," ","+/// Diff the `--check` snapshot against the lockfile the run resolved.","+/// `resolved` is `None` when the run produced none (for example `lockfile=false`),","+/// in which case whatever is on disk is compared instead."," pub(crate) fn check_lockfile<Reporter: self::Reporter>(","     existing: Option<&str>,","-    mut guard: LockfileGuard,","+    resolved: Option<String>,","     lockfile_path: &Path,"," ) -> miette::Result<()> {","-    let current = read_lockfile_snapshot(lockfile_path)?;","-    if existing == current.as_deref() {","-        guard.disarm();","+    let current = match resolved {","+        Some(text) => Some(text),","+        None => read_lockfile_snapshot(lockfile_path)?,","+    };","+    // Ignore the BOM and CRLF line endings: they are not lockfile content, and","+    // a lockfile that differs only in them is not rewritten by an install.","+    if existing.map(normalize_lockfile_content)","+        == current.as_deref().map(normalize_lockfile_content)","+    {","         return Ok(());","     }","     let previous = parse_snapshot(existing, lockfile_path);","@@ -131,7 +138,6 @@ pub(crate) fn check_lockfile<Reporter: self::Reporter>(","         (existing, previous.as_ref()),","         (current.as_deref(), next.as_ref()),","     ) {","-        // Dropping the armed guard restores the snapshot the run rewrote.","         return Ok(());","     }","     let diff = diff_lockfiles(previous.as_ref(), next.as_ref(), ImporterDiffKey::Version);"],"additions":28,"deletions":22,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dedupe/lockfile_guard.rs","lines":["@@ -1,37 +0,0 @@","-use std::path::{Path, PathBuf};","-","-/// A drop guard for `--check` mode: restores the lockfile snapshot on drop","-/// unless [`disarm`](LockfileGuard::disarm) has been called. This way an","-/// unexpected error during deduplication still leaves the workspace in its","-/// original state.","-pub(crate) struct LockfileGuard {","-    existing