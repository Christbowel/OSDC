xisting.clone(), &lockfile_path));"," ","         let root_config = (&*self.manifest_path, &mut *self.cfg, &*self.config_root);","         prepare_root_config::<Reporter>(","@@ -43,7 +41,7 @@ impl DedupePipeline {","             false,","             false,","         )?;","-        self.run_plan::<Reporter>(plan, lockfile_path, existing, guard).await","+        self.run_plan::<Reporter>(plan, lockfile_path, existing).await","     }"," ","     pub(super) async fn run_plan<Reporter: self::Reporter + 'static>(","@@ -51,7 +49,6 @@ impl DedupePipeline {","         plan: InstallFamilyPlan,","         lockfile_path: PathBuf,","         existing: Option<String>,","-        guard: Option<dedupe::LockfileGuard>,","     ) -> miette::Result<()> {","         let cfg: &'static Config = self.cfg;","         match plan {","@@ -62,20 +59,27 @@ impl DedupePipeline {","                     *projects,","                     &lockfile_path,","                     existing,","-                    guard,","                 )","                 .await","             }","             InstallFamilyPlan::Shared(selection) => {","                 if selection.selected_dirs.is_empty() {","-                    return Ok(());","+                    if !self.args.check {","+                        return Ok(());","+                    }","+                    // Nothing was resolved, but config-dependency syncing may","+                    // have changed the lockfile.","+                    return dedupe::check_lockfile::<Reporter>(","+                        existing.as_deref(),","+                        None,","+                        &lockfile_path,","+                    );","                 }","                 let state =","                     State::init(self.manifest_path, cfg, false).wrap_err(\"initialize the state\")?;","                 Box::pin(self.args.run::<Reporter>(","                     state,","                     existing,","-                    guard,","               