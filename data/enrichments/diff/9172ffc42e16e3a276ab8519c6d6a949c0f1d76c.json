gger import init_logger"," from vllm.model_executor.layers.fused_moe.all2all_utils import (","     maybe_make_prepare_finalize,","@@ -19,6 +19,7 @@","     FusedMoEConfig,","     FusedMoEQuantConfig,"," )","+from vllm.platforms import current_platform"," "," if TYPE_CHECKING:","     from vllm.model_executor.layers.quantization.utils.quant_utils import QuantKey","@@ -60,6 +61,9 @@ class MoEKernelOracle(ABC, Generic[BackendT]):","     # out-of-tree platform for fp8, kernel-less online mxfp4): see each enum.","     placeholder_backend: BackendT"," ","+    # Oracles opt in to platform-registered experts with their own enum member.","+    oot_backend: BackendT | None = None","+","     def __init__(","         self,","         moe_config: FusedMoEConfig,","@@ -105,6 +109,59 @@ def backend_to_kernel_cls(","         \"\"\"","         raise NotImplementedError"," ","+    @classmethod","+    def get_oot_backends(cls) -> dict[str, type[mk.FusedMoEExperts]]:","+        \"\"\"Return platform registrations for an oracle that supports them.\"\"\"","+        if cls.oot_backend is None:","+            return {}","+        backends = current_platform.get_moe_backends()","+        if collisions := backends.keys() & get_args(InTreeMoEBackend):","+            raise ValueError(","+                f\"Platform MoE backends use reserved names: {sorted(collisions)}\"","+            )","+        return backends","+","+    def select_oot_backend(self) -> tuple[BackendT, type[mk.FusedMoEExperts]] | None:","+        \"\"\"Select a registered backend, or let the caller try in-tree selection.","+","+        A named registration is required to support the configuration. With","+        `auto`, try registrations in order and warn if all are rejected.","+        \"\"\"","+        backend = self.oot_backend","+        if backend is None:","+            return None","+        requested = self.moe_config.moe_backend","+        if requested != \"auto\" and requested in get_args(InTreeMoEBackend):","+            return None","+","+        backends = self.get_oot_backends()","+        if requested != \"auto\":","+            experts_cls = backends.get(requested)","+            if experts_cls is None:","+                return None","+            return self.return_or_raise(","+                backend, kernel_classes=[experts_cls], backend_name=requested","+            )","+","+        rejections = []","+        for name, experts_cls in backends.items():","+            kernel_cls, rejected = self.try_backend(","+                backend, [experts_cls], backend_name=name","+            )","+            if kernel_cls is not None:","+                logger.debug_once(self.make_log_backend(backend, backend_name=name))","+                return backend, kernel_cls","+            reason = rejected[-1][1] if rejected else None","+            rejections.append(f\"{name}: {reason or 'unsupported configuration'}\")","+        if rejections:","+            logger.warning_once(","+                \"None of the platform's MoE backends support this %s MoE \"","+                \"configuration: %s.\",","+                self.name,","+                \"; \".join(rejections),","+            )","+        return None","+","     def map_backend(self, runner_backend: MoEBackend) -> BackendT:","         \"\"\"Map a user-facing `MoEBackend` (from the runner config) to","         this oracle's enum.\"\"\"","@@ -183,6 +240,8 @@ def make_log_backend(","         backend: BackendT,","         available_backends: list[BackendT] | None = None,","         is_lora: bool = False,","+        *,","+        backend_name: str | None = None,","     ) -> str:","         \"\"\"Message for the backend a select loop settled on.\"\"\"","         available = (","@@ -191,16 +250,23 @@ def make_log_backend(","             else \"\"","         )","         lora = \"LoRA \" if is_lora else \"\"","-        return f\"Using {backend.value} {self.name} MoE {lora}backend{available}.\"","+        name = backend.value if ba