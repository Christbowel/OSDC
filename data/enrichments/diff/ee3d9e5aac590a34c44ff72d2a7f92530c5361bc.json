countTokenRegistry(t *testing.T) {","+\tg := gomega.NewGomegaWithT(t)","+\tconfigMap := &corev1.ConfigMap{Data: map[string]string{","+\t\tKernelCacheConfigName: `{","+\t\t\t\"registry\": {","+\t\t\t\t\"endpoint\": \"registry.example:5000\",","+\t\t\t\t\"insecure\": true,","+\t\t\t\t\"auth\": {","+\t\t\t\t\t\"type\": \"serviceAccountToken\",","+\t\t\t\t\t\"pushRoleRef\": {\"kind\": \"ClusterRole\", \"name\": \"registry-pusher\"},","+\t\t\t\t\t\"pullRoleRef\": {\"kind\": \"ClusterRole\", \"name\": \"registry-puller\"}","+\t\t\t\t}","+\t\t\t}","+\t\t}`,","+\t}}","+","+\t_, err := NewKernelCacheConfig(configMap)","+\tg.Expect(err).To(gomega.MatchError(\"registry.insecure cannot be used with registry.auth.type serviceAccountToken\"))","+}","+"," func TestNewKernelCacheConfigRejectsUnsupportedRegistryAuthType(t *testing.T) {"," \tg := gomega.NewGomegaWithT(t)"," \tconfigMap := &corev1.ConfigMap{Data: map[string]string{"],"additions":21,"deletions":2,"truncated":false},{"path":"pkg/kernelcache/registry/auth.go","lines":["@@ -0,0 +1,99 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package registry","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"net/http\"","+\t\"os\"","+\t\"path\"","+\t\"strings\"","+","+\t\"github.com/google/go-containerregistry/pkg/authn\"","+\t\"github.com/google/go-containerregistry/pkg/name\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+)","+","+const serviceAccountMountPath = \"/var/run/secrets/kubernetes.io/serviceaccount\"","+","+var projectedCredentialPath = path.Join(serviceAccountMountPath, \"token\")","+","+var readServiceAccountToken = os.ReadFile","+","+// RegistryAccess contains the registry connection settings used by the","+// localmodel controller for artifact signing and verification.","+type RegistryAccess struct {","+\tTransport     http.RoundTripper","+\tAuthenticator authn.Authenticator","+\tInsecure      bool","+}","+","+// NewControllerRegistryAccess builds registry connection settings for an image","+// in a workload namespace. It loads the configured CA bundle and obtains the","+// controller ServiceAccount credential when registry authentication is enabled.","+func NewControllerRegistryAccess(ctx context.Context, reader client.Reader, namespace string, config v1beta1.KernelCacheRegistryConfig, imageRef string) (RegistryAccess, error) {","+\ttransport, err := NewTransport(ctx, reader, namespace, config)","+\tif err != nil {","+\t\treturn RegistryAccess{}, err","+\t}","+\tauthenticator, err := NewControllerServiceAccountAuthenticator(config, imageRef)","+\tif err != nil {","+\t\treturn RegistryAccess{}, err","+\t}","+\treturn RegistryAccess{Transport: transport, Authenticator: authenticator, Insecure: config.Insecure}, nil","+}","+","+// NewControllerServiceAccountAuthenticator returns the controller Pod ServiceAccount token","+// for the configured registry. The token is read for each reconcile so a","+// rotated projected token is picked up without restarting the controller.","+func NewControllerServiceAccountAuthenticator(config v1beta1.KernelCacheRegistryConfig, imageRef string) (authn.Authenticator, error) {","+\tif config.Auth.Type == \"\" || config.Auth.Type == v1beta1.KernelCacheRegistryAuthTypeNone {","+\t\treturn nil, nil","+\t}","+\tif config.Auth.Type != v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken {","+\t\treturn nil, fmt.Errorf(\"unsupported registry authentication provider %q\", config.Auth.Type)","+\t}","+","+\toptions := []name.Option{}","+\tif config.Insecure {","+\t\toptions = append(options, name.Insecure)","+\t}","+\tref, err := name.ParseReference(imageRef, options...)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"parse registry image reference %q: %w\", imageRef, err)","+\t}","+\tconfigured, err := name.NewRegistry(config.Endpoint, name.StrictValidation)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"parse configured registry endpoint %q: %w\", config.Endpoint, err)","+\t}","+\tif !strings.EqualFold(ref.Context().RegistryStr(), configured.RegistryStr()) {","+\t\treturn nil, fmt.Errorf(\"registry image %q is outside configured endpoint %q\", ref.Context().RegistryStr(), configured.RegistryStr())","+\t}","+","+\ttoken, err := readServiceAccountToken(projectedCredentialPath)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"read controller ServiceAccount token: %w\", err)","+\t}","+\tif token = []byte(strings.TrimSpace(string(token))); len(token) == 0 {","+\t\treturn nil, errors.New(\"controller ServiceAccount token is empty\")","+\t}","+\treturn authn.FromConfig(authn.AuthConfig{Username: \"unused\", Password: string(token)}), nil","+}"],"additions":99,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/registry/auth_test.go","lines":["@@ -0,0 +1,93 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package registry","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client/fake\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+)","+","+func TestNewControllerServiceAccountAuthenticatorUsesProjectedToken(t *testing.T) {","+\toriginalReadServiceAccountToken := readServiceAccountToken","+\tt.Cleanup(func() { readServiceAccountToken = originalReadServiceAccountToken })","+\treadServiceAccountToken = func(string) ([]byte, error) { return []byte(\"projected-token\"), nil }","+","+\tauthenticator, err := NewControllerServiceAccountAuthenticator(serviceAccountTokenRegistryConfig(), \"registry.example:5000/team/cache@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")","+\trequire.NoError(t, err)","+\trequire.NotNil(t, authenticator)","+\tconfig, err := authenticator.Authorization()","+\trequire.NoError(t, err)","+\trequire.Equal(t, \"unused\", config.Username)","+\trequire.Equal(t, \"projected-token\", config.Password)","+}","+","+func TestNewControllerServiceAccountAuthenticatorRejectsRegistryOutsideConfiguredEndpoint(t *testing.T) {","+\tauthenticator, err := NewControllerServiceAccountAuthenticator(serviceAccountTokenRegistryConfig(), \"other.example:5000/team/cache:latest\")","+\trequire.Nil(t, authenticator)","+\trequire.ErrorContains(t, err, \"outside configured endpoint\")","+}","+","+func TestNewControllerServiceAccountAuthenticatorReturnsNoAuthForNone(t *testing.T) {","+\tconfig := serviceAccountTokenRegistryConfig()","+\tconfig.Auth.Type = v1beta1.KernelCacheRegistryAuthTypeNone","+\tauthenticator, err := NewControllerServiceAccountAuthenticator(config, \"registry.example:5000/team/cache:latest\")","+\trequire.NoError(t, err)","+\trequire.Nil(t, authenticator)","+}","+","+func TestNewControllerServiceAccountAuthenticatorReportsTokenReadFailure(t *testing.T) {","+\toriginalReadServiceAccountToken := readServiceAccountToken","+\tt.Cleanup(func() { readServiceAccountToken = originalReadServiceAccountToken })","+\treadServiceAccountToken = func(string) ([]byte, error) { return nil, errors.New(\"not mounted\") }","+","+\tauthenticator, err := NewControllerServiceAccountAuthenticator(serviceAccountTokenRegistryConfig(), \"registry.example:5000/team/cache:latest\")","+\trequire.Nil(t, authenticator)","+\trequire.ErrorContains(t, err, \"read controller ServiceAccount token\")","+}","+","+func TestNewControllerRegistryAccessBuildsScopedAuthenticator(t *testing.T) {","+\toriginalReadServiceAccountToken := readServiceAccountToken","+\tt.Cleanup(func() { readServiceAccountToken = originalReadServiceAccountToken })","+\treadServiceAccountToken = func(string) ([]byte, error) { return []byte(\"projected-token\"), nil }","+","+\tregistryAccess, err := NewControllerRegistryAccess(","+\t\tcontext.Background(),","+\t\tfake.NewClientBuilder().Build(),","+\t\t\"workload\",","+\t\tserviceAccountTokenRegistryConfig(),","+\t\t\"registry.example:5000/team/cache@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",","+\t)","+\trequire.NoError(t, err)","+\trequire.NotNil(t, registryAccess.Transport)","+\trequire.False(t, registryAccess.Insecure)","+\tauth, err := registryAccess.Authenticator.Authorization()","+\trequire.NoError(t, err)","+\trequire.Equal(t, \"projected-token\", auth.Password)","+}","+","+func serviceAccountTokenRegistryConfig() v1beta1.KernelCacheRegistryConfig {","+\treturn v1beta1.KernelCacheRegistryConfig{","+\t\tEndpoint: \"registry.example:5000\",","+\t\tAuth:     v1beta1.KernelCacheRegistryAuth{Type: v1beta1.KernelCacheRegistryAuthTypeServiceAccountToken},","+\t}","+}"],"additions":93,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/registry/transport.go","lines":["@@ -0,0 +1,75 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+// Package registry builds OCI registry clients from KernelCache configuration.","+package registry","+","+import (","+\t\"context\"","+\t\"crypto/tls\"","+\t\"crypto/x509\"","+\t\"fmt\"","+\t\"net/http\"","+","+\tcorev1 \"k8s.io/api/core/v1\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+)","+","+// NewTransport returns an HTTP transport that trusts the system certificate","+// pool and, when configured, the registry CA bundle in the workload namespace.","+// The returned transport is a clone and never mutates http.DefaultTransport.","+func NewTransport(ctx context.Context, reader client.Reader, namespace string, config v1beta1.KernelCacheRegistryConfig) (http.RoundTripper, error) {","+\ttransport := http.DefaultTransport.(*http.Transport).Clone()","+\tif config.Insecure {","+\t\ttransport.TLSClientConfig = &tls.Config{MinVersion: tls.VersionTLS12, InsecureSkipVerify: true} // #nosec G402 -- explicit registry.insecure opt-in","+\t\treturn transport, nil","+\t}","+","+\tref := config.CAConfigMapRef","+\tif ref == nil {","+\t\treturn transport, nil","+\t}","+\tif reader == nil {","+\t\treturn nil, fmt.Errorf(\"registry CA ConfigMap %q: no reader configured\", ref.Name)","+\t}","+","+\tconfigMap := &corev1.ConfigMap{}","+\tif err := reader.Get(ctx, client.ObjectKey{Namespace: namespace, Name: ref.Name}, configMap); err != nil {","+\t\treturn nil, fmt.Errorf(\"get registry CA ConfigMap %s/%s: %w\", namespace, ref.Name, err)","+\t}","+\tcaPEM, ok := configMap.Data[ref.Key]","+\tif !ok || caPEM == \"\" {","+\t\treturn nil, fmt.Errorf(\"registry CA ConfigMap %s/%s: key %q not present\", namespace, ref.Name, ref.Key)","+\t}","+","+\troots, err := x509.SystemCertPool()","+\tif err != nil || roots == nil {","+\t\troots = x509.NewCertPool()","+\t}","+\tif !roots.AppendCertsFromPEM([]byte(caPEM)) {","+\t\treturn nil, fmt.Errorf(\"registry CA ConfigMap %s/%s: key %q contains no valid CA certificate\", namespace, ref.Name, ref.Key)","+\t}","+","+\ttlsConfig := transport.TLSClientConfig.Clone()","+\tif tlsConfig == nil {","+\t\ttlsConfig = &tls.Config{MinVersion: tls.VersionTLS12}","+\t}","+\ttlsConfig.RootCAs = roots","+\ttransport.TLSClientConfig = tlsConfig","+\treturn transport, nil","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/registry/transport_test.go","lines":["@@ -0,0 +1,76 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package registry","+","+import (","+\t\"context\"","+\t\"crypto/x509\"","+\t\"encoding/pem\"","+\t\"net/http\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client/fake\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+\t\"github.com/kserve/kserve/pkg/kernelcache/security/fixture\"","+)","+","+func TestNewTransportAddsConfiguredCAToRootPool(t *testing.T) {","+\tca := fixture.NewCA(t)","+\t_, leafPEM := ca.IssueLeaf(t)","+\tconfigMap := &corev1.ConfigMap{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"registry-ca\", Namespace: \"workload\"},","+\t\tData:       map[string]string{\"service-ca.crt\": string(ca.CertPEM)},","+\t}","+\treader := fake.NewClientBuilder().WithObjects(configMap).Build()","+","+\ttransport, err := NewTransport(t.Context(), reader, \"workload\", v1beta1.KernelCacheRegistryConfig{","+\t\tCAConfigMapRef: &v1beta1.KernelCacheConfigMapKeyRef{Name: \"registry-ca\", Key: \"service-ca.crt\"},","+\t})","+\trequire.NoError(t, err)","+","+\tleafBlock, _ := pem.Decode(leafPEM)","+\trequire.NotNil(t, leafBlock)","+\tleaf, err := x509.ParseCertificate(leafBlock.Bytes)","+\trequire.NoError(t, err)","+\ttlsConfig := transport.(*http.Transport).TLSClientConfig","+\trequire.NotNil(t, tlsConfig)","+\t_, err = leaf.Verify(x509.VerifyOptions{Roots: tlsConfig.RootCAs, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageCodeSigning}})","+\trequire.NoError(t, err)","+}","+","+func TestNewTransportRejectsInvalidConfiguredCA(t *testing.T) {","+\tconfigMap := &corev1.ConfigMap{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"registry-ca\", Namespace: \"workload\"},","+\t\tData:       map[string]string{\"service-ca.crt\": \"not a certificate\"},","+\t}","+\treader := fake.NewClientBuilder().WithObjects(configMap).Build()","+","+\t_, err := NewTransport(context.Background(), reader, \"workload\", v1beta1.KernelCacheRegistryConfig{","+\t\tCAConfigMapRef: &v1beta1.KernelCacheConfigMapKeyRef{Name: \"registry-ca\", Key: \"service-ca.crt\"},","+\t})","+\trequire.EqualError(t, err, \"registry CA ConfigMap workload/registry-ca: key \\\"service-ca.crt\\\" contains no valid CA certificate\")","+}","+","+func TestNewTransportUsesExplicitInsecureMode(t *testing.T) {","+\ttransport, err := NewTransport(context.Background(), nil, \"workload\", v1beta1.KernelCacheRegistryConfig{Insecure: true})","+\trequire.NoError(t, err)","+\trequire.True(t, transport.(*http.Transport).TLSClientConfig.InsecureSkipVerify)","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"pkg/kernelcache/security/cert_sign.go","lines":["@@ -202,17 +202,25 @@ func (s *certSigner) Sign(ctx context.Context, req types.SignRequest) (types.Sig"," \t\t}"," \t}"," ","-\tref, err := name.ParseReference(req.ImageRef)","+\tparseOptions := []name.Option{}","+\tif req.RegistryInsecure {","+\t\tparseOptions = append(parseOptions, name.Insecure)","+\t}","+\tref, err := name.ParseReference(req.ImageRef, parseOptions...)"," \tif err != nil {"," \t\treturn res, fmt.Errorf(\"parse image reference %q: %w\", req.ImageRef, err)"," \t}"," ","-\t// Registry access uses the ambient keychain, matching the verifier; the","-\t// wiring will inject a keychain built from imagePullSecrets.","-\tkeychain := authn.DefaultKeychain"," \tremoteClientOpts := []remote.Option{"," \t\tremote.WithContext(ctx),","-\t\tremote.WithAuthFromKeychain(keychain),","+\t}","+\tif req.RegistryAuthenticator != nil {","+\t\tremoteClientOpts = append(remoteClientOpts, remote.WithAuth(req.RegistryAuthenticator))","+\t} else {","+\t\tremoteClientOpts = append(remoteClientOpts, remote.WithAuthFromKeychain(authn.DefaultKeychain))","+\t}","+\tif req.RegistryTransport != nil {","+\t\tremoteClientOpts = append(remoteClientOpts, remote.WithTransport(req.RegistryTransport))"," \t}"," \tremoteOpts := ociremote.WithRemoteOptions(remoteClientOpts...)"," "],"additions":13,"deletions":5,"truncated":false},{"path":"pkg/kernelcache/security/cert_verify.go","lines":["@@ -134,20 +134,29 @@ func loadTrustBundle(ctx context.Context, src SecretSource, ref, key string) ([]"," func (v *certVerifier) Verify(ctx context.Context, req types.VerifyRequest) (types.VerifyResult, error) {"," \tres := types.VerifyResult{Mode: types.ModeCert}"," ","-\tref, err := name.ParseReference(req.ImageRef)","+\tparseOptions := []name.Option{}","+\tif req.RegistryInsecure {","+\t\tparseOpt