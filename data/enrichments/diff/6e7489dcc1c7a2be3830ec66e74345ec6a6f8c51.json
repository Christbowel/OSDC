I`. Alternatively, `__unserialize()` can always"," throw to forbid unserialization altogether:"," "," ```php","@@ -61,7 +61,7 @@ final class ConsoleRequest","         requireCli();","     }"," ","-    public function __wakeup(): void","+    public function __unserialize(array $data): void","     {","         throw new LogicException('A request cannot be unserialized');","     }","@@ -74,8 +74,8 @@ To satisfy `@psalm-cli-only-instances`, the class must:"," "," - be `final`, so no subclass can add an unguarded constructor or `__unserialize()`;"," - not implement `Serializable` (its `unserialize()` runs on an object created without calling the constructor);","-- declare `__construct()`, plus `__unserialize()` (if the class or a parent defines one) or `__wakeup()` otherwise —","-  these may come from a trait used by the class;","+- declare `__construct()`, plus `__unserialize()`, or the `__wakeup()` the class or a parent defines without an","+  `__unserialize()` — these may come from a trait used by the class;"," - avoid property hooks on promoted constructor properties, since hooks execute before the constructor body;"," - start each of those methods with a valid CLI guard."," "],"additions":7,"deletions":7,"truncated":false},{"path":"docs/running_psalm/issues/DeprecatedSyntax.md","lines":["@@ -40,6 +40,15 @@ final class Connection","     }"," ","     public function connect(DateTimeZone $zone = null, int $retries = 1, string $dsn): void {} // DeprecatedSyntax: ?DateTimeZone, no default before $dsn","+","+    public function __wakeup(): void {} // DeprecatedSyntax: __unserialize()","+}","+","+final class Session","+{","+    public function __serialize(): array { return []; }","+","+    public function __sleep(): array { return []; } // no issue: serialize() calls __serialize()"," }"," "," function &nothing(): void {} // DeprecatedSyntax: a void function returns no reference"],"additions":9,"deletions":0,"truncated":false},{"path":"docs/security_analysis/index.md","line