{"id":"69306743e64f90927b27bf0d00686e113a988330","axis":"silent","repo":"envoyproxy/envoy","sha":"69306743e64f90927b27bf0d00686e113a988330","parsed":{"files":[{"path":"changelogs/current/bug_fixes/dynamic_modules__upstream-bridge-main-thread.rst","lines":["@@ -0,0 +1,6 @@","+Fixed the upstream HTTP TCP bridge (``envoy.upstreams.http.dynamic_modules``) loading its dynamic","+module and creating its bridge configuration on worker threads, where two workers could run","+``envoy_dynamic_module_on_program_init`` at the same time or use the module before it returned. The","+bridge now loads its module and calls ``envoy_dynamic_module_on_upstream_http_tcp_bridge_config_new``","+once on the main thread when the cluster is created, as the ABI documents, and a module or bridge","+configuration that fails rejects the cluster instead of failing its requests."],"additions":6,"deletions":0,"truncated":false},{"path":"envoy/router/router.h","lines":["@@ -39,9 +39,15 @@ namespace Envoy {"," namespace Formatter {"," class Formatter;"," }","+namespace Server {","+namespace Configuration {","+class ServerFactoryContext;","+} // namespace Configuration","+} // namespace Server"," namespace Upstream {"," class ClusterManager;"," class LoadBalancerContext;","+class ProtocolOptionsConfig;"," class ThreadLocalCluster;"," } // namespace Upstream"," ","@@ -1435,6 +1441,21 @@ class GenericConnPoolFactory : public Envoy::Config::TypedFactory {","       GenericConnPoolFactory::UpstreamProtocol upstream_protocol,","       Upstream::ResourcePriority priority, std::optional<Http::Protocol> downstream_protocol,","       Upstream::LoadBalancerContext* ctx, const Protobuf::Message& config) const PURE;","+","+  /**","+   * Creates the options that the connection pools of a cluster with this upstream config share. A","+   * cluster calls it on the main thread when it is created, and is rejected when it returns an","+   * error. The cluster exposes the options through extensionProtocolOptions() under the name of","+   * this factory.","+   * @param typed_config the typed config of the upstream config of the cluster.","+   * @param context the server factory context.","+   * @return the options, or nullptr when the factory keeps none.","+   */","+  virtual absl::StatusOr<std::shared_ptr<const Upstream::ProtocolOptionsConfig>>","+  createClusterOptions(const Protobuf::Any& /* typed_config */,","+                       Server::Configuration::ServerFactoryContext& /* context */) const {","+    return nullptr;","+  }"," };"," "," using GenericConnPoolFactoryPtr = std::unique_ptr<GenericConnPoolFactory>;"],"additions":21,"deletions":0,"truncated":false},{"path":"source/common/upstream/BUILD","lines":["@@ -456,6 +456,7 @@ envoy_cc_library(","         \"//envoy/network:dns_interface\",","         \"//envoy/network:listen_socket_interface\",","         \"//envoy/registry\",","+        \"//envoy/router:router_interface\",","         \"//envoy/ssl:context_interface\",","         \"//envoy/upstream:health_checker_interface\",","         \"//source/common/common:dns_utils_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/upstream/upstream_impl.cc","lines":["@@ -29,6 +29,7 @@"," #include \"envoy/network/dns.h\""," #include \"envoy/network/transport_socket.h\""," #include \"envoy/registry/registry.h\"","+#include \"envoy/router/router.h\""," #include \"envoy/secret/secret_manager.h\""," #include \"envoy/server/filter_config.h\""," #include \"envoy/server/transport_socket_config.h\"","@@ -184,6 +185,23 @@ parseExtensionProtocolOptions(","     }","   }"," ","+  // The workers create the connection pools of the cluster, so the factory of the upstream config","+  // creates what they share here, on the main thread.","+  if (config.has_upstream_config()) {","+    const auto* factory =","+        Config::Utility::getFactory<Router::GenericConnPoolFactory>(config.upstream_config());","+    if (factory != nullptr) {","+      auto object_or_error = factory->createClusterOptions(config.upstream_config().typed_config(),","+                                                           factory_context.serverFactoryContext());","+      RETURN_IF_NOT_OK_REF(object_or_error.status());","+      if (object_or_error.value() != nullptr &&","+          !options.try_emplace(factory->name(), std::move(object_or_error.value())).second) {","+        return absl::InvalidArgumentError(","+            fmt::format(\"protocol options for '{}' are already configured\", factory->name()));","+      }","+    }","+  }","+","   return options;"," }"," "],"additions":18,"deletions":0,"truncated":false},{"path":"source/extensions/upstreams/http/dynamic_modules/BUILD","lines":["@@ -54,6 +54,11 @@ envoy_cc_extension(","     deps = [","         \":abi_impl\",","         \":upstream_request_lib\",","+        \"//envoy/server:factory_context_interface\",","+        \"//envoy/upstream:upstream_interface\",","+        \"//source/common/common:macros\",","+        \"//source/common/common:thread_lib\",","+        \"//source/common/config:utility_lib\",","         \"//source/common/protobuf:utility_lib\",","         \"//source/extensions/dynamic_modules:dynamic_modules_lib\",","         \"@abseil-cpp//absl/strings\","],"additions":5,"deletions":0,"truncated":false},{"path":"source/extensions/upstreams/http/dynamic_modules/config.cc","lines":["@@ -1,10 +1,12 @@"," #include \"source/extensions/upstreams/http/dynamic_modules/config.h\""," ","+#include \"source/common/common/macros.h\"","+#include \"source/common/common/thread.h\"","+#include \"source/common/config/utility.h\""," #include \"source/common/protobuf/utility.h\""," #include \"source/extensions/dynamic_modules/dynamic_modules.h\""," #include \"source/extensions/upstreams/http/dynamic_modules/upstream_request.h\""," ","-#include \"absl/container/flat_hash_map.h\""," #include \"absl/strings/str_cat.h\""," "," namespace Envoy {","@@ -15,29 +17,37 @@ namespace DynamicModules {"," "," namespace {"," ","-// Thread-local cache of BridgeConfig instances keyed by proto config hash.","-// This ensures that on_bridge_config_new is called once per unique configuration per","-// worker thread, matching the lifecycle semantics of other dynamic module extension points.","-thread_local absl::flat_hash_map<uint64_t, BridgeConfigSharedPtr> bridge_config_cache;","-","-absl::StatusOr<BridgeConfigSharedPtr> getOrCreateBridgeConfig(","-    const envoy::extensions::upstreams::http::dynamic_modules::v3::Config& proto_config) {","-  const uint64_t cache_key = MessageUtil::hash(proto_config);","-  auto it = bridge_config_cache.find(cache_key);","-  if (it != bridge_config_cache.end()) {","-    return it->second;","-  }","+// The cluster stores its options under the name of the factory, which every request looks up.","+const std::string& factoryName() {","+  CONSTRUCT_ON_FIRST_USE(std::string, \"envoy.upstreams.http.dynamic_modules\");","+}","+","+// The bridge configuration that a cluster creates on the main thread, which its workers share.","+class BridgeClusterOptions : public Upstream::ProtocolOptionsConfig {","+public:","+  explicit BridgeClusterOptions(BridgeConfigSharedPtr bridge_config)","+      : bridge_config_(std::move(bridge_config)) {}","+","+  const BridgeConfigSharedPtr bridge_config_;","+};","+","+} // namespace","+","+std::string DynamicModuleGenericConnPoolFactory::name() const { return factoryName(); }"," ","-  const auto& module_config = proto_config.dynamic_module_config();","-  // The upstream HTTP conn-pool factory has no factory context to thread through here, so it is not","-  // passed: only the synchronous local-file and by-name module sources are supported, while remote","-  // sources are rejected by newDynamicModuleByConfig.","+absl::StatusOr<Upstream::ProtocolOptionsConfigConstSharedPtr>","+DynamicModuleGenericConnPoolFactory::createClusterOptions(","+    const Protobuf::Any& typed_config, Server::Configuration::ServerFactoryContext& context) const {","+  ASSERT_IS_MAIN_OR_TEST_THREAD();","+  envoy::extensions::upstreams::http::dynamic_modules::v3::Config proto_config;","+  RETURN_IF_NOT_OK(Config::Utility::translateOpaqueConfig(","+      typed_config, context.messageValidationVisitor(), proto_config));","+","+  // Without a factory context, newDynamicModuleByConfig rejects remote module sources, which a","+  // cluster could not wait for.","   auto load_result = Envoy::Extensions::DynamicModules::newDynamicModuleByConfig(","-      module_config, proto_config.bridge_name());","-  if (!load_result.ok()) {","-    return load_result.status();","-  }","-  auto dynamic_module = std::move(load_result->loaded);","+      proto_config.dynamic_module_config(), proto_config.bridge_name());","+  RETURN_IF_NOT_OK_REF(load_result.status());"," ","   std::string bridge_config_bytes;","   if (proto_config.has_bridge_config()) {","@@ -50,33 +60,26 @@ absl::StatusOr<BridgeConfigSharedPtr> getOrCreateBridgeConfig(","   }"," ","   auto bridge_config = BridgeConfig::create(proto_config.bridge_name(), bridge_config_bytes,","-                                            std::move(dynamic_module));","-  if (!bridge_config.ok()) {","-    return bridge_config.status();","-  }","-","-  bridge_config_cache[cache_key] = bridge_config.value();","-  return bridge_config.value();","+                                            std::move(load_result->loaded));","+  RETURN_IF_NOT_OK_REF(bridge_config.status());","+  return std::make_shared<const BridgeClusterOptions>(std::move(bridge_config.value()));"," }"," ","-} // namespace","-"," Router::GenericConnPoolPtr DynamicModuleGenericConnPoolFactory::createGenericConnPool(","     Upstream::HostConstSharedPtr host, Upstream::ThreadLocalCluster& thread_local_cluster,","     Router::GenericConnPoolFactory::UpstreamProtocol, Upstream::ResourcePriority priority,","     std::optional<Envoy::Http::Protocol>, Upstream::LoadBalancerContext* ctx,","-    const Protobuf::Message& config) const {","-  const auto& typed_config =","-      dynamic_cast<const envoy::extensions::upstreams::http::dynamic_modules::v3::Config&>(config);","-","-  auto bridge_config = getOrCreateBridgeConfig(typed_config);","-  if (!bridge_config.ok()) {","-    ENVOY_LOG_MISC(error, \"failed to create bridge config: {}\", bridge_config.status().message());","+    const Protobuf::Message&) const {","+  const auto options =","+      thread_local_cluster.info()->extensionProtocolOptionsTyped<BridgeClusterOptions>(","+          factoryName());","+  if (options == nullptr) {","+    ENVOY_BUG(false, \"the cluster has no dynamic module bridge configuration\");","     return nullptr;","   }"," ","   auto ret = std::make_unique<TcpConnPool>(host, thread_local_cluster, priority, ctx,","-                                           bridge_config.value());","+                                           options->bridge_config_);","   return (ret->valid() ? std::move(ret) : nullptr);"," }"," "],"additions":42,"deletions":39,"truncated":false},{"path":"source/extensions/upstreams/http/dynamic_modules/config.h","lines":["@@ -4,6 +4,8 @@"," #include \"envoy/extensions/upstreams/http/dynamic_modules/v3/dynamic_modules.pb.validate.h\""," #include \"envoy/registry/registry.h\""," #include \"envoy/router/router.h\"","+#include \"envoy/server/factory_context.h\"","+#include \"envoy/upstream/upstream.h\""," "," namespace Envoy {"," namespace Extensions {","@@ -17,7 +19,7 @@ namespace DynamicModules {","  */"," class DynamicModuleGenericConnPoolFactory : public Router::GenericConnPoolFactory {"," public:","-  std::string name() const override { return \"envoy.upstreams.http.dynamic_modules\"; }","+  std::string name() const override;","   std::string category() const override { return \"envoy.upstreams\"; }","   Router::GenericConnPoolPtr createGenericConnPool(","       Upstream::HostConstSharedPtr host, Upstream::ThreadLocalCluster& thread_local_cluster,","@@ -27,6 +29,10 @@ class DynamicModuleGenericConnPoolFactory : public Router::GenericConnPoolFactor","   ProtobufTypes::MessagePtr createEmptyConfigProto() override {","     return std::make_unique<envoy::extensions::upstreams::http::dynamic_modules::v3::Config>();","   }","+  // Loads the module and creates the bridge configuration of a cluster, on the main thread.","+  absl::StatusOr<Upstream::ProtocolOptionsConfigConstSharedPtr>","+  createClusterOptions(const Protobuf::Any& typed_config,","+                       Server::Configuration::ServerFactoryContext& context) const override;"," };"," "," DECLARE_FACTORY(DynamicModuleGenericConnPoolFactory);"],"additions":7,"deletions":1,"truncated":false},{"path":"test/common/upstream/BUILD","lines":["@@ -851,6 +851,7 @@ envoy_cc_test(","         \"//envoy/api:api_interface\",","         \"//envoy/http:client_codec_factory_interface\",","         \"//envoy/http:codec_interface\",","+        \"//envoy/router:router_interface\",","         \"//envoy/upstream:cluster_manager_interface\",","         \"//source/common/common:hash_lib\",","         \"//source/common/config:metadata_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"test/common/upstream/upstream_impl_test.cc","lines":["@@ -15,6 +15,7 @@"," #include \"envoy/http/client_codec_factory.h\""," #include \"envoy/http/codec.h\""," #include \"envoy/network/address.h\"","+#include \"envoy/router/router.h\""," #include \"envoy/stats/scope.h\""," #include \"envoy/upstream/cluster_manager.h\""," #include \"envoy/upstream/health_check_host_monitor.h\"","@@ -5785,6 +5786,118 @@ TEST_P(ParametrizedClusterInfoImplTest, TypedExtensionProtocolOptionsForUnknownF","                             \"protocol options implementation for name: 'no_such_filter'\");"," }"," ","+class TestClusterOptions : public ProtocolOptionsConfig {};","+","+// Creates the cluster options of an upstream config whose value is \"create\", leaves them to the","+// default for \"default\", and rejects the cluster for \"reject\".","+class TestClusterOptionsConnPoolFactory : public Router::GenericConnPoolFactory {","+public:","+  std::string name() const override { return \"envoy.test.upstreams.cluster_options\"; }","+  std::string category() const override { return \"envoy.upstreams\"; }","+  Router::GenericConnPoolPtr createGenericConnPool(HostConstSharedPtr, ThreadLocalCluster&,","+                                                   Router::GenericConnPoolFactory::UpstreamProtocol,","+                                                   ResourcePriority, std::optional<Http::Protocol>,","+                                                   LoadBalancerContext*,","+                                                   const Protobuf::Message&) const override {","+    return nullptr;","+  }","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<Protobuf::StringValue>();","+  }","+  absl::StatusOr<ProtocolOptionsConfigConstSharedPtr>","+  createClusterOptions(const Protobuf::Any& typed_config,","+                       Server::Configuration::ServerFactoryContext& context) const override {","+    Protobuf::StringValue response;","+    RETURN_IF_NOT_OK(MessageUtil::unpackTo(typed_config, response));","+    if (response.value() == \"reject\") {","+      return absl::InvalidArgumentError(\"cluster options rejected\");","+    }","+    if (response.value() == \"default\") {","+      return Router::GenericConnPoolFactory::createClusterOptions(typed_config, context);","+    }","+    return std::make_shared<TestClusterOptions>();","+  }","+};","+","+// A protocol options factory with the name of TestClusterOptionsConnPoolFactory.","+class TestClusterOptionsProtocolOptionsFactory","+    : public Server::Configuration::ProtocolOptionsFactory {","+public:","+  std::string name() const override { return \"envoy.test.upstreams.cluster_options\"; }","+  std::string category() const override { return \"envoy.upstream_options\"; }","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<Protobuf::Struct>();","+  }","+  ProtobufTypes::MessagePtr createEmptyProtocolOptionsProto() override {","+    return std::make_unique<Protobuf::Struct>();","+  }","+  absl::StatusOr<ProtocolOptionsConfigConstSharedPtr>","+  createProtocolOptionsConfig(const Protobuf::Message&,","+                              Server::Configuration::ProtocolOptionsFactoryContext&) override {","+    return std::make_shared<TestClusterOptions>();","+  }","+};","+","+std::string clusterWithUpstreamConfig(absl::string_view response) {","+  return fmt::format(R\"EOF(","+    name: name","+    connect_timeout: 0.25s","+    type: STRICT_DNS","+    lb_policy: ROUND_ROBIN","+    upstream_config:","+      name: envoy.test.upstreams.cluster_options","+      typed_config:","+        \"@type\": type.googleapis.com/google.protobuf.StringValue","+        value: {}","+  )EOF\",","+                     response);","+}","+","+TEST_P(ParametrizedClusterInfoImplTest, UpstreamConfigCreatesClusterOptions) {","+  TestClusterOptionsConnPoolFactory factory;","+  Registry::InjectFactory<Router::GenericConnPoolFactory> registered_factory(factory);","+  auto cluster = makeCluster(clusterWithUpstreamConfig(\"create\"));","+  EXPECT_NE(nullptr, cluster->info()->extensionProtocolOptionsTyped<TestClusterOptions>(","+                         \"envoy.test.upstreams.cluster_options\"));","+}","+","+TEST_P(ParametrizedClusterInfoImplTest, UpstreamConfigWithoutClusterOptions) {","+  TestClusterOptionsConnPoolFactory factory;","+  Registry::InjectFactory<Router::GenericConnPoolFactory> registered_factory(factory);","+  auto cluster = makeCluster(clusterWithUpstreamConfig(\"default\"));","+  EXPECT_EQ(nullptr, cluster->info()->extensionProtocolOptionsTyped<TestClusterOptions>(","+                         \"envoy.test.upstreams.cluster_options\"));","+}","+","+TEST_P(ParametrizedClusterInfoImplTest, UpstreamConfigOfAnUnknownFactoryHasNoClusterOptions) {","+  auto cluster = makeCluster(clusterWithUpstreamConfig(\"create\"));","+  EXPECT_EQ(nullptr, cluster->info()->extensionProtocolOptionsTyped<TestClusterOptions>(","+                         \"envoy.test.upstreams.cluster_options\"));","+}","+","+TEST_P(ParametrizedClusterInfoImplTest, UpstreamConfigRejectsTheCluster) {","+  TestClusterOptionsConnPoolFactory factory;","+  Registry::InjectFactory<Router::GenericConnPoolFactory> registered_factory(factory);","+  EXPECT_THROW_WITH_MESSAGE(makeCluster(clusterWithUpstreamConfig(\"reject\")), EnvoyException,","+                            \"cluster options rejected\");","+}","+","+TEST_P(ParametrizedClusterInfoImplTest, UpstreamConfigClusterOptionsAlreadyConfigured) {","+  TestClusterOptionsConnPoolFactory factory;","+  Registry::InjectFactory<Router::GenericConnPoolFactory> registered_factory(factory);","+  TestClusterOptionsProtocolOptionsFactory options_factory;","+  Registry::InjectFactory<Server::Configuration::ProtocolOptionsFactory> registered_options_factory(","+      options_factory);","+  const std::string yaml = clusterWithUpstreamConfig(\"create\") + R\"EOF(","+    typed_extension_protocol_options:","+      envoy.test.upstreams.cluster_options:","+        \"@type\": type.googleapis.com/google.protobuf.Struct","+  )EOF\";","+  EXPECT_THROW_WITH_MESSAGE(","+      makeCluster(yaml), EnvoyException,","+      \"protocol options for 'envoy.test.upstreams.cluster_options' are already configured\");","+}","+"," TEST_P(ParametrizedClusterInfoImplTest, TestTrackRequestResponseSizesNotSetInConfig) {","   const std::string yaml_disabled = R\"EOF(","     name: name"],"additions":113,"deletions":0,"truncated":false},{"path":"test/extensions/upstreams/http/dynamic_modules/BUILD","lines":["@@ -90,7 +90,6 @@ envoy_extension_cc_dyn_module_test(","         \"//test/integration:http_integration_lib\",","         \"//test/integration:http_protocol_integration_lib\",","         \"//test/test_common:environment_lib\",","-        \"//test/test_common:logging_lib\",","         \"@envoy_api//envoy/config/bootstrap/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/upstreams/http/dynamic_modules/v3:pkg_cc_proto\",","     ],"],"additions":0,"deletions":1,"truncated":false},{"path":"test/extensions/upstreams/http/dynamic_modules/integration_test.cc","lines":["@@ -3,7 +3,6 @@"," "," #include \"test/integration/http_protocol_integration.h\""," #include \"test/test_common/environment.h\"","-#include \"test/test_common/logging.h\""," "," namespace Envoy {"," namespace {","@@ -137,9 +136,9 @@ TEST_P(DynamicModuleBridgeIntegrationTest, LocalReplyBeforeDownstreamEndStream)","   EXPECT_EQ(\"access denied\", response_->body());"," }"," ","-// The upstream HTTP bridge loads its module lazily on the data path and has no factory context, so","-// a missing module is visible only through the loader error log.","-TEST_P(DynamicModuleBridgeIntegrationTest, ModuleLoadFailureLogsAtRuntime) {","+// The bridge loads its module when the cluster is created, so a missing module rejects the cluster,","+// which here is a static cluster of the bootstrap.","+TEST_P(DynamicModuleBridgeIntegrationTest, ModuleLoadFailureRejectsTheCluster) {","   TestEnvironment::setEnvVar(\"ENVOY_DYNAMIC_MODULES_SEARCH_PATH\", \"/should/not/find/this/path\", 1);"," ","   config_helper_.addConfigModifier([](envoy::config::bootstrap::v3::Bootstrap& bootstrap) {","@@ -156,14 +155,7 @@ TEST_P(DynamicModuleBridgeIntegrationTest, ModuleLoadFailureLogsAtRuntime) {","         cluster->mutable_upstream_config()->mutable_typed_config()->PackFrom(proto_config);","   });"," ","-  initialize();","-","-  EXPECT_LOG_CONTAINS(\"error\", \"Unable to load dynamic module libnonexistent_module\", {","-    codec_client_ = makeHttpConnection(lookupPort(\"http\"));","-    auto response = codec_client_->makeHeaderOnlyRequest(request_headers_);","-    ASSERT_TRUE(response->waitForEndStream());","-    EXPECT_EQ(\"503\", response->headers().getStatusValue());","-  });","+  EXPECT_DEATH(initialize(), \"nonexistent_module\");"," }"," "," } // namespace"],"additions":4,"deletions":12,"truncated":false},{"path":"test/extensions/upstreams/http/dynamic_modules/upstream_request_test.cc","lines":["@@ -616,22 +616,39 @@ class DynamicModuleGenericConnPoolFactoryTest : public ::testing::Test {","     return config;","   }"," ","+  absl::StatusOr<Upstream::ProtocolOptionsConfigConstSharedPtr> createClusterOptions(","+      const envoy::extensions::upstreams::http::dynamic_modules::v3::Config& config) {","+    Protobuf::Any typed_config;","+    std::ignore = typed_config.PackFrom(config);","+    return factory_.createClusterOptions(typed_config, server_context_);","+  }","+","+  // Creates a connection pool of a cluster that has the given options.","+  Router::GenericConnPoolPtr","+  createGenericConnPool(Upstream::ProtocolOptionsConfigConstSharedPtr options) {","+    ON_CALL(*cm_.thread_local_cluster_.cluster_.info_, extensionProtocolOptions(_))","+        .WillByDefault(Return(std::move(options)));","+    return factory_.createGenericConnPool(","+        host_, cm_.thread_local_cluster_, Router::GenericConnPoolFactory::UpstreamProtocol::HTTP,","+        Upstream::ResourcePriority::Default, std::nullopt, nullptr, createProtoConfig());","+  }","+","   DynamicModuleGenericConnPoolFactory factory_;","+  NiceMock<Server::Configuration::MockServerFactoryContext> server_context_;","   NiceMock<Upstream::MockClusterManager> cm_;","   Envoy::Tcp::ConnectionPool::MockInstance mock_pool_;","   std::shared_ptr<NiceMock<Upstream::MockHost>> host_;"," };"," "," TEST_F(DynamicModuleGenericConnPoolFactoryTest, CreateSuccess) {","-  auto config = createProtoConfig();","-  auto pool = factory_.createGenericConnPool(","-      host_, cm_.thread_local_cluster_, Router::GenericConnPoolFactory::UpstreamProtocol::HTTP,","-      Upstream::ResourcePriority::Default, std::nullopt, nullptr, config);","-  EXPECT_NE(pool, nullptr);","+  auto options = createClusterOptions(createProtoConfig());","+  ASSERT_OK(options);"