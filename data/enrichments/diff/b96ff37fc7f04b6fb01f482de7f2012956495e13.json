{"id":"b96ff37fc7f04b6fb01f482de7f2012956495e13","axis":"silent","repo":"omniauth/omniauth","sha":"b96ff37fc7f04b6fb01f482de7f2012956495e13","parsed":{"files":[{"path":".duel.rb","lines":["@@ -0,0 +1,13 @@","+# frozen_string_literal: true","+","+# Duel's configuration: https://github.com/sferik/duel-ruby/blob/main/docs/configuration.md","+#","+# Duel follows conventions, so set only what differs: benchmarks are in","+# duel/**/*_duel.rb, each version's lib/ is first on the load path, a","+# change is compared when it touches lib/ or ext/, and releases are","+# tagged v*.","+Duel.configure do |c|","+  # The library each version's workers require (from the gemspec, unless","+  # this says otherwise).","+  # c.library = \"omniauth\"","+end"],"additions":13,"deletions":0,"truncated":false},{"path":".github/workflows/perf.yml","lines":["@@ -0,0 +1,65 @@","+name: Perf","+","+on:","+  pull_request:","+  push:","+    branches: [master]","+  schedule:","+    - cron: \"0 4 * * *\"","+  workflow_dispatch:","+","+permissions:","+  contents: read","+  pull-requests: write # to comment on a pull request with the report","+","+jobs:","+  duel:","+    name: Duel","+    runs-on: ubuntu-latest","+    steps:","+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+        with:","+          fetch-depth: 0 # the baseline comes from history, tags included","+          persist-credentials: false","+      # Duel requires Ruby 3.4 or later.","+      - uses: ruby/setup-ruby@824c0e29fdfc7d689c191c27acc969d2d04b7dd8 # v1.331.0","+        with:","+          ruby-version: \"3.4\"","+          bundler-cache: true","+      # Against the main branch for a pull request, what was there before","+      # for a push, and the last release on a schedule (slow creep). Duel","+      # adds its report to the job's summary, and writes it to duel.md for","+      # the comment.","+      - name: Compare","+        env:","+          DUEL_BASE: ${{ github.event_name == 'schedule' && 'last-release' || github.event_name == 'push' && github.event.before || '' }}","+          # (Run by hand, it compares anyway: with nothing changed, the code","+          # with itself, which checks the setup.)","+          DUEL_FORCE: ${{ github.event_name == 'workflow_dispatch' && '1' || '' }}","+        run: |","+          # (A branch's first push, or one that rewrote history, has no","+          # commit before it here to compare against.)","+          if [ \"$GITHUB_EVENT_NAME\" = push ] && ! git cat-file -e \"$DUEL_BASE^{commit}\" 2>/dev/null; then","+            echo \"::notice::No commit before this push to compare against\"","+            exit 0","+          fi","+          bundle exec duel --markdown \"$RUNNER_TEMP/duel.md\"","+      # The report, as a comment on the pull request: one comment, updated","+      # on every push. (A pull request from a fork gets no comment, as its","+      # token can't write one: the job's summary has the report.)","+      - name: Comment on the pull request","+        if: ${{ !cancelled() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository }}","+        env:","+          GH_TOKEN: ${{ github.token }}","+          PR: ${{ github.event.pull_request.number }}","+        run: |","+          [ -f \"$RUNNER_TEMP/duel.md\" ] || exit 0","+          marker=\"<!-- duel -->\"","+          { echo \"$marker\"; cat \"$RUNNER_TEMP/duel.md\"; } > \"$RUNNER_TEMP/comment.md\"","+          ids=$(gh api --paginate \"repos/$GITHUB_REPOSITORY/issues/$PR/comments\" \\","+            --jq \".[] | select(.user.login == \\\"github-actions[bot]\\\" and (.body | startswith(\\\"$marker\\\"))) | .id\")","+          if [ -n \"$ids\" ]; then","+            gh api --method PATCH \"repos/$GITHUB_REPOSITORY/issues/comments/${ids%%$'\\n'*}\" -F body=@\"$RUNNER_TEMP/comment.md\" > /dev/null","+          else","+            gh api --method POST \"repos/$GITHUB_REPOSITORY/issues/$PR/comments\" -F body=@\"$RUNNER_TEMP/comment.md\" > /dev/null","+          fi"],"additions":65,"deletions":0,"truncated":false},{"path":".gitignore","lines":["@@ -15,3 +15,4 @@ pkg/*"," .DS_Store"," .tool-versions"," .mutant/","+tmp/"],"additions":1,"deletions":0,"truncated":false},{"path":".rubocop.yml","lines":["@@ -1,4 +1,11 @@","+inherit_mode:","+  merge:","+    - Include","+"," AllCops:","+  # .duel.rb is a dotfile, which RuboCop leaves out unless it's included.","+  Include:","+    - '.duel.rb'","   TargetRubyVersion: 2.5","   NewCops: enable","   SuggestExtensions: false"],"additions":7,"deletions":0,"truncated":false},{"path":"Gemfile","lines":["@@ -22,6 +22,12 @@ group :development do","   # OmniAuth::Utils's.","   gem 'mutant', '~> 0.17.1', :platforms => :mri if RUBY_VERSION >= '3.3'","   gem 'mutant-rspec', '~> 0.17.1', :require => false, :platforms => :mri if RUBY_VERSION >= '3.3'","+  # Duel requires Ruby 3.4 or later. It profiles a regression with","+  # StackProf, which runs on CRuby only.","+  if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new('3.4')","+    gem 'duel'","+    gem 'stackprof', :platforms => :mri","+  end"," end"," "," group :test do"],"additions":6,"deletions":0,"truncated":false},{"path":"README.md","lines":["@@ -6,6 +6,7 @@"," [![JRuby](https://github.com/omniauth/omniauth/actions/workflows/jruby.yml/badge.svg)][githubactionsjruby]"," [![Maintainability](https://qlty.sh/gh/omniauth/projects/omniauth/maintainability.svg)][qlty]"," [![Coverage Status](http://img.shields.io/coveralls/omniauth/omniauth.svg)][coveralls]","+[![Duel](https://raw.githubusercontent.com/sferik/duel-ruby/main/assets/badge.svg)](https://github.com/sferik/duel-ruby)"," "," [gem]: https://rubygems.org/gems/omniauth"," [githubactions]: https://github.com/omniauth/omniauth/actions/workflows/main.yml"],"additions":1,"deletions":0,"truncated":false},{"path":"Rakefile","lines":["@@ -93,3 +93,10 @@ namespace :perf do","     report.pretty_print","   end"," end","+","+begin","+  require 'duel/rake_task'","+  Duel::RakeTask.new","+rescue LoadError","+  # Duel requires Ruby 3.4 or later","+end"],"additions":7,"deletions":0,"truncated":false},{"path":"duel/auth_hash_duel.rb","lines":["@@ -0,0 +1,43 @@","+require_relative 'duel_helper'","+","+# The auth hash that every callback builds, and that the app reads, often","+# field by field, and stores with #to_hash.","+","+duel 'auth_hash: build a minimal one' do","+  OmniAuth::AuthHash.new(:provider => 'github', :uid => '42')","+end","+","+duel 'auth_hash: build a typical one' do","+  once { @data = DuelHelper.auth_data }","+  OmniAuth::AuthHash.new(@data)","+end","+","+# A raw_info with far more fields than providers usually send (GitHub's","+# has about 30), some of them nested.","+duel 'auth_hash: build one with a large raw_info' do","+  once { @data = DuelHelper.auth_data(DuelHelper.raw_info(200)) }","+  OmniAuth::AuthHash.new(@data)","+end","+","+duel 'auth_hash: read its fields' do","+  once { @auth = OmniAuth::AuthHash.new(DuelHelper.auth_data) }","+  @auth.provider","+  @auth.uid","+  @auth.info.name","+  @auth.info.email","+  @auth.credentials.token","+  @auth.extra.raw_info.login","+  @auth.valid?","+end","+","+# The name, made from first and last names, which some providers send","+# without a name.","+duel 'auth_hash: a name from first and last names' do","+  once { @info = OmniAuth::AuthHash::InfoHash.new('first_name' => 'Ada', 'last_name' => 'Lovelace', 'email' => 'ada@example.org') }","+  @info.name","+end","+","+duel 'auth_hash: to_hash' do","+  once { @auth = OmniAuth::AuthHash.new(DuelHelper.auth_data) }","+  @auth.to_hash","+end"],"additions":43,"deletions":0,"truncated":false},{"path":"duel/builder_duel.rb","lines":["@@ -0,0 +1,31 @@","+require_relative 'duel_helper'","+","+# OmniAuth::Builder with five providers, as an app with several sign-in","+# options has: every request passes through all five strategies.","+setup do","+  @app = OmniAuth::Builder.new(DuelHelper::APP) do","+    %w[github google twitter facebook apple].each do |name|","+      provider DuelHelper::Provider, :name => name","+    end","+  end","+  @session, @token = DuelHelper.csrf_session","+  # The first request builds the middleware stack, which is then reused.","+  @app.call(DuelHelper.env_for('/', 'rack.session' => {}))","+end","+","+duel 'builder: pass through five providers' do","+  once { @env = DuelHelper.env_for('/users/42/posts?page=2', 'rack.session' => @session) }","+  @app.call(@env)","+end","+","+duel 'builder: request phase of the fifth provider' do |n|","+  once { @env = DuelHelper.env_for('/auth/apple', :method => 'POST', :params => {'authenticity_token' => @token}) }","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@app, envs, 302)","+end","+","+duel 'builder: callback of the fifth provider' do |n|","+  once { @env = DuelHelper.env_for('/auth/apple/callback?uid=42&code=4a5f8e&state=b1f6c2d0a9e84f37') }","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@app, envs, 200)","+end"],"additions":31,"deletions":0,"truncated":false},{"path":"duel/callback_duel.rb","lines":["@@ -0,0 +1,37 @@","+require_relative 'duel_helper'","+","+# The callback phase builds the auth hash and calls the app. It takes the","+# sign-in's origin and params out of the session, so each iteration gets","+# fresh copies, made untimed.","+","+duel 'callback: the developer strategy' do |n|","+  once do","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/developer/callback?name=Ada+Lovelace&email=ada%40example.org')","+    @session = {'omniauth.origin' => '/dashboard', 'omniauth.params' => {'origin' => '/dashboard'}}","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@strategy, envs, 200)","+end","+","+duel 'callback: a provider' do |n|","+  once do","+    @strategy = DuelHelper::Provider.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/provider/callback?uid=42&code=4a5f8e&state=b1f6c2d0a9e84f37')","+    @session = {'omniauth.origin' => '/dashboard', 'omniauth.params' => {}}","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@strategy, envs, 200)","+end","+","+# The newest of the five sign-ins that OmniAuth keeps, which it finds","+# last, comparing each key in constant time.","+duel 'callback: a provider, with five sign-ins kept' do |n|","+  once do","+    @strategy = DuelHelper::Provider.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/provider/callback?uid=42&code=4a5f8e&state=state5')","+    @session = {'omniauth.sign_ins' => DuelHelper.sign_ins(OmniAuth::Strategy::SignIns::MAX_REMEMBERED_SIGN_INS)}","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@strategy, envs, 200)","+end"],"additions":37,"deletions":0,"truncated":false},{"path":"duel/csrf_duel.rb","lines":["@@ -0,0 +1,24 @@","+require_relative 'duel_helper'","+","+# The request validation phase that checks the request phase's","+# authenticity token against the session's. Rack caches the parsed params","+# in the env, so they're parsed once, untimed, and these time the check","+# itself.","+","+duel 'csrf: a valid token in the form' do","+  once do","+    session, token = DuelHelper.csrf_session","+    @env = DuelHelper.env_for('/auth/developer', :method => 'POST', :params => {'authenticity_token' => token}, 'rack.session' => session)","+    OmniAuth::AuthenticityTokenProtection.call(@env)","+  end","+  OmniAuth::AuthenticityTokenProtection.call(@env)","+end","+","+duel 'csrf: a valid token in a header' do","+  once do","+    session, token = DuelHelper.csrf_session","+    @env = DuelHelper.env_for('/auth/developer', :method => 'POST', 'HTTP_X_CSRF_TOKEN' => token, 'rack.session' => session)","+    OmniAuth::AuthenticityTokenProtection.call(@env)","+  end","+  OmniAuth::AuthenticityTokenProtection.call(@env)","+end"],"additions":24,"deletions":0,"truncated":false},{"path":"duel/duel_helper.rb","lines":["@@ -0,0 +1,146 @@","+require 'logger'","+require 'stringio'","+require 'rack/mock'","+","+# Pin OmniAuth's global configuration, which every benchmark in a worker","+# shares, so no benchmark sees what another one left behind. Logging goes","+# nowhere, and allowed_hosts is set, as OmniAuth recommends, so the","+# request phase doesn't warn about the request's host.","+OmniAuth.configure do |config|","+  config.logger = Logger.new(nil)","+  config.test_mode = false","+  config.allowed_hosts = ['example.org']","+  config.full_host = nil","+  config.path_prefix = '/auth'","+  config.allowed_request_methods = %i[post]","+  config.request_validation_phase = OmniAuth::AuthenticityTokenProtection","+  config.before_request_phase = nil","+  config.after_request_phase = nil","+  config.before_callback_phase = nil","+  config.on_failure = OmniAuth::FailureEndpoint","+  config.failure_raise_out_environments = []","+end","+","+module DuelHelper","+  # The app behind the middleware, which answers every request alike.","+  APP = lambda { |_env| [200, {'content-type' => 'text/plain'}, ['OK']] }","+","+  # A strategy shaped like an OAuth 2.0 provider's: its request phase","+  # redirects to the provider with the callback URL and a state, and","+  # remembers the sign-in under that state, and its callback builds the","+  # auth hash from what the provider sent back.","+  class Provider","+    include OmniAuth::Strategy","+","+    STATE = 'b1f6c2d0a9e84f37'.freeze","+","+    def request_phase","+      remember_sign_in(STATE)","+      redirect(\"https://provider.example/oauth/authorize?client_id=abc123&redirect_uri=#{Rack::Utils.escape(callback_url)}&state=#{STATE}\")","+    end","+","+    def callback_sign_in_key","+      request.params['state']","+    end","+","+    uid { request.params['uid'] }","+","+    info do","+      {","+        'name' => 'Ada Lovelace',","+        'email' => 'ada@example.org',","+        'nickname' => 'ada',","+        'image' => 'https://provider.example/avatars/ada.png'","+      }","+    end","+","+    credentials do","+      {'token' => 'gho_16C7e42F292c6912E7710c838347Ae178B4a', 'expires' => true, 'expires_at' => 1_800_000_000}","+    end","+","+    extra do","+      {'raw_info' => {'id' => 42, 'login' => 'ada', 'site_admin' => false}}","+    end","+  end","+","+  # A strategy with an other_phase, as some providers' have (for","+  # metadata, say), which OmniAuth can't pass a request straight through.","+  class OtherPhase","+    include OmniAuth::Strategy","+","+    def request_phase","+      redirect('https://provider.example/')","+    end","+","+    def other_phase","+      call_app!","+    end","+  end","+","+module_function","+","+  # A session with a CSRF token, and a token for the request phase's form","+  # that's valid for it.","+  def csrf_session","+    session = {}","+    token = Rack::Protection::AuthenticityToken.token(session)","+    [session, token]","+  end","+","+  # What a provider's callback gives AuthHash.new: the typical fields,","+  # and a raw_info.","+  def auth_data(raw_info = {'id' => 42, 'login' => 'ada', 'site_admin' => false})","+    {","+      'provider' => 'github',","+      'uid' => '42',","+      'info' => {","+        'name' => 'Ada Lovelace',","+        'email' => 'ada@example.org',","+        'nickname' => 'ada',","+        'image' => 'https://avatars.example.org/u/42'","+      },","+      'credentials' => {'token' => 'gho_16C7e42F292c6912E7710c838347Ae178B4a', 'expires' => false},","+      'extra' => {'raw_info' => raw_info}","+    }","+  end","+","+  # A raw_info with count fields, a tenth of them nested hashes.","+  def raw_info(count)","+    (1..count).collect do |i|","+      value = (i % 10).zero? ? {'id' => i, 'name' => \"field #{i}\", 'url' => \"https://provider.example/#{i}\"} : \"value #{i}\"","+      [\"field_#{i}\", value]","+    end.to_h","+  end","+","+  # count remembered sign-ins, keyed state1 to stateN, oldest first.","+  def sign_ins(count)","+    (1..count).collect { |i| [\"state#{i}\", {'origin' => \"/posts/#{i}\", 'params' => {'tab' => i.to_s}}] }.to_h","+  end","+","+  # A copy of env with its own session and body, for work that changes","+  # them. Build these in `untimed`.","+  def fresh(env, session)","+    copy = env.dup","+    copy['rack.session'] = session.dup","+    input = env['rack.input']","+    copy['rack.input'] = StringIO.new(input ? input.string : '') if input","+    copy","+  end","+","+  # count fresh copies of env. Build them in `untimed`.","+  def fresh_envs(env, session, count)","+    Array.new(count) { fresh(env, session) }","+  end","+","+  # Calls app with each env, and checks the last response's status.","+  def call_each(app, envs, status)","+    response = nil","+    envs.each { |env| response = app.call(env) }","+    raise \"Expected #{status}, got #{response[0]}\" if response && response[0] != status","+  end","+","+  # The env for a request, built once.","+  def env_for(path, options = {})","+    Rack::MockRequest.env_for(\"http://example.org#{path}\", options)","+  end","+end"],"additions":146,"deletions":0,"truncated":false},{"path":"duel/passthrough_duel.rb","lines":["@@ -0,0 +1,59 @@","+require_relative 'duel_helper'","+","+# Every strategy sits in the middleware stack of every request, so the","+# requests that aren't for it, which it hands straight to the app, are","+# OmniAuth's hottest path. None of these change the env, so each is","+# built once.","+","+duel 'passthrough: a typical path' do","+  once do","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/users/42/posts?page=2', 'rack.session' => {})","+  end","+  @strategy.call(@env)","+end","+","+duel 'passthrough: the root path' do","+  once do","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/', 'rack.session' => {})","+  end","+  @strategy.call(@env)","+end","+","+duel 'passthrough: a long path' do","+  once do","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP)","+    @env = DuelHelper.env_for(\"/#{(%w[Segment] * 250).join('/')}/\", 'rack.session' => {})","+  end","+  @strategy.call(@env)","+end","+","+duel 'passthrough: another path under /auth' do","+  once do","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/failure?message=invalid_credentials&strategy=github', 'rack.session' => {})","+  end","+  @strategy.call(@env)","+end","+","+# A strategy with an other_phase, or with path lambdas, can't be passed","+# through without a copy of it, so it takes the slower way, through","+# #call!.","+","+duel 'passthrough: a strategy with an other_phase' do","+  once do","+    @strategy = DuelHelper::OtherPhase.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/users/42/posts?page=2', 'rack.session' => {})","+  end","+  @strategy.call(@env)","+end","+","+duel 'passthrough: a strategy with a path lambda' do","+  once do","+    request_path = lambda { |env| env['PATH_INFO'].eql?('/sign_in/developer') }","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP, :request_path => request_path)","+    @env = DuelHelper.env_for('/users/42/posts?page=2', 'rack.session' => {})","+  end","+  @strategy.call(@env)","+end"],"additions":59,"deletions":0,"truncated":false},{"path":"duel/request_duel.rb","lines":["@@ -0,0 +1,47 @@","+require_relative 'duel_helper'","+","+# The request phase, POSTed with a valid authenticity token, as OmniAuth","+# requires. It writes to the session and the env, so each iteration gets","+# fresh copies, made untimed.","+setup { @session, @token = DuelHelper.csrf_session }","+","+duel 'request: the developer form' do |n|","+  once do","+    @strategy = OmniAuth::Strategies::Developer.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/developer', :method => 'POST', :params => {'authenticity_token' => @token, 'origin' => '/dashboard'})","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@strategy, envs, 200)","+end","+","+duel 'request: redirect to the provider' do |n|","+  once do","+    @strategy = DuelHelper::Provider.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/provider', :method => 'POST', :params => {'authenticity_token' => @token, 'origin' => '/dashboard'})","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@strategy, envs, 302)","+end","+","+# With as many sign-ins remembered as OmniAuth keeps, so remembering","+# another forgets the oldest.","+duel 'request: redirect, with five sign-ins kept' do |n|","+  once do","+    @strategy = DuelHelper::Provider.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/provider', :method => 'POST', :params => {'authenticity_token' => @token})","+    @full = @session.merge('omniauth.sign_ins' => DuelHelper.sign_ins(OmniAuth::Strategy::SignIns::MAX_REMEMBERED_SIGN_INS))","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @full, n) }","+  DuelHelper.call_each(@strategy, envs, 302)","+end","+","+# A forged token fails the request phase, which redirects to the failure","+# endpoint.","+duel 'request: a forged token, rejected' do |n|","+  once do","+    @strategy = DuelHelper::Provider.new(DuelHelper::APP)","+    @env = DuelHelper.env_for('/auth/provider', :method => 'POST', :params => {'authenticity_token' => 'forged'})","+  end","+  envs = untimed { DuelHelper.fresh_envs(@env, @session, n) }","+  DuelHelper.call_each(@strategy, envs, 302)","+end",""],"additions":47,"deletions":0,"truncated":false}],"additions":487,"deletions":0,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-10-26T14:32:35.215092+00:00"}