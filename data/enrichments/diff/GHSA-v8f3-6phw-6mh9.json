)","+        assert _same_instances(got, _reference_srl_instances(reader, rows))","+        assert all(i.tagged_spans is got[0].tagged_spans for i in got)","+","     def test_real_conll_corpora_read_as_documented(self):","         _needs(\"corpora/conll2000\", \"corpora/conll2002\")","         from nltk.corpus import conll2000, conll2002",""],"additions":59,"deletions":0,"truncated":false}],"additions":88,"deletions":7,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-14T15:12:27.219535+00:00"}