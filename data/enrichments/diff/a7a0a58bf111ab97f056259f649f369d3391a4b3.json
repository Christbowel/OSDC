 test_list_tenant_tables_with_bloom_index_meta() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    fixture.create_default_database().await?;","+    fixture.create_default_table().await?;","+","+    let ctx = fixture.new_query_ctx().await?;","+    let catalog = ctx.get_catalog(\"default\").await?;","+    let table = ctx","+        .get_table(","+            \"default\",","+            &fixture.default_db_name(),","+            &fixture.default_table_name(),","+        )","+        .await?;","+","+    // Simulate metadata written by a release that supports BLOOM table indexes.","+    let table_info = table.get_table_info().clone();","+    let mut meta = table_info.meta.clone();","+    let column_id = meta.schema.field_with_name(\"id\")?.column_id();","+    meta.indexes.insert(\"id_bloom\".to_string(), TableIndex {","+        index_type: TableIndexType::Bloom,","+        name: \"id_bloom\".to_string(),","+        column_ids: vec![column_id],","+        sync_creation: true,","+        version: \"0\".to_string(),","+        options: btreemap! {\"filter_type\".to_string() => \"binary_fuse32\".to_string()},","+    });","+    catalog","+        .update_single_table_meta(","+            &fixture.default_tenant(),","+            UpdateTableMetaReq {","+                table_id: table_info.ident.table_id,","+                seq: MatchSeq::Exact(table_info.ident.seq),","+                new_table_meta: meta,","+                base_snapshot_location: FuseTable::try_from_table(table.as_ref())?.snapshot_loc(),","+                lvt_check: None,","+            },","+            &table_info,","+        )","+        .await?;","+","+    let srv = AdminService::create(&ConfigBuilder::create().with_management_mode().build());","+    let uri = format!(","+        \"/v1/tenants/{}/tables\",","+        fixture.default_tenant().tenant_name()","+    );","+    let response = srv","+        .build_router()","+        .get_response(","+            Request::builder()","+                .uri(Uri::from_maybe_shared(uri)?)","+                .header(header::CONTENT_TYPE, \"application/json\")","+                .method(Method::GET)","+                .finish(),","+        )","+        .await;","+    assert_eq!(response.status(), StatusCode::OK);","+","+    let body = response.into_body().into_vec().await?;","+    let resp = serde_json::from_slice::<Value>(&body)?;","+    assert_eq!(resp[\"warnings\"], Value::Array(vec![]));","+","+    let tables = resp[\"tables\"].as_array().expect(\"tables array\");","+    let listed = tables","+        .iter()","+        .find(|t| {","+            t[\"database\"] == fixture.default_db_name().as_str()","+                && t[\"table\"] == fixture.default_table_name().as_str()","+        })","+        .expect(\"table with BLOOM index meta must be listed\");","+    assert_eq!(listed[\"engine\"], \"FUSE\");","+    let create_query = listed[\"create_query\"].as_str().expect(\"create_query\");","+    assert!(","+        create_query.contains(\"SYNC BLOOM INDEX id_bloom (id) filter_type = 'binary_fuse32'\"),","+        \"unexpected create_query: {create_query}\"","+    );","+","+    Ok(())","+}"],"additions":115,"deletions":0,"truncated":false},{"path":"src/query/service/tests/it/storages/testdata/caches_table.txt","lines":["@@ -4,7 +4,6 @@ DB.Table: 'system'.'caches', Table: caches-table_id:1, ver:0, Engine: SystemCach"," +-------------+----------------------------------------------+----------+----------+----------------------+----------+----------+----------+----------+"," | Column 0    | Column 1                                     | Column 2 | Column 3 | Column 4             | Column 5 | Column 6 | Column 7 | Column 8 |"," +-------------+----------------------------------------------+----------+----------+----------------------+----------+----------+----------+----------+","-| 'test-node' | '__pool:data'                                | 0        | 0        | 107374182            | 'bytes'  | 0 