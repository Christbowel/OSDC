e metadata written by a newer release may carry a `BLOOM` table index","+/// (`index_type = 4`). This release must still decode that metadata, so the","+/// table remains visible to listing and `SHOW CREATE TABLE`, while any","+/// unknown value is rejected as before.","+#[test]","+fn test_table_index_type_bloom_placeholder() -> anyhow::Result<()> {","+    let mut index = new_table_index();","+    index.index_type = TableIndexType::Bloom;","+    index.options = btreemap! {s(\"filter_type\") => s(\"binary_fuse32\")};","+","+    let mut p = index.to_pb();","+    assert_eq!(p.index_type, 4);","+    let got = mt::TableIndex::from_pb(p.clone())?;","+    assert_eq!(index, got);","+    assert_eq!(got.index_type.to_string(), \"BLOOM\");","+","+    let mut tbl = new_table_meta();","+    tbl.indexes.insert(index.name.clone(), index);","+    let got = mt::TableMeta::from_pb(tbl.to_pb())?;","+    assert_eq!(tbl, got);","+","+    p.index_type = 99;","+    assert_eq!(","+        Incompatible::new(s(\"invalid IndexType: 99\")),","+        mt::TableIndex::from_pb(p).unwrap_err()","+    );","+","+    Ok(())","+}","+"," #[test]"," fn test_incompatible() -> anyhow::Result<()> {","     let db_meta = new_db_meta();"],"additions":30,"deletions":0,"truncated":false},{"path":"src/meta/schema-api-test-suite/src/schema_api_test_suite.rs","lines":["@@ -7482,7 +7482,8 @@ impl SchemaApiTestSuite {","                     ver: VER,","                     min_reader_ver: MIN_READER_VER,","                     name: \"idx\".to_string(),","-                    index_type: 4,","+                    // No `TableIndexType` variant has this value.","+                    index_type: 99,","                     ..Default::default()","                 });","                 let table_key = TableId::new(table_id);","@@ -7709,7 +7710,8 @@ impl SchemaApiTestSuite {","                     ver: VER,","                     min_reader_ver: MIN_READER_VER,","                     name: \"idx\".to_string(),","-      