{"id":"87dd6a265e9f99e85cdc346a4034db6127bd5e1f","axis":"silent","repo":"datafuselabs/databend","sha":"87dd6a265e9f99e85cdc346a4034db6127bd5e1f","parsed":{"files":[{"path":"Cargo.lock","lines":["@@ -4133,6 +4133,7 @@ dependencies = [","  \"regex\",","  \"reqwest\",","  \"serde\",","+ \"serde_json\",","  \"sha2 0.10.9\",","  \"simple_hll\",","  \"tempfile\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/exception/src/exception.rs","lines":["@@ -24,6 +24,7 @@ use thiserror::Error;"," use crate::ErrorFrame;"," use crate::StackTrace;"," use crate::exception_backtrace::capture;","+use crate::redact::redact_url_secrets;"," use crate::span::Span;"," use crate::span::pretty_print_error;"," ","@@ -52,11 +53,12 @@ impl<C> ErrorCode<C> {","     }"," ","     pub fn display_text(&self) -> String {","-        if let Some(cause) = &self.cause {","+        let text = if let Some(cause) = &self.cause {","             format!(\"{}\\n{:?}\", self.display_text, cause)","         } else {","             self.display_text.clone()","-        }","+        };","+        redact_url_secrets(&text).into_owned()","     }"," ","     pub fn message(&self) -> String {","@@ -64,12 +66,12 @@ impl<C> ErrorCode<C> {","         if self.detail.is_empty() {","             msg","         } else {","-            format!(\"{}\\n{}\", msg, self.detail)","+            format!(\"{}\\n{}\", msg, self.detail())","         }","     }"," ","     pub fn detail(&self) -> String {","-        self.detail.clone()","+        redact_url_secrets(&self.detail).into_owned()","     }"," ","     #[must_use]"],"additions":6,"deletions":4,"truncated":false},{"path":"src/common/exception/src/lib.rs","lines":["@@ -25,6 +25,7 @@ mod exception_backtrace;"," mod exception_code;"," mod exception_flight;"," mod exception_into;","+mod redact;"," "," pub use context::ErrorFrame;"," pub use context::ResultExt;","@@ -40,4 +41,5 @@ pub use exception_backtrace::StackTrace;"," pub use exception_backtrace::USER_SET_ENABLE_BACKTRACE;"," pub use exception_backtrace::set_backtrace;"," pub use exception_into::SerializedError;","+pub use redact::redact_url_secrets;"," pub use span::merge_span;"],"additions":2,"deletions":0,"truncated":false},{"path":"src/common/exception/src/redact.rs","lines":["@@ -0,0 +1,123 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+//! Mask credential query parameters in URLs quoted by error messages.","+","+use std::borrow::Cow;","+","+/// Case-insensitive names of query parameters that carry credentials.","+const SENSITIVE_QUERY_PARAMS: &[&str] = &[","+    \"webidentitytoken\",","+    \"rolearn\",","+    \"x-amz-security-token\",","+    \"x-amz-signature\",","+    \"x-amz-credential\",","+    \"x-goog-signature\",","+    \"x-goog-credential\",","+    \"securitytoken\",","+    \"security-token\",","+    \"x-oss-security-token\",","+    \"x-oss-signature\",","+    \"signature\",","+    \"q-signature\",","+    \"x-cos-security-token\",","+    \"sig\",","+    \"delegation\",","+    \"token\",","+    \"access_token\",","+];","+","+const REDACTED: &str = \"***\";","+","+/// Mask the values of credential query parameters in `msg`.","+pub fn redact_url_secrets(msg: &str) -> Cow<'_, str> {","+    let bytes = msg.as_bytes();","+    let mut out: Option<String> = None;","+    // Bytes before `copied` are already handled (copied into `out`).","+    let mut copied = 0;","+    let mut i = 0;","+","+    while i < bytes.len() {","+        // A parameter starts after a query separator, or at the start of a","+        // quoted query string (e.g. `Url` debug output).","+        if !matches!(bytes[i], b'?' | b'&' | b'\"') {","+            i += 1;","+            continue;","+        }","+","+        let name_start = i + 1;","+        let name_len = bytes[name_start..]","+            .iter()","+            .position(|b| !(b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_')))","+            .unwrap_or(bytes.len() - name_start);","+        let name_end = name_start + name_len;","+        if bytes.get(name_end) != Some(&b'=') {","+            i += 1;","+            continue;","+        }","+        let name = &msg[name_start..name_end];","+        if !SENSITIVE_QUERY_PARAMS","+            .iter()","+            .any(|p| p.eq_ignore_ascii_case(name))","+        {","+            i += 1;","+            continue;","+        }","+","+        let value_start = name_end + 1;","+        let rest = &bytes[value_start..];","+        let scanned = rest","+            .iter()","+            .position(|b| is_query_value_end(*b))","+            .unwrap_or(rest.len());","+        let value_len = rest[..scanned]","+            .iter()","+            .rposition(|b| !is_closing_punct(*b))","+            .map_or(0, |p| p + 1);","+        let value_end = value_start + value_len;","+","+        if value_len > 0 {","+            let out = out.get_or_insert_with(|| String::with_capacity(msg.len()));","+            out.push_str(&msg[copied..value_start]);","+            out.push_str(REDACTED);","+            copied = value_end;","+        }","+        i = value_end;","+    }","+","+    match out {","+        None => Cow::Borrowed(msg),","+        Some(mut out) => {","+            out.push_str(&msg[copied..]);","+            Cow::Owned(out)","+        }","+    }","+}","+","+/// The next query parameter, a fragment, or a character a URL can't contain","+/// unescaped.","+fn is_query_value_end(b: u8) -> bool {","+    b.is_ascii_whitespace()","+        || b.is_ascii_control()","+        || matches!(","+            b,","+            b'&' | b'#' | b'\"' | b'`' | b'[' | b']' | b'{' | b'}' | b'<' | b'>'","+        )","+}","+","+/// Allowed inside a value, but at its end they close the quote, parenthesis or","+/// clause around the URL.","+fn is_closing_punct(b: u8) -> bool {","+    matches!(b, b'\\'' | b')' | b',')","+}"],"additions":123,"deletions":0,"truncated":false},{"path":"src/common/exception/tests/it/main.rs","lines":["@@ -16,3 +16,4 @@ mod error_code_result_ext;"," mod exception;"," mod exception_flight;"," mod prelude;","+mod redact;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/exception/tests/it/redact.rs","lines":["@@ -0,0 +1,171 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+use std::borrow::Cow;","+","+use databend_common_exception::ErrorCode;","+use databend_common_exception::SerializedError;","+use databend_common_exception::redact_url_secrets;","+","+// A JWT shaped web identity token.","+const TOKEN: &str = concat!(","+    \"eyJhbGciOiJSUzI1NiJ9\",","+    \".\",","+    \"eyJzdWIiOiJub2RlIn0\",","+    \".\",","+    \"c2ln_-\"","+);","+// IAM role names may contain `,`, `+`, `=`, `.`, `@`.","+const ROLE_ARN: &str = \"arn:aws:iam::123456789012:role/databend,query+x=y.z@w\";","+","+fn sts_url() -> String {","+    format!(","+        \"https://sts.zz-nowhere-1.amazonaws.com/?Action=AssumeRoleWithWebIdentity&RoleArn={ROLE_ARN}&WebIdentityToken={TOKEN}&Version=2011-06-15&RoleSessionName=s\"","+    )","+}","+","+fn assert_redacted(message: &str) {","+    assert!(!message.contains(TOKEN), \"{message}\");","+    assert!(!message.contains(ROLE_ARN), \"{message}\");","+    assert!(","+        message.contains(\"RoleArn=***&WebIdentityToken=***&\"),","+        \"{message}\"","+    );","+}","+","+fn assert_no_secret(text: &str) {","+    assert!(!text.contains(TOKEN), \"{text}\");","+    assert!(!text.contains(ROLE_ARN), \"{text}\");","+}","+","+#[test]","+fn test_redact_url_secrets() {","+    // reqwest quotes the URL in parentheses when the request can't be sent.","+    let sts = format!(\"error sending request for url ({})\", sts_url());","+    assert_eq!(","+        redact_url_secrets(&sts),","+        \"error sending request for url (https://sts.zz-nowhere-1.amazonaws.com/?Action=AssumeRoleWithWebIdentity&RoleArn=***&WebIdentityToken=***&Version=2011-06-15&RoleSessionName=s)\"","+    );","+","+    let cases = [","+        (","+            \"uri: http://nn:9870/webhdfs/v1/a?op=OPEN&delegation=HAAEaGRmcwRoZGZz\",","+            \"uri: http://nn:9870/webhdfs/v1/a?op=OPEN&delegation=***\",","+        ),","+        (","+            \"https://b.s3.amazonaws.com/k?X-Amz-Credential=AKIA%2F1&X-Amz-Security-Token=IQo%2Bb3==&x-amz-signature=abc\",","+            \"https://b.s3.amazonaws.com/k?X-Amz-Credential=***&X-Amz-Security-Token=***&x-amz-signature=***\",","+        ),","+        (","+            \"https://a.blob.core.windows.net/c/k?sv=2022-11-02&sig=AbC%2Bd%3D \\\"next\\\"\",","+            \"https://a.blob.core.windows.net/c/k?sv=2022-11-02&sig=*** \\\"next\\\"\",","+        ),","+        (","+            \"url: \\\"WebIdentityToken=abc&x=1\\\"\",","+            \"url: \\\"WebIdentityToken=***&x=1\\\"\",","+        ),","+        (","+            \"https://storage.googleapis.com/b/o?X-Goog-Algorithm=GOOG4-RSA-SHA256&X-Goog-Credential=sa%40p.iam.gserviceaccount.com%2F20240101%2Fauto%2Fstorage%2Fgoog4_request&X-Goog-Date=20240101T000000Z&X-Goog-Expires=3600&X-Goog-SignedHeaders=host&X-Goog-Signature=0a1b2c\",","+            \"https://storage.googleapis.com/b/o?X-Goog-Algorithm=GOOG4-RSA-SHA256&X-Goog-Credential=***&X-Goog-Date=20240101T000000Z&X-Goog-Expires=3600&X-Goog-SignedHeaders=host&X-Goog-Signature=***\",","+        ),","+        // Values keep going through characters a URL may carry unescaped.","+        (\"?token=user:pass@host/x#frag\", \"?token=***#frag\"),","+        (","+            \"?access_token=prefix,suffix&next=1\",","+            \"?access_token=***&next=1\",","+        ),","+        (\"?token=a'b(c)d&x=1\", \"?token=***&x=1\"),","+        (","+            \"error sending request for url (https://h/?token=a(b)c)\",","+            \"error sending request for url (https://h/?token=***)\",","+        ),","+        // Trailing quotes, parentheses and commas close the text around a URL.","+        (","+            \"url: 'https://h/?token=abc', then\",","+            \"url: 'https://h/?token=***', then\",","+        ),","+        (\"(https://h/?sig=abc),\", \"(https://h/?sig=***),\"),","+        // An ambiguous boundary masks more, never less.","+        (\"('https://h/?token=abc','x')\", \"('https://h/?token=***')\"),","+        (","+            \"{\\\"url\\\":\\\"https://h/?sig=abc\\\"}\",","+            \"{\\\"url\\\":\\\"https://h/?sig=***\\\"}\",","+        ),","+        (\"?token=abc\", \"?token=***\"),","+    ];","+    for (input, expected) in cases {","+        assert_eq!(redact_url_secrets(input), expected, \"{input}\");","+    }","+","+    // Unrelated messages and parameters are untouched and not copied.","+    for input in [","+        \"\",","+        \"path not found: a/b?c\",","+        \"https://host/k?versionId=1&partNumber=2\",","+        \"trailing separator &\",","+        \"tokens=1&signatures=2\",","+        \"?token=&x=1\",","+        \"SELECT token=1, sig=2 FROM t\",","+    ] {","+        assert!(","+            matches!(redact_url_secrets(input), Cow::Borrowed(_)),","+            \"{input}\"","+        );","+    }","+}","+","+#[test]","+fn test_error_code_masks_url_credentials() {","+    let url = sts_url();","+    let opendal_error = || {","+        opendal::Error::new(opendal::ErrorKind::Unexpected, \"request failed\")","+            .with_context(\"uri\", &url)","+            .set_source(anyhow::anyhow!(\"error sending request for url ({url})\"))","+    };","+","+    // Conversions.","+    let errors = vec![","+        ErrorCode::from(opendal_error()),","+        ErrorCode::from(","+            opendal::Error::new(opendal::ErrorKind::NotFound, \"missing\").with_context(\"uri\", &url),","+        ),","+        ErrorCode::from(std::io::Error::other(format!(\"io ({url})\"))),","+        ErrorCode::from(anyhow::anyhow!(\"anyhow ({url})\")),","+        // Call sites that format a storage error themselves.","+        ErrorCode::StorageUnavailable(format!(\"storage is not valid, cause: {}\", opendal_error())),","+        ErrorCode::StorageOther(opendal_error().to_string()),","+        ErrorCode::StorageOther(\"permission check failed\")","+            .add_message(format!(\"[Write] failed: {}\", opendal_error())),","+        ErrorCode::StorageOther(\"permission check failed\")","+            .add_detail(format!(\"[Read] failed: {}\", opendal_error())),","+        ErrorCode::StorageOther(\"x\").add_message_back(url.clone()),","+        ErrorCode::StorageOther(\"x\").add_detail_back(url.clone()),","+    ];","+","+    for error in errors {","+        assert_redacted(&error.message());","+        // The secret may sit in the detail part only.","+        assert_no_secret(&error.display_text());","+        assert_redacted(&format!(\"{error}\"));","+        assert_redacted(&format!(\"{error:?}\"));","+        assert_redacted(&error.clone().message());","+        // Flight / tonic transport between nodes.","+        assert_redacted(&SerializedError::from(&error).message);","+        assert_redacted(&ErrorCode::from(&SerializedError::from(&error)).message());","+        assert_redacted(tonic::Status::from(error).message());","+    }","+","+    let with_detail = ErrorCode::StorageOther(\"x\").add_detail(url.clone());","+    assert_redacted(&with_detail.detail());","+}"],"additions":171,"deletions":0,"truncated":false},{"path":"src/common/storage/Cargo.toml","lines":["@@ -41,6 +41,7 @@ rand = { workspace = true }"," regex = { workspace = true }"," reqwest = { workspace = true }"," serde = { workspace = true }","+serde_json = { workspace = true }"," sha2 = { workspace = true }"," simple_hll = { workspace = true, features = [\"serde_borsh\"] }"," thiserror = { workspace = true }"],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/storage/src/azblob_presign.rs","lines":["@@ -638,6 +638,7 @@ mod tests {","             account_name: String::new(),","             account_key: String::new(),","             root: root.to_string(),","+            allow_credential_chain: None,","             network_config: None,","         }","     }"],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/storage/src/operator.rs","lines":["@@ -21,6 +21,8 @@ use std::sync::LazyLock;"," use std::time::Duration;"," "," use anyhow::anyhow;","+use base64::Engine;","+use base64::engine::general_purpose::STANDARD as BASE64_STANDARD;"," use databend_common_base::base::GlobalInstance;"," use databend_common_base::runtime::GlobalIORuntime;"," use databend_common_base::runtime::metrics::FamilyCounter;","@@ -113,7 +115,7 @@ fn init_operator_uncached_with("," ) -> Result<Operator> {","     let op = match &cfg {","         StorageParams::Azblob(cfg) => build_operator(","-            init_azblob_operator(cfg)?,","+            init_azblob_operator(cfg, endpoint_policy_scope)?,","             cfg.network_config.as_ref(),","             endpoint_policy_scope,","             retry_stats.clone(),","@@ -125,7 +127,7 @@ fn init_operator_uncached_with(","             retry_stats.clone(),","         )?,","         StorageParams::Gcs(cfg) => build_operator(","-            init_gcs_operator(cfg)?,","+            init_gcs_operator(cfg, endpoint_policy_scope)?,","             cfg.network_config.as_ref(),","             endpoint_policy_scope,","             retry_stats.clone(),","@@ -166,7 +168,7 @@ fn init_operator_uncached_with(","             retry_stats.clone(),","         )?,","         StorageParams::S3(cfg) => build_operator(","-            init_s3_operator(cfg)?,","+            init_s3_operator(cfg, endpoint_policy_scope)?,","             cfg.network_config.as_ref(),","             endpoint_policy_scope,","             retry_stats.clone(),","@@ -382,7 +384,16 @@ fn get_http_client("," }"," "," /// init_azblob_operator will init an opendal azblob operator.","-pub fn init_azblob_operator(cfg: &StorageAzblobConfig) -> Result<impl Builder> {","+///","+/// Without the credential chain, the location must carry a complete shared key.","+fn init_azblob_operator(","+    cfg: &StorageAzblobConfig,","+    endpoint_policy_scope: EndpointPolicyScope,","+) -> Result<impl Builder> {","+    if !allow_credential_chain(cfg.allow_credential_chain, endpoint_policy_scope) {","+        check_external_azblob_credential(cfg)?;","+    }","+","     let builder = services::Azblob::default()","         // Endpoint","         .endpoint(&cfg.endpoint_url)","@@ -397,6 +408,45 @@ pub fn init_azblob_operator(cfg: &StorageAzblobConfig) -> Result<impl Builder> {","     Ok(builder)"," }"," ","+fn check_external_azblob_credential(cfg: &StorageAzblobConfig) -> Result<()> {","+    if cfg.account_key.is_empty() {","+        return Err(Error::new(","+            ErrorKind::InvalidInput,","+            anyhow!(\"azblob location requires `account_key`\"),","+        ));","+    }","+    // The shared key is only used when the account name is known; OpenDAL","+    // derives it from official Azure endpoints only.","+    if cfg.account_name.is_empty() && !is_official_azure_endpoint(&cfg.endpoint_url) {","+        return Err(Error::new(","+            ErrorKind::InvalidInput,","+            anyhow!(\"azblob location requires `account_name` with a custom `endpoint_url`\"),","+        ));","+    }","+    Ok(())","+}","+","+/// `<account>.<service>.<suffix>` with a known Azure Storage suffix.","+fn is_official_azure_endpoint(endpoint: &str) -> bool {","+    const KNOWN_ENDPOINT_SUFFIXES: [&str; 3] = [","+        \"core.windows.net\",","+        \"core.usgovcloudapi.net\",","+        \"core.chinacloudapi.cn\",","+    ];","+","+    let host = endpoint","+        .strip_prefix(\"https://\")","+        .or_else(|| endpoint.strip_prefix(\"http://\"))","+        .unwrap_or(endpoint);","+    let Some((account, rest)) = host.split_once('.') else {","+        return false;","+    };","+    let Some((_service, suffix)) = rest.split_once('.') else {","+        return false;","+    };","+    !account.is_empty() && KNOWN_ENDPOINT_SUFFIXES.contains(&suffix.trim_end_matches('/'))","+}","+"," /// init_fs_operator will init a opendal fs operator."," fn init_fs_operator(cfg: &StorageFsConfig) -> Result<impl Builder> {","     let mut builder = services::Fs::default();","@@ -411,16 +461,72 @@ fn init_fs_operator(cfg: &StorageFsConfig) -> Result<impl Builder> {"," }"," "," /// init_gcs_operator will init a opendal gcs operator.","-fn init_gcs_operator(cfg: &StorageGcsConfig) -> Result<impl Builder> {","-    let builder = services::Gcs::default()","+///","+/// Without the credential chain, only the `service_account` credential given","+/// in the location is used, or none at all.","+fn init_gcs_operator(","+    cfg: &StorageGcsConfig,","+    endpoint_policy_scope: EndpointPolicyScope,","+) -> Result<impl Builder> {","+    let mut builder = services::Gcs::default()","         .endpoint(&cfg.endpoint_url)","         .bucket(&cfg.bucket)","-        .root(&cfg.root)","-        .credential(&cfg.credential);","+        .root(&cfg.root);","+","+    if allow_credential_chain(cfg.allow_credential_chain, endpoint_policy_scope) {","+        builder = builder.credential(&cfg.credential);","+    } else {","+        builder = builder.disable_config_load().disable_vm_metadata();","+        if cfg.credential.is_empty() {","+            builder = builder.allow_anonymous();","+        } else {","+            builder = builder.credential(&sanitize_gcs_service_account(&cfg.credential)?);","+        }","+    }"," ","     Ok(builder)"," }"," ","+/// An explicit setting wins; otherwise only trusted storage may use the","+/// ambient credential chain.","+fn allow_credential_chain(explicit: Option<bool>, scope: EndpointPolicyScope) -> bool {","+    explicit.unwrap_or(scope == EndpointPolicyScope::Trusted)","+}","+","+/// Re-encode a base64 service account key with only the fields signing needs.","+fn sanitize_gcs_service_account(credential: &str) -> Result<String> {","+    let invalid = |reason: &str| {","+        Error::new(","+            ErrorKind::InvalidInput,","+            anyhow!(\"invalid gcs credential: {reason}\"),","+        )","+    };","+","+    let content = BASE64_STANDARD","+        .decode(credential.trim())","+        .map_err(|_| invalid(\"expect base64 encoded service account key json\"))?;","+    let value: serde_json::Value = serde_json::from_slice(&content)","+        .map_err(|_| invalid(\"expect base64 encoded service account key json\"))?;","+","+    if value.get(\"type\").and_then(|v| v.as_str()) != Some(\"service_account\") {","+        return Err(invalid(\"only `service_account` credentials are supported\"));","+    }","+    let field = |name: &str| {","+        value","+            .get(name)","+            .and_then(|v| v.as_str())","+            .filter(|v| !v.is_empty())","+            .ok_or_else(|| invalid(&format!(\"missing `{name}`\")))","+    };","+","+    let sanitized = serde_json::json!({","+        \"type\": \"service_account\",","+        \"client_email\": field(\"client_email\")?,","+        \"private_key\": field(\"private_key\")?,","+    });","+    Ok(BASE64_STANDARD.encode(sanitized.to_string()))","+}","+"," /// init_hdfs_operator will init an opendal hdfs operator."," #[cfg(feature = \"storage-hdfs\")]"," fn init_hdfs_operator(cfg: &StorageHdfsConfig) -> Result<impl Builder> {","@@ -470,7 +576,20 @@ fn init_memory_operator() -> Result<impl Builder> {"," }"," "," /// init_s3_operator will init a opendal s3 operator with input s3 config.","-fn init_s3_operator(cfg: &StorageS3Config) -> Result<impl Builder> {","+fn init_s3_operator(","+    cfg: &StorageS3Config,","+    endpoint_policy_scope: EndpointPolicyScope,","+) -> Result<impl Builder> {","+    if endpoint_policy_scope == EndpointPolicyScope::External && !is_valid_s3_region(&cfg.region) {","+        return Err(Error::new(","+            ErrorKind::InvalidInput,","+            anyhow!(","+                \"invalid s3 region {:?}: expect a single DNS label of ASCII letters, digits, '-' or '_'\",","+                cfg.region","+            ),","+        ));","+    }","+","     let mut builder = services::S3::default()","         // Endpoint.","         .endpoint(&cfg.endpoint_url)","@@ -552,6 +671,18 @@ fn init_s3_operator(cfg: &StorageS3Config) -> Result<impl Builder> {","     Ok(builder)"," }"," ","+/// Empty, or one DNS label such as `us-east-1`.","+fn is_valid_s3_region(region: &str) -> bool {","+    let bytes = region.as_bytes();","+    bytes.is_empty()","+        || (bytes.len() <= 63","+            && bytes[0].is_ascii_alphanumeric()","+            && bytes[bytes.len() - 1].is_ascii_alphanumeric()","+            && bytes","+                .iter()","+                .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_')))","+}","+"," /// init_obs_operator will init a opendal obs operator with input obs config."," fn init_obs_operator(cfg: &StorageObsConfig) -> Result<impl Builder> {","     let builde