not accept write concern\"},"],"additions":2,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/OWNERS.yml","lines":["@@ -12,6 +12,9 @@ filters:","   - \"*tassert*\":","     approvers:","       - 10gen/server-programmability","+  - \"*defang_invariant*\":","+    approvers:","+      - 10gen/server-programmability","   - \"*pin_code_segments*\":","     approvers:","       - 10gen/server-programmability"],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/defang_invariants_test.js","lines":["@@ -0,0 +1,168 @@","+/**","+ * Tests defanging of invariants to ensure that the server parameter and source locations","+ * are properly parsed and make sure the defanged invariant has tassert like behavior.","+ *","+ * The tests are ordered to minimize the number of server startup and shutdown cycles by","+ * reusing each server for as many assertions as possible. Servers are only ever shut","+ * down because the test asserted the server aborts, or because there are no assertions","+ * left that can run against that particular server.","+ *","+ * @tags: [","+ *   incompatible_with_windows_tls,","+ *   incompatible_aubsan,","+ * ]","+ */","+","+TestData.cleanUpCoreDumpsFromExpectedCrash = true;","+","+const kFalseInvariantLocation = \"src/mongo/util/false_invariant.inl:1\";","+const kDummyInvariantLocation = \"path/dummy_invariant.cpp:12\";","+","+// Asserts that running {failInvariant: 1} aborts the server with the expected invariant","+// failure logs. Must only be called on a server whose false invariant is not defanged,","+// and must be the last assertion run against that server.","+function assertFailInvariantAborts(conn) {","+    clearRawMongoProgramOutput();","+","+    assert.throws(() => conn.getDB(\"admin\").runCommand({failInvariant: 1}));","+","+    const exitCode = waitProgram(conn.pid);","+    assert.eq(","+        exitCode,","+        MongoRunner.EXIT_ABORT,","+        `Expected server to exit with signal 6 (SIGABRT), got ${exitCode}`,","+    );","+","+    const logContents = rawMongoProgramOutput(\".*\");","+    assert(","+        logContents.search(/\"id\":23079/) >= 0,","+        \"Expected 'Invariant failure' log message with ID 23079 in server output\",","+    );","+    assert(","+        logContents.search(/\"id\":23080/) >= 0,","+        \"Expected 'aborting after invariant() failure' log message with ID 23080 in server output\",","+    );","+","+    MongoRunner.stopMongod(conn);","+}","+","+// Asserts that running {failInvariant: 1} on a server whose false invariant is defanged","+// only yields an InternalError and leaves the server running.","+function assertFailInvariantDefanged(conn) {","+    assert.commandFailedWithCode(","+        conn.getDB(\"admin\").runCommand({failInvariant: 1}),","+        ErrorCodes.InternalError,","+    );","+}","+","+// Asserts that getParameter returns the whole 'defangedInvariants' value that was set.","+function assertGetParameterReturnsValue(conn, expected) {","+    const res = assert.commandWorked(conn.adminCommand({getParameter: 1, defangedInvariants: 1}));","+    assert.docEq(","+        expected,","+        res.defangedInvariants,","+        \"getParameter should return the whole 'defangedInvariants' value that was set\",","+    );","+}","+","+function setServerParameterRuntime(conn, defangedInvariants) {","+    assert.commandWorked(","+        conn.adminCommand({setParameter: 1, defangedInvariants: defangedInvariants}),","+    );","+}","+","+// Case 1: a server with no defanged invariants. Used to verify that the false invariant","+// aborts the server when it is not defanged, and to determine the build version needed to","+// construct 'defangedInvariants' values for the later servers.","+const conn = MongoRunner.runMongod({});","+const version = assert.commandWorked(conn.adminCommand({buildInfo: 1})).version;","+assertFailInvariantAborts(conn);","+","+// Case 2: a server started without any defanged invariants, reused for all assertions","+// that only need the parameter to be set at runtime. Ends by verifying that replacing the","+// parameter value with one that no longer defangs the false invariant makes the invariant","+// abort the server again.","+{","+    const conn = MongoRunner.runMongod({});","+","+    // The value associated with the current version must be an array of invariant","+    // locations.","+    assert.commandFailedWithCode(","+        conn.adminCommand({","+            setParameter: 1,","+            defangedInvariants: {[version]: kFalseInvariantLocation},","+        }),","+        ErrorCodes.TypeMismatch,","+        \"Expected the parameter to reject a non-array value for the current version\",","+    );","+","+    // Every element of the array must be a string.","+    assert.commandFailedWithCode(","+        conn.adminCommand({","+            setParameter: 1,","+            defangedInvariants: {[version]: [kFalseInvariantLocation, 42]},","+        }),","+        ErrorCodes.TypeMismatch,","+        \"Expected the parameter to reject an array containing a non-string element\",","+    );","+","+    const defangCurrentVersionOnly = {[version]: [kFalseInvariantLocation]};","+    setServerParameterRuntime(conn, defangCurrentVersionOnly);","+    assertGetParameterReturnsValue(conn, defangCurrentVersionOnly);","+","+    const defangWithExtraVersion = {","+        ...defangCurrentVersionOnly,","+        \"0.0.0-test\": [kDummyInvariantLocation],","+    };","+    setServerParameterRuntime(conn, defangWithExtraVersion);","+    assertGetParameterReturnsValue(conn, defangWithExtraVersion);","+","+    // A runtime-defanged invariant must not abort the server.","+    assertFailInvariantDefanged(conn);","+","+    // Replacing the value with one that no longer defangs the false invariant must make","+    // the invariant abort the server again.","+    setServerParameterRuntime(conn, {[version]: [kDummyInvariantLocation]});","+    assertFailInvariantAborts(conn);","+}","+","+// Case 3: a runtime-defanged server, used to verify that replacing the parameter value","+// with one that has no entry for the current version makes the invariant abort the server","+// again. Must be the last assertion run against this server.","+{","+    const conn = MongoRunner.runMongod({});","+    setServerParameterRuntime(conn, {[version]: [kFalseInvariantLocation]});","+    setServerParameterRuntime(conn, {\"0.0.0-test\": [kFalseInvariantLocation]});","+","+    assertFailInvariantAborts(conn);","+}","+","+// Case 4: a server defanged at startup with only the current version, used to verify","+// that getParameter returns the whole value set at startup and that a startup-defanged","+// invariant does not abort the server.","+{","+    const defangCurrentVersionOnly = {[version]: [kFalseInvariantLocation]};","+    const conn = MongoRunner.runMongod({","+        setParameter: \"defangedInvariants=\" + tojson(defangCurrentVersionOnly),","+    });","+    assertGetParameterReturnsValue(conn, defangCurrentVersionOnly);","+","+    assertFailInvariantDefanged(conn);","+","+    MongoRunner.stopMongod(conn, undefined, {allowedExitCode: MongoRunner.EXIT_ABRUPT});","+}","+","+// Case 5: a server defanged at startup with an entry for an additional version, used to","+// verify that getParameter returns the whole value set at startup.","+{","+    const defangWithExtraVersion = {","+        [version]: [kFalseInvariantLocation],","+        \"0.0.0-test\": [kDummyInvariantLocation],","+    };","+    const conn = MongoRunner.runMongod({","+        setParameter: \"defangedInvariants=\" + tojson(defangWithExtraVersion),","+    });","+    assertGetParameterReturnsValue(conn, defangWithExtraVersion);","+","+    MongoRunner.stopMongod(conn);","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"jstests/replsets/all_commands_downgrading_to_upgraded.js","lines":["@@ -850,6 +850,7 @@ const allCommands = {","             assert.commandWorked(conn.getDB(dbName).runCommand({drop: collName}));","         },","     },","+    failInvariant: {skip: isAnInternalCommand},","     features: {command: {features: 1}},","     filemd5: {","         setUp: function (conn) {"],"additions":1,"deletions":0,"truncated":false},{"path":"jstests/replsets/db_reads_while_recovering_all_commands.js","lines":["@@ -307,6 +307,7 @@ const allCommands = {","         expectFailure: true,","         expectedErrorCode: ErrorCodes.NotPrimaryOrSecondary,","     },","+    failInvariant: {skip: isAnInternalCommand},","     features: {skip: isNotAUserDataRead},","     filemd5: {skip: isNotAUserDataRead},","     find: {"],"additions":1,"deletions":0,"truncated":false},{"path":"jstests/sharding/all_commands_direct_shard_connection_auth.js","lines":["@@ -687,6 +687,7 @@ const allCommands = {","             assert.commandWorked(mongoS.getDB(dbName).runCommand({drop: collName}));","         },","     },","+    failInvariant: {skip: isAnInternalCommand},","     features: {command: {features: 1}, shouldFail: false},","     filemd5: {","         setUp: function (mongoS) {"],"additions":1,"deletions":0,"truncated":false},{"path":"jstests/sharding/database_versioning_all_commands.js","lines":["@@ -655,6 +655,7 @@ const allTestCases = {","             conditional: true,","         },","         explain: {skip: \"already tested by each CRUD command through the 'explain' field\"},","+        failInvariant: {skip: \"internal command\", conditional: true},","         features: {skip: \"executes locally on mongos (not sent to any remote node)\"},","         filemd5: {","             run: {","@@ -1405,6 +1406,7 @@ const allTestCases = {","         eseRotateActiveKEK: {skip: \"TODO\", conditional: true},","         explain: {skip: \"TODO\"},","         exportCollection: {skip: \"TODO\", conditional: true},","+        failInvariant: {skip: \"internal command\", conditional: true},","         features: {skip: \"TODO\"},","         filemd5: {skip: \"TODO\"},","         find: {skip: \"TODO\"},"],"additions":2,"deletions":0,"truncated":false},{"path":"jstests/sharding/read_write_concern_defaults_application.js","lines":["@@ -603,6 +603,7 @@ let testCases = {","     endSessions: {skip: \"does not accept read or write concern\"},","     eseRotateActiveKEK: {skip: \"does not accept read or write concern\"},","     explain: {skip: \"TODO SERVER-45478\"},","+    failInvariant: {skip: \"internal command\"},","     features: {skip: \"internal command\"},","     filemd5: {skip: \"does not accept read or write concern\"},","     find: {"],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/commands/BUILD.bazel","lines":["@@ -744,6 +744,7 @@ mongo_cc_library(","         \"test_commands.cpp\",","         \"whats_my_uri_cmd.cpp\",","         \":sysprofile_gen\",","+        \"//src/mongo/util:false_invariant.inl\",","     ],","     deps = [","         \":test_commands_enabled\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/commands/test_commands.cpp","lines":["@@ -302,6 +302,49 @@ MONGO_REGISTER_COMMAND(CommandFeatureFlaggedOnLatestFCVTestCmd91)","     .requiresFeatureFlag(feature_flags::gFeatureFlagBlender)","     .forShard();"," ","+","+class FailInvariantTestCmd : public BasicCommand {","+public:","+    FailInvariantTestCmd() : BasicCommand(\"failInvariant\") {}","+","+    bool adminOnly() const override {","+        return true;","+    }","+","+    AllowedOnSecondary secondaryAllowed(ServiceContext*) const override {","+        return AllowedOnSecondary::kAlways;","+    }","+","+    bool supportsWriteConcern(const BSONObj& cmd) const override {","+        return false;","+    }","+","+    Status checkAuthForOperation(OperationContext*,","+                                 const DatabaseName&,","+                                 const BSONObj&) const override {","+        return Status::OK();","+    }","+","+    bool requiresAuthzChecks() const override {","+        return false;","+    }","+","+    std::string help() const override {","+        return \"internal. for testing only.\";","+    }","+","+    bool run(OperationContext* opCtx,","+             const DatabaseName& dbName,","+             const BSONObj& cmdObj,","+             BSONObjBuilder& result) override {","+        LOGV2(13420200, \"Test-only command 'failInvariant' invoked\");","+#include \"mongo/util/false_invariant.inl\"","+        uasserted(ErrorCodes::CommandFailed, \"Invariant did not fail\");","+    }","+};","+","+MONGO_REGISTER_COMMAND(FailInvariantTestCmd).testOnly().forShard();","+"," }  // namespace"," "," std::string TestingDurableHistoryPin::getName() {"],"additions":43,"deletions":0,"truncated":false},{"path":"src/mongo/util/BUILD.bazel","lines":["@@ -530,6 +530,22 @@ idl_generator(","     src = \"assert_util_parameters.idl\","," )"," ","+idl_generator(","+    name = \"defang_invariants_parameters_gen\",","+    src = \"defang_invariants_parameters.idl\",","+)","+","+mongo_cc_library(","+    name = \"defang_invariants_parameters\",","+    srcs = [","+        \"defang_invariants_parameters.cpp\",","+        \":defang_invariants_parameters_gen\",","+    ],","+    deps = [","+        \"//src/mongo/db:server_base\",","+    ],","+)","+"," mongo_cc_library(","     name = \"assert_util_params\",","     srcs = [","@@ -537,6 +553,7 @@ mongo_cc_library(","         \":assert_util_parameters_gen\",","     ],","     deps = [","+        \":defang_invariants_parameters\",","         \"//src/mongo/db:server_base\",","     ],"," )"],"additions":17,"deletions":0,"truncated":false},{"path":"src/mongo/util/defang_invariants_parameters.cpp","lines":["@@ -0,0 +1,103 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/bson/json.h\"","+#include \"mongo/platform/rwmutex.h\"","+#include \"mongo/util/defang_invariants_parameters_gen.h\"","+#include \"mongo/util/invariant_action_hook.h\"","+#include \"mongo/util/string_map.h\"","+#include \"mongo/util/version.h\"","+","+#include <algorithm>","+#include <iterator>","+","+#include <fmt/core.h>","+","+namespace mongo {","+","+namespace {","+// Cannot use synchronized value because we must use RWMutex","+RWMutex defangedInvariantsMutex;","+BSONObj defangedInvariantsAllVersions;","+StringSet defangedInvariants;","+","+bool lookupInvariantAbortsImpl(std::string_view invariantID) {","+    auto _ = std::shared_lock{defangedInvariantsMutex};","+    return !defangedInvariants.contains(invariantID);","+}","+","+Status setDefangedInvariants(const BSONObj& obj) {","+    auto versionElement = obj.getField(VersionInfoInterface::instance().version());","+","+    if (versionElement.eoo()) {","+        auto _ = std::unique_lock{defangedInvariantsMutex};","+        defangedInvariants.clear();","+        defangedInvariantsAllVersions = obj.getOwned();","+        return Status::OK();","+    }","+","+    if (versionElement.type() != BSONType::array) {","+        return Status(ErrorCodes::TypeMismatch,","+                      fmt::format(\"Expected the list of defanged invariants to be an array {}\",","+                                  versionElement.toString()));","+    }","+","+    auto defangedInvariantObj = versionElement.Array();","+","+    if (!std::all_of(defangedInvariantObj.begin(),","+                     defangedInvariantObj.end(),","+                     [](const BSONElement& elem) { return elem.type() == BSONType::string; })) {","+        return Status(","+            ErrorCodes::TypeMismatch,","+            fmt::format(","+                \"One or more invariants in the list of defanged invariants are not strings {}\",","+                versionElement.toString()));","+    }","+","+    StringSet newDefangedInvariants;","+    newDefangedInvariants.reserve(defangedInvariantObj.size());","+    std::transform(defangedInvariantObj.begin(),","+                   defangedInvariantObj.end(),","+                   std::inserter(newDefangedInvariants, newDefangedInvariants.begin()),","+                   [](const BSONElement& elem) { return elem.String(); });","+","+    auto _ = std::unique_lock{defangedInvariantsMutex};","+    defangedInvariants = std::move(newDefangedInvariants);","+    defangedInvariantsAllVersions = obj.getOwned();","+    return Status::OK();","+}","+}  // namespace","+","+void DefangedInvariantsServerParameter::append(OperationContext*,","+                                               BSONObjBuilder* b,","+                                               std::string_view name,","+                                               const boost::optional<TenantId>&) {","+    auto _ = std::shared_lock{defangedInvariantsMutex};","+    b->append(name, defangedInvariantsAllVersions);","+}","+","+Status DefangedInvariantsServerParameter::set(const BSONElement& newValueElement,","+                                              const boost::optional<TenantId>&) {","+    if (!newValueElement.isABSONObj()) {","+        return Status(","+            ErrorCodes::TypeMismatch,","+            fmt::format(","+                \"defangedInvariants parameter is expected to be an object. Actual: {} value: {}\",","+                typeName(newValueElement.type()),","+                newValueElement.toString()));","+    }","+    return setDefangedInvariants(newValueElement.Obj());","+}","+","+Status DefangedInvariantsServerParameter::setFromString(std::string_view str,","+                                                        const boost::optional<TenantId>&) try {","+    return setDefangedInvariants(fromjson(str));","+} catch (const DBException& ex) {","+    return ex.toStatus();","+}","+","+MONGO_INITIALIZER(RegisterInvariantActionLookup)(InitializerContext*) {","+    setLookupInvariantAbortsFn(lookupInvariantAbortsImpl);","+}","+","+}  // namespace mongo"],"additions":103,"deletions":0,"truncated":false},{"path":"src/mongo/util/defang_invariants_parameters.idl","lines":["@@ -0,0 +1,14 @@","+# Copyright (c) MongoDB, Inc.","+# SPDX-License-Identifier: SSPL-1.0","+global:","+    mod_visibility: private","+    cpp_namespace: \"mongo\"","+","+server_parameters:","+    defangedInvariants:","+        description: \"Controls which invariants are defanged (converted to tasserts) so that they throw instead of aborting.\"","+        set_at: [\"startup\", \"runtime\"]","+        cpp_class:","+            name: DefangedInvariantsServerParameter","+            override_set: true","+        redact: false",""],"additions":14,"deletions":0,"truncated":false}],"additions":359,"deletions":0,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-11-10T17:08:22.259300+00:00"}