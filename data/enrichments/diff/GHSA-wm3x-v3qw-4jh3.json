{"id":"GHSA-wm3x-v3qw-4jh3","axis":"advisories","repo":"rails/rails","sha":"2fc8838300133931e19eed3ea6cee76a7e83f19c","parsed":{"files":[{"path":"actionpack/CHANGELOG.md","lines":["@@ -1,3 +1,17 @@","+*   `ActionController::Parameters#each_key` returns `self` when given a block.","+","+    It returned the internal `ActiveSupport::HashWithIndifferentAccess`, which","+    does not respond to `permitted?`, so passing that return value to mass","+    assignment skipped the Strong Parameters check. `each`, `each_pair` and","+    `each_value` already return `self`.","+","+    Document that `ActionController::Parameters#as_json` returns every","+    parameter, permitted or not, in a hash that mass assignment does not check.","+","+    [GHSA-wm3x-v3qw-4jh3]","+","+    *Mike Dalessio*","+"," ## Rails 8.0.5.1 (July 29, 2026) ##"," "," *   No changes."],"additions":14,"deletions":0,"truncated":false},{"path":"actionpack/lib/action_controller/metal/strong_parameters.rb","lines":["@@ -197,15 +197,14 @@ class Parameters","     #     as_json(options=nil)","     #","     # Returns a hash that can be used as the JSON representation for the parameters.","-","-    ##","-    # :method: each_key","     #","-    # :call-seq:","-    #     each_key(&block)","+    # Like `#to_unsafe_h`, the hash holds every parameter, permitted or not, and","+    # mass assignment does not check it. Do not pass it to a model.","     #","-    # Calls block once for each key in the parameters, passing the key. If no block","-    # is given, an enumerator is returned instead.","+    #     params = ActionController::Parameters.new(name: \"Bob\", admin: true)","+    #     params.as_json           # => {\"name\" => \"Bob\", \"admin\" => true}","+    #     User.new(params)         # => ActiveModel::ForbiddenAttributesError","+    #     User.new(params.as_json) # => #<User name: \"Bob\", admin: true>"," ","     ##","     # :method: empty?","@@ -248,7 +247,7 @@ class Parameters","     # Returns the content of the parameters as a string."," ","     delegate :keys, :empty?, :exclude?, :include?,","-      :as_json, :to_s, :each_key, to: :@parameters","+      :as_json, :to_s, to: :@parameters"," ","     alias_method :has_key?, :include?","     alias_method :key?, :include?","@@ -420,6 +419,15 @@ def each_value(&block)","       self","     end"," ","+    # Calls block once for each key in the parameters, passing the key. If no block","+    # is given, an enumerator is returned instead.","+    def each_key(&block)","+      return to_enum(:each_key) unless block_given?","+      @parameters.each_key(&block)","+","+      self","+    end","+","     # Returns a new array of the values of the parameters.","     def values","       to_enum(:each_value).to_a"],"additions":16,"deletions":8,"truncated":false},{"path":"actionpack/test/controller/parameters/accessors_test.rb","lines":["@@ -31,6 +31,23 @@ class ParametersAccessorsTest < ActiveSupport::TestCase","     assert_same @params, @params.each_value { |_| _ }","   end"," ","+  test \"each_key returns self\" do","+    assert_same @params, @params.each_key { |_| _ }","+  end","+","+  test \"each_key yields each key\" do","+    keys = []","+    @params.each_key { |key| keys << key }","+    assert_equal @params.keys, keys","+  end","+","+  test \"each_key return value is rejected by mass assignment\" do","+    model = Class.new { include ActiveModel::API; attr_accessor :person }.new","+    assert_raises(ActiveModel::ForbiddenAttributesError) do","+      model.assign_attributes(@params.each_key { |_| _ })","+    end","+  end","+","   test \"[] retains permitted status\" do","     @params.permit!","     assert_predicate @params[:person], :permitted?",""],"additions":17,"deletions":0,"truncated":false}],"additions":47,"deletions":8,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-13T17:02:30.886735+00:00"}