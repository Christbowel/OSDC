ctURLs,","@@ -195,6 +202,7 @@ func (rule *Rule) execWithInput(input *ExecuteRuleInput, httpReq *retryablehttp."," \t\tComponent:       component,"," \t\tParameter:       actualParameter,"," \t\tKey:             key,","+\t\tFuzzedKeys:      append([]string(nil), fuzzedKeys...),"," \t\tValue:           value,"," \t\tOriginalValue:   originalValue,"," \t\tOriginalPayload: originalPayload,"],"additions":11,"deletions":3,"truncated":false},{"path":"pkg/protocols/http/fuzz_cookiejar.go","lines":["@@ -0,0 +1,222 @@","+package http","+","+import (","+\t\"fmt\"","+\t\"net/http\"","+\t\"net/http/cookiejar\"","+\t\"net/url\"","+\t\"slices\"","+\t\"strings\"","+","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/authprovider/authx\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/protocols/http/httpclientpool\"","+\thttputil \"github.com/projectdiscovery/nuclei/v3/pkg/protocols/utils/http\"","+\t\"github.com/projectdiscovery/retryablehttp-go\"","+\t\"golang.org/x/net/http/httpguts\"","+)","+","+// fuzzCookieJar leaves the cookies under test to the request while retaining","+// scope checks and response updates in the shared jar.","+type fuzzCookieJar struct {","+\thttp.CookieJar","+\tnames  map[string]struct{}","+\tfields []fuzzCookieField","+\thost   string","+}","+","+type fuzzCookieField struct {","+\tname string","+\traw  string","+\tauth bool","+}","+","+func (j *fuzzCookieJar) Cookies(u *url.URL) []*http.Cookie {","+\tcookies := j.CookieJar.Cookies(u)","+\tretained := cookies[:0]","+\tfor _, cookie := range cookies {","+\t\tif _, fuzzed := j.names[cookie.Name]; !fuzzed {","+\t\t\tretained = append(retained, cookie)","+\t\t}","+\t}","+\treturn retained","+}","+","+// prepare rebuilds from known field boundaries before each send. Parsing the","+// header here would mistake delimiters inside fuzzed values for cookie fields.","+func (j *fuzzCookieJar) prepare(req *http.Request) {","+\tif !j.trustsHost(req) {","+\t\treturn","+\t}","+\tvar cookies []*http.Cookie","+\tif j.CookieJar != nil {","+\t\tcookies = j.Cookies(httputil.CookieURL(req))","+\t}","+\tstored := make(map[string]struct{}, len(cookies))","+\tfor _, cookie := range cookies {","+\t\tstored[cookie.Name] = struct{}{}","+\t}","+\t// Analyzer follow-up requests rebuild the component with a different","+\t// payload. Use that request's fields rather than the initial payload.","+\tcurrent := httputil.CookieFields(req)","+\tvar retained []string","+\tfor _, field := range j.fields {","+\t\traw := field.raw","+\t\tif _, fuzzed := j.names[field.name]; fuzzed {","+\t\t\tfor _, candidate := range current {","+\t\t\t\tname, _, _ := strings.Cut(candidate, \"=\")","+\t\t\t\tif name == field.name {","+\t\t\t\t\traw = candidate","+\t\t\t\t\tbreak","+\t\t\t\t}","+\t\t\t}","+\t\t} else if _, exists := stored[field.name]; exists && !field.auth {","+\t\t\tcontinue","+\t\t}","+\t\tretained = append(retained, raw)","+\t}","+\tif len(retained) == 0 {","+\t\treq.Header.Del(\"Cookie\")","+\t} else {","+\t\treq.Header.Set(\"Cookie\", strings.Join(retained, \"; \"))","+\t}","+}","+","+func (j *fuzzCookieJar) trustsHost(req *http.Request) bool {","+\tif req.URL == nil {","+\t\treturn false","+\t}","+\t// Match net/http's sensitive-header forwarding rule, including IDNA and","+\t// the IPv6 zone guard. Cookie jar domain/path/secure checks remain separate.","+\thost, hostErr := httpguts.PunycodeHostPort(req.URL.Hostname())","+\tparent, parentErr := httpguts.PunycodeHostPort(j.host)","+\tif hostErr != nil || parentErr != nil {","+\t\treturn false","+\t}","+\thost, parent = strings.ToLower(host), strings.ToLower(parent)","+\treturn host == parent || (!strings.ContainsAny(host, \":%\") && strings.HasSuffix(host, \".\"+parent))","+}","+","+func removeFuzzedCookieFields(req *http.Request, keys []string) {","+\tfields := httputil.CookieFields(req)","+\tif strings.Join(fields, \"; \") != strings.Join(req.Header.Values(\"Cookie\"), \"; \") {","+\t\tfields = nil","+\t\tfor _, header := range req.Header.Values(\"Cookie\") {","+\t\t\tfields = append(fields, httputil.SplitCookieHeader(header)...)","+\t\t}","+\t}","+\tretained := fields[:0]","+\tfor _, field := range fields {","+\t\tname, _, _ := strings.Cut(field, \"=\")","+\t\tif !slices.Contains(keys, strings.TrimSpace(name)) {","+\t\t\tretained = append(retained, field)","+\t\t}","+\t}","+\t// Auth must not parse delimiter fragments inside the target payload as","+\t// independent cookies. The immutable structured fields retain that payload","+\t// for restoration after auth has installed the non-target credentials.","+\tif len(retained) == 0 {","+\t\treq.Header.Del(\"Cookie\")","+\t} else {","+\t\treq.Header.Set(\"Cookie\", strings.Join(retained, \"; \"))","+\t}","+}","+","+func restoreFuzzedCookieFields(req *http.Request, keys []string) {","+\toriginal := httputil.CookieFields(req)","+\tif strings.Join(original, \"; \") == strings.Join(req.Header.Values(\"Cookie\"), \"; \") {","+\t\treturn","+\t}","+\t// Auth or custom headers can replace cookies. Keep their non-target","+\t// fields, then restore only the fields deliberately selected for fuzzing.","+\tvar fields []string","+\tfor _, header := range req.Header.Values(\"Cookie\") {","+\t\tfor _, field := range httputil.SplitCookieHeader(header) {","+\t\t\tname, _, _ := strings.Cut(field, \"=\")","+\t\t\tif !slices.Contains(keys, strings.TrimSpace(name)) {","+\t\t\t\tfields = append(fields, strings.TrimLeft(field, \" \\t\"))","+\t\t\t}","+\t\t}","+\t}","+\tfor _, field := range original {","+\t\tname, _, _ := strings.Cut(field, \"=\")","+\t\tif slices.Contains(keys, name) {","+\t\t\tfields = append(fields, field)","+\t\t}","+\t}","+\treq.Header.Set(\"Cookie\", strings.Join(fields, \"; \"))","+\thttputil.SetCookieFields(req, fields)","+}","+","+func (request *Request) preserveFuzzedCookies(client *retryablehttp.Client, config *httpclientpool.Configuration, hostname string, req *http.Request, keys []string) (*retryablehttp.Client, error) {","+\tjar := client.HTTPClient.Jar","+\t// Explicit input jars already get an isolated client. If an input has no","+\t// jar, obtain one using the cached jar without modifying the cached client.","+\tif config.Connection == nil || !config.Connection.HasCookieJar() {","+\t\tisolatedJar, ok := jar.(*cookiejar.Jar)","+\t\tif jar != nil && !ok {","+\t\t\treturn nil, fmt.Errorf(\"could not isolate cookie jar for cookie fuzzing: unsupported jar %T\", jar)","+\t\t}","+\t\tif jar == nil {","+\t\t\tvar err error","+\t\t\tisolatedJar, err = cookiejar.New(nil)","+\t\t\tif err != nil {","+\t\t\t\treturn nil, fmt.Errorf(\"could not create isolated cookie fuzzing client: %w\", err)","+\t\t\t}","+\t\t}","+\t\tconfig = config.Clone()","+\t\tif config.Connection == nil {","+\t\t\tconfig.Connection = &httpclientpool.ConnectionConfiguration{}","+\t\t}","+\t\tconfig.Connection.SetCookieJar(isolatedJar)","+\t\tvar err error","+\t\tclient, err = httpclientpool.Get(request.options.Options, config, hostname)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"could not get isolated cookie fuzzing client: %w\", err)","+\t\t}","+\t}","+\tnames := make(map[string]struct{}, len(keys))","+\tfor _, key := range keys {","+\t\tnames[key] = struct{}{}","+\t}","+\tview := &fuzzCookieJar{CookieJar: jar, names: names, host: req.URL.Hostname()}","+\tfor _, field := range httputil.CookieFields(req) {","+\t\tname, _, _ := strings.Cut(field, \"=\")","+\t\tname = strings.TrimSpace(name)","+\t\tview.fields = append(view.fields, fuzzCookieField{name: name, raw: field, auth: authx.IsAuthCookie(req.Context(), name)})","+\t}","+\tif jar != nil {","+\t\tclient.HTTPClient.Jar = view","+\t} else {","+\t\t// The temporary explicit jar only bypassed the client cache. Cookie","+\t\t// reuse remains disabled, including learning response cookies.","+\t\tclient.HTTPClient.Jar = nil","+\t}","+\t// This client belongs to one generated request and its synchronous analyzer","+\t// follow-ups. Reset protection before each attempt, after any prior redirect.","+\tclient.RequestLogHook = func(req *http.Request, _ int) {","+\t\tif jar != nil {","+\t\t\tclient.HTTPClient.Jar = view","+\t\t}","+\t\tview.prepare(req)","+\t}","+\tcheckRedirect := client.HTTPClient.CheckRedirect","+\tclient.HTTPClient.CheckRedirect = func(req *http.Request, via []*http.Request) error {","+\t\ttrusted := view.trustsHost(req)","+\t\tfor _, previous := range via {","+\t\t\ttrusted = trusted && view.trustsHost(previous)","+\t\t}","+\t\tif !trusted {","+\t\t\t// Go permanently strips the explicit cookies after an untrusted","+\t\t\t// hop. Use the base jar from then on, including a return to the origin.","+\t\t\tclient.HTTPClient.Jar = jar","+\t\t}","+\t\tif err := checkRedirect(req, via); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif trusted {","+\t\t\tview.prepare(req)","+\t\t}","+\t\treturn nil","+\t}","+\treturn client, nil","+}"],"additions":222,"deletions":0,"truncated":false},{"path":"pkg/protocols/http/fuzz_cookiejar_test.go","lines":["@@ -0,0 +1,253 @@","+package http","+","+import (","+\t\"context\"","+\t\"io\"","+\t\"net\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"strings\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/projectdiscovery/nuclei/v3/internal/tests/testutils\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/fuzz/component\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/protocols/http/httpclientpool\"","+\t\"github.com/projectdiscovery/retryablehttp-go\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func cookieFuzzingClient(t *testing.T, serverURL string, disabled bool) (*Request, *retryablehttp.Client, *httpclientpool.Configuration) {","+\tt.Helper()","+\toptions := testutils.DefaultOptions.Copy()","+\toptions.SetExecutionID(t.Name())","+\toptions.Retries = 1","+\ttestutils.Init(options)","+\tt.Cleanup(func() { testutils.Cleanup(options) })","+\texecutorOptions := testutils.NewMockExecuterOptions(options, nil)","+\tt.Cleanup(executorOptions.RateLimiter.Stop)","+\tconfig := &httpclientpool.Configuration{DisableCookie: disabled, RedirectFlow: httpclientpool.FollowAllRedirect, MaxRedirects: 5}","+\tclient, err := httpclientpool.Get(options, config, serverURL)","+\trequire.NoError(t, err)","+\treturn &Request{options: executorOptions}, client, config","+}","+","+func cookieMutation(t *testing.T, target, key, value string) (*component.Cookie, *retryablehttp.Request) {","+\tt.Helper()","+\treq, err := retryablehttp.NewRequest(http.MethodGet, target, nil)","+\trequire.NoError(t, err)","+\treq.Header.Set(\"Cookie\", \"session=old; account=base; preference=dark\")","+\tcookies := component.NewCookie()","+\tparsed, err := cookies.Parse(req)","+\trequire.NoError(t, err)","+\trequire.True(t, parsed)","+\trequire.NoError(t, cookies.SetValue(key, value))","+\trebuilt, err := cookies.Rebuild()","+\trequire.NoError(t, err)","+\treturn cookies, rebuilt","+}","+","+func sendCookieMutation(client *retryablehttp.Client, req *retryablehttp.Request) error {","+\tresp, err := client.Do(req)","+\tif err != nil {","+\t\treturn err","+\t}","+\t_, err = io.Copy(io.Discard, resp.Body)","+\tcloseErr := resp.Body.Close()","+\tif err != nil {","+\t\treturn err","+\t}","+\treturn closeErr","+}","+","+func TestCookieFuzzingClientIsolation(t *testing.T) {","+\tfor _, disabled := range []bool{false, true} {","+\t\tname := \"reuse enabled\"","+\t\tif disabled {","+\t\t\tname = \"reuse disabled\"","+\t\t}","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\treceived := make(chan string, 2)","+\t\t\trelease := make(chan struct{})","+\t\t\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\t\t\treceived <- r.Header.Get(\"Cookie\")","+\t\t\t\t<-release","+\t\t\t\thttp.SetCookie(w, &http.Cookie{Name: \"session\", Value: \"reissued\", Path: \"/\"})","+\t\t\t}))","+\t\t\tdefer server.Close()","+\t\t\tdefer close(release)","+\t\t\trequest, cached, config := cookieFuzzingClient(t, server.URL, disabled)","+\t\t\t