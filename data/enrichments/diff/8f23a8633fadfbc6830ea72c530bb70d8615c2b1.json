l.Get(request.options.Options, config, server.URL)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Same(t, cached, again)","+\t\t\trequire.Equal(t, baseJar, cached.HTTPClient.Jar)","+\t\t\tif baseJar != nil {","+\t\t\t\trequire.Contains(t, baseJar.Cookies(parsed), &http.Cookie{Name: \"session\", Value: \"reissued\"})","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestCookieFuzzingRetryAndFollowUp(t *testing.T) {","+\treceived := make(chan string, 3)","+\tvar attempts atomic.Int32","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\treceived <- r.Header.Get(\"Cookie\")","+\t\tif attempts.Add(1) == 1 {","+\t\t\thttp.SetCookie(w, &http.Cookie{Name: \"session\", Value: \"reissued\", Path: \"/\"})","+\t\t\thttp.SetCookie(w, &http.Cookie{Name: \"account\", Value: \"fresh\", Path: \"/\"})","+\t\t\tw.WriteHeader(http.StatusServiceUnavailable)","+\t\t}","+\t}))","+\tdefer server.Close()","+\trequest, cached, config := cookieFuzzingClient(t, server.URL, false)","+\tparsed, err := url.Parse(server.URL)","+\trequire.NoError(t, err)","+\tcached.HTTPClient.Jar.SetCookies(parsed, []*http.Cookie{{Name: \"account\", Value: \"stored\", Path: \"/\"}})","+\tcookies, mutation := cookieMutation(t, server.URL, \"session\", `old\"`)","+\tclient, err := request.preserveFuzzedCookies(cached, config, server.URL, mutation.Request, []string{\"session\"})","+\trequire.NoError(t, err)","+\t// The normal policy does not retry 503 responses. Force this retry to test","+\t// payload preservation and cookie learning between attempts.","+\tclient.CheckRetry = func(_ context.Context, resp *http.Response, err error) (bool, error) {","+\t\treturn resp != nil && resp.StatusCode == http.StatusServiceUnavailable, err","+\t}","+\tclient.Backoff = func(_, _ time.Duration, _ int, _ *http.Response) time.Duration { return 0 }","+\trequire.NoError(t, sendCookieMutation(client, mutation))","+\trequire.NoError(t, cookies.SetValue(\"session\", `old\"followup`))","+\tfollowup, err := cookies.Rebuild()","+\trequire.NoError(t, err)","+\t// The time analyzer copies post-parse headers onto rebuilt requests.","+\tfollowup.Header = mutation.Header.Clone()","+\trequire.NoError(t, sendCookieMutation(client, followup))","+\trequire.Len(t, received, 3)","+\trequire.Equal(t, `session=old\"; preference=dark; account=stored`, <-received)","+\trequire.Equal(t, `session=old\"; preference=dark; account=fresh`, <-received)","+\trequire.Equal(t, `session=old\"followup; preference=dark; account=fresh`, <-received)","+}","+","+func TestCookieFuzzingCrossHostRedirect(t *testing.T) {","+\treceived := make(chan string, 2)","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\treceived <- r.Header.Get(\"Cookie\")","+\t\tif r.URL.Path == \"/start\" {","+\t\t\thttp.Redirect(w, r, \"http://\"+strings.Replace(r.Host, \"127.0.0.1\", \"localhost\", 1)+\"/target\", http.StatusFound)","+\t\t}","+\t}))","+\tdefer server.Close()","+\trequest, cached, config := cookieFuzzingClient(t, server.URL, false)","+\totherURL, err := url.Parse(strings.Replace(server.URL, \"127.0.0.1\", \"localhost\", 1))","+\trequire.NoError(t, err)","+\tcached.HTTPClient.Jar.SetCookies(otherURL, []*http.Cookie{{Name: \"session\", Value: \"other-host\", Path: \"/\"}})","+\t_, mutation := cookieMutation(t, server.URL+\"/start\", \"session\", `old\"`)","+\tclient, err := request.preserveFuzzedCookies(cached, config, server.URL, mutation.Request, []string{\"session\"})"],"additions":186,"deletions":0,"truncated":false}],"additions":598,"deletions":13,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-06T14:36:20.381041+00:00"}