 @@","+package authx","+","+import (","+\t\"net/http\"","+\t\"testing\"","+","+\t\"github.com/projectdiscovery/retryablehttp-go\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestCookieAuthOwnershipIsRequestLocal(t *testing.T) {","+\treq, err := retryablehttp.NewRequest(http.MethodGet, \"https://example.com\", nil)","+\trequire.NoError(t, err)","+\tNewCookiesAuthStrategy(&Secret{Cookies: []Cookie{{Key: \"session\", Value: \"configured\"}}}).ApplyOnRR(req)","+\tcloned := req.Clone(req.Context())","+\tNewCookiesAuthStrategy(&Secret{Cookies: []Cookie{{Key: \"other\", Value: \"configured\"}}}).ApplyOnRR(cloned)","+\trequire.True(t, IsAuthCookie(req.Context(), \"session\"))","+\trequire.False(t, IsAuthCookie(req.Context(), \"other\"))","+\trequire.True(t, IsAuthCookie(cloned.Context(), \"session\"))","+\trequire.True(t, IsAuthCookie(cloned.Context(), \"other\"))","+\trequire.False(t, IsAuthCookie(cloned.Context(), \"Session\"))","+","+\tNewHeadersAuthStrategy(&Secret{Headers: []KV{{Key: \"Cookie\", Value: \"replacement=configured\"}}}).ApplyOnRR(cloned)","+\trequire.True(t, IsAuthCookie(cloned.Context(), \"replacement\"))","+\trequire.False(t, IsAuthCookie(cloned.Context(), \"session\"))","+\trequire.False(t, IsAuthCookie(cloned.Context(), \"other\"))","+\trequire.True(t, IsAuthCookie(req.Context(), \"session\"))","+}","+","+func TestHeaderAuthCookieOwnershipIgnoresQuotedFragments(t *testing.T) {","+\tfor _, header := range []string{`payload=\"a;session=probe\"`, `payload=\"a\\\";session=probe\"`, `payload=\"a;session=probe`} {","+\t\tt.Run(header, func(t *testing.T) {","+\t\t\treq, err := retryablehttp.NewRequest(http.MethodGet, \"https://example.com\", nil)","+\t\t\trequire.NoError(t, err)","+\t\t\tNewCookiesAuthStrategy(&Secret{Cookies: []Cookie{{Key: \"session\", Value: \"configured\"}}}).ApplyOnRR(req)","+\t\t\tNewHeadersAuthStrategy(&Secret{Headers: []KV{{Key: \"Cookie\", Value: header}}}).ApplyOnRR(req)","+\t\t\trequire.Equal(t, header, req.Header.Get(\"Cookie\"))","+\t\t\trequire.True(t, IsAuthCookie(req.Context(), \"payload\"))","+\t\t\trequire.False(t, IsAuthCookie(req.Context(), \"session\"))","+\t\t})","+\t}","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"pkg/authprovider/authx/cookies_auth.go","lines":["@@ -23,13 +23,16 @@ func NewCookiesAuthStrategy(data *Secret) *CookiesAuthStrategy {"," "," // Apply applies the cookies auth strategy to the request"," func (s *CookiesAuthStrategy) Apply(req *http.Request) {","+\tvar names []string"," \tfor _, cookie := range s.Data.Cookies {"," \t\tc := &http.Cookie{"," \t\t\tName:  cookie.Key,"," \t\t\tValue: cookie.Value,"," \t\t}"," \t\treq.AddCookie(c)","+\t\tnames = append(names, cookie.Key)"," \t}","+\tmarkCookieAuth(req, names)"," }"," "," // ApplyOnRR applies the cookies auth strategy to the retryable request","@@ -51,10 +54,13 @@ func (s *CookiesAuthStrategy) ApplyOnRR(req *retryablehttp.Request) {"," \t\treq.AddCookie(cookie)"," \t}"," \t// Add new cookies","+\tvar names []string"," \tfor _, cookie := range s.Data.Cookies {"," \t\treq.AddCookie(&http.Cookie{"," \t\t\tName:  cookie.Key,"," \t\t\tValue: cookie.Value,"," \t\t})","+\t\tnames = append(names, cookie.Key)"," \t}","+\tmarkCookieAuth(req.Request, names)"," }"],"additions":6,"deletions":0,"truncated":false},{"path":"pkg/authprovider/authx/headers_auth.go","lines":["@@ -2,7 +2,9 @@ package authx"," "," import ("," \t\"net/http\"","+\t\"strings\""," ","+\thttputil \"github.com/projectdiscovery/nuclei/v3/pkg/protocols/utils/http\""," \t\"github.com/projectdiscovery/retryablehttp-go\""," )"," ","@@ -26,6 +28,14 @@ func NewHeadersAuthStrategy(data *Secret) *HeadersAuthStrategy {"," func (s *HeadersAuthStrategy) Apply(req *http.Request) {"," \tfor _, header := range s.Data.Headers {"," \t\treq.Header[header.Key] = []string{header.Value}","+\t\tif strings.EqualFold(header.Key, \"Cookie\") {","+\t\t\tvar names []string","+\t\t\tfor _, part := range httputil.SplitCookieHeader(header.Value) {",