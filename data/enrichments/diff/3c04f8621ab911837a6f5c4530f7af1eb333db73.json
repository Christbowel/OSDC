{"id":"3c04f8621ab911837a6f5c4530f7af1eb333db73","axis":"silent","repo":"grafana/grafana","sha":"3c04f8621ab911837a6f5c4530f7af1eb333db73","parsed":{"files":[{"path":"e2e-playwright/panels-suite/text-sandbox.spec.ts","lines":["@@ -334,7 +334,9 @@ test.describe('Text sandbox network boundary', () => {","     await expect(page.locator('#host')).toHaveCount(1);","   });"," ","-  test('tracks asynchronous content size, rebuilds for theme changes, and blocks refreshed data', async ({ page }) => {","+  test('tracks asynchronous content size, preserves content on CSS changes, and blocks refreshed data', async ({","+    page,","+  }) => {","     const requests: string[] = [];","     await page.route('https://external.test/**', (route) => {","       requests.push(route.request().url());","@@ -366,8 +368,17 @@ test.describe('Text sandbox network boundary', () => {","     const previous = await page.locator('iframe').elementHandle();","     await page.evaluate(() => window.sandboxSession.update({ globalCss: '.markdown-html { color: rgb(4, 5, 6); }' }));","     await expect(page.frameLocator('iframe').getByText('Content')).toHaveCSS('color', 'rgb(4, 5, 6)');","-    expect(await previous!.evaluate((frame) => frame.isConnected)).toBe(false);","-    await expect(page.locator('iframe')).toHaveCSS('height', '40px');","+    // CSS-only updates must preserve runtime DOM changes and keep size observation active.","+    expect(await previous!.evaluate((frame) => frame.isConnected)).toBe(true);","+    await expect(page.locator('iframe')).toHaveCSS('height', '180px');","+    await page","+      .frameLocator('iframe')","+      .locator('#content')","+      .evaluate((content) => {","+        content.style.height = '220px';","+      });","+    await expect(page.locator('iframe')).toHaveCSS('height', '220px');","+    await expect.poll(() => page.evaluate(() => window.sandboxHeights.at(-1))).toBe(220);"," ","     await page.evaluate(() =>","       window.sandboxSession.update({ html: '<img src=\"https://external.test/refresh?secret=data\">' })"],"additions":14,"deletions":3,"truncated":false},{"path":"packages/grafana-ui/src/themes/GlobalStyles/textContentStyles.ts","lines":["@@ -0,0 +1,29 @@","+import { css } from '@emotion/react';","+","+import { type GrafanaTheme2 } from '@grafana/data';","+","+import { getAccessibilityStyles } from './accessibility';","+import { getCardStyles } from './card';","+import { getCodeStyles } from './code';","+import { getElementStyles } from './elements';","+import { getFilterTableStyles } from './filterTable';","+import { getFormElementStyles } from './forms';","+import { getMarkdownStyles } from './markdownStyles';","+import { getUtilityClassStyles } from './utilityClasses';","+","+/**","+ * Shared content styles for isolated Text documents, in the same order as GlobalStyles.","+ * Card and filter-table classes are included because saved v1 Text panel HTML relies on them.","+ */","+export function getTextContentStyles(theme: GrafanaTheme2) {","+  return css([","+    getAccessibilityStyles(theme),","+    getCodeStyles(theme),","+    getElementStyles(theme),","+    getFilterTableStyles(theme),","+    getFormElementStyles(theme),","+    getCardStyles(theme),","+    getMarkdownStyles(theme),","+    getUtilityClassStyles(theme),","+  ]);","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/unstable.ts","lines":["@@ -42,3 +42,4 @@ export { RangeSliderG14 } from './components/Slider/RangeSliderG14';"," export type { RangeSliderG14Props } from './components/Slider/types';"," export { usePanelNotices, usePanelStatusSnapshot, PanelStatusActions } from './components/PanelChrome';"," export { SanitizedSVG } from './components/SanitizedSVG/SanitizedSVG';","+export { getTextContentStyles } from './themes/GlobalStyles/textContentStyles';"],"additions":1,"deletions":0,"truncated":false},{"path":"public/app/plugins/panel/text/v2/SANDBOX.md","lines":["@@ -59,6 +59,7 @@ The parent and the frame talk over `postMessage` with the `grafana-text-frame-v1"," - `event.source` is this iframe's `contentWindow`."," - `event.origin` is `'null'`, the opaque origin."," - The message has this frame's random `channel` id and passes `isFrameNotification`.","+- After the `ready` handshake, the message carries the current render revision. Older revisions cannot complete, resize, fail, or report resources for the current render."," "," The parent treats every report from the frame as untrusted:"," ","@@ -66,6 +67,24 @@ The parent treats every report from the frame as untrusted:"," - It caps blocked URLs at `MAX_BLOCKED_URL_CHARS` per directive and origin, and URL counts at `MAX_BLOCKED_URL_COUNT`. A source over the cap is marked `truncated`, never listed in part."," - It ignores resize values outside a fixed range."," ","+## Content updates","+","+Initial render commands include the shared stylesheet. Content-only updates omit unchanged CSS to avoid repeatedly transporting inlined font data. A fresh document always receives the full stylesheet; omission is only accepted after a stylesheet has been installed, and an explicit empty string clears shared styles.","+","+Protected frames reuse their document for HTML changes while their policy and diagram configuration remain unchanged. Each update replaces the content container, disconnects its observer, cancels pending completion and violation timers, resets resource reports, and advances the render revision. The shared stylesheet, loaded fonts, and the evaluated Mermaid bundle remain in the document, so later diagrams don't request or evaluate the bundle again. A document that failed or reported blocked resources is replaced on the next HTML change instead; the controller makes that decision synchronously, so a failure batched into the same render as new HTML can't be overwritten by it. Mermaid work is serialized because the library uses document-global state; cancelled work cannot update the new content or complete its render.","+","+Policy and diagram configuration changes still create a new document. A document that reported blocked resources or failed also starts fresh on its next content update, so unchanged stylesheet violations are reported again. Legacy frames without a policy always recreate on content changes: removing their DOM cannot dispose scripts, timers, or listeners they may have installed.","+","+Browser CSP events do not carry render revisions. A delayed violation from a removed resource can therefore still appear in the current report; it remains a blocked request and does not grant permission. The revision guard rejects already-posted notifications from earlier renders.","+","+## Styling","+","+Text documents receive shared typography, element, code, Markdown, accessibility, form, legacy utility, card (`.card-*`) and filter table (`.filter-table`) styles, compiled once per theme. They do not copy feature-specific global styles such as dashboard layout or query editor styles. HTML that depends on those feature-specific classes should supply its own styles.","+","+Font faces are still collected from the application's global styles so configured fonts remain available, and their existing network policy and inlining rules are unchanged. The Text stylesheet is compiled into a detached CSSStyleSheet through Emotion and serialized from CSSOM, matching the browser's handling of unsupported selectors and invalid declarations without applying styles in the parent document.","+","+Content renders with fallback fonts while shared font preparation runs; an already-prepared cache entry is used immediately. Prepared CSS is applied through an authenticated `styles` command without replacing the document or content, including for legacy panels. Style commands retain the content revision and carry a monotonically increasing style revision, so stale font completions cannot measure newer content or styles. They preserve blocked-resource reports, pending Mermaid work, and script/input state. New policies still require new documents; a style command cannot change CSP or sandbox flags.","+"," ## Consent"," "," The frame reports CSP violations for the directives in `RESOURCE_DIRECTIVES`. `TextSandbox` groups them by origin and passes them to `sandboxConsent.ts`, which feeds the dashboard banner and the review modal."],"additions":19,"deletions":0,"truncated":false},{"path":"public/app/plugins/panel/text/v2/SandboxFrame.test.tsx","lines":["@@ -1,7 +1,8 @@","-import { act, fireEvent, render, screen } from '@testing-library/react';","+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';"," import { StrictMode } from 'react';"," "," import { SandboxFrame, type SandboxFrameProps, WATCHDOG_TIMEOUT_MS } from './SandboxFrame';","+import { TextSandbox } from './TextSandbox';"," import { loadSandboxMermaid, loadSandboxRuntime } from './loadSandboxRuntime';"," import { MAX_BLOCKED_URL_CHARS, textSandboxPolicy } from './sandboxPolicy';"," import { TEXT_FRAME_PROTOCOL } from './sandboxProtocol';","@@ -28,7 +29,15 @@ async function frame() {","   return screen.getByTitle<HTMLIFrameElement>('Text content');"," }"," ","+const notifications = new WeakMap<HTMLIFrameElement, { document: string; revision: number }>();","+"," function notify(frame: HTMLIFrameElement, type: string, extra = {}, envelope = {}) {","+  const current = notifications.get(frame) ?? { document: 'first', revision: 0 };","+  if (type === 'ready' && 'document' in extra && extra.document !== current.document) {","+    current.document = String(extra.document);","+    current.revision++;","+  }","+  notifications.set(frame, current);","   const shell = new DOMParser().parseFromString(frame.srcdoc, 'text/html');","   const channel = shell.querySelector('script')!.dataset.channel;","   fireEvent(","@@ -36,7 +45,14 @@ function notify(frame: HTMLIFrameElement, type: string, extra = {}, envelope = {","     new MessageEvent('message', {","       source: frame.contentWindow,","       origin: frame.hasAttribute('sandbox') ? 'null' : window.location.origin,","-      data: { protocol: TEXT_FRAME_PROTOCOL, channel, type, ...(type === 'ready' && { document: 'first' }), ...extra },","+      data: {","+        protocol: TEXT_FRAME_PROTOCOL,","+        channel,","+        revision: current.revision,","+        type,","+        ...(type === 'ready' && { document: 'first' }),","+        ...extra,","+      },","       ...envelope,","     })","   );","@@ -346,9 +362,9 @@ it('fills the minimum height without reporting it as content height', async () =","   expect(element.style.height).toBe('450px');"," });"," ","-it.each(['html', 'policy', 'globalCss'] as const)(","-  'recreates on %s changes and ignores the old generation',","-  async (field) => {","+it.each([{ policy: undefined }, { mermaid: { securityLevel: 'strict' as const } }, { diagramError: 'Changed error' }])(","+  'recreates on policy or diagram configuration changes: %j',","+  async (change) => {","     const options = props();","     const { rerender } = render(<SandboxFrame {...options} />);","     const previous = await frame();","@@ -356,7 +372,7 @@ it.each(['html', 'policy', 'globalCss'] as const)(","     const staleChannel = new DOMParser().parseFromString(previous.srcdoc, 'text/html').querySelector('script')!.dataset","       .channel;","     notify(previous, 'ready');","-    rerender(<SandboxFrame {...options} {...{ [field]: field === 'policy' ? undefined : options[field] + ' ' }} />);","+    rerender(<SandboxFrame {...options} {...change} />);","     const current = await frame();","     expect(current).not.toBe(previous);","     notify(","@@ -437,7 +453,7 @@ it('discards bootstrap completion for a replaced document', async () => {","   const options = props();","   const { rerender } = render(<SandboxFrame {...options} />);","   const previous = screen.getByTitle<HTMLIFrameElement>('Text content');","-  rerender(<SandboxFrame {...options} html=\"<p>Updated content</p>\" />);","+  rerender(<SandboxFrame {...options} policy={undefined} />);","   const current = await frame();","   await act(async () => resolve('stale runtime'));","   expect(current.srcdoc).toContain('/* trusted runtime */');","@@ -537,7 +553,7 @@ it.each(['refresh', 'unmount'] as const)('discards Mermaid loading after %s', as","     unmount();","   }","   await act(async () => resolve('late Mermaid source'));","-  expect(postMessage).not.toHaveBeenCalled();","+  expect(postMessage).not.toHaveBeenCalledWith(expect.objectContaining({ type: 'mermaid-source' }), '*');"," });"," "," it('reports a Mermaid loading error without removing permitted content', async () => {","@@ -608,14 +624,14 @@ it('fails closed on a forbidden shell policy and preserves TrustedHTML branding","     const errorCount = jest.mocked(options.onState).mock.calls.length;","     act(() => jest.runAllTimers());","     expect(options.onState).toHaveBeenCalledTimes(errorCount);","-    view.rerender(<SandboxFrame {...options} html=\"<p>Refreshed secret</p>\" />);","+    view.rerender(<SandboxFrame {...options} globalCss=\"p{color:red}\" html=\"<p>Refreshed secret</p>\" />);","     await frame();","     expect(createPolicy).toHaveBeenCalledWith('grafana-text-panel-shell', expect.any(Object));","     const shell = createHTML.mock.calls[0][0];","     expect(shell).toContain('trusted runtime');","     expect(shell).not.toContain('Refreshed secret');","     expect(setter).toHaveBeenCalledWith(createHTML.mock.results[0].value);","-    view.rerender(<SandboxFrame {...options} html=\"<p>Another generation</p>\" />);","+    view.rerender(<SandboxFrame {...options} globalCss=\"p{color:blue}\" html=\"<p>Another generation</p>\" />);","     await frame();","     expect(createPolicy).toHaveBeenCalledTimes(2);","   } finally {","@@ -627,3 +643,258 @@ it('fails closed on a forbidden shell policy and preserves TrustedHTML branding","     }","   }"," });","+","+it.each([true, false])('renders before fonts finish (font available: %s)', async (ok) => {","+  jest.useRealTimers();","+  const originalFetch = global.fetch;","+  const originalTimeout = AbortSignal.timeout;","+  const style = document.createElement('style');","+  style.dataset.emotion = 'text-global';","+  style.textContent = `@font-face { font-family: Test; src: url(\"/public/fonts/startup-${ok}.woff2\"); }`;","+  document.head.append(style);","+  // JSDOM does not expose CSSStyleSheet.ownerNode.","+  Object.defineProperty(style.sheet, 'ownerNode', { value: style });","+  let finish!: (response: Partial<Response>) => void;","+  global.fetch = jest.fn(","+    () =>","+      new Promise<Response>((resolve) => {","+        finish = (response) => resolve(response as Response);","+      })","+  );","+  AbortSignal.timeout = () => new AbortController().signal;","+  const runtime = jest.mocked(loadSandboxRuntime);","+  runtime.mockClear();","+  try {","+    const { rerender } = render(<TextSandbox html=\"<p>Initial</p>\" />);","+    await act(async () => {});","+    const fallback = screen.getByTitle<HTMLIFrameElement>('Text panel content');","+    expect(runtime).toHaveBeenCalledTimes(1);","+    const fallbackMessage = jest.spyOn(fallback.contentWindow!, 'postMessage').mockImplementation(() => {});","+    notify(fallback, 'ready');","+    expect(fallbackMessage).toHaveBeenCalledWith(","+      expect.objectContaining({ html: '<p>Initial</p>', globalCss: expect.not.stringContaining('@font-face') }),","+      '*'","+    );","+    rerender(<TextSandbox html=\"<p>Latest</p>\" />);","+    await act(async () => {","+      finish({ ok, blob: async () => new Blob(['font'], { type: 'font/woff2' }) });","+    });","+    await waitFor(() =>","+      expect(fallbackMessage).toHaveBeenCalledWith(","+        expect.objectContaining({","+          type: 'styles',","+          revision: 1,","+          styleRevision: 1,","+          globalCss: expect.stringContaining(ok ? 'data:font/woff2;base64,Zm9udA==' : 'local(\"Arial\")'),","+        }),","+        '*'","+      )","+    );","+    expect(screen.getByTitle('Text panel content')).toBe(fallback);","+    expect(runtime).toHaveBeenCalledTimes(1);","+    rerender(<TextSandbox html=\"<p>Latest</p>\" minHeight={200} />);","+    expect(screen.getByTitle('Text panel content')).toBe(fallback);","+    expect(runtime).toHaveBeenCalledTimes(1);","+    runtime.mockClear();","+    render(<TextSandbox html=\"<p>Cached fonts</p>\" />);","+    await act(async () => {});","+    expect(runtime).toHaveBeenCalledTimes(1);","+  } finally {","+    style.remove();","+    global.fetch = originalFetch;","+    AbortSignal.timeout = originalTimeout;","+  }","+});","+","+it('shares one message listener across frames and removes it after the last frame unmounts', async () => {","+  const add = jest.spyOn(window, 'addEventListener');","+  const remove = jest.spyOn(window, 'removeEventListener');","+  const first = props({ title: 'First' });","+  const second = props({ title: 'Second', policy: undefined });","+  try {","+    const { rerender, unmount } = render(","+      <>","+        <SandboxFrame key=\"first\" {...first} />","+        <SandboxFrame key=\"second\" {...second} />","+      </>","+    );","+    await act(async () => {});","+    const firstFrame = screen.getByTitle<HTMLIFrameElement>('First');","+    const secondFrame = screen.getByTitle<HTMLIFrameElement>('Second');","+    const messageListeners = add.mock.calls.filter(([type]) => type === 'message');","+    expect(messageListeners).toHaveLength(1);","+    const listener = messageListeners[0][1];","+    const firstPost = jest.spyOn(firstFrame.contentWindow!, 'postMessage').mockImplementation(() => {});","+    const secondPost = jest.spyOn(secondFrame.contentWindow!, 'postMessage').mockImplementation(() => {});","+","+    notify(firstFrame, 'ready', {}, { source: secondFrame.contentWindow });","+    expect(firstPost).not.toHaveBeenCalled();","+    notify(firstFrame, 'ready');","+    expect(firstPost).toHaveBeenCalledWith(expect.objectContaining({ type: 'render' }), '*');","+    expect(secondPost).not.toHaveBeenCalled();","+    notify(secondFrame, 'ready');","+    expect(secondPost).toHaveBeenCalledWith(expect.objectContaining({ type: 'render' }), window.location.origin);","+","+    rerender(<SandboxFrame key=\"second\" {...second} />);","+    expect(remove).not.toHaveBeenCalledWith('message', listener);","+    notify(secondFrame, 'rendered');","+    expect(second.onState).toHaveBeenLastCalledWith({ status: 'ready', resources: [] });","+    unmount();","+    expect(remove).toHaveBeenCalledWith('message', listener);","+","+    const remount = render(<SandboxFrame {...first} />);","+    await act(async () => {});","+    expect(add.mock.calls.filter(([type]) => type === 'message')).toHaveLength(2);","+    const freshFrame = screen.getByTitle<HTMLIFrameElement>('First');","+    notify(freshFrame, 'ready');","+    notify(freshFrame, 'rendered');","+    expect(first.onState).toHaveBeenLastCalledWith({ status: 'ready', resources: [] });","+    remount.unmount();","+  } finally {","+    add.mockRestore();","+    remove.mockRestore();","+  }","+});","+","+it('notifies height consumers only when frame dimensions change', async () => {","+  const options = props();","+  render(<SandboxFrame {...options} />);","+  const element = await frame();","+  notify(element, 'ready');","+  notify(element, 'resize', { height: 180, contentHeight: 160 });","+  notify(element, 'resize', { height: 180, contentHeight: 160 });","+  expect(options.onHeight).toHaveBeenCalledTimes(1);","+  expect(options.onHeight).toHaveBeenLastCalledWith(180, 160);","+  notify(element, 'resize', { height: 180, contentHeight: 140 });","+  expect(options.onHeight).toHaveBeenCalledTimes(2);","+  expect(options.onHeight).toHaveBeenLastCalledWith(180, 140);","+  notify(element, 'resize', { height: 150, contentHeight: 140 });","+  expect(options.onHeight).toHaveBeenCalledTimes(3);","+  expect(options.onHeight).toHaveBeenLastCalledWith(150, 140);","+  expect(element.style.height).toBe('150px');","+});","+","+it('reuses protected documents for content updates and rejects replies from earlier renders', async () => {","+  const options = props();","+  const { rerender } = render(<SandboxFrame {...options} />);","+  const element = await frame();","+  const shell = element.srcdoc;","+  const postMessage = jest.spyOn(element.contentWindow!, 'postMessage').mockImplementation(() => {});","+  notify(element, 'ready');","+  notify(element, 'rendered');","+  rerender(<SandboxFrame {...options} html=\"<p>Updated</p>\" />);","+  expect(await frame()).toBe(element);","+  expect(element.srcdoc).toBe(shell);","+  expect(postMessage).toHaveBeenLastCalledWith(","+    expect.objectContaining({ type: 'render', revision: 1, html: '<p>Updated</p>', globalCss: undefined }),","+    '*'","+  );","+  expect(options.onState).toHaveBeenLastCalledWith({ status: 'loading', resources: [] });","+  for (const revision of [0, undefined, -1, 1.5, Infinity]) {","+    notify(element, 'rendered', { revision });","+    notify(element, 'error', { revision });","+    notify(element, 'resize', { revision, height: 999, contentHeight: 999 });","+    notify(element, 'blocked', { revision, resources: [{ directive: 'img-src' }] });","+  }","+  expect(options.onState).toHaveBeenLastCalledWith({ status: 'loading', resources: [] });","+  expect(options.onHeight).not.toHaveBeenCalled();","+  notify(element, 'rendered', { revision: 1 });","+  notify(element, 'resize', { revision: 1, height: 42, contentHeight: 40 });","+  expect(options.onState).toHaveBeenLastCalledWith({ status: 'ready', resources: [] });","+  expect(options.onHeight).toHaveBeenLastCalledWith(42, 40);","+  notify(element, 'ready', { document: 'reloaded' });","+  expect(postMessage).toHaveBeenLastCalledWith(","+    expect.objectContaining({ html: '<p>Updated</p>', globalCss: options.globalCss, revision: 2 }),","+    '*'","+  );","+});","+","+it('preserves blocked reports and pending Mermaid loading when styles change', async () => {","+  let finish!: (source: string) => void;","+  jest.mocked(loadSandboxMermaid).mockReturnValueOnce(","+    new Promise((resolve) => {","+      finish = resolve;","+    })","+  );","+  const options = props({ mermaid: { securityLevel: 'strict' } });","+  const { rerender } = render(<SandboxFrame {...options} />);","+  const element = await frame();","+  const postMessage = jest.spyOn(element.contentWindow!, 'postMessage').mockImplementation(() => {});","+  notify(element, 'ready');","+  notify(element, 'mermaid-needed');","+  const resources = [{ directive: 'img-src', origin: 'https://blocked.test' }];","+  notify(element, 'blocked', { resources });","+  jest.mocked(options.onState).mockClear();","+  rerender(<SandboxFrame {...options} globalCss=\"p{color:blue}\" />);","+  expect(await frame()).toBe(element);","+  expect(postMessage).toHaveBeenLastCalledWith(","+    expect.objectContaining({ type: 'styles', revision: 0, styleRevision: 1, globalCss: 'p{color:blue}' }),","+    '*'","+  );","+  expect(options.onState).not.toHaveBeenCalled();","+  await act(async () => finish('/* Mermaid source */'));","+  expect(postMessage).toHaveBeenLastCalledWith(","+    expect.objectContaining({ type: 'mermaid-source', revision: 0, source: '/* Mermaid source */' }),","+    '*'","+  );","+  notify(element, 'rendered');","+  expect(options.onState).toHaveBeenLastCalledWith({ status: 'ready', resources });","+});","+","+it('sends only the latest content when updated before the CSP handshake', async () => {","+  const options = props();","+  const { rerender } = render(<SandboxFrame {...options} />);","+  const element = await frame();","+  const postMessage = jest.spyOn(element.contentWindow!, 'postMessage').mockImplementation(() => {});","+  rerender(<SandboxFrame {...options} html=\"<p>Latest</p>\" />);","+  expect(await frame()).toBe(element);","+  expect(postMessage).not.toHaveBeenCalled();","+  notify(element, 'ready');","+  expect(postMessage).toH