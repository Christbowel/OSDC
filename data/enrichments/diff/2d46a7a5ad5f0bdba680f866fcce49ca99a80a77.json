8 @@ const ("," \tctxKeyWebSocketAuthToken = \"ws_auth_token\""," )"," ","+const (","+\t// The watcher protocol assumes that no reads will be performed","+\t// on the websocket.","+\twebsocketProtocolWatcher = \"nomad-watcher\"","+)","+","+// wsResponse is the default websocket response format.","+type wsResponse struct {","+\tHeaders http.Header `json:\"headers\"`","+\tPayload any         `json:\"payload\"`","+}","+"," // isWebsocketUpgrade checks if the request is a websocket upgrade request."," func isWebsocketUpgrade(req *http.Request) bool {"," \treturn websocket.IsWebSocketUpgrade(req)","@@ -29,6 +41,11 @@ func isWebsocketUpgrade(req *http.Request) bool {"," // upgrade the connection, write audit logs, and then hand off the"," // already-upgraded connection to the handler. We pass the connection and the"," // auth token via request context.","+//","+// NOTE: Outside of initial setup/upgrade failures, this handler should not","+// return any value or error after the connection has been upgraded to a","+// websocket. Any value or error should be sent to the websocket connection","+// along with a close message before returning."," func (s *HTTPServer) wrapWebsocketHandler(handler handlerFn) handlerFn {"," \treturn func(w http.ResponseWriter, req *http.Request) (any, error) {"," ","@@ -39,15 +56,23 @@ func (s *HTTPServer) wrapWebsocketHandler(handler handlerFn) handlerFn {"," \t\t// Upgrade the connection"," \t\tconn, err := s.wsUpgrader.Upgrade(w, req, nil)"," \t\tif err != nil {","-","-\t\t\treturn \"\", fmt.Errorf(\"failed to upgrade connection: %v\", err)","+\t\t\t// The upgrade failed so return the error.","+\t\t\treturn nil, fmt.Errorf(\"failed to upgrade connection: %v\", err)"," \t\t}"," ","+\t\t// Ensure the underlying websocket connection is closed when we","+\t\t// are done. This does not transmit the close message to the","+\t\t// client, so that must still be done before returning from","+\t\t// this function. Failure to send the close message can cause","+\t\t// the client connection to hang for an extended period of time","+\t\t// before closing.","+\t\tdefer conn.Close()","+"," \t\ttoken, err := s.readWsHandshake(conn.ReadJSON, req)"," \t\tif err != nil {"," \t\t\tconn.WriteMessage(websocket.CloseMessage,"," \t\t\t\twebsocket.FormatCloseMessage(toWsCode(400), err.Error()))","-\t\t\treturn \"\", err","+\t\t\treturn nil, nil"," \t\t}"," "," \t\t// Store connection and token in context for handler to use","@@ -56,16 +81,53 @@ func (s *HTTPServer) wrapWebsocketHandler(handler handlerFn) handlerFn {"," \t\tctx = context.WithValue(ctx, ctxKeyWebSocketAuthToken, token)"," \t\t*req = *req.WithContext(ctx)"," ","+\t\t// Check the websocket subprotocol and perform any required setup","+\t\tswitch conn.Subprotocol() {","+\t\tcase websocketProtocolWatcher:","+\t\t\tgo s.runWebsocketWatcher(conn)","+\t\t}","+","+\t\t// Run the handler to process the request."," \t\tobj, err := handler(w, req)"," ","+\t\t// If an error was encountered, send the close control message","+\t\t// with error information."," \t\tif err != nil {"," \t\t\tcode, errMsg := errCodeFromHandler(err)"," \t\t\tconn.WriteMessage(websocket.CloseMessage,"," \t\t\t\twebsocket.FormatCloseMessage(toWsCode(code), errMsg))","-\t\t\treturn \"\", err","+","+\t\t\treturn nil, nil","+\t\t}","+","+\t\t// If the websocket is not configured with a subprotocol and","+\t\t// the handler result is empty, do not write anything to the","+\t\t// websocket. This retains pre-existing behavior.","+\t\tif obj == nil && conn.Subprotocol() == \"\" {","+\t\t\treturn nil, nil"," \t\t}"," ","-\t\treturn obj, nil","+\t\t// Construct the result to return.","+\t\tresult := wsResponse{","+\t\t\tHeaders: w.Header(),","+\t\t\tPayload: obj,","+\t\t}","+","+\t\t// Write the result to the websocket.","+\t\tif err := conn.WriteJSON(result); err != nil {","+\t\t\ts.logger.Error(\"failed to write result to websocket\", \"error\", err)","+\t\t\t// Attempt to send a close message with error infor