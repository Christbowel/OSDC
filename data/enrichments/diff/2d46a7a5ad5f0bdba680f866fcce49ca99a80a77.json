atus     int","+\t\tprotoMajor int","+\t\terrMsg     string","+\t}{","+\t\t{","+\t\t\tname:       \"enabled by default\",","+\t\t\tstatus:     200,","+\t\t\tprotoMajor: 2,","+\t\t},","+\t\t{","+\t\t\tname: \"disabled by config\",","+\t\t\tconfig: func(c *Config) {","+\t\t\t\tc.HTTPDisableHTTP2 = true","+\t\t\t},","+\t\t\terrMsg: \"frame too large\",","+\t\t},","+\t}","+","+\tfor _, tc := range testCases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\ts := makeHTTPServer(t, tc.config)","+\t\t\tt.Cleanup(s.Shutdown)","+","+\t\t\t// Create a custom transport with HTTP2 only. Note that we are","+\t\t\t// using unencrypted since we don't have all the TLS stuff setup.","+\t\t\ttranspo := http.DefaultTransport.(*http.Transport).Clone()","+\t\t\ttranspo.Protocols = new(http.Protocols)","+\t\t\ttranspo.Protocols.SetUnencryptedHTTP2(true)","+","+\t\t\tclient := &http.Client{Transport: transpo}","+\t\t\tresp, err := client.Get(fmt.Sprintf(\"http://%s/\", s.Agent.config.AdvertiseAddrs.HTTP))","+\t\t\tif err != nil {","+\t\t\t\tmust.Error(t, err)","+\t\t\t\tmust.ErrorContains(t, err, tc.errMsg)","+\t\t\t\treturn","+\t\t\t}","+","+\t\t\tmust.Eq(t, tc.status, resp.StatusCode, must.Sprintf(\"expecting %d status code\", tc.status))","+\t\t\tmust.Eq(t, tc.protoMajor, resp.ProtoMajor, must.Sprintf(\"expecting HTTP%d protocol\", resp.ProtoMajor))","+\t\t})","+\t}","+}","+","+func TestWebSocket(t *testing.T) {","+\tci.Parallel(t)","+","+\ttestCases := []struct {","+\t\tname        string","+\t\tconfig      func(*Config)","+\t\theaders     http.Header","+\t\torigin      string","+\t\tmsgContains string","+\t\terr         error","+\t}{","+\t\t{","+\t\t\tname: \"ok\",","+\t\t\tconfig: func(c *Config) {","+\t\t\t\tc.HTTPDisableWebSocketOriginCheck = new(false)","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"bad origin\",","+\t\t\tconfig: func(c *Config) {","+\t\t\t\tc.HTTPDisableWebSocketOriginCheck = new(false)","+\t\t\t},","+\t\t\torigin: \"http://bad-host\",","+\t\t\terr:    websoc