{"id":"9b3d88e2d13f5dd3ff0c2c770a0987784cd8496b","axis":"silent","repo":"comet-ml/comet-llm","sha":"9b3d88e2d13f5dd3ff0c2c770a0987784cd8496b","parsed":{"files":[{"path":"apps/opik-frontend/src/constants/experiments.ts","lines":["@@ -1,4 +1,9 @@"," import { OPTIMIZATION_STATUS } from \"@/types/optimizations\";","+import { EVALUATION_METHOD } from \"@/types/datasets\";","+import {","+  COLUMN_EXPERIMENT_SCORES_ID,","+  COLUMN_FEEDBACK_SCORES_ID,","+} from \"@/types/shared\";"," import { TagProps } from \"@/ui/tag\";"," "," export const EXPERIMENT_ITEM_OUTPUT_PREFIX = \"output\";","@@ -30,3 +35,42 @@ export const STATUS_TO_VARIANT_MAP: Record<","   [OPTIMIZATION_STATUS.INITIALIZED]: \"blue\",","   [OPTIMIZATION_STATUS.ERROR]: \"red\","," };","+","+// Experiments page tabs, kept in the URL as ?tab=.","+export const EXPERIMENTS_PAGE_TAB = {","+  TEST_SUITES: \"test_suites\",","+  DATASETS: \"datasets\",","+} as const;","+","+export const COLUMN_DATASET_VERSION_ID = \"dataset_version\";","+export const COLUMN_PASS_RATE_ID = \"pass_rate\";","+","+export type ExperimentsTabStorage = {","+  storageKeyPrefix: string;","+  // Columns the tab never shows. An id also covers its per-score columns, so","+  // \"feedback_scores\" hides \"feedback_scores.accuracy\" too.","+  excludedColumnIds: string[];","+};","+","+export const EXPERIMENTS_TAB_STORAGE: Record<","+  EVALUATION_METHOD,","+  ExperimentsTabStorage","+> = {","+  [EVALUATION_METHOD.TEST_SUITE]: {","+    storageKeyPrefix: \"experiments-test-suites\",","+    excludedColumnIds: [COLUMN_FEEDBACK_SCORES_ID, COLUMN_EXPERIMENT_SCORES_ID],","+  },","+  [EVALUATION_METHOD.DATASET]: {","+    storageKeyPrefix: \"experiments-datasets\",","+    excludedColumnIds: [COLUMN_PASS_RATE_ID],","+  },","+};","+","+export const isExcludedTabColumn = (","+  columnId: string,","+  excludedColumnIds: string[],","+) =>","+  excludedColumnIds.some(","+    (excludedId) =>","+      columnId === excludedId || columnId.startsWith(`${excludedId}.`),","+  );"],"additions":44,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/lib/ls-migrations/002_split_experiments_tabs.test.ts","lines":["@@ -0,0 +1,140 @@","+import { beforeEach, describe, expect, it } from \"vitest\";","+","+import { migration002 } from \"./002_split_experiments_tabs\";","+","+const SUITES = \"experiments-test-suites\";","+const DATASETS = \"experiments-datasets\";","+","+const setLegacy = (suffix: string, value: unknown) =>","+  localStorage.setItem(`experiments-${suffix}`, JSON.stringify(value));","+","+const read = (prefix: string, suffix: string) =>","+  JSON.parse(localStorage.getItem(`${prefix}-${suffix}`) ?? \"null\");","+","+describe(\"002_split_experiments_tabs\", () => {","+  beforeEach(() => {","+    localStorage.clear();","+  });","+","+  it(\"drops each tab's hidden columns and adds the version column to the selection\", () => {","+    setLegacy(\"selected-columns-v2\", [","+      \"name\",","+      \"pass_rate\",","+      \"feedback_scores\",","+      \"feedback_scores.accuracy\",","+    ]);","+","+    migration002.run();","+","+    expect(read(SUITES, \"selected-columns-v2\")).toEqual([","+      \"name\",","+      \"pass_rate\",","+      \"dataset_version\",","+    ]);","+    expect(read(DATASETS, \"selected-columns-v2\")).toEqual([","+      \"name\",","+      \"feedback_scores\",","+      \"feedback_scores.accuracy\",","+      \"dataset_version\",","+    ]);","+  });","+","+  it(\"falls back to the v1 selection, with Name added, when there is no v2 key\", () => {","+    setLegacy(\"selected-columns\", [\"created_at\", \"feedback_scores\"]);","+","+    migration002.run();","+","+    expect(read(SUITES, \"selected-columns-v2\")).toEqual([","+      \"name\",","+      \"created_at\",","+      \"dataset_version\",","+    ]);","+  });","+","+  it(\"places the version column right after Name in the saved order\", () => {","+    setLegacy(\"columns-order\", [\"id\", \"name\", \"feedback_scores\", \"created_at\"]);","+","+    migration002.run();","+","+    expect(read(SUITES, \"columns-order\")).toEqual([","+      \"id\",","+      \"name\",","+      \"dataset_version\",","+      \"created_at\",","+    ]);","+  });","+","+  it(\"drops a sort on any column the tab does not show, including per-score columns\", () => {","+    setLegacy(\"columns-sort\", [{ id: \"experiment_scores.x\", desc: true }]);","+","+    migration002.run();","+","+    expect(read(SUITES, \"columns-sort\")).toEqual([]);","+    expect(read(DATASETS, \"columns-sort\")).toEqual([","+      { id: \"experiment_scores.x\", desc: true },","+    ]);","+  });","+","+  it(\"copies groups, widths, page size and per-project pins as-is\", () => {","+    setLegacy(\"columns-groups\", []);","+    setLegacy(\"columns-width\", { name: 300 });","+    setLegacy(\"pagination-size\", 50);","+    setLegacy(\"pinned-experiments-project-1\", [\"exp-1\"]);","+","+    migration002.run();","+","+    [SUITES, DATASETS].forEach((prefix) => {","+      expect(read(prefix, \"columns-groups\")).toEqual([]);","+      expect(read(prefix, \"columns-width\")).toEqual({ name: 300 });","+      expect(read(prefix, \"pagination-size\")).toBe(50);","+      expect(read(prefix, \"pinned-experiments-project-1\")).toEqual([\"exp-1\"]);","+    });","+  });","+","+  it(\"never overwrites a choice already saved for the tab\", () => {","+    setLegacy(\"columns-width\", { name: 300 });","+    localStorage.setItem(`${SUITES}-columns-width`, JSON.stringify({}));","+","+    migration002.run();","+","+    expect(read(SUITES, \"columns-width\")).toEqual({});","+  });","+","+  it(\"skips corrupt or wrongly shaped values and still migrates the rest\", () => {","+    localStorage.setItem(\"experiments-selected-columns-v2\", \"{not json\");","+    setLegacy(\"columns-order\", {});","+    setLegacy(\"columns-sort\", [null]);","+    setLegacy(\"columns-width\", { name: 300 });","+","+    expect(migration002.run).not.toThrow();","+","+    expect(localStorage.getItem(`${SUITES}-selected-columns-v2`)).toBeNull();","+    expect(localStorage.getItem(`${SUITES}-columns-order`)).toBeNull();","+    expect(localStorage.getItem(`${SUITES}-columns-sort`)).toBeNull();","+    expect(read(SUITES, \"columns-width\")).toEqual({ name: 300 });","+  });","+","+  it(\"skips a list with any invalid member instead of keeping only the valid ones\", () => {","+    setLegacy(\"selected-columns-v2\", [\"name\", null]);","+    setLegacy(\"columns-order\", [1]);","+    setLegacy(\"columns-sort\", [{}]);","+","+    migration002.run();","+","+    expect(localStorage.getItem(`${SUITES}-selected-columns-v2`)).toBeNull();","+    expect(localStorage.getItem(`${SUITES}-columns-order`)).toBeNull();","+    expect(localStorage.getItem(`${SUITES}-columns-sort`)).toBeNull();","+  });","+","+  it(\"puts the version column at the end when Name is not in the saved order\", () => {","+    setLegacy(\"columns-order\", [\"created_at\", \"trace_count\"]);","+","+    migration002.run();","+","+    expect(read(SUITES, \"columns-order\")).toEqual([","+      \"created_at\",","+      \"trace_count\",","+      \"dataset_version\",","+    ]);","+  });","+});"],"additions":140,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/lib/ls-migrations/002_split_experiments_tabs.ts","lines":["@@ -0,0 +1,179 @@","+/**","+ * Migration 002: Split the Experiments page settings per tab","+ *","+ * Context: The Experiments page split into Test suites and Datasets tabs, and","+ * each tab saves its choices under its own prefix. Before the split, the page","+ * saved one set under \"experiments-*\". Each tab starts from that set, minus the","+ * columns it does not show. A tab key that already has a value is not","+ * overwritten. Legacy keys are left in place so a rollback still finds them.","+ *","+ * The prefixes and column ids are hard-coded on purpose: a later change to the","+ * tab config must not change what this migration does.","+ */","+","+import isArray from \"lodash/isArray\";","+import isPlainObject from \"lodash/isPlainObject\";","+import isString from \"lodash/isString\";","+","+import type { Migration } from \"./engine\";","+","+const LEGACY_PREFIX = \"experiments\";","+const LEGACY_PINNED_PREFIX = `${LEGACY_PREFIX}-pinned-experiments-`;","+const NAME_COLUMN_ID = \"name\";","+","+// Columns the tabs show that the pre-split page did not have.","+const ADDED_COLUMN_IDS = [\"dataset_version\"];","+","+type TabStorage = {","+  storageKeyPrefix: string;","+  // Columns the tab does not show. An id also covers its per-score columns,","+  // so \"feedback_scores\" covers \"feedback_scores.accuracy\" too.","+  excludedColumnIds: string[];","+};","+","+const TABS: TabStorage[] = [","+  {","+    storageKeyPrefix: \"experiments-test-suites\",","+    excludedColumnIds: [\"feedback_scores\", \"experiment_scores\"],","+  },","+  {","+    storageKeyPrefix: \"experiments-datasets\",","+    excludedColumnIds: [\"pass_rate\"],","+  },","+];","+","+type ColumnSortLike = { id: string };","+","+type Setting = {","+  target: string;","+  // Returns the value to store, or null to leave the tab on its default.","+  build: () => string | null;","+};","+","+const legacyKey = (suffix: string) => `${LEGACY_PREFIX}-${suffix}`;","+","+const isSort = (value: unknown): value is ColumnSortLike =>","+  isPlainObject(value) && isString((value as { id?: unknown }).id);","+","+// A corrupt or wrongly shaped value (`{}` where a list is expected, or a list","+// with an invalid member such as `[null]`) is skipped as a whole, so that","+// setting falls back to its default.","+const readList = <T>(","+  key: string,","+  isItem: (value: unknown) => value is T,","+): T[] | null => {","+  const raw = localStorage.getItem(key);","+  if (raw === null) return null;","+  try {","+    const value: unknown = JSON.parse(raw);","+    return isArray(value) && value.every(isItem) ? value : null;","+  } catch {","+    return null;","+  }","+};","+","+const getTabSettings = ({","+  storageKeyPrefix,","+  excludedColumnIds,","+}: TabStorage): Setting[] => {","+  const newKey = (suffix: string) => `${storageKeyPrefix}-${suffix}`;","+  const isKept = (id: string) =>","+    !excludedColumnIds.some(","+      (excludedId) => id === excludedId || id.startsWith(`${excludedId}.`),","+    );","+","+  const selectedColumns: Setting = {","+    target: newKey(\"selected-columns-v2\"),","+    build: () => {","+      // Users who never changed columns after the v2 key was introduced only","+      // have the v1 key, which the table read with Name added.","+      const v2 = readList(legacyKey(\"selected-columns-v2\"), isString);","+      const hasV2 =","+        localStorage.getItem(legacyKey(\"selected-columns-v2\")) !== null;","+      const columns = hasV2","+        ? v2","+        : readList(legacyKey(\"selected-columns\"), isString);","+      if (columns === null) return null;","+      return JSON.stringify([","+        ...new Set([","+          ...(hasV2 ? [] : [NAME_COLUMN_ID]),","+          ...columns.filter(isKept),","+          ...ADDED_COLUMN_IDS,","+        ]),","+      ]);","+    },","+  };","+","+  // The saved order predates the added columns, which would otherwise land at","+  // the far right; put them after Name, where the design has them. When Name","+  // is not in the saved order, they go at the end.","+  const columnsOrder: Setting = {","+    target: newKey(\"columns-order\"),","+    build: () => {","+      const order = readList(legacyKey(\"columns-order\"), isString);","+      if (order === null) return null;","+      const kept = order.filter(","+        (id) => isKept(id) && !ADDED_COLUMN_IDS.includes(id),","+      );","+      const nameIndex = kept.indexOf(NAME_COLUMN_ID);","+      kept.splice(","+        nameIndex === -1 ? kept.length : nameIndex + 1,","+        0,","+        ...ADDED_COLUMN_IDS,","+      );","+      return JSON.stringify(kept);","+    },","+  };","+","+  // A sort on a column the tab does not show would keep the list sorted with","+  // no header to clear it.","+  const columnsSort: Setting = {","+    target: newKey(\"columns-sort\"),","+    build: () => {","+      const sort = readList(legacyKey(\"columns-sort\"), isSort);","+      return sort === null","+        ? null","+        : JSON.stringify(sort.filter((column) => isKept(column.id)));","+    },","+  };","+","+  const copy = (source: string, target: string): Setting => ({","+    target,","+    build: () => localStorage.getItem(source),","+  });","+","+  const plainCopies = [","+    \"scores-columns-order\",","+    \"columns-width\",","+    \"columns-groups\",","+    \"pagination-size\",","+  ].map((suffix) => copy(legacyKey(suffix), newKey(suffix)));","+","+  // Pins are saved per project. Each tab gets all of them; the tab's pinned","+  // fetch is filtered by evaluation method, so pins of the other type are","+  // pruned from that tab on first load.","+  const pins = Object.keys(localStorage)","+    .filter((key) => key.startsWith(LEGACY_PINNED_PREFIX))","+    .map((key) =>","+      copy(","+        key,","+        newKey(`pinned-experiments-${key.slice(LEGACY_PINNED_PREFIX.length)}`),","+      ),","+    );","+","+  return [selectedColumns, columnsOrder, columnsSort, ...plainCopies, ...pins];","+};","+","+export const migration002: Migration = {","+  id: \"002_split_experiments_tabs\",","+  description:","+    \"Copy the pre-split Experiments page settings into the Test suites and Datasets tabs\",","+  run: () => {","+    TABS.flatMap(getTabSettings).forEach(({ target, build }) => {","+      // Never overwrite a choice already saved for the tab.","+      if (localStorage.getItem(target) !== null) return;","+      const value = build();","+      if (value !== null) localStorage.setItem(target, value);","+    });","+  },","+};"],"additions":179,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/lib/ls-migrations/index.ts","lines":["@@ -1,6 +1,7 @@"," import { runMigrations } from \"./engine\";"," import { migration001 } from \"./001_fix_column_order\";","+import { migration002 } from \"./002_split_experiments_tabs\";"," "," export function runLocalStorageMigrations(): void {","-  runMigrations([migration001]);","+  runMigrations([migration001, migration002]);"," }"],"additions":2,"deletions":1,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/experiments/DatasetSelectBox/DatasetSelectBox.tsx","lines":["@@ -5,6 +5,7 @@ import { Database } from \"lucide-react\";"," import useProjectDatasetsList from \"@/api/datasets/useProjectDatasetsList\";"," import LoadableSelectBox from \"@/v2/components/LoadableSelectBox/LoadableSelectBox\";"," import { DropdownOption } from \"@/types/shared\";","+import { Filters } from \"@/types/filters\";"," import { usePermissions } from \"@/contexts/PermissionsContext\";"," "," const DEFAULT_LOADED_DATASET_ITEMS = 1000;","@@ -21,6 +22,7 @@ type DatasetSelectBoxProps = {","   value: string;","   onValueChange: (value: string) => void;","   projectId?: string | null;","+  filters?: Filters;","   placeholder?: string;","   className?: string;","   /** Show the gold dataset icon next to the selected value (matches Figma). */","@@ -32,6 +34,7 @@ const DatasetSelectBox: React.FC<DatasetSelectBoxProps> = ({","   value,","   onValueChange,","   projectId,","+  filters,","   placeholder = \"Select an item source\",","   className,","   showIcon = false,","@@ -44,6 +47,7 @@ const DatasetSelectBox: React.FC<DatasetSelectBoxProps> = ({","   const { data, isLoading } = useProjectDatasetsList(","     {","       projectId: projectId!,","+      filters,","       page: 1,","       size: isLoadedMore ? 10000 : DEFAULT_LOADED_DATASET_ITEMS,","     },"],"additions":4,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/experiments/DatasetVersionCell.tsx","lines":["@@ -0,0 +1,31 @@","+import React from \"react\";","+import { CellContext } from \"@tanstack/react-table\";","+import { GitCommitVertical } from \"lucide-react\";","+","+import CellWrapper from \"@/shared/DataTableCells/CellWrapper\";","+import { Experiment } from \"@/types/datasets\";","+","+const DatasetVersionCell = <TData extends Experiment>(","+  context: CellContext<TData, unknown>,","+) => {","+  const versionName =","+    context.row.original.dataset_version_summary?.version_name;","+","+  return (","+    <CellWrapper","+      metadata={context.column.columnDef.meta}","+      tableMetadata={context.table.options.meta}","+    >","+      {versionName ? (","+        <span className=\"flex min-w-0 items-center gap-0.5\">","+          <GitCommitVertical className=\"size-3 shrink-0 text-muted-slate\" />","+          <span className=\"truncate\">{versionName}</span>","+        </span>","+      ) : (","+        \"-\"","+      )}","+    </CellWrapper>","+  );","+};","+","+export default DatasetVersionCell;"],"additions":31,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/experiments/FeedbackScoresChartsWrapper/FeedbackScoresChartContainer.tsx","lines":["@@ -17,6 +17,7 @@ import { cn, getTextWidth } from \"@/lib/utils\";"," import { Spinner } from \"@/ui/spinner\";"," import FeedbackScoresChartContent, {","   ChartData,","+  ChartLegendPosition,"," } from \"./FeedbackScoresChartContent\";"," import TooltipWrapper from \"@/shared/TooltipWrapper/TooltipWrapper\";"," import { DropdownOption } from \"@/types/shared\";","@@ -27,11 +28,19 @@ type FeedbackScoresChartContainerProps = {","   chartId: string;","   chartName?: string | DropdownOption<string>[];","   subtitle?: string;","+  legendPosition?: ChartLegendPosition;"," };"," "," const FeedbackScoresChartContainer: React.FC<","   FeedbackScoresChartContainerProps","-> = ({ className, chartData, chartId, chartName, subtitle }) => {","+> = ({","+  className,","+  chartData,","+  chartId,","+  chartName,","+  subtitle,","+  legendPosition,","+}) => {","   const isPending = !chartData;","   const noData = useMemo(() => {","     if (isPending) return fal