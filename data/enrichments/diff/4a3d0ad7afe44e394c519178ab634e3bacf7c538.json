RATOR_NOT, [","+\t\t\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'path', 'foo'),","+\t\t\t\t]),","+\t\t\t]),","+\t\t]);","+","+\t\t$this->optimizer->processOperator($operator);","+","+\t\t$this->assertEquals('(not path eq \"foo\")', $operator->__toString());","+\t}","+","+\tpublic function testNegatedNestedGroupIsFullyPushedDown(): void {","+\t\t// not (a and (b or c)) == (not a) or ((not b) and (not c))","+\t\t$operator = new SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_NOT, [","+\t\t\tnew SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_AND, [","+\t\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'path', 'a'),","+\t\t\t\tnew SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_OR, [","+\t\t\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'path', 'b'),","+\t\t\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'path', 'c'),","+\t\t\t\t]),","+\t\t\t]),","+\t\t]);","+","+\t\t$this->optimizer->processOperator($operator);","+","+\t\t$this->assertEquals(","+\t\t\t'((not path eq \"a\") or ((not path eq \"b\") and (not path eq \"c\")))',","+\t\t\t$operator->__toString(),","+\t\t);","+\t}","+","+\tpublic static function emptyGroupProvider(): array {","+\t\treturn [","+\t\t\t'and' => [ISearchBinaryOperator::OPERATOR_AND],","+\t\t\t'or' => [ISearchBinaryOperator::OPERATOR_OR],","+\t\t\t'not' => [ISearchBinaryOperator::OPERATOR_NOT],","+\t\t];","+\t}","+","+\t#[DataProvider('emptyGroupProvider')]","+\tpublic function testNotOfEmptyGroupIsLeftAlone(string $type): void {","+\t\t$empty = new SearchBinaryOperator($type, []);","+\t\t$not = new SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_NOT, [$empty]);","+\t\t$operator = $not;","+","+\t\t$this->assertFalse($this->optimizer->processOperator($operator));","+","+\t\t$this->assertSame($not, $operator);","+\t\t$this->assertSame([$empty], $operator->getArguments());","+\t\t$this->assertSame([], $empty->getArguments());","+\t}","+","+\tpublic function testNestedNotOfEm