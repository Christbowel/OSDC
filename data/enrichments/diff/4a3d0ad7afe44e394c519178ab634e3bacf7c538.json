oups, so they have no","+ * consistent meaning to negate, and it keeps rejecting such a `not` rather than matching everything.","+ */","+class PushDownNegation extends ReplacingOptimizerStep {","+\t#[\\Override]","+\tpublic function processOperator(ISearchOperator &$operator): bool {","+\t\tif (","+\t\t\t$operator instanceof SearchBinaryOperator","+\t\t\t&& $operator->getType() === ISearchBinaryOperator::OPERATOR_NOT","+\t\t\t&& count($operator->getArguments()) === 1","+\t\t) {","+\t\t\t$inner = $operator->getArguments()[0];","+","+\t\t\tif ($inner instanceof SearchBinaryOperator && $inner->getArguments() === []) {","+\t\t\t\treturn false;","+\t\t\t}","+","+\t\t\tif ($inner instanceof SearchBinaryOperator && $inner->getType() === ISearchBinaryOperator::OPERATOR_NOT) {","+\t\t\t\t$operator = $inner->getArguments()[0];","+\t\t\t\t$this->processOperator($operator);","+","+\t\t\t\treturn true;","+\t\t\t}","+","+\t\t\tif ($inner instanceof SearchBinaryOperator) {","+\t\t\t\t// the only other binary operator types are 'and' and 'or', which De Morgan swaps","+\t\t\t\t$flipped = $inner->getType() === ISearchBinaryOperator::OPERATOR_AND","+\t\t\t\t\t? ISearchBinaryOperator::OPERATOR_OR","+\t\t\t\t\t: ISearchBinaryOperator::OPERATOR_AND;","+","+\t\t\t\t$operator = new SearchBinaryOperator($flipped, array_map(","+\t\t\t\t\tstatic fn (ISearchOperator $child): ISearchOperator","+\t\t\t\t\t\t=> new SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_NOT, [$child]),","+\t\t\t\t\t$inner->getArguments(),","+\t\t\t\t));","+\t\t\t\t$this->processOperator($operator);","+","+\t\t\t\treturn true;","+\t\t\t}","+\t\t}","+","+\t\tparent::processOperator($operator);","+","+\t\treturn false;","+\t}","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"lib/private/Files/Search/QueryOptimizer/QueryOptimizer.php","lines":["@@ -17,6 +17,7 @@ class QueryOptimizer {"," \tpublic function __construct() {"," \t\t// note that the order here is relevant"," \t\t$this->steps = [","+\t\t\tnew PushDownNegation(),"," \t\t\tnew PathPrefixOptimizer(),"," \t\t\tnew MergeDistributiveOperations(),"," \t\t\tnew FlattenSingleArgumentBinaryOperation(),","@@ -24,6 +25,9 @@ public function __construct() {"," \t\t\tnew OrEqualsToIn(),"," \t\t\tnew FlattenNestedBool(),"," \t\t\tnew SplitLargeIn(),","+\t\t\t// SplitLargeIn can turn a `not (in (...))` into `not (or (in (...), in (...)))`, which","+\t\t\t// needs pushing down again before it reaches the query builder.","+\t\t\tnew PushDownNegation(),"," \t\t];"," \t}"," "],"additions":4,"deletions":0,"truncated":false},{"path":"tests/lib/Files/Search/QueryOptimizer/CombinedTest.php","lines":["@@ -10,6 +10,7 @@"," use OC\\Files\\Search\\QueryOptimizer\\QueryOptimizer;"," use OC\\Files\\Search\\SearchBinaryOperator;"," use OC\\Files\\Search\\SearchComparison;","+use OCP\\DB\\QueryBuilder\\IQueryBuilder;"," use OCP\\Files\\Search\\ISearchBinaryOperator;"," use OCP\\Files\\Search\\ISearchComparison;"," use Test\\TestCase;","@@ -194,4 +195,35 @@ public function testApplySearchConstraints2(): void {"," "," \t\t$this->assertEquals('(mimetype in [\"image\\/png\",\"image\\/jpeg\"] and ((storage eq 1 and (path eq \"files\" or path like \"files\\/%\")) or storage eq 2 or (storage eq 3 and path in [\"files\\/301\",\"files\\/302\"])))', $operator->__toString());"," \t}","+","+\tpublic function testNegatedGroupSurvivesTheFullPipeline(): void {","+\t\t$operator = new SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_NOT, [","+\t\t\tnew SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_AND, [","+\t\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'storage', 1),","+\t\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'path', 'foo'),","+\t\t\t]),","+\t\t]);","+","+\t\t$this->optimizer->processOperator($operator);","+","+\t\t$this->assertEquals('((not storage eq 1) or (not path eq \"foo\"))', $operator->__toString());","+\t}","+","+\tpublic function testNegatedLargeInIsPushedDownAfterSplitting(): void {","+\t\t$ids = range(1, 1500);","+\t\t$operator = new SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_NOT, [","+\t\t\tnew SearchComparison(ISearchComparison::COMPARE_IN, 'fileid', $ids),","+\t\t]);","+","+\t\t$this->optimizer->processOperator($operator);","+","+\t\t// SplitLargeIn turns the single `in` into `or (in, in)`, which needs pushing back down","+\t\t// through the `not` a second time before it is something SearchBuilder can turn into SQL.","+\t\t$chunks = array_chunk($ids, IQueryBuilder::MAX_IN_PARAMETERS);","+\t\t$expected = '(' . implode(' and ', array_map(","+\t\t\tstatic fn (array $chunk): string => '(not fileid in ' . json_encode($chunk) . ')',","+\t\t\t$chunks,","+\t\t)) . ')';","+\t\t$this->assertEquals($expected, $operator->__toString());","+\t}"," }"],"additions":32,"deletions":0,"truncated":false},{"path":"tests/lib/Files/Search/QueryOptimizer/PushDownNegationTest.php","lines":["@@ -0,0 +1,143 @@","+<?php","+","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+namespace Test\\Files\\Search\\QueryOptimizer;","+","+use OC\\Files\\Search\\QueryOptimizer\\PushDownNegation;","+use OC\\Files\\Search\\SearchBinaryOperator;","+use OC\\Files\\Search\\SearchComparison;","+use OCP\\Files\\Search\\ISearchBinaryOperator;","+use OCP\\Files\\Search\\ISearchComparison;","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use Test\\TestCase;","+","+class PushDownNegationTest extends TestCase {","+\tprivate PushDownNegation $optimizer;","+","+\t#[\\Override]","+\tprotected function setUp(): void {","+\t\tparent::setUp();","+","+\t\t$this->optimizer = new PushDownNegation();","+\t}","+","+\tpublic function testNotOfComparisonIsLeftAlone(): void {","+\t\t$operator = new SearchBinaryOperator(ISearchBinaryOperator::OPERATOR_NOT, [","+\t\t\tnew SearchComparison(ISearchComparison::COMPARE_EQUAL, 'path', 'foo'),","+\t\t]);","+","+\t\t$this->optimizer->processOperator($operator);","+