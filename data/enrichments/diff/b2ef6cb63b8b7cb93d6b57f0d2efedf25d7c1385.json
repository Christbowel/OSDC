)","+            .map_err(|error| StoreLockError::Acquire { path, error })?;","         files.push(file);","     }","     Ok(StoreOperationLock { _files: files })"],"additions":2,"deletions":5,"truncated":false},{"path":"pnpm/crates/store-dir/src/store_lock/tests.rs","lines":["@@ -13,7 +13,7 @@ fn open_lock_file(store: &StoreDir) -> File {"," "," fn assert_global_prune_barrier_is_blocked() {","     let file = pnpm_fs::open_secure_lock_file(&global_operation_lock_path().unwrap()).unwrap();","-    assert!(matches!(file.try_lock(), Err(TryLockError::WouldBlock)));","+    assert!(matches!(pnpm_fs::try_lock_file(&file, true), Err(TryLockError::WouldBlock)));"," }"," "," #[test]","@@ -25,7 +25,7 @@ fn prune_waits_for_store_consumers() {","     assert_global_prune_barrier_is_blocked();"," ","     drop(consumer);","-    open_lock_file(&store).try_lock().unwrap();","+    pnpm_fs::try_lock_file(&open_lock_file(&store), true).unwrap();"," }"," "," #[test]","@@ -46,7 +46,7 @@ fn prune_waits_for_frozen_store_consumers() {","     assert_global_prune_barrier_is_blocked();"," ","     drop(consumer);","-    open_lock_file(&store).try_lock().unwrap();","+    pnpm_fs::try_lock_file(&open_lock_file(&store), true).unwrap();"," }"," "," #[test]",""],"additions":3,"deletions":3,"truncated":false}],"additions":121,"deletions":37,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-02T14:43:19.803362+00:00"}