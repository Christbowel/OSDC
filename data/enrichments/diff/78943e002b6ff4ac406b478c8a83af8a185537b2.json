ks, fs,","+    pack_pnpmfile_with_project, pacquet_cmd, write_peer_workspace, write_project,","+    write_reachability_workspace, write_recording_pnpmfile, write_workspace,","+};","+use assert_cmd::assert::OutputAssertExt;","+","+/// Post-Deploy Self-Containment Oracle:","+/// 1. `pnpm --dir <deploy_dir> --config.verify-deps-before-run=error run start`","+///    passes immediately after `pnpm deploy` without re-installing.","+/// 2. After removing `deploy_dir/node_modules`,","+///    `pnpm --dir <deploy_dir> install --frozen-lockfile` succeeds with no","+///    dangling symlinks and `verifyDepsBeforeRun: error` passes again.","+fn assert_deployed_project_is_self_contained(deploy_dir: &Path, npmrc_path: &Path) {","+    pacquet_cmd(deploy_dir)","+        .with_args([\"--config.verify-deps-before-run=error\", \"run\", \"start\"])","+        .assert()","+        .success();","+","+    fs::copy(npmrc_path, deploy_dir.join(\".npmrc\")).unwrap();","+    fs::remove_dir_all(deploy_dir.join(\"node_modules\")).unwrap();","+    pacquet_cmd(deploy_dir)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+    let dangling = dangling_links(&deploy_dir.join(\"node_modules\"));","+    assert!(","+        dangling.is_empty(),","+        \"post-deploy frozen install must not leave dangling symlinks: {dangling:#?}\",","+    );","+","+    pacquet_cmd(deploy_dir)","+        .with_args([\"--config.verify-deps-before-run=error\", \"run\", \"start\"])","+        .assert()","+        .success();","+}","+","+fn enable_start_script(project_dir: &Path) {","+    let manifest_path = project_dir.join(\"package.json\");","+    let mut manifest: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&manifest_path).unwrap()).unwrap();","+    manifest[\"scripts\"] = serde_json::json!({ \"start\": \"node index.js\" });","+    fs::write(manifest_path, manifest.to_string()).unwrap();","+}","+","+#[test]","+fn deployed_project_is_self