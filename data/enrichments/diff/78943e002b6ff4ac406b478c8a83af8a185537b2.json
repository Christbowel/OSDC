dir, deploy_dir): (&Path, &Path),","+    deploy_lockfile: &mut Lockfile,","+    settings: &mut DeployWorkspaceSettings,","+) {","+    let (Some(lockfile_patches), Some(config_patches)) =","+        (lockfile.patched_dependencies.as_ref(), config.patched_dependencies.as_ref())","+    else {","+        return;","+    };","+    let groups = pnpm_lockfile::patch_groups_from_hashes(lockfile_patches);","+    let applied = groups","+        .as_ref()","+        .and_then(|groups| pnpm_lockfile::applied_patch_keys(deploy_lockfile, groups));","+    let pruned_lockfile = lockfile_patches","+        .iter()","+        .filter(|(key, _)| is_applied_patch_key(applied.as_ref(), key))","+        .map(|(key, hash)| (key.clone(), hash.clone()))","+        .collect::<BTreeMap<_, _>>();","+    let rewritten =","+        relativize_config_patches(config_patches, lockfile_dir, deploy_dir, applied.as_ref());","+    deploy_lockfile.patched_dependencies = (!pruned_lockfile.is_empty()).then_some(pruned_lockfile);","+    settings.patched_dependencies = (!rewritten.is_empty()).then_some(rewritten);","+}","+","+fn is_applied_patch_key(applied: Option<&BTreeSet<&str>>, key: &str) -> bool {","+    applied.is_none_or(|keys| keys.contains(key))","+}","+","+fn relativize_config_patches(","+    config_patches: &indexmap::IndexMap<String, String>,","+    lockfile_dir: &Path,","+    deploy_dir: &Path,","+    applied: Option<&BTreeSet<&str>>,","+) -> indexmap::IndexMap<String, String> {","+    config_patches","+        .iter()","+        .filter(|(key, _)| is_applied_patch_key(applied, key))","+        .map(|(name, value)| {","+            let absolute = if Path::new(value).is_absolute() {","+                PathBuf::from(value)","+            } else {","+                lockfile_dir.join(value)","+            };","+            (name.clone(), relative_path(deploy_dir, &absolute))","+        })","+        .collect()"," }"],"additions":307,"deletions":72,"truncated":false},{"path":"pnpm/crates/cli/tests/