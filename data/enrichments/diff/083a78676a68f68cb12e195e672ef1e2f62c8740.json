get_block_number().await {","+            let latest_message = if let Ok(latest_block) = provider.get_block_number().await {","                 if let Some(block_number) = self.fork_block_number","                     && block_number <= latest_block","                 {","@@ -277,18 +396,67 @@ impl EvmOpts {","             } else {","                 Default::default()","             };","-            eyre::bail!(\"failed to get {bn_msg}{latest_msg}\");","+            eyre::bail!(\"failed to get {block_number_message}{latest_message}\");","         };"," ","-        let block_number = block.header().number();","+        let fork_block = BlockNumHash::new(block.header().number(), block.header().hash());","+        Ok((block, fork_block))","+    }","+","+    fn fork_env_error_context(&self) -> String {","+        let mut message = \"could not instantiate forked environment\".to_string();","+        if let Some(fork_url) = self.fork_url.as_deref()","+            && let Ok(url) = Url::parse(fork_url)","+            && let Some(host) = url.host()","+        {","+            write!(message, \" with provider {host}\").unwrap();","+        }","+        message","+    }","+","+    async fn fork_evm_env_at_resolved<","+        SPEC: Into<SpecId> + Default + Copy,","+        BLOCK: FoundryBlock + Default,","+        N: Network,","+        P: Provider<N>,","+    >(","+        &self,","+        provider: &P,","+        expected: &ResolvedFork,","+    ) -> eyre::Result<EvmEnv<SPEC, BLOCK>> {","+        let (chain_id, block) = tokio::try_join!(","+            option_try_or_else(self.env.chain_id, async || provider.get_chain_id().await),","+            provider.get_block_by_hash(expected.hash())","+        )","+        .wrap_err(\"could not instantiate resolved fork environment\")?;","+        let block =","+            block.ok_or_else(|| eyre::eyre!(\"failed to get block hash: {}\", expected.hash()))?;","+        let actual = BlockNumHash::new(block.header().number(), block.header().hash());","+        eyre::ensure!(","+            actual == expected.block(),","+            \"resolved fork block changed: expected {expected:?}, got {actual:?}\"","+        );","+","+        Ok(self.fork_env_from_block::<SPEC, BLOCK, N>(chain_id, &block))","+    }","+","+    fn fork_env_from_block<","+        SPEC: Into<SpecId> + Default + Copy,","+        BLOCK: FoundryBlock + Default,","+        N: Network,","+    >(","+        &self,","+        chain_id: ChainId,","+        block: &N::BlockResponse,","+    ) -> EvmEnv<SPEC, BLOCK> {","         let mut evm_env = EvmEnv {","             cfg_env: self.cfg_env(chain_id),","             block_env: block_env_from_header(block.header()),","         };"," ","-        apply_chain_and_block_specific_env_changes::<N, _, _>(&mut evm_env, &block, self.networks);","+        apply_chain_and_block_specific_env_changes::<N, _, _>(&mut evm_env, block, self.networks);"," ","-        Ok((evm_env, block_number))","+        evm_env","     }"," ","     /// Returns the [`EvmEnv`] configured with only local settings.","@@ -495,6 +663,10 @@ async fn option_try_or_else<T, E>("," "," #[cfg(test)]"," mod tests {","+    use alloy_network::TransactionBuilder;","+    use alloy_primitives::bytes;","+    use alloy_rpc_types::TransactionRequest;","+    use alloy_serde::WithOtherFields;","     use revm::context::{BlockEnv, TxEnv};"," ","     use super::*;","@@ -559,6 +731,91 @@ mod tests {","         assert!(err.to_string().contains(\"fork block must be resolved\"));","     }"," ","+    #[test]","+    fn resolved_fork_matches_source_headers_and_selector() {","+        let headers = vec![\"Authorization: one\".to_string()];","+        let fork = ResolvedFork::new(","+            \"http://127.0.0.1:1\",","+            Some(&headers),","+            None,","+            BlockNumHash::new(1, B256::ZERO),","+        );","+        let mut evm_opts = EvmOpts {","+            fork_url: Some(\"http://127.0.0.1:1\".to_string()),","+            fork_headers: Some(headers),","+            ..Default::default()","+        };","+","+        assert!(evm_opts.resolved_fork_matches(&fork));","+        let debug = format!(\"{fork:?}\");","+        assert!(!debug.contains(\"127.0.0.1\"));","+        assert!(!debug.contains(\"Authorization\"));","+        assert!(!debug.contains(\"one\"));","+","+        evm_opts.fork_headers = Some(vec![\"Authorization: two\".to_string()]);","+        assert!(!evm_opts.resolved_fork_matches(&fork));","+","+        evm_opts.fork_headers = Some(vec![\"Authorization: one\".to_string()]);","+        evm_opts.fork_block_number = Some(1);","+        assert!(!evm_opts.resolved_fork_matches(&fork));","+","+        evm_opts.fork_block_number = None;","+        evm_opts.fork_url = Some(\"http://127.0.0.1:2\".to_string());","+        assert!(!evm_opts.resolved_fork_matches(&fork));","+","+        let fork =","+            ResolvedFork::new(\"http://127.0.0.1:1\", None, None, BlockNumHash::new(1, B256::ZERO));","+        evm_opts.fork_url = Some(\"http://127.0.0.1:1\".to_string());","+        evm_opts.fork_headers = Some(Vec::new());","+        assert!(evm_opts.resolved_fork_matches(&fork));","+    }","+","+    #[tokio::test(flavor = \"multi_thread\")]","+    async fn create2_deployer_preflight_uses_exact_fork_hash() {","+        let (_api, handle) = anvil::spawn(anvil::NodeConfig::test()).await;","+        let provider = handle.http_provider();","+        let sender = handle.dev_accounts().next().unwrap();","+","+        let init_code = bytes!(\"6001600c60003960016000f300\");","+        let receipt = provider","+            .send_transaction(WithOtherFields::new(","+                TransactionRequest::default().from(sender).with_deploy_code(init_code),","+            ))","+            .await","+            .unwrap()","+            .get_receipt()","+            .await","+            .unwrap();","+        let deployer = receipt.contract_address.unwrap();","+        let block_number = receipt.block_numb