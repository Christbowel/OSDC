{"id":"90c98ae21ef0444a4088b7081676b0f97915001f","axis":"silent","repo":"withastro/astro","sha":"90c98ae21ef0444a4088b7081676b0f97915001f","parsed":{"files":[{"path":".changeset/session-false-cloudflare.md","lines":["@@ -0,0 +1,5 @@","+---","+'@astrojs/cloudflare': minor","+---","+","+When `session: false` is set in `astro.config`, the adapter no longer auto-wires the Cloudflare KV session driver. Combined with the matching `astro` change, this lets the session runtime tree-shake out of the Worker bundle."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/session-false-netlify.md","lines":["@@ -0,0 +1,5 @@","+---","+'@astrojs/netlify': minor","+---","+","+When `session: false` is set in `astro.config`, the adapter no longer auto-wires the Netlify Blobs session driver. Combined with the matching `astro` change, this lets the session runtime tree-shake out of the function bundle."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/session-false-node.md","lines":["@@ -0,0 +1,5 @@","+---","+'@astrojs/node':  minor","+---","+","+When `session: false` is set in `astro.config`, the adapter no longer auto-wires the filesystem session driver. Combined with the matching `astro` change, this lets the session runtime tree-shake out of the server bundle."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/session-false-opt-out.md","lines":["@@ -0,0 +1,21 @@","+---","+'astro': minor","+---","+","+Adds `session: false` in `astro.config` to opt out of session support. Projects that do not set `session: false` see no behavior change.","+","+```js title=\"astro.config.mjs\"","+import { defineConfig } from 'astro/config';","+","+export default defineConfig({","+  session: false,","+});","+```","+","+The session runtime and dependencies (`unstorage`) are now tree-shaken out of the SSR bundle for any project where no session driver is wired via:","+","+* `session: false`","+* no `session` config at all","+* a `session` config without a driver","+","+Useful for serverless/edge runtimes where cold-start parse time is sensitive."],"additions":21,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/create-vite.ts","lines":["@@ -50,7 +50,7 @@ import { joinPaths } from './path.js';"," import { ServerIslandsState } from './server-islands/shared-state.js';"," import { vitePluginServerIslands } from './server-islands/vite-plugin-server-islands.js';"," import { vitePluginCacheProvider } from './cache/vite-plugin.js';","-import { vitePluginSessionDriver } from './session/vite-plugin.js';","+import { vitePluginSessionDriver, vitePluginSessionProvider } from './session/vite-plugin.js';"," import { vitePluginLogger } from './logger/vite-plugin.js';"," import { isObject } from './util-runtime.js';"," import { vitePluginEnvironment } from '../vite-plugin-environment/index.js';","@@ -231,6 +231,7 @@ export async function createVite("," \t\t\tvitePluginActions({ fs, settings }),"," \t\t\tvitePluginServerIslands({ settings, logger, serverIslandsState }),"," \t\t\tvitePluginSessionDriver({ settings }),","+\t\t\tvitePluginSessionProvider({ settings }),"," \t\t\tvitePluginCacheProvider({ settings }),"," \t\t\tvitePluginLogger({ settings }),"," \t\t\tastroContainer(),"],"additions":2,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/errors/default-handler.ts","lines":["@@ -7,7 +7,7 @@ import { getCookiesFromResponse } from '../cookies/response.js';"," import { AstroMiddleware } from '../middleware/astro-middleware.js';"," import { PagesHandler } from '../pages/handler.js';"," import { matchRoute } from '../routing/match.js';","-import { provideSession } from '../session/handler.js';","+import { provideSession } from '../session/provider.js';"," import { validateHost } from '../app/validate-headers.js';"," import { getErrorRoutePath } from '../../i18n/error-routes.js';"," import { getOutputFilename } from '../output-filename.js';"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/fetch/index.ts","lines":["@@ -19,7 +19,7 @@ import { AstroMiddleware } from '../middleware/astro-middleware.js';"," import { PagesHandler } from '../pages/handler.js';"," import { renderRedirect } from '../redirects/render.js';"," import { AstroHandler } from '../routing/handler.js';","-import { provideSession } from '../session/handler.js';","+import { provideSession } from '../session/provider.js';"," import { TrailingSlashHandler } from '../routing/trailing-slash-handler.js';"," "," function getApp(request: Request): BaseApp<Pipeline> {"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/routing/handler.ts","lines":["@@ -7,7 +7,7 @@ import { I18n } from '../i18n/handler.js';"," import { AstroMiddleware } from '../middleware/astro-middleware.js';"," import { PagesHandler } from '../pages/handler.js';"," import { renderRedirect } from '../redirects/render.js';","-import { provideSession } from '../session/handler.js';","+import { provideSession } from '../session/provider.js';"," import type { FetchState } from '../fetch/fetch-state.js';"," import { prepareResponse } from '../app/prepare-response.js';"," import type { BaseApp } from '../app/base.js';"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/session/config.ts","lines":["@@ -5,7 +5,7 @@ export const SessionDriverConfigSchema = z.object({"," \tentrypoint: z.union([z.string(), z.instanceof(URL)]),"," });"," ","-export const SessionSchema = z.object({","+const SessionObjectSchema = z.object({"," \tdriver: z"," \t\t.union(["," \t\t\tz.string().superRefine(() => {","@@ -32,3 +32,9 @@ export const SessionSchema = z.object({"," \t\t.optional(),"," \tttl: z.number().optional(),"," });","+","+// `session: false` opts out of session support entirely so the session","+// runtime and any adapter-provided driver can be tree-shaken from the","+// SSR bundle.","+// See packages/astro/src/core/session/provider-disabled.ts.","+export const SessionSchema = z.union([z.literal(false), SessionObjectSchema]);"],"additions":7,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/session/provider-disabled.ts","lines":["@@ -0,0 +1,16 @@","+import { PipelineFeatures } from '../base-pipeline.js';","+import type { FetchState } from '../fetch/fetch-state.js';","+","+// Drop-in for `provideSession` substituted in for `./provider.js` by the","+// `astro:session-provider` Vite plugin when `session: false` is set.","+// Imports nothing from `./runtime.js`, so the session runtime tree-shakes","+// out of the SSR bundle.","+//","+// It registers no session provider, so `Astro.session` (and","+// `context.session`) is `undefined` — the same behavior as a project","+// without sessions configured, matching its `AstroSession | undefined`","+// type. We still mark the feature as used so the missing-feature warning","+// in `BaseApp` never fires.","+export function provideSession(state: FetchState): void {","+\tstate.pipeline.usedFeatures |= PipelineFeatures.sessions;","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/session/provider.ts","lines":["@@ -0,0 +1,8 @@","+// Re-export shim. Importing `provideSession` from `./provider.js` (rather","+// than `./handler.js` directly) lets the Vite plugin swap this file for","+// `./provider-disabled.js` when `session: false` is configured, so Rollup","+// can tree-shake `./runtime.js` out of the SSR bundle.","+//","+// At runtime in environments without Vite (Node-loaded `dist/`, library","+// tooling), this file resolves normally and keeps the real provider.","+export { provideSession } from './handler.js';"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/session/utils.ts","lines":["@@ -48,6 +48,9 @@ export function normalizeSessionDriverConfig("," export function sessionConfigToManifest("," \tconfig: AstroConfig['session'],"," ): SSRManifestSession | undefined {","+\tif (config === false) {","+\t\treturn undefined;","+\t}"," \tconst sessionDriver = config?.driver;"," \tif (!config || !sessionDriver) {"," \t\treturn undefined;"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/session/vite-plugin.ts","lines":["@@ -1,8 +1,10 @@","+import { realpathSync } from 'node:fs';"," import { fileURLToPath } from 'node:url';"," import type { Plugin as VitePlugin } from 'vite';"," import type { AstroSettings } from '../../types/astro.js';"," import { SessionStorageInitError } from '../errors/errors-data.js';"," import { AstroError } from '../errors/index.js';","+import { normalizePath } from '../viteUtils.js';"," import { normalizeSessionDriverConfig } from './utils.js';"," "," export const VIRTUAL_SESSION_DRIVER_ID = 'virtual:astro:session-driver';","@@ -27,14 +29,12 @@ export function vitePluginSessionDriver({ settings }: { settings: AstroSettings"," \t\t\t\tid: new RegExp(`^${RESOLVED_VIRTUAL_SESSION_DRIVER_ID}$`),"," \t\t\t},"," \t\t\tasync handler() {","-\t\t\t\tif (!settings.config.session?.driver) {","+\t\t\t\tconst session = settings.config.session;","+\t\t\t\tif (session === false || !session?.driver) {"," \t\t\t\t\treturn { code: 'export default null;' };"," \t\t\t\t}"," ","-\t\t\t\tconst driver = normalizeSessionDriverConfig(","-\t\t\t\t\tsettings.config.session.driver,","-\t\t\t\t\tsettings.config.session.options,","-\t\t\t\t);","+\t\t\t\tconst driver = normalizeSessionDriverConfig(session.driver, session.options);"," \t\t\t\tconst importerPath = fileURLToPath(import.meta.url);"," \t\t\t\tconst resolved = await this.resolve(driver.entrypoint, importerPath);"," \t\t\t\tif (!resolved) {","@@ -54,3 +54,66 @@ export function vitePluginSessionDriver({ settings }: { settings: AstroSettings"," \t\t},"," \t};"," }","+","+// When no session driver will be present at request time, swap Astro's own","+// `core/session/provider.js` for `core/session/provider-disabled.js` so","+// Rollup tree-shakes `runtime.js` (and `unstorage`) out of the SSR bundle.","+//","+// This covers `session: false`, `session: undefined`, and a `session`","+// object without a driver. By the time this plugin resolves, adapters have","+// already wired their default driver into `config.session.driver` (during","+// `astro:config:setup`), so `session?.driver` reflects the final decision —","+// the same signal `vitePluginSessionDriver` uses to emit `default null`.","+// Swapping in the no-op provider is behavior-preserving: the real provider","+// already resolves `Astro.session` to `undefined` when no driver factory","+// exists, so the only difference is the dead runtime is dropped.","+//","+// To avoid hijacking unrelated `./session/provider.js` paths in user code","+// or third-party deps, we resolve each candidate specifier through Vite","+// and only redirect when it resolves to Astro's own provider file.","+const PROVIDER_FILENAME = 'provider.js';","+const DISABLED_PROVIDER_FILENAME = 'provider-disabled.js';","+","+function canonicalizePath(filePath: string): string {","+\ttry {","+\t\t// Resolve symlinks, which Node does for `import.meta.url` but Vite only","+\t\t// does when `resolve.preserveSymlinks` is false, and normalize to forward","+\t\t// slashes so the two sides compare equal on Windows.","+\t\treturn normalizePath(realpathSync(filePath));","+\t} catch {","+\t\t// Not a file on disk (bare specifier, virtual module), so there is no","+\t\t// symlink to resolve.","+\t\treturn normalizePath(filePath);","+\t}","+}","+","+export function vitePluginSessionProvider({ settings }: { settings: AstroSettings }): VitePlugin {","+\tconst providerPath = canonicalizePath(","+\t\tfileURLToPath(new URL(`./${PROVIDER_FILENAME}`, import.meta.url)),","+\t);","+\tconst disabledProviderPath = canonicalizePath(","+\t\tfileURLToPath(new URL(`./${DISABLED_PROVIDER_FILENAME}`, import.meta.url)),","+\t);","+\treturn {","+\t\tname: 'astro:session-provider',","+\t\tenforce: 'pre',","+\t\tasync resolveId(id, importer) {","+\t\t\t// Keep the real provider only when a driver will be present.","+\t\t\tconst session = settings.config.session;","+\t\t\tconst hasSessionDriver = session !== false && !!session?.driver;","+\t\t\tif (hasSessionDriver) return null;","+\t\t\t// Cheap prefilter to avoid resolving every import in the graph.","+\t\t\t// Only specifiers that *could* point at Astro's provider file","+\t\t\t// proceed to the (expensive) full resolution + identity check.","+\t\t\tif (!normalizePath(id).endsWith(`/session/${PROVIDER_FILENAME}`)) return null;","+\t\t\t// Fast path: caller already passed Astro's absolute provider path.","+\t\t\tif (canonicalizePath(id) === providerPath) return disabledProviderPath;","+\t\t\tif (!importer) return null;","+\t\t\tconst resolved = await this.resolve(id, importer, { skipSelf: true });","+\t\t\tif (resolved && canonicalizePath(resolved.id) === providerPath) {","+\t\t\t\treturn disabledProviderPath;","+\t\t\t}","+\t\t\treturn null;","+\t\t},","+\t};","+}"],"additions":68,"deletions":5,"truncated":false},{"path":"packages/astro/src/types/public/config.ts","lines":["@@ -1689,9 +1689,19 @@ export interface AstroUserConfig<"," \t *"," \t * Session drivers are configured at build time. This means environment variables used in the driver configuration are inlined. You must create your own driver entrypoint to [override the configuration at runtime](https://docs.astro.build/en/guides/sessions/#overriding-the-configuration-at-runtime)."," \t *","+\t * Set to `false` to opt out of session support entirely. With `session: false`, the session runtime is excluded from the SSR bundle, adapters skip wiring their default session driver, and `Astro.session` (and `context.session`) is `undefined` — the same as a project without sessions configured. Useful for serverless and edge runtimes where bundle parse time is sensitive.","+\t *","+\t * ```js title=\"astro.config.mjs\"","+\t * import { defineConfig } from 'astro/config';","+\t *","+\t * export default defineConfig({","+\t *   session: false,","+\t * });","+\t * ```","+\t *"," \t * See [the sessions guide](https://docs.astro.build/en/guides/sessions/) for more information."," \t */","-\tsession?: SessionConfig<TDriver>;","+\tsession?: SessionConfig<TDriver> | false;"," "," \t/**"," \t * @docs"],"additions":11,"deletions":1,"truncated":false},{"path":"packages/astro/test/fixtures/session-false/astro.config.mjs","lines":["@@ -0,0 +1,4 @@","+//  @ts-check","+import { defineConfig } from 'astro/config';","+","+export default defineConfig({});"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-false/package.json","lines":["@@ -0,0 +1,8 @@","+{","+  \"name\": \"@test/session-false\",","+  \"version\": \"0.0.0\",","+  \"private\": true,","+  \"dependencies\": {","+    \"astro\": \"workspace:*\"","+  }","+}"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-false/src/pages/api.ts","lines":["@@ -0,0 +1,7 @@","+import type { APIRoute } from 'astro';","+","+// With `session: false`, `context.session` is `undefined` (matching its","+// `AstroSession | undefined` type), so user code can feature-detect it.","+export const GET: APIRoute = (context) => {","+\treturn Response.json({ hasSession: context.session != null });","+};"],"additions":7,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-false/src/pages/no-session.ts","lines":["@@ -0,0 +1,5 @@","+import type { APIRoute } from 'astro';","+","+// Route that never accesses session — used to verify that disabling","+// sessions does not affect unrelated routes.","+export const GET: APIRoute = () => Response.json({ ok: true });"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-false/src/pages/user-provider.ts","lines":["@@ -0,0 +1,9 @@","+import type { APIRoute } from 'astro';","+// `.js` extension is intentional — this is the specifier shape that","+// enters the `astro:session-provider` plugin's prefilter. The plugin","+// must resolve the import to the user's own file (not Astro's provider)","+// and leave it untouched. Imported with `.ts` instead, the prefilter","+// would skip and this test would pass trivially.","+import { USER_PROVIDER_SENTINEL } from '../session/provider.js';","+","+export const GET: APIRoute = () => Response.json({ value: USER_PROVIDER_SENTINEL });"],"additions":9,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-false/src/session/provider.ts","lines":["@@ -0,0 +1,5 @@","+// Decoy: user code shaped exactly like the path the","+// astro:session-provider plugin intercepts, to prove the plugin does","+// not hijack unrelated `./session/provider.js` imports under","+// `session: false`.","+export const USER_PROVIDER_SENTINEL = 'user-provider-was-not-hijacked';"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-tree-shake/astro.config.mjs","lines":["@@ -0,0 +1,4 @@","+//  @ts-check","+import { defineConfig } from 'astro/config';","+","+export default defineConfig({});"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-tree-shake/package.json","lines":["@@ -0,0 +1,8 @@","+{","+  \"name\": \"@test/session-tree-shake\",","+  \"version\": \"0.0.0\",","+  \"private\": true,","+  \"dependencies\": {","+    \"astro\": \"workspace:*\"","+  }","+}"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-tree-shake/src/pages/api.ts","lines":["@@ -0,0 +1,8 @@","+import type { APIRoute } from 'astro';","+","+// Reports whether `context.session` is defined. When no driver is wired","+// (no adapter default, no user config), it is `undefined`; when a driver","+// is configured, it is an `AstroSession`.","+export const GET: APIRoute = (context) => {","+\treturn Response.json({ hasSession: context.session != null });","+};"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/astro/test/fixtures/session-tree-shake/src/pages/no-session.ts","lines":["@@ -0,0 +1,4 @@","+import type { APIRoute } from 'astro';","+","+// Route that never accesses the session.","+export const GET: APIRoute = () => Response.json({ ok: true });"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/astro/test/session-false.test.ts","lines":["@@ -0,0 +1,62 @@","+import assert from 'node:assert/strict';","+import { before, describe, it } from 'node:test';","+import testAdapter from './test-adapter.ts';","+import { type App, type Fixture, loadFixture } from './test-utils.ts';","+","+describe('session: false', () => {","+\tlet fixture: Fixture;","+\tlet app: App;","+","+\tbefore(async () => {","+\t\tfixture = await loadFixture({","+\t\t\troot: './fixtures/session-false/',","+\t\t\toutput: 'server',","+\t\t\tadapter: testAdapter(),","+\t\t\tsession: false,","+\t\t\toutDir: './dist/session-false/',","+\t\t});","+\t\tawait fixture.build({});","+\t\tapp = await fixture.loadTestAdapterApp();","+\t});","+","+\tasync function fetchResponse(routePath: string) {","+\t\tconst request = new Request('http://example.com' + routePath);","+\t\treturn app.render(request);","+\t}","+","+\tit('does not affect routes that never touch the session', async () => {","+\t\tconst response = await fetchResponse('/no-session');","+\t\tassert.equal(response.status, 200);","+\t\tconst body = await response.json();","+\t\tassert.deepEqual(body, { ok: true });","+\t});","+","+\tit('leaves Astro.session undefined when a route reads it', async () => {","+\t\tconst response = await fetchResponse('/api');","+\t\tassert.equal(response.status, 200);","+\t\tconst body = (await response.json()) as { hasSession?: boolean };","+\t\tassert.equal(body.hasSession, false, 'expected context.session to be undefined');","+\t});","+","+\tit('does not hijack a user `./session/provider.js` import', async () => {","+\t\tconst response = await fetchResponse('/user-provider');","+\t\tassert.equal(response.status, 200);","+\t\tconst body = (await response.json()) as { value?: string };","+\t\tassert.equal(body.value, 'user-provider-was-not-hijacked');","+\t});","+","+\tit('excludes the session runtime and unstorage from the SSR bundle', async () => {","+\t\tconst entries = await fixture.glob('**/*.{mjs,js,cjs}');","+\t\tlet hasUnstorage = false;","+\t\tlet hasSessionRuntime = false;","+\t\tfor (const entry of entries) {","+\t\t\tconst body = await fixture.readFile(entry);","+\t\t\t// `createStorage` is `unstorage`'s top-level export — present iff","+\t\t\t// `unstorage` is bundled. The runtime class is `AstroSession`.","+\t\t\tif (/\\bcreateStorage\\b/.test(body)) hasUnstorage = true;","+\t\t\tif (/class AstroSession\\b/.test(body)) hasSessionRuntime = true;","+\t\t}","+\t\tassert.equal(hasUnstorage, false, 'unstorage should not appear in the SSR bundle');","+\t\tassert.equal(hasSessionRuntime, false, 'AstroSession class should not appear in the SSR bundle');","+\t});","+});"],"additions":62,"deletions":0,"truncated":false},{"path":"packages/astro/test/session-tree-shake.test.ts","lines":["@@ -0,0 +1,90 @@","+import assert from 'node:assert/strict';","+import { before, describe, it } from 'node:test';","+import testAdapter from './test-adapter.ts';","+import { type App, type Fixture, loadFixture } from './test-utils.ts';","+","+// `createStorage` is `unstorage`'s top-level export — present iff `unstorage`","+// is bundled. The runtime class is `AstroSession`.","+async function bundleHasSessionRuntime(fixture: Fixture) {","+\tconst entries = await fixture.glob('**/*.{mjs,js,cjs}');","+\tlet hasUnstorage = false;","+\tlet hasSessionRuntime = false;","+\tfor (const entry of entries) {","+\t\tconst body = await fixture.readFile(entry);","+\t\tif (/\\bcreateStorage\\b/.test(body)) hasUnstorage = true;","+\t\tif (/class AstroSession\\b/.test(body)) hasSessionRuntime = true;","+\t}","+\treturn { hasUnstorage, hasSessionRuntime };","+}","+","+describe('session tree-shaking when no driver is wired', () => {","+\tlet fixture: Fixture;","+\tlet app: App;","+","+\tbefore(async () => {","+\t\t// No `session` config and an adapter that does not wire a default","+\t\t// driver — the same \"no sessions\" state as before this feature.","+\t\tfixture = await loadFixture({","+\t\t\troot: './fixtures/session-tree-shake/',","+\t\t\toutput: 'server',","+\t\t\tadapter: testAdapter(),","+\t\t\toutDir: './dist/session-tree-shake-no-driver/',","+\t\t});","+\t\tawait fixture.build({});","+\t\tapp = await fixture.loadTestAdapterApp();","+\t});","+","+\tit('leaves Astro.session undefined', async () => {","+\t\tconst response = await app.render(new Request('http://example.com/api'));","+\t\tassert.equal(response.status, 200);","+\t\tconst body = (await response.json()) as { hasSession?: boolean };","+\t\tassert.equal(body.hasSession, false, 'expected context.session to be undefined');","+\t});","+","+\tit('does not affect routes that never touch the session', async () => {","+\t\tconst response = await app.render(new Request('http://example.com/no-session'));","+\t\tassert.equal(response.status, 200);","+\t\tassert.deepEqual(await response.json(), { ok: true });","+\t});","+","+\tit('excludes the session runtime and unstorage from the SSR bundle', async () => {","+\t\tconst { hasUnstorage, hasSessionRuntime } = await bundleHasSessionRuntime(fixture);","+\t\tassert.equal(hasUnstorage, false, 'unstorage should not appear in the SSR bundle');","+\t\tassert.equal(hasSessionRuntime, false, 'AstroSession class should not appear in the SSR bundle');","+\t});","+});","+","+describe('session runtime is retained when a driver is configured', () => {","+\tlet fixture: Fixture;","+\tlet app: App;","+","+\tbefore(async () => {","+\t\t// A configured driver must keep the runtime in the bundle — guards","+\t\t// against the provider swap over-shaking real session setups.","+\t\tfixture = await loadFixture({","+\t\t\troot: './fixtures/session-tree-shake/',","+\t\t\toutput: 'server',","+\t\t\t