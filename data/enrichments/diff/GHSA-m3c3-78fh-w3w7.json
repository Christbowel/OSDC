f any of the resolved targets are not allowed.","+\t/// - `InvalidUrl`: Returned if the URL does not have a valid host.","+\t///"," \t#[cfg(feature = \"http\")]","-\tpub(crate) fn check_allowed_net(&self, url: &Url) -> Result<()> {","+\tpub(crate) async fn check_allowed_net(&self, url: &Url) -> Result<()> {","+\t\tlet match_any_deny_net = |t| {","+\t\t\tif self.capabilities.matches_any_deny_net(t) {","+\t\t\t\twarn!(\"Capabilities denied outgoing network connection attempt, target: '{t}'\");","+\t\t\t\tbail!(Error::NetTargetNotAllowed(t.to_string()));","+\t\t\t}","+\t\t\tOk(())","+\t\t};"," \t\tmatch url.host() {"," \t\t\tSome(host) => {","-\t\t\t\tlet target = &NetTarget::Host(host.to_owned(), url.port_or_known_default());","-\t\t\t\tif !self.capabilities.allows_network_target(target) {","+\t\t\t\tlet target = NetTarget::Host(host.to_owned(), url.port_or_known_default());","+\t\t\t\t// Check the domain name (if any) matches the allow list","+\t\t\t\tlet host_allowed = self.capabilities.matches_any_allow_net(&target);","+\t\t\t\tif !host_allowed {"," \t\t\t\t\twarn!("," \t\t\t\t\t\t\"Capabilities denied outgoing network connection attempt, target: '{target}'\""," \t\t\t\t\t);"," \t\t\t\t\tbail!(Error::NetTargetNotAllowed(target.to_string()));"," \t\t\t\t}","+\t\t\t\t// Check against the deny list","+\t\t\t\tmatch_any_deny_net(&target)?;","+\t\t\t\t// Resolve the domain name to a vector of IP addresses","+\t\t\t\t#[cfg(not(target_family = \"wasm\"))]","+\t\t\t\tlet targets = target.resolve().await?;","+\t\t\t\t#[cfg(target_family = \"wasm\")]","+\t\t\t\tlet targets = target.resolve()?;","+\t\t\t\tfor t in &targets {","+\t\t\t\t\t// For each IP address resolved, check it is allowed","+\t\t\t\t\tmatch_any_deny_net(t)?;","+\t\t\t\t}"," \t\t\t\ttrace!(\"Capabilities allowed outgoing network connection, target: '{target}'\");"," \t\t\t\tOk(())"," \t\t\t}","@@ -555,3 +611,33 @@ impl MutableContext {"," \t\t}"," \t}"," }","+","+#[cfg(test)]","+mod tests {","+\t#[cfg(feature