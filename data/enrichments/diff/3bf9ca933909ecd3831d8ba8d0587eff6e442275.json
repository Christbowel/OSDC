{"id":"3bf9ca933909ecd3831d8ba8d0587eff6e442275","axis":"silent","repo":"doorkeeper-gem/doorkeeper","sha":"3bf9ca933909ecd3831d8ba8d0587eff6e442275","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -17,6 +17,7 @@ User-visible changes worth mentioning."," - [#1978] A client ID metadata document's `jwks_uri` is kept when the application model has a `jwks_uri` column. A document preferring `private_key_jwt` then makes a confidential client, which has to authenticate with its key wherever the server offers `private_key_jwt`, and whose tokens stay under `public_client_access_token_expires_in`."," - [#1944] Add the `revoke_previous_access_token_on_refresh` option (default `true`): set to `false`, the refresh_token grant revokes only the exchanged refresh token and the previous access token stays usable until it expires. Requires the new `refresh_token_revoked_at` column (`rails generate doorkeeper:refresh_token_revoked_at`)."," - [#1980] Omit `scopes_supported` from the authorization server metadata when no scopes are configured (RFC 8414 §3.2).","+- [#1979] **[BREAKING]** Refuse the non-standard out-of-band redirect URIs (`urn:ietf:wg:oauth:2.0:oob`, `urn:ietf:wg:oauth:2.0:oob:auto`) by default: when an application is registered, at the authorization endpoint and on the code exchange; `oauth/authorize/native` is no longer drawn. Applications already stored with such a URI are refused with `invalid_redirect_uri` at the authorization endpoint and `invalid_grant` on the code exchange. Set `allow_oob_redirect_uris true` to keep the old behavior."," - [#PR ID] Description of the change."," "," ## 6.0.0.rc2"],"additions":1,"deletions":0,"truncated":false},{"path":"lib/doorkeeper/config.rb","lines":["@@ -155,7 +155,7 @@ def enable_multiple_database_roles","       # Choose to use the url path for native autorization codes","       # Enabling this flag sets the authorization code response route for","       # native redirect uris to oauth/authorize/<code>. The default is","-      # oauth/authorize/native?code=<code>.","+      # oauth/authorize/native?code=<code>. Needs allow_oob_redirect_uris.","       # Rationale: https://github.com/doorkeeper-gem/doorkeeper/issues/1143","       def use_url_path_for_native_authorization","         @config.instance_variable_set(:@use_url_path_for_native_authorization, true)","@@ -340,6 +340,10 @@ def configure_secrets_for(type, using:, fallback:)","     option :authorization_code_expires_in,  default: 600","     option :orm,                            default: :active_record","     option :native_redirect_uri,            default: \"urn:ietf:wg:oauth:2.0:oob\", deprecated: true","+    # Accept the non-standard out-of-band redirect URIs urn:ietf:wg:oauth:2.0:oob","+    # and urn:ietf:wg:oauth:2.0:oob:auto and draw the page that shows the code","+    # (oauth/authorize/native). Off by default, as OAuth 2.1 has no such flow.","+    option :allow_oob_redirect_uris,        default: false","     option :grant_flows,                    default: %w[authorization_code client_credentials]","     option :pkce_code_challenge_methods,    default: %w[plain S256]","     option :handle_auth_errors,             default: :render"],"additions":5,"deletions":1,"truncated":false},{"path":"lib/doorkeeper/oauth/helpers/uri_checker.rb","lines":["@@ -16,7 +16,7 @@ module URIChecker","         SCRIPT_SCHEMES = %w[javascript vbscript data].freeze"," ","         def self.valid?(url)","-          return true if oob_uri?(url)","+          return Doorkeeper.config.allow_oob_redirect_uris if oob_uri?(url)"," ","           uri = as_uri(url)","           valid_scheme?(uri) && iff_host?(uri) && uri.fragment.nil? && uri.opaque.nil?"],"additions":1,"deletions":1,"truncated":false},{"path":"lib/doorkeeper/orm/active_record/redirect_uri_validator.rb","lines":["@@ -13,7 +13,7 @@ def validate_each(record, attribute, value)","         record.errors.add(attribute, :blank)","       else","         value.split.each do |val|","-          next if oob_redirect_uri?(val)","+          next if handled_as_oob_redirect_uri?(record, attribute, val)"," ","           uri = ::URI.parse(val)","           record.errors.add(attribute, :forbidden_uri) if forbidden_uri?(uri)","@@ -30,8 +30,12 @@ def validate_each(record, attribute, value)"," ","     private"," ","-    def oob_redirect_uri?(uri)","-      Doorkeeper::OAuth::NonStandard::IETF_WG_OAUTH2_OOB_METHODS.include?(uri)","+    # An out-of-band URI is no URI to parse; it is accepted only with allow_oob_redirect_uris.","+    def handled_as_oob_redirect_uri?(record, attribute, uri)","+      return false unless Doorkeeper::OAuth::NonStandard::IETF_WG_OAUTH2_OOB_METHODS.include?(uri)","+","+      record.errors.add(attribute, :forbidden_uri) unless Doorkeeper.config.allow_oob_redirect_uris","+      true","     end"," ","     # Script schemes are refused before the host application's rule is"],"additions":7,"deletions":3,"truncated":false},{"path":"lib/doorkeeper/rails/routes.rb","lines":["@@ -59,7 +59,7 @@ def authorization_routes(mapping)","           as: mapping[:as],","           controller: mapping[:controllers],","         ) do","-          routes.get native_authorization_code_route, action: :show, on: :member","+          routes.get native_authorization_code_route, action: :show, on: :member if allow_oob_redirect_uris?","           routes.get \"/\", action: :new, on: :member","         end","       end","@@ -107,6 +107,10 @@ def native_authorization_code_route","         Doorkeeper.configuration.native_authorization_code_route","       end"," ","+      def allow_oob_redirect_uris?","+        Doorkeeper.configuration.allow_oob_redirect_uris","+      end","+","       def introspection_routes?","         Doorkeeper.configured? &&","           !Doorkeeper.config.allow_token_introspection.is_a?(FalseClass)"],"additions":5,"deletions":1,"truncated":false},{"path":"lib/generators/doorkeeper/templates/initializer.rb","lines":["@@ -224,6 +224,14 @@","   #","   # force_pkce"," ","+  # Accept the non-standard out-of-band redirect URIs urn:ietf:wg:oauth:2.0:oob","+  # and urn:ietf:wg:oauth:2.0:oob:auto, which are not part of OAuth 2.1, and draw","+  # the page that shows the code (oauth/authorize/native). By default they are","+  # refused when an application is registered and at the authorization endpoint;","+  # applications already stored with such a URI get invalid_redirect_uri.","+  #","+  # allow_oob_redirect_uris true","+","   # Accept the https URL of a public client's metadata document as its client_id","   # (draft-ietf-oauth-client-id-metadata-document). +scopes+ caps what it may request.","   # These are public clients: they get authorization codes only, always with S256 PKCE,"],"additions":8,"deletions":0,"truncated":false},{"path":"spec/controllers/authorizations_controller_spec.rb","lines":["@@ -673,6 +673,8 @@ def query_params","   end"," ","   describe \"GET #new token request with native url and skip_authorization true\" do","+    include_context \"with oob redirect uris allowed\"","+","     before do","       allow(Doorkeeper.config).to receive(:skip_authorization).and_return(proc do","         true","@@ -702,6 +704,8 @@ def query_params","   end"," ","   describe \"GET #new code request with native url and skip_authorization true\" do","+    include_context \"with oob redirect uris allowed\"","+","     before do","       allow(Doorkeeper.config).to receive_messages(grant_flows: %w[authorization_code], skip_authorization: proc do","         true","@@ -734,6 +738,7 @@ def query_params","       around(:each) do |example|","         Doorkeeper.configure do","           orm DOORKEEPER_ORM","+          allow_oob_redirect_uris true","           use_url_path_for_native_authorization","         end"," ","@@ -1659,6 +1664,8 @@ def validate_client","   end"," ","   describe \"GET #new with callbacks\" do","+    include_context \"with oob redirect uris allowed\"","+","     after do","       client.update_attribute :redirect_uri, \"ur