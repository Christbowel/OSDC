[\"_attachments\"][attachment.bundle_name.as_str()] = serde_json::json!({","-        \"content_type\": attachment.content_type,","-        \"data\": attachment.data,","-        \"length\": attachment.data.len(),","-    });","-    Ok(())","-}","-"," /// Resolve `path` against the registry the way `new URL(path, registry)` does."," pub(crate) fn join_registry(","     registry: &NormalizedRegistryUrl,","@@ -448,12 +438,17 @@ pub enum PublishPackedPkgError {","     )]","     VariantsNeedPnpr { registry: String },"," ","-    #[display(\"pnpm cannot sign provenance for a version with platform variants yet\")]","-    #[diagnostic(","-        code(ERR_PNPM_VARIANTS_PROVENANCE_UNSUPPORTED),","-        help(\"Pass --no-provenance to publish without a provenance statement.\")","-    )]","-    VariantsWithProvenance,","+    #[display(\"{name} has no package URL to name it in a provenance statement: {error}\")]","+    #[diagnostic(code(ERR_PNPM_PROVENANCE_PURL))]","+    Purl {","+        name: String,","+        #[error(source)]","+        error: pnpm_release_record::PurlError,","+    },","+","+    #[display(\"The archive {integrity} has no SHA-512 for a provenance statement to name it by\")]","+    #[diagnostic(code(ERR_PNPM_PROVENANCE_NO_SHA512))]","+    NoSha512 { integrity: String },"," ","     #[diagnostic(transparent)]","     Staging(StagingError),","@@ -494,7 +489,10 @@ mod tests;"," "," mod document;"," use document::manifest_string;","+mod provenance;"," mod uploads;"," mod variants;"," ","+use provenance::attach_provenance;","+"," mod request;"],"additions":32,"deletions":34,"truncated":false},{"path":"pnpm/crates/publish/src/publish_packed_pkg/provenance.rs","lines":["@@ -0,0 +1,39 @@","+//! The provenance statement a publish signs and attaches.","+","+use super::{OidcHttpOptions, PackedPkg, PublishPackedPkgError, clean_version, variants};","+use crate::{","+    capabilities::{Clock, EnvVar, OidcFetch},","+    provenance_gen::{SignProvenance, generate_provenance, generate_provenance_for},","+};","+use pnpm_reporter::Reporter;","+","+/// Sign the version's provenance statement and attach it: one statement","+/// naming every archive the version publishes, its `any` archive and each","+/// platform variant.","+pub(super) async fn attach_provenance<Sys, Reporter>(","+    document: &mut serde_json::Value,","+    (name, version): (&str, &str),","+    pkg: &PackedPkg<'_>,","+    http: &OidcHttpOptions,","+) -> Result<(), PublishPackedPkgError>","+where","+    Sys: EnvVar + Clock + OidcFetch + SignProvenance,","+    Reporter: self::Reporter,","+{","+    // The statement names the version as the document keys it, without","+    // build metadata, which is how the registry names its archives.","+    let version = &clean_version(version)?;","+    let attachment = if pkg.publishes_staged_archives() {","+        let subjects = variants::provenance_subjects(pkg, (name, version))?;","+        generate_provenance_for::<Sys, Reporter>(name, version, &subjects, http).await","+    } else {","+        generate_provenance::<Sys, Reporter>(name, version, pkg.tarball_data, http).await","+    }","+    .map_err(PublishPackedPkgError::Provenance)?;","+    document[\"_attachments\"][attachment.bundle_name.as_str()] = serde_json::json!({","+        \"content_type\": attachment.content_type,","+        \"data\": attachment.data,","+        \"length\": attachment.data.len(),","+    });","+    Ok(())","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"pnpm/crates/publish/src/publish_packed_pkg/tests.rs","lines":["@@ -785,6 +785,42 @@ impl SignProvenance for ProvenanceSys {","     }"," }"," ","+/// [`ProvenanceSys`] that also records each statement it signs, so only the","+/// one test that reads the recording shares it.","+struct RecordingProvenanceSys;","+","+/// The statements [`RecordingProvenanceSys`] signed, in order.","+static RECORDED_STATEMENTS: std::sync::Mutex<Vec<Value>> = std::sync::Mutex::new(Vec::new());","+","+impl Clock for RecordingProvenanceSys {","+    fn now_ms() -> u64 {","+        ProvenanceSys::now_ms()","+    }","+}","+impl EnvVar for RecordingProvenanceSys {","+    fn var(name: &str) -> Option<String> {","+        ProvenanceSys::var(name)","+    }","+}","+impl OidcFetch for RecordingProvenanceSys {","+    async fn fetch(request: OidcRequest<'_>) -> Result<OidcResponse, OidcFetchError> {","+        ProvenanceSys::fetch(request).await","+    }","+}","+impl SignProvenance for RecordingProvenanceSys {","+    async fn sign_statement(","+        jwt: &str,","+        statement: &[u8],","+        timeout: Option<Duration>,","+    ) -> Result<SignedProvenance, ProvenanceGenError> {","+        RECORDED_STATEMENTS","+            .lock()","+            .unwrap()","+            .push(serde_json::from_slice(statement).expect(\"a statement is JSON\"));","+        ProvenanceSys::sign_statement(jwt, statement, timeout).await","+    }","+}","+"," /// The `--provenance` flow: `publish_packed_pkg` runs the *real*"," /// `generate_provenance` (only the signer is faked) and splices the signed"," /// `.sigstore` bundle into the document's `_attachments` before the `PUT`.","@@ -886,3 +922,126 @@ fn rejects_a_package_name_that_could_redirect_the_publish_url() {","         build_publish_document(&manifest, b\"x\", &registry(), None, \"latest\", &hashes()).is_ok(),","     );"," }","+","+/// The subjects of the statement a provenance publish of `pkg` to a pnpr","+/// registry signs.","+async fn signed_subjects(pkg: &PackedPkg<'_>) -> Vec<(String, String)> {","+    let mut server = mockito::Server::new_async().await;","+    let registry = format!(\"{}/npm/private\", server.url());","+    server","+        .mock(\"POST\", mockito::Matcher::Regex(\"/oidc/token/exchange/\".to_owned()))","+        .with_status(200)","+        .with_body(r#\"{\"token\":\"registry-token\"}\"#)","+        .create_async()","+        .await;","+    let blob = mockito::Matcher::Regex(\"/-/pnpr/v0/artifacts/blob\".to_owned());","+    server","+        .mock(\"HEAD\", blob.clone())","+        .with_status(404)","+        .create_async()","+        .await;","+    server","+        .mock(\"PUT\", blob)","+        .with_status(201)","+        .create_async()","+        .await;","+    let publish = server","+        .mock(\"PUT\", mockito::Matcher::Regex(\"/npm/private/example-cli$\".to_owned()))","+        .with_status(200)","+        .with_body(\"{}\")","+        .expect(1)","+        .create_async()","+        .await;","+    let opts = PublishPackedPkgOptions {","+        dry_run: false,","+        stage: false,","+        wait_timeout: Duration::ZERO,","+        registry: crate::PublishRegistryOptions {","+            default: registry.clone(),","+            scoped: std::collections::BTreeMap::new(),","+            access: None,","+            tag: \"latest\".to_owned(),","+            otp: None,","+            provenance: Some(true),","+            http: OidcHttpOptions::default(),","+        },","+        release_notes: crate::ReleaseNotesTarget::default(),","+        pnpr_registries: std::collections::HashSet::from([format!(\"{registry}/\")]),","+    };","+    let client = ThrottledClient::default();","+    let auth_headers = AuthHeaders::default();","+    let network = PublishNetwork { client: &client, auth_headers: &auth_headers };","+    RECORDED_STATEMENTS","+        .lock()","+        .unwrap()","+        .clear();","+    publish_packed_pkg::<RecordingProvenanceSys, SilentReporter>(pkg, &opts, &network)","+        .await","+        .expect(\"a provenance publish of variants succeeds\");","+    publish.assert_async().await;","+    let statement = RECORDED_STATEMENTS","+        .lock()","+        .unwrap()","+        .pop()","+        .expect(\"a signed statement\");","+    statement[\"subject\"]","+        .as_array()","+        .unwrap()","+        .iter()","+        .map(|subject| {","+            (","+                subject[\"name\"]","+                    .as_str()","+                    .unwrap()","+                    .to_owned(),","+                subject[\"digest\"][\"sha512\"]","+                    .as_str()","+                    .unwrap()","+                    .to_owned(),","+            )","+        })","+        .collect()","+}","+","+fn sha512_hex(bytes: &[u8]) -> String {","+    use sha2::Digest as _;","+    use std::fmt::Write as _;","+    sha2::Sha512::digest(bytes)","+        .iter()","+        .fold(String::new(), |mut hex, byte| {","+            let _ = write!(hex, \"{byte:02x}\");","+            hex","+        })","+}","+","+#[tokio::test]","+async fn a_provenance_publish_of_variants_signs_one_statement_naming_every_archive() {","+    let manifest = json!({ \"name\": \"example-cli\", \"version\": \"1.0.0+build\" });","+    let variants = [super::PackedVariant {","+        tag: \"linux-x64\".into(),","+        archive: super::VariantArchive::Packed(b\"linux\".to_vec()),","+    }];","+    let mut pkg = PackedPkg {","+        published_manifest: &manifest,","+        tarball_data: b\"any\",","+        tarball_path: \"example-cli-1.0.0.tgz\",","+        contents: &[],","+        unpacked_size: 0,","+        notes: None,","+        variants: &variants,","+        any_staged: None,","+    };","+    assert_eq!(","+        signed_subjects(&pkg).await,","+        [","+            (\"pkg:npm/example-cli@1.0.0\".to_owned(), sha512_hex(b\"any\")),","+            (\"pkg:npm/example-cli@1.0.0?variant=linux-x64\".to_owned(), sha512_hex(b\"linux\")),","+        ],","+    );","+    pkg.tarball_data = b\"\";","+    assert_eq!(","+        signed_subjects(&pkg).await,","+        [(\"pkg:npm/example-cli@1.0.0?variant=linux-x64\".to_owned(), sha512_hex(b\"linux\"))],","+        \"a version without an any archive names only its variants\",","+    );","+}"],"additions":159,"deletions":0,"truncated":false},{"path":"pnpm/crates/publish/src/publish_packed_pkg/variants.rs","lines":["@@ -14,10 +14,12 @@"," "," use super::{PackedPkg, PublishPackedPkgError, Value, clean_version, registry_for_display};"," use crate::{","+    provenance_gen::ProvenanceSubject,","     registry_config_keys::NormalizedRegistryUrl,","     staged_archives::{StagedArchive, staged_length},"," };"," use pnpm_network::ThrottledClient;","+use pnpm_release_record::{Purl, PurlError};"," use std::collections::{HashMap, HashSet};"," "," /// One platform variant's archive, published with its version.","@@ -66,26 +68,13 @@ pub(super) fn check_registry(","     pnpr_registries: &HashSet<String>,","     registry: &NormalizedRegistryUrl,"," ) -> Result<(), PublishPackedPkgError> {","-    let has_variants = !pkg.variants.is_empty() || pkg.any_staged.is_some();","+    let has_variants = pkg.publishes_staged_archives();","     if !has_variants || pnpr_registries.contains(registry.as_str()) {","         return Ok(());","     }","     Err(PublishPackedPkgError::VariantsNeedPnpr { registry: registry_for_display(registry) })"," }"," ","-/// Refuse to sign provenance for a version with variants, or with an `any`","-/// archive staged by another job, which pnpm cannot do yet. It runs before","-/// any archive is staged, and in a dry run too.","-pub(super) fn check_provenance(","-    pkg: &PackedPkg<'_>,","-    provenance: Option<bool>,","-) -> Result<(), PublishPackedPkgError> {","-    if (!pkg.variants.is_empty() || pkg.any_staged.is_some()) && provenance == Some(true) {","-        return Err(PublishPackedPkgError::VariantsWithProvenance);","-    }","-    Ok(())","-}","-"," /// The archives this publish packed, to stage before the document that"," /// references them: the `any` archive, whose integrity is `any_integrity`,"," /// and every packed variant.","@@ -243,6 +232,57 @@ fn staged_attachment(integrity: &str, length: u64) -> Value {","     })"," }"," ","+/// The subjects of the provenance statement of a version with variants:","+/// each archive it publishes, by its PURL (a variant's with the `variant`","+/// qualifier) and its `.tgz` SHA-512. An `any` archive pnpr generates for a","+/// version without one is no subject.","+pub(super) fn provenance_subjects(","+    pkg: &PackedPkg<'_>,","+    (name, version): (&str, &str),","+) -> Result<Vec<ProvenanceSubject>, PublishPackedPkgError> {","+    let purl_error =","+        |error: PurlError| PublishPackedPkgError::Purl { name: name.to_string(), error };","+    let any = match pkg.any_staged {","+        Some(staged) => Some(staged.integrity.clone()),","+        None => pkg.has_any_archive().then(|| sri_sha512(pkg.tarball_data)),","+    };","+    let mut subjects = Vec::with_capacity(pkg.variants.len() + 1);","+    if let Some(integrity) = any {","+        let purl = Purl::npm(name, version).map_err(purl_error)?;","+        subjects.push(subject(&purl, &integrity)?);","+    }","+    for variant in pkg.variants {","+        let purl = Purl::npm_variant(name, version, &variant.tag).map_err(purl_error)?;","+        subjects.push(subject(&purl, &variant.archive.integrity())?);","+    }","+    Ok(subjects)","+}","+","+fn subject(purl: &Purl, integrity: &str) -> Result<ProvenanceSubject, PublishPackedPkgError> {","+    let sha512_hex = sha512_hex(integrity)","+        .ok_or_else(|| PublishPackedPkgError::NoSha512 { integrity: integrity.to_string() })?;","+    Ok(ProvenanceSubject { name: purl.as_str().to_string(), sha512_hex })","+}","+","+/// The lowercase hex SHA-512 an SRI `integrity` carries.","+fn sha512_hex(integrity: &str) -> Option<String> {","+    use base64::Engine as _;","+    use std::fmt::Write as _;","+    let integrity: ssri::Integrity = integrity.parse().ok()?;","+    let hash = integrity.hashes","+        .iter()","+        .find(|hash| hash.algorithm == ssri::Algorithm::Sha512)?;","+    let bytes = base64::engine::general_purpose::STANDARD.decode(&hash.digest).ok()?;","+    Some(","+        bytes","+            .iter()","+            .fold(String::new(), |mut hex, byte| {","+                let _ = write!(hex, \"{byte:02x}\");","+                hex","+            }),","+    )","+}","+"," /// The SRI SHA-512 of `bytes`, the integrity a staged archive is named by."," pub(crate) fn sri_sha512(bytes: &[u8]) -> String {","     ssri::IntegrityOpts::new()"],"additions":54,"deletions":14,"truncated":false},{"path":"pnpm/crates/publish/src/publish_packed_pkg/variants/tests.rs","lines":["@@ -1,6 +1,6 @@"," use super::{","     PackedPkg, PackedVariant, PublishPackedPkgError, StagedLengths, StagedReference,","-    VariantArchive, check_provenance, check_registry, reference_staged_archives, sri_sha512,","+    VariantArchive, check_registry, provenance_subjects, reference_staged_archives, sri_sha512,","     staged_archives,"," };"," use crate::registry_config_keys::parse_supported_registry_url;","@@ -105,19 +105,6 @@ fn variants_are_published_only_to_a_pnpr_registry() {","     check_registry(&pkg(&manifest, b\"any\", &[]), &HashSet::new(), &registry).unwrap();"," }"," ","-#[test]","-fn provenance_is_refused_for_a_version_with_variants() {","-    let manifest = json!({ \"name\": \"example-cli\", \"version\": \"4.0.0\" });","-    let variants = [PackedVariant {","-        tag: \"win32-x64\".into(),","-        archive: VariantArchive::Packed(b\"win\".to_vec()),","-    }];","-    let refused = check_provenance(&pkg(&manifest, b\"any\", &variants), Some(true));","-    assert!(matches!(refused, Err(PublishPackedPkgError::VariantsWithProvenance)));","-    check_provenance(&pkg(&manifest, b\"any\", &variants), None).unwrap();","-    check_provenance(&pkg(&manifest, b\"any\", &[]), Some(true)).unwrap();","-}","-"," /// The document keys a version without build metadata, as npm does, so a"," /// version published without an `any` archive loses its `dist` whatever"," /// build metadata its manifest's version carries.","@@ -167,3 +154,46 @@ fn archives_another_machine_staged_are_referenced_by_their_integrity() {","     );","     assert!(staged_archives(&pkg, \"sha512-any\").is_empty(), \"nothing to upload\");"," }","+","+#[test]","+fn a_provenance_statement_names_every_archive_by_its_purl() {","+    use sha2::Digest as _;","+    use std::fmt::Write as _;","+","+    let hex = |bytes: &[u8]| {","+        sha2::Sha512::digest(bytes)","+            .iter()","+            .fold(String::new(), |mut hex, byte| {","+                let _ = write!(hex, \"{byte:02x}\");","+                hex","+            })","+    };","+    let manifest = json!({ \"name\": \"@example/cli\", \"version\": \"4.0.0\" });","+    let staged = StagedReference { integrity: sri_sha512(b\"staged\"), label: \"x\".into() };","+    let variants = [","+        PackedVariant {","+            tag: \"linux-x64+linux-x64-musl\".into(),","+            archive: VariantArchive::Packed(b\"linux\".to_vec()),","+        },","+        PackedVariant { tag: \"win32-x64\".into(), archive: VariantArchive::Staged(staged) },","+    ];","+    let with_any = pkg(&manifest, b\"any\", &variants);","+    let subjects: Vec<(String, String)> = provenance_subjects(&with_any, (\"@example/cli\", \"4.0.0\"))","+        .unwrap()","+        .into_iter()","+        .map(|subject| (subject.name, subject.sha512_hex))","+        .collect();","+    assert_eq!(","+        subjects,","+        [","+            (\"pkg:npm/%40example/cli@4.0.0\".to_string(), hex(b\"any\")),","+            (","+                \"pkg:npm/%40example/cli@4.0.0?variant=linux-x64%2Blinux-x64-musl\".to_string(),","+                hex(b\"linux\"),","+            ),","+            (\"pkg:npm/%40example/cli@4.0.0?variant=win32-x64\".to_string(), hex(b\"staged\")),","+        ],","+    );","+    let without_any = pkg(&manifest, b\"\", &variants);","+    assert_eq!(provenance_subjects(&without_any, (\"@example/cli\", \"4.0.0\")).unwrap().len(), 2);","+}"],"additions":44,"deletions":14,"truncated":false},{"path":"pnpm/docs/cli/publish.md","lines":["@@ -248,6 +248,8 @@ Under trusted publishing, pnpm attaches provenance to a public package from a pu"," Use `--no-provenance` (or `--provenance=false`) to publish without it, for example from a self-hosted runner."," Use [`provenance`](#provenance) to set a default."," ","+For a package with [`publishConfig.variants`](../package_json.md#publishconfigvariants), one statement names every archive the publish supplies: the archive that targets `any` and each platform variant, including those other jobs uploaded with `--upload-variant`. A version without an `any` archive gets one that the registry generates for npm clients, and the statement does not name it. `--upload-variant` itself does not sign provenance.","+"," ### --filter &lt;package_selector\\>"," "," [Read more about filtering.](../filtering.md)",""],"additions":2,"deletions":0,"truncated":false}],"additions":403,"deletions":69,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-04T16:05:07.402506+00:00"}