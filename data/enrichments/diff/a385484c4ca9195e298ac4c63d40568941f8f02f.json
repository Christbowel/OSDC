{"id":"a385484c4ca9195e298ac4c63d40568941f8f02f","axis":"silent","repo":"pnpm/pnpm","sha":"a385484c4ca9195e298ac4c63d40568941f8f02f","parsed":{"files":[{"path":".changeset/pnpm-publish-variant-provenance.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`pnpm publish --provenance` signs one statement that names every archive of a version with `publishConfig.variants`. A platform variant's archive is named by the version's package URL with a `variant` qualifier."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -6189,6 +6189,7 @@ dependencies = [","  \"pnpm-pack\",","  \"pnpm-package-manifest\",","  \"pnpm-package-name\",","+ \"pnpm-release-record\",","  \"pnpm-reporter\",","  \"pnpm-tarball\",","  \"pnpm-wasm-host\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/publish/options.rs","lines":["@@ -16,6 +16,15 @@ impl PublishArgs {","         if stage {","             self.publish_options(config, None, stage).validate()?;","         }","+        if self.flags.variants.no_variants","+            && !self.flags.variants.variant_integrity.is_empty()","+        {","+            return Err(miette::miette!(","+                code = \"ERR_PNPM_INVALID_VARIANT_FLAGS\",","+                help = \"--no-variants publishes only the archive packed here that targets any; --variant-integrity publishes the archives other jobs uploaded. Pass one of them.\",","+                \"--no-variants and --variant-integrity cannot be used together\",","+            ));","+        }","         if self.flags.batch && !recursive {","             return Err(miette::miette!(","                 code = \"ERR_PNPM_BATCH_PUBLISH_REQUIRES_RECURSIVE\","],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/publish_variants.rs","lines":["@@ -220,3 +220,23 @@ fn uploads_a_variant_and_a_final_publish_references_it() {","     assert!(stderr.contains(\"gives no archive for linux-x64