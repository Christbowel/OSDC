t := workloadMetadataBenchmarkInput{","+\t\tkeys:       make([]string, entries),","+\t\tnamespaces: make([]string, entries),","+\t\tpods:       make([]string, entries),","+\t\tuids:       make([]string, entries),","+\t\tworkloads:  make([]string, entries),","+\t}","+\tfor i := range entries {","+\t\tinput.keys[i] = fmt.Sprintf(\"10.%d.%d.%d\", (i/62500)%250, (i/250)%250, i%250+1)","+\t\tinput.namespaces[i] = fmt.Sprintf(\"namespace-%03d\", i%100)","+\t\tinput.pods[i] = fmt.Sprintf(\"checkout-%06d-7c9f55d4b9-abcde\", i)","+\t\tinput.uids[i] = fmt.Sprintf(\"00000000-0000-4000-8000-%012d\", i)","+\t\tinput.workloads[i] = fmt.Sprintf(\"checkout-%06d\", i)","+\t}","+\treturn input","+}","+","+var (","+\tmetadataWithoutWorkloadSink map[string]k8sMetadataWithoutWorkload","+\tmetadataWithWorkloadSink    map[string]K8sMetadata","+)","+","+func BenchmarkK8sMetadataHeap(b *testing.B) {","+\tinput := newWorkloadMetadataBenchmarkInput(workloadMetadataBenchmarkEntries)","+","+\tb.Run(\"without-workload\", func(b *testing.B) {","+\t\tvar heapBytes uint64","+\t\titerations := 0","+\t\tb.ReportAllocs()","+","+\t\tfor b.Loop() {","+\t\t\tb.StopTimer()","+\t\t\tmetadataWithoutWorkloadSink = nil","+\t\t\tmetadataWithWorkloadSink = nil","+\t\t\tdebug.FreeOSMemory()","+\t\t\tvar before, after runtime.MemStats","+\t\t\truntime.ReadMemStats(&before)","+\t\t\tb.StartTimer()","+","+\t\t\tmetadata := make(map[string]k8sMetadataWithoutWorkload, len(input.keys))","+\t\t\tfor i := range input.keys {","+\t\t\t\tmetadata[input.keys[i]] = k8sMetadataWithoutWorkload{","+\t\t\t\t\tNamespace: input.namespaces[i],","+\t\t\t\t\tPodName:   input.pods[i],","+\t\t\t\t\tPodUID:    input.uids[i],","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tb.StopTimer()","+\t\t\tmetadataWithoutWorkloadSink = metadata","+\t\t\truntime.ReadMemStats(&after)","+\t\t\theapBytes += after.HeapAlloc - before.HeapAlloc","+\t\t\titerations++","+\t\t\tb.StartTimer()","+\t\t}","+","+\t\tb.StopTimer()","+\t\tb.ReportMetric(float64(heapBytes)/fl