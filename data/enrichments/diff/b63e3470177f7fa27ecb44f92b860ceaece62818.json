{"id":"b63e3470177f7fa27ecb44f92b860ceaece62818","axis":"silent","repo":"pnpm/pnpm","sha":"b63e3470177f7fa27ecb44f92b860ceaece62818","parsed":{"files":[{"path":".changeset/optional-peer-also-a-dependency-after-lockfile.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+When an existing lockfile records a package's optional peer as a regular dependency, and a newly added dependency now provides that peer, pnpm records it as a peer [#16901](https://github.com/pnpm/pnpm/issues/16901). The lockfile is the same as installing everything at once."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install/peers.rs","lines":["@@ -978,6 +978,78 @@ fn optional_peer_also_in_deps_is_kept_when_a_hoisted_parent_owns_its_children()","         .assert()","         .success();"," ","+    assert_has_optional_peer_also_in_deps_takes_bravo_dep_as_peer(&workspace);","+","+    drop((root, mock_instance));","+}","+","+/// The graph of","+/// [`optional_peer_also_in_deps_is_kept_when_a_hoisted_parent_owns_its_children`],","+/// installed in two steps. The first lockfile records","+/// `@pnpm.e2e/bravo-dep` as a dependency of","+/// `@pnpm.e2e/has-optional-peer-also-in-deps`, and the second install","+/// must reach the same lockfile as the one-step install.","+/// Covers <https://github.com/pnpm/pnpm/issues/16901>.","+#[test]","+fn optional_peer_also_in_deps_is_resplit_when_a_hoisted_parent_owns_locked_children() {","+    assert_two_step_install_takes_bravo_dep_as_peer(","+        \"@pnpm.e2e/has-optional-peer-also-in-deps-grandparent\",","+        \"@pnpm.e2e/peers-of-has-optional-peer-also-in-deps-parent\",","+    );","+}","+","+/// `@pnpm.e2e/has-optional-peer-also-in-deps` is reached at the same depth","+/// through `…-a` and `…-b`. Only `…-b` provides `@pnpm.e2e/bravo-dep`","+/// already, and `…-a` sorts first, so its path decides the split.","+#[test]","+fn optional_peer_also_in_deps_is_resplit_by_its_deciding_path_among_equal_depths() {","+    assert_two_step_install_takes_bravo_dep_as_peer(","+        \"@pnpm.e2e/split-tie-root\",","+        \"@pnpm.e2e/peers-of-split-tie-parent\",","+    );","+}","+","+/// Installs `first`, then adds `added`, and checks that the lockfile","+/// gives `@pnpm.e2e/has-optional-peer-also-in-deps` `@pnpm.e2e/bravo-dep`","+/// as a peer, as installing both at once does.","+fn assert_two_step_install_takes_bravo_dep_as_peer(first: &str, added: &str) {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    let manifest_path = workspace.join(\"package.json\");","+    fs::write(","+        &manifest_path,","+        serde_json::json!({ \"dependencies\": { first: \"1.0.0\" } }).to_string(),","+    )","+    .expect(\"write package.json\");","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    fs::write(","+        &manifest_path,","+        serde_json::json!({ \"dependencies\": { first: \"1.0.0\", added: \"1.0.0\" } }).to_string(),","+    )","+    .expect(\"rewrite package.json\");","+    bump_mtime(&manifest_path);","+    new_pacquet_command(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    assert_has_optional_peer_also_in_deps_takes_bravo_dep_as_peer(&workspace);","+","+    drop((root, mock_instance));","+}","+","+fn assert_has_optional_peer_also_in_deps_takes_bravo_dep_as_peer(workspace: &std::path::Path) {","     let lockfile = read_lockfile(&workspace.join(\"pnpm-lock.yaml\"));","     let snapshots: Vec<_> = lockfile.snapshots","         .iter()","@@ -1000,8 +1072,6 @@ fn optional_peer_also_in_deps_is_kept_when_a_hoisted_parent_owns_its_children()","             vec![\"@pnpm.e2e/bravo-dep 1.0.0\".to_string()],","         )],","     );","-","-    drop((root, mock_instance));"," }"," "," /// Older pnpm versions resolved the optional peer of"],"additions":72,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/reuse.rs","lines":["@@ -12,6 +12,8 @@ pub(super) use direct_versions::{","     higher_direct_dep_version, node_depends_on_changed_direct_dep, record_direct_dep_versions,"," };"," ","+pub(super) use snapshot_children::pinned_specifier;","+"," mod snapshot_children;"," use snapshot_children::{ReusedChildren, reused_children, snapshot_child_refs};"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/reuse/snapshot_children.rs","lines":["@@ -108,7 +108,7 @@ where"," /// aliased child (an `npm:` alias, often written by an override) names its"," /// real package, so a child that falls through to a fresh resolve fetches"," /// that package rather than a same-numbered version of `alias`.","-pub(super) fn pinned_specifier(alias: &str, key: &PkgNameVerPeer) -> String {","+pub(in super::super) fn pinned_specifier(alias: &str, key: &PkgNameVerPeer) -> String {","     let version = key.suffix.without_peer();","     if key.name.to_string() == alias {","         return version.to_string();","@@ -156,6 +156,7 @@ pub(super) fn record_reused_children(","             prior_key: Some(context.key.clone()),","             update_active: !matches!(ctx.update_reuse_scope(), UpdateReuseScope::All),","             children_scope: Arc::clone(context.ancestry.parent_pkg_aliases),","+            changes_locked_split: false,","         },","     );","     (recording.children(realized), recording)"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/walk.rs","lines":["@@ -35,6 +35,9 @@ use child_seeds::{"," mod level_walk;"," use level_walk::{assign_level_owners, pkgs_info_from_ids, seeded_dep, settle_level, settle_seeds};"," ","+mod locked_split;","+use locke