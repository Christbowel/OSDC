:["@@ -1,11 +1,11 @@"," use super::{","     Arc, BTreeMap, ChildSpec, ChildrenOwnerClaim, ChildrenRecording, DirectDep, FrontierNode,","     HashMap, HashSet, NodeId, NodeSeed, ParentPkgAliases, PendingNode, PreferredVersionsOverlay,","-    RecordedChildrenContext, ResolveDependencyTreeError, SeededNode,","+    RecordedChildrenContext, ResolveDependencyTreeError, Resolver, SeededNode,","     SkippedOptionalDependencyParent, TreeChildren, TreeCtx, catalogs_for_children,","     claim_children_owner, extract_peer_dependencies, insert_tree_node, is_current_children_owner,","-    lock_recoverable, make_non_owner_nodes_lazy, record_children, recorded_children_match,","-    register_peer_dep_names,","+    lock_recoverable, make_non_owner_nodes_lazy, mark_changed_locked_splits, record_children,","+    recorded_children_match, register_peer_dep_names,"," };"," "," /// Settle children ownership across every occurrence one level seeded.","@@ -142,10 +142,14 @@ pub(super) fn settle_seeds("," "," /// Record what each occurrence of a seeded level resolved for its"," /// children, and settle that level's own seeds into the next frontier.","-pub(super) fn settle_level(","+pub(super) async fn settle_level<Chain>(","     ctx: &TreeCtx,","+    resolver: &Chain,","     mut seeded: Vec<SeededNode>,","-) -> Result<Vec<FrontierNode>, ResolveDependencyTreeError> {","+) -> Result<Vec<FrontierNode>, ResolveDependencyTreeError>","+where","+    Chain: Resolver + ?Sized,","+{","     assign_level_owners(ctx, seeded.iter_mut().flat_map(|node| node.seeds.iter_mut()))?;","     let mut frontier = Vec::new();","     for node in seeded {","@@ -158,7 +162,7 @@ pub(super) fn settle_level(","                     ..","                 },","             child_specs,","-            seeds,","+            mut seeds,","             grandchild_overlay,","             grandchild_pkg_aliases,","         } = node;","@@ -176,6 +180,7 @@ pub(super) fn settle_level(","         {","             make_non_owner_nodes_lazy(ctx, &pending.identity.id, &pending.identity.node_id);","         }","+        mark_changed_locked_splits(ctx, resolver, &mut seeds, &grandchild_pkg_aliases).await;","         frontier.extend(settle_seeds(","             ctx,","             seeds,","@@ -256,6 +261,7 @@ pub(super) fn children_context("," ) -> RecordedChildrenContext {","     RecordedChildrenContext {","         children_scope: Arc::clone(children_pkg_aliases),","+        changes_locked_split: claim.changes_locked_split,","         peer_shadowed: Arc::clone(&claim.peer_shadowed),","         prior_key: pending.prior_key","             .clone()"],"additions":12,"deletions":6,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/walk/locked_split.rs","lines":["@@ -0,0 +1,349 @@","+use super::{","+    AncestorPkgIds, Arc, HashMap, HashSet, NodeSeed, ParentPkgAliases, PendingNode, Pipe,","+    PkgNameVerPeer, Resolver, TreeCtx, WantedDependency, WantedKey, dependencies_named_as_peers,","+    future, is_update_target, lock_recoverable, peer_shadowed_dependencies, pinned_children_scope,","+    pinned_specifier, project_relative_cache_scope, resolve_wanted_cached,","+};","+","+/// Marks each children owner in `seeds` that would read children the","+/// prior lockfile pinned, when resolving them under","+/// `children_pkg_aliases` would split some package's dependencies and","+/// peers differently than the lockfile recorded. A marked owner resolves","+/// its children instead (see `RecordedChildrenContext::pins_children_over`).","+///","+/// Which of a package's dependencies its own peers shadow depends on the","+/// scope it resolves in, and the lockfile does not record the overlap: an","+/// entry that kept a dependency omits the same-named peer. So the","+/// package's metadata is read, but only for a package with a locked","+/// dependency or peer whose presence in scope differs from the scope the","+/// pins were recorded under.","+pub(super) async fn mark_changed_locked_splits<Chain>(","+    ctx: &TreeCtx,","+    resolver: &Chain,","+    seeds: &mut [NodeSeed],","+    children_pkg_aliases: &Arc<ParentPkgAliases>,","+) where","+    Chain: Resolver + ?Sized,","+{","+    seeds","+        .iter_mut()","+        .filter_map(|seed| match seed {","+            NodeSeed::Pending(pending) => Some(pending),","+            NodeSeed::Done(_) => None,","+        })","+        .filter_map(|pending| {","+            let pinned = pinned_scope_read_by(ctx, pending)?;","+            Some((pending, Scopes { current: Arc::clone(children_pkg_aliases), pinned }))","+        })","+        .map(|(pending, scopes)| async move {","+            let changes = locked_split_changes(ctx, resolver, &pending.identity.id, scopes).await;","+            if let Some(claim) = pending.claim.as_mut() {","+                claim.changes_locked_split = changes;","+            }","+        })","+        .pipe(future::join_all)","+        .await;","+}","+","+/// The scope a package's pinned children were recorded under, when","+/// `pending` owns them and would otherwise read the pins.","+fn pinned_scope_read_by(ctx: &TreeCtx, pending: &PendingNode) -> Option<Arc<ParentPkgAliases>> {","+    let reads_pins = pending.claim.as_ref().is_some_and(|claim| claim.owns_children)","+        && pending.prior_key.is_none()","+        && matches!(ctx.update_reuse_scope(), super::super::UpdateReuseScope::All);","+    if !reads_pins {","+        return None;","+    }","+    pinned_children_scope(ctx, &pending.identity.id)","+}","+","+/// The scope one level of the pinned subtree resolves in now, and the one","+/// it was recorded under. Every level below adds the same aliases to both.","+#[derive(Clone)]","+struct Scopes {","+    current: Arc<ParentPkgAliases>,","+    pinned: Arc<ParentPkgAliases>,","+}","+","+impl Scopes {","+    fn extend(&self, aliases: &HashSet<String>) -> Self {","+        Scopes {","+            current: self.current.extend(aliases.clone()),","+            pinned: self.pinned.extend(aliases.clone()),","+        }","+    }","+","+    fn differ_on(&self, name: &str) -> bool {","+        self.current.contains(name) != self.pinned.contains(name)","+    }","+}","+","+/// Whether any package in the recorded subtree of `pkg_id` would split","+/// its dependencies and peers differently when `pkg_id`'s children","+/// resolve under `scopes.current`.","+///","+/// A fresh walk lets a package's shallowest occurrence decide its split,","+/// so the subtree is walked level by level and a package is checked at","+/// every occurrence on the first level that reaches it. Its children are","+/// expanded once, from the occurrence the ownership rule picks among those:","+/// the smallest parent path. That keeps the walk linear in the subtree's","+/// edges.","+async fn locked_split_changes<Chain>(","+    ctx: &TreeCtx,","+    resolver: &Chain,","+    pkg_id: &Arc<str>,","+    scopes: Scopes,","+) -> bool","+where","+    Chain: Resolver + ?Sized,","+{","+    let mut first_level: HashMap<Arc<str>, usize> = HashMap::default();","+    let mut parents = vec![Occurrence {","+        pkg_id: Arc::clone(pkg_id),","+        children_scopes: scopes,","+        parent_path: AncestorPkgIds::default(),","+    }];","+    let mut level = 0;","+    while !parents.is_empty() {","+        level += 1;","+        let (checks, next) = next_level(ctx, parents, &mut first_level, level);","+        let changed = checks","+            .iter()","+            .map(|(child_id, scopes)| split_changes(ctx, resolver, child_id, scopes))","+            .pipe(future::join_all)","+            .await;","+        if changed.into_iter().any(|changes| changes) {","+            return true;","+        }","+        parents = next;","+    }","+    false","+}","+","+/// A package reached in the pinned subtree, with the scopes its children","+/// resolve in and its ancestors below the subtree's root.","+struct Occurrence {","+    pkg_id: Arc<str>,","+    children_scopes: Scopes,","+    parent_path: AncestorPkgIds,","+}","+","+/// The checks on `level`, one per occurrence of a child of `parents`, and","+/// the occurrences whose children make up the next level.","+fn next_level(","+    ctx: &TreeCtx,","+    parents: Vec<Occurrence>,","+    first_level: &mut HashMap<Arc<str>, usize>,","+    level: usize,","+) -> (Vec<(Arc<str>, Scopes)>, Vec<Occurrence>) {","+    let mut checks = Vec::new();","+    let mut owners: HashMap<Arc<str>, Occurrence> = HashMap::default();","+    for parent in parents {","+        let Some(edges) = recorded_edges(ctx, &parent.pkg_id) else { continue };","+        let children_path: AncestorPkgIds = Arc::new(","+            parent.parent_path","+                .iter()","+                .cloned()","+                .chain([Arc::clone(&parent.pkg_id)])","+                .collect(),","+        );","+        let grandchildren_scopes = parent.children_scopes.extend(","+            &edges","+                .iter()","+                .map(|edge| edge.alias.clone())","+                .collect(),","+        );","+        for edge in edges.iter() {","+            if *first_level","+                .entry(Arc::clone(&edge.pkg_id))","+                .or_insert(level)","+                != level","+            {","+                continue;","+            }","+            checks.push((Arc::clone(&edge.pkg_id), parent.children_scopes.clone()));","+            keep_owner(","+                &mut owners,","+                Occurrence {","+                    pkg_id: Arc::clone(&edge.pkg_id),","+                    children_scopes: grandchildren_scopes.clone(),","+                    parent_path: Arc::clone(&children_path),","+                },","+            );","+        }","+    }","+    (checks, owners.into_values().collect())","+}","+","+/// Keeps, per package, the occurrence with the smallest parent path: the one","+/// a fresh walk lets own the package's children among equal depths.","+fn keep_owner(owners: &mut HashMap<Arc<str>, Occurrence>, candidate: Occurrence) {","+    match owners.entry(Arc::clone(&candidate.pkg_id)) {","+        std::collections::hash_map::Entry::Vacant(entry) => {","+            entry.insert(candidate);","+        }","+        std::collections::hash_map::Entry::Occupied(mut entry) => {","+            if candidate.parent_path < entry.get().parent_path {","+                entry.insert(candidate);","+            }","+        }","+    }","+}","+","+fn recorded_edges(","+    ctx: &TreeCtx,","+    pkg_id: &str,","+) -> Option<Arc<Vec<crate::resolved_tree::ChildEdge>>> {","+    lock_recoverable(&ctx.workspace.children.by_id)","+        .get(pkg_id)","+        .map(|recorded| Arc::clone(&recorded.edges))","+}","+","+/// Whether the package `pkg_id`, resolved under `scopes.current`, would","+/// split its dependencies and peers differently than its recorded","+/// children and peers do.","+async fn split_changes<Chain>(","+    ctx: &TreeCtx,","+    resolver: &Chain,","+    pkg_id: &str,","+    scopes: &Scopes,","+) -> bool","+where","+    Chain: Resolver + ?Sized,","+{","+    let Some(locked) = LockedSplit::of(ctx, pkg_id) else { return false };","+    if !locked.may_change(scopes) {","+        return false;","+    }","+    let Some(manifest) = registry_manifest(ctx, resolver, &locked).await else {","+        return false;","+    };","+    let shadowed = peer_shadowed_dependencies(","+        Some(&manifest),","+        &scopes.current,","+        ctx.workspace.policy.auto_install_peers,","+    );","+    dependencies_named_as_peers(Some(&manifest))","+        .any(|(dep, _)| locked.deps.contains(dep) == shadowed.contains(dep))","+}","+","+/// A registry package's dependencies and peers as the prior lockfile","+/// split them.","+struct LockedSplit {","+    name: String,","+    /// The specifier that resolves exactly the locked version, from the","+    /// registry it was locked from.","+    specifier: String,","+    deps: HashSet<String>,","+    /// The peers whose shadowing depends on the scope: optional ones, and","+    /// every one when peers are not auto-installed.","+    scope_dependent_peers: Vec<String>,","+}","+","+impl LockedSplit {","+    fn of(ctx: &TreeCtx, pkg_id: &str) -> Option<Self> {","+        let auto_install_peers = ctx.workspace.policy.auto_install_peers;","+        let packages = lock_recoverable(&ctx.workspace.tree.packages);","+        let pkg = packages.get(pkg_id)?;","+        let (name, specifier) = locked_specifier(pkg.result())?;","+        Some(LockedSplit {","+            name,","+            specifier,","+            deps: recorded_edges(ctx, pkg_id)","+                .map(|edges| {","+                    edges","+                        .iter()","+                        .map(|edge| edge.alias.clone())","+                        .collect()","+                })","+                .unwrap_or_default(),","+            scope_dependent_peers: pkg.peer_dependencies","+                .iter()","+                .filter(|(_, peer)| peer.optional || !auto_install_peers)","+                .map(|(peer_name, _)| peer_name.clone())","+                .collect(),","+        })","+    }","+","+    /// Whether a name the split depends on is in only one of the scopes.","+    fn may_change(&self, scopes: &Scopes) -> bool {","+        self.deps","+            .iter()","+            .any(|dep| scopes.differ_on(dep))","+            || self.scope_dependent_peers","+                .iter()","+                .any(|peer| scopes.differ_on(peer))","+    }","+}","+","+/// The name and exact specifier of a registry package. `None` for any other","+/// source, whose split the walk never re-reads.","+fn locked_specifier(","+    result: &pnpm_resolving_resolver_base::ResolveResult,","+) -> Option<(String, String)> {","+    match result.resolved_via.as_str() {","+        \"npm-registry\" => {","+            let name_ver = result.package.name_ver.as_ref()?;","+            Some((name_ver.name.to_string(), name_ver.suffix.to_string()))","+        }","+        \"named-registry\" => {","+            let key = result.id","+                .as_str()","+                .parse::<PkgNameVerPeer>()","+                .ok()?;","+            let name = key.name.to_string();","+            let specifier = pinned_specifier(&name, &key);","+            Some((name, specifier))","+        }","+        _ => None,","+    }","+}","+","+/// The manifest of the locked package as a fresh resolve reads it, read-package","+/// hooks applied. `None` when it cannot be resolved; the pins then stand.","+async fn registry_manifest<Chain>(","+    ctx: &TreeCtx,","+    resolver: &Chain,","+    locked: &LockedSplit,","+) -> Option<Arc<serde_json::Value>>","+where","+    Chain: Resolver + ?Sized,","+{","+    let wanted = WantedDependency {","+        alias: Some(locked.name.clone()),","+        bare_specifier: Some(locked.specifier.clone()),","+        ..WantedDependency::default()","+    };","+    let depth = 1;","+    let opts = ctx.opts_for_depth(depth);","+    let cache_key = WantedKey::new((","+        wanted.alias.clone(),","+        wanted.bare_specifier.clone(),","+        wanted.optional,","+        wanted.injected,","+        opts.version.pick_lowest_version,","+        (opts.policy.published_by, opts.policy.fallback_published_by),","+        project_relative_cache_scope(&wanted, opts),","+        None,","+        Vec::new(),","+        ctx.update_cache_scope(),","+        is_update_target(ctx.update_scope(), &wanted, None, depth),","+        opts.refresh.prefer_current_version,","+    ));","+    match resolve_wanted_cached(ctx, resolver, &wanted, opts, None, cache_key).await {","+        Ok(result) => result.package.manifest.clone(),","+        Err(error) => {","+            tracing::debug!(","+                target: \"pacquet::resolve\",","+                package = %locked.name,","+                specifier = %locked.specifier,","+                %error,","+                \"kept the lockfile's dependency and peer split: its metadata could not be read\",","+            );","+            None","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":349,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/walk/locked_split/tests.rs","lines":["@@ -0,0 +1,63 @@","+use super::{","+    super::{","+        HashMap, HashSet, ParentPkgAliases, RecordedChildrenContext, TreeCtx, claim_children_owner,","+        record_children,","+    },","+    Occurrence, Scopes, next_level,","+};","+use crate::resolve_dependency_tree::workspace_ctx::WorkspaceTreeCtx;","+use pnpm_resolving_resolver_base::ResolveOptions;","+use std::sync::Arc;","+","+fn record(ctx: &TreeCtx, pkg_id: &str, children: &[(&str, &str)]) {","+    let pkg_id: Arc<str> = Arc::from(pkg_id);","+    let claim = claim_children_owner(ctx, &pkg_id, 0, &Arc::default(), HashSet::default());","+    let edges = children","+        .iter()","+        .map(|(alias, child_id)| crate::resolved_tree::ChildEdge {","+            alias: (*alias).to_string(),","+            pkg_id: Arc::from(*child_id),","+            optional: false,","+        })","+        .collect();","+    let context = RecordedChildrenContext {","+        peer_shadowed: Arc::default(),","+        prior_key: None,","+        update_active: false,","+        children_scope: ParentPkgAliases::root(HashSet::default()),","+        changes_locked_split: false,","+    };","+    record_children(ctx, &pkg_id, &claim.owner, edges, context);","+}","+","+fn occurrence(pkg_id: &str, alias_in_scope: &str) -> Occurrence {","+    let scope = ParentPkgAliases::root(HashSet::from_iter([alias_in_scope.to_string()]));","+    Occurrence {","+        pkg_id: Arc::from(pkg_id),","+        children_scopes: Scopes { current: Arc::clone(&scope), pinned: scope },","+        parent_path: Arc::new(vec![Arc::from(\"root@1.0.0\")]),","+    }","+}","+","+/// Among occurrences on one level, a fresh walk gives a package's children","+/// to the smallest parent path, whatever order the scan meets them in.","+#[test]","+fn expands_a_shared_package_from_the_occurrence_that_owns_its_children() {","+    let ctx =","+        TreeCtx::with_workspace(Arc::new(WorkspaceTreeCtx::default()), ResolveOptions::default());","+    record(&ctx, \"late@1.0.0\", &[(\"shared\", \"shared@1.0.0\")]);","+    record(&ctx, \"early@1.0.0\", &[(\"shared\", \"shared@1.0.0\")]);","+","+    let (checks, next) = next_level(","+        &ctx,","+        vec![occurrence(\"late@1.0.0\", \"late-only\"), occurrence(\"early@1.0.0\", \"early-only\")],","+        &mut HashMap::default(),","+        1,","+    );","+","+    assert_eq!(checks.len(), 2, \"every occurrence on the level is checked\");","+    let [shared] = next.as_slice() else { panic!(\"one expansion per package\") };","+    assert_eq!(shared.parent_path.last().map(|id| &**id), Some(\"early@1.0.0\"));","+    assert!(shared.children_scopes.current.contains(\"early-only\"));","+    assert!(!shared.children_scopes.current.contains(\"late-only\"));","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/workspace_ctx.rs","lines":["@@ -6,8 +6,9 @@"," pub(super) use children_ownership::{","     ChildrenOwner, ChildrenOwnerClaim, ChildrenRecording, RecordedChildren,","     RecordedChildrenContext, children_warmup_claimed, claim_children_owner, claim_children_warmup,","-    insert_tree_node, is_current_children_owner, make_non_owner_nodes_lazy, record_children,","-    recorded_children_match, register_peer_dep_names, register_shadowable_dep_names,","+    insert_tree_node, is_current_children_owner, make_non_owner_nodes_lazy, pinned_children_scope,","+    record_children, recorded_children_match, register_peer_dep_names,","+    register_shadowable_dep_names,"," };"," "," pub(super) use cache_keys::{"],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve