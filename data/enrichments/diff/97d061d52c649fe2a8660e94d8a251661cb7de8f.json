(shadowing) = find_shadowing_pnpm_on_path(global_bin)","+    {","+        return CheckResult::warn(","+            title,","+            format!(","+                r#\"\"pnpm\" on PATH is {}, not the pnpm in {}\"#,","+                shadowing.executable.display(),","+                global_bin.display(),","+            ),","+            shadowing.warning(global_bin),","+        );","+    }","+    CheckResult::pass(title, \"pnpm\")","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/self_update.rs","lines":["@@ -16,15 +16,19 @@ pub(crate) mod verify_engine;"," pub(crate) use externally_managed::{","     ExternalManager,","     find_external_manager,","+    homebrew_formula,"," };"," "," mod externally_managed;"," mod global_bin;"," mod pinned_project;"," ","-use crate::config_deps::{","-    self,","-    EnginePolicyViolation,","+use crate::{","+    cli_args::shadowing_pnpm::find_shadowing_pnpm_on_path,","+    config_deps::{","+        self,","+        EnginePolicyViolation,","+    },"," };"," use clap::Args;"," use derive_more::{","@@ -474,6 +478,7 @@ async fn switch_global_pnpm<Reporter: self::Reporter + 'static>(","     {","         warn::<Reporter>(prefix, global_bin::LEGACY_HOME_DIR_WARNING);","     }","+    warn_if_shadowed::<Reporter>(config.global_bin.as_deref(), prefix);"," ","     if result.already_existed {","         return Ok(Some(format!(","@@ -483,3 +488,11 @@ async fn switch_global_pnpm<Reporter: self::Reporter + 'static>(","     }","     Ok(Some(format!(\"Successfully updated pnpm to v{target_version}\")))"," }","+","+fn warn_if_shadowed<Reporter: self::Reporter>(global_bin: Option<&Path>, prefix: &str) {","+    if let Some(global_bin) = global_bin","+        && let Some(shadowing) = find_shadowing_pnpm_on_path(global_bin)","+    {","+        shadowing.emit_warning::<Reporter>(global_bin, prefix);","+    }","+}"],"additions":16,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/self_update