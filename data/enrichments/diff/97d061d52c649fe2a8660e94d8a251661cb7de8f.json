me_to_env<Reporter: self::Reporter + 'static>(","     force: bool,","     pnpm_home_dir: &Path,","     bin_dir: &Path,","     dir: &Path,","-) -> miette::Result<String> {","+) -> miette::Result<(String, SetupPathEntry)> {","     let env_path_result = path_extender::add_dir_to_env_path(pnpm_home_dir, &env_path_opts(force));","+    let path_entry =","+        SetupPathEntry::after_env_update(&env_path_result, path_extender::persisted_path_dirs);","     let output = render_env_path_outcome(env_path_result, pnpm_home_dir)?;","     gh_actions_env::write_gh_actions_env_files::<Reporter, Host>(dir, pnpm_home_dir, bin_dir);","-    Ok(output)","+    Ok((output, path_entry))"," }"," "," /// The output of a setup whose CLI install succeeded."],"additions":14,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender.rs","lines":["@@ -11,6 +11,7 @@ pub(super) use posix::{","     render_shell_settings,","     sh_quote,"," };","+pub(super) use windows::persisted_path_dirs;"," "," mod posix;"," mod windows;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/windows.rs","lines":["@@ -12,7 +12,10 @@ use super::{","     PathExtenderError,"," };"," use crate::process::Command;","-use std::path::Path;","+use std::path::{","+    Path,","+    PathBuf,","+};"," "," /// The change made to one environment variable, used to render the"," /// before/after report.","@@ -25,28 +28,38 @@ pub(super) struct EnvVariableChange {"," "," const REG_KEY: &str = r\"HKEY_CURRENT_USER\\Environment\";"," ","+const MACHINE_REG_KEY: &str =","+    r\"HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\";","+"," const UTF8_CODEPAGE: u32 = 65001;"," "," pub(super) fn add_dir_to_windows_env_path(","     dir: &Path,","     opts: &AddDirToEnvPathOpts,"," ) -> Result<Vec<EnvVariableChange>, PathExtenderError> {","-    // The UTF-8 code page makes `reg` use UTF-8 for output. Otherwise","-    // non-ASCII characters in environment variables become garbled. The code","-    // page is switched with `mode con cp select=` rather than `chcp`: both","-    // set the same console code page, but `chcp` clears the visible terminal","-    // whenever it changes it.","+    with_utf8_codepage(|| {","+        let report = add_dir_to_windows_env_path_inner(dir, opts)?;","+        refresh_env_vars()?;","+        Ok(report)","+    })","+}","+","+/// Run `body` under the UTF-8 code page, which makes `reg` use UTF-8 for","+/// output. Otherwise non-ASCII characters in environment variables become","+/// garbled. The code page is switched with `mode con cp select=` rather than","+/// `chcp`: both set the same console code page, but `chcp` clears the visible","+/// terminal whenever it changes it.","+fn with_utf8_codepage<Output, Body>(body: Body) -> Result<Output, PathExtenderError>","+where","+    Body: FnOnce() -> Result<Output, PathExtenderError>,","+{","     let codepage_output =","         query_codepage().map_err(|err| PathExtenderError::CodePage { message: err.to_string() })?;","     let cp_bak = first_number(&codepage_output)","         .ok_or_else(|| PathExtenderError::CodePage { message: codepage_output.clone() })?;","     select_codepage(UTF8_CODEPAGE)?;"," ","-    let result = (|| {","-        let report = add_dir_to_windows_env_path_inner(dir, opts)?;","-        refresh_env_vars()?;","-        Ok(report)","-    })();","+    let result = body();"," ","     // Restore the saved code page even when the body failed.","     let _ = select_codepage(cp_bak);","@@ -327,5 +340,102 @@ fn first_number(text: &str) -> Option<u32> {","     digits.parse().ok()"," }"," ","+/// The `Path` directories a new process gets: the machine `Path` followed by","+/// the user `Path`, with `%NAME%` references expanded from the user's","+/// registry values first. `None` when the registry cannot be read.","+pub(in crate::cli_args::setup) fn persisted_path_dirs() -> Option<Vec<PathBuf>> {","+    with_utf8_codepage(|| Ok(read_persisted_path_dirs())).ok().flatten()","+}","+","+fn read_persisted_path_dirs() -> Option<Vec<PathBuf>> {","+    let machine = run_capture(\"reg\", &[\"query\", MACHINE_REG_KEY]).ok()?;","+    let user = get_registry_output().ok()?;","+    persisted_path_from_registry(&machine, &user, |name| std::env::var(name).ok())","+}","+","+/// The saved `Path` directories from the `reg query` output of the machine","+/// and user environment keys. Windows builds a new process's environment","+/// from the machine values, expanded against the process environment, and","+/// then the user values, expanded against everything before them. Only","+/// `REG_EXPAND_SZ` values are expanded. `Path` is the machine value followed","+/// by the user value.","+fn persisted_path_from_registry<ProcessEnv>(","+    machine: &str,","+    user: &str,","+    process_env: ProcessEnv,","+) -> Option<Vec<PathBuf>>","+where","+    ProcessEnv: Fn(&str) -> Option<String>,","+{","+    let scoped = |output: &str, name: &str, outer: &dyn Fn(&str) -> Option<String>| {","+        let entry = get_env_value_with_type_from_registry(output, name)?;","+        Some(if entry.value_type == \"REG_EXPAND_SZ\" {","+            expand_env_references(&entry.data, &outer)","+        } else {","+            entry.data","+        })","+    };","+    let machine_lookup =","+        |name: &str| scoped(machine, name, &process_env).or_else(|| process_env(name));","+    // A `%Path%` in the user `Path` is the machine `Path` it is appended to.","+    let user_lookup = |name: &str| {","+        if name.eq_ignore_ascii_case(\"Path\") {","+            return machine_lookup(name);","+        }","+        scoped(user, name, &machine_lookup).or_else(|| machine_lookup(name))","+    };","+    let mut dirs = split_registry_path(&scoped(machine, \"Path\", &machine_lookup)?);","+    if let Some(user_path) = scoped(user, \"Path\", &user_lookup) {","+        dirs.extend(split_registry_path(&user_path));","+    }","+    Some(dirs)","+}","+","+/// Split an expanded `Path` value into directories the way Windows does: on","+/// `;` outside double quotes, dropping the quotes.","+fn split_registry_path(expanded: &str) -> Vec<PathBuf> {","+    let mut dirs = Vec::new();","+    let mut current = String::new();","+    let mut in_quotes = false;","+    for character in expanded.chars() {","+        match character {","+            '\"' => in_quotes = !in_quotes,","+            ';' if !in_quotes => dirs.push(std::mem::take(&mut current)),","+            _ => current.push(character),","+        }","+    }","+    dirs.push(current);","+    dirs.into_iter()","+        .filter(|dir| !dir.is_empty())","+        .map(PathBuf::from)","+        .collect()","+}","+","+fn expand_env_references<Lookup>(entry: &str, lookup: &Lookup) -> String","+where","+    Lookup: Fn(&str) -> Option<String>,","+{","+    let mut parts = entry.split('%');","+    let mut expanded = parts","+        .next()","+        .unwrap_or_default()","+        .to_string();","+    let rest: Vec<&str> = parts.collect();","+    for pair in rest.chunks(2) {","+        match pair {","+            [name, tail] => {","+                expanded.push_str(&lookup(name).unwrap_or_else(|| format!(\"%{name}%\")));","+                expanded.push_str(tail);","+            }","+            [unclosed] => {","+                expanded.push('%');","+                expanded.push_str(unclosed);","+            }","+            _ => {}","+        }","+    }","+    expanded","+}","+"," #[cfg(test)]"," mod tests;"],"additions":121,"deletions":11,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/windows/tests.rs","lines":["@@ -11,11 +11,16 @@ use super::{","     add_dir_to_windows_env_path_inner,","     first_number,","     get_env_value_from_registry,","+    persisted_path_from_registry,","     run_capture_mode_with,","+    split_registry_path,","     update_env_variable_with,"," };"," use pretty_assertions::assert_eq;","-use std::path::Path;","+use std::path::{","+    Path,","+    PathBuf,","+};"," "," const SAMPLE: &str = \"\\r\\nHKEY_CURRENT_USER\\\\Environment\\r\\n    Path    REG_EXPAND_SZ    C:\\\\Users\\\\me\\\\bin\\r\\n    PNPM_HOME    REG_SZ    C:\\\\pnpm\\r\\n\";"," ","@@ -225,3 +230,94 @@ fn mode_propagates_non_not_found_errors_without_fallback() {","     assert_eq!(calls.len(), 1);","     assert_eq!(calls[0].0, \"mode.com\");"," }","+","+#[test]","+fn persisted_path_expands_only_expandable_values() {","+    let machine = \"\\r\\nHKEY_LOCAL_MACHINE\\\\...\\\\Environment\\r\\n    \\","+                   Path    REG_EXPAND_SZ    %SystemRoot%\\\\system32;;%Missing%\\\\bin;C:\\\\50%\\r\\n\";","+    let user = \"\\r\\nHKEY_CURRENT_USER\\\\Environment\\r\\n    \\","+                Path    REG_SZ    %SystemRoot%\\\\tools;C:\\\\npm\\r\\n\";","+    let process_env = |name: &str| (name == \"SystemRoot\").then(|| r\"C:\\Windows\".to_string());","+","+    let dirs = persisted_path_from_registry(machine, user, process_env).unwrap();","+    assert_eq!(","+        dirs,","+        [","+            PathBuf::from(r\"C:\\Windows\\system32\"),","+            PathBuf::from(r\"%Missing%\\bin\"),","+            PathBuf::from(r\"C:\\50%\"),","+            PathBuf::from(r\"%SystemRoot%\\tools\"),","+            PathBuf::from(r\"C:\\npm\"),","+        ],","+    );","+}","+","+#[test]","+fn split_registry_path_drops_quotes_and_keeps_quoted_separators() {","+    let dirs = split_registry_path(r#\"\"C:\\npm\";C:\\pnpm-home\\bin;\"C:\\a;b\"\"#);","+    assert_eq!(","+        dirs,","+        [PathBuf::from(r\"C:\\npm\"), PathBuf::from(r\"C:\\pnpm-home\\bin\"), PathBuf::from(r\"C:\\a;b\")],","+    );","+}","+","+#[test]","+fn persisted_path_expands_each_scope_with_its_own_variables() {","+    let machine = \"\\r\\nHKEY_LOCAL_MACHINE\\\\...\\\\Environment\\r\\n    \\","+                   Path    REG_EXPAND_SZ    %TOOLS%;C:\\\\Windows\\r\\n    \\","+                   TOOLS    REG_EXPAND_SZ    %SystemDrive%\\\\npm\\r\\n\";","+    let user = \"\\r\\nHKEY_CURRENT_USER\\\\Environment\\r\\n    \\","+                Path    REG_EXPAND_SZ    %TOOLS%;%PNPM_HOME%\\\\bin\\r\\n    \\","+                PNPM_HOME    REG_SZ    C:\\\\pnpm-home\\r\\n    \\","+                TOOLS    REG_SZ    C:\\\\user-tools\\r\\n\";","+    let process_env = |name: &str| (name == \"SystemDrive\").then(|| \"C:\".to_string());","+","+    let dirs = persisted_path_from_registry(machine, user, process_env).unwrap();","+    assert_eq!(","+        dirs,","+        [","+            PathBuf::from(r\"C:\\npm\"),","+            PathBuf::from(r\"C:\\Windows\"),","+            PathBuf::from(r\"C:\\user-tools\"),","+            PathBuf::from(r\"C:\\pnpm-home\\bin\"),","+        ],","+    );","+}","+","+#[test]","+fn a_user_path_reference_to_path_is_the_machine_path() {","+    let machine = \"\\r\\nHKEY_LOCAL_MACHINE\\\\...\\\\Environment\\r\\n    \\","+                   Path    REG_EXPAND_SZ    C:\\\\Windows\\r\\n\";","+    let user = \"\\r\\nHKEY_CURRENT_USER\\\\Environment\\r\\n    \\","+                Path    REG_EXPAND_SZ    %Path%;C:\\\\pnpm-home\\\\bin\\r\\n\";","+","+    let dirs = persisted_path_from_registry(machine, user, |_: &str| None).unwrap();","+    assert_eq!(","+        dirs,","+        [","+            PathBuf::from(r\"C:\\Windows\"),","+            PathBuf::from(r\"C:\\Windows\"),","+            PathBuf::from(r\"C:\\pnpm-home\\bin\"),","+        ],","+    );","+}","+","+#[test]","+fn a_user_path_resolves_a_machine_variable_in_the_machine_scope() {","+    let machine = \"\\r\\nHKEY_LOCAL_MACHINE\\\\...\\\\Environment\\r\\n    \\","+                   Path    REG_EXPAND_SZ    C:\\\\Windows\\r\\n    \\","+                   TOOLS    REG_EXPAND_SZ    %SystemDrive%\\\\npm\\r\\n\";","+    let user = \"\\r\\nHKEY_CURRENT_USER\\\\Environment\\r\\n    \\","+                Path    REG_EXPAND_SZ    %TOOLS%;C:\\\\pnpm-home\\\\bin\\r\\n\";","+    let process_env = |name: &str| (name == \"SystemDrive\").then(|| \"C:\".to_string());","+","+    let dirs = persisted_path_from_registry(machine, user, process_env).unwrap();","+    assert_eq!(","+        dirs,","+        [","+            PathBuf::from(r\"C:\\Windows\"),","+            PathBuf::from(r\"C:\\npm\"),","+            PathBuf::from(r\"C:\\pnpm-home\\bin\")","+        ],","+    );","+}"],"additions":97,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/shadowing_pnpm.rs","lines":["@@ -0,0 +1,345 @@","+//! The `pnpm` a `PATH` lookup finds when it is not the one in the global bin","+//! directory.","+//!","+//! `self-update` and `setup` install pnpm into the global bin directory. A","+//! `pnpm` that another installer put ahead of that directory on `PATH` (npm,","+//! Homebrew, Corepack, Volta, Scoop) keeps running after either command","+//! reports success, so every version they install looks like it never took.","+//! Both commands, and `doctor`, name that `pnpm` and the command that removes","+//! it.","+","+use super::self_update::homebrew_formula;","+use pnpm_config::{","+    Host,","+    default_pnpm_home_dir,","+};","+use pnpm_reporter::{","+    LogEvent,","+    LogLevel,","+    PnpmLog,","+    Reporter,","+};","+use std::{","+    ffi::{","+        OsStr,","+        OsString,","+    },","+    fs,","+    path::{","+        Path,","+        PathBuf,","+    },","+};","+","+/// Shim scripts (npm's `.cmd` files, Corepack's) name their target inside;","+/// anything larger than this is a real executable, not a script.","+const SHIM_SCRIPT_MAX_SIZE: u64 = 64 * 1024;","+","+/// How a `pnpm` outside the global bin directory got onto `PATH`, as far as","+/// its location and, for a shim script, its contents tell.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub(crate) enum InstallOrigin {","+    /// `npm install -g pnpm`: the executable lives in a `node_modules/pnpm`","+    /// package.","+    NpmGlobal,","+    /// A Homebrew formula (`pnpm`, `pnpm@11`, ...) whose keg holds the","+    /// executable.","+    Homebrew {","+        formula: String,","+    },","+    /// A Corepack shim.","+    Corepack,","+    /// A Volta shim.","+    Volta,","+    /// A Scoop shim.","+    Scoop,","+    Unknown,","+}","+","+impl InstallOrigin {","+    pub(crate) fn detect(executable: &Path) -> Self {","+        let real = fs::canonicalize(executable).unwrap_or_else(|_| executable.to_path_buf());","+        if let Some(formula) = homebrew_formula(&real) {","+            return Self::Homebrew { formula };","+        }","+        origin_from_path(&real)","+            .or_else(|| origin_from_path(executable))","+            .or_else(|| npm_global_package(&real))","+            .or_else(|| origin_from_shim_script(executable))","+            .unwrap_or(Self::Unknown)","+    }","+","+    /// The command that removes that installation, when the origin names one.","+    fn removal_command(&self) -> Option<String> {","+        let command = match self {","+            Self::NpmGlobal => \"npm uninstall -g pnpm\",","+            Self::Homebrew { formula } => return Some(format!(\"brew uninstall {formula}\")),","+            Self::Corepack => \"corepack disable pnpm\",","+            Self::Volta => \"volta uninstall pnpm\",","+            Self::Scoop => \"scoop uninstall pnpm\",","+            Self::Unknown => return None,","+        };","+        Some(command.to_string())","+    }","+","+    fn description(&self) -> &'static str {","+        match self {","+            Self::NpmGlobal => \"installed with npm\",","+            Self::Homebrew { .. } => \"installed with Homebrew\",","+            Self::Corepack => \"a Corepack shim\",","+            Self::Volta => \"installed with Volta\",","+            Self::Scoop => \"installed with Scoop\",","+            Self::Unknown => \"not installed by pnpm\",","+        }","+    }","+}","+","+fn origin_from_path(path: &Path) -> Option<InstallOrigin> {","+    let components: Vec<String> = path","+        .components()","+        .map(|component| {","+            component","+                .as_os_str()","+                .to_string_lossy()","+                .to_ascii_lowercase()","+        })","+        .collect();","+    let has = |name: &str| {","+        components","+            .iter()","+            .any(|component| component == name)","+    };","+    if has(\"corepack\") {","+        return Some(InstallOrigin::Corepack);","+    }","+    if has(\".volta\") {","+        return Some(InstallOrigin::Volta);","+    }","+    if has(\"scoop\") {","+        return Some(InstallOrigin::Scoop);","+    }","+    None","+}","+","+/// `NpmGlobal` when `path` lies in a `node_modules/pnpm` package outside","+/// any project. A project's own `node_modules`, which `node_modules/.bin`","+/// puts on `PATH` in scripts, sits next to a `package.json`; npm's global","+/// prefixes (`lib/` on POSIX, `%APPDATA%\\npm` on Windows) do not. A","+/// package in a pnpm virtual store (`.pnpm`) was installed by pnpm, not npm.","+fn npm_global_package(path: &Path) -> Option<InstallOrigin> {","+    if path","+        .components()","+        .any(|component| component.as_os_str() == \".pnpm\")","+    {","+        return None;","+    }","+    let node_modules = path","+        .ancestors()","+        .filter(|dir| dir.file_name() == Some(OsStr::new(\"pnpm\")))","+        .filter_map(Path::parent)","+        .find(|dir| dir.file_name() == Some(OsStr::new(\"node_modules\")))?;","+    let prefix = node_modules.parent()?;","+    (!prefix.join(\"package.json\").exists()).then_some(InstallOrigin::NpmGlobal)","+}","+","+fn origin_from_shim_script(executable: &Path) -> Option<InstallOrigin> {","+    let size = fs::metadata(executable).ok()?.len();","+    if size > SHIM_SCRIPT_MAX_SIZE {","+        return None;","+    }","+    let script = fs::read_to_string(executable).ok()?;","+    if script.contains(\"corepack\") {","+        return Some(InstallOrigin::Corepack);","+    }","+    let in_project_bin = executable","+        .parent()","+        .is_some_and(|dir| dir.ends_with(Path::new(\"node_modules\").join(\".bin\")));","+    if !in_project_bin","+        && (script.contains(\"node_modules/pnpm/\") || script.contains(r\"node_modules\\pnpm\\\"))","+    {","+        return Some(InstallOrigin::NpmGlobal);","+    }","+    None","+}","+","+/// What `pnpm setup` does to the user's `PATH`.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub(crate) enum SetupPathEntry {","+    /// Writes a shell configuration block that puts the global bin directory","+    /// first on `PATH` in every new shell, wherever it was before.","+    PrependedInShellConfig,","+    /// Adds the global bin directory to the Windows user `Path`. Windows","+    /// appends that after the machine `Path`, and leaves an existing entry","+    /// where it is, so `persisted_path` (machine then user `Path`, as saved)","+    /// decides which `pnpm` a new process finds. `None` when the registry","+    /// could not be read.","+    AddedToUserPath { persisted_path: Option<Vec<PathBuf>> },","+    /// Prints the settings for the user to add, under `--no-modify-path` or","+    /// when the shell configuration cannot be written.","+    LeftAlone,","+}","+","+impl SetupPathEntry {","+    /// What a `pnpm setup` that tried to update the environment did to it.","+    pub(crate) fn after_env_update<Report, Error, ReadPersistedPath>(","+        result: &Result<Report, Error>,","+        read_persisted_path: ReadPersistedPath,","+    ) -> Self","+    where","+        ReadPersistedPath: FnOnce() -> Option<Vec<PathBuf>>,","+    {","+        match result {","+            Ok(_) if cfg!(windows) => {","+                Self::AddedToUserPath { persisted_path: read_persisted_path() }","+            }","+            Ok(_) => Self::PrependedInShellConfig,","+            Err(_) => Self::LeftAlone,","+        }","+    }","+","+    /// The `PATH` a new shell gets after setup, when another `pnpm` can still","+    /// come first on it. `None` when setup's shell configuration puts the","+    /// global bin directory first.","+    pub(crate) fn path_for_new_shells(&self) -> Option<OsString> {","+        match self {","+            Self::PrependedInShellConfig => None,","+            Self::AddedToUserPath {","+                persisted_path: Some(persisted_path),","+            } => std::env::join_paths(persisted_path).ok().or_else(|| std::env::var_os(\"PATH\")),","+            Self::AddedToUserPath { persisted_path: None } | Self::LeftAlone => {","+                std::env::var_os(\"PATH\")","+            }","+        }","+    }","+}","+","+/// A `pnpm` that a `PATH` lookup finds ahead of the one in the global bin","+/// directory.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub(crate) struct ShadowingPnpm {","+    pub(crate) executable: PathBuf,","+    pub(crate) origin: InstallOrigin,","+    /// Whether the global bin directory is on `PATH` at all, behind","+    /// `executable`. When it is not, `PATH` has yet to be set up, and the","+    /// right pnpm runs once the global bin directory is added ahead of","+    /// `executable`.","+    pub(crate) global_bin_on_path: bool,","+}","+","+impl ShadowingPnpm {","+    /// The warning to print once a pnpm is linked into `global_bin` and this","+    /// one still answers to `pnpm`.","+    pub(crate) fn emit_warning<Logger: Reporter>(&self, global_bin: &Path, prefix: &str) {","+        Logger::emit(&LogEvent::Pnpm(PnpmLog {","+            level: LogLevel::Warn,","+            message: self.warning(global_bin),","+            prefix: prefix.to_string(),","+        }));","+    }","+","+    pub(crate) fn warning(&self, global_bin: &Path) -> String {","+        let executable = self.executable.display();","+        let global_bin = global_bin.display();","+        let origin = self.origin.description();","+        let reorder = match self.executable.parent() {","+            Some(dir) => format!(\"move {global_bin} ahead of {} in PATH\", dir.display()),","+            None => format!(\"move {global_bin} ahead of it in PATH\"),","+        };","+        let fix = match self.origin.removal_command() {","+            Some(command) => format!(r#\"run \"{command}\" or {reorder}\"#),","+            None => reorder,","+        };","+        if self.global_bin_on_path {","+            format!(","+                \"\\\"pnpm\\\" on PATH is {executable} ({origin}), which comes before {global_bin}. \\","+                 Your shell keeps running that pnpm, not the one pnpm installed to {global_bin}. \\","+                 To finish switching, {fix}.\",","+            )","+        } else {","+            format!(","+                \"\\\"pnpm\\\" on PATH is {executable} ({origin}), and {global_bin} is not on PATH yet. \\","+                 When you add it, put it first: {fix}.\",","+            )","+        }","+    }","+}","+","+/// Warn about a `pnpm` ahead of `global_bin` that `pnpm setup` leaves in","+/// place, given what it did to `PATH`.","+pub(crate) fn warn_if_shadowed_after_setup<Logger: Reporter>(","+    global_bin: &Path,","+    path_entry: &SetupPathEntry,","+    prefix: &str,","+) {","+    if let Some(path) = path_entry.path_for_new_shells()","+        && let Some(shadowing) = find_shadowing_pnpm_in(global_bin, Some(&path))","+    {","+        shadowing.emit_warning::<Logger>(global_bin, prefix);","+    }","+}","+","+/// Where pnpm links its own `pnpm`.","+#[derive(Debug, Clone, Copy)]","+pub(crate) struct OwnDirs<'a> {","+    pub(crate) global_bin: &'a Path,","+    /// The pnpm home directory, which the v10 layout and CI actions link","+    /// into directly.","+    pub(crate) pnpm_home: Option<&'a Path>,","+}","+","+/// The `pnpm` the current `PATH` finds ahead of the one in `global_bin`, if","+/// any.","+pub(crate) fn find_shadowing_pnpm_on_path(global_bin: &Path) -> Option<ShadowingPnpm> {","+    find_shadowing_pnpm_in(global_bin, std::env::var_os(\"PATH\").as_deref())","+}","+","+fn find_shadowing_pnpm_in(global_bin: &Path, path_env: Option<&OsStr>) -> Option<ShadowingPnpm> {","+    let pnpm_home = default_pnpm_home_dir::<Host>();","+    let own = OwnDirs { global_bin, pnpm_home: pnpm_home.as_deref() };"],"additions":298,"deletions":0,"truncated":false}],"additions":592,"deletions":34,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-21T16:31:57.469540+00:00"}