y developer script\",","+    element: <RemixRootDefaultErrorBoundary error={routeError} />,","+    selector: \"script\",","+  },","+  {","+    name: \"default hydrate fallback developer script\",","+    element: <RemixRootDefaultHydrateFallback />,","+    selector: \"script\",","+  },","+])(","+  \"preserves the server nonce without hydration warnings for $name\",","+  async ({","+    element,","+    criticalCss,","+    selector,","+    links,","+    rsc = false,","+    targetCount = 1,","+  }) => {","+    // The default error/fallback scripts must actually render in these tests.","+    expect(ENABLE_DEV_WARNINGS).toBe(true);","+    let context = mockFrameworkContext({","+      criticalCss,","+      routeModules: {","+        root: {","+          default: () => null,","+          Layout: ({ children }) => <>{children}</>,","+          links,","+        },","+        other: { default: () => null },","+      },","+    });","+    context.manifest.routes.other = {","+      ...context.manifest.routes.root,","+      id: \"other\",","+      parentId: \"root\",","+      path: \"other\",","+      module: \"other.js\",","+      hasLoader: true,","+    };","+    let router = createMemoryRouter([","+      {","+        id: \"root\",","+        path: \"/\",","+        element,","+        children: [{ id: \"other\", path: \"other\" }],","+      },","+    ]);","+    function getTree(nonce?: string) {","+      return (","+        <RSCRouterContext.Provider value={rsc}>","+          <FrameworkContext.Provider value={{ ...context, nonce }}>","+            <RouterProvider router={router} />","+          </FrameworkContext.Provider>","+        </RSCRouterContext.Provider>","+      );","+    }","+","+    let consoleError = jest","+      .spyOn(console, \"error\")","+      .mockImplementation(() => {});","+    let container = document.createElement(\"div\");","+    document.body.appendChild(container);","+    let root: ReturnType<typeof hydrateRoot> | undefined;","+","+    try {","+      container.innerHTML = renderToString(getTree(\"server-nonce\"));","+      let targets = Array.from(","+        container.querySelectorAll<HTMLElement>(selector),","+      );","+      expect(targets).toHaveLength(targetCount);","+      expect(targets.map((target) => target.nonce)).toEqual(","+        Array(targetCount).fill(\"server-nonce\"),","+      );","+      await act(async () => {","+        root = hydrateRoot(container, getTree());","+      });","+","+      // The error boundary logs the supplied error on each render.","+      expect(","+        consoleError.mock.calls.filter(([error]) => error !== routeError),","+      ).toEqual([]);","+      let hydratedTargets = Array.from(container.querySelectorAll(selector));","+      expect(hydratedTargets).toHaveLength(targetCount);","+      expect(","+        hydratedTargets.every((target, index) => target === targets[index]),","+      ).toBe(true);","+      expect(targets.map((target) => target.nonce)).toEqual(","+        Array(targetCount).fill(\"server-nonce\"),","+      );","+    } finally {","+      await act(async () => root?.unmount());","+      container.remove();","+      router.dispose();","+      consoleError.mockRestore();","+    }","+  },","+);"],"additions":150,"deletions":0,"truncated":false},{"path":"packages/react-router/lib/dom/ssr/components.tsx","lines":["@@ -275,6 +275,7 @@ export function Links({ nonce, crossOrigin }: LinksProps): React.JSX.Element {","         <style","           {...{ [CRITICAL_CSS_DATA_ATTRIBUTE]: \"\" }}","           nonce={nonce}","+          suppressHydrationWarning","           dangerouslySetInnerHTML={{ __html: criticalCss }}","         />","       ) : null}","@@ -284,6 +285,7 @@ export function Links({ nonce, crossOrigin }: LinksProps): React.JSX.Element {","           rel=\"stylesheet\"","           href={criticalCss.href}","           nonce={nonce}","+          suppressHydrationWarning","           crossOrigin={crossOrigin}","         />","       ) : null}","@@ -299,6 +