ort { SchemaError } from '../../common/client/schema.js';","+import { ActionsClient } from '../../common/core/actionsClient.js';","+import { CoreClient } from '../../common/core/coreClient.js';","+import { PullRequestsClient } from '../../common/core/pullRequestsClient.js';","+import { ReviewsClient } from '../../common/core/reviewsClient.js';","+import { SearchClient } from '../../common/core/searchClient.js';","+import { parseActivationContext } from '../../common/missionControl/missionControlClient.js';","+import { createTestPullRequestResponse, FixtureApiRequestProvider } from './githubClientTestUtils.js';","+","+suite('GitHub API compatibility', () => {","+\tensureNoDisposablesAreLeakedInTestSuite();","+","+\tconst enabledBy = { id: 2, node_id: 'U_2', login: 'reviewer', avatar_url: '', html_url: 'https://github.com/reviewer', type: 'User' };","+\tconst repository = { owner: 'owner', name: 'repo' };","+\tconst date = '2026-10-02T00:00:00Z';","+\tconst job = {","+\t\tid: 1, node_id: 'CR_1', run_id: 2, name: 'Build', head_sha: 'a'.repeat(40),","+\t\tstatus: 'queued', conclusion: null, html_url: null,","+\t\tcheck_run_url: 'https://api.github.com/repos/owner/repo/check-runs/1',","+\t\tstarted_at: date, completed_at: null, labels: ['ubuntu-latest'],","+\t};","+","+\tfor (const merged of [false, true]) {","+\t\tfor (const [title, message] of [[null, null], [null, 'Custom message'], ['Custom title', null], ['', '']]) {","+\t\t\ttest(`preserves PR state with auto-merge text ${JSON.stringify([title, message])}, merged=${merged}`, async () => {","+\t\t\t\tconst provider = new FixtureApiRequestProvider(createTestPullRequestResponse({","+\t\t\t\t\tmerged,","+\t\t\t\t\tmerged_at: merged ? '2026-10-02T00:00:00Z' : null,","+\t\t\t\t\tmerge_commit_sha: merged ? 'c'.repeat(40) : null,","+\t\t\t\t\tauto_merge: { enabled_by: enabledBy, merge_method: 'squash', commit_title: title, commit_message: message },","+\t\t\t\t}));","+\t\t\t\tconst client = new PullRequestsClient(new CoreClient(provider, provider));","+\t\t\t\tconst result = await client.get({ owner: 'owner', name: 'repo' }, 1, new AbortController().signal);","+\t\t\t\tassert.deepStrictEqual({","+\t\t\t\t\tstate: result.state, merged: result.merged, draft: result.draft,","+\t\t\t\t\ttitle: result.auto_merge?.commit_title, message: result.auto_merge?.commit_message,","+\t\t\t\t}, { state: 'closed', merged, draft: false, title, message });","+\t\t\t});","+\t\t}","+\t}","+","+\tfor (const field of ['commit_title', 'commit_message']) {","+\t\ttest(`rejects a non-text, non-null auto-merge ${field}`, async () => {","+\t\t\tconst provider = new FixtureApiRequestProvider(createTestPullRequestResponse({","+\t\t\t\tauto_merge: { enabled_by: enabledBy, merge_method: 'squash', commit_title: '', commit_message: '', [field]: 42 },","+\t\t\t}));","+\t\t\tconst client = new PullRequestsClient(new CoreClient(provider, provider));","+\t\t\tawait assert.rejects(client.get({ owner: 'owner', name: 'repo' }, 1, new AbortController().signal), SchemaError);","+\t\t});","+\t}","+","+\ttest('preserves auto-merge metadata when the enabling user is unavailable', async () => {","+\t\tconst autoMerge = { enabled_by: null, merge_method: 'squash', commit_title: null, commit_message: null };","+\t\tconst provider = new FixtureApiRequestProvider(createTestPullRequestResponse({ auto_merge: autoMerge }));","+\t\tconst client = new PullRequestsClient(new CoreClient(provider, provider));","+\t\tassert.deepStrictEqual((await client.get(repository, 1, new AbortController().signal)).auto_merge, autoMerge);","+\t});","+","+\ttest('accepts review comments whose diff side is unavailable', async () => {","+\t\tconst comment = {","+\t\t\tid: 1, node_id: 'PRRC_1', pull_request_review_id: null, user: null, body: 'Review comment',","+\t\t\tpath: 'file.ts', diff_hunk: '', commit_id: 'a'.repeat(40), original_commit_id: 'b'.repeat(40),","+\t\t\tside: null, start_side: null, line: 1, original_line: 1,","+\t\t\thtml_url: 'https://github