 function shouldDisplayAriaMode(model: AriaModeInfo | undefined, setting: boolean): boolean {","   return canToggleAriaMode(model) ? setting : !!model?.hasAriaSnapshots;"," }"," "],"additions":4,"deletions":2,"truncated":false},{"path":"packages/trace-viewer/src/ui/defaultSettingsView.tsx","lines":["@@ -19,15 +19,15 @@ import { type Setting, SettingsView } from './settingsView';"," import { kThemeOptions, type Theme, useThemeSetting } from '@web/theme';"," import { useSetting } from '@web/uiUtils';"," import { canToggleAriaMode, shouldDisplayAriaMode } from './ariaModeView';","+import type { AriaModeInfo } from './ariaModeView';"," ","-import type { TraceModel } from '@isomorphic/trace/traceModel';"," "," /**","  * A view of the collection of standard settings used between various applications","  */"," export const DefaultSettingsView: React.FC<{","   location: 'ui-mode' | 'trace-viewer',","-  model?: TraceModel,","+  model?: AriaModeInfo,"," }> = ({ location, model }) => {","   const [","     shouldPopulateCanvasFromScreenshot,"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/trace-viewer/src/ui/serviceWorker.ts","lines":["@@ -0,0 +1,30 @@","+/**","+ * Copyright (c) Microsoft Corporation.","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+// The service worker gives the trace data to the trace viewer.","+export async function startServiceWorker() {","+  if (!navigator.serviceWorker)","+    throw new Error(`Service workers are not supported.\\nMake sure to serve the Trace Viewer (${window.location}) via HTTPS or localhost.`);","+  navigator.serviceWorker.register('sw.bundle.js');","+  if (!navigator.serviceWorker.controller) {","+    await new Promise<void>(f => {","+      navigator.serviceWorker.oncontrollerchange = () => f();","+    });","+  }","+","+  // Keep SW running.","+  setInterval(function() { fetch('ping'); }, 10000);","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"packages/trace-viewer/src/ui/uiModeTraceFrame.tsx","lines":["@@ -0,0 +1,121 @@","+/**","+ * Copyright (c) Microsoft Corporation.","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+import { artifactsFolderName } from '@testIsomorphic/folders';","+import React from 'react';","+import type { ContextEntry } from '@isomorphic/trace/entries';","+import { TraceModel } from '@isomorphic/trace/traceModel';","+import type { UIModeTraceEvent, UIModeTraceParams } from './uiModeTraceProtocol';","+import { Workbench } from './workbench';","+","+// The trace viewer side of the UI mode frame.","+export const UIModeTraceFrame: React.FC<{","+  params: UIModeTraceParams,","+  sendEvent: (event: UIModeTraceEvent) => void,","+}> = ({ params, sendEvent }) => {","+  const [model, setModel] = React.useState<{ model: TraceModel, isLive: boolean } | undefined>(undefined);","+  const [counter, setCounter] = React.useState(0);","+","+  // Only load the trace again when the test result is different.","+  const { result, testId, outputDir, pathSeparator } = params;","+  const errorsRef = React.useRef<string[]>([]);","+  errorsRef.current = result?.errors ?? [];","+  const hasResult = !!result;","+  const { startTime, duration, workerIndex, tracePath } = result ?? {};","+","+  React.useEffect(() => {","+    if (!hasResult) {","+      setModel(undefined);","+      return;","+    }","+","+    const abortController = new AbortController();","+    const { signal } = abortController;","+","+    // Test finished.","+    if (duration! >= 0 && tracePath) {","+      loadSingleTraceFile(tracePath, startTime!, signal).then(model => setModel({ model, isLive: false })).catch(e => {","+        if (!signal.aborted)","+          throw e;","+      });","+      return () => abortController.abort();","+    }","+","+    if (!outputDir) {","+      setModel(undefined);","+      return;","+    }","+","+    const traceLocation = [","+      outputDir,","+      artifactsFolderName(workerIndex!),","+      'traces',","+      `${testId}.json`","+    ].join(pathSeparator);","+    // Start polling running test.","+    const pollTimer = setTimeout(async () => {","+      try {","+        const model = await loadSingleTraceFile(traceLocation, Date.now(), signal);","+        setModel({ model, isLive: true });","+      } catch {","+        if (signal.aborted)","+          return;","+        const model = new TraceModel('', []);","+        model.errorDescriptors.push(...errorsRef.current.map(message => ({ message })));","+        setModel({ model, isLive: false });","+      }","+      setCounter(counter + 1);","+    }, 500);","+    return () => {","+      clearTimeout(pollTimer);","+      abortController.abort();","+    };","+  }, [hasResult, startTime, duration, workerIndex, tracePath, testId, outputDir, pathSeparator, setModel, counter, setCounter]);","+","+  // A live trace gives a new model on each poll. Only send the values that are different.","+  const hasModel = !!model;","+  const hasDomSnapshots = !!model?.model.hasDomSnapshots;","+  const hasAriaSnapshots = !!model?.model.hasAriaSnapshots;","+  React.useEffect(() => {","+    sendEvent({ method: 'traceInfo', info: hasModel ? { hasDomSnapshots, hasAriaSnapshots } : undefined });","+  }, [hasModel, hasDomSnapshots, hasAriaSnapshots, sendEvent]);","+","+  const onOpenExternally = React.useCallback(({ file, line, column }: { file: string, line: number, column: number }) => {","+    sendEvent({ method: 'openExternally', location: { file, line, column } });","+  }, [sendEvent]);","+","+  return <Workbench","+    model={model?.model}","+    key='workbench'","+    showSourcesFirst={true}","+    rootDir={params.rootDir}","+    fallbackLocation={params.testFile}","+    isLive={model?.isLive}","+    status={params.status}","+    defaultAnnotations={params.annotations}","+    onOpenExternally={onOpenExternally}","+    revealSource={params.revealSource}","+  />;","+};","+","+async function loadSingleTraceFile(absolutePath: string, timestamp: number, signal: AbortSignal): Promise<TraceModel> {","+  const traceUri = `file?path=${encodeURIComponent(absolutePath)}&timestamp=${timestamp}`;","+  const params = new URLSearchParams();","+  params.set('trace', traceUri);","+  const response = await fetch(`contexts?${params.toString()}`, { signal });","+  const contextEntries = await response.json() as ContextEntry[];","+  return new TraceModel(traceUri, contextEntries);","+}"],"additions":121,"deletions":0,"truncated":false},{"path":"packages/trace-viewer/src/ui/uiModeTraceProtocol.ts","lines":["@@ -0,0 +1,72 @@","+/**","+ * Copyright (c) Microsoft Corporation.","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+import type { SourceLocation } from '@isomorphic/trace/traceModel';","+import type { TestAnnotation } from '@playwright/test';","+import type { AriaModeInfo } from './ariaModeView';","+import type { UITestStatus } from './testUtils';","+","+// UI mode shows the trace viewer in a frame. The trace viewer shows content from the pages under test,","+// so it has a different origin than UI mode, and they only exchange messages.","+","+export type UIModeTraceParams = {","+  // The result of the selected test, if it has one and the test is not scheduled.","+  result?: {","+    startTime: number,","+    duration: number,","+    workerIndex: number,","+    tracePath?: string,","+    errors: string[],","+  },","+  testId?: string,","+  outputDir?: string,","+  rootDir?: string,","+  testFile?: SourceLocation,","+  status?: UITestStatus,","+  annotations: TestAnnotation[],","+  revealSource: boolean,","+  pathSeparator: string,","+};","+","+// The values are strings from the local storage.","+export type SerializedSettings = Record<string, string>;","+","+export type UIModeTraceRequest = {","+  // UI mode sends this before the first update, and again when a setting changes.","+  method: 'settings',","+  settings: SerializedSettings,","+} | {","+  method: 'update',","+  params: UIModeTraceParams,","+};","+","+export type UIModeTraceEvent = {","+  method: 'ready',","+} | {","+  method: 'traceInfo',","+  info: AriaModeInfo | undefined,","+} | {","+  method: 'openExternally',","+  location: { file: string, line: number, column: number },","+} | {","+  // The trace viewer has its own local storage, and UI mode keeps a copy of it between the runs.","+  method: 'saveSettings',","+  settings: SerializedSettings,","+} | {","+  // A key that the trace viewer did not handle. It bubbles to the page that has the frame.","+  method: 'keydown',","+  event: { key: string, code: string, ctrlKey: boolean, shiftKey: boolean, altKey: boolean, metaKey: boolean },","+};"],"additions":72,"deletions":0,"truncated":false},{"path":"packages/trace-viewer/src/ui/uiModeTraceView.tsx","lines":["@@ -14,102 +14,149 @@","  * limitations under the License.","  */"," ","-import { artifactsFolderName } from '@testIsomorphic/folders';"," import type { TreeItem } from '@testIsomorphic/testTree';","-import '@web/common.css';","-import '@web/third_party/vscode/codicon.css';","+import { settings } from '@web/uiUtils';"," import type * as reporterTypes from 'playwright/types/testReporter';"," import React from 'react';","-import type { ContextEntry } from '@isomorphic/trace/entries';"," import type { SourceLocation } from '@isomorphic/trace/traceModel';","-import { TraceModel } from '@isomorphic/trace/traceModel';","-import { Workbench } from './workbench';","+import type { AriaModeInfo } from './ariaModeView';","+import type { SerializedSettings, UIModeTraceEvent, UIModeTraceParams, UIModeTraceRequest } from './uiModeTraceProtocol';"," ","+const searchParams = new URLSearchParams(window.location.search);","+// The trace viewer has its own server on a different port, so it has a different origin.","+// The browser gets to the two servers through the same host. The parameter is \"<port>/<path>\".","+const traceViewerPortAndPath = searchParams.get('traceViewer') ?? '';","+if (!/^\\d+\\//.test(traceViewerPortAndPath))","+  throw new Error('UI mode does not have the address of the trace viewer');","+const traceViewerBase = new URL(`${window.location.protocol}//${window.location.hostname}:${traceViewerPortAndPath}`);","+const traceViewerOrigin = traceViewerBase.origin;","+const traceViewerSettingsKey = 'traceViewerSettings';","+const traceViewerParams = new URLSearchParams();","+if (searchPar