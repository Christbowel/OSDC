h":"tests/v1/attention/test_indexer_deepseek_v4_slot_mapping.py","lines":["@@ -387,6 +387,7 @@ def test_indexer_preserves_deepseek_v41_mla_block_size():"," "," def test_indexer_warmup_normalizes_zero_compress_ratios():","     config = SimpleNamespace(","+        attention_config=SimpleNamespace(sparse_mla_shard_q=False),","         scheduler_config=SimpleNamespace(max_num_batched_tokens=8),","         model_config=SimpleNamespace(","             hf_text_config=SimpleNamespace(","@@ -416,6 +417,7 @@ def test_indexer_warmup_includes_pcp_normalized_dcp_key(monkeypatch):","         lambda: SimpleNamespace(rank_in_group=2),","     )","     config = SimpleNamespace(","+        attention_config=SimpleNamespace(sparse_mla_shard_q=False),","         scheduler_config=SimpleNamespace(max_num_batched_tokens=8),","         model_config=SimpleNamespace(","             hf_text_config=SimpleNamespace(compress_ratios=[32], index_kpool=32)"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/v1/attention/test_indexer_tp_row_shard.py","lines":["@@ -1,245 +0,0 @@","-# SPDX-License-Identifier: Apache-2.0","-# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","-\"\"\"TP query-row sharding of the DSA indexer prefill (see PrefillRowShard):","-each rank scores a contiguous slice; the group exchanges int32s per row.\"\"\"","-","-from types import SimpleNamespace","-","-import pytest","-import torch","-","-import vllm.model_executor.layers.sparse_attn_indexer as sparse_indexer","-import vllm.v1.attention.backends.mla.indexer as indexer","-from vllm.config import AttentionConfig, CUDAGraphMode","-from vllm.model_executor.layers.sparse_attn_indexer import PrefillRowShard","-","-MIN_ROWS = AttentionConfig().indexer_tp_shard_min_rows","-","-","-def _chunk(start: int, end: int) -> SimpleNamespace:","-    \"\"\"Chunk over rows [start, end); bounds derive from the global row.\"\"\"","-    n = end - start","-    return SimpleNamespace(","-        token_start=start,","-        token_end=end,","-        cu_seqlen_ks=torch.zeros(n, dtype=torch.int32),","-        cu_seqlen_ke=((torch.arange(n) * 7 + start) % 65).int(),","-    )","-","-","-@pytest.mark.parametrize(\"world\", [2, 3, 8])","-def test_shard_narrowing_covers_every_row_once(world: int) -> None:","-    \"\"\"Narrowed windows tile the prefill rows exactly once, carry the causal","-    bounds of those global rows, and skip chunks foreign to this rank.\"\"\"","-    decode, rows = 5, 997","-    edges = [decode, decode + 330, decode + 337, decode + rows]","-    chunks = [_chunk(lo, hi) for lo, hi in zip(edges, edges[1:])]","-    sizes = [rows // world + int(r < rows % world) for r in range(world)]","-    covered = []","-    for rank in range(world):","-        shard = PrefillRowShard(decode, sizes, rank)","-        for chunk in chunks:","-            window = shard.narrow(chunk)","-            if window is None:","-                continue","-            start, end, ks, ke = window","-            lo, hi = start - chunk.token_start, end - chunk.token_start","-            torch.testing.assert_close(ks, chunk.cu_seqlen_ks[lo:hi])","-            torch.testing.assert_close(ke, chunk.cu_seqlen_ke[lo:hi])","-            covered.append((start, end))","-    covered.sort()","-    # Windows must be disjoint, contiguous and exactly cover the prefill rows.","-    assert [s for s, _ in covered] == [decode, *[e for _, e in covered][:-1]]","-    assert covered[-1][1] == decode + rows","-","-","-def test_shard_exchange_reassembles_rows_only(","-    monkeypatch: pytest.MonkeyPatch,","-) -> None:","-    \"\"\"Gathered indices land only on real prefill rows: leading decode rows","-    and trailing CUDA-graph padding stay untouched, and the full k-pool","-    width (tail columns included) is exchanged.\"\"\"","-    decode, pad, topk, kpool = 5, 3, 8, 4","-    width = topk + kpool - 1","-    sizes = [17, 9, 21]","-    buffer = torch.full((decode + sum(sizes) + pad, width), -7, dtype=torch.int32)","-    gathered = torch.arange(sum(sizes) * width, dtype=torch.int32).reshape(-1, width)","-    calls = []","-","-    def fake_group():","-        def all_gatherv(local, dim, sizes):","-            calls.append((local, sizes))","-            return gathered","-","-        return SimpleNamespace(all_gatherv=all_gatherv)","-","-    monkeypatch.setattr(sparse_indexer, \"get_tp_group\", fake_group)","-    for rank in range(len(sizes)):","-        PrefillRowShard(decode, sizes, rank).exchange_topk(buffer, width)","-    assert calls[0][1] == sizes and calls[0][0].is_contiguous()","-    torch.testing.assert_close(buffer[decode : decode + sum(sizes)], gathered)","-    assert torch.all(buffer[:decode] == -7), \"decode rows stay outside\"","-    assert torch.all(buffer[decode + sum(sizes) :] == -7), \"padding untouched\"","-","-","-@pytest.mark.parametrize(\"tp_size\", [2, 4, 8])","-def test_balanced_row_shard_partitions_and_declines(tp_size: int) -> None:","-    \"\"\"The split covers every row once with >= 1 row per rank and declines","-    below the activation floor (or on a single rank).\"\"\"","-    n = MIN_ROWS","-    shapes = [","-        ([4 * n], [4 * n]),  # fresh prompt: the full causal cost ramp","-        # uneven requests at different context depths","-        ([2 * n, 7, 4 * n, n // 3 + 5], [2 * n, 9007, 4 * n + 500, n // 3 + 60005]),","-    ]","-    ratio = 4","-    for query_lens, seq_lens in shapes:","-        sizes = indexer.balanced_prefill_row_shard(","-            torch.tensor(seq_lens, dtype=torch.int32),","-            torch.tensor(query_lens, dtype=torch.int32),","-            ratio,","-            tp_size,","-            n,","-        )","-        assert sizes is not None and len(sizes) == tp_size","-        assert sum(sizes) == sum(query_lens) and min(sizes) >= 1","-    lens = torch.tensor([n - 1], dtype=torch.int32)","-    assert indexer.balanced_prefill_row_shard(lens, lens, ratio, tp_size, n) is None","-    assert indexer.balanced_prefill_row_shard(lens, lens, ratio, 1, n) is None","-","-","-def test_row_shard_threshold_is_total_not_per_rank() -> None:","-    \"\"\"The activation floor counts TOTAL rows regardless of tp_size: a","-    per-rank floor would need 128K rows at TP8, i.e. an unschedulable","-    --max-num-batched-tokens of 128K on 80 GB Hopper nodes.\"\"\"","-    lens = torch.tensor([MIN_ROWS], dtype=torch.int32)","-    for tp_size in (2, 4, 8):","-        sizes = indexer.balanced_prefill_row_shard(lens, lens, 4, tp_size, MIN_ROWS)","-        assert sizes is not None","-","-","-def test_tp2_old_per_rank_window_stays_replicated() -> None:","-    \"\"\"32K-64K total rows engaged on TP2 under the old per-rank floor","-    (16K rows/rank); the total floor now keeps them replicated — the","-    all_gatherv latency term is largest at small tp.\"\"\"","-    window = torch.tensor([3 * MIN_ROWS // 4], dtype=torch.int32)","-    assert indexer.balanced_prefill_row_shard(window, window, 4, 2, MIN_ROWS) is None","-","-","-def test_row_shard_floor_is_at_least_tp_size() -> None:","-    \"\"\"A floor below tp_size still leaves every rank at least one row.\"\"\"","-    lens = torch.tensor([8], dtype=torch.int32)","-    assert indexer.balanced_prefill_row_shard(lens, lens, 4, 8, 1) is not None","-    assert indexer.balanced_prefill_row_shard(lens - 1, lens - 1, 4, 8, 1) is None","-","-","-def test_row_sharding_gate_rejects_unsupported_configurations(","-    monkeypatch: pytest.MonkeyPatch,","-) -> None:","-    \"\"\"The gate is the whole safety envelope; nothing else guards the exchange.\"\"\"","-    monkeypatch.setattr(indexer.current_platform, \"is_cuda\", lambda: True)","-","-    def supported(**kwargs):","-        mode = kwargs.pop(\"cudagraph_mode\", CUDAGraphMode.PIECEWISE)","-        cfg = SimpleNamespace(compilation_config=SimpleNamespace(cudagraph_mode=mode))","-        args = {\"dcp_world_size\": 1, \"use_pcp\": False, \"tp_size\": 4, **kwargs}","-        return indexer.tp_prefill_row_sharding_supported(cfg, **args)","-","-    assert supported()","-    for bad in ({\"tp_size\": 1}, {\"dcp_world_size\": 2}, {\"use_pcp\": True}):","-        assert not supported(**bad)","-    for name in (","-        \"VLLM_DISABLE_PYNCCL\",","-        \"VLLM_USE_NCCL_SYMM_MEM\",","-        \"VLLM_BATCH_INVARIANT\",","-    ):","-        with monkeypatch.context() as m:","-            m.setattr(indexer.envs, name, True)","-            assert not supported()","-    # FULL captures mixed batches whole, so the exchange must stay out.","-    assert not supported(cudagraph_mode=CUDAGraphMode.FULL)","-    assert supported(cudagraph_mode=CUDAGraphMode.FULL_AND_PIECEWISE)","-","-","-def test_profiling_run_reserves_exchange_transient(","-    monkeypatch: pytest.MonkeyPatch,","-) -> None:","-    \"\"\"The dummy run returns before the exchange executes, so its all_gatherv","-    output plus staging copy must be reserved up front when row sharding is","-    active -- and only then.\"\"\"","-    rows, topk = 128, 8","-    buffer = torch.empty((rows, topk), dtype=torch.int32)","-    peak = 2 * rows * topk * buffer.element_size()","-    specs = (((1,), torch.uint8), ((1,), torch.uint8))","-    numels: list[int] = []","-    real_empty = torch.empty","-","-    def recording_empty(*args, **kwargs):","-        out = real_empty(*args, **kwargs)","-        numels.append(out.numel())","-        return out","-","-    def run_dummy(tp_world: int) -> None:","-        numels.clear()","-        with monkeypatch.context() as m:","-            m.setattr(torch, \"empty\", recording_empty)","-            m.setattr(","-                sparse_indexer,","-                \"get_forward_context\",","-                lambda: SimpleNamespace(attn_metadata=None),","-            )","-            m.setattr(sparse_indexer, \"_gather_workspace_shapes\", lambda *a: specs)","-            m.setattr(","-                sparse_indexer,","-                \"current_workspace_manager\",","-                lambda: SimpleNamespace(get_simultaneous=lambda *s: None),","-            )","-            m.setattr(","-                sparse_indexer,","-                \"get_tp_group\",","-                lambda: SimpleNamespace(world_size=tp_world),","-            )","-            m.setattr(","-                sparse_indexer,","-                \"get_current_vllm_config_or_none\",","-                lambda: SimpleNamespace(","-                    compilation_config=SimpleNamespace(","-                        cudagraph_mode=CUDAGraphMode.PIECEWISE","-                    ),","-                    parallel_config=SimpleNamespace(","-                        decode_context_parallel_size=1,","-                        prefill_context_parallel_size=1,","-                    ),","-                    scheduler_config=SimpleNamespace(","-                        max_num_seqs=4, max_num_batched_tokens=512","-                    ),","-                    num_speculative_tokens=0,","-                ),","-            )","-            m.setattr(sparse_indexer.envs, \"VLLM_SPARSE_INDEXER_MAX_LOGITS_MB\", 1)","-            m.setattr(indexer.current_platform, \"is_cuda\", lambda: True)","-            sparse_indexer.sparse_attn_indexer(","-                hidden_states=torch.empty(4, 4),","-                k_cache_prefix=\"k\",","-                kv_cache=torch.empty(4, 4),","-                q_quant=torch.empty(4, 4),","-                q_scale=None,","-                k=None,","-                weights=torch.empty(4),","-                quant_block_size=128,","-                scale_fmt=None,","-                topk_tokens=topk,","-                head_dim=64,","-                max_model_len=1024,","-                total_seq_lens=512,","-                topk_indices_buffer=buffer,","-                skip_k_cache_insert=True,","-                use_pcp=False,","-                pcp_shard_decode_requests=False,","-                dense_mha_metadata_layer_name=\"\",","-            )","-","-    run_dummy(tp_world=2)","-    assert peak in numels","-    run_dummy(tp_world=1)","-    assert peak not in numels"],"additions":0,"deletions":245,"truncated":false},{"path":"tests/v1/attention/test_shardq.py","lines":["@@ -0,0 +1,162 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"ShardQ token split and exchanges (vllm/v1/attention/ops/shardq.py).\"\"\"","+","+from types import SimpleNamespace","+","+import numpy as np","+import pytest","+import torch","+import torch.multiprocessing as mp","+","+from tests.v1.attention.utils import BatchSpec, create_common_attn_metadata","+from vllm.config import VllmConfig, set_current_vllm_config","+from vllm.distributed.parallel_state import (","+    destroy_distributed_environment,","+    destroy_model_parallel,","+    ensure_model_parallel_initialized,","+    init_distributed_environment,","+)","+from vllm.utils.network_utils import get_open_port","+from vllm.v1.attention.ops import shardq","+from vllm.v1.attention.ops.shardq import (","+    ShardQMetadata,","+    allocate_shardq_buffers,","+    build_shardq_split,","+    shard_q,","+    unshard_out,","+    zigzag_split,","+)","+","+","+@pytest.mark.parametrize(\"world\", [2, 4, 8])","+@pytest.mark.parametrize(\"lens\", [[4096], [65, 300, 7000], [1000, 64, 64, 129]])","+def test_zigzag_split_partitions_tokens(world, lens):","+    qsl = np.r_[0, np.cumsum(lens)]","+    token_ids, num_tokens_per_rank = zigzag_split(np.array(lens), world)","+    per_rank = np.split(token_ids, np.cumsum(num_tokens_per_rank)[:-1])","+    merged = np.sort(np.concatenate(per_rank))","+    np.testing.assert_array_equal(merged, np.arange(qsl[-1]))","+    for idx in per_rank:","+        assert np.all(np.diff(idx) > 0)","+    # Each rank takes one early and one late chunk of every request, so its","+    # summed causal positions stay within a couple of tokens per request of","+    # the mean.","+    positions = [","+        sum(int((idx[(idx >= a) & (idx < b)] - a).sum()) for a, b in zip(qsl, qsl[1:]))","+        for idx in per_rank","+    ]","+    assert max(positions) - min(positions) <= sum(4 * n for n in lens)","+","+","+@pytest.mark.parametrize(\"num_spec\", [0, 2])","+def test_build_shardq_split_after_indexer_decodes(monkeypatch, num_spec):","+    \"\"\"The MLA and indexer builders derive the same split from the batch:","+    requests of at most 1 + num_spec tokens stay head-sharded, and the tokens","+    after them are split once they reach sparse_mla_shard_q_min_tokens and a","+    request is longer than the top-k.\"\"\"","+    monkeypatch.setattr(","+        shardq, \"get_tp_group\", lambda: SimpleNamespace(world_size=4, rank_in_group=1)","+    )","+    query_lens = [1 + num_spec] * 3 + [100, 5000, 4000]","+    metadata = create_common_attn_metadata(","+        BatchSpec(seq_lens=[q + 300 for q in query_lens], query_lens=query_lens),","+        block_size=16,","+        device=torch.device(\"cpu\"),","+    )","+    attention_config = SimpleNamespace(sparse_mla_shard_q_min_tokens=9100)","+    hf_config = SimpleNamespace(index_topk=5299)","+    vllm_config = SimpleNamespace(","+        speculative_config=(","+            SimpleNamespace(num_speculative_tokens=num_spec) if num_spec else None","+        ),","+        attention_config=attention_config,","+        model_config=SimpleNamespace(hf_text_config=hf_config),","+    )","+    split = build_shardq_split(metadata, vllm_config)","+    assert split is not None","+    assert split.num_decode_tokens == 3 * (1 + num_spec)","+    assert split.num_tokens_per_rank.sum() == 9100","+    hf_config.index_topk = 5300","+    assert build_shardq_split(metadata, vllm_config) is None","+    hf_config.index_topk = 5299","+    attention_config.sparse_mla_shard_q_min_tokens = 9101","+    assert build_shardq_split(metadata, vllm_config) is None","+    # Five tokens split into eight chunks, three of them empty, leaving rank 2","+    # without tokens.","+    attention_config.sparse_mla_shard_q_min_tokens = 1","+    short = create_common_attn_metadata(","+        BatchSpec(seq_lens=[5300], query_lens=[5]),","+        block_size=16,","+        device=torch.device(\"cpu\"),","+    )","+    assert build_shardq_split(short, vllm_config) is None","+","+","+def _round_trip(rank, world, port, use_sm, q_dtype, num_decode_tokens):","+    torch.accelerator.set_device_index(rank)","+    vllm_config = VllmConfig()","+    with set_current_vllm_config(vllm_config):","+        init_distributed_environment(","+            world_size=world,","+            rank=rank,","+            distributed_init_method=f\"tcp://127.0.0.1:{port}\",","+            local_rank=rank,","+        )","+        ensure_model_parallel_initialized(world, 1)","+        torch.manual_seed(0)","+        lens = [700, 64, 3001]","+        heads, dim = 4, 576","+        num_tokens = num_decode_tokens + sum(lens)","+        vllm_config.scheduler_config.max_num_batched_tokens = num_tokens","+        if use_sm:","+            allocate_shardq_buffers(","+                vllm_config, heads, dim, 512, q_dtype, torch.bfloat16","+            )","+        all_heads = world * heads","+        full = torch.randn(num_tokens, all_heads, dim, device=\"cuda\").to(q_dtype)","+        token_ids, num_tokens_per_rank = zigzag_split(np.array(lens), world)","+        shardq = ShardQMetadata(","+            num_decode_tokens=num_decode_tokens,","+            num_tokens_per_rank=num_tokens_per_rank.tolist(),","+            token_ids=torch.from_numpy(token_ids).cuda(),","+            rank_offsets=torch.from_numpy(","+                np.r_[0, np.cumsum(num_tokens_per_rank)]","+            ).cuda(),","+        )","+        local_heads = full[:, rank * heads : (rank + 1) * heads].contiguous()","+        for _ in range(2):  # The second pass reuses the symmetric buffers.","+            decode_q, sharded = shard_q(local_heads, shardq)","+            # Bitwise, as the exchanges only move bytes (and fp8 lacks","+            # torch.equal).","+            assert torch.equal(","+                decode_q.view(torch.uint8),","+                local_heads[:num_decode_tokens].view(torch.uint8),","+            )","+            expected = full[num_decode_tokens:][shardq.local_token_ids]","+            assert torch.equal(sharded.view(torch.uint8), expected.view(torch.uint8))","+            # Attention outputs are a head-padded slice; unshard reads its","+            # strides.","+            padded = torch.zeros(sharded.shape[0], all_heads + 8, 512, device=\"cuda\")","+            padded[:, :all_heads] = sharded[..., :512].float()","+            out = padded.bfloat16()[:, :all_heads]","+            restored = unshard_out(out, shardq, decode_q[..., :512].bfloat16())","+            assert torch.equal(restored, local_heads[..., :512].bfloat16())","+        destroy_model_parallel()","+        destroy_distributed_environment()","+","+","+@pytest.mark.parametrize(\"q_dtype\", [torch.bfloat16, torch.float8_e4m3fn])","+@pytest.mark.parametrize(\"use_sm\", [False, True])","+@pytest.mark.parametrize(\"num_decode_tokens\", [0, 33])","+def test_shard_q_round_trip(use_sm, q_dtype, num_decode_tokens):","+    \"\"\"The exchanges move each rank's tokens to it with all heads and back,","+    through symmetric memory or NCCL, leaving the decode tokens head-sharded.\"\"\"","+    world = 2","+    if torch.accelerator.device_count() < world:","+        pytest.skip(f\"needs {world} GPUs\")","+    mp.spawn(","+        _round_trip,","+        args=(world, get_open_port(), use_sm, q_dtype, num_decode_tokens),","+        nprocs=world,","+    )"],"additions":162,"deletions":0,"truncated":false},{"path":"tests/v1/attention/test_sparse_mla_backends.py","lines":["@@ -253,6 +253,7 @@ def test_nope_flashinfer_sparse_mla_uses_model_scale(monkeypatch):","         block_table=torch.zeros((1, 1), dtype=torch.int32),","         block_size=32,","         num_decode_tokens=1,","+        topk_start=0,","     )","     recorded_scale = None","