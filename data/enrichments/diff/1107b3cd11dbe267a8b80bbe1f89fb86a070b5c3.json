2 @@ func TestTrashcanCleanOut(t *testing.T) {"," \t\t}"," \t})"," }","+","+func TestTrashcanCleanMaxSize(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname    string","+\t\tmaxSize int","+\t\tdays    int","+\t\twant    []string","+\t}{","+\t\t// Each file is four bytes, and archived 10/6/2 days ago.","+\t\t{\"unlimited\", 0, 0, []string{\"old/file\", \"middle\", \"new\"}},","+\t\t{\"size only\", 8, 0, []string{\"middle\", \"new\"}},","+\t\t{\"exact limit\", 12, 0, []string{\"old/file\", \"middle\", \"new\"}},","+\t\t{\"smaller than one file\", 3, 0, nil},","+\t\t{\"age and size\", 4, 7, []string{\"new\"}},","+\t\t{\"age first\", 8, 7, []string{\"middle\", \"new\"}},","+\t\t{\"invalid limit\", -1, 0, []string{\"old/file\", \"middle\", \"new\"}},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tcfg := config.FolderConfiguration{","+\t\t\t\tFilesystemType: config.FilesystemTypeBasic,","+\t\t\t\tPath:           t.TempDir(),","+\t\t\t\tVersioning:     config.VersioningConfiguration{Params: map[string]string{\"maxSize\": strconv.Itoa(tc.maxSize), \"cleanoutDays\": strconv.Itoa(tc.days)}},","+\t\t\t}","+\t\t\tv := newTrashcan(cfg).(*trashcan)","+\t\t\tif err := v.versionsFs.MkdirAll(\"old\", 0o755); err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+","+\t\t\tfor i, name := range []string{\"old/file\", \"middle\", \"new\"} {","+\t\t\t\twriteFile(t, v.versionsFs, name, \"1234\")","+\t\t\t\tstamp := time.Now().Add(-time.Duration(10-i*4) * 24 * time.Hour)","+\t\t\t\tif err := v.versionsFs.Chtimes(name, stamp, stamp); err != nil {","+\t\t\t\t\tt.Fatal(err)","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tif err := v.Clean(context.Background()); err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+","+\t\t\tfor _, name := range []string{\"old/file\", \"middle\", \"new\"} {","+\t\t\t\twant := slices.Contains(tc.want, name)","+\t\t\t\t_, err := v.versionsFs.Lstat(name)","+\t\t\t\tif want && err != nil {","+\t\t\t\t\tt.Errorf(\"expected %s to remain: %v\", name, err)","+\t\t\t\t}","+\t\t\t\tif !want && !fs.IsNotExist(err) {","+\t\t\t\t\tt.Errorf(\"expected %s to be removed: %v\", name, err)","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tif !slices.Contains(tc.want, \"old/file\") {","+\t\t\t\tif _, err := v.versionsFs.Lstat(\"old\"); !fs.IsNotExist(err) {","+\t\t\t\t\tt.Errorf(\"expected empty directory removed: %v\", err)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"lib/versioner/util.go","lines":["@@ -15,6 +15,7 @@ import ("," \t\"path/filepath\""," \t\"regexp\""," \t\"slices\"","+\t\"sort\""," \t\"strings\""," \t\"time\""," ","@@ -445,3 +446,92 @@ func cleanVersions(versionsFs fs.Filesystem, versions []string, toRemove func([]"," \t\t}"," \t}"," }","+","+// cleanByAgeAndSize removes expired versions, then the oldest remaining versions","+// until their total size fits within maxSize. Nonpositive limits are disabled.","+func cleanByAgeAndSize(ctx context.Context, versionsFs fs.Filesystem, cleanoutDays int, maxSize int64, versionTime func(string, fs.FileInfo) (time.Time, bool)) error {","+\tif cleanoutDays <= 0 && maxSize <= 0 {","+\t\treturn nil","+\t}","+","+\tif _, err := versionsFs.Lstat(\".\"); fs.IsNotExist(err) {","+\t\treturn nil","+\t}","+","+\tcutoff := time.Now().Add(time.Duration(-24*cleanoutDays) * time.Hour)","+\tdirTracker := make(emptyDirTracker)","+\ttype candidate struct {","+\t\tpath        string","+\t\tsize        int64","+\t\tversionTime time.Time","+\t}","+\tvar files []candidate","+\tvar totalSize int64","+","+\twalkFn := func(path string, info fs.FileInfo, err error) error {","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\treturn ctx.Err()","+\t\tdefault:","+\t\t}","+","+\t\tif info.IsDir() && !info.IsSymlink() {","+\t\t\tdirTracker.addDir(path)","+\t\t\treturn nil","+\t\t}","+","+\t\tstamp, ok := versionTime(path, info)","+\t\tif !ok {","+\t\t\tdirTracker.addFile(path)","+\t\t\treturn nil","+\t\t}","+\t\tif cleanoutDays > 0 && stamp.Before(cutoff) {","+\t\t\t// The file is too old; remove it.","+\t\t\terr = versionsFs.Remove(path)","+\t\t} else {","+\t\t\t// Remember candidates for size cleanup, or mark the directory","+\t\t\t// as nonempty when there is no size limit.","+\t\t\tif maxSize > 0 {","+\t\t\t\tfiles = append(files, candidate{path, info.Size(), stamp})","+\t\t\t\ttotalSize += info.Size()","+\t\t\t} else {","+\t\t\t\tdirTracker.addFile(path)","+\t\t\t}","+\t\t}","+\t\treturn err","+\t}","+","+\tif err := versionsFs.Walk(\".\", walkFn); err != nil {","+\t\treturn err","+\t}","+","+\tif maxSize > 0 && totalSize > maxSize {","+\t\tsort.Slice(files, func(i, j int) bool {","+\t\t\tif files[i].versionTime.Equal(files[j].versionTime) {","+\t\t\t\treturn files[i].path < files[j].path","+\t\t\t}","+\t\t\treturn files[i].versionTime.Before(files[j].versionTime)","+\t\t})","+\t}","+\tfor _, file := range files {","+\t\tif err := ctx.Err(); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif maxSize > 0 && totalSize > maxSize {","+\t\t\tif err := versionsFs.Remove(file.path); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t\ttotalSize -= file.size","+\t\t} else {","+\t\t\tdirTracker.addFile(file.path)","+\t\t}","+\t}","+","+\tdirTracker.deleteEmptyDirs(versionsFs)","+","+\treturn nil","+}",""],"additions":90,"deletions":0,"truncated":false}],"additions":187,"deletions":46,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-25T18:25:06.773960+00:00"}