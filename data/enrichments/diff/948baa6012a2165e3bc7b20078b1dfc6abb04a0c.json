 .collect()"," }"," ","-/// Build the workspace [`ProjectGraph`] from `projects` under `options`.","-fn build_graph<'p>(","-    projects: &'p [Project],","-    options: CreateProjectsGraphOptions<'_>,","-) -> ProjectGraph<GraphPkg<'p>> {","-    create_projects_graph(","-        projects","-            .iter()","-            .map(|project| GraphPkg { project })","-            .collect(),","-        &options,","-    )","-    .graph","-}","-"," /// Parse `config`'s `--filter` and `--filter-prod` entries in evaluation order,"," /// appending `root_selector` (if any) with glob directory matching."," pub fn parse_configured_selectors(","@@ -479,31 +457,4 @@ pub fn recursive_filter_options(config: &Config, prefix: &Path) -> FilterWorkspa","     }"," }"," ","-fn production_filter_graph<'a>(","-    projects: &'a [Project],","-    config: &Config,","-    graph_options: CreateProjectsGraphOptions<'_>,","-) -> Option<ProjectGraph<GraphPkg<'a>>> {","-    if config.filter_prod.is_empty() {","-        None","-    } else {","-        Some(build_graph(","-            projects,","-            CreateProjectsGraphOptions { ignore_dev_deps: true, ..graph_options },","-        ))","-    }","-}","-","-/// Respect the configured linking policy when determining workspace edges.","-fn recursive_graph_options<'a>(","-    config: &'a Config,","-    catalogs: &'a Catalogs,","-) -> CreateProjectsGraphOptions<'a> {","-    CreateProjectsGraphOptions {","-        link_workspace_packages: Some(config.link_workspace_packages != LinkWorkspacePackages::Off),","-        catalogs: workspace_catalogs(config, catalogs),","-        ..CreateProjectsGraphOptions::default()","-    }","-}","-"," mod summary;"],"additions":6,"deletions":55,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/recursive/filter_graphs.rs","lines":["@@ -0,0 +1,66 @@","+//! Build the workspace dependency graphs a recursive run filters and sorts through.","+","+use crate::cli_args::catalogs::{configured_catalogs, workspace_catalogs};","+use miette::{Context, IntoDiagnostic};","+use pnpm_config::{Config, LinkWorkspacePackages};","+use pnpm_package_manager::overrides_dependency_rewriter;","+use pnpm_workspace::{GraphPkg, Project};","+use pnpm_workspace_projects_graph::{","+    CreateProjectsGraphOptions, DependencyRewriter, ProjectGraph, create_projects_graph,","+};","+use std::path::Path;","+","+/// The graph a recursive run resolves selection and order through, with","+/// the prod-pruned twin a `--filter-prod` selector is matched against.","+pub(super) struct FilterGraphs<'a> {","+    pub(super) all: ProjectGraph<GraphPkg<'a>>,","+    pub(super) prod_all: Option<ProjectGraph<GraphPkg<'a>>>,","+}","+","+/// Build the graphs [`super::select_recursive_projects`] filters and sorts through.","+///","+/// They follow the configured `link-workspace-packages` policy. Under the","+/// default `link-workspace-packages: false` a bare-semver range naming a","+/// sibling is not a workspace edge, so it drives neither selection nor","+/// order; only a `workspace:` range, an enabled policy, or an override","+/// pointing the dependency at the sibling links it.","+pub(super) fn build_filter_graphs<'a>(","+    projects: &'a [Project],","+    config: &Config,","+    prefix: &Path,","+) -> miette::Result<FilterGraphs<'a>> {","+    let workspace_dir = config.workspace_dir.as_deref().unwrap_or(prefix);","+    let catalogs = configured_catalogs(config)?;","+    let dependency_rewriter = overrides_dependency_rewriter(config, &catalogs, workspace_dir)","+        .into_diagnostic()","+        .wrap_err(\"parsing the overrides\")?;","+    let options = CreateProjectsGraphOptions {","+        link_workspace_packages: Some(config.link_workspace_packages != LinkWorkspacePackages::Off),","+        catalogs: workspace_catalogs(config, &catalogs),","+        dependency_rewriter: dependency_rewriter","+            .as_ref()","+            .map(|rewriter| rewriter as &dyn DependencyRewriter),","+        ..CreateProjectsGraphOptions::default()","+    };","+    Ok(FilterGraphs {","+        all: build_graph(projects, options),","+        prod_all: (!config.filter_prod.is_empty()).then(|| {","+            build_graph(projects, CreateProjectsGraphOptions { ignore_dev_deps: true, ..options })","+        }),","+    })","+}","+","+/// Build the workspace [`ProjectGraph`] from `projects` under `options`.","+fn build_graph<'p>(","+    projects: &'p [Project],","+    options: CreateProjectsGraphOptions<'_>,","+) -> ProjectGraph<GraphPkg<'p>> {","+    create_projects_graph(","+        projects","+            .iter()","+            .map(|project| GraphPkg { project })","+            .collect(),","+        &options,","+    )","+    .graph","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/recursive/selected_dirs.rs","lines":["@@ -1,8 +1,8 @@"," //! A recursive selection detached from the projects it was made over."," "," use super::{","-    RecursiveSelection, build_graph, build_selected_graph, configured_catalogs,","-    production_filter_graph, recursive_graph_options,","+    RecursiveSelection, build_selected_graph,","+    filter_graphs::{FilterGraphs, build_filter_graphs},"," };"," use pnpm_config::Config;"," use pnpm_workspace::Project;","@@ -39,15 +39,14 @@ impl SelectedProjectDirs {","     }"," ","     /// The selection over `projects`, with its graph edges taken from their","-    /// current manifests.","+    /// current manifests. `prefix` is where the command was invoked.","     pub fn select<'a>(","         &self,","         projects: &'a [Project],","         config: &Config,","+        prefix: &Path,","     ) -> miette::Result<RecursiveSelection<'a>> {","-        let catalogs = configured_catalogs(config)?;","-        let graph_options = recursive_graph_options(config, &catalogs);","-        let all = build_graph(projects, graph_options);","+        let FilterGraphs { all, prod_all } = build_filter_graphs(projects, config, prefix)?;","         if !self.narrowed {","             return Ok(RecursiveSelection {","                 selected: all,","@@ -56,7 +55,6 @@ impl SelectedProjectDirs {","                 prod_only_selected: HashSet::new(),","             });","         }","-        let prod_all = production_filter_graph(projects, config, graph_options);","         let selected =","             build_selected_graph(&all, prod_all.as_ref(), &self.selected, &self.prod_only_selected);","         Ok(RecursiveSelection {"],"additions":5,"deletions":7,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/exec_recursive.rs","lines":["@@ -1258,3 +1258,46 @@ fn recursive_exec_resumes_from_exactly_the_projects_that_passed_before_a_failure"," ","     drop(root);"," }","+","+/// Under the default `link-workspace-packages: false`, `app`'s `^1.0.0`","+/// range is not a workspace edge on its own; an override pointing it at","+/// the sibling makes `app...` select `lib` too.","+#[test]","+fn dependency_selector_follows_an_override_to_a_workspace_sibling() {","+    for override_key in [\"lib\", \"app>lib\"] {","+        let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+        write_workspace(&workspace, &[\"app\", \"lib\", \"other\"]);","+        let app_manifest =","+            json!({ \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"lib\": \"^1.0.0\" } });","+        fs::write(workspace.join(\"app/package.json\"), app_manifest.to_string())","+            .expect(\"write app/package.json\");","+        let workspace_yaml = fs::read_to_string(workspace.join(\"pnpm-workspace.yaml\"))","+            .expect(\"read pnpm-workspace.yaml\");","+        fs::write(","+            workspace.join(\"pnpm-workspace.yaml\"),","+            format!(\"{workspace_yaml}overrides:\\n  '{override_key}': 'workspace:*'\\n\"),","+        )","+        .expect(\"write pnpm-workspace.yaml\");","+","+        pacquet","+            .with_arg(\"--filter\")","+            .with_arg(\"app...\")","+            .with_arg(\"exec\")","+            .with_args(marker_args(\"ran.txt\"))","+            .assert()","+            .success();","+","+        for (name, selected) in [(\"app\", true), (\"lib\", true), (\"other\", false)] {","+            assert_eq!(","+                workspace","+                    .join(name)","+                    .join(\"ran.txt\")","+                    .exists(),","+                selected,","+                \"{name} selected with override key {override_key}\",","+            );","+        }","+","+        drop(root);","+    }","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/lifecycle_scripts/project_scripts_in_a_workspace.rs","lines":["@@ -305,3 +305,64 @@ fn add_in_a_member_does_not_save_manifest_when_preinstall_fails() {"," ","     drop((root, anchor));"," }","+","+/// A `prepare` that appends `name` to `order.txt` in the workspace","+/// root (`INIT_CWD`) after `delay_ms`.","+fn append_order_after(name: &str, delay_ms: u32) -> String {","+    format!(","+        r#\"node -e \"setTimeout(() => require('fs').appendFileSync(process.env.INIT_CWD + '/order.txt', '{name}\\n'), {delay_ms})\"\"#,","+    )","+}","+","+/// The dependency's script sleeps and the dependent's does not, so","+/// `order.txt` records the sequencing rather than the script","+/// durations: without the edge `app` would finish first.","+#[test]","+fn override_to_a_workspace_sibling_orders_the_project_scripts() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&yaml_path).expect(\"read pnpm-workspace.yaml\");","+    fs::write(","+        &yaml_path,","+        format!(","+            \"{}\\npackages:\\n  - 'packages/*'\\noverrides:\\n  lib: 'workspace:*'\\n\",","+            yaml.trim_end(),","+        ),","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(workspace.join(\"package.json\"), r#\"{ \"name\": \"root\" }\"#)","+        .expect(\"write the root package.json\");","+    for (dir, manifest) in [","+        (","+            \"lib\",","+            serde_json::json!({","+                \"name\": \"lib\",","+                \"version\": \"1.0.0\",","+                \"scripts\": { \"prepare\": append_order_after(\"lib\", 500) },","+            }),","+        ),","+        (","+            \"app\",","+            serde_json::json!({","+                \"name\": \"app\",","+                \"version\": \"1.0.0\",","+                \"dependencies\": { \"lib\": \"^1.0.0\" },","+                \"scripts\": { \"prepare\": append_order_after(\"app\", 0) },","+            }),","+        ),","+    ] {","+        let dir = workspace.join(\"packages\").join(dir);","+        fs::create_dir_all(&dir).expect(\"create the member dir\");","+        fs::write(dir.join(\"package.json\"), manifest.to_string())","+            .expect(\"write the member package.json\");","+    }","+","+    pacquet(&workspace, [\"install\"]).assert().success();","+","+    let order = fs::read_to_string(workspace.join(\"order.txt\")).expect(\"read order.txt\");","+    assert_eq!(order.lines().collect::<Vec<_>>(), [\"lib\", \"app\"]);","+","+    drop((root, npmrc_info));","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run/time_machine_capture.rs","lines":["@@ -1,13 +1,12 @@"," use super::{InstallScope, RunExecution};"," #[cfg(target_os = \"macos\")]","-use indexmap::IndexMap;","-#[cfg(target_os = \"macos\")]"," use pnpm_config::LinkWorkspacePackages;"," #[cfg(target_os = \"macos\")]"," use pnpm_package_manifest::{DependencyGroup, PackageManifest};"," #[cfg(target_os = \"macos\")]"," use pnpm_workspace_projects_graph::{","-    BaseProject, CreateProjectsGraphOptions, GraphProject, ProjectGraph, create_projects_graph,","+    BaseProject, CreateProjectsGraphOptions, DependencyGroups, GraphProject, ProjectGraph,","+    create_projects_graph,"," };"," #[cfg(target_os = \"macos\")]"," use std::{","@@ -137,17 +136,8 @@ impl BaseProject for CaptureProject<'_> {","             .and_then(|name| name.as_str())","     }"," ","-    fn merged_dependencies(&self, _: bool) -> Vec<(String, String)> {","-        let mut dependencies = IndexMap::new();","-        for (name, spec) in self.manifest.dependencies([","-            DependencyGroup::Peer,","-            DependencyGroup::Dev,","-            DependencyGroup::Optional,","-            DependencyGroup::Prod,","-        ]) {","-            dependencies.insert(name.to_string(), spec.to_string());","-        }","-        dependencies.into_iter().collect()","+    fn merged_dependencies(&self, ignore_dev_deps: bool) -> Vec<(String, String)> {","+        self.dependency_groups(ignore_dev_deps).merge()","     }"," }"," ","@@ -159,6 +149,21 @@ impl GraphProject for CaptureProject<'_> {","             .get(\"version\")","             .and_then(|version| version.as_str())","     }","+","+    fn dependency_groups(&self, ignore_dev_deps: bool) -> DependencyGroups {","+        let declared = |group: DependencyGroup| {","+            self.manifest","+                .dependencies([group])","+                .map(|(name, spec)| (name.to_string(), spec.to_string()))","+                .collect()","+        };","+        DependencyGroups {","+            peer: declared(DependencyGroup::Peer),","+            dev: (!ignore_dev_deps).then(|| declared(DependencyGroup::Dev)),","+            optional: declared(DependencyGroup::Optional),","+            prod: declared(DependencyGroup::Prod),","+        }","+    }"," }"," "," #[cfg(not(target_os = \"macos\"))]"],"additions":19,"deletions":14,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run/workspace.rs","lines":["@@ -463,7 +463,8 @@ pub(super) fn report_install_scope_cycles<Reporter: self::Reporter>(","         catalogs: &workspace.catalogs,","         workspace_dir,","     };","-    let cycles = crate::install_scope_cycles(config, projects, selected_dirs, Some(catalogs));","+    let cycles = crate::install_scope_cycles(config, projects, selected_dirs, catalogs)","+        .map_err(InstallError::InvalidOverrides)?;","     crate::report_workspace_cycles::<Reporter>(config, workspace_dir, cycles.as_deref())","         .map_err(InstallError::CyclicWorkspaceDependencies)"," }"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides.rs","lines":["@@ -10,8 +10,10 @@"," //! happens through [`pnpm_package_manifest::PackageManifest::value_mut`]"," //! on the in-memory `Value` only."," ","+pub use dependency_rewriter::overrides_dependency_rewriter;"," pub(crate) use selectors::{matches_target, parse_declared_range};"," ","+mod dependency_rewriter;"," mod meta_only_peers;"," mod selectors;"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides/dependency_rewriter.rs","lines":["@@ -0,0 +1,91 @@","+use crate::overrides::VersionsOverrider;","+use pnpm_catalogs_types::Catalogs;","+use pnpm_config::Config;","+use pnpm_config_parse_overrides::ParseOverridesError;","+use pnpm_package_manifest::DependencyGroup;","+use pnpm_workspace_projects_graph::{DependencyGroups, DependencyRewriter, GraphProject};","+use serde_json::Value;","+use std::path::Path;","+","+/// The `pnpm.overrides` hook the workspace projects graph applies, so an","+/// override that points a dependency at a workspace sibling becomes an","+/// edge the graph orders by. `Ok(None)` when no overrides are configured.","+/// `catalogs` dereferences `catalog:` override values, the same set the","+/// install resolves against.","+///","+/// Relative `link:` / `file:` override targets are anchored where the","+/// install anchors them, [`Config::root_project_manifest_dir`] with","+/// `workspace_dir` as the fallback.","+pub fn overrides_dependency_rewriter(","+    config: &Config,","+    catalogs: &Catalogs,","+    workspace_dir: &Path,","+) -> Result<Option<VersionsOverrider>, ParseOverridesError> {","+    let Some(map) = config.overrides","+        .as_ref()","+        .filter(|map| !map.is_empty())","+    else {","+        return Ok(None);","+    };","+    let parsed = pnpm_config_parse_overrides::parse_overrides_iter(map.iter(), catalogs)?;","+    let root_dir = config.root_project_manifest_dir(workspace_dir);","+    Ok(Some(VersionsOverrider::new(&parsed, root_dir).with_catalogs(catalogs)))","+}","+","+impl DependencyRewriter for VersionsOverrider {","+    /// Runs the groups through [`Self::apply_to_value`] as the dependency","+    /// fields of a manifest carrying the project's name and version, so","+    /// every override (parent-scoped, range-scoped, or scoped to one","+    /// dependency field) applies as it does to the manifest during","+    /// resolution.","+    fn rewrite_dependencies(&self, project: &dyn GraphProject, groups: &mut DependencyGroups) {","+        if self.is_empty() {","+            return;","+        }","+        let mut manifest = serde_json::Map::new();","+        if let Some(name) = project.manifest_name() {","+            manifest.insert(\"name\".to_string(), Value::String(name.to_string()));","+        }","+        if let Some(version) = project.manifest_version() {","+            manifest.insert(\"version\".to_string(), Value::String(version.to_string()));","+        }","+        insert_group(&mut manifest, DependencyGroup::Peer, &groups.peer);","+        if let Some(dev) = &groups.dev {","+            insert_group(&mut manifest, DependencyGroup::Dev, dev);","+        }","+        insert_group(&mut manifest, DependencyGroup::Optional, &groups.optional);","+        insert_group(&mut manifest, DependencyGroup::Prod, &groups.prod);","+        let mut manifest = Value::Object(manifest);","+        self.apply_to_value(&mut manifest, Some(project.root_dir()));","+        groups.peer = read_group(&manifest, DependencyGroup::Peer);","+        if groups.dev.is_some() {","+            groups.dev = Some(read_group(&manifest, DependencyGroup::Dev));","+        }","+        groups.optional = read_group(&manifest, DependencyGroup::Optional);","+        groups.prod = read_group(&manifest, DependencyGroup::Prod);","+    }","+}","+","+fn insert_group(","+    manifest: &mut serde_json::Map<String, Value>,","+    group: DependencyGroup,","+    dependencies: &[(String, String)],","+) {","+    let map: serde_json::Map<_, _> = dependencies","+        .iter()","+        .map(|(name, spec)| (name.clone(), Value::String(spec.clone())))","+        .collect();","+    let key: &'static str = group.into();","+    manifest.insert(key.to_string(), map.into());","+}","+","+fn read_group(manifest: &Value, group: DependencyGroup) -> Vec<(String, String)> {","+    let key: &'static str = group.into();","+    manifest","+        .get(key)","+        .and_then(Value::as_object)","+        .into_iter()","+        .flatten()","+        .filter_map(|(name, spec)| Some((name.clone(), spec.as_str()?.to_string())))","+        .collect()","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/overrides/tests.rs","lines":["@@ -2,6 +2,9 @@ use super::VersionsOverrider;"," use pnpm_catalogs_types::Catalogs;"," use pnpm_config_parse_overrides::parse_overrides_iter;"," use pnpm_package_manifest::PackageManifest;","+use pnpm_workspace_projects_graph::{","+    BaseProject, DependencyGroups, DependencyRewriter, GraphProject,","+};"," use serde_json::{Value, json};"," use std::path::{Path, PathBuf};"," ","@@ -570,7 +573,6 @@ fn override_for_undeclared_dependency_applies_converge_only_within_range() {","     assert_eq!(undeclared(&overrider, \"react\", \"^19.0.0\"), None);","     assert!(overrider.converge_declared_ranges().is_empty());"," }","-"," /// An override is written once, at the workspace root, and applied to"," /// every package that matches. A bare path has to move with it the way"," /// its `link:` spelling does, or it names a directory inside whichever","@@ -865,3 +867,122 @@ fn version_scoped_override_matches_catalog_dependency_by_catalog_specifier() {","     assert_eq!(undeclared(&overrider, \"ms\", \"catalog:\").as_deref(), Some(\"2.1.1\"));","     assert_eq!(undeclared(&overrider, \"ms\", \"catalog:legacy\"), None);"," }","+","+/// A workspace project as [`crate::overrides_dependency_rewriter`]'s","+/// hook sees it: a root dir, the manifest's `name` / `version`, and its","+/// dependency groups.","+struct GraphProjectFixture {","+    root_dir: PathBuf,","+    name: String,","+    groups: DependencyGroups,","+}","+","+impl BaseProject for GraphProjectFixture {","+    fn root_dir(&self) -> &Path {","+        &self.root_dir","+    }","+","+    fn manifest_name(&self) -> Option<&str> {","+        Some(&self.name)","+    }","+}","+","+impl GraphProject for GraphProjectFixture {","+    fn manifest_version(&self) -> Option<&str> {","+        Some(\"1.0.0\")","+    }","+","+    fn dependency_groups(&self, _ignore_dev_deps: bool) -> DependencyGroups {","+        self.groups.clone()","+    }","+}","+","+fn pairs(dependencies: &[(&str, &str)]) -> Vec<(String, String)> {","+    dependencies","+        .iter()","+        .map(|(name, spec)| ((*name).to_string(), (*spec).to_string()))","+        .collect()","+}","+","+/// The merged dependency list `overrider` rewrites for the project `name`","+/// at `/workspace/packages/<name>`.","+fn rewritten(","+    overrider: &VersionsOverrider,","+    name: &str,","+    groups: DependencyGroups,","+) -> Vec<(String, String)> {","+    let project = GraphProjectFixture {","+        root_dir: PathBuf::from(\"/workspace/packages\").join(name),","+        name: name.to_string(),","+        groups,","+    };","+    let mut groups = project.dependency_groups(false);","+    overrider.rewrite_dependencies(&project, &mut groups);","+    groups.merge()","+}","+","+fn prod_only(dependencies: &[(&str, &str)]) -> DependencyGroups {","+    DependencyGroups { prod: pairs(dependencies), ..DependencyGroups::default() }","+}","+","+#[test]","+fn rewrite_dependencies_applies_workspace_and_local_protocol_overrides() {","+    let overrides =","+        parsed(&[(\"lib\", \"workspace:*\"), (\"qar\", \"link:./packages/qar\"), (\"baz\", \"file:../baz\")]);","+    let overrider = VersionsOverrider::new(&overrides, Path::new(\"/workspace\"));","+","+    assert_eq!(","+        rewritten(","+            &overrider,","+            \"app\",","+            prod_only(&[(\"lib\", \"^1.0.0\"), (\"qar\", \"^2.0.0\"), (\"baz\", \"^3.0.0\")]),","+        ),","+        pairs(&[(\"lib\", \"workspace:*\"), (\"qar\", \"link:../qar\"), (\"baz\", \"file:../../../baz\")]),","+    );","+}","+","+#[test]","+fn rewrite_dependencies_drops_deleted_dependencies() {","+    let overrides = parsed(&[(\"qar\", \"-\")]);","+    let overrider = VersionsOverrider::new(&overrides, Path::new(\"/workspace\"));","+","+    assert_eq!(","+        rewritten(&overrider, \"app\", prod_only(&[(\"lib\", \"^1.0.0\"), (\"qar\", \"^2.0.0\")])),","+        pairs(&[(\"lib\", \"^1.0.0\")]),","+    );","+}","+","+#[test]","+fn rewrite_dependencies_applies_a_parent_scoped_override_to_its_parent_only() {","+    let overrides = parsed(&[(\"app>lib\", \"workspace:*\")]);","+    let overrider = VersionsOverrider::new(&overrides, Path::new(\"/workspace\"));","+","+    assert_eq!(","+        rewritten(&overrider, \"app\", prod_only(&[(\"lib\", \"^1.0.0\")])),","+        pairs(&[(\"lib\", \"workspace:*\")]),","+    );","+    assert_eq!(","+        rewritten(&overrider, \"other\", prod_only(&[(\"lib\", \"^1.0.0\")])),","+        pairs(&[(\"lib\", \"^1.0.0\")]),","+    );","+}","+","+#[test]","+fn rewrite_dependencies_applies_a_dependency_type_selector_to_its_group_only() {","+    let overrides = parsed(&[(\"lib:optional\", \"workspace:*\")]);"],"additions":106,"deletions":1,"truncated":false}],"additions":430,"deletions":87,"trunc