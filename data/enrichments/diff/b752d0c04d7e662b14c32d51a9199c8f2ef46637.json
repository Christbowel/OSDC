{"id":"b752d0c04d7e662b14c32d51a9199c8f2ef46637","axis":"silent","repo":"leaflet/leaflet","sha":"b752d0c04d7e662b14c32d51a9199c8f2ef46637","parsed":{"files":[{"path":"spec/suites/core/ClassSpec.js","lines":["@@ -1,7 +1,31 @@","-import {Class, Evented, Layer, Marker} from 'leaflet';","+import * as L from 'leaflet';","+import {Class, Evented, Layer, LeafletMap, Polygon, Marker} from 'leaflet';"," import sinon from 'sinon';","+import {createContainer, removeMapContainer} from '../SpecHelper.js';","+","+const ownConstructorRe = /^\\s*constructor\\s*\\(/m;"," "," describe('Class', () => {","+\tdescribe('constructor', () => {","+\t\tit('throws on a class that defines initialize()', () => {","+\t\t\tclass OldStyle extends Class {","+\t\t\t\tinitialize() {}","+\t\t\t}","+\t\t\texpect(() => new OldStyle()).to.throw('OldStyle: initialize() is not called');","+\t\t});","+","+\t\tit('throws when initialize() is called from a constructor', () => {","+\t\t\tclass HalfPorted extends Class {","+\t\t\t\tconstructor() {","+\t\t\t\t\tsuper();","+\t\t\t\t\tthis.initialize();","+\t\t\t\t}","+\t\t\t\tinitialize() {}","+\t\t\t}","+\t\t\texpect(() => new HalfPorted()).to.throw('Rename it to constructor()');","+\t\t});","+\t});","+"," \tdescribe('defaultOptions', () => {"," \t\tit('inherits and overrides parent defaults', () => {"," \t\t\tclass Klass1 extends Class {","@@ -181,8 +205,9 @@ describe('Class', () => {"," "," \t\t\tnew Class2();"," ","-\t\t\texpect(spy1.called).to.be.true;","-\t\t\texpect(spy2.called).to.be.true;","+\t\t\texpect(spy1.calledOnce).to.be.true;","+\t\t\texpect(spy2.calledOnce).to.be.true;","+\t\t\texpect(spy1.calledBefore(spy2)).to.be.true;"," \t\t});"," "," \t\tit('does not call child constructor hooks', () => {","@@ -200,5 +225,159 @@ describe('Class', () => {"," \t\t\texpect(spy1.called).to.be.true;"," \t\t\texpect(spy2.called).to.eql(false);"," \t\t});","+","+\t\tit('calls a method by name with arguments', () => {","+\t\t\tconst spy = sinon.spy();","+","+\t\t\tclass Klass extends Class {","+\t\t\t\tfoo(...args) { spy(this, ...args); }","+\t\t\t}","+\t\t\tKlass.addInitHook('foo', 1, 2);","+","+\t\t\tconst a = new Klass();","+\t\t\texpect(spy.calledOnceWith(a, 1, 2)).to.be.true;","+\t\t});","+","+\t\tit('runs hooks added after the first instance was created', () => {","+\t\t\tconst spy = sinon.spy();","+","+\t\t\tclass Klass extends Class {}","+\t\t\tnew Klass();","+\t\t\tKlass.addInitHook(spy);","+\t\t\tnew Klass();","+","+\t\t\texpect(spy.calledOnce).to.be.true;","+\t\t});","+","+\t\tit('runs hooks after the constructor of the deepest marked class', () => {","+\t\t\tconst log = [];","+","+\t\t\tclass Class1 extends Class {","+\t\t\t\tstatic initHooks = true;","+\t\t\t\tconstructor() {","+\t\t\t\t\tsuper();","+\t\t\t\t\tlog.push('Class1');","+\t\t\t\t\tthis.callInitHooks();","+\t\t\t\t}","+\t\t\t}","+\t\t\tclass Class2 extends Class1 {","+\t\t\t\tstatic initHooks = true;","+\t\t\t\tconstructor() {","+\t\t\t\t\tsuper();","+\t\t\t\t\tlog.push('Class2');","+\t\t\t\t\tthis.callInitHooks();","+\t\t\t\t}","+\t\t\t}","+\t\t\tclass Class3 extends Class2 {","+\t\t\t\tconstructor() {","+\t\t\t\t\tsuper();","+\t\t\t\t\tlog.push('Class3');","+\t\t\t\t}","+\t\t\t}","+\t\t\tClass1.addInitHook(() => log.push('hook1'));","+\t\t\tClass3.addInitHook(() => log.push('hook3'));","+","+\t\t\tnew Class3();","+\t\t\texpect(log).to.eql(['Class1', 'Class2', 'hook1', 'hook3', 'Class3']);","+\t\t});","+","+\t\tit('runs hooks once per instance when a hook creates another instance', () => {","+\t\t\tconst spy = sinon.spy();","+\t\t\tlet nested;","+","+\t\t\tclass Klass extends Class {}","+\t\t\tKlass.addInitHook(function () {","+\t\t\t\tspy(this);","+\t\t\t\tif (spy.callCount === 1) {","+\t\t\t\t\tnested = new Klass();","+\t\t\t\t}","+\t\t\t});","+","+\t\t\tconst a = new Klass();","+\t\t\texpect(spy.callCount).to.eql(2);","+\t\t\texpect(spy.calledWith(a)).to.be.true;","+\t\t\texpect(spy.calledWith(nested)).to.be.true;","+\t\t});","+","+\t\tit('runs a Layer hook on a fully built Polygon, once', () => {","+\t\t\tconst spy = sinon.spy();","+\t\t\tlet enabled = true;","+","+\t\t\tLayer.addInitHook(function () {","+\t\t\t\tif (enabled) { spy(this._latlngs); }","+\t\t\t});","+\t\t\tnew Polygon([[0, 0], [0, 1], [1, 1]]);","+\t\t\tenabled = false;","+","+\t\t\texpect(spy.calledOnce).to.be.true;","+\t\t\texpect(spy.firstCall.args[0]).to.not.be.undefined;","+\t\t});","+","+\t\tit('adds one zoom control to a map subclass', () => { // #10294","+\t\t\tclass NewMap extends LeafletMap {}","+\t\t\tconst container = createContainer();","+\t\t\tconst map = new NewMap(container);","+","+\t\t\texpect(container.querySelectorAll('.leaflet-control-zoom').length).to.eql(1);","+\t\t\texpect(map.dragging).to.be.ok;","+","+\t\t\tremoveMapContainer(map, container);","+\t\t});","+\t});","+","+\tdescribe('built-in classes', () => {","+\t\tconst classes = Object.entries(L)","+\t\t\t.filter(([, value]) => typeof value === 'function' && value.prototype instanceof Class);","+","+\t\tconst hasOwnConstructor = Cls => ownConstructorRe.test(Function.prototype.toString.call(Cls));","+","+\t\tit('mark every class with its own constructor with initHooks', () => {","+\t\t\tconst unmarked = classes","+\t\t\t\t.filter(([, Cls]) => hasOwnConstructor(Cls) && !Object.hasOwn(Cls, 'initHooks'))","+\t\t\t\t.map(([name]) => name);","+\t\t\texpect(unmarked).to.eql([]);","+\t\t});","+","+\t\tit('run a hook on Class exactly once per instance', () => {","+\t\t\tconst container = createContainer();","+\t\t\tconst map = new LeafletMap(container);","+\t\t\tconst marker = new Marker([0, 0]).addTo(map);","+","+\t\t\tconst args = {","+\t\t\t\tLeafletMap: () => [createContainer()],","+\t\t\t\tMap: () => [createContainer()],","+\t\t\t\tMarker: () => [[0, 0]],","+\t\t\t\tCircleMarker: () => [[0, 0]],","+\t\t\t\tCircle: () => [[0, 0], {radius: 10}],","+\t\t\t\tPolyline: () => [[[0, 0], [1, 1]]],","+\t\t\t\tPolygon: () => [[[0, 0], [1, 1], [1, 0]]],","+\t\t\t\tRectangle: () => [[[0, 0], [1, 1]]],","+\t\t\t\tImageOverlay: () => ['', [[0, 0], [1, 1]]],","+\t\t\t\tVideoOverlay: () => ['', [[0, 0], [1, 1]]],","+\t\t\t\tSVGOverlay: () => [document.createElementNS('http://www.w3.org/2000/svg', 'svg'), [[0, 0], [1, 1]]],","+\t\t\t\tTileLayer: () => [''],","+\t\t\t\tWMSTileLayer: () => ['', {}],","+\t\t\t\tDraggable: () => [document.createElement('div')],","+\t\t\t\tMarkerDrag: () => [marker],","+\t\t\t};","+","+\t\t\tconst runs = new Map();","+\t\t\tlet recording = true;","+\t\t\tClass.addInitHook(function () {","+\t\t\t\tif (recording) { runs.set(this, (runs.get(this) ?? 0) + 1); }","+\t\t\t});","+","+\t\t\tconst failed = [];","+\t\t\tfor (const [name, Cls] of classes) {","+\t\t\t\tconst instance = new Cls(...(args[name]?.() ?? (Cls.prototype instanceof L.Handler ? [map] : [])));","+\t\t\t\tif (runs.get(instance) !== 1) { failed.push(`${name}: ${runs.get(instance) ?? 0}`); }","+\t\t\t\tif (instance instanceof LeafletMap) { instance.remove(); }","+\t\t\t}","+\t\t\trecording = false;","+","+\t\t\texpect(failed).to.eql([]);","+","+\t\t\tremoveMapContainer(map, container);","+\t\t});"," \t});"," });"],"additions":182,"deletions":3,"truncated":false},{"path":"src/control/AttributionControl.js","lines":["@@ -19,6 +19,8 @@ const ukrainianFlag = '<svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg"," // Creates an attribution control."," export class AttributionControl extends Control {"," ","+\tstatic initHooks = true;","+"," \t// @section"," \t// @aka AttributionControl options"," \tstatic defaultOptions = {","@@ -32,10 +34,11 @@ export class AttributionControl extends Control {"," \t\tprefix: `<a target=\"_blank\" href=\"https://leafletjs.com\" title=\"A JavaScript library for interactive maps\">${ukrainianFlag}Leaflet</a>`"," \t};"," ","-\tinitialize(options) {","-\t\tsuper.initialize(options);","+\tconstructor(options) {","+\t\tsuper(options);"," "," \t\tthis._attributions = {};","+\t\tthis.callInitHooks();"," \t}"," "," \tonAdd(map) {"],"additions":5,"deletions":2,"truncated":false},{"path":"src/control/Control.js","lines":["@@ -14,6 +14,8 @@ import * as DomUtil from '../dom/DomUtil.js';"," "," export class Control extends Class {"," ","+\tstatic initHooks = true;","+"," \t// @section"," \t// @aka Control Options"," \tstatic defaultOptions = {","@@ -24,8 +26,10 @@ export class Control extends Class {"," \t};"," "," ","-\tinitialize(options) {","+\tconstructor(options) {","+\t\tsuper();"," \t\tUtil.setOptions(this, options);","+\t\tthis.callInitHooks();"," \t}"," "," \t/* @section"],"additions":5,"deletions":1,"truncated":false},{"path":"src/control/LayersControl.js","lines":["@@ -46,6 +46,8 @@ import * as DomUtil from '../dom/DomUtil.js';"," // Creates a layers control with the given layers. Base layers will be switched with radio buttons, while overlays will be switched with checkboxes. Note that all base layers should be passed in the base layers object, but only one should be added to the map during map instantiation."," export class LayersControl extends Control {"," ","+\tstatic initHooks = true;","+"," \t// @section"," \t// @aka LayersControl options"," \tstatic defaultOptions = {","@@ -83,8 +85,8 @@ export class LayersControl extends Control {"," \t\t}"," \t};"," ","-\tinitialize(baseLayers, overlays, options) {","-\t\tsuper.initialize(options);","+\tconstructor(baseLayers, overlays, options) {","+\t\tsuper(options);"," "," \t\tthis._layerControlInputs = [];"," \t\tthis._layers = [];","@@ -99,6 +101,8 @@ export class LayersControl extends Control {"," \t\tfor (const [name, layer] of Object.entries(overlays ?? {})) {"," \t\t\tthis._addLayer(layer, name, true);"," \t\t}","+","+\t\tthis.callInitHooks();"," \t}"," "," \tonAdd(map) {"],"additions":6,"deletions":2,"truncated":false},{"path":"src/core/Class.js","lines":["@@ -5,9 +5,31 @@ import * as Util from './Util.js';"," // @section"," // @uninheritable"," ","-// Thanks to John Resig and Dean Edwards for inspiration!","+let hooksVersion = 0;","+const ownHooks = new WeakMap(); // class -> hooks added to that class directly","+const hookPlans = new WeakMap(); // class -> {version, runners, hooks} for its whole chain","+","+// Counts the classes in the chain that end their constructor with `callInitHooks()` and collects their hooks,","+// parents first. Cached per class until the next `addInitHook` call.","+function getHookPlan(cls) {","+\tlet plan = hookPlans.get(cls);","+\tif (plan?.version !== hooksVersion) {","+\t\tplan = {version: hooksVersion, runners: 0, hooks: []};","+\t\tfor (let c = cls; c !== Function.prototype; c = Object.getPrototypeOf(c)) {","+\t\t\tif (Object.hasOwn(c, 'initHooks') && c.initHooks) { plan.runners++; }","+\t\t\tplan.hooks.unshift(...(ownHooks.get(c) ?? []));","+\t\t}","+\t\thookPlans.set(cls, plan);","+\t}","+\treturn plan;","+}"," "," export class Class {","+\t// @property initHooks: Boolean","+\t// Marks a class whose constructor ends with `this.callInitHooks()`. Set it as `static initHooks = true` on","+\t// a plugin class whose own [constructor hooks](#class-constructor-hooks) need its constructor to run first.","+\tstatic initHooks = true;","+"," \t// @function include(properties: Object): this"," \t// [Includes a mixin](#class-includes) into the current class."," \tstatic include(props) {","@@ -52,54 +74,37 @@ export class Class {"," \t// @function addInitHook(fn: Function): this"," \t// Adds a [constructor hook](#class-constructor-hooks) to the class."," \tstatic addInitHook(fn, ...args) { // (Function) || (String, args...)","-\t\tconst init = typeof fn === 'function' ? fn : function () {","+\t\tconst hook = typeof fn === 'function' ? fn : function () {"," \t\t\tthis[fn](...args);"," \t\t};","-","-\t\tif (!Object.hasOwn(this.prototype, '_initHooks')) { // do not use ??= here","-\t\t\tthis.prototype._initHooks = [];","+\t\tif (!ownHooks.has(this)) {","+\t\t\townHooks.set(this, []);"," \t\t}","-\t\tthis.prototype._initHooks.push(init);","+\t\townHooks.get(this).push(hook);","+\t\thooksVersion++;"," \t\treturn this;"," \t}"," ","-\tconstructor(...args) {","-\t\tthis._initHooksCalled = false;","-","-\t\tUtil.setOptions(this);","-","-\t\t// call the constructor","+\tconstructor() {"," \t\tif (this.initialize) {","-\t\t\tthis.initialize(...args);","+\t\t\tthrow new Error(`${this.constructor.name}: initialize() is not called in Leaflet 2. ` +","+\t\t\t\t'Rename it to constructor() and call super() at its start.');"," \t\t}"," ","-\t\t// call all constructor hooks","+\t\tUtil.setOptions(this);","+","+\t\tthis._initHooksLeft = getHookPlan(this.constructor).runners;"," \t\tthis.callInitHooks();"," \t}"," ","+\t// @method callInitHooks()","+\t// Called at the end of the constructor of every class with `static initHooks = true`. The last of these","+\t// calls, from the deepest such class, runs all hooks of the chain once, so they see a fully built instance."," \tcallInitHooks() {","-\t\tif (this._initHooksCalled) {","-\t\t\treturn;","-\t\t}","-","-\t\t// collect all prototypes in chain","-\t\tconst prototypes = [];","-\t\tlet current = this;","-","-\t\twhile ((current = Object.getPrototypeOf(current)) !== null) {","-\t\t\tprototypes.push(current);","-\t\t}","-","-\t\t// reverse so the parent prototype is first","-\t\tprototypes.reverse();","-","-\t\t// call init hooks on each prototype","-\t\tfor (const proto of prototypes) {","-\t\t\tfor (const hook of proto._initHooks ?? []) {","+\t\tif (--this._initHooksLeft === 0) {","+\t\t\tfor (const hook of getHookPlan(this.constructor).hooks) {"," \t\t\t\thook.call(this);"," \t\t\t}"," \t\t}","-","-\t\tthis._initHooksCalled = true;"," \t}"," }"],"additions":39,"deletions":34,"truncated":false},{"path":"src/core/Class.leafdoc","lines":["@@ -1,18 +1,17 @@","-"," @class Class"," ","-Class powers the OOP facilities of Leaflet and is used to create almost all of the Leaflet classes documented here.","+Class is the base of `Evented`, `Handler`, `Icon` and `Control`, and through them of almost all of the Leaflet classes documented here."," ","-It implements a simple classical inheritance model using JavaScript's standard `extends` keyword, and introduces several special properties for convenient code organization — options and init hooks.","+Leaflet classes are plain JavaScript classes: extend them with `extends` and put setup code in `constructor()`, after calling `super()`. Class adds what plugins need on top of that: default options, mixins and constructor hooks."," "," "," @example"," "," ```js"," class MyClass extends Class {","-    initialize(greeter) {","+    constructor(greeter) {","+        super();","         this.greeter = greeter;","-        // class constructor","     }"," ","     greet(name) {","@@ -27,6 +26,8 @@ const a = new MyClass(\"Hello\");"," a.greet(\"World\");"," ```"," ","+Leaflet 1.x classes used an `initialize()` method instead of `constructor()`. Constructing a class that still has an `initialize()` method throws an error.","+"," @section Options"," @example"," ","@@ -70,7 +71,8 @@ class MyClass extends Class {","         bla: 5","     };"," ","-    initialize(options) {","+    constructor(options) {","+        super();","         Util.setOptions(this, options);","         ...","     }","@@ -112,7 +114,7 @@ a.foo();"," If you're a plugin developer, you often need to add additional initialization code to existing classes (e.g. editing hooks for `Polyline`). Leaflet comes with a way to do it easily using the `addInitHook` method:"," "," ```js","-MyClass.addInitHook(() => {","+MyClass.addInitHook(function () {","     // ... do something in constructor additionally","     // e.g. add event listeners, set custom properties etc."," });","@@ -123,3 +125,20 @@ You can also use the following shortcut when you just need to make one additiona"," ```js"," MyClass.addInitHook('methodName', arg1, arg2, …);"," ```","+","+Hooks added to a class also run for instances of its subclasses, parent class hooks first, and each hook runs once per instance. For Leaflet's own classes, they run after the constructor has finished, so a hook added to `Layer` sees a fully built `Polygon`. For a class of your own that extends a Leaflet class, they run before the constructor body of your class.","+","+If other code adds hooks to a class of yours and these hooks need the constructor of your class to have run, mark the class with `static initHooks = true` and end its constructor with `this.callInitHooks()`:","+","+```js","+class MyLayer extends Layer {","+    static initHooks = true;","+","+    constructor(options) {","+        super();","+        Util.setOptions(this, options);","+        this._items = [];","+        this.callInitHooks();","+    }","+}","+```"],"additions":26,"deletions":7,"truncated":false},{"path":"src/core/Handler.js","lines":["@@ -9,8 +9,12 @@ import {Class} from './Class.js';"," // Abstract class for map interaction handlers"," "," export class Handler extends Class {","-\tinitialize(map) {","+\tstatic initHooks = true;","+","+\tconstructor(map) {","+\t\tsuper();"," \t\tthis._map = map;","+\t\tthis.callInitHooks();"," \t}"," "," \t// @method enable(): this"],"additions":5,"deletions":1,"truncated":false},{"path":"src/dom/Draggable.js","lines":["@@ -21,6 +21,8 @@ import * as PointerEvents from './DomEvent.PointerEvents.js';"," "," export class Draggable extends Evented {"," ","+\tstatic initHooks = true;","+"," \tstatic defaultOptions = {"," \t\t// @section"," \t\t// @aka Draggable options","@@ -32,12 +34,16 @@ export class Draggable extends Evented {"," "," \t// @constructor Draggable(el: HTMLElement, dragHandle?: HTMLElement, preventOutline?: Boolean, options?: Draggable options)"," \t// Creates a `Draggable` object for moving `el` when you start dragging the `dragHandle` element (equals `el` itself by default).","-\tinitialize(element, dragStartTarget, preventOutline, options) {","+\tconstructor(element, dragStartTarget, preventOutline, options) {","+\t\tsuper();","+"," \t\tUtil.setOptions(this, options);"," "," \