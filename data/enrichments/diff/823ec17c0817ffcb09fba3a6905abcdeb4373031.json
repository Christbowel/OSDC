writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.apache.tika.parser.microsoft;","+","+import java.util.ArrayList;","+import java.util.List;","+","+import org.xml.sax.SAXException;","+","+import org.apache.tika.parser.microsoft.FormattingUtils.Tag;","+import org.apache.tika.sax.XHTMLContentHandler;","+","+/**","+ * Spreadsheet cell text with superscript or subscript in it: runs of text, each","+ * plain or {@link Tag#SUP}/{@link Tag#SUB}, rendered as {@code <sup>}/{@code <sub>}.","+ * Adjacent runs with the same tag are joined, so a cell split into several font","+ * runs that are all superscript gives one {@code <sup>}.","+ */","+public class ScriptedTextCell implements Cell {","+","+    private final List<Run> runs = new ArrayList<>();","+","+    /**","+     * @param tag {@link Tag#SUP}, {@link Tag#SUB}, or {@code null} for plain text","+     */","+    public ScriptedTextCell append(String text, Tag tag) {","+        if (text == null || text.isEmpty()) {","+            return this;","+        }","+        int last = runs.size() - 1;","+        if (last >= 0 && runs.get(last).tag == tag) {","+            runs.get(last).text.append(text);","+        } else {","+            runs.add(new Run(new StringBuilder(text), tag));","+        }","+        return this;","+    }","+","+    public boolean hasScript() {","+        for (Run run : runs) {","+            if (run.tag != null) {","+                return true;","+            }","+        }","+        return false;","+    }","+","+    public boolean isEmpty() {","+        return runs.isEmpty();","+    }","+","+    /**","+     * Trims whitespace off both ends of the text, as {@link String#trim()} does for","+     * a {@link TextCell}; runs left empty are dropped.","+     */","+    public ScriptedTextCell trim() {","+        // drop whitespace-only runs in one subList clear each end, not remove(0) per run","+        int first = 0;","+        int start = 0;","+        for (; first < runs.size(); first++) {","+            StringBuilder text = runs.get(first).text;","+            start = 0;","+            while (start < text.length() && text.charAt(start) <= ' ') {","+                start++;","+            }","+            if (start < text.length()) {","+                break;","+            }","+        }","+        if (first == runs.size()) {","+            runs.clear();","+            return this;","+        }","+        runs.get(first).text.delete(0, start);","+        runs.subList(0, first).clear();","+","+        int last = runs.size() - 1;","+        int end = 0;","+        for (; last >= 0; last--) {","+            StringBuilder text = runs.get(last).text;","+            end = text.length();","+            while (end > 0 && text.charAt(end - 1) <= ' ') {","+                end--;","+            }","+            if (end > 0) {","+                break;","+            }","+        }","+        // the first run has non-whitespace, so last >= 0","+        runs.get(last).text.setLength(end);","+        runs.subList(last + 1, runs.size()).clear();","+        return this;","+    }","+","+    @Override","+    public void render(XHTMLContentHandler handler) throws SAXException {","+        for (Run run : runs) {","+            if (run.tag == null) {","+                handler.characters(run.text.toString());","+            } else {","+                handler.startElement(run.tag.tagName());","+                handler.characters(run.text.toString());","+                handler.endElement(run.tag.tagName());","+            }","+        }","+    }","+","+    /**","+     * @param vertAlign a SpreadsheetML {@code vertAlign} {@code val}","+     * @return {@link Tag#SUP}, {@link Tag#SUB}, or {@code null} for baseline","+     */","+    public s