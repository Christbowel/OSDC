 getScriptTag(cell);","+            if (unicode.getFormatRunCount() == 0 && cellTag == null) {","+                return null;","+            }","+            List<FormatRun> formatRuns =","+                    sstFormatRuns.computeIfAbsent(cell.getSSTIndex(), i -> formatRuns(unicode));","+","+            String string = unicode.getString();","+            ScriptedTextCell text = new ScriptedTextCell();","+            int pos = 0;","+            Tag tag = cellTag;","+            for (FormatRun formatRun : formatRuns) {","+                int start = formatRun.getCharacterPos() & 0xFFFF;","+                if (start > pos) {","+                    text.append(string.substring(pos, start), tag);","+                    pos = start;","+                }","+                tag = getFontScriptTag(formatRun.getFontIndex() & 0xFFFF);","+            }","+            text.append(string.substring(pos), tag);","+            return text.hasScript() || cellTag != null ? text : null;","+        }","+","+        /**","+         * @return the format runs that start inside the string, sorted by position,","+         * keeping the last at each position, so there are no more runs than characters","+         */","+        private static List<FormatRun> formatRuns(UnicodeString unicode) {","+            int length = unicode.getString().length();","+            List<FormatRun> sorted = new ArrayList<>();","+            for (int i = 0; i < unicode.getFormatRunCount(); i++) {","+                FormatRun run = unicode.getFormatRun(i);","+                if ((run.getCharacterPos() & 0xFFFF) < length) {","+                    sorted.add(run);","+                }","+            }","+            sorted.sort(Comparator.comparingInt(r -> r.getCharacterPos() & 0xFFFF));","+            List<FormatRun> runs = new ArrayList<>();","+            for (FormatRun run : sorted) {","+                int last = runs.size() - 1;","+                if (last >= 0 && runs.get(last).getCharacterPos() == run.getC