ralExpressionRef::BytesLiteral(_) => true,","+    // Check if the literal value is in the allowed values list","+    if settings","+        .allow_magic_values","+        .iter()","+        .any(|value| value.matches_value(literal_expr, unary_op))","+    {","+        return false;","     }","+","+    // Ignore `None`, `Bool`, and `Ellipsis` constants.","+    !matches!(","+        literal_expr,","+        LiteralExpressionRef::NoneLiteral(_)","+            | LiteralExpressionRef::BooleanLiteral(_)","+            | LiteralExpressionRef::EllipsisLiteral(_)","+    )"," }"," "," /// Returns `true` if `expr` is a comparand whose value is derived from the","@@ -132,8 +139,8 @@ pub(crate) fn magic_value_comparison(checker: &Checker, operands: &[Expr]) {","     let mut previous = None;","     let mut operands = operands.iter().peekable();","     while let Some(comparison_expr) = operands.next() {","-        if let Some(value) = as_literal(comparison_expr)","-            && is_magic_value(value, &checker.settings().pylint.allow_magic_value_types)","+        if let Some((value, unary_op)) = as_literal(comparison_expr)","+            && is_magic_value(value, unary_op, &checker.settings().pylint)","             && !previous.is_some_and(|expr| is_sys_version_comparand(expr, checker.semantic()))","             && !operands","                 .peek()"],"additions":45,"deletions":38,"truncated":false},{"path":"crates/ruff_linter/src/rules/pylint/settings.rs","lines":["@@ -5,8 +5,92 @@ use serde::{Deserialize, Serialize};"," use std::fmt;"," "," use crate::display_settings;","+use ruff_cache::{CacheKey, CacheKeyHasher};"," use ruff_macros::CacheKey;","-use ruff_python_ast::{ExprNumberLiteral, LiteralExpressionRef, Number};","+use ruff_python_ast::{ExprNumberLiteral, LiteralExpressionRef, Number, UnaryOp};","+","+#[derive(Debug, Clone, Serialize, Deserialize, Eq, PartialEq, CacheKey)]","+#[serde(untagged)]","+#[cfg_attr(feature = \"schemars\", derive(schemars::JsonSchema))]","+pub enu