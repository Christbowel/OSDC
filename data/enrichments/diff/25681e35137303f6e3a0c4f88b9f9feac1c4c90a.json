{"id":"25681e35137303f6e3a0c4f88b9f9feac1c4c90a","axis":"silent","repo":"nrwl/nx","sha":"25681e35137303f6e3a0c4f88b9f9feac1c4c90a","parsed":{"files":[{"path":"packages/nx/src/daemon/server/handle-process-in-background.spec.ts","lines":["@@ -0,0 +1,115 @@","+import { mkdtempSync, realpathSync, rmSync, writeFileSync } from 'node:fs';","+import { tmpdir } from 'node:os';","+import { join } from 'node:path';","+import { serializeResult } from '../socket-utils';","+import { handleProcessInBackground } from './handle-process-in-background';","+","+describe('handleProcessInBackground', () => {","+  const nativeJsLoader = require.extensions['.js'];","+  let fixturesDir: string;","+  let hookedFiles: string[];","+  let hookedJsLoader: typeof nativeJsLoader;","+","+  beforeEach(() => {","+    fixturesDir = realpathSync(","+      mkdtempSync(join(tmpdir(), 'nx-process-in-background-'))","+    );","+    hookedFiles = [];","+    hookedJsLoader = (module, filename) => {","+      hookedFiles.push(filename);","+      return nativeJsLoader(module, filename);","+    };","+    require.extensions['.js'] = hookedJsLoader;","+  });","+","+  afterEach(() => {","+    require.extensions['.js'] = nativeJsLoader;","+    rmSync(fixturesDir, { recursive: true, force: true });","+  });","+","+  it('requires the module with the .js loader captured before user code hooked it', async () => {","+    const requirePath = join(fixturesDir, 'process.js');","+    writeFileSync(","+      requirePath,","+      'exports.default = async (data) => ({ received: data });'","+    );","+","+    const result = await handleProcessInBackground({","+      type: 'test',","+      requirePath,","+      data: { a: 1 },","+    });","+","+    expect(result.error).toBeUndefined();","+    expect(result.response).toEqual({ received: { a: 1 } });","+    expect(hookedFiles).toEqual([]);","+    expect(require.extensions['.js']).toBe(hookedJsLoader);","+  });","+","+  it.each([","+    ['an Error', `throw new Error('fixture failed to load');`],","+    [","+      'an Error with a BigInt property',","+      `throw Object.assign(new Error('fixture failed to load'), { size: 1n });`,","+    ],","+  ])(","+    'responds with the original message and stack when loading throws %s',","+    async (_, source) => {","+      const requirePath = join(fixturesDir, 'throws.js');","+      writeFileSync(requirePath, source);","+","+      const result = await handleProcessInBackground({","+        type: 'test',","+        requirePath,","+        data: {},","+      });","+","+      const error = sentToClient(result.error);","+      expect(result.description).toBe(`Unable to require ${requirePath}`);","+      expect(error.message).toBe('fixture failed to load');","+      expect(error.stack).toContain(requirePath);","+      expect(require.extensions['.js']).toBe(hookedJsLoader);","+    }","+  );","+","+  it.each(['null', `'boom'`, '1n'])(","+    'responds with an Error when loading throws %s',","+    async (value) => {","+      const requirePath = join(fixturesDir, 'throws.js');","+      writeFileSync(requirePath, `throw ${value};`);","+","+      const result = await handleProcessInBackground({","+        type: 'test',","+        requirePath,","+        data: {},","+      });","+","+      expect(result.error).toBeInstanceOf(Error);","+      const error = sentToClient(result.error);","+      expect(result.description).toBe(`Unable to require ${requirePath}`);","+      expect(error.message).toBe(`Unable to require ${requirePath}`);","+      expect(error.stack).toContain(`Unable to require ${requirePath}`);","+      expect(require.extensions['.js']).toBe(hookedJsLoader);","+    }","+  );","+","+  it('responds with an Error when processing throws a non-Error', async () => {","+    const requirePath = join(fixturesDir, 'process.js');","+    writeFileSync(requirePath, 'exports.default = () => { throw null; };');","+","+    const result = await handleProcessInBackground({","+      type: 'test',","+      requirePath,","+      data: {},","+    });","+","+    expect(result.error).toBeInstanceOf(Error);","+    const error = sentToClient(result.error);","+    expect(result.description).toBe('Error when processing test.');","+    expect(error.message).toBe('Error when processing test.');","+  });","+});","+","+function sentToClient(error: Error) {","+  return JSON.parse(serializeResult(error, null, null)).error;","+}"],"additions":115,"deletions":0,"truncated":false},{"path":"packages/nx/src/daemon/server/handle-process-in-background.ts","lines":["@@ -1,6 +1,8 @@"," import { HandlerResult } from './server';"," import { serverLogger } from '../logger';"," import { getNxRequirePaths } from '../../utils/installation-directory';","+import { serializeResult } from '../socket-utils';","+import { requireWithNativeJsLoader } from './native-js-loader';"," "," export async function handleProcessInBackground(payload: {","   type: string;","@@ -9,16 +11,14 @@ export async function handleProcessInBackground(payload: {"," }): Promise<HandlerResult> {","   let fn;","   try {","-    fn = require(","+    fn = requireWithNativeJsLoader(","       require.resolve(payload.requirePath, {","         paths: getNxRequirePaths(),","       })","     ).default;","   } catch (e) {","-    return {","-      description: `Unable to require ${payload.requirePath}`,","-      error: new Error(`Unable to require ${payload.requirePath}`),","-    };","+    const description = `Unable to require ${payload.requirePath}`;","+    return { description, error: toTransportableError(e, description) };","   }"," ","   try {","@@ -28,9 +28,21 @@ export async function handleProcessInBackground(payload: {","       description: payload.type,","     };","   } catch (e) {","-    return {","-      description: `Error when processing ${payload.type}.`,","-      error: e,","-    };","+    const description = `Error when processing ${payload.type}.`;","+    return { description, error: toTransportableError(e, description) };","+  }","+}","+","+function toTransportableError(e: unknown, fallbackMessage: string): Error {","+  if (!(e instanceof Error)) {","+    return new Error(fallbackMessage);","+  }","+  try {","+    serializeResult(e, null, null);","+    return e;","+  } catch {","+    const copy = new Error(e.message);","+    copy.stack = e.stack;","+    return copy;","   }"," }"],"additions":21,"deletions":9,"truncated":false},{"path":"packages/nx/src/daemon/server/native-js-loader.spec.ts","lines":["@@ -0,0 +1,34 @@","+import { readFileSync } from 'node:fs';","+import { join } from 'node:path';","+import { compileFunction } from 'node:vm';","+import { ModuleKind, transpileModule } from 'typescript';","+","+describe('requireWithNativeJsLoader', () => {","+  it('loads with the require Node gives modules loaded through its ESM loader', () => {","+    const { outputText } = transpileModule(","+      readFileSync(join(__dirname, 'native-js-loader.ts'), 'utf-8'),","+      { compilerOptions: { module: ModuleKind.CommonJS } }","+    );","+    // Like Node's: `resolve` but no `extensions` or `cache`.","+    const requiredPaths: string[] = [];","+    const esmLoaderRequire = Object.assign(","+      (path: string) => {","+        requiredPaths.push(path);","+        return { path };","+      },","+      { resolve: (path: string) => path }","+    );","+    const module = { exports: {} as typeof import('./native-js-loader') };","+","+    compileFunction(outputText, ['exports', 'require', 'module'])(","+      module.exports,","+      esmLoaderRequire,","+      module","+    );","+","+    expect(","+      module.exports.requireWithNativeJsLoader('/workspace/process.js')","+    ).toEqual({ path: '/workspace/process.js' });","+    expect(requiredPaths).toEqual(['/workspace/process.js']);","+  });","+});"],"additions":34,"deletions":0,"truncated":false},{"path":"packages/nx/src/daemon/server/native-js-loader.ts","lines":["@@ -0,0 +1,18 @@","+// Captured when the daemon starts, before plugins or sync generators can","+// replace it (e.g. @swc-node/register compiles every .js outside node_modules).","+const nativeJsLoader = require.extensions?.['.js'];","+","+export function requireWithNativeJsLoader(path: string) {","+  // Undefined when a loader hook (e.g. Yarn PnP's) has Node's ESM loader run","+  // nx's CommonJS. The require nx gets there never runs .js hooks.","+  if (!nativeJsLoader) {","+    return require(path);","+  }","+  const currentJsLoader = require.extensions['.js'];","+  require.extensions['.js'] = nativeJsLoader;","+  try {","+    return require(path);","+  } finally {","+    require.extensions['.js'] = currentJsLoader;","+  }","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"packages/nx/src/daemon/server/start.ts","lines":["@@ -1,5 +1,7 @@"," // Must be the first import — see enable-compile-cache.ts."," import '../../utils/enable-compile-cache';","+// Captures Node's .js loader before user code can hook it, see native-js-loader.ts.","+import './native-js-loader';"," import { output } from '../../utils/output';"," import { startServer } from './server';"," import * as process from 'process';",""],"additions":2,"deletions":0,"truncated":false}],"additions":190,"deletions":9,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-23T14:14:19.823915+00:00"}