values) && ![1, 2].includes(values.dimension)) {","+        throw new Error(\"polygon coordinates must be one- or two-dimensional arrays of numbers\")","+      }","+    }","+    const shaped_x = is_NDArray(xs) && xs.dimension == 2","+    const shaped_y = is_NDArray(ys) && ys.dimension == 2","+    xs = is_NDArray(xs) ? to_nested_array(xs) : xs","+    ys = is_NDArray(ys) ? to_nested_array(ys) : ys","+    const nested = (xs.length == 0 && ys.length == 0) || shaped_x || shaped_y || coordinate_nesting(xs, ys)","+    if (nested && xs.length != ys.length) {","+      throw new Error(\"polygon x and y coordinates must have the same length\")","+    }","+    if (nested && (!isArrayableOf(xs, isArrayable) || !isArrayableOf(ys, isArrayable))) {","+      throw new Error(\"polygon x and y coordinates must have matching nesting\")","+    }","+    const geometries = nested","+      ? Array.from(xs, (x, i) => geometry_from_xy(x as Arrayable, ys[i] as Arrayable))","+      : [geometry_from_xy(xs, ys)]","+    return this.create<T>({geometries, data})","+  }","+","+  protected constructor(attrs: Partial<GeometryDataSource.Attrs> | GeometryInput | Map<string, unknown> = {}) {","+    const input = attrs instanceof Map ? Object.fromEntries(attrs) as Partial<GeometryDataSource.Attrs> : attrs","+    if (typeof input == \"string\" || isArray(input) || (\"type\" in input || \"geometry\" in input)) {","+      super(geojson_to_geometry_records(input))","+    } else {","+      const options = input as Partial<GeometryDataSource.Attrs>","+      const columns = dict(options.data ?? {})","+      const geometry = options.geometries === undefined ? columns.get(\"geometry\") : undefined","+      const data = geometry === undefined ? options.data ?? {} : Object.fromEntries([...columns].filter(([name]) => name != \"geometry\"))","+      const geometries = options.geometries ?? (geometry === undefined ? [] : Array.from(geometry) as GeometryValue[])","+      super({...options, ...geojson_to_geometry_record