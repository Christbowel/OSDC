"+export namespace GeometryDataSource {","+  export type Attrs = p.AttrsOf<Props>","+","+  export type Props = IndexedDataSource.Props & {","+    geometries: p.Property<GeometryValue[]>","+    data: p.Property<Data>","+    crs: p.Property<string | null>","+  }","+}","+","+export interface GeometryDataSource extends GeometryDataSource.Attrs {}","+","+export function is_geometry_records(value: unknown): value is GeometryRecords {","+  if (!isPlainObject(value)) {","+    return false","+  }","+  const {geometries, data} = value as {geometries?: unknown, data?: unknown}","+  return isArray(geometries) && isDict(data)","+}","+","+function coordinate_paths(geometry: GeometryValue): Position[][] {","+  if (geometry == null) {","+    return []","+  }","+","+  switch (geometry.type) {","+    case \"Point\":","+      return [[geometry.coordinates]]","+    case \"MultiPoint\":","+      return [positions(geometry.coordinates)]","+    case \"LineString\":","+      return [positions(geometry.coordinates)]","+    case \"MultiLineString\":","+    case \"Polygon\":","+      return position_paths(geometry.coordinates)","+    case \"MultiPolygon\": {","+      const coordinates = is_NDArray(geometry.coordinates) ? to_nested_array(geometry.coordinates) : geometry.coordinates","+      return coordinates.flatMap(position_paths)","+    }","+    case \"GeometryCollection\":","+      return geometry.geometries.flatMap((item) => coordinate_paths(item))","+    default:","+      return []","+  }","+}","+","+function position_paths(value: unknown): Position[][] {","+  const paths = is_NDArray(value) ? to_nested_array(value) : value as unknown[]","+  return paths.map(positions)","+}","+","+function positions(value: unknown): Position[] {","+  if (is_NDArray(value)) {","+    if (value.dimension != 2) {","+      return []","+    }","+    const [rows, width] = value.shape","+    return Array.from({length: rows}, (_, row) =>","+      Array.from(value.slice(row*width, (row + 1)*width)) as Position,","+    )","+  }","+  return value as Position[]","+}","+","+function coordinate_sequence(geometry: GeometryValue, axis: 0 | 1 | 2): number[] {","+  const paths = coordinate_paths(geometry)","+  if (paths.length != 1) {","+    return []","+  }","+  return paths[0].map((position) => position[axis] ?? NaN)","+}","+","+function point_coordinate(geometry: GeometryValue, axis: 0 | 1 | 2): number {","+  return geometry?.type == \"Point\" ? geometry.coordinates[axis] ?? NaN : NaN","+}","+","+function geometry_from_xy(xs: Arrayable, ys: Arrayable): Geometry {","+  if (!isArrayable(xs) || !isArrayable(ys) || [xs, ys].some((row) => is_NDArray(row) && row.dimension != 1)) {","+    throw new Error(\"polygon x and y coordinates must have matching nesting\")","+  }","+  if (xs.length != ys.length) {","+    throw new Error(\"polygon x and y coordinates must have the same length\")","+  }","+","+  const ring = zip(xs, ys).map(([x, y]) =>","+    [x instanceof Date ? x.getTime() : x, y instanceof Date ? y.getTime() : y])","+  for (const pair of ring) {","+    for (const value of pair) {","+      if (isNumber(value)) {","+        if (!Number.isFinite(value)) {","+          throw new Error(\"polygon coordinates must be finite; use Polygon or MultiPolygon geometry for multipart data\")","+        }","+      } else if (!isString(value) && !(isArrayableOf(value, isString) && value.length > 0)) {","+        throw new Error(\"polygon coordinates must be numbers or categorical factors\")","+      }","+    }","+  }","+","+  if (ring.length == 0) {","+    return {type: \"Polygon\", coordinates: []}","+  }","+  const first = ring[0]","+  if (ring.some(([x, y]) => isNumber(x) != isNumber(first[0]) || isNumber(y) != isNumber(first[1]))) {","+    throw new Error(\"polygon coordinates cannot mix numbers and categorical factors on the same axis\")","+  }","+  if (!is_equal(first, ring.at(-1))) {","+    ring.push(first)","+  }","+  if (ring.length < 4) {","+    throw new Error(\"polygon rings must contain at least three vertices\")","+  }","+  return {type: \"Polygon\", coordinates: [ring as Position[]]}","+}","+","+export function is_coordinate_sequence(value: unknown): value is Arrayable {","+  return isArrayable(value) && (value.length == 0 || typeof value[0] != \"string\")","+}","+","+export function coordinate_nesting(xs: Arrayable, ys: Arrayable): boolean {","+  const x = xs[0]","+  const y = ys[0]","+  const nested_x = is_coordinate_sequence(x)","+  const nested_y = is_coordinate_sequence(y)","+  const categorical_row = (value: unknown): boolean => isArray(value) && value.length > 0 && value.every((item) => typeof item == \"string\")","+  if (nested_x && categorical_row(y) || nested_y && categorical_row(x) || categorical_row(x) && categorical_row(y)) {","+    return true","+  }","+  if (nested_x != nested_y) {","+    throw new Error(\"polygon x and y coordinates must have matching nesting\")","+  }","+  return nested_x","+}","+","+function append_geometry(","+  geometry: GeometryValue,","+  properties: {[key: string]: unknown},","+  geometries: GeometryValue[],","+  rows: {[key: string]: unknown}[],","+): void {","+  if (geometry?.type == \"GeometryCollection\") {","+    for (const item of geometry.geometries) {","+      append_geometry(item, properties, geometries, rows)","+    }","+  } else {","+    geometries.push(geometry)","+    rows.push(properties)","+  }","+}","+","+function misaligned_attributes(data: Data, length: number): string[] {","+  return entries(data)","+    .filter(([, values]) => (is_NDArray(values) && values.dimension > 1 ? values.shape[0] : values.length) != length)","+    .map(([field]) => field)","+}","+","+function geometry_value(value: unknown): GeometryValue {","+  if (value === null) {","+    return null","+  }","+  if (!isPlainObject(value) || !isString(value.type)) {","+    throw new Error(\"geometry values must be GeoJSON mappings with a 'type'\")","+  }","+  if (value.type == \"Feature\") {","+    return geometry_value(value.