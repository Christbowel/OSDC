ns":0,"truncated":false},{"path":"bokehjs/test/unit/models/sources/geometry_data_source.ts","lines":["@@ -0,0 +1,101 @@","+import {expect} from \"#framework/assertions\"","+import {async_trap} from \"#framework/util\"","+import {ndarray} from \"@bokehjs/core/util/ndarray\"","+import {Document} from \"@bokehjs/document/document\"","+import {ColumnDataChangedEvent, ModelChangedEvent} from \"@bokehjs/document/events\"","+import {GeometryDataSource} from \"@bokehjs/models/sources/geometry_data_source\"","+","+describe(\"GeometryDataSource\", () => {","+  it(\"reports misaligned updates and accepts an aligned document patch\", async () => {","+    const source = GeometryDataSource.create({geometries: [null], data: {name: [\"first\"], [\"__proto__\"]: [\"p\"]}})","+    const doc = new Document()","+    doc.add_root(source)","+    const misaligned = await async_trap(async () => {","+      source.geometries = [null, null]","+    })","+    expect(misaligned.warn.includes(\"geometry attributes must have the same length as geometries: name, __proto__\")).to.be.true","+","+    const aligned = await async_trap(async () => {","+      doc.apply_json_patch(doc.create_json_patch([","+        new ModelChangedEvent(doc, source, \"geometries\", [null, null, null]),","+        new ColumnDataChangedEvent(doc, source, \"data\", {name: [\"first\", \"second\", \"third\"], [\"__proto__\"]: [\"p\", \"q\", \"r\"]}),","+      ]))","+    })","+    expect(aligned.warn).to.be.equal(\"\")","+    expect(source.get_field(\"name\")).to.be.equal([\"first\", \"second\", \"third\"])","+    doc.apply_json_patch(doc.create_json_patch([","+      new ColumnDataChangedEvent(doc, source, \"data\", {extra: [1, 2, 3]}, [\"extra\"]),","+    ]))","+    expect(source.get_field(\"__proto__\")).to.be.equal([\"p\", \"q\", \"r\"])","+    expect(source.get_field(\"extra\")).to.be.equal([1, 2, 3])","+  })","+","+  it(\"rejects invalid coordinate rows and values in from_xy()\", () => {","+    expect(() => GeometryDataSource.from_xy([[0], 1], [[0], 2])).to.throw(Error, \"matching nesting\")","+    expect(() => GeometryDataSource.from_xy([null], [0])).to.throw(Error, \"numbers or categorical factors\")","+    expect(() => GeometryDataSource.from_xy([NaN], [0])).to.throw(Error, \"must be finite\")","+    expect(() => GeometryDataSource.from_xy([1], [2])).to.throw(Error, \"at least three vertices\")","+    expect(() => GeometryDataSource.from_xy([0, \"a\", 2], [0, 1, 0])).to.throw(Error, \"cannot mix\")","+  })","+","+  it(\"closes rings and supports empty coordinate arrays and subclasses\", () => {","+    class CustomSource extends GeometryDataSource {}","+    expect(CustomSource.from_xy([], [], {name: []})).to.be.instanceof(CustomSource)","+    const empty = ndarray([], {shape: [0, 3]})","+    expect(GeometryDataSource.from_xy(empty, empty).get_length()).to.be.equal(0)","+    const source = GeometryDataSource.from_xy([new Date(0), new Date(1), new Date(2)], [0, 1, 0])","+    expect(source.geometries).to.be.equal([{type: \"Polygon\", coordinates: [[[0, 0], [1, 1], [2, 0], [0, 0]]]}])","+  })","+","+  it(\"normalizes explicit geometries and preserves attributes in clones\", () => {","+    const point = {type: \"Point\", coordinates: [0, 1]} as const","+    const geometry = {type: point.type, coordinates: [...point.coordinates]}","+    const feature = {type: \"Feature\" as const, geometry, properties: {}}","+    const source = GeometryDataSource.create({geometries: [feature], data: {[\"__proto__\"]: [\"p\"]}})","+    expect(source.geometries).to.be.equal([geometry])","+    source.setv({geometries: [feature], crs: \"EPSG:4326\", tags: [\"test\"]})","+    expect(() => source.setv({geometries: [5]})).to.throw(Error, \"GeoJSON mappings\")","+    const copy = source.clone()","+    expect(copy.geometries).to.be.equal([geometry])","+    expect(copy.get_field(\"__proto__\")).to.be.equal([\"p\"])","+    expect(copy.crs).to.be.equal(\"EPSG:4326\")","+    expect(copy.tags).to.be.equal([\"test\"])","+    const columns = GeometryDataSource.create({data: {geometry: [geometry], name: [\"point\"]}})","+    expect(columns.geometries).to.be.equal([geometry])","+    expect(columns.get_field(\"name\")).to.be.equal([\"point\"])","+","+    const record = GeometryDataSource.create({geometry, type: \"GeometryCollection\"})","+    expect(record.geometries).to.be.equal([geometry])","+    expect(record.get_field(\"type\")).to.be.equal([\"GeometryCollection\"])","+  })","+","+  it(\"preserves prototype-named attributes and fills missing values with null\", () => {","+    const source = GeometryDataSource.create([","+      {type: \"Feature\", geometry: null, properties: {[\"__proto__\"]: \"first\", constructor: \"second\"}},","+      {type: \"Feature\", geometry: null, properties: {}},","+    ])","+    expect(source.get_field(\"__proto__\")).to.be.equal([\"first\", null])","+    expect(source.get_field(\"constructor\")).to.be.equal([\"second\", null])","+    expect(Object.entries(source.get_record(0))).to.be.equal([","+      [\"geometry\", null], [\"__proto__\", \"first\"], [\"constructor\", \"second\"],","+    ])","+    expect(Object.entries(source.get_record(1))).to.be.equal([","+      [\"geometry\", null], [\"__proto__\", null], [\"constructor\", null],","+    ])","+  })","+","+  it(\"exposes geometry, derived coordinates, and attributes through indexed fields\", () => {","+    const point = {type: \"Point\", coordinates: [2, 3]} as const","+    const source = GeometryDataSource.create({","+      geometries: [{type: point.type, coordinates: [...point.coordinates]}, null],","+      data: {name: [\"first\", null]},","+    })","+    expect(source.get_length()).to.be.equal(2)","+    expect(source.get_field(\"geometry\")).to.be.equal([point, null])","+    expect(source.get_field(\"x\")).to.be.equal([2, NaN])","+    expect(source.get_record(0)).to.be.equal({geometry: point, name: \"first\"})","+","+    source.geometries = [{type: \"Point\", coordinates: [4, 3]}, null]","+    expect(source.get_field(\"x\")).to.be.equal([4, NaN])","+  })","+})"],"additions":101,"deletions":0,"truncated":false},{"path":"examples/topics/geo/geojson_point_legend.py","lines":["@@ -0,0 +1,65 @@","+''' Group GeoJSON points by a feature property in a legend.","+","+.. bokeh-example-metadata::","+    :sampledata: us_states","+    :apis: bokeh.models.GeometryDataSource, bokeh.plotting.figure, bokeh.plotting.show","+    :keywords: geojson, scatter, legend","+'''","+","+from bokeh.models import GeometryDataSource, HoverTool","+from bokeh.plotting import figure, show","+from bokeh.sampledata.us_states import data as states","+from bokeh.transform import factor_cmap, factor_mark","+","+# Approximate summit coordinates for selected Cascade volcanoes.","+volcanoes = [","+    (\"Mount Baker\", -121.81, 48.78, \"Washington\"),","+    (\"Glacier Peak\", -121.11, 48.11, \"Washington\"),","+    (\"Mount Rainier\", -121.76, 46.85, \"Washington\"),","+    (\"Mount St. Helens\", -122.18, 46.20, \"Washington\"),","+    (\"Mount Adams\", -121.49, 46.20, \"Washington\"),","+    (\"Mount Hood\", -121.70, 45.37, \"Oregon\"),","+    (\"Mount Jefferson\", -121.80, 44.67, \"Oregon\"),","+    (\"South Sister\", -121.77, 44.10, \"Oregon\"),","+    (\"Mount Mazama\", -122.11, 42.94, \"Oregon\"),","+    (\"Mount Shasta\", -122.19, 41.41, \"California\"),","+    (\"Lassen Peak\", -121.51, 40.49, \"California\"),","+]","+geojson = {","+    \"type\": \"FeatureCollection\",","+    \"features\": [","+        {","+            \"type\": \"Feature\",","+            \"geometry\": {\"type\": \"Point\", \"coordinates\": [longitude, latitude]},","+            \"properties\": {\"name\": name, \"state\": state},","+        }","+        for name, longitude, latitude, state in volcanoes","+    ],","+}","+source = GeometryDataSource(geojson)","+","+p = figure(","+    title=\"Volcanoes of the Cascade Range\",","+    width=640, height=650, x_range=(-126, -116), y_range=(39.5, 50),","+    tools=\"pan,wheel_zoom,reset,save\",","+    background_fill_color=\"#e6f0f4\",","+)","+p.axis.visible = False","+p.grid.visible = False"],"additions":48,"deletions":0,"truncated":false}],"additions":597,"deletions":20,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-24T20:29:34.989220+00:00"}