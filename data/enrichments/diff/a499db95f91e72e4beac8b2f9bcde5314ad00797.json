ctx.authorization,","+    })","+    return { success: true }","+  })"],"additions":20,"deletions":0,"truncated":false},{"path":"apps/studio/lib/ai/tools/deploy-edge-function.ts","lines":["@@ -0,0 +1,19 @@","+import { z } from 'zod'","+","+import type { ToolContract } from './types'","+","+const inputSchema = z.object({","+  name: z.string().describe('The URL-friendly name/slug of the Edge Function.'),","+  code: z.string().describe('The TypeScript code for the Edge Function.'),","+})","+","+export const contract = {","+  name: 'deploy_edge_function',","+  description:","+    'Asks the user to deploy a Supabase Edge Function from provided code. Requires user approval before deploying.',","+  inputSchema,","+  outputSchema: z.object({ success: z.boolean() }),","+  minOptInLevel: null,","+  needsApproval: true,","+  toModelOutput: ({ success }) => ({ success }),","+} as const satisfies ToolContract"],"additions":19,"deletions":0,"truncated":false},{"path":"apps/studio/lib/ai/tools/execute-sql-output.ts","lines":["@@ -0,0 +1,59 @@","+import type { JSONValue } from 'ai'","+import { z } from 'zod'","+","+import { lowerOptInLevel, optInLevelSchema } from '../opt-in-level'","+import { DEFAULT_CELL_ROW_LIMIT } from '@/components/interfaces/Explorer/QueryCell/QueryCell.utils'","+import type { AiOptInLevel } from '@/hooks/misc/useOrgOptedIntoAi'","+","+export const NO_DATA_PERMISSIONS =","+  'The query was executed and the user has viewed the results but decided not to share in the conversation due to permission levels. Continue with your plan unless instructed to interpret the result. If you need the rows to answer and `update_opt_in_level` is available, call it with `schema_and_log_and_data`, unless the user already skipped that request in this chat.'","+","+// the rows.length default covers chats saved before execute_sql sliced its rows","+export const toModelRows = <T>(","+  rows: T[],","+  {","+    totalRows = rows.length,","+    hasMoreRows = false,","+  }: { totalRows?: number; hasMoreRows?: boolean } = {}","+) => {","+  if (!hasMoreRows && totalRows <= DEFAULT_CELL_ROW_LIMIT) return rows","+","+  return {","+    rows: rows.slice(0, DEFAULT_CELL_ROW_LIMIT),","+    note: hasMoreRows","+      ? `The query matches more than ${DEFAULT_CELL_ROW_LIMIT} rows. Only the first ${DEFAULT_CELL_ROW_LIMIT} are included because results are capped to protect database performance, so the exact total is unknown. Tell the user it matched more than ${DEFAULT_CELL_ROW_LIMIT} rows and only the first ${DEFAULT_CELL_ROW_LIMIT} are shown. Do not state a specific total.`","+      : `Only the first ${DEFAULT_CELL_ROW_LIMIT} of ${totalRows} rows are included.`,","+  }","+}","+","+/**","+ * `optInLevel` is the level the query ran under. Rows are shared only at the lower of that","+ * and the current level, so rows from `schema` stay hidden after an upgrade to data.","+ */","+const stampedOutputSchema = z.object({","+  rows: z.array(z.unknown()),","+  totalRows: z.number().optional(),","+  hasMoreRows: z.boolean().optional(),","+  optInLevel: optInLevelSchema,","+})","+","+/**","+ * Output saved before the stamp existed is a bare array. It's stamped `schema` so its rows","+ * stay hidden from the model, and the UI can still show them.","+ */","+export const executeSqlOutputSchema = z.union([","+  stampedOutputSchema,","+  z.array(z.unknown()).transform((rows) => ({ rows, optInLevel: 'schema' as const })),","+])","+","+export type ExecuteSqlOutput = z.infer<typeof stampedOutputSchema>","+","+export function toModelExecuteSqlOutput(","+  output: ExecuteSqlOutput,","+  optInLevel: AiOptInLevel","+): JSONValue {","+  const level = lowerOptInLevel(output.optInLevel, optInLevel)","+  return level === 'schema_and_log_and_data'","+    ? (toModelRows(output.rows, output) as JSONValue)","+    : NO_DATA_PERMISSIONS","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"apps/studio/lib/ai/tools/execute-sql.server.ts","lines":["@@ -0,0 +1,38 @@","+import { untrustedSql } from '@supabase/pg-meta'","+","+import { getAuthHeaders } from './auth-headers'","+import { capReadQuery } from './cap-read-query'","+import { contract } from './execute-sql'","+import { approvalGatedToolFromContract } from './tool-from-contract'","+import type { ApprovalGatedToolFactory } from './types'","+import { DEFAULT_CELL_ROW_LIMIT } from '@/components/interfaces/Explorer/QueryCell/QueryCell.utils'","+import { executeSql } from '@/data/sql/execute-sql-mutation'","+","+export const createTool: ApprovalGatedToolFactory<typeof contract> = (ctx) => {","+  const { projectRef, connectionString, aiOptInLevel = 'schema' } = ctx","+  const authHeaders = getAuthHeaders(ctx.authorization, { contentType: true })","+","+  return approvalGatedToolFromContract(","+    contract,","+    ctx,","+    async ({ sql, isWriteQuery }, { abortSignal }, gate) => {","+      const approvedSql = gate.acceptUntrustedSql(untrustedSql(sql))","+      const { sql: limitedSql, isCappedInDatabase } = isWriteQuery","+        ? { sql: approvedSql, isCappedInDatabase: false }","+        : capReadQuery(approvedSql, DEFAULT_CELL_ROW_LIMIT + 1)","+      const { result } = await executeSql(","+        { projectRef, connectionString, sql: limitedSql },","+        abortSignal,","+        authHeaders","+      )","+      const rows = Array.isArray(result) ? result : []","+      const isCapped = rows.length > DEFAULT_CELL_ROW_LIMIT","+      const hasMoreRows = isCappedInDatabase && isCapped","+      return {","+        rows: rows.slice(0, DEFAULT_CELL_ROW_LIMIT),","+        ...(hasMoreRows ? { hasMoreRows } : { totalRows: rows.length }),","+        optInLevel: aiOptInLevel,","+      }","+    }","+  )","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"apps/studio/lib/ai/tools/execute-sql.ts","lines":["@@ -0,0 +1,36 @@","+import { z } from 'zod'","+","+import { executeSqlOutputSchema, toModelExecuteSqlOutput } from './execute-sql-output'","+import type { ToolContract } from './types'","+import { fixSqlBackslashEscapes } from '@/lib/ai/util'","+","+const inputSchema = z.object({","+  // Transform at parse time so the corrected SQL is what gets stored in","+  // toolCall.input — ensuring evals and logs reflect what actually runs.","+  sql: z.string().describe('The SQL statement to execute.').transform(fixSqlBackslashEscapes),","+  label: z.string().describe('A short 2-4 word label for the SQL statement.'),","+  chartConfig: z","+    .object({","+      view: z.enum(['table', 'chart']).describe('How to render the results after execution'),","+      xAxis: z.string().optional().describe('The column to use for the x-axis of the chart.'),","+      yAxis: z.string().optional().describe('The column to use for the y-axis of the chart.'),","+    })","+    .describe('Chart configuration for rendering the results'),","+  isWriteQuery: z","+    .boolean()","+    .default(false)","+    .describe(","+      'Whether the SQL statement performs a write operation or has side effects. Set true for INSERT/UPDATE/DELETE/DDL and for SELECT statements that call side-effecting functions, such as select cron.schedule(...), cron.unschedule(...), or functions that create, modify, schedule, enqueue, notify, or trigger work.'","+    ),","+})","+","+export const contract = {","+  name: 'execute_sql',","+  description:","+    'Asks the user to execute a SQL statement and return the results. Requires user approval before executing.',","+  inputSchema,","+  outputSchema: executeSqlOutputSchema,","+  minOptInLevel: null,","+  needsApproval: true,","+  toModelOutput: toModelExecuteSqlOutput,","+} as const satisfies ToolContract"],"additions":36,"deletions":0,"truncated":false},{"path":"apps/studio/lib/ai/tools/knowledge-topics.ts","lines":["@@ -0,0 +1,11 @@","+/** Topics `load_knowledge` can load, with how the UI refers to each. Prompt text lives server-side. */","+export const KNOWLEDGE_TOPIC_LABELS = {","+  pg_best_practices: 'Postgres best practices',","+  rls: 'RLS',","+  storage: