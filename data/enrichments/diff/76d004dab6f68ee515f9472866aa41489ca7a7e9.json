t_accelerator_ids()[\"MLU\"]","+            return ids, os.environ[\"CN_VISIBLE_DEVICES\"]","+","+        ids, visible = ray.get(assignment.remote())","+        assert len(ids) == 1, ids","+        assert visible == ids[0], (ids, visible)","+        if os.environ[\"RAY_TEST_RESOURCES_SPECIFIED\"] == \"1\":","+            assert visible != driver_visible, (driver_visible, visible)","+        \"\"\"","+    )","+    script_path = tmp_path / \"mlu_job.py\"","+    script_path.write_text(script)","+    job_id = await mlu_job_manager.submit_job(","+        entrypoint=f'python \"{script_path.as_posix()}\"',","+        runtime_env={","+            \"env_vars\": {","+                \"CN_VISIBLE_DEVICES\": \"0,2\",","+                \"RAY_TEST_RESOURCES_SPECIFIED\": str(int(resources_specified)),","+            },","+        },","+        entrypoint_resources={\"MLU\": 1} if resources_specified else None,","+    )","+","+    async def check_job_succeeded():","+        info = await mlu_job_manager.get_job_info(job_id)","+        if info.status == JobStatus.FAILED:","+            raise RuntimeError(f\"Job failed! {info.message}\")","+        assert info.status in {","+            JobStatus.PENDING,","+            JobStatus.RUNNING,","+            JobStatus.SUCCEEDED,","+        }","+        if info.status == JobStatus.SUCCEEDED:","+            assert info.driver_exit_code == 0","+        else:","+            assert info.driver_exit_code is None","+        return info.status == JobStatus.SUCCEEDED","+","+    await async_wait_for_condition(check_job_succeeded)","+","+","+if __name__ == \"__main__\":","+    sys.exit(pytest.main([\"-sv\", __file__]))"],"additions":397,"deletions":0,"truncated":false},{"path":"src/ray/common/ray_config_def.h","lines":["@@ -998,7 +998,7 @@ RAY_CONFIG(std::string, predefined_unit_instance_resources, \"GPU\")"," /// When set it to \"neuron_cores,TPU,FPGA\", we will also treat FPGA as unit_instance."," RAY_CONFIG(std::string,","            custom_unit_