{"id":"8c36ecf138de70922000f79538b72b6b0509fb7a","axis":"silent","repo":"envoyproxy/envoy","sha":"8c36ecf138de70922000f79538b72b6b0509fb7a","parsed":{"files":[{"path":"api/envoy/config/listener/v3/listener.proto","lines":["@@ -161,7 +161,17 @@ message Listener {","     // for details on how listener name is determined if unspecified. In addition, this may be a xdstp:// URL.","     string name = 1;"," ","-    // Configuration for the source of FCDS updates for this listener.","+    // Configuration for the source of FCDS updates for this listener. If not specified, the","+    // listener does not subscribe to FCDS. Instead, an extension, such as a bootstrap extension,","+    // adds the filter chains by name, and the listener waits for them without a timeout. Server","+    // initialization also waits for them when Envoy creates the listener before it starts its","+    // workers, for example a static listener or one from the first LDS update.","+    //","+    // A filter chain name is either discovered through FCDS or added by an extension, and Envoy","+    // rejects a listener that requests a name of the other kind. A listener keeps its names until","+    // it is removed and has finished draining, and an update builds the new version of a listener","+    // while the previous version still keeps them. So an update that sets or clears","+    // ``config_source`` must use new filter chain names, or Envoy rejects it.","     // .. note::","     //   This discovery service only supports ``AGGREGATED_GRPC`` API type.","     core.v3.ConfigSource config_source = 2;"],"additions":11,"deletions":1,"truncated":false},{"path":"changelogs/current/minor_behavior_changes/listener__fcds-local-filter-chains.rst","lines":["@@ -0,0 +1,7 @@","+A listener whose Filter Chain Discovery Service (FCDS) configuration has no config source is no","+longer rejected. Instead it waits, without a timeout, for an extension, such as a bootstrap","+extension, to add its filter chains by name. When Envoy creates such a listener before it starts its","+workers, server initialization waits too. A filter chain name is either discovered through FCDS or","+added by an extension, and Envoy rejects a listener that requests a name of the other kind. A","+listener keeps its names until it is removed and has finished draining, so an update that sets or","+clears the config source of a listener must use new filter chain names."],"additions":7,"deletions":0,"truncated":false},{"path":"envoy/server/listener_manager.h","lines":["@@ -66,6 +66,15 @@ class ListenerUpdateCallbacks {","    * keeps serving.","    */","   virtual void onListenerListenFailure(absl::string_view /*listener_name*/, bool /*removed*/) {}","+","+  /**","+   * onFilterChainAddOrUpdate is called once a filter chain that the listeners with fcds_config","+   * find by name is added or updated, and is posted to the workers. Envoy can call this inside","+   * addOrUpdateFilterChain() for a version that was added earlier. It must not add, update or","+   * remove listeners or filter chains.","+   * @param filter_chain_name is the name of the filter chain.","+   */","+  virtual void onFilterChainAddOrUpdate(absl::string_view /*filter_chain_name*/) {}"," };"," "," /**","@@ -357,6 +366,36 @@ class ListenerManager {","    */","   virtual ListenerUpdateCallbacksHandlePtr","   addListenerUpdateCallbacks(ListenerUpdateCallbacks& callbacks) PURE;","+","+  /**","+   * Add or update a filter chain that the listeners with fcds_config find by name, as FCDS would","+   * deliver it. A listener whose fcds_config has no config_source waits, without a timeout, until","+   * the filter chains that it finds by name are added and finished warming, and removing a filter","+   * chain that still warms ends the wait. The wait can hold server initialization. A filter chain","+   * name is either discovered through FCDS or added here, and Envoy rejects a listener that","+   * requests a name of the other kind. A listener keeps its names until it is removed and has","+   * finished draining. The caller must use names that no other caller writes. This call can warm","+   * listeners and start the workers, and the callbacks that run inside it must not add, update or","+   * remove filter chains.","+   * @param filter_chain supplies the configuration of the filter chain.","+   * @return TRUE if the filter chain was added or updated or FALSE if it equals the version added","+   *         last, which can still warm. This routine will return an error if the filter chain","+   *         cannot be built, and an AlreadyExists error if a listener requests its name through","+   *         FCDS.","+   */","+  virtual absl::StatusOr<bool>","+  addOrUpdateFilterChain(const envoy::config::listener::v3::FilterChain& /*filter_chain*/) {","+    return absl::UnimplementedError(\"filter chains are not supported\");","+  }","+","+  /**","+   * Remove a filter chain that addOrUpdateFilterChain() added. The listeners drain its connections.","+   * Like addOrUpdateFilterChain(), this call can warm listeners and start the workers, and the","+   * callbacks that run inside it must not add, update or remove filter chains.","+   * @param name supplies the name of the filter chain.","+   * @return TRUE if the filter chain was found and removed.","+   */","+  virtual bool removeFilterChain(absl::string_view /*name*/) { return false; }"," };"," "," // overload operator| to allow ListenerManager::listeners(ListenerState) to be called using a"],"additions":39,"deletions":0,"truncated":false},{"path":"source/common/listener_manager/BUILD","lines":["@@ -36,6 +36,7 @@ envoy_cc_library(","         \"//envoy/server:listener_manager_interface\",","         \"//envoy/server:transport_socket_config_interface\",","         \"//envoy/server:worker_interface\",","+        \"//envoy/singleton:manager_interface\",","         \"//source/common/access_log:access_log_lib\",","         \"//source/common/api:os_sys_calls_lib\",","         \"//source/common/common:basic_resource_lib\",","@@ -132,10 +133,12 @@ envoy_cc_library(","     deps = [","         \":fcds_api_lib\",","         \":filter_chain_factory_context_callback\",","+        \"//envoy/common:optref_lib\",","         \"//envoy/config:grpc_mux_interface\",","         \"//envoy/config:typed_metadata_interface\",","         \"//envoy/config:xds_manager_interface\",","         \"//envoy/event:dispatcher_interface\",","+        \"//envoy/event:dispatcher_thread_deletable\",","         \"//envoy/event:schedulable_cb_interface\",","         \"//envoy/init:manager_interface\",","         \"//envoy/matcher:matcher_interface\",","@@ -144,6 +147,7 @@ envoy_cc_library(","         \"//envoy/server:listener_manager_interface\",","         \"//envoy/server:transport_socket_config_interface\",","         \"//source/common/common:empty_string\",","+        \"//source/common/common:thread_lib\",","         \"//source/common/config:resource_name_lib\",","         \"//source/common/config:resource_type_helper_lib\",","         \"//source/common/config:utility_lib\","],"additions":4,"deletions":0,"truncated":false},{"path":"source/common/listener_manager/fcds_api.cc","lines":["@@ -27,6 +27,11 @@ FcdsApiImpl::FcdsApiImpl(const envoy::config::core::v3::ConfigSource& fcds_confi","   subscription_ = std::move(subscription_or_error).value();"," }"," ","+FcdsApiImpl::FcdsApiImpl(const std::string& filter_chain_name,","+                         FilterChainUpdateCallbacks& callbacks)","+    : filter_chain_name_(filter_chain_name), callbacks_(callbacks),","+      init_target_(absl::StrCat(\"FCDS init \", filter_chain_name_), [] {}) {}","+"," FcdsApiImpl::~FcdsApiImpl() {","   // If we get destroyed during initialization, make sure we signal that we \"initialized\".","   init_target_.ready();","@@ -76,21 +81,13 @@ FcdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& added","         \"Invalid FCDS update: cannot add and remove in the same update\");","   }","   if (updated_or_removed) {","-    const uint64_t new_hash = MessageUtil::hash(*updated_or_removed);","-    if (config_hash_ == new_hash) {","-      ENVOY_LOG(debug, \"fcds: skip update for name {}\", filter_chain_name_);","+    absl::StatusOr<bool> updated = update(*updated_or_removed);","+    RETURN_IF_NOT_OK(updated.status());","+    if (!*updated) {","       return absl::OkStatus();","     }","-    RETURN_IF_NOT_OK(callbacks_.onFilterChainUpdated(*updated_or_removed));","-    // Delay readiness until the filter chain runtime instance is constructed.","-    config_hash_ = new_hash;","   } else {","-    if (filter_chain_) {","-      Network::DrainableFilterChainSharedPtr draining = std::move(filter_chain_);","-      callbacks_.onFilterChainRemoved(std::move(draining));","-      config_hash_.reset();","-    }","-    init_target_.ready();","+    remove();","   }","   // Record the version only after an update or removal is actually applied, matching the CDS","   // behavior of advancing the version on applied changes rather than skipped or rejected ones.","@@ -98,6 +95,27 @@ FcdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& added","   return absl::OkStatus();"," }"," ","+absl::StatusOr<bool> FcdsApiImpl::update(const FilterChainProto& filter_chain) {","+  const uint64_t new_hash = MessageUtil::hash(filter_chain);","+  if (config_hash_ == new_hash) {","+    ENVOY_LOG(debug, \"fcds: skip update for name {}\", filter_chain_name_);","+    return false;","+  }","+  RETURN_IF_NOT_OK(callbacks_.onFilterChainUpdated(filter_chain));","+  // Delay readiness until the filter chain runtime instance is constructed.","+  config_hash_ = new_hash;","+  return true;","+}","+","+void FcdsApiImpl::remove() {","+  if (filter_chain_) {","+    Network::DrainableFilterChainSharedPtr draining = std::move(filter_chain_);","+    callbacks_.onFilterChainRemoved(std::move(draining));","+    config_hash_.reset();","+  }","+  init_target_.ready();","+}","+"," absl::Status FcdsApiImpl::onConfigUpdate(const std::vector<Config::DecodedResourceRef>& resources,","                                          const std::string& version_info) {","   for (const auto& resource : resources) {"],"additions":30,"deletions":12,"truncated":false},{"path":"source/common/listener_manager/fcds_api.h","lines":["@@ -84,7 +84,8 @@ class FcdsApi : public Config::SubscriptionCallbacks {"," using FcdsApiPtr = std::unique_ptr<FcdsApi>;"," "," /**","- * FCDS API implementation that fetches via Config::Subscription.","+ * FCDS API implementation that fetches via Config::Subscription, or that a local caller updates","+ * without a subscription.","  */"," class FcdsApiImpl : public FcdsApi, Logger::Loggable<Logger::Id::upstream> {"," public:","@@ -93,6 +94,7 @@ class FcdsApiImpl : public FcdsApi, Logger::Loggable<Logger::Id::upstream> {","               Upstream::ClusterManager& cm, Stats::Scope& scope,","               const Config::ResourceTypeHelper<FilterChainProto>& resource_type_helper,","               absl::Status& creation_status);","+  FcdsApiImpl(const std::string& filter_chain_name, FilterChainUpdateCallbacks& callbacks);","   ~FcdsApiImpl() override;"," ","   // FcdsApi","@@ -104,6 +106,22 @@ class FcdsApiImpl : public FcdsApi, Logger::Loggable<Logger::Id::upstream> {","     return filter_chain_;","   }"," ","+  /**","+   * Updates the filter chain as an FCDS update does.","+   * @return false when the filter chain is unchanged, or an error when it cannot be built.","+   */","+  absl::StatusOr<bool> update(const FilterChainProto& filter_chain);","+","+  /**","+   * Removes the filter chain as an FCDS update does.","+   */","+  void remove();","+","+  /**","+   * @return whether the filter chain comes from an FCDS subscription.","+   */","+  bool hasSubscription() const { return subscription_ != nullptr; }","+"," private:","   // Config::SubscriptionCallbacks","   absl::Status onConfigUpdate(const std::vector<Config::DecodedResourceRef>& resources,"],"additions":19,"deletions":1,"truncated":false},{"path":"source/common/listener_manager/filter_chain_manager_impl.cc","lines":["@@ -9,6 +9,7 @@"," #include \"source/common/common/cleanup.h\""," #include \"source/common/common/empty_string.h\""," #include \"source/common/common/fmt.h\"","+#include \"source/common/common/thread.h\""," #include \"source/common/config/resource_name.h\""," #include \"source/common/config/utility.h\""," #include \"source/common/listener_manager/fcds_api.h\"","@@ -1064,12 +1065,14 @@ void FcdsContextCreator::initialize(std::function<void()> completion) {"," "," FcdsSharedFilterChainManager::FcdsSharedFilterChainManager(","     Server::Configuration::ServerFactoryContext& server_context,","-    ListenerComponentFactory& listener_component_factory)","+    ListenerComponentFactory& listener_component_factory,","+    FcdsListenerManagerCallbacks& listener_manager)","     : server_context_(server_context), listener_component_factory_(listener_component_factory),","       tls_slot_(ThreadLocal::TypedSlot<ThreadLocalState>::makeUnique(server_context.threadLocal())),","       scope_(server_context_.scope().createScope(\"filter_chain_manager.\")),","       resource_type_helper_(server_context.messageValidationContext().dynamicValidationVisitor(),","                             \"name\"),","+      listener_manager_(listener_manager),","       tls_update_cb_(server_context.mainThreadDispatcher().createSchedulableCallback(","           [this]() { updateTlsState(); })) {","   tls_slot_->set([](Event::Dispatcher&) { return std::make_shared<ThreadLocalState>(); });","@@ -1112,22 +1115,38 @@ absl::StatusOr<FcdsSubscriptionHandleSharedPtr>"," FcdsSharedFilterChainManager::subscribe(const envoy::config::core::v3::ConfigSource& config_source,","                                         const std::string& filter_chain_name,","                                         FcdsClientCallbacks& callbacks,","-                                        Init::Manager& init_manager) {","+                                        OptRef<Init::Manager> init_manager) {","   auto iter = subscriptions_.find(filter_chain_name);","+  const bool has_config_source =","+      config_source.config_source_specifier_case() !=","+      envoy::config::core::v3::ConfigSource::CONFIG_SOURCE_SPECIFIER_NOT_SET;","   // Assume config_source is the same for the same filter chain name. This would be the case for","   // xdstp names.","   if (iter == subscriptions_.end()) {","-    absl::Status creation_status;","-    auto api = std::make_unique<FcdsApiImpl>(config_source, filter_chain_name, *this,","-                                             server_context_.clusterManager(), *scope_,","-                                             resource_type_helper_, creation_status);","-    RETURN_IF_NOT_OK(creation_status);","+    std::unique_ptr<FcdsApiImpl> api;","+    if (!has_config_source) {","+      // Without a config source, a local caller provides the filter chain.","+      api = std::make_unique<FcdsApiImpl>(filter_chain_name, *this);","+    } else {","+      absl::Status creation_status;","+      api = std::make_unique<FcdsApiImpl>(config_source, filter_chain_name, *this,","+                                          server_context_.clusterManager(), *scope_,","+                                          resource_type_helper_, creation_status);","+      RETURN_IF_NOT_OK(creation_status);","+    }","     auto state = std::make_unique<SubscriptionState>();","     state->api_ = std::move(api);","     iter = subscriptions_.emplace(filter_chain_name, std::move(state)).first;","+  } else if (has_config_source != iter->second->api_->hasSubscription()) {","+    return absl::AlreadyExistsError(","+        has_config_source","+            ? fmt::format(\"filter chain {} is added or awaited locally\", filter_chain_name)","+            : fmt::format(\"filter chain {} is discovered through FCDS\", filter_chain_name));","   }","   SubscriptionState& state = *iter->second;","-  init_manager.add(state.api_->initTarget());","+  if (init_manager.has_value()) {","+    init_manager->add(state.api_->initTarget());","+  }","   auto result = std::make_shared<FcdsSubscriptionHandleImpl>(shared_from_this(), filter_chain_name,","                                                              callbacks);","   state.handles_.insert(result.get());","@@ -1146,6 +1165,69 @@ void FcdsSharedFilterChainManager::unsubscribe(const std::string& filter_chain_n","   }"," }"," ","+// A local caller holds a subscription like a listener does, so the state of a name lives while any","+// listener or local caller uses it.","+class FcdsLocalSubscriptionHandleImpl : public FcdsLocalSubscriptionHandle {","+public:","+  FcdsLocalSubscriptionHandleImpl(std::shared_ptr<FcdsSharedFilterChainManager>&& shared_manager,","+                                  FcdsSubscriptionHandleSharedPtr&& subscription)","+      : shared_manager_(std::move(shared_manager)), subscription_(std::move(subscription)) {}","+","+  absl::StatusOr<bool> update(const FilterChainProto& filter_chain) override {","+    ASSERT(filter_chain.name() == subscription_->filterChainName());","+    return shared_manager_->updateLocalFilterChain(filter_chain);","+  }","+","+  void remove() override {","+    shared_manager_->removeLocalFilterChain(subscription_->filterChainName());","+  }","+","+private:","+  const std::shared_ptr<FcdsSharedFilterChainManager> shared_manager_;","+  const FcdsSubscriptionHandleSharedPtr subscription_;","+};","+","+absl::StatusOr<FcdsLocalSubscriptionHandleSharedPtr>","+FcdsSharedFilterChainManager::subscribeLocal(const std::string& filter_chain_name) {","+  // A local caller subscribes like a listener without a config source, but it waits for nothing.","+  absl::StatusOr<FcdsSubscriptionHandleSharedPtr> subscription_or_error =","+      subscribe(envoy::config::core::v3::ConfigSource(), filter_chain_name, local_caller_callbacks_,","+                std::nullopt);","+  RETURN_IF_NOT_OK(subscription_or_error.status());","+  return std::make_shared<FcdsLocalSubscriptionHandleImpl>(","+      shared_from_this(), std::move(subscription_or_error).value());","+}","+","+absl::StatusOr<bool>","+FcdsSharedFilterChainManager::updateLocalFilterChain(const FilterChainProto& filter_chain) {","+  if (committed_filter_chain_names_.contains(filter_chain.name())) {","+    // The listener manager only learns the name, so the committed version is published before this","+    // update.","+    tls_update_cb_->cancel();","+    updateTlsState();","+  }","+  // The listeners that the update warms can go away inside it, while the subscription of the local","+  // caller keeps the state.","+  FcdsApiImpl& api = *subscriptions_.find(filter_chain.name())->second->api_;","+  absl::StatusOr<bool> updated;","+  // Building a filter chain can throw.","+  TRY_ASSERT_MAIN_THREAD { updated = api.update(filter_chain); }","+  END_TRY","+  CATCH(const EnvoyException& e, { updated = absl::InvalidArgumentError(e.what()); });","+  return updated;","+}","+","+void FcdsSharedFilterChainManager::removeLocalFilterChain(absl::string_view filter_chain_name) {","+  // The listeners that the removal readies can go away inside it, while the subscription of the","+  // local caller keeps the state.","+  SubscriptionState& state = *subscriptions_.find(filter_chain_name)->second;","+  // A filter chain that still warms is not committed once removed.","+  state.warming_filter_chain_ = nullptr;","+  state.api_->remove();","+  // The removal readied the listeners that waited, and the later ones wait for the next update.","+  state.api_ = std::make_unique<FcdsApiImpl>(std::string(filter_chain_name), *this);","+}","+"," absl::Status FcdsSharedFilterChainManager::onFilterChainUpdated(const FilterChainProto& proto) {","   auto state_iter = subscriptions_.find(proto.name());","   if (state_iter == subscriptions_.end()) {","@@ -1184,6 +1266,7 @@ void FcdsSharedFilterChainManager::onFilterChainWarmed(",