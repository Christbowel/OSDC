_manager/filter_chain_manager_impl.h","lines":["@@ -4,9 +4,11 @@"," #include <cstdint>"," #include <memory>"," ","+#include \"envoy/common/optref.h\""," #include \"envoy/config/grpc_mux.h\""," #include \"envoy/config/listener/v3/listener_components.pb.h\""," #include \"envoy/config/typed_metadata.h\"","+#include \"envoy/event/dispatcher_thread_deletable.h\""," #include \"envoy/event/schedulable_cb.h\""," #include \"envoy/matcher/matcher.h\""," #include \"envoy/network/drain_decision.h\"","@@ -474,6 +476,15 @@ class FcdsClientCallbacks {","   virtual void drainFilterChain(Network::DrainableFilterChainSharedPtr draining) PURE;"," };"," ","+// The listener manager that the FcdsSharedFilterChainManager reports its filter chains to.","+class FcdsListenerManagerCallbacks {","+public:","+  virtual ~FcdsListenerManagerCallbacks() = default;","+  // Called with the name of a filter chain that was added or updated, once it is posted to the","+  // workers.","+  virtual void notifyFilterChainUpdateCallbacks(absl::string_view filter_chain_name) PURE;","+};","+"," class FcdsSubscriptionHandle {"," public:","   virtual ~FcdsSubscriptionHandle() = default;","@@ -489,6 +500,19 @@ class FcdsSubscriptionHandle {"," };"," using FcdsSubscriptionHandleSharedPtr = std::shared_ptr<FcdsSubscriptionHandle>;"," ","+// The subscription of a local caller that provides the filter chain of a name instead of FCDS. Like","+// the subscription of a listener, it keeps the name until it is destroyed.","+class FcdsLocalSubscriptionHandle {","+public:","+  virtual ~FcdsLocalSubscriptionHandle() = default;","+  // Adds or updates the filter chain, which has the name of the subscription, as an FCDS update","+  // does. Returns false when it equals the version added last, or an error when it cannot be built.","+  virtual absl::StatusOr<bool> update(const FilterChainProto& filter_chain) PURE;","+  // Removes the filter chain as an FCDS update does.","+  virtual void remove() PURE;","+};","+using FcdsLocalS