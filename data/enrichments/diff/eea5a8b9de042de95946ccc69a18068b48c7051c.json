ls_and_features() {","     assert_eq!(client.negotiated_resolver_version().await.unwrap(), 0);","     handshake.assert_async().await;"," }","+","+fn matching_applied_policies(options: &ResolveProjectsOptions) -> Value {","+    let mut applied = serde_json::to_value(&options.verification).unwrap();","+    let object = applied.as_object_mut().unwrap();","+    object.extend(","+        serde_json::to_value(&options.resolution)","+            .unwrap()","+            .as_object()","+            .unwrap()","+            .clone(),","+    );","+    object.insert(\"frozenLockfile\".into(), json!(options.reuse.frozen_lockfile));","+    object.insert(\"trustLockfile\".into(), json!(options.reuse.trust_lockfile));","+    applied","+}","+","+#[tokio::test]","+async fn resolve_rejects_missing_applied_policies() {","+    for field in [","+        \"appliedPolicies\",","+        \"minimumReleaseAge\",","+        \"minimumReleaseAgeExclude\",","+        \"minimumReleaseAgeIgnoreMissingTime\",","+        \"trustPolicy\",","+        \"trustPolicyExclude\",","+        \"trustPolicyIgnoreAfter\",","+        \"trustLockfile\",","+        \"projectScopedOptionalPeers\",","+    ] {","+        let options = resolve_projects_options();","+        let mut done = json!({ \"type\": \"done\", \"lockfile\": matching_transform_lockfile(&options), \"appliedPolicies\": matching_applied_policies(&options) });","+        if field == \"appliedPolicies\" {","+            done.as_object_mut()","+                .unwrap()","+                .remove(field);","+        } else {","+            done[\"appliedPolicies\"]","+                .as_object_mut()","+                .unwrap()","+                .remove(field);","+        }","+        let result = resolve_mock_frames(options, vec![done], true, |_| {}).await;","+        assert!(matches!(result, Err(PnprClientError::Protocol(_))), \"{field}: {result:?}\");","+    }","+}","+","+#[tokio::test]","+async fn verify_requires_matching_applied_policies() {","+    for field in [","+        \"success\",","+        \"appliedPolicies\",","+        \"minimumReleaseAge\",","+        \"minimumReleaseAgeExclude\",","+        \"minimumReleaseAgeIgnoreMissingTime\",","+        \"trustPolicy\",","+        \"trustPolicyExclude\",","+        \"trustPolicyIgnoreAfter\",","+        \"trustLockfile\",","+    ] {","+        let mut options = resolve_projects_options();","+        options.reuse.lockfile =","+            Some(serde_json::from_value(matching_transform_lockfile(&options)).unwrap());","+        let mut applied = matching_applied_policies(&options);","+        if field != \"success\" && field != \"appliedPolicies\" {","+            applied[field] = mismatched_policy(field);","+        }","+        let mut done = json!({ \"type\": \"done\", \"appliedPolicies\": applied });","+        if field == \"appliedPolicies\" {","+            done.as_object_mut()","+                .unwrap()","+                .remove(field);","+        }","+        let mut server = mockito::Server::new_async().await;","+        let mock = server","+            .mock(\"POST\", \"/-/pnpr/v0/verify-lockfile\")","+            .with_body(format!(\"{done}\\n\"))","+            .create_async()","+            .await;","+        let result = PnprClient::new(server.url())","+            .verify_lockfile(","+                crate::VerifyLockfileOptions::from_resolve_projects_options(&options).unwrap(),","+            )","+            .await;","+        if field == \"success\" {","+            result.unwrap();","+        } else {","+            assert!(matches!(result, Err(PnprClientError::Protocol(_))), \"{field}: {result:?}\");","+        }","+        mock.assert_async().await;","+    }","+}","+","+fn mismatched_policy(field: &str) -> Value {","+    match field {","+        \"minimumReleaseAge\" | \"trustPolicyIgnoreAfter\" => json!(0),","+        \"minimumReleaseAgeExclude\" | \"trustPolicyExclude\" => json!([]),","+        \"minimumReleaseAgeIgnoreMissingTime\" | \"projectScopedOptionalPeers\" => json!(true),","+        \"trustPolicy\" => json!(null),","+        \"trustLockfile\" | \"addMissingPeerTypes\" => json!(false),","+        _ => panic!(\"no mismatch for {field}\"),","+    }","+}","+","+#[tokio::test]","+async fn resolve_rejects_mismatched_policies() {","+    for field in [","+        \"minimumReleaseAge\",","+        \"minimumReleaseAgeExclude\",","+        \"minimumReleaseAgeIgnoreMissingTime\",","+        \"trustPolicy\",","+        \"trustPolicyExclude\",","+        \"trustPolicyIgnoreAfter\",","+        \"trustLockfile\",","+        \"addMissingPeerTypes\",","+        \"projectScopedOptionalPeers\",","+    ] {","+        let options = resolve_projects_options();","+        let mut applied = matching_applied_policies(&options);","+        applied[field] = mismatched_policy(field);","+        let done = json!({ \"type\": \"done\", \"lockfile\": matching_transform_lockfile(&options), \"appliedPolicies\": applied });","+        let result = resolve_mock_frames(options, vec![done], true, |_| {}).await;","+        let Err(PnprClientError::Protocol(message)) = result else {","+            panic!(\"{field}: expected a protocol error, got {result:?}\");","+        };","+        let expected_message = match field {","+            \"addMissingPeerTypes\" => \"pnpr server ignored requested addMissingPeerTypes (expected Some(true), got false)\".to_string(),","+            \"projectScopedOptionalPeers\" => \"pnpr server ignored requested projectScopedOptionalPeers (expected Some(false), got true)\".to_string(),","+            _ => format!(\"pnpr server ignored requested {field}\"),","+        };","+        assert_eq!(message, expected_message, \"{field}\");","+    }","+}"],"additions":143,"deletions":33,"truncated":false},{"path":"pnpm/crates/pnpr-client/tests/integration/workspace_settings.rs","lines":["@@ -9,6 +9,22 @@ async fn multi_project_request_sends_every_workspace_project_without_a_synthetic","     let addr = listen