{"id":"9d361bf4a0d02159d9583a6e08793c7b10ae8dc1","axis":"silent","repo":"pnpm/pnpm","sha":"9d361bf4a0d02159d9583a6e08793c7b10ae8dc1","parsed":{"files":[{"path":".changeset/deploy-dependency-symlinks.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/fs.indexed-pkg-importer\": patch","+\"@pnpm/store.controller-types\": patch","+\"@pnpm/releasing.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm deploy` now keeps a deployed symlink to a directory inside the project even if the directory is not among the deployed files, such as a link into `node_modules` [#17288](https://github.com/pnpm/pnpm/issues/17288)."],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/target.rs","lines":["@@ -256,7 +256,7 @@ pub(super) fn copy_project(","         &output.files_map,","         ImportIndexedDirOpts {","             force: true,","-            preserve_symlinks: true,","+            symlink_targets: Some(pnpm_deps_restorer::SymlinkTargets::Internal),","             ..ImportIndexedDirOpts::default()","         },","     )"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/deploy/target.rs","lines":["@@ -557,3 +557,81 @@ diff --git a/package.json b/package.json"," ","     drop((root, mock_instance));"," }","+","+#[cfg(unix)]","+#[test]","+fn deploy_preserves_links_to_dependencies_and_copies_file_links_to_unselected_targets() {","+    use std::{os::unix::fs::symlink, path::Path};","+","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages: [.]\\ninjectWorkspacePackages: true\\n\",","+    )","+    .unwrap();","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\", \"version\": \"1.0.0\", \"files\": [\".next\"],","+            \"dependencies\": {\"local-dep\": \"file:vendor/local-dep\"}","+        })","+        .to_string(),","+    )","+    .unwrap();","+    fs::create_dir_all(workspace.join(\"vendor/local-dep\")).unwrap();","+    fs::write(","+        workspace.join(\"vendor/local-dep/package.json\"),","+        r#\"{\"name\":\"local-dep\",\"version\":\"1.0.0\",\"main\":\"index.cjs\"}\"#,","+    )","+    .unwrap();","+    fs::write(workspace.join(\"vendor/local-dep/index.cjs\"), \"module.exports = 42\").unwrap();","+    pacquet","+        .with_args([\"install\", \"--offline\", \"--ignore-scripts\"])","+        .assert()","+        .success();","+    fs::create_dir_all(workspace.join(\".next/node_modules/@scope\")).unwrap();","+    fs::write(workspace.join(\"omitted.txt\"), \"omitted\").unwrap();","+    fs::write(workspace.join(\".next/control.txt\"), \"control\").unwrap();","+    let links = [","+        (\"node_modules/alias\", \"../../node_modules/local-dep\"),","+        (\"node_modules/@scope/alias\", \"../../../node_modules/local-dep\"),","+        (\"control-link\", \"control.txt\"),","+        (\"chain\", \"node_modules/alias\"),","+    ];","+    for (name, target) in links {","+        symlink(target, workspace.join(\".next\").join(name)).unwrap();","+    }","+    symlink(\"../omitted.txt\", workspace.join(\".next/file-link\")).unwrap();","+    assert_eq!(","+        fs::read_to_string(workspace.join(\".next/node_modules/alias/index.cjs\")).unwrap(),","+        \"module.exports = 42\",","+    );","+    for (mode, flags) in [(\"default\", &[][..]), (\"legacy\", &[\"--legacy\"][..])] {","+        let destination = root.path().join(mode);","+        let command = pacquet_cmd(&workspace)","+            .with_args([\"--filter\", \"app\", \"deploy\", \"--prod\", \"--offline\", \"--ignore-scripts\"]);","+        command","+            .with_args(flags)","+            .with_arg(&destination)","+            .assert()","+            .success();","+        for (name, target) in links {","+            assert_eq!(","+                fs::read_link(destination.join(\".next\").join(name)).unwrap(),","+                Path::new(target),","+            );","+        }","+        let file_link = destination.join(\".next/file-link\");","+        assert!(fs::symlink_metadata(&file_link).unwrap().is_file());","+        assert_eq!(fs::read_to_string(&file_link).unwrap(), \"omitted\");","+        let dependency = destination.join(\".next/node_modules/alias/index.cjs\");","+        assert_eq!(fs::read_to_string(&dependency).unwrap(), \"module.exports = 42\");","+        assert!(","+            fs::canonicalize(&dependency)","+                .unwrap()","+                .starts_with(fs::canonicalize(&destination).unwrap()),","+            \"{dependency:?} must resolve inside {destination:?}\",","+        );","+        assert!(!destination.join(\"omitted.txt\").exists(), \"unselected target must stay omitted\");","+    }","+}"],"additions":78,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/create_virtual_dir_by_snapshot.rs","lines":["@@ -410,7 +410,7 @@ fn slot_import_opts<'a>(","             reuse_hardlinks: source_is_mutable && !force_import && !interrupted_build,","             keep_modules_dir: true,","             safe_to_skip,","-            preserve_symlinks: source_is_mutable,","+            symlink_targets: source_is_mutable.then_some(crate::SymlinkTargets::Imported),","             swap_lock,","         };","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/import_indexed_dir.rs","lines":["@@ -54,9 +54,9 @@ pub struct ImportIndexedDirOpts<'a> {","     ///","     /// Callers must ensure that the target path uniquely identifies its contents.","     pub safe_to_skip: bool,","-    /// When `true`, preserve safe symlinks in the imported package instead of","-    /// assuming all entries are regular files.","-    pub preserve_symlinks: bool,","+    /// Which source symlinks are recreated as symlinks. `None` imports","+    /// every entry as a file.","+    pub symlink_targets: Option<SymlinkTargets>,","     /// The install's [`ModulesSwapLock`], which serializes this install's","     /// forced replacements of private targets with those of the other","     /// installs under the same modules directory. `None` replaces","@@ -64,6 +64,18 @@ pub struct ImportIndexedDirOpts<'a> {","     pub swap_lock: Option<&'a ModulesSwapLock>,"," }"," ","+/// The source symlinks an import recreates. Either way, a link whose","+/// target leads out of the package is refused.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+pub enum SymlinkTargets {","+    /// Only links whose target is imported too. A file link to a target","+    /// left out is imported as a file, and a directory link is left out.","+    Imported,","+    /// Also a directory link whose target is left out. A file link to a","+    /// target left out is still imported as a file.","+    Internal,","+}","+"," /// Error type for [`import_indexed_dir`]."," #[derive(Debug, Display, Error, Diagnostic)]"," pub enum ImportIndexedDirError {","@@ -251,7 +263,7 @@ fn import_indexed_dir_once<Reporter: self::Reporter>(","             import_method,","             dir_path,","             cas_paths,","-            opts.preserve_symlinks,","+            opts.symlink_targets,","         )","         .inspect(|()| unquarantine()),","         // Short-circuit only when the completion marker is present","@@ -313,7 +325,7 @@ fn force_import_existing_dir<Reporter: self::Reporter>(","             import_method,","             dir_path,","             cas_paths,","-            opts.preserve_symlinks,","+            opts.symlink_targets,","         );","     }","     let swap_target =","@@ -355,7 +367,7 @@ pub(super) fn import_into_shared_dir<Reporter: self::Reporter>(","     import_method: PackageImportMethod,","     dir_path: &Path,","     cas_paths: &HashMap<String, PathBuf>,","-    preserve_symlinks: bool,","+    symlink_targets: Option<SymlinkTargets>,"," ) -> Result<(), ImportIndexedDirError> {