{"id":"997913ad79d548630720382b7ea08a2e0870107b","axis":"silent","repo":"apache/airflow","sha":"997913ad79d548630720382b7ea08a2e0870107b","parsed":{"files":[{"path":"providers/fab/docs/changelog.rst","lines":["@@ -20,6 +20,15 @@"," Changelog"," ---------"," ","+.. note::","+    This release includes a database migration that adds a ``token_generation`` column to the","+    ``ab_user`` table. Run ``airflow db migrate`` after upgrading the provider.","+","+    Changing or resetting a password now ends the API tokens and UI sessions issued before the","+    change. API servers cache users for up to ``[fab] cache_ttl`` seconds, so for a change made","+    from another process, such as ``airflow users reset-password`` or another API server, the","+    earlier API tokens stop working there once its cached user expires.","+"," 3.11.1"," ......"," "],"additions":9,"deletions":0,"truncated":false},{"path":"providers/fab/docs/migrations-ref.rst","lines":["@@ -34,7 +34,9 @@ Here's the list of all the Database Migrations that are executed via when you ru"," +-------------------------+------------------+---------------+-----------------------------------------+"," | Revision ID             | Revises ID       | Fab Version   | Description                             |"," +=========================+==================+===============+=========================================+","-| ``02ca36b0235b`` (head) | ``6709f7a774b9`` | ``3.5.0``     | Fix fab db inconsistencies.             |","+| ``20f2f9e27083`` (head) | ``02ca36b0235b`` | ``3.12.0``    | Add token_generation to ab_user.        |","++-------------------------+------------------+---------------+-----------------------------------------+","+| ``02ca36b0235b``        | ``6709f7a774b9`` | ``3.5.0``     | Fix fab db inconsistencies.             |"," +-------------------------+------------------+---------------+-----------------------------------------+"," | ``6709f7a774b9`` (base) | ``None``         | ``1.4.0``     | Create User and Role tables if missing. |"," +-------------------------+------------------+---------------+-----------------------------------------+"],"additions":3,"deletions":1,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/api_fastapi/services/users.py","lines":["@@ -185,7 +185,7 @@ def update_user(cls, username: str, body: UserPatchBody, update_mask: str | None"," ","         password_changed = False","         if \"password\" in fields_to_update and body.password is not None:","-            user.password = security_manager._hash_password(body.password.get_secret_value())","+            security_manager.set_user_password(user, body.password.get_secret_value())","             password_changed = True"," ","         if \"username\" in fields_to_update and body.username is not None:"],"additions":1,"deletions":1,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/fab_auth_manager.py","lines":["@@ -27,7 +27,7 @@"," from urllib.parse import urlencode, urljoin"," from weakref import WeakValueDictionary"," ","-from cachetools import TTLCache, cachedmethod","+from cachetools import TTLCache"," from fastapi import FastAPI"," from fastapi.middleware.wsgi import WSGIMiddleware"," from flask import current_app, g","@@ -185,6 +185,8 @@"," }"," "," CACHE_TTL = conf.getint(\"fab\", \"cache_ttl\", fallback=30)","+TOKEN_GENERATION_CLAIM = \"token_generation\"","+"," "," if AIRFLOW_V_3_1_PLUS:","     from airflow.providers.fab.www.security.permissions import RESOURCE_HITL_DETAIL","@@ -213,7 +215,12 @@ class FabAuthManager(BaseAuthManager[User]):","     This auth manager is responsible for providing a backward compatible user management experience to users.","     \"\"\""," ","+    # Pop a user only after their change is committed: a request served in between would","+    # cache the row as it was before the change.","     cache: TTLCache = TTLCache(maxsize=1024, ttl=CACHE_TTL)","+    # ``TTLCache`` is not thread-safe: requests read it on the event loop, while user updates pop","+    # from it in threadpool and WSGI threads. Hold this lock for every access to ``cache``.","+    cache_lock = threading.Lock()","     _user_fetch_locks: WeakValueDictionary[int, asyncio.Lock] = WeakValueDictionary()","     appbuilder: AirflowAppBuilder | None = None","     flask_app: Flask | None = None","@@ -326,14 +333,47 @@ def _validate_user(user: User | None, user_id: str) -> User:","             raise ValueError(f\"User with id {user_id} is not active\")","         return user"," ","-    @cachedmethod(lambda self: self.cache, key=lambda _, token: int(token[\"sub\"]))","+    @staticmethod","+    def _get_token_generation(token: dict[str, Any]) -> int:","+        # Tokens issued before the claim existed count as the initial generation.","+        token_generation = token.get(TOKEN_GENERATION_CLAIM, 0)","+        if type(token_generation) is not int:","+            raise ValueError(","+                f\"Token of user with id {token['sub']} has an invalid {TOKEN_GENERATION_CLAIM} claim\"","+            )","+        return token_generation","+","+    def _get_cached_user(self, user_id: int, token_generation: int) -> User | None:","+        \"\"\"","+        Return the cached user, unless the token is newer than it.","+","+        A newer token was issued after a password change that the cached user predates, so the","+        cached user is dropped: it must not match tokens from before the change either.","+        \"\"\"","+        with self.cache_lock:","+            user = self.cache.get(user_id)","+            if user is not None and user.token_generation < token_generation:","+                self.cache.pop(user_id, None)","+                return None","+        return user","+","     def deserialize_user(self, token: dict[str, Any]) -> User:","         user_id = int(token[\"sub\"])","+        token_generation = self._get_token_generation(token)","+        user = self._get_cached_user(user_id, token_generation)","+        if user is None:","+            user = self._load_active_user(user_id)","+            with self.cache_lock:","+                self.cache[user_id] = user","+        if token_generation != user.token_generation:","+            raise ValueError(f\"Token of user with id {user_id} was issued before their last password change\")","+        return user"," ","+    def _load_active_user(self, user_id: int) -> User:","         def _fetch_user() -> User:","             with create_session() as session:","                 user = session.scalars(select(User).where(User.id == user_id)).one_or_none()","-                return self._validate_user(user, token[\"sub\"])","+                return self._validate_user(user, str(user_id))"," ","         try:","             return _fetch_user()","@@ -359,27 +399,24 @@ async def deserialize_user_async(self, token: dict[str, Any]) -> User:","             return self.deserialize_user(token)"," ","         user_id = int(token[\"sub\"])","-        try:","-            return self.cache[user_id]","-        except KeyError:","-            pass","-","-        lock = self._user_fetch_locks.setdefault(user_id, asyncio.Lock())","-        async with lock:","-            try:","-                return self.cache[user_id]","-            except KeyError:","-                pass","-","-            async with create_session_async() as session:","-                user = (await session.scalars(select(User).where(User.id == user_id))).one_or_none()","-                user = self._validate_user(user, token[\"sub\"])","-","-            self.cache[user_id] = user","-            return user","+        token_generation = self._get_token_generation(token)","+        user = self._get_cached_user(user_id, token_generation)","+        if user is None:","+            lock = self._user_fetch_locks.setdefault(user_id, asyncio.Lock())","+            async with lock:","+                user = self._get_cached_user(user_id, token_generation)","+                if user is None:","+                    async with create_session_async() as session:","+                        user = (await session.scalars(select(User).where(User.id == user_id))).one_or_none()","+                        user = self._validate_user(user, token[\"sub\"])","+                    with self.cache_lock:","+                        self.cache[user_id] = user","+        if token_generation != user.token_generation:","+            raise ValueError(f\"Token of user with id {user_id} was issued before their last password change\")","+        return user"," ","     def serialize_user(self, user: User) -> dict[str, Any]:","-        return {\"sub\": str(user.id)}","+        return {\"sub\": str(user.id), TOKEN_GENERATION_CLAIM: user.token_generation}"," ","     def is_logged_in(self) -> bool:","         \"\"\"Return whether the user is logged in.\"\"\""],"additions":59,"deletions":22,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/models/__init__.py","lines":["@@ -276,6 +276,9 @@ class User(Model, BaseUser):","     last_login: Mapped[datetime.datetime | None] = mapped_column(DateTime, nullable=True)","     login_count: Mapped[int | None] = mapped_column(Integer, nullable=True)","     fail_login_count: Mapped[int | None] = mapped_column(Integer, nullable=True)","+    # Incremented on every password change. Tokens and sessions record the value they were issued","+    # under and stop being accepted once it moves on.","+    token_generation: Mapped[int] = mapped_column(Integer, nullable=False, default=0, server_default=\"0\")","     roles: Mapped[list[Role]] = relationship(","         \"Role\",","         secondary=assoc_user_role,"],"additions":3,"deletions":0,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/models/db.py","lines":["@@ -32,6 +32,7 @@"," _REVISION_HEADS_MAP: dict[str, str] = {","     \"1.4.0\": \"6709f7a774b9\",","     \"3.5.0\": \"02ca36b0235b\",","+    \"3.12.0\": \"20f2f9e27083\","," }"," "," "],"additions":1,"deletions":0,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/security_manager/override.py","lines":["@@ -614,6 +614,17 @@ def _hash_password(self, password: str) -> str:","         method = current_app.config.get(\"FAB_PASSWORD_HASH_METHOD\", \"scrypt\")","         return generate_password_hash(password, method=method)"," ","+    def set_user_password(self, user: User, password: str) -> None:","+        \"\"\"","+        Set a new password and invalidate the API tokens and Flask sessions issued under the old one.","+","+        Nothing is committed: the caller persists both changes together, normally with","+        ``update_user``.","+        \"\"\"","+        user.password = self._hash_password(password)","+        # Incremented in SQL so that concurrent password changes cannot write the same value.","+        user.token_generation = self.user_model.token_generation + 1","+","     def reset_password(self, userid: int, password: str) -> bool:","         \"\"\"","         Change/Reset a user's password for auth db.","@@ -626,7 +637,7 @@ def reset_password(self, userid: int, password: str) -> bool:","         user = self.get_user_by_id(userid)","         if not user:","             return False","-        user.password = self._hash_password(password)","+        self.set_user_password(user, password)","         self.reset_user_sessions(user)","         return self.update_user(user)"," ","@@ -660,17 +671,6 @@ def reset_user_sessions(self, user: User) -> None:","                     if session_user_id is not None and str(session_user_id) == str(user.id):","                         session.delete(s)","                 session.commit()","-        else:","-            safe_username = escape(user.username)","-            self._cli_safe_flash(","-                \"Since you are using `securecookie` session backend mechanism, we cannot prevent \"","-                f\"some old sessions for user {safe_username} to be reused.<br> If you want to make sure \"","-                \"that the user is logged out from all sessions, you should consider using \"","-                \"`database` session backend mechanism.<br> You can also change the 'secret_key` \"","-                \"webserver configuration for all your webserver instances and restart the webserver. \"","-                \"This however will logout all users from all sessions.\",","-                \"warning\",","-            )"," ","     def load_user_jwt(self, _jwt_header, jwt_data) -> User | None:","         identity = jwt_data[\"sub\"]","@@ -1712,6 +1712,10 @@ def update_user(self, user: User) -> bool:","             log.error(const.LOGMSG_ERR_SEC_UPD_USER, e)","             self.session.rollback()","             return False","+        from airflow.providers.fab.auth_manager.fab_auth_manager import FabAuthManager","+","+        with FabAuthManager.cache_lock:","+            FabAuthManager.cache.pop(user.id, None)","         return True"," ","     @staticmethod"],"additions":16,"deletions":12,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/migrations/versions/0002_3_12_0_add_token_generation_to_ab_user.py","lines":["@@ -0,0 +1,78 @@","+#","+# Licensed to the Apache Software Foundation (ASF) under one","+# or more contributor license agreements.  See the NOTICE file","+# distributed with this work for additional information","+# regarding copyright ownership.  The ASF licenses this file","+# to you under the Apache License, Version 2.0 (the","+# \"License\"); you may not use this file except in compliance","+# with the License.  You may obtain a copy of the License at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+","+\"\"\"","+Add token_generation to ab_user.","+","+Revision ID: 20f2f9e27083","+Revises: 02ca36b0235b","+Create Date: 2026-11-18 02:34:33.000000","+","+\"\"\"","+","+from __future__ import annotations","+","+from collections.abc import Iterator","+from contextlib import contextmanager","+","+import sqlalchemy as sa","+from alembic import op","+","+revision = \"20f2f9e27083\"","+down_revision = \"02ca36b0235b\"","+branch_labels = None","+depends_on = None","+fab_version = \"3.12.0\"","+","+","+@contextmanager","+def _sqlite_rebuilds() -> Iterator[None]:","+    \"\"\"","+    Run SQLite table rebuilds with foreign keys off, rolling back atomically on failure.","+","+    Same as ``airflow.migrations.utils.sqlite_rebuilds``, which Airflow versions this provider","+    supports do not all have. Dropping a column rebuilds ``ab_user`` on SQLite, and dropping the old","+    table with foreign keys on cascades into ``ab_user_role``, deleting every role assignment.","+    ``PRAGMA foreign_keys`` is ignored inside a transaction, hence the autocommit blocks.","+    \"\"\"","+    if op.get_bind().dialect.name != \"sqlite\":","+        yield","+        return","+    if op.get_context().as_sql:","+        raise RuntimeError(\"SQLite offline SQL cannot render this migration's table rebuilds\")","+    enabled = op.get_bind().exec_driver_sql(\"PRAGMA foreign_keys\").scalar()","+    with op.get_context().autocommit_block():","+        op.execute(\"PRAGMA foreign_keys=OFF\")","+    try:","+        with op.get_bind().begin_nested():","+            yield","+    finally:","+        with op.get_context().autocommit_block():","+            op.execute(f\"PRAGMA foreign_keys={1 if enabled else 0}\")","+","+","+def upgrade() -> None:","+    \"\"\"Add the token_generation column to ab_user.\"\"\"","+    with op.batch_alter_table(\"ab_user\", schema=None) as batch_op:","+        batch_op.add_column(sa.Column(\"token_generation\", sa.Integer(), nullable=False, server_default=\"0\"))","+","+","+def downgrade() -> None:","+    \"\"\"Remove the token_generation column from ab_user.\"\"\"","+    with _sqlite_rebuilds(), op.batch_alter_table(\"ab_user\", schema=None) as batch_op:","+        batch_op.drop_column(\"token_generation\")"],"additions":78,"deletions":0,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/www/app.py","lines":["@@ -38,6 +38,7 @@"," from airflow.providers.fab.www.extensions.init_session import (","     init_airflow_session_interface,","     init_session_max_lifetime,","+    init_session_token_generation,"," )"," from airflow.providers.fab.www.extensions.init_views import (","     init_error_handlers,","@@ -126,11 +127,15 @@ def remove_duplicate_date_header(response):","         # FAB auth manager. One example is ``run_update_fastapi_api_spec``, it calls","         # ``FabAuthManager().get_fastapi_app()`` to generate the openapi documentation regardless of the","         # configured auth manager.","+        is_fab_auth_manager = isinstance(get_auth_manager(), FabAuthManager)","         if enable_plugins:","             init_plugins(flask_app)","-        elif isinstance(get_auth_manager(), FabAuthManager):","+        elif is_fab_auth_manager:","             init_airflow_session_interface(flask_app, db)","             init_session_max_lifetime(flask_app)","+        if is_fab_auth_manager:","+            # The plugins app reads the FAB login session too, with the ``securecookie`` backend.","+            init_session_token_generation(flask_app)","         init_jinja_globals(flask_app, enable_plugins=enable_plugins)","         init_wsgi_middleware(flask_app)","     return flask_app"],"additions":6,"deletions":1,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/www/extensions/init_session.py","lines":["@@ -32,6 +32,8 @@"," log = logging.getLogger(__name__)"," "," SESSION_LOGIN_TIME_KEY = \"_login_at\"","+# The ``User.token_generation`` a Flask session was created under.","+SESSION_TOKEN_GENERATION_KEY = \"_token_generation\""," "," "," def init_airflow_session_interface(app, db):","@@ -121,3 +123,22 @@ def expire_session_past_max_lifetime():","             # crossed the deadline is itself unauthenticated.","             logout_user()","             builtin_flask_session.pop(SESSION_LOGIN_TIME_KEY, None)","+","+","+def _record_session_token_generation(sender, user, **kwargs) -> None:","+    builtin_flask_session[SESSION_TOKEN_GENERATION_KEY] = user.token_generation","+","+","+def _end_session_from_before_password_change() -> None:","+    # Sessions created before the key existed count as the initial generation.","+    if current_user.is_authenticated and (","+        builtin_flask_session.get(SESSION_TOKEN_GENERATION_KEY, 0) != current_user.token_generation","+    ):","+        logout_user()","+","+","+def init_session_token_generation(app):","+    \"\"\"End sessions created before their user's last password change.\"\"\"","+    # Scoped to this app: ``user_logged_in`` is shared by every Flask app in the process.","+    user_logged_in.connect(_record_session_token_generation, sender=app)","+    app.before_request(_end_session_from_before_password_change)"],"additions":21,"deletions":0,"truncated":false},{"path":"providers/fab/tests/unit/fab/auth_manager/api_fastapi/services/test_users.py","lines":["@@ -666,12 +666,10 @@ def test_update_user_with_password(self, get_fab_auth_manager, fab_auth_manager,","             password=password_mock,","         )"," ","-        security_manager._hash_password.return_value = \"hashed_password\"","         FABAuthManagerUsers.update_user(\"alice\", patch_body, update_mask=\"password\")"," ","         password_mock.get_secret_value.assert_called_once()","-        security_manager._hash_password.assert_called_once_with(\"newpassword\")","-        assert user_obj.password == \"hashed_password\"","+        security_manager.set_user_password.assert_called_once_with(user_obj, \"newpassword\")"," ","     # delete_user tests"," "],"additions":1,"deletions":3,"truncated":false},{"path":"providers/fab/tests/unit/fab/auth_manager/security_manager/test_override.py","lines":["@@ -24,11 +24,14 @@"," import requests"," from authlib.jose import JsonWebKey, jwt as authlib_jwt"," from authlib.jose.errors import InvalidClaimError","+from cachetools import TTLCache"," from flask import Flask"," from flask_appbuilder import const"," from sqlalchemy.exc import IntegrityError"," from sqlalchemy.orm import Session"," ","+from airflow.api_fastapi.auth.managers.base_auth_manager import BaseAuthManager","+from airflow.providers.fab.auth_manager.fab_auth_manager import FabAuthManager"," from airflow.providers.fab.auth_manager.models import (","     Action,","     Group,","@@ -468,6 +471,25 @@ def test_update_user_clears_cached_permissions(self):","         assert mock_merged_user._perms is None","         mock_session.commit.assert_called_once_with()"," ","+    @mock.patch(\"airflow.providers.fab.www.utils.get_auth_manager\", autospec=True)","+    @mock.patch.object(FabAuthManager, \"cache\", new_callable=lambda: TTLCache(maxsize=1, ttl=60))","+    @mock.patch.object(EmptySecurityManager, \"session\", new_callable=lambda: Mock(spec=Session))","+    def test_update_user_drops_cached_user_without_needing_fab_auth_manager(","+        self, mock_session, cache, mock_get_auth_manager","+    ):","+        \"\"\"","+        ``update_user`` drops the user from ``FabAuthManager.cache`` even when the configured auth","+        manager is not a ``FabAuthManager``, instead of failing after the change is committed.","+        \"\"\"","+        mock_get_auth_manager.return_value = Mock(spec=BaseAuthManager)","+        mock_session.get.return_value = None","+        user = Mock(spec=User, id=1, roles=[], groups=[])","+        cache[user.id] = Mock(spec=User)","+","+        assert EmptySecurityManager().update_user(user)","+","+        assert user.id not in cache","+",