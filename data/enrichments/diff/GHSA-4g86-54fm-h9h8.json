{"id":"GHSA-4g86-54fm-h9h8","axis":"advisories","repo":"microsoft/aspire","sha":"0b6bfe2f538d4eed8a9ae7e11651c09dbbe886b8","parsed":{"files":[{"path":"src/Aspire.Dashboard/Authentication/DashboardAuthenticationState.cs","lines":["@@ -0,0 +1,29 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using Aspire.Dashboard.Configuration;","+using Microsoft.AspNetCore.Components.Authorization;","+","+namespace Aspire.Dashboard.Authentication;","+","+internal static class DashboardAuthenticationState","+{","+    /// <summary>","+    /// Double-checks authentication state inside the dashboard as a defense-in-depth measure.","+    /// Use in main layouts and infrastructure that launches UI.","+    /// </summary>","+    public static async Task EnsureAuthenticatedAsync(","+        DashboardOptions dashboardOptions,","+        Task<AuthenticationState>? authenticationState)","+    {","+        if (dashboardOptions.Frontend.AuthMode is FrontendAuthMode.Unsecured or null)","+        {","+            return;","+        }","+","+        if (authenticationState is null || (await authenticationState.ConfigureAwait(false)).User.Identity?.IsAuthenticated is not true)","+        {","+            throw new InvalidOperationException(\"Dashboard authentication is required, but the current user is not authenticated.\");","+        }","+    }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"src/Aspire.Dashboard/Components/Controls/DashboardNotAuthorized.razor","lines":["@@ -0,0 +1,4 @@","+@if (DashboardOptions.Value.Frontend.AuthMode != FrontendAuthMode.BrowserToken)","+{","+    @Loc[nameof(Resources.Routes.NotAuthorized)]","+}"],"additions":4,"deletions":0,"truncated":false},{"path":"src/Aspire.Dashboard/Components/Controls/DashboardNotAuthorized.razor.cs","lines":["@@ -0,0 +1,37 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using Aspire.Dashboard.Configuration;","+using Aspire.Dashboard.Utils;","+using Microsoft.AspNetCore.Components;","+using Microsoft.AspNetCore.WebUtilities;","+using Microsoft.Extensions.Localization;","+using Microsoft.Extensions.Options;","+","+namespace Aspire.Dashboard.Components.Controls;","+","+public sealed partial class DashboardNotAuthorized : ComponentBase","+{","+    [Inject]","+    public required NavigationManager NavigationManager { get; init; }","+","+    [Inject]","+    public required IOptions<DashboardOptions> DashboardOptions { get; init; }","+","+    [Inject]","+    public required IStringLocalizer<Resources.Routes> Loc { get; init; }","+","+    protected override void OnInitialized()","+    {","+        if (DashboardOptions.Value.Frontend.AuthMode == FrontendAuthMode.BrowserToken)","+        {","+            // Preserve the path base in both URLs, and keep the return URL local so login validation accepts it.","+            var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);","+            var returnUrl = currentUri.PathAndQuery + currentUri.Fragment;","+            var loginUri = NavigationManager.ToAbsoluteUri(DashboardUrls.LoginBasePath);","+            var loginUrl = QueryHelpers.AddQueryString(loginUri.AbsoluteUri, \"returnUrl\", returnUrl);","+","+            NavigationManager.NavigateTo(loginUrl, new NavigationOptions { ReplaceHistoryEntry = true });","+        }","+    }","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"src/Aspire.Dashboard/Components/Interactions/InteractionsProvider.cs","lines":["@@ -4,8 +4,10 @@"," using System.Collections.ObjectModel;"," using System.Diagnostics;"," using System.Net;","+using Aspire.Dashboard.Authentication;"," using Aspire.Dashboard.Components.Dialogs;"," using Aspire.Dashboard.Components.Pages;","+using Aspire.Dashboard.Configuration;"," using Aspire.Dashboard.Model;"," using Aspire.Dashboard.Model.Interaction;