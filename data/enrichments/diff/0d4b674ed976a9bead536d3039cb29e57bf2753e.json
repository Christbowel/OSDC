EY\"],","-            session_token=crawler.settings[\"AWS_SESSION_TOKEN\"],","+            access_key=crawler.settings.getsecret(\"AWS_ACCESS_KEY_ID\"),","+            secret_key=crawler.settings.getsecret(\"AWS_SECRET_ACCESS_KEY\"),","+            session_token=crawler.settings.getsecret(\"AWS_SESSION_TOKEN\"),","             acl=crawler.settings[\"FEED_STORAGE_S3_ACL\"] or None,","             endpoint_url=crawler.settings[\"AWS_ENDPOINT_URL\"] or None,","             region_name=crawler.settings[\"AWS_REGION_NAME\"] or None,"],"additions":3,"deletions":3,"truncated":false},{"path":"scrapy/pipelines/files.py","lines":["@@ -173,9 +173,9 @@ class S3FilesStore:","     # checksums that were requested when the object was uploaded.","     checksum_algorithm: str = \"md5\""," ","-    AWS_ACCESS_KEY_ID = None","-    AWS_SECRET_ACCESS_KEY = None","-    AWS_SESSION_TOKEN = None","+    AWS_ACCESS_KEY_ID: str | None = None","+    AWS_SECRET_ACCESS_KEY: str | None = None","+    AWS_SESSION_TOKEN: str | None = None","     AWS_ENDPOINT_URL = None","     AWS_REGION_NAME = None","     AWS_USE_SSL = None","@@ -201,9 +201,9 @@ def _get_config(","     ) -> dict[str, Any]:","         settings = crawler.settings","         return {","-            \"AWS_ACCESS_KEY_ID\": settings[\"AWS_ACCESS_KEY_ID\"],","-            \"AWS_SECRET_ACCESS_KEY\": settings[\"AWS_SECRET_ACCESS_KEY\"],","-            \"AWS_SESSION_TOKEN\": settings[\"AWS_SESSION_TOKEN\"],","+            \"AWS_ACCESS_KEY_ID\": settings.getsecret(\"AWS_ACCESS_KEY_ID\"),","+            \"AWS_SECRET_ACCESS_KEY\": settings.getsecret(\"AWS_SECRET_ACCESS_KEY\"),","+            \"AWS_SESSION_TOKEN\": settings.getsecret(\"AWS_SESSION_TOKEN\"),","             \"AWS_ENDPOINT_URL\": settings[\"AWS_ENDPOINT_URL\"],","             \"AWS_REGION_NAME\": settings[\"AWS_REGION_NAME\"],","             \"AWS_USE_SSL\": settings[\"AWS_USE_SSL\"],","@@ -489,7 +489,7 @@ def _get_config(","         settings = crawler.settings","         return {","             \"FTP_USERNAME\": settings[\"FTP_USER\"],","-            \"FTP_PASSWORD\": settings[\"FTP_PASSWORD\"],","+            \"FTP_PASSWORD\": settings.getsecret(\"FTP_PASSWORD\"),","             \"USE_ACTIVE_MODE\": settings.getbool(\"FEED_STORAGE_FTP_ACTIVE\"),","             \"UPLOAD_TIMEOUT\": settings.getfloat(\"UPLOAD_TIMEOUT\") or None,","         }"],"additions":7,"deletions":7,"truncated":false},{"path":"scrapy/settings/__init__.py","lines":["@@ -11,6 +11,7 @@"," "," from scrapy.exceptions import ScrapyDeprecationWarning"," from scrapy.settings import default_settings","+from scrapy.utils._secrets import _resolve_secret"," from scrapy.utils.misc import load_object"," from scrapy.utils.python import global_object_name"," ","@@ -322,6 +323,19 @@ def getdictorlist(","             )","         return copy.deepcopy(value)"," ","+    def getsecret(self, name: str, default: str | None = None) -> str | None:","+        \"\"\"Get a setting value as a string, resolving :ref:`secret references","+        <secret-settings>`.","+","+        If the setting is not defined or its value is ``None``, *default* is","+        returned. If the referenced environment variable or keyring entry does","+        not exist, :exc:`KeyError` is raised.","+        \"\"\"","+        value = self.get(name)","+        if value is None:","+            return default","+        return _resolve_secret(value)","+","     def getwithbase(self, name: str) -> BaseSettings:","         \"\"\"Get a composition of a dictionary-like setting and its ``_BASE``","         counterpart."],"additions":14,"deletions":0,"truncated":false},{"path":"scrapy/utils/_secrets.py","lines":["@@ -0,0 +1,78 @@","+from __future__ import annotations","+","+import json","+import os","+from typing import Any","+","+from scrapy.utils.misc import load_object","+","+_SOURCES = {\"env\", \"keyring\", \"raw\"}","+","+","+def _resolve_secret(value: Any) -> str:","+    \"\"\"Return the secret that *value* holds or references.","+","+    See :ref:`secret-settings` for the supported references.","+    \"\"\"","+    if isinstance(value, dict):","+        spec = value","+    elif isinstance(value, str):","+        try:","+            spec = json.loads(value)","+        except ValueError:","+            return value","+        # Any other JSON value, e.g. a service-account blob, is a literal","+        # secret.","+        if not isinstance(spec, dict) or not _SOURCES & spec.keys():","+            return value","+    else:","+        return str(value)","+","+    if \"raw\" in spec:","+        raw = spec[\"raw\"]","+        return raw if isinstance(raw, str) else json.dumps(raw)","+    if \"env\" in spec:","+        try:","+            return os.environ[spec[\"env\"]]","+        except KeyError:","+            raise KeyError(f\"Environment variable {spec['env']!r} is not set\") from None","+    if \"keyring\" in spec:","+        return _resolve_keyring(spec[\"keyring\"])","+    raise ValueError(","+        f\"Secret references need one of these keys: {', '.join(sorted(_SOURCES))}\"","+    )","+","+","+def _resolve_keyring(kr: Any) -> str:","+    try:","+        import keyring  # noqa: PLC0415","+    except ImportError:","+        raise ImportError(","+            \"Install the 'keyring' package to use keyring-based secrets: \"","+            \"pip install keyring\"","+        ) from None","+","+    if isinstance(kr, str):","+        username: str = kr","+        service: str = \"scrapy\"","+        backend_path: str | None = None","+    elif isinstance(kr, dict):","+        if \"username\" not in kr:","+            raise ValueError('\"keyring\" object must have a \"username\" key')","+        username = kr[\"username\"]","+        service = kr.get(\"service\", \"scrapy\")","+        backend_path = kr.get(\"backend\")","+    else:","+        raise ValueError('\"keyring\" must be a string or an object')","+","+    if backend_path is not None:","+        backend_cls = load_object(backend_path)","+        value: str | None = backend_cls().get_password(service, username)","+    else:","+        value = keyring.get_password(service, username)","+","+    if value is None:","+        raise KeyError(","+            f\"No keyring entry found for service={service!r}, username={username!r}\"","+        )","+    return value"],"additions":78,"deletions":0,"truncated":false},{"path":"tests/test_settings/test_secrets.py","lines":["@@ -0,0 +1,136 @@","+from __future__ import annotations","+","+import sys","+from typing import Any","+","+import pytest","+","+from scrapy.settings import BaseSettings","+","+","+class _InMemoryKeyring:","+    passwords = {(\"myservice\", \"myuser\"): \"backend-secret\"}","+","+    def get_password(self, service: str, username: str) -> str | None:","+        return self.passwords.get((service, username))","+","+","+def _getsecret(value: Any, default: str | None = None) -> str | None:","+    return BaseSettings({\"SECRET\": value}).getsecret(\"SECRET\", default)","+","+","+@pytest.mark.parametrize(","+    (\"value\", \"expected\"),","+    [","+        (\"my-api-key\", \"my-api-key\"),","+        (\"\", \"\"),","+        (42, \"42\"),","+        ('\"json-string\"', '\"json-string\"'),","+        ('[\"a\", \"b\"]', '[\"a\", \"b\"]'),","+        (\"not {json}\", \"not {json}\"),","+        ('{\"type\": \"service_account\"}', '{\"type\": \"service_account\"}'),","+        ('{\"raw\": \"literal\"}', \"literal\"),","+        ({\"raw\": \"literal\"}, \"literal\"),","+        ('{\"raw\": {\"env\": \"production\"}}', '{\"env\": \"production\"}'),","+        ({\"raw\": [1, 2]}, \"[1, 2]\"),","+    ],","+)","+def test_literal(value: Any, expected: str) -> None:","+    assert _getsecret(value) == expected","+","+","+@pytest.mark.parametrize((\"default\", \"expected\"), [(None, None), (\"foo\", \"foo\")])","+def test_unset(default: str | None, expected: str | None) -> None:","+    assert BaseSettings().getsecret(\"SECRET\", default) == expected","+    assert _getsecret(None, default) == expected","+","+","+@pytest.mark.parametrize(\"value\", ['{\"env\": \"MY_SECRET\"}', {\"env\": \"MY_SECRET\"}])","+def test_env(value: Any, monkeypatch: pytest.MonkeyPatch) -> None:","+    monkeypatch.setenv(\"MY_SECRET\", \"s3cr3t\")","+    assert _getsecret(value, \"default\") == \"s3cr3t\"","+","+","+def test_env_missing(monkeypatch: pytest.MonkeyPatch) -> None:","+    monkeypatch.delenv(\"MY_SECRET\", raising=False)","+    with pytest.raises(KeyError, match=\"MY_SECRET\"):","+        _getsecret({\"env\": \"MY_SECRET\"}, \"default\")","+","+","+def test_unknown_reference() -> None:","+    with pytest.raises(ValueError, match=\"env, keyring, raw\"):","+        _getsecret({\"type\": \"service_account\"})","+","+","+@pytest.mark.requires_keyring","+@pytest.mark.parametrize(","+    (\"value\", \"service\", \"username\"),","+    [","+        ('{\"keyring\": \"myuser\"}', \"scrapy\", \"myuser\"),","+        ({\"keyring\": {\"username\": \"myuser\"}}, \"scrapy\", \"myuser\"),","+        (","+            {\"keyring\": {\"username\": \"myuser\", \"service\": \"myservice\"}},","+            \"myservice\",","+            \"myuser\",","+        ),","+    ],","+)","+def test_keyring(","+    value: Any, service: str, username: str, monkeypatch: pytest.MonkeyPatch","+) -> None:","+    import keyring  # noqa: PLC0415","+","+    calls = []","+","+    def get_password(service: str, username: str) -> str:","+        calls.append((service, username))","+        return \"keyring-secret\"","+","+    monkeypatch.setattr(keyring, \"get_password\", get_password)","+    assert _getsecret(value) == \"keyring-secret\"","+    assert calls == [(service, username)]","+","+","+@pytest.mark.requires_keyring","+def test_keyring_backend() -> None:","+    value = {","+        \"keyring\": {","+            \"username\": \"myuser\",","+            \"service\": \"myservice\",","+            \"backend\": f\"{__name__}._InMemoryKeyring\",","+        }","+    }","+    assert _getsecret(value) == \"backend-secret\"","+","+","+@pytest.mark.requires_keyring","+def test_keyring_missing() -> None:","+    import keyring  # noqa: PLC0415","+    from keyring.backends.null import Keyring  # noqa: PLC0415","+","+    original = keyring.get_keyring()","+    keyring.set_keyring(Keyring())","+    try:","+        with pytest.raises(KeyError, match=\"myuser\"):","+            _getsecret({\"keyring\": \"myuser\"})","+    finally:","+        keyring.set_keyring(original)","+","+","+@pytest.mark.requires_keyring","+@pytest.mark.parametrize(","+    (\"value\", \"match\"),","+    [","+        ({\"keyring\": 42}, '\"keyring\" must be'),","+        ({\"keyring\": {\"service\": \"myservice\"}}, '\"username\" key'),","+    ],","+)","+def test_keyring_invalid(value: Any, match: str) -> None:","+    with pytest.raises(ValueError, match=match):","+        _getsecret(value)","+","+","+def test_keyring_not_installed(monkeypatch: pytest.MonkeyPatch) -> None:","+    monkeypatch.setitem(sys.modules, \"keyring\", None)","+    with pytest.raises(ImportError, match=\"keyring\"):","+        _getsecret({\"keyring\": \"myuser\"})"],"additions":136,"deletions":0,"truncated":false},{"path":"tox.ini","lines":["@@ -69,6 +69,7 @@ deps =","     mypy==2.4.1","     typing-extensions==4.16.0","     Pillow==13.0.0","+    keyring==22.3.0","     Protego==0.7.0","     Twisted==26.10.0","     aiodns==4.0.4","@@ -187,6 +188,7 @@ basepython = python3"," deps =","     {[testenv]deps}","     Pillow","+    keyring","     Twisted[http2]","     python-socks[asyncio]","     siosocks  # SOCKS server for tests","@@ -208,6 +210,7 @@ basepython = {[min]basepython}"," deps =","     {[min]deps}","     Pillow==9.2.0","+    keyring==21.7.0","     Twisted[http2]==23.10.0","     h2==3.2.0","     python-socks[asyncio]==2.6.0",""],"additions":3,"deletions":0,"truncated":false}],"additions":314,"deletions":16,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-13T17:03:58.913527+00:00"}