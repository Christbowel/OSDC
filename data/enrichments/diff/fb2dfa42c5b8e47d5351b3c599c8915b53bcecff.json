"dependencies\"][\"lib\"], \"workspace:^0.0.0-preview\");","+}","+"," #[test]"," fn intent_files_consumed_only_by_lane_prereleases_survive_until_graduation() {","     let workspace = make_workspace(&[(\"cli\", \"2.0.0\", &[])]);"],"additions":70,"deletions":11,"truncated":false},{"path":"pnpm/crates/versioning/src/error.rs","lines":["@@ -52,7 +52,7 @@ pub enum VersioningError {","     UnreleasablePackage { file_path: PathBuf, pkg_name: String, bump_type: String },"," ","     #[display(","-        \"Package {pkg_name} declares the internal dependency {alias} in {field} as \\\"{spec}\\\". Internal dependencies must use the workspace: protocol so that dependency ranges never need rewriting at release time.\"","+        \"Package {pkg_name} declares the internal dependency {alias} in {field} as \\\"{spec}\\\". Internal dependencies must use the workspace: protocol.\"","     )]","     #[diagnostic(code(ERR_PNPM_VERSIONING_INTERNAL_RANGE))]","     InternalRange { pkg_name: String, alias: String, field: String, spec: String },"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/versioning/src/plan.rs","lines":["@@ -6,6 +6,7 @@ pub use project_refs::{","     to_project_dir,"," };"," pub use versions::materialize_workspace_range;","+pub(crate) use versions::updated_workspace_spec;"," "," use std::{","     collections::{"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/versioning/src/plan/versions.rs","lines":["@@ -357,11 +357,7 @@ pub(super) fn enforce_epic_bands("," /// new version falls outside this range."," #[must_use]"," pub fn materialize_workspace_range(spec: &str, dep_current_version: &str) -> Option<String> {","-    let rest = spec.strip_prefix(\"workspace:\")?;","-    let range = match parse_workspace_spec_alias(rest) {","-        Some(alias) => &rest[alias.len() + 1..],","-        None => rest,","-    };","+    let (_, range) = split_workspace_spec(spec)?;","     Some(match range {","         \"^\" => format!(\"^{dep_current_version}\"),","         \"~\" => format!(\"~{dep_current_version}\"),","@@ -370,6 +366,36 @@ pub fn materialize_workspace_range(spec: &str, dep_current_version: &str) -> Opt","     })"," }"," ","+fn split_workspace_spec(spec: &str) -> Option<(Option<&str>, &str)> {","+    let rest = spec.strip_prefix(\"workspace:\")?;","+    let alias = parse_workspace_spec_alias(rest);","+    Some((alias, alias.map_or(rest, |name| &rest[name.len() + 1..])))","+}","+","+pub(crate) fn updated_workspace_spec(","+    alias: &str,","+    spec: &str,","+    updates: &std::collections::HashMap<&str, &str>,","+) -> Option<String> {","+    let (target, range) = split_workspace_spec(spec)?;","+    let next = updates.get(target.unwrap_or(alias))?;","+    if matches!(range, \"\" | \"*\" | \"^\" | \"~\") {","+        return None;","+    }","+    let parsed = parse_strict_semver_range(range)?;","+    if Version::parse(next).ok()?.satisfies(&parsed) {","+        return None;","+    }","+    let version = range","+        .strip_prefix(['^', '~'])","+        .unwrap_or(range);","+    if Version::parse(version.trim()).is_ok() {","+        Some(format!(\"{}{next}\", spec.strip_suffix(version)?))","+    } else {","+        Some(format!(\"{spec} || {next}\"))","+    }","+}","+"," pub(super) fn range_accepts(range: &str, version: &str) -> bool {","     let (Some(range), Ok(version)) = (parse_strict_semver_range(range), Version::parse(version))","     else {"],"additions":31,"deletions":5,"truncated":false},{"path":"pnpm/docs/cli/version.md","lines":["@@ -35,6 +35,8 @@ pnpm version -r"," "," This assembles a release plan from the `.changeset/*.md` intent files and applies it: every package named by an intent is bumped, and so is every package that depends on it through a `workspace:` range. It then writes changelogs and records the consumed intents in `.changeset/ledger.yaml`."," ","+When a dependency bump falls outside an explicit workspace range, pnpm updates the range in the dependent package. For example, a major bump from 1.0.0 to 2.0.0 updates `workspace:^1.0.0` to `workspace:^2.0.0`. For a compound range, pnpm keeps the existing range and adds the exact release version with `||`. Shorthand ranges such as `workspace:^` keep their spelling.","+"," Private packages (`\"private\": true`) are bumped without checking the registry for their [first release](../versioning.md#first-releases), and their changelog is always written to the committed `CHANGELOG.md`, even when [`versioning.changelog.storage`](../settings/versioning.md#versioningchangelogstorage) is `registry`."," "," Preview the plan without touching anything:","@@ -47,7 +49,7 @@ Narrow it to part of the workspace with `--filter`. The selection is expanded un"," "," The working tree must be clean unless `--dry-run` or `--no-git-checks` is passed. See [Release management](../versioning.md) for the full workflow."," ","-A bump runs the `preversion`, `version`, and `postversion` scripts of each bumped package. `--dry-run` and [`ignoreScripts`](../settings/build.md#ignorescripts) skip them.","+A bump runs the `preversion`, `version`, and `postversion` scripts of each bumped package. The version bump preserves other manifest fields edited by `preversion`. `--dry-run` and [`ignoreScripts`](../settings/build.md#ignorescripts) skip them."," "," Outside a workspace, the bare `pnpm version -r` fails with `ERR_PNPM_WORKSPACE_ONLY`."," "],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm11/docs/cli/version.md","lines":["@@ -39,6 +39,8 @@ pnpm version -r"," "," This assembles a release plan from the `.changeset/*.md` intent files and applies it: every package named by an intent is bumped, and so is every package that depends on it through a `workspace:` range. It then writes changelogs and records the consumed intents in `.changeset/ledger.yaml`."," ","+When a dependency bump falls outside an explicit workspace range, pnpm updates the range in the dependent package. For example, a major bump from 1.0.0 to 2.0.0 updates `workspace:^1.0.0` to `workspace:^2.0.0`. For a compound range, pnpm keeps the existing range and adds the exact release version with `||`. Shorthand ranges such as `workspace:^` keep their spelling.","+"," Private packages (`\"private\": true`) are bumped without checking the registry for their [first release](../versioning.md#first-releases), and their changelog is always written to the committed `CHANGELOG.md`, even when [`versioning.changelog.storage`](../settings/versioning.md#versioningchangelogstorage) is `registry`."," "," Preview the plan without touching anything:","@@ -51,7 +53,7 @@ Narrow it to part of the workspace with `--filter`. The selection is expanded un"," "," The working tree must be clean unless `--dry-run` or `--no-git-checks` is passed. See [Release management](../versioning.md) for the full workflow."," ","-A bump runs the `preversion`, `version`, and `postversion` scripts of each bumped package. `--dry-run` and [`ignoreScripts`](../settings/build.md#ignorescripts) skip them.","+A bump runs the `preversion`, `version`, and `postversion` scripts of each bumped package. The version bump preserves other manifest fields edited by `preversion`. `--dry-run` and [`ignoreScripts`](../settings/build.md#ignorescripts) skip them."," "," ## Options"," "],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm11/releasing/commands/src/version/index.ts","lines":["@@ -18,6 +18,7 @@ import {","   toProjectDir,"," } from '@pnpm/releasing.versioning'"," import type { Project, ProjectsGraph } from '@pnpm/types'","+import { readExactProjectManifest } from '@pnpm/workspace.project-manifest-reader'"," import { safeExeca as execa } from 'execa'"," import { pick } from 'ramda'"," import { inc, valid } from 'semver'","@@ -322,7 +323,8 @@ interface BumpPackageVersionOptions {"," }"," "," async function bumpPackageVersion ({ pkgDir, rawBump, explicitVersion, opts }: BumpPackageVersionOptions): Promise<VersionChange | null> {","-  const { manifest, wr