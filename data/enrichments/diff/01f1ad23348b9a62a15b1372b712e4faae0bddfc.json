src/main/java/io/micronaut/context/python/GraalPyContextFactory.java","lines":["@@ -92,8 +92,10 @@ def __micronaut_load_vfs_module(module_path):","      * Python code that completes the members of every Java object with what GraalPy host interop does not","      * resolve: the trailing-underscore aliases of members named after a Python keyword","      * ({@code builder.from_(...)} for {@code Builder.from(...)}, {@code spec.and_(other)} for","-     * {@code Specification.and(other)}), and the public methods a class inherits from a non-public","-     * superclass (see {@link PythonHostMembers}).","+     * {@code Specification.and(other)}), the public methods a class inherits from a non-public","+     * superclass (see {@link PythonHostMembers}), and the snake_case methods and read-only getter","+     * properties the compiler computed for the Java types the sources reference","+     * ({@code request.basic_auth(...)}, {@code server.port}).","      * <p>","      * The compiler rewrites keyword aliases only on names it can resolve statically (imported Java","      * classes and {@code java.type(...)} aliases). Objects that Java returns at runtime are plain GraalPy","@@ -101,7 +103,11 @@ def __micronaut_load_vfs_module(module_path):","      * {@code polyglot.register_interop_type} for {@code java.lang.Object} enters the type of every host","      * object instance and its {@code __getattr__} runs only after the regular foreign member lookup has","      * failed, retrying with the underscore stripped (the rule the compiler applies, {@code keyword.iskeyword},","-     * so the same spelling works everywhere) and then asking the runtime for an inherited member.","+     * so the same spelling works everywhere), then asking the runtime for an inherited member, then for","+     * the snake_case method or getter property the compiler recorded for the object's class or one of its","+     * supertypes ({@link PythonJavaInstanceMembers}). The names are read once per class loader and shared","+     * by all contexts, no Java member is inspected at run time, and a real member of the object always","+     * comes first.","      * <p>","      * It makes every {@link Exception} an instance of the Python {@code Exception} class, so that","      * {@code except Exception} catches the exceptions of Java calls ({@link Error}s remain only a","@@ -111,7 +117,7 @@ def __micronaut_load_vfs_module(module_path):","      * awaitable, whichever Java call returned it (see {@link PythonAsyncioRuntime#awaitJava}).","      */","     private static final Source JAVA_OBJECT_MEMBERS_SOURCE = Source.newBuilder(PYTHON, \"\"\"","-        def __micronaut_register_java_object_members():","+        def __micronaut_register_java_object_members(instance_members):","             import keyword","             import java","             from polyglot import register_interop_type","@@ -130,6 +136,12 @@ def __getattr__(self, name):","                         member = host_members.inheritedMember(self, name)","                         if member is not None:","                             return member","+                        alias = instance_members.methodAlias(self, name)","+                        if alias is not None:","+                            return getattr(self, alias)","+                        getter = instance_members.propertyGetter(self, name)","+                        if getter is not None:","+                            return getattr(self, getter)()","                     raise AttributeError(f\"foreign object has no attribute '{name}'\")"," ","             register_interop_type(java.type('java.lang.Object'), MicronautJavaObject)","@@ -158,8 +170,8 @@ def __await__(self):","                 except (KeyError, ImportError, TypeError):","                     pass  # absent, or excluded by graalpy.context.host-class-lookup"," ","-        __micronaut_register_java_object_members()","-        del __micronaut_register_java_object_members","+        # the value of the source: the function, no longer bound in __main__","+        globals().pop('__micronaut_register_java_object_members')","         \"\"\", \"micronaut-java-object-members.py\").cached(true).buildLiteral();","     /**","      * Installs the Python view of the generated Java wrappers ({@link ValueCoercible}). A wrapper a","@@ -242,12 +254,14 @@ public GraalPyContextFactory(ApplicationContext applicationContext) {"," ","     /**","      * Complete the members of the Java objects of a context: keyword-safe aliases, inherited public","-     * methods, {@code await} on stages and publishers, and Java exceptions caught by {@code except Exception}.","+     * methods, snake_case methods and getter properties, {@code await} on stages and publishers, and Java","+     * exceptions caught by {@code except Exception}.","      *","      * @param context The context","+     * @param classLoader The class loader of the application, whose compilations recorded the names","      */","-    static void registerJavaObjectMembers(Context context) {","-        context.eval(JAVA_OBJECT_MEMBERS_SOURCE);","+    static void registerJavaObjectMembers(Context context, ClassLoader classLoader) {","+        context.eval(JAVA_OBJECT_MEMBERS_SOURCE).executeVoid(PythonJavaInstanceMembers.of(classLoader));","     }"," ","     /**","@@ -450,7 +464,7 @@ static Context buildContext(HostAccess hostAccess,","             // the public methods GraalPy does not expose because a non-public superclass declares them, and","             // their exceptions to `except Exception`","             now = System.currentTimeMillis();","-            registerJavaObjectMembers(context);","+            registerJavaObjectMembers(context, classLoader);","             LOG.debug(\"GraalPy Java object members registered in {}ms\", System.currentTimeMillis() - now);","             // Before the application modules import: the Java packages, types and annotations they import","             // are served by the finder of the runtime module, from the manifests the compiler wrote"],"additions":24,"deletions":10,"truncated":false},{"path":"context-python/src/main/java/io/micronaut/context/python/PythonJavaInstanceMembers.java","lines":["@@ -0,0 +1,177 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.context.python;","+","+import io.micronaut.core.annotation.Internal;","+import io.micronaut.core.annotation.UsedByGeneratedCode;","+import org.jspecify.annotations.Nullable;","+","+import java.io.BufferedReader;","+import java.io.IOException;","+import java.io.InputStream;","+import java.io.InputStreamReader;","+import java.io.UncheckedIOException;","+import java.net.URL;","+import java.nio.charset.StandardCharsets;","+import java.util.Collections;","+import java.util.Enumeration;","+import java.util.HashMap;","+import java.util.LinkedHashSet;","+import java.util.Map;","+import java.util.Set;","+import java.util.WeakHashMap;","+","+/**","+ * The snake_case methods and read-only getter properties the Python compiler computed for the Java types","+ * the sources reference, which the Java object fallback of every context answers with (see","+ * {@link GraalPyContextFactory}).","+ * <p>","+ * Each compilation writes its names to {@value #RESOURCE}, one line per name: the binary name of the Java","+ * type, the Python name, the Java method and {@code property}, {@code method} or {@code blocked}. They are","+ * read once per class loader and shared by all its contexts, so a context holds no table of its own. A","+ * name applies to the instances of the type and of its implementations: the class of a receiver is","+ * matched, once per class, through the names of its superclasses and interfaces, without loading the","+ * recorded types or inspecting a member. A name that two of them define differently, or one blocks as","+ * ambiguous, is no alias.","+ *","+ * @since 5.3.0","+ */","+@Internal","+public final class PythonJavaInstanceMembers {","+","+    /** The resource each compilation records its names in. */","+    public static final String RESOURCE = \"META-INF/pyronaut/java-instance-members.tsv\";","+","+    private static final String PROPERTY = \"property\";","+    private static final String METHOD = \"method\";","+    private static final Member BLOCKED = new Member(\"\", false);","+    private static final Map<ClassLoader, PythonJavaInstanceMembers> BY_CLASS_LOADER = Collections.synchronizedMap(new WeakHashMap<>());","+","+    // binary name of a Java type -> Python name -> member","+    private final Map<String, Map<String, Member>> types;","+    // ClassValue does not keep the receiver's class loader alive.","+    private final ClassValue<Map<String, Member>> members = new ClassValue<>() {","+        @Override","+        protected Map<String, Member> computeValue(Class<?> type) {","+            Map<String, Member> result = new HashMap<>();","+            for (Class<?> current : hierarchy(type)) {","+                Map<String, Member> recorded = types.get(current.getName());","+                if (recorded != null) {","+                    recorded.forEach((name, member) -> result.merge(name, member, (first, second) -> first.equals(second) ? first : BLOCKED));","+                }","+            }","+            return result.isEmpty() ? Map.of() : Map.copyOf(result);","+        }","+    };","+","+    private PythonJavaInstanceMembers(Map<String, Map<String, Member>> types) {","+        this.types = types;","+    }","+","+    /**","+     * @param classLoader The class loader of the application","+     * @return The names its compilations recorded","+     */","+    static PythonJavaInstanceMembers of(ClassLoader classLoader) {","+        return BY_CLASS_LOADER.computeIfAbsent(classLoader, PythonJavaInstanceMembers::load);","+    }","+","+    /**","+     * @param receiver The Java instance","+     * @param name The Python name","+     * @return The Java method the snake_case name stands for, or {@code null}","+     */","+    @UsedByGeneratedCode","+    public @Nullable String methodAlias(Object receiver, String name) {","+        Member member = members.get(receiver.getClass()).get(name);","+        return member != null && !member.property() && !member.isBlocked() ? member.target() : null;","+    }","+","+    /**","+     * @param receiver The Java instance","+     * @param name The Python name","+     * @return The zero-argument getter the property stands for, or {@code null}","+     */","+    @UsedByGeneratedCode","+    public @Nullable String propertyGetter(Object receiver, String name) {","+        Member member = members.get(receiver.getClass()).get(name);","+        return member != null && member.property() ? member.target() : null;","+    }","+","+    /**","+     * The class, its superclasses and its interfaces: the names of a type's hierarchy, never its members.","+     */","+    private static Set<Class<?>> hierarchy(Class<?> type) {","+        Set<Class<?>> hierarchy = new LinkedHashSet<>();","+        for (Class<?> current = type; current != null; current = current.getSuperclass()) {","+            interfaces(current, hierarchy);","+        }","+        return hierarchy;","+    }","+","+    private static void interfaces(Class<?> type, Set<Class<?>> hierarchy) {","+        if (hierarchy.add(type)) {","+            for (Class<?> parent : type.getInterfaces()) {","+                interfaces(parent, hierarchy);","+            }","+        }","+    }","+","+    private static PythonJavaInstanceMembers load(ClassLoader classLoader) {","+        Map<String, Map<String, Member>> types = new HashMap<>();","+        try {","+            Enumeration<URL> resources = classLoader.getResources(RESOURCE);","+            while (resources.hasMoreElements()) {","+                read(resources.nextElement(), types);","+            }","+        } catch (IOException e) {","+            throw new UncheckedIOException(\"Failed to read the Java instance member names of the Python sources\", e);","+        }","+        return new PythonJavaInstanceMembers(types);","+    }","+","+    private static void read(URL resource, Map<String, Map<String, Member>> types) throws IOException {","+        try (InputStream stream = resource.openStream();","+             BufferedReader reader = new BufferedReader(new InputStreamReader(stream, StandardCharsets.UTF_8))) {","+            String line;","+            while ((line = reader.readLine()) != null) {","+                String[] columns = line.split(\"\\t\", -1);","+                if (columns.length != 4) {","+                    continue;","+                }","+                Member member = switch (columns[3]) {","+                    case PROPERTY -> new Member(columns[2], true);","+                    case METHOD -> new Member(columns[2], false);","+                    default -> BLOCKED;","+                };","+                // computed from the same class path type by every compilation; a disagreement is no alias","+                types.computeIfAbsent(columns[0], type -> new HashMap<>())","+                    .merge(columns[1], member, (first, second) -> first.equals(second) ? first : BLOCKED);","+            }","+        }","+    }","+","+    /**","+     * @param target The Java method, empty when blocked","+     * @param property Whether the name is a read-only property calling the getter","+     */","+    private record Member(String target, boolean property) {","+","+        boolean isBlocked() {","+            return target.isEmpty();","+        }","+    }","+}"],"additions":177,"deletions":0,"truncated":false},{"path":"context-python/src/test/java/io/micronaut/context/python/GraalPyContextFactoryTest.java","lines":["@@ -16,6 +16,7 @@"," package io.micronaut.context.python;"," "," import io.micronaut.context.ApplicationContext;","+import io.micronaut.http.HttpRequest;"," import io.micronaut.logging.LoggingSystem;"," import org.graalvm.polyglot.Context;"," import org.graalvm.polyglot.Engine;","@@ -214,6 +215,140 @@ void javaObjectsAnswerToKeywordSafeMemberAliases() {","         }","     }"," ","+    @Test","+    void javaInstancesOfferReadOnlyPropertiesAndSnakeCaseMethods() {","+        // the names come from META-INF/pyronaut/java-instance-members.tsv of the test resources, read once","+        // for the class loader; it also names a class the class path lacks, which matches no receiver","+        try (ApplicationContext applicationContext = ApplicationContext.builder().properties(Map.of(","+            \"micronaut.python.pool.enabled\", true,","+            \"micronaut.python.pool.size\", 1","+        )).start()) {","+            Context context = applicationContext.getBean(Context.class);","+            context.getBindings(PYTHON).putMember(\"members\", new InstanceMembers());","+            context.getBindings(PYTHON).putMember(\"request\", HttpRequest.GET(\"/\"));","+            context.getBindings(PYTHON).putMember(\"original_request\", HttpRequest.GET(\"/\"));","+            assertEquals(8080, context.eval(PYTHON, \"members.port\").asInt());","+            assertEquals(\"Ada\", context.eval(PYTHON, \"members.name\").asString());","+            assertTrue(context.eval(PYTHON, \"members.ready\").asBoolean());","+            assertEquals(\"HTTP\", context.eval(PYTHON, \"members.http_status\").asString());","+            assertEquals(\"HTTP\", context.eval(PYTHON, \"members.get_http_status()\").asString());","+            assertEquals(\"text:x\", context.eval(PYTHON, \"members.with_value('x')\").asString());","+            assertEquals(\"number:7\", context.eval(PYTHON, \"members.with_value(7)\").asString());","+            assertEquals(\"text:x\", context.eval(PYTHON, \"members.withValue('x')\").asString());","+            assertEquals(\"Basic dXNlcjpwYXNz\", context.eval(PYTHON,","+                \"request.basic_auth('user', 'pass').getHeaders().get('Authorization')\").asString());","+            assertEquals(\"Basic dXNlcjpvbGQ=\", context.eval(PYTHON,","+                \"original_request.basicAuth('user', 'old').getHeaders().get('Authorization')\").asString());","+            assertTrue(context.eval(PYTHON, \"\"\"","+                not any(hasattr(members, name) for name in ('url', 'get_url', 'wrong', 'void', 'static_value', 'get_static_value', 'mixed_value', 'not_boolean', 'class'))","+                \"\"\").asBoolean());","+            assertEquals(\"literal\", context.eval(PYTHON, \"members.literal_name\").asString());","+            assertEquals(\"literal method\", context.eval(PYTHON, \"members.literal_value()\").asString());","+            assertThrows(PolyglotException.class, () -> context.eval(PYTHON, \"members.name = 'Grace'\"));","+            assertEquals(\"Ada\", context.eval(PYTHON, \"members.getName()\").asString());","+            IllegalStateException failure = assertThrows(IllegalStateException.class,","+                () -> context.eval(PYTHON, \"members.failure\"));","+            assertEquals(\"getter failed\", failure.getMessage());","+            assertThrows(PolyglotException.class, () -> context.eval(PYTHON, \"members.with_value()\"));","+            // a name a registered subtype blocks is no alias of its implementations; the other names still are","+            assertEquals(\"GET\", context.eval(PYTHON, \"request.method_name\").asString());","+            assertFalse(context.eval(PYTHON, \"hasattr(request, 'path')\").asBoolean());","+            // the names are shared by the contexts of the class loader, not held by each one","+            assertSame(PythonJavaInstanceMembers.of(applicationContext.getClassLoader()),","+                PythonJavaInstanceMembers.of(applicationContext.getClassLoader()));","+","+            int pooled = applicationContext.getBean(PythonContextExecutor.class).withContext(pooledContext -> {","+                pooledContext.getBindings(PYTHON).putMember(\"members\", new InstanceMembers());","+                return pooledContext.eval(PYTHON, \"members.port\").asInt();","+            });","+            assertEquals(8080, pooled);","+        }","+    }","+","+    public static final class InstanceMembers {","+        private String name = \"Ada\";","+","+        @SuppressWarnings(\"java:S116\")","+        public final String literal_name = \"literal\";","+","+        public int getPort() {","+            return 8080;","+        }","+","+        public String getName() {","+            return name;","+        }","+","+        public void setName(String name) {","+            this.name = name;","+        }","+","+        public boolean isReady() {","+            return true;","+        }","+","+        public String isNotBoolean() {","+            return \"not a getter\";","+        }","+","+        public String getHTTPStatus() {","+            return \"HTTP\";","+        }","+","+        public String getURL() {","+            return \"URL\";","+        }","+","+        public String getUrl() {","+            return \"Url\";","+        }","+","+        public String getLiteralName() {","+            return \"getter\";","+        }","+","+        @SuppressWarnings(\"java:S100\")","+        public String literal_value() {","+            return \"literal method\";","+        }","+","+        public String literalValue() {","+            return \"camel method\";","+        }","+","+        public String withValue(String value) {","+            return \"text:\" + value;","+        }","+","+        public String withValue(int value) {","+            return \"number:\" + value;","+        }","+","+        public String getWrong(int value) {","+            return \"wrong:\" + value;","+        }","+","+        public void getVoid() {","+            // Intentionally empty: a zero-argument void method is not a property getter.","+        }","+","+        public static String getStaticValue() {","+            return \"static\";","+        }","+","+        public String mixedValue(String value) {","+            return value;","+        }","+","+        public static int mixedValue(int value) {","+            return value;","+        }","+","+        public String getFailure() {","+            throw new IllegalStateException(\"getter failed\");","+        }","+    }","+","     @Test","     void javaStagesAndPublishersReturnedByAnyJavaCallAreAwaitable() throws Exception {","         try (ApplicationContext applicationContext = ApplicationContext.run(Map.of("],"additions":135,"deletions":0,"truncated":false},{"path":"context-python/src/test/resources/META-INF/pyronaut/java-instance-members.tsv","lines":["@@ -0,0 +1,16 @@","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\tfailure\tgetFailure\tproperty","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\tget_http_status\tgetHTTPStatus\tmethod","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\tget_url\t\tblocked","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\thttp_status\tgetHTTPStatus\tproperty","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\tliteral_name\tgetLiteralName\tproperty","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\tliteral_value\tliteralValue\tmethod","+io.micronaut.context.python.GraalPyContextFactoryTest$InstanceMembers\tname\tgetName\tproperty","+io.micronaut.context.python.GraalPyContextFactoryTest$Ins