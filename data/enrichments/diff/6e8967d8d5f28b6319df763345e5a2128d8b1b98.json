sume_no_revert_next_call.is_some() {","+                return Err(SymbolicError::Unsupported(","+                    \"revert cheatcode on a CREATE beyond the call depth limit\",","+                ));","+            }","+            state.return_data = SymReturnData::empty(&mut self.cx);","+            state.stack.push(SymExpr::zero(&mut self.cx))?;","+            return Ok(StepOutcome::Continue);","+        }","+","         let initcode = match &size {","             BoundedCopySize::Concrete(size) => {","                 if let Some(offset) = state.constrained_usize(&mut self.cx, &offset) {","@@ -217,16 +231,19 @@ impl SymbolicExecutor {","         code: &SymCode,","         completed_paths: &mut usize,","     ) -> Result<Vec<CallOutcome>, SymbolicError> {","-        let mut worklist = VecDeque::from([initial]);","-        let mut deferred_worklist = VecDeque::new();","-        self.execute_call_path_batch(","-            executor,","-            code,","-            &mut worklist,","-            &mut deferred_worklist,","-            completed_paths,","-            CallPathKind::External,","-        )","+        // Each nested frame recurses on the native stack, so grow it on demand.","+        stacker::maybe_grow(CALL_FRAME_STACK_RED_ZONE, CALL_FRAME_STACK_GROWTH, || {","+            let mut worklist = VecDeque::from([initial]);","+            let mut deferred_worklist = VecDeque::new();","+            self.execute_call_path_batch(","+                executor,","+                code,","+                &mut worklist,","+                &mut deferred_worklist,","+                completed_paths,","+                CallPathKind::External,","+            )","+        })","     }"," ","     /// Fails a CREATE before its frame runs, such as on an insufficient balance or an address"],"additions":27,"deletions":10,"truncated":false},{"path":"crates/evm/symbolic/src/executor/opcodes.rs","lines":["@@ -1,4 +1,5 @@"," use super::*;","+use foundry_evm::revm::interpreter::STACK_LIMIT;"," "," enum MappingStorageProvenance {","     None,","@@ -462,6 +463,18 @@ impl SymbolicExecutor {","             return Ok(StepOutcome::ExceptionalHalt);","         }"," ","+        // The EVM halts a frame exceptionally before it runs an undefined opcode or one whose","+        // stack inputs or outputs do not fit, so the handlers below never see such a stack.","+        let fits = opcode::OpCode::new(op).is_some_and(|opcode| {","+            let height = state.stack.len();","+            let inputs = opcode.inputs() as usize;","+            height >= inputs && height - inputs + opcode.outputs() as usize <= STACK_LIMIT","+        });","+        if !fits {","+            state.return_data = SymReturnData::empty(&mut self.cx);","+            return Ok(StepOutcome::ExceptionalHalt);","+        }","+","         match op {","             opcode::PUSH0 => {","                 state.stack.push(SymExpr::zero(&mut self.cx))?;"],"additions":13,"deletions":0,"truncated":false},{"path":"crates/evm/symbolic/src/lib.rs","lines":["@@ -26,7 +26,7 @@ use foundry_evm::{","         context::{Block, Cfg, Transaction},","         database::DatabaseRef,","         precompile::{PrecompileSpecId, Precompiles, kzg_point_evaluation},","-        primitives::hardfork::SpecId,","+        primitives::{constants::CALL_STACK_LIMIT, hardfork::SpecId},","     },"," };"," use serde::{Deserialize, Serialize};"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/evm/symbolic/src/runtime/memory.rs","lines":["@@ -34,6 +34,10 @@ impl SymStack {","         self.0.swap(len - 1, other);","         Ok(())","     }","+","+    pub(crate) const fn len(&self) -> usize {","+        self.0.len()","+    }"," }"," "," #[derive(Clone, Debug)]"],"additions":4,"deletions":0,"truncated":false},{"path":"crates/forge/tests/cli/test_cmd/symbolic_calls.rs","lines":["@@ -1674,3 +1674,275 @@ Suite result: ok. 4 passed; 0 failed; 0 skipped; [ELAPSED]"," ","     assert!(!stdout.contains(\"symbolic CALLCODE value\"), \"{stdout}\");"," }","+","+// An undefined opcode or one that underflows the stack halts its frame exceptionally, so the","+// call or create that ran it fails instead of the symbolic run stopping.","+#[forgetest_init]","+fn symbolic_invalid_opcode_halts_frame(prj: _, cmd: _) {","+    skip_unless_z3!(\"symbolic_invalid_opcode_halts_frame\");","+","+    prj.add_test(","+        \"SymbolicInvalidOpcode.t.sol\",","+        &r#\"","+import \"forge-std/Test.sol\";","+","+contract SymbolicInvalidOpcode is Test {","+    uint256 marker;","+","+    function checkCallToStackOverflowFails(uint256 value) public {","+        // Init code that returns a runtime of one PUSH0 more than the stack holds.","+        bytes memory init = hex\"61040180600a5f395ff3PUSH0S\";","+        address child;","+        assembly (\"memory-safe\") {","+            child := create(0, add(init, 0x20), mload(init))","+        }","+        assertEq(child.code.length, 1025);","+        marker = value;","+        (bool ok, bytes memory output) = child.call(\"\");","+        assert(!ok);","+        assertEq(output.length, 0);","+        assertEq(marker, value);","+    }","+","+    function checkCallToFullStackSucceeds() public {","+        // Init code that returns a runtime that fills the stack and stops.","+        bytes memory init = hex\"61040180600a5f395ff3FULL_STACK\";","+        address child;","+        assembly (\"memory-safe\") {","+            child := create(0, add(init, 0x20), mload(init))","+        }","+        assertEq(child.code.length, 1025);","+        (bool ok,) = child.call(\"\");","+        assert(ok);","+    }","+","+    function checkCallToStackUnderflowFails(uint256 value) public {","+        address child = address(0xC0DE);","+        // ADD with an empty stack.","+        vm.etch(child, hex\"01\");","+        marker = value;","+        (bool ok, bytes memory output) = child.call(\"\");","+        assert(!ok);","+        assertEq(output.length, 0);","+        assertEq(marker, value);","+    }","+","+    function checkCallToUndefinedOpcodeFails(uint256 value) public {","+        address child = address(0xC0DE);","+        // 0xCC is not an opcode.","+        vm.etch(child, hex\"cc\");","+        marker = value;","+        (bool ok, bytes memory output) = child.call(\"\");","+        assert(!ok);","+        assertEq(output.length, 0);","+        assertEq(marker, value);","+    }","+","+    function checkCreateWithStackUnderflowFails(uint256 value) public {","+        // ADDMOD with two of its three operands.","+        bytes memory initcode = hex\"6001600208\";","+        uint64 nonce = vm.getNonce(address(this));","+        marker = value;","+        address created;","+        assembly (\"memory-safe\") {","+            created := create(0, add(initcode, 0x20), mload(initcode))","+        }","+        assertEq(created, address(0));","+        assertEq(vm.getNonce(address(this)), nonce + 1);","+        assertEq(marker, value);","+    }","+}","+\"#","+        .replace(\"PUSH0S\", &\"5f\".repeat(1025))","+        .replace(\"FULL_STACK\", &format!(\"{}00\", \"5f\".repeat(1024))),","+    );","+","+    assert_symbolic(cmd.args([\"test\", \"--symbolic\", \"--match-test\", \"check.*(Fails|Succeeds)\"]))","+        .success()","+        .stdout_eq(str![[r#\"","+...","+Ran 5 tests for test/SymbolicInvalidOpcode.t.sol:SymbolicInvalidOpcode","+[PASS] checkCallToFullStackSucceeds() ([METRICS])","+[PASS] checkCallToStackOverflowFails(uint256) ([METRICS])","+[PASS] checkCallToStackUnderflowFails(uint256) ([METRICS])","+[PASS] checkCallToUndefinedOpcodeFails(uint256) ([METRICS])","+[PASS] checkCreateWithStackUnderflowFails(uint256) ([METRICS])","+Suite result: ok. 5 passed; 0 failed; 0 skipped; [ELAPSED]","+...","+\"#]]);","+}","+","+// A call or create beyond the EVM call depth limit fails, so self-call recursion unwinds after","+// 1024 nested frames, as on a node, instead of exhausting the native stack.","+#[forgetest_init]","+fn symbolic_call_depth_limit_stops_recursion(prj: _, cmd: _) {","+    skip_unless_z3!(\"symbolic_call_depth_limit_stops_recursion\");","+","+    prj.add_test(","+        \"SymbolicCallDepth.t.sol\",","+        r#\"","+import \"forge-std/Test.sol\";","+","+contract SelfCaller {","+    uint256 public frames;","+","+    fallback() external {","+        frames += 1;","+        (bool ok,) = address(this).call(\"\");","+        ok;","+    }","+}","+","+// The deepest frame's self-call fails, so it tries a CREATE at the depth limit.","+contract DeepCreator {","+    address public created = address(1);","+","+    function descend() external {","+        (bool ok,) = address(this).call(abi.encodeCall(this.descend, ()));","+        if (!ok) {","+            address child;","+            assembly {","+                child := create(0, 0, 0)","+            }","+            created = child;","+        }","+    }","+}","+","+// The deepest frame calls an address outside the known contracts.","+contract DeepSymbolicCaller {","+    address public to;","+    bool public reached;","+","+    function aim(address target) external {","+        to = target;","+    }","+","+    function descend() external {","+        (bool ok,) = address(this).call(abi.encodeCall(this.descend, ()));","+        if (!ok) {","+            (bool sent,) = to.call(\"\");","+            reached = sent;","+        }","+    }","+}","+","+// The deepest frame expects its repeated self-call to fail at the depth limit.","+contract DeepExpectRevert {","+    Vm constant vm = Vm(address(uint160(uint256(keccak256(\"hevm cheat code\")))));","+    bool public caughtExpected;","+    uint256 public outputLength;","+","+    function descend() external {","+        (bool ok,) = address(this).call(abi.encodeCall(this.descend, ()));","+        if (!ok) {","+            vm.expectRevert();","+            bytes memory output;","+            (caughtExpected, output) = address(this).call(abi.encodeCall(this.descend, ()));","+            outputLength = output.length;","+        }","+    }","+}","+","+// The deepest frame expects its CREATE to fail at the depth limit.","+contract DeepExpectRevertCreator {","+    Vm constant vm = Vm(address(uint160(uint256(keccak256(\"hevm cheat code\")))));","+    address public created = address(1);","+","+    function descend() external {","+        (bool ok,) = address(this).call(abi.encodeCall(this.descend, ()));","+        if (!ok) {","+            vm.expectRevert();","+            address child;","+            assembly {","+                child := create(0, 0, 0)","+            }","+            created = child;","+        }","+    }","+}","+","+contract SymbolicCallDepth is Test {","+    function checkExpectedRevertOnCreateBeyondDepthLimit(uint256) public {","+        DeepExpectRevertCreator target = new DeepExpectRevertCreator();","+        target.descend();","+        assertTrue(target.created() != address(0));","+    }","+","+    function checkExpectedRevertAtTheCallDepthLimitSucceeds(uint256) public {","+        DeepExpectRevert target = new DeepExpectRevert();","+        target.descend();","+        assertTrue(target.caughtExpected());","+        // Forge answers a call that met its expected revert with 8192 zero bytes.","+        assertEq(target.outputLength(), 8192);","+    }","+","+    function checkSelfCallsStopAtTheCallDepthLimit(uint256) public {","+        SelfCaller target = new SelfCaller();","+        (bool ok,) = address(target).call(\"\");","+        assertTrue(ok);","+        assertEq(target.frames(), 1024);","+    }","+","+    function checkSymbolicTargetAtTheCallDepthLimitFails(address to) public {","+        DeepSymbolicCaller target = new DeepSymbolicCaller();","+        vm.assume(to != address(target) && to != address(this) && uint160(to) > 0xffff);","+        target.aim(to);","+        target.descend();","+        assertFalse(target.reached());","+    }","+","+    function checkCreateAtTheCallDepthLimitFails(uint256) public {","+        DeepCreator target = new DeepCreator();","+        target.descend();","+        assertEq(target.created(), address(0));","+        assertEq(vm.getNonce(address(target)), 1);","+    }","+}","+\"#,","+    );","+","+    assert_symbolic(cmd.args([","+        \"test\",","+        \"--symbolic\",","+        \"--match-test\",","+        \"check.*AtTheCallDepthLimit\",","+        \"--symbolic-call-targets\",","+        // Every nested frame completes a path for each outcome of the deepest call, and the","+        // depth budget spans all 1024 frames.","+        \"--symbolic-max-paths\",","+        \"16384\",","+        \"--symbolic-max-depth\",","+        \"1000000\",","+    ]))","+    .success()","+    .stdout_eq(str![[r#\"","+...","+Ran 4 tests for test/SymbolicCallDepth.t.sol:SymbolicCallDepth","+[PASS] checkCreateAtTheCallDepthLimitFails(uint256) ([METRICS])","+[PASS] checkExpectedRevertAtTheCallDepthLimitSucceeds(uint256) ([METRICS])","+[PASS] checkSelfCallsStopAtTheCallDepthLimit(uint256) ([METRICS])","+[PASS] checkSymbolicTargetAtTheCallDepthLimitFails(address) ([METRICS])","+Suite result: ok. 4 passed; 0 failed; 0 skipped; [ELAPSED]","+...","+\"#]]);","+","+    // Concrete Forge fails a default `vm.expectRevert` on a CREATE rejected at the depth limit,","+    // which the symbolic engine does not model, so the result is incomplete instead of a proof.","+    assert_symbolic(cmd.forge_fuse().args([","+        \"test\",","+        \"--symbolic\",","+        \"--match-test\",","+        \"checkExpectedRevertOnCreateBeyondDepthLimit\",","+        \"--symbolic-max-paths\",","+        \"16384\",","+        \"--symbolic-max-depth\",","+        \"1000000\",","+    ]))","+    .failure()","+    .stdout_eq(str![[r#\"","+...","+[FAIL: incomplete symbolic execution (Stuck): unsupported symbolic execution feature: revert cheatcode on a CREATE beyond the call depth limit] checkExpectedRevertOnCreateBeyondDepthLimit(uint256) ([METRICS])","+...","+\"#]]);","+}",""],"additions":272,"deletions":0,"truncated":false}],"additions":401,"deletions":14,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-05T16:27:55.933584+00:00"}