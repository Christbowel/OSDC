ty.Cryptography.X509Certificates.X509Certificate2)null!),","+                2 => builder.UseTls(null!, _ => { }),","+                3 => builder.UseTls(","+                    System.Security.Cryptography.X509Certificates.StoreName.My,","+                    \"unused\",","+                    false,","+                    System.Security.Cryptography.X509Certificates.StoreLocation.CurrentUser,","+                    _ => { }),","+                _ => throw new ArgumentOutOfRangeException(nameof(overload)),","+            };","+        });","+","+        Assert.Equal(\"builder\", exception.ParamName);","+    }","+","+    [Fact]","+    public void ClientTlsConfigurationPreservesBuilderAndClientOptions()","+    {","+        var services = new ServiceCollection();","+        var builder = new TestClientBuilder(services);","+        var configured = 0;","+        var expectedTimeout = TimeSpan.FromSeconds(17);","+","+        var result = builder.UseTls(options =>","+        {","+            configured++;","+            options.HandshakeTimeout = expectedTimeout;","+        });","+        using var provider = services.BuildServiceProvider();","+        var options = provider.GetRequiredService<IOptions<TlsOptions>>().Value;","+","+        Assert.Same(builder, result);","+        Assert.Equal(1, configured);","+        Assert.Equal(expectedTimeout, options.HandshakeTimeout);","+    }","+","     [Fact]","     public void SiloTlsConfiguration_AppliesOncePerConnectionRole()","     {","@@ -170,4 +247,10 @@ private sealed class TestSiloBuilder(IServiceCollection services) : ISiloBuilder","         public IServiceCollection Services { get; } = services;","         public IConfiguration Configuration { get; } = new ConfigurationBuilder().Build();","     }","+","+    private sealed class TestClientBuilder(IServiceCollection services) : IClientBuilder","+    {","+        public IServiceCollection Services { get; } = services;","+        public IConfiguration Configuration { get; } = new ConfigurationBuilder().Build();","+    }"," }"],"additions":83,"deletions":0,"truncated":false},{"path":"test/Orleans.Core.Tests/Directory/DirectorySiloBuilderExtensionsTests.cs","lines":["@@ -0,0 +1,98 @@","+using Microsoft.Extensions.DependencyInjection;","+using Microsoft.Extensions.Hosting;","+using NSubstitute;","+using Orleans.GrainDirectory;","+using Orleans.Hosting;","+using Orleans.Runtime;","+using Orleans.Runtime.Hosting;","+using Xunit;","+","+namespace NonSilo.Tests.Directory;","+","+[TestCategory(\"BVT\")]","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"GrainDirectory\")]","+public sealed class DirectorySiloBuilderExtensionsTests","+{","+    [Fact]","+    public void AddGrainDirectoryRejectsNullSiloBuilder()","+    {","+        var exception = Assert.Throws<ArgumentNullException>(","+            () => DirectorySiloBuilderExtensions.AddGrainDirectory<IGrainDirectory>(","+                (ISiloBuilder)null!, \"test\", (_, _) => Substitute.For<IGrainDirectory>()));","+","+        Assert.Equal(\"builder\", exception.ParamName);","+    }","+","+    [Fact]","+    public void AddGrainDirectoryRejectsNullServiceCollection()","+    {","+        var exception = Assert.Throws<ArgumentNullException>(","+            () => DirectorySiloBuilderExtensions.AddGrainDirectory<IGrainDirectory>(","+                (IServiceCollection)null!, \"test\", (_, _) => Substitute.For<IGrainDirectory>()));","+","+        Assert.Equal(\"collection\", exception.ParamName);","+    }","+","+    [Fact]","+    public void NullFactoryPreservesExistingDefaultDirectory()","+    {","+        var services = new ServiceCollection();","+        var directory = Substitute.For<IGrainDirectory>();","+        services.AddGrainDirectory<IGrainDirectory>(GrainDirectoryAttribute.DEFAULT_GRAIN_DIRECTORY, (_, _) => directory);","+        var registrations = services.ToArray();","+","+        var exception = Assert.Throws<ArgumentNullException>(() =>","+            services.AddGrainDirectory<IGrainDirectory>(GrainDirectoryAttribute.DEFAULT_GRAIN_DIRECTORY, null!));","+","+        Assert.Equal(\"implementationFactory\", exception.ParamName);","+        Assert.Equal(registrations, services);","+        using var provider = services.BuildServiceProvider();","+        Assert.Same(directory, provider.GetRequiredKeyedService<IGrainDirectory>(GrainDirectoryAttribute.DEFAULT_GRAIN_DIRECTORY));","+    }","+","+    [Fact]","+    public void NamedRegistrationPassesProviderAndNameToFactoryOnce()","+    {","+        var services = new ServiceCollection();","+        var directory = Substitute.For<IGrainDirectory>();","+        IServiceProvider factoryProvider = null!;","+        string factoryName = null!;","+        var calls = 0;","+","+        var result = services.AddGrainDirectory<IGrainDirectory>(\"custom\", (provider, name) =>","+        {","+            factoryProvider = provider;","+            factoryName = name;","+            calls++;","+            return directory;","+        });","+        using var provider = services.BuildServiceProvider();","+","+        Assert.Same(services, result);","+        Assert.Same(directory, provider.GetRequiredKeyedService<IGrainDirectory>(\"custom\"));","+        Assert.Same(directory, provider.GetRequiredKeyedService<IGrainDirectory>(\"custom\"));","+        Assert.Same(provider.GetRequiredService<IServiceProvider>(), factoryProvider);","+        Assert.Equal(\"custom\", factoryName);","+        Assert.Equal(1, calls);","+    }","+","+    [Fact]","+    public void SiloRegistrationPreservesBuilderAndParticipatesInLifecycle()","+    {","+        var directory = Substitute.For<IGrainDirectory, ILifecycleParticipant<ISiloLifecycle>>();","+        using var host = new HostBuilder().UseOrleans(builder =>","+        {","+            builder.UseLocalhostClustering();","+","+            var result = builder.AddGrainDirectory<IGrainDirectory>(\"custom\", (_, _) => directory);","+","+            Assert.Same(builder, result);","+        }).Build();","+","+        Assert.Same(directory, host.Services.GetRequiredKeyedService<IGrainDirectory>(\"custom\"));","+        Assert.Contains(host.Services.GetServices<ILifecycleParticipant<ISiloLifecycle>>(),","+            participant => ReferenceEquals(participant, directory));","+    }","+}"],"additions":98,"deletions":0,"truncated":false},{"path":"test/Orleans.Core.Tests/Membership/SiloMetadataHostingExtensionsTests.cs","lines":["@@ -0,0 +1,145 @@","+using Microsoft.Extensions.Configuration;","+using Microsoft.Extensions.DependencyInjection;","+using Microsoft.Extensions.Options;","+using NSubstitute;","+using Orleans.Hosting;","+using Orleans.Runtime.MembershipService.SiloMetadata;","+using Xunit;","+","+namespace NonSilo.Tests.Membership;","+","+[TestCategory(\"BVT\")]","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"Runtime\")]","+public sealed class SiloMetadataHostingExtensionsTests","+{","+    [Fact]","+    public void DefaultConfigurationRejectsNullBuilder()","+    {","+        var exception = Assert.Throws<ArgumentNullException>(() => ((ISiloBuilder)null!).UseSiloMetadata());","+","+        Assert.Equal(\"builder\", exception.ParamName);","+    }","+","+    [Fact]","+    public void ConfigurationOverloadRejectsNullBuilderBeforeAccessingConfiguration()","+    {","+        var configuration = Substitute.For<IConfiguration>();","+","+        var exception = Assert.Throws<ArgumentNullException>(","+            () => SiloMetadataHostingExtensions.UseSiloMetadata(null!, configuration));","+","+        Assert.Equal(\"builder\", exception.ParamName);","+        Assert.Empty(configuration.ReceivedCalls());","+    }","+","+    [Fact]","+    public void ConfigurationSectionOverloadRejectsNullBuilderBeforeBindingConfiguration()","+    {","+        var configurationSection = Substitute.For<IConfigurationSection>();","+","+        var exception = Assert.Throws<ArgumentNullException>(","+            () => SiloMetadataHostingExtensions.UseSiloMetadata(null!, configurationSection));","+","+        Assert.Equal(\"builder\", exception.ParamName);","+        Assert.Empty(configurationSection.ReceivedCalls());","+    }","+","+    [Theory]","+    [InlineData(0, \"configuration\")]","+    [InlineData(1, \"configurationSection\")]","+    [InlineData(2, \"metadata\")]","+    public void NullMetadataInputsPreserveServiceRegistrations(int overload, string parameterName)","+    {","+        var builder = new TestBuilder();","+        var exception = Assert.Throws<ArgumentNullException>(() =>","+        {","+            _ = overload switch","+            {","+                0 => builder.UseSiloMetadata((IConfiguration)null!),","+                1 => builder.UseSiloMetadata((IConfigurationSection)null!),","+                2 => builder.UseSiloMetadata((Dictionary<string, string>)null!),","+                _ => throw new ArgumentOutOfRangeException(nameof(overload)),","+            };","+        });","+","+        Assert.Equal(parameterName, exception.ParamName);","+        Assert.Empty(builder.Services);","+    }","+","+    [Theory]","+    [InlineData(0)]","+    [InlineData(1)]","+    [InlineData(2)]","+    [InlineData(3)]","+    public void ConfigurationOverloadsPreserveBuilderAndPublishMetadata(int overload)","+    {","+        var builder = new TestBuilder();","+        var configuration = new ConfigurationBuilder().AddInMemoryCollection(","+            new Dictionary<string, string?>","+            {","+                [\"Orleans:Metadata:region\"] = \"west\",","+                [\"Orleans:Metadata:zone\"] = \"one\",","+            }).Build();","+        builder.Configuration = configuration;","+","+        var result = overload switch","+        {","+            0 => builder.UseSiloMetadata(),","+            1 => builder.UseSiloMetadata((IConfiguration)configuration),","+            2 => builder.UseSiloMetadata(configuration.GetSection(\"Orleans:Metadata\")),","+            3 => builder.UseSiloMetadata(new Dictionary<string, string> { [\"region\"] = \"west\", [\"zone\"] = \"one\" }),","+            _ => throw new ArgumentOutOfRangeException(nameof(overload)),","+        };","+        using var provider = builder.Services.BuildServiceProvider();","+        var metadata = provider.GetRequiredService<IOptions<SiloMetadata>>().Value.Metadata;","+","+        Assert.Same(builder, result);","+        Assert.Equal(2, metadata.Count);","+        Assert.Equal(\"west\", metadata[\"region\"]);","+        Assert.Equal(\"one\", metadata[\"zone\"]);","+    }","+","+    [Theory]","+    [InlineData(0)]","+    [InlineData(1)]","+    [InlineData(2)]","+    [InlineData(3)]","+    public void EmptyConfigurationOverloadsPublishEmptyMetadata(int overload)","+    {","+        var builder = new TestBuilder();","+        var result = overload switch","+        {","+            0 => builder.UseSiloMetadata(),","+            1 => builder.UseSiloMetadata(builder.Configuration),","+            2 => builder.UseSiloMetadata(builder.Configuration.GetSection(\"Orleans:Metadata\")),","+            3 => builder.UseSiloMetadata(new Dictionary<string, string>()),","+            _ => throw new ArgumentOutOfRangeException(nameof(overload)),","+        };","+        using var provider = builder.Services.BuildServiceProvider();","+","+        Assert.Same(builder, result);","+        Assert.Empty(provider.GetRequiredService<IOptions<SiloMetadata>>().Value.Metadata);"],"additions":123,"deletions":0,"truncated":false}],"additions":353,"deletions":2,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-14T15:14:28.479632+00:00"}