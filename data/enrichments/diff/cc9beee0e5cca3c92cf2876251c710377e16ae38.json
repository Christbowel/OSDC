[u8], title: &Title) -> Vec<u8> {","+    let marker = format!(\"# bun-cron: {title}\");","+    let mut kept = Vec::new();","+    let mut lines = strings::split(table, b\"\\n\");","+    while let Some(line) = lines.next() {","+        if strings::trim(line, b\" \\t\") == marker.as_bytes() {","+            lines.next();","+        } else if !line.is_empty() {","+            kept.extend_from_slice(line);","+            kept.push(b'\\n');","+        }","+    }","+    kept","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"src/cron/expression.rs","lines":["@@ -0,0 +1,336 @@","+use core::fmt;","+","+use bun_core::strings;","+","+/// Bit `n` of a field is set if the value `n` matches.","+#[derive(Clone, Copy)]","+pub struct CronExpression {","+    pub(crate) minutes: u64,","+    pub(crate) hours: u64,","+    days: u64,","+    pub(crate) months: u64,","+    /// 0 is Sunday.","+    weekdays: u64,","+    /// Neither the day nor the weekday was written `*`, so POSIX has either of them match.","+    day_or_weekday: bool,","+}","+","+#[derive(thiserror::Error, Debug, Clone, Copy, PartialEq, Eq)]","+pub enum CronError {","+    #[error(\"Invalid cron expression: unrecognized field syntax\")]","+    InvalidField,","+    #[error(\"Invalid cron expression: step value must be a positive integer\")]","+    InvalidStep,","+    #[error(","+        \"Invalid cron expression: range must be ascending (use 'a,b' or 'a-max,0-b' for wrap-around)\"","+    )]","+    InvalidRange,","+    #[error(\"Invalid cron expression: value out of range for field\")]","+    InvalidNumber,","+    #[error(","+        \"Invalid cron expression: too many fields. Bun.cron uses 5 fields (minute hour day month weekday) \\u{2014} seconds are not supported\"","+    )]","+    TooManyFields,","+    #[error(","+        \"Invalid cron expression: expected 5 space-separated fields (minute hour day month weekday)\"","+    )]","+    TooFewFields,","+}","+","+/// `month` and `day` count from 1, `weekday` from Sunday.","+#[derive(Clone, Copy)]","+pub struct WallClock {","+    pub year: i32,","+    pub month: i32,","+    pub day: i32,","+    pub hour: i32,","+    pub minute: i32,","+    pub weekday: i32,","+}","+","+pub trait TimeZone {","+    type Error;","+    /// No instant further than this from the epoch is converted.","+    const MAX_MS: f64;","+    fn utc(&self) -> Self;","+    fn wall_clock(&self, ms: f64) -> WallClock;","+    /// The earlier instant of a repeated time, and the one after the shift of a skipped time. UTC carries a month or day past its end.","+    fn instant(&self, at: WallClock) -> Result<f64, Self::Error>;","+}","+","+impl CronExpression {","+    /// Five fields, or a nickname.","+    pub fn parse(input: &[u8]) -> Result<CronExpression, CronError> {","+        let expr = strings::trim(input, b\" \\t\");","+        if expr.first() == Some(&b'@') {","+            return strings::in_map_case_insensitive(expr, &NICKNAMES)","+                .ok_or(CronError::InvalidField);","+        }","+","+        let mut fields = strings::tokenize_any(expr, b\" \\t\");","+        let mut field = || fields.next().ok_or(CronError::TooFewFields);","+        let (minute, hour, day, month, weekday) =","+            (field()?, field()?, field()?, field()?, field()?);","+        if field().is_ok() {","+            return Err(CronError::TooManyFields);","+        }","+","+        let unnamed = |_: &[u8]| None;","+        let month_named = |name: &[u8]| strings::in_map_case_insensitive(name, &MONTHS);","+        let weekday_named = |name: &[u8]| strings::in_map_case_insensitive(name, &WEEKDAYS);","+        Ok(CronExpression {","+            minutes: parse_field(minute, 0, 59, unnamed)?,","+            hours: parse_field(hour, 0, 23, unnamed)?,","+            days: parse_field(day, 1, 31, unnamed)?,","+            months: parse_field(month, 1, 12, month_named)?,","+            // 7 becomes Sunday after ranges are expanded, so that `5-7` ascends.","+            weekdays: parse_field(weekday, 0, 7, weekday_named)","+                .map(|set| (set | set >> 7) & ALL_WEEKDAYS)?,","+            day_or_weekday: day != b\"*\" && weekday != b\"*\",","+        })","+    }","+","+    /// The five fields as the OS schedulers see them: `None` where every value matches, however it was written.","+    pub(crate) fn restricted_fields(&self) -> [Option<u64>; 5] {","+        [","+            (self.minutes, ALL_MINUTES),","+            (self.hours, ALL_HOURS),","+            (self.days, ALL_DAYS),","+            (self.months, ALL_MONTHS),","+            (self.weekdays, ALL_WEEKDAYS),","+        ]","+        .map(|(set, all)| (set != all).then_some(set))","+    }","+","+    fn matches_day(&self, at: WallClock) -> bool {","+        let (day, weekday) = (has(self.days, at.day), has(self.weekdays, at.weekday));","+        if self.day_or_weekday {","+            day || weekday","+        } else {","+            day && weekday","+        }","+    }","+","+    fn matches(&self, at: WallClock) -> bool {","+        has(self.minutes, at.minute)","+            && has(self.hours, at.hour)","+            && has(self.months, at.month)","+            && self.matches_day(at)","+    }","+","+    /// The instant after `from_ms` for the matching time `at`. `None`: a fixed time fires once when clocks go back, as in cronie.","+    fn resolve_match<Z: TimeZone>(","+        &self,","+        zone: &Z,","+        at: WallClock,","+        from_ms: f64,","+        from: WallClock,","+    ) -> Result<Option<f64>, Z::Error> {","+        let result = zone.instant(at)?;","+        // The walk steps over the repeated hour, in which a `*` minute or hour fires again.","+        if self.minutes == ALL_MINUTES || self.hours == ALL_HOURS {","+            let wall_from = zone.utc().instant(from)?;","+            let wall_at = zone.utc().instant(at)?;","+            // Clocks went back if `at` has passed, or more real time than wall time separates the two.","+            if result <= from_ms || result - from_ms > wall_at - wall_from {","+                let mut probe = ((from_ms / MINUTE_MS).floor() + 1.0) * MINUTE_MS;","+                let mut cap = from_ms + (MAX_DST_SHIFT_MIN + 1.0) * MINUTE_MS;","+                if result > from_ms {","+                    cap = cap.min(result);","+                }","+                while probe < cap {","+                    if self.matches(zone.wall_clock(probe)) {","+                        return Ok(Some(probe));","+                    }","+                    probe += MINUTE_MS;","+                }","+            }","+        }","+        Ok((result > from_ms).then_some(result))","+    }","+","+    /// The first match strictly after `from_ms`, within 8 years and within `Z::MAX_MS`.","+    pub fn next<Z: TimeZone>(&self, zone: &Z, from_ms: f64) -> Result<Option<f64>, Z::Error> {","+        if from_ms.is_nan() || from_ms.abs() > Z::MAX_MS {","+            return Ok(None);","+        }","+        let from = zone.wall_clock(from_ms);","+        let mut at = from;","+        at.minute += 1;","+","+        while at.year - from.year <= 8 {","+            // Carried by hand, so that the fields see the hour and minute before DST shifts them.","+            if at.minute > 59 {","+                at.minute -= 60;","+                at.hour += 1;","+            }","+            if at.hour > 23 {","+                at.hour -= 24;","+                at.day += 1;","+            }","+            let noon_ms = zone.utc().instant(WallClock {","+                hour: 12,","+                minute: 0,","+                ..at","+            })?;","+            // No instant of a later day is in range in any zone, and converting this one asserts or gives year 0.","+            if noon_ms > Z::MAX_MS + 12.0 * 60.0 * MINUTE_MS {","+                return Ok(None);","+            }","+            at = WallClock {","+                hour: at.hour,","+                minute: at.minute,","+                ..zone.utc().wall_clock(noon_ms)","+            };","+","+            if !has(self.months, at.month) {","+                (at.month, at.day, at.hour, at.minute) = (at.month + 1, 1, 0, 0);","+            } else if !self.matches_day(at) {","+                (at.day, at.hour, at.minute) = (at.day + 1, 0, 0);","+            } else if !has(self.hours, at.hour) {","+                (at.hour, at.minute) = (at.hour + 1, 0);","+            } else if has(self.minutes, at.minute)","+                && let Some(ms) = self.resolve_match(zone, at, from_ms, from)?","+                && ms <= Z::MAX_MS","+            {","+                return Ok(Some(ms));","+            } else {","+                at.minute += 1;","+            }","+        }","+        Ok(None)","+    }","+}","+","+/// The numeric form, which every OS scheduler's entry carries: `*` or a list in each field.","+impl fmt::Display for CronExpression {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        let mut separator = \"\";","+        for field in self.restricted_fields() {","+            match field {","+                None => write!(f, \"{separator}*\")?,","+                Some(set) => {","+                    for value in values(set) {","+                        write!(f, \"{separator}{value}\")?;","+                        separator = \",\";","+                    }","+                }","+            }","+            separator = \" \";","+        }","+        Ok(())","+    }","+}","+","+const MINUTE_MS: f64 = 60_000.0;","+const MAX_DST_SHIFT_MIN: f64 = 120.0;","+","+const ALL_MINUTES: u64 = (1 << 60) - 1;","+pub(crate) const ALL_HOURS: u64 = (1 << 24) - 1;","+pub(crate) const ALL_DAYS: u64 = (1 << 32) - 2;","+const ALL_MONTHS: u64 = (1 << 13) - 2;","+const ALL_WEEKDAYS: u64 = (1 << 7) - 1;","+","+const HOURLY: CronExpression = CronExpression {","+    minutes: 1,","+    hours: ALL_HOURS,","+    days: ALL_DAYS,","+    months: ALL_MONTHS,","+    weekdays: ALL_WEEKDAYS,","+    day_or_weekday: false,","+};","+const DAILY: CronExpression = CronExpression { hours: 1, ..HOURLY };","+const WEEKLY: CronExpression = CronExpression {","+    weekdays: 1,","+    ..DAILY","+};","+const MONTHLY: CronExpression = CronExpression { days: 2, ..DAILY };","+const YEARLY: CronExpression = CronExpression {","+    months: 2,","+    ..MONTHLY","+};","+","+bun_core::comptime_string_map! {","+    static NICKNAMES: CronExpression = {","+        b\"@yearly\" => YEARLY,   b\"@annually\" => YEARLY,","+        b\"@monthly\" => MONTHLY, b\"@weekly\" => WEEKLY,","+        b\"@daily\" => DAILY,     b\"@midnight\" => DAILY,","+        b\"@hourly\" => HOURLY,","+    };","+}","+","+bun_core::comptime_string_map! {","+    static WEEKDAYS: u8 = {","+        b\"sun\" => 0,       b\"mon\" => 1,        b\"tue\" => 2,","+        b\"wed\" => 3,       b\"thu\" => 4,        b\"fri\" => 5,","+        b\"sat\" => 6,       b\"sunday\" => 0,     b\"monday\" => 1,","+        b\"tuesday\" => 2,   b\"wednesday\" => 3,  b\"thursday\" => 4,","+        b\"friday\" => 5,    b\"saturday\" => 6,","+    };","+}","+","+bun_core::comptime_string_map! {","+    static MONTHS: u8 = {","+        b\"jan\" => 1,        b\"feb\" => 2,        b\"mar\" => 3,","+        b\"apr\" => 4,        b\"may\" => 5,        b\"jun\" => 6,","+        b\"jul\" => 7,        b\"aug\" => 8,        b\"sep\" => 9,","+        b\"oct\" => 10,       b\"nov\" => 11,       b\"dec\" => 12,","+        b\"january\" => 1,    b\"february\" => 2,   b\"march\" => 3,","+        b\"april\" => 4,      b\"june\" => 6,       b\"july\" => 7,","+        b\"august\" => 8,     b\"september\" => 9,  b\"october\" => 10,","+        b\"november\" => 11,  b\"december\" => 12,","+    };","+}","+","+/// A list of `*`, `a` or `a-b`, each with an optional `/step`.","+fn parse_field(","+    field: &[u8],","+    min: u8,","+    max: u8,","+    named: fn(&[u8]) -> Option<u8>,","+) -> Result<u64, CronError> {","+    let value = |text: &[u8]| {","+        named(text)","+            .or_else(|| bun_core::parse_decimal::<u8>(text).filter(|n| (min..=max).contains(n)))","+            .ok_or(CronError::InvalidNumber)","+    };","+    let mut set = 0;","+    for part in strings::split(field, b\",\") {","+        if part.is_empty() {","+            return Err(CronError::InvalidField);","+        }","+        let (base, step) = match strings::split_once_char(part, b'/') {","+            None => (part, None),","+            Some((base, step)) => match bun_core::parse_decimal::<u8>(step) {","+                Some(step @ 1..=127) => (base, Some(step)),","+                _ => return Err(CronError::InvalidStep),","+            },","+        };","+        let (low, high) = if base == b\"*\" {","+            (min, max)","+        } else if let Some((low @ [_, ..], high)) = strings::split_once_char(base, b'-')","+            && !strings::contains_char(high, b'-')","+        {","+            (value(low)?, value(high)?)","+        } else {","+            let low = value(base)?;","+            (low, if step.is_some() { max } else { low })","+        };","+        if low > high {","+            return Err(CronError::InvalidRange);","+        }","+        for n in (low..=high).step_by(step.unwrap_or(1).into()) {","+            set |= 1 << n;","+        }","+    }","+    Ok(set)","+}","+","+fn has(set: u64, value: i32) -> bool {","+    (set.checked_shr(value.cast_unsigned())).is_some_and(|shifted| shifted & 1 != 0)","+}","+","+/// Ascending.","+pub(crate) fn values(set: u64) -> impl Iterator<Item = u32> {","+    (0..u64::BITS).filter(move |n| set >> n & 1 != 0)","+}"],"additions":336,"deletions":0,"truncated":false},{"path":"src/cron/launchd.rs","lines":["@@ -0,0 +1,71 @@","+use core::fmt::Write as _;","+","+use crate::expression::values;","+use crate::{CronExpression, Registration, XmlText};","+","+pub fn plist(job: &Registration<'_>) -> String {","+    let (title, schedule) = (&job.title, &job.schedule);","+    let (exe, script) = (XmlText(job.exe), XmlText(job.script));","+    let interval = calendar_interval(schedule);","+    format!(","+        r#\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>","+<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">","+<plist version=\"1.0\">","+<dict>","+<key>Label</key>","+<string>bun.cron.{title}</string>","+<key>ProgramArguments</key>","+<array>","+<string>{exe}</string>","+<string>run</string>","+<string>--cron-title={title}</string>","+<string>--cron-period={schedule}</string>","+<string>{script}</string>","+</array>","+<key>StartCalendarInterval</key>","+{interval}","+<key>StandardOutPath</key>","+<string>/tmp/bun.cron.{title}.stdout.log</string>","+<key>StandardErrorPath</key>","+<string>/tmp/bun.cron.{title}.stderr.log</string>","+</dict>","+</plist>","+\"#","+    )","+}","+","+/// launchd fires when any dict matches, and a dict matches when all of its keys do.","+fn calendar_interval(schedule: &CronExpression) -> String {","+    let fields @ [minute, hour, day, month, weekday] = schedule.restricted_fields();","+    let mut dicts = String::new();","+    if day.is_some() && weekday.is_some() {","+        // cron fires when either of the two matches.","+        append_dicts(&mut dicts, \"\", &KEYS, &[minute, hour, day, month, None]);","+        append_dicts(&mut dicts, \"\", &KEYS, &[minute, hour, None, month, weekday]);","+    } else {","+        append_dicts(&mut dicts, \"\", &KEYS, &fields);","+        if fields.iter().flatten().all(|set| set.count_ones() == 1) {","+            dicts.pop();","+            return dicts;","+        }","+    }","+    format!(\"    <array>\\n{dicts}    </array>\")","+}","+","+const KEYS: [&str; 5] = [\"Minute\", \"Hour\", \"Day\", \"Month\", \"Weekday\"];","+","+/// A dict for each combination of the values of `fields`, which `keys` names, after `written`.","+fn append_dicts(dicts: &mut String, written: &str, keys: &[&str], fields: &[Option<u64>]) {","+    match (keys, fields) {","+        ([_, keys @ ..], [None, fields @ ..]) => append_dicts(dicts, written, keys, fields),","+        ([key, keys @ ..], [Some(set), fields @ ..]) => {","+            for value in values(*set) {","+                let written = format!(","+                    \"{written}        <key>{key}</key>\\n        <integer>{value}</integer>\\n\"","+                );","+                append_dicts(dicts, &written, keys, fields);","+            }","+        }","+        _ => _ = write!(dicts, \"    <dict>\\n{written}    </dict>\\n\"),","+    }","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"src/cron/lib.rs","lines":["@@ -0,0 +1,58 @@","+//! What `Bun.cron` computes without the engine or the OS: schedules, and the text each OS scheduler is given.","+","+pub mod crontab;","+mod expression;","+pub mod launchd;","+pub mod schtasks;","+","+pub use expression::{CronError, CronExpression, TimeZone, WallClock};","+","+use core::fmt::{self, Display, Write as _};","+","+use bstr::ByteSlice as _;","+","+/// The name of an OS-level job. It goes unquoted into a crontab line, a file name and XML.","+#[derive(Clone)]","+pub struct Title(Box<str>);","+","+impl Title {","+    /// `None` unless `title` is one or more of `[a-zA-Z0-9_-]`.","+    pub fn new(title: &[u8]) -> Option<Title> {","+        let is_allowed = |&c: &u8| c.is_ascii_alphanumeric() || c == b'-' || c == b'_';","+        (!title.is_empty() && title.iter().all(is_allowed))","+            .then(|| Title(title.iter().map(|&c| char::from(c)).collect()))","+    }","+}","+","+impl Display for Title {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        f.write_str(&self.0)","+    }","+}","+","+/// What the OS is asked to run: `<exe> run --cron-title=<title> --cron-period=<schedule> <script>`.","+pub struct Registration<'a> {","+    pub title: Title,","+    pub schedule: CronExpression,","+    pub exe: &'a [u8],","+    pub script: &'a [u8],","+}","+","+/// Escaped. The document has to be UTF-8, so a byte that is not becomes U+FFFD.","+struct XmlText<'a>(&'a [u8]);","+","+impl Display for XmlText<'_> {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        self.0.chars().try_for_each(|c| match c {","+            '&' => f.write_str(\"&amp;\"),","+            '<' => f.write_str(\"&lt;\"),","+            '>' => f.write_str(\"&gt;\"),","+            '\"' => f.write_str(\"&quot;\"),","+            '\\'' => f.write_str(\"&apos;\"),","+            _ => f.write_char(c),","+        })","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":58,"deletions":0,"truncated":false},{"path":"src/cron/schtasks.rs","lines":["@@ -0,0 +1,179 @@","+use core::fmt::Write as _;","+","+use bun_core::strings;","+","+use crate::expression::{ALL_DAYS, ALL_HOURS, values};","+use crate::{CronExpression, Registration, XmlText};","+","+#[derive(thiserror::Error, Debug, PartialEq, Eq)]","+#[error(","+    \"This cron expression requires too many triggers for Windows Task Scheduler (max 48). Simplify the expression or use fewer restricted fields.\"","+)]","+pub struct TooManyTriggers;","+","+pub fn task_xml(job: &Registration<'_>) -> Result<String, TooManyTriggers> {","+    let (title, schedule) = (&job.title, &job.schedule);","+    let (exe, script) = (XmlText(job.exe), XmlText(job.script));","+    let triggers = triggers(schedule)?;","+    Ok(format!(","+        r#\"<?xml version=\"1.0\"?>","+<Task version=\"1.2\" xmlns=\"http://schemas.microsoft.com/windows/2004/02/mit/task\">","+<Triggers>","+{triggers}  </Triggers>","+<Principals>","+<Principal>","+<LogonType>S4U</LogonType>","+<RunLevel>LeastPrivilege</RunLevel>","+</Principal>","+</Principals>","+<Settings>","+<Enabled>true</Enabled>","+<AllowStartOnDemand>true</AllowStartOnDemand>","+<AllowHardTerminate>true</AllowHardTerminate>","+<MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>","+<StartWhenAvailable>true</StartWhenAvailable>","+</Settings>","+<Actions>","+<Exec>","+<Command>{exe}</Command>","+<Arguments>run --cron-title={title} --cron-period=\"{schedule}\" \"{script}\"</Arguments>","+</Exec>","+</Actions>","+</Task>","+\"#","+    ))","+}","+","+/// What to reject with for the stderr of a `schtasks /create` that failed. Empty if it printed nothing.","+pub fn explain_failure(stderr: &[u8]) -> &[u8] {","+    if strings::contains(stderr, b\"No mapping between account names\") {","+        return b\"Failed to register cron job: your Windows account's Security Identifier (SID) could not be resolved. \\","+            This typically happens on headless servers or CI where the process runs under a service account. \\","+            To fix this, either run Bun as a regular user account, or create the scheduled task manually with: \\","+            schtasks /create /xml <file> /tn <name> /ru SYSTEM /f\";","+    }","+    strings::trim(stderr, b\" \\t\\n\\r\\x0b\\x0c\")","+}","+","+const EVERY_DAY: &str = \"      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>\\n\";","+","+fn triggers(schedule: &CronExpression) -> Result<String, TooManyTriggers> {","+    let (minutes, hours) = (schedule.minutes, schedule.hours);","+    let trigger = |hour: u32, minute: u32, days: &str| {","+        format!(","+            \"    <CalendarTrigger>\\n      <StartBoundary>2000-01-01T{hour:02}:{minute:02}:00</StartBoundary>\\n{days}    </CalendarTrigger>\\n\"","+        )","+    };","+","+    let days = days(schedule);","+    if days == [EVERY_DAY]","+        && let Some(interval) = repetition(minutes, hours)","+    {","+        let days =","+            format!(\"      <Repetition><Interval>{interval}</Interval></Repetition>\\n{EVERY_DAY}\");","+        return Ok(trigger(","+            hours.trailing_zeros(),","+            minutes.trailing_zeros(),","+            &days,","+        ));","+    }","+","+    if (minutes.count_ones() * hours.count_ones()) as usize * days.len() > 48 {","+        return Err(TooManyTriggers);","+    }","+    let mut triggers = String::new();","+    for hour in values(hours) {","+        for minute in values(minutes) {","+            for days in &days {","+                triggers += &trigger(hour, minute, days);","+            }","+        }","+    }","+    Ok(triggers)","+}","+","+/// The interval of the one repeating trigger that fires at these times of every day.","+fn repetition(minutes: u64, hours: u64) -> Option<String> {","+    if hours == ALL_HOURS {","+        return even_step(minutes, 60).map(|step| format!(\"PT{step}M\"));","+    }","+    if minutes.count_ones() == 1 {","+        return even_step(hours, 24).map(|step| format!(\"PT{step}H\"));","+    }","+    None","+}","+","+/// The distance between the values of `set`, if it is always the same, across the end of `period` too.","+fn even_step(set: u64, period: u32) -> Option<u32> {","+    let (first, count) = (set.trailing_zeros(), set.count_ones());","+    let step = period.checked_div(count)?;","+    let steps = (0..count).map(|i| first + i * step);","+    (step * count == period && values(set).eq(steps)).then_some(step)","+}","+","+/// The days part of each trigger that a time of day needs: cron fires when the day or the weekday matches.","+fn days(schedule: &CronExpression) -> Vec<String> {","+    const WEEKS: &str = \"        <Weeks><Week>1</Week><Week>2</Week><Week>3</Week><Week>4</Week><Week>Last</Week></Weeks>\\n\";","+    let [_, _, day, month, weekday] = schedule.restricted_fields();","+    let months = named(\"Months\", schedule.months >> 1, &MONTHS);","+    let mut days = Vec::new();","+    if day.is_some() || (weekday.is_none() && month.is_some()) {","+        let mut listed = String::new();","+        for day in values(day.unwrap_or(ALL_DAYS)) {","+            _ = writeln!(listed, \"          <Day>{day}</Day>\");","+        }","+        days.push(format!(","+            \"      <ScheduleByMonth>\\n        <DaysOfMonth>\\n{listed}        </DaysOfMonth>\\n{months}      </ScheduleByMonth>\\n\"","+        ));","+    }","+    if let Some(weekday) = weekday {","+        let weekdays = named(\"DaysOfWeek\", weekday, &WEEKDAYS);","+        days.push(match month {","+            None => format!(","+                \"      <ScheduleByWeek>\\n        <WeeksInterval>1</WeeksInterval>\\n{weekdays}      </ScheduleByWeek>\\n\"","+            ),","+            Some(_) => format!(","+                \"      <ScheduleByMonthDayOfWeek>\\n{WEEKS}{weekdays}{months}      </ScheduleByMonthDayOfWeek>\\n\"","+            ),","+        });","+    }","+    if days.is_empty() {"],"additions":140,"deletions":0,"truncated":false}],"additions":681,"deletions":23,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-17T18:43:59.821584+00:00"}