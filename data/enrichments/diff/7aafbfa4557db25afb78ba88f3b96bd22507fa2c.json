ted before any key is tried. If empty, any algorithm a key in the JWKS","+  // can verify is accepted.","+  //","+  // Example:","+  //","+  // .. code-block:: yaml","+  //","+  //     allowed_algorithms:","+  //     - RS256","+  //     - ES256","+  //","+  repeated Algorithm allowed_algorithms = 22","+      [(validate.rules).repeated = {items {enum {defined_only: true}}}];","+","   // `JSON Web Key Set (JWKS) <https://tools.ietf.org/html/rfc7517#appendix-A>`_ is needed to","   // validate signature of a JWT. This field specifies where to fetch JWKS.","   oneof jwks_source_specifier {"],"additions":58,"deletions":1,"truncated":false},{"path":"changelogs/current/new_features/jwt_authn__allowed-algorithms.rst","lines":["@@ -0,0 +1,4 @@","+Added :ref:`allowed_algorithms","+<envoy_v3_api_field_extensions.filters.http.jwt_authn.v3.JwtProvider.allowed_algorithms>` to restrict","+the signing algorithms a provider accepts. A JWT whose ``alg`` is not listed is rejected before any","+key is tried."],"additions":4,"deletions":0,"truncated":false},{"path":"source/common/jwt/status.cc","lines":["@@ -168,6 +168,9 @@ std::string getStatusString(Status status) {"," ","   case Status::JwksBioAllocError:","     return \"Failed to create BIO due to memory allocation failure\";","+","+  case Status::JwtAlgorithmNotAllowed:","+    return \"Jwt algorithm is not allowed\";","   };","   // Return empty string though switch-case is exhaustive. See issues/91.","   return \"\";"],"additions":3,"deletions":0,"truncated":false},{"path":"source/common/jwt/status.h","lines":["@@ -211,6 +211,9 @@ enum class Status {"," ","   // Failed to create BIO","   JwksBioAllocError,","+","+  // Jwt algorithm is not allowed.","+  JwtAlgorithmNotAllowed,"," };"," "," /**"],"additions":3,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/jwt_authn/BUILD","lines":["@@ -58,6 +58,7 @@ envoy_cc_library(","         \"//source/common/config:datasource_lib\",","         \"//source/common/jwt:jwt_