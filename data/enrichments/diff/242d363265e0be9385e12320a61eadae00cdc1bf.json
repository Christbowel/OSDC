{"id":"242d363265e0be9385e12320a61eadae00cdc1bf","axis":"silent","repo":"pnpm/pnpm","sha":"242d363265e0be9385e12320a61eadae00cdc1bf","parsed":{"files":[{"path":".changeset/add-token-command.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+Added `pnpm token` to list, create, and revoke authentication tokens on the registry."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args.rs","lines":["@@ -95,6 +95,7 @@ pub mod sudo_guard;"," pub mod supported_architectures;"," pub mod tasks;"," pub mod team;","+pub mod token;"," pub mod undeprecate;"," pub mod unlink;"," pub mod unpublish;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command.rs","lines":["@@ -78,6 +78,7 @@ use super::{","     store::StoreCommand,","     tasks::TasksArgs,","     team::TeamArgs,","+    token::TokenArgs,","     undeprecate::UndeprecateArgs,","     unlink::UnlinkArgs,","     unpublish::UnpublishArgs,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -10,8 +10,8 @@ use super::{","     PruneArgs, PublishArgs, RebuildArgs, RemoveArgs, RepoArgs, RestartArgs, RootArgs, RunArgs,","     RuntimeArgs, SbomArgs, ScriptShortcutArgs, SearchArgs, SelfUpdateArgs, SetScriptArgs,","     SetupArgs, ShimArgs, StageArgs, StarArgs, StarsArgs, StoreCommand, Subcommand, SummaryScope,","-    TasksArgs, TeamArgs, UndeprecateArgs, UnlinkArgs, UnpublishArgs, UnstarArgs, UpdateArgs,","-    VersionArgs, ViewArgs, WhoamiArgs, WhyArgs, WithArgs,","+    TasksArgs, TeamArgs, TokenArgs, UndeprecateArgs, UnlinkArgs, UnpublishArgs, UnstarArgs,","+    UpdateArgs, VersionArgs, ViewArgs, WhoamiArgs, WhyArgs, WithArgs,"," };"," "," #[derive(Debug, strum::IntoStaticStr, Subcommand)]","@@ -270,8 +270,8 @@ pub enum CliCommand {","     Edit(NotImplementedArgs),","     /// Not implemented in pnpm. Use the npm CLI directly.","     Profile(NotImplementedArgs),","-    /// Not implemented in pnpm. Use the npm CLI directly.","-    Token(NotImplementedArgs),","+    /// Manage authentication tokens on the registry.","+    Token(TokenArgs),","     /// Not implemented in pnpm. Use the npm CLI directly.","     Xmas(NotImplementedArgs),","     #[clap(external_subcommand)]"],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/routing.rs","lines":["@@ -74,7 +74,7 @@ fn route_registry<'a>(command: CliCommand, ctx: &RunCtx<'a>) -> miette::Result<C","         CliCommand::Ping(args) => dispatch_query::ping(ctx, args),","         CliCommand::Search(args) => dispatch_query::search(ctx, args),","         CliCommand::Publish(args) => dispatch_query::publish(ctx, args),","-        CliCommand::Token(_) => dispatch_query::not_implemented(\"token\"),","+        CliCommand::Token(args) => dispatch_query::token(ctx, args),","         CliCommand::Docs(args) => dispatch_query::docs(ctx, args),","         CliCommand::Repo(args) => dispatch_query::repo(ctx, args),","         CliCommand::Login(args) => dispatch_query::login(ctx, args),"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_query.rs","lines":["@@ -4,7 +4,7 @@ pub(super) use maintenance::{","     store, tasks, with,"," };"," pub(super) use registry::{","-    access, deprecate, dist_tag, login, logout, owner, ping, search, star, stars, team,","+    access, deprecate, dist_tag, login, logout, owner, ping, search, star, stars, team, token,","     undeprecate, unpublish, unstar, view, whoami,"," };"," ","@@ -54,6 +54,7 @@ use super::{","     store::StoreCommand,","     tasks::TasksArgs,","     team::TeamArgs,","+    token::TokenArgs,","     undeprecate::UndeprecateArgs,","     unpublish::UnpublishArgs,","     unstar::UnstarArgs,"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_query/registry.rs","lines":["@@ -1,7 +1,7 @@"," use super::{","     AccessArgs, CommandFuture, Config, DeprecateArgs, DistTagArgs, LoginArgs, LogoutArgs,","-    OwnerArgs, PingArgs, RunCtx, SearchArgs, StarArgs, StarsArgs, TeamArgs, UndeprecateArgs,","-    UnpublishArgs, UnstarArgs, ViewArgs, WhoamiArgs,","+    OwnerArgs, PingArgs, RunCtx, SearchArgs, StarArgs, StarsArgs, TeamArgs, TokenArgs,","+    UndeprecateArgs, UnpublishArgs, UnstarArgs, ViewArgs, WhoamiArgs,"," };"," use crate::cli_args::reporter::CliReporter;"," ","@@ -255,3 +255,20 @@ pub(in super::super) fn search<'a>(","         Ok(())","     }))"," }","+","+pub(in super::super) fn token<'a>(","+    ctx: &RunCtx<'a>,","+    args: TokenArgs,","+) -> miette::Result<CommandFuture<'a>> {","+    let cfg: &Config = (ctx.loaders.config)()?;","+    Ok(Box::pin(async move {","+        if let Some(output) = args.run(cfg).await? {","+            let output = super::super::sanitize::sanitize(&output);","+            if output.is_empty() {","+                return Ok(());","+            }","+            println!(\"{output}\");","+        }","+        Ok(())","+    }))","+}"],"additions":19,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/token.rs","lines":["@@ -0,0 +1,381 @@","+mod registry;","+#[cfg(test)]","+mod tests;","+","+use crate::{","+    cli_args::{registry_client::build_registry_client_with_guard, sanitize::sanitize_inline},","+    confirm_prompt::stdin_is_terminal,","+};","+use clap::Args;","+use derive_more::{Display, Error};","+use miette::{Diagnostic, IntoDiagnostic};","+use pnpm_auth_commands::login::{Host, PromptPassword};","+use pnpm_config::Config;","+use pnpm_network::{RetryOpts, ThrottledClient, normalize_registry_url, origins_redirect_guard};","+use registry::{CreateTokenRequest, TokenItem, create_token, delete_token, fetch_token_list};","+use std::fmt::Write as _;","+","+pub(crate) const TOKEN_BODY_LIMIT: usize = 1024 * 1024;","+","+#[derive(Debug, Display, Error, Diagnostic)]","+#[non_exhaustive]","+pub enum TokenError {","+    #[display(\"You must be logged in to view or change your tokens\")]","+    #[diagnostic(code(ERR_PNPM_TOKEN_UNAUTHORIZED))]","+    Unauthorized,","+","+    #[display(\"Unknown token command: {command}\")]","+    #[diagnostic(code(ERR_PNPM_TOKEN_UNKNOWN_COMMAND))]","+    UnknownCommand {","+        #[error(not(source))]","+        command: String,","+    },","+","+    #[display(\"Token key or id is required to revoke\")]","+    #[diagnostic(code(ERR_PNPM_TOKEN_KEY_REQUIRED))]","+    KeyRequired,","+","+    #[display(\"Found multiple tokens matching \\\"{id}\\\". Specify the full token or key instead.\")]","+    #[diagnostic(code(ERR_PNPM_TOKEN_AMBIGUOUS))]","+    Ambiguous {","+        #[error(not(source))]","+        id: String,","+    },","+","+    #[display(\"No token matching \\\"{id}\\\" found.\")]","+    #[diagnostic(code(ERR_PNPM_TOKEN_NOT_FOUND))]","+    NotFound {","+        /// The argument, cut by [`redact_token_argument`].","+        #[error(not(source))]","+        id: String,","+    },","+","+    #[display(\"Failed to read the password: {reason}\")]","+    #[diagnostic(code(ERR_PNPM_TOKEN_PASSWORD_READ_FAILED))]","+    PasswordReadFailed {","+        #[error(not(source))]","+        reason: String,","+    },","+","+    #[display(\"Failed to {action}: {status} {status_text}. {body}\")]","+    #[diagnostic(code(ERR_PNPM_REGISTRY_ERROR))]","+    RegistryWriteFailed {","+        #[error(not(source))]","+        action: String,","+        status: u16,","+        #[error(not(source))]","+        status_text: String,","+        #[error(not(source))]","+        body: String,","+    },","+","+    #[display(\"Failed to {operation}: {reason}\")]","+    #[diagnostic(code(ERR_PNPM_REGISTRY_ERROR))]","+    RegistryOperationFailed {","+        operation: &'static str,","+        #[error(not(source))]","+        reason: String,","+    },","+}","+","+#[derive(Debug, Default, Args)]","+pub struct TokenArgs {","+    /// The base URL of the npm registry.","+    #[clap(long)]","+    pub registry: Option<String>,","+","+    /// One-time password for registries that require two-factor authentication.","+    #[clap(long)]","+    pub otp: Option<String>,","+","+    /// Output results in JSON format.","+    #[clap(long)]","+    pub json: bool,","+","+    /// Output results in tab-separated format.","+    #[clap(long, short = 'p')]","+    pub parseable: bool,","+","+    /// Mark a created token as read-only.","+    #[clap(long)]","+    pub read_only: bool,","+","+    /// Restrict a created token to these CIDR ranges.","+    #[clap(long, value_delimiter = ',')]","+    pub cidr: Vec<String>,","+","+    /// The subcommand (`list`, `revoke`, or `create`) and its arguments.","+    pub params: Vec<String>,","+}","+","+/// Set each token's `id` to the shortest prefix of its key, at least","+/// `MIN_TOKEN_ID_LEN` long, that no other key starts with.","+pub(crate) fn generate_token_ids(tokens: &mut [TokenItem]) {","+    let mut order: Vec<usize> = (0..tokens.len()).collect();","+    order.sort_unstable_by(|&left, &right| tokens[left].key.cmp(&tokens[right].key));","+    let neighbor_prefix_lens: Vec<usize> = order","+        .windows(2)","+        .map(|pair| common_prefix_len(&tokens[pair[0]].key, &tokens[pair[1]].key))","+        .collect();","+    for (position, &index) in order.iter().enumerate() {","+        let unique_len = unique_prefix_len(&neighbor_prefix_lens, position);","+        tokens[index].id = Some(shortest_id(&tokens[index].key, unique_len).to_string());","+    }","+}","+","+/// The prefix length that separates the key at `position` of the sorted order","+/// from both of its neighbours.","+fn unique_prefix_len(neighbor_prefix_lens: &[usize], position: usize) -> usize {","+    const MIN_TOKEN_ID_LEN: usize = 6;","+    let before = position","+        .checked_sub(1)","+        .map_or(0, |prev| neighbor_prefix_lens[prev]);","+    let after = neighbor_prefix_lens","+        .get(position)","+        .copied()","+        .unwrap_or(0);","+    (before.max(after) + 1).max(MIN_TOKEN_ID_LEN)","+}","+","+fn shortest_id(key: &str, min_len: usize) -> &str {","+    (min_len..=key.len())","+        .find_map(|len| key.get(..len))","+        .unwrap_or(key)","+}","+","+fn common_prefix_len(left: &str, right: &str) -> usize {","+    left.bytes()","+        .zip(right.bytes())","+        .take_while(|(left, right)| left == right)","+        .count()","+}","+","+fn format_single_token(token: &TokenItem) -> String {","+    let created = token.created","+        .as_deref()","+        .map_or(\"\", |created_at| {","+            created_at","+                .get(..10)","+                .unwrap_or(created_at)","+        });","+    let id = token.id.as_deref().unwrap_or(&token.key);","+    let name_part = match &token.name {","+        Some(name) if !name.is_empty() => format!(\" name {name}\"),","+        _ => String::new(),","+    };","+    let mut item = format!(\"Token {}… with id {id}{name_part} created {created}\", token.token);","+    if let Some(cidrs) = &token.cidr_whitelist","+        && !cidrs.is_empty()","+    {","+        let _ = write!(item, \"\\nwith IP whitelist: {}\", cidrs.join(\",\"));","+    }","+    item","+}","+","+fn format_token_list(tokens: &[TokenItem]) -> String {","+    let mut entries = Vec::new();","+    for token in tokens {","+        entries.push(format_single_token(token));","+    }","+    entries.join(\"\\n\\n\")","+}","+","+fn format_token_list_parseable(tokens: &[TokenItem]) -> String {","+    let mut lines = Vec::new();","+    lines.push(\"key\\ttoken\\tid\\tname\\tcreated\\treadonly\\tCIDR whitelist\".to_string());","+    for token in tokens {","+        let id = token.id.as_deref().unwrap_or(&token.key);","+        let name = token.name.as_deref().unwrap_or(\"\");","+        let created = token.created.as_deref().unwrap_or(\"\");","+        let readonly = if token.readonly { \"true\" } else { \"false\" };","+        let cidrs = token.cidr_whitelist","+            .as_ref()","+            .map(|whitelist| whitelist.join(\",\"))","+            .unwrap_or_default();","+        lines.push(format!(","+            \"{}\\t{}\\t{}\\t{}\\t{}\\t{}\\t{}\",","+            token.key, token.token, id, name, created, readonly, cidrs,","+        ));","+    }","+    lines.join(\"\\n\")","+}","+","+fn resolve_key_to_remove(id: &str, tokens: &[TokenItem]) -> miette::Result<String> {","+    let matches: Vec<&TokenItem> = tokens","+        .iter()","+        .filter(|tok| tok.key.starts_with(id))","+        .collect();","+    if matches.len() == 1 {","+        Ok(matches[0].key.clone())","+    } else if matches.len() > 1 {","+        Err(TokenError::Ambiguous { id: id.to_string() }.into())","+    } else if tokens","+        .iter()","+        .any(|tok| !tok.token.is_empty() && id.starts_with(&tok.token))","+    {","+        Ok(id.to_string())","+    } else {","+        Err(TokenError::NotFound { id: redact_token_argument(id) }.into())","+    }","+}","+","+fn resolve_keys_to_remove(ids: &[String], tokens: &[TokenItem]) -> miette::Result<Vec<String>> {","+    let mut keys = Vec::with_capacity(ids.len());","+    for id in ids {","+        let key = resolve_key_to_remove(id, tokens)?;","+        if !keys.contains(&key) {","+            keys.push(key);","+        }","+    }","+    Ok(keys)","+}","+","+/// Shorten a `revoke` argument for diagnostics, because it may be a full,","+/// still-valid token, and strip control characters from it.","+pub(crate) fn redact_token_argument(id: &str) -> String {","+    const VISIBLE_CHARS: usize = 8;","+    let shown = match id.char_indices().nth(VISIBLE_CHARS) {","+        Some((cut, _)) => format!(\"{}…\", &id[..cut]),","+        None => id.to_string(),","+    };","+    sanitize_inline(&shown).into_owned()","+}","+","+async fn read_password() -> miette::Result<String> {","+    tokio::task::spawn_blocking(|| -> Result<String, String> {","+        if stdin_is_terminal().map_err(|err| err.to_string())? {","+            return Host::prompt_password(\"Password:\").map_err(|err| err.to_string());","+        }","+        let mut line = String::new();","+        std::io::stdin().read_line(&mut line).map_err(|err| err.to_string())?;","+        Ok(line","+            .trim_end_matches(['\\r', '\\n'])","+            .to_string())","+    })","+    .await","+    .map_err(|err| err.to_string())","+    .flatten()","+    .map_err(|reason| TokenError::PasswordReadFailed { reason }.into())","+}","+","+impl TokenArgs {","+    pub async fn run(&self, config: &Config) -> miette::Result<Option<String>> {","+        let registry_url = self.registry.as_deref().unwrap_or(&config.registry);","+        let normalized = normalize_registry_url(registry_url);","+        let auth_header =","+            config.auth_headers.for_url(&normalized).ok_or(TokenError::Unauthorized)?;","+        let redirect_guard = origins_redirect_guard([normalized.as_ref()]);","+        let http_client = build_registry_client_with_guard(config, Some(&redirect_guard))?;","+        let retry_opts = config.retry_opts();","+","+        let subcmd = self.params.first().map_or(\"list\", String::as_str);","+        match subcmd {","+            \"list\" | \"ls\" => {","+                self.run_list(&normalized, &http_client, &auth_header, retry_opts).await","+            }","+            \"revoke\" | \"rm\" | \"delete\" | \"remove\" => {","+                self.run_revoke(&normalized, &http_client, &auth_header, retry_opts).await","+            }","+            \"create\" => self.run_create(&normalized, &http_client, &auth_header, retry_opts).await,","+            other => Err(TokenError::UnknownCommand { command: other.to_string() }.into()),","+        }","+    }","+","+    async fn run_list(","+        &self,","+        url: &str,","+        client: &ThrottledClient,","+        auth: &str,","+        retry: RetryOpts,","+    ) -> miette::Result<Option<String>> {","+        let mut tokens = fetch_token_list(url, client, auth, retry).await?;","+        generate_token_ids(&mut tokens);","+        if self.json {","+            let json_tokens = serde_json::to_string_pretty(&tokens).into_diagnostic()?;","+            return Ok(Some(json_tokens));","+        }","+        if self.parseable {","+            return Ok(Some(format_token_list_parseable(&tokens)));","+        }","+        Ok(Some(format_token_list(&tokens)))","+    }","+","+    async fn run_revoke(","+        &self,","+        url: &str,","+        client: &ThrottledClient,","+        auth: &str,","+        retry: RetryOpts,","+    ) -> miette::Result<Option<String>> {","+        let ids = self.params.get(1..).unwrap_or_default();","+        if ids.is_empty() {","+            return Err(TokenError::KeyRequired.into());","+        }","+        let tokens = fetch_token_list(url, client, auth, retry).await?;","+        let keys_to_remove = resolve_keys_to_remove(ids, &tokens)?;","+        self.delete_tokens(url, client, auth, &keys_to_remove, retry).await?;","+        if self.json {","+            return Ok(Some(serde_json::to_string_pretty(&keys_to_remove).into_diagnostic()?));","+        }","+        if self.parseable {","+            return Ok(Some(keys_to_remove.join(\"\\t\")));","+        }","+        let count = keys_to_remove.len();","+        let plural = if count == 1 { \"\" } else { \"s\" };","+        Ok(Some(format!(\"Removed {count} token{plural}\")))","+    }","+","+    /// Revoke `keys` in order. A failure after the first revocation says how","+    /// many were already revoked.","+    async fn delete_tokens(","+        &self,","+        url: &str,","+        client: &ThrottledClient,","+        auth: &str,","+        keys: &[String],","+        retry: RetryOpts,","+    ) -> miette::Result<()> {","+        for (removed, key) in keys.iter().enumerate() {","+            let result = delete_token(url, client, auth, self.otp.as_deref(), key, retry).await;","+            match result {","+                Ok(()) => {}","+                Err(error) if removed == 0 => return Err(error),","+                Err(error) => {","+                    let total = keys.len();","+                    return Err(error.wrap_err(format!(\"Revoked {removed} of {total} tokens\")));","+                }","+            }","+        }","+        Ok(())","+    }","+","+    async fn run_create(","+        &self,","+        url: &str,","+        client: &ThrottledClient,","+        auth: &str,","+        retry: RetryOpts,","+    ) -> miette::Result<Option<String>> {","+        let password = read_password().await?;","+        let request = CreateTokenRequest {","+            password: &password,","+            readonly: self.read_only,","+            cidr_whitelist: &self.cidr,","+        };","+        let created = create_token(url, client, auth, self.otp.as_deref(), &request, retry).await?;","+","+        if self.json {","+            return Ok(Some(serde_json::to_string_pretty(&created).into_diagnostic()?));","+        }","+        if self.parseable {","+            return Ok(Some(format!(\"token\\t{}\\nreadonly\\t{}\", created.token, created.readonly)));","+        }","+        let mut text = format!(\"Created token {}\", created.token);","+        if let Some(cidrs) = &created.cidr_whitelist","+            && !cidrs.is_empty()","+        {","+            let _ = write!(text, \"\\nwith IP whitelist: {}\", cidrs.join(\",\"));","+        }","+        Ok(Some(text))","+    }","+}"],"additions":381,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/token/registry.rs","lines":["@@ -0,0 +1,224 @@","+use crate::cli_args::{","+    registry_client::{apply_auth_and_otp, join_registry_endpoint, join_registry_url},","+    sanitize::{DEFAULT_ERROR_BODY_LIMIT, read_sanitized_error_body},","+    token::{TOKEN_BODY_LIMIT, TokenError, redact_token_argument},","+};","+use miette::{Context, IntoDiagnostic};","+use percent_encoding::{NON_ALPHANUMERIC, utf8_percent_encode};","+use pnpm_network::{RetryOpts, ThrottledClient, read_limited_body, send_with_retry};","+use serde::{Deserialize, Serialize};","+","+/// Bounds the `urls.next` chain of `GET /-/npm/v1/tokens`, so a registry that","+/// keeps returning a next page cannot hold the command forever.","+const MAX_TOKEN_LIST_PAGES: usize = 1000;","+","+#[derive(Debug, Clone, Serialize, Deserialize)]","+pub struct TokenItem {","+    pub key: String,","+    pub token: String,","+    #[serde(default)]","+    pub id: Option<String>,","+    #[serde(default)]","+    pub name: Option<String>,","+    #[serde(default)]","+    pub created: Option<String>,","+    #[serde(default)]","+    pub readonly: bool,","+    #[serde(default)]","+    pub cidr_whitelist: Option<Vec<String>>,","+}","+","+#[derive(Debug, Deserialize)]","+#[serde(untagged)]","+enum TokenListEnvelope {","+    Paged {","+        objects: Vec<TokenItem>,","+        #[serde(default)]","+        urls: TokenListUrls,","+    },","+    List(Vec<TokenItem>),","+}","+","+#[derive(Debug, Default, Deserialize)]","+struct TokenListUrls {","+    #[serde(default)]","+    next: Option<String>,","+}","+","+#[derive(Serialize)]","+pub struct CreateTokenRequest<'a> {","+    pub password: &'a str,","+    pub readonly: bool,","+    #[serde(skip_serializing_if = \"<[_]>::is_empty\")]","+    pub cidr_whitelist: &'a [String],","+}","+","+#[derive(Debug, Serialize, Deserialize)]","+pub struct CreateTokenResponse {","+    pub token: String,","+    #[serde(default)]","+    pub readonly: bool,","+    #[serde(default)]","+    pub cidr_whitelist: Option<Vec<String>>,","+    #[serde(default)]","+    pub expires: Option<serde_json::Value>,","+}","+","+/// Fetch every page of the token list, following `urls.next` while it stays","+/// on the registry's origin.","+pub(super) async fn fetch_token_list(","+    url: &str,","+    http_client: &ThrottledClient,","+    auth_header: &str,","+    retry_opts: RetryOpts,","+) -> miette::Result<Vec<TokenItem>> {","+    let first_page = join_registry_url(url, \"-/npm/v1/tokens\")","+        .into_diagnostic()","+        .wrap_err(\"building the token list URL\")?;","+    let mut tokens = Vec::new();","+    let mut next_page = Some(first_page);","+    for _ in 0..MAX_TOKEN_LIST_PAGES {","+        let Some(page_url) = next_page.take() else { return Ok(tokens) };","+        let envelope =","+            fetch_token_list_page(page_url.as_str(), http_client, auth_header, retry_opts).await?;","+        match envelope {","+            TokenListEnvelope::Paged { objects, urls } => {","+                tokens.extend(objects);","+                next_page =","+                    urls.next.map(|next| resolve_next_page(&page_url, &next)).transpose()?;","+            }","+            TokenListEnvelope::List(list) => tokens.extend(list),","+        }","+    }","+    if next_page.is_none() {","+        return Ok(tokens);","+    }","+    Err(TokenError::RegistryOperationFailed {","+        operation: \"list tokens\",","+        reason: format!(\"the registry returned more than {MAX_TOKEN_LIST_PAGES} pages\"),","+    }","+    .into())","+}","+","+fn resolve_next_page(current: &reqwest::Url, next: &str) -> miette::Result<reqwest::Url> {","+    let next_url = current","+        .join(next)","+        .into_diagnostic()","+        .wrap_err(\"parsing the next token page URL\")?;","+    if next_url.origin() != current.origin() {","+        return Err(TokenError::RegistryOperationFailed {","+            operation: \"list tokens\",","+            reason: \"the next page is on a different origin than the registry\".to_string(),","+        }","+        .into());","+    }","+    Ok(next_url)","+}","+","+async fn fetch_token_list_page(","+    endpoint: &str,","+    http_client: &ThrottledClient,","+    auth_header: &str,","+    retry_opts: RetryOpts,","+) -> miette::Result<TokenListEnvelope> {","+    let (_client, response) = send_with_retry(http_client, endpoint, retry_opts, |cli| {","+        apply_auth_and_otp(cli.get(endpoint), Some(auth_header), None)","+    })","+    .await","+    .into_diagnostic()","+    .wrap_err(\"requesting tokens\")?;","+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {","+        return Err(TokenError::Unauthorized.into());","+    }","+    if !response.status().is_success() {","+        let (status, status_text, body) =","+            read_sanitized_error_body(response, DEFAULT_ERROR_BODY_LIMIT).await;","+        return Err(TokenError::RegistryWriteFailed {","+            action: \"list tokens\".to_string(),","+            status: status.as_u16(),","+            status_text,","+            body,","+        }","+        .into());","+    }","+    let body = read_limited_body(response, TOKEN_BODY_LIMIT).await","+        .map_err(|err| TokenError::RegistryOperationFailed {","+            operation: \"reading token list\",","+            reason: err.to_string(),","+        })?;","+    serde_json::from_slice(&body.bytes).into_diagnostic().wrap_err(\"parsing tokens response\")","+}","+","+pub(super) async fn delete_token(","+    url: &str,","+    http_client: &ThrottledClient,","+    auth_header: &str,","+    otp: Option<&str>,","+    key: &str,","+    retry_opts: RetryOpts,","+) -> miette::Result<()> {","+    let path = format!(\"-/npm/v1/tokens/token/{}\", utf8_percent_encode(key, NON_ALPHANUMERIC));","+    let endpoint = join_registry_endpoint(url, &path).unwrap_or_else(|_| format!(\"{url}{path}\"));","+    let (_client, response) = send_with_retry(http_client, &endpoint, retry_opts, |cli| {","+        apply_auth_and_otp(cli.delete(&endpoint), Some(auth_header), otp)","+    })","+    .await","+    .into_diagnostic()","+    .wrap_err(\"revoking token\")?;","+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {","+        return Err(TokenError::Unauthorized.into());","+    }","+    if !response.status().is_success() {","+        let (status, status_text, body) =","+            read_sanitized_error_body(response, DEFAULT_ERROR_BODY_LIMIT).await;","+        return Err(TokenError::RegistryWriteFailed {","+