s\"))","+          .putAll(ManagedOptions.owned(\"an INSERT has no error output\", \"error_handling\"))","+          .build();","+","   @VisibleForTesting final String tableIdentifier;","   @VisibleForTesting final IcebergCatalogConfig catalogConfig;","   @VisibleForTesting @Nullable Integer triggeringFrequency;","   @VisibleForTesting final @Nullable List<String> partitionFields;"," ","+  /** The options of an INSERT's {@code WITH} clause, or empty for the table itself. */","+  private final Map<String, Object> writeOptions;","+","   IcebergTable(String tableIdentifier, Table table, IcebergCatalogConfig catalogConfig) {","     super(table.getSchema());","     this.schema = table.getSchema();","@@ -90,19 +121,74 @@ final class IcebergTable extends SchemaBaseBeamTable {","     }"," ","     this.partitionFields = table.getPartitionFields();","+    this.writeOptions = ImmutableMap.of();","+  }","+","+  private IcebergTable(IcebergTable table, Schema schema, Map<String, Object> writeOptions) {","+    super(schema);","+    this.tableIdentifier = table.tableIdentifier;","+    this.catalogConfig = table.catalogConfig;","+    this.triggeringFrequency = table.triggeringFrequency;","+    this.partitionFields = table.partitionFields;","+    this.writeOptions = writeOptions;","+  }","+","+  /**","+   * Returns this table as the target of an INSERT with {@code WITH} options, which are options of","+   * the Managed Iceberg write. With {@code 'mode' = 'merge-on-read'}, the INSERT also supplies the","+   * change type column, if {@code change_type_column} names one, and the sequence number column.","+   */","+  @Override","+  public BeamSqlTable forWrite(Map<String, Object> options) {","+    Map<String, Object> checked =","+        ManagedOptions.check(options, WRITE_CONFIG_SCHEMA, WRITE_OWNED_OPTIONS, \"an Iceberg write\");","+    Schema schema = getSchema();","+    if (\"merge-on-read\".equalsIgnoreCase((String) checked.get(\"mode\"))) {","+      @Nullable String changeTypeColumn = (String) checked.get(\"change_type_column\");","+      if (changeTypeColumn != null) {","+        schema = withControlColumn(schema, changeTypeColumn, Schema.FieldType.STRING);","+      }","+      Object sequenceNumberColumn =","+          checked.getOrDefault(","+              \"sequence_number_column\", IcebergCdcMetadataColumns.COMMIT_SNAPSHOT_SEQUENCE_NUMBER);","+      schema = withControlColumn(schema, (String) sequenceNumberColumn, Schema.FieldType.INT64);","+    }","+    IcebergTable target = new IcebergTable(this, schema, checked);","+    // Building the Managed write's transform to validate options","+    WRITE_PROVIDER.from(","+        Row.withSchema(WRITE_CONFIG_SCHEMA).withFieldValues(target.writeConfig()).build());","+    return target;","+  }","+","+  private static Schema withControlColumn(Schema schema, String name, Schema.FieldType type) {","+    checkArgument(","+        !schema.hasField(name),","+        \"Merge-on-read control column '%s' collides with another column\",","+        name);","+    return Schema.builder().addFields(schema.getFields()).addField(name, type).build();","   }"," ","   @Override","   public POutput buildIOWriter(PCollection<Row> input) {","+    return input.apply(Managed.write(Managed.ICEBERG).withConfig(writeConfig()));","+  }","+","+  /**","+   * The Managed write configuration: the table's, its stored triggering frequency, the INSERT's","+   * {@code WITH} options, which override it, and its partition fields.","+   */","+  @VisibleForTesting","+  Map<String, Object> writeConfig() {","     ImmutableMap.Builder<String, Object> configBuilder = ImmutableMap.builder();","     configBuilder.putAll(getBaseConfig());","     if (triggeringFrequency != null) {","       configBuilder.put(TRIGGERING_FREQUENCY_FIELD, triggeringFrequency);","     }","+    configBuilder.putAll(writeOptions);","     if (partitionFields != null) {","       configBuilder.put(\"partition_fields\", partitionFields);","     }","-    return input.apply(Managed.write(Managed.ICEBERG).withConfig(configBuilder.build()));","+    return configBuilder.buildKeepingLast();","   }"," ","   @Override"],"additions":87,"deletions":1,"truncated":false},{"path":"sdks/java/extensions/sql/iceberg/src/main/java/org/apache/beam/sdk/extensions/sql/meta/provider/iceberg/ManagedOptions.java","lines":["@@ -0,0 +1,184 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.apache.beam.sdk.extensions.sql.meta.provider.iceberg;","+","+import static org.apache.beam.sdk.util.Preconditions.checkStateNotNull;","+import static org.apache.beam.vendor.guava.v32_1_2_jre.com.google.common.base.Preconditions.checkArgument;","+","+import java.math.BigDecimal;","+import java.util.List;","+import java.util.Map;","+import java.util.stream.Collectors;","+import org.apache.beam.sdk.schemas.Schema;","+import org.apache.beam.sdk.schemas.Schema.FieldType;","+import org.apache.beam.vendor.guava.v32_1_2_jre.com.google.common.collect.ImmutableList;","+import org.apache.beam.vendor.guava.v32_1_2_jre.com.google.common.collect.ImmutableMap;","+import org.checkerframework.checker.nullness.qual.Nullable;","+","+/** Checks the options of a {@code WITH} clause against a Managed configuration schema. */","+final class ManagedOptions {","+  private ManagedOptions() {}","+","+  /** Maps each key to {@code reason}, why {@code WITH} cannot set it. */","+  static Map<String, String> owned(String reason, String... keys) {","+    ImmutableMap.Builder<String, String> owned = ImmutableMap.builder();","+    for (String key : keys) {","+      owned.put(key, reason);","+    }","+    return owned.build();","+  }","+","+  /**","+   * Returns the options as the Java values {@code configSchema} expects.","+   *","+   * @param owned the keys that {@code WITH} cannot set, each mapped to the reason","+   * @param use what the options configure, for error messages","+   * @throws IllegalArgumentException for an owned or unknown key, or a value of the wrong type","+   */","+  static Map<String, Object> check(","+      Map<String, Object> options, Schema configSchema, Map<String, String> owned, String use) {","+    ImmutableMap.Builder<String, Object> checked = ImmutableMap.builder();","+    for (Map.Entry<String, Object> option : options.entrySet()) {","+      String key = option.getKey();","+      @Nullable String reason = owned.get(key);","+      checkArgument(reason == null, \"Option '%s' cannot be set in WITH: %s\", key, reason);","+      if (!configSchema.hasField(key)) {","+        List<String> accepted =","+            configSchema.getFieldNames().stream()","+                .filter(name -> !owned.containsKey(name))","+                .sorted()","+                .collect(Collectors.toList());","+        throw new IllegalArgumentException(","+            String.format(\"Unknown option '%s' for %s. Accepted options: %s\", key, use, accepted));","+      }","+      FieldType type = configSchema.getField(key).getType();","+      @Nullable Object value = convert(option.getValue(), type);","+      if (value == null) {","+        throw new IllegalArgumentException(","+            String.format(\"Option '%s' must be of type %s\", key, sqlType(type)));","+      }","+      checked.put(key, value);","+    }","+    return checked.build();","+  }","+","+  /**","+   * Returns {@code value} as the Java type of {@code type}, or null if it is not of that type.","+   * {@code WITH} gives integers as Long and other numbers as Double.","+   */","+  private static @Nullable Object convert(@Nullable Object value, FieldType type) {","+    switch (type.getTypeName()) {","+      case STRING:","+        return value instanceof String ? value : null;","+      case BOOLEAN:","+        return value instanceof Boolean ? value : null;","+      case BYTE:","+      case INT16:","+      case INT32:","+      case INT64:","+        return value instanceof Long ? tryInteger((Long) value, type) : null;","+      case FLOAT:","+        if (!(value instanceof Long || value instanceof Double)) {","+          return null;","+        }","+        double number = ((Number) value).doubleValue();","+        float narrowed = (float) number;","+        return Float.isInfinite(narrowed) || (narrowed == 0 && number != 0) ? null : narrowed;","+      case DOUBLE:","+        return value instanceof Long || value instanceof Double","+            ? ((Number) value).doubleValue()","+            : null;","+      case DECIMAL:","+        if (value instanceof Long) {","+          return BigDecimal.valueOf((Long) value);","+        }","+        return value instanceof Double ? BigDecimal.valueOf((Double) value) : null;","+      case ARRAY:","+        if (!(value instanceof List)) {","+          return null;","+        }","+        FieldType elementType = checkStateNotNull(type.getCollectionElementType());","+        ImmutableList.Builder<Object> list = ImmutableList.builder();","+        for (Object element : (List<?>) value) {","+          @Nullable Object converted = convert(element, elementType);","+          if (converted == null) {","+            return null;","+          }","+          list.add(converted);","+        }","+        return list.build();","+      case MAP:","+        if (!(value instanceof Map)) {","+          return null;","+        }","+        FieldType keyType = checkStateNotNull(type.getMapKeyType());","+        FieldType valueType = checkStateNotNull(type.getMapValueType());","+        ImmutableMap.Builder<Object, Object> map = ImmutableMap.builder();","+        for (Map.Entry<?, ?> entry : ((Map<?, ?>) value).entrySet()) {","+          @Nullable Object convertedKey = convert(entry.getKey(), keyType);","+          @Nullable Object convertedValue = convert(entry.getValue(), valueType);","+          if (convertedKey == null || convertedValue == null) {","+            return null;","+          }","+          map.put(convertedKey, convertedValue);","+        }","+        return map.build();","+      default:","+        return null;","+    }","+  }","+","+  /** Returns {@code value} as the integer type of {@code type}, or null if it is out of range. */","+  private static @Nullable Object tryInteger(long value, FieldType type) {","+    switch (type.getTypeName()) {","+      case BYTE:","+        return value == (byte) value ? (byte) value : null;","+      case INT16:","+        return value == (short) value ? (short) value : null;","+      case INT32:","+        return value == (int) value ? (int) value : null;","+      default:","+        return value;","+    }","+  }","+","+  private static String sqlType(FieldType type) {","+    switch (type.getTypeName()) {","+      case STRING:","+        return \"VARCHAR\";","+      case BYTE:","+        return \"TINYINT\";","+      case INT16:","+        return \"SMALLINT\";","+      case INT32:","+        return \"INTEGER\";","+      case INT64:","+        return \"BIGINT\";","+      case ARRAY:","+        return \"ARRAY<\" + sqlType(checkStateNotNull(type.getCollectionElementType())) + \">\";","+      case MAP:","+        return \"MAP<\"","+            + sqlType(checkStateNotNull(type.getMapKeyType()))","+            + \", \"","+            + sqlType(checkStateNotNull(type.getMapValueType()))","+            + \">\";","+      default:","+        return type.getTypeName().name();","+    }","+  }","+}"],"additions":184,"deletions":0,"truncated":false},{"path":"sdks/java/extensions/sql/iceberg/src/test/java/org/apache/beam/sdk/extensions/sql/meta/provider/iceberg/BeamSqlCliIcebergTest.java","lines":["@@ -18,9 +18,12 @@"," package org.apache.beam.sdk.extensions.sql.meta.provider.iceberg;"," "," import static java.lang.String.format;","+import static org.hamcrest.MatcherAssert.assertThat;","+import static org.hamcrest.Matchers.containsString;"," import static org.junit.Assert.assertEquals;"," import static org.junit.Assert.assertFalse;"," import static org.junit.Assert.assertNull;","+import static org.junit.Assert.assertThrows;"," import static org.junit.Assert.assertTrue;"," "," import java.io.File;","@@ -38,6 +41,7 @@"," import org.apache.beam.sdk.values.PCollection;"," import org.apache.beam.sdk.values.Row;"," import org.apache.beam.vendor.calcite.v1_40_0.org.apache.calcite.runtime.CalciteContextException;","+import org.apache.beam.vendor.guava.v32_1_2_jre.com.google.common.base.Throwables;"," import org.checkerframework.checker.nullness.qual.Nullable;"," import org.joda.time.DateTime;"," import org.junit.Before;","@@ -233,4 +237,65 @@ public void testCrossCatalogTableWriteAndRead() throws IOException {","     assertEquals(\"catalog_1\", catalogManager.currentCatalog().name());","     assertEquals(\"my_namespace\", catalogManager.currentCatalog().currentDatabase());","   }","+","+  @Test","+  public void testInsertWithOptions() {","+    sqlEnv.executeDdl(createCatalog(\"my_catalog\"));","+    sqlEnv.executeDdl(\"USE CATALOG my_catalog\");","+    sqlEnv.executeDdl(","+        \"CREATE EXTERNAL TABLE orders (id BIGINT NOT NULL, name VARCHAR) TYPE 'iceberg'\");","+    // Merge-on-read applies each row as a change, given by the extra change type and sequence","+    // columns. A colon in an option must not reach the Hadoop catalog as a database name.","+    String applyChanges =","+        \"INSERT INTO orders WITH ('mode' = 'merge-on-read', 'equality_columns' = ARRAY['id'],\"","+            + \" 'num_shards' = 2, 'snapshot_properties' = MAP['source', 'sql:test'],\"","+            + \" 'change_type_column' = 'op', 'sequence_number_column' = 'seq') VALUES \";","+    for (String changes :","+        new String[] {","+          \"(1, 'a', 'INSERT', 1), (2, 'b', 'INSERT', 1)\",","+          \"(1, 'a', 'UPDATE_BEFORE', 2), (1, 'aa', 'UPDATE_AFTER', 2), (2, 'b', 'DELETE', 2)\"","+        }) {","+      Pipeline p = Pipeline.create();","+      BeamSqlRelUtils.toPCollection(p, sqlEnv.parseQuery(applyChanges + changes));","+      p.run().waitUntilFinish();","+    }","+","+    Pipeline p = Pipeline.create();","+    PCollection<Row> output =","+        BeamSqlRelUtils.toPCollection(p, sqlEnv.parseQuery(\"SELECT * FROM orders\"));","+    PAssert.that(output)","+        .containsInAnyOrder(Row.withSchema(output.getSchema()).addValues(1L, \"aa\").build());","+    p.run().waitUntilFinish();","+","+    String[][] invalidStatements = {","+      {\"SELECT * FROM orders WITH ('mode' = 'append')\", \"does not support WITH options for reads\"},","+      {","+        \"INSERT INTO orders WITH ('partition_fields' = ARRAY['id']) SELECT * FROM orders\",","+        \"Option 'partition_fields' cannot be set in WITH: it applies only when the write creates\"","+            + \" the table\"","+      },","+      {","+        \"INSERT INTO orders WITH ('streaming' = TRUE) SELECT * FROM orders\",","+        \"Unknown option 'streaming' for an Iceberg write. Accepted options: [\"","+      },","+      {","+        \"INSERT INTO orders WITH ('num_shards' = 'two') SELECT * FROM orders\",","+        \"Option 'num_shards' must be of type INTEGER\"","+      },","+      {","+        \"INSERT INTO orders WITH ('num_shards' = 2) SELECT * FROM orders\",","+        \"The following options are not supported in 'append' mode yet: [