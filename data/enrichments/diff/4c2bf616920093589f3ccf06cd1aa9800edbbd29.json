he License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package core","+","+import (","+\t\"testing\"","+","+\tudpa \"github.com/cncf/xds/go/udpa/type/v1\"","+\tcluster \"github.com/envoyproxy/go-control-plane/envoy/config/cluster/v3\"","+\tcore \"github.com/envoyproxy/go-control-plane/envoy/config/core/v3\"","+\ttcp \"github.com/envoyproxy/go-control-plane/envoy/extensions/filters/network/tcp_proxy/v3\"","+\tinternalupstream \"github.com/envoyproxy/go-control-plane/envoy/extensions/transport_sockets/internal_upstream/v3\"","+\t\"google.golang.org/protobuf/proto\"","+","+\t\"istio.io/api/label\"","+\tnetworking \"istio.io/api/networking/v1alpha3\"","+\t\"istio.io/istio/pilot/pkg/features\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\tistionetworking \"istio.io/istio/pilot/pkg/networking\"","+\t\"istio.io/istio/pilot/pkg/networking/util\"","+\t\"istio.io/istio/pilot/pkg/xds/endpoints\"","+\t\"istio.io/istio/pilot/test/xdstest\"","+\t\"istio.io/istio/pkg/config\"","+\t\"istio.io/istio/pkg/config/constants\"","+\t\"istio.io/istio/pkg/config/protocol\"","+\t\"istio.io/istio/pkg/config/schema/gvk\"","+\t\"istio.io/istio/pkg/test\"","+\t\"istio.io/istio/pkg/test/util/assert\"","+\t\"istio.io/istio/pkg/util/protomarshal\"","+\t\"istio.io/istio/pkg/wellknown\"","+)","+","+func adapterTestProxy(cg *ConfigGenTest, kind model.NodeType, enabled bool) *model.Proxy {","+\treturn cg.SetupProxy(&model.Proxy{","+\t\tType:     kind,","+\t\tMetadata: &model.NodeMetadata{EnableHBONEConnectWait: model.StringBool(enabled)},","+\t\tLabels:   map[string]string{label.GatewayManaged.Name: constants.ManagedGatewayMeshControllerLabel},","+\t})","+}","+","+func TestHBONEConnectWaitSharedListener(t *testing.T) {","+\ttest.SetForTest(t, &features.EnableHBONESend, true)","+\ttest.SetForTest(t, &features.EnableAmbientMultiNetwork, false)","+\ttest.SetForTest(t, &features.EnableAmbientIngressMultiNetwork, false)","+\tfor _, baggage := range []bool{false, true} {","+\t\ttest.SetForTest(t, &features.EnableAmbientBaggage, baggage)","+\t\tcg := NewConfigGenTest(t, TestOptions{ConfigString: `","+apiVersion: telemetry.istio.io/v1","+kind: Telemetry","+metadata:","+  name: outbound-logs","+  namespace: default","+spec:","+  accessLogging:","+  - providers:","+    - name: envoy","+    match:","+      mode: CLIENT","+  - providers:","+    - name: envoy","+    match:","+      mode: SERVER","+    disabled: true","+`})","+\t\tfor _, kind := range []model.NodeType{model.Waypoint, model.Router, model.SidecarProxy} {","+\t\t\tstockListeners := cg.Listeners(adapterTestProxy(cg, kind, false))","+\t\t\tfor _, enabled := range []bool{false, true} {","+\t\t\t\tproxy := adapterTestProxy(cg, kind, enabled)","+\t\t\t\tclass := istionetworking.ListenerClassSidecarOutbound","+\t\t\t\tif kind == model.Waypoint {","+\t\t\t\t\tclass = istionetworking.ListenerClassSidecarInbound","+\t\t\t\t}","+\t\t\t\tif kind == model.Router {","+\t\t\t\t\tclass = istionetworking.ListenerClassGateway","+\t\t\t\t}","+\t\t\t\twant := buildConnectOriginateListener(cg.PushContext(), proxy, class)","+\t\t\t\tlisteners := cg.Listeners(proxy)","+\t\t\t\t// CONNECT wait is configured on the clusters and transports, so enabling","+\t\t\t\t// it must not add listeners or change their filters, telemetry, or names.","+\t\t\t\tassert.Equal(t, listeners, stockListeners)","+\t\t\t\tfound := 0","+\t\t\t\tfor _, l := range listeners {","+\t\t\t\t\tif l.Name != ConnectOriginate {","+\t\t\t\t\t\tcontinue","+\t\t\t\t\t}","+\t\t\t\t\tfound++","+\t\t\t\t\tassert.Equal(t, l, want)","+\t\t\t\t\tfilters := l.FilterChains[0].Filters","+\t\t\t\t\tterminal := filters[len(filters)-1]","+\t\t\t\t\tassert.Equal(t, terminal.Name, wellknown.TCPProxy)","+\t\t\t\t\ttcpProxy := &tcp.TcpProxy{}","+\t\t\t\t\tassert.NoError(t, terminal.GetTypedConfig().UnmarshalTo(tcpProxy))","+\t\t\t\t\tif kind == model.SidecarProxy {","+\t\t\t\t\t\tassert.Equal(t, len(tcpProxy.AccessLog), 1)","+\t\t\t\t\t}","+\t\t\t\t\tassert.Equal(t, tcpProxy.GetCluster(), ConnectOriginate)","+\t\t\t\t\tassert.Equal(t, tcpProxy.GetTunnelingConfig().Hostname, \"%DOWNSTREAM_LOCAL_ADDRESS%\")","+\t\t\t\t\tassert.Equal(t, tcpProxy.GetUpstreamConnectMode(), tcp.UpstreamConnectMode_IMMEDIATE)","+\t\t\t\t\tassert.Equal(t, tcpProxy.GetTunnelingConfig().GetUsePost(), false)","+\t\t\t\t}","+\t\t\t\tassert.Equal(t, found, 1)","+\t\t\t}","+\t\t}","+\t}","+}","+","+// Verify EDS marks HBONE endpoints while CDS applies service, port, and subset policies.","+func TestHBONEOriginationAdapterPairing(t *testing.T) {","+\ttest.SetForTest(t, &features.EnableHBONESend, true)","+\ttest.SetForTest(t, &features.PreferHBONESend, true)","+\ttest.SetForTest(t, &features.EnableAmbientMultiNetwork, false)","+\ttest.SetForTest(t, &features.EnableAmbientIngressMultiNetwork, false)","+\tport := &model.Port{Name: \"http\", Port: 80, Protocol: protocol.HTTP}","+\tsvc := &model.Service{","+\t\tHostname: \"app.default.svc.cluster.local\", DefaultAddress: \"10.0.0.1\",","+\t\tPorts: model.PortList{port}, Resolution: model.ClientSideLB,","+\t\tAttributes: model.ServiceAttributes{Name: \"app\", Namespace: \"default\"},","+\t}","+\tfor _, tt := range []struct {","+\t\tname    string","+\t\tpolicy  *networking.TrafficPolicy","+\t\tsubset  string","+\t\tsubsets []*networking.Subset","+\t\tadapter bool","+\t}{","+\t\t{name: \"raw\", adapter: true},","+\t\t{name: \"istio mutual\", adapter: true, policy: &networking.TrafficPolicy{Tls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_ISTIO_MUTUAL}}},","+\t\t{name: \"application tls\", policy: &networking.TrafficPolicy{Tls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_SIMPLE}}},","+\t\t{name: \"application mtls\", policy: &networking.TrafficPolicy{Tls: &networking.ClientTLSSettings{","+\t\t\tMode: networking.ClientTLSSettings_MUTUAL, ClientCertificate: \"/cert\", PrivateKey: \"/key\", CaCertificates: \"/root\",","+\t\t}}},","+\t\t{name: \"proxy protocol\", policy: &networking.TrafficPolicy{ProxyProtocol: &networking.TrafficPolicy_ProxyProtocol{}}},","+\t\t{name: \"port application tls\", policy: &networking.TrafficPolicy{PortLevelSettings: []*networking.TrafficPolicy_PortTrafficPolicy{{","+\t\t\tPort: &networking.PortSelector{Number: 80}, Tls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_SIMPLE},","+\t\t}}}},","+\t\t{name: \"subset application tls\", subset: \"v1\", subsets: []*networking.Subset{{Name: \"v1\", TrafficPolicy: &networking.TrafficPolicy{","+\t\t\tTls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_SIMPLE},","+\t\t}}}},","+\t\t{","+\t\t\tname: \"subset disables application tls\", adapter: true, subset: \"v1\",","+\t\t\tpolicy: &networking.TrafficPolicy{Tls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_SIMPLE}},","+\t\t\tsubsets: []*networking.Subset{{Name: \"v1\", TrafficPolicy: &networking.TrafficPolicy{","+\t\t\t\tTls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_DISABLE},","+\t\t\t}}},","+\t\t},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tdr := config.Config{","+\t\t\t\tMeta: config.Meta{GroupVersionKind: gvk.DestinationRule, Name: \"app\", Namespace: \"default\"},","+\t\t\t\tSpec: &networking.DestinationRule{Host: string(svc.Hostname), TrafficPolicy: tt.policy, Subsets: tt.subsets},","+\t\t\t}","+\t\t\tcg := NewConfigGenTest(t, TestOptions{","+\t\t\t\tServices: []*model.Service{svc}, Configs: []config.Config{dr},","+\t\t\t\tInstances: []*model.ServiceInstance{{Service: svc, ServicePort: port, Endpoint: &model.IstioEndpoint{","+\t\t\t\t\tAddresses: []string{\"10.0.0.2\"}, EndpointPort: 8080, ServicePortName: \"http\",","+\t\t\t\t\tNamespace: \"default\", CapturedByZtunnel: true,","+\t\t\t\t}}},","+\t\t\t})","+\t\t\tfor _, kind := range []model.NodeType{model.Waypoint, model.Router, model.SidecarProxy} {","+\t\t\t\tvar stockTransport *core.TransportSocket","+\t\t\t\tfor _, enabled := range []bool{false, true} {","+\t\t\t\t\tproxy := adapterTestProxy(cg, kind, enabled)","+\t\t\t\t\tcb := NewClusterBuilder(proxy, &model.PushRequest{Push: cg.PushContext()}, model.NewXdsCache())","+\t\t\t\t\tdirection, subset := model.TrafficDirectionOutbound, tt.subset","+\t\t\t\t\tvar subsetPolicy *networking.TrafficPolicy","+\t\t\t\t\tif len(tt.subsets) > 0 {","+\t\t\t\t\t\tsubsetPolicy = tt.subsets[0].TrafficPolicy","+\t\t\t\t\t}","+\t\t\t\t\tpolicy := util.MergeSubsetTrafficPolicy(tt.policy, subsetPolicy, port)","+\t\t\t\t\tvar c *cluster.Cluster","+\t\t\t\t\tif kind == model.Waypoint {","+\t\t\t\t\t\tdirection, subset = model.TrafficDirectionInboundVIP, \"http\"","+\t\t\t\t\t\tif tt.subset != \"\" {","+\t\t\t\t\t\t\tsubset += \"/\" + tt.subset","+\t\t\t\t\t\t}","+\t\t\t\t\t\tc = cb.buildWaypointInboundVIPCluster(proxy, svc, *port, subset, cg.PushContext().Mesh, policy, &dr)","+\t\t\t\t\t} else {","+\t\t\t\t\t\tc = &cluster.Cluster{ClusterDiscoveryType: &cluster.Cluster_Type{Type: cluster.Cluster_EDS}}","+\t\t\t\t\t\tcb.applyTrafficPolicy(svc, buildClusterOpts{","+\t\t\t\t\t\t\tmutable: &clusterWrapper{cluster: c}, policy: policy, port: port,","+\t\t\t\t\t\t\tmesh: cg.PushContext().Mesh, direction: direction,","+\t\t\t\t\t\t})","+\t\t\t\t\t}","+\t\t\t\t\twantAdapter := enabled && tt.adapter","+\t\t\t\t\tassert.Equal(t, c.UpstreamConfig != nil, wantAdapter)","+\t\t\t\t\tclusterName := model.BuildSubsetKey(direction, subset, svc.Hostname, port.Port)","+\t\t\t\t\teb := endpoints.NewEndpointBuilder(clusterName, proxy, cg.PushContext())","+\t\t\t\t\tlocalities := eb.FromServiceEndpoints()","+\t\t\t\t\tif len(localities) != 1 || len(localities[0].LbEndpoints) != 1 {","+\t\t\t\t\t\tt.Fatalf(\"unexpected endpoints: %v\", localities)","+\t\t\t\t\t}","+\t\t\t\t\tassert.Equal(t, eb.WithSubset(subset).FromServiceEndpoints(), localities)","+\t\t\t\t\tmetadata := localities[0].LbEndpoints[0].GetMetadata().GetFilterMetadata()[util.EnvoyTransportSocketMetadataKey].GetFields()","+\t\t\t\t\t// EDS marks HBONE endpoints regardless of policy; CDS controls which transport is used.","+\t\t\t\t\tassert.Equal(t, metadata[model.TunnelLabelShortName].GetStringValue(), model.TunnelHTTP)","+\t\t\t\t\ttransport := c.TransportSocket","+\t\t\t\t\tfor _, match := range c.TransportSocketMatches {","+\t\t\t\t\t\tmatches := true","+\t\t\t\t\t\tfor key, value := range match.Match.Fields {","+\t\t\t\t\t\t\tif !proto.Equal(metadata[key], value) {","+\t\t\t\t\t\t\t\tmatches = false","+\t\t\t\t\t\t\t\tbreak","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t\tif matches {","+\t\t\t\t\t\t\ttransport = match.TransportSocket","+\t\t\t\t\t\t\tbreak","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t\tif transport == nil {","+\t\t\t\t\t\tt.Fatal(\"missing HBONE transport\")","+\t\t\t\t\t}","+\t\t\t\t\tassert.Equal(t, transport.Name == util.HBONEOriginationAdapterTransport, wantAdapter)","+\t\t\t\t\tif !enabled {","+\t\t\t\t\t\tstockTransport = transport","+\t\t\t\t\t}","+\t\t\t\t\tif !wantAdapter {","+\t\t\t\t\t\tassert.Equal(t, transport, stockTransport)","+\t\t\t\t\t}","+\t\t\t\t\tep := localities[0].LbEndpoints[0].GetEndpoint()","+\t\t\t\t\tassert.Equal(t, ep.Address.GetEnvoyInternalAddress().GetServerListenerName(), ConnectOriginate)","+\t\t\t\t\tassert.Equal(t, xdstest.ExtractListener(ConnectOriginate, cg.Listeners(proxy)) != nil, true)","+\t\t\t\t\tassert.Equal(t, ep.Address.GetEnvoyInternalAddress().GetEndpointId(), \"10.0.0.2:8080\")","+\t\t\t\t\t// Ineligible services share the HBONE cluster, whose pool passes through","+\t\t\t\t\t// callers without CONNECT-wait state.","+\t\t\t\t\touter := cb.buildWaypointConnectOriginate(proxy, cg.PushContext())","+\t\t\t\t\tassertHBONEConnectWaitPool(t, outer, enabled)","+\t\t\t\t\tassert.Equal(t, outer.TransportSocket.Name, \"tls\")","+\t\t\t\t\tassert.Equal(t, outer.TypedExtensionProtocolOptions != nil, true)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestHBONEOriginationAdapterMetadata(t *testing.T) {","+\tfor _, baggage := range []bool{false, true} {","+\t\ttest.SetForTest(t, &features.EnableAmbientBaggage, baggage)","+\t\tfor _, pair := range [][2]*core.TransportSocket{","+\t\t\t{util.WaypointInternalUpstreamTransportSocket(util.RawBufferTransport()), util.WaypointHBONEOriginationAdapterTransportSocket()},","+\t\t\t{","+\t\t\t\tutil.FullMetadataPassthroughInternalUpstreamTransportSocket(util.RawBufferTransport()),","+\t\t\t\tutil.FullMetadataPassthroughHBONEOriginationAdapterTransportSocket(),","+\t\t\t},","+\t\t} {","+\t\t\toriginal := &internalupstream.InternalUpstreamTransport{}","+\t\t\tassert.NoError(t, pair[0].GetTypedConfig().UnmarshalTo(original))","+\t\t\twrapped := &udpa.TypedStruct{}","+\t\t\tassert.NoError(t, pair[1].GetTypedConfig().UnmarshalTo(wrapped))","+\t\t\tassert.Equal(t, wrapped.TypeUrl, util.HBONEConnectWaitTransportSocketTypeURL)","+\t\t\tdecoded := &internalupstream.InternalUpstreamTransport{}","+\t\t\tassert.NoError(t, protomarshal.StructToMessageSlow(wrapped.Value, decoded))","+\t\t\tassert.Equal(t, decoded.PassthroughMetadata, original.PassthroughMetadata)","+\t\t}","+\t}","+}"],"additions":268,"deletions":0,"truncated":false},{"path":"pilot/pkg/networking/core/hbone_connect_wait.go","lines":["@@ -0,0 +1,56 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package core","+","+import (","+\tcluster \"github.com/envoyproxy/go-control-plane/envoy/config/cluster/v3\"","+\tcore \"github.com/envoyproxy/go-control-plane/envoy/config/core/v3\"","+\t\"google.golang.org/protobuf/types/known/anypb\"","+","+\tnetworking \"istio.io/api/networking/v1alpha3\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\t\"istio.io/istio/pilot/pkg/networking/util\"","+)","+","+// hboneConnectWaitEligible reports whether this application cluster can use CONNECT wait.","+// Only EDS services without application TLS or PROXY protocol origination are eligible.","+func (cb *ClusterBuilder) hboneConnectWaitEligible(c *cluster.Cluster, service *model.Service, policy *networking.TrafficPolicy) bool {","+\t// Traffic policy can change the cluster type independently of service resolution.","+\tif !cb.hboneConnectWait || c.GetType() != cluster.Cluster_EDS {","+\t\treturn false","+\t}","+\tif service == nil || service.Resolution != model.ClientSideLB || policy.GetProxyProtocol() != nil {","+\t\treturn false","+\t}","+\tswitch policy.GetTls().GetMode() {","+\tcase networking.ClientTLSSettings_DISABLE, networking.ClientTLSSettings_ISTIO_MUTUAL:","+\t\treturn true","+\tdefault:","+\t\treturn false","+\t}","+}","+","+// Required on both application clusters using the adapter transport and their HBONE","+// origination clusters. The pool signals CONNECT readiness from tunneling callbacks","+// and handles permanent rejections for HTTP and TCP application consumers. Shared","+// HBONE listeners and clusters pass callers without CONNECT-wait state through to the stock pool.","+func applyHBONEConnectWaitPool(c *cluster.Cluster) {","+\t// The router resolves this config for every upstream request attempt. Use a","+\t// direct, empty Any to avoid converting a TypedStruct on each attempt.","+\tc.UpstreamConfig = &core.TypedExtensionConfig{","+\t\tName:        util.HBONEConnectWaitPool,","+\t\tTypedConfig: &anypb.Any{TypeUrl: util.HBONEConnectWaitPoolTypeURL},","+\t}","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"pilot/pkg/networking/core/hbone_connect_wait_test.go","lines":["@@ -0,0 +1,173 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package core","+","+import (","+\t\"fmt\"","+\t\"testing\"","+","+\tudpa \"github.com/cncf/xds/go/udpa/type/v1\"","+\tcluster \"github.com/envoyproxy/go-control-plane/envoy/config/cluster/v3\"","+\tcore \"github.com/envoyproxy/go-control-plane/envoy/config/core/v3\"","+\ttls \"github.com/envoyproxy/go-control-plane/envoy/extensions/transport_sockets/tls/v3\"","+\t\"google.golang.org/protobuf/types/known/structpb\"","+","+\t\"istio.io/api/label\"","+\tnetworking \"istio.io/api/networking/v1alpha3\"","+\t\"istio.io/istio/pilot/pkg/features\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\t\"istio.io/istio/pilot/pkg/networking/util\"","+\t\"istio.io/istio/pilot/pkg/xds/endpoints\"","+\t\"istio.io/istio/pilot/test/xdstest\"","+\t\"istio.io/istio/pkg/config/constants\"","+\t\"istio.io/istio/pkg/config/protocol\"","+\t\"istio.io/istio/pkg/test\"","+\t\"istio.io/istio/pkg/test/util/assert\"","+\t\"istio.io/istio/pkg/util/protomarshal\"","+\t\"istio.io/istio/pkg/wellknown\"","+)","+","+func assertHBONEConnectWaitPool(t *testing.T, c *cluster.Cluster, enabled bool) {","+\tt.Helper()","+\tif c == nil {","+\t\tt.Fatal(\"missing HBONE cluster\")","+\t}","+\tif !enabled {","+\t\tassert.Equal(t, c.UpstreamConfig == nil, true)","+\t\treturn","+\t}","+\tassert.Equal(t, c.GetUpstreamConfig().GetName(), util.HBONEConnectWaitPool)","+\tassert.Equal(t, c.GetUpstreamConfig().GetTypedConfig().GetTypeUrl(), util.HBONEConnectWaitPoolTypeURL)","+\tassert.Equal(t, len(c.GetUpstreamConfig().GetTypedConfig().GetValue()), 0)","+}","+","+func TestHBONEConnectWaitUnsupportedServices(t *testing.T) {","+\tcb := &ClusterBuilder{hboneConnectWait: true}","+\tc := &cluster.Cluster{ClusterDiscoveryType: &cluster.Cluster_Type{Type: cluster.Cluster_EDS}}","+\tassert.Equal(t, cb.hboneConnectWaitEligible(c, nil, nil), false)","+\tfor _, resolution := range []model.Resolution{model.DNSLB, model.DNSRoundRobinLB, model.Passthrough, model.DynamicDNS} {","+\t\tassert.Equal(t, cb.hboneConnectWaitEligible(c, &model.Service{Resolution: resolution}, nil), false)","+\t}","+\t// Unknown future TLS modes must not silently lose application encryption.","+\tassert.Equal(t, cb.hboneConnectWaitEligible(c, &model.Service{}, &networking.TrafficPolicy{","+\t\tTls: &networking.ClientTLSSettings{Mode: networking.ClientTLSSettings_TLSmode(99)},","+\t}), false)","+}","+","+func TestHBONEConnectWaitOptInAndCacheIsolation(t *testing.T) {","+\ttest.SetForTest(t, &features.EnableHBONESend, true)","+\ttest.SetForTest(t, &features.PreferHBONESend, true)","+\ttest.SetForTest(t, &features.EnableAmbientMultiNetwork, false)","+\tsvc := &model.Service{","+\t\tHostname: \"app.default.svc.cluster.local\", Resolution: model.ClientSideLB,","+\t\tAttributes: model.ServiceAttributes{Namespace: \"default\"},","+\t}","+\tcg := NewConfigGenTest(t, TestOptions{Services: []*model.Service{svc}})","+\tfor _, kind := range []model.NodeType{model.Waypoint, model.Router, model.SidecarProxy} {","+\t\tfor _, appProtocol := range []protocol.Instance{protocol.HTTP, protocol.HTTP2, protocol.TCP} {","+\t\t\tport := &model.Port{Name: \"app\", Port: 80, Protocol: appProtocol}","+\t\t\tvar stockCDS, stockEDS any","+\t\t\tfor _, tt := range []struct {","+\t\t\t\tname     string","+\t\t\t\tmetadata map[string]any","+\t\t\t\twant     bool","+\t\t\t}{","+\t\t\t\t{name: \"unset\", metadata: map[string]any{}},","+\t\t\t\t{name: \"disabled\", metadata: map[string]any{\"ENABLE_HBONE_CONNECT_WAIT\": \"false\"}},","+\t\t\t\t{name: \"enabled\", want: true, metadata: map[string]any{\"ENABLE_HBONE_CONNECT_WAIT\": \"true\"}},","+\t\t\t} {","+\t\t\t\tt.Run(fmt.Sprintf(\"%s/%s/%s\", kind, appProtocol, tt.name), func(t *testing.T) {","+\t\t\t\t\tmetadata, err := structpb.NewStruct(tt.metadata)","+\t\t\t\t\tassert.NoError(t, err)","+\t\t\t\t\tparsed, err := model.ParseMetadata(metadata)","+\t\t\t\t\tassert.NoError(t, err)","+\t\t\t\t\tproxy := cg.SetupProxy(&model.Proxy{","+\t\t\t\t\t\tType: kind, Metadata: parsed,","+\t\t\t\t\t\tLabels: map[string]string{label.GatewayManaged.Name: constants.ManagedGatewayMeshControllerLabel},","+\t\t\t\t\t})","+\t\t\t\t\tcb := NewClusterBuilder(proxy, &model.PushRequest{Push: cg.PushContext()}, model.NewXdsCache())","+\t\t\t\t\tvar c *cluster.Cluster","+\t\t\t\t\tif kind == model.Waypoint {","+\t\t\t\t\t\tsubset := \"http\"","+\t\t\t\t\t\tif appProtocol == protocol.TCP {","+\t\t\t\t\t\t\tsubset = \"tcp\"","+\t\t\t\t\t\t}","+\t\t\t\t\t\tc = cb.buildWaypointInboundVIPCluster(proxy, svc, *port, subset, cg.PushContext().Mesh, nil, nil)","+\t\t\t\t\t} else {","+\t\t\t\t\t\tc = &cluster.Cluster{ClusterDiscoveryType: &cluster.Cluster_Type{Type: cluster.Cluster_EDS}}","+\t\t\t\t\t\tcb.applyTrafficPolicy(svc, buildClusterOpts{","+\t\t\t\t\t\t\tmutable: &clusterWrapper{cluster: c}, port: port,","+\t\t\t\t\t\t\tmesh: cg.PushContext().Mesh, direction: model.TrafficDirectionOutbound,","+\t\t\t\t\t\t})","+\t\t\t\t\t}","+\t\t\t\t\tassertHBONEConnectWaitPool(t, c, tt.want)","+\t\t\t\t\tclusters := xdstest.ExtractClusters(cg.Clusters(proxy))","+\t\t\t\t\tassertHBONEConnectWaitPool(t, clusters[ConnectOriginate], tt.want)","+\t\t\t\t\tcache := buildClusterKey(svc, port, cb, proxy, nil)","+\t\t\t\t\tdirection, subset := model.TrafficDirectionOutbound, \"\"","+\t\t\t\t\tif kind == model.Waypoint {","+\t\t\t\t\t\tdirection, subset = model.TrafficDirectionInboundVIP, \"http\"","+\t\t\t\t\t\tif appProtocol == protocol.TCP {","+\t\t\t\t\t\t\tsubset = \"tcp\"","+\t\t\t\t\t\t}","+\t\t\t\t\t}","+\t\t\t\t\teb := endpoints.NewEndpointBuilder(model.BuildSubsetKey(direction, subset, svc.Hostname, port.Port), proxy, cg.PushContext())","+\t\t\t\t\tif tt.name == \"unset\" {","+\t\t\t\t\t\tstockCDS, stockEDS = cache.Key(), eb.Key()","+\t\t\t\t\t}","+\t\t\t\t\tassert.Equal(t, cache.Key() != stockCDS, tt.want)","+\t\t\t\t\tassert.Equal(t, eb.Key(), stockEDS)","+\t\t\t\t\tlisteners := cg.Listeners(proxy)","+\t\t\t\t\tassert.Equal(t, xdstest.ExtractListener(ConnectOriginate, listeners) != nil, true)","+\t\t\t\t})","+\t\t\t}","+\t\t}","+\t}","+}","+","+func TestHBONEConnectWaitNestedPairing(t *testing.T) {","+\tenableDoubleAdapterTest(t)","+\tfor _, kind := range []model.NodeType{model.Waypoint, model.Router} {","+\t\tcg := NewConfigGenTest(t, TestOptions{ConfigString: doubleAdapterGateway})","+\t\tfor _, enabled := range []bool{false, true} {","+\t\t\tt.Run(fmt.Sprintf(\"%s/enabled=%t\", kind, enabled), func(t *testing.T) {","+\t\t\t\tproxy := doubleAdapterProxy(cg, kind, enabled)","+\t\t\t\tcb := NewClusterBuilder(proxy, &model.PushRequest{Push: cg.PushContext()}, model.NewXdsCache())","+\t\t\t\tc := cb.buildInnerConnectOriginateCluster(proxy, cg.PushContext())","+\t\t\t\tassertHBONEConnectWaitPool(t, c, enabled)","+\t\t\t\tassertHBONEConnectWaitPool(t, cb.buildOuterConnectOriginateCluster(proxy, cg.PushContext()), enabled)","+\t\t\t\touter := xdstest.ExtractListener(DoubleHBONEOuterConnectOriginate, cg.Listeners(proxy))","+\t\t\t\tif outer == nil {","+\t\t\t\t\tt.Fatal(\"missing outer HBONE listener\")","+\t\t\t\t}","+\t\t\t\tendpoint := c.LoadAssignment.Endpoints[0].LbEndpoints[0].GetEndpoint().Address.GetEnvoyInternalAddress()","+\t\t\t\tassert.Equal(t, endpoint.GetServerListenerName(), outer.Name)","+\t\t\t\tassert.Equal(t, outer.FilterChains[0].Filters[0].Name, wellknown.TCPProxy)","+\t\t\t\tif !enabled {","+\t\t\t\t\tassert.Equal(t, c.TransportSocket.Name, \"internal_upstream_with_tls\")","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tassert.Equal(t, c.TransportSocket.Name, util.HBONEOriginationAdapterTransport)","+\t\t\t\twrapped := &udpa.TypedStruct{}","+\t\t\t\tassert.NoError(t, c.TransportSocket.GetTypedConfig().UnmarshalTo(wrapped))","+\t\t\t\tsocket := &core.TransportSocket{}","+\t\t\t\tassert.NoError(t, protomarshal.StructToMessageSlow(wrapped.Value.Fields[\"transport_socket\"].GetStructValue(), socket))","+\t\t\t\tinnerTLS := &tls.UpstreamTlsContext{}","+\t\t\t\tassert.NoError(t, socket.GetTypedConfig().UnmarshalTo(innerTLS))","+\t\t\t\tassert.Equal(t, innerTLS.CommonTlsContext, buildCommonConnectTLSContext(proxy, cg.PushContext()))","+\t\t\t})","+\t\t}","+\t}","+}"],"additions":173,"deletions":0,"truncated":false},{"path":"pilot/pkg/networking/core/hbone_double_adapter_test.go","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":555,"deletions":3,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-21T16:32:27.411865+00:00"}