ays count: other objects with `__len__`, e.g. `tqdm(generator)`,","+    may not know their length.","+    \"\"\"","+    if isinstance(vectors, dict):  # numpy arrays of named vectors, all as long","+        return len(next(iter(vectors.values()))) if vectors else 0","+    return len(vectors) if isinstance(vectors, (Sequence, np.ndarray)) else None","+","+","+def require_length(items: Iterable | None, size: int, name: str) -> Iterable | None:","+    \"\"\"Makes `ids` or `payload` of `upload_collection` raise if they end before `size` vectors.","+","+    Checked at once for lists, tuples and arrays, otherwise when the stream runs out. They may be","+    longer, e.g. `itertools.count()`: a stream is read only up to `size` items.","+    \"\"\"","+    if items is None:","+        return None","+    if isinstance(items, (Sequence, np.ndarray)):","+        if len(items) < size:","+            raise ValueError(f\"{name} iterable is shorter than vectors iterable\")","+        return items","+    return _take_exactly(items, size, name)","+","+","+def _take_exactly(items: Iterable, size: int, name: str) -> Iterator:","+    taken = 0","+    for item in islice(items, size):","+        yield item","+        taken += 1","+    if taken < size:","+        raise ValueError(f\"{name} iterable is shorter than vectors iterable\")"],"additions":41,"deletions":0,"truncated":false},{"path":"qdrant_client/local/async_qdrant_local.py","lines":["@@ -939,7 +939,9 @@ def uuid_generator() -> Generator[str, None, None]:","                 payload=payload or {},","             )","             for (point_id, vector, payload) in zip(","-                ids or uuid_generator(), iter(vectors), payload or itertools.cycle([{}])","+                uuid_generator() if ids is None else ids,","+                iter(vectors),","+                itertools.cycle([{}]) if payload is None else payload,","             )","         ]","         if len(point_structs) > 0:"],"additions":3,"deletions":1,"truncated":