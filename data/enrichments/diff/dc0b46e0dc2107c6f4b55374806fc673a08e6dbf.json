eString::kChangeStreamPreImagesNamespace, options);","+    EXPECT_FALSE(isCollectionHashEligibleFor(_opCtx.get(),","+                                             NamespaceString::kChangeStreamPreImagesNamespace));","+}","+","+TEST_F(VerifyValidationHashTest, IneligibleForUnreplicatedCollections) {","+    const auto localNss = NamespaceString::createNamespaceString_forTest(\"local.clustered\");","+    CollectionOptions options;","+    options.clusteredIndex = clustered_util::makeDefaultClusteredIdIndex();","+    createCollection(_opCtx.get(), localNss, options);","+    EXPECT_FALSE(isCollectionHashEligibleFor(_opCtx.get(), localNss));","+}","+","+TEST_F(VerifyValidationHashTest, IneligibleForImplicitlyReplicatedCollections) {","+    CollectionOptions options;","+    options.clusteredIndex = clustered_util::makeDefaultClusteredIdIndex();","+    createCollection(_opCtx.get(), NamespaceString::kConfigImagesNamespace, options);","+    EXPECT_FALSE(","+        isCollectionHashEligibleFor(_opCtx.get(), NamespaceString::kConfigImagesNamespace));","+}","+"," template <typename Base>"," class FatalOnMismatchTest : public Base {"," protected:"],"additions":54,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/internode_validation_hash_utils.cpp","lines":["@@ -5,8 +5,10 @@"," "," #include \"mongo/db/feature_flag.h\""," #include \"mongo/db/repl/replication_coordinator.h\"","+#include \"mongo/db/replicated_fast_count/replicated_fast_count_enabled.h\""," #include \"mongo/db/rss/replicated_storage_service.h\""," #include \"mongo/db/server_feature_flags_gen.h\"","+#include \"mongo/db/shard_role/shard_catalog/clustered_collection_util.h\""," #include \"mongo/db/version_context.h\""," "," // The //src/third_party/xxhash target is header-only and defines XXH_INLINE_ALL for its consumers,","@@ -84,5 +86,14 @@ bool isContinuousInternodeValidationPerCollectionEnabled(OperationContext* opCtx","         gFeatureFlagContinuousInternodeValidationPerCollection","             .isEnabledUseLatestFCVWhenUninitialized(vCtx, fcvSnapshot);"," }","+","+bool isCollectionHashEligible(const CollectionPtr& coll) {","+    // A document's record id has to be reproducible on every node for its hash to be verifiable.","+    if (!coll->areRecordIdsReplicated() &&","+        !(coll->isClustered() && clustered_util::isClusteredOnId(coll->getClusteredInfo()))) {","+        return false;","+    }","+    return isReplicatedFastCountEligible(coll->ns());","+}"," }  // namespace repl"," }  // namespace mongo"],"additions":11,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/internode_validation_hash_utils.h","lines":["@@ -6,6 +6,7 @@"," #include \"mongo/base/data_range.h\""," #include \"mongo/bson/bsonobj.h\""," #include \"mongo/db/operation_context.h\"","+#include \"mongo/db/shard_role/shard_catalog/collection.h\""," #include \"mongo/util/modules.h\""," "," #include <cstdint>","@@ -47,5 +48,11 @@ bool isContinuousInternodeValidationPerDocumentEnabled(OperationContext* opCtx);","  * enabled too.","  */"," bool isContinuousInternodeValidationPerCollectionEnabled(OperationContext* opCtx);","+","+/**","+ * Returns true if 'coll' has reproducible record IDs and belongs to a namespace whose writes are","+ * eligible to carry per-document validation hashes for its collection hash.","+ */","+[[MONGO_MOD_PUBLIC]] bool isCollectionHashEligible(const CollectionPtr& coll);"," }  // namespace repl"],"additions":7,"deletions":0,"truncated":false}],"additions":153,"deletions":54,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-10-15T13:23:32.061455+00:00"}