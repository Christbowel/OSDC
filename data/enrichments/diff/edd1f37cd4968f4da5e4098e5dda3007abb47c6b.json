AS\": False,","+                            \"CATEGORIES_SAVE_AS\": False,","+                        },","+                    )","+","+                    pelican = Pelican(settings=settings)","+                    mute(True)(pelican.run)()","+","+                    with open(","+                        os.path.join(self.temp_output, \"blog\", \"in-blog.html\")","+                    ) as f:","+                        content = f.read()","+","+                    self.assertIn(\"blog\", content)","+                    self.assertNotIn(\"/category/\", content)","+        finally:","+            rmtree(content_dir)","+","     def test_category_and_tag_feed_titles_use_slug(self):","         \"\"\"Feed link titles on category/tag pages should have unique titles.\"\"\""," "],"additions":43,"deletions":2,"truncated":false},{"path":"pelican/themes/notmyidea/templates/article_infos.html","lines":["@@ -16,7 +16,9 @@","                         {% endfor %}","                 </address>","         {% endif %}","-        <p>In <a href=\"{{ SITEURL }}/{{ article.category.url }}\">{{ article.category }}</a>.</p>","+        {% if article.category %}","+                <p>In {% if CATEGORY_SAVE_AS %}<a href=\"{{ SITEURL }}/{{ article.category.url }}\">{{ article.category }}</a>{% else %}{{ article.category }}{% endif %}.</p>","+        {% endif %}","         {% include 'taglist.html' %}","         {% import 'translations.html' as translations with context %}","         {{ translations.translations_for(article) }}"],"additions":3,"deletions":1,"truncated":false},{"path":"pelican/themes/notmyidea/templates/base.html","lines":["@@ -30,7 +30,7 @@ <h1><a href=\"{{ SITEURL }}/\">{{ SITENAME }}{% if SITESUBTITLE %} <strong>{{ SITE","                                                 <li{% if pg == page %} class=\"active\"{% endif %}><a href=\"{{ SITEURL }}/{{ pg.url }}\">{{ pg.title }}</a></li>","                                         {% endfor %}","                                 {% 