uire.Empty(t, folder)","+\t\t\t\treturn authlib.CheckResponse{Allowed: true}, nil","+\t\t\t}}","+\t\t\tcheck := proxyRouteAccessChecker(client)","+\t\t\tctx := krequest.WithNamespace(t.Context(), \"stacks-11\")","+\t\t\tallowed, err := check(ctx, user, \"ds-1\", action)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.True(t, allowed)","+\t\t\trequire.Equal(t, 1, calls)","+\t\t\t// Repeated checks use the authenticated request context.","+\t\t\tallowed, err = check(ctx, user, \"ds-1\", action)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.True(t, allowed)","+\t\t\trequire.Equal(t, 2, calls)","+\t\t})","+\t}","+\tfor _, backendErr := range []error{nil, errors.New(\"authz unavailable\")} {","+\t\tcheck := proxyRouteAccessChecker(proxyAccessClient{check: func(context.Context, authlib.AuthInfo, authlib.CheckRequest, string) (authlib.CheckResponse, error) {","+\t\t\treturn authlib.CheckResponse{}, backendErr","+\t\t}})","+\t\tallowed, err := check(krequest.WithNamespace(t.Context(), \"stacks-11\"), &user.SignedInUser{}, \"ds-1\", \"custom:action\")","+\t\trequire.False(t, allowed)","+\t\trequire.Equal(t, backendErr, err)","+\t}","+}","+","+func TestProxyRouteDelegatedActions(t *testing.T) {","+\tactions := []string{\"datasources:query\", \"alert.rules.external:read\", \"alert.rules.external:write\", \"alert.instances.external:read\", \"alert.instances.external:write\", \"alert.notifications.external:read\", \"alert.notifications.external:write\"}","+\tfor _, granted := range actions {","+\t\tt.Run(granted, func(t *testing.T) {","+\t\t\tcaller := authn.NewIDTokenAuthInfo(","+\t\t\t\tauthn.Claims[authn.AccessTokenClaims]{","+\t\t\t\t\tClaims: jwt.Claims{Subject: \"service\"},","+\t\t\t\t\tRest: authn.AccessTokenClaims{Namespace: \"stacks-11\", DelegatedPermissions: []string{","+\t\t\t\t\t\t\"*.datasource.grafana.app/datasources:\" + granted,","+\t\t\t\t\t}},","+\t\t\t\t},","+\t\t\t\t&authn.Claims[authn.IDTokenClaims]{","+\t\t\t\t\tClaims: jwt.Claims{Subject: \"user:us