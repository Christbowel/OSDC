{"id":"405895fd9e9df216d3bbe310e5fd95a2b621431d","axis":"silent","repo":"wolfSSL/wolfssl","sha":"405895fd9e9df216d3bbe310e5fd95a2b621431d","parsed":{"files":[{"path":"configure.ac","lines":["@@ -9385,11 +9385,19 @@ then","       thread)","         AM_CFLAGS=\"$AM_CFLAGS -DENTROPY_MEMUSE_THREAD\"","         ;;","+      amd-aperf)","+        if (test \"$host_cpu\" != \"x86_64\" && test \"$host_cpu\" != \"amd64\") ||","+           test \"$KERNEL_MODE_DEFAULTS\" = \"yes\"","+        then","+            AC_MSG_ERROR([--enable-wolfEntropy=amd-aperf needs an x86_64 user-space build.])","+        fi","+        AM_CFLAGS=\"$AM_CFLAGS -DWC_ENTROPY_TIMER_AMD_APERF\"","+        ;;","       nofallback)","         AM_CFLAGS=\"$AM_CFLAGS -DENTROPY_MEMUSE_FORCE_FAILURE\"","         ;;","       *)","-        AC_MSG_ERROR([Invalid MemUse Entropy option. Valid are: thread, nofallback. Seen: $ENABLED_ENTROPY_MEMUSE.])","+        AC_MSG_ERROR([Invalid MemUse Entropy option. Valid are: thread, amd-aperf, nofallback. Seen: $ENABLED_ENTROPY_MEMUSE.])","         break;;","       esac","     done"],"additions":9,"deletions":1,"truncated":false},{"path":"src/include.am","lines":["@@ -525,6 +525,7 @@ src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/wolfcrypt_last.c"," # v6 keeps it inside boundary."," if BUILD_MEMUSE"," src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/wolfentropy.c","+src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/entropy-timers.c"," endif"," "," endif BUILD_FIPS_V5","@@ -1432,6 +1433,7 @@ endif !BUILD_FIPS_NO_POST"," # --enable-fips=dev-no-post builds it too."," if BUILD_MEMUSE"," src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/wolfentropy.c","+src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/entropy-timers.c"," endif"," "," endif BUILD_FIPS_V7_PLUS","@@ -1479,6 +1481,7 @@ if BUILD_RNG"," src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/random.c"," if BUILD_MEMUSE"," src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/wolfentropy.c","+src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/entropy-timers.c"," endif"," if BUILD_RNG_BANK"," src_libwolfssl@LIBSUFFIX@_la_SOURCES += wolfcrypt/src/rng_bank.c"],"additions":3,"deletions":0,"truncated":false},{"path":"wolfcrypt/src/entropy-timers.c","lines":["@@ -0,0 +1,95 @@","+/* entropy-timers.c","+ *","+ * Copyright (C) 2006-2026 wolfSSL Inc.","+ *","+ * This file is part of wolfSSL.","+ *","+ * wolfSSL is free software; you can redistribute it and/or modify","+ * it under the terms of the GNU General Public License as published by","+ * the Free Software Foundation; either version 3 of the License, or","+ * (at your option) any later version.","+ *","+ * wolfSSL is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the","+ * GNU General Public License for more details.","+ *","+ * You should have received a copy of the GNU General Public License","+ * along with this program; if not, write to the Free Software","+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1335, USA","+ */","+","+/* Timers for wolfEntropy.  See wolfssl/wolfcrypt/entropy-timers.h. */","+","+#include <wolfssl/wolfcrypt/libwolfssl_sources.h>","+","+#if defined(HAVE_ENTROPY_MEMUSE) && defined(WC_ENTROPY_TIMER_AMD_APERF)","+","+#include <wolfssl/wolfcrypt/entropy-timers.h>","+#include <cpuid.h>","+","+/* AMD64 APM vol. 3: RDPRU is CPUID Fn8000_0008 EBX bit 4 and RDTSCP is","+ * Fn8000_0001 EDX bit 27.  Those leaves are vendor defined, so check AMD first. */","+static int Entropy_AmdRdpruPresent(void)","+{","+    unsigned int eax = 0, ebx = 0, ecx = 0, edx = 0;","+","+    if (!__get_cpuid(0, &eax, &ebx, &ecx, &edx) ||","+            XMEMCMP(&ebx, \"Auth\", 4) != 0 || XMEMCMP(&edx, \"enti\", 4) != 0 ||","+            XMEMCMP(&ecx, \"cAMD\", 4) != 0) {","+        return 0;","+    }","+    if (!__get_cpuid(0x80000001, &eax, &ebx, &ecx, &edx) || !((edx >> 27) & 1))","+        return 0;","+    return __get_cpuid(0x80000008, &eax, &ebx, &ecx, &edx) && ((ebx >> 4) & 1);","+}","+","+/* The CPU number, which Linux stores in TSC_AUX for RDTSCP to return","+ * (arch/x86/kernel/cpu/common.c:2351-2357, setup_getcpu). */","+static unsigned int Entropy_Cpu(void)","+{","+    unsigned int lo, hi, aux;","+","+    __asm__ __volatile__ (\"rdtscp\" : \"=a\"(lo), \"=d\"(hi), \"=c\"(aux));","+    (void)lo;","+    (void)hi;","+    return aux;","+}","+","+/* APERF (RDPRU ECX=1) counts per CPU, so only increments read on one CPU are","+ * added, as Linux does (arch/x86/kernel/cpu/aperfmperf.c:475-487).  Returns 0","+ * without RDPRU.  Callers hold entropy_mutex. */","+word64 wc_Entropy_TimeAmdAperf(void)","+{","+    static int present = -1;","+    static word64 total = 0;","+    static word64 last = 0;","+    static unsigned int lastCpu = 0xffffffffU;","+    unsigned int lo, hi, cpu, cpuAfter;","+    word64 aperf;","+","+    if (present < 0) {","+        present = Entropy_AmdRdpruPresent();","+        if (!present)","+            WOLFSSL_MSG(\"No AMD RDPRU: the APERF entropy timer reads 0\");","+    }","+    if (!present)","+        return 0;","+","+    cpu = Entropy_Cpu();","+    /* RDPRU, encoded as bytes for assemblers that do not know it. */","+    __asm__ __volatile__ (\".byte 0x0f,0x01,0xfd\"","+                          : \"=a\"(lo), \"=d\"(hi) : \"c\"(1));","+    cpuAfter = Entropy_Cpu();","+    aperf = ((word64)hi << 32) | lo;","+","+    if ((cpu == cpuAfter) && (cpu == lastCpu))","+        total += aperf - last;","+    else if (total == 0)","+        total = aperf;","+    last = aperf;","+    lastCpu = (cpu == cpuAfter) ? cpu : 0xffffffffU;","+    return total;","+}","+","+#endif /* HAVE_ENTROPY_MEMUSE && WC_ENTROPY_TIMER_AMD_APERF */"],"additions":95,"deletions":0,"truncated":false},{"path":"wolfssl/wolfcrypt/entropy-timers.h","lines":["@@ -0,0 +1,61 @@","+/* entropy-timers.h","+ *","+ * Copyright (C) 2006-2026 wolfSSL Inc.","+ *","+ * This file is part of wolfSSL.","+ *","+ * wolfSSL is free software; you can redistribute it and/or modify","+ * it under the terms of the GNU General Public License as published by","+ * the Free Software Foundation; either version 3 of the License, or","+ * (at your option) any later version.","+ *","+ * wolfSSL is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the","+ * GNU General Public License for more details.","+ *","+ * You should have received a copy of the GNU General Public License","+ * along with this program; if not, write to the Free Software","+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1335, USA","+ */","+","+/*!","+    \\file wolfssl/wolfcrypt/entropy-timers.h","+*/","+","+/* Build-time timers for wolfEntropy; each one sets CUSTOM_ENTROPY_TIMEHIRES,","+ * which wolfentropy.c uses before its own timers. */","+","+#ifndef WOLF_CRYPT_ENTROPY_TIMERS_H","+#define WOLF_CRYPT_ENTROPY_TIMERS_H","+","+#include <wolfssl/wolfcrypt/types.h>","+","+#ifdef __cplusplus","+    extern \"C\" {","+#endif","+","+/* AMD core clock (APERF) via RDPRU; reads 0 without RDPRU, so the health","+ * tests fail closed.  --enable-wolfEntropy=amd-aperf */","+#ifdef WC_ENTROPY_TIMER_AMD_APERF","+    #if !defined(__x86_64__) || !(defined(__GNUC__) || defined(__clang__))","+        #error WC_ENTROPY_TIMER_AMD_APERF needs x86_64 and GCC or clang","+    #endif","+    #if defined(WOLFSSL_LINUXKM) || defined(WOLFSSL_BSDKM)","+        #error WC_ENTROPY_TIMER_AMD_APERF needs a user-space build","+    #endif","+    #ifdef CUSTOM_ENTROPY_TIMEHIRES","+        #error WC_ENTROPY_TIMER_AMD_APERF and CUSTOM_ENTROPY_TIMEHIRES both set","+    #endif","+    #ifdef ENTROPY_MEMUSE_THREAD","+        #error WC_ENTROPY_TIMER_AMD_APERF and ENTROPY_MEMUSE_THREAD both set","+    #endif","+    WOLFSSL_LOCAL word64 wc_Entropy_TimeAmdAperf(void);","+    #define CUSTOM_ENTROPY_TIMEHIRES wc_Entropy_TimeAmdAperf","+#endif","+","+#ifdef __cplusplus","+    } /* extern \"C\" */","+#endif","+","+#endif /* WOLF_CRYPT_ENTROPY_TIMERS_H */"],"additions":61,"deletions":0,"truncated":false},{"path":"wolfssl/wolfcrypt/include.am","lines":["@@ -52,6 +52,7 @@ nobase_include_HEADERS+= \\","                          wolfssl/wolfcrypt/chacha20_poly1305.h \\","                          wolfssl/wolfcrypt/random.h \\","                          wolfssl/wolfcrypt/wolfentropy.h \\","+                         wolfssl/wolfcrypt/entropy-timers.h \\","                          wolfssl/wolfcrypt/rng_bank.h \\","                          wolfssl/wolfcrypt/ripemd.h \\","                          wolfssl/wolfcrypt/rsa.h \\"],"additions":1,"deletions":0,"truncated":false},{"path":"wolfssl/wolfcrypt/wolfentropy.h","lines":["@@ -30,6 +30,8 @@"," "," #ifdef HAVE_ENTROPY_MEMUSE"," ","+#include <wolfssl/wolfcrypt/entropy-timers.h>","+"," #if defined(ENTROPY_SCALE_FACTOR) && FIPS_VERSION3_GE(5,2,4) && \\","     FIPS_VERSION3_NE(6,0,0)","     #error \"ENTROPY_SCALE_FACTOR defined elsewhere than wolfEntropy.h\"",""],"additions":2,"deletions":0,"truncated":false}],"additions":171,"deletions":1,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-22T13:47:20.768064+00:00"}