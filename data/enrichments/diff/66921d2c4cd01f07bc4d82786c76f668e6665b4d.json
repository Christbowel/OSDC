not accessed via reflection in NativeAOT builds since reflection-based test discovery is disabled.\")]"," \t\t\treadonly List<IssueModel> _issues;"," ","@@ -199,7 +196,7 @@ public TestCaseScreen()"," \t\t\t\t\t\t IsInternetRequired = attribute.IsInternetRequired,"," \t\t\t\t\t\t Action = ActivatePageAndNavigate(attribute, type),"," \t\t\t\t\t\t // PageFactory is used to retrieve the instance of the page.","-\t\t\t\t\t\t PageFactory = () => ActivatePage(type)","+\t\t\t\t\t\t PageFactory = () => attribute.IsInternetRequired ? CheckInternetAndGetPage(type) : ActivatePage(type)"," \t\t\t\t\t }).ToList();"," #endif"," ","@@ -361,7 +358,7 @@ from issueModel in _issues"," \t\t\t\tItemsSource = issues;"," \t\t\t}"," ","-\t\t\t[UnconditionalSuppressMessage(\"TrimAnalysis\", \"IL2112\", ","+\t\t\t[UnconditionalSuppressMessage(\"TrimAnalysis\", \"IL2112\","," \t\t\t\tJustification = \"TestCaseScreen fields are not accessed via reflection in NativeAOT builds since reflection-based test discovery is disabled.\")]"," \t\t\tHashSet<string> _exemptNames = new HashSet<string> { };"," "],"additions":19,"deletions":22,"truncated":false},{"path":"src/Controls/tests/TestCases.Shared.Tests/Tests/CoreGalleryBasePageTest.cs","lines":["@@ -16,9 +16,6 @@ protected override void FixtureSetup()"," \t\t\t\ttry"," \t\t\t\t{"," \t\t\t\t\tbase.FixtureSetup();","-#if MACCATALYST\t\t\t\t\t","-\t\t\t\t\tNavigateToGallery();","-#endif\t\t\t\t\t"," \t\t\t\t\tbreak;"," \t\t\t\t}"," \t\t\t\tcatch (Exception e)"],"additions":0,"deletions":3,"truncated":false},{"path":"src/Controls/tests/TestCases.Shared.Tests/Tests/Issues/Issue32463.cs","lines":["@@ -0,0 +1,62 @@","+#if ANDROID || IOSUITEST","+using NUnit.Framework;","+using UITest.Appium;","+using UITest.Core;","+","+namespace Microsoft.Maui.TestCases.Tests;","+","+// Use UITest rather than _IssuesUITest so setup cannot navigate to the test page.","+public class Issue32463 : UITest","+{","+\tpublic Issue32463(TestDevice device) : base(device)","+\t{","+\t}","+","+\t[TestCase(\"Direct test launch\", \"DirectLaunchLabel\")]","+\t[TestCase(\"DIRECT test launch\", \"DirectLaunchLabel\")]","+\t[TestCase(\"Button Feature Matrix\", \"ButtonControl\")]","+\t[Category(UITestCategories.LifeCycle)]","+\tpublic void LaunchDirectlyToTest(string test, string expectedElement)","+\t{","+\t\tLaunchWithTest(test);","+\t\tApp.WaitForElement(expectedElement);","+\t\tAssert.That(App.FindElements(\"GoToTestButton\"), Is.Empty);","+\t}","+","+\t[TestCase(null)]","+\t[TestCase(\"\")]","+\t[TestCase(\"Unknown startup test\")]","+\t[Category(UITestCategories.LifeCycle)]","+\tpublic void LaunchWithoutMatchingTestShowsGallery(string? test)","+\t{","+\t\tLaunchWithTest(test);","+\t\tApp.WaitForElement(\"GoToTestButton\");","+\t}","+","+\tvoid LaunchWithTest(string? test)","+\t{","+#if IOSUITEST","+\t\tApp.CloseApp();","+\t\tvar environment = new Dictionary<string, string> { [\"test\"] = test ?? \"\" };","+\t\t((AppiumApp)App).Driver.ExecuteScript(\"mobile: launchApp\", new Dictionary<string, object>","+\t\t{","+\t\t\t{ \"bundleId\", \"com.microsoft.maui.uitests\" },","+\t\t\t{ \"environment\", environment }","+\t\t});","+#else","+\t\tvar arguments = new Dictionary<string, object>","+\t\t{","+\t\t\t{ \"component\", \"com.microsoft.maui.uitests/com.microsoft.maui.uitests.MainActivity\" },","+\t\t\t{ \"stop\", true }","+\t\t};","+","+\t\tif (test is not null)","+\t\t{","+\t\t\targuments[\"extras\"] = new[] { new[] { \"s\", \"test\", AppLaunchArguments.QuoteAndroidShellArgument(test) } };","+\t\t}","+","+\t\t((AppiumApp)App).Driver.ExecuteScript(\"mobile: startActivity\", arguments);","+#endif","+\t}","+}","+#endif"],"additions":62,"deletions":0,"truncated":false},{"path":"src/Controls/tests/TestCases.Shared.Tests/Tests/Issues/Issue32463Runner.cs","lines":["@@ -0,0 +1,92 @@","+using NUnit.Framework;","+using UITest.Appium;","+using UITest.Core;","+","+namespace Microsoft.Maui.TestCases.Tests;","+","+public class Issue32463Runner : _IssuesUITest","