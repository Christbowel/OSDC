{"id":"66921d2c4cd01f07bc4d82786c76f668e6665b4d","axis":"silent","repo":"dotnet/maui","sha":"66921d2c4cd01f07bc4d82786c76f668e6665b4d","parsed":{"files":[{"path":"Microsoft.Maui.sln","lines":["@@ -256,12 +256,18 @@ Project(\"{9A19103F-16F7-4668-BE54-9A1E7A4F7556}\") = \"Maui.Controls.Sample.Embedd"," EndProject"," Project(\"{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}\") = \"Controls.ManualTests\", \"src\\Controls\\tests\\ManualTests\\Controls.ManualTests.csproj\", \"{E2BFD1F1-07A8-8DBE-3661-894D0FE37D9C}\""," EndProject","+Project(\"{9A19103F-16F7-4668-BE54-9A1E7A4F7556}\") = \"UITest.Appium.Tests\", \"src\\TestUtils\\tests\\UITest.Appium.Tests\\UITest.Appium.Tests.csproj\", \"{D4FAD399-8E9F-459C-A432-2E9D7BB91117}\"","+EndProject"," Global"," \tGlobalSection(SolutionConfigurationPlatforms) = preSolution"," \t\tDebug|Any CPU = Debug|Any CPU"," \t\tRelease|Any CPU = Release|Any CPU"," \tEndGlobalSection"," \tGlobalSection(ProjectConfigurationPlatforms) = postSolution","+\t\t{D4FAD399-8E9F-459C-A432-2E9D7BB91117}.Debug|Any CPU.ActiveCfg = Debug|Any CPU","+\t\t{D4FAD399-8E9F-459C-A432-2E9D7BB91117}.Debug|Any CPU.Build.0 = Debug|Any CPU","+\t\t{D4FAD399-8E9F-459C-A432-2E9D7BB91117}.Release|Any CPU.ActiveCfg = Release|Any CPU","+\t\t{D4FAD399-8E9F-459C-A432-2E9D7BB91117}.Release|Any CPU.Build.0 = Release|Any CPU"," \t\t{95BA42B5-B00E-4986-B9B5-517140378452}.Debug|Any CPU.ActiveCfg = Debug|Any CPU"," \t\t{95BA42B5-B00E-4986-B9B5-517140378452}.Debug|Any CPU.Build.0 = Debug|Any CPU"," \t\t{95BA42B5-B00E-4986-B9B5-517140378452}.Release|Any CPU.ActiveCfg = Release|Any CPU","@@ -666,6 +672,7 @@ Global"," \t\tHideSolutionNode = FALSE"," \tEndGlobalSection"," \tGlobalSection(NestedProjects) = preSolution","+\t\t{D4FAD399-8E9F-459C-A432-2E9D7BB91117} = {6998CAA1-11D4-46B2-B80F-0AC882F58124}"," \t\t{95BA42B5-B00E-4986-B9B5-517140378452} = {E8AD265B-3C67-4640-AC58-A522F9FB3361}"," \t\t{AF64451F-E2BD-41C2-B083-F60C26AE2A9F} = {50C758FE-4E10-409A-94F5-A75480960864}"," \t\t{00A11C2F-969F-4964-8557-91ADF4B1523D} = {446EB407-57EB-441D-9ADB-1A006CBF672A}"],"additions":7,"deletions":0,"truncated":false},{"path":"docs/UITesting-Guide.md","lines":["@@ -43,12 +43,83 @@ dotnet build ./src/Provisioning/Provisioning.csproj -t:ProvisionAppium -p:SkipAp"," - Set `JAVA_HOME` environment variable"," - Install Android API 30 SDK with x86/x64 emulator image"," ","+#### Launch directly to a test page","+","+The Android HostApp accepts a `test` string intent extra containing the exact","+issue description (from `IssueAttribute`) or gallery title, matched","+case-insensitively. For example, after installing the HostApp:","+","+```bash","+adb shell am start -S -n com.microsoft.maui.uitests/com.microsoft.maui.uitests.MainActivity --es test '\"Direct test launch\"'","+```","+","+This creates the requested page as the initial window page without searching or","+tapping through the gallery. Use `-S` to stop the existing app before launching:","+the extra is read when the window is created, not when an already-running activity","+is brought to the foreground. Omit `--es test ...` for normal gallery startup.","+An empty or unrecognized test also opens the gallery; an unrecognized test is","+reported in debug output.","+"," ### iOS/MacCatalyst-Specific"," "," - macOS required"," - Xcode with command-line tools installed"," - iOS Simulator configured"," ","+#### Launch directly on iOS","+","+iOS and MacCatalyst use the `test` environment variable with the same exact issue","+description or gallery title. After installing the iOS HostApp on a simulator:","+","+```bash","+SIMCTL_CHILD_test=\"Direct test launch\" xcrun simctl launch --terminate-running-process <simulator-udid> com.microsoft.maui.uitests","+```","+","+For a manually launched MacCatalyst app, set `test` in the app process's environment.","+On Windows, pass the description or gallery title as one `--test=...` command-line","+argument:","+","+```powershell","+.\\Controls.TestCases.HostApp.exe '--test=Direct test launch'","+```","+","+On all platforms, missing, empty, or unrecognized startup targets open the normal","+gallery. Unknown targets are reported in debug output. A startup target is consumed","+when the initial window is created, so terminate the previous app instance before","+changing it.","+","+### Direct launch in the UI test runner","+","+`_IssuesUITest` and `_GalleryUITest` configure their startup targets automatically","+on Android, iOS, and MacCatalyst.","+Fixture setup no longer searches for and taps the gallery's Go To Test button.","+Resets relaunch the current fixture's target, including fixtures that set","+`ResetAfterEachTest`; gallery subpage buttons are still selected after launch.","+Fixture teardown closes the app rather than launching an unused gallery.","+Tests of normal gallery startup can derive directly from `UITest` instead.","+","+Starting a new test and resetting the app stop with an explicit error if the","+previous app cannot be terminated. OS-command fallback termination succeeds only","+when the command starts, completes within its timeout, and exits with code zero; a failed command","+must not be treated as a successful close.","+","+Android, iOS, and MacCatalyst reuse the driver session and send the current target","+with each app launch. Android forwards the configured device UDID to Appium as","+well, so multiple running emulators do not select the wrong device. Windows uses","+`appArguments`; because WinAppDriver cannot change these capabilities on an","+existing session, changing the startup target recreates that session. Windows","+therefore retains gallery navigation by default until its native timing is","+validated; set `MAUI_UITEST_DIRECT_LAUNCH=true` to opt into direct fixture startup.","+Set it to `false` on any platform to compare the legacy navigation path.","+Do not infer a Windows speedup from eliminating gallery navigation alone.","+","+The startup argument, session reuse, and launch-command unit tests run without","+native UI automation:","+","+```bash","+dotnet test src/TestUtils/tests/UITest.Appium.Tests/UITest.Appium.Tests.csproj","+```","+"," ## Creating a UI Test"," "," ### Step 1: Create the HostApp Page"],"additions":71,"deletions":0,"truncated":false},{"path":"eng/helix.proj","lines":["@@ -36,6 +36,7 @@","     <XUnitProject Include=\"$(RepoRoot)src/Core/tests/UnitTests/Core.UnitTests.csproj\" />","     <XUnitProject Include=\"$(RepoRoot)src/Essentials/test/UnitTests/Essentials.UnitTests.csproj\" />","     <XUnitProject Include=\"$(RepoRoot)src/Graphics/tests/Graphics.Tests/Graphics.Tests.csproj\" />","+    <XUnitProject Include=\"$(RepoRoot)src/TestUtils/tests/UITest.Appium.Tests/UITest.Appium.Tests.csproj\" />","     <XUnitProject Include=\"$(RepoRoot)src/BlazorWebView/tests/MauiBlazorWebView.UnitTests/MauiBlazorWebView.UnitTests.csproj\" />","     <XUnitProject Condition=\"$(HelixTargetQueue.StartsWith('Windows'))\" Include=\"$(RepoRoot)src/BlazorWebView/tests/BlazorWebView.Windows.UnitTests/BlazorWebView.Windows.UnitTests.csproj\">","       <TargetFramework>$(_MauiDotNetTfm)-windows</TargetFramework>"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Controls/tests/TestCases.HostApp/Issues/Issue32463.cs","lines":["@@ -0,0 +1,20 @@","+namespace Maui.Controls.Sample.Issues;","+","+[Issue(IssueTracker.Github, 32463, \"Direct test launch\", PlatformAffected.All)]","+public class Issue32463 : ContentPage","+{","+\tpublic Issue32463()","+\t{","+\t\tvar count = 0;","+\t\tvar label = new Label","+\t\t{","+\t\t\tText = \"Launched directly to the test\",","+\t\t\tAutomationId = \"DirectLaunchLabel\"","+\t\t};","+\t\tvar counter = new Label { Text = \"0\", AutomationId = \"LaunchCounter\" };","+\t\tvar windows = new Label { Text = Application.Current.Windows.Count.ToString(), AutomationId = \"StartupWindowCount\" };","+\t\tvar button = new Button { Text = \"Increment\", AutomationId = \"IncrementCounter\" };","+\t\tbutton.Clicked += (_, _) => counter.Text = (++count).ToString();","+\t\tContent = new VerticalStackLayout { Children = { label, counter, windows, button } };","+\t}","+}"],"additions":20,"deletions":0,"truncated":false},{"path":"src/Controls/tests/TestCases.HostApp/MauiProgram.cs","lines":["@@ -97,10 +97,16 @@ public static Page CreateDefaultMainPage()"," \t\t{"," \t\t\tPage mainPage = null;"," \t\t\tOverrideMainPage(ref mainPage);","-#if MACCATALYST","-\t\t\t// Check for startup test argument from environment variables (passed by test runner)","+#if ANDROID","+\t\t\tvar testName = Microsoft.Maui.ApplicationModel.Platform.CurrentActivity?.Intent?.GetStringExtra(\"test\");","+#elif IOS || MACCATALYST"," \t\t\tvar testName = System.Environment.GetEnvironmentVariable(\"test\");","-","+#elif WINDOWS","+\t\t\tconst string testArgument = \"--test=\";","+\t\t\tvar testName = Environment.GetCommandLineArgs()","+\t\t\t\t.FirstOrDefault(argument => argument.StartsWith(testArgument, StringComparison.Ordinal))?[testArgument.Length..];","+#endif","+#if ANDROID || IOS || MACCATALYST || WINDOWS"," \t\t\tif (!string.IsNullOrEmpty(testName))"," \t\t\t{"," \t\t\t\t// Try to get the test page directly from issues/test cases","@@ -120,6 +126,8 @@ public static Page CreateDefaultMainPage()"," \t\t\t\t\t// Return the gallery page"," \t\t\t\t\treturn galleryPage;"," \t\t\t\t}","+","+\t\t\t\tDebug.WriteLine($\"No test or gallery page found for startup test '{testName}'.\");"," \t\t\t}"," #endif"," \t\t\treturn mainPage ?? new CoreNavigationPage();"],"additions":11,"deletions":3,"truncated":false},{"path":"src/Controls/tests/TestCases.HostApp/TestCases.cs","lines":["@@ -1,6 +1,6 @@"," ﻿using System.Diagnostics.CodeAnalysis;","-using System.Reflection;"," using System.Linq;","+using System.Reflection;"," "," namespace Maui.Controls.Sample"," {","@@ -10,27 +10,27 @@ public class TestCaseScreen : CollectionView"," \t\t{"," \t\t\tpublic static Dictionary<string, Action> PageToAction = new Dictionary<string, Action>(StringComparer.OrdinalIgnoreCase);",