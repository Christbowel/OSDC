eption;","+use Utopia\\Database\\Database;","+use Utopia\\Database\\DateTime;","+use Utopia\\Database\\Document;","+","+/**","+ * Acknowledging a firing alert: one member says they have it, and everyone who","+ * can read the alert sees who and when. It changes nothing else; the monitor","+ * keeps being evaluated and the alert resolves as before, keeping who handled it.","+ */","+readonly class Acknowledgements","+{","+    public function __construct(private Database $dbForPlatform)","+    {","+    }","+","+    /**","+     * Acknowledges the alert as `$user`, or undoes that. Asking for what the alert","+     * already holds changes nothing, so the first member to acknowledge stays on it.","+     * Called with an API key, `$user` is empty and so is who acknowledged. The name","+     * is a snapshot, as the alert keeps its monitor's name from when it fired.","+     *","+     * @return Document the alert as stored","+     * @throws Exception when the alert has resolved","+     */","+    public function set(Document $alert, bool $acknowledged, Document $user): Document","+    {","+        if ($alert->getAttribute('status') !== State::Firing->value) {","+            throw new Exception(Exception::ALERT_RESOLVED);","+        }","+","+        if (($alert->getAttribute('acknowledgedAt') !== null) === $acknowledged) {","+            return $alert;","+        }","+","+        $changes = new Document($acknowledged ? [","+            'acknowledgedAt' => DateTime::now(),","+            'acknowledgedBy' => $user->getId(),","+            'acknowledgedByName' => (string) $user->getAttribute('name', ''),","+        ] : [","+            'acknowledgedAt' => null,","+            'acknowledgedBy' => '',","+            'acknowledgedByName' => '',","+        ]);","+","+        return $this->dbForPlatform->getAuthorization()->skip(fn () => $this->dbForPlatform->updateDocument('monitorAlerts', $alert->getId(), $changes));","+    }","+","+    /**","+     * The event for going from `$before` to `$after`, or null when the acknowledgement did not change.","+     */","+    public static function change(Document $before, Document $after): ?Change","+    {","+        $was = $before->getAttribute('acknowledgedAt') !== null;","+        $is = $after->getAttribute('acknowledgedAt') !== null;","+","+        return match (true) {","+            $was === $is => null,","+            $is => Change::Acknowledged,","+            default => Change::Unacknowledged,","+        };","+    }","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"src/Appwrite/Alert/Change.php","lines":["@@ -0,0 +1,15 @@","+<?php","+","+namespace Appwrite\\Alert;","+","+/**","+ * What happened to an alert, named as its project event:","+ * `monitors.[monitorId].alerts.[alertId].<change>`.","+ */","+enum Change: string","+{","+    case Firing = 'firing';","+    case Resolved = 'resolved';","+    case Acknowledged = 'acknowledged';","+    case Unacknowledged = 'unacknowledged';","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"src/Appwrite/Alert/Events.php","lines":["@@ -0,0 +1,67 @@","+<?php","+","+namespace Appwrite\\Alert;","+","+use Appwrite\\Event\\Event;","+use Appwrite\\Event\\Message\\Func as FunctionMessage;","+use Appwrite\\Event\\Publisher\\Func as FunctionPublisher;","+use Appwrite\\Event\\Realtime;","+use Appwrite\\Event\\Webhook;","+use Appwrite\\Utopia\\Response\\Model\\Alert as AlertModel;","+use Utopia\\Database\\Document;","+","+/**","+ * Fires an alert's project event, `monitors.[monitorId].alerts.[alertId].<change>`,","+ * with the alert as its payload: to the project's webhooks, the functions that","+ * listen to it, and realtime. For callers outside the project's own request,","+ * such as the evaluator or an organization route; a project route fires it","+ * through the request's event instead.","+ */","+readonly class Events","+{","+    public function __construct(","+        private Event $queueForEvents,","+        private Webhook $queueForWebhooks,","+        private FunctionPublisher $publisherForFunctions,","+        private Realtime $queueForRealtime,","+    ) {","+    }","+","+    /**","+     * A monitor outside a project, which has no webhooks or functions, fires none.","+     *","+     * @throws \\RuntimeException when a queue did not accept the event, so the caller can retry","+     */","+    public function trigger(Change $change, Document $alert, Document $project): void","+    {","+        if ($project->isEmpty() || $project->getId() === 'console' || (string) $alert->getAttribute('projectId', '') !== $project->getId()) {","+            return;","+        }","+","+        $this->queueForEvents","+            ->setProject($project)","+            ->setEvent('monitors.[monitorId].alerts.[alertId].' . $change->value)","+            ->setParam('monitorId', (string) $alert->getAttribute('monitorId'))","+            ->setParam('alertId', $alert->getId())","+            ->setPayload((new AlertModel())->payload($alert));","+","+        if ($this->queueForWebhooks->from($this->queueForEvents)->trigger() === false) {","+            throw new \\RuntimeException('The alert event for webhooks was not accepted by the queue.');","+        }","+","+        $function = $this->publisherForFunctions->enqueue(FunctionMessage::fromEvent(","+            event: $this->queueForEvents->getEvent(),","+            params: $this->queueForEvents->getParams(),","+            project: $this->queueForEvents->getProject(),","+            payload: $this->queueForEvents->getPayload(),","+        ));","+        if ($function === false) {","+            throw new \\RuntimeException('The alert event for functions was not accepted by the queue.');","+        }","+","+        $this->queueForRealtime","+            ->setSubscribers(['console', $project->getId()])","+            ->from($this->queueForEvents)","+            ->trigger();","+    }","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"src/Appwrite/Extend/Exception.php","lines":["@@ -357,6 +357,7 @@ class Exception extends \\Exception"," ","     /** Alerts */","     public const string ALERT_NOT_FOUND = 'alert_not_found';","+    public const string ALERT_RESOLVED = 'alert_resolved';"," ","     /** Router */","     public const string ROUTER_HOST_NOT_FOUND = 'router_host_not_found';"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Appwrite/Migration/Version/V25.php","lines":["@@ -582,10 +582,12 @@ private function migrateCollections(): void","                 case 'monitorAlerts':","                     // New in 2.7.0. Platform collections, so only the console project visits them.","                     $this->createCollection($id);","-                    // Created before monitors could be critical.","-                    try {","-                        $this->createAttributeFromCollection($this->dbForProject, $id, 'critical');","-                    } catch (Duplicate) {","+                    // Created before monitors could be critical, or alerts acknowledged.","+                    foreach (['critical', 'acknowledgedAt', 'acknowledgedBy', 'acknowledgedByName'] as $attribute) {","+                        try {","+                            $this->createAttributeFromCollection($this->dbForProject, $id, $attribute);","+                        } catch (Duplicate) {","+                        }","                     }","                     $this->dbForProject->purgeCachedCollection($id);","                     break;"],"additions":6,"deletions":4,"truncated":false},{"path":"src/Appwrite/Platform/Modules/Alerts/Http/Alerts/Update.php","lines":["@@ -0,0 +1,87 @@","+<?php","+","+namespace Appwrite\\Platform\\Modules\\Alerts\\Http\\Alerts;","+","+use Appwrite\\Alert\\Acknowledgements;","+use Appwrite\\Event\\Event;","+use Appwrite\\Platform\\Modules\\Alerts\\Base;","+use Appwrite\\SDK\\AuthType;","+use Appwrite\\SDK\\Method;","+use Appwrite\\SDK\\Response as SDKResponse;","+use Appwrite\\Utopia\\Response;","+use Utopia\\Database\\Database;","+use Utopia\\Database\\Document;","+use Utopia\\Database\\Validator\\Authorization;","+use Utopia\\Database\\Validator\\UID;","+use Utopia\\Platform\\Scope\\HTTP;","+use Utopia\\Validator\\Boolean;","+","+class Update extends Base","+{","+    use HTTP;","+","+    public static function getName(): string","+    {","+        return 'updateAlert';","+    }","+","+    public function __construct()","+    {","+        $this","+            ->setHttpMethod(self::HTTP_REQUEST_METHOD_PATCH)","+            ->setHttpPath('/v1/alerts/:alertId')","+            ->desc('Update alert')","+            ->groups(['api', 'alerts'])","+            ->label('scope', 'alerts.write')","+            ->label('audits.event', 'alert.update')","+            ->label('audits.resource', 'alert/{request.alertId}')","+            ->label('sdk', new Method(","+                namespace: 'alerts',","+                group: null,","+                name: 'update',","+                description: <<<EOT","+                Acknowledge a firing alert, or undo that. Everyone who can read the alert sees who acknowledged it and when. The alert keeps firing until its monitor recovers; a resolved alert keeps its acknowledgement and cannot be changed.","+                EOT,","+                auth: [AuthType::ADMIN, AuthType::KEY],","+                responses: [","+                    new SDKResponse(","+                        code: Response::STATUS_CODE_OK,","+                        model: Response::MODEL_ALERT,","+                    ),","+                ]","+            ))","+            ->param('alertId', '', fn (Database $dbForPlatform) => new UID($dbForPlatform->getMaxUidLength()), 'Alert ID.', false, ['dbForPlatform'])","+            ->param('acknowledged', false, new Boolean(), 'Whether the alert is acknowledged. False undoes an acknowledgement.')","+            ->inject('response')","+            ->inject('project')","+            ->inject('user')","+            ->inject('dbForPlatform')","+            ->inject('authorization')","+            ->inject('queueForEvents')","+            ->callback($this->action(...));","+    }","+","+    public function action(","+        string $alertId,","+        bool $acknowledged,","+        Response $response,","+        Document $project,","+        Document $user,","+        Database $dbForPlatform,","+        Authorization $authorization,","+        Event $queueForEvents,","+    ): void {","+        $alert = $this->getAlert($dbForPlatform, $authorization, $project, $alertId);","+        $updated = (new Acknowledgements($dbForPlatform))->set($alert, $acknowledged, $user);","+","+        $change = Acknowledgements::change($alert, $updated);","+        if ($change !== null) {","+            $queueForEvents","+                ->setEvent('monitors.[monitorId].alerts.[alertId].' . $change->value)","+                ->setParam('monitorId', (string) $updated->getAttribute('monitorId'))","+                ->setParam('alertId', $updated->getId());","+        }","+","+        $response->dynamic($updated, Response::MODEL_ALERT);","+    }","+}"],"additions":87,"deletions":0,"truncated":false},{"path":"src/Appwrite/Platform/Modules/Alerts/Services/Http.php","lines":["@@ -3,6 +3,7 @@"," namespace Appwrite\\Platform\\Modules\\Alerts\\Services;"," "," use Appwrite\\Platform\\Modules\\Alerts\\Http\\Alerts\\Get as GetAlert;","+use Appwrite\\Platform\\Modules\\Alerts\\Http\\Alerts\\Update as UpdateAlert;"," use Appwrite\\Platform\\Modules\\Alerts\\Http\\Alerts\\XList as ListAlerts;"," use Appwrite\\Platform\\Modules\\Alerts\\Http\\Init;"," use Appwrite\\Platform\\Modules\\Alerts\\Http\\Monitors\\Delete as DeleteMonitor;","@@ -28,5 +29,6 @@ public function __construct()"," ","         $this->addAction('listAlerts', ListAlerts::class);","         $this->addAction('getAlert', GetAlert::class);","+        $this->addAction('updateAlert', UpdateAlert::class);","     }"," }"],"additions":2,"deletions":0,"truncated":fal