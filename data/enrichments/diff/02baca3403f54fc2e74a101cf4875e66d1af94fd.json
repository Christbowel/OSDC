ccessPattern#CONSTANT}, or {@link AccessPattern#DYNAMIC} if the","+     * value is mutable or context-dependent): access pattern is not derived","+     * from the value (see [databind#6437]).","+     */","     @Override","     public AccessPattern getNullAccessPattern() {","         return AccessPattern.ALWAYS_NULL;","     }"," ","-    // While some scalar types have non-null empty values (hence can't say \"ALWAYS_NULL\")","-    // they are mostly immutable, shareable and so constant.","+    /**","+     * While some scalar types have non-null empty values (hence can't say \"ALWAYS_NULL\")","+     * they are mostly immutable, shareable and so constant.","+     *<p>","+     * NOTE: sub-classes whose {@link #getEmptyValue} returns a mutable value","+     * (like {@link java.util.concurrent.atomic.AtomicInteger}), or one that depends","+     * on the context, MUST override this method to return","+     * {@link AccessPattern#DYNAMIC}: otherwise a single instance may be cached","+     * and shared (see [databind#6437]).","+     */","     @Override // since 2.9","     public AccessPattern getEmptyAccessPattern() {","         return AccessPattern.CONSTANT;"],"additions":19,"deletions":3,"truncated":false},{"path":"src/main/java/tools/jackson/databind/ext/jdk8/BaseScalarOptionalDeserializer.java","lines":["@@ -2,6 +2,7 @@"," "," import tools.jackson.databind.DeserializationContext;"," import tools.jackson.databind.deser.std.StdScalarDeserializer;","+import tools.jackson.databind.util.AccessPattern;"," "," public abstract class BaseScalarOptionalDeserializer<T>","     extends StdScalarDeserializer<T>","@@ -17,4 +18,18 @@ protected BaseScalarOptionalDeserializer(Class<T> cls, T empty) {","     public T getNullValue(DeserializationContext ctxt) {","         return _empty;","     }","+","+    /**","+     * Empty {@code OptionalInt}/{@code OptionalLong}/{@code OptionalDouble} are","+     * non-null constants, so {@link AccessPattern#CONSTANT} (not {@code ALWAYS_NULL};","+     * see [databind#6437]).","+     *<p>","+     * NOTE: sub-classes that override {@link #getNullValue} must also override","+     * this method if the value is not constant: see","+     * {@link StdScalarDeserializer#getNullAccessPattern()}.","+     */","+    @Override","+    public AccessPattern getNullAccessPattern() {","+        return AccessPattern.CONSTANT;","+    }"," }"],"additions":15,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/databind/deser/filter/NullConversionsMutableScalarsTest.java","lines":["@@ -0,0 +1,78 @@","+package tools.jackson.databind.deser.filter;","+","+import java.util.*;","+","+import org.junit.jupiter.api.Test;","+","+import com.fasterxml.jackson.annotation.JsonSetter;","+import com.fasterxml.jackson.annotation.Nulls;","+","+import tools.jackson.databind.*;","+","+import static org.junit.jupiter.api.Assertions.*;","+","+import static tools.jackson.databind.testutil.DatabindTestUtil.*;","+","+// [databind#6437]: \"empty\" values of mutable scalar types must not be","+// shared across reads when using `Nulls.AS_EMPTY`","+public class NullConversionsMutableScalarsTest","+{","+    static class MutableScalarsAsEmpty {","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public Date date;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public Calendar calendar;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public java.sql.Date sqlDate;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public java.sql.Timestamp timestamp;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public StringBuilder builder;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public StringBuffer buffer;","+    }","+","+    static class DateContentAsEmpty {","+        @JsonSetter(contentNulls = Nulls.AS_EMPTY)","+        public List<Date> values;","+    }","+","+    private final ObjectMapper MAPPER = newJsonMapper();","+","+    @Test","+    public void mutableScalarsAsEmptyNotShared() throws Exception","+    {","+        final String json = \"\"\"","+                {\"date\":null,\"calendar\":null,\"sqlDate\":null,\"timestamp\":null,","+                 \"builder\":null,\"buffer\":null}","+                \"\"\";","+        ObjectReader r = MAPPER.readerFor(MutableScalarsAsEmpty.class);","+        MutableScalarsAsEmpty first = r.readValue(json);","+        MutableScalarsAsEmpty second = r.readValue(json);","+","+        assertEquals(0L, first.date.getTime());","+        assertEquals(0L, first.calendar.getTimeInMillis());","+        assertEquals(0L, first.sqlDate.getTime());","+        assertEquals(0L, first.timestamp.getTime());","+        assertEquals(\"\", first.builder.toString());","+        assertEquals(\"\", first.buffer.toString());","+","+        assertNotSame(first.date, second.date);","+        assertNotSame(first.calendar, second.calendar);","+        assertNotSame(first.sqlDate, second.sqlDate);","+        assertNotSame(first.timestamp, second.timestamp);","+        assertNotSame(first.builder, second.builder);","+        assertNotSame(first.buffer, second.buffer);","+    }","+","+    @Test","+    public void mutableScalarContentAsEmptyNotShared() throws Exception","+    {","+        DateContentAsEmpty result = MAPPER.readValue(\"\"\"","+                {\"values\":[null,null]}","+                \"\"\", DateContentAsEmpty.class);","+        assertEquals(2, result.values.size());","+        assertEquals(0L, result.values.get(0).getTime());","+        assertNotSame(result.values.get(0), result.values.get(1));","+    }","+}"],"additions":78,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/databind/deser/jdk/JDKAtomicTypesDeserTest.java","lines":["@@ -156,6 +156,20 @@ public AtomicRefWithNodeBean(@JsonProperty(\"atomic\") AtomicReference<JsonNode> r","         }","     }"," ","+    static class AtomicScalarsAsEmptyBean {","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public AtomicInteger i;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public AtomicLong l;","+        @JsonSetter(nulls = Nulls.AS_EMPTY)","+        public AtomicBoolean b;","+    }","+","+    static class AtomicContentAsEmptyBean {","+        @JsonSetter(contentNulls = Nulls.AS_EMPTY)","+        public List<AtomicInteger> values;","+    }","+","     /*","     /**********************************************************************","     /* Test methods","@@ -469,4 +483,36 @@ public void testAtomicRefWithNodeViaCreator() throws Exception","                 .readValue(\"{}\");","         assertNull(bean._atomicNode);","     }","+","+    // [databind#6437]: \"empty\" Atomic values are mutable, so must not be shared","+    @Test","+    public void atomicScalarsAsEmptyNotShared() throws Exception","+    {","+        final String json = \"\"\"","+                {\"i\":null,\"l\":null,\"b\":null}","+                \"\"\";","+        ObjectReader r = MAPPER.readerFor(AtomicScalarsAsEmptyBean.class);","+        AtomicScalarsAsEmptyBean first = r.readValue(json);","+        AtomicScalarsAsEmptyBean second = r.readValue(json);","+","+        assertEquals(0, first.i.get());","+        assertEquals(0L, first.l.get());","+        assertFalse(first.b.get());","+","+        assertNotSame(first.i, second.i);","+        assertNotSame(first.l, second.l);","+        assertNotSame(first.b, second.b);","+    }","+","+    // [databind#6437]: same for content nulls","+    @Test","+    public void atomicContentAsEmptyNotShared() throws Exception","+    {","+        AtomicContentAsEmptyBean bean = MAPPER.readValue(\"\"\"","+                {\"values\":[null,null]}","+                \"\"\", AtomicContentAsEmptyBean.class);","+        assertEquals(2, bean.values.size());","+        assertEquals(0, bean.values.get(0).get());","+        assertNotSame(bean.values.get(0), bean.values.get(1));","+    }"," }"],"additions":46,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/databind/ext/jdk8/OptionalNumbersTest.java","lines":["@@ -11,6 +11,7 @@"," import tools.jackson.databind.*;"," import tools.jackson.databind.exc.MismatchedInputException;"," import tools.jackson.databind.testutil.DatabindTestUtil;","+import tools.jackson.databind.util.AccessPattern;"," "," import static org.junit.jupiter.api.Assertions.*;"," ","@@ -53,6 +54,12 @@ static class OptionalDoubleBean {","         }","     }"," ","+    interface OptionalHolder { Object i(); }","+","+    record OptionalIntHolder(String s, OptionalInt i) implements OptionalHolder { }","+    record OptionalLongHolder(String s, OptionalLong i) implements OptionalHolder { }","+    record OptionalDoubleHolder(String s, OptionalDouble i) implements OptionalHolder { }","+","     private final ObjectMapper MAPPER = newJsonMapper();","     private final ObjectMapper MAPPER_WITHOUT_COERCION = MAPPER.rebuild()","             .disable(MapperFeature.ALLOW_COERCION_OF_SCALARS)","@@ -369,4 +376,50 @@ public void testOptionalDoubleInvalid() throws Exception","         }","     }"," ","+    /*","+    /**********************************************************","+    /* Test methods, null access pattern (databind#6437)","+    /**********************************************************","+     */","+","+    // [databind#6437]: empty OptionalInt/Long/Double are non-null constants","+    @Test","+    public void optionalIntNullAccessPattern() throws Exception {","+        _verifyConstantNull(OptionalInt.class, OptionalInt.empty(), OptionalIntHolder.class);","+    }","+","+    @Test","+    public void optionalLongNullAccessPattern() throws Exception {","+        _verifyConstantNull(OptionalLong.class, OptionalLong.empty(), OptionalLongHolder.class);","+    }","+","+    @Test","+    public void optionalDoubleNullAccessPattern() throws Exception {","+        _verifyConstantNull(OptionalDouble.class, OptionalDouble.empty(), OptionalDoubleHolder.class);","+    }","+","+    private void _verifyConstantNull(Class<?> type, Object empty,","+            Class<? extends OptionalHolder> holderType) throws Exception","+    {","+        DeserializationContext ctxt = MAPPER._deserializationContext();","+        ValueDeserializer<Object> deser = ctxt.findRootValueDeserializer(","+                ctxt.constructType(type));","+","+        assertEquals(AccessPattern.CONSTANT, deser.getNullAccessPattern());","+        assertEquals(AccessPattern.CONSTANT, deser.getEmptyAccessPattern());","+        assertEquals(empty, deser.getNullValue(ctxt));","+        assertEquals(empty, deser.getAbsentValue(ctxt));","+        assertEquals(empty, deser.getEmptyValue(ctxt));","+        // CONSTANT providers may be called without context","+        assertEquals(empty, deser.getNullValue(null));","+        assertEquals(empty, deser.getAbsentValue(null));","+","+        assertEquals(empty, MAPPER.readValue(\"null\", type));","+        assertEquals(empty, MAPPER.readValue(\"\"\"","+                {\"s\":\"x\"}","+                \"\"\", holderType).i());","+        assertEquals(empty, MAPPER.readValue(\"\"\"","+                {\"s\":\"x\",\"i\":null}","+                \"\"\", holderType).i());","+    }"," }",""],"additions":53,"deletions":0,"truncated":false}],"additions":266,"deletions":3,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-14T15:14:00.049121+00:00"}