{"id":"dc0ece19c616575175896748ddec48ebb50908ef","axis":"silent","repo":"tensorflow/tensorflow","sha":"dc0ece19c616575175896748ddec48ebb50908ef","parsed":{"files":[{"path":"third_party/xla/xla/backends/cpu/codegen/BUILD","lines":["@@ -741,6 +741,7 @@ xla_cc_test(","         \"//xla/backends/cpu/runtime:function_library\",","         \"//xla/backends/cpu/runtime:kernel_c_api\",","         \"//xla/backends/cpu/runtime:kernel_thunk\",","+        \"//xla/backends/cpu/runtime:rng_state_resource\",","         \"//xla/backends/cpu/runtime:rng_state_thunk\",","         \"//xla/backends/cpu/runtime:thunk\",","         \"//xla/backends/cpu/runtime:while_thunk\","],"additions":1,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/codegen/thunk_sequence_kernel_emitter_test.cc","lines":["@@ -61,6 +61,7 @@ limitations under the License."," #include \"xla/backends/cpu/runtime/function_library.h\""," #include \"xla/backends/cpu/runtime/kernel_c_api.h\""," #include \"xla/backends/cpu/runtime/kernel_thunk.h\"","+#include \"xla/backends/cpu/runtime/rng_state_resource.h\""," #include \"xla/backends/cpu/runtime/rng_state_thunk.h\""," #include \"xla/backends/cpu/runtime/thunk.h\""," #include \"xla/backends/cpu/runtime/while_thunk.h\"","@@ -817,7 +818,8 @@ TEST_F(ThunkSequenceKernelEmitterTest, CanEmitRejectsUnsupportedThunkKind) {","   BufferAllocation::Slice state(&allocation_, 0, 16);","   ASSERT_OK_AND_ASSIGN(","       std::unique_ptr<RngGetAndUpdateStateThunk> rng,","-      RngGetAndUpdateStateThunk::Create({\"rng\"}, state, /*delta=*/1));","+      RngGetAndUpdateStateThunk::Create({\"rng\"}, state, /*delta=*/1,","+                                        std::make_shared<RngStateResource>()));","   std::vector<std::unique_ptr<Thunk>> thunks;","   thunks.push_back(std::move(rng));","   ThunkSequence sequence = Sequence(std::move(thunks));"],"additions":3,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/nanort/nanort_client_test.cc","lines":["@@ -672,6 +672,60 @@ TEST_P(NanoRtClientTest, ProgramShapeKeepsLayout) {","             absl::Span<const int64_t>({0, 1}));"," }"," ","+TEST_P(NanoRtClientTest, SharedRngGetAndUpdateStateAcrossOps) {","+  constexpr absl::string_view kHlo = R\"hlo(","+    HloModule shared_rng_state","+    ENTRY main {","+      first = u64[2]{0} rng-get-and-update-state(), delta=131072","+      second = u64[2]{0} rng-get-and-update-state(), delta=65536","+      ROOT tuple = (u64[2]{0}, u64[2]{0}) tuple(first, second)","+    }","+  )hlo\";","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnUnverifiedModule(kHlo));","+  XlaComputation computation(module->ToProto());","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<NanoRtExecutable> executable,","+                       GetExecutable(computation, GetParam()));","+","+  alignas(32) std::array<uint64_t, 2> out1 = {0, 0};","+  alignas(32) std::array<uint64_t, 2> out2 = {0, 0};","+  Results results = {{out1.data(), 2}, {out2.data(), 2}};","+","+  // The HLO does not order `first` and `second`; the shared RNG resource only","+  // serializes them. Whichever runs first reads the counter, and the other","+  // reads it advanced by the first one's delta. Each execution advances the","+  // counter by both deltas. Independent counters would make both outputs equal.","+  constexpr uint64_t kInit = 0x7012395;","+  constexpr uint64_t kFirstDelta = 131072;","+  constexpr uint64_t kSecondDelta = 65536;","+  std::optional<bool> run0_first_ran_first;","+  for (uint64_t run = 0; run < 2; ++run) {","+    auto event = executable->Execute({}, results, {});","+    tsl::BlockUntilReady(event);","+    ASSERT_TRUE(event.IsConcrete());","+    EXPECT_EQ(out1[1], 0);","+    EXPECT_EQ(out2[1], 0);","+","+    const uint64_t base = kInit + run * (kFirstDelta + kSecondDelta);","+    const bool first_ran_first = out1[0] == base;","+    if (first_ran_first) {","+      EXPECT_EQ(out2[0], base + kFirstDelta) << \"run \" << run;","+    } else {","+      EXPECT_EQ(out2[0], base) << \"run \" << run;","+      EXPECT_EQ(out1[0], base + kSecondDelta) << \"run \" << run;","+    }","+    // The resource edge follows the fixed thunk sequence order, so every run","+    // of one executable uses the same order.","+    if (run0_first_ran_first.has_value()) {","+      EXPECT_EQ(first_ran_first, *run0_first_ran_first);","+    } else {","+      run0_first_ran_first = first_ran_first;","+    }","+  }","+}","+"," INSTANTIATE_TEST_SUITE_P(NanoRtClientTestSuite, NanoRtClientTest,","                          ::testing::Bool(),","                          [](const ::testing::TestParamInfo<bool>& info) {"],"additions":54,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/runtime/BUILD","lines":["@@ -291,6 +291,7 @@ xla_cc_test(","     srcs = [\"thunk_executor_test.cc\"],","     deps = [","         \":buffer_allocations\",","+        \":rng_state_resource\",","         \":thread_pool_task_runner\",","         \":thunk\",","         \":thunk_executor\",","@@ -1071,6 +1072,7 @@ cc_library(","     deps = [","         \"@com_google_absl//absl/base:config\",","         \"@com_google_absl//absl/base:core_headers\",","+        \"@com_google_absl//absl/container:flat_hash_map\",","         \"@com_google_absl//absl/numeric:int128\",","         \"@com_google_absl//absl/synchronization\",","     ],","@@ -1086,29 +1088,63 @@ xla_cc_test(","     ],"," )"," ","+cc_library(","+    name = \"rng_state_resource\",","+    hdrs = [\"rng_state_resource.h\"],","+    deps = [","+        \":rng_state_lib\",","+        \"//xla/runtime:resource_use\",","+    ],","+)","+"," cc_library(","     name = \"rng_state_thunk\",","     srcs = [\"rng_state_thunk.cc\"],","     hdrs = [\"rng_state_thunk.h\"],","     deps = [","-        \":rng_state_lib\",","+        \":rng_state_resource\",","         \":thunk\",","         \"//xla:shape_util\",","+        \"//xla:status_macros\",","         \"//xla:util\",","    