"-  uint64_t high = absl::Int128High64(state_);","+  absl::int128& state = states_","+                            .try_emplace(std::max<int64_t>(device_ordinal, 0),","+                                         kRngStateInitialValue)","+                            .first->second;","+","+  uint64_t low = absl::Int128Low64(state);","+  uint64_t high = absl::Int128High64(state);"," ","   static_assert(ABSL_IS_LITTLE_ENDIAN, \"Big endian not supported\");","   std::memcpy(data, &low, sizeof(low));","   std::memcpy(data + 1, &high, sizeof(high));"," ","-  state_ += delta_;","+  state += delta;"," }"," "," }  // namespace xla::cpu"],"additions":12,"deletions":7,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/runtime/rng_state_lib.h","lines":["@@ -19,24 +19,45 @@ limitations under the License."," #include <cstdint>"," "," #include \"absl/base/thread_annotations.h\"","+#include \"absl/container/flat_hash_map.h\""," #include \"absl/numeric/int128.h\""," #include \"absl/synchronization/mutex.h\""," "," namespace xla::cpu {"," ","+// Executable scoped 128 bit RNG counter. All `rng-get-and-update-state` ops","+// executed for one device advance one shared counter, and each device has its","+// own counter so concurrent replicas stay deterministic. Counters are keyed by","+// the run time device ordinal, which on PjRt CPU is a global device id (not a","+// dense local index), so they are created lazily. Negative ordinals (no device","+// set) share the counter of ordinal 0."," class RngState {","  public:","-  explicit RngState(int64_t delta);","+  RngState() = default;"," ","-  void GetAndUpdateState(uint64_t* data);","+  // Legacy constructors and one argument overload for code generated by an","+  // older tfcompile binary. When `target` is non null, calls forward into","+  // `*target` using `default_delta`.","+  explicit RngState(int64_t default_delta) : default_delta_(default_delta) {}","+  RngState(int64_t default_delta, RngState* target)","+      : default_delta_(default_delta), target_(target) {}"," ","-  int64_t delta() const { return delta_; }","+  void GetAndUpdateState(uint64_t* data, int64_t delta,","+                         int64_t device_ordinal = 0);"," ","- private:","-  int64_t delta_;","+  void GetAndUpdateState(uint64_t* data) {","+    if (target_ != nullptr) {","+      target_->GetAndUpdateState(data, default_delta_);","+      return;","+    }","+    GetAndUpdateState(data, default_delta_);","+  }"," ","+ private:","+  int64_t default_delta_ = 0;","+  RngState* target_ = nullptr;","   absl::Mutex mu_;","-  absl::int128 state_ ABSL_GUARDED_BY(mu_);","+  absl::flat_hash_map<int64_t, absl::int128> states_ ABSL_GUARDED_BY(mu_);"," };"," "," }  // namespace xla::cpu"],"additions":27,"deletions":6,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/runtime/rng_state_lib_test.cc","lines":["@@ -23,23 +23,99 @@ limitations under the License."," namespace xla::cpu {"," namespace {"," ","-TEST(RngStateTest, DeltaConstructorSetsDeltaCorrectly) {","-  const int64_t test_delta = 12345;","-  RngState rng(test_delta);","-  EXPECT_EQ(rng.delta(), test_delta);","+TEST(RngStateTest, SharedStateAdvancesAcrossMultipleDeltas) {","+  RngState rng;","+  absl::int128 first;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&first), /*delta=*/131072);","+","+  absl::int128 second;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&second), /*delta=*/65536);","+  EXPECT_EQ(second, first + 131072);","+","+  absl::int128 third;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&third), /*delta=*/0);","+  EXPECT_EQ(third, second + 65536);"," }"," ","-TEST(RngStateTest, ConfirmStateIsIncreasedByDelta) {","-  const int64_t test_delta = 12345;","-  RngState rng(test_delta);","-  absl::int128 initial_data;","-  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&initial_data));","+TEST(RngStateTest, ShardsStateByDeviceOrdinalAndClampsNegativeOrdinalToZero) {","+  RngState rng;","+  absl::int128 dev0_first;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&dev0_first),","+                        /*delta=*/1024, /*device_ordinal=*/0);","+","+  absl::int128 dev1_first;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&dev1_first),","+                        /*delta=*/2048, /*device_ordinal=*/1);","+  EXPECT_EQ(dev1_first, dev0_first);","+","+  absl::int128 dev_neg_second;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&dev_neg_second),","+                        /*delta=*/512, /*device_ordinal=*/-1);","+  EXPECT_EQ(dev_neg_second, dev0_first + 1024);","+","+  absl::int128 dev1_second;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&dev1_second), /*delta=*/0,","+                        /*device_ordinal=*/1);","+  EXPECT_EQ(dev1_second, dev1_first + 2048);","+}","+","+// PjRt CPU passes global device ids (2048 * process_index + local id) as the","+// device ordinal, so large and sparse ordinals must get independent counters.","+// 1 << 40 aliases ordinal 0 if the ordinal is narrowed to 32 bits.","+TEST(RngStateTest, LargeDeviceOrdinalsGetIndependentCounters) {","+  RngState rng;","+  absl::int128 dev0_first;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&dev0_first),","+                        /*delta=*/1024, /*device_ordinal=*/0);","+","+  for (int64_t ordinal : {int64_t{2048} * 1000 + 3, int64_t{1} << 40}) {","+    absl::int128 first;","+    rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&first), /*delta=*/7,","+                          ordinal);","+    EXPECT_EQ(first, dev0_first) << \"ordinal \" << ordinal;","+","+    absl::int128 second;","+    rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&second), /*delta=*/0,","+                          ordinal);","+    EXPECT_EQ(second, first + 7) << \"ordinal \" << ordinal;","+  }","+","+  absl::int128 dev0_second;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&dev0_second),","+                        /*delta=*/0, /*device_ordinal=*/0);","+  EXPECT_EQ(dev0_second, dev0_first + 1024);","+}","+","+TEST(RngStateTest, LegacySingleArgumentOverloadUsesDefaultDelta) {","+  RngState rng(/*default_delta=*/17);","+  absl::int128 first;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&first));","+","+  absl::int128 second;","+  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&second));","+  EXPECT_EQ(second, first + 17);","+}","+","+TEST(RngStateTest, LegacyForwardingWrappersShareTargetCounter) {","+  RngState shared;","+  RngState thunk0(/*default_delta=*/1, &shared);","+  RngState thunk1(/*default_delta=*/3, &shared);","+  RngState thunk2(/*default_delta=*/1, &shared);","+","+  absl::int128 s0;","+  thunk0.GetAndUpdateState(reinterpret_cast<uint64_t*>(&s0));","+","+  absl::int128 s1;","+  thunk1.GetAndUpdateState(reinterpret_cast<uint64_t*>(&s1));","+  EXPECT_EQ(s1, s0 + 1);"," ","-  absl::int128 expected_data = initial_data + test_delta;","+  absl::int128 s2;","+  thunk2.GetAndUpdateState(reinterpret_cast<uint64_t*>(&s2));","+  EXPECT_EQ(s2, s1 + 3);"," ","-  absl::int128 data;","-  rng.GetAndUpdateState(reinterpret_cast<uint64_t*>(&data));","-  EXPECT_EQ(data, expected_data);","+  absl::int128 s3;","+  thunk0.GetAndUpdateState(reinterpret_cast<uint64_t*>(&s3));","+  EXPECT_EQ(s3, s2 + 1);"," }"," "," }  // namespace"],"additions":89,"deletions":13,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/runtime/rng_state_resource.h","lines":["@@ -0,0 +1,44 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#ifndef XLA_BACKENDS_CPU_RUNTIME_RNG_STATE_RESOURCE_H_","+#define XLA_BACKENDS_CPU_RUNTIME_RNG_STATE_RESOURCE_H_","+","+#include <cstdint>","+","+#include \"xla/backends/cpu/runtime/rng_state_lib.h\"","+#include \"xla/runtime/resource_use.h\"","+","+namespace xla::cpu {","+","+// Resource wrapper around an executable scoped `RngState`, so one shared object","+// is both the `ThunkExecutor` ordering token and the counter storage. This is","+// the only valid way to create a `Resource::kRngState` resource.","+class RngStateResource final : public Resource {","+ public:","+  RngStateResource() : Resource(Kind::kRngState) {}","+","+  void GetAndUpdateState(uint64_t* data, int64_t delta,","+                         int64_t device_ordinal = 0) {","+    state_.GetAndUpdateState(data, delta, device_ordinal);","+  }","+","+ private:","+  RngState state_;","+};","+","+}  // namespace xla::cpu","+","+#endif  // XLA_BACKENDS_CPU_RUNTIME_RNG_STATE_RESOURCE_H_"],"additions":44,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/runtime/rng_state_thunk.cc","lines":["@@ -25,11 +25,12 @@ limitations under the License."," #include \"absl/status/status_macros.h\""," #include \"absl/status/statusor.h\""," #include \"absl/strings/str_format.h\"","+#include \"xla/backends/cpu/runtime/rng_state_resource.h\""," #include \"xla/backends/cpu/runtime/thunk.h\""," #include \"xla/service/buffer_assignment.h\"","+#include \"xla/status_macros.h\""," #include \"xla/stream_executor/device_address.h\""," #include \"xla/tsl/concurrency/async_value_ref.h\"","-#include \"xla/tsl/platform/statusor.h\""," #include \"xla/util.h\""," "," namespace xla::cpu {","@@ -37,16 +38,20 @@ namespace xla::cpu {"," absl::StatusOr<std::unique_ptr<RngGetAndUpdateStateThunk>>"," RngGetAndUpdateStateThunk::Create(Info info,","                                   BufferAllocation::Slice state_buffer