","+      matchLeftOperand = None,","+      matchOperator = None,","+      matchRightOperand = None,","+      requiresSortMergeAsOfJoin = orderExpression.isEmpty,","+      orderExpression = orderExpression","+    )","+  }","+}","+","+/** Shared ASOF key normalization for the fixed-point and single-pass analyzers. */","+private[sql] object AsOfJoinMatchConditionResolution {","+","+  /** Materializes a SQL MATCH_CONDITION once both operands are resolved. */","+  def materialize(","+      join: AsOfJoin,","+      leftSet: AttributeSet,","+      rightSet: AttributeSet,","+      leftOperand: Expression,","+      operator: MatchComparisonOperator,","+      rightOperand: Expression): Option[MaterializedMatchCondition] = {","+    AsOfJoinValidation.validateMatchConditionTableReferences(","+      join = join,","+      leftSet = leftSet,","+      rightSet = rightSet,","+      leftExpr = leftOperand,","+      rightExpr = rightOperand","+    )","+","+    if (leftOperand.resolved && rightOperand.resolved) {","+      AsOfJoinValidation.validateMatchConditionOperands(","+        join = join,","+        leftExpr = leftOperand,","+        rightExpr = rightOperand","+      )","+      val (normalizedLeft, normalizedRight, normalizedOperator) =","+        AsOfJoin.normalizeMatchOperands(","+          leftSet = leftSet,","+          rightSet = rightSet,","+          expr1 = leftOperand,","+          operator = operator,","+          expr2 = rightOperand","+        )","+      val (asOfCondition, leftSort, rightSort) = AsOfJoin.materializeMatchComparison(","+        leftOperand = normalizedLeft,","+        rightOperand = normalizedRight,","+        normalizedOp = normalizedOperator","+      )","+      Some(MaterializedMatchCondition(","+        asOfCondition = asOfCondition,","+        direction = normalizedOperator.direction,","+        leftSortExpressions = leftSort,","+        rightSortExpressions = rightSort","+      ))","+    } else {","+      None","+    }","+  }","+","+  /** Resolves DataFrame keys and selects the execution strategy during analysis. */","+  def materializeDataFrame(","+      join: AsOfJoin,","+      leftSet: AttributeSet,","+      rightSet: AttributeSet,","+      leftOperand: Expression,","+      rightOperand: Expression): Option[MaterializedMatchCondition] = {","+    if (!leftOperand.resolved || !rightOperand.resolved || !join.tolerance.forall(_.resolved)) {","+      return None","+    }","+","+    AsOfJoinValidation.validateTolerance(join)","+","+    val useSortMerge = SQLConf.get.sortMergeAsOfJoinEnabled","+    if (useSortMerge) {","+      AsOfJoinValidation.validateMatchConditionTableReferences(","+        join = join,","+        leftSet = leftSet,","+        rightSet = rightSet,","+        leftExpr = leftOperand,","+        rightExpr = rightOperand,","+        isDataFrame = true","+      )","+      AsOfJoinValidation.validateMatchConditionOperands(","+        join = join,","+        leftExpr = leftOperand,","+        rightExpr = rightOperand,","+        isDataFrame = true","+      )","+    }","+    AsOfJoinValidation.validateNearestStringKeys(","+      join = join,","+      leftKey = leftOperand,","+      rightKey = rightOperand","+    )","+    if (useSortMerge) {","+      AsOfJoinValidation.validateSortMergeToleranceKeys(","+        join = join,","+        leftKey = leftOperand,","+        rightKey = rightOperand","+      )","+    }","+    val asOfCondition = AsOfJoin.makeAsOfCond(","+      leftAsOf = leftOperand,","+      rightAsOf = rightOperand,","+      tolerance = join.tolerance,","+      allowExactMatches = join.allowExactMatches,","+      direction = join.direction,","+      evalContext = join.evalContext","+    )","+","+    if (useSortMerge) {","+      val operator = if (join.direction == Forward) LessThanOrEqualOp else GreaterThanOrEqualOp","+      val (normalizedLeft, normalizedRight, normalizedOperator) = AsOfJoin.normalizeMatchOperands(","+        leftSet = leftSet,","+        rightSet = rightSet,","+        expr1 = leftOperand,","+        operator = operator,","+        expr2 = rightOperand,","+        isDataFrame = true","+      )","+      val (coercedLeft, coercedRight) =","+        AsOfJoin.coerceMatchStringOperands(normalizedLeft, normalizedRight)","+      val (leftSort, rightSort) = if (join.direction == Nearest) {","+        val (leftKey, rightKey) = coerceNearestKeys(coercedLeft, coercedRight)","+        AsOfJoinValidation.validateNearestKeys(","+          join = join,","+          leftKey = leftKey,","+          rightKey = rightKey","+        )","+        (Seq(leftKey), Seq(rightKey))","+      } else {","+        AsOfJoin.matchSortExpressions(coercedLeft, coercedRight)","+      }","+      Some(MaterializedMatchCondition(","+        asOfCondition = asOfCondition,","+        direction = if (join.direction == Nearest) Nearest else normalizedOperator.direction,","+        leftSortExpressions = leftSort,","+        rightSortExpressions = rightSort","+      ))","+    } else {","+      Some(MaterializedMatchCondition(","+        asOfCondition = asOfCondition,","+        direction = join.direction,","+        leftSortExpressions = Nil,","+        rightSortExpressions = Nil,","+        orderExpression = Some(AsOfJoin.makeOrderingExpr(","+          leftAsOf = leftOperand,","+          rightAsOf = rightOperand,","+          direction = join.direction,","+          evalContext = join.evalContext","+        ))","+      ))","+    }","+  }","+","+  private def coerceNearestKeys(","+      leftKey: Expression,","+      rightKey: Expression): (Expression, Expression) = {","+    val leftType = leftKey.dataType","+    val rightType = rightKey.dataType","+    if (leftType.isInstanceOf[DecimalType] && rightType.isInstanceOf[IntegralType]) {","+      (leftKey, Cast(rightKey, DecimalType.forType(rightType)))","+    } else if (leftType.isInstanceOf[IntegralType] && rightType.isInstanceOf[DecimalType]) {","+      (Cast(leftKey, DecimalType.forType(leftType)), rightKey)","+    } else if