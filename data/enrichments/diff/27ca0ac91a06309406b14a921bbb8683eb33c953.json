xpression(expr).foreach { invalidExpr =>","+        join.failAnalysis(","+          errorClass = if (isDataFrame) {","+            \"AS_OF_JOIN.INVALID_KEY_EXPRESSION\"","+          } else {","+            \"ASOF_JOIN_MATCH_CONDITION_INVALID_EXPRESSION\"","+          },","+          messageParameters = Map(\"expr\" -> toSQLExpr(invalidExpr)))","+      }","+    }","+    if (!MatchConditionTypes.areOperandsCompatible(leftExpr.dataType, rightExpr.dataType)) {","+      join.failAnalysis(","+        errorClass = if (isDataFrame) {","+          \"AS_OF_JOIN.UNSUPPORTED_KEY_TYPE\"","+        } else {","+          \"ASOF_JOIN_MATCH_CONDITION_INVALID_TYPE\"","+        },","+        messageParameters = Map(","+          \"type1\" -> toSQLType(leftExpr.dataType),","+          \"type2\" -> toSQLType(rightExpr.dataType)))","+    }","+","+    if (leftExpr.references.isEmpty || rightExpr.references.isEmpty) {","+      if (isDataFrame) {","+        throw QueryCompilationErrors.asOfJoinKeyReferenceError(leftExpr, rightExpr)","+      } else {","+        throw QueryCompilationErrors.asOfJoinMatchConditionTableReferenceError(leftExpr, rightExpr)","+      }","+    }","+  }","+","+  /** Validates the type, foldability and sign of a DataFrame ASOF tolerance. */","+  def validateTolerance(join: AsOfJoin): Unit = {","+    join.toleranceAssertion.foreach { assertion =>","+      if (assertion.checkInputDataTypes().isFailure) {","+        TypeCoercionValidation.failOnTypeCheckResult(assertion, Some(join))","+      }","+      if (!assertion.foldable) {","+        join.failAnalysis(","+          errorClass = \"AS_OF_JOIN.TOLERANCE_IS_UNFOLDABLE\",","+          messageParameters = Map.empty","+        )","+      }","+      if (!assertion.eval().asInstanceOf[Boolean]) {","+        join.failAnalysis(","+          errorClass = \"AS_OF_JOIN.TOLERANCE_IS_NON_NEGATIVE\",","+          messageParameters = Map.empty","+        )","+      }","+    }","+  }","+","+  /** Rejects nearest STRING matching for either DataFrame execution strategy. */","+  def validateNearestStringKeys(","+      join: AsOfJoin,","+      leftKey: Expression,","+      rightKey: Expression): Unit = {","+    if (join.direction == Nearest &&","+        leftKey.dataType.isInstanceOf[StringType] &&","+        rightKey.dataType.isInstanceOf[StringType]) {","+      validateNearestKeys(","+        join = join,","+        leftKey = leftKey,","+        rightKey = rightKey","+      )","+    }","+  }","+","+  /** Rejects numeric tolerance bounds that are not monotone in STRING key order. */","+  def validateSortMergeToleranceKeys(","+      join: AsOfJoin,","+      leftKey: Expression,","+      rightKey: Expression): Unit = {","+    if (join.tolerance.nonEmpty &&","+        leftKey.dataType.isInstanceOf[StringType] &&","+        rightKey.dataType.isInstanceOf[StringType]) {","+      join.failAnalysis(","+        errorClass = \"AS_OF_JOIN.UNSUPPORTED_TOLERANCE_KEY_TYPE\",","+        messageParameters = Map(\"dataType\" -> toSQLType(leftKey.dataType))","+      )","+    }","+  }","+","+  /** Validates the runtime types used to compare nearest gaps. */","+  def validateNearestKeys(","+      join: AsOfJoin,","+      leftKey: Expression,","+      rightKey: Expression): Unit = {","+    if (join.direction == Nearest &&","+        !AsOfJoin.supportsNearestKeys(leftKey.dataType, rightKey.dataType)) {","+      join.failAnalysis(","+        errorClass = \"AS_OF_JOIN.UNSUPPORTED_NEAREST_KEY_TYPE\",","+        messageParameters = Map(\"dataType\" -> toSQLType(leftKey.dataType))","+      )","+    }","+  }","+","+  private def findInvalidMatchConditionExpression(expr: Expression): Option[Expression] = {","+    expr.collectFirst {","+      case e: SubqueryExpression => e","+      case e: AggregateExpression => e","+      case e: WindowExpression => e","+      case e if e.containsPattern(GENERATOR) => e","+      case e if !e.deterministic => e","+    }","+  }","+}"],"additions":175,"deletions":0,"truncated":false},{"path":"