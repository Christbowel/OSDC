te Validator does not ship a class-level validator; you provide your own by extending","+`AbstractPasswordPolicyValidator<T>`. This base class resolves the policy definition, builds","+the rules, and runs the validation. You only need to implement two methods:","+","+* `getPassword(T)` -- extracts the password from the bean","+* `bindProperties(T, BiConsumer<String, Object>)` -- binds additional properties that rules can read","+via `PasswordContext.get(name, type)`","+","+For example, first, define a rule that reads a property from the context:","+","+[[example-password-policy-no-username-rule]]","+.A rule that rejects passwords containing the username","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=noUsernameRule]","+----","+====","+","+Define a policy that uses this rule alongside standard rules:","+","+[[example-password-policy-class-level-policy]]","+.A policy definition using cross-field rules","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=classLevelPolicy]","+----","+====","+","+Annotate the bean with `@PasswordPolicy` at the class level:","+","+[[example-password-policy-class-level-bean]]","+.A bean with class-level `@PasswordPolicy`","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=classLevelBean]","+----","+====","+","+Implement the validator by extending `AbstractPasswordPolicyValidator`:","+","+[[example-password-policy-class-level-validator]]","+.Class-level validator implementation","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=classLevelValidator]","+----","+====","+","+Since this is a custom validator for an existing constraint, it must be registered with Hibernate","+Validator. This can be done via XML, the `ServiceLoader` mechanism, or the programmatic API.","+See <<section-constraint-definition-contribution>> for details.","+"," ==== Logging of values under validation"," "," In some cases it might be useful to inspect logs produced by Hibernate Validator."],"additions":64,"deletions":2,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/DictionaryRule.java","lines":["@@ -6,6 +6,7 @@"," "," //tag::include[]"," import org.hibernate.validator.constraintvalidation.HibernateConstraintValidatorContext;","+import org.hibernate.validator.spi.password.PasswordContext;"," import org.hibernate.validator.spi.password.PasswordPolicyRule;"," "," public class DictionaryRule implements PasswordPolicyRule {","@@ -22,8 +23,8 @@ public String getMessage() {"," \t}"," "," \t@Override","-\tpublic boolean isValid(char[] password, HibernateConstraintValidatorContext context) {","-\t\treturn !dictionaryService.containsDictionaryWord( new String( password ) );","+\tpublic boolean isValid(PasswordContext passwordContext, HibernateConstraintValidatorContext context) {","+\t\treturn !dictionaryService.containsDictionaryWord( new String( passwordContext.password() ) );"," \t}"," }"," //end::include[]"],"additions":3,"deletions":2,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/PasswordHistoryRule.java","lines":["@@ -6,6 +6,7 @@"," "," //tag::include[]"," import org.hibernate.validator.constraintvalidation.HibernateConstraintValidatorContext;","+import org.hibernate.validator.spi.password.PasswordContext;"," import org.hibernate.validator.spi.password.PasswordPolicyRule;"," "," public class PasswordHistoryRule implements PasswordPolicyRule {","@@ -22,8 +23,8 @@ public String getMessage() {"," \t}"," "," \t@Override","-\tpublic boolean isValid(char[] password, HibernateConstraintValidatorContext context) {","-\t\treturn !historyService.isPrevious