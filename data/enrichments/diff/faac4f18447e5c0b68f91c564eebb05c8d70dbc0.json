11,7 +13,8 @@ TMP=$(mktemp)"," trap \"rm -f $TMP\" 0 1 15"," "," $TMUX -f/dev/null new -d -x7 -y2 \\","-      \"printf 'abcdefabcdefab'; printf '\\e[2;7H'; cat\" || exit 1","+      \"printf 'abcdefabcdefab'; printf '\\e[2;7H\\033]2;ready\\007'; cat\" || exit 1","+wait_for_output ready $TMUX display -p '#{pane_title}' || exit 1"," $TMUX set -g window-size manual || exit 1"," "," $TMUX display -pF '#{cursor_x} #{cursor_y} #{cursor_character}' >>$TMP"],"additions":4,"deletions":1,"truncated":false},{"path":"regress/cursor-test4.sh","lines":["@@ -1,5 +1,7 @@"," #!/bin/sh"," ","+. ./regress-common.inc","+"," PATH=/bin:/usr/bin"," TERM=screen"," ","@@ -10,7 +12,8 @@ $TMUX kill-server 2>/dev/null"," TMP=$(mktemp)"," trap \"rm -f $TMP\" 0 1 15"," ","-$TMUX -f/dev/null new -d -x10 -y3 \"printf 'abcdef\\n'; cat\" || exit 1","+$TMUX -f/dev/null new -d -x10 -y3 \"printf 'abcdef\\n\\033]2;ready\\007'; cat\" || exit 1","+wait_for_output ready $TMUX display -p '#{pane_title}' || exit 1"," $TMUX set -g window-size manual || exit 1"," "," $TMUX display -pF '#{cursor_x} #{cursor_y} #{cursor_character}' >>$TMP"],"additions":4,"deletions":1,"truncated":false},{"path":"regress/destroy-unattached-keep-last.sh","lines":["@@ -0,0 +1,21 @@","+#!/bin/sh","+","+# destroy-unattached must check every session, including the one after a","+# session it destroys.","+","+PATH=/bin:/usr/bin","+TERM=screen","+","+[ -z \"$TEST_TMUX\" ] && TEST_TMUX=$(readlink -f ../tmux)","+TMUX=\"$TEST_TMUX -LtestA$$ -f/dev/null\"","+trap '$TMUX kill-server 2>/dev/null' 0 1 15","+","+$TMUX new -d -s base || exit 1","+$TMUX new -d -s x || exit 1","+$TMUX new -d -s y -t x || exit 1","+$TMUX new -d -s z -t x || exit 1","+$TMUX set -g destroy-unattached keep-last || exit 1","+","+[ \"$($TMUX ls -F '#{session_name}' | tr '\\n' ' ')\" = \"base z \" ] || exit 1","+","+exit 0"],"additions":21,"deletions":0,"truncated":false},{"path":"regress/format-modifiers.sh","lines":["@@ -359,6 +359,9 @@ test_expand \"#{t/f/%Y-%m-%d:@ts}\" \"2001-09-09\""," test_expand \"#{t/f/%H#:%M#:%S:@ts}\" \"01:46:40\""," # An escaped comma in the custom format is unescaped before strftime."," test_expand \"#{t/f/%Y#,end:@ts}\" \"2001,end\"","+# A result too long for the buffer is empty.","+long=$(printf '%0600d' 0)","+test_expand \"[#{t/f/%Y$long:@ts}]\" \"[]\""," "," # T: expands its argument and then runs the result through strftime with the"," # current time.  A value with no strftime specifier is returned unchanged."],"additions":3,"deletions":0,"truncated":false},{"path":"regress/format-nested-loop.sh","lines":["@@ -0,0 +1,55 @@","+#!/bin/sh","+","+# A format loop nested inside a loop over the same sorted list must not","+# change the outer list.","+","+. ./regress-common.inc","+","+PATH=/bin:/usr/bin","+TERM=screen","+","+[ -z \"$TEST_TMUX\" ] && TEST_TMUX=$(readlink -f ../tmux)","+TMUX=\"$TEST_TMUX -Ltest$$ -f/dev/null\"","+stop_server $TMUX || exit 1","+trap 'stop_server $TMUX' 0","+trap 'exit 1' 1 2 15","+","+# Outer window list is small; the inner loop visits a session with more","+# windows, so the shared list is reallocated.","+$TMUX new -d -s a || exit 1","+$TMUX neww -d -t a || exit 1","+$TMUX new -d -s b || exit 1","+i=1","+while [ $i -lt 120 ]; do","+\t$TMUX neww -d -t b || exit 1","+\ti=$((i + 1))","+done","+out=$($TMUX display -t a: -p '#{W:#{S:#{W:x}}}' | wc -c)","+if [ $out -ne 245 ]; then","+\techo \"nested window loop: got $out bytes, expected 245\" >&2","+\texit 1","+fi","+out=$($TMUX lsw -t a: -F '#{S:#{W:x}}' | wc -c)","+if [ $out -ne 246 ]; then","+\techo \"list-windows loop: got $out bytes, expected 246\" >&2","+\texit 1","+fi","+stop_server $TMUX || exit 1","+","+$TMUX new -d -s mike || exit 1","+$TMUX new -d -s alpha || exit 1","+$TMUX new -d -s zeta || exit 1","+out=$($TMUX display -p '#{S:#{session_name}=#{S/r:#{session_name}} }')","+exp='mike=zetaalphamike alpha=zetaalphamike zeta=zetaalphamike '","+if [ \"$out\" != \"$exp\" ]; then","+\techo \"nested session loop: got '$out', expected '$exp'\" >&2","+\texit 1","+fi","+out=$($TMUX ls -F '#{session_name}=#{S/r:#{session_name}}' | tr '\\n' ' ')","+exp='alpha=zetaalphamike mike=zetaalphamike zeta=zetaalphamike '","+if [ \"$out\" != \"$exp\" ]; then","+\techo \"list-sessions loop: got '$out', expected '$exp'\" >&2","+\texit 1","+fi","+","+exit 0"],"additions":55,"deletions":0,"truncated":false},{"path":"regress/screen-redraw-scrollbars.sh","lines":["@@ -137,6 +137,7 @@ $TMUX2 selectw -t:\\$ || exit 1"," $TMUX2 resizew -x40 -y12 || exit 1"," $TMUX2 setw pane-scrollbars-position right || exit 1"," $TMUX2 setw pane-scrollbars-style \"bg=black,fg=white,width=1,pad=0\" || exit 1","+wait_for_text 40 $TMUX2 capturep -p || exit 1"," $TMUX2 copy-mode -H || exit 1"," $TMUX2 send -X history-top || exit 1"," compare scrollbar-copy-mode -e"],"additions":1,"deletions":0,"truncated":false},{"path":"regress/send-keys-K.sh","lines":["@@ -0,0 +1,44 @@","+#!/bin/sh","+","+# A key sent with send-keys -K and not bound must reach the pane as the same","+# bytes as a typed key.","+","+PATH=/bin:/usr/bin","+TERM=screen","+LC_ALL=C.UTF-8","+export PATH TERM LC_ALL","+","+. ./regress-common.inc","+","+[ -z \"$TEST_TMUX\" ] && TEST_TMUX=$(readlink -f ../tmux)","+DIR=$(test_tmpdir) || exit 1","+INNER=\"$TEST_TMUX -LtestI$$ -f/dev/null\"","+OUTER=\"$TEST_TMUX -LtestO$$ -f/dev/null\"","+","+cleanup()","+{","+\tstop_server $OUTER || exit 1","+\tstop_server $INNER || exit 1","+\trm -rf \"$DIR\"","+}","+trap cleanup 0","+trap 'exit 1' 1 2 15","+","+OUT=$DIR/out","+$INNER new-session -d -s inner -x40 -y10 \\","+\t\"stty raw -echo; exec cat >$OUT\" || exit 1","+$INNER set-option -g status off || exit 1","+$OUTER new-session -d -s outer -x40 -y10 \"$INNER attach -t inner\" || exit 1","+wait_for_clients 1 $INNER || exit 1","+client=$($INNER list-clients -F '#{client_name}')","+","+for key in C-F3 BTab F3 C-Up a Enter; do","+\t$INNER send-keys -K -c \"$client\" $key || exit 1","+done","+printf '\\033[1;5R\\033[Z\\033OR\\033[1;5Aa\\r' >$DIR/expected","+wait_until cmp -s $OUT $DIR/expected || {","+\tod -c $OUT >&2","+\texit 1","+}","+","+exit 0"],"additions":44,"deletions":0,"truncated":false},{"path":"regress/source-file-stdin-nested.sh","lines":["@@ -0,0 +1,36 @@","+#!/bin/sh","+","+. ./regress-common.inc","+","+# a nested source-file - fails because stdin can only be read once, rather","+# than hanging the client","+","+PATH=/bin:/usr/bin","+TERM=screen","+","+[ -z \"$TEST_TMUX\" ] && TEST_TMUX=$(readlink -f ../tmux)","+","+TMPDIR=$(test_tmpdir) || exit 1","+TMUX=\"$TEST_TMUX -S$TMPDIR/tmux.sock\"","+","+cleanup()","+{","+\t[ -n \"$pid\" ] && kill -9 $pid 2>/dev/null","+\tstop_server $TMUX || exit 1","+\trm -rf \"$TMPDIR\"","+}","+trap cleanup 0 1 15","+","+$TMUX -f/dev/null new-session -d || exit 1","+","+printf 'display -p x\\nsource -\\n' >$TMPDIR/in","+$TMUX source - <$TMPDIR/in >$TMPDIR/out 2>&1 &","+pid=$!","+wait_for_exit $pid || exit 1","+pid=","+","+[ \"$(sed -n 1p $TMPDIR/out)\" = \"x\" ] || exit 1","+grep -q 'Bad file descriptor: -' $TMPDIR/out || exit 1","+[ $(wc -l <$TMPDIR/out) -eq 2 ] || exit 1","+","+exit 0",""],"additions":36,"deletions":0,"truncated":false}],"additions":219,"deletions":5,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-21T16:33:16.974472+00:00"}