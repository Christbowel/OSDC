string) error {","+\tcleanBase := filepath.Clean(base)","+\tcleanPath := filepath.Clean(path)","+\t// A path is within the base if it equals the base or starts with base + separator.","+\tif cleanPath != cleanBase && !strings.HasPrefix(cleanPath, cleanBase+string(os.PathSeparator)) {","+\t\treturn ErrPathEscapesBase","+\t}","+\treturn nil","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"server/utils/filepath_test.go","lines":["@@ -0,0 +1,84 @@","+// Copyright 2025 The Atlantis Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package utils_test","+","+import (","+\t\"errors\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/runatlantis/atlantis/server/utils\"","+\t. \"github.com/runatlantis/atlantis/testing\"","+)","+","+func TestEnsureSubPath(t *testing.T) {","+\tcases := []struct {","+\t\tbase      string","+\t\tpath      string","+\t\texpectErr bool","+\t\tdesc      string","+\t}{","+\t\t{","+\t\t\tdesc:      \"path equals base\",","+\t\t\tbase:      \"/data/repos\",","+\t\t\tpath:      \"/data/repos\",","+\t\t\texpectErr: false,","+\t\t},","+\t\t{","+\t\t\tdesc:      \"path within base\",","+\t\t\tbase:      \"/data/repos\",","+\t\t\tpath:      \"/data/repos/owner/repo/1/default\",","+\t\t\texpectErr: false,","+\t\t},","+\t\t{","+\t\t\tdesc:      \"path traversal with .. staying within base\",","+\t\t\tbase:      \"/data/repos\",","+\t\t\tpath:      \"/data/repos/owner/repo/../../etc/passwd\",","+\t\t\texpectErr: false, // resolves to /data/repos/etc/passwd which is within base","+\t\t},","+\t\t{","+\t\t\tdesc:      \"path traversal escaping base with ..\",","+\t\t\tbase:      \"/data/repos\",","+\t\t\tpath:      \"/data/repos/owner/../../../../etc/passwd\",","+\t\t\texpectErr: true, // resolves to /etc/passwd which escapes base","+\t\t},","+\t\t{","+\t\t\tdesc:      \"path traversal escaping base\",","+\t\t\tbase:      \"/data/repos\",","+\t\t\tpath:      \"/etc/passwd\",","+\t\t\texpectErr: true,","+\t\t},","+\t\t{","+\t\t\tdesc:      \"path with trailing separator in base\",","+\t\t\tbase:      \"/data/repos/\",","+\t\t\tpath:      \"/data/repos/owner/repo\",","+\t\t\texpectErr: false,","+\t\t},","+\t\t{","+\t\t\tdesc:      \"base prefix but not subpath\",","+\t\t\tbase:      \"/data/repos\",","+\t\t\tpath:      \"/data/repos-evil/something\",","+\t\t\texpectErr: true,","+\t\t},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.desc, func(t *testing.T) {","+\t\t\terr := utils.EnsureSubPath(tc.base, tc.path)","+\t\t\tif tc.expectErr {","+\t\t\t\tAssert(t, err != nil, \"expected error but got nil\")","+\t\t\t\tAssert(t, errors.Is(err, utils.ErrPathEscapesBase), \"expected ErrPathEscapesBase but got %v\", err)","+\t\t\t\tcleanBase := filepath.Clean(tc.base)","+\t\t\t\tcleanPath := filepath.Clean(tc.path)","+\t\t\t\tAssert(t, !strings.Contains(err.Error(), tc.base), \"error should not expose base path: %q\", err.Error())","+\t\t\t\tAssert(t, !strings.Contains(err.Error(), cleanBase), \"error should not expose clean base path: %q\", err.Error())","+\t\t\t\tAssert(t, !strings.Contains(err.Error(), tc.path), \"error should not expose candidate path: %q\", err.Error())","+\t\t\t\tAssert(t, !strings.Contains(err.Error(), cleanPath), \"error should not expose clean candidate path: %q\", err.Error())","+\t\t\t} else {","+\t\t\t\tOk(t, err)","+\t\t\t}","+\t\t})","+\t}","+}",""],"additions":84,"deletions":0,"truncated":false}],"additions":480,"deletions":11,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-08-22T08:18:23.792538+00:00"}