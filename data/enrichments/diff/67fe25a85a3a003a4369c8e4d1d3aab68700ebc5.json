:TempDir;","+    use tikv_util::config::ReadableSize;","+","     use super::*;","+    use crate::{","+        coprocessor::{","+            BoxSplitCheckObserver, Coprocessor, ObserverContext, SplitCheckObserver,","+            dispatcher::SchedTask,","+        },","+        store::{SplitValidator, peer::SplitCheckTrigger},","+    };","+","+    #[derive(Clone)]","+    struct AssertSplitCheckEnabled(SplitValidator);","+","+    impl Coprocessor for AssertSplitCheckEnabled {}","+","+    impl SplitCheckObserver<KvTestEngine> for AssertSplitCheckEnabled {","+        fn add_checker(","+            &self,","+            ctx: &mut ObserverContext<'_>,","+            host: &mut SplitCheckerHost<'_, KvTestEngine>,","+            _: &KvTestEngine,","+            _: CheckPolicy,","+        ) {","+            assert!(","+                host.split_reason() == SplitReason::Admin","+                    || !self.0.is_disabled(ctx.region().get_id())","+            );","+        }","+    }","+","+    fn put_split_check_data(engine: &KvTestEngine, start: usize, end: usize) {","+        for i in start..end {","+            let key = keys::data_key(format!(\"{i:04}\").as_bytes());","+            engine.put_cf(CF_WRITE, &key, &key).unwrap();","+            if i % 10 == 9 {","+                engine.flush_cf(CF_WRITE, true).unwrap();","+            }","+        }","+    }","+","+    fn check_disabled_result(","+        rx: &mpsc::Receiver<SchedTask>,","+        trigger: &mut SplitCheckTrigger,","+        splitable: [bool; 2],","+        buckets_enabled: bool,","+    ) -> (u64, u64) {","+        let (mut size, mut keys, mut buckets) = (None, None, false);","+        // Model a scheduled tick and its responses. Oversized Regions must keep","+        // checking even without writes, so enabling or expiry can resume splits.","+        trigger.post_triggered();","+        let was_skippable = trigger.should_skip(u64::MAX);","+        for task in rx.try_iter() {","+            match task {","+  