ys: Some(1_000_000),","+                region_split_keys: Some(500_000),","+                batch_split_limit: 64,","+                enable_region_bucket: Some(false),","+                ..Default::default()","+            };","+            let max_size = cfg.region_max_size().0;","+            let (tx, rx) = mpsc::sync_channel(100);","+            let host = CoprocessorHost::new(tx.clone(), cfg);","+            let validator = host.split_validator.clone();","+            let mut runner = Runner::new(engine.clone(), tx, host, None);","+            let mut region = Region::default();","+            region.set_id(1);","+            region.set_start_key(b\"a\".to_vec());","+            region.set_end_key(b\"b\".to_vec());","+            region.mut_peers().push(Default::default());","+            for i in 0..64 {","+                engine","+                    .put_cf(","+                        CF_WRITE,","+                        &keys::data_key(format!(\"a{i:04}\").as_bytes()),","+                        &[1; 4096],","+                    )","+                    .unwrap();","+            }","+            let mut trigger = SplitCheckTrigger::default();","+            let mut check_tick = |trigger: &mut SplitCheckTrigger| {","+                assert!(!trigger.should_skip(u64::MAX));","+                let task = Task::split_check(region.clone(), true, CheckPolicy::Scan, None);","+                trigger.post_triggered();","+                runner.run(task);","+                let results: Vec<_> = rx.try_iter().collect();","+                for task in &results {","+                    match task {","+                        SchedTask::UpdateApproximateSize {","+                            size, splitable, ..","+                        } => trigger.on_approximate_region_size(*size, *splitable),","+                        SchedTask::UpdateApproximateKeys {","+                            keys, splitable, ..","+                        } => trigger.on_approximate_region_keys(*keys, *splitable),","+                        SchedTask::AskSplit { .. } => {}","+                        task => panic!(\"unexpected split check result: {task:?}\"),","+                    }","+                }","+                results","+            };","+","+            // A full scan establishes both retry hints before disabling splits.","+            let results = check_tick(&mut trigger);","+            assert!(","+                results","+                    .iter()","+                    .any(|task| matches!(task, SchedTask::AskSplit { .. }))","+            );","+            assert!(trigger.approximate_size.unwrap() > max_size);","+            assert!(!trigger.should_skip(u64::MAX));","+","+            // The final SST sample is outside the Region, underestimating its","+            // unchanged data. Disabled refreshes must not erase the scan hints.","+            validator.disable(region.get_id());","+            let outside_key = keys::data_key(b\"z\");","+            engine.put_cf(CF_WRITE, &outside_key, b\"v\").unwrap();","+            engine.flush_cf(CF_WRITE, true).unwrap();","+            let estimate = get_region_approximate_size(&engine, &region, 0).unwrap();","+            assert!(estimate < max_size);","+            for _ in 0..2 {","+                let results = check_tick(&mut trigger);","+                assert!(results.iter().any(|task| matches!(","+                    task,","+                    SchedTask::UpdateApproximateSize {","+                        size: Some(size), splitable: None, ..","+                    } if *size == estimate","+                )));","+                assert!(results.iter().any(|task| matches!(","+                    task,","+                    SchedTask::UpdateApproximateKeys {","+                        keys: Some(_),","+                        splitable: None,","+                        ..","+                    }","+                )));","+                assert!(","+                    !resu