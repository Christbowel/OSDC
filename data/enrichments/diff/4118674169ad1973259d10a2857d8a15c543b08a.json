enerated=\"True\" extra-ref=\"IOUringFilter\"/>","+","     <variablelist class=\"dbus-property\" generated=\"True\" extra-ref=\"RuntimeDirectorySymlink\"/>"," ","     <variablelist class=\"dbus-property\" generated=\"True\" extra-ref=\"RuntimeDirectoryPreserve\"/>","@@ -13037,6 +13061,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <para><varname>LUOSession</varname> was added in version 262.</para>","       <para><varname>RestartRandomizedDelayUSec</varname> was added in version 262.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Socket Unit Objects</title>","@@ -13117,6 +13142,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <varname>XAttrListen</varname>, and","       <varname>XAttrAccept</varname> were added in version 262.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Mount Unit Objects</title>","@@ -13189,6 +13215,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <varname>CPUSetPartition</varname>, and","       <varname>OOMRules</varname> were added in version 261.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Swap Unit Objects</title>","@@ -13259,6 +13286,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <varname>CPUSetPartition</varname>, and","       <varname>OOMRules</varname> were added in version 261.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Slice Unit Objects</title>"],"additions":28,"deletions":0,"truncated":false},{"path":"man/systemd-analyze.xml","lines":["@@ -116,6 +116,12 @@","       <arg choice=\"plain\">syscall-filter</arg>","       <arg choice=\"opt\"><replaceable>SET</replaceable>…</arg>","     </cmdsynopsis>","+    <cmdsynopsis>","+      <command>systemd-analyze</command>","+      <arg choice=\"opt\" rep=\"repeat\">OPTIONS</arg>","+      <arg choice=\"plain\">io-uring-filter</arg>","+      <arg choice=\"opt\"><replaceable>NAME</replaceable>…</arg>","+    </cmdsynopsis>","     <cmdsynopsis>","       <command>systemd-analyze</command>","       <arg choice=\"opt\" rep=\"repeat\">OPTIONS</arg>","@@ -600,6 +606,31 @@ Conditions succeeded.</programlisting>","       <replaceable>SET</replaceable> must include the <literal>@</literal> prefix.</para>","     </refsect2>"," ","+    <refsect2>","+      <title><command>systemd-analyze io-uring-filter <optional><replaceable>NAME</replaceable>...</optional></command></title>","+","+      <para>Lists the","+      <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>","+      operations that systemd knows, or only the operations with the specified names. The names are the ones","+      that <varname>IOUringFilter=</varname> takes, see","+      <citerefentry><refentrytitle>systemd.exec</refentrytitle><manvolnum>5</manvolnum></citerefentry>. For","+      each operation, the <literal>SYSCALLS</literal> column lists the system calls whose work the operation","+      can do. <varname>SystemCallFilter=</varname> denies an operation if it denies any of the listed system","+      calls.</para>","+","+      <example>","+        <title>Table output</title>","+        <programlisting>$ systemd-analyze io-uring-filter nop read socket uring_cmd","+NAME      SYSCALLS","+nop       -","+read      read pread64","+socket    socket","+uring_cmd ioctl setsockopt getsockopt getsockname</programlisting>","+      </example>","+","+      <xi:include href=\"version-info.xml\" xpointer=\"v263\"/>","+    </refsect2>","+","     <refsect2>","       <title><command>systemd-analyze filesystems <optional><replaceable>SET</replaceable>...</optional></command></title>"," "],"additions":31,"deletions":0,"truncated":false},{"path":"man/systemd.exec.xml","lines":["@@ -2502,21 +2502,73 @@ BindReadOnlyPaths=/var/lib/systemd</programlisting>","         activation with socket units, see","         <citerefentry><refentrytitle>systemd.socket</refentrytitle><manvolnum>5</manvolnum></citerefentry>)","         are unaffected. Also, sockets created with <function>socketpair()</function> (which creates connected","-        AF_UNIX sockets) or the","-        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>","-        functions, are not affected. Thus, it is recommended to combined this setting with","+        AF_UNIX sockets) are not affected. Thus, it is recommended to combine this setting with","         <varname>SystemCallFilter=@service</varname>, to only allow a limited subset of system calls.</para>"," ","-        <para>Note that this option is limited to some ABIs, in particular x86-64, but currently has no","-        effect on 32-bit x86, s390, s390x, mips, mips-le, ppc, ppc-le, ppc64, or ppc64-le, and is ignored. On","-        systems supporting multiple ABIs (such as x86/x86-64) it is recommended to turn off alternative ABIs","-        for services, so that they cannot be used to circumvent the restrictions of this option.","-        Specifically, it is recommended to combine this option with","-        <varname>SystemCallArchitectures=native</varname> or similar. </para>","+        <para>On kernels that support io_uring BPF filters (Linux 7.0 and newer), this setting also applies","+        to sockets created with the <constant>IORING_OP_SOCKET</constant> operation of","+        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>.","+        Such requests fail with <constant>EACCES</constant> for denied address families. The restriction","+        applies to all io_uring instances that the processes of the unit create, but not to io_uring","+        instances that they receive from other processes. On such kernels,","+        <constant>IORING_REGISTER_RESTRICTIONS</constant> without an io_uring instance fails with","+        <constant>EPERM</constant> for the processes of the unit. On older kernels, sockets created with","+        io_uring are not affected.</para>","+","+        <para>Note that the system call restriction of this option is limited to some ABIs, in particular","+        x86-64, but currently has no effect on 32-bit x86, s390, s390x, mips, mips-le, ppc, ppc-le, ppc64, or","+        ppc64-le, and is ignored. The io_uring restriction applies on all ABIs. On systems supporting","+        multiple ABIs (such as x86/x86-64) it is recommended to turn off alternative ABIs for services, so","+        that they cannot be used to circumvent the restrictions of this option. Specifically, it is","+        recommended to combine this option with <varname>SystemCallArchitectures=native</varname> or similar.","+        </para>"," ","         <xi:include href=\"version-info.xml\" xpointer=\"v211\"/></listitem>","       </varlistentry>"," ","+      <varlistentry>","+        <term><varname>IOUringFilter=</varname></term>","+","+        <listitem><para>Restricts the","+        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>","+        operations that the processes of this unit may submit. Takes a comma- or space-separated list of","+        operation names. The name of an operation is its <constant>IORING_OP_</constant> constant in lower","+        case and without the prefix, for example <literal>read</literal> for","+        <constant>IORING_OP_READ</constant>, or <literal>uring_cmd</literal> for","+        <constant>IORING_OP_URING_CMD</constant>. If the list is prefixed with <literal>~</literal>, the","+        listed operations are denied (deny-listing). Otherwise, only the listed operations are allowed","+        (allow-listing). An allow list also denies the operations of newer kernels that systemd doesn't","+        know, even though the kernel reports them as supported. Operation names that systemd doesn't know","+        are ignored. Use <command>systemd-analyze io-uring-filter</command> to list the operations that","+        systemd knows.</para>","+","+        <para>This option may be specified more than once, in which case the lists are merged. If the first","+        assignment starts with <literal>~</literal>, the list is a deny list, otherwise it is an allow list.","+        Later assignments of the other type remove the listed operations from the list. If the empty string","+        is assigned, the list is reset and all prior assignments have no effect. This setting does not","+        affect commands prefixed with <literal>+</literal>.</para>","+","+        <para>Requests for denied operations fail with <constant>EACCES</constant>. The restriction applies","+        to all io_uring instances that the processes of the unit create, but not to io_uring instances that","+        they receive from other processes. <constant>IORING_REGISTER_RESTRICTIONS</constant> without an","+        io_uring instance fails with <constant>EPERM</constant> for the processes of the unit.</para>","+","+        <para>This setting requires a kernel with io_uring BPF filters (Linux 7.0 or newer). On older","+        kernels, <function>io_uring_setup()</function> fails with <constant>ENOSYS</constant> for the","+        processes of the unit instead, so that programs fall back to regular system calls. If seccomp is not","+        available either, this setting has no effect.</para>","+","+        <para>Example: to deny passthrough commands to drivers and zero-copy network operations, use:","+        <programlisting>IOUringFilter=~uring_cmd uring_cmd128 send_zc sendmsg_zc recv_zc</programlisting>","+        </para>","+","+        <para><varname>SystemCallFilter=</varname>, <varname>RestrictAddressFamilies=</varname>, and","+        <varname>RestrictSUIDSGID=</varname> apply to the equivalent io_uring operations as well. To deny","+        io_uring entirely, use <varname>SystemCallFilter=~io_uring_setup</varname>.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","       <varlistentry>","         <term><varname>RestrictFileSystems=</varname></term>"," ","@@ -2857,6 +2909,14 @@ RestrictNamespaces=~cgroup net</programlisting>","         calls where those bits are passed indirectly and cannot be inspected by the filter, such as","         <function>openat2()</function>, the call is blocked entirely, regardless of the requested mode.</para>"," ","+        <para>On kernels that support io_uring BPF filters (Linux 7.0 and newer), this setting also applies","+        to the <constant>IORING_OP_OPENAT</constant> and <constant>IORING_OP_OPENAT2</constant> operations of","+        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>.","+        Requests that create a file with the SUID or SGID bits set fail with <constant>EACCES</constant>.","+        io_uring has no operations that change the mode of existing files. On such kernels,","+        <constant>IORING_REGISTER_RESTRICTIONS</constant> without an io_uring instance fails with","+        <constant>EPERM</constant> for the processes of the unit.</para>","+","         <xi:include href=\"version-info.xml\" xpointer=\"v242\"/></listitem>","       </varlistentry>"," ","@@ -2978,6 +3038,23 @@ RestrictNamespaces=~cgroup net</programlisting>","         <para>This feature makes use of the Secure Computing Mode 2 interfaces of the kernel ('seccomp","         filtering') and is useful for enforcing a minimal sandboxing environment.</para>"," ","+        <para>On kernels that support io_uring BPF filters (Linux 7.0 and newer), this setting also applies","+        to the operations of","+        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>,","+        if the filter allows <function>io_uring_setup()</function>. An operation that can do the work of","+        one or more system calls, such as <constant>IORING_OP_OPENAT</constant> or","+        <constant>IORING_OP_SOCKET</constant>, is denied if the filter denies any of its equivalent system","+        calls. <command>systemd-analyze io-uring-filter</command> lists the equivalent system calls of each","+        operation. Operations of newer kernels that systemd doesn't know are not affected. Denied requests","+        always fail with <constant>EACCES</constant>, regardless of","+        <varname>SystemCallErrorNumber=</varname> and of the action of the system call. System calls that","+        are denied with an error number of 0 do not affect io_uring operations, since a denied request","+        can't pretend to succeed. The restriction applies to all io_uring instances that the processes of","+        the unit create, but not to io_uring instances that they receive from other processes. On such","+        kernels, <constant>IORING_REGISTER_RESTRICTIONS</constant> without an io_uring instance fails with","+        <constant>EPERM</constant> for the processes of the unit. To filter individual io_uring operations,","+        use <varname>IOUringFilter=</varname>.</para>","+","         <para>Note that on systems supporting multiple ABIs (such as x86/x86-64) it is recommended to turn","         off alternative ABIs for services, so that they cannot be used to circumvent the restrictions of this","         option. Specifically, it is recommended to combine this option with"],"additions":86,"deletions":9,"truncated":false},{"path":"shell-completion/bash/systemd-analyze","lines":["@@ -52,6 +52,10 @@ __get_syscall_sets() {","     done"," }"," ","+__get_io_uring_ops() {","+    systemd-analyze --no-legend --no-pager io-uring-filter 2>/dev/null | { while read -r a b; do echo \" $a\"; done; }","+}","+"," __get_architectures() {","     systemd-analyze --no-legend --no-pager architectures 2>/dev/null | { while read -r a b; do echo \" $a\"; done; }"," }","@@ -88,6 +92,7 @@ _systemd_analyze() {","         [DUMP]='dump'","         [VERIFY]='verify'","         [SECCOMP_FILTER]='syscall-filter'","+        [IO_URING_FILTER]='io-uring-filter'","         [CAT_CONFIG]='cat-config'","         [SECURITY]='security'","         [CONDITION]='condition'","@@ -249,6 +254,13 @@ _systemd_analyze() {","             comps='--help --version --system --user --global --no-pager --json=off --json=pretty --json=short --table --no-legend --scale-svg --detailed'","         fi"," ","+    elif __contains_word \"$verb\" ${VERBS[IO_URING_FILTER]}; then","+        if [[ $cur = -* ]]; then","+            comps='--help --version --no-pager --json=off --json=pretty --json=short --no-legend'","+        else","+            comps=$( __get_io_uring_ops )","+        fi","+","     elif __contains_word \"$verb\" ${VERBS[ARCHITECTURES]}; then","         if [[ $cur = -* ]]; then","             comps='--help --version --no-pager --json=off --json=pretty --json=short --no-legend'"],"additions":12,"deletions":0,"truncated":false},{"path":"shell-completion/zsh/_systemd-analyze","lines":["@@ -43,6 +43,13 @@","         _describe -t groups 'syscall groups' _groups || compadd \"$@\"","     }"," ","+(( $+functions[_systemd-analyze_io-uring-filter] )) ||","+    _systemd-analyze_io-uring-filter() {","+        local -a _ops","+        _ops=( $(systemd-analyze --quie