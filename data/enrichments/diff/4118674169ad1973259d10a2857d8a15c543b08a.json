        _cleanup_(table_unrefp) Table *table = NULL;","+        int r;","+","+        table = table_new(\"opcode\", \"name\", \"syscalls\");","+        if (!table)","+                return log_oom();","+","+        (void) table_hide_column_from_display(table, (size_t) 0);","+        table_set_ersatz_string(table, TABLE_ERSATZ_DASH);","+","+        char **args = strv_skip(argv, 1);","+        if (args) {","+                STRV_FOREACH(arg, args) {","+                        int op;","+","+                        op = io_uring_op_from_string(*arg);","+                        if (op < 0)","+                                return log_error_errno(op, \"io_uring operation \\\"%s\\\" not known.\", *arg);","+","+                        r = add_op(table, op);","+                        if (r < 0)","+                                return r;","+                }","+","+                (void) table_set_sort(table, (size_t) 0);","+        } else","+                for (int op = 0; op < IORING_OP_LAST; op++) {","+                        r = add_op(table, op);","+                        if (r < 0)","+                                return r;","+                }","+","+        r = table_print_with_pager(table, arg_json_format_flags, arg_pager_flags, arg_legend);","+        if (r < 0)","+                return r;","+","+        return EXIT_SUCCESS;","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"src/analyze/analyze-io-uring-filter.h","lines":["@@ -0,0 +1,6 @@","+/* SPDX-License-Identifier: LGPL-2.1-or-later */","+#pragma once","+","+#include \"forward.h\"","+","+int verb_io_uring_filter(int argc, char *argv[], uintptr_t _data, void *userdata);"],"additions":6,"deletions":0,"truncated":false},{"path":"src/analyze/analyze.c","lines":["@@ -31,6 +31,7 @@"," #include \"analyze-has-tpm2.h\""," #include \"analyze-image-policy.h\""," #include \"analyze-inspect-elf.h\"","+#include \"analyze-io-uring-filter.h\""," #include \"analyze-log-control.h\""," #include \"analyze-ma