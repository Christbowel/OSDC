rdingSlingResource(connections=[])","+","+","+def fetch_row_count(sling: RecordingSlingResource, inserted_into: str) -> dict:","+    sling._stdout = [  # noqa: SLF001","+        f\"running stream {STREAM}\",","+        f\"inserted 4 rows into {inserted_into} in 0 secs [6 r/s]\",","+        \"\",","+    ]","+    events = SlingEventIterator(","+        iter([MaterializeResult(metadata={\"stream_name\": STREAM})]),","+        sling,","+        {\"target\": \"SLING_SQLITE\"},","+        build_op_context(),","+    )","+    (event,) = list(events.fetch_row_count())","+    return dict(event.metadata or {})","+","+","+def test_row_count_queries_the_logged_table(sling: RecordingSlingResource) -> None:","+    metadata = fetch_row_count(sling, '\"main\".\"orders\"')","+","+    assert sling._calls == [  # noqa: SLF001","+        [\"conns\", \"exec\", \"SLING_SQLITE\", \"select count(*) as ct from main.orders\"]","+    ]","+    assert metadata[\"dagster/row_count\"] == 4","+    assert metadata[\"dagster/storage_kind\"] == \"SLING_SQLITE\"","+","+","+@pytest.mark.parametrize(","+    \"inserted_into\",","+    [","+        '\"main\".\"orders\"\"; drop table users; --\"',","+        \"main.orders; drop table users\",","+        \"main.orders /* drop table users */\",","+        \"`main`.`orders`; drop table users\",","+    ],","+)","+def test_row_count_skips_unsafe_table_names(","+    sling: RecordingSlingResource, inserted_into: str","+) -> None:","+    metadata = fetch_row_count(sling, inserted_into)","+","+    assert not any(\"drop table\" in \" \".join(call) for call in sling._calls)  # noqa: SLF001","+    assert \"dagster/row_count\" not in metadata","+    assert metadata[\"stream_name\"] == STREAM","+","+","+def test_row_count_allows_backtick_quoted_names(sling: RecordingSlingResource) -> None:","+    metadata = fetch_row_count(sling, \"`my-project`.`dataset`.`orders`\")","+","+    assert sling._calls == [  # noqa: SLF001","+        [","+            \"conns\",","+            \"exec\",","+            \"SLING_SQLITE\",","+            \"select count(*) as ct from `my-project`.`dataset`.`orders`\",","+        ]","+    ]","+    assert metadata[\"dagster/row_count\"] == 4","+","+","+def test_row_count_allows_non_ascii_names(sling: RecordingSlingResource) -> None:","+    metadata = fetch_row_count(sling, '\"public\".\"café\"')","+","+    assert sling._calls == [  # noqa: SLF001","+        [\"conns\", \"exec\", \"SLING_SQLITE\", \"select count(*) as ct from public.café\"]","+    ]","+    assert metadata[\"dagster/row_count\"] == 4"],"additions":93,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-snowflake-pandas/dagster_snowflake_pandas/snowflake_pandas_type_handler.py","lines":["@@ -7,7 +7,11 @@"," from dagster._core.errors import DagsterInvariantViolationError"," from dagster._core.storage.db_io_manager import DbTypeHandler, TableSlice"," from dagster_snowflake import build_snowflake_io_manager","-from dagster_snowflake.snowflake_io_manager import SnowflakeDbClient, SnowflakeIOManager","+from dagster_snowflake.snowflake_io_manager import (","+    SnowflakeDbClient,","+    SnowflakeIOManager,","+    check_table_slice_names,","+)"," from snowflake.connector.pandas_tools import write_pandas"," "," ","@@ -103,6 +107,7 @@ def handle_output(","     ) -> Mapping[str, RawMetadataValue]:","         from snowflake import connector"," ","+        check_table_slice_names(table_slice)","         if obj.empty:","             context.log.warning(","                 \"Skipping Snowflake write for empty DataFrame. An empty table will not be created.\""],"additions":6,"deletions":1,"truncated":false},{"path":"python_modules/libraries/dagster-snowflake-polars/dagster_snowflake_polars/snowflake_polars_type_handler.py","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":435,"deletions":9,"truncated":true,"file_count":20},"error":null,"fetched_at":"2026-11-25T18:24:44.167054+00:00"}