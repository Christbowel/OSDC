arametrize(","+    (\"schema\", \"table\"),","+    [","+        (\"schema1\", \"table1\"),","+        (\"my_schema\", \"b_df\"),","+        (\"_private\", \"Table_2\"),","+        (\"public\", \"café\"),","+        (\"attached_db.analytics\", \"table1\"),","+    ],","+)","+def test_statements_keep_plain_names_unquoted(","+    render: Callable[[TableSlice], str], verb: str, schema: str, table: str","+) -> None:","+    assert render(TableSlice(schema=schema, table=table)) == f\"{verb} FROM {schema}.{table}\"","+","+","+@render_statement","+@pytest.mark.parametrize(","+    (\"field\", \"name\"),","+    [(\"schema\", \"a.b.c\"), (\"schema\", \"a.\"), (\"schema\", \".a\"), (\"table\", \"a.b\")],","+)","+def test_statements_reject_extra_dotted_parts(","+    render: Callable[[TableSlice], str], verb: str, field: str, name: str","+) -> None:","+    with pytest.raises(DagsterInvariantViolationError, match=re.escape(f\"{field} {name!r}\")):","+        render(table_slice_with(field, name))"],"additions":62,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-gcp/dagster_gcp/bigquery/io_manager.py","lines":["@@ -1,3 +1,4 @@","+import re"," from abc import abstractmethod"," from collections.abc import Iterator, Sequence"," from contextlib import contextmanager","@@ -13,6 +14,7 @@","     DbTypeHandler,","     TablePartitionDimension,","     TableSlice,","+    check_sql_identifier,","     escape_backslash_sql_string_literal,","     static_where_clause,"," )","@@ -368,6 +370,20 @@ def yield_for_execution(self, context) -> Iterator[DbIOManager]:","             yield mgr"," "," ","+# Project ids may contain hyphens, and domain-scoped ones '.' and ':'; tables may contain hyphens.","+# Both are only written inside backticks. Datasets also appear unquoted, in CREATE SCHEMA.","+BIGQUERY_PROJECT_REGEX = re.compile(r\"[\\w.:-]+\")","+BIGQUERY_DATASET_REGEX = re.compile(r\"\\w+\")","+BIGQUERY_TABLE_REGEX = re.compile(r\"[\\w-]+\")","+","+","+def check_table_slice_names(table_slice: TableSlice) -> None:","+    if table_slice.database is not None:","+        check_sql_identifier(table_slice.database, field=\"database\", pattern=BIGQUERY_PROJECT_REGEX)","+    check_sql_identifier(table_slice.schema, field=\"schema\", pattern=BIGQUERY_DATASET_REGEX)","+    check_sql_identifier(table_slice.table, field=\"table\", pattern=BIGQUERY_TABLE_REGEX)","+","+"," class BigQueryClient(DbClient):","     def __init__(","         self,","@@ -382,6 +398,7 @@ def __init__("," ","     @staticmethod","     def delete_table_slice(context: OutputContext, table_slice: TableSlice, connection) -> None:","+        check_table_slice_names(table_slice)","         try:","             # If partitioned, keep existing behavior (delete matching partitions)","             if table_slice.partition_dimensions:","@@ -408,6 +425,7 @@ def delete_table_slice(context: OutputContext, table_slice: TableSlice, connecti"," ","     @staticmethod","     def get_select_statement(table_slice: TableSlice) -> str:","+        check_table_slice_names(table_slice)","         col_str = \", \".join(table_slice.columns) if table_slice.columns else \"*\""," ","         if table_slice.partition_dimensions:","@@ -421,11 +439,13 @@ def get_select_statement(table_slice: TableSlice) -> str:"," ","     @staticmethod","     def ensure_schema_exists(context: OutputContext, table_slice: TableSlice, connection) -> None:","+        check_table_slice_names(table_slice)","         connection.query(f\"CREATE SCHEMA IF NOT EXISTS {table_slice.schema}\").result()"," ","     @staticmethod","     @contextmanager","     def connect(context, table_slice):","+        check_table_slice_names(table_slice)","         config = context.resource_config or {}"," ","         project_val = config.get(\"project\")","@@ -443,6 +463,7 @@ def _get_cleanup_statement(table_slice: TableSlice) -> str:","     \"\"\"Returns a SQL statement that deletes data in the given table to make way for the output data","     being written.","     \"\"\"","+    check_table_slice_names(table_slice)","     if table_slice.partition_dimensions:","         query = (","             f\"DELETE FROM `{table_slice.database}.{table_slice.schema}.{table_slice.table}` WHERE\\n\""],"additions":21,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-gcp/dagster_gcp/bigquery/resources.py","lines":["@@ -1,3 +1,4 @@","+import re"," from collections.abc import Iterator, Mapping, Sequence"," from contextlib import contextmanager"," from datetime import datetime","@@ -10,6 +11,7 @@","     resource,"," )"," from dagster._core.definitions.resource_definition import dagster_maintained_resource","+from dagster._core.storage.db_io_manager import check_sql_identifier"," from google.cloud import bigquery"," from pydantic import Field"," ","@@ -105,6 +107,11 @@ def bigquery_resource(context):","         yield client"," "," ","+# An optional project id and a dataset. A bare project id may contain hyphens, but not \"--\",","+# which starts a comment; a backtick-quoted one may also be domain-scoped (\"example.com:proj\").","+DATASET_ID_REGEX = re.compile(r\"(?:(?:[^\\W\\d]\\w*(?:-\\w+)*|`[\\w.:-]+`)\\.)?\\w+\")","+","+"," def fetch_last_updated_timestamps(","     *,","     client: bigquery.Client,","@@ -127,6 +134,7 @@ def fetch_last_updated_timestamps(","         len(table_ids) > 0,","         \"At least one table ID must be provided.\",","     )","+    check_sql_identifier(dataset_id, field=\"dataset_id\", pattern=DATASET_ID_REGEX)","     query = f\"\"\"","         SELECT","             table_id,"],"additions":8,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-gcp/dagster_gcp_tests/bigquery_tests/test_identifier_validation.py","lines":["@@ -0,0 +1,139 @@","+import re","+from collections.abc import Callable","+from datetime import datetime","+from types import SimpleNamespace","+","+import pytest","+from dagster import DagsterInvariantViolationError, build_output_context","+from dagster._core.storage.db_io_manager import TableSlice","+from dagster_gcp import fetch_last_updated_timestamps","+from dagster_gcp.bigquery.io_manager import BigQueryClient, _get_cleanup_statement","+","+UNSAFE_NAMES = [\"t; drop table x\", \"t --\", \"t'\", \"t`\", \"my table\", \"t()\", \"t\\\\\"]","+","+","+def table_slice_with(field: str, name: str) -> TableSlice:","+    names = {\"database\": \"my-project\", \"schema\": \"my_dataset\", \"table\": \"my_table\", field: name}","+    return TableSlice(database=names[\"database\"], schema=names[\"schema\"], table=names[\"table\"])","+","+","+render_statement = pytest.mark.parametrize(","+    (\"render\", \"verb\"),","+    [","+        (BigQueryClient.get_select_statement, \"SELECT * FROM\"),","+        (_get_cleanup_statement, \"TRUNCATE TABLE\"),","+    ],","+    ids=[\"select\", \"cleanup\"],","+)","+","+","+@render_statement","+@pytest.mark.parametrize(\"field\", [\"database\", \"schema\", \"table\"])","+@pytest.mark.parametrize(\"name\", UNSAFE_NAMES)","+def test_statements_reject_unsafe_names(","+    render: Callable[[TableSlice], str], verb: str, field: str, name: str","+) -> None:","+","+    with pytest.raises(DagsterInvariantViolationError, match=re.escape(f\"{field} {name!r}\")):","+        render(table_slice_with(field, name))","+","+","+@render_statement","+@pytest.mark.parametrize(","+    (\"database\", \"schema\", \"table\"),","+    [","+        (\"db\", \"schema1\", \"table1\"),","+        (\"my-project\", \"my_dataset\", \"my-table\"),","+        (\"example.com:my-project\", \"Dataset_1\", \"café\"),","+    ],","+)","+def test_statements_keep_names_as_before(","+    render: Callable[[TableSlice], str], verb: str, database: str, schema: str, table: str","+) -> None:","+    table_slice = TableSlice(database=database, schema=schema, table=table)","+","+    assert render(table_slice) == f\"{verb} `{database}.{schema}.{table}`\"","+","+","+class RecordingConnection:","+    def __init__(self):","+        self.statements: list[str] = []","+","+    def query(self, statement: str, job_config=None) -> SimpleNamespace:","+        self.statements.append(statement)","+        row = SimpleNamespace(table_id=\"my_table\", last_modified_time=datetime(2024, 1, 1))","+        return SimpleNamespace(result=lambda: [row])","+","+","+@pytest.mark.parametrize(\"schema\", [\"my-dataset\", \"x; drop table y\", \"x --\"])","+def test_ensure_schema_exists_rejects_unsafe_schema(schema: str) -> None:","+    connection = RecordingConnection()","+    table_slice = TableSlice(database=\"my-project\", schema=schema, table=\"my_table\")","+","+    with pytest.raises(DagsterInvariantViolationError, match=\"schema\"):","+        BigQueryClient.ensure_schema_exists(build_output_context(), table_slice, connection)","+","+    assert connection.statements == []","+","+","+@pytest.mark.parametrize(\"field\", [\"database\", \"schema\", \"table\"])","+@pytest.mark.parametrize(\"write_mode\", [\"truncate\", \"replace\"])","+def test_delete_table_slice_rejects_unsafe_names(field: str, write_mode: str) -> None:","+    connection = RecordingConnection()","+    context = SimpleNamespace(resource_config={\"write_mode\": write_mode})","+","+    with pytest.raises(DagsterInvariantViolationError, match=field):","+        BigQueryClient.delete_table_slice(","+            context,  # ty: ignore[invalid-argument-type]","+            table_slice_with(field, \"x`\"),","+            connection,","+        )","+","+    assert connection.statements == []","+","+","+@pytest.mark.parametrize(","+    \"dataset_id\",","+    [","+        \"x; drop table y\",","+        \"x --\",","+        \"my--project.x\",","+        \"`x`\",","+        \"a.b.c\",","+        \"`a`b`.x\",","+        \"`a\\\\`.x\",","+        \"`a b`.x\",","+    ],","+)","+def test_fetch_last_updated_timestamps_rejects_unsafe_dataset(dataset_id: str) -> None:","+    connection = RecordingConnection()","+","+    with pytest.raises(DagsterInvariantViolationError, m