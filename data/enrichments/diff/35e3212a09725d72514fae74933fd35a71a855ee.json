slice_names(table_slice)","         if obj.empty:","             context.log.warning(","                 \"Skipping DuckDB write for empty DataFrame. An empty table will not be created.\""],"additions":7,"deletions":1,"truncated":false},{"path":"python_modules/libraries/dagster-duckdb-pandas/dagster_duckdb_pandas_tests/test_identifier_validation.py","lines":["@@ -0,0 +1,30 @@","+from pathlib import Path","+","+import pandas as pd","+import pytest","+from dagster import DagsterInvariantViolationError, asset, materialize","+from dagster_duckdb_pandas import DuckDBPandasIOManager","+","+","+@asset(key_prefix=[\"my_schema\"])","+def my_table() -> pd.DataFrame:","+    return pd.DataFrame({\"a\": [1, 2, 3]})","+","+","+@pytest.mark.parametrize(\"schema\", [\"s; drop table x\", \"s --\", \"s'\", 's\"', \"my schema\", \"s()\"])","+def test_run_config_cannot_override_schema_with_unsafe_name(tmp_path: Path, schema: str) -> None:","+    database = tmp_path / \"unit_test.duckdb\"","+    io_manager = DuckDBPandasIOManager(database=str(database), schema=\"my_schema\")","+","+    with pytest.raises(DagsterInvariantViolationError, match=\"schema\"):","+        materialize(","+            [my_table],","+            resources={\"io_manager\": io_manager},","+            run_config={","+                \"resources\": {","+                    \"io_manager\": {\"config\": {\"database\": str(database), \"schema\": schema}}","+                }","+            },","+        )","+","+    assert not database.exists()"],"additions":30,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-duckdb-polars/dagster_duckdb_polars/duckdb_polars_type_handler.py","lines":["@@ -3,7 +3,12 @@"," import polars as pl"," from dagster import InputContext, MetadataValue, OutputContext, TableColumn, TableSchema"," from dagster._core.storage.db_io_manager import DbTypeHandler, TableSlice","-from dagster_duckdb.io_manager import DuckDbClient, DuckDBIOManager, build_duckdb_io_manager","+from d