{"id":"78912690ff6acb82501e6c52c8276944ff647738","axis":"silent","repo":"envoyproxy/envoy","sha":"78912690ff6acb82501e6c52c8276944ff647738","parsed":{"files":[{"path":"changelogs/current/minor_behavior_changes/jwt_authn__select-key-by-x5t.rst","lines":["@@ -0,0 +1,4 @@","+jwt_authn: when a JWT has no ``kid``, keys whose ``x5t#S256`` (or, failing that, ``x5t``) differs","+from the JWT header's are skipped. Keys without a thumbprint are still tried. This behavior can be","+reverted by setting runtime guard ``envoy.reloadable_features.jwt_authn_select_key_by_x5t`` to","+``false``."],"additions":4,"deletions":0,"truncated":false},{"path":"source/common/jwt/BUILD","lines":["@@ -29,6 +29,7 @@ envoy_cc_library(","     deps = [","         \"//bazel:ssl\",","         \"//source/common/protobuf\",","+        \"//source/common/runtime:runtime_features_lib\",","         \"@abseil-cpp//absl/container:flat_hash_set\",","         \"@abseil-cpp//absl/strings\",","         \"@abseil-cpp//absl/time\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/jwt/jwks.cc","lines":["@@ -319,10 +319,12 @@ Status extractJwk(const Protobuf::Struct& jwk_pb, Jwks::Pubkey* jwk) {","     return Status::JwksBadKty;","   }"," ","-  // \"kid\" and \"alg\" are optional, if they do not exist, set them to","+  // \"kid\", \"alg\", \"x5t#S256\" and \"x5t\" are optional, if they do not exist, set them to","   // empty. https://tools.ietf.org/html/rfc7517#page-8","   jwk_getter.GetString(\"kid\", &jwk->kid_);","   jwk_getter.GetString(\"alg\", &jwk->alg_);","+  jwk_getter.GetString(\"x5t#S256\", &jwk->x5t_s256_);","+  jwk_getter.GetString(\"x5t\", &jwk->x5t_);"," ","   // Extract public key according to \"kty\" value.","   // https://tools.ietf.org/html/rfc7518#section-6.1"],"additions":3,"deletions":1,"truncated":false},{"path":"source/common/jwt/jwks.h","lines":["@@ -44,6 +44,8 @@ class Jwks : public WithStatus {","   struct Pubkey {","     std::string hmac_key_;","     std::string kid_;","+    std::string x5t_s256_;","+    std::string x5t_;","     std::string kty_;","     std::string alg_;","     std::string crv_;"],"additions":2,"deletions":0,"truncated":false},{"path":"source/common/jwt/jwt.cc","lines":["@@ -72,6 +72,11 @@ Status Jwt::parseFromString(const std::string& jwt) {","     return Status::JwtHeaderBadKid;","   }"," ","+  // Header may contain \"x5t#S256\" and \"x5t\". They are only used to select a key, so a value that","+  // is not a string is ignored.","+  header_getter.GetString(\"x5t#S256\", &x5t_s256_);","+  header_getter.GetString(\"x5t\", &x5t_);","+","   // Parse payload json","   payload_str_base64url_ = std::string(jwt_split[1]);","   if (!absl::WebSafeBase64Unescape(payload_str_base64url_, &payload_str_)) {"],"additions":5,"deletions":0,"truncated":false},{"path":"source/common/jwt/jwt.h","lines":["@@ -44,6 +44,9 @@ struct Jwt {","   std::string alg_;","   // kid","   std::string kid_;","+  // x5t#S256 and x5t certificate thumbprints","+  std::string x5t_s256_;","+  std::string x5t_;","   // iss","   std::string iss_;","   // audiences"],"additions":3,"deletions":0,"truncated":false},{"path":"source/common/jwt/verify.cc","lines":["@@ -5,6 +5,7 @@"," #include \"source/common/jwt/verify.h\""," "," #include \"source/common/jwt/check_audience.h\"","+#include \"source/common/runtime/runtime_features.h\""," "," #include \"absl/strings/string_view.h\""," #include \"absl/time/clock.h\"","@@ -187,6 +188,16 @@ Status verifySignatureEd25519(absl::string_view key, absl::string_view signature","   return Status::JwtVerificationFail;"," }"," ","+bool thumbprintMismatch(const Jwt& jwt, const Jwks::Pubkey& jwk) {","+  if (!jwt.x5t_s256_.empty() && !jwk.x5t_s256_.empty()) {","+    return jwt.x5t_s256_ != jwk.x5t_s256_;","+  }","+  if (!jwt.x5t_.empty() && !jwk.x5t_.empty()) {","+    return jwt.x5t_ != jwk.x5t_;","+  }","+  return false;","+}","+"," } // namespace"," "," Status verifyJwtWithoutTimeChecking(const Jwt& jwt, const Jwks& jwks) {","@@ -200,6 +211,11 @@ Status verifyJwtWithoutTimeChecking(const Jwt& jwt, const Jwks& jwks) {","     if (!jwt.kid_.empty() && !jwk->kid_.empty() && jwk->kid_ != jwt.kid_) {","       continue;","     }","+    // Without a kid, the certificate thumbprint selects the key the same way.","+    if (jwt.kid_.empty() && thumbprintMismatch(jwt, *jwk) &&","+        Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.jwt_authn_select_key_by_x5t\")) {","+      continue;","+    }"," ","     // The same alg must be used.","     if (!jwk->alg_.empty() && jwk->alg_ != jwt.alg_) {"],"additions":16,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -124,6 +124,7 @@ RUNTIME_GUARD(envoy_reloadable_features_ja4_filter_grease_signature_algorithms);"," RUNTIME_GUARD(envoy_reloadable_features_json_formatter_omit_empty_values);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_add_verification_status_header);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_sanitize_payload_headers_filter_wide);","+RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_select_key_by_x5t);"," RUNTIME_GUARD(envoy_reloadable_features_limit_json_parser_nesting_depth);"," RUNTIME_GUARD(envoy_reloadable_features_listener_filter_reentrant_continue_guard);"," RUNTIME_GUARD(envoy_reloadable_features_listener_in_place_address_update);"],"additions":1,"deletions":0,"truncated":false},{"path":"test/common/jwt/BUILD","lines":["@@ -132,6 +132,7 @@ envoy_cc_test(","     deps = [","         \":test_common_lib\",","         \"//source/common/jwt:jwt_lib\",","+        \"//test/test_common:test_runtime_lib\",","         \"//test/test_common:utility_lib\",","     ],"," )"],"additions":1,"deletions":0,"truncated":false},{"path":"test/common/jwt/jwks_test.cc","lines":["@@ -27,6 +27,8 @@ TEST(JwksParseTest, GoodJwks) {","             \"alg\": \"RS256\",","             \"use\": \"sig\",","             \"kid\": \"62a93512c9ee4c7f8067b5a216dade2763d32a47\",","+            \"