{"id":"ebf746c795a108ce8c36272fdce5bcf3171063f4","axis":"silent","repo":"rails/rails","sha":"ebf746c795a108ce8c36272fdce5bcf3171063f4","parsed":{"files":[{"path":"activerecord/CHANGELOG.md","lines":["@@ -1,36 +1,62 @@","-*   Fix `has_many :through` with `disable_joins: true` ignoring the polymorphic","-    type condition of an `as:` association in the chain.","+*   Add `config.active_record.association_scope_keeps_owner_conditions` to","+    always apply the conditions tying the records of an association to the","+    owner, and deprecate removing them with the association scope.","+","+    `unscope(where: ...)`, `unscope(:where)`, and `rewhere` in an association","+    scope could remove the foreign key condition when loading the association,","+    so it loaded records of other owners, and `update_all`, `delete_all`, and","+    `dependent: :delete_all` affected them. Preloading, eager loading, and","+    joins already kept it. They could also remove or replace the polymorphic","+    type condition of an `as:` association in every path, so the association","+    loaded records it doesn't write: `taggings.create!` still stores the","+    owner's `polymorphic_name`.","+","+    When enabled (the default for new applications), these conditions are","+    always applied. Otherwise the old behavior is kept with a deprecation","+    warning, and in Rails 9.0 they will always be applied."," ","     ```ruby","-    class Post < ActiveRecord::Base","-      has_many :taggings, as: :taggable","-      has_many :tags, through: :taggings, disable_joins: true","+    class Car < ActiveRecord::Base","+      has_many :all_bulbs, -> { unscope(:where) }, class_name: \"Bulb\"","     end"," ","-    post.tags","-    # Before: SELECT \"taggings\".\"tag_id\" FROM \"taggings\" WHERE \"taggings\".\"taggable_id\" = ?","-    # After:  SELECT \"taggings\".\"tag_id\" FROM \"taggings\" WHERE \"taggings\".\"taggable_id\" = ? AND \"taggings\".\"taggable_type\" = ?","+    car.all_bulbs","+    # Before: SELECT \"bulbs\".* FROM \"bulbs\"","+    # After:  SELECT \"bulbs\".* FROM \"bulbs\" WHERE \"bulbs\".\"car_id\" = ?","     ```"," ","-    *Ryuta Kamizono*","+    To load records of other owners, use a scope or a method instead of the","+    association. To store a different polymorphic type for the owner,","+    override `polymorphic_name`. To query records of another type, use","+    `foreign_key:` and `where` instead of `as:`.","+","+    ```ruby","+    class User < ActiveRecord::Base","+      def messages","+        Message.where(sender: self).or(Message.where(recipient: self))","+      end","+    end"," ","-*   Fix the association scope removing the association's own key condition","-    when loading the association.","+    class TaggedPost < Post","+      def self.polymorphic_name = name","+      has_many :taggings, as: :taggable","+    end","+    ```"," ","-    `unscope(where: ...)`, `unscope(:where)`, and `rewhere` in an association","-    scope removed the condition that ties the records to the owner, so the","-    association loaded records of other owners, and `update_all`, `delete_all`,","-    and `dependent: :delete_all` affected them. Preloading, eager loading, and","-    joins already kept it.","+    *Ryuta Kamizono*","+","+*   Fix `has_many :through` with `disable_joins: true` ignoring the polymorphic","+    type condition of an `as:` association in the chain."," ","     ```ruby","-    class Car < ActiveRecord::Base","-      has_many :all_bulbs, -> { unscope(:where) }, class_name: \"Bulb\"","+    class Post < ActiveRecord::Base","+      has_many :taggings, as: :taggable","+      has_many :tags, through: :taggings, disable_joins: true","     end"," ","-    car.all_bulbs","-    # Before: SELECT \"bulbs\".* FROM \"bulbs\"","-    # After:  SELECT \"bulbs\".* FROM \"bulbs\" WHERE \"bulbs\".\"car_id\" = ?","+    post.tags","+    # Before: SELECT \"taggings\".\"tag_id\" FROM \"taggings\" WHERE \"taggings\".\"taggable_id\" = ?","+    # After:  SELECT \"taggings\".\"tag_id\" FROM \"taggings\" WHERE \"taggings\".\"taggable_id\" = ? AND \"taggings\".\"taggable_type\" = ?","     ```"," ","     *Ryuta Kamizono*"],"additions":47,"deletions":21,"truncated":false},{"path":"activerecord/lib/active_record.rb","lines":["@@ -412,6 +412,15 @@ def self.raise_on_assign_to_attr_readonly=(value)","   singleton_class.attr_accessor :raise_on_missing_required_finder_order_columns","   self.raise_on_missing_required_finder_order_columns = false"," ","+  ##","+  # :singleton-method: association_scope_keeps_owner_conditions","+  # Specifies whether an association always applies the conditions tying the","+  # records to the owner (the key and the polymorphic type of +as:+), even","+  # when its scope removes or replaces them with +unscope+ or +rewhere+.","+  # When false, the scope can remove them, which is deprecated.","+  singleton_class.attr_accessor :association_scope_keeps_owner_conditions","+  self.association_scope_keeps_owner_conditions = false","+","   ##","   # :singleton-method: shuffle_unordered_selects","   # Shuffles the rows of every `SELECT` Active Record generates that has no"],"additions":9,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/associations/association_scope.rb","lines":["@@ -121,12 +121,15 @@ def get_chain(reflection, association, tracker, routes)","         end"," ","         def add_constraints(scope, owner, chain)","+          where_clause = scope.where_clause","           scope, key_clause = last_chain_scope(scope, chain.last, owner)"," ","           chain.each_cons(2) do |reflection, next_reflection|","             scope = next_chain_scope(scope, reflection, next_reflection)","           end"," ","+          fixed_clause = scope.where_clause - where_clause - key_clause","+","           chain_head = chain.first","           chain.reverse_each do |reflection|","             reflection.constraints.each do |scope_chain_item|","@@ -156,9 +159,7 @@ def add_constraints(scope, owner, chain)","             end","           end"," ","-          # The association scope can't remove the key conditions tying the","-          # records to the owner, like it can't on joins or preloading.","-          scope.where_clause += key_clause - scope.where_clause","+          chain.first.keep_owner_conditions(scope, key_clause, fixed_clause)"," ","           scope","         end"],"additions":4,"deletions":3,"truncated":false},{"path":"activerecord/lib/active_record/associations/disable_joins_association_scope.rb","lines":["@@ -40,6 +40,7 @@ def add_constraints(reflection, lookup, owner)","           route.destination_fixed_values.each do |column, value|","             scope._where!(column => value)","           end","+          type_clause = scope.where_clause - key_clause"," ","           relation = reflection.klass.scope_for_association","           scope.merge!(","@@ -54,7 +55,7 @@ def add_constraints(reflection, lookup, owner)","             scope.default_order_values = item.default_order_values | scope.default_order_values","             scope","           end","-          scope.where_clause += key_clause - scope.where_clause","+          reflection.keep_owner_conditions(scope, key_clause, type_clause)"," ","           if order_rank(scope) < lookup.order_rank","             split_scope = DisableJoinsAssociationRelation.create(scope.model, key, lookup.ids)"],"additions":2,"deletions":1,"truncated":false},{"path":"activerecord/lib/active_record/associations/preloader/association.rb","lines":["@@ -297,9 +297,16 @@ def destination_fixed_values","           def build_scope","             scope = klass.scope_for_association","             fixed_values = destination_fixed_values","-            scope._where!(fixed_values) unless fixed_values.empty?","+            unless fixed_values.empty?","+              where_clause = scope.where_clause","+              scope._where!(fixed_values)","+              fixed_clause = scope.where_clause - where_clause","+            end"," ","-            scope.merge!(reflection_scope) unless reflection_scope.empty_scope?","+            unless reflection_scope.empty_scope?","+              scope.merge!(reflection_scope)","+              reflection.keep_owner_conditions(scope, Relation::WhereClause.empty, fixed_clause) if fixed_clause","+            end","             scope.default_order!(reflection.options[:default_order]) if reflection.options[:default_order].present?"," ","             if preload_scope && !preload_scope.empty_scope?"],"additions":9,"deletions":2,"truncated":false},{"path":"activerecord/lib/active_record/reflection.rb","lines":["@@ -229,10 +229,13 @@ def join_scope(table, foreign_table, foreign_klass)","         klass_scope       = klass_join_scope(table, predicate_builder)"," ","         route = association_route_for_join(foreign_klass)","+        where_clause = klass_scope.where_clause","         route.destination_fixed_values.each do |column, value|","           klass_scope._where!(column => value)","         end","+        fixed_clause = klass_scope.where_clause - where_clause","         scope_chain_items.inject(klass_scope, &:merge!)","+        keep_owner_conditions(klass_scope, Relation::WhereClause.empty, fixed_clause)"," ","         route.each_match do |origin_column, destination_column|","           destination_attribute = predicate_builder.predicate_attribute(table[destination_column])","@@ -244,6 +247,43 @@ def join_scope(table, foreign_table, foreign_klass)","         klass_scope","       end"," ","+      # Re-applies the conditions tying the records to the owner (the key and","+      # the polymorphic type) that the association scope removed or replaced,","+      # or warns that it does when +association_scope_keeps_owner_conditions+","+      # is disabled.","+      def keep_owner_conditions(scope, key_clause, type_clause = Relation::WhereClause.empty) # :nodoc:","+        removed_key = key_clause - scope.where_clause","+        removed_type = type_clause - scope.where_clause","+        return if removed_key.empty? && removed_type.empty?","+","+        if ActiveRecord.association_scope_keeps_owner_conditions","+          scope.where_clause += removed_key + removed_type","+          return","+        end","+","+        columns = (removed_key + removed_type).extract_attributes.map do |attr|","+          \"`#{attr.relation.table_alias || attr.relation.name}.#{attr.name}`\"","+        end.uniq","+","+        hints = []","+        unless removed_key.empty?","+          hints << \"To load records of other owners, use a scope or a method instead of the association.\"","+        end","+        unless removed_type.empty?","+          hints << \"To store a different polymorphic type for the owner, override `polymorphic_name` on the owner class. \" \\","+            \"To query records of another type, use `foreign_key:` and `where` instead of `as:`.\"","+        end","+","+        ActiveRecord.deprecator.warn(<<~MSG.squish)","+          An association scope removes or replaces the conditions tying the records","+          to the owner on #{columns.join(\", \")} of the `#{active_record.name}##{name}` association.","+          This behavior is deprecated and in Rails 9.0 these conditions will always be applied.","+          To opt in to the new behavior now, set","+          `config.active_record.association_scope_keeps_owner_conditions = true`.","+          #{hints.join(\" \")}","+        MSG","+      end","+","       def association_scope_cache(klass, routes, &block)","         key = [self, *routes]","         klass.with_connection do |connection|","@@ -1561,7 +1601,7 @@ def source_type_scope","     end"," ","     class RuntimeReflection < AbstractReflection # :nodoc:","-      delegate :scope, :type, :constraints, to: :@reflection","+      delegate :scope, :type, :constraints, :name, :active_record, to: :@reflection"," ","       def initialize(reflection, association, route)","         super()"],"additions":41,"deletions":1,"truncated":false},{"path":"activerecord/test/cases/associations/has_many_associations_test.rb","lines":["@@ -1,6 +1,7 @@"," # frozen_string_literal: true"," "," require \"cases/helper\"","+require \"active_support/core_ext/object/with\""," require \"support/deprecated_associations_test_helpers\""," require \"models/developer\""," require \"models/computer\"","@@ -3119,6 +3120,86 @@ def test_association_with_rewhere_doesnt_set_inverse_instance_key","     assert_equal \"other\", other_bulb.reload.name","   end"," ","+  test \"the association scope removing the foreign key is deprecated when association_scope_keeps_owner_conditions is false\" do","+    car = Car.create!","+    bulb = Bulb.create! name: \"defaulty\", car: car","+    Bulb.create! name: \"defaulty\", car: Car.create!","+    message = /conditions tying the records to the owner on `bulbs.car_id` of the `Car#bulbs_unscoping_car_id` association/","+","+    ActiveRecord.with(association_scope_keeps_owner_conditions: false) do","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal Bulb.all.sort_by(&:id), car.bulbs_unscoping_car_id.sort_by(&:id)","+      end","+      assert_not_deprecated(ActiveRecord.deprecator) do","+        assert_equal [bulb], Car.preload(:bulbs_unscoping_car_id).find(car.id).bulbs_unscoping_car_id","+        assert_equal [bulb], Car.eager_load(:bulbs_unscoping_car_id).find(car.id).bulbs_unscoping_car_id","+      end","+    end","+  end","+","+  test \"the association scope can't replace the polymorphic type\" do","+    post = TaggedPost.create!(title: \"Tagged\", body: \"Post\")","+    Tagging.create!(taggable: post).update_columns(taggable_type: \"TaggedPost\")","+    Tagging.create!(taggable: post)","+","+    assert_empty post.taggings","+    assert_empty TaggedPost.preload(:taggings).find(post.id).taggings","+    assert_empty TaggedPost.eager_load(:taggings).find(post.id).taggings","+    assert_empty TaggedPost.joins(:taggings).where(id: post.id)","+  end","+","+  test \"the association scope can't remove the polymorphic type\" do","+    post = posts(:welcome)","+    Tagging.create!(taggable: post).update_columns(taggable_type: \"Other\")","+    expected = post.taggings.sort_by(&:id)","+","+    assert_equal expected, post.taggings_unscoping_type.sort_by(&:id)","+    assert_equal expected, Post.preload(:taggings_unscoping_type).find(post.id).taggings_unscoping_type.sort_by(&:id)","+    assert_equal expected, Post.eager_load(:taggings_unscoping_type).find(post.id).taggings_unscoping_type.sort_by(&:id)","+  end","+","+  test \"the association scope replacing the polymorphic type is deprecated when association_scope_keeps_owner_conditions is false\" do","+    post = TaggedPost.create!(title: \"Tagged\", body: \"Post\")","+    Tagging.create!(taggable: post).update_columns(taggable_type: \"TaggedPost\")","+    Tagging.create!(taggable: post)","+    tagging = Tagging.find_by!(taggable_type: \"TaggedPost\")","+    message = /conditions tying the records to the owner on `taggings.taggable_type` of the `TaggedPost#taggings` association/","+","+    ActiveRecord.with(association_scope_keeps_owner_conditions: false) do","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [tagging], post.taggings.to_a","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [tagging], TaggedPost.preload(:taggings).find(post.id).taggings","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [tagging], TaggedPost.eager_load(:taggings).find(post.id).taggings","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [post], TaggedPost.joins(:taggings).where(id: post.id).to_a","+      end","+    end","+  end","+","+  test \"the association scope removing the polymorphic type is deprecated when association_scope_keeps_owner_conditions is false\" do","+    post = posts(:welcome)","+    Tagging.create!(taggable: post).update_columns(taggable_type: \"Other\")","+    expected = Tagging.where(taggable_id: post.id).sort_by(&:id)","+    message = /conditions tying the records to the owner on `taggings.taggable_type` of the `Post#taggings_unscoping_type` association/","+","+    ActiveRecord.with(association_scope_keeps_owner_conditions: false) do","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal expected, post.taggings_unscoping_type.sort_by(&:id)","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal expected, Post.preload(:taggings_unscoping_type).find(post.id).taggings_unscoping_type.sort_by(&:id)","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal expected, Post.eager_load(:taggings_unscoping_type).find(post.id).taggings_unscoping_type.sort_by(&:id)","+      end","+    end","+  end","+","   test \"unscopes the default scope of associated model when used with include\" do","     car = Car.create!","     bulb1 = Bulb.create! name: \"defaulty\", car: car"],"additions":81,"deletions":0,"truncated":false},{"path":"activerecord/test/cases/associations/has_many_through_associations_test.rb","lines":["@@ -1,6 +1,7 @@"," # frozen_string_literal: true"," "," require \"cases/helper\"","+require \"active_support/core_ext/object/with\""," require \"support/deprecated_associations_test_helpers\""," require \"models/post\""," require \"models/person\"","@@ -1270,10 +1271,30 @@ def test_duplicated_has_many_through_with_through_scope_with_joins","   end"," ","   def test_has_many_through_polymorphic_with_rewhere","+    message = /conditions tying the records to the owner on `taggings.taggable_type` of the `TaggedPost#(tags|taggings)` association/","+    ActiveRecord.with(association_scope_keeps_owner_conditions: false) do","+      post = TaggedPost.create!(title: \"Tagged\", body: \"Post\")","+      tag = assert_deprecated(message, ActiveRecord.deprecator) { post.tags.create!(name: \"Tag\") }","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [tag], post.tags.reload.to_a","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [tag], TaggedPost.preload(:tags).last.tags","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal [tag], TaggedPost.eager_load(:tags).last.tags","+      end","+    end","+  end","+","+  def test_has_many_through_polymorphic_with_rewhere_keeps_the_polymorphic_type","     post = TaggedPost.create!(title: \"Tagged\", body: \"Post\")","-    tag = post.tags.create!(name: \"Tag\")","-    assert_equal [tag], TaggedPost.preload(:tags).last.tags","-    assert_equal [tag], TaggedPost.eager_load(:tags).last.tags","+    tag = Tag.create!(name: \"Tag\")","+    Tagging.create!(taggable: post, tag: tag).update_columns(taggable_type: \"TaggedPost\")","+","+    assert_empty post.tags","+    assert_empty TaggedPost.preload(:tags).find(post.id).tags","+    assert_empty TaggedPost.eager_load(:tags).find(post.id).tags","   end"," ","   def test_has_many_through_polymorphic_with_primary_key_option"],"additions":24,"deletions":3,"truncated":false},{"path":"activerecord/test/cases/associations/has_many_through_disable_joins_associations_test.rb","lines":["@@ -1,6 +1,7 @@"," # frozen_string_literal: true"," "," require \"cases/helper\"","+require \"active_support/core_ext/object/with\""," "," require \"models/post\""," require \"models/author\"","@@ -47,6 +48,41 @@ def test_through_association_scope_cannot_unscope_foreign_key","     assert_equal comments, @author.no_joins_comments_on_posts_with_unscoped_where.sort_by(&:id)","   end"," ","+  def test_through_association_scope_unscoping_foreign_key_is_deprecated_when_association_scope_keeps_owner_conditions_is_false","+    message = /conditions tying the records to the owner on `posts.author_id`/","+","+    ActiveRecord.with(association_scope_keeps_owner_conditions: false) do","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal Comment.count, @author.comments_on_posts_with_unscoped_where.size","+      end","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_equal Comment.count, @author.no_joins_comments_on_posts_with_unscoped_where.size","+      end","+    end","+  end","+","+  def test_through_association_scope_cannot_unscope_polymorphic_type","+    post = posts(:welcome)","+    Tagging.create!(taggable: post, tag: Tag.create!(name: \"Other\")).update_columns(taggable_type: \"Other\")","+    Tagging.create!(taggable: post, tag: Tag.create!(name: \"Post\"))","+","+    assert_equal post.tags.sort_by(&:id), post.no_joins_tags_unscoping_type.sort_by(&:id)","+    assert_not_includes post.no_joins_tags_unscoping_type.map(&:name), \"Other\"","+  end","+","+  def test_through_association_scope_unscoping_polymorphic_type_is_deprecated_when_association_scope_keeps_owner_conditions_is_false","+    post = posts(:welcome)","+    other_tag = Tag.create!(name: \"Other\")","+    Tagging.create!(taggable: post, tag: other_tag).update_columns(taggable_type: \"Other\")","+    message = /conditions tying the records to the owner on `taggings.taggable_type`/","+","+    ActiveRecord.with(association_scope_keeps_owner_conditions: false) do","+      assert_deprecated(message, ActiveRecord.deprecator) do","+        assert_includes post.no_joins_tags_unscoping_type, other_tag","+      end","+    end","+  end","+","   def test_counting_on_disable_joins_through","     assert_equal @author.comments.count, @author.no_joins_comments.count","     assert_queries_count(2) { @author.no_joins_comments.count }"],"additions":36,"deletions":0,"truncated":false},{"path":"activerecord/test/models/post.rb","lines":["@@ -180,6 +180,8 @@ def add_joins_and_select","   has_many :authors_using_author_id, through: :categorizations_using_author_id, source: :author"," ","   has_many :taggings_using_author_id, primary_key: :author_id, as: :taggable, class_name: \"Tagging\"","+  has_many :taggings_unscoping_type, -> { unscope(where: :taggable_type) }, as: :taggable, class_name: \"Tagging\"","+  has_many :no_joins_tags_unscoping_type, through: :taggings_unscoping_type, source: :tag, disable_joins: true","   has_many :tags_using_author_id, through: :taggings_using_author_id, source: :tag"," ","   has_many :images, as: :imageable, foreign_key: :imageable_identifier, foreign_type: :imageable_class"],"additions":2,"deletions":0,"truncated":false},{"path":"activerecord/test/support/global_config.rb","lines":["@@ -18,6 +18,7 @@ def self.apply","       ActiveRecord::Base.automatically_invert_plural_associations = true","       ActiveRecord.belongs_to_required_validates_foreign_key = false","       ActiveRecord.raise_on_missing_required_finder_order_columns = true","+      ActiveRecord.association_scope_keeps_owner_conditions = true","     end","   end"," end"],"additions":1,"deletions":0,"truncated":false},{"path":"guides/source/configuring.md","lines":["@@ -68,6 +68,7 @@ Below are the default values associated with each target version. In cases of co"," - [`config.action_dispatch.strict_accept_header`](#config-action-dispatch-strict-accept-header): `true`"," - [`config.action_view.erb_implementation`](#config-action-view-erb-implementation): `:herb`"," - [`config.active_job.enqueue_after_transaction_commit`](#config-active-job-enqueue-after-transaction-commit): `true`","+- [`config.active_record.association_scope_keeps_owner_conditions`](#config-active-record-association-scope-keeps-owner-conditions): `true`"," - [`config.active_record.postgresql_adapter_decode_bytea`](#config-active-record-postgresql-adapter-decode-bytea): `true`"," - [`config.active_record.postgresql_adapter_decode_money`](#config-active-record-postgresql-adapter-decode-money): `true`"," - [`config.active_storage.analyze`](#config-active-storage-analyze): `:immediately`","@@ -1709,6 +1710,34 @@ ActiveRecord::Base.connection"," ```"," "," ","+The default value depends on the `config.load_defaults` target version:","+","+| Starting with version | The default value is |","+| --------------------- | -------------------- |","+| (original)            | `false`              |","+| 8.2                   | `true`               |","+","+#### `config.active_record.association_scope_keeps_owner_conditions`","+","+Specifies whether an association always applies the conditions tying the","+records to the owner: the foreign key, and the polymorphic type of an `as:`","+association. When `true`, an association scope can't remove or replace them","+with `unscope(where: ...)`, `unscope(:where)`, or `rewhere`, when loading the","+association, preloading, eager loading, and joining it.","+","+```ruby","+class Car < ActiveRecord::Base","+  has_many :all_bulbs, -> { unscope(:where) }, class_name: \"Bulb\"","+end","+","+car.all_bulbs","+# true:  SELECT \"bulbs\".* FROM \"bulbs\" WHERE \"bulbs\".\"car_id\" = ?","+# false: SELECT \"bulbs\".* FROM \"bulbs\"","+```","+","+When `false`, the scope removes or replaces them as before, and a deprecation","+warning is shown.","+"," The default value depends on the `config.load_defaults` target version:"," "," | Starting with version | The default value is |"],"additions":29,"deletions":0,"truncated":false},{"path":"railties/lib/rails/application/configuration.rb","lines":["@@ -395,6 +395,7 @@ def load_defaults(target_version)","           if respond_to?(:active_record)","             active_record.postgresql_adapter_decode_bytea = true","             active_record.postgresql_adapter_decode_money = true","+            active_record.association_scope_keeps_owner_conditions = true","           end"," ","           if respond_to?(:active_storage)"],"additions":1,"deletions":0,"truncated":false},{"path":"railties/lib/rails/generators/rails/app/templates/config/initializers/new_framework_defaults_8_2.rb.tt","lines":["@@ -72,6 +72,20 @@"," # Rails.application.config.active_record.postgresql_adapter_decode_bytea = true"," # Rails.application.config.active_record.postgresql_adapter_decode_money = true"," ","+###","+# Always apply the conditions tying the records of an association to the owner (the foreign key,","+# and the polymorphic type of an `as:` association), even when the association scope removes or","+# replaces them with `unscope(where: ...)`, `unscope(:where)`, or `rewhere`.","+#","+# Example:","+#   has_many :all_bulbs, -> { unscope(:where) }, class_name: \"Bulb\"","+#","+#   car.all_bulbs # => SELECT \"bulbs\".* FROM \"bulbs\" WHERE \"bulbs\".\"car_id\" = ?","+#","+# When false, the association scope can remove them, which is deprecated.","+#++","+# Rails.application.config.active_record.association_scope_keeps_owner_conditions = true","+"," ###"," # Analyze attachments immediately, making metadata available for validations."," #"],"additions":14,"deletions":0,"truncated":false},{"path":"railties/test/application/configuration_test.rb","lines":["@@ -5269,6 +5269,31 @@ def new(app); self; end","       end","     end"," ","+    test \"association_scope_keeps_owner_conditions is true in new apps\" do","+      app \"development\"","+","+      assert_equal true, ActiveRecord.association_scope_keeps_owner_conditions","+    end","+","+    test \"association_scope_keeps_owner_conditions is false in upgrading apps\" do","+      remove_from_config '.*config\\.load_defaults.*\\n'","+      add_to_config 'config.load_defaults \"8.1\"'","+      app \"development\"","+","+      assert_equal false, ActiveRecord.association_scope_keeps_owner_conditions","+    end","+","+    test \"association_scope_keeps_owner_conditions can be set via framework defaults\" do","+      remove_from_config '.*config\\.load_defaults.*\\n'","+      add_to_config 'config.load_defaults \"8.1\"'","+      app_file \"config/initializers/new_framework_defaults_8_2.rb\", <<-RUBY","+        Rails.application.config.active_record.association_scope_keeps_owner_conditions = true","+      RUBY","+      app \"development\"","+","+      assert_equal true, ActiveRecord.association_scope_keeps_owner_conditions","+    end","+","     test \"run_after_transaction_callbacks_in_order_defined is true in new apps\" do","       app \"development\""," ",""],"additions":25,"deletions":0,"truncated":false}],"additions":325,"deletions":31,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-11-17T18:46:32.420210+00:00"}