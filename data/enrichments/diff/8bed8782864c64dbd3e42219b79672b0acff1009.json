spose()` only","+ * stops polling; an already in-flight fetch can still complete and write shared state. Revoking","+ * the gate makes that delegate's storage/telemetry writes no-ops so it cannot overwrite the","+ * memento (`VSCode.ABExp.FeatureData`) or `abexp.assignmentcontext` after being replaced.","+ */","+export class RevocationGate {","+\tprivate _revoked = false;","+\tget isRevoked(): boolean {","+\t\treturn this._revoked;","+\t}","+\trevoke(): void {","+\t\tthis._revoked = true;","+\t}","+}","+","+/** Wraps a memento so writes are dropped once the gate is revoked (reads still pass through). */","+class RevocableMemento implements vscode.Memento {","+\tconstructor(","+\t\tprivate readonly _actual: vscode.Memento,","+\t\tprivate readonly _gate: RevocationGate,","+\t) { }","+","+\tkeys(): readonly string[] {","+\t\treturn this._actual.keys();","+\t}","+","+\tget<T>(key: string): T | undefined;","+\tget<T>(key: string, defaultValue: T): T;","+\tget<T>(key: string, defaultValue?: T): T | undefined {","+\t\treturn defaultValue === undefined ? this._actual.get<T>(key) : this._actual.get<T>(key, defaultValue);","+\t}","+","+\t// eslint-disable-next-line @typescript-eslint/no-explicit-any","+\tupdate(key: string, value: any): Thenable<void> {","+\t\tif (this._gate.isRevoked) {","+\t\t\treturn Promise.resolve();","+\t\t}","+\t\treturn this._actual.update(key, value);","+\t}","+}","+","+export type TASClientDelegateFn = (memento: vscode.Memento, userInfoStore: UserInfoStore, gate: RevocationGate) => ITASExperimentationService;"," "," export class BaseExperimentationService extends Disposable implements IExperimentationService {"," ","@@ -124,9 +166,16 @@ export class BaseExperimentationService extends Disposable implements IExperimen"," \tprivate readonly _refreshTimer = this._register(new IntervalTimer());"," \tprivate readonly _previouslyReadTreatments = new Map<string, boolean | string | number | undefined>();"," ","-\tprotected readonly _delegate: ITASExperimentationService;","+\tprotected _delegate: ITASExperimentationService;"," \tprotected readonly _userInfoStore: UserInfoStore;"," ","+\t/** Disposes the current delegate (stopping its polling); auto-disposes the previous one on replacement. */","+\tprivate readonly _delegateDisposable = this._register(new MutableDisposable());","+","+\tprivate readonly _delegateFn: TASClientDelegateFn;","+\tprivate readonly _globalState: vscode.Memento;","+\tprivate _delegateGeneration = 0;","+"," \tprotected _onDidTreatmentsChange = this._register(new Emitter<TreatmentsChangeEvent>());"," \treadonly onDidTreatmentsChange = this._onDidTreatmentsChange.event;"," ","@@ -155,10 +204,41 @@ export class BaseExperimentationService extends Disposable implements IExperimen"," \t\t\tthis._signalTreatmentsChangeEvent();"," \t\t}, 60 * 60 * 1000);"," ","-\t\tthis._delegate = delegateFn(context.globalState, this._userInfoStore);","-\t\tthis._delegate.initialFetch.then(() => {","+\t\tthis._delegateFn = delegateFn;","+\t\tthis._globalState = context.globalState;","+\t\tthis._delegate = this._createDelegate();","+\t}","+","+\tprivate _createDelegate(): ITASExperimentationService {","+\t\tconst generation = ++this._delegateGeneration;","+\t\tconst gate = new RevocationGate();","+\t\tconst memento = new RevocableMemento(this._globalState, gate);","+\t\tconst delegate = this._delegateFn(memento, this._userInfoStore, gate);","+\t\t// Revoke this generation's storage/telemetry writes and stop its polling when it is","+\t\t// superseded (a newer delegate is assigned) or the service is disposed, so a still","+\t\t// in-flight fetch cannot overwrite the shared memento / assignment context afterwards.","+\t\tthis._delegateDisposable.value = toDisposable(() => {","+\t\t\tgate.revoke();","+\t\t\tdelegate.dispose();","+\t\t});","+\t\tdelegate.initialFetch.then(() => {","+\t\t\tif (generation !== this._delegateGeneration || this._store.isDisposed) {","+\t\t\t\treturn; // superseded by a newer delegate, or the service was disposed","+\t\t\t}"," \t\t\tthis._logService.trace(`[BaseExperimentationService] Initial fetch completed`);","+\t\t\t// A replacement delegate (e.g. once the assignments endpoint arrives) may carry","+\t\t\t// different assignments; announce any changes so experiment-based config updates.","+\t\t\tthis._signalTreatmentsChangeEvent();"," \t\t});","+\t\treturn delegate;","+\t}","+","+\t/**","+\t * Creates a fresh delegate, disposing the previous one (stopping its polling). Used","+\t * when inputs captured at delegate-creation time (e.g. the assignments endpoint) change.","+\t */","+\tprotected recreateDelegate(): void {","+\t\tthis._delegate = this._createDelegate();"," \t}"," "," \tprivate _signalTreatmentsChangeEvent = () => {"],"additions":85,"deletions":5,"truncated":false},{"path":"extensions/copilot/src/platform/telemetry/test/node/experimentation.spec.ts","lines":["@@ -4,16 +4,21 @@","  *--------------------------------------------------------------------------------------------*/"," "," import { beforeAll, beforeEach, describe, expect, it } from 'vitest';","+import type * as vscode from 'vscode';"," import { IExperimentationService as ITASExperimentationService } from 'vscode-tas-client';","+import { mock } from '../../../../util/common/test/simpleMock';","+import { Event } from '../../../../util/vs/base/common/event';"," import { IInstantiationService } from '../../../../util/vs/platform/instantiation/common/instantiation';"," import { CopilotToken, createTestExtendedTokenInfo } from '../../../authentication/common/copilotToken';"," import { ICopilotTokenStore } from '../../../authentication/common/copilotTokenStore';"," import { IConfigurationService } from '../../../configuration/common/configurationService';"," import { IVSCodeExtensionContext } from '../../../extContext/common/extensionContext';"," import { ILogService } from '../../../log/common/logService';","+import { FetchOptions, HeadersImpl, IFetcherService, Response } from '../../../networking/common/fetcherService';"," import { createPlatformServices, ITestingServicesAccessor } from '../../../test/node/services';"," import { TreatmentsChangeEvent } from '../../common/nullExperimentationService';","-import { BaseExperimentationService, TASClientDelegateFn, UserInfoStore } from '../../node/baseExperimentationService';","+import { createTasFetch } from '../../vscode-node/tasFetch';","+import { BaseExperimentationService, RevocationGate, TASClientDelegateFn, UserInfoStore } from '../../node/baseExperimentationService';"," "," "," function toExpectedTreatment(name: string, org: string | undefined, sku: string | undefined): string | undefined {","@@ -45,6 +50,31 @@ class TestExperimentationService extends BaseExperimentationService {"," \t}"," }"," ","+/** Captures the memento + revocation gate handed to each delegate generation. */","+class RevocationTestExperimentationService extends BaseExperimentationService {","+\tpublic readonly captured: { memento: vscode.Memento; gate: RevocationGate }[];","+","+\tconstructor(","+\t\t@IVSCodeExtensionContext extensionContext: IVSCodeExtensionContext,","+\t\t@ICopilotTokenStore tokenStore: ICopilotTokenStore,","+\t\t@IConfigurationService configurationService: IConfigurationService,","+\t\t@ILogService logService: ILogService","+\t) {","+\t\tconst captured: { memento: vscode.Memento; gate: RevocationGate }[] = [];","+\t\tconst delegateFn: TASClientDelegateFn = (memento, userInfoStore, gate) => {","+\t\t\tcaptured.push({ memento, gate });","+\t\t\treturn new MockTASExperimentationService(userInfoStore);","+\t\t};","+","+\t\tsuper(delegateFn, extensionContext, tokenStore, configurationService, logService);","+\t\tthis.captured = captured;","+\t}","+","+\trecreate(): void {","+\t\tthis.recreateDelegate();","+\t}","+}","+"," class MockTASExperimentationService implements ITASExperimentationService {"," \tprivate _initializePromise: Promise<void> | undefined;"," \tprivate _initialFetch: Promise<void> | undefined;","@@ -127,6 +157,8 @@ class MockTASExperimentationService implements ITASExperimentationService {"," \t\tthis.refreshCallCount = 0;"," \t\tthis.treatmentRequests = [];"," \t}","+","+\tdispose(): void { }"," }"," "," describe('ExP Service Tests', () => {","@@ -167,6 +199,27 @@ describe('ExP Service Tests', () => {"," \t\t});"," \t};"," ","+\tit('revokes a superseded delegate so its late writes are dropped', async () => {","+\t\tconst svc = accessor.get(IInstantiationService).createInstance(RevocationTestExperimentationService);","+\t\tconst globalState = accessor.get(IVSCodeExtensionContext).globalState;","+","+\t\texpect(svc.captured.length).toBe(1);","+\t\tsvc.recreate();","+\t\texpect(svc.captured.length).toBe(2);","+","+\t\tconst [gen1, gen2] = svc.captured;","+\t\texpect(gen1.gate.isRevoked).toBe(true);","+\t\texpect(gen2.gate.isRevoked).toBe(false);","+","+\t\t// A superseded (revoked) generation's writes are dropped; the current one's land.","+\t\tawait gen1.memento.update('exp.revoke.test', 'stale');","+\t\texpect(globalState.get('exp.revoke.test')).toBeUndefined();","+\t\tawait gen2.memento.update('exp.revoke.test', 'fresh');","+\t\texpect(globalState.get('exp.revoke.test')).toBe('fresh');","+","+\t\tsvc.dispose();","+\t});","+"," \tit('should return treatments based on copilot token', async () => {"," \t\tawait expService.hasTreatments();"," \t\tlet expectedTreatment = toExpectedTreatment('a', undefined, undefined);","@@ -637,3 +690,174 @@ describe('ExP Service Tests', () => {"," \t\tawait extensionContext.globalState.update(UserInfoStore.IS_SN_STORAGE_KEY, undefined);"," \t});"," });","+","+/**","+ * A delegate whose initial fetch is completed manually, so tests can control ordering, and","+ * that records when it is disposed. Used to exercise endpoint-driven delegate recreation.","+ */","+class ControllableMockTAS implements ITASExperimentationService {","+\tpublic disposed = false;","+\tprivate _resolveInitialFetch!: () => void;","+\tprivate readonly _treatments = new Map<string, boolean | number | string>();","+","+\treadonly initializePromise = Promise.resolve();","+\treadonly initialFetch: Promise<void>;","+","+\tconstructor() {","+\t\tthis.initialFetch = new Promise<void>(resolve => { this._resolveInitialFetch = resolve; });","+\t}","+","+\tcompleteInitialFetch(): void {","+\t\tthis._resolveInitialFetch();","+\t}","+","+\tsetTreatment(name: string, value: boolean | number | string): void {","+\t\tthis._treatments.set(name, value);","+\t}","+","+\tisFlightEnabled(): boolean { throw new Error('Method not implemented.'); }","+\tisCachedFlightEnabled(): Promise<boolean> { throw new Error('Method not implemented.'); }","+\tisFlightEnabledAsync(): Promise<boolean> { throw new Error('Method not implemented.'); }","+\tgetTreatmentVariable<T extends boolean | number | string>(_configId: string, name: string): T | undefined {","+\t\treturn this._treatments.get(name) as T | undefined;","+\t}","+\tgetTreatmentVariableAsync<T extends boolean | number | string>(configId: string, name: string): Promise<T | undefined> {","+\t\treturn Promise.resolve(this.getTreatmentVariable<T>(configId, name));","+\t}","+\tdispose(): void { this.disposed = true; }","+}","+","+class RecreatableExperimentationService extends BaseExperimentationService {","+\tpublic readonly delegates: ControllableMockTAS[];","+","+\tconstructor(","+\t\t@IVSCodeExtensionContext extensionContext: IVSCodeExtensionContext,","+\t\t@ICopilotTokenStore tokenStore: ICopilotTokenStore,","+\t\t@IConfigurationService configurationService: IConfigurationService,","+\t\t@ILogService logService: ILogService","+\t) {","+\t\tconst delegates: ControllableMockTAS[] = [];","+\t\tconst delegateFn: TASClientDelegateFn = () => {","+\t\t\tconst delegate = new ControllableMockTAS();","+\t\t\tdelegates.push(delegate);","+\t\t\treturn delegate;","+\t\t};","+","+\t\tsuper(delegateFn, extensionContext, tokenStore, configurationService, logService);","+\t\tthis.delegates = delegates;","+\t}","+","+\ttriggerRecreate(): void {","+\t\tthis.recreateDelegate();","+\t}","+}","+","+describe('ExP Service delegate recreation', () => {","+\tlet accessor: ITestingServicesAccessor;","+","+\tbeforeAll(() => {","+\t\tconst testingServiceCollection = createPlatformServices();","+\t\taccessor = testingServiceCollection.createTestingAccessor();","+\t});","+","+\tconst create = () => accessor.get(IInstantiationService).createInstance(RecreatableExperimentationService);","+","+\tit('disposes the previous delegate and switches to the new one on recreation', () => {","+\t\tconst service = create();","+\t\texpect(service.delegates.length).toBe(1);","+\t\tconst first = service.delegates[0];","+","+\t\tservice.triggerRecreate();","+","+\t\texpect(service.delegates.length).toBe(2);","+\t\tconst second = service.delegates[1];","+\t\texpect(first.disposed).toBe(true);","+\t\texpect(second.disposed).toBe(false);","+","+\t\t// The final delegate is disposed together with the service.","+\t\tservice.dispose();","+\t\texpect(second.disposed).toBe(true);","+\t});","+","+\tit('ignores a superseded delegate\\'s initial fetch completion', async () => {","+\t\tconst service = create();","+\t\tconst first = service.delegates[0];","+","+\t\t// Seed a previously-read treatment so a change would be detectable if (wrongly) signaled.","+\t\tfirst.setTreatment('x', 'v0');","+\t\texpect(service.getTreatmentVariable<string>('x')).toBe('v0');","+","+\t\tservice.triggerRecreate();","+\t\tservice.delegates[1].setTreatment('x', 'v1');","+","+\t\tlet fired = false;","+\t\tservice.onDidTreatmentsChange(() => { fired = true; });","+","+\t\t// The superseded (first) delegate completing its fetch must not signal changes.","+\t\tfirst.completeInitialFetch();","+\t\tawait new Promise(resolve => setTimeout(resolve, 0));","+\t\texpect(fired).toBe(false);","+","+\t\tservice.dispose();","+\t});","+","+\tit('signals treatment changes after the replacement delegate completes its initial fetch', async () => {","+\t\tc