: add test for other logical types","@@ -177,6 +180,76 @@ public void testNestedUnsignedInt32TypeWithNativeReader()","     }","   }"," ","+  @Test","+  public void testReadersPreserveUnsignedInt64Bits()","+      throws IOException {","+    MessageType schema = MessageTypeParser.parseMessageType(","+        \"message m { required int64 value (INTEGER(64, false)); }\");","+    File dataFile = new File(FileUtils.getTempDirectory(), \"unsigned-int64-\" + System.nanoTime() + \".parquet\");","+    try {","+      try (ParquetWriter<Group> writer = ExampleParquetWriter.builder(new Path(dataFile.getAbsolutePath()))","+          .withType(schema).build()) {","+        SimpleGroupFactory groups = new SimpleGroupFactory(schema);","+        for (long value : new long[]{-1L, 7L, Long.MIN_VALUE}) {","+          writer.write(groups.newGroup().append(\"value\", value));","+        }","+      }","+      for (RecordReader reader : List.of(new ParquetNativeRecordReader(), new ParquetAvroRecordReader())) {","+        try (reader) {","+          reader.init(dataFile, null, null);","+          for (long value : new long[]{-1L, 7L, Long.MIN_VALUE}) {","+            assertTrue(reader.hasNext());","+            assertEquals(reader.next(new GenericRow()).getValue(\"value\"), value);","+          }","+          assertFalse(reader.hasNext());","+        }","+      }","+    } finally {","+      FileUtils.deleteQuietly(dataFile);","+    }","+  }","+","+  @Test","+  public void testReadersAdvancePastRejectedInt96()","+      throws IOException {","+    MessageType schema = MessageTypeParser.parseMessageType(\"message m { required int96 value; }\");","+    File dataFile = new File(FileUtils.getTempDirectory(), \"rejected-int96-\" + System.nanoTime() + \".parquet\");","+    try {","+      try (ParquetWriter<Group> writer = ExampleParquetWriter.builder(new Path(dataFile.getAbsolutePath()))","+          .withType(schema).build()) {","+        SimpleGroupFactory groups = new SimpleGroupFactory(schema);"