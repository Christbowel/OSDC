edInput](issues/TaintedInput.md)","  - [TaintedLdap](issues/TaintedLdap.md)","@@ -387,6 +388,7 @@ These issues are only reported when their corresponding feature is enabled (e.g.","  - [TaintedUnserialize](issues/TaintedUnserialize.md)","  - [TaintedUrlComponent](issues/TaintedUrlComponent.md)","  - [TaintedUrlPath](issues/TaintedUrlPath.md)","+ - [TaintedUrlScheme](issues/TaintedUrlScheme.md)","  - [TaintedUserSecret](issues/TaintedUserSecret.md)","  - [TaintedXpath](issues/TaintedXpath.md)","  - [UncaughtThrowInGlobalScope](issues/UncaughtThrowInGlobalScope.md)"],"additions":2,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues.md","lines":["@@ -260,6 +260,7 @@","  - [TaintedFile](issues/TaintedFile.md)","  - [TaintedHeader](issues/TaintedHeader.md)","  - [TaintedHtml](issues/TaintedHtml.md)","+ - [TaintedHtmlAttribute](issues/TaintedHtmlAttribute.md)","  - [TaintedInclude](issues/TaintedInclude.md)","  - [TaintedInput](issues/TaintedInput.md)","  - [TaintedLdap](issues/TaintedLdap.md)","@@ -275,6 +276,7 @@","  - [TaintedUnserialize](issues/TaintedUnserialize.md)","  - [TaintedUrlComponent](issues/TaintedUrlComponent.md)","  - [TaintedUrlPath](issues/TaintedUrlPath.md)","+ - [TaintedUrlScheme](issues/TaintedUrlScheme.md)","  - [TaintedUserSecret](issues/TaintedUserSecret.md)","  - [TaintedXpath](issues/TaintedXpath.md)","  - [TooFewArguments](issues/TooFewArguments.md)"],"additions":2,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/TaintedHtmlAttribute.md","lines":["@@ -0,0 +1,31 @@","+# TaintedHtmlAttribute","+","+This is a **security issue**, reported by [security analysis](https://psalm.dev/docs/security_analysis/): it flags a potential vulnerability.","+","+Emitted when user-controlled input is placed in an HTML attribute value without quotes. HTML escaping","+(`htmlspecialchars()`, `htmlentities()`) leaves spaces, and a space ends an unquoted value, so the input can add","+attributes of its own.","+","+## Example","+","+```php","+<?php","+","+$src = (string) $_GET['src'];","+","+echo '<img src=' . htmlspecialchars($src, ENT_QUOTES) . '>'; // TaintedHtmlAttribute: `x onerror=alert(1)` adds an event handler","+echo '<img src=\"' . htmlspecialchars($src, ENT_QUOTES) . '\">'; // no issue","+echo '<img src=' . rawurlencode($src) . '>'; // no issue: URL encoding leaves no spaces","+```","+","+Psalm sees where the value is from the markup before it in the same expression (a concatenation, an interpolated","+string or a `sprintf()` format). It doesn't check a template such as `<img src=<?= htmlspecialchars($src) ?>>`.","+","+## Mitigations","+","+- Put the attribute value in quotes, and escape it with `ENT_QUOTES`.","+","+## Further resources","+","+- [OWASP Cross Site Scripting Prevention Cheat Sheet](https://cheatsheetseries.owasp.org/cheatsheets/Cross_Site_Scripting_Prevention_Cheat_Sheet.html)","+- [CWE-79](https://cwe.mitre.org/data/definitions/79.html)"],"additions":31,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/TaintedSql.md","lines":["@@ -25,6 +25,19 @@ class A {"," }"," ```"," ","+`mysqli::real_escape_string()` and the other escaping functions of the database extensions only protect a value","+inside SQL quotes:","+","+```php","+<?php","+","+function findUser(mysqli $db): void {","+    $id = (string) $_GET['id'];","+    $db->query(\"SELECT * FROM users WHERE id = '\" . $db->real_escape_string($id) . \"'\"); // no issue","+    $db->query('SELECT * FROM users WHERE id = ' . $db->real_escape_string($id)); // TaintedSql: `1 OR 1=1` needs no quotes","+}","+```","+"," ## Mitigations"," "," - Use prepared statements with bound parameters (`$pdo->prepare('… where user_id = ?')`) instead of concatenating values."],"additions":13,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/TaintedUrlScheme.md","lines":["@@ -0,0 +1,44 @@","+# TaintedUrlScheme","+","+This is a **security issue**, reported by [security analysis](https://psalm.dev/docs/security_analysis/): it flags a potential vulnerability.","+","+Emitted when user-controlled input starts a URL that a browser runs as script with the `javascript:` scheme: the","+`href` of a link (`<a>`, `<area>`), the `action` of a form, the `formaction` of a button, or the `src` of a frame.","+HTML escaping leaves the `:` of `javascript:alert(1)`, so the code runs when the link is clicked, the form is sent or","+the frame loads.","+","+Psalm doesn't report other attributes: browsers don't run a `javascript:` URL in the `src` of an image, a script or a","+stylesheet.","+","+## Example","+","+```php","+<?php","+","+$url = (string) $_GET['url'];","+","+echo '<a href=\"' . htmlspecialchars($url, ENT_QUOTES) . '\">Profile</a>'; // TaintedUrlScheme","+echo '<a href=\"/users/' . htmlspecialchars($url, ENT_QUOTES) . '\">Profile</a>'; // no issue: the URL starts with a path","+echo '<img src=\"' . htmlspecialchars($url, ENT_QUOTES) . '\">'; // no issue: images don't run `javascript:` URLs","+","+if (preg_match('~^https?://~', $url)) {","+    echo '<a href=\"' . htmlspecialchars($url, ENT_QUOTES) . '\">Profile</a>'; // no issue","+}","+```","+","+Psalm sees where the value is from the markup before it in the same expression (a concatenation, an interpolated","+string or a `sprintf()` format). It doesn't check a template such as `<a href=\"<?= htmlspecialchars($url) ?>\">`.","+","+## Mitigations","+","+- Start the URL with a literal path or origin: `'/users/' . rawurlencode($name)`, `'https://example.com/' . ...`.","+- Check the scheme before output, with `str_starts_with($url, 'https://')` or `preg_match('~^https?://~', $url)`.","+  Psalm understands both. `filter_var($url, FILTER_VALIDATE_URL)` isn't enough: it accepts","+  `javascript://comment%0Aalert(1)`.","+- If Psalm can't see your check (for example, comparing `parse_url($url, PHP_URL_SCHEME)` with a list), put it in a","+  function that returns the URL, and annotate the function with `@psalm-taint-escape url_scheme`.","+","+## Further resources","+","+- [OWASP Cross Site Scripting Prevention Cheat Sheet](https://cheatsheetseries.owasp.org/cheatsheets/Cross_Site_Scripting_Prevention_Cheat_Sheet.html)","+- [CWE-79](https://cwe.mitre.org/data/definitions/79.html)"],"additions":44,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/AssertionFinder.php","lines":["@@ -32,6 +32,7 @@"," use Psalm\\Internal\\Analyzer\\StatementsAnalyzer;"," use Psalm\\Internal\\Analyzer\\TraitAnalyzer;"," use Psalm\\Internal\\Codebase\\InternalCallMapHandler;","+use Psalm\\Internal\\Codebase\\StringContext;"," use Psalm\\Internal\\Codebase\\TaintValidations;"," use Psalm\\Internal\\Codebase\\UrlHosts;"," use Psalm\\Internal\\MethodIdentifier;","@@ -119,6 +120,7 @@"," use Psalm\\Type\\Atomic\\TTemplateValueOf;"," use Psalm\\Type\\Atomic\\TTraitString;"," use Psalm\\Type\\Atomic\\TTrue;","+use Psalm\\Type\\TaintKind;"," use Psalm\\Type\\Union;"," use UnexpectedValueException;"," ","@@ -941,6 +943,14 @@ public static function processFunctionCall(","             && isset($expr->getArgs()[1])","         ) {","             return self::getPatternMatchAssertions($expr, $source, $this_class_name);","+        } elseif ($source instanceof StatementsAnalyzer","+            && $function_id === 'str_starts_with'","+            && isset($expr->getArgs()[1])","+        ) {","+            return [","+                ...self::processCustomAssertion($expr, $this_class_name, $source),","+                ...self::getUrlStartAssertions($expr, $source, $this_class_name),","+            ];","         } else {","             return self::processCustomAssertion($expr, $this_class_name, $source);","         }","@@ -3183,7 +3193,8 @@ private static function getPatternMatchAssertions(","         }"," ","         $pattern = $pattern_type->getSingleStringLiteral()->value;","-        $removed_taints = PatternCharacters::getTaintsRemoved($pattern);","+        $removed_taints = PatternCharacters::getTaintsRe