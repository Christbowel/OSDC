{"id":"a6500b589a7375212f6aa7ccda350283dbdbbdc1","axis":"silent","repo":"elastic/elasticsearch","sha":"a6500b589a7375212f6aa7ccda350283dbdbbdc1","parsed":{"files":[{"path":"x-pack/plugin/esql/qa/server/multi-clusters/src/csvSpecTest/java/org/elasticsearch/xpack/esql/ccq/AbstractMultiClusterSpecIT.java","lines":["@@ -48,6 +48,7 @@"," import static org.elasticsearch.xpack.esql.CsvTestsDataLoader.ENRICH_POLICIES;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.APPROXIMATION_LOOKUP_JOIN_V2;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.COMPLETION;","+import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.DENSE_VECTOR_COMMAND;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.DENSE_VECTOR_EQUALITY;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.EMBEDDING_FUNCTION;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.ENABLE_FORK_FOR_REMOTE_INDICES_V2;","@@ -105,7 +106,8 @@ public abstract class AbstractMultiClusterSpecIT extends EsqlSpecTestCase {","         RERANK.capabilityName(),","         COMPLETION.capabilityName(),","         TEXT_EMBEDDING_FUNCTION.capabilityName(),","-        EMBEDDING_FUNCTION.capabilityName()","+        EMBEDDING_FUNCTION.capabilityName(),","+        DENSE_VECTOR_COMMAND.capabilityName()","     );"," ","     private static final RequestOptions DEPRECATED_DEFAULT_METRIC_WARNING_HANDLER = RequestOptions.DEFAULT.toBuilder()"],"additions":3,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/qa/server/src/main/java/org/elasticsearch/xpack/esql/qa/rest/EsqlSpecTestCase.java","lines":["@@ -71,6 +71,7 @@"," import static org.elasticsearch.xpack.esql.EsqlTestUtils.classpathResource;"," import static org.elasticsearch.xpack.esql.EsqlTestUtils.classpathResources;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.COMPLETION;","+import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.DENSE_VECTOR_COMMAND;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.EMBEDDING_FUNCTION;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.KNN_FUNCTION_V5;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.RERANK;","@@ -354,7 +355,8 @@ protected boolean requiresInferenceEndpointOnLocalCluster() {","             COMPLETION.capabilityName(),","             KNN_FUNCTION_V5.capabilityName(),","             TEXT_EMBEDDING_FUNCTION.capabilityName(),","-            EMBEDDING_FUNCTION.capabilityName()","+            EMBEDDING_FUNCTION.capabilityName(),","+            DENSE_VECTOR_COMMAND.capabilityName()","         ).anyMatch(testCase.requiredCapabilities::contains);","     }"," "],"additions":3,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/qa/testFixtures/src/main/resources/dense_vector_command.csv-spec","lines":["@@ -0,0 +1,195 @@","+// Functional tests for the DENSE_VECTOR command.","+//","+// The \"test_dense_inference\" TEXT_EMBEDDING mock returns a deterministic float vector derived from the","+// input string's hashCode, so the embeddings asserted below are stable (they match the values used in","+// text-embedding.csv-spec). The DENSE_VECTOR command appends a generated \"<field>_dense_vector\" column","+// (dense_vector type) after the existing columns, one per embedded text/keyword field.","+","+dense_vector command on a single field using a ROW source operator","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+ROW input = \"Who is Victor Hugo?\"","+| DENSE_VECTOR input WITH { \"inference_id\" : \"test_dense_inference\" }","+;","+","+input:keyword       | input_dense_vector:dense_vector","+Who is Victor Hugo? | [56.0, 50.0, 48.0]","+;","+","+// The core use case: embed a NON-constant, per-row indexed text field. Each row's publisher value is","+// embedded at runtime into its own vector (distinct values -> distinct vectors), which is exactly what","+// DENSE_VECTOR adds over the TEXT_EMBEDDING function (which only embeds a constant/expression once).","+dense_vector command embeds a non-constant indexed field per row","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+FROM books","+| WHERE book_no IN (\"2924\", \"7381\", \"7670\")","+| DENSE_VECTOR publisher WITH { \"inference_id\" : \"test_dense_inference\" }","+| SORT book_no","+| KEEP book_no, publisher, publisher_dense_vector","+;","+","+book_no:keyword | publisher:text      | publisher_dense_vector:dense_vector","+2924            | Oxford Paperbacks   | [45.0, 56.0, 48.0]","+7381            | Red Wheel/Weiser    | [45.0, 53.0, 56.0]","+7670            | Courier Corporation | [45.0, 49.0, 55.0]","+;","+","+dense_vector command on multiple fields","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+ROW a = \"be excellent to each other\", b = \"live long and prosper\"","+| DENSE_VECTOR a, b WITH { \"inference_id\" : \"test_dense_inference\" }","+;","+","+a:keyword                  | b:keyword             | a_dense_vector:dense_vector | b_dense_vector:dense_vector","+be excellent to each other | live long and prosper | [45.0, 55.0, 54.0]          | [50.0, 57.0, 56.0]","+;","+","+dense_vector command on a single explicitly-named field","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+ROW title = \"Who is Victor Hugo?\"","+| DENSE_VECTOR title WITH { \"inference_id\" : \"test_dense_inference\" }","+;","+","+title:keyword       | title_dense_vector:dense_vector","+Who is Victor Hugo? | [56.0, 50.0, 48.0]","+;","+","+dense_vector command with timeout option","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+required_capability: inference_accept_timeout","+","+ROW input = \"Who is Victor Hugo?\"","+| DENSE_VECTOR input WITH { \"inference_id\" : \"test_dense_inference\", \"timeout\" : \"30s\" }","+;","+","+input:keyword       | input_dense_vector:dense_vector","+Who is Victor Hugo? | [56.0, 50.0, 48.0]","+;","+","+dense_vector command on multiple non-constant fields from an index","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+FROM books","+| WHERE book_no IN (\"7480\", \"8605\")","+| DENSE_VECTOR title, publisher WITH { \"inference_id\" : \"test_dense_inference\" }","+| SORT book_no","+| KEEP book_no, title, publisher, title_dense_vector, publisher_dense_vector","+;","+","+book_no:keyword | title:text | publisher:text | title_dense_vector:dense_vector | publisher_dense_vector:dense_vector","+7480            | The Hobbit | Mariner Books  | [50.0, 49.0, 48.0]              | [45.0, 49.0, 53.0]","+8605            | Dead Souls | Vintage        | [45.0, 49.0, 53.0]              | [50.0, 49.0, 50.0]","+;","+","+","+dense_vector command on a single explicitly-named field over an index","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+FROM books","+| WHERE book_no IN (\"7480\", \"8605\")","+| DENSE_VECTOR title WITH { \"inference_id\" : \"test_dense_inference\" }","+| SORT book_no","+| KEEP book_no, title, title_dense_vector","+;","+","+book_no:keyword | title:text | title_dense_vector:dense_vector","+7480            | The Hobbit | [50.0, 49.0, 48.0]","+8605            | Dead Souls | [45.0, 49.0, 53.0]","+;","+","+dense_vector command with timeout option over an index","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+required_capability: inference_accept_timeout","+","+FROM books","+| WHERE book_no IN (\"2924\", \"7381\", \"7670\")","+| DENSE_VECTOR publisher WITH { \"inference_id\" : \"test_dense_inference\", \"timeout\" : \"30s\" }","+| SORT book_no","+| KEEP book_no, publisher, publisher_dense_vector","+;","+","+book_no:keyword | publisher:text      | publisher_dense_vector:dense_vector","+2924            | Oxford Paperbacks   | [45.0, 56.0, 48.0]","+7381            | Red Wheel/Weiser    | [45.0, 53.0, 56.0]","+7670            | Courier Corporation | [45.0, 49.0, 55.0]","+;","+","+","+dense_vector command on a null value produces a null vector","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+FROM books","+| WHERE book_no IN (\"7480\", \"8605\")","+| EVAL maybe_title = CASE(book_no == \"7480\", title)","+| DENSE_VECTOR maybe_title WITH { \"inference_id\" : \"test_dense_inference\" }","+| SORT book_no","+| KEEP book_no, maybe_title, maybe_title_dense_vector","+;","+","+book_no:keyword | maybe_title:keyword | maybe_title_dense_vector:dense_vector","+7480            | The Hobbit          | [50.0, 49.0, 48.0]","+8605            | null                | null","+;","+","+","+// For multi-valued fields only the FIRST value is embedded ","+dense_vector command on a multi-valued field embeds the first value","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+FROM books","+| WHERE book_no == \"2924\"","+| EVAL sorted_author = MV_SORT(author)","+| DENSE_VECTOR sorted_author WITH { \"inference_id\" : \"test_dense_inference\" }","+| KEEP book_no, sorted_author, sorted_author_dense_vector","+;","+","+book_no:keyword | sorted_author:keyword                                | sorted_author_dense_vector:dense_vector","+2924            | [Alan Myers, Fyodor Dostoevsky, W. J. Leatherbarrow] | [45.0, 52.0, 51.0]","+;","+","+// Assert the generated column is a usable dense_vector.","+dense_vector command output consumed by v_cosine","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+required_capability: vector_similarity_functions_pushdown","+","+FROM books","+| WHERE book_no == \"2924\"","+| DENSE_VECTOR publisher WITH { \"inference_id\" : \"test_dense_inference\" }","+| EVAL sim = v_cosine(publisher_dense_vector, publisher_dense_vector)","+| KEEP book_no, sim","+;","+","+book_no:keyword | sim:double","+2924            | 1.0","+;","+","+// Assert a generated column shadows an existing same-named column (last wins).","+// Case (a) - two inputs producing the same name - can't happen; see AnalyzerTests dotted-name tests.","+dense_vector command generated column shadows an existing same-named column","+required_capability: dense_vector_command","+required_capability: dense_vector_field_type_released","+","+FROM books","+| WHERE book_no == \"2924\"","+| EVAL publisher_dense_vector = \"placeholder\"","+| DENSE_VECTOR publisher WITH { \"inference_id\" : \"test_dense_inference\" }","+| KEEP book_no, publisher_dense_vector","+;","+","+book_no:keyword | publisher_dense_vector:dense_vector","+2924            | [45.0, 56.0, 48.0]","+;"],"additions":195,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/antlr/EsqlBaseLexer.g4","lines":["@@ -66,6 +66,7 @@ options {","  */"," import ChangePoint,","        Dedup,","+       DenseVector,","        Enrich,","        Explain,","        Expression,"],"additions":1,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/antlr/EsqlBaseLexer.tokens","lines":["@@ -3,262 +3,263 @@ MULTILINE_COMMENT=2"," WS=3"," CHANGE_POINT=4"," DEDUP=5","-ENRICH=6","-DEV_EXPLAIN=7","-COMPLETION=8","-DISSECT=9","-EVAL=10","-GROK=11","-LIMIT=12","-RERANK=13","-ROW=14","-SAMPLE=15","-SORT=16","-STATS=17","-WHERE=18","-URI_PARTS=19","-METRICS_INFO=20","-REGISTERED_DOMAIN=21","-TS_INFO=22","-USER_AGENT=23","-TS_COLLAPSE=24","-IP_LOCATION=25","-FROM=26","-TS=27","-DEV_EXTERNAL=28","-FORK=29","-FUSE=30","-DEV_HIGHLIGHT=31","-INLINE=32","-INLINESTATS=33","-JOIN_LOOKUP=34","-DEV_JOIN_FULL=35","-DEV_JOIN_LEFT=36","-DEV_JOIN_RIGHT=37","-DEV_LOOKUP=38","-MMR=39","-MV_EXPAND=40","-DROP=41","-KEEP=42","-PROMQL=43","-RENAME=44","-SET=45","-SHOW=4