ras.h\""," #include \"xla/codegen/xtile/codegen/emitter_helpers.h\""," #include \"xla/hlo/ir/hlo_casting_utils.h\"","@@ -766,6 +767,28 @@ CodegenDecision IsTritonSupportedDot(","   return CodegenDecision::Allow();"," }"," ","+bool IsBlock16ScaledOperand(const Shape& operand, const Shape& scale,","+                            absl::Span<const int64_t> contracting_dims) {","+  if (!xtile::IsTritonDotScaledOperandType(operand.element_type()) ||","+      scale.dimensions().size() != operand.dimensions().size() ||","+      contracting_dims.size() != 1) {","+    return false;","+  }","+  int64_t k_dim = contracting_dims[0];","+  int64_t scale_k = scale.dimensions(k_dim);","+  return scale_k > 0 && scale_k * 16 == operand.dimensions(k_dim);","+}","+","+bool HasBlock16ScaledOperand(const HloScaledDotInstruction& dot) {","+  const DotDimensionNumbers& dnums = dot.dot_dimension_numbers();","+  return IsBlock16ScaledOperand(dot.operand(0)->shape(),","+                                dot.operand(2)->shape(),","+                                dnums.lhs_contracting_dimensions()) ||","+         IsBlock16ScaledOperand(dot.operand(1)->shape(),","+                                dot.operand(3)->shape(),","+                                dnums.rhs_contracting_dimensions());","+}","+"," CodegenDecision IsTritonSupportedScaledDot(","     const HloScaledDotInstruction& dot,","     const se::GpuComputeCapability& gpu_version) {","@@ -829,6 +852,12 @@ CodegenDecision IsTritonSupportedScaledDot(","         absl::StrCat(\"RHS scale is ignored for operand type \",","                      PrimitiveType_Name(rhs_type), \" but is not all ones.\"));","   }","+  if (const auto* cc = gpu_version.cuda_compute_capability();","+      cc && cc->IsAtLeastBlackwell() && HasBlock16ScaledOperand(dot)) {","+    return CodegenDecision::Forbid(","+        \"Triton's Blackwell MMA lowering does not support block-16 scaled \"","+        \"dots.\");","+  }","   return CodegenDecision::Allow();"," }"," "],"additions":29,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/support_test.cc","lines":["@@ -2635,6 +2635,53 @@ ENTRY triton_computation {","       *dot, se::GpuComputeCapability(se::CudaComputeCapability::Volta())));"," }"," ","+TEST_F(HloHardwareIndependentTestBase, ScaledDotBlock16IsRejectedOnBlackwell) {","+  struct TestCase {","+    absl::string_view lhs;","+    absl::string_view rhs;","+    absl::string_view lhs_scale;","+    absl::string_view rhs_scale;","+    bool allowed_on_blackwell;","+  };","+  constexpr TestCase kCases[] = {","+      {\"f4e2m1fn[128,256]\", \"f4e2m1fn[128,256]\", \"f8e4m3fn[128,16]\",","+       \"f8e8m0fnu[128,8]\", /*allowed_on_blackwell=*/false},","+      {\"f4e2m1fn[128,256]\", \"f4e2m1fn[128,256]\", \"f8e8m0fnu[128,8]\",","+       \"f8e4m3fn[128,16]\", /*allowed_on_blackwell=*/false},","+      {\"f8e4m3fn[128,256]\", \"f8e4m3fn[128,256]\", \"f8e8m0fnu[128,16]\",","+       \"f8e8m0fnu[128,8]\", /*allowed_on_blackwell=*/false},","+      {\"f4e2m1fn[128,256]\", \"f4e2m1fn[128,256]\", \"f8e8m0fnu[128,8]\",","+       \"f8e8m0fnu[128,8]\", /*allowed_on_blackwell=*/true},","+  };","+  for (const TestCase& tc : kCases) {","+    std::string hlo =","+        absl::Substitute(R\"hlo(","+      ENTRY e {","+        lhs = $0 parameter(0)","+        rhs = $1 parameter(1)","+        lhs_scale = $2 parameter(2)","+        rhs_scale = $3 parameter(3)","+        ROOT dot = bf16[128,128] scaled-dot(lhs, rhs, lhs_scale, rhs_scale),","+            lhs_contracting_dims={1}, rhs_contracting_dims={1}","+      })hlo\",","+                         tc.lhs, tc.rhs, tc.lhs_scale, tc.rhs_scale);","+    ASSERT_OK_AND_ASSIGN(std::unique_ptr<VerifiedHloModule> module,","+                         ParseAndReturnVerifiedModule(hlo));","+    const HloInstruction* dot = module->entry_computation()->root_instruction();","+    CodegenDecision blackwell = IsTritonSupportedInstruction(","+        *dot, se::GpuComputeCapability(se::CudaComputeCapability::Blackwell()));","+    EXPECT_EQ(blackwell.IsAllowed(), tc.allowed_on_blackwell) << hlo;","+    if (!tc.allowed_on_blackwell) {","+      EXPECT_THAT(blackwell.Explain(), HasSubstr(\"block-16\"));","+    }","+    EXPECT_TRUE(","+        IsTritonSupportedInstruction(","+            *dot, se::GpuComputeCapability(se::CudaComputeCapability::Hopper()))","+            .IsAllowed())","+        << hlo;","+  }","+}","+"," // Triton cannot lower F8E4M3FN conversions before sm89."," class ScaledDotF8E4M3FNTest","     : public SupportTest,"],"additions":47,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/scaled_dot_device_test.cc","lines":["@@ -16,7 +16,6 @@ limitations under the License."," #include <cmath>"," #include <cstddef>"," #include <cstdint>","-#include <cstdlib>"," #include <memory>"," #include <optional>"," #include <ostream>","@@ -83,7 +82,6 @@ namespace {"," "," using ::absl_testing::IsOk;"," using ::absl_testing::IsOkAndHolds;","-using ::testing::HasSubstr;"," using ::xla::xtile::BlockLevelFusionConfig;"," using ::xla::xtile::BlockLevelParameters;"," ","@@ -460,29 +458,20 @@ ENTRY e {","          {\"$output_shape\", absl::StrCat(m, \",\", n)},","          {\"$lhs_contracting_dim\", lhs_k_minor ? \"1\" : \"0\"},","          {\"$rhs_contracting_dim\", rhs_k_minor ? \"1\" : \"0\"}});","-    ASSERT_OK_AND_ASSIGN(auto optimized_module, GetOptimizedModule(hlo));","+    ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> optimized_module,","+                         GetOptimizedModule(hlo));","     HloComputation* scaled_dot_computation = GetFirstComputationWithInstruction(","         *optimized_module, HloOpcode::kScaledDot);","-    ASSERT_NE(scaled_dot_computation, nullptr);","-    EXPECT_THAT(CreateTritonIrAndFileCheckForDot(*scaled_dot_computation,","-                                                 \"CHECK: tt.dot_scaled\"),","-                IsOk());","-    ASSERT_OK_AND_ASSIGN(std::vector<Literal> argume