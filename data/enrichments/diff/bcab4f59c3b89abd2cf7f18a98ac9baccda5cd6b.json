tions under the License."," #include \"riegeli/bytes/string_reader.h\""," #include \"riegeli/bytes/string_writer.h\""," #include \"xla/backends/autotuner/autotuning.pb.h\"","+#include \"xla/backends/autotuner/backends.pb.h\""," #include \"xla/backends/autotuner/codegen_backend.h\""," #include \"xla/backends/autotuner/in_memory_store.h\""," #include \"xla/backends/cpu/nanort/nanort_client.h\"","@@ -78,6 +79,7 @@ limitations under the License."," #include \"xla/backends/gpu/transforms/algebraic_simplifier.h\""," #include \"xla/backends/gpu/transforms/algorithm_checker.h\""," #include \"xla/backends/gpu/transforms/async_wrapper.h\"","+#include \"xla/backends/gpu/transforms/block_scaling_rewriter.h\""," #include \"xla/backends/gpu/transforms/collectives/all_gather_combiner.h\""," #include \"xla/backends/gpu/transforms/collectives/all_gather_dynamic_slice_simplifier.h\""," #include \"xla/backends/gpu/transforms/collectives/all_gather_major_dimension_rewriter.h\"","@@ -261,6 +263,7 @@ limitations under the License."," #include \"xla/service/cpu/executable.pb.h\""," #include \"xla/service/cpu_gpu_shape_verifier.h\""," #include \"xla/service/debug/unstable_reduction_detector.h\"","+#include \"xla/service/decision.h\""," #include \"xla/service/device_assignment.h\""," #include \"xla/service/dump.h\""," #include \"xla/service/dynamic_dimension_inference.h\"","@@ -275,6 +278,7 @@ limitations under the License."," #include \"xla/service/gpu/compile_module_to_llvm_ir.h\""," #include \"xla/service/gpu/conv_layout_normalization.h\""," #include \"xla/service/gpu/cublas_cudnn.h\"","+#include \"xla/service/gpu/cudnn_support_utils.h\""," #include \"xla/service/gpu/early_exit_compilation_result.h\""," #include \"xla/service/gpu/export_hlo.h\""," #include \"xla/service/gpu/flag_utils.h\"","@@ -766,9 +770,98 @@ bool BackendConfigDeviceTypeIsHost(HloInstruction* instr) {","   return backend_config->device_type() == DEVICE_TYPE_HOST;"," }"," ","+// Mirrors the backend filtering in ConfigAssignerPass::GetEnabledBackends.","+bool IsAutotuneBackendAllowed(const DebugOptions& debug_options,","+                              autotuner::Backend backend) {","+  const auto& backends = debug_options.xla_gpu_experimental_autotune_backends();","+  return backends.empty() || absl::c_linear_search(backends, backend);","+}","+","+Decision IsTritonScaledDotSupported(","+    const HloScaledDotInstruction& scaled_dot,","+    const DebugOptions& debug_options,","+    const se::GpuComputeCapability& gpu_version) {","+  if (!debug_options.xla_gpu_experimental_scaled_dot_with_triton()) {","+    return Decision::Forbid(\"Triton scaled dot is disabled by debug options.\");","+  }","+  // On ROCm, HIPBLASLT and HIPBLASLT_FISSION also tune the Triton GEMM fusion,","+  // so the TRITON backend filters below must not decompose the scaled dot.","+  // TODO: b/578351695 - Replace with a separate hipBLASLt allow-check.","+  if (gpu_version.IsRocm()) {","+    return IsTritonSupportedInstruction(scaled_dot, gpu_version);","+  }","+  if (!IsAutotuneBackendAllowed(debug_options, autotuner::Backend::TRITON)) {","+    return Decision::Forbid(\"TRITON backend is excluded by autotune_backends.\");","+  }","+  if (RequireDeterminism(scaled_dot.GetModule()->config()) &&","+      debug_options.xla_gpu_experimental_deterministic_ops_triton() ==","+          DebugOptions::DETERMINISTIC_OPS_TRITON_MODE_OFF) {","+    return Decision::Forbid(\"Triton is disabled in deterministic mode.\");","+  }","+  return IsTritonSupportedInstruction(scaled_dot, gpu_version);","+}","+","+Decision IsCudnnScaledDotSupported(const HloScaledDotInstruction& scaled_dot,","+                                   const DebugOptions& debug_options,","+                                   const GpuTargetConfig& gpu_target_config,","+                                   bool is_deviceless) {","+  if (debug_options.xla_gpu_experimental_disable_binary_libraries()) {","+    return Decision::Forbid(\"Binary libraries are disabled.\");","+  }","+  if (!IsAutotuneBackendAllowed(debug_options,","+                                autotuner::Backend::CUDNN_FISSION)) {","+    return Decision::Forbid(","+        \"CUDNN_FISSION backend is excluded by autotune_backends.\");","+  }","+  if (is_deviceless) {","+    Decision deviceless(","+        ResolveCudnnSupport(debug_options, /*stream_exec=*/nullptr,","+                            gpu_target_config.device_description.dnn_version())","+            .status());","+    if (deviceless.IsForbidden()) {","+      return deviceless;","+    }","+  }","+  if (!CudnnScaledDotHelper::IsAvailable(","+          gpu_target_config.device_description)) {","+    return Decision::Forbid(\"cuDNN scaled dot is not available on target.\");","+  }","+  if (!CudnnScaledDotHelper::IsSupportedPreLayout(&scaled_dot)) {","+    return Decision::Forbid(","+        \"unsupported scaled-dot types, shapes, or dimensions.\");","+  }","+  return Decision::Allow();","+}","+","+Decision IsScaledDotSupportedByBackend(const HloInstruction* instr,","+                                       const GpuTargetConfig& gpu_target_config,","+                                       bool is_deviceless) {","+  const auto& scaled_dot = *Cast<HloScaledDotInstruction>(instr);","+  const DebugOptions& debug_options =","+      instr->GetModule()->config().debug_options();","+  const se::GpuComputeCapability& gpu_version =","+      gpu_target_config.device_description.gpu_compute_capability();","+  // Both Triton and cuDNN are reached via the __triton_gemm fusion that","+  // GemmFusion creates for the autotuner.","+  if (!IsTritonGemmEnabled(debug_options, gpu_version)) {","+    return Decision::Forbid(\"GemmFusion is disabled.\");","+  }","+  Decision triton =","+      IsTritonScaledDotSupported(scaled_dot, debug_options, gpu_version);","+  if (triton.IsAllowed()) {","+    return triton;","+  }","+  Decision cudnn = IsCudnnScaledDotSupported(scaled_dot, debug_options,","+                                             gpu_target_config, is_deviceless);","+  if (cudnn.IsAllowed()) {","+    return cudnn;","+  }","+  return Decision::Forbid(","+      absl::StrCat(\"Triton: \", triton.Explain(), \"; cuDNN: \", cudnn.Explain()));","+}","+"," absl::Status RunOptimizationPasses(","-    const GpuCompiler& compiler, HloModule* hlo_module,","-    const GpuTargetConfig& gpu_target_config,","+    HloModule* hlo_module, const GpuTargetConfig& gpu_target_config,","     const AlgebraicSimplifierOptions& layout_insensitive_algsimp_opts,","     bool is_deviceless, bool is_early_exit_with_layouts,","     CompilationStats* compilation_stats) {","@@ -786,10 +879,15 @@ absl::Status RunOptimizationPasses(","       gpu_version,","       se::dnn::VersionInfo(gpu_target_config.device_description.dnn_version()),","       gpu_target_config.device_description.runtime_version());","-  pipeline.AddPass<ScaledDotRewriter>([&compiler, &gpu_target_config](","-                                          const HloInstruction* instr) {","-    return !compiler.IsScaledDotSupportedByBackend(instr, gpu_target_config);","-  });","+  pipeline.AddPass<ScaledDotRewriter>(","+      [&gpu_target_config, is_deviceless](const HloInstruction* instr) {","+        Decision d = IsScaledDotSupportedByBackend(instr, gpu_target_config,","+                                                   is_deviceless);","+        if (d.IsForbidden()) {","+          VLOG(3) << \"Decomposing \" << instr->name() << \": \" << d.Explain();","+        }","+        return d.IsForbidden();","+      });","   pipeline.AddPass<BatchedGatherScatterNormalizer>();","   if (debug_options.xla_gpu_multi_streamed_windowed_einsum()) {"],"additions":104,"deletions":6,"truncated":false}],"additions":308,"deletions":61,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-05T16:28:13.026564+00:00"}