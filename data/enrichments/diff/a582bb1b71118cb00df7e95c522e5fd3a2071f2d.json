{"id":"a582bb1b71118cb00df7e95c522e5fd3a2071f2d","axis":"silent","repo":"pnpm/pnpm","sha":"a582bb1b71118cb00df7e95c522e5fd3a2071f2d","parsed":{"files":[{"path":".changeset/store-prune-keeps-copied-packages.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/lockfile.fs\": patch","+\"@pnpm/store.controller\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm store prune` now keeps the packages that a project still uses when pnpm copied or cloned them into `node_modules`. These include patched packages, built packages, and every package installed with `packageImportMethod: copy`. Before, the prune removed them, and the next install downloaded them again [#7192](https://github.com/pnpm/pnpm/issues/7192)."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -10173,6 +10173,9 @@ importers:"," ","   pnpm11/store/controller:","     dependencies:","+      '@pnpm/constants':","+        specifier: workspace:*","+        version: link:../../core/constants","       '@pnpm/crypto.hash':","         specifier: workspace:*","         version: link:../../crypto/hash","@@ -10185,9 +10188,21 @@ importers:","       '@pnpm/hooks.types':","         specifier: workspace:*","         version: link:../../hooks/types","+      '@pnpm/installing.modules-yaml':","+        specifier: workspace:*","+        version: link:../../installing/modules-yaml","       '@pnpm/installing.package-requester':","         specifier: workspace:*","         version: link:../../installing/package-requester","+      '@pnpm/lockfile.fs':","+        specifier: workspace:*","+        version: link:../../lockfile/fs","+      '@pnpm/lockfile.types':","+        specifier: workspace:*","+        version: link:../../lockfile/types","+      '@pnpm/lockfile.utils':","+        specifier: workspace:*","+        version: link:../../lockfile/utils","       '@pnpm/resolving.resolver-base':","         specifier: workspace:*","         version: link:../../resolving/resolver-base","@@ -10209,9 +10224,15 @@ importers:","       '@pnpm/worker':","         specifier: workspace:^","         version: link:../../worker","+      '@pnpm/workspace.workspace-manifest-reader':","+        specifier: workspace:*","+        version: link:../../workspace/workspace-manifest-reader","       '@zkochan/rimraf':","         specifier: 'catalog:'","         version: 4.0.0","+      empathic:","+        specifier: 'catalog:'","+        version: 2.1.0","       is-subdir:","         specifier: 'catalog:'","         version: 2.0.1"],"additions":21,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/store.rs","lines":["@@ -7,6 +7,7 @@"," //! any project."," "," mod add;","+mod in_use_files;"," mod status;"," "," use crate::{","@@ -80,7 +81,11 @@ fn prune(config: &Config) -> miette::Result<()> {","     .into_iter()","     .flatten()","     .collect();","-    config.store_dir.prune(&config.cache_dir, &protected_dirs).wrap_err(\"pruning store\")?;","+    config.store_dir","+        .prune_keeping(&config.cache_dir, &protected_dirs, || {","+            in_use_files::in_use_files(&config.store_dir)","+        })","+        .wrap_err(\"pruning store\")?;","     remove_orphaned_private_engine_installs(config)?;","     Ok(())"," }"],"additions":6,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/store/in_use_files.rs","lines":["@@ -0,0 +1,178 @@","+//! The store files of the packages that registered projects installed.","+//!","+//! A package imported by copy or clone, such as a patched or built one, has","+//! no hard link to the store, so `store prune` needs this list to keep it.","+","+use pnpm_config::workspace_root_or;","+use pnpm_deps_restorer::{binary_store_index_key, store_index_key_for_resolution};","+use pnpm_fs::lexical_normalize;","+use pnpm_lockfile::{Lockfile, LockfileResolution, PackageKey};","+use pnpm_modules_yaml::{Host, read_modules_layout};","+use pnpm_store_dir::{","+    CafsFileInfo, PackageFilesIndex, PruneError, StoreDir, StoreIndex, StoreIndexError,","+    decode_package_files_index, get_registered_projects,","+};","+use pnpm_workspace::read_workspace_manifest_document;","+use serde::Deserialize;","+use std::{","+    collections::HashSet,","+    io, iter,","+    path::{Path, PathBuf},","+};","+","+/// Every file of the store index rows of the packages in each registered","+/// project's current lockfile, including the files of every side-effects","+/// entry. A project without a current lockfile, a project whose lockfile","+/// version this pnpm does not support, and a package without a row add","+/// nothing. A registry error keeps its own code, and any other","+/// failure is [`PruneError::InUseFiles`].","+pub(super) fn in_use_files(store_dir: &StoreDir) -> Result<HashSet<PathBuf>, PruneError> {","+    if !StoreIndex::exists(store_dir.root()) {","+        return Ok(HashSet::new());","+    }","+    let mut keys = HashSet::new();","+    for project in get_registered_projects(store_dir).map_err(PruneError::ListProjects)? {","+        // The registry joins a relative link target without normalizing it.","+        let project = lexical_normalize(&project);","+        for lockfile in load_installed_lockfiles(&project).map_err(PruneError::InUseFiles)? {","+            keys.extend(package_index_keys(&lockfile).map_err(PruneError::InUseFiles)?);","+        }","+    }","+    if keys.is_empty() {","+        return Ok(HashSet::new());","+    }","+    let keys: Vec<String> = keys.into_iter().collect();","+    let rows = read_rows(store_dir, &keys)","+        .map_err(|error| PruneError::InUseFiles(io::Error::other(error)))?;","+    Ok(rows","+        .iter()","+        .flat_map(row_files)","+        .filter_map(|file| store_dir.cas_file_path_by_mode(&file.digest, file.mode))","+        .collect())","+}","+","+/// Fails on an undecodable row, which [`StoreIndex::get_many`] skips,","+/// because skipping it would let the prune remove the row's files.","+fn read_rows(","+    store_dir: &StoreDir,","+    keys: &[String],","+) -> Result<Vec<PackageFilesIndex>, StoreIndexError> {","+    StoreIndex::open_readonly_in(store_dir)?","+        .get_many_raw(keys)?","+        .iter()","+        .map(|(_, bytes)| decode_package_files_index(bytes))","+        .collect()","+}","+","+/// The lockfiles the last install wrote, which record what is installed in","+/// the project.","+///","+/// The install writes the lockfile to `<modulesDir>/.pnpm`, or to the","+/// `virtualStoreDir` that `<modulesDir>/.modules.yaml` records when the","+/// project sets one. Under a global virtual store, that setting names the","+/// shared store and the lockfile stays in `<modulesDir>/.pnpm`. The","+/// manifest does not say which case applies, so the prune reads both.","+fn load_installed_lockfiles(project: &Path) -> io::Result<Vec<Lockfile>> {","+    let modules_dir = project.join(configured_modules_dir(project)?);","+    let default_dir = modules_dir.join(\".pnpm\");","+    let virtual_store_dir = read_modules_layout::<Host>(&modules_dir)","+        .map_err(io::Error::other)?","+        .map(|layout| PathBuf::from(layout.virtual_store_dir))","+        .filter(|dir| *dir != default_dir);","+    let mut lockfiles = Vec::new();","+    for install_state_dir in iter::once(default_dir).chain(virtual_store_dir) {","+        lockfiles.extend(load_installed_lockfile(project, &install_state_dir)?);","+    }","+    Ok(lockfiles)","+}","+","+/// The `modulesDir` that the nearest `pnpm-workspace.yaml` at or above the","+/// project sets, or `node_modules`. A `modulesDir` set only on the command","+/// line, in the environment, in the global config, or in `packageConfigs`","+/// is not seen.","+fn configured_modules_dir(project: &Path) -> io::Result<String> {","+    #[derive(Deserialize)]","+    #[serde(rename_all = \"camelCase\")]","+    struct ModulesDirSetting {","+        modules_dir: Option<String>,","+    }","+    let Some(document) =","+        read_workspace_manifest_document(&workspace_root_or(project)).map_err(io::Error::other)?","+    else {","+        return Ok(\"node_modules\".to_string());","+    };","+    let setting: Option<ModulesDirSetting> = serde_saphyr::from_str(&document.text)","+        .map_err(|error| io::Error::other(format!(\"{}: {error}\", document.path.display())))?;","+    Ok(setting","+        .and_then(|setting| setting.modules_dir)","+        .unwrap_or_else(|| \"node_modules\".to_string()))","+}","+","+/// A lockfile of a version this pnpm cannot read adds nothing, like a","+/// missing one, so one project installed by another pnpm does not stop the","+/// prune. The hard-link check then decides for that project's files.","+fn load_installed_lockfile(","+    project: &Path,","+    install_state_dir: &Path,","+) -> io::Result<Option<Lockfile>> {","+    let error = match Lockfile::load_current_from_install_state_dir(install_state_dir) {","+        Ok(lockfile) => return Ok(lockfile),","+        Err(error) => error,","+    };","+    let lockfile_path = install_state_dir.join(Lockfile::CURRENT_FILE_NAME);","+    if let Ok(Some(version)) = Lockfile::unsupported_version_at(&lockfile_path) {","+        pnpm_diagnostics::eprintln!(","+            \"Skipped {} because it was installed with lockfileVersion {version}, \\","+             which this version of pnpm does not support\",","+            project.display(),","+        );","+        return Ok(None);","+    }","+    Err(io::Error::other(format!(\"{}: {error}\", install_state_dir.display())))","+}","+","+fn package_index_keys(lockfile: &Lockfile) -> io::Result<Vec<String>> {","+    let mut keys = Vec::new();","+    for (key, metadata) in lockfile.packages.iter().flatten() {","+        add_resolution_index_keys(&mut keys, key, &metadata.resolution)?;","+    }","+    Ok(keys)","+}","+","+/// The lockfile does not say which key the install used for:","+/// - a git-hosted package, which has a key for its built and its unbuilt","+///   contents;","+/// - a `Variations` resolution, whose variant depends on the installing","+///   host and its `supportedArchitectures`;","+/// - a runtime, whose row an older install keyed without its manifest.","+fn add_resolution_index_keys(","+    keys: &mut Vec<String>,","+    key: &PackageKey,","+    resolution: &LockfileResolution,","+) -> io::Result<()> {","+    if let LockfileResolution::Variations(variations) = resolution {","+        for variant in &variations.variants {","+            add_resolution_index_keys(keys, key, &variant.resolution)?;","+        }","+        return Ok(());","+    }","+    let pkg_id = key.pkg_id();","+    keys.extend(","+        [true, false]","+            .into_iter()","+            .filter_map(|built| store_index_key_for_resolution(resolution, &pkg_id, built)),","+    );","+    if let LockfileResolution::Binary(binary) = resolution {","+        keys.push(binary_store_index_key(key, binary).map_err(io::Error::other)?);","+    }","+    Ok(())","+}","+","+fn row_files(row: &PackageFilesIndex) -> impl Iterator<Item = &CafsFileInfo> {","+    let side_effects_files = row.side_effects","+        .iter()","+        .flat_map(|side_effects| side_effects.values())","+        .filter_map(|diff| diff.added.as_ref())","+        .flat_map(|added| added.values());","+    row.files.values().chain(side_effects_files)","+}"],"additions":178,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_runtimes.rs","lines":["@@ -13,7 +13,7 @@ use std::{"," };"," use tempfile::TempDir;"," ","-struct RuntimeFixture {","+pub(crate) struct RuntimeFixture {","     name: &'static str,","     version: &'static str,","     archive_mock: mockito::Mock,","@@ -963,7 +963,7 @@ fn assert_runtime_bad_integrity(name: &'static str, version: &'static str) {","     assert!(stderr.contains(\"Integrity check failed\"), \"stderr was:\\n{stderr}\");"," }"," ","-fn prepare_workspace(root: &TempDir, extra_yaml: &str) -> PathBuf {","+pub(crate) fn prepare_workspace(root: &TempDir, extra_yaml: &str) -> PathBuf {","     let workspace = root.path().join(\"workspace\");","     fs::create_dir(&workspace).unwrap();","     fs::write(","@@ -976,7 +976,7 @@ fn prepare_workspace(root: &TempDir, extra_yaml: &str) -> PathBuf {","     workspace"," }"," ","-fn runtime_fixture(","+pub(crate) fn runtime_fixture(","     server: &mut mockito::Server,","     name: &'static str,","     version: &'static str,","@@ -1027,7 +1027,7 @@ fn runtime_fixture(","     }"," }"," ","-fn write_runtime_manifest(workspace: &Path, fixtures: &[RuntimeFixture]) {","+pub(crate) fn write_runtime_manifest(workspace: &Path, fixtures: &[RuntimeFixture]) {","     let dependencies = fixtures","         .iter()","         .map(|fixture| {","@@ -1038,7 +1038,7 @@ fn write_runtime_manifest(workspace: &Path, fixtures: &[RuntimeFixture]) {","         .unwrap();"," }"," ","-fn write_runtime_lockfile(workspace: &Path, fixtures: &[RuntimeFixture]) {","+pub(crate) fn write_runtime_lockfile(workspace: &Path, fixtures: &[RuntimeFixture]) {","     write_runtime_lockfile_for_group(workspace, fixtures, \"dependencies\");"," }"," "],"additions":5,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -192,6 +192,7 @@ mod store;"," mod store_pkg_content_check;"," mod store_placement;"," mod store_project_registry;","+mod store_prune_in_use;"," mod sync_injected_deps_after_scripts;"," mod tar_registry;"," mod tarball_url_dependency;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/store_prune_in_use.rs","lines":["@@ -0,0 +1,436 @@","+//! `pnpm store prune` must keep the store files of every package a","+//! registered project installed, including the packages that pnpm copied","+//! into `node_modules`, which hold no hard link to the store.","+","+use crate::{","+    _utils::enable_gvs_in_workspace_yaml,","+    install_runtimes::{","+        prepare_workspace, runtime_fixture, write_runtime_lockfile, write_runtime_manifest,","+    },","+    patch::MARKER_PATCH,","+};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_graph_hasher::{host_arch, host_platform};","+use pnpm_store_dir::{PackageFilesIndex, StoreDir, StoreIndex};","+use pnpm_testing_utils::{","+    bin::{AddMockedRegistry, CommandTempCwd},","+    command_env::CommandTestExt,","+};","+use pretty_assertions::assert_eq;","+use std::{","+    fs,","+    path::{Path, PathBuf},","+    process::Command,","+};","+","+fn pacquet_at(workspace: &Path) -> Command {","+    Command::cargo_bin(\"pnpm\")","+        .expect(\"find the pnpm binary\")","+        .with_current_dir(workspace)","+        .without_ambient_pnpm_config()","+}","+","+fn write_manifest(workspace: &Path) {","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"dependencies\": {","+                \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\",","+                \"is-positive\": \"1.0.0\",","+            },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+}","+","+fn append_workspace_yaml(workspace: &Path, text: &str) {","+    let path = workspace.join(\"pnpm-workspace.yaml\");","+    let mut yaml = fs::read_to_string(&path).expect(\"read pnpm-workspace.yaml\");","+    if !yaml.ends_with('\\n') {","+        yaml.push('\\n');","+    }","+    yaml.push_str(text);","+    fs::write(&path, yaml).expect(\"write pnpm-workspace.yaml\");","+}","+","+fn sorted_index_keys(store_dir: &StoreDir) -> Vec<String> {","+    let mut keys = StoreIndex::open_readonly_in(store_dir)","+        .expect(\"open the store index\")","+        .keys()","+        .expect(\"read the store index keys\");","+    keys.sort();","+    keys","+}","+","+fn is_positive_row(store_dir: &StoreDir) -> PackageFilesIndex {","+    let index = StoreIndex::open_readonly_in(store_dir).expect(\"open the store index\");","+    let key = index","+        .keys()","+        .expect(\"read the store index keys\")","+        .into_iter()","+        .find(|key| key.ends_with(\"\\tis-positive@1.0.0\"))","+        .expect(\"a store index row for is-positive@1.0.0\");","+    index","+        .get(&key)","+        .expect(\"read the store index row\")","+        .expect(\"the row is present\")","+}","+","+/// Every store file the row names: its base files and the files each","+/// side-effects entry adds.","+fn row_blob_paths(store_dir: &StoreDir, row: &PackageFilesIndex) -> Vec<PathBuf> {","+    let side_effects_files = row.side_effects","+        .iter()","+        .flat_map(|side_effects| side_effects.values())","+        .filter_map(|diff| diff.added.as_ref())","+        .flat_map(|added| added.values());","+    row.files","+        .values()","+        .chain(side_effects_files)","+        .map(|info| {","+            store_dir","+                .cas_file_path_by_mode(&info.digest, info.mode)","+                .expect(\"an index row holds hex digests\")","+        })","+        .collect()","+}","+","+/// Every store file the rows under `keys` name.","+fn blob_paths_of_rows(store_dir: &StoreDir, keys: &[String]) -> Vec<PathBuf> {","+    let index = StoreIndex::open_readonly_in(store_dir).expect(\"open the store index\");","+    keys.iter()","+        .flat_map(|key| {","+            let row = index","+                .get(key)","+                .expect(\"read the store index row\")","+                .expect(\"the row is present\");","+            row_blob_paths(store_dir, &row)","+        })","+        .collect()","+}","+","+fn prune(workspace: &Path) {","+    let output = pacquet_at(workspace)","+        .with_args([\"store\", \"prune\"])","+        .output()","+        .expect(\"run store prune\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    eprintln!(\"STDERR:\\n{stderr}\\n\");","+    assert!(output.status.success(), \"store prune failed: {stderr}\");","+}","+","+/// A patched package gets its own copy of the files even under `hardlink`,","+/// so no store file of it has a hard link outside the store. `hardlink`","+/// keeps every other package linked on each platform, which `auto` does","+/// not do on a copy-on-write filesystem.","+#[test]","+fn store_prune_keeps_the_files_of_a_patched_dependency() {","+    let CommandTempCwd {","+        root: _root, workspace, npmrc_info, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry {","+        mock_instance: _mock_instance,","+        store_dir,","+        ..","+    } = npmrc_info;","+    write_manifest(&workspace);","+    fs::create_dir_all(workspace.join(\"patches\")).expect(\"create the patches dir\");","+    fs::write(workspace.join(\"patches/is-positive@1.0.0.patch\"), MARKER_PATCH)","+        .expect(\"write the patch file\");","+    append_workspace_yaml(","+        &workspace,","+        concat!(","+            \"packageImportMethod: hardlink\\n\",","+            \"patchedDependencies:\\n  is-positive@1.0.0: patches/is-positive@1.0.0.patch\\n\",","+        ),","+    );","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--reporter=silent\"])","+        .assert()","+        .success();","+","+    let store_dir = StoreDir::new(store_dir);","+    let row = is_positive_row(&store_dir);","+    let patched_entries = row.side_effects","+        .as_ref()","+        .map_or(0, |side_effects| {","+            side_effects","+                .keys()","+                .filter(|key| key.contains(\";patch=\"))","+                .count()","+        });","+    assert_eq!(patched_entries, 1, \"the patch must be cached as a side-effects entry\");","+    let blob_paths = row_blob_paths(&store_dir, &row);","+    let keys_before = sorted_index_keys(&store_dir);","+","+    prune(&workspace);","+","+    assert_eq!(sorted_index_keys(&store_dir), keys_before);","+    let missing: Vec<_> = blob_paths","+        .iter()","+        .filter(|path| !path.exists())","+        .collect();","+    assert_eq!(missing, Vec::<&PathBuf>::new(), \"store prune removed files the project uses\");","+}","+","+/// With `packageImportMethod: copy` no store file has a hard link outside","+/// the store, so the hard-link count alone marks every package unused.","+#[test]","+fn store_prune_keeps_every_package_installed_by_copy() {","+    assert_prune_keeps_every_package_installed_by_copy(|_| {}, \"node_modules/.pnpm/lock.yaml\");","+}","+","+#[test]","+fn store_prune_keeps_every_package_installed_by_copy_in_a_custom_virtual_store_dir() {","+    assert_prune_keeps_every_package_installed_by_copy(","+        |workspace| append_workspace_yaml(workspace, \"virtualStoreDir: vs\\n\"),","+        \"vs/lock.yaml\",","+    );","+}","+","+#[test]","+fn store_prune_keeps_every_package_installed_by_copy_in_a_custom_virtual_store_dir_without_a_lockfile()","+ {","+    assert_prune_keeps_every_package_installed_by_copy(","+        |workspace| append_workspace_yaml(workspace, \"virtualStoreDir: vs\\nlockfile: false\\n\"),","+        \"vs/lock.yaml\",","+    );","+}","+","+#[test]","+fn store_prune_keeps_every_package_installed_by_copy_in_a_custom_modules_dir() {","+    assert_prune_keeps_every_package_installed_by_copy(","+        |workspace| append_workspace_yaml(workspace, \"modulesDir: pnpm_modules\\n\"),","+        \"pnpm_modules/.pnpm/lock.yaml\",","+    );","+}","+","+/// The project records the shared store as its `virtualStoreDir`, and the","+/// install keeps the lockfile in `node_modules/.pnpm`.","+#[test]","+fn store_prune_keeps_every_package_installed_by_copy_in_the_global_virtual_store() {","+    assert_prune_keeps_every_package_installed_by_copy(","+        |workspace| enable_gvs_in_workspace_yaml(workspace, \"\"),","+        \"node_modules/.pnpm/lock.yaml\",","+    );","+}","+","+fn assert_prune_keeps_every_package_installed_by_copy(","+    configure: impl FnOnce(&Path),","+    installed_lockfile: &str,","+) {","+    let CommandTempCwd {","+        root: _root, workspace, npmrc_info, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry {","+        mock_instance: _mock_instance,","+        store_dir,","+        ..","+    } = npmrc_info;","+    write_manifest(&workspace);","+    append_workspace_yaml(&workspace, \"packageImportMethod: copy\\n\");","+    configure(&workspace);","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--reporter=silent\"])","+        .assert()","+        .success();","+    assert!(","+        workspace.join(installed_lockfile).is_file(),","+        \"the install must write {installed_lockfile}\",","+    );","+","+    let store_dir = StoreDir::new(store_dir);","+    let keys_before = sorted_index_keys(&store_dir);","+    assert!(keys_before.len() > 1, \"the install must index every package it fetched\");","+    let blob_paths = blob_paths_of_rows(&store_dir, &keys_before);","+","+    prune(&workspace);","+","+    assert_eq!(sorted_index_keys(&store_dir), keys_before);","+    let missing: Vec<_> = blob_paths","+        .iter()","+        .filter(|path| !path.exists())","+        .collect();","+    assert_eq!(missing, Vec::<&PathBuf>::new(), \"store prune removed files the project uses\");","+}","+","+/// The install keys a runtime row by its synthesized manifest as well as","+/// its integrity, and the resolution lists one archive per platform.","+#[test]","+fn store_prune_keeps_a_runtime_installed_by_copy() {","+    let root = tempfile::tempdir().expect(\"create a temp dir\");","+    let workspace = prepare_workspace(&root, \"packageImportMethod: copy\\n\");","+    let mut server = mockito::Server::new();","+    let fixtures = [runtime_fixture(&mut server, \"node\", \"22.0.0\", host_platform(), host_arch())];","+    write_runtime_manifest(&workspace, &fixtures);","+    write_runtime_lockfile(&workspace, &fixtures);","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\", \"--reporter=silent\"])","+        .assert()","+        .success();","+","+    let store_dir = StoreDir::new(r