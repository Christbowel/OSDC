{"id":"e3dc02e56ca6fe836e77d469d34ea2498d1b8f67","axis":"silent","repo":"vllm-project/vllm","sha":"e3dc02e56ca6fe836e77d469d34ea2498d1b8f67","parsed":{"files":[{"path":"docs/features/nixl_connector_compatibility.md","lines":["@@ -97,6 +97,11 @@ By default, a **compatibility hash** is checked during handshake. P and D instan"," - Draft-model `attention_backend` (each instance auto-selects independently; the","   resulting KV block layout is validated at handshake time rather than via the","   compatibility hash)","+- `prefill_context_kv_only` in the speculative config, set on the prefill instance","+  only (DFlash-based drafters such as DSpark, Model Runner V2): its drafter only","+  writes the context K/V the decode instance reads, so it drafts nothing,","+  reserves no lookahead KV slots and, for draft models that support it, frees","+  the draft weights only drafting reads"," "," ### KV cache layout"," "],"additions":5,"deletions":0,"truncated":false},{"path":"tests/v1/spec_decode/test_context_kv_modules.py","lines":["@@ -0,0 +1,109 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"With `prefill_context_kv_only`, a DFlash-based drafter frees the weights","+outside its draft model's `context_kv_modules()`. The context K/V it stores","+must not change.\"\"\"","+","+import pytest","+import torch","+from torch import nn","+","+from vllm.config import KVTransferConfig, set_current_vllm_config","+from vllm.engine.arg_utils import EngineArgs","+from vllm.model_executor.layers.vocab_parallel_embedding import (","+    ParallelLMHead,","+    VocabParallelEmbedding,","+)","+from vllm.platforms import current_platform","+from vllm.v1.worker.gpu.spec_decode import init_speculator","+","+NUM_CONTEXT_TOKENS = 37","+","+","+def _load_speculator(target: str, draft: str, method: str, k: int):","+    vllm_config = EngineArgs(","+        model=target,","+        speculative_config={","+            \"method\": method,","+            \"model\": draft,","+            \"num_speculative_tokens\": k,","+            \"prefill_context_kv_only\": True,","+        },","+        kv_transfer_config=KVTransferConfig(","+            kv_connector=\"ExampleConnector\",","+            kv_role=\"kv_producer\",","+            kv_connector_extra_config={\"shared_storage_path\": \"local_storage\"},","+        ),","+        load_format=\"dummy\",","+        skip_tokenizer_init=True,","+        max_model_len=1024,","+        max_num_seqs=8,","+        enforce_eager=True,","+    ).create_engine_config()","+    model_config = vllm_config.model_config","+    vocab_size = model_config.get_vocab_size()","+    hidden_size = model_config.get_hidden_size()","+    device = torch.device(\"cuda\")","+    with set_current_vllm_config(vllm_config):","+        speculator = init_speculator(vllm_config, device, req_states=None)","+        # Drafts share only the embedding and the LM head with the target.","+        target_model = nn.Module()","+        target_model.model = nn.Module()","+        with device:","+            target_model.model.embed_tokens = VocabParallelEmbedding(","+                vocab_size, hidden_size, params_dtype=model_config.dtype","+            )","+            target_model.lm_head = ParallelLMHead(","+                vocab_size, hidden_size, params_dtype=model_config.dtype","+            )","+        speculator.load_model(target_model)","+    return speculator, target_model","+","+","+@pytest.mark.skipif(not current_platform.is_cuda(), reason=\"CUDA required\")","+@pytest.mark.parametrize(","+    (\"target\", \"draft\", \"method\", \"k\"),","+    [","+        # DFlashQwen3Model's list, which DSpark, DFlash2 and XPress return too.","+        (\"Qwen/Qwen3-8B\", \"z-lab/Qwen3-8B-DFlash-b16\", \"dflash\", 16),","+        # A draft model with its own context K/V path and list.","+        (\"google/gemma-4-12B-it\", \"deepseek-ai/dspark_gemma4_12b_block7\", \"dspark\", 7),","+    ],","+)","+def test_freeing_keeps_context_kv(dist_init, monkeypatch, target, draft, method, k):","+    speculator, target_model = _load_speculator(target, draft, method, k)","+    model = speculator.model","+    attn_layers = model.model._attn_layers","+","+    def context_kv() -> list[torch.Tensor]:","+        written: list[torch.Tensor] = []","+        for attn in attn_layers:","+            monkeypatch.setattr(","+                attn.impl,","+                \"do_kv_cache_update\",","+                lambda layer, key, value, kv_cache, slots: written.extend(","+                    (key.clone(), value.clone())","+                ),","+            )","+        generator = torch.Generator(\"cuda\").manual_seed(0)","+        target_states = torch.randn(","+            NUM_CONTEXT_TOKENS,","+            model.model.fc.input_size,","+            generator=generator,","+            device=\"cuda\",","+            dtype=speculator.dtype,","+        )","+        positions = torch.arange(NUM_CONTEXT_TOKENS, device=\"cuda\")","+        model.precompute_and_store_context_kv(","+            model.combine_hidden_states(target_states), positions, positions","+        )","+        return written","+","+    with torch.inference_mode():","+        before = context_kv()","+        speculator.free_unused_weights(target_model)","+        assert any(param.numel() == 0 for param in model.parameters())","+        after = context_kv()","+","+    assert len(before) == len(after) == 2 * len(attn_layers)","+    assert all(torch.equal(b, a) for b, a in zip(before, after))"],"additions":109,"deletions":0,"truncated":false},{"path":"tests/v1/spec_decode/test_dflash_lookahead.py","lines":["@@ -1,11 +1,13 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+import pytest"," import torch"," "," from tests.v1.core.utils import create_requests"," from vllm.config import (","     CacheConfig,","+    KVTransferConfig,","     ModelConfig,","     ParallelConfig,","     SchedulerConfig,","@@ -28,24 +30,29 @@"," NUM_SPECULATIVE_TOKENS = 3"," "," ","-def _dflash_speculative_config(num_speculative_tokens: int) -> SpeculativeConfig:","+def _dflash_speculative_config(","+    num_speculative_tokens: int, **kwargs","+) -> SpeculativeConfig:","     model_config = ModelConfig(","         model=DFLASH_TARGET_DIR,","         runner=\"generate\",","         max_model_len=100,","         trust_remote_code=True,","     )","+    kwargs.setdefault(\"model\", DFLASH_DRAFT_DIR)","+    kwargs.setdefault(\"method\", \"dflash\")","     return SpeculativeConfig(","         target_model_config=model_config,","         target_parallel_config=ParallelConfig(),","-        model=DFLASH_DRAFT_DIR,","-        method=\"dflash\",","         num_speculative_tokens=num_speculative_tokens,","+        **kwargs,","     )"," "," ","-def _create_dflash_scheduler(num_speculative_tokens: int) -> Scheduler:","-    speculative_config = _dflash_speculative_config(num_speculative_tokens)","+def _create_dflash_scheduler(","+    num_speculative_tokens: int, enable_prefix_caching: bool = False, **kwargs","+) -> Scheduler:","+    speculative_config = _dflash_speculative_config(num_speculative_tokens, **kwargs)","     model_config = speculative_config.target_model_config","     scheduler_config = SchedulerConfig(","         max_num_seqs=16,","@@ -57,14 +64,22 @@ def _create_dflash_scheduler(num_speculative_tokens: int) -> Scheduler:","         block_size=BLOCK_SIZE,","         gpu_memory_utilization=0.9,","         cache_dtype=\"auto\",","-        enable_prefix_caching=False,","+        enable_prefix_caching=enable_prefix_caching,","     )","+    kv_transfer_config = None","+    if speculative_config.prefill_context_kv_only:","+        kv_transfer_config = KVTransferConfig(","+            kv_connector=\"ExampleConnector\",","+            kv_role=\"kv_producer\",","+            kv_connector_extra_config={\"shared_storage_path\": \"local_storage\"},","+        )","     vllm_config = VllmConfig(","         scheduler_config=scheduler_config,","         model_config=model_config,","         cache_config=cache_config,","         parallel_config=ParallelConfig(),","         speculative_config=speculative_config,","+        kv_transfer_config=kv_transfer_config,","     )","     kv_cache_config = KVCacheConfig(","         num_blocks=NUM_BLOCKS,","@@ -110,6 +125,81 @@ def test_dflash_prefill_reserves_lookahead_blocks():","     assert len(output.scheduled_new_reqs[0].block_ids[0]) == 2"," "," ","+@pytest.mark.parametrize(","+    (\"prefill_context_kv_only\", \"num_spec_tokens\", \"num_blocks\"),","+    [(True, 0, 1), (False, NUM_SPECULATIVE_TOKENS, 2)],","+)","+def test_dflash_prefill_context_kv_only_schedules_no_drafts(","+    monkeypatch, prefill_context_kv_only, num_spec_tokens, num_blocks","+):","+    # The drafter only stores its context K/V (MRV2): no drafts, and no","+    # lookahead block past the prompt's.","+    monkeypatch.setenv(\"VLLM_USE_V2_MODEL_RUNNER\", \"1\")","+    scheduler = _create_dflash_scheduler(","+        NUM_SPECULATIVE_TOKENS, prefill_context_kv_only=prefill_context_kv_only","+    )","+    (request,) = create_requests(","+        num_requests=1,","+        num_tokens=BLOCK_SIZE,","+        block_size=BLOCK_SIZE,","+    )","+    scheduler.add_request(request)","+","+    output = scheduler.schedule()","+","+    assert output.num_spec_tokens_to_schedule == num_spec_tokens","+    assert len(output.scheduled_new_reqs[0].block_ids[0]) == num_blocks","+","+","+def test_prefill_context_kv_only_full_prefix_hit_is_not_padded():","+    # A full prefix-cache hit leaves one token to compute. With no drafts to","+    # verify, it isn't padded to 1 + K rows.","+    scheduler = _create_dflash_scheduler(","+        NUM_SPECULATIVE_TOKENS,","+        enable_prefix_caching=True,","+        prefill_context_kv_only=True,","+    )","+    first, second = create_requests(","+        num_requests=2,","+        num_tokens=2 * BLOCK_SIZE + 1,","+        block_size=BLOCK_SIZE,","+        same_prompt=True,","+    )","+    scheduler.add_request(first)","+    scheduler.schedule()","+    scheduler.add_request(second)","+","+    output = scheduler.schedule()","+","+    assert output.num_scheduled_tokens[second.request_id] == 1","+    assert not output.scheduled_spec_decode_tokens","+","+","+def test_prefill_context_kv_only_config():","+    config = _dflash_speculative_config(","+        NUM_SPECULATIVE_TOKENS,","+        prefill_context_kv_only=True,","+        enable_adaptive_verification=True,","+        num_speculative_tokens_per_batch_size=[(1, 16, 1)],","+    )","+    # Nothing is drafted, so the options for verifying drafts are turned off.","+    assert not config.enable_adaptive_verification","+    assert config.num_speculative_tokens_per_batch_size is None","+    assert config.num_speculative_tokens == NUM_SPECULATIVE_TOKENS","+","+    # Only an instance that sends KV has a decode instance to read it.","+    with pytest.raises(ValueError, match=\"produces KV\"):","+        VllmConfig(model_config=config.target_model_config, speculative_config=config)","+","+    with pytest.raises(ValueError, match=\"prefill_context_kv_only is not supported\"):","+        _dflash_speculative_config(","+            NUM_SPECULATIVE_TOKENS,","+            model=None,","+            method=\"ngram\",","+            prefill_context_kv_only=True,","+        )","+","+"," def test_dflash_first_prefill_query_window_fits_allocated_blocks():","     scheduler = _create_dflash_scheduler(NUM_SPECULATIVE_TOKENS)"," "],"additions":96,"deletions":6,"truncated":false},{"path":"tests/v1/spec_decode/test_dflash_prepare_inputs.py","lines":["@@ -122,6 +122,7 @@ class InputsPrepared(Exception):","         max_num_tokens=max_num_tokens,","         max_model_len=128,","         sample_from_anchor=True,","+        context_kv_only=False,","     )","     with (","         patch("],"additions":1,"deletions":0,"truncated":fal