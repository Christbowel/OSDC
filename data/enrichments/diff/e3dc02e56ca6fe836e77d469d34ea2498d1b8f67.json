":["@@ -231,6 +231,12 @@ def _build_fused_kv_buffers(self) -> None:","         self._rms_norm_eps = attn0.q_norm.variance_epsilon","         self._attn_layers = [layer.self_attn.attn for layer in self.layers]"," ","+    def context_kv_modules(self) -> list[nn.Module]:","+        modules: list[nn.Module] = [self.fc, self.hidden_norm, *self._attn_layers]","+        if self._fused_k_weight is None:","+            modules.extend(self._context_k_projs)","+        return modules","+","     def _build_context_kv_buffers(","         self, layers_attn: list[nn.Module], has_bias: bool","     ) -> None:"],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/qwen3_dflash.py","lines":["@@ -655,6 +655,20 @@ def _build_fused_kv_buffers(self) -> None:","         # References to inner Attention layers for direct cache writes","         self._attn_layers = [layer.self_attn.attn for layer in self.layers]"," ","+    def context_kv_modules(self) -> list[nn.Module]:","+        \"\"\"The modules whose weights the context K/V path (`combine_hidden_states`","+        and `precompute_and_store_context_kv`) reads once loaded. A subclass that","+        changes that path must override this.\"\"\"","+        modules: list[nn.Module] = [self.hidden_norm, *self._attn_layers]","+        if self.use_aux_hidden_state:","+            modules.append(self.fc)","+        if self._fused_kv_weight is None:  # e.g. quantized: no fused K/V copy","+            if self._context_kv_proj is not None:","+                modules.append(self._context_kv_proj)","+            else:","+                modules.extend(self._context_qkv_projs)","+        return modules","+","     def _normalize_context_states(self, context_states: torch.Tensor) -> torch.Tensor:","         normed_context_states = torch.empty_like(context_states)","         ops.rms_norm(","@@ -945,6 +959,13 @@ def precompute_and_store_context_kv(","             context_states, context_positions, context_slot_mapping","         )"," ","+    def context_kv_modules(self) -> list[nn.Module]:","+        \"\"\"The modules whose weights `combine_hidden_states` and","+        `precompute_and_store_context_kv` read once loaded. With","+        `SpeculativeConfig.prefill_context_kv_only`, the other draft weights","+        are freed (see `DFlashSpeculator.free_unused_weights`).\"\"\"","+        return self.model.context_kv_modules()","+","     def combine_hidden_states(","         self,","         hidden_states: torch.Tensor,"],"additions":21,"deletions":0,"truncated":false},{"path":"vllm/models/minimax_m3/common/dspark.py","lines":["@@ -353,6 +353,10 @@ def _normalize_context_k(self, all_k: torch.Tensor) -> torch.Tensor:","             [layer.self_attn.k_norm(k) for layer, k in zip(self.layers, all_k)]","         )"," ","+    def context_kv_modules(self) -> list[nn.Module]:","+        k_norms = [layer.self_attn.k_norm for layer in self.layers]","+        return [*super().context_kv_modules(), *k_norms]","+","     def _context_kv_writer(self) -> DSparkContextKVWriter | None:","         \"\"\"The fused context K/V writer, or None where the base path runs.\"\"\"","         if not hasattr(self, \"_ctx_kv_writer\"):"],"additions":4,"deletions":0,"truncated":false},{"path":"vllm/models/muse_spark/common/dspark.py","lines":["@@ -309,6 +309,11 @@ def _build_fused_kv_buffers(self) -> None:","             ):","                 raise ValueError(\"Muse Spark DSpark layers must share KV geometry\")"," ","+    def context_kv_modules(self) -> list[nn.Module]:","+        if self.specialized_draft is not None:","+            return [self]  # its fused context K/V chain may read any weight","+        return [self.fc, self.hidden_norm, *self._context_pre_norms, *self._attn_layers]","+","     def _project_muse_context_kv(self, context_states: torch.Tensor) -> torch.Tensor:","         \"\"\"Apply the two trained Muse input norms, then each layer's K/V map.\"\"\"","         fc_output = self.hidden_norm(context_states