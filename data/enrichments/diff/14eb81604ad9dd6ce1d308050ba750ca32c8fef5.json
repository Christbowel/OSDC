{"id":"14eb81604ad9dd6ce1d308050ba750ca32c8fef5","axis":"silent","repo":"ray-project/ray","sha":"14eb81604ad9dd6ce1d308050ba750ca32c8fef5","parsed":{"files":[{"path":".bazelrc","lines":["@@ -1,9 +1,16 @@","-# Ray resolves external dependencies through WORKSPACE. Bazel 7 defaults to that","-# already, so --enable_workspace is redundant here today; Bazel 8 flipped the","-# default to false and refuses to fetch anything with both switches off, so","-# stating it keeps a newer Bazel able to evaluate this tree.","+# Ray resolves external dependencies through WORKSPACE. Bazel 8 turned","+# --enable_workspace off by default and refuses to fetch anything with both","+# switches off, so state both."," common --noenable_bzlmod"," common --enable_workspace","+# Bazel 8 made a glob() that matches nothing an error. Ray's root BUILD.bazel","+# (and likely third-party BUILD files) glob platform-specific paths that are","+# empty on other platforms. Keep Bazel 7's behaviour until they set allow_empty.","+common --noincompatible_disallow_empty_glob","+# Bazel 8 disallows ctx.resolve_tools, which the 2021 rules_proto_grpc pin","+# (Python/Java proto codegen) still calls. Drop once rules_proto_grpc is","+# replaced.","+common --noincompatible_disallow_ctx_resolve_tools"," "," # Must be first. Enables build:windows, build:linux, build:macos, build:freebsd, build:openbsd"," build --enable_platform_specific_config","@@ -55,6 +62,11 @@ build:clang-cl --cxxopt=\"-std=c++17\""," build:msvc-cl --cxxopt=\"/std:c++17\""," build:windows --cxxopt=\"/std:c++17\""," build:windows --cxxopt=\"/utf-8\"","+# Compile out protobuf's deprecated Arena::CreateMessage shim. GCC 10 (the","+# manylinux2014 devtoolset) warns on the shim's own body in every file that","+# includes arena.h, which -Werror turns into an error. Nothing calls it.","+build --cxxopt=\"-DPROTOBUF_FUTURE_REMOVE_CREATEMESSAGE\"","+build --host_cxxopt=\"-DPROTOBUF_FUTURE_REMOVE_CREATEMESSAGE\""," # This workaround is needed to prevent Bazel from compiling the same file twice (once PIC and once not)."," build:linux --copt=\"-fPIC\""," build:macos --copt=\"-fPIC\"","@@ -266,7 +278,14 @@ build:ubsan --copt -fno-sanitize-recover=all"," build:ubsan --copt -g"," build:ubsan --linkopt -fsanitize=undefined"," build:ubsan --linkopt -fno-sanitize-recover=all","-build:ubsan --per_file_copt=\"-external/com_github_grpc_grpc/.*@-fsanitize=undefined\"","+# GCC rejects abseil (>= 20240722) hash containers under the null,","+# nonnull-attribute and returns-nonnull-attribute checks: they make a","+# function-pointer comparison in a constexpr no longer a constant expression.","+# They have to follow -fsanitize=undefined, so they live in the same flag list.","+build:ubsan --per_file_copt=\"-external/com_github_grpc_grpc/.*@-fsanitize=undefined,-fno-sanitize=null,-fno-sanitize=nonnull-attribute,-fno-sanitize=returns-nonnull-attribute\"","+# GCC 11 reports a false -Wmaybe-uninitialized in protobuf's generated","+# move-assignment (CanMoveWithInternalSwap) when inlined under ubsan.","+build:ubsan --copt -Wno-error=maybe-uninitialized"," "," build:cgroup --sandbox_writable_path=/sys/fs/cgroup --config=llvm"," "],"additions":24,"deletions":5,"truncated":false},{"path":".bazelversion","lines":["@@ -1 +1 @@","-7.5.0","+8.8.1"],"additions":1,"deletions":1,"truncated":false},{"path":".buildkite/_forge.rayci.yml","lines":["@@ -4,8 +4,16 @@ steps:","   - name: forge","     wanda: ci/docker/forge.wanda.yaml"," ","+  - name: bazel-glibc217-x86_64","+    label: \"wanda: bazel for manylinux2014 (x86_64)\"","+    wanda: ci/docker/bazel-glibc217.wanda.yaml","+    env_file: rayci.env","+    env:","+      HOSTTYPE: \"x86_64\"","+","   - name: manylinux-x86_64","     wanda: ci/docker/manylinux.wanda.yaml","+    depends_on: bazel-glibc217-x86_64","     env_file: rayci.env","     env:","       HOSTTYPE: \"x86_64\""],"additions":8,"deletions":0,"truncated":false},{"path":".buildkite/_wheel-build.rayci.yml","lines":["@@ -4,6 +4,7 @@ steps:","   - name: ray-core-build","     label: \"wanda: core binary parts py{{array.python}} (x86_64)\"","     wanda: ci/docker/ray-core.wanda.yaml","+    depends_on: bazel-glibc217-x86_64","     array:","       python:","         - \"3.10\"","@@ -32,6 +33,7 @@ steps:","   - name: ray-java-build","     label: \"wanda: java build (x86_64)\"","     wanda: ci/docker/ray-java.wanda.yaml","+    depends_on: bazel-glibc217-x86_64","     env_file: rayci.env","     env:","       ARCH_SUFFIX: \"\""],"additions":2,"deletions":0,"truncated":false},{"path":".buildkite/build.rayci.yml","lines":["@@ -30,6 +30,7 @@ steps:","   - name: ray-cpp-core-build","     label: \"wanda: cpp core (x86_64)\"","     wanda: ci/docker/ray-cpp-core.wanda.yaml","+    depends_on: bazel-glibc217-x86_64","     env_file: rayci.env","     env:","       ARCH_SUFFIX: \"\""],"additions":1,"deletions":0,"truncated":false},{"path":".buildkite/linux_aarch64.rayci.yml","lines":["@@ -10,8 +10,17 @@ steps:","     wanda: ci/docker/forge.aarch64.wanda.yaml","     instance_type: builder-arm64"," ","+  - name: bazel-glibc217-aarch64","+    label: \"wanda: bazel for manylinux2014 (aarch64)\"","+    wanda: ci/docker/bazel-glibc217.wanda.yaml","+    env_file: rayci.env","+    env:","+      HOSTTYPE: \"aarch64\"","+    instance_type: builder-arm64","+","   - name: manylinux-aarch64","     wanda: ci/docker/manylinux.wanda.yaml","+    depends_on: bazel-glibc217-aarch64","     env_file: rayci.env","     env:","       HOSTTYPE: \"aarch64\"","@@ -20,6 +29,7 @@ steps:","   - name: ray-java-build-aarch64","     label: \"wanda: java build (aarch64)\"","     wanda: ci/docker/ray-java.wanda.yaml","+    depends_on: bazel-glibc217-aarch64","     tags:","       - release_wheels","       - java","@@ -186,6 +196,7 @@ steps:","   - name: ray-core-build-aarch64","     label: \"wanda: core binary parts py{{array.python}} (aarch64)\"","     wanda: ci/docker/ray-core.wanda.yaml","+    depends_on: bazel-glibc217-aarch64","     env_file: rayci.env","     array:","       python:","@@ -259,6 +270,7 @@ steps:","   - name: ray-cpp-core-build-aarch64","     label: \"wanda: cpp core (aarch64)\"","     wanda: ci/docker/ray-cpp-core.wanda.yaml","+    depends_on: bazel-glibc217-aarch64","     env_file: rayci.env","     env:","       ARCH_SUFFIX: \"-aarch64\""],"additions":12,"deletions":0,"truncated":false},{"path":"BUILD.bazel","lines":["@@ -8,8 +8,8 @@"," "," load(\"@bazel_skylib//rules:common_settings.bzl\", \"bool_flag\")"," load(\"@com_github_grpc_grpc//bazel:cython_library.bzl\", \"pyx_library\")","+load(\"@com_google_protobuf//bazel:cc_proto_library.bzl\", \"cc_proto_library\")"," load(\"@hedron_compile_commands//:refresh_compile_commands.bzl\", \"refresh_compile_commands\")","-load(\"@rules_cc//cc:defs.bzl\", \"cc_proto_library\")"," load(\"@rules_pkg//pkg:mappings.bzl\", \"pkg_attributes\", \"pkg_files\")"," load(\"@rules_pkg//pkg:zip.bzl\", \"pkg_zip\")"," load(\"@rules_proto//proto:defs.bzl\", \"proto_library\")"],"additions":1,"deletions":1,"truncated":false},{"path":"WORKSPACE","lines":["@@ -10,12 +10,13 @@ http_archive(","     ],"," )"," ","-# bazel_skylib is declared up front, before anything loads from it. The first","-# declaration of a repo wins: the maybe() calls in py_repositories(),","-# rules_java_dependencies() and protobuf_deps() skip theirs, and a later plain","-# http_archive is ignored once the repo has been loaded. Without this,","-# rules_python 0.40.0 pulls bazel_skylib 1.3.0, too old for protobuf 29 (it","-# needs paths.is_normalized() from skylib 1.7.0).","+# bazel_skylib, rules_cc and rules_java are declared up front, before anything","+# loads from them. The first declaration of a repo wins: the maybe() calls in","+# py_repositories(), protobuf_deps() and rules_java_dependencies() skip theirs,","+# and a later plain http_archive is ignored once the repo has been loaded.","+# Without this, rules_python 0.40.0 pulls bazel_skylib 1.3.0 and rules_cc","+# 0.0.13, both too old for protobuf 29 (it needs paths.is_normalized() from","+# skylib 1.7.0)."," http_archive(","     name = \"bazel_skylib\",","     sha256 = \"bc283cdfcd526a52c3201279cda4bc298652efa898b10b4db0837dc51652756f\",","@@ -24,14 +25,36 @@ http_archive(","     ],"," )"," ","+http_archive(","+    name = \"rules_cc\",","+    sha256 = \"bbf1ae2f83305b7053b11e4467d317a7ba3517a12cef608543c1b1c5bf48a4df\",","+    strip_prefix = \"rules_cc-0.0.16\",","+    urls = [","+        \"https://github.com/bazelbuild/rules_cc/releases/download/0.0.16/rules_cc-0.0.16.tar.gz\",","+    ],","+)","+","+# 8.12.0 is the ceiling while wheels build on manylinux2014: from 8.13.0 on,","+# the prebuilt java_tools (singlejar, ijar, one_version) need GLIBCXX_3.4.21,","+# newer than CentOS 7's libstdc++."," http_archive(","     name = \"rules_java\",","-    sha256 = \"302bcd9592377bf9befc8e41aa97ec02df12813d47af9979e4764f3ffdcc5da8\",","+    sha256 = \"1558508fc6c348d7f99477bd21681e5746936f15f0436b5f4233e30832a590f9\",","     urls = [","-        \"https://github.com/bazelbuild/rules_java/releases/download/7.12.4/rules_java-7.12.4.tar.gz\",","+        \"https://github.com/bazelbuild/rules_java/releases/download/8.12.0/rules_java-8.12.0.tar.gz\",","     ],"," )"," ","+# Bazel 8 autoloads sh_binary/sh_test from rules_shell. Declared here (the","+# version protobuf 29 pins) so its toolchains can be registered below; Bazel's","+# implicit declaration only comes after the end of this file.","+http_archive(","+    name = \"rules_shell\",","+    sha256 = \"410e8ff32e018b9efd2743507e7595c26e2628567c42224411ff533b57d27c28\",","+    strip_prefix = \"rules_shell-0.2.0\",","+    url = \"https://github.com/bazelbuild/rules_shell/releases/download/v0.2.0/rules_shell-v0.2.0.tar.gz\",","+)","+"," # rules_python arrives transitively at 0.9.0 (from rules_foreign_cc 0.9.0), which"," # predates bzlmod and pins pip 22.0.4. 0.40.0 is deliberate, not the newest: it is"," # the last release that still ships python/pip_install/repositories.bzl (loaded","@@ -52,20 +75,40 @@ load(\"@rules_python//python:repositories.bzl\", \"py_repositories\")"," "," py_repositories()"," ","-load(\"@rules_java//java:repositories.bzl\", \"rules_java_dependencies\", \"rules_java_toolchains\")","+load(\"//bazel:ray_deps_setup.bzl\", \"ray_deps_setup\")","+","+ray_deps_setup()","+","+# Must run after ray_deps_setup(): rules_java_dependencies() declares its own","+# com_google_protobuf (29.0-rc2) through maybe(), and would otherwise replace","+# Ray's pin.","+load(\"@rules_java//java:rules_java_deps.bzl\", \"rules_java_dependencies\")"," "," rules_java_dependencies()"," ","-rules_java_toolchains()","+load(\"@bazel_features//:deps.bzl\", \"bazel_features_deps\")"," ","-load(\"//bazel:ray_deps_setup.bzl\", \"ray_deps_setup\")","+bazel_features_deps()"," ","-ray_deps_setup()","+load(\"@com_google_protobuf//bazel/private:proto_bazel_features.bzl\", \"proto_bazel_features\")  # buildifier: disable=bzl-visibility","+","+proto_bazel_features(name = \"proto_bazel_features\")","+","+load(\"@rules_java//java:repositories.bzl\", \"rules_java_toolchains\")","+","+rules_java_toolchains()"," "," load(\"//bazel:ray_deps_build_all.bzl\", \"ray_deps_build_all\")"," "," ray_deps_build_all()"," ","+# sh_binary/sh_test need a registered shell toolchain. Bzlmod registers it","+# automatically; WORKSPACE has to. Without it, every sh_binary fails on","+# Windows (\"No suitable shell toolchain found\").","+load(\"@rules_shell//shell:repositories.bzl\", \"rules_shell_toolchains\")","+","+rules_shell_toolchains()","+"," # This needs to be run after grpc_deps() in ray_deps_build_all() to make"," # sure all the packages loaded by grpc_deps() are available. However a"," # load() statement cannot be in a function so we put it here."],"additions":55,"deletions":12,"truncated":false},{"path":"bazel/ray_deps_setup.bzl","lines":["@@ -114,16 +114,18 @@ def ray_deps_setup():","     # https://github.com/ray-project/ray/issues/14117","     # This is copied from grpc's bazel/grpc_deps.bzl","     #","-    # Pinned grpc version: v23.4","+    # Pinned protobuf version: v29.6. This is the first major whose Bazel rules","+    # (//bazel:*.bzl) rules_java 8.x loads from, and rules_java 8.x is what","+    # Bazel 8 needs. It is newer than what grpc 1.58.0 declares, so grpc's own","+    # third_party/protobuf.patch no longer applies and is not used.","+    #","+    # Note: this is only the C++ runtime / build-time protobuf. The protoc that","+    # generates Ray's Python and Java bindings is com_google_protobuf_rules_proto_grpc","+    # below, and is what sets the runtime protobuf floor for users.","     auto_http_archive(","         name = \"com_google_protobuf\",","-        sha256 = \"76a33e2136f23971ce46c72fd697cd94dc9f73d56ab23b753c3e16854c90ddfd\",","-        url = \"https://github.com/protocolbuffers/protobuf/archive/2c5fa078d8e86e5f4bd34e6f4c9ea9e8d7d4d44a.tar.gz\",","-        patches = [","-            \"@com_github_grpc_grpc//third_party:protobuf.patch\",","-            \"//thirdparty/patches:protobuf-bazel7.patch\",","-        ],","-        patch_args = [\"-p1\"],","+        sha256 = \"2af2352d9e89992ae634257a16cff4c5143c8504db972307e49e61ed1047334e\",","+        url = \"https://github.com/protocolbuffers/protobuf/archive/refs/tags/v29.6.tar.gz\",","     )"," ","     # NOTE(lingxuan.zlx): 3rd party dependencies could be accessed, so it suggests","@@ -315,11 +317,12 @@ def ray_deps_setup():","     # OpenCensus depends on Abseil so we have to explicitly pull it in.","     # This is how diamond dependencies are prevented.","     #","-    # TODO(owner): Upgrade abseil to latest version after protobuf updated, which requires to upgrade `rules_cc` first.","+    # The LTS grpc 1.69.0 declares (20240722), at patch 2: patch 1 fixed a","+    # security issue in hash container create/resize.","     auto_http_archive(","         name = \"com_google_absl\",","-        sha256 = \"987ce98f02eefbaf930d6e38ab16aa05737234d7afbab2d5c4ea7adbe50c28ed\",","-        url = \"https://github.com/abseil/abseil-cpp/archive/refs/tags/20230802.1.tar.gz\",","+        sha256 = \"ec820b01d9b328ca1f1b9c4e5b305d7a9fa03dc410ef64ba6654b637f9a4c3a8\",","+        url = \"https://github.com/abseil/abseil-cpp/archive/refs/tags/20240722.2.tar.gz\",","         patches = [","             # TODO (israbbani): #55430 Separate the compiler flags and remove this patch","             \"@io_ray//thirdparty/patches:abseil-cpp-shadow.patch\",","@@ -340,22 +343,49 @@ def ray_deps_setup():","         ],","     )"," ","+    # Declared before grpc_deps() so its maybe() skips rules_proto 6.0.2, which","+    # reads native proto_common.ProtoLangToolchainInfo (removed in Bazel 8).","+    # 7.x forwards to protobuf's own proto rules instead.","+    auto_http_archive(","+        name = \"rules_proto\",","+        url = \"https://github.com/bazelbuild/rules_proto/releases/download/7.1.0/rules_proto-7.1.0.tar.gz\",","+        sha256 = \"14a225870ab4e91869652cfd69ef2028277fc1dc4910d65d353b62d6e0ae21f4\",","+        strip_prefix = \"rules_proto-7.1.0\",","+    )","+","     auto_http_archive(","         name = \"com_github_grpc_grpc\",","         # NOTE: If you update this, also update @boringssl's hash.","-        url = \"https://github.com/grpc/grpc/archive/refs/tags/v1.58.0.tar.gz\",","-        sha256 = \"ec64fdab22726d50fc056474dd29401d914cc616f53ab8f2fe4866772881d581\",","+        # 1.69.0 is the first release whose grpc_deps.bzl pins protobuf 29","+        # (and abseil 20240722.0). Older gRPC builds a standalone @upb that","+        # does not compile against protobuf 29's descriptor.proto.","+        url = \"https://github.com/grpc/grpc/archive/refs/tags/v1.69.0.tar.gz\",","+        sha256 = \"cd256d91781911d46a57506978b3979bfee45d5086a1b6668a3ae19c5e77f8dc\",","         patches = [","             \"@io_ray//thirdparty/patches:grpc-cython-copts.patch\",","-            # Work around bazelbuild/bazel#21592: with layering_check and","-            # non-sandbox/local spawn, clang can record transitive *.cppmap files","-            # in .d files, which Bazel then reports as undeclared direct deps.","-            # Fixed in Bazel 7.3.0. LLVM used the same workaround by disabling","-            # layering_check in Bazel overlays (llvm/llvm-project@5bba176).","+            # gRPC turns on layering_check for its own packages, but its BUILD","+            # files do not declare every header they use (e.g. the Apple-only","+            # cf_event_engine includes absl/status/status.h without depending","+            # on it), which fails on macOS where clang enforces it.","             \"@io_ray//thirdparty/patches:grpc-disable-layering-check.patch\",","+            # gRPC 1.69 turns on its EventEngine client and listener on Windows","+            # (1.58 marked them broken there). They abort at teardown","+            # (win_socket.cc: Check failed: is_shutdown_), so keep Windows on the","+            # iomgr path 1.58 used. Posix is unaffected. The EventEngine","+            # callback CQ goes too: with it on, Windows iomgr reports that it","+            # runs in the background, so callback-API code gets no thread","+            # polling the iomgr sockets and connections never complete in a","+            # process with no CompletionQueue-based gRPC.","+            \"@io_ray//thirdparty/patches:grpc-windows-disable-event-engine.patch\",","             \"@io_ray//thirdparty/patches:grpc-zlib-fdopen.patch\",","             \"@io_ray//thirdparty/patches:grpc-configurable-thread-count.patch\",","             \"@io_ray//thirdparty/patches:grpc-nextresult-cancelled-init.patch\",","+            # The *_pb2_grpc.py stubs come from this gRPC's Python plugin. From","+            # 1.63 on it emits `_registered_method=True` and","+            # `server.add_registered_method_handlers()`, which need grpcio >= 1.64","+            # at runtime. Leave them out so the stubs keep working with the","+            # grpcio >= 1.42.0 that setup.py allows, as the 1.58 plugin's did.","+            \"@io_ray//thirdparty/patches:grpc-python-plugin-no-registered-method.patch\",","         ],","     )"," ","@@ -395,7 +425,11 @@ def ray_deps_setup():","         # This rule is used by @com_github_grpc_grpc, and using a GitHub mirror","         # provides a deterministic archive hash for caching. Explanation here:","         # https://github.com/grpc/grpc/blob/1ff1feaa83e071d87c07827b0a317ffac673794f/bazel/grpc_deps.bzl#L189","-        # Ensure this rule matches the rule used by grpc's bazel/grpc_deps.bzl","+        #","+        # Deliberately older than what grpc 1.69.0 declares (b8b3e6e1). Every","+        # boringssl after this one requires C11 <stdalign.h> on MSVC, which the","+        # Windows SDK on the CI image (10.0.19041) does not ship; this commit","+        # still falls back to __declspec(align) there.","         name = \"boringssl\",","         sha256 = \"b21994a857a7aa6d5256ffe355c735ad4c286de44c6c81dfc04edc41a8feaeef\",","         url = \"https://github.com/google/boringssl/archive/2ff4b968a7e0cfee66d9f151cb95635b43dc1d5b.tar.gz\",","@@ -407,7 +441,7 @@ def ray_deps_setup():","     # code generated by protoc of version X can be used with protobuf library of version >= X.","     # So the version here effectively determines the lower bound of python/java","     # protobuf library that Ray supports.","-    # Declared before protobuf_deps() so its maybe() skips its own rules_pkg.","+    # Declared before protobuf_deps() so its maybe() skips rules_pkg 1.0.1.","     # 0.9.1 is the ceiling: the v3.20.3 protobuf below loads the root","     # @rules_pkg//:providers.bzl stub, which rules_pkg 0.10.0 deleted.","     # Protobuf 29 only uses the //pkg: paths, which 0.9.1 also has."],"additions":54,"deletions":20,"truncated":false},{"path":"ci/docker/bazel-glibc217.Dockerfile","lines":["@@ -0,0 +1,75 @@","+# syntax=docker/dockerfile:1.3-labs","+#","+# Bazel built from source inside the manylinux2014 image, for the images that run","+# Bazel there. Bazel's own Linux releases need glibc >= 2.25 since Bazel 8;","+# manylinux2014 is CentOS 7 with glibc 2.17, so the official binary cannot start.","+# Building here links it against glibc 2.17; it runs on the bundled Temurin","+# JDK 21, which also supports glibc 2.17. The version comes from","+# .bazelversion, so bumping that file rebuilds this image.","+","+ARG MANYLINUX_VERSION","+ARG HOSTTYPE","+FROM rayproject/manylinux2014:${MANYLINUX_VERSION}-jdk-${HOSTTYPE} AS build","+","+ARG HOSTTYPE","+","+COPY .bazelversion /tmp/.bazelversion","+","+RUN <<'EOF'","+#!/bin/bash","+","+set -euo pipefail","+","+version=\"$(tr -d '[:space:]' < /tmp/.bazelversion)\"","+case \"${HOSTTYPE}\" in","+  x86_64) jdk_arch=x64 ;;","+  aarch64) jdk_arch=aarch64 ;;","+  *) echo \"unsupported HOSTTYPE ${HOSTTYPE}\" >&2; exit 1 ;;","+esac","+","+work=\"${HOME}/bazel-src\"","+mkdir -p \"${work}/jdk21\" \"${work}/src\"","+","+# Bootstrapping Bazel 8 needs JDK 21; the image only has JDK 8. Temurin builds","+# target glibc 2.17.","+curl -fsSL \"https://api.adoptium.net/v3/binary/latest/21/ga/linux/${jdk_arch}/jdk/hotspot/normal/eclipse\" \\","+  | tar -xz -C \"${work}/jdk21\" --strip-components=1","+","+curl -fsSL -o /tmp/dist.zip \\","+  \"https://github.com/bazelbuild/bazel/releases/download/${version}/bazel-${version}-dist.zip\"","+unzip -q /tmp/dist.zip -d \"${work}/src\"","+rm /tmp/dist.zip","+","+# devtoolset's enable script reads unset variables.","+set +u","+source /opt/rh/devtoolset-10/enable","+set -u","+export JAVA_HOME=\"${work}/jdk21\"","+export PATH=\"${JAVA_HOME}/bin:${PATH}\"","+","+cd \"${work}/src\"","+","+# compile.sh produces bazel_nojdk, which runs on a separate JDK 21 instead of","+# an embedded one. Building the self-contained //src:bazel from it does not","+# work here: that build runs rules_java's prebuilt ijar, which itself needs","+# GLIBCXX_3.4.21. So ship bazel_nojdk together with the JDK it was built with.","+env EMBED_LABEL=\"${version}\" EXTRA_BAZEL_ARGS=\"--tool_java_runtime_version=local_jdk\" \\","+  bash ./compile.sh","+","+mkdir -p /tmp/out","+cp output/bazel /tmp/out/bazel","+cp -a \"${work}/jdk21\" /tmp/out/jdk21","+","+# Smoke test: start a server, which runs the shipped JDK on glibc 2.17, not","+# just the client.","+mkdir -p /tmp/smoke","+cd /tmp/smoke","+touch MODULE.bazel","+bazel_cmd=(/tmp/out/bazel --nohome_rc --server_javabase=/tmp/out/jdk21 --output_user_root=/tmp/smoke-root)","+\"${bazel_cmd[@]}\" info release | grep -Fx \"release ${version}\"","+\"${bazel_cmd[@]}\" shutdown","+EOF","+","+FROM scratch","+COPY --from=build /tmp/out/bazel /bazel","+COPY --from=build /tmp/out/jdk21 /jdk21"],"additions":75,"deletions":0,"truncated":false},{"path":"ci/docker/bazel-glibc217.wanda.yaml","lines":["@@ -0,0 +1,8 @@","+name: \"bazel-glibc217-$HOSTTYPE\"","+froms: [\"rayproject/manylinux2014:$MANYLINUX_VERSION-jdk-$HOSTTYPE\"]","+dockerfile: ci/docker/bazel-glibc217.Dockerfile","+srcs:","+  - .bazelversion","+build_args:","+  - MANYLINUX_VERSION","+  - HOSTTYPE"],"additions":8,"deletions":0,"truncated":false},{"path":"ci/docker/manylinux-retag.Dockerfile","lines":["@@ -8,8 +8,20 @@"," "," ARG MANYLINUX_VERSION"," ARG HOSTTYPE","+FROM cr.ray.io/rayproject/bazel-glibc217-${HOSTTYPE} AS bazel","+"," FROM rayproject/manylinux2014:${MANYLINUX_VERSION}-jdk-${HOSTTYPE}"," ","+# Bazel's own Linux releases need glibc >= 2.25 since Bazel 8, and this image is","+# glibc 2.17. Run the copy built for it (ci/docker/bazel-glibc217.Dockerfile)","+# instead. The build calls bazelisk, and /usr/local/bin/bazel links to it.","+COPY --from=bazel /bazel /opt/bazel-glibc217/bazel","+COPY --from=bazel /jdk21 /opt/bazel-glibc217/jdk21","+RUN sudo mv /usr/local/bin/bazelisk /usr/local/bin/bazelisk.real \\","+  && printf '#!/bin/sh\\nexec /opt/bazel-glibc217/bazel --server_javabase=/opt/bazel-glibc217/jdk21 \"$@\"\\n' \\","+    | sudo tee /usr/local/bin/bazelisk >/dev/null \\","+  && sudo chmod 0755 /usr/local/bin/bazelisk","+"," ARG BUILDKITE_BAZEL_CACHE_URL"," ENV BUILDKITE_BAZEL_CACHE_URL=${BUILDKITE_BAZEL_CACHE_URL}"," "],"additions":12,"deletions":0,"truncated":false},{"path":"ci/docker/manylinux.wanda.yaml","lines":["@@ -1,6 +1,7 @@"," name: \"manylinux-$HOSTTYPE\""," froms:","   - rayproject/manylinux2014:$MANYLINUX_VERSION-jdk-$HOSTTYPE","+  - cr.ray.io/rayproject/bazel-glibc217-$HOSTTYPE"," build_args:","   - BUILDKITE_BAZEL_CACHE_URL","   - MANYLINUX_VERSION"],"additions":1,"deletions":0,"truncated":false},{"path":"ci/docker/ray-core.Dockerfile","lines":["@@ -2,6 +2,8 @@"," ARG ARCH_SUFFIX="," ARG HOSTTYPE=x86_64"," ARG MANYLINUX_VERSION","+FROM cr.ray.io/rayproject/bazel-glibc217-${HOSTTYPE} AS bazel","+"," FROM rayproject/manylinux2014:${MANYLINUX_VERSION}-jdk-${HOSTTYPE} AS builder"," "," ARG PYTHON_VERSION=3.10","@@ -20,6 +22,16 @@ ENV BAZEL_CACHE=${CACHE_DIR}/bazel"," "," WORKDIR /home/forge/ray"," ","+# Bazel's own Linux releases need glibc >= 2.25 since Bazel 8, and this image is","+# glibc 2.17. Run the copy built for it (ci/docker/bazel-glibc217.Dockerfile)","+# instead. The build calls bazelisk, and /usr/local/bin/bazel links to it.","+COPY --from=bazel /bazel /opt/bazel-glibc217/bazel","+COPY --from=bazel /jdk21 /opt/bazel-glibc217/jdk21","+RUN sudo mv /usr/local/bin/bazelisk /usr/local/bin/bazelisk.real \\","+  && printf '#!/bin/sh\\nexec /opt/bazel-glibc217/bazel --server_javabase=/opt/bazel-glibc217/jdk21 \"$@\"\\n' \\","+    | sudo tee /usr/local/bin/bazelisk >/dev/null \\","+  && sudo chmod 0755 /usr/local/bin/bazelisk","+"," COPY --chown=forge . ."," "," RUN --mount=type=cache,target=${DOWNLOAD_CACHE},uid=2000,gid=100,id=ray-downloads-${HOSTTYPE} \\"],"additions":12,"deletions":0,"truncated":false},{"path":"ci/docker/ray-core.wanda.yaml","lines":["@@ -1,5 +1,7 @@"," name: \"ray-core-py$PYTHON_VERSION$ARCH_SUFFIX\"","-froms: [\"rayproject/manylinux2014:$MANYLINUX_VERSION-jdk-$HOSTTYPE\"]","+froms:","+  - \"rayproject/manylinux2014:$MANY