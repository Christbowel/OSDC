rorOutput(true))","+        );","+    }","+","+    private static function unwrapDisplay(string $display): string","+    {","+        $display = preg_replace(","+            '~","+                (?:^|\\n)   # start of a line","+                \\s*        # optional indentation","+                (?:\\/\\/|!) # \"//\" or \"!\" decoration","+                \\s+        # whitespace after the decoration","+            ~x',","+            ' ',","+            $display","+        );","+        assert($display !== null);","+","+        $display = preg_replace('/\\s+/', '', $display);","+        assert($display !== null);","+","+        return $display;","+    }","+}",""],"additions":54,"deletions":0,"truncated":false}],"additions":136,"deletions":85,"truncated":false,"file_count":17},"error":null,"fetched_at":"2026-11-07T15:04:22.123586+00:00"}