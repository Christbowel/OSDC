ons::default())","@@ -114,6 +115,7 @@ async fn resolve_latest_under_compatible_does_not_override_update_to_latest() {","             ..WantedDependency::default()","         },","         compatible: true,","+        current_version: None,","     };","     let opts = ResolveOptions {","         refresh: pnpm_resolving_resolver_base::ResolutionRefreshOptions {","@@ -254,3 +256,192 @@ async fn latest_is_suppressed_when_all_versions_are_immature_fallback_case() {","     );","     assert!(result.package.latest.is_none(), \"immature dist-tags.latest suppresses the hint\");"," }","+","+fn prerelease_channel_body(dist_tags: &[(&str, &str)]) -> String {","+    let versions = [","+        \"1.0.0\",","+        \"2.0.0-canary-2\",","+        \"2.0.0-canary-abc123-20260101\",","+        \"2.0.0-canary-def456-20260102\",","+        \"2.0.0-next-1\",","+        \"2.0.0-next-2\",","+        \"2.0.0-rc.0\",","+        \"2.0.0-rc.1\",","+        \"2.0.0-rc.2\",","+        \"2.0.0\",","+    ];","+    let versions = versions","+        .iter()","+        .map(|version| {","+            let manifest = serde_json::json!({","+                \"name\": \"acme\",","+                \"version\": version,","+                \"dist\": {","+                    \"integrity\": \"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",","+                    \"tarball\": format!(\"https://registry/acme-{version}.tgz\"),","+                },","+            });","+            ((*version).to_string(), manifest)","+        })","+        .collect::<serde_json::Map<_, _>>();","+    let dist_tags = dist_tags","+        .iter()","+        .map(|(tag, version)| ((*tag).to_string(), serde_json::Value::from(*version)))","+        .collect::<serde_json::Map<_, _>>();","+    serde_json::json!({ \"name\": \"acme\", \"dist-tags\": dist_tags, \"versions\": versions }).to_string()","+}","+","+struct PrereleaseChannelCase {","+    dist_tags: &'static [(&'static str, &'static str)],","+    current: &'static str,","+    expected: &'static str,","+}","+","+#[tokio::test]","+async fn resolve_latest_follows_the_prerelease_channel_of_the_current_version() {","+    let cases = [","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"1.0.0\"), (\"next\", \"2.0.0-next-2\")],","+            current: \"2.0.0-next-1\",","+            expected: \"2.0.0-next-2\",","+        },","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"1.0.0\"), (\"beta\", \"2.0.0-rc.0\"), (\"next\", \"2.0.0-rc.2\")],","+            current: \"2.0.0-rc.1\",","+            expected: \"2.0.0-rc.2\",","+        },","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"2.0.0\"), (\"next\", \"2.0.0-next-2\")],","+            current: \"2.0.0-next-1\",","+            expected: \"2.0.0\",","+        },","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"1.0.0\"), (\"canary\", \"2.0.0-canary-def456-20260102\")],","+            current: \"2.0.0-canary-abc123-20260101\",","+            expected: \"2.0.0-canary-def456-20260102\",","+        },","+        PrereleaseChannelCase {","+            dist_tags: &[","+                (\"latest\", \"1.0.0\"),","+                (\"next\", \"2.0.0-next-2\"),","+                (\"preview\", \"2.0.0-next-9\"),","+            ],","+            current: \"2.0.0-next-1\",","+            expected: \"2.0.0-next-2\",","+        },","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"1.0.0\"), (\"canary\", \"2.0.0-canary-2\")],","+            current: \"2.0.0-next-1\",","+            expected: \"2.0.0-next-1\",","+        },","+    ];","+    for PrereleaseChannelCase { dist_tags, current, expected } in cases {","+        let mut server = mockito::Server::new_async().await;","+        let _mock = server","+            .mock(\"GET\", \"/acme\")","+            .with_status(200)","+            .with_body(prerelease_channel_body(dist_tags))","+            .create_async()","+            .await;","+        let registry = format!(\"{}/\", server.url());","+        let (resolver, _tempdir) = build_resolver(&registry);","+","+        let query = LatestQuery {","+            wanted_dependency: WantedDependency {","+                alias: Some(\"acme\".to_string()),","+                bare_specifier: Some(current.to_string()),","+                ..WantedDependency::default()","+            },","+            compatible: false,","+            current_version: Some(current.parse().expect(\"valid version\")),","+        };","+        let info = resolver","+            .resolve_latest(&query, &ResolveOptions::default())","+            .await","+            .unwrap()","+            .expect(\"latest info\");","+        let manifest = info.latest_manifest.expect(\"manifest present\");","+        assert_eq!(manifest[\"version\"].as_str(), Some(expected), \"current {current}\");","+    }","+}","+","+#[tokio::test]","+async fn resolve_latest_ignores_immature_prerelease_channel_tags() {","+    let cases = [","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"2.0.0\"), (\"next\", \"4.0.0-rc.0\")],","+            current: \"2.0.0-rc.0\",","+            expected: \"2.0.0\",","+        },","+        PrereleaseChannelCase {","+            dist_tags: &[(\"latest\", \"2.0.0\"), (\"rc\", \"3.0.0-rc.1\"), (\"preview\", \"4.0.0-rc.0\")],","+            current: \"3.0.0-rc.0\",","+            expected: \"3.0.0-rc.1\",","+        },","+    ];","+    let time = [","+        (\"2.0.0-rc.0\", \"2026-01-01T00:00:00.000Z\"),","+        (\"2.0.0\", \"2026-01-02T00:00:00.000Z\"),","+        (\"3.0.0-rc.0\", \"2026-01-03T00:00:00.000Z\"),","+        (\"3.0.0-rc.1\", \"2026-01-04T00:00:00.000Z\"),","+        (\"4.0.0-alpha.1\", \"2026-01-05T00:00:00.000Z\"),","+        (\"4.0.0-rc.0\", \"2026-03-01T00:00:00.000Z\"),","+    ];","+    for PrereleaseChannelCase { dist_tags, current, expected } in cases {","+        let versions = time","+            .iter()","+            .map(|(version, _)| {","+                let manifest = serde_json::json!({","+                    \"name\": \"acme\",","+                    \"version\": version,","+                    \"dist\": {","+                        \"integrity\": \"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",","+                        \"tarball\": format!(\"https://registry/acme-{version}.tgz\"),","+                    },","+                });","+                ((*version).to_string(), manifest)","+            })","+            .collect::<serde_json::Map<_, _>>();","+        let body = serde_json::json!({","+            \"name\": \"acme\",","+            \"dist-tags\": dist_tags.iter().copied().collect::<std::collections::HashMap<_, _>>(),","+            \"modified\": \"2026-03-01T00:00:00.000Z\",","+            \"time\": time.iter().copied().collect::<std::collections::HashMap<_, _>>(),","+            \"versions\": versions,","+        })","+        .to_string();","+        let mut server = mockito::Server::new_async().await;","+        let _mock = server","+            .mock(\"GET\", \"/acme\")","+            .with_status(200)","+            .with_body(body)","+            .create_async()","+            .await;","+        let registry = format!(\"{}/\", server.url());","+        let (resolver, _tempdir) = build_resolver(&registry);","+","+        let query = LatestQuery {","+            wanted_dependency: WantedDependency {","+                alias: Some(\"acme\".to_string()),","+                bare_specifier: Some(current.to_string()),","+                ..WantedDependency::default()","+            },","+            compatible: false,","+            current_version: Some(current.parse().expect(\"valid version\")),","+        };","+        let opts = ResolveOptions {","+            policy: pnpm_resolving_resolver_base::ResolutionPolicyOptions {","+            