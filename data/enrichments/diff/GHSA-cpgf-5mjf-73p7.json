ri_attribute(attr_node)","+          attr_name = Loofah::HTML5::Scrub.prefixed_attribute_name(attr_node)"," ","-          if Loofah::HTML5::SafeList::SVG_ATTR_VAL_ALLOWS_REF.include?(attr_name)","-            Loofah::HTML5::Scrub.scrub_attribute_that_allows_local_ref(attr_node)","-          end","-","-          if Loofah::HTML5::SafeList::SVG_ALLOW_LOCAL_HREF.include?(node.name) && Loofah::HTML5::SafeList::SVG_HREF_ATTRIBUTES.include?(attr_name) && attr_node.value =~ /^\\s*[^#\\s].*/m","-            attr_node.remove","-          end","+          return if Loofah::HTML5::Scrub.scrub_attribute_value(node, attr_node, attr_name)"," ","           node.remove_attribute(attr_node.name) if attr_name == \"src\" && attr_node.value !~ /[^[:space:]]/"," "],"additions":2,"deletions":14,"truncated":false},{"path":"rails-html-sanitizer.gemspec","lines":["@@ -25,7 +25,7 @@ Gem::Specification.new do |spec|","   spec.files         = Dir[\"lib/**/*\", \"README.md\", \"MIT-LICENSE\", \"CHANGELOG.md\"]","   spec.require_paths = [\"lib\"]"," ","-  spec.add_dependency \"loofah\", \"~> 2.25\", \">= 2.25.2\"","+  spec.add_dependency \"loofah\", \"~> 2.25\", \">= 2.25.3\""," ","   # A fix was shipped in nokogiri v1.15.7 and v1.16.8 without which there is a vulnerability in this gem.","   spec.add_dependency \"nokogiri\", [\">=1.15.7\","],"additions":1,"deletions":1,"truncated":false},{"path":"test/sanitizer_test.rb","lines":["@@ -949,6 +949,46 @@ def test_use_href_external_ref_with_leading_newline_is_scrubbed","       assert_equal(expected, actual)","     end"," ","+    def test_use_href_external_ref_after_a_local_ref_is_scrubbed","+      input = %(<svg><use href=\"#p\\nhttp://bad.com/x\"></use></svg>)","+      expected = \"<svg><use></use></svg>\"","+      actual = safe_list_sanitize(input, tags: %w(svg use), attributes: %w(href))","+","+      assert_equal(expected, actual)","+    end","+","+    def test_use_href_removal_does_not_skip_the_next_attribute","+      input = %(<svg><use href=\"http://bad.com/x\" fill=\"url(http://bad.com/) #fff\"></use></svg>)","+      expected = %(<svg><use fill=\"#fff\"></use></svg>)","+      actual = safe_list_sanitize(input, tags: %w(svg use), attributes: %w(href fill))","+","+      assert_equal(expected, actual)","+    end","+","+    def test_use_href_unsafe_uri_is_scrubbed","+      input = %(<svg><use href=\"javascript:alert(1)\"></use></svg>)","+      expected = \"<svg><use></use></svg>\"","+      actual = safe_list_sanitize(input, tags: %w(svg use), attributes: %w(href))","+","+      assert_equal(expected, actual)","+    end","+","+    def test_use_xlink_href_unsafe_uri_is_scrubbed","+      input = %(<svg><use xlink:href=\"javascript:alert(1)\"></use></svg>)","+      expected = \"<svg><use></use></svg>\"","+      actual = safe_list_sanitize(input, tags: %w(svg use), attributes: %w(href xlink:href))","+","+      assert_equal(expected, actual)","+    end","+","+    def test_use_href_unsafe_uri_removal_does_not_skip_the_next_attribute","+      input = %(<svg><use href=\"javascript:alert(1)\" fill=\"url(http://bad.com/) #fff\"></use></svg>)","+      expected = %(<svg><use fill=\"#fff\"></use></svg>)","+      actual = safe_list_sanitize(input, tags: %w(svg use), attributes: %w(href fill))","+","+      assert_equal(expected, actual)","+    end","+","     def test_style_with_css_payload","       input, tags = \"<style>div > span { background: \\\"red\\\"; }</style>\", [\"style\"]","       actual = safe_list_sanitize(input, tags: tags)",""],"additions":40,"deletions":0,"truncated":false}],"additions":80,"deletions":35,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-14T15:12:35.245244+00:00"}