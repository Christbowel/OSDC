{"id":"4970769f2aa4d6aedb914e2ca98f940b44a2d6c4","axis":"silent","repo":"pnpm/pnpm","sha":"4970769f2aa4d6aedb914e2ca98f940b44a2d6c4","parsed":{"files":[{"path":".changeset/global-bins-resolve-hoisted-dependencies.md","lines":["@@ -0,0 +1,10 @@","+---","+\"@pnpm/bins.cmd-shim\": patch","+\"@pnpm/bins.linker\": patch","+\"@pnpm/global.commands\": patch","+\"@pnpm/installing.context\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Commands installed with `pnpm add --global` now find the dependencies that pnpm hoists for their package. A package that loads a dependency it does not declare, such as a native addon's platform-specific package, failed with \"Cannot find module\". Reinstall such a package with `pnpm add --global` to update its existing command [#17503](https://github.com/pnpm/pnpm/issues/17503)."],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -6053,6 +6053,9 @@ importers:"," ","   pnpm11/installing/context:","     dependencies:","+      '@pnpm/bins.linker':","+        specifier: workspace:*","+        version: link:../../bins/linker","       '@pnpm/constants':","         specifier: workspace:*","         version: link:../../core/constants"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/groups.rs","lines":["@@ -364,6 +364,7 @@ impl GlobalInstallTarget<'_> {","             || {","                 link_global_bins(","                     self.base_config,","+                    &hash_link,","                     &linked_pkgs,","                     activation.dependencies,","                     self.global_bin_dir,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/install.rs","lines":["@@ -1,7 +1,7 @@"," use super::{","     AddGroups, CatalogMode, Config, Context, DependencyGroup, GlobalPackageBinSnapshot,","     GlobalPackageInfo, HashMap, HashSet, ImporterDepVersion, Lockfile, PackageBinSource, Path,","-    RangeSpe