"-    let extra_node_paths = if config.extend_node_path","-        && matches!(node_linker, NodeLinker::Isolated)","-        && has_hoist_pattern","-    {","-        vec![","-            config.install_state_dir","-                .join(\"node_modules\")","-                .to_string_lossy()","-                .into_owned(),","-        ]","-    } else {","-        Vec::new()","-    };","-    LinkBinsOptions {","-        force: false,","-        extra_node_paths,","-        prefer_symlinked_executables: config.prefer_symlinked_executables.unwrap_or(false),","-        relocatable_root: config.modules_dir_anchor().map(Path::to_path_buf),","-        project_modules_dir_name: (config.extend_node_path","-            && config.modules_dir_name() != \"node_modules\")","-            .then(|| config.modules_dir_name().to_owned()),","-        installed_modules_dir: (config.modules_dir_name() != \"node_modules\").then(|| {","-            config.modules_dir.clone()","-        }),","-    }","-}"," /// Read the `package.json` of every direct dependency under `modules_dir`"," /// and link its bins into `<modules_dir>/.bin`."," ///"],"additions":0,"deletions":40,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/link_bins/shim_options.rs","lines":["@@ -0,0 +1,49 @@","+use pnpm_cmd_shim::LinkBinsOptions;","+use pnpm_config::{Config, NodeLinker};","+use std::path::Path;","+","+/// The config-derived options for every bin an install links. Its","+/// `extra_node_paths` are [`hoisted_node_paths`] of the install's","+/// virtual store dir.","+#[must_use]","+pub fn shim_link_options(config: &Config, node_linker: NodeLinker) -> LinkBinsOptions {","+    let extra_node_paths = hoisted_node_paths(config, node_linker, &config.install_state_dir);","+    LinkBinsOptions {","+        force: false,","+        extra_node_paths,","+        prefer_symlinked_executables: config.prefer_symlinked_executables.unwrap_or(false),","+        relocatable_root: config.modules_dir_anchor().map(Path::to_path_buf),","+        project_modules_dir_name: (config.extend_node_path","+            && config.modules_dir_name() != \"node_modules\")","+            .then(|| config.modules_dir_name().to_owned()),","+        installed_modules_dir: (config.modules_dir_name() != \"node_modules\").then(|| {","+            config.modules_dir.clone()","+        }),","+    }","+}","+","+/// pnpm's `getExtraNodePaths`: under the isolated linker with a hoist","+/// pattern, shims carry the hidden hoisted modules dir","+/// (`<virtual_store_dir>/node_modules`) on `NODE_PATH`, unless","+/// `extendNodePath: false`. Everything else (the hoisted linker, a","+/// disabled hoist pass) gets no `NODE_PATH` at all.","+#[must_use]","+pub fn hoisted_node_paths(","+    config: &Config,","+    node_linker: NodeLinker,","+    virtual_store_dir: &Path,","+) -> Vec<String> {","+    let has_hoist_pattern = config.hoist_pattern","+        .as_ref()","+        .is_some_and(|patterns| !patterns.is_empty());","+    if config.extend_node_path && matches!(node_linker, NodeLinker::Isolated) && has_hoist_pattern {","+        vec![","+            virtual_store_dir","+                .join(\"node_modules\")","+                .to_string_lossy()","+                .into_owned(),","+        ]","+    } else {","+        Vec::new()","+    }","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"pnpm11/bins/cmd-shim/src/index.ts","lines":["@@ -87,16 +87,40 @@ function isShimForMissingTarget (shimContent: string): boolean {"," }"," "," /**","- * Check whether a shell shim's `NODE_PATH` matches expectations.","+ * Check whether a shell shim's `NODE_PATH` is `first`, then `middle`, then","+ * `last`. An omitted `first` or `last` accepts the shim's own entries at that","+ * end, but only where a non-empty `middle` separates them from the rest.","  */","-function isShimNodePath (shimContent: string, expected: { first?: string, last?: string[] }): boolean {","-  const first = expected.first == null ? '' : normalizePathEnvVar([expected.first]).posix","-  const last = normalizePathEnvVar(expected.last).posix","+function isShimNodePath (shimContent: string, expected: { first?: string, middle?: string[], last?: string[] }): boolean {","+  const first = expected.first == null ? undefined : normalizePathEnvVar([expected.first]).posix","+  const last = expected.last == null ? undefined : normalizePathEnvVar(expected.last).posix","   const value = readShNodePath(shimContent)","-  if (value == null) return first === '' && last === ''","-  return (first !== '' || last !== '') &&","-    (first === '' || value === first || value.startsWith(`${first}:`)) &&","-    (last === '' || value === last || value.endsWith(`:${last}`))","+  if (value == null) return !first && !last","+  if (!first && !last) return false","+  const rest = stripOuterEntries(value, first, last)","+  return rest != null && isMiddleCurrent(rest, normalizePathEnvVar(expected.middle).posix, {","+    keepsLeading: first == null,","+    keepsTrailing: last == null,","+  })","+}","+","+function stripOuterEntries (value: string, first: string | undefined, last: string | undefined): string | undefined {","+  const afterFirst = first ? stripEntries(value, first, 'start') : value","+  if (afterFirst == null || !last) return afterFirst","+  return stripEntries(afterFirst, last, 'end')","+}","+","+function isMiddleCurrent (rest: string, middle: string, keeps: { keepsLeading: boolean, keepsTrailing: boolean }): boolean {","+  if (rest === middle) return true","+  if (middle === '') return false","+  return (keeps.keepsLeading && rest.endsWith(`:${middle}`)) ||","+    (keeps.keepsTrailing && rest.startsWith(`${middle}:`))","+}","+","+function stripEntries (value: string, entries: string, end: 'start' | 'end'): string | undefined {","+  if (value === entries) return ''","+  if (end === 'start') return value.startsWith(`${entries}:`) ? value.slice(entries.length + 1) : undefined","+  return value.endsWith(`:${entries}`) ? value.slice(0, -entries.length - 1) : undefined"," }"," "," /**"],"additions":32,"deletions":8,"truncated":false},{"path":"pnpm11/bins/linker/src/getExtraNodePaths.ts","lines":["@@ -0,0 +1,18 @@","+/**","+ * Returns the `NODE_PATH` entries every bin shim of an install carries: the","+ * hidden hoisted modules directory, under the isolated linker with a hoist","+ * pattern, unless `extendNodePath` is `false`.","+ */","+export function getExtraNodePaths (","+  { extendNodePath = true, hoistPattern, nodeLinker, hoistedModulesDir }: {","+    extendNodePath?: boolean","+    hoistPattern?: string[]","+    nodeLinker: 'isolated' | 'hoisted' | 'pnp'","+    hoistedModulesDir: string","+  }","+): string[] {","+  if (extendNodePath && nodeLinker === 'isolated' && hoistPattern?.length) {","+    return [hoistedModulesDir]","+  }","+  return []","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"pnpm11/bins/linker/src/index.ts","lines":["@@ -21,6 +21,7 @@ import { isMissing } from './fileChecks.js'"," import { type CommandInfo, linkBin, type LinkBinOptions } from './linkBin.js'"," import { IS_WINDOWS } from './platform.js'"," ","+export { getExtraNodePaths } from './getExtraNodePaths.js'"," export { getProjectNodePath } from './getProjectNodePath.js'"," export type { LinkBinOptions } from './linkBin.js'"," export { relinkModulesDirPackageBins } from './relinkModulesDirPackageBins.js'"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm11/bins/linker/src/linkBin.ts","lines":["@@ -135,9 +135,8 @@ async function isShimFileCurrent (content: string, ctx: BinLinkContext): Promise","   if (!isShimPointingAt(content, cmd.path) || !isShimHardened(content) || isShimMsysCmdSwitchDoubled(content)) return false","   if (IS_WINDOWS && !existsSync(`${externalBinPath}.cmd`)) return false","   if (isShimForMissingTarget(content) && !await isMissing(cmd.path)) return false","-  return isShimBasedirAnchorCurrent(content, path.relative(binsDir, cmd.path)) &&","-    isShimRelativeTargetCurren