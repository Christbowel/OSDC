"+// into the top results."," //"," // Returns Unimplemented when no embedding provider or vector backend is"," // configured.","@@ -76,6 +80,7 @@ func (s *searchServer) HybridSearch(ctx context.Context, req *resourcepb.HybridS"," \tif !allowed {"," \t\treturn nil, status.Error(codes.NotFound, \"collection not found\")"," \t}","+"," \t// External collections have no lexical index, so the fused contract"," \t// can't hold for them."," \tif coll.IsExternal {","@@ -132,6 +137,13 @@ func (s *searchServer) HybridSearch(ctx context.Context, req *resourcepb.HybridS"," \t}"," "," \tfused := fuseRRF(req.Key, lex, sem)","+\tif !req.SkipRerank {","+\t\tvar err error","+\t\tfused, err = s.rerankHybridResults(ctx, embedText, fused, req.MinRelevance)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t}"," \tif len(fused) > limit {"," \t\tfused = fused[:limit]"," \t}","@@ -176,6 +188,73 @@ func grpcErrorFromErrorResult(e *resourcepb.ErrorResult) error {"," \t}"," }"," ","+// rerankHybridResults cross-encoder re-scores, re-sorts, and threshold-drops the fused candidates; fail-open on provider errors (only caller cancellation propagates).","+func (s *searchServer) rerankHybridResults(ctx context.Context, query string, results []*resourcepb.HybridSearchResult, minRelevance string) ([]*resourcepb.HybridSearchResult, error) {","+\tif s.reranker == nil || len(results) == 0 {","+\t\treturn results, nil","+\t}","+\tif len(results) > maxRerankCandidates {","+\t\tresults = results[:maxRerankCandidates]","+\t}","+\t// Chunks[0] is the best text per resource: closest embedded chunk, whole-resource text for unchunked kinds, or the synthesized title chunk for lexical-only hits.","+\ttexts := make([]string, len(results))","+\tfor i, r := range results {","+\t\ttexts[i] = r.Chunks[0].Content","+\t\t// One empty document (titleless lexical-only hit) would 400 the whole provider call.","+\t\tif texts[i] == \"\" {","+\t\t\ttexts[i] = r.Key.Name","+\t\t}","+\t}","+","+\tscores, err := s.re