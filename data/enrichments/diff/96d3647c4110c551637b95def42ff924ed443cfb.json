/<[a-z][\\s\\S]*>/i.test(value);"," }"," ","+/** True when sanitizing removes nodes (iframes, comments, …), which the diff view would then hide. */","+export function sanitizeDropsContent(value: any): boolean {","+\tif (typeof value !== 'string' || value === '') return false;","+","+\tconst sanitized = dompurify.sanitize(value);","+","+\tif (value.includes('<!--') && !sanitized.includes('<!--')) return true;","+","+\t// DOMParser is inert: nothing executes and no resource loads while the raw markup is inspected","+\tconst parse = (html: string) => new DOMParser().parseFromString(html, 'text/html').body;","+\treturn nodeSignature(parse(value)) !== nodeSignature(parse(sanitized));","+}","+","+// only missing nodes matter here, attribute-level normalization is ignored","+function nodeSignature(root: HTMLElement): string {","+\tconst parts: string[] = [];","+","+\tfunction walk(node: Node) {","+\t\tfor (const child of Array.from(node.childNodes)) {","+\t\t\tif (child.nodeType === Node.ELEMENT_NODE) parts.push((child as HTMLElement).tagName);","+\t\t\telse if (child.nodeType === Node.TEXT_NODE) parts.push(`#text:${child.textContent}`);","+\t\t\twalk(child);","+\t\t}","+\t}","+","+\twalk(root);","+\treturn parts.join('|');","+}","+"," function isFormattingElement(node: Node): boolean {"," \tif (node.nodeType !== Node.ELEMENT_NODE) return false;"," \tconst tag = (node as HTMLElement).tagName;"],"additions":29,"deletions":0,"truncated":false},{"path":"app/src/interfaces/input-rich-text-html/comparison-source.test.ts","lines":["@@ -0,0 +1,72 @@","+import { EditorContent } from '@tiptap/vue-3';","+import { flushPromises, mount } from '@vue/test-utils';","+import { createPinia } from 'pinia';","+import { describe, expect, test } from 'vitest';","+import { nextTick } from 'vue';","+import { createI18n } from 'vue-i18n';","+import Interface from './input-rich-text-html.vue';","+import InterfaceInputCode from '@/interfaces/input-code/input-code.vue';","+","+/**","+ * Comparison view of a value the schema can't represent: rendering it through the editor would","+ * silently drop the unsupported markup, so the revision would look empty and restoring it would be","+ * impossible to judge. Those values fall back to a read-only source view instead.","+ */","+const LOSSY = '<p>hello</p><marquee>legacy</marquee>';","+const DIFF_MARKED = '<p>hello<span class=\"comparison-diff--added\"> world</span></p>';","+","+async function mountComparison(value: string) {","+\tconst i18n = createI18n({ legacy: false, locale: 'en-US', messages: { 'en-US': {} } });","+","+\tconst wrapper = mount(Interface, {","+\t\tprops: { value, comparisonMode: true, nonEditable: true },","+\t\tglobal: {","+\t\t\tplugins: [createPinia(), i18n],","+\t\t\tstubs: {","+\t\t\t\tToolbar: true,","+\t\t\t\tTableBubbleMenu: true,","+\t\t\t\tImageDrawer: true,","+\t\t\t\tLinkDrawer: true,","+\t\t\t\tMediaDrawer: true,","+\t\t\t\tSourceCodeDrawer: true,","+\t\t\t\tNormalizationWarningDialog: true,","+\t\t\t\tInterfaceInputCode: true,","+\t\t\t},","+\t\t},","+\t});","+","+\tawait flushPromises();","+\tawait nextTick();","+\treturn wrapper;","+}","+","+// isVisible() is unreliable for v-show under jsdom; assert on the inline style it toggles","+function editorContentHidden(wrapper: Awaited<ReturnType<typeof mountComparison>>) {","+\treturn (wrapper.findComponent(EditorContent).attributes('style') ?? '').includes('display: none');","+}","+","+describe('comparison mode source fallback', () => {","+\ttest('unsupported markup is shown as read-only source instead of being dropped by the editor', async () => {","+\t\tconst wrapper = await mountComparison(LOSSY);","+","+\t\tconst code = wrapper.findComponent(InterfaceInputCode);","+\t\texpect(code.exists()).toBe(true);","+\t\texpect(code.props('value')).toBe(LOSSY);","+\t\texpect(code.props('disabled')).toBe(true);","+\t\texpect(editorContentHidden(wrapper)).toBe(true);","+\t});","+","+\ttest('diff-marked values still render in the editor', async () => {","+\t\tconst wrapper = await mountComparison(DIFF_MARKED);","+","+\t\texpect(wrapper.findComponent(InterfaceInputCode).exists()).toBe(false);","+\t\texpect(editorContentHidden(wrapper)).toBe(false);","+\t});","+","+\ttest('the source fallback never emits, so opening a comparison cannot dirty the field', async () => {","+\t\tconst wrapper = await mountComparison(LOSSY);","+","+\t\texpect(wrapper.emitted('input')).toBeUndefined();","+\t\texpect(wrapper.emitted('setFieldValue')).toBeUndefined();","+\t});","+});"],"additions":72,"deletions":0,"truncated":false},{"path":"app/src/interfaces/input-rich-text-html/composables/normalization-diff.test.ts","lines":["@@ -1,6 +1,6 @@"," import { describe, expect, test } from 'vitest';"," import { buildCustomFormats } from '../extensions/custom-formats';","-import { computeNormalizationDiff, computeValueNormalizationDiff } from './normalization-diff';","+import { comparisonSchema, computeNormalizationDiff, computeValueNormalizationDiff } from './normalization-diff';"," "," function removedText(code: string): string {"," \tconst changes = computeNormalizationDiff(code);","@@ -76,4 +76,38 @@ describe('computeValueNormalizationDiff', () => {"," \t\tconst { extensions } = buildCustomFormats([{ title: 'Cite', inline: 'cite', classes: 'src' }]);"," \t\texpect(computeValueNormalizationDiff('<p><cite class=\"src\">b</cite></p>', extensions)).toBeNull();"," \t});","+","+\ttest('reuses the verdict for a value already checked against the same schema', () => {","+\t\tconst value = '<p><cite class=\"src\">b</cite></p>';","+\t\tconst first = computeValueNormalizationDiff(value);","+","+\t\texpect(first).not.toBeNull();","+\t\texpect(computeValueNormalizationDiff(value)).toBe(first);","+\t});","+","+\ttest('keeps the verdicts of two custom-format schemas apart', () => {","+\t\tconst cite = buildCustomFormats([{ title: 'Cite', inline: 'cite', classes: 'src' }]);","+\t\tconst highlight = buildCustomFormats([{ title: 'Highlight', inline: 'span', classes: 'highlight' }]);","+\t\tconst value = '<p><cite class=\"src\">b</cite></p>';","+","+\t\texpect(computeValueNormalizationDiff(value, cite.extensions, cite.key)).toBeNull();","+\t\texpect(computeValueNormalizationDiff(value, highlight.extensions, highlight.key)).not.toBeNull();","+\t});","+","+\ttest('does not cache a schema it cannot identify', () => {","+\t\tconst { extensions } = buildCustomFormats([{ title: 'Cite', inline: 'cite', classes: 'src' }]);","+\t\tconst value = '<p><cite class=\"other\">b</cite></p>';","+","+\t\texpect(computeValueNormalizationDiff(value, extensions)).not.toBe(computeValueNormalizationDiff(value, extensions));","+\t});","+});","+","+describe('comparisonSchema', () => {","+\ttest('accepts the diff spans the comparison view feeds the editor', () => {","+\t\tconst value = '<p><span class=\"comparison-diff--added\">a</span></p>';","+\t\tconst { extensions, schemaKey } = comparisonSchema(null);","+","+\t\texpect(computeValueNormalizationDiff(value, extensions, schemaKey)).toBeNull();","+\t\texpect(computeValueNormalizationDiff(value)).not.toBeNull();","+\t});"," });"],"additions":35,"deletions":1,"truncated":false},{"path":"app/src/interfaces/input-rich-text-html/composables/normalization-diff.ts","lines":["@@ -1,6 +1,8 @@"," import { type AnyExtension, Editor } from '@tiptap/vue-3';"," import { type Change, diffLines } from 'diff';"," import { editorExtensions } from '../extensions';","+import { ComparisonDiff } from '../extensions/comparison-diff';","+import { buildCustomFormats } from '../extensions/custom-formats';"," import { decodePageBreaks, encodePageBreaks } from '../extensions/page-break';"," import { formatHtml } from './format-html';"," ","@@ -37,8 +39,41 @@ export function computeNormalizationDiff(code: string, extraExtensions: AnyExten","  * Same check for the stored field value: both sides are compared in the encoded (stored)","  * representation so the page-break marker ↔ element boundary cancels out instead of reading","  * as a change.","+ *","+ * Each miss builds a throwaway editor, and a comparison asks the same question about the same value","+ * repeatedly (per side, per rendered interface, per revision pick), so verdicts are cached against","+ * `schemaKey`. Without one, only the base schema is cached — dynamic custom format marks reuse names.","  */","-export function computeValueNormalizationDiff(value: string, extraExtensions: AnyExtension[] = []): Change[] | null {","+export function computeValueNormalizationDiff(","+\tvalue: string,","+\textraExtensions: AnyExtension[] = [],","+\tschemaKey?: string,","+): Change[] | null {","+\tconst key = schemaKey ?? (extraExtensions.length === 0 ? '' : null);","+","+\tif (key === null) return valueNormalizationDiff(value, extraExtensions);","+","+\tconst cacheKey = `${key}\\u0000${value}`;","+\tif (verdictCache.has(cacheKey)) return verdictCache.get(cacheKey)!;","+","+\tconst verdict = valueNormalizationDiff(value, extraExtensions);","+","+\tif (verdictCache.size >= VERDICT_CACHE_SIZE) verdictCache.delete(verdictCache.keys().next().value!);","+\tverdictCache.set(cacheKey, verdict);","+","+\treturn verdict;","+}","+","+/** The schema the comparison view renders with, so its verdicts are shared with the interface. */","+export function comparisonSchema(customFormats: unknown): { extensions: AnyExtension[]; schemaKey: string } {","+\tconst { extensions, key } = buildCustomFormats(customFormats);","+\treturn { extensions: [...extensions, ComparisonDiff], schemaKey: `comparison\\u0000${key}` };","+}","+","+const VERDICT_CACHE_SIZE = 24;","+const verdictCache = new Map<string, Change[] | null>();","+","+function valueNormalizationDiff(value: string, extraExtensions: AnyExtension[]): Change[] | null {"," \tconst decoded = decodePageBreaks(value);"," \treturn diffFormatted(encodePageBreaks(decoded), encodePageBreaks(roundTrip(decoded, extraExtensions)));"," }"],"additions":36,"deletions":1,"truncated":false},{"path":"app/src/interfaces/input-rich-text-html/composables/use-normalization-warning.ts","lines":["@@ -22,6 +22,7 @@ type UsableNormalizationWarning = {"," export function useNormalizationWarning("," \tvalue: Ref<string | null>,"," \textraExtensions: AnyExtension[] = [],","+\tschemaKey?: string,"," ): UsableNormalizationWarning {"," \tconst normalizationLocked = ref(false);"," \tconst normalizationWarningOpen = ref(false);","@@ -46,7 +47,7 @@ export function useNormalizationWarning("," \t\t\treturn;"," \t\t}"," ","-\t\tconst diff = computeValueNormalizationDiff(value.value, extraExtensions);","+\t\tconst diff = computeValueNormalizationDiff(value.value, extraExtensions, schemaKey);"," \t\tnormalizationLocked.value = diff !== null;"," \t\tnormalizationWarningDiff.value = diff ?? [];"," \t}"],"additions":2,"deletions":1,"truncated":false},{"path":"app/src/interfaces/input-rich-text-html/extensions/custom-formats.ts","lines":["@@ -23,6 +23,8 @@ export interface CustomFormat {"," export interface BuiltCustomFormats {"," \textensions: AnyExtension[];"," \tformats: CustomFormat[];","+\t/** identifies the built schema; the generated mark names don't, they're positional */","+\tkey: string;"," }"," "," /** `type: json` field meta may hand back an already-parsed array or a raw JSON string. */","@@ -113,6 +115,7 @@ function buildMark(entry: CustomFormatEntry, name: string): AnyExtension {"," export function buildCustomFormats(raw: unknown): BuiltCustomFormats {"," \tconst extensions: AnyExtension[] = [];"," \tconst formats: CustomFormat[] = [];","+\tconst accepted: CustomFormatEntry[] = [];"," "," \tparseOption(raw).forEach((entry, index) => {"," \t\tif (!isSupported(entry)) {","@@ -133,7 +136,8 @@ export function buildCustomFormats(raw: unknown): BuiltCustomFormats {"," \t\tconst name = `customFormat_${index}`;"," \t\textensions.push(buildMark(entry, name));"," \t\tformats.push({ name, title: entry.title, previewStyle: serializeStyles(entry.styles) });","+\t\taccepted.push(entry);"," \t});"," ","-