rkflow\\Registry;","+use Twig\\Extension\\AttributeExtension;","+use Twig\\Node\\Nodes;","+use Twig\\TwigFilter;","+use Twig\\TwigFunction;","+use Twig\\TwigTest;","+","+class AttributeDeclarationsTest extends TestCase","+{","+    #[DataProvider('provideExtensions')]","+    public function testAttributesDeclareTheSameCallablesAsTheExtension(string $class)","+    {","+        if (EmojiExtension::class === $class && !\\extension_loaded('intl')) {","+            $this->markTestSkipped('Extension intl is required.');","+        }","+","+        $extension = match ($class) {","+            AssetExtension::class => new AssetExtension(new Packages()),","+            EmojiExtension::class => new EmojiExtension(),","+            ExpressionExtension::class => new ExpressionExtension(),","+            HtmlSanitizerExtension::class => new HtmlSanitizerExtension(new ServiceLocator([])),","+            HttpFoundationExtension::class => new HttpFoundationExtension(new UrlHelper(new RequestStack())),","+            LogoutUrlExtension::class => new LogoutUrlExtension(new LogoutUrlGenerator()),","+            RoutingExtension::class => new RoutingExtension($this->createStub(UrlGeneratorInterface::class)),","+            SecurityExtension::class => new SecurityExtension($this->createStubForIntersectionOfInterfaces([AuthorizationCheckerInterface::class, UserAuthorizationCheckerInterface::class])),","+            WebLinkExtension::class => new WebLinkExtension(new RequestStack()),","+            WorkflowExtension::class => new WorkflowExtension(new Registry()),","+            YamlExtension::class => new YamlExtension(),","+        };","+        $attributes = new AttributeExtension($class);","+","+        $this->assertNotSame([], $attributes->getFunctions() ?: $attributes->getFilters());","+        $this->assertSame(self::describe($extension->getFunctions()), self::describe($attributes->getFunctions()));","+        $this->assertSame(self::describe($extension->getFilters()), self::describe($attributes->getFilters()));","+        $this->assertSame(self::describe($extension->getTests()), self::describe($attributes->getTests()));","+    }","+","+    public static function provideExtensions(): iterable","+    {","+        yield [AssetExtension::class];","+        yield [EmojiExtension::class];","+        yield [ExpressionExtension::class];","+        yield [HtmlSanitizerExtension::class];","+        yield [HttpFoundationExtension::class];","+        yield [LogoutUrlExtension::class];","+        yield [RoutingExtension::class];","+        yield [SecurityExtension::class];","+        yield [WebLinkExtension::class];","+        yield [WorkflowExtension::class];","+        yield [YamlExtension::class];","+    }","+","+    public function testEveryExtensionWithAttributesIsChecked()","+    {","+        $checked = array_merge(...iterator_to_array(self::provideExtensions(), false));","+","+        foreach (glob(\\dirname(__DIR__, 2).'/Extension/*Extension.php') as $file) {","+            $class = 'Symfony\\Bridge\\Twig\\Extension\\\\'.basename($file, '.php');","+","+            $attributes = new AttributeExtension($class);","+","+            if ($attributes->getFunctions() || $attributes->getFilters() || $attributes->getTests()) {","+                $this->assertContains($class, $checked);","+            }","+        }","+    }","+","+    /**","+     * @param list<TwigFunction|TwigFilter|TwigTest> $callables","+     */","+    private static function describe(array $callables): array","+    {","+        $descriptions = [];","+","+        foreach ($callables as $callable) {","+            $method = $callable->getCallable();","+            $descriptions[$callable->getName()] = [","+                'method' => $method instanceof \\Closure ? (new \\ReflectionFunction($method))->name : $method[1],","+                'safe' => $callable instanceof TwigTest ? null : $callable->getSafe(new Nodes()),","+                'needs_charset' => $callable->needsCharset(),","+   