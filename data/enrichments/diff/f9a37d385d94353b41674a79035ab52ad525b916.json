sedGrammar &grammar_p) : grammar(grammar_p) {"],"additions":31,"deletions":19,"truncated":false},{"path":"test/api/test_grammar_extension.cpp","lines":["@@ -8,6 +8,7 @@"," #include \"duckdb/common/limits.hpp\""," #include \"duckdb/main/parse_iterator.hpp\""," #include \"duckdb/main/settings.hpp\"","+#include \"duckdb/storage/buffer_manager.hpp\""," #include \"duckdb/parser/expression/constant_expression.hpp\""," #include \"duckdb/parser/grammar_extension.hpp\""," #include \"duckdb/parser/parser.hpp\"","@@ -3735,3 +3736,51 @@ TEST_CASE(\"The parser's tokens keep the literal info the tokenizer cached\", \"[ap"," \tREQUIRE_FALSE(borrowing_iterator.GetToken(0).HasLiteralInfo(table));"," \tREQUIRE(borrowed[0].GetLiteralInfo(table).LiteralId() == table.Lookup(\"SELECT\").LiteralId());"," }","+","+class MemoryLimitGrammarExtension final : public GrammarExtension {","+public:","+\tMemoryLimitGrammarExtension() : GrammarExtension(\"memory_limit_test\", \"ARENA_MEMORY\") {","+\t}","+","+\tvector<GrammarChange> GetChanges() const override {","+\t\tvector<GrammarChange> changes;","+\t\tchanges.push_back(GrammarChange::AddRule(","+\t\t    \"ArenaMemoryStatement <- 'ARENA_MEMORY'\",","+\t\t    [this](PEGTransformer &transformer, ParseResult &) -> arena_ptr<TransformProcess> {","+\t\t\t    transform_calls++;","+\t\t\t    auto &buffer_manager = transformer.options.context->GetBufferManager();","+\t\t\t    transformer.GetAllocator().Allocate(buffer_manager.GetMaxMemory());","+\t\t\t    throw InternalException(\"Transform arena allocation unexpectedly exceeded the memory limit\");","+\t\t    }));","+\t\tchanges.push_back(GrammarChange::PrependChoice(\"Statement\", \"ArenaMemoryStatement\"));","+\t\treturn changes;","+\t}","+","+\tmutable idx_t transform_calls = 0;","+};","+","+TEST_CASE(\"Top-level transform arenas honor the database memory limit\", \"[api][grammar_extension]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto extension = make_shared_ptr<MemoryLimitGrammarExtension>();","+\tGrammarExtension::Register(*db.instance, extension);","+\tREQUIRE_NO_FAIL(con.Query(\"SET active_grammar_extensions=['memory_limit_test']\"));","+\tREQUIRE_NO_FAIL(con.Query(\"SET memory_limit='16MB'\"));","+\tauto &buffer_manager = BufferManager::GetBufferManager(*con.context);","+\tconst auto memory_before = buffer_manager.GetUsedMemory();","+\tfor (idx_t attempt = 0; attempt < 2; attempt++) {","+\t\tauto result = con.Query(\"ARENA_MEMORY\");","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE(result->GetErrorType() == ExceptionType::OUT_OF_MEMORY);","+\t\tREQUIRE(extension->transform_calls == attempt + 1);","+\t\tREQUIRE(buffer_manager.GetUsedMemory() == memory_before);","+\t\tREQUIRE_NO_FAIL(con.Query(\"SELECT 42\"));","+\t}","+\tParser parser(*con.context);","+\ttry {","+\t\tparser.ParseQuery(\"ARENA_MEMORY\");","+\t\tFAIL(\"Expected an out-of-memory exception during parsing\");","+\t} catch (const OutOfMemoryException &ex) {","+\t\tREQUIRE(StringUtil::Contains(ErrorData(ex).RawMessage(), \"While parsing SQL:\"));","+\t}","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"test/sql/json/peg_memory_limit.test","lines":["@@ -0,0 +1,64 @@","+# name: test/sql/json/peg_memory_limit.test","+# description: JSON SQL and type parsing preserve PEG out-of-memory errors","+# group: [json]","+","+require json","+","+statement ok","+SET VARIABLE oversized_statement = 'SELECT [' || repeat('1,', 400000) || '1]';","+","+statement ok","+SET VARIABLE oversized_type = (","+    SELECT '\"STRUCT(' || string_agg('c' || i || ' INTEGER', ',') || ')\"'","+    FROM range(10000) t(i)","+);","+","+statement ok","+SET memory_limit='16MB';","+","+statement ok","+SET VARIABLE parser_memory_before = (","+    SELECT memory_usage_bytes FROM duckdb_memory() WHERE tag='ALLOCATOR'","+);","+","+# Allocation failure must abort the query, rather than become a successful JSON error value.","+foreach serializer json_serialize_sql json_serialize_plan","+","+statement error","+SELECT {serializer}(getvariable('oversized_statement'));","+----","+<REGEX>:Out of Memory Error: While parsing SQL: failed to allocate data of size .* \\(.*/.* used\\).*","+","+query I","+SELECT memory_usage_bytes <= getvariable('parser_memory_before')","+FROM duckdb_memory() WHERE tag='ALLOCATOR';","+----","+true","+","+endloop","+","+# Type parsing must preserve OOM instead of reporting an invalid type name.","+statement error","+SELECT json_transform('{}', getvariable('oversized_type'));","+----","+<REGEX>:Out of Memory Error: While parsing SQL: failed to allocate data of size .* \\(.*/.* used\\).*","+","+query I","+SELECT memory_usage_bytes <= getvariable('parser_memory_before')","+FROM duckdb_memory() WHERE tag='ALLOCATOR';","+----","+true","+","+# Ordinary parse errors still use the existing JSON error-value contract.","+query TT","+SELECT json_serialize_sql('SELECT') ->> 'error', json_serialize_sql('SELECT') ->> 'error_type';","+----","+true\tparser","+","+query I","+SELECT 42;","+----","+42","+","+statement ok","+RESET memory_limit;"],"additions":64,"deletions":0,"truncated":false},{"path":"test/sql/parser/peg_memory_limit.test","lines":["@@ -0,0 +1,37 @@","+# name: test/sql/parser/peg_memory_limit.test","+# description: PEG parsing honors the memory limit and releases arenas after failure","+# group: [parser]","+","+statement ok","+SET VARIABLE oversized_statement = 'SELECT [' || repeat('1,', 400000) || '1]';","+","+statement ok","+SET memory_limit='16MB';","+","+statement ok","+SET VARIABLE parser_memory_before = (","+    SELECT memory_usage_bytes FROM duckdb_memory() WHERE tag='ALLOCATOR'","+);","+","+loop attempt 0 3","+","+statement error","+SELECT * FROM query(getvariable('oversized_statement'));","+----","+<REGEX>:Out of Memory Error: While parsing SQL: failed to allocate data of size .* \\(.*/.* used\\).*","+","+query I","+SELECT memory_usage_bytes <= getvariable('parser_memory_before')","+FROM duckdb_memory() WHERE tag='ALLOCATOR';","+----","+true","+","+query I","+SELECT 42;","+----","+42","+","+endloop","+","+statement ok","+RESET memory_limit;",""],"additions":37,"deletions":0,"truncated":false}],"additions":197,"deletions":21,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-23T19:32:49.021474+00:00"}