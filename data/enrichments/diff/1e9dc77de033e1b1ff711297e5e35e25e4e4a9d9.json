{"id":"1e9dc77de033e1b1ff711297e5e35e25e4e4a9d9","axis":"silent","repo":"facebook/react-native","sha":"1e9dc77de033e1b1ff711297e5e35e25e4e4a9d9","parsed":{"files":[{"path":".github/actions/run-fantom-tests/action.yml","lines":["@@ -38,6 +38,14 @@ runs:","         exit 1","       env:","         LD_LIBRARY_PATH: ${{ github.workspace }}/private/react-native-fantom/build/tester","+    - name: Upload failed screenshot comparisons","+      if: ${{ always() }}","+      uses: ./.github/actions/upload-artifact","+      with:","+        name: fantom-screenshot-failures","+        compression-level: 1","+        if-no-files-found: ignore","+        path: private/react-native-fantom/build/screenshot-failures","     - name: Upload test results","       if: ${{ always() }}","       uses: ./.github/actions/upload-artifact"],"additions":8,"deletions":0,"truncated":false},{"path":"flow-typed/npm/jest-reporters_v29.x.x.js","lines":["@@ -0,0 +1,40 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ * @flow strict","+ * @format","+ */","+","+declare module '@jest/reporters' {","+  declare export class DefaultReporter<","+    TTestResult = unknown,","+    TAggregatedResult = unknown,","+  > {","+    constructor(globalConfig: unknown): void;","+    onRunStart(aggregatedResults: unknown, options: unknown): void;","+    onTestResult(","+      test: unknown,","+      result: TTestResult,","+      aggregatedResults: TAggregatedResult,","+    ): void | Promise<void>;","+    onRunComplete(","+      testContexts: unknown,","+      aggregatedResults: TAggregatedResult,","+    ): void;","+  }","+  declare export class VerboseReporter<","+    TTestResult = unknown,","+    TAggregatedResult = unknown,","+  > extends DefaultReporter<TTestResult, TAggregatedResult> {}","+  declare export class SummaryReporter<TAggregatedResult = unknown> {","+    constructor(globalConfig: unknown): void;","+    onRunStart(aggregatedResults: unknown, options: unknown): void;","+    onRunComplete(","+      testContexts: unknown,","+      aggregatedResults: TAggregatedResult,","+    ): void;","+  }","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/__docs__/rendering.md","lines":["@@ -117,6 +117,23 @@ the baseline directory before cleaning up the temporary file. Unused images are"," removed only during a full successful snapshot update; empty, failed, skipped or"," filtered suites preserve their baselines."," ","+Failing screenshot snapshots show expected, received and diff PNG previews in","+supported terminals instead of hash diffs, with file paths beneath the images.","+Wide terminals show Expected, Received and Difference side by side; narrow","+terminals stack them. Fantom selects the image protocol from the detected","+terminal. VS Code requires `terminal.integrated.enableImages` in its settings;","+Fantom checks the terminal's response before sending images. If that check","+cannot confirm support (including when another program is reading terminal","+input), it keeps text diagnostics and file paths without printing image headers.","+Unsupported terminals, terminal multiplexers, CI and redirected output retain","+text diagnostics and file paths. Full text diagnostics also remain when any","+required image preview is unavailable.","+","+GitHub Fantom jobs upload failed comparisons as the `fantom-screenshot-failures`","+artifact, grouped by test configuration and snapshot. Each comparison includes","+the expected, received and difference PNGs when available. Failures from earlier","+retries are retained even if a later attempt passes.","+"," ### Painting"," "," The painter traverses Fabric's mounted child order, including stacking changes."],"additions":17,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/config/jest.config.js","lines":["@@ -54,6 +54,7 @@ module.exports = {","   testPathIgnorePatterns: baseConfig.testPathIgnorePatterns,","   transformIgnorePatterns: ['.*'],","   testRunner: '<rootDir>/private/react-native-fantom/runner/index.js',","+  reporters: ['<rootDir>/private/react-native-fantom/reporter/index.js'],","   watchPathIgnorePatterns: ['<rootDir>/private/react-native-fantom/build/'],","   globalSetup:","     '<rootDir>/private/react-native-fantom/runner/global-setup/setup.js',"],"additions":1,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/reporter/ScreenshotReporter.js","lines":["@@ -0,0 +1,255 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ * @flow strict-local","+ * @format","+ */","+","+import type {ScreenshotResult} from '../runtime/ScreenshotContext';","+import type {TerminalEnvironment} from './terminalImages';","+","+import createImageRow from './imageRow';","+import saveScreenshotArtifacts from './screenshotArtifacts';","+import queryImageSupport from './terminalCapabilities';","+import {encodeTerminalImage, getImageProtocol} from './terminalImages';","+import {","+  DefaultReporter,","+  SummaryReporter,","+  VerboseReporter,","+} from '@jest/reporters';","+import fs from 'node:fs';","+import path from 'node:path';","+import tty from 'node:tty';","+","+export type TestResult = {","+  readonly failureMessage?: ?string,","+  readonly screenshotFailureMessage?: ?string,","+  readonly testResults: ReadonlyArray<","+    Readonly<{","+      fullName: string,","+      status: string,","+      screenshotResults?: ReadonlyArray<ScreenshotResult>,","+    }>,","+  >,","+};","+","+type AggregatedResult = {","+  readonly testResults: ReadonlyArray<TestResult>,","+  ...","+};","+","+interface TerminalOutput {","+  readonly isTTY?: boolean;","+  readonly columns?: number;","+  readonly rows?: number;","+  write(string): unknown;","+}","+","+export default function createScreenshotReporter(globalConfig: {","+  readonly verbose?: boolean,","+  ...","+}): DefaultReporter<TestResult, AggregatedResult> {","+  const Reporter: Class<DefaultReporter<TestResult, AggregatedResult>> =","+    globalConfig.verbose === true ? VerboseReporter : DefaultReporter;","+  const summaryReporter = new SummaryReporter<AggregatedResult>(globalConfig);","+  let terminalResults = new WeakMap<TestResult, TestResult>();","+  return new (class ScreenshotReporter extends Reporter {","+    #vsCodeImages: ?Promise<boolean> = null;","+","+    onRunStart(aggregatedResults: unknown, options: unknown): void {","+      this.#vsCodeImages = null;","+      terminalResults = new WeakMap();","+      super.onRunStart(aggregatedResults, options);","+      summaryReporter.onRunStart(aggregatedResults, options);","+    }","+","+    async onTestResult(","+      test: unknown,","+      result: TestResult,","+      aggregatedResults: AggregatedResult,","+    ): Promise<void> {","+      if (process.env.GITHUB_ACTIONS === 'true') {","+        const errors = saveScreenshotArtifacts(","+          result.testResults","+            .filter(testResult => testResult.status === 'failed')","+            .flatMap(testResult => testResult.screenshotResults ?? []),","+          path.resolve(__dirname, '../build/screenshot-failures'),","+        );","+        for (const error of errors) {","+          console.warn(error);","+        }","+      }","+      const input = process.stdin;","+      const output = process.stderr;","+      let terminalResult = result;","+      if (output instanceof tty.WriteStream) {","+        let supportsVSCodeImages = false;","+        if (","+          process.env.TERM_PROGRAM === 'vscode' &&","+          input instanceof tty.ReadStream &&","+          getImageProtocol(output.isTTY, process.env, true) != null &&","+          result.testResults.some(","+            testResult =>","+              testResult.status === 'failed' &&","+              testResult.screenshotResults?.some(","+                screenshot =>","+                  !screenshot.pass && screenshot.receivedPath != null,","+              ),","+          )","+        ) {","+          this.#vsCodeImages ??= queryImageSupport(input, output);","+          supportsVSCodeImages = await this.#vsCodeImages;","+        }","+        terminalResult = reportScreenshotPreviews(","+          result,","+          output,","+          process.env,","+          supportsVSCodeImages,","+        );","+      }","+      terminalResults.set(result, terminalResult);","+      await super.onTestResult(test, terminalResult, aggregatedResults);","+    }","+","+    onRunComplete(","+      testContexts: unknown,","+      aggregatedResults: AggregatedResult,","+    ): void {","+      super.onRunComplete(testContexts, aggregatedResults);","+      summaryReporter.onRunComplete(testContexts, {","+        ...aggregatedResults,","+        testResults: aggregatedResults.testResults.map(","+          result => terminalResults.get(result) ?? result,","+        ),","+      });","+    }","+  })(globalConfig);","+}","+","+export function reportScreenshotPreviews(","+  result: TestResult,","+  output: TerminalOutput,","+  env: TerminalEnvironment,","+  supportsVSCodeImages: boolean = false,","+): TestResult {","+  const protocol = getImageProtocol(output.isTTY, env, supportsVSCodeImages);","+  if (protocol == null) {","+    return result;","+  }","+  const readErrors = new Map<string, string>();","+  const readImage = (file: string): ?Buffer => {","+    try {","+      return fs.readFileSync(file);","+    } catch (error: unknown) {","+      const message = error instanceof Error ? error.message : String(error);","+      readErrors.set(file, message.replace(/\\p{Cc}/gu, ''));","+      return null;","+    }","+  };","+  const columns =","+    output.columns != null && output.columns > 0 ? output.columns : 80;","+  const rows = output.rows != null && output.rows > 0 ? output.rows : 30;","+  const horizontal = columns >= 60;","+  const preview = (png: Buffer) =>","+    encodeTerminalImage(png, protocol, {","+      columns: columns - 2,","+      rows: rows - 9,","+      tmux: env.TMUX != null,","+    });","+  let previews = '';","+  let hasPreview = false;","+  let allPreviewsRendered = true;","+  for (const test of result.testResults) {","+    if (test.status !== 'failed') {","+      continue;","+    }","+    for (const screenshot of test.screenshotResults ?? []) {","+      const receivedPath = screenshot.receivedPath;","+      if (screenshot.pass || receivedPath == null) {","+        continue;","+      }","+      const panels = [","+        {","+          label: 'Expected',","+          path: screenshot.expectedPath,","+          image: screenshot.isNew ? null : readImage(screenshot.expectedPath),","+          unavailable: screenshot.isNew ? 'no baseline' : 'preview unavailable',","+          required: !screenshot.isNew,","+        },","+        {","+          label: 'Received',","+          path: receivedPath,","+          image: readImage(receivedPath),","+          unavailable: 'preview unavailable',","+          required: true,","+        },","+        {","+          label: 'Difference',","+          path: screenshot.differencePath,","+          image:","+            screenshot.differencePath == null","+              ? null","+              : readImage(screenshot.differencePath),","+          unavailable: screenshot.isNew ? 'no baseline' : 'preview unavailable',","+          required: !screenshot.isNew,","+        },","+      ];","+      const title = test.fullName.replace(/\\p{Cc}/gu, '');","+      previews += `\\nScreenshot snapshot: ${title}\\n`;","+      const images = panels","+        .map(panel => panel.image)","+        .filter(image => image != null);","+      const row =","+        horizontal && images.length === panels.length","+          ? createImageRow(images)","+          : null;","+      const rowPreview = row == null ? null : preview(row);","+      if (rowPreview != null) {","+        hasPreview = true;","+        const labelWidth = Math.max(","+          8,","+          Math.floor((rowPreview.columns - 6) / 3),","+        );","+        previews +=","+          panels.map(panel => panel.label.padEnd(labelWidth)).join(' | ') +","+          '\\n';","+        previews += rowPreview.sequence + '\\n';","+        for (const panel of panels) {","+          previews += `${panel.label}: ${panel.path ?? panel.unavailable}\\n`;","+        }","+      } else {","+        for (const panel of panels) {","+          previews += `${panel.label}: ${panel.path ?? panel.unavailable}\\n`;","+          const image = panel.image == null ? null : preview(panel.image);","+          hasPreview ||= image != null;","+          allPreviewsRendered &&= image != null || !panel.required;","+          const readError = readErrors.get(panel.path ?? '');","+          previews +=","+            (image?.sequence ??","+              (readError == null","+                ? panel.unavailable","+                : `preview unavailable: ${readError}`)) + '\\n';","+        }","+      }","+    }","+  }","+  if (previews === '') {","+    return result;","+  }","+  try {","+    output.write(previews);","+  } catch {","+    return result;","+  }","+  if (","+    hasPreview &&","+    allPreviewsRendered &&","+    result.screenshotFailureMessage != null","+  ) {","+    return {...result, failureMessage: result.screenshotFailureMessage};","+  }","+  return result;","+}"],"additions":255,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/reporter/__tests__/ScreenshotReporter-test.js","lines":["@@ -0,0 +1,632 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ * @flow strict-local","+ * @format","+ */","+","+import type {ScreenshotResult} from '../../runtime/ScreenshotContext';","+import type {TestResult} from '../ScreenshotReporter';","+","+import createImageRow from '../imageRow';","+import createScreenshotReporter, {","+  reportScreenshotPreviews,","+} from '../ScreenshotReporter';","+import {encodeTerminalImage, getImageProtocol} from '../terminalImages';","+import {","+  DefaultReporter,","+  SummaryReporter,","+  VerboseReporter,","+} from '@jest/reporters';","+import {Buffer} from 'node:buffer';","+import fs from 'node:fs';","+import os from 'node:os';","+import path from 'node:path';","+import tty from 'node:tty';","+import {PNG} from 'pngjs/lib/png';","+","+jest.mock('@jest/reporters', () => {","+  class MockDefaultReporter {","+    onRunStart() {}","+    onTestResult() {}","+    onRunComplete() {}","+  }","+  return {","+    DefaultReporter: MockDefaultReporter,","+    SummaryReporter: class MockSummaryReporter {","+      onRunStart() {}","+      onRunComplete() {}","+    },","+    VerboseReporter: class MockVerboseReporter extends MockDefaultReporter {},","+  };","+});","+","+const fixture = path.join(__dirname, 'fixtures', 'preview.png');","+const png = fs.readFileSync(fixture);","+const output = jest.fn<[string], boolean>(() => true);","+let directory: string;","+let differencePath: string;","+let env: {[string]: string | void};","+let savedEnvironment: typeof process.env;","+const terminal = {isTTY: true, columns: 80, rows: 30, write: output};","+","+beforeEach(() => {","+  savedEnvironment = process.env;","+  terminal.columns = 80;","+  directory = fs.mkdtempSync(path.join(os.tmpdir(), 'fantom-preview-test-'));","+  differencePath = path.join(directory, 'image.diff.png');","+  fs.writeFileSync(","+    differencePath,","+    PNG.sync.write(new PNG({width: 64, height: 128})),","+  );","+  env = {TERM_PROGRAM: 'iTerm.app'};","+});","+","+afterEach(() => {","+  output.mockClear();","+  jest.restoreAllMocks();","+  process.env = savedEnvironment;","+  fs.rmSync(directory, {recursive: true, force: true});","+});","+","+function report(","+  changes: Partial<ScreenshotResult> = {},","+  status: string = 'failed',","+  supportsVSCodeImages: boolean = false,","+): TestResult {","+  const result: TestResult = {","+    failureMessage: 'Expected old-hash, received new-hash',","+    screenshotFailureMessage: 'Expected to match screenshot snapshot.',","+    testResults: [","+      {","+        fullName: 'Example renders',","+        status,","+        screenshotResults: [","+          {","+            fileName: 'image.png',","+            expectedPath: fixture,","+            receivedPath: fixture,","+            differencePath: changes.isNew === true ? undefined : differencePath,","+            pass: false,","+            isNew: false,","+            ...changes,","+          },","+        ],","+      },","+    ],","+  };","+  Object.freeze(result);","+  const terminalResult = reportScreenshotPreviews(","+    result,","+    terminal,","+    env,","+    supportsVSCodeImages,","+  );","+  expect(result.failureMessage).toContain('old-hash');","+  return terminalResult;","+}","+","+it('detects iTerm2, WezTerm and Kitty', () => {","+  for (const TERM_PROGRAM of ['iTerm.app', 'WezTerm']) {","+    expect(getImageProtocol(true, {TERM_PROGRAM})).toBe('iterm2');","+  }","+  expect(getImageProtocol(true, {LC_TERMINAL: 'iTerm2'})).toBe('iterm2');","+  expect(getImageProtocol(true, {TERM: 'xterm-kitty'})).toBe('kitty');","+  expect(getImageProtocol(true, {KITTY_WINDOW_ID: '1'})).toBe('kitty');","+});","+","+it('shows previews in VS Code only with confirmed image support', () => {","+  env = {TERM_PROGRAM: 'vscode', LC_TERMINAL: 'iTerm2'};","+  expect(getImageProtocol(true, env)).toBe(null);","+  expect(getImageProtocol(true, env, true)).toBe('iterm2');","+  report({}, 'failed', true);","+  expect(output).toHaveBeenCalledTimes(1);","+});","+","+it('keeps the image row header out of VS Code without confirmed image support', () => {","+  env = {TERM_PROGRAM: 'vscode'};","+  const result = report();","+  expect(output).not.toHaveBeenCalled();","+  expect(result.failureMessage).toContain('old-hash');","+});","+","+it('keeps text diagnostics in terminal multiplexers', () => {","+  for (const multiplexer of [{TMUX: '/tmp/tmux'}, {STY: 'screen-session'}]) {","+    env = {TERM_PROGRAM: 'iTerm.app', ...multiplexer};","+    expect(getImageProtocol(true, env)).toBe(null);","+    report();","+    expect(output).not.toHaveBeenCalled();","+  }","+});","+","+it('uses the detected terminal identity over SSH', () => {","+  expect(","+    getImageProtocol(true, {SSH_TTY: '/dev/pts/0', TERM_PROGRAM: 'iTerm.app'}),","+  ).toBe('iterm2');","+  expect(","+    getImageProtocol(true, {SSH_TTY: '/dev/pts/0', TERM: 'xterm-kitty'}),","+  ).toBe('kitty');","+});","+","+it('keeps image sequences out of CI, pipes and unsupported terminals', () => {","+  expect(getImageProtocol(false, {TERM_PROGRAM: 'vscode'})).toBe(null);","+  expect(getImageProtocol(true, {TERM: 'xterm-256color'})).toBe(null);","+  expect(getImageProtocol(true, {CI: '1', TERM_PROGRAM: 'iTerm.app'})).toBe(","+    null,","+  );","+  env.CI = 'true';","+  report();","+  expect(output).not.toHaveBeenCalled();","+});","+","+it('shows saved expected, received and difference PNGs in one row', () => {","+  report();","+  const text = output.mock.calls[0][0];","+  expect(text).toContain('Screenshot snapshot: Example renders');","+  expect(text).toMatch(/Expected +\\| Received +\\| Difference/);","+  expect(text).toContain(`Expected: ${fixture}`);","+  expect(text).toContain(`Received: ${fixture}`);","+  expect(text).toContain(`Difference: ${differencePath}`);","+  const images = [...text.matchAll(/preserveAspectRatio=1:([A-Za-z0-9+/=]+)/g)];","+  expect(images.length).toBe(1);","+  const row = PNG.sync.read(Buffer.from(images[0][1], 'base64'));","+  const baseline = PNG.sync.read(png);","+  const difference = PNG.sync.read(fs.readFileSync(differencePath));","+  expect(row.width).toBe(224);","+  expect(row.height).toBe(128);","+  for (const [panel, image] of [baseline, baseline, difference].entries()) {","+    for (let y = 0; y < image.height; y++) {","+      const offset = (y * row.width + panel * 80) * 4;","+      expect(","+        row.data","+          .subarray(offset, offset + image.width * 4)","+          .equals(","+            image.data.subarray(y * image.width * 4, (y + 1) * image.width * 4),","+          ),","+      ).toBe(true);","+    }","+  }","+  expect(text).not.toContain('\\x1b7');","+});","+","+it('removes terminal control characters from test names while preserving Unicode text', () => {","+  const result = report();","+  output.mockClear();","+  reportScreenshotPreviews(","+    {","+      ...result,","+      testResults: result.testResults.map(test => ({","+        ...test,","+        fullName: '\\x00\\x1b[31mPreview\\n\\x7f\\u0085 😀',","+      })),","+    },","+    terminal,","+    env,","+  );","+  expect(output.mock.calls[0][0]).toContain(","+    'Screenshot snapshot: [31mPreview 😀',","+  );","+  expect(output.mock.calls[0][0]).not.toContain('\\x1b[31m');","+});","+","+it('chunks Kitty transfers and preserves the complete PNG', () => {","+  const text =","+    encodeTerminalImage(png, 'kitty', {columns: 78, rows: 25, tmux: false})","+      ?.sequence ?? '';","+  const chunks = text","+    .split('\\x1b_G')","+    .slice(1)","+    .map(packet => {","+      expect(packet.endsWith('\\x1b\\\\')).toBe(true);","+      return packet.slice(0, -2).split(';');","+    });","+  expect(chunks.length).toBeGreaterThan(1);","+  expect(chunks[0][0]).toContain('a=T,f=100,t=d,q=2,');","+  expect(chunks[chunks.length - 1][0]).toBe('m=0');","+  for (const [index, chunk] of chunks.entries()) {","+    expect(chunk[1].length).toBeLessThanOrEqual(4096);","+    if (index !== chunks.length - 1) {","+      expect(chunk[0]).toContain('m=1');","+    }","+  }","+  expect(","+    Buffer.from(chunks.map(chunk => chunk[1]).join(''), 'base64').equals(png),","+  ).toBe