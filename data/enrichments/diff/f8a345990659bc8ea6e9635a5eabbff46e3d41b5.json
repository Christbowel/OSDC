Inputs<'b> {","         resolve::ImporterInputs {","             hooks: pnpm_resolving_deps_resolver::ManifestTransformHooks {","@@ -360,6 +340,7 @@ impl<'a, Reporter: self::Reporter + 'static> ResolutionContext<'a, Reporter> {","             versions: crate::install_with_fresh_lockfile::resolution_inputs::ImporterVersionSeeds {","                 shared: preferred_versions_seed,","                 by_importer: preferred_versions_seeds_by_importer,","+                own_manifest_specifiers,","                 pick_lowest: self.setup.policy.pick_lowest_direct,","                 published_by: self.setup.policy.published_by,","             },"],"additions":5,"deletions":24,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolution/automatic_dedupe.rs","lines":["@@ -121,6 +121,7 @@ impl<Reporter: pnpm_reporter::Reporter + 'static> super::ResolutionContext<'_, R","             lockfile_reuse_seed.is_some(),","         );","         dedupe.merge(stale_override_targets);","+        let own_manifest_specifiers = self.own_manifest_specifiers(importer_manifests);","         loop {","             let walk = self.workspace_walk(lockfile_reuse_seed.as_ref(), dedupe.clone());","             let result = resolve::run_dependency_pass::<Reporter>(resolve::ResolvePassInputs {","@@ -132,6 +133,7 @@ impl<Reporter: pnpm_reporter::Reporter + 'static> super::ResolutionContext<'_, R","                     &shared_resolve_options,","                     &preferred_versions_seed,","                     &preferred_versions_seeds_by_importer,","+                    own_manifest_specifiers.as_ref(),","                 ),","             })","             .await?;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolution/preferred_seeds.rs","lines":["@@ -0,0 +1,127 @@","+use super::{ResolutionContext, resolve};","+use crate::install_with_fresh_lockfile::resolution_inputs::OwnManifestSpecifiers;","+use pipe_trait::Pipe;","+use pnpm_catalogs_types::Catalogs;","+use pnpm_lockfile_preferred_versions::{","+    DirectSpecs, get_preferred_versions_from_lockfile_and_manifests,","+};","+use pnpm_package_manifest::{DependencyGroup, PackageManifest};","+use pnpm_reporter::Reporter;","+use pnpm_resolving_deps_resolver::UpdateTargets;","+use pnpm_resolving_resolver_base::{PreferredVersions, PreferredVersionsOverlay, VersionSelectors};","+use rayon::prelude::*;","+use std::{","+    collections::{BTreeMap, HashSet},","+    sync::Arc,","+};","+","+impl<Reporter: self::Reporter + 'static> ResolutionContext<'_, Reporter> {","+    pub(super) fn preferred_versions_seeds(","+        &self,","+        importer_manifests: &BTreeMap<String, &PackageManifest>,","+        stale_override_targets: &UpdateTargets,","+    ) -> (Arc<PreferredVersions>, BTreeMap<String, Arc<PreferredVersions>>) {","+        let manifests: Vec<&PackageManifest> = if self.dedupes_across_projects() {","+            importer_manifests","+                .values()","+                .copied()","+                .collect()","+        } else {","+            Vec::new()","+        };","+        resolve::preferred_versions_seeds(","+            &self.owned.resolution.update_seed_policy,","+            self.wanted_lockfile(),","+            DirectSpecs { manifests: &manifests, catalogs: &self.owned.projects.catalogs },","+            self.owned.resolution.preferred_versions_override.as_ref(),","+            stale_override_targets,","+        )","+    }","+","+    /// Whether every project's manifest specifiers steer the version picks of","+    /// the whole workspace. Without it, a project resolves its dependencies","+    /// from its own ranges, as it would with its own lockfile, and only its","+    /// peer-only `peerDependencies` follow the other projects.","+    fn dedupes_across_projects(&self) -> bool {","+        self.install.drivers.config.auto_dedupe","+            || matches!(","+                self.owned.resolution.update_seed_policy,","+                super::super::UpdateSeedPolicy::KeepAllResolveAll,","+            )","+    }","+","+    /// Each project's own manifest specifiers, when","+    /// [`Self::dedupes_across_projects`] keeps them out of the seed.","+    pub(super) fn own_manifest_specifiers(","+        &self,","+        importer_manifests: &BTreeMap<String, &PackageManifest>,","+    ) -> Option<OwnManifestSpecifiers> {","+        if self.dedupes_across_projects() {","+            return None;","+        }","+        own_manifest_specifiers(importer_manifests, &self.owned.projects.catalogs).pipe(Some)","+    }","+}","+","+fn own_manifest_specifiers(","+    importer_manifests: &BTreeMap<String, &PackageManifest>,","+    catalogs: &Catalogs,","+) -> OwnManifestSpecifiers {","+    let mut by_importer: BTreeMap<String, PreferredVersions> = importer_manifests","+        .par_iter()","+        .map(|(id, manifest)| {","+            let direct = DirectSpecs { manifests: &[manifest], catalogs };","+            (id.clone(), get_preferred_versions_from_lockfile_and_manifests(None, direct))","+        })","+        .collect();","+    let peer_additions: Vec<(String, String, VersionSelectors)> = importer_manifests","+        .iter()","+        .flat_map(|(id, manifest)| {","+            peer_only_names(manifest)","+                .into_iter()","+                .map(|peer_name| {","+                    let selectors: VersionSelectors = by_importer","+                        .values()","+                        .filter_map(|preferred| preferred.get(peer_name))","+                        .flatten()","+                        .map(|(k, v)| (k.clone(), v.clone()))","+                        .collect();","+                    (id.clone(), peer_name.to_string(), selectors)","+                })","+        })","+        .filter(|(_, _, selectors)| !selectors.is_empty())","+        .collect();","+    for (id, peer_name, selectors) in peer_additions {","+        by_importer","+            .entry(id)","+            .or_default()","+            .entry(peer_name)","+            .or_default()","+            .extend(selectors);","+    }","+    by_importer","+        .into_iter()","+        .filter_map(|(id, preferred)| {","+            Some((id, PreferredVersionsOverlay::manifest_specifiers(preferred)?))","+        })","+        .collect()","+}","+","+fn peer_only_names(manifest: &PackageManifest) -> Vec<&str> {","+    if manifest","+        .dependencies([DependencyGroup::Peer])","+        .next()","+        .is_none()","+    {","+        return Vec::new();","+    }","+    let direct: HashSet<&str> = manifest","+        .dependencies([DependencyGroup::Dev, DependencyGroup::Prod, DependencyGroup::Optional])","+        .map(|(name, _)| name)","+        .collect();","+    manifest","+        .dependencies([DependencyGroup::Peer])","+        .map(|(name, _)| name)","+        .filter(|name| !direct.contains(name))","+        .collect()","+}"],"additions":127,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolution_inputs.rs","lines":["@@ -3,7 +3,7 @@ use pnpm_config::{Config, NeedsFullMetadataFor};"," use pnpm_lockfile::Lockfile;"," use pnpm_network::{AuthHeaders, ThrottledClient};"," use pnpm_resolving_npm_resolver::InMemoryPackageMetaCache;","-use pnpm_resolving_resolver_base::PreferredVersions;","+use pnpm_resolving_resolver_base::{PreferredVersions, PreferredVersionsOverlay};"," use pnpm_store_dir::{","     SharedReadonlyStoreIndex, SharedVerifiedFilesCache, StoreDir, StoreIndexWriter,"," };","@@ -22,9 +22,16 @@ pub(crate) struct WorkspaceLifecycleHooks {","     pub finalized_package: Option<pnpm_resolving_deps_resolver::FinalizedPackageFn>,"," }"," ","+/// Each importer's root preference layer of the specifiers its manifest","+/// declares, keyed by importer id.","+pub(crate) type OwnManifestSpecifiers = BTreeMap<String, Arc<PreferredVersionsOverlay>>;","+"," pub(crate) struct ImporterVersionSeeds<'a> {","     pub shared: &'a Arc<PreferredVersions>,","     pub by_importer: &'a BTreeMap<String, Arc<PreferredVersions>>,","+    /// Each importer's own manifest specifiers, when the seeds leave out other","+    /// projects' specifiers. `None` when those steer every project.","+    pub own_manifest_specifiers: Option<&'a OwnManifestSpecifiers>,","     /// See [`crate::resolution_policy::PickPolicy`].","     pub pick_lowest: bool,","     pub published_by: Option<chrono::DateTime<chrono::Utc>>,","@@ -103,6 +110,13 @@ impl<'a> ImporterVersionSeeds<'a> {","     pub(super) fn for_importer(&self, id: &str) -> &'a Arc<PreferredVersions> {","         self.by_importer.get(id).unwrap_or(self.shared)","     }","+","+    pub(super) fn own_manifest_specifiers_of(","+        &self,","+        id: &str,","+    ) -> Option<Arc<PreferredVersionsOverlay>> {","+        self.own_manifest_specifiers?.get(id).map(Arc::clone)","+    }"," }"," "," pub(crate) struct FreshLockfilePrior<'a> {"],"additions":15,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolve.rs","lines":["@@ -215,6 +215,19 @@ impl ImporterInputs<'_> {","         usize::try_from(self.config.peers_suffix_max_length).unwrap_or(usize::MAX)","     }"," ","+    fn importer_base_opts(","+        &self,","+        importer_id: &str,","+        project_dir: std::path::PathBuf,","+        preferred_versions: &Arc<PreferredVersions>,","+    ) -> ResolveOptions {","+        let mut base_opts =","+            self.shared_resolve_options.build(project_dir, Arc::clone(preferred_versions));","+        base_opts.version.preferred_versions_overlay =","+            self.versions.own_manifest_specifiers_of(importer_id);","+        base_opts","+    }","+","     fn resolve_importer_options(","         &self,","         importer: &pnpm_resolving_deps_resolver::WorkspaceImporter<'_>,","@@ -228,10 +241,7 @@ impl ImporterInputs<'_> {","             .to_path_buf()