ep-of-pkg-with-1-dep\".parse().expect(\"parse the dependency name\"))","+            .expect(\"the parent pins dep-of-pkg-with-1-dep\")","+            .to_string();","+        assert_eq!(transitive_pin, \"100.0.0\", \"direct_spec = {direct_spec}\");","+        let installed = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","+","+        for _ in 0..2 {","+            pacquet_at(&workspace)","+                .with_args([\"dedupe\", \"--lockfile-only\"])","+                .assert()","+                .success();","+            let deduped = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","+            assert_eq!(deduped, installed, \"direct_spec = {direct_spec}\");","+        }","+        pacquet_at(&workspace)","+            .with_args([\"dedupe\", \"--check\", \"--lockfile-only\"])","             .assert()","             .success();","-        let deduped = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","-        assert_eq!(deduped, installed);","     }","-    pacquet_at(&workspace)","-        .with_args([\"dedupe\", \"--check\", \"--lockfile-only\"])","-        .assert()","-        .success();"," ","     drop((root, mock_instance));"," }","@@ -276,9 +279,15 @@ fn direct_dep_bump_in_one_importer_converges_another_importers_transitive_pin()"," ","     write_b(\"100.0.0\");","     pacquet_at(&workspace)","-        .with_arg(\"install\")","+        .with_args([\"install\", \"--auto-dedupe\"])","         .assert()","         .success();","+    let first_lockfile =","+        fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(","+        !first_lockfile.contains(\"@pnpm.e2e/dep-of-pkg-with-1-dep@100.1.0\"),","+        \"the first install must pin project a's transitive dependency to 100.0.0:\\n{first_lockfile}\",","+    );"," ","     write_b(\"100.1.0\");","     bump_mtime(&b_manifest);"],"additions":47,"deletions":38,"truncated":false},{"path":"pnpm/crates/pac