{"id":"f8a345990659bc8ea6e9635a5eabbff46e3d41b5","axis":"silent","repo":"pnpm/pnpm","sha":"f8a345990659bc8ea6e9635a5eabbff46e3d41b5","parsed":{"files":[{"path":".changeset/direct-deps-resolve-from-own-ranges.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+When `autoDedupe` is off, a workspace project's dependencies now resolve from its own ranges, like they do with `sharedWorkspaceLockfile: false`. Previously, another project's narrower range could hold them back. For example, `ajv: \"*\"` now resolves to the latest Ajv even if another project depends on `ajv@^6`. Packages that a project lists in `peerDependencies` still follow the versions other projects use. `pnpm dedupe` and installs with `autoDedupe: true` still pick one version that satisfies every range. Set `autoDedupe: true` if CI runs `pnpm dedupe --check` [#17235](https://github.com/pnpm/pnpm/issues/17235)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/auto_dedupe.rs","lines":["@@ -649,3 +649,59 @@ fn filtered_downgrade_reaches_other_projects_on_the_next_install() {","     assert_eq!(installed(\"high\"), \"100.0.0\");","     drop((root, npmrc_info));"," }","+","+#[test]","+fn another_projects_range_steers_a_direct_dependency_only_when_deduping() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_settings(&workspace, \"packages:\\n  - pinned\\n  - open\\n  - peer\\n\").unwrap();","+    write_project(&workspace, \"pinned\", \"100.0.0\");","+    write_project(&workspace, \"open\", \"*\");","+    fs::create_dir_all(workspace.join(\"peer\")).unwrap();","+    fs::write(","+        workspace.join(\"peer/package.json\"),","+        serde_json::json!({","+            \"name\": \"peer\",","+            \"peerDependencies\": {DEP: \">=100.0.0\"},","+        })","+        .to_string(),","+    )","+    .unwrap();","+    let lockfile_path = workspace.join(\"pnpm-lock.yaml\");","+","+    pnpm_at(&workspace)","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let lockfile = read_lockfile(&lockfile_path);","+    assert_eq!(importer_version(&lockfile, \"pinned\", DEP), \"100.0.0\");","+    assert_eq!(importer_version(&lockfile, \"open\", DEP), \"101.0.0\");","+    assert_eq!(importer_version(&lockfile, \"peer\", DEP), \"100.0.0\");","+","+    pnpm_at(&workspace)","+        .with_args([\"dedupe\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let lockfile = read_lockfile(&lockfile_path);","+    assert_eq!(importer_version(&lockfile, \"open\", DEP), \"100.0.0\");","+    assert_eq!(importer_version(&lockfile, \"peer\", DEP), \"100.0.0\");","+","+    fs::remove_file(&lockfile_path).unwrap();","+    pnpm_at(&workspace)","+        .with_args([\"install\", \"--auto-dedupe\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let lockfile = read_lockfile(&lockfile_path);","+    assert_eq!(importer_version(&lockfile, \"open\", DEP), \"100.0.0\");","+    assert_eq!(importer_version(&lockfile, \"peer\", DEP), \"100.0.0\");","+","+    pnpm_at(&workspace)","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let lockfile = read_lockfile(&lockfile_path);","+    assert_eq!(importer_version(&lockfile, \"open\", DEP), \"100.0.0\");","+    assert_eq!(importer_version(&lockfile, \"peer\", DEP), \"100.0.0\");","+    drop((root, mock_instance));","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_filters/mutations.rs","lines":["@@ -263,8 +263,18 @@ fn filtered_compatible_update_does_not_cross_importer_cache_boundaries() {"," }"," "," #[test]","-fn filtered_compatible_update_keeps_workspace_manifest_preferences() {","+fn filtered_compatible_update_keeps_workspace_manifest_preferences_when_deduping() {","+    assert_filtered_compatible_update(\"autoDedupe: true\\n\", \"100.0.0\");","+}","+","+#[test]","+fn filtered_compatible_update_ignores_another_projects_manifest_without_dedupe() {","+    assert_filtered_compatible_update(\"\", \"100.1.0\");","+}","+","+fn assert_filtered_compatible_update(settings: &str, expected: &str) {","     let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(settings);","     let selected = fixture.project(","         \"selected\",","         \"selected\",","@@ -282,7 +292,7 @@ fn filtered_compatible_update_keeps_workspace_manifest_preferences() {","     fixture.run([\"--filter\", \"selected\", \"update\", DEP, \"--lockfile-only\"]);","     let lockfile = fixture.wanted();"," ","-    assert_eq!(importer_version(&lockfile, \"packages/selected\", DEP), \"100.0.0\");","+    assert_eq!(importer_version(&lockfile, \"packages/selected\", DEP), expected);","     assert_eq!(importer_version(&lockfile, \"packages/unselected\", DEP), \"100.0.0\");","     assert_eq!(","         fs::read(unselected.join(\"package.json\")).expect(\"read manifest\"),"],"additions":12,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/stale_pin_dedupe.rs","lines":["@@ -185,48 +185,51 @@ fn dedupe_does_not_refresh_a_pin_onto_an_aliased_direct_dependency() {","     let AddMockedRegistry { mock_instance, .. } = npmrc_info;"," ","     let lockfile_path = workspace.join(\"pnpm-lock.yaml\");","-    fs::write(","-        workspace.join(\"package.json\"),","-        serde_json::json!({","-            \"dependencies\": {","-                \"@pnpm.e2e/dep-of-pkg-with-1-dep\": \"100.0.0\",","-                \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\",","-                \"latest\": \"npm:@pnpm.e2e/dep-of-pkg-with-1-dep@100.1.0\",","-            }","-        })","-        .to_string(),","-    )","-    .expect(\"write package.json\");","+    for direct_spec in [\"100.0.0\", \"~100.0.0\"] {","+        let _ = fs::remove_file(&loc