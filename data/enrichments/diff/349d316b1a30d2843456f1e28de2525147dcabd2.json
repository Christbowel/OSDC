ions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/storage_config.rs","lines":["@@ -292,7 +292,7 @@ fn network_metadata(file: &DatabaseFile, url: &str) -> Result<MetadataBackend, R"," }"," "," fn is_network_sql_url(url: &str) -> bool {","-    [\"postgres:\", \"postgresql:\", \"mysql:\"]","+    [\"postgres://\", \"postgresql://\", \"mysql://\"]","         .iter()","         .any(|prefix| {","             url.get(..prefix.len())"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/config/src/tests/storage.rs","lines":["@@ -412,3 +412,18 @@ fn libsql_settings_need_a_libsql_url_and_a_replica_needs_a_sync_interval() {","         assert!(matches!(err, RegistryError::InvalidConfig { .. }), \"{yaml}: {err:?}\");","     }"," }","+","+#[test]","+fn network_sql_urls_require_double_slash_authority() {","+    for raw in [","+        \"postgres:user:secret@db.example.test/pnpr\",","+        \"postgresql:user:secret@db.example.test/pnpr\",","+        \"mysql:user:secret@db.example.test/pnpr\",","+    ] {","+        let yaml = format!(\"storage: /s\\ndatabase:\\n  url: {raw}\\n\");","+        let err = Config::from_yaml_str(&yaml, Path::new(\"/\"), listen(), None).unwrap_err();","+        let rendered = err.to_string();","+        assert!(matches!(err, RegistryError::InvalidConfig { .. }), \"{raw}: {rendered}\");","+        assert!(!rendered.contains(\"secret\"), \"{raw}: {rendered}\");","+    }","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"pnpr/crates/libsql/src/testing.rs","lines":["@@ -7,9 +7,11 @@"," "," pub use hrana::RoundTrips;"," pub use plain_http::{EXECUTE_RESPONSE, PlainHttpServer, serve_plain_http};","+pub use tls_proxy::serve_tls_proxy;"," "," mod hrana;"," mod plain_http;","+mod tls_proxy;"," "," use axum::{","     Json, Router,"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/libsql/src/testing/tls_proxy.rs","lines":["@@ -0,0 +1,50 @@","+use rustls::{","+    ServerConfig,","+    pki_types::{CertificateDer, PrivateKeyDer, pem::PemObject},","+};","+use std::{net::SocketAddr, sync::Arc};","+use tokio::{","+    io::copy_bidirectional,","+    net::{TcpListener, TcpStream},","+    task::JoinHandle,","+};","+use tokio_rustls::TlsAcceptor;","+","+/// Terminate TLS on loopback with `(cert_pem, key_pem)` and forward each","+/// connection to `upstream`.","+pub async fn serve_tls_proxy(","+    upstream: SocketAddr,","+    cert_pem: &[u8],","+    key_pem: &[u8],","+) -> (SocketAddr, JoinHandle<()>) {","+    let acceptor = TlsAcceptor::from(server_config(cert_pem, key_pem));","+    let listener = TcpListener::bind(\"127.0.0.1:0\").await.expect(\"bind TLS proxy\");","+    let address = listener.local_addr().expect(\"TLS proxy address\");","+    let handle = tokio::spawn(async move {","+        while let Ok((stream, _)) = listener.accept().await {","+            let acceptor = acceptor.clone();","+            tokio::spawn(forward_connection(acceptor, stream, upstream));","+        }","+    });","+    (address, handle)","+}","+","+async fn forward_connection(acceptor: TlsAcceptor, stream: TcpStream, upstream: SocketAddr) {","+    let Ok(mut client) = acceptor.accept(stream).await else { return };","+    let Ok(mut backend) = TcpStream::connect(upstream).await else { return };","+    let _ = copy_bidirectional(&mut client, &mut backend).await;","+}","+","+fn server_config(cert_pem: &[u8], key_pem: &[u8]) -> Arc<ServerConfig> {","+    let cert = CertificateDer::from_pem_slice(cert_pem).expect(\"parse server certificate\");","+    let key = PrivateKeyDer::from_pem_slice(key_pem).expect(\"parse server key\");","+    let provider = Arc::new(rustls::crypto::aws_lc_rs::default_provider());","+    Arc::new(","+        ServerConfig::builder_with_provider(provider)","+            .with_safe_default_protocol_versions()","+            .expect(\"supported TLS protocol versions\")","+            .with_no_client_auth()","+            .with_single_cert(vec![cert], key)","+            .expect(\"configure TLS server\"),","+    )","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/config_check.rs","lines":["@@ -71,7 +71,11 @@ pub fn check_config(config_path: Option<&Path>) -> miette::Result<ConfigCheckRep","     )","     .map_err(|err| miette::miette!(\"{err}\"))?;"," ","-    check_resolved_config(&mut config, &source).map_err(|error| miette::miette!(\"{error}\"))","+    check_resolved_config(&mut config, &source)","+        .map_err(|error| {","+            let message = error.log_message();","+            miette::miette!(\"{message}\")","+        })"," }"," "," fn summarize_registry(config: &Config, name: &str) -> RegistrySummary {"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/config_validation.rs","lines":["@@ -1,52 +1,136 @@","-use pnpr_config::{Config, MetadataBackend};","+use pnpr_config::{BackendConfig, Config, LibsqlSettings, MetadataBackend, SqlBackendSettings};","+use pnpr_error::{RegistryError, Result};","+use url::Url;"," "," /// Validate startup settings without opening databases or creating files."," ///"," /// # Errors"," ///"," /// A server setting is invalid or its database driver is unavailable.","-pub(crate) fn validate_startup_config(config: &mut Config) -> pnpr_error::Result<()> {","+pub(crate) fn validate_startup_config(config: &mut Config) -> Result<()> {","     config.features.ensure_a_feature_is_enabled()?;","     config.routing.ensure_valid_registry_graph(config.features.registry.enabled)?;","     config.http.ensure_valid_metrics()?;","-    validate_database_url(&config.storage.metadata)?;","-    let available = match &config.storage.metadata {","-        MetadataBackend::Sqlite(_) => true,","-        MetadataBackend::Postgres(_) => cfg!(feature = \"backend-postgres\"),","-        MetadataBackend::Mysql(_) => cfg!(feature = \"backend-mysql\"),","-        MetadataBackend::Libsql(settings) => {","-            #[cfg(feature = \"backend-libsql\")]","-            pnpr_libsql::validate_settings(settings, \"database\")?;","-            #[cfg(not(feature = \"backend-libsql\"))]","-            let _ = settings;","-            cfg!(feature = \"backend-libsql\")","+    validate_metadata_backend(&config.storage.metadata)?;","+    validate_identity_backend(&config.identity.backend)?;","+    Ok(())","+}","+","+fn validate_metadata_backend(metadata: &MetadataBackend) -> Result<()> {","+    match metadata {","+        MetadataBackend::Sqlite(path) if path.as_os_str().is_empty() => {","+            Err(invalid(\"database.url `sqlite:` needs a path after the colon\"))","         }","-    };","-    if !available {","-        return Err(pnpr_error::RegistryError::InvalidConfig {","-            reason: \"this build does not include the configured database driver\".to_string(),","-        });","+        MetadataBackend::Sqlite(_) => Ok(()),","+        MetadataBackend::Postgres(settings) => validate_postgres(settings),","+        MetadataBackend::Mysql(settings) => validate_mysql(settings),","+        MetadataBackend::Libsql(settings) => validate_libsql(settings),","+    }","+}","+","+fn validate_identity_backend(backend: &BackendConfig) -> Result<()> {","+    match backend {","+        BackendConfig::Local => Ok(()),","+        BackendConfig::Postgres(settings) => validate_postgres(settings),","+        BackendConfig::Mysql(settings) => validate_mysql(settings),","+        BackendConfig::Libsql(settings) => validate_libsql(settings),","+    }","+}","+","+fn validate_postgres(settings: &SqlBackendSettings) -> Result<()> {","+    validate_sql_pool(settings)?;","+    let parsed = parse_hierarchical_url(&settings.url)?;","+    if !matches!(parsed.scheme(), \"postgres\" | \"postgresql\") {","+        return Err(invalid_url());","+    }","+    if !cfg!(feature = \"backend-postgres\") {","+        return Err(missing_driver());","+    }","+    #[cfg(feature = \"backend-postgres\")]","+    {","+        use std::str::FromStr as _;","+        sqlx::postgres::PgConnectOptions::from_str(&settings.url).map_err(|_| invalid_url())?;","     }","     Ok(())"," }"," ","-fn validate_database_url(metadata: &MetadataBackend) -> pnpr_error::Result<()> {","-    let target = match metadata {","-        MetadataBackend::Sqlite(_) => None,","-        MetadataBackend::Postgres(settings) | MetadataBackend::Mysql(settings) => {","-            if settings.max_connections == Some(0) {","-                return Err(pnpr_error::RegistryError::InvalidConfig {","-                    reason: \"database.maxConnections must be greater than 0\".to_string(),","-                });","-            }","-            Some(&settings.url)","-        }","-        MetadataBackend::Libsql(settings) => Some(&settings.url),","-    };","-    if target.is_some_and(|target| url::Url::parse(target).is_err()) {","-        return Err(pnpr_error::RegistryError::InvalidConfig {","-            reason: \"database.url is not a valid URL\".to_string(),","-        });","+fn validate_mysql(settings: &SqlBackendSettings) -> Result<()> {","+    validate_sql_pool(settings)?;","+    let parsed = parse_hierarchical_url(&settings.url)?;","+    if parsed.scheme() != \"mysql\" {","+        return Err(invalid_url());","+    }","+    if !cfg!(feature = \"backend-mysql\") {","+        return Err(missing_driver());","+    }","+    #[cfg(feature = \"backend-mysql\")]","+    {","+        use std::str::FromStr as _;","+        sqlx::mysql::MySqlConnectOptions::from_str(&settings.url).map_err(|_| invalid_url())?;","     }","     Ok(())"," }","+","+fn validate_libsql(settings: &LibsqlSettings) -> Result<()> {","+    if settings.max_connections == Some(0) {","+        return Err(invalid(\"database.maxConnections must be greater than 0\"));","+    }","+    if settings.replica_path.is_some() && settings.sync_interval_secs == Some(0) {","+        return Err(invalid(","+            \"database.syncInterval must be at least 1s with a replicaPath: it bounds how stale a \\","+             replica read may be\",","+        ));","+    }","+    let parsed = parse_hierarchical_url(&settings.url)?;","+    let has_host = parsed","+        .host_str()","+        .is_some_and(|host| !host.is_empty());","+    if !matches!(parsed.scheme(), \"libsql\" | \"http\" | \"https\") || !has_host {","+        return Err(invalid_url());","+    }","+    if !cfg!(feature = \"backend-libsql\") {","+        return Err(missing_driver());","+    }","+    #[cfg(feature = \"backend-libsql\")]","+    pnpr_libsql::validate_settings(settings, \"database\")?;","+    Ok(())","+}","+","+fn validate_sql_pool(settings: &SqlBackendSettings) -> Result<()> {","+    if settings.max_connections == Some(0) {","+        return Err(invalid(\"database.maxConnections must be greater than 0\"));","+    }","+    if settings.timeout.is_zero() {","+        return Err(invalid(\"database.timeout must be greater than 0\"));","+    }","+    if settings.startup_timeout.is_zero() {","+        return Err(invalid(\"database.startupTimeout must be greater than 0\"));","+    }","+    Ok(())","+}","+","+fn parse_hierarchical_url(raw: &str) -> Result<Url> {","+    let parsed = Url::parse(raw).map_err(|_| invalid_url())?;","+    let has_authority_prefix = raw","+        .get(parsed.scheme().len()..)","+        .is_some_and(|rest| rest.starts_with(\"://\"));","+    if parsed.cannot_be_a_base() || !has_authority_prefix {","+        return Err(invalid_url());","+    }","+    Ok(parsed)","+}","+","+fn invalid_url() -> RegistryError {","+    invalid(\"database.url is not a valid URL\")","+}","+","+fn missing_driver() -> RegistryError {","+    invalid(\"this build does not include the configured database driver\")","+}","+","+fn invalid(reason: &str) -> RegistryError {","+    RegistryError::InvalidConfig { reason: reason.to_string() }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":119,"deletions":35,"truncated":false},{"path":"pnpr/crates/pnpr/src/config_validation/tests.rs","lines":["@@ -0,0 +1,127 @@","+use super::validate_startup_config;","+use pnpr_config::{BackendConfig, Config, LibsqlSettings, MetadataBackend, SqlBackendSettings};","+use std::{","+    net::{Ipv4Addr, SocketAddr, SocketAddrV4},","+    path::{Path, PathBuf},","+    time::Duration,","+};","+","+fn base_config() -> Config {","+    let listen = SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST, 4873));","+    Config::from_default_yaml(Path::new(\"/etc/pnpr\"), listen, None)","+}","+","+fn sql_settings(url: &str) -> SqlBackendSettings {","+    SqlBackendSettings {","+        url: url.to_string(),","+        max_connections: Some(4),","+        timeout: Duration::from_secs(30),","+        startup_timeout: Duration::from_mins(1),","+    }","+}","+","+fn libsql_settings(url: &str) -> LibsqlSettings {","+    LibsqlSettings {","+        url: url.to_string(),","+        auth_token: None,","+        replica_path: None,","+        sync_interval_secs: None,","+        max_connections: Some(4),","+    }","+}","+","+#[test]","+fn rejects_empty_sqlite_path_on_programmatic_config() {","+    let mut config = base_config();","+    config.storage.metadata = MetadataBackend::Sqlite(PathBuf::new());","+    let err = validate_startup_config(&mut config).unwrap_err().to_string();","+    assert!(err.contains(\"sqlite:\"), \"{err}\");","+}","+","+#[test]","+fn rejects_invalid_libsql_urls_without_leaking_credentials() {","+    for url in [","+        \"libsql://\",","+        \"libsql:///missing-host\",","+        \"postgres://user:supersecret@db.example.test/pnpr\",","+        \"libsql:user:supersecret@db.example.test\",","+    ] {","+        let mut config = base_config();","+        config.storage.metadata = MetadataBackend::Libsql(libsql_settings(url));","+        let err = validate_startup_config(&mut config).unwrap_err().to_string();","+        assert!(err.contains(\"database.url is not a valid URL\"), \"{url}: {err}\");","+        assert!(!err.contains(\"supersecret\"), \"{url}: {err}\");","+    }","+}","+","+#[test]","+fn rejects_mismatched_schemes_and_invalid_urls_on_identity_backend() {","+    for backend in [","+        BackendConfig::Postgres(sql_settings(\"mysql://user:supersecret@db.example.test/pnpr\")),","+        BackendConfig::Postgres(sql_settings(\"postgres:user:supersecret@db.example.test/pnpr\")),","+        BackendConfig::Mysql(sql_settings(\"postgres://user:supersecret@db.example.test/pnpr\")),","+        BackendConfig::Mysql(sql_settings(\"mysql:user:supersecret@db.example.test/pnpr\")),","+        BackendConfig::Libsql(libsql_settings(\"libsql://\")),","+    ] {","+        let mut config = base_config();","+        config.identity.backend = backend;","+        let err = validate_startup_config(&mut config).unwrap_err().to_string();","+        assert!(err.contains(\"database.url is not a valid URL\"), \"{err}\");","+        assert!(!err.contains(\"supersecret\"), \"{err}\");","+    }","+}","+","+#[cfg(feature = \"backend-postgres\")]","+#[test]","+fn rejects_invalid_postgres_connect_options_without_leaking_credentials() {","+    for url in [","+        \"postgres://user:supersecret@db.example.test/pnpr?sslmode=bogus\",","+        \"postgresql://user:supersecret@db.example.test:99999/pnpr\",","+    ] {","+        let mut config = base_config();","+        config.storage.metadata = MetadataBackend::Postgres(sql_settings(url));","+        let err = validate_startup_config(&mut config).unwrap_err().to_string();","+        assert!(err.contains(\"database.url is not a valid URL\"), \"{url}: {err}\");","+        assert!(!err.contains(\"supersecret\"), \"{url}: {err}\");","+    }","+}","+","+#[cfg(feature = \"backend-mysql\")]","+#[test]","+fn rejects_invalid_mysql_connect_options_without_leaking_credentials() {","+    for url in [","+        \"mysql://user:supersecret@db.example.test/pnpr?ssl-mode=bogus\",","+        \"mysql://user:supersecret@db.example.test:99999/pnpr\",","+    ] {","+        let mut config = base_config();","+        config.storage.metadata = Metadata