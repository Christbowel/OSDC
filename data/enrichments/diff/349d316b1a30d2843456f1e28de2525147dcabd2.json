e_cfg = write_config(sqlite_dir.path(), \"sqlite:./metadata.sqlite\", None);","+    let (ok_code, stdout, stderr) =","+        run_cli(&bin, &[\"--config\", sqlite_cfg.to_str().unwrap(), \"config\", \"check\"]).await;","+    assert_eq!(ok_code, Some(0), \"sqlite config check failed:\\nstdout: {stdout}\\nstderr: {stderr}\");","+    assert!(stdout.contains(\"Configuration check: OK\"), \"{stdout}\");","+","+    for url in [","+        \"libsql://database.example.test\",","+        \"http://127.0.0.1:8080\",","+        \"https://database.example.test\",","+        \"postgres://example:supersecret@database.example.test/registry\",","+        \"postgresql://example:supersecret@database.example.test/registry\",","+        \"mysql://example:supersecret@database.example.test/registry\",","+    ] {","+        let dir = TempDir::new().unwrap();","+        let token = url.starts_with(\"libsql://\").then_some(\"supersecret-token\");","+        let cfg = write_config(dir.path(), url, token);","+        let cfg_str = cfg.to_str().unwrap();","+","+        for subcommand in [","+            vec![\"--config\", cfg_str, \"config\", \"check\"],","+            vec![\"--config\", cfg_str, \"serve\", \"--listen\", \"127.0.0.1:0\"],","+        ] {","+            let (code, stdout, stderr) = run_cli(&bin, &subcommand).await;","+            assert_ne!(code, Some(0), \"{url} unexpectedly succeeded for {subcommand:?}\");","+            let combined = format!(\"{stdout}\\n{stderr}\");","+            assert!(","+                combined.contains(\"this build does not include the configured database driver\"),","+                \"{url} ({subcommand:?}): {combined}\",","+            );","+            assert!(!combined.contains(\"supersecret\"), \"{url} leaked secret: {combined}\");","+        }","+    }","+}","+","+#[cfg(all(feature = \"backend-postgres\", feature = \"backend-mysql\"))]","+#[tokio::test]","+#[ignore = \"requires PNPR_TEST_RELEASE_BIN, PNPR_TEST_POSTGRES_URL, and PNPR_TEST_MYSQL_URL\"]","+async fn release_binary_supports_every_database_scheme() {","+    let bin = PathBuf::from(","+        std::env::var(\"PNPR_TEST_RELEASE_BIN\")","+            .expect(\"PNPR_TEST_RELEASE_BIN must point to the release pnpr binary\"),","+    );","+    let pg_admin =","+        std::env::var(\"PNPR_TEST_POSTGRES_URL\").expect(\"PNPR_TEST_POSTGRES_URL is required\");","+    let mysql_admin =","+        std::env::var(\"PNPR_TEST_MYSQL_URL\").expect(\"PNPR_TEST_MYSQL_URL is required\");","+","+    let scratch = TempDir::new().unwrap();","+    let (_http_primary, http_addr, _http_task) =","+        serve_primary(scratch.path().join(\"http-primary.db\")).await;","+    let (_https_primary, https_upstream, _https_task) =","+        serve_primary(scratch.path().join(\"https-primary.db\")).await;","+    let (_libsql_primary, libsql_upstream, _libsql_task) =","+        serve_primary(scratch.path().join(\"libsql-primary.db\")).await;","+","+    let ca_path = TrustedTlsServer::ca_path();","+    let cert_pem = std::fs::read(ca_path.with_file_name(\"server.crt\")).unwrap();","+    let key_pem = std::fs::read(ca_path.with_file_name(\"server.key\")).unwrap();","+    let (https_addr, _https_proxy) = serve_tls_proxy(https_upstream, &cert_pem, &key_pem).await;","+    let (libsql_addr, _libsql_proxy) = serve_tls_proxy(libsql_upstream, &cert_pem, &key_pem).await;","+","+    let pg_db = create_postgres_database(&pg_admin, \"postgres\").await;","+    let postgresql_db = create_postgres_database(&pg_admin, \"postgresql\").await;","+    let mysql_db = create_mysql_database(&mysql_admin).await;","+","+    let cases = [","+        SchemeCase {","+            label: \"sqlite\",","+            url: \"sqlite:./metadata.sqlite\".to_string(),","+            auth_token: None,","+            tls_ca: None,","+        },","+        SchemeCase {","+            label: \"http\",","+            url: format!(\"http://{http_addr}\"),","+            auth_token: None,","+            tls_ca: None,","+        },","+        SchemeCase {","+            label: \"https\",","+            url: format!(\"https://{https_addr}\"),","+            auth_token: Some(\"test-libsql-token\"),"],"additions":134,"deletions":0,"truncated":false}],"additions":531,"deletions":47,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-11T15:38:38.450609+00:00"}