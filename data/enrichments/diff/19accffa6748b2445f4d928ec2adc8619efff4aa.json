mon.Exceptions;"," using KurrentDB.Core.Services;","@@ -46,6 +47,12 @@ public static void Validate(ClusterVNodeOptions options) {"," \t\t\t\t$\"{nameof(options.Database.InitializationThreads)} must be greater than 0.\");"," \t\t}"," ","+\t\tif (options.Database.SqlEngineTempDirectorySizeLimit < 0) {","+\t\t\tthrow new ArgumentOutOfRangeException(nameof(options.Database.SqlEngineTempDirectorySizeLimit),","+\t\t\t\toptions.Database.SqlEngineTempDirectorySizeLimit,","+\t\t\t\t$\"{nameof(options.Database.SqlEngineTempDirectorySizeLimit)} must be greater than or equal to 0.\");","+\t\t}","+"," \t\tif (options.Grpc.KeepAliveTimeout < 0) {"," \t\t\tthrow new ArgumentOutOfRangeException("," \t\t\t\t$\"Invalid {nameof(options.Grpc.KeepAliveTimeout)} {options.Grpc.KeepAliveTimeout}. Please provide a positive integer.\");","@@ -84,15 +91,16 @@ public static void Validate(ClusterVNodeOptions options) {"," \t\t\t\t\"The given database path starts with a '~'. KurrentDB does not expand '~'.\");"," \t\t}"," ","-\t\tif (options.Database is { Index: not null, Db: not null }) {","-\t\t\tvar absolutePathIndex = Path.GetFullPath(options.Database.Index);","-\t\t\tvar absolutePathDb = Path.GetFullPath(options.Database.Db);","-\t\t\tif (absolutePathDb.Equals(absolutePathIndex)) {","-\t\t\t\tthrow new ApplicationInitializationException(","-\t\t\t\t\t$\"The given database ({absolutePathDb}) and index ({absolutePathIndex}) paths cannot point to the same directory.\");","-\t\t\t}","+\t\tif (options.Database.SqlEngineTempDirectory.StartsWith('~')) {","+\t\t\tthrow new ApplicationInitializationException(","+\t\t\t\t$\"The given {nameof(options.Database.SqlEngineTempDirectory)} starts with a '~'. KurrentDB does not expand '~'.\");"," \t\t}"," ","+\t\tValidateDistinctDirectories(","+\t\t\t(\"database\", options.Database.Db),","+\t\t\t(nameof(options.Database.Index), options.Database.Index),","+\t\t\t(nameof(options.Database.SqlEngineTempDirectory), options.Database.SqlEngineTempDirectory));","+"," \t\tif (options.Cluster.GossipSeed.Length > 1 && options.Cluster.ClusterSize == 1) {"," \t\t\tthrow new ApplicationInitializationException("," \t\t\t\t\"The given ClusterSize is set to 1 but GossipSeeds are multiple. We will never be able to sync up with this configuration.\");","@@ -126,6 +134,22 @@ public static void Validate(ClusterVNodeOptions options) {"," \t\t\t\t\"authentication when running with --disable-tls and authentication enabled.\","," \t\t\t\tnameof(options.Cluster.ClusterSecret));"," \t\t}","+","+\t\treturn;","+","+\t\tstatic void ValidateDistinctDirectories(params ReadOnlySpan<(string Name, string Path)> directories) {","+\t\t\tvar names = new Dictionary<string, string>(directories.Length, StringComparer.Ordinal);","+\t\t\tforeach (var (name, path) in directories) {","+\t\t\t\tif (path is not { Length: > 0 })","+\t\t\t\t\tcontinue;","+","+\t\t\t\tvar absolutePath = Path.TrimEndingDirectorySeparator(Path.GetFullPath(path));","+\t\t\t\tif (!names.TryAdd(absolutePath, name)) {","+\t\t\t\t\tthrow new ApplicationInitializationException(","+\t\t\t\t\t\t$\"The given {names[absolutePath]} and {name} paths cannot point to the same directory ({absolutePath}).\");","+\t\t\t\t}","+\t\t\t}","+\t\t}"," \t}"," "," \tpublic static bool ValidateForStartup(ClusterVNodeOptions options) {"],"additions":31,"deletions":7,"truncated":false},{"path":"src/KurrentDB.Core/DuckDB/DuckDBConnectionPoolLifetime.cs","lines":["@@ -22,6 +22,8 @@ namespace KurrentDB.Core.DuckDB;"," // Also produces additional pools on demand that the caller should dispose."," public class DuckDBConnectionPoolLifetime : Disposable, IHostedService {"," \tprivate readonly string _path;","+\tprivate readonly string _tempDirectory;","+\tprivate readonly long _maxTempDirectorySizeBytes;"," \tprivate readonly IReadOnlyList<IDuckDBSetup> _repeated;"," \tprivate readonly ILogger<DuckDBConnectionPoolLifetime> _log;"," \t[CanBeNull] private string _tempPath;","@@ -34,6 +36,11 @@ public DuckDBConnectionPoolLifetime("," \t\t[CanBeNull] ILogger<DuckDBConnectionPoolLifetime> log) {"," "," \t\t_path = config.InMemDb ? GetTempPath() : $\"{config.Path}/kurrent.ddb\";","+\t\t_tempDirectory = Path.GetFullPath(config.SqlEngineTempDirectory is { Length: > 0 } tempPath","+\t\t\t? tempPath","+\t\t\t: $\"{_path}.tmp\"); // the same directory DuckDB would pick by default. explicit so we can clean it up","+","+\t\t_maxTempDirectorySizeBytes = config.SqlEngineTempDirectorySizeLimit;"," \t\t_log = log ?? NullLogger<DuckDBConnectionPoolLifetime>.Instance;"," "," \t\tvar once = new List<IDuckDBSetup>();","@@ -70,7 +77,12 @@ private ConnectionPoolWithFunctions CreatePool(bool isReadOnly, bool log) {"," \t\tvar settings = new Dictionary<string, string> {"," \t\t\t[\"memory_limit\"] = $\"{duckDbRamMib}MB\", // total, not per connection"," \t\t\t[\"access_mode\"] = isReadOnly ? \"READ_ONLY\" : \"READ_WRITE\",","+\t\t\t[\"temp_directory\"] = _tempDirectory,"," \t\t};","+","+\t\tif (_maxTempDirectorySizeBytes > 0L)","+\t\t\tsettings[\"max_temp_directory_size\"] = $\"{_maxTempDirectorySizeBytes}B\";","+"," \t\tvar pool = new ConnectionPoolWithFunctions($\"Data Source={_path};{GetParamsString()}\", _repeated);"," "," \t\tif (log)","@@ -88,7 +100,30 @@ string GetParamsString() {"," \t\t}"," \t}"," ","-\tpublic Task StartAsync(CancellationToken cancellationToken) => Task.CompletedTask;","+\tpublic Task StartAsync(CancellationToken cancellationToken) {","+\t\tvar task = Task.CompletedTask;","+\t\ttry {","+\t\t\tvar tempDir = new DirectoryInfo(_tempDirectory);","+\t\t\t// cleanup tmp files on startup","+\t\t\tif (tempDir.Exists) {","+\t\t\t\tDeleteTempObjects(tempDir);","+\t\t\t}","+\t\t} catch (Exception e) {","+\t\t\ttask = Task.FromException(e);","+\t\t}","+","+\t\treturn task;","+","+\t\tstatic void DeleteTempObjects(DirectoryInfo tempDir) {","+\t\t\tforeach (var tempObj in tempDir.EnumerateFileSystemInfos(\"*.tmp\", SearchOption.TopDirectoryOnly)) {","+\t\t\t\tif (tempObj is DirectoryInfo subDir) {","+\t\t\t\t\tsubDir.Delete(recursive: true);","+\t\t\t\t} else {","+\t\t\t\t\ttempObj.Delete();","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}"," "," \tpublic Task StopAsync(CancellationToken cancellationToken) {"," \t\t_log.LogDebug(\"Checkpointing DuckDB connection\");"],"additions":36,"deletions":1,"truncated":false},{"path":"src/KurrentDB.Core/TransactionLog/Chunks/TFChunkDbConfig.cs","lines":["@@ -77,4 +77,8 @@ public TFChunkDbConfig(string path,"," \t\tReduceFileCachePressure = reduceFileCachePressure;"," \t\tMaxTruncation = maxTruncation;"," \t}","+","+\tpublic long SqlEngineTempDirectorySizeLimit { get; init; }","+","+\tpublic string SqlEngineTempDirectory { get; init; } = \"\";"," }",""],"additions":4,"deletions":0,"truncated":false}],"additions":275,"deletions":10,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-07-31T10:31:37.206215+00:00"}