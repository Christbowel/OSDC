":0,"truncated":false},{"path":"contrib/dynamo/filters/http/test/dynamo_filter_test.cc","lines":["@@ -15,6 +15,7 @@"," #include \"gtest/gtest.h\""," "," using testing::_;","+using testing::Invoke;"," using testing::NiceMock;"," using testing::Property;"," using testing::Return;","@@ -32,6 +33,13 @@ class DynamoFilterTest : public testing::Test {","         .WillByDefault(Return(enabled));","     EXPECT_CALL(loader_.snapshot_, featureEnabled(\"dynamodb.filter_enabled\", 100));"," ","+    // DynamoStats creates a 'prefix.dynamodb' subscope; back it with a mock scope so its stats","+    // still land on the string-based expectations of the mock store.","+    ON_CALL(stats_.mockScope(), createScope_(_, _))","+        .WillByDefault(Invoke([this](const std::string& name, const std::string&) {","+          const Stats::StatNameDynamicStorage storage(name, stats_.symbolTable());","+          return stats_.makeScope(storage.statName());","+        }));","     auto stats = std::make_shared<DynamoStats>(*stats_.rootScope(), \"prefix.\");","     filter_ = std::make_unique<DynamoFilter>(loader_, stats,","                                              decoder_callbacks_.dispatcher().timeSource());"],"additions":8,"deletions":0,"truncated":false},{"path":"contrib/dynamo/filters/http/test/dynamo_integration_test.cc","lines":["@@ -0,0 +1,83 @@","+#include \"source/common/buffer/buffer_impl.h\"","+#include \"source/common/config/well_known_names.h\"","+","+#include \"test/integration/http_integration.h\"","+#include \"test/integration/tagged_stats_test_util.h\"","+","+#include \"gtest/gtest.h\"","+","+namespace Envoy {","+namespace {","+","+using testing::Eq;","+","+class DynamoIntegrationTest : public testing::TestWithParam<Network::Address::IpVersion>,","+                              public HttpIntegrationTest {","+public:","+  DynamoIntegrationTest() : HttpIntegrationTest(Http::CodecType::HTTP1, GetParam()) {}","+","+  // Whether the stats store derives tags with the explicit-tags logic (the tag-friendly scope API)","+  // rather than with the legacy tag-extraction rules. Both modes must produce identical stat names,","+  // tag-extracted names and tags for the filter stats asserted below.","+  bool explicitTags() const { return version_ == Network::Address::IpVersion::v4; }","+","+  void initialize() override {","+    config_helper_.prependFilter(R\"EOF(","+name: envoy.filters.http.dynamo","+typed_config:","+  \"@type\": type.googleapis.com/envoy.extensions.filters.http.dynamo.v3.Dynamo","+)EOF\");","+    // Exercise both stats modes without doubling the test matrix: the two IP versions run the","+    // server in different modes.","+    Stats::TestUtil::setExplicitStatsTags(explicitTags());","+    HttpIntegrationTest::initialize();","+    Stats::TestUtil::verifyExplicitStatsTags(*test_server_, explicitTags());","+  }","+};","+","+INSTANTIATE_TEST_SUITE_P(IpVersions, DynamoIntegrationTest,","+                         testing::ValuesIn(TestEnvironment::getIpVersionsForTest()),","+                         TestUtility::ipTestParamsToString);","+","+TEST_P(DynamoIntegrationTest, OperationAndTableStatsAreTagged) {","+  initialize();","+  codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+","+  Http::TestRequestHeaderMapImpl request_headers{{\":method\", \"POST\"},","+                                                 {\":path\", \"/\"},","+                                                 {\":scheme\", \"http\"},","+                                                 {\":authority\", \"host\"},","+                                                 {\"x-amz-target\", \"DynamoDB_20120810.GetItem\"}};","+  auto response =","+      codec_client_->makeRequestWithBody(request_headers, R\"EOF({\"TableName\": \"locations\"})EOF\");","+  waitForNextUpstreamRequest();","+  upstream_request_->encodeHeaders(default_response_headers_, false);","+  Buffer::OwnedImpl response_body(\"{}\");","+  upstream_request_->encodeData(response_body, true);","+  ASSERT_TRUE(response->waitForEndStream());","+","+  test_server_->waitForCounter(\"http.config_test.dynamodb.operation.GetItem.upstream_rq_total\",","+                               Eq(1));","+  EXPECT_EQ(1UL,","+            test_server_->counter(\"http.config_test.dynamodb.table.locations.upstream_rq_total_2xx\")","+                ->value());","+","+  // The operation and table segments of the stat names are dropped from the tag-extracted names","+  // and carried as tags, identically in both stats modes.","+  const std::string& hcm_prefix = Config::TagNames::get().HTTP_CONN_MANAGER_PREFIX;","+  Stats::TestUtil::expectStatTags(","+      *test_server_, \"http.config_test.dynamodb.operation.GetItem.upstream_rq_total\",","+      \"http.dynamodb.operation.upstream_rq_total\",","+      {{hcm_prefix, \"config_test\"}, {Config::TagNames::get().DYNAMO_OPERATION, \"GetItem\"}});","+  Stats::TestUtil::expectStatTags(","+      *test_server_, \"http.config_test.dynamodb.table.locations.upstream_rq_total\",","+      \"http.dynamodb.table.upstream_rq_total\",","+      {{hcm_prefix, \"config_test\"}, {Config::TagNames::get().DYNAMO_TABLE, \"locations\"}});","+  Stats::TestUtil::expectStatTags(","+      *test_server_, \"http.config_test.dynamodb.table.locations.upstream_rq_time\",","+      \"http.dynamodb.table.upstream_rq_time\",","+      {{hcm_prefix, \"config_test\"}, {Config::TagNames::get().DYNAMO_TABLE, \"locations\"}});","+}","+","+} // namespace","+} // namespace Envoy"],"additions":83,"deletions":0,"truncated":false},{"path":"contrib/dynamo/filters/http/test/dynamo_stats_test.cc","lines":["@@ -1,6 +1,8 @@"," #include <string>"," ","+#include \"test/common/stats/stat_test_utility.h\""," #include \"test/mocks/stats/mocks.h\"","+#include \"test/test_common/utility.h\""," "," #include \"contrib/dynamo/filters/http/source/dynamo_stats.h\""," #include \"gmock/gmock.h\"","@@ -63,6 +65,102 @@ TEST(DynamoStats, PartitionIdStatString) {","   }"," }"," ","+TEST(DynamoStats, StatsAreTagged) {","+  // The tags of a stat as (name, value) pairs.","+  const auto tags_of = [](const Stats::Metric& metric) {","+    std::vector<std::pair<std::string, std::string>> tags;","+    for (const Stats::Tag& tag : metric.tags()) {","+      tags.emplace_back(tag.name_, tag.value_);","+    }","+    return tags;","+  };","+","+  // TestStore, unlike IsolatedStoreImpl, tracks histograms so they can be found by name below.","+  Stats::TestUtil::TestStore store;","+  DynamoStats stats(*store.rootScope(), \"prefix.\");","+  Stats::StatNameDynamicPool pool(store.symbolTable());","+","+  // The operation, table and partition id segments are tags of their own and are dropped from the","+  // tag-extracted names; the prefix is joined verbatim.","+  const Stats::Counter& partition = stats.buildPartitionStatCounter(","+      \"locations\", \"GetItem\", \"6235c781-1d0d-47a3-a4ea-eec04c5883ca\");","+  EXPECT_EQ(\"prefix.dynamodb.table.locations.capacity.GetItem.__partition_id=c5883ca\",","+            partition.name());","+  EXPECT_EQ(\"prefix.dynamodb.table.capacity\", partition.tagExtractedName());","+  EXPECT_THAT(tags_of(partition),","+              testing::UnorderedElementsAre(testing::Pair(\"envoy.dynamo_table\", \"locations\"),","+                                            testing::Pair(\"envoy.dynamo_operation\", \"GetItem\"),","+                                            testing::Pair(\"envoy.dynamo_partition_id\", \"c5883ca\")));","+","+  stats.incEntityCounter(stats.getBuiltin(\"operation\", stats.unknown_entity_type_),","+                         stats.operation_tag_, pool.add(\"Query\"), stats.upstream_rq_total_);","+  const Stats::CounterSharedPtr operation =","+      TestUtility::findCounter(store, \"prefix.dynamodb.operation.Query.upstream_rq_total\");","+  ASSERT_NE(operation, nullptr);","+  EXPECT_EQ(1U, operation->value());","+  EXPECT_EQ(\"prefix.dynamodb.operation.upstream_rq_total\", operation->tagExtractedName());","+  EXPECT_THAT(tags_of(*operation),","+              testing::UnorderedElementsAre(testing::Pair(\"envoy.dynamo_operation\", \"Query\")));","+","+  stats.recordEntityHistogram(stats.getBuiltin(\"table\", stats.unknown_entity_type_),","+                              stats.table_tag_, pool.add(\"bar_table\"), stats.upstream_rq_time_,","+                              Stats::Histogram::Unit::Milliseconds, 5);","+  const Stats::HistogramOptConstRef table_time =","+      store.findHistogramByString(\"prefix.dynamodb.table.bar_table.upstream_rq_time\");","+  ASSERT_TRUE(table_time.has_value());","+  EXPECT_EQ(\"prefix.dynamodb.table.upstream_rq_time\", table_time->tagExtractedName());","+  EXPECT_THAT(tags_of(*table_time),","+              testing::UnorderedElementsAre(testing::Pair(\"envoy.dynamo_table\", \"bar_table\")));","+","+  stats.incTableErrorCounter(pool.add(\"bar_table\"), stats.batch_failure_unprocessed_keys_);","+  const Stats::CounterSharedPtr table_error = TestUtility::findCounter(","+      store, \"prefix.dynamodb.error.bar_table.BatchFailureUnprocessedKeys\");","+  ASSERT_NE(table_error, nullptr);","+  EXPECT_EQ(\"prefix.dynamodb.error.BatchFailureUnprocessedKeys\", table_error->tagExtractedName());","+  EXPECT_THAT(tags_of(*table_error),","+              testing::UnorderedElementsAre(testing::Pair(\"envoy.dynamo_table\", \"bar_table\")));","+","+  // Stats without an entity segment carry no tags.","+  stats.incCounter({stats.operation_missing_});","+  const Stats::CounterSharedPtr missing =","+      TestUtility::findCounter(store, \"prefix.dynamodb.operation_missing\");","+  ASSERT_NE(missing, nullptr);","+  EXPECT_EQ(\"prefix.dynamodb.operation_missing\", missing->tagExtractedName());","+  EXPECT_TRUE(missing->tags().empty());","+}","+","+TEST(DynamoStats, ShortPartitionIdsAreTagged) {","+  // The tags of a stat as (name, value) pairs.","+  const auto tags_of = [](const Stats::Metric& metric) {","+    std::vector<std::pair<std::string, std::string>> tags;","+    for (const Stats::Tag& tag : metric.tags()) {","+      tags.emplace_back(tag.name_, tag.value_);","+    }","+    return tags;","+  };","+","+  Stats::TestUtil::TestStore store;","+  DynamoStats stats(*store.rootScope(), \"prefix.\");","+","+  // An id shorter than 7 characters is kept whole.","+  const Stats::Counter& short_id = stats.buildPartitionStatCounter(\"locations\", \"GetItem\", \"abc\");","+  EXPECT_EQ(\"prefix.dynamodb.table.locations.capacity.GetItem.__partition_id=abc\", short_id.name());","+  EXPECT_EQ(\"prefix.dynamodb.table.capacity\", short_id.tagExtractedName());","+  EXPECT_THAT(tags_of(short_id),","+              testing::UnorderedElementsAre(testing::Pair(\"envoy.dynamo_table\", \"locations\"),","+                                            testing::Pair(\"envoy.dynamo_operation\", \"GetItem\"),","+                                            testing::Pair(\"envoy.dynamo_partition_id\", \"abc\")));","+","+  // An empty id is tolerated.","+  const Stats::Counter& empty_id = stats.buildPartitionStatCounter(\"locations\", \"GetItem\", \"\");","+  EXPECT_EQ(\"prefix.dynamodb.table.locations.capacity.GetItem.__partition_id=\", empty_id.name());","+  EXPECT_EQ(\"prefix.dynamodb.table.capacity\", empty_id.tagExtractedName());","+  EXPECT_THAT(tags_of(empty_id),","+              testing::UnorderedElementsAre(testing::Pair(\"envoy.dynamo_table\", \"locations\"),","+                                            testing::Pair(\"envoy.dynamo_operation\", \"GetItem\"),","+                                            testing::Pair(\"envoy.dynamo_partition_id\", \"\")));","+}","+"," } // namespace"," } // namespace Dynamo"," } // namespace HttpFilters",""],"additions":98,"deletions":0,"truncated":false}],"additions":322,"deletions":48,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-03T16:48:43.061652+00:00"}