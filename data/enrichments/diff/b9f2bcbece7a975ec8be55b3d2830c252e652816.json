{"id":"b9f2bcbece7a975ec8be55b3d2830c252e652816","axis":"silent","repo":"hibernate/hibernate-orm","sha":"b9f2bcbece7a975ec8be55b3d2830c252e652816","parsed":{"files":[{"path":"hibernate-core/src/main/java/org/hibernate/StatelessSession.java","lines":["@@ -64,6 +64,16 @@","  *     transaction is not automatically marked for rollback.","  * </ul>","  * <p>","+ * Explicit lock modes behave differently to a stateful session.The lock","+ * modes {@link jakarta.persistence.LockModeType#OPTIMISTIC OPTIMISTIC}","+ * and {@link jakarta.persistence.LockModeType#OPTIMISTIC_FORCE_INCREMENT","+ * OPTIMISTIC_FORCE_INCREMENT} are implemented as immediate pessimistic","+ * locks, as explicitly permitted by the JPA specification. The lock modes","+ * {@link jakarta.persistence.LockModeType#OPTIMISTIC_FORCE_INCREMENT","+ * OPTIMISTIC_FORCE_INCREMENT} and","+ * {@link jakarta.persistence.LockModeType#PESSIMISTIC_FORCE_INCREMENT","+ * PESSIMISTIC_FORCE_INCREMENT} both increment the version immediately.","+ * <p>","  * Since version 7, the configuration property","  * {@value org.hibernate.cfg.BatchSettings#STATEMENT_BATCH_SIZE} has no effect","  * on a stateless session. Automatic batching may be enabled by explicitly"],"additions":10,"deletions":0,"truncated":false},{"path":"hibernate-core/src/main/java/org/hibernate/engine/internal/StatefulPersistenceContext.java","lines":["@@ -481,6 +481,13 @@ private void processLoadedEntityHolder("," \t\t\t\t\t\t.setPersister( holder.getDescriptor() );"," \t\t\t\tlistenerGroup.fireEventOnEachListener( postLoadEvent, PostLoadEventListener::onPostLoad );"," \t\t\t}","+\t\t\telse if ( listenerGroup != null && getSession().isStateless() ) {","+\t\t\t\t// Stateless loads do not fire post-load events, but must still perform forced increments.","+\t\t\t\tfinal var entry = holder.getEntityEntry();","+\t\t\t\tif ( entry.getLockMode().requiresVersion() ) {","+\t\t\t\t\tholder.getDescriptor().lock( entry.getId(), entry.getVersion(), entity, entry.getLockMode(), getSession() );","+\t\t\t\t}","+\t\t\t}"," \t\t\tif ( callback != null ) {"," \t\t\t\tcallback.invokeAfterLoadActions( entity, holder.getDescriptor(), getSession() );"," \t\t\t}"],"additions":7,"deletions":0,"truncated":false},{"path":"hibernate-core/src/main/java/org/hibernate/internal/StatelessLocking.java","lines":["@@ -0,0 +1,63 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.internal;","+","+import org.hibernate.LockMode;","+import org.hibernate.LockOptions;","+import org.hibernate.engine.spi.SharedSessionContractImplementor;","+import org.hibernate.query.internal.DelegatingDomainQueryExecutionContext;","+import org.hibernate.query.spi.DelegatingQueryOptions;","+import org.hibernate.query.spi.DomainQueryExecutionContext;","+import org.hibernate.query.spi.QueryOptions;","+","+/**","+ * Stateless sessions obtain locks immediately so that version checks and increments","+ * do not depend on a persistence context surviving the operation.","+ */","+public final class StatelessLocking {","+\tprivate StatelessLocking() {","+\t}","+","+\tpublic static LockMode getEffectiveLockMode(LockMode lockMode) {","+\t\treturn lockMode == LockMode.OPTIMISTIC ? LockMode.PESSIMISTIC_READ","+\t\t\t\t: lockMode == LockMode.OPTIMISTIC_FORCE_INCREMENT ? LockMode.PESSIMISTIC_FORCE_INCREMENT","+\t\t\t\t: lockMode;","+\t}","+","+\tpublic static LockOptions getEffectiveLockOptions(LockOptions lockOptions, SharedSessionContractImplementor session) {","+\t\tif ( session.isStateless() ) {","+\t\t\tfinal var effectiveLockMode = getEffectiveLockMode( lockOptions.getLockMode() );","+\t\t\tif ( effectiveLockMode != lockOptions.getLockMode() ) {","+\t\t\t\treturn lockOptions.makeCopy().setLockMode( effectiveLockMode );","+\t\t\t}","+\t\t}","+\t\treturn lockOptions;","+\t}","+","+\tpublic static DomainQueryExecutionContext getExecutionContext(DomainQueryExecutionContext context) {","+\t\tfinal var queryOptions = context.getQueryOptions();","+\t\tfinal var lockOptions = getEffectiveLockOptions( queryOptions.getLockOptions(), context.getSession() );","+\t\tif ( lockOptions == queryOptions.getLockOptions() ) {","+\t\t\treturn context;","+\t\t}","+\t\tfinal var effectiveQueryOptions = new DelegatingQueryOptions( queryOptions ) {","+\t\t\t@Override","+\t\t\tpublic LockOptions getLockOptions() {","+\t\t\t\treturn lockOptions;","+\t\t\t}","+\t\t};","+\t\treturn new DelegatingDomainQueryExecutionContext( context ) {","+\t\t\t@Override","+\t\t\tpublic QueryOptions getQueryOptions() {","+\t\t\t\treturn effectiveQueryOptions;","+\t\t\t}","+","+\t\t\t@Override","+\t\t\tpublic Class<?> getResultType() {","+\t\t\t\treturn context.getResultType();","+\t\t\t}","+\t\t};","+\t}","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"hibernate-core/src/main/java/org/hibernate/internal/StatelessSessionImpl.java","lines":["@@ -1810,7 +1810,7 @@ private JtaPlatform getJtaPlatform() {"," \t}"," "," \tprivate LockMode getNullSafeLockMode(LockMode lockMode) {","-\t\treturn lockMode == null ? LockMode.NONE : lockMode;","+\t\treturn lockMode == null ? LockMode.NONE : StatelessLocking.getEffectiveLockMode( lockMode );"," \t}"," "," \tprotected Object lockCacheItem(Object id, Object previousVersion, EntityPersister persister) {"],"additions":1,"deletions":1,"truncated":false},{"path":"hibernate-core/src/main/java/org/hibernate/internal/find/StatelessFindByKeyOperation.java","lines":["@@ -16,6 +16,7 @@"," import org.hibernate.engine.spi.StatelessSessionImplementor;"," import org.hibernate.graph.GraphSemantic;"," import org.hibernate.graph.spi.RootGraphImplementor;","+import org.hibernate.internal.StatelessLocking;"," import org.hibernate.loader.internal.CacheLoadHelper;"," import org.hibernate.persister.entity.EntityPersister;"," ","@@ -112,4 +113,9 @@ private Object loadFromSecondLevelCache("," \tprivate LockMode getNullSafeLockMode() {"," \t\treturn getLockMode() == null ? LockMode.NONE : get