retationCache.Key {"," "," \tpublic static SqmInterpretationsKey createInterpretationsKey(InterpretationsKeySource keySource) {","+\t\treturn createInterpretationsKey( keySource, keySource.getQueryOptions().getLockOptions() );","+\t}","+","+\tpublic static SqmInterpretationsKey createInterpretationsKey(InterpretationsKeySource keySource, LockOptions lockOptions) {"," \t\tif ( isCacheable ( keySource ) ) {"," \t\t\tfinal Object query = keySource.getQueryStringCacheKey();"," \t\t\treturn new SqmInterpretationsKey(","@@ -28,7 +32,7 @@ public static SqmInterpretationsKey createInterpretationsKey(InterpretationsKeyS"," \t\t\t\t\tkeySource.unnamedParameterIndices(),"," \t\t\t\t\tquery instanceof SqmStatement<?> statement ? statement.cacheHashCode() : query.hashCode(),"," \t\t\t\t\tkeySource.getResultType(),","-\t\t\t\t\tkeySource.getQueryOptions().getLockOptions(),","+\t\t\t\t\tlockOptions,"," \t\t\t\t\tmemoryEfficientDefensiveSetCopy( keySource.getLoadQueryInfluencers().getEnabledFetchProfileNames() ),"," \t\t\t\t\tkeySource.getLoadQueryInfluencers().getTemporalIdentifier() != null"," \t\t\t);"],"additions":5,"deletions":1,"truncated":false},{"path":"hibernate-core/src/test/java/org/hibernate/orm/test/stateless/StatelessLockingTest.java","lines":["@@ -0,0 +1,241 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.orm.test.stateless;","+","+import java.util.List;","+import java.util.stream.Stream;","+","+import jakarta.persistence.Entity;","+import jakarta.persistence.EntityAgent;","+import jakarta.persistence.Id;","+import jakarta.persistence.LockModeType;","+import jakarta.persistence.Version;","+","+import org.hibernate.annotations.Cache;","+import org.hibernate.annotations.CacheConcurrencyStrategy;","+import org.hibernate.cfg.AvailableSettings;","+import org.hibernate.testing.orm.junit.EntityManagerFactoryScope;","+import org.hibernate.testing.orm.junit.Jpa;","+import org.hibernate.testing.orm.junit.Setting;","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.params.ParameterizedTest;","+import org.junit.jupiter.params.provider.Arguments;","+import org.junit.jupiter.params.provider.EnumSource;","+import org.junit.jupiter.params.provider.MethodSource;","+","+import static jakarta.persistence.LockModeType.OPTIMISTIC;","+import static jakarta.persistence.LockModeType.OPTIMISTIC_FORCE_INCREMENT;","+import static jakarta.persistence.LockModeType.PESSIMISTIC_FORCE_INCREMENT;","+import static jakarta.persistence.LockModeType.PESSIMISTIC_READ;","+import static jakarta.persistence.LockModeType.WRITE;","+import static org.junit.jupiter.api.Assertions.assertEquals;","+import static org.junit.jupiter.api.Assertions.assertSame;","+","+@Jpa(annotatedClasses = StatelessLockingTest.Lockable.class,","+\t\tuseCollectingStatementInspector = true,","+\t\tproperties = @Setting(name = AvailableSettings.CACHE_REGION_FACTORY,","+\t\t\t\tvalue = \"org.hibernate.testing.cache.CachingRegionFactory\"))","+class StatelessLockingTest {","+\tprivate static final String QUERY = \"from StatelessLockable order by id\";","+","+\t@BeforeEach","+\tvoid prepare(EntityManagerFactoryScope scope) {","+\t\tscope.inTransaction( em -> {","+\t\t\tem.persist( new Lockable( 1, \"first\" ) );","+\t\t\tem.persist( new Lockable( 2, \"second\" ) );","+\t\t} );","+\t}","+","+\t@AfterEach","+\tvoid cleanup(EntityManagerFactoryScope scope) {","+\t\tscope.dropData();","+\t\tscope.getEntityManagerFactory().getCache().evictAll();","+\t}","+","+\tstatic Stream<Arguments> forceIncrementOperations() {","+\t\treturn Stream.of( WRITE, OPTIMISTIC_FORCE_INCREMENT, PESSIMISTIC_FORCE_INCREMENT )","+\t\t\t\t.flatMap( mode -> Stream.of( Operation.values() ).map( operation -> Arguments.of( mode, operation ) ) );","+\t}","+","+\t@ParameterizedTest","+\t@MethodSource(\"forceIncrementOperations\")","+\tvoid testImmediateForceIncrement(LockModeType mode, Operation operation, EntityManagerFactoryScope scope) {","+\t\ttry ( var agent = scope.getEntityManagerFactory().createEntityAgent() ) {","+\t\t\tfinal var transaction = agent.getTransaction();","+\t\t\ttransaction.begin();","+\t\t\ttry {","+\t\t\t\tfinal var entity = operation.read( agent, mode );","+\t\t\t\tassertEquals( 1, entity.version );","+\t\t\t\tentity.name = \"changed only in memory\";","+\t\t\t\ttransaction.commit();","+\t\t\t}","+\t\t\tfinally {","+\t\t\t\tif ( transaction.isActive() ) {","+\t\t\t\t\ttransaction.rollback();","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tassertStoredState( scope, \"first\", 1 );","+\t}","+","+\t@ParameterizedTest","+\t@EnumSource(value = LockModeType.class, names = { \"WRITE\", \"OPTIMISTIC_FORCE_INCREMENT\", \"PESSIMISTIC_FORCE_INCREMENT\" })","+\tvoid testForceIncrementThenUpdate(LockModeType mode, EntityManagerFactoryScope scope) {","+\t\ttry ( var agent = scope.getEntityManagerFactory().createEntityAgent() ) {","+\t\t\tfinal var transaction = agent.getTransaction();","+\t\t\ttransaction.begin();","+\t\t\ttry {","+\t\t\t\tfinal var entity = agent.find( Lockable.class, 1, mode );","+\t\t\t\tassertEquals( 1, entity.version );","+\t\t\t\tentity.name = \"updated\";","+\t\t\t\tagent.update( entity );","+\t\t\t\tassertEquals( 2, entity.version );","+\t\t\t\ttransaction.commit();","+\t\t\t}","+\t\t\tfinally {","+\t\t\t\tif ( transaction.isActive() ) {","+\t\t\t\t\ttransaction.rollback();","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tassertStoredState( scope, \"updated\", 2 );","+\t}","+","+\t@ParameterizedTest","+\t@EnumSource(value = LockModeType.class, names = { \"WRITE\", \"OPTIMISTIC_FORCE_INCREMENT\", \"PESSIMISTIC_FORCE_INCREMENT\" })","+\tvoid testForceIncrementRollback(LockModeType mode, EntityManagerFactoryScope scope) {","+\t\ttry ( var agent = scope.getEntityManagerFactory().createEntityAgent() ) {","+\t\t\tfinal var transaction = agent.getTransaction();","+\t\t\ttransaction.begin();","+\t\t\ttry {","+\t\t\t\tassertEquals( 1, agent.find( Lockable.class, 1, mode ).version );","+\t\t\t}","+\t\t\tfinally {","+\t\t\t\ttransaction.rollback();","+\t\t\t}","+\t\t}","+\t\tassertStoredState( scope, \"first\", 0 );","+\t}","+","+\t@ParameterizedTest","+\t@EnumSource(value = LockModeType.class, names = { \"WRITE\", \"OPTIMISTIC_FORCE_INCREMENT\", \"PESSIMISTIC_FORCE_INCREMENT\" })","+\tvoid testDuplicateQueryResults(LockModeType mode, EntityManagerFactoryScope scope) {","+\t\ttry ( var agent = scope.getEntityManagerFactory().createEntityAgent() ) {","+\t\t\tfinal var transaction = agent.getTransaction();","+\t\t\ttransaction.begin();","+\t\t\ttry {","+\t\t\t\tfinal var results = agent.createQuery(","+\t\t\t\t\t\t\"select l, other.id from StatelessLockable l cross join StatelessLockable other order by l.id, other.id\",","+\t\t\t\t\t\tObject[].class ).setLockMode( mode ).getResultList();","+\t\t\t\tassertEquals( 4, results.size() );","+\t\t\t\tassertSame( results.get( 0 )[0], results.get( 1 )[0] );","+\t\t\t\tassertSame( results.get( 2 )[0], results.get( 3 )[0] );","+\t\t\t\tfor ( var result : results ) {","+\t\t\t\t\tassertEquals( 1, ((Lockable) result[0]).version );","+\t\t\t\t}","+\t\t\t\ttransaction.commit();","+\t\t\t}","+\t\t\tfinally {","+\t\t\t\tif ( transaction.isActive() ) {","+\t\t\t\t\ttransaction.rollback();","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tassertStoredState( scope, \"first\", 1 );","+\t}","+","+\t@ParameterizedTest","+\t@EnumSource(value = LockModeType.class, names = { \"READ\", \"OPTIMISTIC\" })","+\tvoid testOptimisticQueryUsesImmediateLock(LockModeType mode, EntityManagerFactoryScope scope) {","+\t\tfinal var originalSql = statefulQuerySql( scope );","+\t\tList<String> optimisticSql;","+\t\ttry ( var agent = scope.getEntityManagerFactory().createEntityAgent() ) {","+\t\t\tfinal var transaction = agent.getTransaction();","+\t\t\ttransaction.begin();","+\t\t\ttry {","+\t\t\t\tfinal var query = agent.createQuery( QUERY, Lockable.class ).setLockMode( mode );","+\t\t\t\tfinal var inspector = scope.getCollectingStatementInspector();","+\t\t\t\tinspector.clear();","+\t\t\t\tquery.getResultList();","+\t\t\t\toptimisticSql = List.copyOf( inspector.getSqlQueries() );","+\t\t\t\tassertEquals( OPTIMISTIC, query.getLockMode() );","+\t\t\t\tinspector.clear();","+\t\t\t\tquery.setLockMode( PESSIMISTIC_READ ).getResultList();","+\t\t\t\tassertEquals( inspector.getSqlQueries(), optimisticSql );","+\t\t\t\ttransaction.commit();","+\t\t\t}","+\t\t\tfinally {","+\t\t\t\tif ( transaction.isActive() ) {","+\t\t\t\t\ttransaction.rollback();","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tassertEquals( originalSql, statefulQuerySql( scope ) );","+\t\tassertStoredState( scope, \"first\", 0 );","+\t}","+","+\tprivate List<String> statefulQuerySql(EntityManagerFactoryScope scope) {","+\t\treturn scope.fromTransaction( em -> {","+\t\t\tfinal var inspector = scope.getCollectingStatementInspector();","+\t\t\tinspector.clear();","+\t\t\tem.createQuery( QUERY, Lockable.class ).setLockMode( OPTIMISTIC ).getResultList();","+\t\t\treturn List.copyOf( inspector.getSqlQueries() );","+\t\t} );","+\t}","+","+\tprivate void assertStoredState(EntityManagerFactoryScope scope, String name, int version) {","+\t\tscope.inTransaction( em -> {","+\t\t\t// Verify both cache-visible entity state and the database row.","+\t\t\tfinal var entity = em.find( Lockable.class, 1 );","+\t\t\tassertEquals( name, entity.name );","+\t\t\tassertEquals( version, entity.version );","+\t\t\tfinal var row = em.createQuery(","+\t\t\t\t\t\"select name, version from StatelessLockable where id = 1\", Object[].class ).getSingleResult();","+\t\t\tassertEquals( name, row[0] );","+\t\t\tassertEquals( version, row[1] );","+\t\t} );","+\t}","+","+\tenum Operation {","+\t\tFIND, REFRESH, MULTIPLE, QUERY, STREAM;","+","+\t\tLockable read(EntityAgent agent, LockModeType mode) {","+\t\t\treturn switch ( this ) {","+\t\t\t\tcase FIND -> agent.find( Lockable.class, 1, mode );","+\t\t\t\tcase REFRESH -> {","+\t\t\t\t\tfinal var entity = new Lockable( 1, \"old\" );","+\t\t\t\t\tagent.refresh( entity, mode );","+\t\t\t\t\tyield entity;","+\t\t\t\t}","+\t\t\t\tcase MULTIPLE -> agent.findMultiple( Lockable.class, List.of( 1, 2 ), mode ).get( 0 );","+\t\t\t\tcase QUERY -> agent.createQuery( StatelessLockingTest.QUERY, Lockable.class ).setLockMode( mode ).getResultList().get( 0 );","+\t\t\t\tcase STREAM -> {","+\t\t\t\t\ttry ( var stream = agent.createQuery( StatelessLockingTest.QUERY, Lockable.class ).setLockMode( mode ).getResultStream() ) {","+\t\t\t\t\t\tyield stream.toList().get( 0 );","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t};","+\t\t}","+\t}","+","+\t@Entity(name = \"StatelessLockable\")","+\t@Cache(usage = CacheConcurrencyStrategy.READ_WRITE)","+\tstatic class Lockable {","+\t\t@Id","+\t\tint id;","+\t\t@Version","+\t\tint version;","+\t\tString name;","+","+\t\tLockable() {","+\t\t}","+","+\t\tLockable(int id, String name) {","+\t\t\tthis.id = id;","+\t\t\tthis.name = name;","+\t\t}","+\t}","+}",""],"additions":241,"deletions":0,"truncated":false}],"additions":350,"deletions":3,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-09-15T12:59:04.637770+00:00"}