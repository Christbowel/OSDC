{"id":"9e9951e5e3d02db4d4e7673660085d854700399b","axis":"silent","repo":"appwrite/appwrite","sha":"9e9951e5e3d02db4d4e7673660085d854700399b","parsed":{"files":[{"path":".github/workflows/crates.yml","lines":["@@ -0,0 +1,104 @@","+name: Crates","+","+# An `rs/<name>/<version>` tag publishes that crate to crates.io, then pushes","+# exactly what was published to its read-only mirror at utopia-rs/<name>.","+# Cargo writes the published crate's standalone Cargo.toml, so the crates here","+# keep inheriting from the workspace. See rfc/monorepo.md.","+","+on:","+  push:","+    tags: ['rs/*/*']","+","+concurrency:","+  group: crates-${{ github.ref }}","+  cancel-in-progress: false","+","+permissions:","+  contents: read","+","+jobs:","+  publish:","+    runs-on: ubuntu-24.04","+    steps:","+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2","+        with:","+          persist-credentials: false","+","+      # rs/query/0.2.0 is crates/utopia/query, the package utopia-query, at 0.2.0.","+      - name: Resolve the crate","+        id: crate","+        run: |","+          name=\"${GITHUB_REF_NAME#rs/}\"","+          version=\"${name##*/}\"","+          name=\"${name%/*}\"","+          for parent in crates/utopia crates/support; do","+            if [ -f \"$parent/$name/Cargo.toml\" ]; then directory=\"$parent/$name\"; fi","+          done","+          [ -n \"${directory:-}\" ] || { echo \"no crate named $name\" >&2; exit 1; }","+          package=$(cargo metadata --no-deps --format-version 1 |","+            jq -r --arg manifest \"$PWD/$directory/Cargo.toml\" '.packages[] | select(.manifest_path == $manifest) | .name')","+          stated=$(cargo metadata --no-deps --format-version 1 |","+            jq -r --arg manifest \"$PWD/$directory/Cargo.toml\" '.packages[] | select(.manifest_path == $manifest) | .version')","+          [ \"$stated\" = \"$version\" ] || { echo \"$directory/Cargo.toml is at $stated, not $version\" >&2; exit 1; }","+          {","+            echo \"name=$name\"","+            echo \"version=$version\"","+            echo \"directory=$directory\"","+            echo \"package=$package\"","+          } >> \"$GITHUB_OUTPUT\"","+","+      # utopia-image links libheif; the verification build of a publish needs its headers.","+      - name: Install build dependencies","+        run: sudo apt-get update && sudo apt-get install --yes --no-install-recommends libheif-dev","+","+      # A rerun after a publish that succeeded packages the same version again instead of","+      # failing on \"already exists\", so the mirror step still runs.","+      - name: Publish to crates.io","+        env:","+          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}","+          PACKAGE: ${{ steps.crate.outputs.package }}","+          VERSION: ${{ steps.crate.outputs.version }}","+        run: |","+          status=$(curl --silent --output /dev/null --write-out '%{http_code}' \\","+            --user-agent 'appwrite/appwrite crates.yml' \"https://crates.io/api/v1/crates/$PACKAGE/$VERSION\")","+          if [ \"$status\" = \"200\" ]; then","+            echo \"$PACKAGE $VERSION is already on crates.io\"","+            cargo package --package \"$PACKAGE\" --locked --no-verify","+          else","+            cargo publish --package \"$PACKAGE\" --locked","+          fi","+","+      - uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0","+        id: app-token","+        with:","+          app-id: ${{ vars.SPLIT_RS_APP_ID }}","+          private-key: ${{ secrets.SPLIT_RS_APP_PRIVATE_KEY }}","+          owner: utopia-rs","+          repositories: ${{ steps.crate.outputs.name }}","+          permission-contents: write","+          permission-workflows: write","+","+      # The mirror's tree is the .crate Cargo just built: one commit and one tag per release.","+      - name: Push the release to the mirror","+        env:","+          TOKEN: ${{ steps.app-token.outputs.token }}","+          NAME: ${{ steps.crate.outputs.name }}","+          PACKAGE: ${{ steps.crate.outputs.package }}","+          VERSION: ${{ steps.crate.outputs.version }}","+          DIRECTORY: ${{ steps.crate.outputs.directory }}","+        run: |","+          mirror=$(mktemp -d)","+          git clone --quiet \"https://x-access-token:$TOKEN@github.com/utopia-rs/$NAME.git\" \"$mirror\"","+          if git -C \"$mirror\" rev-parse --quiet --verify \"refs/tags/$VERSION\" > /dev/null; then","+            echo \"utopia-rs/$NAME already has $VERSION\"","+            exit 0","+          fi","+          git -C \"$mirror\" rm --quiet -r --ignore-unmatch .","+          tar --extract --gzip --file \"target/package/$PACKAGE-$VERSION.crate\" --strip-components 1 --directory \"$mirror\"","+          git -C \"$mirror\" add --all","+          git -C \"$mirror\" \\","+            -c user.name='github-actions[bot]' -c user.email='41898282+github-actions[bot]@users.noreply.github.com' \\","+            commit --quiet --message \"$VERSION\" \\","+            --message \"Published to crates.io as $PACKAGE $VERSION from $GITHUB_REPOSITORY@$GITHUB_SHA ($DIRECTORY).\"","+          git -C \"$mirror\" tag \"$VERSION\"","+          git -C \"$mirror\" push --quiet origin HEAD \"refs/tags/$VERSION\""],"additions":104,"deletions":0,"truncated":false},{"path":".github/workflows/split.yml","lines":["@@ -2,20 +2,13 @@ name: Split"," "," # Pushes every packages/<name> to its read-only mirror at utopia-php/<name>"," # on each push to main; a `<name>/<version>` tag pushes `<version>` to the","-# mirror and publishes its GitHub release. A Rust crate is the same under the","-# name rs/<name>: its directory goes to utopia-rs/<name>, and an","-# `rs/<name>/<version>` tag releases it. See rfc/monorepo.md.","+# mirror and publishes its GitHub release. See rfc/monorepo.md."," "," on:","   push:","     branches: [main]","-    tags: ['*/*', 'rs/*/*']","+    tags: ['*/*']","   workflow_dispatch:","-    inputs:","-      force-crates:","-        description: Overwrite the utopia-rs mirrors' main branches. Only for the first sync from main, which replaces the unrelated history pushed there on 2026-10-14.","-        type: boolean","-        default: false"," "," # Per-ref so independent tag releases (each targets its own mirror) run in"," # parallel instead of cancelling each other as pending; branch pushes to main","@@ -41,23 +34,15 @@ jobs:","       - name: Resolve mirrors","         id: mirrors","         run: |","-          # <name>/<version> is a package, rs/<name>/<version> a crate. A tag gets a token for","-          # its own mirror and none for the other organisation.","-          packages=$(bin/monorepo list | awk '$1 !~ /^rs\\// {print $1}' | paste -sd, -)","-          crates=$(bin/monorepo list | awk '$1 ~ /^rs\\// {sub(/^rs\\//, \"\", $1); print $1}' | paste -sd, -)","           if [ \"$GITHUB_REF_TYPE\" = \"tag\" ]; then","-            name=\"${GITHUB_REF_NAME%/*}\"","-            case \"$name\" in","-              rs/*) packages=\"\"; crates=\"${name#rs/}\" ;;","-              *) packages=\"$name\"; crates=\"\" ;;","-            esac","+            repositories=\"${GITHUB_REF_NAME%%/*}\"","+          else","+            repositories=$(for manifest in packages/*/composer.json; do basename \"$(dirname \"$manifest\")\"; done | paste -sd, -)","           fi","-          echo \"repositories=$packages\" >> \"$GITHUB_OUTPUT\"","-          echo \"crates=$crates\" >> \"$GITHUB_OUTPUT\"","+          echo \"repositories=$repositories\" >> \"$GITHUB_OUTPUT\""," ","       - uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0","         id: app-token","-        if: steps.mirrors.outputs.repositories != ''","         with:","           app-id: ${{ vars.SPLIT_APP_ID }}","           private-key: ${{ secrets.SPLIT_APP_PRIVATE_KEY }}","@@ -66,30 +51,13 @@ jobs:","           permission-contents: write","           permission-workflows: write"," ","-      - uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0","-        id: crates-token","-        if: steps.mirrors.outputs.crates != ''","-        with:","-          app-id: ${{ vars.SPLIT_RS_APP_ID }}","-          private-key: ${{ secrets.SPLIT_RS_APP_PRIVATE_KEY }}","-          owner: utopia-rs","-          repositories: ${{ steps.mirrors.outputs.crates }}","-          permission-contents: write","-          permission-workflows: write","-","-      - name: Split packages and crates","+      - name: Split packages","         env:","           SPLIT_REMOTE_BASE: https://x-access-token:${{ steps.app-token.outputs.token }}@github.com/utopia-php","           GH_TOKEN: ${{ steps.app-token.outputs.token }}","-          SPLIT_CRATES_REMOTE_BASE: https://x-access-token:${{ steps.crates-token.outputs.token }}@github.com/utopia-rs","-          CRATES_GH_TOKEN: ${{ steps.crates-token.outputs.token }}","-          FORCE_CRATES: ${{ github.event_name == 'workflow_dispatch' && inputs.force-crates }}","         run: |","           if [ \"$GITHUB_REF_TYPE\" = \"tag\" ]; then","-            bin/monorepo split \"${GITHUB_REF_NAME%/*}\" --tag=\"${GITHUB_REF_NAME##*/}\"","-          elif [ \"$FORCE_CRATES\" = \"true\" ]; then","-            # shellcheck disable=SC2046","-            bin/monorepo split $(bin/monorepo list | awk '$1 ~ /^rs\\// {print $1}') --force","+            bin/monorepo split \"${GITHUB_REF_NAME%%/*}\" --tag=\"${GITHUB_REF_NAME#*/}\"","           else","             bin/monorepo split","           fi"],"additions":8,"deletions":40,"truncated":false},{"path":"Cargo.toml","lines":["@@ -18,16 +18,12 @@ edition = \"2024\""," rust-version = \"1.97\""," license = \"BSD-3-Clause\""," repository = \"https://github.com/appwrite/appwrite\"","-publish = false","-","-# Each crate under crates/utopia and crates/support has a Cargo.toml that stands on its own, so","-# its directory is its read-only mirror at github.com/utopia-rs/<name> as it is. A crate names","-# php-std by the mirror's URL; here that resolves to this checkout.","-[patch.\"https://github.com/utopia-rs/php-std\"]","-php-std = { path = \"crates/support/php-std\" }","+# The crates under crates/utopia and crates/support are published to crates.io. See rfc/monorepo.md.","+publish = true"," "," [workspace.dependencies]","-php-std = { path = \"crates/support/php-std\" }","+# The version is what a published crate asks crates.io for; this checkout uses the path.","+php-std = { path = \"crates/support/php-std\", version = \"0.1.0\" }"," utopia-auth = { path = \"crates/utopia/auth\" }"," utopia-balancer = { path = \"crates/utopia/balancer\" }"," utopia-compression = { path = \"crates/utopia/compression\" }"],"additions":4,"deletions":8,"truncated":false},{"path":"bin/monorepo","lines":["@@ -10,16 +10,14 @@","  * `<name>/<version>`, which pushes `<version>` to the mirror for Packagist to","  * pick up. See rfc/monorepo.md.","  *","- * A Rust crate in crates/utopia/<name> (or crates/support/<name>) is split, listed and","- * released by the same commands under the name `rs/<name>`: its directory goes to","- * github.com/utopia-rs/<name> as it is, and `rs/<name>/<version>` tags a release.","+ * A Rust crate in crates/utopia/<name> or crates/support/<name> is listed and released","+ * under the name `rs/<name>`: `rs/<name>/<version>` tags it, and crates.yml publishes that","+ * version to crates.io and to the crate's mirror at github.com/utopia-rs/<name>.","  */"," "," chdir(dirname(__DIR__));"," "," const ORG = 'utopia-php';","-const CRATES_ORG = 'utopia-rs';","-const CRATE = 'rs/'; // what a crate's name starts with: rs/query"," const REPOSITORY = 'appwrite/appwrite';"," const SPLIT_APP_ID = 4016286; // GitHub App that pushes splits to the mirrors"," const HOISTED = ['laravel/pint', 'phpstan/phpstan', 'rector/rector', 'phpunit/phpunit'];","@@ -119,50 +117,41 @@ function packages(): array","  * authenticated HTTPS URL via SPLIT_REMOTE_BASE.","  */"," /**","- * The Rust crates with a mirror, each named `rs/<name>`.","+ * The Rust crates that are published, each named `rs/<name>`.","  *","  * @return string[]","  */"," function crates(): array"," {","     $manifests = [...(glob('crates/utopia/*/Cargo.toml') ?: []), ...(glob('crates/support/*/Cargo.toml') ?: [])];","-    $names = array_map(fn (string $manifest) => CRATE . basename(dirname($manifest)), $manifests);","+    $names = array_map(fn (string $manifest) => 'rs/' . basename(dirname($manifest)), $manifests);","     sort($names);"," ","     return $names;"," }"," "," /**","- * Where a package or a crate lives in this repository, or null when there is none by that name.","+ * Where a package, or a crate named `rs/<name>`, lives in this repository, or null.","  */"," function directory(string $name): ?string"," {","-    if (!str_starts_with($name, CRATE)) {","+    if (!str_starts_with($name, 'rs/')) {","         return is_dir(\"packages/{$name}\") ? \"packages/{$name}\" : null;","     }","     foreach (['crates/utopia/', 'crates/support/'] as $parent) {","-        if (is_file($parent . substr($name, strlen(CRATE)) . '/Cargo.toml')) {","-            return $parent . substr($name, strlen(CRATE));","+        if (is_file($parent . substr($name, 3) . '/Cargo.toml')) {","+            return $parent . substr($name, 3);","         }","     }"," ","     return null;"," }"," ","-/**","- * The mirror of a package or a crate, as \"<org>/<repository>\".","- */","-function mirror(string $name): string","-{","-    return str_starts_with($name, CRATE) ? CRATES_ORG . '/' . substr($name, strlen(CRATE)) : ORG . '/' . $name;","-}","-","-function remote(string $name): string","+function remote(string $package): string"," {","-    [$org, $repository] = explode('/', mirror($name));","-    $base = getenv($org === CRATES_ORG ? 'SPLIT_CRATES_REMOTE_BASE' : 'SPLIT_REMOTE_BASE') ?: 'git@github.com:' . $org;","+    $base = getenv('SPLIT_REMOTE_BASE') ?: 'git@github.com:' . ORG;"," ","-    return $base . '/' . $repository . '.git';","+    return $base . '/' . $package . '.git';"," }"," "," function import_package(string $package, ?string $url, ?string $branch): void","@@ -250,7 +239,7 @@ function release_notes(string $package, string $version, string $to): string"," }"," "," /**","- * Compute the split head of a package or a crate: starting from the latest subtree","+ * Compute a package's split head: starting from the latest subtree","  * annotation (an import or rejoin merge), or from the repository root when","  * there is none, re-synthesize one commit per mainline commit that changed","  * the package, copying tree, author, committer and raw message. Deterministic,","@@ -259,12 +248,10 @@ function release_notes(string $package, string $version, string $to): string","  */"," function split_package(string $package): string"," {","-    $directory = directory($package);","-","     // With an annotation present, resume from it; without one — a hand-created","     // package, or one whose import merge a squash-merge flattened — synthesize","     // from the repository root, the first commit landing parentless.","-    $join = sh('git log --format=%H --grep=' . escapeshellarg(\"^git-subtree-dir: {$directory}\\$\") . ' -1 HEAD');","+    $join = sh('git log --format=%H --grep=' . escapeshellarg(\"^git-subtree-dir: packages/{$package}\\$\") . ' -1 HEAD');","     $tip = null;","     $range = 'HEAD';","     if ($join !== '') {","@@ -275,10 +262,10 @@ function split_package(string $package): string","         $range = \"{$mainline[1]}..HEAD\";","     }"," ","-    $commits = sh(\"git log --reverse --first-parent --format=%H {$range} -- {$directory}\");","+    $commits = sh(\"git log --reverse --first-parent --format=%H {$range} -- packages/{$package}\");","     foreach (array_filter(explode(\"\\n\", $commits)) as $commit) {","         unset($tree);","-        exec(\"git rev-parse -q --verify {$commit}:{$directory} 2>/dev/null\", $tree, $missing);","+        exec(\"git rev-parse -q --verify {$commit}:packages/{$package} 2>/dev/null\", $tree, $missing);","         if ($missing !== 0 || ($tip !== null && $tree[0] === sh(\"git rev-parse {$tip}^{tree}\"))) {","             continue;","         }","@@ -291,7 +278,7 @@ function split_package(string $package): string","         $tip = sh(\"git log -1 --pretty=format:%B {$commit} | {$environment}git commit-tree {$tree[0]} {$parent}\");","     }"," ","-    $tip !== null || fail(\"{$directory} has no commits to split\");","+    $tip !== null || fail(\"packages/{$package} has no commits to split\");"," ","     return $tip;"," }","@@ -747,10 +734,10 @@ switch ($command) {","         break;"," ","     case 'split':","-        $targets = $arguments !== [] ? $arguments : [...packages(), ...crates()];","+        $targets = $arguments !== [] ? $arguments : packages();","         $failed = [];","         foreach ($targets as $package) {","-            directory($package) !== null || fail(\"unknown package: {$package}\");","+            is_dir(\"packages/{$package}\") || fail(\"unknown package: {$package}\");"," ","             out(\"splitting {$package}...\");","             $sha = split_package($package);","@@ -788,14 +775,14 @@ switch ($command) {","                 // curl with an explicit token: gh's own auth resolution 401s","                 // intermittently (seen with both CI app tokens and the local","                 // keyring), while the same token works fine over plain HTTP.","-                $token = getenv(str_starts_with($package, CRATE) ? 'CRATES_GH_TOKEN' : 'GH_TOKEN') ?: sh('gh auth token');","+                $token = getenv('GH_TOKEN') ?: sh('gh auth token');","                 $authorization = escapeshellarg('Authorization: Bearer ' . $token);","                 foreach ([1, 2] as $attempt) {","                     $response = [];","                     exec('printf %s ' . escapeshellarg($payload)","                         . ' | curl -sS --fail-with-body -X POST -H ' . $authorization","                         . ' -H \"Accept: application/vnd.github+json\" --data-binary @- '","-                        . 'https://api.github.com/repos/' . mirror($package) . '/releases 2>&1', $response, $code);","+                        . 'https://api.github.com/repos/' . ORG . \"/{$package}/releases 2>&1\", $response, $code);","                     if ($code === 0 || $attempt === 2) {","                         break;","                     }","@@ -819,9 +806,20 @@ switch ($command) {","     case 'release':","         $package = $arguments[0] ?? fail('usage: monorepo release <package> <version> [--dry-run]');","         $version = $arguments[1] ?? fail('usage: monorepo release <package> <version> [--dry-run]');","-        directory($package) !== null || fail(\"unknown package: {$package}\");","+        $directory = directory($package) ?? fail(\"unknown package: {$package}\");","         preg_match('/^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$/', $version)","             || fail(\"version must be semver (e.g. 2.1.0 or 2.1.0-rc1), got \\\"{$version}\\\"\");","+        // crates.io publishes the version the manifest states, so the tag has to agree with it.","+        if (str_starts_with($package, 'rs/')) {","+            $metadata = json_decode(sh('cargo metadata --no-deps --format-version 1 --offline'), true);","+            $stated = null;","+            foreach ($metadata['packages'] ?? [] as $crate) {","+                if (dirname($crate['manifest_path']) === getcwd() . '/' . $directory) {","+                    $stated = $crate['version'];","+                }","+            }","+            $stated === $version || fail(\"{$directory}/Cargo.toml is at version {$stated}, not {$version}: set it there first\");","+        }"," ","         $tag = \"{$package}/{$version}\";","         if (sh('git tag --list ' . escapeshellarg($tag)) !== '') {","@@ -965,28 +963,6 @@ switch ($command) {","             out(\"{$class}: loadable from more than one directory (\" . implode(', ', $locations) . ')');","             $failures++;","         }","-        // A crate's directory is its mirror, so its manifest may lean on nothing outside it.","-        foreach (crates() as $crate) {","-            $directory = directory($crate);","-            $toml = (string) file_get_contents(\"{$directory}/Cargo.toml\");","-            $problems = [];","-            if (preg_match('/\\bworkspace\\s*=\\s*true\\b/', $toml) === 1) {","-                $problems[] = 'Cargo.toml inherits from the workspace, which the mirror does not have';","-            }","-            if (preg_match('/\\bpath\\s*=/', $toml) === 1) {","-                $problems[] = 'Cargo.toml names a dependency by path, which the mirror does not have';","-            }","-            if (!str_contains($toml, 'repository = \"https://github.com/' . mirror($crate) . '\"')) {","-                $problems[] = 'repository must be \"https://github.com/' . mirror($crate) . '\"';","-            }","-            if (!is_file(\"{$directory}/.github/workflows/mirror.yml\")) {","-                $problems[] = 'missing .github/workflows/mirror.yml, which closes pull requests opened on the mirror';","-            }","-            foreach ($problems as $problem) {","-                out(\"{$directory}: {$problem}\");","-            }","-            $failures += count($problems);","-        }","         if (file_get_contents('composer.json') !== root_manifest()) {","             out('composer.json: package autoload entries are stale, run `bin/monorepo autoload`');","             $failures++;","@@ -1149,7 +1125,7 @@ switch ($command) {","                                               push package histories to their mirrors","           release <name> <version> [--dry-run]","                                               preview notes, tag <name>/<version> and push it (CI does the rest)","-          validate                            check the package shape, the crate manifests and 