","+publish.workspace = true"," "," [dependencies]","-bytes = \"1\"","+bytes.workspace = true"," # crypt(), password_*() and hash(): Blowfish (EksBlowfish), MD5, SHA-1, SHA-2 and SHA-3 (RustCrypto),"," # and BLAKE2b for Argon2 (src/argon2.rs).","-blake2 = \"0.10\"","-blowfish = { version = \"0.9\", features = [\"bcrypt\"] }","-foldhash = \"0.2\"","-getrandom = \"0.3\"","-gost94 = \"0.10\"","-hashbrown = { version = \"0.17\", default-features = false }","-indexmap = \"2\"","-md-5 = \"0.10\"","-md2 = \"0.10\"","-icu_normalizer = { version = \"2.3\", default-features = false, features = [\"compiled_data\"] }","-icu_properties = { version = \"2.3\", default-features = false, features = [\"compiled_data\"] }","-ripemd = \"0.1\"","-rustix = { version = \"1\", default-features = false, features = [\"std\", \"fs\", \"system\"] }","+blake2.workspace = true","+blowfish.workspace = true","+foldhash.workspace = true","+getrandom.workspace = true","+gost94.workspace = true","+hashbrown.workspace = true","+indexmap.workspace = true","+md-5.workspace = true","+md2.workspace = true","+icu_normalizer.workspace = true","+icu_properties.workspace = true","+ripemd.workspace = true","+rustix.workspace = true"," # Shortest round-trip float digits (serialize_precision = -1).","-ryu = \"1\"","-serde_json = { version = \"1\", features = [\"raw_value\", \"preserve_order\", \"float_roundtrip\"] }","-sha1 = \"0.10\"","-sha2 = \"0.10\"","-sha3 = \"0.10\"","-whirlpool = \"0.10\"","-xxhash-rust = { version = \"0.8\", features = [\"xxh3\"] }","+ryu.workspace = true","+serde_json.workspace = true","+sha1.workspace = true","+sha2.workspace = true","+sha3.workspace = true","+whirlpool.workspace = true","+xxhash-rust.workspace = true"," # yaml_parse(): libyaml 0.2.5 translated to Rust, the parser ext-yaml links, so"," # documents are accepted, refused and split into events exactly as in PHP.","-unsafe-libyaml = \"0.2\"","+unsafe-libyaml.workspace = true"," # Wipes Argon2's memory after a hash, as libargon2 does.","-zeroize = \"1\"","+zeroize.workspace = true"," "," [dev-dependencies]"," # The reference src/argon2.rs is tested against.","-argon2 = { version = \"0.5\", features = [\"std\"] }","+argon2.workspace = true"," "," [build-dependencies]"," # PCRE2 10.44 with its JIT, from the sources PHP 8.5 bundles (pcre2/): the"," # preg_* functions run user patterns, which must behave exactly as in PHP, and"," # no Rust engine does (see src/pcre.rs).","-cc = \"1\"","+cc.workspace = true"," "," [package.metadata.utopia]"," category = \"platform\""],"additions":31,"deletions":30,"truncated":false},{"path":"crates/support/php-std/README.md","lines":["@@ -1,8 +1,5 @@"," # PHP standard library"," ","-> [!IMPORTANT]","-> This repository is a read-only mirror of [`crates/support/php-std`](https://github.com/appwrite/appwrite/tree/main/crates/support/php-std) in [appwrite/appwrite](https://github.com/appwrite/appwrite). Development happens there: please open issues and pull requests in that repository.","-"," [![Discord](https://img.shields.io/discord/564160730845151244?label=discord)](https://discord.gg/GSeTUeA)"," "," PHP engine semantics (the value model, juggling and comparison, string, number, JSON, serialize, igbinary, sorting, filter and URL functions) for crates that must behave exactly like PHP.","@@ -13,7 +10,7 @@ This library is maintained by the [Appwrite team](https://appwrite.io)."," "," ```toml"," [dependencies]","-php-std = { git = \"https://github.com/utopia-rs/php-std\" }","+php-std = { git = \"https://github.com/appwrite/appwrite\" }"," ```"," "," php-std reproduces PHP built-in functions and value semantics in Rust, byte for byte. When you port PHP code, call the php-std twin of each built-in instead of writing your own approximation, and the Rust code gives the same answer as PHP, edge cases included. Strings are bytes (`&[u8]`), because PHP strings are bytes. This guide covers the common tasks."],"additions":1,"deletions":4,"truncated":false},{"path":"crates/utopia/auth/.github/workflows/mirror.yml","lines":["@@ -1,18 +0,0 @@","-name: Mirror","-","-on:","-  pull_request_target:","-    types: [opened]","-  issues:","-    types: [opened]","-","-permissions:","-  issues: write","-  pull-requests: write","-","-jobs:","-  redirect:","-    uses: appwrite/appwrite/.github/workflows/mirror-redirect.yml@main","-    with:","-      package: auth","-      path: crates/utopia/auth"],"additions":0,"deletions":18,"truncated":false},{"path":"crates/utopia/auth/.gitignore","lines":["@@ -1,2 +1 @@"," /target","-Cargo.lock"],"additions":0,"deletions":1,"truncated":false},{"path":"crates/utopia/auth/Cargo.toml","lines":["@@ -1,21 +1,22 @@"," [package]"," name = \"utopia-auth\""," description = \"The password hash algorithms of utopia-php/auth: PECL scrypt, Firebase's modified scrypt and phpass.\"","-version = \"0.1.0\"","-edition = \"2024\"","-rust-version = \"1.97\"","-license = \"BSD-3-Clause\"","-repository = \"https://github.com/utopia-rs/auth\"","+version.workspace = true","+edition.workspace = true","+rust-version.workspace = true","+license.workspace = true","+repository.workspace = true","+publish.workspace = true"," "," [dependencies]"," # AES-256 for Firebase's modified scrypt (openssl_encrypt aes-256-ctr in PHP).","-aes = \"0.8\"","+aes.workspace = true"," # random_bytes() and password_hash()'s salts.","-getrandom = \"0.3\"","-md-5 = \"0.10\"","-php-std = { version = \"0.1.0\", git = \"https://github.com/utopia-rs/php-std\" }","-sha2 = \"0.10\"","-zeroize = \"1\"","+getrandom.workspace = true","+md-5.workspace = true","+php-std.workspace = true","+sha2.workspace = true","+zeroize.workspace = true"," "," [package.metadata.utopia]"," category = \"security\""],"additions":12,"deletions":11,"truncated":false},{"path":"crates/utopia/auth/README.md","lines":["@@ -1,8 +1,5 @@"," # Utopia Auth"," ","-> [!IMPORTANT]","-> This repository is a read-only mirror of [`crates/utopia/auth`](https://github.com/appwrite/appwrite/tree/main/cra