ng the same security checks. Primary success does no extra work."," fn with_user_cache_root<T>(materialize: impl Fn(&Path) -> Result<T>) -> Result<T> {","     let primary = platform::user_cache_root().and_then(|root| materialize(&root));","-    #[cfg(windows)]","     if let Err(primary) = primary {","         if primary.kind != ErrorKind::Cache {","             return Err(primary);","         }","-        tracing::debug!(error = %primary, \"native user cache unavailable; trying profile cache\");","-        return platform::user_profile_cache_root()","+        tracing::debug!(error = %primary, \"native user cache unavailable; trying fallback cache\");","+        return platform::fallback_cache_root()","             .and_then(|root| materialize(&root))","             .map_err(|fallback| {","                 if fallback.kind != ErrorKind::Cache {","@@ -145,7 +144,7 @@ fn with_user_cache_root<T>(materialize: impl Fn(&Path) -> Result<T>) -> Result<T","                 Error::new(","                     ErrorKind::Cache,","                     format!(","-                        \"user cache failed: {primary}; profile cache failed: {fallback}; set \\","+                        \"user cache failed: {primary}; fallback cache failed: {fallback}; set \\","                          SWC_NATIVE_BINDING_CACHE to a safe absolute directory owned by your user \\","                          whose ancestors do not grant other users replacement rights\"","                     ),"],"additions":7,"deletions":8,"truncated":false},{"path":"crates/swc_native_addon/src/platform/unix.rs","lines":["@@ -23,9 +23,9 @@ pub fn user_namespace() -> Result<String> {","     Ok(format!(\"swc-native-{}\", unsafe { libc::geteuid() }))"," }"," ","-/// Use a per-user location rather than the system temporary directory: hardened","-/// Linux installations commonly mount the latter `noexec`, which prevents the","-/// dynamic loader from mapping a materialized addon.","+/// Prefer a per-user location: hardened Linux installations commonly mount the","+/// system temporary directory `noexec`, preventing native addon loading. The","+/// temporary directory is a fallback only and must pass the same checks."," pub fn user_cache_root() -> Result<PathBuf> {","     let root = env::var_os(\"XDG_CACHE_HOME\")","         .filter(|value| Path::new(value).is_absolute())","@@ -45,6 +45,13 @@ pub fn user_cache_root() -> Result<PathBuf> {","     Ok(root)"," }"," ","+/// Resolve aliases such as macOS's /var before validating fallback ancestors.","+/// The caller still checks mount execution policy and directory security.","+pub(crate) fn fallback_cache_root() -> Result<PathBuf> {","+    fs::canonicalize(env::temp_dir())","+        .map_err(|e| Error::io(ErrorKind::Cache, \"resolve native addon fallback cache\", e))","+}","+"," /// Reject roots from which the dynamic loader cannot map a materialized addon."," /// This applies to explicit custom roots as well as the user default."," pub fn executable_cache_root(root: &Path) -> Result<()> {"],"additions":10,"deletions":3,"truncated":false},{"path":"crates/swc_native_addon/src/platform/windows.rs","lines":["@@ -142,7 +142,7 @@ pub fn user_cache_root() -> Result<PathBuf> {"," /// AppContainer grants inherited by LocalAppData can make it unsafe for native"," /// loading. Use a separately validated profile cache rather than trusting those"," /// grants or changing the user's directory ACLs.","-pub(crate) fn user_profile_cache_root() -> Result<PathBuf> {","+pub(crate) fn fallback_cache_root() -> Result<PathBuf> {","     env::var_os(\"USERPROFILE\")","         .filter(|value| Path::new(value).is_absolute())","         .map(|value| PathBuf::from(value).join(\".swc-cache\"))"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/swc_native_addon/tests/cache.rs","lines":["@@ -4,6 +4,10 @@ mod support;"," #[path = \"support/cache_security.rs\"]"," mod cache_security;"," ","+#[cfg(unix)]","+#[path = \"support/unix_cache_fallback.rs\"]","+mod unix_cache_fallback;","+"," use std::{fs, io::Cursor, process::Command};"," "," use swc_native_addon::{"],"additions":4,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/tests/fixtures/unix-cache.txt","lines":["@@ -0,0 +1,12 @@","+# Each case runs in an isolated child process with a real native payload.","+home","+xdg","+custom","+primary","+symlink-temp","+unsafe-temp","+missing-temp","+missing-primary","+primary-integrity","+fallback-integrity","+noexec-temp"],"additions":12,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/tests/support/unix_cache_fallback.rs","lines":["@@ -0,0 +1,213 @@","+//! Unix fallback cases use child processes to isolate cache environment","+//! changes.","+","+use std::{","+    env, fs,","+    io::Cursor,","+    os::unix::fs::{symlink, PermissionsExt},","+    path::PathBuf,","+    process::Command,","+};","+","+use swc_native_addon::{","+    cache::{self, CacheMode},","+    format::Payload,","+    integrity::{RuntimeIntegrity, INTEGRITY_LEN},","+    platform, ErrorKind,","+};","+","+use super::support;","+","+#[derive(Clone, Copy, Debug, PartialEq)]","+enum Scenario {","+    Home,","+    Xdg,","+    Custom,","+    Primary,","+    SymlinkTemp,","+    UnsafeTemp,","+    MissingTemp,","+    MissingPrimary,","+    PrimaryIntegrity,","+    FallbackIntegrity,","+    NoexecTemp,","+}","+","+impl Scenario {","+    fn parse(value: &str) -> Self {","+        match value {","+            \"home\" => Self::Home,","+            \"xdg\" => Self::Xdg,","+            \"custom\" => Self::Custom,","+            \"primary\" => Self::Primary,","+            \"symlink-temp\" => Self::SymlinkTemp,","+            \"unsafe-temp\" => Self::UnsafeTemp,","+            \"missing-temp\" => Self::MissingTemp,","+            \"missing-primary\" => Self::MissingPrimary,","+            \"primary-integrity\" => Self::PrimaryIntegrity,","+            \"fallback-integrity\" => Self::FallbackIntegrity,","+            \"noexec-temp\" => Self::NoexecTemp,","+            _ => panic!(\"unknown Unix cache fixture {value}\"),","+        }","+    }","+}","+","+#[test]","+fn unix_cache_fixtures() {","+    for case in include_str!(\"../fixtures/unix-cache.txt\").lines() {","+        if case.is_empty() || case.starts_with('#') {","+            continue;","+        }","+        let scenario = Scenario::parse(case);","+        if scenario == Scenario::NoexecTemp {","+            // Linux exposes a conventional noexec tmpfs without privileged","+            // mounts. Other hosts still exercise unsafe and missing fallbacks.","+            if !cfg!(target_os = \"linux\") || !std::path::Path::new(\"/dev/shm\").is_dir() {","+                continue;","+            }","+            if platform::executable_cache_root(std::path::Path::new(\"/dev/shm\")).is_ok() {","+                continue;","+            }","+        }","+        let temporary = tempfile::tempdir().unwrap();","+        let root = temporary.path().canonicalize().unwrap();","+        let output = Command::new(env::current_exe().unwrap())","+            .args([","+                \"--exact\",","+                \"unix_cache_fallback::unix_cache_worker\",","+                \"--nocapture\",","+            ])","+            .env(\"SWC_TEST_UNIX_CACHE_CASE\", case)","+            .env(\"SWC_TEST_UNIX_CACHE_ROOT\", &root)","+            .env(\"HOME\", root.join(\"home\"))","+            .env(\"XDG_CACHE_HOME\", root.join(\"home/cache\"))","+            .env(\"TMPDIR\", root.join(\"tmp\"))","+            .env_remove(\"SWC_NATIVE_BINDING_CACHE\")","+            .env_remove(\"SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK\")","+            .output()","+            .unwrap();","+        assert!(","+            output.status.success(),","+            \"{case}: {}{}\",","+            String::from_utf8_lossy(&output.stdout),","+            String::from_utf8_lossy(&output.stderr)","+        );","+    }","+}","+","+#[test]","+fn unix_cache_worker() {","+    let Ok(case) = env::var(\"SWC_TEST_UNIX_CACHE_CASE\") else {","+        return;","+    };","+    let scenario = Scenario::parse(&case);","+    let root = PathBuf::from(env::var_os(\"SWC_TEST_UNIX_CACHE_ROOT\").unwrap());","+    let home = root.join(\"home\");","+    let fallback = root.join(\"tmp\");","+    fs::create_dir(&home).unwrap();","+    fs::create_dir(&fallback).unwrap();","+    let primary_usable = matches!(scenario, Scenario::Primary | Scenario::PrimaryIntegrity);","+    fs::set_permissions(","+        &home,","+        fs::Permissions::from_mode(if primary_usable { 0o700 } else { 0o775 }),","+    )","+    .unwrap();","+    let bytes = support::packed();","+    let payload = Payload::parse(&bytes).unwrap();","+    let raw = fs::read(support::fixture()).unwrap();","+    match scenario {","+        Scenario::Home => env::remove_var(\"XDG_CACHE_HOME\"),","+        Scenario::Primary | Scenario::PrimaryIntegrity | Scenario::MissingTemp => {","+            env::set_var(\"TMPDIR\", root.join(\"missing\"));","+        }","+        Scenario::SymlinkTemp => {","+            let alias = root.join(\"alias\");","+            symlink(&fallback, &alias).unwrap();","+            env::set_var(\"TMPDIR\", alias);","+        }","+        Scenario::UnsafeTemp => {","+            fs::set_permissions(&fallback, fs::Permissions::from_mode(0o775)).unwrap();","+        }","+        Scenario::MissingPrimary => {","+            env::remove_var(\"HOME\");","+            env::remove_var(\"XDG_CACHE_HOME\");","+        }","+        Scenario::NoexecTemp => env::set_var(\"TMPDIR\", \"/dev/shm\"),","+        _ => {}","+    }","+    let primary = platform::user_cache_root().ok();","+    let corrupt = matches!(","+        scenario,","+        Scenario::PrimaryIntegrity | Scenario::FallbackIntegrity","+    );","+    let mut integrity = RuntimeIntegrity::from_raw(&payload.header, &mut Cursor::new(&raw))","+        .unwrap()","+        .encode();","+    if corrupt {","+        integrity[INTEGRITY_LEN - 1] ^= 1;","+    }","+    let payload = payload","+        .with_integrity(RuntimeIntegrity::parse(&integrity).unwrap())","+        .unwrap();","+    let blocked = root.join(\"blocked\");","+    fs::write(&blocked, b\"preserve me\").unwrap();","+    let mut modes = vec![CacheMode::Default, CacheMode::Temporary];","+    if scenario == Scenario::Custom {","+        modes.push(CacheMode::Custom(blocked.clone()));","+    }","+    for mode in modes {","+        let result = cache::materialize(&payload, &mode);","+        if corrupt {","+            let error = result.err().expect(\"corrupt payload must fail\");","+            assert_eq!(error.kind, ErrorKind::Integrity);","+            assert!(!error.to_string().contains(\"fallback cache failed\"));","+            continue;","+        }","+        if matches!(","+            scenario,","+            Scenario::UnsafeTemp | Scenario::MissingTemp | Scenario::NoexecTemp","+        ) {","+            let error = result.err().expect(\"unusable roots must fail\");","+            assert_eq!(error.kind, ErrorKind::Cache);","+            let message = error.to_string();","+            assert!(message.contains(\"user cache failed\"), \"{message}\");","+            assert!(message.contains(\"fallback cache failed\"), \"{message}\");","+            assert!(message.contains(\"SWC_NATIVE_BINDING_CACHE\"), \"{message}\");","+            assert!(message.contains(&home.display().to_string()), \"{message}\");","+            if scenario == Scenario::UnsafeTemp {","+                assert!(","+                    message.contains(&fallback.display().to_string()),","+                    \"{message}\"","+                );","+            }","+            if scenario == Scenario::NoexecTemp {","+                assert!(message.contains(\"noexec\"), \"{message}\");","+            }","+            continue;","+        }","+        let selected = if primary_usable {","+            primary.as_ref().unwrap()","+        } else {","+            &fallback","+        };","+        let mut image = result.unwrap();","+        assert!(image.path().starts_with(selected));","+        assert_eq!(fs::read(image.path()).unwrap(), raw);","+        let directory = image.path().parent().unwrap();","+        for private in [directory, directory.parent().unwrap()] {","+            assert_eq!(","+                fs::metadata(private).unwrap().permissions().mode() & 0o777,","+                0o700","+            );","+        }","+        let path = image.path().to_owned();","+        let library = unsafe { libloading::Library::new(&path) }.unwrap();","+        image.loaded().unwrap();","+        assert_eq!(path.exists(), mode != CacheMode::Temporary);","+        drop(library);","+    }","+    assert_eq!(fs::read(&blocked).unwrap(), b\"preserve me\");","+    if primary_usable {","+        assert!(!fallback.join(platform::user_namespace().unwrap()).exists());","+    }","+}"],"additions":213,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/tests/windows_cache.rs","lines":["@@ -156,13 +156,13 @@ fn windows_cache_worker() {","         let error = result.err().expect(\"unsafe caches or payload must fail\");","         if scenario == Scenario::Integrity {","             assert_eq!(error.kind, ErrorKind::Integrity);","-            assert!(!error.to_string().contains(\"profile cache\"));","+            assert!(!error.to_string().contains(\"fallback cache\"));","         } else {","             assert_eq!(error.kind, ErrorKind::Cache);","             let message = error.to_string();","             assert!(message.contains(&local.display().to_string()), \"{message}\");","             assert!(message.contains(Grant::AppContainer.sid()), \"{message}\");","-            assert!(message.contains(\"profile cache failed\"), \"{message}\");","+            assert!(message.contains(\"fallback cache failed\"), \"{message}\");","             assert!(message.contains(\"SWC_NATIVE_BINDING_CACHE\"), \"{message}\");","             if matches!(","                 scenario,"],"additions":2,"deletions":2,"truncated":false},{"path":"docs/native-addon-carriers.md","lines":["@@ -66,7 +66,12 @@ cache files, full integrity checks, locking, and atomic publication remain"," required. The opt-out does not permit unsafe directories or links inside the"," private namespace."," ","-Failure of both a custom root and the default root throws. An executable cache","+If the default root is unusable, both default and temporary modes try the","+system temporary directory on Unix (respecting `TMPDIR`) or","+`USERPROFILE/.swc-cache` on Windows. Unix resolves temporary-directory symlinks","+before applying the same security checks. Only cache failures trigger this","+retry; corrupt payloads still fail immediately. Failure of every candidate root","+throws. An executable cache"," filesystem is required; a Linux `noexec` cache is rejected. Existing cache"," namespaces retain at most three inactive-or-current raw images."," ",""],"additions":6,"deletions":1,"truncated":false}],"additions":295,"deletions":16,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-11T14:22:29.968263+00:00"}