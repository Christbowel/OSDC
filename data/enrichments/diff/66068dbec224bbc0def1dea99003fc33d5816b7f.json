ions: t.wafRegexes.Load(),","+\t\tPrefilterSkips:   t.wafSkips.Load(),","+\t\tDuration:         time.Duration(t.wafDuration.Load()),","+\t}"," }"," "," func (t *Tracker) incrementCounter(m *mapsutil.SyncLockMap[string, *atomic.Int32], key string) {"],"additions":41,"deletions":3,"truncated":false},{"path":"pkg/output/stats/stats_test.go","lines":["@@ -1,7 +1,10 @@"," package stats"," "," import (","+\t\"sync\""," \t\"testing\"","+","+\t\"github.com/stretchr/testify/require\""," )"," "," func TestTrackErrorKind(t *testing.T) {","@@ -34,3 +37,56 @@ func TestTrackWaf_Detect(t *testing.T) {"," \t\tt.Errorf(\"expected waf detected count to be 1, got %v\", count)"," \t}"," }","+","+func TestTrackersShareDetectorButNotCounters(t *testing.T) {","+\tfirst := NewTracker()","+\tsecond := NewTracker()","+","+\trequire.Same(t, first.wafDetector, second.wafDetector)","+","+\tfirst.TrackStatusCode(\"200\")","+\tfirst.TrackErrorKind(\"timeout\")","+\tfirst.TrackWAFDetected(\"Attention Required! | Cloudflare\")","+","+\trequire.Equal(t, 1, first.GetStats().StatusCodeStats[\"200\"])","+\trequire.Equal(t, 1, first.GetStats().ErrorStats[\"timeout\"])","+\trequire.Equal(t, 1, first.GetStats().WAFStats[\"CloudFlare\"])","+\trequire.Empty(t, second.GetStats().StatusCodeStats)","+\trequire.Empty(t, second.GetStats().ErrorStats)","+\trequire.Empty(t, second.GetStats().WAFStats)","+}","+","+func TestWAFMetricsAreExecutionLocal(t *testing.T) {","+\tfirst := NewTracker()","+\tsecond := NewTracker()","+\tresponse := \"ordinary response with no WAF signature\"","+","+\tfirst.TrackWAFDetected(response)","+","+\tmetrics := first.GetWAFMetrics()","+\trequire.Equal(t, uint64(1), metrics.Calls)","+\trequire.Equal(t, uint64(len(response)), metrics.Bytes)","+\trequire.Greater(t, metrics.PrefilterSkips, uint64(0))","+\trequire.Greater(t, metrics.RegexEvaluations+metrics.PrefilterSkips, uint64(0))","+\trequire.Zero(t, second.GetWAFMetrics().Calls)","+}","+","+func TestWAFMetricsAreConcurrencySafe(t *testing.T) {","+\ttracker := NewTracker()","+\tresponse := \"ordinary response with no WAF signature\"","+","+\tconst calls = 32","+\tvar wg sync.WaitGroup","+\tfor range calls {","+\t\twg.Add(1)","+\t\tgo func() {","+\t\t\tdefer wg.Done()","+\t\t\ttracker.TrackWAFDetected(response)","+\t\t}()","+\t}","+\twg.Wait()","+","+\tmetrics := tracker.GetWAFMetrics()","+\trequire.Equal(t, uint64(calls), metrics.Calls)","+\trequire.Equal(t, uint64(calls*len(response)), metrics.Bytes)","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"pkg/output/stats/waf/literal_matcher.go","lines":["@@ -0,0 +1,145 @@","+package waf","+","+import \"unicode/utf8\"","+","+type literalMatcherNode struct {","+\tnext    [256]int32","+\tfailure int32","+\toutputs []string","+}","+","+// literalMatcher finds every configured byte string in one pass over the","+// response. WAF responses can be several megabytes, so scanning once is much","+// cheaper than searching the response once for every WAF signature.","+type literalMatcher struct {","+\tnodes []literalMatcherNode","+}","+","+func newLiteralMatcher(patterns []string) *literalMatcher {","+\tif len(patterns) == 0 {","+\t\treturn nil","+\t}","+","+\tmatcher := &literalMatcher{nodes: []literalMatcherNode{newLiteralMatcherNode()}}","+\tseen := make(map[string]struct{}, len(patterns))","+\tfor _, pattern := range patterns {","+\t\tif pattern == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\tif _, ok := seen[pattern]; ok {","+\t\t\tcontinue","+\t\t}","+\t\tseen[pattern] = struct{}{}","+","+\t\tstate := int32(0)","+\t\tfor index := 0; index < len(pattern); index++ {","+\t\t\tvalue := pattern[index]","+\t\t\tnext := matcher.nodes[state].next[value]","+\t\t\tif next == -1 {","+\t\t\t\tnext = int32(len(matcher.nodes))","+\t\t\t\tmatcher.nodes = append(matcher.nodes, newLiteralMatcherNode())","+\t\t\t\tmatcher.nodes[state].next[value] = next","+\t\t\t}","+\t\t\tstate = next","+\t\t}","+\t\tmatcher.nodes[state].outputs = append(matcher.nodes[state].outputs, pattern)","+\t}","+","+\tqueue := make([]int32, 0, len(matcher.nodes))","+\tfor value := 0; value < 256; value++ {","+\t\tchild := matcher.nodes[0].next[byte(value)]","+\t\tif child == -1 {","+\t\t\tmatcher.nodes[0].next[byte(value)] = 0","+\t\t\tcontinue","+\t\t}","+\t\tmatcher.nodes[child].failure = 0","+\t\tqueue = append(queue, child)","+\t}","+","+\tfor len(queue) > 0 {","+\t\tstate := queue[0]","+\t\tqueue = queue[1:]","+\t\tfor value := 0; value < 256; value++ {","+\t\t\tchild := matcher.nodes[state].next[byte(value)]","+\t\t\tif child == -1 {","+\t\t\t\tmatcher.nodes[state].next[byte(value)] = matcher.nodes[matcher.nodes[state].failure].next[byte(value)]","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tfailure := matcher.nodes[matcher.nodes[state].failure].next[byte(value)]","+\t\t\tmatcher.nodes[child].failure = failure","+\t\t\tmatcher.nodes[child].outputs = append(matcher.nodes[child].outputs, matcher.nodes[failure].outputs...)"],"additions":70,"deletions":0,"truncated":false}],"additions":509,"deletions":26,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-09-15T12:58:56.984262+00:00"}