mport sinon from 'sinon';","+import {createContainer, removeMapContainer} from '../SpecHelper.js';","+","+describe('FullscreenControl', () => {","+\tlet container, map;","+","+\tbeforeEach(() => {","+\t\tcontainer = createContainer();","+\t\tmap = new LeafletMap(container).setView([0, 0], 1);","+\t});","+","+\tafterEach(() => {","+\t\tremoveMapContainer(map, container);","+\t});","+","+\tit('toggles pseudo-fullscreen and fires map events', () => {","+\t\tconst control = new FullscreenControl({pseudo: true}).addTo(map),","+\t\tenter = sinon.spy(), exit = sinon.spy();","+\t\tmap.on({enterfullscreen: enter, exitfullscreen: exit});","+","+\t\tcontrol.toggle();","+\t\texpect(control.isFullscreen()).to.equal(true);","+\t\texpect(container.classList.contains('leaflet-pseudo-fullscreen')).to.equal(true);","+\t\texpect(container.classList.contains('leaflet-fullscreen-on')).to.equal(true);","+\t\texpect(control.getContainer().querySelector('a').title).to.equal('Exit fullscreen');","+\t\texpect(enter.calledOnce).to.equal(true);","+","+\t\tcontrol.toggle();","+\t\texpect(control.isFullscreen()).to.equal(false);","+\t\texpect(container.classList.contains('leaflet-pseudo-fullscreen')).to.equal(false);","+\t\texpect(exit.calledOnce).to.equal(true);","+\t});","+","+\tit('sets fullscreen explicitly, ignoring no-op calls', () => {","+\t\tconst control = new FullscreenControl({pseudo: true}).addTo(map),","+\t\tenter = sinon.spy(), exit = sinon.spy();","+\t\tmap.on({enterfullscreen: enter, exitfullscreen: exit});","+","+\t\tcontrol.setFullscreen(false);","+\t\texpect(exit.called).to.equal(false);","+","+\t\tcontrol.setFullscreen(true).setFullscreen(true);","+\t\texpect(control.isFullscreen()).to.equal(true);","+\t\texpect(enter.calledOnce).to.equal(true);","+","+\t\tcontrol.setFullscreen(false).setFullscreen(false);","+\t\texpect(control.isFullscreen()).to.equal(false);","+\t\texpect(exit.calledOnce).to.equal(true);","+\t});","+","+\tit('exits pseudo-fullscreen on Escape unless something else handled it', () => {","+\t\tconst control = new FullscreenControl({pseudo: true}).addTo(map).toggle(),","+\t\tprevented = new KeyboardEvent('keydown', {key: 'Escape', cancelable: true});","+\t\tprevented.preventDefault();","+","+\t\tdocument.dispatchEvent(prevented);","+\t\texpect(control.isFullscreen()).to.equal(true);","+","+\t\tdocument.dispatchEvent(new KeyboardEvent('keydown', {key: 'Escape'}));","+\t\texpect(control.isFullscreen()).to.equal(false);","+\t});","+","+\tit('exits fullscreen when removed', () => {","+\t\tconst control = new FullscreenControl({pseudo: true}).addTo(map).toggle();","+\t\tcontrol.remove();","+\t\texpect(container.classList.contains('leaflet-pseudo-fullscreen')).to.equal(false);","+\t\texpect(container.classList.contains('leaflet-fullscreen-on')).to.equal(false);","+\t});","+","+\tit('fullscreens a given container', () => {","+\t\tconst parent = document.createElement('div'),","+\t\tcontrol = new FullscreenControl({container: parent, pseudo: true}).addTo(map).toggle();","+\t\texpect(parent.classList.contains('leaflet-pseudo-fullscreen')).to.equal(true);","+\t\tcontrol.toggle();","+\t});","+});"],"additions":77,"deletions":0,"truncated":false},{"path":"spec/tree_shaking.js","lines":["@@ -18,7 +18,7 @@ let failed = false;"," const alwaysAbsent = ["," \t'layer/GeoJSON.js', 'layer/LayerGroup.js', 'layer/FeatureGroup.js', 'layer/tile/WMSTileLayer.js',"," \t'layer/ImageOverlay.js', 'layer/VideoOverlay.js', 'layer/SVGOverlay.js', 'layer/vector/Canvas.js',","-\t'control/LayersControl.js', 'control/ScaleControl.js', 'geo/crs/EPSG3395.js', 'geo/crs/EPSG4326.js',","+\t'control/LayersControl.js', 'control/ScaleControl.js', 'control/FullscreenControl.js', 'geo/crs/EPSG3395.js', 'geo/crs/EPSG4326.js',"," \t'geo/crs/SimpleCRS.js'"," ];"," const bundles = {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/Leaflet.js","lines":["@@ -12,6 +12,7 @@ export const version = '2.0.0-beta.1';"," // control"," export {AttributionControl} from './control/AttributionControl.js';"," export {Control} from './control/Control.js';","+export {FullscreenControl} from './control/FullscreenControl.js';"," export {LayersControl} from './control/LayersControl.js';"," export {ScaleControl} from './control/ScaleControl.js';"," export {ZoomControl} from './control/ZoomControl.js';"],"additions":1,"deletions":0,"truncated":false},{"path":"src/control/FullscreenControl.js","lines":["@@ -0,0 +1,157 @@","+import {Control} from './Control.js';","+import * as DomUtil from '../dom/DomUtil.js';","+import * as DomEvent from '../dom/DomEvent.js';","+","+/** @import {ControlOptions, Defaults, FullscreenControlDefaults, FullscreenControlOptions} from '../types.js' */","+/** @import {LeafletMap} from '../map/Map.js' */","+","+/** @satisfies {Defaults<ControlOptions>} */","+const defaultOptions = {","+\t/**","+\t * The position of the control (one of the map corners). Possible values","+\t * are `'topleft'`, `'topright'`, `'bottomleft'` or `'bottomright'`","+\t */","+\tposition: 'topleft',","+","+\t/** The text set on the button while the map is not fullscreen. */","+\tenterText: '<svg width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M1 5V1h4m4 0h4v4m0 4v4H9m-4 0H1V9\"/></svg>',","+","+\t/** The title set on the button while the map is not fullscreen. */","+\tenterTitle: 'Enter fullscreen',","+","+\t/** The text set on the button while the map is fullscreen. */","+\texitText: '<svg width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 1v4H1m8-4v4h4m0 4H9v4m-4 0V9H1\"/></svg>',","+","+\t/** The title set on the button while the map is fullscreen. */","+\texitTitle: 'Exit fullscreen',","+","+\t/**","+\t * The element to make fullscreen, e.g. a parent that also holds a sidebar. Defaults to the map container.","+\t * @type {HTMLElement | undefined}","+\t */","+\tcontainer: undefined,","+","+\t/**","+\t * Whether to always fill the window with CSS instead of using the Fullscreen API. The control falls back to","+\t * this where the API isn't available, e.g. on iPhone or in an iframe without `allow=\"fullscreen\"`.","+\t */","+\tpseudo: false","+};","+","+/** @typedef {typeof defaultOptions} FullscreenControlDefaultsValues */","+","+/**","+ * A button that toggles fullscreen mode for the map, using the Fullscreen API where available and filling the","+ * window otherwise. The map fires `enterfullscreen` and `exitfullscreen` when the mode changes. Extends `Control`.","+ *","+ * @example","+ * ```js","+ * new FullscreenControl().addTo(map);","+ * ```","+ * @template {FullscreenControlOptions} [O=FullscreenControlOptions]","+ * @extends {Control<O & FullscreenControlDefaults>}","+ */","+export class FullscreenControl extends Control {","+","+\t/** @type {Defaults<FullscreenControlOptions>} */","+\tstatic defaultOptions = defaultOptions;","+","+\t/**","+\t * @param {LeafletMap} map","+\t * @returns {HTMLElement}","+\t */","+\tonAdd(map) {","+\t\tconst container = DomUtil.create('div', 'leaflet-control-fullscreen leaflet-bar'),","+\t\tlink = this._link = DomUtil.create('a', '', container);","+","+\t\tlink.href = '#';","+\t\tlink.setAttribute('role', 'button');","+","+\t\t/** @type {HTMLElement} */","+\t\tthis._target = this.options.container ?? map.getContainer();","+\t\t/** @type {boolean} */","+\t\tthis._fullscreen = false;","+\t\tthis._update();","+","+\t\tDomEvent.disableClickPropagation(link);","+\t\tDomEvent.on(link, 'click', (e) => {","+\t\t\tDomEvent.stop(e);","+\t\t\tthis.toggle();","+\t\t\tthis._refocusOnMap(/** @type {MouseEvent} */ (e));","+\t\t});","+\t\tDomEvent.on(this._target, 'fullscreenchange', this._onFullscreenChange, this);","+","+\t\treturn container;","+\t}","+","+\t/** @param {LeafletMap} map */","+\tonRemove(map) {","+\t\t// a native exit fires fullscreenchange after the listener below is gone, so reset the state synchronously","+\t\tthis.setFullscreen(false);","+\t\tthis._setPseudo(false);","+\t\tDomEvent.off(this._target, 'fullscreenchange', this._onFullscreenChange, this);","+\t}","+","+\t/** Returns `true` if the map is in fullscreen mode. */","+\tisFullscreen() {","+\t\treturn this._fullscreen;","+\t}","+","+\t/** Enters fullscreen mode, or exits it if the map is already fullscreen. */","+\ttoggle() {","+\t\treturn this.setFullscreen(!this._fullscreen);","+\t}","+","+\t/**","+\t * Enters fullscreen mode if `on` is `true`, or exits it otherwise. Does nothing if the map is already in that mode.","+\t * @param {boolean} on","+\t */","+\tsetFullscreen(on) {","+\t\tif (on === this._fullscreen) { return this; }","+\t\tif (!on) {","+\t\t\tif (this._pseudo) { this._setPseudo(false); } else { document.exitFullscreen(); }","+\t\t} else if (this.options.pseudo || !document.fullscreenEnabled) {","+\t\t\tthis._setPseudo(true);","+\t\t} else {","+\t\t\tthis._target.requestFullscreen().catch(() => this._setPseudo(true));","+\t\t}","+\t\treturn this;","+\t}","+","+\t/** @param {boolean} on */","+\t_setPseudo(on) {","+\t\tthis._pseudo = on;","+\t\tthis._target.classList.toggle('leaflet-pseudo-fullscreen', on);","+\t\t(on ? DomEvent.on : DomEvent.off)(document, 'keydown', this._onKeyDown, this);","+\t\tthis._setFullscreen(on);","+\t}","+","+\t/** @param {KeyboardEvent} e */","+\t_onKeyDown(e) {","+\t\t// a popup closed by the same Escape prevents default first, since the map container is below the document","+\t\tif (e.key === 'Escape' && !e.defaultPrevented) { this._setPseudo(false); }","+\t}","+","+\t_onFullscreenChange() {","+\t\tthis._setFullscreen(document.fullscreenElement === this._target);","+\t}","+","+\t/** @param {boolean} on */","+\t_setFullscreen(on) {","+\t\tif (on === this._fullscreen) { return; }","+\t\tthis._fullscreen = on;","+\t\tthis._update();","+\t\tthis._map.fire(on ? 'enterfullscreen' : 'exitfullscreen');","+\t}","+","+\t_update() {","+\t\tconst link = /** @type {HTMLAnchorElement} */ (this._link),","+\t\t{options} = this,","+\t\ttitle = this._fullscreen ? options.exitTitle : options.enterTitle;","+","+\t\tlink.innerHTML = this._fullscreen ? options.exitText : options.enterText;","+\t\tlink.title = title;","+\t\tlink.setAttribute('aria-label', title);","+\t\tthis._map.getContainer().classList.toggle('leaflet-fullscreen-on', this._fullscreen);","+\t}","+}"],"additions":157,"deletions":0,"truncated":false},{"path":"src/leaflet.css","lines":["@@ -348,11 +348,23 @@ path.leaflet-interactive:focus:not(:focus-visible) {"," \tfont: bold 22px \"Lucida Console\", Monaco, monospace;"," }"," ","-.leaflet-control-zoom a {","+.leaflet-control-zoom a,","+.leaflet-control-fullscreen a {"," \tdisplay: grid;"," \tplace-items: center;"," }"," ","+/* fullscreen control without the Fullscreen API */","+","+.leaflet-pseudo-fullscreen {","+\tposition: fixed !important;","+\tinset: 0 !important;","+\twidth: auto !important;","+\theight: auto !important;","+\tmargin: 0 !important;","+\tz-index: 99999;","+}","+"," "," /* layers control */"," "],"additions":13,"deletions":1,"truncated":false},{"path":"src/map/Map.js","lines":["@@ -409,6 +409,8 @@ const defaultOptions = {","  * @category Other events","  * @typedef {Object} MapOtherEvents","  * @property {ZoomAnimEvent} zoomanim Fired at least once per zoom animation. For continuous zoom, like pinch zooming, fired once per frame during zoom.","+ * @property {LeafletEvent} enterfullscreen Fired when the map enters fullscreen mode through the [fullscreen control](#fullscreencontrol).","+ * @property {LeafletEvent} exitfullscreen Fired when the map exits fullscreen mode through the [fullscreen control](#fullscreencontrol).","  */"," "," /**"],"additions":2,"deletions":0,"truncated":false},{"path":"src/map/handler/KeyboardHandler.js","lines":["@@ -35,8 +35,8 @@ export class KeyboardHandler extends Handler {"," \t\tconst shortcuts = this._map.options.ariaKeyShortcuts;"," \t\tif (shortcuts) {"," \t\t\t// ARIA names physical keys by their unshift