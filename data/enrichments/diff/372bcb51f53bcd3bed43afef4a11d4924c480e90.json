e, expect, it } from 'vitest';","+import { page, userEvent } from 'vitest/browser';","+import { dragByPointer, renderInApp } from '@test-utils/acceptance';","+import { SortableList } from '@tryghost/shade/components';","+","+// dnd-kit works out keyboard moves from the rows' layout, so these run in Admin's browser","+// harness, where rows have real sizes.","+","+interface Row {","+  id: string;","+  name: string;","+  tall?: boolean;","+}","+","+const evenRows: Row[] = [","+  { id: 'weekly', name: 'The Weekly' },","+  { id: 'deep-dives', name: 'Deep Dives' },","+  { id: 'digest', name: 'Digest' },","+];","+","+const unevenRows: Row[] = [","+  { id: 'short-one', name: 'Short one' },","+  { id: 'tall', name: 'Tall', tall: true },","+  { id: 'short-two', name: 'Short two' },","+  { id: 'short-three', name: 'Short three' },","+];","+","+const manyRows: Row[] = Array.from({ length: 8 }, (_, index) => ({","+  id: `row-${index + 1}`,","+  name: `Row ${index + 1}`,","+}));","+","+function List({","+  initial,","+  getDragHandleLabel,","+  control,","+}: {","+  initial: Row[];","+  getDragHandleLabel?: (row: Row) => string;","+  /** Lets a spec change the rows mid-drag, as a refetch would. */","+  control?: (setRows: Dispatch<SetStateAction<Row[]>>) => void;","+}) {","+  const [rows, setRows] = useState(initial);","+  useEffect(() => control?.(setRows), [control]);","+","+  return (","+    <SortableList","+      className=\"w-80\"","+      getDragHandleLabel={getDragHandleLabel}","+      getItemLabel={(row) => row.name}","+      items={rows}","+      renderItem={(row) => (","+        <div className={row.tall ? 'h-40' : 'h-8'} data-testid=\"row\">","+          {row.name}","+        </div>","+      )}","+      onMove={(id, overId) =>","+        setRows((current) => {","+          const next = [...current];","+          const [moved] = next.splice(","+            next.findIndex((row) => row.id === id),","+            1,","+          );","+          next.splice(","+            current.findIndex((row) => row.id === overId),","+            0,","+            moved,","+          );","+          return next;","+        })","+      }","+    />","+  );","+}","+","+const nextFrame = () =>","+  new Promise<void>((resolve) => {","+    requestAnimationFrame(() => resolve());","+  });","+","+const order = () =>","+  page","+    .getByTestId('row')","+    .elements()","+    .map((row) => row.textContent);","+","+// dnd-kit's live regions, one per list.","+const liveRegions = () =>","+  [...document.querySelectorAll('[role=\"status\"][aria-live=\"assertive\"]')].map(","+    (region) => region.textContent,","+  );","+","+const announced = (text: string) => expect.poll(liveRegions).toContain(text);","+","+/** Focuses a row's handle and picks the row up with Space. */","+async function pickUp(","+  name: string,","+  handleLabel = `Reorder ${name}`,","+  position = order().indexOf(name) + 1,","+) {","+  const handle = page.getByRole('button', { name: handleLabel }).element() as HTMLElement;","+  // Count before the pick-up: the lifted copy of the row is a row too.","+  const total = order().length;","+  handle.focus();","+  await userEvent.keyboard(' ');","+  await announced(`Picked up ${name}, position ${position} of ${total}.`);","+}","+","+/** Picks the row up from the keyboard, presses each arrow key in turn, then drops it. */","+async function move(name: string, keys: Array<'ArrowUp' | 'ArrowDown'>, positions: number[]) {","+  const total = order().length;","+  await pickUp(name);","+  for (const [index, key] of keys.entries()) {","+    await userEvent.keyboard(`{${key}}`);","+    await announced(`${name} moved to position ${positions[index]} of ${total}.`);","+  }","+  await userEvent.keyboard(' ');","+  await announced(`${name} dropped at position ${positions.at(-1)} of ${total}.`);","+}","+","+describe('SortableList keyboard reordering', () => {","+  it('stops at the ends of the list', async () => {","+    await renderInApp(<List initial={evenRows} />);","+","+    await pickUp('Digest');","+    await userEvent.keyboard('{ArrowDown}');","+    // Still at the end, so one press back up moves it one place.","+    await userEvent.keyboard('{ArrowUp}');","+    await announced('Digest moved to position 2 of 3.');","+    await userEvent.keyboard('{ArrowDown}');","+    await announced('Digest moved to position 3 of 3.');","+    await userEvent.keyboard('{ArrowDown}');","+    await userEvent.keyboard(' ');","+    await announced('Digest dropped at position 3 of 3.');","+    await expect.poll(order).toEqual(['The Weekly', 'Deep Dives', 'Digest']);","+","+    await pickUp('The Weekly');","+    await userEvent.keyboard('{ArrowUp}');","+    await userEvent.keyboard('{ArrowDown}');","+    await announced('The Weekly moved to position 2 of 3.');","+    await userEvent.keyboard('{ArrowUp}');","+    await announced('The Weekly moved to position 1 of 3.');","+    await userEvent.keyboard('{ArrowUp}');","+    await userEvent.keyboard(' ');","+    await announced('The Weekly dropped at position 1 of 3.');","+    await expect.poll(order).toEqual(['The Weekly', 'Deep Dives', 'Digest']);","+  });","+","+  it('moves rows of different heights one place per press', async () => {","+    await renderInApp(<List initial={unevenRows} />);","+","+    // A short row past a tall one, and back.","+    await move('Short one', ['ArrowDown', 'ArrowDown'], [2, 3]);","+    await expect.poll(order).toEqual(['Tall', 'Short two', 'Short one', 'Short three']);","+    await move('Short one', ['ArrowUp', 'ArrowUp'], [2, 1]);","+    await expect.poll(order).toEqual(['Short one', 'Tall', 'Short two', 'Short three']);","+","+    // The tall row over short ones, down and back up.","+    await move('Tall', ['ArrowDown', 'ArrowDown'], [3, 4]);","+    await expect.poll(order).toEqual(['Short one', 'Short two', 'Short three', 'Tall']);","+    await move('Tall', ['ArrowUp'], [3]);","+    await expect.poll(order).toEqual(['Short one', 'Short two', 'Tall', 'Short three']);","+  });","+","+  it('shows the lifted row in the place it will drop into', async () => {","+    await renderInApp(<List initial={unevenRows} />);","+","+    await pickUp('Short one');","+    await userEvent.keyboard('{ArrowDown}');","+    await announced('Short one moved to position 2 of 4.');","+","+    // The tall row moves up into the gap, and the lifted row sits just below it rather than over it.","+    const rowOf = (name: string) =>","+      page","+        .getByRole('button', { name: `Reorder ${name}` })","+        .elements()","+        .at(-1)!.parentElement!;","+    await expect","+      .poll(() =>","+        Math.round(","+          rowOf('Short one').getBoundingClientRect().top -","+            rowOf('Tall').getBoundingClientRect().bottom,","+        ),","+      )","+      .toBeCloseTo(0, 0);","+    await userEvent.keyboard('{Escape}');","+  });","+","+  it('moves a row one place per press in a list that scrolls, even when keys come quickly', async () => {","+    await renderInApp(","+      <div className=\"max-h-32 overflow-auto\" data-testid=\"scroller\">","+        <List initial={manyRows} />","+      </div>,","+    );","+","+    await move('Row 1', ['ArrowDown', 'ArrowDown', 'ArrowDown', 'ArrowDown'], [2, 3, 4, 5]);","+    await expect","+      .poll(order)","+      .toEqual(['Row 2', 'Row 3', 'Row 4', 'Row 5', 'Row 1', 'Row 6', 'Row 7', 'Row 8']);","+","+    // Dropped straight after the presses, before the list has scrolled to show the target.","+    await pickUp('Row 1');","+    await userEvent.keyboard('{ArrowDown}{ArrowDown}{ArrowDown} ');","+    await announced('Row 1 dropped at position 8 of 8.');","+    await expect","+      .poll(order)","+      .toEqual(['Row 2', 'Row 3', 'Row 4', 'Row 5', 'Row 6', 'Row 7', 'Row 8', 'Row 1']);","+","+    // Scrolling the list under a lifted row doesn't move it: only the arrow keys do.","+    const scroller = page.getByTestId('scroller').element();","+    scroller.scrollTop = 0;","+    await pickUp('Row 3');","+    scroller.scrollTop += 82;","+    // Let dnd-kit see the scroll and re-render before the drop.","+    await nextFrame();","+    await nextFrame();","+    await userEvent.keyboard(' ');","+    await announced('Row 3 dropped at position 2 of 8.');","+    await expect","+      .poll(order)","+      .toEqual(['Row 2', 'Row 3', 'Row 4', 'Row 5', 'Row 6', 'Row 7', 'Row 8', 'Row 1']);","+  });","+","+  it('moves rows by keyboard and by pointer in the same list', async () => {","+    await renderInApp(<List initial={evenRows} />);","+","+    await move('The Weekly', ['ArrowDown'], [2]);","+    await expect.poll(order).toEqual(['Deep Dives', 'The Weekly', 'Digest']);","+","+    await dragByPointer(","+      page.getByRole('button', { name: 'Reorder Digest' }),","+      page.getByTestId('row').first(),","+    );","+    await expect.poll(order).toEqual(['Digest', 'Deep Dives', 'The Weekly']);","+","+    await move('Deep Dives', ['ArrowDown'], [3]);","+    await expect.poll(order).toEqual(['Digest', 'The Weekly', 'Deep Dives']);","+  });","+","+  it('keeps a lifted row in place when rows leave the list mid-drag', async () => {","+    let setRows: Dispatch<SetStateAction<Row[]>> | undefined;","+    await renderInApp(","+      <List","+        control={(set) => {","+          setRows = set;","+        }}","+        initial={[...evenRows, { id: 'events', name: 'Events' }]}","+      />,","+    );","+    const remove = async (id: string) => {","+      setRows?.((rows) => rows.filter((row) => row.id !== id));","+      await nextFrame();","+      await nextFrame();","+    };","+","+    // The row it was moving to goes: it drops where it started.","+    await pickUp('The Weekly');","+    await userEvent.keyboard('{ArrowDown}{ArrowDown}');","+    await announced('The Weekly moved to position 3 of 4.');","+    await remove('digest');","+    await userEvent.keyboard(' ');","+    await announced('The Weekly dropped at position 1 of 3.');","+    await expect.poll(order).toEqual(['The Weekly', 'Deep Dives', 'Events']);","+","+    // The lifted row itself goes: nothing moves.","+    await pickUp('Deep Dives');","+    await userEvent.keyboard('{ArrowDown}');","+    await remove('deep-dives');","+    await userEvent.keyboard(' ');","+    await announced('Moving cancelled. The item is no longer in the list.');","+    await expect.poll(order).toEqual(['The Weekly', 'Events']);","+  });","+","+  it('names a row by its handle label when it has no name of its own', async () => {","+    await renderInApp(","+      <List","+        getDragHandleLabel={(row) => `Reorder ${row.name || 'untitled row'}`}","+        initial={[{ id: 'untitled', name: '' }, ...evenRows]}","+      />,","+    );","+","+    await pickUp('Reorder untitled row', 'Reorder untitled row', 1);","+    await userEvent.keyboard('{Escape}');","+  });","+","+  it('announces a cancelled move by name, and keeps the order', async () => {","+    await renderInApp(<List initial={evenRows} />);","+","+    await pickUp('Deep Dives');","+    await userEvent.keyboard('{ArrowDown}');","+    await announced('Deep Dives moved to position 3 of 3.');","+    await userEvent.keyboard('{Escape}');","+    await announced('Moving cancelled. Deep Dives stays at position 2 of 3.');","+    await expect.poll(order).toEqual(['The Weekly', 'Deep Dives', 'Digest']);","+  });","+});"],"additions":297,"deletions":0,"truncated":false},{"path":"apps/shade/src/components/ui/sortable-list.stories.tsx","lines":["@@ -10,7 +10,7 @@ const meta = {","     docs: {","       description: {","         component:","-          'Use SortableList when people need to change the order of items, such as steps or settings. Each item has a drag handle, so people can reorder it without activating its other buttons or links.',","+          'Use SortableList when people need to change the order of items, such as steps or settings. Each item has a drag handle, so people can reorder it without activating its other buttons or links. From the keyboard, Space or Enter picks a row up, each arrow key moves it one place, and Space or Enter drops it.',","       },","     },","   },","@@ -20,46 +20,92 @@ const meta = {"," export default meta;"," type Story = StoryObj<typeof meta>;"," ","-const initialItems = [","-  { id: 'one', label: 'First item' },","-  { id: 'two', label: 'Second item' },","-  { id: 'three', label: 'Third item' },","-];","+interface ExampleItem {","+  id: string;","+  label: string;","+  description?: string;","+}","+","+const moveItem = (items: ExampleItem[], id: string, overId: string) => {","+  const from = items.findIndex((item) => item.id === id);","+  const to = items.findIndex((item) => item.id === overId);","+  const reordered = [...items];","+  const [moved] = reordered.splice(from, 1);","+  reordered.splice(to, 0, moved);","+  return reordered;","+};","+","+const ExampleList = ({ initialItems }: { initialItems: ExampleItem[] }) => {","+  const [items, setItems] = useState(initialItems);","+","+  return (","+    <SortableList","+      className=\"w-80\"","+      getItemLabel={(item) => item.label}","+      items={items}","+      renderItem={(item) => (","+        <div className=\"w-full rounded-md bg-muted px-3 py-2\">","+          <div>{item.label}</div>","+          {item.description && (","+            <p className=\"mt-1 text-sm text-muted-foreground\">{item.description}</p>","+          )}","+        </div>","+      )}","+      onMove={(id, overId) => setItems((current) => moveItem(current, id, overId))}","+    />","+  );","+};","+","+const placeholderArgs = {","+  items: [],","+  renderItem: () => null,","+  onMove: () => {},","+};"," "," export const Default: Story = {","+  args: placeholderArgs,","   parameters: {","     docs: {","       description: {","         story:","-          'Drag a handle to move an item. The rest of each row remains available for its content and other controls.',","+          'Drag a handle to move an item. The rest of each row remains available for its content and other controls. Rows here are the same height; `getItemLabel` names each row for the drag handle and for what screen readers announce while it moves.',","       },","     },","   },","-  args: {","-    items: [],","-    renderItem: () => null,","-    onMove: () => {},","-  },","-  render: () => {","-    const [items, setItems] = useState(initialItems);","+  render: () => (","+    <ExampleList","+      initialItems={[","+        { id: 'one', label: 'First item' },","+        { id: 'two', label: 'Second item' },","+        { id: 'three', label: 'Third item' },","+      ]}","+    />","+  ),","+};"," ","-    return (","-      <SortableList","-        className=\"w-80\"","-        getDragHandleLabel={(item) => `Reorder ${item.label}`}","-        items={items}","-        renderItem={(item) => (","-          <div className=\"w-full rounded-md bg-muted px-3 py-2\">{item.label}</div>","-        )}","-        onMove={(id, overId) => {","-          const from = items.findIndex((item) => item.id === id);","-          const to = items.findIndex((item) => item.id === overId);","-          const reordered = [...items];","-          const [moved] = reordered.splice(from, 1);","-          reordered.splice(to, 0, moved);","-          setItems(reordered);","-        }}","-      />","-    );","+export const UnevenRows: Story = {","+  args: placeholderArgs,","+  parameters: {","+    docs: {","+      description: {","+        story:","+          'Rows of different heights. Each arrow press still moves a row one place, whichever rows it passes.',","+      },","+    },","   },","+  render: () => (","+    <ExampleList","+      initialItems={[","+        { id: 'short-one', label: 'Short row' },","+        {","+          id: 'tall',","+          label: 'Tall row',","+          description:","+            'This row has a description long enough to wrap onto several lines, so it is much taller than the rows around it.',","+        },","+        { id: 'short-two', label: 'Another short row' },","+        { id: 'short-three', label: 'Last short row' },","+      ]}","+    />","+  ),"," };"],"additions":78,"deletions":32,"truncated":false},{"path":"apps/shade/src/components/ui/sortable-list.tsx","lines":["@@ -1,12 +1,26 @@"," import {","+  type Announcements,","+  type CollisionDetection,","   DndContext,","   DragOverlay,","   type DraggableAttributes,","   type DraggableSyntheticListeners,","+  type KeyboardCoordinateGetter,","+  KeyboardSensor,","+  PointerSensor,","+  type ScreenReaderInstructions,","+  type UniqueIdentifier,","   closestCenter,","+  useSensor,","+  useSensors,"," } from '@dnd-kit/core';","-import { SortableContext, useSortable, verticalListSortingStrategy } from '@dnd-kit/sortable';","-import { CSS } from '@dnd-kit/utilities';","+import {","+  SortableContext,","+  hasSortableData,","+  useSortable,","+  verticalListSortingStrategy,","+} from '@dnd-kit/sortable';","+import { CSS, isKeyboardEvent } from '@dnd-kit/utilities';"," import { Menu } from 'lucide-react';"," import {","   type CSSProperties,","@@ -14,6 +28,7 @@ import {","   Fragment,","   type HTMLAttributes,","   type ReactNode,","+  useRef,","   useState,"," } from 'react';"," import { Separator } from './separator';","@@ -124,6 +139,83 @@ const SortableItem = ({","   });"," };"," ","+/**","+ * Moves the dragged item one place per Up or Down arrow press. dnd-kit's","+ * `sortableKeyboardCoordinates` picks the next item by distance, which skips or sticks on rows of","+ * different heights. This picks it by index instead, and collision detection follows that pick","+ * during a keyboard drag. The dragged item moves to the slot it will drop into.","+ */","+const createKeyboardMoves = () => {","+  let targetId: UniqueIdentifier | null = null;","+","+  const coordinateGetter: KeyboardCoordinateGetter = (","+    event,","+    { currentCoordinates, context: { active, droppableRects, droppableContainers } },","+  ) => {","+    if (!event.code.startsWith('Arr