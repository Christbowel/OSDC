{"id":"GHSA-phg3-3g28-wq9v","axis":"advisories","repo":"hatchet-dev/hatchet","sha":"f90464189ad642251e09412d0f99fde353036428","parsed":{"files":[{"path":"api/v1/server/authn/session_helpers.go","lines":["@@ -1,6 +1,7 @@"," package authn"," "," import (","+\t\"crypto/subtle\""," \t\"fmt\""," \t\"net/http\""," ","@@ -167,6 +168,10 @@ func (s *SessionHelpers) ValidateOAuthState("," \tintegration string,"," ) (isValidated bool, isOAuthTriggered bool, err error) {"," \tstateKey := fmt.Sprintf(\"oauth_state_%s\", integration)","+\tprovided := c.Request().URL.Query().Get(\"state\")","+\tif provided == \"\" {","+\t\treturn false, false, fmt.Errorf(\"missing state parameter\")","+\t}"," "," \tsession, err := s.ss.Get(c.Request(), s.ss.GetName())"," ","@@ -174,11 +179,12 @@ func (s *SessionHelpers) ValidateOAuthState("," \t\treturn false, false, err"," \t}"," ","-\tif _, ok := session.Values[stateKey]; !ok {","+\tstored, ok := session.Values[stateKey].(string)","+\tif !ok || stored == \"\" {"," \t\treturn false, false, fmt.Errorf(\"state parameter not found in session\")"," \t}"," ","-\tif c.Request().URL.Query().Get(\"state\") != session.Values[stateKey] {","+\tif subtle.ConstantTimeCompare([]byte(provided), []byte(stored)) != 1 {"," \t\treturn false, false, fmt.Errorf(\"state parameters do not match\")"," \t}"," ","@@ -190,9 +196,9 @@ func (s *SessionHelpers) ValidateOAuthState("," \t\tisOAuthTriggered = ok && isOAuthTriggered"," \t}"," ","-\t// need state parameter to validate when redirected","-\tsession.Values[stateKey] = \"\"","-\tsession.Values[\"oauth_triggered\"] = false","+\t// invalidate the single-use state by removing the keys entirely","+\tdelete(session.Values, stateKey)","+\tdelete(session.Values, \"oauth_triggered\")"," "," \tif err := session.Save(c.Request(), c.Response()); err != nil {"," \t\treturn false, false, fmt.Errorf(\"could not clear session\")"],"additions":11,"deletions":5,"truncated":false},{"path":"api/v1/server/authn/session_helpers_test.go","lines":["@@ -0,0 +1,155 @@","+//go:build integration","+","+package authn_test","+","+import (","+\t\"fmt\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\t\"github.com/labstack/echo/v4\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/hatchet-dev/hatchet/api/v1/server/authn\"","+\t\"github.com/hatchet-dev/hatchet/internal/testutils\"","+\t\"github.com/hatchet-dev/hatchet/pkg/auth/cookie\"","+\t\"github.com/hatchet-dev/hatchet/pkg/config/database\"","+\t\"github.com/hatchet-dev/hatchet/pkg/random\"","+)","+","+// TestValidateOAuthState_EmptyStateBypass reproduces the login-CSRF bypass:","+// after a victim completes one OAuth flow, session.Values[\"oauth_state_github\"]","+// is left as \"\" instead of being deleted.  An attacker can then replay","+// ?state= (empty string) against that session and ValidateOAuthState incorrectly","+// returns true, allowing the attacker's OAuth code to be exchanged within the","+// victim's browser session.","+func TestValidateOAuthState_EmptyStateBypass(t *testing.T) {","+\tt.Setenv(\"SERVER_MSGQUEUE_RABBITMQ_URL\", \"amqp://user:password@localhost:5672/\")","+","+\ttestutils.RunTestWithDatabase(t, func(conf *database.Layer) error {","+\t\tconst cookieName = \"hatchet-test\"","+","+\t\thashKey, err := random.Generate(16)","+\t\trequire.NoError(t, err)","+\t\tblockKey, err := random.Generate(16)","+\t\trequire.NoError(t, err)","+","+\t\tss, err := cookie.NewUserSessionStore(","+\t\t\tcookie.WithCookieSecrets(hashKey, blockKey),","+\t\t\tcookie.WithCookieDomain(\"localhost\"),","+\t\t\tcookie.WithCookieName(cookieName),","+\t\t\tcookie.WithCookieAllowInsecure(true),","+\t\t\tcookie.WithSessionRepository(conf.V1.UserSession()),","+\t\t)","+\t\trequire.NoError(t, err)","+","+\t\te := echo.New()","+\t\thelpers := authn.NewSessionHelpers(ss)","+","+\t\t// ── Step 1: prime the session ──────────────────────────────────────────","+\t\t// Simulate what the server does AFTER a successful OAuth round-trip:","+\t\t// it calls session.Values[stateKey] = \"\" instead of deleting the key.","+\t\t// We reproduce this by calling SaveKV directly.","+\t\tprimeReq := httptest.NewRequest(http.MethodGet, \"/\", nil)","+\t\tprimeRec := httptest.NewRecorder()","+\t\tprimeCtx := e.NewContext(primeReq, primeRec)","+","+\t\terr = helpers.SaveKV(primeCtx, \"oauth_state_github\", \"\")","+\t\trequire.NoError(t, err, \"priming session should succeed\")","+","+\t\t// Extract the Set-Cookie header so we can attach it to the attack request.","+\t\tsetCookieRaw := primeRec.Header().Get(\"Set-Cookie\")","+\t\trequire.NotEmpty(t, setCookieRaw, \"response must contain a Set-Cookie header\")","+","+\t\tvar sessionCookie *http.Cookie","+\t\tfor _, c := range primeRec.Result().Cookies() {","+\t\t\tif c.Name == cookieName {","+\t\t\t\tsessionCookie = c","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t\trequire.NotNil(t, sessionCookie, \"session cookie must be present in response\")","+","+\t\t// ── Step 2: attacker fires the exploit ────────────────────────────────","+\t\t// The attack URL carries an empty state parameter (?state=).","+\t\t// The victim's primed session cookie is attached.","+\t\tattackURL := fmt.Sprintf(\"/api/v1/users/github/callback?code=ATTACKER_CODE&state=\")","+\t\tattackReq := httptest.NewRequest(http.MethodGet, attackURL, nil)","+\t\tattackReq.AddCookie(sessionCookie)","+\t\tattackRec := httptest.NewRecorder()","+\t\tattackCtx := e.NewContext(attackReq, attackRec)","+","+\t\tisValid, _, err := helpers.ValidateOAuthState(attackCtx, \"github\")","+","+\t\t// ── Step 3: assert the expected (fixed) behaviour ─────────────────────","+\t\t// Before the fix, isValid == true and err == nil, proving the bypass.","+\t\t// After the fix, the call must return false (and a non-nil error).","+\t\tassert.False(t, isValid,","+\t\t\t\"empty ?state= must NOT validate; if this assertion fails the bypass is active\")","+\t\tassert.Error(t, err,","+\t\t\t\"ValidateOAuthState must return an error when state is empty\")","+","+\t\treturn nil","+\t})","+}","+","+// TestValidateOAuthState_LegitimateFlow verifies that the normal OAuth path is","+// unaffected by the fix: a correctly generated state round-trips successfully.","+func TestValidateOAuthState_LegitimateFlow(t *testing.T) {","+\tt.Setenv(\"SERVER_MSGQUEUE_RABBITMQ_URL\", \"amqp://user:password@localhost:5672/\")","+","+\ttestutils.RunTestWithDatabase(t, func(conf *database.Layer) error {","+\t\tconst cookieName = \"hatchet-test-legit\"","+","+\t\thashKey, err := random.Generate(16)","+\t\trequire.NoError(t, err)","+\t\tblockKey, err := random.Generate(16)","+\t\trequire.NoError(t, err)","+","+\t\tss, err := cookie.NewUserSessionStore(","+\t\t\tcookie.WithCookieSecrets(hashKey, blockKey),","+\t\t\tcookie.WithCookieDomain(\"localhost\"),","+\t\t\tcookie.WithCookieName(cookieName),","+\t\t\tcookie.WithCookieAllowInsecure(true),","+\t\t\tcookie.WithSessionRepository(conf.V1.UserSession()),","+\t\t)","+\t\trequire.NoError(t, err)","+","+\t\te := echo.New()","+\t\thelpers := authn.NewSessionHelpers(ss)","+","+\t\t// Start the OAuth flow: SaveOAuthState generates a random state and stores it.","+\t\tstartReq := httptest.NewRequest(http.MethodGet, \"/api/v1/users/github\", nil)","+\t\tstartRec := httptest.NewRecorder()","+\t\tstartCtx := e.NewContext(startReq, startRec)","+","+\t\tstate, err := helpers.SaveOAuthState(startCtx, \"github\")","+\t\trequire.NoError(t, err)","+\t\trequire.NotEmpty(t, state)","+","+\t\tvar sessionCookie *http.Cookie","+\t\tfor _, c := range startRec.Result().Cookies() {","+\t\t\tif c.Name == cookieName {","+\t\t\t\tsessionCookie = c","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t\trequire.NotNil(t, sessionCookie)","+","+\t\t// Callback with the correct state value.","+\t\tcallbackURL := fmt.Sprintf(\"/api/v1/users/github/callback?code=REAL_CODE&state=%s\", state)","+\t\tcallbackReq := httptest.NewRequest(http.MethodGet, callbackURL, nil)","+\t\tcallbackReq.AddCookie(sessionCookie)","+\t\tcallbackRec := httptest.NewRecorder()","+\t\tcallbackCtx := e.NewContext(callbackReq, callbackRec)","+","+\t\tisValid, _, err := helpers.ValidateOAuthState(callbackCtx, \"github\")","+","+\t\tassert.True(t, isValid, \"correct state must validate successfully\")","+\t\tassert.NoError(t, err)","+","+\t\treturn nil","+\t})","+}",""],"additions":155,"deletions":0,"truncated":false}],"additions":166,"deletions":5,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-09-22T12:50:11.178209+00:00"}