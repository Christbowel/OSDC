  !(metadata.getH() && metadata.getHSet()));","+","             // Resolve and acquire the collection by UUID so the repair serializes with drops and","             // renames. Renames preserve the UUID, so retry if the collection moved; if it no","             // longer exists, the command is a true no-op.","@@ -115,7 +120,7 @@ class RepairReplicatedMetadataCommand final : public TypedCommand<RepairReplicat","                                           opCtx, *nss, AcquisitionPrerequisites::kWrite),","                                       MODE_IX);","                 if (collection.exists() && collection.uuid() == uuid) {","-                    _writeNoopOplogEntry(opCtx, collection, request().getMetadata());","+                    _writeNoopOplogEntry(opCtx, collection, metadata);","                     return;","                 }","             }"],"additions":6,"deletions":1,"truncated":false},{"path":"src/mongo/db/replicated_fast_count/replicated_fast_count_advance_checkpoint.cpp","lines":["@@ -83,7 +83,8 @@ CheckpointWriteCounts persistCheckpointSnapshot(","                     SizeCountStore::Entry{.timestamp = checkpoint.validAsOf,","                                           .size = entry.metadata.sizeCount.size,","                                           .count = entry.metadata.sizeCount.count,","-                                          .hash = entry.metadata.hash});","+                                          .hash = entry.metadata.hash},","+                    entry.hashUpdateMode);","                 if (oldValue.has_value()) {","                     writeCounts.updateCount++;","                 } else {"],"additions":2,"deletions":1,"truncated":false},{"path":"src/mongo/db/replicated_fast_count/replicated_fast_count_streaming_oplog_delta_accumulator.cpp","lines":["@@ -162,7 +162,7 @@ enum class FastDecision {"," };"," "," // The `type` discriminator value carried in the o2 of a no-op oplog entry that repairs a","-// collection's replicated metadata with explicit size/count/hash diffs.","+// collection's replicated metadata with explicit size/count/hash diffs or an absolute hash."," constexpr std::string_view kRepairReplicatedMetadataType = \"repairReplicatedMetadata\"sv;"," "," // True if `o2` is the o2 object of a repairReplicatedMetadata no-op entry.","@@ -463,12 +463,18 @@ boost::optional<int> tryFastCommitTxn(const ScanFields& f,","     return processed;"," }"," ","-// Extracts the collection uuid and metadata diff from a repairReplicatedMetadata o2 object.","-// Returns boost::none if the shape is malformed (missing/non-numeric fields, unparsable uuid).","-// Unlike CRUD's `m`, a no-op's o2 isn't otherwise validated by replication, so a malformed repair","-// entry is ignored (no delta) rather than treated as fatal.","-boost::optional<std::pair<UUID, CollectionReplicatedMetadata>> tryExtractNoopRepairDiff(","-    const BSONObj& o2Obj) {","+// The uuid and metadata carried by a repairReplicatedMetadata o2 object.","+struct NoopRepair {","+    UUID uuid;","+    CollectionReplicatedMetadata metadata;","+    HashUpdateMode hashUpdateMode;","+};","+","+// Extracts the collection uuid and metadata from a repairReplicatedMetadata o2 object. Returns","+// boost::none if the shape is malformed (missing/non-numeric fields, both `h` and `hSet`,","+// unparsable uuid). Unlike CRUD's `m`, a no-op's o2 isn't otherwise validated by replication, so a","+// malformed repair entry is ignored (no delta) rather than treated as fatal.","+boost::optional<NoopRepair> tryExtractNoopRepair(const BSONObj& o2Obj) {","     const auto uuidElem = o2Obj.getField(\"uuid\"sv);","     const auto mElem = o2Obj.getField(\"m\"sv);","     if (uuidElem.eoo() || !mElem.isABSONObj()) {","@@ -478,38 +484,58 @@ boost::optional<std::pair<UUID, CollectionReplicatedMetadata>> tryExtractNoopRep","     const auto szElem = mObj.getField(\"sz\"sv);","     const auto ctElem = mObj.getField(\"ct\"sv);","     const auto hElem = mObj.getField(\"h\"sv);","-    if (szElem.eoo() && ctElem.eoo() && hElem.eoo()) {","+    const auto hSetElem = mObj.getField(\"hSet\"sv);","+    if (szElem.eoo() && ctElem.eoo() && hElem.eoo() && hSetElem.eoo()) {","         return boost::none;","     }","-    // `sz`, `ct`, and `h` are each optional but a present field must be numeric; malformed input","-    // invalidates the whole entry rather than partially applying it.","-    if ((!szElem.eoo() && !szElem.isNumber()) || (!ctElem.eoo() && !ctElem.isNumber()) ||","-        (!hElem.eoo() && !hElem.isNumber())) {","+    // `sz`, `ct`, `h`, and `hSet` are each optional but a present field must be numeric; malformed","+    // input invalidates the whole entry rather than partially applying it.","+    const auto isMalformed = [](const BSONElement& elem) {","+        return !elem.eoo() && !elem.isNumber();","+    };","+    if (isMalformed(szElem) || isMalformed(ctElem) || isMalformed(hElem) || isMalformed(hSetElem) ||","+        (!hElem.eoo() && !hSetElem.eoo())) {","         return boost::none;","     }","     auto uuid = UUID::parse(uuidElem);","     if (!uuid.isOK()) {","         return boost::none;","     }","+    const CollectionSizeCount sizeCount{.size = szElem.eoo() ? 0 : szElem.safeNumberLong(),","+                                        .count = ctElem.eoo() ? 0 : ctElem.safeNumberLong()};","+    if (!hSetElem.eoo()) {","+        return NoopRepair{.uuid = uuid.getValue(),","+                          .metadata = {.sizeCount = sizeCount, .hash = hSetElem.safeNumberLong()},","+                          .hashUpdateMode = HashUpdateMode::kSet};","+    }","     // An absent `h` folds as the XOR identity so that the window's accumulated hash is preserved.","-    return std::make_pair(","-        uuid.getValue(),","-        CollectionReplicatedMetadata{","-            .sizeCount = CollectionSizeCount{.size = szElem.eoo() ? 0 : szElem.safeNumberLong(),","-                                             .count = ctElem.eoo() ? 0 : ctElem.safeNumberLong()},","-            .hash = hElem.eoo() ? kEmptyCollectionValidationHash : hElem.safeNumberLong()});","+    return NoopRepair{","+        .uuid = uuid.getValue(),","+        .metadata = {.sizeCount = sizeCount,","+                     .hash = hElem.eoo() ? kEmptyCollectionValidationHash : hElem.safeNumberLong()},","+        .hashUpdateMode = HashUpdateMode::kFold};"," }"," "," // Layer 2: handle a no-op entry whose o2 repairs a collection's replicated metadata. A malformed"," // o2 is ignored (no delta) rather than surfaced as an error. Always fully handled."," int tryRecordFastNoopRepair(const ScanFields& f,","                             ReplicatedMetadataDeltas& replicatedMetadataDeltasOut) {","-    if (auto diff = tryExtractNoopRepairDiff(f.o2.Obj())) {","+    auto repair = tryExtractNoopRepair(f.o2.Obj());","+    if (!repair) {","+        return 0;","+    }","+    if (repair->hashUpdateMode == HashUpdateMode::kFold) {","         recordCollectionReplicatedMetadataDelta(","-            diff->first, diff->second, replicatedMetadataDeltasOut);","+            repair->uuid, repair->metadata, replicatedMetadataDeltasOut);","         return 1;","     }","-    return 0;","+    // Size and count still add up, but the set hash overrides every hash contribution before it in","+    // the window. Later contributions fold into the set value.","+    auto& delta = replicatedMetadataDeltasOut[repair->uuid];","+    delta.metadata.sizeCount = delta.metadata.sizeCount + repair->metadata.sizeCount;","+    delta.metadata.hash = repair->metadata.hash;","+    delta.hashUpdateMode = HashUpdateMode::kSet;","+    return 1;"," }"," "," // Returns true if the oplog entry is a container operation on a replicated fast count ident."],"additions":47,"deletions":21,"truncated":false},{"path":"src/mongo/db/replicated_fast_count/replicated_fast_count_streaming_oplog_delta_accumulator_test.cpp","lines":["@@ -10,8 +10,11 @@"," #include \"mongo/unittest/death_test.h\""," #include \"mongo/unittest/unittest.h\""," ","+#include <limits>"," #include <list>","+#include <string>"," #include <utility>","+#include <vector>"," "," namespace mongo::replicated_fast_count {"," namespace {","@@ -851,6 +854,179 @@ TEST_F(StreamingOplogDeltaAccumulatorTest, FastLane_NoopRepairNonNumericH_Ignore","     EXPECT_EQ(result.lastTimestamp, ts);"," }"," ","+// A set records exactly its value, overriding a nonzero hash already in the window.","+TEST_F(StreamingOplogDeltaAccumulatorTest, FastLane_NoopRepairHashSet_RecordsSetHash) {","+    // Differs from every set value, so a set that folded instead would be caught.","+    const int64_t priorHash = 0x0f0f0f0f0f0f0f0f;","+    const std::vector<int64_t> setHashes{","+        // The hash of an empty collection: XOR with it is the identity, so only the nonzero prior","+        // distinguishes a set from a fold, and it must not be mistaken for an omitted field.","+        kEmptyCollectionValidationHash,","+        -1,","+        std::numeric_limits<int64_t>::min(),","+        std::numeric_limits<int64_t>::max(),","+        0x0123456789abcdef,","+    };","+    for (const int64_t setHash : setHashes) {","+        const auto result = runAccumulatorRaw(","+            {makeRawCrudBson(Timestamp(1, 1),","+                             \"i\"sv,","+                             collA.nss,","+                             collA.uuid,","+                             BSON(\"sz\" << 10 << \"h\" << priorHash)),","+             makeNoopWithO2Bson(Timestamp(1, 2),","+                                BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid","+                                            << \"m\" << BSON(\"hSet\" << setHash)))});","+        ASSERT_TRUE(result.deltas.contains(collA.uuid)) << setHash;","+        const auto& delta = result.deltas.at(collA.uuid);","+        EXPECT_EQ(delta.metadata.sizeCount, (CollectionSizeCount{.size = 10, .count = 1}))","+            << setHash;","+        EXPECT_EQ(delta.metadata.hash, setHash) << setHash;","+        EXPECT_EQ(delta.hashUpdateMode, HashUpdateMode::kSet) << setHash;","+        EXPECT_EQ(result.lastTimestamp, Timestamp(1, 2)) << setHash;","+    }","+}","+","+TEST_F(StreamingOplogDeltaAccumulatorTest,","+       FastLane_NoopRepairHashSet_OverridesPriorThenFoldsLater) {","+    // Whatever the window accumulated before the set (nothing, an absent hash, or a present one)","+    // is overridden, and both CRUD hashes and repair diffs after it fold into the set value. Size","+    // and count add up across the whole window regardless.","+    const int64_t setHash = 0x0011223344556677;","+    const int64_t laterCrudHash = 0x7766554433221100;","+    const int64_t laterRepairHash = 0x0f0f0f0f0f0f0f0f;","+    struct PriorEntry {","+        std::string name;","+        boost::optional<BSONObj> m;","+    };","+    const std::vector<PriorEntry> priors{","+        {\"none\", boost::none},","+        {\"absentHash\", BSON(\"sz\" << 10)},","+        {\"presentHash\", BSON(\"sz\" << 10 << \"h\" << int64_t{0x0123456789abcdef})},","+    };","+    for (const auto& prior : priors) {","+        std::vector<BSONObj> records;","+        if (prior.m) {","+            records.push_back(","+                makeRawCrudBson(Timestamp(1, 1), \"i\"sv, collA.nss, collA.uuid, *prior.m));","+        }","+        records.push_back(","+            makeNoopWithO2Bson(Timestamp(1, 2),","+                               BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid","+                                           << \"m\" << BSON(\"sz\" << 5 << \"hSet\" << setHash))));","+        records.push_back(makeRawCrudBson(Timestamp(1, 3),","+                                          \"i\"sv,","+                                          collA.nss,","+                                          collA.uuid,","+                                          BSON(\"sz\" << 20 << \"h\" << laterCrudHash)));","+        records.push_back(","+            makeNoopWithO2Bson(Timestamp(1, 4), makeRepairO2(collA, 0, 0, laterRepairHash)));","+","+        const auto result = runAccumulatorRaw(records);","+        ASSERT_TRUE(result.deltas.contains(collA.uuid)) << prior.name;","+        const auto& delta = result.deltas.at(collA.uuid);","+        const int64_t priorCount = prior.m ? 1 : 0;","+        const int64_t priorSize = prior.m ? 10 : 0;","+        EXPECT_EQ(delta.metadata.sizeCount,","+                  (CollectionSizeCount{.size = priorSize + 5 + 20, .count = priorCount + 1}))","+            << prior.name;","+        EXPECT_EQ(delta.metadata.hash, setHash ^ laterCrudHash ^ laterRepairHash) << prior.name;","+        EXPECT_EQ(delta.hashUpdateMode, HashUpdateMode::kSet) << prior.name;","+        EXPECT_EQ(result.lastTimestamp, Timestamp(1, 4)) << prior.name;","+    }","+}","+","+// A later set overrides an earlier one in the same window.","+TEST_F(StreamingOplogDeltaAccumulatorTest, FastLane_NoopRepairHashSet_LastSetWins) {","+    const int64_t firstSet = 0x0011223344556677;","+    const int64_t betweenHash = 0x0123456789abcdef;","+    const int64_t secondSet = 0x7766554433221100;","+    const auto result = runAccumulatorRaw(","+        {makeNoopWithO2Bson(Timestamp(1, 1),","+                            BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                        << BSON(\"hSet\" << firstSet))),","+         makeRawCrudBson(","+             Timestamp(1, 2), \"i\"sv, collA.nss, collA.uuid, BSON(\"sz\" << 10 << \"h\" << betweenHash)),","+         makeNoopWithO2Bson(Timestamp(1, 3),","+                            BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                        << BSON(\"hSet\" << secondSet)))});","+    ASSERT_TRUE(result.deltas.contains(collA.uuid));","+    const auto& delta = result.deltas.at(collA.uuid);","+    EXPECT_EQ(delta.metadata.sizeCount, (CollectionSizeCount{.size = 10, .count = 1}));","+    EXPECT_EQ(delta.metadata.hash, secondSet);","+    EXPECT_EQ(delta.hashUpdateMode, HashUpdateMode::kSet);","+}","+","+TEST_F(StreamingOplogDeltaAccumulatorTest,","+       FastLane_NoopRepairHashSet_LaterAbsentContributionLeavesHashAbsent) {","+    const Timestamp ts1{1, 1};","+    const Timestamp ts2{1, 2};","+    const auto o2 = BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                << BSON(\"hSet\" << int64_t{0x0011223344556677}));","+    const auto result =","+        runAccumulatorRaw({makeNoopWithO2Bson(ts1, o2),","+                           makeRawCrudBson(ts2, \"i\"sv, collA.nss, collA.uuid, BSON(\"sz\" << 10))});","+    ASSERT_TRUE(result.deltas.contains(collA.uuid));","+    const auto& delta = result.deltas.at(collA.uuid);","+    EXPECT_EQ(delta.metadata.hash, boost::none);","+    EXPECT_EQ(delta.hashUpdateMode, HashUpdateMode::kSet);","+}","+","+// A set on a collection created in the same window keeps the create, so the checkpoint still","+// inserts a fresh entry, now carrying the set hash.","+TEST_F(StreamingOplogDeltaAccumulatorTest, NoopRepairHashSet_AfterCreateKeepsCreatedState) {","+    const int64_t setHash = 0x0011223344556677;","+    const auto result = runAccumulatorRaw(","+        {test_helpers::makeCreateOplogEntry(Timestamp(1, 1), collA).getEntry().toBSON(),","+         makeNoopWithO2Bson(Timestamp(1, 2),","+                            BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                        << BSON(\"hSet\" << setHash)))});","+    ASSERT_TRUE(result.deltas.contains(collA.uuid));","+    const auto& delta = result.deltas.at(collA.uuid);","+    EXPECT_EQ(delta.state, DDLState::kCreated);","+    EXPECT_EQ(delta.metadata.hash, setHash);","+    EXPECT_EQ(delta.hashUpdateMode, HashUpdateMode::kSet);","+}","+","+// A set does not outlive the collection it was applied to: once the collection is dropped and a","+// collection with the same UUID is imported, the new collection starts from the import's absent","+// hash and folds as usual.","+TEST_F(StreamingOplogDeltaAccumulatorTest, NoopRepairHashSet_DropThenImportResetsToFold) {","+    const auto result = runAccumulatorRaw(","+        {makeNoopWithO2Bson(Timestamp(1, 1),","+                            BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                        << BSON(\"hSet\" << int64_t{0x0011223344556677}))),","+         test_helpers::makeDropOplogEntry(Timestamp(1, 2), collA).getEntry().toBSON(),","+         test_helpers::makeImportCollectionOplogEntry(","+             Timestamp(1, 3), collA, /*numRecords=*/1, /*dataSize=*/10)","+             .getEntry()","+             .toBSON()});","+    ASSERT_TRUE(result.deltas.contains(collA.uuid));","+    const auto& delta = result.deltas.at(collA.uuid);","+    EXPECT_EQ(delta.state, DDLState::kDroppedAndRecreated);","+    EXPECT_EQ(delta.metadata.hash, boost::none);","+    EXPECT_EQ(delta.hashUpdateMode, HashUpdateMode::kFold);","+}","+","+TEST_F(StreamingOplogDeltaAccumulatorTest, FastLane_NoopRepairHashDiffAndHashSet_Ignored) {","+    const Timestamp ts{1, 1};","+    const auto o2 = BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                << BSON(\"sz\" << 100 << \"h\" << int64_t{1} << \"hSet\" << int64_t{2}));","+    const auto result = runAccumulatorRaw({makeNoopWithO2Bson(ts, o2)});","+    EXPECT_TRUE(result.deltas.empty());","+    EXPECT_EQ(result.lastTimestamp, ts);","+}","+","+TEST_F(StreamingOplogDeltaAccumulatorTest, FastLane_NoopRepairNonNumericHashSet_Ignored) {","+    const Timestamp ts{1, 1};","+    const auto o2 = BSON(\"type\" << \"repairReplicatedMetadata\" << \"uuid\" << collA.uuid << \"m\"","+                                << BSON(\"sz\" << 100 << \"hSet\"","+                                             << \"notanumber\"));","+    const auto result = runAccumulatorRaw({makeNoopWithO2Bson(ts, o2)});","+    EXPECT_TRUE(result.deltas.empty());","+    EXPECT_EQ(result.lastTimestamp, ts);","+}","+"," TEST_F(StreamingOplogDeltaAccumulatorTest, FastLane_NoopWithUnrelatedO2Type_NoDeltas) {","     const Timestamp ts{1, 1};","     const auto result = runAccumulatorRaw("],"additions":176,"deletions":0,"truncated":false},{"path":"src/mongo/db/replicated_fast_count/replicated_fast_size_count.h","lines":["@@ -128,6 +128,21 @@ enum class [[MONGO_MOD_PUBLIC]] DDLState {","     kNone"," };"," ","+/**","+ * Indicates how a delta's hash applies to the collection's persisted hash.","+ */","+enum class [[MONGO_MOD_PUBLIC]] HashUpdateMode {","+    /**","+     * The hash is a contribution that combines with the persisted hash.","+     */","+    kFold,","+","+    /**","+     * The hash replaces the persisted hash, including an absent one.","+     */","+    kSet,","+};","+"," /**","  * Stores the size, count, and validation hash values for a collection along with state indicating","  * whether the collection had been created or dropped.","@@ -136,6 +151,7 @@ struct [[MONGO_MOD_PUBLIC]] ReplicatedMetadataDelta {","     CollectionReplicatedMetadata metadata{.sizeCount = CollectionSizeCount{.size = 0, .count = 0},","                                           .hash = boost::none};","     DDLState state{DDLState::kNone};","+    HashUpdateMode hashUpdateMode{HashUpdateMode::kFold};"," ","     bool operator==(const ReplicatedMetadataDelta&) const = default;"," ","@@ -153,7 +169,10 @@ struct [[MONGO_MOD_PUBLIC]] ReplicatedMetadataDelta {","             }","             MONGO_UNREACHABLE;","         }();","-        return fmt::format(\"metadata: {}, state: {}\", metadata.toString(), stateStr);","+        return fmt::format(\"metadata: {}, state: {}, hashUpdateMode: {}\",","+                           metadata.toString(),","+                           stateStr,","+                           hashUpdateMode == HashUpdateMode::kSet ? \"set\" : \"fold\");","     }"," };"," "],"additions":20,"deletions":1,"truncated":false},{"path":"src/mongo/db/replicated_fast_count/size_count_checkpoint_coordinator_test.cpp","lines":["@@ -21,6 +21,10 @@"," #include \"mongo/util/fail_point.h\""," #include \"mongo/util/uuid.h\""," ","+#include <cstdint>","+#include <limits>","+#include <vector>","+"," namespace mongo::replicated_fast_count {"," namespace {"," ","@@ -368,6 +372,19 @@ class SizeCountCheckpointCoordinatorHashTest : public CatalogTestFixture {","         return _sizeCountStore->read(_opCtx, uuid);","     }"," ","+    // Writes a repairReplicatedMetadata no-op entry for 'coll' carrying 'metadata'.","+    void writeRepairNoop(const test_helpers::NsAndUUID& coll, BSONObj metadata) {","+        writeOplogEntry(repl::DurableOplogEntry{repl::DurableOplogEntryParams{","+            .opTime = repl::OpTime(nextTs(), 1),","+            .opType = repl::OpTypeEnum::kNoop,","+            .nss = NamespaceString(),","+            .oField = BSON(\"msg\" << \"Repairing collection's replicated metadata with diffs\"),","+            .o2Field = BSON(\"type\" << \"repairReplicatedMetadata\"","+                                   << \"uuid\" << coll.uuid << \"m\" << metadata),","+            .wallClockTime = Date_t::now(),","+        }});","+    }","+","     const test_helpers::NsAndUUID _collA{","         .nss = NamespaceString::createNamespaceString_forTest(\"coordinator_hash_test\", \"collA\"),","         .uuid = UUID::gen(),","@@ -673,6 +690,93 @@ TEST_F(SizeCountCheckpointCoordinatorHashTest, RepairHashDiffFoldsIntoCreatedCol","     EXPECT_EQ(expectedEntry, *entry);"," }"," ","+// A repair noop's hash set replaces the persisted hash, absent or present, with exactly the set","+// value while its size and count diffs still apply. Later checkpoints fold into the set value.","+TEST_F(SizeCountCheckpointCoordinatorHashTest, RepairHashSetReplacesPersistedHashThenFolds) {","+    const std::vector<boost::optional<int64_t>> persistedHashes{boost::none, kHashC};","+    const std::vector<int64_t> setHashes{kEmptyCollectionValidationHash,","+                                         -1,","+                                         std::numeric_limits<int64_t>::min(),","+                                         std::numeric_limits<int64_t>::max(),","+                                         kHashA};","+","+    for (const auto& persistedHash : persistedHashes) {","+        for (const int64_t setHash : setHashes) {","+            const test_helpers::NsAndUUID coll{.nss = _collA.nss, .uuid = UUID::gen()};","+            test_helpers::insertSizeCountEntry(","+                _opCtx,","+                *_sizeCountStore,","+                coll.uuid,","+                SizeCountStore::Entry{","+                    .timestamp = nextTs(), .size = 1000, .count = 10, .hash = persistedHash});","+","+            writeRepairNoop(coll, BSON(\"sz\" << 100 << \"ct\" << 5 << \"hSet\" << setHash));","+            const Timestamp validAsOf1 = flush();","+            {","+                const SizeCountStore::Entry expectedEntry{","+                    .timestamp = validAsOf1, .size = 1100, .count = 15, .hash = setHash};","+                const auto entry = readSizeCount(coll.uuid);","+                ASSERT_TRUE(entry.has_value());","+                EXPECT_EQ(expectedEntry, *entry);","+            }","+","+            writeCrudEntry(nextTs(), coll, repl::OpTypeEnum::kInsert, 20 /*sizeDelta=*/, kHashB);","+            const Timestamp validAsOf2 = flush();","+            const SizeCountStore::Entry expectedEntry{","+                .timestamp = validAsOf2, .size = 1120, .count = 16, .hash = setHash ^ kHashB};","+            const auto entry = readSizeCount(coll.uuid);","+            ASSERT_TRUE(entry.has_value());","+            EXPECT_EQ(expectedEntry, *entry);","+        }","+    }","+}","+","+// A set on a collection created in the same checkpoint inserts the entry with the set hash, and","+// deltas after the set fold into it, both in that checkpoint and in later ones.","+TEST_F(SizeCountCheckpointCoordinatorHashTest, RepairHashSetAfterCreateThenFolds) {","+    writeOplogEntry(test_helpers::makeCreateOplogEntry(nextTs(), _collA));","+    writeRepairNoop(_collA, BSON(\"hSet\" << kHashA));","+    writeCrudEntry(nextTs(), _collA, repl::OpTypeEnum::kInsert, 10 /*sizeDelta=*/, kHashB);","+","+    const Timestamp validAsOf1 = flush();","+    {","+        const SizeCountStore::Entry expectedEntry{","+            .timestamp = validAsOf1, .size = 10, .count = 1, .hash = kHashA ^ kHashB};","+        const auto entry = readSizeCount(_collA.uuid);","+        ASSERT_TRUE(entry.has_value());","+        EXPECT_EQ(expectedEntry, *entry);","+    }","+","+    const int64_t repairHash = 0x0F0F0F0F0F0F0F0F;","+    writeCrudEntry(nextTs(), _collA, repl::OpTypeEnum::kInsert, 20 /*sizeDelta=*/, kHashC);","+    writeRepairNoop(_collA, BSON(\"h\" << repairHash));","+","+    const Timestamp validAsOf2 = flush();","+    const SizeCountStore::Entry expectedEntry{.timestamp = validAsOf2,","+                                              .size = 30,","+                                              .count = 2,","+                                              .hash = kHashA ^ kHashB ^ kHashC ^ repairHash};","+    const auto entry = readSizeCount(_collA.uuid);","+    ASSERT_TRUE(entry.has_value());","+    EXPECT_EQ(expectedEntry, *entry);","+}","+","+// A set on a collection dropped later in the same checkpoint leaves no entry behind.","+TEST_F(SizeCountCheckpointCoordinatorHashTest, RepairHashSetThenDropRemovesEntry) {","+    test_helpers::insertSizeCountEntry(","+        _opCtx,","+        *_sizeCountStore,","+        _collA.uuid,","+        SizeCountStore::Entry{","+            .timestamp = nextTs(), .size = 1000, .count = 10, .hash = boost::none});","+    writeRepairNoop(_collA, BSON(\"hSet\" << kHashA));","+    writeOplogEntry(test_helpers::makeDropOplogEntry(nextTs(), _collA));","+","+    flush();","+","+    EXPECT_FALSE(readSizeCount(_collA.uuid).has_value());","+}","+"," // A collection created with no writes persists the hash of an empty collection, which later"," // contributions fold into."," TEST_F(SizeCountCheckpointCoordinatorHashTest, CreateWithoutWritesPersistsEmptyCollectionHash) {"],"additions":104,"deletions":0,"truncated":false},{"path":"src/mongo/db/replicated_fast_count/size_count_store.cpp","lines":["@@ -100,7 +100,8 @@ boost::optional<SizeCountStore::Entry> SizeCountStore::read(OperationContext* op"," "," boost::optional<SizeCountStore::Entry> SizeCountStore::insert(OperationContext* opCtx,","                                                               UUID uuid,","-                                                              const SizeCountStore::Entry& entry) {","+                                                              const SizeCountStore::Entry& entry,","+                                                              HashUpdateMode hashUpdateMode) {","     assertInWriteUnitOfWorkAndLocked(opCtx, \"insert\");"," ","     auto& ru = *shard_role_details::getRecoveryUnit(opCtx);","@@ -114,8 +115,10 @@ boost::optional<SizeCountStore::Entry> SizeCountStore::insert(OperationContext*","               SizeCountStore::parseContainerValue(*previousValue))","         : boost::none;"],"additions":2,"deletions":1,"truncated":false}],"additions":399,"deletions":26,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-19T15:01:14.620138+00:00"}