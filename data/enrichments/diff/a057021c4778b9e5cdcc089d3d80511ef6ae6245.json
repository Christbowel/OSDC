   busy_pool: FsmPriority,","+        busy_since: &mut Instant,","+    ) -> bool {","         if batch.control.is_some() {","             return true;","         }"," ","+        let pool = self.handler.get_priority();","         if let Ok(fsm) = self.fsm_receiver.try_recv() {","-            return batch.push(fsm);","+            return batch.push(fsm, pool);","         }"," ","         if batch.is_empty() {","             self.handler.pause();","-            if let Ok(fsm) = self.fsm_receiver.recv() {","-                return batch.push(fsm);","+            POLLER_BUSY_SECONDS","+                .get(N::FSM_TYPE)","+                .get(busy_pool)","+                .inc_by(busy_since.saturating_elapsed_secs());","+            let fsm = self.fsm_receiver.recv();","+            *busy_since = Instant::now();","+            if let Ok(fsm) = fsm {","+                return batch.push(fsm, pool);","             }","         }","         !batch.is_empty()","@@ -392,8 +416,12 @@ impl<N: Fsm, C: Fsm, Handler: PollHandler<N, C>> Poller<N, C, Handler> {","         // from becoming hungry if some regions are hot points. Since we fetch new FSM","         // every time calling `poll`, we do not need to configure a large value for","         // `self.max_batch_size`.","+        // Thread-local like the other poller metrics; flushed at most once a","+        // second, so the exported resolution is unchanged.","+        let busy_pool = fsm_priority(self.handler.get_priority());","+        let mut busy_since = Instant::now();","         let mut run = true;","-        while run && self.fetch_fsm(&mut batch) {","+        while run && self.fetch_fsm(&mut batch, busy_pool, &mut busy_since) {","             // If there is a region that waits to be dealt, we must deal with it even if it","             // has overhead max size of batch. It's helpful to protect regions","             // from becoming hungry if some regions are hot points.","@@ -447,7 +475,7 @@ impl<N: Fsm, C: Fsm, Handler: PollHandler<N, C>> Poller<N, C, Handler> {","             let mut fsm_cnt = batch.normals.len();","             while batch.normals.len() < max_batch_size {","                 if let Ok(fsm) = self.fsm_receiver.try_recv() {","-                    run = batch.push(fsm);","+                    run = batch.push(fsm, self.handler.get_priority());","                 }","                 // When `fsm_cnt >= batch.normals.len()`:","                 // - No more FSMs in `fsm_receiver`.","@@ -487,6 +515,13 @@ impl<N: Fsm, C: Fsm, Handler: PollHandler<N, C>> Poller<N, C, Handler> {","                 batch.swap_reclaim(*index);","             }","             reschedule_fsms.clear();","+","+            // Counted every round, so a pool that never goes idle still reports.","+            POLLER_BUSY_SECONDS","+                .get(N::FSM_TYPE)","+                .get(busy_pool)","+                .inc_by(busy_since.saturating_elapsed_secs());","+            busy_since = Instant::now();","         }","         if let Some(fsm) = batch.control.take() {","             self.router.control_scheduler.schedule(fsm);"],"additions":42,"deletions":7,"truncated":false},{"path":"components/batch-system/src/metrics.rs","lines":["@@ -14,8 +14,19 @@ make_auto_flush_static_metric! {","         \"type\" => FsmType,","     }"," ","+    pub label_enum FsmPriority {","+        normal,","+        low,","+    }","+","     pub struct FsmScheduleWaitDurationVec: LocalHistogram {","         \"type\" => FsmType,","+        \"priority\" => FsmPriority,","+    }","+","+    pub struct PollerBusySecondsVec: LocalCounter {","+        \"type\" => FsmType,","+        \"priority\" => FsmPriority,","     }"," ","     pub struct FsmPollDurationVec: LocalHistogram {","@@ -53,12 +64,21 @@ lazy_static! {","     register_histogram_vec!(","         \"tikv_batch_system_fsm_schedule_wait_seconds\",","         \"Duration of fsm waiting to be polled.\",","-        &[\"type\"],","+        &[\"type\", \"priority\"],","         exponential_buckets(0.001, 1.59, 20).unwrap(), // max 10s","     ).unwrap();","     pub static ref FSM_SCHEDULE_WAIT_DURATION: FsmScheduleWaitDurationVec =","     auto_flush_from!(FSM_SCHEDULE_WAIT_DURATION_VEC, FsmScheduleWaitDurationVec);"," ","+    pub static ref POLLER_BUSY_SECONDS_VEC: CounterVec = register_counter_vec!(","+        \"tikv_batch_system_poller_busy_seconds_total\",","+        \"Wall time pollers spent handling FSMs rather than waiting for one. Includes off-CPU time, so it is occupancy, not CPU\",","+        &[\"type\", \"priority\"]","+    )","+    .unwrap();","+    pub static ref POLLER_BUSY_SECONDS: PollerBusySecondsVec =","+        auto_flush_from!(POLLER_BUSY_SECONDS_VEC, PollerBusySecondsVec);","+","     pub static ref FSM_POLL_DURATION_VEC: HistogramVec =","     register_histogram_vec!(","         \"tikv_batch_system_fsm_poll_seconds\","],"additions":21,"deletions":1,"truncated":false},{"path":"components/batch-system/tests/cases/batch.rs","lines":["@@ -3,7 +3,7 @@"," use std::{","     sync::{Arc, atomic::AtomicUsize},","     thread::sleep,","-    time::Duration,","+    time::{Duration, Instant},"," };"," "," use batch_system::{test_runner::*, *};","@@ -13,6 +13,7 @@ use tikv_util::mpsc;"," "," #[test]"," fn test_batch() {","+    let _serial = super::serialize_tests();","     let (control_tx, control_fsm) = Runner::new(10);","     let (router, mut system) =","         batch_system::create_system(&Config::default(), control_tx, control_fsm, None);","@@ -55,6 +56,7 @@ fn test_batch() {"," "," #[test]"," fn test_priority() {","+    let _serial = super::serialize_tests();","     let (control_tx, control_fsm) = Runner::new(10);","     let (router, mut system) =","         batch_system::create_system(&Config::default(), control_tx, control_fsm, None);","@@ -106,6 +108,7 @@ fn test_priority() {"," "," #[test]"," fn test_resource_group() {","+    let _serial = super::serialize_tests();","     let (control_tx, control_fsm) = Runner::new(10);","     let resource_manager = ResourceGroupManager::default();"," ","@@ -206,6 +209,7 @@ fn test_resource_group() {"," #[cfg(target_os = \"linux\")]"," #[test]"," fn test_thread_priority() {","+    let _serial = super::serialize_tests();","     use tikv_util::sys::thread::get_priority;"," ","     // Raising the nice value doesn't require `CAP_SYS_NICE`.","@@ -248,3 +252,156 @@ fn test_thread_priority() {","     assert_eq!(rx.recv_timeout(Duration::from_secs(3)), Ok(caller_pri));","     system.shutdown();"," }","+","+/// An FSM whose priority changes must move to the matching pool and back, as","+/// noisy-region demotion relies on.","+#[test]","+fn test_priority_change_migrates_fsm_between_pools() {","+    let _serial = super::serialize_tests();","+    // Returns (FSM priority, handling pool). No asserts inside the poller: a","+    // panic there kills the thread and hides the real failure.","+    fn observe(","+        router: &BatchRouter<Runner, Runner>,","+        tx: &mpsc::Sender<(Priority, Priority)>,","+        rx: &mpsc::Receiver<(Priority, Priority)>,","+    ) -> (Priority, Priority) {","+        let tx = tx.clone();","+        router","+            .send(","+                1,","+                Message::Callback(Box::new(move |h: &Handler, r: &mut Runner| {","+                    tx.send((r.get_priority(), h.get_priority())).unwrap();","+                })),","+            )","+            .unwrap();","+        rx.recv_timeout(Duration::from_secs(3)).unwrap()","+    }","+","+    fn set_priority(","+        router: &BatchRouter<Runner, Runner>,","+        tx: &mpsc::Sender<(Priority, Priority)>,","+        rx: &mpsc::Receiver<(Priority, Priority)>,","+        priority: Priority,","+    ) {","+        let tx = tx.clone();","+        router","+            .send(","+                1,","+                Message::Callback(Box::new(move |h: &Handler, r: &mut Runner| {","+                    r.set_priority(priority);","+                    tx.send((r.get_priority(), h.get_priority())).unwrap();","+                })),","+            )","+            .unwrap();","+        rx.recv_timeout(Duration::from_secs(3)).unwrap();","+    }","+","+    // Probes until `want` handles the FSM. The move happens at the end of the","+    // round, so the old poller may still drain a message sent right after.","+    fn wait_for_pool(","+        router: &BatchRouter<Runner, Runner>,","+        tx: &mpsc::Sender<(Priority, Priority)>,","+        rx: &mpsc::Receiver<(Priority, Priority)>,","+        want: Priority,","+    ) {","+        let deadline = Instant::now() + Duration::from_secs(5);","+        loop {","+            let (fsm_priority, pool) = observe(router, tx, rx);","+            if pool == want {","+                assert_eq!(","+                    fsm_priority, want,","+                    \"the FSM and the pool handling it must agree once it has moved\"","+                );","+                return;","+            }","+            assert!(","+                Instant::now() < deadline,","+                \"FSM never reached the {:?} pool\",","+                want","+            );","+        }","+    }","+","+    let (control_tx, control_fsm) = Runner::new(10);","+    let (router, mut system) =","+        batch_system::create_system(&Config::default(), control_tx, control_fsm, None);","+    system.spawn(\"test\".to_owned(), Builder::new());","+    let (tx, rx) = mpsc::unbounded();","+","+    let state_cnt = Arc::new(AtomicUsize::new(0));","+    let (fsm_tx, fsm) = Runner::new(10);","+    router.register(1, BasicMailbox::new(fsm_tx, fsm, state_cnt));","+","+    // Starts on the normal pool.","+    assert_eq!(","+        observe(&router, &tx, &rx),","+        (Priority::Normal, Priority::Normal)","+    );","+","+    // Demote it.","+    set_priority(&router, &tx, &rx, Priority::Low);","+    wait_for_pool(&router, &tx, &rx, Priority::Low);","+","+    // Releasing it must send it back.","+    set_priority(&router, &tx, &rx, Priority::Normal);","+    wait_for_pool(&router, &tx, &rx, Priority::Normal);","+","+    system.shutdown();","+}","+","+fn poller_busy_seconds(pool: &str) -> f64 {","+    prometheus::gather()","+        .iter()","+        .filter(|f| f.get_name() == \"tikv_batch_system_poller_busy_seconds_total\")","+        .flat_map(|f| f.get_metric())","+        .filter(|m| {","+            m.get_label()","+                .iter()","+                .any(|l| l.get_name() == \"priority\" && l.get_value() == pool)","+                && m.get_label()","+                    .iter()","+                    .any(|l| l.get_name() == \"type\" && l.get_value() == \"store\")","+        })","+        .map(|m| m.get_counter().get_value())","+        .sum()","+}","+","+#[test]","+fn test_poller_busy_time_counts_time_spent_handling() {","+    let _serial = super::serialize_tests();","+    let (control_tx, control_fsm) = Runner::new(10);","+    let (router, mut system) =","+        batch_system::create_system(&Config::default(), control_tx, control_fsm, None);","+    system.spawn(\"test\".to_owned(), Builder::new());","+    let (tx, rx) = mpsc::unbounded();","+    let state_cnt = Arc::new(AtomicUsize::new(0));","+    let (fsm_tx, fsm) = Runner::new(10);","+    router.register(1, BasicMailbox::new(fsm_tx, fsm, state_cnt));","+","+    // Off-CPU time spent holding an FSM counts as busy.","+    let before = poller_busy_seconds(\"normal\");","+    router","+        .send(","+            1,","+            Message::Callback(Box::new(move |_: &Handler, _: &mut Runner| {","+                sleep(Duration::from_millis(100));","+                tx.send(()).unwrap();","+            })),","+        )","+        .unwrap();","+    rx.recv_timeout(Duration::from_secs(3)).unwrap();","+    // The counter is thread-local and flushes on a later access, so keep the","+    // poller doing rounds until the flush lands.","+    let deadline = Instant::now() + Duration::from_secs(5);","+    while poller_busy_seconds(\"normal\") - before < 0.1 {","+        assert!(Instant::now() < deadline, \"busy time was never flushed\");","+        router","+            .send(","+                1,","+                Message::Callback(Box::new(|_: &Handler, _: &mut Runner| {})),","+            )","+            .unwrap();","+        sleep(Duration::from_millis(10));","+    }","+    system.shutdown();","+}"],"additions":158,"deletions":1,"truncated":false},{"path":"components/batch-system/tests/cases/mod.rs","lines":["@@ -1,4 +1,14 @@"," // Copyright 2020 TiKV Project Authors. Licensed under Apache-2.0."," ","+use std::sync::Mutex;","+","+/// Every test creates `store` pollers and some read the process-wide poller","+/// metrics, so they run one at a time.","+pub static TEST_LOCK: Mutex<()> = Mutex::new(());","+","+pub fn serialize_tests() -> std::sync::MutexGuard<'static, ()> {","+    TEST_LOCK.lock().unwrap_or_else(|e| e.into_inner())","+}","+"," mod batch;"," mod router;"],"additions":10,"deletions":0,"truncated":false},{"path":"components/batch-system/tests/cases/router.rs","lines":["@@ -26,6 +26,7 @@ fn unreachable() -> Message {"," "," #[test]"," fn test_basic() {","+    let _serial = super::serialize_tests();","     let (control_tx, mut control_fsm) = Runner::new(10);","     let (control_drop_tx, control_drop_rx) = mpsc::unbounded();","     control_fsm.sender = Some(control_drop_tx);","@@ -128,6 +129,7 @@ fn test_basic() {"," "," #[test]"," fn test_router_trace() {","+    let _serial = super::serialize_tests();","     let (control_tx, control_fsm) = Runner::new(10);","     let (router, mut system) =","         batch_system::create_system(&Config::default(), control_tx, control_fsm, None);"],"additions":2,"deletions":0,"truncated":false},{"path":"components/raftstore/Cargo.toml","lines":["@@ -92,4 +92,6 @@ engine_rocks = { workspace = true }"," engine_test = { workspace = true }"," file_system = { workspace = true, features = [\"testexport\"] }"," panic_hook = { workspace = true }","+resource_contr