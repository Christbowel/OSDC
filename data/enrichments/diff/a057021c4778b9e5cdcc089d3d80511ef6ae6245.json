 because applying the snapshot bumps the region version.","+        let initialized = self.peer.is_initialized();","+        // Decoded only when split or merge moved the region's bounds.","+        if self.noisy_region_version != version {","+            self.noisy_region_tables = util::region_table_range(region);","+            self.noisy_region_version = version;","+        }","+        // Evaluated even when disabled, so turning it off promotes regions back.","+        let next = match self.noisy_region_tables {","+            Some((first, last))","+                if enabled && initialized && mgr.any_noisy_table_in(first, last) =>","+            {","+                Priority::Low","+            }","+            _ => Priority::Normal,","+        };","+        self.noisy_priority_gen = generation;","+        self.noisy_enabled = enabled;","+        // Counted per transition, so idle demoted regions still show up.","+        if next != self.noisy_priority {","+            match next {","+                Priority::Low => NOISY_REGION_TO_LOW.inc(),","+                Priority::Normal => NOISY_REGION_TO_NORMAL.inc(),","+            }","+            self.noisy_priority = next;","+        }","+    }"," }"," "," pub struct PeerFsmDelegate<'a, EK, ER, T: 'static>","@@ -7921,7 +8005,7 @@ mod tests {","         atomic::{AtomicBool, Ordering},","     };"," ","-    use engine_test::kv::KvTestEngine;","+    use engine_test::{kv::KvTestEngine, raft::RaftTestEngine};","     use kvproto::raft_cmdpb::{","         AdminRequest, CmdType, PutRequest, RaftCmdRequest, RaftCmdResponse, Request, Response,","         StatusRequest,","@@ -8187,4 +8271,248 @@ mod tests {","         builder.add(RaftCommand::new(req2, Callback::None), size);","         assert!(builder.duplicate_put_on_lock_cf_detected);","     }","+","+    /// The encoded `t{table_id}` boundary a region split on that table has."],"additions":88,"deletions":2,"truncated":false}],"additions":494,"deletions":16,"truncated":true