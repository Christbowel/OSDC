pragma clang diagnostic ignored \"-Wunused-function\"","+","+#include <HAP_farf.h>","+","+#include <stdint.h>","+#include <string.h>","+#include <math.h>","+","+#include \"dma-queue.h\"","+#include \"hex-common.h\"","+#include \"hex-profile.h\"","+#include \"htp-ctx.h\"","+#include \"htp-tensor.h\"","+#include \"hvx-utils.h\"","+#include \"dsv4-hc-ops.h\"","+","+// ---------------------------------------------------------------------------","+// DSV4_HC_PRE","+// ---------------------------------------------------------------------------","+","+// hvx_vec_fast_sigmoid_f32_guard_2it with fewer live constants and predicates","+static inline HVX_Vector dsv4_hc_sigmoid_f32(HVX_Vector v, HVX_Vector max_exp, HVX_Vector min_exp) {","+    v = Q6_Vsf_vmin_VsfVsf(Q6_Vsf_vmax_VsfVsf(v, min_exp), max_exp);","+    v = Q6_Vqf32_vmpy_VsfVsf(v, hvx_vec_splat_f32(0.5f * 1.442695022f));","+","+    HVX_Vector in_int = Q6_Vw_equals_Vsf(Q6_Vsf_equals_Vqf32(v));","+    HVX_Vector x      = Q6_Vqf32_vsub_Vqf32Vsf(v, Q6_Vsf_equals_Vw(in_int));","+    HVX_Vector xx     = Q6_Vqf32_vmpy_Vqf32Vqf32(x, x);","+","+    HVX_Vector v1 = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(xx), Q6_V_vsplat_R(FAST_SIGMOID_C2));","+    v1            = Q6_Vqf32_vadd_Vqf32Vsf(v1, Q6_V_vsplat_R(FAST_SIGMOID_LOG2F));","+","+    HVX_Vector v2 = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(x), Q6_V_vsplat_R(FAST_SIGMOID_C1));","+    v2            = Q6_Vqf32_vmpy_Vqf32Vqf32(v2, xx);","+    v2            = Q6_Vqf32_vadd_Vqf32Vqf32(v2, x);","+","+    HVX_Vector v3 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(v2, v1));","+    v3            = Q6_Vw_vaslacc_VwVwR(v3, in_int, 24);","+","+    HVX_Vector v4 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_Vqf32Vqf32(v2, v1));","+    HVX_Vector v5 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_VsfVsf(v3, v4));","+","+    // Newton-Raphson with 2 iterations","+    HVX_Vector r = Q6_Vw_vsub_VwVw(Q6_V_vsplat_R(0x7EEEEBB3), v5);","+    for (int i = 0; i < 2; ++i) {","+        const HVX_Vector rv = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r, v5));","+        r = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_Vqf32Vqf32(Q6_Vqf32_vadd_VsfVsf(r, r), Q6_Vqf32_vmpy_VsfVsf(r, rv)));","+    }","+","+    return Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(v3, r));","+}","+","+struct dsv4_hc_pre_context {","+    struct htp_ops_context * octx;","+    const struct htp_dsv4_hc_pre_kernel_params * kparams;","+    uint32_t token_start;","+    uint32_t n_chunks;","+    uint32_t total_jobs;","+    uint32_t jobs_per_thread;","+    float scale;","+    uint8_t * vtcm;","+    uint32_t dma_block_chunks;","+    uint32_t dma_row_stride;","+    uint32_t dma_buffer_size;","+};","+","+struct dsv4_hc_block {","+    uint32_t it;","+    uint32_t chunk;","+    uint32_t count;","+};","+","+static inline struct dsv4_hc_block dsv4_hc_pre_block_make(","+        const struct dsv4_hc_pre_context * dctx,","+        uint32_t job,","+        uint32_t end) {","+    const uint32_t local_token = fastdiv(job, &dctx->kparams->div_n_chunks);","+    const uint32_t chunk       = job - local_token*dctx->n_chunks;","+    const uint32_t count       = hex_smin(dctx->dma_block_chunks, hex_smin(dctx->n_chunks - chunk, end - job));","+    return (struct dsv4_hc_block) {","+        .it    = dctx->token_start + local_token,","+        .chunk = chunk,","+        .count = count,","+    };","+}","+","+static inline void dsv4_hc_pre_push_plain(","+        dma_queue * dma_q,","+        const struct dsv4_hc_pre_context * dctx,","+        const struct dsv4_hc_block * block,","+        uint8_t * spad) {","+    const struct htp_tensor * x       = dctx->octx->src[0];","+    const struct htp_tensor * weights = dctx->octx->src[1];","+    const uint32_t row_stride         = dctx->dma_row_stride;","+    const uint32_t row_size           = block->count * VLEN;","+","+    dma_queue_push(dma_q, dma_make_data(spad, x->data + (block->it*x->nb[2] + block->chunk*VLEN)), row_stride, x->nb[1], row_size, 4);","+    dma_queue_push(dma_q, dma_make_data(spad + 5*row_stride, weights->data + (block->it*weights->nb[1])), 16, 16, 16, 1);","+}","+","+static inline void dsv4_hc_pre_push_gated(","+        dma_queue * dma_q,","+        const struct dsv4_hc_pre_context * dctx,","+        const struct dsv4_hc_block * block,","+        uint8_t * spad) {","+    const struct htp_tensor * x       = dctx->octx->src[0];","+    const struct htp_tensor * g       = dctx->octx->src[1];","+    const uint32_t row_stride         = dctx->dma_row_stride;","+    const uint32_t row_size           = block->count * VLEN;","+","+    dma_queue_push(dma_q, dma_make_data(spad, x->data + (block->it*x->nb[2] + block->chunk*VLEN)), row_stride, x->nb[1], row_size, 4);","+    dma_queue_push(dma_q, dma_make_data(spad + 4*row_stride, g->data + (block->it*g->nb[2] + block->chunk*VLEN)), row_stride, g->nb[1], row_size, 4);","+}","+","+static __attribute__((noinline)) void dsv4_hc_pre_plain_block_f32(","+        const struct dsv4_hc_pre_context * dctx,","+        const struct dsv4_hc_block * block,","+        const uint8_t * x_spad,","+        uint8_t * d_spad,","+        const float * wb) {","+    const uint32_t row_stride = dctx->dma_row_stride;","+    const HVX_Vector scale_v  = hvx_vec_splat_f32(dctx->scale);","+    const HVX_Vector w0       = hvx_vec_splat_f32(wb[0]);","+    const HVX_Vector w1       = hvx_vec_splat_f32(wb[1]);","+    const HVX_Vector w2       = hvx_vec_splat_f32(wb[2]);","+    const HVX_Vector w3       = hvx_vec_splat_f32(wb[3]);","+","+    for (uint32_t c = 0; c < block->count; ++c) {","+        const uint8_t * xb = x_spad + c*VLEN;","+","+        HVX_Vector x0 = *(const HVX_Vector *) xb;","+        HVX_Vector x1 = *(const HVX_Vector *) (xb + row_stride);","+        HVX_Vector x2 = *(const HVX_Vector *) (xb + 2*row_stride);","+        HVX_Vector x3 = *(const HVX_Vector *) (xb + 3*row_stride);","+","+        HVX_Vector acc = hvx_vec_mul_f32_f32(x0, w0);","+        acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(x1, w1));","+        acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(x2, w2));","+        acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(x3, w3));","+","+        *(HVX_Vector *) (d_spad + c*VLEN) = hvx_vec_mul_f32_f32(acc, scale_v);","+    }","+}","+","+static __attribute__((noinline)) void dsv4_hc_pre_gated_block_f32(","+        const struct dsv4_hc_pre_context * dctx,","+        const struct dsv4_hc_block * block,","+        const uint8_t * x_spad,","+        const uint8_t * g_spad,","+        uint8_t * d_spad) {","+    const uint32_t row_stride = dctx->dma_row_stride;","+    const HVX_Vector scale_v = hvx_vec_splat_f32(dctx->scale);","+    const HVX_Vector max_exp = hvx_vec_splat_f32(87.0f);","+    const HVX_Vector min_exp = hvx_vec_splat_f32(-87.0f);","+","+    for (uint32_t c = 0; c < block->count; ++c) {","+        const uint8_t * xb = x_spad + c*VLEN;","+        const uint8_t * gb = g_spad + c*VLEN;","+","+        HVX_Vector xv = *(const HVX_Vector *) xb;","+        HVX_Vector gv = dsv4_hc_sigmoid_f32(*(const HVX_Vector *) gb, max_exp, min_exp);","+        HVX_Vector acc = hvx_vec_mul_f32_f32(xv, gv);","+","+        xv = *(const HVX_Vector *) (xb + row_stride);","+        gv = dsv4_hc_sigmoid_f32(*(const HVX_Vector *) (gb + row_stride), max_exp, min_exp);","+        acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(xv, gv));","+","+        xv = *(const HVX_Vector *) (xb + 2*row_stride);","+        gv = dsv4_hc_sigmoid_f32(*(const HVX_Vector *) (gb + 2*row_stride), max_exp, min_exp);","+        acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(xv, gv));","+","+        xv = *(const HVX_Vector *) (xb + 3*row_stride);","+        gv = dsv4_hc_sigmoid_f32(*(const HVX_Vector *) (gb + 3*row_stride), max_exp, min_exp);","+        acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(xv, gv));","+","+        *(HVX_Vector *) (d_spad + c*VLEN) = hvx_vec_mul_f32_f32(acc, scale_v);","+    }","+}","+","+static void dsv4_hc_pre_thread_plain_f32(unsigned int nth, unsigned int ith, void * data) {","+    struct dsv4_hc_pre_context * dctx = (struct dsv4_hc_pre_context *) data;","+    struct htp_ops_context *     octx = dctx->octx;","+","+    const struct htp_tensor * dst    = octx->dst;","+    const uint64_t            d_data = dst->data;","+","+    const uint32_t row_stride  = dctx->dma_row_stride;","+    const uint32_t buffer_size = dctx->dma_buffer_size;","+    const uint32_t start       = dctx->jobs_per_thread * ith;","+    const uint32_t end         = hex_smin(start + dctx->jobs_per_thread, dctx->total_jobs);","+    if (start >= end) {","+        return;","+    }","+","+    uint8_t * spad[2] = {","+        dctx->vtcm + 2*buffer_size*ith,","+        dctx->vtcm + 2*buffer_size*ith + buffer_size,","+    };","+","+    dma_queue * dma_q = octx->ctx->dma[ith];","+    uint32_t prefetch_job = start;","+    for (uint32_t i = 0; i < 2 && prefetch_job < end; ++i) {","+        const struct dsv4_hc_block block = dsv4_hc_pre_block_make(dctx, prefetch_job, end);","+        // empty dst writeback keeps pop order dst, x, weights in loop","+        dma_queue_push(dma_q, dma_make_data(d_data, spad[i] + 4*row_stride), block.count*VLEN, block.count*VLEN, 0, 0);","+        dsv4_hc_pre_push_plain(dma_q, dctx, &block, spad[i]);","+        prefetch_job += block.count;","+    }","+","+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];","+","+    uint32_t job  = start;","+    uint32_t curr = 0;","+    while (job < end) {","+        const struct dsv4_hc_block block = dsv4_hc_pre_block_make(dctx, job, end);","+","+        dma_queue_pop(dma_q);","+        dma_queue_pop(dma_q);","+        dma_queue_pop(dma_q);","+","+        const float * wb = (const float *) (spad[curr] + 5*row_stride);","+        uint8_t * d_spad = spad[curr] + 4*row_stride;"],"additions":223,"deletions":0,"truncated":false}],"additions":670,"deletions":0,"truncated":true,"file_count":5},"error":null,"fetched_at":"2026-11-04T16:07:00.481818+00:00"}