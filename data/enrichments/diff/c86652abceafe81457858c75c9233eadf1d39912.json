'\"),","+        ])?","+        .with_file(","+            venv.join(\"pyvenv.cfg\"),","+            format!(\"home = {workspace}\\nversion = 3.13\\n\"),","+        )?","+        .with_file(&main, source)?","+        // Disable relative patterns so a single workspace-wide watch covers both environments.","+        .with_watched_file_support(false)","+        .build()","+        .wait_until_workspaces_are_initialized();","+","+    watcher_registrations(&mut server)?;","+    server.open_text_document(&main, source, 1);","+    assert_snapshot!(","+        condensed_document_diagnostic_snapshot(server.document_diagnostic_request(&main, None)),","+        @r#\"2:12..2:18[INFORMATION]: Revealed type: `Literal[\"pixi\"]`\"#","+    );","+","+    std::fs::remove_dir_all(&prefix)?;","+    server.did_change_watched_file(&prefix, FileChangeType::Deleted);","+    assert_snapshot!(","+        condensed_document_diagnostic_snapshot(server.document_diagnostic_request(&main, None)),","+        @r#\"2:12..2:18[INFORMATION]: Revealed type: `Literal[\"venv\"]`\"#","+    );","+    Ok(())","+}","+"," #[test]"," fn nested_search_path_picks_up_missed_dependency_edit() -> Result<()> {","     let main = SystemPath::new(\"src/main.py\");"],"additions":53,"deletions":1,"truncated":false},{"path":"crates/ty_site_packages/src/lib.rs","lines":["@@ -200,26 +200,30 @@ fn settings_diagnostic_path_from_sys_prefix(","         sys_prefix.join(\"bin\")","     };"," ","-    for candidate in [","-        bin_dir.join(\"python3\"),","-        bin_dir.join(\"python\"),","-        bin_dir.join(\"pypy3\"),","-        bin_dir.join(\"pypy\"),","-    ] {","+    find_interpreter_in_directory(&bin_dir, system)","+}","+","+/// Tries common interpreter names such as `python3`, `pypy`, and `graalpy` before scanning for","+/// names that include a minor version, such as `python3.13`.","+fn find_interpreter_in_directory(","+    bin_dir: &SystemPath,","+    system: &dyn System,","+) -> Option<SystemPathBuf> {","+    for