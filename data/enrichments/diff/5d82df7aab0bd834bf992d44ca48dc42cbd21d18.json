{"id":"5d82df7aab0bd834bf992d44ca48dc42cbd21d18","axis":"silent","repo":"mongodb/mongo","sha":"5d82df7aab0bd834bf992d44ca48dc42cbd21d18","parsed":{"files":[{"path":"jstests/noPassthrough/extensions/extension_command_auth.js","lines":["@@ -0,0 +1,113 @@","+/**","+ * Tests that the host enforces the privileges an extension command declares before running it.","+ * Uses the mock_commands extension: extRequiresFind requires the find action on its target","+ * namespace, extRequiresFindDb requires it on the whole database, and testEcho declares no required","+ * privileges.","+ *","+ * @tags: [featureFlagExtensionsAPI, featureFlagExtensionCommands]","+ */","+import {describe, it} from \"jstests/libs/mochalite.js\";","+import {","+    checkPlatformCompatibleWithExtensions,","+    withExtensions,","+} from \"jstests/noPassthrough/libs/extension_helpers.js\";","+","+checkPlatformCompatibleWithExtensions();","+","+const extensions = {\"libmock_commands_extension.so\": {}};","+const collName = \"coll\";","+const otherCollName = \"otherColl\";","+","+function runTest(conn) {","+    const admin = conn.getDB(\"admin\");","+    admin.createUser({user: \"adminUser\", pwd: \"pwd\", roles: [\"root\"]});","+    assert(admin.auth(\"adminUser\", \"pwd\"));","+","+    const db = conn.getDB(jsTestName());","+    const findOn = (coll) => [{resource: {db: db.getName(), collection: coll}, actions: [\"find\"]}];","+    db.createRole({role: \"canFind\", privileges: findOn(collName), roles: []});","+    db.createRole({role: \"canFindOtherColl\", privileges: findOn(otherCollName), roles: []});","+    db.createRole({role: \"canFindDb\", privileges: findOn(\"\"), roles: []});","+    db.createUser({user: \"findUser\", pwd: \"pwd\", roles: [\"canFind\"]});","+    db.createUser({user: \"findDbUser\", pwd: \"pwd\", roles: [\"canFindDb\"]});","+    db.createUser({user: \"otherCollUser\", pwd: \"pwd\", roles: [\"canFindOtherColl\"]});","+    db.createUser({user: \"noPrivilegesUser\", pwd: \"pwd\", roles: []});","+    admin.logout();","+","+    function asUser(user, fn) {","+        assert(db.auth(user, \"pwd\"));","+        try {","+            fn();","+        } finally {","+            db.logout();","+        }","+    }","+","+    // A user who holds the declared action on the target namespace can run the command.","+    asUser(\"findUser\", () => {","+        assert.commandWorked(db.runCommand({extRequiresFind: collName}));","+    });","+","+    // A user without the declared action is rejected, but can still run a command that declares no","+    // required privileges.","+    asUser(\"noPrivilegesUser\", () => {","+        assert.commandFailedWithCode(","+            db.runCommand({extRequiresFind: collName}),","+            ErrorCodes.Unauthorized,","+        );","+        assert.commandWorked(db.runCommand({testEcho: collName}));","+    });","+","+    // Holding the declared action on a different namespace does not grant access.","+    asUser(\"otherCollUser\", () => {","+        assert.commandFailedWithCode(","+            db.runCommand({extRequiresFind: collName}),","+            ErrorCodes.Unauthorized,","+        );","+        assert.commandWorked(db.runCommand({extRequiresFind: otherCollName}));","+    });","+","+    // A command that names no collection is checked against its database.","+    asUser(\"findUser\", () => {","+        assert.commandFailedWithCode(db.runCommand({extRequiresFind: 1}), ErrorCodes.Unauthorized);","+    });","+    asUser(\"findDbUser\", () => {","+        assert.commandWorked(db.runCommand({extRequiresFind: 1}));","+        assert.commandWorked(db.runCommand({extRequiresFind: collName}));","+    });","+","+    // A database-scoped privilege is enforced against the database, not the collection named in","+    // the request: a user holding the action on only one collection cannot run the command.","+    asUser(\"findUser\", () => {","+        assert.commandFailedWithCode(","+            db.runCommand({extRequiresFindDb: collName}),","+            ErrorCodes.Unauthorized,","+        );","+    });","+    asUser(\"findDbUser\", () => {","+        assert.commandWorked(db.runCommand({extRequiresFindDb: collName}));","+    });","+","+    // An unauthenticated client cannot run any of the commands.","+    assert.commandFailedWithCode(","+        db.runCommand({extRequiresFind: collName}),","+        ErrorCodes.Unauthorized,","+    );","+    assert.commandFailedWithCode(","+        db.runCommand({extRequiresFindDb: collName}),","+        ErrorCodes.Unauthorized,","+    );","+    assert.commandFailedWithCode(db.runCommand({testEcho: collName}), ErrorCodes.Unauthorized);","+}","+","+// Standalone and sharded need different configuration setups to enable auth, so they run","+// separately.","+describe(\"extension command authorization\", function () {","+    it(\"enforces declared privileges on a standalone\", function () {","+        withExtensions(extensions, runTest, [\"standalone\"], {}, {auth: \"\"});","+    });","+","+    it(\"enforces declared privileges on a sharded cluster\", function () {","+        withExtensions(extensions, runTest, [\"sharded\"], {other: {keyFile: \"jstests/libs/key1\"}});","+    });","+});"],"additions":113,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/extensions/extension_command_echo.js","lines":["@@ -0,0 +1,54 @@","+/**","+ * Tests that an extension command receives the request and the command context, and that its","+ * response reaches the client.","+ * @tags: [featureFlagExtensionsAPI, featureFlagExtensionCommands]","+ */","+import {describe, it} from \"jstests/libs/mochalite.js\";","+import {","+    checkPlatformCompatibleWithExtensions,","+    withExtensions,","+} from \"jstests/noPassthrough/libs/extension_helpers.js\";","+","+checkPlatformCompatibleWithExtensions();","+","+const extensions = {\"libmock_commands_extension.so\": {}};","+","+function testEcho(conn) {","+    const db = conn.getDB(jsTestName());","+","+    let res = assert.commandWorked(db.runCommand({testEcho: \"coll\", message: \"hello\"}));","+    assert.eq(res.request.message, \"hello\", {res});","+    assert.eq(res.db, db.getName(), {res});","+    assert.eq(res.coll, \"coll\", {res});","+","+    // A command that does not name a collection passes an empty collection name.","+    res = assert.commandWorked(db.runCommand({testEcho: 1}));","+    assert.eq(res.db, db.getName(), {res});","+    assert.eq(res.coll, \"\", {res});","+}","+","+describe(\"testEcho extension command\", function () {","+    // testEcho declares 'clusterRole: both', so it runs on mongod (shard role) and on mongos","+    // (router role).","+    it(\"echoes the request and namespace\", function () {","+        withExtensions(extensions, testEcho, [\"standalone\", \"sharded\"]);","+    });","+","+    it(\"is not registered when featureFlagExtensionCommands is disabled\", function () {","+        withExtensions(","+            extensions,","+            (conn) => {","+                assert.commandFailedWithCode(","+                    conn.getDB(jsTestName()).runCommand({testEcho: \"coll\"}),","+                    ErrorCodes.CommandNotFound,","+                );","+            },","+            [","+                {","+                    topology: \"standalone\",","+                    mongodOptions: {setParameter: {featureFlagExtensionCommands: false}},","+                },","+            ],","+        );","+    });","+});"],"additions":54,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/host/BUILD.bazel","lines":["@@ -24,6 +24,7 @@ mongo_cc_library(","     ],","     deps = [","         \"//src/mongo:base\",","+        \"//src/mongo/db/auth:authprivilege\",","         \"//src/mongo/db/commands/server_status:server_status_metric\",","         \"//src/mongo/db/extension/shared\",","         \"//src/mongo/db/extension/shared/handle\",","@@ -92,6 +93,7 @@ mongo_cc_library(","     srcs = [","         \"document_source_extension_for_query_shape.cpp\",","         \"document_source_extension_optimizable.cpp\",","+        \"extension_command.cpp\",","         \"extension_stage.cpp\",","     ],","     deps = [","@@ -101,12 +103,14 @@ mongo_cc_library(","         \"//src/mongo:base\",","         \"//src/mongo/db:commands\",","         \"//src/mongo/db:shard_role_api\",","+        \"//src/mongo/db/auth\",","         \"//src/mongo/db/commands/server_status:server_status_core\",","         \"//src/mongo/db/extension/host/aggregation_stage\",","         \"//src/mongo/db/extension/host_connector/adapter:host_adapters\",","         \"//src/mongo/db/extension/host_connector/adapter:host_services_adapter\",","         \"//src/mongo/db/extension/host_connector/handle:host_handles\",","         \"//src/mongo/db/extension/shared/handle/aggregation_stage:aggregation_stage_handles\",","+        \"//src/mongo/db/extension/shared/handle/command:command_handles\",","         \"//src/mongo/db/pipeline\",","         \"//src/mongo/db/pipeline:docs_needed_bounds_visitor\",","         \"//src/mongo/db/pipeline:lite_parsed_desugarer\",","@@ -198,6 +202,23 @@ mongo_cc_library(","     }),"," )"," ","+mongo_cc_unit_test(","+    name = \"extension_command_test\",","+    srcs = [","+        \"extension_command_test.cpp\",","+    ],","+    tags = [\"mongo_unittest_seventh_group\"],","+    deps = [","+        \":extension_host\",","+        \"//src/mongo/db:service_context_test_fixture\",","+        \"//src/mongo/db/extension/host_connector/adapter:host_adapters\",","+        \"//src/mongo/db/extension/host_connector/adapter:host_services_adapter\",","+        \"//src/mongo/db/extension/sdk:sdk_cpp\",","+        \"//src/mongo/db/extension/shared/handle/command:command_handles\",","+        \"//src/mongo/unittest\",","+    ],","+)","+"," mongo_cc_unit_test(","     name = \"extensions_api_test\",","     srcs = ["],"additions":21,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/host/document_source_extension_optimizable.h","lines":["@@ -329,10 +329,7 @@ class DocumentSourceExtensionOptimizable : public DocumentSource,"," ","             if (const auto& requiredPrivileges = _properties.getRequiredPrivileges()) {","                 for (const auto& rp : *requiredPrivileges) {","-                    ActionSet actions;","-                    for (const auto& entry : rp.getActions()) {","-                        actions.addAction(static_properties_util::toActionType(entry.getAction()));","-                    }","+                    const auto actions = static_properties_util::toActionSet(rp);"," ","                     switch (rp.getResourcePattern()) {","                         case MongoExtensionPrivilegeResourcePatternEnum::kNamespace:"],"additions":1,"deletions":4,"truncated":false},{"path":"src/mongo/db/extension/host/extension_command.cpp","lines":["@@ -0,0 +1,180 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/extension/host/extension_command.h\"","+","+#include \"mongo/db/auth/authorization_session.h\"","+#include \"mongo/db/auth/resource_pattern.h\"","+#include \"mongo/db/database_name_util.h\"","+#include \"mongo/db/extension/host/extension_host_utils.h\"","+#include \"mongo/db/extension/shared/byte_buf_utils.h\"","+#include \"mongo/db/query/query_feature_flags_gen.h\"","+#include \"mongo/db/service_context.h\"","+#include \"mongo/logv2/log.h\"","+","+#include <array>","+#include <string_view>","+#include <vector>","+","+#include <fmt/format.h>","+","+#define MONGO_LOGV2_DEFAULT_COMPONENT ::mongo::logv2::LogComponent::kExtension","+","+namespace mongo::extension::host {","+","+namespace {","+","+ClusterRole toClusterRole(MongoExtensionCommandClusterRoleEnum role) {","+    switch (role) {","+        case MongoExtensionCommandClusterRoleEnum::kShard:","+            return ClusterRole::ShardServer;","+        case MongoExtensionCommandClusterRoleEnum::kRouter:","+            return ClusterRole::RouterServer;","+        case MongoExtensionCommandClusterRoleEnum::kBoth:","+            return {ClusterRole::ShardServer, ClusterRole::RouterServer};","+    }","+    MONGO_UNREACHABLE_TASSERT(13730003);","+}","+","+/**","+ * Top-level reply fields that the host owns. Errors must be returned through the status, and the","+ * remaining fields are appended by the host after the command runs.","+ */","+constexpr std::array kReservedReplyFields{","+    \"ok\", \"errmsg\", \"code\", \"codeName\", \"$clusterTime\", \"operationTime\", \"writeConcernError\"};","+","+}  // namespace","+","+ExtensionCommand::ExtensionCommand(CommandDescriptorHandle descriptor,","+                                   MongoExtensionCommandStaticProperties properties)","+    : BasicCommand(descriptor->getName()),","+      _descriptor(std::move(descriptor)),","+      _properties(std::move(properties)) {}","+","+void ExtensionCommand::registerCommand(CommandDescriptorHandle descriptor) {","+    const std::string cmdName{descriptor->getName()};","+","+    if (!feature_flags::gFeatureFlagExtensionCommands.isEnabled()) {","+        LOGV2(13730005,","+              \"Extension commands are disabled; skipping command registration\",","+              \"commandName\"_attr = cmdName);","+        return;","+    }","+","+    uassert(ErrorCodes::ExtensionError,","+            fmt::format(\"Invalid extension command name '{}'\", cmdName),","+            !cmdName.empty() && cmdName.front() != '$' &&","+                cmdName.find_first_of(std::string_view{\".\\0\", 2}) == std::string::npos);","+","+    auto properties = MongoExtensionCommandStaticProperties::parse(","+        descriptor->getProperties(), IDLParserContext(fmt::format(\"{} properties\", cmdName)));","+    const auto declaredRoles = toClusterRole(properties.getClusterRole());","+","+    // Registries exist only for the roles this process serves, and are built before extensions","+    // load. Check each of them for a name collision before registering into any:","+    // CommandRegistry::registerCommand() fatally asserts on a duplicate name, and an extension must","+    // not shadow a built-in or another extension's command.","+    std::vector<ClusterRole> roles;","+    for (auto role : {ClusterRole::ShardServer, ClusterRole::RouterServer}) {","+        if (declaredRoles.has(role) && getGlobalServiceContext()->getService(role)) {","+            uassert(ErrorCodes::ExtensionError,","+                    fmt::format(\"Extension command '{}' is already registered for the {} role\",","+                                cmdName,","+                                toString(role)),","+                    !getCommandRegistry(role)->findCommand(cmdName));","+            roles.push_back(role);","+        }","+    }","+","+    for (auto role : roles) {","+        LOGV2(13730006,","+              \"Registering extension command\",","+              \"commandName\"_attr = cmdName,","+              \"role\"_attr = toString(role));","+        auto command = std::make_unique<ExtensionCommand>(descriptor, properties);","+        command->initializeClusterRole(role);","+        getCommandRegistry(role)->registerCommand(command.release());","+    }","+}","+","+Command::AllowedOnSecondary ExtensionCommand::secondaryAllowed(ServiceContext*) const {","+    switch (_properties.getAllowedOnSecondary()) {","+        case MongoExtensionCommandAllowedOnSecondaryEnum::kAlways:","+            return AllowedOnSecondary::kAlways;","+        case MongoExtensionCommandAllowedOnSecondaryEnum::kNever:","+            return AllowedOnSecondary::kNever;","+        case MongoExtensionCommandAllowedOnSecondaryEnum::kOptIn:","+            return AllowedOnSecondary::kOptIn;","+    }","+    MONGO_UNREACHABLE_TASSERT(13730007);","+}","+","+Command::ReadWriteType ExtensionCommand::getReadWriteType() const {","+    switch (_properties.getReadWriteType()) {","+        case MongoExtensionCommandReadWriteTypeEnum::kRead:","+            return ReadWriteType::kRead;","+        case MongoExtensionCommandReadWriteTypeEnum::kWrite:","+            return ReadWriteType::kWrite;","+        case MongoExtensionCommandReadWriteTypeEnum::kCommand:","+            return ReadWriteType::kCommand;","+    }","+    MONGO_UNREACHABLE_TASSERT(13730004);","+}","+","+Status ExtensionCommand::checkAuthForOperation(OperationContext* opCtx,","+                                               const DatabaseName& dbName,","+                                               const BSONObj& cmdObj) const {","+    const auto& requiredPrivileges = _properties.getRequiredPrivileges();","+    if (requiredPrivileges.empty()) {","+        // A command that does not require privileges can be run by any authenticated user.","+        return Status::OK();","+    }","+","+    auto* authSession = AuthorizationSession::get(opCtx->getClient());","+    for (const auto& privilege : requiredPrivileges) {","+        // Each declared privilege is checked against the resource named by its own resource","+        // pattern.","+        const auto resource =","+            privilege.getResourcePattern() == MongoExtensionPrivilegeResourcePatternEnum::kDatabase","+            ? ResourcePattern::forDatabaseName(dbName)","+            : parseResourcePattern(dbName, cmdObj);","+","+        if (!authSession->isAuthorizedForActionsOnResource(","+                resource, static_properties_util::toActionSet(privilege))) {","+            return {ErrorCodes::Unauthorized,","+                    fmt::format(\"not authorized to run command '{}'\", getName())};","+        }","+    }","+    return Status::OK();","+}","+","+bool ExtensionCommand::run(OperationContext* opCtx,","+                           const DatabaseName& dbName,","+                           const BSONObj& cmdObj,","+                           BSONObjBuilder& result) {","+    const auto nss = parseNs(dbName, cmdObj);","+    const auto dbNameStr =","+        DatabaseNameUtil::serialize(dbName, SerializationContext::stateCommandRequest());","+","+    // TODO SERVER-137298: Pass the resolved collection UUID and view.","+    const ::MongoExtensionCommandContext ctx{","+        .namespaceString =","+            {","+                .databaseName = stringViewAsByteView(dbNameStr),","+                .collectionName = stringViewAsByteView(nss.coll()),","+            },","+    };","+    _descriptor->run(cmdObj, ctx, result);","+","+    const auto reply = result.asTempObj();","+    for (auto field : kReservedReplyFields) {","+        uassert(ErrorCodes::ExtensionError,","+                fmt::format(\"Extension command '{}' returned the reserved reply field '{}'\",","+                            getName(),","+                            field),","+                !reply.hasField(field));","+    }","+    return true;","+}","+","+}  // namespace mongo::extension::host"],"additions":180,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/host/extension_command.h","lines":["@@ -0,0 +1,69 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+#pragma once","+","+#include \"mongo/db/commands.h\"","+#include \"mongo/db/extension/public/extension_command_static_properties_gen.h\"","+#include \"mongo/db/extension/shared/handle/command/command_descriptor.h\"","+#include \"mongo/util/modules.h\"","+","+#include <string>","+","+namespace mongo::extension::host {","+","+/**","+ * ExtensionCommand is a host-side BasicCommand that wraps an extension-provided command descriptor.","+ * Its static behavior comes from the descriptor's static properties, and its run() delegates","+ * execution to the extension via the C API boundary.","+ */","+class ExtensionCommand final : public BasicCommand {","+public:","+    ExtensionCommand(CommandDescriptorHandle descriptor,","+                     MongoExtensionCommandStaticProperties properties);","+","+    /**","+     * Registers the command in each cluster role that its static properties declare and this","+     * process serves. Throws if the properties are invalid or if a command with the same name is","+     * already registered for one of the roles.","+     */","+    static void registerCommand(CommandDescriptorHandle descriptor);","+","+    AllowedOnSecondary secondaryAllowed(ServiceContext*) const override;","+","+    bool adminOnly() const override {","+        return _properties.getAdminOnly();","+    }","+","+    bool supportsWriteConcern(const BSONObj& cmdObj) const override {","+        return _properties.getSupportsWriteConcern();","+    }","+","+    ReadWriteType getReadWriteType() const override;","+","+    bool isSubjectToIngressAdmissionControl() const override {","+        return _properties.getIsSubjectToIngressAdmissionControl();","+    }","+","+    bool requiresAuthzChecks() const override {","+        return !_properties.getRequiredPrivileges().empty();","+    }","+","+    Status checkAuthForOperation(OperationContext* opCtx,","+                                 const DatabaseName& dbName,","+                                 const BSONObj& cmdObj) const override;","+","+    bool run(OperationContext* opCtx,","+             const DatabaseName& dbName,","+             const BSONObj& cmdObj,","+             BSONObjBuilder& result) override;","+","+    std::string help() const override {","+        return \"extension-defined command\";","+    }","+","+private:","+    CommandDescriptorHandle _descriptor;","+    MongoExtensionCommandStaticProperties _properties;","+};","+","+}  // namespace mongo::extension::host"],"additions":69,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/host/extension_command_test.cpp","lines":["@@ -0,0 +1,166 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/extension/host/extension_command.h\"","+","+#include \"mongo/base/error_codes.h\"","+#include \"mongo/bson/bsonobj.h\"","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/db/commands.h\"","+#include \"mongo/db/extension/host/host_portal.h\"","+#include \"mongo/db/extension/host_connector/adapter/host_services_adapter.h\"","+#include \"mongo/db/extension/sdk/command.h\"","+#include \"mongo/db/extension/sdk/host_services.h\"","+#include \"mongo/db/extension/sdk/tests/shared_test_commands.h\"","+#include \"mongo/db/extension/shared/handle/command/command_descriptor.h\"","+#include \"mongo/db/service_context_test_fixture.h\"","+#include \"mongo/unittest/server_parameter_guard.h\"","+#include \"mongo/unittest/unittest.h\"","+#include \"mongo/util/static_immortal.h\"","+","+#include <memory>","+#include <string>","+#include <string_view>","+#include <vector>","+","+namespace mongo::extension::host {","+namespace {","+","+using sdk::shared_test_commands::EchoCommandDescriptor;","+","+const DatabaseName kTestDb = DatabaseName::createDatabaseName_forTest(boost::none, \"testDb\");","+","+class ExtensionCommandTest : public ServiceContextTest {","+public:","+    static constexpr CapabilityVersion kCapabilityVersion = CapabilityVersion::latestCapability();","+","+    void setUp() override {","+        ServiceContextTest::setUp();","+        sdk::HostServicesAPI::setHostServices(&host_connector::HostServicesAdapter::get(),","+                                              kCapabilityVersion);","+    }","+","+    /**","+     * Registers a command through the same path the host portal uses at extension load. Registered","+     * commands keep an unowned handle to the descriptor for the rest of the process, so every","+     * descriptor is kept alive for the process lifetime, including ones whose registration was","+     * skipped or rejected.","+     */","+    void registerCommand(std::string name,","+                         BSONObj properties = EchoCommandDescriptor::defaultProperties()) {","+        static StaticImmortal<std::vector<std::unique_ptr<sdk::ExtensionCommandDescriptorAdapter>>>","+            descriptors;","+        auto& descriptor =","+            descriptors->emplace_back(std::make_unique<sdk::ExtensionCommandDescriptorAdapter>(","+                std::make_unique<EchoCommandDescriptor>(std::move(name), std::move(properties))));","+        ExtensionCommand::registerCommand(","+            CommandDescriptorHandle(descriptor.get(), kCapabilityVersion));","+    }","+","+    ExtensionCommand* findCommand(std::string_view name) {","+        return dynamic_cast<ExtensionCommand*>(","+            getCommandRegistry(ClusterRole::ShardServer)->findCommand(name));","+    }","+","+private:","+    unittest::ServerParameterGuard _featureFlagExtensionCommands{\"featureFlagExtensionCommands\",","+                                                                 true};","+};","+","+TEST_F(ExtensionCommandTest, PropertiesMapToCommandOverrides) {","+    registerCommand(\"testExtProperties\",","+                    BSON(\"readWriteType\" << \"write\"","+                                         << \"allowedOnSecondary\"","+                                         << \"optIn\"","+                                         << \"adminOnly\" << true << \"supportsWriteConcern\" << true","+                                         << \"isSubjectToIngressAdmissionControl\" << true","+                                         << \"requiredPrivileges\" << BSONArray()));","+","+    auto* cmd = findCommand(\"testExtProperties\");","+    ASSERT_TRUE(cmd);","+    ASSERT_EQ(cmd->secondaryAllowed(getServiceContext()), Command::AllowedOnSecondary::kOptIn);","+    ASSERT_EQ(cmd->getReadWriteType(), Command::ReadWriteType::kWrite);","+    ASSERT_TRUE(cmd->adminOnly());","+    ASSERT_TRUE(cmd->supportsWriteConcern(BSONObj()));","+    ASSERT_TRUE(cmd->isSubjectToIngressAdmissionControl());","+}","+","+TEST_F(ExtensionCommandTest, RunPassesNamespaceToExtension) {","+    registerCommand(\"testExtRun\");","+    auto* cmd = findCommand(\"testExtRun\");","+    auto opCtx = makeOperationContext();","+","+    ASSERT_TRUE(cmd);","+","+    BSONObjBuilder result;","+    const auto request = BSON(\"testExtRun\" << \"coll\");","+    ASSERT_TRUE(cmd->run(opCtx.get(), kTestDb, request, result));","+    ASSERT_BSONOBJ_EQ(result.obj(),","+                      BSON(\"request\" << request << \"db\"","+                                     << \"testDb\"","+                                     << \"coll\"","+                                     << \"coll\"));","+}","+","+TEST_F(ExtensionCommandTest, RunRejectsReservedReplyFields) {","+    registerCommand(\"testExtReserved\");","+    auto* cmd = findCommand(\"testExtReserved\");","+    auto opCtx = makeOperationContext();","+    ASSERT_TRUE(cmd);","+","+    for (auto&& extra : {BSON(\"ok\" << 0), BSON(\"errmsg\" << \"x\"), BSON(\"operationTime\" << 1)}) {","+        BSONObjBuilder result;","+        ASSERT_THROWS_CODE(","+            cmd->run(","+                opCtx.get(), kTestDb, BSON(\"testExtReserved\" << 1 << \"extra\" << extra), result),","+            DBException,","+            ErrorCodes::ExtensionError);","+    }","+}","+","+// The test fixture's process serves only the shard role.","+TEST_F(ExtensionCommandTest, RegisterCommandOnlyAddsItToServedRoles) {","+    registerCommand(\"testExtRouterOnly\",","+                    BSON(\"clusterRole\" << \"router\"","+                                       << \"requiredPrivileges\" << BSONArray()));","+    ASSERT_FALSE(findCommand(\"testExtRouterOnly\"));","+}","+","+TEST_F(ExtensionCommandTest, RegisterCommandRejectsDuplicateName) {","+    registerCommand(\"testExtDup\");","+    ASSERT_THROWS_CODE(registerCommand(\"testExtDup\"), DBException, ErrorCodes::ExtensionError);","+}","+","+TEST_F(ExtensionCommandTest, RegisterCommandRejectsInvalidName) {","+    for (auto name : {\"\", \"$testExt\", \"test.ext\"}) {","+        ASSERT_THROWS_CODE(registerCommand(name), DBException, ErrorCodes::ExtensionError);","+    }","+    ASSERT_THROWS_CODE(","+        registerCommand(std::string(\"test\\0ext\", 8)), DBException, ErrorCodes::ExtensionError);","+}","+","+TEST_F(ExtensionCommandTest, RegisterCommandR