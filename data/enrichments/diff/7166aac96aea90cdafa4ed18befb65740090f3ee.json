+  {excludeFieldPaths, includeFieldPaths}: PartialIndexFieldPaths,","+): boolean {","+  if (!excludeFieldPaths?.length) return false","+","+  const pathSegments = toSegments(path)","+  const excluded = matchingPrefixLength(excludeFieldPaths, pathSegments)","+  if (excluded === 0) return false","+","+  return excluded >= matchingPrefixLength(includeFieldPaths, pathSegments)","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/search/common/types.ts","lines":["@@ -69,11 +69,27 @@ export interface WeightedHit extends SearchHit {","   stories: SearchStory[]"," }"," ","+/**","+ * Field paths from a dataset's partial indexing settings, in the format returned by the indexing","+ * settings API (e.g. `analytics`, `analytics[]`, `seo.title`).","+ *","+ * @internal","+ */","+export interface PartialIndexFieldPaths {","+  excludeFieldPaths?: readonly string[]","+  includeFieldPaths?: readonly string[]","+}","+"," /**","  * @internal","  */"," export interface SearchFactoryOptions {","   maxDepth?: number","+  /**","+   * Fields excluded from the dataset's partial index cannot be used in `score()`. Search","+   * strategies that score results skip boosts on those fields.","+   */","+  partialIndexFieldPaths?: PartialIndexFieldPaths","   filter?: string","   params?: Record<string, unknown>","   tag?: string"],"additions":16,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/search/groq2024/createSearchQuery.test.ts","lines":["@@ -2,6 +2,7 @@ import {Schema} from '@sanity/schema'"," import {defineArrayMember, defineField, defineType} from '@sanity/types'"," import {describe, expect, it} from 'vitest'"," ","+import {createSchema} from '../../schema/createSchema'"," import {DEFAULT_LIMIT} from '../weighted/createSearchQuery'"," import {createSearchQuery} from './createSearchQuery'"," ","@@ -651,6 +652,76 @@ describe('createSearchQuery', () => {","     })","   })"," ","+  describe('partial index field paths', () => {","+    const 