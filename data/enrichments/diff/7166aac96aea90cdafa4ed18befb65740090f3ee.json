se)","+  })","+","+  test('an excluded path excludes itself and every path below it', () => {","+    const fieldPaths = {excludeFieldPaths: ['analytics']}","+","+    expect(isFieldPathExcludedFromIndex('analytics', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('analytics.pageName', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('analytics[].pageName', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('analytics.meta.slug.current', fieldPaths)).toBe(true)","+  })","+","+  test('an excluded path does not exclude siblings sharing its prefix', () => {","+    const fieldPaths = {excludeFieldPaths: ['analytics']}","+","+    expect(isFieldPathExcludedFromIndex('analyticsLabel', fieldPaths)).toBe(false)","+    expect(isFieldPathExcludedFromIndex('title', fieldPaths)).toBe(false)","+    expect(isFieldPathExcludedFromIndex('page.analytics', fieldPaths)).toBe(false)","+  })","+","+  test('an excluded array item path excludes fields of the array items only', () => {","+    const fieldPaths = {excludeFieldPaths: ['labels[]']}","+","+    expect(isFieldPathExcludedFromIndex('labels[].text', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('labels', fieldPaths)).toBe(false)","+  })","+","+  test('a nested excluded path excludes only that nested subtree', () => {","+    const fieldPaths = {excludeFieldPaths: ['seo.description']}","+","+    expect(isFieldPathExcludedFromIndex('seo.description', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('seo.title', fieldPaths)).toBe(false)","+  })","+","+  test('an included path more specific than the exclusion keeps the path', () => {","+    const fieldPaths = {","+      excludeFieldPaths: ['analytics'],","+      includeFieldPaths: ['analytics.pageName'],","+    }","+","+    expect(isFieldPathExcludedFromIndex('analytics.pageName', fieldPaths)).toBe(false)","+    expect(isFieldPathExcludedFromIndex('analytics.campaign', fieldPaths)).toBe(true)","+  })","+","+  test('a path that is both excluded and included at the same level stays excluded', () => {","+    const fieldPaths = {excludeFieldPaths: ['content'], includeFieldPaths: ['content']}","+","+    expect(isFieldPathExcludedFromIndex('content', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('content.heading', fieldPaths)).toBe(true)","+  })","+","+  test('an included path less specific than the exclusion does not keep the path', () => {","+    const fieldPaths = {excludeFieldPaths: ['page.analytics'], includeFieldPaths: ['page']}","+","+    expect(isFieldPathExcludedFromIndex('page.analytics.pageName', fieldPaths)).toBe(true)","+    expect(isFieldPathExcludedFromIndex('page.title', fieldPaths)).toBe(false)","+  })","+})"],"additions":65,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/search/common/deriveSearchWeightsFromType2024.ts","lines":["@@ -15,7 +15,7 @@ interface SearchWeightEntry {","   type?: 'string' | 'pt'"," }"," ","-const CACHE = new WeakMap<SchemaType | CrossDatasetType, SearchSpec>()","+const CACHE = new WeakMap<SchemaType | CrossDatasetType, Map<string, SearchSpec>>()"," "," const PREVIEW_FIELD_WEIGHT_MAP = {","   title: 10,","@@ -97,6 +97,8 @@ function getLeafWeights(","     }"," ","     if (isSlugField(type)) {","+      // The weight applies to `<path>.current`, one level below the slug field itself.","+      if (depth + 1 > maxDepth) return accumulator","       const weight = getWeight(type, path)","       if (typeof weight === 'number') {","         accumulator.push({","@@ -235,7 +237,11 @@ export function deriveSearchWeightsFromType2024({","   isCrossDataset,","   processPaths = (paths) => paths,"," }: DeriveSearchWeightsFromTypeOptions): SearchSpec {","-  const cached = CACHE.get(schemaType)","+  // The dataset's partial index settings can lower `maxDepth` after a first search at the default.","+  const cacheKey = `${maxDepth}:${Boolean(isCrossDataset)}`","+  const cachedByOptions = CACHE.get(schemaT