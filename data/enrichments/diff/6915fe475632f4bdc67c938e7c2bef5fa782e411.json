d -> shard never collapses: unsharding commits a","+ *   brand-new collection, so each shardCollection incarnation carries a fresh UUID.","+ *","+ * @param {Object} event - A change stream event.","+ * @returns {string|null}","+ */","+function makeCommandDedupKey(event) {","+    if (!event || !event.ns || !event.ns.db || !event.ns.coll) {","+        return null;","+    }","+    if (event.operationType === \"reshardCollection\") {","+        if (","+            !event.hasOwnProperty(\"operationDescription\") ||","+            event.operationDescription.reshardUUID === undefined","+        ) {","+            return null;","+        }","+        return `${event.ns.db}.${event.ns.coll}|reshard|${tojson(","+            event.operationDescription.reshardUUID,","+        )}`;","+    }","+    if (event.operationType === \"shardCollection\") {","+        if (event.uuid === undefined) {","+            return null;","+        }","+        return `${event.ns.db}.${event.ns.coll}|shard|${tojson(event.uuid)}`;","+    }","+    return null;","+}","+","+/**","+ * Tracks which command (DDL) events a reader has already emitted, so a subsequently observed","+ * duplicate copy is collapsed (not recorded/counted).","+ */","+class DedupCommandEventTracker {","+    /**","+     * @param {Array<string>} [seedKeys] - Dedup keys already emitted before the reader's","+     *     start point, so it collapses a duplicate whose first copy precedes the start.","+     */","+    constructor(seedKeys = []) {","+        this._seenKeys = new Set(seedKeys);","+        this._duplicateCount = 0;","+    }","+","+    /**","+     * Returns true when `event` is a duplicate command event that should be collapsed.","+     * @param {Object} event - A change stream event.","+     * @returns {boolean}","+     */","+    shouldSkip(event) {","+        const key = makeCommandDedupKey(event);","+        if (key === null) {","+            return false;","+        }","+        if (this._seenKeys.has(key)) {","+            this._duplicateCount++;","+            return true;","+        }","+        this._seenKeys.add(key);","+        return false;","+    }","+","+    /**","+     * Number of duplicate command events collapsed so far.","+     * @returns {number}","+     */","+    getDuplicateCount() {","+        return this._duplicateCount;","+    }","+}","+","+export {makeCommandDedupKey, DedupCommandEventTracker};"],"additions":91,"deletions":0,"truncated":false},{"path":"jstests/libs/util/change_stream/change_stream_verifier.js","lines":["@@ -28,7 +28,7 @@ import {","     ChangeStreamReader,","     ChangeStreamReadingMode,"," } from \"jstests/libs/util/change_stream/change_stream_reader.js\";","-","+import {makeCommandDedupKey} from \"jstests/libs/util/change_stream/change_stream_reader_dedup.js\";"," /**","  * Format a change event record for debugging output.","  * @param {Object} rec - Event record containing changeEvent","@@ -129,9 +129,11 @@ class VerifierContext {"," ","     /**","      * Launch a reader from a specific cluster time without waiting for completion.","+     * @param {Array<string>} [dedupSeedKeys] - Dedup keys seen before `clusterTime`, so this","+     *     reader collapses the same duplicates as the reference reader.","      * @returns {string} The instance name of the launched reader (use with getChangeEvents to collect).","      */","-    launchReaderFromClusterTime(conn, instanceName, clusterTime, limit) {","+    launchReaderFromClusterTime(conn, instanceName, clusterTime, limit, dedupSeedKeys = []) {","         const baseCfg = this.changeStreamReaderConfigs[instanceName];","         assert(baseCfg, `No reader config for instanceName=${instanceName}`);","         assert(limit > 0, `limit must be a positive number, got ${limit}`);","@@ -141,6 +143,7 @@ class VerifierContext {","             numberOfEventsToRead: limit,","             readingMode: ChangeStreamReadingMode.kContinuous,","             startAtClusterTime: clusterTime,","+            dedupSeedKeys