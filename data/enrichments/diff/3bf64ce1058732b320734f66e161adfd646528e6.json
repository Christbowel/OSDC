{"id":"3bf64ce1058732b320734f66e161adfd646528e6","axis":"silent","repo":"vllm-project/vllm","sha":"3bf64ce1058732b320734f66e161adfd646528e6","parsed":{"files":[{"path":"docs/features/lora.md","lines":["@@ -480,4 +480,17 @@ vllm serve model --enable-lora --lora-target-modules o_proj"," vllm serve model --enable-lora --lora-target-modules o_proj qkv_proj down_proj"," ```"," ","-When `--lora-target-modules` is not specified, LoRA will be applied to all supported modules in the model. This parameter accepts module suffixes (the last component of the module name), such as `o_proj`, `qkv_proj`, `gate_proj`, etc.","+`--lora-target-modules` is an explicit allowlist for module names or suffixes such as `o_proj`, `qkv_proj`, and `gate_proj`. When set, this list takes precedence over `--enable-lora-embedding-modules`.","+","+### Embedding Modules","+","+By default, LoRA skips embedding modules (input embeddings and `lm_head`), so vLLM allocates no LoRA buffers for them.","+Use `--enable-lora-embedding-modules` to enable both alongside the default modules. The Python `LLM` argument is `enable_lora_embedding_modules=True`.","+","+```bash","+vllm serve model --enable-lora --enable-lora-embedding-modules","+```","+","+If an adapter contains weights for an embedding module excluded by default, vLLM logs a warning, skips those weights, and applies the remaining enabled weights. Use an explicit `--lora-target-modules` list for finer control, such as enabling input embedding LoRA without `lm_head`.","+","+Enabling `lm_head` LoRA through either option disables prompt scoring for the deployment. Requests using `prompt_logprobs` (including `0`) or `prompt_logprob_token_ids` receive a validation error. This restriction also applies to base-model requests because they can be batched with LoRA requests. Input embedding LoRA supports prompt scoring when `lm_head` LoRA is disabled."],"additions":14,"deletions":1,"truncated":false},{"path":"tests/basic_correctness/memory/sleep_mode/test_sleep_mode.py","lines":["@@ -221,6 +221,7 @@ def test_deep_sleep_lora_tp2(monkeypatch):","         model,","         enable_sleep_mode=True,","         enable_lora=True,","+        enable_lora_embedding_modules=True,","         max_lora_rank=8,","         tensor_parallel_size=2,","         enforce_eager=True,"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/lora/test_llama_tp.py","lines":["@@ -91,6 +91,7 @@ def test_llama_lora(vllm_runner, llama32_lora_files, cudagraph_specialize_lora:","     with vllm_runner(","         MODEL_PATH,","         enable_lora=True,","+        enable_lora_embedding_modules=True,","         # also test odd max_num_seqs","         max_num_seqs=7,","         max_model_len=1024,","@@ -110,6 +111,7 @@ def test_llama_lora_transformers_backend(vllm_runner, llama32_lora_files):","         MODEL_PATH,","         model_impl=\"transformers\",","         enable_lora=True,","+        enable_lora_embedding_modules=True,","         max_num_seqs=7,","         max_model_len=1024,","         max_loras=4,","@@ -126,6 +128,7 @@ def test_llama_lora_tp4(vllm_runner, llama32_lora_files):","     with vllm_runner(","         MODEL_PATH,","         enable_lora=True,","+        enable_lora_embedding_modules=True,","         max_num_seqs=7,","         max_model_len=1024,","         max_loras=4,","@@ -140,6 +143,7 @@ def test_llama_lora_tp4_fully_sharded_loras(vllm_runner, llama32_lora_files):","     with vllm_runner(","         MODEL_PATH,","         enable_lora=True,","+        enable_lora_embedding_modules=True,","         max_num_seqs=8,","         max_loras=4,","         max_model_len=1024,"],"additions":4,"deletions":0,"truncated":false},{"path":"tests/lora/test_lora_manager.py","lines":["@@ -375,7 +375,11 @@ def test_lm_head_exempt_from_dedup(default_vllm_config, dist_init, dummy_model):","         1,","         1,","         LoRAConfig(","-            max_lora_rank=8, max_cpu_loras=8, max_loras=8, lora_dtype=DEFAULT_DTYPE","+            max_lora_rank=8,","+            max_cpu_loras=8,","+            max_loras=8,","+            lora_dtype=DEFAULT_DTYPE,","+            enable_embedding_modules=True,","         ),","         torch.device(DEVICES[0]),","         default_vllm_config,","@@ -581,7 +585,11 @@ def test_lora_model_manager(default_vllm_config, dist_init, dummy_model, device)","         2,","         2,","         LoRAConfig(","-            max_lora_rank=8, max_cpu_loras=3, max_loras=2, lora_dtype=DEFAULT_DTYPE","+            max_lora_rank=8,","+            max_cpu_loras=3,","+            max_loras=2,","+            lora_dtype=DEFAULT_DTYPE,","+            enable_embedding_modules=True,","         ),","         device=device,","         vllm_config=default_vllm_config,","@@ -1301,10 +1309,12 @@ def test_target_modules_multiple(default_vllm_config, dist_init, dummy_model, de"," "," "," @pytest.mark.parametrize(\"device\", DEVICES)","-def test_target_modules_none_uses_all(","+def test_target_modules_none_uses_defaults(","     default_vllm_config, dist_init, dummy_model, device"," ):","-    \"\"\"Test that target_modules=None uses all supported modules.\"\"\"","+    \"\"\"The default wraps supported linear layers and leaves lm_head unwrapped.\"\"\"","+    from vllm.lora.layers import LogitsProcessorWithLoRA","+","     _test_target_modules(","         dummy_model,","         None,","@@ -1315,7 +1325,7 @@ def test_target_modules_none_uses_all(","             (\"dense2\", RowParallelLinearWithLoRA),","             (\"layer1.dense2\", RowParallelLinearWithLoRA),","         ],","-        expected_no_lora=[],","+        expected_no_lora=[(\"logits_processor\", LogitsProcessorWithLoRA)],","         vllm_config=default_vllm_config,","     )"," "],"additions":15,"deletions":5,"truncated":false},{"path":"tests/lora/test_qwen3_with_multi_loras.py","lines":["@@ -174,9 +174,15 @@ def test_multiple_lora_requests(vllm_runner):","             LoRARequest(LORA_NAME + str(idx), idx + 1, LORA_NAME_PATH_MAP[LORA_NAME])","             for idx in range(len(PROMPTS))","         ]","-        # Multiple SamplingParams should be matched with each prompt","-        outputs = runner.llm.generate(PROMPTS, lora_request=lora_request)","+        # Each prompt has its own LoRA request and should return prompt logprobs.","+        outputs = runner.llm.generate(","+            PROMPTS, SamplingParams(prompt_logprobs=0), lora_request=lora_request","+        )","         assert len(PROMPTS) == len(outputs)","+        for output, request in zip(outputs, lora_request):","+            assert output.lora_request == request","+            prompt_logprobs = output.prompt_logprobs","+            assert prompt_logprobs is not None and any(prompt_logprobs)"," ","         # Exception raised, if the size of params does not match the size of prompts","         with pytest.raises(VLLMValidationError):"],"additions":8,"deletions":2,"truncated":false},{"path":"vllm/config/lora.py","lines":["@@ -10,12 +10,14 @@"," from vllm import envs"," from vllm.config.kernel import MEGA_MOE_BACKENDS, KernelConfig"," from vllm.config.utils import CompileFactors, config, get_compile_factors","+from vllm.exceptions import VLLMValidationError"," from vllm.logger import init_logger"," from vllm.platforms import current_platform"," "," if TYPE_CHECKING:","     from vllm.config import ModelConfig","     from vllm.config.cache import CacheConfig","+    from vllm.sampling_params import SamplingParams"," else:","     ModelConfig = Any","     CacheConfig = Any","@@ -55,8 +57,11 @@ class LoRAConfig:","     \"\"\"Data type for LoRA. If auto, will default to base model dtype.\"\"\"","     target_modules: list[str] | None = None","     \"\"\"Restrict LoRA to specific module suffixes (e.g., [\"o_proj\", \"qkv_proj\"]).","-    If None, all supported LoRA modules are used. This allows deployment-time","-    control over which modules have LoRA applied, useful for performance tuning.\"\"\"","+    An explicit list takes precedence over `enable_lora_embedding_modules`.\"\"\"","+    enable_embedding_modules: bool = False","+    \"\"\"Enable LoRA on input embeddings and `lm_head` alongside the default","+    LoRA modules. Both are skipped by default. Ignored when","+    `lora_target_modules` is specified.\"\"\"","     default_mm_loras: dict[str, str] | None = None","     \"\"\"Dictionary mapping specific modalities to LoRA model paths; this field","     is only applicable to multimodal models and should be leveraged when a","@@ -96,6 +101,20 @@ class LoRAConfig:","     \"\"\"Maximum output size for LoRA classification heads. Defaults to the","     base classification head size.\"\"\""," ","+    def validate_prompt_logprobs(self, params: \"SamplingParams\") -> None:","+        if params.prompt_logprobs is None and params.prompt_logprob_token_ids is None:","+            return","+        lm_head_enabled = (","+            any(\"lm_head\" in name for name in self.target_modules)","+            if self.target_modules is not None","+            else self.enable_embedding_modules","+        )","+        if lm_head_enabled:","+            raise VLLMValidationError(","+                \"prompt_logprobs and prompt_logprob_token_ids are unsupported \"","+                \"when lm_head LoRA is enabled for the deployment.\"","+            )","+","     def compile_factors(self) -> CompileFactors:","         \"\"\"WARNING: Whenever a new field is added to this config, add it to","         `ignored_factors` if it does not affect the computation graph."],"additions":21,"deletions":2,"truncated":false},{"path":"vllm/engine/arg_utils.py","lines":["@@ -253,10 +253,13 @@ def collection_to_kwargs(type_hints: set[TypeHint], type: TypeHint) -> dict[str,","         )","         elem_type = str"," ","-    return {","+    kwargs = {","         \"type\": elem_type,","         \"nargs\": \"+\" if type is not tuple or Ellipsis in types else len(types),","     }","+    if get_origin(elem_type) is Literal:","+        kwargs.update(literal_to_kwargs({elem_type}))","+    return kwargs"," "," "," def is_not_builtin(type_hint: TypeHint) -> bool:","@@ -682,6 +685,7 @@ class EngineArgs:","     max_cpu_loras: int | None = LoRAConfig.max_cpu_loras","     lora_dtype: str | torch.dtype | None = LoRAConfig.lora_dtype","     lora_target_modules: list[str] | None = LoRAConfig.target_modules","+    enable_lora_embedding_modules: bool = LoRAConfig.enable_embedding_modules","     enable_tower_connector_lora: bool = LoRAConfig.enable_tower_connector_lora","     specialize_active_lora: bool = LoRAConfig.specialize_active_lora","     enable_mixed_moe_lora_format: bool = LoRAConfig.enable_mixed_moe_lora_format","@@ -1632,6 +1636,10 @@ def add_cli_args(parser: FlexibleArgumentParser) -> FlexibleArgumentParser:","         lora_group.add_argument(","             \"--lora-target-modules\", **lora_kwargs[\"target_modules\"]","         )","+        lora_group.add_argument(","+            \"--enable-lora-embedding-modules\",","+            **lora_kwargs[\"enable_embedding_modules\"],","+        )","         lora_group.add_argument(\"--default-mm-loras\", **lora_kwargs[\"default_mm_loras\"])","         lora_group.add_argument(","             \"--specialize-active-lora\", **lora_kwargs[\"specialize_active_lora\"]","@@ -2731,6 +2739,7 @@ def create_engine_config(","                 split_k_reduction=self.lora_split_k_reduction,","                 lora_dtype=self.lora_dtype,","                 target_modules=self.lora_target_modules,","+                enable_embedding_modules=self.enable_lora_embedding_modules,","                 enable_tower_connector_lora=self.enable_tower_connector_lora,","                 specialize_active_lora=self.specialize_active_lora,","                 enable_mixed_moe_lora_format=self.enable_mixed_moe_lora_format,"],"additions":10,"deletions":1,"truncated":false},{"path":"vllm/lora/model_manager.py","lines":["@@ -485,6 +485,17 @@ def _parent_module(module_name: str) -> str:","         # Layers that share a suffix with a LoRA layer but are not wrapped,","         # such as BERT's pooler.dense. Adapters with LoRA on them are refused.","         self.unsupported_lora_modules: set[str] = set()","+        self.disabled_embedding_modules: set[str] = set()","+        if (","+            self.lora_config.target_modules is None","+            and not self.lora_config.enable_embedding_modules","+        ):","+            # Use model declarations so every pipeline rank can check adapter","+            # weights, even when the corresponding layer is on another rank.","+            for module in self.model.modules():","+                self.disabled_embedding_modules.update(","+                    getattr(module, \"embedding_modules\", None) or ()","+                )"," ","         named_modules = list(self.model.named_modules(remove_duplicate=False))","         runners = [f\"{n}.\" for n, m in named_modules if isinstance(m, MoERunner)]","@@ -495,6 +506,8 @@ def _parent_module(module_name: str) -> str:","         for module_name, module in named_modules:","             if isinstance(module, PPMissingLayer):","                 continue","+            if module_name.rsplit(\".\", 1)[-1] in self.disabled_embedding_modules:","+                continue"," ","             is_classifier_head = module_name in self.supported_modules_to_save"," ","@@ -1269,6 +1282,20 @@ def _get_lora_layer_weights(","                 org_module_name = text_name","         return lora_model.get_lora(org_module_name)"," ","+    def warn_disabled_embedding_modules(self, lora_model: LoRAModel) -> None:","+        if not self.disabled_embedding_modules:","+            return","+        disabled = self.disabled_embedding_modules.intersection(","+            name.rsplit(\".\", 1)[-1] for name in lora_model.loras","+        )","+        if disabled:","+            logger.warning_once(","+                \"Ignoring weights for disabled embedding modules in LoRA adapter \"","+                \"ID %d: %s. Enable them wi