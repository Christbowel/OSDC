terface{}) error"," // Rows return sql.Rows compatible Rows obj, as a forward Iterator object for iterating record by record, bean's non-empty fields"," // are conditions."," func (session *Session) Rows(bean interface{}) (*Rows, error) {","-\treturn newRows(session, bean)","+\trows, err := newRows(session, bean)","+\tif err != nil {","+\t\t// A successful query clears the statement itself, a failed one before the query does not.","+\t\tsession.resetStatement()","+\t}","+\treturn rows, err"," }"," "," // Iterate record by record handle records from table, condiBeans's non-empty fields","@@ -25,6 +30,9 @@ func (session *Session) Iterate(bean interface{}, fun IterFunc) error {"," \t\tdefer session.Close()"," \t}"," ","+\t// Runs after bufferIterate has restored autoResetStatement, so the buffered path is covered too.","+\tdefer session.resetStatement()","+"," \tif session.statement.lastError != nil {"," \t\treturn session.statement.lastError"," \t}"],"additions":9,"deletions":1,"truncated":false},{"path":"pkg/util/xorm/session_query.go","lines":["@@ -83,6 +83,8 @@ func (session *Session) Query(sqlOrArgs ...interface{}) ([]map[string][]byte, er"," \t\tdefer session.Close()"," \t}"," ","+\tdefer session.resetStatement()","+"," \tsqlStr, args, err := session.genQuerySQL(sqlOrArgs...)"," \tif err != nil {"," \t\treturn nil, err","@@ -238,6 +240,8 @@ func (session *Session) QueryString(sqlOrArgs ...interface{}) ([]map[string]stri"," \t\tdefer session.Close()"," \t}"," ","+\tdefer session.resetStatement()","+"," \tsqlStr, args, err := session.genQuerySQL(sqlOrArgs...)"," \tif err != nil {"," \t\treturn nil, err","@@ -258,6 +262,8 @@ func (session *Session) QuerySliceString(sqlOrArgs ...interface{}) ([][]string,"," \t\tdefer session.Close()"," \t}"," ","+\tdefer session.resetStatement()","+"," \tsqlStr, args, err := session.genQuerySQL(sqlOrArgs...)"," \tif err != nil {"," \t\treturn nil, err","@@ -314,6 +320,8 @@ func (session *Session) QueryInterface(sqlOrArgs ...interface{}) ([]map[string]i"," \t\tdefer session.Close()"," \t}"," ","+\tdefer session.resetStatement()","+"," \tsqlStr, args, err := session.genQuerySQL(sqlOrArgs...)"," \tif err != nil {"," \t\treturn nil, err"],"additions":8,"deletions":0,"truncated":false},{"path":"pkg/util/xorm/session_reset_test.go","lines":["@@ -0,0 +1,160 @@","+package xorm","+","+import (","+\t\"testing\"","+","+\t_ \"github.com/grafana/grafana/pkg/util/sqlite\"","+\t\"github.com/grafana/grafana/pkg/util/xorm/core\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+type LeakRule struct {","+\tId    int64","+\tGuid  string","+\tTitle string","+}","+","+type LeakUser struct {","+\tId  int64","+\tUid string","+}","+","+func newLeakEngine(t *testing.T) *Engine {","+\tt.Helper()","+","+\teng, err := NewEngine(\"sqlite3\", \":memory:\")","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { require.NoError(t, eng.Close()) })","+","+\t_, err = eng.Exec(\"CREATE TABLE leak_rule (id INTEGER PRIMARY KEY, guid TEXT, title TEXT)\")","+\trequire.NoError(t, err)","+\t_, err = eng.Exec(\"CREATE TABLE leak_user (id INTEGER PRIMARY KEY, uid TEXT)\")","+\trequire.NoError(t, err)","+\t_, err = eng.Exec(\"INSERT INTO leak_rule (id, guid, title) VALUES (1, 'g1', 't1')\")","+\trequire.NoError(t, err)","+\t_, err = eng.Exec(\"INSERT INTO leak_user (id, uid) VALUES (1, 'u1')\")","+\trequire.NoError(t, err)","+","+\treturn eng","+}","+","+// Sessions are shared between services through the request context, so state left","+// on the session by one query must not change the next query on an unrelated table.","+func TestSessionStateDoesNotLeakBetweenOperations(t *testing.T) {","+\tt.Run(\"after Rows\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\trows, err := sess.Table(\"leak_rule\").Rows(new(LeakRule))","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, rows.Next())","+\t\trequire.NoError(t, rows.Scan(new(LeakRule)))","+\t\trequire.NoError(t, rows.Close())","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\tt.Run(\"after Update\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\tupdated, err := sess.Table(LeakRule{}).ID(1).AllCols().Omit(\"guid\").Update(&LeakRule{Title: \"t2\"})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, int64(1), updated)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\tt.Run(\"after Delete\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\t_, err := sess.Table(LeakRule{}).ID(1).Delete(&LeakRule{})","+\t\trequire.NoError(t, err)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\t// These operations return before they reach the database, which used to leave the","+\t// table and column list behind on the session.","+\tt.Run(\"after Update that has nothing to update\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\t_, err := sess.Table(LeakRule{}).ID(1).Cols(\"unknown_column\").Update(&LeakRule{})","+\t\trequire.Error(t, err)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\tt.Run(\"after InsertMulti with nothing to insert\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\tinserted, err := sess.Table(LeakRule{}).Cols(\"guid\").InsertMulti(&[]LeakRule{})","+\t\trequire.NoError(t, err)","+\t\trequire.Zero(t, inserted)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\tt.Run(\"after Rows that fails to build a query\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\t_, err := sess.Table(LeakRule{}).ID(core.PK{1, 2}).Rows(new(LeakRule))","+\t\trequire.Error(t, err)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\tt.Run(\"after buffered Iterate\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\tvisited := 0","+\t\terr := sess.Table(LeakRule{}).Cols(\"guid\").BufferSize(1).Iterate(new(LeakRule), func(int, interface{}) error {","+\t\t\tvisited++","+\t\t\treturn nil","+\t\t})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, 1, visited)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+","+\tt.Run(\"after Count\", func(t *testing.T) {","+\t\teng := newLeakEngine(t)","+\t\tsess := eng.NewSession()","+\t\tdefer sess.Close()","+","+\t\tcount, err := sess.Table(LeakRule{}).Where(\"guid = ?\", \"g1\").Count()","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, int64(1), count)","+","+\t\tvar users []LeakUser","+\t\trequire.NoError(t, sess.Table(\"leak_user\").Find(&users))","+\t\trequire.Len(t, users, 1)","+\t})","+}"],"additions":160,"deletions":0,"truncated":false},{"path":"pkg/util/xorm/session_stats.go","lines":["@@ -17,6 +17,8 @@ func (session *Session) Count(bean ...interface{}) (int64, error) {"," \t\tdefer session.Close()"," \t}"," ","+\tdefer session.resetStatement()","+"," \tvar sqlStr string"," \tvar args []interface{}"," \tvar err error","@@ -45,6 +47,8 @@ func (session *Session) sum(res interface{}, bean interface{}, columnNames ...st"," \t\tdefer session.Close()"," \t}"," ","+\tdefer session.resetStatement()","+"," \tv := reflect.ValueOf(r