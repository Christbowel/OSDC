nd platforms.","+\tvector<LinkedExtension> linked_extensions;","+"," \tbool operator==(const DBConfig &other);"," \tbool operator!=(const DBConfig &other);"," "],"additions":15,"deletions":0,"truncated":false},{"path":"src/include/duckdb/main/extension_helper.hpp","lines":["@@ -98,6 +98,9 @@ class ExtensionHelper {"," \tstatic void LoadAllExtensions(DuckDB &db);"," \tstatic vector<string> LoadedExtensionTestPaths();"," \tstatic ExtensionLoadResult LoadExtension(DuckDB &db, const std::string &extension);","+\t//! Publishes the extensions linked into this binary onto the config. Generated at build time;","+\t//! a build that links none (or an extension carrying its own DuckDB) registers nothing.","+\tstatic void RegisterLinkedExtensions(DBConfig &config);"," "," \t//! Install an extension"," \tstatic unique_ptr<ExtensionInstallInfo> InstallExtension(ClientContext &context, const string &extension,"],"additions":3,"deletions":0,"truncated":false},{"path":"src/main/database.cpp","lines":["@@ -302,6 +302,8 @@ void DatabaseInstance::Initialize(const char *database_path, DBConfig *user_conf"," \t}"," "," \tConfigure(*config_ptr, database_path);","+\t// publish what this binary links, unless the config already carries a set handed to us","+\tExtensionHelper::RegisterLinkedExtensions(config);"," "," \tcreate_api_v1 = CreateAPIv1Wrapper;"," ","@@ -477,6 +479,9 @@ Allocator &Allocator::Get(AttachedDatabase &db) {"," void DatabaseInstance::Configure(DBConfig &new_config, const char *database_path) {"," \tconfig.options = new_config.options;"," \tconfig.user_settings = new_config.user_settings;","+\t// carry over a capability set handed to us, so a database created by code with its own copy of","+\t// DuckDB can be given the extensions the binary that created it links","+\tconfig.linked_extensions = new_config.linked_extensions;"," "," \tif (Settings::Get<DuckDBAPISetting>(*this).empty()) {"," \t\tconfig.SetOptionByName(\"duckdb_api\", \"cpp\");"],"additions":5,"deletions":0,"truncated":false},{"path":"src/main/extension/extension_helper.cpp","lines":["@@ -90,6 +90,29 @@"," "," namespace duckdb {"," ","+//! Loads an extension that was linked into the binary, via the registry the config carries. This is","+//! deliberately not generated code: an extension with its own copy of DuckDB links no generated","+//! loader, so a compile-time list would be invisible to it, while the config is data it can read.","+ExtensionLoadResult ExtensionHelper::LoadExtension(DuckDB &db, const std::string &extension) {","+\tauto &config = DBConfig::GetConfig(*db.instance);","+\tfor (auto &linked : config.linked_extensions) {","+\t\tif (StringUtil::CIEquals(linked.name, extension)) {","+\t\t\tlinked.load(db);","+\t\t\treturn ExtensionLoadResult::LOADED_EXTENSION;","+\t\t}","+\t}","+\treturn ExtensionLoadResult::NOT_LOADED;","+}","+","+void ExtensionHelper::LoadAllExtensions(DuckDB &db) {","+\t// registration order, so a binary loads its extensions the same way on every run","+\tauto &config = DBConfig::GetConfig(*db.instance);","+\tauto linked = config.linked_extensions;","+\tfor (auto &entry : linked) {","+\t\tentry.load(db);","+\t}","+}","+"," //===--------------------------------------------------------------------===//"," // Default Extensions"," //===--------------------------------------------------------------------===//",""],"additions":23,"deletions":0,"truncated":false}],"additions":76,"deletions":36,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-08-19T08:08:18.403964+00:00"}