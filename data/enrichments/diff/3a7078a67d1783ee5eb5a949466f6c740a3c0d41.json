{"id":"3a7078a67d1783ee5eb5a949466f6c740a3c0d41","axis":"silent","repo":"MetaMask/metamask-extension","sha":"3a7078a67d1783ee5eb5a949466f6c740a3c0d41","parsed":{"files":[{"path":"app/scripts/lib/boot-operation-roots.integration.test.ts","lines":["@@ -0,0 +1,349 @@","+import * as Sentry from '@sentry/browser';","+import {","+  _INTERNAL_setSpanForScope as setSpanForScope,","+  getDefaultCurrentScope,","+  type Event as SentryEvent,","+} from '@sentry/core';","+import {","+  C2_DOMAIN_BLOCKLIST_URL,","+  METAMASK_HOTLIST_DIFF_URL,","+  METAMASK_STALELIST_URL,","+} from '@metamask/phishing-controller';","+import { trace, TraceName } from '../../../shared/lib/trace';","+import { traceSupportedNetworksFetches } from '../messenger-client-init/assets/assets-controller-init';","+import { getGeolocationApiServiceInstanceOptions } from '../wallet-init/instance-options/geolocation-api-service';","+import { rampsInitTrace } from './ramps/ramps-init-trace';","+import { shouldCreateSpanForRequest } from './setupSentry';","+import {","+  BACKEND_TRACE_PROPAGATION_TARGETS,","+  consensysTracePropagationIntegration,","+} from './sentry-trace-propagation';","+import { updatePhishingLists } from './update-phishing-lists';","+","+const UNRELATED_URL = 'https://client-config.api.cx.metamask.io/v1/flags';","+const GEOLOCATION_URL = 'https://on-ramp.api.cx.metamask.io/geolocation';","+const COUNTRIES_URL = 'https://on-ramp.api.cx.metamask.io/regions/countries';","+const SUPPORTED_NETWORKS_URL =","+  'https://accounts.api.cx.metamask.io/v2/supportedNetworks';","+","+type Deferred = { promise: Promise<void>; resolve: () => void };","+","+function defer(): Deferred {","+  let resolve: () => void = () => undefined;","+  const promise = new Promise<void>((done) => {","+    resolve = done;","+  });","+  return { promise, resolve };","+}","+","+function traceparentIds(header: string | undefined) {","+  const [, traceId, spanId] = (header ?? '').split('-');","+  return { traceId, spanId };","+}","+","+// A real client, as the service worker configures it, with every trace sampled","+// and each sent transaction recorded.","+describe('boot-time operation roots (real SDK)', () => {","+  const requests: { url: string; headers: Record<string, string> }[] = [];","+  const transactions: SentryEvent[] = [];","+  const originalFetch = globalThis.fetch;","+","+  // One client for the file: each init adds fetch handlers that outlive it.","+  beforeAll(() => {","+    // Wrapped once per process by the SDK, so installed before the init.","+    globalThis.fetch = jest.fn(async (input, init?: RequestInit) => {","+      requests.push({","+        url: String(input),","+        headers: Object.fromEntries(new Headers(init?.headers)),","+      });","+      return new Response('{}', { status: 200 });","+    }) as typeof fetch;","+    // Lets `Sentry.init` run in jsdom, which it takes for an embedded extension.","+    (globalThis as { nw?: object }).nw = {};","+    performance.getEntriesByType ??= () => [];","+    (globalThis as { sentry?: unknown }).sentry = Sentry;","+    Sentry.init({","+      dsn: 'https://public@example.ingest.sentry.io/1',","+      transport: () => ({ send: async () => ({}), flush: async () => true }),","+      tracesSampleRate: 1,","+      tracePropagationTargets: BACKEND_TRACE_PROPAGATION_TARGETS,","+      propagateTraceparent: true,","+      beforeSendTransaction: (event) => {","+        transactions.push(event);","+        return null;","+      },","+      integrations: [","+        Sentry.browserTracingIntegration({","+          instrumentPageLoad: false,","+          instrumentNavigation: false,","+          shouldCreateSpanForRequest,","+        }),","+        consensysTracePropagationIntegration({ log: () => undefined }),","+      ],","+    });","+  });","+","+  afterAll(async () => {","+    await Sentry.close();","+    globalThis.fetch = originalFetch;","+  });","+","+  beforeEach(() => {","+    requests.length = 0;","+    transactions.length = 0;","+  });","+","+  // Starts a phishing list refresh that stays pending until `finish` is","+  // called; `run` executes inside the refresh after its first `await`.","+  function startPhishingRefresh(","+    run: () => Promise<unknown> = async () => undefined,","+  ) {","+    const pending = defer();","+    let traceId = '';","+    const done = updatePhishingLists({","+      isStalelistOutOfDate: () => true,","+      isHotlistOutOfDate: () => false,","+      isC2DomainBlocklistOutOfDate: () => false,","+      maybeUpdateState: async () => {","+        traceId = (Sentry.getActiveSpan() as Sentry.Span).spanContext().traceId;","+        await Promise.resolve();","+        await run();","+        await pending.promise;","+      },","+    });","+    return { done, finish: pending.resolve, traceId: () => traceId };","+  }","+","+  function sentTransaction(name: string): SentryEvent {","+    const event = transactions.find(({ transaction }) => transaction === name);","+    if (!event) {","+      throw new Error(`No ${name} transaction was sent`);","+    }","+    return event;","+  }","+","+  // Whether the traceparent names a span the transaction holds.","+  function namesSpanIn(header: string | undefined, event: SentryEvent) {","+    const { traceId, spanId } = traceparentIds(header);","+    const spanIds = [","+      event.contexts?.trace?.span_id,","+      ...(event.spans ?? []).map(({ span_id: id }) => id),","+    ];","+    return (","+      traceId === event.contexts?.trace?.trace_id && spanIds.includes(spanId)","+    );","+  }","+","+  it('roots a geolocation fetch started while another operation runs', async () => {","+    const phishing = startPhishingRefresh();","+    await Promise.resolve();","+","+    await getGeolocationApiServiceInstanceOptions().fetch?.(GEOLOCATION_URL);","+    phishing.finish();","+    await phishing.done;","+    await Sentry.flush();","+","+    const geolocation = sentTransaction(TraceName.GeolocationFetch);","+    expect(requests).toHaveLength(1);","+    expect(traceparentIds(requests[0].headers.traceparent).traceId).not.toBe(","+      phishing.traceId(),","+    );","+    expect(namesSpanIn(requests[0].headers.traceparent, geolocation)).toBe(","+      true,","+    );","+  });","+","+  it('keeps an unrelated request out of a running operation', async () => {","+    const phishing = startPhishingRefresh();","+    await Promise.resolve();","+","+    await fetch(UNRELATED_URL);","+    phishing.finish();","+    await phishing.done;","+","+    expect(requests).toHaveLength(1);","+    expect(requests[0].headers.traceparent ?? '').not.toContain(","+      phishing.traceId(),","+    );","+  });","+","+  it('leaves no span active when two operations end out of order', async () => {","+    const first = startPhishingRefresh();","+    const second = startPhishingRefresh();","+    await Promise.resolve();","+","+    first.finish();","+    await first.done;","+    expect(Sentry.getActiveSpan()).toBeUndefined();","+    await fetch(UNRELATED_URL);","+","+    second.finish();","+    await second.done;","+    expect(Sentry.getActiveSpan()).toBeUndefined();","+","+    expect(first.traceId()).not.toBe(second.traceId());","+    for (const traceId of [first.traceId(), second.traceId()]) {","+      expect(requests[0].headers.traceparent ?? '').not.toContain(traceId);","+    }","+  });","+","+  it('keeps the phishing list requests sent after an await in the refresh', async () => {","+    const phishing = startPhishingRefresh(async () => {","+      await fetch(METAMASK_STALELIST_URL);","+      await fetch(`${METAMASK_HOTLIST_DIFF_URL}/1700000000`);","+      await fetch(`${C2_DOMAIN_BLOCKLIST_URL}?timestamp=1700000000`);","+    });","+    phishing.finish();","+    await phishing.done;","+    await Sentry.flush();","+","+    const update = sentTransaction(TraceName.PhishingListsUpdate);","+    expect(requests).toHaveLength(3);","+    for (const { headers } of requests) {","+      expect(namesSpanIn(headers.traceparent, update)).toBe(true);","+    }","+  });","+","+  it('keeps a phishing list request out of a running pageload', async () => {","+    // The pageload sits on the base scope, below every operation's scope.","+    const pageload = Sentry.startInactiveSpan({","+      name: '/service-worker.js',","+      forceTransaction: true,","+    });","+    setSpanForScope(getDefaultCurrentScope(), pageload);","+    try {","+      const phishing = startPhishingRefresh(() =>","+        fetch(`${METAMASK_HOTLIST_DIFF_URL}/1700000000`),","+      );","+      phishing.finish();","+      await phishing.done;","+    } finally {","+      setSpanForScope(getDefaultCurrentScope(), undefined);","+      pageload.end();","+    }","+    await Sentry.flush();","+","+    expect(requests).toHaveLength(1);","+    expect(","+      namesSpanIn(","+        requests[0].headers.traceparent,","+        sentTransaction(TraceName.PhishingListsUpdate),","+      ),","+    ).toBe(true);","+    expect(sentTransaction('/service-worker.js').spans ?? []).toHaveLength(0);","+  });","+","+  it('keeps the supported-networks request sent after an await in its root', async () => {","+    const accounts = {","+      // The client awaits its bearer token before it fetches.","+      fetchV2SupportedNetworks: async () => {","+        await Promise.resolve();","+        return fetch(SUPPORTED_NETWORKS_URL);","+      },","+    };","+    traceSupportedNetworksFetches(accounts);","+    const phishing = startPhishingRefresh();","+    await Promise.resolve();","+","+    await accounts.fetchV2SupportedNetworks();","+    phishing.finish();","+    await phishing.done;","+    await Sentry.flush();","+","+    expect(requests).toHaveLength(1);","+    expect(","+      namesSpanIn(","+        requests[0].headers.traceparent,","+        sentTransaction(TraceName.AccountsApiSupportedNetworksFetch),","+      ),","+    ).toBe(true);","+  });","+","+  it('keeps a ramps request sent after an await in Ramps Init', async () => {","+    const rampsFetch = rampsInitTrace.bindFetch(fetch);","+","+    await rampsInitTrace.run(async () => {","+      await Promise.resolve();","+      await rampsFetch(COUNTRIES_URL);","+    });","+    await rampsFetch(COUNTRIES_URL);","+    await Sentry.flush();","+","+    const rampsInit = sentTransaction(TraceName.RampsInit);","+    expect(requests).toHaveLength(2);","+    expect(namesSpanIn(requests[0].headers.traceparent, rampsInit)).toBe(true);","+    expect(requests[1].headers.traceparent).toBeUndefined();","+  });","+","+  it('lets a ramps request join a later parent once a sampled-out Ramps Init settles', async () => {","+    const options = Sentry.getClient()?.getOptions() as {","+      tracesSampleRate?: number;","+    };","+    const rampsFetch = rampsInitTrace.bindFetch(fetch);","+","+    options.tracesSampleRate = 0;","+    try {","+      await rampsInitTrace.run(async () => {","+        await Promise.resolve();","+      });","+    } finally {","+      options.tracesSampleRate = 1;","+    }","+    const laterTraceId = await Sentry.startSpan(","+      { name: 'later parent', forceTransaction: true },","+      async (span) => {","+        await rampsFetch(COUNTRIES_URL);","+        return span.spanContext().traceId;","+      },","+    );","+","+    expect(requests).toHaveLength(1);","+    expect(traceparentIds(requests[0].headers.traceparent).traceId).toBe(","+      laterTraceId,","+    );","+  });","+","+  it('lets a ramps request join a later parent once Ramps Init settles with tracing disabled', async () => {","+    const options = Sentry.getClient()?.getOptions() as {","+      tracesSampleRate?: number;","+    };","+    const rampsFetch = rampsInitTrace.bindFetch(fetch);","+","+    options.tracesSampleRate = undefined;","+    try {","+      await rampsInitTrace.run(async () => {","+        await Promise.resolve();","+      });","+    } finally {","+      options.tracesSampleRate = 1;","+    }","+    const laterTraceId = await Sentry.startSpan(","+      { name: 'later parent', forceTransaction: true },","+      async (span) => {","+        await rampsFetch(COUNTRIES_URL);","+        return span.spanContext().traceId;","+      },","+    );","+","+    expect(requests).toHaveLength(1);","+    expect(traceparentIds(requests[0].headers.traceparent).traceId).toBe(","+      laterTraceId,","+    );","+  });","+","+  it('keeps an explicit parent while an operation runs', async () => {","+    const phishing = startPhishingRefresh();","+    await Promise.resolve();","+    const parent = Sentry.startInactiveSpan({ name: 'parent' });","+","+    const parentSpanId = trace(","+      { name: TraceName.GeolocationFetch, parentContext: parent },","+      () => Sentry.spanToJSON(Sentry.getActiveSpan() as Sentry.Span),","+    ).parent_span_id;","+    parent.end();","+    phishing.finish();","+    await phishing.done;","+","+    expect(parentSpanId).toBe(parent.spanContext().spanId);","+  });","+});"],"additions":349,"deletions":0,"truncated":false},{"path":"app/scripts/lib/ended-active-span.integration.test.ts","lines":["@@ -0,0 +1,142 @@","+import * as Sentry from '@sentry/browser';","+import {","+  _INTERNAL_setSpanForScope as setSpanForScope,","+  getDefaultCurrentScope,","+} from '@sentry/core';","+import { trace, TraceName } from '../../../shared/lib/trace';","+import { shouldCreateSpanForRequest } from './setupSentry';","+import {","+  BACKEND_TRACE_PROPAGATION_TARGETS,","+  consensysTracePropagationIntegration,","+} from './sentry-trace-propagation';","+import { withOwnRootTrace } from './own-root-trace';","+","+const BACKEND_URL = 'https://client-config.api.cx.metamask.io/v1/flags';","+","+// The browser SDK's scope stack pops in settlement order, not push order: when","+// a root settles before a root started after it, the first root's span stays","+// active after it has ended, until the second settles.","+describe('work under an ended active span (real SDK)', () => {","+  const requestHeaders: Record<string, string>[] = [];","+  const originalFetch = globalThis.fetch;","+  let releaseLater: () => void;","+  let later: Promise<void>;","+","+  beforeAll(() => {","+    // Wrapped once per process by the SDK, so installed before the first init.","+    globalThis.fetch = jest.fn(async (_input, init?: RequestInit) => {","+      requestHeaders.push(Object.fromEntries(new Headers(init?.headers)));","+      return new Response('{}', { status: 200 });","+    }) as typeof fetch;","+  });","+","+  afterAll(() => {","+    globalThis.fetch = originalFetch;","+  });","+","+  beforeEach(() => {","+    requestHeaders.length = 0;","+    // Lets `Sentry.init` run in jsdom, which it takes for an embedded extension.","+    (globalThis as { nw?: object }).nw = {};","+    performance.getEntriesByType ??= () => [];","+    (globalThis as { sentry?: unknown }).sentry = Sentry;","+    Sentry.init({","+      dsn: 'https://public@example.ingest.sentry.io/1',","+      transport: () => ({ send: async () => ({}), flush: async () => true }),","+      tracesSampleRate: 1,","+      tracePropagationTargets: BACKEND_TRACE_PROPAGATION_TARGETS,","+      propagateTraceparent: true,","+      integrations: [","+        Sentry.browserTracingIntegration({","+          instrumentPageLoad: false,","+          instrumentNavigation: false,","+          shouldCreateSpanForRequest,","+        }),","+        consensysTracePropagationIntegration({ log: () => undefined }),","+      ],","+    });","+  });","+","+  afterEach(async () => {","+    releaseLater?.();","+    await later;","+    await Sentry.close();","+  });","+","+  // Leaves the earlier root's span active and ended; returns its trace id.","+  async function endEarlierRootFirst(): Promise<string> {","+    let releaseEarlier: () => void = () => undefined;","+    let earlierTraceId = '';","+    const earlier = trace(","+      { name: TraceName.RampsInit, root: true },","+      (span) =>","+        new Promise<void>((resolve) => {","+          earlierTraceId = (span as Sentry.Span).spanContext().traceId;","+          releaseEarlier = resolve;","+        }),","+    );","+    later = trace(","+      { name: TraceName.PhishingListsUpdate, root: true },","+      () =>","+        new Promise<void>((resolve) => {","+          releaseLater = resolve;","+        }),","+    );","+    releaseEarlier();","+    await earlier;","+","+    const active = Sentry.getActiveSpan() as Sentry.Span;","+    expect(active.spanContext().traceId).toBe(earlierTraceId);","+    expect(Sentry.spanToJSON(active).timestamp).toBeDefined();","+    return earlierTraceId;","+  }","+","+  it('sends no trace headers naming the ended span', async () => {","+    const endedTraceId = await endEarlierRootFirst();","+","+    await fetch(BACKEND_URL);","+","+    expect(requestHeaders).toHaveLength(1);","+    expect(requestHeaders[0].traceparent ?? '').not.toContain(endedTraceId);","+    expect(requestHeaders[0]['sentry-trace']).toBeUndefined();","+  });","+","+  it('names the running pageload when the active span has ended', async () => {","+    // The pageload sits on the base scope, below every operation's scope.","+    const pageload = Sentry.startInactiveSpan({","+      name: '/service-worker.js',","+      forceTransaction: true,","+    });","+    setSpanForScope(getDefaultCurrentScope(), pageload);","+    const endedTraceId = await endEarlierRootFirst();","+","+    try {","+      await fetch(BACKEND_URL);","+    } finally {","+      setSpanForScope(getDefaultCurrentScope(), undefined);","+      pageload.end();","+    }","+","+    const pageloadTraceId = pageload.spanContext().traceId;","+    expect(pageloadTraceId).not.toBe(endedTraceId);","+    expect(requestHeaders).toHaveLength(1);","+    expect(requestHeaders[0].traceparent).toContain(pageloadTraceId);","+    expect(requestHeaders[0]['sentry-trace']).toContain(pageloadTraceId);","+    expect(requestHeaders[0].baggage).toContain('consensys-request-id=');","+  });","+","+  it('starts an operation as its own root', async () => {","+    const endedTraceId = await endEarlierRootFirst();","+    let rootName: string | undefined;","+","+    await withOwnRootTrace(TraceName.GeolocationFetch, async () => {","+      const span = Sentry.getActiveSpan() as Sentry.Span;","+      rootName = Sentry.spanToJSON(Sentry.getRootSpan(span)).description;","+      await fetch(BACKEND_URL);","+    })();","+","+    expect(rootName).toBe(TraceName.GeolocationFetch);","+    expect(requestHeaders[0].traceparent).toMatch(/^00-[0-9a-f]{32}-/u);","+    expect(requestHeaders[0].traceparent).not.toContain(endedTraceId);","+  });","+});"],"additions":142,"deletions":0,"truncated":false},{"path":"app/scripts/lib/own-root-trace.test.ts","lines":["@@ -0,0 +1,57 @@","+import { readFileSync } from 'fs';","+import path from 'path';","+import { TraceName } from '../../../shared/lib/trace';","+import { runAsOwnRoot } from './own-root-trace';","+","+const globals = globalThis as { sentry?: unknown };","+","+describe('runAsOwnRoot', () => {","+  afterEach(() => {","+    delete globals.sentry;","+  });","+","+  it('imports no span function from the SDK', () => {","+    // The background bundles its own SDK copy, which has no client, so a root","+    // started on it is never sent. Jest loads one copy and cannot show this.","+    const source = readFileSync(","+      path.join(__dirname, 'own-root-trace.ts'),","+      'utf8',","+    );","+    expect(source).not.toMatch(/from '@sentry\\/browser'/u);","+    const coreImports =","+      source.match(/import \\{([^}]*)\\} from '@sentry\\/core'/u)?.[1] ?? '';","+    expect(coreImports).not.toMatch(","+      /\\b(start\\w*|withActiveSpan|spanToJSON|getActiveSpan)\\b/u,","+    );","+  });","+","+  it('starts the root on the instance at `globalThis.sentry`', () => {","+    const span = { end: jest.fn(), setStatus: jest.fn() };","+    const sentry = {","+      startNewTrace: jest.fn((callback: () => unknown) => callback()),","+      startInactiveSpan: jest.fn(() => span),","+      withActiveSpan: jest.fn((_span: unknown, callback: () => unknown) =>","+        callback(),","+      ),","+    };","+    globals.sentry = sentry;","+","+    expect(runAsOwnRoot(TraceName.GeolocationFetch, (root) => root)).toBe(span);","+    expect(sentry.startInactiveSpan).toHaveBeenCalledWith({","+      name: TraceName.GeolocationFetch,","+      op: 'custom',","+      parentSpan: null,","+    });","+    expect(sentry.withActiveSpan).toHaveBeenCalledWith(","+      span,","+      expect.any(Function),","+    );","+    expect(span.end).toHaveBeenCalledTimes(1);","+  });","+","+  it('runs the operation untraced when no instance is installed', () => {","+    expect(runAsOwnRoot(TraceName.GeolocationFetch, () => 'result')).toBe(","+      'result',","+    );","+  });","+});"],"additions":57,"deletions":0,"truncated":false},{"path":"app/scripts/lib/own-root-trace.ts","lines":["@@ -0,0 +1,158 @@","+import {","+  SentryNonRecordingSpan,","+  SPAN_STATUS_ERROR,","+  type Span,","+} from '@sentry/core';","+import type { TraceName } from '../../../shared/lib/trace';","+import { claimBackendRequests } from './sentry-trace-propagation';","+","+// The service worker has no async context: the SDK keeps one scope stack and","+// pops it when a callback settles, so a span left as the active span across an","+// `await` parents whatever starts meanwhile. A root here is therefore the","+// active span only while its own code runs synchronously.","+","+// The background bundles its own copy of the SDK, which has no client:","+// `Sentry.init` runs in `sentry-install`. Spans therefore start on the","+// initialized instance at `globalThis.sentry`, as in `shared/lib/trace.ts`.","+// Without it, a root is a non-recording span and `fn` runs as if untraced.","+","+function startRoot(name: TraceName): Span {","+  const startNewTrace = globalThis.sentry?.startNewTrace;","+  const startInactiveSpan = globalThis.sentry?.startInactiveSpan;","+  if (!startNewTrace || !startInactiveSpan) {","+    return new SentryNonRecordingSpan();","+  }","+  return startNewTrace(() =>","+    startInactiveSpan({ name, op: 'custom', parentSpan: null }),","+  );","+}","+","+function runWithActiveSpan<Result>(span: Span, fn: () => Result): Result {","+  const withActiveSpan = globalThis.sentry?.withActiveSpan;","+  if (!withActiveSpan) {","+    return fn();","+  }","+  // Boxed so the scope is popped on return, not when a returned promise settles.","+  return withActiveSpan(span, () => ({ result: fn() })).result;","+}","+","+function endWithError(span: Span): void {","+  span.setStatus({ code: SPAN_STATUS_ERROR, message: 'internal_error' });","+  span.end();","+}","+","+/**","+ * Run `fn` as the root of a trace of its own, regardless of the active span.","+ * The root is the active span while `fn` runs synchronously, and ends when its","+ * result settles.","+ *","+ * @param name - The root's transaction name.","+ * @param fn - The operation, given its root span.","+ * @returns The result of `fn`.","+ */","+export function runAsOwnRoot<Result>(","+  name: TraceName,","+  fn: (span: Span) => Result,","+): Result {","+  const span = startRoot(name);","+  let result: Result;","+  try {","+    result = runWithActiveSpan(span, () => fn(span));","+  } catch (error) {","+    endWithError(span);","+    throw error;","+  }","+  if (!(result instanceof Promise)) {","+    span.end();","+    return result;","+  }","+  return result.then(","+    (value) => {","+      span.end();","+      return value;","+    },","+    (error) => {","+      endWithError(span);","+      throw error;","+    },","+  ) as Result;","+}","+","+/**","+ * Run `fn` as the root of a trace of its own, for an operation whose requests","+ * leave from code that has awaited and calls the global `fetch`: while the","+ * root runs, a backend request whose URL `claims` accepts is sent under it.","+ *","+ * @param name - The root's transaction name.","+ * @param claims - Whether a request URL belongs to the operation.","+ * @param fn - The operation.","+ * @returns The result of `fn`.","+ */","+export function runAsOwnRootClaiming<Result>(","+  name: TraceName,","+  claims: (url: string) => boolean,","+  fn: () => Promise<Result>,","+): Promise<Result> {","+  return runAsOwnRoot(name, (span) => {","+    const release = claimBackendRequests(span, claims);","+    return fn().finally(release);","+  });","+}","+","+/**","+ * Wrap `fn` so each call runs as the root of a trace of its own.","+ *","+ * @param name - The root's transaction name.","+ * @param fn - The function to wrap; its requests must start synchronously.","+ * @returns The wrapped function.","+ */","+export function withOwnRootTrace<Args extends unknown[], Result>(","+  name: TraceName,","+  fn: (...args: Args) => Result,","+): (...args: Args) => Result {","+  return (...args) => runAsOwnRoot(name, () => fn(...args));","+}","+","+/**","+ * A root whose later requests leave from code that has awaited since the root","+ * stopped being the active span. `bindFetch` gives that code a `fetch` that","+ * sends a request under the root while the root runs.","+ *","+ * @param name - The root's transaction name.","+ * @returns `run`, which runs an operation as the root, and `bindFetch`.","+ */","+export function createOwnRoot(name: TraceName) {","+  let current: Span | undefined;","+  return {","+    run<Result>(fn: () => Result): Result {","+      return runAsOwnRoot(name, (span) => {","+        current = span;","+        // Released on settle rather than read off the span, because a span","+        // with tracing disabled is a non-recording span that never ends.","+        const release = () => {","+          if (current === span) {","+            current = undefined;","+          }","+        };","+        let result: Result;","+        try {","+          result = fn();","+        } catch (error) {","+          release();","+          throw error;","+        }","+        if (result instanceof Promise) {","+          return result.finally(release) as Result;