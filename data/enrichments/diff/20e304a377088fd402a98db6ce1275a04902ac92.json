ch/types'","+","+let client: SupabaseClient<Database> | undefined","+function searchClient() {","+  client ??= createClient<Database>(","+    process.env.SUPABASE_URL!,","+    process.env.SUPABASE_SERVICE_ROLE_KEY!,","+    { auth: { autoRefreshToken: false, persistSession: false, detectSessionInUrl: false } }","+  )","+  return client","+}","+","+/** Fetches the markdown export of a page (`<href>.md`); null if it can't be loaded. */","+async function fetchContent(href: string): Promise<string | null> {","+  try {","+    const response = await fetch(`${href}.md`)","+    if (!response.ok) {","+      console.warn(`Failed to fetch kb content from ${href}.md: ${response.status}`)","+      return null","+    }","+    return await response.text()","+  } catch (error) {","+    console.warn(`Failed to fetch kb content from ${href}.md:`, error)","+    return null","+  }","+}","+","+export function OPTIONS() {","+  return new Response(null, { headers: corsHeaders })","+}","+","+export async function GET(request: Request) {","+  const { searchParams } = new URL(request.url)","+  const query = searchParams.get('q')?.trim()","+  const limit = Number(searchParams.get('limit')) || 10","+  const includeContent = searchParams.get('content') === 'true'","+  if (!query)","+    return Response.json({ error: 'Missing q parameter' }, { status: 400, headers: corsHeaders })","+","+  const { data, error } = await searchClient().rpc('search_kb', {","+    query_text: query,","+    match_limit: limit,","+  })","+  if (error) {","+    console.error('Error running kb search:', error)","+    return Response.json(","+      { error: 'There was an error processing your request' },","+      { status: 500, headers: corsHeaders }","+    )","+  }","+","+  let results: KbSearchResult[] = data.map((row) => ({","+    title: row.page_title,","+    href: `https://supabase.com/${row.slug.toLowerCase()}`,","+    heading: row.heading,","+    excerpt: row.excerpt,","+    score: row.score,","+  }))","+","+  if (includeContent) {","+    results = await Promise.all(","+      results.map(async (result) => ({ ...result, content: await fetchContent(result.href) }))","+    )","+  }","+","+  return Response.json(results, {","+    headers: {","+      ...corsHeaders,","+      'Cache-Control': 'public, s-maxage=3600, stale-while-revalidate=300',","+    },","+  })","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"apps/kb/package.json","lines":["@@ -11,6 +11,8 @@","     \"build\": \"astro build\",","     \"fetch:federated-content\": \"tsx ./scripts/federated-content/fetch-federated-content.ts\",","     \"generate:markdown\": \"tsx ./scripts/generate-markdown.mjs\",","+    \"presearch:ingest\": \"pnpm run fetch:federated-content && pnpm run generate:markdown\",","+    \"search:ingest\": \"tsx ./scripts/search/ingest.ts\",","     \"sync:legacy-slugs\": \"tsx ./scripts/federated-content/backfill-legacy-slugs.ts\",","     \"sync:troubleshooting-entries\": \"tsx ./scripts/federated-content/sync-troubleshooting-entries.ts\",","     \"sync:troubleshooting-updates\": \"tsx ./scripts/federated-content/sync-troubleshooting-updates.ts\",","@@ -29,6 +31,7 @@","     \"@supabase/supabase-js\": \"catalog:\",","     \"astro\": \"^7.2.6\",","     \"common\": \"workspace:*\",","+    \"docs-search\": \"workspace:*\",","     \"gray-matter\": \"^4.0.3\",","     \"lucide-react\": \"catalog:\",","     \"react\": \"catalog:\","],"additions":3,"deletions":0,"truncated":false},{"path":"apps/kb/scripts/search/ingest.ts","lines":["@@ -0,0 +1,26 @@","+import '../utils/dotenv.js'","+","+import path from 'node:path'","+import { createClient } from '@supabase/supabase-js'","+import { ingestMarkdown } from 'docs-search/ingest'","+","+import { TABLE_NAME } from './supabase.js'","+","+const { SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY } = process.env","+if (!SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) {","+  console.error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY. Set them in .env.local.')","+  process.exit(1)","+}","+","+ingestMarkdown({","+  supabase: createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, {","+    auth: { autoRefreshToken: false, persistSession: false },","+  }),","+  table: TABLE_NAME,","+  contentRoot: path.resolve(process.cwd(), 'public/markdown'),","+  include: ['**/*.md'],","+  slugPrefix: 'kb/',","+}).catch((err) => {","+  console.error(err instanceof Error ? err.message : err)","+  process.exit(1)","+})"],"additions":26,"deletions":0,"truncated":false},{"path":"apps/kb/scripts/search/supabase.ts","lines":["@@ -0,0 +1 @@","+export const TABLE_NAME = 'kb_search'"],"additions":1,"deletions":0,"truncated":false},{"path":"apps/kb/src/lib/search/cors.ts","lines":["@@ -0,0 +1,5 @@","+export const corsHeaders = {","+  'Access-Control-Allow-Origin': '*',","+  'Access-Control-Allow-Methods': 'GET, OPTIONS',","+  'Access-Control-Allow-Headers': 'content-type',","+}"],"additions":5,"deletions":0,"truncated":false},{"path":"apps/kb/src/lib/search/types.ts","lines":["@@ -0,0 +1,33 @@","+export interface KbSearchRow {","+  slug: string","+  page_title: string","+  heading: string","+  heading_level: number","+  heading_path: string[]","+  excerpt: string","+  score: number","+}","+","+export interface KbSearchResult {","+  title: string","+  href: string","+  heading: string","+  excerpt: string","+  score: number","+  content?: string | null","+}","+","+export type Database = {","+  public: {","+    Tables: Record<string, never>","+    Views: Record<string, never>","+    Functions: {","+      search_kb: {","+        Args: { query_text: string; match_limit?: number }","+        Returns: KbSearchRow[]","+      }","+    }","+    Enums: Record<string, never>","+    CompositeTypes: Record<string, never>","+  }","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"package.json","lines":["@@ -27,7 +27,7 @@","     \"test:case-hazards\": \"node scripts/check-case-hazards.mjs\",","     \"test:prettier\": \"SORT_IMPORTS=false prettier --config prettier