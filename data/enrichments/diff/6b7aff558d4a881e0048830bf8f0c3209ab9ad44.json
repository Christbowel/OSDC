engine reads no system","+     * properties: the Quarkus platform, the Camel Spring Boot version, and the repositories (camel.jbang.repos) when","+     * none are configured. The extra default repositories of the camel.extra.repos system property are left to the","+     * Maven downloader.","+     */","+    static void applySystemProperties(ExportRequest request) {","+        request.quarkusPlatform = QuarkusPlatform.of(System.getProperties(), request.quarkusPlatform);","+        request.camelSpringBootVersion","+                = PropertyResolver.fromSystemProperty(CAMEL_SPRING_BOOT_VERSION, () -> request.camelSpringBootVersion);","+        MavenResolver resolver = request.mavenResolver;","+        String repos = System.getProperty(REPOS);","+        if (resolver.repos() == null && repos != null) {","+            request.mavenResolver = new MavenResolver(resolver.download(), repos, resolver.fresh(), resolver.extraRepos());","+        }","+    }","+","     protected void addDependencies(String... deps) {","         var depsArray = Optional.ofNullable(deps).orElse(new String[0]);","         dependencies.addAll(Arrays.asList(depsArray));"],"additions":19,"deletions":0,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/main/java/org/apache/camel/dsl/jbang/core/commands/MavenResolverMixin.java","lines":["@@ -43,6 +43,9 @@ public class MavenResolverMixin implements MavenResolverMixinSpec {","                         defaultValue = \"false\")","     boolean fresh;"," ","+    // not an option: set by an export through the Java API, else the camel.extra.repos system property is in use","+    String extraRepos;","+","     private volatile MavenResolver resolver;","     private final Object resolverLock = new Object();"," ","@@ -52,6 +55,7 @@ public static MavenResolverMixin of(Properties props, MavenResolverMixinSpec fal","                 = Boolean.parseBoolean(props.getProperty(CamelJBangConstants.DOWNLOAD, String.valueOf(fallback.download())));","         re