coration. Each argument is rounded up to the pointer width.","+fn windows_abi_argument_byte_sum<'tcx>(args: &[ArgAbi<'tcx, Ty<'tcx>>], target: &Target) -> u64 {","+    let pointer_bytes = target.pointer_width as u64 / 8;","+","+    args.iter().map(|arg| arg.layout.size.bytes().next_multiple_of(pointer_bytes)).sum()","+}","+","+/// Computes the linker-visible decorated symbol name for supported Windows","+/// calling conventions using the original `FnAbi` argument layouts.","+/// Vectorcall is also decorated on non-Windows targets.","+///","+/// The byte count is computed before backend-specific argument lowering,","+/// which may replace indirectly passed arguments with pointers.","+///","+/// For example, on 32-bit Windows, `extern \"fastcall\" fn foo(i32, i32)`","+/// is decorated as `@foo@8`. On 64-bit targets,","+/// `extern \"vectorcall\" fn foo(i32)` is decorated as `foo@@8`.","+///","+/// Returns `None` if no decoration is required or if the name begins with","+/// `\\x01` or `?`, indicating that it must not be decorated further.","+///","+/// This function does not add LLVM's `\\x01` escape prefix. Backend-specific","+/// handling of that marker is the responsibility of the caller.","+pub fn windows_calling_convention_name<'tcx>(","+    target: &Target,","+    conv: CanonAbi,","+    name: &str,","+    args: &[ArgAbi<'tcx, Ty<'tcx>>],","+) -> Option<String> {","+    if !target.is_like_windows && conv != CanonAbi::X86(X86Call::Vectorcall) {","+        return None;","+    }","+","+    if name.starts_with('\\x01') || name.starts_with('?') {","+        return None;","+    }","+","+    let (prefix, suffix) = match (&target.arch, conv) {","+        (Arch::X86, CanonAbi::X86(X86Call::Fastcall)) => (\"@\", \"@\"),","+        (Arch::X86, CanonAbi::X86(X86Call::Stdcall)) => (\"_\", \"@\"),","+        (Arch::X86 | Arch::X86_64, CanonAbi::X86(X86Call::Vectorcall)) => (\"\", \"@@\"),","+        _ => return None,","+    };","+","+    let args_in_bytes = windows_abi_argument_byte_sum(args, target);","+    Some(format!(\"{prefix}{name}{suffix}{args_in_bytes}\"))","+}","+"," pub fn i686_decorated_name(","     dll_import: &DllImport,","     mingw: bool,"],"additions":53,"deletions":2,"truncated":false},{"path":"tests/assembly-llvm/win32-byte-count-suffix.rs","lines":["@@ -249,9 +249,8 @@ extern \"vectorcall\" fn eight_vectors_vectorcall("," ) {"," }"," ","-/// FIXME: the mangled name for this type is incorrect on msvc, where the argument is passed","-/// indirectly and a pointer takes up 4 bytes, but clang counts the size of the type and uses","-/// @8 there. With GNU the value is passed directly, so the suffix is correct.","+// MSVC passes this argument indirectly, but the decoration uses the","+// original 8-byte type size rather than the 4-byte pointer size."," #[repr(C, align(8))]"," struct OverAligned(u32, u32);"," ","@@ -260,16 +259,16 @@ struct OverAligned(u32, u32);"," extern \"C\" fn overaligned(_: OverAligned) {}"," "," // windows-gnu-LABEL: _overaligned_stdcall@8:","-// windows-msvc-LABEL: _overaligned_stdcall@4:","+// windows-msvc-LABEL: _overaligned_stdcall@8:"," #[unsafe(no_mangle)]"," extern \"stdcall\" fn overaligned_stdcall(_: OverAligned) {}"," "," // windows-gnu-LABEL: @overaligned_fastcall@8:","-// windows-msvc-LABEL: @overaligned_fastcall@4:","+// windows-msvc-LABEL: @overaligned_fastcall@8:"," #[unsafe(no_mangle)]"," extern \"fastcall\" fn overaligned_fastcall(_: OverAligned) {}"," "," // windows-gnu-LABEL: overaligned_vectorcall@@8:","-// windows-msvc-LABEL: overaligned_vectorcall@@4:","+// windows-msvc-LABEL: overaligned_vectorcall@@8:"," #[unsafe(no_mangle)]"," extern \"vectorcall\" fn overaligned_vectorcall(_: OverAligned) {}"],"additions":5,"deletions":6,"truncated":false},{"path":"tests/codegen-llvm/abi-x86_64-win-zst.rs","lines":["@@ -43,15 +43,15 @@ extern \"win64\" fn pass_c_maybezst_win64(_: CMaybeZst) {}"," #[no_mangle]"," extern \"win64\" fn pass_c_maybezst_2_win64(_: CMaybeZst2) {}"," ","-// CHECK: defi