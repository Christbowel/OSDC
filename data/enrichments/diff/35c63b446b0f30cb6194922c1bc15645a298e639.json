ility = [\"//visibility:public\"],","+)"],"additions":17,"deletions":0,"truncated":false},{"path":"tools/git/defs.bzl","lines":["@@ -0,0 +1,23 @@","+\"\"\"Targets exposing the hermetic git toolchain, so nothing depends on a host `git`.\"\"\"","+","+load(\"@envoy_toolshed//git:defs.bzl\", \"GIT_TOOLCHAIN_TYPE\")","+","+def _git_runtime_impl(ctx):","+    git_info = ctx.toolchains[GIT_TOOLCHAIN_TYPE].git","+    files = git_info.runfiles.merge(ctx.runfiles(files = [git_info.git])).files","+    return [DefaultInfo(files = files)]","+","+git_runtime = rule(","+    implementation = _git_runtime_impl,","+    doc = \"Exposes the resolved git toolchain runtime files, for `$(GIT)` consumers.\",","+    toolchains = [GIT_TOOLCHAIN_TYPE],","+)","+","+def _git_bin_impl(ctx):","+    return [DefaultInfo(files = depset([ctx.toolchains[GIT_TOOLCHAIN_TYPE].git.git]))]","+","+git_bin = rule(","+    implementation = _git_bin_impl,","+    doc = \"Exposes just the resolved git toolchain executable, eg to resolve `GIT_BIN` in CI.\",","+    toolchains = [GIT_TOOLCHAIN_TYPE],","+)"],"additions":23,"deletions":0,"truncated":false},{"path":"tools/git/last_github_commit.sh","lines":["@@ -5,4 +5,4 @@"," # heuristic, e.g. when patches are manually merged for security fixes on main, but this is very"," # rare."," ","-git rev-list --no-merges --committer=\"GitHub <noreply@github.com>\" --max-count=1 HEAD","+\"${GIT_BIN:-git}\" rev-list --no-merges --committer=\"GitHub <noreply@github.com>\" --max-count=1 HEAD"],"additions":1,"deletions":1,"truncated":false},{"path":"tools/git/modified_since_last_github_commit.sh","lines":["@@ -7,4 +7,4 @@ declare -r EXTENSION=$2"," export TARGET_PATH"," "," ","-git diff --name-only \"$(\"${BASE}\"/last_github_commit.sh)\" | grep \"\\.${EXTENSION}$\"","+\"${GIT_BIN:-git}\" diff --name-only \"$(\"${BASE}\"/last_github_commit.sh)\" | grep \"\\.${EXTENSION}$\""],"additions":1,"deletions":1,"truncated":false},{"path":"tools/proto_format/BUILD","lines":["@@ -6,6 +6,10 @@ 