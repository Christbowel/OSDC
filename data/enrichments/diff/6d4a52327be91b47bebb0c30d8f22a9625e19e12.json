, String>,"," }"," "," impl WebLogins {","     pub(super) fn prune(&mut self, now: i64) {","-        let poll_to_browser = &mut self.poll_to_browser;","+        let poll_to_login = &mut self.poll_to_login;","+        let code_to_login = &mut self.code_to_login;","         self.entries.retain(|_, entry| {","             if entry.expires <= now {","-                poll_to_browser.remove(&entry.poll_hash);","+                poll_to_login.remove(&entry.poll_hash);","+                code_to_login.remove(&entry.code_hash);","                 false","             } else {","                 true","@@ -39,11 +56,13 @@ impl WebLogins {","     }"," }"," ","-/// The two secrets issued for a CLI web login flow.","+/// What the CLI receives for a web login: the secret it polls with, and the","+/// code the user types in the browser."," #[derive(Debug, Clone, PartialEq, Eq)]"," pub struct WebLoginTokens {","-    pub browser_session_id: String,","     pub poll_token: String,","+    /// Formatted as `XXXX-XXXX`.","+    pub user_code: String,"," }"," "," #[derive(Debug, Clone, PartialEq, Eq)]","@@ -56,45 +75,89 @@ pub enum WebLoginPoll {"," impl OidcState {","     /// Creates a pending web login session for the CLI web login flow.","     pub fn create_web_login(&self) -> Result<WebLoginTokens> {","-        let browser_session_id = random_secret()?;","+        let login_id = random_secret()?;","         let poll_token = random_secret()?;","+        let letters = random_user_code_letters()?;","         let now = Utc::now().timestamp();","         let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","         logins.prune(now);","         if logins.entries.len() >= MAX_ENTRIES {","             return Err(unavailable());","         }","-        let expires = now + WEB_LOGIN_TTL.as_secs() as i64;","-        let browser_hash = super::super::sha256_hex(browser_session_id.as_bytes());","+        let code_hash = super::super::sha256_hex(letters.as_by