{"id":"6d4a52327be91b47bebb0c30d8f22a9625e19e12","axis":"silent","repo":"pnpm/pnpm","sha":"6d4a52327be91b47bebb0c30d8f22a9625e19e12","parsed":{"files":[{"path":".changeset/login-prints-npm-notice.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/auth.commands\": patch","+\"pnpm\": patch","+---","+","+`pnpm login` now prints the registry's `npm-notice` message before the web login URL. Some registries use it to show a code that you type in the browser."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/pnpr-confirm-web-login.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+`pnpm login` and `npm login` against pnpr now print a code that the user types in the browser before signing in. A login link alone can no longer sign anyone in.","+","+A token created without a password, by an account that has none, now expires no later than the session or token that created it. It also stays within that credential's CIDR whitelist."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -828,6 +828,7 @@ snapshots:"," \t\t\t\t\"@pnpm/network.fetch\": \"workspace:*\","," \t\t\t\t\"@pnpm/network.web-auth\": \"workspace:*\","," \t\t\t\t\"@pnpm/registry-access.client\": \"workspace:*\",","+\t\t\t\t\"@pnpm/text.sanitize\": \"workspace:*\","," \t\t\t\t\"normalize-registry-url\": \"catalog:\","," \t\t\t\t\"read-ini-file\": \"catalog:\","," \t\t\t\t\"render-help\": \"catalog:\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm11/auth/commands/package.json","lines":["@@ -39,6 +39,7 @@","     \"@pnpm/network.fetch\": \"workspace:*\",","     \"@pnpm/network.web-auth\": \"workspace:*\",","     \"@pnpm/registry-access.client\": \"workspace:*\",","+    \"@pnpm/text.sanitize\": \"workspace:*\",","     \"normalize-registry-url\": \"catalog:\",","     \"read-ini-file\": \"catalog:\",","     \"render-help\": \"catalog:\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm11/auth/commands/src/login.ts","lines":["@@ -18,6 +18,7 @@ import {","   withOtpHandling,"," } from '@pnpm/network.web-auth'"," import { addUser, AddUserHttpError, AddUserNoTokenError } from '@pnpm/registry-access.client'","+import { sanitizeInline } from '@pnpm/text.sanitize'"," import normalizeRegistryUrl from 'normalize-registry-url'"," import { readIniFile } from 'read-ini-file'"," import { renderHelp } from 'render-help'","@@ -215,6 +216,21 @@ function readUrlField (body: unknown, field: 'loginUrl' | 'doneUrl'): string | u","  * Whether `url` contains a Unicode control character (the C0 controls, DEL,","  * or the C1 controls) — the same set pacquet rejects via `char::is_control`.","  */","+/**","+ * Prints the registry's `npm-notice` header, such as the code a web login asks","+ * the user to type in the browser. The text is registry-controlled, so control","+ * and formatting characters are removed first, and a notice that is empty","+ * afterwards is skipped.","+ */","+function reportNotices (headers: LoginFetchResponseHeaders, globalInfo: (message: string) => void): void {","+  const notice = headers.get('npm-notice')","+  if (notice == null) return","+  const sanitized = sanitizeInline(notice)","+  if (sanitized !== '') {","+    globalInfo(sanitized)","+  }","+}","+"," function containsControlCharacters (url: string): boolean {","   for (const char of url) {","     const codePoint = char.codePointAt(0) ?? 0","@@ -286,6 +302,8 @@ async function webLogin ({","     throw new UnsafeLoginUrlError()","   }"," ","+  reportNotices(response.headers, globalInfo)","+","   // A non-TTY stdout (a CI log, a pipe) cannot render the QR code block, so","   // print the URL on its own.","   globalInfo(process.stdout.isTTY"],"additions":18,"deletions":0,"truncated":false},{"path":"pnpm11/auth/commands/test/login.test.ts","lines":["@@ -63,6 +63,7 @@ const createMockResponse = (init: {","     },","     headers: init.headers ?? {","       get: name => {","+        if (name === 'npm-notice') return null","         throw new Error(`Unexpected call to headers.get: ${name}`)","       },","     },","@@ -82,6 +83,10 @@ const createMockContext = (overrides?: MockContextOverrides): LoginContext => ({","   },"," })"," ","+const NOTICE_HEADERS: LoginFetchResponse['headers'] = {","+  get: name => name === 'npm-notice' ? 'Enter the code \\u001b[31m1234-5678\\u001b[0m' : null,","+}","+"," const OTP_CHALLENGE_HEADERS: LoginFetchResponse['headers'] = {","   get: (name: string) => name === 'www-authenticate' ? 'OTP otp' : null,"," }","@@ -229,6 +234,39 @@ describe('login', () => {","     ])","   })"," ","+  it('should print the sanitized npm-notice of the web login response before the login URL', async () => {","+    const globalInfo = jest.fn()","+    const context = createMockContext({","+      globalInfo,","+      readIniFile: async () => ({}),","+      writeIniFile: async () => {},","+      fetch: async url => {","+        if (url === 'https://example.com/-/v1/login') {","+          return createMockResponse({","+            ok: true,","+            status: 202,","+            json: {","+              loginUrl: 'https://example.com/auth/login',","+              doneUrl: 'https://example.com/auth/done',","+            },","+            headers: NOTICE_HEADERS,","+          })","+        }","+        if (url === 'https://example.com/auth/done') {","+          return createMockResponse({ ok: true, status: 200, json: { token: 'web-auth-token-123' } })","+        }","+        throw new Error(`Unexpected call to fetch: ${url}`)","+      },","+    })","+    const opts = { configDir: '/custom/config', dir: '/mock', authConfig: {}, registry: 'https://example.com/' }","+    await login({ context, opts })","+    expect(globalInfo.mock.calls).toEqual([","+      ['Enter the code [31m1234-5678[0m'],","+      [expect.stringContaining('https://example.com/auth/login')],","+      ['Press ENTER to open the URL in your browser.'],","+    ])","+  })","+","   it('should warn and fall back to URL-only display when the login URL exceeds QR capacity', async () => {","     // Longer than the 2953-byte maximum QR data capacity, which makes","     // qrcode-terminal throw."],"additions":38,"deletions":0,"truncated":false},{"path":"pnpm11/auth/commands/tsconfig.json","lines":["@@ -29,6 +29,9 @@","     },","     {","       \"path\": \"../../registry-access/client\"","+    },","+    {","+      \"path\": \"../../text/sanitize\"","     }","   ]"," }"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm11/docs/cli/login.md","lines":["@@ -17,6 +17,8 @@ Supports web-based login with QR code as well as classic username/password authe"," "," Since v11.19.0, web-based login no longer requires an interactive terminal: without a TTY, `pnpm login` prints the authentication URL (skipping the QR code and the prompt to open the URL in a browser) and polls the registry until the browser approval completes. Only the classic username/password login still fails with `ERR_PNPM_LOGIN_NON_INTERACTIVE` in a non-interactive terminal."," ","+Since v11.28.12, web-based login prints the registry's `npm-notice` message before the authentication URL. Some registries use it to show a code that you type in the browser.","+"," Auth tokens are written to [`<pnpm config>/auth.ini`](../npmrc.md#auth-file-locations)."," "," ## Options"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/oidc/sessions.rs","lines":["@@ -37,8 +37,9 @@ pub enum LoginReturn {","     /// The web UI, which redeems a [handoff code](OidcState::hand_off) for","     /// the token.","     Ui,","-    /// CLI web login session flow (`/-/v1/login`).","-    Cli { session: String },","+    /// The CLI web login (`/-/v1/login`) that a browser claimed with its","+    /// user code.","+    Cli { login_id: String },"," }"," "," impl OidcState {","@@ -59,6 +60,16 @@ impl OidcState {","         Err(rejected())","     }"," ","+    /// When the unexpired browser session `raw` expires, in Unix seconds.","+    p