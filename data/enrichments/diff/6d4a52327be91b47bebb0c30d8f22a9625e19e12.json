|login_id| logins.entries.get(login_id))","             .is_some_and(|entry| {","                 entry.expires > now && matches!(entry.state, WebLoginState::Pending)","             })","     }"," ","-    /// Fulfills a pending web login session with the issued session token.","-    pub fn fulfill_web_login(&self, session_id: &str, token: String) -> Result<()> {","+    /// Claims the pending web login whose user code a browser entered,","+    /// returning its login ID. Case, spaces, and dashes in `user_code` are","+    /// ignored. A code can be claimed once.","+    pub fn claim_web_login(&self, user_code: &str) -> Option<String> {","+        let letters = normalize_user_code(user_code)?;","+        let now = Utc::now().timestamp();","+        let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","+        let login_id = logins.code_to_login.remove(&super::super::sha256_hex(letters.as_bytes()))?;","+        let entry = logins.entries.get_mut(&login_id)?;","+        if entry.expires <= now || !matches!(entry.state, WebLoginState::Pending) {","+            return None;","+        }","+        entry.state = WebLoginState::Claimed;","+        Some(login_id)","+    }","+","+    /// Returns a claimed web login to pending, so its user code works again.","+    /// For a browser sign-in that could not start.","+    pub fn release_web_login(&self, login_id: &str) {","+        let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","+        let Some(entry) = logins.entries.get_mut(login_id) else {","+            return;","+        };","+        if !matches!(entry.state, WebLoginState::Claimed) {","+            return;","+        }","+        entry.state = WebLoginState::Pending;","+        let code_hash = entry.code_hash.clone();","+        logins.code_to_login.insert(code_hash, login_id.to_string());","+    }","+","+    /// Fulfills a claimed web login with the issued session token.","+    pub fn fulfill_web_login(&self, login_id: &str, token: String) -> Result<()> {","         let now = Utc::now().timestamp();","-        let hash = super::super::sha256_hex(session_id.as_bytes());","         let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","-        if let Some(entry) = logins.entries.get_mut(&hash)","+        if let Some(entry) = logins.entries.get_mut(login_id)","             && entry.expires > now","-            && matches!(entry.state, WebLoginState::Pending)","+            && matches!(entry.state, WebLoginState::Claimed)","         {","             entry.state = WebLoginState::Fulfilled { token };","             return Ok(());","@@ -107,30 +170,59 @@ impl OidcState {","         let now = Utc::now().timestamp();","         let poll_hash = super::super::sha256_hex(poll_token.as_bytes());","         let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","-        let Some(browser_hash) = logins.poll_to_browser.get(&poll_hash).cloned() else {","+        let Some(login_id) = logins.poll_to_login.get(&poll_hash).cloned() else {","             return WebLoginPoll::NotFound;","         };","-        let Some(entry) = logins.entries.get(&browser_hash) else {","-            logins.poll_to_browser.remove(&poll_hash);","+        let Some(entry) = logins.entries.get(&login_id) else {","+            logins.poll_to_login.remove(&poll_hash);","             return WebLoginPoll::NotFound;","         };","         if entry.expires <= now {","-            logins.entries.remove(&browser_hash);","-            logins.poll_to_browser.remove(&poll_hash);","+            let code_hash = entry.code_hash.clone();","+            logins.entries.remove(&login_id);","+            logins.poll_to_login.remove(&poll_hash);","+            logins.code_to_login.remove(&code_hash);","             return WebLoginPoll::NotFound;","         }","-        if matches!(entry.state, WebLoginState::Pending) {","+        if !ma