,"+s1","+","+statement ok","+RESET SESSION SCHEMA","+","+query I","+SELECT current_schema()","+----","+main","+","+statement ok","+SET SCHEMA 's1'","+","+statement ok","+RESET SCHEMA","+","+query I","+SELECT current_schema()","+----","+main","+","+statement error","+SET LOCAL SCHEMA 's1'","+----","+SET LOCAL is not implemented","+","+statement error","+SET GLOBAL SCHEMA 's1'","+----","+cannot be set globally",""],"additions":113,"deletions":0,"truncated":false}],"additions":283,"deletions":27,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-20T14:26:43.123656+00:00"}