," {","-    [ActiveIssue(\"https://github.com/dotnet/runtime/issues/91381\", typeof(Utilities), nameof(Utilities.IsNativeAot))]","+    // Modifiers on a generic parameter are read from the definition's signature, so they survive","+    // substitution, while the arguments of a substituted type have no signature and no modifiers.","+    [ActiveIssue(\"needs triage\", TestRuntimes.Mono)]","+    [Fact]","+    public static void SubstitutedGenericParameters()","+    {","+        foreach (Type argument in new[] { typeof(int), typeof(List<int>) })","+        {","+            Type modOpt = Modified(\"ModOptOnGenericParameter\", argument);","+            Assert.Same(argument, modOpt.UnderlyingSystemType);","+            Assert.Equal(new[] { typeof(FooModifier) }, modOpt.GetOptionalCustomModifiers());","+            Assert.Empty(modOpt.GetRequiredCustomModifiers());","+            if (argument.IsGenericType)","+            {","+                Type inner = modOpt.GetGenericArguments()[0];","+                Assert.Same(typeof(int), inner.UnderlyingSystemType);","+                Assert.Empty(inner.GetOptionalCustomModifiers());","+            }","+","+            Type modOptInArgument = Modified(\"ModOptInGenericArgument\", argument);","+            Assert.Same(typeof(List<>).MakeGenericType(argument), modOptInArgument.UnderlyingSystemType);","+            Assert.Empty(modOptInArgument.GetOptionalCustomModifiers());","+            Type listArgument = modOptInArgument.GetGenericArguments()[0];","+            Assert.Same(argument, listArgument.UnderlyingSystemType);","+            Assert.Equal(new[] { typeof(FooModifier) }, listArgument.GetOptionalCustomModifiers());","+","+            Type modReqByRef = Modified(\"ModReqOnByRefGenericParameter\", argument);","+            Assert.Same(argument.MakeByRefType(), modReqByRef.UnderlyingSystemType);","+            Type element = modReqByRef.GetElementType();","+            Assert.Same(argument, element.UnderlyingSystemType);","+            Assert.Equal(new[] { typeof(BarModifier) }, element.GetRequiredCustomModifiers());","+            Assert.Empty(element.GetOptionalCustomModifiers());","+        }","+","+        static Type Modified(string name, Type argument) =>","+            typeof(GenericModifiers).GetMethod(name).MakeGenericMethod(argument).GetParameters()[0].GetModifiedParameterType();","+    }","+","     [ActiveIssue(\"needs triage\", TestRuntimes.Mono)]","     [Fact]","     public static unsafe int TestEntryPoint()"],"additions":39,"deletions":2,"truncated":false},{"path":"src/tests/reflection/Modifiers/modifiersdata.il","lines":["@@ -1,6 +1,7 @@"," // Licensed to the .NET Foundation under one or more agreements."," // The .NET Foundation licenses this file to you under the MIT license."," ","+.assembly extern System.Collections { }"," .assembly extern mscorlib { }"," .assembly modifiersdata { }"," ","@@ -166,5 +167,23 @@","   }"," }"," ","+.class public GenericModifiers","+{","+  .method public static hidebysig void ModOptOnGenericParameter<T>(!!0 modopt (FooModifier) arg)","+  {","+    ret","+  }","+","+  .method public static hidebysig void ModOptInGenericArgument<T>(class [System.Collections]System.Collections.Generic.List`1<!!0 modopt (FooModifier)> arg)","+  {","+    ret","+  }","+","+  .method public static hidebysig void ModReqOnByRefGenericParameter<T>(!!0 modreq (BarModifier)& arg)","+  {","+    ret","+  }","+}","+"," .class public FooModifier { }"," .class public BarModifier { }",""],"additions":19,"deletions":0,"truncated":false}],"additions":272,"deletions":26,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-13T17:05:01.117909+00:00"}