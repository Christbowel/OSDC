,"+    public void testWithAnOlderNodeAnObjectIsALeaf() {","+        TransportVersion older = TransportVersionUtils.getPreviousVersion(TransportVersion.fromName(\"esql_objects_are_not_leaves\"));","+        Map<String, EsField> mapping = resolve(","+            older,","+            true,","+            index(\"field\", field(\"a\", \"keyword\")),","+            index(\"object\", field(\"a\", \"object\"), field(\"a.b\", \"long\"))","+        );","+        assertThat(((TypeConflictedField) mapping.get(\"a\")).types(), equalTo(Set.of(DataType.KEYWORD, DataType.OBJECT)));","+    }","+","+    public void testAnObjectOnly() {","+        Map<String, EsField> mapping = resolve(index(\"object\", field(\"a\", \"object\"), field(\"a.b\", \"long\")));","+        assertThat(mapping.get(\"a\").getDataType(), equalTo(DataType.OBJECT));","+        assertThat(mapping.get(\"a\").getProperties().get(\"b\").getDataType(), equalTo(DataType.LONG));","+    }","+","+    private static Map<String, EsField> resolve(FieldCapabilitiesIndexResponse... indices) {","+        return resolve(TransportVersion.current(), false, indices);","+    }","+","+    private static Map<String, EsField> resolve(","+        TransportVersion minimumVersion,","+        boolean trackUnmappedFieldIndices,","+        FieldCapabilitiesIndexResponse... indices","+    ) {","+        FieldCapabilitiesResponse caps = FieldCapabilitiesResponse.builder().withIndexResponses(List.of(indices)).build();","+        return IndexResolver.mergedMappings(","+            \"*\",","+            false,","+            new IndexResolver.FieldsInfo(caps, minimumVersion, false, false, false, false, false, false),","+            trackUnmappedFieldIndices,","+            IndexResolver.DO_NOT_GROUP","+        ).get().mapping();","+    }","+","+    private static IndexFieldCapabilities field(String name, String type) {","+        return new IndexFieldCapabilitiesBuilder(name, type).build();","+    }","+","+    private static FieldCapabilitiesI