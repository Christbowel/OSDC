{"id":"885945cf205c3fe9b6f1da88ec8ce8a47c3865af","axis":"silent","repo":"ray-project/ray","sha":"885945cf205c3fe9b6f1da88ec8ce8a47c3865af","parsed":{"files":[{"path":"doc/source/ray-observability/reference/system-metrics.md","lines":["@@ -50,7 +50,7 @@ These variables must be set in the Ray node and Dashboard Reporter process envir","   - Current number of placement groups by state. The State label (e.g., PENDING, CREATED, REMOVED) describes the state of the placement group. See [rpc::PlacementGroupTable](https://github.com/ray-project/ray/blob/e85355b9b593742b4f5cb72cab92051980fa73d3/src/ray/protobuf/gcs.proto#L517) for more information."," * - `ray_gcs_storage_operation_count_total`","   - `Operation`, `TableName`","-  - Number of operations the GCS invoked on its storage backend, broken down by operation and by the GCS table it addressed. `Operation` is one of `Put`, `Get`, `GetAll`, `MultiGet`, `Delete`, `BatchDelete`, `GetKeys`, `Exists`, or `GetNextJobID`. `TableName` is bounded to the names of Ray's internal `TablePrefix` enum, plus `JobCounter` for `GetNextJobID` and `OTHER` for a table name outside that enum. The values the GCS produces in practice are `JOB`, `ACTOR`, `ACTOR_TASK_SPEC`, `PLACEMENT_GROUP`, `NODE`, `WORKERS`, and `KV`. The remaining enum names are legacy, and no code path emits them. Keys, internal-KV namespaces, and any other user-supplied string never appear in labels. Recorded when the operation is issued, so this metric leads `ray_gcs_storage_operation_latency_ms` by the number of operations in flight. Exported only when the GCS storage backend is in-memory or RocksDB.","+  - Number of operations the GCS invoked on its storage backend, broken down by operation and by the GCS table it addressed. `Operation` is one of `Put`, `Get`, `GetAll`, `MultiGet`, `Delete`, `BatchDelete`, `GetKeys`, `Exists`, or `GetNextJobID`. `TableName` is bounded to the names of Ray's internal `TablePrefix` enum, plus `JobCounter` for `GetNextJobID` and `OTHER` for a table name outside that enum. The values the GCS produces in practice are `JOB`, `ACTOR`, `ACTOR_TASK_SPEC`, `PLACEMENT_GROUP`, `NODE`, `WORKERS`, and `KV`. The remaining enum names are legacy, and no code path emits them. Keys, internal-KV namespaces, and any other user-supplied string never appear in labels. Recorded when the operation is issued, so this metric leads `ray_gcs_storage_operation_latency_ms` by the number of operations in flight. Exported on every GCS storage backend. On Redis, one operation can issue several Redis commands (see `ray_gcs_redis_command_count_total`), and `RAY_gcs_redis_storage_metrics_enabled=false` stops recording this metric and `ray_gcs_storage_operation_latency_ms`."," * - `ray_gcs_storage_operation_latency_ms`","   - `Operation`, `TableName`","   - Time to invoke an operation on the GCS storage backend, with the same label domain as `ray_gcs_storage_operation_count_total`. Recorded when the operation completes."],"additions":1,"deletions":1,"truncated":false},{"path":"src/ray/common/ray_config_def.h","lines":["@@ -443,6 +443,12 @@ RAY_CONFIG(int64_t, redis_tcp_keepalive_interval_seconds, 30)"," /// keepalive is enabled."," RAY_CONFIG(int64_t, redis_tcp_keepalive_probes, 3)"," ","+/// Whether the GCS records gcs_storage_operation_count and","+/// gcs_storage_operation_latency_ms on the Redis backend. Adds two metric","+/// records per storage operation. The in-memory and RocksDB backends always","+/// record them.","+RAY_CONFIG(bool, gcs_redis_storage_metrics_enabled, true)","+"," /// Number of retries for a redis request failure."," RAY_CONFIG(size_t, num_redis_request_retries, 5)"," "],"additions":6,"deletions":0,"truncated":false},{"path":"src/ray/gcs/gcs_server.cc","lines":["@@ -221,7 +221,13 @@ GcsServer::GcsServer(const ray::gcs::GcsServerConfig &config,","         RayConfig::instance().gcs_redis_heartbeat_interval_milliseconds(),","         \"GCSServer.redis_health_check\");"," ","-    store_client = redis_store_client;","+    // The health check above keeps its own pointer, so its PINGs are not","+    // counted as storage operations.","+    store_client = MaybeObserve(std::move(redis_store_client),","+                                RayConfig::instance().gcs_redis_storage_metrics_enabled(),","+                                metrics_.storage_operation_latency_in_ms_histogram,","+                                metrics_.storage_operation_count_counter,","+                                clock_);","     break;","   }"," #if defined(__linux__)","@@ -1004,10 +1010,20 @@ void GcsServer::InitKVManager() {","   auto &io_context = io_context_provider_.GetIOContext<GcsInternalKVManager>();","   std::unique_ptr<StoreClient> store_client;","   switch (storage_type_) {","-  case (StorageType::REDIS_PERSIST):","-    store_client = std::make_unique<RedisStoreClient>(","+  case (StorageType::REDIS_PERSIST): {","+    auto redis_store_client = std::make_unique<RedisStoreClient>(","         io_context, GetRedisClientOptions(), clock_, MakeRedisMetrics(metrics_));","+    if (RayConfig::instance().gcs_redis_storage_metrics_enabled()) {","+      store_client = std::make_unique<ObservableStoreClient>(","+          std::move(redis_store_client),","+          metrics_.storage_operation_latency_in_ms_histogram,","+          metrics_.storage_operation_count_counter,","+          clock_);","+    } else {","+      store_client = std::move(redis_store_client);","+    }","     break;","+  }","   case (StorageType::IN_MEMORY):","     store_client = std::make_unique<ObservableStoreClient>(","         std::make_unique<InMemoryStoreClient>(),"],"additions":19,"deletions":3,"truncated":false},{"path":"src/ray/gcs/store_client/BUILD.bazel","lines":["@@ -105,6 +105,7 @@ ray_cc_library(","     visibility = [","         \":__subpackages__\",","         \"//src/ray/gcs:__pkg__\",","+        \"//src/ray/gcs/tests:__pkg__\",","     ],","     deps = [","         \":store_client\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/ray/gcs/store_client/observable_store_client.cc","lines":["@@ -15,6 +15,7 @@"," #include \"ray/gcs/store_client/observable_store_client.h\""," "," #include <chrono>","+#include <memory>"," #include <string>"," #include <string_view>"," #include <utility>","@@ -44,6 +45,22 @@ double ElapsedMs(ClockInterface &clock, SteadyTimePoint start) {"," "," }  // namespace"," ","+std::shared_ptr<StoreClient> MaybeObserve(","+    std::shared_ptr<StoreClient> delegate,","+    bool enabled,","+    ray::observability::MetricInterface &storage_operation_latency_in_ms_histogram,","+    ray::observability::MetricInterface &storage_operation_count_counter,","+    ClockInterface &clock) {","+  if (!enabled) {","+    return delegate;","+  }","+  return std::make_shared<ObservableStoreClient>(","+      std::move(delegate),","+      storage_operation_latency_in_ms_histogram,","+      storage_operation_count_counter,","+      clock);","+}","+"," void ObservableStoreClient::AsyncPut(const std::string &table_name,","                                      const std::string &key,","                                      std::string data,"],"additions":17,"deletions":0,"truncated":false},{"path":"src/ray/gcs/store_client/observable_store_client.h","lines":["@@ -27,11 +27,36 @@ namespace ray {"," "," namespace gcs {"," ","+/// Wraps `delegate` in an ObservableStoreClient when `enabled`, and returns it","+/// unchanged otherwise.","+///","+/// \\param delegate The store client to wrap.","+/// \\param enabled Whether to wrap `delegate`.","+/// \\param storage_operation_latency_in_ms_histogram Sink for per-operation","+/// latency, recorded when each operation completes.","+/// \\param storage_operation_count_counter Sink for per-operation counts,","+/// recorded when each operation is issued.","+/// \\param clock Clock used to measure operation latency.","+/// \\return Either an ObservableStoreClient owning `delegate`, or `delegate`.","+std::shared_ptr<StoreClient> MaybeObserve(","+    std::shared_ptr<StoreClient> delegate,","+    bool enabled,","+    ray::observability::MetricInterface &storage_operation_latency_in_ms_histogram,","+    ray::observability::MetricInterface &storage_operation_count_counter,","+    ClockInterface &clock);","+"," /// Wraps around a StoreClient instance and observe the metrics."," class ObservableStoreClient : public StoreClient {","  public:","+  /// \\param delegate The store client to observe. A shared_ptr so that GcsServer","+  /// can keep its own RedisStoreClient pointer for the health check.","+  /// \\param storage_operation_latency_in_ms_histogram Sink for per-operation","+  /// latency, recorded when each operation completes.","+  /// \\param storage_operation_count_counter Sink for per-operation counts,","+  /// recorded when each operation is issued.","+  /// \\param clock Clock used to measure operation latency.","   explicit ObservableStoreClient(","-      std::unique_ptr<StoreClient> delegate,","+      std::shared_ptr<StoreClient> delegate,","       ray::observability::MetricInterface &storage_operation_latency_in_ms_histogram,","       ray::observability::MetricInterface &storage_operation_count_counter,","       ClockInterface &clock)","@@ -79,7 +104,7 @@ class ObservableStoreClient : public StoreClient {","                    Postable<void(bool)> callback) override;"," ","  private:","-  std::unique_ptr<StoreClient> delegate_;","+  std::shared_ptr<StoreClient> delegate_;","   ray::observability::MetricInterface &storage_operation_latency_in_ms_histogram_;","   ray::observability::MetricInterface &storage_operation_count_counter_;","   ClockInterface &clock_;"],"additions":27,"deletions":2,"truncated":false},{"path":"src/ray/gcs/store_client/tests/observable_store_client_test.cc","lines":["@@ -339,6 +339,78 @@ TEST_F(ObservableStoreClientTableLabelTest, NoUserDataInLabels) {","   EXPECT_EQ(ValueFor(count_.GetTagToValue(), \"Put\", kv_table), 1);"," }"," ","+// Exercises MaybeObserve over the in-memory client;","+// RedisObservableGcsTableStorageTest covers it against a real Redis.","+class MaybeObserveTest : public ::testing::Test {","+ public:","+  void SetUp() override {","+    io_service_pool_ = std::make_shared<IOServicePool>(1);","+    io_service_pool_->Run();","+  }","+","+  void TearDown() override { io_service_pool_->Stop(); }","+","+ protected:","+  // Issues one Put and waits for it to complete, so the latency observer has","+  // fired by the time the test asserts.","+  void PutAndWait(StoreClient &client) {","+    std::atomic<bool> done{false};","+    client.AsyncPut(rpc::TablePrefix_Name(rpc::TablePrefix::JOB),","+                    \"key\",","+                    \"value\",","+                    /*overwrite=*/true,","+                    {[&done](bool) { done = true; }, *io_service_pool_->Get()});","+    ASSERT_TRUE(WaitForCondition([&done] { return done.load(); }, 5000));","+  }","+","+  using Recorded =","+      absl::flat_hash_map<absl::flat_hash_map<std::string, std::string>, double>;","+","+  static std::optional<double> ValueFor(const Recorded &recorded,","+                                        const std::string &operation,","+                                        const std::string &table) {","+    for (const auto &[tags, value] : recorded) {","+      auto op = tags.find(\"Operation\");","+      auto tbl = tags.find(\"TableName\");","+      if (op != tags.end() && op->second == operation && tbl != tags.end() &&","+          tbl->second == table) {","+        return value;","+      }","+    }","+    return std::nullopt;","+  }","+","+  std::shared_ptr<IOServicePool> io_service_pool_;","+  ray::FakeClock clock_;","+  ray::observability::FakeHistogram latency_;","+  ray::observability::FakeCounter count_;","+};","+","+TEST_F(MaybeObserveTest, RecordsWhenEnabled) {","+  auto client = MaybeObserve(std::make_shared<InMemoryStoreClient>(),","+                             /*enabled=*/true,","+                             latency_,","+                             count_,","+                             clock_);","+  PutAndWait(*client);","+","+  EXPECT_EQ(ValueFor(count_.GetTagToValue(), \"Put\", \"JOB\").value_or(0), 1);","+  // FakeHistogram keeps the last observation, so only its presence is stable.","+  EXPECT_TRUE(ValueFor(latency_.GetTagToValue(), \"Put\", \"JOB\").has_value());","+}","+","+TEST_F(MaybeObserveTest, RecordsNothingWhenDisabled) {","+  auto delegate = std::make_shared<InMemoryStoreClient>();","+  auto client = MaybeObserve(delegate, /*enabled=*/false, latency_, count_, clock_);","+  // The kill switch must hand back the delegate itself, not a silent wrapper.","+  EXPECT_EQ(client.get(), static_cast<StoreClient *>(delegate.get()));","+","+  PutAndWait(*client);","+","+  EXPECT_TRUE(count_.GetTagToValue().empty());","+  EXPECT_TRUE(latency_.GetTagToValue().empty());","+}","+"," }  // namespace gcs"," "," }  // namespace ray"],"additions":72,"deletions":0,"truncated":false},{"path":"src/ray/gcs/tests/BUILD.bazel","lines":["@@ -300,7 +300,9 @@ ray_cc_test(","         \":gcs_table_storage_test_lib\",","         \"//src/ray/common:test_utils\",","         \"//src/ray/gcs:gcs_table_storage\",","+        \"//src/ray/gcs/store_client:observable_store_client\",","         \"//src/ray/gcs/store_client/tests:store_client_test_lib\",","+        \"//src/ray/observability:fake_metric\",","         \"//src/ray/util:clock\",","     ],"," )"],"additions":2,"deletions":0,"truncated":false},{"path":"src/ray/gcs/tests/redis_gcs_table_storage_test.cc","lines":["@@ -13,12 +13,17 @@"," // limitations under the License."," "," #include <memory>","+#include <optional>","+#include <string>"," ","+#include \"absl/container/flat_hash_map.h\""," #include \"gtest/gtest.h\""," #include \"ray/common/test_utils.h\""," #include \"ray/gcs/gcs_table_storage.h\"","+#include \"ray/gcs/store_client/observable_store_client.h\""," #include \"ray/gcs/store_client/redis_store_client.h\""," #include \"ray/gcs/tests/gcs_table_storage_test_base.h\"","+#include \"ray/observability/fake_metric.h\""," #include \"ray/util/clock.h\""," "," namespace ray {","@@ -45,4 +50,76 @@ TEST_F(RedisGcsTableStorageTest, TestGcsTableApi) { TestGcsTableApi(); }"," "," TEST_F(RedisGcsTableStorageTest, TestGcsTableWithJobIdApi) { TestGcsTableWithJobIdApi(); }"," ","+/// Exercises gcs::MaybeObserve against a real Redis, with metrics enabled and","+/// disabled.","+class RedisObservableGcsTableStorageTest : public gcs::GcsTableStorageTestBase {","+ public:","+  static void SetUpTestCase() { TestSetupUtil::StartUpRedisServers(std::vector<int>()); }","+","+  static void TearDownTestCase() { TestSetupUtil::ShutDownRedisServers(); }","+","+  // The storage is built per test rather than in SetUp, because the two tests","+  // differ only in the flag MaybeObserve is called with. io_service_pool_ comes","+  // from the base's constructor and is already running.","+  void SetUp() override {}","+","+  void TearDown() override {}","+","+ protected:","+  void BuildStorage(bool metrics_enabled) {","+    auto &io_service = *io_service_pool_->Get();","+    gcs::RedisClientOptions options{\"127.0.0.1\", TEST_REDIS_SERVER_PORTS.front()};","+    gcs_table_storage_ = std::make_shared<gcs::GcsTableStorage>(gcs::MaybeObserve(","+        std::make_shared<gcs::RedisStoreClient>(io_service, options, clock_),","+        metrics_enabled,","+        latency_,","+        count_,","+        clock_));","+  }","+","+  using Recorded =","+      absl::flat_hash_map<absl::flat_hash_map<std::string, std::string>, double>;","+","+  static std::optional<double> ValueFor(const Recorded &recorded,","+                                        const std::string &operation,","+                                        const std::string &table) {","+    for (const auto &[tags, value] : recorded) {","+      auto op = tags.find(\"Operation\");","+      auto tbl = tags.find(\"TableName\");","+      if (op != tags.end() && op->second == operation && tbl != tags.end() &&","+          tbl->second == table) {","+        return value;","+      }","+    }","+    return std::nullopt;","+  }","+","+  Clock clock_;","+  ray::observability::FakeHistogram latency_;","+  ray::observability::FakeCounter count_;","+};","+","+TEST_F(RedisObservableGcsTableStorageTest, RecordsOnTheRedisBackend) {","+  BuildStorage(/*metrics_enabled=*/true);","+","+  JobID job_id = JobID::FromInt(1);","+  auto job_table_data = GenJobTableData(job_id);","+  Put(gcs_table_storage_->JobTable(), job_id, *job_table_data);","+","+  EXPECT_EQ(ValueFor(count_.GetTagToValue(), \"Put\", \"JOB\").value_or(0), 1);","+  // FakeHistogram keeps the last observation, so only its presence is stable.","+  EXPECT_TRUE(ValueFor(latency_.GetTagToValue(), \"Put\", \"JOB\").has_value());","+}","+","+TEST_F(RedisObservableGcsTableStorageTest, RecordsNothingWhenTheKillSwitchIsOff) {","+  BuildStorage(/*metrics_enabled=*/false);","+","+  JobID job_id = JobID::FromInt(2);","+  auto job_table_data = GenJobTableData(job_id);","+  Put(gcs_table_storage_->JobTable(), job_id, *job_table_data);","+","+  EXPECT_TRUE(count_.GetTagToValue().empty());","+  EXPECT_TRUE(latency_.GetTagToValue().empty());","+}","+"," }  // namespace ray",""],"additions":77,"deletions":0,"truncated":false}],"additions":222,"deletions":6,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-20T14:24:55.916716+00:00"}