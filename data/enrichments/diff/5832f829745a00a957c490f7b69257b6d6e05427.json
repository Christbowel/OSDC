 Hidden accessibility text. */"],"additions":28,"deletions":2,"truncated":false},{"path":"src/wp-includes/class-wp-admin-bar.php","lines":["@@ -109,12 +109,15 @@ public function remove_menu( $id ) {"," \t * @since 3.1.0"," \t * @since 4.5.0 Added the ability to pass 'lang' and 'dir' meta data."," \t * @since 6.5.0 Added the ability to pass 'menu_title' for an ARIA menu name.","+\t * @since 7.2.0 Added the `icon` argument."," \t *"," \t * @param array $args {"," \t *     Arguments for adding a node."," \t *"," \t *     @type string $id     ID of the item."," \t *     @type string $title  Title of the node.","+\t *     @type string $icon   Optional. Namespaced icon name in the form \"collection/icon-name\",","+\t *                          e.g. 'core-admin/pin'. Rendered before the title."," \t *     @type string $parent Optional. ID of the parent node."," \t *     @type string $href   Optional. Link for the item."," \t *     @type bool   $group  Optional. Whether or not the node is a group. Default false.","@@ -146,6 +149,7 @@ public function add_node( $args ) {"," \t\t$defaults = array("," \t\t\t'id'     => false,"," \t\t\t'title'  => false,","+\t\t\t'icon'   => false,"," \t\t\t'parent' => false,"," \t\t\t'href'   => false,"," \t\t\t'group'  => false,","@@ -179,6 +183,68 @@ public function add_node( $args ) {"," \t\t$this->_set_node( $args );"," \t}"," ","+\t/**","+\t * Dashicons back-compat: returns the default icon for a node ID that core registers.","+\t *","+\t * The icons of these nodes used to be added with CSS rules for the node ID,","+\t * in one of two ways. A node that has no icon of its own gets the icon under","+\t * the same condition as before:","+\t *","+\t * - On `.ab-item::before`: the node gets the icon whatever its title is. The","+\t *   `my-account` node only gets it without the `with-avatar` class.","+\t * - On `.ab-icon::before`: the node gets the icon in place of the empty","+\t *   `<span class=\"ab-icon\">` of its title, and no icon without that element.","+\t *","+\t * @since 7.2.0","+\t *","+\t * @param object $node The node.","+\t * @return array|false {","+\t *     Default icon, or false if the node has none.","+\t *","+\t *     @type string $icon     Namespaced icon name.","+\t *     @type bool   $in_title Whether the icon takes the place of the empty icon element of the title.","+\t * }","+\t */","+\tprivate static function get_default_icon( $node ) {","+\t\t$id            = $node->id;","+\t\t$default_icons = array(","+\t\t\t// On `.ab-item::before`.","+\t\t\t'site-name'       => array( 'core-admin/dashboard', false ),","+\t\t\t'my-sites'        => array( 'core-admin/sites', false ),","+\t\t\t'site-editor'     => array( 'core-admin/brush', false ),","+\t\t\t'customize'       => array( 'core-admin/brush', false ),","+\t\t\t'edit'            => array( 'core-admin/pencil', false ),","+\t\t\t'my-account'      => array( 'core-admin/people', false ),","+\t\t\t// On `.ab-icon::before`, in the title.","+\t\t\t'wp-logo'         => array( 'core-admin/wordpress', true ),","+\t\t\t'menu-toggle'     => array( 'core-admin/menu', true ),","+\t\t\t'command-palette' => array( 'core-admin/search', true ),","+\t\t\t'new-content'     => array( 'core-admin/plus', true ),","+\t\t\t'comments'        => array( 'core-admin/comment', true ),","+\t\t\t'updates'         => array( 'core-admin/update', true ),","+\t\t);","+","+\t\tif ( ! isset( $default_icons[ $id ] ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// The account icon is only for a node without an avatar.","+\t\tif ( 'my-account' === $id && in_array( 'with-avatar', explode( ' ', $node->meta['class'] ?? '' ), true ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t$icon = $default_icons[ $id ][0];","+","+\t\tif ( 'site-name' === $id && ( is_admin() || ! current_user_can( 'read' ) ) ) {","+\t\t\t$icon = 'core-admin/home';","+\t\t}","+","+\t\treturn array(","+\t\t\t'icon'     => $icon,","+\t\t\t'in_title' => $default_icons[ $id ][1],","+\t\t);","+\t}","+"," \t/**"," \t * @since 3.3.0"," \t *","@@ -575,6 +641,42 @@ final protected function _render_item( $node ) {"," \t\t\t$menuclass = ' class=\"' . esc_attr( trim( $menuclass ) ) . '\"';"," \t\t}"," ","+\t\t$title     = $node->title;","+\t\t$icon_name = $node->icon;","+","+\t\t// Dashicons back-compat: a core node that was given no icon gets its default icon.","+\t\t$default_icon = self::get_default_icon( $node );","+","+\t\t// Dashicons back-compat: the icon replaces the first empty `<span class=\"ab-icon\">` in the title; without one, the node gets no default icon.","+\t\tif ( $default_icon && $default_icon['in_title'] ) {","+\t\t\t$title = preg_replace( '/<span\\b[^>]*\\bclass=([\"\\'])(?:[^\"\\']*\\s)?ab-icon(?:\\s[^\"\\']*)?\\1[^>]*>\\s*<\\/span>/', '', (string) $title, 1, $count );","+\t\t\tif ( ! $count ) {","+\t\t\t\t$default_icon = false;","+\t\t\t}","+\t\t}","+","+\t\tif ( ! $icon_name && $default_icon ) {","+\t\t\t$icon_name = $default_icon['icon'];"],"additions":82,"deletions":0,"truncated":false}],"additions":324,"deletions":75,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-20T14:25:58.608733+00:00"}