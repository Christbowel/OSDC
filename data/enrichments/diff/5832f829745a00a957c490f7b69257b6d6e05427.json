; this does it for inline SVG icons, with CSS.","+ *","+ * The rules are printed before the stylesheet of the scheme, so a scheme","+ * that colors the icon element itself overrides them.","+ *","+ * @since 7.2.0","+ *","+ * @see wp_color_scheme_settings()","+ */","+function wp_color_scheme_menu_icon_styles() {","+\t$styles = _wp_get_color_scheme_menu_icon_styles( get_user_option( 'admin_color' ) );","+","+\tif ( '' !== $styles ) {","+\t\twp_add_inline_style( 'admin-menu', $styles );","+\t}","+}","+","+/**","+ * Returns the CSS that colors inline SVG admin menu icons with the icon colors of an admin color scheme.","+ *","+ * A scheme without icon colors gets CSS that makes the icons follow the","+ * text color of the menu links instead.","+ *","+ * The color scheme picker also passes it to user-profile.js, which applies","+ * it when another scheme is selected.","+ *","+ * @since 7.2.0","+ * @access private","+ *","+ * @global array $_wp_admin_css_colors","+ *","+ * @param string $color_scheme The name of the color scheme.","+ * @return string The CSS, or an empty string if the scheme needs none.","+ */","+function _wp_get_color_scheme_menu_icon_styles( $color_scheme ) {","+\tglobal $_wp_admin_css_colors;","+","+\tif ( empty( $_wp_admin_css_colors[ $color_scheme ] ) ) {","+\t\treturn '';","+\t}","+","+\t// The core schemes have no stylesheet of their own, or one from the core colors directory.","+\t$url = $_wp_admin_css_colors[ $color_scheme ]->url;","+\tif ( ! is_string( $url ) || '' === $url || str_starts_with( $url, admin_url( 'css/colors/' ) ) ) {","+\t\treturn '';","+\t}","+","+\t$base_selector    = '#adminmenu div.wp-menu-image';","+\t$focus_selector   = '#adminmenu li:hover div.wp-menu-image,#adminmenu li a:focus div.wp-menu-image,#adminmenu li.opensub div.wp-menu-image';","+\t$current_selector = '#adminmenu li.wp-has-current-submenu div.wp-menu-image,#adminmenu li.wp-has-current-submenu:hover div.wp-menu-image,#adminmenu a.wp-has-current-submenu:hover div.wp-menu-image,#adminmenu a.current:hover div.wp-menu-image,#adminmenu li.current div.wp-menu-image,#adminmenu li.wp-has-current-submenu a:focus div.wp-menu-image,#adminmenu li.wp-has-current-submenu.opensub div.wp-menu-image';","+","+\t$icon_colors = array_map( 'sanitize_hex_color', wp_parse_args( (array) $_wp_admin_css_colors[ $color_scheme ]->icon_colors, array_fill_keys( array( 'base', 'focus', 'current' ), '' ) ) );","+","+\t// Without icon colors, the icons follow the text color that the scheme gives to the menu links.","+\tif ( ! $icon_colors['base'] || ! $icon_colors['focus'] || ! $icon_colors['current'] ) {","+\t\treturn \"$base_selector,$focus_selector,$current_selector{color:inherit}\";","+\t}","+","+\treturn \"$base_selector{color:{$icon_colors['base']}}\" .","+\t\t\"$focus_selector{color:{$icon_colors['focus']}}\" .","+\t\t\"$current_selector{color:{$icon_colors['current']}}\";","+}","+"," /**","  * Displays the viewport meta in the admin.","  *"],"additions":69,"deletions":0,"truncated":false},{"path":"src/wp-admin/includes/plugin.php","lines":["@@ -1396,6 +1396,8 @@ function uninstall_plugin( $plugin ) {","  *                                the color scheme. This should begin with 'data:image/svg+xml;base64,'.","  *                              * Pass the name of a Dashicons helper class to use a font icon,","  *                                e.g. 'dashicons-chart-pie'.","+ *                              * Pass the namespaced name of a registered icon to render it as an inline SVG,","+ *                                e.g. 'core-admin/pin'.","  *                              * Pass 'none' to leave div.wp-menu-image empty so an icon can be added via CSS.","  * @param int|float $position   Optional. The position in the menu order this item should appear.","  * @return string The resulting page's hook_suffix."],"additions":2,"deletions":0,"truncated":false},{"path":"src/wp-admin/menu-header.php","lines":["@@ -73,6 +73,26 @@"," function _wp_menu_output( $menu, $submenu, $submenu_as_parent = true ) {"," \tglobal $self, $parent_file, $submenu_file, $plugin_page, $typenow;"," ","+\t/*","+\t * Dashicons back-compat: the `$menu` global keeps the Dashicons values of the core","+\t * menu items. Those Dashicons are only mapped to their replacement icons here, when","+\t * the menu is rendered.","+\t */","+\t$dashicon_replacements = array(","+\t\t'dashicons-dashboard'        => 'core-admin/dashboard',","+\t\t'dashicons-admin-post'       => 'core-admin/pin',","+\t\t'dashicons-admin-media'      => 'core-admin/media',","+\t\t'dashicons-admin-links'      => 'core-admin/link',","+\t\t'dashicons-admin-page'       => 'core-admin/page',","+\t\t'dashicons-admin-comments'   => 'core-admin/comment',","+\t\t'dashicons-admin-appearance' => 'core-admin/brush',","+\t\t'dashicons-admin-plugins'    => 'core-admin/plugins',","+\t\t'dashicons-admin-users'      => 'core-admin/people',","+\t\t'dashicons-admin-tools'      => 'core-admin/tool',","+\t\t'dashicons-admin-settings'   => 'core-admin/settings',","+\t\t'dashicons-admin-multisite'  => 'core-admin/sites',","+\t);","+"," \t$first = true;"," \t// 0 = menu_title, 1 = capability, 2 = menu_slug, 3 = page_title, 4 = classes, 5 = hookname, 6 = icon_url."," \tforeach ( $menu as $key => $item ) {","@@ -125,10 +145,13 @@ function _wp_menu_output( $menu, $submenu, $submenu_as_parent = true ) {"," \t\t * If the string 'none' (previously 'div') is passed instead of a URL, don't output"," \t\t * the default menu image so an icon can be added to div.wp-menu-image as background"," \t\t * with CSS. Dashicons and base64-encoded data:image/svg_xml URIs are also handled","-\t\t * as special cases.","+\t\t * as special cases. Dashicons that have a replacement, and namespaced icon names, are","+\t\t * rendered as inline SVG, or leave the menu image empty if the icon is not found.","+\t\t * Any other value is treated as an image URL."," \t\t */"," \t\tif ( ! empty( $item[6] ) ) {","-\t\t\t$img = '<img src=\"' . e