{"id":"ddd7303412d4718f7295e0ba11107db38b0ae68e","axis":"silent","repo":"langchain-ai/langchain","sha":"ddd7303412d4718f7295e0ba11107db38b0ae68e","parsed":{"files":[{"path":"libs/core/langchain_core/exceptions.py","lines":["@@ -1,7 +1,12 @@"," \"\"\"Custom **exceptions** for LangChain.\"\"\""," ","+from __future__ import annotations","+"," from enum import Enum","-from typing import Any","+from typing import TYPE_CHECKING, Any","+","+if TYPE_CHECKING:","+    from langchain_core.messages import BaseMessage, RefusalContentBlock"," "," "," class LangChainException(Exception):  # noqa: N818","@@ -69,11 +74,12 @@ class ModelError(LangChainException):","     \"\"\"Base exception for failures related to model invocation."," ","     Subclasses correspond to conditions that model providers report consistently,","-    keyed to the HTTP status they surface it with, so the same condition maps to","-    the same exception type regardless of provider.","+    so the same condition maps to the same exception type regardless of provider.","+    Most are keyed to the HTTP status they surface it with; `ModelRefusalError`","+    covers successful responses in which the model refused."," ","-    Provider integrations raise subclasses that also inherit from the provider","-    SDK's own exception type, so code catching either continues to work.","+    Provider integrations raise HTTP error subclasses that also inherit from the","+    provider SDK's own exception type, so code catching either continues to work.","     \"\"\""," ","     is_retryable = False","@@ -128,6 +134,59 @@ class ContextOverflowError(ModelError):","     \"\"\""," "," ","+class ModelRefusalError(ModelError):","+    \"\"\"Exception raised when a model declines to produce the requested output.","+","+    Providers report a refusal as a successful response rather than an HTTP error","+    (for example Anthropic's `stop_reason=\"refusal\"`, or the `refusal` field in","+    OpenAI Structured Outputs), so a plain model call returns the message as-is.","+    Integrations raise this exception from paths that need the content the model","+    withheld, such as `with_structured_output`, so callers can handle refusals the","+    same way across providers instead of receiving a parsing error.","+","+    Retrying the same request is unlikely to succeed.","+","+    !!! version-added \"Added in `langchain-core` 1.7.5\"","+    \"\"\"","+","+    def __init__(","+        self,","+        message: str = \"Model refused to produce the requested output\",","+        *,","+        raw_message: BaseMessage | None = None,","+    ) -> None:","+        \"\"\"Create a `ModelRefusalError`.","+","+        Args:","+            message: Error message.","+            raw_message: The model response that contained the refusal. Its","+                `content_blocks` hold the refusal block, including any","+                provider-specific details in `extras`.","+        \"\"\"","+        self.raw_message = raw_message","+        super().__init__(message)","+","+    @classmethod","+    def from_refusal(","+        cls, refusal: RefusalContentBlock, *, raw_message: BaseMessage","+    ) -> ModelRefusalError:","+        \"\"\"Create a `ModelRefusalError` from a standard refusal block.","+","+        Args:","+            refusal: The refusal block from the response's `content_blocks`.","+            raw_message: The model response that contained the refusal.","+","+        Returns:","+            An error whose message includes the refusal's category and text.","+        \"\"\"","+        message = \"Model refused to produce the requested output\"","+        if category := refusal.get(\"extras\", {}).get(\"category\"):","+            message += f\" (category={category!r})\"","+        if text := refusal.get(\"refusal\"):","+            message += f\": {text}\"","+        return cls(message, raw_message=raw_message)","+","+"," class ErrorCode(Enum):","     \"\"\"Error codes.\"\"\""," "],"additions":64,"deletions":5,"truncated":false},{"path":"libs/core/langchain_core/language_models/chat_models.py","lines":["@@ -2465,6 +2465,9 @@ def with_structured_output(","                 The final output is always a `dict` with keys `'raw'`, `'parsed'`, and","                 `'parsing_error'`."," ","+                If the model refuses, `ModelRefusalError` is raised, or returned as","+                `'parsing_error'` when `include_raw` is `True`.","+","         Raises:","             ValueError: If there are any unsupported `kwargs`.","             NotImplementedError: If the model does not implement"],"additions":3,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/messages/__init__.py","lines":["@@ -38,6 +38,7 @@","         NonStandardContentBlock,","         PlainTextContentBlock,","         ReasoningContentBlock,","+        RefusalContentBlock,","         ServerToolCall,","         ServerToolCallChunk,","         ServerToolResult,","@@ -104,6 +105,7 @@","     \"OutputTokenDetails\",","     \"PlainTextContentBlock\",","     \"ReasoningContentBlock\",","+    \"RefusalContentBlock\",","     \"RemoveMessage\",","     \"ServerToolCall\",","     \"ServerToolCallChunk\",","@@ -165,6 +167,7 @@","     \"OutputTokenDetails\": \"ai\",","     \"PlainTextContentBlock\": \"content\",","     \"ReasoningContentBlock\": \"content\",","+    \"RefusalContentBlock\": \"content\",","     \"RemoveMessage\": \"modifier\",","     \"ServerToolCall\": \"content\",","     \"ServerToolCallChunk\": \"content\","],"additions":3,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/messages/block_translators/anthropic.py","lines":["@@ -256,6 +256,17 @@ def _iter_blocks() -> Iterator[types.ContentBlock]:","                     text_block[\"index\"] = block[\"index\"]","                 yield text_block"," ","+            elif block_type == \"refusal\":","+                refusal_block: types.RefusalContentBlock = {","+                    \"type\": \"refusal\",","+                    \"refusal\": block.get(\"refusal\", \"\"),","+                }","+                if extras := block.get(\"extras\"):","+                    refusal_block[\"extras\"] = extras","+                if \"index\" in block:","+                    refusal_block[\"index\"] = block[\"index\"]","+                yield refusal_block","+","             elif block_type == \"thinking\":","                 reasoning_block: types.ReasoningContentBlock = {","                     \"type\": \"reasoning\",","@@ -499,7 +510,33 @@ def _iter_blocks() -> Iterator[types.ContentBlock]:","                     new_block = {\"type\": \"non_standard\", \"value\": block}","                 yield new_block"," ","-    return list(_iter_blocks())","+    blocks = list(_iter_blocks())","+    if message.response_metadata.get(\"stop_reason\") == \"refusal\" and not any(","+        block[\"type\"] == \"refusal\" for block in blocks","+    ):","+        blocks.append(_refusal_from_stop_details(message.response_metadata))","+    return blocks","+","+","+def _refusal_from_stop_details(","+    response_metadata: dict[str, Any],","+) -> types.RefusalContentBlock:","+    \"\"\"Build a refusal block from Anthropic's response-level refusal fields.","+","+    The block uses a fixed index so that streamed chunks aggregate into a single","+    refusal.","+    \"\"\"","+    details = response_metadata.get(\"stop_details\")","+    if not isinstance(details, dict):","+        details = {}","+    block: types.RefusalContentBlock = {","+        \"type\": \"refusal\",","+        \"refusal\": details.get(\"explanation\") or \"\",","+        \"index\": \"lc_refusal\",","+    }","+    if category := details.get(\"category\"):","+        block[\"extras\"] = {\"category\": category}","+    return block"," "," "," def translate_content(message: AIMessage) -> list[types.ContentBlock]:"],"additions":38,"deletions":1,"truncated":false},{"path":"libs/core/langchain_core/messages/block_translators/openai.py","lines":["@@ -175,6 +175,8 @@ def _convert_to_v1_from_chat_completions(","             }","         )"," ","+    if refusal := message.additional_kwargs.get(\"refusal\"):","+        content_blocks.append({\"type\": \"refusal\", \"refusal\": refusal})","     return content_blocks"," "," ","@@ -260,6 +262,11 @@ def _convert_to_v1_from_chat_completions_chunk(","                 tc[\"index\"] = idx","             content_blocks.append(tc)"," ","+    if refusal := chunk.additional_kwargs.get(\"refusal\"):","+        # A fixed index merges streamed refusal deltas into one block.","+        content_blocks.append(","+            {\"type\": \"refusal\", \"refusal\": refusal, \"index\": \"lc_refusal\"}","+        )","     return content_blocks"," "," ","@@ -674,6 +681,25 @@ def _iter_blocks() -> Iterator[types.ContentBlock]:","                     block[\"index\"] = f\"lc_txt_{block['index']}\"","                 yield cast(\"types.TextContentBlock\", block)"," ","+            elif block_type == \"refusal\":","+                refusal_block: types.RefusalContentBlock = {","+                    \"type\": \"refusal\",","+                    \"refusal\": block.get(\"refusal\", \"\"),","+                }","+                for key in (\"id\", \"index\"):","+                    if key in block:","+                        refusal_block[key] = block[key]","+                refusal_extras = {","+                    k: v","+                    for k, v in block.items()","+                    if k not in {\"type\", \"refusal\", \"id\", \"index\", \"extras\"}","+                }","+                if block.get(\"extras\"):","+                    refusal_extras = {**block[\"extras\"], **refusal_extras}","+                if refusal_extras:","+                    refusal_block[\"extras\"] = refusal_extras","+                yield refusal_block","+","             elif block_type == \"reasoning\":","                 yield from _explode_reasoning(block)"," "],"additions":26,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/messages/content.py","lines":["@@ -492,6 +492,33 @@ class ReasoningContentBlock(TypedDict):","     \"\"\"Provider-specific metadata.\"\"\""," "," ","+class RefusalContentBlock(TypedDict):","+    \"\"\"An explicit refusal reported by the model provider.","+","+    Providers report refusals differently: OpenAI returns refusal content, while","+    Anthropic reports a refusal stop reason on the response. Both are represented","+    as this block so callers can detect a refusal without provider-specific code.","+    Refusals the model writes as ordinary text are not detected.","+","+    !!! version-added \"Added in `langchain-core` 1.7.5\"","+    \"\"\"","+","+    type: Literal[\"refusal\"]","+    \"\"\"Type of the content block. Used for discrimination.\"\"\"","+","+    refusal: str","+    \"\"\"Human-readable refusal message, or an empty string if none was provided.\"\"\"","+","+    id: NotRequired[str]","+    \"\"\"Unique identifier for this content block.\"\"\"","+","+    index: NotRequired[int | str]","+    \"\"\"Index of block in aggregate response. Used during streaming.\"\"\"","+","+    extras: NotRequired[dict[str, Any]]","+    \"\"\"Provider-specific metadata, e.g. Anthropic's refusal `category`.\"\"\"","+","+"," # Note: `title` and `context` are fields that could be used to provide additional"," # information about the file, such as a description or summary of its content."," # E.g. with Claude, you can provide a context for a file which is passed to the model.","@@ -846,6 +873,7 @@ class NonStandardContentBlock(TypedDict):","     TextContentBlock","     | InvalidToolCall","     | ReasoningContentBlock","+    | RefusalContentBlock","     | NonStandardContentBlock","     | DataContentBlock","     | ToolContentBlock","@@ -857,6 +885,7 @@ class NonStandardContentBlock(TypedDict):","     # Text output","     \"text\",","     \"reasoning\",","+    \"refusal\",","     # Tools","     \"tool_call\",","     \"invalid_tool_call\","],"additions":29,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/messages/utils.py","lines":["@@ -1952,6 +1952,11 @@ def convert_to_openai_messages(","                             },","                         }","                     )","+                elif block.get(\"type\") == \"refusal\":","+                    # Refusals without text, e.g. from Anthropic, have nothing to","+                    # send.","+                    if block.get(\"refusal\"):","+                        content.append({\"type\": \"refusal\", \"refusal\": block[\"refusal\"]})","                 elif (","                     block.get(\"type\") in {\"thinking\", \"reasoning\"}","                     or pass_through_unknown_blocks"],"additions":5,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/output_parsers/_refusal.py","lines":["@@ -0,0 +1,11 @@","+\"\"\"Refusal handling shared by structured output parsers.\"\"\"","+","+from langchain_core.exceptions import ModelRefusalError","+from langchain_core.messages import BaseMessage","+","+","+def raise_if_refused(message: BaseMessage) -> None:","+    \"\"\"Raise `ModelRefusalError` if the model refused instead of answering.\"\"\"","+    for block in message.content_blocks:","+        if block[\"type\"] == \"refusal\":","+            raise ModelRefusalError.from_refusal(block, raw_message=message)"],"additions":11,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/output_parsers/json.py","lines":["@@ -13,9 +13,10 @@"," from typing_extensions import override"," "," from langchain_core.exceptions import OutputParserException","+from langchain_core.output_parsers._refusal import raise_if_refused"," from langchain_core.output_parsers.format_instructions import JSON_FORMAT_INSTRUCTIONS"," from langchain_core.output_parsers.transform import BaseCumulativeTransformOutputParser","-from langchain_core.outputs import Generation","+from langchain_core.outputs import ChatGeneration, Generation"," from langchain_core.utils.json import (","     parse_and_check_json_markdown,","     parse_json_markdown,","@@ -74,8 +75,11 @@ def parse_result(self, result: list[Generation], *, partial: bool = False) -> An","             The parsed JSON object."," ","         Raises:","+            ModelRefusalError: If the model refused to answer.","             OutputParserException: If the output is not valid JSON.","         \"\"\"","+        if isinstance(result[0], ChatGeneration):","+            raise_if_refused(result[0].message)","         text = result[0].text","         text = text.strip()","         if partial:"],"additions":5,"deletions":1,"truncated":false},{"path":"libs/core/langchain_core/output_parsers/openai_tools.py","lines":["@@ -13,6 +13,7 @@"," from langchain_core.messages import AIMessage, InvalidToolCall"," from langchain_core.messages.tool import invalid_tool_call"," from langchain_core.messages.tool import tool_call as create_tool_call","+from langchain_core.output_parsers._refusal import raise_if_refused"," from langchain_core.output_parsers.transform import BaseCumulativeTransformOutputParser"," from langchain_core.outputs import ChatGeneration, Generation"," from langchain_core.utils.json import parse_partial_json","@@ -178,6 +179,7 @@ def parse_result(self, result: list[Generation], *, partial: bool = False) -> An","             The parsed tool calls."," ","         Raises:","+            ModelRefusalError: If the model refused to answer.","             OutputParserException: If the output is not valid JSON.","         \"\"\"","         generation = result[0]","@@ -185,6 +187,7 @@ def parse_result(self, result: list[Generation], *, partial: bool = False) -> An","             msg = \"This output parser can only be used with a chat generation.\"","             raise OutputParserException(msg)","         message = generation.message","+        raise_if_refused(message)","         if isinstance(message, AIMessage) and message.tool_calls:","             tool_calls = [dict(tc) for tc in message.tool_calls]","             for tool_call in tool_calls:","@@ -238,6 +241,7 @@ def parse_result(self, result: list[Generation], *, partial: bool = False) -> An","                 If `False`, the output will be the full JSON object."," ","         Raises:","+            ModelRefusalError: If the model refused to answer.","             OutputParserException: If the generation is not a chat generation."," ","         Returns:","@@ -248,6 +252,7 @@ def parse_result(self, result: list[Generation], *, partial: bool = False) -> An","             msg = \"This output parser can only be used with a chat generation.\"","             raise OutputParserException(msg)","         message = generation.message","+        raise_if_refused(message)","         if isinstance(message, AIMessage) and message.tool_calls:","             parsed_tool_calls = [dict(tc) for tc in message.tool_calls]","             for tool_call in parsed_tool_calls:","@@ -326,6 +331,7 @@ def parse_result(self, result: list[Generation], *, partial: bool = False) -> An","             The parsed Pydantic objects."," ","         Raises:","+            ModelRefusalError: If the model refused to answer.","             ValueError: If the tool call arguments are not a dict.","             ValidationError: If the tool call arguments do not conform to the Pydantic","                 model."],"additions":6,"deletions":0,"truncated":false},{"path":"libs/core/langchain_core/output_parsers/pydantic.py","lines":["@@ -67,6 +67,7 @@ def parse_result(","                 have been returned so far."," ","         Raises:","+            ModelRefusalError: If the model refused to answer.","             OutputParserException: If the result is not valid JSON or does not conform","                 to the Pydantic model."," "],"additions":1,"deletions":0,"truncated":false},{"path":"libs/core/tests/unit_tests/messages/block_translators/test_openai.py","lines":["@@ -361,8 +361,8 @@ def test_compat_responses_v03() -> None:","             \"id\": \"msg_123\",","         },","         {","-            \"type\": \"non_standard\",","-            \"value\": {\"type\": \"refusal\", \"refusal\": \"I cannot assist with that.\"},","+            \"type\": \"refusal\",","+            \"refusal\": \"I cannot assist with that.\",","         },","         {","             \"type\": \"tool_call\","],"additions":2,"deletions":2,"truncated":false},{"path":"libs/core/tests/unit_tests/messages/test_imports.py","lines":["@@ -4,6 +4,7 @@","     \"NotificationMetadata\",","     \"add_notification_metadata\",","     \"get_notification_metadata\",","+    \"RefusalContentBlock\",","     \"MessageLikeRepresentation\",","     \"_message_from_dict\",","     \"AIMessage\","],"additions":1,"deletions":0,"truncated":false},{"path":"libs/core/tests/unit_tests/messages/test_refusal.py","lines":["@@ -0,0 +1,213 @@","+\"\"\"Standard refusal blocks and provider translations.\"\"\"","+","+import pytest","+","+from langchain_core.exceptions import ModelRefusalError","+from langchain_core.messages import (","+    AIMessage,","+    AIMessageChunk,","+    RefusalContentBlock,","+    convert_to_openai_messages,","+)","+","+STOP_DETAILS = {","+    \"type\": \"refusal\",","+    \"category\": \"cyber\",","+    \"explanation\": \"Blocked under the usage policy.\",","+}","+","+","+def _refusal(message: AIMessage) -> RefusalContentBlock | None:","+    for block in message.content_blocks:","+        if block[\"type\"] == \"refusal\":","+            return block","+    return None","+","+","+@pytest.mark.parametrize(\"message_cls\", [AIMessage, AIMessageChunk])","+def test_openai_legacy_refusal(message_cls: type[AIMessage]) -> None:","+    message = message_cls(","+        content=\"\",","+        additional_kwargs={\"refusal\": \"I can't help with that.\"},","+        response_metadata={\"model_provider\": \"openai\"},","+    )","+    expected: RefusalContentBlock = {","+        \"type\": \"refusal\",","+        \"refusal\": \"I can't help with that.\",","+    }","+    if message_cls is AIMessageChunk:","+        expected[\"index\"] = \"lc_refusal\"","+    assert message.content_blocks == [expected]","+","+","+def test_openai_responses_refusal() -> None:","+    message = AIMessage(","+        content=[","+            {","+                \"type\": \"refusal\",","+                \"refusal\": \"blocked\",","+                \"id\": \"msg_1\",","+                \"phase\": \"final_answer\",","+                \"index\": 2,","+            }","+        ],","+        response_metadata={\"model_provider\": \"openai\"},","+    )","+    assert message.content_blocks == [","+        {","+            \"type\": \"refusal\",","+            \"refusal\": \"blocked\",","+            \"id\": \"msg_1\",","+            \"index\": 2,","+            \"extras\": {\"phase\": \"final_answer\"},","+        }","+    ]","+","+","+def test_anthropic_refusal_from_stop_details() -> None:","+    message = AIMessage(","+        content=[],","+        response_metadata={","+            \"model_provider\": \"anthropic\",","+            \"stop_reason\": \"refusal\",","+            \"stop_details\": STOP_DETAILS,","+        },","+    )","+    assert message.content_blocks == [","+        {","+            \"type\": \"refusal\",","+            \"refusal\": \"Blocked under the usage policy.\",","+            \"index\": \"lc_refusal\",","+            \"extras\": {\"category\": \"cyber\"},","+        }","+    ]","+","+","+def test_anthropic_refusal_without_stop_details() -> None:","+    message = AIMessage(","+        content=[],","+        response_metadata={\"model_provider\": \"anthropic\", \"stop_reason\": \"refusal\"},","+    )","+    assert message.content_blocks == [","+        {\"type\": \"refusal\", \"refusal\": \"\", \"index\": \"lc_refusal\"}","+    ]","+","+","+def test_anthropic_partial_output_kept_before_refusal() -> None:","+    message = AIMessage(","+        content=\"Here is\",","+        response_metadata={\"model_provider\": \"anthropic\", \"stop_reason\": \"refusal\"},","+    )","+    assert message.content_blocks == [","+        {\"type\": \"text\", \"text\": \"Here is\"},","+        {\"type\": \"refusal\", \"refusal\": \"\", \"index\": \"lc_refusal\"},","+    ]","+","+","+def test_anthropic_streamed_refusal() -> None:","+    first = AIMessageChunk(","+        content=[{\"type\": \"text\", \"text\": \"Here is\", \"index\": 0}],","+        response_metadata={\"model_provider\": \"anthropic\"},","+    )","+    last = AIMessageChunk(","+        content=[],","+        response_metadata={","+            \"model_provider\": \"anthropic\",","+            \"stop_reason\": \"refusal\",","+            \"stop_details\": STOP_DETAILS,","+        },","+        chunk_position=\"last\",","+    )","+    assert _refusal(last) == _refusal(first + last)","+    assert [block[\"type\"] for block in (first + last).content_blocks] == [","+        \"text\",","+        \"refusal\",","+    ]","+","+","+def test_ordinary_text_not_refused() -> None:","+    message = AIMessage(","+        \"I cannot help.\",","+        response_metadata={\"model_provider\": \"anthropic\", \"stop_reason\": \"end_turn\"},","+    )","+    assert _refusal(message) is None","+","+","+def test_error_from_refusal() -> None:","+    message = AIMessage(","+        content=[],","+        response_metadata={","+            \"model_provider\": \"anthropic\",","+            \"stop_reason\": \"refusal\",","+            \"stop_details\": STOP_DETAILS,","+        },","+    )","+    refusal = _refusal(message)","+    assert refusal is not None","+    error = ModelRefusalError.from_refusal(refusal, raw_message=message)","+    assert str(error) == (","+        \"Model refused to produce the requested output (category='cyber'): \"","+        \"Blocked under the usage policy.\"","+    )","+    assert error.raw_message is message","+","+","+def test_error_from_refusal_without_text() -> None:","+    block: RefusalContentBlock = {\"type\": \"refusal\", \"refusal\": \"\"}","+    message = AIMessage(content_blocks=[block])","+    error = ModelRefusalError.from_refusal(block, raw_message=message)","+    assert str(error) == \"Model refused to produce the requested output\"","+","+","+def test_anthropic_native_refusal_block_not_duplicated() -> None:","+    block = {\"type\": \"refusal\", \"refusal\": \"No.\"}","+    message = AIMessage(","+        content=[block],","+        response_metadata={\"model_provider\": \"anthropic\", \"stop_reason\": \"refusal\"},","+    )","+    assert message.content_blocks == [block]","+","+","+@pytest.mark.parametrize(\"stop_details\", [None, \"unexpected\", [\"refusal\"]])","+def test_anthropic_refusal_with_malformed_stop_details(stop_details: object) -> None:","+    message = AIMessage(","+        content=[],","+        response_metadata={","+            \"model_provider\": \"anthropic\",","+            \"stop_reason\": \"refusal\",","+            \"stop_details\": stop_details,","+        },","+    )","+    assert _refusal(message) == {","+        \"type\": \"refusal\",","+        \"refusal\": \"\",","+        \"index\": \"lc_refusal\",","+    }","+","+","+def test_error_from_openai_refusal() -> None:","+    message = AIMessage(","+        content=\"\",","+        additional_kwargs={\"refusal\": \"I can't help with that.\"},","+        response_metadata={\"model_provider\": \"openai\", \"finish_reason\": \"stop\"},","+    )","+    refusal = _refusal(message)","+    assert refusal is not None","+    error = ModelRefusalError.from_refusal(refusal, raw_message=message)","+    assert str(error) == (","+        \"Model refused to produce the requested output: I can't help with that.\"","+    )","+","+","+def test_convert_to_openai_messages_refusal_blocks() -> None:","+    message = AIMessage(","+        content=[","+            {\"type\": \"text\", \"text\": \"Here is\"},","+            {\"type\": \"refusal\", \"refusal\": \"\", \"index\": \"lc_refusal\"},","+            {\"type\": \"refusal\", \"refusal\": \"No.\", \"extras\": {\"x\": 1}, \"index\": 1},","+        ]","+    )","+    assert convert_to_openai_messages(message)[\"content\"] == [","+        {\"type\": \"text\", \"text\": \"Here is\"},","+        {\"type\": \"refusal\", \"refusal\": \"No.\"},","+    ]"],"additions":213,"deletions":0,"truncated":false},{"path":"libs/core/tests/unit_tests/output_parsers/test_refusal.py","lines":["@@ -0,0 +1,112 @@","+\"\"\"Structured output parsers raise `ModelRefusalError` for refusals.\"\"\"","+","+from typing import Any","+","+import pytest","+from pydantic import BaseModel","+","+from langchain_core.exceptions import ModelRefusalError","+from langchain_core.language_models import GenericFakeChatModel, LanguageModelInput","+from langchain_core.messages import AIMessage","+from langchain_core.output_parsers import (","+    JsonOutputKeyToolsParser,","+    JsonOutputParser,","+    JsonOutputToolsParser,","+    PydanticOutputParser,","+    PydanticToolsParser,","+)","+from langchain_core.output_parsers.base import BaseOutputParser","+from langchain_core.outputs import ChatGeneration","+from langchain_core.runnables import Runnable","+","+","+class Answer(BaseModel):","+    answer: str","+","+","+REFUSAL = AIMessage(","+    content=[],","+    response_metadata={","+        \"model_provider\": \"anthropic\",","+        \"stop_reason\": \"refusal\",","+        \"stop_details\": {\"type\": \"refusal\", \"category\": \"cyber\", \"explanation\": None},","+    },","+)","+","+PARSERS: list[BaseOutputParser[Any]] = [","+    JsonOutputParser(),","+    PydanticOutputParser(pydantic_object=Answer),","+    JsonOutputToolsParser(),","+    JsonOutputKeyToolsParser(key_name=\"Answer\", first_tool_only=True),","+    PydanticToolsParser(tools=[Answer], first_tool_only=True),","+]","+","+","+@pytest.mark.parametrize(\"parser\", PARSERS, ids=lambda p: type(p).__name__)","+@pytest.mark.parametrize(\"partial\", [False, True])","+def test_parser_raises_on_refusal(","+    parser: BaseOutputParser[Any], *, partial: bool","+) -> None:","+    with pytest.raises(ModelRefusalError) as exc_info:","+        parser.parse_result([ChatGeneration(message=REFUSAL)], partial=partial)","+    assert \"cyber\" in str(exc_info.value)","+    assert exc_info.value.raw_message is REFUSAL","+","+","+class _ToolFakeChatModel(GenericFakeChatModel):","+    def bind_tools(","+        self,","+        tools: Any,  # noqa: ARG002","+        **kwargs: Any,  # noqa: ARG002","+    ) -> Runnable[LanguageModelInput, AIMessage]:","+        return self","+","+","+def test_with_structured_output_raises_on_refusal() -> None:","+    model = _ToolFakeChatModel(messages=iter([REFUSAL]))","+    with pytest.raises(ModelRefusalError):","+        model.with_structured_output(Answer).invoke(\"hi\")","+","+","+def test_with_structured_output_include_raw_reports_refusal() -> None:","+    model = _ToolFakeChatModel(messages=iter([REFUSAL]))","+    result = model.with_structured_output(Answer, include_raw=True).invoke(\"hi\")","+    assert isinstance(result, dict)","+    assert isinstance(result[\"parsing_error\"], ModelRefusalError)","+    assert result[\"parsed\"] is None","+","+","+def test_tool_parser_raises_when_refusal_follows_tool_call() -> None:","+    message = AIMessage(","+        content=[],","+        tool_calls=[{\"name\": \"Answer\", \"args\": {\"answer\": \"x\"}, \"id\": \"1\"}],","+        response_metadata={\"model_provider\": \"anthropic\", \"stop_reason\": \"refusal\"},","+    )","+    with pytest.raises(ModelRefusalError):","+        PydanticToolsParser(tools=[Answer]).parse_result(","+            [ChatGeneration(message=message)]","+        )","+","+","+@pytest.mark.parametrize(","+    \"message\",","+    [","+        AIMessage(","+            '{\"answer\": \"no\"}',","+            response_metadata={","+                \"model_provider\": \"anthropic\",","+                \"stop_reason\": \"end_turn\",","+            },","+        ),","+        AIMessage(","+            '{\"answer\": \"no\"}',","+            additional_kwargs={\"refusal\": None},","+            response_metadata={\"model_provider\": \"openai\"},","+        ),","+    ],","+    ids=[\"anthropic\", \"openai\"],","+)","+def test_parser_parses_non_refusal(message: AIMessage) -> None:","+    assert JsonOutputParser().parse_result([ChatGeneration(message=message)]) == {","+        \"answer\": \"no\"","+    }"],"additions":112,"deletions":0,"truncated":false},{"path":"libs/core/tests/unit_tests/test_exceptions.py","lines":["@@ -0,0 +1,20 @@","+from langchain_core.exceptions import LangChainException, ModelError, ModelRefusalError","+from langchain_core.messages import AIMessage","+","+","+def test_model_refusal_error() -> None:","+    raw = AIMessage(content=[], response_metadata={\"stop_reason\": \"refusal\"})","+    err = ModelRefusalError(\"Blocked.\", raw_message=raw)","+","+    assert isinstance(err, ModelError)","+    assert isinstance(err, LangChainException)","+    assert err.is_retryable is False","+    assert err.raw_message is raw","+    assert str(err) == \"Blocked.\"","+","+","+def test_model_refusal_error_defaults() -> None:","+    err = ModelRefusalError()","+","+    assert str(err) == \"Model refused to produce the requested output\"","+    assert err.raw_message is None"],"additions":20,"deletions":0,"truncated":false},{"path":"libs/langchain_v1/langchain/agents/middleware/__init__.py","lines":["@@ -11,6 +11,7 @@"," )"," from langchain.agents.middleware.model_call_limit import ModelCallLimitMiddleware"," from langchain.agents.middleware.model_fallback import ModelFallbackMiddleware","+from langchain.agents.middleware.model_refusal import ModelRefusalMiddleware"," from langchain.agents.middleware.model_retry import ModelRetryMiddleware"," from langchain.agents.middleware.pii import PIIDetectionError, PIIMatch, PIIMiddleware"," from langchain.agents.middleware.provider_tool_search import ProviderToolSearchMiddleware","@@ -68,6 +69,7 @@","     \"ModelCallLimitMiddleware\",","     \"ModelCallResult\",","     \"ModelFallbackMiddleware\",","+    \"ModelRefusalMiddleware\",","     \"ModelRequest\",","     \"ModelResponse\",","     \"ModelRetryMiddleware\","],"additions":2,"deletions":0,"truncated":false},{"path":"libs/langchain_v1/langchain/agents/middleware/model_refusal.py","lines":["@@ -0,0 +1,73 @@","+\"\"\"Opt-in error handling for explicit model refusals.\"\"\"","+","+from __future__ import annotations","+"],"additions":4,"deletions":0,"truncated":false}],"additions":545,"deletions":9,"truncated":true,"file_count":18},"error":null,"fetched_at":"2026-11-04T16:05:30.553065+00:00"}