{"id":"bb2ff9b1cc8dc12c11eb323f1ac3b26339edf43d","axis":"silent","repo":"changesets/changesets","sha":"bb2ff9b1cc8dc12c11eb323f1ac3b26339edf43d","parsed":{"files":[{"path":".changeset/staged-publishing.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@changesets/cli\": minor","+\"@changesets/config\": minor","+\"@changesets/types\": minor","+---","+","+Add support for staging packages for approval before they go live on npm. You can enable it with `\"stagedPublishing\": true` in your Changesets config or by running `changeset publish --stage`. If staging is enabled in your config, you can use `--no-stage` to publish directly."],"additions":7,"deletions":0,"truncated":false},{"path":"docs/guide/cli.md","lines":["@@ -115,6 +115,14 @@ Published versions are tagged on npm with `latest` by default. You may want to c"," $ changeset publish --tag beta"," ```"," ","+### Staged publishing","+","+`--stage` stages packages for later approval instead of publishing","+them immediately. `--no-stage` disables a `stagedPublishing` config value for","+one invocation.","+","+Staged publishing requires npm >=11.15.0, pnpm >=11.3.0, or Yarn >=4.16.0. Older supported versions can still publish directly with `--no-stage`.","+"," ## publish-plan"," "," <div v-html=\"data.publishPlanHelpMessage\" />"],"additions":8,"deletions":0,"truncated":false},{"path":"docs/guide/config.md","lines":["@@ -12,6 +12,7 @@ Changesets keeps its configuration in `.changeset/config.json`. The default conf","   \"baseBranch\": \"main\",","   \"changedFilePatterns\": [\"**\"],","   \"format\": \"auto\",","+  \"stagedPublishing\": false,","   \"privatePackages\": { \"version\": false, \"tag\": false },","   \"updateInternalDependencies\": \"patch\",","   \"ignore\": [],","@@ -284,3 +285,12 @@ Add dependent packages to the release (if they are not already a part of it) wit"," - **Default:** `false`"," "," When set to `true`, Changesets will only bump peer dependents when `peerDependencies` are leaving the range.","+","+## `stagedPublishing`","+","+- **Type:** `boolean`","+- **Default:** `false`","+","+When enabled, `changeset publish` stages package versions for later","+approval instead of publishing them immediately. It can be overridden per","+invocation with `--stage` or `--no-stage`."],"additions":10,"deletions":0,"truncated":false},{"path":"packages/cli/src/cli.test.ts","lines":["@@ -196,6 +196,14 @@ const tests: CommandTest[] = [","           output: \"output.ndjson\",","         },","       },","+      {","+        args: [\"--stage\"],","+        options: { gitTag: true, stage: true },","+      },","+      {","+        args: [\"--no-stage\"],","+        options: { gitTag: true, stage: false },","+      },","     ],","   },","   {"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/cli/src/cli.ts","lines":["@@ -124,6 +124,7 @@ cli","   .option(\"--tag <name>\", \"Publish with the given npm dist-tag\")","   .option(\"--from-pack-dir <dir>\", \"Publish from a packed output directory\")","   .option(\"--git-tag\", \"Create a git tag for the release\", { default: true })","+  .option(\"--stage\", \"Stage packages for approval instead of publishing\")","   .action(async (options) => {","     withEnvOptions(normalizeOptions(options));","     const { publish } = await import(\"./commands/publish/index.ts\");"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/cli/src/commands/init/__tests__/command.test.ts","lines":["@@ -303,6 +303,7 @@ describe(\"init\", () => {","       \"fixed\",","       \"linked\",","       \"updateInternalDependencies\",","+      \"stagedPublishing\",","     ]);","   });"," });"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/cli/src/commands/publish/README.md","lines":["@@ -1,8 +1,8 @@"," ## Returned values from `{PM}.publish()`"," ","-- `published`","+- `success { stageId?: string }` (the input selects publish or stage)"," - `failed` (generic error)","-- `failed:already-published`","+- `failed:already-done`"," - `failed:needs-2fa { authUrl?: string; doneUrl?: string }`"," "," ## Publish Flow","@@ -10,7 +10,7 @@"," 1. Process the publish plan one topological chunk at a time."," 2. In a TTY, publish sequentially until a non-interactive publish succeeds.","    - A provided OTP is reused while it remains valid and discarded before an interactive retry.","-   - Interactive successes and `failed:already-published` continue sequentially.","+   - Interactive successes and `failed:already-done` continue sequentially."," 3. Bulk publish the rest of the current chunk.","    - Successful and already-published packages are finished.","    - Generic failures are reported and prevent later chunks from publishing.","@@ -18,3 +18,13 @@","    - Mixed generic and 2FA failures are reported and stop publishing."," 4. In a non-TTY, start in bulk mode and report 2FA as a regular failure."," 5. List the results and create git tags for successful publishes and tag-only releases in every processed chunk, including a chunk that failed.","+","+Repeating a publish or stage is OK. Switching between them is an error.","+","+npm uses the same stage-conflict message for already-staged and already-published versions. We check again using the package manager's `info()`:","+","+- Version is published -> fail.","+- Version is absent -> assume it is already staged and continue.","+- Lookup fails -> fail.","+","+A version removed with `npm unpublish` also appears absent, so it can be mistaken for an already-staged version."],"additions":13,"deletions":3,"truncated":false},{"path":"packages/cli/src/commands/publish/getPublishTool.ts","lines":["@@ -1,41 +1,57 @@"," import type { Packages } from \"@changesets/types\";"," import { detect } from \"package-manager-detector/detect\";","+import semverSatisfies from \"semver/functions/satisfies.js\";"," import { exec } from \"tinyexec\";"," import * as npm from \"../../lib/npm.ts\";"," import * as pnpm from \"../../lib/pnpm.ts\";"," import type { PublishTool } from \"