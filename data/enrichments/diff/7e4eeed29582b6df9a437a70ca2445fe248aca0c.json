         return x + torch.arange(16.0).view(4, 4).to(x.device)","+","+        @torch.compiler.nested_compile_region","+        def scale(x):","+            return x * 2","+","+        class NestedRegion(torch.nn.Module):","+            def forward(self, x):","+                return scale(x) + scale(x + 1)","+","+        class UnusedInput(torch.nn.Module):","+            def forward(self, x, y):","+                return x + 1","+","+        class Attention(torch.nn.Module):","+            def forward(self, q):","+                # Tagged random for its dropout, which is 0 here.","+                return torch.nn.functional.scaled_dot_product_attention(q, q, q)","+","+        class StreamsAttribute(torch.nn.Module):","+            def __init__(self):","+                super().__init__()","+                self.streams = torch.nn.ModuleList([torch.nn.Linear(4, 4)])","+","+            def forward(self, x):","+                return self.streams[0](x)","+","+        class InBoundsAsStrided(torch.nn.Module):","+            def forward(self, x):","+                # Within the input's 16 elements, at an explicit offset.","+                return x.as_strided((2, 2), (4, 1), 1) * 2","+","+        x = torch.randn(4, 4, device=self.device)","+        q = torch.randn(1, 2, 16, 64, device=self.device)","+        for model, inputs in (","+            (torch.nn.Sequential(torch.nn.Linear(4, 8), torch.nn.ReLU()), (x,)),","+            (CpuConstant(), (x,)),","+            (NestedRegion(), (x,)),","+            (UnusedInput(), (x, torch.randn(3, device=self.device))),","+            (StreamsAttribute().to(self.device), (x,)),","+            (InBoundsAsStrided(), (x,)),","+            # Different attention backends.","+            (Attention(), (q,)),","+            *([(Attention(), (q.bfloat16(),))] if SM80OrLater else []),","+        ):","+            # The C API PR later in the stack captures and replays each of","+            # these through run_with_lazy_cuda_graphs.","+            with self.subTest(type(model).__name__):","+                self.check_model(","+                    model, inputs, options={\"aot_inductor.cudagraphs\": True}","+                )","+","+    @runOnRocm","+    def test_aot_cudagraphs_rejects_rocm(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        with self.assertRaisesRegex(Exception, \"ROCm isn't supported yet\"):","+            AOTIRunnerUtil.compile(","+                torch.nn.Linear(4, 4).to(self.device),","+                (torch.randn(2, 4, device=self.device),),","+                inductor_configs={\"aot_inductor.cudagraphs\": True},","+            )","+","+    def test_aot_cudagraphs_rejects_non_cuda_model(self):","+        if self.device == \"cuda\":","+            raise unittest.SkipTest(\"requires a non-CUDA device\")","+        with self.assertRaisesRegex(Exception, \"doesn't run on CUDA\"):","+            AOTIRunnerUtil.compile(","+                torch.nn.Linear(4, 4).to(self.device),","+                (torch.randn(2, 4, device=self.device),),","+                inductor_configs={\"aot_inductor.cudagraphs\": True},","+            )","+","+    @xfailIfROCm","+    def test_aot_cudagraphs_rejects_uncapturable_models(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+","+        class CpuOp(torch.nn.Module):","+            def forward(self, x):","+                return (x.cpu() * 2).to(x.device)","+","+        class Item(torch.nn.Module):","+            def forward(self, x):","+                return x * x.sum().item()","+","+        class MutatesInput(torch.nn.Module):","+            def forward(self, x):","+                x.add_(1)","+                return x * 2","+","+        class Cond(torch.nn.Module):","+            def forward(self, x):","+                return torch.cond(x.sum() > 0, lambda x: x + 1, lambda x: x - 1, (x,))","+","+        class RecordsAndSyncsEvent(torch.nn.Module):","+            def forward(self, x):","+                s = torch.cuda.Stream()","+                with torch.cuda.stream(s):","+                    y = x + 1","+                event = s.record_event()","+                event.synchronize()","+                return y * 2","+","+        class SyncsStream(torch.nn.Module):","+            def forward(self, x):","+                s = torch.cuda.Stream()","+                with torch.cuda.stream(s):","+                    y = x + 1","+                s.synchronize()","+                return y * 2","+","+        class SyncsDevice(torch.nn.Module):","+            def forward(self, x):","+                y = x + 1","+                torch.cuda.synchronize()","+                return y * 2","+","+        class Random(torch.nn.Module):","+            def forward(self, x):","+                return x + torch.rand_like(x)","+","+        class AttentionDropout(torch.nn.Module):","+            def forward(self, x):","+                q = x.view(1, 1, 4, 4)","+                return torch.nn.functional.scaled_dot_product_attention(","+                    q, q, q, dropout_p=0.5","+                )","+","+        class SideStream(torch.nn.Module):","+            def forward(self, x):","+                s = torch.cuda.Stream()","+                with torch.cuda.stream(s):","+                    y = x + 1","+                return y * 2","+","+        class Effectful(torch.nn.Module):","+            def forward(self, x):","+                # Checks for errors with an effectful op.","+                return torch.linalg.inv(x)","+","+        class InputAsStrided(torch.nn.Module):","+            def forward(self, x):","+                # Past the end of a (4, 4) input.","+                return x.as_strided((4, 4), (4, 1), 1) * 2","+","+        class ReturnsCpuConstant(torch.nn.Module):","+            def __init__(self):","+                super().__init__()","+                # Larger than the constants Inductor inlines as literals.","+                self.register_buffer(\"table\", torch.arange(16.0))","+","+            def forward(self, x):","+                return x * 2, self.table","+","+        class WhileLoop(torch.nn.Module):","+            def forward(self, x):","+                return torch._higher_order_ops.while_loop(","+                    lambda i, x: i < 3,","+                    lambda i, x: (i + 1, x * 2),","+                    (x.new_zeros(()), x),","+                )[1]","+","+        for model, reason, configs in (","+            (CpuOp(), \"cpu device\", {}),","+            # AOT mode lowers without graph partitioning, which skips CPU ops.","+            (CpuOp(), \"cpu device\", {\"triton.cudagraphs\": True}),","+            (Item(), \"incompatible op\", {}),","+            (MutatesInput(), r\"mutated inputs \\(1 instances\\)\\. Found from\", {}),","+            (Cond(), \"control flow operator: torch.cond\", {}),","+            (RecordsAndSyncsEvent(), \"it uses stream op streams.record_event\", {}),","+            (SyncsStream(), \"it uses stream op streams.synchronize_stream\", {}),","+            (SyncsDevice(), \"it uses stream op streams.synchronize_device\", {}),","+            (Random(), r\"it uses random numbers \\(prims.inductor_seeds\", {}),","+            (AttentionDropout(), \"it uses random numbers\", {}),","+            (SideStream(), \"it uses a side stream\", {}),","+            (Effectful(), \"_linalg_check_errors.* has side effects\", {}),","+            (WhileLoop(), \"control flow operator: torch.while_loop\", {}),","+            (InputAsStrided(), \"reads a graph input through as_strided\", {}),","+            (ReturnsCpuConstant(), \"output 1 is on cpu\", {}),","+        ):","+            with (","+                self.subTest(type(model).__name__, **configs),","+                self.assertRaisesRegex(Exception, f\"CUDA graph: .*{reason}\"),","+            ):","+                AOTIRunnerUtil.compile(","+                    model,","+                    (torch.randn(4, 4, device=self.device),),","+                    inductor_configs={\"aot_inductor.cudagraphs\": True, **configs},","+                )","+","+        class MutatesOut(torch.nn.Module):","+            def forward(self, x, out):","+                torch.add(x, 1, out=out)","+                return out * 2","+","+        class UnusedInput(torch.nn.Module):","+            def forward(self, x, unused):","+                return x.relu()","+","+        x = torch.randn(4, 4, device=self.device)","+        # The write-back copy_, out's only user, has no stack trace.","+        with self.assertRaisesRegex(","+            Exception, r\"mutated inputs \\(1 instances\\)\\. Found from\"","+        ):","+            AOTIRunnerUtil.compile(","+                MutatesOut(),","+                (x, torch.randn(4, 4, device=self.device)),","+                inductor_configs={\"aot_inductor.cudagraphs\": True},","+            )","+","+        class ReadsPastSlice(torch.nn.Module):","+            def forward(self, x):","+                # The slice's storage reaches further than its elements.","+                return x.as_strided((4, 8), (8, 1)) * 2","+","+        class ReadsSliceGaps(torch.nn.Module):","+            def forward(self, x):","+                # As many elements as the slice has, but through its gaps.","+                return x.as_strided((2, 8), (8, 1)) * 2","+","+        for model in (ReadsPastSlice(), ReadsSliceGaps()):","+            with (","+                self.subTest(type(model).__name__),","+                self.assertRaisesRegex(","+                    Exception, \"CUDA graph: .*reads a graph input through as_strided\"","+                ),","+            ):","+                AOTIRunnerUtil.compile(","+                    model,","+                    (torch.randn(4, 8, device=self.device)[:, :4],),","+                    inductor_configs={\"aot_inductor.cudagraphs\": True},","+                )","+        devices = [\"cpu\"]","+        if torch.cuda.device_count() >= 2:","+            devices.append(f\"{GPU_TYPE}:1\")","+        for device in devices:","+            msg = f\"CUDA graph: input 1 is on {device}\"","+            with (","+                self.subTest(\"UnusedInput\", device=device),","+                self.assertRaisesRegex(Exception, msg),","+            ):","+                AOTIRunnerUtil.compile(","+                    UnusedInput(),","+                    (x, torch.randn(4, device=device)),","+                    inductor_configs={\"aot_inductor.cudagraphs\": True},","+                )","+","+    @xfailIfROCm","+    def test_aot_cudagraphs_checks_subgraphs(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+","+        def cpu_op(x):","+            return (x.cpu() * 2).to(x.device)","+","+        def item(x):","+            return x * x.sum().item()","+","+        for fn, reason in ((cpu_op, \"cpu device\"), (item, \"incompatible op\")):","+            with (","+                self.subTest(fn.__name__),","+                torch._dynamo.config.patch(","+                    enable_invoke_subgraph_regional_compile=True,","+                    inline_single_use_invoke_subgraph=False,","+                ),","+            ):","+                region = torch.compiler.nested_compile_region(fn)","+","+                class Model(torch.nn.Module):","+                    def forward(self, x):","+                        return region(x) + region(x * 2)","+","+                x = torch.randn(4, 4, device=self.device)","+                # The failing op must be inside a subgraph, not inlined.","+                graph = torch.export.export(Model(), (x,)).graph","+                op = torch.ops.higher_order.invoke_subgraph","+                self.assertTrue(graph.find_nodes(op=\"call_function\", target=op))","+                with self.assertRaisesRegex(Exception, f\"CUDA graph: .*{reason}\"):","+                    AOTIRunnerUtil.compile(","+                        Model(),","+                        (x,),","+                        inductor_configs={\"aot_inductor.cudagraphs\": True},","+                    )","+","+    @xfailIfROCm","+    @requires_multigpu()","+    def test_aot_cudagraphs_rejects_multi_device_model(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+","+        class Model(torch.nn.Module):","+            def forward(self, x):","+                return (x.to(f\"{GPU_TYPE}:1\") * 2).to(x.device)","+","+        with self.assertRaisesRegex(Exception, \"CUDA graph: .*multiple devices\"):","+            AOTIRunnerUtil.compile(","+                Model(),","+                (torch.randn(4, 4, device=self.device),),","+                inductor_configs={\"aot_inductor.cudagraphs\": True},","+            )","+","     def test_custom_op_in_subgraph(self):","         with torch.library._scoped_library(\"mylib\", \"FRAGMENT\") as lib:","             torch.library.define("],"additions":312,"deletions":0,"truncated":false},{"path":"test/inductor/test_cudagraph_trees.py","lines":["@@ -5460,6 +5460,19 @@ def f(x):","             eager_result = f(example_input)","             self.assertEqual(compiled_result, eager_result)"," ","+        # cpp_wrapper skips cudagraphs with graph partitioning on.","+        @torch._inductor.config.patch({\"cpp_wrapper\": True, \"graph_partition\": False})","+        def test_cpp_wrapper_cpu_constant(self):","+            # The CPU constant is folded into a CUDA constant, so nothing runs","+            # on the CPU and the graph is still captured.","+            def f(x):","+                return x + torch.arange(16.0).view(4, 4).to(x.device)","+","+            compiled = torch.compile(f, mode=\"reduce-overhead\")","+            x = torch.randn(4, 4, device=\"cuda\")","+            self.assertEqual(self.run_twc(compiled, x), f(x))","+            self.assertEqual(counters[\"inductor\"][\"cudagraph_skips\"], 0)","+","         @torch._inductor.config.patch(\"graph_partition\", True)","         def test_graph_partition(self):","             def f(x, y):"],"additions":13,"deletions":0,"truncated":false},{"path":"torch/_inductor/compile_fx.py","lines":["@@ -65,6 +65,7 @@"," from torch._inductor.codecache import code_hash, FxGraphCache, output_code_log"," from torch._inductor.cudagraph_utils import (","     BoxedDeviceIndex,","+    check_aot_cudagraphs,","     cudagraph_trees_clone_live_user_visible_outputs,","     cudagraphs_log,","     format_default_skip_message,","@@ -1878,6 +1879,8 @@ def _fx_graph_runnable_payload() -> str:","                                 output_strides.append(None)"," ","                     _check_triton_bf16_support(graph)","+                    if graph.aot_mode and config.aot_inductor.cudagraphs:","+                        check_aot_cudagraphs(graph)"," ","                     # TODO: The switching between AOT mode and not here is a bit","                     # messy, but it's localized to the block of code below so I'm"],"additions":3,"deletions":0,"truncated":false},{"path":"torch/_inductor/config.py","lines":["@@ -2779,6 +2779,10 @@ class aot_inductor:","     # flag to decide whether to create a submodule for constant graph.","     use_runtime_constant_folding: bool = False"," ","+    # Fail the compile unless AOTI's CUDA graph runtime can capture and correctly","+    # replay the whole model. Only checks; the generated code doesn't change.","+    cudagraphs: bool = False","+","     # flag to force weight to be appended to the shared library and mapped by the runtime","     # rather than embedded into the data section. Needed to support 1B+ parameter models","     force_mmap_weights: bool = False"],"additions":4,"deletions":0,"truncated":false},{"path":"torch/_inductor/cudagraph_utils.py","lines":["@@ -2,23 +2,26 @@"," from __future__ import annotations"," "," import dataclasses","+import operator"," from collections.abc import Callable"," from enum import Enum"," from typing import Any, Literal, TYPE_CHECKING, TypeVar"," "," import torch","+import torch.utils._pytree as pytree"," from torch._dynamo.utils import counters, get_metrics_context"," from torch._inductor.utils import GraphPartitionMap, InputType"," from torch._subclasses.fake_tensor import get_plain_tensors, is_fake"," from torch.utils._ordered_set import OrderedSet"," "," from . import config","-from .utils import is_using_cudagraph_partition","+from .utils import get_first_incompatible_cudagraph_node, is_using_cudagraph_partition"," "," "," if TYPE_CHECKING:","-    from collections.abc import Sequence, Set as AbstractSet","+    from collections.abc import Iterator, Sequence, Set as AbstractSet"," ","+    from torch._inductor.graph import GraphLowering","     from torch._inductor.output_code import OutputCode"," "," _OC = TypeVar(\"_OC\", bound=\"OutputCode\")","@@ -201,14 +204,26 @@ class WrappedFunction:"," def get_mutating_use_stack_trace_from_node(","     placeholder_node: torch.fx.Node,"," ) -> str | None:","+    def stack_trace_of(use: torch.fx.Node) -> str | None:","+        if stack_trace := use.meta.get(\"stack_trace\", None):","+            return stack_trace","+        # Functionalization's write-back copy_ has no stack trace, but the op","+        # whose result it copies does.","+        if use.target is torch.ops.aten.copy_.default:","+            src = use.args[1]","+            if isinstance(src, torch.fx.Node):","+                return src.meta.get(\"stack_trace\", None)","+        return None","+","     # reinplaced uses might have a single, non-copy_ use","     if len(placeholder_node.users) == 1:","-        return next(iter(placeholder_node.users)).meta.get(\"stack_trace\", None)","+        return stack_trace_of(next(iter(placeholder_node.users)))"," ","     for use in placeholder_node.users:","-        if use.target is torch.ops.aten.copy_.default:","-            if stack_trace := use.meta.get(\"stack_trace\", None):","-                return stack_trace","+        if use.target is torch.ops.aten.copy_.default and (","+            stack_trace := stack_trace_of(use)","+        ):","+            return stack_trace"," ","     return None"," ","@@ -396,6 +411,144 @@ def check_lowering_disable_cudagraph(","     )"," "," ","+def _with_subgraphs(graph: GraphLowering) -> Iterator[GraphLowering]:","+    yield graph","+    for subgraph in graph.seen_subgraphs.values():","+        if subgraph.graph is not None:","+            yield from _with_subgraphs(subgraph.graph)","+","+","+def _with_fx_subgraphs(","+    module: torch.nn.Module, seen: OrderedSet[torch.fx.GraphModule] | None = None","+) -> Iterator[torch.fx.GraphModule]:","+    # Also covers higher-order ops whose bodies aren't lowered as subgraphs,","+    # e.g. the control_deps wrapping stream ops.","+    seen = OrderedSet() if seen is None else seen","+    if not isinstance(module, torch.fx.GraphModule) or module in seen:","+        return","+    seen.add(module)","+    yield module","+    for node in module.graph.find_nodes(op=\"get_attr\"):","+        yield from _with_fx_subgraphs(operator.attrgetter(node.target)(module), seen)","+","+","+def check_aot_cudagraphs(graph: GraphLowering) -> None:","+    \"\"\"Fails an AOTInductor compile with aot_inductor.cudagraphs=True unless","+    the graph and the subgraphs of its higher-order ops can be captured into a","+    CUDA graph and replayed correctly by AOTI's runtime. AOT mode lowers with","+    graph_partition off, so CPU nodes and partition-gated lowering reasons","+    (e.g. for while_loop) count.\"\"\"","+","+    def with_stack_trace(msg: str, stack_trace: str | None) -> str:","+        return f\"{msg}. Found from:\\n{stack_trace}\" if stack_trace else msg","+","+    def reason_at(msg: str, node: torch.fx.Node) -> str:","+        stack_trace = node.meta.get(\"stack_trace\") or _get_use_stack_trace(node)","+        return with_stack_trace(msg, stack_trace)","+","+    def first(","+        gm: torch.fx.GraphModule, pred: Callable[[torch.fx.Node], bool]","+    ) -> torch.fx.Node | None:","+        return next((n for n in gm.graph.nodes if pred(n)), None)","+","+    def incompatible_op(gm: torch.fx.GraphModule) -> str | None:","+        if node := get_first_incompatible_cudagraph_node(gm):","+            return reason_at(f\"incompatible op {node.target}\", node)","+        return None","+","+    def side_effect(gm: torch.fx.GraphModule) -> str | None:","+        # A replay wouldn't repeat the side effect.","+        if node := first(gm, lambda n: n.target is torch.ops.higher_order.with_effects):","+            return reason_at(f\"op {node.args[1]} has side effects\", node)","+        return None","+","+    # The generated code can't use side streams, or sync on the host (e.g.","+    # torch.cuda.synchronize), during a capture.","+    def stream_op(gm: torch.fx.GraphModule) -> str | None:","+        def is_stream_op(n: torch.fx.Node) -> bool:","+            target = n.target","+            return (","+                isinstance(target, torch._ops.OpOverload)","+                and target.namespace == \"streams\"","+            )","+","+        if node := first(gm, is_stream_op):","+            return reason_at(f\"it uses stream op {node.target}\", node)","+        return None","+","+    def side_stream(gm: torch.fx.GraphModule) -> str | None:","+        if node := first(gm, lambda n: graph._get_node_stream(n) is not None):","+            return reason_at(\"it uses a side stream\", node)","+        return None","+","+    def random_numbers(gm: torch.fx.GraphModule) -> str | None:","+        from torch._functorch.partitioners import is_rng_op","+","+        # Random numbers aren't supported yet: concurrent replays race on the","+        # generator's offset.","+        if node := first(gm, is_rng_op):","+            return reason_at(f\"it uses random numbers ({node.target})\", node)","+        return None","+","+    def find_reason