Exception(\"Test grammar is missing the Program rule\");","+\t}","+\trules.emplace(rule->name, make_uniq<CompiledGrammarRule>(rule->name, rule->transform_process));","+\treturn rules;","+}","+","+static vector<MatcherSuggestion> GetLiteralChoiceSuggestions(const Matcher &matcher) {","+\tvector<MatcherToken> tokens;","+\tTokenIterator iterator(tokens);","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator allocator;","+\tidx_t max_position = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, allocator, process_allocator, max_position);","+\tMatchState state(iterator, context);","+\tmatcher.AddSuggestion(state);","+\treturn suggestions;","+}","+","+TEST_CASE(\"Literal choice dispatch retains autocomplete metadata\", \"[api][grammar_extension]\") {","+\tauto compiled = CompiledGrammar::Create();","+\tauto grammar = ParsedGrammar::Parse(\"Program <- 'TABLE' / '(' / '.' / 'table'\");","+\tauto rules = CompileTestProgramRule(grammar);","+\tMatcherAllocator allocator;","+\tMatcherFactory factory(allocator, grammar, rules, compiled->GetKeywordHelper(), {});","+\tauto &root = factory.CreateRootMatcher(\"Program\").Cast<ListMatcher>();","+\tauto &choice = root.matchers[0].get().Cast<ChoiceMatcher>();","+\tvector<reference<Matcher>> children = choice.matchers;","+\tChoiceMatcher sequential(std::move(children));","+\tauto actual = GetLiteralChoiceSuggestions(choice);","+\tauto expected = GetLiteralChoiceSuggestions(sequential);","+\tREQUIRE(actual.size() == 3);","+\tREQUIRE(actual.size() == expected.size());","+\tfor (idx_t i = 0; i < actual.size(); i++) {","+\t\tREQUIRE(actual[i].type == expected[i].type);","+\t\tREQUIRE(actual[i].keyword.candidate == expected[i].keyword.candidate);","+\t\tREQUIRE(actual[i].keyword.score_bonus == expected[i].keyword.score_bonus);","+\t\tREQUIRE(actual[i].keyword.extra_char == expected[i].keyword.extra_char);","+\t\tREQUIRE(actual[i].keyword.candidate_type == expected[i].keyword.candidate_type);","+\t}","+}","+","+static LiteralChoiceTestResult MatchLiteralChoiceTest(const Matcher &matcher, const string &text, MatchMode mode) {","+\tvector<MatcherToken> tokens;","+\tif (!text.empty()) {","+\t\ttokens.emplace_back(text, 0, TokenType::KEYWORD);","+\t}","+\tTokenIterator iterator(tokens);","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator allocator;","+\tParserPackratCache packrat;","+\tidx_t max_position = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, allocator, process_allocator, max_position, mode,","+\t                     IdentifierCaseMode::PRESERVE_CASE, &packrat);","+\tMatchState state(iterator, context);","+\tauto result = matcher.MatchParseResult(state);","+\treturn {result.IsSuccess(), state.token_iterator.Position(), max_position,","+\t        result.HasParseResult() ? result.GetParseResult()->ToString() : string()};","+}","+","+TEST_CASE(\"Literal choice dispatch preserves ordered choice results\", \"[api][grammar_extension]\") {","+\tauto compiled = CompiledGrammar::Create();","+\tauto grammar = ParsedGrammar::Parse(\"Program <- 'SELECT' / 'FROM' / 'select' / 'WHERE' / '('\");","+\tauto rules = CompileTestProgramRule(grammar);","+\tMatcherAllocator allocator;","+\tMatcherFactory factory(allocator, grammar, rules, compiled->GetKeywordHelper(), {});","+\tauto &root = factory.CreateRootMatcher(\"Program\").Cast<ListMatcher>();","+\tauto &choice = root.matchers[0].get().Cast<ChoiceMatcher>();","+\tvector<reference<Matcher>> children = choice.matchers;","+\tChoiceMatcher sequential(std::move(children));","+\tauto table = compiled->GetKeywordHelper().GetLiteralTable();","+\tREQUIRE(table);","+\tREQUIRE(choice.matchers[0].get().Cast<KeywordMatcher>().GetDispatchLiteral(*table).IsValid());","+\tfor (auto &text : vector<string> {\"WHERE\", \"unknown_literal\"}) {","+\t\tvector<MatcherToken> tokens {MatcherToken(text, 0, TokenType::KEYWORD)};","+\t\tTokenIterator iterator(tokens);","+\t\tvector<MatcherSuggestion> suggestions;","+\t\tParseResultAllocator parse_results;","+\t\tidx_t max_position = 0;","+\t\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\t\tMatchContext context(suggestions, parse_results, process_allocator, max_position);","+\t\tMatchState state(iterator, context);","+\t\tauto process = choice.StartMatch(state);","+\t\tauto step = process->Resume(nullopt);","+\t\tif (text == \"WHERE\") {","+\t\t\tREQUIRE(step.GetChild());","+\t\t\tREQUIRE(&step.GetChild()->matcher == &choice.matchers[3].get());","+\t\t} else {","+\t\t\tREQUIRE_FALSE(step.GetChild());","+\t\t\tREQUIRE_FALSE(step.GetResult().IsSuccess());","+\t\t}","+\t}","+\tfor (auto mode : {MatchMode::BUILD_PARSE_RESULT, MatchMode::RECOGNIZE_ONLY}) {","+\t\tfor (auto &text : vector<string> {\"select\", \"FROM\", \"where\", \"(\", \"unknown_literal\", \"\"}) {","+\t\t\tauto actual = MatchLiteralChoiceTest(choice, text, mode);","+\t\t\tauto expected = MatchLiteralChoiceTest(sequential, text, mode);","+\t\t\tREQUIRE(actual.success == expected.success);","+\t\t\tREQUIRE(actual.position == expected.position);","+\t\t\tREQUIRE(actual.max_position == expected.max_position);","+\t\t\tREQUIRE(actual.tree == expected.tree);","+\t\t}","+\t}","+}","+","+class DispatchOverrideKeywordMatcher final : public KeywordMatcher {","+public:","+\tDispatchOverrideKeywordMatcher(const string &keyword, const KeywordInfo &info, const PEGKeywordHelper &helper,","+\t                               idx_t &calls_p)","+\t    : KeywordMatcher(keyword, info, helper), calls(calls_p), accepts_from(keyword == \"SELECT\") {","+\t}","+","+\tMatcherResult MatchAtomic(MatchState &state) const override {","+\t\tcalls++;","+\t\tauto token = state.token_iterator.Current();","+\t\tif (accepts_from && token && StringUtil::CIEquals(token->text, \"FROM\")) {","+\t\t\tstate.token_iterator.Advance();","+\t\t\treturn MatcherResult::Success();","+\t\t}","+\t\treturn KeywordMatcher::MatchAtomic(state);","+\t}","+","+private:","+\tidx_t &calls;","+\tbool accepts_from;","+};","+","+class DispatchOverrideMatcherFactory final : public MatcherFactory {","+public:","+\tDispatchOverrideMatcherFactory(MatcherAllocator &allocator, const ParsedGrammar &grammar,","+\t                               const compiled_rules_map_t &rules, const PEGKeywordHelper &helper_p, idx_t &calls_p)"],"additions":144,"deletions":0,"truncated":false}],"additions":449,"deletions":16,"truncated":true,"file_count":19},"error":null,"fetched_at":"2026-09-17T12:55:19.265820+00:00"}