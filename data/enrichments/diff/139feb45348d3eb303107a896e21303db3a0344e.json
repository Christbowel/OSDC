{"id":"139feb45348d3eb303107a896e21303db3a0344e","axis":"silent","repo":"vllm-project/vllm","sha":"139feb45348d3eb303107a896e21303db3a0344e","parsed":{"files":[{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -105,6 +105,7 @@ steps:","       - tests/models/test_deepseek_v4_rocm_compressor_gemm_fusion.py","       - tests/models/test_dsv41_mono_decode.py","       - tests/models/test_muse_spark_rocm_loading.py","+      - tests/models/test_dsv4_mono_decode.py","       - tests/models/test_deepseek_v4_vl_stream_weights.py","       - tests/models/hy_v4/test_triton_ihc.py","       - vllm/models/muse_spark/","@@ -114,6 +115,7 @@ steps:","       - pytest -v -s models/test_terratorch.py models/transformers/test_backend.py models/test_registry.py models/test_deepseek_v4_vl_rocm.py models/transformers/test_layer_registry_e2e.py models/test_deepseek_v41_replay_start.py models/test_deepseek_v41_decoder_replay_layers.py models/test_deepseek_v41_replay_batch.py models/test_deepseek_v41_amd_replay_forward.py models/test_deepseek_v4_dspark_rocm.py models/test_deepseek_v4_rocm_wo_a.py models/test_deepseek_v4_rocm_compressor_gemm_fusion.py models/test_dsv41_mono_decode.py models/test_muse_spark_rocm_loading.py models/test_deepseek_v4_vl_stream_weights.py models/test_muse_spark_logits_local.py models/test_muse_spark_rocm_shared_rope.py","       - VLLM_ROCM_USE_AITER=1 pytest -v -s models/test_hyv4_rocm.py -m 'not distributed'","       - pytest -v -s models/hy_v4/test_triton_ihc.py","+      - pytest -v -s models/test_dsv4_mono_decode.py"," "," - label: \":amd: (MI355) MiniMax M3 MonoKernel\"","   key: minimax-m3-monokernel-mi355","@@ -347,6 +349,24 @@ steps:","   - pytest -v -s tests/models/test_dsv41_mono_numerics.py","   - pytest -v -s tests/models/test_dsv41_mono_layers.py"," ","+- label: ':amd: (MI355) DeepSeek-V4-Pro Mono Decode Numerics'","+  key: dsv4-mono-decode-numerics-amd","+  dind: false","+  device: mi355_8","+  num_devices: 8","+  timeout_in_minutes: 60","+  working_dir: /vllm-workspace/","+  depends_on:","+  - image-build-amd","+  source_file_dependencies:","+  - docker/Dockerfile.rocm_base","+  - vllm/models/deepseek_v4/amd/","+  - tests/models/test_dsv4_mono_numerics.py","+  - tests/models/test_dsv4_mono_layers.py","+  commands:","+  - pytest -v -s tests/models/test_dsv4_mono_numerics.py","+  - pytest -v -s tests/models/test_dsv4_mono_layers.py","+"," - label: ':amd: (MI300) DeepSeek-V4.1 gfx942 Mono Decode Layers'","   key: dsv41-mono-decode-layers-gfx942-amd","   dind: false"],"additions":20,"deletions":0,"truncated":false},{"path":"tests/models/test_dsv4_mono_decode.py","lines":["@@ -0,0 +1,373 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The DeepSeek-V4-Pro mono decode layer runs only where its kernels are exact:","+decode-only steps of at most 64 rows with causal SWA windows, eager or in a","+FULL graph. Every backbone layer takes the whole layer: a CSA layer through","+its top-k (its compressor and indexer run between the launches), an HCA layer","+through every compressed row (vLLM's c128a table), a hash-routed layer with","+its tokens' experts. Deployments the kernels cannot run are an error.\"\"\"","+","+import sys","+from types import ModuleType, SimpleNamespace","+","+import pytest","+import torch","+","+from vllm.config import CUDAGraphMode","+from vllm.model_executor.layers.fused_moe.oracle.mxfp4 import Mxfp4MoeBackend","+from vllm.models.deepseek_v4.amd import mono_decode as md","+from vllm.models.deepseek_v4.amd.mono.dims import HIDDEN, MAX_TOKENS, WINDOW","+","+M = 6","+HCA_WIDTH = 512","+DEFAULT = object()","+","+","+class _Runner:","+    def __init__(self):","+        self.calls = []","+","+    def forward(self, *args, **kwargs):","+        self.calls.append((args, kwargs))","+        return (\"x\", \"residual\", \"post_mix\", \"res_mix\", \"extra\")","+","+","+def _cache(block):","+    return torch.zeros(4, block * md.RECORD, dtype=torch.uint8)","+","+","+def _layer(ratio=md.CSA, tid2eid=None):","+    attn = SimpleNamespace(","+        prefix=\"comp\",","+        swa_cache_layer=SimpleNamespace(prefix=\"swa\", kv_cache=_cache(64)),","+        kv_cache=_cache(64),","+        compress_ratio=ratio,","+        topk_indices_buffer=torch.zeros(64, 1024, dtype=torch.int32),","+    )","+    ffn = SimpleNamespace(gate=SimpleNamespace(tid2eid=tid2eid))","+    return SimpleNamespace(attn=attn, ffn=ffn)","+","+","+def _swa(**overrides):","+    fields = dict(","+        num_prefills=0,","+        num_decodes=1,","+        num_decode_tokens=M,","+        decode_swa_width=WINDOW,","+        decode_swa_indices=torch.zeros(64, 1, WINDOW, dtype=torch.int32),","+        decode_swa_lens=torch.zeros(64, dtype=torch.int32),","+        token_to_req_indices=torch.zeros(64, dtype=torch.int32),","+        slot_mapping=torch.zeros(64, dtype=torch.int64),","+        block_size=64,","+    )","+    fields.update(overrides)","+    return SimpleNamespace(**fields)","+","+","+def _c128a(rows=M, width=128):","+    \"\"\"VLLM's c128a decode table: its step's rows of a 64-row buffer as wide as","+    the longest context, cut to the step's active width.\"\"\"","+    buffer = torch.arange(64 * HCA_WIDTH, dtype=torch.int32).view(64, HCA_WIDTH)","+    return buffer[:rows, :width].view(rows, 1, -1)","+","+","+def _comp(rows=M, **overrides):","+    fields = dict(","+        block_size=256,","+        block_table=torch.zeros(1, 4, dtype=torch.int32),","+        c128a_global_decode_topk_indices=_c128a(rows),","+    )","+    fields.update(overrides)","+    return SimpleNamespace(**fields)","+","+","+def _inputs(rows=M):","+    return dict(","+        x=torch.zeros(rows, 4, HIDDEN, dtype=torch.bfloat16),","+        positions=torch.zeros(rows, dtype=torch.int64),","+        input_ids=torch.arange(rows),","+        residual=torch.zeros(rows, 4, HIDDEN, dtype=torch.bfloat16),","+        post_mix=torch.zeros(rows, 4, 1),","+        res_mix=torch.zeros(rows, 4, 4),","+    )","+","+","+@pytest.fixture","+def run(monkeypatch):","+    \"\"\"Call the mono path for one layer under a forward context built from","+    ``mode`` and ``metadata``; returns (result, runner calls). ``run.built``","+    records the runner's build arguments.\"\"\"","+    built: list = []","+","+    def _run(mode=CUDAGraphMode.FULL, metadata=DEFAULT, layer=None, **inputs):","+        if metadata is DEFAULT:","+            metadata = {\"swa\": _swa(), \"comp\": _comp()}","+        fc = SimpleNamespace(cudagraph_runtime_mode=mode, attn_metadata=metadata)","+        runner = _Runner()","+        monkeypatch.setattr(md, \"is_forward_context_available\", lambda: True)","+        monkeypatch.setattr(md, \"get_forward_context\", lambda: fc)","+","+        def build(*args):","+            built.append(args)","+            return runner","+","+        monkeypatch.setattr(md, \"_mono_runner\", build)","+        monkeypatch.setattr(md.MonoDecodeLayer, \"weights\", lambda self, layer: None)","+        mono = md.MonoDecodeLayer(HCA_WIDTH)","+        return mono(layer or _layer(), **{**_inputs(), **inputs}), runner.calls","+","+    _run.built = built  # type: ignore[attr-defined]","+    return _run","+","+","+@pytest.mark.parametrize(\"mode\", [CUDAGraphMode.NONE, CUDAGraphMode.FULL])","+def test_csa_step_runs_mono_with_its_topk(run, mode):","+    layer = _layer()","+    out, calls = run(mode, layer=layer)","+    assert out == (\"x\", \"residual\", \"post_mix\", \"res_mix\") and len(calls) == 1","+    kwargs = calls[0][1]","+    assert kwargs[\"topk_indices\"] is layer.attn.topk_indices_buffer","+    # the CSA cache: a 256-token page holds 64 compressed records","+    assert kwargs[\"comp_cache\"].shape == (4, 64, md.RECORD)","+    assert kwargs[\"fold\"] and kwargs[\"route_ids\"] is None","+    assert \"global_keys\" not in kwargs","+","+","+@pytest.mark.parametrize(","+    \"ratio, indexed, expected\",","+    [","+        (md.CSA, True, [\"compressor\", \"indexer\", \"topk\"]),","+        # a short context's top-k is every row, already filled","+        (md.CSA, False, [\"compressor\", \"indexer\"]),","+        (md.HCA, False, [\"compressor\"]),","+    ],","+    ids=[\"csa\", \"csa-short-context\", \"hca\"],","+)","+def test_select_runs_the_compressor_then_the_indexer(run, ratio, indexed, expected):","+    \"\"\"Between K1 and K2 the layer's compressor writes its row and a CSA","+    layer's indexer selects the top-k from K1's normed input and qr.\"\"\"","+    log = []","+    normed = torch.empty(M, HIDDEN, device=\"meta\")","+    qr = torch.empty(M, 1536, device=\"meta\")","+    q = torch.empty(M, 4, device=\"meta\") if indexed else None","+","+    class Compressor:","+        fused_wkv_wgate = SimpleNamespace(weight=torch.empty(8, HIDDEN, device=\"meta\"))","+","+        def __call__(self, score, positions, rope):","+            log.append(\"compressor\")","+","+    class Indexer:","+        compressor = Compressor()","+","+        def weights_proj(self, x):","+            return x[:, :4], None","+","+        def __call__(self, x, q_rank, score, weights, positions, rope):","+            assert x is normed and q_rank is qr","+            log.append(\"indexer\")","+            return q, None, weights","+","+        def indexer_op(self, x, index_q, _, weights):","+            assert x is normed and index_q is q","+            log.append(\"topk\")","+","+    layer = _layer(ratio)","+    layer.attn.compressor = Compressor()","+    layer.attn.indexer = Indexer() if ratio == md.CSA else None","+    layer.attn.rotary_emb = layer.attn.indexer_rotary_emb = None","+    _, calls = run(layer=layer)","+    calls[0][1][\"select\"](normed, qr)","+    assert log == expected","+","+","+@pytest.mark.parametrize(\"decode_tokens\", [M, M - 2], ids=[\"exact\", \"padded\"])","+def test_hca_step_reads_every_compressed_row(run, decode_tokens):","+    \"\"\"An HCA layer's keys are its c128a table's rows: the runner is built as","+    wide as vLLM's table, and the kernels read the table's buffer at its row","+    stride. A FULL graph padded past the step's decode tokens reads its pad","+    rows from the same buffer (their slots are -1).\"\"\"","+    comp = _comp(rows=decode_tokens)","+    metadata = {\"swa\": _swa(num_decode_tokens=decode_tokens), \"comp\": comp}","+    out, calls = run(metadata=metadata, layer=_layer(ratio=md.HCA))","+    assert out is not None and len(calls) == 1","+    assert [args[1] for args in run.built] == [HCA_WIDTH]","+    kwargs = calls[0][1]","+    assert kwargs[\"global_keys\"] and kwargs[\"topk\"] == HCA_WIDTH","+    keys = kwargs[\"topk_indices\"]","+    table = comp.c128a_global_decode_topk_indices","+    assert keys.data_ptr() == table.data_ptr() and keys.stride(0) == HCA_WIDTH","+    assert keys.untyped_storage().nbytes() >= M * HCA_WIDTH * keys.element_size()","+    assert kwargs[\"comp_cache\"].shape == (4, 2, md.RECORD)","+","+","+def test_hash_layer_routes_its_tokens(run):","+    tid2eid = torch.arange(100 * 6).view(100, 6)","+    ids = torch.tensor([3, 1, 4, 1, 5, 9])","+    out, calls = run(layer=_layer(tid2eid=tid2eid), input_ids=ids)","+    assert out is not None","+    assert torch.equal(calls[0][1][\"route_ids\"], tid2eid[ids])","+","+","+def test_first_layer_runs_mono_from_the_embedding(run):","+    \"\"\"The first layer's residual is the embedding broadcast to the four","+    streams, which K1 takes as it is (no owed post to fold).\"\"\"","+    out, calls = run(residual=None, post_mix=None, res_mix=None)","+    assert out is not None and len(calls) == 1","+    args, kwargs = calls[0]","+    assert args[2] is args[1] and not kwargs[\"fold\"]","+","+","+@pytest.mark.parametrize(","+    \"case\",","+    [","+        dict(mode=CUDAGraphMode.PIECEWISE),","+        dict(metadata={\"swa\": _swa(num_prefills=1), \"comp\": _comp()}),","+        dict(metadata=None),  # a profile / dummy run","+        dict(metadata={\"swa\": _swa()}),","+        dict(","+            metadata={","+                \"swa\": _swa(),","+                \"comp\": _comp(c128a_global_decode_topk_indices=None),","+            },","+            layer=_layer(ratio=md.HCA),","+        ),","+        dict(**_inputs(MAX_TOKENS + 1)),","+        dict(residual=torch.zeros(M, HIDDEN, 4, dtype=torch.bfloat16).mT),","+        dict(layer=_layer(tid2eid=torch.zeros(100, 6)), input_ids=None),","+    ],","+    ids=[","+        \"piecewise\",","+        \"prefill\",","+        \"no-metadata\",","+        \"no-comp-metadata\",","+        \"no-c128a-metadata\",","+        \"rows\",","+        \"non-contiguous\",","+        \"hash-without-ids\",","+    ],","+)","+def test_other_steps_take_the_original_path(run, case):","+    out, calls = run(**case)","+    assert out is None and not calls","+","+","+def _decoder_layer(layer_id=5, **attn):","+    attn = (","+        dict(","+            prefix=f\"model.layers.{layer_id}.attn\",","+            compress_ratio=md.CSA,","+            indexer=object(),","+            kv_cache_dtype=\"fp8_ds_mla\",","+        )","+        | attn","+    )","+    quant_method = SimpleNamespace(mxfp4_backend=Mxfp4MoeBackend.AITER_MXFP4_BF16)","+    ffn = SimpleNamespace(","+        experts=SimpleNamespace(","+            routed_experts=SimpleNamespace(quant_method=quant_method)","+        ),","+        shared_experts=object(),","+        use_mega_moe=False,","+        fuse_heterogeneous_shared_expert=False,","+        is_fused_shared_expert_enabled=False,","+        gate=SimpleNamespace(tid2eid=None, bias_vl=None),","+        n_routed_experts=384,","+        n_activated_experts=6,","+        routed_scaling_factor=2.5,","+        swiglu_limit=10.0,","+        scoring_func=\"sqrtsoftplus\",","+        renormalize=True,","+    )","+    return SimpleNamespace(","+        attn=SimpleNamespace(**attn),","+        ffn=ffn,","+        use_fused_mhc=True,","+        fuse_mhc_rmsnorm=True,","+    )","+","+","+def _config(monokernel=True, max_model_len=8192):","+    parallel = dict(","+        enable_expert_parallel=False, enable_eplb=False, data_parallel_size=1","+    )","+    return SimpleNamespace(","+        model_config=SimpleNamespace(","+            hf_config=SimpleNamespace(num_hidden_layers=61),","+            max_model_len=max_model_len,","+        ),","+        parallel_config=SimpleNamespace(**parallel),","+        kernel_config=SimpleNamespace(monokernel=monokernel),","+    )","+","+","+def _deployment(monkeypatch, tp=8, aiter_linear=True):","+    \"\"\"A deployment the kernels take (the runner module stubbed: no FlyDSL).\"\"\"","+    import vllm.platforms.rocm as rocm","+    from vllm._aiter_ops import rocm_aiter_ops","+","+    monkeypatch.delenv(\"VLLM_ROCM_USE_AITER_MOE_A4W4_DSV4\", raising=False)","+    monkeypatch.delenv(\"VLLM_ROCM_FP8_PADDING\", raising=False)","+    monkeypatch.setattr(rocm, \"get_cdna_version\", lambda: 4)","+    monkeypatch.setattr(md, \"get_tensor_model_parallel_world_size\", lambda: tp)","+    monkeypatch.setattr(md, \"_compute_units\", lambda: 256)","+    monkeypatch.setattr(","+        rocm_aiter_ops, \"is_linear_fp8_enabled\", classmethod(lambda cls: aiter_linear)","+    )","+    name = \"vllm.models.deepseek_v4.amd.mono.runner\"","+    runner = ModuleType(name)","+    runner.BLOCKS = 256  # type: ignore[attr-defined]","+    monkeypatch.setitem(sys.modules, name, runner)","+","+","+@pytest.mark.parametrize(","+    \"layer, eligible\",","+    [","+        (_decoder_layer(), True),","+        (_decoder_layer(compress_ratio=md.HCA, indexer=None), True),","+        (_decoder_layer(layer_id=61), False),","+    ],","+    ids=[\"csa\", \"hca\", \"draft\"],","+)","+def test_backbone_layers_take_the_whole_layer(monkeypatch, layer, eligible):","+    _deployment(monkeypatch)","+    mono = md.MonoDecodeLayer.create(layer, _config())","+    assert (mono is not None) == eligible","+","+","+def test_off_without_the_flag(monkeypatch):","+    \"\"\"No --monokernel: no mono layer, whatever the deployment.\"\"\"","+    _deployment(monkeypatch, tp=4)","+    assert (","+        md.MonoDecodeLayer.create(_decoder_layer(), _config(monokernel=False)) is None","+    )","+","+","+@pytest.mark.parametrize(","+    \"case, match\",","+    [","+        (dict(tp=4), \"tensor parallel size 8\"),","+        (dict(aiter_linear=False), \"VLLM_ROCM_USE_AITER_LINEAR\"),","+        (dict(padding=\"0\"), \"VLLM_ROCM_FP8_PADDING\"),","+    ],","+    ids=[\"tp\", \"aiter-linear\", \"fp8-padding\"],","+)","+def test_opt_in_outside_the_kernels_raises(monkeypatch, case, match):","+    \"\"\"The kernels read TP8 shards of vLLM's preshuffled, padded aiter FP8","+    weights: any other deployment is an error, not garbage.\"\"\"","+    padding = case.get(\"padding\")","+    _deployment(monkeypatch, **{k: v for k, v in case.items() if k != \"padding\"})","+    if padding is not None:","+        monkeypatch.setenv(\"VLLM_ROCM_FP8_PADDING\", padding)","+    with pytest.raises(ValueError, match=match):","+        md.MonoDecodeLayer.create(_decoder_layer(), _config())","+","+","+def test_hca_key_table_is_vllms_c128a_width(monkeypatch):","+    \"\"\"The runner's HCA key table is as wide as the c128a table vLLM's metadata","+    builder allocates: every compressed row of the longest context, in 128-row","+    multiples (sparse_mla).\"\"\"","+    _deployment(monkeypatch)","+    layer = _decoder_layer(compress_ratio=md.HCA, indexer=None)","+    mono = md.MonoDecodeLayer.create(layer, _config(max_model_len=1_000_000))","+    assert mono is not None and mono.hca_width == 7936"],"additions":373,"deletions":0,"truncated":false},{"path":"tests/models/test_dsv4_mono_layers.py","lines":["@@ -0,0 +1,355 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The DeepSeek-V4-Pro mono decode path through the real model: a five-layer","+DeepSeek-V4-Pro at TP8 on CDNA4, served with ``--monokernel`` on and off on","+the same random weights: every decoder layer's outputs at every decode step","+must match. Unlike ``test_dsv4_mono_numerics.py``, which checks the kernels","+against vLLM's ops one stage at a time, this runs","+``DeepseekV4DecoderLayer.forward`` in the engine -- the model's hook, the","+per-step path choice, the weights taken off the layer, the metadata, the","+compressor and the indexer's top-k -- so a change to the decoder layer that","+the kernels do not follow fails here. Scope: eager steps of one token a","+request; speculative decoding's multi-token rows and graph replays are not","+covered.","+","+The checkpoint's own first five layers (``compress_ratios`` 128, 128, 4, 128,","+4; ``num_hash_layers`` 3) hold every variant the kernels build, each taking the","+whole layer (K1 + K2):","+- 0: hash-routed HCA, the first layer (K1 takes the embedding, no fold)","+- 1: hash-routed HCA","+- 2: hash-routed CSA (vLLM's indexer between K1 and K2)","+- 3: bias-routed HCA","+- 4: bias-routed CSA","+A 32K ``max_model_len`` builds the HCA kernels 256 keys wide; the prompts","+(under 8.3K) keep vLLM's c128a decode table at its 128-wide floor, so the","+kernels read a table narrower than they are built for.","+\"\"\"","+","+import zlib","+","+import pytest","+import torch","+","+from vllm.model_executor.model_loader import register_model_loader","+from vllm.model_executor.model_loader.dummy_loader import DummyModelLoader","+from vllm.platforms import current_platform","+","+MODEL = \"deepseek-ai/DeepSeek-V4-Pro\"","+TP = 8","+LOAD_FORMAT = \"dsv4_mono_random\"","+TRUNCATED = {","+    \"num_hidden_layers\": 5,","+    # one entry a layer, the MTP layer's included","+    \"compress_ratios\": [128, 128, 4, 128, 4, 0],","+}","+LAYERS = (0, 1, 2, 3, 4)","+STEPS = 5  # decode steps after the prefill's token","+","+","+def _on_cdna4() -> bool:","+    if not current_platform.is_rocm():","+        return False","+    from vllm.platforms.rocm import get_cdna_version","+","+    return get_cdna_version() == 4","+","+","+@torch.no_grad()","+def _fill(name: str, t: torch.Tensor) -> None:","+    \"\"\"A random value for every weight, seeded by its name (alike on every","+    rank and in every run), in the ranges the checkpoint's formats hold.\"\"\"","+    if t.device.type == \"meta\":","+        return  # materialized and filled by the dummy loader's own path","+    g = torch.Generator(device=t.device).manual_seed(zlib.crc32(name.encode()))","+","+    def randn(scale=1.0, shift=0.0):","+        return torch.randn(t.shape, generator=g, device=t.device) * scale + shift","+","+    if t.dtype in (torch.uint8, torch.float8_e8m0fnu) and \"scale\" in name:","+        # E8M0 2^-12 .. 2^-8: one a 128 x 128 FP8 block, one a 32 MXFP4","+        # values. Larger random layers make the stack chaotic: atomics' order","+        # alone moves vLLM's own logits run to run.","+        u8 = t.view(torch.uint8)","+        u8.copy_(torch.randint(115, 120, u8.shape, generator=g, device=t.device))","+    elif t.dtype in (torch.uint8, torch.float4_e2m1fn_x2):","+        u8 = t.view(torch.uint8)","+        u8.copy_(torch.randint(0, 256, u8.shape, generator=g, device=t.device))","+    elif t.dtype == torch.float8_e4m3fn:","+        t.copy_(randn().clamp(-6, 6))","+    elif name.endswith(\"tid2eid\"):","+        # a hash layer's table: distinct experts (of 384) a token","+        ids = torch.rand(t.shape[0], 384, generator=g, device=t.device)","+        t.copy_(ids.argsort(1)[:, : t.shape[1]])","+    elif not torch.is_floating_point(t):","+        return","+    elif \"norm\" in name:","+        t.copy_(randn(0.1, 1.0))","+    elif name.endswith((\"hc_attn_scale\", \"hc_ffn_scale\")):","+        t.copy_(randn(0.5).abs() + 0.5)","+    elif name.endswith((\"hc_attn_base\", \"hc_ffn_base\", \"attn_sink\")):","+        t.copy_(randn(0.1))","+    elif name.endswith(\"embed_tokens.weight\"):","+        t.copy_(randn())","+    else:","+        t.copy_(randn(0.02))","+","+","+@register_model_loader(LOAD_FORMAT)","+class RandomWeightLoader(DummyModelLoader):","+    \"\"\"Dummy loading with weights in the checkpoint's ranges, before post-load","+    processing, so every processed copy follows (plain dummy weights leave the","+    E8M0 scales zero, and both paths would agree on zeros).\"\"\"","+","+    def load_weights(self, model, model_config) -> None:","+        from vllm.distributed import get_tensor_model_parallel_world_size","+","+        super().load_weights(model, model_config)","+        for name, t in model.state_dict().items():","+            _fill(name, t)","+        # the routed experts' intermediate past this rank's share, if padded,","+        # is the loader's zero padding: the kernels skip it","+        inter = model_config.hf_text_config.moe_intermediate_size","+        inter //= get_tensor_model_parallel_world_size()","+        for m in model.modules():","+            w13, w2 = getattr(m, \"w13_weight\", None), getattr(m, \"w2_weight\", None)","+            if w13 is None or w2 is None or w13.device.type == \"meta\":","+                continue","+            padded = w13.shape[1] // 2","+            if padded > inter:","+                w13, w2 = w13.data.view(torch.uint8), w2.data.view(torch.uint8)","+                for half in (0, padded):","+                    w13[:, half + inter : half + padded] = 0","+                w2[..., inter // 2 :] = 0","+","+","+class MonoProbe:","+    \"\"\"Worker extension (``worker_extension_cls``): it also brings this module,","+    and so the loader, into the workers.\"\"\"","+","+    def _decoder_layers(self) -> dict:","+        from vllm.model_executor.models.utils import extract_layer_index","+        from vllm.models.deepseek_v4.amd.model import DeepseekV4DecoderLayer","+","+        model = self.model_runner.model  # type: ignore[attr-defined]","+        return {","+            extract_layer_index(m.attn.prefix): m","+            for m in model.modules()","+            if isinstance(m, DeepseekV4DecoderLayer)","+        }","+","+    def capture_steps(self, lens: list[int]) -> None:","+        \"\"\"Keep each decoder layer's outputs (x, residual, post_mix, res_mix)","+        for every decode token taken in a decode-only step (the steps the","+        mono path takes), keyed by (layer, prompt length, position): a","+        request's step and row can differ between engines, its prompt length","+        and position cannot.","+        ``lens``: the prompt lengths, more than ``STEPS`` apart; a row's","+        request is the longest prompt not past its position.\"\"\"","+        from vllm.forward_context import get_forward_context","+","+        self._captured: dict = {}","+        self._gaps: dict = {}","+        lens = sorted(lens)","+","+        def decode_only(layer) -> bool:","+            md = get_forward_context().attn_metadata","+            if not isinstance(md, dict):","+                return False","+            swa = md.get(layer.attn.swa_cache_layer.prefix)","+            return swa is not None and swa.num_prefills == 0","+","+        def keys(layer_id, pos):","+            for row, p in enumerate(pos.tolist()):","+                yield row, (layer_id, max(n for n in lens if n <= p), p)","+","+        def hook(layer_id):","+            def keep(module, args, kwargs, out):","+                if not decode_only(module):","+                    return","+                pos = kwargs.get(\"positions\", args[1] if len(args) > 1 else None)","+                for row, k in keys(layer_id, pos):","+                    kept = [t[row].float().cpu() for t in out[:4]]","+                    self._captured.setdefault(k, kept)","+","+            return keep","+","+        def gap_hook(layer_id, layer):","+            def keep(ffn, args, kwargs):","+                # vLLM's path of a bias-routed layer only (the mono kernels","+                # route inside): each row's top-6 margin, sqrt(softplus(logits))","+                # + bias as vLLM routes","+                if ffn.gate.tid2eid is not None or not decode_only(layer):","+                    return","+                h = args[0] if args else kwargs[\"hidden_states\"]","+                logits = h.float() @ ffn.gate.weight.float().T","+                score = torch.nn.functional.softplus(logits).sqrt()","+                score = score + ffn.gate.e_score_correction_bias.float()","+                top = score.topk(7, dim=-1).values","+                gap = (top[:, 5] - top[:, 6]).tolist()","+                for row, k in keys(layer_id, self._positions):","+                    self._gaps.setdefault(k, gap[row])","+","+            return keep","+","+        def pos_hook(module, args, kwargs):","+            self._positions = kwargs.get(","+                \"positions\", args[1] if len(args) > 1 else None","+            )","+","+        for i, layer in self._decoder_layers().items():","+            layer.register_forward_hook(hook(i), with_kwargs=True)","+            layer.register_forward_pre_hook(pos_hook, with_kwargs=True)","+            gap = gap_hook(i, layer)","+            layer.ffn.register_forward_pre_hook(gap, with_kwargs=True)","+","+    def save_capture(self, path: str) -> None:","+        rank = self.rank  # type: ignore[attr-defined]","+        torch.save((self._captured, self._gaps), f\"{path}.rank{rank}\")","+","+    def mono_layers(self) -> dict:","+        from vllm.models.deepseek_v4.amd import mono_decode","+","+        layers = {","+            i: None if m.mono is None else m.mono._weights is not None","+            for i, m in self._decoder_layers().items()","+        }","+        runner = mono_decode._runner","+        return {","+            \"layers\": layers,","+            \"epoch\": -1 if runner is None else int(runner.epoch[0]),","+        }","+","+","+def _decode(vllm_runner, monkeypatch, mono: bool, prompts, path: str):","+    \"\"\"Greedy decode of ``prompts`` with the mono path on or off: (each","+    prompt's output, the workers' mono layers); each decoder layer's outputs","+    for the decode tokens of decode-only steps, and vLLM's routing margins,","+    saved under ``path``.\"\"\"","+    from vllm import SamplingParams","+    from vllm.inputs import TokensPrompt","+","+    # the deployment the mono path takes (``MonoDecodeLayer.create``)","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER\", \"1\")","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER_MOE\", \"1\")","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER_LINEAR\", \"1\")","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER_FUSION_SHARED_EXPERTS\", \"0\")","+    monkeypatch.setenv(\"VLLM_ROCM_FP8_PADDING\", \"1\")","+    with vllm_runner(","+        MODEL,","+        tensor_parallel_size=TP,","+        load_format=LOAD_FORMAT,","+        hf_overrides=TRUNCATED,","+        worker_extension_cls=f\"{__name__}.MonoProbe\",","+        moe_backend=\"aiter\",","+        monokernel=mono,","+        kv_cache_dtype=\"fp8\",","+        # the serving page (vllm_runner's default 16 holds no C128 row)","+        block_size=256,","+        tokenizer_mode=\"deepseek_v4\",","+        # eager: the hooks read every step (the kernels take eager steps as","+        # they take FULL graph replays)","+        enforce_eager=True,","+        max_model_len=32768,","+        max_num_seqs=len(prompts),","+        # the steps mixing prefill and decode take vLLM's path and are not","+        # captured (the runner turns chunked prefill off: a step's tokens","+        # must cover the model length)","+        max_num_batched_tokens=32768,","+        enable_prefix_caching=False,","+        gpu_memory_utilization=0.5,","+    ) as runner:","+        runner.llm.collective_rpc(\"capture_steps\", args=([len(p) for p in prompts],))","+        params = SamplingParams(temperature=0.0, max_tokens=STEPS + 1)","+        outs = runner.llm.generate(","+            [TokensPrompt(prompt_token_ids=p) for p in prompts], params","+        )","+        runner.llm.collective_rpc(\"save_capture\", args=(path,))","+        probe = runner.llm.collective_rpc(\"mono_layers\")","+    return [o.outputs[0] for o in outs], probe","+","+","+def _rel(a: torch.Tensor, b: torch.Tensor) -> float:","+    assert a.shape == b.shape, (a.shape, b.shape)","+    return ((a - b).norm() / b.norm()).item()","+","+","+@pytest.mark.skipif(not _on_cdna4(), reason=\"the mono kernels target CDNA4\")","+def test_mono_decode_matches_the_model(vllm_runner, monkeypatch, tmp_path):","+    if torch.accelerator.device_count() < TP:","+        pytest.skip(f\"needs {TP} GPUs\")","+    pytest.importorskip(\"flydsl\")","+    g = torch.Generator().manual_seed(0)","+    # contexts past the CSA layers' 1024 top-k (4 tokens a compressed entry),","+    # so the indexer selects; 512 apart, so a row's prompt is unambiguous","+    jitter = torch.randint(256, (8,), generator=g).tolist()","+    lens = [4400 + 512 * i + r for i, r in enumerate(jitter)]","+    prompts = [torch.randint(1000, 60000, (n,), generator=g).tolist() for n in lens]","+","+    on, probe_on = _decode(vllm_runner, monkeypatch, True, prompts, f\"{tmp_path}/on\")","+    off, probe_off = _decode(","+        vllm_runner, monkeypatch, False, prompts, f\"{tmp_path}/off\"","+    )","+","+    # every layer took the mono path on every rank, at every decode step","+    for rank in probe_on:","+        assert rank[\"layers\"] == dict.fromkeys(LAYERS, True), rank","+        assert rank[\"epoch\"] >= len(LAYERS) * STEPS, rank","+        assert rank[\"epoch\"] % len(LAYERS) == 0, rank","+    assert all(set(r[\"layers\"].values()) == {None} for r in probe_off)","+    # each decode token's input matches between the runs while the greedy","+    # tokens before it do: (prompt length, position) pairs to compare","+    same: set[tuple[int, int]] = set()","+    for prompt, a, b in zip(prompts, on, off):","+        for step in range(STEPS):","+            if a.token_ids[: step + 1] != b.token_ids[: step + 1]:","+                break","+            same.add((len(prompt), len(prompt) + step))"],"additions":306,"deletions":0,"truncated":false}],"additions":699,"deletions":0,"truncated":true,"file_count":3},"error":null,"fetched_at":"2026-10-25T13:32:48.184363+00:00"}