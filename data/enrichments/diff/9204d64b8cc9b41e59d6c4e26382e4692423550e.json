ect.manifest)","+    if (projectProof === 'proven') return false","+    const rootDir = path.resolve(project.rootDir)","+    if (selected != null) return selected.has(rootDir)","+    return projectProof !== 'unrecorded' || commandDir == null || commandDir === rootDir","+  })","+}","+","+/**","+ * The first held project its recorded validation cannot vouch for: one never","+ * installed, or one installed from another lockfile. The current lockfile","+ * cannot prove either installed, since a filtered install records the","+ * projects it left out in it as if it had installed them.","+ */","+function findUnprovableProject (held: ProjectStats[], proof: ValidationProof): string | undefined {","+  for (const { project } of held) {","+    switch (proof.proofOf(project.rootDir, project.manifest)) {","+      case 'unrecorded':","+        if (declaresDependencies(project)) {","+          return `Workspace package ${project.manifest.name ?? project.rootDir} has dependencies but was not installed`","+        }","+        break","+      case 'lockfileChanged':","+        return `The installed dependencies of ${project.manifest.name ?? project.rootDir} are not up to date with the lockfile`","+      default:","+        break","+    }","+  }","+  return undefined","+}","+"," function findWorkspaceStructureIssue ({ allProjects, opts, workspaceState }: WorkspaceDepsStatusContext): string | undefined {","   if (!equals(","     filter(value => value != null, workspaceState.settings.catalogs ?? {}),","@@ -186,7 +344,11 @@ async function readWorkspaceLockfiles ({ opts, workspaceDir }: WorkspaceDepsStat","   ]"," }"," ","-async function createWantedLockfileReader (ctx: WorkspaceDepsStatusContext): Promise<WantedLockfileReader> {","+/**","+ * `lockfileModified` overrides the modification time when the recorded","+ * validation already decided whether the lockfile changed.","+ */","+async function createWantedLockfileReader (ctx: WorkspaceDepsStatusContext, lockfileModified?: boolean): Pro