alidation proved","+ * it installed with. A passing check records the project again, so the next","+ * run need not repeat it.","+ */","+async function checkRecordedRootProject (","+  ctx: RootProjectDepsStatusContext,","+  lockfiles: RootProjectLockfiles,","+  proof: ValidationProof","+): Promise<CheckDepsStatusResult> {","+  const { rootProjectManifest, rootProjectManifestDir, workspaceState } = ctx","+  if (proof.lockfileUnreadable) return outdatedResult('Cannot check whether dependencies are outdated', workspaceState)","+  const projectProof = proof.proofOf(rootProjectManifestDir, rootProjectManifest)","+  if (projectProof === 'proven') {","+    logger.debug({ msg: 'No manifest files or lockfiles were modified since the last validation. Exiting check.' })","+    if (!lockfiles.currentLockfileStats) await assertNoDependenciesRequired(lockfiles.wantedLockfilePromise, rootProjectManifestDir)","+    if (proof.rehashed) await recordRootProject(ctx, true)","+    return upToDateRootProjectResult(lockfiles, ctx)","+  }","+  logger.debug({ msg: 'Some manifest files or lockfiles were modified since the last validation. Continuing check.' })","+  try {","+    if (projectProof !== 'manifestChanged') await assertWantedLockfileInstalled(lockfiles, rootProjectManifestDir)","+    await assertRootManifestUpToDate(ctx, lockfiles)","+  } catch (err) {","+    return outdatedResult(errorMessageOf(err), workspaceState)","+  }","+  await recordRootProject(ctx, false)","+  return upToDateRootProjectResult(lockfiles, ctx)","+}","+","+/**","+ * Records the project as proven installed. `onlyIfTrusted` is set for a","+ * refresh that only records the lockfile's stat again.","+ */","+async function recordRootProject (","+  { opts, rootProjectManifest, rootProjectManifestDir, wantedLockfileName, workspaceState }: RootProjectDepsStatusContext,","+  onlyIfTrusted: boolean","+): Promise<void> {","+  await updateWorkspaceState({","+    allProjects: [{ rootDir: rootProjectManifestDir as ProjectRo