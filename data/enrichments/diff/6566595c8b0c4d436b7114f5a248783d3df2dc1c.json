"+","+\tv3 \"github.com/rancher/rancher/pkg/apis/management.cattle.io/v3\"","+\tmgmtv3 \"github.com/rancher/rancher/pkg/generated/controllers/management.cattle.io/v3\"","+\t\"github.com/rancher/rancher/pkg/settings\"","+\twcorev1 \"github.com/rancher/wrangler/v3/pkg/generated/controllers/core/v1\"","+\t\"github.com/sirupsen/logrus\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/labels\"","+)","+","+// tokenExpiryHandler deletes SCIM token Secrets when they expire, as set by","+// [settings.ExpireSCIMTokensAfter].","+type tokenExpiryHandler struct {","+\tsecrets           wcorev1.SecretController","+\tsecretCache       wcorev1.SecretCache","+\texpireTokensAfter func() time.Duration","+}","+","+// RegisterTokenExpiry registers the handlers that delete SCIM token Secrets when they expire.","+//","+// The Secret handler is added to the shared Secret controller, which watches Secrets in all","+// namespaces, so it runs for every Secret change and ignores all but token Secrets in","+// [tokenSecretNamespace]. This is on purpose. Rancher already watches and caches every Secret in","+// the local cluster through this controller, and the SCIM authenticator lists token Secrets from","+// the same cache. The handler adds no watch, cache or queue, only a few field checks per Secret","+// event.","+//","+// A controller limited to one namespace would need its own cache factory, as the impersonation and","+// cluster auth token controllers use on downstream clusters to avoid caching every Secret there.","+// Here it would add a second watch and a second cached copy of every Secret in","+// [tokenSecretNamespace], including large Helm release Secrets, and would need its own start and","+// cache sync.","+func RegisterTokenExpiry(ctx context.Context, secrets wcorev1.SecretController, settingController mgmtv3.SettingController) {","+\th := &tokenExpiryHandler{","+\t\tsecrets:           secrets,","+\t\tsecretCache:       secrets.Cache(),","+\t\texpireTokensAfter: func() time.Duration { return settings.ExpireSCIMTokensAfter.GetDuration() },","+\t}","+","+\tsecrets.OnChange(ctx, \"scim-token-expiry\", h.onSecretChange)","+\tsettingController.OnChange(ctx, \"scim-token-expiry-setting\", h.onSettingChange)","+}","+","+// onSecretChange deletes an expired token Secret, or requeues it for the time it expires.","+func (h *tokenExpiryHandler) onSecretChange(_ string, secret *corev1.Secret) (*corev1.Secret, error) {","+\tif secret == nil || secret.DeletionTimestamp != nil ||","+\t\tsecret.Namespace != tokenSecretNamespace || secret.Labels[secretKindLabel] != scimAuthToken {","+\t\treturn secret, nil","+\t}","+","+\tremaining, expires := tokenExpiresIn(secret, h.expireTokensAfter(), time.Now())","+\tif !expires {","+\t\treturn secret, nil","+\t}","+\tif remaining > 0 {","+\t\th.secrets.EnqueueAfter(secret.Namespace, secret.Name, remaining)","+\t\treturn secret, nil","+\t}","+","+\t// Use the constant, not the Secret's namespace, so a mistake in the checks above can't delete a","+\t// Secret in another namespace.","+\terr := h.secrets.Delete(tokenSecretNamespace, secret.Name, &metav1.DeleteOptions{","+\t\tPreconditions: &metav1.Preconditions{UID: &secret.UID},","+\t})","+\tif apierrors.IsNotFound(err) || apierrors.IsConflict(err) {"],"additions":73,"deletions":0,"truncated":false}],"additions":415,"deletions":133,"truncated":true,"file_count":3},"error":null,"fetched_at":"2026-10-22T13:46:23.321439+00:00"}