ugin-compat` failing to load on Grafana older than 11.6. Every earlier release (`0.1.0` to `0.7.0`) imported `@grafana/runtime/unstable`, which those hosts don't provide, so the plugin failed to load even if it never called the affected function. Update to `0.8.0` and rebuild the plugin to pick up the fix.","+","+Each function now uses the host's stable `@grafana/runtime` export when it exists and the legacy `getDataSourceSrv()` or `getBackendSrv()` API otherwise. This changes behavior on Grafana 13.1 and 13.2, which only expose the async APIs under `unstable`: they now take the legacy path, so `registerRuntimeDataSourceInstance` registers into the legacy registry there.","+"," # 0.7.0 (2026-11-03)"," "," Add `getAppPluginHealth` function."],"additions":6,"deletions":0,"truncated":false},{"path":"packages/grafana-plugin-compat/package.json","lines":["@@ -2,7 +2,7 @@","   \"author\": \"Grafana Labs\",","   \"license\": \"Apache-2.0\",","   \"name\": \"@grafana/plugin-compat\",","-  \"version\": \"0.7.0\",","+  \"version\": \"0.8.0\",","   \"private\": true,","   \"description\": \"Compatibility shims that let Grafana plugins adopt new Grafana host APIs across a range of host versions\",","   \"keywords\": ["],"additions":1,"deletions":1,"truncated":false},{"path":"packages/grafana-plugin-compat/src/apps.compat.test.ts","lines":["@@ -4,11 +4,6 @@ import { type BackendSrv, setBackendSrv } from '@grafana/runtime';"," import { getAppPluginHealth, getPluginSettings, updateAppPluginSettings } from './apps';"," import { getMockedBackendSrv } from './utils/mocks';"," ","-jest.mock('@grafana/runtime/unstable', () => ({","-  getPluginSettings: undefined,","-  updateAppPluginSettings: undefined,","-}));","-"," jest.mock('@grafana/runtime', () => ({","   ...jest.requireActual('@grafana/runtime'),","   getPluginSettings: undefined,"],"additions":0,"deletions":5,"truncated":false},{"path":"packages/grafana-plugin-compat/src/apps.stable.test.ts","lines":["@@ -6,10 +6,6 @@ import {"