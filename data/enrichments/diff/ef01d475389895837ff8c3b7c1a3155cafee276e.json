rereleases. A registry","+/// `*` is a requirement the manifest spells out, so it keeps semver's rule.","+pub(crate) fn accepts_declared_version(","+    requirement: &VersionReq,","+    source: Option<&str>,","+    version: &Version,","+) -> bool {","+    let unversioned =","+        *requirement == VersionReq::STAR && source.is_none_or(|source| source.starts_with(\"git+\"));","+    unversioned || requirement.matches(version)","+}","+"," pub(crate) fn ensure_not_cancelled(","     should_cancel: &(dyn Fn() -> bool + Send + Sync),"," ) -> miette::Result<()> {"],"additions":17,"deletions":0,"truncated":false},{"path":"pnpm/crates/cargo-resolver/src/tests.rs","lines":["@@ -1,6 +1,6 @@"," use super::{","     IndexDiscovery, git_dependency_sources, latest_version, missing_index_names, resolve_inputs,","-    resolve_lockfile,","+    resolve_lockfile, verify_lockfile,"," };"," use crate::registry::CRATES_IO_SOURCE;"," use cargo_lock::Lockfile;","@@ -1057,6 +1057,51 @@ fn incremental_discovery_asks_for_what_a_full_walk_asks_for() {","     }"," }"," ","+#[test]","+fn locks_an_unversioned_path_dependency_on_a_prerelease_workspace_member() {","+    const PRERELEASE_PATH_METADATA: &str = r#\"{","+  \"packages\": [","+    {","+      \"id\": \"path+file:///workspace/crates/app#0.1.0\",","+      \"name\": \"app\",","+      \"version\": \"0.1.0\",","+      \"dependencies\": [{","+        \"name\": \"shared\",","+        \"source\": null,","+        \"req\": \"*\"","+      }]","+    },","+    {","+      \"id\": \"path+file:///workspace/crates/shared#0.1.0-alpha.1\",","+      \"name\": \"shared\",","+      \"version\": \"0.1.0-alpha.1\",","+      \"dependencies\": []","+    }","+  ],","+  \"workspace_members\": [","+    \"path+file:///workspace/crates/app#0.1.0\",","+    \"path+file:///workspace/crates/shared#0.1.0-alpha.1\"","+  ]","+}\"#;","+","+    let encoded =","+        resolve_lockfile(PRERELEASE_PATH_METADATA, &BTreeMap::new(), CRATES_IO_SOURCE).unwrap();","+    verify_lockfile(PRERELEASE_PATH_METADATA, &encoded).unwrap();","+    let lockfile = Lockfile::from_str(&encoded).unwrap();","+    let app = lockfile.packages","+        .iter()","+        .find(|package| package.name.as_str() == \"app\")","+        .expect(\"app package locked\");","+    assert_eq!(app.dependencies.len(), 1);","+    assert_eq!(app.dependencies[0].name.as_str(), \"shared\");","+    assert_eq!(app.dependencies[0].version.to_string(), \"0.1.0-alpha.1\");","+","+    let mismatched = PRERELEASE_PATH_METADATA.replace(r#\"\"req\": \"*\"\"#, r#\"\"req\": \"^1.0\"\"#);","+    let error =","+        resolve_lockfile(&mismatched, &BTreeMap::new(), CRATES_IO_SOURCE).unwrap_err().to_string();","+    assert_eq!(error, \"workspace dependency shared is not a workspace member\");","+}","+"," mod cancellation;"," mod freshness;"," mod lockfile_features;"],"additions":46,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps/git/manifest.rs","lines":["@@ -2,6 +2,7 @@ use super::{","     BTreeMap, BTreeSet, DEPENDENCY_KINDS, EXCLUDED_DIRECTORIES, IntoDiagnostic, Path, PathBuf,","     Result, fs, io,"," };","+use crate::cargo_manifest::lookup_inherited_workspace_entry;"," use miette::WrapErr;"," "," /// A package found in a git checkout, with the manifest the vendored","@@ -279,32 +280,46 @@ fn inherit_dependency_kinds("," }"," "," /// Replace each `dep.workspace = true` entry with the workspace's","-/// declaration of that dependency, keeping the `features`, `optional`,","-/// `public` and `default-features` the member added.","+/// declaration of that dependency, keeping the `package`, `features`,","+/// `optional`, `public` and `default-features` the member added."," fn inherit_dependency_table(","     dependencies: &mut toml::Table,","     workspace: Option<&toml::Table>,"," ) -> Result<bool> {","+    let ws_deps = workspace.and_then(|workspace| workspace.get(\"dependencies\")?.as_table());","     let mut inherited = false;","     for (name, declaration) in depe