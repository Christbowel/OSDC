ncy {name} as neither a version nor a table\",","+                \"the workspace declares dependency {ws_key} as neither a version nor a table\",","             ));","         }","     };","     let local = local.as_table().expect(\"an inheriting entry is a table\");","+    if ws_key != dep_key","+        && !merged.contains_key(\"package\")","+        && let Some(package) = local.get(\"package\")","+    {","+        merged.insert(\"package\".to_string(), package.clone());","+    }","     for key in [\"optional\", \"public\", \"default-features\"] {","         if let Some(value) = local.get(key) {","             merged.insert(key.to_string(), value.clone());"],"additions":32,"deletions":11,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps/git/tests.rs","lines":["@@ -113,6 +113,45 @@ workspace = true","     assert_eq!(document[\"lints\"][\"rust\"][\"unsafe_code\"].as_str(), Some(\"forbid\"));"," }"," ","+#[test]","+fn workspace_inheritance_honors_renamed_package_declarations() {","+    let workspace = manifest(","+        r#\"","+[workspace]","+members = [\"member\"]","+","+[workspace.dependencies]","+itoa = \"1.0\"","+ws_ryu = { package = \"ryu\", version = \"1.0.19\" }","+\"#,","+    );","+    let member = manifest(","+        r#\"","+[package]","+name = \"member\"","+version = \"0.1.0\"","+","+[dependencies]","+my_itoa = { package = \"itoa\", workspace = true, features = [\"extra\"] }","+ws_ryu = { workspace = true }","+local_ryu = { package = \"ws_ryu\", workspace = true }","+\"#,","+    );","+","+    let vendored = vendored_package(&member, Some(&workspace.document)).unwrap();","+    let document: toml::Table = toml::from_str(&vendored.manifest).expect(\"valid TOML\");","+    assert_eq!(document[\"dependencies\"][\"my_itoa\"][\"package\"].as_str(), Some(\"itoa\"));","+    assert_eq!(document[\"dependencies\"][\"my_itoa\"][\"version\"].as_str(), Some(\"1.0\"));","+    assert_eq!(","+        document[\"dependencies\"][\"my_itoa\"][\"features\"].as_array(