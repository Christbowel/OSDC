{"id":"ef01d475389895837ff8c3b7c1a3155cafee276e","axis":"silent","repo":"pnpm/pnpm","sha":"ef01d475389895837ff8c3b7c1a3155cafee276e","parsed":{"files":[{"path":".changeset/cargo-manifest-and-workspace-deps.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add crate:<pkg>` no longer corrupts multiline arrays in `Cargo.toml`. Saving an explicit version with `pnpm add crate:<pkg>@<version>` now replaces `workspace = true` on existing dependency entries. Inherited workspace settings such as `features`, `default-features`, and `package` stay on the updated entry. `pnpm install` now accepts unversioned path dependencies on prerelease Cargo workspace members. Cargo workspace inheritance now resolves `package` renames."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cargo-resolver/src/freshness.rs","lines":["@@ -1,10 +1,10 @@"," use crate::{","     metadata::parse_metadata,","-    model::{MetadataDependency, MetadataPackage},","+    model::{MetadataDependency, MetadataPackage, accepts_declared_version},"," };"," use cargo_lock::{Dependency, Lockfile, Package};"," use miette::{IntoDiagnostic, Report, Result, WrapErr};","-use semver::{Version, VersionReq};","+use semver::Version;"," use std::str::FromStr;"," "," /// Check that, for every registry or git dependency a workspace member","@@ -106,16 +106,8 @@ fn accounts_for(declaration: &MetadataDependency, edge: &Dependency) -> bool {","         }"," }"," ","-/// A path or git dependency declared without a version appears in the","-/// metadata as `*`. Cargo accepts any version for it, prereleases included,","-/// while semver's `*` rejects prereleases. A registry `*` is a requirement","-/// the manifest spells out, so it keeps semver's rule."," fn accepts_version(declaration: &MetadataDependency, version: &Version) -> bool {","-    let unversioned = declaration.req == VersionReq::STAR","-        && declaration.source","-            .as_deref()","-            .is_none_or(|sourc