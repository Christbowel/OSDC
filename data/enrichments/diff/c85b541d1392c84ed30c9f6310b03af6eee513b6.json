, context.Canceled)"," \t})"," ","@@ -324,15 +303,15 @@ func TestFileListScanner_List(t *testing.T) {"," \t\t{\"returns an error for a tenant with a slash\", \"a/aa\"},"," \t} {"," \t\tt.Run(tc.name, func(t *testing.T) {","-\t\t\t_, err := newTestFileListScanner(t, newFileBucket(t), \"index/v0\").List(t.Context(), tc.tenant, now)","+\t\t\t_, err := newTestFileListScanner(t, newFileBucket(t)).List(t.Context(), tc.tenant, now)"," \t\t\trequire.ErrorContains(t, err, \"tenant\")"," \t\t})"," \t}"," }"," ","-func newTestFileListScanner(t *testing.T, bucket objstore.BucketReader, indexPrefix string) *FileListScanner {","+func newTestFileListScanner(t *testing.T, bucket objstore.BucketReader) *FileListScanner {"," \tt.Helper()","-\tscanner, err := NewFileListScanner(bucket, indexPrefix, 2, log.NewNopLogger())","+\tscanner, err := NewFileListScanner(bucket, 2, log.NewNopLogger())"," \trequire.NoError(t, err)"," \treturn scanner"," }"],"additions":21,"deletions":42,"truncated":false},{"path":"pkg/dataobj/deletion/sweep.go","lines":["@@ -0,0 +1,154 @@","+package deletion","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"path\"","+\t\"strings\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/go-kit/log/level\"","+\t\"github.com/grafana/dskit/backoff\"","+\t\"github.com/thanos-io/objstore\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj/metastore\"","+)","+","+// MinSweepInterval is the minimum age of a stored file list that makes a","+// sweep scan again.","+//","+// The planner starts a sweep for each tenant every hour, and each start is a","+// little late. A minimum of 23 hours keeps the daily scan of a tenant at the","+// same hour. A minimum of 24 hours would move it one hour later each day.","+const MinSweepInterval = 23 * time.Hour","+","+// SweepOutcome reports what a sweep did.","+type SweepOutcome string","+","+const (","+\t// SweepSkipped means that the stored file list was newer than","+\t// MinSweepInterval, so the sweep did not scan.","+\tSweepSkipped SweepOutcome = \"skipped\"","+\t// SweepScanned means that the sweep scanned and stored a new file list.","+\tSweepScanned SweepOutcome = \"scanned\"","+\t// SweepSuperseded means that the sweep scanned, but a concurrent sweep","+\t// stored a file list that is not older. The stored list stays.","+\tSweepSuperseded SweepOutcome = \"superseded\"","+)","+","+// sweepMaxOpenFiles limits the objects that one sweep opens at the same time.","+// A worker can run several sweeps at once, so the limit is per sweep.","+const sweepMaxOpenFiles = 16","+","+var sweepWriterBackoff = backoff.Config{","+\tMinBackoff: 100 * time.Millisecond,","+\tMaxBackoff: 5 * time.Second,","+\tMaxRetries: 5,","+}","+","+// Sweeper records the objects of a tenant in its stored file list, at most","+// once per MinSweepInterval.","+//","+// Sweeper is safe for concurrent use.","+type Sweeper struct {","+\tbucket  objstore.Bucket","+\tscanner *FileListScanner","+\twriter  *FileListWriter","+\tlogger  log.Logger","+}","+","+// NewSweeper returns a Sweeper for bucket. bucket is the root of the data","+// object storage. It must report modification times and support conditional","+// writes. See [NewFileListScanner] and [NewFileListWriter].","+func NewSweeper(bucket objstore.Bucket, logger log.Logger) (*Sweeper, error) {","+\tscanner, err := NewFileListScanner(bucket, sweepMaxOpenFiles, logger)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn &Sweeper{","+\t\tbucket:  bucket,","+\t\tscanner: scanner,","+\t\twriter:  NewFileListWriter(bucket, sweepWriterBackoff, logger),","+\t\tlogger:  logger,","+\t}, nil","+}","+","+// Sweep reads the stored file list of tenant first. It skips the scan if the","+// stored list is newer than MinSweepInterval at now. Otherwise, or if no list","+// is stored, it scans the objects of tenant and stores the new list.","+//","+// Sweep returns an error, and does not scan, if it cannot read the stored","+// list. That includes a list that wraps ErrMalformedFileList. Sweep does not","+// replace such a list, so an operator must repair or delete it.","+//","+// A list that a concurrent sweep stored first is not an error. Sweep then","+// returns SweepSuperseded.","+func (s *Sweeper) Sweep(ctx context.Context, tenant string, now time.Time) (SweepOutcome, error) {","+\tstored, found, err := s.storedListTime(ctx, tenant)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\tif found && now.Sub(stored) < MinSweepInterval {","+\t\tlevel.Debug(s.logger).Log(\"msg\", \"skipped deletion sweep: stored file list is recent\", \"tenant\", tenant, \"created_at\", stored.Format(time.RFC3339))","+\t\treturn SweepSkipped, nil","+\t}","+","+\tlist, err := s.scanner.List(ctx, tenant, now)","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"scanning objects of tenant %q: %w\", tenant, err)","+\t}","+\terr = s.writer.Write(ctx, list)","+\tswitch {","+\tcase errors.Is(err, ErrSuperseded):","+\t\treturn SweepSuperseded, nil","+\tcase err != nil:","+\t\treturn \"\", fmt.Errorf(\"storing file list of tenant %q: %w\", tenant, err)","+\t}","+\treturn SweepScanned, nil","+}","+","+// storedListTime returns the creation time of the stored file list of","+// tenant. found is false if no list is stored.","+func (s *Sweeper) storedListTime(ctx context.Context, tenant string) (createdAt time.Time, found bool, err error) {","+\tr, err := OpenFileList(ctx, s.bucket, tenant)","+\tif err != nil {","+\t\tif s.bucket.IsObjNotFoundErr(err) {","+\t\t\treturn time.Time{}, false, nil","+\t\t}","+\t\treturn time.Time{}, false, fmt.Errorf(\"reading stored file list of tenant %q: %w\", tenant, err)","+\t}","+\tdefer r.Close()","+\treturn r.CreatedAt(), true, nil","+}","+","+// ListCompactedTenants returns the tenants that have a directory of compacted","+// log objects or compacted index objects in bucket. bucket is the root of the","+// data object storage.","+//","+// It lists the directory names only, so a tenant whose compacted objects were","+// all deleted can still appear. It skips a directory name that is not a valid","+// tenant ID, and logs it.","+func ListCompactedTenants(ctx context.Context, bucket objstore.BucketReader, logger log.Logger) (map[string]struct{}, error) {","+\ttenants := make(map[string]struct{})","+\tfor _, root := range []string{\"objects\", path.Join(metastore.IndexStoragePrefix, \"indexes\")} {","+\t\tdir := tenantsDir(root)","+\t\terr := bucket.Iter(ctx, dir, func(name string) error {","+\t\t\tif !strings.HasSuffix(name, objstore.DirDelim) {","+\t\t\t\treturn nil","+\t\t\t}","+\t\t\ttenant := strings.TrimSuffix(strings.TrimPrefix(name, dir), objstore.DirDelim)","+\t\t\tif err := validateTenant(tenant); err != nil {","+\t\t\t\tlevel.Warn(logger).Log(\"msg\", \"skipped tenants directory entry that is not a valid tenant\", \"dir\", name, \"err\", err)","+\t\t\t\treturn nil","+\t\t\t}","+\t\t\ttenants[tenant] = struct{}{}","+\t\t\treturn nil","+\t\t})","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"listing tenants in %s: %w\", dir, err)","+\t\t}","+\t}","+\treturn tenants, nil","+}"],"additions":154,"deletions":0,"truncated":false},{"path":"pkg/dataobj/deletion/sweep_test.go","lines":["@@ -0,0 +1,124 @@","+package deletion","+","+import (","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/stretchr/testify/require\"","+\t\"github.com/thanos-io/objstore\"","+)","+","+func TestSweeper_Sweep(t *testing.T) {","+\tnotADataObject := []byte(\"not a data object\")","+\tnow := time.Date(2026, 11, 4, 12, 0, 0, 0, time.UTC)","+\told := now.Add(-2 * time.Hour)","+","+\tnewSweeper := func(t *testing.T, bucket objstore.Bucket) *Sweeper {","+\t\tt.Helper()","+\t\tsweeper, err := NewSweeper(bucket, log.NewNopLogger())","+\t\trequire.NoError(t, err)","+\t\treturn sweeper","+\t}","+","+\tt.Run(\"scans and stores the list when no list is stored\", func(t *testing.T) {","+\t\tbucket := newFileBucket(t)","+\t\tbucket.put(t, \"objects/00/single-a\", objectBytes(t, \"a\"), old)","+","+\t\toutcome, err := newSweeper(t, bucket).Sweep(t.Context(), \"a\", now)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, SweepScanned, outcome)","+\t\trequire.Equal(t, FileList{Tenant: \"a\", CreatedAt: now, Paths: []string{\"objects/00/single-a\"}}, readFileList(t, bucket, \"a\"))","+\t})","+","+\tt.Run(\"skips the scan and keeps the stored list when it is newer than MinSweepInterval\", func(t *testing.T) {","+\t\tfiles := newFileBucket(t)","+\t\tfiles.put(t, \"objects/00/single-a\", objectBytes(t, \"a\"), old)","+\t\tstored := FileList{Tenant: \"a\", CreatedAt: now.Add(-MinSweepInterval + time.Second), Paths: []string{\"objects/00/stored\"}}","+\t\tstoreFileList(t, files, stored)","+\t\tbucket := &listRecordingBucket{fileBucket: files}","+","+\t\toutcome, err := newSweeper(t, bucket).Sweep(t.Context(), \"a\", now)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, SweepSkipped, outcome)","+\t\trequire.Empty(t, bucket.dirs)","+\t\trequire.Equal(t, stored, readFileList(t, files, \"a\"))","+\t})","+","+\tt.Run(\"scans and replaces a stored list that is MinSweepInterval old\", func(t *testing.T) {","+\t\tbucket := newFileBucket(t)","+\t\tbucket.put(t, \"objects/00/single-a\", objectBytes(t, \"a\"), old)","+\t\tstoreFileList(t, bucket, FileList{Tenant: \"a\", CreatedAt: now.Add(-MinSweepInterval)})","+","+\t\toutcome, err := newSweeper(t, bucket).Sweep(t.Context(), \"a\", now)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, SweepScanned, outcome)","+\t\trequire.Equal(t, FileList{Tenant: \"a\", CreatedAt: now, Paths: []string{\"objects/00/single-a\"}}, readFileList(t, bucket, \"a\"))","+\t})","+","+\tt.Run(\"returns SweepSuperseded and keeps a newer list that a concurrent sweep stored\", func(t *testing.T) {","+\t\tfiles := newFileBucket(t)","+\t\tfiles.put(t, \"objects/00/single-a\", objectBytes(t, \"a\"), old)","+\t\tnewer := FileList{Tenant: \"a\", CreatedAt: now.Add(time.Minute), Paths: []string{\"objects/00/newer\"}}","+\t\tbucket := &conflictBucket{Bucket: files, conflicts: 1, concurrentWrite: func() { storeFileList(t, files, newer) }}","+","+\t\toutcome, err := newSweeper(t, bucket).Sweep(t.Context(), \"a\", now)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, SweepSuperseded, outcome)","+\t\trequire.Equal(t, newer, readFileList(t, files, \"a\"))","+\t})","+","+\tt.Run(\"returns ErrMalformedFileList without a scan and keeps a malformed stored list\", func(t *testing.T) {","+\t\tfiles := newFileBucket(t)","+\t\tupload(t, files, fileListPath(\"a\"), []byte(\"not gzip\"))","+\t\tbucket := &listRecordingBucket{fileBucket: files}","+","+\t\t_, err := newSweeper(t, bucket).Sweep(t.Context(), \"a\", now)","+\t\trequire.ErrorIs(t, err, ErrMalformedFileList)","+\t\trequire.Empty(t, bucket.dirs)","+\t\trequire.Equal(t, \"not gzip\", readRaw(t, files, fileListPath(\"a\")))","+\t})","+","+\tt.Run(\"returns an error and stores no list when the scan fails\", func(t *testing.T) {","+\t\tbucket := newFileBucket(t)","+\t\tbucket.put(t, \"objects/00/corrupt\", notADataObject, old)","+","+\t\t_, err := newSweeper(t, bucket).Sweep(t.Context(), \"a\", now)","+\t\trequire.ErrorContains(t, err, \"objects/00/corrupt\")","+\t\texists, err := bucket.Exists(t.Context(), fileListPath(\"a\"))","+\t\trequire.NoError(t, err)","+\t\trequire.False(t, exists)","+\t})","+}","+","+func TestListCompactedTenants(t *testing.T) {","+\tt.Run(\"returns the tenants of the compacted log and index directories\", func(t *testing.T) {","+\t\tbucket := newFileBucket(t)","+\t\tupload(t, bucket, \"objects/tenants/a/aa/compacted\", []byte(\"x\"))","+\t\tupload(t, bucket, \"objects/tenants/b/aa/compacted\", []byte(\"x\"))","+\t\tupload(t, bucket, \"index/v0/indexes/tenants/b/bb/compacted\", []byte(\"x\"))","+\t\tupload(t, bucket, \"index/v0/indexes/tenants/c/bb/compacted\", []byte(\"x\"))","+\t\tupload(t, bucket, \"objects/00/uncompacted\", []byte(\"x\"))","+\t\tupload(t, bucket, \"objects/tenants/stray-file\", []byte(\"x\"))","+","+\t\ttenants, err := ListCompactedTenants(t.Context(), bucket, log.NewNopLogger())","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, map[string]struct{}{\"a\": {}, \"b\": {}, \"c\": {}}, tenants)","+\t})","+","+\tt.Run(\"skips a directory name that is not a valid tenant\", func(t *testing.T) {","+\t\tbucket := newFileBucket(t)","+\t\tupload(t, bucket, \"objects/tenants/a/aa/compacted\", []byte(\"x\"))","+\t\tupload(t, bucket, \"objects/tenants/not a tenant/aa/compacted\", []byte(\"x\"))","+","+\t\ttenants, err := ListCompactedTenants(t.Context(), bucket, log.NewNopLogger())","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, map[string]struct{}{\"a\": {}}, tenants)","+\t})","+","+\tt.Run(\"returns no tenants when no compacted objects exist\", func(t *testing.T) {","+\t\ttenants, err := ListCompactedTenants(t.Context(), newFileBucket(t), log.NewNopLogger())","+\t\trequire.NoError(t, err)","+\t\trequire.Empty(t, tenants)","+\t})","+}"],"additions":124,"deletions":0,"truncated":false},{"path":"pkg/engine/compactor/compactor.go","lines":["@@ -22,8 +22,12 @@ import ("," // constructs as enabled — Bucket and MetastoreWriter are unconditionally"," // required."," type PlannerParams struct {","-\tConfig          Config","-\tBucket          objstore.Bucket                  // required","+\tConfig Config","+\t// Bucket is the index storage.","+\tBucket objstore.Bucket // required","+\t// DataBucket is the root of the data object storage. It is required if","+\t// the deletion sweep is enabled.","+\tDataBucket      objstore.BucketReader"," \tMetastoreWriter *metastore.TableOfContentsWriter // required"," \tLimits          Limits                           // required"," \tLogger          log.Logger","@@ -63,6 +67,9 @@ func New(params PlannerParams) (*Planner, error) {"," \tif params.Limits == nil {"," \t\treturn nil, errors.New(\"dataobj compaction planner: limits is required\")"," \t}","+\tif params.Config.DeletionSweep.Enabled && params.DataBucket == nil {","+\t\treturn nil, errors.New(\"dataobj compaction planner: data bucket is required when the deletion sweep is enabled\")","+\t}"," "," \tsched, err := newScheduler("," \t\tparams.Config.Scheduler,","@@ -76,6 +83,7 @@ func New(params PlannerParams) (*Planner, error) {"," \t\tparams.Config,"," \t\tlog.With(logger, \"component\", \"dataobj-compaction-coordinator\"),"," \t\tparams.Bucket,","+\t\tparams.DataBucket,"," \t\tsched.inner,"," \t\tparams.MetastoreWriter,"," \t\tparams.Registerer,"],"additions":10,"deletions":2,"truncated":false},{"path":"pkg/engine/compactor/compactor_test.go","lines":["@@ -9,6 +9,7 @@ import ("," \t\"time\""," "," \t\"github.com/go-kit/log\"","+\t\"github.com/grafana/dskit/flagext\""," \t\"github.com/grafana/dskit/services\""," \t\"github.com/stretchr/testify/require\""],"additions":1,"deletions":0,"truncated":false}],"additions":343,"deletions":60,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-11T15:39:40.826117+00:00"}