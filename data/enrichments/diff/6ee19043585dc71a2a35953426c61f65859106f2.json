nst transformers: Record<string, (...args: any[]) => any> = {};","+","+  registerProjectSettingsAuditEvents({","+    registerEvent(name: string, transform: any) {","+      transformers[name] = transform;","+    },","+  });","+","+  return transformers;","+};","+","+const logo = (name: string, hash: string) => ({ name, hash, url: `/uploads/${hash}.png` });","+","+describe('Project settings audit events', () => {","+  test('registers project-settings.update', () => {","+    expect(Object.keys(getTransformers())).toEqual(['project-settings.update']);","+  });","+","+  test('project-settings.update has a resource with no id and carries the changes', () => {","+    const changes = { menuLogo: { before: null, after: 'logo.png' } };","+","+    expect(getTransformers()['project-settings.update']({ changes })).toEqual({","+      resource: { type: 'project-settings' },","+      details: { changes },","+    });","+  });","+","+  describe('getProjectSettingsChanges', () => {","+    test('records an uploaded logo by name', () => {","+      expect(","+        getProjectSettingsChanges(","+          { menuLogo: logo('old.png', 'old_1'), authLogo: null },","+          { menuLogo: logo('new.png', 'new_1'), authLogo: null }","+        )","+      ).toEqual({ menuLogo: { before: 'old.png', after: 'new.png' } });","+    });","+","+    test('records a reset logo as null', () => {","+      expect(","+        getProjectSettingsChanges(","+          { menuLogo: null, authLogo: logo('auth.png', 'auth_1') },","+          { menuLogo: null, authLogo: null }","+        )","+      ).toEqual({ authLogo: { before: 'auth.png', after: null } });","+    });","+","+    test('records both logos', () => {","+      expect(","+        getProjectSettingsChanges(undefined, {","+          menuLogo: logo('menu.png', 'menu_1'),","+          authLogo: logo('auth.png', 'auth_1'),","+        })","+      ).toEqual({","+        menuLogo: { before: null, after: 'menu.png' },","+        authLogo: { before: null, after: 'auth.png' },","+      });","+    });","+","+    test('records a new upload with the same file name', () => {","+      expect(","+        getProjectSettingsChanges(","+          { menuLogo: logo('logo.png', 'logo_1') },","+          { menuLogo: logo('logo.png', 'logo_2') }","+        )","+      ).toEqual({ menuLogo: { before: 'logo.png', after: 'logo.png' } });","+    });","+","+    test('returns no changes when the logos are kept', () => {","+      const settings = { menuLogo: logo('menu.png', 'menu_1'), authLogo: null };","+","+      expect(getProjectSettingsChanges(settings, { ...settings })).toEqual({});","+      expect(getProjectSettingsChanges(null, { menuLogo: null, authLogo: null })).toEqual({});","+    });","+","+    test('treats a stored empty logo as no logo', () => {","+      expect(getProjectSettingsChanges(null, { menuLogo: {}, authLogo: {} })).toEqual({});","+    });","+  });","+});"],"additions":82,"deletions":0,"truncated":false},{"path":"packages/core/admin/server/src/audit-logs/project-settings.ts","lines":["@@ -0,0 +1,63 @@","+import type { Modules } from '@strapi/types';","+","+export const AUDITED_EVENTS = {","+  PROJECT_SETTINGS_UPDATE: 'project-settings.update',","+} as const;","+","+const AUDITED_LOGOS = ['menuLogo', 'authLogo'] as const;","+","+type Logo = { name?: string; hash?: string } | null | undefined;","+","+/** The logos as stored under the `project-settings` admin-store key. */","+export type ProjectSettingsLogos = Partial<Record<(typeof AUDITED_LOGOS)[number], Logo>>;","+","+export type ProjectSettingsChanges = Partial<","+  Record<(typeof AUDITED_LOGOS)[number], Modules.AuditLogs.FieldChange<string | null>>","+>;","+","+export interface UpdateDetails {","+  changes: ProjectSettingsChanges;","+}","+","+// The service stores `{}` for a logo when there were no settings yet and none was uploaded.","+const toName = (logo: Logo) => logo?.name ?? null;","+","+// A new upload gets a new hash, even when the file name is the same.","+export const getProjectSettingsChanges = (","+  previous: ProjectSettingsLogos | null | undefined,","+  next: ProjectSettingsLogos","+): ProjectSettingsChanges => {","+  const changes: ProjectSettingsChanges = {};","+","+  for (const logo of AUDITED_LOGOS) {","+    const before = previous?.[logo];","+    const after = next[logo];","+","+    if (toName(before) !== toName(after) || (before?.hash ?? null) !== (after?.hash ?? null)) {","+      changes[logo] = { before: toName(before), after: toName(after) };","+    }","+  }","+","+  return changes;","+};","+","+/**","+ * The part of the audit-logs lifecycle service used here.","+ * The full service type lives in the Admin EE package.","+ */","+interface AuditLogsLifecycle {","+  registerEvent<TDetails>(","+    name: string,","+    transform: Modules.AuditLogs.EventTransformer<TDetails>","+  ): void;","+}","+","+export const registerProjectSettingsAuditEvents = (auditLogsLifecycle: AuditLogsLifecycle) => {","+  auditLogsLifecycle.registerEvent<UpdateDetails>(","+    AUDITED_EVENTS.PROJECT_SETTINGS_UPDATE,","+    (event: UpdateDetails) => ({","+      resource: { type: 'project-settings' },","+      details: { changes: event.changes },","+    })","+  );","+};"],"additions":63,"deletions":0,"truncated":false},{"path":"packages/core/admin/server/src/services/__tests__/project-settings.test.ts","lines":["@@ -1,3 +1,4 @@","+import { emitAudit } from '@strapi/utils';"," import {","   parseFilesData,","   getProjectSettings,","@@ -5,6 +6,11 @@ import {","   updateProjectSettings,"," } from '../project-settings';"," ","+jest.mock('@strapi/utils', () => ({","+  ...jest.requireActual('@strapi/utils'),","+  emitAudit: jest.fn(),","+}));","+"," jest.mock('fs', () => ({","   ...jest.requireActual('fs'),","   createReadStream: () => null,","@@ -340,6 +346,13 @@ describe('Project setting', () => {","         key: 'project-settings',","         value: expectedOutput,","       });","+      expect(emitAudit).toHaveBeenCalledTimes(1);","+     