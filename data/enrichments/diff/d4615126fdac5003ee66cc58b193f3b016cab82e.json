ned()","+    }","+  })","+","+  it.each([","+    {","+      name: 'the opt-out flag',","+      setup: () => publishViews(defaultEntries()),","+      federatedAssetSource: false,","+      resolution: {outcome: 'iframe_opt_out', reason: null},","+    },","+    {","+      name: 'a Studio outside the workbench',","+      setup: () => {},","+      federatedAssetSource: undefined,","+      resolution: {outcome: 'iframe_unsupported', reason: 'standalone_studio'},","+    },","+    {","+      name: 'a cold start before the application list is published',","+      setup: () => stubMessageBusHost(),","+      federatedAssetSource: undefined,","+      resolution: {outcome: 'iframe_fallback', reason: 'cold_start'},","+    },","+    {","+      name: 'an error published for the application list',","+      setup: () => stubMessageBusHost().publish('applications.list', {ok: false}),","+      federatedAssetSource: undefined,","+      resolution: {outcome: 'iframe_fallback', reason: 'applications_list_failed'},","+    },","+    {","+      name: 'an application list without a Media Library view',","+      setup: () =>","+        publishViews([appWithView({id: 'stock-app', name: 'stock-photos', viewName: 'stock'})]),","+      federatedAssetSource: undefined,","+      resolution: {outcome: 'iframe_fallback', reason: 'no_view'},","+    },","+  ])('passes the iframe source its resolution for $name', async (testCase) => {","+    testCase.setup()","+","+    const {file, image} = await resolveAssetSources({","+      mediaLibrary: {","+        enabled: true,","+        ...(testCase.federatedAssetSource === undefined","+          ? {}","+          : {__internal: {federatedAssetSource: testCase.federatedAssetSource}}),","+      },","+    })","+","+    for (const sources of [file, image]) {","+      const view = mediaLibraryDialogElement(sources)","+      expect(view.type).toBe(MediaLibraryAssetSource)","+      expect(view.props.resolution).toEqual(testCase.resolution)","+    }","+  })","+})"],"additions":78,"deletions":3,"truncated":false},{"path":"packages/sanity/src/core/config/prepareConfig.tsx","lines":["@@ -22,12 +22,14 @@ import {"," import {","   createFederatedSanityMediaLibraryFileSource,","   createFederatedSanityMediaLibraryImageSource,","-  createSanityMediaLibraryFileSource,","-  createSanityMediaLibraryImageSource,","+  createIframeSanityMediaLibraryFileSource,","+  createIframeSanityMediaLibraryImageSource,"," } from '../form/studio/assetSourceMediaLibrary'","+import {type MediaLibraryAssetSourceIframeResolution} from '../form/studio/assetSourceMediaLibrary/__telemetry__/mediaLibraryAssetSource.telemetry'"," import {","   createFederatedAssetSource,","-  getCurrentFederatedAssetSourceViews,","+  discoverFederatedAssetSourceViews,","+  type FederatedAssetSourceDiscovery,","   isMediaLibraryView,"," } from '../form/studio/federatedAssetSource'"," import {prepareI18n} from '../i18n/i18nConfig'","@@ -295,27 +297,33 @@ const createMediaLibraryAssetSources = (config: PluginOptions) => {","   const brokeredSourcesEnabled = federatedSourcesConfig?.enabled === true"," ","   // The `asset_source` views brokered over the workbench message bus, read","-  // synchronously since sources are resolved once here. `undefined` outside","-  // the workbench; on a cold start in which the workbench has not published","-  // its application list yet, `[]` — either way every brokered source is","-  // simply absent and the Media Library keeps its iframe select dialog, so","+  // synchronously since sources are resolved once here. Outside the","+  // workbench, or on a cold start in which the workbench has not published","+  // its application list yet, there are none — either way every brokered","+  // source is simply absent and the Media Library keeps its iframe dialog, so","   // the race can never cost the Media Library source itself. Only consult","   // the bus when a source could use the result — with `federated` defaulting","   // on, reading it unconditionally would open a message-bus connection in","   // every workspace, Media Library or not.","-  const viewsFromBus =","+  const discovery =","     (federated && enabled) || brokeredSourcesEnabled","-      ? getCurrentFederatedAssetSourceViews()","+      ? discoverFederatedAssetSourceViews()","       : undefined","-  const brokeredViews = viewsFromBus ?? []","+  const brokeredViews = discovery?.status === 'published' ? discovery.views : []"," ","   // The Media Library's own view replaces the select dialog of the built-in","   // source below; views from other applications become their own sources.","   const mediaLibraryView = federated ? brokeredViews.find(isMediaLibraryView) : undefined"," ","-  // Outside the workbench (`viewsFromBus === undefined`) the iframe dialog is","-  // the normal path, not a degraded one — stay quiet there.","-  if (federated && enabled && !mediaLibraryView && viewsFromBus !== undefined) {","+  // Outside the workbench the iframe dialog is the normal path, not a","+  // degraded one — stay quiet there.","+  if (","+    federated &&","+    enabled &&","+    !mediaLibraryView &&","+    discovery !== undefined &&","+    discovery.status !== 'standalone'","+  ) {","     notifyFederatedFallbackOnce(","       'no Media Library asset_source view in the brokered application list',","     )","@@ -346,25 +354,50 @@ const createMediaLibraryAssetSources = (config: PluginOptions) => {","     return {fileSource: null, imageSource: null, federatedSources}","   }"," ","-  const fileSource = mediaLibraryView","-    ? createFederatedSanityMediaLibraryFileSource({","+  if (mediaLibraryView) {","+    return {","+      fileSource: createFederatedSanityMediaLibraryFileSource({","         libraryId: libraryId || null,","         view: mediaLibraryView,","-      })","-    : createSanityMediaLibraryFileSource({","-        libraryId: libraryId || null,","-      })","-","-  const imageSource = mediaLibraryView","-    ? createFederatedSanityMediaLibraryImageSource({","+      }),","+      imageSource: createFederatedSanityMediaLibraryImageSource({","         libraryId: libraryId || null,","         view: mediaLibraryView,","-      })","-    : createSanityMediaLibraryImageSource({","-        libraryId: libraryId || null,","-      })","+      }),","+      federatedSources,","+    }","+  }"," ","-  return {fileSource, imageSource, federatedSources}","+  const resolution = resolveIframeResolution(federated, discovery)","+  return {","+    fileSource: createIframeSanityMediaLibraryFileSource({","+      libraryId: libraryId || null,","+      resolution,","+    }),","+    imageSource: createIframeSanityMediaLibraryImageSource({","+      libraryId: libraryId || null,","+      resolution,","+    }),","+    federatedSources,","+  }","+}","+","+/** Why the Media Library source uses the iframe, reported when it opens. */","+function resolveIframeResolution(","+  federated: boolean,","+  discovery: FederatedAssetSourceDiscovery | undefined,","+): MediaLibraryAssetSourceIframeResolution {","+  if (!federated) return {outcome: 'iframe_opt_out', reason: null}","+  switch (discovery?.status) {","+    case 'pending':","+      return {outcome: 'iframe_fallback', reason: 'cold_start'}","+    case 'failed':","+      return {outcome: 'iframe_fallback', reason: 'applications_list_failed'}","+    case 'published':","+      return {outcome: 'iframe_fallback', reason: 'no_view'}","+    default:","+      return {outcome: 'iframe_unsupported', reason: 'standalone_studio'}","+  }"," }"," "," // Create default asset sources with configuration"],"additions":60,"deletions":27,"truncated":false},{"path":"packages/sanity/src/core/form/studio/assetSourceMediaLibrary/__telemetry__/mediaLibraryAssetSource.telemetry.ts","lines":["@@ -0,0 +1,71 @@","+import {defineEvent} from '@sanity/telemetry'","+import {type AssetSourceComponentAction} from '@sanity/types'","+","+/**","+ * How the Media Library asset source rendered:","+ * - `federated`: the Media Library's brokered view mounted.","+ * - `iframe_fallback`: the federated view was wanted but the iframe was used,","+ *   see the `reason`.","+ * - `iframe_opt_out`: `mediaLibrary.__internal.federatedAssetSource` is `false`.","+ * - `iframe_unsupported`: the Studio does not run inside the workbench, so","+ *   there is no federated view to use.","+ *","+ * @internal","+ */","+export type MediaLibraryAssetSourceOutcome =","+  | 'federated'","+  | 'iframe_fallback'","+  | 'iframe_opt_out'","+  | 'iframe_unsupported'","+","+/**","+ * Why the iframe was used:","+ * - `cold_start`: the workbench had not published its application list when","+ *   the Studio resolved its asset sources.","+ * - `applications_list_failed`: the workbench published an error for the list.","+ * - `no_view`: the list has no loadable Media Library `asset_source` view.","+ * - `load_failed`: the view module failed to load, or threw when mounted.","+ * - `standalone_studio`: the Studio does not run inside the workbench.","+ *","+ * @internal","+ */","+export type MediaLibraryAssetSourceReason =","+  | 'cold_start'","+  | 'applications_list_failed'","+  | 'no_view'","+  | 'load_failed'","+  | 'standalone_studio'","+","+/**","+ * An outcome decided when the Studio resolved its asset sources, before any","+ * picker opened. Carried by the iframe source so it can report it on open.","+ *","+ * @internal","+ */","+export interface MediaLibraryAssetSourceIframeResolution {","+  outcome: Exclude<MediaLibraryAssetSourceOutcome, 'federated'>","+  reason: MediaLibraryAssetSourceReason | null","+}","+","+/** @internal */","+export interface MediaLibraryAssetSourceResolvedInfo {","+  outcome: MediaLibraryAssetSourceOutcome","+  /** Set for `iframe_fallback` and `iframe_unsupported`, otherwise `null`. */","+  reason: MediaLibraryAssetSourceReason | null","+  /** The asset source action the source opened with. */","+  action: AssetSourceComponentAction","+  /**","+   * Milliseconds from opening the source until the federated view mounted or","+   * failed. `null` when the outcome was decided before the source opened.","+   */","+  durationMs: number | null","+}","+","+/** @internal */","+export const MediaLibraryAssetSourceResolved = defineEvent<MediaLibraryAssetSourceResolvedInfo>({","+  name: 'Media Library Asset Source Resolved',","+  version: 1,","+  description:","+    'The Media Library asset source opened (select, upload or open in source) and rendered either ' +","+    'the federated view or the iframe. Sent once per open, with the reason for an iframe fallback.',","+})"],"additions":71,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/form/studio/assetSourceMediaLibrary/__tests__/MediaLibraryAssetSourceResolved.test.tsx","lines":["@@ -0,0 +1,177 @@","+import {type SanityClient} from '@sanity/client'","+import type * as TelemetryReactMod from '@sanity/telemetry/react'","+import {type AssetSource, type AssetSourceComponentProps} from '@sanity/types'","+import {render, waitFor} from '@testing-library/react'","+import noop from 'lodash-es/noop.js'","+import {type ReactNode} from 'react'","+import {beforeEach, describe, expect, test, vi} from 'vitest'","+","+import {createMockSanityClient} from '../../../../../../test/mocks/mockSanityClient'","+import {createTestProvider} from '../../../../../../test/testUtils/TestProvider'","+import {ColorSchemeProvider} from '../../../../studio/colorScheme'","+import type * as FormValueMod from '../../../contexts/FormValue'","+import {loadFederatedAssetSourceModule} from '../../federatedAssetSource/loadModule'","+import {type FederatedAssetSourceView} from '../../federatedAssetSource/types'","+import {MediaLibraryAssetSourceResolved} from '../__telemetry__/mediaLibraryAssetSource.telemetry'","+import {","+  createFederatedSanityMediaLibraryImageSource,","+  createIframeSanityMediaLibraryImageSource,","+} from '../createAssetSource'","+import {MediaLibraryUploader} from '../uploader'","+","+const log = vi.hoisted(() => vi.fn())","+","+vi.mock('@sanity/telemetry/react', async (importOriginal) => ({","+  ...(await importOriginal<typeof TelemetryReactMod>()),","+  useTelemetry: () => ({log}),","+}))","+","+vi.mock('../../federatedAssetSource/loadModule', () => ({","+  loadFederatedAssetSourceModule: vi.fn(),","+}))","+","+// The candidate-validation hook reads useFormValue; stub it so the harness","+// need not mount FormValueProvider.","+vi.mock('../../../contexts/FormValue', async (importOriginal) => ({","+  ...(await importOriginal<typeof FormValueMod>()),","+  useFormValue: () => undefined,","+}))","+","+// MediaLibraryProvider's ensure-flow talks to the real API; provide the ids","+// context directly.","+vi.mock('../shared/MediaLibraryProvider', async () => {","+  const {MediaLibraryIdsContext} = await import('sanity/_singletons')","+  return {","+    MediaLibraryProvider: ({children}: {children: ReactNode}) => (","+      <MediaLibraryIdsContext.Provider","+        value={{organizationId: 'test-org-id', libraryId: 'test-library-id'}}","+      >","+        {children}","+      </MediaLibraryIdsContext.Provider>","+    ),","+  }","+})","+","+const VIEW: FederatedAssetSourceView = {","+  applicationId: 'ml-app',","+  applicationName: 'media-library',","+  applicationTitle: 'Media Library',","+  name: 'picker',","+  title: 'Media Library',","+  remote: {name: 'ml-app', entry: 'https://ml.example/mf-manifest.json'},","+  moduleId: 'ml-app/views/picker/asset_source',","+  interface: {","+    id: 'ml-app-picker',","+    type: 'asset_source',","+    name: 'picker',","+    title: 'Media Library',","+    version: '1',","+    moduleId: 'views/picker',","+    metadata: null,","+  },","+}","+","+function sourceProps(","+  assetSource: AssetSource,","+  overrides: Partial<AssetSourceComponentProps> = {},","+): AssetSourceComponentProps {","+  return {","+    action: 'select',","+    assetSource,","+    assetType: 'image',","+    accept: 'image/*',","+    selectionType: 'single',","+    selectedAssets: [],","+    onClose: noop,","+    onSelect: noop,","+    ...overrides,","+  }","+}","+","+async function renderSource(assetSource: AssetSource, props: AssetSourceComponentProps) {","+  const client = createMockSanityClient() as any as SanityClient","+  const TestProvider = await createTestProvider({","+    client,","+    config: {projectId: 'p1', dataset: 'd1', name: 'ws1'},","+  })","+  const Component = assetSource.component","+  return render(","+    <TestProvider>","+      <ColorSchemeProvider>","+        <Component {...props} />","+      </ColorSchemeProvider>","+    </TestProvider>,","+  )","+}","+","+function resolvedEvents() {","+  return log.mock.calls.filter(([event]) => event === MediaLibraryAssetSourceResolved)","+}","+","+beforeEach(() => {","+  log.mockReset()","+  vi.mocked(loadFederatedAssetSourceModule).mockReset()","+  vi.spyOn(console, 'warn').mockImplementation(() => {})","+})","+","+describe('Media Library Asset Source Resolved', () => {","+  test('reports the federated outcome once the view has mounted', async () => {","+    vi.mocked(loadFederatedAssetSourceModule).mockResolvedValue({","+      version: 1,","+      render: () => ({dispose: noop}),","+    })","+    const source = createFederatedSanityMediaLibraryImageSource({libraryId: null, view: VIEW})","+","+    await renderSource(source, sourceProps(source))","+","+    await waitFor(() => expect(resolvedEvents()).toHaveLength(1))","+    expect(resolvedEvents()[0][1]).toEqual({","+      outcome: 'federated',","+      reason: null,","+      action: 'select',","+      durationMs: expect.any(Number),","+    })","+  })","+","+  test('reports a load failure once, without a second event from the iframe fallback', async () => {","+    vi.mocked(loadFederatedAssetSourceModule).mockRejectedValue(new Error('remote failed to load'))","+    const source = createFederatedSanityMediaLibraryImageSource({libraryId: null, view: VIEW})","+    const uploader = new MediaLibraryUploader()","+    uploader.upload([new File(['a'], 'a.png', {type: 'image/png'})])","+","+    await renderSource(source, sourceProps(source, {action: 'upload', uploader}))","+","+    // The iframe fallback's hidden upload dialog mounts an iframe.","+    await waitFor(() => expect(document.querySelector('iframe')).toBeTruthy())","+    expect(resolvedEvents()).toHaveLength(1)","+    expect(resolvedEvents()[0][1]).toEqual({","+      outcome: 'iframe_fallback',","+      reason: 'load_failed',","+      action: 'upload',","+      durationMs: expect.any(Number),","+    })","+  })","+","+  test('reports the resolution the iframe source was created with when it opens', async () => {","+    const source = createIframeSanityMediaLibraryImageSource({","+      libraryId: null,","+      resolution: {outcome: 'iframe_fallback', reason: 'cold_start'},","+    })","+","+    const {unmount} = await renderSource(source, sourceProps(source, {action: 'openInSource'}))","+","+    await waitFor(() => expect(resolvedEvents()).toHaveLength(1))","+    expect(resolvedEvents()[0][1]).toEqual({","+      outcome: 'iframe_fallback',","+      reason: 'cold_start',","+      action: 'openInSource',","+      durationMs: null,","+    })","+","+    // Every open reports again.","+    unmount()","+    await renderSource(source, sourceProps(source))","+    await waitFor(() => expect(resolvedEvents()).toHaveLength(2))","+    expect(resolvedEvents()[1][1]).toMatchObject({action: 'select', reason: 'cold_start'})","+  })","+})"],"additions":177,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/form/studio/assetSourceMediaLibrary/createAssetSource.tsx","lines":["@@ -8,6 +8,7 @@ import {"," } from '@sanity/types'"," "," import {type FederatedAssetSourceView} from '../federatedAssetSource/types'","+import {type MediaLibraryAssetSourceIframeResolution} from './__telemetry__/mediaLibraryAssetSource.telemetry'"," import {FederatedMediaLibraryAssetSource} from './federated/FederatedMediaLibraryAssetSource'"," import {MediaLibraryAssetSource} from './shared/MediaLibraryAssetSource'"," import {MediaLibraryUploader} from './uploader'","@@ -76,6 +77,58 @@ export function createSanityMediaLibraryFileSource(","   }"," }"," ","+/**","+ * Props for the iframe Media Library source factories that `prepareConfig`","+ * uses: the public factory props plus why the federated view is not used.","+ *","+ * @internal","+ */","+export interface CreateIframeSanityMediaLibrarySourceProps extends CreateSanityMediaLibrarySourceProps {","+  resolution: MediaLibraryAssetSourceIframeResolution","+}","+","+/**","+ * {@link createSanityMediaLibraryImageSource}, reporting `resolution` in the","+ * `Media Library Asset Source Resolved` telemetry event when the source opens.","+ *","+ * @internal","+ */","+export function createIframeSanityMediaLibraryImageSource(","+  props: CreateIframeSanityMediaLibrarySourceProps,","+): AssetSource {","+  return {","+    ...createSanityMediaLibraryImageSource(props),","+    component: (sourceProps: AssetSourceComponentProps) => (","+      <MediaLibraryAssetSource","+        {...sourceProps}","+        libraryId={props.libraryId}","+        resolution={props.resolution}","+      />","+    ),","+  }","+}","+","+/**","+ * {@link createSanityMediaLibraryFileSource}, reporting `resolution` in the","+ * `Media Library Asset Source Resolved` telemetry event when the source opens.","+ *","+ * @internal","+ */","+export function createIframeSanityMediaLibraryFileSource(","+  props: CreateIframeSanityMediaLibrarySourceProps,","+): AssetSource {","+  return {","+    ...createSanityMediaLibraryFileSource(props),","+    component: (sourceProps: AssetSourceComponentProps) => (","+      <MediaLibraryAssetSource","+        {...sourceProps}","+        libraryId={props.libraryId}","+        resolution={props.resolution}","+      />","+    ),","+  }","+}","+"," /**","  * Props for the federated Media Library source factories: the iframe factory","  * props plus the brokered view that renders the select dialog."],"additions":53,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/form/studio/assetSourceMediaLibrary/federated/FederatedMediaLibraryAssetSource.tsx","lines":["@@ -11,6 +11,7 @@ import {"," } from '../../federatedAssetSource/types'"," import {DEFAULT_API_VERSION} from '../constants'"," import {useMediaLibraryIds} from '../hooks/useMediaLibraryIds'","+import {useReportAssetSourceResolved} from '../hooks/useReportAssetSourceResolved'"," import {useValidateAssetCandidate} from '../hooks/useValidateAssetCandidate'"," import {MediaLibraryAssetSource} from '../shared/MediaLibraryAssetSource'"," import {MediaLibraryProvider} from '../shared/MediaLibraryProvider'","@@ -51,9 +52,24 @@ export function FederatedMediaLibraryAssetSource(","   const client = useClient({apiVersion: DEFAULT_API_VERSION})","   const projectId = client.config().projectId","   const [unavailable, setUnavailable] = useState(false)","+  const [openedAt] = useState(() => performance.now())","+  const reportResolved = useReportAssetSourceResolved(sourceProps.action ?? 'select')","+","+  const handleMounted = () => {","+    reportResolved({","+      outcome: 'federated',","+      reason: null,","+      durationMs: Math.round(performance.now() - openedAt),","+    })","+  }"," ","   // The React Compiler memoizes this; identity is stable across renders.","   const handleUnavailable = (reason: unknown) => {","+    reportResolved({","+      outcome: 'iframe_fallback',","+      reason: 'load_failed',","+      durationMs: Math.round(performance.now() - openedAt),","+    })","     // The dying view may have left upload files mid-flight (`uploading`) or","     // individually failed (`error`) — its writer is gone, so nothing else","     // will ever move them, and the iframe fallback dialog only issues its","@@ -106,6 +122,7 @@ export function FederatedMediaLibraryAssetSource(","       {/* The body-level portal escape lives in FederatedAssetSourceDialog,","           shared with third-party b