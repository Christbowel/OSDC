{"id":"GHSA-7hvw-3c2q-45qg","axis":"advisories","repo":"bep/imagemeta","sha":"2289fdf83fcd238d86f72e65c588da687c998437","parsed":{"files":[{"path":"imagedecoder_png.go","lines":["@@ -7,6 +7,7 @@ import ("," \t\"bytes\""," \t\"compress/zlib\""," \t\"encoding/hex\"","+\t\"errors\""," \t\"fmt\""," \t\"io\""," )","@@ -90,6 +91,9 @@ func (e *imageDecoderPNG) decode() error {"," \t\t\t\t\tif err != nil {"," \t\t\t\t\t\treturn newInvalidFormatError(fmt.Errorf(\"decompressing zTXt: %w\", err))"," \t\t\t\t\t}","+\t\t\t\t\tif int64(len(data)) < profileNameLength {","+\t\t\t\t\t\treturn newInvalidFormatErrorf(\"zTXt data too short: %d\", len(data))","+\t\t\t\t\t}"," \t\t\t\t\tdata = data[profileNameLength:] // Skip the header bytes."," \t\t\t\t\tdata = bytes.ReplaceAll(data, []byte(\"\\n\"), []byte(\"\"))"," \t\t\t\t\td := make([]byte, hex.DecodedLen(len(data)))","@@ -120,6 +124,9 @@ func (e *imageDecoderPNG) decode() error {"," }"," "," func decompressZTXt(data []byte) ([]byte, error) {","+\tif len(data) == 0 {","+\t\treturn nil, errors.New(\"no zTXt data\")","+\t}"," \t// The first byte indicates the compression method, for which only deflate is currently defined (method zero)."," \tcompressionMethod := data[0]"," \tif compressionMethod != 0 {","@@ -131,6 +138,14 @@ func decompressZTXt(data []byte) ([]byte, error) {"," \t\treturn nil, err"," \t}"," \tdefer z.Close()","-\tp, err := io.ReadAll(z)","-\treturn p, err","+","+\t// Bound the inflated size; a small zlib stream can otherwise expand to gigabytes.","+\tp, err := io.ReadAll(io.LimitReader(z, maxBufSize+1))","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tif len(p) > maxBufSize {","+\t\treturn nil, fmt.Errorf(\"uncompressed zTXt size exceeds max %d\", maxBufSize)","+\t}","+\treturn p, nil"," }"],"additions":17,"deletions":2,"truncated":false},{"path":"io.go","lines":["@@ -289,6 +289,12 @@ func (e *streamReader) readNFromRIntoBuf(n int, r io.Reader) {"," }"," "," func (e *streamReader) readNFromRIntoBufE(n int, r io.Reader) error {","+\tif n < 0 {","+\t\treturn newInvalidFormatErrorf(\"negative length %d\", n)","+\t}","+\tif n > maxBufSize {","+\t\treturn newInvalidFormatErrorf(\"length %d exceeds max %d\", n, maxBufSize)","+\t}"," \te.allocateBuf(n)"," \tn2, err := io.ReadFull(r, e.buf[:n])"," \tif err != nil {"],"additions":6,"deletions":0,"truncated":false},{"path":"metadecoder_iptc.go","lines":["@@ -405,7 +405,7 @@ func resolveCodedCharacterSet(b []byte) string {"," \t\treturn characterSetISO88591"," \t}"," ","-\tif len(b) > 3 && b[0] == esc && (b[1] == dot || b[2] == dot || b[3] == dot) && b[4] == latinCapitalA {","+\tif len(b) > 4 && b[0] == esc && (b[1] == dot || b[2] == dot || b[3] == dot) && b[4] == latinCapitalA {"," \t\treturn characterSetISO88591"," \t}"," "],"additions":1,"deletions":1,"truncated":false},{"path":"security_test.go","lines":["@@ -0,0 +1,123 @@","+// Copyright 2024 Bjørn Erik Pedersen","+// SPDX-License-Identifier: MIT","+","+package imagemeta","+","+import (","+\t\"bytes\"","+\t\"compress/zlib\"","+\t\"encoding/binary\"","+\t\"testing\"","+","+\tqt \"github.com/frankban/quicktest\"","+)","+","+// pngWithRawProfileIPTC builds a minimal PNG with a single zTXt chunk carrying the","+// \"Raw profile type iptc\" keyword. declaredDataLen goes into the chunk length, so it","+// can be made to disagree with the payload actually delivered.","+func pngWithRawProfileIPTC(declaredDataLen int, payload []byte) []byte {","+\tkeyword := append([]byte(\"Raw profile type iptc\"), 0)","+\tvar buf bytes.Buffer","+\tbuf.Write([]byte{0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a})","+\tbinary.Write(&buf, binary.BigEndian, uint32(len(keyword)+declaredDataLen))","+\tbuf.WriteString(\"zTXt\")","+\tbuf.Write(keyword)","+\tbuf.Write(payload)","+\tbuf.Write([]byte{0, 0, 0, 0}) // CRC","+\treturn buf.Bytes()","+}","+","+// zTXtPayload returns a deflate compression method byte followed by a zlib stream","+// that inflates to size bytes of hex digits.","+func zTXtPayload(size int) []byte {","+\tvar buf bytes.Buffer","+\tbuf.WriteByte(0) // Compression method: deflate.","+\tw := zlib.NewWriter(&buf)","+\tw.Write(bytes.Repeat([]byte(\"41\"), size/2))","+\tw.Close()","+\treturn buf.Bytes()","+}","+","+func decodePNGIPTC(b []byte) error {","+\t_, err := Decode(Options{","+\t\tR:           bytes.NewReader(b),","+\t\tImageFormat: PNG,","+\t\tSources:     IPTC,","+\t})","+\treturn err","+}","+","+// A length read off the wire must never reach make. This is the bound the eXIf path","+// has always had via bufferedReader; it lives in the shared read primitive so every","+// size-bearing read inherits it.","+func TestReadNBounds(t *testing.T) {","+\tc := qt.New(t)","+","+\tread := func(n int) error {","+\t\te := newStreamReader(bytes.NewReader(make([]byte, 8)), binary.BigEndian)","+\t\treturn e.readNFromRIntoBufE(n, e.r)","+\t}","+","+\tc.Assert(read(maxBufSize+1), qt.ErrorMatches, \".*exceeds max.*\")","+\tc.Assert(read(-1), qt.ErrorMatches, \".*negative length.*\")","+\tc.Assert(read(4), qt.IsNil)","+}","+","+// A small zlib stream must not be allowed to inflate without bound.","+func TestDecompressZTXtBounds(t *testing.T) {","+\tc := qt.New(t)","+","+\t_, err := decompressZTXt(zTXtPayload(maxBufSize * 4))","+\tc.Assert(err, qt.ErrorMatches, \".*uncompressed zTXt size exceeds max.*\")","+","+\t_, err = decompressZTXt(nil)","+\tc.Assert(err, qt.ErrorMatches, \".*no zTXt data.*\")","+","+\tb, err := decompressZTXt(zTXtPayload(64))","+\tc.Assert(err, qt.IsNil)","+\tc.Assert(len(b), qt.Equals, 64)","+}","+","+// End to end: a crafted PNG must not be able to drive an allocation from its declared","+// chunk length, nor inflate without bound. Both are memory exhaustion, which recover","+// cannot catch.","+func TestDecodePNGZTXtRawProfileIPTC(t *testing.T) {","+\tc := qt.New(t)","+","+\tc.Run(\"inflated size beyond max\", func(c *qt.C) {","+\t\tpayload := zTXtPayload(maxBufSize * 4)","+\t\tc.Assert(len(payload) < 600*1024, qt.IsTrue, qt.Commentf(\"payload is %d bytes\", len(payload)))","+\t\tc.Assert(decodePNGIPTC(pngWithRawProfileIPTC(len(payload), payload)), qt.ErrorMatches, \".*uncompressed zTXt size exceeds max.*\")","+\t})","+","+\tc.Run(\"inflated size shorter than keyword\", func(c *qt.C) {","+\t\tpayload := zTXtPayload(4)","+\t\tc.Assert(decodePNGIPTC(pngWithRawProfileIPTC(len(payload), payload)), qt.ErrorMatches, \".*zTXt data too short.*\")","+\t})","+","+\tc.Run(\"no data\", func(c *qt.C) {","+\t\tc.Assert(decodePNGIPTC(pngWithRawProfileIPTC(0, nil)), qt.ErrorMatches, \".*no zTXt data.*\")","+\t})","+","+\t// 42 bytes on disk claiming 256 MB of zTXt data. The declared length is rejected","+\t// before it reaches make, so this returns without consuming the claimed memory.","+\tc.Run(\"declared length beyond max\", func(c *qt.C) {","+\t\tpng := pngWithRawProfileIPTC(256<<20, nil)","+\t\tc.Assert(len(png) < 64, qt.IsTrue)","+\t\tc.Assert(decodePNGIPTC(png), qt.IsNil)","+\t})","+}","+","+// resolveCodedCharacterSet indexes b[4], so it must require 5 bytes, not 4.","+func TestResolveCodedCharacterSetShortInput(t *testing.T) {","+\tc := qt.New(t)","+","+\tfor i := range 6 {","+\t\tb := bytes.Repeat([]byte{0x1b}, i)","+\t\tc.Assert(func() { resolveCodedCharacterSet(b) }, qt.Not(qt.PanicMatches), \".*\")","+\t}","+","+\tc.Assert(resolveCodedCharacterSet([]byte{0x1b, 0x2e, 0x2e, 0x2e}), qt.Equals, \"\")","+\tc.Assert(resolveCodedCharacterSet([]byte{0x1b, 0x2e, 0x2e, 0x2e, 0x41}), qt.Equals, characterSetISO88591)","+\tc.Assert(resolveCodedCharacterSet([]byte{0x1b, 0x25, 0x47}), qt.Equals, characterSetUTF8)","+}",""],"additions":123,"deletions":0,"truncated":false}],"additions":147,"deletions":3,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-20T17:57:01.965546+00:00"}