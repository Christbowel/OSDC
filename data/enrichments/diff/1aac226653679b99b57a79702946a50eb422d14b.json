 0), filterStatRow(\"logs/b\", 0)})","+\t\tuploadFilterSourceIndex(t, bucket, sourcePath, objBuilder)","+","+\t\tartifact, err := newTestExecutorContext(t, bucket).doIndexFilter(ctx, &physical.IndexFilter{","+\t\t\tNodeID: ulid.Make(), Tenant: \"acme\", SourceIndexPath: sourcePath,","+\t\t\tObjectPaths: []string{\"logs/a\"},","+\t\t})","+\t\trequire.NoError(t, err)","+","+\t\tvar blooms []string","+\t\tfor _, row := range readAllPostingsRowsFromBucket(ctx, t, bucket, artifact.Path) {","+\t\t\tif row.Kind == postings.KindBloom {","+\t\t\t\tblooms = append(blooms, row.ObjectPath)","+\t\t\t}","+\t\t}","+\t\trequire.Equal(t, []string{\"logs/a\"}, blooms)","+\t})","+","+\tt.Run(\"keeps every stats row of a listed object across several stats sections\", func(t *testing.T) {","+\t\tbucket := objstore.NewInMemBucket()","+\t\tobjBuilder := dataobj.NewBuilder(nil)","+\t\tappendFilterPostings(t, objBuilder, \"acme\", 1<<20, []string{\"logs/a\", \"logs/b\"}, false)","+\t\tappendFilterStats(t, objBuilder, \"acme\", []stats.Stat{filterStatRow(\"logs/a\", 0), filterStatRow(\"logs/b\", 0)})","+\t\tappendFilterStats(t, objBuilder, \"acme\", []stats.Stat{filterStatRow(\"logs/a\", 1), filterStatRow(\"logs/b\", 1)})","+\t\tuploadFilterSourceIndex(t, bucket, sourcePath, objBuilder)","+\t\tsourceStats := 0","+\t\tfor _, sec := range openObjectFromBucket(ctx, t, bucket, sourcePath).Sections() {","+\t\t\tif stats.CheckSection(sec) {","+\t\t\t\tsourceStats++","+\t\t\t}","+\t\t}","+\t\trequire.Equal(t, 2, sourceStats, \"the source index must hold two stats sections\")","+","+\t\tartifact, err := newTestExecutorContext(t, bucket).doIndexFilter(ctx, &physical.IndexFilter{","+\t\t\tNodeID: ulid.Make(), Tenant: \"acme\", SourceIndexPath: sourcePath,","+\t\t\tObjectPaths: []string{\"logs/a\"},","+\t\t})","+\t\trequire.NoError(t, err)","+","+\t\ttype key struct {","+\t\t\tobject  string","+\t\t\tsection int64","+\t\t}","+\t\tvar got []key","+\t\tfor _, row := range readAllStatsRowsFromBucket(t, bu