f(plan)}, nil"," \t\t\t}}"," ","-\t\t\tartifacts, err := d.Run(context.Background(), \"acme\", \"index-merge\", plans)","+\t\t\tartifacts, err := d.Run(context.Background(), \"acme\", plans)"," \t\t\trequire.ErrorContains(t, err, tc.wantErr)"," \t\t\tif tc.err != nil {"," \t\t\t\trequire.ErrorIs(t, err, tc.err)"],"additions":36,"deletions":8,"truncated":false},{"path":"pkg/engine/compactor/workflow_builder.go","lines":["@@ -57,6 +57,20 @@ func buildLogMergePlan("," \treturn physical.FromGraph(g)"," }"," ","+// buildIndexFilterPlan returns a single-root physical.Plan holding one","+// IndexFilter node that keeps the rows of objectPaths from sourceIndexPath.","+func buildIndexFilterPlan(tenant, sourceIndexPath string, objectPaths []string) *physical.Plan {","+\tnode := &physical.IndexFilter{","+\t\tNodeID:          ulid.Make(),","+\t\tTenant:          tenant,","+\t\tSourceIndexPath: sourceIndexPath,","+\t\tObjectPaths:     objectPaths,","+\t}","+\tvar g dag.Graph[physical.Node]","+\tg.Add(node)","+\treturn physical.FromGraph(g)","+}","+"," func buildSortObjectPlan(sourceObjectPath string, sortSchema []string) *physical.Plan {"," \tnode := &physical.SortObject{"," \t\tNodeID:           ulid.Make(),"],"additions":14,"deletions":0,"truncated":false},{"path":"pkg/engine/internal/executor/executor.go","lines":["@@ -229,6 +229,8 @@ func (c *Context) execute(ctx context.Context, node physical.Node) Pipeline {"," \t\treturn NewObservedPipeline(n.Type().String(), nodeAttributes(n), c.executeLogMerge(n))"," \tcase *physical.SortObject:"," \t\treturn NewObservedPipeline(n.Type().String(), nodeAttributes(n), c.executeSortObject(n))","+\tcase *physical.IndexFilter:","+\t\treturn NewObservedPipeline(n.Type().String(), nodeAttributes(n), c.executeIndexFilter(n))"," \tdefault:"," \t\treturn errorPipeline(ctx, fmt.Errorf(\"invalid node type: %T\", node))"," \t}"],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/engine/internal/executor/index_filter.go","lines":["@@ -0,0 +1,139 @@","+package executor","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+","+\t\"github.com/apache/arrow-go/v18/arrow/memory\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\tv2 \"github.com/grafana/loki/v3/pkg/dataobj/compaction/v2\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/index/indexobj\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/pointers\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/postings\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/stats\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/streams\"","+\t\"github.com/grafana/loki/v3/pkg/engine/internal/planner/physical\"","+\titer \"github.com/grafana/loki/v3/pkg/iter/v2\"","+)","+","+// executeIndexFilter copies the rows of the node's log objects from the","+// source index into a new index object, and emits a record that reports the","+// content-hash path of the new index.","+func (c *Context) executeIndexFilter(node *physical.IndexFilter) Pipeline {","+\treturn newLazyPipeline(func(ctx context.Context, _ []Pipeline) Pipeline {","+\t\tartifact, err := c.doIndexFilter(ctx, node)","+\t\tif err != nil {","+\t\t\treturn errorPipeline(ctx, err)","+\t\t}","+\t\trec, err := artifact.ToRecordBatch(memory.DefaultAllocator)","+\t\tif err != nil {","+\t\t\treturn errorPipeline(ctx, err)","+\t\t}","+\t\treturn NewBufferedPipeline(rec)","+\t}, nil)","+}","+","+func (c *Context) doIndexFilter(ctx context.Context, node *physical.IndexFilter) (*v2.ResultArtifact, error) {","+\tif c.bucket == nil {","+\t\treturn nil, errors.New(\"no object store bucket configured\")","+\t}","+\tif node.Tenant == \"\" || node.SourceIndexPath == \"\" {","+\t\treturn nil, fmt.Errorf(\"IndexFilter: malformed plan: tenant %q, source index %q\", node.Tenant, node.SourceIndexPath)","+\t}","+\tif len(node.ObjectPaths) == 0 {","+\t\treturn nil, errors.New(\"IndexFilter: no object paths to keep\")","+\t}","+","+\tkeep := make(map[string]struct{}, len(node.ObjectPaths))","+\tfor _, path := range node.ObjectPaths {","+\t\tkeep[path] = struct{}{}","+\t}","+","+\tsource, err := dataobj.FromBucket(ctx, c.bucket, node.SourceIndexPath, 0)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"opening source index %q: %w\", node.SourceIndexPath, err)","+\t}","+","+\tbuilder, err := indexobj.NewMergeBuilder(c.indexobjCfg, c.scratchStore)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"creating index builder: %w\", err)","+\t}","+\tdefer builder.Reset()","+","+\tfoundPostings := make(map[string]struct{}, len(keep))","+\tfoundStats := make(map[string]struct{}, len(keep))","+\tfor _, sec := range source.Sections() {","+\t\tif sec.Tenant != node.Tenant {","+\t\t\tcontinue","+\t\t}","+\t\tswitch {","+\t\tcase postings.CheckSection(sec):","+\t\t\terr = copyRows(ctx, sec, openPostingsReader, keep, foundPostings, func(row postings.Row) string { return row.ObjectPath },","+\t\t\t\tfunc(row postings.Row) error { return c.writePostingsRow(builder, node.Tenant, row) })","+\t\tcase stats.CheckSection(sec):","+\t\t\terr = copyRows(ctx, sec, openStatsReader, keep, foundStats, func(row stats.Stat) string { return row.ObjectPath },","+\t\t\t\tfunc(row stats.Stat) error { return builder.AppendStat(node.Tenant, row) })","+\t\tcase pointers.CheckSection(sec):","+\t\t\t// Pointers sections may exist for fresh indexes until this section is no longer built.","+\t\t\t// The compactor does not support them.","+\t\t\tcontinue","+\t\tcase streams.CheckSection(sec):","+\t\t\t// Streams sections may exist for fresh indexes until this section is no longer built.","+\t\t\t// The compactor does not support them.","+\t\t\tcontinue","+\t\tdefault:","+\t\t\treturn nil, fmt.Errorf(\"filtering source index %q: unknown section %q\", node.SourceIndexPath, sec)","+\t\t}","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"filtering source index %q: %w\", node.SourceIndexPath, err)","+\t\t}","+\t}","+","+\t// A kept object without postings rows or without stats rows means the","+\t// planner and the source index disagree. Fail rather than publish an","+\t// index that cannot find the object, or cannot plan it.","+\tfor _, path := range node.ObjectPaths {","+\t\tif _, ok := foundPostings[path]; !ok {","+\t\t\treturn nil, fmt.Errorf(\"source index %q has no postings rows for object %q\", node.SourceIndexPath, path)","+\t\t}","+\t\tif _, ok := foundStats[path]; !ok {","+\t\t\treturn nil, fmt.Errorf(\"source index %q has no stats rows for object %q\", node.SourceIndexPath, path)","+\t\t}","+\t}","+","+\tartifact, _, _, err := c.uploadIndex(ctx, node.Tenant, builder)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"index filter output for source index %q: %w\", node.SourceIndexPath, err)","+\t}","+\treturn artifact, nil","+}","+","+// copyRows passes each row of sec whose object path is in keep to write, and","+// records that object path in found.","+func copyRows[R any](","+\tctx context.Context,","+\tsec *dataobj.Section,","+\topen func(context.Context, *dataobj.Section) (iter.CloseIterator[R], error),","+\tkeep, found map[string]struct{},","+\tobjectPath func(R) string,","+\twrite func(R) error,","+) error {","+\trows, err := open(ctx, sec)","+\tif err != nil {","+\t\treturn err","+\t}","+\tfor rows.Next() {","+\t\trow := rows.At()","+\t\tpath := objectPath(row)","+\t\tif _, ok := keep[path]; !ok {","+\t\t\tcontinue","+\t\t}","+\t\tfound[path] = struct{}{}","+\t\tif err := write(row); err != nil {","+\t\t\treturn errors.Join(err, rows.Close())","+\t\t}","+\t}","+\treturn errors.Join(rows.Err(), rows.Close())","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"pkg/engine/internal/executor/index_filter_test.go","lines":["@@ -0,0 +1,478 @@","+package executor","+","+import (","+\t\"context\"","+\t\"io\"","+\t\"slices\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/apache/arrow-go/v18/arrow\"","+\t\"github.com/oklog/ulid/v2\"","+\t\"github.com/prometheus/prometheus/model/labels\"","+\t\"github.com/stretchr/testify/require\"","+\t\"github.com/thanos-io/objstore\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\tv2 \"github.com/grafana/loki/v3/pkg/dataobj/compaction/v2\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/indexpointers\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/pointers\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/postings\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/stats\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/streams\"","+\t\"github.com/grafana/loki/v3/pkg/engine/internal/planner/physical\"","+)","+","+// buildFilterSourceIndex uploads an index with one postings row and one stats","+// row per log object, for each tenant. A small postingsSectionSize splits the","+// postings into several sections.","+func buildFilterSourceIndex(t *testing.T, bucket objstore.Bucket, path string, postingsSectionSize int, objectsByTenant map[string][]string) {","+\tt.Helper()","+\tobjBuilder := dataobj.NewBuilder(nil)","+\tfor tenant, objects := range objectsByTenant {","+\t\tappendFilterPostings(t, objBuilder, tenant, postingsSectionSize, objects, false)","+\t\tvar rows []stats.Stat","+\t\tfor _, object := range objects {","+\t\t\trows = append(rows, filterStatRow(object, 0))","+\t\t}","+\t\tappendFilterStats(t, objBuilder, tenant, rows)","+\t}","+\tuploadFilterSourceIndex(t, bucket, path, objBuilder)","+}","+","+// appendFilterPostings appends one postings section builder with a label row","+// per object, and a bloom row per object when withBlooms is true.","+func appendFilterPostings(t *testing.T, objBuilder *dataobj.Builder, tenant string, sectionSize int, objects []string, withBlooms bool) {","+\tt.Helper()","+\tpostingsBuilder := postings.NewBuilder(nil, 0, 0, sectionSize)","+\tpostingsBuilder.SetTenant(tenant)","+\tfor i, object := range objects {","+\t\tts := time.Unix(0, int64(1_000+i))","+\t\tpostingsBuilder.ObserveLabelPosting(postings.LabelObservation{","+\t\t\tObjectPath: object, ColumnName: \"service_name\", LabelValue: object,","+\t\t\tStreamID: 1, Timestamp: ts, UncompressedSize: 100,","+\t\t})","+\t\tif withBlooms {","+\t\t\tpostingsBuilder.PrepareBloomColumn(object, 0, \"trace_id\", 1, 1)","+\t\t\trequire.NoError(t, postingsBuilder.ObserveBloomPosting(postings.BloomObservation{","+\t\t\t\tObjectPath: object, ShardBuckets: 1, ColumnName: \"trace_id\",","+\t\t\t\tValue: \"trace-\" + object, StreamID: 1, Timestamp: ts,","+\t\t\t}))","+\t\t}","+\t}","+\trequire.NoError(t, objBuilder.Append(postingsBuilder))","+}","+","+// appendFilterStats appends one stats section with rows.","+func appendFilterStats(t *testing.T, objBuilder *dataobj.Builder, tenant string, rows []stats.Stat) {","+\tt.Helper()","+\tstatsBuilder := stats.NewBuilder(nil, stats.ColumnarSectionEncoder(2048, 1000))","+\tstatsBuilder.SetTenant(tenant)","+\tfor _, row := range rows {","+\t\tstatsBuilder.Append(row)","+\t}","+\trequire.NoError(t, objBuilder.Append(statsBuilder))","+}","+","+func filterStatRow(object string, sectionIndex int64) stats.Stat {","+\treturn stats.Stat{","+\t\tObjectPath: object, SectionIndex: sectionIndex, SortSchema: \"label:service_name\",","+\t\tLabels:       map[string]string{\"service_name\": object},","+\t\tMinTimestamp: 1_000 + sectionIndex, MaxTimestamp: 1_010 + sectionIndex,","+\t\tRowCount: 1, UncompressedSize: 100,","+\t}","+}","+","+func uploadFilterSourceIndex(t *testing.T, bucket objstore.Bucket, path string, objBuilder *dataobj.Builder) {","+\tt.Helper()","+\tobj, closer, err := objBuilder.Flush()","+\trequire.NoError(t, err)","+\tdefer closer.Close()","+\trequire.NoError(t, uploadObjectToBucket(context.Background(), bucket, path, obj))","+}","+","+// readAllStatsRowsFromBucket reads the rows of every stats section of the","+// object at path.","+func readAllStatsRowsFromBucket(t *testing.T, bucket objstore.Bucket, path string) []stats.Stat {","+\tt.Helper()","+\tctx := context.Background()","+\tvar rows []stats.Stat","+\tfor _, sec := range openObjectFromBucket(ctx, t, bucket, path).Sections() {","+\t\tif !stats.CheckSection(sec) {","+\t\t\tcontinue","+\t\t}","+\t\tstatsSec, err := stats.Open(ctx, sec)","+\t\trequire.NoError(t, err)","+\t\treader := stats.NewRowReader(ctx, statsSec)","+\t\tfor reader.Next() {","+\t\t\trows = append(rows, reader.At())","+\t\t}","+\t\trequire.NoError(t, reader.Err())","+\t\trequire.NoError(t, reader.Close())","+\t}","+\treturn rows","+}","+","+// indexObjectPaths returns the sorted, distinct log object paths that the","+// postings and stats rows of the index at path reference.","+func indexObjectPaths(t *testing.T, bucket objstore.Bucket, path string) (postingsPaths, statsPaths []string) {","+\tt.Helper()","+\tctx := context.Background()","+\tfor _, row := range readAllPostingsRowsFromBucket(ctx, t, bucket, path) {","+\t\tpostingsPaths = append(postingsPaths, row.ObjectPath)","+\t}","+\tfor _, row := range readAllStatsRowsFromBucket(t, bucket, path) {","+\t\tstatsPaths = append(statsPaths, row.ObjectPath)","+\t}","+\tslices.Sort(postingsPaths)","+\tslices.Sort(statsPaths)","+\treturn slices.Compact(postingsPaths), slices.Compact(statsPaths)","+}","+","+// sizeRecordingBucket records the size that each upload reader reports","+// before the upload reads it.","+type sizeRecordingBucket struct {","+\tobjstore.Bucket","+\tsizes   map[string]int64","+\tsizeErr error","+}","+","+func (b *sizeRecordingBucket) Upload(ctx context.Context, name string, r io.Reader) error {","+\tsize, err := objstore.TryToGetSize(r)","+\tif err != nil {","+\t\tb.sizeErr = err","+\t}","+\tb.sizes[name] = size","+\treturn b.Bucket.Upload(ctx, name, r)","+}","+","+func TestDoIndexFilter(t *testing.T) {","+\tctx := context.Background()","+\tconst sourcePath = \"indexes/source\"","+","+\tt.Run(\"keeps only the postings and stats rows of the listed objects\", func(t *testing.T) {","+\t\tbucket := objstore.NewInMemBucket()","+\t\tbuildFilterSourceIndex(t, bucket, sourcePath, 1<<20, map[string][]string{","+\t\t\t\"acme\": {\"l