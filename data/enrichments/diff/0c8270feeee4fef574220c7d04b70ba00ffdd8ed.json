{"id":"0c8270feeee4fef574220c7d04b70ba00ffdd8ed","axis":"silent","repo":"pnpm/pnpm","sha":"0c8270feeee4fef574220c7d04b70ba00ffdd8ed","parsed":{"files":[{"path":".changeset/fix-github-actions-update-and-outdated.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/deps.github-actions\": patch","+\"@pnpm/deps.inspection.commands\": patch","+\"@pnpm/installing.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Fixed GitHub Actions support in `pnpm update` and `pnpm outdated`. Updating a workflow step with a major or minor version comment such as `# v4` or a prose comment now formats the updated version comment cleanly. Negated action selectors such as `!actions/cache/save` now exclude only the targeted subpath actions. Passing only negated action selectors still updates packages. Previously, negated action selectors skipped package updates. `pnpm outdated` now reports every distinct outdated version when several workflows pin the same action at different versions."],"additions":9,"deletions":0,"truncated":false},{"path":".changeset/fix-update-purl-with-github-actions.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Fixed `pnpm update` skipping package updates when a Package URL selector such as `pkg:npm/foo` is combined with `--include-github-actions`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/ecosystem_deps.rs","lines":["@@ -5,8 +5,7 @@ pub(crate) mod selectors;"," pub(crate) mod standalone;"," "," pub(crate) use selectors::{","-    EcosystemFilterKind, excludes_only, is_purl, patterns_for_ecosystem,","-    validate_ecosystem_selectors,","+    EcosystemFilterKind, excludes_only, patterns_for_ecosystem, validate_ecosystem_selectors,"," };"," pub(crate) use standalone::{","     select_recursive_and_standalone_projects, select_standalone_ecosystem_dirs,"],"additions":1,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/ecosystem_deps/selectors.rs","lines":["@@ -82,7 