= collidingWfName","+\twf.Status.Nodes = Nodes{}","+\treturn wf","+}","+","+func (w *Workflow) plant(name string, wide bool) *NodeStatus {","+\tn := NodeStatus{Name: name}","+\tif wide {","+\t\tn.ID = w.NodeID64(name)","+\t} else {","+\t\tn.ID = w.NodeID(name)","+\t}","+\tw.Status.Nodes[n.ID] = n","+\treturn &n","+}","+","+func TestResolveNode(t *testing.T) {","+\tt.Run(\"empty\", func(t *testing.T) {","+\t\twf := newCollidingWorkflow()","+\t\tnode, id := wf.ResolveNode(collidingLeafName)","+\t\tassert.Nil(t, node)","+\t\tassert.Equal(t, wf.NodeID(collidingLeafName), id)","+\t\tassert.Equal(t, wf.NodeID(collidingLeafName), wf.ResolveNodeID(collidingLeafName))","+\t})","+","+\tt.Run(\"base slot hit\", func(t *testing.T) {","+\t\twf := newCollidingWorkflow()","+\t\twant := wf.plant(collidingOuterSG, false)","+\t\tnode, id := wf.ResolveNode(collidingOuterSG)","+\t\trequire.NotNil(t, node)","+\t\tassert.Equal(t, want.ID, node.ID)","+\t\tassert.Equal(t, want.ID, id)","+\t})","+","+\tt.Run(\"base slot held by another name\", func(t *testing.T) {","+\t\twf := newCollidingWorkflow()","+\t\twinner := wf.plant(collidingOuterSG, false)","+","+\t\tnode, id := wf.ResolveNode(collidingLeafName)","+\t\tassert.Nil(t, node, \"the winner's node must not be returned for the loser's name\")","+\t\tassert.Equal(t, wf.NodeID64(collidingLeafName), id, \"the loser must be created with the widened ID\")","+\t\tassert.NotEqual(t, winner.ID, id)","+","+\t\tloser := wf.plant(collidingLeafName, true)","+\t\tnode, id = wf.ResolveNode(collidingLeafName)","+\t\trequire.NotNil(t, node)","+\t\tassert.Equal(t, loser.ID, node.ID)","+\t\tassert.Equal(t, loser.ID, id)","+\t\tassert.Equal(t, loser.ID, wf.ResolveNodeID(collidingLeafName))","+","+\t\t// the winner is still found under its own name","+\t\tnode, _ = wf.ResolveNode(collidingOuterSG)","+\t\trequire.NotNil(t, node)","+\t\tassert.Equal(t, winner.ID, node.ID)","+\t})","+","+\tt.Run(\"widened node found when the base slot is empty\", func(t *testing.T) {","+\t\t// A retry can delete the node holding the 32-bit slot while the","+\t\t// widened node survives; it must still be found.","+\t\twf := newCollidingWorkflow()","+\t\tloser := wf.plant(collidingLeafName, true)","+\t\tnode, id := wf.ResolveNode(collidingLeafName)","+\t\trequire.NotNil(t, node)","+\t\tassert.Equal(t, loser.ID, node.ID)","+\t\tassert.Equal(t, loser.ID, id)","+\t})","+","+\tt.Run(\"both slots held by other names\", func(t *testing.T) {","+\t\t// A 64-bit collision on top of a 32-bit collision is not resolved:","+\t\t// ResolveNode reports no node, and initializeNode refuses to create","+\t\t// one because the returned slot is occupied.","+\t\twf := newCollidingWorkflow()","+\t\tname := \"custom-job-thbh7[0].third\"","+\t\twf.Status.Nodes[wf.NodeID(name)] = NodeStatus{Name: collidingOuterSG}","+\t\twf.Status.Nodes[wf.NodeID64(name)] = NodeStatus{Name: collidingLeafName}","+\t\tnode, id := wf.ResolveNode(name)","+\t\tassert.Nil(t, node)","+\t\tassert.Equal(t, wf.NodeID64(name), id)","+\t\tassert.True(t, wf.Status.Nodes.Has(id), \"creation must be refused\")","+\t})","+}","+","+func TestGetNodeByNameCollision(t *testing.T) {","+\twf := newCollidingWorkflow()","+\twinner := wf.plant(collidingOuterSG, false)","+","+\t_, err := wf.GetNodeByName(collidingLeafName)","+\trequire.Error(t, err, \"must not return the colliding node\")","+","+\tloser := wf.plant(collidingLeafName, true)","+\tnode, err := wf.GetNodeByName(collidingLeafName)","+\trequire.NoError(t, err)","+\tassert.Equal(t, loser.ID, node.ID)","+\tassert.Equal(t, collidingLeafName, node.Name)","+\tnode, err = wf.GetNodeByName(collidingOuterSG)","+\trequire.NoError(t, err)","+\tassert.Equal(t, winner.ID, node.ID)","+}","+","+// BenchmarkResolveNodeMiss measures the not-found path, which every node pays","+// once before it is created: the 32-bit slot plus the 64-bit fallback.","+func BenchmarkResolveNodeMiss(b *testing.B) {","+\twf := newCollidingWorkflow()","+\tfor i := range 10000 {","+\t\twf.plant(\"custom-job-thbh7[0].fanout(\"+strconv.Itoa(i)+\":item)\", false)","+\t}","+\tname := \"custom-job-thbh7[0].fanout(99999:item)\"","+\tb.ResetTimer()","+\tfor i := 0; i < b.N; i++ {","+\t\tif n, _ := wf.ResolveNode(name); n != nil {","+\t\t\tb.Fatal(\"unexpected hit\")","+\t\t}","+\t}","+}"],"additions":144,"deletions":0,"truncated":false},{"path":"pkg/apis/workflow/v1alpha1/workflow_types.go","lines":["@@ -3847,8 +3847,48 @@ func (w *Workflow) GetTemplateByName(name string) *Template {"," }"," "," func (w *Workflow) GetNodeByName(nodeName string) (*NodeStatus, error) {","-\tnodeID := w.NodeID(nodeName)","-\treturn w.Status.Nodes.Get(nodeID)","+\tnode, _ := w.ResolveNode(nodeName)","+\tif node == nil {","+\t\treturn nil, fmt.Errorf(\"key was not found for %s\", nodeName)","+\t}","+\treturn node, nil","+}","+","+// ResolveNode finds the node for a spec-derived node name, tolerating node","+// ID collisions. It returns the existing node and its ID if there is one.","+// Otherwise it returns nil and the ID a node with this name must be created","+// with.","+//","+// Distinct names can hash to the same 32-bit ID. A node whose name loses","+// that race is stored under the widened NodeID64(name) instead, so lookups","+// try the 32-bit slot and fall back to the 64-bit slot, comparing the stored","+// Name. The 64-bit slot is also tried when the 32-bit slot is empty, because","+// a retry can delete the node that held it while the widened node survives.","+// There is no third level: a 64-bit collision between names that also","+// collide at 32 bits is not resolved, and initializeNode refuses to create","+// the node.","+func (w *Workflow) ResolveNode(name string) (*NodeStatus, string) {","+\tid32 := w.NodeID(name)","+\tn32, ok32 := w.Status.Nodes[id32]","+\tif ok32 && n32.Name == name {","+\t\treturn &n32, id32","+\t}","+\tid64 := w.NodeID64(name)","+\tif n64, ok := w.Status.Nodes[id64]; ok && n64.Name == name {","+\t\treturn &n64, id64","+\t}","+\tif ok32 {","+\t\t// the 32-bit slot is held by a different name: widen","+\t\treturn nil, id64","+\t}","+\treturn nil, id32","+}","+","+// ResolveNodeID returns the ID of the node with this spec-derived name, or","+// the ID it will be created with if it does not exist yet.","+func (w *Workflow) ResolveNodeID(name string) string {","+\t_, id := w.ResolveNode(name)","+\treturn id"," }"," "," // GetResourceScope returns the template scope of workflow.","@@ -3876,6 +3916,19 @@ func (w *Workflow) NodeID(name string) string {"," \treturn fmt.Sprintf(\"%s-%v\", w.Name, h.Sum32())"," }"," ","+// NodeID64 creates the widened node ID a node is stored under when its name","+// collides with a different name under NodeID. FNV-1a has no finalisation","+// step, so a 32-bit collision carries over to every common extension of the","+// two names, but their 64-bit hashes are independent of it.","+func (w *Workflow) NodeID64(name string) string {","+\tif name == w.Name {","+\t\treturn w.Name","+\t}","+\th := fnv.New64a()","+\t_, _ = h.Write([]byte(name))","+\treturn fmt.Sprintf(\"%s-%v\", w.Name, h.Sum64())","+}","+"," // GetStoredTemplate retrieves a template from stored templates of the workflow."," func (w *Workflow) GetStoredTemplate(scope ResourceScope, resourceName string, caller TemplateReferenceHolder) *Template {"," \ttmplID, storageNeeded := resolveTemplateReference(scope, resourceName, caller)"],"additions":55,"deletions":2,"truncated":false},{"path":"ui/src/shared/pod-name.test.ts","lines":["@@ -55,10 +55,14 @@ describe('pod names', () => {","         }","     });"," ","+    // a node's ID is <workflow name>-<fnv32a(node name)>; the pod name takes the hash from there,","+    // so the expected values below must match rehashing the node name as the pre-existing implementation did","+    const nodeId = (wfName: string, nodeName: string) => `${wfName}-${createFNVHash(nodeName)}`;","+","     test('getPodName', () => {","         const node = {","             name: 'nodename',","-  