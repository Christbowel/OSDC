{"id":"c0cf7484c14bfa89763ceed4a0ef4d81046f5b07","axis":"silent","repo":"pnpm/pnpm","sha":"c0cf7484c14bfa89763ceed4a0ef4d81046f5b07","parsed":{"files":[{"path":".changeset/mode-codepage-shim.md","lines":["@@ -0,0 +1,8 @@","+---","+'@pnpm/bins.cmd-shim': patch","+'@pnpm/os.env.path-extender-windows': patch","+'pnpm': patch","+'pacquet': patch","+---","+","+`pnpm run` and `pnpm setup` no longer clear the visible terminal on Windows when a project path contains non-ASCII characters. Command shims and `pnpm setup` now switch the console code page with `mode.com con cp select=` instead of `chcp.com`; changing the code page with `chcp.com` clears the screen."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender.rs","lines":["@@ -131,17 +131,17 @@ pub(crate) enum PathExtenderError {","         current_value: String,","     },"," ","-    #[display(\"exec chcp failed: {message}\")]","-    #[diagnostic(code(ERR_PNPM_CHCP))]","-    Chcp {","+    #[display(\"could not read the console code page: {message}\")]","+    #[diagnostic(code(ERR_PNPM_CODE_PAGE))]","+    CodePage {","         message: String,","     },"," ","-    #[display(\"`{command}` failed: {stderr}\")]","+    #[display(\"`{command}` failed: {message}\")]","     #[diagnostic(code(ERR_PNPM_SETUP_COMMAND_FAILED))]","     CommandFailed {","         command: String,","-        stderr: String,","+        message: String,","     },"," ","     #[display(\"win32 registry environment values could not be retrieved\")]"],"additions":5,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/windows.rs","lines":["@@ -3,8 +3,8 @@"," //!"," //! The registry is read with `reg query`, the proxy variable and `Path`"," //! are written with `reg add`, and a dummy `setx` forces the new values to","-//! be picked up by future processes. `chcp 65001` makes `reg` emit UTF-8","-//! so non-ASCII values survive the round-trip.","+//! be picked up by future processes. Switching the console to code page","+//! 65001 makes `reg` emit UTF-8 so non-ASCII values survive the round-trip."," "," use super::{AddDirToEnvPathOpts, AddingPosition, PathExtenderError};"," use crate::process::Command;","@@ -21,17 +21,22 @@ pub(super) struct EnvVariableChange {"," "," const REG_KEY: &str = r\"HKEY_CURRENT_USER\\Environment\";"," ","+const UTF8_CODEPAGE: u32 = 65001;","+"," pub(super) fn add_dir_to_windows_env_path(","     dir: &Path,","     opts: &AddDirToEnvPathOpts,"," ) -> Result<Vec<EnvVariableChange>, PathExtenderError> {","-    // `chcp` makes `reg` use UTF-8 for output. Otherwise non-ASCII","-    // characters in environment variables become garbled.","-    let chcp_output =","-        run_capture_chcp(&[]).map_err(|err| PathExtenderError::Chcp { message: err.to_string() })?;","-    let cp_bak = first_number(&chcp_output)","-        .ok_or_else(|| PathExtenderError::Chcp { message: chcp_output.clone() })?;","-    run_capture_chcp(&[\"65001\"])?;","+    // The UTF-8 code page makes `reg` use UTF-8 for output. Otherwise","+    // non-ASCII characters in environment variables become garbled. The code","+    // page is switched with `mode con cp select=` rather than `chcp`: both","+    // set the same console code page, but `chcp` clears the visible terminal","+    // whenever it changes it.","+    let codepage_output =","+        query_codepage().map_err(|err| PathExtenderError::CodePage { message: err.to_string() })?;","+    let cp_bak = first_number(&codepage_output)","+        .ok_or_else(|| PathExtenderError::CodePage { message: codepage_output.clone() })?;","+    select_codepage(UTF8_CODEPAGE)?;"," ","     let result = (|| {","         let report = add_dir_to_windows_env_path_inner(dir, opts)?;","@@ -40,10 +45,28 @@ pub(super) fn add_dir_to_windows_env_path(","     })();"," ","     // Restore the saved code page even when the body failed.","-    let _ = run_capture_chcp(&[&cp_bak.to_string()]);","+    let _ = select_codepage(cp_bak);","     result"," }"," ","+/// Print the console's code page. The output is a device status report whose","+/// first number is the code page:","+///","+/// ```text","+/// Status for device CON:","+/// ----------------------","+///     Code page:      437","+/// ```","+fn query_codepage() -> Result<String, PathExtenderError> {","+    run_capture_mode(&[\"con\", \"cp\"])","+}","+","+/// Switch the console's code page. The output is a longer status report that","+/// starts with the window size, so it is not parsed for the code page.","+fn select_codepage(codepage: u32) -> Result<(), PathExtenderError> {","+    run_capture_mode(&[\"con\", \"cp\", &format!(\"select={codepage}\")]).map(drop)","+}","+"," fn add_dir_to_windows_env_path_inner(","     dir: &Path,","     opts: &AddDirToEnvPathOpts,","@@ -172,34 +195,38 @@ fn get_registry_output() -> Result<String, PathExtenderError> {"," "," /// Run a command and capture stdout, returning an error if it cannot be"," /// spawned or exits non-zero — rather than silently continuing with empty","-/// output.","+/// output. `mode` reports its errors on stdout, so a failure without stderr","+/// is reported with stdout instead."," fn run_capture(program: &str, args: &[&str]) -> Result<String, PathExtenderError> {","     let output = Command::new(program).args(args).output()?;","     if !output.status.success() {","+        let stderr = String::from_utf8_lossy(&output.stderr);","+        let message =","+            if stderr.trim().is_empty() { String::from_utf8_lossy(&output.stdout) } else { stderr };","         return Err(PathExtenderError::CommandFailed {","             command: program.to_string(),","-            stderr: String::from_utf8_lossy(&output.stderr).into_owned(),","+            message: message.trim().to_string(),","         });","     }","     Ok(String::from_utf8_lossy(&output.stdout).into_owned())"," }"," ","-/// Run `chcp`, attempting `chcp.com` first (the standard executable name on","-/// Windows) with a fallback to `chcp` if `chcp.com` is not found.","-fn run_capture_chcp(args: &[&str]) -> Result<String, PathExtenderError> {","-    run_capture_chcp_with(args, run_capture)","+/// Run `mode`, attempting `mode.com` first (the standard executable name on","+/// Windows) with a fallback to `mode` if `mode.com` is not found.","+fn run_capture_mode(args: &[&str]) -> Result<String, PathExtenderError> {","+    run_capture_mode_with(args, run_capture)"," }"," ","-fn run_capture_chcp_with<Runner>(","+fn run_capture_mode_with<Runner>(","     args: &[&str],","     mut runner: Runner,"," ) -> Result<String, PathExtenderError>"," where","     Runner: FnMut(&str, &[&str]) -> Result<String, PathExtenderError>,"," {","-    match runner(\"chcp.com\", args) {","+    match runner(\"mode.com\", args) {","         Err(PathExtenderError::Io(err)) if err.kind() == std::io::ErrorKind::NotFound => {","-            runner(\"chcp\", args)","+            runner(\"mode\", args)","         }","         res => res,","     }"],"additions":46,"deletions":19,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/windows/tests.rs","lines":["@@ -6,7 +6,7 @@"," use super::{","     AddDirToEnvPathOpts, AddingPosition, EnvVariableChange, PathExtenderError,","     add_dir_to_windows_env_path_inner, first_number, get_env_value_from_registry,","-    run_capture_chcp_with, update_env_variable_with,","+    run_capture_mode_with, update_env_variable_with,"," };"," use pretty_assertions::assert_eq;"," use std::path::Path;","@@ -113,7 +113,10 @@ fn refuses_to_replace_a_different_value_and_names_the_current_one() {"," "," #[test]"," fn first_number_extracts_the_code_page() {","-    assert_eq!(first_number(\"Active code page: 437\"), Some(437));","+    let mode_con_cp =","+        \"\\r\\nStatus for device CON:\\r\\n----------------------\\r\\n    Code page:      437\\r\\n\\r\\n\";","+    assert_eq!(first_number(mode_con_cp), Some(437));","+    assert_eq!(first_number(\"Active code page: 6