"," import FacebookLogoSvg from './facebook-logo.svg?react';"," import GhostLogoSvg from './ghost-logo.svg?react';"," import GhostOrbSvg from './ghost-orb.svg?react';","@@ -7,10 +8,12 @@ import XLogoSvg from './x-logo.svg?react';"," "," // Explicit types keep the `?react` asset imports out of the published"," // declarations, where consumers can't resolve them.","-type Logo = FunctionComponent<SVGProps<SVGSVGElement>>;","+type Logo = FunctionComponent<SvgGraphicProps>;"," ","-export const FacebookLogo: Logo = FacebookLogoSvg;","-export const GhostLogo: Logo = GhostLogoSvg;","-export const GhostOrb: Logo = GhostOrbSvg;","-export const GoogleLogo: Logo = GoogleLogoSvg;","-export const XLogo: Logo = XLogoSvg;","+// Logos are decorative unless the caller names them with `title`,","+// `aria-label` or `aria-labelledby`.","+export const FacebookLogo: Logo = svgGraphic(FacebookLogoSvg, 'FacebookLogo');","+export const GhostLogo: Logo = svgGraphic(GhostLogoSvg, 'GhostLogo');","+export const GhostOrb: Logo = svgGraphic(GhostOrbSvg, 'GhostOrb');","+export const GoogleLogo: Logo = svgGraphic(GoogleLogoSvg, 'GoogleLogo');","+export const XLogo: Logo = svgGraphic(XLogoSvg, 'XLogo');"],"additions":10,"deletions":7,"truncated":false},{"path":"apps/shade/src/assets/images/x-logo.svg","lines":["@@ -1 +1 @@","-<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><g><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\" fill=\"currentColor\"></path></g></svg>","\\ No newline at end of file","+<svg viewBox=\"0 0 24 24\"><g><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\" fill=\"currentColor\"></path></g></svg>","\\ No newline at end of file"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/shade/src/components/ui/icon.stories.tsx","lines":["@@ -10,7 +10,7 @@ const meta = {","     docs: {","       description: {","         component:","-          'Custom SVG icons auto-generated from `src/assets/icons`. Import via `Icon.<Name>` and adjust with `size` and `className`.',","+          \"Custom SVG icons auto-generated from `src/assets/icons`. Import via `Icon.<Name>` and adjust with `size` and `className`. Icons are hidden from screen readers by default. When an icon carries meaning on its own, name it with `title`, `aria-label` or `aria-labelledby`. `title` sets `aria-label`; it doesn't show a tooltip.\",","       },","     },","   },"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/shade/src/components/ui/icon.ts","lines":["@@ -1,5 +1,6 @@"," import React from 'react';"," import { cva, type VariantProps } from 'class-variance-authority';","+import { svgGraphicProps, type SvgGraphicProps } from '@/lib/svg-graphic';"," import { cn, kebabToPascalCase } from '@/lib/utils';"," "," const iconVariants = cva('', {","@@ -16,14 +17,19 @@ const iconVariants = cva('', {","   },"," });"," ","-interface IconProps extends React.SVGProps<SVGSVGElement>, VariantProps<typeof iconVariants> {","+// Icons are decorative unless the caller names them with `title`,","+// `aria-label` or `aria-labelledby`.","+interface IconProps extends SvgGraphicProps, VariantProps<typeof iconVariants> {","   className?: string;"," }"," ","-const iconModules = import.meta.glob<{ default: React.FC<IconProps> }>('../../assets/icons/*.svg', {","-  eager: true,","-  query: '?react',","-});","+const iconModules = import.meta.glob<{ default: React.FC<React.SVGProps<SVGSVGElement>> }>(","+  '../../assets/icons/*.svg',","+  {","+    eager: true,","+    query: '?react',","+  },","+);"," "," const Icon = Object.entries(iconModules).reduce(","   (acc, [path, module]) => {","@@ -34,7 +40,7 @@ const Icon = Object.entries(iconModules).reduce(","       const { size, className, ...rest } = props;","       const iconClassName = cn(iconVariants({ size, className }));","       return React.createElement(module.default, {","-        ...rest,","+        ...svgGraphicProps(rest),","         className: iconClassName,","       });","     };"],"additions":12,"deletions":6,"truncated":false},{"path":"apps/shade/src/docs/component-contracts.mdx","lines":["@@ -33,6 +33,10 @@ See [Lists and tables](?path=/docs/components-lists-and-tables--docs) to choose"," "," Browse the sidebar for the live inventory and APIs. Full rules: [Contributing to Shade](https://github.com/TryGhost/Ghost/blob/main/apps/shade/CONTRIBUTING.md), including [Layers](https://github.com/TryGhost/Ghost/blob/main/apps/shade/CONTRIBUTING.md#layers)."," ","+## Logos and icons","+","+Shade's logos (`FacebookLogo`, `GoogleLogo`, `XLogo`, …) and `Icon.*` graphics are hidden from screen readers by default, so one beside a label doesn't change what the label says. When a logo or icon carries meaning on its own, name it with `title`, `aria-label` or `aria-labelledby`. `title` sets `aria-label`; it doesn't show a tooltip.","+"," ## Example: good vs. bad props"," "," ```tsx"],"additions":4,"deletions":0,"truncated":false},{"path":"apps/shade/src/lib/svg-graphic.ts","lines":["@@ -0,0 +1,41 @@","+import { createElement, type FunctionComponent, type SVGProps } from 'react';","+","+export interface SvgGraphicProps extends SVGProps<SVGSVGElement> {","+  /**","+   * Names the graphic for screen readers. It sets `aria-label`, and doesn't","+   * render a tooltip or an SVG `<title>`. Without a `title`, `aria-label` or","+   * `aria-labelledby`, the graphic is decorative and hidden from them. A","+   * non-blank `aria-label` takes precedence over `title`, and an explicit","+   * `aria-hidden` from the caller always wins.","+   */","+  title?: string | undefined;","+}","+","+const nonBlank = (value: string | undefined) => (value?.trim() ? value : undefined);","+","+/**","+ * Applies Shade's rule for SVG logos and icons: decorative by default, and an","+ * image with a name when the caller gives one. Callers can still override","+ * `aria-hidden` and `role`; a prop passed as `undefined` keeps the default.","+ *","+ * This lives in code rather than SVGR options because Admin and other apps","+ * compile Shade's source with their own SVGR config.","+ */","+export function svgGraphicProps({ title, ...props }: SvgGraphicProps): SVGProps<SVGSVGElement> {","+  const label = nonBlank(props['aria-label']) ?? nonBlank(title);","+","+  if (label || nonBlank(props['aria-labelledby'])) {","+    return { ...props, role: props.role ?? 'img', 'aria-label': label };","+  }","+","+  return { ...props, 'aria-hidden': props['aria-hidden'] ?? true };","+}","+","+export function svgGraphic(","+  Svg: FunctionComponent<SVGProps<SVGSVGElement>>,","+  displayName: string,","+): FunctionComponent<SvgGraphicProps> {","+  const Graphic = (props: SvgGraphicProps) => createElement(Svg, svgGraphicProps(props));","+  Graphic.displayName = displayName;","+  return Graphic;","+}",""],"additions":41,"deletions":0,"truncated":false}],"additions":104,"deletions":32,"truncated":false,"file_count":19},"error":null,"fetched_at":"2026-11-23T19:31:22.470792+00:00"}