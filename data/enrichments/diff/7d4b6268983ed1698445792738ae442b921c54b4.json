 UI, and pending web login","+/// sessions for CLI authentication."," #[derive(Default)]"," pub(super) struct BrowserSessions {","     pub(super) sessions: Mutex<HashMap<String, Session>>,","     pub(super) handoffs: Mutex<HashMap<String, Handoff>>,","+    pub(super) web_logins: Mutex<WebLogins>,"," }"," "," pub(super) struct Session {","@@ -27,7 +29,7 @@ pub struct LoginSession {"," }"," "," /// Where a browser goes after signing in.","-#[derive(Debug, Default, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]","+#[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]"," pub enum LoginReturn {","     /// A page that shows the token, to copy into an `.npmrc`.","     #[default]","@@ -35,6 +37,8 @@ pub enum LoginReturn {","     /// The web UI, which redeems a [handoff code](OidcState::hand_off) for","     /// the token.","     Ui,","+    /// CLI web login session flow (`/-/v1/login`).","+    Cli { session: String },"," }"," "," impl OidcState {"],"additions":8,"deletions":4,"truncated":false},{"path":"pnpr/crates/auth/src/oidc/web_login.rs","lines":["@@ -0,0 +1,136 @@","+use std::{collections::HashMap, time::Duration};","+","+use super::{MAX_ENTRIES, OidcState, Result, Utc, random_secret, rejected, unavailable};","+","+#[cfg(test)]","+mod tests;","+","+/// How long a web login session remains valid for browser authentication and CLI polling.","+pub const WEB_LOGIN_TTL: Duration = Duration::from_mins(5);","+","+pub(super) enum WebLoginState {","+    Pending,","+    Fulfilled { token: String },","+}","+","+pub(super) struct WebLoginEntry {","+    pub(super) state: WebLoginState,","+    pub(super) expires: i64,","+    pub(super) poll_hash: String,","+}","+","+#[derive(Default)]","+pub(super) struct WebLogins {","+    pub(super) entries: HashMap<String, WebLoginEntry>,","+    pub(super) poll_to_browser: HashMap<String, String>,","+}","+","+impl WebLogins {","+    pub(super) fn prune(&mut self, now: i64) {","+        let poll_to_browser = &mut self.poll_to_browser;","+        self.entries.retain(|_, entry| {","+            if entry.expires <= now {","+                poll_to_browser.remove(&entry.poll_hash);","+                false","+            } else {","+                true","+            }","+        });","+    }","+}","+","+/// The two secrets issued for a CLI web login flow.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub struct WebLoginTokens {","+    pub browser_session_id: String,","+    pub poll_token: String,","+}","+","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub enum WebLoginPoll {","+    Pending,","+    Ready(String),","+    NotFound,","+}","+","+impl OidcState {","+    /// Creates a pending web login session for the CLI web login flow.","+    pub fn create_web_login(&self) -> Result<WebLoginTokens> {","+        let browser_session_id = random_secret()?;","+        let poll_token = random_secret()?;","+        let now = Utc::now().timestamp();","+        let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","+        logins.prune(now);","+        if logins.entries.len() >= MAX_ENTRIES {","+            return Err(unavailable());","+        }","+        let expires = now + WEB_LOGIN_TTL.as_secs() as i64;","+        let browser_hash = super::super::sha256_hex(browser_session_id.as_bytes());","+        let poll_hash = super::super::sha256_hex(poll_token.as_bytes());","+        logins.entries.insert(","+            browser_hash.clone(),","+            WebLoginEntry { state: WebLoginState::Pending, expires, poll_hash: poll_hash.clone() },","+        );","+        logins.poll_to_browser.insert(poll_hash, browser_hash);","+        Ok(WebLoginTokens { browser_session_id, poll_token })","+    }","+","+    /// Checks if a web login session exists, is unexpired, and is still pending.","+    pub fn is_valid_web_login(&self, session_id: &str) -> bool {","+        let now = Utc::now().timestamp();","+        let hash = super::super::sha256_hex(session_id.as_bytes());","+        let logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","+        logins.entries","+            .get(&hash)","+            .is_some_and(|entry| {","+                entry.expires > now && matches!(entry.state, WebLoginState::Pending)","+            })","+    }","+","+    /// Fulfills a pending web login session with the issued session token.","+    pub fn fulfill_web_login(&self, session_id: &str, token: String) -> Result<()> {","+        let now = Utc::now().timestamp();","+        let hash = super::super::sha256_hex(session_id.as_bytes());","+        let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","+        if let Some(entry) = logins.entries.get_mut(&hash)","+            && entry.expires > now","+            && matches!(entry.state, WebLoginState::Pending)","+        {","+            entry.state = WebLoginState::Fulfilled { token };","+            return Ok(());","+        }","+        Err(rejected())","+    }","+","+    /// Polls a web login session using the poll token. Consumes the session when ready.","+    pub fn poll_web_login(&self, poll_token: &str) -> WebLoginPoll {","+        let now = Utc::now().timestamp();","+        let poll_hash = super::super::sha256_hex(poll_token.as_bytes());","+        let mut logins = self.browser.web_logins.lock().expect(\"OIDC web login mutex poisoned\");","+        let Some(browser_hash) = logins.poll_to_browser.get(&poll_hash).cloned() else {","+            return WebLoginPoll::NotFound;","+        };","+        let Some(entry) = logins.entries.get(&browser_hash) else {","+            logins.poll_to_browser.remove(&poll_hash);","+            return WebLoginPoll::NotFound;","+        };","+        if entry.expires <= now {","+            logins.entries.remove(&browser_hash);","+            logins.poll_to_browser.remove(&poll_hash);","+            return WebLoginPoll::NotFound;","+        }","+        if matches!(entry.state, WebLoginState::Pending) {","+            return WebLoginPoll::Pending;","+        }","+        let Some(entry) = logins.entries.remove(&browser_hash) else {","+            logins.poll_to_browser.remove(&poll_hash);","+            return WebLoginPoll::NotFound;","+        };","+        logins.poll_to_browser.remove(&poll_hash);","+        if let WebLoginState::Fulfilled { token } = entry.state {","+            WebLoginPoll::Ready(token)","+        } else {","+            WebLoginPoll::NotFound","+        }","+    }","+}"],"additions":136,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/oidc/web_login/tests.rs","lines":["@@ -0,0 +1,97 @@","+use super::{OidcState, WEB_LOGIN_TTL, WebLoginPoll, WebLoginState};","+use chrono::Utc;","+","+#[tokio::test]","+async fn create_and_poll_pending_web_login() {","+    let state = OidcState::new(&[], \"https://registry.example\").unwrap();","+    let tokens = state.create_web_login().expect(\"session created\");","+    assert!(!tokens.browser_session_id.is_empty());","+    assert!(!tokens.poll_token.is_empty());","+    assert_ne!(tokens.browser_session_id, tokens.poll_token);","+","+    assert!(state.is_valid_web_login(&tokens.browser_session_id));","+    assert!(!state.is_valid_web_login(&tokens.poll_token));","+    assert!(!state.is_valid_web_login(\"unknown_session\"));","+","+    assert_eq!(state.poll_web_login(&tokens.poll_token), WebLoginPoll::Pending);","+    // Polling with browser session id must not work","+    assert_eq!(state.poll_web_login(&tokens.browser_session_id), WebLoginPoll::NotFound);","+    assert_eq!(state.poll_web_login(\"unknown_session\"), WebLoginPoll::NotFound);","+}","+","+#[tokio::test]","+async fn fulfill_and_poll_ready_consumes_session() {","+    let state = OidcState::new(&[], \"https://registry.example\").unwrap();","+    let tokens = state.create_web_login().expect(\"session created\");","+","+    state","+        .fulfill_web_login(&tokens.browser_session_id, \"pnpr_oidc_secret_token\".to_string())","+        .expect(\"fulfilled\");","+","+    // Once fulfilled, it is no longer pending validation","+    assert!(!state.is_valid_web_login(&tokens.browser_session_id));","+","+    // First poll consumes the session and returns Ready","+    assert_eq!(","+        state.poll_web_login(&tokens.poll_token),","+        WebLoginPoll::Ready(\"pnpr_oidc_secret_token\".to_string()),","+    );","+","+    // Second poll returns NotFound because it was consumed","+    assert_eq!(state.poll_web_login(&tokens.poll_token), WebLoginPoll::NotFound);","+}","+","+#[tokio::test]","+async fn fulfill_fails_on_unknown_or_already_fulfilled_session() {","+    let state = OidcState::new(&[], \"https://registry.example\").unwrap();","+    assert!(state.fulfill_web_login(\"unknown\", \"token\".to_string()).is_err());","+","+    let tokens = state.create_web_login().expect(\"session created\");","+    assert!(state.fulfill_web_login(&tokens.browser_session_id, \"token1\".to_string()).is_ok());","+    // Second fulfillment attempt fails","+    assert!(state.fulfill_web_login(&tokens.browser_session_id, \"token2\".to_string()).is_err());","+}","+","+#[tokio::test]","+async fn expired_session_fails_validation_and_polling() {","+    let state = OidcState::new(&[], \"https://registry.example\").unwrap();","+    let tokens = state.create_web_login().expect(\"session created\");","+","+    // Manually expire the session entry","+    let hash = crate::sha256_hex(tokens.browser_session_id.as_bytes());","+    {","+        let mut logins = state.browser.web_logins.lock().unwrap();","+        if let Some(entry) = logins.entries.get_mut(&hash) {","+            entry.expires = Utc::now().timestamp() - 1;","+        }","+    }","+","+    assert!(!state.is_valid_web_login(&tokens.browser_session_id));","+    assert!(state.fulfill_web_login(&tokens.browser_session_id, \"token\".to_string()).is_err());","+    assert_eq!(state.poll_web_login(&tokens.poll_token), WebLoginPoll::NotFound);","+}","+","+#[tokio::test]","+async fn max_entries_enforced() {","+    let state = OidcState::new(&[], \"https://registry.example\").unwrap();","+    let now = Utc::now().timestamp();","+    {","+        let mut logins = state.browser.web_logins.lock().unwrap();","+        for index in 0..1024 {","+            let browser_hash = format!(\"browser_hash_{index}\");","+            let poll_hash = format!(\"poll_hash_{index}\");","+            logins.entries.insert(","+                browser_hash.clone(),","+                super::WebLoginEntry {","+                    state: WebLoginState::Pending,","+                    expires: now + WEB_LOGIN_TTL.as_secs() as i64,","+                    poll_hash: poll_hash.clone(),","+                },","+            );","+            logins.poll_to_browser.insert(poll_hash, browser_hash);","+        }","+    }","+","+    // Creating another session when full returns unavailable","+    assert!(state.create_web_login().is_err());","+}"],"additions":97,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -123,6 +123,7 @@ mod team_access;"," mod team_mutations;"," mod team_rosters;"," mod user_admin;","+mod web_login;"," mod web_ui;"," "," #[cfg(test)]","@@ -284,20 +285,25 @@ pub fn try_router_with_auth(mut config: Config, auth: AuthState) -> pnpr_error::"," /// (`DELETE .../-/user/token/{token}`, path-less or under a `/~<prefix>/`)"," /// puts the raw bearer token in the URL path, and a reusable credential"," /// must never reach a log line, so everything after that marker is","-/// redacted. OIDC callback queries are also omitted. Other URIs are logged verbatim; a false positive (a","-/// registry path that merely embeds the marker) is redacted too, which","-/// only costs log detail on a request no route serves.","+/// redacted. Web login polling (`/-/v1/login/poll/{token}`) is also","+/// redacted, and OIDC callback and web login start queries are omitted.","+/// Other URIs are logged verbatim; a false positive (a registry path that","+/// merely embeds the marker) is redacted too, which only costs log detail","+/// on a request no route serves."," fn loggable_uri(uri: &axum::http::Uri) -> String {","-    if uri.path().starts_with(\"/-/oidc/\") {","-        return uri.path().to_string();","+    let path = uri.path();","+    if path.starts_with(\"/-/oidc/\") || path.ends_with(\"/-/v1/login/start\") {","+        return path.to_string();","     }","     const TOKEN_MARKER: &str = \"/-/user/token/\";","-    match uri.path().find(TOKEN_MARKER) {","-        Some(index) => {","-            format!(\"{}<redacted>\", &uri.path()[..index + TOKEN_MARKER.len()])","-        }","-        None => uri.to_string(),","+    const POLL_MARKER: &str = \"/-/v1/login/poll/\";","+    if let Some(index) = path.find(TOKEN_MARKER) {","+        return format!(\"{}<redacted>\", &path[..index + TOKEN_MARKER.len()]);","+    }","+    if let Some(index) = path.find(POLL_MARKER) {","+        return format!(\"{}<redacted>\", &path[..index + POLL_MARKER.len()]);","     }","+    uri.to_string()"," }"," "," // --------------------------------------------------------------------"],"additions":16,"deletions":10,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/oidc.rs","lines":["@@ -40,6 +40,7 @@ pub(super) fn routes(ui_served: bool) -> Router<AppState> {"," pub(super) struct LoginQuery {","     #[serde(rename = \"return\")]","     returns_to: Option<String>,","+    session: Option<String>,"," }"," "," async fn login(","@@ -52,6 +53,15 @@ async fn login(","         None => LoginReturn::Token,","         Some(\"ui\") if ui_served => LoginReturn::Ui,","         Some(\"ui\") => return bad_request(\"this pnpr does not serve the web UI\"),","+        Some(\"cli\") => {","+            let Some(session) = query.session.as_deref() else {","+                return bad_request(\"session query parameter required for return=cli\");","+            };","+            if !is_valid_state(session) || !state.inner.identity.oidc.is_valid_web_login(session) {","+                return bad_request(\"invalid or expired web login session\");","+            }","+            LoginReturn::Cli { session: session.to_string() }","+        }","         Some(_) => return bad_request(\"return must be ui\"),","     };","     let response = match state.inner.identity.oidc.start(&provider, returns_to).await {","@@ -118,6 +128,23 @@ fn signed_in(oidc: &OidcState, flow: &str, session: LoginSession) -> Response {","             Err(err) => err.into_response(),","         };","     }","+    if let LoginReturn::Cli { session: ref session_id } = session.returns_to {","+        return match oidc.fulfill_web_login(session_id, session.token) {","+            Ok(()) => {","+                let html = r#\"<!doctype html>","+<html>","+<head><title>Signed In - pnpr</title><meta charset=\"utf-8\"></head>","+<body>","+  <h1>Authentication successful</h1>","+  <p>You may now close this browser window and return to your terminal.</p>","+</body>","+</html>\"#;","+                (StatusCode::OK, [(header::CONTENT_TYPE, \"text/html; charset=utf-8\")], html)","+                    .into_response()","+            }","+            Err(err) => err.into_response(),","+        };","+    }","     let token = session.token;","     let expires = session.expires;","     let message = format!(","@@ -160,7 +187,7 @@ fn redeem(oidc: &OidcState, flow: &str, headers: &HeaderMap) -> Response {"," }"," "," /// An OIDC state as pnpr issues it, safe to put in a cookie name.","-fn is_valid_state(state: &str) -> bool {","+pub(super) fn is_valid_state(state: &str) -> bool {","     !state.is_empty()","         && state.len() <= 128","         && state","@@ -214,7 +241,7 @@ fn bad_request(reason: &str) -> Response {","     protect(RegistryError::BadRequest { reason: reason.to_string() }.into_response())"," }"," ","-fn protect(response: Response) -> Response {","+pub(super) fn protect(response: Response) -> Response {","     let mut response = private_no_cache(response);","     response","         .headers_mut()"],"additions":29,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/rate_limit.rs","lines":["@@ -13,8 +13,14 @@ enum RateLimitKey {","     Ip(IpAddr),","     IpUser(IpAddr, String),","     User(String),","+    WebLogin(Option<IpAddr>),"," }"," ","+const MAX_WEB_LOGIN_RECORDS: usize = 1024;","+const EVICTION_MAP_THRESHOLD: usize = 1024;","+const EVICTION_INTERVAL: Duration = Duration::from_secs(30);","+const FULL_EVICTION_COOLDOWN: Duration = Duration::from_secs(1);","+"," struct AttemptRecord {","     count: u32,","     first_attempt: Instant,","@@ -22,6 +28,7 @@ struct AttemptRecord {"," "," struct RateLimiterInner {","     map: HashMap<RateLimitKey, AttemptRecord>,","+    web_login_count: usize,","     last_eviction: Instant,"," }"," ","@@ -55,11 +62,29 @@ impl LoginRateLimiter {","             max_user_attempts,","             records: Mutex::new(RateLimiterInner {","                 map: HashMap::new(),","+                web_login_count: 0,","                 last_eviction: Instant::now(),","             }),","         }","     }"," ","+    fn evict_if_needed(&self, inner: &mut RateLimiterInner, now: Instant, force: bool) {","+        let should_evict = now.duration_since(inner.last_eviction) >= EVICTION_INTERVAL","+            || ((force || inner.map.len() > EVICTION_MAP_THRESHOLD)","+                && now.duration_since(inner.last_eviction) >= FULL_EVICTION_COOLDOWN);","+        if should_evict {","+            let web_login_count = &mut inner.web_login_count;","+            inner.map.retain(|key, record| {","+                let active = now.duration_since(record.first_attempt) < self.window;","+                if !active && matches!(key, RateLimitKey::WebLogin(_)) {","+                    *web_login_count = web_login_count.saturating_sub(1);","+                }","+                active","+            });","+            inner.last_eviction = now;","+        }","+    }","+","     fn check_key(","         &self,","         map: &HashMap<RateLimitKey, AttemptRecord>,","@@ -87,14 +112,7 @@ impl LoginRateLimiter {","     pub(crate) fn check(&self, client_ip: Option<IpAddr>, username: &str) -> Result<(), u64> {","         let now = Instant::now();","         let mut inner = self.records.lock().unwrap();","-","-        // Evict expired entries periodically or when map exceeds size threshold","-        if now.duration_since(inner.last_eviction) >= Duration::from_secs(30)","-            || inner.map.len() > 1024","-        {","-            inner.map.retain(|_, record| now.duration_since(record.first_attempt) < self.window);","-            inner.last_eviction = now;","-        }","+        self.evict_if_needed(&mut inner, now, false);"," ","         if let Some(ip_address) = client_ip {","             self.check_key(","@@ -116,10 +134,91 @@ impl LoginRateLimiter {","         Ok(())","     }"," ","+    fn update_existing_web_login(","+        &self,","+        record: &mut AttemptRecord,","+        now: Instant,","+    ) -> Result<(), u64> {","+        if now.duration_since(record.first_attempt) >= self.window {","+            record.count = 1;","+            record.first_attempt = now;","+            return Ok(());","+        }","+        if record.count >= self.max_ip_attempts {","+            let elapsed = now.duration_since(record.first_attempt);","+            let retry_after = self.window","+                .saturating_sub(elapsed)","+                .as_secs()","+                .max(1);","+            return Err(retry_after);","+        }","+        record.count += 1;","+        Ok(())","+    }","+","+    fn ensure_web_login_capacity(","+        &self,","+        inner: &mut RateLimiterInner,","+        now: Instant,","+    ) -> Result<(), u64> {","+        if inner.web_login_count < MAX_WEB_LOGIN_RECORDS {","+            return Ok(());","+        }","+        self.evict_if_needed(inner, now, true);","+        if inner.web_login_count < MAX_