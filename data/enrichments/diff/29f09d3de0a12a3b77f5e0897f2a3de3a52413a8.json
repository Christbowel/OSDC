Proto));","-    event_stats.AddStatValue(*hlo_proto_stat, hlo_proto);","-  }","-","-  return CreateXSpace(space, first_device_latency, second_device_latency);","+  ABSL_ASSIGN_OR_RETURN(","+      std::string fingerprint,","+      AddModuleWithFingerprint(metadata_plane, kHloText, /*program_id=*/1));","+  CreateXSpace(space, first_device_latency, second_device_latency);","+  return fingerprint;"," }"," "," TEST(XplaneToProfiledInstructionsProtoTest,","@@ -223,13 +247,15 @@ TEST(XplaneToProfiledInstructionsProtoTest,","   const std::string path = tsl::profiler::ProfilerJoinPath(logdir, run);"," ","   XSpace xspace_first_host;","-  CreateXSpaceWithFingerprint(&xspace_first_host, 10000, 10000);","+  ASSERT_OK_AND_ASSIGN(","+      std::string fingerprint,","+      CreateXSpaceWithFingerprint(&xspace_first_host, 10000, 10000));","   auto status =","       tsl::profiler::SaveXSpace(logdir, run, \"host_0\", xspace_first_host);","   EXPECT_TRUE(status.ok());"," ","   XSpace xspace_2nd_host;","-  CreateXSpaceWithFingerprint(&xspace_2nd_host, 15000, 5000);","+  ASSERT_OK(CreateXSpaceWithFingerprint(&xspace_2nd_host, 15000, 5000));","   status = tsl::profiler::SaveXSpace(logdir, run, \"host_1\", xspace_2nd_host);","   EXPECT_TRUE(status.ok());"," ","@@ -238,7 +264,8 @@ TEST(XplaneToProfiledInstructionsProtoTest,","           .ok());","   EXPECT_EQ(profile_proto.costs_size(), 1);","   EXPECT_EQ(profile_proto.costs(0).cost_us(), 10);","-  EXPECT_EQ(profile_proto.costs(0).name(), \"08a5::custom-call\");","+  EXPECT_EQ(profile_proto.costs(0).name(),","+            FingerprintedCostName(fingerprint, \"custom-call\"));"," }"," "," TEST(XplaneToProfiledInstructionsProtoTest,","@@ -264,17 +291,111 @@ TEST(XplaneToProfiledInstructionsProtoTest,","   tensorflow::profiler::ProfiledInstructionsProto profile_proto;"," ","   XSpace xspace_a;","-  CreateXSpaceWithFingerprint(&xspace_a, 10000, 10000);","+  ASSERT_OK_AND_ASSIGN(std::string fingerprint,","+                       CreateXSpaceWithFingerprint(&xspace_a, 10000, 10000));"," ","   XSpace xspace_b;","-  CreateXSpaceWithFingerprint(&xspace_b, 15000, 5000);","+  ASSERT_OK(CreateXSpaceWithFingerprint(&xspace_b, 15000, 5000));"," ","   EXPECT_TRUE(ConvertXplaneToProfiledInstructionsProto({xspace_a, xspace_b},","                                                        &profile_proto)","                   .ok());","   EXPECT_EQ(profile_proto.costs_size(), 1);","   EXPECT_EQ(profile_proto.costs(0).cost_us(), 10);","-  EXPECT_EQ(profile_proto.costs(0).name(), \"08a5::custom-call\");","+  EXPECT_EQ(profile_proto.costs(0).name(),","+            FingerprintedCostName(fingerprint, \"custom-call\"));","+}","+","+TEST(XplaneToProfiledInstructionsProtoTest,","+     RequireFingerprintsFailsForModuleWithoutFingerprint) {","+  tensorflow::profiler::ProfiledInstructionsProto profile_proto;","+  XSpace xspace;","+  CreateXSpace(&xspace, 10000, 10000);","+  EXPECT_THAT(ConvertXplaneToProfiledInstructionsProto(","+                  {xspace}, &profile_proto, /*require_fingerprints=*/true),","+              StatusIs(absl::StatusCode::kFailedPrecondition,","+                       HasSubstr(\"test_module(1)\")));","+}","+","+TEST(XplaneToProfiledInstructionsProtoTest,","+     RequireFingerprintsSucceedsForModuleWithFingerprint) {","+  tensorflow::profiler::ProfiledInstructionsProto profile_proto;","+  XSpace xspace;","+  ASSERT_OK_AND_ASSIGN(std::string fingerprint,","+                       CreateXSpaceWithFingerprint(&xspace, 10000, 10000));","+  EXPECT_THAT(ConvertXplaneToProfiledInstructionsProto(","+                  {xspace}, &profile_proto, /*require_fingerprints=*/true),","+              IsOk());","+  EXPECT_EQ(profile_proto.costs_size(), 1);","+  EXPECT_EQ(profile_proto.costs(0).name(),","+            FingerprintedCostName(fingerprint, \"custom-call\"));","+}","+","+TEST(XplaneToProfiledInstructionsProtoTest,","+     ConvertXplaneToProfiledInstructionsProtoKeepsModulesApart) {","+  // Two modules with the same name and instruction names, as when a function","+  // is compiled for two input shapes, whose instructions take different times.","+  XSpace xspace;","+  XPlaneBuilder metadata_plane(xspace.add_planes());","+  metadata_plane.SetName(kMetadataPlaneName);","+  ASSERT_OK_AND_ASSIGN(std::string fingerprint_a,","+                       AddModuleWithFingerprint(metadata_plane, R\"(","+  HloModule test_module","+  ENTRY e {","+    p0 = f32[32,32] parameter(0)","+    ROOT dot0 = f32[32,32]{1,0} custom-call(p0, p0), custom_call_target=\"__cublas$gemm\"","+  })\",","+                                                /*program_id=*/1));","+  ASSERT_OK_AND_ASSIGN(std::string fingerprint_b,","+                       AddModuleWithFingerprint(metadata_plane, R\"(","+  HloModule test_module","+  ENTRY e {","+    p0 = f32[64,64] parameter(0)","+    ROOT dot0 = f32[64,64]{1,0} custom-call(p0, p0), custom_call_target=\"__cublas$gemm\"","+  })\",","+                                                /*program_id=*/2));","+  ASSERT_NE(fingerprint_a, fingerprint_b);","+","+  XPlaneBuilder device_plane(xspace.add_planes());","+  device_plane.SetName(GpuPlaneName(0));","+  device_plane.SetId(0);","+  XLineBuilder stream = device_plane.GetOrCreateLine(30);","+  stream.SetName(\"gpu stream 1\");","+  int64_t timestamp_ns = 100000;","+  for (auto [program_id, latency_ns] :","+       {std::pair<int64_t, int64_t>{1, 10000},","+        std::pair<int64_t, int64_t>{2, 30000}}) {","+    XEventBuilder event =","+        stream.AddEvent(*device_plane.GetOrCreateEventMetadata(\"kernel1\"));","+    event.SetTimestampNs(timestamp_ns);","+    event.SetDurationNs(latency_ns);","+    timestamp_ns += latency_ns;","+    event.AddStatValue(","+        *device_plane.GetOrCreateStatMetadata(GetStatTypeStr(StatType::kHloOp)),","+        *device_plane.GetOrCreateStatMetadata(\"custom-call\"));","+    event.AddStatValue(*device_plane.GetOrCreateStatMetadata(","+                           GetStatTypeStr(StatType::kHloModule)),","+                       *device_plane.GetOrCreateStatMetadata(\"test_module\"));","+    event.AddStatValue(*device_plane.GetOrCreateStatMetadata(","+                           GetStatTypeStr(StatType::kProgramId)),","+                       program_id);","+    event.AddStatValue(*device_plane.GetOrCreateStatMetadata(","+                           GetStatTypeStr(StatType::kScopeRangeId)),","+                       GetUniqueId());","+  }","+","+  tensorflow::profiler::ProfiledInstructionsProto profile_proto;","+  ASSERT_TRUE(","+      ConvertXplaneToProfiledInstructionsProto({xspace}, &profile_proto).ok());","+  auto cost = [](absl::string_view name, double cost_us) {","+    return AllOf(Property(&InstructionCost::name, name),","+                 Property(&InstructionCost::cost_us, cost_us));","+  };","+  EXPECT_THAT(","+      profile_proto.costs(),","+      UnorderedElementsAre(","+          cost(FingerprintedCostName(fingerprint_a, \"custom-call\"), 10),","+          cost(FingerprintedCostName(fingerprint_b, \"custom-call\"), 30)));"," }"," "," TEST(XplaneToProfiledInstructionsProtoTest, UsesSchedulingNames) {"],"additions":157,"deletions":36,"truncated":false},{"path":"third_party/xla/xla/service/BUILD","lines":["@@ -2018,6 +2018,33 @@ cc_library(","     ],"," )"," ","+cc_library(","+    name = \"hlo_profiling_utils\",","+    srcs = [\"hlo_profiling_utils.cc\"],","+    hdrs = [\"hlo_profiling_utils.h\"],","+    deps = [","+        \":hlo_proto_cc\",","+        \"//xla:xla_data_proto_cc\",","+        \"//xla/hlo/ir:hlo\",","+        \"@com_google_absl//absl/log\",","+        \"@com_google_absl//absl/strings\",","+        \"@com_google_absl//absl/strings:string_view\",","+    ],","+)"],"additions":13,"deletions":0,"truncated":false}],"additions":295,"deletions":164,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-29T15:19:33.916562+00:00"}