|| fs::rename(&temp, &path).is_err() {","         let _ = fs::remove_file(&temp);"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/fs/src/lib.rs","lines":["@@ -37,6 +37,7 @@ pub use secure_temp_lock::{","     open_secure_lock_file, secure_temp_lock_dir, secure_user_lock_dir, secure_user_lock_file_path,"," };"," pub use symlink_dir::*;","+pub use sync_file::sync_file;"," #[cfg(target_os = \"wasi\")]"," pub use wasi_fs::{","     check_file_owner, create_inheriting_mode as create_file_inheriting_mode,","@@ -68,6 +69,7 @@ mod rename_to_free_name;"," mod retry;"," mod secure_temp_lock;"," mod symlink_dir;","+mod sync_file;"," #[cfg(target_os = \"wasi\")]"," mod wasi_fs;"," mod write_atomic;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/sync_file.rs","lines":["@@ -0,0 +1,47 @@","+use std::{fs::File, io};","+","+/// Flushes `file`'s data and metadata to the storage device, as","+/// [`File::sync_all`] does.","+///","+/// On Apple platforms `sync_all` is `fcntl(F_FULLFSYNC)`, which some file","+/// systems reject, such as virtiofs and SMB shares. There this falls back to","+/// `fsync`, as `SQLite` and Node.js do.","+pub fn sync_file(file: &File) -> io::Result<()> {","+    #[cfg(target_vendor = \"apple\")]","+    return sync_with_fallback(|| file.sync_all(), || fsync(file));","+    #[cfg(not(target_vendor = \"apple\"))]","+    file.sync_all()","+}","+","+/// Runs `full_sync`, and `fsync` only if the file system does not support it.","+#[cfg(target_vendor = \"apple\")]","+fn sync_with_fallback(","+    full_sync: impl FnOnce() -> io::Result<()>,","+    fsync: impl FnOnce() -> io::Result<()>,","+) -> io::Result<()> {","+    match full_sync() {","+        Err(error)","+            if matches!(","+                error.raw_os_error(),","+                Some(libc::ENOTTY | libc::ENOTSUP | libc::EOPNOTSUPP | libc::EINVAL),","+            ) =>","+        {","+            fsync()","+        }","+        result => result,","+    }","+}","+","+#[cfg(target_vendor = \"apple\")]","+fn fsync(file: &File) -> io::Result<()> {","+    use std::os::fd::AsRawFd as _;","+    // SAFETY: `file` keeps the descriptor open for the whole call.","+    if unsafe { libc::fsync(file.as_raw_fd()) } == 0 {","+        Ok(())","+    } else {","+        Err(io::Error::last_os_error())","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":47,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/sync_file/tests.rs","lines":["@@ -0,0 +1,49 @@","+use super::sync_file;","+use std::io::Write as _;","+","+#[test]","+fn syncs_a_regular_file() {","+    let mut file = tempfile::tempfile().unwrap();","+    file.write_all(b\"content\").unwrap();","+    sync_file(&file).unwrap();","+}","+","+#[cfg(target_vendor = \"apple\")]","+#[test]","+fn falls_back_to_fsync_when_full_sync_is_unsupported() {","+    use super::sync_with_fallback;","+    use std::{cell::Cell, io::Error};","+    for errno in [libc::ENOTTY, libc::ENOTSUP, libc::EOPNOTSUPP, libc::EINVAL] {","+        let fell_back = Cell::new(false);","+        sync_with_fallback(","+            || Err(Error::from_raw_os_error(errno)),","+            || {","+                fell_back.set(true);","+                Ok(())","+            },","+        )","+        .unwrap();","+        assert!(fell_back.get(), \"errno {errno}\");","+        let fsync_error = sync_with_fallback(","+            || Err(Error::from_raw_os_error(errno)),","+            || Err(Error::from_raw_os_error(libc::EIO)),","+        )","+        .unwrap_err();","+        assert_eq!(fsync_error.raw_os_error(), Some(libc::EIO), \"errno {errno}\");","+    }","+}","+","+#[cfg(target_vendor = \"apple\")]","+#[test]","+fn keeps_other_full_sync_errors() {","+    use super::sync_with_fallback;","+    use std::io::Error;","+    for errno in [libc::EIO, libc::ENOSPC, libc::EBADF] {","+        let error = sync_with_fallback(","+            || Err(Error::from_raw_os_error(errno)),","+            || panic!(\"fell back to fsync on errno {errno}\"),","+        )","+        .unwrap_err();","+        assert_eq!(error.raw_os_error(), Some(errno));","+    }","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/write_atomic.rs","lines":["@@ -75,7 +75,7 @@ fn write_tmp_over(path: &Path, bytes: &[u8], inherit: InheritMode) -> io::Result","             create_private_file(path)","         })?;","     tmp.write_all(bytes)?;","-    tmp.as_file().sync_all()?;","+    crate::sync_file(tmp.as_file())?;","     inherit_permissions(path, tmp.as_file(), inherit)?;","     let mut pending = Some(tmp.into_temp_path());","     crate::retry::retry_transient_file_locks(|| {"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/install-coordinator/src/metadata_file.rs","lines":["@@ -194,7 +194,7 @@ fn write_file(","     let result = (|| {","         file.write_all(contents)?;","         file.set_permissions(fs::Permissions::from_mode(mode))?;","-        file.sync_all()?;","+        pnpm_fs::sync_file(&file)?;","         rename_at(parent, &temporary, &destination)","     })();","     drop(file);"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/lockfile/src/save_lockfile.rs","lines":["@@ -232,7 +232,7 @@ impl Lockfile {"," /// default."," fn fill_temp_file(file: &mut fs::File, content: &[u8], target: &Path) -> io::Result<()> {","     file.write_all(content)?;","-    file.sync_all()?;","+    pnpm_fs::sync_file(file)?;","     carry_mode_across(file, target)"," }"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/pack/src/capabilities.rs","lines":["@@ -148,7 +148,7 @@ impl FsAtomicWrite for Host {","             };","             pnpm_fs::set_file_permissions(tmp.as_file(), &mode)?;","         }","-        tmp.as_file().sync_all()?;","+        pnpm_fs::sync_file(tmp.as_file())?;","         tmp.persist(dest).map_err(|error| error.error)?;","         Ok(())","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manifest/src/serialization.rs","lines":["@@ -211,7 +211,7 @@ impl PackageManifest {","         if let Some(permissions) = permissions {","             pnpm_fs::set_file_permissions(tmp.as_file(), &permissions)?;","         }","-        tmp.as_file().sync_all()?;","+        pnpm_fs::sync_file(tmp.as_file())?;","         tmp.persist(path).map_err(|err| err.error)?;","         Ok(())","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/workspace-manifest-writer/src/lib.rs","lines":["@@ -475,7 +475,7 @@ fn write_atomic(path: &Path, contents: &str) -> io::Result<()> {","         .unwrap_or_else(|| Path::new(\".\"));","     let mut tmp = pnpm_fs::private_named_tempfile_in(dir)?;","     tmp.write_all(contents.as_bytes())?;","-    tmp.as_file().sync_all()?;","+    pnpm_fs::sync_file(tmp.as_file())?;","     tmp.persist(path).map_err(|err| err.error)?;","     Ok(())"," }",""],"additions":1,"deletions":1,"truncated":false}],"additions":121,"deletions":18,"truncated":false,"file_count":20},"error":null,"fetched_at":"2026-10-12T18:18:29.177352+00:00"}