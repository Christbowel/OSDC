sync_file(tmp.as_file()).into_diagnostic().wrap_err(\"syncing temp file\")?;","     tmp.persist(path)","         .into_diagnostic()","         .wrap_err(\"renaming temp file into place\")?;"],"additions":1,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/target/atomic_write.rs","lines":["@@ -12,7 +12,7 @@ pub(super) fn write_atomic(path: &Path, contents: &[u8]) -> io::Result<()> {","         .unwrap_or_else(|| Path::new(\".\"));","     let mut tmp = pnpm_fs::private_named_tempfile_in(dir)?;","     tmp.write_all(contents)?;","-    tmp.as_file().sync_all()?;","+    pnpm_fs::sync_file(tmp.as_file())?;","     #[cfg(not(target_os = \"wasi\"))]","     if let Ok(metadata) = fs::metadata(path) {","         tmp.as_file().set_permissions(metadata.permissions())?;"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_commit/paths.rs","lines":["@@ -104,7 +104,7 @@ pub(super) fn write_patch_file_atomically(target: &Path, content: &[u8]) -> io::","     let parent = target.parent().unwrap_or_else(|| Path::new(\".\"));","     let mut tmp = pnpm_fs::private_named_tempfile_in(parent)?;","     tmp.write_all(content)?;","-    tmp.as_file().sync_all()?;","+    pnpm_fs::sync_file(tmp.as_file())?;","     tmp.persist(target).map_err(|error| error.error)?;","     Ok(())"," }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_state.rs","lines":["@@ -194,7 +194,7 @@ fn write_state_file_atomically(target: &Path, content: &[u8]) -> io::Result<()>","     let parent = target.parent().unwrap_or_else(|| Path::new(\".\"));","     let mut tmp = pnpm_fs::private_named_tempfile_in(parent)?;","     tmp.write_all(content)?;","-    tmp.as_file().sync_all()?;","+    pnpm_fs::sync_file(tmp.as_file())?;","     tmp.persist(target).map_err(|error| error.error)?;","     Ok(())"," }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/executable_link.rs","lines":["@@ -37,7 +37,7 