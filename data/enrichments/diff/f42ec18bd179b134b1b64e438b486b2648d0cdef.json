\trepository_url = config.options.default_autoinstall_repository;","+\t}","+\treturn ExtensionRepository::GetRepositoryByUrl(repository_url);"," }"," "," bool ExtensionHelper::TryAutoLoadExtension(DatabaseInstance &instance, const string &extension_name) noexcept {"," \tif (instance.ExtensionIsLoaded(extension_name)) {"," \t\treturn true;"," \t}","-\tauto &dbconfig = DBConfig::GetConfig(instance);"," \ttry {"," \t\tauto &fs = FileSystem::GetFileSystem(instance);"," \t\tif (Settings::Get<AutoinstallKnownExtensionsSetting>(instance)) {","-\t\t\tauto repository_url = GetAutoInstallExtensionsRepository(dbconfig);","-\t\t\tauto autoinstall_repo = ExtensionRepository::GetRepositoryByUrl(repository_url);","+\t\t\tauto autoinstall_repo = GetAutoinstallRepository(instance);"," \t\t\tExtensionInstallOptions options;"," \t\t\toptions.repository = autoinstall_repo;"," \t\t\tExtensionHelper::InstallExtension(instance, fs, extension_name, options);","@@ -379,13 +380,11 @@ void ExtensionHelper::AutoLoadExtension(DatabaseInstance &db, const string &exte"," \t\t// Avoid downloading again"," \t\treturn;"," \t}","-\tauto &dbconfig = DBConfig::GetConfig(db);"," \ttry {"," \t\tauto &fs = FileSystem::GetLocal(db);"," #ifndef DUCKDB_WASM"," \t\tif (Settings::Get<AutoinstallKnownExtensionsSetting>(db)) {","-\t\t\tauto repository_url = GetAutoInstallExtensionsRepository(dbconfig);","-\t\t\tauto autoinstall_repo = ExtensionRepository::GetRepositoryByUrl(repository_url);","+\t\t\tauto autoinstall_repo = GetAutoinstallRepository(db);"," \t\t\tExtensionInstallOptions options;"," \t\t\toptions.repository = autoinstall_repo;"," \t\t\tExtensionHelper::InstallExtension(db, fs, extension_name, options);"],"additions":9,"deletions":10,"truncated":false},{"path":"src/main/extension/extension_load.cpp","lines":["@@ -729,11 +729,12 @@ ExtensionInitResult ExtensionHelper::InitialLoad(DatabaseInstance &db, FileSyste"," \t\t// the extension load failed - try installing the extension, from the requested repository if one was given"," \t\tExtensionInstallOptions options;"," \t\tExtensionRepository repository;","-\t\tif (!repository_name.empty() &&","-\t\t    (ExtensionRepositoryManager::TryGetRepository(db, fs, repository_name, repository) ||","-\t\t     ExtensionRepository::TryGetKnownRepository(repository_name, repository))) {","-\t\t\toptions.repository = repository;","+\t\tif (repository_name.empty() ||","+\t\t    !(ExtensionRepositoryManager::TryGetRepository(db, fs, repository_name, repository) ||","+\t\t      ExtensionRepository::TryGetKnownRepository(repository_name, repository))) {","+\t\t\trepository = GetAutoinstallRepository(db);"," \t\t}","+\t\toptions.repository = repository;"," \t\tExtensionHelper::InstallExtension(db, fs, extension, options);"," \t\t// try loading again"," \t\tif (!TryInitialLoad(db, fs, extension, repository_name, core_only, result, error)) {"],"additions":5,"deletions":4,"truncated":false},{"path":"src/main/extension/local_extension_repository.cpp.in","lines":["@@ -0,0 +1,28 @@","+// Generated from src/main/extension/local_extension_repository.cpp.in. Do not edit.","+// The local_extension_repository capability: automatic installs default to the extension repository of the build","+// that produced it, instead of the core repository.","+","+#include \"duckdb/main/database.hpp\"","+#include \"duckdb_static_extension.h\"","+","+namespace duckdb {","+","+static void UseLocalExtensionRepository(DatabaseInstance &db) {","+\tauto &options = db.config.options;","+\tif (options.default_autoinstall_repository.empty()) {","+\t\toptions.default_autoinstall_repository = \"@LOCAL_EXTENSION_REPOSITORY@\";","+\t}","+}","+","+} // namespace duckdb","+","+extern \"C\" int32_t duckdb_extension_local_extension_repository_describe(duckdb_extension_descriptor *descriptor) {","+\tif (descriptor->version < 2) {","+\t\tdescriptor->set_error(descriptor, \"local_extension_repository needs descriptor layout 2\");","+\t\treturn 1;","+\t}","+\tdescriptor->version = 2;","+\tdescriptor->name = \"local_extension_repository\";","+\tdescriptor->database_callback = reinterpret_cast<void (*)(void)>(duckdb::UseLocalExtensionRepository);","+\treturn 0;","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"test/api/test_external_extension_provider.cpp","lines":["@@ -3,6 +3,7 @@"," #include \"duckdb/main/extension/external_extension_provider.hpp\""," #include \"duckdb/main/extension/linked_extension_registry.hpp\""," #include \"duckdb/main/extension_helper.hpp\"","+#include \"duckdb/main/extension_install_info.hpp\""," #include \"test_helpers.hpp\""," "," using namespace duckdb;","@@ -45,3 +46,25 @@ TEST_CASE(\"The none external extension provider refuses installing and loading\","," \tCHECK(!ExtensionHelper::CanAutoloadExtension(*db.instance, \"json\"));"," \tREQUIRE_THROWS(db.instance->config.SetExternalExtensionProvider(nullptr));"," }","+","+TEST_CASE(\"Automatic installs go to the linked local extension repository unless a setting says otherwise\", \"[api]\") {","+\tDuckDB db(nullptr);","+\tauto &config = DBConfig::GetConfig(*db.instance);","+\tbool linked = false;","+\tfor (auto &entry : config.linked_extensions) {","+\t\tlinked = linked || entry.name == \"local_extension_repository\";","+\t}","+\tauto core = ExtensionRepository::GetCoreRepository();","+\tauto repository = ExtensionHelper::GetAutoinstallRepository(*db.instance);","+\tCHECK(linked == !config.options.default_autoinstall_repository.empty());","+\tCHECK(repository.path == (linked ? config.options.default_autoinstall_repository : core.path));","+","+\tConnection con(db);","+\tREQUIRE_NO_FAIL(con.Query(\"SET custom_extension_repository = 'http://custom.test'\"));","+\tCHECK(ExtensionHelper::GetAutoinstallRepository(*db.instance).path == \"http://custom.test\");","+\tREQUIRE_NO_FAIL(con.Query(\"SET autoinstall_extension_repository = 'http://autoinstall.test'\"));","+\tCHECK(ExtensionHelper::GetAutoinstallRepository(*db.instance).path == \"http://autoinstall.test\");","+\tREQUIRE_NO_FAIL(con.Query(\"RESET autoinstall_extension_repository\"));","+\tREQUIRE_NO_FAIL(con.Query(\"RESET custom_extension_repository\"));","+\tCHECK(ExtensionHelper::GetAutoinstallRepository(*db.instance).path == repository.path);","+}",""],"additions":23,"deletions":0,"truncated":false}],"additions":98,"deletions":21,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-09-30T15:48:11.238762+00:00"}