{"id":"36cfbfb5d1795326561aaee5a4796e83407fc494","axis":"silent","repo":"envoyproxy/envoy","sha":"36cfbfb5d1795326561aaee5a4796e83407fc494","parsed":{"files":[{"path":"api/envoy/extensions/filters/http/mcp_json_rest_bridge/v3/mcp_json_rest_bridge.proto","lines":["@@ -202,10 +202,10 @@ message ServerInfo {","   //   ``-32601`` (``Method not found``) error only after header validation succeeds. A request","   //   with both a header validation error and an unsupported method is rejected with HTTP ``400``.","   //","-  // This filter does not validate ``io.modelcontextprotocol/clientCapabilities``. To reject","-  // requests that are missing it with HTTP ``400``, configure the","-  // :ref:`MCP filter <config_http_filters_mcp>` with ``traffic_mode: REJECT_NO_MCP`` before this","-  // filter.","+  // For stateless MCP ``2026-07-28`` requests, this filter also validates","+  // the presence of ``io.modelcontextprotocol/clientCapabilities`` in","+  // ``params._meta``. A missing field is rejected with HTTP ``400``.","+  // This validation takes precedence over unsupported method handling.","   //","   // All other (legacy) requests keep their existing behavior: the header validation above does","   // not apply, and an unsupported method is rejected with HTTP ``200`` and a JSON-RPC ``-32601``"],"additions":4,"deletions":4,"truncated":false},{"path":"changelogs/current/new_features/mcp_json_rest_bridge__require_client_capabilities.rst","lines":["@@ -0,0 +1,4 @@","+Added validation that stateless MCP ``2026-07-28`` requests include","+``params._meta[\"io.modelcontextprotocol/clientCapabilities\"]`` as a JSON object. Requests where the","+field is missing or is not an object are rejected with a ``400`` ``Invalid params`` (``-32602``)","+JSON-RPC error. Individual capability contents are not validated."],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/bridge_status.cc","lines":["@@ -19,6 +19,8 @@ absl::string_view bridgeStatusToString(BridgeStatus status) {","     return BridgeStatusValues::REQUEST_UNSUPPORTED_MCP_VERSION;","   case BridgeStatus::RequestMcpHeaderMismatch:","     return BridgeStatusValues::REQUEST_MCP_HEADER_MISMATCH;","+  case BridgeStatus::RequestMcpClientCapabilitiesInvalid:","+    return BridgeStatusValues::REQUEST_MCP_CLIENT_CAPABILITIES_INVALID;","   case BridgeStatus::RequestInitializeNotValid:","     return BridgeStatusValues::REQUEST_INITIALIZE_NOT_VALID;","   case BridgeStatus::RequestMcpMethodNotSupported:"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/bridge_status.h","lines":["@@ -14,6 +14,7 @@ enum class BridgeStatus {","   RequestFailedToParseJsonRpc,","   RequestUnsupportedMcpVersion,","   RequestMcpHeaderMismatch,","+  RequestMcpClientCapabilitiesInvalid,","   RequestInitializeNotValid,","   RequestMcpMethodNotSupported,","   RequestMcpMethodMalformed,","@@ -45,6 +46,8 @@ inline constexpr absl::string_view REQUEST_UNSUPPORTED_MCP_VERSION =","     \"mcp_json_rest_bridge_request_unsupported_mcp_version\";"," inline constexpr absl::string_view REQUEST_MCP_HEADER_MISMATCH =","     \"mcp_json_rest_bridge_request_mcp_header_mismatch\";","+inline constexpr absl::string_view REQUEST_MCP_CLIENT_CAPABILITIES_INVALID =","+    \"mcp_json_rest_bridge_request_mcp_client_capabilities_invalid\";"," inline constexpr absl::string_view REQUEST_INITIALIZE_NOT_VALID =","     \"mcp_json_rest_bridge_request_initialize_not_valid\";"," inline constexpr absl::string_view REQUEST_MCP_METHOD_NOT_SUPPORTED ="],"additions":3,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/mcp_json_rest_bridge_filter.cc","lines":["@@ -1360,6 +1360,31 @@ absl::Status McpJsonRestBridgeFilter::validateMcpProtocolVersionHeader(","   return absl::OkStatus();"," }"," ","+bool McpJsonRestBridgeFilter::validateClientCapabilitiesMeta(const nlohmann::json& json_rpc,","+                                                             absl::string_view method) {","+  const nlohmann::json& params = json_rpc[McpConstants::PARAMS_FIELD];","+  const nlohmann::json& meta = params[McpConstants::META_FIELD];","+  const auto client_capabilities = meta.find(McpConstants::MCP_META_CLIENT_CAPABILITIES_FIELD);","+  if (client_capabilities != meta.end() && client_capabilities->is_object()) {","+    return true;","+  }","+","+  const std::string error_message =","+      client_capabilities == meta.end()","+          ? absl::StrCat(\"Missing required params._meta field: \",","+                         McpConstants::MCP_META_CLIENT_CAPABILITIES_FIELD)","+          : absl::StrCat(\"Invalid params._meta field: \",","+                         McpConstants::MCP_META_CLIENT_CAPABILITIES_FIELD, \" must be an object\");","+  ENVOY_STREAM_LOG(debug, \"Rejecting stateless MCP request: {}\", *decoder_callbacks_,","+                   error_message);","+  sendErrorResponse(","+      Http::Code::BadRequest, BridgeStatus::RequestMcpClientCapabilitiesInvalid,","+      generateErrorJsonResponse(McpConstants::JSONRPC_INVALID_PARAMS_ERROR_CODE, error_message)","+          .dump(),","+      nullptr, method, params);","+  return false;","+}","+"," bool McpJsonRestBridgeFilter::validateMcpMethodHeader(","     const nlohmann::json& json_rpc, absl::string_view method,","     Http::RequestHeaderMapOptRef request_headers) {","@@ -1461,6 +1486,10 @@ void McpJsonRestBridgeFilter::handleMcpMethod(","     return;","   }"," ","+  if (is_stateless_request_ && !validateClientCapabilitiesMeta(json_rpc, method)) {","+    return;","+  }","+","   if (method == McpConstants::Methods::TOOLS_LIST) {","     std::vector<const envoy::extensions::filters::http::mcp_json_rest_bridge::v3::ToolConfig*>","         tool_list_local_tools = (per_route_config == nullptr)"],"additions":29,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/mcp_json_rest_bridge_filter.h","lines":["@@ -231,6 +231,13 @@ class McpJsonRestBridgeFilter : public Http::PassThroughFilter,","                                                 absl::string_view method,","                                                 Http::RequestHeaderMapOptConstRef request_headers);"," ","+  // Validates that a stateless (2026-07-28) request carries the required","+  // params._meta[\"io.modelcontextprotocol/clientCapabilities\"] field and that it is a JSON object.","+  // Individual capability contents are not validated. Must only be called for stateless requests,","+  // whose params._meta is guaranteed to be an object. Returns true when the field is valid.","+  // Otherwise sends a local error response and returns false.","+  bool validateClientCapabilitiesMeta(const nlohmann::json& json_rpc, absl::string_view method);","+","   // Validates that the \"Mcp-Method\" request header is present and matches the JSON-RPC \"method\"","   // field. Returns true when the header is valid. Otherwise sends a local error response and","   // returns false."],"additions":7,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/mcp_json_rest_bridge/mcp_json_rest_bridge_filter_test.cc","lines":["@@ -5483,6 +5483,118 @@ TEST_F(McpJsonRestBridgeFilterTest,","             Http::FilterDataStatus::StopIterationNoBuffer);"," }"," ","+constexpr absl::string_view kMissingClientCapabilitiesError =","+    R\"json({\"code\":-32602,\"message\":\"Missing required params._meta field: io.modelcontextprotocol/clientCapabilities\"})json\";","+constexpr absl::string_view kInvalidClientCapabilitiesError =","+    R\"json({\"code\":-32602,\"message\":\"Invalid params._meta field: io.modelcontextprotocol/clientCapabilities must be an object\"})json\";","+","+class StatelessClientCapabilitiesTest : public McpJsonRestBridgeFilterTest {","+protected:","+  void SetUp() override {","+    McpJsonRestBridgeFilterTest::SetUp();","+    proto_config_.mutable_server_info()->mutable_max_supported_protocol_version()->set_value(","+        \"2026-07-28\");","+    ASSERT_OK(makeFilter());","+  }","+","+  void setToolsCallHeaders() {","+    request_headers_ = {{\":method\", \"POST\"},","+                        {\":path\", \"/mcp\"},","+                        {\"content-type\", \"application/json\"},","+                        {\"mcp-method\", \"tools/call\"},","+                        {\"mcp-name\", \"create_api_key\"},","+                        {\"mcp-protocol-version\", \"2026-07-28\"}};","+  }","+};","+","+TEST_F(StatelessClientCapabilitiesTest, EmptyClientCapabilitiesIsAccepted) {","+  setToolsCallHeaders();","+  EXPECT_EQ(filter_->decodeHeaders(request_headers_, /*end_stream=*/false),","+            Http::FilterHeadersStatus::StopIteration);","+","+  EXPECT_CALL(decoder_callbacks_, sendLocalReply(_, _, _, _, _)).Times(0);","+","+  Buffer::OwnedImpl body(","+      R\"json({\"jsonrpc\":\"2.0\",\"id\":123,\"method\":\"tools/call\",\"params\":{\"name\":\"create_api_key\",\"arguments\":{\"parent\":\"projects/test-codelab\",\"key\":{\"displayName\":\"display-key\"}},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}})json\");","+  EXPECT_EQ(filter_->decodeData(body, /*end_stream=*/true), Http::FilterDataStatus::Continue);","+  EXPECT_THAT(request_headers_.getPathValue(), StrEq(\"/v1/projects/test-codelab/apiKeys\"));","+}","+","+TEST_F(StatelessClientCapabilitiesTest, MissingClientCapabilitiesReturnsInvalidParams) {","+  setToolsCallHeaders();","+  EXPECT_EQ(filter_->decodeHeaders(request_headers_, /*end_stream=*/false),","+            Http::FilterHeadersStatus::StopIteration);","+","+  EXPECT_CALL(decoder_callbacks_.downstream_callbacks_, clearRouteCache()).Times(0);","+  EXPECT_CALL(","+      decoder_callbacks_,","+      sendLocalReply(Eq(Http::Code::BadRequest), StrEq(kMissingClientCapabilitiesError), _, _,","+                     StrEq(\"mcp_json_rest_bridge_request_mcp_client_capabilities_invalid\")));","+","+  Buffer::OwnedImpl body(","+      R\"json({\"jsonrpc\":\"2.0\",\"id\":123,\"method\":\"tools/call\",\"params\":{\"name\":\"create_api_key\",\"arguments\":{\"parent\":\"projects/test-codelab\",\"key\":{\"displayName\":\"display-key\"}},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}})json\");","+  EXPECT_EQ(filter_->decodeData(body, /*end_stream=*/true),","+            Http::FilterDataStatus::StopIterationNoBuffer);","+  EXPECT_THAT(request_headers_.getPathValue(), StrEq(\"/mcp\"));","+","+  response_headers_ = {{\"content-type\", \"text/plain\"}, {\"content-length\", \"123456\"}};","+  EXPECT_EQ(filter_->encodeHeaders(response_headers_, /*end_stream=*/false),","+            Http::FilterHeadersStatus::StopIteration);","+  Buffer::OwnedImpl response_body(kMissingClientCapabilitiesError);","+  EXPECT_EQ(filter_->encodeData(response_body, /*end_stream=*/true),","+            Http::FilterDataStatus::Continue);","+  EXPECT_THAT(response_headers_.getContentTypeValue(), StrEq(\"application/json\"));","+  EXPECT_EQ(","+      nlohmann::json::parse(response_body.toString()),","+      nlohmann::json::parse(","+          R\"json({\"error\":{\"code\":-32602,\"message\":\"Missing required params._meta field: io.modelcontextprotocol/clientCapabilities\"},\"id\":123,\"jsonrpc\":\"2.0\"})json\"));","+}","+","+TEST_F(StatelessClientCapabilitiesTest,","+       MissingClientCapabilitiesTakesPrecedenceOverUnsupportedMethod) {","+  request_headers_ = {{\":method\", \"POST\"},","+                      {\":path\", \"/mcp\"},","+                      {\"mcp-method\", \"resources/list\"},","+                      {\"mcp-protocol-version\", \"2026-07-28\"}};","+  EXPECT_EQ(filter_->decodeHeaders(request_headers_, /*end_stream=*/false),","+            Http::FilterHeadersStatus::StopIteration);","+","+  EXPECT_CALL(","+      decoder_callbacks_,","+      sendLocalReply(Eq(Http::Code::BadRequest), StrEq(kMissingClientCapabilitiesError), _, _,","+                     StrEq(\"mcp_json_rest_bridge_request_mcp_client_capabilities_invalid\")));","+","+  Buffer::OwnedImpl body(","+      R\"json({\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"resources/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}})json\");","+  EXPECT_EQ(filter_->decodeData(body, /*end_stream=*/true),","+            Http::FilterDataStatus::StopIterationNoBuffer);","+}","+","+class StatelessNonObjectClientCapabilitiesTest : public StatelessClientCapabilitiesTest,","+                                                 public testing::WithParamInterface<std::string> {};","+","+TEST_P(StatelessNonObjectClientCapabilitiesTest, NonObjectClientCapabilitiesReturnsInvalidParams) {","+  setToolsCallHeaders();","+  EXPECT_EQ(filter_->decodeHeaders(request_headers_, /*end_stream=*/false),","+            Http::FilterHeadersStatus::StopIteration);","+","+  EXPECT_CALL(decoder_callbacks_.downstream_callbacks_, clearRouteCache()).Times(0);","+  EXPECT_CALL(","+      decoder_callbacks_,","+      sendLocalReply(Eq(Http::Code::BadRequest), StrEq(kInvalidClientCapabilitiesError), _, _,","+                     StrEq(\"mcp_json_rest_bridge_request_mcp_client_capabilities_invalid\")));","+","+  Buffer::OwnedImpl body(","+      R\"json({\"jsonrpc\":\"2.0\",\"id\":123,\"method\":\"tools/call\",\"params\":{\"name\":\"create_api_key\",\"arguments\":{\"parent\":\"projects/test-codelab\",\"key\":{\"displayName\":\"display-key\"}},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":)json\" +","+      GetParam() + \"}}}\");","+  EXPECT_EQ(filter_->decodeData(body, /*end_stream=*/true),","+            Http::FilterDataStatus::StopIterationNoBuffer);","+  EXPECT_THAT(request_headers_.getPathValue(), StrEq(\"/mcp\"));","+}","+","+INSTANTIATE_TEST_SUITE_P(NonObjectValues, StatelessNonObjectClientCapabilitiesTest,","+                         testing::Values(\"null\", \"true\", \"0\", R\"(\"elicitation\")\", \"[]\"));","+"," } // namespace"," } // namespace McpJsonRestBridge"," } // namespace HttpFilters"],"additions":112,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/mcp_json_rest_bridge/mcp_json_rest_bridge_integration_test.cc","lines":["@@ -471,7 +471,7 @@ TEST_P(McpJsonRestBridgeIntegrationTest, StatelessUnsupportedMethodReturnsNotFou","                                      {\"content-type\", \"application/json\"},","                                      {\"mcp-method\", \"tools/invalid\"},","                                      {\"mcp-protocol-version\", \"2026-07-28\"}},","-      R\"json({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/invalid\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}})json\");","+      R\"json({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/invalid\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}})json\");"," ","   ASSERT_TRUE(response->waitForEndStream());","   EXPECT_THAT(response->headers().getStatusValue(), StrEq(\"404\"));",""],"additions":1,"deletions":1,"truncated":false}],"additions":162,"deletions":5,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-22T13:46:16.027704+00:00"}