{"id":"3548f353cda8b1c2fc702052b0f63ab724694654","axis":"silent","repo":"mongodb/mongo","sha":"3548f353cda8b1c2fc702052b0f63ab724694654","parsed":{"files":[{"path":"jstests/noPassthrough/validate/validate_full_with_collHash.js","lines":["@@ -0,0 +1,105 @@","+/**","+ * Ensures {full: true} and {collHash: true} can be combined in one validate command, producing both","+ * the collection hash and the work that only a full validation does.","+ */","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {checkLog} from \"src/mongo/shell/check_log.js\";","+","+const kValidatingCollectionLogId = 20303;","+","+describe(\"validate with full and collHash\", function () {","+    let conn;","+    let coll;","+","+    before(function () {","+        conn = MongoRunner.runMongod();","+        coll = conn.getDB(\"test\").coll;","+        assert.commandWorked(coll.createIndex({a: 1}));","+        assert.commandWorked(","+            coll.insert([","+                {_id: 1, a: 1},","+                {_id: 2, a: 2},","+                {_id: 3, a: 3},","+            ]),","+        );","+    });","+","+    after(function () {","+        MongoRunner.stopMongod(conn);","+    });","+","+    it(\"returns the collection hash alongside the full validation results\", function () {","+        const collHashOnly = assert.commandWorked(coll.validate({collHash: true}));","+        const fullOnly = assert.commandWorked(coll.validate({full: true}));","+        const fullAndCollHash = assert.commandWorked(coll.validate({full: true, collHash: true}));","+","+        assert(collHashOnly.hasOwnProperty(\"all\"), \"collHash did not return a hash\", {","+            collHashOnly,","+        });","+        assert(!fullOnly.hasOwnProperty(\"all\"), \"full alone returned a hash\", {fullOnly});","+","+        assert(fullAndCollHash.valid, \"validation failed\", {fullAndCollHash});","+        assert(fullAndCollHash.hasOwnProperty(\"all\"), \"full and collHash did not return a hash\", {","+            fullAndCollHash,","+        });","+        assert.eq(collHashOnly.all, fullAndCollHash.all, \"hash differs when combined with full\");","+        assert.eq(fullOnly.nrecords, fullAndCollHash.nrecords);","+        assert.eq(fullOnly.nIndexes, fullAndCollHash.nIndexes);","+        assert.eq(fullOnly.keysPerIndex, fullAndCollHash.keysPerIndex);","+    });","+","+    it(\"computes only the hashes that collHash names\", function () {","+        const sha256 = assert.commandWorked(coll.validate({collHash: \"sha256\"}));","+        assert(sha256.hasOwnProperty(\"all\"), \"sha256 did not return the SHA-256 hash\", {sha256});","+        assert(!sha256.hasOwnProperty(\"xxh3All\"), \"sha256 returned the XXH3 hash\", {sha256});","+","+        const xxh3 = assert.commandWorked(coll.validate({collHash: \"xxh3\"}));","+        assert(xxh3.hasOwnProperty(\"xxh3All\"), \"xxh3 did not return the XXH3 hash\", {xxh3});","+        assert(!xxh3.hasOwnProperty(\"all\"), \"xxh3 returned the SHA-256 hash\", {xxh3});","+        assert(!xxh3.hasOwnProperty(\"metadata\"), \"xxh3 returned the metadata hash\", {xxh3});","+","+        const both = assert.commandWorked(","+            coll.validate({collHash: [\"sha256\", \"xxh3\"], full: true}),","+        );","+        assert.eq(sha256.all, both.all);","+        assert.eq(xxh3.xxh3All, both.xxh3All);","+","+        const absent = assert.commandWorked(coll.validate({}));","+        const defaulted = assert.commandWorked(coll.validate({collHash: \"default\"}));","+        assert(!defaulted.hasOwnProperty(\"all\"), \"default returned the SHA-256 hash\", {defaulted});","+        assert(!absent.hasOwnProperty(\"xxh3All\"), \"absent returned the XXH3 hash\", {absent});","+        assert(!defaulted.hasOwnProperty(\"xxh3All\"), \"default returned the XXH3 hash\", {defaulted});","+        assert.eq(","+            Object.keys(absent).sort(),","+            Object.keys(defaulted).sort(),","+            \"default differs from leaving collHash out\",","+        );","+","+        assert.commandFailedWithCode(","+            coll.validate({collHash: [\"default\"]}),","+            ErrorCodes.InvalidOptions,","+        );","+        assert.commandFailedWithCode(coll.validate({collHash: \"md5\"}), ErrorCodes.InvalidOptions);","+        assert.commandFailedWithCode(coll.validate({collHash: []}), ErrorCodes.InvalidOptions);","+        assert.commandFailedWithCode(","+            coll.validate({collHash: \"xxh3\", hashPrefixes: []}),","+            ErrorCodes.InvalidOptions,","+        );","+    });","+","+    it(\"resolves the validate mode and collection hash settings independently\", function () {","+        assert.commandWorked(coll.validate({collHash: true}));","+        assert.commandWorked(coll.validate({full: true}));","+        assert.commandWorked(coll.validate({full: true, collHash: true}));","+","+        checkLog.containsJson(conn, kValidatingCollectionLogId, {","+            options: (o) => o.mode === \"foreground\" && o.collHash.sha256 === true,","+        });","+        checkLog.containsJson(conn, kValidatingCollectionLogId, {","+            options: (o) => o.mode === \"foregroundFull\" && o.collHash.sha256 === false,","+        });","+        checkLog.containsJson(conn, kValidatingCollectionLogId, {","+            options: (o) => o.mode === \"foregroundFull\" && o.collHash.sha256 === true,","+        });","+    });","+});"],"additions":105,"deletions":0,"truncated":false},{"path":"src/mongo/db/commands/validate.cpp","lines":["@@ -228,7 +228,8 @@ class ValidateCmd : public BasicCommand {","                   logAttrs(nss),","                   \"background\"_attr = options.isBackground(),","                   \"full\"_attr = options.isFullValidation(),","-                  \"extended\"_attr = options.isExtendedValidation(),","+                  \"collHash\"_attr = options.collHash.toBSON(),","+                  \"hashDrillDown\"_attr = options.isHashDrillDown(),","                   \"enforceFastCount\"_attr = options.enforceFastCountRequested(),","                   \"enforceFastSize\"_attr = options.enforceFastSizeRequested(),","                   \"checkBSONConformance\"_attr = options.isBSONConformanceValidation(),"],"additions":2,"deletions":1,"truncated":false},{"path":"src/mongo/db/validate/README.md","lines":["@@ -172,9 +172,16 @@ a replica set to check for inter-node consistency. The collection hashing featur"," on a standalone node and is not supported against a replica set. The following parameters are used"," for the collection hashing."," ","-- `collHash`: <bool>","-  - Enables hash computation for the collection. When present, validate computes a combined hash","-    over the collection’s documents.","+- `collHash`: <bool | string | array<string>>","+  - Enables hash computation for the collection. When absent, validate computes only the XXH3 hash,","+    and only when the persistence provider records per-collection hashes to check it against;","+    `false` computes no hash. `true` computes the SHA-256 hash, plus the XXH3 hash when the","+    persistence provider records per-collection hashes to compare it against. A string or array","+    selects the hashes explicitly from `\"sha256\"` and `\"xxh3\"`. The string `\"default\"` (not accepted","+    in an array) is what leaving `collHash` out selects. `\"xxh3\"` alone computes the XXH3 hash","+    (reported as `xxh3All`) regardless of the persistence provider, and does not compute any SHA-256","+    hash. `hashPrefixes` and `revealHashedIds` require `\"sha256\"`. It can be combined with any","+    validation mode, such as `full: true`."," - `hashPrefixes`: <array<string>>","   - Requests a bucketed view of the collection keyed by prefixes of the per-document \\_id hash.","     Buckets are returned in the `partial` field and are used to iteratively narrow down inconsistent"],"additions":10,"deletions":3,"truncated":false},{"path":"src/mongo/db/validate/collection_validation.cpp","lines":["@@ -619,6 +619,81 @@ boost::optional<int64_t> getTargetRecordsPerRecordStoreSlice() {","     return gValidateParallelTargetRecordsPerSlice.load();"," }"," ","+bool isRecordStoreSlicingEnabled(const boost::optional<int64_t>& targetRecordsPerSlice) {","+    return targetRecordsPerSlice && *targetRecordsPerSlice > 0 &&","+        gValidateParallelMaxRecordStoreSlices.load() > 1;","+}","+","+namespace {","+","+// Absent selects the defaults. 'true' selects the legacy behavior, and 'false' no hashes. A string","+// or an array of strings selects exactly the hashes to compute: \"sha256\" and/or \"xxh3\". The string","+// \"default\" selects whatever absence does, and is only accepted as a string.","+CollectionHashOptions parseCollHashOptions(const BSONElement& elem, bool enableSizeStats) {","+    if (elem.eoo()) {","+        return {};","+    }","+","+    CollectionHashOptions options = CollectionHashOptions::none();","+    auto select = [&](std::string_view algorithm) {","+        if (algorithm == \"sha256\") {","+            options.sha256 = true;","+        } else if (algorithm == \"xxh3\") {","+            options.xxh3 = Xxh3HashMode::kAlways;","+        } else {","+            uasserted(ErrorCodes::InvalidOptions,","+                      str::stream() << \"Unknown collHash algorithm '\" << algorithm","+                                    << \"', expected 'sha256' or 'xxh3'\");","+        }","+    };","+","+    switch (elem.type()) {","+        case BSONType::null:","+        case BSONType::undefined:","+            break;","+        case BSONType::boolean:","+        case BSONType::numberInt:","+        case BSONType::numberLong:","+        case BSONType::numberDouble:","+        case BSONType::numberDecimal:","+            if (elem.trueValue()) {","+                options = CollectionHashOptions::legacy();","+            }","+            break;","+        case BSONType::string:","+            if (elem.valueStringData() == \"default\") {","+                return {};","+            }","+            select(elem.valueStringData());","+            break;","+        case BSONType::array: {","+            if (elem.Obj().isEmpty()) {","+                uasserted(ErrorCodes::InvalidOptions,","+                          \"collHash must name at least one algorithm when it is an array\");","+            }","+            for (const auto& algorithm : elem.Obj()) {","+                uassert(ErrorCodes::InvalidOptions,","+                        str::stream() << \"collHash array elements must be strings, got \"","+                                      << typeName(algorithm.type()),","+                        algorithm.type() == BSONType::string);","+                select(algorithm.valueStringData());","+            }","+            break;","+        }","+        default:","+            uasserted(ErrorCodes::InvalidOptions,","+                      str::stream() << \"collHash must be a boolean, a string or an array of \"","+                                       \"strings, got \"","+                                    << typeName(elem.type()));","+    }","+","+    // Size stats are only collected for SHA256 hashes","+    options.sizeStats = enableSizeStats && options.sha256;","+    return options;","+}","+","+}  // namespace","+"," ValidationOptions parseValidateOptions(OperationContext* opCtx,","                                        NamespaceString nss,","                                        const BSONObj& cmdObj,","@@ -724,14 +799,11 @@ ValidationOptions parseValidateOptions(OperationContext* opCtx,","                                 << \"is not supported on unreplicated collections\");","     }"," ","-    // collHash parameter.","-    const bool collHash = cmdObj[\"collHash\"].trueValue();","-","     // Size stats accumulate and log a size summary during a collHash validation. This is","     // enabled only by the offline startup '--validate' path (fleet validation), never by the","     // 'validate' command, so customers never see the extra log lines. It is meaningful only for","     // collHash validation, whose full scan drives the size-summary accumulation.","-    const bool sizeStats = enableSizeStats && collHash;","+    const auto collHashOptions = parseCollHashOptions(cmdObj[\"collHash\"], enableSizeStats);"," ","     // hashPrefixes parameter.","     const auto rawHashPrefixes = cmdObj[\"hashPrefixes\"];","@@ -752,25 +824,24 @@ ValidationOptions parseValidateOptions(OperationContext* opCtx,","             str::stream() << \"Running the validate command with { hashPrefixes: [] } can only be\"","                           << \" performed in standalone mode.\");","     }","-    if (rawHashPrefixes && !collHash) {","+    if (rawHashPrefixes && !collHashOptions.sha256) {","         uasserted(ErrorCodes::InvalidOptions,","-                  str::stream() << \"Running the validate command with { hashPrefixes: [] }\"","-                                << \" requires {collHash: true}.\");","+                  \"Running the validate command with { hashPrefixes: [] } requires a collHash that \"","+                  \"includes 'sha256'.\");","     }"," ","     // revealHashedIds parameter.","     const auto rawRevealHashedIds = cmdObj[\"revealHashedIds\"];","     boost::optional<std::vector<std::string>> revealHashedIds = boost::none;","     if (rawRevealHashedIds && replCoord->getSettings().isReplSet()) {","-        uasserted(","-            ErrorCodes::InvalidOptions,","-            str::stream() << \"Running the validate command with { revealHashedIds: [] } can only be\"","-                          << \" performed in standalone mode.\");","+        uasserted(ErrorCodes::InvalidOptions,","+                  \"Running the validate command with { revealHashedIds: [] } can only be performed \"","+                  \"in standalone mode.\");","     }","-    if (rawRevealHashedIds && !collHash) {","+    if (rawRevealHashedIds && !collHashOptions.sha256) {","         uasserted(ErrorCodes::InvalidOptions,","-                  str::stream() << \"Running the validate command with { revealHashedIds: [] }\"","-                                << \" requires {collHash: true}.\");","+                  \"Running the validate command with { revealHashedIds: [] } collHash options that \"","+                  \"include 'sha256'.\");","     }","     if (rawRevealHashedIds && rawHashPrefixes) {","         uasserted(ErrorCodes::InvalidOptions,","@@ -834,9 +905,6 @@ ValidationOptions parseValidateOptions(OperationContext* opCtx,","         if (hashPrefixes) {","             return collection_validation::ValidateMode::kHashDrillDown;","         }","-        if (collHash) {","-            return collection_validation::ValidateMode::kCollectionHash;","-        }","         if (background) {","             return checkBSONConformance ? collection_validation::ValidateMode::kBackgroundCheckBSON","                                         : collection_validation::ValidateMode::kBackground;","@@ -868,7 +936,6 @@ ValidationOptions parseValidateOptions(OperationContext* opCtx,","         }","         switch (validateMode) {","             case collection_validation::ValidateMode::kForeground:","-            case collection_validation::ValidateMode::kCollectionHash:","             case collection_validation::ValidateMode::kHashDrillDown:","             case collection_validation::ValidateMode::kForegroundCheckBSON:","             case collection_validation::ValidateMode::kForegroundFull:","@@ -906,7 +973,7 @@ ValidationOptions parseValidateOptions(OperationContext* opCtx,","             .hashPrefixes = hashPrefixes,","             .revealHashedIds = revealHashedIds,","             .targetRecordsPerRecordStoreSlice = getTargetRecordsPerRecordStoreSlice(),","-            .sizeStats = sizeStats};","+            .collHash = collHashOptions};"," }"," "," BSONObj ValidationMetrics::toBSON(const ValidateResults& results) const {","@@ -1209,13 +1276,13 @@ Status validate(OperationContext* opCtx,","             }","         }"," ","-        if (validateState.getOptions().isCollHashValidation()) {","+        if (validateState.getOptions().collHash.sha256) {","             indexValidator.computeMetadataHash(opCtx, validateState.getCollection(), results);","         }"," ","         // Compare the accumulated hash against the replicated metadata system's view of the","         // collection.","-        if (validateState.getOptions().isCollHashValidation() &&","+        if (results.getXxh3CollectionHash().has_value() &&","             rss::ReplicatedStorageService::get(opCtx)","                 .getPersistenceProvider()","                 .shouldUseContinuousInternodeValidation()) {"],"additions":88,"deletions":21,"truncated":false},{"path":"src/mongo/db/validate/collection_validation_bm.cpp","lines":["@@ -132,7 +132,10 @@ size_t insertRecords(OperationContext* opCtx, const DataSpec& spec) {"," "," // Builds a fresh storage environment, populates a collection per 'state's range args, and times"," // repeated collection_validation::validate() calls in the requested mode.","-void BM_Validate(benchmark::State& state, collection_validation::ValidateMode mode) {","+void BM_Validate(benchmark::State& state,","+                 collection_validation::ValidateMode mode,","+                 collection_validation::CollectionHashOptions collHash =","+                     collection_validation::CollectionHashOptions::none()) {","     const DataSpec spec{","         .numRecords = static_cast<int>(state.range(0)),","         .numFields = static_cast<int>(state.range(1)),","@@ -158,7 +161,8 @@ void BM_Validate(benchmark::State& state, collection_validation::ValidateMode mo","             collection_validation::ValidationOptions{.validateMode = mode,","                                                      .repairMode =","                                                          collection_validation::RepairMode::kNone,","-                                                     .logDiagnostics = false},","+                                                     .logDiagnostics = false,","+                                                     .collHash = collHash},","             results));","         invariant(results.isValid());","         benchmark::DoNotOptimize(results);","@@ -205,7 +209,39 @@ void DeprecatedTypeArgs(benchmark::internal::Benchmark* b) {","     }"," }"," ","-// Record-count scaling, across hash-off (kForeground), full, and hash-on (kCollectionHash) modes.","+// The four XXH3 / SHA256 combinations.","+static constexpr collection_validation::CollectionHashOptions kXxh3OnSha256On{","+    .sha256 = true, .xxh3 = collection_validation::Xxh3HashMode::kAlways};","+static constexpr collection_validation::CollectionHashOptions kXxh3OffSha256On{","+    .sha256 = true, .xxh3 = collection_validation::Xxh3HashMode::kNone};","+static constexpr collection_validation::CollectionHashOptions kXxh3OnSha256Off{","+    .sha256 = false, .xxh3 = collection_validation::Xxh3HashMode::kAlways};","+static constexpr collection_validation::CollectionHashOptions kXxh3OffSha256Off{","+    .sha256 = false, .xxh3 = collection_validation::Xxh3HashMode::kNone};","+","+#define BM_VALIDATE_HASH_COMBOS(axis, argsFn)                           \\","+    BENCHMARK_CAPTURE(BM_Validate,                                      \\","+                      Xxh3On_Sha256On_##axis,                           \\","+                      collection_validation::ValidateMode::kForeground, \\","+                      kXxh3OnSha256On)                                  \\","+        ->Apply(argsFn);                                                \\","+    BENCHMARK_CAPTURE(BM_Validate,                                      \\","+                      Xxh3Off_Sha256On_##axis,                          \\","+                      collection_validation::ValidateMode::kForeground, \\","+                      kXxh3OffSha256On)                                 \\","+        ->Apply(argsFn);                                                \\","+    BENCHMARK_CAPTURE(BM_Validate,                                      \\","+                      Xxh3On_Sha256Off_##axis,                          \\","+                      collection_validation::ValidateMode::kForeground, \\","+                      kXxh3OnSha256Off)                                 \\","+        ->Apply(argsFn);                                                \\","+    BENCHMARK_CAPTURE(BM_Validate,                                      \\","+                      Xxh3Off_Sha256Off_##axis,                         \\","+                      collection_validation::ValidateMode::kForeground, \\","+                      kXxh3OffSha256Off)                                \\","+        ->Apply(argsFn)","+","+// Record-count scaling, across hash-off (kForeground), full, and each XXH3 / SHA256 combination."," BENCHMARK_CAPTURE(BM_Validate,","                   Foreground_RecordCount,","                   collection_validation::ValidateMode::kForeground)","@@ -214,18 +250,13 @@ BENCHMARK_CAPTURE(BM_Validate,","                   ForegroundFull_RecordCount,","                   collection_validation::ValidateMode::kForegroundFull)","     ->Apply(RecordCountArgs);","-BENCHMARK_CAPTURE(BM_Validate,","-                  CollectionHash_RecordCount,","-                  collection_validation::ValidateMode::kCollectionHash)","-    ->Apply(RecordCountArgs);","+BM_VALIDATE_HASH_COMBOS(RecordCount, RecordCountArgs);"," ","-// Document-size axis, hash off vs on (where the per-record SHA256 cost scales with bytes).","+// Document-size axis, hash off vs each combination (where the per-record hash cost scales with","+// bytes)."," BENCHMARK_CAPTURE(BM_Validate, Foreground_DocSize, collection_validation::ValidateMode::kForeground)","     ->Apply(DocSizeArgs);","-BENCHMARK_CAPTURE(BM_Validate,","-                  CollectionHash_DocSize,","-                  collection_validation::ValidateMode::kCollectionHash)","-    ->Apply(DocSizeArgs);","+BM_VALIDATE_HASH_COMBOS(DocSize, DocSizeArgs);"," "," // Field-count axis (BSON-validation traversal cost per byte)."," BENCHMARK_CAPTURE(BM_Validate,"],"additions":43,"deletions":12,"truncated":false},{"path":"src/mongo/db/validate/collection_validation_test.cpp","lines":["@@ -1132,6 +1132,110 @@ TEST_P(CollectionValidationAdaptorTest, ValidateOldUniqueIndexKeyWarning) {","     }"," }"," ","+using collection_validation::CollectionHashOptions;","+using collection_validation::Xxh3HashMode;","+","+TEST_F(CollectionValidationTest, CollHashIsIndependentOfValidateMode) {","+    auto parse = [&](BSONObj cmd) {","+        return collection_validation::parseValidateOptions(operationContext(), kNss, cmd);","+    };","+","+    const auto collHashOnly = parse(BSON(\"validate\" << \"t\" << \"collHash\" << true));","+    EXPECT_TRUE(collHashOnly.collHash.sha256);","+    EXPECT_EQ(collHashOnly.validateMode, collection_validation::ValidateMode::kForeground);","+","+    const auto full = parse(BSON(\"validate\" << \"t\" << \"full\" << true << \"collHash\" << true));","+    EXPECT_TRUE(full.collHash.sha256);","+    EXPECT_TRUE(full.isFullValidation());","+    EXPECT_EQ(full.validateMode, collection_validation::ValidateMode::kForegroundFull);","+","+    const auto noHash = parse(BSON(\"validate\" << \"t\" << \"full\" << true));","+    EXPECT_FALSE(noHash.collHash.sha256);","+    EXPECT_EQ(noHash.collHash.xxh3, Xxh3HashMode::kIfContinuousHashValidationEnabled);","+}","+","+TEST_F(CollectionValidationTest, CollHashAcceptsAlgorithmSelection) {","+    auto parse = [&](BSONObj cmd) {","+        return collection_validation::parseValidateOptions(operationContext(), kNss, cmd).collHash;","+    };","+    const auto legacy = CollectionHashOptions{","+        .sha256 = true, .xxh3 = Xxh3HashMode::kIfContinuousHashValidationEnabled};","+","+    EXPECT_EQ(parse(BSON(\"collHash\" << true)), legacy);","+    EXPECT_EQ(parse(BSON(\"collHash\" << 1)), legacy);","+    EXPECT_EQ(parse(BSON(\"collHash\" << false)), CollectionHashOptions::none());","+    EXPECT_EQ(parse(BSON(\"collHash\" << BSONNULL)), CollectionHashOptions::none());","+","+    // Without collHash, XXH3 is still accumulated when there is a persisted hash to check.","+    EXPECT_EQ(parse(BSONObj()), CollectionHashOptions{});","+    EXPECT_FALSE(parse(BSONObj()).sha256);","+    EXPECT_EQ(parse(BSONObj()).xxh3, Xxh3HashMode::kIfContinuousHashValidationEnabled);","+","+    EXPECT_EQ(parse(BSON(\"collHash\" << \"sha256\")),","+              (CollectionHashOptions{.sha256 = true, .xxh3 = Xxh3HashMode::kNone}));","+    EXPECT_EQ(parse(BSON(\"collHash\" << \"xxh3\")),","+              (CollectionHashOptions{.sha256 = false, .xxh3 = Xxh3HashMode::kAlways}));","+    EXPECT_EQ(parse(BSON(\"collHash\" << BSON_ARRAY(\"sha256\" << \"xxh3\"))),","+              (CollectionHashOptions{.sha256 = true, .xxh3 = Xxh3HashMode::kAlways}));","+    EXPECT_EQ(parse(BSON(\"collHash\" << BSON_ARRAY(\"xxh3\" << \"xxh3\"))),","+              (CollectionHashOptions{.sha256 = false, .xxh3 = Xxh3HashMode::kAlways}));","+","+    // \"default\" is the same as leaving collHash out.","+    EXPECT_EQ(parse(BSON(\"collHash\" << \"default\")), parse(BSONObj()));","+}","+","+TEST_F(CollectionValidationTest, CollHashRejectsInvalidSelection) {","+    auto parse = [&](BSONObj cmd) {","+        return collection_validation::parseValidateOptions(operationContext(), kNss, cmd);","+    };","+    ASSERT_THROWS_CODE(parse(BSON(\"collHash\" << \"md5\")), DBException, ErrorCodes::InvalidOptions);","+    ASSERT_THROWS_CODE(","+        parse(BSON(\"collHash\" << BSONArray())), DBException, ErrorCodes::InvalidOptions);","+    ASSERT_THROWS_CODE(","+        parse(BSON(\"collHash\" << BSON_ARRAY(\"default\"))), DBException, ErrorCodes::InvalidOptions);","+    ASSERT_THROWS_CODE(parse(BSON(\"collHash\" << BSON_ARRAY(\"sha256\" << \"default\"))),","+                       DBException,","+                       ErrorCodes::Invali