ngth: query.length,","+      queryWordCount,","+    })","+  })","+","+  it.each([","+    ['a signed token', `eyJ${'a'.repeat(30)}.eyJ${'b'.repeat(30)}.${'c'.repeat(30)}`],","+    ['a secret key', `sb_secret_${'a'.repeat(22)}_${'b'.repeat(8)}`],","+    ['a letters-only secret under the length limit', `sb_secret_${'a'.repeat(20)}`],","+    ['a project ref', 'abcdefghijklmnopqrst'],","+    ['a connection string', 'postgresql://postgres:hunter2@db.example.com:5432/postgres'],","+    ['an email address', 'person@example.com'],","+    ['a user id', '3f2504e0-4f89-41d3-9a0c-0305e82c3301'],","+    ['a phone number', '+15555550100'],","+    ['a term with digits', 'error 42501'],","+    ['letters-only parts that add up to over the length limit', 'abcdefghijklmn '.repeat(3).trim()],","+  ])('leaves out the text of %s', (_label, rawQuery) => {","+    const description = describeSearchQuery(rawQuery)","+","+    expect(description).not.toHaveProperty('query')","+    expect(description.queryLength).toBe(rawQuery.length)","+  })","+","+  it('leaves out the text of a longer question', () => {","+    expect(describeSearchQuery('how do I set up the supabase mcp server')).toEqual({","+      queryLength: 39,","+      queryWordCount: 9,","+    })","+  })","+","+  it('leaves out pasted multi-word text with a credential', () => {","+    expect(describeSearchQuery('connect fails with password=hunter2 on port 5432')).toEqual({","+      queryLength: 48,","+      queryWordCount: 7,","+    })","+  })","+","+  it('collapses repeated whitespace so a stray double space keeps a keyword a keyword', () => {","+    expect(describeSearchQuery('auth  \\t policies')).toEqual({","+      query: 'auth policies',","+      queryLength: 13,","+      queryWordCount: 2,","+    })","+  })","+","+  it('describes an empty term without text', () => {","+    expect(describeSearchQuery('   ')).toEqual({","+      queryLength: 0,","+      queryWordCount: 0,","+    })","+  })","+})"],"additions":69,"deletions":0,"truncated":false},{"path":"packages/common/search-query-telemetry.ts","lines":["@@ -0,0 +1,18 @@","+import type { SearchQueryProperties } from './telemetry-constants'","+","+const KEYWORD_PATTERN = /^[a-z]{1,16}(?:[ _-][a-z]{1,16}){0,3}$/i","+const MAX_KEYWORD_LENGTH = 40","+","+// People paste credentials and personal data into search boxes, so the text itself is sent","+// only for short letters-only terms: keys, tokens, emails, ids and project refs never match.","+export function describeSearchQuery(rawQuery: string): SearchQueryProperties {","+  const query = rawQuery.trim().replace(/\\s+/g, ' ')","+  const queryWordCount = query ? query.split(/\\s+/).length : 0","+  const isKeyword = query.length <= MAX_KEYWORD_LENGTH && KEYWORD_PATTERN.test(query)","+","+  return {","+    ...(isKeyword && { query }),","+    queryLength: query.length,","+    queryWordCount,","+  }","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"packages/common/telemetry-constants.ts","lines":["@@ -1357,6 +1357,22 @@ export interface DocsSearchV2OpenedEvent {","   }"," }"," ","+/**","+ * How a search term is reported. Free text can contain credentials and personal data, so the","+ * term's text is sent only when it is a short letters-only keyword.","+ */","+export interface SearchQueryProperties {","+  /**","+   * The search term, present only when it is a keyword: up to 4 letters-only parts of at most","+   * 16 letters each, joined by single spaces, hyphens or underscores, 40 characters at most.","+   */","+  query?: string","+  /** Length of the search term, trimmed and with repeated whitespace collapsed. */","+  queryLength: number","+  /** Number of whitespace-separated words in the search term. */","+  queryWordCount: number","+}","+"," /**","  * User's search term was sent to the Search V2 endpoint.","  *","@@ -1365,11 +1381,7 @@ export interface DocsSearchV2OpenedEvent {","  */"," export interface DocsSearchV2SearchSubmittedEvent {","   action: 'docs_search_v2_search_submitted'"