arch term typed into the command menu input","+     * Search term typed into the command menu input, present only when it is a keyword (see","+     * `SearchQueryProperties`)","      */","-    value: string","+    value?: string","     /**","      * In which app the command input was typed","      */","@@ -3431,7 +3432,8 @@ export interface CommandMenuCommandClickedEvent {","      */","     command_section?: string","     /**","-     * The search query that was active when the command was clicked","+     * The search query that was active when the command was clicked, present only when it is","+     * a keyword (see `SearchQueryProperties`)","      */","     search_query?: string","     /**"],"additions":25,"deletions":23,"truncated":false},{"path":"packages/common/telemetry-event.test.ts","lines":["@@ -49,7 +49,7 @@ describe('buildTelemetryEventRequest', () => {","     })","     const other = buildTelemetryEventRequest(API_URL, {","       action: 'kb_search_submitted',","-      properties: { query: 'abc', queryLength: 3, resultCount: 1, hasResults: true },","+      properties: { queryLength: 3, queryWordCount: 1, resultCount: 1, hasResults: true },","     })","     expect(explorer?.body.page_title).toBe('Explorer')","     expect(other?.body.page_title).toBe('Page')","@@ -75,7 +75,7 @@ describe('buildTelemetryEventRequest', () => {","     })","     const submit = buildTelemetryEventRequest(API_URL, {","       action: 'kb_search_submitted',","-      properties: { query: 'abc', queryLength: 3, resultCount: 1, hasResults: true },","+      properties: { queryLength: 3, queryWordCount: 1, resultCount: 1, hasResults: true },","     })","     expect(click?.url).toBe('https://api.example.com/platform/telemetry/event')","     expect(click?.keepalive).toBe(true)","@@ -85,7 +85,7 @@ describe('buildTelemetryEventRequest', () => {","   it(\"adds the app's platform to custom_properties only once it is set\", () => {","     const event = {","       action: 'kb_search_submitted',","-      properties: { query: 'abc', queryLength: 3, resultCount: 1, hasResults: true },","+      properties: { queryLength: 3, queryWordCount: 1, resultCount: 1, hasResults: true },","     } as const","     const unset = buildTelemetryEventRequest(API_URL, event)","     platform.value = 'kb'","@@ -122,7 +122,7 @@ describe('buildTelemetryEventRequest', () => {","   it('builds the same endpoint whether the API URL has a trailing slash or /platform', () => {","     const event = {","       action: 'kb_search_submitted',","-      properties: { query: 'abc', queryLength: 3, resultCount: 1, hasResults: true },","+      properties: { queryLength: 3, queryWordCount: 1, resultCount: 1, hasResults: true },","     } as const","     for (const apiUrl of [","       'https://api.example.com/',","@@ -158,7 +158,7 @@ describe('sendTelemetryEvent', () => {","     consent.value = false","     await sendTelemetryEvent(API_URL, {","       action: 'kb_search_submitted',","-      properties: { query: 'abc', queryLength: 3, resultCount: 1, hasResults: true },","+      properties: { queryLength: 3, queryWordCount: 1, resultCount: 1, hasResults: true },","     })","     expect(post).not.toHaveBeenCalled()","   })"],"additions":5,"deletions":5,"truncated":false},{"path":"packages/common/telemetry-utils.test.ts","lines":["@@ -0,0 +1,66 @@","+// @vitest-environment jsdom","+import { describe, expect, it, vi } from 'vitest'","+","+import {","+  getSharedTelemetryData,","+  redactEventUrlKeywords,","+  redactUrlKeywords,","+} from './telemetry-utils'","+","+// The real module reads window.matchMedia on import, which jsdom does not implement.","+vi.mock('./helpers', () => ({ isBrowser: true }))","+","+const USERS_PAGE = 'https://supabase.com/dashboard/project/abc/auth/users'","+const LEAKING_URL = `${USERS_PAGE}?keywords=person%40example.com`","+const REDACTED_URL = `${USERS_PAGE}?keywords=redacted`","+","+describe('keywords url param redaction', () => {","+  it.each([","+    [LEAKING_URL, REDACTED_URL],","+    [","+      `${USERS_PAGE}?sortBy=id&keywords=jane+doe#row`,","+      `${USERS_PAGE}?sortBy=id&keywords=redacted#row`,","+    ],","+    [`${USERS_PAGE}?mykeywords=abc`, `${USERS_PAGE}?mykeywords=abc`],","+    ['https://example.com/', 'https://example.com/'],","+  ])('redactUrlKeywords(%j)', (url, expected) => {","+    expect(redactUrlKeywords(url)).toBe(expected)","+  })","+","+  it('covers every property bag of an outgoing event and leaves non-strings alone', () => {","+    const event = {","+      properties: {","+        $session_entry_url: LEAKING_URL,","+        viewport_width: 1280,","+        $set: { last_page: LEAKING_URL },","+        $set_once: { $initial_referrer: LEAKING_URL },","+      },","+      $set: { last_page: LEAKING_URL },","+      $set_once: { $initial_current_url: LEAKING_URL },","+    }","+","+    redactEventUrlKeywords(event)","+","+    expect(event).toEqual({","+      properties: {","+        $session_entry_url: REDACTED_URL,","+        viewport_width: 1280,","+        $set: { last_page: REDACTED_URL },","+        $set_once: { $initial_referrer: REDACTED_URL },","+      },","+      $set: { last_page: REDACTED_URL },","+      $set_once: { $initial_current_url: REDACTED_URL },","+    })","+  })","+","+  it('covers the page URL, query string and referrer in the shared telemetry data', () => {","+    window.history.replaceState({}, '', '/project/abc/auth/users?keywords=person%40example.com')","+    Object.defineProperty(document, 'referrer', { value: `${LEAKING_URL}&sortBy=id` })","+","+    const data = getSharedTelemetryData()","+","+    expect(data.page_url).toBe(`${window.location.origin}/project/abc/auth/users?keywords=redacted`)","+    expect(data.ph.search).toBe('?keywords=redacted')","+    expect(data.ph.referrer).toBe(`${REDACTED_URL}&sortBy=id`)","+  })","+})"],"additions":66,"deletions":0,"truncated":false},{"path":"packages/common/telemetry-utils.ts","lines":["@@ -45,19 +45,55 @@ function getPostHogSessionId(): string | null {","   return null"," }"," ","+const KEYWORDS_PARAM_PATTERN = /([?&]keywords=)[^&#]*/g","+","+// Studio's Auth users page keeps its search term, often an end user's email, in `keywords`.","+export function redactUrlKeywords(url: string) {","+  return url.replace(KEYWORDS_PARAM_PATTERN, '$1redacted')","+}","+","+type EventProperties = Record<string, unknown>","+","+// posthog-js fills its own URL properties (session entry URL, initial URL, referrers) from the","+// browser, so the outgoing event is cleaned by value instead of by a list of property names.","+export function redactEventUrlKeywords(event: {","+  properties: EventProperties","+  $set?: EventProperties","+  $set_once?: EventProperties","+}) {","+  const { properties } = event","+  const propertyBags = [","+    properties,","+    properties.$set,","+    properties.$set_once,","+    event.$set,","+    event.$set_once,","+  ]","+","+  for (const bag of propertyBags) {","+    if (!bag || typeof bag !== 'object') continue","+","+    for (const [key, value] of Object.entries(bag)) {","+      if (typeof value === 'string') (bag as EventProperties)[key] = redactUrlKeywords(value)","+    }","+  }","+}","+","+function getPageLocation() {","+  if (!isBrowser) return { pageUrl: '', search: '' }","+","+  try {","+    const url = new URL(window.location.href)","+    url.hash = ''","+    return { pageUrl: redactUrlKeywords(url.href), search: redactUrlKeywords(url.search) }","+  } catch {","+    return { pageUrl: window.location.href.split('#')[0], search: window.location.search }","+  }","+}","+"," export function getSharedTelemetryData(pathname?: string) {","   const sessionId = getPostHogSessionId()","-  const pageUrl = (() => {","-    if (!isBrowser) return ''","-","-    try {","-      const url = new URL(window.location.href)","-      url.hash = ''","-      return url.href","-    } catch {","-      return window.location.href.split('#')[0]","-    }","-  })()","+  const { pageUrl, search } = getPageLocation()"