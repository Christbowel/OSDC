acheSpec{","+\t\t\tArtifact:     v1alpha1.KernelCacheArtifact{ImageReference: \"registry.example/cache@sha256:\" + strings.Repeat(\"a\", 64)},","+\t\t\tNodeGroupRef: &corev1.LocalObjectReference{Name: \"gpu\"},","+\t\t},","+\t}","+\tgroup := &v1alpha1.KernelCacheNodeGroup{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"gpu\"},","+\t\tSpec:       v1alpha1.KernelCacheNodeGroupSpec{NodeSelector: map[string]string{\"role\": \"gpu\"}},","+\t}","+\tnode := &corev1.Node{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"node-a\", Labels: map[string]string{\"role\": \"gpu\", \"kubernetes.io/hostname\": \"node-a\"}},","+\t\tStatus:     corev1.NodeStatus{Conditions: []corev1.NodeCondition{{Type: corev1.NodeReady, Status: corev1.ConditionTrue}}},","+\t}","+\tkernelCacheNode := &v1alpha1.KernelCacheNode{ObjectMeta: metav1.ObjectMeta{Name: node.Name}, Status: v1alpha1.KernelCacheNodeStatus{CacheStatus: map[string]v1alpha1.KernelCacheNodeCacheInfo{","+\t\t\"team/cache\": {State: v1alpha1.KernelCacheNodePreparationStatePending},","+\t}}}","+\tconfigMap := &corev1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Name: constants.InferenceServiceConfigMapName, Namespace: constants.KServeNamespace}, Data: map[string]string{","+\t\t\"kernelcache\": `{\"enabled\":true,\"jobNamespace\":\"jobs\",\"prefetchImage\":\"example/prefetch:latest\"}`,","+\t}}","+\tjobNamespace := &corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: \"jobs\"}}","+\tk8sClient := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(cache).WithObjects(cache, group, node, kernelCacheNode, configMap, jobNamespace).Build()","+\treconciler := &KernelCacheReconciler{Client: k8sClient}","+","+\tif _, err := reconciler.Reconcile(t.Context(), reconcile.Request{NamespacedName: client.ObjectKeyFromObject(cache)}); err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\tupdated := &v1alpha1.KernelCache{}","+\tif err := k8sClient.Get(t.Context(), client.ObjectKeyFromObject(cache), updated); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif 