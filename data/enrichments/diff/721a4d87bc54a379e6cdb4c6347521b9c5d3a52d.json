in a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package reconcilers","+","+import (","+\t\"context\"","+\t\"crypto/sha256\"","+\t\"encoding/hex\"","+\t\"fmt\"","+\t\"strings\"","+","+\tbatchv1 \"k8s.io/api/batch/v1\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha1\"","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+\tkernelcachelabels \"github.com/kserve/kserve/pkg/kernelcache/labels\"","+)","+","+const (","+\tkernelCachePrefetchServiceAccount = \"kernel-cache-prefetcher\"","+\tkernelCachePrefetchManagedLabel   = \"internal.serving.kserve.io/kernelcache-prefetcher\"","+)","+","+func (r *KernelCacheReconciler) checkNamespace(ctx context.Context, name string) error {","+\tnamespace := &corev1.Namespace{}","+\treader := r.Reader","+\tif reader == nil {","+\t\treader = r.Client","+\t}","+\tif err := reader.Get(ctx, client.ObjectKey{Name: name}, namespace); err != nil {","+\t\tif apierrors.IsNotFound(err) {","+\t\t\treturn fmt.Errorf(\"job namespace %q was not found; create it before using KernelCache\", name)","+\t\t}","+\t\treturn err","+\t}","+\treturn nil","+}","+","+func (r *KernelCacheReconciler) ensurePrefetchServiceAccount(ctx context.Context, namespace string) error {","+\tautomount := false","+\tdesired := &corev1.ServiceAccount{ObjectMeta: metav1.ObjectMeta{","+\t\tName:      kernelCachePrefetchServiceAccount,","+\t\tNamespace: namespace,","+\t\tLabels:    map[string]string{kernelCachePrefetchManagedLabel: \"true\"},","+\t}, AutomountServiceAccountToken: &automount}","+","+\tcurrent := &corev1.ServiceAccount{}","+\terr := r.Get(ctx, client.ObjectKeyFromObject(desired), current)","+\tif apierrors.IsNotFound(err) {","+\t\treturn r.Create(ctx, desired)","+\t}","+\tif err != nil {","+\t\treturn err","+\t}","+\tif current.Labels[kernelCachePrefetchManagedLabel] != \"true\" {","+\t\treturn fmt.Errorf(\"reserved ServiceAccount %s/%s already exists and is not managed by KernelCache\", namespace, kernelCachePrefetchServiceAccount)","+\t}","+\tif current.AutomountServiceAccountToken == nil || *current.AutomountServiceAccountToken {","+\t\treturn fmt.Errorf(\"managed ServiceAccount %s/%s must disable token automount\", namespace, kernelCachePrefetchServiceAccount)","+\t}","+\treturn nil","+}","+","+func (r *KernelCacheReconciler) ensureOCIPrefetchJobs(","+\tctx context.Context,","+\tkernelCache *v1alpha1.KernelCache,","+\tnodeGroup *v1alpha1.KernelCacheNodeGroup,","+\treadyNodes *corev1.NodeList,","+\tconfig *v1beta1.KernelCacheConfig,","+) error {","+\tfor i := range readyNodes.Items {","+\t\tif err := r.ensureOCIPrefetchJob(ctx, kernelCache, nodeGroup, &readyNodes.Items[i], config); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+\treturn nil","+}","+","+func (r *KernelCacheReconciler) ensureOCIPrefetchJob(","+\tctx context.Context,","+\tkernelCache *v1alpha1.KernelCache,","+\tnodeGroup *v1alpha1.KernelCacheNodeGroup,","+\tnode *corev1.Node,","+\tconfig *v1beta1.KernelCacheConfig,","+) error {","+\tkernelCacheNode := &v1alpha1.KernelCacheNode{}","+\tif err := r.Get(ctx, client.ObjectKey{Name: node.Name}, kernelCacheNode); err == nil {","+\t\tcacheInfo, exists := kernelCacheNode.Status.CacheStatus[kernelCache.Namespace+\"/\"+kernelCache.Name]","+\t\tif !exists {","+\t\t\treturn nil","+\t\t}","+\t\tif cacheInfo.State == v1alpha1.KernelCacheNodePreparationStateReady &&","+\t\t\tcacheInfo.ImageReference == kernelCache.Spec.Artifact.ImageReference &&","+\t\t\tcacheInfo.Footprints == kernelCache.Spec.Artifact.Identity.Footprints {","+\t\t\treturn nil","+\t\t}","+\t} else if apierrors.IsNotFound(err) {","+\t\treturn nil","+\t} else {","+\t\treturn err","+\t}","+","+\tjobName := kernelCachePrefetchJobName(kernelCache, node)","+\tjob := &batchv1.Job{}","+\tif err := r.Get(ctx, client.ObjectKey{Name: jobName, Namespace: config.JobNamespace}, job); err == nil {","+\t\treturn nil","+\t} else if !apierrors.IsNotFound(err) {","+\t\treturn err","+\t}","+","+\tmetadata := kernelcachelabels.ObjectMeta(kernelCache.Name, kernelCache.Namespace, node.Name)","+\tjob = &batchv1.Job{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:        jobName,","+\t\t\tNamespace:   config.JobNamespace,","+\t\t\tLabels:      metadata.Labels,","+\t\t\tAnnotations: metadata.Annotations,","+\t\t},","+\t\tSpec: batchv1.JobSpec{","+\t\t\tTTLSecondsAfterFinished: kernelCacheJobTTL(config),","+\t\t\tTemplate: corev1.PodTemplateSpec{","+\t\t\t\tObjectMeta: metav1.ObjectMeta{Labels: metadata.Labels, Annotations: metadata.Annotations},","+\t\t\t\tSpec: corev1.PodSpec{","+\t\t\t\t\tRestartPolicy:      corev1.RestartPolicyNever,","+\t\t\t\t\tServiceAccountName: kernelCachePrefetchServiceAccount,","+\t\t\t\t\tNodeSelector:       map[string]string{\"kubernetes.io/hostname\": nodeHostname(node)},","+\t\t\t\t\tTolerations:        append([]corev1.Toleration(nil), nodeGroup.Spec.Tolerations...),","+\t\t\t\t\tContainers: []corev1.Container{{","+\t\t\t\t\t\tName:            \"kernel-cache-prefetch\",","+\t\t\t\t\t\tImage:           config.PrefetchImage,","+\t\t\t\t\t\tImagePullPolicy: corev1.PullIfNotPresent,","+\t\t\t\t\t\tCommand:         []string{\"/bin/sh\", \"-c\", \"test -d /mnt/kernel-cache\"},","+\t\t\t\t\t\tVolumeMounts:    []corev1.VolumeMount{{Name: \"kernel-cache\", MountPath: \"/mnt/kernel-cache\", ReadOnly: true}},","+\t\t\t\t\t}},","+\t\t\t\t\tVolumes: []corev1.Volume{{Name: \"kernel-cache\", VolumeSource: corev1.VolumeSource{","+\t\t\t\t\t\tImage: &corev1.ImageVolumeSource{Reference: kernelCache.Spec.Artifact.ImageReference, PullPolicy: corev1.PullIfNotPresent},","+\t\t\t\t\t}}},","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t}","+\tautomount := false","+\tjob.Spec.Template.Spec.AutomountServiceAccountToken = &automount","+\tif err := r.Create(ctx, job); err != nil && !apierrors.IsAlreadyExists(err) {","+\t\treturn err","+\t}","+\treturn nil","+}","+","+func kernelCachePrefetchJobName(kernelCache *v1alpha1.KernelCache, node *corev1.Node) string {","+\tkey := kernelCache.Namespace + \"/\" + kernelCache.Name + \"/\" + kernelCache.Spec.Artifact.ImageReference + \"/\" + node.Name","+\thash := sha256.Sum256([]byte(key))","+\treturn fmt.Sprintf(\"kc-%s-%s-%s\", readableJobNamePart(kernelCache.Name, 24), readableJobNamePart(node.Name, 18), hex.EncodeToString(hash[:])[:16])","+}","+","+func readableJobNamePart(value string, maxLength int) string {","+\tvalue = strings.ReplaceAll(strings.ToLower(value), \".\", \"-\")","+\tif len(value) > maxLength {","+\t\tvalue = value[:maxLength]","+\t}","+\tvalue = strings.Trim(value, \"-.\")","+\tif value == \"\" {","+\t\treturn \"unknown\"","+\t}","+\treturn value","+}","+","+func kernelCacheJobTTL(config *v1beta1.KernelCacheConfig) *int32 {","+\tif config.JobTTLSecondsAfterFinished != nil {","+\t\treturn config.JobTTLSecondsAfterFinished","+\t}","+\tttl := v1beta1.DefaultKernelCacheJobTTLSeconds","+\treturn &ttl","+}","+","+func nodeHostname(node *corev1.Node) string {","+\tif hostname := node.Labels[\"kubernetes.io/hostname\"]; hostname != \"\" {","+\t\treturn hostname","+\t}","+\treturn node.Name","+}"],"additions":199,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha1/kernelcache/reconcilers/cache_reconciler.go","lines":["@@ -0,0 +1,132 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package reconcilers","+","+import (","+\t\"context\"","+\t\"fmt\"","+","+\t\"github.com/go-logr/logr\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tctrl \"sigs.k8s.io/controller-runtime\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha1\"","+\tkernelcacheconfig \"github.com/kserve/kserve/pkg/kernelcache/config\"","+\t\"github.com/kserve/kserve/pkg/kernelcache/nodegroup\"","+)","+","+// KernelCacheReconciler prepares KernelCache artifacts on the selected nodes.","+// Capture and registry credential flows are integrated by later controllers.","+type KernelCacheReconciler struct {","+\tclient.Client","+\tReader client.Reader","+\tLog    logr.Logger","+}","+","+const (","+\tkernelCacheReadyConditionType = \"Ready\"","+\treasonNodeGroupNotFound       = \"NodeGroupNotFound\"","+\treasonNoMatchingNodes         = \"NoMatchingNodes\"","+\treasonNoReadyNodes            = \"NoReadyNodes\"","+\treasonConfigError             = \"ConfigError\"","+\treasonFeatureDisabled         = \"FeatureDisabled\"","+\treasonStorageError            = \"StorageError\"","+\treasonWaitingForPreparation   = \"WaitingForPreparation\"","+\treasonPreparing               = \"Preparing\"","+\treasonCacheReady              = \"CacheReady\"","+\treasonPreparationFailed       = \"PreparationFailed\"","+)","+","+func (r *KernelCacheReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {","+\tkernelCache := &v1alpha1.KernelCache{}","+\tif err := r.Get(ctx, req.NamespacedName, kernelCache); err != nil {","+\t\tif apierrors.IsNotFound(err) {","+\t\t\treturn ctrl.Result{}, nil","+\t\t}","+\t\treturn ctrl.Result{}, err","+\t}","+\tif !kernelCache.DeletionTimestamp.IsZero() {","+\t\treturn ctrl.Result{}, nil","+\t}","+","+\tconfig, err := kernelcacheconfig.Load(ctx, r.Client)","+\tif err != nil {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, 0, reasonConfigError, err.Error(), kernelCache.Spec.MountType)","+\t}","+\tmountType := kernelCache.Spec.MountType","+\tif mountType == \"\" {","+\t\tmountType = v1alpha1.KernelCacheMountType(config.DefaultMountType)","+\t}","+\tif mountType != v1alpha1.KernelCacheMountTypeOCI {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, 0, reasonConfigError, fmt.Sprintf(\"unsupported KernelCache mount type %q\", mountType), mountType)","+\t}","+\tif !config.Enabled {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStatePending, 0, reasonFeatureDisabled, \"kernel cache is disabled in inferenceservice-config\", mountType)","+\t}","+","+\tif err := r.reconcileKernelCacheUsage(ctx, kernelCache); err != nil {","+\t\treturn ctrl.Result{}, err","+\t}","+","+\tnodeGroupName := kernelCacheNodeGroupName(kernelCache, config.DefaultNodeGroup)","+\tif nodeGroupName == \"\" {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, 0, reasonNodeGroupNotFound, \"nodeGroupRef.name is required and default node group is not specified\", mountType)","+\t}","+\tnodeGroup := &v1alpha1.KernelCacheNodeGroup{}","+\tif err := r.Get(ctx, client.ObjectKey{Name: nodeGroupName}, nodeGroup); err != nil {","+\t\tif apierrors.IsNotFound(err) {","+\t\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, 0, reasonNodeGroupNotFound, \"referenced KernelCacheNodeGroup was not found\", mountType)","+\t\t}","+\t\treturn ctrl.Result{}, err","+\t}","+","+\treadyNodes, notReadyNodes, err := nodegroup.GetNodes(ctx, nodeGroup, r.Client)","+\tif err != nil {","+\t\treturn ctrl.Result{}, err","+\t}","+\tmatchingNodeCount := len(readyNodes.Items) + len(notReadyNodes.Items)","+\tif matchingNodeCount == 0 {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStatePending, 0, reasonNoMatchingNodes, \"no nodes match the referenced KernelCacheNodeGroup\", mountType)","+\t}","+\tif len(readyNodes.Items) == 0 {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStatePending, 0, reasonNoReadyNodes, \"matching nodes are not ready\", mountType)","+\t}","+","+\tif err := r.checkNamespace(ctx, config.JobNamespace); err != nil {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, len(readyNodes.Items), reasonStorageError, err.Error(), mountType)","+\t}","+\tif err := r.ensurePrefetchServiceAccount(ctx, config.JobNamespace); err != nil {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, len(readyNodes.Items), reasonStorageError, err.Error(), mountType)","+\t}","+\tif err := r.ensureOCIPrefetchJobs(ctx, kernelCache, nodeGroup, readyNodes, config); err != nil {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, len(readyNodes.Items), reasonStorageError, err.Error(), mountType)","+\t}","+","+\taggregate, err := r.aggregateKernelCacheStatus(ctx, kernelCache, readyNodes)","+\tif err != nil {","+\t\treturn ctrl.Result{}, r.updateStatus(ctx, kernelCache, v1alpha1.KernelCacheStateError, len(readyNodes.Items), reasonStorageError, err.Error(), mountType)","+\t}","+\treturn ctrl.Result{}, r.updateStatusWithCounts(ctx, kernelCache, aggregate.State, aggregate.NodeCount, aggregate.NodesReady, aggregate.NodesPreparing, aggregate.NodesError, aggregate.Reason, aggregate.Message, mountType)","+}","+","+func kernelCacheNodeGroupName(kernelCache *v1alpha1.KernelCache, defaultNodeGroup string) string {","+\tif k