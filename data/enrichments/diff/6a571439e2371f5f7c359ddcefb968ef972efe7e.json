f helpers.IsTLSPassthroughListener(&l) {","+\t\t\treturn nil, fmt.Errorf(\"TLS option %s is not supported on TLS passthrough listeners\", key)","+\t\t}","+","+\t\tswitch key {","+\t\tcase model.TLSOptionsMinVersion:","+\t\t\tparsed.MinVersion = string(value)","+\t\tcase model.TLSOptionsMaxVersion:","+\t\t\tparsed.MaxVersion = string(value)","+\t\tdefault:","+\t\t\treturn nil, fmt.Errorf(\"TLS Option %s is not supported\", key)","+\t\t}","+","+\t\tif _, ok := supportedTLSVersions[string(value)]; !ok {","+\t\t\treturn nil, fmt.Errorf(\"TLS Value %s is not supported in %s\", value, key)","+\t\t}","+\t}","+","+\tmin := model.TLSOptionsDefaultMinVersion","+\tif parsed.MinVersion != \"\" {","+\t\tmin = parsed.MinVersion","+\t}","+","+\tmax := model.TLSOptionsDefaultMaxVersion","+\tif parsed.MaxVersion != \"\" {","+\t\tmax = parsed.MaxVersion","+\t}","+","+\tif supportedTLSVersions[min] > supportedTLSVersions[max] {","+\t\treturn nil, fmt.Errorf(\"TLS minimum version %s must not exceed maximum version %s\", min, max)","+\t}","+","+\tif parsed.MinVersion == \"\" && parsed.MaxVersion == \"\" {","+\t\treturn nil, nil","+\t}","+","+\treturn parsed, nil","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"operator/pkg/gateway-api/status_listener_tls_options_test.go","lines":["@@ -0,0 +1,135 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package gateway_api","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\tgatewayv1 \"sigs.k8s.io/gateway-api/apis/v1\"","+","+\t\"github.com/cilium/cilium/operator/pkg/model\"","+)","+","+func TestParseTLSOptions(t *testing.T) {","+\ttests := []struct {","+\t\tname        string","+\t\toptions     map[gatewayv1.AnnotationKey]gatewayv1.AnnotationValue","+\t\tpassthrough bool","+\t\twantErr     bool","+\t\twantOptions *model.TLSOptions","+\t}{","+\t\t{","+\t\t\tname: \"no options set\",","+\t\t},","+\t\t{","+\t\t\tname: \"min only\",","+\t\t\toptions: map[gatewayv1.