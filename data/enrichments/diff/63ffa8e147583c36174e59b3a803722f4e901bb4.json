"AQ\", \"y\":\"AQ\"}), vec![Algorithm::ES384]),","+            (json!({\"kty\":\"EC\", \"crv\":\"P-521\", \"x\":\"AQ\", \"y\":\"AQ\"}), vec![]),","+            (json!({\"kty\":\"OKP\", \"crv\":\"Ed25519\", \"x\":\"AQ\"}), vec![Algorithm::EdDSA]),","+            (json!({\"kty\":\"OKP\", \"crv\":\"P-256\", \"x\":\"AQ\"}), vec![]),","+            (json!({\"kty\":\"oct\", \"k\":\"c2VjcmV0\"}), vec![Algorithm::HS256, Algorithm::HS384, Algorithm::HS512]),","+        ] {","+            let mut parameters = parameters;","+            parameters[\"kid\"] = json!(\"test\");","+            let jwk: Jwk = serde_json::from_value(parameters).unwrap();","+            let (_, info) = decode_jwk(&jwk, &policy, true).unwrap();","+            assert_eq!(info.validation.algorithms, expected);","+","+            let mut deny_all = policy.clone();","+            deny_all.algorithms.clear();","+            let (_, info) = decode_jwk(&jwk, &deny_all, true).unwrap();","+            assert!(info.validation.algorithms.is_empty());","+        }","+    }","+","     #[test]","     fn test_decode_jwk_rejects_symmetric_by_default() {","         // valid base64url of \"secret\""],"additions":54,"deletions":17,"truncated":false},{"path":"crates/jwt-auth/tests/fixtures/oidc-rsa-modulus.bin","lines":["@@ -0,0 +1 @@","+�K\u0019\u000e�<@���[���� h=�2&���S�\u000f�\u0006\u000bܖ4����\u001a^���\u0015�D\u0016��d[�\u0017�K��R2�t1��:\fr���#\u00148�'�1��Kiތ�0\u0001�G�̟�k.ʦ�\u0001$_�z��p�\f+\u0006���f�V�mv\u0006�X\tu� t\u0006�*\u00100\b]\u0011k\t����\\Ļ�0��l@�ҁ����Y_n��[�A�Ȋ7��YǼI��k���\r[uK\u0013����O�/��4<4��2+j\u0014h_�!OA��\u001a=6j)��s�\u000b��ƷG\"�\"`DJ$=�\b�+\u001e�\u0011YBZ����<Fk\u0001!","\\ No newline at end of file"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/tests/fixtures/oidc-rsa.pem","lines":["@@ -0,0 +1,28 @@","+-----BEGIN PRIVATE KEY-----","+MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDKSxkOmzxAkaPk","+W6TwuujmIGg9xjIm4f+mU8IPsAYL3JY0r8jM7rcaXoiW+hXgRBb/3GRb5Re