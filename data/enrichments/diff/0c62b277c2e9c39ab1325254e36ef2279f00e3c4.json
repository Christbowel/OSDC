{"id":"0c62b277c2e9c39ab1325254e36ef2279f00e3c4","axis":"silent","repo":"ueberdosis/tiptap","sha":"0c62b277c2e9c39ab1325254e36ef2279f00e3c4","parsed":{"files":[{"path":".changeset/2026-10-17-editor-lifecycle.md","lines":["@@ -0,0 +1,9 @@","+---","+'@tiptap/core': major","+'@tiptap/react': major","+'@tiptap/vue': major","+---","+","+Keep unmounted editors alive and build React and Vue NodeViews once per mount. Unmounting preserves the document, selection, and plugins. Autofocus runs only on the first mount. Repeated mounts at the same element and repeated unmounts do nothing. Destroyed editors cannot mount again.","+","+Migration: use `editor.isMounted` before reading view DOM. `editor.isDestroyed` is true only after `destroy()`. React `useEditor` and Vue `Editor` now wait for `EditorContent` to mount the view by default. For a view without `EditorContent`, pass an `element` or call `editor.mount(element)`. Use `unmount()` for temporary removal and `destroy()` for final cleanup. Mount and unmount events now follow `EditorContent` attachment and removal."],"additions":9,"deletions":0,"truncated":false},{"path":".changeset/2026-10-17-table-of-contents-mount.md","lines":["@@ -0,0 +1,5 @@","+---","+'@tiptap/extension-table-of-contents': patch","+---","+","+Skip table of contents updates until the editor is mounted."],"additions":5,"deletions":0,"truncated":false},{"path":"demos/src/Experiments/CollaborationAnnotation/Vue/index.vue","lines":["@@ -101,6 +101,7 @@ onMounted(() => {"," ","   clients.value = documents.map((document, index) => {","     const editor = new Editor({","+      element: window.document.createElement('div'),","       extensions: [","         StarterKit.configure({ undoRedo: false }),","         Image,"],"additions":1,"deletions":0,"truncated":false},{"path":"demos/src/GuideNodeViews/ReactComponentContent/React/index.jsx","lines":["@@ -2,11 +2,12 @@ import './styles.scss'"," "," import { EditorContent, useEditor } from '@tiptap/react'"," import Starte