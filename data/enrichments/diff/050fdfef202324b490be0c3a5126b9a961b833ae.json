r, sentinel error, wantCategory, wantReason string, wantStatus int, wantMessage string) {","+\tt.Helper()","+","+\trequire.ErrorIs(t, err, sentinel)","+","+\tcategory, reason := server.ClassifyFailure(err)","+\trequire.Equal(t, wantCategory, category)","+\trequire.Equal(t, wantReason, reason)","+","+\tstatus, clientErr := server.ClientHTTPStatusAndError(err)","+\trequire.Equal(t, wantStatus, status)","+\trequire.Equal(t, wantMessage, clientErr.Error())","+}","+","+// Test_MaxQueryParallelismDisableClassification pins the classification of the","+// 429 the frontend returns when a tenant has no query parallelism left.","+func Test_MaxQueryParallelismDisableClassification(t *testing.T) {","+\th := queryrangebase.HandlerFunc(func(_ context.Context, _ queryrangebase.Request) (queryrangebase.Response, error) {","+\t\treturn queryrangebase.NewEmptyPrometheusResponse(model.ValMatrix), nil","+\t})","+\t// The queryData value statsHTTPMiddleware installs marks this as a real user","+\t// query, which is what makes the failed-query usage line eligible.","+\tdata := &queryData{}","+\tctx := user.InjectOrgID(context.WithValue(context.Background(), ctxKey, data), \"foo\")","+","+\tlines := captureFailedQueryUsage(t)","+\tcountBefore := failedQueryUsageCount(t, server.FailureThrottled)","+","+\tquery := `{app=\"foo\"} |= \"bar\"`","+\t_, err := NewLimitedRoundTripper(h, fakeLimits{maxQueryParallelism: 0},","+\t\ttestSchemas,","+\t\tqueryrangebase.MiddlewareFunc(func(next queryrangebase.Handler) queryrangebase.Handler {","+\t\t\treturn next","+\t\t}),","+\t).Do(ctx, &LokiRequest{Query: query, StartTs: testTime.Add(-time.Hour), EndTs: testTime})","+\trequire.Error(t, err)","+","+\trequireSentinelClassification(t, err, logqlmodel.ErrMaxQueryParallelism,","+\t\tserver.FailureThrottled, \"max_query_parallelism\",","+\t\thttp.StatusTooManyRequests, \"querying is disabled, please contact your Loki operator\")","+","+\t// Rejected before the wrapped middleware chain runs, but still reported.","+\tline := lines.only(t)","+\trequireFailedQueryUsageShape(t, line)","+\trequire.Equal(t, query, line[\"query\"])","+\trequire.Equal(t, fmt.Sprint(util.HashedQuery(query)), line[\"query_hash\"])","+\trequire.Equal(t, logql.QueryTypeFilter, line[\"query_type\"])","+\trequire.Equal(t, string(logql.RangeType), line[\"range_type\"])","+\trequire.Equal(t, time.Hour.String(), line[\"length\"])","+\trequire.Equal(t, \"429\", line[\"status\"])","+\trequire.Equal(t, \"0B\", line[\"total_bytes\"])","+\trequire.Equal(t, server.FailureThrottled, line[\"failure_category\"])","+\trequire.Equal(t, \"max_query_parallelism\", line[\"failure_reason\"])","+\trequire.Equal(t, \"foo\", line[\"org_id\"])","+\trequire.Equal(t, countBefore+1, failedQueryUsageCount(t, server.FailureThrottled))","+\trequire.False(t, data.recorded)","+}","+","+// Test_MaxQueryParallelismNoUsageLineForMetadataQuery pins the type gate on the","+// pre-chain path: series queries also go through NewLimitedRoundTripper, but","+// they carry no query usage bytes, so they get no line.","+func Test_MaxQueryParallelismNoUsageLineForMetadataQuery(t *testing.T) {","+\th := queryrangebase.HandlerFunc(func(_ context.Context, _ queryrangebase.Request) (queryrangebase.Response, error) {","+\t\treturn queryrangebase.NewEmptyPrometheusResponse(model.ValMatrix), nil","+\t})","+\tctx := user.InjectOrgID(context.WithValue(context.Background(), ctxKey, &queryData{}), \"foo\")","+","+\tlines := captureFailedQueryUsage(t)","+\tcountBefore := failedQueryUsageCount(t, server.FailureThrottled)","+","+\t_, err := NewLimitedRoundTripper(h, fakeLimits{maxQueryParallelism: 0},","+\t\ttestSchemas,","+\t\tqueryrangebase.MiddlewareFunc(func(next queryrangebase.Handler) queryrangebase.Handler {","+\t\t\treturn next","+\t\t}),","+\t).Do(ctx, &LokiSeriesRequest{Match: []string{`{app=\"foo\"}`}, StartTs: testTime.Add(-time.Hour), EndTs: testTime})","+","+\trequireSentinelClassification(t, err, logqlmodel.ErrMaxQueryParallelism,","+\t\tserver.FailureThrottled, \"max_query_parallelism\",","+\t\thttp.StatusTooManyRequests, \"querying is disabled, please contact your Loki operator\")","+\trequire.Empty(t, lines.all())","+\trequire.Equal(t, countBefore, failedQueryUsageCount(t, server.FailureThrottled))","+}","+","+// Test_MaxQueryLengthClassification drives the real limitsMiddleware, where","+// max_query_length is enforced, and pins the classification of its rejection.","+func Test_MaxQueryLengthClassification(t *testing.T) {","+\tcalled := false","+\th := queryrangebase.HandlerFunc(func(context.Context, queryrangebase.Request) (queryrangebase.Response, error) {","+\t\tcalled = true","+\t\treturn nil, nil","+\t})","+","+\tctx := user.InjectOrgID(context.Background(), \"1\")","+\t_, err := NewLimitsMiddleware(fakeLimits{maxQueryLength: 24 * time.Hour}).Wrap(h).Do(ctx, &LokiRequest{","+\t\tQuery:   `{app=\"foo\"}`,","+\t\tStartTs: testTime.Add(-48 * time.Hour),","+\t\tEndTs:   testTime,","+\t\tPath:    \"/loki/api/v1/query_range\",","+\t})","+\trequire.Error(t, err)","+\trequire.False(t, called)","+","+\trequireSentinelClassification(t, err, logqlmodel.ErrMaxQueryLength,","+\t\tserver.FailureLimit, \"max_query_length\",","+\t\thttp.StatusBadRequest, \"the query time range exceeds the limit (query length: 48h0m0s, limit: 1d)\")","+}","+"," func Test_MaxQueryLookBack(t *testing.T) {"," \ttpw, stopper, err := NewMiddleware(testConfig, testEngineOpts, RouterConfig{}, nil, util_log.Logger, fakeLimits{"," \t\tmaxQueryLookback:    1 * time.Hour,"],"additions":114,"deletions":0,"truncated":false},{"path":"pkg/querier/queryrange/querysharding.go","lines":["@@ -133,18 +133,18 @@ func (ast *astMapperware) checkQuerySizeLimit(ctx context.Context, bytesPerShard"," \t\tstatsBytesStr := humanize.IBytes(bytesPerShard)"," \t\tmaxBytesReadStr := humanize.IBytes(uint64(maxBytesRead))"," ","-\t\tif bytesPerShard > uint64(maxBytesRead) {","-\t\t\tlevel.Warn(ast.logger).Log(\"msg\", \"Query exceeds limits\", \"status\", \"rejected\", \"limit_name\", \"MaxQuerierBytesRead\", \"limit_bytes\", maxBytesReadStr, \"resolved_bytes\", statsBytesStr)","+\t\tspec := maxQuerierBytesReadShardableSpec","+\t\tif notShardable {","+\t\t\tspec = maxQuerierBytesReadUnshardableSpec","+\t\t}"," ","-\t\t\terrorTmpl := limErrQuerierTooManyBytesShardableTmpl","-\t\t\tif notShardable {","-\t\t\t\terrorTmpl = limErrQuerierTooManyBytesUnshardableTmpl","-\t\t\t}","+\t\tif bytesPerShard > uint64(maxBytesRead) {","+\t\t\tlevel.Warn(ast.logger).Log(\"msg\", \"Query exceeds limits\", \"status\", \"rejected\", \"limit_name\", spec.limitName, \"limit_bytes\", maxBytesReadStr, \"resolved_bytes\", statsBytesStr)"," ","-\t\t\treturn httpgrpc.Errorf(http.StatusBadRequest, errorTmpl, statsBytesStr, maxBytesReadStr)","+\t\t\treturn spec.exceededErr(statsBytesStr, maxBytesReadStr)"," \t\t}"," ","-\t\tlevel.Debug(ast.logger).Log(\"msg\", \"Query is within limits\", \"status\", \"accepted\", \"limit_name\", \"MaxQuerierBytesRead\", \"limit_bytes\", maxBytesReadStr, \"resolved_bytes\", statsBytesStr)","+\t\tlevel.Debug(ast.logger).Log(\"msg\", \"Query is within limits\", \"status\", \"accepted\", \"limit_name\", spec.limitName, \"limit_bytes\", maxBytesReadStr, \"resolved_bytes\", statsBytesStr)"," \t}"," "," \treturn nil","@@ -254,6 +254,10 @@ func (ast *astMapperware) Do(ctx context.Context, r queryrangebase.Request) (que"," "," \tres, err := query.Exec(ctx)"," \tif err != nil {","+\t\t// Keep the usage of the shards and index lookups that completed before","+\t\t// the failure.","+\t\tstats.JoinPartial(ctx, res.Statistics)","+\t\tstats.JoinPartial(ctx, resolverStats.Result(0, 0, 0))"," \t\treturn nil, err"," \t}"," "],"additions":12,"deletions":8,"truncated":false},{"path":"pkg/querier/queryrange/querysharding_partial_test.go","lines":["@@ -0,0 +1,234 @@","+package queryrange","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"math\"","+\t\"net/http\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/grafana/dskit/httpgrpc\"","+\t\"github.com/grafana/dskit/user\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.uber.org/atomic\"","+","+\t\"github.com/grafana/loki/v3/pkg/loghttp\"","+\t\"github.com/grafana/loki/v3/pkg/logproto\"","+\t\"github.com/grafana/loki/v3/pkg/logql/syntax\"","+\t\"github.com/grafana/loki/v3/pkg/logqlmodel\"","+\t\"github.com/grafana/loki/v3/pkg/logqlmodel/stats\"","+\t\"github.com/grafana/loki/v3/pkg/querier/plan\"","+\t\"github.com/grafana/loki/v3/pkg/querier/queryrange/queryrangebase\"","+\t\"github.com/grafana/loki/v3/pkg/storage/config\"","+\t\"github.com/grafana/loki/v3/pkg/storage/types\"","+\t\"github.com/grafana/loki/v3/pkg/util\"","+\t\"github.com/grafana/loki/v3/pkg/util/server\"","+)","+","+// TestASTMapperware_PartialStatsOnError runs a two-leg sharded query where the","+// left leg completes while the right leg fails. The completed leg's usage is not","+// part of the failing Downstream call's results, so without the partial-stats","+// collector it would be dropped along with the engine result.","+func TestASTMapperware_PartialStatsOnError(t *testing.T) {","+\tconst (","+\t\tbytesPerShard = 1000","+\t\tshardsPerLeg  = 2","+\t)","+","+\tlimitErr := wrapErr(logqlmodel.ErrQuerierTooManyBytes, httpgrpc.Errorf(http.StatusBadRequest, \"query too large to execute on a single querier: (query: 5GB, limit: 1GB)\"))","+","+\tvar (","+\t\tleftCalls   atomic.Int64","+\t\tgateTimeout atomic.Bool","+\t)","+","+\thandler := queryrangebase.HandlerFunc(func(_ context.Context, req queryrangebase.Request) (queryrangebase.Response, error) {","+\t\tif _, ok := req.(*logproto.IndexStatsRequest); ok {","+\t\t\treturn &IndexStatsResponse{","+\t\t\t\tResponse: &logproto.IndexStatsResponse{Bytes: 1 << 40},","+\t\t\t}, nil","+\t\t}","+","+\t\tif strings.Contains(req.GetQuery(), `app=\"left\"`) {","+\t\t\tleftCalls.Add(1)","+\t\t\treturn &LokiPromResponse{","+\t\t\t\tResponse: &queryrangebase.PrometheusResponse{","+\t\t\t\t\tData: queryrangebase.PrometheusData{","+\t\t\t\t\t\tResultType: loghttp.ResultTypeVector,","+\t\t\t\t\t\tResult: []queryrangebase.SampleStream{{","+\t\t\t\t\t\t\tLabels:  []logproto.LabelAdapter{{Name: \"foo\", Value: \"bar\"}},","+\t\t\t\t\t\t\tSamples: []logproto.LegacySample{{Value: 10, TimestampMs: 10}},","+\t\t\t\t\t\t}},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t\tStatistics: stats.Result{","+\t\t\t\t\tQuerier: stats.Querier{Store: stats.Store{Chunk: stats.Chunk{DecompressedBytes: bytesPerShard}}},","+\t\t\t\t},","+\t\t\t}, nil","+\t\t}","+","+\t\t// Right leg: fail only once every left-leg shard has been served, which is","+\t\t// the case this test is about. The gate is the test's own counter rather","+\t\t// than the engine statistics: production never reads a stats Context","+\t\t// mid-flight, so a test that did would be racing on its own.","+\t\tdeadline := time.Now().Add(10 * time.Second)","+\t\tfor leftCalls.Load() < shardsPerLeg {","+\t\t\tif time.Now().After(deadline) {","+\t\t\t\tgateTimeout.Store(true)","+\t\t\t\tbreak","+\t\t\t}","+\t\t\ttime.Sleep(time.Millisecond)","+\t\t}","+\t\t// Give the last left response time to reach its accumulator, so the common","+\t\t// case is a fully completed leg. The assertion below tolerates losing the","+\t\t// race, so this only sharpens the test, it does not decide it.","+\t\ttime.Sleep(50 * time.Millisecond)","+\t\treturn nil, limitErr","+\t})","+","+\tmware := newASTMapperware(","+\t\tShardingConfigs{config.PeriodConfig{IndexType: types.IndexTypeTSDB}},","+\t\ttestEngineOpts,","+\t\thandler,","+\t\thandler,","+\t\thandler,","+\t\tlog.NewNopLogger(),","+\t\tnilShardingMetrics,","+\t\tfakeLimits{","+\t\t\tmaxSeries:               math.MaxInt32,","+\t\t\tmaxQueryParallelism:     4,","+\t\t\ttsdbMaxQueryParallelism: 4,","+\t\t\tqueryTimeout:            time.Minute,","+\t\t},","+\t\tshardsPerLeg,","+\t\t[]string{},","+\t)","+","+\tquery := `count_over_time({app=\"left\"}[1h]) / count_over_time({app=\"right\"}[1h])`","+\treq := defaultReq()","+\treq.Query = query","+\treq.Plan = &plan.QueryPlan{AST: syntax.MustParseExpr(query)}","+","+\tdata := &queryData{}","+\tctx := user.InjectOrgID(context.WithValue(context.Background(), ctxKey, data), \"1\")","+","+\tlines := captureFailedQueryUsage(t)","+\tcountBefore := failedQueryUsageCount(t, server.FailureLimit)","+","+\t_, err := StatsCollectorMiddleware().Wrap(mware).Do(ctx, req)","+\trequire.ErrorIs(t, err, logqlmodel.ErrQuerierTooManyBytes)","+\trequire.False(t, gateTimeout.Load(), \"the left leg never completed, the test did not exercise the intended path\")","+\trequire.Equal(t, int64(shardsPerLeg), leftCalls.Load())","+","+\tline := lines.only(t)","+\trequireFailedQueryUsageShape(t, line)","+\t// How much of the completed leg is reported depends on how many of its","+\t// responses were accumulated before the failing leg cancelled it, so accept"],"additions":129,"deletions":0,"truncated":false}],"additions":418,"deletions":44,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-08-20T08:33:08.352972+00:00"}