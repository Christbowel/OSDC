rator_wrapped(%[[P0]], %[[P1]]) : (tensor<f32>, tensor<f32>) -> i1","+// CHECK:         return %[[RES]] : i1","+// CHECK:       }","+// CHECK:       func.func private @wrap_comparator_wrapped(","+// CHECK-SAME:    %[[ARG0:.+]]: tensor<f32>, %[[ARG1:.+]]: tensor<f32>) -> i1","+// CHECK-SAME:    llvm.always_inline","+// CHECK-SAME:    llvm.linkage = #llvm.linkage<internal>"],"additions":26,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/codegen/emitters/transforms/xla_cpu_rewrite_patterns.cc","lines":["@@ -406,6 +406,83 @@ class WrapEntryWithCallFrame","   int32_t vector_width_;"," };"," ","+class WrapComparatorWithDataArray","+    : public mlir::OpRewritePattern<mlir::func::FuncOp> {","+ public:","+  using OpRewritePattern::OpRewritePattern;","+","+  mlir::LogicalResult matchAndRewrite(","+      mlir::func::FuncOp op, mlir::PatternRewriter& rewriter) const override {","+    if (!op->hasAttr(\"xla.cpu.is_comparator\")) {","+      return mlir::failure();","+    }","+","+    if (op->hasAttr(\"xla.cpu.is_wrapped\")) {","+      return mlir::failure();","+    }","+","+    if (!op->getUsers().empty()) {","+      return rewriter.notifyMatchFailure(op, \"Comparator function has users.\");","+    }","+","+    mlir::MLIRContext* context = rewriter.getContext();","+    mlir::ImplicitLocOpBuilder builder(op.getLoc(), rewriter);","+","+    std::string comparator_name(op.getName());","+    op.setName(absl::StrCat(comparator_name, \"_wrapped\"));","+","+    auto ptr_type = mlir::LLVM::LLVMPointerType::get(context);","+    mlir::func::FuncOp comparator_func = mlir::func::FuncOp::create(","+        builder, comparator_name,","+        rewriter.getFunctionType({ptr_type}, op.getResultTypes()));","+","+    builder.setInsertionPointToStart(comparator_func.addEntryBlock());","+    comparator_func->setAttr(","+        \"llvm.uwtable_kind\",","+        mlir::LLVM::UWTableKindAttr::get(","+            context, mlir::LLVM::uwtable::UWTableKind::Async));","+    comparator_func.setArgAttr(0, mlir::LLVM::LLVMDialect::getNoUndefAttrName(),","+                               builder.getUnitAttr());","+    comparator_func.setArgAttr(0, mlir::LLVM::LLVMDialect::getNonNullAttrName(),","+                               builder.getUnitAttr());","+    // The x86-64 psABI requires a `bool` return to be zero extended to 8 bits,","+    // and clang marks it `zeroext` there. AAPCS64 leaves the upper bits to the","+    // caller, so clang omits it on aarch64 Linux; an extra `zeroext` there is","+    // harmless. Emit it unconditionally so the C declaration is matched on","+    // every target that needs it.","+    comparator_func.setResultAttr(0, mlir::LLVM::LLVMDialect::getZExtAttrName(),","+                                  builder.getUnitAttr());","+","+    mlir::Value params_ptr = comparator_func.getArgument(0);","+","+    llvm::SmallVector<mlir::Value> call_args;","+    call_args.reserve(op.getNumArguments());","+    for (const auto& [idx, arg] : llvm::enumerate(op.getArguments())) {","+      auto param_gep = mlir::LLVM::GEPOp::create(","+          builder, ptr_type, ptr_type, params_ptr,","+          llvm::SmallVector<mlir::LLVM::GEPArg, 1>{","+              mlir::LLVM::GEPArg(static_cast<int32_t>(idx))},","+          mlir::LLVM::GEPNoWrapFlags::inbounds);","+      auto param_ptr = mlir::LLVM::LoadOp::create(builder, ptr_type, param_gep);","+      param_ptr.setInvariant(true);","+      auto cast = mlir::UnrealizedConversionCastOp::create(","+          builder, arg.getType(), param_ptr.getResult());","+      call_args.push_back(cast.getResult(0));","+    }","+","+    auto call = mlir::func::CallOp::create(builder, op, call_args);","+    mlir::func::ReturnOp::create(builder, call.getResults());","+","+    op->setAttr(\"xla.cpu.is_wrapped\", builder.getUnitAttr());","+    op.setPrivate();","+    op->setAttr(\"llvm.linkage\", mlir::LLVM::LinkageAttr::get(","+                                    context, mlir::LLVM::Linkage::Internal));","+    op->setAttr(\"llvm.always_inline\", builder.getUnitAttr());","+","+    return mlir::success();","+  }","+};","+"," // Implementation similar to https://gudok.xyz/transpose/#_64_bit_simd_0_74."," "," // Example that follows changes in the first row.","@@ -638,7 +715,7 @@ void PopulateXlaCpuConversionPatterns(mlir::RewritePatternSet& patterns,","   mlir::MLIRContext* context = patterns.getContext();","   patterns.add<LowerLoadOp, LowerWorkGroupIdOp, LowerSuccessOp,","                RewriteFunctionSignatures, LowerExtractWorkgroupIdOp,","-               LowerVector2DTransposeOp>(context);","+               LowerVector2DTransposeOp, WrapComparatorWithDataArray>(context);","   patterns.add<WrapEntryWithCallFrame>(context, vector_width);"," }"," "],"additions":78,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/backends/cpu/codegen/fusion_emitter.cc","lines":["@@ -35,18 +35,32 @@ limitations under the License."," #include \"absl/strings/string_view.h\""," #include \"absl/types/span.h\""," #include \"llvm/ADT/STLExtras.h\"","+#include \"llvm/ADT/SmallVector.h\"","+#include \"mlir/Dialect/Arith/IR/Arith.h\"","+#include \"mlir/Dialect/Func/IR/FuncOps.h\"","+#include \"mlir/Dialect/Tensor/IR/Tensor.h\""," #include \"mlir/IR/Builders.h\"","+#include \"mlir/IR/BuiltinOps.h\"","+#include \"mlir/IR/Location.h\""," #include \"mlir/IR/MLIRContext.h\"","+#include \"mlir/IR/OwningOpRef.h\"","+#include \"mlir/IR/Types.h\"","+#include \"mlir/IR/Value.h\"","+#include \"mlir/IR/ValueRange.h\""," #include \"xla/backends/cpu/alignment.h\""," #include \"xla/backends/cpu/codegen/emitters/cpu_scatter_emitter.h\""," #include \"xla/backends/cpu/codegen/kernel_api_ir_builder.h\""," #include \"xla/backends/cpu/codegen/symbol_name_util.h\""," #include \"xla/backends/cpu/codegen/tiled/tiled_fusion_emitter.h\"","+#include \"xla/codegen/emitters/computation_partitioner.h\""," #include \"xla/codegen/emitters/concatenate_kernel_emitter.h\""," #include \"xla/codegen/emitters/dynamic_update