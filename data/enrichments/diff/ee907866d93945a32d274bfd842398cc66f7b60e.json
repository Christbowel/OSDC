        io_workers=value,","+        )","+        self.assertEqual(reader.max_batch_size, expected)","+        self.assertEqual(reader.max_batch_bytes, expected)","+        self.assertEqual(reader.cpu_workers, expected)","+        self.assertEqual(reader.io_workers, expected)","+","+    def test_fsspec_reader_empty_local_world_size_env(self):","+        with patch.dict(os.environ, {\"LOCAL_WORLD_SIZE\": \"\"}):","+            reader = FsspecReader(\"memory://test_empty_local_world_size\")","+            self.assertGreaterEqual(reader.cpu_workers, 1)","+            self.assertEqual(reader.io_workers, 2)","+","+    def test_fsspec_reader_concurrent_planner_thread_safety(self):","+        checkpoint_dir = \"memory://test_concurrent_planner_safety\"","+        state_dict = {","+            \"nested\": {","+                f\"b_{i}\": io.BytesIO(f\"payload_{i}\".encode()) for i in range(16)","+            },","+            \"tensors\": [torch.randn(8) for _ in range(16)],","+        }","+        dcp.save(","+            state_dict=state_dict,","+            storage_writer=FsspecWriter(checkpoint_dir),","+            planner=dcp.DefaultSavePlanner(),","+            no_dist=True,","+        )","+","+        load_dict = {","+            \"nested\": {f\"b_{i}\": io.BytesIO() for i in range(16)},","+            \"tensors\": [torch.zeros(8) for _ in range(16)],","+        }","+        reader = _async_reader(checkpoint_dir, max_batch_size=4, cpu_workers=8)","+        planner = dcp.DefaultLoadPlanner()","+        caller_thread = threading.get_ident()","+        hook_threads: set[int] = set()","+        hook_counts = {\"resolve\": 0, \"commit\": 0, \"bytes\": 0}","+","+        orig_resolve = planner.resolve_tensor","+        orig_commit = planner.commit_tensor","+        orig_load_bytes = planner.load_bytes","+","+        def tracked_resolve(read_item):","+            hook_threads.add(threading.get_ident())","+            hook_counts[\"resolve\"] += 1","+            return orig_resolve(read_item)","+","+        def tracked_commit(read_item, tensor):","+            hook_threads.add(threading.get_ident())","+            hook_counts[\"commit\"] += 1","+            return orig_commit(read_item, tensor)","+","+        def tracked_load_bytes(read_item, value):","+            hook_threads.add(threading.get_ident())","+            hook_counts[\"bytes\"] += 1","+            return orig_load_bytes(read_item, value)","+","+        with (","+            patch.object(","+                reader.fs.fs, \"cat_ranges\", wraps=reader.fs.fs.cat_ranges","+            ) as mock_cat_ranges,","+            patch.object(planner, \"resolve_tensor\", side_effect=tracked_resolve),","+            patch.object(planner, \"commit_tensor\", side_effect=tracked_commit),","+            patch.object(planner, \"load_bytes\", side_effect=tracked_load_bytes),","+        ):","+            dcp.load(","+                state_dict=load_dict,","+                storage_reader=reader,","+                planner=planner,","+                no_dist=True,","+            )","+            self.assertEqual(mock_cat_ranges.call_count, 8)","+","+        self.assertEqual(hook_threads, {caller_thread})","+        self.assertEqual(hook_counts, {\"resolve\": 16, \"commit\": 16, \"bytes\": 16})","+        for i in range(16):","+            self.assertEqual(","+                state_dict[\"nested\"][f\"b_{i}\"].getvalue(),","+                load_dict[\"nested\"][f\"b_{i}\"].getvalue(),","+            )","+            self.assertEqual(state_dict[\"tensors\"][i], load_dict[\"tensors\"][i])","+","+    def test_fsspec_reader_cat_ranges_error(self):","+        checkpoint_dir = \"memory://test_cat_ranges_error\"","+        state_dict = {\"t1\": torch.randn(10)}","+","+        dcp.save(","+            state_dict=state_dict,","+            storage_writer=FsspecWriter(checkpoint_dir),","+            planner=dcp.DefaultSavePlanner(),","+            no_dist=True,","+        )","+","+        reader = _async_reader(checkpoint_dir)","+        with patch.object(","+            reader.fs.fs,","+            \"cat_ranges\",","+            side_effect=RuntimeError(\"cat_ranges failed\"),","+        ):","+            load_dict = {\"t1\": torch.zeros(10)}","+            with self.assertRaisesRegex(CheckpointException, \"cat_ranges failed\"):","+                dcp.load(","+                    state_dict=load_dict,","+                    storage_reader=reader,","+                    planner=dcp.DefaultLoadPlanner(),","+                    no_dist=True,","+                )","+","+    def test_fsspec_reader_cpu_exception_propagation(self):","+        checkpoint_dir = \"memory://test_cpu_exception\"","+        state_dict = {\"t1\": torch.randn(10)}","+        dcp.save(","+            state_dict=state_dict,","+            storage_writer=FsspecWriter(checkpoint_dir),","+            planner=dcp.DefaultSavePlanner(),","+            no_dist=True,","+        )","+","+        reader = _async_reader(checkpoint_dir)","+        load_dict = {\"t1\": torch.zeros(10)}","+","+        with patch.object(","+            fsspec_filesystem,","+            \"narrow_tensor_by_index\",","+            side_effect=RuntimeError(\"simulated cpu crash\"),","+        ):","+            with self.assertRaisesRegex(CheckpointException, \"simulated cpu crash\"):","+                dcp.load(","+                    state_dict=load_dict,","+                    storage_reader=reader,","+                    planner=dcp.DefaultLoadPlanner(),","+                    no_dist=True,","+                )","+","+    def test_fsspec_reader_worker_threads_named_and_joined(self):","+        checkpoint_dir = \"memory://test_worker_threads\"","+        state_dict = {f\"t_{i}\": torch.randn(4) for i in range(8)}","+        dcp.save(","+            state_dict=state_dict,","+            storage_writer=FsspecWriter(checkpoint_dir),","+            planner=dcp.DefaultSavePlanner(),","+            no_dist=True,","+        )","+","+        reader = _async_reader(checkpoint_dir, max_batch_size=2, cpu_workers=4)","+        load_dict = {f\"t_{i}\": torch.zeros(4) for i in range(8)}","+        decode_threads: set[str] = set()","+","+        def failing_narrow(*args, **kwargs):","+            decode_threads.add(threading.current_thread().name)","+            raise RuntimeError(\"shutdown test\")","+","+        with patch.object(","+            fsspec_filesystem, \"narrow_tensor_by_index\", side_effect=failing_narrow","+        ):","+            with self.assertRaisesRegex(CheckpointException, \"shutdown test\"):","+                dcp.load(","+                    state_dict=load_dict,","+                    storage_reader=reader,","+                    planner=dcp.DefaultLoadPlanner(),","+                    no_dist=True,","+                )","+","+        self.assertTrue(decode_threads)","+        for name in decode_threads:","+            self.assertTrue(name.startswith(\"FsspecReader\"), name)","+        live = [t.name for t in threading.enumerate()]","+        self.assertFalse([n for n in live if n.startswith(\"FsspecReader\")], live)","+","+    def test_fsspec_reader_cat_ranges_inband_exception(self):","+        checkpoint_dir = \"memory://test_cat_ranges_inband_exception\"","+        state_dict = {f\"t_{i}\": torch.randn(4) for i in range(4)}","+        dcp.save(","+            state_dict=state_dict,","+            storage_writer=FsspecWriter(checkpoint_dir),","+            planner=dcp.DefaultSavePlanner(),","+            no_dist=True,","+        )","+","+        reader = _async_reader(checkpoint_dir)","+        real_cat_ranges = reader.fs.fs.cat_ranges","+","+        def cat_ranges_returning_exception(paths, starts, ends, **kwargs):","+            chunks = real_cat_ranges(paths, starts, ends, **kwargs)","+            return [OSError(\"simulated range failure\"), *chunks[1:]]","+","+        load_dict = {f\"t_{i}\": torch.zeros(4) for i in range(4)}","+        with patch.object(","+            reader.fs.fs, \"cat_ranges\", side_effect=cat_ranges_returning_exception","+        ):","+            with self.assertRaisesRegex(","+                CheckpointException,","+                \"Failed to read bytes.*OSError: simulated range failure\",","+            ):","+                dcp.load(","+                    state_dict=load_dict,","+                    storage_reader=reader,","+                    planner=dcp.DefaultLoadPlanner(),","+                    no_dist=True,","+                )","+","+    def test_fsspec_reader_non_contiguous_destination(self):","+        checkpoint_dir = \"memory://test_non_contiguous_destination\"","+        state_dict = {\"t1\": torch.randn(10, 10), \"t2\": torch.randn(20)}","+        dcp.save(","+            state_dict=state_dict,","+            storage_writer=FsspecWriter(checkpoint_dir),","+            planner=dcp.DefaultSavePlanner(),","+            no_dist=True,","+        )","+","+        load_dict = {\"t1\": torch.zeros(10, 10).t(), \"t2\": torch.zeros(20)}","+        results = []","+","+        def spy_disjoint(targets):","+            results.append(_destinations_disjoint(targets))","+            return results[-1]","+","+        with patch.object(","+            fsspec_filesystem, \"_destinations_disjoint\", side_effect=spy_disjoint","+        ):","+            dcp.load(","+                state_dict=load_dict,","+                storage_reader=_async_reader(checkpoint_dir),","+                planner=dcp.DefaultLoadPlanner(),","+                no_dist=True,","+            )","+        self.assertEqual(results, [False])","+        self.assertEqual(state_dict[\"t1\"], load_dict[\"t1\"])","+        self.assertEqual(state_dict[\"t2\"], load_dict[\"t2\"])","+","+    def test_fsspec_reader_resharded_load_copies_in_parallel(self):","+        # Two saved chunks narrow into disjoint halves of one destination tensor,","+        # which is the case the parallel copy path exists for.","+        checkpoint_dir = \"memory://test_resharded_parallel_copy\"","+        full = torch.randn(10)","+        dist.init_process_group(\"gloo\", store=dist.HashStore(), rank=0, world_size=1)","+        try:","+            shards = [","+                Shard(full[0:5].clone(), ShardMetadata([0], [5], \"rank:0/cpu\")),","+                Shard(full[5:10].clone(), ShardMetadata([5], [5], \"rank:0/cpu\")),","+            ]","+            dcp.save(","+                {\"w\": init_from_local_shards(shards, [10])},","+                storage_writer=FsspecWriter(checkpoint_dir),","+                no_dist=True,","+            )","+        finally:","+            dist.destroy_process_group()","+","+        load_dict = {\"w\": torch.zeros(10)}","+        results = []","+","+        def spy_disjoint(targets):","+            results.append(_destinations_disjoint(targets))","+            return results[-1]","+","+        with patch.object(","+            fsspec_filesystem, \"_destinations_disjoint\", side_effect=spy_disjoint","+        ):","+            dcp.load(","+                state_dict=load_dict,","+                storage_reader=_async_reader(checkpoint_dir),","+                planner=dcp.DefaultLoadPlanner(),","+                no_dist=True,","+            )","+        self.assertEqual(results, [True])","+        self.assertEqual(full, load_dict[\"w\"])","+","+    def test_destinations_disjoint_slices(self):","+        base = torch.zeros(30)","+        self.assertFalse(_destinations_disjoint([base[0:15], base[10:25]]))","+        self.assertTrue(_destinations_disjoint([base[0:10], base[10:20]]))","+","+    def test_destinations_disjoint_rejects_subclasses(self):","+        class SubclassRaisingDataPtr(torch.Tensor):","+            def data_ptr(self):","+                raise RuntimeError(\"data_ptr not supported\")","+","+        self.assertFalse(","+            _destinations_disjoint(","+                [SubclassRaisingDataPtr(torch.zeros(20)), torch.zeros(10)]","+            )","+        )","+","+        cla