tViewer()","+\tresponse := &spb.AuthenticateResponse{}","+\tif entity := viewer.GetEntity(); entity != nil {","+\t\tresponse.DefaultEntity = *entity","+\t}","+\tif username := viewer.GetUsername(); username != nil {","+\t\tresponse.Username = *username","+\t}","+\tif email := viewer.GetEmail(); email != nil {","+\t\tresponse.Email = *email","+\t}","+\tif flags := viewer.GetFlags(); flags != nil {","+\t\tresponse.FlagsJson = *flags","+\t}","+\tif teams := viewer.GetTeams(); teams != nil {","+\t\tfor _, edge := range teams.GetEdges() {","+\t\t\tif node := edge.GetNode(); node != nil {","+\t\t\t\tresponse.Teams = append(response.Teams, node.GetName())","+\t\t\t}","+\t\t}","+\t}","+","+\treturn &spb.ApiResponse{","+\t\tResponse: &spb.ApiResponse_AuthenticateResponse{","+\t\t\tAuthenticateResponse: response,","+\t\t},","+\t}","+}"],"additions":79,"deletions":0,"truncated":false},{"path":"core/internal/wbapi/authhandler_test.go","lines":["@@ -0,0 +1,128 @@","+package wbapi_test","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/wandb/wandb/core/internal/wbapi\"","+\tspb \"github.com/wandb/wandb/core/pkg/service_go_proto\"","+)","+","+func TestAuthenticateReturnsViewerInfo(t *testing.T) {","+\tclient := &fakeGQLClient{","+\t\trespMap: map[string]any{","+\t\t\t\"viewer\": map[string]any{","+\t\t\t\t\"id\":       \"user-node-id\",","+\t\t\t\t\"entity\":   \"myentity\",","+\t\t\t\t\"username\": \"myuser\",","+\t\t\t\t\"email\":    \"me@example.com\",","+\t\t\t\t\"flags\":    `{\"code_saving_enabled\": true}`,","+\t\t\t\t\"teams\": map[string]any{","+\t\t\t\t\t\"edges\": []any{","+\t\t\t\t\t\tmap[string]any{\"node\": map[string]any{\"name\": \"team1\"}},","+\t\t\t\t\t\tmap[string]any{\"node\": map[string]any{\"name\": \"team2\"}},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t}","+\thandler := wbapi.NewAuthHandler(client)","+","+\tresponse := handler.HandleAuthenticate(","+\t\tcontext.Background(),","+\t\t&spb.AuthenticateRequest{},","+\t)","+","+\tauthResponse := response.GetAuthenticateResponse()","+\trequire.NotNil(t, authResponse)","+\trequire.True(t, client.called)","+\tassert.Equal(t, \"Viewer\", client.gotReq.OpName)","+\tassert.Equal(t, \"myentity\", authResponse.GetDefaultEntity())","+\tassert.Equal(t, \"myuser\", authResponse.GetUsername())","+\tassert.Equal(t, \"me@example.com\", authResponse.GetEmail())","+\tassert.Equal(t, `{\"code_saving_enabled\": true}`, authResponse.GetFlagsJson())","+\tassert.Equal(t, []string{\"team1\", \"team2\"}, authResponse.GetTeams())","+}","+","+func TestAuthenticateNullEntityIsAccepted(t *testing.T) {","+\t// Unusual accounts and old server versions may return a viewer with","+\t// null fields; the credentials are still valid.","+\tclient := &fakeGQLClient{","+\t\trespMap: map[string]any{","+\t\t\t\"viewer\": map[string]any{","+\t\t\t\t\"id\":       \"user-node-id\",","+\t\t\t\t\"username\": \"myuser\",","+\t\t\t},","+\t\t},","+\t}","+\thandler := wbapi.NewAuthHandler(client)","+","+\tresponse := handler.HandleAuthenticate(","+\t\tcontext.Background(),","+\t\t&spb.AuthenticateRequest{},","+\t)","+","+\tauthResponse := response.GetAuthenticateResponse()","+\trequire.NotNil(t, authResponse)","+\tassert.Equal(t, \"\", authResponse.GetDefaultEntity())","+\tassert.Equal(t, \"myuser\", authResponse.GetUsername())","+}","+","+func TestAuthenticatePartialDataIsAccepted(t *testing.T) {","+\t// Field-level GraphQL errors don't invalidate the credentials when the","+\t// viewer itself resolved; genqlient returns partial data plus an error.","+\tclient := &fakeGQLClient{","+\t\terr: errors.New(\"resolver for field 'teams' failed\"),","+\t\trespMap: map[string]any{","+\t\t\t\"viewer\": map[string]any{","+\t\t\t\t\"id\":     \"user-node-id\",","+\t\t\t\t\"entity\": \"myentity\",","+\t\t\t},","+\t\t},","+\t}","+\thandler := wbapi.NewAuthHandler(client)","+","+\tresponse := handler.HandleAuthenticate(","+\t\tcontext.Background(),","+\t\t&spb.AuthenticateRequest{},","+\t)","+","+\tauthResponse := response.GetAuthenticateResponse()","+\trequire.NotNil(t, authResponse)","+\tassert.Equal(t, \"myentity\", authResponse.GetDefaultEntity())","+}","+","+func TestAuthenticateNullViewerIsError(t *testing.T) {","+\tclient := &fakeGQLClient{","+\t\trespMap: map[string]any{\"viewer\": nil},","+\t}","+\thandler := wbapi.NewAuthHandler(client)","+","+\tresponse := handler.HandleAuthenticate(","+\t\tcontext.Background(),","+\t\t&spb.AuthenticateRequest{},","+\t)","+","+\tapiError := response.GetApiErrorResponse()","+\trequire.NotNil(t, apiError)","+\tassert.Contains(t, apiError.GetMessage(), \"invalid credentials\")","+}","+","+func TestAuthenticateReturnsError(t *testing.T) {","+\tclient := &fakeGQLClient{err: errors.New(\"boom\")}","+\thandler := wbapi.NewAuthHandler(client)","+","+\tresponse := handler.HandleAuthenticate(","+\t\tcontext.Background(),","+\t\t&spb.AuthenticateRequest{},","+\t)","+","+\tapiError := response.GetApiErrorResponse()","+\trequire.NotNil(t, apiError)","+\tassert.Contains(t, apiError.GetMessage(), \"boom\")","+\tassert.Equal(t, int32(0), apiError.GetHttpStatus()) // non-HTTP error","+}"],"additions":128,"deletions":0,"truncated":false},{"path":"core/internal/wbapi/runfileshandler_test.go","lines":["@@ -14,8 +14,12 @@ import ("," \tspb \"github.com/wandb/wandb/core/pkg/service_go_proto\""," )"," ","-// fakeGQLClient records the request it receives and returns a canned result or","-// error.","+// fakeGQLClient records the request it receives and returns a canned result","+// and/or error.","+//","+// Setting both respMap and err models genqlient's behavior for a response","+// with partial data and GraphQL errors: data is populated and a non-nil","+// error is returned."," type fakeGQLClient struct {"," \terr     error"," \tcalled  bool","@@ -30,14 +34,11 @@ func (c *fakeGQLClient) MakeRequest("," ) error {"," \tc.called = t