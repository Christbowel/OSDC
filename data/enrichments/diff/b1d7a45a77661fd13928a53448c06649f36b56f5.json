,"-\t\t\tconst readStream = await disk.read(filepath);","-\t\t\tconst writeStream = createWriteStream(destinationPath);","-\t\t\tqueue.add(() => pipeline(readStream, writeStream));","+\t\t\t\t// Queue the whole per-file sync so the remote stat/read round trips run concurrently.","+\t\t\t\t// Failures are recorded inside the task so the queue is cleared before it starts more work.","+\t\t\t\tqueue.add(() => syncFile().catch(onTaskError));","+\t\t\t}","+\t\t} catch (error) {","+\t\t\t// The listing itself failed; stop queued work","+\t\t\tonTaskError(error);"," \t\t}"," ","-\t\t// wait for the queue to finish","+\t\t// wait for in-flight tasks to finish; on failure the queued tasks were already cleared"," \t\tawait queue.onIdle();","+","+\t\tif (syncError) throw syncError;","+"," \t\t// cleanup dangling local files"," \t\tawait fileTracker.cleanup(localExtensionsPath);"," \t} finally {"],"additions":44,"deletions":20,"truncated":false},{"path":"packages/env/src/constants/defaults.ts","lines":["@@ -110,6 +110,7 @@ export const DEFAULTS: Env = {"," \tEXTENSIONS_SANDBOX_MEMORY: 100,"," \tEXTENSIONS_SANDBOX_TIMEOUT: 1000,"," \tEXTENSIONS_ROLLDOWN: false,","+\tEXTENSIONS_STORAGE_MAX_CONCURRENCY: 20,"," "," \tMIGRATIONS_PATH: './migrations',"," "],"additions":1,"deletions":0,"truncated":false},{"path":"packages/env/src/constants/directus-variables.ts","lines":["@@ -222,6 +222,7 @@ export const DIRECTUS_VARIABLES = ["," \t'EXTENSIONS_SANDBOX_TIMEOUT',"," \t'EXTENSIONS_LIMIT',"," \t'EXTENSIONS_ROLLDOWN',","+\t'EXTENSIONS_STORAGE_MAX_CONCURRENCY',"," "," \t// migrations"," \t'MIGRATIONS_PATH',"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/env/src/constants/type-map.ts","lines":["@@ -69,6 +69,7 @@ export const TYPE_MAP: Record<string, EnvType> = {"," \tSECRET: 'string',"," "," \tEXTENSIONS_ROLLDOWN: 'boolean',","+\tEXTENSIONS_STORAGE_MAX_CONCURRENCY: 'number',"," "," \tPROJECT_OWNER_ENABLED: 'boolean',"," ",""],"additions":1,"deletions":0,"truncated":false}