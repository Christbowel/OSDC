{"id":"f7a99da76b82f762b891cfb17b0bde4514fd0db5","axis":"silent","repo":"vimeo/psalm","sha":"f7a99da76b82f762b891cfb17b0bde4514fd0db5","parsed":{"files":[{"path":"config.xsd","lines":["@@ -312,6 +312,7 @@","             <xs:element name=\"InaccessibleProperty\" type=\"IssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"IncompatibleTypeParameters\" type=\"IssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"InheritorViolation\" type=\"ClassIssueHandlerType\" minOccurs=\"0\" />","+            <xs:element name=\"InsecureCookie\" type=\"IssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"InterfaceInstantiation\" type=\"IssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"InternalClass\" type=\"ClassIssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"InternalMethod\" type=\"MethodIssueHandlerType\" minOccurs=\"0\" />","@@ -580,6 +581,10 @@","             <xs:element name=\"UnusedPsalmSuppress\" type=\"FunctionIssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"UnusedReturnValue\" type=\"IssueHandlerType\" minOccurs=\"0\" />","             <xs:element name=\"UnusedVariable\" type=\"IssueHandlerType\" minOccurs=\"0\" />","+            <xs:element name=\"WeakCipher\" type=\"IssueHandlerType\" minOccurs=\"0\" />","+            <xs:element name=\"WeakHash\" type=\"IssueHandlerType\" minOccurs=\"0\" />","+            <xs:element name=\"WeakRandom\" type=\"IssueHandlerType\" minOccurs=\"0\" />","+            <xs:element name=\"XmlExternalEntity\" type=\"IssueHandlerType\" minOccurs=\"0\" />","         </xs:choice>","         <xs:anyAttribute processContents=\"skip\" />","     </xs:complexType>"],"additions":5,"deletions":0,"truncated":false},{"path":"docs/running_psalm/error_levels.md","lines":["@@ -186,6 +186,8 @@ These issues become info (non-blocking) at level 3 and higher.","  - [UnsafeGenericInstantiation](issues/UnsafeGenericInstantiation.md)","  - [UnsafeInstantiation](issues/UnsafeInstantiation.md)","  - [UnsupportedReferenceUsage](issues/UnsupportedReferenceUsage.md)","+ - [WeakHash](issues/WeakHash.md)","+ - [WeakRandom](issues/WeakRandom.md)"," "," ## Errors at level 3 and below"," ","@@ -194,6 +196,7 @@ These issues become info (non-blocking) at level 4 and higher.","  - [ArgumentTypeCoercion](issues/ArgumentTypeCoercion.md)","  - [CallableByReferenceMismatch](issues/CallableByReferenceMismatch.md)","  - [ImplicitFloatToIntCast](issues/ImplicitFloatToIntCast.md)","+ - [InsecureCookie](issues/InsecureCookie.md)","  - [LessSpecificReturnStatement](issues/LessSpecificReturnStatement.md)","  - [MoreSpecificReturnType](issues/MoreSpecificReturnType.md)","  - [NonInvariantDocblockPropertyType](issues/NonInvariantDocblockPropertyType.md)","@@ -283,6 +286,8 @@ These issues become info (non-blocking) at level 6 and higher.","  - [NullableReturnStatement](issues/NullableReturnStatement.md)","  - [UndefinedInterfaceMethod](issues/UndefinedInterfaceMethod.md)","  - [UndefinedThisPropertyAssignment](issues/UndefinedThisPropertyAssignment.md)","+ - [WeakCipher](issues/WeakCipher.md)","+ - [XmlExternalEntity](issues/XmlExternalEntity.md)"," "," ## Errors at level 6 and below"," "],"additions":5,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues.md","lines":["@@ -63,6 +63,7 @@","  - [InaccessibleProperty](issues/InaccessibleProperty.md)","  - [IncompatibleTypeParameters](issues/IncompatibleTypeParameters.md)","  - [InheritorViolation](issues/InheritorViolation.md)","+ - [InsecureCookie](issues/InsecureCookie.md)","  - [InterfaceInstantiation](issues/InterfaceInstantiation.md)","  - [InternalClass](issues/InternalClass.md)","  - [InternalMethod](issues/InternalMethod.md)","@@ -330,3 +331,7 @@","  - [UnusedPsalmSuppress](issues/UnusedPsalmSuppress.md)","  - [UnusedReturnValue](issues/UnusedReturnValue.md)","  - [UnusedVariable](issues/UnusedVariable.md)","+ - [WeakCipher](issues/WeakCipher.md)","+ - [WeakHash](issues/WeakHash.md)","+ - [WeakRandom](issues/WeakRandom.md)","+ - [XmlExternalEntity](issues/XmlExternalEntity.md)"],"additions":5,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/InsecureCookie.md","lines":["@@ -0,0 +1,27 @@","+# InsecureCookie","+","+This is a **security issue**: it flags a potential vulnerability.","+","+Emitted when `setcookie()` or `setrawcookie()` set a cookie without the `secure` flag: it isn't given, or is `false`.","+","+```php","+<?php","+","+function remember(string $session): void {","+    setcookie('session', $session); // InsecureCookie","+    setcookie('session', $session, ['httponly' => true]); // InsecureCookie","+    setcookie('session', $session, ['secure' => true, 'httponly' => true]); // no issue","+}","+```","+","+## Why this is bad","+","+The browser then also sends the cookie over plain HTTP, where anyone on the network can read it, and steal a session.","+","+## How to fix","+","+Pass `secure: true`, or `'secure' => true` in the options.","+","+## Further resources","+","+- [CWE-614](https://cwe.mitre.org/data/definitions/614.html)"],"additions":27,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/WeakCipher.md","lines":["@@ -0,0 +1,24 @@","+# WeakCipher","+","+This is a **security issue**: it flags a potential vulnerability.","+","+Emitted when `openssl_encrypt()` or `openssl_decrypt()` use a cipher with a key or a block too small (DES, triple DES, RC2, RC4, Blowfish, CAST5, IDEA) or the ECB mode.","+","+```php","+<?php","+","+function encrypt(string $data, string $key): string {","+    return (string) openssl_encrypt($data, 'des-ecb', $key); // WeakCipher","+}","+","+openssl_encrypt('data', 'aes-256-ecb', 'key'); // WeakCipher: ECB encrypts equal blocks the same way","+openssl_encrypt('data', 'aes-256-gcm', 'key', 0, random_bytes(12), $tag); // no issue","+```","+","+## How to fix","+","+Use an authenticated cipher such as `aes-256-gcm` or `chacha20-poly1305`, or `sodium_crypto_secretbox()`.","+","+## Further resources","+","+- [CWE-327](https://cwe.mitre.org/data/definitions/327.html)"],"additions":24,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/WeakHash.md","lines":["@@ -0,0 +1,30 @@","+# WeakHash","+","+This is a **security issue**: it flags a potential vulnerability.","+","+Emitted when data is hashed with an algorithm that collisions break: `md5()`, `sha1()`, or `md2`, `md4`, `md5` and `sha1` given to `hash()`, `hash_file()`, `hash_init()` or `openssl_digest()`.","+","+```php","+<?php","+","+function fingerprint(string $document): string {","+    return md5($document); // WeakHash","+}","+","+hash('sha1', 'data'); // WeakHash","+hash('sha256', 'data'); // no issue","+hash('xxh3', 'data'); // no issue: a fast hash for cache keys and checksums, not meant to resist attacks","+hash_hmac('md5', 'data', 'key'); // no issue: HMAC doesn't rely on collision resistance","+```","+","+## Why this is bad","+","+An attacker can make two inputs with the same MD5 or SHA-1 hash, so the hash can't prove that data wasn't changed, and it is fast enough to guess passwords from.","+","+## How to fix","+","+Use a SHA-2 or SHA-3 algorithm (`hash('sha256', ...)`), and `password_hash()` for passwords. Where only speed matters (cache keys, checksums), use `hash('xxh3', ...)`, which is faster than MD5.","+","+## Further resources","+","+- [CWE-328](https://cwe.mitre.org/data/definitions/328.html)"],"additions":30,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/WeakRandom.md","lines":["@@ -0,0 +1,29 @@","+# WeakRandom","+","+This is a **security issue**: it flags a potential vulnerability.","+","+Emitted when the Mersenne Twister behind `mt_rand()`, `rand()`, `shuffle()`, `array_rand()`... is seeded, by `mt_srand()` or `srand()` given a seed, or `Random\\Engine\\Mt19937` constructed with one: it then generates the same values for the same seed.","+","+```php","+<?php","+","+function token(int $seed): int {","+    mt_srand($seed); // WeakRandom","+    return mt_rand();","+}","+","+mt_srand(); // no issue: seeded randomly","+```","+","+## Why this is bad","+","+Whoever knows or guesses the seed (a timestamp, a user id, a value from the request) can compute every value generated after it. Even unseeded, the Mersenne Twister isn't meant for secrets: its state can be recovered from its output.","+","+## How to fix","+","+Use `random_int()` or `random_bytes()` for tokens, passwords and anything that must stay secret.","+","+## Further resources","+","+- [CWE-335](https://cwe.mitre.org/data/definitions/335.html)","+- [CWE-330](https://cwe.mitre.org/data/definitions/330.html)"],"additions":29,"deletions":0,"truncated":false},{"path":"docs/running_psalm/issues/XmlExternalEntity.md","lines":["@@ -0,0 +1,26 @@","+# XmlExternalEntity","+","+This is a **security issue**: it flags a potential vulnerability.","+","+Emitted when XML is parsed with `LIBXML_NOENT` or `LIBXML_DTDLOAD`, which make libxml load the external entities and DTD of the document: `simplexml_load_string()`, `simplexml_load_file()`, `new SimpleXMLElement()`, `DOMDocument::load()` and `loadXML()`, `Dom\\XMLDocument::createFromString()` and `createFromFile()`.","+","+```php","+<?php","+","+function parse(string $xml): void {","+    simplexml_load_string($xml, SimpleXMLElement::class, LIBXML_NOENT); // XmlExternalEntity","+    simplexml_load_string($xml, SimpleXMLElement::class, LIBXML_NONET); // no issue","+}","+```","+","+## Why this is bad","+","+An entity such as `<!ENTITY x SYSTEM \"file:///etc/passwd\">` then puts a local file in the document, or makes the server request a URL (XML external entity injection, XXE).","+","+## How to fix","+","+Don't pass these options: since libxml 2.9 external entities aren't loaded otherwise.","+","+## Further resources","+","+- [CWE-611](https://cwe.mitre.org/data/definitions/611.html)"],"additions":26,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/Call/ArgumentsAnalyzer.php","lines":["@@ -1503,6 +1503,10 @@ public static function checkArgumentsMatch(","             }","         }"," ","+        if ($method_id !== null && $method_id !== '') {","+            InsecureCallAnalyzer::analyze($statements_analyzer, $method_id, $args, $function_params, $code_location);","+        }","+","         if ($statements_analyzer->taint_flow_graph","             && $cased_method_id","             && !self::returnsInsteadOfOutputting($statements_analyzer, $cased_method_id, $args)","@@ -2003,7 +2007,7 @@ private static function getByRefFlowInputs(string $function_id, string $param_na","      * @param array<int, FunctionLikeParameter> $function_params","      * @psalm-mutation-free","      */","-    private static function getArgForParam(array $args, array $function_params, string $param_name): ?PhpParser\\Node\\Arg","+    public static function getArgForParam(array $args, array $function_params, string $param_name): ?PhpParser\\Node\\Arg","     {","         foreach ($args as $arg) {","             if ($arg->name !== null && $arg->name->name === $param_name) {"],"additions":5,"deletions":1,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/Call/InsecureCallAnalyzer.php","lines":["@@ -0,0 +1,302 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Psalm\\Internal\\Analyzer\\Statements\\Expression\\Call;","+","+use PhpParser;","+use Psalm\\CodeLocation;","+use Psalm\\Internal\\Analyzer\\StatementsAnalyzer;","+use Psalm\\Internal\\MethodIdentifier;","+use Psalm\\Issue\\CodeIssue;","+use Psalm\\Issue\\InsecureCookie;","+use Psalm\\Issue\\WeakCipher;","+use Psalm\\Issue\\WeakHash;","+use Psalm\\Issue\\WeakRandom;","+use Psalm\\Issue\\XmlExternalEntity;","+use Psalm\\IssueBuffer;","+use Psalm\\Storage\\FunctionLikeParameter;","+use Psalm\\Type\\Atomic\\TKeyedArray;","+use Psalm\\Type\\Atomic\\TLiteralInt;","+use Psalm\\Type\\Atomic\\TLiteralString;","+","+use function count;","+use function implode;","+use function in_array;","+use function preg_match;","+use function strtolower;","+","+use const LIBXML_DTDLOAD;","+use const LIBXML_NOENT;","+","+/**","+ * Reports the calls of builtins that make the code insecure whatever data they are given: weak hashes and ciphers,","+ * seeded random number generators, cookies sent without the secure flag and XML parsers loading external entities.","+ *","+ * @internal","+ */","+final class InsecureCallAnalyzer","+{","+    /** The functions hashing with a weak algorithm, whatever their arguments */","+    private const WEAK_HASH_FUNCTIONS = ['md5', 'md5_file', 'sha1', 'sha1_file'];","+","+    /** The parameter of the functions that choose a hash algorithm, by its name before PHP 8 too */","+    private const HASH_ALGORITHM_PARAMS = [","+        'hash' => ['algo'],","+        'hash_file' => ['algo'],","+        'hash_init' => ['algo'],","+        'openssl_digest' => ['digest_algo', 'method'],","+    ];","+","+    /** The hash algorithms that collisions break (lowercase) */","+    private const WEAK_HASH_ALGORITHMS = ['md2', 'md4', 'md5', 'sha1'];","+","+    /** The parameter of the functions that choose a cipher, by its name before PHP 8 too */","+    private const CIPHER_PARAMS = [","+        'openssl_encrypt' => ['cipher_algo', 'method'],","+        'openssl_decrypt' => ['cipher_algo', 'method'],","+    ];","+","+    /**","+     * The ciphers with a key or a block too small (DES, triple DES, RC2, RC4, Blowfish, CAST5, IDEA) and the ECB mode,","+     * which encrypts equal blocks the same way","+     */","+    private const WEAK_CIPHER_PATTERN = '/^(des|rc2|rc4|bf|blowfish|cast5|idea)\\b|-ecb$/i';","+","+    /**","+     * The functions and methods seeding the Mersenne Twister of mt_rand(), rand(), shuffle()... or a Random\\Randomizer,","+     * which then generates the same values for the same seed","+     */","+    private const RANDOM_SEED_PARAMS = [","+        'mt_srand' => 'seed',","+        'srand' => 'seed',","+        'random\\\\engine\\\\mt19937::__construct' => 'seed',","+    ];","+","+    /** The functions setting a cookie, which take its secure flag or an array of options */","+    private const COOKIE_FUNCTIONS = ['setcookie', 'setrawcookie'];","+","+    /** The parameter of the functions and methods parsing XML that takes the libxml options */","+    private const XML_OPTIONS_PARAMS = [","+        'simplexml_load_string' => 'options',","+        'simplexml_load_file' => 'options',","+        'simplexmlelement::__construct' => 'options',","+        'domdocument::load' => 'options',","+        'domdocument::loadxml' => 'options',","+        'dom\\\\xmldocument::createfromfile' => 'options',","+        'dom\\\\xmldocument::createfromstring' => 'options',","+    ];","+","+    /**","+     * @param array<int, PhpParser\\Node\\Arg> $args","+     * @param array<int, FunctionLikeParameter> $function_params","+     */","+    public static function analyze(","+        StatementsAnalyzer $statements_analyzer,","+        string|MethodIdentifier $method_id,","+        array $args,","+        array $function_params,","+        CodeLocation $code_location,","+    ): void {","+        if ($method_id instanceof MethodIdentifier) {","+            $declaring_method_id = $statements_analyzer->getCodebase()->methods->getDeclaringMethodId($method_id);","+            $id = strtolower((string) ($declaring_method_id ?? $method_id));","+        } else {","+            $id = strtolower($method_id);","+        }","+","+        $issue = null;","+","+        if (in_array($id, self::WEAK_HASH_FUNCTIONS, true)) {","+            $issue = new WeakHash(","+                $id . '() hashes with a weak algorithm: use hash() with a SHA-2 or SHA-3 one, password_hash() for'","+                    . ' passwords, or xxh3 where only speed matters',","+                $code_location,","+            );","+        } elseif (isset(self::HASH_ALGORITHM_PARAMS[$id])","+            && ($algorithms = self::getLiteralStrings(","+                $statements_analyzer,","+                self::getArg($args, $function_params, self::HASH_ALGORITHM_PARAMS[$id]),","+            ))","+        ) {","+            foreach ($algorithms as $algorithm) {","+                if (in_array(strtolower($algorithm), self::WEAK_HASH_ALGORITHMS, true)) {","+                    $issue = new WeakHash(","+                        $algorithm . ' is a weak hash algorithm: use a SHA-2 or SHA-3 one, password_hash() for'","+                            . ' passwords, or xxh3 where only speed matters',","+                        $code_location,","+                    );","+                    break;","+                }","+            }","+        } elseif (isset(self::CIPHER_PARAMS[$id])","+            && ($ciphers = self::getLiteralStrings(","+                $statements_analyzer,","+                self::getArg($args, $function_params, self::CIPHER_PARAMS[$id]),","+            ))","+        ) {","+            foreach ($ciphers as $cipher) {","+                if (preg_match(self::WEAK_CIPHER_PATTERN, $cipher) === 1) {","+                    $issue = new WeakCipher(","+                        $cipher . ' is a weak cipher: use an authenticated one, such as aes-256-gcm',","+                        $code_location,","+                    );","+                    break;","+                }","+            }","+        } elseif (isset(self::RANDOM_SEED_PARAMS[$id])","+            && ArgumentsAnalyzer::getArgForParam($args, $function_params, self::RANDOM_SEED_PARAMS[$id]) !== null","+        ) {","+            $issue = new WeakRandom(","+                'A seeded Mersenne Twister generates values whoever knows or guesses the seed can predict:'","+                    . ' use random_int() or random_bytes() for values that must stay secret',","+                $code_location,","+            );","+        } elseif (in_array($id, self::COOKIE_FUNCTIONS, true)","+            && self::setsCookieWithoutSecureFlag($statements_analyzer, $args, $function_params)","+        ) {","+            $issue = new InsecureCookie(","+                'The cookie is set without the secure flag, so it is also sent over plain HTTP',","+                $code_location,","+            );","+        } elseif (isset(self::XML_OPTIONS_PARAMS[$id])","+            && ($options = self::getLoadingExternalEntitiesOptions(","+                $statements_analyzer,","+                ArgumentsAnalyzer::getArgForParam($args, $function_params, self::XML_OPTIONS_PARAMS[$id]),","+            ))","+        ) {","+            $issue = new XmlExternalEntity(","+                implode(' and ', $options) . (count($options) === 1 ? ' makes' : ' make')","+                    . ' the parser load the external entities of the document,'","+                    . ' which can read local files or make requests (XXE)',","+                $code_location,","+            );","+        }","+","+        if ($issue instanceof CodeIssue) {","+            IssueBuffer::maybeAdd($issue, $statements_analyzer->getSuppressedIssues());","+        }","+    }","+","+    /**","+     * The argument given to the first of the parameters named $param_names the function has","+     *","+     * @param array<int, PhpParser\\Node\\Arg> $args","+     * @param array<int, FunctionLikeParameter> $function_params","+     * @param non-empty-list<string> $param_names","+     * @psalm-mutation-free","+     */","+    private static function getArg(array $args, array $function_params, array $param_names): ?PhpParser\\Node\\Arg","+    {","+        foreach ($param_names as $param_name) {","+            $arg = ArgumentsAnalyzer::getArgForParam($args, $function_params, $param_name);","+","+            if ($arg !== null) {","+                return $arg;","+            }","+        }","+","+        return null;","+    }","+","+    /**","+     * The literal strings the argument can be, or none if it can be another string or isn't given","+     *","+     * @return list<string>","+     * @psalm-capabilities read-props","+     */","+    private static function getLiteralStrings(StatementsAnalyzer $statements_analyzer, ?PhpParser\\Node\\Arg $arg): array","+    {","+        $type = $arg !== null ? $statements_analyzer->node_data->getType($arg->value) : null;","+","+        if ($type === null) {","+            return [];","+        }","+","+        $values = [];","+","+        foreach ($type->getAtomicTypes() as $atomic) {","+            if ($atomic instanceof TLiteralString) {","+                $values[] = $atomic->value;","+            }","+        }","+","+        return $values;","+    }","+","+    /**","+     * Whether setcookie() or setrawcookie() are called without the secure flag: it isn't given, neither as an","+     * argument nor as an option, or it is false. Nothing is reported when the analysis can't tell.","+     *","+     * @param array<int, PhpParser\\Node\\Arg> $args","+     * @param array<int, FunctionLikeParameter> $function_params","+     * @psalm-capabilities read-props","+     */","+    private static function setsCookieWithoutSecureFlag(","+        StatementsAnalyzer $statements_analyzer,","+        array $args,","+        array $function_params,","+    ): bool {","+        // the signature taking the options names the parameter `options`","+        $options_arg = ArgumentsAnalyzer::getArgForParam($args, $function_params, 'expires_or_options')","+            ?? ArgumentsAnalyzer::getArgForParam($args, $function_params, 'options');","+        $options_type = $options_arg !== null ? $statements_analyzer->node_data->getType($options_arg->value) : null;","+","+        if ($options_type !== null && $options_type->isArray()) {","+            $options = $options_type->getSingleAtomic();","+","+            if (!$options instanceof TKeyedArray || $options->fallback_params !== null) {","+                return false;","+            }","+","+            return !isset($options->properties['secure']) || $options->properties['secure']->isFalse();","+        }","+","+        $secure_arg = ArgumentsAnalyzer::getArgForParam($args, $function_params, 'secure');","+","+        if ($secure_arg === null) {","+            return true;","+        }","+","+        $secure_type = $statements_analyzer->node_data->getType($secure_arg->value);","+","+        return $secure_type !== null && $secure_type->isFalse();","+    }","+","+    /**","+     * The names of the libxml options making a parser load external entities that the options given can set","+     *","+     * @return list<string>","+     * @psalm-capabilities read-props","+     */","+    private static function getLoadingExternalEntitiesOptions(","+        StatementsAnalyzer $statements_analyzer,","+        ?PhpParser\\Node\\Arg $arg,","+    ): array {","+        $type = $arg !== null ? $statements_analyzer->node_data->getType($arg->value) : null;","+","+        if ($type === null) {","+            return [];","+        }","+","+        $set = 0;","+","+        foreach ($type->getAtomicTypes() as $atomic) {","+            if ($atomic instanceof TLiteralInt) {","+                $set |= $atomic->value;","+            }","+        }","+","+        $options = [];","+","+        if ($set & LIBXML_NOENT) {","+            $options[] = 'LIBXML_NOENT';","+        }","+","+        if ($set & LIBXML_DTDLOAD) {","+            $options[] = 'LIBXML_DTDLOAD';","+        }","+","+        return $options;","+    }","+}"],"additions":302,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/PreloaderList.php","lines":["@@ -1197,6 +1197,7 @@ final class PreloaderList {","         \\Psalm\\Issue\\InaccessibleProperty::class,","         \\Psalm\\Issue\\IncompatibleTypeParameters::class,","         \\Psalm\\Issue\\InheritorViolation::class,","+        \\Psalm\\Issue\\InsecureCookie::class,","         \\Psalm\\Issue\\IntMaskComparison::class,","         \\Psalm\\Issue\\InterfaceInstantiation::class,","         \\Psalm\\Issue\\InternalClass::class,","@@ -1471,6 +1472,10 @@ fina