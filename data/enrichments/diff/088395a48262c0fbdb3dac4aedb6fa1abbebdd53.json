gUtil::Format(\" FORMAT %s\", SQLString(format)));"," \t}"," \tfor (auto &opt : parsed_options) {"," \t\tauto &name = opt.first;"," \t\tauto &expr = opt.second;","-\t\tstring option_string = name.GetIdentifierName();","+\t\tstring option_string = StringUtil::Format(\"%s\", name);"," \t\tif (expr) {"," \t\t\toption_string += \" \" + expr->ToString();"," \t\t}","@@ -81,7 +83,7 @@ string CopyInfo::CopyOptionsToString() const {"," \t\tauto &name = opt.first;"," \t\tauto &values = opt.second;"," ","-\t\tauto option = name + \" \";","+\t\tauto option = StringUtil::Format(\"%s \", name);"," \t\tif (values.empty()) {"," \t\t\t// Options like HEADER don't need an explicit value"," \t\t\t// just providing the name already sets it to true"],"additions":5,"deletions":3,"truncated":false},{"path":"src/parser/parsed_data/create_type_info.cpp","lines":["@@ -1,4 +1,6 @@"," #include \"duckdb/parser/parsed_data/create_type_info.hpp\"","+","+#include \"duckdb/common/sql_identifier.hpp\""," #include \"duckdb/common/extra_type_info.hpp\""," #include \"duckdb/common/sql_identifier.hpp\""," "],"additions":2,"deletions":0,"truncated":false},{"path":"src/parser/statement/execute_statement.cpp","lines":["@@ -1,5 +1,7 @@"," #include \"duckdb/parser/statement/execute_statement.hpp\""," ","+#include \"duckdb/common/sql_identifier.hpp\"","+"," namespace duckdb {"," "," ExecuteStatement::ExecuteStatement() : SQLStatement(StatementType::EXECUTE_STATEMENT) {","@@ -19,7 +21,7 @@ unique_ptr<SQLStatement> ExecuteStatement::Copy() const {"," string ExecuteStatement::ToString() const {"," \tstring result = \"\";"," \tresult += \"EXECUTE\";","-\tresult += \" \" + name;","+\tresult += \" \" + SQLIdentifier(name);"," \tvector<string> stringified;"," \tfor (auto &val : named_values) {"," \t\tstringified.push_back(StringUtil::Format(\"%s := %s\", val.first, val.second->ToString()));"],"additions":3,"deletions":1,"truncated":false},{"path":"src/parser/statement/external_resource_statement.cpp","lines":["@@ -1,6 +1,7 @@"," #include \"duckdb/parser/statement/external_resource_statement.hpp\""," "," #include \"duckdb/common/string_util.hpp\"","+#include \"duckdb/common/sql_identifier.hpp\""," #include \"duckdb/parser/keyword_helper.hpp\""," "," namespace duckdb {","@@ -29,12 +30,13 @@ string ExternalResourceStatement::ToString() const {"," \tcase ExternalResourceOperation::CREATE:"," \t\tresult = \"CREATE EXTERNAL RESOURCE \" + SQLString(type);"," \t\tif (!name.GetIdentifierName().empty()) {","-\t\t\tresult += \" AS \" + name.GetIdentifierName();","+\t\t\tresult += \" AS \" + SQLIdentifier(name);"," \t\t}"," \t\tif (!options.empty()) {"," \t\t\tvector<string> stringified;"," \t\t\tfor (auto &opt : options) {","-\t\t\t\tstringified.push_back(StringUtil::Format(\"%s %s\", opt.first, opt.second->ToString()));","+\t\t\t\tstringified.push_back(","+\t\t\t\t    StringUtil::Format(\"%s %s\", SQLIdentifier(opt.first).ToString(opt.first), opt.second->ToString()));"," \t\t\t}"," \t\t\tresult += \" (\" + StringUtil::Join(stringified, \", \") + \")\";"," \t\t}","@@ -42,12 +44,12 @@ string ExternalResourceStatement::ToString() const {"," \tcase ExternalResourceOperation::REGISTER:"," \t\tresult = \"REGISTER EXTERNAL RESOURCE \" + SQLString(type);"," \t\tif (!name.GetIdentifierName().empty()) {","-\t\t\tresult += \" AS \" + name.GetIdentifierName();","+\t\t\tresult += \" AS \" + SQLIdentifier(name);"," \t\t}"," \t\tresult += \" FROM \" + (handle ? handle->ToString() : string());"," \t\tbreak;"," \tcase ExternalResourceOperation::DESTROY:","-\t\tresult = \"DESTROY EXTERNAL RESOURCE \" + name.GetIdentifierName();","+\t\tresult = \"DESTROY EXTERNAL RESOURCE \" + SQLIdentifier(name);"," \t\tbreak;"," \tcase ExternalResourceOperation::SHOW:"," \t\tresult = all ? \"SHOW ALL EXTERNAL RESOURCES\" : \"SHOW EXTERNAL RESOURCES\";"],"additions":6,"deletions":4,"truncated":false},{"path":"src/parser/statement/prepare_statement.cpp","lines":["@@ -1,5 +1,7 @@"," #include \"duckdb/parser/statement/prepare_statement.hpp\""," ","+#include \"duckdb/common/sql_identifier.hpp\"","+"," namespace duckdb {"," "," PrepareStatement::PrepareStatement() : SQLStatement(StatementType::PREPARE_STATEMENT), statement(nullptr), name(\"\") {","@@ -17,7 +19,7 @@ string PrepareStatement::ToString() const {"," \tstring result = \"\";"," \tresult += \"PREPARE\";"," \tresult += \" \";","-\tresult += name;","+\tresult += SQLIdentifier(name);"," \tresult += \" \";"," \tresult += \"AS\";"," \tresult += \" \";"],"additions":3,"deletions":1,"truncated":false},{"path":"test/configs/verify_aggregate_state_export.json","lines":["@@ -64,6 +64,7 @@","         \"test/sql/cte/cte_describe.test\",","         \"test/sql/function/generic/hash_func.test\",","         \"test/sql/json/issues/internal_issue391.test\",","+        \"test/sql/parser/statement_tostring_roundtrip.test\",","         \"test/sql/prepared/prepare_summarize.test\",","         \"test/sql/show_select/summarize_subquery.test\",","         \"test/sql/show_select/test_summarize.test\","],"additions":1,"deletions":0,"truncated":false},{"path":"test/sql/parser/external_resource_roundtrip.test","lines":["@@ -0,0 +1,106 @@","+# name: test/sql/parser/external_resource_roundtrip.test","+# description: EXTERNAL RESOURCE statements must survive Copy() and ToString()+reparse","+# group: [parser]","+","+# Found by ranking recently merged PRs by patch coverage: #24056 landed the CREATE / REGISTER /","+# DESTROY / SHOW EXTERNAL RESOURCE surface at 57.6% coverage of the lines it added, and","+# src/parser/statement/external_resource_statement.cpp was 2/45 - i.e. nothing had ever copied or","+# printed one of these statements, because no fast-suite test runs under debug_verify_statement.","+#","+# It was broken. ToString() emitted the resource name and the option keys raw, so any identifier","+# needing quotes produced SQL that does not parse back:","+#     DESTROY EXTERNAL RESOURCE \"weird name\"   ->   DESTROY EXTERNAL RESOURCE weird name","+#                                              ->   Parser Error: syntax error at or near \"name\"","+# Reserved words (\"select\") and embedded double quotes broke the same way.","+","+foreach mode COPY_STATEMENT REPARSE_STATEMENT","+","+statement ok","+SET debug_verify_statement='{mode}'","+","+# --- DESTROY: the name is the whole statement, so a quoting bug is immediately fatal ------------------","+","+statement error","+DESTROY EXTERNAL RESOURCE plain_name","+----","+Invalid Input Error: external resource \"plain_name\" is not registered","+","+statement error","+DESTROY EXTERNAL RESOURCE \"weird name\"","+----","+Invalid Input Error: external resource \"weird name\" is not registered","+","+statement error","+DESTROY EXTERNAL RESOURCE \"select\"","+----","+Invalid Input Error: external resource \"select\" is not registered","+","+statement error","+DESTROY EXTERNAL RESOURCE \"he said \"\"hi\"\"\"","+----","+<REGEX>:Invalid Input Error.*is not registered.*","+","+statement error","+DESTROY EXTERNAL RESOURCE \"MixedCase\"","+----","+Invalid Input Error: external resource \"MixedCase\" is not registered","+","+# --- CREATE: name plus an option list, with and without option values ---------------------------------","+","+statement error","+CREATE EXTERNAL RESOURCE 'aws:ec2:quack' AS x (SPOT, REGION 'eu-west-1')","+----","+<REGEX>:.*unknown resource type.*","+","+statement error","+CREATE EXTERNAL RESOURCE 'aws:ec2:quack' AS \"weird name\" (SPOT, REGION 'eu-west-1')","+----","+<REGEX>:.*unknown resource type.*","+","+statement error","+CREATE EXTERNAL RESOURCE 'aws:ec2:quack' AS \"select\" (REGION 'eu-west-1')","+----","+<REGEX>:.*unknown resource type.*","+","+# no alias at all: the name is required, and the statement still has to copy/reparse to get there","+statement error","+CREATE EXTERNAL RESOURCE 'aws:ec2:quack'","+----","+Binder Error: EXTERNAL RESOURCE requires a name (AS <name>)","+","+# a resource type string that itself needs escaping","+statement error","+CREATE EXTERNAL RESOURCE 'aws:ec2:it''s quacky' AS x","+----","+<REGEX>:.*unknown resource type.*","+","+# --- REGISTER: name plus an arbitrary handle expression ------------------------------------------------","+","+statement error","+REGISTER EXTERNAL RESOURCE 'aws:ec2:quack' AS x FROM {'id': 'i-123'}","+----","+<REGEX>:.*unknown resource type.*","+","+statement error","+REGISTER EXTERNAL RESOURCE 'aws:ec2:quack' AS \"weird name\" FROM {'id': 'i-123', 'tags': ['a','b']}","+----","+<REGEX>:.*unknown resource type.*","+","+# a scalar handle reaches the cast rather than the type lookup - still a full ToString round-trip","+statement error","+REGISTER EXTERNAL RESOURCE 'aws:ec2:quack' AS x FROM 'plain-handle'","+----","+<REGEX>:.*can't be cast to the destination type MAP\\(VARCHAR, VARCHAR\\).*","+","+# --- SHOW: no identifiers, but both forms must still copy and reparse ----------------------------------","+","+statement ok","+SHOW EXTERNAL RESOURCES","+","+statement ok","+SELECT count(*) FROM duckdb_external_resources()","+","+statement ok","+RESET debug_verify_statement","+","+endloop"],"additions":106,"deletions":0,"truncated":false},{"path":"test/sql/parser/statement_tostring_roundtrip.test","lines":["@@ -0,0 +1,323 @@","+# name: test/sql/parser/statement_tostring_roundtrip.test","+# description: Every statement form must survive Copy() and ToString()+reparse with quoted identifiers","+# group: [parser]","+","+# SQLStatement::ToString() and Copy() are executed by exactly one thing - debug_verify_statement -","+# and no test in the fast suite enables it. So for any statement type, ToString() is unexercised by","+# construction, and the failure mode is silent: it only shows up when something re-parses the printed","+# SQL (EXPLAIN, the shell's formatter, a serialized plan, a downstream tool).","+#","+# Sweeping ~110 statement forms with identifiers that need quoting found six real round-trip bugs,","+# all fixed alongside this file:","+#","+#   DESTROY EXTERNAL RESOURCE \"weird name\"        -> ...RESOURCE weird name          (#24056 surface)","+#   CREATE/REGISTER EXTERNAL RESOURCE AS \"...\"    -> unquoted alias","+#   ALTER TABLE t ADD COLUMN \"new col\" INTEGER    -> ...ADD COLUMN new col INTEGER","+#   PREPARE \"weird prep\" AS ...                   -> PREPARE weird prep AS ...","+#   EXECUTE \"weird prep\"(1)                       -> EXECUTE weird prep(1)","+#   ... REFERENCES \"t fk\"(\"a b\")                  -> REFERENCES t fk(\"a b\")","+#   CREATE MACRO m(\"a b\") AS \"a b\" + 1            -> CREATE MACRO m(a b) AS ...","+#   CREATE TYPE t AS ENUM ('c''d')                -> ENUM ('c'd')  (unterminated string literal)","+#","+# Everything below succeeds, so any ToString regression surfaces as a parser error.","+","+foreach mode COPY_STATEMENT REPARSE_STATEMENT","+","+statement ok","+SET debug_verify_statement='{mode}'","+","+# --- DDL with identifiers that need quoting -----------------------------------------------------------","+","+statement ok","+CREATE TABLE \"weird name\"(\"odd col\" INTEGER, \"select\" VARCHAR, \"He said \"\"hi\"\"\" INTEGER)","+","+statement ok","+CREATE TABLE \"t chk\"(\"a b\" INTEGER CHECK (\"a b\" > 0), \"c d\" INTEGER UNIQUE)","+","+statement ok","+CREATE TABLE \"t gen\"(\"a b\" INTEGER, \"g h\" INTEGER GENERATED ALWAYS AS (\"a b\" * 2))","+","+statement ok","+CREATE TABLE \"t fk\"(\"a b\" INTEGER PRIMARY KEY, \"c d\" INTEGER REFERENCES \"t fk\"(\"a b\"))","+","+statement ok","+CREATE TABLE \"t comp\"(\"a b\" INTEGER NOT NULL DEFAULT 7, \"c d\" INTEGER, PRIMARY KEY (\"a b\", \"c d\"))","+","+statement ok","+CREATE SCHEMA \"weird schema\"","+","+statement ok","+CREATE TABLE \"weird schema\".\"qualified tbl\"(\"x y\" INTEGER)","+","+statement ok","+CREATE TABLE \"t fk2\"(\"a b\" INTEGER, FOREIGN KEY (\"a b\") REFERENCES \"t fk\"(\"a b\"))","+","+statement ok","+CREATE VIEW \"weird view\"(\"col a\", \"col b\") AS SELECT 1, 2","+","+statement ok","+CREATE SEQUENCE \"weird seq\" START WITH 3 INCREMENT BY 2 MINVALUE 1 MAXVALUE 99 CYCLE","+","+statement ok","+CREATE TYPE \"weird enum\" AS ENUM ('a b', 'c''d', '')","+","+statement ok","+CREATE TYPE \"weird struct\" AS STRUCT(\"a b\" INTEGER, \"c d\" VARCHAR)","+","+statement ok","+CREATE TYPE \"weird union\" AS UNION(\"a b\" INTEGER, \"c d\" VARCHAR)","+","+statement ok","+CREATE MACRO \"weird macro\"(\"a b\") AS \"a b\" + 1","+","+statement ok","+CREATE MACRO \"macro defaults\"(a, \"b c\" := 3) AS a + \"b c\"","+","+statement ok","+CREATE MACRO \"table macro\"() AS TABLE SELECT 1 AS \"q q\"","+","+# --- ALTER ---------------------------------------------------------------------------------------------","+","+statement ok","+ALTER TABLE \"weird name\" ADD COLUMN \"new col\" INTEGER","+","+statement ok","+ALTER TABLE \"weird name\" ADD COLUMN IF NOT EXISTS \"new col2\" INTEGER DEFAULT 4","+","+statement ok","+ALTER TABLE \"weird name\" RENAME COLUMN \"odd col\" TO \"odder col\"","+","+statement ok","+ALTER TABLE \"weird name\" ALTER COLUMN \"odder col\" SET DEFAULT 5","+","+statement ok","+ALTER TABLE \"weird name\" ALTER COLUMN \"odder col\" DROP DEFAULT","+","+statement ok","+ALTER TABLE \"weird name\" ALTER COLUMN \"odder col\" TYPE BIGINT","+","+statement ok","+ALTER TABLE \"weird name\" DROP COLUMN \"new col2\"","+","+statement ok","+ALTER TABLE \"weird name\" RENAME TO \"other name\"","+","+statement ok","+ALTER TABLE \"other name\" RENAME TO \"weird name\"","+","+statement ok","+ALTER VIEW \"weird view\" RENAME TO \"other view\"","+","+statement ok","+COMMENT ON TABLE \"weird name\" IS 'a comment with '' a quote'","+","+statement ok","+COMMENT ON COLUMN \"weird name\".\"odder col\" IS 'hi'","+","+# indexes are created after the ALTERs, since an index blocks a column rename","+statement ok","+CREATE INDEX \"weird idx\" ON \"weird name\"(\"odder col\")","+","+statement ok","+CREATE UNIQUE INDEX \"weird uidx\" ON \"weird name\"(\"select\")","+","+# --- DML -------------------------------------------------------------------------------------------------","+","+statement ok","+INSERT INTO \"weird name\"(\"odder col\", \"select\", \"He said \"\"hi\"\"\") VALUES (1, 'x', 2)","+","+statement ok","+INSERT INTO \"weird name\" BY NAME SELECT 3 AS \"odder col\", 'y' AS \"select\"","+","+statement ok","+INSERT INTO \"t chk\" VALUES (1, 1) ON CONFLICT DO NOTHING","+","+statement ok","+UPDATE \"weird name\" SET \"select\" = 'z' WHERE \"odder col\" = 1","+","+statement ok","+DELETE FROM \"weird name\" WHERE \"odder col\" = 99","+","+statement ok","+MERGE INTO \"t chk\" USING \"t chk\" AS \"src x\" ON \"t chk\".\"a b\" = \"src x\".\"a b\" WHEN MATCHED THEN DELETE","+","+# --- queries ------------------------------------------------------------------------------------------","+","+statement ok","+SELECT \"odder col\" AS \"a b\" FROM \"weird name\" AS \"al ias\" ORDER BY \"a b\"","+","+statement ok","+SELECT * FROM \"weird name\" t1 JOIN \"weird name\" t2 USING (\"odder col\")","+","+statement ok","+SELECT sum(\"odder col\") FILTER (WHERE \"odder col\" > 0) OVER (PARTITION BY \"select\" ORDER BY \"odder col\")","+FROM \"weird name\"","+","+statement ok","+SELECT * FROM \"weird name\" QUALIFY row_number() OVER (ORDER BY \"odder col\") = 1","+","+statement ok","+SELECT list_transform([1,2], lambda \"x y\": \"x y\" * 2), {'a b': 1}['a b'], MAP{'k k': 1}['k k']","+","+statement ok","+SELECT * FROM (VALUES (1)) AS \"v v\"(\"c c\")","+","+# a qualified star: the relation name is the one part of StarExpression::ToString that was raw","+# (EXCLUDE / RENAME / REPLACE already quoted their identifiers)","+statement ok","+SELECT \"weird name\".* FROM \"weird name\"","+","+statement ok","+SELECT \"weird name\".* EXCLUDE (\"select\") FROM \"weird name\"","+","+statement ok","+SELECT * EXCLUDE (\"select\") RENAME (\"odder col\" AS \"renamed col\") FROM \"weird name\"","+","+statement ok","+SELECT * REPLACE (\"odder col\" + 1 AS \"odder col\") FROM \"weird name\"","+","+statement ok","+SELECT COLU