hm.","+// The given command is directly modified such that it runs under `aa-exec` with a restricted profile (see [compressProfileTpl]).","+// It returns a cleanup function that deletes the AppArmor profile that the command is running in.","+func CompressWrapper(sysOS *sys.OS, cmd *exec.Cmd, dstPath string, extraAllowedCommands []string) (func(), error) {","+\tif !sysOS.AppArmorAvailable || !sysOS.AppArmorAdmin {","+\t\treturn func() {}, nil","+\t}","+","+\trevert := revert.New()","+\tdefer revert.Fail()","+","+\tif dstPath != \"\" {","+\t\tfullPath, err := filepath.EvalSymlinks(dstPath)","+\t\tif err == nil {","+\t\t\tdstPath = fullPath","+\t\t}","+\t}","+","+\tcmds := append(extraAllowedCommands, cmd.Args[0])","+\tallowedCmdPaths := make([]string, 0, len(cmds))","+\tfor _, c := range cmds {","+\t\tcmdPath, err := exec.LookPath(c)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"Failed starting compression: Failed finding executable: %w\", err)","+\t\t}","+","+\t\tcmdPathFull, err := filepath.EvalSymlinks(cmdPath)","+\t\tif err == nil {","+\t\t\tcmdPath = cmdPathFull","+\t\t}","+","+\t\tallowedCmdPaths = append(allowedCmdPaths, cmdPath)","+\t}","+","+\t// Load the profile.","+\tprofileName, err := compressProfileLoad(sysOS, allowedCmdPaths, dstPath)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"Failed loading compression profile: %w\", err)","+\t}","+","+\tcleanup := func() { _ = deleteProfile(sysOS, profileName, profileName) }","+\trevert.Add(cleanup)","+","+\t// Resolve aa-exec.","+\texecPath, err := exec.LookPath(\"aa-exec\")","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\t// Override the command.","+\tnewArgs := make([]string, 0, 3+len(cmd.Args))","+\tnewArgs = append(newArgs, \"aa-exec\", \"-p\", profileName)","+\tnewArgs = append(newArgs, cmd.Args...)","+\tcmd.Args = newArgs","+\tcmd.Path = execPath","+","+\trevert.Success()","+\treturn cleanup, nil","+}","+","+// compressProfileLoad loads [compressProfileTpl] with the given arguments. A name is generated at random for the profile","+// because it should be loaded and unloaded as necessary using [CompressWrapper].","+func compressProfileLoad(sysOS *sys.OS, allowedCommandPaths []string, dstPath string) (string, error) {","+\trevert := revert.New()","+\tdefer revert.Fail()","+","+\t// Generate a temporary profile name.","+\tname := profileName(\"compress\", uuid.New().String())","+\tprofilePath := filepath.Join(aaPath, \"profiles\", name)","+","+\t// Generate the profile","+\tcontent, err := compressProfile(name, allowedCommandPaths, dstPath)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+","+\t// Write it to disk.","+\terr = os.WriteFile(profilePath, []byte(content), 0600)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+","+\trevert.Add(func() { os.Remove(profilePath) })","+","+\t// Load it.","+\terr = loadProfile(sysOS, name)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+","+\trevert.Success()","+\treturn name, nil","+}","+","+// compressProfile generates the AppArmor profile template from the given destination path.","+func compressProfile(name string, allowedCommandPaths []string, dstPath string) (string, error) {","+\tsb := &strings.Builder{}","+\terr := compressProfileTpl.Execute(sb, map[string]any{","+\t\t\"allowedCommandPaths\": allowedCommandPaths,","+\t\t\"name\":                name,","+\t\t\"hasDstPath\":          dstPath != \"\",","+\t\t\"dstPath\":             dstPath,","+\t\t\"snap\":                shared.InSnap(),","+\t})","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+","+\treturn sb.String(), nil","+}",""],"additions":139,"deletions":0,"truncated":false}],"additions":139,"deletions":0,"truncated":false,"file_count":1},"error":null,"fetched_at":"2026-11-07T15:03:01.161942+00:00"}