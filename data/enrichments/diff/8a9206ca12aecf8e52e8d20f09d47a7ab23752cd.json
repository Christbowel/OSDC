));","+                }","+                config.parse_bytes(&combined);","+            } else {","+                config.parse_bytes(first.as_bytes());","+            }","         }","         config","     }"],"additions":22,"deletions":4,"truncated":false},{"path":"crates/jwt-auth/tests/oidc_cache_directives.rs","lines":["@@ -7,6 +7,49 @@ use std::time::Duration;"," use salvo_core::http::HeaderValue;"," use salvo_jwt_auth::oidc::CachePolicy;"," ","+#[test]","+fn repeated_fields_match_one_combined_field_without_discarding_opaque_bytes() {","+    let fields = [","+        HeaderValue::from_bytes(","+            b\"MAX-AGE=\\\"120\\\", extension=\\\"opaque\\x80,max-age=2592000,ignored\\\"\",","+        )","+        .unwrap(),","+        HeaderValue::from_static(r#\"Stale-While-Revalidate=\"30\", STALE-IF-ERROR=\"0\"\"#),","+    ];","+    let combined = HeaderValue::from_bytes(b\"MAX-AGE=\\\"120\\\", extension=\\\"opaque\\x80,max-age=2592000,ignored\\\",Stale-While-Revalidate=\\\"30\\\", STALE-IF-ERROR=\\\"0\\\"\").unwrap();","+    let policy = CachePolicy::from_header_values(&fields);","+    assert_eq!(policy, CachePolicy::from_header_val(Some(&combined)));","+    assert_eq!(policy.max_age, Duration::from_secs(120));","+    assert_eq!(policy.stale_while_revalidate, Some(Duration::from_secs(30)));","+    assert_eq!(policy.stale_if_error, Some(Duration::ZERO));","+}","+","+#[test]","+fn repeated_fields_preserve_quoted_boundaries_and_received_order() {","+    let fields = [","+        HeaderValue::from_static(r#\"extension=\"ignored\"#),","+        HeaderValue::from_static(r#\"max-age=2592000,ignored\", max-age=12, stale-if-error=60\"#),","+        HeaderValue::from_static(\"stale-if-error=0\"),","+    ];","+    let combined = HeaderValue::from_static(","+        r#\"extension=\"ignored,max-age=2592000,ignored\", max-age=12, stale-if-error=60,stale-if-error=0\"#,","+    );","+    let policy = CachePolicy::from_header_values(&fields);","+    assert_eq!(policy, CachePolicy::from_header_val(Some(&combined)));","+    assert_eq!(policy.max_age, Duration::from_secs(12));","+    assert_eq!(policy.stale_if_error, Some(Duration::ZERO));","+}","+","+#[test]","+fn empty_and_single_field_inputs_keep_existing_policy_behavior() {","+    assert_eq!(CachePolicy::from_header_values([]), CachePolicy::default());","+    let value = HeaderValue::from_static(\"max-age=90, stale-if-error=0\");","+    assert_eq!(","+        CachePolicy::from_header_values([&value]),","+        CachePolicy::from_header_val(Some(&value))","+    );","+}","+"," #[test]"," fn quoted_extensions_cannot_extend_jwks_cache_policy() {","     let header = HeaderValue::from_static(",""],"additions":43,"deletions":0,"truncated":false}],"additions":140,"deletions":10,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-30T15:56:48.384122+00:00"}