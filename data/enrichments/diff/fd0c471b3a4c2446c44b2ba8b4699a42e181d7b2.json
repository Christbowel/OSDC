{"id":"fd0c471b3a4c2446c44b2ba8b4699a42e181d7b2","axis":"silent","repo":"vllm-project/vllm","sha":"fd0c471b3a4c2446c44b2ba8b4699a42e181d7b2","parsed":{"files":[{"path":"tests/utils_/test_rocm_vram_lookup.py","lines":["@@ -0,0 +1,133 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Finding amdgpu's exact VRAM counter from KFD topology and DRM sysfs. Plain","+files in a temporary directory, so this runs without a GPU.\"\"\"","+","+import pytest","+","+from vllm.platforms.rocm_device_memory import find_vram_used_file","+","+GB = 1 << 30","+# torch's ROCm UUID holds the KFD unique_id 0x13a691b49a73a35c as ASCII hex.","+UUID = b\"13a691b49a73a35c\".hex()","+UNIQUE_ID = 0x13A691B49A73A35C","+# location_id 0xE300 is PCI bus 0xE3, device 0, function 0.","+PCI = (0, 0xE3, 0)","+","+","+def _node(root, name, **props):","+    node = root / \"nodes\" / name","+    node.mkdir(parents=True)","+    node.joinpath(\"properties\").write_text(","+        \"\".join(f\"{k} {v}\\n\" for k, v in props.items())","+    )","+","+","+def _gpu(root, name=\"2\", minor=128, location_id=0xE300, unique_id=UNIQUE_ID):","+    _node(","+        root,","+        name,","+        simd_count=128,","+        drm_render_minor=minor,","+        location_id=location_id,","+        domain=0,","+        unique_id=unique_id,","+    )","+","+","+def _vram(root, minor=128, total=32 * GB, used=GB):","+    device = root / \"drm\" / f\"renderD{minor}\" / \"device\"","+    device.mkdir(parents=True)","+    device.joinpath(\"mem_info_vram_total\").write_text(f\"{total}\\n\")","+    device.joinpath(\"mem_info_vram_used\").write_text(f\"{used}\\n\")","+    return str(device / \"mem_info_vram_used\")","+","+","+def _find(root, uuid=UUID, pci=PCI, total=32 * GB):","+    return find_vram_used_file(","+        uuid,","+        pci,","+        total,","+        nodes_dir=str(root / \"nodes\"),","+        drm_dir=str(root / \"drm\"),","+    )","+","+","+@pytest.fixture","+def root(tmp_path):","+    # A CPU node, skipped by the lookup.","+    _node(tmp_path, \"0\", simd_count=0, drm_render_minor=0, location_id=0)","+    return tmp_path","+","+","+def test_finds_the_gpu_by_uuid_and_pci(root):","+    _gpu(root)","+    _gpu(root, name=\"3\", minor=129, location_id=0x6300, unique_id=7)","+    expected = _vram(root)","+    _vram(root, minor=129)","+    assert _find(root) == (expected, \"\")","+    # A UUID that is not hex digits leaves the PCI address.","+    assert _find(root, uuid=\"GPU-1234\") == (expected, \"\")","+","+","+@pytest.mark.parametrize(","+    (\"uuid\", \"pci\"),","+    [","+        (UUID, (0, 0x99, 0)),  # no node at this PCI address","+        (b\"0000000000000007\".hex(), PCI),  # the node at this address has","+        # another unique_id","+    ],","+)","+def test_no_matching_node(root, uuid, pci):","+    _gpu(root)","+    _vram(root)","+    path, reason = _find(root, uuid=uuid, pci=pci)","+    assert path is None and \"no single KFD node\" in reason","+","+","+def test_skips_partitioned_gpus(root):","+    \"\"\"Partitions of one GPU share its PCI bus and device (function 1 here)","+    and its VRAM counter.\"\"\"","+    _gpu(root)","+    _gpu(root, name=\"3\", minor=129, location_id=0xE301, unique_id=7)","+    _vram(root)","+    _vram(root, minor=129)","+    assert _find(root) == (None, \"partitioned GPU\")","+","+","+def test_skips_a_malformed_node(root):","+    \"\"\"A node whose properties do not parse is skipped, not a crash.\"\"\"","+    _gpu(root, unique_id=\"not-a-number\")","+    _vram(root)","+    path, reason = _find(root)","+    assert path is None and \"no single KFD node\" in reason","+","+","+def test_needs_the_vram_counters(root):","+    _gpu(root)","+    path, reason = _find(root)","+    assert path is None and \"no amdgpu VRAM counters\" in reason","+","+","+@pytest.mark.parametrize(","+    (\"vram_total\", \"found\"),","+    [","+        (32 * GB, True),","+        (int(32 * GB * 1.005), True),","+        # More than 1% above HIP's total: HIP's memory is not this VRAM.","+        (int(32 * GB * 1.02), False),","+        # Below HIP's total (e.g. an APU's small carve-out).","+        (32 * GB - (1 << 20), False),","+    ],","+)","+def test_vram_total_must_match_hip(root, vram_total, found):","+    _gpu(root)","+    expected = _vram(root, total=vram_total)","+    path, reason = _find(root)","+    assert path == (expected if found else None)","+    assert found or \"does not match\" in reason","+","+","+def test_no_kfd_topology(tmp_path):","+    path, reason = _find(tmp_path)","+    assert path is None and \"no KFD topology\" in reason"],"additions":133,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_extensible_kv_cache.py","lines":["@@ -9,6 +9,7 @@"," import torch"," "," from vllm.config import ModelConfig, VllmConfig","+from vllm.platforms.interface import Platform"," from vllm.utils.vmm_driver import vmm_unavailable_reason"," from vllm.v1.core.kv_cache_planning import get_kv_cache_config_from_groups"," from vllm.v1.kv_cache_interface import (","@@ -198,6 +199,11 @@ def test_measured_sizing_caps_torch_memory(monkeypatch):","     monkeypatch.setattr(accelerator, \"synchronize\", lambda *args: None)","     monkeypatch.setattr(accelerator, \"empty_cache\", lambda: None)","     monkeypatch.setattr(accelerator, \"get_memory_info\", lambda *args: (6 * gib, 0))","+    monkeypatch.setattr(","+        extensible_kv_cache.current_platform,","+        \"free_device_memory\",","+        Platform.free_device_memory,","+    )","     monkeypatch.setattr(accelerator, \"memory_reserved\", lambda *args: 2 * gib)","     monkeypatch.setattr(","         extensible_kv_cache, \"measure_kv_cache_bytes\", lambda **kwargs: 5 * gib","@@ -249,6 +255,11 @@ def test_measured_sizing_counts_reclaimable_memory_on_integrated_gpu(monkeypatch","     monkeypatch.setattr(","         accelerator, \"get_memory_info\", lambda *args: (10 * gib, 120 * gib)","     )","+    monkeypatch.setattr(","+        extensible_kv_cache.current_platform,","+        \"free_device_memory\",","+        Platform.free_device_memory,","+    )","     from vllm.utils import mem_utils"," ","     monkeypatch.setattr(mem_utils, \"in_wsl\", lambda: False)"],"additions":11,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_gpu_worker.py","lines":["@@ -775,6 +775,7 @@ def _weight_update_worker("," ):","     \"\"\"A Worker over an extensible KV cache with free_bytes of free memory","     and a model whose largest layer reloads layer_bytes.\"\"\"","+    from vllm.platforms.interface import Platform","     from vllm.v1.worker import extensible_kv_cache","     from vllm.v1.worker.gpu_worker import Worker"," ","@@ -785,6 +786,11 @@ def _weight_update_worker(","     monkeypatch.setattr(","         torch.accelerator, \"get_memory_info\", lambda *args: (free_bytes, 100 * GiB)","     )","+    monkeypatch.setattr(","+        extensible_kv_cache.current_platform,","+        \"free_device_memory\",","+        Platform.free_device_memory,","+    )","     monkeypatch.setattr(torch.accelerator, \"memory_reserved\", lambda *args: 0)","     monkeypatch.setattr(torch.accelerator, \"memory_allocated\", lambda *args: 0)","     monkeypatch.setattr(torch.accelerator, \"empty_cache\", lambda: None)"],"additions":6,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_rocm_device_memory.py","lines":["@@ -0,0 +1,182 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Free memory by the exact device memory count on a real ROCm GPU. The sysfs","+lookup is tested without a GPU in tests/utils_/test_rocm_vram_lookup.py.\"\"\"","+","+import ctypes","+import subprocess","+import sys","+import time","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+","+if not current_platform.is_rocm():","+    # vllm.platforms.rocm queries the GPU at import time.","+    pytest.skip(\"requires ROCm\", allow_module_level=True)","+","+from vllm.platforms import rocm_device_memory  # noqa: E402","+from vllm.utils.extensible_tensor import ExtensibleTensor  # noqa: E402","+","+MB = 1 << 20","+DEVICE = torch.device(\"cuda:0\")","+","+","+def _used() -> int:","+    path = rocm_device_memory._vram_used_file(0)","+    assert path is not None","+    with open(path) as f:","+        return int(f.read())","+","+","+def _exact_free() -> int:","+    free = rocm_device_memory.exact_free_memory(DEVICE)","+    assert free is not None","+    return free","+","+","+def _hidden() -> int:","+    \"\"\"Free memory the exact count shows and HIP's free memory does not.\"\"\"","+    return _exact_free() - torch.accelerator.get_memory_info(DEVICE)[0]","+","+","+@pytest.fixture","+def exact_count():","+    torch.zeros(1, device=DEVICE)","+    if rocm_device_memory._vram_used_file(0) is None:","+        pytest.skip(\"no exact VRAM count for this GPU\")","+    # Wait until earlier frees are erased and the count holds.","+    torch.accelerator.empty_cache()","+    torch.accelerator.synchronize()","+    start = held_since = time.monotonic()","+    last = _used()","+    while time.monotonic() - held_since < 0.1:","+        assert time.monotonic() - start < 10, \"device memory never settled\"","+        time.sleep(0.005)","+        if (used := _used()) != last:","+            held_since, last = time.monotonic(), used","+","+","+def test_exact_count_grows_with_an_allocation(exact_count):","+    before = _used()","+    tensor = torch.empty(64 * MB, dtype=torch.uint8, device=DEVICE)","+    torch.accelerator.synchronize()","+    grown = _used() - before","+    del tensor","+    # 64 MB, give or take driver memory (page tables).","+    assert abs(grown - 64 * MB) < 32 * MB","+","+","+@pytest.fixture","+def code_objects():","+    \"\"\"Loads n copies of a small kernel code object; free memory counts each","+    as at least 2 MB.\"\"\"","+    import triton","+    import triton.language as tl","+","+    @triton.jit","+    def add_one(x_ptr, n, BLOCK: tl.constexpr):","+        i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)","+        tl.store(x_ptr + i, tl.load(x_ptr + i, mask=i < n) + 1, mask=i < n)","+","+    x = torch.zeros(128, device=DEVICE)","+    image = add_one.warmup(x, 128, BLOCK=128, grid=(1,)).asm[\"hsaco\"]","+    with open(\"/proc/self/maps\") as f:","+        path = next(line.split()[-1] for line in f if \"libamdhip64\" in line)","+    hip = ctypes.CDLL(path)","+    buffer = ctypes.create_string_buffer(image, len(image))","+    modules: list[ctypes.c_void_p] = []","+","+    def load(n: int) -> None:","+        for _ in range(n):","+            module = ctypes.c_void_p()","+            assert hip.hipModuleLoadData(ctypes.byref(module), buffer) == 0","+            modules.append(module)","+        torch.accelerator.synchronize()","+","+    yield load","+    for module in modules:","+        hip.hipModuleUnload(module)","+","+","+def test_code_objects_are_added_back(exact_count, code_objects):","+    \"\"\"200 code objects of a few KB, each counted as at least 2 MB, are added","+    back; another process taking 1 GB meanwhile is not.\"\"\"","+    hidden_before = _hidden()","+    code_objects(200)","+    free_alone, added_alone = _exact_free(), _hidden() - hidden_before","+    assert added_alone > 200 * MB","+","+    child = subprocess.Popen(","+        [","+            sys.executable,","+            \"-c\",","+            (","+                \"import sys, torch\\n\"","+                \"t = torch.empty(1 << 30, dtype=torch.uint8, device='cuda:0')\\n\"","+                \"torch.accelerator.synchronize()\\n\"","+                \"print('ready', flush=True)\\n\"","+                \"sys.stdin.read()\\n\"","+            ),","+        ],","+        stdin=subprocess.PIPE,","+        stdout=subprocess.PIPE,","+        text=True,","+    )","+    try:","+        assert child.stdout is not None","+        assert child.stdout.readline().strip() == \"ready\"","+        free_shared, added_shared = _exact_free(), _hidden() - hidden_before","+    finally:","+        assert child.stdin is not None","+        child.stdin.close()","+        child.wait(timeout=60)","+    assert free_alone - free_shared >= 1 << 30","+    # The child's own rounding (its runtime's code objects) is added back too,","+    # but not its 1 GB.","+    assert -32 * MB < added_shared - added_alone < 256 * MB","+","+","+def _corrected_target(code_objects) -> int:","+    \"\"\"Corrected free memory after loading code objects, less 256 MB.\"\"\"","+    hidden_before = _hidden()","+    code_objects(200)","+    assert _hidden() - hidden_before > 200 * MB","+    return _exact_free() - 256 * MB","+","+","+@pytest.mark.optional","+def test_corrected_free_memory_can_be_allocated(exact_count, code_objects):","+    \"\"\"All but 256 MB of the corrected free memory can be allocated through","+    torch in 64 MB and 2 MB blocks. Fills nearly the whole GPU: runs with","+    --optional.\"\"\"","+    target = _corrected_target(code_objects)","+    chunks, allocated = [], 0","+    try:","+        for step in (64 * MB, 2 * MB):","+            while allocated + step <= target:","+                chunks.append(torch.empty(step, dtype=torch.uint8, device=DEVICE))","+                allocated += step","+        torch.accelerator.synchronize()","+    finally:","+        del chunks","+        torch.accelerator.empty_cache()","+    assert allocated > target - 2 * MB","+","+","+@pytest.mark.optional","+def test_corrected_free_memory_fits_one_allocation(exact_count, code_objects):","+    \"\"\"All but 256 MB of the corrected free memory can be committed as one","+    driver allocation, as a defragmented extensible KV cache segment is.","+    Fills nearly the whole GPU: runs with --optional.\"\"\"","+    target = _corrected_target(code_objects) // (2 * MB) * (2 * MB)","+    tensor = ExtensibleTensor(target, device=DEVICE)","+    try:","+        tensor.resize_per_segment_(target)","+        assert tensor.num_physical_chunks == 1","+        tensor.full_view()[-1:].zero_()","+        torch.accelerator.synchronize()","+    finally:","+        tensor.free()"],"additions":182,"deletions":0,"truncated":false},{"path":"vllm/config/cache.py","lines":["@@ -390,9 +390,12 @@ def device_memory_utilization(self, value: float | None) -> None:","     physical pages after warmup, so the cache is sized from the memory actually","     free after CUDA graph capture rather than from a profiling estimate. If","     unspecified, enabled on CUDA and ROCm unless kv_cache_memory_bytes is set,","-    or NIXL on device memory has no IMEX channel;","-    falls back to estimate-based sizing where the driver lacks VMM support.","-    Explicitly requesting it where unsupported is an error.\"\"\"","+    or NIXL on device memory has no IMEX channel; falls back to estimate-based","+    sizing where the driver lacks VMM support. Explicitly requesting it where","+    unsupported is an error. On unpartitioned discrete ROCm GPUs, the sizing","+    adds back free memory that HIP hides by counting each allocation as at","+    least 2 MiB, so gpu_memory_utilization bounds exact device memory use","+    there.\"\"\""," ","     kv_offloading_size: float | None = None","     \"\"\"Size of the KV cache offloading buffer in GiB. When TP > 1, this is"],"additions":6,"deletions":3,"truncated":false},{"path":"vllm/platforms/interface.py","lines":["@@ -1209,6 +1209,15 @@ def get_current_memory_usage(","         \"\"\"Return the memory usage in bytes.\"\"\"","         raise NotImplementedError"," ","+    @classmethod","+    def free_device_memory(cls, device: torch.device | None = None) -> int:","+        \"\"\"Free bytes on device (None: the current one) to size memory from.","+        Platforms whose reported free memory is too low override this.","+        \"\"\"","+        from vllm.utils.mem_utils import device_memory_info","+","+        return device_memory_info(device)[0]","+","     @classmethod","     def get_punica_wrapper(cls) -> str:","         \"\"\"Return the punica wrapper for current platform.\"\"\""],"additions":9,"deletions":0,"truncated":false},{"path":"vllm/platforms/rocm.py","lines":["@@ -17,6 +17,7 @@"," from vllm.logger import init_logger"," from vllm.v1.attention.backends.registry import AttentionBackendEnum"," ","+from . import rocm_device_memory"," from .interface import DeviceCapability, Platform, PlatformEnum, in_wsl"," "," if TYPE_CHECKING:","@@ -1278,6 +1279,11 @@ def get_current_memory_usage(","         torch.cuda.reset_peak_memory_stats(device)","         return torch.cuda.max_memory_allocated(device)"," ","+    @classmethod","+    def free_device_memory(cls, device: torch.device | None = None) -> int:","+        free = rocm_device_memory.exact_free_memory(device)","+        return super().free_device_memory(device) if free is None else free","+","     @classmethod","     def get_device_communicator_cls(cls) -> str:","         return ("],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/platforms/rocm_device_memory.py","lines":["@@ -0,0 +1,180 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Free device memory corrected by amdgpu's exact VRAM count.","+","+hipMemGetInfo counts each allocation as at least 2 MB, so small allocations","+hide free memory; amdgpu's sysfs mem_info_vram_used counts exact sizes.","+\"\"\"","+","+import os","+import time","+","+import torch","+","+from vllm.logger import init_logger","+","+logger = init_logger(__name__)","+","+KFD_TOPOLOGY_NODES = \"/sys/class/kfd/kfd/topology/nodes\"","+DRM_SYSFS = \"/sys/class/drm\"","+# sysfs VRAM total may exceed hipMemGetInfo's total by at most this share.","+VRAM_TOTAL_TOLERANCE = 0.01","+","+","+def _kfd_gpu_nodes(nodes_dir: str) -> list[dict[str, str]]:","+    \"\"\"Properties of the KFD GPU nodes; CPU and malformed nodes are skipped.\"\"\"","+    nodes = []","+    for node in sorted(os.listdir(nodes_dir)):","+        try:","+            # One \"name value\" pair per line.","+            with open(os.path.join(nodes_dir, node, \"properties\")) as f:","+                props = dict(line.split() for line in f if line.strip())","+            if int(props.get(\"simd_count\", 0)) > 0 and \"drm_render_minor\" in props:","+                int(props[\"location_id\"])","+                int(props.get(\"unique_id\", -1))","+                nodes.append(props)","+        except (OSError, KeyError, ValueError):","+            continue","+    return nodes","+","+","+def _pci(props: dict[str, str]) -> tuple[int, int, int]:","+    # location_id is (bus << 8) | (dev << 3) | fn; torch reports no function.","+    loc = int(props[\"location_id\"])","+    return int(props.get(\"domain\", 0)), loc >> 8, (loc >> 3) & 0x1F","+","+","+def _unique_id(uuid: str) -> int | None:","+    # torch's ROCm UUID is the KFD unique_id written as ASCII hex digits.","+    try:","+        return int(bytes.fromhex(uuid.replace(\"-\", \"\")).decode(), 16)","+    except ValueError:","+        return None","+","+","+def find_vram_used_file(","+    uuid: str,","+    pci: tuple[int, int, int],","+    total_memory: int,","+    *,","+    nodes_dir: str = KFD_TOPOLOGY_NODES,","+    drm_dir: str = DRM_SYSFS,","+) -> tuple[str | None, str]:","+    \"\"\"The mem_info_vram_used file of the GPU with this torch UUID and PCI","+    address, and hipMemGetInfo's total_memory; or None and why not.\"\"\"","+    try:","+        nodes = _kfd_gpu_nodes(nodes_dir)","+    except OSError as e:","+        return None, f\"no KFD topology ({e})\"","+    unique_id = _unique_id(uuid)","+    by_uid = [n for n in nodes if int(n.get(\"unique_id\", -1)) == unique_id]","+    by_pci = [n for n in nodes if _pci(n) == pci]","+    if len(by_pci) > 1:","+        # Partitions share one device's VRAM counter.","+        return None, \"partitioned GPU\"","+    if len(by_pci) != 1 or (unique_id is not None and by_uid != by_pci):","+        return None, \"no single KFD node matches the GPU\"","+    device_dir = os.path.join(","+        drm_dir, f\"renderD{by_pci[0]['drm_render_minor']}\", \"device\"","+    )","+    try:","+        with open(os.path.join(device_dir, \"mem_info_vram_total\")) as f:","+            vram_total = int(f.read())","+        with open(os.path.join(device_dir, \"mem_info_vram_used\")) as f:","+            int(f.read())","+    except (OSError, ValueError) as e:","+        return None, f\"no amdgpu VRAM counters ({e})\"","+    # A total far from HIP's means memory HIP sees is not this VRAM (e.g. an","+    # APU's shared memory). Below HIP's would let the cap exceed real VRAM.","+    if not total_memory <= vram_total <= total_memory * (1 + VRAM_TOTAL_TOLERANCE):","+        return None, (","+            f\"VRAM total {vram_total} bytes does not match HIP's {total_memory}\"","+        )","+    return os.path.join(device_dir, \"mem_info_vram_used\"), \"\"","+","+","+# A reading is settled once the memory hidden from free memory has not risen","+# for this long. Freed memory stays in the exact count until the driver has","+# erased it (about 10 ms per GB on an R9700) while free memory shows it free at","+# once, which lowers what appears hidden.","+SETTLE_SECONDS = 0.2","+MAX_SAMPLING_SECONDS = 2.0","+SAMPLE_INTERVAL_SECONDS = 0.002","+","+# mem_info_vram_used per device index, or None where there is none.","+_vram_used_files: dict[int, str | None] = {}","+","+","+def _vram_used_file(index: int) -> str | None:","+    \"\"\"Only unpartitioned discrete GPUs whose VRAM total matches HIP's.\"\"\"","+    if index not in _vram_used_files:","+        props = torch.cuda.get_device_properties(index)","+        if props.is_integrated:","+            path, reason = None, \"integrated GPU\"","+        else:","+            path, reason = find_vram_used_file(","+                str(props.uuid),","+                (props.pci_domain_id, props.pci_bus_id, props.pci_device_id),","+                torch.cuda.mem_get_info(index)[1],","+            )","+        if path is None:","+            logger.debug(","+                \"Using free device memory as HIP reports it, which counts each \"","+                \"allocation as at least 2 MB: %s.\",","+                reason,","+            )","+        _vram_used_files[index] = path","+    return _vram_used_files[index]","+","+","+def _read_used(path: str) -> int | None:","+    try:","+        with open(path) as f:","+            return int(f.read())","+    except (OSError, ValueError):","+        return None","+","+","+def exact_free_memory(device: torch.device | None = None) -> int | None:","+    \"\"\"Free bytes by the exact VRAM count, or None where there is none.","+","+    At least free memory as HIP reports it, plus what that hides: the total less","+    the exact count less HIP's free memory, sampled until it stops rising. An","+    erase still pending afterwards only makes the result smaller. Other","+    processes' allocations lower both counts alike. The exact count leaves out","+    KFD's page-table reserve and RAS pages (about 80 MB on an R9700), which","+    KV_CACHE_MARGIN_FLOOR_BYTES covers.","+    \"\"\"","+    index = (","+        torch.cuda.current_device()","+        if device is None or device.index is None","+        else device.index","+    )","+    path = _vram_used_file(index)","+    if path is None:","+        return None","+    torch.cuda.synchronize(index)","+    start = last_rise = time.monotonic()","+    hidden = 0","+    while True:","+        used = _read_used(path)","+        free, total = torch.cuda.mem_get_info(index)","+        used_after = _read_used(path)","+        if used is None or used_after is None:","+            return None","+        now = time.monotonic()","+        # Skip a sample when another process allocated between the two","+        # counts: free memory would already show it and too much seem hidden.","+        i