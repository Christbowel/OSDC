fPreview' && editorAreaFocus\"","+\t\t\t},","+\t\t\t{","+\t\t\t\t\"command\": \"pdfPreview.goToSection\",","+\t\t\t\t\"key\": \"ctrl+shift+o\",","+\t\t\t\t\"mac\": \"cmd+shift+o\",","+\t\t\t\t\"when\": \"activeCustomEditorId == 'vscode.pdfPreview' && editorAreaFocus\"","+\t\t\t}","+\t\t]","+\t},","+\t\"scripts\": {","+\t\t\"compile\": \"gulp compile-extension:pdf-preview && pnpm run build-webview\",","+\t\t\"watch\": \"pnpm run build-webview && gulp watch-extension:pdf-preview\",","+\t\t\"vscode:prepublish\": \"pnpm run build-ext && pnpm run build-webview\",","+\t\t\"build-ext\": \"node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.mjs compile-extension:pdf-preview ./tsconfig.json\",","+\t\t\"build-webview\": \"node ./esbuild.webview.mts\",","+\t\t\"compile-web\": \"npm-run-all2 -lp bundle-web typecheck-web\",","+\t\t\"bundle-web\": \"node ./esbuild.browser.mts\",","+\t\t\"typecheck-web\": \"node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.browser.json --noEmit\",","+\t\t\"watch-web\": \"npm-run-all2 -lp watch-bundle-web watch-typecheck-web\",","+\t\t\"watch-bundle-web\": \"node ./esbuild.browser.mts --watch\",","+\t\t\"watch-typecheck-web\": \"node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.browser.json --noEmit --watch\"","+\t},","+\t\"dependencies\": {","+\t\t\"pdfjs-dist\": \"6.4.299\"","+\t},","+\t\"devDependencies\": {","+\t\t\"@types/node\": \"24.x\",","+\t\t\"@types/vscode-webview\": \"^1.57.0\"","+\t},","+\t\"repository\": {","+\t\t\"type\": \"git\",","+\t\t\"url\": \"https://github.com/microsoft/vscode.git\"","+\t}","+}"],"additions":215,"deletions":0,"truncated":false},{"path":"extensions/pdf-preview/package.nls.json","lines":["@@ -0,0 +1,15 @@","+{","+\t\"displayName\": \"PDF Preview\",","+\t\"description\": \"Provides a built-in preview for PDF files.\",","+\t\"customEditor.accessibilityHelpContent\": \"The PDF preview shows the pages of a PDF file. You can read and select their text and follow links. The commands of the preview are in the status bar, in the editor title and in the Command Palette:\\n- Find<keybinding:pdfPreview.find> searches the whole document and shows the number of matches. Press Enter for the next match and Escape to close the find input.\\n- Find Next<keybinding:pdfPreview.findNext> and Find Previous<keybinding:pdfPreview.findPrevious> continue the last search.\\n- Go to Page<keybinding:pdfPreview.goToPage> moves to a page by its number or label.\\n- Go to Section<keybinding:pdfPreview.goToSection> moves to a section of the document's outline.\\n- Select Zoom Level<keybinding:pdfPreview.selectZoom>, Zoom In<keybinding:pdfPreview.zoomIn> and Zoom Out<keybinding:pdfPreview.zoomOut> change the size of the pages.\\n- Save As<keybinding:workbench.action.files.saveAs> saves a copy of the file.\",","+\t\"command.category\": \"PDF\",","+\t\"command.zoomIn\": \"Zoom In\",","+\t\"command.zoomOut\": \"Zoom Out\",","+\t\"command.selectZoom\": \"Select Zoom Level...\",","+\t\"command.goToPage\": \"Go to Page...\",","+\t\"command.goToSection\": \"Go to Section...\",","+\t\"command.find\": \"Find\",","+\t\"command.findNext\": \"Find Next\",","+\t\"command.findPrevious\": \"Find Previous\",","+\t\"command.saveAs\": \"Save As...\"","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"extensions/pdf-preview/preview-src/index.css","lines":["@@ -0,0 +1,49 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+#viewerContainer {","+\tposition: absolute;","+\tinset: 0;","+\toverflow: auto;","+\toutline: none;","+\tbackground-color: var(--vscode-editor-background);","+\t/* Outline the pages instead of the wide transparent border of pdf.js, so that they stand out in light themes */","+\t--page-border: 0 solid transparent;","+\t--page-margin: 8px auto;","+}","+","+.pdfViewer .page {","+\tbox-shadow: 0 0 0 1px var(--vscode-widget-border, transparent), 0 1px 6px var(--vscode-widget-shadow, transparent);","+}","+","+.textLayer .highlight {","+\t--highlight-bg-color: var(--vscode-editor-findMatchHighlightBackground);","+\t--highlight-selected-bg-color: var(--vscode-editor-findMatchBackground);","+\toutline: 1px dotted var(--vscode-editor-findMatchHighlightBorder, transparent);","+}","+","+/* The find colors of some themes are opaque: blend them with the page so that they don't cover its text */","+body:not(.vscode-high-contrast) .textLayer {","+\tmix-blend-mode: multiply;","+}","+","+.textLayer .highlight.selected {","+\toutline: 1px solid var(--vscode-editor-findMatchBorder, transparent);","+}","+","+#message {","+\tposition: absolute;","+\tinset: 0;","+\tdisplay: flex;","+\talign-items: center;","+\tjustify-content: center;","+\tpadding: 20px;","+\ttext-align: center;","+\tbackground-color: var(--vscode-editor-background);","+}","+","+#message:empty {","+\tdisplay: none;","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"extensions/pdf-preview/preview-src/index.ts","lines":["@@ -0,0 +1,209 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { AnnotationEditorType, AnnotationMode, getDocument, GlobalWorkerOptions, PasswordResponses, type PDFDocumentLoadingTask, type PDFDocumentProxy } from 'pdfjs-dist';","+import { EventBus, PDFFindController, PDFLinkService, PDFViewer } from 'pdfjs-dist/web/pdf_viewer.mjs';","+import 'pdfjs-dist/web/pdf_viewer.css';","+import './index.css';","+","+type ExtensionMessage =","+\t| { readonly type: 'load'; readonly data: Uint8Array }","+\t| { readonly type: 'message'; readonly text: string; readonly load?: number }","+\t| { readonly type: 'password'; readonly password: string; readonly load: number }","+\t| { readonly type: 'zoom'; readonly value: number | string }","+\t| { readonly type: 'goToPage'; readonly page: string }","+\t| { readonly type: 'goToSection'; readonly index: number }","+\t| { readonly type: 'find'; readonly query: string; readonly again: boolean; readonly previous: boolean }","+\t| { readonly type: 'findClose' };","+","+type Destination = string | unknown[];","+","+const vscode = acquireVsCodeApi<{ readonly location: string }>();","+const assets = new URL('pdfjs/', import.meta.url).href;","+const container = document.getElementById('viewerContainer') as HTMLDivElement;","+const message = document.getElementById('message')!;","+","+// The worker can't load files through the service worker of the webview, so start it from its","+// source and let pdf.js load CMaps and fonts on the page (`useWorkerFetch: false`)","+const workerStarted = fetch(`${assets}pdf.worker.min.mjs`).then(response => response.text()).then(source => {","+\tGlobalWorkerOptions.workerPort = new Worker(URL.createObjectURL(new Blob([source], { type: 'text/javascript' })), { type: 'module' });","+});","+","+const eventBus = new EventBus();","+const linkService = new PDFLinkService({ eventBus });","+const style = getComputedStyle(document.documentElement);","+const viewer = new PDFViewer({","+\tcontainer,","+\teventBus,","+\tlinkService,","+\tfindController: new PDFFindController({ eventBus, linkService }),","+\tannotationMode: AnnotationMode.ENABLE,","+\tannotationEditorMode: AnnotationEditorType.DISABLE,","+\timageResourcesPath: new URL('images/', import.meta.url).href,","+\t// Show documents in the colors of high contrast themes, like other editors","+\tpageColors: document.body.className.includes('vscode-high-contrast')","+\t\t? { background: style.getPropertyValue('--vscode-editor-background'), foreground: style.getPropertyValue('--vscode-editor-foreground') }","+\t\t: undefined,","+});","+linkService.setViewer(viewer);","+","+let loadingTask: PDFDocumentLoadingTask | undefined;","+let loads = Promise.resolve();","+let latestLoad = 0;","+let sectionDestinations: Destination[] = [];","+let setPassword: ((password: string) => void) | undefined;","+","+async function load(data: Uint8Array, id: number): Promise<void> {","+\tawait workerStarted;","+\t// Documents share the worker, which pdf.js only allows once the previous document is destroyed","+\tawait loadingTask?.destroy();","+\tif (id !== latestLoad) {","+\t\treturn; // A newer version of the file arrived meanwhile","+\t}","+\t// No `wasmUrl`: the preview doesn't ship the image decoders (see esbuild.webview.mts), so JPEG","+\t// 2000 and JBIG2 images don't show, but the rest of the page does","+\tconst task = loadingTask = getDocument({","+\t\tdata,","+\t\tcMapUrl: `${assets}cmaps/`,","+\t\tstandardFontDataUrl: `${assets}standard_fonts/`,","+\t\tuseWorkerFetch: false,","+\t\tenableXfa: false,","+\t});","+\ttask.onPassword = (callback: (password: string) => void, reason: number) => {","+\t\tsetPassword = callback;","+\t\tvscode.postMessage({ type: 'password', incorrect: reason === PasswordResponses.INCORRECT_PASSWORD, load: id });","+\t};","+","+\ttry {","+\t\tconst pdfDocument = await task.promise;","+\t\t// Restore the position after a reload or after the editor was hidden","+\t\tconst location = vscode.getState()?.location;","+\t\tconst restore = () => {","+\t\t\tviewer.currentScaleValue = 'auto';","+\t\t\tif (location) {","+\t\t\t\t// The new version of the file may have fewer pages","+\t\t\t\tlinkService.setHash(location.replace(/^page=\\d+/, page => `page=${Math.min(Number(page.slice(5)), pdfDocument.numPages)}`));","+\t\t\t}","+\t\t};","+\t\teventBus.on('pagesinit', () => {","+\t\t\trestore();","+\t\t\t// Until all pages are known, pages have the size of the first one, so like the viewer of","+\t\t\t// pdf.js, restore the position again when some pages have another size","+\t\t\tvoid viewer.pagesPromise?.then(() => location && !viewer.hasEqualPageSizes && id === latestLoad && restore());","+\t\t}, { once: true });","+\t\tviewer.setDocument(pdfDocument);","+\t\tlinkService.setDocument(pdfDocument);","+\t\tmessage.textContent = '';","+","+\t\tconst [pageLabels, sections] = await Promise.all([pdfDocument.getPageLabels(), getSections(pdfDocument)]);","+\t\tviewer.setPageLabels(pageLabels);","+\t\tsectionDestinations = sections.map(section => section.destination);","+\t\tvscode.postMessage({ type: 'loaded', pageCount: pdfDocument.numPages, pageLabels, outline: sections.map(({ title, level, page }) => ({ title, level, page })) });","+\t} catch {","+\t\t// Unless a newer document replaced this one","+\t\tif (!task.destroyed) {","+\t\t\tvscode.postMessage({ type: 'error' });","+\t\t}","+\t}","+}","+","+/**","+ * Returns the sections of the outline of `pdfDocument` that point to a place in the document.","+ */","+async function getSections(pdfDocument: PDFDocumentProxy) {","+\tconst sections: { title: string; level: number; destination: Destination }[] = [];","+\tconst visit = (items: Awaited<ReturnType<PDFDocumentProxy['getOutline']>> | null, level: number) => {","+\t\tfor (const item of items ?? []) {","+\t\t\tif (item.dest) {","+\t\t\t\tsections.push({ title: item.title, level, destination: item.dest });","+\t\t\t}","+\t\t\tvisit(item.items, level + 1);","+\t\t}","+\t};","+\tvisit(await pdfDocument.getOutline(), 0);","+\treturn Promise.all(sections.map(async section => ({ ...section, page: await getPageNumber(pdfDocument, section.destination).catch(() => undefined) })));","+}","+","+async function getPageNumber(pdfDocument: PDFDocumentProxy, destination: Destination): Promise<number> {","+\tconst [page] = (typeof destination === 'string' ? await pdfDocument.getDestination(destination) : destination) ?? [];","+\treturn typeof page === 'number' ? page + 1 : await pdfDocument.getPageIndex(page as Parameters<PDFDocumentProxy['getPageIndex']>[0]) + 1;","+}","+","+let view = '';","+eventBus.on('updateviewarea', ({ location }: { location: { pageNumber: number; pdfOpenParams: string } }) => {","+\tvscode.setState({ location: location.pdfOpenParams.slice(1) });","+\t// Scrolling within a page changes neither the page nor the zoom","+\tconst current = `${location.pageNumber} ${viewer.currentScale}`;","+\tif (current !== view) {","+\t\tview = current;","+\t\tvscode.postMessage({ type: 'view', page: location.pageNumber, scale: viewer.currentScale });","+\t}","+});","+for (const event of ['updatefindmatchescount', 'updatefindcontrolstate']) {","+\teventBus.on(event, ({ matchesCount }: { matchesCount: { current: number; total: number } }) => vscode.postMessage({ type: 'find', ...matchesCount }));","+}","+","+window.addEventListener('message', ({ data }: MessageEvent<ExtensionMessage>) => {","+\tswitch (data.type) {","+\t\tcase 'load': {","+\t\t\tconst id = ++latestLoad;","+\t\t\t// A document that waits for its password would hold up the next one","+\t\t\tvoid loadingTask?.destroy();","+\t\t\tloads = loads.then(() => load(data.data, id)).catch(() => vscode.postMessage({ type: 'error' }));","+\t\t\tbreak;","+\t\t}","+\t\tcase 'message':","+\t\t\tif (data.load === undefined || data.load === latestLoad) {","+\t\t\t\tmessage.textContent = data.text;","+\t\t\t}","+\t\t\tbreak;","+\t\tcase 'password':","+\t\t\tif (data.load === latestLoad) {","+\t\t\t\tsetPassword?.(data.password);","+\t\t\t}","+\t\t\tbreak;","+\t\tcase 'zoom':","+\t\t\tif (typeof data.value === 'number') {","+\t\t\t\tviewer.updateScale({ steps: data.value });","+\t\t\t} else {","+\t\t\t\tviewer.currentScaleValue = data.value;","+\t\t\t}","+\t\t\tbreak;","+\t\tcase 'goToPage':","+\t\t\tviewer.currentPageLabel = data.page;","+\t\t\tbreak;","+\t\tcase 'goToSection':","+\t\t\tvoid linkService.goToDestination(sectionDestinations[data.index]);","+\t\t\tbreak;","+\t\tcase 'find':","+\t\t\teventBus.dispatch('find', { source: null, type: data.again ? 'again' : '', query: data.query, caseSensitive: false, entireWord: false, highlightAll: true, findPrevious: data.previous, matchDiacritics: false });","+\t\t\tbreak;","+\t\tcase 'findClose':","+\t\t\teventBus.dispatch('findbarclose', { source: null });","+\t\t\tbreak;","+\t}","+});","+","+// Zoom with Ctrl or Cmd and the mouse wheel, which is also what pinching on a trackpad sends","+container.addEventListener('wheel', event => {","+\tif (event.ctrlKey || event.metaKey) {","+\t\tevent.preventDefault();","+\t\tviewer.updateScale({ scaleFactor: Math.exp(-Math.max(-25, Math.min(25, event.deltaY)) / 100), origin: [event.clientX, event.clientY], drawingDelay: 400 });","+\t}","+}, { passive: false });","+","+// Fit the pages to the editor again when it is resized","+window.addEventListener('resize', () => {","+\tconst scale = viewer.currentScaleValue;","+\tif (scale === 'auto' || scale === 'page-width' || scale === 'page-fit') {","+\t\tviewer.currentScaleValue = scale;","+\t}","+\tviewer.update();","+});","+","+// Keyboard navigation scrolls the focused element, so move focus from the webview to the document","+window.addEventListener('focus', () => container.focus());","+","+vscode.postMessage({ type: 'ready' });"],"additions":209,"deletions":0,"truncated":false},{"path":"extensions/pdf-preview/preview-src/tsconfig.json","lines":["@@ -0,0 +1,16 @@","+{","+\t\"extends\": \"../../tsconfig.base.json\",","+\t\"compilerOptions\": {","+\t\t\"module\": \"esnext\",","+\t\t\"moduleResolution\": \"bundler\",","+\t\t\"noUncheckedSideEffectImports\": false,","+\t\t\"lib\": [","+\t\t\t\"ES2024\",","+\t\t\t\"DOM\",","+\t\t\t\"DOM.Iterable\"","+\t\t],","+\t\t\"types\": [","+\t\t\t\"vscode-webview\"","+\t\t]","+\t}","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"extensions/pdf-preview/src/extension.ts","lines":["@@ -0,0 +1,344 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import * as vscode from 'vscode';","+","+interface PdfSection {","+\treadonly title: string;","+\treadonly level: number;","+\treadonly page: number | undefined;","+}","+","+type WebviewMessage =","+\t| { readonly type: 'ready' }","+\t| { readonly type: 'loaded'; readonly pageCount: number; readonly pageLabels: readonly string[] | null; readonly outline: readonly PdfSection[] }","+\t| { readonly type: 'view'; readonly page: number; readonly scale: number }","+\t| { readonly type: 'find'; readonly current: number; readonly total: number }","+\t| { readonly type: 'password'; readonly incorrect: boolean; readonly load: number }","+\t| { readonly type: 'error' };","+","+type ExtensionMessage =","+\t| { readonly type: 'load'; readonly data: Uint8Array }","+\t| { readonly type: 'message'; readonly text: string; readonly load?: number }","+\t| { readonly type: 'password'; readonly password: string; readonly load: number }","+\t| { readonly type: 'zoom'; readonly value: number | string }","+\t| { readonly type: 'goToPage'; readonly page: string }","+\t| { readonly type: 'goToSection'; readonly index: number }","+\t| { readonly type: 'find'; readonly query: string; readonly again: boolean; readonly previous: boolean }","+\t| { readonly type: 'findClose' };","+","+// Quick input shows one prompt at a time, so a new one would close the one shown, e.g. in a diff of"],"additions":32,"deletions":0,"truncated":false}],"additions":652,"deletions":2,"truncated":true,"file_count":19},"error":null,"fetched_at":"2026-11-27T19:02:54.091793+00:00"}