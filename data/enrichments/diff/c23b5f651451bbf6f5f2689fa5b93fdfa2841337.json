\"mlir/Dialect/Vector/IR/VectorOps.h\"","+ #include \"mlir/Dialect/Vector/Transforms/IndexedAccessOpInterfaceImpl.h\"","+@@ -85,6 +88,7 @@","+     ptr::PtrDialect,","+     scf::SCFDialect,","+     tensor::TensorDialect,","++    ub::UBDialect,","+     vector::VectorDialect,","+     cuda_tile::CudaTileDialect,","+     nv_tensor_ir::TensorIRDialect","+@@ -103,12 +107,14 @@","+   // Register ConvertToLLVM interfaces for every upstream dialect above that","+   // provides one.","+   arith::registerConvertArithToLLVMInterface(registry);","++  registerConvertComplexToLLVMInterface(registry);","+   registerConvertFuncToLLVMInterface(registry);","+   cf::registerConvertControlFlowToLLVMInterface(registry);","+   gpu::registerConvertGpuToLLVMInterface(registry);","+   registerConvertMathToLLVMInterface(registry);","+   registerConvertMemRefToLLVMInterface(registry);","+   ptr::registerConvertPtrToLLVMInterface(registry);","++  ub::registerConvertUBToLLVMInterface(registry);","+   vector::registerConvertVectorToLLVMInterface(registry);","+ ","+   // Register bufferization models used by the Linalg pipeline.","+diff --git a/lib/Transform/HostToLLVM.cpp b/lib/Transform/HostToLLVM.cpp","+--- a/lib/Transform/HostToLLVM.cpp","+@@ -6,6 +6,7 @@","+ #include \"tensor_ir/Transform/Passes.h\" // IWYU pragma: keep","+ ","+ #include \"mlir/Analysis/DataLayoutAnalysis.h\"","++#include \"mlir/Conversion/ArithCommon/CeilFloorDivExpansion.h\"","+ #include \"mlir/Conversion/ArithToLLVM/ArithToLLVM.h\"","+ #include \"mlir/Conversion/ControlFlowToLLVM/ControlFlowToLLVM.h\"","+ #include \"mlir/Conversion/FuncToLLVM/ConvertFuncToLLVM.h\"","+diff --git a/test/Dialect/exp-rounding-mode.mlir b/test/Dialect/exp-rounding-mode.mlir","+--- a/test/Dialect/exp-rounding-mode.mlir","+@@ -5,7 +5,7 @@","+ // CHECK-LABEL: nv_tensor_ir.graph @different_policies(","+ // CHECK-SAME: %[[INPUT:.*]]: tensor<128xf32>","+ // CHECK: %[[FULL:.*]] = exp %[[INPUT]] : tensor<128xf32>","+-// CHECK: %[[APPROX:.*]] = exp %[[IN