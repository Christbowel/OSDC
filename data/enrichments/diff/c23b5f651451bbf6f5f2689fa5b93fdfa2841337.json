{"id":"c23b5f651451bbf6f5f2689fa5b93fdfa2841337","axis":"silent","repo":"tensorflow/tensorflow","sha":"c23b5f651451bbf6f5f2689fa5b93fdfa2841337","parsed":{"files":[{"path":"third_party/xla/third_party/tensor_ir/patches/cuda_tile_test_fixes.patch","lines":["rename from third_party/xla/third_party/tensor_ir/patches/pow_op.patch","rename to third_party/xla/third_party/tensor_ir/patches/cuda_tile_test_fixes.patch","@@ -1,15 +1,3 @@","-diff --git a/lib/Conversion/TensorToCudaTile/OutlinedComputeOps.cpp b/lib/Conversion/TensorToCudaTile/OutlinedComputeOps.cpp","-+++ b/lib/Conversion/TensorToCudaTile/OutlinedComputeOps.cpp","-@@ -293,7 +293,7 @@","-                 getSignedness(exponentType),","-                 cuda_tile::RoundingMode::NEAREST_EVEN);","-           }","--          rewriter.replaceOpWithNewOp<cuda_tile::PowOp>(op, operands[0], rhs);","-+          rewriter.replaceOpWithNewOp<cuda_tile::FPowFOp>(op, operands[0], rhs);","-           return success();","-         })","-         .Case<Atan2Op>([&](auto) {"," diff --git a/test/Conversion/TensorToCudaTile/iterspace_matmul.mlir b/test/Conversion/TensorToCudaTile/iterspace_matmul.mlir"," --- a/test/Conversion/TensorToCudaTile/iterspace_matmul.mlir"," +++ b/test/Conversion/TensorToCudaTile/iterspace_matmul.mlir"],"additions":0,"deletions":11,"truncated":false},{"path":"third_party/xla/third_party/tensor_ir/patches/llvm_compat.patch","lines":["@@ -0,0 +1,118 @@","+diff --git a/include/tensor_ir/Dialect/TensorDialect.td b/include/tensor_ir/Dialect/TensorDialect.td","+--- a/include/tensor_ir/Dialect/TensorDialect.td","+@@ -111,6 +111,7 @@","+ ","+   // Add this line when we define attributes in this dialect.","+   let useDefaultAttributePrinterParser = 1;","++  let useStrictPropertiesInAssemblyFormat = 0;","+   // OSS has no dialect-defined types, so TableGen emits no type parser/printer","+   // bodies. Only declare the overrides when their type definitions are present.","+   let hasOperationAttrVerify = 1;","+diff --