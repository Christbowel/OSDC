ymbolAttrName());","-+  auto moduleName = module->getAttrOfType<mlir::StringAttr>(\"sym_name\");","-   return moduleName ? moduleName.getValue().str() : \"tensor_ir_rtk\";","- }","- ","-diff --git a/lib/Utils/Utils.cpp b/lib/Utils/Utils.cpp","-+++ b/lib/Utils/Utils.cpp","-@@ -311,8 +311,8 @@ FailureOr<llvm::hash_code> getModuleHash","-   // Anonymize symbols to ignore symbol name discrepancy among modules","-   size_t symNameCounter = 0;","-   auto walkResult =","--      clonedModuleOp->walk<WalkOrder::PreOrder>([&](Operation *op) {","--        if (op->hasAttr(SymbolTable::getSymbolAttrName())) {","-+      clonedModuleOp->walk<WalkOrder::PreOrder>([&](Operation* op) {","-+        if (op->hasAttr(\"sym_name\")) {","-           StringAttr oldName = SymbolTable::getSymbolName(op);","- ","-           // Generate new anonymized name and replace all uses of the symbol"],"additions":0,"deletions":47,"truncated":false},{"path":"third_party/xla/third_party/tensor_ir/patches/tiling_analysis.patch","lines":["@@ -1,2749 +0,0 @@","-Add the tiling analysis (architecture info, tiling enumeration and cost","-model evaluation) imported from dynamic-kernel-generator/tensor_ir.","-","-diff --git a/include/tensor_ir/Analysis/Tiling/Arch.h b/include/tensor_ir/Analysis/Tiling/Arch.h","-new file mode 100644","-index 0000000..4becf41","-+++ b/include/tensor_ir/Analysis/Tiling/Arch.h","-@@ -0,0 +1,57 @@","-+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.","-+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception","-+","-+#ifndef TENSOR_IR_ANALYSIS_TILING_ARCH_H_","-+#define TENSOR_IR_ANALYSIS_TILING_ARCH_H_","-+","-+#include \"tensor_ir/Dialect/TensorIRAttrs.h\"","-+","-+namespace mlir::nv_tensor_ir {","-+namespace tiling_analysis {","-+","-+/// Common parameters for all GPU architectures.","-+/// Number of threads per warp.","-+constexpr int kWarpSize = 32;","-+/// Size of a memory sector in bytes.","-+constexpr int kMemorySectorSize = 32;","-+/// Maximum number of registers per thread.","-+constexpr int kMaxRegistersPerThread = 255;","-+/// Maximum number of registers per SM.","-+constexpr int kMaxRegistersPerSM = 65536;","-+/// Size of a register in bytes.","-+constexpr int kRegisterSize = 4;","-+","-+/// Tensor core versions (bit values).","-+enum TensorCoreVersion {","-+  kMMAv2 = 1 << 2,","-+  kMMAv3 = 1 << 3,","-+  kMMAv5 = 1 << 5,","-+};","-+","-+/**","-+ * @brief GPU architecture information.","-+ */","-+struct ArchInfo {","-+  /// Number of Streaming Multiprocessors (SMs).","-+  int numSMs = 0;","-+  /// Maximum number of resident blocks per SM.","-+  int maxBlocksPerSM;","-+  /// Maximum number of resident warps per SM.","-+  int maxWarpsPerSM;","-+  /// Maximum amount of shared memory per SM (in KB).","-+  int maxSharedMemoryPerSM;","-+  /// Supported tensor core versions (bit mask).","-+  int tensorCoreVersions;","-+};","-+","-+/**","-+ * @brief Get the architecture information for a given compute capability.","-+ * @param cc Compute capability.","-+ * @param numSMs Number of Streaming Multiprocessors (SMs).","-+ */","-+ArchInfo getArchInfo(ComputeCapability cc, int numSMs);","-+","-+} // namespace tiling_analysis","-+} // namespace mlir::nv_tensor_ir","-+","-+#endif // TENSOR_IR_ANALYSIS_TILING_ARCH_H_","-diff --git a/include/tensor_ir/Analysis/Tiling/Enumerate.h b/include/tensor_ir/Analysis/Tiling/Enumerate.h","-new file mode 100644","-index 0000000..ade5641","-+++ b/include/tensor_ir/Analysis/Tiling/Enumerate.h","-@@ -0,0 +1,25 @@","-+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.","-+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception","-+","-+#ifndef TENSOR_IR_ANALYSIS_TILING_ENUMERATE_H_","-+#define TENSOR_IR_ANALYSIS_TILING_ENUMERATE_H_","-+","-+#include \"tensor_ir/Analysis/Tiling/Evaluate.h\"","-+","-+#include \"mlir/Support/LLVM.h\"","-+","-+namespace mlir::nv_tensor_ir {","-+namespace tiling_analysis {","-+","-+/**","-+  * @brief Get the tiling configurations in the evaluator scope.","-+  * @param evaluator The tiling config evaluator.","-+  * @param maxResults The maximum number of results to return.","-+  */","-+SmallVector<TilingConfig> enumerateTilings(TilingEvaluator &evaluator,","-+                                           size_t maxResults = 1000);","-+","-+} // namespace tiling_analysis","-+} // namespace mlir::nv_tensor_ir","-+","-+#endif // TENSOR_IR_ANALYSIS_TILING_ENUMERATE_H_","-diff --git a/include/tensor_ir/Analysis/Tiling/Evaluate.h b/include/tensor_ir/Analysis/Tiling/Evaluate.h","-new file mode 100644","-index 0000000..403592b","-+++ b/include/tensor_ir/Analysis/Tiling/Evaluate.h","-@@ -0,0 +1,191 @@","-+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.","-+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception","-+","-+#ifndef TENSOR_IR_ANALYSIS_TILING_EVALUATE_H_","-+#define TENSOR_IR_ANALYSIS_TILING_EVALUATE_H_","-+","-+#include \"tensor_ir/Analysis/Tiling/Arch.h\"","-+#include \"tensor_ir/Dialect/TensorIR.h\"","-+","-+#include \"mlir/Support/LLVM.h\"","-+","-+#include <array>","-+#include <cstdint>","-+#include <utility>","-+","-+/// Tiling evaluator: an analytical cost model for tiling a TensorIR graph.","-+///","-+/// A graph is executed as a grid of blocks, where each block computes one tile","-+/// of the main iteration space. The evaluator estimates the per-block costs of","-+/// a tiling configuration, so that configurations can be ranked without","-+/// generating code. It does not produce timings; the results are only","-+/// meaningful relative to other configurations.","-+///","-+/// The graph must have been processed by the layout propagation and","-+/// normalization passes. The evaluator reads the layouts attached to the graph","-+/// terminator (`iteration_space`, and `result_layouts` and `result_views` for","-+/// multi-output graphs), which describe the memory accesses of the graph as a","-+/// tree of tensor, composite, concat, reduction and matmul sources.","-+///","-+/// A tiling configuration consists of:","-+///","-+/// - The tile shape, with one power-of-two size per dimension of the main","-+///   iteration space. Reduced and contracting dimensions are not part of the","-+///   iteration space. Concat dimensions must have unit tile size.","-+/// - The reduction tile size, the number of elements of the reduced (or","-+///   contracting) dimensions processed per loop iteration. It is distributed","-+///   between these dimensions.","-+///","-+/// The evaluation estimates:","-+///","-+/// - The number of blocks covering the iteration space.","-+/// - The register and shared memory storage, as the peak over the iteration","-+///   spaces. The register storage assumes that every live value of a tile is","-+///   kept in registers.","-+/// - The number of memory accesses and accessed sectors (loads and stores),","-+///   the number of loop iterations over the reduction tiles, and the number of","-+///   tensor core operations per MMA generation.","-+///","-+/// Typical use:","-+///","-+///   auto evaluator = TilingEvaluator::create(graph, archInfo);","-+///   if (failed(evaluator)) return failure();","-+///   for (const TilingConfig &config : candidates) {","-+///     if (auto eval = evaluator->evaluate(config); succeeded(eval)) { ... }","-+///   }","-+///","-+/// `create` fails with a diagnostic when the layouts are missing or do not","-+/// match the graph. `evaluate` fails silently for invalid configurations, and","-+/// with a diagnostic for layouts that cannot be evaluated with the given tile","-+/// shape (e.g. non-unit concat dimensions).","-+","-+namespace mlir::nv_tensor_ir {","-+namespace tiling_analysis {","-+","-+/**","-+ * @brief Tiling configuration.","-+ */","-+class TilingConfig {","-+public:","-+  /// Returns the tiling config, if the tile sizes are valid.","-+  static FailureOr<TilingConfig> get(SmallVector<int32_t> tileShape,","-+                                     int32_t reductionTileSize);","-+","-+  ArrayRef<int32_t> getTileShape() const { return tileShape; }","-+  int32_t getReductionTileSize() const { return reductionTileSize; }","-+","-+  friend llvm::raw_ostream &operator<<(llvm::raw_ostream &os,","-+                                       const TilingConfig &config);","-+","-+private:","-+  TilingConfig(SmallVector<int32_t> tileShape, int32_t reductionTileSize)","-+      : tileShape(std::move(tileShape)), reductionTileSize(reductionTileSize) {}","-+","-+  /// Tile shape for the main iteration space, for example [16,32,64]","-+  SmallVector<int32_t> tileShape;","-+  /// Reduction tile size for reduction/matmul operations.","-+  int32_t reductionTileSize = 1;","-+","-+  friend class TilingLayoutIterator;","-+  friend class EvaluationLayoutIterator;","-+};","-+","-+/**","-+ * @brief Tiling evaluation result.","-+ */","-+struct TilingEvaluation {","-+  /// Number of execution blocks.","-+  int64_t blockCount = 1;","-+","-+  /// Estimate register storage size for the tiles.","-+  int64_t registerStorageBytes = 0;","-+","-+  /// Estimate shared memory storage size for the tiles.","-+  int64_t sharedStorageBytes = 0;","-+","-+  /// Number of memory accesses (loads/stores).","-+  int64_t memoryAccessCount = 0;","-+","-+  /// Estimate cost of memory accesses (~number of sectors).","-+  int64_t memoryAccessCost = 0;","-+","-+  /// Number of loop iterations.","-+  int64_t loopIterationCount = 0;","-+","-+  /// Number of TensorCore MMA operations (v2/v3/v5).","-+  std::array<int64_t, 3> mmaOperationCount = {0, 0, 0};","-+","-+  /// Returns true if this tiling is expected to run faster than `other`.","-+  /// The total memory traffic is the main criterion, followed by the loop","-+  /// iterations, the number of blocks and the tensor core generation. Only","-+  /// evaluations of the same graph and architecture are comparable.","-+  bool operator<(const TilingEvaluation &other) const;","-+","-+  friend llvm::raw_ostream &operator<<(llvm::raw_ostream &os,","-+                                       const TilingEvaluation &eval);","-+};","-+","-+/**","-+ * @brief Tiling evaluator implementation.","-+ */","-+class TilingEvaluator {","-+public:","-+  /**","-+   * @brief Construct a new TilingEvaluator object.","-+   * @param graph The graph to evaluate.","-+   * @param archInfo The architecture information.","-+   */","-+  static FailureOr<TilingEvaluator> create(GraphOp graph,","-+                                           const ArchInfo &archInfo);","-+","-+  /**","-+   * @brief Evaluate the tiling configuration for the current graph.","-+   * @param config The tiling configuration.","-+   */","-+  FailureOr<TilingEvaluation> evaluate(const TilingConfig &config);","-+","-+  /// Basic getters.","-+  GraphOp getGraph() const { return graph; }","-+  const ArchInfo &getArchInfo() const { return archInfo; }","-+  LayoutSourceAttrInterface getInputLayout() const { return inputLayout; }","-+  LayoutSourceAttrInterface getOutputLayout() const { return outputLayout; }","-+","-+private:","-+  TilingEvaluator(GraphOp graph, ArchInfo archInfo,","-+                  LayoutSourceAttrInterface inputLayout,","-+                  LayoutSourceAttrInterface outputLayout,","-+                  DenseMap<LayoutSourceAttrInterface, Operation *> pivots,","-+                  DenseMap<Operation *, SmallVector<int>> liveSizes)","-+      : graph(graph), archInfo(archInfo), inputLayout(inputLayout),","-+        outputLayout(outputLayout), pivots(std::move(pivots)),","-+        liveSizes(std::move(liveSizes)) {}","-+","-+  GraphOp graph;","-+  ArchInfo archInfo;","-+  LayoutSourceAttrInterface inputLayout;","-+  LayoutSourceAttrInterface outputLayout;","-+  DenseMap<LayoutSourceAttrInterface, Operation *> pivots;","-+  DenseMap<Operation *, SmallVector<int>> liveSizes;","-+","-+  friend class EvaluationLayoutIterator;","-+};","-+","-+/**","-+ * @brief Layout tree iterator (base class).","-+ */","-+class LayoutIterator {","-+public:","-+  virtual ~LayoutIterator() = default;","-+  LogicalResult dispatch(LayoutSourceAttrInterface layout);","-+","-+  virtual LogicalResult processTensor(TensorSourceAttr tensor);","-+  virtual LogicalResult processComposite(CompositeSourceAttr composite);","-+  virtual LogicalResult processConcat(ConcatSourceAttr concat);","-+  virtual LogicalResult processReduction(ReductionSourceAttr reduction);","-+  virtual LogicalResult processMatmul(MatmulSourceAttr matmul);","-+};","-+","-+} // namespace tiling_analysis","-+} // namespace mlir::nv_tensor_ir","-+","-+#endif // TENSOR_IR_ANALYSIS_TILING_EVALUATE_H_","-diff --git a/lib/Analysis/Tiling/Arch.cpp b/lib/Analysis/Tiling/Arch.cpp","-new file mode 100644","-index 0000000..d11d8cb","-+++ b/lib/Analysis/Tiling/Arch.cpp","-@@ -0,0 +1,128 @@","-+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.","-+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception","-+","-+#include \"tensor_ir/Analysis/Tiling/Arch.h\"","-+","-+namespace mlir::nv_tensor_ir {","-+namespace tiling_analysis {","-+namespace {","-+","-+static const ArchInfo archInfoSm80 = {","-+    .maxBlocksPerSM = 32,","-+    .maxWarpsPerSM = 64,","-+    .maxSharedMemoryPerSM = 164,","-+    .tensorCoreVersions = kMMAv2,","-+};","-+","-+static const ArchInfo archInfoSm86 = {","-+    .maxBlocksPerSM = 16,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 100,","-+    .tensorCoreVersions = kMMAv2,","-+};","-+","-+static const ArchInfo archInfoSm87 = {","-+    .maxBlocksPerSM = 16,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 164,","-+    .tensorCoreVersions = kMMAv2,","-+};","-+","-+static const ArchInfo archInfoSm89 = {","-+    .maxBlocksPerSM = 24,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 100,","-+    .tensorCoreVersions = kMMAv2,","-+};","-+","-+static const ArchInfo archInfoSm90 = {","-+    .maxBlocksPerSM = 32,","-+    .maxWarpsPerSM = 64,","-+    .maxSharedMemoryPerSM = 228,","-+    .tensorCoreVersions = kMMAv2 | kMMAv3,","-+};","-+","-+static const ArchInfo archInfoSm100 = {","-+    .maxBlocksPerSM = 32,","-+    .maxWarpsPerSM = 64,","-+    .maxSharedMemoryPerSM = 228,","-+    .tensorCoreVersions = kMMAv2 | kMMAv5,","-+};","-+","-+static const ArchInfo archInfoSm103 = {","-+    .maxBlocksPerSM = 32,","-+    .maxWarpsPerSM = 64,","-+    .maxSharedMemoryPerSM = 228,","-+    .tensorCoreVersions = kMMAv2 | kMMAv5,","-+};","-+","-+static const ArchInfo archInfoSm110 = {","-+    .maxBlocksPerSM = 24,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 228,","-+    .tensorCoreVersions = kMMAv2 | kMMAv5,","-+};","-+","-+static const ArchInfo archInfoSm120 = {","-+    .maxBlocksPerSM = 24,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 100,","-+    .tensorCoreVersions = kMMAv2,","-+};","-+","-+static const ArchInfo archInfoSm121 = {","-+    .maxBlocksPerSM = 24,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 100,","-+    .tensorCoreVersions = kMMAv2,","-+};","-+","-+static const ArchInfo archInfoGeneric = {","-+    .maxBlocksPerSM = 16,","-+    .maxWarpsPerSM = 48,","-+    .maxSharedMemoryPerSM = 100,","-+    .tensorCoreVersions = 0,","-+};","-+","-+ArchInfo getArchInfo(ComputeCapability cc) {","-+  switch (cc) {","-+  case ComputeCapability::Sm80:","-+    return archInfoSm80;","-+  case ComputeCapability::Sm86:","-+    return archInfoSm86;","-+  case ComputeCapability::Sm87:","-+    return archInfoSm87;","-+  case ComputeCapability::Sm89:","-+    return archInfoSm89;","-+  case ComputeCapability::Sm90:","-+    return archInfoSm90;","-+  case ComputeCapability::Sm100:","-+    return archInfoSm100;","-+  case ComputeCapability::Sm103:","-+    return archInfoSm103;","-+  case ComputeCapability::Sm110:","-+    return archInfoSm110;","-+  case ComputeCapability::Sm120:","-+    return archInfoSm120;","-+  case ComputeCapability::Sm121:","-+    return archInfoSm121;","-+  default:","-+    return archInfoGeneric;","-+  }","-+}","-+","-+} // namespace","-+","-+/**","-+ * @brief Get the architecture information for a given compute capability.","-+ * @param cc Compute capability.","-+ * @param numSMs Number of Streaming Multiprocessors (SMs).","-+ */","-+ArchInfo getArchInfo(ComputeCapability cc, int numSMs) {","-+  ArchInfo archInfo = getArchInfo(cc);","-+  archInfo.numSMs = std::max(numSMs, 1);","-+  return archInfo;","-+}","-+","-+} // namespace tiling_analysis","-+} // namespace mlir::nv_tensor_ir","-diff --git a/lib/Analysis/Tiling/Enumerate.cpp b/lib/Analysis/Tiling/Enumerate.cpp","-new file mode 100644","-index 0000000..e4bbed9","-+++ b/lib/Analysis/Tiling/Enumerate.cpp","-@@ -0,0 +1,910 @@","-+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.","-+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception","-+","-+#include \"tensor_ir/Analysis/Tiling/Enumerate.h\"","-+","-+#include \"llvm/ADT/STLExtras.h\"","-+#include \"llvm/Support/Debug.h\"","-+#include \"llvm/Support/MathExtras.h\"","-+#include \"llvm/Support/raw_ostream.h\"","-+","-+#include <algorithm>","-+#include <cassert>","-+#include <cmath>","-+#include <cstddef>","-+#include <cstdint>","-+#include <functional>","-+#include <utility>","-+","-+#define DEBUG_TYPE \"tiling-analysis-enumerate\"","-+","-+namespace mlir::nv_tensor_ir {","-+namespace tiling_analysis {","-+","-+/// Minimum tile size (1 warp, 1 value per thread).","-+constexpr int kMinTileSizeBits = 5; // 2^5 = 32","-+/// Maximum tile size (8 warps, 128 values per thread).","-+constexpr int kMaxTileSizeBits = 15; // 2^15 = 32768","-+","-+/// Minimum reduction tile size.","-+constexpr int kMinReductionTileSizeBits = 5; // 2^5 = 32","-+/// Maximum tile size for dynamic dimensions.","-+constexpr int kMaxDynamicTileSizeBits = 6; // 2^6 = 64","-+","-+/// Tile size limits for matmul dimensions.","-+constexpr int kMinLhsTileSizeBits = 4;         // 2^4 = 16","-+constexpr int kMaxLhsTileSizeBits = 7;         // 2^7 = 128","-+constexpr int kMinRhsTileSizeBits = 3;         // 2^3 = 8","-+constexpr int kMaxRhsTileSizeBits = 8;         // 2^8 = 256","-+constexpr int kMinContractionTileSizeBits = 4; // 2^4 = 16","-+constexpr int kMaxContractionTileSizeBits = 8; // 2^8 = 256","-+","-+/// ----- Dimension analysis ---------------------------------------------------","-+///","-+/// Before generating tile shapes, the enumerator collects the properties of","-+/// each dimension of the main iteration space, by walking the input and output","-+/// layout trees attached to the graph:","-+///","-+/// - Tensor sources count the tensors where the dimension is contiguous","-+///   (stride 1, the loads and stores can be vectorized), and where it is","-+///   broadcast (stride 0, the loaded values are reused across the tile).","-+///   Stores are counted twice, as storing a partial sector needs a","-+///   read-modify-write.","-+/// - Concat sources mark their concatenation dimension as non-tileable, as the","-+///   evaluator requires a unit tile size for it.","-+/// - Matmul sources mark the dimensions that map to the M and N dimensions of","-+///   the matmul result, based on their position in the (batch, M, N, K)","-+///   iteration space. The matmul generator tiles these groups separately.","-+///","-+/// Reductions and matmuls start nested iteration spaces. The nested dimensions","-+/// are mapped back to the main dimensions the same way as in the evaluator, and","-+/// the reduced and contracting dimensions are mapped to a temporary value,","-+/// since their tile size is set by the reduction tile size instead."],"additions":0,"deletions":491,"truncated":false}],"additions":115,"deletions":607,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-10-21T13:28:03.244811+00:00"}