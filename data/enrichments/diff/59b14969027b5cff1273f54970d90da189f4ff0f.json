de);","+        context.Response.Body.Position = 0;","+        Assert.Equal(\"The tenant could not be resolved.\", await new StreamReader(context.Response.Body).ReadToEndAsync());","+    }","+","+    [Fact]","+    public async Task InvokeAsync_WhenTenantResolvesAndRejectingUnresolvedTenants_Continues()","+    {","+        // Arrange","+        var (context, nextWasCalled, middleware, invoker) = CreateMiddleware(resolvedTenant: Tenant.Default);","+","+        // Act","+        await middleware.InvokeAsync(context, invoker, Microsoft.Extensions.Options.Options.Create(new MultitenancyOptions { RejectUnresolvedTenants = true }));","+","+        // Assert","+        Assert.True(nextWasCalled());","+        Assert.Equal(StatusCodes.Status200OK, context.Response.StatusCode);","+    }","+","+    private static (HttpContext Context, Func<bool> NextWasCalled, TenantResolutionMiddleware Middleware, ITenantResolverPipelineInvoker Invoker) CreateMiddleware(Tenant? resolvedTenant)","+    {","+        var rootProvider = new ServiceCollection().BuildServiceProvider();","+        var context = new DefaultHttpContext { RequestServices = rootProvider };","+        var nextWasCalled = false;","+        var tenantScopeFactory = new DefaultTenantScopeFactory(new DefaultTenantAccessor(), rootProvider.GetRequiredService<IServiceScopeFactory>());","+        var middleware = new TenantResolutionMiddleware(_ =>","+        {","+            nextWasCalled = true;","+            return Task.CompletedTask;","+        }, tenantScopeFactory);","+        var invoker = Substitute.For<ITenantResolverPipelineInvoker>();","+        invoker.InvokePipelineAsync(Arg.Any<CancellationToken>()).Returns(Task.FromResult(resolvedTenant));","+","+        return (context, () => nextWasCalled, middleware, invoker);","+    }","+","     private sealed class ScopedProbe","     {","     }"],"additions":65,"deletions":1,"truncated":false},{"path":"core/test/unit/Elsa.Tenants.UnitTests/Services/DefaultTenantResolverPipeli