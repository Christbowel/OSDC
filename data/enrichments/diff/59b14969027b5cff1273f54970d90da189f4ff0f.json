"         foreach (var resolver in resolutionPipeline)","         {","+            // The default resolver is the silent fallback to the default tenant that fail-closed hosts opt out of.","+            if (options.Value.RejectUnresolvedTenants && resolver is DefaultTenantResolver)","+            {","+                continue;","+            }","+","             var result = await resolver.ResolveAsync(context);"," ","             if (result.IsResolved)"],"additions":6,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Tenants/ShellFeatures/TenantsFeature.cs","lines":["@@ -18,6 +18,17 @@ namespace Elsa.Tenants.ShellFeatures;"," [UsedImplicitly]"," public class TenantsFeature : IShellFeature"," {","+    /// <summary>","+    /// Gets or sets a value indicating whether a request, job or command whose tenant cannot be resolved is rejected instead of running as the default tenant.","+    /// </summary>","+    [ManifestSetting(","+        DisplayName = \"Reject Unresolved Tenants\",","+        Description = \"Reject requests, jobs and commands whose tenant cannot be resolved instead of running them as the default tenant.\",","+        Category = \"Tenancy\",","+        DefaultValue = \"false\",","+        RestartRequired = true)]","+    public bool RejectUnresolvedTenants { get; set; }","+","     public void ConfigureServices(IServiceCollection services)","     {","         // Matches the classic TenantsFeature: persistence reads this flag to apply tenant query filters and stamp tenant IDs.","@@ -27,6 +38,11 @@ public void ConfigureServices(IServiceCollection services)","             .AddHostedService<SetupMediatorPipelines>()","             .AddScoped<ITenantResolverPipelineInvoker, DefaultTenantResolverPipelineInvoker>()","             .AddScoped<ITenantResolver, DefaultTenantResolver>();","+","+        if (RejectUnresolvedTenants)","+        {","+            services.Configure<MultitenancyOptions>(options => options.RejectUnresolvedTenants = true);","+     