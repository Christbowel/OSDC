are.InvokeAsync(CreateContext(headers: new Dictionary<object, object>()));","+","+        // Assert","+        Assert.True(nextWasCalled());","+    }","+","+    private static (TenantPropagatingMiddleware Middleware, Func<bool> NextWasCalled) CreateMiddleware(bool rejectUnresolvedTenants, ITenantAccessor? tenantAccessor = null)","+    {","+        tenantAccessor ??= new DefaultTenantAccessor();","+        var services = new ServiceCollection().BuildServiceProvider();","+        var tenantScopeFactory = new DefaultTenantScopeFactory(tenantAccessor, services.GetRequiredService<IServiceScopeFactory>());","+        var tenantService = Substitute.For<ITenantService>();","+        tenantService.FindAsync(string.Empty, Arg.Any<CancellationToken>()).Returns(Tenant.Default);","+        var nextWasCalled = false;","+        var options = Microsoft.Extensions.Options.Options.Create(new MultitenancyOptions { RejectUnresolvedTenants = rejectUnresolvedTenants });","+        var middleware = new TenantPropagatingMiddleware(_ =>","+        {","+            nextWasCalled = true;","+            return ValueTask.CompletedTask;","+        }, tenantScopeFactory, tenantService, tenantAccessor, options);","+","+        return (middleware, () => nextWasCalled);","+    }","+","+    private static CommandContext CreateContext(IDictionary<object, object> headers) => new(","+        Substitute.For<ICommand>(),","+        Substitute.For<ICommandStrategy>(),","+        typeof(object),","+        headers,","+        new ServiceCollection().BuildServiceProvider(),","+        CancellationToken.None);"," }"],"additions":105,"deletions":1,"truncated":false},{"path":"core/test/unit/Elsa.Tenants.UnitTests/Middleware/TenantResolutionMiddlewareTests.cs","lines":["@@ -1,7 +1,9 @@"," using Elsa.Common.Multitenancy;"," using Elsa.Tenants.AspNetCore.Middleware;","+using Elsa.Tenants.Options;"," using Microsoft.AspNetCore.Http;"," using Microsoft.Extensions.DependencyInjection;","+using Microsoft.Extensions.O