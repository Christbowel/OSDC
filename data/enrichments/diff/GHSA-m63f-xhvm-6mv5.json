ext(aspireHomeDirectory: aspireHome);","+        });","+        services.AddSingleton<IAppHostServerProjectFactory>(new TestAppHostServerProjectFactory","+        {","+            CreateAsyncCallback = (appPath, _) =>","+            {","+                Assert.Equal(Path.Combine(aspireHome.FullName, \"tmp\", \"sdk\"), Directory.GetParent(appPath)?.FullName);","+                Assert.True(Directory.Exists(appPath));","+                Assert.Equal(appPath, ConfigurationHelper.GetConfigRootDirectory(new DirectoryInfo(appPath)).FullName);","+                Assert.Equal(Path.Combine(appPath, \".aspire\", \"integrations\"),","+                    ConfigurationHelper.GetIntegrationCacheDirectory(new DirectoryInfo(appPath)).FullName);","+                if (!OperatingSystem.IsWindows())","+                {","+                    foreach (var directory in new[] { appPath, Path.Combine(aspireHome.FullName, \"tmp\"), Path.Combine(aspireHome.FullName, \"tmp\", \"sdk\") })","+                    {","+                        Assert.Equal(UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute,","+                            File.GetUnixFileMode(directory));","+                    }","+                }","+                scannerPaths.Add(appPath);","+                return Task.FromResult<IAppHostServerProject>(new FakeFailingAppHostServerProject(appPath));","+            }","+        });","+        using var provider = services.BuildServiceProvider();","+        var integrationProject = Path.Combine(workspace.Path, \"Integration.csproj\");","+        await File.WriteAllTextAsync(integrationProject, \"<Project />\");","+        var outputPath = Path.Combine(workspace.Path, \"output\");","+        string[] arguments = commandName switch","+        {","+            \"generate\" => [\"sdk\", \"generate\", integrationProject, \"--language\", \"typescript\", \"--output\", outputPath],","+            \"dump\" => [\"sdk\", \"dump\", \"--output\", outputPath],","+  