ut, 0x5A, sizeof(input));","+            ddict = ZSTD_createDDict_advanced(input, sizeof(input), methods[methodNb],","+                                            ZSTD_dct_rawContent, ZSTD_defaultCMem);","+            CHECK(ddict != NULL);","+            CHECK_EQ(ZSTD_DDict_dictSize(ddict), sizeof(input));","+            CHECK(!memcmp(ZSTD_DDict_dictContent(ddict), input, sizeof(input)));","+            CHECK((ZSTD_DDict_dictContent(ddict) == input) == (methods[methodNb] == ZSTD_dlm_byRef));","+            ZSTD_freeDDict(ddict);","+        }","+    }","+    {   ZSTD_DCtx* const dctx = ZSTD_createDCtx();","+        size_t pos = 0;","+        CHECK(dctx != NULL);","+        CHECK_Z(ZSTD_decompressBegin(dctx));","+        while (ZSTD_nextSrcSizeToDecompress(dctx) != 0) {","+            size_t const next = ZSTD_nextSrcSizeToDecompress(dctx);","+            CHECK(next <= sizeof(emptyFrame) - pos);","+            CHECK_EQ(ZSTD_decompressContinue(dctx, NULL, 0, emptyFrame + pos, next), 0);","+            pos += next;","+        }","+        CHECK_EQ(pos, sizeof(emptyFrame));","+        CHECK_Z(ZSTD_DCtx_reset(dctx, ZSTD_reset_session_and_parameters));","+        CHECK_Z(ZSTD_DCtx_setParameter(dctx, ZSTD_d_stableOutBuffer, 1));","+        {   ZSTD_inBuffer in1 = { emptyFrame, 6, 0 };","+            ZSTD_inBuffer in2 = { emptyFrame + 6, sizeof(emptyFrame) - 6, 0 };","+            ZSTD_outBuffer out = { NULL, 0, 0 };","+            CHECK_Z(ZSTD_decompressStream(dctx, &out, &in1));","+            CHECK_EQ(ZSTD_decompressStream(dctx, &out, &in2), 0);","+            CHECK_EQ(out.pos, 0);","+        }","+        ZSTD_freeDCtx(dctx);","+    }","+    {   BYTE input[2 * sizeof(BitContainerType)];","+        size_t distance;","+        U32 nbBytes;","+        memset(input, 0xA5, sizeof(input));","+        for (distance = 1; distance < sizeof(BitContainerType); ++distance) {","+            for (nbBytes = 0; nbBytes <= sizeof(BitContainerType); ++nbBytes) {","+                BIT_DStre