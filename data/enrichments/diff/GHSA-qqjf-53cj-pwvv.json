out(t *testing.T) {"," \t}"," }"," ","+func TestHTTP3StickyBackendTransport(t *testing.T) {","+\tconst backendConnHeader = \"X-Backend-Conn\"","+","+\t// RemoteAddr identifies the backend connection, the challenge making Traefik stick to it as an NTLM backend would.","+\tbackend := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\trw.Header().Set(\"WWW-Authenticate\", \"NTLM\")","+\t\trw.Header().Set(backendConnHeader, req.RemoteAddr)","+\t\trw.WriteHeader(http.StatusUnauthorized)","+\t}))","+\tt.Cleanup(backend.Close)","+","+\trtManager := service.NewRoundTripperManager()","+\trtManager.Update(map[string]*dynamic.ServersTransport{\"default@internal\": {}})","+","+\troundTripper, err := rtManager.Get(\"default@internal\")","+\trequire.NoError(t, err)","+","+\tcertContent, err := localhostCert.Read()","+\trequire.NoError(t, err)","+","+\tkeyContent, err := localhostKey.Read()","+\trequire.NoError(t, err)","+","+\ttlsCert, err := tls.X509KeyPair(certContent, keyContent)","+\trequire.NoError(t, err)","+","+\tepConfig := &static.EntryPointsTransport{}","+\tepConfig.SetDefaults()","+","+\tentryPoint, err := NewTCPEntryPoint(t.Context(), &static.EntryPoint{","+\t\tAddress:          \"127.0.0.1:0\",","+\t\tTransport:        epConfig,","+\t\tForwardedHeaders: &static.ForwardedHeaders{},","+\t\tHTTP2:            &static.HTTP2Config{},","+\t\tHTTP3:            &static.HTTP3Config{},","+\t}, nil)","+\trequire.NoError(t, err)","+","+\trouter, err := tcprouter.NewRouter()","+\trequire.NoError(t, err)","+","+\trouter.AddHTTPTLSConfig(\"example.com\", &tls.Config{","+\t\tCertificates: []tls.Certificate{tlsCert},","+\t}, traefiktls.DefaultTLSConfigName)","+\trouter.SetHTTPSHandler(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\toutReq, err := http.NewRequestWithContext(req.Context(), http.MethodGet, backend.URL, http.NoBody)","+\t\tif err != nil {","+\t\t\trw.WriteHeader(http.StatusInternalServerError)","+\t\t\treturn","+\t\t}","+","+\t\tresp, err := roundTripper.RoundTrip(outReq)","+\t\tif err != nil {","+\t\t\trw.WriteHeader(http.StatusBadGateway)","+\t\t\treturn","+\t\t}","+\t\tdefer resp.Body.Close()","+","+\t\trw.Header().Set(backendConnHeader, resp.Header.Get(backendConnHeader))","+\t}), nil)","+","+\tctx := t.Context()","+\tgo entryPoint.Start(ctx)","+\tentryPoint.SwitchRouter(router)","+","+\tt.Cleanup(func() { entryPoint.Shutdown(ctx) })","+","+\t// We are racing with the http3Server readiness happening in the goroutine starting the entrypoint.","+\ttime.Sleep(time.Second)","+","+\tcertPool := x509.NewCertPool()","+\tcertPool.AppendCertsFromPEM(certContent)","+","+\thttp3Addr := entryPoint.http3Server.http3conn.LocalAddr().String()","+","+\t// Each transport holds its own QUIC connection to the entrypoint.","+\tnewClient := func() *http3.Transport {","+\t\ttransport := &http3.Transport{","+\t\t\tTLSClientConfig: &tls.Config{","+\t\t\t\tRootCAs:    certPool,","+\t\t\t\tServerName: \"example.com\",","+\t\t\t},","+\t\t\tDial: func(ctx context.Context, _ string, tlsCfg *tls.Config, cfg *quic.Config) (*quic.Conn, error) {","+\t\t\t\treturn quic.DialAddr(ctx, http3Addr, tlsCfg, cfg)","+\t\t\t},","+\t\t}","+\t\tt.Cleanup(func() { _ = transport.Close() })","+","+\t\treturn transport","+\t}","+","+\tbackendConnFor := func(transport *http3.Transport) string {","+\t\tt.Helper()","+","+\t\treq, err := http.NewRequest(http.MethodGet, \"https://example.com\", http.NoBody)","+\t\trequire.NoError(t, err)","+","+\t\tresp, err := transport.RoundTrip(req)","+\t\trequire.NoError(t, err)","+","+\t\tt.Cleanup(func() { _ = resp.Body.Close() })","+\t\trequire.Equal(t, http.StatusOK, resp.StatusCode)","+","+\t\treturn resp.Header.Get(backendConnHeader)","+\t}","+","+\tfirstClient, secondClient := newClient(), newClient()","+","+\tfirstConn := backendConnFor(firstClient)","+\tfirstStickyConn := backendConnFor(firstClient)","+\tfirstReusedConn := backendConnFor(firstClient)","+\tsecondConn := backendConnFor(secondClient)","+\tsecondStickyConn := backendConnFor(secondClient)","+","+\t// The challenge on the first call moves the following ones to a connection dedicated to that client.","+\tassert.NotEqual(t, firstConn, firstStickyConn)","+\t// That dedicated connection is then reused, which is what a connection-bound authentication relies on.","+\tassert.Equal(t, firstStickyConn, firstReusedConn)","+\t// A client must never be served by the connection another one is stuck to.","+\tassert.NotEqual(t, firstStickyConn, secondConn)","+\tassert.NotEqual(t, firstStickyConn, secondStickyConn)","+}","+"," func TestNewHTTP3ServerTimeouts(t *testing.T) {"," \tcertContent, err := localhostCert.Read()"," \trequire.NoError(t, err)"],"additions":126,"deletions":0,"truncated":false},{"path":"pkg/server/service/roundtripper.go","lines":["@@ -212,7 +212,10 @@ func (k *KerberosRoundTripper) RoundTrip(request *http.Request) (*http.Response,"," "," func containsNTLMorNegotiate(h []string) bool {"," \treturn slices.ContainsFunc(h, func(s string) bool {","-\t\treturn strings.HasPrefix(s, \"NTLM\") || strings.HasPrefix(s, \"Negotiate\")","+\t\t// RFC 9110 section 11.1 defines the auth-scheme as case-insensitive,","+\t\t// hence a challenge is matched on its scheme token whatever its case.","+\t\tscheme, _, _ := strings.Cut(s, \" \")","+\t\treturn strings.EqualFold(scheme, \"NTLM\") || strings.EqualFold(scheme, \"Negotiate\")"," \t})"," }"," "],"additions":4,"deletions":1,"truncated":false},{"path":"pkg/server/service/roundtripper_test.go","lines":["@@ -324,6 +324,26 @@ func TestKerberosRoundTripper(t *testing.T) {"," \t\t\texpectedOriginalCount:       1,"," \t\t\texpectedDedicatedCount:      2,"," \t\t},","+\t\t{","+\t\t\tdesc:                        \"with a lowercase negotiate scheme\",","+\t\t\toriginalRoundTripperHeaders: map[string][]string{\"Www-Authenticate\": {\"negotiate\"}},","+\t\t\texpectedStatusCode:          []int{http.StatusUnauthorized, http.StatusOK, http.Statu