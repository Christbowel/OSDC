{"id":"1e7aa90382920c9dc79218cd36e06e60be66ce52","axis":"silent","repo":"pnpm/pnpm","sha":"1e7aa90382920c9dc79218cd36e06e60be66ce52","parsed":{"files":[{"path":".changeset/pnpr-shutdown-drain-and-readiness.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Added `shutdownTimeout` (`25s` by default) to configure how long pnpr waits for in-flight requests to drain on `SIGINT` or `SIGTERM`. `GET /-/ready` now returns `503 Service Unavailable` as soon as shutdown starts. `GET /-/ping` now returns `{}` without probing storage or auth backends."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/config_file.rs","lines":["@@ -210,6 +210,9 @@ pub(super) struct ConfigFile {","     /// Request processing timeout (e.g. `60s`, `1m`).","     #[serde(default)]","     pub(super) request_timeout: Option<Interval>,","+    /// Graceful shutdown drain timeout (e.g. `25s`, `1m`).","+    #[serde(default)]","+    pub(super) shutdown_timeout: Option<Interval>,","     /// Duration before a cached packument is considered stale and refetched.","     #[serde(default)]","     pub(super) packument_ttl: Option<Interval>,"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/http_config.rs","lines":["@@ -0,0 +1,114 @@","+use super::{","+    ByteSize, Config, ConfigFile, HttpConfig, Interval, MetricsConfig, Path, RegistryError,","+    SocketAddr, TrustedProxyHeader, build_cors_config, build_package_documents_config,","+    build_ui_config, cdn, parse_byte_size, parse_interval, parse_trusted_proxies,","+};","+","+pub(super) fn build_http_config(","+    file: &mut ConfigFile,","+    base_dir: &Path,","+    listen: SocketAddr,","+    public_url: Option<String>,","+) -> Result<HttpConfig, RegistryError> {","+    let cors = build_cors_config(std::mem::take(&mut file.cors))?;","+    let ui = build_ui_config(std::mem::take(&mut file.ui), base_dir);","+    let trusted_proxies = parse_trusted_proxies(&file.trusted_proxies)?;","+    let trusted_proxy_header = match file.trusted_proxy_header.as_deref() {","+        Some(raw) => raw.parse::<TrustedProxyHeader>()?,","+        None => TrustedProxyHeader::default(),","+    };","+    let request_timeout = build_request_timeout(file.request_timeout.as_ref())?;","+    let shutdown_timeout = build_shutdown_timeout(file.shutdown_timeout.take())?;","+    let packument_ttl = build_packument_ttl(file.packument_ttl.take())?;","+    let max_tarball_bytes = build_max_tarball_bytes(file.max_tarball_size.take())?;","+    Ok(HttpConfig {","+        listen,","+        public_url: public_url.unwrap_or_else(|| format!(\"http://{listen}\")),","+        cors,","+        ui,","+        oci: std::mem::take(&mut file.oci),","+        packument_ttl,","+        max_tarball_bytes,","+        trusted_proxies,","+        trusted_proxy_header,","+        request_timeout,","+        shutdown_timeout,","+        metrics: build_metrics_config(file, listen)?,","+        package_documents: build_package_documents_config(file.package_documents.take())?,","+        cloudflare_cdn: cdn::build(file.cloudflare_cdn.take())?,","+    })","+}","+","+fn build_request_timeout(","+    raw: Option<&Interval>,","+) -> Result<Option<std::time::Duration>, RegistryError> {","+    let Some(interval) = raw else {","+        return Ok(Some(HttpConfig::DEFAULT_REQUEST_TIMEOUT));","+    };","+    let duration = parse_interval(&interval.0)","+        .ok_or_else(|| RegistryError::InvalidConfig {","+            reason: format!(\"http.requestTimeout {:?} is not a valid interval\", interval.0),","+        })?;","+    Ok((!duration.is_zero()).then_some(duration))","+}","+","+/// The `shutdownTimeout:` key as a duration, defaulting to","+/// [`HttpConfig::DEFAULT_SHUTDOWN_TIMEOUT`]. Zero is refused: a","+/// zero-length drain would abort in-flight requests as soon as shutdown starts.","+fn build_shutdown_timeout(raw: Option<Interval>) -> Result<std::time::Duration, RegistryError> {","+    let Some(Interval(raw)) = raw else {","+        return Ok(HttpConfig::DEFAULT_SHUTDOWN_TIMEOUT);","+    };","+    let duration = parse_interval(&raw)","+        .ok_or_else(|| RegistryError::InvalidConfig {","+            reason: format!(\"shutdownTimeout {raw:?} is not a valid interval\"),","+        })?;","+    if duration.is_zero() {","+        return Err(RegistryError::InvalidConfig {","+            reason: \"shutdownTimeout must be greater than zero\".to_string(),","+        });","+    }","+    Ok(duration)","+}","+","+/// The `packumentTtl:` key as a duration, defaulting to","+/// [`Config::DEFAULT_PACKUMENT_TTL`].","+fn build_packument_ttl(raw: Option<Interval>) -> Result<std::time::Duration, RegistryError> {","+    let Some(Interval(raw)) = raw else {","+        return Ok(Config::DEFAULT_PACKUMENT_TTL);","+    };","+    parse_interval(&raw)","+        .ok_or_else(|| RegistryError::InvalidConfig {","+            reason: format!(\"packumentTtl {raw:?} is not a valid interval\"),","+        })","+}","+","+/// The `maxTarballSize:` key as bytes, defaulting to","+/// [`HttpConfig::DEFAULT_MAX_TARBALL_BYTES`]. Zero is refused: it would","+/// turn every upstream tarball away.","+fn build_max_tarball_bytes(raw: Option<ByteSize>) -> Result<u64, RegistryError> {","+    let Some(ByteSize(raw)) = raw else {","+        return Ok(HttpConfig::DEFAULT_MAX_TARBALL_BYTES);","+    };","+    let bytes = parse_byte_size(&raw)","+        .ok_or_else(|| RegistryError::InvalidConfig {","+            reason: format!(\"maxTarballSize {raw:?} is not a valid byte size\"),","+        })?;","+    if bytes == 0 {","+        return Err(RegistryError::InvalidConfig {","+            reason: \"maxTarballSize must be greater than zero\".to_string(),","+        });","+    }","+    Ok(bytes)","+}","+","+fn build_metrics_config(","+    file: &mut ConfigFile,","+    listen: SocketAddr,","+) -> Result<Option<MetricsConfig>, RegistryError> {","+    let metrics = file.metrics.take();","+    if let Some(metrics) = &metrics {","+        metrics.validate(listen)?;","+    }","+    Ok(metrics)","+}"],"additions":114,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -63,6 +63,7 @@ mod gc;"," use gc::{GcFile, build_gc_config};"," "," mod hosted;","+mod http_config;"," mod ip_network;"," mod loading;"," mod logging;","@@ -241,6 +242,10 @@ pub struct HttpConfig {","     /// this duration to process, it is aborted and returns 504 Gateway Timeout.","     /// `None` or 0 disables request timeouts.","     pub request_timeout: Option<Duration>,","+    /// Maximum duration to wait for in-flight requests to drain after a","+    /// shutdown signal (`SIGINT` or `SIGTERM`) before exiting. Defaults to","+    /// [`Self::DEFAULT_SHUTDOWN_TIMEOUT`].","+    pub shutdown_timeout: Duration,","     /// Who may scrape Prometheus metrics. `None` serves none.","     pub metrics: Option<MetricsConfig>,","     /// How pnpr's own package document is served.","@@ -250,6 +255,9 @@ pub struct HttpConfig {"," "," impl HttpConfig {","     pub const DEFAULT_REQUEST_TIMEOUT: Duration = Duration::from_mins(1);","+    /// 25 seconds, leaving headroom inside Kubernetes' default 30-second","+    /// `terminationGracePeriodSeconds` so `SIGKILL` does not land mid-drain.","+    pub const DEFAULT_SHUTDOWN_TIMEOUT: Duration = Duration::from_secs(25);","     /// 100 MiB, the size npm itself caps a published package at.","     pub const DEFAULT_MAX_TARBALL_BYTES: u64 = 100 * 1024 * 1024;"," "],"additions":8,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/loading.rs","lines":["@@ -2,8 +2,8 @@ use super::{","     Arc, Config, ConfigFile, ConfigSource, DEFAULT_CONFIG_YAML, EnvVar, FeatureOverrides,","     HostedStoreConfig, Path, PathBuf, RegistryError, RemovedGroupsBlock, RemovedPackagesBlock,","     RemovedUplinksBlock, RemovedUpstreamsBlock, ResolvedFileRegistries, RoutesFile, SocketAddr,","-    SystemEnv, build_cors_config, build_features, build_identity_config, build_