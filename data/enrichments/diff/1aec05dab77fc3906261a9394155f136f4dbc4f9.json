{"id":"1aec05dab77fc3906261a9394155f136f4dbc4f9","axis":"silent","repo":"TryGhost/Ghost","sha":"1aec05dab77fc3906261a9394155f136f4dbc4f9","parsed":{"files":[{"path":"ghost/core/server/api/endpoints/members-stripe-connect.js","lines":["@@ -1,5 +1,10 @@","+const config = require('../../../shared/config');","+const auth = require('../../auth');"," const membersService = require('../../services/members');"," ","+// Chosen once at load, as in auth/authenticate.ts","+const isBetterAuth = config.get('auth:engine') === 'better-auth';","+"," /** @type {import('@tryghost/api-framework').Controller} */"," const controller = {","   docName: 'members_stripe_connect',","@@ -20,6 +25,10 @@ const controller = {","       // This is something you have to do if you want to use the \"framework\" with access to the raw req/res","       frame.response = async function (req, res) {","         function setSessionProp(prop, val) {","+          // Better Auth has no req.session","+          if (isBetterAuth) {","+            return auth.stripeConnectState.set(frame.options.context.user, val);","+          }","           req.session[prop] = val;","         }","         const mode = frame.options.mode || 'live';"],"additions":9,"deletions":0,"truncated":false},{"path":"ghost/core/server/api/endpoints/settings.js","lines":["@@ -7,14 +7,29 @@ const settingsService = require('../../services/settings/settings-service');"," const membersService = require('../../services/members');"," const stripeService = require('../../services/stripe');"," const settingsBREADService = settingsService.getSettingsBREADServiceInstance();","+const config = require('../../../shared/config');","+const auth = require('../../auth');"," ","-async function getStripeConnectData(frame) {","+// Chosen once at load, as in auth/authenticate.ts","+const isBetterAuth = config.get('auth:engine') === 'better-auth';","+","+/**","+ * @param {Object} frame","+ * @param {{state?: string}} checked - Gets the Better Auth state the token was checked against","+ */","+async function getStripeConnectData(frame, checked) {","   const stripeConnectIntegrationToken = frame.data.settings.find(","     (setting) => setting.key === 'stripe_connect_integration_token',","   );"," ","   if (stripeConnectIntegrationToken && stripeConnectIntegrationToken.value) {","-    const getSessionProp = (prop) => frame.original.session[prop];","+    // Better Auth has no session object","+    const getSessionProp = isBetterAuth","+      ? async () => {","+          checked.state = await auth.stripeConnectState.get(frame.options.context.user);","+          return checked.state;","+        }","+      : (prop) => frame.original.session[prop];"," ","     return await settingsBREADService.getStripeConnectData(","       stripeConnectIntegrationToken,","@@ -24,6 +39,22 @@ async function getStripeConnectData(frame) {","   }"," }"," ","+// Only a saved token uses up its Better Auth state, so a failed save can be retried","+async function editSettings(frame) {","+  const checked = {};","+  const stripeConnectData = await getStripeConnectData(frame, checked);","+  const result = await settingsBREADService.edit(","+    frame.data.settings,","+    frame.options,","+    stripeConnectData,","+  );","+","+  if (stripeConnectData && checked.state) {","+    await auth.stripeConnectState.clear(frame.options.context.user, checked.state);","+  }","+  return result;","+}","+"," /** @type {import('@tryghost/api-framework').Controller} */"," const controller = {","   docName: 'settings',","@@ -146,13 +177,7 @@ const controller = {","       },","     },","     async query(frame) {","-      const stripeConnectData = await getStripeConnectData(frame);","-","-      const result = await settingsBREADService.edit(","-        frame.data.settings,","-        frame.options,","-        stripeConnectData,","-      );","+      const result = await editSettings(frame);"," ","       if (!_.isEmpty(result)) {","         frame.setHeader('X-Cache-Invalidate', '/*');"],"additions":34,"deletions":9,"truncated":false},{"path":"ghost/core/server/auth/better-auth/README.md","lines":["@@ -87,6 +87,11 @@ until Phase 4."," - `session-controller.ts`: `POST` and `DELETE /session` under `better-auth`,","   described below."," - `staff-sessions.ts`: the security events' session changes, described below.","+- `stripe-connect-state.ts`: Stripe Connect's OAuth `state`, which legacy","+  keeps on `req.session`. Under `better-auth` it is a `verifications` row with","+  the identifier `stripe-connect:<userId>`, expiring after an hour. Starting","+  a connection replaces it, a mismatch or a failed save keeps it as legacy","+  does, and a successful save deletes it, so a token saves once."," - `routes.ts`: the Better Auth paths that matchers, limiters and","   `disabledPaths` refer to. A mistyped path matches nothing, silently."," "],"additions":5,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/stripe-connect-state.ts","lines":["@@ -0,0 +1,88 @@","+import errors from '@tryghost/errors';","+import type { GhostAuth } from './create-auth';","+","+type AuthContext = Awaited<GhostAuth['$context']>;","+","+export type StripeConnectStateDeps = {","+  /** Read per call: the instance is built by boot */","+  getContext(): Promise<{","+    internalAdapter: Pick<","+      AuthContext['internalAdapter'],","+      'createVerificationValue' | 'deleteVerificationByIdentifier' | 'findVerificationValue'","+    >;","+    adapter: Pick<AuthContext['adapter'], 'deleteMany'>;","+  }>;","+};","+","+// Covers Stripe account onboarding and pasting the token back into Admin","+export const STATE_TTL_MS = 60 * 60 * 1000;","+","+const identifierFor = (userId: string) => `stripe-connect:${userId}`;","+","+function requireUserId(userId: string | undefined): string {","+  if (!userId) {","+    throw new errors.NoPermissionError({ message: 'Stripe Connect requires a staff user.' });","+  }","+  return userId;","+}","+","+/**","+ * Stripe Connect's OAuth state under `better-auth`, which has no","+ * `req.session`: one `verifications` row per staff user, kept until a save","+ * succeeds so a failed save can be retried, as on the legacy session.","+ */","+export function createStripeConnectState(deps: StripeConnectStateDeps) {","+  return {","+    /** Replaces any earlier state for the user */","+    async set(userId: string | undefined, state: string): Promise<void> {","+      const identifier = identifierFor(requireUserId(userId));","+      const { internalAdapter } = await deps.getContext();","+      await internalAdapter.deleteVerificationByIdentifier(identifier);","+      await internalAdapter.createVerificationValue({","+        identifier,","+        value: state,","+        expiresAt: new Date(Date.now() + STATE_TTL_MS),","+      });","+    },","+","+    /** `null` when there is none or it has expired */","+    async get(userId: string | undefined): Promise<string | null> {","+      const identifier = identifierFor(requireUserId(userId));","+      const { internalAdapter } = await deps.getContext();","+      const row = await internalAdapter.findVerificationValue(identifier);","+      return row && new Date(row.expiresAt) > new Date() ? row.value : null;","+    },","+","+    /**","+     * Called once the token is saved, so the state works once. Deletes only","+     * the row holding this state: a connection started meanwhile keeps its own.","+     */","+    async clear(userId: string | undefined, state: string): Promise<void> {","+      const identifier = identifierFor(requireUserId(userId));","+      const { adapter } = await deps.getContext();","+      await adapter.deleteMany({","+        model: 'verification',","+        where: [","+          { field: 'identifier', value: identifier },","+          { field: 'value', value: state },","+        ],","+      });","+    },","+  };","+}","+","+export type StripeConnectState = ReturnType<typeof createStripeConnectState>;","+","+let stripeConnectState: StripeConnectState | undefined;","+","+/** Better Auth loads only under its engine, so callers check it first */","+export default function getStripeConnectState(): StripeConnectState {","+  if (!stripeConnectState) {","+    const betterAuth = require('./index').default;","+","+    stripeConnectState = createStripeConnectState({","+      getContext: () => betterAuth.service.$context,","+    });","+  }","+  return stripeConnectState;","+}"],"additions":88,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/index.ts","lines":["@@ -37,4 +37,11 @@ export = {","   get staffSessions(): ReturnType<typeof import('./better-auth/staff-sessions').default> {","     return require('./better-auth/staff-sessions').default();","   },","+","+  // Stripe Connect's OAuth state; only under auth:engine better-auth","+  get stripeConnectState(): ReturnType<","+    typeof import('./better-auth/stripe-connect-state').default","+  > {","+    return require('./better-auth/stripe-connect-state').default();","+  },"," };"],"additions":7,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/members/stripe-connect.js","lines":["@@ -63,7 +63,8 @@ async function getStripeConnectTokenData(encodedData, getSessionProp) {"," ","   const state = await getSessionProp(STATE_PROP);"," ","-  if (state !== data.s) {","+  // No stored state never matches, whatever the token carries","+  if (!state || state !== data.s) {","     throw new errors.NoPermissionError({ message: tpl(messages.incorrectState) });","   }"," "],"additions":2,"deletions":1,"truncated":false},{"path":"ghost/test/e2e-api/admin/__snapshots__/members-stripe-connect.test.js.snap","lines":["@@ -1,17 +0,0 @@","-// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing","-","-exports[`Members Stripe Connect API can do auth 1: [headers] 1`] = `","-Object {","-  \"access-control-allow-origin\": \"http://127.0.0.1:2369\",","-  \"cache-control\": \"no-cache, private, no-store, must-revalidate, max-stale=0, post-check=0, pre-check=0\",","-  \"content-length\": \"289\",","-  \"content-type\": \"text/plain; charset=utf-8\",","-  \"content-version\": StringMatching /v\\\\\\\\d\\\\+\\\\\\\\\\\\.\\\\\\\\d\\\\+/,","-  \"location\": StringMatching /\\\\^https:\\\\\\\\/\\\\\\\\/connect\\\\\\\\\\\\.stripe\\\\\\\\\\\\.com\\\\\\\\/oauth\\\\\\\\/authorize\\\\\\\\\\\\?response_type=code&scope=read_write&client_id=/,","-  \"set-cookie\": Array [","-    StringMatching /\\\\^ghost-admin-api-session=/,","-  ],","-  \"vary\": \"Accept-Version, Origin, Accept, Accept-Encoding\",","-  \"x-powered-by\": \"Express\",","-}","-`;"],"additions":0,"deletions":17,"truncated":false},{"path":"ghost/test/e2e-api/admin/members-stripe-connect.test.js","lines":["@@ -1,5 +1,12 @@","-const { agentProvider, fixtureManager, matchers } = require('../../utils/e2e-framework');","-const { anyContentVersion, stringMatching } = matchers;","+const assert = require('node:assert/strict');","+const {","+  agentProvider,","+  fixtureManager,","+  configUtils,","+  mockManager,","+} = require('../../utils/e2e-framework');","+","+const isBetterAuth = configUtils.config.get('auth:engine') === 'better-auth';"," "," describe('Members Stripe Connect API', function () {","   let agent;","@@ -10,17 +17,81 @@ describe('Members Stripe Connect API', function () {","     await agent.loginAsOwner();","   });"," ","-  it('can do auth', async function () {","+  async function startConnect() {","+    let state;","     await agent","-      .get(`members/stripe_connect`)","+      .get('members/stripe_connect?mode=test')","       .expectStatus(302)","       .expectEmptyBody()","-      .matchHeaderSnapshot({","-        'content-version': anyContentVersion,","-        location: stringMatching(","-          /^https:\\/\\/connect\\.stripe\\.com\\/oauth\\/authorize\\?response_type=code&scope=read_write&client_id=/,","-        ),","-        'set-cookie': [stringMatching(/^ghost-admin-api-session=/)],","+      .expect(({ headers }) => {","+        const location = new URL(headers.location);","+        assert.equal(","+          `${location.origin}${location.pathname}`,","+          'https://connect.stripe.com/oauth/authorize',","+        );","+        assert.equal(location.searchParams.get('response_type'), 'code');","+        assert.equal(location.searchParams.get('scope'), 'read_write');","+        state = location.searchParams.get('state');","+        assert.ok(state);","+","+        // Legacy keeps the state on the session; Better Auth in verifications","+        const cookies = [headers['set-cookie'] ?? []].flat();","+        assert.equal(","+          cookies.some((cookie) => cookie.startsWith('ghost-admin-api-session=')),","+          !isBetterAuth,","+        );","       });","+    return state;","+  }","+","+  const token = (s) =>","+    Buffer.from(","+      JSON.stringify({","+        s,","+        p: 'pk_test_stripeConnect',","+        a: 'sk_test_stripeConnect',","+        l: false,","+        n: 'Test Account',","+        i: 'acct_stripeConnect',","+      }),","+    ).toString('base64');","+","+  const save = (s) =>","+    agent.put('settings/').body({","+      settings: [{ key: 'stripe_connect_integration_token', value: token(s) }],","+    });","+","+  const expectConnected = (request) =>","+    request.expectStatus(200).expect(({ body }) => {","+      const key = body.settings.find((s) => s.key === 'stripe_connect_publishable_key');","+      assert.equal(key.value, 'pk_test_stripeConnect');","+    });","+","+  it('can do auth', async function () {","+    await startConnect();","+  });","+","+  afterEach(function () {","+    mockManager.restore();","+  });","+","+  it('keeps the state after a mismatch', async function () {","+    const state = await startConnect();","+","+    await save('not-the-state').expectStatus(400);","+    await expectConnected(save(state));","+  });","+","+  it('keeps the state when saving fails, so the same token can be retried', async function () {","+    const state = await startConnect();","+","+    mockManager.mockLimitService('limitStripeConnect', {","+      isLimited: true,","+      errorIfWouldGoOverLimit: true,","+    });","+    await save(state).expectStatus(403);","+","+    mockManager.restore();","+    await expectConnected(save(state));","   });"," });"],"additions":81,"deletions":10,"truncated":false},{"path":"ghost/test/e2e-server/better-auth-stripe-connect.isolated.test.ts","lines":["@@ -0,0 +1,237 @@","+import assert from 'node:assert/strict';","+import sinon from 'sinon';","+import request from 'supertest';","+","+const {","+  startGhost,","+  fixtureManager,","+  configUtils,","+  mockManager,","+  resetRateLimits,","+} = require('../utils/e2e-framework');","+const db = require('../../core/server/data/db');","+const jobsService = require('../../core/server/services/jobs-service');","+const stripe = require('../../core/server/services/stripe');","+const sentry = require('../../core/shared/sentry');","+const DataGenerator = require('../utils/fixtures/data-generator');","+const SettingsBREADService = require('../../core/server/services/settings/settings-bread-service');","+","+const isSQLite = ['sqlite3', 'better-sqlite3'].includes(db.knex.client.config.client);","+","+const [owner, admin] = DataGenerator.Content.users;","+","+// Under better-auth there is no req.session, so the OAuth state lives in","+// `verifications`, one row per staff user, deleted once a save succeeds","+describe.skipIf(isSQLite)('Stripe Connect under auth:engine better-auth', function () {","+  const sandbox = sinon.createSandbox();","+  const adminOrigin = 'http://localhost:2369';","+  const host = new URL(adminOrigin).host;","+  let app: Parameters<typeof request>[0];","+","+  const cookieOf = (response: request.Response) =>","+    [response.headers['set-cookie']].flat().map((c: string) => c.split(';')[0]);","+","+  const adminApi = (method: 'get' | 'put' | 'post', path: string, cookie?: string[]) => {","+    const agent = request(app);","+    const req = agent[method](`/ghost/api/admin/${path}`)","+      .set('Host', host)","+      .set('Origin', adminOrigin);","+    return cookie ? req.set('Cookie', cookie) : req;","+  };","+","+  const signIn = async (user: { email: string; password: string }) =>","+    cookieOf(","+      await adminApi('post', 'session/')","+        .send({ username: user.email, password: user.password })","+        .expect(201),","+    );","+","+  const stateRows = (userId: string) =>","+    db.knex('verifications').where({ identifier: `stripe-connect:${userId}` });","+","+  async function startConnect(cookie: string[]) {","+    const response = await adminApi('get', 'members/stripe_connect/?mode=test', cookie).expect(302);","+    const location = new URL(response.headers.location);","+    assert.equal(location.origin, 'https://connect.stripe.com');","+    // No legacy session cookie under better-auth","+    assert.equal(response.headers['set-cookie'], undefined);","+    const state = location.searchParams.get('state');","+    assert.ok(state);","+    return state;","+  }","+","+  // What stripe.ghost.org hands back for the user to paste into Admin","+  const token = (state: string | null) =>","+    Buffer.from(","+      JSON.stringify({","+        s: state,","+        p: 'pk_test_stripeConnect',","+        a: 'sk_test_stripeConnect',","+        l: false,","+        n: 'Test Account',","+        i: 'acct_test_stripe_connect',","+      }),","+    ).toString('base64');","+","+  const saveToken = (cookie: string[], value: string) =>","+    adminApi('put', 'settings/', cookie).send({","+      settings: [{ key: 'stripe_connect_integration_token', value }],","+    });","+","+  const setting = async (key: string) =>","+    (await db.knex('settings').where({ key }).first())?.value ?? null;","+","+  beforeAll(async function () {","+    configUtils.set('sentry:disabled', true);","+    sandbox.stub(sentry, 'captureException');","+    sandbox.stub(sentry, 'captureMessage');","+    configUtils.set('auth:engine', 'better-auth');","+    configUtils.set('createInDevelopmentTables', true);","+    configUtils.set('url', `${adminOrigin}/`);","+","+    app = await startGhost({ backend: true, frontend: false, server: false });","+    await fixtureManager.init('users');","+  });","+","+  beforeEach(async function () {","+    // mockManager.restore() resets config, and the origin check reads the URL per request","+    configUtils.set('url', `${adminOrigin}/`);","+    configUtils.set('security:staffDeviceVerification', false);","+    await resetRateLimits();","+    await db.knex('verifications').where('identifier', 'like', 'stripe-connect:%').del();","+    await db","+      .knex('settings')","+      .whereIn('key', ['stripe_connect_publishable_key', 'stripe_connect_secret_key'])","+      .update({ value: null });","+    mockManager.mockMail();","+  });","+","+  afterEach(function () {","+    mockManager.restore();","+  });","+","+  afterAll(async function () {","+    sandbox.restore();","+    try {","+      await jobsService.shutdown();","+    } finally {","+      await stripe.shutdown();","+      await configUtils.restore();","+    }","+  });","+","+  it('round-trips the state from the redirect to saving the token, once', async function () {","+    const cookie = await signIn(owner);","+    const state = await startConnect(cookie);","+","+    const [row] = await stateRows(owner.id);","+    assert.equal(row.value, state);","+    const ttl = new Date(row.expires_at).getTime() - Date.now();","+    assert.ok(ttl > 0 && ttl <= 60 * 60 * 1000, `unexpected expiry ${row.expires_at}`);","+","+    const saved = await saveToken(cookie, token(state));","+    assert.equal(saved.status, 200, JSON.stringify(saved.body));","+    assert.equal(await setting('stripe_connect_publishable_key'), 'pk_test_stripeConnect');","+    assert.equal((await stateRows(owner.id)).length, 0);","+","+    // The state is single-use","+    await saveToken(cookie, token(state)).expect(400);","+  });","+","+  it('keeps only the latest state, and keeps it after a mismatch', async function () {","+    const cookie = await signIn(owner);","+    const first = await startConnect(cookie);","+    const second = await startConnect(cookie);","+","+    assert.equal((await stateRows(owner.id)).length, 1);","+    await saveToken(cookie, token(first)).expect(400);","+    assert.equal((await stateRows(owner.id)).length, 1);","+    await saveToken(cookie, token(second)).expect(200);","+    assert.equal(await setting('stripe_connect_publishable_key'), 'pk_test_stripeConnect');","+  });","+","+  it('keeps the state when saving fails, so the same token can be retried', async function () {","+    const cookie = await signIn(owner);","+    const state = await startConnect(cookie);","+","+    mockManager.mockLimitService('limitStripeConnect', {","+      isLimited: true,","+      errorIfWouldGoOverLimit: true,","+    });","+    await saveToken(cookie, token(state)).expect(403);","+    assert.equal(await setting('stripe_connect_publishable_key'), null);","+    assert.equal((await stateRows(owner.id)).length, 1);","+","+    mockManager.restore();","+    configUtils.set('url', `${adminOrigin}/`);","+    const retried = await saveToken(cookie, token(state));","+    assert.equal(retried.status, 200, JSON.stringify(retried.body));","+    assert.equal(await setting('stripe_connect_publishable_key'), 'pk_test_stripeConnect');","+    assert.equal((await stateRows(owner.id)).length, 0);","+  });","+","+  it(\"a save in flight doesn't clear a connection started in another tab\", async function () {","+    const cookie = await signIn(owner);","+    const tabA = await startConnect(cookie);","+    let tabB: string | undefined;","+","+    // Tab B starts connecting after tab A's token is checked, before its save finishes","+    const edit = SettingsBREADService.prototype.edit;","+    const stub = sinon.stub(SettingsBREADService.prototype, 'edit').callsFake(async function (","+      this: unknown,","+      ...args: unknown[]","+    ) {","+      tabB = await startConnect(cookie);","+      return edit.apply(this, args);","+    });","+    try {","+      await saveToken(cookie, token(tabA)).expect(200);","+    } finally {","+      stub.restore();","+    }","+","+    assert.ok(tabB);","+    const rows = await stateRows(owner.id);","+    assert.deepEqual(","+      rows.map((row: { value: string }) => row.value),","+      [tabB],","+    );","+    await saveToken(cookie, token(tabB)).expect(200);","+    assert.equal((await stateRows(owner.id)).length, 0);","+  });","+","+  it('rejects a token with a null state when no connection was started', async function () {","+    const cookie = await signIn(owner);","+","+    await saveToken(cookie, token(null)).expect(400);","+    assert.equal(await setting('stripe_connect_publishable_key'), null);","+  });","+","+  it('rejects a mismatched state', async function () {","+    const cookie = await signIn(owner);","+    await startConnect(cookie);","+","+    await saveToken(cookie, token('not-the-state')).expect(400);","+    assert.equal(await setting('stripe_connect_publishable_key'), null);","+  });","+","+  it('rejects an expired state', async function () {","+    const cookie = await signIn(owner);","+    const state = await startConnect(cookie);","+    await stateRows(owner.id).update({ expires_at: new Date(Date.now() - 1000) });","+","+    await saveToken(cookie, token(state)).expect(400);","+    assert.equal(await setting('stripe_connect_publishable_key'), null);","+  });","+","+  it(\"rejects another staff user's state\", async function () {","+    const ownerCookie = await signIn(owner);","+    const adminCookie = await signIn(admin);","+    const state = await startConnect(ownerCookie);","+","+    await saveToken(adminCookie, token(state)).expect(400);","+    assert.equal(await setting('stripe_connect_publishable_key'), null);","+    // The owner's state is untouched","+    assert.equal((await stateRows(owner.id)).length, 1);","+  });","+});"],"additions":237,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/auth/better-auth/stripe-connect-state.test.ts","lines":["@@ -0,0 +1,118 @@","+import assert from 'node:assert/strict';","+import sinon from 'sinon';","+import {","+  createStripeConnectState,","+  STATE_TTL_MS,","+} from '../../../../../core/server/auth/better-auth/stripe-connect-state';","+","+type Row = { identifier: string; value: string; expiresAt: Date };","+","+// Mirrors internalAdapter: find returns the latest row, expired or not","+function fakeAdapter() {","+  let rows: Row[] = [];","+  return {","+    get rows() {","+      return rows;","+    },","+    createVerificationValue: sinon.spy(async (data: Row) => {","+      rows.push(data);","+      return { id: 'id', createdAt: new Date(), updatedAt: new Date(), ...data };","+    }),","+    deleteVerificationByIdentifier: sinon.spy(async (identifier: string) => {","+      rows = rows.filter((row) => row.identifier !== identifier);","+    }),","+    findVerificationValue: sinon.spy(async (identifier: string) => {","+      return rows.filter((row) => row.identifier === identifier).at(-1) ?? null;","+    }),","+    deleteMany: sinon.spy(","+      async ({ where }: { model: string; where: { field: keyof Row; value: unknown }[] }) => {","+        rows = rows.filter((row) => !where.every(({ field, value }) => row[field] === value));","+        return 0;","+      },","+    ),","+  };","+}","+","+describe('Better Auth Stripe Connect state', function () {","+  let adapter: ReturnType<typeof fakeAdapter>;","+  let state: ReturnType<typeof createStripeConnectState>;","+","+  beforeEach(function () {","+    adapter = fakeAdapter();","+    state = createStripeConnectState({","+      getContext: async () => ({ internalAdapter: adapter, adapter }) as any,","+    });","+  });","+","+  afterEach(function () {","+    sinon.restore();","+  });","+","+  it('stores the state per user with a short expiry until cleared', async function () {","+    const now = Date.now();","+    const clock = sinon.useFakeTimers({ now, toFake: ['Date'] });","+    try {","+      await state.set('user-1', 'state-1');","+","+      sinon.assert.calledOnceWithExactly(adapter.createVerificationValue, {","+        identifier: 'stripe-connect:user-1',","+        value: 'state-1',","+        expiresAt: new Date(now + STATE_TTL_MS),","+      });","+      // Reading keeps it, so a failed save can be retried","+      assert.equal(await state.get('user-1'), 'state-1');","+      assert.equal(await state.get('user-1'), 'state-1');","+","+      await state.clear('user-1', 'state-1');","+      assert.equal(await state.get('user-1'), null);","+    } finally {","+      clock.restore();","+    }","+  });","+","+  it('replaces an earlier state for the same user', async function () {","+    await state.set('user-1', 'old');","+    await state.set('user-1', 'new');","+","+    assert.deepEqual(","+      adapter.rows.map((row) => row.value),","+      ['new'],","+    );","+    assert.equal(await state.get('user-1'), 'new');","+  });","+","+  it(\"does not return another user's state\", async function () {","+    await state.set('user-1', 'state-1');","+","+    assert.equal(await state.get('user-2'), null);","+    await state.clear('user-2', 'state-1');","+    assert.equal(await state.get('user-1'), 'state-1');","+  });","+","+  it('clears only the state it was given, keeping a connection started meanwhile', async function () {","+    await state.set('user-1', 'tab-a');","+    assert.equal(await state.get('user-1'), 'tab-a');","+    // Another tab starts connecting while tab A's save is in flight","+    await state.set('user-1', 'tab-b');","+","+    await state.clear('user-1', 'tab-a');","+    assert.equal(await state.get('user-1'), 'tab-b');","+  });","+","+  it('returns null for an expired state', async function () {","+    await state.set('user-1', 'state-1');","+    adapter.rows[0].expiresAt = new Date(Date.now() - 1);","+","+    assert.equal(await state.get('user-1'), null);","+  });","+","+  it('refuses a request without a staff user', async function () {","+    await assert.rejects(state.set(undefined, 'state'), { errorType: 'NoPermissionError' });","+    await assert.rejects(state.get(undefined), { errorType: 'NoPermissionError' });","+    await assert.rejects(state.clear(undefined, 'state'), { errorType: 'NoPermissionError' });","+    sinon.assert.notCalled(adapter.createVerificationValue);","+    sinon.assert.notCalled(adapter.findVerificationValue);","+    sinon.assert.notCalled(adapter.deleteVerificationByIdentifier);","+    sinon.assert.notCalled(adapter.deleteMany);","+  });","+});"],"additions":118,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/services/members/stripe-connect.test.js","lines":["@@ -62,4 +62,17 @@ describe('Members - Stripe Connect', function () {","       },","     );","   });","+","+  for (const stored of [null, undefined, '']) {","+    it(`getStripeConnectTokenData throws when no state is stored (${stored}) and the token carries the same`, async function () {","+      const encodedData = Buffer.from(","+        JSON.stringify({ p: 'pk', a: 'sk', l: false, s: stored }),","+      ).toString('base64');","+","+      await assert.rejects(","+        stripeConnect.getStripeConnectTokenData(encodedData, () => stored),","+        { errorType: 'NoPermissionError' },","+      );","+    });","+  }"," });",""],"additions":13,"deletions":0,"truncated":false}],"additions":594,"deletions":37,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-18T16:50:19.665649+00:00"}