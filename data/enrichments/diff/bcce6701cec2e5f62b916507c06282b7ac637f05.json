      slot,","+        slot_storage,","+        (prepared.attachment, staged),","+        prepared.kind,","+        prepared.dist,","+        (decodes, permit),","+    )","+    .await?;","+    let Some(derived) = derived else { return Ok((slot, None)) };","+    if let Some(tgz_integrity) = &derived.tgz_integrity {","+        let recorded = record_published_tar(storage, name, tgz_integrity, &derived, slot_storage);","+        if let Err(err) = recorded.await {","+            slot.abandon().await;","+            return Err(err);","+        }","+    }","+    Ok((slot, Some(published_tar(prepared.version, prepared.variant_tag, derived))))","+}","+","+async fn staged_bytes(","+    (storage, claimant): (&Storage, Option<&str>),","+    attachment: &PendingAttachment,","+    decodes: &Arc<Semaphore>,","+) -> Result<(Option<Vec<u8>>, Option<OwnedSemaphorePermit>), RegistryError> {","+    let Some(integrity) = attachment.staged_integrity() else { return Ok((None, None)) };","+    let permit =","+        Arc::clone(decodes).acquire_owned().await.expect(\"the decode semaphore is never closed\");","+    let bytes = claim_staged_archive(storage, claimant, &attachment.filename, integrity).await?;","+    Ok((Some(bytes), Some(permit)))","+}","+","+fn published_tar(","+    version: String,","+    variant_tag: Option<String>,","+    derived: TarDerivation,","+) -> PublishedTar {","+    let variant = variant_tag.map(|tag| {","+        let tgz = derived.tgz_integrity.as_deref();","+        variants::variant_tar(tag, &derived.integrity, tgz, &derived.archive)","+    });","+    let TarDerivation {","+        tgz_integrity,","+        integrity,","+        inspection,","+        archive,","+    } = derived;","+    PublishedTar {","+        version,","+        tgz_integrity,","+        integrity,","+        inspection,","+        archive,","+        variant,","+        generated: false,","+    }","+}","+","+async fn record_published_tar(","+    storage: &Storage,","+    name: &CanonicalPackageName,","+    tgz_integrity: &str,","+    derived: &TarDerivation,","+    slot_storage: TarballStorage,","+) -> Result<(), RegistryError> {","+    let inspection = &derived.inspection;","+    let derived = pnpr_storage::DerivedTar::new(","+        derived.integrity.to_string(),","+        inspection.requires_build,","+        inspection.file_count,","+        inspection.unpacked_size,","+    )","+    .with_bins(inspection.bins.clone());","+    let Err(err) = storage.record_tar_integrity(name, tgz_integrity, derived).await else {","+        return Ok(());","+    };","+    tracing::warn!(?err, package = %name.as_str(), \"recording a tar integrity failed\");","+    match slot_storage {","+        TarballStorage::Tar => Err(err),","+        TarballStorage::Tgz => Ok(()),","+    }","+}","+"," /// Where an attachment is written, and where its tar is encoded to when the"," /// registry stores tars."," pub(super) struct AttachmentPaths {"],"additions":149,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/release_record_logs.rs","lines":["@@ -1,4 +1,4 @@","-//! Integrating the transparency logs of hosted release records","+//! Integrating and reconciling the transparency logs of hosted release records"," //! ([release records](https://github.com/pnpm/rfcs/blob/92d2b281af321ecf8f1e5fea63f698716ba4e9e7/pnpr/text/0000-release-records.md#transparency-log))."," //!"," //! A record's log entry is sequenced when its version is accepted. A commit","@@ -6,13 +6,119 @@"," //! server once integrates every log, which picks up whatever an interrupted"," //! integration left: when its router is built, or, for a router built"," //! outside a Tokio runtime, at the first integration it starts or the","-//! first read of a log. A publication's success means committed, not yet","-//! integrated. Without a log signing key, entries are sequenced and nothing","-//! is integrated.","+//! first read of a log. Startup and publish commits reconcile each log against","+//! `.transparency-log/` before new entries are sequenced, re-importing","+//! checkpoint-signed entries from stored bundles after a metadata rollback and","+//! refusing forked logs."," "," use super::AppState;","-use pnpr_storage::transparency_log::LogId;","-use std::sync::{Arc, atomic::Ordering};","+use pnpm_transparency_log::NoteSigner;","+use pnpr_config::Config;","+use pnpr_error::Result;","+use pnpr_package_name::Ecosystem;","+use pnpr_storage::{","+    Storage,","+    metadata::SqlMetadata,","+    transparency_log::{LogId, StoredCheckpoint},","+};","+use std::{","+    collections::HashMap,","+    sync::{","+        Arc, Mutex, PoisonError,","+        atomic::{AtomicBool, Ordering},","+    },","+};","+","+#[derive(Default)]","+pub(super) struct LogIntegrationState {","+    locks: Mutex<HashMap<LogId, Arc<tokio::sync::Mutex<()>>>>,","+    recovered: AtomicBool,","+    reconciled: Mutex<HashMap<LogId, Option<StoredCheckpoint>>>,","+}","+","+impl LogIntegrationState {","+    fn lock_for(&self, log: &LogId) -> Arc<tokio::sync::Mutex<()>> {","+        let mut locks = self.locks.lock().unwrap_or_else(PoisonError::into_inner);","+        Arc::clone(","+            locks","+                .entry(log.clone())","+                .or_insert_with(|| Arc::new(tokio::sync::Mutex::new(()))),","+        )","+    }","+","+    fn matching_checkpoint(","+        &self,","+        log: &LogId,","+        current: Option<&StoredCheckpoint>,","+    ) -> Option<Option<StoredCheckpoint>> {","+        self.reconciled","+            .lock()","+            .unwrap_or_else(PoisonError::into_inner)","+            .get(log)","+            .filter(|cached| cached.as_ref() == current)","+            .cloned()","+    }","+"],"additions":52,"deletions":6,"truncated":false}],"additions":399,"deletions":181,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-12T17:12:43.596120+00:00"}