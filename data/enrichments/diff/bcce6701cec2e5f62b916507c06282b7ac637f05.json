{"id":"bcce6701cec2e5f62b916507c06282b7ac637f05","axis":"silent","repo":"pnpm/pnpm","sha":"bcce6701cec2e5f62b916507c06282b7ac637f05","parsed":{"files":[{"path":".changeset/pnpr-transparency-log-restore.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now re-imports transparency log entries from stored entry bundles when the metadata database is restored from an earlier snapshot than hosted storage. Rolled-back package versions from those entries cannot be republished, and pnpr refuses to start or sign checkpoints when stored log state diverges from the database. `pnpr migrate-storage` also copies transparency log tiles, entry bundles, and checkpoints to S3 [zkochan/pnpm-tasks#65](https://github.com/zkochan/pnpm-tasks/issues/65)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/release-record/src/purl.rs","lines":["@@ -114,6 +114,22 @@ impl Purl {","         rest.split_once('/').map_or(rest, |(purl_type, _)| purl_type)","     }"," ","+    /// The npm package name and version this PURL names, or `None` for","+    /// another PURL type, a variant PURL, or a non-canonical spelling.","+    #[must_use]","+    pub fn npm_package(&self) -> Option<(String, String)> {","+        let parts = Components::parse(&self.0)?;","+        if parts.purl_type != \"npm\" || !parts.qualifiers.is_empty() {","+            return None;","+        }","+        let name = match parts.namespace.as_deref() {","+            Some(scope) => format!(\"{scope}/{}\", parts.name),","+            None => parts.name,","+        };","+        let rebuilt = Purl::npm(&name, &parts.version).ok()?;","+        (rebuilt == *self).then_some((name, parts.version))","+    }","+","     /// Checks that an `npm`, `cargo`, or `pypi` PURL is exactly the one","     /// [`Purl::npm`], [`Purl::npm_variant`], [`Purl::cargo`], or","     /// [`Purl::pypi_file`] builds from its components, so one release has one"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpm/crates/release-record/src/purl/tests.rs","lines":["@@ -145,3 +145,24 @@ fn spells_a_purl_canonically() {","     let vcs = \"pkg:npm/legacy!pkg@1.0.0?vcs_url=git%2Bhttps://example.com/legacy.git\";","     assert_eq!(Purl::from_string_unchecked(vcs.to_owned()).canonical(), None);"," }","+","+#[test]","+fn extracts_npm_package_name_and_version() {","+    assert_eq!(","+        Purl::npm(\"@example/widgets\", \"1.2.0-beta.1+build.5\").unwrap().npm_package(),","+        Some((\"@example/widgets\".to_owned(), \"1.2.0-beta.1+build.5\".to_owned())),","+    );","+    assert_eq!(","+        Purl::npm(\"foobar\", \"12.3.1\").unwrap().npm_package(),","+        Some((\"foobar\".to_owned(), \"12.3.1\".to_owned())),","+    );","+    assert_eq!(","+        Purl::npm_variant(\"@example/cli\", \"4.0.0\", \"linux-x64\").unwrap().npm_package(),","+        None,","+    );","+    assert_eq!(Purl::cargo(\"serde\", \"1.0.210\").unwrap().npm_package(), None);","+    assert_eq!(","+        Purl::from_string_unchecked(\"pkg:npm/@example/widgets@1.2.0\".to_owned()).npm_package(),","+        None,","+    );","+}"],"additions":21,"deletions":0,"truncated":false},{"path":"pnpm/crates/transparency-log/src/tiles.rs","lines":["@@ -78,6 +78,13 @@ impl TilePath {","             TilePath::Hashes { width, .. } | TilePath::Entries { width, .. } => width == TILE_WIDTH,","         }","     }","+","+    /// The path prefix under which partial entry bundles of `index` are","+    /// stored (`tile/entries/<N>.p`), without a trailing `/`.","+    #[must_use]","+    pub fn partial_entries_prefix(index: u64) -> String {","+        format!(\"tile/entries/{}.p\", encode_index(index))","+    }"," }"," "," impl fmt::Display for TilePath {"],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/transparency-log/src/tiles/tests.rs","lines":["@@ -89,3 +89,14 @@ fn does_not_convert_hash_tiles_outside_tlog_tiles_bounds() {","         assert_eq!(TilePath::Hashes { level, index: 0, width }.to_tile(), None);","     }"," }","+","+#[test]","+fn formats_partial_entries_prefix_for_bundle_discovery() {","+    assert_eq!(TilePath::partial_entries_prefix(0), \"tile/entries/000.p\");","+    assert_eq!(TilePath::partial_entries_prefix(1_234_067), \"tile/entries/x001/x234/067.p\");","+    let candidate = format!(\"{}/17\", TilePath::partial_entries_prefix(1_234_067));","+    assert_eq!(","+        candidate.parse::<TilePath>(),","+        Ok(TilePath::Entries { index: 1_234_067, width: 17 }),","+    );","+}"],"additions":11,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/cli_commands.rs","lines":["@@ -266,7 +266,9 @@ fn run_import_htpasswd("," }"," "," async fn run_gc(config: &Config, options: &crate::archive_gc::GcOptions) -> miette::Result<()> {","-    crate::prepare_storage(config).await.map_err(|err| redacted_report(&err))?;","+    if !options.dry_run {","+        crate::prepare_storage(config).await.map_err(|err| redacted_report(&err))?;","+    }","     let report = crate::archive_gc::collect_archives(config, options).await","         .map_err(|err| redacted_report(&err))?;","     let verb = if options.dry_run { \"would remove\" } else { \"removed\" };"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/migrate_storage.rs","lines":["@@ -48,6 +48,14 @@ pub async fn migrate_local_to_s3(","             migrate_namespace(&src, &tgt, options, &mut report).await?;","         }","     }","+    migrate_transparency_logs(","+        &source,","+        &target,","+        config.release_records.log_signing_key.as_deref(),","+        options,","+        &mut report,","+    )","+    .await?;"," ","     Ok(report)"," }","@@ -117,8 +125,11 @@ fn resolve_target_s3_config(","             allow_http: None,","         };","         Ok(HostedStoreConfig::S3(settings))","-    } else if let HostedStoreConfig::S3(s) = &config.storage.hosted_backend {","-        Ok(HostedStoreConfig::S3(s.clone()))","+    } else if matches!(","+        config.storage.hosted_backend,","+        HostedStoreConfig::S3(_) | HostedStoreConfig::ObjectStore { .. },","+    ) {","+        Ok(config.storage.hosted_backend.clone())","     } else {","         Err(miette::miette!(","             \"destination S3 storage must be configured via YAML 's3:' or CLI flag '--to-bucket'\"","@@ -201,6 +212,82 @@ async fn verify_uploaded_archive(","     }"," }"," ","+/// Copy every `.transparency-log` tile, entry bundle, and checkpoint from","+/// `source` to `target`, uploading tiles and bundles before checkpoints.","+async fn migrate_transparency_logs(","+    source: &Storage,","+    target: &Storage,","+    signer: Option<&pnpm_transparency_log::NoteSigner>,","+    options: &MigrateStorageOptions,","+    report: &mut MigrateReport,","+) -> miette::Result<()> {","+    let keys = source","+        .stored_log_record_keys()","+        .await","+        .map_err(|err| miette::miette!(\"failed to list source transparency-log records: {err}\"))?;","+    for key in keys {","+        migrate_log_record(source, target, &key, signer, options, report).await?;","+    }","+    Ok(())","+}","+","+async fn migrate_log_record(","+    source: &Storage,","+    target: &Storage,","+    key: &str,","+    signer: Option<&pnpm_transparency_log::NoteSigner>,","+    options: &MigrateStorageOptions,","+    report: &mut MigrateReport,","+) -> miette::Result<()> {","+    let opened = source","+        .read_log_record(key)","+        .await","+        .map_err(|err| {","+            miette::miette!(\"failed to read source transparency-log record '{key}': {err}\")","+        })?;","+    let Some(bytes) = opened else { return Ok(()) };","+    report.blobs_transferred += 1;","+    report.bytes_transferred += bytes.len() as u64;","+    if options.dry_run {","+        return Ok(());","+    }","+    target","+        .store_log_record_copy(key, &bytes, signer)","+        .await","+        .map_err(|err| {","+            miette::miette!(\"failed to store transparency-log record '{key}' on target: {err}\")","+        })?;","+    if options.verify {","+        verify_uploaded_log_record(target, key, &bytes).await?;","+    }","+    Ok(())","+}","+","+async fn verify_uploaded_log_record(","+    target: &Storage,","+    key: &str,","+    expected_bytes: &[u8],","+) -> miette::Result<()> {","+    let stored = target","+        .read_log_record(key)","+        .await","+        .map_err(|err| {","+            miette::miette!(\"failed to verify uploaded transparency-log record '{key}': {err}\")","+        })?;","+    let Some(bytes) = stored else {","+        return Err(miette::miette!(","+            \"uploaded transparency-log record '{key}' not found in target store\"","+        ));","+    };","+    if bytes.as_slice() == expected_bytes {","+        Ok(())","+    } else {","+        Err(miette::miette!(","+            \"uploaded transparency-log record '{key}' content mismatch: target does not match source\"","+        ))","+    }","+}","+"," #[must_use]"," pub fn format_migrate_report(report: &MigrateReport) -> String {","     let action = if report.dry_run { \"would be migrated\" } else { \"migrated\" };"],"additions":89,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/lifecycle.rs","lines":["@@ -20,14 +20,16 @@ pub(super) fn load_active_osv_index(","     }"," }"," ","-/// Check the hosted store's layout, and empty a proxy cache in another","-/// layout. [`serve`] and [`serve_listener`] call this before binding; an","-/// embedder that builds a router directly should call it itself on startup,","-/// before serving requests.","+/// Check the hosted store's layout, empty a proxy cache in another layout,","+/// and reconcile hosted transparency logs with the metadata database.","+/// [`serve`] and [`serve_listener`] call this before binding; an embedder that","+/// builds a router directly should call it itself on startup, before serving","+/// requests."," pub async fn prepare_storage(config: &Config) -> pnpr_error::Result<()> {