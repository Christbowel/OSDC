hat the"," /// ignore rules keep. It does not descend into a top-level `node_modules` or"," /// into a version-control directory, and does not follow symlinks.","-pub(crate) fn walk_files(","+///","+/// An entry below `pkg_dir` that is removed while the walk reads it is not","+/// part of the package and is skipped. A missing `pkg_dir` is an error.","+pub(crate) fn walk_files<Sys: FsReadDir + FsRead>(","     pkg_dir: &Path,","     options: PackageRules<'_>,","     on_file: &mut dyn FnMut(&Path, fs::FileType),"," ) -> io::Result<()> {","-    let matcher = root_rules(pkg_dir, options)?;","+    let matcher = root_rules::<Sys>(pkg_dir, options)?;","     let root_rules = matcher.rules;","     let root = DirRules {","         parent: None,","@@ -48,20 +80,30 @@ pub(crate) fn walk_files(","         rules: root_rules,","         exact: false,","     };","-    let mut walker = Walker {","+    let mut walker = Walker::<Sys> {","         named_files: (!matcher.named_files.is_empty()).then_some(&matcher.named_files),","         on_file,","+        sys: PhantomData,","     };","     walker.walk_dir(pkg_dir, &root, 0)"," }"," ","-fn root_rules(pkg_dir: &Path, options: PackageRules<'_>) -> io::Result<files_field::FilesMatcher> {","+fn root_rules<Sys: FsRead>(","+    pkg_dir: &Path,","+    options: PackageRules<'_>,","+) -> io::Result<files_field::FilesMatcher> {","     let files = options.manifest.get(\"files\").and_then(serde_json::Value::as_array);","     let mut matcher =","         files_field::compile_files_rules(pkg_dir, files.map_or(&[][..], Vec::as_slice));","     if files.is_none() {","-        matcher.rules = inherited_rules(pkg_dir, options.workspace_dir)?;","-        matcher.rules.extend(read_dir_rules(pkg_dir)?);","+        let own = read_dir_ignore_file::<Sys>(pkg_dir)?;","+        matcher.rules = if own.is_npmignore {","+            own.rules","+        } else {","+            let mut rules = inherited_rules::<Sys>(pkg_dir, options.workspace_dir)?;","+            ru