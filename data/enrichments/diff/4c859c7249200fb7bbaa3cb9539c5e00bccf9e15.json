Ok(rules);","-    }","     let Some(parent_rel) = pkg_dir","         .parent()","         .and_then(|parent| parent.strip_prefix(workspace_dir).ok())","@@ -359,13 +458,13 @@ fn inherited_rules(pkg_dir: &Path, workspace_dir: Option<&Path>) -> io::Result<V","         return Ok(rules);","     };","     let mut current = workspace_dir.to_path_buf();","-    rules.extend(read_dir_rules(&current)?);","+    rules.extend(read_dir_rules::<Sys>(&current)?);","     for component in parent_rel.components() {","         // A component other than `Normal` means a non-canonical path; stop","         // rather than read ignore files outside the workspace.","         let Component::Normal(segment) = component else { break };","         current.push(segment);","-        rules.extend(read_dir_rules(&current)?);","+        rules.extend(read_dir_rules::<Sys>(&current)?);","     }","     Ok(rules)"," }"],"additions":125,"deletions":26,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/ignore_walk/tests.rs","lines":["@@ -360,3 +360,5 @@ fn lockfile_staging_entries_are_pruned_before_visiting_even_with_a_files_allowli","         );","     }"," }","+","+mod vanished_entries;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/ignore_walk/tests/vanished_entries.rs","lines":["@@ -0,0 +1,206 @@","+//! Entries that another process removes or renames while the walk reads them.","+","+use super::super::{FsRead, FsReadDir, Host, LISTING_ATTEMPTS, PackageRules, walk_files};","+use std::{","+    fs, io,","+    path::Path,","+    sync::atomic::{AtomicBool, AtomicUsize, Ordering},","+};","+","+/// Implements [`FsRead`] for a fake that only changes how directories are","+/// listed.","+macro_rules! reads_from_disk {","+    ($fake:ty) => {","+        impl FsRead for $fake {","+            fn read(path: &Path) -> io::Result<Vec<u8>> {","+                fs::read(path)","+            }","+        }","+    };","+}","+","+fn walked_files<Sys: FsReadDir + FsRead>(pkg_dir: &Path) -> io::Result<Vec<String>> {","+    walked_workspace_files::<Sys>(pkg_dir, None)","+}","+","+fn walked_workspace_files<Sys: FsReadDir + FsRead>(","+    pkg_dir: &Path,","+    workspace_dir: Option<&Path>,","+) -> io::Result<Vec<String>> {","+    let manifest = serde_json::json!({});","+    let rules =","+        PackageRules { workspace_dir, manifest: &manifest, include_alternate_manifests: true };","+    let mut files = Vec::new();","+    walk_files::<Sys>(pkg_dir, rules, &mut |path, _| {","+        let relative = path.strip_prefix(pkg_dir).unwrap();","+        files.push(relative.to_string_lossy().replace('\\\\', \"/\"));","+    })?;","+    files.sort();","+    Ok(files)","+}","+","+fn package_with_lib() -> tempfile::TempDir {","+    let root = tempfile::tempdir().unwrap();","+    fs::write(root.path().join(\"package.json\"), \"{}\").unwrap();","+    fs::write(root.path().join(\"index.js\"), \"\").unwrap();","+    fs::create_dir(root.path().join(\"lib\")).unwrap();","+    fs::write(root.path().join(\"lib/a.js\"), \"\").unwrap();","+    root","+}","+","+fn not_found() -> io::Result<fs::DirEntry> {","+    Err(io::Error::from(io::ErrorKind::NotFound))","+}","+","+#[test]","+fn a_listing_failed_by_a_concurrent_rename_is_read_again() {","+    struct InterruptedOnce;","+    static INTERRUPTED: AtomicBool = AtomicBool::new(false);","+    impl FsReadDir for InterruptedOnce {","+        fn read_dir(path: &Path) -> io::Result<impl Iterator<Item = io::Result<fs::DirEntry>>> {","+            let interrupt = !INTERRUPTED.swap(true, Ordering::SeqCst);","+            let listed = if interrupt { 1 } else { usize::MAX };","+            Ok(fs::read_dir(path)?","+                .take(listed)","+                .chain(interrupt.then(not_found)))","+        }","+    }","+    reads_from_disk!(InterruptedOnce);","+    let root = package_with_lib();","+","+    let files = walked_files::<InterruptedOnce>(root.path()).unwrap();","+","+    assert_eq!(files, [\"index.js\", \"lib/a.js\", \"package.json\"]);","+}","+","+#[test]","+fn a_listing_that_keeps_failing_is_an_error() {","+    struct AlwaysInterrupted;","+    static ATTEMPTS: AtomicUsize = AtomicUsize::new(0);","+    impl FsReadDir for AlwaysInterrupted {","+        fn read_dir(path: &Path) -> io::Result<impl Iterator<Item = io::Result<fs::DirEntry>>> {","+            ATTEMPTS.fetch_add(1, Ordering::SeqCst);","+            Ok(fs::read_dir(path)?.chain([not_found()]))","+        }","+    }","+    reads_from_disk!(AlwaysInterrupted);","+    let root = package_with_lib();","+","+    let error = walked_files::<AlwaysInterrupted>(root.path()).unwrap_err();","+","+    assert_eq!(error.kind(), io::ErrorKind::NotFound);","+    assert_eq!(ATTEMPTS.load(Ordering::SeqCst), LISTING_ATTEMPTS);","+}","+","+#[test]","+fn a_subdirectory_listing_that_keeps_failing_is_an_error() {","+    struct LibAlwaysInterrupted;","+    impl FsReadDir for LibAlwaysInterrupted {","+        fn read_dir(path: &Path) -> io::Result<impl Iterator<Item = io::Result<fs::DirEntry>>> {","+            let interrupt = path.ends_with(\"lib\");","+            Ok(fs::read_dir(path)?.chain(interrupt.then(not_found)))","+        }","+    }","+    reads_from_disk!(LibAlwaysInterrupted);","+    let root = package_with_lib();","+","+    let error = walked_files::<LibAlwaysInterrupted>(root.path()).unwrap_err();","+","+    assert_eq!(error.kind(), io::ErrorKind::NotFound);","+}","+","+#[test]","+fn a_directory_removed_before_the_walk_enters_it_is_skipped() {","+    struct RemovesLibAfterListing;","+    impl FsReadDir for RemovesLibAfterListing {","+        fn read_dir(path: &Path) -> io::Result<impl Iterator<Item = io::Result<fs::DirEntry>>> {","+            let entries: Vec<_> = fs::read_dir(path)?.collect();","+            let lib = path.join(\"lib\");","+            if lib.is_dir() {","+                fs::remove_dir_all(lib)?;","+            }","+            Ok(entries.into_iter())","+        }","+    }","+    reads_from_disk!(RemovesLibAfterListing);","+    let root = package_with_lib();","+","+    let files = walked_files::<RemovesLibAfterListing>(root.path()).unwrap();","+","+    assert_eq!(files, [\"index.js\", \"package.json\"]);","+}","+","+#[test]","+fn an_npmignore_removed_before_it_is_read_falls_back_to_the_gitignore() {","+    struct RemovesNpmignoreBeforeReading;","+    impl FsReadDir for RemovesNpmignoreBeforeReading {","+        fn read_dir(path: &Path) -> io::Result<impl Iterator<Item = io::Result<fs::DirEntry>>> {","+            fs::read_dir(path)","+        }","+    }","+    impl FsRead for RemovesNpmignoreBeforeReading {","+        fn read(path: &Path) -> io::Result<Vec<u8>> {","+            if path.ends_with(\".npmignore\") {","+                fs::remove_file(path)?;","+            }","+            fs::read(path)","+        }","+    }","+    let root = tempfile::tempdir().unwrap();","+    for (name, contents) in [","+        (\"package.json\", \"{}\"),","+        (\"index.js\", \"\"),","+        (\"secret.js\", \"\"),","+        (\"other.js\", \"\"),","+        (\".npmignore\", \"other.js\\n\"),","+        (\".gitignore\", \"secret.js\\n\"),","+    ] {","+        fs::write(root.path().join(name), contents).unwrap();","+    }","+","+    let files = walked_files::<RemovesNpmignoreBeforeReading>(root.path()).unwrap();","+","+    assert_eq!(files, [\"index.js\", \"other.js\", \"package.json\"]);","+}","+","+#[test]","+fn a_workspace_package_whose_npmignore_is_removed_before_it_is_read_inherits_workspace_rules() {","+    struct RemovesNpmignoreBeforeReading;","+    impl FsReadDir for RemovesNpmignoreBeforeReading {","+        fn read_dir(path: &Path) -> io::Result<impl Iterator<Item = io::Result<fs::DirEntry>>> {","+            fs::read_dir(path)","+        }","+    }","+    impl FsRead for RemovesNpmignoreBeforeReading {","+        fn read(path: &Path) -> io::Result<Vec<u8>> {","+            if path.ends_with(\".npmignore\") {","+                fs::remove_file(path)?;","+            }","+            fs::read(path)","+        }","+    }","+    let workspace = tempfile::tempdir().unwrap();","+    fs::write(workspace.path().join(\".gitignore\"), \"secret.js\\n\").unwrap();","+    let pkg_dir = workspace.path().join(\"packages/pkg\");","+    fs::create_dir_all(&pkg_dir).unwrap();","+    for (name, contents) in","+        [(\"package.json\", \"{}\"), (\"index.js\", \"\"), (\"secret.js\", \"\"), (\".npmignore\", \"secret.js\\n\")]","+    {","+        fs::write(pkg_dir.join(name), contents).unwrap();","+    }","+","+    let files =","+        walked_workspace_files::<RemovesNpmignoreBeforeReading>(&pkg_dir, Some(workspace.path()))","+            .unwrap();","+","+    assert_eq!(files, [\"index.js\", \"package.json\"]);","+}","+","+#[test]","+fn a_missing_package_root_is_an_error() {","+    let base = tempfile::tempdir().unwrap();","+","+    let error = walked_files::<Host>(&base.path().join(\"missing\")).unwrap_err();","+","+    assert_eq!(error.kind(), io::ErrorKind::NotFound);","+}"],"additions":206,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/lib.rs","lines":["@@ -13,7 +13,7 @@ pub use ignore_walk::files_field::{FilesMatcher, build_files_matcher};"," pub use pnpm_fs::{AdmittedSymlink, SymlinkTargetKind};"," "," use derive_more::{Display, Error};","-use ignore_walk::{PackageRules, walk_files};","+use ignore_walk::{Host, PackageRules, walk_files};"," use pnpm_diagnostics::miette::{self, Diagnostic};"," use pnpm_package_manifest::safe_read_package_json_from_dir;"," use serde_json::Value;","@@ -153,7 +153,7 @@ fn collect_own_files(","     options: PackageRules<'_>,"," ) -> Result<SelectedPackageFiles, PacklistError> {","     let mut out = SelectedPackageFiles::default();","-    walk_files(pkg_dir, options, &mut |path, file_type| {","+    walk_files::<Host>(pkg_dir, options, &mut |path, file_type| {","         if let Some(entry) = classify_entry(pkg_dir, path, file_type) {","             let rel = relative_forward_slash(pkg_dir, path);","             out.files.insert(rel.clone(), pkg_dir.join(&rel));"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm11/__typings__/typed.d.ts","lines":["@@ -93,10 +93,15 @@ declare module 'npm-packlist' {","     class Walker {","       constructor (tree: PacklistTree, options?: Record<string, unknown>)","       isPackage: boolean","+      parent: Walker | null","       path: string","       requiredFiles: string[]","       tree: PacklistTree","+      addIgnoreFile (file: string, callback: () => void): void","+      emit (event: 'error', err: unknown): boolean","+      onReadIgnoreFile (file: string, data: string, callback: () => void): void","       onstat (opts: StatOptions, callback: () => void): void","+      stat (opts: Omit<StatOptions, 'st' | 'isSymbolicLink'>, callback: () => void): void","       walker (entry: string, opts: Record<string, unknown>, callback: () => void): void","       walkerOpt (entry: string, opts: Record<string, unknown>): Record<string, unknown>","       on (event: 'done', listener: (files: string[]) => void): this"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm11/fetching/directory-fetcher/test/index.ts","lines":["@@ -3,7 +3,7 @@ import fs from 'node:fs'"," import os from 'node:os'"," import path from 'node:path'"," ","-import { beforeAll, describe, expect, jest, test } from '@jest/globals'","+import { afterEach, beforeAll, beforeEach, describe, expect, jest, test } from '@jest/globals'"," import type { Cafs } from '@pnpm/store.cafs-types'"," import { fixtures } from '@pnpm/test-fixtures'"," import { lexCompare } from '@pnpm/text.ordinal-comparator'","@@ -354,3 +354,99 @@ test.each([true, false])('listFilesFromDir skips a lockfile staging file at the","     rimrafSync(pkgDir)","   }"," })","+","+describe('listFilesFromDir with entries removed while the package is walked', () => {","+  type ReaddirCallback = (err: NodeJS.ErrnoException | null, entries: string[]) => void","+  const readdir = fs.readdir","+  let pkgDir: string","+","+  beforeEach(() => {","+    pkgDir = fs.mkdtempSync(path.join(os.tmpdir(), 'directory-fetcher-'))","+    fs.writeFileSync(path.join(pkgDir, 'package.json'), JSON.stringify({ name: 'pkg', version: '1.0.0' }))","+    fs.writeFileSync(path.join(pkgDir, 'index.js'), '')","+    fs.mkdirSync(path.join(pkgDir, 'lib'))","+    fs.writeFileSync(path.join(pkgDir, 'lib/a.js'), '')","+  })","+","+  afterEach(() => {","+    jest.restoreAllMocks()","+    rimrafSync(pkgDir)","+  })","+","+  function mockReaddir (implementation: (dir: string, callback: ReaddirCallback) => void): void {","+    jest.spyOn(fs, 'readdir').mockImplementation(implementation as unknown as typeof fs.readdir)","+  }","+","+  async function listPackageFiles (): Promise<string[]> {","+    const { filesMap } = await listFilesFromDir(pkgDir, { includeOnlyPackageFiles: true })","+    return Array.from(filesMap.keys()).sort(lexCompare)","+  }","+","+  test('a listing that fails with ENOENT is read again', async () => {","+    let failed = false","+    mockReaddir((dir, callback) => {","+      if (path.resolve(dir) === pkgDir && !failed) {","+        failed = true","+        callback(Object.assign(new Error(`ENOENT: no such file or directory, '${dir}'`), { code: 'ENOENT' }), [])","+        return","+      }","+      readdir(dir, callback)","+    })","+","+    expect(await listPackageFiles()).toStrictEqual(['index.js', 'lib/a.js', 'package.json'])","+    expect(failed).toBe(true)","+  })","+","+  test('a file removed after its directory is listed is skipped', async () => {","+    mockReaddir((dir, callback) => {","+      readdir(dir, (err, entries) => {","+        fs.rmSync(path.join(pkgDir, 'index.js'), { force: true })","+        callback(err, entries)","+      })","+    })","+","+    expect(await listPackageFiles()).toStrictEqual(['lib/a.js', 'package.json'])","+  })","+","+  test('a directory removed before the walk enters it is skipped', async () => {","+    const lib = path.join