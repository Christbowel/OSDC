part-way is read again: on macOS, listings of a directory","+/// that still exists have failed that way while another process renamed one","+/// of its entries, so a listing that keeps failing is an error.","+///","+/// `None` when `dir` is missing and `may_be_missing` allows that. Otherwise","+/// opening a missing `dir` fails without a retry.","+fn list_dir<Sys: FsReadDir>(","+    dir: &Path,","+    may_be_missing: bool,","+) -> io::Result<Option<Vec<fs::DirEntry>>> {","+    let mut attempt = 1;","+    loop {","+        let listing = match Sys::read_dir(dir) {","+            Err(error) if may_be_missing && pnpm_fs::is_not_found(&error) => return Ok(None),","+            listing => listing?,","+        };","+        match listing.collect::<io::Result<Vec<_>>>() {","+            Err(error) if pnpm_fs::is_not_found(&error) && attempt < LISTING_ATTEMPTS => {","+                attempt += 1;","+            }","+            entries => return entries.map(Some),","+        }","+    }","+}","+"," fn is_pruned(name: &str, depth: usize) -> bool {","     (depth == 0","         && (crate::is_lockfile_staging_file(name)","@@ -325,19 +398,45 @@ fn matches_as_dir(rule: &IgnoreRule, entry: &str) -> bool {"," "," /// The rules of `dir`'s `.npmignore`, or of its `.gitignore` when it has no"," /// `.npmignore`.","-fn read_dir_rules(dir: &Path) -> io::Result<Vec<IgnoreRule>> {","-    let npmignore = dir.join(\".npmignore\");","-    let ignore_file = if npmignore.is_file() { npmignore } else { dir.join(\".gitignore\") };","-    if !ignore_file.is_file() {","-        return Ok(Vec::new());","+fn read_dir_rules<Sys: FsRead>(dir: &Path) -> io::Result<Vec<IgnoreRule>> {","+    Ok(read_dir_ignore_file::<Sys>(dir)?.rules)","+}","+","+/// The rules [`read_dir_rules`] reads, and which file they came from.","+struct DirIgnoreFile {","+    rules: Vec<IgnoreRule>,","+    /// Whether the rules are `dir`'s `.npmignore`, which replaces the","+    /// ignore files of the workspace directories above a