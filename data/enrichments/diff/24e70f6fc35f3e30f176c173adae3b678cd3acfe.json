t_changes(old_content: str, new_content: str) -> str:","+    \"\"\"Report target sysroot pin changes without container or lockfile changes.\"\"\"","+    old = read_sysroot_manifest(old_content)[\"sysroots\"]","+    new = read_sysroot_manifest(new_content)[\"sysroots\"]","+    lines = []","+    for distro in sorted(new):","+        for architecture, pin in sorted(new[distro].items()):","+            if old.get(distro, {}).get(architecture) != pin:","+                lines.append(f\"- **{distro}/{architecture}**: `{pin['sha256']}`\")","+    return \"\\n\".join(lines) or \"- No sysroot changes\"","+","+","+def merge_sysroot_pins(","+    base_content: str,","+    pending_content: str,","+    pending_base_content: str,","+    generated_content: str,","+    published_distros: set[str],","+) -> str:","+    \"\"\"Keep pending updates and merged pins, replacing only freshly published distros.\"\"\"","+    merged = read_sysroot_manifest(base_content, source=f\"Base {TOOLCHAIN_SYSROOT_FILE}\")","+    ancestor = read_sysroot_manifest(","+        pending_base_content, source=f\"PR ancestor {TOOLCHAIN_SYSROOT_FILE}\"","+    )[\"sysroots\"]","+    pending = read_sysroot_manifest(pending_content, source=f\"Pending {TOOLCHAIN_SYSROOT_FILE}\")[","+        \"sysroots\"","+    ]","+    generated = read_sysroot_manifest(","+        generated_content, source=f\"Generated {TOOLCHAIN_SYSROOT_FILE}\"","+    )[\"sysroots\"]","+    for distro, pins in pending.items():","+        for architecture, pin in pins.items():","+            old_pin = ancestor.get(distro, {}).get(architecture)","+            current_pin = merged[\"sysroots\"].get(distro, {}).get(architecture)","+            if pin != old_pin and current_pin == old_pin:","+                merged[\"sysroots\"].setdefault(distro, {})[architecture] = pin","+    for distro in published_distros:","+        if distro not in generated:","+            raise ValueError(","+                f\"Generated {TOOLCHAIN_SYSROOT_FILE} is missing published distro {distro}\"","+            )","+        merged[\"sysroots\"][distro] = generated[distro]","+    return json.dumps(merged, indent=2, sort_keys=True) + \"\\n\"","+","+","+def file_content_on_ref(repo: Repository.Repository, path: str, ref: str) -> str:"],"additions":58,"deletions":4,"truncated":false}],"additions":488,"deletions":15,"truncated":true,"file_count":5},"error":null,"fetched_at":"2026-11-27T19:04:39.647097+00:00"}