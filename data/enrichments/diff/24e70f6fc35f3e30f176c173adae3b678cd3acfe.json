{"id":"24e70f6fc35f3e30f176c173adae3b678cd3acfe","axis":"silent","repo":"mongodb/mongo","sha":"24e70f6fc35f3e30f176c173adae3b678cd3acfe","parsed":{"files":[{"path":".gitignore","lines":["@@ -379,3 +379,7 @@ CLAUDE.local.md"," "," # C++ Code Coverage Artifacts"," coverage/","+","+# Local toolchain sysroot build and validation output.","+/toolchain-sysroot-output/","+/toolchain-sysroot-validation.tgz"],"additions":4,"deletions":0,"truncated":false},{"path":"bazel/platforms/BUILD.bazel","lines":["@@ -331,12 +331,18 @@ platform("," )"," "," load(\"//bazel/uv:defs.bzl\", \"dependency\")","-load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_test\")","+load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_library\", \"py_test\")","+","+py_library(","+    name = \"toolchain_sysroot_manifest\",","+    srcs = [\"toolchain_sysroot_manifest.py\"],","+)"," "," py_binary(","     name = \"remote_execution_containers_generator\",","     srcs = [\"remote_execution_containers_generator.py\"],","     visibility = [\"//visibility:public\"],","+    deps = [\":toolchain_sysroot_manifest\"],"," )"," "," py_test(","@@ -344,8 +350,29 @@ py_test(","     srcs = [\"remote_execution_containers_generator_test.py\"],","     data = [","         \"remote_execution_containers_generator.py\",","+        \"//bazel/remote_execution_container:repin_dockerfiles.sh\",","         \"//evergreen:remote_execution_containers_generate.sh\",","     ],","+    deps = [\":toolchain_sysroot_manifest\"],","+)","+","+py_test(","+    name = \"toolchain_sysroots_generator_test\",","+    srcs = [\"toolchain_sysroots_generator_test.py\"],","+    data = [","+        \"remote_execution_containers_generator.py\",","+        \"remote_execution_containers_generator_test.py\",","+        \"toolchain_sysroots_generator.py\",","+        \"//bazel/remote_execution_container:repin_dockerfiles.sh\",","+        \"//evergreen:toolchain_sysroots_generate.sh\",","+    ],","+    deps = [","+        \":toolchain_sysroot_manifest\",","+        dependency(","+            \"retry\",","+            group = \"wrapper-hook\",","+        ),","+    ],"," )"," "," py_binary(","@@ -353,6 +380,7 @@ py_binary(","     srcs = [\"remote_execution_containers_pr.py\"],","     visibility = [\"//visibility:public\"],","     deps = [","+        \":toolchain_sysroot_manifest\",","         dependency(","             \"pygithub\",","             group = \"testing\",","@@ -364,6 +392,7 @@ py_test(","     name = \"remote_execution_containers_pr_test\",","     srcs = [\"remote_execution_containers_pr_test.py\"],","     data = [\"remote_execution_containers_pr.py\"],","+    deps = [\":toolchain_sysroot_manifest\"],"," )"," "," exports_files(["],"additions":30,"deletions":1,"truncated":false},{"path":"bazel/platforms/remote_execution_containers_generator.py","lines":["@@ -13,9 +13,15 @@"," import tarfile"," import tempfile"," from datetime import datetime","+from typing import Any"," "," from retry import retry"," ","+from bazel.platforms.toolchain_sysroot_manifest import (","+    TOOLCHAIN_SYSROOT_ARCHITECTURES as PUBLISHED_ARCHITECTURES,","+)","+from bazel.platforms.toolchain_sysroot_manifest import TOOLCHAIN_SYSROOT_DISTROS","+"," DEFAULT_PLATFORMS = (\"linux/amd64\", \"linux/arm64/v8\")"," RHEL_EXTRA_PLATFORMS = (\"linux/ppc64le\", \"linux/s390x\")"," DISTRO_EXTRA_PLATFORMS = {distro: RHEL_EXTRA_PLATFORMS for distro in (\"rhel8\", \"rhel9\", \"rhel10\")}","@@ -26,34 +32,128 @@"," BINFMT_IMAGE = (","     \"tonistiigi/binfmt@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0\""," )","-PUBLISHED_ARCHITECTURES = (\"amd64\", \"arm64\", \"ppc64le\", \"s390x\")"," MACHINE_ARCHITECTURES = {","     \"aarch64\": \"arm64\",","     \"x86_64\": \"amd64\","," }"," SYSROOT_PATHS = (\"usr/include\", \"usr/lib\", \"usr/lib64\", \"lib\", \"lib64\")","+SYSROOT_EXCLUDED_PATHS = (\"usr/lib/.build-id\", \"usr/lib64/.build-id\")","+TARGET_ELF = {","+    \"amd64\": (62, 1, \"ld-linux-x86-64.so.2\"),","+    \"arm64\": (183, 1, \"ld-linux-aarch64.so.1\"),","+    \"ppc64le\": (21, 1, \"ld64.so.2\"),","+    \"s390x\": (22, 2, \"ld64.so.1\"),","+}","+","+","+def validate_toolchain_sysroot(root: pathlib.Path, architecture: str) -> list[str]:","+    \"\"\"Check the target files used to configure/build GCC's runtime libraries.\"\"\"","+    machine, encoding, loader = TARGET_ELF[architecture]","+    for path in sorted(root.rglob(\"*\")):","+        if path.is_symlink():","+            try:","+                target = path.resolve(strict=True)","+            except (OSError, RuntimeError) as exc:","+                raise ValueError(f\"Sysroot has a dangling or cyclic link: {path}\") from exc","+            if not target.is_relative_to(root.resolve()):","+                raise ValueError(f\"Sysroot link escapes the archive: {path}\")","+    validated = []","+    for header in (\"stdio.h\", \"linux/version.h\", \"asm/unistd.h\", \"sys/sdt.h\", \"crypt.h\"):","+        path = root / \"usr/include\" / header","+        if not path.is_file():","+            raise ValueError(f\"Toolchain sysroot is missing usr/include/{header}\")","+        validated.append(path.relative_to(root).as_posix())","+    elf_files = (\"crt1.o\", \"crti.o\", \"crtn.o\", \"libc.so.6\", \"libgcc_s.so.1\", \"libcrypt.so\", loader)","+    for name in (*elf_files, \"libc.so\", \"libc_nonshared.a\"):","+        # These RHEL targets are all 64-bit. A copy in usr/lib or an unrelated","+        # subdirectory cannot replace GCC's required usr/lib64 linker inputs.","+        required = root / \"usr/lib64\" / name","+        if not required.is_file():","+            raise ValueError(f\"Toolchain sysroot is missing usr/lib64/{name}\")","+        paths = [required, root / \"lib64\" / name]","+        if name == loader:","+            # RHEL also exposes some 64-bit loaders through /lib and /usr/lib.","+            paths.extend([root / \"usr/lib\" / name, root / \"lib\" / name])","+        for path in paths:","+            if not path.is_file():","+                continue","+            if name in elf_files:","+                with path.open(\"rb\") as source:","+                    header = source.read(20)","+                byteorder = \"little\" if encoding == 1 else \"big\"","+                if (","+                    len(header) < 20","+                    or header[:5] != b\"\\x7fELF\\x02\"","+                    or header[5] != encoding","+                    or int.from_bytes(header[18:20], byteorder) != machine","+                ):","+                    raise ValueError(f\"Wrong ELF architecture for {architecture}: {path}\")","+            validated.append(path.relative_to(root).as_posix())","+    return sorted(validated)","+","+","+def sysroot_provenance(","+    image: str, distro: str, build_platform: str, image_identity: str","+) -> dict[str, Any]:","+    \"\"\"Read target package versions from the exact image being exported.\"\"\"","+    query = (","+        [\"dpkg-query\", \"-W\", \"-f=${Package}=${Version}:${Architecture}\\n\"]","+        if distro.startswith((\"ubuntu\", \"debian\"))","+        else [\"rpm\", \"-qa\", \"--qf\", \"%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\\n\"]","+    )","+    result = log_subprocess_run(","+        [\"docker\", \"run\", \"--rm\", \"--platform\", build_platform, image, *query],","+        capture_output=True,","+        text=True,","+        check=True,","+    )","+    packages = sorted(set(result.stdout.splitlines()))","+    if not packages:","+        raise ValueError(f\"No target package inventory returned for {image}\")","+    return {","+        \"schema-version\": 1,","+        \"distro\": distro,","+        \"architecture\": build_platform.split(\"/\")[1],","+        \"image\": image_identity,","+        \"packages\": packages,","+    }"," "," "," def _is_sysroot_path(path: str) -> bool:","-    return any(path == root or path.startswith(root + \"/\") for root in SYSROOT_PATHS)","+    # Debugger lookup indexes can reference executables omitted from this archive.","+    return any(path == root or path.startswith(root + \"/\") for root in SYSROOT_PATHS) and not any(","+        path == root or path.startswith(root + \"/\") for root in SYSROOT_EXCLUDED_PATHS","+    )"," "," ","-def create_sysroot_archive(rootfs: pathlib.Path, archive: pathlib.Path) -> str:","+def create_sysroot_archive(","+    rootfs: pathlib.Path, archive: pathlib.Path, *, provenance: dict[str, Any] | None = None","+) -> str:","     \"\"\"Package headers/libraries with portable links and return the archive's SHA-256.\"\"\""," ","+    def link_target(name: str, link: str) -> str:","+        return posixpath.normpath(","+            link if link.startswith(\"/\") else posixpath.join(posixpath.dirname(name), link)","+        ).lstrip(\"/\")","+","     def extract_filter(member: tarfile.TarInfo, destination: str) -> tarfile.TarInfo | None:","         name = posixpath.normpath(member.name.removeprefix(\"./\"))","         if not _is_sysroot_path(name):","             return None","         member = member.replace(name=name)","         if member.issym():","-            target = posixpath.normpath(","-                member.linkname","-                if member.linkname.startswith(\"/\")","-                else posixpath.join(posixpath.dirname(name), member.linkname)","-            ).lstrip(\"/\")","-            if not _is_sysroot_path(target):","-                return None","+            target = link_target(name, member.linkname)","+            visited = set()","+            while not _is_sysroot_path(target):","+                # Preserve library selections routed through /etc/alternatives without","+                # including system configuration in the compiler's sysroot.","+                selected = exported_members.get(target)","+                if selected is None or not selected.issym():","+                    return None","+                if target in visited:","+                    raise ValueError(f\"Sysroot link has a cyclic external target: {name}\")","+                visited.add(target)","+                target = link_target(target, selected.linkname)","             member = member.replace(linkname=posixpath.relpath(target, posixpath.dirname(name)))","         elif member.islnk() and not _is_sysroot_path(member.linkname):","             raise ValueError(f\"Sysroot hard link points outside the archive: {name}\")","@@ -74,9 +174,23 @@ def archive_filter(member: tarfile.TarInfo) -> tarfile.TarInfo:","     with tempfile.TemporaryDirectory(dir=rootfs.parent) as temp_dir:","         sysroot = pathlib.Path(temp_dir)","         with tarfile.open(rootfs) as exported:","+            exported_members = {","+                posixpath.normpath(member.name.removeprefix(\"./\")): member","+                for member in exported.getmembers()","+            }","             exported.extractall(sysroot, filter=extract_filter)","         if not (sysroot / \"usr/include\").is_dir():","             raise ValueError(\"Extracted sysroot does not contain usr/include\")","+        if provenance is not None:","+            manifest = dict(provenance)","+            manifest[\"validated-files\"] = (","+                validate_toolchain_sysroot(sysroot, provenance[\"architecture\"])","+                if provenance[\"distro\"] in TOOLCHAIN_SYSROOT_DISTROS","+                else []","+            )","+            manifest_path = sysroot / \"sysroot-manifest.json\"","+            manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + \"\\n\")","+            manifest_path.chmod(0o644)","         with (","             archive.open(\"wb\") as output,","             gzip.GzipFile(filename=\"\", fileobj=output, mode=\"wb\", mtime=0) as compressed,"],"additions":124,"deletions":10,"truncated":false},{"path":"bazel/platforms/remote_execution_containers_generator_test.py","lines":["@@ -141,6 +141,278 @@ def test_hard_linked_headers_are_preserved(self) -> None:","                 packaged.extractall(directory / \"extracted\", filter=\"data\")","             self.assertEqual(b\"header\", (directory / \"extracted/usr/include/linked.h\").read_bytes())"," ","+    def test_library_links_through_system_alternatives_are_resolved(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\")","+            with tarfile.open(root / \"rootfs.tar\", \"a\") as archive:","+                for name, target in (","+                    (\"usr/lib64/selected.so\", \"/etc/alternatives/selected.so\"),","+                    (\"etc/alternatives/selected.so\", \"/usr/lib64/libc.so\"),","+                ):","+                    member = tarfile.TarInfo(name)","+                    member.type, member.linkname = tarfile.SYMTYPE, target","+                    archive.addfile(member)","+            generator.create_sysroot_archive(root / \"rootfs.tar\", root / \"sysroot.tar.gz\")","+            with tarfile.open(root / \"sysroot.tar.gz\") as archive:","+                archive.extractall(root / \"extracted\", filter=\"data\")","+            self.assertEqual(b\"library\", (root / \"extracted/usr/lib64/selected.so\").read_bytes())","+            self.assertFalse((root / \"extracted/etc\").exists())","+","+    def test_cyclic_system_alternatives_are_rejected(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\")","+            with tarfile.open(root / \"rootfs.tar\", \"a\") as archive:","+                for name, target in (","+                    (\"usr/lib64/selected.so\", \"/etc/alternatives/one\"),","+                    (\"etc/alternatives/one\", \"two\"),","+                    (\"etc/alternatives/two\", \"one\"),","+                ):","+                    member = tarfile.TarInfo(name)","+                    member.type, member.linkname = tarfile.SYMTYPE, target","+                    archive.addfile(member)","+            with self.assertRaisesRegex(ValueError, \"cyclic external\"):","+                generator.create_sysroot_archive(root / \"rootfs.tar\", root / \"sysroot.tar.gz\")","+","+","+class ToolchainSysrootArchiveTest(unittest.TestCase):","+    @staticmethod","+    def _rootfs(path: pathlib.Path, architecture: str, *, omitted: str = \"\") -> None:","+        machine, byteorder, loader = {","+            \"amd64\": (62, \"little\", \"ld-linux-x86-64.so.2\"),","+            \"arm64\": (183, \"little\", \"ld-linux-aarch64.so.1\"),","+            \"ppc64le\": (21, \"little\", \"ld64.so.2\"),","+            \"s390x\": (22, \"big\", \"ld64.so.1\"),","+        }[architecture]","+        elf = bytearray(64)","+        elf[:6] = b\"\\x7fELF\\x02\" + bytes([1 if byteorder == \"little\" else 2])","+        elf[18:20] = machine.to_bytes(2, byteorder)","+        with tarfile.open(path, \"w\") as archive:","+            files = {","+                **{","+                    f\"usr/include/{name}\": b\"header\"","+                    for name in (","+                        \"stdio.h\",","+                        \"linux/version.h\",","+                        \"asm/unistd.h\",","+                        \"sys/sdt.h\",","+                        \"crypt.h\",","+                    )","+                },","+                **{","+                    f\"usr/lib64/{name}\": bytes(elf)","+                    for name in (","+                        \"crt1.o\",","+                        \"crti.o\",","+                        \"crtn.o\",","+                        \"libc.so.6\",","+                        \"libgcc_s.so.1\",","+                        \"libcrypt.so\",","+                        loader,","+                    )","+                },","+                \"usr/lib64/libc.so\": b\"GROUP ( libc.so.6 libc_nonshared.a )\",","+                \"usr/lib64/libc_nonshared.a\": b\"!<arch>\\n\",","+            }","+            for name, data in files.items():","+                if name == omitted:","+                    continue","+                member = tarfile.TarInfo(name)","+                member.size = len(data)","+                archive.addfile(member, io.BytesIO(data))","+","+    @staticmethod","+    def _provenance(architecture: str = \"s390x\") -> dict:","+        return {","+            \"schema-version\": 1,","+            \"distro\": \"rhel8\",","+            \"architecture\": architecture,","+            \"image\": \"repo@sha256:target\",","+            \"packages\": [\"glibc-2.28.s390x\", \"systemtap-sdt-devel.s390x\"],","+        }","+","+    def test_shared_archive_records_provenance_and_validates_each_target(self) -> None:","+        for architecture in (\"amd64\", \"arm64\", \"ppc64le\", \"s390x\"):","+            with self.subTest(architecture=architecture), tempfile.TemporaryDirectory() as tmp:","+                root = pathlib.Path(tmp)","+                rootfs, archive = root / \"rootfs.tar\", root / \"sysroot.tar.gz\"","+                self._rootfs(rootfs, architecture)","+                generator.create_sysroot_archive(","+                    rootfs, archive, provenance=self._provenance(architecture)","+                )","+                with tarfile.open(archive) as packaged:","+                    manifest = json.load(packaged.extractfile(\"sysroot-manifest.json\"))","+                    self.assertEqual(architecture, manifest[\"architecture\"])","+                    self.assertEqual(\"repo@sha256:target\", manifest[\"image\"])","+                    self.assertIn(\"systemtap-sdt-devel.s390x\", manifest[\"packages\"])","+                    self.assertIn(\"usr/include/sys/sdt.h\", manifest[\"validated-files\"])","+","+    def test_missing_exception_probe_header_prevents_publication(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\", omitted=\"usr/include/sys/sdt.h\")","+            with self.assertRaisesRegex(ValueError, \"sys/sdt.h\"):","+                generator.create_sysroot_archive(","+                    root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+                )","+            self.assertFalse((root / \"sysroot.tar.gz\").exists())","+","+    def test_wrong_architecture_is_rejected_before_archiving(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"arm64\")","+            with self.assertRaisesRegex(ValueError, \"ELF architecture\"):","+                generator.create_sysroot_archive(","+                    root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+                )","+","+    def test_incomplete_crt_is_rejected(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\", omitted=\"usr/lib64/crti.o\")","+            with self.assertRaisesRegex(ValueError, \"crti.o\"):","+                generator.create_sysroot_archive(","+                    root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+                )","+","+    def test_misplaced_runtime_file_cannot_replace_required_library_path(self) -> None:","+        for name in (\"crti.o\", \"libc.so\", \"libc_nonshared.a\", \"ld64.so.1\"):","+            with self.subTest(name=name), tempfile.TemporaryDirectory() as tmp:","+                root = pathlib.Path(tmp)","+                self._rootfs(root / \"rootfs.tar\", \"s390x\")","+                with tarfile.open(root / \"rootfs.tar\") as exported:","+                    exported.extractall(root / \"sysroot\", filter=\"data\")","+                required = root / \"sysroot/usr/lib64\" / name","+                misplaced = root / \"sysroot/usr/lib/unrelated\" / name","+                misplaced.parent.mkdir(parents=True, exist_ok=True)","+                required.rename(misplaced)","+                with self.assertRaisesRegex(ValueError, f\"usr/lib64/{name}\"):","+                    generator.validate_toolchain_sysroot(root / \"sysroot\", \"s390x\")","+","+    def test_valid_duplicate_cannot_mask_wrong_architecture_at_required_path(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\")","+            with tarfile.open(root / \"rootfs.tar\") as exported:","+                data = exported.extractfile(\"usr/lib64/libc.so.6\").read()","+            with tarfile.open(root / \"rootfs.tar\", \"a\") as exported:","+                decoy = tarfile.TarInfo(\"usr/lib/libc.so.6\")","+                decoy.size = len(data)","+                exported.addfile(decoy, io.BytesIO(data))","+                wrong = bytearray(data)","+                wrong[18:20] = (62).to_bytes(2, \"big\")","+                required = tarfile.TarInfo(\"usr/lib64/libc.so.6\")","+                required.size = len(wrong)","+                exported.addfile(required, io.BytesIO(wrong))","+            with self.assertRaisesRegex(ValueError, \"ELF architecture.*usr/lib64/libc.so.6\"):","+                generator.create_sysroot_archive(","+                    root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+                )","+            self.assertFalse((root / \"sysroot.tar.gz\").exists())","+","+    def test_unrelated_32_bit_library_copy_does_not_replace_64_bit_validation(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\")","+            with tarfile.open(root / \"rootfs.tar\", \"a\") as exported:","+                data = b\"\\x7fELF\\x01\" + bytes(59)","+                member = tarfile.TarInfo(\"usr/lib/libc.so.6\")","+                member.size = len(data)","+                exported.addfile(member, io.BytesIO(data))","+            generator.create_sysroot_archive(","+                root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+            )","+            with tarfile.open(root / \"sysroot.tar.gz\") as packaged:","+                manifest = json.load(packaged.extractfile(\"sysroot-manifest.json\"))","+                self.assertIn(\"usr/lib64/libc.so.6\", manifest[\"validated-files\"])","+                self.assertNotIn(\"usr/lib/libc.so.6\", manifest[\"validated-files\"])","+","+    def test_runtime_directory_aliases_and_loader_links_are_validated(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\")","+            with tarfile.open(root / \"rootfs.tar\", \"a\") as exported:","+                for name, target in (","+                    (\"lib\", \"usr/lib\"),","+                    (\"lib64\", \"usr/lib64\"),","+                    (\"usr/lib/ld64.so.1\", \"../lib64/ld64.so.1\"),","+                ):","+                    member = tarfile.TarInfo(name)","+                    member.type, member.linkname = tarfile.SYMTYPE, target","+                    exported.addfile(member)","+            generator.create_sysroot_archive(","+                root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+            )","+            with tarfile.open(root / \"sysroot.tar.gz\") as packaged:","+                manifest = json.load(packaged.extractfile(\"sysroot-manifest.json\"))","+                self.assertIn(\"usr/lib64/libc.so.6\", manifest[\"validated-files\"])","+                self.assertIn(\"usr/lib/ld64.so.1\", manifest[\"validated-files\"])","+","+    def test_wrong_architecture_runtime_alias_is_rejected(self) -> None:","+        for name in (\"lib64/libc.so.6\", \"usr/lib/ld64.so.1\"):","+            with self.subTest(name=name), tempfile.TemporaryDirectory() as tmp:","+                root = pathlib.Path(tmp)","+                self._rootfs(root / \"rootfs.tar\", \"s390x\")","+                with tarfile.open(root / \"rootfs.tar\") as exported:","+                    data = bytearray(exported.extractfile(\"usr/lib64/libc.so.6\").read())","+                data[18:20] = (62).to_bytes(2, \"big\")","+                with tarfile.open(root / \"rootfs.tar\", \"a\") as exported:","+                    member = tarfile.TarInfo(name)","+                    member.size = len(data)","+                    exported.addfile(member, io.BytesIO(data))","+                with self.assertRaisesRegex(ValueError, f\"ELF architecture.*{name}\"):","+                    generator.create_sysroot_archive(","+                        root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+                    )","+","+    def test_dangling_library_link_is_rejected(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\")","+            with tarfile.open(root / \"rootfs.tar\", \"a\") as archive:","+                member = tarfile.TarInfo(\"usr/lib64/broken.so\")","+                member.type, member.linkname = tarfile.SYMTYPE, \"missing.so\"","+                archive.addfile(member)","+            with self.assertRaisesRegex(ValueError, \"dangling\"):","+                generator.create_sysroot_archive(","+                    root / \"rootfs.tar\", root / \"sysroot.tar.gz\", provenance=self._provenance()","+                )","+","+    def test_build_id_indexes_for_excluded_executables_are_omitted(self) -> None:","+        with tempfile.TemporaryDirectory() as tmp:","+            root = pathlib.Path(tmp)","+            self._rootfs(root / \"rootfs.tar\", \"s390x\")","+            with tarfile.open(root / \"r