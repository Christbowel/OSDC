{"id":"6dd11f61f54595935746f9e0814c16844fc6d31b","axis":"silent","repo":"evilmartians/lefthook","sha":"6dd11f61f54595935746f9e0814c16844fc6d31b","parsed":{"files":[{"path":".github/workflows/release.yml","lines":["@@ -255,3 +255,24 @@ jobs:"," ","             bash packaging/scripts/publish aur-bin","           '","+","+  publish-php:","+    needs: build","+    runs-on: ubuntu-latest","+    steps:","+      - uses: actions/checkout@v6","+        with:","+          fetch-depth: 0","+","+      - name: Update PHP package","+        run: |","+          mkdir -p ~/.ssh","+          echo \"${{ secrets.LEFTHOOK_PHP_SSH_KEY }}\" > ~/.ssh/lefthook_php","+          chmod 600 ~/.ssh/lefthook_php","+          echo \"Host github.com\" >> ~/.ssh/config","+          echo \"  IdentityFile ~/.ssh/lefthook_php\" >> ~/.ssh/config","+          echo \"  IdentitiesOnly yes\" >> ~/.ssh/config","+          echo \"  User git\" >> ~/.ssh/config","+          ssh-keyscan github.com >> ~/.ssh/known_hosts","+","+          bash packaging/scripts/publish php"],"additions":21,"deletions":0,"truncated":false},{"path":"docmd.config.js","lines":["@@ -87,6 +87,10 @@ module.exports = {","           title: \"Python\",","           path: \"/installation/python\"","         },","+        {","+          title: \"PHP\",","+          path: \"/installation/php\"","+        },","         {","           title: \"Swift\",","           path: \"/installation/swift\""],"additions":4,"deletions":0,"truncated":false},{"path":"docs/installation/php.md","lines":["@@ -0,0 +1,21 @@","+# PHP","+","+1. Add the package as a dependency","+","+```sh","+composer require --dev evilmartians/lefthook","+```","+","+2. Check that it works","+","+```sh","+vendor/bin/lefthook version","+```","+","+3. Install the Git hooks","+","+```sh","+vendor/bin/lefthook install","+```","+","+After that lefthook should automatically find its path via `composer exec` on Git hooks."],"additions":21,"deletions":0,"truncated":false},{"path":"internal/templates/hook.tmpl","lines":["@@ -89,6 +89,9 @@ call_lefthook()","     elif uv run lefthook -h >/dev/null 2>&1","     then","       uv run lefthook \"$@\"","+    elif composer exec lefthook -- -h >/dev/null 2>&1","+    then","+      composer exec lefthook -- \"$@\"","     elif mise exec -- lefthook -h >/dev/null 2>&1","     then","       mise exec -- lefthook \"$@\""],"additions":3,"deletions":0,"truncated":false},{"path":"packaging/registries/php/bin/lefthook","lines":["@@ -0,0 +1,55 @@","+#!/usr/bin/env php","+<?php","+","+const LEFTHOOK_VERSION = '2.2.0';","+","+$os = match (PHP_OS_FAMILY) {","+    'Linux'   => 'Linux',","+    'Darwin'  => 'MacOS',","+    'Windows' => 'Windows',","+    'BSD'     => 'Freebsd',","+    default   => fail('Unsupported OS: ' . PHP_OS_FAMILY),","+};","+","+$arch = match (strtolower(php_uname('m'))) {","+    'x86_64', 'amd64'  => 'x86_64',","+    'arm64', 'aarch64' => 'arm64',","+    'i386', 'i686'     => 'i386',","+    default            => fail('Unsupported arch: ' . php_uname('m')),","+};","+","+$ext   = $os === 'Windows' ? '.exe' : '';","+$asset = sprintf('lefthook_%s_%s_%s%s', LEFTHOOK_VERSION, $os, $arch, $ext);","+$dir   = dirname(__DIR__) . '/.bin/' . LEFTHOOK_VERSION;","+$bin   = \"$dir/lefthook$ext\";","+","+if (!is_file($bin)) {","+    $base = 'https://github.com/evilmartians/lefthook/releases/download/v' . LEFTHOOK_VERSION;","+    @mkdir($dir, 0755, true);","+","+    $data = @file_get_contents(\"$base/$asset\");","+    if ($data === false) fail(\"Download failed: $base/$asset\");","+","+    $sums = @file_get_contents(\"$base/lefthook_checksums.txt\");","+    if ($sums === false || !str_contains($sums, hash('sha256', $data) . '  ' . $asset)) {","+        fail('Checksum mismatch for ' . $asset);","+    }","+","+    $tmp = \"$bin.tmp\" . getmypid();","+    file_put_contents($tmp, $data);","+    chmod($tmp, 0755);","+    rename($tmp, $bin);","+}","+","+$proc = proc_open(","+    array_merge([$bin], array_slice($argv, 1)),","+    [STDIN, STDOUT, STDERR],","+    $pipes","+);","+exit(proc_close($proc));","+","+function fail(string $msg): never {","+    fwrite(STDERR, \"lefthook: $msg\\n\");","+    exit(1);","+}","+"],"additions":55,"deletions":0,"truncated":false},{"path":"packaging/registries/php/composer.json","lines":["@@ -0,0 +1,37 @@","+{","+    \"$schema\": \"https://getcomposer.org/schema.json\",","+    \"name\": \"evilmartians/lefthook\",","+    \"description\": \"Lefthook Git hooks manager, installable via Composer.\",","+    \"type\": \"library\",","+    \"keywords\": [","+        \"git\",","+        \"hook\",","+        \"hooks\",","+        \"manager\",","+        \"lefthook\"","+    ],","+    \"homepage\": \"https://lefthook.dev\",","+    \"license\": \"MIT\",","+    \"authors\": [","+        {","+            \"name\": \"Evil Martians\",","+            \"email\": \"lefthook@evilmartians.com\"","+        },","+        {","+            \"name\": \"Louis Midson LAJEANTY\",","+            \"email\": \"midsonlajeanty@proton.me\"","+        }","+    ],","+    \"support\": {","+        \"issues\": \"https://github.com/evilmartians/lefthook/issues\",","+        \"source\": \"https://github.com/evilmartians/lefthook\"","+    },","+    \"require\": {","+        \"php\": \">=7.4\",","+        \"ext-zlib\": \"*\"","+    },","+    \"bin\": [","+        \"bin/lefthook\"","+    ]","+}","+"],"additions":37,"deletions":0,"truncated":false},{"path":"packaging/scripts/lib/php.sh","lines":["@@ -0,0 +1,36 @@","+#! /usr/bin/env bash","+","+[[ -n \"${_PHP_SH:-}\" ]] && return","+_PHP_SH=1","+","+lib=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)","+source \"$lib/globals.sh\"","+source \"$lib/utils.sh\"","+","+set_version_php() {","+  local php_dir=\"$REGISTRIES_ROOT/php\"","+","+  replace \"$php_dir/bin/lefthook\" \\","+    'LEFTHOOK_VERSION\\s*=\\s*.*;$' \\","+    \"LEFTHOOK_VERSION = '${VERSION}';\"","+}","+","+publish_php() {","+  local php_dir=\"$REGISTRIES_ROOT/php\"","+  git clone git@github.com:evilmartians/lefthook-php.git lefthook-php","+","+  copy \"$php_dir/composer.json\" lefthook-php/composer.json","+  copy \"$php_dir/bin/lefthook\" lefthook-php/bin/lefthook","+","+  pushd lefthook-php","+","+  git config user.name \"github-actions[bot]\"","+  git config user.email \"github-actions[bot]@users.noreply.github.com\"","+","+  git add composer.json bin/lefthook","+  git commit -m \"${VERSION}: automated bump\"","+  git tag \"v${VERSION}\" -m \"${VERSION}: automated bump\"","+  git push origin main --follow-tags","+","+  popd","+}"],"additions":36,"deletions":0,"truncated":false},{"path":"packaging/scripts/publish","lines":["@@ -24,6 +24,10 @@ case $1 in","     source \"$lib/aur_bin.sh\"","     publish_aur_bin","     ;;","+  php)","+    source \"$lib/php.sh\"","+    publish_php","+    ;;","   *)","     echo \"unknown target: $1\"","     exit 1"],"additions":4,"deletions":0,"truncated":false},{"path":"packaging/scripts/set-version","lines":["@@ -8,9 +8,11 @@ source \"$lib/rubygem.sh\""," source \"$lib/pypi.sh\""," source \"$lib/aur.sh\""," source \"$lib/aur_bin.sh\"","+source \"$lib/php.sh\""," "," set_version_npm"," set_version_rubygem"," set_version_pypi"," set_version_aur"," set_version_aur_bin","+set_version_php",""],"additions":2,"deletions":0,"truncated":false}],"additions":183,"deletions":0,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-08T16:20:45.509998+00:00"}