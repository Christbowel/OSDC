lgorithms')]","+    #[Test]","+    public function tokenWithTruncatedTagIsRejected(string $alg, string $enc, int $keySize): void","+    {","+        $key = $this->createKey($keySize);","+        $decrypter = $this->getJWEDecrypterFactory()","+            ->create([$alg, $enc]);","+        $token = $this->createToken($alg, $enc, $key);","+        $parts = explode('.', $token);","+        $tag = Base64UrlSafe::decodeNoPadding($parts[4]);","+","+        static::assertTrue($this->decrypt($decrypter, $token, $key));","+        for ($length = 0; $length < 16; ++$length) {","+            $parts[4] = Base64UrlSafe::encodeUnpadded(mb_substr($tag, 0, $length, '8bit'));","+            static::assertFalse($this->decrypt($decrypter, implode('.', $parts), $key));","+        }","+    }","+","+    #[DataProvider('dataAlgorithms')]","+    #[Test]","+    public function tamperedTokenCannotBeForgedWithAOneByteTag(string $alg, string $enc, int $keySize): void","+    {","+        $key = $this->createKey($keySize);","+        $decrypter = $this->getJWEDecrypterFactory()","+            ->create([$alg, $enc]);","+        $parts = explode('.', $this->createToken($alg, $enc, $key));","+        $ciphertext = Base64UrlSafe::decodeNoPadding($parts[3]);","+        $parts[3] = Base64UrlSafe::encodeUnpadded(substr_replace($ciphertext, $ciphertext[0] ^ \"\\x01\", 0, 1));","+","+        $accepted = 0;","+        for ($byte = 0; $byte < 256; ++$byte) {","+            $parts[4] = Base64UrlSafe::encodeUnpadded(chr($byte));","+            if ($this->decrypt($decrypter, implode('.', $parts), $key)) {","+                ++$accepted;","+            }","+        }","+","+        static::assertSame(0, $accepted);","+    }","+","+    public static function dataAlgorithms(): iterable","+    {","+        yield 'dir, A128GCM' => ['dir', 'A128GCM', 16];","+        yield 'dir, A192GCM' => ['dir', 'A192GCM', 24];","+        yield 'dir, A256GCM' => ['dir', 'A256GCM', 32];","+        yield 'A256KW, A256GCM' => ['A256KW', 'A256GCM', 32];","+        yield 'A256GCMKW, A128GCM' => ['A256GCMKW', 'A128GCM', 32];","+    }","+","+    private function createKey(int $size): JWK","+    {","+        return new JWK([","+            'kty' => 'oct',","+            'k' => Base64UrlSafe::encodeUnpadded(random_bytes($size)),","+        ]);","+    }","+","+    private function createToken(string $alg, string $enc, JWK $key): string","+    {","+        $jwe = $this->getJWEBuilderFactory()","+            ->create([$alg, $enc])","+            ->create()","+            ->withPayload('{\"sub\":\"alice\",\"adm\":0}')","+            ->withSharedProtectedHeader([","+                'alg' => $alg,","+                'enc' => $enc,","+            ])","+            ->addRecipient($key)","+            ->build();","+","+        return $this->getJWESerializerManager()","+            ->serialize('jwe_compact', $jwe, 0);","+    }","+","+    private function decrypt(JWEDecrypter $decrypter, string $token, JWK $key): bool","+    {","+        $jwe = $this->getJWESerializerManager()","+            ->unserialize($token);","+","+        return $decrypter->decryptUsingKey($jwe, $key, 0);","+    }","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"tests/EncryptionAlgorithm/ContentEncryption/AESGCM/AESGCMContentEncryptionTest.php","lines":["@@ -8,8 +8,12 @@"," use Jose\\Component\\Encryption\\Algorithm\\ContentEncryption\\A128GCM;"," use Jose\\Component\\Encryption\\Algorithm\\ContentEncryption\\A192GCM;"," use Jose\\Component\\Encryption\\Algorithm\\ContentEncryption\\A256GCM;","+use Jose\\Component\\Encryption\\Algorithm\\ContentEncryption\\AESGCM;","+use PHPUnit\\Framework\\Attributes\\DataProvider;"," use PHPUnit\\Framework\\Attributes\\Test;"," use PHPUnit\\Framework\\TestCase;","+use RuntimeException;","+use function sprintf;"," use const STR_PAD_LEFT;"," "," /**","@@ -208,6 +212,36 @@ public function a256GCMDecryptTestVector(): void","         );","     }"," ","+    #[DataProvider('dataTruncatedTags')]","+    #[Test]","+    public function truncatedTagIsRejected(AESGCM $algorithm, int $length): void","+    {","+        $header = Base64UrlSafe::encodeUnpadded(json_encode([","+            'alg' => 'dir',","+            'enc' => $algorithm->name(),","+        ]));","+        $tag = null;","+        $cek = random_bytes($algorithm->getCEKSize() / 8);","+        $iv = random_bytes(96 / 8);","+        $cyphertext = $algorithm->encryptContent('Live long and Prosper.', $cek, $iv, null, $header, $tag);","+        static::assertIsString($tag);","+        $truncatedTag = mb_substr($tag, 0, $length, '8bit');","+","+        $this->expectException(RuntimeException::class);","+        $this->expectExceptionMessage('Unable to decrypt the content');","+","+        $algorithm->decryptContent($cyphertext, $cek, $iv, null, $header, $truncatedTag);","+    }","+","+    public static function dataTruncatedTags(): iterable","+    {","+        foreach ([new A128GCM(), new A192GCM(), new A256GCM()] as $algorithm) {","+            foreach ([0, 1, 4, 8, 12, 15] as $length) {","+                yield sprintf('%s, %d bytes', $algorithm->name(), $length) => [$algorithm, $length];","+            }","+        }","+    }","+","     private function convertArrayToBinString(array $data): string","     {","         foreach ($data as $key => $value) {"],"additions":34,"deletions":0,"truncated":false},{"path":"tests/EncryptionAlgorithm/KeyEncryption/AESGCMKW/AESGCMKWKeyEncryptionTest.php","lines":["@@ -10,8 +10,12 @@"," use Jose\\Component\\Encryption\\Algorithm\\KeyEncryption\\A128GCMKW;"," use Jose\\Component\\Encryption\\Algorithm\\KeyEncryption\\A192GCMKW;"," use Jose\\Component\\Encryption\\Algorithm\\KeyEncryption\\A256GCMKW;","+use Jose\\Component\\Encryption\\Algorithm\\KeyEncryption\\AESGCMKW;","+use PHPUnit\\Framework\\Attributes\\DataProvider;"," use PHPUnit\\Framework\\Attributes\\Test;"," use PHPUnit\\Framework\\TestCase;","+use RuntimeException;","+use function sprintf;"," "," /**","  *