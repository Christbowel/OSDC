t.get_long() {","+            options.push(format!(\"--{long}\"));","+        }","+        if let Some(aliases) = argument.get_visible_aliases() {","+            options.extend(","+                aliases","+                    .into_iter()","+                    .map(|alias| format!(\"--{alias}\")),","+            );","+        }","+    }","+}","+","+pub(super) fn attached_option_values(","+    context: &CompletionContext<'_>,","+    current_word: &str,","+) -> miette::Result<Option<Vec<String>>> {","+    let Some((option_prefix, argument, value_prefix)) =","+        attached_option_completion(context, current_word)","+    else {","+        return Ok(None);","+    };","+    let values = complete_argument_values(context, argument, value_prefix, ValueForm::Attached)?","+        .into_iter()","+        .map(|value| format!(\"{option_prefix}{value}\"))","+        .collect();","+    Ok(Some(values))","+}","+","+fn attached_option_completion<'a>(","+    context: &'a CompletionContext<'_>,","+    current_word: &'a str,","+) -> Option<(String, &'a Arg, &'a str)> {","+    if current_word.starts_with(\"--\") {","+        let (option, value_prefix) = current_word.split_once('=')?;","+        let argument = find_option_argument(context, option)?;","+        return argument_takes_value(argument)","+            .then(|| (format!(\"{option}=\"), argument, value_prefix));","+    }","+    let rest = current_word.strip_prefix('-')?;","+    for (offset, short) in rest.char_indices() {","+        let argument = find_short_option_argument(context, short)?;","+        if !argument_takes_separate_value(argument) {","+            continue;","+        }","+        let attached = &rest[offset + short.len_utf8()..];","+        if attached.is_empty() {","+            return None;","+        }","+        let option_end = 1 + offset + short.len_utf8();","+        let (prefix, value_prefix) = match attached.strip_prefix('=') {","+            Some(value_prefix) => (&current_word[..=option_end], value_prefix),","+            None => (&current_word[..option_end], attached),","+        };","+        return Some((prefix.to_string(), argument, value_prefix));","+    }","+    None","+}","+","+pub(super) fn complete_argument_values(","+    context: &CompletionContext<'_>,","+    argument: &Arg,","+    value_prefix: &str,","+    form: ValueForm,","+) -> miette::Result<Vec<String>> {","+    if matches!(argument.get_id().as_str(), \"filter\" | \"filter_prod\") {","+        return Ok(filter_by_prefix(packages::complete_packages(context)?, value_prefix));","+    }","+    let path_kind = match argument.get_value_hint() {","+        ValueHint::DirPath => Some(PathCompletionKind::Directories),","+        ValueHint::FilePath | ValueHint::AnyPath => Some(PathCompletionKind::FilesAndDirectories),","+        _ => None,","+    };","+    if let Some(kind) = path_kind {","+        let home_dir = pnpm_config::home_dir();","+        let base_dir = path_base_directory(context, argument, home_dir.as_deref())?;","+        let value_home_dir = match form {","+            ValueForm::Separate => home_dir.as_deref(),","+            ValueForm::Attached if argument.get_id() == \"store_dir\" => home_dir.as_deref(),","+            ValueForm::Attached => None,","+        };","+        return Ok(paths::complete_paths(&base_dir, value_home_dir, value_prefix, kind));","+    }","+    let mut values = filter_by_prefix(visible_possible_values(argument), value_prefix);","+    values.sort();","+    values.dedup();","+    Ok(values)","+}","+","+fn path_base_directory(","+    context: &CompletionContext<'_>,","+    argument: &Arg,","+    home_dir: Option<&Path>,","+) -> miette::Result<PathBuf> {","+    let cwd = env::current_dir().into_diagnostic()?;","+    if matches!(argument.get_id().as_str(), \"dir\" | \"env_file\" | \"npmrc_auth_file\")","+        || (context.command_name == Some(\"sbom\") && argument.get_id() == \"out\")","+    {","+        return Ok(cwd);","+    }","+    let selected = context.resolve_selected_directory(&cwd, home_dir)?;","+    let selected = if context.workspace_root {","+        match find_workspace_root_dir(&selected) {","+            Ok(root) => root,","+            Err(WorkspaceRootError::NotInWorkspace) => selected,","+            Err(error) => return Err(error.into()),","+        }","+    } else {","+        selected","+    };","+    if !context.ignore_workspace","+        && matches!(argument.get_id().as_str(), \"store_dir\" | \"patches_dir\")","+    {","+        return Ok(find_workspace_dir(&selected)?.unwrap_or(selected));","+    }","+    Ok(selected)","+}","+","+fn visible_possible_values(argument: &Arg) -> Vec<String> {","+    argument","+        .get_possible_values()","+        .into_iter()","+        .filter(|value| !value.is_hide_set())","+        .map(|value| value.get_name().to_string())","+        .collect()","+}","+","+pub(super) fn separate_value_option<'a>(","+    context: &CompletionContext<'a>,","+    word: &str,","+    next: Option<&str>,","+) -> Option<&'a Arg> {","+    if word.contains('=') {","+        return None;","+    }","+    find_option_argument(context, word)","+        .filter(|argument| {","+            argument_takes_separate_value(argument) && option_value_is_allowed(argument, next)","+        })","+}","+","+pub(super) fn option_value_is_allowed(argument: &Arg, next: Option<&str>) -> bool {","+    next.is_none_or(|value| {","+        !value.starts_with('-') || value == \"-\" || argument.is_allow_hyphen_values_set()","+    })","+}","+","+pub(super) fn find_option_argument<'a>(","+    context: &CompletionContext<'a>,","+    option: &str,","+) -> Option<&'a Arg> {","+    find_option_argument_in_command(context.command, option)","+        .or_else(|| find_option_argument_in_command(context.root, option))","+}","+","+pub(super) fn find_short_option_argument<'a>(","+    context: &CompletionContext<'a>,","+    short: char,","+) -> Option<&'a Arg> {","+    find_short_in_command(context.command, short)","+    