Duration)))"," \ts.Require().NoError(s.WaitJoinAPI(s.ControllerNode(0)))"," ","-\textClient, err := s.ExtensionsClient(s.ControllerNode(0))","-\ts.Require().NoError(err)","-","-\ts.Require().NoError(aptest.WaitForCRDByName(ctx, extClient, \"plans\"))","-\ts.Require().NoError(aptest.WaitForCRDByName(ctx, extClient, \"controlnodes\"))","-"," \t// Create a worker join token"," \tworkerJoinToken, err := s.GetJoinToken(\"worker\")"," \ts.Require().NoError(err)","@@ -53,110 +56,163 @@ func (s *kubeletCertRotateSuite) SetupTest() {"," \tfor idx := range s.WorkerCount {"," \t\ts.Require().NoError(s.WaitForNodeReady(s.WorkerNode(idx), client))"," \t}","-","-\t// Knowing that `kube-controller-manager` is issuing certificates that live for","-\t// only 3m, if we can successfully apply autopilot plans AFTER kubelet key/certs have changed, we should","-\t// be able to confidentially say that the transport cert rotation is fine.","-\tworkerSSH, err := s.SSH(s.Context(), s.WorkerNode(0))","-\ts.Require().NoError(err)","-\ts.T().Log(\"waiting to see kubelet rotating the client cert before triggering Plan creation\")","-\t_, err = workerSSH.ExecWithOutput(s.Context(), \"inotifywait --no-dereference /var/lib/kubelet/pki/kubelet-client-current.pem\")","-\ts.Require().NoError(err)","-\toutput, err := workerSSH.ExecWithOutput(s.Context(), \"k0s status -ojson\")","-\ts.Require().NoError(err)","-\tvar status map[string]any","-\ts.Require().NoError(json.Unmarshal([]byte(output), &status))","-\tsuccess, found, err := unstructured.NestedBool(status, \"WorkerToAPIConnectionStatus\", \"Success\")","-\ts.Require().NoError(err)","-\ts.Require().True(found)","-\ts.Require().True(success)","-\ts.TestApply()"," }"," ","-func (s *kubeletCertRotateSuite) applyPlan(id string) {","+func (s *kubeletCertRotateSuite) TestWorkerClientsSurviveRotation() {"," \tctx := s.Context()"," ","-\trestConfig, err := s.GetKubeConfig(s.ControllerNode(0))","+\t// Knowing that `kube-controller-manager` is issuing short-lived","+\t// certificates, if the worker clients can still talk to the API server","+\t// *after* the kubelet has rotated its key/cert *and* the initial","+\t// certificate has expired, we should be able to confidently say that the","+\t// transport cert rotation is fine. The status socket's worker connectivity","+\t// probe is used for this, as it shares the client factory, and hence the","+\t// cached client-go transport, with all the other worker-side clients.","+\tworkerSSH, err := s.SSH(ctx, s.WorkerNode(0))"," \ts.Require().NoError(err)"," ","-\t// Ensure that a plan and yaml do not exist (safely)","-\t_, err = s.RunCommandController(0, \"/usr/local/bin/k0s kubectl delete plan autopilot | true\")","-\ts.Require().NoError(err)","+\t// Probe once before the rotation, so that the status component's client","+\t// and its connection to the API server predate the rotation.","+\tsuccess, message := s.probeWorkerToAPIConnection(ctx, workerSSH)","+\ts.Require().Truef(success, \"Worker-to-API probe failed before the rotation: %s\", message)","+\ts.T().Log(\"Worker-to-API probe succeeded before the rotation\")","+","+\t// Rotation happens after 70-90% of the certificate lifetime.","+\t// https://github.com/kubernetes/kubernetes/blob/v1.37.0/staging/src/k8s.io/client-go/util/certificate/certificate_manager.go#L736","+\tinitial := s.readKubeletClientCert(ctx, workerSSH)","+\tearliestRotation := /* 70%: */ initial.NotBefore.Add(7 * lifetime / 10)","+\tlatestRotation := /*   90%: */ initial.NotBefore.Add(9 * lifetime / 10)","+","+\tdeadline := latestRotation.Add(30 * time.Second) // slack for the CSR round-trip","+\ts.T().Log(\"Waiting for the kubelet to rotate the initial client cert until\", deadline.Format(time.TimeOnly))","+","+\tvar rotated *x509.Certificate","+\tfor deadline := time.After(time.Until(deadline)); rotated == nil || rotated.SerialNumber.Cmp(initial.SerialNumber) == 0; {","+\t\tselect {","+\t\tcase <-time.After(5 * time.Second):","+\t\t\trotated = s.readKubeletClientCert(ctx, workerSSH)","+\t\tcase <-deadline:","+\t\t\ts.Require().Fail(\"Kubelet didn't rotate its client certificate in time\")","+\t\tcase <-ctx.Done():","+\t\t\ts.Require().Fail(\"Test interrupted\")","+\t\t}","+\t}"," ","-\tplanTemplate := `","-apiVersion: autopilot.k0sproject.io/v1beta2","-kind: Plan","-metadata:","-  name: autopilot","-spec:","-  id: ` + id + `","-  timestamp: now","-  commands:","-    - k0supdate:","-        version: v0.0.0","-        forceupdate: true","-        platforms:","-          linux-amd64:","-            url: http://localhost/dist/k0s","-          linux-arm64:","-            url: http://localhost/dist/k0s","-        targets:","-          controllers:","-            discovery:","-              static:","-                nodes:","-                  - controller0","-          workers:","-            discovery:","-              static:","-                nodes:","-                  - worker0","-`","-","-\t// Create the plan","-","-\t_, err = common.Create(ctx, restConfig, []byte(planTemplate))","+\tissuedAt := rotated.NotBefore.Add(notBeforeBackdate)","+\ts.T().Log(\"Kubelet rotated its client cert at\", issuedAt.Format(time.TimeOnly))","+\ts.Require().Falsef(","+\t\tissuedAt.Before(earliestRotation),","+\t\t\"Kubelet rotated its client certificate too early: %s before %s\",","+\t\tissuedAt.Format(time.TimeOnly),","+\t\tearliestRotation.Format(time.TimeOnly))","+\ts.Require().Falsef(","+\t\tissuedAt.After(deadline),","+\t\t\"Kubelet rotated its client certificate too late: %s after %s\",","+\t\tissuedAt.Format(time.TimeOnly),","+\t\tdeadline.Format(time.TimeOnly))","+","+\t// The initial certificate stays valid for a while after the rotation, and","+\t// the API server verifies the client certificate on every request, not just","+\t// during the TLS handshake:","+\t// https://github.com/kubernetes/kubernetes/blob/v1.37.0/staging/src/k8s.io/apiserver/pkg/authentication/request/x509/x509.go#L194","+\t// A request over a connection that's still presenting the expired","+\t// certificate gets rejected, rather than being treated as anonymous:","+\t// https://github.com/kubernetes/kubernetes/blob/v1.37.0/pkg/kubeapiserver/authenticator/config.go#L245","+\t// So wait for the initial certificate to expire before probing again. A","+\t// successful probe then proves that the new certificate is in use.","+\tdeadline = initial.NotAfter.Add(1 * time.Second)","+\ts.T().Log(\"Waiting until\", deadline.Format(time.TimeOnly), \"for the initial client cert to expire\")","+\tselect {","+\tcase <-time.After(time.Until(deadline)):","+\tcase <-ctx.Done():","+\t\ts.Require().Fail(\"Test interrupted\")","+\t}","+","+\t// The worker clients rely on client-go to reload the certificate files, and","+\t// to close connections that have been established using the initial","+\t// certificate. It reloads the files during each TLS handshake ...","+\t// https://github.com/kubernetes/kubernetes/blob/v1.37.0/staging/src/k8s.io/client-go/transport/cache.go#L135","+\t// ... and on a timer (see CertCallbackRefreshDuration below). A new","+\t// handshake only happens if there's no usable connection in the pool, and","+\t// the connection is usually kept busy by other clients that share the","+\t// transport. The first probe after the expiry is hence expected to fail.","+\t// The API server then tears down the HTTP/2 connection along with the","+\t// rejected request:","+\t// https://github.com/kubernetes/kubernetes/blob/v1.37.0/staging/src/k8s.io/apiserver/pkg/endpoints/filters/authentication.go#L139","+\t// The next probe dials a new connection, and the handshake picks up the new","+\t// certificate. Should this not happen for whatever reason, the timer is the","+\t// fallback, so that's the upper bound for the recovery.","+\tdeadline = initial.NotAfter.Add(transport.CertCallbackRefreshDuration + 5*time.Second)","+\ts.T().Log(\"Waiting for the worker-to-API probe to succeed until\", deadline.Format(time.TimeOnly))","+\tfor failureSeen, deadline := false, time.After(time.Until(deadline)); ; {","+\t\tsuccess, message := s.probeWorkerToAPIConnection(ctx, workerSSH)","+\t\tif success {","+\t\t\tif failureSeen {","+\t\t\t\ts.T().Log(\"Worker-to-API probe succeeded\",","+\t\t\t\t\ttime.Since(initial.NotAfter).Round(time.Second),","+\t\t\t\t\t\"after the initial client cert expired\")","+\t\t\t\tbreak","+\t\t\t}","+\t\t\tif time.Since(initial.NotAfter) >= 10*time.Second {","+\t\t\t\ts.T().Log(\"Worker-to-API probe succeeded 10 seconds after the initial cert expired\")","+\t\t\t\tbreak","+\t\t\t}","+\t\t} else {","+\t\t\ts.Require().Equal(\"the server has asked for the client to provide credentials\", message)","+\t\t\tif !failureSeen {","+\t\t\t\ts.T().Log(\"Worker-to-API probe failed because the initial client cert expired\")","+\t\t\t\tfailureSeen = true","+\t\t\t}","+\t\t}","+","+\t\tselect {","+\t\tcase <-time.After(1 * time.Second):","+\t\tcase <-deadline:","+\t\t\ts.Require().Fail(\"Worker-to-API probe didn't recover in time after the initial client cert expired\")","+\t\tcase <-ctx.Done():","+\t\t\ts.Require().Fail(\"Test interrupted\")","+\t\t}","+\t}","+}","+","+// probeWorkerToAPIConnection queries the worker's status socket and returns","+// the outcome of its worker-to-API connection probe.","+func (s *kubeletCertRotateSuite) probeWorkerToAPIConnection(ctx context.Context, workerSSH *common.SSHConnection) (success bool, message string) {","+\toutput, err := workerSSH.ExecWithOutput(ctx, \"k0s status -ojson\")"," \ts.Require().NoError(err)","-\ts.T().Logf(\"Plan created\")","+\tvar status map[string]any","+\ts.Require().NoError(json.Unmarshal([]byte(output), &status))"," ","-\t// The plan has enough information to perform a successful update of k0s, so wait for it.","-\tclient, err := k0sclientset.NewForConfig(restConfig)","+\tsuccess, found, err := unstructured.NestedBool(status, \"WorkerToAPIConnectionStatus\", \"Success\")"," \ts.Require().NoError(err)","-\tplan, err := aptest