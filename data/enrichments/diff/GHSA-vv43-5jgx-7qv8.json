{"id":"GHSA-vv43-5jgx-7qv8","axis":"advisories","repo":"electron/electron","sha":"01faabfc250801a980fc94d64608046c67fc1cd9","parsed":{"files":[{"path":"patches/squirrel.mac/.patches","lines":["@@ -10,3 +10,4 @@ chore_turn_off_launchapplicationaturl_deprecation_errors_in_squirrel.patch"," fix_crash_when_process_to_extract_zip_cannot_be_launched.patch"," use_uttype_class_instead_of_deprecated_uttypeconformsto.patch"," fix_clean_up_orphaned_staged_updates_before_downloading_new_update.patch","+fix_resolve_target_bundle_path_once_at_start_of_install.patch"],"additions":1,"deletions":0,"truncated":false},{"path":"patches/squirrel.mac/fix_resolve_target_bundle_path_once_at_start_of_install.patch","lines":["@@ -0,0 +1,107 @@","+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","+From: Samuel Attard <sattard@anthropic.com>","+Date: Sat, 4 Apr 2026 11:21:37 -0700","+Subject: fix: resolve target bundle path once at start of install","+","+The target bundle URL is read from the serialized request on disk and was","+re-evaluated at multiple points in the install signal chain. Resolve it to","+a canonical path once up front, reject requests whose path is not already","+canonical, and thread the resolved URL through the rest of the chain so","+every step operates on the same location that validation saw.","+","+Also resolve the running application's bundle URL on the write side in","+SQRLUpdater so the serialized request always carries a canonical path.","+","+diff --git a/Squirrel/SQRLInstaller.m b/Squirrel/SQRLInstaller.m","+index 8969cfda03efd5a11bfe0c531e2702ff12a3f610..6a4e821c332db013dddd966b14f014cadfd6952d 100644","+--- a/Squirrel/SQRLInstaller.m","+@@ -9,6 +9,9 @@","+ #import \"SQRLInstaller.h\"","+ ","+ #import <libkern/OSAtomic.h>","++#import <mach-o/dyld.h>","++#import <sys/param.h>","++#import <unistd.h>","+ #import <ReactiveObjC/EXTScope.h>","+ #import <ReactiveObjC/NSEnumerator+RACSequenceAdditions.h>","+ #import <ReactiveObjC/NSObject+RACPropertySubscribing.h>","+@@ -307,6 +310,48 @@ - (RACSignal *)renameIfNeeded:(SQRLShipItRequest *)request updateBundleURL:(NSUR","+ - (RACSignal *)installRequest:(SQRLShipItRequest *)request {","+ \tNSParameterAssert(request != nil);","+ ","++\t// Resolve the target bundle path exactly once and use the canonical URL for","++\t// every step of the install chain. The request is read from disk, so the","++\t// path it carries is untrusted; every downstream step that re-resolves it","++\t// must see the same location that validation saw.","++\tNSURL *resolvedTargetURL = request.targetBundleURL.URLByResolvingSymlinksInPath.URLByStandardizingPath;","++\tif (![resolvedTargetURL.path isEqual:request.targetBundleURL.URLByStandardizingPath.path]) {","++\t\tNSDictionary *errorInfo = @{","++\t\t\tNSLocalizedDescriptionKey: NSLocalizedString(@\"Target bundle path is not canonical\", nil),","++\t\t\tNSLocalizedRecoverySuggestionErrorKey: NSLocalizedString(@\"The target bundle path must not traverse symbolic links.\", nil),","++\t\t};","++\t\treturn [RACSignal error:[NSError errorWithDomain:SQRLInstallerErrorDomain code:SQRLInstallerErrorInvalidState userInfo:errorInfo]];","++\t}","++\trequest = [[SQRLShipItRequest alloc] initWithUpdateBundleURL:request.updateBundleURL targetBundleURL:resolvedTargetURL bundleIdentifier:request.bundleIdentifier launchAfterInstallation:request.launchAfterInstallation useUpdateBundleName:request.useUpdateBundleName];","++","++\t// When running privileged, the target must be the app bundle that contains","++\t// this installer. This pins the install to a location whose ancestors the","++\t// user that wrote the request cannot modify.","++\tif (geteuid() == 0) {","++\t\tNSString *expectedTargetPath = nil;","++\t\tchar rawPath[PATH_MAX] = {0};","++\t\tchar canonicalPath[PATH_MAX] = {0};","++\t\tuint32_t rawPathSize = sizeof(rawPath);","++\t\tif (_NSGetExecutablePath(rawPath, &rawPathSize) == 0 && realpath(rawPath, canonicalPath) != NULL) {","++\t\t\tNSArray<NSString *> *components = @(canonicalPath).pathComponents;","++\t\t\tfor (NSInteger i = (NSInteger)components.count - 1; i >= 0; i--) {","++\t\t\t\tif ([components[(NSUInteger)i] hasSuffix:@\".app\"]) {","++\t\t\t\t\tNSURL *expectedURL = [NSURL fileURLWithPath:[NSString pathWithComponents:[components subarrayWithRange:NSMakeRange(0, (NSUInteger)i + 1)]]];","++\t\t\t\t\texpectedTargetPath = expectedURL.URLByStandardizingPath.path;","++\t\t\t\t\tbreak;","++\t\t\t\t}","++\t\t\t}","++\t\t}","++\t\tif (expectedTargetPath == nil || ![resolvedTargetURL.path isEqual:expectedTargetPath]) {","++\t\t\tNSLog(@\"Privileged install rejected: target %@ does not match installer bundle %@\", resolvedTargetURL.path, expectedTargetPath);","++\t\t\tNSDictionary *errorInfo = @{","++\t\t\t\tNSLocalizedDescriptionKey: NSLocalizedString(@\"Target bundle does not match installer location\", nil),","++\t\t\t\tNSLocalizedRecoverySuggestionErrorKey: NSLocalizedString(@\"When running with elevated privileges, the target bundle must be the application that contains this installer.\", nil),","++\t\t\t};","++\t\t\treturn [RACSignal error:[NSError errorWithDomain:SQRLInstallerErrorDomain code:SQRLInstallerErrorInvalidState userInfo:errorInfo]];","++\t\t}","++\t}","++","+ \treturn [[[[self","+ \t\tprepareAndValidateUpdateBundleURLForRequest:request]","+ \t\tflattenMap:^(NSURL *updateBundleURL) {","+diff --git a/Squirrel/SQRLUpdater.m b/Squirrel/SQRLUpdater.m","+index 41856e5754228d33982db72f97f2ff241615a357..f75042af341140643e864845a212d743b85ec188 100644","+--- a/Squirrel/SQRLUpdater.m","+@@ -340,7 +340,7 @@ - (id)initWithUpdateRequest:(NSURLRequest *)updateRequest requestForDownload:(SQ","+ \t\tdefer:^{","+ \t\t\t@strongify(self);","+ ","+-\t\t\tNSURL *targetURL = NSRunningApplication.currentApplication.bundleURL;","++\t\t\tNSURL *targetURL = NSRunningApplication.currentApplication.bundleURL.URLByResolvingSymlinksInPath;","+ ","+ \t\t\tBOOL targetWritable = [self canWriteToURL:targetURL];","+ \t\t\tBOOL parentWritable = [self canWriteToURL:targetURL.URLByDeletingLastPathComponent];","+@@ -843,12 +843,13 @@ - (RACSignal *)prepareUpdateForInstallation:(SQRLDownloadedUpdate *)update {","+ \treturn [[[[RACSignal","+ \t\tdefer:^{","+ \t\t\tNSRunningApplication *currentApplication = NSRunningApplication.currentApplication;","+-\t\t\tNSBundle *appBundle = [NSBundle bundleWithURL:currentApplication.bundleURL];","++\t\t\tNSURL *targetBundleURL = currentApplication.bundleURL.URLByResolvingSymlinksInPath;","++\t\t\tNSBundle *appBundle = [NSBundle bundleWithURL:targetBundleURL];","+ \t\t\t// Only use the update bundle's name if the user hasn't renamed the","+ \t\t\t// app themselves.","+-\t\t\tBOOL useUpdateBundleName = [appBundle.sqrl_executableName isEqual:currentApplication.bundleURL.lastPathComponent.stringByDeletingPathExtension];","++\t\t\tBOOL useUpdateBundleName = [appBundle.sqrl_executableName isEqual:targetBundleURL.lastPathComponent.stringByDeletingPathExtension];","+ ","+-\t\t\tSQRLShipItRequest *request = [[SQRLShipItRequest alloc] initWithUpdateBundleURL:update.bundle.bundleURL targetBundleURL:currentApplication.bundleURL bundleIdentifier:currentApplication.bundleIdentifier launchAfterInstallation:NO useUpdateBundleName:useUpdateBundleName];","++\t\t\tSQRLShipItRequest *request = [[SQRLShipItRequest alloc] initWithUpdateBundleURL:update.bundle.bundleURL targetBundleURL:targetBundleURL bundleIdentifier:currentApplication.bundleIdentifier launchAfterInstallation:NO useUpdateBundleName:useUpdateBundleName];","+ \t\t\treturn [request writeUsingURL:self.shipItStateURL];","+ \t\t}]","+ \t\tthen:^{",""],"additions":105,"deletions":0,"truncated":false}],"additions":106,"deletions":0,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-09-30T15:45:05.398333+00:00"}