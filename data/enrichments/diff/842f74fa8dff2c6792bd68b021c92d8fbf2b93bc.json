","+        reference = load(","+            VllmConfig(","+                model_config=model_config,","+                engram_config=EngramConfig(cpu_offload=False),","+            )","+        )","+        assert isinstance(embedding, Qwen4ExpPLEPoolEmbedding)","+        assert embedding.table is not None","+        assert embedding.weight.shape == (12, 32)","+        start = embedding.table.row_start","+        assert torch.equal(","+            embedding.weight.view(torch.uint8).to(reference.weight.device),","+            reference.weight[start : start + 12].view(torch.uint8),","+        )","+        ids = torch.tensor([[0, 11], [12, 23]], dtype=torch.long, device=\"cuda\")","+        embedding(ids)","+        graph = torch.cuda.CUDAGraph()","+        with torch.cuda.graph(graph):","+            output = embedding(ids)","+        for rows in ([[12, 12], [11, 0]], [[23, 11], [0, 12]]):","+            ids.copy_(torch.tensor(rows, device=\"cuda\"))","+            graph.replay()","+            expected = reference(ids)","+            assert torch.equal(output.view(torch.uint8), expected.view(torch.uint8))","+            torch.testing.assert_close(","+                embedding.dequantize(output, torch.bfloat16),","+                reference.dequantize(expected, torch.bfloat16),","+                atol=0,","+                rtol=0,","+            )","+        embedding.pool.group.barrier()","+    finally:","+        cleanup_dist_env_and_memory()","+","+","+@pytest.mark.skipif(","+    not current_platform.is_cuda() or torch.accelerator.device_count() < 2,","+    reason=\"requires two CUDA GPUs\",","+)","+@pytest.mark.parametrize(","+    \"transport,host\", [(\"nvlink\", False), (\"rdma\", False), (\"rdma\", True)]","+)","+def test_ple_pool_checkpoint_shards_and_cuda_graph(","+    tmp_path: Path, transport, host: bool","+) -> None:","+    if transport == \"nvlink\" and not imex_channel_available():","+        pytest.skip(\"requires CUDA FABRIC handles\")","+    if tra