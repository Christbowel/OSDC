eload(self) -> None:","+        raise RuntimeError(","+            \"Qwen4Exp Engram pool tables cannot reload weights; restart the group\"","+        )","+","+    def __init__(","+        self,","+        *args,","+        embedding_method: Qwen4ExpPLEEmbeddingMethod,","+        num_ngram_heads: int,","+        max_total_tokens: int,","+        **kwargs,","+    ) -> None:","+        if not isinstance(embedding_method, Qwen4ExpPLEFp8EmbeddingMethod):","+            raise ValueError(\"Qwen4Exp Engram pool requires an FP8 PLE table\")","+        self._max_items = max_total_tokens * num_ngram_heads","+        self.table: EngramTable | None = None","+        self._loaded_ranges: list[tuple[int, int]] = []","+        super().__init__(*args, embedding_method=embedding_method, **kwargs)","+        if self.table is not None:","+            start = self.table.row_start","+            end = start + self.table.shard.shape[0]","+            self.shard_indices.org_vocab_start_index = start","+            self.shard_indices.org_vocab_end_index = end","+            self.shard_indices.padded_org_vocab_start_index = start","+            self.shard_indices.padded_org_vocab_end_index = end","+            self.num_org_embeddings_per_partition = end - start","+            if get_current_vllm_config().load_config.load_format == \"dummy\":","+                self._loaded_ranges.append((start, end))","+","+    def allocate_embedding_weight(","+        self, num_embeddings: int, embedding_dim: int, dtype: torch.dtype","+    ) -> torch.Tensor:","+        if torch.get_default_device().type == \"meta\":","+            return torch.empty(num_embeddings, embedding_dim, dtype=dtype)","+        self.pool = get_engram_pool(self._max_items, embedding_dim)","+        self.table = self.pool.table(num_embeddings, embedding_dim, self.prefix)","+        return self.table.shard.view(dtype)","+","+    def process_weights_after_loading(self) -> None:","+        if self.table is None or self.weight.data_ptr(