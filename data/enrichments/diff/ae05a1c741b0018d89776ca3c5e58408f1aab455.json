{"id":"ae05a1c741b0018d89776ca3c5e58408f1aab455","axis":"silent","repo":"salvo-rs/salvo","sha":"ae05a1c741b0018d89776ca3c5e58408f1aab455","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -46,6 +46,9 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).","   exclude JWKs whose declared use or key operations do not permit verification."," - Make the default JWT header finder use the same methods and Authorization","   header as `HeaderFinder::new`, instead of silently rejecting every token.","+- Use only `Authorization` for Basic authentication by default, keeping proxy","+  credentials out of origin authentication. Applications that intentionally","+  accept `Proxy-Authorization` can opt in with `BasicAuth::set_header_names`."," "," - Exclude request query strings and client error URL contents from proxy failure","   logs while retaining the request method, path, and error type."],"additions":3,"deletions":0,"truncated":false},{"path":"crates/extra/src/basic_auth.rs","lines":["@@ -33,7 +33,7 @@"," use std::fmt::{self, Debug, Formatter};"," "," use base64::engine::{Engine, general_purpose};","-use salvo_core::http::header::{AUTHORIZATION, HeaderName, HeaderValue, PROXY_AUTHORIZATION};","+use salvo_core::http::header::{AUTHORIZATION, HeaderName, HeaderValue};"," use salvo_core::http::{Request, Response, StatusCode};"," use salvo_core::{Depot, Error, FlowCtrl, Handler, async_trait};"," ","@@ -66,7 +66,11 @@ impl BasicAuthDepotExt for Depot {","     }"," }"," ","-/// BasicAuth","+/// HTTP Basic authentication using the `Authorization` header by default.","+///","+/// Proxy credentials belong to a separate authentication scope. Applications","+/// that deliberately use `Proxy-Authorization` for origin authentication must","+/// opt in with [`BasicAuth::set_header_names`]."," pub struct BasicAuth<V: BasicAuthValidator> {","     realm: String,","     header_names: Vec<HeaderName>,","@@ -91,7 +95,7 @@ where","     pub fn new(validator: V) 