).contains_key(\"www-authenticate\"));","+    }","+","+    let mut res = TestClient::get(\"http://localhost/\")","+        .basic_auth(\"alice\", Some(\"origin-secret\"))","+        .send(&service)","+        .await;","+    assert_eq!(res.status_code, Some(StatusCode::OK));","+    assert_eq!(res.take_string().await.unwrap(), \"alice\");","+}","+","+#[tokio::test]","+async fn proxy_credentials_remain_available_with_explicit_configuration() {","+    let service = Service::new(","+        Router::new()","+            .hoop(BasicAuth::new(Validator).set_header_names([AUTHORIZATION, PROXY_AUTHORIZATION]))","+            .get(identity),","+    );","+    let mut res = TestClient::get(\"http://localhost/\")","+        .add_header(AUTHORIZATION, \"Bearer unrelated\", true)","+        .add_header(","+            PROXY_AUTHORIZATION,","+            \"Basic YWxpY2U6b3JpZ2luLXNlY3JldA==\",","+            true,","+        )","+        .send(&service)","+        .await;","+    assert_eq!(res.status_code, Some(StatusCode::OK));","+    assert_eq!(res.take_string().await.unwrap(), \"alice\");","+}",""],"additions":65,"deletions":0,"truncated":false}],"additions":76,"deletions":3,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-30T15:56:50.294550+00:00"}