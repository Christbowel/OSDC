ent.","+"," ## Use an ellipsis for actions that need more input"," "," Append an ellipsis (`…`) when activating an item opens another interface that requires more user input before the command can finish, such as a dialog."],"additions":18,"deletions":0,"truncated":false},{"path":"packages/ui/src/menu/style.module.css","lines":["@@ -46,9 +46,11 @@"," \t\t}"," "," \t\t.list {","+\t\t\t--_wp-ui-menu-item-label-line-height: var(--wpds-typography-line-height-sm);","+"," \t\t\tfont-family: var(--wpds-typography-font-family-body);"," \t\t\tfont-size: var(--wpds-typography-font-size-md);","-\t\t\tline-height: var(--wpds-typography-line-height-sm);","+\t\t\tline-height: var(--_wp-ui-menu-item-label-line-height);"," \t\t\tcolor: var(--wpds-color-foreground-interactive-neutral);"," \t\t}"," ","@@ -130,7 +132,8 @@"," \t\t\t\t[content-end] var(--wp-ui-menu-item-padding-inline)"," \t\t\t\t[item-padding-end];"," \t\t\tgap: 0;","-\t\t\talign-items: center;","+\t\t\t/* Keep every slot anchored to the label's first line. */","+\t\t\talign-items: start;"," \t\t\tjustify-content: stretch;"," \t\t\tmin-width: 0;"," \t\t\tmin-height: var(--wp-ui-menu-item-height);","@@ -187,13 +190,12 @@"," "," \t\t.item-selection-indicator {"," \t\t\tgrid-column: selection-start / selection-end;","-\t\t\talign-self: center;"," \t\t\tjustify-self: center;"," \t\t\tdisplay: flex;"," \t\t\talign-items: center;"," \t\t\tjustify-content: center;"," \t\t\twidth: var(--wp-ui-menu-selection-indicator-size);","-\t\t\theight: var(--wp-ui-menu-selection-indicator-size);","+\t\t\theight: var(--_wp-ui-menu-item-label-line-height);"," \t\t\tcolor: var(--wpds-color-foreground-content-neutral-weak);"," \t\t\tpointer-events: none;"," ","@@ -202,6 +204,11 @@"," \t\t\t}"," \t\t}"," ","+\t\t.checkbox-selection-icon {","+\t\t\t/* Optical alignment with the item label. */","+\t\t\ttranslate: 0 1px;","+\t\t}","+"," \t\t.radio-selection-icon {"," \t\t\twidth: var(--wpds-dimension-size-xs);"," \t\t\theight: var(--wpds-dimensio