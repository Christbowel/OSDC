","+        parameters = errorParameters(\"to_csv\"),","+        context = ExpectedContext(","+          fragment = \"\"\"to_csv(named_struct('a', 1, 'b', 2),","+            |  map('delimiter', delimiter))\"\"\".stripMargin,","+          start = 15,","+          stop = 81))","+    }","+","+    checkUnsafeOptions()","+    withSQLConf(SQLConf.LEGACY_ALLOW_NON_FOLDABLE_OPTIONS.key -> \"true\") {","+      evaluableNonFoldableOptions.foreach { option =>","+        checkAnswer(","+          df.selectExpr(s\"to_csv(a, map('delimiter', $option))\"),","+          Row(\"1|2\") :: Nil)","+      }","+      checkUnsafeOptions()","+    }","+  }","+","   test(\"parse timestamps with locale\") {","     Seq(\"en-US\", \"ko-KR\", \"zh-CN\", \"ru-RU\").foreach { langTag =>","       val locale = Locale.forLanguageTag(langTag)"],"additions":111,"deletions":0,"truncated":false},{"path":"sql/core/src/test/scala/org/apache/spark/sql/JsonFunctionsSuite.scala","lines":["@@ -1022,6 +1022,33 @@ class JsonFunctionsSuite extends SharedSparkSession {","         stop = 22","       )","     )","+","+  }","+","+  test(\"SPARK-59801: JSON functions with non-foldable options\") {","+    val df = Seq((Tuple1(1), \"\"\"{\"a\":1}\"\"\", \"true\")).toDF(\"a\", \"json\", \"option\")","+    val nonFoldableQueries = Seq(","+      \"from_json\" ->","+        \"from_json(json, 'a INT', map('primitivesAsString', option))\",","+      \"to_json\" -> \"to_json(a, map('pretty', option))\",","+      \"schema_of_json\" ->","+        \"\"\"schema_of_json('{\"a\":1}', map('primitivesAsString', option))\"\"\")","+","+    nonFoldableQueries.foreach { case (functionName, query) =>","+      checkError(","+        exception = intercept[AnalysisException] {","+          df.selectExpr(query)","+        },","+        condition = \"NON_FOLDABLE_ARGUMENT\",","+        parameters = Map(","+          \"funcName\" -> s\"`$functionName`\",","+          \"paramName\" -> \"`options`\",","+          \"paramType\" -> \"\\\"MAP<STRING, S