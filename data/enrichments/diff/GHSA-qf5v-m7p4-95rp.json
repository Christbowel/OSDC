","-\t\t\t\t\t\"%s.securityContext.capabilities.add[%q] is not allowed\", fieldPath, cap))","+\t\t\t\t\t\"%s.securityContext.capabilities.add[%q] is not in the allowlist (only NET_BIND_SERVICE may be added)\",","+\t\t\t\t\tfieldPath, cap))"," \t\t\t}"," \t\t}"," \t}"],"additions":17,"deletions":12,"truncated":false},{"path":"pkg/apis/core/v1/podspec_safety_test.go","lines":["@@ -5,10 +5,12 @@"," package v1"," "," import (","+\t\"reflect\""," \t\"strings\""," \t\"testing\""," "," \tapiv1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," )"," "," func TestValidatePodSpecSafety_Nil(t *testing.T) {","@@ -139,6 +141,82 @@ func TestValidatePodSpecSafety_DangerousFields(t *testing.T) {"," \t\t\t},"," \t\t\twantInErr: \"NET_ADMIN\","," \t\t},","+\t\t// GHSA-qf5v-m7p4-95rp regression coverage: the prior denylist omitted","+\t\t// these escape-class capabilities. The allowlist rejects all of them.","+\t\t{","+\t\t\tname: \"SYS_TIME capability (node clock corruption)\",","+\t\t\tmutate: func(ps *apiv1.PodSpec) {","+\t\t\t\tps.Containers = []apiv1.Container{{","+\t\t\t\t\tName: \"user\",","+\t\t\t\t\tSecurityContext: &apiv1.SecurityContext{","+\t\t\t\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"SYS_TIME\"}},","+\t\t\t\t\t},","+\t\t\t\t}}","+\t\t\t},","+\t\t\twantInErr: \"SYS_TIME\",","+\t\t},","+\t\t{","+\t\t\tname: \"SYS_RAWIO capability\",","+\t\t\tmutate: func(ps *apiv1.PodSpec) {","+\t\t\t\tps.Containers = []apiv1.Container{{","+\t\t\t\t\tName: \"user\",","+\t\t\t\t\tSecurityContext: &apiv1.SecurityContext{","+\t\t\t\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"SYS_RAWIO\"}},","+\t\t\t\t\t},","+\t\t\t\t}}","+\t\t\t},","+\t\t\twantInErr: \"SYS_RAWIO\",","+\t\t},","+\t\t{","+\t\t\tname: \"BPF capability\",","+\t\t\tmutate: func(ps *apiv1.PodSpec) {","+\t\t\t\tps.Containers = []apiv1.Container{{","+\t\t\t\t\tName: \"user\",","+\t\t\t\t\tSecurityContext: &apiv1.SecurityContext{","+\t\t\t\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"BPF\"}},","+\t\t\t\t\t},","+\t\t\t\t}}","+\t\t\t},","+\t\t\twantInErr: \"BPF\",","+\t\t},","+\t\t{","+\t\t\tname: \"SYS_RESOURCE capability\",","+\t\t\tmutate: func(ps *apiv1.PodSpec) {","+\t\t\t\tps.Containers = []apiv1.Container{{","+\t\t\t\t\tName: \"user\",","+\t\t\t\t\tSecurityContext: &apiv1.SecurityContext{","+\t\t\t\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"SYS_RESOURCE\"}},","+\t\t\t\t\t},","+\t\t\t\t}}","+\t\t\t},","+\t\t\twantInErr: \"SYS_RESOURCE\",","+\t\t},","+\t\t{","+\t\t\tname: \"MAC_ADMIN capability\",","+\t\t\tmutate: func(ps *apiv1.PodSpec) {","+\t\t\t\tps.Containers = []apiv1.Container{{","+\t\t\t\t\tName: \"user\",","+\t\t\t\t\tSecurityContext: &apiv1.SecurityContext{","+\t\t\t\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"MAC_ADMIN\"}},","+\t\t\t\t\t},","+\t\t\t\t}}","+\t\t\t},","+\t\t\twantInErr: \"MAC_ADMIN\",","+\t\t},","+\t\t// Allowlist also rejects benign-by-old-standards but not-in-allowlist caps","+\t\t// (the prior denylist let these through, the allowlist does not).","+\t\t{","+\t\t\tname: \"CHOWN capability (rejected under allowlist)\",","+\t\t\tmutate: func(ps *apiv1.PodSpec) {","+\t\t\t\tps.Containers = []apiv1.Container{{","+\t\t\t\t\tName: \"user\",","+\t\t\t\t\tSecurityContext: &apiv1.SecurityContext{","+\t\t\t\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"CHOWN\"}},","+\t\t\t\t\t},","+\t\t\t\t}}","+\t\t\t},","+\t\t\twantInErr: \"CHOWN\",","+\t\t},"," \t\t{"," \t\t\tname: \"privileged init container\","," \t\t\tmutate: func(ps *apiv1.PodSpec) {","@@ -210,6 +288,9 @@ func TestValidateContainerSafety(t *testing.T) {"," \t\t{\"allowPrivilegeEscalation\", &apiv1.SecurityContext{AllowPrivilegeEscalation: &on}, \"allowPrivilegeEscalation\"},"," \t\t{\"SYS_ADMIN\", &apiv1.SecurityContext{Capabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"SYS_ADMIN\"}}}, \"SYS_ADMIN\"},"," \t\t{\"NET_ADMIN\", &apiv1.SecurityContext{Capabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"NET_ADMIN\"}}}, \"NET_ADMIN\"},","+\t\t// GHSA-qf5v: allowlist must reject SYS_TIME and CHOWN that the denylist let through.","+\t\t{\"SYS_TIME\", &apiv1.SecurityContext{Capabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"SYS_TIME\"}}}, \"SYS_TIME\"},","+\t\t{\"CHOWN\", &apiv1.SecurityContext{Capabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"CHOWN\"}}}, \"CHOWN\"},"," \t}"," \tfor _, tc := range cases {"," \t\tt.Run(tc.name, func(t *testing.T) {","@@ -228,22 +309,211 @@ func TestValidateContainerSafety(t *testing.T) {"," \t}"," }"," ","-// TestValidatePodSpecSafety_BenignCapability asserts that NET_BIND_SERVICE","-// (and other non-dangerous capabilities) flow through. The denylist is","-// intentionally narrow so legitimate function workloads can still bind to","-// privileged ports etc.","-func TestValidatePodSpecSafety_BenignCapability(t *testing.T) {","+// TestValidatePodSpecSafety_AllowedCapability asserts that NET_BIND_SERVICE","+// — the sole entry on the PSA-restricted allowlist — flows through. The","+// allowlist is intentionally narrow so legitimate function workloads can","+// still bind to privileged ports, and every other capability (including the","+// OCI defaults like CHOWN/MKNOD that the prior denylist accepted) is rejected.","+func TestValidatePodSpecSafety_AllowedCapability(t *testing.T) {"," \tps := &apiv1.PodSpec{"," \t\tContainers: []apiv1.Container{{"," \t\t\tName: \"user\","," \t\t\tSecurityContext: &apiv1.SecurityContext{"," \t\t\t\tCapabilities: &apiv1.Capabilities{","-\t\t\t\t\tAdd: []apiv1.Capability{\"NET_BIND_SERVICE\", \"CHOWN\"},","+\t\t\t\t\tAdd: []apiv1.Capability{\"NET_BIND_SERVICE\"},"," \t\t\t\t},"," \t\t\t},"," \t\t}},"," \t}"," \tif err := ValidatePodSpecSafety(\"Function.spec.podspec\", ps); err != nil {","-\t\tt.Fatalf(\"non-dangerous capabilities must flow through, got: %v\", err)","+\t\tt.Fatalf(\"NET_BIND_SERVICE must flow through, got: %v\", err)","+\t}","+}","+","+// TestAllTenantContainerSurfacesAreValidated is the forward-compat regression","+// guard for the PodSpec-injection advisory cluster (GHSA-gx55 / GHSA-wmgg /","+// GHSA-v455 / GHSA-m63v / GHSA-qf5v). It walks every Fission CRD type via","+// reflection, finds every tenant-reachable `*apiv1.PodSpec` and","+// `*apiv1.Container` field (including slice element types), and asserts each","+// is on the explicitly maintained `knownCovered` set. A new CRD addition that","+// introduces a tenant-supplied PodSpec/Container surface without wiring it","+// through ValidateForAdmission — or removes a surface without trimming","+// knownCovered — fails this test.","+//","+// MessageQueueTrigger.Spec.PodSpec is included on knownCovered because it","+// uses a controller-side allowlist (MergeAllowedPodSpecFields) plus its own","+// admission validator (validateAllowedPodSpec in pkg/webhook/messagequeuetrigger.go).","+// SecurityContext is not on that allowlist, so a tenant cannot inject","+// capabilities through MQT — the qf5v fix doesn't need to touch that path.","+func TestAllTenantContainerSurfacesAreValidated(t *testing.T) {","+\tknownCovered := map[string]string{","+\t\t\"Function.Spec.PodSpec\":              \"ValidatePodSpecSafety in Function.validateForAdmission\",","+\t\t\"Environment.Spec.Runtime.PodSpec\":   \"ValidatePodSpecSafety in Environment.validateForAdmission\",","+\t\t\"Environment.Spec.Runtime.Container\": \"ValidateContainerSafety in Environment.validateForAdmission\",","+\t\t\"Environment.Spec.Builder.PodSpec\":   \"ValidatePodSpecSafety in Environment.validateForAdmission\",","+\t\t\"Environment.Spec.Builder.Container\": \"ValidateContainerSafety in Environment.validateForAdmission\",","+\t\t\"MessageQueueTrigger.Spec.PodSpec\":   \"MQT-specific allowlist (validateAllowedPodSpec); SecurityContext not allowlisted\",","+\t}","+","+\ttargets := map[reflect.Type]struct{}{","+\t\treflect.TypeFor[apiv1.PodSpec]():   {},","+\t\treflect.TypeFor[apiv1.Container](): {},","+\t}","+","+\tcrdRoots := []any{","+\t\tFunction{}, Environment{}, Package{}, HTTPTrigger{}, TimeTrigger{},","+\t\tKubernetesWatchTrigger{}, MessageQueueTrigger{}, CanaryConfig{},","+\t}","+","+\tfound := map[string]struct{}{}","+\tfor _, c := range crdRoots {","+\t\trt := reflect.TypeOf(c)","+\t\twalkTenantPodSpecFields(rt.Name(), rt, targets, found, map[reflect.Type]bool{})","+\t}","+","+\tfor path := range found {","+\t\tif _, ok := knownCovered[path]; !ok {","+\t\t\tt.Errorf(\"tenant-supplied PodSpec/Container field %q has no admission-time safety validator on record. \"+","+\t\t\t\t\"Wire it through ValidatePodSpecSafety / ValidateContainerSafety in the CRD's ValidateForAdmission (and sanitizeContainerSecurityContext at the merge site if applicable), then add the path to knownCovered in TestAllTenantContainerSurfacesAreValidated.\",","+\t\t\t\tpath)","+\t\t}","+\t}","+\tfor path := range knownCovered {","+\t\tif _, ok := found[path]; !ok {","+\t\t\tt.Errorf(\"knownCovered references %q but reflection no longer finds it; the field was removed or renamed — trim knownCovered to match\", path)","+\t\t}","+\t}","+}","+","+// walkTenantPodSpecFields recurses through a CRD type's exported struct fields","+// (and slice/pointer element types) looking for fields whose underlying type","+// matches one of `targets`. Each hit emits its dotted field path into `found`.","+// Standard Kubernetes meta fields are skipped — they cannot carry tenant data.","+func walkTenantPodSpecFields(prefix string, rt reflect.Type, targets map[reflect.Type]struct{}, found map[string]struct{}, seen map[reflect.Type]bool) {","+\tfor rt.Kind() == reflect.Pointer {","+\t\trt = rt.Elem()","+\t}","+\tif rt.Kind() != reflect.Struct || seen[rt] {","+\t\treturn","+\t}","+\tseen[rt] = true","+\tfor i := range rt.NumField() {","+\t\tf := rt.Field(i)","+\t\tif !f.IsExported() {","+\t\t\tcontinue","+\t\t}","+\t\tif f.Name == \"TypeMeta\" || f.Name == \"ObjectMeta\" || f.Name == \"ListMeta\" {","+\t\t\tcontinue","+\t\t}","+\t\tft := f.Type","+\t\t// Unwrap pointer / slice / array to the underlying element type.","+\t\tfor {","+\t\t\tswitch ft.Kind() {","+\t\t\tcase reflect.Pointer, reflect.Slice, reflect.Array:","+\t\t\t\tft = ft.Elem()","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tbreak","+\t\t}","+\t\tpath := prefix + \".\" + f.Name","+\t\tif _, hit := targets[ft]; hit {","+\t\t\tfound[path] = struct{}{}","+\t\t\tcontinue // don't descend into PodSpec/Container — its internal fields are the upstream k8s API surface, not Fission-CRD-owned","+\t\t}","+\t\tif ft.Kind() == reflect.Struct {","+\t\t\twalkTenantPodSpecFields(path, ft, targets, found, seen)","+\t\t}","+\t}","+}","+","+// TestTenantContainerSurfaces_RejectSysAdmin pins, for every CRD surface on","+// the knownCovered list, that ValidateForAdmission actually rejects a","+// SYS_ADMIN injection at that exact field path. The reflection walk above","+// catches *missing* wiring; this test catches wiring that exists but no longer","+// rejects (e.g., a future refactor that forgets to call the safety validator).","+func TestTenantContainerSurfaces_RejectSysAdmin(t *testing.T) {","+\tmeta := metav1.ObjectMeta{Name: \"tenant-attack\", Namespace: \"default\"}","+\tsc := func() *apiv1.SecurityContext {","+\t\treturn &apiv1.SecurityContext{","+\t\t\tCapabilities: &apiv1.Capabilities{Add: []apiv1.Capability{\"SYS_ADMIN\"}},","+\t\t}","+\t}","+\tpsWithSysAdmin := func() *apiv1.PodSpec {","+\t\treturn &apiv1.PodSpec{Containers: []apiv1.Container{{Name: \"user\", SecurityContext: sc()}}}","+\t}","+","+\ttype admissionValidator interface {","+\t\tValidateForAdmission() error","+\t}","+","+\tcases := []struct {","+\t\tpath string","+\t\tmk   func() admissionValidator","+\t}{","+\t\t{","+\t\t\tpath: \"Function.Spec.PodSpec\",","+\t\t\tmk: func() admissionValidator {","+\t\t\t\tf := &Function{ObjectMeta: meta}","+\t\t\t\tf.Spec.InvokeStrategy = InvokeStrategy{","+\t\t\t\t\tStrategyType:      StrategyTypeExecuti