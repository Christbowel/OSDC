               &self,","+                cluster: ClusterConfig<'_>,","+            ) -> Result<Arc<dyn Connector<Service = Self::Service> + Send + Sync>, BoxError>","+            {","+                let connector = self.0.make_connector(cluster)?;","+                Ok(Arc::new(RecordingConnector(connector, self.1.clone())))","+            }","+        }","+","+        /// The endpoints the next config lists for the channel's one cluster.","+        async fn listed(view: &mut CacheWatch<XdsConfigResult>) -> HashSet<EndpointAddress> {","+            let config = view.next().await.unwrap().unwrap();","+            let (_, cluster) = config.clusters().next().unwrap();","+            let endpoints = cluster.unwrap().endpoints().unwrap();","+            endpoints.map(|ep| ep.address().clone()).collect()","+        }","+","+        let cluster_name = \"test-cluster\";","+        let (_, servers) = setup_grpc_servers(3).await;","+        let cache = Arc::new(XdsCache::new());","+        let publish = |servers: &[TestServer]| {","+            publish_single_cluster_config(","+                &cache,","+                cluster_name,","+                make_test_cluster(cluster_name),","+                make_test_endpoints(cluster_name, servers),","+            )","+        };","+        publish(&servers[..2]);","+","+        // XdsLb connects only while polled; TowerP2c's discovery connects","+        // eagerly either way.","+        let (connects_tx, mut connects) = mpsc::unbounded_channel();","+        let factory = LbBackend::XdsLb.cluster_factory::<_, TonicBody, TonicBody>(","+            RecordingMakeConnector(","+                super::grpc_make_connector(","+                    crate::GrpcMakeConnector::new(),","+                    super::ClusterCircuitBreakerRegistry::new_for_test(),","+                ),","+                connects_tx,","+            ),","+            #[cfg(feature = \"_tls-any\")]","+            LbBackend::empty_cert_registry(),","+            Arc::new(super::GrpcOutcomeClassifier),","+        );","+        let channel = build_xds_channel_from_factory(&cache, factory);","+        let mut view = channel.xds_config();","+        let initial = listed(&mut view).await;","+        tokio::time::sleep(tokio::time::Duration::from_millis(50)).await;","+        assert!(","+            connects.is_empty(),","+            \"by_request={by_request}: connected idle\"","+        );","+","+        let mut connected = HashSet::new();","+        let mut expect_connected = async |expected: HashSet<EndpointAddress>| {","+            let all = async {","+                while connected != expected {","+                    connected.insert(connects.recv().await.unwrap());","+                }","+            };","+            let waited = tokio::time::timeout(tokio::time::Duration::from_secs(5), all).await;","+            assert!(","+                waited.is_ok(),","+                \"by_request={by_request}: connected {connected:?}\"","+            );","+        };","+        if by_request {","+            let client = GreeterClient::new(channel.clone());","+            let (successful, error_types, _) = send_grpc_requests(client, 1).await;","+            assert_eq!(successful, 1, \"{error_types:?}\");","+        } else {","+            channel.connect();","+        }","+        expect_connected(initial).await;","+","+        publish(&servers);","+        let all = listed(&mut view).await;","+        assert_eq!(all.len(), 3);","+        expect_connected(all).await;","+","+        shutdown(servers).await;","+    }","+","     /// A cluster that leaves the route config and later rejoins it is served","     /// from its new resources, whether or not the router saw the route config","     /// without it.","@@ -1929,13 +2119,14 @@ mod tests {","             &self,","             cluster_name: &str,","             _watches: ClusterWatches,","+            connect: ConnectSignal,","         ) -> ClusterChannel<http::Request<TonicBody>