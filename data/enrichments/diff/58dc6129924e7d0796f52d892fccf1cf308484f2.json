sing the new","+ * userParam key names, so the assignments endpoint never receives the legacy header keys.","+ */","+export class VSCodeCoreAssignmentsFilterProvider implements IExperimentationFilterProvider {","+\tconstructor(","+\t\tprivate version: string,","+\t\tprivate appName: string,","+\t\tprivate devDeviceId: string,","+\t\tprivate targetPopulation: TargetPopulation,","+\t\tprivate releaseDate: string,","+\t\tprivate windowKind: WindowKind","+\t) { }","+","+\tgetFilterValue(filter: string): string | null {","+\t\tswitch (filter) {","+\t\t\tcase AssignmentsFilters.ApplicationVersion:","+\t\t\t\treturn trimVersionSuffix(this.version);","+\t\t\tcase AssignmentsFilters.Build:","+\t\t\t\treturn this.appName;","+\t\t\tcase AssignmentsFilters.DeveloperDeviceId:","+\t\t\t\treturn this.devDeviceId;","+\t\t\tcase AssignmentsFilters.ExtensionName:","+\t\t\tcase AssignmentsFilters.ExtensionNameShort:","+\t\t\t\treturn 'vscode-core';","+\t\t\tcase AssignmentsFilters.TargetPopulation:","+\t\t\t\treturn this.targetPopulation;","+\t\t\tcase AssignmentsFilters.Platform:","+\t\t\t\treturn platform.PlatformToString(platform.platform);","+\t\t\tcase AssignmentsFilters.ReleaseDate:","+\t\t\t\treturn formatReleaseDate(this.releaseDate);","+\t\t\tcase AssignmentsFilters.WindowKind:","+\t\t\t\treturn this.windowKind;","+\t\t\tdefault:","+\t\t\t\treturn null;"," \t\t}","-\t\treturn match.slice(1, 5).join('');"," \t}"," "," \tgetFilters(): Map<string, unknown> {"," \t\tconst filters: Map<string, unknown> = new Map<string, unknown>();","-\t\tconst filterValues = Object.values(Filters);","-\t\tfor (const value of filterValues) {","+\t\tfor (const value of Object.values(AssignmentsFilters)) {"," \t\t\tfilters.set(value, this.getFilterValue(value));"," \t\t}"," "],"additions":88,"deletions":28,"truncated":false},{"path":"src/vs/workbench/services/assignment/common/assignmentFilters.ts","lines":["@@ -243,3 +243,84 @@ export class CopilotAssignmentFilterProvider extends Disposable impleme