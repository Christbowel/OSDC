the first known value and fall back to it so the","+\t\t// filter is not dropped from later requests once we have seen it.","+\t\tconst liveTrackingId = this._chatEntitlementService.copilotTrackingId;","+\t\tif (liveTrackingId) {","+\t\t\tthis.copilotTrackingId = liveTrackingId;","+\t\t}","+\t\tconst copilotTrackingId = liveTrackingId ?? this.copilotTrackingId;","+\t\tconst internalOrg = getInternalOrg(this._chatEntitlementService.organisations) ?? this.internalOrg;","+\t\tswitch (filter) {","+\t\t\tcase GitHubAssignmentsFilter.CopilotTrackingId:","+\t\t\t\treturn copilotTrackingId ?? null;","+\t\t\tcase GitHubAssignmentsFilter.IsGhOrMsftStaff:","+\t\t\t\treturn internalOrg ? '1' : '0';","+\t\t\tcase GitHubAssignmentsFilter.GhMsftOrExternal:","+\t\t\t\treturn internalOrg === 'github'","+\t\t\t\t\t? 'github'","+\t\t\t\t\t: (internalOrg === 'microsoft' || internalOrg === 'vscode')","+\t\t\t\t\t\t? 'microsoft'","+\t\t\t\t\t\t: 'external';","+\t\t\tdefault:","+\t\t\t\treturn null;","+\t\t}","+\t}","+","+\tgetFilters(): Map<string, string | null> {","+\t\tconst filters = new Map<string, string | null>();","+\t\tfor (const value of Object.values(GitHubAssignmentsFilter)) {","+\t\t\tfilters.set(value, this.getFilterValue(value));","+\t\t}","+","+\t\treturn filters;","+\t}","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"src/vs/workbench/services/assignment/common/assignmentService.ts","lines":["@@ -5,7 +5,7 @@"," "," import { localize } from '../../../../nls.js';"," import { createDecorator, IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';","-import type { IKeyValueStorage, IExperimentationTelemetry, ExperimentationService as TASClient } from 'tas-client';","+import type { IKeyValueStorage, IExperimentationTelemetry, IExperimentationFilterProvider, ExperimentationService as TASClient } from 'tas-client';"," import { Memento } from '../../../common/memento.js';"," import { ITelemetryService } from '../../../../platfor