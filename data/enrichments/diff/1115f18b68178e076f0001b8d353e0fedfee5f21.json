xample\",","+\t\tResolvers:   []string{listener.LocalAddr().String()},","+\t}","+\trequire.NoError(t, request.Compile(executerOpts))","+","+\tstart := time.Now()","+\tfor _, host := range []string{\"a.example\", \"b.example\", \"c.example\", \"d.example\"} {","+\t\tinput := contextargs.NewWithInput(context.Background(), host)","+\t\trequire.NoError(t, request.ExecuteWithResults(input, output.InternalEvent{}, output.InternalEvent{}, func(*output.InternalWrappedEvent) {}))","+\t}","+\t// The question name is the same for every input, so they share one limiter.","+\trequire.GreaterOrEqual(t, time.Since(start), 800*time.Millisecond)","+}",""],"additions":67,"deletions":0,"truncated":false}],"additions":106,"deletions":21,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-10T14:52:58.001504+00:00"}