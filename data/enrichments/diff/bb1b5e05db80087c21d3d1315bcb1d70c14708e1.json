 : 5;","+    size_t const payloadSize = type == 2 ? 1 : blockSize;","+    if (version == 1) {","+        dst[0] = 0xFD; dst[1] = 0x2F; dst[2] = 0xB5; dst[3] = 0x1E;","+    } else {","+        dst[0] = (unsigned char)(0x20 + version);","+        dst[1] = 0xB5; dst[2] = 0x2F; dst[3] = 0xFD;","+    }","+    if (version >= 4) dst[4] = version == 6 ? 5 : 0;","+    if (version == 7) dst[5] = 0x38; /* 128-KB window, unknown content size */","+    dst[headerSize] = (unsigned char)((type << 6) | ((blockSize >> 16) & 7));","+    dst[headerSize + 1] = (unsigned char)(blockSize >> 8);","+    dst[headerSize + 2] = (unsigned char)blockSize;","+    memset(dst + headerSize + 3, 'X', payloadSize);","+    dst[headerSize + 3 + payloadSize] = 0xC0;","+    dst[headerSize + 4 + payloadSize] = 0;","+    dst[headerSize + 5 + payloadSize] = 0;","+    return headerSize + 6 + payloadSize;","+}","+#endif","+","+static int testLegacyBlockBounds(void)","+{","+#if (ZSTD_LEGACY_SUPPORT <= 7)","+    size_t const sizes[] = { LEGACY_BLOCK_LIMIT - 1, LEGACY_BLOCK_LIMIT,","+                            LEGACY_BLOCK_LIMIT + 1, 2 * LEGACY_BLOCK_LIMIT, 524287 };","+    unsigned char* const src = (unsigned char*)malloc(2 * (524287 + 12));","+    unsigned char* const decoded = (unsigned char*)malloc(524287 + 1);","+    unsigned version, type;","+    size_t s;","+    int failed = 1;","+    if (src == NULL || decoded == NULL) goto cleanup;","+    for (version = ZSTD_LEGACY_SUPPORT; version <= 7; ++version) {","+        for (type = 0; type < 3; ++type) {","+            for (s = 0; s < sizeof(sizes) / sizeof(sizes[0]); ++s) {","+                size_t const size = sizes[s];","+                int const reject = size > LEGACY_BLOCK_LIMIT;","+                size_t const srcSize = buildLegacyBlockFrame(src, version, type, size);","+                size_t const cSize = ZSTD_findFrameCompressedSize(src, srcSize);","+                unsigned long long const bound = ZSTD_decompressBound(src, srcSize);","+                if (reject) {","+                    if (ZSTD_getErrorCode(cSize) != ZSTD_error_corruption_detected","+                        || bound != ZSTD_CONTENTSIZE_ERROR) goto mismatch;","+                    if (ZSTD_getErrorCode(ZSTD_decompress(decoded, 524287 + 1, src, srcSize))","+                        != ZSTD_error_corruption_detected) goto mismatch;","+                } else {","+                    if (cSize != srcSize || bound != LEGACY_BLOCK_LIMIT) goto mismatch;","+                    /* Only decode raw blocks here: the compressed payload is","+                     * arbitrary 'X' bytes, and not all early versions support RLE. */","+                    if (type == 1) {","+                        size_t const result = ZSTD_decompress(decoded, 524287 + 1, src, srcSize);","+                        if (result != size || decoded[0] != 'X'","+                            || decoded[size - 1] != 'X') goto mismatch;","+                    }","+                }","+                continue;","+mismatch:","+                DISPLAY(\"ERROR: v0.%u block type %u size %u violates block bound\\n\",","+                        version, type, (unsigned)size);","+                goto cleanup;","+            }","+        }","+        {   size_t const first = buildLegacyBlockFrame(src, version, 1, LEGACY_BLOCK_LIMIT);","+            size_t const second = buildLegacyBlockFrame(src + first, version, 1, 1);","+            size_t const result = ZSTD_decompress(decoded, 524287 + 1, src, first + second);","+            if (ZSTD_decompressBound(src, first + second) != 2ULL * LEGACY_BLOCK_LIMIT","+                || result != LEGACY_BLOCK_LIMIT + 1) {","+                DISPLAY(\"ERROR: v0.%u concatenated raw frames violate block bound\\n\", version);","+                goto cleanup;","+            }","+            if (ZSTD_getErrorCode(ZSTD_decompress(decoded, LEGACY_BLOCK_LIMIT - 1,","+                                                  src, first)) != ZSTD_error_dstSize_tooSmall) {","+  