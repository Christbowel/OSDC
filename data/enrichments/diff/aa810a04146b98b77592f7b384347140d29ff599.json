 || node.type === 'NewExpression') {","+\t\t\t\tconst callee = node.callee;","+\t\t\t\tif (callee.type !== 'Identifier') return false;","+","+\t\t\t\t// single-argument new URL(path) misparses absolute windows paths just like import(), so require a base","+\t\t\t\treturn (","+\t\t\t\t\tcallee.name === 'pathToFileURL' || (callee.name === 'URL' && node.arguments.length > 1)","+\t\t\t\t);","+\t\t\t}","+","+\t\t\t// `pathToFileURL(...).href` and `new URL(...).href`","+\t\t\tif (node.type === 'MemberExpression') {","+\t\t\t\treturn (","+\t\t\t\t\tnode.property.type === 'Identifier' &&","+\t\t\t\t\tnode.property.name === 'href' &&","+\t\t\t\t\tis_safe(node.object, depth)","+\t\t\t\t);","+\t\t\t}","+","+\t\t\t// resolve an identifier one hop to its declaration","+\t\t\tif (node.type === 'Identifier' && depth === 0) {","+\t\t\t\tconst variable = context.sourceCode","+\t\t\t\t\t.getScope(node)","+\t\t\t\t\t.references.find((ref) => ref.identifier === node)?.resolved;","+","+\t\t\t\tconst def = variable?.defs[0];","+","+\t\t\t\tif (","+\t\t\t\t\tvariable?.defs.length === 1 &&","+\t\t\t\t\tdef?.type === 'Variable' &&","+\t\t\t\t\tdef.node.init &&","+\t\t\t\t\t// a reassignment after a safe initializer would not be seen here","+\t\t\t\t\tvariable.references.every((ref) => !ref.isWrite() || ref.init)","+\t\t\t\t) {","+\t\t\t\t\treturn is_safe(def.node.init, depth + 1);","+\t\t\t\t}","+\t\t\t}","+","+\t\t\treturn false;","+\t\t}","+","+\t\treturn {","+\t\t\tImportExpression(node) {","+\t\t\t\tif (!is_safe(node.source)) {","+\t\t\t\t\tcontext.report({ node: node.source, messageId: 'requirePathToFileURL' });","+\t\t\t\t}","+\t\t\t}","+\t\t};","+\t}","+};"],"additions":89,"deletions":0,"truncated":false},{"path":".github/workflows/ci.yml","lines":["@@ -256,3 +256,16 @@ jobs:","           node-version: ${{ matrix.node-version }}","       - run: cd packages/kit && pnpm prepublishOnly","       - run: pnpm run test:others","+  test-others-windows:","+    runs-on: windows-latest","+    t