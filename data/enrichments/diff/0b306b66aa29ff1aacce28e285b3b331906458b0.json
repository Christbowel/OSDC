{"id":"0b306b66aa29ff1aacce28e285b3b331906458b0","axis":"silent","repo":"pnpm/pnpm","sha":"0b306b66aa29ff1aacce28e285b3b331906458b0","parsed":{"files":[{"path":".changeset/bootstrap-reads-global-tls-settings.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/config.reader\": patch","+\"@pnpm/types\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`strictSsl` and `localAddress` set in the global `config.yaml`, through `PNPM_CONFIG_STRICT_SSL` and `PNPM_CONFIG_LOCAL_ADDRESS`, or on the command line now apply to `pnpm self-update` and to the download of the pnpm version pinned in `packageManager`. These requests read them from `.npmrc` only before. `--config.localAddress` now reaches them in the camelCase spelling too [pnpm/tasks#201](https://github.com/pnpm/tasks/issues/201)."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests/tls_settings.rs","lines":["@@ -61,4 +61,5 @@ fn dotted_tls_settings_override_the_workspace_yaml() {","     assert_eq!(config.tls.strict_ssl, Some(false));","     assert_eq!(config.tls.local_address, Some([127, 0, 0, 2].into()));","     assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","+    assert_eq!(config.package_manager_bootstrap.tls.local_address, Some([127, 0, 0, 2].into()));"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/known_settings.rs","lines":["@@ -34,6 +34,7 @@ const TYPED_WORKSPACE_MANIFEST_KEYS: &[&str] = &[","     \"httpProxy\",","     \"httpsProxy\",","     \"ignoredOptionalDependencies\",","+    \"localAddress\",","     \"namedRegistries\",","     \"nodeDownloadMirrors\",","     \"noProxy\",","@@ -48,6 +49,7 @@ const TYPED_WORKSPACE_MANIFEST_KEYS: &[&str] = &[","     \"remoteSideEffectsCache\",","     \"requiredScripts\",","     \"sideEffectsCache\",","+    \"strictSsl\",","     \"supportedArchitectures\",","     \"tasks\",","     \"update\","],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/loading.rs","lines":["@@ -250,6 +250,7 @@ impl Config {","                 &mut bootstrap.proxy,","                 &mut bootstrap.proxy_keys,","             );","+            global_settings.settings.apply_tls_to(&mut bootstrap.tls);","         }","         Ok(())","     }","@@ -320,6 +321,7 @@ impl Config {","         let configured_state_dir = env_settings.machine.state_dir.take();","         let bootstrap = &mut self.package_manager_bootstrap;","         env_settings.settings.apply_proxy_to(&mut bootstrap.proxy, &mut bootstrap.proxy_keys);","+        env_settings.settings.apply_tls_to(&mut bootstrap.tls);","         let saved_workspace_dir = self.workspace_dir.clone();","         env_settings.expand_home_prefixes::<Sys>();","         env_settings.apply_to(self, start_dir);","@@ -361,6 +363,7 @@ impl Config {","         }","         let bootstrap = &mut self.package_manager_bootstrap;","         settings.settings.apply_proxy_to(&mut bootstrap.proxy, &mut bootstrap.proxy_keys);","+        settings.settings.apply_tls_to(&mut bootstrap.tls);","         let saved_workspace_dir = self.workspace_dir.clone();","         settings.apply_to(self, start_dir);","         self.workspace_dir = saved_workspace_dir;"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/tests/tls_settings.rs","lines":["@@ -141,3 +141,111 @@ fn cli_tls_settings_override_the_environment_and_the_workspace_yaml() {","     assert_eq!(config.tls.strict_ssl, Some(false));","     assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));"," }","+","+/// The bootstrap reads the sources outside the repository: the trusted","+/// `.npmrc` files, the global `config.yaml`, the environment, and the","+/// command line. The project's `pnpm-workspace.yaml` stays out of it.","+#[test]","+fn global_config_yaml_tls_settings_reach_the_bootstrap_over_the_user_npmrc() {","+    fake_env!();","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        \"strictSsl: true\\nlocalAddress: 127.0.0.4\\n\",","+    );","+    let auth = tempdir().expect(\"auth tempdir\");","+    let user_file = auth.path().join(\"user-npmrc\");","+    write_file(&user_file, \"strict-ssl=true\\nlocal-address=127.0.0.3\\n\");","+    let xdg = tempdir().expect(\"config tempdir\");","+    let config_dir = xdg.path().join(\"pnpm\");","+    fs::create_dir_all(&config_dir).expect(\"create global config dir\");","+    write_file(","+        &config_dir.join(\"config.yaml\"),","+        &format!(\"strictSsl: false\\nlocalAddress: {LOCAL_ADDRESS}\\n\"),","+    );","+","+    set_fake_env(&[(\"XDG_CONFIG_HOME\", xdg.path().to_str().unwrap())]);","+    let config = Config { npmrc_auth_file: Some(user_file), ..Config::default() }","+        .current::<FakeEnv>(project.path())","+        .expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(true));","+    assert_eq!(config.tls.local_address, local_address(\"127.0.0.4\"));","+    assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","+    assert_eq!(config.package_manager_bootstrap.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+#[test]","+fn workspace_yaml_tls_settings_do_not_reach_the_bootstrap() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        &format!(\"strictSsl: false\\nlocalAddress: {LOCAL_ADDRESS}\\n\"),","+    );","+","+    let config = Config::new().current::<HostNoHome>(project.path()).expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, None);","+    assert_eq!(config.package_manager_bootstrap.tls.local_address, None);","+}","+","+#[test]","+fn pnpm_config_env_tls_settings_reach_the_bootstrap_over_the_global_config_yaml() {","+    fake_env!(load_with_fake_env);","+    let project = tempdir().expect(\"project tempdir\");","+    let xdg = tempdir().expect(\"config tempdir\");","+    let config_dir = xdg.path().join(\"pnpm\");","+    fs::create_dir_all(&config_dir).expect(\"create global config dir\");","+    write_file(&config_dir.join(\"config.yaml\"), \"strictSsl: true\\nlocalAddress: 127.0.0.3\\n\");","+","+    set_fake_env(&[","+        (\"XDG_CONFIG_HOME\", xdg.path().to_str().unwrap()),","+        (\"PNPM_CONFIG_STRICT_SSL\", \"false\"),","+        (\"PNPM_CONFIG_LOCAL_ADDRESS\", LOCAL_ADDRESS),","+    ]);","+    let config = load_with_fake_env(project.path());","+","+    assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","+    assert_eq!(config.package_manager_bootstrap.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+/// The command line outranks the global `config.yaml` in the bootstrap as","+/// it does in the project config, in both spellings of a setting.","+#[test]","+fn cli_tls_settings_reach_the_bootstrap_over_the_global_config_yaml_and_the_environment() {","+    fake_env!();","+    let project = tempdir().expect(\"project tempdir\");","+    let xdg = tempdir().expect(\"config tempdir\");","+    let config_dir = xdg.path().join(\"pnpm\");","+    fs::create_dir_all(&config_dir).expect(\"create global config dir\");","+    write_file(&config_dir.join(\"config.yaml\"), \"strictSsl: true\\n\");","+    set_fake_env(&[","+        (\"XDG_CONFIG_HOME\", xdg.path().to_str().unwrap()),","+        (\"PNPM_CONFIG_LOCAL_ADDRESS\", \"127.0.0.3\"),","+    ]);","+","+    // `--config.strict-ssl=false --config.localAddress=...`, as the CLI","+    // seeds them: the tokens as given, the setting values in kebab-case.","+    let config = Config {","+        cli: crate::CliLayer {","+            npmrc_tokens: vec![","+                (\"strict-ssl\".to_string(), \"false\".to_string()),","+                (\"localAddress\".to_string(), LOCAL_ADDRESS.to_string()),","+            ],","+            setting_values: [(\"strict-ssl\", \"false\"), (\"local-address\", LOCAL_ADDRESS)]","+                .iter()","+                .map(|&(key, value)| (key.to_string(), value.to_string()))","+                .collect::<BTreeMap<_, _>>(),","+            ..crate::CliLayer::default()","+        },","+        ..Config::default()","+    }","+    .current::<FakeEnv>(project.path())","+    .expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+    assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","+    assert_eq!(config.package_manager_bootstrap.tls.local_address, local_address(LOCAL_ADDRESS));","+}"],"additions":108,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/apply.rs","lines":["@@ -418,11 +418,12 @@ impl WorkspaceSettings {","         overlay_some(&mut config.audit_ignore_prune, audit.ignore_prune);","     }"," ","-    /// An invalid `localAddress` clears the one a lower source set, as","-    /// it does between `.npmrc` layers.","-    fn apply_tls_to(&mut self, tls: &mut pnpm_network::TlsConfig) {","-        overlay_some(&mut tls.strict_ssl, self.strict_ssl.take());","-        if let Some(local_address) = self.local_address.take() {","+    /// Overlay `strictSsl` and `localAddress` onto `tls`, the project's or","+    /// the package-manager bootstrap's. An invalid `localAddress` clears the","+    /// one a lower source set, as it does between `.npmrc` layers.","+    pub(crate) fn apply_tls_to(&self, tls: &mut pnpm_network::TlsConfig) {","+        overlay_some(&mut tls.strict_ssl, self.strict_ssl);","+        if let Some(local_address) = self.local_address.as_deref() {","             tls.local_address = local_address.parse().ok();","         }","     }"],"additions":6,"deletions":5,"truncated":false},{"path":"pnpm11/config/reader/src/getConfig/envVars.ts","lines":["@@ -136,6 +136,14 @@ function applyEnvSetting ({ ex