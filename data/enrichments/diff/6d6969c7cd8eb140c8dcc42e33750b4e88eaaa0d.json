e_TRPCQueryHandleWithData<TDef>>;","+  /**","+   * Like `unstable_$ensure`, but stale data in the cache is refetched before it resolves.","+   * Rejects if that request fails.","+   *","+   * Same as `await queryClient.fetchQuery(trpc.<path>.queryOptions(input, opts))`.","+   * Not available on `useTRPC()`.","+   * @see https://trpc.io/docs/client/tanstack-react-query/handles#fetch","+   */","+  unstable_$fetch: (","+    ...args: undefined extends TDef['input']","+      ? [input?: TDef['input'], opts?: unstable_TRPCPrefetchOptions]","+      : [input: TDef['input'], opts?: unstable_TRPCPrefetchOptions]","+  ) => Promise<unstable_TRPCQueryHandleWithData<TDef>>;","+}","+","+/** Verbs added to query procedures with a `cursor` input */","+export interface DecorateInfiniteQueryHandleVerbs<TDef extends ResolverDef> {","+  /**","+   * Like `unstable_$prefetch`, for an infinite query. Loads the first page unless `pages` is set.","+   *","+   * Same as `void queryClient.prefetchInfiniteQuery(trpc.<path>.infiniteQueryOptions(input, opts))`.","+   * On `useTRPC()`, call it during render, like `unstable_$prefetch`.","+   * @see https://trpc.io/docs/client/tanstack-react-query/handles#infinite-queries","+   */","+  unstable_$prefetchInfinite: (","+    input: TDef['input'],","+    opts?: unstable_TRPCPrefetchInfiniteOptions<TDef>,","+  ) => unstable_TRPCInfiniteQueryHandle<TDef>;","+  /**","+   * Like `unstable_$ensure`, for an infinite query. The handle carries the loaded pages.","+   *","+   * Same as `await queryClient.ensureInfiniteQueryData({ ...trpc.<path>.infiniteQueryOptions(input, opts), revalidateIfStale: true })`.","+   * Not available on `useTRPC()`.","+   * @see https://trpc.io/docs/client/tanstack-react-query/handles#infinite-queries","+   */","+  unstable_$ensureInfinite: (","+    input: TDef['input'],","+    opts?: unstable_TRPCPrefetchInfiniteOptions<TDef>,","+  ) => Promise<unstable_TRPCInfiniteQueryHandleWithData<TDef>>;","+  /**","+   * Like `unstable_$fetch`, 