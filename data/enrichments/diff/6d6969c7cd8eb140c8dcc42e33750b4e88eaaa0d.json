he server (or in a loader).","+ * Read it with `trpc.unstable_$fromHandle(handle, { getNextPageParam })`.","+ */","+export interface unstable_TRPCInfiniteQueryHandle<","+  TDef extends ResolverDef = ResolverDef,","+> {","+  /**","+   * Type-only: never present at runtime. Required, so only the handle verbs","+   * create handles.","+   */","+  readonly [handleDef]: TDef & { kind: 'infinite' };","+  readonly queryKey: HandleQueryKey<","+    TDef,","+    InfiniteHandleInput<TDef['input']>,","+    'infinite'","+  >;","+  /** The input the query was started with, without `cursor` and `direction` */","+  readonly input: InfiniteHandleInput<TDef['input']>;","+  readonly initialCursor?: NonNullable<ExtractCursorType<TDef['input']>> | null;","+}","+","+/**","+ * An infinite handle from `unstable_$ensureInfinite()` or `unstable_$fetchInfinite()`:","+ * it also carries the loaded `pages` and `pageParams`.","+ */","+export interface unstable_TRPCInfiniteQueryHandleWithData<","+  TDef extends ResolverDef = ResolverDef,","+> extends unstable_TRPCInfiniteQueryHandle<TDef> {","+  readonly data: TRPCInfiniteData<TDef['input'], TDef['output']>;","+  /** When `data` was fetched, as a timestamp, so its staleness carries over */","+  readonly dataUpdatedAt: number;","+}","+","+export type unstable_AnyTRPCHandle =","+  | unstable_TRPCQueryHandle<any>","+  | unstable_TRPCInfiniteQueryHandle<any>;","+","+/** Options for starting a query that returns a handle */","+export interface unstable_TRPCPrefetchOptions","+  extends","+    Pick<","+      FetchQueryOptions,","+      'staleTime' | 'retry' | 'retryDelay' | 'gcTime' | 'meta'","+    >,","+    TRPCQueryBaseOptions {}","+","+type HandleGetNextPageParam<TDef extends ResolverDef> =","+  GetNextPageParamFunction<","+    NonNullable<ExtractCursorType<TDef['input']>> | null,","+    TDef['output']","+  >;","+","+export type unstable_TRPCPrefetchInfiniteOptions<TDef extends ResolverDef> =","+  unstable_TRPCPrefetchOptions & {","+    initialCursor