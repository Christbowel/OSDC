lly for one repository.","+ */","+export async function fetchReviewCategories(","+  projectId: string,","+  range: ReviewAuthorRange,","+  repositoryId: string,","+): Promise<ReviewCategoryList> {","+  if (!projectId) {","+    return { categories: [], total: 0 }","+  }","+","+  return await sdk","+    .forProject(projectId)","+    .reviews.listCategories({ range, repositoryId: repositoryId || undefined })","+}","+"," // ============================================================================"," // QUERY OPTIONS"," // ============================================================================","@@ -321,6 +340,23 @@ export function reviewAuthorsQueryOptions(","   })"," }"," ","+export function reviewCategoriesQueryOptions(","+  projectId: string | null | undefined,","+  range: ReviewAuthorRange = '30d',","+  repositoryId: string = '',","+) {","+  return queryOptions({","+    queryKey: ['review-categories', 'project', projectId, range, repositoryId],","+    queryFn: () => fetchReviewCategories(projectId!, range, repositoryId),","+    enabled: !!projectId,","+    staleTime: DEFAULT_STALE_TIME,","+    retry: false,","+    refetchOnWindowFocus: false,","+    placeholderData: keepPreviousData,","+    gcTime: projectId ? 5 * 60 * 1000 : 0,","+  })","+}","+"," export function reviewedRepositoriesQueryOptions(","   projectId: string | null | undefined,","   providerRepositoryIds: readonly string[],","@@ -446,6 +482,21 @@ export function useReviewAuthors(","   }"," }"," ","+export function useReviewCategories(","+  projectId: string | null | undefined,","+  range: ReviewAuthorRange = '30d',","+  repositoryId: string = '',","+) {","+  const { data, isLoading } = useQuery(","+    reviewCategoriesQueryOptions(projectId, range, repositoryId),","+  )","+","+  return {","+    categories: data?.categories ?? [],","+    isLoading,","+  }","+}","+"," /**","  * Which of the given GitHub repositories the project reviews, keyed by GitHub","  * repository ID. Works for any number of reviewed repositories, since only the"],"additions":51,"deletions":0,"truncated":false},{"path":"apps/console/src/routes/_public/projects.$projectId.reviews.performance.tsx","lines":["@@ -3,6 +3,7 @@ import { View } from '@/components/pages/projects/$projectId/reviews/View'"," import {","   projectQueryOptions,","   reviewAuthorsQueryOptions,","+  reviewCategoriesQueryOptions,","   reviewRepositoriesQueryOptions,"," } from '@/lib/react-query/hooks'"," import { pageTitle } from '@/lib/utils/page-title'","@@ -19,6 +20,7 @@ export const Route = createFileRoute(","     await queryClient.ensureQueryData(projectQueryOptions(projectId))","     await Promise.all([","       queryClient.ensureQueryData(reviewAuthorsQueryOptions(projectId)),","+      queryClient.ensureQueryData(reviewCategoriesQueryOptions(projectId)),","       queryClient.ensureQueryData(reviewRepositoriesQueryOptions(projectId)),","     ])","   },"],"additions":2,"deletions":0,"truncated":false},{"path":"src/Appwrite/Platform/Modules/Reviews/Http/Categories/XList.php","lines":["@@ -0,0 +1,162 @@","+<?php","+","+namespace Appwrite\\Platform\\Modules\\Reviews\\Http\\Categories;","+","+use Appwrite\\Platform\\Action;","+use Appwrite\\SDK\\AuthType;","+use Appwrite\\SDK\\Method;","+use Appwrite\\SDK\\Response as SDKResponse;","+use Appwrite\\Utopia\\Response;","+use Utopia\\Database\\Database;","+use Utopia\\Database\\DateTime;","+use Utopia\\Database\\Document;","+use Utopia\\Database\\Query;","+use Utopia\\Database\\Validator\\UID;","+use Utopia\\Platform\\Scope\\HTTP;","+use Utopia\\System\\System;","+use Utopia\\Validator\\WhiteList;","+","+/**","+ * How the findings of each category landed: how many a later commit fixed, and how many were","+ * dismissed without a change. A category with many dismissed findings is one the reviewer should","+ * flag less, or that a learning should narrow. Computed from the completed reviews of the range,","+ * newest first, up to APP_LIMIT_REVIEW_AUTHORS of them.","+ */","+class XList extends Action","+{","+    use HTTP;","+","+    private const array RANGES = [","+        '7d' => 7,","+        '30d' => 30,","+        '90d' => 90,","+    ];","+","+    private const int PAGE = 1000;","+","+    /** Reviews whose findings are read in one query: at most 100 findings each. */","+    private const int FINDINGS_CHUNK = 50;","+","+    public static function getName()","+    {","+        return 'listReviewCategories';","+    }","+","+    public function __construct()","+    {","+        $this","+            ->setHttpMethod(Action::HTTP_REQUEST_METHOD_GET)","+            ->setHttpPath('/v1/reviews/categories')","+            ->desc('List review categories')","+            ->groups(['api', 'reviews'])","+            ->label('scope', 'reviews.read')","+            ->label('sdk', new Method(","+                namespace: 'reviews',","+                group: 'categories',","+                name: 'listCategories',","+                description: <<<EOT","+                List the categories of the findings posted on the project's pull requests over a range, with how many were fixed and how many were dismissed without a change. Categories with the most dismissed findings come first.","+                EOT,","+                auth: [AuthType::ADMIN, AuthType::KEY],","+                responses: [","+                    new SDKResponse(","+                        code: Response::STATUS_CODE_OK,","+                        model: Response::MODEL_REVIEW_CATEGORY_LIST,","+                    )","+                ],","+                // Hidden until code review is generally available; preview SDK builds show it.","+                hide: System::getEnv('_APP_SDK_PREVIEW', 'disabled') !== 'enabled',","+            ))","+            ->param('range', '30d', new WhiteList(\\array_keys(self::RANGES), true), 'Date range of the reviews.', true)","+            ->param('repositoryId', '', new UID(), 'Count only the reviews of this repository.', true)","+            ->inject('response')","+            ->inject('dbForProject')","+            ->callback($this->action(...));","+    }","+","+    public function action(","+        string $range,","+        string $repositoryId,","+        Response $response,","+        Database $dbForProject,","+    ): void {","+        $since = DateTime::addSeconds(new \\DateTime(), -self::RANGES[$range] * 86400);","+","+        $filters = [","+            Query::equal('status', ['completed']),","+            Query::greaterThanEqual('$createdAt', $since),","+        ];","+        if ($repositoryId !== '') {","+            $filters[] = Query::equal('repositoryId', [$repositoryId]);","+        }","+","+        $categories = [];","+        foreach (\\array_chunk($this->listReviews($filters, $dbForProject), self::FINDINGS_CHUNK) as $chunk) {","+            // Dropped findings were never posted, so nobody could judge them.","+            $findings = $dbForProject->find('reviewFindings', [","+                Query::equal('reviewInternalId', $chunk),","+                Query::notEqual('status', 'dropped'),","+                Query::select(['category', 'status']),","+                Query::limit(self::FINDINGS_CHUNK * APP_LIMIT_ARRAY_PARAMS_SIZE),","+            ]);","+","+            foreach ($findings as $finding) {","+                $name = $finding->getAttribute('category');","+                $category = &$categories[$name];","+                $category ??= [","+                    'category' => $name,","+                    'findings' => 0,","+                    'resolved' => 0,","+                    'dismissed' => 0,","+                ];","+","+                $category['findings']++;","+                $status = $finding->getAttribute('status');","+                if ($status === 'resolved' || $status === 'dismissed') {","+                    $category[$status]++;","+                }","+                unset($category);","+            }","+        }","+","+        $documents = \\array_map(fn (a