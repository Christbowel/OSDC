 | 'lastReviewAt'"," ","@@ -78,6 +94,17 @@ function formatPercent(value: number | null): string {","   return value === null ? '-' : `${Math.round(value * 100)}%`"," }"," ","+/**","+ * Share of the settled findings that a later commit fixed rather than someone","+ * dismissed. Findings still open count for neither side.","+ */","+function usefulRate(item: {","+  resolved: number","+  dismissed: number","+}): number | null {","+  return ratio(item.resolved, item.resolved + item.dismissed)","+}","+"," function formatNumber(value: number | null): string {","   return value === null ? '-' : value.toFixed(1)"," }","@@ -96,6 +123,8 @@ function sortValue(author: ReviewAuthor, key: SortKey): number | string {","       return author.critical + author.major","     case 'fixRate':","       return ratio(author.resolved, author.findings) ?? -1","+    case 'useful':","+      return usefulRate(author) ?? -1","     case 'tier':","       return TIERS.indexOf(author.tier)","     case 'lastReviewAt':","@@ -179,6 +208,7 @@ export function Performance({ projectId }: { projectId: string }) {","     range,","     repositoryId,","   )","+  const { categories } = useReviewCategories(projectId, range, repositoryId)"," ","   // A repository row stores GitHub's ID only; its name comes from GitHub, as","   // on the repositories tab, whose cache this shares.","@@ -218,6 +248,7 @@ export function Performance({ projectId }: { projectId: string }) {","           critical: sum.critical + author.critical,","           major: sum.major + author.major,","           resolved: sum.resolved + author.resolved,","+          dismissed: sum.dismissed + author.dismissed,","         }),","         {","           pulls: 0,","@@ -227,6 +258,7 @@ export function Performance({ projectId }: { projectId: string }) {","           critical: 0,","           major: 0,","           resolved: 0,","+          dismissed: 0,","         },","       ),","     [authors],","@@ -352,7 +384,7 @@ export function Performance({ projectId }: { projectId: string }) {","         />","       ) : (","         <>","-          <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4\">","+          <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5\">","             <StatCard","               icon={GitPullRequest}","               label={t('Pull requests reviewed')}","@@ -388,6 +420,14 @@ export function Performance({ projectId }: { projectId: string }) {","                 String(totals.resolved),","               )}","             />","+            <StatCard","+              icon={Target}","+              label={t('Useful findings')}","+              value={formatPercent(usefulRate(totals))}","+              hint={t('{resolved} fixed, {dismissed} dismissed')","+                .replace('{resolved}', String(totals.resolved))","+                .replace('{dismissed}', String(totals.dismissed))}","+            />","           </div>"," ","           <div className=\"rounded-lg border border-border bg-card overflow-hidden\">","@@ -401,6 +441,7 @@ export function Performance({ projectId }: { projectId: string }) {","                   {header('findingsPerPull', t('Findings / PR'))}","                   {header('severe', t('Critical / major'))}","                   {header('fixRate', t('Fixed'))}","+                  {header('useful', t('Useful'))}","                   {header('tier', t('Confidence'))}","                   {header('lastReviewAt', t('Last review'))}","                 </TableRow>","@@ -443,6 +484,9 @@ export function Performance({ projectId }: { projectId: string }) {","                     <TableCell className=\"px-4 py-3 text-end text-[13px] tabular-nums\">","                       {formatPercent(ratio(author.resolved, author.findings))}","                     </TableCell>","+                    <TableCell className=\"px-4 py-3 text-end text-[13px] tabular-nums\">","+                      {formatPercent(usefulRate(author))}","+                    </TableCell>","                     <TableCell className=\"px-4 py-3 text-end\">","                       <div className=\"flex justify-end\">","                         <ReviewTierBadge tier={author.tier} />","@@ -461,9 +505,13 @@ export function Performance({ projectId }: { projectId: string }) {","               </TableBody>","             </Table>","           </div>","+          {categories.length > 0 && <Categories categories={categories} />}","           <p className=\"text-[12px] text-muted-foreground\">","             {t(","               'Counts completed reviews in the range. Approval and confidence go by each pull request’s latest review; fixed counts findings resolved by a later commit.',","+            )}{' '}","+            {t(","+              'Useful findings is the share of settled findings that were fixed rather than dismissed; findings still open count for neither.',","             )}","           </p>","         </>","@@ -471,3 +519,76 @@ export function Performance({ projectId }: { projectId: string }) {","     </div>","   )"," }","+","+/**","+ * How the findings of each category landed, most dismissed first: the signal for","+ * which kinds of findings the reviewer should flag less, or a learning should","+ * narrow.","+ */","+function Categories({ categories }: { categories: ReviewCategory[] }) {","+  const t = useT()","+  return (","+    <div className=\"space-y-2\">","+      <div>","+        <h3 className=\"text-[14px] font-semibold text-foreground\">","+          {t('Findings by category')}","+        </h3>","+        <p className=\"text-[12px] text-muted-foreground\">","+          {t(","+            'Categories that are often dismissed are candidates for a learning that tells the reviewer to flag them less.',","+          )}","+        </p>","+      </div>","+      <div className=\"rounded-lg border border-border bg-card overflow-hidden\">","+        <Table>","+          <TableHeader>","+            <TableRow className=\"hover:bg-transparent border-b border-border\">","+              <TableHead className={HEAD_CLASS}>{t('Category')}</TableHead>","+              <TableHead className={cn(HEAD_CLASS, 'text-end')}>","+                {t('Findings')}","+              </TableHead>","+              <TableHead className={cn(HEAD_CLASS, 'text-end')}>","+                {t('Useful')}","+              </TableHead>","+              <TableHead className={cn(HEAD_CLASS, 'text-end')}>","+                {t('Dismissed')}","+              </TableHead>","+            </TableRow>","+          </TableHeader>","+          <TableBody>","+            {categories.map((category) => {","+              const settled = category.resolved + category.dismissed","+              const noisy =","+                settled >= NOISY_MIN_SETTLED &&","+                category.dismissed / settled >= NOISY_SHARE","+              return (","+                <TableRow","+                  key={category.category}","+                  className=\"border-b border-border/50\"","+                >","+                  <TableCell className=\"px-4 py-3 text-[13px] font-medium text-foreground\">","+                    {category.category}","+                  </TableCell>","+                  <TableCell className=\"px-4 py-3 text-end text-[13px] tabular-nums\">","+                    {category.findings}","+                  </TableCell>","+                  <TableCell className=\"px-4 py-3 text-end text-[13px] tabular-nums\">","+                    {formatPercent(usefulRate(category))}","+                  </TableCell>","+                  <TableCell","+                    className={cn(","+                      'px-4 py-3 text-end text-[13px] tabular-nums',","+                      noisy && 'text-destructive',","+                    )}","+                  >","+                    {category.dismissed}","+                  </TableCell>","+                </TableRow>","+              )","+            })}","+          </TableBody>","+        </Table>","+      </div>","+    </div>","+  )","+}"],"additions":123,"deletions":2,"truncated":false},{"path":"apps/console/src/lib/appwrite/reviews/models.ts","lines":["@@ -1,6 +1,6 @@"," /**","  * Reviews response models, copied from `Review`, `ReviewFinding`,","- * `ReviewRepository`, `ReviewLearning` and `ReviewAuthor` in `src/Appwrite/Utopia/Response/Model`. Delete with","+ * `ReviewRepository`, `ReviewLearning`, `ReviewAuthor` and `ReviewCategory` in `src/Appwrite/Utopia/Response/Model`. Delete with","  * `service.ts` once the generated SDK carries the `reviews` service.","  */"," ","@@ -347,3 +347,31 @@ export type ReviewAuthorList = {","    */","   authors: ReviewAuthor[]"," }","+","+/**","+ * Review Category: how the findings of one category landed over a range.","+ */","+export type ReviewCategory = {","+  /** Finding category, such as bug, security or performance. */","+  category: string","+  /** Findings of the category posted on pull requests. */","+  findings: number","+  /** Findings fixed by a later commit. */","+  resolved: number","+  /** Findings settled without a change: declined in their thread, or whose thread a maintainer resolved. */","+  dismissed: number","+}","+","+/**","+ * Review Categories List","+ */","+export type ReviewCategoryList = {","+  /**","+   * Total number of categories.","+   */","+  total: number","+  /**","+   * Categories with the most dismissed findings first.","+   */","+  categories: ReviewCategory[]","+}"],"additions":29,"deletions":1,"truncated":false},{"path":"apps/console/src/lib/appwrite/reviews/service.ts","lines":["@@ -11,6 +11,7 @@ import type {","   Review,","   ReviewAuthorList,","   ReviewAuthorRange,","+  ReviewCategoryList,","   ReviewEventList,","   ReviewInstallation,","   ReviewLearningList,","@@ -289,6 +290,34 @@ export class Reviews {","     )","   }"," ","+  /**","+   * List the categories of the findings posted on the project's pull","+   * requests with how many were fixed and how many dismissed, most dismissed","+   * first.","+   *","+   * @param {ReviewAuthorRange} params.range - Date range of the reviews. Defaults to 30d.","+   * @param {string} params.repositoryId - Count only the reviews of this repository.","+   * @throws {AppwriteException}","+   * @returns {Promise<ReviewCategoryList>}","+   */","+  listCategories(","+    params: { range?: ReviewAuthorRange; repositoryId?: string } = {},","+  ): Promise<ReviewCategoryList> {","+    const payload: Record<string, unknown> = {}","+    if (typeof params.range !== 'undefined') {","+      payload['range'] = params.range","+    }","+    if (params.repositoryId) {","+      payload['repositoryId'] = params.repositoryId","+    }","+    return this.client.call(","+      'get',","+      this.uri('/reviews/categories'),","+      this.headers(),","+      payload,","+    )","+  }","+","   private uri(apiPath: string): URL {","     return new URL(this.client.config.endpoint + apiPath)","   }"],"additions":29,"deletions":0,"truncated":false},{"path":"apps/console/src/lib/i18n/dictionaries/he/reviews.ts","lines":["@@ -259,4 +259,16 @@ export const heReviewsDictionary: Record<string, string> = {","     'כאן מוצג איך מחברי בקשות המשיכה שלכם מצליחים בסקירה, לאחר שהסקירות מושלמות. נסו טווח ארוך יותר או מאגר אחר.',","   'Counts completed reviews in the range. Approval and confidence go by each pull request’s latest review; fixed counts findings resolved by a later commit.':","     'נספרות סקירות שהושלמו בטווח. אישור וביטחון נקבעים לפי הסקירה האחרונה של כל בקשת משיכה; תוקנו סופר ממצאים שנפתרו בקומיט מאוחר יותר.',","+","+  // Finding outcomes","+  'Useful findings': 'ממצאים מועילים',","+  '{resolved} fixed, {dismissed} dismissed':","+    '{resolved} תוקנו, {dismissed} נדחו',","+  Useful: 'מועילים',","+  Dismissed: 'נדחו',","+  'Findings by category': 'ממצאים לפי קטגוריה',","+  'Categories that are often dismissed are candidates for a learning that tells the reviewer to flag them less.':","+    'קטגוריות שנדחות לעיתים קרובות הן