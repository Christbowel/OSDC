ed_lockfiles_relink(linker: &str, optimistic: &str) {","+    let fixture = workspace(linker, optimistic);","+    let root = &fixture.workspace;","+    fs::OpenOptions::new()","+        .append(true)","+        .open(root.join(\"pnpm-workspace.yaml\"))","+        .and_then(|mut yaml| io::Write::write_all(&mut yaml, b\"sharedWorkspaceLockfile: false\\n\"))","+        .unwrap();","+    for command in [\"a-one\", \"a-renamed\"] {","+        write_bins(root, &json!({ command: \"one.js\" }));","+        pnpm(root)","+            .args([\"install\", \"--offline\", \"--ignore-scripts\"])","+            .assert()","+            .success();","+        for pkg in [\"packages/b\", \"packages/c\"] {","+            assert_installed_bins(&root.join(pkg).join(\"node_modules/.bin\"), &[command]);","+        }","+        assert_bin(root, \"c\", command, \"one\");","+    }","+}","+"," #[test]"," fn hoisted_workspace_package_prunes_removed_bins_from_root() {","     for linker in [\"isolated\", \"hoisted\"] {"],"additions":33,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install.rs","lines":["@@ -19,9 +19,9 @@ pub(crate) use modules_state::{"," };"," pub use run::{InstallExecution, InstallLockfilePolicy, ResolutionInputs};"," pub(crate) use workspace_state::{","-    CarriedSettings, StateWrite, configured_or_discovered_workspace_dir, lockfile_root_dir,","-    recorded_workspace_state, registry_keys_current, update_workspace_state_or_warn,","-    workspace_packages_for_freshness,","+    CarriedSettings, StateProjects, StateWrite, configured_or_discovered_workspace_dir,","+    lockfile_root_dir, recorded_workspace_state, registry_keys_current,","+    update_workspace_state_or_warn, workspace_packages_for_freshness,"," };"," pub use workspace_state::{","     UpToDateFastPathCheck, UpToDateWorkspace, build_workspace_packages_map,"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization.rs","lines":["@