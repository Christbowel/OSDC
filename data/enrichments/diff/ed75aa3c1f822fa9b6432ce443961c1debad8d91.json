sing exponential backoff. Values <= 1 make one attempt.","+\tAuthExchangeAttempts int"," }"," "," // HookResolveAuthKey resolves to [oauthkey.ResolveAuthKey] when the"],"additions":3,"deletions":0,"truncated":false},{"path":"tsnet/depaware.txt","lines":["@@ -123,7 +123,7 @@ tailscale.com/tsnet dependencies: (generated by github.com/tailscale/depaware)","         tailscale.com/appc                                           from tailscale.com/ipn/ipnlocal","      💣 tailscale.com/atomicfile                                     from tailscale.com/ipn+","         tailscale.com/client/local                                   from tailscale.com/client/web+","-        tailscale.com/client/tailscale                               from tailscale.com/internal/client/tailscale","+        tailscale.com/client/tailscale                               from tailscale.com/internal/client/tailscale+","         tailscale.com/client/tailscale/apitype                       from tailscale.com/client/local+","  LDWI    tailscale.com/client/web                                     from tailscale.com/ipn/ipnlocal","         tailscale.com/control/controlbase                            from tailscale.com/control/controlhttp+","@@ -264,6 +264,7 @@ tailscale.com/tsnet dependencies: (generated by github.com/tailscale/depaware)","         tailscale.com/types/structs                                  from tailscale.com/control/controlclient+","         tailscale.com/types/tkatype                                  from tailscale.com/client/local+","         tailscale.com/types/views                                    from tailscale.com/appc+","+        tailscale.com/util/authretry                                 from tailscale.com/feature/oauthkey","         tailscale.com/util/backoff                                   from tailscale.com/control/controlclient+","         tailscale.com/util/bufiox                                    from tailscale.com/types/key","         tailscale.com/util/checkchange                               from tailscale.com/ipn/ipnlocal+","@@ -360,7 +361,7 @@ tailscale.com/tsnet dependencies: (generated by github.com/tailscale/depaware)","         golang.org/x/net/ipv6                                        from github.com/tailscale/wireguard-go/conn+","  LDW    golang.org/x/net/proxy                                       from tailscale.com/net/netns","   DI    golang.org/x/net/route                                       from tailscale.com/net/netmon+","-        golang.org/x/oauth2                                          from golang.org/x/oauth2/clientcredentials","+        golang.org/x/oauth2                                          from golang.org/x/oauth2/clientcredentials+","         golang.org/x/oauth2/clientcredentials                        from tailscale.com/feature/oauthkey","         golang.org/x/oauth2/internal                                 from golang.org/x/oauth2+","         golang.org/x/sync/errgroup                                   from github.com/mdlayher/socket+"],"additions":3,"deletions":2,"truncated":false},{"path":"util/authretry/authretry.go","lines":["@@ -0,0 +1,67 @@","+// Copyright (c) Tailscale Inc & contributors","+// SPDX-License-Identifier: BSD-3-Clause","+","+// Package authretry provides retry logic for transient errors encountered","+// during auth key generation (OAuth token fetch, WIF token exchange).","+package authretry","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"log\"","+\t\"net/http\"","+\t\"time\"","+","+\t\"golang.org/x/oauth2\"","+\ttsclient \"tailscale.com/client/tailscale\"","+\t\"tailscale.com/util/backoff\"","+)","+","+// RetryOnTransientFailure calls fn up to attempts times, retrying transient","+// errors with exponential backoff. Values <= 1 call fn exactly once.","+func RetryOnTransientFailure(ctx context.Context, name string, attempts int, fn func() (string, error)) (string, error) {","+\tattempts = max(1, attempts)","+\tvar bo *backoff.Backoff","+\tif attempts > 1 {","+\t\tbo = backoff.NewBackoff(name, log.Printf, 30*time.Second, backoff.WithInitialBackoff(1*time.Second))","+\t}","+\tvar lastErr error","+\tfor i := range attempts {","+\t\tresult, err := fn()","+\t\tif err == nil {","+\t\t\treturn result, nil","+\t\t}","+\t\tlastErr = err","+\t\tif i == attempts-1 || !isRetriableError(err) {","+\t\t\treturn \"\", err","+\t\t}","+\t\tlog.Printf(\"%s: transient error (attempt %d/%d), retrying: %v\", name, i+1, attempts, err)","+\t\tbo.BackOff(ctx, err)","+\t\tif ctx.Err() != nil {","+\t\t\treturn \"\", ctx.Err()","+\t\t}","+\t}","+\treturn \"\", lastErr","+}","+","+// isRetriableError reports whether err is a transient error that may succeed on","+// retry: e.g., any 5xx status (from either tsclient.ErrResponse or *oauth2.RetrieveError),","+// or context.DeadlineExceeded.","+//","+// TODO(mpminardi): add-in handling for 429 if / when these are returned from the upstream","+// endpoints that are hit in the auth exchange flows.","+func isRetriableError(err error) bool {","+\tif err == nil {","+\t\treturn false","+\t}","+\tif errors.Is(err, context.DeadlineExceeded) {","+\t\treturn true","+\t}","+\tif errResp, ok := errors.AsType[tsclient.ErrResponse](err); ok {","+\t\treturn errResp.Status >= http.StatusInternalServerError","+\t}","+\tif retrieveErr, ok := errors.AsType[*oauth2.RetrieveError](err); ok {","+\t\treturn retrieveErr.Response.StatusCode >= http.StatusInternalServerError","+\t}","+\treturn false","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"util/authretry/authretry_test.go","lines":["@@ -0,0 +1,238 @@","+// Copyright (c) Tailscale Inc & contributors","+// SPDX-License-Identifier: BSD-3-Clause","+","+package authretry","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"net/http\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"time\"","+","+\t\"golang.org/x/oauth2\"","+\ttsclient \"tailscale.com/client/tailscale\"","+)","+","+func TestIsRetriable(t *testing.T) {","+\ttests := []struct {","+\t\tname string","+\t\terr  error","+\t\twant bool","+\t}{","+\t\t{\"nil-error\", nil, false},","+\t\t{\"non-retriable-error\", errors.New(\"something went wrong\"), false},","+\t\t{\"deadline-exceeded\", context.DeadlineExceeded, true},","+\t\t{\"wrapped-deadline-exceeded\", fmt.Errorf(\"request failed: %w\", context.DeadlineExceeded), true},","+\t\t{\"err-response-500\", tsclient.ErrResponse{Status: 500, Message: \"internal server error\"}, true},","+\t\t{\"err-response-502\", tsclient.ErrResponse{Status: 502, Message: \"bad gateway\"}, true},","+\t\t{\"err-response-503\", tsclient.ErrResponse{Status: 503, Message: \"service unavailable\"}, true},","+\t\t{\"err-response-504\", tsclient.ErrResponse{Status: 504, Message: \"gateway timeout\"}, true},","+\t\t{\"err-response-400\", tsclient.ErrResponse{Status: 400, Message: \"bad request\"}, false},","+\t\t{\"err-response-401\", tsclient.ErrResponse{Status: 401, Message: \"unauthorized\"}, false},","+\t\t{\"err-response-403\", tsclient.ErrResponse{Status: 403, Message: \"forbidden\"}, false},","+\t\t{\"err-response-404\", tsclient.ErrResponse{Status: 404, Message: \"not found\"}, false},","+\t\t{\"wrapped-err-response-400\", fmt.Errorf(\"create key: %w\", tsclient.ErrResponse{Status: 400}), false},","+\t\t{","+\t\t\t\"oauth2-retrieve-error-503\",","+\t\t\t&oauth2.RetrieveError{Response: &http.Response{StatusCode: 503}, Body: []byte(\"service unavailable\")},","+\t\t\ttrue,","+\t\t},","+\t\t{","+\t\t\t\"oauth2-retrieve-error-400\",","+\t\t\t&oauth2.RetrieveError{Response: &http.Response{StatusCode: 400}, Body: []byte(\"bad request\")},","+\t\t\tfalse,","+\t\t},","+\t\t{","+\t\t\t\"wrapped-oauth2-retrieve-error-504\",","+\t\t\tfmt.Errorf(\"token exchange: %w\", &oauth2.RetrieveError{Response: &http.Response{StatusCode: 504}, Body: []byte(\"gateway timeout\")}),","+\t\t\ttrue,","+\t\t},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tif got := isRetriableError(tt.err); got != tt.want {","+\t\t\t\tt.Errorf(\"isRetriable() = %v, want %v\", got, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestRetryAttemptCount(t *testing.T) {","+\tfor _, attempts := range []int{-1, 0, 1, 2, 4} {","+\t\tt.Run(fmt.Sprint(attempts), func(t *testing.T) {","+\t\t\tcalls := 0","+\t\t\twantErr := tsclient.ErrResponse{Status: 503, Message: \"unavailable\"}","+\t\t\t_, err := RetryOnTransientFailure(context.Background(), \"test\", attempts, func() (string, error) {","+\t\t\t\tcalls++","+\t\t\t\treturn \"\", wantErr","+\t\t\t})","+\t\t\tif !errors.Is(err, wantErr) {","+\t\t\t\tt.Errorf(\"got error %v, want %v\", err, wantErr)","+\t\t\t}","+\t\t\tif want := max(1, attempts); calls != want {","+\t\t\t\tt.Errorf(\"got %d calls, want %d\", calls, want)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestRetryOnTransient(t *testing.T) {","+\tt.Run(\"calls-once-on-retriable-error-with-one-attempt\", func(t *testing.T) {","+\t\tvar calls atomic.Int32","+\t\t_, err := RetryOnTransientFailure(context.Background(), \"test\", 1, func() (string, error) {","+\t\t\tcalls.Add(1)","+\t\t\treturn \"\", tsclient.ErrResponse{Status: 503, Message: \"unavailable\"}","+\t\t})","+\t\tif err == nil {","+\t\t\tt.Fatal(\"expected error\")","+\t\t}","+\t\tif got := calls.Load(); got != 1 {","+\t\t\tt.Errorf(\"got %d calls, want 1\", got)","+\t\t}","+\t})","+","+\tt.Run(\"success-case-one-attempt\", func(t *testing.T) {","+\t\tresult, err := RetryOnTransientFailure(context.Background(), \"test\", 1, func() (string, error) {","+\t\t\treturn \"key-123\", nil","+\t\t})","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t\t}","+\t\tif result != \"key-123\" {","+\t\t\tt.Errorf(\"got %q, want %q\", result, \"key-123\")","+\t\t}","+\t})","+","+\tt.Run(\"retries-on-retriable-error\", func(t *testing.T) {","+\t\tvar calls atomic.Int32","+\t\tresult, err := RetryOnTransientFailure(context.Background(), \"test\", 3, func() (string, error) {","+\t\t\tn := calls.Add(1)","+\t\t\tif n < 3 {"