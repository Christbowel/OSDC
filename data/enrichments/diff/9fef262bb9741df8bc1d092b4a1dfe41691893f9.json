ts;","+","+@TestInstance(TestInstance.Lifecycle.PER_CLASS)","+@DisplayName(\"Service Toggles Resource Test\")","+@ExtendWith(DropwizardAppExtensionProvider.class)","+class ServiceTogglesResourceTest {","+","+    private static final String USER = UUID.randomUUID().toString();","+","+    private static final String API_KEY_ENABLED = UUID.randomUUID().toString();","+    private static final String WORKSPACE_NAME_ENABLED = UUID.randomUUID().toString();","+    private static final String WORKSPACE_ID_ENABLED = UUID.randomUUID().toString();","+","+    private static final String API_KEY_OTHER = UUID.randomUUID().toString();","+    private static final String WORKSPACE_NAME_OTHER = UUID.randomUUID().toString();","+    private static final String WORKSPACE_ID_OTHER = UUID.randomUUID().toString();","+","+    private final RedisContainer REDIS = RedisContainerUtils.newRedisContainer();","+    private final MySQLContainer MYSQL = MySQLContainerUtils.newMySQLContainer();","+    private final GenericContainer<?> ZOOKEEPER_CONTAINER = ClickHouseContainerUtils.newZookeeperContainer();","+    private final ClickHouseContainer CLICKHOUSE = ClickHouseContainerUtils.newClickHouseContainer(ZOOKEEPER_CONTAINER);","+","+    private final WireMockRuntime wireMock;","+","+    @RegisterApp","+    private final TestDropwizardAppExtension APP;","+","+    {","+        Startables.deepStart(REDIS, MYSQL, CLICKHOUSE, ZOOKEEPER_CONTAINER).join();","+","+        wireMock = WireMockUtils.startWireMock();","+","+        var databaseAnalyticsFactory = ClickHouseContainerUtils.newDatabaseAnalyticsFactory(CLICKHOUSE, DATABASE_NAME);","+","+        MigrationUtils.runMysqlDbMigration(MYSQL);","+        MigrationUtils.runClickhouseDbMigration(CLICKHOUSE);","+","+        APP = TestDropwizardAppExtensionUtils.newTestDropwizardAppExtension(","+                TestDropwizardAppExtensionUtils.AppContextConfig.builder()","+                        .jdbcUrl(MYSQL.getJdbcUrl())","+                        .databaseAnalyticsFactory(databaseAnalyticsFactory)","+                        .runtimeInfo(wireMock.runtimeInfo())","+                        .redisUrl(REDIS.getRedisURI())","+                        .customConfigs(List.of(","+                                new CustomConfig(\"serviceToggles.ollieEnabled\", \"true\"),","+                                new CustomConfig(\"customCharts.enabledWorkspaces\", WORKSPACE_ID_ENABLED)))","+                        .build());","+    }","+","+    private String baseURI;","+    private ClientSupport client;","+","+    @BeforeAll","+    void setUpAll(ClientSupport client) {","+        this.baseURI = TestUtils.getBaseUrl(client);","+        this.client = client;","+","+        ClientSupportUtils.config(client);","+","+        AuthTestUtils.mockTargetWorkspace(wireMock.server(), API_KEY_ENABLED, WORKSPACE_NAME_ENABLED,","+                WORKSPACE_ID_ENABLED, USER);","+        AuthTestUtils.mockTargetWorkspace(wireMock.server(), API_KEY_OTHER, WORKSPACE_NAME_OTHER,","+                WORKSPACE_ID_OTHER, USER);","+    }","+","+    Stream<Arguments> customChartsWorkspaces() {","+        return Stream.of(","+                arguments(API_KEY_ENABLED, WORKSPACE_NAME_ENABLED, true),","+                arguments(API_KEY_OTHER, WORKSPACE_NAME_OTHER, false));","+    }","+","+    @ParameterizedTest","+    @MethodSource(\"customChartsWorkspaces\")","+    @DisplayName(\"custom_charts_enabled_for_workspace is true only for a workspace on the Custom Charts allowlist\")","+    void getToggles__customChartsEnabled__followsTheCallersWorkspace(String apiKey, String workspaceName,","+            boolean expected) {","+        try (var response = client.target(\"%s/v1/private/toggles/\".formatted(baseURI))","+                .request(MediaType.APPLICATION_JSON_TYPE)","+                .header(HttpHeaders.AUTHORIZATION, apiKey)","+                .header(WORKSPACE_HEADER, workspaceName)","+                .get()) {","+","+            assertThat(response.getStatus()).isEqualTo(200);","+            var toggles = response.readEntity(JsonNode.class);","+            assertThat(toggle(toggles, \"custom_charts_enabled_for_workspace\")).isEqualTo(expected);","+            assertThat(toggle(toggles, \"ollie_enabled\")).isTrue();","+        }","+    }","+","+    // The test app writes these keys in camelCase, the deployed one in snake_case; match either.","+    private static boolean toggle(JsonNode toggles, String snakeCaseName) {","+        String name = snakeCaseName.replace(\"_\", \"\");","+        return toggles.properties().stream()","+                .filter(entry -> entry.getKey().replace(\"_\", \"\").equalsIgnoreCase(name))","+                .findFirst()","+                .orElseThrow(() -> new AssertionError(\"no toggle \" + snakeCaseName + \" in \" + toggles))","+                .getValue()","+                .asBoolean();","+    }","+}"],"additions":140,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/contexts/feature-toggles-provider.tsx","lines":["@@ -29,6 +29,7 @@ const DEFAULT_STATE: FeatureToggles = {","   [FeatureToggleKeys.DATASET_EXPORT_ENABLED]: true,","   [FeatureToggleKeys.DEMO_DATA_ENABLED]: true,","   [FeatureToggleKeys.OLLIE_ENABLED]: false,","+  [FeatureToggleKeys.CUSTOM_CHARTS_ENABLED_FOR_WORKSPACE]: false,","   // Matches the backend default, so a backend that omits the key keeps Diagnostics as-is.","   [FeatureToggleKeys.AGENT_INSIGHTS_ENABLED]: true,","   [FeatureToggleKeys.PROJECT_HOMEPAGE_ENABLED]: false,"],"additions":1,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/shared/Dashboard/WidgetConfigDialog/WidgetConfigDialog.test.tsx","lines":["@@ -0,0 +1,78 @@","+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";","+import { render, screen } from \"@testing-library/react\";","+import WidgetConfigDialog from \"./WidgetConfigDialog\";","+import usePluginsStore from \"@/store/PluginsStore\";","+import { FeatureToggleKeys } from \"@/types/featu