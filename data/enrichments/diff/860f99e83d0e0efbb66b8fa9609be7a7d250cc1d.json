-\t\t\t$header_meta               = get_post_meta( $header_image['attachment_id'] );","-\t\t\t$header_image['timestamp'] = $header_meta[ $timestamp_key ] ?? '';","-\t\t\t$header_image['alt_text']  = $header_meta[ $alt_text_key ] ?? '';","+\t\t\t$header_image['timestamp'] = get_post_meta( $header_image['attachment_id'], $timestamp_key, true );","+\t\t\t$header_image['alt_text']  = get_post_meta( $header_image['attachment_id'], $alt_text_key, true );"," \t\t}"," "," \t\treturn $header_images;"],"additions":12,"deletions":7,"truncated":false},{"path":"wp-includes/customize/class-wp-customize-header-image-setting.php","lines":["@@ -15,6 +15,17 @@","  * @since 3.4.0","  *","  * @see WP_Customize_Setting","+ *","+ * @phpstan-type Header_Image_Data array{","+ *     attachment_id?: int,","+ *     url?: string,","+ *     thumbnail_url?: string,","+ *     timestamp?: int,","+ *     width?: int,","+ *     height?: int,","+ *     alt_text?: string,","+ *     attachment_parent?: int,","+ * }","  */"," final class WP_Customize_Header_Image_Setting extends WP_Customize_Setting {"," ","@@ -62,4 +73,163 @@ public function update( $value ) {"," \t\t}"," \t\treturn true;"," \t}","+","+\t/**","+\t * Sanitizes a header value.","+\t *","+\t * The value is expected to be one of the following:","+\t *","+\t * - An array of header image data, with the keys `attachment_id`, `url`, `thumbnail_url`, `timestamp`, `width`,","+\t *   `height`, `alt_text`, and `attachment_parent`, as supplied by {@see get_uploaded_header_images()}. Any other","+\t *   key is discarded.","+\t * - An array with a `choice` key, being the legacy format in which any of the other accepted values is nested.","+\t * - The string `remove-header`, `random-default-image`, or `random-uploaded-image`.","+\t * - A string corresponding to one of the keys for the array returned by {@see get_uploaded_header_images()}, or","+\t *   one of the keys for the array passed into {@see register_default_headers()}.","+\t *","+\t * @since 7.1.1","+\t *","+\t * @see WP_Customize_Header_Image_Setting::update()","+\t * @see Custom_Image_Header::set_header_image()","+\t *","+\t * @param mixed $value Value to sanitize.","+\t * @return array|string|WP_Error|null Sanitized value, or `null`/`WP_Error` if invalid. The array holds","+\t *                                    the header image data, or that data nested under a `choice` key,","+\t *                                    before the `customize_sanitize_header_image_data` filter, which","+\t *                                    may return anything, is applied to it.","+\t *","+\t * @phpstan-return array<mixed, mixed>|string|WP_Error|null","+\t */","+\tpublic function sanitize( $value ) {","+\t\t/*","+\t\t * The update() method unwraps the legacy `choice` format before handing the value off to","+\t\t * Custom_Image_Header::set_header_image(), so the nested value is what must be sanitized.","+\t\t */","+\t\tif ( is_array( $value ) && isset( $value['choice'] ) ) {","+\t\t\t$choice = $this->sanitize_choice( $value['choice'] );","+\t\t\tif ( is_null( $choice ) || is_wp_error( $choice ) ) {","+\t\t\t\treturn $choice;","+\t\t\t}","+\t\t\t$value = array( 'choice' => $choice );","+\t\t} else {","+\t\t\t$value = $this->sanitize_choice( $value );","+\t\t\tif ( is_null( $value ) || is_wp_error( $value ) ) {","+\t\t\t\treturn $value;","+\t\t\t}","+\t\t}","+","+\t\treturn parent::sanitize( $value );","+\t}","+","+\t/**","+\t * Sanitizes a header image choice.","+\t *","+\t * This is the value which is ultimately passed to {@see Custom_Image_Header::set_header_image()}, whether","+\t * supplied at the top level of the setting value or nested under its legacy `choice` key.","+\t *","+\t * @since 7.1.1","+\t *","+\t * @param mixed $value Value to sanitize.","+\t * @return array|string|WP_Error|null Sanitized value, or `null`/`WP_Error` if invalid.","+\t *","+\t * @phpstan-return Header_Image_Data|string|WP_Error|null","+\t */","+\tprivate function sanitize_choice( $value ) {","+\t\t// Custom_Image_Header::set_header_image() accepts an object in place of an array.","+\t\tif ( is_object( $value ) ) {","+\t\t\t$value = (array) $value;","+\t\t}","+","+\t\tif ( is_string( $value ) ) {","+\t\t\treturn sanitize_text_field( $value );","+\t\t}","+","+\t\tif ( ! is_array( $value ) ) {","+\t\t\treturn null;","+\t\t}","+","+\t\t/*","+\t\t * The sanitized value is assembled member by member rather than filtered down from the","+\t\t * supplied one, so that nothing but the members below can end up in it.","+\t\t */","+\t\t$sanitized = array();","+","+\t\tif ( isset( $value['attachment_id'] ) ) {","+\t\t\tif ( ! is_scalar( $value['attachment_id'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$attachment_id = absint( $value['attachment_id'] );","+","+\t\t\t/*","+\t\t\t * A supplied attachment must be an existing image, since its ID is written to postmeta and its","+\t\t\t * data displayed. Note that an ID of zero must be skipped rather than looked up, as","+\t\t\t * get_post_mime_type() falls back to the global post when passed an empty value.","+\t\t\t */","+\t\t\tif ( $attachment_id > 0 ) {","+\t\t\t\t$mime_type = get_post_mime_type( $attachment_id );","+\t\t\t\tif ( ! is_string( $mime_type ) || ! str_starts_with( $mime_type, 'image/' ) ) {","+\t\t\t\t\treturn null;","+\t\t\t\t}","+\t\t\t}","+","+\t\t\t$sanitized['attachment_id'] = $attachment_id;","+\t\t}","+","+\t\tif ( isset( $value['url'] ) ) {","+\t\t\tif ( ! is_string( $value['url'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['url'] = sanitize_url( $value['url'] );","+\t\t\tif ( '' === $sanitized['url'] ) {","+\t\t\t\treturn new WP_Error( 'invalid_url', __( 'Invalid URL.' ) );","+\t\t\t}","+\t\t}","+","+\t\tif ( isset( $value['thumbnail_url'] ) ) {","+\t\t\tif ( ! is_string( $value['thumbnail_url'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['thumbnail_url'] = sanitize_url( $value['thumbnail_url'] );","+\t\t\tif ( '' === $sanitized['thumbnail_url'] ) {","+\t\t\t\treturn new WP_Error( 'invalid_url', __( 'Invalid URL.' ) );","+\t\t\t}","+\t\t}","+","+\t\tif ( isset( $value['timestamp'] ) ) {","+\t\t\tif ( ! is_scalar( $value['timestamp'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['timestamp'] = absint( $value['timestamp'] );","+\t\t}","+","+\t\tif ( isset( $value['width'] ) ) {","+\t\t\tif ( ! is_scalar( $value['width'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['width'] = absint( $value['width'] );","+\t\t}","+","+\t\tif ( isset( $value['height'] ) ) {","+\t\t\tif ( ! is_scalar( $value['height'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['height'] = absint( $value['height'] );","+\t\t}","+","+\t\tif ( isset( $value['alt_text'] ) ) {","+\t\t\tif ( ! is_string( $value['alt_text'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['alt_text'] = sanitize_text_field( $value['alt_text'] );","+\t\t}","+","+\t\tif ( isset( $value['attachment_parent'] ) ) {","+\t\t\tif ( ! is_scalar( $value['attachment_parent'] ) ) {","+\t\t\t\treturn null;","+\t\t\t}","+\t\t\t$sanitized['attachment_parent'] = absint( $value['attachment_parent'] );","+\t\t}","+","+\t\treturn $sanitized;","+\t}"," }"],"additions":170,"deletions":0,"truncated":false},{"path":"wp-includes/theme.php","lines":["@@ -1551,6 +1551,7 @@ function get_uploaded_header_images() {","  * Gets the header image data.","  *","  * @since 3.4.0","+ * @since 7.1.1 The `width` and `height` are cast to non-negative integers.","  *","  * @global array $_wp_default_headers","  *","@@ -1589,7 +1590,14 @@ function get_custom_header() {"," \t\t'height'        => get_theme_support( 'custom-header', 'height' ),"," \t\t'video'         => get_theme_support( 'custom-header', 'video' ),"," \t);","-\treturn (object) wp_parse_args( $data, $default );","+","+\tif ( ! is_array( $data ) && ! is_object( $data ) ) {","+\t\t$data = array();","+\t}","+\t$header         = (object) wp_parse_args( $data, $default );","+\t$header->width  =