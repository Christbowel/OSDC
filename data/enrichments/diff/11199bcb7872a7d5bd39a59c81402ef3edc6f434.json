{"id":"11199bcb7872a7d5bd39a59c81402ef3edc6f434","axis":"silent","repo":"vllm-project/vllm","sha":"11199bcb7872a7d5bd39a59c81402ef3edc6f434","parsed":{"files":[{"path":"docs/models/supported_models.md","lines":["@@ -596,6 +596,7 @@ These models primarily accept the [`LLM.generate`](./generative_models.md#llmgen"," | `KimiVLForConditionalGeneration` | Kimi-VL-A3B-Instruct, Kimi-VL-A3B-Thinking | T + I<sup>+</sup> | `moonshotai/Kimi-VL-A3B-Instruct`, `moonshotai/Kimi-VL-A3B-Thinking` | | ✅︎ |"," | `LightOnOCRForConditionalGeneration` | LightOnOCR-1B | T + I<sup>E+</sup> | `lightonai/LightOnOCR-1B`, etc | ✅︎ | ✅︎ |"," | `Lfm2VlForConditionalGeneration` | LFM2-VL | T + I<sup>+</sup> | `LiquidAI/LFM2-VL-450M`, `LiquidAI/LFM2-VL-3B`, `LiquidAI/LFM2-VL-8B-A1B`, etc. | ✅︎ | ✅︎ |","+| `Lfm3AudioForConditionalGeneration` | LFM3-Audio | T + A<sup>E+</sup> | `LiquidAI/LFM3-Audio-2B`, etc. | | ✅︎ |"," | `Lfm3VlForConditionalGeneration` | LFM3-VL | T + I<sup>E+</sup> + V<sup>E+</sup> | `LiquidAI/LFM3-VL-2B` | | ✅︎ |"," | `Llama4ForConditionalGeneration` | Llama 4 | T + I<sup>+</sup> | `meta-llama/Llama-4-Scout-17B-16E-Instruct`, `meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8`, `meta-llama/Llama-4-Maverick-17B-128E-Instruct`, etc. | ✅︎ | ✅︎ |"," | `Llama_Nemotron_Nano_VL` | Llama Nemotron Nano VL | T + I<sup>E+</sup> | `nvidia/Llama-3.1-Nemotron-Nano-VL-8B-V1` | ✅︎ | ✅︎ |"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_lfm3_audio.py","lines":["@@ -0,0 +1,89 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import numpy as np","+import pytest","+","+from vllm.transformers_utils.configs.lfm3_audio import Lfm3AudioConfig","+from vllm.transformers_utils.processors.lfm3_audio import Lfm3AudioFeatureExtractor","+","+LAYER_TYPES = [\"conv\", \"conv\", \"full_attention\"] * 5 + [\"full_attention\"] * 2","+","+# The hub checkpoints (training export) and the transformers-native export","+TRAINING_EXPORT = {","+    \"lfm\": {\"model_type\": \"lfm3\", \"dtype\": \"float32\"},","+    \"encoder\": {","+        \"dim_in\": 128,","+        \"dim_conv\": 256,","+        \"dim_out\": 768,","+        \"sliding_window\": 32,","+        \"lfm\": {","+            \"model_type\": \"lfm2\",","+            \"vocab_size\": 2,","+            \"hidden_size\": 768,","+            \"intermediate_size\": 2560,","+            \"num_hidden_layers\": 17,","+            \"num_attention_heads\": 8,","+            \"num_key_value_heads\": 4,","+            \"layer_types\": LAYER_TYPES,","+            \"rope_parameters\": {\"rope_type\": \"default\", \"rope_theta\": 1e6},","+        },","+    },","+    \"depthformer\": {\"model_type\": \"lfm3\"},","+    \"codebooks\": 12,","+}","+TRANSFORMERS_NATIVE = {","+    \"text_config\": {\"model_type\": \"lfm3\"},","+    \"audio_encoder_config\": {","+        \"num_mel_bins\": 128,","+        \"conv_channels\": 256,","+        \"text_config\": {","+            \"model_type\": \"lfm3\",","+            \"vocab_size\": 2,","+            \"hidden_size\": 768,","+            \"intermediate_size\": 1792,","+            \"num_hidden_layers\": 17,","+            \"num_attention_heads\": 8,","+            \"num_key_value_heads\": 4,","+            \"head_dim\": 96,","+            \"sliding_window\": 32,","+            \"use_attention_gate\": False,","+            \"use_sandwich_norm\": False,","+            \"layer_types\": [","+                \"sliding_attention\" if t == \"full_attention\" else t for t in LAYER_TYPES","+            ],","+            \"rope_parameters\": {","+                \"sliding_attention\": {\"rope_type\": \"default\", \"rope_theta\": 1e6}","+            },","+        },","+    },","+    \"audio_token_id\": 125031,","+}","+","+","+@pytest.mark.parametrize(\"layout\", [TRAINING_EXPORT, TRANSFORMERS_NATIVE])","+def test_config_layouts(layout):","+    config = Lfm3AudioConfig(**layout)","+    encoder = config.audio_encoder_config","+    assert config.audio_token_id == 125031","+    assert config.text_config.model_type == \"lfm3\"","+    assert (encoder.num_mel_bins, encoder.text_config.hidden_size) == (128, 768)","+    assert encoder.sliding_window == 32","+    backbone = encoder.text_config","+    assert backbone.model_type == \"lfm2\"","+    assert backbone.layer_types == LAYER_TYPES","+    assert backbone.rope_parameters[\"rope_theta\"] == 1e6","+    assert backbone.block_auto_adjust_ff_dim == (layout is TRAINING_EXPORT)","+    restored = Lfm3AudioConfig(**config.to_dict())","+    assert restored.audio_encoder_config.to_dict() == encoder.to_dict()","+","+","+@pytest.mark.parametrize(","+    (\"num_samples\", \"num_frames\", \"num_tokens\"),","+    [(1, 1, 1), (400, 1, 1), (401, 2, 1), (16000, 99, 13), (16160, 100, 13)],","+)","+def test_feature_extractor_lengths(num_samples, num_frames, num_tokens):","+    extractor = Lfm3AudioFeatureExtractor()","+    features = extractor(np.zeros(num_samples, dtype=np.float32))","+    assert features[\"input_features\"].shape == (1, 128, num_frames)","+    assert extractor.num_frames(num_samples) == num_frames","+    assert extractor.num_encoder_tokens(num_frames) == num_tokens"],"additions":89,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -1086,6 +1086,7 @@ def check_available_online(","     \"Lfm2VlForConditionalGeneration\": _HfExamplesInfo(","         \"LiquidAI/LFM2-VL-450M\",","     ),","+    \"Lfm3AudioForConditionalGeneration\": _HfExamplesInfo(\"LiquidAI/LFM3-Audio-2B\"),","     \"Lfm3VlForConditionalGeneration\": _HfExamplesInfo(\"LiquidAI/LFM3-VL-2B\"),","     \"Llama4ForConditionalGeneration\": _HfExamplesInfo(","         \"meta-llama/Llama-4-Scout-17B-16E-Instruct\","],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/lfm3_audio.py","lines":["@@ -0,0 +1,411 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Inference-only LFM3-Audio model: speech in, text out.","+","+The speech output head (codebook embedding, depth decoder) is not served and its","+weights are skipped on load.","+\"\"\"","+","+import copy","+from collections.abc import Iterable, Mapping, Sequence","+from typing import Annotated, Literal, TypeAlias","+","+import torch","+from torch import nn","+from transformers import BatchFeature, Lfm2Model","+","+from vllm.config import VllmConfig","+from vllm.config.multimodal import MultiModalDummyOptions","+from vllm.inputs import MultiModalDataDict","+from vllm.model_executor.layers.linear import ReplicatedLinear","+from vllm.model_executor.layers.mamba.mamba_utils import (","+    MambaStateCopyFunc,","+    MambaStateCopyFuncCalculator,","+)","+from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.inputs import MultiModalFieldConfig, MultiModalKwargsItems","+from vllm.multimodal.parse import MultiModalDataItems, MultiModalDataParser","+from vllm.multimodal.processing import (","+    BaseDummyInputsBuilder,","+    BaseMultiModalProcessor,","+    BaseProcessingInfo,","+    PromptReplacement,","+    PromptUpdate,","+)","+from vllm.sequence import IntermediateTensors","+from vllm.transformers_utils.configs.lfm3_audio import (","+    Lfm3AudioConfig,","+    Lfm3AudioEncoderConfig,","+)","+from vllm.transformers_utils.processors.lfm3_audio import (","+    Lfm3AudioFeatureExtractor,","+    Lfm3AudioProcessor,","+)","+from vllm.utils.tensor_schema import TensorSchema, TensorShape","+","+from .interfaces import (","+    HasInnerState,","+    IsHybrid,","+    MultiModalEmbeddings,","+    SupportsMultiModal,","+    SupportsPP,","+)","+from .lfm3 import _short_conv_state_dtype, _short_conv_state_shape","+from .utils import (","+    AutoWeightsLoader,","+    WeightsMapper,","+    init_vllm_registered_model,","+    maybe_prefix,","+)","+","+# Bounds the profiling run and the encoder cache (one token per 80 ms); the","+# encoder itself is causal with a bounded window, so any length runs.","+MAX_AUDIO_SECONDS = 600","+","+","+class Lfm3AudioFeatureInputs(TensorSchema):","+    \"\"\"Dimensions:","+    - na: Number of audios","+    - nmb: Number of mel bins","+    - nf: Number of spectrogram frames","+    \"\"\"","+","+    type: Literal[\"audio_features\"]","+    input_features: Annotated[","+        torch.Tensor | list[torch.Tensor],","+        TensorShape(\"na\", \"nmb\", \"nf\", dynamic_dims={\"nf\"}),","+    ]","+","+","+class Lfm3AudioEmbeddingInputs(TensorSchema):","+    \"\"\"Dimensions:","+    - na: Number of audios","+    - nt: Number of audio tokens","+    - hs: Hidden size of the language model","+    \"\"\"","+","+    type: Literal[\"audio_embeds\"]","+    audio_embeds: Annotated[","+        torch.Tensor | list[torch.Tensor],","+        TensorShape(\"na\", \"nt\", \"hs\", dynamic_dims={\"nt\"}),","+    ]","+","+","+Lfm3AudioInputs: TypeAlias = Lfm3AudioFeatureInputs | Lfm3AudioEmbeddingInputs","+","+","+def split_audio_features(processed_data: BatchFeature) -> BatchFeature:","+    \"\"\"Keeps each clip's own frames: the features are padded to the longest clip","+    of the call, so cached and freshly processed items would differ.\"\"\"","+    if (masks := processed_data.pop(\"feature_attention_mask\", None)) is not None:","+        processed_data[\"input_features\"] = [","+            features[..., :length]","+            for features, length in zip(","+                processed_data[\"input_features\"], masks.sum(-1).tolist()","+            )","+        ]","+    return processed_data","+","+","+def suppress_speech_mode(","+    config: Lfm3AudioConfig, logits: torch.Tensor | None","+) -> torch.Tensor | None:","+    # These tokens switch generation to speech, whose output head is not served.","+    if logits is not None:","+        logits[..., config.audio_start_token_id] = float(\"-inf\")","+        logits[..., config.mixed_start_token_id] = float(\"-inf\")","+    return logits","+","+","+class Lfm3AudioDownsampler(nn.Module):","+    \"\"\"Three stride-2 convolutions over the (mel, time) plane: 128 mel bins and","+    8 frames become one vector.\"\"\"","+","+    def __init__(self, config: Lfm3AudioEncoderConfig) -> None:","+        super().__init__()","+        channels = config.conv_channels","+        conv = {\"kernel_size\": 3, \"stride\": 2, \"padding\": 1}","+        self.conv_in = nn.Conv2d(1, channels, **conv)","+        self.conv_mid = nn.Conv2d(channels, channels, groups=channels, **conv)","+        self.lin_mid = nn.Conv2d(channels, channels, kernel_size=1)","+        self.conv_end = nn.Conv2d(channels, channels, groups=channels, **conv)","+        self.lin_end = nn.Conv2d(channels, channels, kernel_size=1)","+        self.lin_out = nn.Conv1d(","+            config.num_mel_bins * channels // 8,","+            config.text_config.hidden_size,","+            kernel_size=1,","+        )","+        self.act = nn.SiLU()","+","+    def forward(self, input_features: torch.Tensor) -> torch.Tensor:","+        hidden_states = self.act(self.conv_in(input_features.unsqueeze(1)))","+        hidden_states = self.act(self.lin_mid(self.conv_mid(hidden_states)))","+        hidden_states = self.act(self.lin_end(self.conv_end(hidden_states)))","+        return self.lin_out(hidden_states.flatten(1, 2)).transpose(1, 2)","+","+","+class Lfm3AudioEncoder(nn.Module):","+    def __init__(self, config: Lfm3AudioEncoderConfig) -> None:","+        super().__init__()","+        self.sliding_window = config.sliding_window","+        self.downsample = Lfm3AudioDownsampler(config)","+        lfm_config = copy.deepcopy(config.text_config)","+        lfm_config._attn_implementation = \"sdpa\"","+        self.lfm = Lfm2Model(lfm_config)","+        # The encoder consumes spectrogram features only","+        self.lfm.embed_tokens = None","+","+    def forward(self, input_features: torch.Tensor) -> torch.Tensor:","+        hidden_states = self.downsample(input_features)","+        positions = torch.arange(hidden_states.shape[1], device=hidden_states.device)","+        distance = positions[:, None] - positions[None, :]","+        mask = (distance >= 0) & (distance < self.sliding_window)","+        return self.lfm(","+            inputs_embeds=hidden_states,","+            attention_mask={\"full_attention\": mask[None, None], \"conv\": None},","+            use_cache=False,","+        ).last_hidden_state","+","+","+class Lfm3AudioProjector(nn.Module):","+    def __init__(self, config: Lfm3AudioConfig, prefix: str = \"\") -> None:","+        super().__init__()","+        in_features = config.audio_encoder_config.text_config.hidden_size","+        out_features = config.text_config.hidden_size","+        self.layer_norm = nn.LayerNorm(in_features)","+        self.linear_1 = ReplicatedLinear(","+            in_features,","+            out_features,","+            return_bias=False,","+            prefix=maybe_prefix(prefix, \"linear_1\"),","+        )","+        self.act = nn.GELU()","+        self.linear_2 = ReplicatedLinear(","+            out_features,","+            out_features,","+            return_bias=False,","+            prefix=maybe_prefix(prefix, \"linear_2\"),","+        )","+","+    def forward(self, audio_features: torch.Tensor) -> torch.Tensor:","+        hidden_states = self.linear_1(self.layer_norm(audio_features))","+        return self.linear_2(self.act(hidden_states))","+","+","+class Lfm3AudioProcessingInfo(BaseProcessingInfo):","+    def get_hf_config(self) -> Lfm3AudioConfig:","+        return self.ctx.get_hf_config(Lfm3AudioConfig)","+","+    def get_hf_processor(self, **kwargs: object) -> Lfm3AudioProcessor:","+        return self.ctx.get_hf_processor(Lfm3AudioProcessor, **kwargs)","+","+    def get_feature_extractor(self, **kwargs: object) -> Lfm3AudioFeatureExtractor:","+        return self.get_hf_processor(**kwargs).feature_extractor","+","+    def get_data_parser(self) -> MultiModalDataParser:","+        return MultiModalDataParser(","+            target_sr=self.get_feature_extractor().sampling_rate,","+            target_channels=1,","+            expected_hidden_size=self._get_expected_hidden_size(),","+            allow_missing_mm_embeddings=self.allow_missing_mm_embeddings,","+        )","+","+    def get_supported_mm_limits(self) -> Mapping[str, int | None]:","+        return {\"audio\": None}","+","+    def get_max_audio_samples(self) -> int:","+        return MAX_AUDIO_SECONDS * self.get_feature_extractor().sampling_rate","+","+    def get_mm_max_tokens_per_item(","+        self, seq_len: int, mm_counts: Mapping[str, int] | None = None","+    ) -> Mapping[str, int]:","+        extractor = self.get_feature_extractor()","+        num_frames = extractor.num_frames(self.get_max_audio_samples())","+        return {\"audio\": extractor.num_encoder_tokens(num_frames)}","+","+","+class Lfm3AudioDummyInputsBuilder(BaseDummyInputsBuilder[Lfm3AudioProcessingInfo]):","+    def get_dummy_text(self, mm_counts: Mapping[str, int]) -> str:","+        return self.info.get_hf_processor().audio_token * mm_counts.get(\"audio\", 0)","+","+    def get_dummy_mm_data(","+        self,","+        seq_len: int,","+        mm_counts: Mapping[str, int],","+        mm_options: MultiModalDummyOptions,","+    ) -> MultiModalDataDict:","+        return {","+            \"audio\": self._get_dummy_audios(","+                length=self.info.get_max_audio_samples(),","+                num_audios=mm_counts.get(\"audio\", 0),","+                overrides=mm_options.get(\"audio\"),","+            )","+        }","+","+","+class Lfm3AudioMultiModalProcessor(BaseMultiModalProcessor[Lfm3AudioProcessingInfo]):","+    def _postprocess_hf_mm_data(","+        self,","+        mm_inputs: Mapping[str, object],","+        hf_processor_mm_kwargs: Mapping[str, object],","+        processed_data: BatchFeature,","+    ) -> BatchFeature:","+        return split_audio_features(processed_data)","+","+    def _get_mm_fields_config(","+        self, hf_inputs: BatchFeature, hf_processor_mm_kwargs: Mapping[str, object]","+    ) -> Mapping[str, MultiModalFieldConfig]:","+        return {","+            \"input_features\": MultiModalFieldConfig.batched(\"audio\"),","+            \"audio_embeds\": MultiModalFieldConfig.batched(\"audio\"),","+        }","+","+    def _get_prompt_updates(","+        self,","+        mm_items: MultiModalDataItems,","+        hf_processor_mm_kwargs: Mapping[str, object],","+        out_mm_kwargs: MultiModalKwargsItems,","+    ) -> Sequence[PromptUpdate]:","+        processor = self.info.get_hf_processor(**hf_processor_mm_kwargs)","+        extractor = processor.feature_extractor","+","+        def audio_tokens(item_idx: int) -> list[int]:","+            item = out_mm_kwargs[\"audio\"][item_idx]","+            if (embeds := item.get(\"audio_embeds\")) is not None:","+                count = len(embeds.data)","+            else:","+                features = item[\"input_features\"].data","+                assert isinstance(features, torch.Tensor)","+                count = extractor.num_encoder_tokens(features.shape[-1])","+            return [processor.audio_token_id] * count","+","+        return [PromptReplacement(\"audio\", [processor.audio_token_id], audio_tokens)]","+","+","+@MULTIMODAL_REGISTRY.register_processor(","+    Lfm3AudioMultiModalProcessor,","+    info=Lfm3AudioProcessingInfo,","+    dummy_inputs=Lfm3AudioDummyInputsBuilder,","+)","+class Lfm3AudioForConditionalGeneration(","+    nn.Module, HasInnerState, IsHybrid, SupportsMultiModal, SupportsPP","+):","+    hf_to_vllm_mapper = WeightsMapper(","+        orig_to_new_prefix={","+            # Training-export layout of the hub checkpoints","+            \"lfm.model.\": \"language_model.model.\",","+            \"lfm.lm_head.\": \"language_model.lm_head.\",","+            \"encoder.lfm.lfm.\": \"audio_encoder.lfm.\",","+            \"encoder.downsample.\": \"audio_encoder.downsample.\",","+            \"mlp.model.0.\": \"audio_projector.layer_norm.\",","+            \"mlp.model.1.\": \"audio_projector.linear_1.\",","+            \"mlp.model.3.\": \"audio_projector.linear_2.\",","+            # Transformers layout","+            \"model.language_model.\": \"language_model.model.\",","+            \"model.audio_encoder.\": \"audio_encoder.\",","+            \"model.audio_projector.\": \"audio_projector.\",","+            \"lm_head.\": \"language_model.lm_head.\",","+            # Speech output head","+            \"codebook_embedding.\": None,","+            \"depth_linear.\": None,","+            \"depth_embeddings.\": None,","+            \"depthformer.\": None,","+            \"mask_embedding\": None,","+            \"model.codebook_embedding.\": None,","+            \"model.depth_decoder.\": None,","+        }","+    )","+","+    @classmethod","+    def get_placeholder_str(cls, modality: str, i: int) -> str | None:","+        if modality.startswith(\"audio\"):","+            return \"<|audio|>\"","+        raise ValueError(\"Only audio modality is supported\")","+","+    @classmethod","+    def get_mamba_state_dtype_from_config(","+        cls, vllm_config: VllmConfig","+    ) -> tuple[torch.dtype, ...]:","+        return _short_conv_state_dtype(vllm_config)","+","+    @classmethod","+    def get_mamba_state_shape_from_config(","+        cls, vllm_config: VllmConfig","+    ) -> tuple[tuple[int, int]]:","+        return _short_conv_state_shape(","+            vllm_config, vllm_config.model_config.hf_config.text_config","+        )","+","+    @classmethod","+    def get_mamba_state_copy_func(cls) -> tuple[MambaStateCopyFunc]:","+        return MambaStateCopyFuncCalculator.short_conv_state_copy_func()","+","+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\") -> None:","+        super().__init__()","+        config: Lfm3AudioConfig = vllm_config.model_config.hf_config","+        self.config = config","+        with self._mark_tower_model(vllm_config, \"audio\"):","+            self.audio_encoder = Lfm3AudioEncoder(config.audio_encoder_config)","+            self.audio_projector = Lfm3AudioProjector(","+                config, prefix=maybe_prefix(prefix, \"audio_projector\")","+            )","+        with self._mark_language_model(vllm_config):","+            self.language_model = init_vllm_registered_model(","+                vllm_config=vllm_config,","+                hf_config=config.text_config,","+                prefix=maybe_prefix(prefix, \"language_model\"),","+                architectures=[\"Lfm3ForCausalLM\"],","+            )","+        self.make_empty_intermediate_tensors = (","+            self.language_model.make_empty_intermediate_tensors","+        )","+","+    def _parse_and_validate_audio_input(","+        self, **kwargs: object","+    ) -> Lfm3AudioInputs | None:","+        input_features = kwargs.pop(\"input_features\", None)","+        audio_embeds = kwargs.pop(\"audio_embeds\", None)","+        if audio_embeds is not None:","+            return Lfm3AudioEmbeddingInputs(","+                type=\"audio_embeds\", audio_embeds=audio_embeds","+            )","+        if input_features is not None:","+            return Lfm3AudioFeatureInputs(","+                type=\"audio_features\", input_features=input_features","+            )","+        return None","+","+    def embed_multimodal(self, **kwargs: object) -> MultiModalEmbeddings:","+        audio_input = self._parse_and_validate_audio_input(**kwargs)","+        if audio_input is None:","+            return []","+        if audio_input[\"type\"] == \"audio_embeds\":","+            return list(audio_input[\"audio_embeds\"])","+        dtype = self.audio_encoder.downsample.conv_in.weight.dtype","+        return [","+            self.audio_projector(self.audio_encoder(features[None].to(dtype))[0])","+            for features in audio_input[\"input_features\"]","+        ]","+","+    def forward(","+        self,","+        input_ids: torch.Tensor | None,","+        positions: torch.Tensor,","+        intermediate_tensors: IntermediateTensors | None = None,","+        inputs_embeds: torch.Tensor | None = None,","+        **kwargs: object,","+    ) -> torch.Tensor | IntermediateTensors:","+        if intermediate_tensors is not None:","+            inputs_embeds = None","+        return self.language_model(","+            input_ids, positions, intermediate_tensors, inputs_embeds","+        )","+","+    def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor | None:","+        return suppress_speech_mode(","+            self.config, self.language_model.compute_logits(hidden_states)","+        )","+","+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:","+        loader = AutoWeightsLoader(self)","+        return loader.load_weights(weights, mapper=self.hf_to_vllm_mapper)"],"additions":411,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/registry.py","lines":["@@ -499,6 +499,10 @@","         \"LightOnOCRForConditionalGeneration\",","     ),","     \"Lfm2VlForConditionalGeneration\": (\"lfm2_vl\", \"Lfm2VLForConditionalGeneration\"),","+    \"Lfm3AudioForConditionalGeneration\": (","+        \"lfm3_audio\",","+        \"Lfm3AudioForConditionalGeneration\",","+    ),","     \"Lfm3VlForConditionalGeneration\": (\"lfm3_vl\", \"Lfm3VlForConditionalGeneration\"),","     \"Llama4ForConditionalGeneration\": (\"mllama4\", \"Llama4ForConditionalGeneration\"),","     \"Llama_Nemotron_Nano_VL\": (\"nemotron_vl\", \"LlamaNemotronVLChatModel\"),"],"additions":4,"deletions":0,"truncated":false},{"path":"vllm/transformers_utils/config.py","lines":["@@ -150,6 +150,7 @@ def __getitem__(self, key):","     muse_spark=\"MuseSparkConfig\",","     kimi_k3=\"KimiK3Config\",","     lfm3=\"Lfm3Config\",","+    lfm3_audio=\"Lfm3AudioConfig\",","     lfm3_vl=\"Lfm3VlConfig\",","     RefinedWeb=\"RWConfig\",  # For tiiuae/falcon-40b(-instruct)"," 