64),","             nonce: 6690,","             code: Default::default(),","+            ..Default::default()","         }","     );"," ","@@ -4430,6 +4432,7 @@ async fn test_fork_get_account_info() {","             balance: U256::from(14352720829244098514u64),","             nonce: 6690,","             code: Default::default(),","+            ..Default::default()","         }","     );"," }"],"additions":3,"deletions":0,"truncated":false},{"path":"crates/anvil/tests/it/fork_bal.rs","lines":["@@ -242,6 +242,7 @@ async fn fork_bal_preserves_genesis_funding_and_loaded_state_overrides() {","                 nonce: 3,","                 balance: U256::from(40),","                 code: bytes!(\"00\"),","+                extension: Default::default(),","                 storage: [(B256::ZERO, B256::with_last_byte(50))].into(),","             },","         )]"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/anvil/tests/it/tempo.rs","lines":["@@ -101,6 +101,7 @@ use tempo_precompiles::{"," };"," use tempo_primitives::{","     AASigned, TempoHeader, TempoSignature, TempoTransaction,","+    account::encode_config_commitment,","     transaction::{","         CONFIGURABLE_ACCOUNT_UPGRADE_DOMAIN, Call, ConfigurableAccountConfig,","         ConfigurableAccountOwner, ConfigurableAccountSignature, FEE_PAYER_SIGNATURE_MARKER,","@@ -3791,6 +3792,9 @@ const CONFIGURABLE_ACCOUNT_GAS: u64 = 5_000_000;"," const VIEM_CA_ACCOUNT: Address = address!(\"0xca35691e6caba70cc9ac71a436d97c20f8313455\");"," const VIEM_CA_COMMITMENT_V0: B256 =","     b256!(\"0xe8dcac29bbf08814f137469ec65486e7ba3a64802fd8e6459f5d976eaa7d59f3\");","+/// The account extension that stores `VIEM_CA_COMMITMENT_V0`: a format tag, then the commitment.","+const VIEM_CA_EXTENSION: Bytes =","+    bytes!(\"00e8dcac29bbf08814f137469ec65486e7ba3a64802fd8e6459f5d976eaa7d59f3\");"," /// The commitment after `updateConfig` to threshold one over the keys `0x22..22` and `0x44..44`."," const VIEM_CA_COMMITMENT_V1: B256 =","     b256!(\"0x842aa9620d9c6703c9f0090711eaaf70008fcd2c28ecb9bbfa94c2571717718f\");","@@ -3983,6 +3987,7 @@ async fn test_tempo_configurable_account_matches_viem_reference() {","     let account = TestConfigurableAccount::fixture();","     assert_eq!(account.address, VIEM_CA_ACCOUNT);","     assert_eq!(account.config.commitment().unwrap(), VIEM_CA_COMMITMENT_V0);","+    assert_eq!(encode_config_commitment(VIEM_CA_COMMITMENT_V0), VIEM_CA_EXTENSION);"," ","     let inner = B256::repeat_byte(0xab);","     assert_eq!(configurable_account_digest(inner, account.address, 0), VIEM_CA_DIGEST_V0);","@@ -4142,6 +4147,111 @@ async fn test_tempo_t14_configurable_account_lifecycle() {","     assert_eq!(receipt.from, root.address());"," }"," ","+/// Registers the fixture configurable account on a T14 node with its first `0x05` transaction, and","+/// asserts that the node reports its configuration commitment in the account extension.","+async fn register_fixture_account(provider: &RetryProvider) -> TestConfigurableAccount {","+    let account = TestConfigurableAccount::fixture();","+    provider","+        .raw_request::<_, ()>(","+            \"anvil_dealTIP20\".into(),","+            (account.address, ALPHA_USD, U256::from(1_000_000_000_000u64)),","+        )","+        .await","+        .unwrap();","+    let noop = Call {","+        to: TxKind::Call(Address::repeat_byte(0x73)),","+        value: U256::ZERO,","+        input: Bytes::new(),","+    };","+    let tx = configurable_account_tx(provider, 0, vec![noop]).await;","+    let signature = account.sign(&tx).await;","+    let receipt = send_signed_tempo_tx(provider, tx, signature).await.unwrap();","+    assert!(receipt.status(), \"registration should succeed: {receipt:?}\");","+    assert_eq!(config_commitment(provider, account.address).await, VIEM_CA_COMMITMENT_V0);","+    for method in [\"eth_getAccount\", \"eth_getAccountInfo\"] {","+        assert_eq!(account_extension(provider, method, account.address).await, VIEM_CA_EXTENSION);","+    }","+    account","+}","+","+/// Returns the `extension` that `method` reports for `account`.","+async fn account_extension(provider: &RetryProvider, method: &str, account: Address) -> Bytes {","+    let info = provider","+        .raw_request::<_, serde_json::Value>(method.to_string().into(), (account, \"latest\"))","+        .await","+        .unwrap();","+    serde_json::from_value(info[\"extension\"].clone()).unwrap_or_default()","+}","+","+/// Asserts that `provider`'s node holds the registered fixture `account` with its configuration","+/// commitment, which the account extension stores, and that the account updates its configuration","+/// and authorizes later `0x05` transactions with it.","+async fn assert_registered_account_continues(","+    provider: &RetryProvider,","+    account: &TestConfigurableAccount,","+) {","+    assert_eq!(config_commitment(provider, account.address).await, VIEM_CA_COMMITMENT_V0);","+    assert_eq!(","+        account_extension(provider, \"eth_getAccountInfo\", account.address).await,","+        VIEM_CA_EXTENSION","+    );","+","+    let (update, rotated) =","+        account.update(&[seeded_key(0x22), seeded_key(0x44)], vec![seeded_key(0x44)]);","+    let tx = configurable_account_tx(provider, 1, vec![update]).await;","+    let signature = account.sign(&tx).await;","+    let receipt = send_signed_tempo_tx(provider, tx, signature).await.unwrap();","+    assert!(receipt.status(), \"updateConfig should succeed: {receipt:?}\");","+    assert_eq!(config_commitment(provider, account.address).await, VIEM_CA_COMMITMENT_V1);","+","+    let noop = Call {","+        to: TxKind::Call(Address::repeat_byte(0x73)),","+        value: U256::ZERO,","+        input: Bytes::new(),","+    };","+    let tx = configurable_account_tx(provider, 2, vec![noop]).await;","+    let signature = rotated.sign(&tx).await;","+    let receipt = send_signed_tempo_tx(provider, tx, signature).await.unwrap();","+    assert!(receipt.status(), \"the rotated owner should authorize: {receipt:?}\");","+}","+","+/// A fork of a T14 node reads the account extension, so a configurable account registered before","+/// the fork block keeps its configuration commitment on the fork.","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_tempo_t14_configurable_account_fork_keeps_config_commitment() {","+    let t14 = || NodeConfig::test_tempo().with_hardfork(Some(TempoHardfork::T14.into()));","+    let (_source_api, source_handle) = spawn(t14()).await;","+    let account = register_fixture_account(&source_handle.http_provider()).await;","+","+    let (_api, handle) = spawn(t14().with_eth_rpc_url(Some(source_handle.http_endpoint()))).await;","+    assert_registered_account_continues(&handle.http_provider(), &account).await;","+}","+","+/// State dumps keep the account extension, so a configurable account keeps its configuration","+/// commitment after `anvil_dumpState` and `anvil_loadState`, at the latest block as well as in","+/// preserved historical states.","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_tempo_t14_configurable_account_dump_load_keeps_config_commitment() {","+    let t14 = || NodeConfig::test_tempo().with_hardfork(Some(TempoHardfork::T14.into()));","+    let (source_api, source_handle) = spawn(t14()).await;","+    let account = register_fixture_account(&source_handle.http_provider()).await;","+    let registered = source_api.block_number().unwrap().to::<u64>();","+    source_api.mine_one().await.unwrap();","+    let state = source_api.anvil_dump_state(Some(true)).await.unwrap();","+","+    let (api, handle) = spawn(t14()).await;","+    assert!(api.anvil_load_state(state).await.unwrap());","+    let provider = handle.http_provider();","+    let commitment = IConfigurableAccount::new(CONFIGURABLE_ACCOUNT_ADDRESS, &provider)","+        .getConfigCommitment(account.address)","+        .block(BlockId::number(registered))","+        .call()","+        .await","+        .unwrap();","+    assert_eq!(commitment, VIEM_CA_COMMITMENT_V0);","+    assert_registered_account_continues(&provider, &account).await;","+}","+"," /// From T14 a channel's voucher signer must not be a retired root key: `open` and a nonzero"," /// `topUp` revert with `RootKeyRetired` for a configurable account and for an upgraded account,"," /// while a zero `topUp` stays allowed."],"additions":110,"deletions":0,"truncated":false},{"path":"crates/cast/tests/cli/tempo.rs","lines":["@@ -1838,7 +1838,8 @@ async fn t14_tempo_tx(","     }"," }"," ","-/// Returns the approval of every owner of `config` over `tx` for the configurable `account`.","+/// Returns the approval of every owner of `config` whose key is in `owners` over `tx` for the","+/// configurable `account`."," async fn configurable_account_signature(","     account: Address,","     config: &ConfigurableAccountConfig,","@@ -1848,18 +1849,35 @@ async fn configurable_account_signature(","     let digest = configurable_account_digest(tx.signature_hash(), account, config.version);","     let mut signatures = Vec::new();","     for owner in &config.owners {","-        let key = owners.iter().find(|key| key.address() == owner.owner).unwrap();","-        signatures.push(PrimitiveSignature::Secp256k1(key.sign_hash(&digest).await.unwrap()));","+        if let Some(key) = owners.iter().find(|key| key.address() == owner.owner) {","+            signatures.push(PrimitiveSignature::Secp256k1(key.sign_hash(&digest).await.unwrap()));","+        }","     }","     TempoSignature::ConfigurableAccount(","         ConfigurableAccountSignature::try_new(account, config.clone(), signatures).unwrap(),","     )"," }"," ","-/// `cast run` forks a T14 node at the parent of the `0x05` transaction that registers a","-/// configurable account, replays the block up to it, and reproduces the status and gas the node","-/// charged. No public","-/// Tempo network schedules T14 yet, so the node is a local Anvil T14 node.","+/// Returns `config`'s owners as `IConfigurableAccount` encodes them.","+fn abi_owners(","+    config: &ConfigurableAccountConfig,","+) -> Vec<IConfigurableAccount::ConfigurableAccountOwner> {","+    config","+        .owners","+        .iter()","+        .map(|owner| IConfigurableAccount::ConfigurableAccountOwner {","+            owner: owner.owner,","+            weight: owner.weight,","+        })","+        .collect()","+}","+","+/// `cast run` forks a T14 node at the parent of each `0x05` transaction of a configurable account,","+/// replays the block up to it, and reproduces the status and gas the node charged: the","+/// transaction that registers the account, its `updateConfig`, and a later transaction that the","+/// updated owners authorize. The last two read the configuration commitment, which the account","+/// extension stores, from the fork. No public Tempo network schedules T14 yet, so the node is a","+/// local Anvil T14 node."," #[casttest]"," async fn tempo_t14_configurable_account_run_fork_replay_matches_node(cmd: _) {","     let (api, handle) =","@@ -1927,10 +1945,65 @@ async fn tempo_t14_configurable_account_run_fork_replay_matches_node(cmd: _) {","     assert_eq!(registered.block_number, primitive.block_number);","     assert_eq!(registered.transaction_index, Some(1));"," ","-    // Replay forks at the parent block, where the account is still unregistered. Accounts that","-    // registered before the fork block cannot be replayed yet: the fork database does not carry","-    // the account extension that holds their configuration commitment.","-    let hashes = [(registration, true)];","+    // The registered account rotates its owners to threshold one over keys `0x22..22` and","+    // `0x44..44`, then key `0x44..44` alone authorizes a transaction, each in a later block.","+    let keys =","+        [0x22, 0x44].map(|byte| PrivateKeySigner::from_bytes(&B256::repeat_byte(byte)).unwrap());","+    let mut rotated = ConfigurableAccountConfig {","+        salt: config.salt,","+        version: 1,","+        threshold: 1,","+        owners: keys","+            .iter()","+            .map(|key| ConfigurableAccountOwner { owner: key.address(), weight: 1 })","+            .collect(),","+    };","+    rotated.owners.sort_by_key(|owner| owner.owner);","+    let update = IConfigurableAccount::updateConfigCall {","+        current: IConfigurableAccount::ConfigurableAccountConfig {","+            salt: config.salt,","+            version: config.version,","+            threshold: config.threshold,","+            owners: abi_owners(&config),","+        },","+        threshold: rotated.threshold,","+        owners: abi_owners(&rotated),","+    };","+    let tx = t14_tempo_tx(","+        &provider,","+        1,","+        vec![call(CONFIGURABLE_ACCOUNT_ADDRESS, update.abi_encode()), call(target, vec![])],","+    )","+    .await;","+    let signature = configurable_account_signature(account, &config, &owners, &tx).await;","+    let update = provider","+        .send_raw_transaction(&TempoTxEnvelope::AA(tx.into_signed(signature)).encoded_2718())","+        .await","+        .unwrap()","+        .get_receipt()","+        .await","+        .unwrap()","+        .transaction_hash();","+    let get_commitment = IConfigurableAccount::getConfigCommitmentCall { account }.abi_encode();","+    let tx = t14_tempo_tx(","+        &provider,","+        2,","+        vec![call(CONFIGURABLE_ACCOUNT_ADDRESS, get_commitment), call(target, vec![])],","+    )","+    .await;","+    let signature = configurable_account_signature(account, &rotated, &keys[1..], &tx).await;","+    let rotated_tx = provider","+        .send_raw_transaction(&TempoTxEnvelope::AA(tx.into_signed(signature)).encoded_2718())","+        .await","+        .unwrap()","+        .get_receipt()","+        .await","+        .unwrap()","+        .transaction_hash();","+","+    // Replay forks at each transaction's parent block. The account is unregistered at the","+    // registration's parent and registered with its commitment at the others'.","+    let hashes = [(registration, true), (update, true), (rotated_tx, true)];","     for (hash, succeeds) in hashes {","         let receipt = provider.get_transaction_receipt(hash).await.unwrap().unwrap();","         assert_eq!(receipt.status(), succeeds, \"{receipt:?}\");"],"additions":84,"deletions":11,"truncated":false},{"path":"crates/evm/core/src/backend/mod.rs","lines":["@@ -39,7 +39,7 @@ use crate::{","         apply_chain_specific_tx_replay_env_changes_for_chain, block_env_from_header,","     },"," };","-use alloy_chains::Chain;","+use alloy_chains::{Chain, NamedChain};"," use alloy_consensus::{BlockHeader, Transaction as _, Typed2718, transaction::Recovered};"," use alloy_eips::BlockNumHash;"," use alloy_genesis::GenesisAccount;","@@ -1638,13 +1638,22 @@ fn is_contract(account: Option<AccountInfo>) -> bool {"," /// Returns the account-loading policy required by a fork source."," ///"," /// A recognized source chain ID is authoritative. The endpoint's execution profile is only a","-/// source hint for custom chain IDs, where the chain ID cannot identify the RPC semantics.","+/// source hint for custom chain IDs, where the chain ID cannot identify the RPC semantics, and for","+/// local development chain IDs, which nodes of any family use, such as Anvil and Tempo dev nodes.","+/// A dev node of another family that reports no Anvil node info therefore needs an execution","+/// profile that matches it: selecting Tempo for it requires `eth_getAccountInfo`."," pub fn account_fetch_policy_for_source(","     source_chain_id: ChainId,","     network_profile: NetworkConfigs,"," ) -> AccountFetchPolicy {","     let source_chain = Chain::from_id(source_chain_id);","-    let is_tempo =","-        source_chain.is_tempo() || (source_chain.named().is_none() && network_profile.is_tempo());","-    if is_tempo { AccountFetchPolicy::RequireAccountInfo } else { AccountFetchPolicy::Auto }","+    let identifies_family = source_chain","+        .named