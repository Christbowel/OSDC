val.WeekdayRange{","+\t\t\t\t{InclusiveRange: timeinterval.InclusiveRange{Begin: 1, End: 2}},","+\t\t\t\t{InclusiveRange: timeinterval.InclusiveRange{Begin: 5, End: 6}},","+\t\t\t},","+\t\t\tDaysOfMonth: []timeinterval.DayOfMonthRange{","+\t\t\t\t{InclusiveRange: timeinterval.InclusiveRange{Begin: 1, End: 10}},","+\t\t\t\t{InclusiveRange: timeinterval.InclusiveRange{Begin: 20, End: 25}},","+\t\t\t},","+\t\t\tMonths: []timeinterval.MonthRange{","+\t\t\t\t{InclusiveRange: timeinterval.InclusiveRange{Begin: 1, End: 3}},","+\t\t\t},","+\t\t\tYears: []timeinterval.YearRange{","+\t\t\t\t{InclusiveRange: timeinterval.InclusiveRange{Begin: 2020, End: 2022}},","+\t\t\t},","+\t\t\tLocation: &timeinterval.Location{Location: time.UTC},","+\t\t},","+\t}","+}","+","+func TestMuteTimeIntervalModelRoundTrip(t *testing.T) {","+\tt.Run(\"roundtrip is lossless\", func(t *testing.T) {","+\t\tcases := []struct {","+\t\t\tname string","+\t\t\tin   definitions.MuteTimeInterval","+\t\t}{","+\t\t\t{","+\t\t\t\tname: \"fully populated\",","+\t\t\t\tin: definitions.MuteTimeInterval{","+\t\t\t\t\tUID: \"some-stable-uid\",","+\t\t\t\t\tMuteTimeInterval: amconfig.MuteTimeInterval{","+\t\t\t\t\t\tName:          \"my-interval\",","+\t\t\t\t\t\tTimeIntervals: fullTimeIntervals(),","+\t\t\t\t\t},","+\t\t\t\t\tVersion:    \"v-12345\",","+\t\t\t\t\tProvenance: definitions.Provenance(models.ProvenanceAPI),","+\t\t\t\t},","+\t\t\t},","+\t\t\t{","+\t\t\t\tname: \"zero value\",","+\t\t\t\tin:   definitions.MuteTimeInterval{},","+\t\t\t},","+\t\t\t{","+\t\t\t\tname: \"nil time intervals\",","+\t\t\t\tin: definitions.MuteTimeInterval{","+\t\t\t\t\tMuteTimeInterval: amconfig.MuteTimeInterval{Name: \"empty-interval\"},","+\t\t\t\t\tProvenance:       definitions.Provenance(models.ProvenanceFile),","+\t\t\t\t},","+\t\t\t},","+\t\t}","+","+\t\tfor _, tc := range cases {","+\t\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\t\tout := ModelToMuteTimeInterval(MuteTimeIntervalToModel(tc.in))","+\t\t\t\trequire.Equal(t, tc.in, out)","+\t\t\t})","+\t\t}","+\t})","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"pkg/services/ngalert/api/test-data/policy-exports/testing.go","lines":["@@ -38,15 +38,6 @@ var Config = func() *v1.AMConfigV1 {"," \t\tAlertmanagerConfig: v1.PostableApiAlertingConfig{"," \t\t\tConfig: v1.Config{"," \t\t\t\tRoute: Legacy(),","-\t\t\t\t// Add time interval references to help tests avoid validation errors.","-\t\t\t\tTimeIntervals: []v1.TimeInterval{","-\t\t\t\t\t{Name: \"interval\"},","-\t\t\t\t\t{Name: \"active\"},","-\t\t\t\t\t{Name: \"Some interval\"},","-\t\t\t\t\t{Name: \"A provisioned interval\"},","-\t\t\t\t\t{Name: \"Some interval override\"},","-\t\t\t\t\t{Name: \"A provisioned interval override\"},","-\t\t\t\t},"," \t\t\t},"],"additions":0,"deletions":9,"truncated":false}],"additions":276,"deletions":126,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-08-13T09:12:12.608389+00:00"}