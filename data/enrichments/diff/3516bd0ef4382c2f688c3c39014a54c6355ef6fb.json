leService(disconnect: () => void): ILifecycleService {","+\t\tconst willShutdown = store.add(new Emitter<WillShutdownEvent>());","+\t\t// Register disconnection first, as the extension service may initialize before the contribution.","+\t\tstore.add(willShutdown.event(e => e.join(async () => disconnect(), {","+\t\t\tid: 'join.disconnectRemote', label: 'Disconnect', order: WillShutdownJoinerOrder.Last","+\t\t})));","+\t\treturn new class extends mock<ILifecycleService>() {","+\t\t\toverride readonly onWillShutdown = willShutdown.event;","+\t\t\toverride async shutdown(): Promise<void> {","+\t\t\t\tconst joiners: Promise<void>[] = [];","+\t\t\t\tconst lastJoiners: (() => Promise<void>)[] = [];","+\t\t\t\twillShutdown.fire({","+\t\t\t\t\treason: ShutdownReason.RELOAD,","+\t\t\t\t\ttoken: CancellationToken.None,","+\t\t\t\t\tjoin: (promise: Promise<void> | (() => Promise<void>), joiner: IWillShutdownEventJoiner) => {","+\t\t\t\t\t\tif (joiner.order === WillShutdownJoinerOrder.Last) {","+\t\t\t\t\t\t\tlastJoiners.push(typeof promise === 'function' ? promise : () => promise);","+\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\tjoiners.push(typeof promise === 'function' ? promise() : promise);","+\t\t\t\t\t\t}","+\t\t\t\t\t},","+\t\t\t\t\tjoiners: () => [],","+\t\t\t\t\tforce: () => { }","+\t\t\t\t});","+\t\t\t\tawait Promise.all(joiners);","+\t\t\t\tawait Promise.all(lastJoiners.map(join => join()));","+\t\t\t}","+\t\t};","+\t}","+","+\tfunction createInstanceService(backends: ITerminalBackend[], onDidRegisterBackend: Event<ITerminalBackend> = Event.None): ITerminalInstanceService {","+\t\treturn new class extends mock<ITerminalInstanceService>() {","+\t\t\toverride getRegisteredBackends(): IterableIterator<ITerminalBackend> { return backends.values(); }","+\t\t\toverride readonly onDidRegisterBackend = onDidRegisterBackend;","+\t\t};","+\t}","+","+\ttest('awaits cleanup on initial and late backends before disconnection', async () => {","+\t\tconst cleanup = new DeferredPromise<void>();","+\t\tconst calls: string[] = [];","+\t\tlet disconnected = false;","+\t\tconst lifecycleService = createLifecycleService(() => { disconnected = true; });","+\t\tconst makeBackend = (name: string): ITerminalBackend => new class extends mock<ITerminalBackend>() {","+\t\t\toverride uninstallAllAutoReplies(): Promise<void> {","+\t\t\t\tcalls.push(name);","+\t\t\t\treturn cleanup.p;","+\t\t\t}","+\t\t};","+\t\tconst didRegisterBackend = store.add(new Emitter<ITerminalBackend>());","+\t\tconst configurationService = new TestConfigurationService({ 'terminal.integrated': { autoReplies: {} } });","+\t\tstore.add(configurationService.onDidChangeConfigurationEmitter);","+\t\tconst contribution = store.add(new TerminalAutoRepliesContribution(configurationService, createInstanceService([makeBackend('local')], didRegisterBackend.event), lifecycleService));","+\t\tdidRegisterBackend.fire(makeBackend('remote'));","+","+\t\tconst shutdown = lifecycleService.shutdown();","+\t\tawait Promise.resolve();","+\t\tassert.deepStrictEqual({ calls, disconnected }, { calls: ['local', 'remote'], disconnected: false });","+\t\tawait cleanup.complete();","+\t\tawait shutdown;","+\t\tcontribution.dispose();","+\t\tassert.deepStrictEqual({ calls, disconnected }, { calls: ['local', 'remote'], disconnected: true });","+\t});","+","+\ttest('removes reloaded owners while preserving a live peer', () => runWithFakedTimers({ useFakeTimers: true }, async () => {","+\t\tconst activeOwners = new Set<string>(['live peer']);","+\t\tfor (let reload = 0; reload < 3; reload++) {","+\t\t\tlet disconnected = false;","+\t\t\tlet installCount = 0;","+\t\t\tconst lifecycleService = createLifecycleService(() => { disconnected = true; });","+\t\t\tconst backend = new class extends mock<ITerminalBackend>() {","+\t\t\t\toverride async installAutoReply(match: string, reply: string, ownerId: string): Promise<void> {","+\t\t\t\t\tinstallCount++;","+\t\t\t\t\tactiveOwners.add(ownerId);","+\t\t\t\t}","+\t\t\t\toverride async uninstallAllAutoReplies(ownerId: string): Promise<void> {","+\t\t\t\t\tawait timeout(0);","+\t\t\t\t\tassert.strictEqual(disconnected, false, 'cleanup must finish before IPC disconnects');","+\t\t\t\t\tactiveOwners.delete(ownerId);","+\t\t\t\t}","+\t\t\t};","+\t\t\tconst configurationService = new TestConfigurationService({ 'terminal.integrated': { autoReplies: { 'old prompt': 'old reply' } } });","+\t\t\tstore.add(configurationService.onDidChangeConfigurationEmitter);","+\t\t\tconst contribution = store.add(new TerminalAutoRepliesContribution(configurationService, createInstanceService([backend]), lifecycleService));","+\t\t\tassert.strictEqual(activeOwners.size, 2);","+\t\t\tconst shutdown = lifecycleService.shutdown();","+\t\t\t// A setting update during cleanup must not reinstall the departing owner's replies.","+\t\t\tconfigurationService.onDidChangeConfigurationEmitter.fire({","+\t\t\t\taffectsConfiguration: () => true, affectedKeys: new Set(), change: { keys: [], overrides: [] }, source: ConfigurationTarget.WORKSPACE","+\t\t\t});","+\t\t\tawait shutdown;","+\t\t\tcontribution.dispose();","+\t\t\tassert.deepStrictEqual({ owners: [...activeOwners], installCount }, { owners: ['live peer'], installCount: 1 });","+\t\t}","+\t}));","+});",""],"additions":117,"deletions":0,"truncated":false}],"additions":348,"deletions":47,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-31T14:35:45.343033+00:00"}