"incorrect metadata size in {filename}\"));","+    }","+    Ok(bytes)","+}","+","+fn metadata_index(","+    archive: &zip::ZipArchive<Cursor<&[u8]>>,","+    filename: &str,","+    kind: DistributionKind,","+) -> Result<usize, String> {","+    let mut found = None;","+    for (index, name) in archive.file_names().enumerate() {","+        let name = name.map_err(|err| err.to_string())?;","         if !is_metadata(&name, kind) {","             continue;","         }","-        if document.is_some() {","+        if found.replace(index).is_some() {","             return Err(format!(\"multiple metadata files in {filename}\"));","         }","         verify_metadata_directory(&name, filename, kind)?;","-        document = Some(read_metadata(entry)?);","     }","-    document.ok_or_else(|| {","-        format!(","-            \"{filename} has no {}\",","-            match kind {","-                DistributionKind::Wheel => \"dist-info METADATA\",","-                DistributionKind::Sdist => \"PKG-INFO\",","-            },","-        )","+    found.ok_or_else(|| {","+        let expected = match kind {","+            DistributionKind::Wheel => \"dist-info METADATA\",","+            DistributionKind::Sdist => \"PKG-INFO\",","+        };","+        format!(\"{filename} has no {expected}\")","     })"," }"," ","+fn validate_zip(","+    archive: &mut zip::ZipArchive<Cursor<&[u8]>>,","+    metadata_index: usize,","+    limit: u64,","+) -> Result<(), String> {","+    archive.validate_header_consistency().map_err(|err| err.to_string())?;","+    let mut paths = pnpr_package_name::ArchivePaths::default();","+    let mut remaining = limit;","+    for index in 0..archive.len() {","+        let entry = archive.by_index(index).map_err(|err| err.to_string())?;","+        let name = entry.name().map_err(|err| err.to_string())?;","+        remaining = remaining","+            .checked_sub(entry.size())","+            .ok_or_else(|| format!(\"ZIP exceeds {limit} decompressed bytes\"))?;",