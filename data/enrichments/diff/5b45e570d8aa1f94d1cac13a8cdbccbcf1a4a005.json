fer.test.ts","lines":["@@ -35,6 +35,7 @@ function validateDocument({","   return validateDocumentInternal({","     ...options,","     environment: 'studio',","+    validateReferenceTypes: false,","     getClient: (clientOptions) => documentClient.withConfig(clientOptions),","     i18n: getFallbackLocaleSource(),","   })"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/@sanity/validation/test/referenceTypes.test.ts","lines":["@@ -0,0 +1,386 @@","+import {SanityClient} from '@sanity/client'","+import {Schema} from '@sanity/schema'","+import {builtinTypes} from '@sanity/schema/_internal'","+import {type SanityDocument} from '@sanity/types'","+import {afterEach, describe, expect, it, vi} from 'vitest'","+","+import {validateDocument, validateDocuments, validationMarkerCodes} from '../src'","+import {inferFromSchema} from '../src/_internal'","+","+function createSchema(compiled: boolean) {","+  const parent = Schema.compile({name: 'builtin', types: builtinTypes})","+  if (compiled) inferFromSchema(parent)","+  const schema = Schema.compile({","+    name: 'test',","+    parent,","+    types: [","+      {name: 'knowledgePage', type: 'document', fields: []},","+      {name: 'pageReference', type: 'reference', to: [{type: 'knowledgePage'}]},","+      {name: 'weakPageReference', type: 'reference', to: [{type: 'knowledgePage'}], weak: true},","+      {","+        name: 'designEntity',","+        type: 'document',","+        fields: [","+          {name: 'owningPageRef', type: 'pageReference'},","+          {name: 'weakPageRef', type: 'weakPageReference'},","+          {","+            name: 'related',","+            type: 'reference',","+            to: [{type: 'knowledgePage'}, {type: 'designEntity'}],","+          },","+          {name: 'pages', type: 'array', of: [{type: 'pageReference'}]},","+        ],","+      },","+    ],","+  })","+  return compiled ? inferFromSchema(schema) : schema","+}","+","+function document(id: string, fields: Record<string, unknown> = {}): SanityDocument {","+  return {_id: id, _type: 'designEntity', _rev: 'rev', _createdAt: '', _updatedAt: '', ...fields}","+}","+","+function reference(id: string) {","+  return {_type: 'reference', _ref: id}","+}","+","+function createClient(","+  targets: Record<string, string>,","+  {restricted = [] as string[], unpublished = [] as string[]} = {},","+) {","+  const request = vi.fn(async (options: {url?: string; signal?: AbortSignal}) => {","+    const url = new URL(options.url!, 'https://api.sanity.io')","+    if (url.pathname.includes('/data/doc/')) {","+      const ids = decodeURIComponent(url.pathname.split('/').at(-1)!).split(',')","+      return {","+        omitted: ids.flatMap((id) => {","+          if (restricted.includes(id)) return [{id, reason: 'permission'}]","+          return id in targets ? [] : [{id, reason: 'existence'}]","+        }),","+      }","+    }","+    const ids: string[] | null = JSON.parse(url.searchParams.get('$ids') ?? 'null')","+    if (ids) {","+      return {","+        result: ids.flatMap((id) =>","+          id in targets && !restricted.includes(id) ? [{_id: id, _type: targets[id]}] : [],","+        ),","+      }","+    }","+    return {result: unpublished.includes(JSON.parse(url.searchParams.get('$id')!))}","+  })","+  const client = new SanityClient(request, {","+    projectId: 'project',","+    dataset: 'production',","+    apiVersion: '2025-02-19',","+    useCdn: false,","+  })","+  return {client, request}","+}","+","+afterEach(() => vi.useRealTimers())","+","+describe.each([false, true])('reference types with compiled schema=%s', (compiled) => {","+  const schema = createSchema(compiled)","+","+  it('rejects an existing asset where a page is required by an inherited reference', async () => {","+    const {client} = createClient({image: 'sanity.imageAsset'})","+    const result = await validateDocument({","+      client,","+      schema,","+      document: document('entity', {owningPageRef: reference('image')}),","+    })","+    expect(result.complete).toBe(true)","+    expect(result.markers).toEqual([","+      expect.objectContaining({","+        code: validationMarkerCodes.referenceTargetTypeMismatch,","+        level: 'error',","+        path: ['owningPageRef'],","+        details: {","+          referenceId: 'image',","+          actualType: 'sanity.imageAsset',","+          allowedTypes: ['knowledgePage'],","+        },","+      }),","+    ])","+  })","+","+  it('accepts every declared target type and validates references inside arrays', async () => {","+    const {client} = createClient({","+      page: 'knowledgePage',","+      other: 'designEntity',","+      image: 'sanity.imageAsset',","+    })","+    const results = await validateDocuments({","+      client,","+      schema,","+      documents: [","+        document('one', {owningPageRef: reference('page'), related: reference('other')}),","+        document('two', {","+          related: reference('page'),","+          pages: [{...reference('image'), _type: 'pageReference', _key: 'a'}],","+        }),","+      ],","+    })","+    expect(results[0]).toMatchObject({complete: true, markers: []})","+    expect(results[1].markers).toEqual([","+      expect.objectContaining({","+        code: validationMarkerCodes.referenceTargetTypeMismatch,","+        path: ['pages', {_key: 'a'}],","+      }),","+    ])","+  })","+","+  it('checks existing weak targets while allowing missing weak targets', async () => {","+    const {client} = createClient({image: 'sanity.imageAsset'})","+    const results = await validateDocuments({","+      client,","+      schema,","+      documents: [","+        document('one', {weakPageRef: reference('image')}),","+        document('two', {weakPageRef: reference('missing')}),","+      ],","+    })","+    expect(results[0].markers).toEqual([","+      expect.objectContaining({code: validationMarkerCodes.referenceTargetTypeMismatch}),","+    ])","+    expect(results[1]).toMatchObject({complete: true