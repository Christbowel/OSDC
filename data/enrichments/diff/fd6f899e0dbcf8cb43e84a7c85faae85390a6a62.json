k's remote cache from the keys of an older cached block.","+    /// Prefetches remote fork state before the EVM reads it.","     ///","-    /// Defaults to `false`. When a fork starts on a block with an empty disk cache, the accounts","-    /// and storage slots in the cache of the newest older block on the same chain are fetched","-    /// again at the new block in the background. This helps forks of `latest`, which start","-    /// cold on each new head. Values come from the fork block and never replace cached values,","-    /// so results do not change; unused keys cost extra RPC requests. Requires storage caching.","+    /// Defaults to `false`. While reads miss the cache, each call into a fork contract is","+    /// simulated on the endpoint with `eth_createAccessList`, and the state it touches is","+    /// fetched in batches. With storage caching, a fork block with an empty disk cache also","+    /// fetches the keys cached for the newest older block on the same chain. Values come from","+    /// the fork block; extra keys cost requests.","     #[serde(default)]","     pub fork_prefetch: bool,","     /// Disables rate limiting entirely. This overrides any settings made in"],"additions":6,"deletions":6,"truncated":false},{"path":"crates/evm/core/src/backend/mod.rs","lines":["@@ -45,7 +45,7 @@ use alloy_eips::BlockNumHash;"," use alloy_genesis::GenesisAccount;"," use alloy_network::{AnyNetwork, AnyRpcBlock, AnyRpcTransaction, TransactionResponse};"," use alloy_primitives::{","-    Address, B256, ChainId, KECCAK256_EMPTY, TxKind, U256, keccak256,","+    Address, B256, Bytes, ChainId, KECCAK256_EMPTY, TxKind, U256, keccak256,","     map::{AddressMap, AddressSet, HashSet},","     uint,"," };","@@ -1230,6 +1230,22 @@ impl<FEN: FoundryEvmNetwork> Backend<FEN> {","         Ok(write)","     }"," ","+    /// Prefetches the remote state a call is about to read, if the active context is an RPC fork.","+    ///","+    /// A `top_level` call is simulated with the local state that differs from the remote, such as","+    /// the test contract, as overrides. A nested call is simulated as is.","+    pub fn prefetch_call(","+        &self,","+        caller: Address,","+        target: Address,","+        value: U256,","+        input: Bytes,","+        top_level: bool,","+    ) {","+        let context = self.lifecycle.active();","+        context.db.prefetch_call(caller, target, value, input, context.cache.as_deref(), top_level);","+    }","+","     // ---- Snapshots ----"," ","     /// Captures the running context and every fork, and returns the snapshot ID."],"additions":17,"deletions":1,"truncated":false},{"path":"crates/evm/core/src/backend/tests.rs","lines":["@@ -9,7 +9,7 @@ use alloy_consensus::{Signed, TxEnvelope, TxLegacy};"," use alloy_network::{","     AnyHeader, AnyRpcHeader, AnyTxEnvelope, AnyTxType, UnknownTxEnvelope, UnknownTypedTransaction,"," };","-use alloy_primitives::{Bytes, Signature};","+use alloy_primitives::Signature;"," use alloy_provider::Provider;"," use alloy_rpc_types::{Block, Transaction as RpcTransaction};"," use alloy_serde::WithOtherFields;"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/evm/core/src/evm/db.rs","lines":["@@ -4,8 +4,9 @@"," //! snapshots and cheatcode policy live in [`ForkRegistry`](super::ForkRegistry) and"," //! [`ExecutionLifecycle`](super::ExecutionLifecycle), not here."," ","+use crate::fork::prefetch;"," use alloy_network::Network;","-use alloy_primitives::{Address, B256, U256, map::B256Map};","+use alloy_primitives::{Address, B256, Bytes, U256, map::B256Map};"," use evm2::{","     DatabaseError,","     bytecode::Bytecode,","@@ -43,6 +44,20 @@ pub trait FoundryDatabase: DynDatabase {","     /// Sets whether the execution reading this database applies EIP-161, under which empty","     /// accounts do not exist.","     fn set_eip161(&self, _eip161: bool) {}","+","+    /// Prefetches the remote state a call is about to read, if this database reads a remote","+    /// fork. With `overrides`, the `local` state over this database goes along as overrides;","+    /// without, a call into a local-only account is skipped.","+    fn prefetch_call(","+        &self,","+        _caller: Address,","+        _target: Address,","+        _value: U256,","+        _input: Bytes,","+        _local: Option<&Cache>,","+        _overrides: bool,","+    ) {","+    }"," }"," "," impl FoundryDatabase for EmptyDB {}","@@ -82,6 +97,18 @@ impl FoundryDatabase for Box<dyn BackingDb> {","     fn set_eip161(&self, eip161: bool) {","         (**self).set_eip161(eip161);","     }","+","+    fn prefetch_call(","+        &self,","+        caller: Address,","+        target: Address,","+        value: U256,","+        input: Bytes,","+        local: Option<&Cache>,","+        overrides: bool,","+    ) {","+        (**self).prefetch_call(caller, target, value, input, local, overrides);","+    }"," }"," "," /// Converts accounts of the fork cache, which holds raw code, into evm2 accounts.","@@ -202,18 +229,28 @@ impl<N: Network, B: ForkBlockEnv> FoundryDatabase for ForkDb<SharedBackend<N, B>","     }"," ","     fn evict_account(&self, address: &Address) {","-        self.db.data().accounts.write().remove(address);","+        self.db.evict(*address, None);","     }"," ","     fn evict_storage(&self, address: &Address, slot: &U256) {","-        if let Some(storage) = self.db.data().storage.write().get_mut(address) {","-            storage.remove(slot);","-        }","+        self.db.evict(*address, Some(*slot));","     }"," ","     fn set_eip161(&self, eip161: bool) {","         self.eip161.store(eip161, Ordering::Relaxed);","     }","+","+    fn prefetch_call(","+        &self,","+        caller: Address,","+        target: Address,","+        value: U256,","+        input: Bytes,","+        local: Option<&Cache>,","+        overrides: bool,","+    ) {","+        prefetch::prefetch_call(&self.db, caller, target, value, input, local, overrides);","+    }"," }"," ","