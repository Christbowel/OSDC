{"id":"90e5159ea9099bd5c6e1ea667deb33490007d34e","axis":"silent","repo":"pnpm/pnpm","sha":"90e5159ea9099bd5c6e1ea667deb33490007d34e","parsed":{"files":[{"path":".changeset/windows-side-effects-cache-exec-bit.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+On Windows, `pnpm install` no longer skips a dependency's build script on a later install when the package ships an executable file and the script changes nothing inside the package directory [#15667](https://github.com/pnpm/pnpm/issues/15667)."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/windows-side-effects-cache-mode.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/worker\": patch","+\"pnpm\": patch","+---","+","+On Windows, `pnpm install` no longer skips a dependency's build script on a later install when the script changes nothing inside the package directory [#15667](https://github.com/pnpm/pnpm/issues/15667)."],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/side_effects_cache.rs","lines":["@@ -107,6 +107,19 @@ fn assert_side_effects_materialized(hoisted: bool) {"," /// Regression for <https://github.com/pnpm/pnpm/issues/14717>."," #[test]"," fn a_build_with_nothing_to_restore_runs_on_every_install() {","+    assert_build_runs_on_every_install(\"1.0.0\");","+}","+","+/// The 1.1.0 fixture ships an executable file. Off Unix the rehash cannot","+/// record that bit, which must not count as build output.","+///","+/// Regression for <https://github.com/pnpm/pnpm/issues/15667>.","+#[test]","+fn a_build_with_nothing_to_restore_runs_on_every_install_when_the_package_ships_an_executable() {","+    assert_build_runs_on_every_install(\"1.1.0\");","+}","+","+fn assert_build_runs_on_every_install(version: &str) {","     let CommandTempCwd {","         pacquet,","         root,","@@ -127,7 +140,7 @@ fn a_build_with_nothing_to_restore_runs_on_every_install() {","     fs::write(","         workspace.join(\"package.json\"),","         serde