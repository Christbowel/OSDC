{"id":"bc3caf0c721d0f51082b421f8dfd54356005829e","axis":"silent","repo":"pnpm/pnpm","sha":"bc3caf0c721d0f51082b421f8dfd54356005829e","parsed":{"files":[{"path":".changeset/optional-peer-kept-on-cycle-reinstall.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` with an existing lockfile and a second `pnpm dedupe` now keep optional peer bindings that point into a dependency cycle or back into the dependent package. Before, the second run dropped the optional peer binding from the lockfile snapshot key."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/lockfile/src/peer_bindings.rs","lines":["@@ -1,6 +1,56 @@","+use std::collections::HashSet;","+"," use crate::PkgNameVerPeer;"," use pnpm_deps_path::{DepPath, PeerId, create_peer_dep_graph_hash};"," ","+/// The providers one key's peer bindings name, without their own peers:","+/// peer segments may omit them (`dedupePeers`). `None` for a hashed","+/// suffix, which names none.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub struct BoundProviders(Option<HashSet<PkgNameVerPeer>>);","+","+impl BoundProviders {","+    /// The providers `key`'s peer suffix names. Empty when `key` has no","+    /// peer suffix.","+    #[must_use]","+    pub fn from_key(key: &PkgNameVerPeer) -> Self {","+        match PeerBindings::from_key(key) {","+            Some(bindings) => Self::of(&bindings),","+            None => BoundProviders(Some(HashSet::new())),","+        }","+    }","+","+    /// The providers `bindings` name.","+    #[must_use]","+    pub fn of(bindings: &PeerBindings) -> Self {","+        match bindings {","+            PeerBindings::Hashed => BoundProviders(None),","+            PeerBindings::Explicit(_) => BoundProviders(Some(","+                bindings","+                    .providers()","+                    .map(|provider| provider.without_peer())","+                    .collect(),","+            )),","+        }","+    }","+","+    /// Whether the suffix was hashed (`peersSuffixMaxLength`) rather than","+    /// listing explicit providers.","+    #[must_use]","+    pub fn is_hashed(&self) -> bool {","+        self.0.is_none()","+    }","+","+    /// Whether the bindings name `target`. Every target counts for a","+    /// hashed suffix.","+    #[must_use]","+    pub fn binds(&self, target: &PkgNameVerPeer) -> bool {","+        self.0","+            .as_ref()","+            .is_none_or(|providers| providers.contains(&target.without_peer()))","+    }","+}","+"," /// The peer providers a snapshot key records in its peer suffix. The"," /// suffix is the only record of the providers peer resolution bound,"," /// including where it cut a peer cycle short, so every reader goes"],"additions":50,"deletions":0,"truncated":false},{"path":"pnpm/crates/lockfile/src/peer_bindings/tests.rs","lines":["@@ -1,4 +1,4 @@","-use super::PeerBindings;","+use super::{BoundProviders, PeerBindings};"," use crate::{Lockfile, PkgNameVerPeer};"," use pretty_assertions::assert_eq;"," use std::path::{Path, PathBuf};","@@ -7,6 +7,25 @@ fn key(text: &str) -> PkgNameVerPeer {","     text.parse().expect(\"parse key\")"," }"," ","+#[test]","+fn bound_providers_match_targets_by_name_and_version_and_accept_all_for_hashed() {","+    let explicit = BoundProviders::from_key(&key(\"a@1.0.0(b@2.0.0(c@1.0.0))\"));","+    assert!(!explicit.is_hashed());","+    assert!(explicit.binds(&key(\"b@2.0.0\")));","+    assert!(explicit.binds(&key(\"b@2.0.0(other@1.0.0)\")));","+    assert!(!explicit.binds(&key(\"b@1.0.0\")));","+    assert!(!explicit.binds(&key(\"c@1.0.0\")));","+","+    let none = BoundProviders::from_key(&key(\"a@1.0.0\"));","+    assert!(!none.is_hashed());","+    assert!(!none.binds(&key(\"b@2.0.0\")));","+","+    let hashed = BoundProviders::from_key(&key(\"a@1.0.0(0123456789abcdef0123456789abcdef)\"));","+    assert!(hashed.is_hashed());","+    assert!(hashed.binds(&key(\"b@2.0.0\")));","+    assert!(hashed.binds(&key(\"anything@9.9.9\")));","+}","+","