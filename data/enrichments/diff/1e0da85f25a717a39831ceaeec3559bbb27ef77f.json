ns":2,"deletions":1,"truncated":false},{"path":"test/helpers/syntaxEquivalence.js","lines":["@@ -1109,17 +1109,35 @@ const compareRenders = async ({ pairs, width }) => {"," \tconst measure = async () => {"," \t\tconst doc = /** @type {Document} */ (frame.contentDocument);"," \t\tawait settled(doc.fonts.ready);","-\t\t// WHY: Chrome boxes a blocked `<img>` with no `alt` 0x0 or as a 16x16 icon","-\t\t// apparently at random — measured in CI on srcset.html, both orders at once","-\t\t// — while one with an empty `alt` represents nothing, so both copies get one.","-\t\t// Which had one is compared on its own, so a dropped `alt=\"\"` still shows.","+\t\t// WHY: how Chrome boxes a broken `<img>` with no `alt` follows how far its","+\t\t// fetch got — 0x0 where none was made, a 16x16 icon where one came back","+\t\t// undecodable — so on a page whose images cannot load it is timing, not the","+\t\t// printer, that decides; measured in CI on srcset.html, both orders at once.","+\t\t// An empty `alt` makes one represent nothing, but only where it is there as","+\t\t// the element breaks: setting it afterwards leaves the icon, so each image","+\t\t// is loaded again under it. Which had one is compared on its own, so a","+\t\t// dropped `alt=\"\"` still shows."," \t\t/** @type {number[]} */"," \t\tconst withoutAlt = [];","+\t\t/** @type {Promise<unknown>[]} */","+\t\tconst breaking = [];"," \t\tfor (const [at, image] of [...doc.images].entries()) {"," \t\t\tif (image.hasAttribute(\"alt\")) continue;"," \t\t\twithoutAlt.push(at);","-\t\t\timage.setAttribute(\"alt\", \"\");","+\t\t\t// A clone runs the image update algorithm again, whatever names the","+\t\t\t// source — an `src`, a `srcset` or a `<source>` beside it.","+\t\t\tconst under = /** @type {HTMLImageElement} */ (image.cloneNode(true));","+\t\t\tunder.setAttribute(\"alt\", \"\");","+\t\t\timage.replaceWith(under);","+\t\t\tif (under.complete) continue;","+\t\t\tbreaking.push(","+\t\t\t\tnew Promise((resolve) => {","+\t