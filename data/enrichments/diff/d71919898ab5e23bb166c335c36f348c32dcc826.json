fastapi.execution_api.datamodels.taskinstance import TIDeferredStatePayload","+","+","+class RemoveStringTriggerKwargs(VersionChange):","+    \"\"\"Stop accepting `trigger_kwargs` as a string in TIDeferredStatePayload.\"\"\"","+","+    description = __doc__","+","+    instructions_to_migrate_to_previous_version = (","+        schema(TIDeferredStatePayload).field(\"trigger_kwargs\").had(type=dict[str, JsonValue] | str),","+    )","+","+    # Keyed by path: cadwyn 8 can't match a body-schema converter to one member of the TIStateUpdate union.","+    @convert_request_to_next_version_for(\"/task-instances/{task_instance_id}/state\", [\"PATCH\"])  # type: ignore[arg-type]","+    def reject_string_trigger_kwargs(request: RequestInfo) -> None:","+        \"\"\"Reject a string from older clients; the server can't tell whether it is encrypted.\"\"\"","+        if isinstance(request.body, dict) and isinstance(request.body.get(\"trigger_kwargs\"), str):","+            raise HTTPException(","+                status_code=HTTP_422_UNPROCESSABLE_CONTENT,","+                detail={","+                    \"reason\": \"invalid_trigger_kwargs\",","+                    \"message\": \"trigger_kwargs must be a serialized dict, not a string\",","+                },","+            )"],"additions":48,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/cli/cli_config.py","lines":["@@ -2391,10 +2391,10 @@ class GroupCommand(NamedTuple):","     ActionCommand(","         name=\"rotate-fernet-key\",","         func=lazy_load_command(\"airflow.cli.commands.rotate_fernet_key_command.rotate_fernet_key\"),","-        help=\"Rotate encrypted connection credentials and variables\",","+        help=\"Rotate encrypted connection credentials, variables and trigger kwargs\",","         description=(","-            \"Rotate all encrypted connection credentials and variables; see \"","-            \"https://airflow.apache.org/docs/apache-airflow/stable/howto/secure-connections.html\"","+   