(\"utf-8\")).decode(\"utf-8\")","+        else:","+            self.encrypted_kwargs = fernet.rotate(self.encrypted_kwargs.encode(\"utf-8\")).decode(\"utf-8\")"," ","     @classmethod","     def from_object(cls, trigger: BaseTrigger) -> Trigger:","@@ -288,6 +291,7 @@ def from_serialized_kwargs(","         classpath: str,","         serialized_kwargs: dict[str, Any],","         queue: str | None = None,","+        team_name: str | None = None,","         *,","         dag_id: str | None = None,","         used_by_ref: dict[str, Any] | None = None,","@@ -295,10 +299,17 @@ def from_serialized_kwargs(","         \"\"\"","         Create a trigger row from kwargs that are already in their serde-encoded form."," ","-        The kwargs are stored exactly as given and decoded by the triggerer when it creates","-        the trigger, the same as kwargs stored by :meth:`from_object`.","+        The kwargs are encrypted without being re-serialized and decoded by the triggerer when it","+        creates the trigger, the same as kwargs stored by :meth:`from_object`.","         \"\"\"","-        trigger = cls(classpath=classpath, kwargs={}, queue=queue, dag_id=dag_id, used_by_ref=used_by_ref)","+        trigger = cls(","+            classpath=classpath,","+            kwargs={},","+            queue=queue,","+            team_name=team_name,","+            dag_id=dag_id,","+            used_by_ref=used_by_ref,","+        )","         trigger.encrypted_kwargs = cls._encrypt_serialized_kwargs(serialized_kwargs)","         return trigger"," "],"additions":18,"deletions":7,"truncated":false},{"path":"airflow-core/tests/unit/api_fastapi/execution_api/versions/head/test_task_instances.py","lines":["@@ -17,6 +17,7 @@"," "," from __future__ import annotations"," ","+import json"," import re"," from concurrent.futures import ThreadPoolExecutor"," from contextlib import nullcontext","@@ -58,6 +59,7 @@"," from airflow.api_fastapi.execution_api.routes import task_instances as task_instances_r