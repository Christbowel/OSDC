nse at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+from __future__ import annotations","+","+import pytest","+from sqlalchemy import select","+","+from airflow.models import TaskInstance, Trigger","+from airflow.utils.state import State","+","+from tests_common.test_utils.db import clear_db_runs, clear_db_triggers","+","+pytestmark = pytest.mark.db_test","+","+PREVIOUS_VERSION = \"2026-10-30\"","+","+","+@pytest.fixture(autouse=True)","+def _clean_db():","+    clear_db_runs()","+    clear_db_triggers()","+    yield","+    clear_db_runs()","+    clear_db_triggers()","+","+","+@pytest.mark.parametrize(","+    (\"trigger_kwargs\", \"expected_status\", \"expected_state\"),","+    [","+        pytest.param({\"key\": \"value\"}, 204, State.DEFERRED, id=\"dict\"),","+        pytest.param('{\"key\": \"value\"}', 422, State.RUNNING, id=\"string\"),","+    ],","+)","+def test_old_version_deferral_trigger_kwargs(","+    client, session, create_task_instance, trigger_kwargs, expected_status, expected_state","+):","+    ti = create_task_instance(","+        task_id=\"test_old_version_deferral_trigger_kwargs\", state=State.RUNNING, session=session","+    )","+    session.commit()","+    client.headers[\"Airflow-API-Version\"] = PREVIOUS_VERSION","+","+    response = client.patch(","+        f\"/execution/task-instances/{ti.id}/state\",","+        json={","+            \"state\": \"deferred\",","+            \"trigger_kwargs\": trigger_kwargs,","+            \"classpath\": \"my-classpath\",","+            \"next_method\": \"execute_callback\",","+        },","+    )","+","+    assert response.status_code == expected_status, response.text","+    if expected_status == 422:","+        assert response.json()[\"detail\"][\"reason\"] == \"invalid_trigger_kwargs\"","+    session.expire_all()","+    assert session.scalar(select(TaskInstance.state).where(TaskInstance.id == ti.id)) == expected_state","+    triggers = session.scalars(select(Trigger)).all()","+    assert [t.kwargs for t in triggers] == ([trigger_kwargs] if expected_status == 204 else [])","+","+","+@pytest.mark.parametrize(\"version\", [PREVIOUS_VERSION, \"2026-12-01\"])","+def test_trigger_kwargs_schema_by_version(client, version):","+    response = client.get(f\"/execution/openapi.json?version={version}\")","+","+    assert response.status_code == 200","+    field = response.json()[\"components\"][\"schemas\"][\"TIDeferredStatePayload\"][\"properties\"][\"trigger_kwargs\"]","+    types = {option.get(\"type\") for option in field.get(\"oneOf\", [field])}","+    assert (\"string\" in types) == (version == PREVIOUS_VERSION)"],"additions":83,"deletions":0,"truncated":false},{"path":"airflow-core/tests/unit/cli/commands/test_rotate_fernet_key_command.py","lines":["@@ -16,6 +16,7 @@"," # under the License."," from __future__ import annotations"," ","+import json"," from argparse import ArgumentParser"," from typing import TYPE_CHECKING"," ","@@ -26,12 +27,12 @@"," from airflow.cli import cli_parser"," from airflow.cli.commands import rotate_fernet_key_command"," from airflow.crypto import get_fernet","-from airflow.models import Connection, Variable","+from airflow.models import Connection, Trigger, Variable"," from airflow.sdk import BaseHook"," from airflow.utils.session import provide_session"," "," from tests_common.test_utils.config import conf_vars","-from tests_common.test_utils.db import clear_db_connections, clear_db_variables","+from tests_common.test_utils.db import clear_db_connections, clear_db_triggers, clear_db_variables"," "," if TYPE_CHECKING:","     from sqlalchemy.orm import Session","@@ -49,10 +50,12 @@ def setup_class(