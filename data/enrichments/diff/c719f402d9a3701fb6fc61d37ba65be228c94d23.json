 +182,9 @@ pub enum NodePackageMapType {"," /// Given workspace package `A` → `B` → `C`:"," /// - [`HoistingLimits::None`]: hoist as far as possible"," ///   (`/node_modules/B`, `/node_modules/C`).","-/// - [`HoistingLimits::Workspaces`]: hoist only as far as each","-///   workspace package (`/packages/A/node_modules/{B,C}`).","+/// - [`HoistingLimits::Projects`]: hoist only as far as each","+///   workspace package (`/packages/A/node_modules/{B,C}`). Also read","+///   from `workspaces`, yarn's name for it, which pnpm 11 accepted."," /// - [`HoistingLimits::Dependencies`]: hoist only up to each"," ///   workspace package's direct dependencies"," ///   (`/packages/A/node_modules/B/node_modules/C`).","@@ -192,7 +193,8 @@ pub enum NodePackageMapType {"," pub enum HoistingLimits {","     #[default]","     None,","-    Workspaces,","+    #[serde(alias = \"workspaces\")]","+    Projects,","     Dependencies,"," }"," "],"additions":5,"deletions":3,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -814,7 +814,7 @@ pub struct Config {"," ","     /// `hoistingLimits` from `pnpm-workspace.yaml`. Controls how far","     /// dependencies are hoisted under `nodeLinker: hoisted`. See","-    /// [`HoistingLimits`] for the `none` / `workspaces` /","+    /// [`HoistingLimits`] for the `none` / `projects` /","     /// `dependencies` semantics. Default [`HoistingLimits::None`]","     /// (hoist as far as possible). Translated into the hoister's","     /// per-locator border map by `crate::get_hoisting_limits` in"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/settings.rs","lines":["@@ -273,7 +273,7 @@ pub struct WorkspaceSettings {","     /// [`Config::inject_workspace_packages`](crate::settings::Config::inject_workspace_packages).","     pub inject_workspace_packages: Option<bool>,","     /// `hoistingLimits` from `pnpm-workspace.yaml`. One of `none`,","-    /// `workspaces`, or `dependencies`; see","+    /// `projects`, or `dependencies`; see","     /// [`crate::HoistingLimits`]. Missing → default","     /// [`crate::HoistingLimits::None`].","     pub hoisting_limits: Option<HoistingLimits>,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/workspace_settings.rs","lines":["@@ -817,7 +817,7 @@ fn hoist_false_disables_private_hoist_pattern() {","     assert_eq!(config.hoist_pattern, None, \"hoist:false must override an explicit hoistPattern\");"," }"," ","-/// `hoistingLimits` deserializes as one of the `none` / `workspaces`","+/// `hoistingLimits` deserializes as one of the `none` / `projects`"," /// / `dependencies` modes. Yaml-empty /"," /// missing keeps the `Config` field at its [`HoistingLimits::None`]"," /// default.","@@ -833,6 +833,15 @@ fn parses_hoisting_limits_from_yaml_and_applies() {","     assert_eq!(config.hoisting_limits, HoistingLimits::Dependencies);"," }"," ","+/// pnpm 11 configs spell the `projects` limit `workspaces`.","+#[test]","+fn reads_workspaces_hoisting_limit_as_projects() {","+    for yaml in [\"hoistingLimits: projects\\n\", \"hoistingLimits: workspaces\\n\"] {","+        let settings: WorkspaceSettings = serde_saphyr::from_str(yaml).unwrap();","+        assert_eq!(settings.hoisting_limits, Some(HoistingLimits::Projects), \"{yaml}\");","+    }","+}","+"," /// Both knobs absent → both `Config` fields stay at their empty"," /// defaults. Pins the `apply_to` skip-on-None branch so future"," /// edits don't accidentally overwrite with empty when the yaml"],"additions":10,"deletions":1,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/hoisting_limits/tests.rs","lines":["@@ -62,7 +62,7 @@ fn workspaces_mode_borders_packages_at_root() {","     importers.insert(Lockfile::ROOT_IMPORTER_KEY.to_string(), project_with_deps(&[\"a\"]));","     importers.insert(\"packages/foo\".to_string(), project_with_deps(&[\"b\"]));"," ","-    let limits = get_hoisting_limits(&importers, HoistingLimits::Workspaces);","+    let limits = get_hoisting_limits(&importers, HoistingLimits::Projects);","     assert_eq!(","         limits","             .keys()","@@ -95,7 +95,7 @@ fn workspaces_mode_borders_packages_at_root_when_root_importer_omitted() {","     let mut importers = HashMap::new();","     importers.insert(\"packages/foo\".to_string(), project_with_deps(&[\"b\"]));"," ","-    let limits = get_hoisting_limits(&importers, HoistingLimits::Workspaces);","+    let limits = get_hoisting_limits(&importers, HoistingLimits::Projects);","     assert_eq!(","         limits","             .keys()"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/docs/settings/node-modules.md","lines":["@@ -45,7 +45,7 @@ The hoisted linker accepts `hoistingLimits`:"," ```yaml title=\"pnpm-workspace.yaml\""," nodeLinker:","   type: hoisted","-  hoistingLimits: workspaces","+  hoistingLimits: projects"," ```"," "," The loaded linker accepts an `excluded` list. The list replaces lower-priority exclusions, and an omitted list clears them. Other linker types reject options they do not support.","@@ -521,13 +521,13 @@ root of `node_modules`, you can set this to `true` to hoist them for you."," ### hoistingLimits"," "," * Default: **none**","-* Type: **none**, **workspaces**, **dependencies**","+* Type: **none**, **projects**, **dependencies**"," "," Controls how far dependencies are hoisted when using `nodeLinker: hoisted`. This setting mirrors Yarn's `nmHoistingLimits`."," "," * **none** - hoist as far as possible (the default).","-* **workspaces** - hoist only as far as each workspace package, preventing dependencies from being hoisted above the workspace package that depends on them.","-* **dependencies** - hoist only up to each workspace package's direct dependencies, preventing transitive dependencies from being hoisted into the workspace package's `node_modules`.","+* **projects** - hoist only as far as each workspace project, preventing dependencies from being hoisted above the project that depends on them. pnpm also accepts its earlier name, `workspaces`.","+* **dependencies** - hoist only up to each workspace project's direct dependencies, preventing transitive dependencies from being hoisted into the project's `node_modules`."," "," ### externalDependencies"," ",""],"additions":4,"deletions":4,"truncated":false}],"additions":41,"deletions":24,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-26T18:55:28.209447+00:00"}