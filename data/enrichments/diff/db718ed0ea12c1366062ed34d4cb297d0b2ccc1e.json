{"id":"db718ed0ea12c1366062ed34d4cb297d0b2ccc1e","axis":"silent","repo":"strapi/strapi","sha":"db718ed0ea12c1366062ed34d4cb297d0b2ccc1e","parsed":{"files":[{"path":"docs/docs/packages/core/admin/ee/audit-logs.md","lines":["@@ -28,6 +28,12 @@ To save audit log data, we utilize an Audit Logs local provider responsible for"," "," This content type stores all the audit logs. For each allowed event, we save an entry in the audit logs content type."," ","+The `admin::audit-log` content type is registered by the CE admin (`packages/core/admin/server/src/content-types/index.ts`) in every edition, with or without a license, like the content types of content releases and review workflows. The CE bootstrap also adds `strapi_audit_logs` to the persisted tables. The schema file stays under `packages/core/admin/ee/server/src/audit-logs/content-types/`.","+","+### Runtime gates","+","+The routes, controller, services and the `admin::audit-logs.read` / `admin::audit-logs.export` permission actions all use one condition, `isAuditLogsEnabled` in `packages/core/admin/ee/server/src/audit-logs/utils.ts`: the license includes the `audit-logs` feature and `admin.auditLogs.enabled` is not `false`. When the config disables audit logs, the role editor does not list the audit-log permissions.","+"," ### Subscribing to all events"," "," The Audit Logs feature adds a subscriber to the [EventHub](../../core/event-hub.md), allowing it to listen to all events in the application. However, we don't save every event in the audit logs; we only save the default ones (see the defaultEvents array in the service file)."],"additions":6,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/server/src/__tests__/bootstrap.vitest.test.ts","lines":["@@ -0,0 +1,80 @@","+import { beforeEach, describe, expect, test, vi } from 'vitest';","+","+import bootstrap from '../bootstrap';","+import actions from '../config/admin-actions';","+","+const { registerMany, persistTablesWithPrefix, seatEnforcementWorkflow } = vi.hoisted(() => ({","+  registerMany: vi.fn(),","+  persistTablesWithPrefix: vi.fn(),","+  seatEnforcementWorkflow: vi.fn(),","+}));","+","+vi.mock('../../../../server/src/bootstrap', () => ({ default: vi.fn() }));","+","+vi.mock('../utils', () => ({","+  getService: vi.fn((name: string) => {","+    switch (name) {","+      case 'permission':","+        return { actionProvider: { registerMany } };","+      case 'persist-tables':","+        return { persistTablesWithPrefix };","+      case 'seat-enforcement':","+        return { seatEnforcementWorkflow };","+      default:","+        throw new Error(`Unexpected service ${name}`);","+    }","+  }),","+}));","+","+const mockStrapi = ({","+  features,","+  auditLogsEnabled,","+}: {","+  features: string[];","+  auditLogsEnabled?: boolean;","+}) => {","+  global.strapi = {","+    ee: { features: { isEnabled: vi.fn((name: string) => features.includes(name)) } },","+    config: {","+      get: vi.fn((path: string, defaultValue?: unknown) => {","+        if (path === 'admin.auditLogs.enabled') {","+          return auditLogsEnabled ?? defaultValue;","+        }","+","+        return defaultValue;","+      }),","+    },","+  } as any;","+};","+","+describe('EE admin bootstrap', () => {","+  beforeEach(() => {","+    vi.clearAllMocks();","+  });","+","+  describe('audit logs permission actions', () => {","+    test('registers the actions when the feature is licensed and the config is not set', async () => {","+      mockStrapi({ features: ['audit-logs'] });","+","+      await bootstrap({});","+","+      expect(registerMany).toHaveBeenCalledWith(actions.auditLogs);","+    });","+","+    test('does not register the actions when admin.auditLogs.enabled is false', async () => {","+      mockStrapi({ features: ['audit-logs'], auditLogsEnabled: false });","+","+      await bootstrap({});","+","+      expect(registerMany).not.toHaveBeenCalledWith(actions.auditLogs);","+    });","+","+    test('does not register the actions when the feature is not licensed', async () => {","+      mockStrapi({ features: [], auditLogsEnabled: true });","+","+      await bootstrap({});","+","+      expect(registerMany).not.toHaveBeenCalledWith(actions.auditLogs);","+    });","+  });","+});"],"additions":80,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/server/src/audit-logs/utils.ts","lines":["@@ -1,3 +1,5 @@","+import type { Core } from '@strapi/types';","+"," interface AdminUserLike {","   username?: string | null;","   firstname?: string | null;","@@ -18,4 +20,13 @@ const getDisplayName = (user: AdminUserLike): string => {","   return user.email;"," };"," ","-export { getDisplayName };","+/**","+ * Audit logs run when the license includes the feature and the admin config does not disable them.","+ * Routes, services and permission actions all follow this condition.","+ */","+const isAuditLogsEnabled = (strapi: Core.Strapi): boolean =>","+  Boolean(","+    strapi.config.get('admin.auditLogs.enabled', true) && strapi.ee.features.isEnabled('audit-logs')","+  );","+","+export { getDisplayName, isAuditLogsEnabled };"],"additions":12,"deletions":1,"truncated":false},{"path":"packages/core/admin/ee/server/src/bootstrap.ts","lines":["@@ -1,17 +1,17 @@"," import executeCEBootstrap from '../../../server/src/bootstrap';"," import { getService } from './utils';"," import actions from './config/admin-actions';","+import { isAuditLogsEnabled } from './audit-logs/utils';"," "," export default async (args: any) => {","   const { actionProvider } = getService('permission');","-  const { persistTablesWithPrefix } = getService('persist-tables');"," ","   if (strapi.ee.features.isEnabled('sso')) {","     await actionProvider.registerMany(actions.sso);","   }"," ","-  if (strapi.ee.features.isEnabled('audit-logs')) {","-    await persistTablesWithPrefix('strapi_audit_logs');","+  // Same condition as the audit-logs routes, so the role editor lists no permission without a route","+  if (isAuditLogsEnabled(strapi)) {","     await actionProvider.registerMany(actions.auditLogs);","   }"," "],"additions":3,"deletions":3,"truncated":false},{"path":"packages/core/admin/ee/server/src/index.ts","lines":["@@ -10,7 +10,7 @@ import auditLogsRoutes from './audit-logs/routes/audit-logs';"," import auditLogsController from './audit-logs/controllers/audit-logs';"," import { createAuditLogsService } from './audit-logs/services/audit-logs';"," import { createAuditLogsLifecycleService } from './audit-logs/services/lifecycles';","-import { auditLog } from './audit-logs/content-types/audit-log';","+import { isAuditLogsEnabled as getIsAuditLogsEnabled } from './audit-logs/utils';"," import { AUDIT_LOG_EXPORT_EVENT } from '../../../shared/utils/audit-log-export';"," import { registerTokenAuditEvents } from '../../../server/src/audit-logs/tokens';"," import { registerAdminUserAuditEvents } from '../../../server/src/audit-logs/admin-users';","@@ -24,19 +24,14 @@ const getAdminEE = () => {","     register,","     bootstrap,","     destroy,","-    contentTypes: {","-      // Always register the audit-log content type to prevent data loss","-      'audit-log': auditLog,","-      ...adminContentTypes,","-    },","+    // The audit-log content type is registered by the CE admin, in every edition","+    contentTypes: adminContentTypes,","     services,","     controllers,","     routes,","   };"," ","-  const isAuditLogsEnabled =","-    strapi.config.get('admin.auditLogs.enabled', true) &&","-    strapi.ee.features.isEnabled('audit-logs');","+  const isAuditLogsEnabled = getIsAuditLogsEnabled(strapi);","   return {","     ...eeAdmin,","     controllers: {"],"additions":4,"deletions":9,"truncated":false},{"path":"packages/core/admin/server/src/bootstrap.ts","lines":["@@ -11,6 +11,7 @@ import {"," import adminActions from './config/admin-actions';"," import adminConditions from './config/admin-conditions';"," import constants from './services/constants';","+import { persistTablesWithPrefix } from '