n<&std::path::Path> {","+        None","+    }","+}","+","+#[tokio::test]","+async fn hook_replay_sees_package_extensions() {","+    let parent = pnpm_lockfile_verification::LocalResolutionProbeParent {","+        pkg_key: \"remote@1.0.0\".parse().expect(\"parse key\"),","+        resolution: None,","+        name: \"remote\".to_string(),","+        version: Some(\"1.0.0\".to_string()),","+        dep_aliases: vec![\"helper\".to_string()],","+        optional_aliases: Vec::new(),","+        peer_aliases: Vec::new(),","+    };","+    let pristine = serde_json::json!({ \"name\": \"remote\", \"version\": \"1.0.0\" });","+    let mut config = pnpm_config::Config::new();","+    config.package_extensions = Some(indexmap::IndexMap::from([(","+        \"remote\".to_string(),","+        pnpm_config::PackageExtension {","+            dependencies: Some([(\"helper\".to_string(), \"^1.0.0\".to_string())].into()),","+            ..Default::default()","+        },","+    )]));","+    let drivers = super::LocalPolicyEnrichDrivers {","+        config: Some(&config),","+        http_client: None,","+        hook: Some(&RedirectsExtendedHelper),","+    };","+    let modes = super::ProbeModes { pristine_specs: false, read_package: true };","+    let replay = super::ReadPackageReplay::for_probe(drivers, modes)","+        .expect(\"valid selector\")","+        .expect(\"a hook to replay\");","+    let mut rewrites = Vec::new();","+    super::collect_probed_parent_rewrites(&replay, &parent, Some(&pristine), &mut rewrites)","+        .await","+        .expect(\"the hook accepts the manifest\");","+    let rewritten: Vec<_> = rewrites","+        .iter()","+        .map(|(_, _, _, alias, spec)| (alias.as_str(), spec.as_str()))","+        .collect();","+    assert_eq!(rewritten, [(\"helper\", \"link:../helper\")]);","+","+    // Without the real manifest, as for a tarball on a cold store, the replay","+    // cannot tell whether the package declares `helper` itself, so a rewrite","+    // ke