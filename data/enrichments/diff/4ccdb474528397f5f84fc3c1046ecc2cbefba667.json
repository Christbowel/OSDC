_as_bytes()),"," ","       encode_raw_headers_(config.encode_raw_headers()),","+      read_raw_header_value_(config.read_raw_header_value()),"," ","       status_on_error_(toErrorCode(config.status_on_error().code())),","       validate_mutations_(config.validate_mutations()), scope_(scope),","@@ -351,8 +353,8 @@ Filter::createPerRouteGrpcClient(const Grpc::GrpcServiceConfigWithHashKey& confi","                    grpc_service.has_envoy_grpc() ? grpc_service.envoy_grpc().cluster_name()","                                                  : \"google_grpc\");"," ","-  return std::make_unique<Filters::Common::ExtAuthz::GrpcClientImpl>(client_or_error.value(),","-                                                                     timeout);","+  return std::make_unique<Filters::Common::ExtAuthz::GrpcClientImpl>(","+      client_or_error.value(), timeout, config_->emitClientSpan(), config_->readRawHeaderValue());"," }"," "," Filters::Common::ExtAuthz::ClientPtr Filter::createPerRouteHttpClient(","@@ -1385,7 +1387,13 @@ void ShadowDecisionObject::populateProto(ShadowDecisionProto& msg) const {","   for (const auto& [key, value] : response_headers_) {","     auto* hv = msg.add_response_headers();","     hv->set_key(key);","-    hv->set_value(value);","+    // Proto3 string fields reject non-UTF-8 bytes during JSON serialization, so encode","+    // non-UTF-8 header values in raw_value instead.","+    if (utf8_range::IsStructurallyValid(value)) {","+      hv->set_value(value);","+    } else {","+      hv->set_raw_value(value);","+    }","   }"," }"," "],"additions":11,"deletions":3,"truncated":false},{"path":"source/extensions/filters/http/ext_authz/ext_authz.h","lines":["@@ -220,6 +220,8 @@ class FilterConfig {"," ","   bool headersAsBytes() const { return encode_raw_headers_; }"," ","+  bool readRawHeaderValue() const { return read_raw_header_value_; }","+","   Filters::Common::MutationRules::CheckResult","   checkDecoderHeaderMutation(const Filters::Common::MutationRules::CheckOperation& operation,","                              const Http::LowerCaseString& key, absl::string_view value) const {","@@ -357,6 +359,7 @@ class FilterConfig {","   const uint32_t max_denied_response_body_bytes_;","   const bool pack_as_bytes_;","   const bool encode_raw_headers_;","+  const bool read_raw_header_value_;","   const Http::Code status_on_error_;","   const bool validate_mutations_;","   Stats::Scope& scope_;"],"additions":3,"deletions":0,"truncated":false},{"path":"test/extensions/filters/common/ext_authz/BUILD","lines":["@@ -38,6 +38,8 @@ envoy_cc_test(","         \"//source/extensions/filters/common/ext_authz:ext_authz_grpc_lib\",","         \"//test/extensions/filters/common/ext_authz:ext_authz_test_common\",","         \"//test/mocks/tracing:tracing_mocks\",","+        \"@abseil-cpp//absl/strings\",","+        \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/service/auth/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/type/v3:pkg_cc_proto\",","     ],"],"additions":2,"deletions":0,"truncated":false},{"path":"test/extensions/filters/common/ext_authz/ext_authz_grpc_impl_test.cc","lines":["@@ -1,3 +1,4 @@","+#include \"envoy/config/core/v3/base.pb.h\""," #include \"envoy/service/auth/v3/external_auth.pb.h\""," #include \"envoy/type/v3/http_status.pb.h\""," ","@@ -12,6 +13,7 @@"," #include \"test/mocks/stream_info/mocks.h\""," #include \"test/mocks/tracing/mocks.h\""," ","+#include \"absl/strings/string_view.h\""," #include \"gmock/gmock.h\""," #include \"gtest/gtest.h\""," ","@@ -37,6 +39,12 @@ class ExtAuthzGrpcClientTest : public testing::Test {","     client_ = std::make_unique<GrpcClientImpl>(Grpc::RawAsyncClientPtr{async_client_}, timeout_);","   }"," ","+  void initializeWithRawHeaderValue() {","+    client_ = std::make_unique<GrpcClientImpl>(Grpc::RawAsyncClientPtr{async_client_}, timeout_,","+                                               /*emit_client_span=*/true,","+                                               /*read_raw_header_value=*/true);","+  }","+","   void expectCallSend(envoy::service::auth::v3::CheckRequest& request) {","     EXPECT_CALL(*async_client_,","                 sendRaw(_, _, Grpc::ProtoBufferEq(request), Ref(*(client_.get())), _, _))","@@ -753,6 +761,426 @@ TEST_F(ExtAuthzGrpcClientTest, SetEmitClientSpan) {","                      Tracing::NullSpan::instance());"," }"," ","+// Test the client when an ok response uses raw_value with fallback to value.","+TEST_F(ExtAuthzGrpcClientTest, AuthorizationOkWithRawValue) {","+  initializeWithRawHeaderValue();","+","+  const std::string non_utf8_bytes = std::string(\"raw-\\xc0\\xc0\", 6);","+  const std::string raw_append_bytes = std::string(\"append-\\xc3\\x28\", 9);","+","+  auto check_response = std::make_unique<envoy::service::auth::v3::CheckResponse>();","+  check_response->mutable_status()->set_code(Grpc::Status::WellKnownGrpcStatus::Ok);","+  auto* ok_response = check_response->mutable_ok_response();","+","+  auto add_header_with_append = [](auto* repeated_headers, absl::string_view key,","+                                   absl::string_view value, absl::string_view raw_value,","+                                   bool append) {","+    auto* entry = repeated_headers->Add();","+    entry->mutable_append()->set_value(append);","+    entry->mutable_header()->set_key(key);","+    if (!value.empty()) {","+      entry->mutable_header()->set_value(value);","+    }","+    if (!raw_value.empty()) {","+      entry->mutable_header()->set_raw_value(raw_value);","+    }","+  };","+","+  auto add_header_with_action =","+      [](auto* repeated_headers, absl::string_view key, absl::string_view value,","+         absl::string_view raw_value,","+         envoy::config::core::v3::HeaderValueOption::HeaderAppendAction action) {","+        auto* entry = repeated_headers->Add();","+        entry->set_append_action(action);","+        entry->mutable_header()->set_key(key);","+        if (!value.empty()) {","+          entry->mutable_header()->set_value(value);","+        }","+        if (!raw_value.empty()) {","+          entry->mutable_header()->set_raw_value(raw_value);","+        }","+      };","+","+  // Upstream request headers: raw_value only, fallback to value, explicit empty raw_value,","+  // both empty, and raw_value taking precedence.","+  add_header_with_append(ok_response->mutable_headers(), \"x-raw-set\", \"\", non_utf8_bytes, false);","+  add_header_with_append(ok_response->mutable_headers(), \"x-raw-append\", \"\", raw_append_bytes,","+                         true);","+  add_header_with_append(ok_response->mutable_headers(), \"x-fallback-set\", \"legacy-set\", \"\", false);","+  add_header_with_append(ok_response->mutable_headers(), \"x-both-set\", \"legacy-ignored\",","+                         \"raw-preferred\", false);","+","+  auto* explicit_empty_raw = ok_response->add_headers();","+  explicit_empty_raw->mutable_append()->set_value(false);","+  explicit_empty_raw->mutable_header()->set_key(\"x-empty-raw-fallback\");","+  explicit_empty_raw->mutable_header()->set_value(\"explicit-empty-raw-fallback\");","+  explicit_empty_raw->mutable_header()->set_raw_value(\"\");","+","+  auto* both_empty = ok_response->add_headers();","+  both_empty->mutable_append()->set_value(false);","+  both_empty->mutable_header()->set_key(\"x-both-empty\");","+  both_empty->mutable_header()->set_value(\"\");","+  both_empty->mutable_header()->set_raw_value(\"\");","+","+  // Downstream response headers across deprecated append, both-set precedence, and all","+  // append_action variants including an invalid append_action alongside raw_value.","+  add_header_with_append(ok_response->mutable_response_headers_to_add(), \"x-resp-add\", \"\",","+                         non_utf8_bytes, true);","+  add_header_with_append(ok_response->mutable_response_headers_to_add(), \"x-resp-both\",","+                         \"legacy-resp-ignored\", \"resp-both-raw\", true);","+  add_header_with_append(ok_response->mutable_response_headers_to_add(), \"x-resp-set\", \"\",","+                         \"resp-set-raw\", false);","+  add_header_with_action(ok_response->mutable_response_headers_to_add(), \"x-action-append\", \"\",","+                         raw_append_bytes, Router::HeaderValueOption::APPEND_IF_EXISTS_OR_ADD);","+  add_header_with_action(ok_response->mutable_response_headers_to_add(), \"x-action-absent\", \"\",","+                         non_utf8_bytes, Router::HeaderValueOption::ADD_IF_ABSENT);","+  add_header_with_action(ok_response->mutable_response_headers_to_add(), \"x-action-overwrite\", \"\",","+                         \"overwrite-raw\", Router::HeaderValueOption::OVERWRITE_IF_EXISTS);","+  add_header_with_action(ok_response->mutable_response_headers_to_add(), \"x-action-overwrite-add\",","+                         \"fallback-value\", \"\",","+                         Router::HeaderValueOption::OVERWRITE_IF_EXISTS_OR_ADD);","+  add_header_with_action(ok_response->mutable_response_headers_to_add(),","+                         \"x-action-overwrite-add-raw\", \"\", non_utf8_bytes,","+                         Router::HeaderValueOption::OVERWRITE_IF_EXISTS_OR_ADD);","+  add_header_with_action(","+      ok_response->mutable_response_headers_to_add(), \"x-action-invalid\", \"\", non_utf8_bytes,","+      static_cast<envoy::config::core::v3::HeaderValueOption::HeaderAppendAction>(404));","+","+  envoy::service::auth::v3::CheckRequest request;","+  expectCallSend(request);","+  client_->check(request_callbacks_, request, Tracing::NullSpan::instance(), stream_info_);","+","+  EXPECT_CALL(span_, setTag(Eq(\"ext_authz_status\"), Eq(\"ext_authz_ok\")));","+  EXPECT_CALL(request_callbacks_, onComplete_(_)).WillOnce([&](ResponsePtr& response) {","+    EXPECT_EQ(CheckStatus::OK, response->status);","+    EXPECT_EQ(Grpc::Status::WellKnownGrpcStatus::Ok, response->grpc_status);","+    EXPECT_TRUE(response->saw_invalid_append_actions);","+    EXPECT_TRUE(response->headers_to_add.empty());","+    EXPECT_TRUE(response->headers_to_remove.empty());","+    EXPECT_TRUE(response->query_parameters_to_set.empty());","+    EXPECT_TRUE(response->query_parameters_to_remove.empty());","+    EXPECT_TRUE(TestCommon::compareHeaderVector(","+        response->headers_to_set, {{\"x-raw-set\", non_utf8_bytes},","+                                   {\"x-fallback-set\", \"legacy-set\"},","+                                   {\"x-both-set\", \"raw-preferred\"},","+                                   {\"x-empty-raw-fallback\", \"explicit-empty-raw-fallback\"},","+                                   {\"x-both-empty\", \"\"}}));","+    EXPECT_TRUE(TestCommon::compareHeaderVector(response->headers_to_append,","+                                                {{\"x-raw-append\", raw_append_bytes}}));","+    EXPECT_TRUE(TestCommon::compareHeaderVector(response->response_headers_to_add,","+                                                {{\"x-resp-add\", non_utf8_bytes},","+                                                 {\"x-resp-both\", \"resp-both-raw\"},","+                                                 {\"x-action-append\", raw_append_bytes}}));","+    EXPECT_TRUE(TestCommon::compareHeaderVector(response->response_headers_to_set,","+                                                {{\"x-resp-set\", \"resp-set-raw\"},","+                                                 {\"x-action-overwrite-add\", \"fallback-value\"},","+                                                 {\"x-action-overwrite-add-raw\", non_utf8_bytes}}));","+    EXPECT_TRUE(TestCommon::compareHeaderVector(response->response_headers_to_add_if_absent,","+                                                {{\"x-action-absent\", non_utf8_bytes}}));","+    EXPECT_TRUE(TestCommon::compareHeaderVector(response->response_headers_to_overwrite_if_exists,","+                                                {{\"x-action-overwrite\", \"overwrite-raw\"}}));","+  });","+  client_->onSuccess(std::move(check_response), span_);","+}","+","+// Test the client when a denied response uses raw_value with fallback to value.","+TEST_F(ExtAuthzGrpcClientTest, AuthorizationDeniedWithRawValue) {","+  initializeWithRawHeaderValue();","+","+  const std::string non_utf8_bytes = std::string(\"denied-\\xc0\\xc0\", 9);","+  const std::string raw_append_bytes = std::string(\"denied-append-\\xc3\\x28\", 16);","+","+  auto check_response = std::make_unique<envoy::service::auth::v3::CheckResponse>();","+  check_response->mutable_status()->set_code(Grpc::Status::WellKnownGrpcStatus::PermissionDenied);","+  auto* denied_response = check_response->mutable_denied_response();","+  denied_response->mutable_status()->set_code(envoy::type::v3::Unauthorized);","+","+  auto* raw_header = denied_response->add_headers();","+  raw_header->mutable_header()->set_key(\"x-denied-raw\");","+  raw_header->mutable_header()->set_raw_value(non_utf8_bytes);","+","+  auto* fallback_header = denied_response->add_headers();","+  fallback_header->mutable_header()->set_key(\"x-denied-fallback\");","+  fallback_header->mutable_header()->set_value(\"legacy-denied\");","+","+  auto* both_header = denied_response->add_headers();","+  both_header->mutable_header()->set_key(\"x-denied-both\");","+  both_header->mutable_header()->set_value(\"legacy-ignored\");","+  both_header->mutable_header()->set_raw_value(\"raw-preferred\");","+","+  auto* append_raw_header = denied_response->add_headers();","+  append_raw_header->mutable_append()->set_value(true);","+  append_raw_header->mutable_header()->set_key(\"x-denied-append-raw\");","+  append_raw_header->mutable_header()->set_raw_value(raw_append_bytes);","+","+  auto* append_fallback_header = denied_response->add_headers();","+  append_fallback_header->mutable_append()->set_value(true);","+  append_fallback_header->mutable_header()->set_key(\"x-denied-append-fallback\");","+  append_fallback_header->mutable_header()->set_value(\"legacy-denied-append\");","+","