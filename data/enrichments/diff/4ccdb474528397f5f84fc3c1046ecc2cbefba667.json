en","+non-empty, falling back to :ref:`HeaderValue.value","+<envoy_v3_api_field_config.core.v3.HeaderValue.value>` when ``raw_value`` is empty, allowing gRPC","+authorization servers to return non-UTF-8 header values. Also updated shadow mode so","+:ref:`ShadowDecision.response_headers","+<envoy_v3_api_field_extensions.filters.http.ext_authz.v3.ShadowDecision.response_headers>`","+populates ``raw_value`` instead of ``value`` when a denied response header value contains","+non-UTF-8 bytes."],"additions":11,"deletions":0,"truncated":false},{"path":"source/extensions/filters/common/ext_authz/ext_authz_grpc_impl.cc","lines":["@@ -16,48 +16,59 @@ namespace Filters {"," namespace Common {"," namespace ExtAuthz {"," ","+namespace {","+","+const std::string& getHeaderValue(const envoy::config::core::v3::HeaderValue& header,","+                                  bool read_raw_value) {","+  // Prefer raw_value when populated so non-UTF-8 bytes are preserved, and fall back to value for","+  // backwards compatibility with authorization servers that only populate value.","+  if (read_raw_value && !header.raw_value().empty()) {","+    return header.raw_value();","+  }","+  return header.value();","+}","+"," void copyHeaderFieldIntoResponse(","     ResponsePtr& response,","-    const Protobuf::RepeatedPtrField<envoy::config::core::v3::HeaderValueOption>& headers) {","+    const Protobuf::RepeatedPtrField<envoy::config::core::v3::HeaderValueOption>& headers,","+    bool read_raw_value) {","   for (const auto& header : headers) {","+    const std::string& value = getHeaderValue(header.header(), read_raw_value);","     if (header.append().value()) {","-      response->headers_to_append.emplace_back(header.header().key(), header.header().value());","+      response->headers_to_append.emplace_back(header.header().key(), value);","     } else {","-      response->headers_to_set.emplace_back(header.header().key(), header.header().value());","+      response->headers_to_set.emplace_back(header.header().key(), value);","     }","   }"," }"," "," void copyOkResponseMutations(ResponsePtr& response,","-                             const envoy::service::auth::v3::OkHttpResponse& ok_response) {","-  copyHeaderFieldIntoResponse(response, ok_response.headers());","+                             const envoy::service::auth::v3::OkHttpResponse& ok_response,","+                             bool read_raw_value) {","+  copyHeaderFieldIntoResponse(response, ok_response.headers(), read_raw_value);"," ","   for (const auto& header : ok_response.response_headers_to_add()) {","+    const std::string& value = getHeaderValue(header.header(), read_raw_value);","     if (header.has_append()) {","       if (header.append().value()) {","-        response->response_headers_to_add.emplace_back(header.header().key(),","-                                                       header.header().value());","+        response->response_headers_to_add.emplace_back(header.header().key(), value);","       } else {","-        response->response_headers_to_set.emplace_back(header.header().key(),","-                                                       header.header().value());","+        response->response_headers_to_set.emplace_back(header.header().key(), value);","       }","     } else {","       switch (header.append_action()) {","       case Router::HeaderValueOption::APPEND_IF_EXISTS_OR_ADD:","-        response->response_headers_to_add.emplace_back(header.header().key(),","-                                                       header.header().value());","+        response->response_headers_to_add.emplace_back(header.header().key(), value);","         break;","       case Router::HeaderValueOption::ADD_IF_ABSENT:","-        response->response_headers_to_add_if_absent.emplace_back(header.header().key(),","-                                                                 header.header().value());","+        response->response_headers_to_add_if_absent.emplace_back(header.header().key()