","+","+import java.io.IOException;","+import java.net.Authenticator;","+import java.net.CookieHandler;","+import java.net.ProxySelector;","+import java.net.http.HttpClient;","+import java.net.http.HttpRequest;","+import java.net.http.HttpResponse;","+import java.nio.charset.StandardCharsets;","+import java.time.Duration;","+import java.util.Base64;","+import java.util.List;","+import java.util.Optional;","+import java.util.concurrent.CompletableFuture;","+import java.util.concurrent.Executor;","+import java.util.function.UnaryOperator;","+","+import javax.net.ssl.SSLContext;","+import javax.net.ssl.SSLParameters;","+","+/**","+ * Sends the JVM proxy credentials ({@code http(s).proxyUser} and {@code http(s).proxyPassword}) with every","+ * request, which {@code java.net.http.HttpClient} never reads on its own.","+ *","+ * <p>The JDK only forwards a {@code Proxy-Authorization} header to a proxy, never to the target server. An","+ * {@link Authenticator} is deliberately not used: once one is set, the JDK fails a 401 from the target server","+ * instead of returning it. For an HTTPS target the JVM must also be started with","+ * {@code -Djdk.http.auth.tunneling.disabledSchemes=}, since the JDK drops Basic credentials on a tunnel by default.","+ */","+public final class ProxyAuthorizingHttpClient extends HttpClient {","+    private static final String PROXY_AUTHORIZATION = \"Proxy-Authorization\";","+    private static final List<String> SCHEMES = List.of(\"https\", \"http\");","+","+    private final HttpClient delegate;","+    private final UnaryOperator<String> properties;","+","+    private ProxyAuthorizingHttpClient(HttpClient delegate, UnaryOperator<String> properties) {","+        this.delegate = delegate;","+        this.properties = properties;","+    }","+","+    public static boolean isConfigured() {","+        return SCHEMES.stream().anyMatch(scheme -> proxyAuthorization(System::getProperty, scheme).isPresent());","+    }","+","+    public static HttpClient.Builder builder(HttpClient.Builder delegate) {","+        return builder(delegate, System::getProperty);","+    }","+","+    static HttpClient.Builder builder(HttpClient.Builder delegate, UnaryOperator<String> properties) {","+        return new Builder(delegate, properties);","+    }","+","+    @Override","+    public <T> HttpResponse<T> send(HttpRequest request, HttpResponse.BodyHandler<T> responseBodyHandler) throws IOException, InterruptedException {","+        return delegate.send(authorize(request), responseBodyHandler);","+    }","+","+    @Override","+    public <T> CompletableFuture<HttpResponse<T>> sendAsync(HttpRequest request, HttpResponse.BodyHandler<T> responseBodyHandler) {","+        return delegate.sendAsync(authorize(request), responseBodyHandler);","+    }","+","+    @Override","+    public <T> CompletableFuture<HttpResponse<T>> sendAsync(","+        HttpRequest request,","+        HttpResponse.BodyHandler<T> responseBodyHandler,","+        HttpResponse.PushPromiseHandler<T> pushPromiseHandler","+    ) {","+        return delegate.sendAsync(authorize(request), responseBodyHandler, pushPromiseHandler);","+    }","+","+    @Override","+    public Optional<CookieHandler> cookieHandler() {","+        return delegate.cookieHandler();","+    }","+","+    @Override","+    public Optional<Duration> connectTimeout() {","+        return delegate.connectTimeout();","+    }","+","+    @Override","+    public Redirect followRedirects() {","+        return delegate.followRedirects();","+    }","+","+    @Override","+    public Optional<ProxySelector> proxy() {","+        return delegate.proxy();","+    }","+","+    @Override","+    public SSLContext sslContext() {","+        return delegate.sslContext();","+    }","+","+    @Override","+    public SSLParameters sslParameters() {","+        return delegate.sslParameters();","+    }","+","+    @Override","+    public Optional<Authenticator> authenticator() {","+        return delegate.authenticator();","+    }","