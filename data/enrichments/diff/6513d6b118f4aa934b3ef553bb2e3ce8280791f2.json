{"id":"6513d6b118f4aa934b3ef553bb2e3ce8280791f2","axis":"silent","repo":"rustwasm/wasm-bindgen","sha":"6513d6b118f4aa934b3ef553bb2e3ce8280791f2","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -76,6 +76,17 @@"," "," ### Changed"," ","+* **Breaking (experimental):** `experimental_generic_mono` imports no longer add","+  hidden ABI bounds to the generated wrapper. The conversion bounds each","+  position needs are now declared on the import like any other bound:","+  `T: IntoWasmAbi` for an argument, `T: RefIntoWasmAbi` (a new trait in","+  `wasm_bindgen::convert`) for a `&T` argument, `T: VectorRefIntoWasmAbi` for a","+  `&[T]` or `Option<&[T]>` argument, `T: FromWasmAbi` for a return","+  (`+ 'static` when `async`), `A: FromWasmAbi` for a callback argument and","+  `R: IntoWasmAbi` for a callback return. A missing bound is reported at the","+  position that needs it.","+  [#5385](https://github.com/wasm-bindgen/wasm-bindgen/pull/5385)","+"," * The generated `TextDecoder` no longer sets `fatal: true`. Rust `&str` is","   always valid UTF-8, so this only removes a redundant check and lets","   `JsValue::from_str` and `JsValue::from_utf8_lossy` share a single decoder."],"additions":11,"deletions":0,"truncated":false},{"path":"crates/cli/tests/reference/generic-import.bg.js","lines":["@@ -209,7 +209,12 @@ export function __wbindgen_generic_0000000000000012(arg0, arg1, arg2) {","     // generic import `fillSlice`: [RefMut(Slice(U16)), U32] -> Unit","     fillSlice(getArrayU16FromWasm0(arg0, arg1), arg2 >>> 0);"," }","-export function __wbindgen_generic_0000000000000013(arg0, arg1) {","+export function __wbindgen_generic_0000000000000013(arg0, arg1, arg2) {","+    // generic import `get`: [Ref(Externref), Ref(String)] -> U32","+    const ret = arg0[getStringFromWasm0(arg1, arg2)];","+    return ret;","+}","+export function __wbindgen_generic_0000000000000014(arg0, arg1) {","     // generic import `get`: [Ref(Externref)] -> String","     const ret = arg1.get();","  