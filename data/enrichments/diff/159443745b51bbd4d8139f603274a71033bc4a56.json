ontroller.Request{{"," \t\t\t\tKind: structs.TCPRoute,"," \t\t\t\tName: \"tcp-route\",","@@ -4205,6 +4212,10 @@ func TestAPIGatewayController(t *testing.T) {"," \t\t\t\trequire.NoError(t, reconciler.Reconcile(ctx, req))"," \t\t\t}"," ","+\t\t\tif !tc.skipBoundConfigSync {","+\t\t\t\tsyncExpectedBoundListenerConfig(tc.finalEntries, tc.initialEntries)","+\t\t\t}","+"," \t\t\t_, entries, err := fsm.State().ConfigEntries(nil, acl.WildcardEnterpriseMeta())"," \t\t\trequire.NoError(t, err)"," \t\t\tfor _, entry := range entries {","@@ -4316,3 +4327,250 @@ func (n *noopController) RemoveTrigger(request controller.Request) {"," func (n *noopController) Enqueue(requests ...controller.Request) {"," \tn.enqueued = append(n.enqueued, requests...)"," }","+","+// syncExpectedBoundListenerConfig copies listener configuration from the","+// APIGateway fixtures onto the expected BoundAPIGateway fixtures. The","+// reconciler's contract is that a bound listener mirrors its parent gateway","+// listener's configuration, so deriving the expectation from the gateway","+// fixture keeps these table entries focused on route and certificate binding","+// while still asserting the mirrored config via IsSame.","+//","+// Listeners are collected per gateway/listener name across every source, with","+// the first source winning. Sources are passed initial-entries-first because","+// the reconciler never rewrites an APIGateway's listeners, so the seeded entry","+// is the source of truth; many finalEntries fixtures declare the gateway only","+// to assert status and elide or partially restate its listeners.","+func syncExpectedBoundListenerConfig(expected []structs.ConfigEntry, gatewaySources ...[]structs.ConfigEntry) {","+\ttype listenerKey struct {","+\t\tgateway structs.ServiceID","+\t\tname    string","+\t}","+","+\tlisteners := map[listenerKey]structs.APIGatewayListener{}","+\tfor _, source := range append(gatewaySources, expected) {","+\t\tfor _, entry := range source {","+\t\t\tgateway, ok := entry.(*structs.APIGatewayConfigEntry)","+\t\t\tif !ok {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tid := structs.NewServiceID(gateway.Name, &gateway.EnterpriseMeta)","+\t\t\tfor _, listener := range gateway.Listeners {","+\t\t\t\tkey := listenerKey{gateway: id, name: listener.Name}","+\t\t\t\tif _, ok := listeners[key]; !ok {","+\t\t\t\t\tlisteners[key] = listener","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+","+\tfor _, entry := range expected {","+\t\tbound, ok := entry.(*structs.BoundAPIGatewayConfigEntry)","+\t\tif !ok {","+\t\t\tcontinue","+\t\t}","+\t\tid := structs.NewServiceID(bound.Name, &bound.EnterpriseMeta)","+\t\tfor i := range bound.Listeners {","+\t\t\tlistener, ok := listeners[listenerKey{gateway: id, name: bound.Listeners[i].Name}]","+\t\t\tif !ok {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tbound.Listeners[i].SetConfigFromListener(listener)","+\t\t}","+\t}","+}","+","+// TestAPIGatewayControllerBoundListenerConfigStaleness is a regression test for","+// the bound listener configuration fields being effectively write-once.","+//","+// BoundAPIGatewayListener carries a copy of its parent APIGatewayListener's","+// configuration. That copy was previously only ever set when the bound entry","+// was first created: BoundAPIGatewayListener.IsSame ignored the copied fields,","+// so the gateway reconcile path decided nothing had changed and skipped the","+// write, while the route reconcile path wrote back the stored entry verbatim.","+//","+// The practical effect was that a gateway whose bound entry was created before","+// these fields existed (i.e. any gateway that survived an upgrade) was left","+// with Port 0 and an empty Protocol forever, and the only remedy was deleting","+// and recreating the gateway.","+func TestAPIGatewayControllerBoundListenerConfigStaleness(t *testing.T) {","+\tt.Parallel()","+","+\tdefaultMeta := acl.DefaultEnterpriseMeta()","+","+\tgateway := func(port int, protocol structs.APIGatewayListenerProtocol) *structs.APIGatewayConfigEntry {","+\t\treturn &structs.APIGatewayConfigEntry{","+\t\t\tKind:           structs.APIGateway,","+\t\t\tName:           \"gateway\",","+\t\t\tEnterpriseMeta: *defaultMeta,","+\t\t\tListeners: []structs.APIGatewayListener{{","+\t\t\t\tName:     \"listener\",","+\t\t\t\tPort:     port,","+\t\t\t\tProtocol: protocol,","+\t\t\t}},","+\t\t\tStatus: structs.Status{","+\t\t\t\tConditions: []structs.Condition{","+\t\t\t\t\tgatewayAccepted(),","+\t\t\t\t\tgatewayListenerNoConflicts(structs.ResourceReference{","+\t\t\t\t\t\tKind:           structs.APIGateway,","+\t\t\t\t\t\tName:           \"gateway\",","+\t\t\t\t\t\tSectionName:    \"listener\",","+\t\t\t\t\t\tEnterpriseMeta: *defaultMeta,","+\t\t\t\t\t}),","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t}","+","+\t// staleBound models a bound entry written before the configuration fields","+\t// were introduced: it has the binding state but no listener config.","+\tstaleBound := func() *structs.BoundAPIGatewayConfigEntry {","+\t\treturn &structs.BoundAPIGatewayConfigEntry{","+\t\t\tKind:           structs.BoundAPIGateway,","+\t\t\tName:           \"gateway\",","+\t\t\tEnterpriseMeta: *defaultMeta,","+\t\t\tListeners: []structs.BoundAPIGatewayListener{{","+\t\t\t\tName: \"listener\",","+\t\t\t}},","+\t\t}","+\t}","+","+\troute := &structs.TCPRouteConfigEntry{","+\t\tKind:           structs.TCPRoute,","+\t\tName:           \"tcp-route\",","+\t\tEnterpriseMeta: *defaultMeta,","+\t\tServices:       []structs.TCPService{{Name: \"tcp-upstream\"}},","+\t\tParents: []structs.ResourceReference{{","+\t\t\tKind:           structs.APIGateway,","+\t\t\tName:           \"gateway\",","+\t\t\tEnterpriseMeta: *defaultMeta,","+\t\t}},","+\t\t// A route only binds once it has been accepted.","+\t\tStatus: structs.Status{","+\t\t\tConditions: []structs.Condition{routeAccepted()},","+\t\t},","+\t}","+","+\tfor name, tc := range map[string]struct {","+\t\tinitialEntries []structs.ConfigEntry","+\t\trequest        controller.Request","+\t\t// assertSubsequentChange is only set for the gateway reconcile path.","+\t\t// The route path deliberately writes the bound entry only when route","+\t\t// binding actually changes, so a config-only edit does not trigger a","+\t\t// write there; its contract is just to never resurrect stale config.","+\t\tassertSubsequentChange bool","+\t}{","+\t\t\"gateway reconcile repairs a bound entry with no listener config\": {","+\t\t\tassertSubsequentChange: true,","+\t\t\tinitialEntries: []structs.ConfigEntry{","+\t\t\t\tgateway(8443, structs.ListenerProtocolTCP),","+\t\t\t\tstaleBound(),","+\t\t\t},","+\t\t\trequest: controller.Request{","+\t\t\t\tKind: structs.APIGateway,","+\t\t\t\tName: \"gateway\",","+\t\t\t\tMeta: defaultMeta,","+\t\t\t},","+\t\t},","+\t\t\"route reconcile does not write back stale listener config\": {","+\t\t\tinitialEntries: []structs.ConfigEntry{","+\t\t\t\tgateway(8443, structs.ListenerProtocolTCP),","+\t\t\t\tstaleBound(),","+\t\t\t\troute,","+\t\t\t},","+\t\t\trequest: controller.Request{","+\t\t\t\tKind: structs.TCPRoute,","+\t\t\t\tName: \"tcp-route\",","+\t\t\t\tMeta: defaultMeta,","+\t\t\t},","+\t\t},","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)","+\t\t\tdefer cancel()","+","+\t\t\tpublisher := stream.NewEventPublisher(1 * time.Millisecond)","+\t\t\tgo publisher.Run(ctx)","+","+\t\t\tfsm := fsm.NewFromDeps(fsm.Deps{","+\t\t\t\tLogger: hclog.New(nil),","+\t\t\t\tNewStateStore: func() *state.Store {","+\t\t\t\t\treturn state.NewStateStoreWithEventPublisher(nil, publisher)","+\t\t\t\t},","+\t\t\t\tPublisher:      publisher,","+\t\t\t\tStorageBackend: fsm.NullStorageBackend,","+\t\t\t})","+","+\t\t\tvar index uint64","+\t\t\tupdater := &Updater{","+\t\t\t\tUpdateWithStatus: func(entry structs.ControlledConfigEntry) error {","+\t\t\t\t\tindex++","+\t\t\t\t\t_, err := fsm.State().EnsureConfigEntryWithStatusCAS(index, entry.GetRaftIndex().ModifyIndex, entry)","+\t\t\t\t\treturn err","+\t\t\t\t},","+\t\t\t\tUpdate: func(entry structs.ConfigEntry) error {","+\t\t\t\t\tindex++","+\t\t\t\t\t_, err := fsm.State().EnsureConfigEntryCAS(index, entry.GetRaftIndex().ModifyIndex, entry)","+\t\t\t\t\treturn err","+\t\t\t\t},","+\t\t\t\tDelete: func(entry structs.ConfigEntry) error {","+\t\t\t\t\tindex++","+\t\t\t\t\t_, err := fsm.State().DeleteConfigEntryCAS(index, entry.GetRaftIndex().ModifyIndex, entry)","+\t\t\t\t\treturn err","+\t\t\t\t},","+\t\t\t}","+","+\t\t\tfor _, entry := range tc.initialEntries {","+\t\t\t\tif controlled, ok := entry.(structs.ControlledConfigEntry); ok {","+\t\t\t\t\trequire.NoError(t, updater.UpdateWithStatus(controlled))","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\trequire.NoError(t, updater.Update(entry))","+\t\t\t}","+","+\t\t\treconciler := apiGatewayReconciler{","+\t\t\t\tfsm:        fsm,","+\t\t\t\tlogger:     hclog.Default(),","+\t\t\t\tupdater:    updater,","+\t\t\t\tcontroller: &noopController{triggers: make(map[controller.Request]struct{})},","+\t\t\t}","+","+\t\t\treadBoundListener := func() structs.BoundAPIGatewayListener {","+\t\t\t\t_, entry, err := fsm.State().ConfigEntry(nil, structs.BoundAPIGateway, \"gateway\", defaultMeta)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.NotNil(t, entry)","+\t\t\t\tbound := entry.(*structs.BoundAPIGatewayConfigEntry)","+\t\t\t\trequire.Len(t, bound.Listeners, 1)","+\t\t\t\treturn bound.Listeners[0]","+\t\t\t}","+","+\t\t\t// Sanity check that the seeded entry really is stale, otherwise the","+\t\t\t// assertions below would pass without exercising anything.","+\t\t\tseeded := readBoundListener()","+\t\t\trequire.Zero(t, seeded.Port)","+\t\t\trequire.Empty(t, seeded.Protocol)","+","+\t\t\trequire.NoError(t, reconciler.Reconcile(ctx, tc.request))","+","+\t\t\trepaired := readBoundListener()","+\t\t\trequire.Equal(t, 8443, repaired.Port)","+\t\t\trequire.Equal(t, structs.ListenerProtocolTCP, repaired.Protocol)","+","+\t\t\tif !tc.assertSubsequentChange {","+\t\t\t\treturn","+\t\t\t}","+","+\t\t\t// A subsequent configuration change must also propagate, rather","+\t\t\t// than the first successful write becoming the new permanent state.","+\t\t\t_, current, err := fsm.State().ConfigEntry(nil, structs.APIGateway, \"gateway\", defaultMeta)","+\t\t\trequire.NoError(t, err)","+\t\t\tchanged := gateway(9443, structs.ListenerProtocolTCP)","+\t\t\t// Carry the current index forward so the CAS write is not a no-op.","+\t\t\tchanged.RaftIndex = *current.GetRaftIndex()","+\t\t\trequire.NoError(t, updater.UpdateWithStatus(changed))","+\t\t\trequire.NoError(t, reconciler.Reconcile(ctx, tc.request))","+","+\t\t\tupdated := readBoundListener()","+\t\t\trequire.Equal(t, 9443, updated.Port)","+\t\t})","+\t}","+}"],"additions":258,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog.go","lines":["@@ -2988,9 +2988,79 @@ func (s *Store) CheckAPIGatewayServiceNodes(ws memdb.WatchSet, serviceName strin"," \t\tmaxIdx = lib.MaxUint64(maxIdx, idx)"," \t\tresults = append(results, n...)"," \t}","+","+\t// The nodes above are the gateway's own catalog registrations, whose","+\t// ServicePort describes the gateway service rather than the listener that","+\t// actually fronts serviceName. Registrations made by consul-k8s carry no","+\t// port at all, which is what makes SRV lookups answer with port 0. Rewrite","+\t// the port from the gateway-services mapping, which records the bound","+\t// listener port per routed service.","+\tports, err := apiGatewayListenerPorts(tx, serviceName, entMeta)","+\tif err != nil {","+\t\treturn 0, nil, err","+\t}","+\tresults = withAPIGatewayListenerPorts(results, ports)","+"," \treturn maxIdx, results, nil"," }"," ","+// apiGatewayListenerPorts returns, per API gateway fronting the given service,","+// the bound listener ports that route to it. A gateway can front the same","+// service on several listeners, so each gateway maps to a set of ports.","+func apiGatewayListenerPorts(tx ReadTxn, service string, entMeta *acl.EnterpriseMeta) (map[structs.ServiceName][]int, error) {","+\tgws, err := tx.Get(tableGatewayServices, indexService, structs.NewServiceName(service, entMeta))","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed gateway lookup: %s\", err)","+\t}","+","+\tports := map[structs.ServiceName][]int{}","+\tfor gateway := gws.Next(); gateway != nil; gateway = gws.Next() {","+\t\tmapping := gateway.(*structs.GatewayService)","+\t\tif mapping.GatewayKind != structs.ServiceKindAPIGateway || mapping.Port == 0 {","+\t\t\tcontinue","+\t\t}","+\t\tname := structs.NewServiceName(mapping.Gateway.Name, &mapping.Gateway.EnterpriseMeta)","+\t\tif slices.Contains(ports[name], mapping.Port) {","+\t\t\tcontinue","+\t\t}","+\t\tports[name] = append(ports[name], mapping.Port)","+\t}","+","+\tfor name := range ports {","+\t\tsort.Ints(ports[name])","+\t}","+\treturn ports, nil","+}","+","+// withAPIGatewayListenerPorts rewrites each node's service port to the bound","+// listener port that fronts the requested service. A gateway listening for the","+// service on more than one port yields one node per port, so that an SRV lookup","+// advertises every listener the client could use.","+//","+// Nodes are copied before mutation: the originals are shared, immutable memdb","+// objects.","+func withAPIGatewayListenerPorts(nodes structs.CheckServiceNodes, ports map[structs.ServiceName][]int) structs.CheckServiceNodes {","+\tif len(ports) == 0 {","+\t\treturn nodes","+\t}","+","+\tresults := make(structs.CheckServiceNodes, 0, len(nodes))","+\tfor _, node := range nodes {","+\t\tlistenerPorts := ports[node.Service.CompoundServiceName()]","+\t\tif len(listenerPorts) == 0 {","+\t\t\tresults = append(results, node)","+\t\t\tcontinue","+\t\t}","+\t\tfor _, port := range listenerPorts {","+\t\t\twithPort := node","+\t\t\twithPort.Service = node.Service.DeepCopy()","+\t\t\twithPort.Service.Port = port","+\t\t\tresults = append(results, withPort)","+\t\t}","+\t}","+\treturn results","+}","+"," func (s *Store) checkServiceNodes(ws memdb.WatchSet, serviceName string, connect bool, entMeta *acl.EnterpriseMeta, peerName string) (uint64, structs.CheckServiceNodes, error) {"," \ttx := s.db.Txn(false)"," \tdefer tx.Abort()"],"additions":70,"deletions":0,"truncated":false},{"path":"agent/consul/state/catalog_apigateway_test.go","lines":["@@ -198,3 +198,145 @@ func TestStateStore_GatewayServices_APIGateway_MultiRoute(t *testing.T) {"," \trequire.Equal(t, 9000, byService[\"tcp-backend\"].Port)"," \trequire.Equal(t, \"tcp\", byService[\"tcp-backend\"].Protocol)"," }","+","+// registerAPIGatewayWithPort registers an api-gateway service instance with an","+// explicit catalog port. Port 0 reproduces what consul-k8s writes: its","+// registration builds an api.AgentService with no Port field at all, whereas a","+// hand-registered gateway carries a real one.","+func registerAPIGatewayWithPort(t *testing.T, s *Store, idx uint64, node, name string, port int) {","+\tt.Helper()","+\trequire.NoError(t, s.EnsureService(idx, node, &structs.NodeService{","+\t\tID:      name,","+\t\tService: name,","+\t\tKind:    structs.ServiceKindAPIGateway,","+\t\tAddress: \"1.1.1.1\",","+\t\tPort:    port,","+\t}))","+}","+","+// TestStateStore_CheckAPIGatewayServiceNodes_ListenerPort asserts that DNS","+// lookups for a service fronted by an API gateway report the gateway's bound","+// *listener* port rather than the port on the gateway's catalog registration.","+//","+// This is the root of the \"SRV records answer with port 0\" issue: the DNS SRV","+// path resolves the port via findPort -> NodeService.Port, and","+// CheckAPIGatewayServiceNodes used to return the gateway's raw catalog","+// registration. consul-k8s registers gateways without a port, so SRV answered","+// 0; only a hand-registered gateway (which sets one) appeared to work, and even","+// then it reported the registration port rather than the listener port.","+func TestStateStore_CheckAPIGatewayServiceNodes_ListenerPort(t *testing.T) {","+\tfor name, tc := range map[string]struct {","+\t\tregisteredPort int","+\t}{","+\t\t\"gateway registered without a port (consul-k8s)\": {registeredPort: 0},","+\t\t\"gateway registered with a port (hand-rolled)\":   {registeredPort: 1111},","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\ts := testStateStore(t)","+","+\t\t\ttestRegisterNode(t, s, 0, \"node1\")","+\t\t\tregisterAPIGatewayWithPort(t, s, 1, \"node1\", \"api-gw\", tc.registeredPort)","+\t\t\ttestRegisterConnectService(t, s, 2, \"node1\", \"web\")","+","+\t\t\trequire.NoError(t, s.EnsureConfigEntry(3, &structs.ProxyConfigEntry{","+\t\t\t\tName:   structs.ProxyConfigGlobal,","+\t\t\t\tKind:   structs.ProxyDefaults,","+\t\t\t\tConfig: map[string]interface{}{\"protocol\": \"http\"},","+\t\t\t}))","+\t\t\trequire.NoError(t, s.EnsureConfigEntry(4, &structs.APIGatewayConfigEntry{","+\t\t\t\tKind: structs.APIGateway,","+\t\t\t\tName: \"api-gw\",","+\t\t\t\tListeners: []structs.APIGatewayListener{","+\t\t\t\t\t{Name: \"http-listener\", Port: 8443, Protocol: structs.ListenerProtocolHTTP},","+\t\t\t\t},","+\t\t\t}))","+\t\t\trequire.NoError(t, s.EnsureConfigEntry(5, &structs.HTTPRouteConfigEntry{","+\t\t\t\tKind:    structs.HTTPRoute,","+\t\t\t\tName:    \"web-route\",","+\t\t\t\tParents: []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\t\t\tRules:   []structs.HTTPRouteRule{{Services: []structs.HTTPService{{Name: \"web\"}}}},","+\t\t\t}))","+\t\t\trequire.NoError(t, s.EnsureConfigEntry(6, &structs.BoundAPIGatewayConfigEntry{","+\t\t\t\tKind: structs.BoundAPIGateway,","+\t\t\t\tName: \"api-gw\",","+\t\t\t\tListeners: []structs.BoundAPIGatewayListener{{","+\t\t\t\t\tName:     \"http-listener\",","+\t\t\t\t\tPort:     8443,","+\t\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\t\tRoutes:   []structs.ResourceReference{{Kind: structs.HTTPRoute, Name: \"web-route\"}},","+\t\t\t\t}},","+\t\t\t}))","+","+\t\t\t_, nodes, err := s.CheckAPIGatewayServiceNodes(memdb.NewWatchSet(), \"web\", nil)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Len(t, nodes, 1)","+\t\t\trequire.Equal(t, \"api-gw\", nodes[0].Service.Service)","+\t\t\trequire.Equal(t, 8443, nodes[0].Service.Port,","+\t\t\t\t\"DNS must report the bound listener port, not the catalog registration port\")","+","+\t\t\t// The catalog registration itself must be untouched: the nodes above","+\t\t\t// are shared memdb objects and rewriting them in place would corrupt","+\t\t\t// every other reader.","+\t\t\t_, direct, err := s.NodeServices(memdb.NewWatchSet(), \"node1\", nil, \"\")","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, tc.registeredPort, direct.Services[\"api-gw\"].Port,","+\t\t\t\t\"the gateway's own registration must not be mutated\")","+\t\t})","+\t}","+}","+","+// TestStateStore_CheckAPIGatewayServiceNodes_MultipleListenerPorts covers a","+// gateway fronting the same service on two listeners: DNS should advertise both","+// ports so a client can reach either listener.","+func TestStateStore_CheckAPIGatewayServiceNodes_MultipleListenerPorts(t *testing.T) {","+\ts := testStateStore(t)","+","+\ttestRegisterNode(t, s, 0, \"node1\")","+\tregisterAPIGatewayWithPort(t, s, 1, \"node1\", \"api-gw\", 0)","+\ttestRegisterConnectService(t, s, 2, \"node1\", \"web\")","+","+\trequire.NoError(t, s.EnsureConfigEntry(3, &structs.ProxyConfigEntry{","+\t\tName:   structs.ProxyConfigGlobal,","+\t\tKind:   structs.ProxyDefaults,","+\t\tConfig: map[string]interface{}{\"protocol\": \"http\"},","+\t}))","+\trequire.NoError(t, s.EnsureConfigEntry(4, &structs.APIGatewayConfigEntry{","+\t\tKind: structs.APIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.APIGatewayListener{","+\t\t\t{Name: \"listener-a\", Port: 8443, Protocol: structs.ListenerProtocolHTTP},","+\t\t\t{Name: \"listener-b\", Port: 9443, Protocol: structs.ListenerProtocolHTTP},","+\t\t},","+\t}))","+\trequire.NoError(t, s.EnsureConfigEntry(5, &structs.HTTPRouteConfigEntry{","+\t\tKind:    structs.HTTPRoute,","+\t\tName:    \"web-route\",","+\t\tParents: []structs.ResourceReference{{Kind: structs.APIGateway, Name: \"api-gw\"}},","+\t\tRules:   []structs.HTTPRouteRule{{Services: []structs.HTTPService{{Name: \"web\"}}}},","+\t}))","+\trequire.NoError(t, s.EnsureConfigEntry(6, &structs.BoundAPIGatewayConfigEntry{","+\t\tKind: structs.BoundAPIGateway,","+\t\tName: \"api-gw\",","+\t\tListeners: []structs.BoundAPIGatewayListener{","+\t\t\t{","+\t\t\t\tName:     \"listener-a\",","+\t\t\t\tPort:     8443,","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tRoutes:   []structs.ResourceReference{{Kind: structs.HTTPRoute, Name: \"web-route\"}},","+\t\t\t},","+\t\t\t{","+\t\t\t\tName:     \"listener-b\",","+\t\t\t\tPort:     9443,","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tRoutes:   []structs.ResourceReference{{Kind: structs.HTTPRoute, Name: \"web-route\"}},","+\t\t\t},","+\t\t},","+\t}))","+","+\t_, nodes, err := s.CheckAPIGatewayServiceNodes(memdb.NewWatchSet(), \"web\", nil)","+\trequire.NoError(t, err)","+\trequire.Len(t, nodes, 2)","+","+\tports := []int{nodes[0].Service.Port, nodes[1].Service.Port}","+\trequire.ElementsMatch(t, []int{8443, 9443}, ports)","+}"],"additions":142,"deletions":0,"truncated":false},{"path":"agent/proxycfg/api_gateway.go","lines":["@@ -796,13 +796,78 @@ func (h *handlerAPIGateway) watchIngressLeafCert(ctx context.Context, snap *Conf"," \treturn nil"," }"," ","+// apiGatewayTLSServingEnabled returns true if downstream TLS termination is","+// active on the API gateway — either globally via the gateway-level TLS flag","+// (APIGatewayConfigEntry.TLS.Enabled) or on at least one bound listener (a","+// listener carries certificates or an SDS source).","+//","+// This mirrors connectTLSServingEnabled used by ingress gateways. DNS SANs are","+// only needed when the gateway actually terminates TLS for downstream clients.","+//","+// Note: the leaf cert itself is always requested (see watchIngressLeafCert)","+// because the gateway needs it as a client cert for outbound mTLS even when no","+// listener terminates downstream TLS. Only the DNS SAN set is gated here.","+func apiGatewayTLSServingEnabled(snap *ConfigSnapshot) bool {","+\t// Gateway-level global TLS flag (APIGatewayConfigEntry.TLS.Enabled).","+\tif snap.APIGateway.TLSConfig.Enabled {","+\t\treturn true","+\t}","+","+\t// Check gateway-level TLS configuration. This mirrors the xDS builder logic","+\t// (listeners_apigateway.go:644-649) which considers the config non-empty if:","+\t// - SDS is configured with a CertResource","+\t// - TLSMinVersion is set","+\t// - TLSMaxVersion is set","+\t// - CipherSuites is configured","+\tgatewayTLSCfg := &snap.APIGateway.TLSConfig","+","+\t// Check gateway-level SDS (must have CertResource to be valid)","+\tif gatewayTLSCfg.SDS != nil && gatewayTLSCfg.SDS.CertResource != \"\" {","+\t\treturn true","+\t}","+","+\t// Check gateway-level TLS parameters","+\tif len(gatewayTLSCfg.TLSMinVersion) > 0 || len(gatewayTLSCfg.TLSMaxVersion) > 0 || len(gatewayTLSCfg.CipherSuites) > 0 {","+\t\treturn true","+\t}","+","+\t// Check if any listener-level listener has TLS termination configured.","+\t// This mirrors the xDS builder logic (listeners_apigateway.go:590-591).","+\tfor _, listener := range snap.APIGateway.BoundListeners {","+\t\ttlsCfg := &listener.TLS","+\t\tif len(tlsCfg.Certificates) > 0 {","+\t\t\treturn true","+\t\t}","+\t\t// Listener-level SDS must also have CertResource to be valid (mirrors hasSDSCert)","+\t\tif tlsCfg.SDS != nil && tlsCfg.SDS.CertResource != \"\" {","+\t\t\treturn true","+\t\t}","+\t\tif len(tlsCfg.MinVersion) > 0 || len(tlsCfg.MaxVersion) > 0 || len(tlsCfg.CipherSuites) > 0 {","+\t\t\treturn true","+\t\t}","+\t}","+","+\treturn false","+}","+"," // generateAPIGatewayDNSSANs returns the set of DNS Subject Alternative Names that"," // should be present on the API gateway's leaf certificate. This mirrors the"," // ingress gateway behavior (generateIngressDNSSANs) so that services exposed via"," // an API gateway can be reached over TLS using the auto-registered"," // \"<service>.api-gateway.<domain>\" DNS names, in addition to any explicit"," // hostnames configured on listeners or bound routes.","+//","+// DNS SANs are only injected when at least one listener terminates downstream","+// TLS. When all listeners are plain-text the leaf cert is still issued (for","+// outbound mTLS) but carries no DNS SANs, which avoids unnecessary XFCC","+// header fields on the outbound client certificate."," func (h *handlerAPIGateway) generateAPIGatewayDNSSANs(snap *ConfigSnapshot) []string {","+\t// Only inject DNS SANs when at least one listener terminates downstream TLS.","+\t// This mirrors the connectTLSServingEnabled guard in generateIngressDNSSANs.","+\tif !apiGatewayTLSServingEnabled(snap) {","+\t\treturn nil","+\t}","+"," \tvar dnsNames []string"," "," \t// Collect the tenancy (namespace + partition) of every fronted upstream so"],"additions":65,"deletions":0,"truncated":false},{"path":"agent/proxycfg/api_gateway_tls_test.go","lines":["@@ -14,6 +14,7 @@ import ("," \t\"github.com/hashicorp/consul/agent/leafcert\""," \t\"github.com/hashicorp/consul/agent/proxycfg/internal/watch\""," \t\"github.com/hashicorp/consul/agent/structs\"","+\t\"github.com/hashicorp/consul/types\""," )"," "," // countingLeafSource is a minimal LeafCertificate data source that records how","@@ -45,8 +46,179 @@ func testAPIGatewayHandler(t *testing.T, leaf LeafCertificate) *handlerAPIGatewa"," \t}"," }"," ","-// TestGenerateAPIGatewayDNSSANs verifies the leaf-cert DNS SANs include the","-// \"*.api-gateway.<domain>\" wildcards plus explicit listener and route","+// TestGenerateAPIGatewayDNSSANs_NoTLS verifies that generateAPIGatewayDNSSANs","+// returns nil when the global TLS flag is not set. The leaf cert is still","+// issued for outbound mTLS, but with no DNS SANs — which prevents unnecessary","+// XFCC header fields that would otherwise break RBAC intentions on the","+// destination service.","+func TestGenerateAPIGatewayDNSSANs_NoTLS(t *testing.T) {","+\tsnap := TestConfigSnapshotAPIGateway(t, \"default\", nil,","+\t\tfunc(entry *structs.APIGatewayConfigEntry, bound *structs.BoundAPIGatewayConfigEntry) {","+\t\t\t// entry.TLS.Enabled is false by default — no global TLS flag set.","+\t\t\tentry.Listeners = []structs.APIGatewayListener{{","+\t\t\t\tName:     \"http-listener\",","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tPort:     8080,","+\t\t\t}}","+\t\t\tbound.Listeners = []structs.BoundAPIGatewayListener{{","+\t\t\t\tName:     \"http-listener\",","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tPort:     8080,","+\t\t\t}}","+\t\t}, nil, nil, nil)","+","+\th := testAPIGatewayHandler(t, nil)","+\tsans := h.generateAPIGatewayDNSSANs(snap)","+","+\trequire.Nil(t, sans, \"no DNS SANs should be generated when APIGatewayConfigEntry.TLS.Enabled is false\")","+}","+","+// TestGenerateAPIGatewayDNSSANs_GlobalTLSEnabled verifies that DNS SANs are","+// injected when APIGatewayConfigEntry.TLS.Enabled is true. Listener-level","+// certificate references are irrelevant to this decision — they only control","+// which custom cert is presented, not whether TLS is active.","+func TestGenerateAPIGatewayDNSSANs_GlobalTLSEnabled(t *testing.T) {","+\tsnap := TestConfigSnapshotAPIGateway(t, \"default\", nil,","+\t\tfunc(entry *structs.APIGatewayConfigEntry, bound *structs.BoundAPIGatewayConfigEntry) {","+\t\t\tentry.TLS = structs.GatewayTLSConfig{Enabled: true}","+\t\t\tentry.Listeners = []structs.APIGatewayListener{{","+\t\t\t\tName:     \"https-listener\",","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tPort:     8443,","+\t\t\t}}","+\t\t\tbound.Listeners = []structs.BoundAPIGatewayListener{{","+\t\t\t\tName:     \"https-listener\",","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tPort:     8443,","+\t\t\t}}","+\t\t}, nil, nil, nil)","+","+\th := testAPIGatewayHandler(t, nil)","+\tsans := h.generateAPIGatewayDNSSANs(snap)","+","+\trequire.NotNil(t, sans, \"DNS SANs must be generated when APIGatewayConfigEntry.TLS.Enabled is true\")","+\trequire.Contains(t, sans, \"*.api-gateway.consul\")","+\trequire.Contains(t, sans, \"*.api-gateway.dc1.consul\")","+}","+","+// TestGenerateAPIGatewayDNSSANs_GatewayLevelMinVersion verifies that DNS SANs are","+// injected when gateway-level TLS MinVersion is configured, even without the","+// global Enabled flag. This tests gateway-level TLS parameter path.","+func TestGenerateAPIGatewayDNSSANs_GatewayLevelMinVersion(t *testing.T) {","+\tsnap := TestConfigSnapshotAPIGateway(t, \"default\", nil,","+\t\tfunc(entry *structs.APIGatewayConfigEntry, bound *structs.BoundAPIGatewayConfigEntry) {","+\t\t\t// No global Enabled flag, but gateway has TLS MinVersion configured","+\t\t\tentry.TLS = structs.GatewayTLSConfig{TLSMinVersion: \"TLSv1_2\"}","+\t\t\tentry.Listeners = []structs.APIGatewayListener{{","+\t\t\t\tName:     \"https-listener\",","+\t\t\t\tProtocol: structs.ListenerProtocolHTTP,","+\t\t\t\tPort:     8443,","+\t\t\t}}","+\t\t\tbound.Listeners = []structs.BoundAPIGatewayListener{{"],"additions":70,"deletions":2,"truncated":false}],"additions":632,"deletions":12,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-10-05T18:06:53.933082+00:00"}