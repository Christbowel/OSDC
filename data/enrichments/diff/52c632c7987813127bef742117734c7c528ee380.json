h bucket to the session's open list (the hash value was previously saved in the cursor)"," - Clear the cache cursor flag."," - Update convenient pointers within the cursor to parts of the WT_BTREE that may have changed"],"additions":2,"deletions":2,"truncated":false},{"path":"src/third_party/wiredtiger/src/include/connection.h","lines":["@@ -1061,7 +1061,6 @@ struct __wt_connection_impl {","     wt_shared u_int open_btree_count;        /* Locked: open writable btree count */","     uint32_t next_file_id;                   /* Locked: file ID counter */","     wt_shared uint32_t open_file_count;      /* Atomic: open file handle count */","-    wt_shared uint32_t open_cursor_count;    /* Atomic: open cursor handle count */","     wt_shared uint32_t version_cursor_count; /* Atomic: open version cursor count */"," ","     /*"],"additions":0,"deletions":1,"truncated":false},{"path":"src/third_party/wiredtiger/src/include/session.h","lines":["@@ -371,6 +371,13 @@ struct __wt_session_impl {","      */","     wt_shared WT_RAND_STATE rnd_skiplist;"," ","+    /*","+     * Count of cursors in this session's open list, written only by the owning thread and summed","+     * across sessions for statistics. It lives outside the cleared region so the summing load","+     * cannot race a closing session's non-atomic clear; cursor teardown returns it to zero first.","+     */","+    wt_shared uint32_t open_cursor_count;","+","     /*","      * Hash tables are allocated lazily as sessions are used to keep the size of this structure from","      * growing too large."],"additions":7,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/src/session/session_api.c","lines":["@@ -381,6 +381,7 @@ __wt_session_close_internal(WT_SESSION_IMPL *session)","     WT_TRET(__session_close_cached_cursors(session));"," ","     WT_ASSERT(session, session->ncursors == 0);","+    WT_ASSERT(session, __wt_atomic_load_uint32_relaxed(&session->open_cursor_count) == 0);"," ","     /* Discard cached handles. */","     __wt_session_close_cache(session);"],"additions":1,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/test/catch2/misc_tests/test_conn_stat_open_cursor_count.cpp","lines":["@@ -0,0 +1,50 @@","+/*-","+ * Copyright (c) 2014-present MongoDB, Inc.","+ * Copyright (c) 2008-2014 WiredTiger, Inc.","+ *\tAll rights reserved.","+ *","+ * See the file LICENSE for redistribution information.","+ */","+","+#include <catch2/catch.hpp>","+#include \"wt_internal.h\"","+","+#include \"../utils.h\"","+#include \"../wrappers/connection_wrapper.h\"","+","+/*","+ * [conn_stat]: conn_stat.c","+ * Test that the connection open cursor statistic counts cursors of internal sessions.","+ */","+TEST_CASE(\"conn stats: open cursor count includes internal sessions\", \"[statistics][session]\")","+{","+    const std::string home = \"WT_TEST.conn_stat_open_cursor_count\";","+","+    connection_wrapper conn(home, \"create,statistics=(all)\");","+    WT_CONNECTION_IMPL *conn_impl = conn.get_wt_connection_impl();","+    WT_SESSION_IMPL *session = conn.create_session();","+","+    int64_t *stat = &conn_impl->stats[0]->cursor_open_count;","+","+    __wt_conn_stat_init(session);","+    int64_t before = *stat;","+","+    WT_SESSION_IMPL *internal_session = nullptr;","+    REQUIRE(","+      __wt_open_internal_session(conn_impl, \"stat_internal\", false, 0, 0, &internal_session) == 0);","+","+    /* The exact cursor count is implementation-defined, so assert direction only. */","+    WT_CURSOR *cursor = nullptr;","+    REQUIRE(internal_session->iface.open_cursor(","+              &internal_session->iface, \"metadata:\", nullptr, nullptr, &cursor) == 0);","+","+    __wt_conn_stat_init(session);","+    CHECK(*stat > before);","+","+    REQUIRE(cursor->close(cursor) == 0);","+","+    __wt_conn_stat_init(session);","+    CHECK(*stat == before);","+","+    REQUIRE(__wt_session_close_internal(internal_session) == 0);","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/test/suite/test_stat20.py","lines":["@@ -0,0 +1,55 @@","+#!/usr/bin/env python","+#","+# Public Domain 2014-present MongoDB, Inc.","+# Public Domain 2008-2014 WiredTiger, Inc.","+#","+# This is free and unencumbered software released into the public domain.","+#","+# Anyone is free to copy, modify, publish, use, compile, sell, or","+# distribute this software, either in source code form or as a compiled","+# binary, for any purpose, commercial or non-commercial, and by any","+# means.","+#","+# In jurisdictions that recognize copyright laws, the author or authors","+# of this software dedicate any and all copyright interest in the","+# software to the public domain. We make this dedication for the benefit","+# of the public at large and to the detriment of our heirs and","+# successors. We intend this dedication to be an overt act of","+# relinquishment in perpetuity of all present and future rights to this","+# software under copyright law.","+#","+# THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,","+# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF","+# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.","+# IN NO EVENT SHALL THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR","+# OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,","+# ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR","+# OTHER DEALINGS IN THE SOFTWARE.","+","+import wttest","+from wiredtiger import stat","+","+# The open cursor count follows cursors opened, cached, reopened and closed in another session.","+class test_stat20(wttest.WiredTigerTestCase):","+    # Statistics logging opens cursors in the background.","+    conn_config = 'statistics=(fast),statistics_log=(wait=0)'","+    uri = 'table:test_stat20'","+","+    def open_cursor_count(self):","+        return self.get_stat(stat.conn.cursor_open_count)","+","+    def test_open_cursor_count(self):","+        self.session.create(self.uri, 'key_format=i,value_format=i')","+        before = self.open_cursor_count()","+","+        session = self.conn.open_session()","+        start = self.open_cursor_count()","+        cursor = session.open_cursor(self.uri)","+        opened = self.open_cursor_count() - start","+        self.assertGreater(opened, 0)","+        cursor.close()","+        self.assertEqual(self.open_cursor_count(), start)","+        cursor = session.open_cursor(self.uri)","+        self.assertEqual(self.open_cursor_count(), start + opened)","+        session.close()","+        self.assertEqual(self.open_cursor_count(), before)",""],"additions":55,"deletions":0,"truncated":false}],"additions":142,"deletions":10,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-16T17:24:16.742005+00:00"}