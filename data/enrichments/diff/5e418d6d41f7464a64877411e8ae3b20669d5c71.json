entHostStateManager } from '../../node/agentHostStateManager.js';","@@ -1710,28 +1710,6 @@ suite('AgentMergeController', () => {"," \t\t}]);"," \t});"," ","-\ttest('resolves the API host a credential must match for every GitHub deployment', () => {","-\t\tassert.deepStrictEqual({","-\t\t\tdotCom: parsePullRequestUrl('https://github.com/octo/repo/pull/1')?.apiHost,","-\t\t\twww: parsePullRequestUrl('https://www.github.com/octo/repo/pull/1')?.apiHost,","-\t\t\t// GitHub Enterprise Cloud serves its API from an `api.` subdomain, which is","-\t\t\t// the host the credential reports; comparing the web host rejects every PR.","-\t\t\tenterpriseCloud: parsePullRequestUrl('https://tenant.ghe.com/octo/repo/pull/1')?.apiHost,","-\t\t\tenterpriseServer: parsePullRequestUrl('https://ghe.corp.example/octo/repo/pull/1')?.apiHost,","-\t\t\tparsed: parsePullRequestUrl('https://tenant.ghe.com/octo/repo/pull/42'),","-\t\t\tnotAPullRequest: parsePullRequestUrl('https://github.com/octo/repo/issues/1'),","-\t\t\tnotAUrl: parsePullRequestUrl('octo/repo#1'),","-\t\t}, {","-\t\t\tdotCom: 'api.github.com',","-\t\t\twww: 'api.github.com',","-\t\t\tenterpriseCloud: 'api.tenant.ghe.com',","-\t\t\tenterpriseServer: 'ghe.corp.example',","-\t\t\tparsed: { owner: 'octo', repo: 'repo', number: 42, apiHost: 'api.tenant.ghe.com' },","-\t\t\tnotAPullRequest: undefined,","-\t\t\tnotAUrl: undefined,","-\t\t});","-\t});","-"," \ttest('detects a refused gate fragment so a credential can be requested from the snapshot', () => {"," \t\tconst saml = 'GitHub GraphQL request failed: Resource protected by organization SAML enforcement. You must grant your OAuth token access to this organization.';"," \t\tconst ready = { status: 'ready', complete: true, value: {} };"],"additions":1,"deletions":23,"truncated":false},{"path":"src/vs/platform/github/common/githubUrls.ts","lines":["@@ -0,0 +1,117 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { URI } from '../../../base/common/uri.js';","+import { deriveGitHubEndpoints } from './githubEndpoints.js';","+","+/** A GitHub issue, identified by the repository that owns it and its number. */","+export interface IGitHubIssueReference {","+\treadonly owner: string;","+\treadonly repo: string;","+\treadonly number: number;","+}","+","+/** Matches public issue URLs, including links with trailing paths, queries or comment fragments. */","+const ISSUE_URL_PATTERN = /^https?:\\/\\/(?:www\\.)?github\\.com\\/([\\w.-]+)\\/([\\w.-]+)\\/issues\\/(\\d+)\\b/i;","+const PULL_REQUEST_URL_PATTERN = /^https:\\/\\/github\\.com\\/(?<owner>[^/]+)\\/(?<repo>[^/]+)\\/pull\\/(?<number>\\d+)\\/?$/;","+const PULL_REQUEST_PATH_PATTERN = /^\\/(?<owner>[^/]+)\\/(?<repo>[^/]+)\\/pull\\/(?<number>\\d+)\\/?$/;","+const COMMIT_PATH_PATTERN = /^\\/(?<owner>[^/]+)\\/(?<repo>[^/]+)\\/commit\\/(?<sha>[^/]+)(?:\\/|$)/;","+","+/** Parses a public GitHub issue URL into its parts, or `undefined` when it is not one. */","+export function parseGitHubIssueUrl(url: string): IGitHubIssueReference | undefined {","+\tconst match = ISSUE_URL_PATTERN.exec(url);","+\tif (!match) {","+\t\treturn undefined;","+\t}","+\tconst number = Number(match[3]);","+\treturn Number.isSafeInteger(number) && number > 0 ? { owner: match[1], repo: match[2], number } : undefined;","+}","+","+/** Parses a canonical `https://github.com` pull request URL, without a query or fragment. */","+export function parseGitHubPullRequestUrl(url: string): { readonly owner: string; readonly repo: string; readonly number: number } | undefined {","+\tconst match = PULL_REQUEST_URL_PATTERN.exec(url);","+\tconst groups = match?.groups;","+\treturn groups ? { owner: groups.owner, repo: groups.repo, number: Number(groups.number) } : undefined;","+}","+","+export interface IParsedPullRequestUrl {","+\treadonly owner: string;","+\treadonly repo: string;","+\treadonly number: number;","+\t/** REST API host the credential account must match (`api.github.com` for github.com). */","+\treadonly apiHost: string;","+}","+","+/** Parses a pull request URL and derives its API host; callers determine which hosts are allowed. */","+export function parsePullRequestUrl(value: string): IParsedPullRequestUrl | undefined {","+\tlet url: URL;","+\ttry {","+\t\turl = new URL(value);","+\t} catch {","+\t\treturn undefined;","+\t}","+\tconst match = PULL_REQUEST_PATH_PATTERN.exec(url.pathname);","+\tconst number = Number(match?.groups?.number);","+\tif (!match?.groups || !Number.isSafeInteger(number) || number <= 0) {","+\t\treturn undefined;","+\t}","+\tconst host = url.host.toLowerCase();","+\treturn {","+\t\towner: match.groups.owner,","+\t\trepo: match.groups.repo,","+\t\tnumber,","+\t\t// Enterprise Cloud credentials report the API subdomain rather than the web host.","+\t\tapiHost: new URL(deriveGitHubEndpoints(`${url.protocol}//${host}`).apiBaseUri).host.toLowerCase(),","+\t};","+}","+","+export interface IGitHubCommitTarget {","+\treadonly owner: string;","+\treadonly repo: string;","+\treadonly sha: string;","+\treadonly resource: URI;","+}","+","+/** Parses a github.com commit link, retaining the original resource and any trailing path. */","+export function parseGitHubCommitTarget(resource: URI): IGitHubCommitTarget | undefined {","+\tif (resource.authority.toLowerCase() !== 'github.com') {","+\t\treturn undefined;","+\t}","+\tconst match = COMMIT_PATH_PATTERN.exec(resource.path);","+\tconst owner = match?.groups?.owner;","+\tconst repo = match?.groups?.repo;","+\tconst sha = match?.groups?.sha;","+\treturn owner && repo && sha ? { owner, repo, sha, resource } : undefined;","+}","+","+export type GitHubLinkTarget =","+\t| { readonly kind: 'repository'; readonly owner: string; readonly repo: string }","+\t| { readonly kind: 'issue'; readonly owner: string; readonly repo: string; readonly number: number }","+\t| { readonly kind: 'pullRequest'; readonly owner: string; readonly repo: string; readonly number: number };","+","+/** Parses HTTPS repository, issue and pull request paths after the caller has selected the host. */","+export function parseGitHubLinkTarget(resource: URI): GitHubLinkTarget | undefined {","+\tif (resource.scheme !== 'https') {","+\t\treturn undefined;","+\t}","+\tconst segments = resource.path.split('/').filter(Boolean);","+\tif (segments.length === 2) {","+\t\treturn { kind: 'repository', owner: segments[0], repo: segments[1] };","+\t}","+\tif (segments.length !== 4) {","+\t\treturn undefined;","+\t}","+\tconst number = Number(segments[3]);","+\tif (!Number.isSafeInteger(number) || number <= 0) {","+\t\treturn undefined;","+\t}","+\tif (segments[2] === 'issues') {","+\t\treturn { kind: 'issue', owner: segments[0], repo: segments[1], number };","+\t}","+\tif (segments[2] === 'pull') {","+\t\treturn { kind: 'pullRequest', owner: segments[0], repo: segments[1], number };","+\t}","+\treturn undefined;","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"src/vs/platform/github/test/common/githubUrls.test.ts","lines":["@@ -0,0 +1,180 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import assert from 'assert';","+import { URI } from '../../../../base/common/uri.js';","+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';","+import { parseGitHubCommitTarget, parseGitHubIssueUrl, parseGitHubLinkTarget, parseGitHubPullRequestUrl, parsePullRequestUrl } from '../../common/githubUrls.js';","+","+suite('GitHub URL parsers', () => {","+\tensureNoDisposablesAreLeakedInTestSuite();","+","+\ttest('issue URLs allow public host variants and trailing paths, queries and fragments', () => {","+\t\tconst urls = [","+\t\t\t'https://github.com/Owner/Repo/issues/42',","+\t\t\t'http://www.github.com/Owner/Repo/issues/42',","+\t\t\t'HTTPS://GITHUB.COM/Owner/Repo/ISSUES/42',","+\t\t\t'https://github.com/Owner/Repo/issues/42/',","+\t\t\t'https://github.com/Owner/Repo/issues/42/comments',","+\t\t\t'https://github.com/Owner/Repo/issues/42?tab=comments#issuecomment-1',","+\t\t];","+\t\tassert.deepStrictEqual(urls.map(parseGitHubIssueUrl), urls.map(() => ({ owner: 'Owner', repo: 'Repo', number: 42 })));","+\t});","+","+\ttest('issue URLs require a positive safe number and a public GitHub host', () => {","+\t\tconst urls = [","+\t\t\t'',","+\t\t\t'Owner/Repo#42',","+\t\t\t'https://github.com/Owner/Repo/pull/42',","+\t\t\t'https://github.com/Owner/Repo/issues/0',","+\t\t\t'https://github.com/Owner/Repo/issues/9007199254740992',","+\t\t\t'https://github.com/Owner/Repo/issues/42text',","+\t\t\t'https://github.com/Owner/Repo/issues/',","+\t\t\t'https://tenant.ghe.com/Owner/Repo/issues/42',","+\t\t\t'https://api.github.com/Owner/Repo/issues/42',","+\t\t\t'https://github.com.example/Owner/Repo/issues/42',","+\t\t\t'ftp://github.com/Owner/Repo/issues/42',","+\t\t];","+\t\tassert.deepStrictEqual(urls.map(parseGitHubIssueUrl), urls.map(() => undefined));","+\t});","+","+\ttest('canonical pull request URLs preserve coordinates and an optional trailing slash', () => {","+\t\tassert.deepStrictEqual([","+\t\t\tparseGitHubPullRequestUrl('https://github.com/Owner/Repo/pull/42'),","+\t\t\tparseGitHubPullRequestUrl('https://github.com/Owner/Repo/pull/0042/'),","+\t\t\tparseGitHubPullRequestUrl('https://github.com/Owner/Repo/pull/0'),","+\t\t], [","+\t\t\t{ owner: 'Owner', repo: 'Repo', number: 42 },","+\t\t\t{ owner: 'Owner', repo: 'Repo', number: 42 },","+\t\t\t{ owner: 'Owner', repo: 'Repo', number: 0 },","+\t\t]);","+\t});","+","+\ttest('canonical pull request URLs reject host variants and noncanonical suffixes', () => {","+\t\tconst urls = [","+\t\t\t'',","+\t\t\t'Owner/Repo#42',","+\t\t\t'http://github.com/Owner/Repo/pull/42',","+\t\t\t'https://GITHUB.COM/Owner/Repo/pull/42',","+\t\t\t'https://www.github.com/Owner/Repo/pull/42',","+\t\t\t'https://tenant.ghe.com/Owner/Repo/pull/42',","+\t\t\t'https://github.com/Owner/Repo/issues/42',","+\t\t\t'https://github.com/Owner/Repo/pull/42?tab=files',","+\t\t\t'https://github.com/Owner/Repo/pull/42#discussion_r1',","+\t\t\t'https://github.com/Owner/Repo/pull/42/files',","+\t\t\t'https://github.com/Owner/Repo/pull/42//',","+\t\t\t'https://github.com/Owner/Repo/pull/-1',","+\t\t];","+\t\tassert.deepStrictEqual(urls.map(parseGitHubPullRequestUrl), urls.map(() => undefined));","+\t});","+","+\ttest('resolves the API host a credential must match for every GitHub deployment', () => {","+\t\tassert.deepStrictEqual({","+\t\t\tdotCom: parsePullRequestUrl('https://github.com/octo/repo/pull/1')?.apiHost,","+\t\t\twww: parsePullRequestUrl('https://www.github.com/octo/repo/pull/1')?.apiHost,","+\t\t\tenterpriseCloud: parsePullRequestUrl('https://tenant.ghe.com/octo/repo/pull/1')?.apiHost,","+\t\t\tenterpriseServer: parsePullRequestUrl('https://ghe.corp.example/octo/repo/pull/1')?.apiHost,","+\t\t\tparsed: parsePullRequestUrl('https://tenant.ghe.com/octo/repo/pull/42'),","+\t\t\tnotAPullRequest: parsePullRequestUrl('https://github.com/octo/repo/issues/1'),","+\t\t\tnotAUrl: parsePullRequestUrl('octo/repo#1'),","+\t\t}, {","+\t\t\tdotCom: 'api.github.com',","+\t\t\twww: 'api.github.com',","+\t\t\tenterpriseCloud: 'api.tenant.ghe.com',","+\t\t\tenterpriseServer: 'ghe.corp.example',","+\t\t\tparsed: { owner: 'octo', repo: 'repo', number: 42, apiHost: 'api.tenant.ghe.com' },","+\t\t\tnotAPullRequest: undefined,","+\t\t\tnotAUrl: undefined,","+\t\t});","+\t});","+","+\ttest('API-h