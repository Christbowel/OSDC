----------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  48 |  49 |  50 | 51  |     |     |     |     |  *","+ *  -------------------------------------------------  *","+ *  | 0xc0| 0xc4| 0xc8| 0xcc|     |     |     |     |  *","+ *  -------------------------------------------------  *","+ *  |     ra    |     pc    |           |           |  *","+ *  -------------------------------------------------  *","+ *                                                     *","+ *******************************************************/","+","+.file \"jump_riscv64_sysv_elf_gas.S\"","+.text","+.align  1","+.global folly_jump_fcontext","+.type   folly_jump_fcontext, %function","+folly_jump_fcontext:","+    # prepare stack for GP + FPU","+    addi  sp, sp, -0xd0","+","+    # save fs0 - fs11","+    fsd  fs0, 0x00(sp)","+    fsd  fs1, 0x08(sp)","+    fsd  fs2, 0x10(sp)","+    fsd  fs3, 0x18(sp)","+    fsd  fs4, 0x20(sp)","+    fsd  fs5, 0x28(sp)","+    fsd  fs6, 0x30(sp)","+    fsd  fs7, 0x38(sp)","+    fsd  fs8, 0x40(sp)","+    fsd  fs9, 0x48(sp)","+    fsd  fs10, 0x50(sp)","+    fsd  fs11, 0x58(sp)","+","+    # save s0-s11, ra","+    sd  s0, 0x60(sp)","+    sd  s1, 0x68(sp)","+    sd  s2, 0x70(sp)","+    sd  s3, 0x78(sp)","+    sd  s4, 0x80(sp)","+    sd  s5, 0x88(sp)","+    sd  s6, 0x90(sp)","+    sd  s7, 0x98(sp)","+    sd  s8, 0xa0(sp)","+    sd  s9, 0xa8(sp)","+    sd  s10, 0xb0(sp)","+    sd  s11, 0xb8(sp)","+    sd  ra, 0xc0(sp)","+","+    # save RA as PC","+    sd  ra, 0xc8(sp)","+","+    # store SP (pointing to context-data) in A2","+    mv  a2, sp","+","+    # restore SP (pointing to context-data) from A0","+    mv  sp, a0","+","+    # load fs0 - fs11","+    fld  fs0, 0x00(sp)","+    fld  fs1, 0x08(sp)","+    fld  fs2, 0x10(sp)","+    fld  fs3, 0x18(sp)","+    fld  fs4, 0x20(sp)","+    fld  fs5, 0x28(sp)","+    fld  fs6, 0x30(sp)","+    fld  fs7, 0x38(sp)","+    fld  fs8, 0x40(sp)","+    fld  fs9, 0x48(sp)","+    fld  fs10, 0x50(sp)","+    fld  fs11, 0x58(sp)","+","+    # load s0-s11,ra","+    ld  s0, 0x60(sp)","+    ld  s1, 0x68(sp)","+    ld  s2, 0x70(sp)","+    ld  s3, 0x78(sp)","+    ld  s4, 0x80(sp)","+    ld  s5, 0x88(sp)","+    ld  s6, 0x90(sp)","+    ld  s7, 0x98(sp)","+    ld  s8, 0xa0(sp)","+    ld  s9, 0xa8(sp)","+    ld  s10, 0xb0(sp)","+    ld  s11, 0xb8(sp)","+    ld  ra, 0xc0(sp)","+","+    # return transfer_t from jump","+    # pass transfer_t as first arg in context function","+    # a0 == FCTX, a1 == DATA","+    mv a0, a2","+","+    # load pc","+    ld  a2, 0xc8(sp)","+","+    # restore stack from GP + FPU","+    addi  sp, sp, 0xd0","+","+    jr a2","+.size   folly_jump_fcontext,.-folly_jump_fcontext","+# Mark that we don't need executable stack.","+.section .note.GNU-stack,\"\",%progbits"],"additions":150,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_s390x_sysv_elf_gas.S","lines":["@@ -0,0 +1,156 @@","+/*******************************************************","+ *  -------------------------------------------------  *","+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+ *  -------------------------------------------------  *","+ *  |     0     |     8     |    16     |    24     |  *","+ *  -------------------------------------------------  *","+ *  |   t.fctx  |   t.data  |    r2     |    r6     |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *","+ *  -------------------------------------------------  *","+ *  |     32    |    40     |     48    |     56    |  *","+ *  -------------------------------------------------  *","+ *  |     r7    |     r8    |     r9    |    r10    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *","+ *  -------------------------------------------------  *","+ *  |     64    |     72    |     80    |     88    |  *","+ *  -------------------------------------------------  *","+ *  |    r11    |    r12    |    r13    |    r14    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  24 |  25 |  26 |  27 |  28 | 29  |  30 |  31 |  *","+ *  -------------------------------------------------  *","+ *  |     96    |    104    |    112    |    120    |  *","+ *  -------------------------------------------------  *","+ *  |     f8    |     f9    |    f10    |    f11    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  32 |  33 |  34 |  35 |  36 |  37 |  38 |  39 |  *","+ *  -------------------------------------------------  *","+ *  |    128    |    136    |    144    |    152    |  *","+ *  -------------------------------------------------  *","+ *  |    f12    |    f13    |    f14    |    f15    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  40 |  41 |  42 |  43 |  44 |  45 |  46 |  47 |  *","+ *  -------------------------------------------------  *","+ *  |    160    |    168    |    176    |           |  *","+ *  -------------------------------------------------  *","+ *  |    fpc    |     pc    |           |           |  *","+ *  -------------------------------------------------  *","+ *******************************************************/","+","+.text","+.align\t8","+.global\tfolly_jump_fcontext","+.type\tfolly_jump_fcontext, @function","+","+#define ARG_OFFSET         0","+#define GR_OFFSET\t   16","+#define FP_OFFSET\t   96","+#define FPC_OFFSET\t   160","+#define PC_OFFSET\t   168","+#define CONTEXT_SIZE\t   176","+","+#define REG_SAVE_AREA_SIZE 160","+","+/*","+","+typedef void*   fcontext_t;","+","+struct transfer_t {","+   fcontext_t  fctx;","+   void    *   data;","+};","+","+transfer_t folly_jump_fcontext( fcontext_t const to,","+\t\t\t  void * data);","+","+Incoming args","+r2 - Hidden argument to the location where the return transfer_t needs to be returned","+r3 - Context we want to switch to","+r4 - Data pointer","+","+*/","+","+folly_jump_fcontext:","+\t.machine \"z10\"","+\t/* Reserve stack space to store the current context.  */","+\taghi\t%r15,-CONTEXT_SIZE","+","+\t/* Save the argument register holding the location of the return value.  */","+\tstg\t%r2,GR_OFFSET(%r15)","+","+\t/* Save the call-saved general purpose registers.  */","+\tstmg\t%r6,%r14,GR_OFFSET+8(%r15)","+","+\t/* Save call-saved floating point registers.  */","+\tstd\t%f8,FP_OFFSET(%r15)","+\tstd\t%f9,FP_OFFSET+8(%r15)","+\tstd\t%f10,FP_OFFSET+16(%r15)","+\tstd\t%f11,FP_OFFSET+24(%r15)","+\tstd\t%f12,FP_OFFSET+32(%r15)","+\tstd\t%f13,FP_OFFSET+40(%r15)","+\tstd\t%f14,FP_OFFSET+48(%r15)","+\tstd\t%f15,FP_OFFSET+56(%r15)","+","+\t/* Save the return address as current pc.  */","+\tstg\t%r14,PC_OFFSET(%r15)","+","+\t/* Save the floating point control register.  */","+\tstfpc\tFPC_OFFSET(%r15)","+","+\t/* Backup the stack pointer pointing to the old context-data into r1.  */","+\tlgr\t %r1,%r15","+","+\t/* Load the new context pointer as stack pointer.  */","+\tlgr\t%r15,%r3","+","+\t/* Restore the call-saved GPRs from the new context.  */","+\tlmg\t%r6,%r14,GR_OFFSET+8(%r15)","+","+\t/* Restore call-saved floating point registers.  */","+\tld\t%f8,FP_OFFSET(%r15)","+\tld\t%f9,FP_OFFSET+8(%r15)","+\tld\t%f10,FP_OFFSET+16(%r15)","+\tld\t%f11,FP_OFFSET+24(%r15)","+\tld\t%f12,FP_OFFSET+32(%r15)","+\tld\t%f13,FP_OFFSET+40(%r15)","+\tld\t%f14,FP_OFFSET+48(%r15)","+\tld\t%f15,FP_OFFSET+56(%r15)","+","+\t/* Load the floating point control register.  */","+\tlfpc\tFPC_OFFSET(%r15)","+","+\t/* Restore PC - the location where we will jump to at the end.  */","+\tlg\t%r5,PC_OFFSET(%r15)","+","+\tltg\t%r2,GR_OFFSET(%r15)","+\tjnz\tuse_return_slot","+","+\t/* We restore a make_fcontext context.  Use the function","+\t   argument slot in the context we just saved and allocate the","+\t   register save area for the target function.  */","+\tla\t%r2,ARG_OFFSET(%r1)","+\taghi\t%r15,-REG_SAVE_AREA_SIZE","+","+use_return_slot:","+\t/* Save the two fields in transfer_t.  When calling a","+\t   make_fcontext function this becomes the function argument of","+\t   the target function, otherwise it will be the return value of","+\t   folly_jump_fcontext.  */","+\tstg\t%r1,0(%r2)","+\tstg\t%r4,8(%r2)","+","+\t/* Free the restored context.  */","+\taghi\t%r15,CONTEXT_SIZE","+","+\t/* Jump to the PC loaded from the new context.  */","+\tbr\t%r5","+","+","+.size   folly_jump_fcontext,.-folly_jump_fcontext","+.section .note.GNU-stack,\"\",%progbits"],"additions":156,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_x86_64_ms_pe_clang_gas.S","lines":["@@ -0,0 +1,209 @@","+/*","+            Copyright Oliver Kowalke 2009.","+            Copyright Thomas Sailer 2013.","+   Distributed under the Boost Software License, Version 1.0.","+      (See accompanying file LICENSE_1_0.txt or copy at","+            http://www.boost.org/LICENSE_1_0.txt)","+*/","+","+/*************************************************************************************","+* ---------------------------------------------------------------------------------- *","+* |     0   |     1   |     2    |     3   |     4   |     5   |     6   |     7   | *","+* ---------------------------------------------------------------------------------- *","+* |    0x0  |    0x4  |    0x8   |    0xc  |   0x10  |   0x14  |   0x18  |   0x1c  | *","+* ---------------------------------------------------------------------------------- *","+* |                          SEE registers (XMM6-XMM15)                            | *","+* ---------------------------------------------------------------------------------- *"],"additions":16,"deletions"