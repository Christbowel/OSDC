{"id":"25bb18ffb2f2082930ed072812719adf29e844a0","axis":"silent","repo":"facebook/folly","sha":"25bb18ffb2f2082930ed072812719adf29e844a0","parsed":{"files":[{"path":"cmake/FollyFunctions.cmake","lines":["@@ -632,7 +632,7 @@ endfunction ()"," #     DEPS folly_lang_bits folly_ext_lz4  # Private dependencies (folly targets"," #                                         # and folly_ext_* libraries)"," #     EXPORTED_DEPS folly_range     # Public dependencies (propagated to users)","-#     EXTERNAL_DEPS Boost::context  # External library dependencies","+#     EXTERNAL_DEPS Boost::regex  # External library dependencies"," #     EXTERNAL_INCLUDE_DIRS ${FOO_INCLUDE_DIRS}  # External include directories"," #     COMPILE_OPTIONS -mpclmul      # Optional compile options for source files"," #     EXCLUDE_FROM_MONOLITH         # Don't include in monolithic folly library"],"additions":1,"deletions":1,"truncated":false},{"path":"cmake/folly-config.h.cmake","lines":["@@ -65,7 +65,6 @@"," #cmakedefine01 FOLLY_HAVE_DWARF"," #cmakedefine01 FOLLY_HAVE_ELF"," #cmakedefine FOLLY_HAVE_SWAPCONTEXT 1","-#cmakedefine FOLLY_FIBERS_USE_BOOST_CONTEXT 1"," #cmakedefine FOLLY_HAVE_BACKTRACE 1"," #cmakedefine FOLLY_USE_SYMBOLIZER 1"," #define FOLLY_DEMANGLE_MAX_SYMBOL_SIZE 1024"],"additions":0,"deletions":1,"truncated":false},{"path":"cmake/folly-deps.cmake","lines":["@@ -55,26 +55,9 @@ set(Boost_USE_STATIC_LIBS \"${FOLLY_BOOST_LINK_STATIC}\")"," "," # Note: We find these components so the CMake targets exist, but we don't"," # link them globally. Targets that need specific Boost libraries should","-# add them to their EXTERNAL_DEPS (e.g., Boost::regex, Boost::context).","+# add them to their EXTERNAL_DEPS (e.g., Boost::regex)."," set(FOLLY_BOOST_COMPONENTS \"\")"," ","-# Fibers switch contexts with the assembly in folly/external/boost-fcontext","-# on x86_64 and arm64 outside Windows, and with Boost.Context elsewhere.","-set(FOLLY_FIBERS_USE_BOOST_CONTEXT OFF)","-set(folly_fcontext_archs ${CMAKE_SYSTEM_PROCESSOR})","-if (APPLE AND CMAKE_OSX_ARCHITECTURES)","-  set(folly_fcontext_archs ${CMAKE_OSX_ARCHITECTURES})","-endif ()","-foreach (arch IN LISTS folly_fcontext_archs)","-  if (NOT arch MATCHES \"^(x86_64|aarch64|arm64)$\")","-    set(FOLLY_FIBERS_USE_BOOST_CONTEXT ON)","-  endif ()","-endforeach ()","-if (WIN32 OR NOT folly_fcontext_archs OR FOLLY_FIBERS_USE_BOOST_CONTEXT)","-  set(FOLLY_FIBERS_USE_BOOST_CONTEXT ON)","-  list(APPEND FOLLY_BOOST_COMPONENTS context)","-endif ()","-"," # CMake 4 dropped FindBoost, so this config-only probe warns without QUIET."," # folly/cli's ProgramOptions is built only if Boost.ProgramOptions is found,"," # and the libraries that need Boost.Regex only if it is."],"additions":1,"deletions":18,"truncated":false},{"path":"folly/external/boost-fcontext/BUCK","lines":["@@ -25,6 +25,10 @@ ELF_SRCS = {","         \"make_arm_aapcs_elf_gas.S\",","     ],","     \"ovr_config//cpu:arm64\": ELF_ARM64_SRCS,","+    \"ovr_config//cpu:riscv64\": [","+        \"jump_riscv64_sysv_elf_gas.S\",","+        \"make_riscv64_sysv_elf_gas.S\",","+    ],","     \"ovr_config//cpu:x86_32\": [","         \"jump_i386_sysv_elf_gas.S\",","         \"make_i386_sysv_elf_gas.S\","],"additions":4,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/CMakeLists.txt","lines":["@@ -15,27 +15,117 @@"," # NOTE: This file is manually maintained, not auto-generated."," # Update this file when the corresponding BUCK file changes."," ","-if (FOLLY_FIBERS_USE_BOOST_CONTEXT)","-  folly_add_library(","-    NAME fcontext","-    HEADERS fcontext.h","-    EXTERNAL_DEPS Boost::context","-  )","-  return ()","-endif ()","-","-# On Apple platforms the wrappers pick the variant for each architecture in","-# CMAKE_OSX_ARCHITECTURES, which may differ from CMAKE_SYSTEM_PROCESSOR.","+# Picks the vendored assembly for the target. CMAKE_SYSTEM_PROCESSOR names the","+# host on Windows and may differ from CMAKE_OSX_ARCHITECTURES on Apple","+# platforms, so those check the architectures being compiled instead.","+include(CheckCSourceCompiles)","+include(CheckSymbolExists)","+unset(abi)","+set(asm_language ASM)"," if (APPLE)","+  # The wrappers include the Mach-O variant for each architecture compiled.","+  set(archs ${CMAKE_OSX_ARCHITECTURES})","+  if (NOT archs)","+    set(archs ${CMAKE_SYSTEM_PROCESSOR})","+  endif ()","+  foreach (arch IN LISTS archs)","+    if (NOT arch MATCHES \"^(x86_64|arm64|aarch64)$\")","+      message(FATAL_ERROR \"folly/fibers does not support ${arch} on Apple platforms\")","+    endif ()","+  endforeach ()","   set(abi macho_gas.S)","-elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL \"x86_64\")","-  set(abi x86_64_sysv_elf_gas.S)","+elseif (MSVC)","+  check_symbol_exists(_M_ARM64EC \"\" FOLLY_FCONTEXT_ARM64EC)","+  check_symbol_exists(_M_ARM64 \"\" FOLLY_FCONTEXT_ARM64)","+  check_symbol_exists(_M_X64 \"\" FOLLY_FCONTEXT_X64)","+  check_symbol_exists(_M_IX86 \"\" FOLLY_FCONTEXT_X86)","+  if (FOLLY_FCONTEXT_ARM64EC)","+    message(FATAL_ERROR \"folly/fibers does not support ARM64EC\")","+  elseif (FOLLY_FCONTEXT_ARM64)","+    if (CMAKE_VERSION VERSION_LESS 3.26)","+      message(FATAL_ERROR \"Building folly for ARM64 Windows requires CMake 3.26\")","+    endif ()","+    set(abi arm64_aapcs_pe_armasm.asm)","+    set(asm_language ASM_MARMASM)","+  elseif (FOLLY_FCONTEXT_X64)","+    set(abi x86_64_ms_pe_masm.asm)","+    set(asm_language ASM_MASM)","+  elseif (FOLLY_FCONTEXT_X86)","+    set(abi i386_ms_pe_masm.asm)","+    set(asm_language ASM_MASM)","+    set(asm_options /safeseh)","+  else ()","+    message(FATAL_ERROR \"folly/fibers does not support this MSVC target\")","+  endif ()","+  enable_language(${asm_language})","+elseif (WIN32)","+  # MinGW and other GNU-style toolchains.","+  check_symbol_exists(__x86_64__ \"\" FOLLY_FCONTEXT_X86_64)","+  if (NOT FOLLY_FCONTEXT_X86_64)","+    message(FATAL_ERROR \"folly/fibers supports only x86_64 with a GNU-style toolchain on Windows\")","+  endif ()","+  set(abi x86_64_ms_pe_clang_gas.S)"," else ()","-  set(abi arm64_aapcs_elf_gas.S)","+  set(arch ${CMAKE_SYSTEM_PROCESSOR})","+  if (arch MATCHES \"^(x86_64|amd64|AMD64|i[3-6]86|x86)$\")","+    check_symbol_exists(__x86_64__ \"\" FOLLY_FCONTEXT_X86_64)","+    check_symbol_exists(__ILP32__ \"\" FOLLY_FCONTEXT_ILP32)","+    check_symbol_exists(__i386__ \"\" FOLLY_FCONTEXT_I386)","+    if (FOLLY_FCONTEXT_X86_64 AND FOLLY_FCONTEXT_ILP32)","+      message(FATAL_ERROR \"folly/fibers does not support the x32 ABI\")","+    elseif (FOLLY_FCONTEXT_X86_64)","+      set(abi x86_64_sysv_elf_gas.S)","+    elseif (FOLLY_FCONTEXT_I386)","+      set(abi i386_sysv_elf_gas.S)","+    endif ()","+  elseif (arch MATCHES \"^(aarch64|arm64|ARM64)$\")","+    set(abi arm64_aapcs_elf_gas.S)","+  elseif (arch MATCHES \"^arm\")","+    set(abi arm_aapcs_elf_gas.S)","+  elseif (arch STREQUAL \"riscv64\")","+    # The assembly saves the floating-point registers with fsd and fld.","+    check_symbol_exists(__riscv_d \"\" FOLLY_FCONTEXT_RISCV_D)","+    if (NOT FOLLY_FCONTEXT_RISCV_D)","+      message(FATAL_ERROR \"folly/fibers requires the D extension on riscv64\")","+    endif ()","+    set(abi riscv64_sysv_elf_gas.S)","+  elseif (arch STREQUAL \"s390x\")","+    set(abi s390x_sysv_elf_gas.S)","+  elseif (arch MATCHES \"^mips\")","+    check_c_source_compiles(\"","+      #if _MIPS_SIM != _ABIO32","+      #error","+      #endif","+      int main(void) { return 0; }\" FOLLY_FCONTEXT_MIPS_O32)","+    check_c_source_compiles(\"","+      #if _MIPS_SIM != _ABI64","+      #error","+      #endif","+      int main(void) { return 0; }\" FOLLY_FCONTEXT_MIPS_N64)","+    if (FOLLY_FCONTEXT_MIPS_O32)","+      set(abi mips32_o32_elf_gas.S)","+    elseif (FOLLY_FCONTEXT_MIPS_N64)","+      set(abi mips64_n64_elf_gas.S)","+    else ()","+      message(FATAL_ERROR \"folly/fibers supports only the o32 and n64 MIPS ABIs\")","+    endif ()","+  endif ()","+  if (NOT abi)","+    message(FATAL_ERROR \"folly/fibers does not support ${arch}\")","+  endif ()"," endif ()"," ","+set_source_files_properties(make_${abi} jump_${abi}","+  PROPERTIES LANGUAGE ${asm_language})"," folly_add_library(","   NAME fcontext","   SRCS make_${abi} jump_${abi}","   HEADERS fcontext.h"," )","+","+if (MSVC)","+  # Folly's compile options are for the C++ compiler, not the assembler.","+  set_target_properties(folly_external_boost-fcontext_fcontext_obj PROPERTIES","+    COMPILE_OPTIONS \"${asm_options}\"","+    COMPILE_DEFINITIONS BOOST_CONTEXT_EXPORT=)","+endif ()"],"additions":104,"deletions":14,"truncated":false},{"path":"folly/external/boost-fcontext/README.md","lines":["@@ -14,7 +14,8 @@ Boost.Context in a program that links both. `update.sh` regenerates the"," assembly from a Boost source tree. `make_macho_gas.S` and `jump_macho_gas.S`"," include the Mach-O variant for the target architecture, so that CMake builds"," for any combination of arm64 and x86_64 in `CMAKE_OSX_ARCHITECTURES`, including","-universal binaries, and uses Boost.Context for other architectures.","+universal binaries. CMake stops with an error for an architecture that has no","+variant here."," "," Distributed under the Boost Software License, Version 1.0 (see"," `LICENSE_1_0.txt`)."],"additions":2,"deletions":1,"truncated":false},{"path":"folly/external/boost-fcontext/jump_mips32_o32_elf_gas.S","lines":["@@ -0,0 +1,119 @@","+/*","+            Copyright Oliver Kowalke 2009.","+   Distributed under the Boost Software License, Version 1.0.","+      (See accompanying file LICENSE_1_0.txt or copy at","+          http://www.boost.org/LICENSE_1_0.txt)","+*/","+","+/*******************************************************","+ *                                                     *","+ *  -------------------------------------------------  *","+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+ *  -------------------------------------------------  *","+ *  |  0  |  4  |  8  |  12 |  16 |  20 |  24 |  28 |  *","+ *  -------------------------------------------------  *","+ *  |    F20    |    F22    |    F24    |    F26    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *","+ *  -------------------------------------------------  *","+ *  |  32 |  36 |  40 |  44 |  48 |  52 |  56 |  60 |  *","+ *  -------------------------------------------------  *","+ *  |    F28    |    F30    |  S0 |  S1 |  S2 |  S3 |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *","+ *  -------------------------------------------------  *","+ *  |  64 |  68 |  72 |  76 |  80 |  84 |  88 |  92 |  *","+ *  -------------------------------------------------  *","+ *  |  S4 |  S5 |  S6 |  S7 |  FP |hiddn|  RA |  PC |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  24 |  25 |  26 |  27 |  28 |  29 |  30 |  31 |  *","+ *  -------------------------------------------------  *","+ *  |  96 | 100 | 104 | 108 | 112 | 116 | 120 | 124 |  *","+ *  -------------------------------------------------  *","+ *  |       ABI ARGS        |  GP | FCTX| DATA|     |  *","+ *  -------------------------------------------------  *","+ *                                                     *","+ * *****************************************************/","+","+.file \"jump_mips32_o32_elf_gas.S\"","+.text","+.globl folly_jump_fcontext","+.align 2","+.type folly_jump_fcontext,@function","+.ent folly_jump_fcontext","+folly_jump_fcontext:","+    # reserve space on stack","+    addiu $sp, $sp, -96","+","+    sw  $s0, 48($sp)  # save S0","+    sw  $s1, 52($sp)  # save S1","+    sw  $s2, 56($sp)  # save S2","+    sw  $s3, 60($sp)  # save S3","+    sw  $s4, 64($sp)  # save S4","+    sw  $s5, 68($sp)  # save S5","+    sw  $s6, 72($sp)  # save S6","+    sw  $s7, 76($sp)  # save S7","+    sw  $fp, 80($sp)  # save FP","+    sw  $a0, 84($sp)  # save hidden, address of returned transfer_t","+    sw  $ra, 88($sp)  # save RA","+    sw  $ra, 92($sp)  # save RA as PC","+","+#if defined(__mips_hard_float)","+    s.d  $f20, ($sp)  # save F20","+    s.d  $f22, 8($sp)  # save F22","+    s.d  $f24, 16($sp)  # save F24","+    s.d  $f26, 24($sp)  # save F26","+    s.d  $f28, 32($sp)  # save F28","+    s.d  $f30, 40($sp)  # save F30","+#endif","+","+    # store SP (pointing to context-data) in A0","+    move  $a0, $sp","+","+    # restore SP (pointing to context-data) from A1","+    move  $sp, $a1","+","+#if defined(__mips_hard_float)","+    l.d  $f20, ($sp)  # restore F20","+    l.d  $f22, 8($sp)  # restore F22","+    l.d  $f24, 16($sp)  # restore F24","+    l.d  $f26, 24($sp)  # restore F26","+    l.d  $f28, 32($sp)  # restore F28","+    l.d  $f30, 40($sp)  # restore F30","+#endif","+","+    lw  $s0, 48($sp)  # restore S0","+    lw  $s1, 52($sp)  # restore S1","+    lw  $s2, 56($sp)  # restore S2","+    lw  $s3, 60($sp)  # restore S3","+    lw  $s4, 64($sp)  # restore S4","+    lw  $s5, 68($sp)  # restore S5","+    lw  $s6, 72($sp)  # restore S6","+    lw  $s7, 76($sp)  # restore S7","+    lw  $fp, 80($sp)  # restore FP","+    lw  $v0, 84($sp)  # restore hidden, address of returned transfer_t","+    lw  $ra, 88($sp)  # restore RA","+","+    # load PC","+    lw  $t9, 92($sp)","+","+    # adjust stack","+    addiu $sp, $sp, 96","+    ","+    # return transfer_t from jump","+    sw  $a0, ($v0)  # fctx of transfer_t","+    sw  $a2, 4($v0) # data of transfer_t","+    # pass transfer_t as first arg in context function","+    # A0 == fctx, A1 == data","+    move  $a1, $a2 ","+","+    # jump to context","+    jr  $t9","+.end folly_jump_fcontext","+.size folly_jump_fcontext, .-folly_jump_fcontext","+","+/* Mark that we don't need executable stack.  */","+.section .note.GNU-stack,\"\",%progbits"],"additions":119,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_mips64_n64_elf_gas.S","lines":["@@ -0,0 +1,124 @@","+/*","+            Copyright Jiaxun Yang 2018.","+   Distributed under the Boost Software License, Version 1.0.","+      (See accompanying file LICENSE_1_0.txt or copy at","+          http://www.boost.org/LICENSE_1_0.txt)","+*/","+","+/*******************************************************","+ *                                                     *","+ *  -------------------------------------------------  *","+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+ *  -------------------------------------------------  *","+ *  |     0     |     8     |    16     |     24    |  *","+ *  -------------------------------------------------  *","+ *  |    F24    |    F25    |    F26    |    F27    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *","+ *  -------------------------------------------------  *","+ *  |     32    |    40     |     48    |     56    |  *","+ *  -------------------------------------------------  *","+ *  |    F28    |    F29    |    F30    |    F31    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *","+ *  -------------------------------------------------  *","+ *  |     64    |    72     |     80    |     88    |  *","+ *  -------------------------------------------------  *","+ *  |    S0     |    S1     |     S2    |     S3    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  24 |  25 |  26 |  27 |  28 |  29 |  30 |  31 |  *","+ *  -------------------------------------------------  *","+ *  |  96 | 100 | 104 | 108 | 112 | 116 | 120 | 124 |  *","+ *  -------------------------------------------------  *","+ *  |    S4     |    S5     |     S6    |     S7    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  32 |  33 |  34 |  35 |  36 |  37 |  38 |  39 |  *","+ *  -------------------------------------------------  *","+ *  | 128 | 132 | 136 | 140 | 144 | 148 | 152 | 156 |  *","+ *  -------------------------------------------------  *","+ *  |    FP     |    GP     |     RA    |     PC    |  *","+ *  -------------------------------------------------  *","+ *                                                     *","+ * *****************************************************/","+","+.file \"jump_mips64_n64_elf_gas.S\"","+.text","+.globl folly_jump_fcontext","+.align 3","+.type folly_jump_fcontext,@function","+.ent folly_jump_fcontext","+folly_jump_fcontext:","+    # reserve space on stack","+    daddiu $sp, $sp, -160","+","+    sd  $s0, 64($sp)  # save S0","+    sd  $s1, 72($sp)  # save S1","+    sd  $s2, 80($sp)  # save S2","+    sd  $s3, 88($sp)  # save S3","+    sd  $s4, 96($sp)  # save S4","+    sd  $s5, 104($sp) # save S5","+    sd  $s6, 112($sp) # save S6","+    sd  $s7, 120($sp) # save S7","+    sd  $fp, 128($sp) # save FP","+    sd  $ra, 144($sp) # save RA","+    sd  $ra, 152($sp) # save RA as PC","+","+#if defined(__mips_hard_float)","+    s.d  $f24, 0($sp)   # save F24","+    s.d  $f25, 8($sp)   # save F25","+    s.d  $f26, 16($sp)  # save F26","+    s.d  $f27, 24($sp)  # save F27","+    s.d  $f28, 32($sp)  # save F28","+    s.d  $f29, 40($sp)  # save F29","+    s.d  $f30, 48($sp)  # save F30","+    s.d  $f31, 56($sp)  # save F31","+#endif","+","+    # store SP (pointing to old context-data) in v0 as return","+    move  $v0, $sp","+","+    # get SP (pointing to new context-data) from a0 param","+    move  $sp, $a0","+","+#if defined(__mips_hard_float)","+    l.d  $f24, 0($sp)   # restore F24","+    l.d  $f25, 8($sp)   # restore F25","+    l.d  $f26, 16($sp)  # restore F26","+    l.d  $f27, 24($sp)  # restore F27","+    l.d  $f28, 32($sp)  # restore F28","+    l.d  $f29, 40($sp)  # restore F29","+    l.d  $f30, 48($sp)  # restore F30","+    l.d  $f31, 56($sp)  # restore F31","+#endif","+","+    ld  $s0, 64($sp)  # restore S0","+    ld  $s1, 72($sp)  # restore S1","+    ld  $s2, 80($sp)  # restore S2","+    ld  $s3, 88($sp)  # restore S3","+    ld  $s4, 96($sp)  # restore S4","+    ld  $s5, 104($sp) # restore S5","+    ld  $s6, 112($sp) # restore S6","+    ld  $s7, 120($sp) # restore S7","+    ld  $fp, 128($sp) # restore FP","+    ld  $ra, 144($sp) # restore RAa","+","+    # load PC","+    ld  $t9, 152($sp)","+","+    # adjust stack","+    daddiu $sp, $sp, 160","+","+    move  $a0, $v0 # move old sp from v0 to a0 as param","+    move  $v1, $a1 # move *data from a1 to v1 as return","+","+    # jump to context","+    jr  $t9","+.end folly_jump_fcontext","+.size folly_jump_fcontext, .-folly_jump_fcontext","+","+/* Mark that we don't need executable stack.  */","+.section .note.GNU-stack,\"\",%progbits"],"additions":124,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_riscv64_sysv_elf_gas.S","lines":["@@ -0,0 +1,150 @@","+/*","+   Distributed under the Boost Software License, Version 1.0.","+      (See accompanying file LICENSE_1_0.txt or copy at","+          http://www.boost.org/LICENSE_1_0.txt)","+*/","+/*******************************************************","+ *                                                     *","+ *  -------------------------------------------------  *","+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+ *  -------------------------------------------------  *","+ *  | 0x0 | 0x4 | 0x8 | 0xc | 0x10| 0x14| 0x18| 0x1c|  *","+ *  -------------------------------------------------  *","+ *  |    fs0    |    fs1    |    fs2    |    fs3    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------