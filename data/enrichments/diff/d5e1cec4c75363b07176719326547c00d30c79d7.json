{"id":"d5e1cec4c75363b07176719326547c00d30c79d7","axis":"silent","repo":"facebook/rocksdb","sha":"d5e1cec4c75363b07176719326547c00d30c79d7","parsed":{"files":[{"path":"utilities/transactions/write_prepared_transaction_test.cc","lines":["@@ -2566,6 +2566,56 @@ TEST_P(WritePreparedTransactionTest, RollbackPreparedAfterCommitWriteFailure) {","   ASSERT_OK(ReOpenNoDelete());"," }"," ","+TEST_P(WritePreparedTransactionTest, RollbackPreparedWithReadError) {","+  // Rolling back a prepared transaction reads the pre-transaction value of","+  // each written key. A retryable read IO error during that lookup must be","+  // returned to the caller with the transaction still PREPARED so that","+  // rollback can be retried.","+  BlockBasedTableOptions bbto;","+  bbto.no_block_cache = true;","+  options.table_factory.reset(NewBlockBasedTableFactory(bbto));","+  ASSERT_OK(ReOpen());","+  fault_fs->SetFileTypesExcludedFromFaultInjection({FileType::kInfoLogFile});","+","+  ASSERT_OK(db->Put(WriteOptions(), \"key\", \"value\"));","+  ASSERT_OK(db->Flush(FlushOptions()));","+","+  TransactionOptions txn_options;","+  std::unique_ptr<Transaction> txn(","+      db->BeginTransaction(WriteOptions(), txn_options));","+  ASSERT_NE(nullptr, txn);","+  ASSERT_OK(txn->SetName(\"rollback_read_error\"));","+  ASSERT_OK(txn->Delete(\"key\"));","+  ASSERT_OK(txn->Prepare());","+","+  fault_fs->SetThreadLocalErrorContext(FaultInjectionIOType::kRead,","+                                       /*seed=*/0, /*one_in=*/1,","+                                       /*retryable=*/true,","+                                       /*has_data_loss=*/false);","+  fault_fs->EnableThreadLocalErrorInjection(FaultInjectionIOType::kRead);","+  const Status rollback_s = txn->Rollback();","+  fault_fs->DisableThreadLocalErrorInjection(FaultInjectionIOType::kRead);","+","+  ASSERT_NOK(rollback_s);","+  ASSERT_TRUE(rollback_s.IsIOError()) << rollback_s.ToString();","+  ASSERT_TRUE(FaultInjectionTestFS::IsInjectedError(rollback_s))","+      << rollback_s.ToString();","+  ASSERT_GE(fault_fs->GetAndResetInjectedThreadLocalErrorCount(","+                FaultInjectionIOType::kRead),","+            1);","+","+  ASSERT_OK(txn->Rollback());","+  txn.reset();","+","+  std::string value;","+  ASSERT_OK(db->Get(ReadOptions(), \"key\", &value));","+  ASSERT_EQ(\"value\", value);","+","+  ASSERT_OK(ReOpenNoDelete());","+  ASSERT_OK(db->Get(ReadOptions(), \"key\", &value));","+  ASSERT_EQ(\"value\", value);","+}","+"," TEST_P(WritePreparedTransactionTest, DisableGCDuringRecovery) {","   // Use large buffer to avoid memtable flush after 1024 insertions","   options.write_buffer_size = 1024 * 1024;"],"additions":50,"deletions":0,"truncated":false},{"path":"utilities/transactions/write_prepared_txn.cc","lines":["@@ -433,8 +433,10 @@ Status WritePreparedTxn::RollbackInternal() {","       get_impl_options.value = &pinnable_val;","       get_impl_options.value_found = &not_used;","       get_impl_options.callback = &callback_;","+      // The lookup can fail with an IO error (e.g. a retryable read error);","+      // such errors are returned to the caller, which keeps the transaction","+      // PREPARED so the rollback can be retried.","       s = db_->GetImpl(roptions_, key, get_impl_options);","-      assert(s.ok() || s.IsNotFound());","       if (s.ok()) {","         s = rollback_batch_->Put(cf_handle, key, pinnable_val);","         assert(s.ok());"],"additions":3,"deletions":1,"truncated":false},{"path":"utilities/transactions/write_unprepared_txn_db.cc","lines":["@@ -107,8 +107,8 @@ Status WriteUnpreparedTxnDB::RollbackRecoveredTransaction(","         get_impl_options.value = &pinnable_val;","         get_impl_options.value_found = &not_used;","         get_impl_options.callback = &callback;","+        // The lookup can fail with an IO error; return it to the caller.","         s = db_->GetImpl(roptions, key, get_impl_options);","-        assert(s.ok() || s.IsNotFound());","         if (s.ok())