($queryBuilder);","     }"," ","+    public function updateBackendUserPasswordHash(int $uid, string $passwordHash): void","+    {","+        $this->updateRecord('be_users', $uid, ['password' => $passwordHash]);","+    }","+","+    public function updateFrontendUserPasswordHash(int $uid, string $passwordHash): void","+    {","+        $this->updateRecord('fe_users', $uid, ['password' => $passwordHash]);","+    }","+","+    public function updateBackendUserLastLogin(int $uid, int $timestamp): void","+    {","+        $this->updateRecord('be_users', $uid, ['lastlogin' => $timestamp]);","+    }","+","+    public function updateFrontendUserLastLogin(int $uid, int $timestamp): void","+    {","+        $this->updateRecord('fe_users', $uid, ['lastlogin' => $timestamp]);","+    }","+","+    private function updateRecord(string $table, int $uid, array $fields): void","+    {","+        $this->connectionPool->getConnectionForTable($table)->update($table, $fields, ['uid' => $uid]);","+    }","+","     /**","      * @param list<int>|null $storagePageIds","      */"],"additions":25,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Security/PasswordCredentialVerifier.php","lines":["@@ -0,0 +1,119 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Security;","+","+use Psr\\EventDispatcher\\EventDispatcherInterface;","+use Psr\\Http\\Message\\ServerRequestInterface;","+use TYPO3\\CMS\\Core\\Authentication\\AbstractUserAuthentication;","+use TYPO3\\CMS\\Core\\Authentication\\Event\\BeforeRequestTokenProcessedEvent;","+use TYPO3\\CMS\\Core\\Context\\Context;","+use TYPO3\\CMS\\Core\\Context\\SecurityAspect;","+use TYPO3\\CMS\\Core\\Crypto\\PasswordHashing\\InvalidPasswordHashException;","+use TYPO3\\CMS\\Core\\Crypto\\PasswordHashing\\PasswordHashFactory;","+","+/**","+ * The parts of a password login that the native backend and frontend","+ * authenticators share: the request token check, the password verification","+ * against a stored hash, the creation of a replacement hash and the timing","+ * mitigation for unknown users. The hash method and the request token scope","+ * are derived from the login type of the user object.","+ *","+ * Nothing is persisted here: where a user record and its hash are stored is","+ * the business of the identity provider the authenticator looked the user up","+ * with.","+ *","+ * @internal not part of TYPO3 Core API yet, still experimental as part of the","+ *           authentication pipeline groundwork","+ */","+final readonly class PasswordCredentialVerifier","+{","+    public function __construct(","+        private PasswordHashFactory $passwordHashFactory,","+        private Context $context,","+        private EventDispatcherInterface $eventDispatcher,","+    ) {}","+","+    /**","+     * Validates the submitted request token (nonce) for the authentication","+     * scope of the user (\"core/user-auth/be\" or \"core/user-auth/fe\") and","+     * revokes its signing secret. Listeners of BeforeRequestTokenProcessedEvent","+     * may adjust the token, felogin also derives the storage page restriction","+     * from it.","+     */","+    public function requestTokenMatches(AbstractUserAuthentication $user, ServerRequestInterface $request): bool","+    {","+        $securityAspect = SecurityAspect::provideIn($this->context);","+        $event = new BeforeRequestTokenProcessedEvent($user, $request, $securityAspect->getReceivedRequestToken());","+        $this->eventDispatcher->dispatch($event);","+        $requestToken = $event->getRequestToken();","+        if (($requestToken->scope ?? null) !== 'core/user-auth/' . strtolower($user->loginType)) {","+            return false;","+        }","+        if ($requestToken instanceof RequestToken && $requestToken->getSigningSecretIdentifier() !== null) {","+            $securityAspect->getSigningSecretResolver()->revokeIdentifier($requestToken->getSigningSecretIdentifier());","+        }","+        return true;","+    }","+","+    /**","+     * Verifies the password against the stored hash. A matching password whose","+     * hash is outdated or not created with the default hash method of the login","+     * type is reported as such, so the caller can store a replacement created by","+     * hashPassword().","+     */","+    public function verify(AbstractUserAuthentication $user, string $passwordHash, string $password): PasswordVerification","+    {","+        try {","+            $hashInstance = $this->passwordHashFactory->get($passwordHash, $user->loginType);","+        } catch (InvalidPasswordHashException) {","+            return PasswordVerification::NoSuitableHashMethod;","+        }","+        if (!$hashInstance->checkPassword($password, $passwordHash)) {","+            return PasswordVerification::Invalid;","+        }","+        // Don't catch InvalidPasswordHashException here: Only install tool should handle those configuration failures","+        $defaultHashInstance = $this->passwordHashFactory->getDefaultHashInstance($user->loginType);","+        // Lax object comparison intended: Rehash if old and new salt objects are not","+        // instances of the same class.","+        if ($hashInstance->isHashUpdateNeeded($passwordHash) || $defaultHashInstance != $hashInstance) {","+            return PasswordVerification::VerifiedWithOutdatedHash;","+        }","+        return PasswordVerification::Verified;","+    }","+","+    /**","+     * Hashes the password with the default hash method of the login type of the user.","+     */","+    public function hashPassword(AbstractUserAuthentication $user, string $password): string","+    {","+        return $this->passwordHashFactory->getDefaultHashInstance($user->loginType)->getHashedPassword($password);","+    }","+","+    /**","+     * Mimics password hashing for a login of an unknown user to mitigate","+     * @link https://cwe.mitre.org/data/definitions/208.html: CWE-208: Observable Timing Discrepancy","+     */","+    public function mimicPasswordHashing(AbstractUserAuthentication $user): void","+    {","+        try {","+            $this->hashPassword($user, random_bytes(10));","+        } catch (\\Exception) {","+            // no further processing here","+        }","+    }","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Security/PasswordVerification.php","lines":["@@ -0,0 +1,32 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Security;","+","+/**","+ * The result of verifying a submitted password against a stored hash.","+ *","+ * @internal not part of TYPO3 Core API yet, still experimental as part of the","+ *           authentication pipeline groundwork","+ */","+enum PasswordVerification","+{","+    case Verified;","+    case VerifiedWithOutdatedHash;","+    case NoSuitableHashMethod;","+    case Invalid;","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Authentication/LocalIdentityProviderTest.php","lines":["@@ -156,4 +156,36 @@ public function returnsNullForEmptyUsernameAndNonPositiveUid(): void","         self::assertNull($this->subject->findFrontendUserByUsername('', null));","         self::assertNull($this->subject->findFrontendUserByUid(-1));","     }","+","+    #[Test]","+    public function updatesPasswordHashOfBackendUser(): void","+    {","+        $this->subject->updateBackendUserPasswordHash(100, 'new-backend-hash');","+        self::assertSame('new-backend-hash', $this->subject->findBackendUserByUid(100)['password'] ?? null);","+        self::assertSame('', $this->subject->findFrontendUserByUid(200)['password'] ?? null);","+    }","+","+    #[Test]","+    public function updatesPasswordHashOfFrontendUser(): void","+    {","+        $this->subject->updateFrontendUserPasswordHash(200, 'new-frontend-hash');","+        self::assertSame('new-frontend-hash', $this->subject->findFrontendUserByUid(200)['password'] ?? null);","+        self::assertSame('', $this->subject->findBackendUserByUid(100)['password'] ?? null);","+    }","+","+    #[Test]","+    public function updatesLastLoginOfBackendUser(): void","+    {","+        $this->subject->updateBackendUserLastLogin(100, 1763372400);","+        self::assertSame(1763372400, $this->subject->findBackendUserByUid(100)['lastlogin'] ?? null);","+        self::assertSame(0, $this->subject->findFrontendUserByUid(200)['lastlogin'] ?? null);","+    }","+","+    #[Test]","+    public function updatesLastLoginOfFrontendUser(): void","+    {","+        $this->subject->updateFrontendUserLastLogin(200, 1763372400);","+        self::assertSame(1763372400, $this->subject->findFrontendUserByUid(200)['lastlogin'] ?? null);","+        self::assertSame(0, $this->subject->findBackendUserByUid(100)['lastlogin'] ?? null);","+    }"," }"],"additions":32,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Security/PasswordCredentialVerifierTest.php","lines":["@@ -0,0 +1,163 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Tests\\Functional\\Security;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\Authentication\\BackendUserAuthentication;","+use TYPO3\\CMS\\Core\\Context\\Context;","+use TYPO3\\CMS\\Core\\Context\\SecurityAspect;","+use TYPO3\\CMS\\Core\\Crypto\\PasswordHashing\\Argon2idPasswordHash;","+use TYPO3\\CMS\\Core\\Crypto\\PasswordHashing\\PasswordHashFactory;","+use TYPO3\\CMS\\Core\\Crypto\\PasswordHashing\\PhpassPasswordHash;","+use TYPO3\\CMS\\Core\\Http\\ServerRequest;","+use TYPO3\\CMS\\Core\\Security\\Nonce;","+use TYPO3\\CMS\\Core\\Security\\NoncePool;","+use TYPO3\\CMS\\Core\\Security\\PasswordCredentialVerifier;","+use TYPO3\\CMS\\Core\\Security\\PasswordVerification;","+use TYPO3\\CMS\\Core\\Security\\RequestToken;","+use TYPO3\\CMS\\Frontend\\Authentication\\FrontendUserAuthentication;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class PasswordCredentialVerifierTest extends FunctionalTestCase","+{","+    private const string PASSWORD = 'test-password-1234';","+","+    #[Test]","+    public function passwordMatchingDefaultHashIsVerified(): void","+    {","+        $passwordHash = $this->get(PasswordHashFactory::class)->getDefaultHashInstance('BE')->getHashedPassword(self::PASSWORD);","+","+        $result = $this->get(PasswordCredentialVerifier::class)->verify(new BackendUserAuthentication(), $passwordHash, self::PASSWORD);","+","+        self::assertSame(PasswordVerification::Verified, $result);","+    }","+","+    #[Test]","+    public function passwordMatchingHashOfOtherMethodIsVerifiedWithOutdatedHash(): void","+    {","+        $passwordHash = new PhpassPasswordHash()->getHashedPassword(self::PASSWORD);","+","+        $result = $this->get(PasswordCredentialVerifier::class)->verify(new BackendUserAuthentication(), $passwordHash, self::PASSWORD);","+","+        self::assertSame(PasswordVerification::VerifiedWithOutdatedHash, $result);","+    }","+","+    #[Test]","+    public function passwordMatchingHashWithOutdatedOptionsIsVerifiedWithOutdatedHash(): void","+    {","+        $passwordHash = new Argon2idPasswordHash(['time_cost' => 4])->getHashedPassword(self::PASSWORD);","+","+        $result = $this->get(PasswordCredentialVerifier::class)->verify(new BackendUserAuthentication(), $passwordHash, self::PASSWORD);","+","+        self::assertSame(PasswordVerification::VerifiedWithOutdatedHash, $result);","+    }","+","+    #[Test]","+    public function wrongPasswordIsInvalid(): void","+    {","+        $passwordHash = new PhpassPasswordHash()->getHashedPassword(self::PASSWORD);","+","+        $result = $this->get(PasswordCredentialVerifier::class)->verify(new BackendUserAuthentication(), $passwordHash, 'wrong-password');","+","+        self::assertSame(PasswordVerification::Invalid, $result);","+    }","+","+    #[Test]","+    public function unknownHashFormatHasNoSuitableHashMethod(): void","+    {","+        $result = $this->get(PasswordCredentialVerifier::class)->verify(new BackendUserAuthentication(), 'not-a-password-hash', self::PASSWORD);","+","+        self::assertSame(PasswordVerification::NoSuitableHashMethod, $result);","+    }","+","+    #[Test]","+    public function hashedPasswordUsesDefaultHashMethodOfLoginType(): void","+    {","+        $passwordHashFactory = $this->get(PasswordHashFactory::class);","+        $subject = $this->get(PasswordCredentialVerifier::class);","+","+        $backendHash = $subject->hashPassword(new BackendUserAuthentication(), self::PASSWORD);","+        $frontendHash = $subject->hashPassword(new FrontendUserAuthentication(), self::PASSWORD);","+","+        self::assertFalse($passwordHashFactory->getDefaultHashInstance('BE')->isHashUpdateNeeded($backendHash));","+        self::assertTrue($passwordHashFactory->getDefaultHashInstance('BE')->checkPassword(self::PASSWORD, $backendHash));","+        self::assertFalse($passwordHashFactory->getDefaultHashInstance('FE')->isHashUpdateNeeded($frontendHash));","+        self::assertTrue($passwordHashFactory->getDefaultHashInstance('FE')->checkPassword(self::PASSWORD, $frontendHash));","+        self::assertSame(PasswordVerification::Verified, $subject->verify(new FrontendUserAuthentication(), $frontendHash, self::PASSWORD));","+    }","+","+    #[Test]","+    public function requestTokenOfAnotherScopeDoesNotMatch(): void","+    {","+        SecurityAspect::provideIn($this->get(Context::class))->setReceivedRequestToken(RequestToken::create('core/user-auth/fe'));","+","+        $result = $this->get(PasswordCredentialVerifier::class)->requestTokenMatches(","+            new BackendUserAuthentication(),","+            new ServerRequest('https://example.com/typo3/login', 'POST'),","+        );","+","+        self::assertFalse($result);","+    }","+","+    #[Test]","+    public function requestTokenOfTheScopeMatches(): void","+    {","+        SecurityAspect::provideIn($this->get(Context::class))->setReceivedRequestToken(RequestToken::create('core/user-auth/be'));","+","+        $result = $this->get(PasswordCredentialVerifier::class)->requestTokenMatches(","+            new BackendUserAuthentication(),","+            new ServerRequest('https://example.com/typo3/login', 'POST'),","+        );","+","+        self::assertTrue($result);","+    }","+","+    #[Test]","+    public function requestTokenOfFrontendScopeMatchesFrontendUser(): void","+    {","+        SecurityAspect::provideIn($this->get(Context::class))->setReceivedRequestToken(RequestToken::create('core/user-auth/fe'));","+","+        $result