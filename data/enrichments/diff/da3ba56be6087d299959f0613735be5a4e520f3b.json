 {getPublishDate, useFormatPublishDateTime} from './useFormatPublishDateTime'","+","+/** When a scheduled draft goes out. Undated ones sort last. */","+function getScheduledTime(release: ReleaseDocument): number {","+  const date = getPublishDate(release)","+  return date ? new Date(date).getTime() : Number.POSITIVE_INFINITY","+}","+","+function ScheduledDraftMenuItem(props: {","+  isSelected: boolean","+  label: string","+  onSelect: (release: ReleaseDocument) => void","+  release: ReleaseDocument","+}) {","+  const {isSelected, label, onSelect, release} = props","+  const handleClick = useCallback(() => onSelect(release), [onSelect, release])","+","+  return (","+    <MenuItem","+      data-testid={`document-scheduled-draft-${getReleaseIdFromReleaseDocumentId(release._id)}`}","+      icon={<ReleaseAvatar padding={2} release={release} />}","+      iconRight={isPausedCardinalityOneRelease(release) ? UnlockIcon : undefined}","+      onClick={handleClick}","+      pressed={isSelected}","+      selected={isSelected}","+      text={label}","+    />","+  )","+}","+","+/**","+ * Opens one of the scheduled drafts of the selected variant of the document (Default when none","+ * is selected) in this pane, listed by the date they go out. Renders only when scheduled drafts","+ * are enabled and the variant has at least one.","+ *","+ * @internal","+ */","+export function DocumentScheduledDraftsMenu() {","+  const {t} = useTranslation(structureLocaleNamespace)","+  const {t: tStudio} = useTranslation()","+  const isScheduledDraftsEnabled = useScheduledDraftsEnabled()","+  const {documentId} = useDocumentPane()","+  const {versions} = useDocumentVersions({documentId: getPublishedId(documentId)})","+  const {data: activeReleases} = useActiveReleases()","+  const {selectedPerspective} = usePerspective()","+  const selectedVariant = useSelectedVariant(DEFAULT_VARIANT_TYPE_KEY)","+  const formatPublishDateTime = useFormatPublishDateTime()","+  const {navigate} = usePerspectiveNavigator()","+  const {params, setParams} = usePaneRouter()","+  const [filterQuery, setFilterQuery] = useState('')","+","+  const variantId = selectedVariant?._id","+  const scheduledDrafts = useMemo(() => {","+    const documentReleaseIds = new Set(getNavigationBadges({versions, variantId}).releaseIds)","+    return activeReleases","+      .filter(","+        (release) =>","+          isCardinalityOneRelease(release) &&","+          documentReleaseIds.has(getReleaseIdFromReleaseDocumentId(release._id)),","+      )","+      .toSorted((a, b) => getScheduledTime(a) - getScheduledTime(b))","+  }, [activeReleases, variantId, versions])","+","+  const untitledRelease = tStudio('release.placeholder-untitled-release')","+  const getLabel = useCallback(","+    (release: ReleaseDocument) => formatPublishDateTime(release) ?? untitledRelease,","+    [formatPublishDateTime, untitledRelease],","+  )","+  const visibleScheduledDrafts = useMemo(() => {","+    const query = filterQuery.trim().toLowerCase()","+    if (!query) return scheduledDrafts","+    return scheduledDrafts.filter((release) => getLabel(release).toLowerCase().includes(query))","+  }, [filterQuery, getLabel, scheduledDrafts])","+","+  const handleSelect = useCallback(","+    (release: ReleaseDocument) => {","+      navigate(release)","+      setFilterQuery('')","+    },","+    [navigate],","+  )","+  // Drop the pane param only. `onSetScheduledDraftPerspective` also clears the global","+  // perspective, which is what opening a scheduled draft does so it does not stay inside a release.","+  const handleClear = useCallback(() => {","+    setParams({...params, scheduledDraft: undefined})","+  }, [params, setParams])","+","+  if (!isScheduledDraftsEnabled || scheduledDrafts.length === 0) {","+    return null","+  }","+","+  const selectedScheduledDraft =","+    isReleaseDocument(selectedPerspective) && isCardinalityOneRelease(selectedPerspective)","+      ? selectedPerspective","+      : undefined","+","+  return (","+    <DocumentNavigationMenu","+      testId=\"document-scheduled-drafts-menu\"","+      button={","+        <DropdownButton","+          data-testid=\"document-scheduled-drafts-menu-button\"","+          icon={isPausedCardinalityOneRelease(selectedScheduledDraft) ? UnlockIcon : ClockIcon}","+          onClear={selectedScheduledDraft ? handleClear : undefined}","+          tone={selectedScheduledDraft ? getReleaseTone(selectedScheduledDraft) : undefined}","+          text={","+            selectedScheduledDraft","+              ? getLabel(selectedScheduledDraft)","+              : t('document-panel-navigation.scheduled-drafts.button.text')","+          }","+        />","+      }","+      filterPlaceholder={t('document-panel-navigation.filter-placeholder')}","+      filterQuery={filterQuery}","+      onFilterChange={setFilterQuery}","+      sections={[","+        {","+          key: 'scheduled',","+          label: t('document-panel-navigation.scheduled-drafts.section.scheduled-for'),","+          items: visibleScheduledDrafts.map((release) => (","+            <ScheduledDraftMenuItem","+              isSelected={selectedScheduledDraft?._id === release._id}","+              key={release._id}","+              label={getLabel(release)}","+              onSelect={handleSelect}","+              release={release}","+            />","+          )),","+        },","+      ]}","+    />","+  )","+}"],"additions":162,"deletions":0,"truncated":false},{"path":"packages/sanity/src/structure/panes/document/documentPanel/header/DocumentPanelNavigation/scheduledDrafts/__tests__/DocumentScheduledDraftsMenu.test.tsx","lines":["@@ -0,0 +1,271 @@","+import {type ReleaseDocument} from '@sanity/client'","+import {render, screen, within} from '@testing-library/react'","+import {userEvent} from '@testing-library/user-event'","+import {","+  useActiveReleases,","+  useDocumentVersions,","+  usePerspective,","+  useScheduledDraftsEnabled,","+  type VersionInfoDocumentStub,","+} from 'sanity'","+import {afterEach, beforeAll, beforeEach, describe, expect, it, type Mock, vi} from 'vitest'","+","+import {createTestProvider} from '../../../../../../../../../test/testUtils/TestProvider'","+import {usePaneRouter} from '../../../../../../../components/paneRouter/usePaneRouter'","+import {usePerspectiveNavigator} from '../../../../../../../hooks/usePerspectiveNavigator'","+import {structureUsEnglishLocaleBundle} from '../../../../../../../i18n'","+import {type DocumentPaneContextValue} from '../../../../../DocumentPaneContext'","+import {useDocumentPane} from '../../../../../useDocumentPane'","+import {","+  createPerspective,","+  createRelease,","+  createVariant,","+  createVersion,","+  GROUP_ID,","+} from '../../__tests__/fixtures'","+import {DocumentScheduledDraftsMenu} from '../DocumentScheduledDraftsMenu'","+","+vi.mock('sanity', async (importOriginal) => ({","+  ...(await importOriginal()),","+  useActiveReleases: vi.fn(),","+  useDocumentVersions: vi.fn(),","+  usePerspective: vi.fn(),","+  useScheduledDraftsEnabled: vi.fn(),","+}))","+","+vi.mock('../../../../../useDocumentPane')","+vi.mock('../../../../../../../hooks/usePerspectiveNavigator')","+vi.mock('../../../../../../../components/paneRouter/usePaneRouter')","+","+const mockUseActiveReleases = useActiveReleases as Mock<typeof useActiveReleases>","+const mockUseDocumentVersions = useDocumentVersions as Mock<typeof useDocumentVersions>","+const mockUsePerspective = usePerspective as Mock<typeof usePerspective>","+const mockUseScheduledDraftsEnabled = useScheduledDraftsEnabled as Mock<","+  typeof useScheduledDraftsEnabled","+>","+const mockUseDocumentPane = useDocumentPane as Mock<() => Partial<DocumentPaneContextValue>>","+const mockUsePerspectiveNavigator = usePerspectiveNavigator as Mock<typeof usePerspectiveNavigator>","+const mockUsePaneRouter = usePaneRouter as Mock<() => Partial<ReturnType<typeof usePaneRouter>>>","+","+/**","+ * A scheduled draft going out on `date`, mid-month at noon so the day is the same everywhere.","+ * A paused one stays active with only its intended date, the way pausing leaves it.","+ */","+function createScheduledDraft(","+  releaseId: string,","+  date: string,","+  options: {paused?: boolean} = {},","+): ReleaseDocument {","+  const publishAt = `${date}T12:00:00.000Z`","+  const scheduledDraft = createRelease(releaseId, '', {","+    cardinality: 'one',","+    releaseType: 'scheduled',","+    intendedPublishAt: publishAt,","+  })","+  return options.paused ? scheduledDraft : {...scheduledDraft, state: 'scheduled', publishAt}","+}","+","+const variantA = createVariant('variantA', 'Variant A')","+const decemberDraft = createScheduledDraft('rDecember', '2026-12-15', {paused: true})","+const novemberDraft = createScheduledDraft('rNovember', '2026-11-10')","+const variantDraft = createScheduledDraft('rVariant', '2026-11-20')","+const release = createRelease('rA', 'Release A')","+","+const navigate = vi.fn()","+const setParams = vi.fn()","+let wrapper: React.ComponentType<{children: React.ReactNode}>","+","+function mockVersions(versions: VersionInfoDocumentStub[]) {","+  mockUseDocumentVersions.mockReturnValue({","+    data: versions.map((version) => version._id),","+    versions,","+    loading: false,","+  })","+}","+","+async function renderMenu() {","+  render(","+    <>","+      <span data-testid=\"rendered\" />","+      <DocumentScheduledDraftsMenu />","+    </>,","+    {wrapper},","+  )","+  // The locale provider suspends on the first render.","+  await screen.findByTestId('rendered')","+}","+","+async function openMenu() {","+  await userEvent.click(screen.getByTestId('document-scheduled-drafts-menu-button'))","+  return screen.findByTestId('document-scheduled-drafts-menu')","+}","+","+beforeAll(async () => {","+  wrapper = await createTestProvider({resources: [structureUsEnglishLocaleBundle]})","+})","+","+describe('DocumentScheduledDraftsMenu', () => {","+  beforeEach(() => {","+    mockUseDocumentPane.mockReturnValue({documentId: GROUP_ID})","+    mockUsePerspective.mockReturnValue(createPerspective())","+    mockUsePerspectiveNavigator.mockReturnValue({navigate})","+    mockUsePaneRouter.mockReturnValue({params: {view: 'form'}, setParams})","+    mockUseScheduledDraftsEnabled.mockReturnValue(true)","+    const activeReleases = [release, decemberDraft, novemberDraft, variantDraft]","+    mockUseActiveReleases.mockReturnValue({","+      data: activeReleases,","+      byId: new Map(activeReleases.map((activeRelease) => [activeRelease._id, activeRelease])),","+      loading: false,","+      dispatch: vi.fn(),","+    })","+    mockVersions([","+      createVersion({bundle: 'published'}),","+      createVersion({bundle: {release: 'rA'}}),","+      createVersion({bundle: {release: 'rDecember'}}),","+      createVersion({bundle: {release: 'rNovember'}}),","+      createVersion({bundle: {release: 'rVariant'}, variant: 'variantA'}),","+    ])","+  })","+","+  afterEach(() => {","+    vi.clearAllMocks()","+  })","+","+  it('renders nothing when scheduled drafts are disabled', async () => {","+    mockUseScheduledDraftsEnabled.mockReturnValue(false)","+    await renderMenu()","+","+    expect(screen.queryByTestId('document-scheduled-drafts-menu-button')).toBeNull()","+  })","+","+  it('renders nothing when the selected variant has no scheduled draft', async () => {","+    mockVersions([","+      createVersion({bundle: 'published'}),","+      createVersion({bundle: {release: 'rA'}}),","+      createVersion({bundle: {release: 'rVariant'}, variant: 'variantA'}),","+    ])","+    await renderMenu()","+","+    expect(screen.queryByTestId('document-scheduled-drafts-menu-button')).toBeNull()","+  })","+","+  it('lists the scheduled drafts of the document by date, in one \"Scheduled for:\" section', async () => {","+    await renderMenu()","+","+    expect(screen.getByTestId('document-scheduled-drafts-menu-button')).toHaveTextContent(","+      'Scheduled drafts',","+    )","+    const menu = await op