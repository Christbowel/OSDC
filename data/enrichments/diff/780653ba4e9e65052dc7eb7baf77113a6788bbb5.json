 example to launch, one of: cloud, techproducts, schemaless, films.\")","+          \"Name of the example to launch, one of: cloud, secure, techproducts, schemaless, films.\")","   private String exampleOpt;"," ","   @picocli.CommandLine.Option(","@@ -499,13 +506,14 @@ public void runImpl(CommandLine cli) throws Exception {","             + script);"," ","     if (!\"cloud\".equals(exampleType)","+        && !\"secure\".equals(exampleType)","         && !\"techproducts\".equals(exampleType)","         && !\"schemaless\".equals(exampleType)","         && !\"films\".equals(exampleType)) {","       throw new IllegalArgumentException(","           \"Unsupported example \"","               + exampleType","-              + \"! Please choose one of: cloud, schemaless, techproducts, or films\");","+              + \"! Please choose one of: cloud, secure, schemaless, techproducts, or films\");","     }"," ","     StartSolrParams startParams =","@@ -523,6 +531,7 @@ public void runImpl(CommandLine cli) throws Exception {","         Integer.parseInt(","             cli.getOptionValue(","                 PORT_OPTION, System.getenv().getOrDefault(\"SOLR_PORT_LISTEN\", \"8983\")));","+    validatePort(port);"," ","     if (\"cloud\".equals(exampleType)) {","       runCloudExample(","@@ -532,12 +541,31 @@ public void runImpl(CommandLine cli) throws Exception {","               zkHost,","               port,","               startParams));","+    } else if (\"secure\".equals(exampleType)) {","+      runSecureExample(","+          new CloudExampleParams(","+              cli.hasOption(NO_PROMPT_OPTION),","+              cli.getOptionValue(SCRIPT_INPUTS_OPTION),","+              zkHost,","+              port,","+              startParams),","+          cli.hasOption(USER_MANAGED_OPTION));","     } else {","       runExample(","           new RunExampleParams(!cli.hasOption(USER_MANAGED_OPTION), zkHost, port, startParams));","     }","   }"," ","+  /**","+   * Rejects ports outside the