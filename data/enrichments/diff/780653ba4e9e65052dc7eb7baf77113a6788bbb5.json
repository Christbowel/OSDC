"+  void runSecureExample(CloudExampleParams params, boolean userManaged) throws Exception {","+    StartSolrParams start = params.start();","+    if (userManaged || params.zkHost() != null) {","+      throw new IllegalArgumentException(","+          \"The secure example requires its own embedded ZooKeeper in SolrCloud mode.\");","+    }","+    if (start.host() != null","+        || start.jvmOpts() != null","+        || !start.extraArgs().isEmpty()","+        || params.scriptInputs() != null","+        || System.getenv(\"SOLR_DATA_HOME\") != null) {","+      throw new IllegalArgumentException(","+          \"Unsupported argument provided.  'secure' example currently only supports: --solr-home,\"","+              + \" -p, --no-prompt, -m, or --force.\");","+    }","+    int port = params.basePort();","+    String password = generateSecureExamplePassword();","+    Path home = solrHomeDir.toAbsolutePath().normalize();","+    echo(","+        \"Commands below use paths relative to \"","+            + serverDir.getParent().toAbsolutePath().normalize());","+    Path tls = home.resolve(\"tls\");","+    Path include = tls.resolve(\"solr.in.sh\");","+    String zkHost = \"localhost:\" + (port + 1000);","+    Map<String, String> environment = new HashMap<>(EnvironmentUtils.getProcEnvironment());","+    environment.put(\"SOLR_INCLUDE\", include.toString());","+    environment.put(\"SOLR_ULIMIT_CHECKS\", \"false\");","+    environment.put(\"SOLR_PID_DIR\", home.toString());","+    environment.put(\"SOLR_HOME\", tls.toString());","+    environment.remove(\"SOLR_ZK_CREDS_AND_ACLS\");","+    environment.remove(\"ZK_HOST\");","+    echo(","+        \"Generated password: \"","+            + password","+            + \" (used for the keystore and all basic-auth/ZooKeeper demonstration accounts below).\");","+    echo(\"ZooKeeper is protected by digest ACLs; its transport remains plaintext on loopback.\");","+    if (!params.noPrompt()) {","+      prompt(","+          userInputScanner(),","+          \"Press Enter to delete and recreate \"","+              + secureExampleDisplayArgument(home.toString())","+              + \", or Ctrl-C to cancel: \",","+          \"\");","+    }","+    resetSecureExampleHome(home, environment);","+    Files.setPosixFilePermissions(home, PosixFilePermissions.fromString(\"rwx------\"));","+    Files.createDirectories(tls);","+    Files.setPosixFilePermissions(tls, PosixFilePermissions.fromString(\"rwx------\"));","+    for (String node : List.of(\"node1\", \"node2\")) {","+      Path nodeHome = Files.createDirectories(home.resolve(node).resolve(\"solr\"));","+      for (String file : List.of(\"solr.xml\", \"zoo.cfg\")) {","+        Files.copy(serverDir.resolve(\"solr\").resolve(file), nodeHome.resolve(file));","+      }","+    }","+    writeSecureExampleFile(","+        include,","+        String.format(","+            Locale.ROOT,","+            \"\"\"","+            SOLR_ULIMIT_CHECKS=false","+            SOLR_HOST_BIND=127.0.0.1","+            SOLR_HOST_ADVERTISE=127.0.0.1","+            SOLR_PID_DIR=%s","+            SOLR_OPTS=%s","+            \"\"\",","+            secureExampleShellQuote(home.toString()),","+            secureExampleShellQuote(\"-Dsolr.security.allow.paths=\" + home)));","+    boolean ready = false;","+    try {","+      echo(\"\\n\");","+      echo(\"1. Start both nodes.\");","+      startSecureNodes(params, home, environment, zkHost);","+      for (int nodePort : List.of(port, port + 1)) {","+        waitForSecureExample(","+            environment, tls, null, \"http://localhost:\" + nodePort + \"/api/node/health\");","+      }","+      stopSecureNodes(port, environment);","+","+      echo(\"\\n\");","+      echo(\"2. Generate a self-signed certificate and PKCS12 key and trust stores.\");","+      String keytool = Path.of(EnvUtils.getProperty(\"java.home\"), \"bin\", \"keytool\").toString();","+      runSecureCommand(","+          environment,","+          keytool,","+          \"-genkeypair\",","+          \"-alias\",","+          \"solr-ssl\",","+          \"-keyalg\",","+          \"RSA\",","+          \"-keysize\",","+          \"2048\",","+          \"-validity\",","+          \"365\",","+          \"-dname\",","+          \"CN=localhost\",","+          \"-ext\",","+          \"SAN=DNS:localhost,IP:127.0.0.1\",","+          \"-storetype\",","+          \"PKCS12\",","+          \"-keystore\",","+          tls.resolve(\"solr-ssl.keystore.p12\").toString(),","+          \"-storepass\",","+          password,","+          \"-keypass\",","+          password);","+      runSecureCommand(","+          environment,","+          keytool,","+          \"-exportcert\",","+          \"-rfc\",","+          \"-alias\",","+          \"solr-ssl\",","+          \"-keystore\",","+          tls.resolve(\"solr-ssl.keystore.p12\").toString(),","+          \"-storetype\",","+          \"PKCS12\",","+          \"-storepass\",","+          password,","+          \"-file\",","+          tls.resolve(\"cert.pem\").toString());","+      runSecureCommand(","+          environment,","+          keytool,","+          \"-importcert\",","+          \"-noprompt\",","+          \"-alias\",","+          \"solr-ssl\",","+          \"-file\",","+          tls.resolve(\"cert.pem\").toString(),","+          \"-storetype\",","+          \"PKCS12\",","+          \"-keystore\",","+          tls.resolve(\"solr-ssl.truststore.p12\").toString(),","+          \"-storepass\",","+          password);","+      runSecureCommand(","+          environment,","+          \"openssl\",","+          \"x509\",","+          \"-in\",","+          tls.resolve(\"cert.pem\").toString(),","+          \"-noout\",","+          \"-subject\",","+          \"-dates\");","+      Files.writeString(","+          include,","+          String.format(","+              Locale.ROOT,","+              \"\"\"","+              SOLR_SSL_ENABLED=true","+              SOLR_SSL_KEY_STORE=%s","+              SOLR_SSL_KEY_STORE_TYPE=PKCS12","+              SOLR_SSL_KEY_STORE_PASSWORD=%s","+              SOLR_SSL_TRUST_STORE=%s","+              SOLR_SSL_TRUST_STORE_TYPE=PKCS12","+              SOLR_SSL_TRUST_STORE_PASSWORD=%s","+              SOLR_SSL_CLIENT_TRUST_STORE=${SOLR_SSL_CLIENT_TRUST_STORE:-%s}","+              SOLR_SSL_CLIENT_TRUST_STORE_TYPE=PKCS12","+              SOLR_SSL_CLIENT_TRUST_STORE_PASSWORD=%s","+              SOLR_SSL_NEED_CLIENT_AUTH=false","+              SOLR_SSL_WANT_CLIENT_AUTH=false","+              SOLR_SSL_CHECK_PEER_NAME=true","+              \"\"\",","+              secureExampleShellQuote(tls.resolve(\"solr-ssl.keystore.p12\").toString()),","+              secureExampleShellQuote(password),","+              secureExampleShellQuote(tls.resolve(\"solr-ssl.truststore.p12\").toString()),","+              secureExampleShellQuote(password),","+              secureExampleShellQuote(tls.resolve(\"solr-ssl.truststore.p12\").toString()),","+              secureExampleShellQuote(password)),","+          StandardOpenOption.APPEND);","+      for (String file : List.of(\"solr-ssl.keystore.p12\", \"solr-ssl.truststore.p12\")) {","+        Files.setPosixFilePermissions(","+            tls.resolve(file), PosixFilePermissions.fromString(\"rw-------\"));","+      }","+","+      echo(\"\\n\");","+      echo(\"3. Restart both nodes with HTTPS and verify the certificate.\");","+      startSecureNodes(params, home, environment, zkHost);","+      for (int nodePort : List.of(port, port + 1)) {","+        waitForSecureExample(","+            environment,","+            tls,","+            \"admin:\" + password,","+            \"https://localhost:\" + nodePort + \"/api/node/health\");","+      }","+      echo(\"\\n\");","+      echo(\"\\n\");","+      echo(","+          \"4. Enable Basic Authentication and configure administrator, indexing, and search accounts.\");","+      runSecureCommand(","+          environment,","+          script,","+          \"auth\",","+          \"enable\",","+          \"--type\",","+          \"basicAuth\",","+          \"--credentials\",","+          \"admin:\" + password,","+          \"--block-unknown\",","+          \"true\",","+          \"-z\",","+          zkHost);","+      waitForSecureExample(","+          environment, tls, \"admin:\" + password, \"https://localhost:\" + port + \"/api/node/health\");","+      secureExampleRequest(","+          environment,","+          tls,","+          port,","+          password,","+          \"/api/cluster/security/authentication\",","+          String.format(","+              Locale.ROOT,","+              \"\"\"","+              {","+                \"set-user\": {","+                  \"index\": \"%s\",","+                  \"search\": \"%s\"","+                }","+              }","+              \"\"\",","+              password,","+              password));","+      secureExampleRequest(","+          environment,","+          tls,","+          port,","+          password,","+          \"/api/cluster/security/authorization\",","+          \"\"\"","+          {","+            \"update-permission\": {\"index\": 9, \"role\": [\"admin\", \"search\"]},","+            \"set-user-role\": {","+              \"admin\": [\"superadmin\", \"admin\"],","+              \"index\": [\"index\", \"search\"],","+              \"search\": [\"search\"]","+            }","+          }","+          \"\"\");","+","+      echo(\"\\n\");","+      echo(\"\\n\");","+      echo(","+          \"5. Configure ZooKeeper digest accounts and migrate existing znodes to restricted ACLs.\");","+      Path credentials = tls.resolve(\"zk-credentials.properties\");","+      writeSecureExampleFile(","+          credentials,","+          String.format(","+              Locale.ROOT,","+              \"\"\"","+              zkDigestUsername=zk-admin","+              zkDigestPassword=%s","+              zkDigestReadonlyUsername=zk-readonly","+              zkDigestReadonlyPassword=%s","+              \"\"\",","+              password,","+              password));","+      String zkOptions =","+          \"-DzkCredentialsInjector=org.apache.solr.common.cloud.VMParamsZkCredentialsInjector \"","+              + \"-DzkCredentialsProvider=org.apache.solr.common.cloud.DigestZkCredentialsProvider \"","+              + \"-DzkACLProvider=org.apache.solr.common.cloud.DigestZkACLProvider \";","+      String zkSettings =","+          String.format(","+              Locale.ROOT,","+              \"\"\"","+","+              SOLR_ZK_CREDS_AND_ACLS=%s","+              SOLR_OPTS=\"$SOLR_OPTS $SOLR_ZK_CREDS_AND_ACLS\"","+              \"\"\",","+              secureExampleShellQuote(zkOptions + \"-DzkDigestCredentialsFile=\" + credentials));","+      Files.writeString(include, zkSettings, StandardOpenOption.APPEND);","+      echo(\"Added ZooKeeper settings to \" + secureExampleDisplayArgument(include.toString()) + \":\");","+      echo(zkSettings.strip());","+      stopSecureNodes(port, environment);","+      startSecureNodes(params, home, environment, zkHost);","+      for (int nodePort : List.of(port, port + 1)) {","+        waitForSecureExample(","+            environment,","+            tls,","+            \"admin:\" + password,","+            \"https://localhost:\" + nodePort + \"/api/node/health\");","+      }","+      runSecureCommand(environment, script, \"zk\", \"updateacls\", \"/\", \"-z\", zkHost);","+      Map<String, String> adminEnvironment = new HashMap<>(environment);","+      adminEnvironment.put(\"SOLR_INCLUDE\", \"/dev/null\");","+      adminEnvironment.put(","+          \"SOLR_ZK_CREDS_AND_ACLS\",","+          zkOptions + \"-DzkDigestUsername=zk-admin -DzkDigestPassword=\" + password);","+      runSecureCommand(","+          adminEnvironment, script, \"zk\", \"updateacls\", \"/security.json\", \"-z\", zkHost);","+","+      echo(\"\\n\");","+      echo(\"6. Create one shard per node and index the techproducts documents over HTTPS.\");","+      runSecureCommand(","+          environment,","+          script,","+          \"create\",","+          \"-c\",","+          \"techproducts\",","+          \"--shards\",","+          \"2\",","+          \"--replication-factor\",","+          \"1\",","+          \"--conf-dir\",","+          serverDir","+              .resolve(\"solr/configsets/sample_techproducts_configs/conf\")","+              .toAbsolutePath()","+              .toString(),","+          \"--solr-url\",","+          \"https://localhost:\" + port,","+          \"--credentials\",","+          \"admin:\" + password);","+      runSecureCommand(","+          environment,","+          script,","+          \"post\",","+          \"-c\",","+          \"techproducts\",","+          \"--credentials\",","+          \"index:\" + password,","+          \"--solr-url\",","+          \"https://localhost:\" + port,","+          exampleDir.resolve(\"exampledocs/*.xml\").toAbsolutePath().toString());","+      ready = true;","+    } finally {","+      if (!ready) {","+        echo(","+            \"Setup failed. See \"","+                + home","+                + \"/node{1,2}/logs/solr.log. Run the secure example again to reset it and retry.\");","+        for (int nodePort : List.of(port + 1, port)) {","+          try {","+            runSecureCommand(environment, script, \"stop\", \"-p\", Integer.toString(nodePort));","+          } catch (Exception ignored) {","+            // Preserve the setup failure if cleanup also fails.","+          }","+        }","+      }","+    }","+    for (int nodePort : List.of(port, port + 1)) {","+      waitForSecureExample(","+          environment,","+          tls,","+          \"search:\" + password,","+          \"https://localhost:\"","+              + nodePort","+              + \"/api/collections/techproducts/select?q=*:*&rows=0&shards.tolerant=false\");","+    }","+    echo(\"\\n\\n\");","+    echo(","+        \"Two-node secure example is ready: https://localhost:\"","+            + port","+            + \"/solr/ and https://localhost:\"","+            + (port + 1)","+            + \"/solr/\");","+    echo(","+        \"HTTP accounts: admin (administration), index (indexing/search), search (search only).\"","+            + \" Password: \"","+            + password","+            + \".\");","+    echo(","+        \"ZooKeeper accounts: zk-admin (all), zk-readonly (metadata read only). Password: \"","+            + password","+            + \".\");","+    echo(\"Configuration: \" + secureExampleDisplayArgument(include.toString()));","+    echo(","+        \"Check status: SOLR_INCLUDE='\"","+            + secureExampleDisplayArgument(include.toString())","+            + \"' ./bin/solr status\");","+    echo(\"\\n\");","+    echo(","+        \"Stop nodes: SOLR_INCLUDE='\"","+            + secureExampleDisplayArgument(include.toString())","+            + \"' ./bin/solr stop --all \");","+    echo(\"\\n\");","+    echo(","+        \"See the Securing Solr tutorial for the individual commands and inter-node trust exercise.\");","+  }","+","+  private void resetSecureExampleHome(Path home, Map<String, String> environment)","+      throws IOException {","+    echo(\"Resetting the secure example in \" + secureExampleDisplayArgument(home.toString()));","+    Map<String, String> stopEnvironment = new HashMap<>(environment);","+    stopEnvironment.put(\"SOLR_INCLUDE\", \"/dev/null\");","+    runSecureCommand(stopEnvironment, script, \"stop\", \"--all\");","+    PathUtils.deleteDirectory(home);","+    Files.createDirectories(home);","+  }","+","+  private void startSecureNodes(","+      CloudExampleParams params, Path home, Map<String, String> environment, String zkHost)","+      throws IOException {","+    for (int node = 1; node <= 2; node++) {","+      Map<String, String> nodeEnvironment = new HashMap<>(environment);","+      nodeEnvironment.put(\"SOLR_LOGS_DIR\", home.resolve(\"node\" + node + \"/logs\").toString());","+      List<String> command =","+          new ArrayList