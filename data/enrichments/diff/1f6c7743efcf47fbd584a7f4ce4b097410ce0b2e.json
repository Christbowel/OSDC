ush(['getClient', sessionId, token === cancellation.token]);","+\t\t\t\tawait options.acquire?.();","+\t\t\t\treturn {","+\t\t\t\t\tgists: {","+\t\t\t\t\t\tget: async gistId => { calls.push(['get', gistId]); return options.read ? options.read() : gist([file('{}')]); },","+\t\t\t\t\t\tcreate: async (request, token) => { calls.push(['create', request, token === cancellation.token]); return options.create ? options.create() : gist([file('{}')]); },","+\t\t\t\t\t},","+\t\t\t\t\tdispose: () => calls.push(['dispose']),","+\t\t\t\t};","+\t\t\t},","+\t\t\tgetAnonymousClient: async token => {","+\t\t\t\tcalls.push(['getAnonymousClient', token === cancellation.token]);","+\t\t\t\tawait options.acquire?.();","+\t\t\t\treturn {","+\t\t\t\t\tgists: { get: async (gistId, token) => { calls.push(['get', gistId, token === cancellation.token]); return options.read ? options.read() : gist([file('{}')]); } },","+\t\t\t\t\tdispose: () => calls.push(['dispose']),","+\t\t\t\t};","+\t\t\t},","+\t\t};","+\t\tconst authentication: AuthenticationApi = {","+\t\t\tgetSession: (async (providerId: string, scopes: readonly string[], sessionOptions: vscode.AuthenticationGetSessionOptions) => {","+\t\t\t\tcalls.push(['getSession', providerId, scopes, sessionOptions]);","+\t\t\t\treturn { id: 'chosen-session', accessToken: 'secret-token', account: { id: 'account', label: 'octocat' }, scopes };","+\t\t\t}) as AuthenticationApi['getSession'],","+\t\t\t};","+\t\t\treturn { handler: new GitHubGistProfileContentHandler(github, authentication), calls, token: cancellation.token, cancellation };","+\t}","+","+\ttest('saves a secret gist with the session chosen by the extension', async () => {","+\t\tconst { handler, calls, token, cancellation } = setup();","+\t\tconst result = await handler.saveProfile('My Profile', '{\"settings\":{}}', token);","+\t\tcancellation.dispose();","+\t\tassert.deepStrictEqual({ result: result && { id: result.id, link: result.link.toString() }, calls }, {","+\t\t\tresult: { id: 'gist-id', link: 'https://gist.github.com/gist-id' },","+\t\t\tcalls: [","+\t\t\t\t['getSession', 'github', ['gist', 'user:email'], { createIfNone: true }],","+\t\t\t\t['getClient', 'chosen-session', true],","+\t\t\t\t['create', { public: false, files: { 'My Profile': { content: '{\"settings\":{}}' } } }, true],","+\t\t\t\t['dispose'],","+\t\t\t],","+\t\t});","+\t});","+","+\ttest('reports save failures and still releases the client', async () => {","+\t\tconst failure = new vscode.GitHubError('The selected GitHub session is not available to this extension.', 'authentication');","+\t\tconst { handler, calls, token, cancellation } = setup({ create: () => Promise.reject(failure) });","+\t\tawait assert.rejects(handler.saveProfile('profile', '{}', token), error => error === failure);","+\t\tcancellation.dispose();","+\t\tassert.deepStrictEqual(calls.map(call => call[0]), ['getSession', 'getClient', 'create', 'dispose']);","+\t});","+","+\ttest('reads the first gist file anonymously by id or URI', async () => {","+\t\tconst { handler, calls, token, cancellation } = setup({ read: async () => gist([file('first'), file('second')]) });","+\t\tconst byId = await handler.readProfile('gist-id', token);","+\t\tconst byUri = await handler.readProfile(vscode.Uri.parse('https://gist.github.com/octocat/uri-id'), token);","+\t\tcancellation.dispose();","+\t\tassert.deepStrictEqual({ byId, byUri, calls }, {","+\t\t\tbyId: 'first',","+\t\t\tbyUri: 'first',","+\t\t\tcalls: [","+\t\t\t\t['getAnonymousClient', true], ['get', 'gist-id', true], ['dispose'],","+\t\t\t\t['getAnonymousClient', true], ['get', 'uri-id', true], ['dispose'],","+\t\t\t],","+\t\t});","+\t});","+","+\ttest('returns null for unreadable gists and failures', async () => {","+\t\tconst results: (string | null)[] = [];","+\t\tfor (const read of [","+\t\t\tasync () => gist([]),","+\t\t\tasync () => gist([file('{\"partial', { truncated: true })]),","+\t\t\tasync () => gist([file('e30=', { isBinary: true })]),","+\t\t\tasync () => { throw new vscode.GitHubError('Not Found', 'notFound', 404); },","+\t\t]) {","+\t\t\tconst { handler, cancellation } = setup({ read });","+\t\t\tresults.push(await handler.readProfile('gist-id'));","+\t\t\tcancellation.dispose();","+\t\t}","+\t\tconst { handler, calls, cancellation } = setup({ acquire: () => Promise.reject(new vscode.GitHubError('Busy', 'rateLimit')) });","+\t\tresults.push(await handler.readProfile('gist-id'));","+\t\tcancellation.dispose();","+\t\tassert.deepStrictEqual({ results, calls }, { results: [null, null, null, null, null], calls: [['getAnonymousClient', false]] });","+\t});","+","+\ttest('a pre-cancelled read rejects without acquiring a client or requesting a gist', async () => {","+\t\tconst { handler, calls, token, cancellation } = setup();","+\t\tcancellation.cancel();","+\t\tawait assert.rejects(handler.readProfile('gist-id', token), error => error instanceof vscode.CancellationError);","+\t\tcancellation.dispose();","+\t\tassert.deepStrictEqual(calls, []);","+\t});","+","+\ttest('a read cancelled during the request rejects and still releases the client', async () => {","+\t\tconst { handler, calls, token, cancellation } = setup({ read: async () => { throw new vscode.CancellationError(); } });","+\t\tawait assert.rejects(handler.readProfile('gist-id', token), error => error instanceof vscode.CancellationError);","+\t\tcancellation.dispose();","+\t\tassert.deepStrictEqual(calls, [['getAnonymousClient', true], ['get', 'gist-id', true], ['dispose']]);","+\t});","+});"],"additions":127,"deletions":0,"truncated":false},{"path":"extensions/configuration-editing/src/typings/ref.d.ts","lines":["@@ -1,6 +0,0 @@","-/*---------------------------------------------------------------------------------------------","- *  Copyright (c) Microsoft Corporation. All rights reserved.","- *  Licensed under the MIT License. See License.txt in the project root for license information.","- *--------------------------------------------------------------------------------------------*/","-","-declare module 'tunnel';"],"additions":0,"deletions":6,"truncated":false},{"path":"extensions/configuration-editing/tsconfig.json","lines":["@@ -14,5 +14,6 @@"," \t\t\"src/**/*\","," \t\t\"../../src/vscode-dts/vscode.d.ts\","," \t\t\"../../src/vscode-dts/vscode.proposed.profileContentHandlers.d.ts\",","+\t\t\"../../src/vscode-dts/vscode.proposed.github.d.ts\","," \t]"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"src/vs/platform/extensions/common/extensionsApiProposals.ts","lines":["@@ -303,6 +303,9 @@ const _allApiProposals = {"," \tfsChunks: {"," \t\tproposal: 'https://raw.githubusercontent.com/microsoft/vscode/main/src/vscode-dts/vscode.proposed.fsChunks.d.ts',"," \t},","+\tgithub: {","+\t\tproposal: 'https://raw.githubusercontent.com/microsoft/vscode/main/src/vscode-dts/vscode.proposed.github.d.ts',","+\t},"," \tinlineCompletionsAdditions: {"," \t\tproposal: 'https://raw.githubusercontent.com/microsoft/vscode/main/src/vscode-dts/vscode.proposed.inlineCompletionsAdditions.d.ts',"," \t},"],"additions":3,"deletions":0,"truncated":false},{"path":"src/vs/platform/github/README.md","lines":["@@ -5,461 +5,159 @@ Licensed under the MIT License. See License.txt in the project root for license"," "," # GitHub service"," ","-Reusable GitHub engine and cross-target architecture.","+The GitHub service provides typed clients backed by shared request scheduling, rate-limit handling, credentials, caching, and cancellation. New integrations should use these clients instead of constructing their own HTTP or Octokit stack."," ","-> **Status:** Draft consolidation design. The target architecture below is not yet implemented.","+Consolidation is incremental. Some workbench, extension, and SDK callers still use separate networking; this service does not intercept all GitHub traffic. Git transport, GitHub MCP tool traffic, and build tooling are outside its scope."," ","-## Current implementation","+## Runtime ownership"," ","-[GitHubService](common/githubService.ts) owns shared admission, cooldowns and telemetry. Its legacy `IGitHubClient` combines credentials, capabilities, transport, queries, mutations, and PR subscriptions. Mission Control domains are exposed only by the portable [account facade](common/account/accountClient.ts) over execution-provider leases.","+Portable clients share contracts and execution policies, but engine state belongs to the process hosting it."," ","-- The [workbench binding](../../workbench/services/github/browser/githubService.ts) selects the default account or an explicit session in the renderer. Legacy consumers retain their in-process clients. Portable default-account clients execute locally on web and through the [desktop IPC binding](../../workbench/services/github/electron-browser/githubService.ts) on desktop.","-- The [Agent Host binding](../agentHost/node/agentHostGitHubService.ts) selects its host-owned repository credential resource without an attached workbench. Repository/PR association, creation, merge settings, auto-merge and issue/PR title context use its explicit clients. Copilot discovery and model requests still use the existing [Agent Host Copilot service](../agentHost/node/shared/copilotApiService.ts); migrating them is a separate change.","-- The [shared-process binding](electron-utility/githubService.ts) hosts an additional engine with direct Node networking. Its [typed service boundary](common/remote/ipc.ts) supports directly disposable anonymous and explicitly authorized account clients with REST, buffered GraphQL, pinned public raw-content, Mission Control, and Copilot Connectors execution. Account credentials come from the acquiring renderer's callback channel. Sessions GitHub, Cloud Automations, Copilot Connectors, Issue Reporter anonymous search, and slow-extension issue search use this binding on desktop; other feature consumers retain their existing bindings.","-- The [Sessions service](../../sessions/contrib/github/browser/githubService.ts) retains its observable models and polling while its fetchers use the portable account API. Extension clients still own independent requests and polling.","-","-These instances do not currently share application-wide request state.","-","-The [client inventory](client-inventory.md) maps runtime callers, migration boundaries, and remaining gaps.","-","-### Code organization","-","-The GitHub engine uses shared [types](common/types.ts), [queue](common/requestQueue.ts), [scheduler](common/scheduler.ts), [backoff](common/backoff.ts), [cooldown state](common/cooldownState.ts), [response readers](common/responseReader.ts) and [operation waiters](common/operationWaiters.ts) with neutral names. These mechanisms do not interpret service-specific payloads. GitHub header/GraphQL policy stays in [GitHubRateLimitCoordinator](common/githubRateLimitCoordinator.ts)."],"additions":4,"deletions":16,"truncated":false}],"additions":194,"deletions":324,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-10-24T12:58:41.471354+00:00"}