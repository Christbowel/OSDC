= await client.gists.create({","+\t\t\t\tpublic: false,","+\t\t\t\tfiles: { [name]: { content } }","+\t\t\t}, token);","+\t\t\tif (gist.id && gist.htmlUrl) {","+\t\t\t\treturn { id: gist.id, link: gist.htmlUrl };"," \t\t\t}","-\t\t});","-\t\tif (result.data.id && result.data.html_url) {","-\t\t\tconst link = vscode.Uri.parse(result.data.html_url);","-\t\t\treturn { id: result.data.id, link };","+\t\t\treturn null;","+\t\t} finally {","+\t\t\tclient.dispose();"," \t\t}","-\t\treturn null;"," \t}"," ","-\tprivate _public_octokit: Promise<Octokit> | undefined;","-\tprivate getPublicOctokit(): Promise<Octokit> {","-\t\tif (!this._public_octokit) {","-\t\t\tthis._public_octokit = (async () => {","-\t\t\t\tconst { Octokit } = await import('@octokit/rest');","-\t\t\t\treturn new Octokit({ request: { agent }, userAgent: 'GitHub VSCode' });","-\t\t\t})();","-\t\t}","-\t\treturn this._public_octokit;","-\t}","-","-\tasync readProfile(id: string): Promise<string | null>;","-\tasync readProfile(uri: vscode.Uri): Promise<string | null>;","-\tasync readProfile(arg: string | vscode.Uri): Promise<string | null> {","-\t\tconst gist_id = typeof arg === 'string' ? arg : basename(arg.path);","-\t\tconst octokit = await this.getPublicOctokit();","+\tasync readProfile(idOrUri: string | vscode.Uri, token?: vscode.CancellationToken): Promise<string | null> {","+\t\tthis.throwIfCancelled(token);","+\t\tconst gistId = typeof idOrUri === 'string' ? idOrUri : basename(idOrUri.path);","+\t\tlet client: vscode.GitHubAnonymousClient | undefined;"," \t\ttry {","-\t\t\tconst gist = await octokit.gists.get({ gist_id });","-\t\t\tif (gist.data.files) {","-\t\t\t\treturn gist.data.files[Object.keys(gist.data.files)[0]]?.content ?? null;","+\t\t\tclient = await this.github.getAnonymousClient(token);","+\t\t\tthis.throwIfCancelled(token);","+\t\t\tconst gist = await client.gists.get(gistId, token);","+\t\t\tconst file = gist.files[0];","+\t\t\t// Truncated or binary inline content is not a usable profile.","+\t\t\tif (!file || file.truncated || file.isBinary) {","+\t\t\t\treturn null;"," \t\t\t}","+\t\t\treturn file.content;"," \t\t} catch (error) {","-\t\t\t// ignore","+\t\t\tif (error instanceof vscode.CancellationError) {","+\t\t\t\tthrow error;","+\t\t\t}","+\t\t\t// Other failures mean the gist cannot be read as a profile.","+\t\t} finally {","+\t\t\tclient?.dispose();"," \t\t}"," \t\treturn null;"," \t}"," ","+\tprivate throwIfCancelled(token: vscode.CancellationToken | undefined): void {","+\t\tif (token?.isCancellationRequested) {","+\t\t\tthrow new vscode.CancellationError();","+\t\t}","+\t}","+"," }"," ","-vscode.window.registerProfileContentHandler('github', new GitHubGistProfileContentHandler());","+export function registerGitHubGistProfileContentHandler(): vscode.Disposable {","+\treturn vscode.window.registerProfileContentHandler('github', new GitHubGistProfileContentHandler());","+}"],"additions":51,"deletions":55,"truncated":false},{"path":"extensions/configuration-editing/src/node/net.ts","lines":["@@ -1,29 +0,0 @@","-/*---------------------------------------------------------------------------------------------","- *  Copyright (c) Microsoft Corporation. All rights reserved.","- *  Licensed under the MIT License. See License.txt in the project root for license information.","- *--------------------------------------------------------------------------------------------*/","-","-import { Agent, globalAgent } from 'https';","-import { URL } from 'url';","-import { httpsOverHttp } from 'tunnel';","-import { window } from 'vscode';","-","-export const agent = getAgent();","-","-/**","- * Return an https agent for the given proxy URL, or return the","- * global https agent if the URL was empty or invalid.","- */","-function getAgent(url: string | undefined = process.env.HTTPS_PROXY): Agent {","-\tif (!url) {","-\t\treturn globalAgent;","-\t}","-\ttry {","-\t\tconst { hostname, port, username, password } = new URL(url);","-\t\tconst auth = username && 