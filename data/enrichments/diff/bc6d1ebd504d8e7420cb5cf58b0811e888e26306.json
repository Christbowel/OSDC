okahead sets reject matchers that cannot continue with the second token\", \"[api][grammar_extension]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto grammar = CompiledGrammar::Get(*con.context);","+\tauto &helper = grammar->GetKeywordHelper();","+\tauto &table = helper.GetLiteralTable();","+","+\t// keyword matchers created by the factory are matched by literal id","+\tauto keyword_grammar = ParsedGrammar::Parse(\"Program <- '.' ','\");","+\tauto keyword_rules = CompileTestProgramRule(keyword_grammar);","+\tMatcherAllocator matcher_allocator;","+\tMatcherFactory factory(matcher_allocator, keyword_grammar, keyword_rules, helper, {});","+\tauto &keywords = factory.CreateRootMatcher(\"Program\").Cast<ListMatcher>().matchers;","+\tauto &dot = keywords[0].get();","+\tauto &comma = keywords[1].get();","+\tIdentifierMatcher identifier(SuggestionState::SUGGEST_COLUMN_NAME, helper);","+\tNumberLiteralMatcher number;","+\tStringLiteralMatcher string_literal;","+\tFirstOnlyKeywordTestMatcher first_only(\"SELECT\", table);","+\t// IDENTIFIER '.'","+\tListMatcher qualified({identifier, dot});","+\t// IDENTIFIER '.' / IDENTIFIER","+\tChoiceMatcher name({qualified, identifier});","+\t// NUMBER? IDENTIFIER '.'","+\tOptionalMatcher optional_number(number);","+\tListMatcher optional_prefix({optional_number, qualified});","+\t// IDENTIFIER ','*","+\tRepeatMatcher commas(comma);","+\tOptionalMatcher optional_commas(commas);","+\tListMatcher trailing({identifier, optional_commas});","+\t// 'SELECT' NUMBER with a first-only leading matcher","+\tListMatcher first_only_list({first_only, number});","+\tChoiceMatcher root({name, optional_prefix, trailing, first_only_list, string_literal});","+\tfor (auto matcher : vector<reference<Matcher>> {qualified, name, optional_number, optional_prefix, commas,","+\t                                                optional_commas, trailing, first_only_list, root}) {","+\t\tmatcher.get().SetStructural();","+\t}","+\tComputeFirstSets(root, table);","+","+\tSECTION(\"Sequences need their second token\") {","+\t\tCheckFirstSet(*grammar, qualified, \"foo . bar\", true);","+\t\tCheckFirstSet(*grammar, qualified, \"foo , bar\", false);","+\t\tCheckFirstSet(*grammar, qualified, \"foo\", false);","+\t\tCheckFirstSet(*grammar, qualified, \"42 . bar\", false);","+\t}","+\tSECTION(\"One-token alternatives accept any second token\") {","+\t\tCheckFirstSet(*grammar, name, \"foo , bar\", true);","+\t\tCheckFirstSet(*grammar, name, \"foo\", true);","+\t\tCheckFirstSet(*grammar, trailing, \"foo , ,\", true);","+\t\tCheckFirstSet(*grammar, trailing, \"foo 42\", true);","+\t\tCheckFirstSet(*grammar, string_literal, \"'a' 'b'\", true);","+\t\tCheckFirstSet(*grammar, string_literal, \"'a' 42\", true);","+\t}","+\tSECTION(\"Nullable prefixes shift the second token\") {","+\t\tCheckFirstSet(*grammar, optional_prefix, \"42 foo . bar\", true);","+\t\tCheckFirstSet(*grammar, optional_prefix, \"42 foo , bar\", true);","+\t\tCheckFirstSet(*grammar, optional_prefix, \"foo . bar\", true);","+\t\tCheckFirstSet(*grammar, optional_prefix, \"foo , bar\", false);","+\t\tCheckFirstSet(*grammar, optional_prefix, \"42 , bar\", false);","+\t}","+\tSECTION(\"Matchers that only describe FIRST may consume any number of tokens\") {","+\t\tREQUIRE(first_only.first_set.one.any);","+\t\tREQUIRE(first_only.first_set.second.any);","+\t\tCheckFirstSet(*grammar, first_only_list, \"select\", true);","+\t\tCheckFirstSet(*grammar, first_only_list, \"select foo\", true);","+\t\tCheckFirstSet(*grammar, first_only_list, \"foo\", false);","+\t}","+\tSECTION(\"The autocomplete cursor can stand for any second token\") {","+\t\tvector<MatcherToken> tokens {MatcherToken(\"foo\", 0, TokenType::IDENTIFIER),","+\t\t                             MatcherToken(\"\", 3, TokenType::END_OF_INPUT_AUTOCOMPLETE)};","+\t\tTokenIterator iterator(tokens);","+\t\tvector<MatcherSuggestion> suggestions;","+\t\tParseResultAllocator allocator;","+\t\tidx_t max_token_index = 0;"