","+    if (unexpected) this.failure(\"FAIL\", test, result);","+    this.progress();","+  }","+","+  onStdOut(chunk: string | Buffer) {","+    if (!this.quiet) process.stdout.write(chunk);","+  }","+","+  onStdErr(chunk: string | Buffer) {","+    if (!this.quiet) process.stderr.write(chunk);","+  }","+","+  onError(error: TestError) {","+    console.log(\"ERROR\");","+    this.error(error);","+  }","+","+  onEnd(result: FullResult) {","+    let counts = {","+      passed: 0,","+      skipped: 0,","+      flaky: 0,","+      failed: 0,","+      interrupted: 0,","+      \"not run\": 0,","+    };","+    // Reconcile at the end: maxFailures or interruption may prevent retries","+    // that were still available when onTestEnd ran.","+    for (let test of this.tests) {","+      let last = test.results.at(-1);","+      // On global timeout, active results can still have their initial skipped","+      // status: the runner may call onEnd before their onTestEnd callback.","+      if (this.running.has(test) || last?.status === \"interrupted\") {","+        counts.interrupted++;","+      } else if (!last) {","+        counts[\"not run\"]++;","+      } else {","+        if (test.outcome() === \"unexpected\" && !this.completed.has(test)) {","+          this.failure(\"FAIL\", test, last);","+        }","+        this.completed.add(test);","+        let outcome = test.outcome();","+        if (outcome === \"expected\") counts.passed++;","+        else if (outcome === \"unexpected\") counts.failed++;","+        else counts[outcome]++;","+        if (outcome === \"flaky\") {","+          for (let attempt of test.results) {","+            if (","+              attempt.status !== test.expectedStatus &&","+              attempt.status !== \"skipped\"","+            ) {","+              this.failure(\"FLAKY\", test, attempt);","+            }","+          }","+        }","+      }","+    }","+    this.running.clear();","+    this.progress(true);","+    console.log(","+      Object.entries(counts)","+        .filter(([name, count]) => count > 0 || name === \"failed\")","+        .map(([name, count]) => `${count} ${name}`)","+        .join(\" · \"),","+    );","+    if (result.status !== \"passed\") console.log(`Run ${result.status}`);","+  }","+","+  private progress(final = false) {","+    let percent = this.tests.length","+      ? Math.floor((this.completed.size / this.tests.length) * 100)","+      : 0;","+    let milestone = Math.floor(percent / 5);","+    // Print 100% with the final summary so it only appears once.","+    if (!final && (milestone <= this.lastMilestone || percent === 100)) return;","+    this.lastMilestone = milestone;","+    let seconds = Math.floor((Date.now() - this.started) / 1000);","+    let elapsed = `${Math.floor(seconds / 60)","+      .toString()","+      .padStart(2, \"0\")}:${(seconds % 60).toString().padStart(2, \"0\")}`;","+    let failed = [...this.completed].filter(","+      (test) => test.outcome() === \"unexpected\",","+    ).length;","+    console.log(","+      `[${elapsed}] ${this.completed.size}/${this.tests.length} complete (${percent}%) | ${failed} failed | ${this.retries} ${this.retries === 1 ? \"retry\" : \"retries\"} | ${this.running.size} running`,","+    );","+  }","+","+  private title(test: TestCase) {","+    let location = test.location;","+    return `${test.titlePath().filter(Boolean).join(\" › \")} (${path.relative(this.rootDir, location.file)}:${location.line}:${location.column})`;","+  }","+","+  private failure(label: string, test: TestCase, result: TestResult) {","+    console.log(`${label} ${this.title(test)} (attempt ${result.retry + 1})`);","+    if (result.status === \"passed\" && test.expectedStatus === \"failed\") {","+      console.log(\"Expected to fail, but passed\");","+    }","+    for (let error of result.errors) this.error(error);","+    for (let attachment of result.attachments) {","+      if (attachment.path)","+        console.log(`${attachment.name}: ${attachment.path}`);","+    }","+  }","+","+  private error(error: TestError) {","+    console.log(error.stack ?? error.message ?? error.value ?? \"Unknown error\");","+    if (error.snippet) console.log(error.snippet);","+  }","+}"],"additions":162,"deletions":0,"truncated":false},{"path":"integration/route-pattern-preload-test.ts","lines":["@@ -3,6 +3,20 @@ import { test, expect } from \"@playwright/test\";"," "," import { createProject } from \"./helpers/vite.js\";"," ","+let originalNodeEnv: string | undefined;","+test.beforeEach(() => {","+  originalNodeEnv = process.env.NODE_ENV;","+});","+test.afterEach(() => {","+  // Vite's in-process build/preview APIs set NODE_ENV to production. Restore it","+  // so later tests in the same worker can start development servers.","+  if (originalNodeEnv === undefined) {","+    delete process.env.NODE_ENV;","+  } else {","+    process.env.NODE_ENV = originalNodeEnv;","+  }","+});","+"," for (let enabled of [false, true]) {","   test(`Data Mode route-pattern preloading (flag: ${enabled})`, async ({","     page,"],"additions":14,"deletions":0,"truncated":false},{"path":"integration/rsc-csrf-action-test.ts","lines":["@@ -10,6 +10,22 @@ import {"," import type { AppFixture, Fixture } from \"./helpers/create-fixture.js\";"," import { implementations, setupRscTest, validateRSCHtml } from \"./rsc/utils.js\";"," ","+const csrfRootRoute = js`","+  import { Outlet } from \"react-router\";","+","+  export function Layout({ children }) {","+    return <html><body>{children}</body></html>;","+  }","+","+  export default function Root() {","+    return <Outlet />;","+  }","+","+  export function ErrorBoundary() {","+    return <p>Action request rejected</p>;","+  }","+`;","+"," const csrfActionRoute = js`","   let actionCalls = 0;"," ","@@ -50,6 +66,7 @@ test.describe(\"RSC CSRF action protection\", () => {","       fixture = await createFixture({","         templateName: \"rsc-vite-framework\",","         files: {","+          \"app/root.tsx\": csrfRootRoute