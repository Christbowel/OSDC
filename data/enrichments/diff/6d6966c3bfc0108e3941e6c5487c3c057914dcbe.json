crates/utopia/compression\", version = \"0.1.0\" }","@@ -46,7 +45,7 @@ ext-php-rs = \"0.16.5\""," aho-corasick = \"1\""," # JetStream for utopia-queue, which shares queues with utopia-php/queue's Broker\\Nats."," async-nats = \"0.53\"","-futures-util = { version = \"0.3\", default-features = false, features = [\"std\", \"async-await-macro\"] }","+futures-util = { version = \"0.3\", default-features = false, features = [\"std\"] }"," argon2 = { version = \"0.5\", features = [\"std\"] }"," # BLAKE2b for php-std's Argon2, which fills lanes on scoped threads (the `argon2` crate, a test"," # reference, fills them one after the other).","@@ -55,10 +54,9 @@ blowfish = { version = \"0.9\", features = [\"bcrypt\"] }"," # C brotli 1.2.1, built from source and linked statically: the library PHP's ext-brotli links."," brotlic-sys = \"0.2.5\""," bytes = \"1\"","-http = \"1\"","-http-body-util = \"0.1\"","-hyper = { version = \"1\", features = [\"server\", \"http1\"] }"," # The Sentry transport (utopia-span): HTTP/1.1 client over rustls with the WebPKI roots.","+http-body-util = \"0.1\"","+hyper = \"1\""," hyper-rustls = { version = \"0.27\", default-features = false, features = [\"http1\", \"ring\", \"tls12\", \"webpki-roots\"] }"," hyper-util = \"0.1\""," cc = \"1\"","@@ -114,16 +112,10 @@ lzma-rust2 = { version = \"0.22\", default-features = false, features = [\"std\", \"e"," # The extension's allocator: musl's, on the Alpine image, is slow. `local_dynamic_tls` is what a"," # library PHP loads with dlopen needs there."," mimalloc = { version = \"0.1.52\", default-features = false, features = [\"local_dynamic_tls\"] }","-pin-project-lite = \"0.2\""," png = \"0.18\"","-proc-macro2 = { version = \"1\", default-features = false, features = [\"span-locations\"] }","-quote = { version = \"1\", default-features = false }"," rustls = { version = \"0.23\", default-features = false, features = [\"ring\", \"std\", \"tls12\"] }","-socket2 = { version = \"0.6\", features = [\"all\"] }","-syn = { version = \"2\", default-features = false, features = [\"full\", \"parsing\", \"printing\"] }"," thiserror = \"2\""," tokio = { version = \"1\", features = [\"time\"] }","-tower-service = \"0.3\""," # libzstd 1.5.7, built from source and linked statically, as PHP's ext-zstd links it. No"," # `zstdmt`: multithreaded compression would start threads in a process that forks."," zstd-safe = { version = \"8\", default-features = false, features = [\"std\"] }"],"additions":3,"deletions":11,"truncated":false},{"path":"crates/utopia/async/.gitignore","lines":["@@ -1,2 +0,0 @@","-/target","-Cargo.lock"],"additions":0,"deletions":2,"truncated":false},{"path":"crates/utopia/async/Cargo.toml","lines":["@@ -1,43 +0,0 @@","-[package]","-name = \"utopia-async\"","-description = \"Promises, timers and parallel work on an async engine behind one adapter (Tokio), with the tasks, sockets, files, processes and signals every crate uses through it.\"","-version.workspace = true","-edition.workspace = true","-rust-version.workspace = true","-license.workspace = true","-repository.workspace = true","-publish.workspace = true","-","-[features]","-default = [\"tokio\"]","-# The Tokio adapter: a work-stealing scheduler, epoll/kqueue I/O, timers, a","-# blocking pool, processes and signals.","-tokio = [\"tokio/rt\", \"tokio/rt-multi-thread\", \"tokio/time\", \"tokio/net\", \"tokio/fs\", \"tokio/process\", \"tokio/signal\", \"tokio/io-std\", \"dep:socket2\"]","-# hyper's runtime traits on the engine: an executor, a timer, an I/O wrapper","-# and a client connector (`utopia_async::hyper`).","-hyper = [\"dep:http\", \"dep:hyper\", \"dep:hyper-util\", \"dep:tower-service\"]","-","-[dependencies]","-futures-util.workspace = true","-pin-project-lite.workspace = true","-thiserror.workspace = true","-# The engine-independent building blocks re-exported by `io` and `sync` (the","-# I/O traits and their combinators, mutexes, semaphores, channels) and the","-# `select!`/`join!` macros: they run on any engine. The `tokio` feature adds","-# the engine itself.","-tokio = { workspace = true, features = [\"sync\", \"io-util\", \"macros\"] }","-utopia-async-macros = { path = \"macros\", version = \"0.1.0\" }","-socket2 = { workspace = true, optional = true }","-http = { workspace = true, optional = true }","-hyper = { workspace = true, optional = true }","-hyper-util = { workspace = true, optional = true, features = [\"client-legacy\"] }","-tower-service = { workspace = true, optional = true }","-","-[dev-dependencies]","-bytes.workspace = true","-http-body-util.workspace = true","-hyper-util = { workspace = true, features = [\"client-legacy\", \"http1\"] }","-tower-service.workspace = true","-","-[package.metadata.utopia]","-category = \"platform\""],"additions":0,"deletions":43,"truncated":false},{"path":"crates/utopia/async/LICENSE","lines":["@@ -1,12 +0,0 @@","-Copyright (c) 2019 Appwrite (https://appwrite.io) and individual contributors.","-All rights reserved.","-","-Redistribution and use in source and binary forms, with or without modification, are permitted provided that the following conditions are met:","-","-    1. Redistributions of source code must retain the above copyright notice, this list of conditions and the following disclaimer.","-","-    2. Redistributions in binary form must reproduce the above copyright notice, this list of conditions and the following disclaimer in the documentation and/or other materials provided with the distribution.","-","-    3. Neither the name Appwrite nor the names of its contributors may be used to endorse or promote products derived from this software without specific prior written permission.","-","-THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \"AS IS\" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.","\\ No newline at end of file"],"additions":0,"deletions":12,"truncated":false},{"path":"crates/utopia/async/README.md","lines":["@@ -1,232 +0,0 @@","-# Utopia Async","-","-> [!IMPORTANT]","-> This repository is a read-only mirror of [`crates/utopia/async`](https://github.com/appwrite/appwrite/tree/main/crates/utopia/async) in [appwrite/appwrite](https://github.com/appwrite/appwrite). Development happens there — please open issues and pull requests against appwrite/appwrite.","-","-[![Discord](https://img.shields.io/discord/564160730845151244?label=discord)](https://discord.gg/GSeTUeA)","-","-Promises, timers and parallel work on an async engine behind one adapter (Tokio), with the tasks, sockets, files, processes and signals every crate uses through it.","-","-This library is maintained by the [Appwrite team](https://appwrite.io).","-","-## Getting started","-","-```toml","-[dependencies]","-utopia-async = { git = \"https://github.com/appwrite/appwrite\" }","-```","-","-Async code waits on many things at once: a database reply, a timer, a socket. This crate gives it three facades, `Promise` to run futures together, `Timer` to run callbacks later or on a schedule, and `Parallel` to spread CPU-bound work over threads, and the engine underneath, which every other crate reaches only through `utopia_async`. The engine is chosen once, by a feature flag. This guide covers the common tasks.","-","-## Run futures together","-","-A Rust future is a promise that has not started: it does nothing until awaited. `Promise::run` runs one to its end, `Promise::spawn` starts one as a task of its own, and `all`, `race`, `any` and `all_settled` combine several.","-","-```rust","-use std::time::Duration;","-","-use utopia_async::Promise;","-","-async fn reply(after: u64, text: &'static str) -> &'static str {","-    Promise::delay(Duration::from_millis(after)).await;","-    text","-}","-","-let (both, first) = Promise::run(async {","-    let user = Promise::spawn(async { \"ada\" });","-    let both = Promise::all([Promise::resolve::<_, String>(1), Promise::resolve(2)]).await;","-    let first = Promise::race([reply(5000, \"slow\"), reply(0, \"fast\")]).await;","-    assert_eq!(user.await.unwrap(), \"ada\");","-    (both, first)","-});","-","-assert_eq!(both, Ok(vec![1, 2]));","-assert_eq!(first, Ok(\"fast\"));","-```","-","-A future that fails returns a `Result`: `Ok` fulfills, `Err` rejects. `Promise::all` stops at the first error, `Promise::all_settled` keeps every outcome, and `Promise::timeout` gives up on a future that takes too long.","-","-```rust","-use std::time::Duration;","-","-use utopia_async::{Error, Promise};","-","-Promise::run(async {","-    let failed = Promise::all([Promise::resolve(1), Promise::reject(\"offline\")]).await;","-    assert_eq!(failed, Err(\"offline\"));","-","-    let outcomes = Promise::all_settled([Promise::resolve(1), Promise::reject(\"offline\")]).await;","-    assert_eq!(outcomes, [Ok(1), Err(\"offline\")]);","-","-    let late = Promise::timeout(Duration::from_millis(5), Promise::delay(Duration::from_secs(5))).await;","-    assert_eq!(late, Err(Error::Timeout(\"Promise timed out after 5ms\".into())));","-});","-```","-","-## Run callbacks later","-","-`Timer::after` runs a callback once after a delay, `Timer::tick` every period until it is cleared. Both run as tasks of the current runtime and return an id to clear them with.","-","-```rust","-use std::sync::Arc;","-use std::sync::atomic::{AtomicUsize, Ordering};","-use std::time::Duration;","-","-use utopia_async::Timer;","-","-utopia_async::run(async {","-    let ticks = Arc::new(AtomicUsize::new(0));","-    let counter = ticks.clone();","-    Timer::tick(Duration::from_millis(2), move |id| {","-        if counter.fetch_add(1, Ordering::SeqCst) + 1 == 3 {","-            Timer::clear(id);","-        }","-    });","-","-    utopia_async::sleep(Duration::from_millis(50)).await;","-    assert_eq!(ticks.load(Ordering::SeqCst), 3);","-});","-```","-","-## Spread work over cores","-","-`Parallel` runs closures on the engine's thread pool, off the workers that run tasks: `run` one, `all` of several, `map` over items in chunks, or a `pool` that caps how many run at once.","-","-```rust","-use utopia_async::Parallel;","-","-utopia_async::run(async {","-    let squares = Parallel::map(1..=8u64, |n, _index| n * n, Some(4)).await;","-    assert_eq!(squares, [1, 4, 9, 16, 25, 36, 49, 64]);","-","-    let sum = Parallel::run(|| (1..=1_000_000u64).sum::<u64>()).await;","-    assert_eq!(sum, 500_000_500_000);","-});","-```","-","-## Spawn tasks and share state","-","-Below the facades is the engine's API, which Swoole gives PHP code natively: `spawn` starts a task, `sleep` and `timeout` wait, and `sync` has the channels, mutexes and semaphores tasks coordinate with. Waiting parks the task, not the thread.","-","-```rust","-use std::sync::Arc;","-","-use utopia_async::sync::{Mutex, mpsc};","-use utopia_async::task::JoinSet;","-","-utopia_async::run(async {","-    let total = Arc::new(Mutex::new(0));","-    let mut workers = JoinSet::new();","-    for n in 1..=10 {","-        let total = total.clone();","-        workers.spawn(async move { *total.lock().await += n });","-    }","-    while workers.join_next().await.is_some() {}","-    assert_eq!(*total.lock().await, 55);","-","-    let (sender, mut receiver) = mpsc::channel(1);","-    utopia_async::spawn(async move { sender.send(\"ping\").await.unwrap() });","-    assert_eq!(receiver.recv().await, Some(\"ping\"));","-});","-```","-","-A server wants every core: build a multi-threaded runtime and drive it with `block_on`.","-","-```rust","-use utopia_async::Builder;","-","-let runtime = Builder::multi_thread().threads(4).stack_size(8 * 1024 * 1024).build()?;","-let sum = runtime.block_on(async {","-    let tasks: Vec<_> = (1..=4).map(|n| utopia_async::spawn(async move { n * n })).collect();","-    let mut sum = 0;","-    for task in tasks {","-        sum += task.await?;","-    }","-    Ok::<_, utopia_async::JoinError>(sum)","-})?;","-","-assert_eq!(sum, 30);","-```","-","-## Talk to the network","-","-`net` has TCP connections and listeners, UDP sockets and name resolution. Streams implement the `io` traits, so `read`, `write_all` and the rest come from `AsyncReadExt` and `AsyncWriteExt`.","-","-```rust","-use utopia_async::io::{AsyncReadExt, AsyncWriteExt};","-use utopia_async::net::{TcpListener, TcpStream};","-","-utopia_async::run(async {","-    let listener = TcpListener::bind(\"127.0.0.1:0\").await?;","-    let addr = listener.local_addr()?;","-    utopia_async::spawn(async move {","-        let (mut socket, _) = listener.accept().await?;","-        let mut name = [0; 5];","-        socket.read_exact(&mut name).await?;","-        socket.write_all(&[b\"hello \", &name[..]].concat()).await","-    });","-","-    let mut client = TcpStream::connect(addr).await?;","-    client.write_all(b\"world\").await?;","-    let mut reply = String::new();","-    client.read_to_string(&mut reply).await?;","-    assert_eq!(reply, \"hello world\");","-    Ok::<(), std::io::Error>(())","-})?;","-```","-","-## Read files and run processes","-","-`fs` reads, writes and lists files on the blocking pool, and `process` runs a program with its pipes awaited.","-","-```rust","-use utopia_async::process::Command;","-","-utopia_async::run(async {","-    let path = std::env::temp_dir().join(format!(\"utopia-async-guide-{}\", std::process::id()));","-    utopia_async::fs::write(&path, b\"delta\\nalpha\\n\").await?;","-    let text = utopia_async::fs::read_to_string(&path).await?;","-    assert_eq!(text.lines().count(), 2);","-","-    let output = Command::new(\"sort\").arg(&path).output().await?;","-    assert_eq!(output.stdout, b\"alpha\\ndelta\\n\");","-    utopia_async::fs::remove_file(&path).await","-})?;","-```","-","-## Test async code","-","-`#[utopia_async::test]` runs an async test on a fresh single-threaded runtime; `threads = N` gives it a multi-threaded one.","-","-```rust","-#[utopia_async::test]","-async fn sleeps() {","-    utopia_async::sleep(std::time::Duration::from_millis(1)).await;","-}","-","-#[utopia_async::test(threads = 2)]","-async fn spawns_in_parallel() {","-    let task = utopia_async::spawn(async { 2 });","-    assert_eq!(task.await.unwrap(), 2);","-}","-```","-","-## Switch the engine","-","-The engine is the `Adapter` of the build, `utopia_async::Engine`: `Tokio` with the default `tokio` feature. An engine is added as a module of `utopia_async::adapter` that implements `Adapter` and its resource traits (`TcpStream`, `File`, `Child`, ...), behind a feature of its name; no crate that uses `utopia_async` changes. PHP picks an adapter per facade when the program runs (`Promise::setAdapter()`); Rust picks the engine when it compiles, so every call goes straight to it.","-","-## Contributing","-","-Development happens in [appwrite/appwrite](https://github.com/appwrite/appwrite), where this crate lives at [`crates/utopia/async`](https://github.com/appwrite/appwrite/tree/main/crates/utopia/async). Run these commands from a checkout of it. The [contributing guide](https://utopia-docs.appwrite.network/contributing) covers each step.","-","-### Test","-","-```bash","-cargo test -p utopia-async","-cargo clippy -p utopia-async --all-targets -- -D warnings","-cargo fmt --all --check","-```","-","-## License","-","-BSD-3-Clause. See [LICENSE](LICENSE)."],"additions":0,"deletions":232,"truncated":false},{"path":"crates/utopia/async/guide.md","lines":["@@ -1,282 +0,0 @@","-Async code waits on many things at once: a database reply, a timer, a socket. This crate gives it three facades, `Promise` to run futures together, `Timer` to run callbacks later or on a schedule, and `Parallel` to spread CPU-bound work over threads, and the engine underneath, which every other crate reaches only through `utopia_async`. The engine is chosen once, by a feature flag. This guide covers the common tasks.","-","-## Run futures together","-","-A Rust future is a promise that has not started: it does nothing until awaited. `Promise::run` runs one to its end, `Promise::spawn` starts one as a task of its own, and `all`, `race`, `any` and `all_settled` combine several.","-","-```","-use std::time::Duration;","-","-use utopia_async::Promise;","-","-async fn reply(after: u64, text: &'static str) -> &'static str {","-    Promise::delay(Duration::from_millis(after)).await;","-    text","-}","-","-let (both, first) = Promise::run(async {","-    let user = Promise::spawn(async { \"ada\" });","-    let both = Promise::all([Promise::resolve::<_, String>(1), Promise::resolve(2)]).await;","-    let first = Promise::race([reply(5000, \"slow\"), reply(0, \"fast\")]).await;","-    assert_eq!(user.await.unwrap(), \"ada\");","-    (both, first)","-});","-","-assert_eq!(both, Ok(vec![1, 2]));","-assert_eq!(first, Ok(\"fast\"));","-```","-","-```php","-use Utopia\\Async\\Promise;","-","-Swoole\\Coroutine\\run(function () {","-    $user = Promise::async(fn () => 'ada');","-    $both = Promise::all([Promise::resolve(1), Promise::resolve(2)])->await();","-    $first = Promise::race([","-        Promise::async(function () { Promise::delay(5000)->await(); return 'slow'; }),","-        Promise::async(fn () => 'fast'),","-    ])->await();","-    echo $user->await(), ' ', json_encode($both), ' ', $first, \"\\n\"; // ada [1,2] fast","-});","-```","-","-A future that fails returns a `Result`: `Ok` fulfills, `Err` rejects. `Promise::all` stops at the first error, `Promise::all_settled` keeps every outcome, and `Promise::timeout` gives up on a future that takes too long.","-","-```","-use std::time::Duration;","-","-use utopia_async::{Error, Promise};","-","-Promise::run(async {","-    let failed = Promise::all([Promise::resolve(1), Promise::reject(\"offline\")]).await;","-    assert_eq!(failed, Err(\"offline\"));","-","-    let outcomes = Promise::all_settled([Promise::resolve(1), Promise::reject(\"offline\")]).await;","-    assert_eq!(outcomes, [Ok(1), Err(\"offline\")]);","-","-    let late = Promise::timeout(Duration::from_millis(5), Promise::delay(Duration::from_secs(5))).await;","-    assert_eq!(late, Err(Error::Timeout(\"Promise timed out after 5ms\".into())));","-});","-```","-","-## Run callbacks later","-","-`Timer::after` runs a callback once after a delay, `Timer::tick` every period until it is cleared. Both run as tasks of the current runtime and return an id to clear them with.","-","-```","-use std::sync::Arc;","-use std::sync::atomic::{AtomicUsize, Ordering};","-use std::time::Duration;","-","-use utopia_async::Timer;","-","-utopia_async::run(async {","-    let ticks = Arc::new(AtomicUsize::new(0));","-    let counter = ticks.clone();","-    Timer::tick(Duration::from_millis(2), move |id| {","-        if counter.fetch_add(1, Ordering::SeqCst) + 1 == 3 {","-            Timer::clear(id);","-        }","-    });","-","-    utopia_async::sleep(Duration::from_millis(50)).await;","-    assert_eq!(ticks.load(Ordering::SeqCst), 3);","-});","-```","-","-```php","-use Utopia\\Async\\Timer;","-","-Swoole\\Coroutine\\run(function () {","-    $ticks = 0;","-    Timer::tick(2, function (int $id) use (&$ticks) {","-        if (++$ticks === 3) {","-            Timer::clear($id);","-        }","-    });","-","-    Swoole\\Coroutine::sleep(0.05);","-    echo $ticks, \"\\n\"; // 3","-});","-```","-","-## Spread work over cores","-","-`Parallel` runs closures on the engine's thread pool, off the workers that run tasks: `run` one, `all` of several, `map` over items in chunks, or a `pool` that caps how many run at once.","-","-```","-use utopia_async::Parallel;","-","-utopia_async::run(async {","-    let squares = Parallel::map(1..=8u64, |n, _index| n * n, Some(4)).await;","-    assert_eq!(squares, [1, 4, 9, 16, 25, 36, 49, 64]);","-","-    let sum = Parallel::run(|| (1..=1_000_000u64).sum::<u64>()).await;","-    assert_eq!(sum, 500_000_500_000);","-});","-```","-","-```php","-use Utopia\\Async\\Parallel;","-","-$squares = Parallel::map(range(1, 8), fn (int $n) => $n * $n, 4);","-echo json_encode($squares), \"\\n\"; // [1,4,9,16,25,36,49,64]","-","-echo Parallel::run(fn () => array_sum(range(1, 1000000))), \"\\n\"; // 500000500000","-```","-","-## Spawn tasks and share state","-","-Below the facades is the engine's API, which Swoole gives PHP code natively: `spawn` starts a task, `sleep` and `timeout` wait, and `sync` has the channels, mutexes and semaphores tasks coordinate with. Waiting parks the task, not the thread.","-","-```","-use std::sync::Arc;","-","-use utopia_async::sync::{Mutex, mpsc};","-use utopia_async::task::JoinSet;","-","-utopia_async::run(async {","-    let total = Arc::new(Mutex::new(0));","-    let mut workers = JoinSet::new();","-    for n in 1..=10 {","-        let total = total.clone();","-        workers.spawn(async move { *total.lock().await += n });","-    }","-    while workers.join_next().await.is_some() {}","-    assert_eq!(*total.lock().await, 55);","-","-    let (sender, mut receiver) = mpsc::channel(1);","-    utopia_async::spawn(async move { sender.send(\"ping\").await.unwrap() });","-    assert_eq!(receiver.recv().await, Some(\"ping\"));","-});","-```","-","-```php","-Swoole\\Coroutine\\run(function () {","-    $total = 0;","-    $workers = new Swoole\\Coroutine\\WaitGroup();","-    foreach (range(1, 10) as $n) {","-        $workers->add();","-        go(function () use (&$total, $n, $workers) {","-            $total += $n;","-            $workers->done();","-        });","-    }","-    $workers->wait();","-","-    $channel = new Swoole\\Coroutine\\Channel(1);","-    go(fn () => $channel->push('ping'));","-    echo $total, ' ', $channel->pop(), \"\\n\"; // 55 ping","-});","-```","-","-A server wants every core: build a multi-threaded runtime and drive it with `block_on`.","-","-```","-use utopia_async::Builder;","-","-let runtime = Builder::multi_thread().threads(4).stack_size(8 * 1024 * 1024).build()?;","-let sum = runtime.block_on(async {","-    let tasks: Vec<_> = (1..=4).map(|n| utopia_async::spawn(async move { n * n })).collect();","-    let mut sum = 0;","-    for task in tasks {","-        sum += task.await?;","-    }","-    Ok::<_, utopia_async::JoinError>(sum)","-})?;","-","-assert_eq!(sum, 30);","-# Ok::<(), Box<dyn std::error::Error>>(())","-```","-","-## Talk to the network","-","-`net` has TCP connections and listeners, UDP sockets and name resolution. Streams implement the `io` traits, so `read`, `write_all` and the rest come from `AsyncReadExt` and `AsyncWriteExt`.","-","-```","-use utopia_async::io::{AsyncReadExt, AsyncWriteExt};","-use utopia_async::net::{TcpListener, TcpStream};","-","-utopia_async::run(async {","-    let listener = TcpListener::bind(\"127.0.0.1:0\").await?;","-    let addr = listener.local_addr()?;","-    utopia_async::spawn(async move {","-        let (mut socket, _) = listener.accept().await?;","-        let mut name = [0; 5];","-        socket.read_exact(&mut name).await?;","-        socket.write_all(&[b\"hello \", &name[..]].concat()).await","-    });","-","-    let mut client = TcpStream::connect(addr).await?;","-    client.write_all(b\"world\").await?;","-    let mut reply = String::new();","-    client.read_to_string(&mut reply).await?;","-    assert_eq!(reply, \"hello world\");","-    Ok::<(), std::io::Error>(())","-})?;","-# Ok::<(), std::io::Error>(())","-```","-","-```php","-use Swoole\\Coroutine\\Client;","-use Swoole\\Coroutine\\Server;","-use Swoole\\Coroutine\\Server\\Connection;","-","-Swoole\\Coroutine\\run(function () {","-    $server = new Server('127.0.0.1', 0);","-    go(function () use ($server) {","-        $server->handle(function (Connection $connection) {","-            $connection->send('hello ' . $connection->recv());","-            $connection->close();","-        });","-        $server->start();","-    });","-","-    $client = new Client(SWOOLE_SOCK_TCP);","-    $client->connect('127.0.0.1', $server->port);","-    $client->send('world');","-    echo $client->recv(), \"\\n\"; // hello world","-    $server->shutdown();","-});","-```","-","-## Read files and run processes","-","-`fs` reads, writes and lists files on the blocking pool, and `process` runs a program with its pipes awaited.","-","-```","-use utopia_async::process::Command;","-","-utopia_async::run(async {","-    let path = std::env::temp_dir().join(format!(\"utopia-async-guide-{}\", std::process::id()));","-    utopia_async::fs::write(&path, b\"delta\\nalpha\\n\").await?;","-    let text = utopia_async::fs::read_to_string(&path).await?;","-    assert_eq!(text.lines().count(), 2);","-","-    let output = Command::new(\"sort\").arg(&path).output().await?;","-    assert_eq!(output.stdout, b\"alpha\\ndelta\\n\");","-    utopia_async::fs::remove_file(&path).await","-})?;","-# Ok::<(), std::io::Error>(())","-```","-","-## Test async code","-","-`#[utopia_async::test]` runs an async test on a fresh single-threaded runtime; `threads = N` gives it a multi-threaded one.","-","-```","-#[utopia_async::test]","-async fn sleeps() {","-    utopia_async::sleep(std::time::Duration::from_millis(1)).await;","-}","-","-#[utopia_async::test(threads = 2)]","-async fn spawns_in_parallel() {","-    let task = utopia_async::spawn(async { 2 });","-    assert_eq!(task.await.unwrap(), 2);","-}","-```","-","-## Switch the engine","-","-The engine is the `Adapter` of the build, `utopia_async::Engine`: `Tokio` with the default `tokio` feature. An engine is added as a module of `utopia_async::adapter` that implements `Adapter` and its resource traits (`TcpStream`, `File`, `Child`, ...), behind a feature of its name; no crate that uses `utopia_async` changes. PHP picks an adapter per facade when the program runs (`Promise::setAdapter()`); Rust picks the engine when it compiles, so every call goes straight to it."],"additions":0,"deletions":282,"truncated":false},{"path":"crates/utopia/async/macros/Cargo.toml","lines":["@@ -1,17 +0,0 @@","-[package]","-name = \"utopia-async-macros\"","-description = \"The #[utopia_async::main] and #[utopia_async::test] attributes: run an async function on a utopia-async runtime.\"","-version.workspace = true","-edition.workspace = true","-rust-version.workspace = true","-license.workspace = true","-repository.workspace = true","-publish.workspace = true","-","-[lib]","-proc-macro = true","-","-[dependencies]","-proc-macro2 = { workspace = true, features = [\"proc-macro\"] }","-quote = { workspace = true, features = [\"proc-macro\"] }","-syn = { workspace = true, features = [\"proc-macro\"] }"],"additions":0,"deletions":17,"truncated":false},{"path":"crates/utopia/async/macros/src/lib.rs","lines":["@@ -1,73 +0,0 @@","-//! The attributes of `utopia-async`: `#[utopia_async::main]` and","-//! `#[utopia_async::test]`. Use them through `utopia_async`, which","-//! re-exports them; the expansions name `::utopia_async`.","-","-use proc_macro::TokenStream;","-use quote::quote;","-use syn::parse::Parser;","-use syn::punctuated::Punctuated;","-use syn::{Expr, ExprLit, ItemFn, Lit, MetaNameValue, Token};","-","-/// Runs an async test function to its end on a new runtime: single-threaded","-/// by default, multi-threaded with `threads = N` workers.","-#[proc_macro_attribute]","-pub fn test(args: TokenStream, item: TokenStream) -> TokenStream {","-    match expand(args.into(), item.into(), true) {","-        Ok(tokens) => tokens.into(),","-        Err(error) => error.to_compile_error().into(),","-    }","-}","-","-/// Runs an async `main` to its end on a new runtime: single-threaded by","-/// default, multi-threaded with `threads = N` workers.","-#[proc_macro_attribute]","-pub fn main(args: TokenStream, item: TokenStream) -> TokenStream {","-    match expand(args.into(), item.into(), false) {","-        Ok(tokens) => tokens.into(),","-        Err(error) => error.to_compile_error().into(),","-    }","-}","-","-fn expand(","-    args: proc_macro2::TokenStream,","-    item: proc_macro2::TokenStream,"],"additions":0,"deletions":33,"truncated":false}],"additions":4,"deletions":690,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-28T17:09:57.771392+00:00"}