 {","+        startProcess(new String[]{\"-config\", getConfig(\"tika-config-server-basic.json\"),","+                \"--preset\", PRESET});","+        assertPresetServesXml();","+    }","+","+    @Test","+    public void testPresetsEnvironmentVariable() throws Exception {","+        startProcess(new String[]{\"-config\", getConfig(\"tika-config-server-basic.json\")},","+                Map.of(TikaServerConfig.PRESETS_ENV, \" \" + PRESET + \", \"));","+        assertPresetServesXml();","+    }","+","+    @Test","+    public void testUnknownPresetFailsStartup() throws Exception {","+        startProcess(new String[]{\"-config\", getConfig(\"tika-config-server-basic.json\"),","+                \"--preset\", \"no-such-preset\"});","+        assertTrue(process.waitFor(MAX_WAIT_MS, TimeUnit.MILLISECONDS), \"server should exit\");","+        assertNotEquals(0, process.exitValue());","+    }","+","+    private void assertPresetServesXml() throws Exception {","+        awaitServerStartup();","+        Response response = WebClient","+                .create(endPoint + RMETA_PATH + \"/preset/\" + PRESET)","+                .accept(\"application/json\")","+                .put(ClassLoader.getSystemResourceAsStream(TEST_HELLO_WORLD));","+        assertEquals(200, response.getStatus());","+        Reader reader = new InputStreamReader((InputStream) response.getEntity(), UTF_8);","+        List<Metadata> metadataList = JsonMetadataList.fromJson(reader);","+        assertEquals(1, metadataList.size());","+        assertContains(\"<body><p>hello world</p>\",","+                metadataList.get(0).get(TikaCoreProperties.TIKA_CONTENT));","+    }","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"tika-server/tika-server-core/src/test/java/org/apache/tika/server/core/TikaServerConfigTest.java","lines":["@@ -18,14 +18,18 @@"," "," import static org.junit.jupiter.api.Assertions.assertEquals;"," import static org.junit.jupiter.api.Assertions.assertFalse;","+import static or