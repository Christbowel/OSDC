re = Injector::inst()->get('DevUrlsConfirmationMiddleware');","+            $this->assertInstanceOf(DevelopmentAdminConfirmationMiddleware::class, $middleware);","+            $request = $this->buildRequestMock($url);","+            $request->method('remaining')->willReturn(substr($url, strlen('dev/')));","+            $this->assertSame($expected, $middleware->hasAccess($request));","+        } finally {","+            $kernel->setEnvironment($env);","+        }","+    }","+","+    public static function provideProcessRedirectsToConfirmation(): array","+    {","+        return [","+            'mount point' => ['dev/tasks'],","+            'nested task' => ['dev/tasks/SomeTask'],","+        ];","+    }","+","+    #[DataProvider('provideProcessRedirectsToConfirmation')]","+    public function testProcessRedirectsToConfirmation(string $url): void","+    {","+        $kernel = Injector::inst()->get(Kernel::class);","+        $env = $kernel->getEnvironment();","+        $kernel->setEnvironment(Kernel::LIVE);","+        DevelopmentAdmin::config()->set('allow_all_cli', false);","+        try {","+            $this->logInWithPermission('BUILDTASK_CAN_RUN');","+            $middleware = Injector::inst()->get('DevUrlsConfirmationMiddleware');","+            $request = $this->buildRequestMock($url);","+            $request->method('remaining')->willReturn(substr($url, strlen('dev/')));","+            $delegateCalled = false;","+            $response = $middleware->process($request, function () use (&$delegateCalled) {","+                $delegateCalled = true;","+                return new HTTPResponse();","+            });","+            $this->assertFalse($delegateCalled);","+            $this->assertInstanceOf(HTTPResponse::class, $response);","+            $this->assertSame(302, $response->getStatusCode());","+            $this->assertStringContainsString('dev/confirm', $response->getHeader('location'));","+        } finally {","+            $kernel->setEnvironment($env);