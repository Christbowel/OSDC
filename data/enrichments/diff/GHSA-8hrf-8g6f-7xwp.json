{"id":"GHSA-8hrf-8g6f-7xwp","axis":"advisories","repo":"digitalbazaar/forge","sha":"700d977d39f9f8f896c55b0763eebb940a2c087e","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -77,6 +77,18 @@ Forge ChangeLog","     - Ziyue Wang, Chenchen, Strick Sheng, Liyi Zhou, and Maurice Ng.","   - CVE ID: [CVE-TBD]()","   - GHSA ID: [GHSA-hqq3-7jhf-c5jx](https://github.com/digitalbazaar/forge/security/advisories/GHSA-hqq3-7jhf-c5jx)","+- **HIGH**: Denial of service in TLS record processing via an interleaved","+  record during a fragmented handshake message.","+  - When a `tls.createConnection()` connection receives a record of another","+    type (alert, change_cipher_spec, application data or heartbeat) while a","+    handshake message is split across records, it reports the error and","+    closes the connection, and then `process()` throws `TypeError: Cannot","+    set properties of null`. A peer can trigger this with two small records","+    before the handshake, without authentication, as a server or a client.","+    In Node.js applications that call `process()` from a socket `data`","+    handler, the exception is uncaught and terminates the process.","+  - CVE ID: [CVE-TBD]()","+  - GHSA ID: [GHSA-8hrf-8g6f-7xwp](https://github.com/digitalbazaar/forge/security/advisories/GHSA-8hrf-8g6f-7xwp)"," - **LOW**: ASN.1 OID first arc truncation.","   - An Integer Overflow (CWE-190) vulnerability in node-forge versions 1.4.0","     and below lets `asn1.oidToDer()` encode an OID string with out of range","@@ -112,6 +124,9 @@ Forge ChangeLog","   `2.999`) in base 128. From PR #1148 by @spokodev."," - [tls] Process received TLS records in a loop instead of recursively, so the","   number of records in one `process()` call no longer affects stack depth.","+- [tls] Stop processing a record that interrupts a fragmented handshake","+  message after failing the connection with an `unexpected_message` alert,","+  instead of throwing a `TypeError`."," "," ## 1.4.0 - 2026-03-24"," "],"additions":15,"deletions":0,"truncated":false},{"path":"lib/tls.js","lines":["@@ -3917,6 +3917,8 @@ tls.createConnection = function(options) {","                   tls.Alert.Description.unexpected_message","               }","             });","+            // fatal error closed and reset the connection (no record)","+            return rval;","           }","         }"," "],"additions":2,"deletions":0,"truncated":false},{"path":"tests/unit/tls.js","lines":["@@ -308,5 +308,92 @@ require('../../lib/util');","         ASSERT.deepEqual(log.errors, ['Handshake failure.']);","       });","     });","+","+    // see GHSA-8hrf-8g6f-7xwp","+    describe('fragmented handshake messages', function() {","+      // TLS 1.0 record","+      function record(type, fragment) {","+        var b = forge.util.createBuffer();","+        b.putByte(type);","+        b.putByte(3);","+        b.putByte(1);","+        b.putInt16(fragment.length);","+        b.putBytes(fragment);","+        return b.getBytes();","+      }","+","+      function createConnection(server, log) {","+        var c = forge.tls.createConnection({","+          server: server,","+          verify: function() {","+            return true;","+          },","+          tlsDataReady: function(c) {","+            log.sent += c.tlsData.getBytes();","+          },","+          dataReady: function(c) {","+            c.data.getBytes();","+          },","+          closed: function() {},","+          error: function(c, error) {","+            log.errors.push(error.message);","+          }","+        });","+        if(!server) {","+          c.handshake();","+          // drop the ClientHello","+          log.sent = '';","+        }","+        return c;","+      }","+","+      // start of a handshake message (ClientHello or ServerHello) announcing","+      // more bytes than the record holds","+      function firstFragment(server) {","+        return record(22, forge.util.hexToBytes(","+          (server ? '01' : '02') + '000010' + '0301'));","+      }","+","+      var interleaved = {","+        change_cipher_spec: record(20, '\\x01'),","+        alert: record(21, forge.util.hexToBytes('0228')),","+        application_data: record(23, 'data'),","+        heartbeat: record(24, forge.util.hexToBytes('010000'))","+      };","+","+      [true, false].forEach(function(server) {","+        var mode = server ? 'server' : 'client';","+        Object.keys(interleaved).forEach(function(name) {","+          it('should fail on ' + name + ' in a fragmented message (' + mode +","+            ')', function() {","+            var log = {sent: '', errors: []};","+            var c = createConnection(server, log);","+            ASSERT.doesNotThrow(function() {","+              c.process(firstFragment(server) + interleaved[name]);","+            });","+            ASSERT.deepEqual(log.errors, ['Invalid fragmented record.']);","+            ASSERT.equal(c.fail, true);","+            // fatal unexpected_message alert","+            var alert = forge.util.createBuffer(log.sent);","+            ASSERT.equal(alert.getByte(), 21);","+            alert.getBytes(4);","+            ASSERT.equal(alert.bytes(), forge.util.hexToBytes('020a'));","+            // further input is ignored","+            ASSERT.equal(c.process(interleaved[name]), 0);","+            ASSERT.deepEqual(log.errors, ['Invalid fragmented record.']);","+          });","+        });","+","+        it('should accept continuation records (' + mode + ')', function() {","+          var log = {sent: '', errors: []};","+          var c = createConnection(server, log);","+          var rval = c.process(firstFragment(server) + record(22, '\\x00'));","+          ASSERT.equal(rval, 0);","+          ASSERT.deepEqual(log.errors, []);","+          ASSERT.equal(c.fail, false);","+          ASSERT.equal(log.sent, '');","+        });","+      });","+    });","   });"," })();",""],"additions":87,"deletions":0,"truncated":false}],"additions":104,"deletions":0,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-31T14:35:22.323884+00:00"}