(&fixture, bundle);","+            assert_eq!(","+                changed,","+                Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap(),","+            );","+            let normalized = normalize_registry_origin(changed, &fixture);","+            if let Some(expected) = &expected {","+                assert_eq!(expected, &normalized);","+            }","+            expected = Some(normalized);","+        }","+    }","+}","+","+fn nested_provider_version(lockfile: &Lockfile) -> String {","+    let consumer = \"consumer\".parse().unwrap();","+    let consumer_key = lockfile.importers[\".\"].dependencies.as_ref().unwrap()[&consumer]","+        .version","+        .resolved_key(&consumer)","+        .unwrap();","+    let snapshots = lockfile.snapshots.as_ref().unwrap();","+    let provider = \"provider\".parse().unwrap();","+    let provider_key = snapshots[&consumer_key].dependencies.as_ref().unwrap()[&provider]","+        .resolve(&provider)","+        .unwrap();","+    snapshots[&provider_key].dependencies.as_ref().unwrap()[&\"nested\".parse().unwrap()].to_string()","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peer_convergence/new_project_pins.rs","lines":["@@ -0,0 +1,99 @@","+use super::moving_providers::{","+    install_lockfile, normalize_registry_origin, registry_from_manifests,","+};","+use crate::_utils::{ManifestDeps, WorkspaceFixture, read_v11_bundle_path};","+use pnpm_lockfile::Lockfile;","+use serde_json::json;","+","+#[test]","+fn new_projects_classify_prior_peer_candidates_from_manifests() {","+    let bundle = read_v11_bundle_path();","+    for (new_project, suffix_length) in","+        [(\"a\", 1), (\"a\", 1000), (\"zz\", 1), (\"zz\", 1000), (\"b\", 1), (\"b\", 1000)]","+    {","+        let mut expected = None;","+        for bundle in bundle","+            .as_deref()","+            .map(Some)","+            .into_iter()","+            .chain([None])","+        {","+            let registry_dir = tempfile::tempdir().unwrap();","+            let mut fixture = WorkspaceFixture::new();","+            fixture.registry.mock_instance = registry_from_manifests(","+                registry_dir.path(),","+                [","+                    json!({\"name\":\"owner\",\"version\":\"1.0.0\",\"dependencies\":{\"provider\":\"1.0.0\"},\"peerDependencies\":{\"provider\":\"*\",\"auxiliary\":\"1.0.0\"},\"peerDependenciesMeta\":{\"provider\":{\"optional\":true}}}),","+                    json!({\"name\":\"consumer\",\"version\":\"1.0.0\",\"peerDependencies\":{\"provider\":\"*\"},\"peerDependenciesMeta\":{\"provider\":{\"optional\":true}}}),","+                    json!({\"name\":\"provider\",\"version\":\"1.0.0\"}),","+                    json!({\"name\":\"provider\",\"version\":\"2.0.0\"}),","+                    json!({\"name\":\"auxiliary\",\"version\":\"1.0.0\"}),","+                ],","+            );","+            fixture.append_workspace_yaml(&format!(\"autoInstallPeers: true\\nresolvePeersFromWorkspaceRoot: false\\ndedupePeers: false\\npeersSuffixMaxLength: {suffix_length}\\nlockfile:\\n  format: v9\\n\"));","+            fixture.write_root_manifest(\"root\", ManifestDeps::default());","+            fixture.project(","+                \"z\",","+                \"existing\",","+                ManifestDeps { prod: &[(\"owner\", \"1.0.0\")], ..Default::default() },","+            );","+            fixture.project(","+                \"versions\",","+                \"versions\",","+                ManifestDeps { prod: &[(\"provider\", \"2.0.0\")], ..Default::default() },","+            );","+            install_lockfile(&fixture, bundle);","+            if new_project == \"b\" {","+                fixture.project(","+                    \"a\",","+                    \"new-owner\",","+                    ManifestDeps {","+                        prod: &[(\"owner\", \"1.0.0\"), (\"provider\", \"2.0.0\")],","+                        ..Default::default()","+                    },","+                );","+            }","+            fixture.project(","+                new_project,","+                \"added\",","+                ManifestDeps { prod: &[(\"consumer\", \"1.0.0\")], ..Default::default() },","+            );","+            install_lockfile(&fixture, bundle);","+            let changed = Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap();","+            assert_eq!(","+                peer_provider_version(&changed, &format!(\"packages/{new_project}\"), \"consumer\"),","+                \"2.0.0\",","+            );","+            install_lockfile(&fixture, bundle);","+            assert_eq!(","+                changed,","+                Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap(),","+            );","+            let normalized = normalize_registry_origin(changed, &fixture);","+            if let Some(expected) = &expected {","+                assert_eq!(expected, &normalized);","+            }","+            expected = Some(normalized);","+        }","+    }","+}","+","+pub(super) fn peer_provider_version(","+    lockfile: &Lockfile,","+    importer: &str,","+    dependent: &str,","+) -> String {","+    let consumer = dependent.parse().unwrap();","+    let consumer_key = lockfile.importers[importer].dependencies.as_ref().unwrap()[&consumer]","+        .version","+        .resolved_key(&consumer)","+        .unwrap();","+    let snapshot = &lockfile.snapshots.as_ref().unwrap()[&consumer_key];","+    let provider = \"provider\".parse().unwrap();","+    [snapshot.dependencies.as_ref(), snapshot.optional_dependencies.as_ref()]","+        .into_iter()","+        .flatten()","+        .find_map(|dependencies| dependencies.get(&provider))","+        .expect(\"consumer binds provider\")","+        .to_string()","+}"],"additions":99,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peer_convergence/patched_retained_pins.rs","lines":["@@ -0,0 +1