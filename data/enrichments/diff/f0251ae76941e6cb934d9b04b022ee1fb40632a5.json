{"id":"f0251ae76941e6cb934d9b04b022ee1fb40632a5","axis":"silent","repo":"payloadcms/payload","sha":"f0251ae76941e6cb934d9b04b022ee1fb40632a5","parsed":{"files":[{"path":".claude-plugin/marketplace.json","lines":["@@ -1,7 +1,7 @@"," {","   \"name\": \"payload-marketplace\",","   \"version\": \"0.0.1\",","-  \"description\": \"Development marketplace for Payload\",","+  \"description\": \"Claude Code plugins for Payload\",","   \"owner\": {","     \"name\": \"Payload\",","     \"email\": \"info@payloadcms.com\"","@@ -9,13 +9,18 @@","   \"plugins\": [","     {","       \"name\": \"payload\",","+      \"source\": \"./packages/payload\",","+      \"strict\": false,","       \"description\": \"Payload Development plugin - covers collections, fields, hooks, access control, plugins, and database adapters.\",","-      \"version\": \"0.0.1\",","-      \"source\": \"./tools/claude-plugin\",","       \"author\": {","         \"name\": \"Payload\",","-        \"email\": \"info@payloadcms.com\"","-      }","+        \"email\": \"info@payloadcms.com\",","+        \"url\": \"https://payloadcms.com\"","+      },","+      \"homepage\": \"https://payloadcms.com\",","+      \"repository\": \"https://github.com/payloadcms/payload\",","+      \"license\": \"MIT\",","+      \"keywords\": [\"payload\", \"cms\", \"payload-cms\", \"nextjs\", \"typescript\", \"headless-cms\"]","     }","   ]"," }"],"additions":10,"deletions":5,"truncated":false},{"path":"docs/getting-started/ai-tooling.mdx","lines":["@@ -0,0 +1,72 @@","+---","+title: AI Tooling","+label: AI Tooling","+order: 40","+desc: Payload ships an agent skill with the payload package so AI coding assistants have accurate, version-matched guidance for your project.","+keywords: documentation, getting started, guide, ai, agent, skill, claude, cursor, codex, Content Management System, cms, headless, javascript, node, react, nextjs","+---","+","+Payload publishes an agent skill inside the `payload` package. Because it ships with the","+package, the guidance your AI assistant reads always matches the version of Payload you","+have installed.","+","+The skill lives at `node_modules/payload/skills/payload/` once `payload` is installed.","+","+## What's included","+","+The skill's `SKILL.md` opens with a Quick Reference table mapping common tasks to the","+relevant reference file, so your assistant only opens the reference docs a given task","+needs rather than loading everything up front. Those reference docs cover:","+","+- **Collections**: auth, uploads, drafts, and live preview configurations","+- **Fields**: all field types including relationships, arrays, blocks, joins, and virtual fields","+- **Hooks**: `beforeChange`, `afterChange`, `beforeValidate`, and field hooks","+- **Access Control**: collection, field, and global patterns including RBAC and multi-tenant, plus advanced row-level security","+- **Queries**: Local API, REST, and GraphQL with complex operators","+- **Database Adapters**: MongoDB, Postgres, and SQLite configuration and transactions","+- **Endpoints**: custom collection and global API routes","+- **Plugin Development**: plugin architecture and package structure","+- **Advanced Features**: jobs queue, localization, and other advanced configuration","+","+## Setup","+","+New projects created with `create-payload-app` are configured automatically. Pass","+`--no-agent` to skip it.","+","+For an existing project, add `AGENTS.md` at the project root:","+","+```md","+# AI Agent","+","+For any Payload-related work, reference the skill at `node_modules/payload/skills/payload/SKILL.md`.","+```","+","+Claude Code reads `CLAUDE.md` rather than `AGENTS.md`. Add a `CLAUDE.md` that imports it,","+so both read the same instructions:","+","+```md","+@AGENTS.md","+```","+","+<Banner type=\"info\">","+  `SKILL.md` costs roughly 8,000 tokens once your assistant opens it. The files","+  under `reference/` are only read on demand, so the full skill is not loaded","+  into context up front.","+</Banner>","+","+## Claude Code plugin","+","+Payload also publishes the skill as a Claude Code plugin. The plugin tracks the `main`","+branch rather than your installed version, so prefer it only when contributing to Payload","+itself or when you specifically want unreleased guidance.","+","+```bash","+/plugin marketplace add payloadcms/payload","+/plugin install payload@payload-marketplace","+```","+","+<Banner type=\"warning\">","+  Use one channel per project. The plugin and the `node_modules` pointer both","+  provide a skill named `payload`. Enabling both puts two copies at different","+  versions in scope, and they can give conflicting guidance.","+</Banner>"],"additions":72,"deletions":0,"truncated":false},{"path":"packages/create-payload-app/src/lib/agent-config.spec.ts","lines":["@@ -0,0 +1,25 @@","+import { describe, expect, it } from 'vitest'","+","+import { buildAgentConfigFiles } from './agent-config.js'","+","+describe('buildAgentConfigFiles', () => {","+  it('should write both AGENTS.md and CLAUDE.md', () => {","+    const fileNames = buildAgentConfigFiles().map((file) => file.fileName)","+","+    expect(fileNames).toEqual(['AGENTS.md', 'CLAUDE.md'])","+  })","+","+  it('should point AGENTS.md at the skill inside node_modules', () => {","+    const agents = buildAgentConfigFiles().find((file) => file.fileName === 'AGENTS.md')","+","+    expect(agents?.content).toContain('# AI Agent')","+    expect(agents?.content).toContain('node_modules/payload/skills/payload/SKILL.md')","+    expect(agents?.content).not.toContain('.claude/skills')","+  })","+","+  it('should import AGENTS.md from CLAUDE.md rather than duplicating it', () => {","+    const claude = buildAgentConfigFiles().find((file) => file.fileName === 'CLAUDE.md')","+","+    expect(claude?.content.trim()).toBe('@AGENTS.md')","+  })","+})"],"additions":25,"deletions":0,"truncated":false},{"path":"packages/create-payload-app/src/lib/agent-config.ts","lines":["@@ -0,0 +1,28 @@","+/** Where the skill ships inside a consumer's installed dependencies. */","+const SKILL_PATH = 'node_modules/payload/skills/payload'","+","+type AgentConfigFile = {","+  content: string","+  fileName: 'AGENTS.md' | 'CLAUDE.md'","+}","+","+/**","+ * Builds the agent config files written at project root. They point agents at the skill","+ * bundled with the installed `payload` package, so guidance always matches the installed","+ * version.","+ *","+ * `AGENTS.md` holds the instructions. Claude Code reads only `CLAUDE.md`, so that file","+ * imports `AGENTS.md` rather than duplicating it.","+ */","+export function buildAgentConfigFiles(): AgentConfigFile[] {","+  return [","+    {","+      content: `# AI Agent\\n\\nFor any Payload-related work, reference the skill at \\`${SKILL_PATH}/SKILL.md\\`.\\n`,","+      fileName: 'AGENTS.md',","+    },","+    {","+      content: `@AGENTS.md\\n`,","+      fileName: 'CLAUDE.md',","+    },","+  ]","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"packages/create-payload-app/src/lib/create-project.ts","lines":["@@ -6,7 +6,6 @@ import { fileURLToPath } from 'node:url'"," import path from 'path'"," "," import type {","-  AgentType,","   CliArgs,","   DbDetails,","   PackageManager,","@@ -20,15 +19,14 @@ import {","   DEFAULT_PAYLOAD_VERSION_TAG,","   resolvePackageVersion,"," } from '../utils/resolvePackageVersion.js'","+import { buildAgentConfigFiles } from './agent-config.js'"," import { configurePayloadConfig } from './configure-payload-config.js'"," import { configurePluginProject } from './configure-plugin-project.js'"," import { ensurePnpmBuildApprovals } from './configure-pnpm-builds.js'"," import { downloadExample } from './download-example.js'","-import { downloadSkill } from './download-skill.js'"," import { downloadTemplate } from './download-template.js'"," import { generateSecret } from './generate-secret.js'"," import { manageEnvFiles } from './manage-env-files.js'","-import { getAgentChoice } from './select-agent.js'"," "," const fil