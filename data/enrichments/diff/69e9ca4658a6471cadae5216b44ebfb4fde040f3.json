{"id":"69e9ca4658a6471cadae5216b44ebfb4fde040f3","axis":"silent","repo":"pydantic/pydantic","sha":"69e9ca4658a6471cadae5216b44ebfb4fde040f3","parsed":{"files":[{"path":"docs/api/fields.md","lines":["@@ -12,6 +12,5 @@","         - \"!^from_field$\"","         - \"!^from_annotation$\"","         - \"!^from_annotated_attribute$\"","-        - \"!^merge_field_infos$\"","         - \"!^rebuild_annotation$\"","         - \"!^apply_typevars_map$\""],"additions":0,"deletions":1,"truncated":false},{"path":"docs/concepts/fields.md","lines":["@@ -123,7 +123,7 @@ print(field_info.metadata)"," #> [Gt(gt=1), WithJsonSchema(json_schema={'extra': 'data'}, mode=None)]"," ```"," ","-/// deprecated-removed | v2.11 v3","+/// version-changed | v3"," [`model_fields`][pydantic.main.BaseModel.model_fields] can only be accessed from the class object, not the instance."," ///"," "],"additions":1,"deletions":1,"truncated":false},{"path":"docs/errors/usage_errors.md","lines":["@@ -664,6 +664,28 @@ except PydanticUserError as exc_info:","     assert exc_info.code == 'validator-instance-method'"," ```"," ","+## Model *after* validator on a class method {#model-after-validator-classmethod}","+","+This error is raised when you apply a [model *after* validator](../concepts/validators.md#model-after-validator)","+on a class method. Model *after* validators must be instance methods.","+","+```python","+from pydantic import BaseModel, PydanticUserError, model_validator","+","+try:","+","+    class Model(BaseModel):","+        a: int = 1","+","+        @model_validator(mode='after')","+        @classmethod","+        def check_model(cls, model):","+            return model","+","+except PydanticUserError as exc_info:","+    assert exc_info.code == 'model-after-validator-classmethod'","+```","+"," ## `json_schema_input_type` used with the wrong mode {#validator-input-type}"," "," This error is raised when you explicitly specify a value for the `json_schema_input_type`"],"additions":22,"deletions":0,"truncated":false},{"path":"docs/plugins/griffe_model_metaclass.py","lines":["@@ -0,0 +1,31 @@","+\"\"\"Griffe extension documenting the `ModelMetaclass` properties as `BaseModel` attributes.","+","+`BaseModel.model_fields` and `BaseModel.model_computed_fields` are properties of the","+`ModelMetaclass` (so that they can only be accessed from the model class). Griffe documents","+them on the metaclass, which isn't part of the API documentation.","+\"\"\"","+","+from __future__ import annotations","+","+from typing import Any","+","+import griffe","+","+","+class ModelMetaclassProperties(griffe.Extension):","+    def on_package_loaded(self, *, pkg: griffe.Module, **kwargs: Any) -> None:","+        if pkg.name != 'pydantic':","+            return","+        base_model = pkg['main.BaseModel']","+        metaclass = pkg['_internal._model_construction.ModelMetaclass']","+        for name, member in metaclass.members.items():","+            if name.startswith('_') or name in base_model.members or 'property' not in member.labels:","+                continue","+            docstring = member.docstring","+            attribute = griffe.Attribute(","+                name,","+                annotation=member.annotation,","+                docstring=docstring and griffe.Docstring(docstring.value, parser=docstring.parser),","+            )","+            attribute.labels.add('class-attribute')","+            base_model.set_member(name, attribute)"],"additions":31,"deletions":0,"truncated":false},{"path":"docs/plugins/main.py","lines":["@@ -19,6 +19,7 @@"," from jinja2 import Template  # type: ignore"," from mkdocs.config.defaults import MkDocsConfig"," from mkdocs.exceptions import PluginError","+from mkdocs.plugins import event_priority"," from mkdocs.structure.files import Files"," from mkdocs.structure.pages import Page"," from packaging.version import Version","@@ -41,6 +42,19 @@"," # Start definition of MkDocs hooks"," "," ","+@event_priority(100)  # Run before the mkdocstrings plugin.","+def on_config(config: MkDocsConfig) -> None:","+    \"\"\"","+    Register the Griffe extension documenting the `ModelMetaclass` properties on `BaseModel`.","+","+    This isn't done in `mkdocs.yml`, as its mkdocstrings options are also used by the unified documentation","+    (see https://github.com/pydantic/unified-docs), which can't load extensions from this repository.","+    \"\"\"","+    python_handler = config.plugins['mkdocstrings'].config.handlers['python']","+    options = python_handler.setdefault('options', {})","+    options.setdefault('extensions', []).append(str(THIS_DIR / 'griffe_model_metaclass.py'))","+","+"," def on_pre_build(config: MkDocsConfig) -> None:","     \"\"\"","     Before the build starts."],"additions":14,"deletions":0,"truncated":false},{"path":"pydantic-core/python/pydantic_core/core_schema.py","lines":["@@ -6,15 +6,14 @@"," from __future__ import annotations as _annotations"," "," import sys","-import warnings"," from collections.abc import Callable, Generator, Mapping"," from datetime import date, datetime, time, timedelta"," from decimal import Decimal"," from fractions import Fraction"," from re import Pattern","-from typing import TYPE_CHECKING, Any, Literal, Union, overload","+from typing import TYPE_CHECKING, Any, Literal, Union"," ","-from typing_extensions import TypeVar, deprecated","+from typing_extensions import TypeVar"," "," if sys.version_info < (3, 12):","     from typing_extensions import TypedDict","@@ -1393,47 +1392,17 @@ class EnumSchema(TypedDict, total=False):","     cls: Required[Any]","     members: Required[list[Any]]","     sub_type: Literal['str', 'int', 'float']","-    missing: Callable[[Any], Any]","     strict: bool","     ref: str","     metadata: dict[str, Any]","     serialization: SerSchema"," "," ","-@overload","-@deprecated('The `missing` argument on `enum_schema()` is deprecated and no longer used.')"," def enum_schema(","     cls: Any,","     members: list[Any],","     *,","     sub_