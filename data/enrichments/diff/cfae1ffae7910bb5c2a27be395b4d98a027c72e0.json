{"id":"cfae1ffae7910bb5c2a27be395b4d98a027c72e0","axis":"silent","repo":"pnpm/pnpm","sha":"cfae1ffae7910bb5c2a27be395b4d98a027c72e0","parsed":{"files":[{"path":".changeset/lockfile-pin-breaks-ties.md","lines":["@@ -0,0 +1,12 @@","+---","+\"@pnpm/resolving.resolver-base\": patch","+\"@pnpm/resolving.npm-resolver\": patch","+\"@pnpm/lockfile.preferred-versions\": patch","+\"@pnpm/installing.deps-resolver\": patch","+\"@pnpm/installing.deps-installer\": patch","+\"@pnpm/installing.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+When `pnpm install` resolves a dependency again, it now reuses a version that the install already resolved for the same package, as a fresh install does. Before, it kept the version the lockfile pinned and added a second copy of the package. A locked version still stays when nothing else in the install prefers another version. To pin a transitive dependency on purpose, use `overrides` [#17084](https://github.com/pnpm/pnpm/issues/17084)."],"additions":12,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peer_convergence.rs","lines":["@@ -746,36 +746,10 @@ fn peer_provided_by_a_dependency_moves() {","             alias: \"provider\",","             to: \"npm:@pnpm.e2e/has-foo-100.1.0-dep-1@1.0.0\",","         }],","-        vec![","-            Divergence {","-                issue: LOCKFILE_ONLY_VERSION_ISSUE,","-                check: Check::MoveBack,","-                rows: |row| !row.auto_dedupe,","-                paths: LOCKFILE_ONLY_VERSION_PATHS,","-            },","-            Divergence {","-                issue: LOCKFILE_ONLY_VERSION_ISSUE,","-                check: Check::Incremental,","-                rows: |row| row.auto_install_peers && !row.auto_dedupe,","-                paths: LOCKFILE_ONLY_VERSION_PATHS,","-            },","-        ],","+        vec![],","     );"," }"," ","-const LOCKFILE_ONLY_VERSION_ISSUE: &str = \"https://github.com/pnpm/pnpm/issues/17084\";","-","-/// `requires-any-foo` resolves `*` to the version only the lockfile holds,","-/// and the peer binds to it.","-const LOCKFILE_ONLY_VERSION_PATHS: &[&str] = &[","-    \"importers > packages/app > dependencies > @pnpm.e2e/has-foo100-peer > version \",","-    \"packages > @pnpm.e2e/foo@100.1.0 >\",","-    \"snapshots > @pnpm.e2e/foo@100.1.0 \",","-    \"snapshots > @pnpm.e2e/has-foo100-peer@1.0.0(@pnpm.e2e/foo@100.0.0) \",","-    \"snapshots > @pnpm.e2e/has-foo100-peer@1.0.0(@pnpm.e2e/foo@100.1.0) \",","-    \"snapshots > @pnpm.e2e/requires-any-foo@1.0.0 > dependencies > @pnpm.e2e/foo \",","-];","-"," /// The only provider of the required peer is a workspace dependency's own"," /// dependency, so an auto-installed peer follows it (pnpm/tasks#61)."," #[test]"],"additions":1,"deletions":27,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/update.rs","lines":["@@ -1401,3 +1401,30 @@ mod selectors;"," mod overrides;"," "," mod compatibility_db;","+","+/// A changed specifier re-resolves its dependency, and that dependency's","+/// own dependencies keep the versions the lockfile pins while nothing else","+/// in the graph prefers another (pnpm/pnpm#2191).","+#[test]","+fn a_changed_specifier_keeps_the_locked_versions_of_its_dependencies() {","+    const FOOBARQAR: &str = \"@pnpm.e2e/foobarqar\";","+    let (root, workspace, anchor) = setup_with_own_registry();","+    anchor.set_dist_tag(FOO, \"100.0.0\", \"latest\");","+    anchor.set_dist_tag(BAR, \"100.0.0\", \"latest\");","+    anchor.set_dist_tag(FOOBARQAR, \"1.0.0\", \"latest\");","+    write_manifest(&workspace, &format!(r#\"{{ \"{FOOBARQAR}\": \"^1.0.0\" }}\"#));","+    pacquet(&workspace, [\"install\", \"--lockfile-only\"]).assert().success();","+","+    anchor.set_dist_tag(FOO, \"100.1.0\", \"latest\");","+    anchor.set_dist_tag(BAR, \"100.1.0\", \"latest\");","+    anchor.set_dist_tag(FOOBARQAR, \"1.0.1\", \"latest\");","+    write_manifest(&workspace, &format!(r#\"{{ \"{FOOBARQAR}\": \"^1.0.1\" }}\"#));","+    pacquet(&workspace, [\"install\", \"--lockfile-only\"]).assert().success();","+","+    let packages = lockfile_package_keys(&workspace);","+    assert!(packages.contains(&format!(\"{FOOBARQAR}@1.0.1\")), \"{packages:?}\");","+    assert!(packages.contains(&format!(\"{FOO}@100.0.0\")), \"{packages:?}\");","+    assert!(!packages.contains(&format!(\"{FOO}@100.1.0\")), \"{packages:?}\");","+","+    drop((root, anchor));","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"pnpm/crates/lockfile-import/src/lib.rs","lines":["@@ -23,8 +23,8 @@ use std::{"," use derive_more::{Display, Error};"," use miette::Diagnostic;"," use pnpm_resolving_resolver_base::{","-    EXISTING_VERSION_SELECTOR_WEIGHT, PreferredVersions, VersionSelectorEntry, VersionSelectorType,","-    VersionSelectorWithWeight,","+    PreferredVersions, REQUESTED_VERSION_SELECTOR_WEIGHT, VersionSelectorEntry,","+    VersionSelectorType, VersionSelectorWithWeight,"," };"," "," mod npm;","@@ -129,7 +129,7 @@ pub fn read_foreign_lockfile_versions("," /// Turn collected versions into resolver preferences."," ///"," /// Every version becomes a `version` selector with","-/// [`EXISTING_VERSION_SELECTOR_WEIGHT`], matching the TypeScript CLI. That","+/// [`REQUESTED_VERSION_SELECTOR_WEIGHT`], matching the TypeScript CLI. That"," /// weight outranks the direct-dependency ranges every workspace project"," /// contributes, so another project's wider range cannot pull a project off"," /// its pinned version. A range collected from npm's flat format only takes","@@ -145,7 +145,7 @@ pub fn to_preferred_versions(versions: &VersionsByPackageName) -> PreferredVersi","                 .map(|version| {","                     let selector = VersionSelectorWithWeight {","                         selector_type: VersionSelectorType::Version,","-                        weight: EXISTING_VERSION_SELECTOR_WEIGHT,","+                        weight: REQUESTED_VERSION_SELECTOR_WEIGHT,","                     };","                     