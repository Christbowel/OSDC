le('image2.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\t// The modal is a dialog labelled by the current file name.","+\t\tconst dialog = page.locator('.viewer__modal[role=\"dialog\"]')","+\t\tawait expect(dialog).toBeVisible()","+\t\texpect(await viewerPage.currentName()).toBe('image2.jpg')","+","+\t\t// Navigation and close controls have accessible names.","+\t\tawait expect(viewerPage.nextButton).toBeVisible()","+\t\tawait expect(viewerPage.previousButton).toBeVisible()","+\t\tawait expect(viewerPage.closeButton).toBeVisible()","+\t})","+})"],"additions":31,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/close.spec.ts","lines":["@@ -0,0 +1,23 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { test } from '../../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer close on click outside', () => {","+\ttest.beforeEach(async ({ filesListPage, uploadMedia }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+\t})","+","+\t// Regression for nextcloud/viewer#2166: clicking outside the image closes it.","+\ttest('closes when clicking outside the media', async ({ openFile, viewerPage }) => {","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\tawait viewerPage.clickOutside()","+","+\t\tawait viewerPage.waitForClosed()","+\t})","+})"],"additions":23,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/delete.spec.ts","lines":["@@ -0,0 +1,29 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer delete action', () => {","+\t// Deleting the shown file advances the viewer to the next file, then the","+\t// previous one, then closes when nothing is left.","+\ttest('advances to the next file, then closes when the list is empty', async ({ filesListPage, uploadMedia, openFile, viewerPage }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait uploadMedia('image2.jpg', 'image2.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\t// Delete the first file → viewer moves to the second, staying open.","+\t\tawait viewerPage.runAction('Delete file')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait expect(async () => {","+\t\t\texpect(await viewerPage.currentName()).toBe('image2.jpg')","+\t\t}).toPass()","+","+\t\t// Delete the only remaining file → viewer closes.","+\t\tawait viewerPage.runAction('Delete file')","+\t\tawait viewerPage.waitForClosed()","+\t})","+})"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/download.spec.ts","lines":["@@ -0,0 +1,31 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, sharingTest as test, uploadMediaFile } from '../../../support/fixtures/viewer-page.ts'","+import { mkdir } from '../../../support/utils/dav.ts'","+import { createShare, DOWNLOAD_DISABLED_ATTRIBUTE, waitForShare } from '../../../support/utils/sharing.ts'","+","+test.describe('Viewer download restrictions', () => {","+\t// The owner shares a folder with the current user, forbidding download. The","+\t// recipient must then get no download control in the viewer.","+\ttest('does not expose a download control when download is forbidden', async ({ page, user, owner, ownerRequest, filesListPage, viewerPage }) => {","+\t\tawait mkdir(ownerRequest, owner, '/Photos')","+\t\tawait uploadMediaFile(ownerRequest, owner, 'image1.jpg', '/Photos/image1.jpg', 'image/jpeg')","+\t\tawait createShare(ownerRequest, '/Photos', user.userId, { attributes: DOWNLOAD_DISABLED_ATTRIBUTE })","+\t\tawait waitForShare(page.request, user, '', 'Photos')","+","+\t\tawait filesListPage.open()","+\t\tawait filesListPage.getRowNameLinkForFile('Photos').click()","+\t\tawait expect(filesListPage.getRowForFile('image1.jpg')).toBeVisible()","+","+\t\tawait filesListPage.getRowNameLinkForFile('image1.jpg').click()","+\t\tawait viewerPage.isVisible()","+\t\texpect(await viewerPage.currentName()).toBe('image1.jpg')","+","+\t\t// No download link nor download action is offered in the viewer.","+\t\tawait expect(viewerPage.modal.locator('a[download]')).toHaveCount(0)","+\t\tawait expect(viewerPage.modal.getByRole('button', { name: /download/i })).toHaveCount(0)","+\t})","+})"],"additions":31,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/edit.spec.ts","lines":["@@ -0,0 +1,54 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer image editor action', () => {","+\ttest.beforeEach(async ({ filesListPage, uploadMedia }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+\t\tawait expect(filesListPage.getRowForFile('image1.jpg')).toBeVisible()","+\t})","+","+\t// The Edit action opens @nextcloud/image-editor; its Cancel closes it.","+\ttest('opens the image editor and closes it on cancel', async ({ page, openFile, viewerPage }) => {","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\tawait viewerPage.runAction('Edit')","+\t\tconst editor = page.locator('.viewer__image-editor.image-editor')","+\t\tawait expect(editor).toBeVisible()","+\t\texpect(page.url()).toContain('editing=true')","+","+\t\tawait page.locator('[data-test=\"cancel\"], [data-test=\"cancel-icon\"]').first().click()","+\t\tawait expect(editor).toBeHidden()","+\t\texpect(page.url()).not.toContain('editing=true')","+\t})","+","+\t// Saving overwrites the file and shows the edited image from its local blob,","+\t// without a server refetch.","+\ttest('saves and shows the edited image without a refetch', async ({ page, openFile, viewerPage }) => {","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait viewerPage.runAction('Edit')","+\t\tawait expect(page.locator('.viewer__image-editor.image-editor')).toBeVisible()","+","+\t\tawait page.locator('[data-test=\"save\"]').click()","+","+\t\tawait expect(page.locator('.viewer__image-editor.image-editor')).toBeHidden()","+\t\tawait expect(page.locator('oca-viewer-image img')).toHaveAttribute('src', /^blob:/)","+\t})","+","+\t// The `editing=true` URL param reopens the editor on refresh.","+\ttest('reopens the editor from an editing=true URL', async ({ page, openFile, viewerPage }) => {","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait viewerPage.runAction('Edit')","+\t\tawait expect(page.locator('.viewer__image-editor.image-editor')).toBeVisible()","+","+\t\tawait page.reload()","+\t\tawait expect(page.locator('.viewer__image-editor.image-editor')).toBeVisible()","+\t})","+})"],"additions":54,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/menu.spec.ts","lines":["@@ -0,0 +1,34 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer actions menu', () => {","+\t// The viewer links its header menu to the Files actions. Actions rendered by","+\t// a custom component (e.g. the sharing status) have no static label/icon and","+\t// must be filtered out, otherwise they show up as blank menu entries.","+\ttest('does not render blank entries for custom-rendered file actions', async ({ page, filesListPage, uploadMedia, openFile, viewerPage }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\tconst toggle = viewerPage.actionsToggle()","+\t\tawait toggle.click()","+","+\t\tconst menuItems = page.getByRole('menuitem')","+\t\tawait expect(menuItems.first()).toBeVisible()","+","+\t\t// Every menu entry must have a non-empty accessible label.","+\t\tconst labels = await menuItems.allInnerTexts()","+\t\texpect(labels.length).toBeGreaterThan(0)","+\t\tfor (const label of labels) {","+\t\t\texpect(label.trim()).not.toBe('')","+\t\t}","+","+\t\t// The sharing-status action is custom-rendered and must be absent.","+\t\tawait expect(page.getByRole('menuitem', { name: /sharing/i })).toHaveCount(0)","+\t})","+})"],"additions":34,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/rename.spec.ts","lines":["@@ -0,0 +1,31 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer rename action', () => {","+\t// The Files rename action edits the file-list row, which the viewer cannot","+\t// host, so the viewer renames through its own dialog instead.","+\ttest('renames the current file from the viewer', async ({ page, filesListPage, uploadMedia, openFile, viewerPage }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\tawait viewerPage.runAction('Rename')","+","+\t\tconst dialog = page.getByRole('dialog', { name: 'Rename file' })","+\t\tawait expect(dialog).toBeVisible()","+\t\tconst input = dialog.getByRole('textbox')","+\t\tawait input.fill('renamed.jpg')","+\t\tawait dialog.getByRole('button', { name: 'Rename' }).click()","+","+\t\tawait expect(dialog).toBeHidden()","+\t\t// The header reflects the new name.","+\t\tawait expect(async () => {","+\t\t\texpect(await viewerPage.currentName()).toBe('renamed.jpg')","+\t\t}).toPass()","+\t})","+})"],"additions":31,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/actions/sidebar.spec.ts","lines":["@@ -0,0 +1,72 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer sidebar action', () => {","+\ttest.beforeEach(async ({ filesListPage, uploadMedia }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+\t\tawait expect(filesListPage.getRowForFile('image1.jpg')).toBeVisible()","+\t})","+","+\ttest('opens the Files sidebar for the current file', async ({ page, openFile, viewerPage }) => {","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\tawait viewerPage.openSidebar()","+","+\t\tconst sidebar = page.locator('aside.app-sidebar')","+\t\tawait expect(sidebar).toBeVisible()","+\t\tawait expect(sidebar.locator('.app-sidebar-header__mainname')).toContainText('image1.jpg')","+\t})","+","+\t// The sidebar next to the viewer must fill the full height (the app header is","+\t// hidden), like the pre-7.0.0 viewer did.","+\ttest('shows the sidebar full height next to the viewer', async ({ page, openFile, viewerPage }) => {","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait viewerPage.openSidebar()","+","+\t\tconst sidebar = page.locator('aside.app-sidebar')","+\t\tawait expect(sidebar).toBeVisible()","+","+\t\tawait expect(async () => {","+\t\t\tconst full = await page.evaluate(() => {","+\t\t\t\tconst el = document.querySelector('aside.app-sidebar')!","+\t\t\t\tconst header = document.querySelector('#header')","+\t\t\t\treturn document.body.classList.contains('viewer--sidebar-fullscreen')","+\t\t\t\t\t&& getComputedStyle(el).position === 'fixed'","+\t\t\t\t\t&& (!header || getComputedStyle(header).visibility === 'hidden')","+\t\t\t\t\t&& Math.round(el.getBoundingClientRect().height) === window.innerHeight","+\t\t\t})","+\t\t\texpect(full).toBe(true)","+\t\t}).toPass()","+\t})","+","+\t// Regression for nextcloud/viewer#658: opening the sidebar while the image is","+\t// still loading must still show the sidebar (the header actions are available","+\t// during loading).","+\ttest('opens the sidebar right after opening a file', async ({ page, openFile, viewerPage }) => {","+\t\t// The header actions have to work from the moment the viewer is up,","+\t\t// whether or not the pixels have arrived. The loading state itself is","+\t\t// not what is asserted: the file list fetches the preview for its own","+\t\t// row and the viewer reuses that response, so holding the viewer's","+\t\t// request back delays nothing, and the spinner measured here lives","+\t\t// about 600ms. Waiting for it is a race in both directions, which is","+\t\t// how this test failed on a fast machine and passed on a slow one.","+\t\tawait openFile('image1.jpg')","+\t\tawait expect(viewerPage.container).toBeVisible()","+","+\t\tawait viewerPage.openSidebar()","+","+\t\tconst sidebar = page.locator('aside.app-sidebar')","+\t\tawait expect(sidebar).toBeVisible()","+\t\tawait expect(sidebar).toContainText('image1.jpg')","+","+\t\t// And the picture still arrives behind it","+\t\tawait viewerPage.waitForOpen()","+\t})","+})"],"additions":72,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/audios.spec.ts","lines":["@@ -0,0 +1,8 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { AUDIO_MEDIA, createMediaViewerTests } from './media.ts'","+","+createMediaViewerTests(AUDIO_MEDIA)"],"additions":8,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/compare.spec.ts","lines":["@@ -0,0 +1,53 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer compare API', () => {","+\t// The compare() API renders two files side by side. It has no Files-app UI","+\t// (it is used programmatically, e.g. by files_versions), so we capture two","+\t// real File nodes by opening them, then call the public viewer service.","+\ttest('renders two files side by side', async ({ page, filesListPage, uploadMedia, openFile, viewerPage }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait uploadMedia('image2.jpg', 'image2.jpg', 'image/jpeg')","+\t\tawait filesListPage.open()","+","+\t\t// Capture the File node passed to the viewer for each opened file.","+\t\tawait page.evaluate(() => {","+\t\t\tconst win = window as unknown as {","+\t\t\t\t__capturedNodes: unknown[]","+\t\t\t\t_nc_viewer_scope: Record<string, { service: { open: (...args: unknown[]) => unknown } }>","+\t\t\t}","+\t\t\twin.__capturedNodes = []","+\t\t\tconst service = win._nc_viewer_scope.handlers_v1!.service","+\t\t\tconst original = service.open.bind(service)","+\t\t\tservice.open = (nodes: unknown, file: unknown, ...rest: unknown[]) => {","+\t\t\t\twin.__capturedNodes.push(file)","+\t\t\t\treturn original(nodes, file, ...rest)","+\t\t\t}","+\t\t})","+","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait viewerPage.close()","+","+\t\tawait openFile('image2.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait viewerPage.close()","+","+\t\t// Programmatically compare the two captured nodes.","+\t\tawait page.evaluate(async () => {","+\t\t\tconst win = window as unknown as {","+\t\t\t\t__capturedNodes: unknown[]","+\t\t\t\t_nc_viewer_scope: Record<string, { service: { compare: (a: unknown, b: unknown) => Promise<void> } }>","+\t\t\t}","+\t\t\tawait win._nc_viewer_scope.handlers_v1!.service.compare(win.__capturedNodes[0], win.__capturedNodes[1])","+\t\t})","+","+\t\tconst comparison = viewerPage.modal.locator('.viewer__comparison')","+\t\tawait expect(comparison).toBeVisible()","+\t\tawait expect(comparison.locator('oca-viewer-image')).toHaveCount(2)","+\t})","+})"],"additions":53,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/custom-list.spec.ts","lines":["@@ -0,0 +1,137 @@","+/*","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import type { Page } from '@playwright/test'","+","+import { expect, test } from '../../support/fixtures/viewer-page.ts'","+","+/**","+ * The viewer can be handed a list of its own rather than the folder it was","+ * opened from: Photos and the versions sidebar both do it. These are the","+ * Playwright port of the old app's `images-custom-list` specs.","+ */","+","+/** Minimum a file needs to be handed back to the viewer */","+interface CapturedNode { basename: string }","+","+/**","+ * Open one file so the viewer is handed the folder listing, keep the nodes it","+ * was given, then close it again. Those nodes are real, so a list built from","+ * them exercises the same path a caller would.","+ *","+ * @param page - The test page","+ */","+async function captureFolderNodes(page: Page): Promise<void> {","+\tawait page.evaluate(() => {","+\t\tconst win = window as unknown as {","+\t\t\t__capturedList: unknown[]","+\t\t\t_nc_viewer_scope: Record<string, { service: { open: (...args: unknown[]) => unknown } }>","+\t\t}","+\t\twin.__capturedList = []","+\t\tconst service = win._nc_viewer_scope.handlers_v1!.service","+\t\tconst original = service.open.bind(service)","+\t\t// Only the first open is the folder listing; every later one is a list","+\t\t// this test handed over, so the wrapper steps aside once it has it","+\t\tservice.open = (nodes: unknown, file: unknown, ...rest: unknown[]) => {","+\t\t\twin.__capturedList = nodes as unknown[]","+\t\t\tservice.open = original","+\t\t\treturn original(nodes, file, ...rest)","+\t\t}","+\t})","+}","+","+/**","+ * Hand the viewer a list of its own, named by basename.","+ *","+ * @param page - The test page","+ * @param names - The files to put in the list, in order","+ * @param loadMore - Files to append once navigation reaches the end","+ */","+async function openList(page: Page, names: string[], loadMore: string[] = []): Promise<void> {","+\tawait page.evaluate(({ wanted, more }) => {","+\t\tconst win = window as unknown as {","+\t\t\t__capturedList: CapturedNode[]","+\t\t\t_nc_viewer_scope: Record<string, { service: { open: (...args: unknown[]) => Promise<void> } }>","+\t\t}","+\t\tconst pick = (names: string[]) => names","+\t\t\t.map((name) => win.__capturedList.find((node) => node.basename === name))","+\t\t\t.filter((node) => node !== undefined)","+\t\tconst list = pick(wanted)","+\t\tlet appended = false","+\t\tconst marker = window as unknown as { __loadedMore?: boolean }","+\t\tmarker.__loadedMore = false","+\t\tconst options = more.length === 0","+\t\t\t? {}","+\t\t\t: {","+\t\t\t\t\tloadMore: async () => {","+\t\t\t\t\t\tif (appended) {","+\t\t\t\t\t\t\treturn []","+\t\t\t\t\t\t}","+\t\t\t\t\t\tappended = true","+\t\t\t\t\t\t// The viewer appends what this resolves with, so the test","+\t\t\t\t\t\t// waits for the flag before asking for the next file","+\t\t\t\t\t\tmarker.__loadedMore = true","+\t\t\t\t\t\treturn pick(more)","+\t\t\t\t\t},","+\t\t\t\t}","+\t\treturn win._nc_viewer_scope.handlers_v1!.service.open(list, list[0], options)","+\t}, { wanted: names, more: loadMore })","+}","+","+test.describe('Viewer custom list', () => {","+\ttest.beforeEach(async ({ filesListPage, uploadMedia, openFile, viewerPage, page }) => {","+\t\tfor (const name of ['image1.jpg', 'image2.jpg', 'image3.jpg', 'image4.jpg']) {","+\t\t\tawait uploadMedia(name, name, 'image/jpeg')","+\t\t}","+\t\tawait filesListPage.open()","+","+\t\tawait captureFolderNodes(page)","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tawait viewerPage.close()","+\t})","+","+\ttest('pages through the list it was handed, not the folder', async ({ page, viewerPage }) => {","+\t\t// The folder holds four images; the caller offers two of them","+\t\tawait openList(page, ['image1.jpg', 'image3.jpg'])","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image1.jpg')","+","+\t\tawait viewerPage.next()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image3.jpg')","+","+\t\t// image2 and image4 are in the folder but not in the list, so the end of","+\t\t// the list wraps straight back to its first entry","+\t\tawait viewerPage.next()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image1.jpg')","+\t})","+","+\ttest('asks for more files when it runs out', async ({ page, viewerPage }) => {","+\t\tawait openList(page, ['image1.jpg', 'image2.jpg'], ['image3.jpg', 'image4.jpg'])","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image1.jpg')","+","+\t\tawait viewerPage.next()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image2.jpg')","+","+\t\t// Reaching the last entry is what asks for more, and the viewer appends","+\t\t// them when that resolves: pressing next before it has is what a person","+\t\t// could never do and a test does every time","+\t\tawait page.waitForFunction(() => (window as unknown as { __loadedMore?: boolean }).__loadedMore === true)","+","+\t\t// The end of the given list: what loadMore returned continues it rather","+\t\t// than wrapping round to the start","+\t\tawait viewerPage.next()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image3.jpg')","+","+\t\tawait viewerPage.next()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image4.jpg')","+\t})","+})"],"additions":137,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/error.spec.ts","lines":["@@ -0,0 +1,24 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { test } from '../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer error handling', () => {","+\t// A media file that fails to load must show an error, not stay stuck on the","+\t// loading spinner (regression guard for the loading-gate / onError path).","+\ttest('shows an error when the media fails to load', async ({ page, filesListPage, uploadMedia, openFile, viewerPage }) => {","+\t\tawait uploadMedia('video1.mp4', 'video1.mp4', 'video/mp4')","+","+\t\t// Make every request for the video fail: the direct source and the E2EE","+\t\t// fallback fetch both hit the dav endpoint for this file.","+\t\tawait page.route('**/video1.mp4', (route) => route.abort())","+\t\tawait page.route('**/video1.mp4?**', (route) => route.abort())","+","+\t\tawait filesListPage.open()","+\t\tawait openFile('video1.mp4')","+","+\t\tawait viewerPage.expectError()","+\t})","+})"],"additions":24,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/viewer/history.spec.ts","lines":["@@ -0,0 +1,76 @@","+/*","+ * SPDX-FileCopyrightText: 2025 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { expect, test } from '../../support/fixtures/viewer-page.ts'","+","+test.describe('Viewer browser history', () => {","+\ttest.beforeEach(async ({ uploadMedia }) => {","+\t\tawait uploadMedia('image1.jpg', 'image1.jpg', 'image/jpeg')","+\t\tawait uploadMedia('image2.jpg', 'image2.jpg', 'image/jpeg')","+\t})","+","+\ttest('reflects the open file in the URL and re-opens on refresh', async ({ page, filesListPage, openFile, viewerPage }) => {","+\t\tawait filesListPage.open()","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+","+\t\t// Opening pushes an openfile URL so a refresh re-triggers the viewer.","+\t\texpect(page.url()).toContain('openfile=true')","+","+\t\tawait page.reload()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image1.jpg')","+\t})","+","+\ttest('back and forward move between the shown files', async ({ page, filesListPage, openFile, viewerPage }) => {","+\t\tawait filesListPage.open()","+\t\tawait openFile('image1.jpg')","+\t\tawait viewerPage.waitForOpen()","+\t\tconst openUrl = page.url()","+","+\t\tawait viewerPage.next()","+\t\tawait viewerPage.waitForOpen()","+\t\texpect(await viewerPage.currentName()).toBe('image2.jpg')"],"additions":35,"deletions":0,"truncated":false}],"additions":617,"deletions":2,"truncated":true,"file_count":32},"error":null,"fetched_at":"2026-10-02T14:44:28.105392+00:00"}