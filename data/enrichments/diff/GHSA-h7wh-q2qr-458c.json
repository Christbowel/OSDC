{"id":"GHSA-h7wh-q2qr-458c","axis":"advisories","repo":"rails/rails-html-sanitizer","sha":"15f764c3563d5dd9b97ad32eaa7454577ccec4b9","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -18,6 +18,18 @@"," ","   *Mike Dalessio*"," ","+* `SafeListSanitizer` no longer shares a `PermitScrubber` across calls.","+","+  Previously one sanitizer instance reused a single `PermitScrubber`, assigning its `tags` and","+  `attributes` on every call. Action View memoizes one sanitizer per helper module, so two","+  concurrent `sanitize` calls with different `tags:` or `attributes:` options could interleave and","+  one call could be scrubbed with the other call's allowlist. Each call now builds its own","+  `PermitScrubber`.","+","+  This change addresses GHSA-h7wh-q2qr-458c.","+","+  *Mike Dalessio*","+"," "," ## v1.7.1 / 2026-07-15"," "],"additions":12,"deletions":0,"truncated":false},{"path":"lib/rails/html/sanitizer.rb","lines":["@@ -154,7 +154,7 @@ class << klass","           end"," ","           def initialize(prune: false)","-            @permit_scrubber = PermitScrubber.new(prune: prune)","+            @prune = prune","           end"," ","           def scrub(fragment, options = {})","@@ -162,9 +162,10 @@ def scrub(fragment, options = {})","               # No duck typing, Loofah ensures subclass of Loofah::Scrubber","               fragment.scrub!(scrubber)","             elsif allowed_tags(options) || allowed_attributes(options)","-              @permit_scrubber.tags = allowed_tags(options)","-              @permit_scrubber.attributes = allowed_attributes(options)","-              fragment.scrub!(@permit_scrubber)","+              permit_scrubber = PermitScrubber.new(prune: @prune)","+              permit_scrubber.tags = allowed_tags(options)","+              permit_scrubber.attributes = allowed_attributes(options)","+              fragment.scrub!(permit_scrubber)","             else","               fragment.scrub!(:strip)","             end"],"additions":5,"deletions":4,"truncated":false},{"path":"test/sanitizer_test.rb","lines":["@@ -1273,6 +1273,24 @@ def test_should_prune_noscript","       assert_includes(acceptable_results, actual)","     end"," ","+    def test_reentrant_sanitize_call_does_not_share_scrubber_configuration","+      sanitizer = module_under_test::SafeListSanitizer.new","+      permissive_result = nil","+","+      strict_options = { tags: %w(div), attributes: [] }","+      strict_options.define_singleton_method(:[]) do |key|","+        if key == :attributes && permissive_result.nil?","+          permissive_result = sanitizer.sanitize(\"<script>alert(2)</script>\", tags: %w(script), attributes: [])","+        end","+        super(key)","+      end","+","+      strict_result = sanitizer.sanitize(\"<div>x</div><script>alert(1)</script>\", strict_options)","+","+      assert_equal(\"<script>alert(2)</script>\", permissive_result)","+      assert_equal(\"<div>x</div>alert(1)\", strict_result)","+    end","+","     protected","       def safe_list_sanitize(input, options = {})","         module_under_test::SafeListSanitizer.new.sanitize(input, options)",""],"additions":18,"deletions":0,"truncated":false}],"additions":35,"deletions":4,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-14T15:12:38.132392+00:00"}