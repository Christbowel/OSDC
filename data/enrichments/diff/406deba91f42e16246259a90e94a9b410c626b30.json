       // Match the Razor file, not its generated C# document. Leave missing values to the caller so","+        // IDE preferences remain the fallback without introducing a dependency on client settings here.","+        return razorDocument.Project.State","+            .GetAnalyzerOptionsForPath(razorDocument.FilePath.AssumeNotNull(), cancellationToken)","+            .ConfigOptionsWithoutFallback;","+    }","+}"],"additions":41,"deletions":0,"truncated":false},{"path":"src/Razor/src/Razor/src/Microsoft.CodeAnalysis.Razor.Workspaces.Shared/Microsoft.CodeAnalysis.Razor.Workspaces.Shared.projitems","lines":["@@ -35,6 +35,7 @@","     <Compile Include=\"$(MSBuildThisFileDirectory)Extensions\\TextChangeExtensions.cs\" />","     <Compile Include=\"$(MSBuildThisFileDirectory)Extensions\\TextLineExtensions.cs\" />","     <Compile Include=\"$(MSBuildThisFileDirectory)Formatting\\CSharpFormattingOptionsExtensions.cs\" />","+    <Compile Include=\"$(MSBuildThisFileDirectory)Formatting\\RazorFormattingOptionsStorage.cs\" />","     <Compile Include=\"$(MSBuildThisFileDirectory)Logging\\EmptyLoggerFactory.cs\" />","     <Compile Include=\"$(MSBuildThisFileDirectory)Logging\\Handlers\\CriticalLogMessageInterpolatedStringHandler.cs\" />","     <Compile Include=\"$(MSBuildThisFileDirectory)Logging\\Handlers\\DebugLogMessageInterpolatedStringHandler.cs\" />"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Razor/src/Razor/src/Microsoft.CodeAnalysis.Razor.Workspaces/Formatting/RazorFormattingOptions.cs","lines":["@@ -34,40 +34,6 @@ public CSharpSyntaxFormattingOptions GetResolvedCSharpSyntaxFormattingOptions()","         => CSharpSyntaxFormattingOptions.GetResolvedCSharpSyntaxFormattingOptions(","             InsertSpaces, TabSize, CSharpSyntaxFormattingOptions.Default.NewLine);"," ","-    public static RazorFormattingOptions From(","-        LspFormattingOptions options,","-        bool codeBlockBraceOnNextLine,","-        AttributeIndentStyle attributeIndentStyle,","-   