),","+          y: new Coordinates([0, 0])","+        }),","+        getPosition: {sql: 'ARRAY[x, y]'},","+        radiusUnits: 'pixels',","+        getRadius: 6,","+        pickable: true","+      });","+      const errors: Error[] = [];","+      const deck = new Deck({","+        device: testDevice,","+        width: 128,","+        height: 128,","+        useDevicePixels: false,","+        views: new OrthographicView(),","+        initialViewState: {target: [0, 0, 0], zoom: 0},","+        layers: [layer],","+        onError: error => errors.push(error)","+      });","+      try {","+        await vi.waitFor(","+          () => {","+            expect(errors).toEqual([]);","+            expect(layer.isLoaded).toBe(true);","+            const positions = layer.internalState?.accessorQueries?.table?.getChild('getPosition');","+            expect(positions?.getChildAt(0)?.toArray()).toBeInstanceOf(Coordinates);","+            expect(layer.getBounds()).toEqual([","+              [-20, 0, 0],","+              [20, 0, 0]","+            ]);","+            deck.redraw('draw SQL positions');","+          },","+          {timeout: 5000}","+        );","+        expect((await deck.pickObjectAsync({x: 44, y: 64}))?.index).toBe(0);","+        expect((await deck.pickObjectAsync({x: 84, y: 64}))?.index).toBe(1);","+      } finally {","+        deck.finalize();","+      }","+    });","+  }","+}",""],"additions":65,"deletions":0,"truncated":false}],"additions":91,"deletions":26,"truncated":false,"file_count":19},"error":null,"fetched_at":"2026-11-21T16:32:06.671830+00:00"}