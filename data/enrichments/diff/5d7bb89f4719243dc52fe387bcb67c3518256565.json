ARS ? VoiceModelRole.VOICE : null","+\t);","+\t// the drawer captures the pointer of a press on its content, and a dispatched touch has none","+\tvi.spyOn(Element.prototype, 'setPointerCapture').mockImplementation(() => {});","+\tawait page.viewport(390, 844);","+});","+","+afterEach(() => {","+\tvi.restoreAllMocks();","+\tsettingsStore.config = previousConfig;","+\tserverStore.role = previousRole;","+});","+","+/** Holds a row with a finger: a touch press, then the context menu a long touch raises. */","+async function hold(row: HTMLElement) {","+\trow.dispatchEvent(","+\t\tnew PointerEvent('pointerdown', { bubbles: true, isPrimary: true, pointerType: 'touch' })","+\t);","+\trow.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true }));","+}","+","+function renderSheet() {","+\treturn render(ModelsSelectorSheetWrapper, {","+\t\tactiveId: DEAF,","+\t\topen: true,","+\t\tquickItems: [item(DEAF), item(HEARS)]","+\t});","+}","+","+it('offers a model that hears for dictation, and picks it', async () => {","+\tconst screen = renderSheet();","+\tconst row = screen.getByRole('button', { name: /Voxtral/ });","+","+\tawait expect.element(row).toBeVisible();","+\tawait hold(row.element() as HTMLElement);","+","+\tconst use = page.getByRole('menuitem', { name: VOICE_DICTATION_MODEL_LABEL.use });","+","+\tawait expect.element(use).toBeVisible();","+\tawait use.click();","+","+\texpect(settingsStore.config[SETTINGS_KEYS.VOICE_TRANSCRIPTION_MODEL]).toBe(HEARS);","+});","+","+it('does not offer a model that cannot hear', async () => {","+\tconst screen = renderSheet();","+\tconst row = screen.getByRole('button', { name: /Qwen3/ });","+","+\tawait expect.element(row).toBeVisible();","+\tawait hold(row.element() as HTMLElement);","+","+\tawait expect","+\t\t.element(page.getByRole('menuitem', { name: MODELS_SHEET_TEXT.MORE_DETAILS }))","+\t\t.toBeVisible();","+\texpect(page.getByRole('menuitem', { name: VOICE_DICTATION_MODEL_LABEL.use }).query()).toBeNull();"