/ The chain file is ignored","+        assertServerChain(TesterSupport.CA_CERT_PEM);","+    }","+","+","+    @Test","+    public void testHostRSAPkcs12LeafOnlyWithChainFile() throws Exception {","+        configureHostRSAChainFileTest(TesterSupport.createLocalhostRsaPkcs12(false), true);","+        // The chain file is used","+        assertServerChain(TesterSupport.LOCALHOST_EC_CERT_PEM);","+    }","+","+","+    @Test","+    public void testHostRSAPkcs12WithChainAndChainFile() throws Exception {","+        configureHostRSAChainFileTest(TesterSupport.createLocalhostRsaPkcs12(true), true);","+        // The chain file is ignored","+        assertServerChain(TesterSupport.CA_CERT_PEM);","+    }","+","+","+    /*","+     * The certificate file may also hold the private key and that key may be encrypted. That must not affect whether","+     * the certificate file is found to hold the certificate chain. The certificate file is the certificate, the","+     * certificate of a CA and the encrypted key.","+     */","+    @Test","+    public void testHostRSAPemWithChainAndEncryptedKeyAndChainFile() throws Exception {","+        doTestHostRSAPemWithChainAndEncryptedKeyAndChainFile(false);","+    }","+","+","+    @Test","+    public void testHostRSAPemWithChainAndEncryptedKeyAndChainFileWithPasswordFile() throws Exception {","+        doTestHostRSAPemWithChainAndEncryptedKeyAndChainFile(true);","+    }","+","+","+    private void doTestHostRSAPemWithChainAndEncryptedKeyAndChainFile(boolean passwordFile) throws Exception {","+        Assume.assumeTrue(\"Only needs to be run once for each implementation\", storeType == StoreType.PEM);","+","+        SSLHostConfig sslHostConfig = getSSLHostConfig();","+        SSLHostConfigCertificate certificate = new SSLHostConfigCertificate(sslHostConfig, Type.RSA);","+        certificate.setCertificateFile(","+                TesterSupport.createLocalhostRsaCertCaAndEncryptedKeyPem(TesterSupport.JKS_PASS).getAbsolutePath());","+        if (pas