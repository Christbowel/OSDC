{"id":"4b5bf22ef4e8aabfaeb436317d132614b7255af7","axis":"silent","repo":"tensorflow/tensorflow","sha":"4b5bf22ef4e8aabfaeb436317d132614b7255af7","parsed":{"files":[{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/concat_fusion.hlo","lines":["@@ -1,6 +1,11 @@"," // RUN: fusion_to_triton %s | FileCheck %s"," // RUN: triton_test_correctness %s"," ","+// Verifies that elementwise producers (`abs`, `negate`) are emitted inside","+// their respective `scf.if` branches of a 3-way `concatenate`, and that tile","+// constraints narrow each branch's operand offset indexing domain to its active","+// tiles (`pid in [0, 3]` for `p0`, `pid in [4, 7]` for `p1`, and folded","+// constant `0` for `pid = 8` on `p2`)."," fusion {","   p0 = s32[128] parameter(0)","   p1 = s32[128] parameter(1)","@@ -10,7 +15,8 @@ fusion {","   ROOT concatenate = s32[281] concatenate(abs0, neg1, p2), dimensions={0}"," }"," // CHECK-DAG: #[[$ATTR_0:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32), domain: pid in [0, 8]\">","-// CHECK-DAG: #[[$ATTR_1:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32 - 128), domain: pid in [0, 8]\">","+// CHECK-DAG: #[[$ATTR_1:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32), domain: pid in [0, 3]\">","+// CHECK-DAG: #[[$ATTR_2:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32 - 128), domain: pid in [4, 7]\">"," "," // CHECK:       xtile.entry_func"," // CHECK-SAME:  %[[ARG0:[A-Za-z0-9]+]]: memref<128xi32>,","@@ -27,13 +33,14 @@ fusion {"," // CHECK:       %[[OFFSET:.*]] = xla.apply_indexing #[[$ATTR_0]](%[[PID]])"," // CHECK:       %[[CMPI_0:.*]] = arith.cmpi slt, %[[OFFSET]], %[[C128]] : index"," // CHECK:       %[[IF_0:.*]] = scf.if %[[CMPI_0]] -> (tensor<32xi32>) {","-// CHECK:         %[[EXTRACT_0:.*]] = xtile.extract %[[ARG0]][%[[OFFSET]]] [32] [1] : memref<128xi32> -> tensor<32xi32>","+// CHECK:         %[[OFFSET_1:.*]] = xla.apply_indexing #[[$ATTR_1]](%[[PID]])","+// CHECK:         %[[EXTRACT_0:.*]] = xtile.extract %[[ARG0]][%[[OFFSET_1]]] [32] [1] : memref<128xi32> -> tensor<32xi32>"," // CHECK:         %[[ABSI_0:.*]] = math.absi %[[EXTRACT_0]] : tensor<32xi32>"," // CHECK:         scf.yield %[[ABSI_0]] : tensor<32xi32>"," // CHECK:       } else {"," // CHECK:         %[[CMPI_1:.*]] = arith.cmpi slt, %[[OFFSET]], %[[C256]] : index"," // CHECK:         %[[IF_1:.*]] = scf.if %[[CMPI_1]] -> (tensor<32xi32>) {","-// CHECK:           %[[OFFSET_2:.*]] = xla.apply_indexing #[[$ATTR_1]](%[[PID]])","+// CHECK:           %[[OFFSET_2:.*]] = xla.apply_indexing #[[$ATTR_2]](%[[PID]])"," // CHECK:           %[[EXTRACT_1:.*]] = xtile.extract %[[ARG1]][%[[OFFSET_2]]] [32] [1] : memref<128xi32> -> tensor<32xi32>"," // CHECK:           %[[SUBI_0:.*]] = arith.subi %[[TC0]], %[[EXTRACT_1]] : tensor<32xi32>"," // CHECK:           scf.yield %[[SUBI_0]] : tensor<32xi32>"],"additions":10,"deletions":3,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/concat_pred.hlo","lines":["@@ -1,6 +1,10 @@"," // RUN: fusion_to_triton %s | FileCheck %s"," // RUN: triton_test_correctness %s"," ","+// Verifies `pred` `concatenate` lowering (`i8` memref loads converted to `i1`","+// inside each `scf.if` branch and zero-extended back to `i8` before store),","+// with branch-specific tile constraints narrowing operand offset domains (`pid","+// in [0, 3]`, `pid in [4, 7]`, and constant `0` for `pid = 8`)."," fusion {","   p0 = pred[128] parameter(0)","   p1 = pred[128] parameter(1)","@@ -8,7 +12,8 @@ fusion {","   ROOT concatenate = pred[281] concatenate(p0, p1, p2), dimensions={0}"," }"," // CHECK-DAG: #[[$MAP0:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32), domain: pid in [0, 8]\">","-// CHECK-DAG: #[[$MAP1:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32 - 128), domain: pid in [0, 8]\">","+// CHECK-DAG: #[[$MAP1:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32), domain: pid in [0, 3]\">","+// CHECK-DAG: #[[$MAP2:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32 - 128), domain: pid in [4, 7]\">"," "," // CHECK:       xtile.entry_func"," // CHECK-SAME:  %[[ARG0:[A-Za-z0-9]+]]: memref<128xi8>,","@@ -25,13 +30,14 @@ fusion {"," // CHECK:       %[[OFFSET:.*]] = xla.apply_indexing #[[$MAP0]](%[[PID]])"," // CHECK:       %[[CMPI_0:.*]] = arith.cmpi slt, %[[OFFSET]], %[[C128]] : index"," // CHECK:       %[[IF_0:.*]] = scf.if %[[CMPI_0]] -> (tensor<32xi1>) {","-// CHECK:         %[[EXTRACT_0:.*]] = xtile.extract %[[ARG0]][%[[OFFSET]]] [32] [1] : memref<128xi8> -> tensor<32xi8>","+// CHECK:         %[[OFFSET_1:.*]] = xla.apply_indexing #[[$MAP1]](%[[PID]])","+// CHECK:         %[[EXTRACT_0:.*]] = xtile.extract %[[ARG0]][%[[OFFSET_1]]] [32] [1] : memref<128xi8> -> tensor<32xi8>"," // CHECK:         %[[CMPI_1:.*]] = arith.cmpi ne, %[[EXTRACT_0]], %[[CST]] : tensor<32xi8>"," // CHECK:         scf.yield %[[CMPI_1]] : tensor<32xi1>"," // CHECK:       } else {"," // CHECK:         %[[CMPI_2:.*]] = arith.cmpi slt, %[[OFFSET]], %[[C256]] : index"," // CHECK:         %[[IF_1:.*]] = scf.if %[[CMPI_2]] -> (tensor<32xi1>) {","-// CHECK:           %[[OFFSET_2:.*]] = xla.apply_indexing #[[$MAP1]](%[[PID]])","+// CHECK:           %[[OFFSET_2:.*]] = xla.apply_indexing #[[$MAP2]](%[[PID]])"," // CHECK:           %[[EXTRACT_1:.*]] = xtile.extract %[[ARG1]][%[[OFFSET_2]]] [32] [1] : memref<128xi8> -> tensor<32xi8>"," // CHECK:           %[[CMPI_3:.*]] = arith.cmpi ne, %[[EXTRACT_1]], %[[CST]] : tensor<32xi8>"," // CHECK:           scf.yield %[[CMPI_3]] : tensor<32xi1>"],"additions":9,"deletions":3,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/concat_simplify_offset.hlo","lines":["@@ -2,7 +2,9 @@"," // RUN: triton_test_correctness %s"," "," // Both branches of concat access whole second dimension of parameters and we","-// can simplify offset of it to 0 constant.","+// can simplify offset of it to 0 constant. Propagating branch-specific tile","+// constraints produces distinct row-offset indexing maps (`#indexing_map1` and","+// `#indexing_map2`) restricted to each branch's active tiles."," "," // CHECK:      xtile.entry_func @triton_fn"," // CHECK:        %[[C0:.*]] = arith.constant 0 : index","@@ -10,7 +12,7 @@"," // CHECK:          %[[ROW_0:.*]] = xla.apply_indexing #indexing_map1(%arg3)"," // CHECK:          xtile.extract %arg0[%[[ROW_0]], %[[C0]]] [16, 128] [1, 1]"," // CHECK:        } else {","-// CHECK:          %[[ROW_1:.*]] = xla.apply_indexing #indexing_map1(%arg3)","+// CHECK:          %[[ROW_1:.*]] = xla.apply_indexing #indexing_map2(%arg3)"," // CHECK:          xtile.extract %arg1[%[[ROW_1]], %[[C0]]] [16, 128] [1, 1]"," "," fusion {"],"additions":4,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/concat_unit_tile_dim.hlo","lines":["@@ -0,0 +1,51 @@","+// RUN: fusion_to_triton %s | FileCheck %s","+// RUN: triton_test_correctness %s","+","+// Verifies that with a unit tile size along the concat dimension (`[32, 1]`,","+// `pid in [0, 15]`), the first branch's identity offset map `(pid) -> (pid)`","+// with narrowed domain `pid in [0, 7]` is preserved as an `xla.apply_indexing`","+// carrying `{xla.range = [0 : index, 7 : index]}` (rather than folding to bare","+// `%pid`), allowing downstream lowering to prove the `memref<32x8xf32>` load is","+// in-bounds and elide its mask.","+fusion {","+  p0 = f32[32,8] parameter(0)","+  p1 = f32[32,8] parameter(1)","+  ROOT concatenate = f32[32,16] concatenate(p0, p1), dimensions={1}","+}","+// CHECK-DAG: #[[$LHS_MAP:.+]] = #xla.indexing_map<\"(pid) -> (pid), domain: pid in [0, 7]\">","+// CHECK-DAG: #[[$RHS_MAP:.+]] = #xla.indexing_map<\"(pid) -> (pid - 8), domain: pid in [8, 15]\">","+","+// CHECK:       xtile.entry_func","+// CHECK-SAME:  %[[ARG0:[A-Za-z0-9]+]]: memref<32x8xf32>,","+// CHECK-SAME:  %[[ARG1:[A-Za-z0-9]+]]: memref<32x8xf32>,","+// CHECK-SAME:  %[[ARG2:[A-Za-z0-9]+]]: memref<32x16xf32>,","+// CHECK-SAME:  %[[PID:[A-Za-z0-9]+]]: index {xla.range = [0 : index, 15 : index]}","+","+// CHECK-DAG:   %[[C0:.*]] = arith.constant 0 : index","+// CHECK-DAG:   %[[C8:.*]] = arith.constant 8 : index","+","+// CHECK:       %[[CMPI:.*]] = arith.cmpi slt, %[[PID]], %[[C8]] : index","+// CHECK:       %[[IF:.*]] = scf.if %[[CMPI]] -> (tensor<32x1xf32>) {","+// CHECK:         %[[LHS_COL:.*]] = xla.apply_indexing #[[$LHS_MAP]](%[[PID]]) {xla.range = [0 : index, 7 : index]}","+// CHECK:         %[[EXTRACT_0:.*]] = xtile.extract %[[ARG0]][%[[C0]], %[[LHS_COL]]] [32, 1] [1, 1] : memref<32x8xf32> -> tensor<32x1xf32>","+// CHECK:         scf.yield %[[EXTRACT_0]] : tensor<32x1xf32>","+// CHECK:       } else {","+// CHECK:         %[[RHS_COL:.*]] = xla.apply_indexing #[[$RHS_MAP]](%[[PID]])","+// CHECK:         %[[EXTRACT_1:.*]] = xtile.extract %[[ARG1]][%[[C0]], %[[RHS_COL]]] [32, 1] [1, 1] : memref<32x8xf32> -> tensor<32x1xf32>","+// CHECK:         scf.yield %[[EXTRACT_1]] : tensor<32x1xf32>","+// CHECK:       }","+// CHECK:       xtile.insert %[[IF]] into %[[ARG2]][%[[C0]], %[[PID]]] [32, 1] [1, 1] : tensor<32x1xf32> -> memref<32x16xf32>","+","+ENTRY main {","+  p0 = f32[32,8] parameter(0)","+  p1 = f32[32,8] parameter(1)","+  ROOT fusion = f32[32,16] fusion(p0, p1), kind=kCustom,","+    calls=fusion, backend_config={","+    \"fusion_backend_config\":{","+      \"kind\":\"__triton_nested_gemm_fusion\",","+      \"block_level_fusion_config\":{","+        \"output_tiles\":[{\"sizes\":[\"32\",\"1\"]}],","+        \"num_warps\":\"1\",","+        \"num_ctas\":\"1\",","+        \"num_stages\":\"1\"}}}","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/pad_of_concat.hlo","lines":["@@ -0,0 +1,60 @@","+// RUN: fusion_to_triton %s | FileCheck %s","+// RUN: triton_test_correctness %s","+","+// Verifies that when `pad` evaluates `concatenate` on high-padding tiles","+// (tiles 4..7: offset >= 128 for concat size 128), `concatenate` guards the","+// last operand's branch with `offset < 128` and yields a zero tile for","+// out-of-bounds tiles, while narrowing the operand indexing domains to active","+// tiles (`pid in [0, 1]` and `pid in [2, 3]`).","+fusion {","+  p0 = f32[64] parameter(0)","+  p1 = f32[64] parameter(1)","+  concat = f32[128] concatenate(p0, p1), dimensions={0}","+  c0 = f32[] constant(42.0)","+  ROOT pad = f32[256] pad(concat, c0), padding=0_128","+}","+// CHECK-DAG: #[[$OUT_MAP:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32), domain: pid in [0, 7]\">","+// CHECK-DAG: #[[$LHS_MAP:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32), domain: pid in [0, 1]\">","+// CHECK-DAG: #[[$RHS_MAP:.+]] = #xla.indexing_map<\"(pid) -> (pid * 32 - 64), domain: pid in [2, 3]\">","+","+// CHECK:       xtile.entry_func","+// CHECK-SAME:  %[[ARG0:[A-Za-z0-9]+]]: memref<64xf32>,","+// CHECK-SAME:  %[[ARG1:[A-Za-z0-9]+]]: memref<64xf32>,","+// CHECK-SAME:  %[[ARG2:[A-Za-z0-9]+]]: memref<256xf32>,","+// CHECK-SAME:  %[[PID:[A-Za-z0-9]+]]: index","+","+// CHECK-DAG:   %[[C64:.*]] = arith.constant 64 : index","+// CHECK-DAG:   %[[C128:.*]] = arith.constant 128 : index","+// CHECK-DAG:   %[[ZERO_TILE:.*]] = arith.constant dense<0.000000e+00> : tensor<32xf32>","+","+// CHECK:       %[[OFFSET:.*]] = xla.apply_indexing #[[$OUT_MAP]](%[[PID]])","+// CHECK:       %[[CMPI_0:.*]] = arith.cmpi slt, %[[OFFSET]], %[[C64]] : index","+// CHECK:       %[[IF_0:.*]] = scf.if %[[CMPI_0]] -> (tensor<32xf32>) {","+// CHECK:         %[[LHS_OFFSET:.*]] = xla.apply_indexing #[[$LHS_MAP]](%[[PID]])","+// CHECK:         %[[EXTRACT_0:.*]] = xtile.extract %[[ARG0]][%[[LHS_OFFSET]]] [32] [1] : memref<64xf32> -> tensor<32xf32>","+// CHECK:         scf.yield %[[EXTRACT_0]] : tensor<32xf32>","+// CHECK:       } else {","+// CHECK:         %[[CMPI_1:.*]] = arith.cmpi slt, %[[OFFSET]], %[[C128]] : index","+// CHECK:         %[[IF_1:.*]] = scf.if %[[CMPI_1]] -> (tensor<32xf32>) {","+// CHECK:           %[[RHS_OFFSET:.*]] = xla.apply_indexing #[[$RHS_MAP]](%[[PID]])","+// CHECK:           %[[EXTRACT_1:.*]] = xtile.extract %[[ARG1]][%[[RHS_OFFSET]]] [32] [1] : memref<64xf32> -> tensor<32xf32>","+// CHECK:           scf.yield %[[EXTRACT_1]] : tensor<32xf32>","+// CHECK:         } else {","+// CHECK:           scf.yield %[[ZERO_TILE]] : tensor<32xf32>","+// CHECK:         }","+// CHECK:         scf.yield %[[IF_1]] : tensor<32xf32>","+// CHECK:       }","+","+ENTRY main {","+  p0 = f32[64] parameter(0)","+  p1 = f32[64] parameter(1)","+  ROOT fusion = f32[256] fusion(p0, p1), kind=kCustom,","+    calls=fusion, backend_config={","+    \"fusion_backend_config\":{","+      \"kind\":\"__triton_nested_gemm_fusion\",","+      \"block_level_fusion_config\":{","+        \"output_tiles\":[{\"sizes\":[\"32\"]}],","+        \"num_warps\":\"1\",","+        \"num_ctas\":\"1\",","+        \"num_stages\":\"1\"}}}","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/pad_of_concat_unaligned.hlo","lines":["@@ -0,0 +1,38 @@","+// RUN: fusion_to_triton %s | FileCheck %s","+// RUN: triton_test_correctness %s","+","+// Verifies that a tile straddling `concat_dim_size` (tile 3: [96, 128) for","+// concat size 114) still enters the last operand's branch (96 < 114), while","+// pure high-padding tiles (tiles 4..7: offset >= 114) yield a zero tile.","+fusion {","+  p0 = f32[64] parameter(0)","+  p1 = f32[50] parameter(1)","+  concat = f32[114] concatenate(p0, p1), dimensions={0}","+  c0 = f32[] constant(-7.0)","+  ROOT pad = f32[256] pad(concat, c0), padding=0_142","+}","+","+// CHECK:       %[[C114:.*]] = arith.constant 114 : index","+// CHECK:       scf.if","+// CHECK:       } else {","+// CHECK:         %[[CMPI_1:.*]] = arith.cmpi slt, %{{.*}}, %[[C114]] : index","+// CHECK:         scf.if %[[CMPI_1]] -> (tensor<32xf32>) {","+// CHECK:           xtile.extract %{{.*}}[{{.*}}] [32] [1] : memref<50xf32> -> tensor<32xf32>","+// CHECK:         } else {","+// CHECK:           scf.yield %{{.*}} : tensor<32xf32>","+// CHECK:         }","+// CHECK:       }","+","+ENTRY main {","+  p0 = f32[64] parameter(0)","+  p1 = f32[50] parameter(1)","+  ROOT fusion = f32[256] fusion(p0, p1), kind=kCustom,","+    calls=fusion, backend_config={","+    \"fusion_backend_config\":{","+      \"kind\":\"__triton_nested_gemm_fusion\",","+      \"block_level_fusion_config\":{","+        \"output_tiles\":[{\"sizes\":[\"32\"]}],","+        \"num_warps\":\"1\",","+        \"num_ctas\":\"1\",","+        \"num_stages\":\"1\"}}}","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/codegen/xtile/codegen/emitter_helpers.cc","lines":["@@ -78,7 +78,6 @@ limitations under the License."," #include \"xla/stream_executor/device_description.h\""," #include \"xla/types.h\""," #include \"xla/util.h\"","-#include \"xla/xla.pb.h\""," #include \"xla/xla_data.pb.h\""," "," namespace xla::xtile {","@@ -424,7 +423,8 @@ Value EmitClampedRTVar(mlir::ImplicitLocOpBuilder& b,"," "," // Evaluates tiling parameters for the given affine expressions, e.g. offsets."," absl::StatusOr<SmallVector<Value>> EmitterContext::EvaluateTilingParameters(","-    ArrayRef<SymbolicExpr> exprs) {","+    ArrayRef<SymbolicExpr> exprs,","+    ArrayRef<std::pair<SymbolicExpr, Interval>> tile_constraints) {","   // We expect expressions to use:","   // - some parallel and sequential dimensions of tiling space d0, d1, ..","   // - some runtime variables s0, s1, .., represented as symbols.","@@ -438,8 +438,14 @@ absl::StatusOr<SmallVector<Value>> EmitterContext::EvaluateTilingParameters(","   const gpu::TilingSpace& tiling_space = tiled_computation_.tiling_space();","   int64_t num_dimensions = tiling_space.num_dimensions();","   int64_t num_parallel_dimensions = tiling_space.num_parallel_dimensions();","-  // Get all dimension and symbol IDs from all of the expressions.","-  UsedParameters used_parameters = GetUsedParameters(exprs, num_dimensions);","+  // Get all dimension and symbol IDs from all of the expressions and","+  // constraints.","+  SmallVector<SymbolicExpr> al