chive = crate_archive(published, \"0.1.0\");","+        let response = app","+            .clone()","+            .oneshot(publish_request(","+                Some(&token),","+                publish_body(&metadata(published, \"0.1.0\"), &archive),","+            ))","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::OK);","+        let other = aliases","+            .into_iter()","+            .find(|alias| *alias != published)","+            .unwrap();","+        let alternate_case = published.to_ascii_uppercase();","+        for rejected in [other, alternate_case.as_str()] {","+            let response = app","+                .clone()","+                .oneshot(publish_request(","+                    Some(&token),","+                    publish_body(&metadata(rejected, \"0.2.0\"), &crate_archive(rejected, \"0.2.0\")),","+                ))","+                .await","+                .unwrap();","+            assert_eq!(response.status(), StatusCode::BAD_REQUEST);","+            let error: Value =","+                serde_json::from_slice(&body_bytes(response.into_body()).await).unwrap();","+            assert!(","+                error[\"errors\"][0][\"detail\"]","+                    .as_str()","+                    .unwrap()","+                    .contains(published),","+            );","+        }","+        for name in aliases {","+            let response = app","+                .clone()","+                .oneshot(","+                    Request::get(format!(\"/cargo/index/{}\", pnpr_cargo::sparse_index_path(name)))","+                        .body(Body::empty())","+                        .unwrap(),","+                )","+                .await","+                .unwrap();","+            assert_eq!(response.status(), StatusCode::OK);","+            let index = String::from_utf8(body_bytes(response.into_body()).await).unwrap();","+            assert_eq!(index.lines().count(), 1);","+            let entry: Value = serde_json::from_str(index.lines().next().unwrap()).unwrap();","+            assert_eq!(entry[\"name\"], published);","+            let response = app","+                .clone()","+                .oneshot(","+                    Request::get(format!(\"/cargo/api/v1/crates/{name}/0.1.0/download\"))","+                        .body(Body::empty())","+                        .unwrap(),","+                )","+                .await","+                .unwrap();","+            assert_eq!(response.status(), StatusCode::OK);","+            assert_eq!(body_bytes(response.into_body()).await, archive);","+        }","+        for query in [\"demo\", aliases[0], aliases[1]] {","+            let response = app","+                .clone()","+                .oneshot(","+                    Request::get(format!(\"/cargo/api/v1/crates?q={query}\"))","+                        .body(Body::empty())","+                        .unwrap(),","+                )","+                .await","+                .unwrap();","+            assert_eq!(response.status(), StatusCode::OK);","+            let result: Value =","+                serde_json::from_slice(&body_bytes(response.into_body()).await).unwrap();","+            assert_eq!(result[\"meta\"][\"total\"], 1);","+            assert_eq!(result[\"crates\"][0][\"name\"], published);","+        }","+        upstream_requests.assert_async().await;","+    }","+}","+","+#[tokio::test]","+async fn upstream_index_cache_keeps_separator_spellings_separate() {","+    for names in [[\"demo_crate\", \"demo-crate\"], [\"demo-crate\", \"demo_crate\"]] {","+        let mut upstream = mockito::Server::new_async().await;","+        let config_mock = upstream","+            .mock(\"GET\", \"/config.json\")","+            .with_body(","+                json!({\"dl\": format!(\"{}/dl/{{crate}}/{{version}}\", upstream.url())}).to_string(),","+            )","+            .expect(1)","+            .create_async()","+            .await;","+        l