]","+;   add sp, sp, #0x20","+;   ldp x29, x30, [sp], #0x10","+;   ret","+"],"additions":40,"deletions":0,"truncated":false},{"path":"cranelift/filetests/filetests/isa/x64/stackslot-impl-limits.clif","lines":["@@ -0,0 +1,39 @@","+; Stack slots and `stack_addr` offsets that can't fit in a frame (limited to","+; 1 GiB) fail with an implementation-limit error rather than overflowing the","+; frame-size arithmetic or panicking during lowering.","+test compile expect-fail","+target x86_64","+","+; A slot so large that the frame size would overflow a u32.","+function %huge_slot() -> i64 {","+    ss0 = explicit_slot 4294967288","+block0:","+    v0 = stack_addr.i64 ss0","+    return v0","+}","+","+; A slot just over the frame size limit.","+function %slot_over_limit() -> i64 {","+    ss0 = explicit_slot 1073741832","+block0:","+    v0 = stack_addr.i64 ss0","+    return v0","+}","+","+; A `stack_addr` offset beyond the frame size limit.","+function %large_offset() -> i64 {","+    ss0 = explicit_slot 8","+    ss1 = explicit_slot 8","+block0:","+    v0 = stack_addr.i64 ss1+2147483647","+    return v0","+}","+","+; A negative `stack_addr` offset.","+function %negative_offset() -> i64 {","+    ss0 = explicit_slot 8","+    ss1 = explicit_slot 8","+block0:","+    v0 = stack_addr.i64 ss1-8","+    return v0","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"cranelift/filetests/filetests/isa/x64/stackslot-large-load-offset.clif","lines":["@@ -0,0 +1,40 @@","+; A load whose offset from a `stack_addr` is too large to fold into a","+; stack-slot address mode: the slot's address is computed in a register and","+; the offset applied to the load instead.","+test compile precise-output","+target x86_64","+","+function %f() -> i64 {","+    ss0 = explicit_slot 16","+    ss1 = explicit_slot 16","+block0:","+    v0 = stack_addr.i64 ss1","+    v1 = load.i64 notrap v0+0x7ffffffc","+    return v1","+}","+","+; VCode:","+;   pushq %rbp","+;   movq %rsp, %rbp","+;   subq $0x20, %rsp","+