rspack-test/newCacheCases/make/rebuild-module/loader.mjs","lines":["@@ -0,0 +1,5 @@","+export default function () {","+  const options = this.getOptions();","+  options.buildCount++;","+  return `export default ${JSON.stringify(options.value())};`;","+}"],"additions":5,"deletions":0,"truncated":false},{"path":"tests/rspack-test/newCacheCases/make/rebuild-module/rspack.config.ts","lines":["@@ -0,0 +1,84 @@","+import { defineConfig, definePlugin } from '@rspack/cli';","+import { NormalModule } from '@rspack/core';","+","+let compilerIndex = 0;","+let rebuilding = false;","+const loaderOptions = {","+  buildCount: 0,","+  value: () =>","+    rebuilding ? `rebuilt-${compilerIndex}` : `initial-${compilerIndex}`,","+};","+","+export default defineConfig({","+  module: {","+    rules: [","+      {","+        test: /value\\.js$/,","+        use: [","+          {","+            loader: './loader.mjs',","+            options: loaderOptions,","+          },","+        ],","+      },","+    ],","+  },","+  plugins: [","+    definePlugin((compiler) => {","+      let rebuilt = false;","+      let stillValid = false;","+","+      compiler.hooks.compilation.tap(","+        'RebuildModuleCacheTest',","+        (compilation) => {","+          compilation.hooks.stillValidModule.tap(","+            'RebuildModuleCacheTest',","+            (module) => {","+              if (","+                module instanceof NormalModule &&","+                module.resource.endsWith('value.js')","+              ) {","+                stillValid = true;","+              }","+            },","+          );","+        },","+      );","+","+      compiler.hooks.finishMake.tapAsync(","+        'RebuildModuleCacheTest',","+        (compilation, callback) => {","+          if (rebuilt) {","+            return callback();","+          }","+          rebuilt = true;","+          const valueModule = Array.from(compilation.modules).find(","+            (module): module is NormalModule =>","+              module instanceof NormalModule &&","+              module.resource.endsWith('value.js'),","+          );","+          if (!valueModule) {","+            return callback(new Error('value.js module not found'));","+          }","+          rebuilding = true;","+          compilation.rebuildModule(valueModule, (error) => {","+            rebuilding = false;","+            callback(error);","+          });","+        },","+      );","+","+      compiler.hooks.done.tap('RebuildModuleCacheTest', () => {","+        if (compilerIndex === 0) {","+          expect(stillValid).toBe(false);","+          expect(loaderOptions.buildCount).toBe(2);","+        } else {","+          expect(stillValid).toBe(true);","+          expect(loaderOptions.buildCount).toBe(1);","+        }","+        compilerIndex++;","+        loaderOptions.buildCount = 0;","+      });","+    }),","+  ],","+});"],"additions":84,"deletions":0,"truncated":false},{"path":"tests/rspack-test/newCacheCases/make/rebuild-module/value.js","lines":["@@ -0,0 +1 @@","+export default 'original';",""],"additions":1,"deletions":0,"truncated":false}],"additions":236,"deletions":21,"truncated":false,"file_count":21},"error":null,"fetched_at":"2026-11-23T19:31:06.717032+00:00"}