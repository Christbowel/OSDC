e their own. If yours still uses a previously published default, set a unique value before upgrading, or set `ALLOW_INSECURE_DEFAULT_SECRETS=true` to keep booting while you migrate."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/scope-deployment-background-worker-lookup.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Background-worker deployment lookups are now scoped to the authenticated environment."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/scope-github-app-update-to-org.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Updating a GitHub App installation from the callback flow is now scoped to your own organization, so an installation ID belonging to another organization can no longer be used to refresh that organization's installation record. The GitHub App installation session is also now single-use, so completing an installation callback invalidates its state and it can no longer be replayed."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/scope-schedule-and-env-var-writes.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Scope schedule and environment-variable writes to the caller's project and environment"],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/secure-compute-snapshot-callbacks.md","lines":["@@ -0,0 +1,6 @@","+---","+area: supervisor","+type: fix","+---","+","+Reject compute snapshot callbacks that do not match the snapshot request that created them."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/session-out-stream-private-auth.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Require secret-key authentication to initialize the session out (agent→client) stream, matching the append route."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/tighten-realtime-and-trace-sync.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Live run and trace subscriptions now validate their identifiers more strictly and only return data from your own organization."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/tsql-window-function-allowlist.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Window-function names in the query compiler are now validated against the allowlist, matching how other function calls are handled."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/workload-token-supervisor.md","lines":["@@ -0,0 +1,6 @@","+---","+area: supervisor","+type: fix","+---","+","+Authenticate run controllers to the platform with a signed, deployment-scoped token."],"additions":6,"deletions":0,"truncated":false},{"path":".server-changes/workload-token-webapp.md","lines":["@@ -0,0 +1,6 @@","+---","+area: webapp","+type: fix","+---","+","+Verify that worker actions (starting, completing, and continuing a run, and reading its snapshots) target a run belonging to the caller's environment."],"additions":6,"deletions":0,"truncated":false},{"path":"apps/supervisor/.env.example","lines":["@@ -1,8 +1,8 @@"," # This needs to match the token of the worker group you want to connect to"," TRIGGER_WORKER_TOKEN="," ","-# This needs to match the MANAGED_WORKER_SECRET env var on the webapp","-MANAGED_WORKER_SECRET=managed-secret","+# Must match the webapp's MANAGED_WORKER_SECRET. Generate with: openssl rand -hex 16","+MANAGED_WORKER_SECRET="," "," # Point this at the webapp in prod"," TRIGGER_API_URL=http://localhost:3030"],"additions":2,"deletions":2,"truncated":false},{"path":"apps/supervisor/src/env.ts","lines":["@@ -14,8 +14,17 @@ export const Env = z"," ","     // Required settings","     TRIGGER_API_URL: z.string().url(),","-    TRIGGER_WORKER_TOKEN: z.string(), // accepts file:// path to read from a file","+    TRIGGER_WORKER_TOKEN: z.string().min(1), // accept