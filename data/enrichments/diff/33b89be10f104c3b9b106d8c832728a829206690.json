","+        let DebugRunResult::Watchpoint(hit) = event else {","+            panic!(\"expected a watchpoint, got {event:?}\");","+        };","+        assert_eq!(","+            hit,","+            WatchpointHit {","+                memory,","+                address: 6,","+                len: 4,","+                value: Some(0x11223344),","+            }","+        );","+        // The event is raised before the write happens.","+        debuggee","+            .with_store(move |store| {","+                assert_eq!(&memory.data(&store)[6..10], &[0, 1, 0, 0]);","+            })","+            .await?;","+","+        let event = debuggee.run().await?;","+        let DebugRunResult::Watchpoint(hit) = event else {","+            panic!(\"expected a watchpoint, got {event:?}\");","+        };","+        assert_eq!(","+            hit,","+            WatchpointHit {","+                memory,","+                address: 0,","+                len: 16,","+                value: None,","+            }","+        );","+        debuggee","+            .with_store(move |mut store| {","+                // The previous write has now happened, but not the","+                // fill.","+                assert_eq!(&memory.data(&store)[6..10], &0x11223344_u32.to_le_bytes());","+                assert_eq!(memory.data(&store)[12], 2);","+                // Stop watching; the rest of execution runs freely.","+                memory.debug_watch(&mut store, 0..16, false).unwrap();","+            })","+            .await?;","+","+        let event = debuggee.run().await?;","+        assert!(matches!(event, DebugRunResult::Finished));","+        debuggee","+            .with_store(move |store| {","+                assert_eq!(&memory.data(&store)[..16], &[0xaa; 16]);","+            })","+            .await?;","+","+        Ok(())","+    }","+","     #[tokio::test]","     #[cfg_attr(miri, ignore)]","     async fn early_finish() -> Result<()> {"],"additions":98,"deletions":1,"truncated":false},{"path":"crates/debugger/wit/world.wit","lines":["@@ -168,6 +168,25 @@ interface debuggee {","     exception(wasm-exception),","     /// An injected call completed with return value(s).","     injected-call-return(list<wasm-value>),","+    /// Wasm is about to write memory watched with","+    /// `memory.add-watchpoint`, pausing execution *before* the write.","+    /// The write happens when execution resumes.","+    watchpoint(watchpoint-hit),","+  }","+","+  /// A guest write to watched bytes of a linear memory.","+  record watchpoint-hit {","+    /// The memory being written.","+    memory: memory,","+    /// The address of the first byte written. This may be below the","+    /// watched range if the write only partially overlaps it.","+    address: u64,","+    /// The number of bytes written, at least one of which is watched.","+    len: u64,","+    /// For a scalar or vector store, the bytes being stored (`len`","+    /// bytes, in memory order). `none` for bulk memory operations","+    /// such as `memory.fill` or `memory.copy`.","+    value: option<list<u8>>,","   }"," ","   resource instance {","@@ -250,6 +269,32 @@ interface debuggee {","     /// Set a u64 (in little endian order) at an address.","     set-u64: func(d: borrow<debuggee>, addr: u64, value: u64) -> result<_, error>;"," ","+    /// Watch guest writes to the `len` bytes starting at `addr`.","+    ///","+    /// Any Wasm store or bulk memory operation that writes at least","+    /// one watched byte pauses execution with a `watchpoint` event","+    /// before the write happens. Only writes can be watched.","+    ///","+    /// Whether a byte is watched is a per-byte property: watching an","+    /// already-watched byte has no further effect, and","+    /// `remove-watchpoint` unwatches every byte in its range,"],"additions":28,"deletions":0,"truncated":false}],"additions":464,"deletions":32,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-05T16:29:40.819387+00:00"}