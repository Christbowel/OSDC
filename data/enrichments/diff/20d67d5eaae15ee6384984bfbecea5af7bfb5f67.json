in value) {","+    const {asset} = value","+    if (typeof asset === 'object' && asset !== null && '_ref' in asset) {","+      return typeof asset._ref === 'string' ? asset._ref : undefined","+    }","+  }","+  return undefined","+}","+","+async function fetchAssetFileType(","+  assetId: string,","+  context: ValidationContext,","+): Promise<AssetFileType | null> {","+  const cached = resolvedFileTypes.get(assetId)","+  if (cached) return cached","+","+  const fileType = await context","+    .getClient({apiVersion: DEFAULT_API_VERSION})","+    .fetch<AssetFileType | null>(","+      ASSET_FILE_TYPE_QUERY,","+      {id: assetId},","+      {signal: context.signal, tag: 'validation.asset-accept'},","+    )","+  if (fileType) resolvedFileTypes.set(assetId, fileType)","+  return fileType","+}","+","+/** @internal */","+export function createAssetAcceptValidator(","+  accept: string,","+  assetType: AcceptedAssetType,","+): CustomValidator {","+  return async (value, context) => {","+    const assetId = getAssetId(value)","+    if (assetId === undefined) return true","+","+    const fileType = await fetchAssetFileType(assetId, context)","+    if (fileType === null || isUnknownFileType(fileType) || assetMatchesAccept(fileType, accept)) {","+      return true","+    }","+","+    return {","+      code: validationMarkerCodes.assetNotAccepted,","+      details: {accept, mimeType: fileType.mimeType, extension: fileType.extension},","+      message: context.i18n.t('validation:object.asset-not-accepted', {","+        context: assetType,","+        mimeType: fileType.mimeType ?? fileType.extension,","+      }),","+    }","+  }","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"packages/@sanity/validation/test/infer.test.ts","lines":["@@ -4,7 +4,7 @@ import {Schema as SchemaBuilder} from '@sanity/schema'"," import {builtinTypes} from '@sanity/schema/_internal'"," import {type ObjectSchemaType, type Rule, type SanityDocument} from '@sanity/types'"," import has from 'lod