ng_if = \"Option::is_none\")]","+    pub code: Option<i64>,","+    /// The HTTP status, when the endpoint returned an HTTP error.","+    #[serde(skip_serializing_if = \"Option::is_none\")]","+    pub status: Option<u16>,","+}","+","+impl RpcFailure {","+    /// Returns the machine-readable kind of this failure.","+    pub const fn kind(&self) -> &'static str {","+        if self.answered { \"rpc.error\" } else { \"rpc.transport\" }","+    }","+}","+","+/// An endpoint answered without a block that must exist, such as a load-balanced endpoint whose","+/// backend has not seen that block yet.","+#[derive(Debug, thiserror::Error)]","+#[error(\"{0}\")]","+pub struct BlockNotFound(pub String);","+","+/// Classifies the innermost [`TransportError`] in `error`'s chain.","+///","+/// The innermost one is the cause: a retry layer that gives up wraps the last error it got in a","+/// transport error.","+pub fn rpc_failure(error: &(dyn std::error::Error + 'static)) -> Option<RpcFailure> {","+    let error = std::iter::successors(Some(error), |error| error.source())","+        .filter_map(|error| error.downcast_ref::<TransportError>())","+        .last()?;","+    // These fail before a request is sent.","+    if matches!(","+        error,","+        TransportError::LocalUsageError(_)","+            | TransportError::SerError(_)","+            | TransportError::UnsupportedFeature(_)","+    ) {","+        return None;","+    }","+    let code = json_rpc_error_code(error);","+    let status = error.as_transport_err().and_then(|error| error.as_http_error()).map(|e| e.status);","+    let answered =","+        code.is_some() || matches!(error, TransportError::ErrorResp(_) | TransportError::NullResp);","+    Some(RpcFailure { answered, code, status })","+}","+"," /// Constructs a provider using [`try_get_http_provider`]."," ///"," /// # Panics","@@ -668,6 +737,32 @@ mod tests {","         assert!(!is_rpc_method_not_found(&transport_error));","     }"," ","+    #[test]","+    fn gateway_error_code_is_not_a_json_rpc_code() {","+        for body in [","+            r#\"{\"code\":401,\"title\":\"Unauthorized\",\"type\":\"about:blank\",\"status\":401}\"#,","+            r#\"{\"status\":401,\"code\":401,\"message\":\"Unauthorized\"}\"#,","+            r#\"{\"error\":{\"code\":401,\"message\":\"Unauthorized\",\"status\":\"UNAUTHENTICATED\"}}\"#,","+        ] {","+            let error = alloy_transport::TransportErrorKind::http_error(401, body.to_string());","+            let failure = rpc_failure(&error).unwrap();","+            assert_eq!(","+                (failure.kind(), failure.code, failure.status),","+                (\"rpc.transport\", None, Some(401))","+            );","+        }","+        let error = alloy_transport::TransportErrorKind::http_error(","+            429,","+            r#\"{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32005,\"message\":\"rate limited\"}}\"#","+                .to_string(),","+        );","+        let failure = rpc_failure(&error).unwrap();","+        assert_eq!(","+            (failure.kind(), failure.code, failure.status),","+            (\"rpc.error\", Some(-32005), Some(429))","+        );","+    }","+","     #[test]","     fn can_auto_correct_missing_prefix() {","         let builder = ProviderBuilder::<AnyNetwork>::new(\"localhost:8545\");"],"additions":95,"deletions":0,"truncated":false},{"path":"crates/evm/core/src/backend/error.rs","lines":["@@ -1,5 +1,6 @@"," use alloy_primitives::Address;"," use evm2::registry::HandlerError;","+use foundry_common::provider::{BlockNotFound, RpcFailure, rpc_failure};"," "," pub use foundry_fork_db::{DatabaseError, DatabaseResult};"," ","@@ -82,3 +83,69 @@ pub struct TransactionValidationError {","     /// The evm2 rejection.","     pub error: HandlerError,"," }","+","+/// Returns how an RPC request in `error`'s chain failed, including requests a fork's database","+/// made during execution.","+pub fn rpc_failure_in(error: &(dyn std::error::Error + 'static)) -> Option<RpcFailure> {","+    for error in std::iter::successors(Some(error), |error| error.source()) {","+        if error.is::<BlockNotFound>() {","+            return Some(RpcFailure { answered: true, ..Default::default() });","+        }","+        // These wrappers hide the fork database error from the source chain.","+        let state = error","+            .downcast_ref::<evm2::DatabaseError>()","+            .or_else(|| match error.downcast_ref() {","+                Some(BackendError::State(error)) => Some(error),","+                _ => None,","+            })","+            .or_else(|| match error.downcast_ref() {","+                Some(evm2::ExecutionError::Database(error)) => Some(error),","+                _ => None,","+            });","+        let database = state","+            .and_then(|error| error.downcast_ref::<DatabaseError>())","+            .or_else(|| error.downcast_ref::<DatabaseError>())","+            .or_else(|| match error.downcast_ref() {","+                Some(BackendError::Database(error)) => Some(error),","+                _ => None,","+            });","+        if let Some(database) = database {","+            return match database {","+                DatabaseError::GetAccount(.., error)","+                | DatabaseError::GetStorage(.., error)","+                | DatabaseError::GetFullBlock(_, error)","+                | DatabaseError::AnyRequest(error) => {","+                    Some(rpc_failure((**error).as_ref()).unwrap_or_default())","+                }","+                // Without a transport error, the endpoint answered, such as with no transaction or","+                // no ancestor block.","+                DatabaseError::GetTransaction(_, error) | DatabaseError::GetBlockHash(_, error) => {","+                    Some(","+                        rpc_failure((**error).as_ref())","+                            .unwrap_or(RpcFailure { answered: true, ..Default::default() }),","+                    )","+             