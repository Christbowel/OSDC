re.annotation.NonNull;","+import io.micronaut.core.annotation.Nullable;","+import io.micronaut.validation.validator.constraints.ConstraintValidator;","+import io.micronaut.validation.validator.constraints.ConstraintValidatorContext;","+import jakarta.inject.Singleton;","+","+@Singleton","+public class TableInputValidator implements ConstraintValidator<TableInputValidation, TableInput> {","+    static final Set<Type> ALLOWED_COLUMN_TYPES = EnumSet.of(","+        Type.STRING, Type.INT, Type.FLOAT, Type.BOOL, Type.DATE, Type.DATETIME, Type.TIME, Type.DURATION,","+        Type.EMAIL, Type.URI, Type.SELECT, Type.MULTISELECT","+    );","+","+    @Override","+    public boolean isValid(@Nullable TableInput value, @NonNull AnnotationValue<TableInputValidation> annotationMetadata, @NonNull ConstraintValidatorContext context) {","+        if (value == null) {","+            return true;","+        }","+","+        List<String> violations = fieldViolations(\"columns\", value.getColumns());","+        if (value.getMinRows() != null && value.getMaxRows() != null && value.getMinRows() > value.getMaxRows()) {","+            violations.add(\"`minRows` cannot be greater than `maxRows`\");","+        }","+        if (violations.isEmpty()) {","+            return true;","+        }","+        context.disableDefaultConstraintViolation();","+        violations.forEach(violation -> context.buildConstraintViolationWithTemplate(violation).addConstraintViolation());","+        return false;","+    }","+","+    /**","+     * The rules every typed field of a record must follow: a regular scalar input, resolved against one key of the","+     * record. {@code fieldsName} is the property holding the fields, used in the messages.","+     */","+    static List<String> fieldViolations(String fieldsName, List<Input<?>> fields) {","+        List<String> violations = new ArrayList<>();","+        if (ListUtils.isEmpty(fields)) {","+            violations.add(\"`\" + fieldsName + \"` must declare at least one field\");","+            return violations;","+        }","+","+        Set<String> ids = new HashSet<>();","+        for (Input<?> field : fields) {","+            String id = field.getId();","+            if (id == null) {","+                continue;","+            }","+            if (!ids.add(id)) {","+                violations.add(\"`\" + fieldsName + \"` declares the id `\" + id + \"` more than once\");","+            }","+            if (id.contains(\".\")) {","+                violations.add(\"field `\" + id + \"` id cannot contain a dot\");","+            }","+            if (field.getType() != null && !ALLOWED_COLUMN_TYPES.contains(field.getType())) {","+                violations.add(\"field `\" + id + \"` cannot be of type \" + field.getType());","+            }","+            if (field.getDependsOn() != null) {","+                violations.add(\"field `\" + id + \"` cannot declare `dependsOn`\");","+            }","+            if (field.getDefaults() != null) {","+                violations.add(\"field `\" + id + \"` cannot declare `defaults`\");","+            }","+            if (field.getPrefill() != null) {","+                violations.add(\"field `\" + id + \"` cannot declare `prefill`\");","+            }","+            if (field instanceof SelectInput select && select.getExpression() != null","+                || field instanceof MultiselectInput multiselect && multiselect.getExpression() != null) {","+                violations.add(\"field `\" + id + \"` cannot declare an `expression`\");","+            }","+        }","+        return violations;","+    }","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"core/src/test/java/io/kestra/core/docs/JsonSchemaGeneratorTest.java","lines":["@@ -239,6 +239,7 @@ void flowSchemaExcludesEeOnlyInputTypes() throws URISyntaxException {","             // anyOf branch reaching them by $ref have to go too, or a reusable-inputs input still validates, minus its","             // discrimin