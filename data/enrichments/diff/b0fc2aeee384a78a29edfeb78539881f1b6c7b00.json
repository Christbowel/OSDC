olumns.","+     * Every failing field is reported into {@code violations} with {@code prefix} + the field id in front of the","+     * cause, so a caller can surface all of them at once, and with {@code path} + the field id as its property path","+     * ({@code disks[1].size_gb}), which is where the value sits inside the input.","+     */","+    @SuppressWarnings({ \"unchecked\", \"rawtypes\" })","+    private Map<String, Object> parseRecord(Execution execution, List<Input<?>> fields, Map<?, ?> row, String prefix, String path, Set<ConstraintViolation<?>> violations) {","+        Map<String, Object> record = new LinkedHashMap<>();","+        Set<String> declared = fields.stream().map(Input::getId).collect(Collectors.toSet());","+        row.keySet().stream()","+            .map(String::valueOf)","+            .filter(key -> !declared.contains(key))","+            .forEach(key -> violations.add(violation(prefix + \"`\" + key + \"`: it is not declared\", fields.getFirst(), path + \".\" + key, row.get(key))));","+        for (Input<?> field : fields) {","+            String label = prefix + \"`\" + field.getId() + \"`\";","+            String propertyPath = path + \".\" + field.getId();","+            Object value = row.get(field.getId());","+            if (value instanceof String s && s.isEmpty() && !isTextType(field.getType())) {","+                value = null;","+            }","+            if (value == null) {","+                if (Boolean.TRUE.equals(field.getRequired())) {","+                    violations.add(violation(label + \": missing required value\", field, propertyPath, null));","+                } else {","+                    record.put(field.getId(), null);","+                }","+                continue;","+            }","+            try {","+                Type itemType = field instanceof ItemTypeInterface item ? item.getItemType() : null;","+                Object parsed = parseType(execution, field.getType(), field.getId(), itemType, value, field);","+                ((Input) field).validate(parsed);","+                record.put(field.getId(), parsed);","+            } catch (ConstraintViolationException e) {","+                Object invalid = value;","+                e.getConstraintViolations().forEach(c -> violations.add(violation(label + \": \" + c.getMessage(), field, propertyPath, invalid)));","+            } catch (Exception e) {","+                violations.add(violation(label + \": \" + e.getMessage(), field, propertyPath, value));","+            }","+        }","+        return record;","+    }","+","+    @SuppressWarnings({ \"unchecked\", \"rawtypes\" })","+    private static ConstraintViolation<?> violation(String message, Input<?> input, String propertyPath, Object invalidValue) {","+        return ManualConstraintViolation.of(message, (Input) input, Input.class, propertyPath, invalidValue);","+    }","+","     private static Execution minimalExecution(FlowInterface flow, String executionId, @Nullable List<Label> contributed) {","         return Execution.builder()","             .id(executionId)"],"additions":93,"deletions":3,"truncated":false},{"path":"core/src/main/java/io/kestra/core/validations/TableInputValidation.java","lines":["@@ -0,0 +1,19 @@","+package io.kestra.core.validations;","+","+import java.lang.annotation.Retention;","+import java.lang.annotation.RetentionPolicy;","+","+import io.kestra.core.validations.validator.TableInputValidator;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+@Retention(RetentionPolicy.RUNTIME)","+@Constraint(validatedBy = TableInputValidator.class)","+public @interface TableInputValidation {","+    String message() default \"invalid table input\";","+","+    Class<?>[] groups() default {};","+","+    Class<? extends Payload>[] payload() default {};","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/validations/validator/ArrayInputValidator.java","lines":["