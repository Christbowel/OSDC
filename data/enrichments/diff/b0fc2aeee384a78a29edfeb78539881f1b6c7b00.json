jects, referenced as \" +","+            \"`{{ inputs.myTable[0].myColumn }}`. Columns cannot be of type `TABLE`, `ARRAY`, `FORM`, `FILE`, `SECRET`, \" +","+            \"`JSON`, `ION` or `YAML`, and cannot declare `defaults`, `prefill`, `dependsOn` or an `expression`. \" +","+            \"This input type is only available in the Enterprise Edition.\"","+    )","+    @NotNull","+    @Valid","+    private List<Input<?>> columns;","+","+    @Schema(title = \"Minimum number of rows.\")","+    @Min(0)","+    private Integer minRows;","+","+    @Schema(title = \"Maximum number of rows.\")","+    @Min(1)","+    private Integer maxRows;","+","+    @Override","+    public void validate(List<?> input) throws ConstraintViolationException {","+        if (minRows != null && input.size() < minRows) {","+            throw ManualConstraintViolation.toConstraintViolationException(","+                \"it must have at least `\" + minRows + \"` rows\",","+                this,","+                TableInput.class,","+                getId(),","+                input","+            );","+        }","+","+        if (maxRows != null && input.size() > maxRows) {","+            throw ManualConstraintViolation.toConstraintViolationException(","+                \"it must have at most `\" + maxRows + \"` rows\",","+                this,","+                TableInput.class,","+                getId(),","+                input","+            );","+        }","+    }","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/runners/FlowInputOutput.java","lines":["@@ -32,10 +32,12 @@"," import io.kestra.core.models.flows.input.InputAndValue;"," import io.kestra.core.models.flows.input.ItemTypeInterface;"," import io.kestra.core.models.flows.input.SecretInput;","+import io.kestra.core.models.flows.input.TableInput;"," import io.kestra.core.models.property.Property;"," import io.kestra.core.models.property.PropertyContext;"," import io.kestra.core.models.p