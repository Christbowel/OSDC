"+        filter: {","+            id: \"kind\",","+            key: \"kind\",","+            keyLabel: kindKey.label,","+            comparator: Comparators.EQUALS,","+            comparatorLabel: \"\",","+            value: \"\",","+            valueLabel: \"\",","+        },","+        onUpdate: fn(),","+    },","+} satisfies Meta<typeof FilterEditPopper>","+","+export default meta","+type Story = StoryObj<typeof meta>","+","+export const Standard: Story = {","+    play: async ({canvasElement, args}) => {","+        const canvas = within(canvasElement)","+        await expect(canvas.getByText(kindKey.allDescription!)).toBeVisible()","+        await expect(canvas.queryByText(\"Normal\")).not.toBeInTheDocument()","+        await expect(canvas.queryByText(\"Default\")).not.toBeInTheDocument()","+","+        await userEvent.click(canvas.getByText(\"Playground\"))","+        await waitFor(() => expect(args.onUpdate).toHaveBeenLastCalledWith(expect.objectContaining({value: \"PLAYGROUND\"})))","+        await userEvent.click(canvas.getByText(\"Standard\", {exact: true}))","+        await waitFor(() => expect(args.onUpdate).toHaveBeenLastCalledWith(expect.objectContaining({value: \"\"})))","+    },","+}","+","+export const LegacyNormal: Story = {","+    args: {filter: {...meta.args.filter, value: \"NORMAL\", valueLabel: \"NORMAL\"}},","+    play: async ({canvasElement}) => {","+        await expect(canvasElement.querySelector(\"[data-test=\\\"filter-radio-default\\\"] input\")).toBeChecked()","+    },","+}","+","+export const ExistingPlayground: Story = {","+    args: {filter: {...meta.args.filter, value: \"PLAYGROUND\", valueLabel: \"PLAYGROUND\"}},","+    play: async ({canvasElement}) => {","+        await waitFor(() => expect(canvasElement.querySelector(\"[data-test=\\\"filter-radio-PLAYGROUND\\\"] input\")).toBeChecked())","+    },","+}","+","+export const Hierarchy: Story = {","+    args: {","+        filterKey: {","+            key: \"childFilter\",","+            label: locale.en.filter.childFilter.label,","+            valueType: \"radio\",","+            comparators: [Comparators.EQUALS],","+            valueProvider: async () => [{label: \"Parent\", value: \"MAIN\"}],","+        },","+    },","+}","+","+export const Dark: Story = {","+    globals: {theme: \"dark\"},","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"ui/packages/design-system/src/components/Data/KsDataTable/filter/layout/FilterEditPopper.test.ts","lines":["@@ -10,6 +10,31 @@ import FilterNumber from \"./FilterNumber.vue\""," import FilterComparatorSelect from \"./FilterComparatorSelect.vue\""," import FilterFooter from \"./FilterFooter.vue\""," import {Comparators, type AppliedFilter, type FilterKeyConfig} from \"../utils/filterTypes\"","+import filterLocale from \"../../KsFilter.locale\"","+","+test.each([","+    {allLabel: \"Standard\", expected: \"Standard sélectionné\"},","+    {allLabel: undefined, expected: `${filterLocale.fr.filter.hierarchy.all} sélectionné`},","+])(\"shouldTranslateTheDefaultRadioFooterWithLabel $allLabel\", async ({allLabel, expected}) => {","+    const wrapper = i18nMount(FilterEditPopper, {","+        locales: filterLocale,","+        props: {","+            filter: {id: \"kind\", key: \"kind\", keyLabel: \"Kind\", comparator: Comparators.EQUALS, comparatorLabel: \"\", value: \"\", valueLabel: \"\"},","+            filterKey: {","+                key: \"kind\",","+                label: \"Kind\",","+                valueType: \"radio\",","+                comparators: [Comparators.EQUALS],","+                allLabel,","+                valueProvider: async () => [{label: \"Playground\", value: \"PLAYGROUND\"}],","+            },","+        },","+    })","+    wrapper.vm.$i18n.locale = \"fr\"","+    await flushPromises()","+","+    expect(wrapper.text()).toContain(expected)","+})"," "," const levelKey: FilterKeyConfig = {","     key: \"level\","],"additions":25,"deletions":0,"truncated":false},{"path":"ui/packages/