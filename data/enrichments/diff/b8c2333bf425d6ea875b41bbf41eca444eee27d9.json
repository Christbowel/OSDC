"+    public static Type CallWithArgument<T, TArg>() where T : IOperation => T.WithArgument<TArg>();","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    public static Func<Type> Callback<T>() where T : IOwner => T.Owner;","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    public static Func<Type> CallbackWithArgument<T, TArg>() where T : IOperation => T.WithArgument<TArg>;","+","+    [MethodImpl(MethodImplOptions.AggressiveInlining)]","+    private static Type Forward<T>() where T : IOwner => T.Owner();","+","+    [MethodImpl(MethodImplOptions.AggressiveInlining)]","+    private static Type ForwardWithArgument<T, TArg>() where T : IOperation => T.WithArgument<TArg>();","+","+    [MethodImpl(MethodImplOptions.AggressiveInlining)]","+    private static Func<Type> ForwardCallback<T>() where T : IOwner => T.Owner;","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static void CheckHierarchies<A, B>()","+    {","+        Assert.Equal(typeof(B), Forward<Derived<A, B>>());","+        Assert.Equal(typeof(B), Forward<IInherited<A, B>>());","+        Assert.Equal(typeof(A[]), Forward<INested<A>>());","+        Assert.Equal(typeof(B), Forward<IDiamond<B>>());","+        Assert.Equal(typeof((B, int)), ForwardWithArgument<IInherited<A, B>, int>());","+        Assert.Equal(typeof((B, string)), ForwardWithArgument<IInherited<A, B>, string>());","+        Assert.Equal(typeof(B), ForwardCallback<IInherited<A, B>>()());","+        Assert.Equal(typeof(B), ForwardCallback<IDiamond<B>>()());","+    }","+","+    [Fact]","+    public static void TestEntryPoint()","+    {","+        // #137846: the implementation's argument is string[], not the constrained type's string.","+        Assert.Equal(typeof(string[]), Call<Nested<string>>());","+        Assert.Equal(typeof(object[]), Call<Nested<object>>());","+        Assert.Equal(typeof(string), Call<Direct<string>>());","+        Assert.Equal(typeof(object), Call<Direct<object>>());","+        Assert.Equal(typeof(string), Call<Swapped<object, string>>());","+        Assert.Equal(typeof(object), Call<Swapped<string, object>>());","+        Assert.Equal(typeof(string[]), Callback<Nested<string>>()());","+        Assert.Equal(typeof(object[]), Callback<Nested<object>>()());","+        Assert.Equal(typeof(string), Callback<Swapped<object, string>>()());","+        Assert.Equal(typeof(object), Callback<Swapped<string, object>>()());","+        Assert.Equal(typeof((string[], int)), CallWithArgument<Nested<string>, int>());","+        Assert.Equal(typeof((string, int)), CallWithArgument<Swapped<object, string>, int>());","+        Assert.Equal(typeof((object, string)), CallWithArgument<Swapped<string, object>, string>());","+        Assert.Equal(typeof((string[], int)), CallbackWithArgument<Nested<string>, int>()());","+        Assert.Equal(typeof((string, int)), CallbackWithArgument<Swapped<object, string>, int>()());","+        Assert.Equal(typeof((object, string)), CallbackWithArgument<Swapped<string, object>, string>()());","+        CheckHierarchies<object, string>();","+        CheckHierarchies<string, object>();","+    }","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"src/tests/Loader/classloader/StaticVirtualMethods/Regression/ConstrainedStaticInterfaceContext.csproj","lines":["@@ -0,0 +1,5 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+  <ItemGroup>","+    <Compile Include=\"$(MSBuildThisFileName).cs\" />","+  </ItemGroup>","+</Project>",""],"additions":5,"deletions":0,"truncated":false}],"additions":185,"deletions":60,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-20T17:59:43.221517+00:00"}