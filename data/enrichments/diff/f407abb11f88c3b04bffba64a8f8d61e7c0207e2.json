nd == \"partial\":","+            callee = partial(callee)","+","+        def fn(x, mapping):","+            if callee_kind == \"builtin\":","+                result = dict(**mapping)","+                return x + sum(result.values()), tuple(result)","+            return callee(x, **mapping)","+","+        counter = torch._dynamo.testing.CompileCounter()","+        compiled = torch.compile(fn, backend=counter, fullgraph=True)","+        x = torch.ones(1)","+        for mapping in (mapping_type(a=1, b=2), mapping_type(b=2, a=1)):","+            self.assertEqual(compiled(x, mapping), fn(x, mapping))","+        self.assertEqual(counter.frame_count, 2 if observe_order else 1)","+","+    @parametrize(\"kind\", [\"fixed\", \"ordered\", \"invalid\", \"duplicate\", \"starargs\"])","+    @parametrize(\"wrapped\", [False, True])","+    def test_forwarded_keyword_order_guard(self, kind, wrapped):","+        def fixed(x, a=0, b=0):","+            return x + 10 * a + b","+","+        def starargs(x, *args, a=0, b=0):","+            return x + 10 * a + b","+","+        def ordered(x, **kwargs):","+            return x + sum(kwargs.values()), tuple(kwargs)","+","+        callee = {\"ordered\": ordered, \"starargs\": starargs}.get(kind, fixed)","+        bound = (10, 20) if kind in (\"duplicate\", \"starargs\") else ()","+        if wrapped:","+            callee = partial(callee, *bound)","+","+        def fn(x, **kwargs):","+            try:","+                return x + 1, callee(x, *(() if wrapped else bound), **kwargs)","+            except TypeError as exc:","+                return x + 1, str(exc)","+","+        counter = torch._dynamo.testing.CompileCounter()","+        compiled = torch.compile(fn, backend=counter, fullgraph=True)","+        x = torch.ones(1)","+        if kind in (\"invalid\", \"duplicate\"):","+            keys = (\"extra_a\", \"extra_b\") if kind == \"invalid\" else (\"a\", \"b\")","+            kwargs = dict(zip(keys, (1, 2)))","+            reversed_kwargs = dict(reversed(kwargs.items()))","+            for kw in (kwargs, reversed_kwargs):","+                error_key = compiled(x, **kw)[1].split(\"'\")[1]","+                self.assertEqual(error_key, fn(x, **kw)[1].split(\"'\")[1])","+        else:","+            self.assertEqual(compiled(x, a=1, b=2), fn(x, a=1, b=2))","+            self.assertEqual(compiled(x, b=2, a=1), fn(x, b=2, a=1))","+        frames = 1 if kind in (\"fixed\", \"starargs\") else 2","+        self.assertEqual(counter.frame_count, frames)","+","+    @parametrize(\"mapping_type\", [dict, OrderedDict, defaultdict])","+    @parametrize(\"subclass\", [False, True])","+    @parametrize(\"valid\", [False, True])","+    def test_keyword_expansion_mapping(self, mapping_type, subclass, valid):","+        class Mapping(mapping_type):","+            pass","+","+        actual_type = Mapping if subclass else mapping_type","+","+        def fn(x, mapping):","+            def target(a=0, b=0):","+                return x + 10 * a + b","+","+            try:","+                return target(**mapping)","+            except TypeError as exc:","+                return x - 1, str(exc)","+","+        counter = torch._dynamo.testing.CompileCounter()","+        compiled = torch.compile(fn, backend=counter, fullgraph=True)","+        x = torch.ones(1)","+        for pairs in (","+            [(\"a\", 1), (\"b\", 2)],","+            [(\"a\", 1), (\"b\", 2)],","+            [(\"b\", 2), (\"a\", 1)],","+        ):","+            if not valid:","+                pairs = [(1, 2)]","+            mapping = (","+                actual_type(None, pairs)","+                if mapping_type is defaultdict","+                else actual_type(pairs)","+            )","+            if not valid:","+                self.assertEqual(fn(x, mapping)[1], \"keywords must be strings\")","+            self.assertEqual(compiled(x, mapping), fn(x, mapping))","+        # Subclass keys retain positional guards; exact builtin keys bind by