ate Integer integer;","+","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"documentation/src/main/asciidoc/reference/_ch02.adoc","lines":["@@ -710,6 +710,10 @@ The default is `ANY`, which means both IPv4 and IPv6 addresses are considered va"," \tSupported data types::: `CharSequence`"," \tHibernate metadata impact::: None"," ","+`@ISSN`:: Checks that the annotated character sequence is a valid https://en.wikipedia.org/wiki/International_Standard_Serial_Number[ISSN]. `type` determines the type of ISSN. The default is ISSN-13.","+\tSupported data types::: `CharSequence`","+\tHibernate metadata impact::: None","+"," `@DateTimeFormat`:: Checks that the annotated character sequence is valid for the date and/or time format. The `pattern` parameter specifies the date/time format pattern (e.g., \"yyyy-MM-dd\", \"dd/MM/yyyy HH:mm:ss\") following `java.time.format.DateTimeFormatter` conventions. The `locale` parameter accepts one or more locale strings (e.g., `\"en-US\"`, `{\"en-US\", \"fr-FR\"}`), validation succeeds if the value parses with any of them; defaults to `\"ROOT\"` which works for numeric patterns but not text-based ones like month names. The `lenient` parameter determines date validation behaviour: when `false` (default), invalid dates like February 31st are rejected; when `true`, invalid dates are accepted and rolled over to subsequent months (e.g., February 30th becomes March 2nd). `null` values are always considered valid."," \tSupported data types::: `CharSequence`"," \tHibernate metadata impact::: None"],"additions":4,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/cfg/defs/ISSNDef.java","lines":["@@ -0,0 +1,34 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.cfg.defs;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.cfg.ConstraintDef;","+import org.hibernate.validator.constraints.ISSN;","+","+/**","+ * Programmatic constraint definition for {@link ISSN}.","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Incubating","+public class ISSNDef extends ConstraintDef<ISSNDef, ISSN> {","+","+\tpublic ISSNDef() {","+\t\tsuper( ISSN.class );","+\t}","+","+\t/**","+\t * Sets the ISSN type (ISSN-8, ISSN-13, or ANY).","+\t *","+\t * @param type the ISSN type","+\t * @return this instance for method chaining","+\t */","+\tpublic ISSNDef type(ISSN.Type type) {","+\t\taddParameter( \"type\", type );","+\t\treturn this;","+\t}","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/constraints/ISSN.java","lines":["@@ -0,0 +1,79 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.constraints;","+","+import static java.lang.annotation.ElementType.ANNOTATION_TYPE;","+import static java.lang.annotation.ElementType.CONSTRUCTOR;","+import static java.lang.annotation.ElementType.FIELD;","+import static java.lang.annotation.ElementType.METHOD;","+import static java.lang.annotation.ElementType.PARAMETER;","+import static java.lang.annotation.ElementType.TYPE_USE;","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+import java.lang.annotation.Documented;","+import java.lang.annotation.Repeatable;","+import java.lang.annotation.Retention;","+import java.lang.annotation.Target;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.constraints.ISSN.List;","+","+/**","+ * Checks that the annotated character sequence is a valid","+ * <a href=\"https://en.wikipedia.org/wiki/International_Standard_Serial_Number\">ISSN</a>.","+ * The length of the number and the check digit are both verified.","+ * <p>","+ * The supported type is {@code CharSequence}. {@code null} is considered valid.","+ * <p>","+ * During validation all non ISSN characters are ignored. All digits and 'X' are considered","+ * to be valid ISSN characters. This is useful when validating ISSN with dashes separating","+ * parts of the number (ex. {@code 1234-567X}).","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Documented","+@Constraint(validatedBy = { })","+@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+@Retention(RUNTIME)","+@Repeatable(List.class)","+@Incubating","+public @interface ISSN {","+","+\tString message() default \"{org.hibernate.validator.constraints.ISSN.message}\";","+","+\tClass<?>[] groups() default { };","+","+\tClass<? extends Payload>[] payload() default { };","+","+\tType type() default Type.ISSN_13;","+","+\t/**","+\t * Defines several {@code @ISSN} annotations on the same element.","+\t */","+\t@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+\t@Retention(RUNTIME)","+\t@Documented","+\tpublic @interface List {","+","+\t\tISSN[] value();","+\t}","+","+\t/**","+\t * Defines the ISSN length. Valid lengths of ISSNs are {@code 8} and {@code 13}","+\t * which are represented as {@link Type#ISSN_8} and {@link Type#ISSN_13} respectively.","+\t * <p>","+\t * Using {@link Type#ANY} allows to validate values that could either be ISSN-8 or ISSN-13.","+\t * In such case, ISSN type would be determined by the length of the corresponding value.","+\t */","+\tenum Type {","+\t\tISSN_8,","+\t\tISSN_13,","+\t\tANY","+\t}","+}"],"additions":79,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/constraintvalidators/hv/ISSNValidator.java","lines":["@@ -0,0 +1,155 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.internal.constraintvalidators.hv;","+","+import java.util.regex.Pattern;","+","+import jakarta.validation.ConstraintValidator;","+import jakarta.validation.ConstraintValidatorContext;","+","+import org.hibernate.validator.constraints.ISSN;","+import org.hibernate.validator.internal.util.Contracts;","+","+/**","+ * Checks that a given character sequence (e.g. string) is a valid ISSN.","+ *","+ * @author Andrea Boriero","+ */","+public class ISSNValidator implements ConstraintValidator<ISSN, CharSequence> {","+","+\t/**","+\t * Pattern to replace all non ISSN characters. ISSN can have digits or 'X'.","+\t */","+\tprivate static Pattern NOT_DIGITS_OR_NOT_X = Pattern.compile( \"[^\\\\dX]\" );","+","+\tprivate ISSNValidationAlgorithm issnValidationAlgorithm;","+","+\t@Override","+\tpublic void initialize(ISSN constraintAnnotation) {","+\t\tthis.issnValidationAlgorithm = ISSNValidationAlgorithm.from( constraintAnnotation.type() );","+\t}","+","+\t@Override","+\tpublic boolean isValid(CharSequence issn, ConstraintValidatorContext context) {","+\t\tif ( issn == null ) {","+\t\t\treturn true;","+\t\t}","+","+\t\t// Replace all non-digit (or !=X) chars","+\t\tString digits = NOT_DIGITS_OR_NOT_X.matcher( issn ).replaceAll( \"\" );","+","+\t\t// Check if the length of resulting string matches the expecting one","+\t\tif ( !issnValidationAlgorithm.isValidLength( digits.length() ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\treturn issnValidationAlgorithm.isValidChecksum( digits );","+\t}","+","+\tprivate interface ISSNValidationAlgorithm {","+\t\tboolean isValidLength(int length);","+","+\t\tboolean isValidChecksum(String issn);","+","+\t\tstatic ISSNValidationAlgorithmImpl from(ISSN.Type type) {","+\t\t\tContracts.assertNotNull( type );","+\t\t\tswitch ( type ) {","+\t\t\t\tcase ISSN_8:","+\t\t\t\t\treturn ISSNValidationAlgorithmImpl.ISSN_8;","+\t\t\t\tcase ISSN_13:","+\t\t\t\t\treturn ISSNValidationAlgorithmImpl.ISSN_13;","+\t\t\t\tcase ANY:","+\t\t\t\tdefault:","+\t\t\t\t\treturn ISSNValidationAlgorithmImpl.ANY;","+\t\t\t}","+\t\t}","+\t}","+","+\tprivate enum ISSNValidationAlgorithmImpl implements ISSNValidationAlgorithm {","+","+\t\tISSN_8 {","+\t\t\t@Override","+\t\t\tpublic boolean isValidChecksum(String issn) {","+\t\t\t\treturn checkChecksumISSN8( issn );","+\t\t\t}","+","+\t\t\t@Override","+\t\t\tpublic boolean isValidLength(int length) {","+\t\t\t\treturn 8 == length;","+\t\t\t}","+\t\t},","+\t\tISSN_13 {","+\t\t\t@Override","+\t\t\tpublic boolean isValidChecksum(String issn) {","+\t\t\t\treturn checkChecksumISSN13( issn );","+\t\t\t}","+","+\t\t\t@Override","+\t\t\tpublic boolean isValidLength(int length) {","+\t\t\t\treturn 13 == length;","+\t\t\t}","+\t\t},","+\t\tANY {","+\t\t\t@Override","+\t\t\tpublic boolean isValidLength(int length) {","+\t\t\t\treturn 8 == length || 13 == length;","+\t\t\t}","+","+\t\t\t@Override","+\t\t\tpublic boolean isValidChecksum(String issn) {","+\t\t\t\tint length = issn.length();","+\t\t\t\tif ( length == 8 ) {","+\t\t\t\t\treturn checkChecksumISSN8( issn );","+\t\t\t\t}","+\t\t\t\telse if ( length == 13 ) {","+\t\t\t\t\treturn checkChecksumISSN13( issn );","+\t\t\t\t}","+\t\t\t\tthrow new IllegalStateException( \"Invalid/unsupported issn value length\" );","+\t\t\t}","+\t\t};","+","+\t\t/**","+\t\t * Check the digits for ISSN-8 using modulus 11 algorithm with weights 8 to 1.","+\t\t * The check digit calculation: sum of (digit × position weight from left, 8 to 2) mod 11.","+\t\t * If remainder is 0, check digit is 0. Otherwise check digit is 11 - remainder.","+\t\t * When check digit would be 10, it's represented as 'X'.","+\t\t * For validation, we verify that the sum of all 8 positions (with weights 8 to 1) mod 11 equals 0.","+\t\t */","+\t\tprivate static boolean checkChecksumISSN8(String issn) {","+\t\t\tint sum = 0;","+\t\t\tfor ( int i = 0; i < issn.length(); i++ ) {","+\t\t\t\tif ( issn.charAt( i ) == 'X' && i != 7 ) {","+\t\t\t\t\treturn false;","+\t\t\t\t}","+\t\t\t\tint digit = issn.charAt( i ) == 'X' ? 10 : issn.charAt( i ) - '0';","+\t\t\t\tsum += digit * ( 8 - i );","+\t\t\t}","+","+\t\t\treturn ( sum % 11 ) == 0;","+\t\t}","+","+\t\t/**","+\t\t * Check the digits for ISSN-13 (EAN-13 format) using modulus 10 algorithm.","+\t\t * ISSN-13 format: 977 prefix + 7 ISSN digits (excluding ISSN-8 check digit) + 2 sequence digits + EAN check digit.","+\t\t * The algorithm alternates multiplying by 1 and 3 from left to right.","+\t\t */","+\t\tprivate static boolean checkChecksumISSN13(String issn) {","+\t\t\t// Verify 977 prefix for ISSN in EAN-13 format","+\t\t\tif ( !issn.startsWith( \"977\" ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+","+\t\t\tint sum = 0;","+\t\t\tfor ( int i = 0; i < issn.length(); i++ ) {","+\t\t\t\tif ( issn.charAt( i ) == 'X' ) {","+\t\t\t\t\treturn false;","+\t\t\t\t}","+\t\t\t\tsum += ( issn.charAt( i ) - '0' ) * ( i % 2 == 0 ? 1 : 3 );","+\t\t\t}","+","+\t\t\treturn ( sum % 10 ) == 0;","+\t\t}","+\t}","+}"],"additions":155,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/BuiltinConstraint.java","lines":["@@ -60,6 +60,7 @@ enum BuiltinConstraint {"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_IBAN( \"org.hibernate.validator.constraints.IBAN\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_IP_ADDRESS( \"org.hibernate.validator.constraints.IpAddress\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_ISBN( \"org.hibernate.validator.constraints.ISBN\" ),","+\tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_ISSN( \"org.hibernate.validator.constraints.ISSN\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_LENGTH( \"org.hibernate.validator.constraints.Length\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_LOWERCASE( \"org.hibernate.validator.constraints.LowerCase\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_LUHN_CHECK( \"org.hibernate.validator.constraints.LuhnCheck\" ),"],"additions":1,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/ConstraintHelper.java","lines":["@@ -44,6 +44,7 @@"," import static org.hibernate.validator.internal.metadata.core.BuiltinConstraint.ORG_HIBERNATE_VALIDATOR_CO