{"id":"7b93ace23b48612e2f0bd5faba31dc3cf2e168a4","axis":"silent","repo":"owncloud/core","sha":"7b93ace23b48612e2f0bd5faba31dc3cf2e168a4","parsed":{"files":[{"path":"changelog/unreleased/41753","lines":["@@ -0,0 +1,13 @@","+Change: Expose createLocal() on ICacheFactory","+","+The cache factory has always been able to hand out a cache from the host local","+tier, but the method was missing from the public ICacheFactory interface, so","+core had to ask for it defensively and apps had no way to use it at all. It is","+now part of the interface, which lets values that are only meaningful on the","+machine that produced them be kept out of the cache shared between the nodes of","+an installation.","+","+Note for app developers: a class implementing OCP\\ICacheFactory has to declare","+createLocal() from this release on.","+","+https://github.com/owncloud/core/pull/41753"],"additions":13,"deletions":0,"truncated":false},{"path":"lib/private/App/AppManager.php","lines":["@@ -31,8 +31,7 @@"," namespace OC\\App;"," "," use OC_App;","-use OC\\Memcache\\ArrayCache;","-use OC\\Memcache\\NullCache;","+use OC\\Memcache\\LocalCacheFactory;"," use OC\\Installer;"," use OCP\\App\\AppNotFoundException;"," use OCP\\App\\IAppManager;","@@ -120,14 +119,9 @@ public function __construct("," \t\t$this->dispatcher = $dispatcher;"," \t\t$this->config = $config;"," ","-\t\t// TODO we have no public API for this","-\t\tif (\\method_exists($this->memCacheFactory, 'createLocal')) {","-\t\t\t/* @phan-suppress-next-line PhanUndeclaredMethod */","-\t\t\t$this->appInfo = $this->memCacheFactory->createLocal('app-info');","-\t\t}","-\t\tif ($this->appInfo === null || $this->appInfo instanceof NullCache) {","-\t\t\t$this->appInfo = new ArrayCache('app-info');","-\t\t}","+\t\t// app info describes the apps installed on this machine, so it belongs in","+\t\t// the host local tier","+\t\t$this->appInfo = LocalCacheFactory::create($this->memCacheFactory, 'app-info');"," \t}"," "," \t/**"],"additions":4,"deletions":10,"truncated":false},{"path":"lib/private/Memcache/LocalCacheFactory.php","lines":["@@ -33,9 +33,8 @@","  * consume what any single node (or anything else able to talk to the backend)","  * wrote there.","  *","- * ICacheFactory does not declare createLocal(), so the tier is requested","- * defensively and a request scoped ArrayCache is used whenever a usable local","- * cache cannot be obtained.","+ * A request scoped ArrayCache is used whenever a usable local cache cannot be","+ * obtained.","  *","  * @package OC\\Memcache","  */","@@ -51,11 +50,7 @@ class LocalCacheFactory {"," \t * @return ICache"," \t */"," \tpublic static function create(ICacheFactory $factory, $prefix = '') {","-\t\t$cache = null;","-\t\tif (\\method_exists($factory, 'createLocal')) {","-\t\t\t/* @phan-suppress-next-line PhanUndeclaredMethod */","-\t\t\t$cache = $factory->createLocal($prefix);","-\t\t}","+\t\t$cache = $factory->createLocal($prefix);"," \t\tif (!$cache instanceof ICache || $cache instanceof NullCache) {"," \t\t\t$cache = new ArrayCache($prefix);"," \t\t}"],"additions":3,"deletions":8,"truncated":false},{"path":"lib/public/ICacheFactory.php","lines":["@@ -40,6 +40,23 @@ interface ICacheFactory {"," \t */"," \tpublic function create($prefix = '');"," ","+\t/**","+\t * Get a memory cache instance in the host local tier","+\t *","+\t * Unlike the cache returned by create(), this cache is not shared between the","+\t * nodes of an installation. Values which are only meaningful on the machine","+\t * which produced them - resolved paths on disk, results of inspecting the","+\t * local installation - belong here and not in the shared cache, where every","+\t * node would consume what any single node wrote.","+\t *","+\t * All entries added trough the cache instance will be namespaced by $prefix to prevent collisions between apps","+\t *","+\t * @param string $prefix","+\t * @return \\OCP\\ICache","+\t * @since 11.0.0","+\t */","+\tpublic function createLocal($prefix = '');","+"," \t/**"," \t * Check if any memory cache backend is available"," \t *"],"additions":17,"deletions":0,"truncated":false},{"path":"tests/lib/Memcache/LocalCacheFactoryTest.php","lines":["@@ -77,20 +77,12 @@ public function testNeverFallsBackToTheDistributedTier(): void {"," \t\t$this->assertNull($factory->createDistributed('test')->get('key'));"," \t}"," ","-\tpublic function testFallsBackWhenCreateLocalIsNotImplemented(): void {","-\t\t// ICacheFactory does not declare createLocal(), so a bare interface","-\t\t// mock has no such method","-\t\t$factory = $this->createMock(ICacheFactory::class);","-","-\t\t$this->assertInstanceOf(ArrayCache::class, LocalCacheFactory::create($factory, 'test'));","-\t}","-"," \t/**"," \t * @dataProvider unusableLocalCacheProvider"," \t * @param mixed $returnValue"," \t */"," \tpublic function testFallsBackWhenCreateLocalReturnsSomethingUnusable($returnValue): void {","-\t\t$factory = $this->createMock(FixedCacheFactory::class);","+\t\t$factory = $this->createMock(ICacheFactory::class);"," \t\t$factory->method('createLocal')->willReturn($returnValue);"," "," \t\t$this->assertInstanceOf(ArrayCache::class, LocalCacheFactory::create($factory, 'test'));","@@ -103,6 +95,17 @@ public function unusableLocalCacheProvider() {"," \t\t];"," \t}"," ","+\t/**","+\t * The helper calls createLocal() unconditionally, which is only safe as long","+\t * as every ICacheFactory has to provide it.","+\t */","+\tpublic function testTheLocalTierIsPartOfThePublicApi(): void {","+\t\t$this->assertTrue(","+\t\t\t(new \\ReflectionClass(ICacheFactory::class))->hasMethod('createLocal'),","+\t\t\t'ICacheFactory declares createLocal()'","+\t\t);","+\t}","+"," \tpublic function testPassesThroughThePrefix(): void {"," \t\t$factory = new FixedCacheFactory($this->createMock(ICache::class));"," ",""],"additions":12,"deletions":9,"truncated":false}],"additions":49,"deletions":27,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-07-29T10:24:51.720260+00:00"}