_config<GpuBackendConfig>());","   FusionBackendConfig* backend_config =","       gpu_config.mutable_fusion_backend_config();","   backend_config->set_kind(kCuDnnFusionKind);","   backend_config->mutable_cudnn_fusion_config()->set_plan_id(config.algo_id());","-  ABSL_RETURN_IF_ERROR(fusion_instr->set_backend_config(std::move(gpu_config)));","-  fusion_instr->set_fusion_kind(HloInstruction::FusionKind::kCustom);","+  ABSL_RETURN_IF_ERROR(instr.set_backend_config(std::move(gpu_config)));","+  instr.set_fusion_kind(HloInstruction::FusionKind::kCustom);","   return absl::OkStatus();"," }"," "],"additions":15,"deletions":18,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/cudnn_test.cc","lines":["@@ -16,6 +16,7 @@ limitations under the License."," #include \"xla/backends/gpu/autotuner/cudnn.h\""," "," #include <memory>","+#include <utility>"," #include <vector>"," "," #include <gmock/gmock.h>","@@ -27,14 +28,21 @@ limitations under the License."," #include \"absl/strings/string_view.h\""," #include \"xla/autotuning.pb.h\""," #include \"xla/backends/autotuner/codegen_backend.h\"","+#include \"xla/backends/gpu/autotuner/fission_backend.h\"","+#include \"xla/backends/gpu/codegen/emitters/mlir_kernel_emitter.h\""," #include \"xla/backends/gpu/target_config/target_config.h\"","+#include \"xla/backends/gpu/transforms/block_scaling_rewriter.h\""," #include \"xla/hlo/ir/hlo_instruction.h\""," #include \"xla/hlo/ir/hlo_module.h\""," #include \"xla/hlo/ir/hlo_opcode.h\"","+#include \"xla/hlo/pass/hlo_pass_pipeline.h\""," #include \"xla/hlo/testlib/hlo_hardware_independent_test_base.h\""," #include \"xla/service/compiler.h\"","+#include \"xla/service/gpu/alias_info.h\""," #include \"xla/service/gpu/backend_configs.pb.h\"","+#include \"xla/service/gpu/cublas_cudnn.h\""," #include \"xla/service/gpu/ir_emission_utils.h\"","+#include \"xla/service/gpu/mlir_context_pool.h\""," #include \"xla/service/gpu/nvptx_compiler.h\""," #include \"xla/service/platform_util.h\""," #include \"xla/stream_executor/cuda/cuda_compute_capability.h\"","@@ -65,8 +73,14 @@ se::StreamExecutor* GetDefaultStreamExecutor() {"," using CudnnBackendConfig = stream_executor::dnn::AlgorithmProto;"," "," using ::absl_testing::IsOkAndHolds;","+using ::absl_testing::StatusIs;","+using ::testing::AnyOf;","+using ::testing::Each;"," using ::testing::Gt;","+using ::testing::HasSubstr;"," using ::testing::IsEmpty;","+using ::testing::Not;","+using ::testing::Property;"," using ::testing::SizeIs;"," using ::tsl::proto_testing::EqualsProto;"," ","@@ -174,6 +188,73 @@ absl::string_view kScaledDotGemmFusionHlo = R\"hlo(","         backend_config={\"fusion_backend_config\":{kind:\"__triton_gemm\"}}","   })hlo\";"," ","+// The scales are already swizzled, as emitted by CudnnScaledDotRewriter.","+constexpr absl::string_view kScaledDotCudnnFusionHlo = R\"hlo(","+  block_scaled_dot {","+    lhs = f8e4m3fn[256,128] parameter(0)","+    rhs = f8e4m3fn[384,128] parameter(1)","+    lhs_scale = f8e8m0fnu[256,4] parameter(2)","+    rhs_scale = f8e8m0fnu[384,4] parameter(3)","+    ROOT result = f32[256,384] scaled-dot(lhs, rhs, lhs_scale, rhs_scale),","+        lhs_contracting_dims={1}, rhs_contracting_dims={1}","+  }","+","+  ENTRY main {","+    lhs = f8e4m3fn[256,128] parameter(0)","+    rhs = f8e4m3fn[384,128] parameter(1)","+    lhs_scale = f8e8m0fnu[256,4] parameter(2)","+    rhs_scale = f8e8m0fnu[384,4] parameter(3)","+    ROOT result = f32[256,384] fusion(lhs, rhs, lhs_scale, rhs_scale),","+        kind=kCustom, calls=block_scaled_dot,","+        backend_config={\"fusion_backend_config\":{kind:\"__cudnn$fusion\"}}","+  })hlo\";","+","+// K = 64 requires padding the scales from 2 to 4 columns before swizzling.","+constexpr absl::string_view kScaledDotWithEpilogueGemmFusionHlo = R\"hlo(","+  block_scaled_dot {","+    lhs = f8e4m3fn[256,64] parameter(0)","+    rhs = f8e4m3fn[384,64] parameter(1)","+    lhs_scale = f8e8m0fnu[256,2] parameter(2)","+    rhs_scale = f8e8m0fnu[384,2] parameter(3)","+    dot = f32[256,384] scaled-dot(lhs, rhs, lhs_scale, rhs_scale),","+        lhs_contracting_dims={1}, rhs_contracting_dims={1}","+    ROOT convert = bf16[256,384] convert(dot)","+  }","+","+  ENTRY main {","+    lhs = f8e4m3fn[256,64] parameter(0)","+    rhs = f8e4m3fn[384,64] parameter(1)","+    lhs_scale = f8e8m0fnu[256,2] parameter(2)","+    rhs_scale = f8e8m0fnu[384,2] parameter(3)","+    ROOT result = bf16[256,384] fusion(lhs, rhs, lhs_scale, rhs_scale),","+        kind=kCustom, calls=block_scaled_dot,","+        backend_config={\"fusion_backend_config\":{kind:\"__triton_gemm\"}}","+  })hlo\";","+","+// Non-K-minor LHS and scale are transposed to K-minor inside the GEMM fusion.","+constexpr absl::string_view kScaledDotWithPrologueTransposeGemmFusionHlo =","+    R\"hlo(","+  block_scaled_dot {","+    lhs_in = f8e4m3fn[64,256] parameter(0)","+    lhs = f8e4m3fn[256,64] transpose(lhs_in), dimensions={1,0}","+    rhs = f8e4m3fn[384,64] parameter(1)","+    lhs_scale_in = f8e8m0fnu[2,256] parameter(2)","+    lhs_scale = f8e8m0fnu[256,2] transpose(lhs_scale_in), dimensions={1,0}","+    rhs_scale = f8e8m0fnu[384,2] parameter(3)","+    ROOT dot = f32[256,384] scaled-dot(lhs, rhs, lhs_scale, rhs_scale),","+        lhs_contracting_dims={1}, rhs_contracting_dims={1}","+  }","+","+  ENTRY main {","+    lhs = f8e4m3fn[64,256] parameter(0)","+    rhs = f8e4m3fn[384,64] parameter(1)","+    lhs_scale = f8e8m0fnu[2,256] parameter(2)","+    rhs_scale = f8e8m0fnu[384,2] parameter(3)","+    ROOT result = f32[256,384] fusion(lhs, rhs, lhs_scale, rhs_scale),","+        kind=kCustom, calls=block_scaled_dot,","+        backend_config={\"fusion_backend_config\":{kind:\"__triton_gemm\"}}","+  })hlo\";","+"," absl::string_view kCudnnCustomCallHlo = R\"hlo(","   HloModule module"," ","@@ -223,11 +304,24 @@ class CudnnBackendTest : public HloHardwareIndependentTestBase {","                                               &compiler_, &target_config_);","   }"," ","+  std::unique_ptr<FissionBackend> CreateFissionBackend() {","+    auto pipeline = std::make_unique<HloPassPipeline>(\"cudnn_fission\");","+    pipeline->AddPass(std::make_unique<CudnnScaledDotRewriter>());","+    return std::make_unique<FissionBackend>(","+        &debug_options_, &compiler_, &target_config_,","+        std::make_unique<CudnnBackend>(stream_executor_, &debug_options_,","+                                       &compiler_, &target_config_),","+        std::move(pipeline), &alias_info_, &mlir_context_pool_,","+        stream_executor_);","+  }","+","   NVPTXCompiler compiler_;","   se::StreamExecutor* stream_executor_;","   Compiler::GpuTargetConfig target_config_;","   DebugOptions debug_options_;","   std::unique_ptr<CudnnBackend> backend_;","+  GpuAliasInfo alias_info_{target_config_.device_description};","+  MlirContextPool mlir_context_pool_{CreateMlirContext};"," };"," "," TEST_F(CudnnBackendTest, CanCreateCublasBackend) {","@@ -271,15 +365,14 @@ TEST_F(CudnnBackendTest, GetSupportedConfigsFromF64GemmFusionReturnsEmpty) {","   EXPECT_THAT(configs, IsOkAndHolds(IsEmpty()));"," }"," ","-TEST_F(CudnnBackendTest, GetSupportedConfigsFromScaledDotGemmFusion) {","-  se::CudaComputeCapability cc =","-      stream_executor_->GetDeviceDescription().cuda_compute_capability();","-  if (!cc.IsAtLeastBlackwell()) {","-    GTEST_SKIP() << \"Block-scaled dot is only supported on Blackwell GPUs.\";","+TEST_F(CudnnBackendTest, GetSupportedConfigsFromScaledDotCudnnFusion) {","+  if (!CudnnScaledDotHelper::IsAvailable(","+          stream_executor_->GetDeviceDescription())) {","+    GTEST_SKIP() << \"cuDNN scaled dot requires Blackwell and cuDNN 9.10+.\";","   }"," ","   ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","-                       ParseAndReturnVerifiedModule(kScaledDotGemmFusionHlo));","+                       ParseAndReturnVerifiedModule(kScaledDotCudnnFusionHlo));","   // Test with cudnn_gemm_fusion_level = 0 to ensure it is permanently enabled.","   DebugOptions debug_options = debug_options_;","   debug_options.set_xla_gpu_cudnn_gemm_fusion_level(0);","@@ -291,6 +384,20 @@ TEST_F(CudnnBackendTest, GetSupportedConfigsFromScaledDotGemmFusion) {","   EXPECT_THAT(configs, absl_testing::IsOkAndHolds(SizeIs(Gt(0))));"," }"," ","+TEST_F(CudnnBackendTest, GetSupportedConfigsFromScaledDotGemmFusionIsEmpty) {","+  ASSERT_OK_AND_ASSIGN(stream_executor::GpuTargetConfigProto proto,","+                       GetGpuTargetConfig(GpuModel::B200));","+  ASSERT_OK_AND_ASSIGN(Compiler::GpuTargetConfig b200_target_config,","+                       Compiler::GpuTargetConfig::FromProto(proto));","+  CudnnBackend backend(/*stream_executor=*/nullptr, &debug_options_, &compiler_,","+                       &b200_target_config);","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(kScaledDotGemmFusionHlo));","+  EXPECT_THAT(backend.GetSupportedConfigs(","+                  *hlo_module->entry_computation()->root_instruction()),","+              IsOkAndHolds(IsEmpty()));","+}","+"," TEST_F(CudnnBackendTest, GetSupportedConfigsFromCudnnCustomCall) {","   ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","                        ParseAndReturnVerifiedModule(kCudnnCustomCallHlo));","@@ -443,28 +550,122 @@ TEST_F(CudnnBackendTest, ApplyConfigToLoopFusionSetsCustomFusionKind) {","             1);"," }"," ","-TEST_F(CudnnBackendTest, ApplyConfigToScaledDotGemmFusionAddsScaleSwizzle) {","+TEST_F(CudnnBackendTest, ApplyConfigToScaledDotCudnnFusionKeepsOperands) {","   ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","-                       ParseAndReturnVerifiedModule(kScaledDotGemmFusionHlo));","-  CudnnBackendConfig config;","-  config.set_algo_id(1);","+                       ParseAndReturnVerifiedModule(kScaledDotCudnnFusionHlo));","+  BackendConfig backend_config;","+  backend_config.mutable_algorithm()->set_algo_id(1);","   HloInstruction* fusion_instr =","       hlo_module->entry_computation()->root_instruction();","-  BackendConfig backend_config;","-  *backend_config.mutable_algorithm() = config;","   ASSERT_OK(backend_->ApplyConfig(*fusion_instr, backend_config));","-  HloInstruction* root_instr =","-      hlo_module->entry_computation()->root_instruction();","-  ASSERT_EQ(root_instr->opcode(), HloOpcode::kFusion);","+  ASSERT_EQ(hlo_module->entry_computation()->root_instruction(), fusion_instr);","   ASSERT_OK_AND_ASSIGN(GpuBackendConfig gpu_config,","-                       root_instr->backend_config<GpuBackendConfig>());","-  EXPECT_EQ(gpu_config.fusion_backend_config().kind(), kCuDnnFusionKind);","+                       fusion_instr->backend_config<GpuBackendConfig>());","   EXPECT_EQ(gpu_config.fusion_backend_config().cudnn_fusion_config().plan_id(),","             1);","-  EXPECT_EQ(root_instr->operand(2)->opcode(), HloOpcode::kGetTupleElement);","-  EXPECT_EQ(root_instr->operand(2)->operand(0)->opcode(), HloOpcode::kCall);","-  EXPECT_EQ(root_instr->operand(3)->opcode(), HloOpcode::kGetTupleElement);","-  EXPECT_EQ(root_instr->operand(3)->operand(0)->opcode(), HloOpcode::kCall);","+  EXPECT_THAT(fusion_instr->operands(),","+              Each(Property(&HloInstruction::opcode, HloOpcode::kParameter)));","+}","+","+TEST_F(CudnnBackendTest, ApplyConfigToScaledDotGemmFusionFails) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(kScaledDotGemmFusionHlo));","+  BackendConfig backend_config;","+  backend_config.mutable_algorithm()->set_algo_id(1);","+  EXPECT_THAT(","+      backend_->ApplyConfig(","+          *hlo_module->entry_computation()->root_instruction(), backend_config),","+      StatusIs(absl::StatusCode::kInternal,","+               HasSubstr(\"CudnnScaledDotRewriter\")));","+}","+","+TEST_F(CudnnBackendTest, FissionDoesNotSupportFusionWithoutScaledDot) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(kTritonGemmFusionHlo));","+  std::unique_ptr<FissionBackend> fission_backend = CreateFissionBackend();","+  EXPECT_TRUE(fission_backend->CanProduceWrongResults());","+  HloInstruction& fusion = *hlo_module->entry_computation()->root_instruction();","+  EXPECT_FALSE(fission_backend->IsSupported(fusion));","+  EXPECT_THAT(fission_backend->GetSupportedConfigs(fusion),","+              IsOkAndHolds(IsEmpty()));","+  EXPECT_THAT(fission_backend->ApplyConfig(fusion, BackendConfig{}),","+              StatusIs(absl::StatusCode::kInvalidArgument,","+                       HasSubstr(\"does not support\")));","+}","+","+TEST_F(CudnnBackendTest, FissionDoesNotSupportScaledDotCudnnFusion) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(kScaledDotCudnnFusionHlo));","+  std::unique_ptr<FissionBackend> fission_backend = CreateFissionBackend();","+  HloInstruction& fusion = *hlo_module->entry_computation()->root_instruction();","+  EXPECT_FALSE(fission_backend->IsSupported(fusion));","+  EXPECT_THAT(fission_backend->GetSupportedConfigs(fusion),","+              IsOkAndHolds(IsEmpty()));","+  EXPECT_THAT(fission_backend->ApplyConfig(fusion, BackendConfig{}),","+              StatusIs(absl::StatusCode::kInvalidArgument,","+                       HasSubstr(\"does not support\")));","+}","+","+TEST_F(CudnnBackendTest, FissionRewritesScaledDotGemmFusionToCudnnFusion) {","+  if (!CudnnScaledDotHelper::IsAvailable(","+          stream_executor_->GetDeviceDescription())) {","+    GTEST_SKIP() << \"cuDNN scaled dot requires Blackwell and cuDNN 9.10+.\";","+  }","+  std::unique_ptr<FissionBackend> fission_backend = CreateFissionBackend();","+  ASSERT_OK_AND_ASSIGN(","+      std::unique_ptr<HloModule> hlo_module,","+      ParseAndReturnVerifiedModule(kScaledDotWithEpilogueGemmFusionHlo));","+  HloInstruction* fusion = hlo_module->entry_computation()->root_instruction();","+  ASSERT_OK_AND_ASSIGN(std::vector<std::unique_ptr<BackendConfig>> configs,","+                       fission_backend->GetSupportedConfigs(*fusion));","+  ASSERT_THAT(configs, Not(IsEmpty()));","+  EXPECT_OK(fission_backend->Compile(*fusion, *configs[0]));","+","+  ASSERT_OK(fission_backend->ApplyConfig(*fusion, *configs[0]));","+","+  // The cuDNN fusion is preserved and the scale padding/swizzle is fused. The","+  // convert epilogue can't fuse into the cuDNN fusion and stays standalone.","+  const HloComputation* entry = hlo_module->entry_computation();","+  EXPECT_THAT(entry->instructions(),","+              Each(Property(&HloInstruction::opcode,","+                            Not(AnyOf(HloOpcode::kPad, HloOpcode::kTranspose,","+                                      HloOpcode::kScaledDot)))));","+  const HloInstruction* cudnn_fusion = entry->root_instruction()->operand(0);","+  ASSERT_TRUE(IsCudnnFusion(*cudnn_fusion));","+  ASSERT_OK_AND_ASSIGN(GpuBackendConfig gpu_config,","+                       cudnn_fusion->backend_config<GpuBackendConfig>());","+  EXPECT_TRUE(","+      gpu_config.fusion_backend_config().cudnn_fusion_config().has_plan_id());","+}","+","+TEST_F(CudnnBackendTest,","+       FissionExtractsTransposePrologueFromScaledDotGemmFusion) {","+  if (!CudnnScaledDotHelper::IsAvailable(","+          stream_executor_->GetDeviceDescription())) {","+    GTEST_SKIP() << \"cuDNN scaled dot requires Blackwell and cuDNN 9.10+.\";","+  }","+  std::unique_ptr<FissionBackend> fission_backend = CreateFissionBackend();","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(","+                           kScaledDotWithPrologueTransposeGemmFusionHlo));","+  HloInstruction* fusion = hlo_module->entry_computation()->root_instruction();","+  ASSERT_OK_AND_ASSIGN(std::vector<std::unique_ptr<BackendConfig>> configs,","+                       fission_backend->GetSupportedConfigs(*fusion));","+  ASSERT