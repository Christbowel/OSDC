8,14 @@ internal sealed class Journal","     internal static Journal Read(IDictionary<string, object> properties)","     {","         if (!properties.TryGetValue(PropertyKey, out var value))","+        {","             throw new InvalidOperationException(\"Journal absent; do not manufacture empty recovery state.\");","+        }","         var map = value is JsonElement json ? json : JsonSerializer.SerializeToElement(value);","         if (map.GetProperty(nameof(Schema)).GetInt32() != 1)","+        {","             throw new InvalidOperationException(\"Unsupported journal schema; original state must be retained.\");","+        }","         return map.Deserialize<Journal>() ?? throw new InvalidOperationException(\"Empty journal.\");","     }"," "],"additions":4,"deletions":0,"truncated":false},{"path":"core/experiments/NativeCompensation.E1/Program.cs","lines":["@@ -29,13 +29,13 @@ public static async Task<int> Main(string[] args)","         Directory.CreateDirectory(directory);","         var participant = args.Length > 2 ? args[2] : \"http://127.0.0.1:1\";","         var ambient = args.Contains(\"--ambient\");","-        var host = Host.CreateDefaultBuilder()","+        using var host = Host.CreateDefaultBuilder()","             .ConfigureLogging(logging => logging.ClearProviders())","             .ConfigureServices(services =>","             {","                 services.AddSingleton(new Barriers(args.Contains(\"--barriers\")));","                 services.AddNotificationHandler<CommitObserver, WorkflowStateCommitted>(provider => new(provider.GetRequiredService<Barriers>()));","-                services.AddSingleton(new HttpClient { BaseAddress = new Uri(participant) });","+                services.AddSingleton(_ => new HttpClient { BaseAddress = new Uri(participant) });","                 services.AddDataProtection().SetApplicationName(\"Elsa.NativeCompensation.E1\")","                     .PersistKeysToFileSystem(new DirectoryInfo(Path.Combine(directory, \"keys\")));","                 services.AddElsa(elsa => elsa","@@ -115,7 +115,6 @@ public static async Task<int> Main(string[] args)","         finally","         {","             await host.StopAsync();","-            host.Dispose();","         }","     }"," }","@@ -130,9 +129,13 @@ internal sealed class Barriers(bool enabled)","     internal async Task ReachAsync(string name, WorkflowExecutionContext context)","     {","         if (!enabled)","+        {","             return;","+        }","         Events.Write(\"barrier\", new { name, journal = Journal.Read(context.Properties) });","         if (await Console.In.ReadLineAsync() != \"continue\")","+        {","             throw new InvalidOperationException(\"Controller disconnected at barrier.\");","+        }","     }"," }"],"additions":6,"deletions":3,"truncated":false},{"path":"core/experiments/NativeCompensation.E1/README.md","lines":["@@ -23,3 +23,5 @@ The project adds an experiment-only scope, explicit effect-aware activity, map c"," The `--ambient` case measures Elsa's existing optional `EFCoreWorkflowCommitTransaction`. Cases with it disabled are clearly weaker exploratory snapshot tests and cannot establish cross-store atomicity. The historical r4 scope-activation gap was corrected in r5 by committing the seed and first native work together. The native fault-ownership bookkeeping gap remains exposed. The selected fault handoff uses an explicit retained-cause wrapper, never arbitrary CLR exception reconstruction or a type-specific catch guarantee."," "," See `REPORT.md` for the measured results and unresolved gates.","+","+Post-measurement review added backend-controller failure cleanup/diagnostics and braces to the experiment C# conditionals. The host now owns disposal of the registered `HttpClient` and retains explicit `StopAsync` teardown. These harness/style/resource-ownership corrections were not .NET-built or natively executed; the measured r5/control source heads remain the ones recorded in `REPORT.md`."],"additions":2,"deletions":0,"truncated":false},{"path":"core/experiments/NativeCompensation.E1/REPORT.md","lines":["@@ -115,3 +115,26 @@ failures/errors/skips. The 15 Python tests were also rechecked without native pr"," execution. This narrow inventory integration adds the discovery test and its owning"," document to the experiment's changed-file scope; it does not change the recorded E1"," observations, their hashes, or readiness.","+","+## Post-measurement backend cleanup and fixture style review","+","+Greptile reproduced malformed backend stdout raising before cleanup, leaving the","+backend alive and losing its PID, earlier events and stderr. The controller now","+terminates only its own still-live child in a `finally` path, waits/reaps it, joins","+the stdout/stderr readers, and carries PID/events/stderr plus controller/reader","+errors in a structured failed phase. Both matrix and control runners use the same","+phase helper, so a failure is retained in `evidence.json` and causes a nonzero","+controller exit. Reader completion/failure is signaled even when stdout iteration","+throws. Cheap Python child-process tests cover a valid event followed by malformed","+output and a hanging timeout; they assert child reaping and retained event/stderr","+diagnostics and run no .NET, participant or database process.","+","+The four experiment C# files now brace their conditional bodies as required by","+repository style. `Program.cs` registers `HttpClient` through the host-owned","+singleton factory and uses `using var` for the host while preserving `StopAsync` in","+`finally`. These are style/resource-ownership corrections only; they are not","+byte-identical to the frozen measured fixture source. The r5 source head remains","+`f3d4b31863dc7e2a029d6e93454a25a905e9b813`, and the controls source head remains","+`17a27e78d6c6afaef1b9c1a302b52442d30894f1`. No C# build or native execution was","+repeated for these corrections; the original raw files, 24 evidence hashes and","+summary remain unchanged. E1 remains Partial and M1 Not Ready."],"additions":23,"deletions":0,"truncated":false},{"path":"core/experiments/NativeCompensation.E1/controls.py","lines":["@@ -30,14 +30,14 @@ def run_control(name, output):","     result = {\"case\": name, \"participant_pid\": participant.pid}","     try:","         cut = \"forward-ack-0\" if name in (\"missing-work\", \"callback-owner\", \"callback-child\") else \"after-intent-reserve-0\"","-        result[\"first\"] = native.backend(directory, url, kill_at=cut)","+        native.run_backend_phase(result, \"first\", directory, url, kill_at=cut)","         result[\"before\"] = {\"elsa\": native.snapshot(directory), \"participant\": native.ledger(directory)}","         if name == \"stale-writer\":","-            result[\"control\"] = native.backend(directory, url, mode=\"stale\")","+            native.run_backend_phase(result, \"control\", directory, url, mode=\"stale\")","         elif name == \"definition-pin\":","             os.environ[\"E1_GRAPH_VERSION\"] = \"e1-definition-v2\"","             try:","-                result[\"control\"] = native.backend(directory, url)","+                native.run_backend_phase(result, \"control\", directory, url)","             finally:","                 del os.environ[\"E1_GRAPH_VERSION\"]","         else:","@@ -63,8 +63,9 @@ def run_control(name, output):","                 result[\"injectedSha256\"] = digest(altered)","                 (directory / \"injected-snapshot.txt\").write_text(altered)","                 db.execute(\"UPDATE WorkflowInstances SET Data=?\", (altered,))","-            result[\"inspection\"] = native.backend(directory, url, mode=\"inspect\")","-            result[\"control\"] = native.backend(directory, url, mode=\"resave\" if name in (\"outer-corrupt\", \"outer-compression\") else \"run\")","+            native.run_backend_phase(result, \"inspection\", directory, url, mode=\"inspect\")","+            native.run_backend_phase(result, \"control\", directory, url,","+                                     mode=\"resave\" if name in (\"outer-corrupt\", \"outer-compression\") else \"run\")","             with sqlite3.connect(directory / \"elsa.db\") as db:","                 raw_after = db.execute(\"SELECT Data FROM WorkflowInstances\").fetchone()[0]","                 result[\"afterSha256\"] = digest(raw_after)"],"additions":6,"deletions":5,"truncated":false},{"path":"core/experiments/NativeCompensation.E1/run.py","lines":["@@ -29,6 +29,14 @@ def dotnet_host():"," parser.add_argument(\"--case\", choices=(\"all\", *MATRIX_CASES), default=\"all\")"," "," ","+class BackendFailure(RuntimeError):","+    \"\"\"A failed controller phase with its captured child diagnostics intact.\"\"\"","+","+    def __init__(self, message, result):","+        super().__init__(message)","+        self.result = result","+","+"," def ledger(directory):","     with sqlite3.connect(directory / \"participant.db\") as db:","         db.row_factory = sqlite3.Row","@@ -53,53 +61,157 @@ def snapshot(directory):","         return {\"table\": table, \"rows\": rows}"," "," ","-def backend(directory, url, kill_at=None, ambient=False, handoff=\"Compensated\", mode=\"run\"):","-    command = [dotnet_host(), str(DLL), mode, str(directory), url]","-    if mode == \"run\":","-        command += [\"--barriers\"]","-    if ambient:","-        command += [\"--ambient\"]","+def backend(directory, url, kill_at=None, ambient=False, handoff=\"Compensated\", mode=\"run\",","+            timeout_seconds=90, command_override=None):","+    command = command_override or [dotnet_host(), str(DLL), mode, str(directory), url]","+    if command_override is None:","+        if mode == \"run\":","+            command += [\"--barriers\"]","+        if ambient:","+            command += [\"--ambient\"]","     environment = dict(os.environ, E1_HANDOFF=handoff)","-    process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subp