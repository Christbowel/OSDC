ent, int $size, MessageBag $bag): void","+    {","+        $value = $jwk->find($component);","+        if (! is_string($value)) {","+            $bag->add(Message::high(sprintf('Invalid key. The component \"%s\" shall be a string.', $component)));","+","+            return;","+        }","+        if (strlen(Base64UrlSafe::decodeNoPadding($value)) !== $size) {","+            $bag->add(Message::high(sprintf(","+                'Invalid key. The component \"%s\" size shall be %d bytes.',","+                $component,","+                $size","+            )));","+        }","+    }","+","+    private function checkAlgorithm(JWK $jwk, string $crv, MessageBag $bag): void","+    {","+        $alg = $jwk->find('alg');","+        if (! is_string($alg)) {","+            return;","+        }","+        $expected = self::SIGNATURE_ALGORITHMS[$crv] ?? [];","+        if (in_array($alg, $expected, true)) {","+            return;","+        }","+        $isSignatureAlgorithm = in_array($alg, array_merge(...array_values(self::SIGNATURE_ALGORITHMS)), true);","+        if ($isSignatureAlgorithm && $expected !== []) {","+            $bag->add(Message::high(sprintf(","+                'Invalid key. The algorithm \"%s\" cannot be used with the curve \"%s\"; use \"%s\".',","+                $alg,","+                $crv,","+                $expected[0]","+            )));","+","+            return;","+        }","+        if ($isSignatureAlgorithm || ($expected !== [] && str_starts_with($alg, 'ECDH-'))) {","+            $bag->add(Message::high(sprintf(","+                'Invalid key. The algorithm \"%s\" cannot be used with the curve \"%s\".',","+                $alg,","+                $crv","+            )));","+        }","+    }","+}"],"additions":101,"deletions":0,"truncated":false},{"path":"src/Library/KeyManagement/JWKFactory.php","lines":["@@ -7,12 +7,12 @@"," use Jose\\Component\\Core\\Exception\\InvalidKeyException;"," use Jose\\Component\\Core\\Exception\\MissingDependency