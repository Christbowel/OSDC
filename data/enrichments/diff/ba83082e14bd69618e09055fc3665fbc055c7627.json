*","+ * Keeps actions visible at the bottom of a scrolling surface.","+ *","+ * The footer takes its background from `--sticky-footer-background`, which","+ * Shade's Dialog sets to its own surface; anywhere else it falls back to","+ * `--background`. When the scroll container has bottom padding, the footer","+ * fills it so content doesn't show beneath the footer.","+ */"," export const StickyFooter = ({","   shiftY,","   height = 96,","@@ -17,29 +31,73 @@ export const StickyFooter = ({","   contentClassName,","   style,","   ...props","-}: StickyFooterProps) => (","-  <div","-    className={cn('sticky z-[297] m-0 box-border w-full p-0', className)}","-    style={{","-      bottom: shiftY ? `calc(${shiftY} - 24px)` : '-24px',","-      height: `${height + 24}px`,","-      ...style,","-    }}","-    {...props}","-  >","-    <div className=\"sticky bottom-0 z-[298] block h-6 bg-background\" />","+}: StickyFooterProps) => {","+  const ref = useRef<HTMLDivElement>(null);","+","+  useLayoutEffect(() => {","+    const footer = ref.current;","+    let container = footer?.parentElement ?? null;","+    while (container && !isScrollContainer(container)) {","+      container = container.parentElement;","+    }","+    if (!footer || !container) {","+      return;","+    }","+","+    const scrollContainer = container;","+    const update = () => {","+      footer.style.setProperty(","+        '--sticky-footer-inset',","+        getComputedStyle(scrollContainer).paddingBottom,","+      );","+    };","+    update();","+","+    // Responsive padding follows the window or the container's size, and a","+    // breakpoint can change the padding without resizing the content box.","+    window.addEventListener('resize', update);","+    const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(update);","+    observer?.observe(scrollContainer);","+","+    return () => {","+      window.removeEventListener('resize', update);","+      observer?.disconnect();","+    };","+  }, []);","+","+  return (","     <div","+      ref={ref}","       className={cn(","-        'sticky bottom-0 z-[299] -mb-6 flex items-center justify-between bg-background',","-        contentClassName,","+        'sticky z-[297] m-0 box-border w-full p-0 [--sticky-footer-bg:var(--sticky-footer-background,var(--background))]',","+        className,","       )}","-      style={{ height }}","+      style={{","+        bottom: shiftY ? `calc(${shiftY} - 24px)` : '-24px',","+        height: `${height + 24}px`,","+        ...style,","+      }}","+      {...props}","     >","-      {children}","+      <div className=\"sticky bottom-0 z-[298] block h-6 bg-(--sticky-footer-bg)\" />","+      <div","+        className={cn(","+          'sticky bottom-0 z-[299] -mb-6 flex items-center justify-between bg-(--sticky-footer-bg)',","+          contentClassName,","+        )}","+        style={{ height }}","+      >","+        {children}","+        {/* Fills the scroll container's bottom padding below the footer. */}","+        <div","+          aria-hidden=\"true\"","+          className=\"pointer-events-none absolute inset-x-0 top-full h-[var(--sticky-footer-inset,0px)] bg-(--sticky-footer-bg)\"","+        />","+      </div>","+      <div","+        className=\"sticky mx-2 block h-6 rounded-full shadow-[0_0_0_1px_color-mix(in_oklab,var(--border)_25%,transparent),0_-8px_16px_-3px_color-mix(in_oklab,var(--foreground)_8%,transparent)]\"","+        style={{ bottom: shiftY ? `calc(${shiftY} + ${height - 24}px)` : `${height - 24}px` }}","+      />","     </div>","-    <div","-      className=\"sticky mx-2 block h-6 rounded-full shadow-[0_0_0_1px_color-mix(in_oklab,var(--border)_25%,transparent),0_-8px_16px_-3px_color-mix(in_oklab,var(--foreground)_8%,transparent)]\"","-      style={{ bottom: shiftY ? `calc(${shiftY} + ${height - 24}px)` : `${height - 24}px` }}","-    />","-  </div>","-);","+  );","+};"],"additions":81,"deletions":23,"truncated":false},{"path":"apps/shade/test/un