\"0.31\", default-features = false, features = [","     \"trace\",","     \"logs\",","     \"metrics\",","@@ -515,9 +540,14 @@ opentelemetry-otlp = { version = \"0.29\", default-features = false, features = [","     \"grpc-tonic\",","     \"gzip-tonic\",","     \"http-proto\",","-    \"reqwest-client\",","+    # otlp drives the log exporter with futures_executor::block_on, outside any tokio","+    # runtime, so the async reqwest client panics there (\"no reactor running\"). The","+    # blocking client is the combination the sdk documents for logs, and the two","+    # client features are mutually exclusive, so it has to be this one everywhere.","+    \"reqwest-blocking-client\",","+    \"reqwest-rustls\","," ] }","-opentelemetry_sdk = { version = \"0.29\", features = [\"trace\", \"logs\", \"rt-tokio\"] }","+opentelemetry_sdk = { version = \"0.31\", features = [\"trace\", \"logs\", \"rt-tokio\"] }"," prometheus-client = \"0.22\""," prometheus-parse = \"0.2.3\""," ","@@ -560,9 +590,15 @@ databend-query = { codegen-units = 4 }"," databend-binaries = { codegen-units = 4 }"," "," [profile.dev]","+# Full debuginfo roughly doubles codegen and link time of the big crates and adds ~13GB to","+# target/. Line tables keep file:line in backtraces and profilers; for full variable/type info","+# in a debugger, build with `CARGO_PROFILE_DEV_DEBUG=true`. `cargo test` uses [profile.test].","+debug = \"line-tables-only\""," split-debuginfo = \"unpacked\""," overflow-checks = true","-# Report to https://github.com/rust-lang/rust/issues/100142 if incremental works well","+# Incremental only pays off for repeated rebuilds. For a from-scratch build (fresh clone, branch","+# switch, CI) use `CARGO_INCREMENTAL=0`: on 24 cores that is 209s instead of 249s and 14GB","+# instead of 24GB of target/."," incremental = true"," "," [profile.dev.package]","@@ -598,6 +634,7 @@ arrow-schema = { version = \"=58.4.0\" }"," arrow-select = { version = \"=58.4.0\" }"," "," [patch.crates-io]","+# Kept from main: crates.io 0.8.0 does not resolve here (pyo3 0.24 vs bendpy's 0.28)."," arrow-udf-runtime = { git = \"https://github.com/datafuse-extras/arrow-udf.git\", rev = \"c1de708add62ecd1afa2721b2e5c639f29be1f9d\" }"," async-backtrace = { git = \"https://github.com/datafuse-extras/async-backtrace.git\", rev = \"dea4553\" }"," async-recursion = { git = \"https://github.com/datafuse-extras/async-recursion.git\", rev = \"a353334\" }","@@ -609,8 +646,8 @@ databend-meta-client = { git = \"https://github.com/databendlabs/databend-meta.gi"," databend-meta-test-harness = { git = \"https://github.com/databendlabs/databend-meta.git\", tag = \"v260629.7.0\" }"," jsonb = { git = \"https://github.com/databendlabs/jsonb.git\", rev = \"fba895c\" }"," map-api = { git = \"https://github.com/databendlabs/map-api\", tag = \"v0.5.0\" }","-# Keep ORC on a patch while the upstream crate has not caught up with Arrow 58 yet.","-orc-rust = { git = \"https://github.com/datafuse-extras/orc-rust\", rev = \"fc17101f1c96e1ea7c7a19e931110471a4bd7e21\" }","+# dev: v0.2.0 plus the reqwest rustls fix (datafuse-extras/paimon-rust#1).","+paimon = { git = \"https://github.com/datafuse-extras/paimon-rust\", branch = \"dev\" }"," parquet = { git = \"https://github.com/datafuse-extras/arrow-rs.git\", rev = \"221c744\" }"," recursive = { git = \"https://github.com/datafuse-extras/recursive.git\", rev = \"16e433a\" }"," reqwest-hickory-resolver = { git = \"https://github.com/datafuse-extras/reqwest-hickory-resolver\", rev = \"5ad03257a3c702d34b9643878efb5a3536323d2d\" }"],"additions":71,"deletions":34,"truncated":false},{"path":"Makefile","lines":["@@ -19,6 +19,8 @@ lint:"," \ttypos --config .config/typos.toml"," \t# Cargo.toml file formatter(make setup to install)"," \ttaplo fmt --config .config/taplo.toml","+\t# Keep OpenSSL / aws-lc out of the dependency graph","+\t./scripts/ci/ci-check-tls-backend.sh"," \t# Python file formatter(make setup to install)"," \t# ruff format tests/"," \t# Bash file formatter(make setup to install)"],"additions":2,"deletions":0,"truncated":false},{"path":"scripts/ci/ci-check-tls-backend.sh","lines":["@@ -0,0 +1,39 @@","+#!/bin/bash","+# Copyright 2020-2025 The Databend Authors.","+# SPDX-License-Identifier: Apache-2.0.","+","+# Fails if OpenSSL or aws-lc sneaks back into the dependency graph.","+#","+# Both are C builds that sit at the very start of the clean-build critical path: everything","+# that needs `reqwest` (opendal, databend-common-exception, ...) waits for them, which costs","+# ~75s of build time. Cargo features are additive, so one dependency that asks for reqwest's","+# default TLS backend (`native-tls`) or for the `aws-lc` rustls provider brings them back for","+# the whole graph. See https://github.com/databendlabs/databend/pull/20745 for the details.","+","+set -e","+","+cd \"$(dirname \"$0\")/../..\" || exit","+","+banned=(openssl openssl-sys native-tls native-tls-crate hyper-tls aws-lc-sys aws-lc-rs)","+","+found=()","+for crate in \"${banned[@]}\"; do","+\tif grep -qx \"name = \\\"$crate\\\"\" Cargo.lock; then","+\t\tfound+=(\"$crate\")","+\tfi","+done","+","+if [[ ${#found[@]} -ne 0 ]]; then","+\techo \"Found banned crates in Cargo.lock: ${found[*]}\" >&2","+\techo >&2","+\techo \"These pull in a C build of OpenSSL or aws-lc, on the critical path of every build.\" >&2","+\techo \"To find the dependent crate:\" >&2","+\techo \"  cargo tree --workspace --target x86_64-unknown-linux-gnu -e normal,build,features -i openssl-sys\" >&2","+\techo >&2","+\techo \"Fix it by asking the dependency for a rustls backend instead, e.g.\" >&2","+\techo '  reqwest = { version = \"0.12\", default-features = false, features = [\"rustls-tls-native-roots\"] }' >&2","+\techo \"and, if it is a third-party crate that does not allow this, send it upstream or patch it.\" >&2","+\texit 1","+fi","+","+echo \"No OpenSSL or aws-lc in Cargo.lock\""],"additions":39,"deletions":0,"truncated":false},{"path":"src/common/base/src/http_client.rs","lines":["@@ -80,8 +80,8 @@ pub fn get_global_http_client(","         // Disable http2 for better performance.","         builder = builder.http1_only();"," ","-        // Enforce to use native tls backend.","-        builder = builder.use_native_tls();","+        // Enforce to use rustls (ring) backend.","+        builder = builder.use_rustls_tls();"," ","         // Set dns resolver.","         builder = builder.dns_resolver(GLOBAL_HICKORY_RESOLVER.clone());","@@ -139,8 +139,8 @@ impl HttpClient {","         // Disable http2 for better performance.","         builder = builder.http1_only();"," ","-        // Enforce to use native tls backend.","-        builder = builder.use_native_tls();","+        // Enforce to use rustls (ring) backend.","+        builder = builder.use_rustls_tls();"," ","         // Set dns resolver.","         builder = builder.dns_resolver(GLOBAL_HICKORY_RESOLVER.clone());"],"additions":4,"deletions":4,"truncated":false},{"path":"src/common/building/Cargo.toml","lines":["@@ -10,9 +10,8 @@ edition = { workspace = true }"," anyhow = { workspace = true }"," base64 = { workspace = true }"," cargo_metadata = { workspace = true }","-gix = { workspace = true }"," log = { workspace = true }","-vergen-gix = { workspace = true }","+vergen-gitcl = { workspace = true }"," "," [lints]"," workspace = true"],"additions":1,"deletions":2,"truncated":false},{"path":"src/common/building/src/git.rs","lines":["@@ -12,65 +12,88 @@"," // See the License for the specific language governing permissions and"," // limitations under the License."," ","+//! Git metadata for build scripts, read through the `git` CLI.","+//!","+//! We used to link `gix` into the build scripts, which costs ~85 CPU-seconds (125 crates) at the","+//! start of every clean build. Shelling out to `git` is what `vergen-gitcl` does as well."],"additions":4,"deletions":0,"truncated":false}],"additions":571,"deletions":2283,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-20T14:26:13.037070+00:00"}