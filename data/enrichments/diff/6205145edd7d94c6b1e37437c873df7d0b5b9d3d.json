edWith(`${window.location.origin}/report?interval=1d#usage`)","+    )","+  })","+","+  it('links to the section, so a click also moves to it', () => {","+    renderButton()","+","+    expect(screen.getByRole('link', { name: 'Copy link to section' })).toHaveAttribute(","+      'href',","+      '#usage'","+    )","+  })","+","+  it('announces the copy to screen readers only after a click', async () => {","+    renderButton()","+    expect(screen.getByRole('status')).toHaveTextContent('')","+","+    clickButton()","+","+    expect(await screen.findByRole('status')).toHaveTextContent('Link copied')","+  })","+","+  it('clears the copied state after two seconds, so the next copy is announced again', async () => {","+    vi.useFakeTimers({ toFake: ['setTimeout'] })","+    copySectionLink()","+    await act(() => vi.advanceTimersByTimeAsync(0))","+    expect(screen.getByRole('status')).toHaveTextContent('Link copied')","+","+    await act(() => vi.advanceTimersByTimeAsync(2000))","+","+    expect(screen.getByRole('status')).toHaveTextContent('')","+  })","+","+  it('restarts the two second wait when the link is copied again', async () => {","+    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] })","+    copySectionLink()","+    await act(() => vi.advanceTimersByTimeAsync(1000))","+    clickButton()","+    await act(() => vi.advanceTimersByTimeAsync(1500))","+","+    expect(screen.getByRole('status')).toHaveTextContent('Link copied')","+  })","+})"],"additions":82,"deletions":0,"truncated":false},{"path":"packages/ui/src/components/CustomHTMLElements/CopyHeadingLinkButton.tsx","lines":["@@ -0,0 +1,59 @@","+'use client'","+","+import { CheckIcon, LinkIcon } from 'lucide-react'","+import { useRef, useState } from 'react'","+","+import { copyToClipboard } from '../../lib/utils/clipboard'","+import { cn } from '../../lib/utils/cn'","+import { CrossfadeIcon } from '../CrossfadeIcon/CrossfadeIcon'","+import { Tooltip, TooltipContent, TooltipTrigger } from '../shadcn/ui/tooltip'","+","+export interface CopyHeadingLinkButtonProps {","+  id: string","+  className?: string","+}","+","+export const CopyHeadingLinkButton = ({ id, className }: CopyHeadingLinkButtonProps) => {","+  const [isCopied, setIsCopied] = useState(false)","+  const copiedTimeout = useRef<number | undefined>(undefined)","+","+  const handleClick = () => {","+    // the url keeps its query string, so a shared link opens the same filtered view","+    const url = `${window.location.href.split('#')[0]}#${id}`","+    copyToClipboard(url, () => {","+      setIsCopied(true)","+      window.clearTimeout(copiedTimeout.current)","+      copiedTimeout.current = window.setTimeout(() => setIsCopied(false), 2000)","+    })","+  }","+","+  return (","+    <>","+      <span role=\"status\" className=\"sr-only\">","+        {isCopied ? 'Link copied' : ''}","+      </span>","+      <Tooltip>","+        <TooltipTrigger asChild>","+          <a","+            href={`#${id}`}","+            aria-label=\"Copy link to section\"","+            // the tooltip repeats the label, so screen readers read it twice","+            aria-describedby={undefined}","+            onClick={handleClick}","+            className={cn(","+              'group/btn inline-flex size-7 items-center justify-center rounded-md focus-ring',","+              'transition hover:bg-accent [&_.lucide-check]:translate-y-px',","+              isCopied","+                ? 'opacity-100 bg-accent'","+                : 'opacity-0 [:hover>&]:opacity-100 focus-visible:opacity-100',","+              className","+            )}","+          >","+            <CrossfadeIcon active={isCopied} activeIcon={CheckIcon} inactiveIcon={LinkIcon} />","+          </a>","+        </TooltipTrigger>","+        <TooltipContent side=\"bottom\">Copy link to section</TooltipContent>","+      </Tooltip>","+    </>","+  )","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"packages/ui/src/components/CustomHTMLElements/Heading.tsx","lines