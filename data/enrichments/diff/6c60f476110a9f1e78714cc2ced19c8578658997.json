{"id":"6c60f476110a9f1e78714cc2ced19c8578658997","axis":"silent","repo":"open-telemetry/opentelemetry-go","sha":"6c60f476110a9f1e78714cc2ced19c8578658997","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -30,6 +30,7 @@ This project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.htm"," - Prevent a deadlock when formatting an error passed to `RecordError` calls back into the span in `go.opentelemetry.io/otel/sdk/trace`. (#8815)"," - Prevent `SimpleSpanProcessor.Shutdown` from panicking when constructed with a nil exporter in `go.opentelemetry.io/otel/sdk/trace`. (#8844)"," - Propagate invalid exponential histogram scale errors to Prometheus exporter self-observability metrics in `go.opentelemetry.io/otel/exporters/prometheus`. (#8839)","+- Ignore HTTP(S) paths when deriving gRPC trace exporter endpoints from `OTEL_EXPORTER_OTLP_ENDPOINT` and `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` in `go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc`. (#8852)"," "," <!-- Released section -->"," <!-- Don't change this section unless doing release -->"],"additions":1,"deletions":0,"truncated":false},{"path":"exporters/otlp/otlptrace/otlptracegrpc/doc.go","lines":["@@ -12,8 +12,9 @@ The environment variables described below can be used for configuration."," OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_TRACES_ENDPOINT (default: \"https://localhost:4317\") -"," target to which the exporter sends telemetry."," The target syntax is defined in https://github.com/grpc/grpc/blob/master/doc/naming.md.","-The value must contain a scheme (\"http\" or \"https\") and host.","-The value may additionally contain a port, and a path.","+If the value uses the \"http\" or \"https\" scheme, the host and optional port are","+used as the gRPC target and any path is ignored.","+Values with other schemes are passed to gRPC as-is."," The value should not contain a query string or fragment."," OTEL_EXPORTER_OTLP_TRACES_ENDPOINT takes precedence over OTEL_EXPORTER_OTLP_ENDPOINT."," The configuration can be overridden by [WithEndpoint], [WithEndpointURL], [WithInsecure], and [WithGRPCConn] options."],"additions":3,"deletions":2,"truncated":false},{"path":"exporters/otlp/otlptrace/otlptracegrpc/internal/otlpconfig/envconfig.go","lines":["@@ -119,10 +119,20 @@ func withEndpointScheme(u *url.URL) GenericOption {"," }"," "," func withEndpointForGRPC(u *url.URL) func(cfg Config) Config {","+\ttarget := u.String()","+\tswitch strings.ToLower(u.Scheme) {","+\tcase \"http\", \"https\":","+\t\ttarget = u.Host","+\tcase \"\":","+\t\tif u.Host != \"\" {","+\t\t\ttarget = path.Join(u.Host, u.Path)","+\t\t}","+\t}","+"," \treturn func(cfg Config) Config {"," \t\t// For OTLP/gRPC endpoints, this is the target to which the"," \t\t// exporter is going to send telemetry.","-\t\tcfg.Traces.Endpoint = path.Join(u.Host, u.Path)","+\t\tcfg.Traces.Endpoint = target"," \t\treturn cfg"," \t}"," }"],"additions":11,"deletions":1,"truncated":false},{"path":"exporters/otlp/otlptrace/otlptracegrpc/internal/otlpconfig/options_test.go","lines":["@@ -176,16 +176,43 @@ func TestConfigs(t *testing.T) {"," \t\t\tenv: map[string]string{"," \t\t\t\t\"OTEL_EXPORTER_OTLP_ENDPOINT\": \"https://env.endpoint/prefix\","," \t\t\t},","+\t\t\tasserts: func(t *testing.T, c *Config, grpcOption bool) { //nolint:revive // interface compliance","+\t\t\t\tassert.False(t, c.Traces.Insecure)","+\t\t\t\tassert.Equal(t, \"env.endpoint\", c.Traces.Endpoint)","+\t\t\t\tif !grpcOption {","+\t\t\t\t\tassert.Equal(t, \"/prefix/v1/traces\", c.Traces.URLPath)","+\t\t\t\t}","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"Test Environment Endpoint Without Scheme With Path\",","+\t\t\tenv: map[string]string{","+\t\t\t\t\"OTEL_EXPORTER_OTLP_ENDPOINT\": \"//env.endpoint:4317/prefix\",","+\t\t\t},"," \t\t\tasserts: func(t *testing.T, c *Config, grpcOption bool) { //nolint:revive // interface compliance"," \t\t\t\tassert.False(t, c.Traces.Insecure)"," \t\t\t\tif grpcOption {","-\t\t\t\t\tassert.Equal(t, \"e