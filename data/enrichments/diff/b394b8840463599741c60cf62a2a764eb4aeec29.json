{"id":"b394b8840463599741c60cf62a2a764eb4aeec29","axis":"silent","repo":"apache/airflow","sha":"b394b8840463599741c60cf62a2a764eb4aeec29","parsed":{"files":[{"path":"airflow-e2e-tests/docker/openlineage.yml","lines":["@@ -35,10 +35,92 @@ x-ol-common-env: &ol-common-env","   # fully-qualified class path; the OpenLineage client imports it directly.","   AIRFLOW__OPENLINEAGE__TRANSPORT: '{\"type\": \"system.openlineage.transport.variable.VariableTransport\"}'","   AIRFLOW__OPENLINEAGE__DISABLED: 'false'","-  # Deployment-wide policy required by the two conf-driven policy DAGs. Each rule is scoped by","-  # dag_id, so both rules coexist and do not affect any other DAG.","-  AIRFLOW__OPENLINEAGE__EMISSION_POLICY: '[{\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_dag\"}, \"locked\": true, \"controls\": {\"include_source_code\": false}}, {\"scope\": {\"dag_id\": \"openlineage_policy_conf_source_code_dag\"}, \"controls\": {\"include_source_code\": false}}]'","+  # Deployment-wide policy required by the conf-driven policy Dags. Rules are scoped by dag_id or by","+  # names unique to a Dag (hook/operator classes, dataset patterns), so they coexist and do not affect any other Dag.","+  # The exception is the SmoothOperator rule, which applies to every Dag: do not use SmoothOperator in other","+  # OpenLineage system tests, as its task events are never emitted.","+  AIRFLOW__OPENLINEAGE__EMISSION_POLICY: >-","+    [","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_dag\"}, \"locked\": true, \"controls\": {\"include_source_code\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_source_code_dag\"}, \"controls\": {\"include_source_code\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_extract_off\"}, \"controls\": {\"extract_operator_metadata\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_hook_off\"}, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_full_info\"}, \"controls\": {\"include_full_task_info\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_emit_off\"}, \"controls\": {\"emit\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_task_events_off\"}, \"controls\": {\"emit_task_events\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_task_events_beat_emit\"}, \"controls\": {\"emit\": false, \"emit_task_events\": true}},","+    {\"scope\": {\"operator\": \".*\\\\.PolicyConfControlsOperator\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_operator_task\"}, \"controls\": {\"hook_lineage\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_extract_overridden\"}, \"controls\": {\"extract_operator_metadata\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_hook_overridden\"}, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_emit_overridden\"}, \"controls\": {\"emit\": false}},","+    {\"scope\": {\"operator\": \".*\\\\.PolicyConfEmitOffOperator\"}, \"match_mode\": \"regex\", \"controls\": {\"emit\": false}},","+    {\"scope\": {\"operator\": \"airflow.providers.standard.operators.smooth.SmoothOperator\"}, \"controls\": {\"emit\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"grp.t_grouped\"}, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_mapped\"}, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_contr.*\", \"task_id\": \"t_regex_.*\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_conflict\"}, \"controls\": {\"hook_lineage\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_controls_dag\", \"task_id\": \"t_conflict\"}, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\", \"task_id\": \"t_locked_emit\"}, \"locked\": true, \"controls\": {\"emit\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\", \"task_id\": \"t_locked_task_events\"}, \"locked\": true, \"controls\": {\"emit_task_events\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\", \"task_id\": \"t_locked_extract\"}, \"locked\": true, \"controls\": {\"extract_operator_metadata\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\", \"task_id\": \"t_locked_hook\"}, \"locked\": true, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\", \"task_id\": \"t_locked_full\"}, \"locked\": true, \"controls\": {\"include_full_task_info\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\"}, \"locked\": true, \"controls\": {\"include_source_code\": false, \"exclude_datasets\": [\".*/dag_locked_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_conf_locked_controls_dag\", \"task_id\": \"t_floor\"}, \"controls\": {\"include_source_code\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_off_ok_child__notrigger\"}, \"controls\": {\"emit_dag_events\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_off_fail_child__notrigger\"}, \"controls\": {\"emit_dag_events\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_on_emit_off_ok_child__notrigger\"}, \"controls\": {\"emit\": false, \"emit_dag_events\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_on_emit_off_fail_child__notrigger\"}, \"controls\": {\"emit\": false, \"emit_dag_events\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_emit_off_child__notrigger\"}, \"controls\": {\"emit\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_task_events_on_emit_off_child__notrigger\"}, \"controls\": {\"emit\": false, \"emit_task_events\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_task_events_off_child__notrigger\"}, \"controls\": {\"emit_task_events\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_dag_events_locked_off_child__notrigger\"}, \"locked\": true, \"controls\": {\"emit_dag_events\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\"}, \"controls\": {\"exclude_datasets\": [\".*/conf_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\", \"hook\": \".*\\\\.AuthHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/conf_hook_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\", \"task_id\": \"t_locked\"}, \"locked\": true, \"controls\": {\"exclude_datasets\": [\".*/locked_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\", \"task_id\": \"t_locked\", \"hook\": \".*\\\\.AuthHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/specific_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\", \"task_id\": \"t_locked_hook\", \"hook\": \".*\\\\.LockedHook\"}, \"match_mode\": \"regex\", \"locked\": true, \"controls\": {\"exclude_datasets\": [\".*/locked_hook_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\", \"hook\": \".*\\\\.AuthDroppedHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_authoring_dag\", \"task_id\": \"t_locked_dropped\", \"hook\": \".*\\\\.AuthLockedDroppedHook\"}, \"match_mode\": \"regex\", \"locked\": true, \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {}, \"controls\": {\"exclude_datasets\": [\".*/exclude_datasets_global_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\"}, \"controls\": {\"exclude_datasets\": [\".*/dag_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"hook\": \".*\\\\.ConfHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/dag_hook_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_task\"}, \"controls\": {\"exclude_datasets\": [\".*/task_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_task_hook\"}, \"controls\": {\"exclude_datasets\": [\".*/task_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_task_hook\", \"hook\": \".*\\\\.ConfHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/task_hook_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_task_clear\"}, \"controls\": {\"exclude_datasets\": []}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"hook\": \".*\\\\.InvalidRuleHook\"}, \"match_mode\": \"regex\", \"controls\": {\"emit\": false, \"exclude_datasets\": [\".*/invalid_rule_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_same_tier\"}, \"controls\": {\"exclude_datasets\": [\".*/first_rule_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_same_tier\"}, \"controls\": {\"exclude_datasets\": [\".*/second_rule_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"hook\": \".*\\\\.DroppedHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"hook\": \".*\\\\.KeptHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": true}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"task_id\": \"t_task_dropped\", \"hook\": \".*\\\\.TaskDroppedHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsConfOperator\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/operator_excluded_.*\"]}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsConfOperator\", \"hook\": \".*\\\\.ConfHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/operator_hook_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_conf_dag\", \"hook\": \"airflow.providers.standard.hooks.filesystem.FSHook\"}, \"controls\": {\"exclude_datasets\": [\".*/fs_hook_excluded_.*\"]}},","+    {\"scope\": {\"hook\": \".*\\\\.ExcludeDatasetsGlobalHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/hook_excluded_.*\"]}},","+    {\"scope\": {\"hook\": \".*\\\\.ExcludeDatasetsGlobalOtherHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/other_hook_excluded_.*\"]}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsGlobalOperator\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/operator_excluded_.*\"]}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsGlobalOperator\", \"hook\": \".*\\\\.ExcludeDatasetsGlobalHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/operator_hook_excluded_.*\"]}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsGlobalClearOperator\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": []}},","+    {\"scope\": {\"hook\": \".*\\\\.ExcludeDatasetsGlobalDropHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsGlobalOperator\", \"hook\": \".*\\\\.ExcludeDatasetsGlobalOpDropHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"operator\": \".*\\\\.ExcludeDatasetsGlobalLockedOperator\"}, \"match_mode\": \"regex\", \"locked\": true, \"controls\": {\"exclude_datasets\": [\".*/operator_locked_.*\"]}},","+    {\"scope\": {\"hook\": \".*\\\\.ExcludeDatasetsGlobalLockedHook\"}, \"match_mode\": \"regex\", \"locked\": true, \"controls\": {\"exclude_datasets\": [\".*/hook_locked_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_sources_dag\"}, \"controls\": {\"exclude_datasets\": [\".*/dag_excluded_.*\", \".*sql_excluded.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_sources_dag\", \"hook\": \".*\\\\.SqlRuledHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*sql_hook_excluded.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_sources_dag\", \"hook\": \".*\\\\.SqlDroppedHook\"}, \"match_mode\": \"regex\", \"controls\": {\"hook_lineage\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_sources_dag\", \"hook\": \".*\\\\.SourceHook\"}, \"match_mode\": \"regex\", \"controls\": {\"exclude_datasets\": [\".*/hook_scoped_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_versioned_dag\"}, \"controls\": {\"exclude_datasets\": [\".*/dag_excluded_.*\"]}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_versioned_dag\", \"task_id\": \"t_skipped_emit_off\"}, \"controls\": {\"emit\": false}},","+    {\"scope\": {\"dag_id\": \"openlineage_policy_exclude_datasets_versioned_dag\", \"task_id\": \"t_skipped_full_info\"}, \"controls\": {\"include_full_task_info\": true}}","+    ]","   AIRFLOW__OPENLINEAGE__EXECUTION_TIMEOUT: '60'","+  # openlineage_policy_exclude_datasets_versioned_dag checks that exclusion runs after this cap; no other Dag","+  # registers more than a few hook lineage inputs or outputs per task, so 67 (instead of the default 100) does","+  # not affect them.","+  AIRFLOW__LINEAGE__MAX_ASSETS_PER_COLLECTOR: '67'","   # Both control how quickly the dag-processor picks up dags: REFRESH_INTERVAL is how often it","   # re-scans the folder for new/removed files, MIN_FILE_PROCESS_INTERVAL is how often it re-parses","   # a file it already knows about. Tightened from the 300s/30s defaults so the e2e run doesn't wait"],"additions":85,"deletions":3,"truncated":false},{"path":"providers/openlineage/tests/system/openlineage/example_openlineage_policy_authoring_controls_dag.py","lines":["@@ -0,0 +1,140 @@","+# Licensed to the Apache Software Foundation (ASF) under one","+# or more contributor license agreements.  See the NOTICE file","+# distributed with this work for additional information","+# regarding copyright ownership.  The ASF licenses this file","+# to you under the Apache License, Version 2.0 (the","+# \"License\"); you may not use this file except in compliance","+# with the License.  You may obtain a copy of the License at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+\"\"\"","+Dag exercising the emission policy authoring API for the controls the other authoring Dags do not.","+","+The comment above each task says which rules and authoring calls apply to it, and what its events must show.","+","+The Dag run START event reports in ``emits_ol_events`` which tasks emit, as the scheduler reads the authored flags.","+\"\"\"","+","+from __future__ import annotations","+","+from datetime import datetime","+","+from airflow import DAG","+from airflow.providers.common.compat.assets import Asset","+from airflow.providers.common.compat.lineage.hook import get_hook_lineage_collector","+from airflow.providers.common.compat.sdk import task","+from airflow.providers.openlineage.api.emission_policy import extend_global_openlineage_emission_policy","+from airflow.providers.standard.operators.bash import BashOperator","+from airflow.providers.standard.operators.python import PythonOperator","+","+from system.openlineage.constants import DEFAULT_DAGRUN_TIMEOUT","+from system.openlineage.expected_events import get_expected_event_file_path","+from system.openlineage.operator import OpenLineageTestOperator","+","+","+def _register_hook_lineage(*_):","+    collector = get_hook_lineage_collector()","+    collector.add_input_asset(context=None, uri=\"file://host1/in.txt\")","+    collector.add_output_asset(context=None, uri=\"file://host1/out.txt\")","+","+","+DAG_ID = \"openlineage_policy_authoring_controls_dag\"","+","+with DAG(","+    dagrun_timeout=DEFAULT_DAGRUN_TIMEOUT,","+    dag_id=DAG_ID,","+    start_date=datetime(2021, 1, 1),","+    schedule=None,","+    catchup=False,","+    default_args={\"retries\": 0},","+) as dag:","+    # No conf rule. Gets the Dag-level authored hook_lineage=False, as it exists at the call: no datasets, the","+    # source code stays.","+    t_dag_hook_off = PythonOperator(task_id=\"t_dag_hook_off\", python_callable=_register_hook_lineage)","+    # Gets the Dag-level authored include_full_task_info=True: bash_command is in the airflow task facet.","+    t_dag_full_info = BashOperator(task_id=\"t_dag_full_info\", bash_command=\"echo full_info\")","+    # Gets the Dag-level hook_lineage=False, then a later task-level call sets True, which wins: the hook","+    # lineage datasets are emitted.","+    t_dag_hook_back_on = PythonOperator(task_id=\"t_dag_hook_back_on\", python_callable=_register_hook_lineage)","+    # Gets the Dag-level include_full_task_info=True, then a later task-level call sets False, which wins: no","+    # bash_command.","+    t_dag_full_info_off = BashOperator(task_id=\"t_dag_full_info_off\", bash_command=\"echo full_info\")","+    # Its task-level hook_lineage=True comes first, and the later Dag-level call overwrites it with False: no","+    # datasets.","+    t_task_then_dag = extend_global_openlineage_emission_policy(","+        PythonOperator(task_id=\"t_task_then_dag\", python_callable=_register_hook_lineage),","+        hook_lineage=True,","+    )","+    # Dag-level flags only reach tasks that already exist, so the tasks defined below are left out of this call.","+    extend_global_openlineage_emission_policy(dag, hook_lineage=False, include_full_task_info=True)","+    extend_global_openlineage_emission_policy(t_dag_hook_back_on, hook_lineage=True)","+    extend_global_openlineage_emission_policy(t_dag_full_info_off, include_full_task_info=False)","+","+    # Defined after the Dag-level call, so it gets none of its flags: the hook lineage datasets are emitted.","+    t_after_dag_call = PythonOperator(task_id=\"t_after_dag_call\", python_callable=_register_hook_lineage)","+    # Authored emit_task_events=False: no task events.","+    t_task_events_off = extend_global_openlineage_emission_policy(","+        PythonOperator(task_id=\"t_task_events_off\", python_callable=_register_hook_lineage),","+        emit_task_events=False,","+    )","+    # Authored emit=False with emit_task_events=True. emit_task_events wins: the task events are emitted.","+    t_task_events_beat_emit = extend_global_openlineage_emission_policy(","+        PythonOperator(task_id=\"t_task_events_beat_emit\", python_callable=_register_hook_lineage),","+        emit=False,","+        emit_task_events=True,","+    )","+    # Authored include_full_task_info=True on the task: bash_command is in the airflow task facet.","+    t_task_full_info = extend_global_openlineage_emission_policy(","+        BashOperator(task_id=\"t_task_full_info\", bash_command=\"echo full_info\"),","+        include_full_task_info=True,","+    )","+","+    # Authored hook_lineage=False through the XComArg of a TaskFlow task. The hook lineage datasets are","+    # dropped and the declared inlets and outlets are emitted instead. TaskFlow has no extractor, so no source","+    # code.","+    @task(","+        task_id=\"t_taskflow\",","+        inlets=[Asset(uri=\"file://host1/declared_in.txt\")],","+        outlets=[Asset(uri=\"file://host1/declared_out.txt\")],","+    )","+    def t_taskflow_fn():","+        _register_hook_lineage()","+","+    t_taskflow = extend_global_openlineage_emission_policy(t_taskflow_fn(), hook_lineage=False)","+    # Authored hook_lineage=False on a mapped operator, with one instance: no datasets, the source code stays.","+    t_mapped = extend_global_openlineage_emission_policy(","+        PythonOperator.partial(task_id=\"t_mapped\", python_callable=_register_hook_lineage).expand(","+            op_args=[[1]]","+        ),","+        hook_lineage=False,","+    )","+    check_events = OpenLineageTestOperator(","+        task_id=\"check_events\", file_path=get_expected_event_file_path(DAG_ID)","+    )","+    (","+        t_dag_hook_off","+        >> t_dag_full_info","+        >> t_dag_hook_back_on","+        >> t_dag_full_info_off","+        >> t_task_then_dag","+        >> t_after_dag_call","+        >> t_task_events_off","+        >> t_task_events_beat_emit","+        >> t_task_full_info","+        >> t_taskflow","+        >> t_mapped","+        >> check_events","+    )","+","+","+from tests_common.test_utils.system_tests import get_test_run  # noqa: E402","+","+# Needed to run the example DAG with pytest (see: contributing-docs/testing/system_tests.rst)","+test_run = get_test_run(dag)"],"additions":140,"deletions":0,"truncated":false},{"path":"providers/openlineage/tests/system/openlineage/example_openlineage_policy_conf_controls_dag.py","lines":["@@ -0,0 +1,200 @@","+# Licensed to the Apache Software Foundation (ASF) under one","+# or more contributor license agreements.  See the NOTICE file","+# distributed with this work for additional information","+# regarding copyright ownership.  The ASF licenses this file","+# to you under the Apache License, Version 2.0 (the","+# \"License\"); you may not use this file except in compliance","+# with the License.  You may obtain a copy of the License at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+\"\"\"","+Dag exercising every task-level boolean emission policy control in Dag + task and operator scoped conf rules.","+","+Each task registers hook lineage, so its events show the datasets and the source code. Every control has a task","+with its rule, next to ``t_default``, which has none.","+","+The comment above each task says which rules and authoring calls apply to it, and what its events must show.","+","+The Dag run START event reports in ``emits_ol_events`` which tasks emit, as the scheduler resolves the policy for","+them, including authoring.","+","+The rules are in ``AIRFLOW__OPENLINEAGE__EMISSION_POLICY`` of ``airflow-e2e-tests/docker/openlineage.yml``.","+\"\"\"","+","+from __future__ import annotations","+","+from datetime import datetime","+","+from openlineage.client.event_v2 import Dataset","+","+from airflow import DAG","+from airflow.providers.common.compat.assets import Asset","+from airflow.providers.common.compat.lineage.hook import get_hook_lineage_collector","+from airflow.providers.common.compat.sdk import TaskGroup","+from airflow.providers.openlineage.api import emit_dataset_lineage, emit_query_lineage","+from airflow.providers.openlineage.api.emission_policy import extend_global_openlineage_emission_policy","+from airflow.providers.standard.operators.bash import BashOperator","+from airflow.providers.standard.operators.python import PythonOperator","+from airflow.providers.standard.operators.smooth import SmoothOperator","+","+from system.openlineage.constants import DEFAULT_DAGRUN_TIMEOUT","+from system.openlineage.expected_events import get_expected_event_file_path","+from system.openlineage.operator import OpenLineageTestOperator","+","+","+class PolicyConfControlsOperator(PythonOperator):","+    \"\"\"Operator with an operator scoped rule.\"\"\"","+","+","+class PolicyConfEmitOffOperator(PythonOperator):","+    \"\"\"Operator with an operator scoped ``emit: false`` rule.\"\"\"","+","+","+def _register_hook_lineage(*_):","+    collector = get_hook_lineage_collector()","+    collector.add_input_asset(context=None, uri=\"file://host1/in.txt\")","+    collector.add_output_asset(context=None, uri=\"file://host1/out.txt\")","+","+","+def _register_and_emit_lineage():","+    _register_hook_lineage()","+    emit_dataset_lineage(","+        inputs=[Dataset(namespace=\"emit://source\", name=\"in\")],","+        outputs=[Dataset(namespace=\"emit://source\", name=\"out\")],","+        raise_on_error=True,","+    )","+    emit_query_lineage(","+        inputs=[Dataset(namespace=\"emit://source\", name=\"in\")],","+        outputs=[Dataset(namespace=\"emit://source\", name=\"out\")],","+        raise_on_error=True,","+    )","+","+","+DAG_ID = \"openlineage_policy_conf_controls_dag\"","+","+with DAG(","+    dagrun_timeout=DEFAULT_DAGRUN_TIMEOUT,","+    dag_id=DAG_ID,","+    start_date=datetime(2021, 1, 1),","+    schedule=None,","+    catchup=False,","+    default_args={\"retries\": 0},","+) as dag:","+    # No rule. START/COMPLETE carry the hook lineage datasets and the Python source code: the baseline.","+    t_default = PythonOperator(task_id=\"t_default\", python_callable=_register_hook_lineage)","+    # No rule. START/COMPLETE carry the bash source code but no bash_command in the airflow task facet: the","+    # baseline for t_full_info.","+    t_default_bash = BashOperator(task_id=\"t_default_bash\", bash_command=\"echo full_info\")","+    # Conf Dag + task rule extract_operator_metadata: false. START/COMPLETE carry no datasets and no source","+    # code.","+    t_extract_off = PythonOperator(task_id=\"t_extract_off\", python_callable=_register_hook_lineage)","+    # Conf Dag + task rule hook_lineage: false. START/COMPLETE carry no datasets, the source code stays.","+    t_hook_off = PythonOperator(task_id=\"t_hook_off\", python_callable=_register_hook_lineage)","+    # Conf Dag + task rule include_full_task_info: true. START/COMPLETE carry bash_command in the airflow task","+    # facet.","+    t_full_info = BashOperator(task_id=\"t_full_info\", bash_command=\"echo full_info\")","+    # Conf Dag + task rule emit: false. No task events, and its emit_dataset_lineage and emit_query_lineage","+    # calls emit nothing either.","+    t_emit_off = PythonOperator(task_id=\"t_emit_off\", python_callable=_register_and_emit_lineage)","+    # Conf Dag + task rule emit_task_events: false. No task events.","+    t_task_events_off = PythonOperator(task_id=\"t_task_events_off\", python_callable=_register_hook_lineage)","+    # Conf Dag + task rule emit: false with emit_task_events: true. emit_task_events wins, so START/COMPLETE","+    # are emitted with the datasets.","+    t_task_events_beat_emit = PythonOperator(","+        task_id=\"t_task_events_beat_emit\", python_callable=_register_hook_lineage","+    )","+    # Conf operator rule (regex on PolicyConfControlsOperator) hook_lineage: false. The hook lineage datasets","+    # are dropped, so START/COMPLETE carry the declared inlets and outlets instead. The operator has no","+    # extractor, so no source code.","+    t_operator_conf = PolicyConfControlsOperator(","+        task_id=\"t_operator_conf\",","+        python_callable=_register_hook_lineage,","+        inlets=[Asset(uri=\"file://host1/declared_in.txt\")],","+        outlets=[Asset(uri=\"file://host1/declared_out.txt\")],","+    )","+    # The same operator rule, but a Dag + task rule sets hook_lineage: true and wins as the more specific","+    # rule. COMPLETE carries the hook lineage datasets instead of the declared ones, START only the declared","+    # ones.","+    t_operator_task = PolicyConfControlsOperator(","+        task_id=\"t_operator_task\",","+        python_callable=_register_hook_lineage,","+        inlets=[Asset(uri=\"file://host1/declared_in.txt\")],","+        outlets=[Asset(uri=\"file://host1/declared_out.txt\")],","+    )","+    # Conf Dag + task rule extract_operator_metadata: false, unlocked. The authored True wins: datasets and","+    # source code are emitted.","+    t_extract_overridden = extend_global_openlineage_emission_policy(","+        PythonOperator(task_id=\"t_extract_overridden\", python_callable=_register_hook_lineage),","+        extract_operator_metadata=True,","+    )","+    # Conf Dag + task rule hook_lineage: false, unlocked. The authored True wins: the hook lineage datasets","+    # are emitted.","+    t_hook_overridden = extend_global_openlineage_emission_policy(","+        PythonOperator(task_id=\"t_hook_overridden\", python_callable=_register_hook_lineage),","+        hook_lineage=True,","+    )","+    # Conf Dag + task rule emit: false, unlocked. The authored True wins: START/COMPLETE are emitted.","+    t_emit_overridden = extend_global_openlineage_emission_policy(","+        PythonOperator(task_id=\"t_emit_overridden\", python_callable=_register_hook_lineage),","+        emit=True,","+    )","+    # Conf operator rule (regex on PolicyConfEmitOffOperator) emit: false. No task events.","+    t_operator_emit_off = PolicyConfEmitOffOperator(","+        task_id=\"t_operator_emit_off\", python_callable=_register_hook_lineage","+    )","+    # Conf operator rule with the exact class path of SmoothOperator (default match_mode) emit: false. No task","+    # events.","+    t_exact_operator = SmoothOperator(task_id=\"t_exact_operator\")","+    with TaskGroup(\"grp\"):","+        # Conf Dag + task rule naming the task by its full id grp.t_grouped, hook_lineage: false. No datasets,","+        # the source code stays.","+        t_grouped = PythonOperator(task_id=\"t_grouped\", python_callable=_register_hook_lineage)","+    # Conf Dag + task rule hook_lineage: false, applied to the one mapped instance. No datasets, the source","+    # code stays.","+    t_mapped = PythonOperator.partial(task_id=\"t_mapped\", python_callable=_register_hook_lineage).expand(","+        op_args=[[1]]","+    )","+    # Conf rule with match_mode regex on both the dag_id and the task_id, hook_lineage: false. No datasets,","+    # the source code stays.","+    t_regex_task = PythonOperator(task_id=\"t_regex_task\", python_callable=_register_hook_lineage)","+    # Two conf Dag + task rules, hook_lineage: true then false. The last one wins: no datasets, the source","+    # code stays.","+    t_conflict = PythonOperator(task_id=\"t_conflict\", python_callable=_register_hook_lineage)","+    check_events = OpenLineageTestOperator(","+        task_id=\"check_events\", file_path=get_expected_event_file_path(DAG_ID)","+    )","+    (","+        t_default","+        >> t_default_bash","+        >> t_extract_off","+        >> t_hook_off","+        >> t_full_info","+        >> t_emit_off","+        >> t_task_events_off","+        >> t_task_events_beat_emit","+        >> t_operator_conf","+        >> t_operator_task","+        >> t_extract_overridden","+        >> t_hook_overridden","+        >> t_emit_overridden","+        >> t_operator_emit_off","+        >> t_exact_operator","+        >> t_grouped","+        >> t_mapped"],"additions":190,"deletions":0,"truncated":false}],"additions":415,"deletions":3,"truncated":true,"file_count":3},"error":null,"fetched_at":"2026-10-29T15:19:41.487692+00:00"}