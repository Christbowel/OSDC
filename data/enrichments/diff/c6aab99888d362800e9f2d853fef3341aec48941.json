 Arc::new(config);","+","+    let server_name = ServerName::try_from(\"localhost\").unwrap();","+    let mut ticket = NewSessionTicketPayloadTls13::new(","+        Duration::from_secs(1800),","+        0x1234_5678,","+        [0u8; 32],","+        b\"ticket\".to_vec(),","+    );","+    ticket.extensions.max_early_data_size = Some(1024);","+    store.insert_tls13_ticket(","+        ClientSessionKey {","+            config_hash: config.config_hash(),","+            server_name: server_name.clone(),","+        },","+        Tls13Session::new(","+            &ticket,","+            Tls13ClientSessionInput {","+                suite: Tls13ProtocolSuite::Tcp(TLS13_TEST_SUITE),","+                peer_identity: VerifiedIdentity::assertion(Identity::RawPublicKey(","+                    pki_types::SubjectPublicKeyInfoDer::from(&b\"spki\"[..]),","+                )),","+                quic_params: None,","+                alpn: Some(ApplicationProtocol::Http2),","+            },","+            &[0x55; 32],","+            UnixTime::now(),","+        ),","+    );","+","+    let mut tls = Vec::new();","+    let mut conn = config","+        .connect(server_name)","+        .with_alpn(vec![","+            ApplicationProtocol::Http2,","+            ApplicationProtocol::Http11,","+        ])","+        .build(&mut tls)","+        .unwrap();","+    let ch = client_hello_in(&tls);","+    assert!(ch.early_data_request.is_some());","+","+    let sh = Message {","+        version: EncodableVersion::Legacy(ProtocolVersion::TLSv1_3),","+        payload: MessagePayload::handshake(HandshakeMessagePayload(HandshakePayload::ServerHello(","+            ServerHelloPayload {","+                random: Random([0; 32]),","+                compression_method: Compression::Null,","+                cipher_suite: TLS13_TEST_SUITE.suite(),","+                legacy_version: ProtocolVersion::TLSv1_2,","+                session_id: ch.session_id,","+                extensions: Box::new(ServerExtensions {