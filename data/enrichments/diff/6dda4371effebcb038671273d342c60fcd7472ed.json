d after it has","+ * loaded: once it runs it replaces the queue with `{ push: registerChunk }`.","+ * The entry's runtime modules can then be instantiated from within this inline","+ * script, so they mustn't depend on `document.currentScript` being one of the","+ * chunk scripts (see `appBootstrap`).","+ */","+export function getTurbopackBootstrapScriptTag(","+  scriptContent: string,","+  nonce: string | undefined","+): string {","+  const startScriptTag = nonce","+    ? `<script nonce=\"${htmlEscapeAttributeString(nonce)}\">`","+    : '<script>'","+","+  // The bootstrap is `globalThis[<JSON string>].push(<JSON params>)`: the only","+  // characters that need escaping can only appear inside its JSON string","+  // literals, where the `\\uXXXX` escapes keep their value.","+  return `${startScriptTag}${htmlEscapeJsonString(scriptContent)}</script>`","+}","+","+export function createTurbopackBootstrapScriptStream(","+  scriptContent: string,","+  nonce: string | undefined","+): ReadableStream<Uint8Array> {","+  return streamFromString(getTurbopackBootstrapScriptTag(scriptContent, nonce))","+}","+","+/**","+ * The Turbopack bootstrap script for `page`, for serving a Cache Components","+ * static shell on its own, without the resume that would otherwise emit it.","+ * Returns undefined when the build doesn't inline a bootstrap for the page.","+ */","+export function createTurbopackBootstrapScriptStreamForPage(","+  buildManifest: BuildManifest,","+  page: string,","+  nonce: string | undefined","+): ReadableStream<Uint8Array> | undefined {","+  if (","+    !buildManifest.pagesChunkGroupBootstrapParams ||","+    !buildManifest.chunkLoadingGlobal","+  ) {","+    return undefined","+  }","+  const scriptContent = getTurbopackChunkGroupBootstrap(","+    buildManifest.pagesChunkGroupBootstrapParams,","+    buildManifest.chunkLoadingGlobal,","+    [page]","+  )","+  return scriptContent","+    ? createTurbopackBootstrapScriptStream(scriptContent, nonce)","+    : undefined",