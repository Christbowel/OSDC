Metrics.Recorder(repoType),","+\t}","+}","+","+// writableClient returns a client whose staged writer accepts every write.","+func writableClient() *mocks.FakeClient {","+\tclient := &mocks.FakeClient{}","+\tclient.GetRefReturns(nanogit.Ref{Name: \"refs/heads/main\", Hash: hash.Hash{}}, nil)","+\twriter := &mocks.FakeStagedWriter{}","+\twriter.CreateBlobReturns(hash.Hash{}, nil)","+\twriter.UpdateBlobReturns(hash.Hash{}, nil)","+\twriter.DeleteBlobReturns(hash.Hash{}, nil)","+\twriter.CommitReturns(&nanogit.Commit{}, nil)","+\twriter.PushReturns(nil)","+\tclient.NewStagedWriterReturns(writer, nil)","+\treturn client","+}","+","+// TestGitRepository_OperationMetrics pins the contract that callers rely on:","+// every operation on the repository interface is observed once, by the","+// repository itself, with no help from the caller.","+func TestGitRepository_OperationMetrics(t *testing.T) {","+\tctx := context.Background()","+","+\tt.Run(\"read\", func(t *testing.T) {","+\t\tclient := &mocks.FakeClient{}","+\t\tclient.GetRefReturns(nanogit.Ref{Name: \"refs/heads/main\", Hash: hash.Hash{}}, nil)","+\t\tclient.GetCommitReturns(&nanogit.Commit{Tree: hash.Hash{}}, nil)","+\t\tclient.GetBlobByPathReturns(&nanogit.Blob{Content: []byte(\"0123456789\")}, nil)","+\t\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, client)","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\t_, err := repo.Read(ctx, \"test.yaml\", \"main\")","+\t\trequire.NoError(t, err)","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationRead, \"success\")-before.count(repository.OperationRead, \"success\"))","+\t\tassert.Equal(t, 10.0, after.size(repository.OperationRead)-before.size(repository.OperationRead))","+\t})","+","+\tt.Run(\"failed read\", func(t *testing.T) {","+\t\tclient := &mocks.FakeClient{}","+\t\tclient.GetRefReturns(nanogit.Ref{Name: \"refs/heads/main\", Hash: hash.Hash{}}, nil)","+\t\tclient.GetCommitReturns(&nanogit.Commit{Tree: hash.Hash{}}, nil)","+\t\tclient.GetBlobByPathReturns(nil, nanogit.ErrObjectNotFound)","+\t\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, client)","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\t_, err := repo.Read(ctx, \"missing.yaml\", \"main\")","+\t\trequire.ErrorIs(t, err, repository.ErrFileNotFound)","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationRead, \"error\")-before.count(repository.OperationRead, \"error\"))","+\t\tassert.Equal(t, 0.0, after.size(repository.OperationRead)-before.size(repository.OperationRead),","+\t\t\t\"a failed read has no size to report\")","+\t})","+","+\tt.Run(\"list\", func(t *testing.T) {","+\t\tclient := &mocks.FakeClient{}","+\t\tclient.GetRefReturns(nanogit.Ref{Name: \"refs/heads/main\", Hash: hash.Hash{}}, nil)","+\t\tclient.GetFlatTreeReturns(&nanogit.FlatTree{Entries: []nanogit.FlatTreeEntry{{","+\t\t\tPath: \"configs/test.yaml\", Hash: hash.Hash{}, Type: protocol.ObjectTypeBlob,","+\t\t}}}, nil)","+\t\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, client)","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\t_, err := repo.ReadTree(ctx, \"main\")","+\t\trequire.NoError(t, err)","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationList, \"success\")-before.count(repository.OperationList, \"success\"))","+\t})","+","+\tt.Run(\"create, update, delete and move\", func(t *testing.T) {","+\t\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, writableClient())","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\trequire.NoError(t, repo.Create(ctx, \"test.yaml\", \"main\", []byte(\"0123456789\"), \"create\"))","+\t\trequire.NoError(t, repo.Update(ctx, \"test.yaml\", \"main\", []byte(\"updated\"), \"update\"))","+\t\trequire.NoError(t, repo.Delete(ctx, \"test.yaml\", \"main\", \"delete\"))","+\t\trequire.NoError(t, repo.Move(ctx, \"test.yaml\", \"moved.yaml\", \"main\", \"move\"))","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 2.0, after.count(repository.OperationWrite, \"success\")-before.count(repository.OperationWrite, \"success\"))","+\t\tassert.Equal(t, 17.0, after.size(repository.OperationWrite)-before.size(repository.OperationWrite))","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationDelete, \"success\")-before.count(repository.OperationDelete, \"success\"))","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationMove, \"success\")-before.count(repository.OperationMove, \"success\"))","+\t})","+","+\t// Write delegates to Read plus Create, so it must not add a write of its own","+\t// on top of the one Create already records.","+\tt.Run(\"write is counted once, by the operation it delegates to\", func(t *testing.T) {","+\t\tclient := writableClient()","+\t\tclient.GetCommitReturns(&nanogit.Commit{Tree: hash.Hash{}}, nil)","+\t\tclient.GetBlobByPathReturns(nil, nanogit.ErrObjectNotFound)","+\t\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, client)","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\trequire.NoError(t, repo.Write(ctx, \"new.yaml\", \"main\", []byte(\"written\"), \"write\"))","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationWrite, \"success\")-before.count(repository.OperationWrite, \"success\"))","+\t\tassert.Equal(t, 7.0, after.size(repository.OperationWrite)-before.size(repository.OperationWrite))","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationRead, \"error\")-before.count(repository.OperationRead, \"error\"),","+\t\t\t\"the existence check is the read it performed\")","+\t})","+","+\tt.Run(\"labels follow the configured repository type\", func(t *testing.T) {","+\t\trepo := newMetricsRepo(t, provisioning.GitHubRepositoryType, writableClient())","+","+\t\tbefore := gitSnapshot(t, provisioning.GitHubRepositoryType)","+\t\trequire.NoError(t, repo.Delete(ctx, \"test.yaml\", \"main\", \"delete\"))","+\t\tafter := gitSnapshot(t, provisioning.GitHubRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationDelete, \"success\")-before.count(repository.OperationDelete, \"success\"))","+\t})","+}","+","+func TestStagedGitRepository_OperationMetrics(t *testing.T) {","+\tctx := context.Background()","+\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, writableClient())","+","+\t// StageModeCommitOnlyOnce defers the commit to Push, so the writes below","+\t// only touch the staged writer.","+\tstaged, err := NewStagedGitRepository(ctx, repo, repository.StageOptions{","+\t\tRef:  \"main\",","+\t\tMode: repository.StageModeCommitOnlyOnce,","+\t})","+\trequire.NoError(t, err)","+","+\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\trequire.NoError(t, staged.Create(ctx, \"test.yaml\", \"main\", []byte(\"0123456789\"), \"create\"))","+\trequire.NoError(t, staged.Update(ctx, \"test.yaml\", \"main\", []byte(\"updated\"), \"update\"))","+\trequire.NoError(t, staged.Delete(ctx, \"test.yaml\", \"main\", \"delete\"))","+\trequire.NoError(t, staged.Move(ctx, \"test.yaml\", \"moved.yaml\", \"main\", \"move\"))","+\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\tassert.Equal(t, 2.0, after.count(repository.OperationWrite, \"success\")-before.count(repository.OperationWrite, \"success\"))","+\tassert.Equal(t, 17.0, after.size(repository.OperationWrite)-before.size(repository.OperationWrite))","+\tassert.Equal(t, 1.0, after.count(repository.OperationDelete, \"success\")-before.count(repository.OperationDelete, \"success\"))","+\tassert.Equal(t, 1.0, after.count(repository.OperationMove, \"success\")-before.count(repository.OperationMove, \"success\"))","+\tassert.Equal(t, 0.0, after.count(repository.OperationPush, \"success\")-before.count(repository.OperationPush, \"success\"),","+\t\t\"StageModeCommitOnlyOnce defers the remote round trip to Push\")","+}","+","+// A staged write only stages a blob; the writes reach the remote in Push. These","+// pin that Push is where that outcome and latency are observed, so a batch that","+// never landed is visible even though its staged writes succeeded.","+func TestStagedGitRepository_PushMetrics(t *testing.T) {","+\tctx := context.Background()","+","+\tnewStaged := func(t *testing.T, client *mocks.FakeClient) repository.StagedRepository {","+\t\tt.Helper()","+\t\trepo := newMetricsRepo(t, provisioning.GitRepositoryType, client)","+\t\tstaged, err := NewStagedGitRepository(ctx, repo, repository.StageOptions{","+\t\t\tRef:  \"main\",","+\t\t\tMode: repository.StageModeCommitOnlyOnce,","+\t\t})","+\t\trequire.NoError(t, err)","+\t\treturn staged","+\t}","+","+\tt.Run(\"a successful push is recorded\", func(t *testing.T) {","+\t\tstaged := newStaged(t, writableClient())","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\trequire.NoError(t, staged.Push(ctx))","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationPush, \"success\")-before.count(repository.OperationPush, \"success\"))","+\t})","+","+\tt.Run(\"a failed push is recorded as an error, even though the staged write succeeded\", func(t *testing.T) {","+\t\tclient := writableClient()","+\t\twriter := &mocks.FakeStagedWriter{}","+\t\twriter.CreateBlobReturns(hash.Hash{}, nil)","+\t\twriter.CommitReturns(&nanogit.Commit{}, nil)","+\t\twriter.PushReturns(errors.New(\"remote rejected\"))","+\t\tclient.NewStagedWriterReturns(writer, nil)","+\t\tstaged := newStaged(t, client)","+","+\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\trequire.NoError(t, staged.Create(ctx, \"test.yaml\", \"main\", []byte(\"staged\"), \"create\"))","+\t\trequire.Error(t, staged.Push(ctx))","+\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationWrite, \"success\")-before.count(repository.OperationWrite, \"success\"),","+\t\t\t\"staging the blob did succeed\")","+\t\tassert.Equal(t, 1.0, after.count(repository.OperationPush, \"error\")-before.count(repository.OperationPush, \"error\"),","+\t\t\t\"the batch not reaching the remote is what shows up as a failure\")","+\t})","+","+\tt.Run(\"a push with nothing to send is not a failure\", func(t *testing.T) {","+\t\tfor _, tt := range []struct {","+\t\t\tname string","+\t\t\terr  error","+\t\t}{","+\t\t\t{\"nothing to push\", nanogit.ErrNothingToPush},","+\t\t\t{\"nothing to commit\", nanogit.ErrNothingToCommit},","+\t\t} {","+\t\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\t\tclient := writableClient()","+\t\t\t\twriter := &mocks.FakeStagedWriter{}","+\t\t\t\twriter.CommitReturns(&nanogit.Commit{}, nil)","+\t\t\t\twriter.PushReturns(tt.err)","+\t\t\t\tclient.NewStagedWriterReturns(writer, nil)","+\t\t\t\tstaged := newStaged(t, client)","+","+\t\t\t\tbefore := gitSnapshot(t, provisioning.GitRepositoryType)","+\t\t\t\trequire.Error(t, staged.Push(ctx))","+\t\t\t\tafter := gitSnapshot(t, provisioning.GitRepositoryType)","+","+\t\t\t\tassert.Equal(t, 1.0, after.count(repository.OperationPush, \"success\")-before.count(repository.OperationPush, \"success\"))","+\t\t\t\tassert.Equal(t, 0.0, after.count(repository.OperationPush, \"error\")-before.count(repository.OperationPush, \"error\"))","+\t\t\t})","+\t\t}","+\t})","+}","+","+// metricSnapshot holds the operation samples for one repository type at a point","+// in time, so assertions can be made on deltas rather than absolute values.","+type metricSnapshot struct {","+\tcounts map[string]float64","+\tsizes  map[string]float64","+}","+","+func (s metricSnapshot) count(operation, outcome string) float64 {","+\treturn s.counts[operation+\"/\"+outcome]","+}","+","+func (s metricSnapshot) size(operation string) flo