tions":1,"truncated":false},{"path":"src/coredump/coredump-kernel-helper.c","lines":["@@ -12,8 +12,9 @@"," #include \"format-util.h\""," #include \"log.h\""," #include \"signal-util.h\"","+#include \"strv.h\""," ","-int coredump_kernel_helper(int argc, char *argv[]) {","+int coredump_kernel_helper(char **metadata) {","         _cleanup_(coredump_context_done) CoredumpContext context = COREDUMP_CONTEXT_NULL;","         int r;"," ","@@ -37,7 +38,7 @@ int coredump_kernel_helper(int argc, char *argv[]) {","         log_debug(\"Processing coredump received from the kernel...\");"," ","         /* Collect all process metadata passed by the kernel through argv[] */","-        r = coredump_context_parse_from_argv(&context, argc - 1, argv + 1);","+        r = coredump_context_parse_from_argv(&context, (int) strv_length(metadata), metadata);","         if (r < 0)","                 return r;"," "],"additions":3,"deletions":2,"truncated":false},{"path":"src/coredump/coredump-kernel-helper.h","lines":["@@ -1,4 +1,4 @@"," /* SPDX-License-Identifier: LGPL-2.1-or-later */"," #pragma once"," ","-int coredump_kernel_helper(int argc, char *argv[]);","+int coredump_kernel_helper(char **metadata);"],"additions":1,"deletions":1,"truncated":false},{"path":"src/coredump/coredump.c","lines":["@@ -1,7 +1,9 @@"," /* SPDX-License-Identifier: LGPL-2.1-or-later */"," "," #include \"sd-daemon.h\"","+#include \"sd-json.h\""," ","+#include \"build.h\""," #include \"coredump-backtrace.h\""," #include \"coredump-kernel-helper.h\""," #include \"coredump-manager.h\"","@@ -10,7 +12,64 @@"," #include \"dlopen-note.h\""," #include \"log.h\""," #include \"main-func.h\"","-#include \"string-util.h\"","+#include \"strv.h\"","+#include \"verbs.h\"","+","+COMMAND(","+        \"systemd-coredump\\0\",","+        \"Acquire, save, and process core dumps.\",","+        .argspec = \"[METADATA…]\\0\",","+        .man_pages = \"systemd-coredump(8)\\0\",","+);","+","+typedef enum CoredumpMode {","+        COREDUMP_MODE_KERNEL_HELPER,      /* Run as a privileged helper binary invoked by the kernel */","+        COREDUMP_MODE_BACKTRACE,          /* Log a backtrace received on standard input */","+        COREDUMP_MODE_CHECK_REQUIREMENTS, /* Check whether core dumps can be processed */","+        COREDUMP_MODE_MANAGER,            /* Run as the core dump manager handling */","+} CoredumpMode;","+","+static CoredumpMode arg_mode = COREDUMP_MODE_KERNEL_HELPER;","+","+static int parse_argv(int argc, char *argv[], char ***ret_args) {","+        assert(argc >= 0);","+        assert(argv);","+        assert(ret_args);","+","+        /* The kernel passes the core_pattern fields after our own options, starting with the PID. Some of","+         * them, like the hostname, are under the control of the crashing process, so they must never be","+         * looked at as options: stop parsing at the first positional argument. */","+        OptionParser opts = { argc, argv, OPTION_PARSER_STOP_AT_FIRST_NONOPTION };","+","+        FOREACH_OPTION_OR_RETURN(c, &opts)","+                switch (c) {","+","+                OPTION_COMMON_HELP:","+                        return command_print_help();","+","+                OPTION_COMMON_VERSION:","+                        return version();","+","+                OPTION_LONG_DATA(\"backtrace\", NULL, /* data= */ COREDUMP_MODE_BACKTRACE,","+                                 \"Log a backtrace received on standard input\"): {}","+                OPTION_LONG_DATA(\"check-requirements\", NULL, /* data= */ COREDUMP_MODE_CHECK_REQUIREMENTS,","+                                 \"Check whether core dumps can be processed\"): {}","+                OPTION_LONG_DATA(\"manager\", NULL, /* data= */ COREDUMP_MODE_MANAGER,","+                                 \"Run as the core dump manager\"):","+                        if (arg_mode != COREDUMP_MODE_KERNEL_HELPER)","+                                return log_error_errno(","+                                                SYNTHETIC_ERRNO(EINVAL),","+                                                \"Only one of --backtrace, --check-requirements, and --manager may be specified.\");","+                        arg_mode = opts.opt->data;","+                        break;","+","+                OPTION_COMMON_INTROSPECT_CLI:","+                        return introspect_cli(SD_JSON_FORMAT_OFF);","+                }","+","+        *ret_args = option_parser_get_args(&opts);","+        return 1;","+}"," "," static int run(int argc, char *argv[]) {","         int r;","@@ -21,12 +80,20 @@ static int run(int argc, char *argv[]) {","         LIBELF_NOTE(suggested);","         LIBSELINUX_NOTE(recommended);"," ","+        char **args = NULL;","+        r = parse_argv(argc, argv, &args);","+        if (r <= 0)","+                return r;","+","+        if (IN_SET(arg_mode, COREDUMP_MODE_CHECK_REQUIREMENTS, COREDUMP_MODE_MANAGER) && !strv_isempty(args))","+                return log_error_errno(SYNTHETIC_ERRNO(EINVAL), \"Too many arguments.\");","+","         /* When running as backtrace mode, it is not necessary to use kmsg, not necessary to disable coredump","          * from the command, and unexpectedly passed file descriptors can be silently ignored. */","-        if (streq_ptr(argv[1], \"--backtrace\"))","-                return coredump_backtrace(argc, argv);","+        if (arg_mode == COREDUMP_MODE_BACKTRACE)","+                return coredump_backtrace(args);"," ","-        if (streq_ptr(argv[1], \"--check-requirements\")) {","+        if (arg_mode == COREDUMP_MODE_CHECK_REQUIREMENTS) {","                 log_setup();","                 return coredump_manager_check_requirements(LOG_DEBUG);","         }","@@ -34,7 +101,7 @@ static int run(int argc, char *argv[]) {","         /* Make sure we never enter a loop. */","         (void) set_dumpable(SUID_DUMP_DISABLE);"," ","-        if (streq_ptr(argv[1], \"--manager\"))","+        if (arg_mode == COREDUMP_MODE_MANAGER)","                 return coredump_manager();"," ","         /* First, log to a safe place, since we don't know what crashed and it might be journald which we'd","@@ -49,7 +116,7 @@ static int run(int argc, char *argv[]) {","         /* If we got an fd passed, we are running in coredumpd mode. Otherwise we are invoked from the","          * kernel as coredump handler. */","         if (r == 0)","-                return coredump_kernel_helper(argc, argv);","+                return coredump_kernel_helper(args);","         if (r == 1)","                 return coredump_receive(SD_LISTEN_FDS_START);"," "],"additions":73,"deletions":6,"truncated":false},{"path":"test/units/TEST-74-AUX-UTILS.introspect-cli.sh","lines":["@@ -74,6 +74,7 @@ INTROSPECTABLE=(","     systemd-clonesetup","     systemd-clonesetup-generator","     systemd-confext","+    systemd-coredump","     systemd-creds","     systemd-cryptenroll","     systemd-cryptsetup",""],"additions":1,"deletions":0,"truncated":false}],"additions":85,"deletions":15,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-22T13:47:40.911990+00:00"}