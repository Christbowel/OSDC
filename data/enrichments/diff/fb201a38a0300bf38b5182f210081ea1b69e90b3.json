/locale', array_merge($headers, [","+                'x-forwarded-ip' => $value,","+            ]));","+            $this->assertEquals(200, $response['headers']['status-code']);","+            $this->assertEquals($direct['body']['ip'], $response['body']['ip'], \"Forwarded value '{$value}' should fall back to the request address\");","+        }","+    }"," }"],"additions":46,"deletions":0,"truncated":false},{"path":"tests/unit/Utopia/RequestTest.php","lines":["@@ -6,6 +6,7 @@"," "," use Appwrite\\SDK\\Method;"," use Appwrite\\SDK\\Parameter;","+use Appwrite\\Utopia\\Database\\Documents\\User;"," use Appwrite\\Utopia\\Request;"," use Appwrite\\Utopia\\Request\\Filter;"," use PHPUnit\\Framework\\Attributes\\DataProvider;","@@ -14,6 +15,7 @@"," use Tests\\Unit\\Utopia\\Request\\Filters\\First;"," use Tests\\Unit\\Utopia\\Request\\Filters\\Second;"," use Tests\\Unit\\Utopia\\Request\\Filters\\ThrowingFilter;","+use Utopia\\Database\\Validator\\Authorization;"," use Utopia\\Http\\Route;"," "," final class RequestTest extends TestCase","@@ -102,6 +104,61 @@ public function testGetHostnameHonorsForwardedHostFromTrustedProxy(): void","         }","     }"," ","+    #[DataProvider('forwardedIPCases')]","+    public function testGetClientIPHonorsForwardedIPFromKey(string $forwardedIP, string $expected): void","+    {","+        $request = $this->requestWithForwardedIP($forwardedIP, User::ROLE_KEYS);","+","+        $this->assertSame($expected, $request->getClientIP());","+        $this->assertSame('203.0.113.10', $request->getIP());","+    }","+","+    public function testGetClientIPIgnoresForwardedIPWithoutKey(): void","+    {","+        $request = $this->requestWithForwardedIP('198.51.100.7', User::ROLE_USERS);","+","+        $this->assertSame('203.0.113.10', $request->getClientIP());","+    }","+","+    public function testGetClientIPIgnoresForwardedIPBeforeAuthorization(): void","+    {","+        $swoole = new SwooleRequest();","+        $swoole->server = ['remote_addr' 