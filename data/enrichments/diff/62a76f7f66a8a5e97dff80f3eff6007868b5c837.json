 as $type) {","+            $patched = $this->client->call(Client::METHOD_PATCH, \"/messaging/messages/{$type}/\" . $message['$id'], $headers + $writeKey, ['draft' => true]);","+            $this->assertSame(200, $patched['headers']['status-code']);","+            $this->assertArrayNotHasKey('url', $patched['body']['data']['image']);","+        }","+","+        $fileReader = ['x-appwrite-key' => $this->getNewKey(['messages.read', 'files.read'])];","+","+        $read = $this->client->call(Client::METHOD_GET, '/messaging/messages/' . $message['$id'], $headers + $fileReader);","+        $this->assertSame($imageUrl, $read['body']['data']['image']['url']);","+","+        $list = $this->client->call(Client::METHOD_GET, '/messaging/messages', $headers + $fileReader, $listQueries);","+        $this->assertSame($imageUrl, $list['body']['messages'][0]['data']['image']['url']);","+","         $client = new Client();","         $client->setEndpoint('');"," ",""],"additions":33,"deletions":0,"truncated":false}],"additions":75,"deletions":11,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-05T16:28:00.982661+00:00"}