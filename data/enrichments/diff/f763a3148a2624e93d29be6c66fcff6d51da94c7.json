ntent'));","     }"," ","+    public static function searchLevelsIncludeThePagesBelowThePageDataProvider(): iterable","+    {","+        yield 'admin, live' => [1, 8300, 0, [8911, 8912]];","+        yield 'admin, workspace with a page only existing in it' => [1, 8300, 1, [8911, 8912, 8913]];","+        yield 'admin, page not shown to everybody' => [1, 8303, 0, [8914, 8915, 8916]];","+        yield 'editor, page tree root searches the web mounts without pages not shown' => [10, 0, 0, [8914]];","+        yield 'editor, page without pages not shown' => [10, 8303, 0, [8914]];","+    }","+","+    #[DataProvider('searchLevelsIncludeThePagesBelowThePageDataProvider')]","+    #[Test]","+    public function searchLevelsIncludeThePagesBelowThePage(int $backendUserId, int $pageId, int $workspaceId, array $expectedUids): void","+    {","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/search_levels_workspace.csv');","+        $backendUser = $this->setUpBackendUser($backendUserId);","+        $backendUser->workspace = $workspaceId;","+        $recordList = $this->get(DatabaseRecordList::class);","+        $recordList->setRequest(new ServerRequest('http://localhost/'));","+        $recordList->start($pageId, 'tt_content', 0, '', 99);","+        $queryBuilder = $this->get(ConnectionPool::class)->getQueryBuilderForTable('tt_content');","+        $queryBuilder->getRestrictions()->removeAll();","+        $queryBuilder->select('uid')->from('tt_content')->orderBy('uid');","+        new \\ReflectionMethod($recordList, 'addPageIdConstraint')->invoke($recordList, 'tt_content', $queryBuilder, 99);","+","+        self::assertSame($expectedUids, array_map(intval(...), $queryBuilder->executeQuery()->fetchFirstColumn()));","+    }","+","     #[Test]","     public function pageTranslationInOrphanedLanguageIsListedAndMarked(): void","     {"],"additions":27,"deletions":0,"truncated":false},{"path":"typo3/sysext/belog/Classes/Domain/Repository/LogEntryRepository.php","lines":["@@ -18,13 +18,14 @@"," namespace TYPO3\\CMS\\Belog\\Domain\\Repository;"," "," use Psr\\Log\\LogLevel;","-use TYPO3\\CMS\\Backend\\Tree\\Repository\\PageTreeRepository;"," use TYPO3\\CMS\\Belog\\Domain\\Model\\Constraint;"," use TYPO3\\CMS\\Belog\\Domain\\Model\\LogEntry;"," use TYPO3\\CMS\\Core\\Authentication\\GroupResolver;"," use TYPO3\\CMS\\Core\\Database\\Connection;"," use TYPO3\\CMS\\Core\\Database\\ConnectionPool;"," use TYPO3\\CMS\\Core\\Database\\Query\\QueryBuilder;","+use TYPO3\\CMS\\Core\\Database\\Query\\QueryHelper;","+use TYPO3\\CMS\\Core\\Domain\\Repository\\PageDescendantsRepository;"," use TYPO3\\CMS\\Core\\Log\\LogLevel as Typo3LogLevel;"," use TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission;"," use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","@@ -113,23 +114,29 @@ protected function createQueryConstraints(QueryBuilder $query, Constraint $const","      */","     protected function addPageTreeConstraintsToQuery(Constraint $constraint, QueryBuilder $query): ?string","     {","-        $pageIds = [];","-        // Check if we should get a whole tree of pages and not only a single page","-        if ($constraint->getDepth() > 0) {","-            $repository = GeneralUtility::makeInstance(PageTreeRepository::class);","-            $repository->setAdditionalWhereClause($GLOBALS['BE_USER']->getPagePermsClause(Permission::PAGE_SHOW));","-            $pages = $repository->getFlattenedPages([$constraint->getPageId()], $constraint->getDepth());","-            foreach ($pages as $page) {","-                $pageIds[] = (int)$page['uid'];","-            }","-        }","-        if (!empty($constraint->getPageId())) {","-            $pageIds[] = $constraint->getPageId();","+        $pageId = (int)$constraint->getPageId();","+        $depth = max($constraint->getDepth(), 0);","+        if ($pageId === 0 && $depth === 0) {","+            return null;","         }","-        if (!empty($pageIds)) {","-            return $query->expr()->in('event_pid', $query->createNamedParameter($pageIds, Connection::PARAM_INT_ARRAY));","+        $permsClause = QueryHelper::stripLogicalOperatorPrefix($GLOBALS['BE_USER']->getPagePermsClause(Permission::PAGE_SHOW));","+        // With a depth, the log entries of the pages below the page are found as well","+        $pageTreeConstraint = GeneralUtility::makeInstance(PageDescendantsRepository::class)->createPageTreeConstraint(","+            $query,","+            'event_pid',","+            [$pageId],","+            $depth,","+            0,","+            static fn(): string => $permsClause,","+        );","+        if ($pageId === 0) {","+            // The pages below the page tree root, without log entries not related to a page","+            return (string)$query->expr()->and(","+                $pageTreeConstraint,","+                $query->expr()->neq('event_pid', $query->createNamedParameter(0, Connection::PARAM_INT))","+            );","         }","-        return null;","+        return $pageTreeConstraint;","     }"," ","     /**"],"additions":23,"deletions":16,"truncated":false},{"path":"typo3/sysext/belog/Tests/Functional/Domain/Repository/Fixtures/PageTree.csv","lines":["@@ -0,0 +1,13 @@","+\"pages\"","+,\"uid\",\"pid\",\"title\"","+,1,0,\"Root\"","+,2,1,\"Page\"","+,3,2,\"Subpage\"","+,4,0,\"Other root\"","+\"sys_log\"","+,\"uid\",\"event_pid\",\"details\"","+,1,0,\"Login\"","+,2,1,\"Root\"","+,3,2,\"Page\"","+,4,3,\"Subpage\"","+,5,4,\"Other root\""],"additions":13,"deletions":0,"truncated":false},{"path":"typo3/sysext/belog/Tests/Functional/Domain/Repository/LogEntryRepositoryTest.php","lines":["@@ -0,0 +1,64 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Belog\\Tests\\Functional\\Domain\\Repository;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Belog\\Domain\\Model\\Constraint;","+use TYPO3\\CMS\\Belog\\Domain\\Repository\\LogEntryRepository;","+use TYPO3\\CMS\\Core\\Database\\ConnectionPool;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class LogEntryRepositoryTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = ['belog'];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/../../../../../core/Tests/Functional/Fixtures/be_users_admin.csv');","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/PageTree.csv');","+        $this->setUpBackendUser(1);","+    }","+","+    public static function pageTreeConstraintMatchesLogEntriesOfThePagesDataProvider(): iterable","+    {","+        yield 'page without depth' => [2, 0, [3]];","+        yield 'page with one level' => [1, 1, [2, 3]];","+        yield 'page with all levels' => [1, 99, [2, 3, 4]];","+        yield 'page tree root with all levels' => [0, 99, [2, 3, 4, 5]];","+        yield 'page tree root without depth' => [0, 0, [1, 2, 3, 4, 5]];","+    }","+","+    #[DataProvider('pageTreeConstraintMatchesLogEntriesOfThePagesDataProvider')]","+    #[Test]","+    public function pageTreeConstraintMatchesLogEntriesOfThePages(int $pageId, int $depth, array $expectedUids): void","+    {","+        $constraint = new Constraint();","+        $constraint->setPageId($pageId);","+        $constraint->setDepth($depth);","+        $queryBuilder = $this->get(ConnectionPool::class)->getQueryBuilderForTable('sys_log');","+        $queryBuilder->select('uid')->from('sys_log')->orderBy('uid');","+        $subject = $this->get(LogEntryRepository::class);","+        $pageTreeConstraint = new \\ReflectionMethod($subject, 'addPageTreeConstraintsToQuery')->invoke($subject, $constraint, $queryBuilder);","+        if ($pageTreeConstraint !== null) {","+            $queryBuilder->where($pageTreeConstraint);","+        }","+        self::assertSame($expectedUids, array_map(intval(...), $queryBuilder->executeQuery()->fetchFirstColumn()));","+    }","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Repository/PageDescendantsRepository.php","lines":["@@ -51,6 +51,8 @@","      */","     private const array STRUCTURE_FIELDS = ['uid', 'pid', 'sorting'];"," ","+    private const array CTE_FIELDS = ['uid', 'pid', 'sorting', '_ORIG_uid', '__CTE_RECORD_UID__', '__CTE_LEVEL__', '__CTE_PATH__', '__CTE_IS_CYCLE__'];","+","     public function __construct(","         private ConnectionPool $connectionPool,","     ) {}","@@ -95,14 +97,7 @@ public function findDescendants(","         }","         $cte = $this->connectionPool->getQueryBuilderForTable('pages');","         $cte->getRestrictions()->removeAll();","-        $cteFields = ['uid', 'pid', 'sorting', '_ORIG_uid', '__CTE_RECORD_UID__', '__CTE_LEVEL__', '__CTE_PATH__', '__CTE_IS_CYCLE__'];","-        $cte->typo3_withRecursive(","-            'cte',","-            false,","-            $this->createPartQueryBuilder($cte, $workspaceId, $liveConstraint, $restrictions, $pageIds, $depth, $includeDeleted, $includeDeletedInWorkspace),","-            $this->createPartQueryBuilder($cte, $workspaceId, $liveConstraint, $restrictions, null, $depth, $includeDeleted, $includeDeletedInWorkspace),","-            array_map($cte->quoteIdentifier(...), $cteFields),","-        );","+        $this->addCommonTableExpression($cte, $cte, 'cte', $pageIds, $depth, $workspaceId, $liveConstraint, $restrictions, $includeDeleted, $includeDeletedInWorkspace);","         // Fields are returned in the order of the table columns, like a page record","         $selectFields = [];","         foreach ($this->resolveFields($fields) as $field) {","@@ -116,13 +111,102 @@ public function findDescendants(","                 $cte->expr()->eq('record.uid', $cte->quoteIdentifier('cte.__CTE_RECORD_UID__'))","             );","         }","-        foreach (array_diff($cteFields, self::STRUCTURE_FIELDS) as $field) {","+        foreach (array_diff(self::CTE_FIELDS, self::STRUCTURE_FIELDS) as $field) {","             $selectFields[] = 'cte.' . $field;","         }","         $rows = $cte->select(...$selectFields)->from('cte')->executeQuery()->fetchAllAssociative();","         return $this->sortDepthFirst($pageIds, $rows);","     }"," ","+    /**","+     * Returns a constraint for a field holding a page uid - for example the \"pid\" of the","+     * records of a table - to be one of the given pages or one of their descendants, down","+     * to $depth levels below the given pages.","+     *","+     * The descendants are resolved by the database within the query, as a subquery with a","+     * recursive common table expression, so no list of page uids is built. The descendants","+     * are resolved as by findDescendants(). If the query builder does not use the database","+     * connection of the pages table, the descendants are fetched first and the constraint","+     * holds their uids.","+     *","+     * @param QueryBuilder $queryBuilder Query the constraint is added to, its named parameters are used","+     * @param string $fieldName Field holding a page uid, e.g. \"pid\" or \"tt_content.pid\"","+     * @param list<int> $pageIds Pages, whose uids are always matched by the constraint","+     * @param int $depth Number of levels below the given pages, 0 for the given pages only","+     * @param (\\Closure(ExpressionBuilder, string): string)|null $liveConstraint See findDescendants()","+     * @param list<QueryRestrictionInterface> $restrictions See findDescendants()","+     * @param bool $includeDeleted See findDescendants()","+     * @param bool $includeDeletedInWorkspace See findDescendants()","+     */","+    public function createPageTreeConstraint(","+        QueryBuilder $queryBuilder,","+        string $fieldName,","+        array $pageIds,","+        int $depth,","+        int $workspaceId,","+        ?\\Closure $liveConstraint = null,","+        array $restrictions = [],","+        bool $includeDeleted = false,","+        bool $includeDeletedInWorkspace = false,","+    ): string {","+        $pageIds = array_values(array_unique(array_map(intval(...), $pageIds)));","+        $depth = min($depth, self::MAX_TRAVERSAL_LEVELS);","+        $expr = $queryBuilder->expr();","+        if ($pageIds === []) {","+            return '1 = 0';","+        }","+        $pageConstraint = $expr->in($fieldName, $queryBuilder->createNamedParameter($pageIds, Connection::PARAM_INT_ARRAY));","+        if ($depth < 1) {","+            return $pageConstraint;","+        }","+        if ($queryBuilder->getConnection() !== $this->connectionPool->getConnectionForTable('pages')) {","+            $descendants = $this->findDescendants($pageIds, $depth, $workspaceId, $liveConstraint, $restrictions, [], $includeDeleted, $includeDeletedInWorkspace);","+            if ($descendants === []) {","+                return $pageConstraint;","+            }","+            return (string)$expr->or(","+                $pageConstraint,","+                $expr->in($fieldName, $queryBuilder->quoteArrayBasedValueListToIntegerList(array_column($descendants, 'uid')))","+            );","+        }","+        // A unique name, as the query may contain further common table expressions","+        $cteName = 'page_descendants_' . count($queryBuilder->getParameters());","+        $subQuery = $this->connectionPool->getQueryBuilderForTable('pages');","+        $subQuery->getRestrictions()->removeAll();","+        $this->addCommonTableExpression($subQuery, $queryBuilder, $cteName, $pageIds, $depth, $workspaceId, $liveConstraint, $restrictions, $includeDeleted, $includeDeletedInWorkspace);","+        $subQuery->select($cteName . '.uid')->from($cteName);","+        return (string)$expr->or(","+            $pageConstraint,","+            $queryBuilder->quoteIdentifier($fieldName) . ' IN (' . $subQuery->getSQL() . ')'","+        );","+    }","+","+    /**","+     * Adds the recursive common table expression resolving the descendants of the given pages","+     * to $queryBuilder. Its named parameters are created in $parameterQueryBuilder, which is the","+     * query the SQL is finally executed with.","+     */","+    private function addCommonTableExpression(","+        QueryBuilder $queryBuilder,","+        QueryBuilder $parameterQueryBuilder,","+        string $cteName,","+        array $pageIds,","+        int $depth,","+        int $workspaceId,","+        ?\\Closure $liveConstraint,","+        array $restrictions,","+        bool $includeDeleted,","+        bool $includeDeletedInWorkspace,","+    ): void {","+        $queryBuilder->typo3_withRecursive(","+            $cteName,","+            false,","+            $this->createPartQueryBuilder($parameterQueryBuilder, $cteName, $workspaceId, $liveConstraint, $restrictions, $pageIds, $depth, $includeDeleted, $includeDeletedInWorkspace),","+            $this->createPartQueryBuilder($parameterQueryBuilder, $cteName, $workspaceId, $liveConstraint, $restrictions, null, $depth, $includeDeleted, $includeDeletedInWorkspace),","+            array_map($parameterQueryBuilder->quoteIdentifier(...), self::CTE_FIELDS),","+        );","+    }","+","     /**","      * Creates the initial part of the CTE - the subpages of the given pages - if page ids","      * are given, and the recursive part - the subpages of the pages found so far - if not.","@@ -135,6 +219,7 @@ public function findDescendants(","      */","     private function createPartQueryBuilder(","         QueryBuilder $cte,","+        string $cteName,","         int $workspaceId,","         ?\\Closure $liveConstraint,","         array $restrictions,","@@ -190,7 +275,7 @@ private function createPartQueryBuilder(","             $constraints[] = $expr->in($pageAlias . '.pid', $cte->createNamedParameter($pageIds, Connection::PARAM_INT_ARRAY));","         } else {","             $queryBuilder","-                ->from('cte', 'c')","+                ->from($cteName, 'c')","                 ->innerJoin('c', 'pages', $pageAlias, $expr->eq($pageAlias . '.pid', $cte->quoteIdentifier('c.uid')));","             $constraints[] = $expr->eq('c.__CTE_IS_CYCLE__', $cte->createNamedParameter(0, Connection::PARAM_INT));","             $constraints[] = $expr->lt('c.__CTE_LEVEL__', $cte->createNamedParameter($depth, Connection::PARAM_INT));"],"additions":95,"deletions":10,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Feature-111406-FindTheSubpagesOfAPageWithOneDatabaseQuery.rst","lines":["@@ -34,15 +34,24 @@ The pages are found as the backend sees the page tree:","     evaluated on the live page, as page permissions are not versioned. A page","     not matching them is left out together with its subpages."," ","+Queries restricted to the records of a page and the pages below it no longer","+collect the uids of these pages first and add them as :sql:`pid IN (...)`,","+which made queries slow and exceeded the number of placeholders a database","+accepts in one statement for large page trees. The database resolves the pages","+of the tree within the query as a subquery instead. If the queried table lives","+on another database connection than the :sql:`pages` table, a list of the page","+uids is used as before.","+"," The following parts of TYPO3 find subpages this way now:"," "," *   :php:`\\TYPO3\\CMS\\Backend\\Tree\\Repository\\PageTreeRepository::getFlattenedPages()`,","-    used by the record list, the live search, the log module and the suggest","-    wizard","+    used by the live search and the suggest wizard","+*   the record list with search levels, the log module with a depth and the","+    recycler, which restrict their queries with","+    :php:`createPageTreeConstraint()`"," *   the workspaces module, to collect the versions below a page"," *   Extbase backend modules with :typoscript:`persistence.recursive`"," *   the query search in the \"System > Database\" module","-*   the recycler"," *   the indexed search administration"," *   the page trees of the \"Permissions\" module, the \"Localization Overview\",","     the export of :php:`EXT:impexp` and the indexed search administration, which","@@ -68,6 +77,11 @@ Extbase :typoscript:`persistence.recursive` in backend      905         1"," \"System > Reports > Record Statistics\", per statistic       1561        1"," ==========================================================  ==========  ========="," ","+The record list, the log module and the recycler need no query to restrict","+their queries to a page tree anymore, and their queries contain no list of page","+uids. The record list searches with search levels in the workspace of the","+backend user, so records on pages that only exist in this workspace are found.","+"," Extbase backend modules with :typoscript:`persistence.recursive` and the link"," validator no longer receive the uids of workspace versions as page ids."," "],"additions":17,"deletions":3,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Domain/Repository/PageTreeConstraintTest.php","lines":["@@ -0,0 +1,169 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Tests\\Functional\\Domain\\Repository;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\Database\\Connection;","+use TYPO3\\CMS\\Core\\Database\\ConnectionPool;","+use TYPO3\\CMS\\Core\\Database\\Query\\Expression\\ExpressionBuilder;","+use TYPO3\\CMS\\Core\\Database\\Query\\QueryBuilder;","+use TYPO3\\CMS\\Core\\Domain\\Repository\\PageDescendantsRepository;","+use TYPO3\\CMS\\Core\\Tests\\Functional\\Domain\\Repository\\Fixtures\\QueryCountingMiddleware;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class PageTreeConstraintTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = ['workspaces'];","+","+    protected array $configurationToUseInTestInstance = [","+        'DB' => [","+            'globalDriverMiddlewares' => [","+                'typo3-tests/query-counting' => [","+                    'target' => QueryCountingMiddleware::class,","+                ],","+            ],","+        ],","+    ];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/PageDescendants.csv');","+    }","+","+    public static function constraintMatchesThePagesOfTheTreeDataProvider(): iterable","+    {","+        foreach ([0, 1, 2] as $workspaceId) {","+            foreach ([1, 2, 99] as $depth) {","+                yield 'workspace ' . $workspaceId . ', depth ' . $depth => [[1], $depth, $workspaceId, false];","+                yield 'workspace ' . $workspaceId . ', depth ' . $depth . ', with live constraint' => [[1], $depth, $workspaceId, true];","+            }","+        }","+        yield 'several pages' => [[2, 3], 99, 0, false];","+        yield 'cycling page tree' => [[20], 99, 0, false];","+    }","+","+    #[Test]","+    #[DataProvider('constraintMatchesThePagesOfTheTreeDataProvider')]","+    public function constraintMatchesThePagesOfTheTree(array $pageIds, int $depth, int $workspaceId, bool $withLiveConstraint): void","+    {","+        $subject = $this->get(PageDescendantsRepository::class);","+        $liveConstraint = $this->createLiveConstraint($withLiveConstraint);","+","+        $queryBuilder = $this->createQueryBuilder();","+        $queryBuilder->andWhere($subject->createPageTreeConstraint($queryBuilder, 'pid', $pageIds, $depth, $workspaceId, $liveConstraint));","+        $actual = $queryBuilder->executeQuery()->fetchFirstColumn();","+","+        $expectedPageIds = [...$pageIds, ...array_column($subject->findDescendants($pageIds, $depth, $workspaceId, $liveConstraint), 'uid')];","+        $queryBuilder = $this->createQueryBuilder();","+        $queryBuilder->andWhere($queryBuilder->expr()->in('pid', $queryBuilder->createNamedParameter($expectedPageIds, Connection::PARAM_INT_ARRAY)));","+        $expected = $queryBuilder->executeQuery()->fetchFirstColumn();","+","+        self::assertNotSame([], $expected);","+        self::assertSame($expected, $actual);","+    }","+","+    /**","+     * A table mapped to another database connection than \"pages\" cannot join the page tree","+     * in a subquery, so the constraint holds the uids of the pages, resolved the same way.","+     */","+    #[Test]","+    #[DataProvider('constraintMatchesThePagesOfTheTreeDataProvider')]","+    public function constraintOnAnotherConnectionMatchesThePagesOfTheTree(array $pageIds, int $depth, int $workspaceId, bool $withLiveConstraint): void","+    {","+        $subject = $this->get(PageDescendantsRepository::class);","+        $liveConstraint = $this->createLiveConstraint($withLiveConstraint);","+","+        $queryBuilder = $this->createQueryBuilder();","+        $queryBuilder->andWhere($subject->createPageTreeConstraint($queryBuilder, 'pid', $pageIds, $depth, $workspaceId, $liveConstraint));","+        $expected = $queryBuilder->executeQuery()->fetchFirstColumn();","+","+        // A connection instance of its own, as the connection pool returns for another connection name","+        $otherConnection = clone $this->get(ConnectionPool::class)->getConnectionForTable('pages');","+        $queryBuilder = $this->createQueryBuilder($otherConnection);","+        $queryBuilder->andWhere($subject->createPageTreeConstraint($queryBuilder, 'pid', $pageIds, $depth, $workspaceId, $liveConstraint));","+","+        self::assertStringNotContainsStringIgnoringCase('with recursive', $queryBuilder->getSQL());","+        self::assertNotSame([], $expected);","+        self::assertSame($expected, $queryBuilder->executeQuery()->fetchFirstColumn());","+    }","+","+    #[Test]","+    public function constraintMatchesTheGivenPagesOnlyWithoutDepth(): void","+    {","+        $queryBuilder = $this->createQueryBuilder();","+        $queryBuilder->andWhere($this->get(PageDescendantsRepository::class)->createPageTreeConstraint($queryBuilder, 'pid', [1], 0, 0));","+        self::assertSame([2, 3, 10], array_map(intval(...), $queryBuilder->executeQuery()->fetchFirstColumn()));","+    }","+","+    #[Test]","+    public function constraintMatchesNothingWithoutPages(): void","+    {","+        $queryBuilder = $this->createQueryBuilder();","+        $queryBuilder->andWhere($this->get(PageDescendantsRepository::class)->createPageTreeConstraint($queryBuilder, 'pid', [], 99, 0));","+        self::assertSame([], $queryBuilder->executeQuery()->fetchFirstColumn());"],"additions":120,"deletions":0,"truncated":false}],"additions":391,"deletions":70,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-27T19:04:10.782054+00:00"}