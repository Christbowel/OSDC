kind would demand permission to create it.","+func AsReadAttributes(attr authorizer.Attributes) authorizer.Attributes {","+\tfieldSelector, fieldErr := attr.GetFieldSelector()","+\tlabelSelector, labelErr := attr.GetLabelSelector()","+\treturn authorizer.AttributesRecord{","+\t\tUser:            attr.GetUser(),","+\t\tVerb:            \"list\",","+\t\tNamespace:       attr.GetNamespace(),","+\t\tAPIGroup:        attr.GetAPIGroup(),","+\t\tAPIVersion:      attr.GetAPIVersion(),","+\t\tResource:        attr.GetResource(),","+\t\tSubresource:     attr.GetSubresource(),","+\t\tResourceRequest: true,","+\t\tPath:            attr.GetPath(),","+","+\t\tFieldSelectorRequirements: fieldSelector,","+\t\tFieldSelectorParsingErr:   fieldErr,","+\t\tLabelSelectorRequirements: labelSelector,","+\t\tLabelSelectorParsingErr:   labelErr,","+\t}","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"pkg/services/apiserver/auth/authorizer/search_test.go","lines":["@@ -0,0 +1,115 @@","+package authorizer","+","+import (","+\t\"context\"","+\t\"net/http\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"k8s.io/apimachinery/pkg/util/sets\"","+\t\"k8s.io/apiserver/pkg/authorization/authorizer\"","+\t\"k8s.io/apiserver/pkg/endpoints/request\"","+)","+","+// Uses the apiserver's own parser, so the assumptions below are pinned to real","+// behaviour rather than a guess.","+func attributesFor(t *testing.T, method, path string) authorizer.Attributes {","+\tt.Helper()","+\tf := &request.RequestInfoFactory{","+\t\tAPIPrefixes:          sets.NewString(\"apis\"),","+\t\tGrouplessAPIPrefixes: sets.NewString(),","+\t}","+\tr, err := http.NewRequest(method, path, nil)","+\trequire.NoError(t, err)","+\tinfo, err := f.NewRequestInfo(r)","+\trequire.NoError(t, err)","+","+\treturn authorizer.AttributesRecord{","+\t\tVerb:            info.Verb,","+\t\tNamespace:       info.Namespace,","+\t\tAPIGroup:        info.APIGroup,","+\t\tAPIVersion:      info.APIVersion,","+\t\tResource:        info.Resource,","+\t\tSubresource:     info.Subresource,","+\t\tName:            info.Name,","+\t\tResourceRequest: info.IsResourceRequest,","+\t\tPath:            path,","+\t}","+}","+","+const (","+\tbase       = \"/apis/dashboard.grafana.app/v0alpha1/namespaces/default/dashboards\"","+\tsearchPath = base + \"/search\"","+\ttrashPath  = base + \"/trash\"","+\tlistPath   = base","+)","+","+func TestIsSearchRequest(t *testing.T) {","+\tfor _, path := range []string{searchPath, trashPath} {","+\t\tattr := attributesFor(t, http.MethodPost, path)","+\t\trequire.Equal(t, \"create\", attr.GetVerb())","+\t\trequire.Equal(t, \"dashboards\", attr.GetResource())","+\t\tassert.True(t, IsSearchRequest(attr), \"path %s\", path)","+\t}","+","+\t// Creating a dashboard posts to the collection, so it carries no name and","+\t// must not be mistaken for a search.","+\tcreateAttr := attributesFor(t, http.MethodPost, listPath)","+\trequire.Empty(t, createAttr.GetName())","+\tassert.False(t, IsSearchRequest(createAttr))","+","+\tassert.False(t, IsSearchRequest(attributesFor(t, http.MethodGet, listPath)))","+","+\t// An object may legitimately be named \"search\" or \"trash\", and is only ever","+\t// reached with a non-create verb.","+\tfor _, path := range []string{searchPath, trashPath} {","+\t\tassert.False(t, IsSearchRequest(attributesFor(t, http.MethodGet, path)), \"path %s\", path)","+\t\tassert.False(t, IsSearchRequest(attributesFor(t, http.MethodPut, path)), \"path %s\", path)","+\t\tassert.False(t, IsSearchRequest(attributesFor(t, http.MethodDelete, path)), \"path %s\", path)","+\t}","+","+\t// A subresource named \"search\" is a different endpoint and not ours.","+\tsub := attributesFor(t, http.MethodPost, base+\"/my-dash/search\")","+\trequire.Equal(t, \"search\", sub.GetSubresource())","+\tassert.False(t, IsSearchRequest(sub))","+}","+","+func TestAsReadAttributes(t *testing.T) {","+\tread := AsReadAttributes(attributesFor(t, http.MethodPost, searchPath))","+","+\t// Searching reads the kind, so it must not demand permission to create it.","+\tassert.Equal(t, \"list\", read.GetVerb())","+\tassert.True(t, read.IsReadOnly())","+\t// \"search\" was a path segment, not an object.","+\tassert.Empty(t, read.GetName())","+","+\t// Everything the authorizer scopes on is preserved.","+\tassert.Equal(t, \"dashboard.grafana.app\", read.GetAPIGroup())","+\tassert.Equal(t, \"v0alpha1\", read.GetAPIVersion())","+\tassert.Equal(t, \"dashboards\", read.GetResource())","+\tassert.Equal(t, \"default\", read.GetNamespace())","+\tassert.True(t, read.IsResourceRequest())","+}","+","+// The org role authorizer allows a viewer to list but not to create, which is why","+// the restatement has to happen before the chain.","+func TestGrafanaAuthorizer_ViewerMaySearchButNotCreate(t *testing.T) {","+\tvar seen []string","+\trecorder := authorizer.AuthorizerFunc(","+\t\tfunc(_ context.Context, attr authorizer.Attributes) (authorizer.Decision, string, error) {","+\t\t\tseen = append(seen, attr.GetVerb())","+\t\t\treturn authorizer.DecisionNoOpinion, \"\", nil","+\t\t})","+","+\ta := &GrafanaAuthorizer{auth: recorder}","+","+\t_, _, err := a.Authorize(context.Background(), attributesFor(t, http.MethodPost, searchPath))","+\trequire.NoError(t, err)","+\t_, _, err = a.Authorize(context.Background(), attributesFor(t, http.MethodPost, trashPath))","+\trequire.NoError(t, err)","+\t_, _, err = a.Authorize(context.Background(), attributesFor(t, http.MethodPost, listPath))","+\trequire.NoError(t, err)","+","+\tassert.Equal(t, []string{\"list\", \"list\", \"create\"}, seen)","+}",""],"additions":115,"deletions":0,"truncated":false}],"additions":175,"deletions":118,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-07-30T10:12:19.624415+00:00"}