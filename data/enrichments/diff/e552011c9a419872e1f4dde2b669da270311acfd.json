side_the_project() {","+    for setting in MODULES_DIR_SETTINGS {","+        let CommandTempCwd { root, workspace, npmrc_info, .. } =","+            CommandTempCwd::init().add_mocked_registry();","+        let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+        let (root_modules_dir, project_modules_dir) =","+            set_modules_dir_outside_the_project(&workspace, setting);","+        append_workspace_yaml_key(&workspace, \"packages\", \"['project-1']\");","+        let project_dir = workspace.join(\"project-1\");","+        // Each project gets its own command: the root's `.bin` is on every","+        // project's `PATH`, so a shared one would hide a missed member `.bin`.","+        for (dir, name, to_workspace) in","+            [(&workspace, \"root\", \".\"), (&project_dir, \"project-1\", \"..\")]","+        {","+            let tool = workspace.join(format!(\"{name}-tool\"));","+            fs::create_dir_all(&tool).expect(\"create the tool package\");","+            fs::write(tool.join(\"bin.js\"), \"#!/usr/bin/env node\\n\").expect(\"write bin.js\");","+            write_manifest(","+                &tool,","+                &serde_json::json!({","+                    \"name\": format!(\"{name}-tool\"),","+                    \"version\": \"1.0.0\",","+                    \"bin\": { format!(\"{name}-tool\"): \"bin.js\" },","+                }),","+            );","+            write_manifest(","+                dir,","+                &serde_json::json!({","+                    \"name\": name,","+                    \"version\": \"1.0.0\",","+                    \"scripts\": { \"greet\": format!(\"{name}-tool\") },","+                    \"dependencies\": { format!(\"{name}-tool\"): format!(\"link:{to_workspace}/{name}-tool\") },","+                }),","+            );","+        }","+        pacquet_in(&workspace)","+            .with_arg(\"install\")","+            .assert()","+            .success();","+        assert_commands_use(&workspace, &root_modules_dir, \"root-tool\", setting);","+        assert_commands_use(&project_dir, &project_modules_dir, \"project-1-tool\", setting);","+        drop((root, mock_instance));","+    }","+}","+","+fn assert_commands_use(dir: &Path, modules_dir: &Path, command: &str, setting: ModulesDirSetting) {","+    let context = format!(\"{setting:?} {}\", dir.display());","+    let real = |path: &str| {","+        dunce::canonicalize(path.trim())","+            .unwrap_or_else(|error| panic!(\"{context}: canonicalize {path:?}: {error}\"))","+    };","+    assert_eq!(","+        real(&probe_stdout(dir, &[\"root\"])),","+        dunce::canonicalize(modules_dir).unwrap(),","+        \"{context}\",","+    );","+    assert_eq!(","+        real(&probe_stdout(dir, &[\"bin\"])),","+        dunce::canonicalize(modules_dir.join(\".bin\")).unwrap(),","+        \"{context}\",","+    );","+    for args in [&[\"run\", \"greet\"][..], &[\"exec\", command]] {","+        pacquet_in(dir)","+            .with_args(args)","+            .assert()","+            .success();","+    }","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/modules_dir_with_subdirectory.rs","lines":["@@ -69,7 +69,8 @@ fn bin_prints_the_whole_nested_modules_dir() {","         format!(","             \"{}\\n\",","             workspace","-                .join(\"www/modules\")","+                .join(\"www\")","+                .join(\"modules\")","                 .join(\".bin\")","                 .display()","         ),"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/derive_layout.rs","lines":["@@ -185,10 +185,7 @@ impl Config {","                     .applies_package_configs()","                     .then(|| pnpm_workspace::read_project_name(dir))","                     .flatten();","-                vec![","-                    dir.join(self.modules_dir_name_for(dir, root_name.as_deref()))","-                        .join(\".bin\"),","-                ]","+                vec![self.project_modules_dir(dir, root_name.as_deref()).join(\".bin\")]","             })","     }"," "],"additions":1,"deletions":4,"truncated":false},{"path":"pnpm/crates/config/src/layout.rs","lines":["@@ -262,17 +262,26 @@ impl Config {","     }"," ","     /// The modules directory an install gives the project at","-    /// `project_dir`: the `packageConfigs` entry naming it, else the","-    /// configured `modulesDir`, resolved against `project_dir` and","-    /// lexically normalized. Unlike [`Self::modules_dir_name_for`] it","-    /// keeps a multi-component or absolute setting whole, as pnpm's","-    /// `pathAbsolute` does.","+    /// `project_dir`, lexically normalized:","+    ///","+    /// - a project that shares a lockfile with others but is not in the","+    ///   lockfile directory gets [`Self::modules_dir_name`] inside it;","+    /// - any other project gets the `packageConfigs` entry naming it, else","+    ///   the configured `modulesDir`, resolved against `project_dir` whole,","+    ///   as pnpm's `pathAbsolute` does.","     #[must_use]","     pub fn project_modules_dir(","         &self,","         project_dir: &Path,","         project_name: Option<&str>,","     ) -> std::path::PathBuf {","+        let project_dir = pnpm_fs::lexical_normalize(project_dir);","+        if self.shares_one_lockfile()","+            && pnpm_fs::lexical_normalize(self.lockfile_dir_for(&project_dir)) != project_dir","+        {","+            return pnpm_fs::lexical_normalize(&project_dir.join(self.modules_dir_name()));","+        }","+        let project_dir = project_dir.as_path();","         let modules_dir = self","             .applies_package_configs()","             .then(|| {"],"additions":14,"deletions":5,"truncated":false},{"path":"pnpm/crates/config/src/tests/modules_dir_name.rs","lines":["@@ -56,3 +56,22 @@ fn a_package_config_nested_modules_dir_keeps_every_segment() {","     assert_eq!(Path::new(config.modules_dir_name()), Path::new(\"www/modules\"));","     assert_eq!(config.modules_dir_anchor(), Some(project_dir.as_path()));"," }","+","+#[test]","+fn a_project_modules_dir_follows_the_install_rule_for_a_modules_dir_outside_the_project() {","+    let project = workspace().join(\"packages/member\");","+    let mut config = config_with_modules_dir(\"../vendor\");","+    config.workspace_dir = Some(workspace());","+    config.shared_workspace_lockfile = true;","+    assert_eq!(","+        config.project_modules_dir(&workspace(), None),","+        pnpm_fs::lexical_normalize(&workspace().join(\"../vendor\")),","+    );","+    assert_eq!(config.project_modules_dir(&project, None), project.join(\"vendor\"));","+","+    config.shared_workspace_lockfile = false;","+    assert_eq!(","+        config.project_modules_dir(&project, None),","+        pnpm_fs::lexical_normalize(&project.join(\"../vendor\")),","+    );","+}",""],"additions":19,"deletions":0,"truncated":false}],"additions":119,"deletions":25,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-08T15:21:24.071390+00:00"}