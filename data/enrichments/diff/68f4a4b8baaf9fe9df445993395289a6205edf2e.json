{"id":"68f4a4b8baaf9fe9df445993395289a6205edf2e","axis":"silent","repo":"duckdb/duckdb","sha":"68f4a4b8baaf9fe9df445993395289a6205edf2e","parsed":{"files":[{"path":"src/common/enum_util.cpp","lines":["@@ -4646,19 +4646,20 @@ const StringUtil::EnumStringLiteral *GetOptimizerTypeValues() {"," \t\t{ static_cast<uint32_t>(OptimizerType::DISJUNCTIVE_JOIN_REWRITER), \"DISJUNCTIVE_JOIN_REWRITER\" },"," \t\t{ static_cast<uint32_t>(OptimizerType::REDUNDANT_ORDER), \"REDUNDANT_ORDER\" },"," \t\t{ static_cast<uint32_t>(OptimizerType::WINDOW_JOIN_PUSHDOWN), \"WINDOW_JOIN_PUSHDOWN\" },","-\t\t{ static_cast<uint32_t>(OptimizerType::SELF_JOIN_AGGREGATE), \"SELF_JOIN_AGGREGATE\" }","+\t\t{ static_cast<uint32_t>(OptimizerType::SELF_JOIN_AGGREGATE), \"SELF_JOIN_AGGREGATE\" },","+\t\t{ static_cast<uint32_t>(OptimizerType::SCALAR_AGGREGATE_MERGE), \"SCALAR_AGGREGATE_MERGE\" }"," \t};"," \treturn values;"," }"," "," template<>"," const char* EnumUtil::ToChars<OptimizerType>(OptimizerType value) {","-\treturn StringUtil::EnumToString(GetOptimizerTypeValues(), 51, \"OptimizerType\", static_cast<uint32_t>(value));","+\treturn StringUtil::EnumToString(GetOptimizerTypeValues(), 52, \"OptimizerType\", static_cast<uint32_t>(value));"," }"," "," template<>"," OptimizerType EnumUtil::FromString<OptimizerType>(const char *value) {","-\treturn static_cast<OptimizerType>(StringUtil::StringToEnum(GetOptimizerTypeValues(), 51, \"OptimizerType\", value));","+\treturn static_cast<OptimizerType>(StringUtil::StringToEnum(GetOptimizerTypeValues(), 52, \"OptimizerType\", value));"," }"," "," const StringUtil::EnumStringLiteral *GetOrderByColumnTypeValues() {"],"additions":4,"deletions":3,"truncated":false},{"path":"src/common/enums/optimizer_type.cpp","lines":["@@ -63,6 +63,7 @@ static const DefaultOptimizerType internal_optimizer_types[] = {","     {\"disjunctive_join_rewriter\", OptimizerType::DISJUNCTIVE_JOIN_REWRITER},","     {\"redundant_order\", OptimizerType::REDUNDANT_ORDER},","     {\"self_join_aggregate\", OptimizerType::SELF_JOIN_AGGREGATE},","+    {\"scalar_aggregate_merge\", OptimizerType::SCALAR_AGGREGATE_MERGE},","     {nullptr, OptimizerType::INVALID}};"," "," string OptimizerTypeToString(OptimizerType type) {"],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/settings.json","lines":["@@ -1437,6 +1437,13 @@","         ],","         \"is_deprecated\": true","     },","+    {","+        \"name\": \"scalar_aggregate_merge_threshold\",","+        \"description\": \"The number of rows a table needs for sibling scalar aggregates over it to be computed in one pass. 0 computes them in one pass only over table functions such as read_parquet.\",","+        \"type\": \"UBIGINT\",","+        \"default_scope\": \"local\",","+        \"default_value\": \"0\"","+    },","     {","         \"name\": \"scalar_subquery_error_on_multiple_rows\",","         \"description\": \"Deprecated setting. Throw an error when a scalar subquery returns more than one row. This will become the default behavior. When disabled, an arbitrary row is returned instead.\","],"additions":7,"deletions":0,"truncated":false},{"path":"src/include/duckdb/common/enums/optimizer_type.hpp","lines":["@@ -64,7 +64,8 @@ enum class OptimizerType : uint32_t {"," \tDISJUNCTIVE_JOIN_REWRITER = 47,"," \tREDUNDANT_ORDER = 48,"," \tWINDOW_JOIN_PUSHDOWN = 49,","-\tSELF_JOIN_AGGREGATE = 50","+\tSELF_JOIN_AGGREGATE = 50,","+\tSCALAR_AGGREGATE_MERGE = 51"," };"," "," string OptimizerTypeToString(OptimizerType type);"],"additions":2,"deletions":1,"truncated":false},{"path":"src/include/duckdb/main/settings.hpp","lines":["@@ -2373,6 +2373,20 @@ struct RegexMatchOperatorSemanticsSetting {"," \tstatic void OnSet(SettingCallbackInfo &info, Value &input);"," };"," ","+struct ScalarAggregateMergeThresholdSetting {","+\tusing RETURN_TYPE = idx_t;","+\tstatic constexpr const char *Name = \"scalar_aggregate_merge_threshold\";","+\tstatic constexpr const char *Description =","+\t    \"The number of rows a table needs for sibling scalar aggregates over it to be computed in one pass. 0 computes \"","+\t    \"them in one pass only over table functions such as read_parquet.\";","+\tstatic constexpr const char *InputType = \"UBIGINT\";","+\tstatic constexpr bool IsDebug = false;","+\tstatic constexpr bool IsDeprecated = false;","+\tstatic constexpr const char *DefaultValue = \"0\";","+\tstatic constexpr SettingScopeTarget Scope = SettingScopeTarget::LOCAL_DEFAULT;","+\tstatic constexpr idx_t SettingIndex = NEXT_SETTING_INDEX();","+};","+"," struct ScalarSubqueryErrorOnMultipleRowsSetting {"," \tusing RETURN_TYPE = bool;"," \tstatic constexpr const char *Name = \"scalar_subquery_error_on_multiple_rows\";"],"additions":14,"deletions":0,"truncated":false},{"path":"src/include/duckdb/optimizer/scalar_aggregate_merger.hpp","lines":["@@ -0,0 +1,59 @@","+//===----------------------------------------------------------------------===//","+//                         DuckDB","+//","+// duckdb/optimizer/scalar_aggregate_merger.hpp","+//","+//","+//===----------------------------------------------------------------------===//","+","+#pragma once","+","+#include \"duckdb/optimizer/column_binding_replacer.hpp\"","+#include \"duckdb/planner/logical_operator.hpp\"","+","+namespace duckdb {","+","+class Optimizer;","+","+//! The ScalarAggregateMerger computes sibling ungrouped aggregates over the same table(s) in one pass.","+//!","+//! An uncorrelated scalar subquery that returns exactly one row, and a one-row derived table in a FROM list, are","+//! planned as a cross product with the rest of the query, and each of them reads its tables on its own. Siblings of","+//! the form [projection ->] ungrouped aggregate -> filters -> plain scan(s) of the same table(s) are rewritten into one","+//! scan, filtered by the predicates every sibling shares and the OR of what each has beyond them, feeding one aggregate","+//! that holds every sibling's aggregates, each with a FILTER (WHERE ...) of its own predicate. A projection then hands","+//! every sibling's columns back under new bindings (TPC-DS q9, q28, q88 and q90).","+//!","+//! The merge trades scans for FILTERs, which pays off when the scan is the expensive part: siblings over a table","+//! function (read_parquet, read_csv, ...) are merged, siblings over a catalog table only when it has at least","+//! scalar_aggregate_merge_threshold rows.","+class ScalarAggregateMerger {","+public:","+\texplicit ScalarAggregateMerger(Optimizer &optimizer);","+","+\t//! Rewrites every eligible group of siblings in the plan","+\tvoid Optimize(unique_ptr<LogicalOperator> &plan);","+","+public:","+\tstruct Branch;","+\tstruct MergeTarget;","+","+private:","+\tvoid VisitOperator(unique_ptr<LogicalOperator> &op);","+\t//! Merges the eligible leaves of the cross-product tree rooted at `op`","+\tvoid MergeCrossProduct(unique_ptr<LogicalOperator> &op);","+\t//! Appends `leaf` to `branches` when it has the shape of a branch","+\tstatic void TryMatchBranch(unique_ptr<LogicalOperator> &leaf, vector<Branch> &branches);","+\t//! Whether the scans of `branch` cost enough for the merge to pay off: a table function (files, remote sources)","+\t//! or a table of at least scalar_aggregate_merge_threshold rows","+\tbool IsWorthMerging(const Branch &branch);","+\t//! The merged leaf that replaces the branches of `group`, or null when the group cannot be merged","+\tunique_ptr<LogicalOperator> MergeBranches(vector<Branch> &branches, const vector<idx_t> &group);","+","+private:","+\tOptimizer &optimizer;","+\t//! The bindings of the branches that were merged away, pointed at the merged projection's columns","+\tvector<ReplacementBinding> replacements;","+};","+","+} // namespace duckdb"],"additions":59,"deletions":0,"truncated":false},{"path":"src/main/config.cpp","lines":["@@ -245,6 +245,7 @@ static const ConfigurationOption internal_options[] = {","     DUCKDB_SETTING_CALLBACK(ReadAheadDepthSetting),","     DUCKDB_SETTING(RedactHttpLogsSetting),","     DUCKDB_SETTING_CALLBACK(RegexMatchOperatorSemanticsSetting),","+    DUCKDB_SETTING(ScalarAggregateMergeThresholdSetting),","     DUCKDB_SETTING(ScalarSubqueryErrorOnMultipleRowsSetting),","     DUCKDB_SETTING(SchedulerProcessPartialSetting),","     DUCKDB_LOCAL(SchemaSetting),"],"additions":1,"deletions":0,"truncated":false},{"path":"src/optimizer/CMakeLists.txt","lines":["@@ -64,6 +64,7 @@ add_library_unity(","   window_self_join.cpp","   row_number_rewriter.cpp","   sampling_pushdown.cpp","+  scalar_aggregate_merger.cpp","   type_pushdown.cpp","   scalar_fn_pushdown.cpp","   self_join_aggregate.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"src/optimizer/optimizer.cpp","lines":["@@ -32,6 +32,7 @@"," #include \"duckdb/optimizer/remove_unused_columns.hpp\""," #include \"duckdb/optimizer/row_group_pruner.hpp\""," #include \"duckdb/optimizer/sampling_pushdown.hpp\"","+#include \"duckdb/optimizer/scalar_aggregate_merger.hpp\""," #include \"duckdb/optimizer/scalar_fn_pushdown.hpp\""," #include \"duckdb/optimizer/self_join_aggregate.hpp\""," #include \"duckdb/optimizer/statistics_propagator.hpp\"","@@ -227,6 +228,12 @@ void Optimizer::RunBuiltInOptimizers() {"," \t\tplan = self_join_aggregate.Optimize(std::move(plan));"," \t});"," ","+\t// computes sibling scalar aggregates over the same table(s) in one pass, while their predicates are still filters","+\tRunOptimizer(OptimizerType::SCALAR_AGGREGATE_MERGE, [&]() {","+\t\tScalarAggregateMerger scalar_aggregate_merger(*this);","+\t\tscalar_aggregate_merger.Optimize(plan);","+\t});","+"," \t// Rewrites AVG(x) -> SUM(x)/COUNT(x) and SUM(x+C) -> SUM(x) + C*COUNT(x)"," \tRunOptimizer(OptimizerType::AGGREGATE_FUNCTION_REWRITER, [&]() {"," \t\tAggregateFunctionRewriter aggregate_function_rewriter(*this);"],"additions":7,"deletions":0,"truncated":false},{"path":"src/optimizer/scalar_aggregate_merger.cpp","lines":["@@ -0,0 +1,667 @@","+#include \"duckdb/optimizer/scalar_aggregate_merger.hpp\"","+","+#include \"duckdb/common/set.hpp\"","+#include \"duckdb/main/settings.hpp\"","+#include \"duckdb/optimizer/optimizer.hpp\"","+#include \"duckdb/planner/binder.hpp\"","+#include \"duckdb/planner/column_binding_map.hpp\"","+#include \"duckdb/planner/expression/bound_aggregate_expression.hpp\"","+#include \"duckdb/planner/expression/bound_columnref_expression.hpp\"","+#include \"duckdb/planner/expression/bound_comparison_expression.hpp\"","+#include \"duckdb/planner/expression/bound_conjunction_expression.hpp\"","+#include \"duckdb/planner/expression/bound_function_expression.hpp\"","+#include \"duckdb/planner/expression_iterator.hpp\"","+#include \"duckdb/planner/operator/logical_aggregate.hpp\"","+#include \"duckdb/planner/operator/logical_cross_product.hpp\"","+#include \"duckdb/planner/operator/logical_filter.hpp\"","+#include \"duckdb/planner/operator/logical_get.hpp\"","+#include \"duckdb/planner/operator/logical_projection.hpp\"","+","+namespace duckdb {","+","+//===--------------------------------------------------------------------===//","+// Branch: [projection ->] ungrouped aggregate -> filters -> plain scan(s)","+//===--------------------------------------------------------------------===//","+//! One leaf of a cross-product tree that can be merged with its siblings","+struct ScalarAggregateMerger::Branch {","+\t//! The leaf's slot in the cross-product tree","+\treference<unique_ptr<LogicalOperator>> leaf;","+\t//! The projection over the aggregate, if any","+\toptional_ptr<LogicalProjection> projection;","+\treference<LogicalAggregate> aggregate;","+\t//! The slot under the filters: the scan, or the cross product of scans of different tables (a FROM list)","+\treference<unique_ptr<LogicalOperator>> relation;","+\tvector<reference<LogicalGet>> scans;","+\t//! The filters' predicates, with ANDs split into their conjuncts","+\tvector<reference<const Expression>> conjuncts;","+};","+","+//! One of the first branch's scans, which the merged leaf keeps, and the columns it gains for the other branches","+struct ScalarAggregateMerger::MergeTarget {","+\treference<LogicalGet> scan;","+\t//! A column the scan gains, and the binding that column lands on","+\tvector<std::pair<column_t, ColumnBinding>> added_columns;","+};","+","+//! The aggregates that are merged: FILTER (WHERE p) feeds exactly the rows where p holds, so the result over the rows","+//! where p holds equals the result with FILTER (WHERE p) over any superset of them, for empty input too","+//! (0 for the counts, NULL otherwise). min(x, n) and max(x, n) take two arguments and are not matched.","+static bool IsMergeableAggregateFunction(const BoundAggregateExpression &aggregate) {","+\tauto &name = aggregate.Function().GetName().GetIdentifierName();","+\tconst auto argument_count = aggregate.GetChildren().size();","+\tif (name == \"count_star\") {","+\t\treturn argument_count == 0;","+\t}","+\treturn argument_count == 1 && (name == \"count\" || name == \"sum\" || name == \"avg\" || name == \"min\" || name == \"max\");","+}","+","+//! An expression that may be evaluated on more rows than before: neither volatile nor able to throw. A foldable","+//! subtree that can throw failed to fold, and a CASE or OR above it decides per row whether it is reached.","+static bool IsSafeOnOtherRows(const Expression &expr) {","+\treturn !expr.IsVolatile() && !expr.CanThrow();","+}","+","+static bool IsMergeableAggregate(const Expression &expr) {","+\tif (expr.GetExpressionClass() != ExpressionClass::BOUND_AGGREGATE) {","+\t\treturn false;","+\t}","+\tauto &aggregate = expr.Cast<BoundAggregateExpression>();","+\t// DISTINCT is fine: the FILTER applies before the deduplication. ORDER BY is not matched.","+\tif (aggregate.GetOrderBys() || !IsMergeableAggregateFunction(aggregate)) {","+\t\treturn false;","+\t}","+\tfor (auto &child : aggregate.GetChildren()) {","+\t\tif (!IsSafeOnOtherRows(*child)) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn !aggregate.GetFilter() || IsSafeOnOtherRows(*aggregate.GetFilter());","+}","+","+static void SplitConjunction(const Expression &expr, vector<reference<const Expression>> &conjuncts) {","+\tif (expr.GetExpressionType() == ExpressionType::CONJUNCTION_AND) {","+\t\tfor (auto &child : expr.Cast<BoundConjunctionExpression>().GetChildren()) {","+\t\t\tSplitConjunction(*child, conjuncts);","+\t\t}","+\t\treturn;","+\t}","+\tconjuncts.push_back(expr);","+}","+","+//! A scan as bound: no filters, time travel, ordinality, projection list, sample, input table or process-local input,","+//! and only plain columns. A scan that reads no column gets the empty placeholder once its types are resolved.","+static bool IsPlainScan(const LogicalGet &get) {","+\tif (!get.children.empty() || get.bind_info || get.table_filters.HasFilters() || get.at_clause ||","+\t    get.source_ordinality != OrdinalityType::WITHOUT_ORDINALITY || !get.projection_ids.empty() ||","+\t    get.has_pushed_projection || get.extra_info.sample_options || get.dynamic_filters ||","+\t    !get.input_table_types.empty() || !get.projected_input.empty()) {","+\t\treturn false;","+\t}","+\tfor (auto &column_id : get.GetColumnIds()) {","+\t\tif (column_id.IsEmptyColumn()) {","+\t\t\tcontinue;","+\t\t}","+\t\tif (column_id.IsVirtualColumn() || column_id.HasChildren()) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+","+static bool SameValues(const vector<Value> &a, const vector<Value> &b) {","+\tif (a.size() != b.size()) {","+\t\treturn false;","+\t}","+\tfor (idx_t i = 0; i < a.size(); i++) {","+\t\tif (a[i].type() != b[i].type() || !Value::NotDistinctFrom(a[i], b[i])) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+","+static bool SameNamedParameters(const named_argument_map_t &a, const named_argument_map_t &b) {","+\tif (a.size() != b.size()) {","+\t\treturn false;","+\t}","+\tfor (auto &entry : a) {","+\t\tauto other = b.find(entry.first);","+\t\tif (other == b.end() || entry.second.type() != other->second.type() ||","+\t\t    !Value::NotDistinctFrom(entry.second, other->second)) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+","+//! Two plain scans that read the same rows: the same catalog table, or the same table function (read_parquet,","+//! read_csv, ...) called with the same arguments. What a call without arguments reads is known to its bind data alone.","+static bool IsSameRelation(const LogicalGet &a, const LogicalGet &b) {","+\tif (a.function != b.function || !SameValues(a.parameters, b.parameters) ||","+\t    !SameNamedParameters(a.named_parameters, b.named_parameters)) {","+\t\treturn false;","+\t}","+\tauto table = a.GetTable();","+\tif (table || b.GetTable()) {","+\t\treturn table.get() == b.GetTable().get();","+\t}","+\treturn !a.parameters.empty() || FunctionData::Equals(a.bind_data.get(), b.bind_data.get());","+}","+","+//! The columns a scan reads, without the empty placeholder","+static set<column_t> ReadColumns(const LogicalGet &get) {","+\tset<column_t> columns;","+\tfor (auto &column_id : get.GetColumnIds()) {","+\t\tif (!column_id.IsEmptyColumn()) {","+\t\t\tcolumns.insert(column_id.GetPrimaryIndex());","+\t\t}","+\t}","+\treturn columns;","+}","+","+//! A named argument that is set: given, not NULL and not false","+static bool HasOption(const LogicalGet &get, const char *name) {","+\tauto entry = get.named_parameters.find(name);","+\tif (entry == get.named_parameters.end() || entry->second.IsNull()) {","+\t\treturn false;","+\t}","+\treturn entry->second.type().id() != LogicalTypeId::BOOLEAN || BooleanValue::Get(entry->second);","+}","+","+//! A scan that stores the rows it rejects writes them as a side effect of each scan","+static bool RecordsRejects(const LogicalGet &get) {","+\treturn HasOption(get, \"store_rejects\") || HasOption(get, \"rejects_table\") || HasOption(get, \"rejects_scan\") ||","+\t       HasOption(get, \"rejects_limit\");","+}","+","+//! Two scans that one scan reading both of their columns can replace: the same relation, and the rows a scan returns do","+//! not depend on the columns it reads. A scan that drops the rows it fails to parse (ignore_errors) returns a row when","+//! every column it reads parses, so such scans are only shared when they read the same columns.","+static bool CanShareScan(const LogicalGet &a, const LogicalGet &b) {","+\tif (!IsSameRelation(a, b) || RecordsRejects(a)) {","+\t\treturn false;","+\t}","+\treturn !HasOption(a, \"ignore_errors\") || ReadColumns(a) == ReadColumns(b);","+}","+","+//! The plain scans under `op`: one scan, or a cross product of scans of different relations (a self-join's copies of","+//! a table would not pair one to one with another branch's)","+static bool CollectScans(LogicalOperator &op, vector<reference<LogicalGet>> &scans) {","+\tif (op.type == LogicalOperatorType::LOGICAL_CROSS_PRODUCT) {","+\t\tfor (auto &child : op.children) {","+\t\t\tif (!CollectScans(*child, scans)) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+\tif (op.type != LogicalOperatorType::LOGICAL_GET) {","+\t\treturn false;","+\t}","+\tauto &scan = op.Cast<LogicalGet>();","+\tif (!IsPlainScan(scan)) {","+\t\treturn false;","+\t}","+\tfor (auto &other : scans) {","+\t\tif (IsSameRelation(other.get(), scan)) {","+\t\t\treturn false;","+\t\t}","+\t}","+\tscans.push_back(scan);","+\treturn true;","+}","+","+//! Two branches read the same tables when their scans pair up one to one as scans that can be shared","+static bool ReadSameTables(const ScalarAggregateMerger::Branch &a, const ScalarAggregateMerger::Branch &b) {","+\tif (a.scans.size() != b.scans.size()) {","+\t\treturn false;","+\t}","+\tfor (auto &scan : a.scans) {","+\t\tbool found = false;","+\t\tfor (auto &other : b.scans) {","+\t\t\tfound = found || CanShareScan(scan.get(), other.get());","+\t\t}","+\t\tif (!found) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+","+//! Equal conjuncts, or the same comparison with its sides swapped (a = b and b = a)","+static bool IsSameConjunct(const Expression &a, const Expression &b) {","+\tif (a.Equals(b)) {","+\t\treturn true;","+\t}","+\tif (!BoundComparisonExpression::IsComparison(a) || !BoundComparisonExpression::IsComparison(b)) {","+\t\treturn false;","+\t}","+\tauto &left = a.Cast<BoundFunctionExpression>();","+\tauto &right = b.Cast<BoundFunctionExpression>();","+\treturn left.GetExpressionType() == FlipComparisonExpression(right.GetExpressionType()) &&","+\t       BoundComparisonExpression::Left(left).Equals(BoundComparisonExpression::Right(right)) &&","+\t       BoundComparisonExpression::Right(left).Equals(BoundComparisonExpression::Left(right));","+}","+","+static bool ContainsConjunct(const vector<unique_ptr<Expression>> &conjuncts, const Expression &expr) {","+\tfor (auto &conjunct : conjuncts) {","+\t\tif (IsSameConjunct(*conjunct, expr)) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+","+static void CollectBindings(const Expression &expr, column_binding_set_t &bindings) {","+\tExpressionIterator::VisitExpression<BoundColumnRefExpression>(","+\t    expr, [&](const BoundColumnRefExpression &column_ref) { bindings.insert(column_ref.Binding()); });","+}","+","+//! Points every column reference of `expr` that `remap` names at its new binding","+static void RemapBindings(Expression &expr, const column_binding_map_t<ColumnBinding> &remap) {","+\tif (expr.GetExpressionClass() == ExpressionClass::BOUND_COLUMN_REF) {","+\t\tauto &binding = expr.Cast<BoundColumnRefExpression>().BindingMutable();","+\t\tauto entry = remap.find(binding);","+\t\tif (entry != remap.end()) {","+\t\t\tbinding = entry->second;","+\t\t}","+\t}","+\tExpressionIterator::EnumerateChildren(expr, [&](Expression &child) { RemapBindings(child, remap); });","+}","+","+static unique_ptr<Expression> MakeConjunction(ExpressionType type, vector<unique_ptr<Expression>> terms) {","+\tif (terms.size() == 1) {","+\t\treturn std::move(terms[0]);","+\t}","+\tauto result = make_uniq<BoundConjunctionExpression>(type);","+\tfor (auto &term : terms) {","+\t\tresult->GetChildrenMutable().push_back(std::move(term));","+\t}","+\treturn std::move(result);","+}","+","+static bool TreeHasProjectionMap(const LogicalOperator &op) {","+\tif (op.HasProjectionMap()) {","+\t\treturn true;","+\t}","+\tfor (auto &child : op.children) {","+\t\tif (TreeHasProjectionMap(*child)) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+","+//! Where `target` reads `column`: the binding it has, or the one it gains once its group merges","+static ColumnBinding TargetBinding(ScalarAggregateMerger::MergeTarget &target, column_t column) {","+\tauto &scan = target.scan.get();","+\tauto &column_ids = scan.GetColumnIds();","+\tfor (idx_t i = 0; i < column_ids.size(); i++) {","+\t\tif (column_ids[i].GetPrimaryIndex() == column) {","+\t\t\treturn ColumnBinding(scan.table_index, ProjectionIndex(i));","+\t\t}","+\t}","+\tfor (auto &entry : target.added_columns) {","+\t\tif (entry.first == column) {","+\t\t\treturn entry.second;","+\t\t}","+\t}","+\tColumnBinding binding(scan.table_index, ProjectionIndex(column_ids.size() + target.added_columns.size()));","+\ttarget.added_columns.emplace_back(column, binding);","+\treturn binding;","+}","+","+//===--------------------------------------------------------------------===//","+// ScalarAggregateMerger","+//===--------------------------------------------------------------------===//","+ScalarAggregateMerger::ScalarAggregateMerger(Optimizer &optimizer) : optimizer(optimizer) {","+}","+","+void ScalarAggregateMerger::Optimize(unique_ptr<LogicalOperator> &plan) {","+\t// rebuilding a cross-product tree would move the positions a projection map names: only plans without them","+\tif (TreeHasProjectionMap(*plan)) {","+\t\treturn;","+\t}","+\tVisitOperator(plan);","+\tif (replacements.empty()) {","+\t\treturn;","+\t}","+\tColumnBindingReplacer replacer;","+\treplacer.replacement_bindings = std::move(replacements);","+\treplacer.VisitOpera