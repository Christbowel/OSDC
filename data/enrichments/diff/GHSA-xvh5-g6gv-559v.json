se TIFF_RATIONAL:","+        case TIFF_SRATIONAL:","+            return 3;","+        case TIFF_ASCII:","+            return 4;","+        default:","+            return 0;","+    }","+}","+","+/* Size of the values that TIFFSetField copies from an array of the given","+   type. libtiff stores custom RATIONAL arrays as floats. */","+static int","+tiff_array_item_size(TIFFDataType type) {","+    switch (type) {","+        case TIFF_BYTE:","+        case TIFF_SBYTE:","+        case TIFF_UNDEFINED:","+        case TIFF_ASCII:","+            return 1;","+        case TIFF_SHORT:","+        case TIFF_SSHORT:","+            return 2;","+        case TIFF_LONG:","+        case TIFF_SLONG:","+        case TIFF_IFD:","+        case TIFF_FLOAT:","+        case TIFF_RATIONAL:","+        case TIFF_SRATIONAL:","+            return 4;","+        case TIFF_DOUBLE:","+        case TIFF_LONG8:","+        case TIFF_SLONG8:","+        case TIFF_IFD8:","+            return 8;","+        default:","+            return 0;","+    }","+}","+","+/* Check that a value which will be passed to TIFFSetField as a single value","+   of the given type, or as an array of len values, matches the definition","+   of the field that libtiff will use. */","+static int","+tiff_needs_field_definition(int is_core_tag, int key) {","+    return !is_core_tag || key == TIFFTAG_TRANSFERFUNCTION || key == TIFFTAG_COLORMAP ||","+           key == TIFFTAG_YCBCRSUBSAMPLING || key == TIFFTAG_REFERENCEBLACKWHITE;","+}","+","+static int","+tiff_special_field_matches(","+    int key, TIFFDataType type, int is_var_length, Py_ssize_t len, long bits_per_sample","+) {","+    if (key == TIFFTAG_COLORMAP) {","+        // libtiff reads three arrays of 1 << BitsPerSample values","+        return is_var_length && type == TIFF_SHORT && bits_per_sample >= 1 &&","+               bits_per_sample <= 16 && len == 3 * ((Py_ssize_t)1 << bits_per_sample);","+    }","+    if (key == TIFFTAG_YCBCRSUBSAMPLING) {","+        return is_var_le