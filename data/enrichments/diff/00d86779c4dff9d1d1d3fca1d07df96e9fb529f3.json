";","+","+// Same ragged-dot hero, but emitted by GemmRewriter for the Triton XTile","+// backend: cuDNN must not claim it.","+absl::string_view kRaggedDotTritonFusionHlo = R\"hlo(","+  fusion1 {","+    p0 = bf16[64,9] parameter(0)","+    p1 = bf16[2,9,8] parameter(1)","+    p2 = s64[2] parameter(2)","+    ROOT rd = bf16[64,8] ragged-dot(p0, p1, p2),","+      lhs_contracting_dims={1}, rhs_contracting_dims={1},","+      lhs_ragged_dims={0}, rhs_group_dims={0}","+  }","+","+  ENTRY e {","+    p0 = bf16[64,9] parameter(0)","+    p1 = bf16[2,9,8] parameter(1)","+    p2 = s64[2] parameter(2)","+    ROOT _ = bf16[64,8] fusion(p0, p1, p2), kind=kCustom, calls=fusion1,","+      backend_config={\"fusion_backend_config\": {kind: \"__triton_gemm\"}}","+  })hlo\";","+"," absl::string_view kLoopDotFusionHlo = R\"hlo(","   wrapped_dot_computation {","     p0 = f32[4,4] parameter(0)","@@ -449,6 +487,21 @@ TEST_F(CudnnBackendTest, GetSupportedConfigsFromScaledDotGemmFusionIsEmpty) {","               IsOkAndHolds(IsEmpty()));"," }"," ","+TEST_F(CudnnBackendTest, SupportsRaggedDotCudnnFusion) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(kRaggedDotCudnnFusionHlo));","+  EXPECT_TRUE(backend_->IsSupported(","+      *hlo_module->entry_computation()->root_instruction()));","+}","+","+TEST_F(CudnnBackendTest, DoesNotSupportRaggedDotTritonFusion) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","+                       ParseAndReturnVerifiedModule(kRaggedDotTritonFusionHlo));","+  HloInstruction& fusion = *hlo_module->entry_computation()->root_instruction();","+  EXPECT_FALSE(backend_->IsSupported(fusion));","+  EXPECT_THAT(backend_->GetSupportedConfigs(fusion), IsOkAndHolds(IsEmpty()));","+}","+"," TEST_F(CudnnBackendTest, GetSupportedConfigsFromCudnnCustomCall) {","   ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> hlo_module,","                        ParseAndReturnVerifiedModule(kCudnnCustomCallHlo));"],"additions":53,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/cost_model/triton_emitter_constraints.cc","lines":["@@ -124,23 +124,32 @@ Decision VerifyTritonConstraints(const TiledHloComputation& tiled_computation,","   // TODO(b/393299275): There is also a lower bound limit for Triton on what","   // is accepted for dimension size (both contracting and free).","   for (const TiledHloInstruction* inst : all_instructions) {","-    if (inst->hlo()->opcode() == HloOpcode::kDot ||","-        inst->hlo()->opcode() == HloOpcode::kScaledDot) {","-      for (const TiledHloInstruction* operand : inst->operands()) {","-        auto op_tile_sizes_or = operand->tile().GetStaticTileSizes();","-        if (!op_tile_sizes_or.ok()) {","-          return Decision(op_tile_sizes_or.status());","-        }","-        llvm::SmallVector<int64_t> op_tile_sizes = std::move(*op_tile_sizes_or);","-","-        for (int64_t size : op_tile_sizes) {","-          if (size > kMaxMMADimSize) {","-            return Decision::Forbid(absl::StrCat(","-                \"Dot operand instruction \", operand->hlo()->name(),","-                \" has a tile size of \", size,","-                \", which exceeds the maximum MMA dimension size of \",","-                kMaxMMADimSize, \".\"));","-          }","+    const HloOpcode opcode = inst->hlo()->opcode();","+    if (opcode != HloOpcode::kDot && opcode != HloOpcode::kScaledDot &&","+        opcode != HloOpcode::kRaggedDot) {","+      continue;","+    }","+    // Only the lhs and the rhs of a ragged-dot are MMA operands.  The","+    // group_sizes operand is read from its buffer rather than as a tile (see","+    // ResolveBufferArgument in the xtile fusion emitter), and its tile may","+    // span all of the groups, so the MMA limit does not apply to it.","+    const int64_t num_mma_operands =","+        opcode == HloOpcode::kRaggedDot ? 2 : inst->operands().size();","+    for (int64_t i = 0; i < num_mma_operands; ++i) {","+      const TiledHloInstruction* operand = inst->operand(i);","+      auto op_tile_sizes_or = operand->tile().GetStaticTileSizes();","+      if (!op_tile_sizes_or.ok()) {","+        return Decision(op_tile_sizes_or.status());","+      }","+      llvm::SmallVector<int64_t> op_tile_sizes = std::move(*op_tile_sizes_or);","+","+      for (int64_t size : op_tile_sizes) {","+        if (size > kMaxMMADimSize) {","+          return Decision::Forbid(","+              absl::StrCat(\"Dot operand instruction \", operand->hlo()->name(),","+                           \" has a tile size of \", size,","+                           \", which exceeds the maximum MMA dimension size of \",","+                           kMaxMMADimSize, \".\"));","         }","       }","     }","@@ -254,12 +263,15 @@ Decision VerifySubsetOfTritonConstraints(","     const TilingSpace& tiling_space, const se::DeviceDescription& device_info) {","   auto dimensions = tiling_space.dimensions();"," ","-  // Hardware MMA limits for Dot / ScaledDot instructions.","+  // Hardware MMA limits for Dot / ScaledDot / RaggedDot instructions.","   // TODO(b/393299275): There is also a lower bound limit for Triton on what","   // is accepted for dimension size (both contracting and free).","   for (const auto& [idx, dim] : llvm::enumerate(dimensions)) {","+    // A ragged-dot's group dimension is always tiled at 1, so no dimension","+    // needs to be excluded here.","     if (dim.hlo != nullptr && (dim.hlo->opcode() == HloOpcode::kDot ||","-                               dim.hlo->opcode() == HloOpcode::kScaledDot)) {","+                               dim.hlo->opcode() == HloOpcode::kScaledDot ||","+                               dim.hlo->opcode() == HloOpcode::kRaggedDot)) {","       if (padded_tile_sizes[idx] > kMaxMMADimSize) {","         return Decision::Forbid(absl::StrCat(","             \"Tile size \", padded_tile_sizes[idx], \" for dimension \", idx,"],"additions":31,"deletions":19,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/cost_model/triton_emitter_constraints_test.cc","lines":["@@ -183,6 +183,66 @@ ENTRY entry_computation {","               StatusIs(_, HasSubstr(\"exceeds the maximum MMA dimension size\")));"," }"," ","+TEST_F(VerifyTritonConstraintsTest, RaggedDotOperandSizeConstraintIsEnforced) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<VerifiedHloModule> module,","+                       ParseAndReturnVerifiedModule(R\"hlo(","+HloModule m","+","+fused_computation {","+  lhs = bf16[128,512] parameter(0)","+  rhs = bf16[4,512,128] parameter(1)","+  gs = s32[4] parameter(2)","+  ROOT rd = bf16[128,128] ragged-dot(lhs, rhs, gs),","+    lhs_contracting_dims={1}, rhs_contracting_dims={1},","+    lhs_ragged_dims={0}, rhs_group_dims={0}","+}","+","+ENTRY entry_computation {","+  lhs = bf16[128,512] parameter(0)","+  rhs = bf16[4,512,128] parameter(1)","+  gs = s32[4] parameter(2)","+  ROOT fusion = bf16[128,128] fusion(lhs, rhs, gs),","+    kind=kCustom, calls=fused_computation,","+    backend_config={\"fusion_backend_config\":{\"kind\":\"__triton\"}}","+}","+)hlo\"));","+","+  // Tile sizes are [M, N] for the output, then the sequential [G, K].","+  EXPECT_OK(CheckTiling(module.get(), {64, 64, 1, 128}));","+  // Having any tile larger than 256 is not allowed for ragged-dots either.","+  EXPECT_THAT(CheckTiling(module.get(), {64, 64, 1, 512}),","+              StatusIs(_, HasSubstr(\"exceeds the maximum MMA dimension size\")));","+}","+","+TEST_F(VerifyTritonConstraintsTest, RaggedDotGroupSizesAreNotMmaOperands) {","+  // The group_sizes operand is read from its buffer rather than as an MMA","+  // operand, so a group count above the MMA dimension limit is fine.","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<VerifiedHloModule> module,","+                       ParseAndReturnVerifiedModule(R\"hlo(","+HloModule m","+","+fused_computation {","+  lhs = bf16[1024,512] parameter(0)","+  rhs = bf16[512,512,128] parameter(1)","+  gs = s32[512] parameter(2)","+  ROOT rd = bf16[1024,128] ragged-dot(lhs, rhs, gs),","+    lhs_contracting_dims={1}, rhs_contracting_dims={1},","+    lhs_ragged_dims={0}, rhs_group_dims={0}","+}","+","+ENTRY entry_computation {","+  lhs = bf16[1024,512] parameter(0)","+  rhs = bf16[512,512,128] parameter(1)","+  gs = s32[512] parameter(2)","+  ROOT fusion = bf16[1024,128] fusion(lhs, rhs, gs),","+    kind=kCustom, calls=fused_computation,","+    backend_config={\"fusion_backend_config\":{\"kind\":\"__triton\"}}","+}","+)hlo\"));","+","+  EXPECT_OK(CheckTiling(module.get(), {64, 64, 1, 128}));","+}","+"," TEST_F(VerifyTritonConstraintsTest, TransposeSharedMemoryConstraintIsEnforced) {","   ASSERT_OK_AND_ASSIGN(std::unique_ptr<VerifiedHloModule> module,","                        ParseAndReturnVerifiedModule(R\"hlo("],"additions":60,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/BUILD","lines":["@@ -2353,11 +2353,13 @@ cc_library(","         \"//xla:util\",","         \"//xla:xla_data_proto_cc\",","         \"//xla:xla_proto_cc\",","+        \"//xla/codegen/xtile:xtile_config_proto_cc\",","         \"//xla/hlo/evaluator:hlo_evaluator\",","         \"//xla/hlo/ir:dfs_hlo_visitor_with_default\",","         \"//xla/hlo/ir:hlo\",","         \"//xla/hlo/pass:hlo_pass\",","         \"//xla/service:algorithm_util\",","+        \"//xla/service:decision\",","         \"//xla/service:hlo_creation_utils\",","         \"//xla/service:matmul_indexing_utils\",","         \"//xla/service:pattern_matcher\",","@@ -2368,6 +2370,7 @@ cc_library(","         \"//xla/service/gpu:matmul_utils\",","         \"//xla/stream_executor:blas\",","         \"//xla/stream_executor:device_description\",","+        \"//xla/stream_executor:dnn\",","         \"//xla/stream_executor:semantic_version\",","         \"//xla/stream_executor/cuda:cuda_compute_capability\",","         \"//xla/stream_executor/gpu:gpu_blas_lt\",","@@ -2377,6 +2380,7 @@ cc_library(","         \"//xla/tsl/protobuf:dnn_proto_cc\",","         \"@com_google_absl//absl/algorithm:container\",","         \"@com_google_absl//absl/container:flat_hash_set\",","+        \"@com_google_absl//absl/container:inlined_vector\",","         \"@com_google_absl//absl/log\",","         \"@com_google_absl//absl/log:check\",","         \"@com_google_absl//absl/status\","],"additions":4,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/gemm_rewriter.cc","lines":["@@ -23,10 +23,12 @@ limitations under the License."," #include <cmath>"," #include <cstddef>"," #include <cstdint>","+#include <functional>"," #include <initializer_list>"," #include <limits>"," #include <memory>"," #include <optional>","+#include <string>"," #include <tuple>"," #include <unordered_set>"," #include <utility>","@@ -34,13 +36,16 @@ limitations under the License."," "," #include \"absl/algorithm/container.h\""," #include \"absl/container/flat_hash_set.h\"","+#include \"absl/container/inlined_vector.h\""," #include \"absl/log/check.h\""," #include \"absl/log/log.h\""," #include \"absl/status/status.h\""," #include \"absl/status/status_macros.h\""," #include \"absl/status/statusor.h\"","+#include \"absl/strings/str_cat.h\""," #include \"absl/strings/string_view.h\""," #include \"absl/types/span.h\"","+#include \"xla/codegen/xtile/xtile_config.pb.h\""," #include \"xla/hlo/evaluator/hlo_evaluator.h\""," #include \"xla/hlo/ir/dfs_hlo_visitor_with_default.h\""," #include \"xla/hlo/ir/hlo_casting_utils.h\"","@@ -54,6 +59,7 @@ limitations under the License."," #include \"xla/permutation_util.h\""," #include \"xla/primitive_util.h\""," #include \"xla/service/algorithm_util.h\"","+#include \"xla/service/decision.h\""," #include \"xla/service/gpu/backend_configs.pb.h\""," #include \"xla/service/gpu/cublas_cudnn.h\""," #include \"xla/service/gpu/gpu_fusible.h\"","@@ -68,6 +74,7 @@ limitations under the License."," #include \"xla/stream_executor/blas.h\""," #include \"xla/stream_executor/cuda/cuda_compute_capability.h\""," #include \"xla/stream_executor/device_description.h\"","+#include \"xla/stream_executor/dnn.h\""," #include \"xla/stream_executor/gpu/gpu_blas_lt.h\""," #include \"xla/stream_executor/rocm/rocm_compute_capability.h\""," #include \"xla/stream_executor/semantic_version.h\"","@@ -684,6 +691,72 @@ absl::StatusOr<HloInstruction*> NormalizeBatchDimensions(HloInstruction* dot) {","   return MakeReshapeHlo(dot->shape(), new_dot);"," }"," ","+// Classifies a ragged-dot by the role its lhs ragged dimension plays in the dot","+// dimension numbers. Requires `lhs_ragged_dimensions` to be non-empty; only the","+// first ragged dimension is considered.","+se::gpu::RaggedDotMode GetRaggedDotMode(","+    const RaggedDotDimensionNumbers& ragged_dims) {","+  const DotDimensionNumbers& dot_dims = ragged_dims.dot_dimension_numbers();","+  const int64_t lhs_ragged_dim = ragged_dims.lhs_ragged_dimensions(0);","+  if (absl::c_linear_search(dot_dims.lhs_batch_dimensions(), lhs_ragged_dim)) {","+    return se::gpu::RaggedDotMode::kRaggedBatch;","+  }","+  if (absl::c_linear_search(dot_dims.lhs_contracting_dimensions(),","+                            lhs_ragged_dim)) {","+    return se::gpu::RaggedDotMode::kRaggedContracting;","+  }","+  return se::gpu::RaggedDotMode::kRaggedNonContracting;","+}","+","+// Default XTile tile sizes for a ragged-dot fusion; an autotuner may later","+// override them.","+constexpr int64_t kDefaultRaggedDotBlockM = 32;","+constexpr int64_t kDefaultRaggedDotBlockN = 32;","+constexpr int64_t kDefaultRaggedDotBlockK = 32;","+","+// Builds the sequential-dimension tile sizes carried by the ragged-dot inside","+// an XTile fusion computation.","+xtile::Tile BuildRaggedDotSequentialTile(const DotDimensionNumbers& dot_dims,","+                                         se::gpu::RaggedDotMode ragged_mode) {","+  xtile::Tile tile;","+  switch (ragged_mode) {","+    case se::gpu::RaggedDotMode::kRaggedBatch:","+      // A plain batched GEMM: only the contraction is sequential.","+      for (int i = 0; i < dot_dims.lhs_contracting_dimensions_size(); ++i) {","+        tile.add_sizes(kDefaultRaggedDotBlockK);","+      }","+      break;","+    case se::gpu::RaggedDotMode::kRaggedNonContracting:","+      tile.add_sizes(1);                        // G sequential dim","+      tile.add_sizes(kDefaultRaggedDotBlockK);  // K sequential dim","+      break;","+    case se::gpu::RaggedDotMode::kRaggedContracting:","+      tile.add_sizes(kDefaultRaggedDotBlockM);  // M sequential dim","+      break;","+  }","+  return tile;","+}","+","+// Builds the parallel output tile sizes carried by an XTile ragged-dot fusion","+// instruction.","+xtile::Tile BuildRaggedDotOutputTile(const DotDimensionNumbers& dot_dims,","+                                     se::gpu::RaggedDotMode ragged_mode) {","+  xtile::Tile tile;","+  if (ragged_mode == se::gpu::RaggedDotMode::kRaggedContracting) {","+    tile.add_sizes(1);  // G dim tile size = 1","+  }","+  for (int i = 0; i < dot_dims.lhs_batch_dimensions_size(); ++i) {","+    tile.add_sizes(1);  // one batch element per tile","+  }","+  if (ragged_mode == se::gpu::RaggedDotMode::kRaggedContracting) {","+    tile.add_sizes(kDefaultRaggedDotBlockK);  // K output tile","+  } else {","+    tile.add_sizes(kDefaultRaggedDotBlockM);  // M output tile","+  }","+  tile.add_sizes(kDefaultRaggedDotBlockN);  // N output tile","+  return tile;","+}","+"," // The rewriting proceeds in a bottom-up way:"," //"," // (kDot A B) is rewritten into a (kCustomCall:gemm A B)","@@ -718,12 +791,17 @@ absl::StatusOr<HloInstruction*> NormalizeBatchDimensions(HloInstruction* dot) {"," // when the output of the GEMM is requested in FP8 format."," class GemmRewriterVisitor : public DfsHloRewriteVisitor {","  public:","-  explicit GemmRewriterVisitor(const se::GpuComputeCapability& gpu_version,","-                               se::SemanticVersion toolkit_version,","-                               const GemmRewriterOptions options)","+ 