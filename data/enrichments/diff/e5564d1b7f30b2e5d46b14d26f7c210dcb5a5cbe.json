st [pathToConfig, options] = presetCall?.arguments ?? [];","+  if (!pathToConfig) {","+    return false;","+  }","+","+  const replace = (start: number, end: number, text: string) =>","+    tree.write(","+      configFilePath,","+      `${contents.slice(0, start)}${text}${contents.slice(end)}`","+    );","+  const buildTargetLiteral = JSON.stringify(buildTarget);","+","+  if (!options) {","+    const insertAt = pathToConfig.getEnd();","+    replace(insertAt, insertAt, `, { buildTarget: ${buildTargetLiteral} }`);","+    return true;","+  }","+  if (!ts.isObjectLiteralExpression(options)) {","+    return false;","+  }","+","+  const effectiveProperty = [...options.properties]","+    .reverse()","+    .find(","+      (property) =>","+        ts.isSpreadAssignment(property) ||","+        isUnresolvedComputedName(property.name) ||","+        getPropertyName(property.name) === 'buildTarget'","+    );","+  if (!effectiveProperty) {","+    // `__proto__: value` sets the prototype, which can provide buildTarget","+    if (","+      options.properties.some(","+        (property) =>","+          ts.isPropertyAssignment(property) &&","+          !ts.isComputedPropertyName(property.name) &&","+          getPropertyName(property.name) === '__proto__'","+      )","+    ) {","+      return false;","+    }","+    const insertAt = options.getStart() + 1;","+    replace(insertAt, insertAt, ` buildTarget: ${buildTargetLiteral},`);","+    return true;","+  }","+  if (ts.isShorthandPropertyAssignment(effectiveProperty)) {","+    replace(","+      effectiveProperty.getStart(),","+      effectiveProperty.getEnd(),","+      `buildTarget: buildTarget || ${buildTargetLiteral}`","+    );","+    return true;","+  }","+  if (","+    !ts.isPropertyAssignment(effectiveProperty) ||","+    isUnresolvedComputedName(effectiveProperty.name)","+  ) {","+    return false;","+  }","+","+  const value = effectiveProperty.initializer;","+  if (ts.isStringLiteralLike(value) && value.text) {","+    return true;","+  }","+  // The factory parenthesizes the left operand when precedence requires it","+  const needsParentheses = ts.isParenthesizedExpression(","+    ts.factory.createBinaryExpression(","+      value,","+      ts.SyntaxKind.BarBarToken,","+      ts.factory.createStringLiteral(buildTarget)","+    ).left","+  );","+  const valueText = value.getText();","+  replace(","+    value.getStart(),","+    value.getEnd(),","+    `${needsParentheses ? `(${valueText})` : valueText} || ${buildTargetLiteral}`","+  );","+  return true;","+}","+","+function isUnresolvedComputedName(name: PropertyName): boolean {","+  return ts.isComputedPropertyName(name) && getPropertyName(name) === null;","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"packages/cypress/src/generators/convert-to-inferred/lib/add-dev-server-target-to-config.spec.ts","lines":["@@ -245,5 +245,41 @@ export default defineConfig({","         });\"","       `);","     });","+","+    it('should update webServerCommands and ciWebServerCommand values that use type assertions', () => {","+      // ARRANGE","+      tree.write(","+        configFilePath,","+        `import { nxE2EPreset } from '@nx/cypress/plugins/cypress-preset';","+import { defineConfig } from 'cypress';","+","+export default defineConfig({","+  e2e: {","+    ...nxE2EPreset(__filename, { cypressDir: 'src', webServerCommands: <Record<string, string>>{default: \"npx nx run test:serve\"}, ciWebServerCommand: <string>\"npx nx run test:static-serve\" }),","+    baseUrl: \"http://localhost:4200\",","+  },","+});`","+      );","+      // ACT","+      addDevServerTargetToConfig(","+        tree,","+        configFilePath,","+        { default: 'npx nx run myorg:serve' },","+        'npx nx run myorg:static-serve'","+      );","+","+      // ASSERT","+      expect(tree.read(configFilePath, 'utf-8')).toMatchInlineSnapshot(`","+        \"import { nxE2EPreset } from '@nx/cypress/plugins/cypress-preset';","+        import { defineConfig } from 'cypres