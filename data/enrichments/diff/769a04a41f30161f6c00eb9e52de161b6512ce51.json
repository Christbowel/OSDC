{"id":"769a04a41f30161f6c00eb9e52de161b6512ce51","axis":"silent","repo":"payloadcms/payload","sha":"769a04a41f30161f6c00eb9e52de161b6512ce51","parsed":{"files":[{"path":"docs/migration-guide/v4.mdx","lines":["@@ -1118,6 +1118,43 @@ export const MyFeature = createServerFeature({"," "," If an affected adapter or feature performs asynchronous work, move that work to an asynchronous plugin before config sanitization or to a runtime hook. Projects that only use `buildConfig(...)` and `lexicalEditor(...)` normally are not affected; `buildConfig` remains asynchronous."," ","+### Lexical converters render the saved text direction","+","+The Lexical HTML converters and the `RichText` JSX component now render a `dir` attribute on elements with an explicit `direction` (`'ltr'` or `'rtl'`), matching the editor. Elements with `direction: null` render no `dir` and inherit the page direction, as before.","+","+```diff","+- <p>مرحبا</p>","++ <p dir=\"rtl\">مرحبا</p>","+```","+","+Content saved with Lexical versions before 0.35, or created with `buildEditorState` before Payload 4.0, can contain a `direction: 'ltr'` that nobody chose. That content now renders as `dir=\"ltr\"`. If text displays in the wrong direction, set `direction` to `null` on its element nodes, for example in a migration:","+","+```ts","+type ElementNode = {","+  children?: ElementNode[]","+  direction?: 'ltr' | 'rtl' | null","+}","+","+function clearDirection<T extends ElementNode>({ node }: { node: T }): T {","+  if (!node.children) {","+    return node","+  }","+","+  return {","+    ...node,","+    children: node.children.map((child) => clearDirection({ node: child })),","+    direction: null,","+  }","+}","+","+const content = {","+  ...doc.content,","+  root: clearDirection({ node: doc.content.root }),","+}","+```","+","+Custom HTML converters receive the attribute as `providedDirAttribute`. Add it to the opening tag, next to `providedStyleTag`, to render it too.","+"," ### Transaction requests now use a single identifier property"," "," The `transactionIDPromise` property on `PayloadRequest` has been removed. It was deprecated and unused — `transactionID` (which already supports `Promise<number | string>`) is the correct property to use for both resolved values and pending transactions."],"additions":37,"deletions":0,"truncated":false},{"path":"packages/richtext-lexical/src/features/converters/direction.spec.ts","lines":["@@ -0,0 +1,120 @@","+import { createElement } from 'react'","+import { renderToStaticMarkup } from 'react-dom/server'","+import { describe, expect, it } from 'vitest'","+","+import type {","+  DefaultTypedEditorState,","+  LexicalElementDirection,","+  SerializedHeadingNode,","+  SerializedParagraphNode,","+  SerializedTextNode,","+} from '../../types/nodeTypes.js'","+","+import { convertLexicalToHTMLAsync } from './lexicalToHtml/async/index.js'","+import { convertLexicalToHTML } from './lexicalToHtml/sync/index.js'","+import { RichText } from './lexicalToJSX/Component/index.js'","+","+type ConvertArgs = {","+  data: DefaultTypedEditorState","+}","+","+const converters: { convert: (args: ConvertArgs) => Promise<string>; name: string }[] = [","+  {","+    name: 'lexicalToHtml (sync)',","+    convert: async (args) => convertLexicalToHTML({ ...args, disableContainer: true }),","+  },","+  {","+    name: 'lexicalToHtml (async)',","+    convert: (args) => convertLexicalToHTMLAsync({ ...args, disableContainer: true }),","+  },","+  {","+    name: 'lexicalToJSX',","+    convert: async (args) =>","+      renderToStaticMarkup(createElement(RichText, { ...args, disableContainer: true })),","+  },","+]","+","+describe.each(converters)('$name - text direction', ({ convert }) => {","+  it.each(['ltr', 'rtl'] as const)('should render an explicit %s direction as dir', async (dir) => {","+    const html = await convert({","+      data: editorState({ children: [paragraphNode({ direction: dir })] }),","+    })","+","+    expect(html).toBe(`<p dir=\"${dir}\">مرحبا</p>`)","+  })","+","+  it('should not render dir when the direction is null', async () => {","+    const html = await convert({","+      data: editorState({ children: [paragraphNode({ direction: null })] }),","+    })","+","+    expect(html).toBe('<p>مرحبا</p>')","+  })","+","+  it('should render dir only on the nodes that have an explicit direction', async () => {","+    const html = await convert({","+      data: editorState({","+        children: [paragraphNode({ direction: null }), headingNode({ direction: 'rtl' })],","+      }),","+    })","+","+    expect(html).toBe('<p>مرحبا</p><h2 dir=\"rtl\">مرحبا</h2>')","+  })","+})","+","+function textNode(): SerializedTextNode {","+  return {","+    type: 'text',","+    detail: 0,","+    format: 0,","+    mode: 'normal',","+    style: '',","+    text: 'مرحبا',","+    version: 1,","+  }","+}","+","+function paragraphNode({","+  direction,","+}: {","+  direction: LexicalElementDirection","+}): SerializedParagraphNode {","+  return {","+    type: 'paragraph',","+    children: [textNode()],","+    direction,","+    format: '',","+    indent: 0,","+    textFormat: 0,","+    version: 1,","+  }","+}","+","+function headingNode({ direction }: { direction: LexicalElementDirection }): SerializedHeadingNode {","+  return {","+    type: 'heading',","+    children: [textNode()],","+    direction,","+    format: '',","+    indent: 0,","+    tag: 'h2',","+    version: 1,","+  }","+}","+","+function editorState({","+  children,","+}: {","+  children: (SerializedHeadingNode | SerializedParagraphNode)[]","+}): DefaultTypedEditorState {","+  return {","+    root: {","+      type: 'root',","+      children,","+      direction: null,","+      format: '',","+      indent: 0,","+      version: 1,","+    },","+  }","+}"],"additions":120,"deletions":0,"truncated":false},{"path":"packages/richtext-lexical/src/features/converters/lexicalToHtml/async/converters/blockquote.ts","lines":["@@ -2,13 +2,13 @@ import type { SerializedQuoteNode } from '../../