{"id":"3f34c5e91fb6a8c0cdec5e406a544a0c878584c4","axis":"silent","repo":"symfony/symfony","sha":"3f34c5e91fb6a8c0cdec5e406a544a0c878584c4","parsed":{"files":[{"path":"src/Symfony/Component/KeyManagement/Bridge/AzureKeyVault/AzureKeyVault.php","lines":["@@ -36,12 +36,12 @@","  * for its audience.","  *","  * Algorithm matrix:","- *   - RSA keys: `RSA-OAEP-256` (default), `RSA-OAEP`, `RSA1_5`. Suited to","+ *   - RSA keys: `RSA-OAEP-256` (default). Suited to","  *     small payloads (config secrets, DEK wrapping). RSA does not support","  *     AAD, so a non-empty `$aad` triggers {@see UnsupportedOperationException}.","  *   - Symmetric AES keys (Managed HSM or Key Vault Premium in preview):","- *     `A256GCM` / `A192GCM` / `A128GCM` are AEAD and accept AAD natively;","- *     CBC variants do not.","+ *     `A256GCM` / `A192GCM` / `A128GCM` are AEAD and accept AAD natively.","+ *     `A128KW` / `A192KW` / `A256KW` are accepted only for data-key wrapping and have no AAD support.","  *","  * `generateDataKey()` is implemented locally (Azure has no `GenerateDataKey`","  * primitive): a fresh DEK is drawn with `random_bytes()` and wrapped via","@@ -66,6 +66,8 @@"," final class AzureKeyVault implements DecrypterInterface, EncrypterInterface, DataKeyGeneratorInterface"," {","     private const array AEAD_ALGORITHMS = ['A128GCM', 'A192GCM', 'A256GCM'];","+    private const array ENCRYPT_ALGORITHMS = ['RSA-OAEP-256', ...self::AEAD_ALGORITHMS];","+    private const array WRAP_ALGORITHMS = [...self::ENCRYPT_ALGORITHMS, 'A128KW', 'A192KW', 'A256KW'];"," ","     // See https://learn.microsoft.com/azure/key-vault/general/about-keys-secrets-certificates#object-identifiers","     private const string KEY_ID_PATTERN = '~\\A([0-9A-Za-z-]{1,127})(?:/(?1))?\\z~';","@@ -77,6 +79,8 @@ public function __construct(","         private readonly string $wrapAlgorithm = 'RSA-OAEP-256',","         private readonly string $apiVersion = '7.4',","     ) {","+        self::validateAlgorithm($encryptAlgorithm, self::ENCRYPT_ALGORITHMS, 'encryption');","+        self::validateAlgorithm($wrapAlgorithm, self::WRAP_ALGORITHMS, 'wrapping');","     }"," ","     public function encrypt(string $keyId, #[\\SensitiveParameter] string $plaintext, string $aad = ''): Ciphertext","@@ -99,12 +103,14 @@ public function encrypt(string $keyId, #[\\SensitiveParameter] string $plaintext,","             throw new RuntimeException('Azure Key Vault returned a malformed response (missing \"value\").');","         }"," ","-        $blob = $data['value'];","+        $blob = $this->encryptAlgorithm.'.'.$data['value'];","         if (\\in_array($this->encryptAlgorithm, self::AEAD_ALGORITHMS, true)) {","-            if (!isset($data['iv'], $data['tag']) || !\\is_string($data['iv']) || !\\is_string($data['tag'])) {","+            if (!isset($data['iv'], $data['tag']) || !\\is_string($data['iv']) || '' === $data['iv'] || !\\is_string($data['tag']) || '' === $data['tag']) {","                 throw new RuntimeException('Azure Key Vault returned a malformed AEAD response (missing \"iv\"/\"tag\").');","             }","             $blob = $this->encryptAlgorithm.'.'.$data['iv'].'.'.$data['tag'].'.'.$data['value'];","+        } elseif ('' === $data['value']) {","+            throw new RuntimeException('Azure Key Vault returned an empty ciphertext.');","         }"," ","         return new Ciphertext($blob, $this->resolvedKeyId($data, $keyId));","@@ -116,7 +122,7 @@ public function decrypt(Ciphertext $ciphertext, string $aad = ''): string","             throw new DecryptionFailedException();","         }"," ","-        $body = $this->buildDecryptBody($ciphertext->blob, $aad, $this->encryptAlgorithm);","+        $body = $this->buildDecryptBody($ciphertext->blob, $aad, self::ENCRYPT_ALGORITHMS);"," ","         $data = $this->request('POST', $this->keyPath($ciphertext->keyId, 'decrypt'), $body, $ciphertext->keyId, true);"," ","@@ -163,12 +169,14 @@ public function wrapDataKey(string $keyId, #[\\SensitiveParameter] string $dataKe","             throw new RuntimeException('Azure Key Vault returned a malformed response (missing \"value\").');","         }"," ","-        $blob = $data['value'];","+        $blob = $this->wrapAlgorithm.'.'.$data['value'];","         if (\\in_array($this->wrapAlgorithm, self::AEAD_ALGORITHMS, true)) {","-            if (!isset($data['iv'], $data['tag']) || !\\is_string($data['iv']) || !\\is_string($data['tag'])) {","+            if (!isset($data['iv'], $data['tag']) || !\\is_string($data['iv']) || '' === $data['iv'] || !\\is_string($data['tag']) || '' === $data['tag']) {","                 throw new RuntimeException('Azure Key Vault returned a malformed AEAD wrap response (missing \"iv\"/\"tag\").');","             }","             $blob = $this->wrapAlgorithm.'.'.$data['iv'].'.'.$data['tag'].'.'.$data['value'];","+        } elseif ('' === $data['value']) {","+            throw new RuntimeException('Azure Key Vault returned an empty wrapped data key.');","         }"," ","         return new Ciphertext($blob, $this->resolvedKeyId($data, $keyId));","@@ -180,7 +188,7 @@ public function unwrapDataKey(Ciphertext $wrapped, string $aad = ''): DataKey","             throw new DecryptionFailedException();","         }"," ","-        $body = $this->buildDecryptBody($wrapped->blob, $aad, $this->wrapAlgorithm);","+        $body = $this->buildDecryptBody($wrapped->blob, $aad, self::WRAP_ALGORITHMS);"," ","         $data = $this->request('POST', $this->keyPath($wrapped->keyId, 'unwrapkey'), $body, $wrapped->keyId, true);"," ","@@ -196,6 +204,16 @@ public function unwrapDataKey(Ciphertext $wrapped, string $aad = ''): DataKey","         return new DataKey($plaintext, $wrapped);","     }"," ","+    /**","+     * @param list<string> $supported","+     */","+    private static function validateAlgorithm(string $algorithm, array $supported, string $operation): void","+    {","+        if (!\\in_array($algorithm, $supported, true)) {","+            throw new InvalidArgumentException(\\sprintf('The \"%s\" algorithm must be one of \"%s\", \"%s\" given.', $operation, implode('\", \"', $supported), $algorithm));","+        }","+    }","+","     private function keyPath(string $keyId, string $operation): string","     {","         if (!self::isKeyId($keyId)) {","@@ -244,20 +262,27 @@ private function resolvedKeyId(array $data, string $requestedKeyId): string","     }"," ","     /**","-     * Builds the decrypt/unwrap body.","+     * Builds the decrypt/unwrap body from the algorithm recorded in the blob.","      *","-     * The algorithm is auto-detected from the AEAD blob prefix when present, so","-     * that ciphertexts written under a previous configuration can still be","-     * decoded after a config rotation.","+     * @param list<string> $supported","      *","      * @return array<string, mixed>","      */","-    private function buildDecryptBody(string $blob, string $aad, string $fallbackAlgorithm): array","+    private function buildDecryptBody(string $blob, string $aad, array $supported): array","     {","-        $aeadPrefix = self::detectAeadAlgorithm($blob);","+        $parts = explode('.', $blob, 5);","+        $algorithm = array_shift($parts);"," ","-        if (null !== $aeadPrefix) {","-            [$algorithm, $iv, $tag, $value] = $aeadPrefix;","+        if (!\\in_array($algorithm, $supported, true)) {","+            throw new DecryptionFailedException();","+        }","+","+        if (\\in_array($algorithm, self::AEAD_ALGORITHMS, true)) {","+            if (3 !== \\count($parts) || '' === $parts[0] || '' === $parts[1]) {","+                throw new DecryptionFailedException();","+            }","+","+            [$iv, $tag, $value] = $parts;","             $body = ['alg' => $algorithm, 'iv' => $iv, 'tag' => $tag, 'value' => $value];","             if ('' !== $aad) {","                 $body['aad'] = Base64UrlSafe::encode($aad);","@@ -266,31 +291,15 @@ private function buildDecryptBody(string $blob, string $aad, string $fallbackAlg","             return $body;","         }"," ","-        if (\\in_array($fallbackAlgorithm, self::AEAD_ALGORITHMS, true)) {","+        if (1 !== \\count($parts) || '' === $parts[0]) {","             throw new DecryptionFailedException();","         }"," ","         if ('' !== $aad) {","-            throw new UnsupportedOperationException(\\sprintf('Algorithm \"%s\" cannot enforce AAD; configure an AEAD algorithm (A128GCM, A192GCM, A256GCM) to use AAD with Azure Key Vault.', $fallbackAlgorithm));","-        }","-","-        return ['alg' => $fallbackAlgorithm, 'value' => $blob];","-    }","-","-    /**","-     * @return array{0: string, 1: string, 2: string, 3: string}|null","-     */","-    private static function detectAeadAlgorithm(string $blob): ?array","-    {","-        if (!str_contains($blob, '.')) {","-            return null;","-        }","-        $parts = explode('.', $blob, 4);","-        if (4 !== \\count($parts) || !\\in_array($parts[0], self::AEAD_ALGORITHMS, true)) {","-            return null;","+            throw new UnsupportedOperationException(\\sprintf('Algorithm \"%s\" cannot enforce AAD; configure an AEAD algorithm (A128GCM, A192GCM, A256GCM) to use AAD with Azure Key Vault.', $algorithm));","         }"," ","-        return $parts;","+        return ['alg' => $algorithm, 'value' => $parts[0]];","     }"," ","     /**"],"additions":45,"deletions":36,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/AzureKeyVault/AzureKeyVaultFactory.php","lines":["@@ -63,26 +63,7 @@ public function __construct(","         '.managedhsm.azure.cn',","     ];"," ","-    /**","-     * Azure answers HTTP 400 to an unknown \"alg\", which the decrypt path masks as a decryption failure.","-     */","-    private const array ALGORITHMS = [","-        'RSA-OAEP-256',","-        'RSA-OAEP',","-        'RSA1_5',","-        'A128GCM',","-        'A192GCM',","-        'A256GCM',","-        'A128CBC',","-        'A192CBC',","-        'A256CBC',","-        'A128CBCPAD',","-        'A192CBCPAD',","-        'A256CBCPAD',","-        'A128KW',","-        'A192KW',","-        'A256KW',","-    ];","+    private const array ALGORITHMS = ['RSA-OAEP-256', 'A128GCM', 'A192GCM', 'A256GCM'];"," ","     public function supports(#[\\SensitiveParameter] Dsn $dsn): bool","     {","@@ -129,8 +110,9 @@ public function create(#[\\SensitiveParameter] Dsn $dsn): EncrypterInterface&Decr","     private static function algorithmOption(Dsn $dsn, string $option): string","     {","         $algorithm = $dsn->getOption($option, 'RSA-OAEP-256');","-        if (!\\in_array($algorithm, self::ALGORITHMS, true)) {","-            throw new InvalidArgumentException(\\sprintf('The \"%s\" option of the \"%s://\" DSN must be one of \"%s\", \"%s\" given.', $option, $dsn->scheme, implode('\", \"', self::ALGORITHMS), $algorithm));","+        $supported = 'wrap_algorithm' === $option ? [...self::ALGORITHMS, 'A128KW', 'A192KW', 'A256KW'] : self::ALGORITHMS;","+        if (!\\in_array($algorithm, $supported, true)) {","+            throw new InvalidArgumentException(\\sprintf('The \"%s\" option of the \"%s://\" DSN must be one of \"%s\", \"%s\" given.', $option, $dsn->scheme, implode('\", \"', $supported), $algorithm));","         }"," ","         return $algorithm;"],"additions":4,"deletions":22,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/AzureKeyVault/README.md","lines":["@@ -60,19 +60,20 @@ Algorithms"," "," The bridge accepts two configurable algorithms:"," ","-  * `encryptAlgorithm` (default `RSA-OAEP-256`): used by `encrypt()`/`decrypt()`.","-    `RSA-OAEP`, `RSA1_5` and the AEAD variants `A128GCM`/`A192GCM`/`A256GCM`","-    are also accepted (the AEAD variants require a symmetric key, available","-    on Managed HSM or Key Vault Premium in preview).","-  * `wrapAlgorithm` (default `RSA-OAEP-256`): used by `generateDataKey()`,","-    `wrapDataKey()` and `unwrapDataKey()`. Same algorithm set as above; with a","-    symmetric key you can use `A128KW` / `A192KW` / `A256KW` by setting it","-    explicitly.","-","-The DSN factory only accepts the algorithm names Azure Key Vault documents","-(`RSA-OAEP-256`, `RSA-OAEP`, `RSA1_5`, the `A*GCM`, `A*CBC`, `A*CBCPAD` and","-`A*KW` families) so that a typo does not surface later as a decryption","-failure, which is how the decrypt path reports Azure's HTTP 400.","+  * `encryptAlgorithm` (default `RSA-OAEP-256`): selects the algorithm for `encrypt()`.","+    The AEAD variants `A128GCM`/`A192GCM`/`A256GCM` are also accepted.","+    These require a symmetric key, available on Managed HSM or Key Vault Premium in preview.","+  * `wrapAlgorithm` (default `RSA-OAEP-256`): selects the algorithm for `generateDataKey()` and `wrapDataKey()`.","+    The same algorithms are accepted; with a symmetric key you can also select `A128KW` / `A192KW` / `A256KW` explicitly.","+","+The constructor and DSN factory reject any other algorithm.","+`RSA-OAEP` and `RSA1_5` are excluded following [Microsoft's recommendations](https://learn.microsoft.com/azure/key-vault/keys/about-keys-details#rsa-algorithms).","+CBC variants are excluded because the bridge does not preserve their IV and they do not authenticate ciphertexts.","+AES-KW is accepted only for data-key wrapping.","+","+Every blob records its algorithm, so a configuration change only affects new writes.","+Reads use the recorded algorithm, subject to the same payload or wrapping allowlist.","+Unprefixed blobs and malformed algorithm prefixes are rejected."," "," `encrypt()` / `decrypt()` go through the RSA path by default and are therefore"," suited to small payloads (config secrets, tokens). For arbitrary-size","@@ -105,7 +106,7 @@ Examples:"," "," ```"," azure-keyvault://CLIENT_ID:CLIENT_SECRET@my-vault.vault.azure.net?tenant=TENANT_ID","-azure-keyvault://CLIENT_ID:CLIENT_SECRET@my-vault.vault.azure.net?tenant=TENANT_ID&algorithm=RSA-OAEP&api_version=7.4","+azure-keyvault://CLIENT_ID:CLIENT_SECRET@my-vault.vault.azure.net?tenant=TENANT_ID&algorithm=RSA-OAEP-256&api_version=7.4"," azure-keyvault://CLIENT_ID:CLIENT_SECRET@my-hsm.managedhsm.azure.net?tenant=TENANT_ID&algorithm=A256GCM&wrap_algorithm=A256KW"," ```"," ","@@ -113,15 +114,13 @@ AAD support"," -----------"," "," AEAD algorithms (`A128GCM`/`A192GCM`/`A256GCM`) accept Azure's `aad`","-parameter natively and are integrity-protected. RSA algorithms have no AAD","-concept; passing a non-empty `$aad` to an RSA-configured bridge raises","-`UnsupportedOperationException`.","-","-For AEAD ciphertexts, this bridge concatenates the algorithm, IV, tag and","-value into a single dot-separated blob (`<alg>.<iv>.<tag>.<value>`, all","-base64url) so callers can store one opaque ciphertext and let the bridge","-recover its parts on decrypt. The pieces themselves are exactly what Azure","-returns; nothing is added to or stripped from them.","+parameter natively and are integrity-protected.","+RSA and AES-KW have no AAD support; passing a non-empty `$aad` with either algorithm raises `UnsupportedOperationException`.","+","+For AEAD ciphertexts and wrapped keys, the blob is `<alg>.<iv>.<tag>.<value>`.","+For RSA ciphertexts and RSA or AES-KW wrapped keys, it is `<alg>.<value>`.","+The IV, tag and value are the base64url fields returned by Azure; the algorithm prefix is added by the bridge and removed before sending a read request.","+Callers store the complete opaque blob, together with its key ID."," "," Resources"," ---------"],"additions":22,"deletions":23,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/AzureKeyVault/Tests/AzureKeyVaultAlgorithmsTest.php","lines":["@@ -0,0 +1,274 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\Bridge\\AzureKeyVault\\Tests;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\HttpClient\\MockHttpClient;","+use Symfony\\Component\\HttpClient\\Response\\MockResponse;","+use Symfony\\Component\\KeyManagement\\Base64UrlSafe;","+use Symfony\\Component\\KeyManagement\\Bridge\\AzureKeyVault\\AzureKeyVault;","+use Symfony\\Component\\KeyManagement\\Bridge\\AzureKeyVault\\AzureKeyVaultFactory;","+use Symfony\\Component\\KeyManagement\\Bridge\\AzureKeyVault\\TokenProviderInterface;","+use Symfony\\Component\\KeyManagement\\Ciphertext;","+use Symfony\\Component\\KeyManagement\\Dsn;","+use Symfony\\Component\\KeyManagement\\Exception\\DecryptionFailedException;","+use Symfony\\Component\\KeyManagement\\Exception\\InvalidArgumentException;","+use Symfony\\Component\\KeyManagement\\Exception\\RuntimeException;","+use Symfony\\Component\\KeyManagement\\Exception\\UnsupportedOperationException;","+","+class AzureKeyVaultAlgorithmsTest extends TestCase","+{","+    private const string VAULT = 'https://my-vault.vault.azure.net/';","+","+    #[DataProvider('provideUnsupportedAlgorithms')]","+    public function testConstructorRejectsUnsupportedAlgorithms(string $algorithm, bool $wrapping)","+    {","+        $this->expectException(InvalidArgumentException::class);","+","+        new AzureKeyVault(new MockHttpClient(), $this->tokens(), $wrapping ? 'RSA-OAEP-256' : $algorithm, $wrapping ? $algorithm : 'RSA-OAEP-256');","+    }","+","+    #[DataProvider('provideUnsupportedAlgorithms')]","+    public function testFactoryRejectsUnsupportedAlgorithms(string $algorithm, bool $wrapping)","+    {","+        $this->expectException(InvalidArgumentException::class);","+","+        (new AzureKeyVaultFactory())->create(Dsn::fromString('azure-keyvault://id:secret@my-vault.vault.azure.net?tenant=t&'.($wrapping ? 'wrap_algorithm' : 'algorithm').'='.$algorithm));","+    }","+","+    public static function provideUnsupportedAlgorithms(): iterable","+    {","+        foreach (['RSA-OAEP', 'RSA1_5', 'A128CBC', 'A192CBC', 'A256CBC', 'A128CBCPAD', 'A192CBCPAD', 'A256CBCPAD', 'unknown'] as $algorithm) {","+            yield 'encrypt '.$algorithm => [$algorithm, false];","+            yield 'wrap '.$algorithm => [$algorithm, true];","+        }","+","+        foreach (['A128KW', 'A192KW', 'A256KW'] as $algorithm) {","+            yield 'encrypt '.$algorithm => [$algorithm, false];","+        }","+    }","+","+    #[DataProvider('provideNonAeadWrites')]","+    public function testNonAeadWritesRecordTheirAlgorithmAndSurviveConfigurationChanges(string $operation, string $algorithm)","+    {","+        $plaintext = 'a data key or payload of 32 bytes';","+        $requests = [];","+        $client = new MockHttpClient(static function (string $method, string $url, array $options) use (&$requests, &$plaintext): MockResponse {","+            $requests[] = [$url, json_decode($options['body'], true)];","+","+            return new MockResponse(json_encode(1 === \\count($requests)","+                ? ['kid' => self::VAULT.'keys/app/v1', 'value' => Base64UrlSafe::encode('opaque ciphertext')]","+                : ['value' => Base64UrlSafe::encode($plaintext)]));","+        }, self::VAULT);","+","+        $wrapping = 'encrypt' !== $operation;","+        $writer = new AzureKeyVault($client, $this->tokens(), $wrapping ? 'RSA-OAEP-256' : $algorithm, $wrapping ? $algorithm : 'RSA-OAEP-256');","+        $ciphertext = match ($operation) {","+            'encrypt' => $writer->encrypt('app', $plaintext),","+            'wrapDataKey' => $writer->wrapDataKey('app', $plaintext),","+            'generateDataKey' => $writer->generateDataKey('app'),","+        };","+        if ('generateDataKey' === $operation) {","+            $plaintext = $ciphertext->use(static fn (string $key): string => $key);","+            $ciphertext = $ciphertext->wrapped;","+        }","+","+        $this->assertSame($algorithm.'.'.Base64UrlSafe::encode('opaque ciphertext'), $ciphertext->blob);","+        $reader = new AzureKeyVault($client, $this->tokens(), 'A256GCM', 'A256GCM');","+        $decrypted = $wrapping","+            ? $reader->unwrapDataKey($ciphertext)->use(static fn (string $key): string => $key)","+            : $reader->decrypt($ciphertext);","+","+        $this->assertSame($plaintext, $decrypted);","+        $this->assertSame(self::VAULT.'keys/app/'.($wrapping ? 'wrapkey' : 'encrypt').'?api-version=7.4', $requests[0][0]);","+        $this->assertSame(['alg' => $algorithm, 'value' => Base64UrlSafe::encode($plaintext)], $requests[0][1]);","+        $this->assertSame(self::VAULT.'keys/app/v1/'.($wrapping ? 'unwrapkey' : 'decrypt').'?api-version=7.4', $requests[1][0]);","+        $this->assertSame(['alg' => $algorithm, 'value' => Base64UrlSafe::encode('opaque ciphertext')], $requests[1][1]);","+    }","+","+    public static function provideNonAeadWrites(): iterable","+    {","+        yield ['encrypt', 'RSA-OAEP-256'];","+","+        foreach (['wrapDataKey', 'generateDataKey'] as $operation) {","+            foreach (['RSA-OAEP-256', 'A128KW', 'A192KW', 'A256KW'] as $algorithm) {","+                yield [$operation, $algorithm];","+            }","+        }","+    }","+","+    #[DataProvider('provideAeadWrites')]","+    public function testAeadRoundTripsKeepTheirParametersAfterAConfigurationChange(string $operation, string $algorithm, string $plaintext)","+    {","+        $iv = Base64UrlSafe::encode(str_repeat('I', 12));","+        $tag = Base64UrlSafe::encode(str_repeat('T', 16));","+        $requests = [];","+        $client = new MockHttpClient(static function (string $method, string $url, array $options) use (&$requests, $iv, $tag): MockResponse {","+            $body = json_decode($options['body'], true);","+            $requests[] = $body;","+","+            return new MockResponse(json_encode(1 === \\count($requests)","+                ? ['kid' => self::VAULT.'keys/app/v1', 'value' => $body['value'], 'iv' => $iv, 'tag' => $tag]","+                : ['value' => $body['value']]));","+        }, self::VAULT);","+        $writer = new AzureKeyVault($client, $this->tokens(), $algorithm, $algorithm);","+        $ciphertext = match ($operation) {","+            'encrypt' => $writer->encrypt('app', $plaintext, 'tenant=acme'),","+            'wrapDataKey' => $writer->wrapDataKey('app', $plaintext, 'tenant=acme'),","+            'generateDataKey' => $writer->generateDataKey('app', 32, 'tenant=acme'),","+        };","+        if ('generateDataKey' === $operation) {","+            $plaintext = $ciphertext->use(static fn (string $key): string => $key);","+            $ciphertext = $ciphertext->wrapped;","+        }","+","+        $this->assertSame($algorithm.'.'.$iv.'.'.$tag.'.'.Base64UrlSafe::encode($plaintext), $ciphertext->blob);","+        $reader = new AzureKeyVault($client, $this->tokens());","+        $decrypted = 'encrypt' === $operation","+            ? $reader->decrypt($ciphertext, 'tenant=acme')","+            : $reader->unwrapDataKey($ciphertext, 'tenant=acme')->use(static fn (string $key): string => $key);","+","+        $this->assertSame($plaintext, $decrypted);","+        $this->assertSame(['alg' => $algorithm, 'value' => Base64UrlSafe::encode($plaintext), 'aad' => Base64UrlSafe::encode('tenant=acme')], $requests[0]);","+        $this->assertSame(['alg' => $algorithm, 'iv' => $iv, 'tag' => $tag, 'value' => Base64UrlSafe::encode($plaintext), 'aad' => Base64UrlSafe::encode('tenant=acme')], $requests[1]);","+    }","+","+    public static function provideAeadWrites(): iterable","+    {","+        foreach (['A128GCM', 'A192GCM', 'A256GCM'] as $algorithm) {","+            foreach (['encrypt', 'wrapDataKey', 'generateDataKey'] as $operation) {","+                yield [$operation, $algorithm, str_repeat('K', 32)];","+            }","+","+            yield ['encrypt', $algorithm, ''];","+        }","+    }","+","+    #[Dat