h_args([\"store\", \"prune\"])","+        .output()","+        .unwrap();","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    eprintln!(\"STDERR:\\n{stderr}\");","+    assert!(!output.status.success());","+    assert!(stderr.contains(\"not a valid pylock.toml\"), \"{stderr}\");","+    assert!(!stderr.contains(\"secret-token\"), \"{stderr}\");","+    assert!(!stderr.contains(\"Removed\"), \"{stderr}\");","+}","+"," #[tokio::test]"," async fn sibling_projects_keep_their_generations_apart() {","     let root = tempfile::tempdir().unwrap();"],"additions":59,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/store.rs","lines":["@@ -559,6 +559,26 @@ fn store_add_fails_without_touching_a_frozen_store() {","     assert!(!npmrc_info.store_dir.exists(), \"a frozen store must stay untouched\");"," }"," ","+#[test]","+fn store_prune_fails_without_touching_a_frozen_store() {","+    let CommandTempCwd {","+        pacquet, root: _root, npmrc_info, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let unreferenced = npmrc_info.store_dir.join(STORE_VERSION).join(\"files/00/unreferenced\");","+    fs::create_dir_all(unreferenced.parent().unwrap()).unwrap();","+    fs::write(&unreferenced, \"\").unwrap();","+","+    let output = pacquet","+        .with_args([\"store\", \"prune\", \"--frozen-store\"])","+        .output()","+        .expect(\"run store prune\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    eprintln!(\"STDERR:\\n{stderr}\");","+    assert!(!output.status.success());","+    assert!(stderr.contains(\"ERR_PNPM_FROZEN_STORE_WRITE\"));","+    assert!(unreferenced.exists(), \"a frozen store must stay untouched\");","+}","+"," /// The hash a lockfile entry pins a registry package's tarball by."," #[derive(Clone, Copy, PartialEq)]"," enum PinnedHash {"],"additions":20,"deletions":0,"truncated":false},{"path":"pnpm/crates/python-installer/src/lib.rs","lines":["@@ -37,6 +37,7 @@ pub use pep508_rs::{","     PackageName,","     VersionOrUrl,"," };","+pub use store_keys::locked_archive_store_index_keys;"," pub use update::{","     UpdateOptions,","     plan_update,","@@ -61,6 +62,7 @@ mod resolutions;"," mod resolver;"," mod settings;"," mod sources;","+mod store_keys;"," mod targets;"," mod update;"," mod workspace;","@@ -242,7 +244,31 @@ async fn prepare<Reporter: self::Reporter + 'static>(","         .wrap_err(\"join Python artifact store index writer\")?","         .into_diagnostic()","         .wrap_err(\"flush Python artifact store index\")?;","-    result","+    let prepared = result?;","+    register_in_store(&context, &prepared);","+    Ok(prepared)","+}","+","+/// Register the root of every environment as a user of the store, so a","+/// store prune keeps the archives its `pylock.toml` pins.","+fn register_in_store(context: &InstallOptions, prepared: &[Prepared]) {","+    let config = context.config;","+    if config.frozen_store {","+        return;","+    }","+    for project in prepared.iter().filter(|project| project.environment.is_some()) {","+        // Unlike an npm project, one whose store is inside it is registered","+        // too: its `RECORD` files have no hard link to keep them.","+        if let Err(error) =","+            pnpm_store_dir::register_loaded_project(&config.store_dir, &project.root)","+        {","+            tracing::warn!(","+                target: \"pnpm::python\",","+                ?error,","+                \"Failed to register a Python project in the store project registry; install continues\",","+            );","+        }","+    }"," }"," "," impl PythonPrepare<'_> {"],"additions":27,"deletions":1,"truncated":false},{"path":"pnpm/crates/python-installer/src/registry.rs","lines":["@@ -329,7 +329,7 @@ impl<'a> Registry<'a> {","         buffer: Option<Vec<u8>>,","     ) -> Result<pnpm_fs::CasPaths> {","         let integrity = wheel.integrity()?;","-        let package_id = format!(\"python:{}\", wheel.name);","+        let package_id = crate::store_keys::archive_package_id(&wheel.name);","         let ingestion = IngestZipArchiveToStore {","             fetching: pnpm_tarball::ArchiveFetchOptions {","                 http_client: self.client,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/python-installer/src/sources/sdist.rs","lines":["@@ -148,7 +148,7 @@ impl Registry<'_> {","         sdist: &LockedSdist,","     ) -> Result<pnpm_fs::CasPaths> {","         let integrity = sdist.integrity()?;","-        let package_id = format!(\"python:{}\", sdist.name);","+        let package_id = crate::store_keys::archive_package_id(&sdist.name);","         let fetching = pnpm_tarball::ArchiveFetchOptions {","             http_client: self.client,","             auth_headers: &self.index.auth,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/python-installer/src/store_keys.rs","lines":["@@ -0,0 +1,80 @@","+//! The store index rows a `pylock.toml` keeps in use.","+","+use pnpm_python_resolver::LockedWheel;","+use pnpm_tarball::ArchiveStoreProjection;","+use serde::Deserialize;","+use std::{","+    collections::BTreeMap,","+    fs,","+    io,","+    path::Path,","+};","+","+/// The package id a Python archive is stored under, named by its file.","+pub(crate) fn archive_package_id(filename: &str) -> String {","+    format!(\"python:{filename}\")","+}","+","+/// The store index keys of the wheels and source distributions that the","+/// `pylock.toml` at `path` pins, or `None` when there is no such file.","+///","+/// Only the file names and digests are read, so a lockfile another tool","+/// wrote counts too. pnpm stores only archives that its lockfile names and","+/// pins by SHA-256, so an archive without a `name` or that digest adds no","+/// key.","+///","+/// # Errors","+///","+/// The file cannot be read, or does not parse as a `pylock.toml`.","+pub fn locked_archive_store_index_keys(path: &Path) -> io::Result<Option<Vec<String>>> {","+    let text = match fs::read_to_string(path) {","+        Ok(text) => text,","+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),","+        Err(error) => return Err(error),","+    };","+    let lock: PinnedArchives =","+        toml::from_str(&text).map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;","+    Ok(Some(","+        lock.packages","+            .into_iter()","+            .flat_map(|package| package.wheels.into_iter().chain(package.sdist))","+            .filter_map(PinnedArchive::store_index_key)","+            .collect(),","+    ))","+}","+","+#[derive(Deserialize)]","+struct PinnedArchives {","+    #[serde(default)]","+    packages: Vec<PinnedPackage>,","+}","+","+#[derive(Deserialize)]","+struct PinnedPackage {","+    #[serde(default)]","+    wheels: Vec<PinnedArchive>,","+    sdist: Option<PinnedArchive>,","+}","+","+#[derive(Deserialize)]","+struct PinnedArchive {","+    name: Option<String>,","+    #[serde(default)]","+    hashes: BTreeMap<String, String>,","+}","+","+impl PinnedArchive {","+    fn store_index_key(self) -> Option<String> {","+        let name = self.name?;","+        let package_id = archive_package_id(&name);","+        let integrity =","+            LockedWheel { name, url: String::new(), hashes: self.hashes }.integrity().ok()?;","+        Some(ArchiveStoreProjection::RawArchive.store_index_key(","+            &integrity.to_string(),","+            &package_id,","+        ))","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":80,"deletions":0,"truncated":false},{"path":"pnpm/crates/python-installer/src/store_keys/tests.rs","lines":["@@ -0,0 +1,59 @@","+use super::locked_archive_store_index_keys;","+use std::fs;","+","+const DIGEST: &str = \"0b0f6ab1a92e94d1d9ef17bd6fb9aab2e3e0d1d6e1a9b0c4d8a9c5f2e7b1a3c4\";","+","+#[test]","+fn keys_every_pinned_wheel_and_source_distribution() {","+    let dir = tempfile::tempdir().unwrap();","+    let path = dir.path().join(\"pylock.toml\");","+    fs::write(","+        &path,","+        format!(","+            r#\"lock-version = \"1.0\"","+created-by = \"another-tool\"","+","+[[packages]]","+name = \"demo\"","+version = \"1.0.0\"","+wheels = [{{ name = \"demo-1.0.0-py3-none-any.whl\", url = \"https://example.test/demo.whl\", size = 10, hashes = {{ sha256 = \"{DIGEST}\" }} }}]","+","+[[packages]]","+name = \"built\"","+version = \"2.0.0\"","+sdist = {{ name = \"built-2.0.0.tar.gz\", url = \"https://example.test/built.tar.gz\", hashes = {{ sha256 = \"{DIGEST}\" }} }}","+","+[[packages]]","+name = \"local\"","+version = \"0.1.0\"","+directory = {{ path = \"local\" }}","+","+[[packages]]","+name = \"unnamed\"","+version = \"4.0.0\"","+wheels = [{{ url = \"https://example.test/unnamed-4.0.0-py3-none-any.whl\", hashes = {{ sha256 = \"{DIGEST}\" }} }}]","+","+[[packages]]","+name = \"undigested\"","+version = \"3.0.0\"","+wheels = [{{ name = \"undigested-3.0.0-py3-none-any.whl\", url = \"https://example.test/u.whl\", hashes = {{ md5 = \"00\" }} }}]","+\"#,","+        ),","+    )","+    .unwrap();","+","+    let integrity = ssri::Integrity::from_hex(DIGEST, ssri::Algorithm::Sha256).unwrap();","+    assert_eq!(","+        locked_archive_store_index_keys(&path).unwrap(),","+        Some(vec![","+            format!(\"raw-archive\\t{integrity}\\tpython:demo-1.0.0-py3-none-any.whl\"),","+            format!(\"raw-archive\\t{integrity}\\tpython:built-2.0.0.tar.gz\"),","+        ]),","+    );","+}","+","+#[test]","+fn no_lockfile_has_no_keys() {","+    let dir = tempfile::tempdir().unwrap();","+    assert_eq!(locked_archive_store_index_keys(&dir.path().join(\"pylock.toml\")).unwrap(), None);","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"pnpm/crates/store-dir/src/project_registry.rs","lines":["@@ -106,9 +106,10 @@ pub fn register_project(","     register_loaded_project(store_dir, project_dir)"," }"," ","-/// Register a loader's ownership even when its store is inside the project.","-/// Pruning reads the store manifest in the registered directory without","-/// recursively walking the registry link.","+/// [`register_project`], even when the store is inside `project_dir`: a","+/// loader directory, or a project whose store files have no hard link to","+/// keep them. Pruning reads what the registered directory holds without","+/// recursively walking the registry link, and its walk skips the store."," pub fn register_loaded_project(","     store_dir: &StoreDir,","     project_dir: &Path,"],"additions":4,"deletions":3,"truncated":false},{"path":"pnpm/crates/store-dir/src/prune_cas.rs","lines":["@@ -1,4 +1,6 @@"," use crate::{","+    CafsFileInfo,","+    PackageFilesIndex,","     StoreDir,","     StoreIndex,","     StoreIndexError,","@@ -10,6 +12,10 @@ use derive_more::{","     Error,"," };"," use miette::Diagnostic;","+use pnpm_fs::{","+    FileMode,","+    file_mode::is_executable,","+};"," use std::{","     collections::HashSet,","     ffi::OsStr,","@@ -84,7 +90,7 @@ pub(crate) fn prune_cas_with_references(","     remove_tmp(store_dir)?;"," ","     let mut stats = PruneCasStats::default();","-    let mut removed_hashes = HashSet::new();","+    let mut removed_files = RemovedFiles::default();","     for shard in read_entries(store_dir.files_dir())? {","         if !shard","             .file_type()","@@ -93,31 +99,26 @@ pub(crate) fn prune_cas_with_references(","         {","             continue;","         }","-        prune_shard(","-            &shard.path(),","-            &shard.file_name(),","-            &mut removed_hashes,","-            &mut stats,","-            referenced,","-        )?;","+        prune_shard(&shard.path(), &shard.file_name(), &mut removed_files, &mut stats, referenced)?;","     }"," ","-    prune_index(store_dir, &removed_hashes, &mut stats)?;","+    prune_index(store_dir, &removed_files, &mut stats)?;","     Ok(stats)"," }"," "," fn prune_index(","     store_dir: &StoreDir,","-    removed_hashes: &HashSet<String>,","+    removed_files