{"id":"2a9aaaeee5c9c855184b8c7d98c1f2c3fafea776","axis":"silent","repo":"rancher/rancher","sha":"2a9aaaeee5c9c855184b8c7d98c1f2c3fafea776","parsed":{"files":[{"path":"pkg/auth/providers/scim/auth.go","lines":["@@ -22,7 +22,8 @@ import ("," \t\"k8s.io/apimachinery/pkg/runtime\""," )"," ","-var tokenSecretNamespace = namespace.GlobalNamespace","+// tokenSecretNamespace is the namespace for SCIM token secrets.","+var tokenSecretNamespace = namespace.System"," "," // tokenAuthenticator authenticates requests to SCIM endpoints using Bearer tokens"," // stored as secrets in [tokenSecretNamespace].","@@ -35,8 +36,8 @@ var tokenSecretNamespace = namespace.GlobalNamespace"," //"," // Here is an example of how to create a secret with a token for the \"okta\" provider:"," //","-// kubectl create secret generic scim-okta -n cattle-global-data --from-literal=\"token=$(sha256 -s $(uuidgen))\"","-// kubectl label secret -n cattle-global-data scim-okta 'cattle.io/kind=scim-auth-token' 'authn.management.cattle.io/provider=okta'","+// kubectl create secret generic scim-okta -n cattle-system --from-literal=\"token=$(sha256 -s $(uuidgen))\"","+// kubectl label secret -n cattle-system scim-okta 'cattle.io/kind=scim-auth-token' 'authn.management.cattle.io/provider=okta'"," type tokenAuthenticator struct {"," \tsecretCache        wcorev1.SecretCache"," \tsecrets            wcorev1.SecretClient"],"additions":4,"deletions":3,"truncated":false},{"path":"pkg/auth/providers/scim/legacy_tokens.go","lines":["@@ -0,0 +1,37 @@","+package scim","+","+import (","+\t\"github.com/rancher/rancher/pkg/namespace\"","+\twcorev1 \"github.com/rancher/wrangler/v3/pkg/generated/controllers/core/v1\"","+\t\"github.com/sirupsen/logrus\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/labels\"","+)","+","+// DeleteLegacyTokens deletes SCIM token secrets left in the namespace used before","+// [tokenSecretNamespace]. Those secrets are no longer used.","+func DeleteLegacyTokens(secrets wcorev1.SecretClient) {","+\tselector := labels.Set{secretKindLabel: scimAuthToken}.AsSelector().String()","+","+\tlist, err := secrets.List(namespace.GlobalNamespace, metav1.ListOptions{LabelSelector: selector})","+\tif err != nil {","+\t\tlogrus.Errorf(\"scim::DeleteLegacyTokens: failed to list token secrets in %s: %s\", namespace.GlobalNamespace, err)","+\t\treturn","+\t}","+","+\tfor _, secret := range list.Items {","+\t\terr := secrets.Delete(namespace.GlobalNamespace, secret.Name, &metav1.DeleteOptions{","+\t\t\tPreconditions: &metav1.Preconditions{UID: &secret.UID},","+\t\t})","+\t\tif apierrors.IsNotFound(err) {","+\t\t\tcontinue // Already deleted, e.g. by another replica.","+\t\t}","+\t\tif err != nil {","+\t\t\tlogrus.Errorf(\"scim::DeleteLegacyTokens: failed to delete token secret %s/%s: %s\", namespace.GlobalNamespace, secret.Name, err)","+\t\t\tcontinue","+\t\t}","+","+\t\tlogrus.Warnf(\"Deleted SCIM token secret %s/%s; SCIM tokens are now read from %s\", namespace.GlobalNamespace, secret.Name, tokenSecretNamespace)","+\t}","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"pkg/auth/providers/scim/legacy_tokens_test.go","lines":["@@ -0,0 +1,137 @@","+package scim","+","+import (","+\t\"bytes\"","+\t\"fmt\"","+\t\"testing\"","+","+\t\"github.com/rancher/rancher/pkg/namespace\"","+\t\"github.com/rancher/wrangler/v3/pkg/generic/fake\"","+\t\"github.com/sirupsen/logrus\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.uber.org/mock/gomock\"","+\tv1 \"k8s.io/api/core/v1\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/labels\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\t\"k8s.io/apimachinery/pkg/types\"","+)","+","+func TestTokenSecretNamespace(t *testing.T) {","+\tassert.Equal(t, namespace.System, tokenSecretNamespace)","+}","+","+func TestDeleteLegacyTokens(t *testing.T) {","+\tctrl := gomock.NewController(t)","+","+\twantSelector := labels.Set{secretKindLabel: scimAuthToken}.AsSelector().String()","+","+\tcaptureLog := func(t *testing.T) *bytes.Buffer {","+\t\tvar buf bytes.Buffer","+\t\tout, level := logrus.StandardLogger().Out, logrus.GetLevel()","+\t\tlogrus.SetOutput(&buf)","+\t\tlogrus.SetLevel(logrus.InfoLevel)","+\t\tt.Cleanup(func() {","+\t\t\tlogrus.SetOutput(out)","+\t\t\tlogrus.SetLevel(level)","+\t\t})","+\t\treturn &buf","+\t}","+","+\tlegacySecrets := func(names ...string) *v1.SecretList {","+\t\tlist := &v1.SecretList{}","+\t\tfor _, name := range names {","+\t\t\tlist.Items = append(list.Items, v1.Secret{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace.GlobalNamespace}})","+\t\t}","+\t\treturn list","+\t}","+","+\tt.Run(\"legacy tokens are deleted and logged\", func(t *testing.T) {","+\t\tbuf := captureLog(t)","+","+\t\tsecrets := fake.NewMockControllerInterface[*v1.Secret, *v1.SecretList](ctrl)","+\t\tsecrets.EXPECT().List(gomock.Any(), gomock.Any()).DoAndReturn(func(ns string, opts metav1.ListOptions) (*v1.SecretList, error) {","+\t\t\tassert.Equal(t, namespace.GlobalNamespace, ns)","+\t\t\tassert.Equal(t, wantSelector, opts.LabelSelector)","+\t\t\treturn legacySecrets(\"scim-okta\", \"scim-azuread\"), nil","+\t\t}).Times(1)","+\t\tsecrets.EXPECT().Delete(namespace.GlobalNamespace, \"scim-okta\", gomock.Any()).Return(nil).Times(1)","+\t\tsecrets.EXPECT().Delete(namespace.GlobalNamespace, \"scim-azuread\", gomock.Any()).Return(nil).Times(1)","+","+\t\tDeleteLegacyTokens(secrets)","+","+\t\tassert.Contains(t, buf.String(), \"scim-okta\")","+\t\tassert.Contains(t, buf.String(), \"scim-azuread\")","+\t\tassert.NotContains(t, buf.String(), \"level=error\")","+\t})","+","+\tt.Run(\"already deleted by another replica\", func(t *testing.T) {","+\t\tbuf := captureLog(t)","+","+\t\tsecrets := fake.NewMockControllerInterface[*v1.Secret, *v1.SecretList](ctrl)","+\t\tsecrets.EXPECT().List(gomock.Any(), gomock.Any()).Return(legacySecrets(\"scim-okta\"), nil).Times(1)","+\t\tsecrets.EXPECT().Delete(namespace.GlobalNamespace, \"scim-okta\", gomock.Any()).","+\t\t\tReturn(apierrors.NewNotFound(schema.GroupResource{Resource: \"secrets\"}, \"scim-okta\")).Times(1)","+","+\t\tDeleteLegacyTokens(secrets)","+","+\t\tassert.Empty(t, buf.String())","+\t})","+","+\tt.Run(\"delete is conditional on the listed secret's UID\", func(t *testing.T) {","+\t\tcaptureLog(t)","+","+\t\tlist := legacySecrets(\"scim-okta\")","+\t\tlist.Items[0].UID = \"uid-1\"","+","+\t\tsecrets := fake.NewMockControllerInterface[*v1.Secret, *v1.SecretList](ctrl)","+\t\tsecrets.EXPECT().List(gomock.Any(), gomock.Any()).Return(list, nil).Times(1)","+\t\tsecrets.EXPECT().Delete(namespace.GlobalNamespace, \"scim-okta\", gomock.Any()).","+\t\t\tDoAndReturn(func(_, _ string, opts *metav1.DeleteOptions) error {","+\t\t\t\trequire.NotNil(t, opts.Preconditions)","+\t\t\t\trequire.NotNil(t, opts.Preconditions.UID)","+\t\t\t\tassert.Equal(t, types.UID(\"uid-1\"), *opts.Preconditions.UID)","+\t\t\t\treturn nil","+\t\t\t}).Times(1)","+","+\t\tDeleteLegacyTokens(secrets)","+\t})","+","+\tt.Run(\"a failed delete doesn't stop the others\", func(t *testing.T) {","+\t\tbuf := captureLog(t)","+","+\t\tsecrets := fake.NewMockControllerInterface[*v1.Secret, *v1.SecretList](ctrl)","+\t\tsecrets.EXPECT().List(gomock.Any(), gomock.Any()).Return(legacySecrets(\"scim-okta\", \"scim-azuread\"), nil).Times(1)","+\t\tsecrets.EXPECT().Delete(namespace.GlobalNamespace, \"scim-okta\", gomock.Any()).Return(fmt.Errorf(\"some error\")).Times(1)","+\t\tsecrets.EXPECT().Delete(namespace.GlobalNamespace, \"scim-azuread\", gomock.Any()).Return(nil).Times(1)","+","+\t\tDeleteLegacyTokens(secrets)","+","+\t\tassert.Contains(t, buf.String(), \"level=error\")","+\t\tassert.Contains(t, buf.String(), \"scim-azuread\")","+\t})","+","+\tt.Run(\"no legacy tokens\", func(t *testing.T) {","+\t\tbuf := captureLog(t)","+","+\t\tsecrets := fake.NewMockControllerInterface[*v1.Secret, *v1.SecretList](ctrl)","+\t\tsecrets.EXPECT().List(gomock.Any(), gomock.Any()).Return(&v1.SecretList{}, nil).Times(1)","+","+\t\tDeleteLegacyTokens(secrets)","+","+\t\tassert.Empty(t, buf.String())","+\t})","+","+\tt.Run(\"list fails\", func(t *testing.T) {","+\t\tbuf := captureLog(t)","+","+\t\tsecrets := fake.NewMockControllerInterface[*v1.Secret, *v1.SecretList](ctrl)","+\t\tsecrets.EXPECT().List(gomock.Any(), gomock.Any()).Return(nil, fmt.Errorf(\"some error\")).Times(1)","+","+\t\tDeleteLegacyTokens(secrets)","+","+\t\tassert.Contains(t, buf.String(), \"level=error\")","+\t})","+}"],"additions":137,"deletions":0,"truncated":false},{"path":"pkg/auth/scimconfig/config_test.go","lines":["@@ -4,6 +4,7 @@ import ("," \t\"testing\""," "," \t\"github.com/rancher/rancher/pkg/features\"","+\t\"github.com/rancher/rancher/pkg/namespace\""," \t\"github.com/rancher/wrangler/v3/pkg/generic/fake\""," \t\"github.com/stretchr/testify/assert\""," \t\"go.uber.org/mock/gomock\"","@@ -116,6 +117,10 @@ func TestDefault(t *testing.T) {"," \tassert.Equal(t, defaultRateLimitBurst, cfg.RateLimitBurst)"," }"," ","+func TestNamespace(t *testing.T) {","+\tassert.Equal(t, namespace.GlobalNamespace, Namespace)","+}","+"," func TestGet(t *testing.T) {"," \tt.Parallel()"," "],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/rancher/rancher.go","lines":["@@ -25,6 +25,7 @@ import ("," \t\"github.com/rancher/rancher/pkg/auth/cleanup\""," \t\"github.com/rancher/rancher/pkg/auth/providers/common\""," \t\"github.com/rancher/rancher/pkg/auth/providers/local/pbkdf2\"","+\t\"github.com/rancher/rancher/pkg/auth/providers/scim\""," \t\"github.com/rancher/rancher/pkg/auth/requests\""," \t\"github.com/rancher/rancher/pkg/clusterrouter\""," \tauditlogcontroller \"github.com/rancher/rancher/pkg/controllers/auditlog/auditpolicy\"","@@ -455,6 +456,9 @@ func (r *Rancher) Start(ctx context.Context) error {"," \t\t\treturn err"," \t\t}"," \t}","+