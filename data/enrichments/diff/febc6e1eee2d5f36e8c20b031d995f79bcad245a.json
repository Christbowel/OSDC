ction,","   type MiddlewareBuilder as TRPCMiddlewareBuilder,"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/server/src/unstable-core-do-not-import.ts","lines":["@@ -21,6 +21,7 @@ export * from './unstable-core-do-not-import/http/formDataToObject';"," export * from './unstable-core-do-not-import/http/getHTTPStatusCode';"," export * from './unstable-core-do-not-import/http/abortError';"," export * from './unstable-core-do-not-import/http/parseConnectionParams';","+export * from './unstable-core-do-not-import/http/pathSeparator';"," export * from './unstable-core-do-not-import/http/resolveResponse';"," export * from './unstable-core-do-not-import/http/types';"," export * from './unstable-core-do-not-import/initTRPC';"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/server/src/unstable-core-do-not-import/http/pathSeparator.ts","lines":["@@ -0,0 +1,51 @@","+/**","+ * The character between a procedure path's segments in HTTP URLs, such as","+ * the `~` in `/trpc/post~byId`. Procedure paths stay dotted everywhere else:","+ * in middlewares, errors, `onError` and query keys.","+ *","+ * These are the URL \"unreserved\" punctuation characters (RFC 3986), which","+ * are never percent-encoded or normalised and mean nothing to routers. `/`","+ * would need catch-all routes in every adapter, and `,` separates batched","+ * calls.","+ */","+export type PathSeparator = '.' | '_' | '~' | '-';","+","+/**","+ * Applies the `'.'` default to a user-given `pathSeparator` option. Call it","+ * once, where the option is read.","+ * @internal","+ */","+export function resolvePathSeparator(","+  value: PathSeparator | undefined,","+): PathSeparator {","+  return value ?? '.';","+}","+","+/**","+ * `post.byId` → `post~byId`, for building URLs.","+ * @internal","+ */","+export function procedurePathToURLPath(","+  path: string,","+  separator: PathSeparator,","+): string {","+  if (separator === '.') {","+    return path;","+  }","+  return path.split('.').join(separator);","+}","+","+/**","+ * `post~byId` → `post.byId`, for reading URLs. Dotted paths still resolve,","+ * so clients can move to the separator after the server does.","+ * @internal","+ */","+export function urlPathToProcedurePath(","+  path: string,","+  separator: PathSeparator,","+): string {","+  if (separator === '.') {","+    return path;","+  }","+  return path.split(separator).join('.');","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"packages/server/src/unstable-core-do-not-import/http/resolveResponse.ts","lines":["@@ -23,6 +23,7 @@ import {"," } from '../utils';"," import { getAcceptHeader, getLastEventId, getRequestInfo } from './contentType';"," import { getHTTPStatusCode } from './getHTTPStatusCode';","+import { urlPathToProcedurePath } from './pathSeparator';"," import type {","   HTTPBaseHandlerOptions,","   ResolveHTTPRequestOptionsContextFn,","@@ -290,7 +291,10 @@ export async function resolveResponse<TRouter extends AnyRouter>(","         undefined,","         await getRequestInfo({","           req,","-          path: decodePath(opts.path),","+          path: urlPathToProcedurePath(","+            decodePath(opts.path),","+            config.pathSeparator,","+          ),","           router,","           searchParams: url.searchParams,","           headers: opts.req.headers,"],"additions":5,"deletions":1,"truncated":false},{"path":"packages/server/src/unstable-core-do-not-import/initTRPC.ts","lines":["@@ -3,6 +3,7 @@ import {","   type DefaultErrorShape,","   type ErrorFormatter,"," } from './error/formatter';","+import { resolvePathSeparator } from './http/pathSeparator';"," import type { MiddlewareBuilder, MiddlewareFunction } from './middleware';"," import { createMiddlewareFactory } from './middleware';"," import type { ProcedureBuilder } from './procedureBuilder';","@@ -176,6 +177,7 @@ class TRPCBuilder<TContext extends object, TMeta extends object> {","       allowOutsideOfServer: opts?.allowOutsideOfServer ??