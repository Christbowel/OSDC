Separator';"," import type {","   AnyProcedure,","   ErrorHandlerOptions,","@@ -362,9 +363,17 @@ export function createRouterFactory<TRoot extends AnyRootTypes>(","       };","     }"," ","+    const separator = config.pathSeparator;","+","     function step(from: CreateRouterOptions, path: readonly string[] = []) {","       const aggregate: RouterRecord = emptyObject();","       for (const [key, item] of Object.entries(from ?? {})) {","+        if (separator !== '.' && key.includes(separator)) {","+          // The URL `a_b_c` couldn't say which `_` splits a segment","+          throw new Error(","+            `Key \"${[...path, key].join('.')}\" contains the pathSeparator ${JSON.stringify(separator)}, so its URL would be ambiguous. Rename it or pick another pathSeparator.`,","+          );","+        }","         if (isLazy(item)) {","           lazy[[...path, key].join('.')] = createLazyLoader({","             path,","@@ -620,9 +629,21 @@ export function mergeRouters<TRouters extends AnyRouter[]>(","     return prev;","   }, defaultTransformer);"," ","+  const pathSeparator = routerList.reduce<PathSeparator>((prev, current) => {","+    const next = current._def._config.pathSeparator;","+    if (next === '.') {","+      return prev;","+    }","+    if (prev !== '.' && prev !== next) {","+      throw new Error('You seem to have several pathSeparators');","+    }","+    return next;","+  }, '.');","+","   const router = createRouterFactory({","     errorFormatter,","     transformer,","+    pathSeparator,","     isDev: routerList.every((r) => r._def._config.isDev),","     allowOutsideOfServer: routerList.every(","       (r) => r._def._config.allowOutsideOfServer,"],"additions":21,"deletions":0,"truncated":false},{"path":"packages/tanstack-react-query/test/pathSeparator.test.ts","lines":["@@ -0,0 +1,61 @@","+import { testServerAndClientResource } from '@trpc/client/__tests__/testClientResource';","+import { QueryClient } from '@tanstack/react-query';","+import { httpLink } from '@trpc/client';","+import { initTRPC } from '@trpc/server';","+import { describe, expect, test } from 'vitest';","+import { z } from 'zod';","+import { createTRPCOptionsProxy } from '../src';","+","+describe('pathSeparator', () => {","+  test('query keys keep their shape and URLs use the separator', async () => {","+    const t = initTRPC.create({ pathSeparator: '~' });","+    const router = t.router({","+      post: {","+        byId: t.procedure","+          .input(z.object({ id: z.number() }))","+          .query((opts) => opts.input),","+        add: t.procedure.input(z.string()).mutation((opts) => opts.input),","+      },","+      'flat.key': t.procedure.query(() => 'flat'),","+    });","+","+    const urls: string[] = [];","+    await using ctx = testServerAndClientResource(router, {","+      client: ({ httpUrl }) => ({","+        links: [","+          httpLink({","+            url: httpUrl,","+            pathSeparator: '~',","+            fetch: (url, init) => {","+              urls.push(","+                new URL(url instanceof Request ? url.url : url).pathname,","+              );","+              return fetch(url, init);","+            },","+          }),","+        ],","+      }),","+    });","+    const queryClient = new QueryClient();","+    const trpc = createTRPCOptionsProxy({ client: ctx.client, queryClient });","+","+    expect(trpc.post.byId.queryKey({ id: 1 })).toEqual([","+      ['post', 'byId'],","+      { input: { id: 1 }, type: 'query' },","+    ]);","+    expect(trpc.post.add.mutationKey()).toEqual([['post', 'add']]);","+    // A key containing `.` keys and routes like a nested one, as it always has","+    expect(trpc['flat.key'].queryKey()).toEqual([","+      ['flat', 'key'],","+      { type: 'query' },","+    ]);","+","+    expect(","+      await queryClient.fetchQuery(trpc.post.byId.queryOptions({ id: 1 })),","+    ).toEqual({ id: 1 });","+    expect(await queryClient.fetchQuery(trpc['flat.key'].queryOptions())).toBe(","+      'flat',","+    );","+    expect(urls).toEqual(['/post~byId', '/flat~key']);","+  });","+});"],"additions":61,"deletions":0,"truncated":false},{"path":"packages/tests/server/pathSeparator.test.ts","lines":["@@ -0,0 +1,382 @@","+import { testServerAndClientResource } from '@trpc/client/__tests__/testClientResource';","+import { waitError } from '@trpc/server/__tests__/waitError';","+import {","+  createTRPCClient,","+  httpBatchLink,","+  httpBatchStreamLink,","+  httpLink,","+  httpSubscriptionLink,","+  splitLink,","+  TRPCClientError,","+} from '@trpc/client';","+import type { TRPCPathSeparator } from '@trpc/server';","+import { initTRPC, lazy, TRPCError } from '@trpc/server';","+import * as trpcExpress from '@trpc/server/adapters/express';","+import { fastifyTRPCPlugin } from '@trpc/server/adapters/fastify';","+import express from 'express';","+import fastify from 'fastify';","+import fetch from 'node-fetch';","+import { expectTypeOf } from 'vitest';","+import { z } from 'zod';","+","+function createRouter(pathSeparator?: TRPCPathSeparator) {","+  const t = initTRPC.create({ pathSeparator });","+  const middlewarePaths: string[] = [];","+  const proc = t.procedure.use((opts) => {","+    middlewarePaths.push(opts.path);","+    return opts.next();","+  });","+  const router = t.router({","+    post: {","+      byId: proc","+        .input(z.object({ id: z.number() }))","+        .query((opts) => ({ id: opts.input.id })),","+      list: proc.query(() => ['a', 'b']),","+      add: proc.input(z.string()).mutation((opts) => opts.input),","+      fail: proc.query(() => {","+        throw new TRPCError({ code: 'BAD_REQUEST', message: 'nope' });","+      }),","+      onAdd: proc.subscription(async function* () {","+        yield 1;","+        yield 2;","+      }),","+    },","+    'flat.key': proc.query(() => 'flat'),","+  });","+  return { router, middlewarePaths };","+}","+","+function recordingFetch() {","+  const urls: string[] = [];","+  const fn = ((url: string, init: any) => {","+    urls.push(new URL(url).pathname);","+    return fetch(url, init);","+  }) as any;","+  return { urls, fetch: fn };","+}","+","+describe('pathSeparator: \"~\"', () => {","+  async function setup() {","+    const { router, middlewarePaths } = createRouter('~');","+    const rec = recordingFetch();","+    const sseUrls: string[] = [];","+    class RecordingEventSource extends EventSource {","+      constructor(url: string | URL, init?: EventSourceInit) {","+        sseUrls.push(new URL(url).pathname);","+        super(url, init);","+      }","+    }","+    const ctx = testServerAndClientResource(router, {","+      client: ({ httpUrl }) => ({","+        links: [","+          splitLink({","+            condition: (op) => op.type === 'subscription',","+            true: httpSubscriptionLink({","+              url: httpUrl,","+              pathSeparator: '~',","+              EventSource: RecordingEventSource,","+            }),","+            false: splitLink({","+              condition: (op) => op.context['link'] === 'httpLink',","+              true: httpLink({","+                url: httpUrl,","+                fetch: rec.fetch,","+                pathSeparator: '~',","+              }),","+              false: splitLink({","+                condition: (op) => op.context['link'] === 'stream',","+                true: httpBatchStreamLink({","+                  url: httpUrl,","+                  fetch: rec.fetch,","+                  pathSeparator: '~',","+                }),","+                false: httpBatchLink({","+                  url: httpUrl,","+                  fetch: rec.fetch,","+                  pathSeparator: '~',","+                }),","+              }),","+            }),","+          }),","+        ],","+      }),","+    });","+    return { ...ctx, middlewarePaths, urls: rec.urls, sseUrls };","+  }","+","+  test('httpLink puts \"~\" in the URL', async () => {","+    await using t = await setup();","+    const context = { link: 'httpLink' };","+","+    expect(await t.client.post.byId.query({ id: 1 }, { context })).toEqual({","+      id: 1,","+    });","+    expect(await t.client.post.add.mutate('x', { context })).toBe('x');","+","+    expect(t.urls).toEqual(['/post~byId', '/post~add']);","+  });","+","+  test('httpBatchLink joins \"~\" paths with \",\"', async () => {","+    await using t = await setup();","+","+    expect(","+      await Promise.all([","+        t.client.post.byId.query({ id: 1 }),","+        t.client.post.list.query(),","+      ]),","+    ).toEqual([{ id: 1 }, ['a', 'b']]);","+","+    expect(t.urls).toEqual(['/post~byId,post~list']);","+  });","+","+  test('httpBatchStreamLink', async () => {","+    await using t = await setup();","+    const context = { link: 'stream' };","+","+    expect(","+      await Promise.all([","+        t.client.post.byId.query({ id: 2 }, { context }),","+        t.client.post.list.query(undefined, { context }),","+      ]),","+    ).toEqual([{ id: 2 }, ['a', 'b']]);","+","+    expect(t.urls).toEqual(['/post~byId,post~list']);","+  });","+","+  test('httpSubscriptionLink', async () => {","+    await using t = await setup();","+","+    const values: number[] = [];","+    await new Promise<void>((resolve, reject) => {","+      const sub = t.client.post.onAdd.subscribe(undefined, {","+        onData(value) {","+          values.push(value);","+          if (values.length === 2) {","+            sub.unsubscribe();","+            resolve();","+          }","+        },","+        onError: reject,","+      });","+    });","+    expect(values).toEqual([1, 2]);","+    expect(t.sseUrls).toEqual(['/post~onAdd']);","+  });","+","+  test('middlewares, onError and error shapes still see dotted paths', async () => {","+    await using t = await setup();","+","+    await t.client.post.list.query();","+    const err = await waitError(t.client.post.fail.query(), TRPCClientError);","+","+    expect(t.middlewarePaths).toEqual(['post.list', 'post.fail']);","+    expect(err.data?.path).toBe('post.fail');","+    expect(t.onErrorSpy).toHaveBeenCalledTimes(1);","+    expect(t.onErrorSpy.mock.calls[0]![0].path).toBe('post.fail');","+  });","+","+  test('a key containing \".\" is served at the same URL as nesting', async () => {","+    await using t = await setup();","+","+    expect(await t.client['flat.key'].query()).toBe('flat');","+    expect(t.urls).toEqual(['/flat~key']);","+  });","+","+  test('the server still accepts dotted URLs', async () => {","+    await using t = await setup();","+","+    const res = await fetch(","+      `${t.httpUrl}/post.byId?input=${encodeURIComponent(JSON.stringify({ id: 3 }))}`,","+    );","+    expect(res.status).toBe(200);","+    expect(await res.json()).toEqual({ result: { data: { id: 3 } } });","+  });","+","+  test('server-side callers still use dotted paths', async () => {","+    const { router, middlewarePaths } = createRouter('~');","+    const caller = router.createCaller({});","+","+    expect(await caller.post.byId({ id: 4 })).toEqual({ id: 4 });","+    expect(middlewarePaths).toEqual(['post.byId']);","+  });","+});","+","+test('pathSeparator: \"-\"', async () => {","+  const { router } = createRouter('-');","+  await using t = testServerAndClientResource(router);","+","+  const res = await fetch(","+    `${t.httpUrl}/post-byId,post-list?batch=1&input=${encodeURIComponent(JSON.stringify({ 0: { id: 5 } }))}`,","+  );","+  expect(await res.json()).toEqual([","+    { result: { data: { id: 5 } } },","+    { result: { data: ['a', 'b'] } },","+  ]);","+});","+","+test('default: \"~\" in the URL is not a separator', async () => {","+  const { router } = createRouter();","+  await using t = testServerAndClientResource(router);","+","+  const res = await fetch(`${t.httpUrl}/post~list`);","+  expect(res.status).toBe(404);","+","+  const dotted = await fetch(`${t.httpUrl}/post.list`);","+  expect(dotted.status).toBe(200);","+});","+","+test('client with \"~\" against a server without it gets NOT_FOUND', async () => {","+  const { router } = createRouter();","+  await using t = testServerAndClientResource(router, {","+    client: ({ httpUrl }) => ({","+      links: [","+        httpLink({ url: httpUrl, fetch: fetch as any, pathSeparator: '~' }),","+      ],","+    }),","+  });","+","+  const err = await waitError(t.client.post.list.query(), TRPCClientError);","+  expect(err.data?.code).toBe('NOT_FOUND');","+});","+","+describe('keys containing the separator', () => {","+  test('are rejected when the router is built', () => {","+    const t = initTRPC.create({ pathSeparator: '_' });","+","+    expect(() =>","+      t.router({ get_user: t.procedure.query(() => null) }),","+    ).toThrowErrorMatchingInlineSnapshot(","+      `[Error: Key \"get_user\" contains the pathSeparator \"_\", so its URL would be ambiguous. Rename it or pick another pathSeparator.]`,","+    );","+    expect(() =>","+      t.router({ user: { by_id: t.procedure.query(() => null) } }),","+    ).toThrow('Key \"user.by_id\" contains the pathSeparator \"_\"');","+    expect(() =>","+      t.router({ my_users: { list: t.procedure.query(() => null) } }),","+    ).toThrow('Key \"my_users\" contains the pathSeparator \"_\"');","+  });","+","+  test('are rejected in sub-routers built without a separator', () => {","+    const plain = initTRPC.create();","+    const sub = plain.router({ by_id: plain.procedure.query(() => null) });","+    const t = initTRPC.create({ pathSeparator: '_' });","+","+    expect(() => t.router({ user: sub })).toThrow(","+      'Key \"user.by_id\" contains the pathSeparator \"_\"',","+    );","+  });","+","+  test('are rejected in lazy routers when they load', async () => {","+    const plain = initTRPC.create();","+    const t = initTRPC.create({ pathSeparator: '_' });","+    const router = t.router({","+      user: lazy(async () =>","+        plain.router({ by_id: plain.procedure.query(() => null) }),","+      ),","+    });","+","+    await expect(router.createCaller({}).user.by_id()).rejects.toThrow(","+      'Key \"user.by_id\" contains the pathSeparator \"_\"',","+    );","+  });","+","+  test('are fine with the default separator', () => {","+    const t = initTRPC.create();","+    expect(() =>","+      t.router({ get_user: t.procedure.query(() => null) }),","+    ).not.toThrow();","+  });","+});","+","+describe('mergeRouters', () => {","+  test('keeps the separator', () => {","+    const a = initTRPC.create({ pathSeparator: '~' });","+    const b = initTRPC.create();","+    const merged = a.mergeRouters(","+      b.router({ x: b.procedure.query(() => null) }),","+      a.router({ y: a.procedure.query(() => null) }),","+    );","+    expect(merged._def._config.pathSeparator).toBe('~');","+  });","+","+  test('throws on different separators', () => {","+    const a = initTRPC.create({ pathSeparator: '~' });","+    const b = initTRPC.create({ pathSeparator: '_' });","+    expect(() =>","+      a.mergeRouters(","+        a.router({ x: a.procedure.query(() => null) }),","+        b.router({ y: b.procedure.query(() => null) }),","+      ),","+    ).toThrow('You seem to have several pathSeparators');","+  });","+});","+","+test('only URL-safe separators type-check', () => {","+  expectTypeOf<TRPCPathSeparator>().toEqualTypeOf<'.' | '_' | '~' | '-'>();","+","+  // @ts-expect-error - \"/\" would need catch-all routes in every adapter","+  initTRPC.create({ pathSeparator: '/' });","+  // @ts-expect-error - \",\" separates batched calls","+  httpLink({ url: 'http://localhost', pathSeparator: ',' });","+});","+","+describe('adapters need no changes', () => {","+  test('express', async () => {","+    const { router } = createRouter('~');","+    const app = express();","+    app.use('/trpc', trpcExpress.createExpressMiddleware({ router }));","+    const server = app.listen(0);","+    await new Promise((resolve) => server.once('listening', resolve));","+    const { port } = server.address() as { port: number };","+","+    const client = createTRPCClient<typeof router>({","+      links: [","+        httpBatchLink({","+          url: `http://localhost:${port}/trpc`,","+          fetch: fetch as any,","+          pathSeparator: '~',","+        }),","+      ],","+    });","+    try {","+      expect(","+        await Promise.all([","+          client.post.byId.query({ id: 6 }),","+          client.post.list.query(),","+        ]),","+      ).toEqual([{ id: 6 }, ['a', 'b']]);","+    } finally {","+      server.close();","+    }","+  });","+","+  test('fastify', async () => {","+    const { router } = createRouter('~');","+    const app = fastify();","+    await app.register(fastifyTRPCPlugin, {","+      prefix: '/trpc',","+      trpcOptions: { router },","+    });","+    const url = await app.listen({ port: 0 });","+","+    const client = createTRPCClient<typeof router>({","+      links: [","+        httpBatchLink({","+          url: `${url}/trpc`,","+          fetch: fetch as any,","+          pathSeparator: '~',","+        }),","+      ],","+    });","+    try {","+      expect(","+        await Promise.all([","+          client.post.byId.query({ id: 7 }),","+          client.post.add.mutate('y'),","+        ]),","+      ).toEqual([{ id: 7 }, 'y']);","+    } finally {","+      await app.close();","+    }","+  });","+});"],"additions":382,"deletions":0,"truncated":false},{"path":"www/v11/docs/client/links/httpBatchLink.md","lines":["@@ -113,6 +113,13 @@ export interface HTTPLinkOptions {","    * @see https://trpc.io/docs/rpc","    */","   methodOverride?: 'POST';","+  /**","+   * The character between a procedure path's segments in URLs. Must match","+   * the server's `pathSeparator`.","+   * @default '.'","+   * @see https://trpc.io/docs/rpc#path-separator","+   */","+  pathSeparator?: '.' | '_' | '~' | '-';"," }"," ```"," "],"additions":7,"deletions":0,"truncated":false},{"path":"www/v11/docs/client/links/httpLink.md","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":618,"deletions":