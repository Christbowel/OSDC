nfiguration', 'defaultConfiguration', 'installerDefaultConfigurationExecuteToken'],","+  ];","+","+  for (const [action, step, tokenName] of steps) {","+    it(`sends the form data together with action and token in ${action}`, async (): Promise<void> => {","+      const moduleContent = document.createElement('div');","+      moduleContent.className = 't3js-module-content';","+      moduleContent.dataset[tokenName] = 'the-token';","+      moduleContent.innerHTML = '<div class=\"t3js-installer-databaseConnect-output\"></div>'","+        + '<div class=\"t3js-installer-databaseSelect-output\"></div>'","+        + '<div class=\"t3js-installer-databaseData-output\"></div>';","+      container.className = 't3js-body';","+      container.innerHTML = '<form>'","+        + '<input type=\"hidden\" name=\"install[values][flag]\" value=\"0\">'","+        + '<input type=\"checkbox\" name=\"install[values][flag]\" value=\"1\" checked>'","+        + '<input type=\"file\" name=\"install[values][upload]\">'","+        + `<button class=\"t3js-installer-${step}-execute\">Continue</button>`","+        + '</form>';","+      container.append(moduleContent);","+","+      container.querySelector<HTMLButtonElement>(`.t3js-installer-${step}-execute`)!.click();","+      const postRequest = (): Request | undefined => fetchStub.getCalls()","+        .map((call): Request => call.args[0])","+        .find((request: Request): boolean => request.method === 'POST');","+      await waitUntil((): boolean => postRequest() !== undefined);","+","+      const body = await postRequest()!.formData();","+      expect(body.get('install[action]')).to.equal(action);","+      expect(body.get('install[token]')).to.equal('the-token');","+      expect(body.getAll('install[values][flag]')).to.deep.equal(['0', '1']);","+      expect(body.get('install[values][upload]')).to.be.instanceOf(File);","+    });","+  }","+","+  it('sends the form data together with action and token in checkDatabaseRequirements', async (): Prom