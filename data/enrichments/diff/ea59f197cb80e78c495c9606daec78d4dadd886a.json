 Some(TrustEvidence::TrustedPublisher),","+        ),","+        with_trust(","+            pkg(\"unsigned\", \"unsigned\", \"1.0.0\", \"1.1.0\", DependencyGroup::Prod),","+            None,","+            None,","+        ),","+    ];","+","+    let groups = update_choices(&packages.iter().collect::<Vec<_>>(), false);","+","+    let header = &groups[0].rows[0].label;","+    for (row, cell) in [(1, \"provenance\"), (2, \"trusted publisher\"), (3, \"none\")] {","+        let label = &groups[0].rows[row].label;","+        assert_eq!(column_of(header, \"Trust\"), column_of(label, cell), \"{header}\\n{label}\");","+        assert_eq!(column_of(header, \"URL\"), column_of(label, \"https://\"), \"{header}\\n{label}\");","+    }","+}","+","+#[test]","+fn a_trust_downgrade_names_the_evidence_it_loses() {","+    let packages = [with_trust(","+        pkg(\"foo\", \"foo\", \"1.0.0\", \"2.0.0\", DependencyGroup::Prod),","+        Some(TrustEvidence::TrustedPublisher),","+        Some(TrustEvidence::Provenance),","+    )];","+","+    let groups = update_choices(&packages.iter().collect::<Vec<_>>(), false);","+","+    let label = &groups[0].rows[1].label;","+    assert!(label.contains(\"provenance (was trusted publisher)\"), \"{label}\");","+}","+","+/// A GitHub Action has no registry trust evidence, so its cell is empty","+/// while the dependencies next to it still get the column.","+#[test]","+fn a_row_without_trust_evidence_leaves_its_cell_empty() {","+    let mut action =","+        pkg(\"actions/checkout\", \"actions/checkout\", \"4.0.0\", \"5.0.0\", DependencyGroup::Dev);","+    action.github_action = true;","+    let packages = [","+        with_trust(pkg(\"foo\", \"foo\", \"1.0.0\", \"2.0.0\", DependencyGroup::Prod), None, None),","+        action,","+    ];","+","+    let groups = update_choices(&packages.iter().collect::<Vec<_>>(), false);","+","+    assert!(groups[1].rows[0].label.contains(\"Trust\"), \"{}\", groups[1].rows[0].label);","+    assert!(!groups[1].rows[1].label.contains(\"none\"), \"{}\", groups[1].rows[1].label);","+}","+","+#[test]","+fn no_trust_column_without_trust_evidence() {","+    let packages = [pkg(\"foo\", \"foo\", \"1.0.0\", \"2.0.0\", DependencyGroup::Prod)];","+","+    let groups = update_choices(&packages.iter().collect::<Vec<_>>(), false);","+","+    assert!(!groups[0].rows[0].label.contains(\"Trust\"), \"{}\", groups[0].rows[0].label);","+}"],"additions":83,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/update_interactive/global.rs","lines":["@@ -20,14 +20,7 @@ pub(crate) async fn select_global_package_groups<Reporter: self::Reporter>(","         })?;","     let config = global_update_config(base_config);","     let ignored = ignored_dependencies_matcher(config);","-    let query = OutdatedQuery {","-        target_version,","-        include_direct: &[DependencyGroup::Prod],","-        match_names: None,","-        ignore_names: ignored.as_ref(),","-        include_deprecated: false,","-        full_metadata: false,","-    };","+    let query = global_outdated_query(target_version, ignored.as_ref());","     let Some(matched_packages) = matching_global_packages(&global_pkg_dir, packages)? else {","         return Ok(None);","     };","@@ -52,6 +45,21 @@ pub(crate) async fn select_global_package_groups<Reporter: self::Reporter>(","     Ok(Some(selected))"," }"," ","+fn global_outdated_query<'a>(","+    target_version: TargetVersion<'a>,","+    ignored: Option<&'a pnpm_matcher::Matcher>,","+) -> OutdatedQuery<'a> {","+    OutdatedQuery {","+        target_version,","+        include_direct: &[DependencyGroup::Prod],","+        match_names: None,","+        ignore_names: ignored,","+        include_deprecated: false,","+        full_metadata: false,","+        apply_trust_policy: false,","+    }","+}","+"," /// One prompt row per global group that has an update available, labelled"," /// with the packages the group would move."," async fn outdated_group_rows("],"additions":16,