h(t *testing.T) {"," \t\trequire.ErrorIs(t, context.Cause(ctx), context.Canceled)"," \t})"," }","+","+func TestStart(t *testing.T) {","+\tt.Run(\"startup failure is reported and stop still cleans up\", func(t *testing.T) {","+\t\tfailure := errors.New(\"subscriber failed\")","+\t\tsvc := services.NewBasicService(func(context.Context) error { return failure }, func(ctx context.Context) error {","+\t\t\t<-ctx.Done()","+\t\t\treturn nil","+\t\t}, nil)","+\t\tctx, stop, err := Start(t.Context(), svc)","+\t\trequire.ErrorIs(t, err, failure)","+\t\t<-ctx.Done()","+\t\trequire.ErrorIs(t, context.Cause(ctx), failure)","+\t\trequire.ErrorIs(t, stop(), failure)","+\t})","+","+\tt.Run(\"running service is stopped on stop\", func(t *testing.T) {","+\t\tsvc := services.NewIdleService(nil, nil)","+\t\tctx, stop, err := Start(t.Context(), svc)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, services.Running, svc.State())","+\t\trequire.NoError(t, ctx.Err())","+\t\trequire.NoError(t, stop())","+\t\trequire.Equal(t, services.Terminated, svc.State())","+\t})","+}","+","+func TestStart_MultipleServices(t *testing.T) {","+\tt.Run(\"a later startup failure still stops the services already started\", func(t *testing.T) {","+\t\tfailure := errors.New(\"manifest watcher failed\")","+\t\tfirst := services.NewIdleService(nil, nil)","+\t\tsecond := services.NewBasicService(func(context.Context) error { return failure }, func(ctx context.Context) error {","+\t\t\t<-ctx.Done()","+\t\t\treturn nil","+\t\t}, nil)","+","+\t\t_, stop, err := Start(t.Context(), first, second)","+\t\trequire.ErrorIs(t, err, failure)","+\t\trequire.ErrorIs(t, stop(), failure)","+\t\trequire.Equal(t, services.Terminated, first.State())","+\t})","+","+\tt.Run(\"a running failure cancels the operator and stop reports it\", func(t *testing.T) {","+\t\tfailure := errors.New(\"subscriber failed\")","+\t\tfail := make(chan struct{})","+\t\tfailing := services.NewBasicService(nil, func(ctx context.Context) error {","+\