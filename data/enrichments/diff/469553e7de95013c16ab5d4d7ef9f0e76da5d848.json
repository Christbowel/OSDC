ers before startup so even immediate service failures cancel the operator.","+// watch registers before startup so even immediate service failures cancel the operator."," // The caller must defer stop and include its error in the operator's return value.","-func Watch(ctx context.Context, svc services.Service) (context.Context, func() error) {","+func watch(ctx context.Context, svc services.Service) (context.Context, func() error) {"," \tctx, cancel := context.WithCancelCause(ctx)"," \tremove := svc.AddListener(services.NewListener(nil, nil, nil, nil, func(_ services.State, err error) {"," \t\tcancel(err)","@@ -23,3 +24,41 @@ func Watch(ctx context.Context, svc services.Service) (context.Context, func() e"," \t\treturn nil"," \t}"," }","+","+// Start watches svcs and starts them in order; the returned context is","+// cancelled when any of them fails. The caller must defer stop even when Start","+// returns an error, and include its error in the operator's return value. stop","+// stops the services in reverse order, and only stop stops them: cancelling ctx","+// cancels the returned context but leaves the services running. A start interrupted by a service","+// failing reports that failure, not the cancellation it caused.","+func Start(ctx context.Context, svcs ...services.Service) (_ context.Context, stop func() error, _ error) {","+\tstops := make([]func() error, 0, len(svcs))","+\tfor _, svc := range svcs {","+\t\tvar stopSvc func() error","+\t\tctx, stopSvc = watch(ctx, svc)","+\t\tstops = append(stops, stopSvc)","+\t}","+\tstop = func() error {","+\t\tvar errs []error","+\t\tfor i := len(stops) - 1; i >= 0; i-- {","+\t\t\terrs = append(errs, stops[i]())","+\t\t}","+\t\treturn errors.Join(errs...)","+\t}","+","+\tfor _, svc := range svcs {","+\t\t// A service's lifetime follows the context it is started with, so","+\t\t// starting it on a cancellable one would let cancellation stop every","+\t\t// service at once instead of in reverse order through stop.","+\t\