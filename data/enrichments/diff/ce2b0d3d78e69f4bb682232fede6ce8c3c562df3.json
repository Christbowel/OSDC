{"id":"ce2b0d3d78e69f4bb682232fede6ce8c3c562df3","axis":"silent","repo":"microsoft/onnxruntime","sha":"ce2b0d3d78e69f4bb682232fede6ce8c3c562df3","parsed":{"files":[{"path":"include/onnxruntime/core/framework/tensor.h","lines":["@@ -272,7 +272,16 @@ class Tensor final {","     ORT_ENFORCE(shape_.Size() == new_shape.Size(),","                 \"Tensor size (\" + std::to_string(shape_.Size()) +","                     \") != new size (\" + std::to_string(new_shape.Size()) + \")\");","+","+#ifdef ENABLE_STRIDED_TENSORS","+    ORT_ENFORCE(is_contiguous_,","+                \"Reshape is only supported for contiguous tensors.\");","     shape_ = new_shape;","+    strides_.clear();  // lazily recomputed by Strides() for the new shape","+    is_contiguous_ = true;","+#else","+    shape_ = new_shape;","+#endif","   }"," ","   /**"],"additions":9,"deletions":0,"truncated":false},{"path":"onnxruntime/core/framework/execution_frame.cc","lines":["@@ -98,6 +98,7 @@ void IExecutionFrame::UpdateFetches(gsl::span<const int> fetch_mlvalue_idxs,","           dest.Init(p_tensor.release(), ml_tensor, ml_tensor->GetDeleteFunc());","         }"," ","+        ORT_THROW_IF_ERROR(utils::NormalizePreallocatedOutputShape(src.Shape(), *dest.GetMutable<Tensor>()));","         ORT_THROW_IF_ERROR(CopyTensor(src, *dest.GetMutable<Tensor>()));","       }","     }","@@ -170,16 +171,36 @@ Status IExecutionFrame::GetOrCreateNodeOutputMLValue(const int output_index, int","       // shapes on a model with dynamic dimensions. The caller should either supply","       // unallocated output OrtValues or ensure the pre-allocated shape matches.","       //","+      // The only exception is the scalar / single-element case where a rank-0 tensor","+      // are treated as equivalent. All other mismatches still return","+      // INVALID_ARGUMENT","+      //","       // Pre-run validation (ValidateInputsOutputs in inference_session.cc) catches","       // structural mismatches (element type, rank, fixed dimensions) before execution","-      // begins. Only dynamic dimension differences reach this point, since the actual","-      // shape is only known once the kernel computes it.","+      // begins. Only dynamic dimension differences reach this point, except for the","+      // rank-0 single-element compatibility case, since the actual shape is only","+      // known once the kernel computes it.","+","       bool shape_matched = true;"," ","       if (p_ort_value->IsTensor()) {","         ORT_RETURN_IF_NOT(shape != nullptr, \"shape must not be null for tensor output that is already allocated\");","         const Tensor& tensor = p_ort_value->Get<Tensor>();","-        shape_matched = (tensor.Shape() == *shape);","+        const TensorShape& existing_shape = tensor.Shape();","+        // First require the logical shapes to match; the only allowed exception is the","+        // rank-0 single-element compatibility case. Equal element counts alone are","+        // not sufficient to reuse a buffer for arbitrary reshapes.","+        if (existing_shape == *shape) {","+          shape_matched = true;","+        } else if (existing_shape.Size() == 1 &&","+                   shape->Size() == 1 &&","+                   (existing_shape.NumDimensions() == 0 || shape->NumDimensions() == 0)) {","+          // Reuse buffer, update shape in-place","+          p_ort_value->GetMutable<Tensor>()->Reshape(*shape);","+          shape_matched = true;","+        } else {","+          shape_matched = false;","+        }","       } else if (p_ort_value->IsSparseTensor()) {"," #if !defined(DISABLE_SPARSE_TENSORS)","         ORT_RETURN_IF_NOT(shape != nullptr, \"shape must not be null for sparse tensor output that is already allocated\");","@@ -331,6 +352,7 @@ void IExecutionFrame::Init(gsl::span<const int> feed_mlvalue_idxs, gsl::span<con","           AllocatorPtr allocator = GetAllocator(src.Location().device);","           Tensor::InitOrtValue(src.DataType(), src.Shape(), std::move(allocator), dest);","         }","+        ORT_THROW_IF_ERROR(utils::NormalizePreallocatedOutputShape(src.Shape(), *dest.GetMutable<Tensor>()));","         ORT_THROW_IF_ERROR(CopyTensor(src, *dest.GetMutable<Tensor>()));"," #if !defined(DISABLE_SPARSE_TENSORS)","       }"],"additions":25,"deletions":3,"truncated":false},{"path":"onnxruntime/core/framework/utils.cc","lines":["@@ -630,6 +630,23 @@ common::Status CopyOneInputAcrossDevices(const SessionState& session_state, cons","   return BatchOrCopyMLValue(session_state, copy_info, orig_mlvalue, new_mlvalue, device_stream);"," }"," ","+common::Status NormalizePreallocatedOutputShape(const TensorShape& source_shape, Tensor& destination) {","+  const auto& destination_shape = destination.Shape();","+  if (destination_shape == source_shape) {","+    return Status::OK();","+  }","+","+  if (destination_shape.Size() == 1 && source_shape.Size() == 1 &&","+      (destination_shape.NumDimensions() == 0 || source_shape.NumDimensions() == 0)) {","+    destination.Reshape(source_shape);","+    return Status::OK();","+  }","+","+  return ORT_MAKE_STATUS(ONNXRUNTIME, INVALID_ARGUMENT,","+                         \"The pre-allocated output shape \", destination_shape,","+                         \" does not match the computed output shape \", source_shape);","+}","+"," static common::Status CopyOutputsAcrossDevices(const SessionState& session_state,","                                                gsl::span<const OrtValue> fetches,","                                                std::vector<OrtValue>& user_fetches,","@@ -644,6 +661,10 @@ static common::Status CopyOutputsAcrossDevices(const SessionState& session_state"," #endif"," ","   for (size_t idx = 0; idx < num_outputs; ++idx) {","+    if (fetches[idx].IsTensor() && user_fetches[idx].IsTensor()) {","+      ORT_RETURN_IF_ERROR(NormalizePreallocatedOutputShape(fetches[idx].Get<Tensor>().Shape(),","+                                                           *user_fetches[idx].GetMutable<Tensor>()));","+    }"," #if !defined(DISABLE_SPARSE_TENSORS)","     ORT_RETURN_IF_ERROR(BatchOrCopyMLValue(session_state, copy_info[idx], fetches[idx], user_fetches[idx], fetch_streams[idx],","                                            &batched_data_transfers, &batched_sparse_data_transfers));"],"additions":21,"deletions":0,"truncated":false},{"path":"onnxruntime/core/framework/utils.h","lines":["@@ -64,6 +64,8 @@ bool IsMemcpyNode(const Node& node);"," // DEFAULT -> HOST_ACCESSIBLE is NOT valid (CPU cannot read device-only memory)."," bool CanSourceSatisfyTarget(const OrtDevice& src, const OrtDevice& tgt);"," ","+common::Status NormalizePreallocatedOutputShape(const TensorShape& source_shape, Tensor& destination);","+"," common::Status CopyOneInputAcrossDevices(const SessionState& session_state, const std::string& input_name,","                                          const OrtValue& orig_mlvalue, OrtValue& new_mlvalue);"," "],"additions":2,"deletions":0,"truncated":false},{"path":"onnxruntime/core/session/inference_session.cc","lines":["@@ -4,6 +4,7 @@"," #include \"core/graph/onnx_protobuf.h\""," #include \"core/session/inference_session.h\""," ","+#include <algorithm>"," #include <charconv>"," #include <memory>"," #include <sstream>","@@ -3478,8 +3479,14 @@ common::Status InferenceSession::ValidateInputsOutputs(gsl::span<const std::stri","       // check for shape","       const auto& opt_shape = iter->second.tensor_shape;","       if (opt_shape.has_value() && !opt_shape->GetDims().empty()) {","-        ORT_RETURN_IF_ERROR_SESSIONID_(CheckShapes(name, input_output_tensor.Shape(),","-                                                   *opt_shape, input_output_moniker));","+        const auto& actual_shape = input_output_tensor.Shape();","+        const bool scalar_single_element_output_compatibility =","+            !is_inputs && actual_shape.NumDimensions() == 0 &&","+            std::all_of(opt_shape->GetDims().begin(), opt_shape->GetDims().end(),","+                        [](int64_t dimension) { return dimension < 0 || dimension == 1; });","+        if (!scalar_single_element_output_compatibility) {","+          ORT_RETURN_IF_ERROR_SESSIONID_(CheckShapes(name, actual_shape, *opt_shape, input_output_moniker));","+        }","       }","     } else if (input_output_ml_value.IsSparseTensor()) {"," #if !defined(DISABLE_SPARSE_TENSORS)"],"additions":9,"deletions":2,"truncated":false},{"path":"onnxruntime/test/framework/execution_frame_test.cc","lines":["@@ -9,6 +9,7 @@"," #include \"core/graph/model.h\""," #include \"core/providers/cpu/cpu_execution_provider.h\""," #include \"core/session/inference_session.h\"","+#include \"test/util/include/default_providers.h\""," #include \"test/unittest_util/framework_test_utils.h\""," #include \"test/test_environment.h\""," #include \"test/util/include/inference_session_wrapper.h\"","@@ -842,5 +843,339 @@ TEST(ExecutionFrameTestInit, SparseInitializerAsOutput) {"," }"," #endif  // !defined(DISABLE_SPARSE_TENSORS)"," ","+TEST(ExecutionFrameTestInit, FetchReusesPreallocatedScalarOutputForSingleElementVector) {","+  SessionOptions so;","+  so.enable_mem_pattern = true;","+","+  InferenceSession session(so, GetEnvironment());","+","+  onnxruntime::Model model(\"scalar_to_vector1_output_test\", false, ModelMetaData(), PathString(),","+                           IOnnxRuntimeOpSchemaRegistryList(),","+                           {{kOnnxDomain, 12}}, {}, DefaultLoggingManager().DefaultLogger());","+  auto& graph = model.MainGraph();","+","+  TypeProto float_tensor;","+  float_tensor.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+","+  TypeProto float_vector1_tensor;","+  float_vector1_tensor.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+  float_vector1_tensor.mutable_tensor_type()->mutable_shape()->add_dim()->set_dim_value(1);","+","+  auto& input_arg = graph.GetOrCreateNodeArg(\"X\", &float_tensor);","+  auto& output_arg = graph.GetOrCreateNodeArg(\"Y\", &float_vector1_tensor);","+  graph.AddNode(\"identity\", \"Identity\", \"identity\", {&input_arg}, {&output_arg});","+  graph.SetInputs({&input_arg});","+  graph.SetOutputs({&output_arg});","+  ASSERT_STATUS_OK(graph.Resolve());","+","+  std::string serialized;","+  ASSERT_TRUE(model.ToProto().SerializeToString(&serialized));","+  std::istringstream model_stream(serialized);","+  ASSERT_STATUS_OK(session.Load(model_stream));","+  ASSERT_STATUS_OK(session.Initialize());","+","+  auto allocator = test::AllocatorManager::Instance().GetAllocator(CPU);","+","+  std::array<float, 1> input_data = {5.0f};","+  OrtValue input;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({1}), input_data.data(), allocator->Info(), input);","+","+  // Pre-allocate scalar output ({}). Runtime output for this run is {1}.","+  OrtValue preallocated_output;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({}), allocator, preallocated_output);","+  const void* preallocated_buffer = preallocated_output.Get<Tensor>().DataRaw();","+  std::vector<OrtValue> results = {preallocated_output};","+","+  RunOptions ro;","+  ASSERT_STATUS_OK(session.Run(ro,","+                               AsSpan({std::string(\"X\")}), AsSpan({input}),","+                               AsSpan({std::string(\"Y\")}), &results, nullptr));","+","+  ASSERT_EQ(results.size(), 1u);","+  ASSERT_TRUE(results[0].IsTensor());","+  EXPECT_EQ(results[0].Get<Tensor>().Shape(), TensorShape({1}));","+  EXPECT_EQ(results[0].Get<Tensor>().DataRaw(), preallocated_buffer);","+  EXPECT_EQ(results[0].Get<Tensor>().DataAsSpan<float>()[0], 5.0f);","+}","+","+TEST(ExecutionFrameTestInit, SymbolicOutputValidatesScalarCompatibilityAtRuntime) {","+  onnxruntime::Model model(\"symbolic_scalar_output_test\", false, ModelMetaData(), PathString(),","+                           IOnnxRuntimeOpSchemaRegistryList(), {{kOnnxDomain, 12}}, {},","+                           DefaultLoggingManager().DefaultLogger());","+  auto& graph = model.MainGraph();","+  TypeProto tensor_type;","+  tensor_type.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+  tensor_type.mutable_tensor_type()->mutable_shape()->add_dim()->set_dim_param(\"N\");","+  auto& input_arg = graph.GetOrCreateNodeArg(\"X\", &tensor_type);","+  auto& output_arg = graph.GetOrCreateNodeArg(\"Y\", &tensor_type);","+  graph.AddNode(\"relu\", \"Relu\", \"\", {&input_arg}, {&output_arg});","+  graph.SetInputs({&input_arg});","+  graph.SetOutputs({&output_arg});","+  ASSERT_STATUS_OK(graph.Resolve());","+","+  std::string serialized;","+  ASSERT_TRUE(model.ToProto().SerializeToString(&serialized));","+  std::istringstream model_stream(serialized);","+  SessionOptions options;","+  InferenceSession session(options, GetEnvironment());","+  ASSERT_STATUS_OK(session.Load(model_stream));","+  ASSERT_STATUS_OK(session.Initialize());","+  auto allocator = test::AllocatorManager::Instance().GetAllocator(CPU);","+","+  for (int64_t element_count : {1, 2}) {","+    SCOPED_TRACE(element_count);","+    std::vector<float> input_data(static_cast<size_t>(element_count), 5.0f);","+    OrtValue input;","+    Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({element_count}), input_data.data(),","+                         allocator->Info(), input);","+    OrtValue output;","+    Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({}), allocator, output);","+    output.GetMutable<Tensor>()->MutableData<float>()[0] = -1.0f;","+    const void* supplied_buffer = output.Get<Tensor>().DataRaw();","+    std::vector<OrtValue> results{output};","+    auto status = session.Run(RunOptions(), AsSpan({std::string(\"X\")}), AsSpan({input}),","+                              AsSpan({std::string(\"Y\")}), &results, nullptr);","+    if (element_count == 1) {","+      ASSERT_STATUS_OK(status);","+      const auto& result = results[0].Get<Tensor>();","+      EXPECT_EQ(result.Shape(), TensorShape({1}));","+      EXPECT_EQ(result.DataRaw(), supplied_buffer);","+      EXPECT_EQ(result.Data<float>()[0], 5.0f);","+    } else {","+      ASSERT_FALSE(status.IsOK());","+      EXPECT_EQ(status.Code(), common::StatusCode::INVALID_ARGUMENT);","+      EXPECT_THAT(status.ErrorMessage(), ::testing::HasSubstr(\"computed output shape\"));","+      EXPECT_EQ(output.Get<Tensor>().Shape(), TensorShape({}));","+      EXPECT_EQ(output.Get<Tensor>().Data<float>()[0], -1.0f);","+    }","+  }","+","+  OrtValue scalar_input;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({}), allocator, scalar_input);","+  scalar_input.GetMutable<Tensor>()->MutableData<float>()[0] = 5.0f;","+  std::vector<OrtValue> results;","+  auto status = session.Run(RunOptions(), AsSpan({std::string(\"X\")}), AsSpan({scalar_input}),","+                            AsSpan({std::string(\"Y\")}), &results, nullptr);","+  ASSERT_FALSE(status.IsOK());","+  EXPECT_EQ(status.Code(), common::StatusCode::INVALID_ARGUMENT);","+  EXPECT_THAT(status.ErrorMessage(), ::testing::HasSubstr(\"Invalid rank for input\"));","+}","+","+TEST(ExecutionFrameTestInit, InitializerAndConstantReusePreallocatedScalarOutput) {","+  for (bool use_constant : {false, true}) {","+    SCOPED_TRACE(use_constant);","+    onnxruntime::Model model(\"scalar_initializer_output_test\", false, ModelMetaData(), PathString(),","+                             IOnnxRuntimeOpSchemaRegistryList(), {{kOnnxDomain, 12}}, {},","+                             DefaultLoggingManager().DefaultLogger());","+    auto& graph = model.MainGraph();","+    TypeProto output_type;","+    output_type.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+    output_type.mutable_tensor_type()->mutable_shape()->add_dim()->set_dim_value(1);","+    auto& output_arg = graph.GetOrCreateNodeArg(\"Y\", &output_type);","+    TensorProto value;","+    value.set_name(\"Y\");","+    value.set_data_type(TensorProto_DataType_FLOAT);","+    value.add_dims(1);","+    value.add_float_data(5.0f);","+    if (use_constant) {","+      graph.AddNode(\"constant\", \"Constant\", \"\", {}, {&output_arg}).AddAttribute(\"value\", value);","+    } else {","+      graph.AddInitializedTensor(value);","+    }","+    graph.SetOutputs({&output_arg});","+    ASSERT_STATUS_OK(graph.Resolve());","+","+    std::string serialized;","+    ASSERT_TRUE(model.ToProto().SerializeToString(&serialized));","+    std::istringstream model_stream(serialized);","+    SessionOptions options;","+    InferenceSession session(options, GetEnvironment());","+    ASSERT_STATUS_OK(session.Load(model_stream));","+    ASSERT_STATUS_OK(session.Initialize());","+    EXPECT_EQ(session.GetSessionState().GetGraphViewer().NumberOfNodes(), 0);","+","+    auto allocator = test::AllocatorManager::Instance().GetAllocator(CPU);","+    OrtValue output;","+    Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({}), allocator, output);","+    const void* supplied_buffer = output.Get<Tensor>().DataRaw();","+    std::vector<OrtValue> results{output};","+    ASSERT_STATUS_OK(session.Run(RunOptions(), EmptySpan<std::string>(), EmptySpan<OrtValue>(),","+                                 AsSpan({std::string(\"Y\")}), &results, nullptr));","+    ASSERT_EQ(results.size(), 1u);","+    const auto& result = results[0].Get<Tensor>();","+    EXPECT_EQ(result.Shape(), TensorShape({1}));","+    EXPECT_EQ(result.DataRaw(), supplied_buffer);","+    EXPECT_EQ(result.Data<float>()[0], 5.0f);","+  }","+}","+","+#ifdef USE_CUDA","+TEST(ExecutionFrameTestInit, CrossDeviceCopyReusesPreallocatedScalarOutput) {","+  auto cuda_provider = DefaultCudaExecutionProvider();","+  if (!cuda_provider) {","+    GTEST_SKIP() << \"CUDA execution provider is unavailable\";","+  }","+","+  onnxruntime::Model model(\"scalar_cross_device_output_test\", false, ModelMetaData(), PathString(),","+                           IOnnxRuntimeOpSchemaRegistryList(), {{kOnnxDomain, 12}}, {},","+                           DefaultLoggingManager().DefaultLogger());","+  auto& graph = model.MainGraph();","+  TypeProto tensor_type;","+  tensor_type.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+  tensor_type.mutable_tensor_type()->mutable_shape()->add_dim()->set_dim_value(1);","+  auto& input_arg = graph.GetOrCreateNodeArg(\"X\", &tensor_type);","+  auto& output_arg = graph.GetOrCreateNodeArg(\"Y\", &tensor_type);","+  graph.AddNode(\"relu\", \"Relu\", \"\", {&input_arg}, {&output_arg});","+  graph.SetInputs({&input_arg});","+  graph.SetOutputs({&output_arg});","+  ASSERT_STATUS_OK(graph.Resolve());","+  std::string serialized;","+  ASSERT_TRUE(model.ToProto().SerializeToString(&serialized));","+  std::istringstream model_stream(serialized);","+  SessionOptions options;","+  InferenceSession session(options, GetEnvironment());","+  ASSERT_STATUS_OK(session.RegisterExecutionProvider(std::move(cuda_provider)));","+  ASSERT_STATUS_OK(session.Load(model_stream));","+  ASSERT_STATUS_OK(session.Initialize());","+  for (const auto& node : session.GetSessionState().GetGraphViewer().Nodes()) {","+    if (node.OpType() == \"Relu\") {","+      ASSERT_EQ(node.GetExecutionProviderType(), kCudaExecutionProvider);","+    }","+  }","+","+  auto allocator = test::AllocatorManager::Instance().GetAllocator(CPU);","+  std::array<float, 1> input_data{5.0f};","+  OrtValue input;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({1}), input_data.data(), allocator->Info(), input);","+  OrtValue output;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({}), allocator, output);","+  const void* supplied_buffer = output.Get<Tensor>().DataRaw();","+  std::vector<OrtValue> results{output};","+  ASSERT_STATUS_OK(session.Run(RunOptions(), AsSpan({std::string(\"X\")}), AsSpan({input}),","+                               AsSpan({std::string(\"Y\")}), &results, nullptr));","+  ASSERT_EQ(results.size(), 1u);","+  const auto& result = results[0].Get<Tensor>();","+  EXPECT_EQ(result.Shape(), TensorShape({1}));","+  EXPECT_EQ(result.DataRaw(), supplied_buffer);","+  EXPECT_EQ(result.Data<float>()[0], 5.0f);","+}","+#endif","+","+TEST(ExecutionFrameTestInit, FetchFailsForEqualCountNonScalarShapeMismatch) {","+  // Regression test to ensure that equal element count but different shapes","+  // are NOT reused. For example, {2,3} vs {3,2} both have 6 elements but","+  // represent different tensor layouts and should not be reused.","+  SessionOptions so;","+  so.enable_mem_pattern = true;","+","+  InferenceSession session(so, GetEnvironment());","+","+  onnxruntime::Model model(\"equal_count_shape_mismatch_test\", false, ModelMetaData(), PathString(),","+                           IOnnxRuntimeOpSchemaRegistryList(),","+                           {{kOnnxDomain, 12}}, {}, DefaultLoggingManager().DefaultLogger());","+  auto& graph = model.MainGraph();","+","+  TypeProto float_tensor;","+  float_tensor.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+","+  auto& input_arg = graph.GetOrCreateNodeArg(\"X\", &float_tensor);","+  auto& output_arg = graph.GetOrCreateNodeArg(\"Y\", &float_tensor);","+  graph.AddNode(\"identity\", \"Identity\", \"identity\", {&input_arg}, {&output_arg});","+  graph.SetInputs({&input_arg});","+  graph.SetOutputs({&output_arg});","+  ASSERT_STATUS_OK(graph.Resolve());","+","+  std::string serialized;","+  ASSERT_TRUE(model.ToProto().SerializeToString(&serialized));","+  std::istringstream model_stream(serialized);","+  ASSERT_STATUS_OK(session.Load(model_stream));","+  ASSERT_STATUS_OK(session.Initialize());","+","+  auto allocator = test::AllocatorManager::Instance().GetAllocator(CPU);","+","+  std::array<float, 6> input_data = {1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f};","+  OrtValue input;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({2, 3}), input_data.data(),","+                       allocator->Info(), input);","+","+  // Pre-allocate output with shape {3, 2} (same element count as {2,3}, but different shape)","+  OrtValue preallocated_output;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), TensorShape({3, 2}), allocator, preallocated_output);","+","+  std::vector<OrtValue> results = {preallocated_output};","+","+  RunOptions ro;","+  auto status = session.Run(ro,","+                            AsSpan({std::string(\"X\")}), AsSpan({input}),","+                            AsSpan({std::string(\"Y\")}), &results, nullptr);","+","+  // This should fail because shapes don't match, even though element counts are equal","+  ASSERT_FALSE(status.IsOK());","+  ASSERT_EQ(status.Code(), common::StatusCode::INVALID_ARGUMENT);","+  EXPECT_THAT(status.ErrorMessage(), ::testing::HasSubstr(\"pre-allocated\"));","+}","+","+#ifdef ENABLE_STRIDED_TENSORS","+TEST_F(ExecutionFrameTest, ExactShapeReusesNonContiguousPreallocatedOutput) {","+  Model model(\"strided_output_test\", false, ModelMetaData(), PathString(),","+              IOnnxRuntimeOpSchemaRegistryList(), {{kOnnxDomain, 12}}, {},","+              DefaultLoggingManager().DefaultLogger());","+  Graph& graph = model.MainGraph();","+  TypeProto tensor_float;","+  tensor_float.mutable_tensor_type()->set_elem_type(TensorProto_DataType_FLOAT);","+  NodeArg input_def(\"X\", &tensor_float), output_def(\"Y\", &tensor_float);","+  Node* node = &graph.AddNode(\"node1\", \"Relu\", \"Relu operator\",","+                              ArgMap{&input_def}, ArgMap{&output_def});","+  node->SetExecutionProviderType(kCpuExecutionProvider);","+  ASSERT_STATUS_OK(graph.Resolve());","+","+  auto cpu_xp = CreateCPUExecutionProvider();","+  auto xp_type = cpu_xp->Type();","+  ExecutionProviders execution_providers;","+  ASSERT_STATUS_OK(execution_providers.Add(xp_type, std::move(cpu_xp)));","+  KernelRegistryManager kernel_registry_manager;","+  ASSERT_STATUS_OK(kernel_registry_manager.RegisterKernels(execution_providers));","+","+  DataTransferManager dtm;","+  ExternalDataLoaderManager edlm;","+  profiling::Profiler profiler;","+  SessionOptions options;","+  SessionState state(graph, execution_providers, &tp_, nullptr, dtm, edlm,","+                     DefaultLoggingManager().DefaultLogger(), profiler, options);","+  ASSERT_STATUS_OK(state.FinalizeSessionState(ORT_TSTR(\"\"), kernel_registry_manager));","+","+  int y_idx = -1;","+  ASSERT_STATUS_OK(state.GetOrtValueNameIdxMap().GetIdx(\"Y\", y_idx));","+","+  const TensorShape shape({3, 2});","+  const TensorShapeVector strides{1, 3};","+  auto allocator = test::AllocatorManager::Instance().GetAllocator(CPU);","+  OrtValue preallocated_output;","+  Tensor::InitOrtValue(DataTypeImpl::GetType<float>(), shape, allocator,","+                       preallocated_output);","+  preallocated_output.GetMutable<Tensor>()->SetShapeAndStrides(shape, strides);","+  const void* buffer = preallocated_output.Get<Tensor>().DataRaw();","+  ASSERT_FALSE(preallocated_output.Get<Tensor>().IsContiguous());","+","+  std::vector<OrtValue> fetches{preallocated_output};","+  ExecutionFrame frame({}, {}, AsSpan({y_idx}), fetches, {},","+#ifdef ORT_ENABLE_STREAM","+                       {},","+#endif","+                       state);","+","+  const int output_arg_index = frame.GetNodeOffset(node->Index()) + 1;","+  OrtValue* output = nullptr;","+  ASSERT_STATUS_OK(frame.GetOrCreateNodeOutputMLValue(0, output_arg_index,","+                                                      &shape, output, *node));","+  ASSERT_NE(output, nullptr);","+  const Tensor& result = output->Get<Tensor>();","+  EXPECT_EQ(result.DataRaw(), buffer);","+  EXPECT_EQ(result.Shape(), shape);","+  EXPECT_THAT(result.Strides(), ::testing::ContainerEq(gsl::make_span(strides)));","+  EXPECT_FALSE(result.IsContiguous());","+}","+#endif  // ENABLE_STRIDED_TENSORS","+"," }  // namespace test"," }  // namespace onnxruntime"],"additions":335,"deletions":0,"truncated":false},{"path":"onnxruntime/test/framework/tensor_test.cc","lines":["@@ -258,6 +258,39 @@ TEST(TensorTest, Strided) {","   AS