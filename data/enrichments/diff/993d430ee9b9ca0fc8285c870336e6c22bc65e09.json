{"id":"993d430ee9b9ca0fc8285c870336e6c22bc65e09","axis":"silent","repo":"oven-sh/bun","sha":"993d430ee9b9ca0fc8285c870336e6c22bc65e09","parsed":{"files":[{"path":"CLAUDE.md","lines":["@@ -142,7 +142,7 @@ The Rust side is a Cargo workspace of ~200 crates rooted at `Cargo.toml`. The ke"," - `src/shell/` - Cross-platform shell implementation"," - `src/css/` - CSS parser and processor"," - `src/http/` - HTTP client + `websocket_client/` (WebSocket, deflate)","-- `src/icu/` - the part of ICU's C API that JavaScriptCore, WTF and Bun call (not on macOS); the headers and the data come with WebKit","+- `src/icu/` - the part of ICU's C API that JavaScriptCore, WTF and Bun call, and a part of `ubidi.h` (not on macOS); the headers and the data come with WebKit"," - `src/zstd/` - zstd (`decoder/` and `encoder/` are crates of their own)"," - `src/sql/` - SQL database integrations (Postgres, MySQL, SQLite)"," - `src/bake/` - Server-side rendering / dev server framework"],"additions":1,"deletions":1,"truncated":false},{"path":"src/icu/README.md","lines":["@@ -1,7 +1,7 @@"," # bun_icu"," ","-The functions of ICU's C API that JavaScriptCore, WTF and Bun's C++ call, for the arguments that they pass. The callers","-are compiled against ICU4C's headers, and the data package is ICU4C's. Both come with WebKit's build","+The functions of ICU's C API that JavaScriptCore, WTF and Bun's C++ call, for the arguments that they pass, and a part of","+`ubidi.h`. The callers are compiled against ICU4C's headers, and the data package is ICU4C's. Both come with WebKit's build"," (`scripts/build/deps/webkit.ts`). The crate is empty where the system's ICU is used: on macOS, and on Linux with a local"," WebKit without `BUN_ICU_ROOT`."," "],"additions":2,"deletions":2,"truncated":false},{"path":"src/icu/capi/ffi/raw/mod.rs","lines":["@@ -1,5 +1,6 @@"," //! Contracts of single headers, one file each. This file has the raw-pointer helpers that they share."," ","+pub(crate) mod ubidi;"," pub(crate) mod ubrk;"," pub(crate) mod ulistformatter;"," pub(crate) mod uloc;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/icu/capi/ffi/raw/ubidi.rs","lines":["@@ -0,0 +1,56 @@","+//! `unicode/ubidi.h`: the arrays whose length is not a parameter.","+","+use super::slice;","+use crate::capi::ffi::{Parameter, UChar};","+use crate::common::slice_ext::slices_equal;","+use crate::common::ubidi::{UBiDi, UBiDiLevel};","+use std::marker::PhantomData;","+use std::mem::MaybeUninit;","+","+/// `embeddingLevels`: null, or one level per code unit of the text.","+#[repr(transparent)]","+pub(crate) struct EmbeddingLevels<'c>(*mut UBiDiLevel, PhantomData<&'c ()>);","+","+impl Parameter for EmbeddingLevels<'_> {}","+","+impl EmbeddingLevels<'_> {","+    /// `text` is the text passed to the same call.","+    pub(crate) fn read(&self, text: &[UChar]) -> Option<&[UBiDiLevel]> {","+        // SAFETY: the array is as long as `text`. `write_back` ends the borrow.","+        (!self.0.is_null()).then(|| unsafe { slice(self.0, text.len()) })","+    }","+","+    /// Writes the array only if it differs. `bidi` is the object that copied the result of `read`.","+    pub(crate) fn write_back(self, bidi: &UBiDi) {","+        let levels = bidi.embedding_levels();","+        // SAFETY: the copy is no longer than the array, and belongs to the object, which shares no memory with the array.","+        unsafe {","+            if !self.0.is_null() && !slices_equal(slice(self.0, levels.len()), levels) {","+                self.0","+                    .copy_from_nonoverlapping(levels.as_ptr(), levels.len());","+            }","+        }","+    }","+}","+","+/// `indexMap`: null, or an uninitialized array that is as long as the text of the object.","+#[repr(transparent)]","+pub(crate) struct VisualMap<'c>(*mut MaybeUninit<i32>, PhantomData<&'c ()>);","+","+impl Parameter for VisualMap<'_> {}","+","+impl<'c> VisualMap<'c> {","+    pub(crate) fn is_null(&self) -> bool {","+        self.0.is_null()","+    }","+","+    /// `bidi` is the object passed to the same call.","+    pub(crate) fn slots(self, bidi: &UBiDi) -> &'c mut [MaybeUninit<i32>] {","+        let length = bidi.get_result_length();","+        if self.is_null() || length == 0 {","+            return &mut [];","+        }","+        // SAFETY: the array has this length, and shares no memory with the object.","+        unsafe { std::slice::from_raw_parts_mut(self.0, length) }","+    }","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"src/icu/capi/mod.rs","lines":["@@ -5,6 +5,7 @@"," #[expect(unsafe_code)]"," mod ffi;"," ","+mod ubidi;"," mod ubrk;"," mod ucal;"," mod uchar;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/icu/capi/ubidi.rs","lines":["@@ -0,0 +1,73 @@","+//! `unicode/ubidi.h`","+//!","+//! `ubidi_setPara` works on a copy of `embeddingLevels`, and writes it back before it returns, also after a failure","+//! other than for lack of memory.","+","+use crate::capi::ffi::raw::ubidi::{EmbeddingLevels, VisualMap};","+use crate::capi::ffi::{self, ErrorCode, NonNullHandle, Text, UChar, to_int32};","+use crate::common::memory::try_box;","+use crate::common::slice_ext::SliceExt;","+use crate::common::ubidi::{UBiDi, UBiDiLevel};","+use crate::common::utypes::*;","+use bun_icu_macros::capi;","+use std::hint::black_box;","+","+// ICU4C: ubidiimp.h, RETURN_IF_NOT_VALID_PARA_OR_LINE","+fn valid_para(bidi: Option<&UBiDi>) -> Result<&UBiDi, UErrorCode> {","+    bidi.filter(|bidi| bidi.is_valid())","+        .ok_or(U_INVALID_STATE_ERROR)","+}","+","+#[capi]","+fn ubidi_open() -> Option<Box<UBiDi>> {","+    ffi::on_oom(None, || try_box(UBiDi::default()).ok())","+}","+","+#[capi]","+fn ubidi_close(bidi: Option<Box<UBiDi>>) {","+    // Like ICU4C, leaves an object without a text in the block. `black_box` keeps the write.","+    if let Some(mut bidi) = bidi {","+        *bidi = UBiDi::default();","+        black_box(&*bidi);","+    }","+}","+","+#[capi]","+fn ubidi_setPara(","+    bidi: Option<&mut UBiDi>,","+    (text, _): Text<UChar>,","+    para_level: UBiDiLevel,","+    embedding_levels: EmbeddingLevels,","+    status: ErrorCode,","+) {","+    status.run((), |_| {","+        let bidi = bidi.non_null()?;","+        if text.is_null() {","+            return Err(U_ILLEGAL_ARGUMENT_ERROR);","+        }","+        UBiDi::check_para_level(para_level)?;","+        let text = text.get()?;","+        let text = text.slice(..text.len().min(i32::MAX as usize));","+        let result = bidi.set_para(text, para_level, embedding_levels.read(text));","+        if result != Err(U_MEMORY_ALLOCATION_ERROR) {","+            embedding_levels.write_back(bidi);","+        }","+        result","+    })","+}","+","+#[capi]","+fn ubidi_countRuns(bidi: Option<&UBiDi>, status: ErrorCode) -> i32 {","+    status.run(-1, |_| valid_para(bidi)?.count_runs().map(to_int32))","+}","+","+#[capi]","+fn ubidi_getVisualMap(bidi: Option<&UBiDi>, index_map: VisualMap, status: ErrorCode) {","+    status.run((), |_| {","+        if index_map.is_null() {","+            return Err(U_ILLEGAL_ARGUMENT_ERROR);","+        }","+        let bidi = valid_para(bidi)?;","+        bidi.get_visual_map(index_map.slots(bidi))","+    })","+}"],"additions":73,"deletions":0,"truncated":false},{"path":"src/icu/common/arrayvec.rs","lines":["@@ -82,6 +82,11 @@ impl<T: Copy + Default, const N: usize> ArrayVec<T, N> {","         self","     }"," ","+    #[inline]","+    pub(crate) fn clear(&mut self) {","+        self.length = 0;","+    }","+","     /// Returns false if the vector is full.","     #[inline]","     pub(crate) fn push(&mut self, unit: T) -> bool {"],"additions":5,"deletions":0,"truncated":false},{"path":"src/icu/common/mod.rs","lines":["@@ -48,7 +48,10 @@ pub(crate) mod sorting;"," mod static_map;"," pub(crate) mod static_unicode_sets;"," pub(crate) mod uarrsort;","+pub(crate) mod ubidi;"," pub(crate) mod ubidi_props;","+mod ubidi_tables;","+mod ubidiln;"," pub(crate) mod ucase;"," pub(crate) mod uchar;"," pub(crate) mod ucharstrie;"],"additions":3,"deletions":0,"truncated":false},{"path":"src/icu/common/ubidi.rs","lines":["@@ -0,0 +1,1437 @@","+//! The Unicode Bidirectional Algorithm (UAX #9): the object, and the levels of a text. ICU4C: ubidi.cpp","+//!","+//! X9 removes nothing from the text: BN and the embedding codes are skipped. The trail unit of a surrogate pair has","+//! the property of the code point, and the lead unit is BN.","+","+use crate::common::arrayvec::ArrayVec;","+use crate::common::memory::{","+    Appendable, check_oom, try_collect, try_extend_from_slice, try_push, try_resize,","+};","+use crate::common::slice_ext::{SliceExt, SoftUnwrap};","+use crate::common::ubidi_props::{","+    ubidi_get_class, ubidi_get_class_from_single_unit, ubidi_get_paired_bracket,","+    ubidi_get_paired_bracket_type,","+};","+use crate::common::ubidi_tables::{self as tables, Action, ImpTab, reduced};","+use crate::common::ubidiln::Runs;","+use crate::common::unicode::uchar::{U_BPT_CLOSE, U_BPT_OPEN};","+use crate::common::utf16;","+use crate::common::utypes::{U_ILLEGAL_ARGUMENT_ERROR, U_MEMORY_ALLOCATION_ERROR, UErrorCode};","+use std::mem::replace;","+","+/// An embedding level. Until the implicit rules have run, bit 7 is `UBIDI_LEVEL_OVERRIDE`.","+pub(crate) type UBiDiLevel = u8;","+","+const MAX_EXPLICIT_LEVEL: UBiDiLevel = 125;","+const DEFAULT_LTR: UBiDiLevel = 0xfe;","+// ICU4C: ubidi.cpp, ubidi_getMemory. An array has at most `INT32_MAX` bytes, and a run has 12.","+pub(crate) const MAX_RUN_COUNT: usize = i32::MAX as usize / 12;","+// ICU4C: ubidi.cpp, checkParaCount. It allocates twice the number of paragraphs, 8 bytes each.","+const MAX_PARA_COUNT: usize = i32::MAX as usize / 16;","+// ICU4C: ubidiimp.h. It needs no memory for so many.","+const SIMPLE_PARAS_COUNT: usize = 10;","+const LEVEL_OVERRIDE: UBiDiLevel = 0x80;","+","+/// A CR before an LF does not end a paragraph.","+fn is_cr_before_lf(text: &[u16], i: usize) -> bool {","+    text.get(i..i + 2) == Some(&[0x0d, 0x0a])","+}","+","+/// Returns true for `UBIDI_DEFAULT_LTR` and `UBIDI_DEFAULT_RTL`. Bit 0 is the level if no character is strong.","+fn is_default_level(level: UBiDiLevel) -> bool {","+    level >= DEFAULT_LTR","+}","+","+fn no_override(level: UBiDiLevel) -> UBiDiLevel {","+    level & !LEVEL_OVERRIDE","+}","+","+/// Bidi_Class, with the values of `UCharDirection`, and two more for European numbers whose context is known.","+#[expect(clippy::upper_case_acronyms)]","+#[derive(Clone, Copy, PartialEq, Default)]","+#[repr(u8)]","+enum DirProp {","+    L,","+    R,","+    EN,","+    ES,","+    ET,","+    AN,","+    CS,","+    B,","+    S,","+    WS,","+    #[default]","+    ON,","+    LRE,","+    LRO,","+    AL,","+    RLE,","+    RLO,","+    PDF,","+    NSM,","+    BN,","+    FSI,","+    LRI,","+    RLI,","+    PDI,","+    /// EN after W7","+    ENL,","+    /// EN not subject to W7","+    ENR,","+}","+","+use DirProp::*;","+","+/// A set of `DirProp`s.","+type Flags = u32;","+","+impl DirProp {","+    /// Indexed by the five bits of a class in the data.","+    const ALL: [Self; 32] = [","+        L, R, EN, ES, ET, AN, CS, B, S, WS, ON, LRE, LRO, AL, RLE, RLO, PDF, NSM, BN, FSI, LRI,","+        RLI, PDI, ENL, ENR, ON, ON, ON, ON, ON, ON, ON,","+    ];","+","+    fn from_code_point(c: u32) -> Self {","+        Self::ALL.at(ubidi_get_class(c) as usize % Self::ALL.len())","+    }","+","+    /// `unit` is not a lead surrogate.","+    #[inline]","+    fn from_single_unit(unit: u16) -> Self {","+        Self::ALL.at(ubidi_get_class_from_single_unit(unit) as usize % Self::ALL.len())","+    }","+","+    fn from_level(level: UBiDiLevel) -> Self {","+        if level & 1 == 0 { L } else { R }","+    }","+","+    const fn flag(self) -> Flags {","+        1 << self as u32","+    }","+","+    fn is_in(self, mask: Flags) -> bool {","+        self.flag() & mask != 0","+    }","+}","+","+const MASK_LTR: Flags = L.flag()","+    | EN.flag()","+    | ENL.flag()","+    | ENR.flag()","+    | AN.flag()","+    | LRE.flag()","+    | LRO.flag()","+    | LRI.flag();","+const MASK_RTL: Flags = R.flag() | AL.flag() | RLE.flag() | RLO.flag() | RLI.flag();","+const MASK_R_AL: Flags = R.flag() | AL.flag();","+const MASK_STRONG: Flags = L.flag() | MASK_R_AL;","+const MASK_EXPLICIT: Flags = LRE.flag() | LRO.flag() | RLE.flag() | RLO.flag() | PDF.flag();","+const MASK_ISO: Flags = LRI.flag() | RLI.flag() | FSI.flag() | PDI.flag();","+const MASK_BN_EXPLICIT: Flags = BN.flag() | MASK_EXPLICIT;","+const MASK_B_S: Flags = B.flag() | S.flag();","+const MASK_WS: Flags = MASK_B_S | WS.flag() | MASK_BN_EXPLICIT | MASK_ISO;","+const MASK_POSSIBLE_N: Flags = ON.flag() | CS.flag() | ES.flag() | ET.flag() | MASK_WS;","+/// The properties that may take the embedding direction (N2).","+const MASK_EMBEDDING: Flags = NSM.flag() | MASK_POSSIBLE_N;","+","+fn flag_lr(level: UBiDiLevel) -> Flags {","+    DirProp::from_level(level).flag()","+}","+","+// ICU4C: ubidi.cpp, DIRPROP_FLAG_E and DIRPROP_FLAG_O. LRO and RLO are in the same masks as LRE and RLE.","+fn flag_e(level: UBiDiLevel) -> Flags {","+    if level & 1 == 0 {","+        LRE.flag()","+    } else {","+        RLE.flag()","+    }","+}","+","+#[derive(Clone, Copy, PartialEq, Default)]","+pub(crate) enum Direction {","+    #[default]","+    Ltr,","+    Rtl,","+    Mixed,","+}","+","+/// Stores the properties from `*i` on and adds them to `flags`. Stops after the first that is in `mask` and returns","+/// it, or returns `None` at the end of the text.","+#[inline]","+fn classify_until(","+    text: &[u16],","+    mask: Flags,","+    dir_props: &mut [DirProp],","+    i: &mut usize,","+    flags: &mut Flags,","+) -> Option<DirProp> {","+    loop {","+        while let (Some(&unit), Some(slot)) = (text.get(*i), dir_props.get_mut(*i))","+            && !utf16::is_lead(unit.into())","+        {","+            *slot = DirProp::from_single_unit(unit);","+            *flags |= slot.flag();","+            *i += 1;","+            if slot.is_in(mask) {","+                return Some(*slot);","+            }","+        }","+        if *i >= text.len() {","+            return None;","+        }","+        let c = utf16::next(text, i);","+        let dir_prop = DirProp::from_code_point(c);","+        *flags |= dir_prop.flag();","+        dir_props.set(*i - 1, dir_prop);","+        if c > 0xffff {","+            *flags |= BN.flag();","+            dir_props.set(*i - 2, BN);","+        }","+        if dir_prop.is_in(mask) {","+            return Some(dir_prop);","+        }","+    }","+}","+","+#[derive(Clone, Copy, Default)]","+struct Para {","+    limit: u32,","+    level: UBiDiLevel,","+}","+","+impl Para {","+    fn limit(self) -> usize {","+        self.limit as usize","+    }","+}","+","+enum Paras {","+    Few(ArrayVec<Para, SIMPLE_PARAS_COUNT>),","+    Many(Vec<Para>),","+}","+","+impl Default for Paras {","+    fn default() -> Self {","+        Self::Few(ArrayVec::new())","+    }","+}","+","+impl Paras {","+    #[inline]","+    fn as_slice(&self) -> &[Para] {","+        match self {","+            Self::Few(list) => list,","+            Self::Many(list) => list,","+        }","+    }","+","+    /// Requires a paragraph.","+    #[inline]","+    fn first_limit(&self) -> usize {","+        match self {","+            Self::Few(list) => list.units[0].limit(),","+            Self::Many(list) => list.at(0).limit(),","+        }","+    }","+","+    /// Keeps the memory.","+    fn clear(&mut self) {","+        match self {","+            Self::Few(list) => list.clear(),","+            Self::Many(list) => list.clear(),","+        }","+    }","+","+    fn push(&mut self, para: Para) -> Result<(), UErrorCode> {","+        match self {","+            Self::Few(list) => {","+                if !list.push(para) {","+                    *self = Self::Many(try_collect(list.iter().copied().chain([para]))?);","+                }","+            }","+            Self::Many(list) => try_push(list, para)?,","+        }","+        Ok(())","+    }","+","+    /// Iterates over the starts, limits and levels. They cover exactly the text.","+    fn with_starts(&self) -> impl Iterator<Item = (usize, usize, UBiDiLevel)> {","+        let mut start = 0;","+        self.as_slice()","+            .iter()","+            .map(move |&para| (replace(&mut start, para.limit()), para.limit(), para.level))","+    }","+}","+","+#[derive(Clone, Copy, Default)]","+pub(crate) struct Run {","+    pub(crate) logical_start: usize,","+    pub(crate) is_odd: bool,","+    /// Read only while the runs are reordered.","+    pub(crate) level: UBiDiLevel,","+    pub(crate) visual_limit: usize,","+}","+","+#[derive(Default)]","+pub(crate) struct UBiDi {","+    /// False if there is no text yet, or if the last `set_para` failed.","+    is_valid: bool,","+    pub(super) length: usize,","+    dir_props: Vec<DirProp>,","+    /// Valid if the direction is mixed.","+    pub(super) levels: Vec<UBiDiLevel>,","+    pub(super) para_level: UBiDiLevel,","+    /// The level of each paragraph is computed from its text.","+    default_para_level: bool,","+    pub(super) direction: Direction,","+    paras: Paras,","+    pub(super) runs: Runs,","+    /// Scratch buffers of `set_para`, reused for the next text.","+    bracket_lists: BracketLists,","+    isolates: Vec<Isolate>,","+}","+","+impl UBiDi {","+    pub(crate) fn is_valid(&self) -> bool {","+        self.is_valid","+    }","+","+    pub(crate) fn get_result_length(&self) -> usize {","+        if self.is_valid { self.length } else { 0 }","+    }","+","+    // ICU4C: ubidiimp.h, GET_PARALEVEL","+    #[inline]","+    fn para_level_at(&self, index: usize) -> UBiDiLevel {","+        if self.default_para_level && index >= self.paras.first_limit() {","+            self.search_para_level(index)","+        } else {","+            self.para_level","+        }","+    }","+","+    fn search_para_level(&self, index: usize) -> UBiDiLevel {","+        let paras = self.paras.as_slice();","+        paras","+            .get(paras.partition_point(|para| para.limit() <= index))","+            .map(|para| para.level)","+            .soft_unwrap()","+    }","+","+    pub(crate) fn check_para_level(para_level: UBiDiLevel) -> Result<(), UErrorCode> {","+        if para_level > MAX_EXPLICIT_LEVEL && !is_default_level(para_level) {","+            return Err(U_ILLEGAL_ARGUMENT_ERROR);","+        }","+        Ok(())","+    }","+","+    /// Returns the copy as `set_para` has changed it, also after a failure, for the caller's array.","+    pub(crate) fn embedding_levels(&self) -> &[UBiDiLevel] {","+        &self.levels","+    }","+","+    /// Requires that `para_level` has passed `check_para_level`. `embedding_levels` is as long as the text, which has","+    /// at most `INT32_MAX` units.","+    // ICU4C: ubidi.cpp, ubidi_setPara","+    pub(crate) fn set_para(","+        &mut self,","+        text: &[u16],","+        para_level: UBiDiLevel,","+        embedding_levels: Option<&[UBiDiLevel]>,","+    ) -> Result<(), UErrorCode> {","+        debug_assert!(Self::check_para_level(para_level).is_ok());","+        self.is_valid = false;","+        self.paras.clear();","+        if embedding_levels.is_some() {","+            self.levels.clear();","+        }","+        self.length = text.len();","+        self.para_level = para_level;","+        self.runs.clear();","+        self.default_para_level = is_default_level(para_level);","+","+        if self.length == 0 {","+            self.runs.set(Vec::new());","+            self.is_valid = true;","+            return Ok(());","+        }","+","+        let mut resolve_state = self.get_dir_props(text)?;","+        // A B is at the end of its paragraph.","+        let only_trailing_ws = resolve_state.flags & (S.flag() | MASK_BN_EXPLICIT) == 0;","+        if let Some(given) = embedding_levels {","+            try_extend_from_slice(&mut self.levels, given)?;","+            self.check_explicit_levels(&mut resolve_state)?;","+        } else {","+            try_resize(&mut self.levels, self.length, 0)?;","+            self.resolve_explicit_levels(text, &mut resolve_state)?;","+        }","+","+        self.direction = direction_from_flags(resolve_state.flags);","+        if self.direction == Direction::Mixed {","+            self.resolve_implicit_rules(resolve_state.is_one_run);","+            // Observable: an unmatched initiator or PDI becomes WS without an update of the flags.","+            if resolve_state.flags & MASK_WS != 0 {","+                self.adjust_ws_levels(only_trailing_ws);","+            }","+        }","+        check_oom()?;","+        self.init_single_run();","+        self.is_valid = true;","+        Ok(())","+    }","+","+    // P2, P3, X5c","+","+    /// Computes the properties, the paragraphs and their levels. An FSI becomes LRI, or RLI if its first strong","+    /// character is R or AL.","+    // ICU4C: ubidi.cpp, getDirProps","+    fn get_dir_props(&mut self, text: &[u16]) -> Result<ResolveState, UErrorCode> {","+        /// The item that the next strong character resolves. 32 bits, so that `memset` can initialize the stack.","+        #[derive(Clone, Copy, PartialEq)]","+        #[repr(u32)]","+        enum Seeking {","+            Nothing,","+            Para,","+            Fsi,","+        }","+","+        let length = text.len();","+        if self.dir_props.len() < length {","+            try_resize(&mut self.dir_props, length, ON)?;","+        }","+        let (dir_props, paras) = (self.dir_props.slice_mut(..length), &mut self.paras);","+","+        let (initial_level, initial_seeking) = if self.default_para_level {","+            (self.para_level & 1, Seeking::Para)","+        } else {","+            (self.para_level, Seeking::Nothing)","+        };","+        let (mut level, mut seeking) = (initial_level, initial_seeking);","+        // The position of each open initiator, and the state before it.","+        let mut isolates = Stack