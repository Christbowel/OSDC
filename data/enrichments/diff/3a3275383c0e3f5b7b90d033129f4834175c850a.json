sonate-user-id',","+        ] as $param => $header) {","+            $value = $request->getHeaderLine($header, '');","+            if ($value === '') {","+                $value = $request->getQuery($param, '');","+            }","+            if (\\is_string($value) && $value !== '') {","+                $binding[$param] = $value;","+            }","+        }","+","+        return $binding;","+    }","+","+    /**","+     * Appends the request's binding (see binding()) to a URL a player follows.","+     * `updatedAt` is the video document's last write: a fresh playlist emits a","+     * new value and Fastly treats those segment addresses as new objects. Copies","+     * that still carry an older time share the video's Surrogate-Key and are","+     * dropped by purgeVideoSegmentCache.","+     */","+    protected function withProject(string $uri, Request $request, Document $video): string","+    {","+        $query = \\http_build_query(","+            $this->binding($request) + ['updatedAt' => $video->getUpdatedAt()],","+            '',","+            '&'","+        );"," ","         return $uri . (\\str_contains($uri, '?') ? '&' : '?') . $query;","     }"],"additions":42,"deletions":10,"truncated":false},{"path":"src/Appwrite/Platform/Modules/Videos/Http/Videos/Outputs/CMAF/DASH/Manifest/Get.php","lines":["@@ -9,9 +9,9 @@"," use Appwrite\\SDK\\MethodType;"," use Appwrite\\SDK\\Response as SDKResponse;"," use Appwrite\\Utopia\\Database\\Documents\\User;","+use Appwrite\\Utopia\\Request;"," use Appwrite\\Utopia\\Response;"," use Utopia\\Database\\Database;","-use Utopia\\Database\\Document;"," use Utopia\\Database\\Validator\\Authorization;"," use Utopia\\Database\\Validator\\UID;"," use Utopia\\Platform\\Action;","@@ -50,7 +50,7 @@ public function __construct()","                 ],","                 contentType: ContentType::ANY,","                 type: MethodType::LOCATION,","-                locationAuth: ['Project', 'ImpersonateUserId'],","+                loc