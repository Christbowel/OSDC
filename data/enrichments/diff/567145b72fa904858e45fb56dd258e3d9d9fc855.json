{"id":"567145b72fa904858e45fb56dd258e3d9d9fc855","axis":"silent","repo":"vercel/turbo","sha":"567145b72fa904858e45fb56dd258e3d9d9fc855","parsed":{"files":[{"path":"crates/turborepo-cli/src/commands/setup.rs","lines":["@@ -103,6 +103,13 @@ pub enum Error {","     #[error(transparent)]","     Rust(#[from] turborepo_setup::rust_provision::Error),","     #[error(transparent)]","+    Artifact(#[from] turborepo_setup::artifact_provision::Error),","+    #[error(","+        \"setup.additionalTools changed for {0:?}; run `turbo setup` locally and commit the \\","+         updated turbo.lock\"","+    )]","+    AdditionalToolDrift(std::collections::BTreeSet<String>),","+    #[error(transparent)]","     Install(#[from] turborepo_tool_install::Error),","     #[error(transparent)]","     Io(#[from] std::io::Error),"],"additions":7,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/additional_tools_tests.rs","lines":["@@ -0,0 +1,117 @@","+//! Repository-declared tools through `turbo setup`, with local fixtures only.","+use super::*;","+","+const LOCAL: &[&str] = &[\"--tools-only\", \"--no-frozen\"];","+","+fn artifact() -> Vec<u8> {","+    archive(","+        \"fixture-1.2.3\",","+        &[","+            (\"bin/fixture\", \"#!/bin/sh\\necho fixture 1.2.3\\n\"),","+            (\"share/data.txt\", \"fixture resource\"),","+        ],","+    )","+}","+","+fn tool(sha256: String) -> Value {","+    let platform = serde_json::to_value(provision::platform().unwrap()).unwrap();","+    json!({\"version\": \"1.2.3\", \"artifacts\": {platform.as_str().unwrap(): {","+        \"url\": \"https://downloads.example.test/fixture-1.2.3.tar.gz\", \"sha256\": sha256,","+        \"format\": \"tar-gz\", \"rootPrefix\": \"fixture-1.2.3\",","+        \"executables\": {\"fixture\": \"bin/fixture\"}}}})","+}","+","+fn declare(f: &Fixture, tools: Value) {","+    let config = json!({\"futureFlags\": {\"experimentalSetup\": true},","+        \"setup\": {\"additionalTools\": tools}});","+    fs::write(f.owned.root().join(\"turbo.json\"), config.to_string()).unwrap();","+}","+","+/// Node plus one additional tool, served from a literal-loopback fixture.","+fn fixture() -> (Fixture, LoopbackServer) {","+    let mut f = Fixture::new();","+    f.lock[\"tools\"].as_object_mut().unwrap().remove(\"pnpm\");","+    f.declare(json!({}));","+    declare(","+        &f,","+        json!({\"fixture\": tool(format!(\"{:x}\", Sha256::digest(artifact())))}),","+    );","+    let routes = [","+        (f.node_path.clone(), f.node.clone()),","+        (\"/fixture-1.2.3.tar.gz\".into(), artifact()),","+    ];","+    let u = LoopbackServer::new(routes, |_| {}).unwrap();","+    (f, u)","+}","+","+fn installed(f: &Fixture) -> Vec<String> {","+    let store = turborepo_tool_install::Store::open(f.owned.root()).unwrap();","+    let current = store.current().unwrap().unwrap();","+    current.tools.into_iter().map(|tool| tool.id).collect()","+}","+","+#[test]","+fn local_setup_locks_installs_reuses_and_removes_additional_tools() {","+    let (f, u) = fixture();","+    assert_eq!(f.run(&u, LOCAL).unwrap(), 0);","+    assert_eq!(u.hits(), 2);","+    let lock: Value =","+        serde_json::from_slice(&fs::read(f.owned.root().join(\"turbo.lock\")).unwrap()).unwrap();","+    assert_eq!(lock[\"tools\"][\"fixture\"][\"adapter\"], \"artifact\");","+    assert_eq!(installed(&f), [\"fixture\", \"node\"]);","+    let store = turborepo_tool_install::Store::open(f.owned.root()).unwrap();","+    let bin = store.current().unwrap().unwrap().bin;","+    let output = std::process::Command::new(bin.join(\"fixture\"))","+        .output()","+        .unwrap();","+    assert_eq!(output.stdout, b\"fixture 1.2.3\\n\");","+    assert_eq!(","+        fs::read(bin.join(\"../tools/fixture/share/data.txt\")).unwrap(),","+        b\"fixture resource\"","+    );","+    drop(store);","+","+    // Frozen repeats reuse the installation and leave tracked files alone.","+    let lock = fs::read(f.owned.root().join(\"turbo.lock\")).unwrap();","+    let manifest = f.manifest().unwrap();","+    assert_eq!(f.run(&u, FROZEN).unwrap(), 0);","+    assert_eq!(u.hits(), 2);","+    assert_eq!(fs::read(f.owned.root().join(\"turbo.lock\")).unwrap(), lock);","+    assert_eq!(f.manifest().unwrap(), manifest);","+","+    // Removing the declaration removes its lock entry and installation.","+    declare(&f, json!({}));","+    assert_eq!(f.run(&u, LOCAL).unwrap(), 0);","+    assert_eq!(installed(&f), [\"node\"]);","+    let lock: Value =","+        serde_json::from_slice(&fs::read(f.owned.root().join(\"turbo.lock\")).unwrap()).unwrap();","+    assert!(lock[\"tools\"].get(\"fixture\").is_none());","+    assert_eq!(u.hits(), 2);","+    f.no_execution();","+}","+","+#[test]","+fn drift_and_checksum_failures_keep_the_previous_installation() {","+    let (f, u) = fixture();","+    assert_eq!(f.run(&u, LOCAL).unwrap(), 0);","+    let lock = fs::read(f.owned.root().join(\"turbo.lock\")).unwrap();","+    let manifest = f.manifest().unwrap();","+","+    // Same version, different digest: frozen setup names the declaration.","+    declare(&f, json!({\"fixture\": tool(\"0\".repeat(64))}));","+    let error = f.run(&u, FROZEN).unwrap_err();","+    assert!(","+        matches!(&error, Error::AdditionalToolDrift(ids) if ids.contains(\"fixture\")),","+        \"{error}\"","+    );","+    assert_eq!(u.hits(), 2);","+    assert_eq!(fs::read(f.owned.root().join(\"turbo.lock\")).unwrap(), lock);","+","+    // Local setup records the new digest, which the download then fails.","+    let error = f.run(&u, LOCAL).unwrap_err();","+    assert!(error.to_string().contains(\"\\\"fixture\\\"\"), \"{error}\");","+    assert_eq!(u.hits(), 3);","+    assert_eq!(f.manifest().unwrap(), manifest);","+    assert_eq!(installed(&f), [\"fixture\", \"node\"]);","+    f.no_execution();","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/first_lock.rs","lines":