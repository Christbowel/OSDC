+    let end = s.floor_char_boundary((start + max_len.saturating_sub(3)).min(s.len()));"," ","     if start == 0 {","         format!(\"{}...\", &s[..end])","@@ -319,3 +319,20 @@ fn truncate_str(s: &str, max_len: usize) -> String {","         format!(\"...{}...\", &s[start..end])","     }"," }","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn truncate_str_cuts_on_char_boundaries() {","+        assert_eq!(","+            truncate_str(\"{\\n        // 检查余额是否足够支付\\n        return a + 1;\\n    }\", 40),","+            \"...查余额是否足够支付\\n        r...\"","+        );","+        assert_eq!(","+            truncate_str(\"{\\n        return owner;\\n        // 返回当前合约的所有者\\n    }\", 40),","+            \"...owner;\\n        // 返回当前合约...\"","+        );","+    }","+}"],"additions":19,"deletions":2,"truncated":false},{"path":"crates/forge/src/mutation/visitor.rs","lines":["@@ -5,7 +5,7 @@ use crate::mutation::{"," };"," use eyre::Report;"," use foundry_config::MutatorType;","-use solar::ast::{Expr, ItemContract, VariableDefinition, visit::Visit, yul};","+use solar::ast::{Expr, ItemContract, ItemFunction, VariableDefinition, visit::Visit, yul};"," use std::{ops::ControlFlow, path::PathBuf};"," "," #[cfg(test)]","@@ -145,6 +145,23 @@ impl<'ast> Visit<'ast> for MutantVisitor<'ast> {","         res","     }"," ","+    fn visit_item_function(","+        &mut self,","+        function: &'ast ItemFunction<'ast>,","+    ) -> ControlFlow<Self::BreakValue> {","+        if self.in_allowed_contract && function.body.is_some() {","+            let mut builder = MutationContext::builder()","+                .with_path(self.path.clone())","+                .with_span(function.body_span)","+                .with_function(function);","+            if let Some(src) = self.source {","+                builder = builder.with_source(src);","+            }","+            self.collect_mutations(&builder.build().expect(\"function body context\"));","+        }","+       