.to_string(),","+        );","+        assert_eq!(","+            mutated,","+            source.replacen(","+                \"function effect() public guarded { revert(); }\",","+                \"function effect() public guarded {}\",","+                1,","+            )","+        );","+        assert_eq!(","+            mutants.iter().map(|mutant| mutant.mutation.to_string()).collect::<Vec<_>>(),","+            [","+                \"{}\",","+                \"{ return true; }\",","+                \"{ return false; }\",","+                \"{ return 0; }\",","+                \"{ return 1; }\",","+                \"{ return 0; }\",","+                \"{ return 1; }\",","+                \"{ return -1; }\",","+                \"{ return address(0); }\",","+                \"{ return payable(address(0)); }\",","+                \"{}\",","+                \"{}\",","+                \"{}\",","+                \"{ return 1; }\",","+            ]","+        );","+    }","+","+    #[test]","+    fn function_body_replacements_skip_equivalent_constants() {","+        for (ty, expression, expected) in [","+            (\"bool\", \"(true)\", vec![\"false\"]),","+            (\"bool\", \"(/* Always on. */ true)\", vec![\"false\"]),","+            (\"bool\", \"bool((false))\", vec![\"true\"]),","+            (\"uint256\", \"0x0\", vec![\"1\"]),","+            (\"uint8\", \"uint8(0)\", vec![\"1\"]),","+            (\"uint256\", \"1_0e-1\", vec![\"0\"]),","+            (\"int256\", \"-(int8((0x1)))\", vec![\"0\", \"1\"]),","+            (\"int256\", \"int256(-1)\", vec![\"0\", \"1\"]),","+            (\"int256\", \"-(-1)\", vec![\"0\", \"-1\"]),","+            (\"int256\", \"-0\", vec![\"1\", \"-1\"]),","+            (\"address\", \"address(uint160(0x0))\", vec![]),","+            (\"address payable\", \"payable(address((0)))\", vec![]),","+            // Keep replacements when evaluating the original can have side effects.","+            (\"bool\", \"other()\", vec![\"true\", \"false\"]),","+            (\"uint8\", \"uint8(other())\", vec![\"0\", \"1\"]),","+        ] {","+            let source = format!(","+                \"contract Target {{ function target() public returns ({ty}) {{ return {expression}; }} }}\"","+            );","+            let replacements = function_body_mutants(&source)","+                .iter()","+                .map(|mutant| mutant.mutation.to_string())","+                .collect::<Vec<_>>();","+            assert_eq!(","+                replacements,","+                expected.iter().map(|value| format!(\"{{ return {value}; }}\")).collect::<Vec<_>>(),","+                \"{source}\"","+            );","+        }","+    }","+","+    fn function_body_mutants(source: &str) -> Vec<Mutant> {","+        let sess = Session::builder().with_silent_emitter(None).build();","+        sess.enter(|| {","+            let arena = Arena::new();","+            let mut parser = Parser::from_lazy_source_code(","+                &sess,","+                &arena,","+                FileName::Real(\"target.sol\".into()),","+                || Ok(source.to_string()),","+            )","+            .unwrap();","+            let ast = parser.parse_file().map_err(|e| e.emit()).unwrap();","+            drop(parser);","+            let mut visitor =","+                MutantVisitor::with_operators(\"target.sol\".into(), &[MutatorType::FunctionBody])","+                    .with_source(source)","+                    .with_contract_filter(|name| name == \"Target\");","+            let _ = visitor.visit_source_unit(&ast);","+            assert!(visitor.take_errors().is_empty());","+            for mutant in &visitor.mutation_to_conduct {","+                assert_eq!(","+                    mutant.original,","+                    &source[mutant.span.lo().0 as usize..mutant.span.hi().0 as usize]","+                );","+            }","+            visitor.mutation_to_conduct","+        })","+    }"," }"],"additions":143,"deletions":1,"truncated":false},{"path":"crates/forge/tests/cli/test_cmd/mutation.rs","lines":["@@ -13,6 +13,49 @@ fn mutation_summary(stdout: &str) -> serde_json::Value {","     serde_json::from_str::<serde_json::Value>(stdout.trim()).unwrap()[\"summary\"].clone()"," }"," ","+#[forgetest_init]","+fn mutation_testing_body_survivors_do_not_skip_other_mutants(prj: _, cmd: _) {","+    prj.add_source(","+        \"Body.sol\",","+        r#\"pragma solidity ^0.8.13;","+contract Body {","+    uint public number;","+    function check(bool value) public returns (bool) { number = 7; return value; }","+}\"#,","+    );","+    prj.add_test(","+        \"Body.t.sol\",","+        r#\"pragma solidity ^0.8.13;","+import \"../src/Body.sol\";","+contract BodyTest {","+    function testCheck() public { assert(new Body().check(true)); }","+}\"#,","+    );","+    fs::write(","+        prj.root().join(\"foundry.toml\"),","+        r#\"[mutation]","+exclude_operators = [\"assembly\", \"binary-op\", \"delete-expression\", \"elim-delegate\", \"require\", \"unary-op\"]","+\"#,","+    )","+    .unwrap();","+    // A fixed seed keeps the execution cache key, and so the persisted spans, stable across runs.","+    let args =","+        [\"test\", \"--mutate\", \"src/Body.sol\", \"--mutation-jobs\", \"1\", \"--fuzz-seed\", \"1\", \"--json\"];","+    let expected = str![[r#\"","+{\"summary\":{\"total\":3,\"killed\":1,\"survived\":2,\"invalid\":0,\"skipped\":0,\"timed_out\":0,\"mutation_score\":33.33333333333333,\"duration_secs\":\"{...}\"},\"survived_mutants\":{\"src/Body.sol\":[{\"line\":5,\"column\":54,\"original\":\"{ number = 7; return value; }\",\"mutant\":\"{ return true; }\"},{\"line\":5,\"column\":56,\"original\":\"number = 7\",\"mutant\":\"0\"}]}}","+\"#]];","+    cmd.args(args).assert_json_stdout(expected.clone());","+","+    // Resume from the persisted survived spans without a complete results cache.","+    for entry in fs::read_dir(prj.root().join(\"cache/mutation\")).unwrap() {","+      