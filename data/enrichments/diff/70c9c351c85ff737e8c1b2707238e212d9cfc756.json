nd the Admin","+acceptance and browser E2E suites drive a browser per worker. Each sizes its","+workers as if it had the machine to itself, so tests running in several","+worktrees at once can exhaust memory.","+","+Set `GHOST_TEST_MACHINE_SHARE` in your shell profile to the share of the","+machine one test run may use, such as `0.5` when two worktrees run tests at","+once. Each suite scales its workers to that share by what its workers cost, so","+the suites split the machine instead of each taking all of it.","+`TEST_WORKERS_COUNT` sets an exact worker count instead.","+"," ## Run Browser E2E Tests"," "," The browser suite needs its test infrastructure running. For the normal"],"additions":13,"deletions":0,"truncated":false},{"path":"e2e/package.json","lines":["@@ -34,6 +34,7 @@","   \"devDependencies\": {","     \"@eslint/js\": \"catalog:\",","     \"@faker-js/faker\": \"catalog:\",","+    \"@internal/cfg-test-workers\": \"workspace:*\",","     \"@playwright/test\": \"catalog:\",","     \"@tryghost/adapter-base-upgrade\": \"workspace:*\",","     \"@tryghost/app-contracts\": \"workspace:*\","],"additions":1,"deletions":0,"truncated":false},{"path":"e2e/playwright.config.mjs","lines":["@@ -1,5 +1,5 @@"," import dotenv from 'dotenv';","-import os from 'os';","+import { testWorkerCount } from '@internal/cfg-test-workers';"," dotenv.config({ quiet: true });"," "," /*","@@ -10,10 +10,7 @@ dotenv.config({ quiet: true });","  * It's possible to use more workers, but then the total test time and flakiness","  * goes up dramatically.","  */","-const getWorkerCount = () => {","-  const cpuCount = os.cpus().length;","-  return Math.floor(cpuCount / 3) || 1;","-};","+const getWorkerCount = () => testWorkerCount({ memoryPerWorkerGB: 2, cpusPerWorker: 3 });"," "," /** @type {import('@playwright/test').PlaywrightTestConfig} */"," const config = {","@@ -25,7 +22,7 @@ const config = {","   },","   retries: 0, // Retries open the door to flaky tests. If the test needs retries, it's not a good test or the app is broken.","   maxFailures: process.argv.includes('--ui') ? 0 : 1,","-  workers: parseInt(process.env.TEST_WORKERS_COUNT, 10) || getWorkerCount(),","+  workers: getWorkerCount(),","   fullyParallel: false,","   reporter: process.env.CI","     ? ["],"additions":3,"deletions":6,"truncated":false},{"path":"ghost/package.json","lines":["@@ -240,6 +240,7 @@","   \"devDependencies\": {","     \"@eslint/js\": \"catalog:\",","     \"@internal/cfg-eslint\": \"workspace:*\",","+    \"@internal/cfg-test-workers\": \"workspace:*\",","     \"@tryghost/email-mock-receiver\": \"2.3.19\",","     \"@tryghost/express-test\": \"2.3.20\",","     \"@tryghost/webhook-mock-receiver\": \"2.3.19\","],"additions":1,"deletions":0,"truncated":false},{"path":"ghost/vitest.config.db.ts","lines":["@@ -1,5 +1,5 @@"," import path from 'node:path';","-import { availableParallelism } from 'node:os';","+import { testWorkerCount } from '@internal/cfg-test-workers';"," import { defineConfig } from 'vitest/config';"," import { coverageEnv } from './test/utils/strict-mode';"," ","@@ -54,7 +54,7 @@ const sharedSsrConfig = {","  * one purely on worker count. `legacy` runs on the threads pool, so the","  * \"forks 2 hangs\" wedge below is not in play here.","  */","-const getWorkerCount = () => Math.max(2, availableParallelism() - 1);","+const getWorkerCount = () => testWorkerCount({ memoryPerWorkerGB: 1, min: 2 });"," "," // Shared by every DB-backed project — the execution model is identical for all"," // of them; only the include globs and per-suite timeouts differ."],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -1220,6 +1220,9 @@ importers:","       '@internal/cfg-eslint-react':","         specifier: workspace:*","         version: link:../../tools/configs/eslint-react","+      '@internal/cfg-test-workers':","+        specifier: workspace:*","+        version: link:../../tools/configs/test-workers","       '@sentry/vite-plugin':","         specifier: 'catalog:'","         version: 5.4.1(rollup@4.62.2)(supports-color@10.2.2)","@@ -2044,6 +2047,9 @@ importers:","       '@faker-js/faker':","         specifier: 'catalog:'","         version: 10.6.0","+      '@internal/cfg-test-workers':","+        specifier: workspace:*","+        version: link:../tools/configs/test-workers","       '@playwright/test':","         specifier: 'catalog:'","         version: 1.64.1","@@ -2609,6 +2615,9 @@ importers:","       '@internal/cfg-eslint':","         specifier: workspace:*","         version: link:../tools/configs/eslint","+      '@internal/cfg-test-workers':","+        specifier: workspace:*","+        version: link:../tools/configs/test-workers","       '@tryghost/email-mock-receiver':","         specifier: 2.3.19","         version: 2.3.19","@@ -4490,6 +4499,8 @@ importers:","         specifier: 'catalog:'","         version: '@typescript/typescript6@6.0.2'"," ","+  tools/configs/test-workers: {}","+","   tools/configs/typescript: {}"," ","   tools/configs/vite-public-app:"],"additions":11,"deletions":0,"truncated":false},{"path":"tools/configs/README.md","lines":["@@ -9,6 +9,7 @@ workspace and compose the shared factories or presets."," | [eslint/](eslint/README.md) | Node/library rule factories and shared rule atoms | `@internal/cfg-eslint`                                      |"," | `eslint-react/`             | React workspace rule factories                    | `@internal/cfg-eslint-react`                                |"," | `oxlint/`                   | Custom lint rules and plugin entrypoints          | Root Oxlint configuration; `@internal/cfg-oxlint` typecheck |","+| `test-workers/`             | Worker count for expensive test suites            | `@internal/cfg-test-workers`                                |"," | `typescript/`               | Strict ESM and browser compiler presets           | `@internal/cfg-typescript` JSON presets                     |"," | `vite-public-app/`          | Shared public-app build setup and declarations    | `@internal/cfg-vite-public-app`                             |"," | `vitest/`                   | Shared test configuration                         | `@internal/cfg-vitest`                                      |"],"additions":1,"deletions":0,"truncated":false},{"path":"tools/configs/test-workers/index.d.mts","lines":["@@ -0,0 +1,12 @@","+export interface TestWorkerOptions {","+  /** Memory one worker uses at its peak, including the browser or Ghost it drives. */","+  memoryPerWorkerGB: number;","+  /** Cores one worker keeps busy. Default `1`. */","+  cpusPerWorker?: number;","+  /** Default `1`. */","+  min?: number;","+  /** Default no limit. */","+  max?: number;","+}","+","+export function testWorkerCount(options: TestWorkerOptions): number;"],"additions":12,"deletions":0,"truncated":false},{"path":"tools/configs/test-workers/index.mjs","lines":["@@ -0,0 +1,51 @@","+import { availableParallelism, totalmem } from 'node:os';","+","+const GB = 1024 ** 3;","+","+// The rest of the machine needs memory too, and a machine that swaps runs","+// tests slower than one running fewer workers.","+const USABLE_MEMORY_SHARE = 0.67;","+","+/**","+ * Share of the machine one test run may use. Each run sizes itself as if it","+ * had the machine to itself, so runs in several worktrees at once need to","+ * split it between them.","+ */","+function machineShare() {","+  const raw = process.env.GHOST_TEST_MACHINE_SHARE;","+  const share = Number(raw || 1);","+  if (!(share > 0 && share <= 1)) {","+    throw new Error(`GHOST_TEST_MACHINE_SHARE must be greater than 0 and at most 1, got \"${raw}\"`);","+  }","+  return share;","+}","+","+// totalmem() reports the host's memory inside a memory-limited container","+function usableMemory() {","+  const limit = process.constrainedMemory?.() ?? 0;","+  const total = totalmem();","+  return (limit > 0 && limit < total ? limit : total) * USABLE_MEMORY_SHARE;","+}","+","+/**","+ * Number of parallel workers for a test suite whose workers each run a browser","+ * or a Ghost. Such workers can exhaust memory before they saturate the cores,","+ * so take whichever limit is lower. `TEST_WORKERS_COUNT` sets an exact count","+ * instead.","+ *","+ * @param {import('./index.d.mts').TestWorkerOptions} options","+ */","+export function testWorkerCount({ memoryPerWorkerGB, cpusPerWorker = 1, min = 1, max = Infinity }) {","+  // A fractional count makes Vitest start a fork with no pool id","+  const override = Math.floor(Number(process.env.TEST_WORKERS_COUNT));","+  if (override >= 1) {","+    return override;","+  }","+","+  const share = machineShare();","+  // The runner's main process needs a core of its own","+  const byCpu = Math.floor((availableParallelism() * share - 1) / cpusPerWorker);","+  const byMemory = Math.floor((usableMemory() * share) / (memoryPerWorkerGB * GB));","+","+  return Math.max(min, Math.min(max, byCpu, byMemory));","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"tools/configs/test-workers/package.json","lines":["@@ -0,0 +1,18 @@","+{","+  \"name\": \"@internal/cfg-test-workers\",","+  \"version\": \"private\",","+  \"private\": true,","+  \"description\": \"Shared worker count for Ghost's expensive test suites\",","+  \"license\": \"MIT\",","+  \"files\": [","+    \"index.mjs\",","+    \"index.d.mts\"","+  ],","+  \"type\": \"module\",","+  \"exports\": {","+    \".\": {","+      \"types\": \"./index.d.mts\",","+      \"default\": \"./index.mjs\"","+    }","+  }","+}",""],"additions":18,"deletions":0,"truncated":false}],"additions":116,"deletions":10,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-05T16:27:43.285780+00:00"}