oc","lines":["@@ -863,6 +863,10 @@ The default is `ANY`, which means both IPv4 and IPv6 addresses are considered va","         Supported data types::: `CharSequence`, `char[]`","         Hibernate metadata impact::: None"," ","+`@Alphabetic`:: Checks that every character of the annotated character sequence is a letter, as determined by `Character.isLetter(char)`. Any digit, whitespace, or punctuation character causes validation to fail. `null` values and empty character sequences are considered valid.","+        Supported data types::: `CharSequence`","+        Hibernate metadata impact::: None","+"," ===== Country specific constraints"," "," Hibernate Validator offers also some country specific constraints, e.g. for the validation of social"],"additions":4,"deletions":0,"truncated":false},{"path":"documentation/src/main/asciidoc/whats-new/index.adoc","lines":["@@ -74,6 +74,9 @@ Corresponding constraint definitions are also available for programmatic constra"," "," | `@PasswordStrength`, `@NotCompromised`, `@PasswordPolicy`"," | Checks password strength, exposure in data breaches, or a configurable set of password policy rules. See the next section for configuration requirements.","+","+| `@Alphabetic`","+| Checks that every character in a character sequence is a letter, as determined by `Character.isLetter(char)`."," |==="," "," `@NullOrNotBlank` and `@NullOrNotEmpty` are particularly useful for optional values:"],"additions":3,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/cfg/defs/AlphabeticDef.java","lines":["@@ -0,0 +1,24 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+","+package org.hibernate.validator.cfg.defs;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.cfg.ConstraintDef;","+import org.hibernate.validator.constraints.Alphabetic;","+","+/**","+ * Constraint definition for {@link Alphabetic}.","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Incubating","+public class AlphabeticDef extends ConstraintDef<AlphabeticDef, Alphabetic> {","+","+\tpublic AlphabeticDef() {","+\t\tsuper( Alphabetic.class );","+\t}","+}"],"additions":24,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/constraints/Alphabetic.java","lines":["@@ -0,0 +1,59 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.constraints;","+","+import static java.lang.annotation.ElementType.ANNOTATION_TYPE;","+import static java.lang.annotation.ElementType.CONSTRUCTOR;","+import static java.lang.annotation.ElementType.FIELD;","+import static java.lang.annotation.ElementType.METHOD;","+import static java.lang.annotation.ElementType.PARAMETER;","+import static java.lang.annotation.ElementType.TYPE_USE;","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+import java.lang.annotation.Documented;","+import java.lang.annotation.Repeatable;","+import java.lang.annotation.Retention;","+import java.lang.annotation.Target;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.constraints.Alphabetic.List;","+","+/**","+ * The annotated element must contain only letters, i.e. every character must satisfy","+ * {@link Character#isLetter(char)}. Any digit, whitespace, or punctuation character causes","+ * validation to fail.","+ * <p>","+ * {@code null} values and empty character sequences are considered valid.","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Documented","+@Constraint(validatedBy = { })","+@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+@Retention(RUNTIME)","+@Repeatable(List.class)","+@Incubating","+public @interface Alphabetic {","+","+\tString message() default \"{org.hibernate.validator.constraints.Alphabetic.message}\";","+","+\tClass<?>[] groups() default { };","+","+\tClass<? extends Payload>[] payload() default { };","+","+\t/**","+\t * Defines several {@code @Alphabetic} annotations on the same element.","+\t */","+\t@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+\t@Retention(RUNTIME)","+\t@Documented","+\tpublic @interface List {","+\t\tAlphabetic[] value();","+\t}","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/constraintvalidators/hv/AlphabeticValidator.java","lines":["@@ -0,0 +1,33 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.internal.constraintvalidators.hv;","+","+import jakarta.validation.ConstraintValidator;","+import jakarta.validation.ConstraintValidatorContext;","+","+import org.hibernate.validator.constraints.Alphabetic;","+","+/**","+ * Checks that the character sequence contains only letters.","+ *","+ * @author Andrea Boriero","+ */","+public class AlphabeticValidator implements ConstraintValidator<Alphabetic, CharSequence> {","+","+\t@Override","+\tpublic boolean isValid(CharSequence value, ConstraintValidatorContext constraintValidatorContext) {","+\t\tif ( value == null ) {","+\t\t\treturn true;","+\t\t}","+","+\t\t// Every character must be a letter","+\t\tfor ( int i = 0; i < value.length(); i++ ) {","+\t\t\tif ( !Character.isLetter( value.charAt( i ) ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/BuiltinConstraint.java","lines":["@@ -106,7 +106,8 @@ enum BuiltinConstraint {"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_BITCOIN_ADDRESS( \"org.hibernate.validator.constraints.BitcoinAddress\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_NOT_COMPROMISED( \"org.hibernate.validator.constraints