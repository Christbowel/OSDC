{"id":"b423e413cae5c31ec98370dfd79ae8b483f3591e","axis":"silent","repo":"salvo-rs/salvo","sha":"b423e413cae5c31ec98370dfd79ae8b483f3591e","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -44,6 +44,9 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).","   with multiple separators, including after filesystem path normalization."," - Require OIDC discovery metadata to contain the exact configured issuer, and","   exclude JWKs whose declared use or key operations do not permit verification.","+- Make the default JWT header finder use the same methods and Authorization","+  header as `HeaderFinder::new`, instead of silently rejecting every token.","+"," - Exclude request query strings and client error URL contents from proxy failure","   logs while retaining the request method, path, and error type."," "],"additions":3,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/src/finder.rs","lines":["@@ -40,7 +40,7 @@ pub trait JwtTokenFinder: Send + Sync {"," /// // Custom configuration for specific methods"," /// let get_only = HeaderFinder::new().allowed_methods(vec![Method::GET]);"," /// ```","-#[derive(Eq, PartialEq, Clone, Default, Debug)]","+#[derive(Eq, PartialEq, Clone, Debug)]"," #[non_exhaustive]"," pub struct HeaderFinder {","     /// Allowed HTTP methods for which this finder should extract tokens.","@@ -50,6 +50,12 @@ pub struct HeaderFinder {","     /// List of headers names to check for Bearer tokens.","     pub header_names: Vec<HeaderName>,"," }","+impl Default for HeaderFinder {","+    fn default() -> Self {","+        Self::new()","+    }","+}","+"," impl HeaderFinder {","     /// Creates a new `HeaderFinder`.","     #[inline]"],"additions":7,"deletions":1,"truncated":false},{"path":"crates/jwt-auth/tests/header_finder_default.rs","lines":["@@ -0,0 +1,54 @@","+use jsonwebtoken::{EncodingKey, Header};","+use salvo_core::http::Method;","+use salvo_core::prelude::*;","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_jwt_auth::{","+    ConstDecoder, HeaderFinder, JwtAuth, JwtAuthDepotExt, install_crypto_provider,","+};","+use serde::{Deserialize, Serialize};","+","+#[derive(Clone, Deserialize, Serialize)]","+struct Claims {","+    sub: String,","+    exp: u64,","+}","+","+#[handler]","+async fn identity(depot: &mut Depot) -> String {","+    depot.jwt_auth_data::<Claims>().unwrap().claims.sub.clone()","+}","+","+#[tokio::test]","+async fn default_header_finder_authenticates_like_new() {","+    let _ = install_crypto_provider();","+    let token = jsonwebtoken::encode(","+        &Header::default(),","+        &Claims {","+            sub: \"alice\".into(),","+            exp: u64::MAX,","+        },","+        &EncodingKey::from_secret(b\"test-secret\"),","+    )","+    .unwrap();","+","+    for finder in [HeaderFinder::new(), HeaderFinder::default()] {","+        let auth: JwtAuth<Claims, _> =","+            JwtAuth::new(ConstDecoder::from_secret(b\"test-secret\")).finders(vec![Box::new(finder)]);","+        let service = Service::new(Router::new().hoop(auth).goal(identity));","+        for method in [Method::GET, Method::POST, Method::QUERY] {","+            let mut response = salvo_core::test::RequestBuilder::new(\"http://localhost/\", method)","+                .add_header(\"authorization\", format!(\"Bearer {token}\"), true)","+                .send(&service)","+                .await;","+            assert_eq!(response.status_code, Some(StatusCode::OK));","+            assert_eq!(response.take_string().await.unwrap(), \"alice\");","+        }","+        let response = TestClient::get(\"http://localhost/\").send(&service).await;","+        assert_eq!(response.status_code, Some(StatusCode::UNAUTHORIZED));","+        let response = TestClient::get(\"http://localhost/\")","+            .add_header(\"proxy-authorization\", format!(\"Bearer {token}\"), true)","+            .send(&service)","+            .await;","+        assert_eq!(response.status_code, Some(StatusCode::UNAUTHORIZED));","+    }","+}",""],"additions":54,"deletions":0,"truncated":false}],"additions":64,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-29T15:20:45.955436+00:00"}