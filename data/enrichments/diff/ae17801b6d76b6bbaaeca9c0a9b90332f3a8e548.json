h64/riscv64:","                     // We convert the TLS access to the optimized helper where we will store","                     // the static blocks in TLS directly and access them via inline code.","+                    // The _OPTIMIZED helpers share their implementation with the _NOCTOR_OPTIMIZED ones;","+                    // only the JIT's model differs, since they may run the class constructor.","                     if ((pResult->helper == CORINFO_HELP_GET_NONGCTHREADSTATIC_BASE_NOCTOR) ||","-                        (pResult->helper == CORINFO_HELP_GET_NONGCTHREADSTATIC_BASE) ||","-                        (pResult->helper == CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_NOCTOR) ||","-                        (pResult->helper == CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE))","+                        (pResult->helper == CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_NOCTOR))","                     {","                         fieldAccessor = CORINFO_FIELD_STATIC_TLS_MANAGED;","                         pResult->helper = CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_NOCTOR_OPTIMIZED;","@@ -1449,14 +1449,24 @@ void CEEInfo::getFieldInfo (CORINFO_RESOLVED_TOKEN * pResolvedToken,","                             pResult->helper = CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_NOCTOR_OPTIMIZED2;","                         }","                     }","+                    else if ((pResult->helper == CORINFO_HELP_GET_NONGCTHREADSTATIC_BASE) ||","+                             (pResult->helper == CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE))","+                    {","+                        fieldAccessor = CORINFO_FIELD_STATIC_TLS_MANAGED;","+                        pResult->helper = CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_OPTIMIZED;","+                    }","                     else if ((pResult->helper == CORINFO_HELP_GET_GCTHREADSTATIC_BASE_NOCTOR) ||","-                            (pResult->helper == CORINFO_HELP_GET_GCTHREADSTATIC_BASE) ||","-                            (pResult->helper == CORINFO_HELP_GETDYNAMIC_GCTHREADSTATIC_BASE_NOCTOR) ||","-                            (pResult->helper == CORINFO_HELP_GETDYNAMIC_GCTHREADSTATIC_BASE))","+                             (pResult->helper == CORINFO_HELP_GETDYNAMIC_GCTHREADSTATIC_BASE_NOCTOR))","                     {","                         fieldAccessor = CORINFO_FIELD_STATIC_TLS_MANAGED;","                         pResult->helper = CORINFO_HELP_GETDYNAMIC_GCTHREADSTATIC_BASE_NOCTOR_OPTIMIZED;","                     }","+                    else if ((pResult->helper == CORINFO_HELP_GET_GCTHREADSTATIC_BASE) ||","+                             (pResult->helper == CORINFO_HELP_GETDYNAMIC_GCTHREADSTATIC_BASE))","+                    {","+                        fieldAccessor = CORINFO_FIELD_STATIC_TLS_MANAGED;","+                        pResult->helper = CORINFO_HELP_GETDYNAMIC_GCTHREADSTATIC_BASE_OPTIMIZED;","+                    }","                     else if (pResult->helper == CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_NOCTOR_OPTIMIZED2_NOJITOPT)","                     {","                         pResult->helper = CORINFO_HELP_GETDYNAMIC_NONGCTHREADSTATIC_BASE_NOCTOR_OPTIMIZED2;"],"additions":16,"deletions":6,"truncated":false},{"path":"src/tests/JIT/Regression_ro_2/Runtime_136480.cs","lines":["@@ -0,0 +1,108 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+namespace Runtime_136480;","+","+using System;","+using System.Runtime.CompilerServices;","+using Xunit;","+","+// The first access to a [ThreadStatic] field of a class that is not yet initialized may run","+// its static constructor, which can modify the heap. A read after the access must observe that effect.","+public static class Runtime_136480","+{","+    static int s_counter;","+","+    class PreciseInt","+    {","+        [ThreadStatic] public static int T;","+        static PreciseInt() { s_counter++; }","+    }","+","+    class PreciseRef","+    {","+        [ThreadStatic] public static object T;","+        static PreciseRef() { s_counter++; }","+    }","+","+    class PreciseLoop","+    {","+        [ThreadStatic] public static int T;","+        static PreciseLoop() { s_counter++; }","+    }","+","+    class BeforeFieldInitInt","+    {","+        [ThreadStatic] public static int T;","+        public static int Init = ++s_counter;","+    }","+","+    class BeforeFieldInitRef","+    {","+        [ThreadStatic] public static object T;","+        public static int Init = ++s_counter;","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining | MethodImplOptions.AggressiveOptimization)]","+    static (int, int, int) TestPreciseInt()","+    {","+        int before = s_counter;","+        int t = PreciseInt.T;","+        return (before, t, s_counter);","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining | MethodImplOptions.AggressiveOptimization)]","+    static (int, object, int) TestPreciseRef()","+    {","+        int before = s_counter;","+        object t = PreciseRef.T;","+        return (before, t, s_counter);","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining | MethodImplOptions.AggressiveOptimization)]","+    static (int, int, int) TestPreciseLoop()","+    {","+        int before = s_counter;","+        int sum = 0;","+        for (int i = 0; i < 3; i++)","+        {","+            sum += PreciseLoop.T;","+        }","+        return (before, sum, s_counter);","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining | MethodImplOptions.AggressiveOptimization)]","+    static (int, int, int) TestBeforeFieldInitInt()","+    {","+        int before = s_counter;","+        int t = BeforeFieldInitInt.T;","+        return (before, t, s_counter);","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining | MethodImplOptions.AggressiveOptimization)]","+    static (int, object, int) TestBeforeFieldInitRef()","+    {","+        int before = s_counter;","+        object t = BeforeFieldInitRef.T;","+        return (before, t, s_counter);","+    }","+","+    [Fact]","+    [ActiveIssue(\"https://github.com/dotnet/runtime/issues/136592\", TestRuntimes.Mono)]","+    public static void TestEntryPoint()","+    {","+        // Each case runs its own class constructor exactly once, so the counter advances by one per case.","+        Assert.Equal((0, 0, 1), TestPreciseInt());","+        Assert.Equal((1, null, 2), TestPreciseRef());","+        Assert.Equal((2, 0, 3), TestPreciseLoop());","+","+        // beforefieldinit constructors may run before the method does, so only the final value is fixed.","+        var (_, intValue, intCounter) = TestBeforeFieldInitInt();","+        Assert.Equal(0, intValue);","+        Assert.Equal(4, intCounter);","+","+        var (_, refValue, refCounter) = TestBeforeFieldInitRef();","+        Assert.Null(refValue);","+        Assert.Equal(5, refCounter);","+    }","+}",""],"additions":108,"deletions":0,"truncated":false}],"additions":161,"deletions":13,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-29T15:20:54.099081+00:00"}