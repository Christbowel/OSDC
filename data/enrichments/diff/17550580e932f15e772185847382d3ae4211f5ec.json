{"id":"17550580e932f15e772185847382d3ae4211f5ec","axis":"silent","repo":"vllm-project/vllm","sha":"17550580e932f15e772185847382d3ae4211f5ec","parsed":{"files":[{"path":".buildkite/test-amd.yaml","lines":["@@ -4870,6 +4870,34 @@ steps:","   # PLE and QSA import conflicting HC registrations in a shared process.","   - pytest -v -s models/qwen4_exp/test_ple.py"," ","+- label: \":amd: (MI355 DPX) Step5\"","+  timeout_in_minutes: 30","+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]","+  dind: false","+  agent_pool: mi355_dpx","+  num_gpus: 1","+  optional: true","+  working_dir: \"/vllm-workspace/tests\"","+  source_file_dependencies:","+  - vllm/models/step5/","+  - tests/models/step5/","+  - vllm/model_executor/models/step3p7.py","+  - vllm/model_executor/models/step3_vl.py","+  - vllm/model_executor/models/step_vl.py","+  - vllm/config/compilation.py","+  - vllm/model_executor/layers/indexer_topk.py","+  - vllm/transformers_utils/configs/step5.py","+  - vllm/model_executor/warmup/step5_dsa_warmup.py","+  - vllm/v1/attention/backends/rocm_aiter_unified_attn.py","+  - vllm/triton_utils/","+  - vllm/platforms/rocm.py","+  - tests/v1/attention/utils.py","+  - tests/models/test_initialization.py","+  - tests/models/registry.py","+  commands:","+  - pytest -v -s models/step5","+  - pytest -v -s models/test_initialization.py -k Step5ForConditionalGeneration","+"," - label: \":amd: (MI355 DPX) GLM5Next\"","   timeout_in_minutes: 35","   mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]"],"additions":28,"deletions":0,"truncated":false},{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -292,8 +292,37 @@ steps:","   source_file_dependencies:","   - vllm/models/step5/","   - tests/models/step5/","+  - vllm/model_executor/warmup/step5_dsa_warmup.py","   commands:","     - pytest -v -s models/step5","+  mirror:","+    amd:","+      label: \":amd: (MI355 DPX) Step5\"","+      dind: false","+      device: mi355_dpx","+      timeout_in_minutes: 30","+      working_dir: \"/vllm-workspace/tests\"","+      depends_on:","+      - image-build-amd","+      source_file_dependencies:","+      - vllm/models/step5/","+      - tests/models/step5/","+      - vllm/model_executor/models/step3p7.py","+      - vllm/model_executor/models/step3_vl.py","+      - vllm/model_executor/models/step_vl.py","+      - vllm/config/compilation.py","+      - vllm/model_executor/layers/indexer_topk.py","+      - vllm/transformers_utils/configs/step5.py","+      - vllm/model_executor/warmup/step5_dsa_warmup.py","+      - vllm/v1/attention/backends/rocm_aiter_unified_attn.py","+      - vllm/triton_utils/","+      - vllm/platforms/rocm.py","+      - tests/v1/attention/utils.py","+      - tests/models/test_initialization.py","+      - tests/models/registry.py","+      commands:","+        - pytest -v -s models/step5","+        - pytest -v -s models/test_initialization.py -k Step5ForConditionalGeneration"," "," - label: \":nvidia: (H200) GLM5Next\"","   key: glm5next-unit-tests"],"additions":29,"deletions":0,"truncated":false},{"path":"docs/models/supported_models.md","lines":["@@ -731,6 +731,13 @@ Some models are supported only via the [Transformers modeling backend](#transfor","     `NemotronH_Omni_Reasoning_V3` checkpoints load without `--trust-remote-code`","     on `transformers>=5.18.0`; older versions still require the flag."," ","+!!! note","+    On ROCm, `Step5ForConditionalGeneration` runs its MoE layers on Triton. With","+    `VLLM_ROCM_USE_AITER=1`, also pass `--moe-backend triton`: AITER's MoE does not","+    apply Step-5's SwiGLU clamp. An FP8 KV cache (`--kv-cache-dtype fp8`) needs","+    `--block-size 32`. The checkpoint ships three MTP layers, enabled with","+    `--speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":3}'`.","+"," !!! note","     The official `openbmb/MiniCPM-V-2` doesn't work yet, so we need to use a fork (`HwwwH/MiniCPM-V-2`) for now.","     For more details, please see: <https://github.com/vllm-project/vllm/pull/4087#issuecomment-2250397630>"],"additions":7,"deletions":0,"truncated":false},{"path":"tests/config/test_step5_mtp_config.py","lines":["@@ -0,0 +1,32 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+import pytest","+from transformers import PreTrainedConfig","+","+from vllm.config.speculative import SpeculativeConfig","+","+","+@pytest.mark.parametrize(\"model_type\", [\"step5\", \"step5_vl\"])","+def test_step5_mtp_hf_config_override(model_type: str):","+    text = PreTrainedConfig(","+        architectures=[\"Step5ForCausalLM\"],","+        num_hidden_layers=92,","+        num_nextn_predict_layers=3,","+    )","+    text.model_type = \"step5\"","+    if model_type == \"step5_vl\":","+        config = PreTrainedConfig(","+            architectures=[\"Step5ForConditionalGeneration\"], text_config=text","+        )","+        config.model_type = \"step5_vl\"","+    else:","+        config = text","+    config.quantization_config = {\"quant_method\": \"fp8\"}","+","+    overridden = SpeculativeConfig.hf_config_override(config)","+","+    assert overridden.model_type == \"step5_mtp\"","+    assert overridden.architectures == [\"Step5MTP\"]","+    assert overridden.n_predict == 3","+    assert overridden.quantization_config == {\"quant_method\": \"fp8\"}"],"additions":32,"deletions":0,"truncated":false},{"path":"tests/models/step5/test_amd_csa_metadata.py","lines":["@@ -0,0 +1,80 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Step-5 CSA per-step metadata on ROCm.\"\"\"","+","+from types import SimpleNamespace","+","+import pytest","+import torch","+","+from tests.v1.attention.utils import BatchSpec, create_common_attn_metadata","+from vllm.models.step5.amd.csa_cache import Step5CSAMetadataBuilder","+from vllm.platforms import current_platform","+","+REGION = 8","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_rocm(), reason=\"Step5 CSA metadata is the ROCm path\"","+)","+","+","+def _builder(num_speculative_tokens: int | None = None) -> Step5CSAMetadataBuilder:","+    config = SimpleNamespace(","+        model_config=SimpleNamespace(","+            hf_text_config=SimpleNamespace(","+                sparse_config=SimpleNamespace(region_block_size=REGION, topk=512)","+            )","+        ),","+        scheduler_config=SimpleNamespace(max_num_batched_tokens=64),","+        speculative_config=(","+            None","+            if num_speculative_tokens is None","+            else SimpleNamespace(num_speculative_tokens=num_speculative_tokens)","+        ),","+    )","+    return Step5CSAMetadataBuilder(SimpleNamespace(), [], config, torch.device(\"cuda\"))","+","+","+def test_builder_positions_fallback():","+    \"\"\"Spec-decode metadata carries no positions; the builder must derive them.\"\"\"","+    spec = BatchSpec(seq_lens=[40, 9, 130], query_lens=[4, 9, 1])","+    m = create_common_attn_metadata(spec, block_size=16, device=torch.device(\"cuda\"))","+    assert m.positions is None","+    builder = _builder()","+    md = builder.build(0, m)","+    assert md.positions is not None and md.token_req is not None","+","+    want_pos = [","+        p for s, q in zip(spec.seq_lens, spec.query_lens) for p in range(s - q, s)","+    ]","+    want_req = [r for r, q in enumerate(spec.query_lens) for _ in range(q)]","+    assert md.positions.tolist() == want_pos","+    assert md.token_req.tolist() == want_req","+","+","+def test_builder_plans_prefill_only_for_decode_or_mtp_verify():","+    \"\"\"Equal-length prefills are not mistaken for decode or MTP verification.\"\"\"","+    prefill = BatchSpec(seq_lens=[9, 9], query_lens=[9, 9])","+    md = _builder().build(","+        0, create_common_attn_metadata(prefill, 16, device=torch.device(\"cuda\"))","+    )","+    assert md.prefill_groups is not None and md.prefill_groups.shape == (18, 10)","+","+    decode = BatchSpec(seq_lens=[40, 9, 130], query_lens=[1, 1, 1])","+    md = _builder().build(","+        0, create_common_attn_metadata(decode, 16, device=torch.device(\"cuda\"))","+    )","+    assert md.prefill_groups is None","+","+    mtp = BatchSpec(seq_lens=[40, 9, 130], query_lens=[4, 4, 4])","+    md = _builder(num_speculative_tokens=3).build(","+        0, create_common_attn_metadata(mtp, 16, device=torch.device(\"cuda\"))","+    )","+    assert md.prefill_groups is None","+","+    mixed = BatchSpec(seq_lens=[40, 9, 130], query_lens=[1, 9, 1])","+    md = _builder().build(","+        0, create_common_attn_metadata(mixed, 16, device=torch.device(\"cuda\"))","+    )","+    assert md.prefill_groups is not None and md.prefill_groups.shape == (11, 10)","+    assert md.prefill_indexer is None  # 17 regions fit in top-k"],"additions":80,"deletions":0,"truncated":false},{"path":"tests/models/step5/test_amd_csa_paged.py","lines":["@@ -0,0 +1,258 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Paged Step-5 CSA kernels vs PyTorch references on scrambled block tables.","+","+Each test mixes requests with their own block-table rows, and prefill, chunked","+prefill and decode rows, since a page- or request-addressing bug reads wrong","+tokens without changing any shape.","+\"\"\"","+","+import pytest","+import torch","+","+from vllm.models.step5.amd.ops.csa_paged import sparse_attention_paged","+from vllm.models.step5.common.ops.sparse_decode_attention import (","+    sparse_decode_attention,","+)","+from vllm.models.step5.common.ops.sparse_indexer import select_regions","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_rocm(), reason=\"Step5 CSA kernels are the ROCm path\"","+)","+","+DEVICE = \"cuda\"","+REGION = 8","+PROXY = 256","+","+","+def _paged(","+    seqs: list[torch.Tensor], rows_per_page: int","+) -> tuple[torch.Tensor, torch.Tensor]:","+    \"\"\"Scatter each request's rows into shared pages behind its own row of a","+    shuffled ``[requests, pages]`` block table.\"\"\"","+    pages = [-(-x.shape[0] // rows_per_page) for x in seqs]","+    perm = torch.randperm(sum(pages) + 3, device=DEVICE).int()","+    table = torch.zeros(len(seqs), max(pages), dtype=torch.int32, device=DEVICE)","+    cache = torch.zeros(","+        (sum(pages) + 3, rows_per_page, *seqs[0].shape[1:]),","+        dtype=seqs[0].dtype,","+        device=DEVICE,","+    )","+    start = 0","+    for r, (x, n) in enumerate(zip(seqs, pages)):","+        table[r, :n] = perm[start : start + n]","+        start += n","+        idx = torch.arange(x.shape[0], device=DEVICE)","+        cache[table[r, idx // rows_per_page].long(), idx % rows_per_page] = x","+    return cache, table","+","+","+def ref_select(scores: torch.Tensor, positions: torch.Tensor, topk: int):","+    tokens, groups, _ = scores.shape","+    out = torch.full((tokens, groups, topk + 1), -1, dtype=torch.int32)","+    for t in range(tokens):","+        own = int(positions[t]) // REGION","+        for g in range(groups):","+            order = torch.argsort(-scores[t, g, :own].cpu(), stable=True)[:topk]","+            row = torch.cat([torch.sort(order).values, torch.tensor([own])])","+            out[t, g, -row.numel() :] = row.to(torch.int32)","+    return out","+","+","+def ref_attention(q, k, v, regions, req, positions, scale):","+    tokens, heads, _ = q.shape","+    groups = k.shape[2]","+    per_group = heads // groups","+    out = torch.zeros(q.shape, dtype=torch.float32)","+    for t in range(tokens):","+        kr, vr = k[int(req[t])], v[int(req[t])]","+        for g in range(groups):","+            ids = regions[t, g]","+            ids = ids[ids >= 0].long().cpu()","+            cols = (ids[:, None] * REGION + torch.arange(REGION)).flatten()","+            cols = cols[cols <= int(positions[t])]","+            hs = slice(g * per_group, (g + 1) * per_group)","+            p = torch.softmax(","+                q[t, hs].float().cpu() @ kr[cols, g].float().cpu().T * scale, -1","+            )","+            out[t, hs] = p @ vr[cols, g].float().cpu()","+    return out","+","+","+def test_select_regions_breaks_ties_by_region_id():","+    \"\"\"Post-ReLU scores are often exactly zero; ties must pick lower ids.\"\"\"","+    torch.manual_seed(0)","+    scores = torch.randn(48, 2, 40, device=DEVICE)","+    scores[scores.abs() < 0.5] = 0.0","+    positions = torch.randint(0, 40 * REGION, (48,), device=DEVICE)","+    own = (positions // REGION).repeat_interleave(2)","+    got = select_regions(scores.flatten(0, 1), own, 6, \"per_row\").view(48, 2, -1)","+    want = ref_select(scores, positions, 6)","+    for g, w in zip(got.cpu(), want):","+        for gg, ww in zip(g, w):","+            assert sorted(gg[gg >= 0].tolist()) == sorted(ww[ww >= 0].tolist())","+","+","+FP8_KV = [None, torch.float8_e4m3fn, torch.float8_e4m3fnuz]","+","+","+def _quant_kv(k, v, kv_dtype):","+    \"\"\"KV as stored (FP8 with per-tensor scales, or BF16) and as the reference","+    sees it.\"\"\"","+    if kv_dtype is None:","+        return k, v, k, v, None, None","+    k_s, v_s = 0.5, 2.0","+    fmax = torch.finfo(kv_dtype).max","+    kq = (k.float() / k_s).clamp(-fmax, fmax).to(kv_dtype)","+    vq = (v.float() / v_s).clamp(-fmax, fmax).to(kv_dtype)","+    scales = [torch.tensor([x], dtype=torch.float32, device=DEVICE) for x in (k_s, v_s)]","+    return kq, vq, kq.float() * k_s, vq.float() * v_s, *scales","+","+","+@pytest.mark.parametrize(\"kv_dtype\", FP8_KV)","+@pytest.mark.parametrize(\"topk\", [6, 512])","+def test_sparse_attention_paged(topk: int, kv_dtype):","+    \"\"\"topk=512 covers the whole history, so it also checks dense equivalence.\"\"\"","+    torch.manual_seed(0)","+    seq_len, heads, groups, dim = 203, 16, 4, 192","+    shape = (2, seq_len, groups, dim)","+    k = torch.randn(shape, dtype=torch.bfloat16, device=DEVICE)","+    v = torch.randn(shape, dtype=torch.bfloat16, device=DEVICE)","+    kq, vq, k, v, k_scale, v_scale = _quant_kv(k, v, kv_dtype)","+    # Request 0 starts at a nonzero position to exercise chunked-prefill","+    # addressing independently of the packed query row.","+    pos = torch.cat([torch.arange(37, seq_len), torch.tensor([202])]).int().to(DEVICE)","+    req = torch.tensor([0] * (seq_len - 37) + [1], dtype=torch.int32, device=DEVICE)","+    q = torch.randn(len(pos), heads, dim, dtype=torch.bfloat16, device=DEVICE)","+    scores = torch.randn(len(pos), groups, seq_len // REGION + 1, device=DEVICE)","+    regions = ref_select(scores, pos, topk).to(DEVICE)","+","+    kv_cache, bt = _paged([torch.stack([kq[r], vq[r]], 1) for r in range(2)], 64)","+    got = torch.empty_like(q)","+    sparse_attention_paged(","+        q,","+        kv_cache[:, :, 0],","+        kv_cache[:, :, 1],","+        regions,","+        bt,","+        req,","+        pos,","+        got,","+        region_size=REGION,","+        scale=dim**-0.5,","+        k_scale=k_scale,","+        v_scale=v_scale,","+    )","+    want = ref_attention(q, k, v, regions, req, pos, dim**-0.5)","+    torch.testing.assert_close(got.float().cpu(), want, atol=2e-2, rtol=2e-2)","+","+","+@pytest.mark.parametrize(\"kv_dtype\", FP8_KV)","+def test_sparse_decode_attention(kv_dtype):","+    \"\"\"MTP verify rows use each request's pages, live tail, and headwise gate.\"\"\"","+    torch.manual_seed(0)","+    seq_len, heads, groups, dim, topk, query_len = 203, 16, 4, 192, 32, 4","+    shape = (2, seq_len, groups, dim)","+    k = torch.randn(shape, dtype=torch.bfloat16, device=DEVICE)","+    v = torch.randn(shape, dtype=torch.bfloat16, device=DEVICE)","+    kq, vq, k, v, k_scale, v_scale = _quant_kv(k, v, kv_dtype)","+    pos = torch.tensor(","+        [31, 32, 33, 34, seq_len - 12, seq_len - 11, seq_len - 10, seq_len - 9],","+        dtype=torch.int32,","+        device=DEVICE,","+    )","+    req = torch.arange(2, dtype=torch.int32, device=DEVICE).repeat_interleave(query_len)","+    q = torch.randn(len(pos), heads, dim, dtype=torch.bfloat16, device=DEVICE)","+    scores = torch.randn(len(pos), groups, seq_len // REGION + 1, device=DEVICE)","+    regions = ref_select(scores, pos, topk).to(DEVICE)","+    gate = torch.randn(len(pos), heads, device=DEVICE)","+","+    kv_cache, bt = _paged([torch.cat([kq[r], vq[r]], -1) for r in range(2)], 16)","+    got = torch.empty_like(q)","+    sparse_decode_attention(","+        q.view(len(pos) * groups, heads // groups, dim),","+        kv_cache.transpose(1, 2).contiguous(),","+        regions.view(len(pos) * groups, -1).long(),","+        bt,","+        pos.long().repeat_interleave(groups),","+        torch.ones(len(pos) * groups, dtype=torch.bool, device=DEVICE),","+        got.view(len(pos) * groups, heads // groups, dim),","+        scale=dim**-0.5,","+        query_len=query_len,","+        splits=4,","+        k_scale=k_scale,","+        v_scale=v_scale,","+        gate=gate,","+    )","+    want = ref_attention(q, k, v, regions, req, pos, dim**-0.5)","+    want *= torch.sigmoid(gate.float().cpu()).unsqueeze(-1)","+    torch.testing.assert_close(got.float().cpu(), want, atol=2e-2, rtol=2e-2)","+","+","+def test_summaries_on_coarse_summary_blocks():","+    \"\"\"ROCm keeps summaries in their own KV group, whose block (384 tokens,","+    48 regions) differs from the main 16-token block; summaries and decode","+    scores must match the main-block layout.\"\"\"","+    from vllm.models.step5.common.ops.sparse_indexer_scores import (","+        decode_summary_scores,","+    )","+    from vllm.models.step5.common.ops.summary_update import (","+        build_prefill_groups,","+        update_prefill,","+    )","+","+    torch.manual_seed(0)","+    seq, capacity = 1001, 12","+    regions = seq // REGION","+    key = torch.randn((seq, 1, PROXY), device=DEVICE).to(torch.bfloat16)","+    z = torch.randn((seq, 1, PROXY), device=DEVICE).to(torch.bfloat16)","+    positions = torch.arange(seq, device=DEVICE)","+    query = torch.randn((2, 1, 8, PROXY), device=DEVICE).to(torch.float8_e4m3fn)","+    weights = torch.rand((2, 1, 8), device=DEVICE)","+","+    def run(block: int):","+        blocks = -(-seq // block)","+        table = torch.randperm(blocks + 2, device=DEVICE)[:blocks].int()","+        mean = torch.zeros(","+            (blocks + 2, block // REGION, PROXY), dtype=torch.uint8, device=DEVICE","+        )","+        rows = torch.zeros((capacity, 2 * PROXY), dtype=torch.bfloat16, device=DEVICE)","+        slots = table[positions // block].long() * block + positions % block","+        groups = build_prefill_groups(","+            slots,","+            positions,","+            torch.zeros_like(positions),","+            torch.tensor([0, seq], device=DEVICE),","+        )","+        keep = positions >= seq - capacity","+        update_prefill(","+            key,","+            z,","+            groups,","+            positions,","+            torch.zeros_like(positions),","+            torch.where(keep, positions % capacity, -1),","+            mean,","+            rows,","+            capacity,","+        )","+        r = torch.arange(regions, device=DEVICE)","+        per_region = mean[table[r // mean.shape[1]].long(), r % mean.shape[1]]","+        scores, meta = decode_summary_scores(","+            query,","+            weights,","+            mean,","+            table[None].expand(2, -1).contiguous(),","+            slots[-1:].expand(2).contiguous(),","+            torch.tensor([seq, seq - 9], device=DEVICE),","+            regions,","+            num_sms=4,","+        )","+        return per_region, scores, meta.lengths","+","+    fine, fine_scores, lengths = run(16)","+    coarse, coarse_scores, _ = run(384)","+    assert fine.any() and torch.equal(fine, coarse)","+    for row, length in enumerate(lengths.tolist()):","+        assert torch.equal(fine_scores[row, :length], coarse_scores[row, :length])"],"additions":258,"deletions":0,"truncated":false},{"path":"tests/models/step5/test_amd_csa_warmup.py","lines":["@@ -0,0 +1,48 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The ROCm CSA layers reach the Step5 scored-prefill warmup.\"\"\"","+","+from types import SimpleNamespace","+from unittest.mock import MagicMock, patch","+","+import pytest","+","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_rocm(), reason=\"Step5 CSA is the ROCm path\"","+)","+","+","+def _worker(context):","+    return SimpleNamespace(","+        vllm_config=SimpleNamespace(","+            model_config=SimpleNamespace(","+                hf_text_config=SimpleNamespace(model_type=\"step5\")","+            ),","+            compilation_config=SimpleNamespace(static_forward_context=context),","+        )","+    )","+","+","+def test_step5_warmup_dispatches_rocm_csa_topk():","+    from vllm.model_executor.warmup.step5_dsa_warmup import step5_dsa_warmup","+    from vllm.models.step5.amd import warmup","+    from vllm.models.step5.amd.model import Step5Attention","+","+    def layer(indexer):","+        mock = MagicMock(indexer=indexer)","+        mock.__class__ = Step5Attention","+        return mock","+","+    sparse = layer(SimpleNamespace(topk=512))","+    dense = layer(None)","+    worker = _worker({\"swa\": dense, \"other\": object(), \"csa\": sparse})","+","+    with patch.object(warmup, \"run_step5_scored_prefill_warmup\") as run:","+        step5_dsa_warmup(worker)","+    run.assert_called_once_with(worker, 512)","+","+    with patch.object(warmup, \"run_step5_scored_prefill_warmup\") as run:","+        step5_dsa_warmup(_worker({\"swa\": dense}))","+    run.assert_not_called()"],"additions":48,"deletions":0,"truncated":false},{"path":"tests/models/step5/test_amd_fp8_kv_init.py","lines":["@@ -0,0 +1,48 @@","+