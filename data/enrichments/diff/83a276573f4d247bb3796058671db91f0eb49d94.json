   int hasCreateIndex = 0;","   int hasInitCoroutine = 0;","+  int hasProgram = 0;","   Op *pOp;","   VdbeOpIter sIter;"," ","@@ -819,17 +820,37 @@ int sqlite3VdbeAssertMayAbort(Vdbe *v, int mayAbort){","       hasFkCounter = 1;","     }"," #endif","+    if( opcode==OP_Program ){","+      hasProgram = 1;","+    }","   }","   sqlite3DbFree(v->db, sIter.apSub);"," ","-  /* Return true if hasAbort==mayAbort. Or if a malloc failure occurred.","-  ** If malloc failed, then the while() loop above may not have iterated","-  ** through all opcodes and hasAbort may be set incorrectly. Return","-  ** true for this case to prevent the assert() in the callers frame","-  ** from failing.  */","-  return ( v->db->mallocFailed || hasAbort==mayAbort || hasFkCounter","-        || (hasCreateTable && hasInitCoroutine) || hasCreateIndex","-  );","+  /* Return true if there is no problem, or false if there is. Determined","+  ** as follows:","+  ** ","+  **    1. If a malloc() failed, always return 1.","+  **","+  **    2. If hasAbort is set, then the statement contains an opcode that","+  **       can cause an abort. So this is an error if mayAbort==0, or a","+  **       pass if mayAbort is set. Just return mayAbort.","+  **","+  **    3. If the statement is a CREATE TABLE AS or a CREATE INDEX, then","+  **       also return mayAbort - same logic as in (2).","+  **","+  **    4. If hasFkCounter or hasProgram is set, it is not possible to tell","+  **       whether the statement may abort or not. So either value of mayAbort","+  **       is a pass. Just return 1.","+  **","+  **    5. Otherwise, mayAbort should be clear. Return true if it is, or ","+  **       false otherwise.","+  */","+  if( v->db->mallocFailed ) return 1;                           /* 1. */","+  if( hasAbort ) return mayAbort;                               /* 2. */","+  if( hasCreateIndex ) return mayAbort;                         /* 3. */","+  if( (hasCreateTable && hasInitCoroutine) ) return mayAbort;   /* 3. */","+  if( hasFkCounter || hasProgram ) return 1;                    /* 4. */","+  return !mayAbort;                                             /* 5. */"," }"," #endif /* SQLITE_DEBUG - the sqlite3AssertMayAbort() function */"," "],"additions":29,"deletions":8,"truncated":false},{"path":"src/window.c","lines":["@@ -1418,7 +1418,6 @@ void sqlite3WindowCodeInit(Parse *pParse, Select *pSelect){","   pMWin = pSelect->pWin;","   v = sqlite3GetVdbe(pParse);"," ","-  sqlite3MayAbort(pParse);","   sqlite3VdbeAddOp2(v, OP_OpenEphemeral, pMWin->iEphCsr, nEphExpr);","   sqlite3VdbeAddOp2(v, OP_OpenDup, pMWin->iEphCsr+1, pMWin->iEphCsr);","   sqlite3VdbeAddOp2(v, OP_OpenDup, pMWin->iEphCsr+2, pMWin->iEphCsr);","@@ -1769,6 +1768,7 @@ static void windowAggStep(","         pColl = sqlite3ExprNNCollSeq(pParse, pWin->pOwner->x.pList->a[0].pExpr);","         sqlite3VdbeAddOp4(v, OP_CollSeq, 0,0,0, (const char*)pColl, P4_COLLSEQ);","       }","+      sqlite3MayAbort(pParse);","       sqlite3VdbeAddOp3(v, bInverse? OP_AggInverse : OP_AggStep,","                         bInverse, regArg, pWin->regAccum);","       sqlite3VdbeAppendP4(v, pFunc, P4_FUNCDEF);","@@ -1815,6 +1815,7 @@ static void windowAggFinal(WindowCodeArg *p, int bFin){","       assert( pMWin->regStartRowid==0 );","     }else{","       int nArg = windowArgCount(pWin);","+      sqlite3MayAbort(pParse);","       if( bFin ){","         sqlite3VdbeAddOp2(v, OP_AggFinal, pWin->regAccum, nArg);","         sqlite3VdbeAppendP4(v, pWin->pWFunc, P4_FUNCDEF);"],"additions":2,"deletions":1,"truncated":false},{"path":"test/misc02.sql","lines":["@@ -1605,3 +1605,85 @@ SELECT schema, page_count FROM pragma_page_count;"," .testcase 2950"," SELECT schema, name FROM pragma_table_info('t1','temp');"," .check temp,x","+","+# Bug sqlite.org/bugs/forumpost/64e9d45f6f","+# A DELETE inside a transaction whose self-referencing ON DELETE CASCADE","+# chain fails with \"triggers nested too deep\" must be rolled back, as","+# it is in autocommit mode.","+#","+.open :memory:","+.mode list","+.testcase 3000","+PRAGMA foreign_keys=ON;","+CREATE TABLE t1(id INTEGER PRIMARY KEY, parent REFERENCES t1(id) ON DELETE CASCADE);","+INSERT INTO t1 VALUES(1,NULL);","+WITH RECURSIVE s(i) AS (SELECT 2 UNION ALL SELECT i+1 FROM s WHERE i<1200)","+  INSERT INTO t1 SELECT i, i-1 FROM s;","+BEGIN;","+DELETE FROM t1 WHERE id=1;","+.check -glob \"*rror near line *: triggers nested too deep*\"","+","+.testcase 3010","+SELECT count(*), min(id) FROM t1;","+PRAGMA foreign_key_check(t1);","+.check 1200|1","+","+.testcase 3020","+COMMIT;","+.check -glob \"*\"","+","+# Same again, but with a recursive AFTER DELETE trigger instead of an","+# ON DELETE CASCADE foreign key action.","+#","+.testcase 3100","+PRAGMA recursive_triggers=ON;","+CREATE TABLE t2(id INTEGER PRIMARY KEY, parent);","+INSERT INTO t2 VALUES(1,NULL);","+WITH RECURSIVE s(i) AS (SELECT 2 UNION ALL SELECT i+1 FROM s WHERE i<1200)","+  INSERT INTO t2 SELECT i, i-1 FROM s;","+CREATE TRIGGER t2d AFTER DELETE ON t2 BEGIN","+  DELETE FROM t2 WHERE parent=old.id;","+END;","+BEGIN;","+DELETE FROM t2 WHERE id=1;","+.check -glob \"*rror near line *: triggers nested too deep*\"","+","+.testcase 3110","+SELECT count(*), min(id) FROM t2;","+.check 1200|1","+","+.testcase 3120","+COMMIT;","+PRAGMA recursive_triggers=OFF;","+.check -glob \"*\"","+","+# Multi-write statements that use the first_value() window function.","+# sqlite3WindowCodeInit() calls sqlite3MayAbort(), but first_value() is","+# coded without OP_AggStep or any other opcode that sqlite3VdbeAssertMayAbort()","+# recognizes as able to abort, so the assert() in sqlite3FinishCoding()","+# fails in SQLITE_DEBUG builds.","+#","+.open :memory:","+.mode list","+.testcase 3200","+CREATE TABLE w1(a INTEGER PRIMARY KEY, b, c);","+INSERT INTO w1 VALUES(1,2,3),(4,5,6);","+CREATE TABLE w2(x, y);","+INSERT INTO w2 SELECT first_value(b) OVER (ORDER BY a), 1 FROM w1;","+SELECT * FROM w2;","+.check '2|1 2|1'","+","+.testcase 3210","+INSERT INTO w2 SELECT first_value(b) OVER (PARTITION BY c), 2 FROM w1;","+SELECT * FROM w2 WHERE y=2 ORDER BY x;","+.check '2|2 5|2'","+","+.testcase 3220","+UPDATE w1 SET c = (SELECT first_value(b) OVER () FROM w1 LIMIT 1);","+SELECT c FROM w1;","+.check '2 2'","+","+.testcase 3230","+DELETE FROM w1 WHERE a IN (SELECT first_value(a) OVER (ORDER BY b) FROM w1);","+SELECT a FROM w1;","+.check 4",""],"additions":82,"deletions":0,"truncated":false}],"additions":131,"deletions":20,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-17T18:46:56.975766+00:00"}