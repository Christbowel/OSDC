{"id":"5328ae2fefc42039c15e8ecae9aefb5587df8efd","axis":"silent","repo":"vllm-project/vllm","sha":"5328ae2fefc42039c15e8ecae9aefb5587df8efd","parsed":{"files":[{"path":".buildkite/test_areas/kernels.yaml","lines":["@@ -745,11 +745,14 @@ steps:","   - vllm/utils/deep_gemm.py","   - vllm/model_executor/layers/fused_moe","   - vllm/model_executor/layers/quantization","+  - vllm/model_executor/warmup/deep_gemm_warmup.py","   - tests/kernels/quantization/test_block_fp8.py","   - tests/kernels/moe/test_deepgemm.py","   - tests/kernels/moe/test_batched_deepgemm.py","   - tests/kernels/attention/test_deepgemm_attention.py","   - tests/quantization/test_cutlass_w4a16.py","+  - tests/model_executor/test_deep_gemm_warmup.py","+  - tests/kernels/moe/test_deep_gemm_mega_moe.py","   commands:","     - python3 ../tools/check_wheel_deepgemm.py","     - pytest -v -s kernels/quantization/test_block_fp8.py","@@ -757,6 +760,8 @@ steps:","     - pytest -v -s kernels/moe/test_batched_deepgemm.py","     - pytest -v -s kernels/attention/test_deepgemm_attention.py","     - pytest -v -s quantization/test_cutlass_w4a16.py","+    - pytest -v -s model_executor/test_deep_gemm_warmup.py","+    - pytest -v -s kernels/moe/test_deep_gemm_mega_moe.py -k fp8_block_sm90_matches_reference","   mirror:","     amd:","       automatic_shard: true"],"additions":5,"deletions":0,"truncated":false},{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -374,6 +374,7 @@ steps:","   device: h200_35gb","   source_file_dependencies:","   - vllm/models/glm5next/","+  - vllm/model_executor/layers/fused_moe/deep_gemm_mega_moe.py","   - tests/models/glm5next/","   - vllm/model_executor/layers/mamba/checkpoint.py","   commands:"],"additions":1,"deletions":0,"truncated":false},{"path":"cmake/external_projects/deepgemm.cmake","lines":["@@ -41,10 +41,11 @@ else()","   # FP8 x FP4 Mega MoE kernel (vllm-project/DeepGEMM#44) and the MegaMoE","   # combine-readiness fix under CUDA graph replay (vllm-project/DeepGEMM#59),","   # plus the SM90 paged-MQA metadata kernel compiled once for every batch size","-  # (vllm-project/DeepGEMM#63) and the SM90 mHC prenorm GEMM WGMMA register","-  # reuse fix (vllm-project/DeepGEMM#64).","+  # (vllm-project/DeepGEMM#63), the SM90 mHC prenorm GEMM WGMMA register","+  # reuse fix (vllm-project/DeepGEMM#64), and the SM90 FP8 Mega MoE kernel","+  # with 128x128 block scales (vllm-project/DeepGEMM#57).","   # Targets the PyTorch 2.11 stable ABI (requires PyTorch 2.14+ headers at build time) and CPython 3.10 limited API.","-  set(_DEEPGEMM_UPSTREAM_TAG \"e84cd4fb47361bd2cc4e296d1e1871126f030dab\")","+  set(_DEEPGEMM_UPSTREAM_TAG \"44cba7d28066182852005c59052f035ebc18e211\")"," ","   set(_deepgemm_fc_root \"${FETCHCONTENT_BASE_DIR}\")","   if(NOT _deepgemm_fc_root)"],"additions":4,"deletions":3,"truncated":false},{"path":"recipes/models/zai-org/GLM-5.3-Flash.yaml","lines":["@@ -4,13 +4,14 @@ meta:","   provider: \"GLM (Z-AI)\"","   description: \"GLM-5.3-Flash is a 320B-total / 18B-active multimodal MoE with hybrid KDA and sparse MLA attention, native FP8 weights, MTP, and a 1M-token context window.\"","   date_added: 2026-08-27","-  date_updated: 2026-11-05","+  date_updated: 2026-11-17","   tasks:","     - text","     - multimodal","   performance_headline: \"320B MoE with 18B active parameters and 1M-token context\"","   hardware:","     h100: verified","+    h200: verified","     b200: verified","     gb200: verified","     # FP8 TP4 with MTP, stock and latency_specialized decode, validated 2026-10","@@ -145,6 +146,20 @@ hardware_notes:","       `--additional-config '{\"decode_backend\":\"latency_specialized\"}'`. See the guide's","       GB300 section for the requirements."," ","+presets:","+  h200_dep_mega_moe:","+    label: \"Mega MoE\"","+    hardware: h200","+    strategy: single_node_dep","+    variants: [default]","+    description: \"Routed and shared FP8 experts in DeepGEMM Mega MoE. Needs TP1 (DP + EP). Text only.\"","+    source: { label: \"vLLM #66812\", href: \"https://github.com/vllm-project/vllm/pull/66812\" }","+    args:","+      - \"--moe-backend\"","+      - \"deep_gemm_mega_moe\"","+      - \"--limit-mm-per-prompt\"","+      - '{\"image\":0,\"video\":0}'","+"," strategy_overrides:","   pd_cluster:","     # KDA conv-state / KV-cache layouts must match on both pools for NIXL","@@ -261,6 +276,29 @@ guide: |","   `{\"decode_backend\":\"latency_specialized\",\"policy\":{\"boundary\":\"\"}}` runs the fused all-reduce +","   mHC boundary stock."," ","+  ### FP8 Mega MoE on H200 (DP + EP)","+","+  `--moe-backend deep_gemm_mega_moe` runs the FP8 routed and shared experts in one DeepGEMM","+  kernel ([vLLM #66812](https://github.com/vllm-project/vllm/pull/66812)). It needs DP + EP with","+  TP1 and is the opt-in **Mega MoE** preset of the **Data + Expert Parallel** strategy. On 8×H200","+  it served 22-44% more output tokens/s than the default MoE backend. It is text only for now:","+  with image or video input, H200 DP ranks fail encoder profiling. On 4 GPUs, also pass","+  `--max-num-seqs 948`.","+","+  ```bash","+  VLLM_USE_RUST_FRONTEND=1 vllm serve zai-org/GLM-5.3-Flash \\","+    --tokenizer-mode glm5_next \\","+    --data-parallel-size 8 \\","+    --enable-expert-parallel \\","+    --moe-backend deep_gemm_mega_moe \\","+    --limit-mm-per-prompt '{\"image\":0,\"video\":0}' \\","+    --disable-flashinfer-autotune \\","+    --tool-call-parser glm47 \\","+    --reasoning-parser glm47 \\","+    --enable-auto-tool-choice \\","+    --served-model-name zai-org/GLM-5.3-Flash","+  ```","+","   ### Prefill/Decode disaggregation (single node, TP4 + TP4)"," ","   Split one 8-GPU node into a prefill pool (GPUs 0-3) and a decode pool (GPUs 4-7),"],"additions":39,"deletions":1,"truncated":false},{"path":"tests/kernels/moe/test_deep_gemm_mega_moe.py","lines":["@@ -12,6 +12,7 @@"," "," from vllm.model_executor.layers.fused_moe.deep_gemm_mega_moe import (","     MEGA_MOE_BF16,","+    MEGA_MOE_FP8_BLOCK_SM90,","     MEGA_MOE_MXFP4,","     MEGA_MOE_MXFP4_SM90,","     MEGA_MOE_NVFP4,","@@ -1566,3 +1567,128 @@ def randn(*shape, fan_in):","     assert output.dtype == torch.bfloat16","     assert _calc_diff(output, expected) < 1e-3","     assert F.cosine_similarity(output.float(), expected, dim=-1).min() > 0.99","+","+","+def _block_fp8_checkpoint(n: int, k: int, device: torch.device):","+    \"\"\"Block-FP8 weight, its 128x128 scales (spread so a misplaced one shows)","+    and the dequantized weight.\"\"\"","+    weight = torch.randn(n, k, device=device).to(torch.float8_e4m3fn)","+    scale = (torch.rand(n // 128, k // 128, device=device) + 0.5) / k**0.5","+    full = scale.repeat_interleave(128, 0).repeat_interleave(128, 1)","+    return weight, scale, weight.float() * full","+","+","+@pytest.mark.skipif(","+    not (","+        has_sm90_mega_moe","+        and hasattr(_import_deep_gemm(), \"transform_fp8_block_sf_for_sm90_mega_moe\")","+    ),","+    reason=\"The SM90 block-FP8 MegaMoE kernel requires SM90 and DeepGEMM\",","+)","+@pytest.mark.parametrize(\"fuse_shared\", [False, True])","+@pytest.mark.parametrize(","+    \"act_name\",","+    [","+        name","+        for name, act in ACTIVATIONS.items()","+        if act.name in MEGA_MOE_FP8_BLOCK_SM90.activations","+    ],","+)","+def test_deep_gemm_mega_moe_fp8_block_sm90_matches_reference(","+    dist_init, act_name, fuse_shared","+):","+    \"\"\"A 128x128 block-FP8 checkpoint loaded through the GLM experts matches","+    the dequantized reference.\"\"\"","+    from vllm.models.glm5next.nvidia.mega_moe import Glm5NextMegaMoEExperts","+","+    fmt, act = MEGA_MOE_FP8_BLOCK_SM90, ACTIVATIONS[act_name]","+    torch.manual_seed(0)","+    device = torch.device(\"cuda\")","+    vllm_config = SimpleNamespace(","+        scheduler_config=SimpleNamespace(max_num_batched_tokens=NUM_TOKENS),","+        compilation_config=SimpleNamespace(static_forward_context={}),","+    )","+    with torch.device(device):","+        experts = Glm5NextMegaMoEExperts(","+            vllm_config,  # type: ignore[arg-type]","+            weight_block_size=(128, 128),","+            num_shared_experts=int(fuse_shared),","+            num_experts=NUM_EXPERTS,","+            num_local_experts=NUM_EXPERTS,","+            experts_start_idx=0,","+            top_k=TOP_K,","+            hidden_size=HIDDEN,","+            intermediate_size=INTER,","+            activation=act,","+            prefix=f\"model.layers.0.{fmt.name}.{act_name}.{fuse_shared}\",","+        )","+    assert experts.weight_format == fmt","+    assert experts.has_fused_shared_experts == fuse_shared","+","+    def shards(w13_ckpt, w2_ckpt):","+        \"\"\"`(shard_id, param name, weight, block scale)` of one expert.\"\"\"","+        (w13, s13, _), (w2, s2, _) = w13_ckpt, w2_ckpt","+        blocks = INTER // 128","+        return (","+            (\"w1\", \"w13\", w13[:INTER], s13[:blocks]),","+            (\"w3\", \"w13\", w13[INTER:], s13[blocks:]),","+            (\"w2\", \"w2\", w2, s2),","+        )","+","+    w13 = torch.empty(NUM_EXPERTS, 2 * INTER, HIDDEN, device=device)","+    w2 = torch.empty(NUM_EXPERTS, HIDDEN, INTER, device=device)","+    for e in range(NUM_EXPERTS):","+        w13_ckpt = _block_fp8_checkpoint(2 * INTER, HIDDEN, device)","+        w2_ckpt = _block_fp8_checkpoint(HIDDEN, INTER, device)","+        w13[e], w2[e] = w13_ckpt[2], w2_ckpt[2]","+        for shard_id, name, weight, scale in shards(w13_ckpt, w2_ckpt):","+            for suffix, tensor in ((\"weight\", weight), (\"weight_scale_inv\", scale)):","+                param = getattr(experts, f\"{name}_{suffix}\")","+                assert experts.weight_loader(","+                    param,","+                    tensor,","+                    f\"experts.{name}_{suffix}\",","+                    shard_id=shard_id,","+                    expert_id=e,","+                    return_success=True,","+                )","+","+    shared_ckpt = (","+        _block_fp8_checkpoint(2 * INTER, HIDDEN, device),","+        _block_fp8_checkpoint(HIDDEN, INTER, device),","+    )","+    reference_shared = _ReferenceSharedExpert(","+        shared_ckpt[0][2], shared_ckpt[1][2], fmt.hidden_quant, act","+    )","+    if fuse_shared:","+        projs = {\"w1\": \"gate_proj\", \"w3\": \"up_proj\", \"w2\": \"down_proj\"}","+        for shard_id, _, weight, scale in shards(*shared_ckpt):","+            prefix = f\"mlp.shared_experts.{projs[shard_id]}\"","+            experts.load_shared_expert_weight(f\"{prefix}.weight\", weight)","+            experts.load_shared_expert_weight(f\"{prefix}.weight_scale_inv\", scale)","+    experts.finalize_block_fp8_weights()","+","+    hidden_states = torch.randn(NUM_TOKENS, HIDDEN, device=device).bfloat16()","+    scores = torch.randn(NUM_TOKENS, NUM_EXPERTS, device=device)","+    topk_weights, topk_ids = torch.topk(scores.softmax(-1), TOP_K, dim=-1)","+","+    output = experts(","+        hidden_states,","+        topk_weights,","+        topk_ids,","+        None if fuse_shared else reference_shared,","+    )","+","+    x = _round_trip(hidden_states.float(), fmt.hidden_quant)","+    expected = reference_shared(hidden_states).float()","+    for e in range(NUM_EXPERTS):","+        token, slot = (topk_ids == e).nonzero(as_tuple=True)","+        expected.index_add_(","+            0,","+            token,","+            _expert(x[token], w13[e], w2[e], topk_weights[token, slot], fmt, act, 1.0),","+        )","+","+    assert output.dtype == torch.bfloat16","+    assert _calc_diff(output, expected) < 1e-3","+    assert F.cosine_similarity(output.float(), expected, dim=-1).min() > 0.99"],"additions":126,"deletions":0,"truncated":false},{"path":"tests/model_executor/test_deep_gemm_warmup.py","lines":["@@ -97,16 +97,17 @@ def test_kernel_registers_itself_as_warmup_provider(is_bmm) -> None:"," "," def test_mega_moe_predicate_matches_only_native_mega_moe_layers(monkeypatch) -> None:","     \"\"\"Without the MegaMoE model modules loaded, nothing matches and nothing is","-    imported; with them loaded, only DeepSeek-V4, Kimi K3 and MiniMax M3 MegaMoE","-    layers match.\"\"\"","+    imported; with them loaded, only DeepSeek-V4, Kimi K3, MiniMax M3 and","+    GLM-5.3-Flash MegaMoE layers match.\"\"\"","     name = \"vllm.models.deepseek_v4.nvidia.model\"","     kimi_name = \"vllm.models.kimi_k3.nvidia.model\"","     minimax_name = \"vllm.models.minimax_m3.nvidia.model\"","-    for model_module in (name, kimi_name, minimax_name):","+    glm_name = \"vllm.models.glm5next.common.model\"","+    for model_module in (name, kimi_name, minimax_name, glm_name):","         monkeypatch.delitem(sys.modules, model_module, raising=False)","     other = SimpleNamespace(use_native_mega_moe=True, use_mega_moe=True)","     assert not deep_gemm_warmup._mega_moe_may_use_deep_gemm(other)","-    assert not {name, kimi_name, minimax_name} & set(sys.modules)","+    assert not {name, kimi_name, minimax_name, glm_name} & set(sys.modules)"," ","     moe_cls = type(\"DeepseekV4MoE\", (), {})","     monkeypatch.setitem(sys.modules, name, SimpleNamespace(DeepseekV4MoE=moe_cls))","@@ -132,6 +133,13 @@ def test_mega_moe_predicate_matches_only_native_mega_moe_layers(monkeypatch) ->","     assert deep_gemm_warmup._mega_moe_may_use_deep_gemm(minimax_mega)","     assert not deep_gemm_warmup._mega_moe_may_use_deep_gemm(minimax_fused)"," ","+    glm_cls = type(\"Glm5NextMoE\", (), {})","+    monkeypatch.setitem(sys.modules, glm_name, SimpleNamespace(Glm5NextMoE=glm_cls))","+    glm_mega, glm_fused = glm_cls(), glm_cls()","+    glm_mega.use_mega_moe, glm_fused.use_mega_moe = True, False","+    assert deep_gemm_warmup._mega_moe_may_use_deep_gemm(glm_mega)","+    assert not deep_gemm_warmup._mega_moe_may_use_deep_gemm(glm_fused)","+"," "," @pytest.mark.parametrize(","     (\"weight_format\", \"expected\"),"],"additions":12,"deletions":4,"truncated":false},{"path":"tests/models/glm5next/test_mega_moe.py","lines":["@@ -1,14 +1,19 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," \"\"\"GLM-5.3 MegaMoE: block-FP8 checkpoint shards requantized to the MXFP8","-MegaMoE kernel layout, and BF16 shards loaded as they are.\"\"\"","+MegaMoE kernel layout (kept as block-FP8 on SM90), and BF16 shards loaded as","+they are.\"\"\""," "," from types import SimpleNamespace"," "," import pytest"," import torch"," ","-from vllm.model_executor.layers.fused_moe.deep_gemm_mega_moe import MegaMoEActivation","+from vllm.model_executor.layers.fused_moe.deep_gemm_mega_moe import (","+    MEGA_MOE_FP8_BLOCK_SM90,","+    MegaMoEActivation,","+    check_deep_gemm_mega_moe_supported,","+)"," from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","     requant_block_fp8_to_ue8m0,"," )","@@ -19,9 +24,13 @@"," )"," from vllm.model_executor.model_loader.utils import process_weights_after_loading"," from vllm.models.glm5next.nvidia.mega_moe import Glm5NextMegaMoEExperts","+from vllm.platforms import current_platform","+from vllm.utils.import_utils import has_deep_gemm","+from vllm.utils.math_utils import round_up"," "," BLOCK = (128, 128)","-HIDDEN, INTER = 256, 128","+# Two 128-row blocks each of gate and up, so the SM90 block-row interleave shows.","+HIDDEN, INTER = 256, 256"," FP8 = torch.float8_e4m3fn"," NUM_EXPERTS = 4"," # Global ids of the experts _experts() places on this rank.","@@ -36,6 +45,9 @@ def sm100_mega_moe_layout(monkeypatch):","         \"check_deep_gemm_mega_moe_supported\",","         lambda *args: None,","     )","+    monkeypatch.setattr(","+        current_platform, \"is_device_capability\", lambda *args, **kwargs: False","+    )"," "," "," def _block_fp8(real: torch.Tensor, power_of_two: bool = False):","@@ -156,18 +168,55 @@ def utccp(sf):","     )"," "," ","-def _expected_routed(ckpt):","-    w13, s13 = requant_block_fp8_to_ue8m0(","-        ckpt[\"w13_weight\"][LOCAL_EXPERTS], ckpt[\"w13_weight_scale_inv\"][LOCAL_EXPERTS]","+def _sm90_layout(w13, s13, w2, s2):","+    \"\"\"Block-FP8 weights as loaded and the block scale of each weight row.\"\"\"","+    return (","+        _interleave(w13.view(torch.uint8)),","+        _interleave(s13.repeat_interleave(128, -2)),","+        w2.view(torch.uint8),","+        s2.repeat_interleave(128, -2),","+    )","+","+","+def _sm90_scale_reads(sf, is_l1):","+    \"\"\"The block scale of each weight row, read as the SM90 kernel does","+    (DeepGEMM's `read_like_kernel`).\"\"\"","+    *_, mn, num_k = sf.shape","+    # MN-major, MN stride aligned to 16 bytes, experts contiguous.","+    assert sf.stride()[-2:] == (1, round_up(mn, 4))","+    assert sf.dim() == 2 or sf.stride(0) == num_k * round_up(mn, 4)","+    groups = sf if sf.dim() == 3 else sf.unsqueeze(0)","+    memory = torch.as_strided(","+        groups,","+        (groups.shape[0], num_k, sf.stride(-1)),","+        (groups.stride(0), sf.stride(-1), 1),","     )","-    w2, s2 = requant_block_fp8_to_ue8m0(","-        ckpt[\"w2_weight\"][LOCAL_EXPERTS], ckpt[\"w2_weight_scale_inv\"][LOCAL_EXPERTS]","+    rows = torch.arange(mn * 128)","+    tiles = rows // 128","+    words = (","+        torch.where(rows % 16 < 8, tiles & 2, (tiles & 2) + 1) if is_l1 else tiles & 3","     )","+    reads = memory[:, :, (tiles & ~3) + words].transpose(-1, -2)","+    return reads if sf.dim() == 3 else reads[0]","+","+","+def _expected(w13, s13, w2, s2, sm90):","+    if sm90:","+        return _sm90_layout(w13, s13, w2, s2)","+    w13, s13 = requant_block_fp8_to_ue8m0(w13, s13)","+    w2, s2 = requant_block_fp8_to_ue8m0(w2, s2)","     return _reference_mega_moe_layout(w13, s13, w2, s2)"," "," ","-def _assert_layout(actual, expected):","-    for tensor, reference in zip(actual, expected):","+def _expected_routed(ckpt, sm90=False):","+    w13, s13, w2, s2 = (t[LOCAL_EXPERTS] for t in ckpt.values())","+    return _expected(w13, s13, w2, s2, sm90)","+","+","+def _assert_layout(actual, expected, sm90=False):","+    for i, (tensor, reference) in enumerate(zip(actual, expected)):","+        if sm90 and i % 2:","+            tensor = _sm90_scale_reads(tensor, is_l1=i == 1)","         assert torch.equal(tensor.view(reference.dtype), reference)"," "," ","@@ -208,19 +257,18 @@ def _load_shared(experts, ckpt) -> None:","     for name, data in [","         (\"down_proj.weight_scale_inv\", s2[0]),","         (\"gate_proj.weight\", w13[0, :INTER]),","-        (\"up_proj.weight_scale_inv\", s13[0, 1:]),","+        (\"up_proj.weight_scale_inv\", s13[0, INTER // 128 :]),","         (\"down_proj.weight\", w2[0]),","         (\"up_proj.weight\", w13[0, INTER:]),","-        (\"gate_proj.weight_scale_inv\", s13[0, :1]),","+        (\"gate_proj.weight_scale_inv\", s13[0, : INTER // 128]),","     ]:","         loaded = experts.load_shared_expert_weight(f\"mlp.shared_experts.{name}\", data)","         assert loaded in params"," "," ","-def _expected_shared(ckpt):","-    q13, sf13 = requant_block_fp8_to_ue8m0(ckpt[\"w13\"], ckpt[\"s13\"])","-    q2, sf2 = requant_block_fp8_to_ue8m0(ckpt[\"w2\"], ckpt[\"s2\"])","-    return [t[0] for t in _reference_mega_moe_layout(q13, sf13, q2, sf2)]","+def _expected_shared(ckpt, sm90=False):","+    expected = _expected(ckpt[\"w13\"], ckpt[\"s13\"], ckpt[\"w2\"], ckpt[\"s2\"], sm90)","+    return [t[0] for t in expected]"," "," "," def _shared(experts):","@@ -240,14 +288,26 @@ def __init__(self):","         self.experts = _experts()"," ","     def process_weights_after_loading(self):","-        self.experts.requantize_block_fp8()","+        self.experts.finalize_block_fp8_weights()"," "," ","+@pytest.mark.parametrize(","+    \"sm90\",","+    [","+        False,","+        pytest.param(","+            True, marks=pytest.mark.skipif(not has_deep_gemm(), reason=\"no DeepGEMM\")","+        ),","+    ],","+)"," @pytest.mark.parametrize(\"mode\", [\"layerwise\", \"direct\"])","-def test_reload_requantizes_into_the_kernel_tensors(monkeypatch, mode):","+def test_reload_requantizes_into_the_kernel_tensors(monkeypatch, mode, sm90):","     \"\"\"A reload writes the block-FP8 shards and finishes with the model's","     process_weights_after_loading; the kernel tensors keep their storage.\"\"\"","     monkeypatch.setenv(\"VLLM_RELOAD_MODE\", mode)","+    monkeypatch.setattr(","+        current_platform, \"is_device_capability\", lambda cap, **_: sm90 and cap == 90","+    )","     model_config = SimpleNamespace(","         word_embeddings_untied_by_checkpoint=False, quantization=None","     )","@@ -259,10 +319,10 @@ def test_reload_requantizes_into_the_kernel_tensors(monkeypatch, mode):","     _load_shuffled(experts, ckpt, seed=0)","     _load_shared(experts, shared_ckpt)","     process_weights_after_loading(model, model_config, device)  # type: ignore[arg-type]","-    # Already requantized shards are left alone by a second call.","-    experts.requantize_block_fp8()","-    _assert_layout(_routed(experts), _expected_routed(ckpt))","-    _assert_layout(_shared(experts), _expected_shared(shared_ckpt))","+    # A second call leaves the kernel tensors as they are.","+    experts.finalize_block_fp8_weights()","+    _assert_layout(_routed(experts), _expected_routed(ckpt, sm90), sm90)","+    _assert_layout(_shared(experts), _expected_shared(shared_ckpt, sm90), sm90)","     storage = {n: p.data_ptr() for n, p in experts.named_parameters()}"," ","     ckpt, shared_ckpt = _checkpoint(seed=1), _shared_checkpoint(seed=1)","@@ -274,11 +334,40 @@ def test_reload_requantizes_into_the_kernel_tensors(monkeypatch, mode):","     assert not experts.w13_weight.is_meta","     finish_reload(model, model_config, device)  # type: ignore[arg-type]"," ","-    _assert_layout(_routed(experts), _expected_routed(ckpt))","-    _assert_layout(_shared(experts), _expected_shared(shared_ckpt))","+    _assert_layout(_routed(experts), _expected_routed(ckpt, sm90), sm90)","+    _assert_layout(_shared(experts), _expected_shared(shared_ckpt, sm90), sm90)","     asser