g user stack map @ {pc:#x} spanning {span} bytes: {stack_map:?}\");"," ","         debug_assert!(","             self.user_stack_maps","                 .last()","-                .map_or(true, |(prev_addr, _, _)| *prev_addr < return_addr),","+                .map_or(true, |(prev_addr, _, _)| *prev_addr < pc),","             \"pushed stack maps out of order: {} is not less than {}\",","             self.user_stack_maps.last().unwrap().0,","-            return_addr,","+            pc,","         );"," ","         stack_map.finalize(emit_state.frame_layout().sp_to_sized_stack_slots());","-        self.user_stack_maps.push((return_addr, span, stack_map));","+        self.user_stack_maps.push((pc, span, stack_map));","     }"," ","     /// Push a user stack map whose offsets are already relative to the stack"],"additions":12,"deletions":11,"truncated":false},{"path":"cranelift/codegen/src/write.rs","lines":["@@ -463,8 +463,7 @@ pub fn write_operands(w: &mut dyn Write, dfg: &DataFlowGraph, inst: Inst) -> fmt","         Call {","             func_ref, ref args, ..","         } => {","-            write!(w, \" {}({})\", func_ref, DisplayValues(args.as_slice(pool)))?;","-            write_user_stack_map_entries(w, dfg, inst)","+            write!(w, \" {}({})\", func_ref, DisplayValues(args.as_slice(pool)))","         }","         CallIndirect {","             sig_ref, ref args, ..","@@ -476,8 +475,7 @@ pub fn write_operands(w: &mut dyn Write, dfg: &DataFlowGraph, inst: Inst) -> fmt","                 sig_ref,","                 args[0],","                 DisplayValues(&args[1..])","-            )?;","-            write_user_stack_map_entries(w, dfg, inst)","+            )","         }","         TryCall {","             func_ref,","@@ -491,8 +489,7 @@ pub fn write_operands(w: &mut dyn Write, dfg: &DataFlowGraph, inst: Inst) -> fmt","                 func_ref,","                 DisplayValues(args.as_slice(pool)),","                 exception_tables[exception].display(pool