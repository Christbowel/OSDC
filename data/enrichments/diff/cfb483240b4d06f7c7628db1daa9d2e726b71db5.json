, user3, stack_map=[i64 @ ss0+0]","+    return v4","+}","+","+; (no functions inlined into %poll_callee)","+","+function %poll_caller(i64, i64, i64) -> i64 tail {","+    ss0 = explicit_slot 16, align = 8","+    fn0 = %poll_callee(i64, i64, i64) -> i64 tail","+block0(v0: i64, v1: i64, v2: i64):","+    v3 = stack_addr.i64 ss0+8","+    store notrap v0, v3","+    v4 = call fn0(v0, v1, v2), stack_map=[i64 @ ss0+8]","+    v5 = stack_addr.i64 ss0+8","+    v6 = load.i64 notrap v5","+    v7 = iadd v4, v6","+    return v7","+}","+","+; function %poll_caller(i64, i64, i64) -> i64 tail {","+;     ss0 = explicit_slot 16, align = 8","+;     ss1 = explicit_slot 8, align = 8","+;     sig0 = (i64, i64, i64) -> i64 tail","+;     fn0 = %poll_callee sig0","+;","+; block0(v0: i64, v1: i64, v2: i64):","+;     v3 = stack_addr.i64 ss0+8","+;     store notrap v0, v3","+;     jump block1","+;","+; block1:","+;     v9 = stack_addr.i64 ss1","+;     store.i64 notrap v0, v9","+;     v10 = interrupt_poll.i64 v1, v2, user3, stack_map=[i64 @ ss0+8, i64 @ ss1+0]","+;     jump block2(v10)","+;","+; block2(v8: i64):","+;     v4 -> v8","+;     v5 = stack_addr.i64 ss0+8","+;     v6 = load.i64 notrap v5","+;     v7 = iadd v4, v6","+;     return v7","+; }","+","+;; A callee with both a poll and a real call, inlined at a `try_call` site: the","+;; real call has to be rewritten to a `try_call`, but the poll must be left","+;; alone.","+function %poll_callee_try(i64, i64, i64) -> i64 tail {","+    ss0 = explicit_slot 8, align = 8","+    sig0 = (i64) -> i64 tail","+    fn0 = %foo sig0","+block0(v0: i64, v1: i64, v2: i64):","+    v3 = stack_addr.i64 ss0","+    store notrap v0, v3","+    v4 = interrupt_poll v1, v2, user3, stack_map=[i64 @ ss0+0]","+    v5 = call fn0(v4)","+    return v5","+}","+","+; (no functions inlined into %poll_callee_try)","+","+function %poll_try_caller(i64, i64, i64) -> i64 tail {","+    ss0 = explicit_slot 16, align = 8","+    sig0 = (i64, i64, i64) -> i64 tail","+    fn0 = %poll_callee_try(i64, i64, i64) -> i64 tail","+block0(v0: i64, v1: i64, v2: i64):","+    v3 = stack_addr.i64 ss0+8","+    store notrap v0, v3","+    try_call fn0(v0, v1, v2), sig0, block1(ret0), [default: block2(exn0)], stack_map=[i64 @ ss0+8]","+block1(v4: i64):","+    v5 = stack_addr.i64 ss0+8","+    v6 = load.i64 notrap v5","+    v7 = iadd v4, v6","+    return v7","+block2(v8: i64):","+    return v8","+}","+","+; function %poll_try_caller(i64, i64, i64) -> i64 tail {","+;     ss0 = explicit_slot 16, align = 8","+;     ss1 = explicit_slot 8, align = 8","+;     sig0 = (i64, i64, i64) -> i64 tail","+;     sig1 = (i64, i64, i64) -> i64 tail","+;     sig2 = (i64) -> i64 tail","+;     fn0 = %poll_callee_try sig1","+;     fn1 = %foo sig2","+;","+; block0(v0: i64, v1: i64, v2: i64):","+;     v3 = stack_addr.i64 ss0+8","+;     store notrap v0, v3","+;     jump block3","+;","+; block3:","+;     v9 = stack_addr.i64 ss1","+;     store.i64 notrap v0, v9","+;     v10 = interrupt_poll.i64 v1, v2, user3, stack_map=[i64 @ ss0+8, i64 @ ss1+0]","+;     try_call fn1(v10), sig2, block4(ret0), [ default: block2(exn0) ], stack_map=[i64 @ ss0+8]","+;","+; block4(v12: i64):","+;     v11 -> v12","+;     jump block1(v11)","+;","+; block1(v4: i64):","+;     v5 = stack_addr.i64 ss0+8","+;     v6 = load.i64 notrap v5","+;     v7 = iadd v4, v6","+;     return v7","+;","+; block2(v8: i64):","+;     return v8","+; }"],"additions":124,"deletions":0,"truncated":false},{"path":"cranelift/filetests/filetests/isa/aarch64/interrupt-poll-stack-map.clif","lines":["@@ -0,0 +1,44 @@","+test compile precise-output","+target aarch64","+","+;; The stack map attached to an `interrupt_poll` must be emitted at the address","+;; of the faulting load, because the MMU-interruption handler resumes by","+;; re-executing that load and records its address as the Wasm resume PC.","+function %interrupt_poll_stack_map(i64, i64, i64) -> i64 tail {","+    ss0 = explicit_slot 8, align = 8","+block0(v0: i64, v1: i64, v2: i64):","+    v3 = stack_addr.i64 ss0","+    store notrap v0, v3","+    v4 = interrupt_poll v1, v2, user3, stack_map=[i64 @ ss0+0]","+    return v4","+}","+","+; VCode:","+;   stp fp, lr, [sp, #-16]!","+;   mov fp, sp","+;   sub sp, sp, #16","+; block0:","+;   str x2, [sp]","+;   mov x0, x4","+;   mov x10, x3","+;   x10 = interrupt_poll load_ptr=x10, context=x0, scratch=x9 #trap=user3","+;   ; UserStackMap { by_type: [(types::I64, CompoundBitSet {0})], sp_to_sized_stack_slots: None }","+;   mov x2, x10","+;   add sp, sp, #16","+;   ldp fp, lr, [sp], #16","+;   ret","+;","+; Disassembled:","+; block0: ; offset 0x0","+;   stp x29, x30, [sp, #-0x10]!","+;   mov x29, sp","+;   sub sp, sp, #0x10","+; block1: ; offset 0xc","+;   stur x2, [sp]","+;   mov x0, x4","+;   mov x10, x3","+;   ldr x9, [x10] ; trap: user3","+;   mov x2, x10","+;   add sp, sp, #0x10","+;   ldp x29, x30, [sp], #0x10","+;   ret"],"additions":44,"deletions":0,"truncated":false},{"path":"cranelift/filetests/filetests/isa/x64/interrupt-poll-stack-map.clif","lines":["@@ -0,0 +1,46 @@","+test compile precise-output","+target x86_64","+","+;; The stack map attached to an `interrupt_poll` must be emitted at the address","+;; of the faulting load, because the MMU-interruption handler resumes by","+;; re-executing that load and records its address as the Wasm resume PC.","+function %interrupt_poll_stack_map(i64, i64, i64) -> i64 tail {","+    ss0 = explicit_slot 8, align = 8","+block0(v0: i64, v1: i64, v2: i64):","+    v3 = stack_addr.i64 ss0","+    store notrap v0, v3","+    v4 = interrupt_poll v1, v2, user3, stack_map=[i64 @ ss0+0]","+    return v4","+}","+","+; VCode:","+;   pushq %rbp","+;   movq %rsp, %rbp","+;   subq $0x10, %rsp","+; block0:","+;   movq %rdi, <offset:1>+(%rsp)","+;   movq %rdx, %rdi","+;   movq %rsi, %r11","+;   %r11 = interrupt_poll load_ptr=%r11, context=%rdi, scratch=%r10 #trap=user3","+;   ; UserStackMap { by_type: [(types::I64, CompoundBitSet {0})], sp_to_sized_stack_slots: None }","+;   movq %r1