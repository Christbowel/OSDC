olean isFromPom(Profile profile) {","+        InputLocation location = profile.getLocation(\"\");","+        if (location != null) {","+            InputSource source = location.getSource();","+            if (source != null) {","+                String modelId = source.getModelId();","+                return modelId != null && !modelId.isEmpty();","+            }","+        }","+        return true;","+    }","+}"],"additions":65,"deletions":0,"truncated":false},{"path":"impl/maven-impl/src/main/java/org/apache/maven/impl/model/profile/PropertyProfileActivator.java","lines":["@@ -103,7 +103,7 @@ public boolean isActive(Profile profile, ProfileActivationContext context, Model","         // Only cascaded properties (from previously-activated profiles) are checked — the","         // POM's own <properties> must NOT self-activate profiles via PropertyProfileActivator.","         // ONLY for POM profiles - settings profiles should not use cascaded properties.","-        if (sysValue == null && Profile.SOURCE_POM.equals(profile.getSource())) {","+        if (sysValue == null && isFromPom(profile)) {","             sysValue = context.getCascadedProfileProperty(name);","         }"," ","@@ -161,4 +161,13 @@ public boolean presentInConfig(Profile profile, ProfileActivationContext context"," ","         return property != null;","     }","+","+    /**","+     * Determines whether the given profile originates from a POM file.","+     *","+     * @see ProfileSourceDetector#isFromPom(Profile)","+     */","+    private static boolean isFromPom(Profile profile) {","+        return ProfileSourceDetector.isFromPom(profile);","+    }"," }"],"additions":10,"deletions":1,"truncated":false},{"path":"impl/maven-impl/src/test/java/org/apache/maven/impl/model/DefaultProfileSelectorTest.java","lines":["@@ -26,8 +26,13 @@"," import org.apache.maven.api.model.Activation;"," import org.apache.maven.api.model.ActivationFile;"," import org.apache.maven.api.model.ActivationProperty;","+import or