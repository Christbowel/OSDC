{"id":"944ec109da42f696cab16d67a977cf4f26e6d263","axis":"silent","repo":"vllm-project/vllm","sha":"944ec109da42f696cab16d67a977cf4f26e6d263","parsed":{"files":[{"path":"docs/serving/expert_parallel_deployment.md","lines":["@@ -39,11 +39,33 @@ vLLM provides multiple communication backends for EP. Use `--all2all-backend` to"," | `allgather_reducescatter` | General purpose | Standard all2all using allgather/reducescatter primitives | Works with any EP+DP configuration |"," | `deepep_high_throughput` | Multi-node prefill | Grouped GEMM with continuous layout, optimized for prefill | Prefill-dominated workloads, high-throughput scenarios |"," | `deepep_low_latency` | Multi-node decode | CUDA graph support, masked layout, optimized for decode | Decode-dominated workloads, low-latency scenarios |","+| `mooncake_ep` | CUDA decode | Mooncake EP low-latency kernels, elastic buffers, BF16 and blockwise FP8 dispatch | Decode workloads on NVLink or RDMA |"," | `flashinfer_nvlink_one_sided` | MNNVL systems, single-node NVSwitch | FlashInfer's one-sided A2A strategy over NVLink | High-throughput workloads |"," | `passthrough` | Any | Internal, not accepted on the CLI: bound automatically for MoE backends that dispatch and combine themselves, so no all-to-all runs in the framework | `--moe-backend flashinfer_moe_ep_*` (FlashInfer MoE-EP megakernels) |"," | `flashinfer_nvlink_two_sided` | MNNVL systems | FlashInfer's two-sided A2A strategy for multi-node NVLink | Systems with NVLink across nodes |"," | `mori` | ROCm | MoRI EP: EPv2 (dispatch/combine over a CCO symmetric-memory window) where supported, otherwise EPv1 | AMD Instinct; see [MoRI EP](#mori-ep-rocm) |"," ","+### Mooncake EP","+","+Install a Mooncake package built with EP support, including the elastic legacy","+`Buffer.create_elastic()` API (Mooncake 0.3.14 or later). For CUDA 13:","+","+```bash","+uv pip install mooncake-transfer-engine-cuda13","+```","+","+Select `--all2all-backend mooncake_ep` with `--enable-expert-parallel` and","+`--data-parallel-size`. The backend uses elastic buffers for both fixed-size and","+elastic deployments, with native NVLink peer access within a node and IBGDA for","+RDMA peers. Dispatch supports BF16 and blockwise FP8 activations. The existing","+vLLM elastic EP lifecycle stages connections before activating new ranks and","+reserves capacity using `--elastic-ep-max-dp-size`.","+","+For elastic scaling, also set `--enable-elastic-ep`, `--enable-eplb`,","+`--data-parallel-backend ray`, and `--elastic-ep-max-dp-size` to the largest","+intended DP size. See [Elastic Expert Parallelism](online_serving/README.md#elastic-expert-parallelism-eep)","+for the scaling API.","+"," ## Single Node Deployment"," "," ### Configuration"],"additions":22,"deletions":0,"truncated":false},{"path":"tests/distributed/test_elastic_ep.py","lines":["@@ -232,6 +232,7 @@ def _base_serve_args(","             id=\"cuda_graphs_heavy\",","         ),","         pytest.param(False, \"heavy\", \"nixl_ep\", id=\"cuda_graphs_heavy_nixl_ep\"),","+        pytest.param(False, \"heavy\", \"mooncake_ep\", id=\"cuda_graphs_heavy_mooncake_ep\"),","     ],"," )"," @multi_gpu_test(num_gpus=4)","@@ -239,7 +240,7 @@ def test_elastic_ep_scaling(","     enforce_eager: bool, traffic_mode: str, all2all_backend: str"," ):","     from vllm.distributed.eplb.eplb_communicator import has_nixl","-    from vllm.utils.import_utils import has_nixl_ep","+    from vllm.utils.import_utils import has_mooncake_ep, has_nixl_ep"," ","     if not has_nixl():","         pytest.skip(\"Async EPLB with elastic EP requires NIXL (not installed)\")","@@ -247,6 +248,8 @@ def test_elastic_ep_scaling(","         pytest.skip(\"Elastic EP with NIXL is not supported on XPU\")","     if all2all_backend == \"nixl_ep\" and not has_nixl_ep():","         pytest.skip(\"NIXL EP is not installed\")","+    if all2all_backend == \"mooncake_ep\" and not has_mooncake_ep():","+        pytest.skip(\"Mooncake EP is not installed\")"," ","     initial_dp_size = int(os.getenv(\"VLLM_TEST_ELASTIC_EP_INITIAL_DP\", \"2\"))","     target_dp_size = int(os.getenv(\"VLLM_TEST_ELASTIC_EP_TARGET_DP\", \"4\"))"],"additions":4,"deletions":1,"truncated":false},{"path":"vllm/config/parallel.py","lines":["@@ -61,6 +61,7 @@ def get_min_num_redundant_experts(num_logical_experts: int, ep_size: int) -> int","     \"moonep\",","     \"mori\",","     \"nixl_ep\",","+    \"mooncake_ep\",","     \"allgather_reducescatter\",","     \"alltoall_batched\",","     \"flashinfer_all2allv\",  # temporary alias for flashinfer_nvlink_two_sided","@@ -352,6 +353,7 @@ class ParallelConfig:","       EPv1 otherwise, picking the EPv1 inter-node kernel from the token budget","       (see `VLLM_MORI_DISPATCH_INTER_KERNEL_SWITCH_THRESHOLD`)","     - \"nixl_ep\": Use nixl-ep kernels","+    - \"mooncake_ep\": Use Mooncake EP low-latency kernels with elastic buffers","     - \"flashinfer_nvlink_one_sided\": Use flashinfer high-throughput a2a kernels","     - \"flashinfer_nvlink_two_sided\": Use flashinfer two-sided kernels for mnnvl","     - \"passthrough\": No all2all at all: the MoE backend dispatches and combines","@@ -991,6 +993,7 @@ def use_sequence_parallel_moe(self) -> bool:","                 \"mori_low_latency\",","                 \"mori\",","                 \"nixl_ep\",","+                \"mooncake_ep\",","             )","             and self.enable_expert_parallel","             and self.tensor_parallel_size > 1","@@ -1013,6 +1016,7 @@ def use_batched_dp_moe(self) -> bool:","             in (","                 \"deepep_low_latency\",","                 \"nixl_ep\",","+                \"mooncake_ep\",","                 \"alltoall_batched\",","             )","             and self.enable_expert_parallel"],"additions":4,"deletions":0,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -2313,6 +2313,7 @@ def has_blocked_weights():","                     \"deepep_low_latency\",","                     \"deepep_high_throughput\",","                     \"nixl_ep\",","+                    \"mooncake_ep\",","                 ]","             assert a2a_backend in supported_backends, (","                 \"Microbatching currently only supports the \""],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/distributed/device_communicators/cuda_communicator.py","lines":["@@ -265,6 +265,12 @@ def __init__(","                     tcp_store_group,","                     device_group=self.device_group,","                 )","+            elif self.all2all_backend == \"mooncake_ep\":","+                from .mooncake_ep import MooncakeEPAll2AllManager","+","+                self.all2all_manager = MooncakeEPAll2AllManager(","+                    self.cpu_group, tcp_store_group","+                )","             elif self.all2all_backend == \"nixl_ep\":","                 from .all2all import NixlEPAll2AllManager"," "],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/distributed/device_communicators/mooncake_ep.py","lines":["@@ -0,0 +1,260 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+import threading","+from collections.abc import Iterator","+from contextlib import contextmanager","+from dataclasses import dataclass","+from typing import Any","+","+import torch","+import torch.distributed as dist","+","+from vllm.config import get_current_vllm_config","+from vllm.distributed.device_communicators.base_device_communicator import (","+    All2AllManagerBase,","+)","+from vllm.distributed.utils import StatelessProcessGroup","+","+","+@dataclass","+class _MooncakeEPBufferState:","+    buffer: Any","+    max_num_ep_ranks: int","+    connected_ep_size: int","+    active_ep_size: int","+","+","+class MooncakeEPAll2AllManager(All2AllManagerBase):","+    \"\"\"All2All communication based on Mooncake EP kernels.","+    This backend supports elastic EP with dynamic rank connection/disconnection.","+    \"\"\"","+","+    _buffer: _MooncakeEPBufferState | None = None","+    _lock = threading.RLock()","+    _mask: torch.Tensor | None = None","+    _last_mask: torch.Tensor | None = None","+","+    def __init__(self, cpu_group, tcp_store_group=None):","+        if tcp_store_group is None:","+            tcp_store_group = StatelessProcessGroup(","+                rank=cpu_group.rank(),","+                world_size=cpu_group.size(),","+                store=dist.PrefixStore(\"mooncake_ep\", cpu_group.get_group_store()),","+            )","+        super().__init__(cpu_group, tcp_store_group)","+        self.support_fault_tolerance = True","+","+    @property","+    def max_num_ep_ranks(self) -> int:","+        assert MooncakeEPAll2AllManager._buffer is not None","+        return MooncakeEPAll2AllManager._buffer.max_num_ep_ranks","+","+    def _init_buffer(","+        self,","+        max_num_tokens_per_dp_rank: int,","+        token_hidden_size: int,","+        num_experts_per_rank: int,","+    ) -> None:","+        from mooncake.mooncake_ep_buffer import Buffer","+","+        parallel_config = get_current_vllm_config().parallel_config","+        max_num_ep_ranks = (","+            self.world_size","+            * parallel_config.elastic_ep_max_dp_size","+            // parallel_config.data_parallel_size","+            if parallel_config.enable_elastic_ep","+            else self.world_size","+        )","+        max_num_global_experts = max_num_ep_ranks * num_experts_per_rank","+        num_rdma_bytes = Buffer.get_rdma_size_hint(","+            num_max_dispatch_tokens_per_rank=max_num_tokens_per_dp_rank,","+            hidden=token_hidden_size,","+            num_ranks=max_num_ep_ranks,","+            num_experts=max_num_global_experts,","+        )","+        assert MooncakeEPAll2AllManager._buffer is None, (","+            \"Mooncake EP buffer already initialized\"","+        )","+        buffer = Buffer.create_elastic(","+            rank=self.rank,","+            tcp_store_group=self.tcp_store_group.store,","+        )","+        buffer.update_memory_buffers(","+            num_ranks=max_num_ep_ranks,","+            num_experts_per_rank=num_experts_per_rank,","+            num_rdma_bytes=num_rdma_bytes,","+        )","+        ranks_to_connect = list(range(self.world_size))","+        buffer.connect_ranks(ranks_to_connect)","+        MooncakeEPAll2AllManager._buffer = _MooncakeEPBufferState(","+            buffer=buffer,","+            max_num_ep_ranks=max_num_ep_ranks,","+            connected_ep_size=self.world_size,","+            active_ep_size=self.world_size,","+        )","+","+    def _connect_to_ep_size(self, ep_size: int, *, make_active: bool) -> None:","+        assert MooncakeEPAll2AllManager._buffer is not None","+        state = MooncakeEPAll2AllManager._buffer","+        if ep_size <= state.connected_ep_size:","+            return","+","+        state.buffer.set_tcp_store_group(self.tcp_store_group.store)","+        ranks_to_connect = list(range(state.connected_ep_size, ep_size))","+        state.buffer.connect_ranks(ranks_to_connect, activate=make_active)","+        state.connected_ep_size = ep_size","+        if make_active:","+            state.active_ep_size = ep_size","+","+    def _disconnect_to_ep_size(self, ep_size: int) -> None:","+        assert MooncakeEPAll2AllManager._buffer is not None","+        state = MooncakeEPAll2AllManager._buffer","+        if ep_size >= state.connected_ep_size:","+            return","+","+        state.buffer.set_tcp_store_group(self.tcp_store_group.store)","+        ranks_to_disconnect = list(range(ep_size, state.connected_ep_size))","+        state.buffer.disconnect_ranks(ranks_to_disconnect)","+        state.connected_ep_size = ep_size","+        state.active_ep_size = min(state.active_ep_size, ep_size)","+","+    def _unmask_connected_ranks(self, target_ep_size: int) -> None:","+        assert MooncakeEPAll2AllManager._buffer is not None","+        state = MooncakeEPAll2AllManager._buffer","+        state.buffer.set_tcp_store_group(self.tcp_store_group.store)","+        if target_ep_size <= state.active_ep_size:","+            return","+        assert state.connected_ep_size >= target_ep_size","+","+        for rank in range(state.active_ep_size, target_ep_size):","+            state.buffer.update_mask_buffer(rank, mask=False)","+        torch.accelerator.synchronize()","+        state.active_ep_size = target_ep_size","+","+    def _stage_ep_size(self) -> None:","+        assert MooncakeEPAll2AllManager._buffer is not None","+        state = MooncakeEPAll2AllManager._buffer","+        target_ep_size = self.world_size","+","+        # Scale-up can safely connect standby ranks while leaving them masked.","+        # Scale-down must not disconnect active ranks until commit.","+        if target_ep_size > state.connected_ep_size:","+            self._connect_to_ep_size(target_ep_size, make_active=False)","+","+    def stage_ep_size(self) -> None:","+        with MooncakeEPAll2AllManager._lock:","+            self._stage_ep_size()","+","+    def commit_ep_size(self) -> None:","+        \"\"\"Commit the staged EP size to the active communication set.\"\"\"","+        with MooncakeEPAll2AllManager._lock:","+            assert MooncakeEPAll2AllManager._buffer is not None","+            state = MooncakeEPAll2AllManager._buffer","+            target_ep_size = self.world_size","+","+            if target_ep_size < state.connected_ep_size:","+                self._disconnect_to_ep_size(target_ep_size)","+            elif target_ep_size > state.connected_ep_size:","+                self._connect_to_ep_size(target_ep_size, make_active=True)","+","+            self._unmask_connected_ranks(target_ep_size)","+","+    @contextmanager","+    def mask_remote_ranks(self) -> Iterator[None]:","+        peers = [rank for rank in range(self.world_size) if rank != self.rank]","+        assert MooncakeEPAll2AllManager._buffer is not None","+        buffer = MooncakeEPAll2AllManager._buffer.buffer","+        for rank in peers:","+            buffer.update_mask_buffer(rank, mask=True)","+        torch.accelerator.synchronize()","+        try:","+            yield","+        finally:","+            for rank in peers:","+                buffer.update_mask_buffer(rank, mask=False)","+            torch.accelerator.synchronize()","+","+    def get_handle(self, kwargs):","+        with MooncakeEPAll2AllManager._lock:","+            state = MooncakeEPAll2AllManager._buffer","+            if state is None:","+                max_num_tokens_per_dp_rank = kwargs[\"max_num_tokens_per_dp_rank\"]","+                self._init_buffer(","+                    max_num_tokens_per_dp_rank=max_num_tokens_per_dp_rank,","+                    token_hidden_size=kwargs[\"token_hidden_size\"],","+                    num_experts_per_rank=kwargs[\"num_local_experts\"],","+                )","+","+            assert MooncakeEPAll2AllManager._buffer is not None","+            handle = MooncakeEPAll2AllManager._buffer.buffer","+            return handle","+","+    def dispatch(","+        self,","+        hidden_states: torch.Tensor,","+        topk_weights: torch.Tensor,","+        topk_ids: torch.Tensor,","+        is_sequence_parallel: bool = False,","+        extra_tensors: list[torch.Tensor] | None = None,","+    ) -> (","+        tuple[torch.Tensor, torch.Tensor, torch.Tensor]","+        | tuple[torch.Tensor, torch.Tensor, torch.Tensor, list[torch.Tensor]]","+    ):","+        raise NotImplementedError","+","+    def combine(","+        self, hidden_states: torch.Tensor, is_sequence_parallel: bool = False","+    ) -> torch.Tensor:","+        raise NotImplementedError","+","+    def destroy(self):","+        # The manager instance is recreated during","+        # scale-up/down, so we cannot destroy the persistent buffer here.","+        state = MooncakeEPAll2AllManager._buffer","+        if state is not None:","+            state.buffer.set_tcp_store_group(None)","+","+    def query_active_mask(self) -> torch.Tensor:","+        state = MooncakeEPAll2AllManager._buffer","+        assert state is not None","+        if MooncakeEPAll2AllManager._mask is None:","+            MooncakeEPAll2AllManager._mask = torch.zeros(","+                state.max_num_ep_ranks, device=\"cuda\", dtype=torch.int32","+            )","+        state.buffer.query_mask_buffer(MooncakeEPAll2AllManager._mask)","+        return MooncakeEPAll2AllManager._mask[: state.active_ep_size]","+","+    def query_fault(self) -> torch.Tensor:","+        current = self.query_active_mask()","+        last = MooncakeEPAll2AllManager._last_mask","+        if last is None or last.shape != current.shape:","+            MooncakeEPAll2AllManager._last_mask = torch.zeros_like(current)","+            last = MooncakeEPAll2AllManager._last_mask","+        has_fault = (current != last).any()","+        return has_fault","+","+    def clean_buffers(self) -> None:","+        if MooncakeEPAll2AllManager._buffer is None:","+            return","+        state = MooncakeEPAll2AllManager._buffer","+        state.buffer.get_local_buffer_tensor(","+            dtype=torch.int8, use_rdma_buffer=True","+        ).zero_()","+        torch.accelerator.synchronize()","+        state.buffer.clean_mask_buffer()","+        torch.accelerator.synchronize()","+        MooncakeEPAll2AllManager._last_mask = None","+","+    def update_mask(self, rank: int, masked: bool = True) -> None:","+        state = MooncakeEPAll2AllManager._buffer","+        assert state is not None","+        state.buffer.update_mask_buffer(rank, mask=masked)","+        torch.accelerator.synchronize()","+        last = MooncakeEPAll2AllManager._last_mask","+        if last is None or last.shape[0] != state.active_ep_size:","+            MooncakeEPAll2AllManager._last_mask = torch.zeros(","+                state.active_ep_size, device=\"cuda\", dtype=torch.int32","+            )","+            last = MooncakeEPAll2AllManager._last_mask","+        last[rank] = int(masked)"],"additions":260,"deletions":0,"truncated":false},{"path":"vllm/distributed/elastic_ep/elastic_execute.py","lines":["@@ -74,7 +74,7 @@ def can_reuse_fused_moe_kernel(parallel_config: ParallelConfig) -> bool:","     The EP backend must preserve its CUDA graph entries when ranks are connected,","     disconnected, masked, or unmasked.","     \"\"\"","-    return parallel_config.all2all_backend == \"nixl_ep\"","+    return parallel_config.all2all_backend in (\"nixl_ep\", \"mooncake_ep\")"," "," "," def batch_transfer_weights("],"additions":1,"deletions":1,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/all2all_utils.py","lines":["@@ -39,6 +39,7 @@"," from vllm.utils.import_utils import (","     has_deep_ep,","     has_deep_ep_v2,","+    has_mooncake_ep,","     has_moonep,","     has_mori,","     has_nixl_ep,","@@ -121,6 +122,11 @@ def flashinfer_one_sided_dispatch_layout(","     if has_mori():","         from .prepare_finalize.mori import MoriPrepareAndFinalize","         from .prepare_finalize.mori_epv2 import MoriEPv2PrepareAndFinalize","+    if has_mooncake_ep():","+        from .prepare_finalize.mooncake_ep import (","+            MOONCAKE_EP_QUANT_BLOCK_SHAPE,","+            MooncakeEPPrepareAndFinalize,","+        )","     if has_nixl_ep():","         from .prepare_finalize.nixl_ep import (","             NIXL_EP_QUANT_BLOCK_SHAPE,","@@ -469,6 +475,38 @@ def maybe_make_prepare_finalize(","             num_dispatchers=all2all_manager.world_size,","         )"," ","+    elif moe.use_mooncake_ep_kernels:","+        assert quant_config is not None","+        global_to_physical = physical_to_global = local_expert_global_ids = None","+        if routing_tables is not None:","+            (","+                global_to_physical,","+                physical_to_global,","+                local_expert_global_ids,","+            ) = routing_tables","+        all_to_all_args = dict(","+            max_num_tokens_per_dp_rank=moe.max_num_tokens,","+            token_hidden_size=moe.hidden_dim,","+            num_local_experts=moe.num_local_experts,","+        )","+        handle = all2all_manager.get_handle(all_to_all_args)","+","+        # Note: We may want to use FP8 dispatch just to reduce","+        # data movement.","+        use_fp8_dispatch = (","+            quant_config.quant_dtype == current_platform.fp8_dtype()","+            and quant_config.block_shape == MOONCAKE_EP_QUANT_BLOCK_SHAPE","+        )","+","+        prepare_finalize = MooncakeEPPrepareAndFinalize(","+            handle,","+            max_tokens_per_rank=moe.max_num_tokens,","+            num_dispatchers=all2all_manager.max_num_ep_ranks,","+            expert_capacity=moe.num_local_experts * all2all_manager.max_num_ep_ranks,","+            use_fp8_dispatch=use_fp8_dispatch,","+            global_to_physical=global_to_physical,","+        )","+","     elif moe.use_nixl_ep_kernels:","         assert quant_config is not None","         global_to_physical = physical_to_global = local_expert_global_ids = None"],"additions":38,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/config.py","lines":["@@ -1117,7 +1117,11 @@ def use_fi_nvl_one_sided_kernels(self):"," ","     @property","     def needs_round_robin_routing_tables(self):","-        return self.use_deepep_ll_kernels or self.use_nixl_ep_kernels","+        return (","+            self.use_deepep_ll_kernels","+            or self.use_nixl_ep_kernels","+            or self.use_mooncake_ep_kernels","+        )"," ","     @property","     def use_ag_rs_all2all_kernels(self):","@@ -1153,6 +1157,10 @@ def use_mori_epv2_kernels(self):","             and self.mori_ep_v2","         )"," ","+    @property","+    def use_mooncake_ep_kernels(self):","+        return self.use_all2all_kernels and self.all2all_backend == \"mooncake_ep\"","+","     @property","     def use_nixl_ep_kernels(self):","         return self.use_all2all_kernels and self.all2all_backend == \"nixl_ep\"","@@ -1501,6 +1509,7 @@ def activation_format(self) -> \"FusedMoEActivationFormat\":","         if (","             conf.use_deepep_ll_kernels","             or conf.use_nixl_ep_kernels","+            or conf.use_mooncake_ep_kernels","             or conf.use_alltoall_batched_kernels","             or self.moe_backend == \"batched_triton\"","         ):","@@ -1672,6 +1681,10 @@ def use_ag_rs_all2all_kernels(self):","     def use_alltoall_batched_kernels(self):","         return self.moe_parallel_config.use_alltoall_batched_kernels"," ","+    @property","+    def use_mooncake_ep_kernels(self):","+        return self.moe_parallel_config.use_mooncake_ep_kernels","+","     @property","     def use_nixl_ep_kernels(self):","         return self.moe_parallel_config.use_nixl_ep_kernels"],"additions":14,"deletions":1,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/prepare_finalize/mooncake_ep.py","lines":["@@ -0,0 +1,227 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+from collections.abc import Callable","+","+import torch","+","+import vllm.model_executor.layers.fused_moe.modular_kernel as mk","+from vllm.model_executor.layers.fused_moe.config import FusedMoEQuantConfig","+from vllm.model_executor.layers.fused_moe.topk_weight_and_reduce import (","+    TopKWeightAndReduceDelegate,","+)","+from vllm.v1.worker.ubatching import (","+    dbo_current_ubatch_id,","+    dbo_enabled,","+    dbo_maybe_run_recv_hook,","+)","+","+MOONCAKE_EP_QUANT_BLOCK_SHAPE = [128, 128]","+","+","+class MooncakeEPPrepareAndFinalize(mk.FusedMoEPrepareAndFinalizeModular):","+    \"\"\"Prepare/Finalize using the Mooncake EP backend.\"\"\"","+","+    def __init__(","+        self,","+        buffer,","+        max_tokens_per_rank: int,","+        num_dispatchers: int,","+        expert_capacity: int,","+        use_fp8_dispatch: bool = False,","+        global_to_physical: torch.Tensor | None = None,","+    ):","+        super().__init__()","+        self.buffer = buffer","+        self.max_tokens_per_rank = max_tokens_per_rank","+        self.num_dispatchers_ = num_dispatchers","+        # Keep dispatch shapes and captured kernels stable across EP resizing.","+        self.expert_capacity = expert_capacity","+        self.use_fp8_dispatch = use_fp8_dispatch","+        self.global_to_physical = (","+            global_to_physical.to(torch.int64)","+            if global_to_physical is not None","+            else None","+        )","+        self.handles: list[tuple | None] = [None, None]","+","+    def num_dispatchers(self) -> int:","+        return self.num_dispatchers_","+","+    def output_is_reduced(self) -> bool:","+        return True","+","+    @property","+    def activation_format(self) -> mk.FusedMoEActivationFormat:","+        return mk.FusedMoEActivationFormat.BatchedExperts","+","+    def max_num_tokens_per_rank(self) -> int | None:","+        return self.max_tokens_per_rank","+","+    def topk_indices_dtype(self) -> torch.dtype | None:","+        return torch.int64","+","+    def supports_async(self) -> bool:","+        return True","+","+    def _map_global_to_physical_ids(self, topk_ids: torch.Tensor) -> torch.Tensor:","+        if self.global_to_physical is None:","+            return topk_ids.to(torch.int64)","+        return self.global_to_physical[topk_ids]","+","+    def _check_supported(self, a1: torch.Tensor, quant_config: FusedMoEQuantConfig):","+        if a1.dtype != torch.bfloat16:","+            raise NotImplementedError(\"Mooncake EP currently supports BF16 activations\")","+        if quant_config.quant_dtype is not None and not self.use_fp8_dispatch:","+            raise NotImplementedError(","+                \"Mooncake EP supports BF16 and blockwise FP8 dispatch only\"","+            )","+","+    def prepare_async(","+        self,","+        a1: torch.Tensor,","+        topk_weights: torch.Tensor,","+        topk_ids: torch.Tensor,","+        num_experts: int,","+        expert_map: torch.Tensor | None,","+        apply_router_weight_on_input: bool,","+        quant_config: FusedMoEQuantConfig,","+        defer_input_quant: bool = False,","+    ) -> tuple[Callable, mk.ReceiverType]:","+        if defer_input_quant:","+            raise NotImplementedError(","+                \"Mooncake EP does not support deferred input quantization\"","+            )","+        self._check_supported(a1, quant_config)","+        if apply_router_weight_on_input:","+            if topk_ids.size(1) != 1:","+                raise NotImplementedError(","+                    \"Mooncake EP input weighting supports top-k=1\"","+                )","+            a1 = a1 * topk_weights.to(a1.dtype)","+","+        a2a_idx = dbo_current_ubatch_id()","+        expert_x, expert_num_tokens, handle, _, hook = self.buffer.dispatch(","+            a1,","+            self._map_global_to_physical_ids(topk_ids).contiguous(),","+            num_max_dispatch_tokens_per_rank=self.max_tokens_per_rank,","+            num_experts=self.expert_capacity,","+            use_fp8=self.use_fp8_dispatch,","+            async_finish=False,","+            return_recv_hook=True,","+        )","+        self.handles[a2a_idx] = handle","+","+        return hook, lambda: self._receiver(expert_x, expert_num_tokens)","+","+    def _receiver(","+        self,","+        expert_x: torch.Tensor | tuple[torch.Tensor, torch.Tensor],","+        expert_num_tokens: torch.Tensor,","+    ) -> mk.PrepareResultType:","+        if self.use_fp8_dispatch:","+            assert isinstance(expert_x, tuple)","+            expert_x, expert_x_scale = expert_x","+        else:","+            assert isinstance(expert_x, torch.Tensor)","+            expert_x_scale = None","+        metadata = mk.ExpertTokensMetadata(","+            expert_num_tokens=expert_num_tokens, expert_num_tokens_cpu=None","+        )","+        return expert_x, expert_x_scale, metadata, None, None","+","+    def prepare(","+        self,","+        a1: torch.Tensor,","+        topk_weights: torch.Tensor,","+        topk_ids: torch.Tensor,","+        num_experts: int,","+        expert_map: torch.Tensor | None,","+        apply_router_weight_on_input: bool,","+        quant_config: FusedMoEQuantConfig,","+        defer_input_quant: bool = False,","+    ) -> mk.PrepareResultType:","+        hook, receiver = self.prepare_async(","+            a1,","+            topk_weights,","+            topk_ids,","+            num_experts,","+            expert_map,","+            apply_router_weight_on_input,","+            quant_config,","+            defer_input_quant,","+        )","+        if hook is not None:","+            hook()","+        return receiver()","+","+    def _finalize(","+        self,","+        output: torch.Tensor,","+        fused_expert_output: torch.Tensor,","+        topk_weights: torch.Tensor,","+        topk_ids: torch.Tensor,","+        apply_router_weight_on_input: bool,","+        weight_and_reduce_impl: mk.TopKWeightAndReduce,","+        do_async: bool,","+    ) -> tuple[Callable, Callable]:","+        assert isinstance(weight_and_reduce_impl, TopKWeightAndReduceDelegate)","+        a2a_idx = dbo_current_ubatch_id()","+        do_recv_hook = dbo_enabled() or do_async","+        handle = self.handles[a2a_idx]","+        assert handle is not None","+        combine_weights = (","+            torch.ones_like(topk_weights)","+            if apply_router_weight_on_input","+            else topk_weights","+        )","+        dbo_maybe_run_recv_hook()","+        _, _, recv_hook = self.buffer.combine(","+            fused_expert_output,","+            self._map_global_to_physical_ids(topk_ids).contiguous(),","+            combine_weights.contiguous(),","+            handle=handle,","+            zero_copy=False,","+            async_finish=False,","+            return_recv_hook=do_recv_hook,","+            out=output,","+        )","+        return recv_hook, lambda: None","+","+    def finalize_async(","+        self,","+        output,","+        fused_expert_output,","+        topk_weights,","+        topk_ids,","+        apply_router_weight_on_input,","+        weight_and_reduce_impl,","+    ):","+        return self._finalize(","+            output,","+            fused_expert_output,","+            topk_weights,","+            topk_ids,","+            apply_router_weight_on_input,","+            weight_and_reduce_impl,","+            do_async=True,","+        )","+","+    def finalize(","+        self,","+        output,","+        fused_expert_output,","+        topk_weights,","+        topk_ids,","+        apply_router_weight_on_input,","+        weight_and_reduce_impl,","+    ) -> None:","+        self._finalize(","+            output,","+            fused_expert_output,","+            topk_weights,","+            topk_ids,","+            apply_router_weight_on_input,","+            weight_and_reduce_impl,","+            do_async=False,","+        )"],"additions":227,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/utils.py","lines":["@@ -506,7 +506,7 @@ def get_fused_shared_expert_layers(","     an `nn.ModuleList`, and absolute for `nn.ModuleDict` MTP layers keyed by","     layer index. No loader needs to hard-code an offset."," ","-    Also rejects mixed fusion when EPLB is enabled or the `nixl_ep` all2all","+    Also rejects mixed fusion when EPLB is enabled or an elastic-buffer all2all","     backend is selected, and logs the resolved policy.","     \"\"\"","     fused_layers: set[int] = set()","@@ -545,7 +545,7 @@ def get_fused_shared_expert_layers(","         all2all_backend = (","             parallel_config.all2all_backend if parallel_config is not None else None"],"additions":1,"deletions":1,"truncated":false}],"additions":578,"deletions":4,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-28T17:09:59.805832+00: