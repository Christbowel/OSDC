{"id":"a03b6bc1bd5efdcaa4c08486000f5a9712acb0a6","axis":"silent","repo":"pnpm/pnpm","sha":"a03b6bc1bd5efdcaa4c08486000f5a9712acb0a6","parsed":{"files":[{"path":".changeset/side-effects-cache-exclude.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+Added the `sideEffectsCache.exclude` setting for packages whose build output depends on the environment, such as native addons that read `JAVA_HOME`. pnpm builds the listed packages in every project and never restores or saves their builds through the side-effects cache. Under the global virtual store, each project gets its own copy of these packages and of the packages that depend on them. Entries use the same `name`, `@scope/*`, and `name@version` patterns as `minimumReleaseAgeExclude` [#5271](https://github.com/pnpm/pnpm/issues/5271)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -164,6 +164,7 @@ mod self_update;"," mod set_script;"," mod setting_flags;"," mod side_effects_cache;","+mod side_effects_cache_exclude;"," mod stage;"," mod stale_pin_dedupe;"," mod star_tests;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/side_effects_cache_exclude.rs","lines":["@@ -0,0 +1,116 @@","+//! `sideEffectsCache.exclude`: builds that must run in every project","+//! because their output depends on the environment.","+//!","+//! Regression coverage for <https://github.com/pnpm/pnpm/issues/5271>.","+","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::{","+    bin::{AddMockedRegistry, CommandTempCwd},","+    command_env::CommandTestExt,","+};","+use std::{fmt::Write, fs, path::Path, process::Command};","+","+/// Writes the environment of its `install` script to `env.json`.","+const ENV_WRITER: &str = \"@pnpm.e2e/write-lifecycle-env\";","+","+#[test]","+fn a_cached_build_reaches_a_project_that_builds_in_another_environment() {","+    assert_eq!(build_flavors(&Layout::default()), [\"first\", \"first\"]);","+}","+","+#[test]","+fn an_excluded_package_is_built_in_every_project() {","+    let layout = Layout { exclude: true, ..Layout::default() };","+    assert_eq!(build_flavors(&layout), [\"first\", \"second\"]);","+}","+","+/// The first project's flavor is checked after the second install too: a","+/// second build into a slot the two projects shared would overwrite it.","+#[test]","+fn an_excluded_package_is_built_in_every_project_under_the_global_virtual_store() {","+    let layout = Layout { exclude: true, global_virtual_store: true };","+    assert_eq!(build_flavors(&layout), [\"first\", \"second\"]);","+}","+","+#[derive(Default)]","+struct Layout {","+    exclude: bool,","+    global_virtual_store: bool,","+}","+","+/// Install [`ENV_WRITER`] in two projects that share one store, with","+/// `BUILD_FLAVOR` set to `first` and then `second`, and return the","+/// flavor each project's build output records once both are installed.","+fn build_flavors(layout: &Layout) -> [String; 2] {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    configure(&workspace, layout);","+    let second = root.path().join(\"second\");","+    fs::create_dir(&second).expect(\"create the second project\");","+    for file in [\".npmrc\", \"pnpm-workspace.yaml\", \"package.json\"] {","+        fs::copy(workspace.join(file), second.join(file)).expect(\"copy the project files\");","+    }","+","+    install(&workspace, \"first\");","+    assert_eq!(build_flavor(&workspace), \"first\");","+    install(&second, \"second\");","+    let flavors = [build_flavor(&workspace), build_flavor(&second)];","+","+    drop((root, mock_instance));","+    flavors","+}","+","+fn configure(workspace: &Path, layout: &Layout) {","+    let mut settings = format!(\"allowBuilds:\\n  '{ENV_WRITER}': true\\n\");","+    if layout.exclude {","+        writeln!(settings, \"sideEffectsCache:\\n  exclude:\\n    - '{ENV_WRITER}'\").expect(","+            \"format the sideEffectsCache.exclude entry\",","+        );","+    }","+    if layout.global_virtual_store {","+        crate::_utils::enable_gvs_in_workspace_yaml(workspace, &settings);","+    } else {","+        let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+        let mut yaml = fs::read_to_string(&yaml_path).expect(\"read pnpm-workspace.yaml\");","+        yaml.push_str(&settings);","+        fs::write(&yaml_path, yaml).expect(\"write pnpm-workspace.yaml\");","+    }","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { ENV_WRITER: \"1.0.0\" } }).to_string(),","+    )","+    .expect(\"write package.json\");","+}","+","+fn install(project: &Path, flavor: &str) {","+    let output = Command::cargo_bin(\"pnpm\")","+        .expect(\"find the pnpm binary\")","+        .without_ambient_pnpm_config()","+        .with_current_dir(project)","+        .with_env(\"BUILD_FLAVOR\", flavor)","+        .with_arg(\"install\")","+        .output()","+        .expect(\"run pnpm install\");","+    assert!(","+        output.status.success(),","+        \"install failed:\\n{}{}\",","+        String::from_utf8_lossy(&output.stdout),","+        String::from_utf8_lossy(&output.stderr),","+    );","+}","+","+fn build_flavor(project: &Path) -> String {","+    let env_json = project","+        .join(\"node_modules\")","+        .join(ENV_WRITER)","+        .join(\"env.json\");","+    let env: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&env_json).expect(\"read env.json\"))","+            .expect(\"parse env.json\");","+    env[\"BUILD_FLAVOR\"]","+        .as_str()","+        .expect(\"the build recorded BUILD_FLAVOR\")","+        .to_string()","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -939,6 +939,13 @@ pub struct Config {","     /// [`Config::side_effects_cache_write`].","     pub side_effects_cache_readonly: bool,"," ","+    /// `name[@version]` patterns of packages whose builds bypass the","+    /// side-effects cache: pnpm neither restores them from it nor saves","+    /// them to it, locally or remotely, and gives them a project's own","+    /// global-virtual-store slot. The `sideEffectsCache.exclude` setting,","+    /// for builds whose output depends on the environment they run in.","+    pub side_effects_cache_exclude: Option<Vec<String>>,","+","     /// How many times pacquet retries a failed tarball fetch on transient","     /// errors before giving up. The `fetchRetries` setting (default `2`).","     /// The value is the count of *retries*, so total attempts ="],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml.rs","lines":["@@ -296,18 +296,22 @@ fn global_shims_setting(config: &Config) -> crate::GlobalShimsSetting {"," }"," "," /// Reads and writes as resolved, in the boolean shorthand when they agree","-/// and no remote cache is configured. That is the shape pnpm reports and","-/// the one a hook is likeliest to assign.","+/// and neither a remote cache nor an exclude list is configured. That is","+/// the shape pnpm reports and the one a hook is likeliest to assign."," fn side_effects_cache_setting(config: &Config) -> SideEffectsCacheSetting {","     let read = config.side_effects_cache_read();","     let write = config.side_effects_cache_write();","-    if read == write && config.remote_side_effects_cache.is_none() {","+    if read == write","+        && config.remote_side_effects_cache.is_none()","+        && config.side_effects_cache_exclude.is_none()","+    {","         SideEffectsCacheSetting::Enabled(read)","     } else {","         SideEffectsCacheSetting::Settings(Box::new(SideEffectsCacheSettings {","             read: Some(read),","             write: Some(write),","             remote: config.remote_side_effects_cache.clone(),","+            exclude: config.side_effects_cache_exclude.clone(),","         }))","     }"," }"],"additions":7,"deletions":3,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/apply.rs","lines":["@@ -245,6 +245,7 @@ impl WorkspaceSettings {","                 if let Some(remote) = settings.remote {","                     config.remote_side_effects_cache.get_or_insert_default().overlay(remote);","                 }","+                overlay_some(&mut config.side_effects_cache_exclude, settings.exclude);","             }","             None => {}","         }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/reset.rs","lines":["@@ -262,6 +262,7 @@ impl WorkspaceSettings {","                 config.side_effects_cache_read_setting = defaults.side_effects_cache_read_setting;","                 config.side_effects_cache_write_setting = defaults.side_effects_cache_write_setting;","                 config.remote_side_effects_cache.clone_from(&defaults.remote_side_effects_cache);","+                config.side_effects_cache_exclude.clone_from(&defaults.side_effects_cache_exclude);","             }","             \"httpsProxy\" | \"httpProxy\" | \"proxy\" | \"noProxy\" | \"noproxy\" => {","                 reset_proxy_setting(config, defaults, key);"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/sections.rs","lines":["@@ -207,6 +207,8 @@ pub struct SideEffectsCacheSettings {","     /// Save a package's build output to the cache.","     pub write: Option<bool>,","     pub remote: Option<RemoteSideEffectsCacheSettings>,","+    /// See [`Config::side_effects_cache_exclude`](crate::settings::Config::side_effects_cache_exclude).","+    pub exclude: Option<Vec<String>>,"," }"," "," /// `audit` entry: settings that tune `pnpm audit`. Supersedes the"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests.rs","lines":["@@ -96,3 +96,5 @@ mod publish_wait_timeout;"," mod env_placeholders;"," "," mod readable_settings;","+","+mod side_effects_cache_exclude;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/side_effects_cache_exclude.rs","lines":["@@ -0,0 +1,43 @@","+use super::{Config, Path, SideEffectsCacheSetting, WorkspaceSettings, assert_eq};","+use crate::api::EnvVar;","+","+fn exclude_of(setting: Option<&SideEffectsCacheSetting>) -> Option<&Vec<String>> {","+    match setting {","+        Some(SideEffectsCacheSetting::Settings(settings)) => settings.exclude.as_ref(),","+        _ => None,","+    }","+}","+","+#[test]","+fn side_effects_cache_exclude_is_read_resolved_and_reset() {","+    let settings: WorkspaceSettings =","+        serde_saphyr::from_str(\"sideEffectsCache:\\n  exclude:\\n    - java\\n    - '@native/*'\\n\")","+            .unwrap();","+    let mut config = Config::default();","+    settings.apply_to(&mut config, Path::new(\"/workspace\"));","+    let expected = Some(vec![\"java\".to_string(), \"@native/*\".to_string()]);","+    assert_eq!(config.side_effects_cache_exclude, expected);","+    assert!(config.side_effects_cache_read() && config.side_effects_cache_write());","+    let resolved = WorkspaceSettings::from_resolved(&config);","+    assert_eq!(exclude_of(resolved.side_effects_cache.as_ref()), expected.as_ref());","+","+    assert!(WorkspaceSettings::reset_setting_to_default::<crate::Host>(","+        &mut config,","+        &Config::default(),","+        \"sideEffectsCache\",","+        Path::new(\"/workspace\"),","+    ));","+    assert_eq!(config.side_effects_cache_exclude, None);","+}","+","+#[test]","+fn side_effects_cache_exclude_reads_from_environment() {","+    struct Env;","+    impl EnvVar for Env {","+        fn var(name: &str) -> Option<String> {","+            (name == \"PNPM_CONFIG_SIDE_EFFECTS_CACHE\").then(|| r#\"{\"exclude\":[\"java\"]}\"#.to_owned())","+        }","+    }","+    let settings = WorkspaceSettings::from_pnpm_config_env::<Env>();","+    assert_eq!(exclude_of(settings.side_effects_cache.as_ref()), Some(&vec![\"java\".to_string()]));","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/build_modules.rs","lines":["@@ -26,7 +26,10 @@ use crate::{","     ImportIndexedDirError, ImportIndexedDirOpts, NEEDS_BUILD_MARKER, SkippedSnapshots,","     build_graph::build_graph,","     find_root_runtime_node_key, import_indexed_dir, store_index_key_for_resolution,","-    version_policy::{VersionPolicyError, expand_package_version_specs},","+    version_policy::{","+        PackageVersionPolicy, PolicyMatch, VersionPolicyError, create_package_version_policy,","+        expand_package_version_specs,","+    },"," };"," "," use derive_more::{Display, Error};"],"additions":4,"deletions":1,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/build_modules/allow_build_policy.rs","lines":["@@ -1,7 +1,8 @@"," //! Deciding which packages are allowed to run build scripts."," "," use super::{","-    Config, Cow, HashMap, HashSet, VersionPolicyError, expand_package_version_specs,","+    Config, Cow, HashMap, HashSet, PackageKey, PackageVersionPolicy, PolicyMatch,","+    VersionPolicyError, create_package_version_policy, expand_package_version_specs,","     get_pkg_id_with_patch_hash, index_of_dep_path_suffix, parse_name_version_from_key,","     remove_suffix,"," };","@@ -24,6 +25,7 @@ pub struct AllowBuildPolicy {","     allowed_git_repos: HashSet<String>,","     disallowed_git_repos: HashSet<String>,","     dangerously_allow_all: bool,","+    side_effects_cache_exclude: Option<PackageVersionPolicy>,"," }"," "," impl AllowBuildPolicy {","@@ -45,6 +47,7 @@ impl AllowBuildPolicy {","             allowed_git_repos: HashSet::new(),","             disallowed_git_repos: HashSet::new(),","             dangerously_allow_all,","+            side_effects_cache_exclude: None,","         }","     }"," ","@@ -64,6 +67,7 @@ impl AllowBuildPolicy {","             allowed_git_repos: HashSet::new(),","             disallowed_git_repos: HashSet::new(),","             dangerously_allow_all,","+            side_effects_cache_exclude: None,","         }","     }"," ","@@ -73,7 +77,10 @@ impl AllowBuildPolicy {","     /// from `pnpm-workspace.yaml`. pnpm v11 stopped reading these","     /// from `package.json#pnpm` — see pnpm/pacquet#397 item 5.","     pub fn from_config(config: &Config) -> Result<Self, VersionPolicyError> {","-        Self::from_approvals(&config.allow_builds, config.dangerously_allow_all_builds)","+        Self::from_approvals(&config.allow_builds, config.dangerously_allow_all_builds)?","+            .with_side_effects_cache_exclude(","+                config.side_effects_cache_exclude.as_deref().unwrap_or_default(),","+            )","     }"," ","     /// Build the policy from a map of `allowBuilds`-shaped keys to","@@ -100,6 +107,44 @@ impl AllowBuildPolicy {","         .with_git_repo_rules(allowed.git_repos, disallowed.git_repos))","     }"," ","+    /// Add the `sideEffectsCache.exclude` rules [`Self::caches_build`]","+    /// reads.","+    pub fn with_side_effects_cache_exclude(","+        mut self,","+        patterns: &[String],","+    ) -> Result<Self, VersionPolicyError> {","+        self.side_effects_cache_exclude =","+            if patterns.is_empty() { None } else { Some(create_package_version_policy(patterns)?) };","+        Ok(self)","+    }","+","+    /// Whether the build of the snapshot at `snapshot_key` may be","+    /// restored from, and saved to, the side-effects cache and shared","+    /// through a global-virtual-store slot. `false` for a package","+    /// `sideEffectsCache.exclude` names.","+    ///","+    /// A bare-name rule covers every resolution of the package, a git or","+    /// tarball URL included. A `name@version` rule names registry","+    /// versions only, from the default registry or a named one.","+    #[must_use]","+    pub fn caches_build(&self, snapshot_key: &PackageKey) -> bool {","+        let Some(exclude) = &self.side_effects_cache_exclude else {","+            return true;","+        };","+        match exclude.matches(&snapshot_key.name.to_string()) {","+            PolicyMatch::No => true,","+            PolicyMatch::AnyVersion => false,","+            PolicyMatch::ExactVersions(versions) => !snapshot_key.suffix","+                .version_semver()","+                .or_else(|| snapshot_key.suffix.registry_qualified().map(|(_, version)| version))","+                .is_some_and(|version| {","+                    versions","+                        .iter()","+                        .any(|exact| exact == &version.to_string())","+                }),","+        }","+    }","+","     #[must_use]","     fn with_git_repo_rules(","         mut self,"],"additions":47,"deletions":2,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/build_modules/build_one_snapshot/side_effects.rs","lines":["@@ -13,8 +13,9 @@ use super::{"," /// call free anyway, but routing through one value keeps the gate-side"," /// and write-side keys provably identical."," ///","-/// `None` when the cache gate can't fire (no engine, no graph, etc.);","-/// both downstream consumers short-circuit on `None`.","+/// `None` when the cache gate can't fire (no engine, no graph, etc.) or","+/// `sideEffectsCache.exclude` names the package; both downstream","+/// consumers short-circuit on `None`."," ///"," /// The `deps_state_cache` is shared across all scheduled nodes via"," /// `Mutex` because `calc_dep_state` is recursive and memoizes — a","@@ -25,6 +26,9 @@ pub(super) fn side_effects_cache_key(","     snapshot_key: &PackageKey,","     candidate: &BuildCandidate<'_>,"," ) -> Option<String> {","+    if !context.allow_build_policy.caches_build(snapshot_key) {","+        return None;","+    }","     let (graph, engine) = context.progress.dep_graph.zip(context.cache.engine_name)?;","     // Poison-recover: `calc_d