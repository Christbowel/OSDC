rt { resolveChangelogRenderer } from '../utils/resolve-changelog-renderer';"," import { resolveNxJsonConfigErrorMessage } from '../utils/resolve-nx-json-error-message';"," import { DEFAULT_CONVENTIONAL_COMMITS_CONFIG } from './conventional-commits';","@@ -947,6 +948,16 @@ export async function createNxReleaseConfig(","     }","   }"," ","+  // Before validateChangelogConfig, which reports any renderer path error as","+  // an unresolvable renderer","+  validateReleaseConfigTokens({","+    releaseTag: WORKSPACE_DEFAULTS.releaseTag,","+    git: rootGitConfig,","+    version: rootVersionConfig,","+    changelog: rootChangelogConfig,","+    groups: releaseGroups,","+  });","+","   const configError = validateChangelogConfig(","     releaseGroups,","     rootChangelogConfig","@@ -1437,6 +1448,56 @@ function isProjectPublic(","   }"," }"," ","+const releaseTagPatternTokens = ['version', 'projectName', 'releaseGroupName'];","+const commitMessageTokens = ['version', 'projectName'];","+const changelogFileTokens = ['projectName', 'projectRoot', 'workspaceRoot'];","+const changelogRendererTokens = ['workspaceRoot'];","+","+/**","+ * A release can interpolate these fields after it writes files, so an invalid","+ * token has to fail when the config is loaded","+ */","+function validateReleaseConfigTokens(","+  config: Pick<","+    NxReleaseConfig,","+    'releaseTag' | 'git' | 'version' | 'changelog' | 'groups'","+  >","+): void {","+  const templates: Array<[unknown, string[]]> = [","+    [config.releaseTag.pattern, releaseTagPatternTokens],","+    [config.git.commitMessage, commitMessageTokens],","+    [config.version.git.commitMessage, commitMessageTokens],","+    [config.changelog.git.commitMessage, commitMessageTokens],","+  ];","+  const { workspaceChangelog } = config.changelog;","+  if (workspaceChangelog) {","+    // The workspace changelog uses its entryWhenNoChanges as written","+    templates.push(","+      [workspaceChangelog.file, changelogFileTokens],","+      [workspaceChangelog.renderer, changelogRendererTokens]","+    );","+  }","+  for (const group of Object.values(config.groups)) {","+    templates.push([group.releaseTag.pattern, releaseTagPatternTokens]);","+    if (group.changelog) {","+      templates.push(","+        [group.changelog.file, changelogFileTokens],","+        [group.changelog.entryWhenNoChanges, changelogFileTokens],","+        [group.changelog.renderer, changelogRendererTokens]","+      );","+    }","+  }","+  for (const [template, tokens] of templates) {","+    if (typeof template === 'string') {","+      validateReleaseConfigTemplate(template, tokens);","+    }","+  }","+}","+","+export function validateCommitMessageTokens(commitMessage: string): void {","+  validateReleaseConfigTemplate(commitMessage, commitMessageTokens);","+}","+"," /**","  * We need to ensure that changelog renderers are resolvable up front so that we do not end up erroring after performing","  * actions later, and we also make sure that any configured createRelease options are valid."],"additions":61,"deletions":0,"truncated":false},{"path":"packages/nx/src/command-line/release/utils/git.spec.ts","lines":["@@ -616,6 +616,22 @@ See merge request nx-release-test/nx-release-test!2`,"," ","       expect(result).toEqual(null);","     });","+","+    it('should throw when the pattern reads an environment variable', async () => {","+      await expect(","+        getLatestGitTagForPattern(","+          'v{version}-{env.CHANNEL}',","+          {},","+          mockResolveTags,","+          {","+            requireSemver: true,","+            strictPreid: false,","+          }","+        )","+      ).rejects.toThrow(","+        \"Release configuration 'v{version}-{env.CHANNEL}' is invalid. It can't read environment variables\"","+      );","+    });","   });"," ","   describe('sanitizeProjectNameForGitTag', () => {"],"additions":16,"deletions":0,"truncated":false},{"path":"packages/nx/src/command-line/release/utils/git.ts","lines":["@@ -4,7 +4,7 @@","  */"," import { relative } from 'node:path';"," import { coerce as semverCoerce, gte as semverGte } from 'semver';","-import { interpolate } from '../../../tasks-runner/utils';","+import { interpolateReleaseConfig } from './interpolate-release-config';"," import { workspaceRoot } from '../../../utils/workspace-root';"," import { execCommand } from './exec-command';"," import type { CheckAllBranchesWhen, RepoGitTags } from './repository-git-tags';","@@ -147,6 +147,14 @@ export async function getLatestGitTagForPattern("," ): Promise<GitTagAndVersion | null> {","   const { requireSemver, strictPreid, preid, checkAllBranchesWhen } = options;"," ","+  // Outside the try: an invalid pattern must fail, not read as \"no tags\"","+  const interpolatedTagPattern = interpolateReleaseConfig(releaseTagPattern, {","+    version: '%v%',","+    projectName: '%p%',","+    releaseGroupName: '%rg%',","+    ...additionalInterpolationData,","+  });","+","   try {","     let tags: string[] = await resolveTags(checkAllBranchesWhen);"," ","@@ -154,13 +162,6 @@ export async function getLatestGitTagForPattern(","       return null;","     }"," ","-    const interpolatedTagPattern = interpolate(releaseTagPattern, {","-      version: '%v%',","-      projectName: '%p%',","-      releaseGroupName: '%rg%',","-      ...additionalInterpolationData,","-    });","-","     const tagRegexp = `^${escapeRegExp(interpolatedTagPattern)","       .replace('%v%', '(.+)')","       .replace('%p%', '(.+)')"],"additions":9,"deletions":8,"truncated":false},{"path":"packages/nx/src/command-line/release/utils/interpolate-release-config.ts","lines":["@@ -0,0 +1,51 @@","+import { parseTokens } from '../../../tasks-runner/tokens';","+import { interpolate } from '../../../tasks-runner/utils';","+","+// A call site passes only the values it has, so a fallback is found by name","+const releaseTokens = new Set([","+  'version',","+  'projectName',","+  'releaseGroupName',","+  'projectRoot',","+  'workspaceRoot',","+]);","+","+export function interpolateReleaseConfig(","+  template: string,","+  data: Record<string, unknown>","+): string {","+  rejectFallbacks(template);","+  return interpolate(template, data, {","+    envNotAllowed: (template) =>","+      `Release configuration '${template}' is invalid. It can't read environment variables, because every release run must resolve it the same way.`,","+  });","+}","+","+/**","+ * Throws what `interpolateReleaseConfig` throws for `template` when it gets","+ * values for `tokens`, so a release can fail before it writes anything","+ */","+export function validateReleaseConfigTemplate(","+  template: string,","+  tokens: readonly string[]","+): void {","+  interpolateReleaseConfig(","+    template,","+    Object.fromEntries(tokens.map((token) => [token, '']))","+  );","+}","+","+// Tags, commit messages and the previous-tag lookup fill in different values,","+// so a fallback wouldn't resolve the same way in each","+function rejectFallbacks(template: string): void {","+  const nodes = parseTokens(template, {","+    isToken: (name) => name === 'env' || releaseTokens.has(name),","+    read: () => undefined,","+    noValue: (token) => token,","+  });","+  if (nodes.some((node) => node.kind === 'token' && node.parts.length > 1)) {","+    throw new Error(","+      `Release configuration '${template}' is invalid. It can't use ?? fallbacks.`","+    );","+  }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"packages/nx/src/command-line/release/utils/resolve-changelog-renderer.ts","lines":["@@ -3,7 +3,7 @@ import {","   loadTsFile,","   requireWithTsconfigFallback,"," } from '../../../plugins/js/utils/register';","-import { interpolate } from '../../../tasks-runner/utils';","+import { interpolateReleaseConfig } from './interpolate-release-config';"," import { workspaceRoot } from '../../../utils/workspace-root';"," "," export function resolveChangelogRenderer(","@@ -14,7 +14,7 @@ export function resolveChangelogRenderer