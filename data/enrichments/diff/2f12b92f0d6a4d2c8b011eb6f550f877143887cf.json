4, Shape{1}, {1});","+    const auto kernel = context.mark_node(std::make_shared<v8::Slice>(weight_shape, starts, stops, steps));","+","+    std::vector<int64_t> ones(spatial_dims, 1);","+    std::vector<int64_t> divisors(spatial_dims, 2);","+    std::vector<int64_t> dilation_values(dilations.begin(), dilations.end());","+    const auto one = context.mark_node(v0::Constant::create(element::i64, Shape{spatial_dims}, ones));","+    const auto dilation = context.mark_node(v0::Constant::create(element::i64, Shape{spatial_dims}, dilation_values));","+    const auto kernel_minus_one = context.mark_node(std::make_shared<v1::Subtract>(kernel, one));","+    const auto effective_padding = context.mark_node(std::make_shared<v1::Multiply>(kernel_minus_one, dilation));","+    const auto divisor = context.mark_node(v0::Constant::create(element::i64, Shape{spatial_dims}, divisors));","+    const auto pads_begin_spatial = context.mark_node(std::make_shared<v1::Divide>(effective_padding, divisor, false));","+    const auto pads_end_spatial =","+        context.mark_node(std::make_shared<v1::Subtract>(effective_padding, pads_begin_spatial));","+","+    const auto no_padding = context.mark_node(v0::Constant::create(element::i64, Shape{2}, {0, 0}));","+    const auto pads_begin =","+        context.mark_node(std::make_shared<v0::Concat>(OutputVector{no_padding, pads_begin_spatial}, 0));","+    const auto pads_end =","+        context.mark_node(std::make_shared<v0::Concat>(OutputVector{no_padding, pads_end_spatial}, 0));","+    const auto pad_value =","+        context.mark_node(std::make_shared<v1::ConvertLike>(v0::Constant::create(element::f32, Shape{}, {0}), input));","+    return context.mark_node(std::make_shared<v12::Pad>(input, pads_begin, pads_end, pad_value, PadMode::CONSTANT));","+}","+"," Output<Node> concat_list_construct(const Output<Node>& input) {","     if (auto seq_mark = ov::as_type_ptr<SequenceMark>(input.get_node_shared_ptr())) {","         auto list_inputs = seq_mar