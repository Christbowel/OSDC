{"id":"3cd03c52625cf304892884af8f6093940b554741","axis":"silent","repo":"aws/aws-sdk-net","sha":"3cd03c52625cf304892884af8f6093940b554741","parsed":{"files":[{"path":"changelogs/SDK.CHANGELOG.2026.md","lines":["@@ -1,3 +1,31 @@","+### 4.0.317.0 (2026-08-21 18:32 UTC)","+* Backup (4.0.101.4)","+\t* Updating CLI Docs for Backup Audit Manager List Job Summaries APIs.","+* BedrockAgentCore (4.0.107.0)","+\t* Increase spans count from 1k to 20k","+* BedrockAgentCoreControl (4.0.112.0)","+\t* Update Dataset schema to THIRDPARTYEVALUATIONV1","+* CloudWatch (4.0.104.0)","+\t* Allows customers to specify an initial warm up period to wait for metrics to arrive when creating metric or log alarms","+* DeviceFarm (4.0.102.0)","+\t* Added support to CreateRemoveAccessSession for selecting a server version on the mobile WebDriver endpoint.","+* Kinesis (4.0.101.0)","+\t* Generate account endpoint for Kinesis Data Streams requests when the account ID is available","+* MarketplaceReporting (4.0.100.11)","+\t* MarketplaceReporting is now generated from its Smithy model. There are no changes to the public API.","+* SSO (4.0.100.12)","+\t* Removed the Content-Type header from requests that do not have a request body.","+* SSOOIDC (4.0.100.11)","+\t* SSOOIDC is now generated from its Smithy model. There are no changes to the public API.","+* SupportApp (4.0.100.12)","+\t* Removed the Content-Type header from requests that do not have a request body.","+* Uxc (4.0.100.11)","+\t* Uxc is now generated from its Smithy model. There are no changes to the public API.","+* WAFV2 (4.0.101.5)","+\t* DataProtectionConfig field Key Documentation Update","+* Extensions.CloudFront.Signers (4.0.101.0)","+\t* Added ICloudFrontSigner and DelegateCloudFrontSigner, plus overloads of AmazonCloudFrontUrlSigner.SignUrl/GetCustomSignedURL and AmazonCloudFrontCookieSigner.GetCookiesForCustomPolicy that accept an ICloudFrontSigner, so policies can be signed with AWS KMS or another external signer (RSA or ECDSA P-256) without holding the private key in the process.","+"," ### 4.0.316.0 (2026-08-20 18:19 UTC)"," * Amplify (4.0.102.0)"," \t* Increased the maximum allowed length from 255 to 4,096 characters to support longer access tokens."],"additions":28,"deletions":0,"truncated":false},{"path":"changelogs/SDK.CHANGELOG.ALL.md","lines":["@@ -1,3 +1,31 @@","+### 4.0.317.0 (2026-08-21 18:32 UTC)","+* Backup (4.0.101.4)","+\t* Updating CLI Docs for Backup Audit Manager List Job Summaries APIs.","+* BedrockAgentCore (4.0.107.0)","+\t* Increase spans count from 1k to 20k","+* BedrockAgentCoreControl (4.0.112.0)","+\t* Update Dataset schema to THIRDPARTYEVALUATIONV1","+* CloudWatch (4.0.104.0)","+\t* Allows customers to specify an initial warm up period to wait for metrics to arrive when creating metric or log alarms","+* DeviceFarm (4.0.102.0)","+\t* Added support to CreateRemoveAccessSession for selecting a server version on the mobile WebDriver endpoint.","+* Kinesis (4.0.101.0)","+\t* Generate account endpoint for Kinesis Data Streams requests when the account ID is available","+* MarketplaceReporting (4.0.100.11)","+\t* MarketplaceReporting is now generated from its Smithy model. There are no changes to the public API.","+* SSO (4.0.100.12)","+\t* Removed the Content-Type header from requests that do not have a request body.","+* SSOOIDC (4.0.100.11)","+\t* SSOOIDC is now generated from its Smithy model. There are no changes to the public API.","+* SupportApp (4.0.100.12)","+\t* Removed the Content-Type header from requests that do not have a request body.","+* Uxc (4.0.100.11)","+\t* Uxc is now generated from its Smithy model. There are no changes to the public API.","+* WAFV2 (4.0.101.5)","+\t* DataProtectionConfig field Key Documentation Update","+* Extensions.CloudFront.Signers (4.0.101.0)","+\t* Added ICloudFrontSigner and DelegateCloudFrontSigner, plus overloads of AmazonCloudFrontUrlSigner.SignUrl/GetCustomSignedURL and AmazonCloudFrontCookieSigner.GetCookiesForCustomPolicy that accept an ICloudFrontSigner, so policies can be signed with AWS KMS or another external signer (RSA or ECDSA P-256) without holding the private key in the process.","+"," ### 4.0.316.0 (2026-08-20 18:19 UTC)"," * Amplify (4.0.102.0)"," \t* Increased the maximum allowed length from 255 to 4,096 characters to support longer access tokens."],"additions":28,"deletions":0,"truncated":false},{"path":"extensions/src/AWSSDK.Extensions.CloudFront.Signers/AWSSDK.Extensions.CloudFront.Signers.nuspec","lines":["@@ -3,7 +3,7 @@","   <metadata>","     <id>AWSSDK.Extensions.CloudFront.Signers</id>","     <title>AWSSDK - Extensions for AWS CloudFront</title>","-    <version>4.0.100.10</version>","+    <version>4.0.101.0</version>","     <authors>Amazon Web Services</authors>","     <description>This package contains extension methods for creating signed URLs for Amazon CloudFront distributions and for creating signed cookies for Amazon CloudFront distributions using canned or custom policies.</description>","     <language>en-US</language>"],"additions":1,"deletions":1,"truncated":false},{"path":"extensions/src/AWSSDK.Extensions.CloudFront.Signers/Properties/AssemblyInfo.cs","lines":["@@ -16,4 +16,4 @@"," [assembly: ComVisible(false)]"," "," [assembly: AssemblyVersion(\"4.0\")]","-[assembly: AssemblyFileVersion(\"4.0.100.10\")]","+[assembly: AssemblyFileVersion(\"4.0.101.0\")]"],"additions":1,"deletions":1,"truncated":false},{"path":"generator/.DevConfigs/ac51c45f-b8c9-43fa-936f-1c4cea3806c8.json","lines":["@@ -1,11 +0,0 @@","-{","-  \"extensions\": [","-    {","-      \"extensionName\": \"Extensions.CloudFront.Signers\",","-      \"type\": \"minor\",","-      \"changeLogMessages\": [","-        \"Added ICloudFrontSigner and DelegateCloudFrontSigner, plus overloads of AmazonCloudFrontUrlSigner.SignUrl/GetCustomSignedURL and AmazonCloudFrontCookieSigner.GetCookiesForCustomPolicy that accept an ICloudFrontSigner, so policies can be signed with AWS KMS or another external 