ceCollection } from '../../../../../platform/instantiation/common/serviceCollection.js';"," import { ISessionPaneContent } from '../../../../../workbench/services/sessions/common/sessionPane.js';","@@ -868,7 +869,8 @@ suite('SessionsManagementService', () => {"," \t\t\t\tdisposable: (view.gridHost as Partial<IDisposable>).dispose !== undefined,"," \t\t\t\thosts: sessionHostService.hosts.get().filter(host => host.kind === SessionHostKind.MainWindow).length,"," \t\t\t\tinjected: injected === view.gridHost,","-\t\t\t\trootRegistration: getSingletonServiceDescriptors().some(([id]) => id === ISessionHost),","+\t\t\t\t// Editor windows register their own root host, which shows what a feature binds; the Agents window registers none","+\t\t\t\trootRegistration: getSingletonServiceDescriptors().some(([id, descriptor]) => id === ISessionHost && descriptor.ctor !== EditorWindowMainSessionHost),"," \t\t\t\trootInjection,"," \t\t\t\tshownBefore,"," \t\t\t\tshownAfter: view.gridHost.session.get()?.sessionId,"],"additions":3,"deletions":1,"truncated":false},{"path":"src/vs/sessions/sessions.desktop.main.ts","lines":["@@ -264,7 +264,7 @@ import './contrib/providers/remoteAgentHost/browser/tunnelAgentHost.contribution"," import './contrib/providers/remoteAgentHost/browser/wslAgentHost.contribution.js';"," import './contrib/providers/remoteAgentHost/browser/sshAgentHost.contribution.js';"," import './contrib/providers/remoteAgentHost/browser/webSocketAgentHost.contribution.js';","-import './contrib/providers/remoteAgentHost/browser/devContainerAgentHostService.contribution.js';","+import '../workbench/contrib/sessions/providers/remoteAgentHost/browser/devContainerAgentHostService.contribution.js';"," import './contrib/providers/remoteAgentHost/browser/remoteWorkspaceHandoffService.js';"," import './contrib/providers/remoteAgentHost/electron-browser/devContainerAgentHostConnector.contribution.js';"," import './contrib/providers/remoteAgentHost/electron-browser/remotes.contribution.js';"],"additions":1,"deletions":1,"truncated":false},{"path":"src/vs/workbench/contrib/sessions/browser/agentsView/agentsViewProviders.ts","lines":["@@ -0,0 +1,29 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { IDisposable } from '../../../../../base/common/lifecycle.js';","+import { createDecorator } from '../../../../../platform/instantiation/common/instantiation.js';","+","+export const IAgentsViewProvidersService = createDecorator<IAgentsViewProvidersService>('agentsViewProvidersService');","+","+/**","+ * Holds the sessions providers of an editor window. Their sessions are known only while something holds them: what shows","+ * sessions while it shows (see `IEditorWindowSessionsRuntime`), or an open of a session until it shows.","+ */","+export interface IAgentsViewProvidersService {","+\treadonly _serviceBrand: undefined;","+","+\t/** Registers the providers, unless they are, and holds them until the returned disposable is disposed. */","+\tacquire(): IDisposable;","+","+\t/** Asks `participant` before it releases the providers, until the returned disposable is disposed. */","+\tregisterReleaseParticipant(participant: IAgentsViewProvidersReleaseParticipant): IDisposable;","+}","+","+/** What takes part as the providers of an editor window are released, such as what holds new-session composers, whose drafts are their sessions. */","+export interface IAgentsViewProvidersReleaseParticipant {","+\t/** Prepares for the providers to go, such as by closing the composers the user left; resolves to whether they can go. */","+\tprepareRelease(): Promise<boolean>;","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"src/vs/workbench/contrib/sessions/browser/agentsView/editorWindowMainSessionHost.ts","lines":["@@ -0,0 +1,68 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { mainWindow } from '../../../../../base/browser/window.js';","+import { IDisposable, toDisposable } from '../../../../../base/common/lifecycle.js';","+import { constObservable, derived, IObservable, ISettableObservable, observableValue } from '../../../../../base/common/observable.js';","+import { IContextKeyService } from '../../../../../platform/contextkey/common/contextkey.js';","+import { SessionHost, SessionHostKind } from '../../../../services/sessions/browser/sessionHost.js';","+import { IChat, ISession } from '../../../../services/sessions/common/session.js';","+","+/** A chat with its session, such as the one the active tab of the chat part shows. */","+export interface IEditorWindowShownChat {","+\treadonly session: ISession;","+\treadonly chat: IChat;","+}","+","+/**","+ * The session host of an editor window, as the service `ISessionHost` of the window: it shows the chat that a feature binds","+ * (see {@link bindShownChat}), such as that of the active tab of the chat part. What the editors of the editor area show of","+ * a session, such as the Changes editor that the pills of a chat open, is of that chat. Until a feature binds one, it shows","+ * nothing and does nothing: it only derives what it shows from what is bound.","+ */","+export class EditorWindowMainSessionHost extends SessionHost {","+","+\tprivate readonly _shown: ISettableObservable<IObservable<IEditorWindowShownChat | undefined> | undefined>;","+\tprivate readonly _override: ISettableObservable<IObservable<IEditorWindowShownChat | undefined> | undefined>;","+","+\tconstructor(@IContextKeyService contextKeyService: IContextKeyService) {","+\t\tconst source = observableValue<IObservable<IEditorWindowShownChat | undefined> | undefined>('editorWindowShownChat', undefined);","+\t\tconst override = observableValue<IObservable<IEditorWindowShownChat | undefined> | undefined>('editorWindowShownChatOverride', undefined);","+\t\tconst shown = derived(reader => (override.read(reader) ?? source.read(reader))?.read(reader));","+\t\tsuper({","+\t\t\tkind: SessionHostKind.MainWindow,","+\t\t\tparent: undefined,","+\t\t\tsession: derived(reader => shown.read(reader)?.session),","+\t\t\tchat: derived(reader => shown.read(reader)?.chat),","+\t\t\tcontextKeyService,","+\t\t\twindowId: constObservable(mainWindow.vscodeWindowId),","+\t\t});","+\t\tthis._shown = source;","+\t\tthis._override = override;","+\t}","+","+\t/**","+\t * Shows the chat `shown` names in place of the one bound with {@link bindShownChat}, until the returned disposable is","+\t * disposed: such as the chat of the Chat view while the chats open there, and not in the chat part.","+\t */","+\toverrideShownChat(shown: IObservable<IEditorWindowShownChat | undefined>): IDisposable {","+\t\tthis._override.set(shown, undefined);","+\t\treturn toDisposable(() => {","+\t\t\tif (this._override.get() === shown) {","+\t\t\t\tthis._override.set(undefined, undefined);","+\t\t\t}","+\t\t});","+\t}","+","+\t/** Shows the chat `shown` names, until the returned disposable is disposed. */","+\tbindShownChat(shown: IObservable<IEditorWindowShownChat | undefined>): IDisposable {","+\t\tthis._shown.set(shown, undefined);","+\t\treturn toDisposable(() => {","+\t\t\tif (this._shown.get() === shown) {","+\t\t\t\tthis._shown.set(undefined, undefined);","+\t\t\t}","+\t\t});","+\t}","+}"],"additions":68,"deletions":0,"truncated":false},{"path":"src/vs/workbench/contrib/sessions/browser/agentsView/editorWindowSessionsNavigationHost.ts","lines":["@@ -0,0 +1,104 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { Disposable } from '../../../../../base/common/lifecycle.js';","+import { constObservable, IObservable } from '../../../../../base/common/observable.js';","+import { URI } from '../../../../../base/common/uri.js';","+import { ISessionGridPane } from '../../../../services/sessions/browser/sessionGridPane.js';","+import { ISessionHost } from '../../../../services/sessions/browser/sessionHost.js';","+import { IChat, ISession } from '../../../../services/sessions/common/session.js';","+import { ISessionsManagementService } from '../../common/sessionsManagement.js';","+import { ISessionsNavigationService } from '../sessionsNavigationService.js';","+import type { IOpenChatOptions, IOpenSessionOptions } from '../sessionsService.js';","+import { IEditorWindowSessionsPresenterService } from '../editorWindow/editorWindowSessionsPresenter.js';","+import { IAgentsViewProvidersService } from './agentsViewProviders.js';","+import { LatestSessionOpen, prepareSessionForOpen, resolveSessionForOpen } from '../sessionOpen.js';","+import { ISessionsProvidersService } from '../sessionsProvidersService.js';","+import { IWorkspaceTrustManagementService, IWorkspaceTrustRequestService } from '../../../../../platform/workspace/common/workspaceTrust.js';","+import { requestSessionWorkspaceTrust } from '../../../../services/sessions/browser/worktreeTrust.js';","+","+/**","+ * The navigation of an editor window: sessions and chats open where its presenter shows them (see","+ * `IEditorWindowSessionsPresenterService`), such as tabs of the chat part. The window has no grid of sessions: the","+ * presenter's active chat is its active session.","+ */","+export class EditorWindowSessionsNavigationHost extends Disposable implements ISessionsNavigationService {","+","+\tdeclare readonly _serviceBrand: undefined;","+","+\treadonly slotPanes: IObservable<readonly ISessionGridPane[]> = constObservable([]);","+","+\tconstructor(","+\t\t@IEditorWindowSessionsPresenterService private readonly _presenterService: IEditorWindowSessionsPresenterService,","+\t\t@ISessionHost private readonly _mainWindowHost: ISessionHost,","+\t\t@ISessionsManagementService private readonly _sessionsManagementService: ISessionsManagementService,","+\t\t@IAgentsViewProvidersService private readonly _providers: IAgentsViewProvidersService,","+\t\t@IWorkspaceTrustManagementService private readonly _workspaceTrustManagementService: IWorkspaceTrustManagementService,","+\t\t@IWorkspaceTrustRequestService private readonly _workspaceTrustRequestService: IWorkspaceTrustRequestService,","+\t\t@ISessionsProvidersService private readonly _sessionsProvidersService: ISessionsProvidersService,","+\t) {","+\t\tsuper();","+\t}","+","+\t/** What shows the chats of sessions: the chat part, while a feature shows them there, or the Chat view. */","+\tprivate get _presenter() {","+\t\treturn this._presenterService.presenter.get();","+\t}","+","+\tget mainWindowHost(): ISessionHost {","+\t\treturn this._mainWindowHost;","+\t}","+","+\t/** The latest open, which a later one cancels, as disposing this does: an open shows its session only while it is the latest. */","+\tprivate readonly _open = this._register(new LatestSessionOpen());","+","+\tasync openSession(sessionResource: URI, options?: IOpenSessionOptions): Promise<void> {","+\t\t// A later open supersedes this one while it resolves, waits for or prepares its session: the user's latest pick shows","+\t\tconst token = this._open.start();","+\t\t// Its session is known only while the providers are held: until it shows, such as in the chat part, which holds them then","+\t\tconst hold = this._providers.acquire();","+\t\ttry {","+\t\t\tconst session = await resolveSessionForOpen(this._sessionsManagementService, this._sessionsProvidersService, sessionResource, token);","+\t\t\tif (session) {","+\t\t\t\tawait this._presenter.openChat(session, undefined, { preserveFocus: options?.preserveFocus });","+\t\t\t}","+\t\t} finally {","+\t\t\thold.dispose();","+\t\t}","+\t}","+","+\tasync openSessionToSide(session: ISession, options?: IOpenSessionOptions): Promise<void> {","+\t\tawait prepareSessionForOpen(this._sessionsProvidersService, session);","+\t\tawait this._presenter.openChat(session, undefined, { preserveFocus: options?.preserveFocus, sideBySide: true });","+\t}","+","+\tasync openChat(session: ISession, chatUri: URI, options?: IOpenChatOptions): Promise<void> {","+\t\t// A later open, also of a session, supersedes this one while its session prepares, so that the user's latest pick shows","+\t\tconst token = this._open.start();","+\t\tawait prepareSessionForOpen(this._sessionsProvidersService, session);","+\t\tif (!token.isCancellationRequested) {","+\t\t\tawait this._presenter.openChat(session, chatUri, { preserveFocus: options?.preserveFocus });","+\t\t}","+\t}","+","+\tasync openChatToSide(session: ISession, chatResource: URI, options?: { readonly preserveFocus?: boolean }): Promise<void> {","+\t\tawait prepareSessionForOpen(this._sessionsProvidersService, session);","+\t\tawait this._presenter.openChat(session, chatResource, { preserveFocus: options?.preserveFocus, sideBySide: true });","+\t}","+","+\t/** Whether the user trusts every folder the session works in, as the Agents window asks before it opens a session. */","+\tasync canOpenSession(session: ISession): Promise<boolean> {","+\t\tconst workspace = session.workspace.get();","+\t\treturn requestSessionWorkspaceTrust(workspace, () => workspace && this._sessionsManagementService.getRemoteHostLabel(workspace, session.providerId), this._workspaceTrustManagementService, this._workspaceTrustRequestService);","+\t}","+","+\tfocusActiveSession(): void {","+\t\tthis._presenter.focus();","+\t}","+","+\tasync closeArchivedChat(_session: ISession, chat: IChat): Promise<void> {","+\t\tawait this._presenter.closeChat(chat.resource);","+\t}","+}"],"additions":104,"deletions":0,"truncated":false},{"path":"src/vs/workbench/contrib/sessions/browser/agentsView/editorWindowSessionsService.ts","lines":["@@ -0,0 +1,321 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { CancellationToken, CancellationTokenSource } from '../../../../../base/common/cancellation.js';","+import { CancellationError } from '../../../../../base/common/errors.js';","+import { Event } from '../../../../../base/common/event.js';","+import { Disposable, IDisposable } from '../../../../../base/common/lifecycle.js';","+import { constObservable, IObservable } from '../../../../../base/common/observable.js';","+import { isEqual } from '../../../../../base/common/resources.js';","+import { URI } from '../../../../../base/common/uri.js';","+import { localize } from '../../../../../nls.js';","+import { ILogService } from '../../../../../platform/log/common/log.js';","+import { IWorkspaceContextService } from '../../../../../platform/workspace/common/workspace.js';","+import { IEditorService } from '../../../../services/editor/common/editorService.js';","+import { IWorkspaceTrustManagementService, IWorkspaceTrustRequestService } from '../../../../../platform/workspace/common/workspaceTrust.js';","+import { requestSessionWorkspaceTrust } from '../../../../services/sessions/browser/worktreeTrust.js';","+import { ISessionGridPane } from '../../../../services/sessions/browser/sessionGrid