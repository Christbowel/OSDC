n the current tenant context writes a secret it does not own. This includes a tenant-agnostic (<c>*</c>)","+/// secret: every tenant can read it, but only the <c>*</c> context can change it.","+/// </summary>","+public class SecretTenantOwnershipException(string secretName) : InvalidOperationException($\"A secret named '{secretName}' belongs to another tenant.\");"],"additions":7,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Secrets/Repositories/FileSecretRepository.cs","lines":["@@ -2,6 +2,7 @@"," using System.Text.Json.Serialization;"," using Elsa.Common.Multitenancy;"," using Elsa.Secrets.Contracts;","+using Elsa.Secrets.Exceptions;"," using Elsa.Secrets.Services;"," using Elsa.Tenants.Options;"," using Microsoft.Extensions.Logging;","@@ -169,7 +170,7 @@ public async Task SaveAsync(Secret secret, CancellationToken cancellationToken =","             else","             {","                 if (!SecretRepositoryTenant.CanReplace(secrets[index], secret, tenantAccessor, tenancyEnabled))","-                    throw new InvalidOperationException($\"A secret named '{secret.Name}' belongs to another tenant.\");","+                    throw new SecretTenantOwnershipException(secret.Name);"," ","                 secrets[index] = ReplaceIdentityAndTenant(secrets[index], secret, tenancyEnabled);","             }"],"additions":2,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Secrets/Repositories/InMemorySecretRepository.cs","lines":["@@ -1,5 +1,6 @@"," using Elsa.Common.Multitenancy;"," using Elsa.Secrets.Contracts;","+using Elsa.Secrets.Exceptions;"," using Elsa.Secrets.Services;"," using Elsa.Tenants.Options;"," using Microsoft.Extensions.Options;","@@ -140,7 +141,7 @@ public Task SaveAsync(Secret secret, CancellationToken cancellationToken = defau","             if (existing is not null)","             {","                 if (!SecretRepositoryTenant.CanReplace(existing, secret, tenantAccessor, tenancyEnabled))","-                    throw new InvalidOperationException($\"A secret named '{secret.Name}' belongs to another tenant.\");","+                    throw new SecretTenantOwnershipException(secret.Name);"," ","                 // EF updates the row found by name, retaining its primary key and tenant ownership.","                 var replacement = Clone(secret);"],"additions":2,"deletions":1,"truncated":false},{"path":"core/test/unit/Elsa.Secrets.UnitTests/AgnosticSecretWriteEndpointsTests.cs","lines":["@@ -0,0 +1,80 @@","+using Elsa.Common.Multitenancy;","+using Elsa.Secrets.Models;","+using Elsa.Secrets.Repositories;","+using Elsa.Secrets.Services;","+using FastEndpoints;","+using Microsoft.AspNetCore.Http;","+using DeleteEndpoint = Elsa.Secrets.Endpoints.Secrets.Delete.Endpoint;","+using RevokeEndpoint = Elsa.Secrets.Endpoints.Secrets.Revoke.Endpoint;","+using RotateEndpoint = Elsa.Secrets.Endpoints.Secrets.Rotate.Endpoint;","+using UpdateEndpoint = Elsa.Secrets.Endpoints.Secrets.Update.Endpoint;","+","+namespace Elsa.Secrets.UnitTests;","+","+/// <summary>","+/// A tenant sees a tenant-agnostic (<c>*</c>) secret but cannot write it. Every write endpoint answers 403 with the","+/// reason instead of failing with 500 (#8759).","+/// </summary>","+public class AgnosticSecretWriteEndpointsTests","+{","+    private const string SecretName = \"shared:secret\";","+    private readonly DefaultTenantAccessor _tenantAccessor = new();","+    private readonly DefaultSecretManager _manager;","+","+    public AgnosticSecretWriteEndpointsTests()","+    {","+        var fixture = new SecretTestFixture();","+        _manager = new DefaultSecretManager(new DefaultSecretNameValidator(), fixture.StoreRegistry, fixture.TypeRegistry, new InMemorySecretRepository(_tenantAccessor));","+    }","+","+    [Theory]","+    [InlineData(\"update\")]","+    [InlineData(\"revoke\")]","+    [InlineData(\"delete\")]","+    [InlineData(\"rotate\")]","+    public async Task WritingAnAgnosticSecretFromATenant_Returns403(string operation)","+    {","+        using (UseTenant(Tenant.AgnosticTenantId))","+            await _manager.CreateAsync(new CreateSecretRequest { Name = SecretName, Value = \"shared\" });","+","+        using (UseTenant(\"tenant-a\"))","+        {","+            var endpoint = await HandleAsync(operation);","+","+            Assert.Equal(StatusCodes.Status403Forbidden, endpoint.HttpContext.Response.StatusCode);","+            Assert.Equal($\"A secret named '{SecretName}' belongs to another tenant.\", Assert.Single(endpoint.ValidationFailures).ErrorMessage);","+        }","+    }","+","+    private async Task<BaseEndpoint> HandleAsync(string operation)","+    {","+        switch (operation)","+        {","+            case \"update\":","+                var update = CreateEndpoint<UpdateEndpoint>();","+                await update.HandleAsync(new UpdateSecretRequest { DisplayName = \"Rehomed\" }, CancellationToken.None);","+                return update;","+            case \"revoke\":","+                var revoke = CreateEndpoint<RevokeEndpoint>();","+                await revoke.HandleAsync(CancellationToken.None);","+                return revoke;","+            case \"delete\":","+                var delete = CreateEndpoint<DeleteEndpoint>();","+                await delete.HandleAsync(CancellationToken.None);","+                return delete;","+            default:","+                var rotate = CreateEndpoint<RotateEndpoint>();","+                await rotate.HandleAsync(new RotateSecretRequest { Value = \"rotated\" }, CancellationToken.None);","+                return rotate;","+        }","+    }","+","+    private TEndpoint CreateEndpoint<TEndpoint>() where TEndpoint : class, IEndpoint =>","+        Factory.Create<TEndpoint>(context =>","+        {","+            context.Request.RouteValues[\"name\"] = SecretName;","+            context.Response.Body = new MemoryStream();","+        }, _manager);","+","+    private IDisposable UseTenant(string tenantId) => _tenantAccessor.PushContext(new Tenant { Id = tenantId, Name = tenantId });","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"core/test/unit/Elsa.Secrets.UnitTests/EFCoreSecretRepositoryTests.cs","lines":["@@ -3,6 +3,7 @@"," using Elsa.Persistence.EFCore.EntityHandlers;"," using Elsa.Persistence.EFCore.Extensions;"," using Elsa.Secrets.Contracts;","+using Elsa.Secrets.Exceptions;"," using Elsa.Secrets.Models;"," using Elsa.Secrets.Persistence.EFCore;"," using Elsa.Secrets.Persistence.EFCore.Repositories;","@@ -288,7 +289,7 @@ await WithTenantAwareRepositoryAsync(async (repository, tenantAccessor) =>","                     Assert.False(await repository.TryAddOrReplaceDeletedAsync(secret));","                 else","                 {","-                    var error = await Assert.ThrowsAsync<InvalidOperationException>(() =>","+                    var error = await Assert.ThrowsAsync<SecretTenantOwnershipException>(() =>","                         operation == \"add\" ? repository.AddAsync(secret) : repository.SaveAsync(secret));","                     Assert.Equal($\"A secret named '{name}' belongs to another tenant.\", error.Message);","                 }","@@ -308,7 +309,7 @@ await WithTenantAwareRepositoryAsync(async (repository, tenantAccessor) =>","         {","             using (UseTenant(tenantAccessor, \"tenant-a\"))","             {","-                await Assert.ThrowsAsync<InvalidOperationException>(() => repository.SaveAsync(new Secret","+                await Assert.ThrowsAsync<SecretTenantOwnershipException>(() => repository.SaveAsync(new Secret","                 {","                     Id = \"forged-secret\",","                     Name = \"novel:legacy-constructor\",","@@ -396,7 +397,7 @@ await repository.SaveAsync(new Secret"," ","             using (UseTenant(tenantAccessor, \"tenant-a\"))","             {","-                var exception = await Assert.ThrowsAsync<InvalidOperationException>(() => repository.SaveAsync(new Secret","+