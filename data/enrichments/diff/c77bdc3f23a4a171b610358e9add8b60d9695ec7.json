{"id":"c77bdc3f23a4a171b610358e9add8b60d9695ec7","axis":"silent","repo":"sanity-io/sanity","sha":"c77bdc3f23a4a171b610358e9add8b60d9695ec7","parsed":{"files":[{"path":"packages/sanity/src/core/store/auth/legacy/__tests__/authHashParams.test.ts","lines":["@@ -0,0 +1,45 @@","+import {afterEach, describe, expect, it} from 'vitest'","+","+import {removeAuthHashParams, takeHashParam} from '../authHashParams'","+","+describe('takeHashParam', () => {","+  afterEach(() => {","+    window.history.replaceState(null, '', window.location.pathname)","+  })","+","+  it('matches the param by its exact name', () => {","+    window.history.replaceState(null, '', '#access_token=abc&keep=me')","+","+    expect(takeHashParam('token')).toBeUndefined()","+    expect(window.location.hash).toBe('#access_token=abc&keep=me')","+  })","+","+  it('removes every occurrence of the param', () => {","+    window.history.replaceState(null, '', '#token=first&keep=me&token=second')","+","+    expect(takeHashParam('token')).toBe('first')","+    expect(window.location.hash).toBe('#keep=me')","+  })","+","+  it('keeps the current history state', () => {","+    window.history.replaceState({key: 'entry'}, '', '#token=abc')","+","+    takeHashParam('token')","+","+    expect(window.history.state).toEqual({key: 'entry'})","+  })","+})","+","+describe('removeAuthHashParams', () => {","+  it('returns a hash without auth params unchanged', () => {","+    expect(removeAuthHashParams('#a&&b')).toBe('#a&&b')","+  })","+","+  it('returns an empty hash unchanged', () => {","+    expect(removeAuthHashParams('#')).toBe('#')","+  })","+","+  it('removes auth params and keeps the others', () => {","+    expect(removeAuthHashParams('#sid=x&a=1')).toBe('#a=1')","+  })","+})"],"additions":45,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/store/auth/legacy/__tests__/createLegacyAuthStore.test.ts","lines":["@@ -13,6 +13,7 @@ import {promiseWithResolvers} from '../../../../util/promiseWithResolvers'"," import {type AuthStore} from '../../types'"," import {AUTH_STATE_SETTLE_TIMEOUT_MS} from '../constants'"," import {_createLegacyAuthStore, createLegacyAuthStore} from '../createLegacyAuthStore'","+import {consumeHashToken} from '../hashToken'"," "," // Mock supportsLocalStorage to return true so createBroadcastStorage uses localStorage."," // In jsdom/Node.js it returns false because process.versions.node is defined.","@@ -1913,6 +1914,118 @@ describe('createLegacyAuthStore: workbench OS token', () => {","   })"," })"," ","+describe('createLegacyAuthStore: hash credentials', () => {","+  const PASTED_TOKEN = 'pasted-hash-token-0123456789abcdef'","+","+  beforeEach(() => {","+    localStorage.clear()","+  })","+","+  afterEach(() => {","+    localStorage.clear()","+    // Not `location.hash = ''`: its queued hashchange would reach the next test's store.","+    window.history.replaceState(null, '', window.location.pathname)","+    // Drains a token a cookie store left for a token store, so it can't reach the next test.","+    consumeHashToken()","+  })","+","+  it.each(['cookie', 'token', 'dual'] as const)(","+    'removes a #sid= fragment pasted into an open tab from the URL (%s, during the first probe)',","+    async (loginMethod) => {","+      const mock = createMockClientFactory()","+","+      const store = _createLegacyAuthStore({","+        projectId: PROJECT_ID,","+        dataset: DATASET,","+        loginMethod,","+        clientFactory: mock.factory,","+        getSessionId: () => undefined,","+        consumeHashToken: () => undefined,","+      })","+      const sub = store.state.subscribe(() => {})","+","+      try {","+        // Dispatched before any await: the initial /users/me probe is still in flight.","+        // replaceState, unlike assigning location.hash, doesn't queue jsdom's own (later)","+        // hashchange event, which would otherwise arrive after the probe settles.","+        window.history.replaceState(null, '', '#sid=12345678901234567890&keep=me')","+        window.dispatchEvent(new HashChangeEvent('hashchange'))","+","+        await vi.waitFor(() => {","+          expect(window.location.hash).toBe('#keep=me')","+        })","+      } finally {","+        sub.unsubscribe()","+      }","+    },","+  )","+","+  it('removes a #token= fragment pasted into an open tab without taking it in (cookie)', async () => {","+    const store = _createLegacyAuthStore({","+      projectId: PROJECT_ID,","+      dataset: DATASET,","+      loginMethod: 'cookie',","+      clientFactory: createMockClientFactory().factory,","+      getSessionId: () => undefined,","+      consumeHashToken,","+    })","+    const sub = store.state.subscribe(() => {})","+","+    try {","+      window.history.replaceState(null, '', `#token=${PASTED_TOKEN}&keep=me`)","+      window.dispatchEvent(new HashChangeEvent('hashchange'))","+","+      expect(window.location.hash).toBe('#keep=me')","+      expect(localStorage.getItem(TOKEN_STORAGE_KEY)).toBeNull()","+    } finally {","+      sub.unsubscribe()","+    }","+  })","+","+  it('leaves a #token= pasted into an open tab for a token store that a cookie store heard first', async () => {","+    const cookieStore = _createLegacyAuthStore({","+      projectId: 'cookie-project',","+      dataset: DATASET,","+      loginMethod: 'cookie',","+      clientFactory: createMockClientFactory().factory,","+      getSessionId: () => undefined,","+      consumeHashToken,","+    })","+    const tokenStore = _createLegacyAuthStore({","+      projectId: PROJECT_ID,","+      dataset: DATASET,","+      loginMethod: 'token',","+      clientFactory: createMockClientFactory().factory,","+      getSessionId: () => undefined,","+      consumeHashToken,","+    })","+    const subscriptions = [cookieStore, tokenStore].map((store) => store.state.subscribe(() => {}))","+","+    try {","+      window.history.replaceState(null, '', `#token=${PASTED_TOKEN}`)","+      window.dispatchEvent(new HashChangeEvent('hashchange'))","+","+      expect(JSON.parse(localStorage.getItem(TOKEN_STORAGE_KEY)!)).toEqual({token: PASTED_TOKEN})","+      expect(window.location.hash).toBe('')","+    } finally {","+      subscriptions.forEach((subscription) => subscription.unsubscribe())","+    }","+  })","+","+  it('does not store a #token= present at load in a cookie store', () => {","+    _createLegacyAuthStore({","+      projectId: PROJECT_ID,","+      dataset: DATASET,","+      loginMethod: 'cookie',","+      clientFactory: createMockClientFactory().factory,","+      getSessionId: () => undefined,","+      consumeHashToken: () => PASTED_TOKEN,","+    })","+","+    expect(localStorage.getItem(TOKEN_STORAGE_KEY)).toBeNull()","+  })","+})","+"," describe('createLegacyAuthStore: hash claim intake', () => {","   const CLAIM_URL = 'https://www.sanity.io/manage/claim/some-claim-token'","   const CLAIM_STORAGE_KEY = `__studio_unclaimed_${PROJECT_ID}`"],"additions":113,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/store/auth/legacy/__tests__/hashCredentialsOnBootFailure.test.ts","lines":["@@ -0,0 +1,166 @@","+import {afterEach, beforeEach, describe, expect, it, vi} from 'vitest'","+","+import {type WorkspaceOptions} from '../../../../config/types'","+","+// Credentials handed to the studio in the URL hash (`#sid=` after a login","+// redirect, `#token=` for token auth links) must leave the address bar and the","+// session history even when the studio fails to boot. A crash shown on screen","+// is exactly when people copy the URL into a bug report or share their screen.","+","+const SESSION_ID = 'sid-abcdefghijklmnopqrstuvwxyz'","+const TOKEN = 'tok-abcdefghijklmnopqrstuvwxyz0123456789'","+const CLAIM_URL = 'https://www.sanity.io/manage/claim/some-claim-token'","+","+// A field pointing at a type that does not exist: `prepareConfig` throws a","+// `SchemaError` while resolving the workspace, before it creates the auth store.","+const brokenWorkspace: WorkspaceOptions = {","+  name: 'broken',","+  basePath: '/',","+  projectId: 'hashcreds',","+  dataset: 'test',","+  schema: {","+    types: [","+      {","+        type: 'document',","+        name: 'post',","+        fields: [{name: 'author', type: 'reference', to: [{type: 'missing'}]}],","+      },","+    ],","+  },","+}","+","+async function bootWithBrokenSchema() {","+  // The hash is read when the auth modules evaluate, so load them fresh after","+  // the hash is set, the way a page load after a redirect would.","+  const {prepareConfig} = await import('../../../../config/prepareConfig')","+  const {SchemaError} = await import('../../../../config/SchemaError')","+  expect(() => prepareConfig([brokenWorkspace])).toThrow(SchemaError)","+}","+","+// Cold imports of the config modules are slow, and each test re-imports them.","+describe('credentials in the URL hash when the studio fails to boot', {timeout: 60_000}, () => {","+  let consoleSpies: ReturnType<typeof vi.spyOn>[]","+","+  beforeEach(() => {","+    vi.resetModules()","+    consoleSpies = [","+      vi.spyOn(console, 'error').mockImplementation(() => {}),","+      vi.spyOn(console, 'warn').mockImplementation(() => {}),","+    ]","+  })","+","+  afterEach(() => {","+    for (const spy of consoleSpies) spy.mockRestore()","+    window.history.replaceState(null, '', window.location.pathname)","+    delete globalThis.__SANITY_AUTH_HASH_PARAMS__","+  })","+","+  it('removes #sid= from the URL even when the schema fails to compile', async () => {","+    window.location.hash = `#sid=${SESSION_ID}`","+","+    await bootWithBrokenSchema()","+","+    expect(window.location.href).not.toContain(SESSION_ID)","+  })","+","+  it('removes #token= from the URL even when the schema fails to compile', async () => {","+    window.location.hash = `#token=${TOKEN}`","+","+    await bootWithBrokenSchema()","+","+    expect(window.location.href).not.toContain(TOKEN)","+  })","+","+  it('removes #claim= from the URL even when the schema fails to compile', async () => {","+    window.location.hash = `#claim=${encodeURIComponent(CLAIM_URL)}`","+","+    await bootWithBrokenSchema()","+","+    expect(window.location.hash).toBe('')","+  })","+","+  it('keeps unrelated hash params when removing the token', async () => {","+    window.location.hash = `#token=${TOKEN}&keep=me`","+","+    await bootWithBrokenSchema()","+","+    expect(window.location.hash).toBe('#keep=me')","+  })","+","+  it('still hands a token that was removed at load to the auth store', async () => {","+    window.location.hash = `#token=${TOKEN}`","+","+    const {consumeHashToken} = await import('../hashToken')","+    expect(window.location.href).not.toContain(TOKEN)","+","+    expect(consumeHashToken()).toBe(TOKEN)","+    // One-shot, like the session id: a later call must not replay it.","+    expect(consumeHashToken()).toBeUndefined()","+  })","+","+  it('removes a token the host restored to the hash after load when it is consumed', async () => {","+    window.location.hash = `#token=${TOKEN}`","+    const {consumeHashToken} = await import('../hashToken')","+","+    // A host router restoring the hash it cached before load (vercel/next.js#91819)","+    window.location.hash = `#token=${TOKEN}&keep=me`","+","+    expect(consumeHashToken()).toBe(TOKEN)","+    expect(window.location.hash).toBe('#keep=me')","+  })","+","+  it('still reads a token that arrives in a later hash change', async () => {","+    window.location.hash = ''","+    const {consumeHashToken} = await import('../hashToken')","+","+    window.location.hash = `#token=${TOKEN}`","+","+    expect(consumeHashToken()).toBe(TOKEN)","+    expect(window.location.href).not.toContain(TOKEN)","+  })","+","+  it('still hands a claim URL that was removed at load to the auth store', async () => {","+    window.location.hash = `#claim=${encodeURIComponent(CLAIM_URL)}`","+","+    const {consumeHashClaim} = await import('../hashClaim')","+    expect(window.location.hash).toBe('')","+","+    expect(consumeHashClaim()).toBe(CLAIM_URL)","+    expect(consumeHashClaim()).toBeUndefined()","+  })","+","+  it('removes a claim URL the host restored to the hash after load when it is consumed', async () => {","+    window.location.hash = `#claim=${encodeURIComponent(CLAIM_URL)}`","+    const {consumeHashClaim} = await import('../hashClaim')","+","+    // A host router restoring the hash it cached before load (vercel/next.js#91819)","+    window.location.hash = `#claim=${encodeURIComponent(CLAIM_URL)}&keep=me`","+","+    expect(consumeHashClaim()).toBe(CLAIM_URL)","+    expect(window.location.hash).toBe('#keep=me')","+  })","+","+  it('takes the token and claim URL the studio HTML stashed before the bundle loaded', async () => {","+    globalThis.__SANITY_AUTH_HASH_PARAMS__ = {token: TOKEN, claim: encodeURIComponent(CLAIM_URL)}","+","+    const {consumeHashToken} = await import('../hashToken')","+    const {consumeHashClaim} = await import('../hashClaim')","+","+    expect(consumeHashToken()).toBe(TOKEN)","+    expect(consumeHashClaim()).toBe(CLAIM_URL)","+    expect(globalThis.__SANITY_AUTH_HASH_PARAMS__).toEqual({})","+  })","+","+  it('validates stashed values like hash params', async () => {","+    globalThis.__SANITY_AUTH_HASH_PARAMS__ = {","+      token: 'too-short',","+      claim: encodeURIComponent('https://evil.example.com/manage/claim/some-claim-token'),","+    }","+","+    const {consumeHashToken} = await import('../hashToken')","+    const {consumeHashClaim} = await import('../hashClaim')","+","+    expect(consumeHashToken()).toBeUndefined()","+    expect(consumeHashClaim()).toBeUndefined()","+  })","+})"],"additions":166,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/store/auth/legacy/__tests__/sessionId.test.ts","lines":["@@ -11,6 +11,7 @@ describe('sessionId', () => {","   afterEach(() => {","     replaceStateSpy.mockRestore()","     window.location.hash = ''","+    delete globalThis.__SANITY_AUTH_HASH_PARAMS__","   })"," ","   it('extracts session ID from URL hash on module load and removes it from history', async () => {","@@ -52,4 +53,22 @@ describe('sessionId', () => {","     expect(getSessionId()).toBe('12345678901234567890')","     expect(replaceStateSpy).toHaveBeenCalled()","   })","+","+  it('takes the session ID the studio HTML stashed before the bundle loaded', async () => {","+    globalThis.__SANITY_AUTH_HASH_PARAMS__ = {sid: '12345678901234567890', claim: 'other'}","+","+    const {getHashSessionId: getSessionId} = await import('../sessionId')","+","+    expect(getSessionId()).toBe('12345678901234567890')","+    expect(getSessionId()).toBeUndefined()","+    // Read once, then dropped from the stash so it doesn't linger on the global.","+    expect(globalThis.__SANITY_AUTH_HASH_PARAMS__).toEqual({claim: 'other'})","+  })","+","+  it('rejects a stashed session ID shorter than 20 characters', async () => {","+    globalThis.__SANITY_AUTH_HASH_PARAMS__ = {sid: 'short'}","+","+    const {getHashSessionId: getSessionId} = await import('../sessionId')","+    expect(getSessionId()).toBeUndefined()","+  })"," })"],"additions":19,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/store/auth/legacy/authHashParams.ts","lines":["@@ -0,0 +1,70 @@","+interface StashedAuthHashParams {","+  sid?: string","+  token?: string","+  claim?: string","+}","+","+declare global {","+  /**","+   * Set by an inline script that the CLI adds to the studio's `index.html`. It runs before any","+   * module, removes the auth params below from the URL hash, and keeps their raw values here so","+   * a studio that fails to boot never leaves them in the address bar.","+   */","+  var __SANITY_AUTH_HASH_PARAMS__: StashedAuthHashParams | undefined","+}","+","+type AuthHashParam = keyof StashedAuthHashParams","+","+const AUTH_HASH_PARAMS: AuthHashParam[] = ['sid', 'token', 'claim']","+","+/**","+ * Takes a raw value stashed by the studio's `index.html`, removing it from the stash so it","+ * doesn't linger on the global.","+ */","+export function takeStashedAuthHashParam(name: AuthHashParam): string | undefined {","+  const stash = globalThis.__SANITY_AUTH_HASH_PARAMS__","+  if (!stash) return undefined","+  const value = stash[name]","+  delete stash[name]","+  return typeof value === 'string' ? value : undefined","+}","+","+/**","+ * Takes the raw value of a param in the URL hash, wherever it sits in the `&`-separated list, and","+ * removes every occurrence of it from the URL and the current history entry, even when the value","+ * is invalid.","+ */","+export function takeHashParam(name: AuthHashParam): string | undefined {","+  if (typeof window === 'undefined' || typeof window.location !== 'object') {","+    return undefined","+  }","+","+  const isParam = (param: string) => param.startsWith(`${name}=`)","+  const params = window.location.hash.replace(/^#/, '').split('&')","+  const value = params.find(isParam)?.slice(name.length + 1)","+  if (value === undefined) {","+    return undefined","+  }","+","+  const newUrl = new URL(window.location.href)","+  newUrl.hash = params.filter((param) => param && !isParam(param)).join('&')","+  history.replaceState(history.state, '', newUrl)","+","+  return value","+}","+","+const isAuthParam = (param: string) => AUTH_HASH_PARAMS.some((name) => param.startsWith(`${name}=`))","+","+/**","+ * Removes the auth params from a hash string, for code that writes a hash back to the URL from a","+ * `history` location cached before the auth modules removed them. A hash without auth params is","+ * returned unchanged.","+ */","+export function removeAuthHashParams(hash: string): string {","+  const params = hash.replace(/^#/, '').split('&')","+  if (!params.some(isAuthParam)) {","+    return hash","+  }","+  const kept = params.filter((param) => param && !isAuthParam(param))","+  return kept.length > 0 ? `#${kept.join('&')}` : ''","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/store/auth/legacy/createLegacyAuthSto