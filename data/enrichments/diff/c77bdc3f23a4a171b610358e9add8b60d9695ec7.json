the hash.","   // The tap triggers tokenStorage.update() which pushes to the BehaviorSubject","   // backing tokenStorage.value — so the actual emission comes from that stream.","-  // switchMap to EMPTY so this branch produces no direct values.","+  // switchMap to EMPTY so this branch produces no direct values. Merged into","+  // existingAuthState$ outside its concat, so it listens in every login mode","+  // and from the first subscription on, including while the initial probe is","+  // in flight.","   // Guarded for SSR: `window` is undefined on the server, where we can't","   // listen for hash changes anyway.","   const hashTokenChange =","@@ -501,8 +508,11 @@ function createStandaloneAuthStore({","       ? EMPTY","       : fromEvent(window, 'hashchange').pipe(","           tap(() => {","+            // A `#sid=` pasted into an open tab is not exchanged (the callback flow runs once,","+            // when the studio mounts), but it must not stay in the URL.","+            clearHashSessionId()","             consumeHashClaimUrl(projectId)","-            const hashToken = consumeHashToken()","+            const hashToken = takeUsableHashToken()","             if (hashToken) {","               tokenStorage.update({token: hashToken})","             }","@@ -513,8 +523,10 @@ function createStandaloneAuthStore({","   // Derived from the live token state, not concat'ed with a pre-built","   // initial client: a positional skip would drop a token applied while the","   // initial probe is in flight (fast sid exchange), leaving the store stuck","-  // on the credential-less client. Same shape as dualClient$ below.","-  const tokenClient$ = merge(hashTokenChange, tokenStorage.value).pipe(","+  // on the credential-less client. Same shape as dualClient$ below. A token","+  // pasted into the hash reaches both through tokenStorage.value (see","+  // hashTokenChange).","+  const tokenClient$ = tokenStorage.value.pipe(","     map((nextTokenState) => {","       return clien