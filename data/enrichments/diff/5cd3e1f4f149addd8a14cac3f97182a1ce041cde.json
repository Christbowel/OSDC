{"id":"5cd3e1f4f149addd8a14cac3f97182a1ce041cde","axis":"silent","repo":"pnpm/pnpm","sha":"5cd3e1f4f149addd8a14cac3f97182a1ce041cde","parsed":{"files":[{"path":".changeset/pnpr-forward-workspace-settings.md","lines":["@@ -0,0 +1,9 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` with `pnprServer` now applies `injectWorkspacePackages`, `dedupeInjectedDeps`, `ignoredOptionalDependencies`, and `dependenciesMeta`. Projects that use them no longer fail with `ERR_PNPM_OUTDATED_LOCKFILE` or `ERR_PNPM_LOCKFILE_CONFIG_MISMATCH`.","+","+`pnpm install --update-checksums` with `pnprServer` now refreshes the integrity checksums in the lockfile.","+","+With `pnprServer` set and `blockExoticSubdeps: false`, pnpm resolves locally."],"additions":9,"deletions":0,"truncated":false},{"path":".changeset/pnpr-resolve-workspace-settings.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+The resolve endpoint now accepts `injectWorkspacePackages`, `dedupeInjectedDeps`, `ignoredOptionalDependencies`, `updateChecksums`, and a `dependenciesMeta` for each project."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install.rs","lines":["@@ -368,6 +368,7 @@ impl InstallArgs {","                     .prefer_frozen_override()","                     .unwrap_or(config.prefer_frozen_lockfile),","                 update_patches: false,","+                update_checksums: self.lockfile_updates.update_checksums,","                 fix: self.lockfile.fix,","                 only: self.lockfile.only,","                 ignore_manifest_check: self.lockfile.ignore_manifest_check,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_link.rs","lines":["@@ -35,6 +35,9 @@ pub(crate) struct PnprLockfilePolicy {","     /// version. This disables the exchange-free satisfied-lockfile path and","     /// is forwarded to `/-/pnpr/v0/resolve`.","     pub(crate) update_patches: bool,","+    /// `--update-checksums`. Disables the exchange-free satisfied-lockfile","+    /// path and is forwarded to `/-/pnpr/v0/resolve`.","+    pub(crate) update_checksums: bool,","     /// Regenerate derived lockfile metadata while retaining compatible pins.","     pub(crate) fix: bool,","     /// `--lockfile-only`. Forwarded to `/-/pnpr/v0/resolve` so the server"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_request.rs","lines":["@@ -115,21 +115,13 @@ pub(super) fn resolve_projects_options(","             allow_unused_patches: state.config.allow_unused_patches,","             catalogs: session.catalogs.take(),","         },","-        resolution: pnpm_pnpr_client::ResolutionSettings {","-            auto_install_peers: Some(state.config.auto_install_peers),","-            dedupe_peers: Some(state.config.dedupe_peers),","-            exclude_links_from_lockfile: Some(state.config.exclude_links_from_lockfile),","-            add_missing_peer_types: Some(state.config.add_missing_peer_types),","-            project_scoped_optional_peers: Some(","-                state.config.project_scoped_optional_peers_take_effect(),","-            ),","-            resolution_mode: state.config.resolution_mode,","-        },","+        resolution: resolution_settings(state.config),","         reuse: pnpm_pnpr_client::LockfileReuseOptions {","             lockfile: session.previous_wanted.cloned(),","             frozen_lockfile: link.lockfile.frozen,","             prefer_frozen_lockfile: Some(link.lockfile.prefer_frozen),","             update_patches: link.lockfile.update_patches,","+            update_checksums: link.lockfile.update_checksums,","             ignore_manifest_check: link.lockfile.ignore_manifest_check,","             trust_lockfile: link.lockfile.trust,","         },","@@ -137,6 +129,24 @@ pub(super) fn resolve_projects_options(","     }"," }"," ","+/// The client's settings that shape the lockfile the server resolves.","+fn resolution_settings(config: &pnpm_config::Config) -> pnpm_pnpr_client::ResolutionSettings {","+    pnpm_pnpr_client::ResolutionSettings {","+        auto_install_peers: Some(config.auto_install_peers),","+        dedupe_peers: Some(config.dedupe_peers),","+        exclude_links_from_lockfile: Some(config.exclude_links_from_lockfile),","+        add_missing_peer_types: Some(config.add_missing_peer_types),","+        project_scoped_optional_peers: Some(config.project_scoped_optional_peers_take_effect()),","+        resolution_mode: config.resolution_mode,","+        dependency_graph: pnpm_pnpr_client::DependencyGraphSettings {","+            inject_workspace_packages: config.inject_workspace_packages,","+            dedupe_injected_deps: (!config.dedupe_injected_deps).then_some(false),","+            ignored_optional_dependencies: config.ignored_optional_dependencies.clone(),","+            block_exotic_subdeps: config.block_exotic_subdeps,","+        },","+    }","+}","+"," /// `addMissingPeerTypes` was on, but the lockfile the pnpr server returned"," /// was resolved without it. A server that predates the setting drops it from"," /// the request, and every later install would reject the lockfile.","@@ -233,6 +243,12 @@ fn resolve_project(","             .dependencies([DependencyGroup::Peer])","             .map(|(name, spec)| (name.to_string(), spec.to_string()))","             .collect(),","+        dependencies_meta: manifest","+            .value()","+            .get(\"dependenciesMeta\")","+            .and_then(serde_json::Value::as_object)","+            .filter(|meta| !meta.is_empty())","+            .cloned(),","     }"," }"," "],"additions":26,"deletions":10,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_resolution.rs","lines":["@@ -136,6 +136,9 @@ async fn prepare_pnpr_session<'a, Reporter: self::Reporter + 'static>(","     link: &PnprLink<'_>,","     lockfile_dir: &std::path::Path,"," ) -> miette::Result<PnprSession<'a>> {","+    if link.lockfile.frozen && link.lockfile.update_checksums {","+        return Err(pnpm_package_manager::InstallError::FrozenLockfileWithUpdateChecksums.into());","+    }","     let projects = resolve_projects_for_pnpr(state, selection, link.use_state_lockfile)?;","     let catalogs = pnpr_catalogs(state)?;","     check_pnpr_project_specs_and_config(state.config, &projects, catalogs.as_ref(), link)?;","@@ -406,6 +409,7 @@ async fn satisfied_without_server("," ) -> bool {","     let exchange_free = !link.lockfile.frozen","         && !link.lockfile.update_patches","+        && !link.lockfile.update_checksums","         && !link.lockfile.fix","         && !link.lockfile.only","         && link.lockfile.prefer_frozen"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/update.rs","lines":["@@ -439,6 +439,7 @@ impl UpdateArgs {","                 frozen: false,","                 prefer_frozen: false,","                 update_patches: true,","+                update_checksums: false,","                 fix: false,","                 only: self.install.lockfile_only,","                 ignore_manifest_check: false,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install.rs","lines":["@@ -783,6 +783,7 @@ mod hosted;"," mod optional_peers;"," mod publish_retry;"," mod workspace;","+mod workspace_settings;"," "," mod revisions;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install/workspace_settings.rs","lines":["@@ -0,0 +1,273 @@","+//! Workspace settings that change what the server resolves, and the install","+//! flags that change how it treats the input lockfile.","+","+use super::{","+    AddMockedRegistry,","+    CommandExtra,","+    CommandTempCwd,","+    WORKSPACE_HELLO,","+    configure_pnpr_auth,","+    configure_workspace,","+    fs,","+    pacquet_at,","+    read_workspace_lockfile,","+    start_pnpr,","+    workspace_importer,","+    workspace_importer_version,","+};","+use crate::_utils::append_workspace_yaml_key;","+use assert_cmd::assert::OutputAssertExt;","+use std::path::Path;","+","+fn write_manifest(dir: &Path, manifest: &serde_json::Value) {","+    fs::create_dir_all(dir).expect(\"create project dir\");","+    fs::write(","+        dir.join(\"package.json\"),","+        serde_json::to_string_pretty(manifest).expect(\"serialize package.json\"),","+    )","+    .expect(\"write package.json\");","+}","+","+/// `app` depends on the workspace project `lib`, with `extra` merged into","+/// `app`'s manifest.","+fn write_app_and_lib(workspace: &Path, extra: &serde_json::Value) {","+    let mut app = serde_json::json!({","+        \"name\": \"app\",","+        \"version\": \"1.0.0\",","+        \"dependencies\": { \"lib\": \"workspace:*\" },","+    });","+    if let (Some(app), Some(extra)) = (app.as_object_mut(), extra.as_object()) {","+        app.extend(extra.clone());","+    }","+    write_manifest(&workspace.join(\"packages/app\"), &app);","+    write_manifest(","+        &workspace.join(\"packages/lib\"),","+        &serde_json::json!({ \"name\": \"lib\", \"version\": \"1.0.0\" }),","+    );","+}","+","+fn install_via_pnpr(","+    workspace: &Path,","+    registry: &str,","+    pnpr_url: &str,","+) -> assert_cmd::assert::Assert {","+    pacquet_at(workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", registry)","+        .with_args([\"install\", \"--pnpr-server\", pnpr_url])","+        .assert()","+}","+","+#[test]","+fn install_via_pnpr_injects_workspace_packages() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    configure_workspace(&workspace);","+    append_workspace_yaml_key(&workspace, \"injectWorkspacePackages\", true);","+    write_app_and_lib(&workspace, &serde_json::json!({}));","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+","+    install_via_pnpr(&workspace, mock_instance.url(), &pnpr_url).success();","+","+    let lockfile = read_workspace_lockfile(&workspace);","+    assert!(lockfile.settings.is_some_and(|settings| settings.inject_workspace_packages));","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn install_via_pnpr_honors_dependencies_meta() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    configure_workspace(&workspace);","+    write_app_and_lib(","+        &workspace,","+        &serde_json::json!({ \"dependenciesMeta\": { \"lib\": { \"injected\": true } } }),","+    );","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+","+    install_via_pnpr(&workspace, mock_instance.url(), &pnpr_url).success();","+","+    let lockfile = read_workspace_lockfile(&workspace);","+    assert_eq!(","+        workspace_importer(&lockfile, \"packages/app\").dependencies_meta,","+        Some(serde_json::json!({ \"lib\": { \"injected\": true } })),","+    );","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn install_via_pnpr_skips_ignored_optional_dependencies() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    configure_workspace(&workspace);","+    append_workspace_yaml_key(","+        &workspace,","+        \"ignoredOptionalDependencies\",","+        format!(\"['{WORKSPACE_HELLO}']\"),","+    );","+    write_manifest(","+        &workspace.join(\"packages/app\"),","+        &serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"optionalDependencies\": { WORKSPACE_HELLO: \"1.0.0\" },","+        }),","+    );","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+","+    install_via_pnpr(&workspace, mock_instance.url(), &pnpr_url).success();","+","+    let lockfile = read_workspace_lockfile(&workspace);","+    assert_eq!(lockfile.ignored_optional_dependencies, Some(vec![WORKSPACE_HELLO.to_string()]));","+    assert!(workspace_importer(&lockfile, \"packages/app\").optional_dependencies.is_none());","+","+    drop((root, mock_instance));","+}","+","+/// pnpr does not fetch exotic subdependencies, so it refuses","+/// `blockExoticSubdeps: false` and pnpm resolves locally.","+#[test]","+fn install_via_pnpr_resolves_locally_when_exotic_subdeps_are_allowed() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    configure_workspace(&workspace);","+    append_workspace_yaml_key(&workspace, \"blockExoticSubdeps\", false);","+    write_app_and_lib(&workspace, &serde_json::json!({}));","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+","+    let output = install_via_pnpr(&workspace, mock_instance.url(), &pnpr_url).success();","+","+    let stderr = String::from_utf8_lossy(&output.get_output().stderr).into_owned();","+    let stdout = String::from_utf8_lossy(&output.get_output().stdout).into_owned();","+    assert!(","+        format!(\"{stdout}{stderr}\").contains(\"blockExoticSubdeps\"),","+        \"stdout: {stdout}\\nstderr: {stderr}\",","+    );","+    let lockfile = read_workspace_lockfile(&workspace);","+    assert_eq!(workspace_importer_version(&lockfile, \"packages/app\", \"lib\"), \"link:../lib\");","+","+    drop((root, mock_instance));","+}","+","+const WRONG_INTEGRITY: &str = \"sha512-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\";","+","+#[test]","+fn install_via_pnpr_updates_checksums() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    configure_workspace(&workspace);","+    write_manifest(","+        &workspace.join(\"packages/app\"),","+        &serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { WORKSPACE_HELLO: \"1.0.0\" },","+        }),","+    );","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+    install_via_pnpr(&workspace, mock_instance.url(), &pnpr_url).success();","+    let lockfile_path = workspace.join(\"pnpm-lock.yaml\");","+    let resolved = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","+    let integrity = resolved","+        .split_whitespace()","+        .find(|word| word.starts_with(\"sha512-\"))","+        .expect(\"the lockfile records an integrity\")","+        .trim_end_matches(['}', ',']);","+    fs::write(&lockfile_path, resolved.replace(integrity, WRONG_INTEGRITY))","+        .expect(\"write pnpm-lock.yaml\");","+    fs::remove_dir_all(workspace.join(\"node_modules\")).expect(\"remove node_modules\");","+","+    pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([\"install\", \"--update-checksums\", \"--pnpr-server\", &pnpr_url])","+        .assert()","+        .success();","+","+    let updated = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","+    assert!(updated.contains(integrity), \"{updated}\");","+    assert!(!updated.contains(WRONG_INTEGRITY), \"{updated}\");","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn install_via_pnpr_rejects_update_checksums_with_frozen_lockfile() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    configure_workspace(&workspace);","+    write_app_and_lib(&workspace, &serde_json::json!({}));","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+    install_via_pnpr(&workspace, mock_instance.url(), &pnpr_url).success();","+","+    let output = pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([","+            \"install\",","+            \"--frozen-lockfile\",","+            \"--update-checksums\",","+            \"--pnpr-server\",","+            &pnpr_url,","+        ])","+        .assert()","+        .failure();","+","+    let stderr = String::from_utf8_lossy(&output.get_output().stderr).into_owned();","+    assert!(","+        stderr.contains(\"ERR_PNPM_CONFIG_CONFLICT_FROZEN_LOCKFILE_WITH_UPDATE_CHECKSUMS\"),","+        \"{stderr}\",","+    );","+","+    drop((root, mock_instance));","+}","+","+/// pnpr resolves into the v9 format, so a v13 project keeps resolving","+/// locally and its lockfile is left as it was.","+#[test]","+fn update_patches_via_pnpr_does_not_downgrade_a_v13_lockfile() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    append_workspace_yaml_key(&workspace, \"lockfile\", \"\\n  format: v13\");","+    write_manifest(","+        &workspace,","+        &serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { WORKSPACE_HELLO: \"1.0.0\" },","+        }),","+    );","+    pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let lockfile_path = workspace.join(\"pnpm-lock.yaml\");","+    let local = fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\");","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+","+    let output = pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([\"update\", \"--patches\", \"--pnpr-server\", &pnpr_url])","+        .assert()","+        .failure();","+","+    let stderr = String::from_utf8_lossy(&output.get_output().stderr).into_owned();","+    assert!(stderr.contains(\"ERR_PNPM_RESOLUTION_SETTINGS_WITH_PNPR_SERVER\"), \"{stderr}\");","+    assert_eq!(fs::read_to_string(&lockfile_path).expect(\"read pnpm-lock.yaml\"), local);","+","+    drop((root, mock_instance));","+}"],"additions":273,"deletions":0,"truncated":false},{"path":"pnpm/crates/pnpr-client/src/lib.rs","lines":["@@ -218,6 +218,45 @@ pub struct ResolutionSettings {","     /// The client's `resolutionMode`. The server picks versions the way","     /// the client would, instead of falling back to its own default.","     pub resolution_mode: ResolutionMode,","+    #[serde(flatten)]","+    pub dependency_graph: DependencyGraphSettings,","+}","+","+/// Settings that decide which dependencies the resolved graph holds and how","+/// workspace projects join it. Each is omitted at its default, so a request","+/// that does not change them is accepted by servers that predate them.","+#[derive(Clone, Serialize)]","+#[serde(rename_all = \"camelCase\")]","+pub struct DependencyGraphSettings {","+    #[serde(skip_serializing_if = \"std::ops::Not::not\")]","+    pub inject_workspace_packages: bool,","+    #[serde(skip_serializing_if = \"Option::is_none\")]","+    pub dedupe_injected_deps: Option<bool>,","+    #[serde(skip_serializing_if = \"Option::is_none\")]","+    pub ignored_optional_dependencies: Option<Vec<String>>,","+    /// pnpr refuses `false`: it does not fetch exotic subdependencies, and the","+    /// client resolves locally instead.","+    #[serde(skip_serializing_if = \"is_true\")]","+    pub block_exotic_subdeps: bool,","+}","+","+impl Default for DependencyGraphSettings {","+    fn default() -> Self {","+        Self {","+            inject_workspace_packages: false,","+            dedupe_injected_deps: None,","+            ignored_optional_dependencies: None,","+            block_exotic_subdeps: true,","+        }","+    }","+}","+","+#[expect(","+    clippy::trivially_copy_pass_by_ref,","+    reason = \"serde's skip_serializing_if passes a reference\"","+)]","+fn is_true(value: &bool) -> bool {","+    *value"," }"," "," #[derive(Clone, Serialize)]","@@ -235,6 +274,10 @@ pub struct LockfileReuseOptions {","     /// Refresh registry artifacts while retaining every locked package","     /// version.","     pub update_patches: bool,","+    /// `--update-checksums`. Omitted when off, like the settings of","+    /// [`ResolutionSettings`].","+    #[serde(skip_serializing_if = \"std::ops::Not::not\")]","+    pub update_checksums: bool,","     /// `ignoreManifestCheck`: skip the manifest ↔ lockfile freshness","     /// comparison during the frozen resolve.","     pub ignore_manifest_check: bool,","@@ -272,6 +315,13 @@ pub struct PublishConfig {"," /// One workspace project sent to the pnpr resolver."," #[derive(Clone, Serialize)]"," #[serde(rename_all = \"camelCase\")]","+#[cfg_attr(","+    dylint_lib = \"perfectionist\",","+    expect(","+        perfectionist::too_many_struct_fields,","+        reason = \"mirrors the flat project object of the pnpr resolve request\"","+    )","+)]"," pub struct ResolveProject {","     /// Importer directory relative to the lockfile directory, in POSIX form.","     pub dir: String,","@@ -291,6 +341,8 @@ pub struct ResolveProject {","     /// servers that predate the field.","     #[serde(skip_serializing_if = \"DepMap::is_empty\")]","     pub peer_dependencies: DepMap,","+    #[serde(skip_serializing_if = \"Option::is_none\")]","+    pub dependencies_meta: Option<serde_json::Map<String, serde_json::Value>>,"," }"," "," /// Inputs for a multi-project workspace resolution.","@@ -324,6 +376,7 @@ impl From<ResolveOptions> for ResolveProjectsOptions {","                 dev_dependencies: opts.dev_dependencies,","                 optional_dependencies: opts.optional_dependencies,","                 peer_dependencies: DepMap::new(),","+                dependencies_meta: None,","             }],","             fix_lockfile: false,","             routing: opts.routing,"],"additions":53,"deletions":0,"truncated":false},{"path":"pnpm/crates/pnpr-client/src/tests.rs","lines":["@@ -148,6 +148,45 @@ async fn the_resolve_request_carries_the_catalogs_and_the_whole_policy() {","     resolve_mock.assert_async().await;"," }"," ","+/// A server that predates these fields refuses a request naming them, so","+/// they are sent only when they differ from the defaults.","+#[test]","+fn the_resolve_request_omits_workspace_settings_at_their_defaults() {","+    let body = serde_json::to_value(resolve_projects_options()).expect(\"request serializes\");","+    for field in [","+        \"injectWorkspacePackages\",","+        \"dedupeInjectedDeps\",","+        \"ignoredOptionalDependencies\",","+        \"blockExoticSubdeps\",","+        \"updateChecksums\",","+    ] {","+        assert!(body.get(field).is_none(), \"{field} is sent at its default\");","+    }","+    assert!(body[\"projects\"][0].get(\"dependenciesMeta\").is_none());","+}","+","+#[test]","+fn the_resolve_request_carries_changed_workspace_settings() {","+    let mut options = resolve_projects_options();","+    options.resolution.dependency_graph.inject_workspace_packages = true;","+    options.resolution.dependency_graph.dedupe_injected_deps = Some(false);","+    options.resolution.dependency_graph.ignored_optional_dependen