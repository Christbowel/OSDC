ported: finder.found,","+    }","+}","+","+/// Finds the type references ngtsc's `assertEmittableInputType` rejects within the context file:","+/// identifiers naming a declaration of the file that it does not statically export.","+struct UnexportedTypeFinder<'s, 'a> {","+    semantic: &'s Semantic<'a>,","+    found: Option<UnexportedType>,","+}","+","+impl<'a> Visit<'a> for UnexportedTypeFinder<'_, 'a> {","+    fn visit_ts_type_reference(&mut self, it: &TSTypeReference<'a>) {","+        if self.found.is_some() {","+            return;","+        }","+        if let TSTypeName::IdentifierReference(ident) = &it.type_name {","+            self.check(ident);","+        }","+        walk::walk_ts_type_reference(self, it);","+    }","+}","+","+impl UnexportedTypeFinder<'_, '_> {","+    fn check(&mut self, ident: &IdentifierReference<'_>) {","+        let scoping = self.semantic.scoping();","+        let Some(symbol_id) = ident","+            .reference_id","+            .get()","+            .and_then(|id| scoping.get_reference(id).symbol_id())","+        else {","+            // A global: ngtsc emits it as an ambient reference.","+            return;","+        };","+        let flags = scoping.symbol_flags(symbol_id);","+        // Imports name a declaration exported by another file. Type parameters only occur in","+        // generic functions, which are rejected before the type is looked at.","+        if flags","+            .intersects(SymbolFlags::Import | SymbolFlags::TypeImport | SymbolFlags::TypeParameter)","+        {","+            return;","+        }","+        if is_statically_exported(symbol_id, self.semantic) {","+            return;","+        }","+        self.found = Some(UnexportedType {","+            name: scoping.symbol_name(symbol_id).to_string(),","+            decl_span: self.semantic.symbol_declaration(symbol_id).kind().span(),","+        });","+    }","+}","+","+/// Whether a declaration is exported from its file, by an `export` modifier or through an export","+/// list or `export default`, as ngtsc's `ReflectionHost.isStaticallyExported`.","+fn is_statically_exported(symbol_id: SymbolId, semantic: &Semantic<'_>) -> bool {","+    let nodes = semantic.nodes();","+    let is_export = |kind: AstKind<'_>| {","+        matches!(","+            kind,","+            AstKind::ExportDeclaration(_)","+                | AstKind::ExportDefaultDeclaration(_)","+                | AstKind::ExportSpecifier(_)","+        )","+    };","+    let declaration = semantic.symbol_declaration(symbol_id);","+    if is_export(nodes.parent_kind(declaration.id())) {","+        return true;","+    }","+    semantic","+        .scoping()","+        .get_resolved_references(symbol_id)","+        .any(|reference| is_export(nodes.parent_kind(reference.node_id())))","+}","+","+/// [`FunctionFacts`] for the function declarations at the top level of a file, by name.","+pub(crate) fn collect_function_facts(","+    program: &Program<'_>,","+    semantic: &Semantic<'_>,","+) -> HashMap<String, FunctionFacts> {","+    let mut declarations: Vec<(&str, Vec<&Function<'_>>)> = Vec::new();","+    for statement in &program.body {","+        let function = match statement {","+            Statement::FunctionDeclaration(function) => function,","+            Statement::ExportDeclaration(export) => match &export.declaration {","+                Declaration::FunctionDeclaration(function) => function,","+                _ => continue,","+            },","+            Statement::ExportDefaultDeclaration(export) => match &export.declaration {","+                ExportDefaultDeclarationKind::FunctionDeclaration(function) => function,","+                _ => continue,","+            },","+            _ => continue,","+        };","+        let Some(id) = &function.id else {","+            continue;","+        };","+        match declarations","+            .iter_mut()","+            .find(|(name, _)| *name == id.name.as_str())","+        {","+            Some