 multiplier, cap)","+}","+","+fn apply_capped_gas_estimate_multiplier(","+    estimate: u64,","+    multiplier: Option<u64>,","+    cap: Option<u64>,","+) -> Result<u64> {","     let Some(multiplier) = multiplier else { return Ok(estimate) };","-    let adjusted = u128::from(estimate) * u128::from(multiplier) / 100;","+    let mut adjusted = u128::from(estimate) * u128::from(multiplier) / 100;","+    if let Some(cap) = cap {","+        adjusted = adjusted.min(u128::from(cap)).max(u128::from(estimate));","+    }","     adjusted.try_into().map_err(|_| eyre::eyre!(\"multiplied gas estimate exceeds u64\"))"," }"," ","@@ -1296,13 +1319,55 @@ mod tests {"," ","     #[test]","     fn applies_gas_estimate_multiplier() {","-        assert_eq!(apply_gas_estimate_multiplier(21_000, None).unwrap(), 21_000);","-        assert_eq!(apply_gas_estimate_multiplier(21_000, Some(150)).unwrap(), 31_500);","+        assert_eq!(apply_gas_estimate_multiplier(21_000, None, None).unwrap(), 21_000);","+        assert_eq!(apply_gas_estimate_multiplier(21_000, Some(150), None).unwrap(), 31_500);","         assert_eq!(","-            apply_gas_estimate_multiplier(21_000, Some(1_000_000_000_000_000)).unwrap(),","+            apply_gas_estimate_multiplier(21_000, Some(1_000_000_000_000_000), None).unwrap(),","             210_000_000_000_000_000","         );","-        assert!(apply_gas_estimate_multiplier(u64::MAX, Some(101)).is_err());","+        assert!(apply_gas_estimate_multiplier(u64::MAX, Some(101), None).is_err());","+    }","+","+    #[test]","+    fn caps_gas_estimate_multiplier() {","+        let cap = Some(30_000_000);","+        assert_eq!(","+            apply_capped_gas_estimate_multiplier(20_000_000, Some(130), cap).unwrap(),","+            26_000_000","+        );","+        assert_eq!(","+            apply_capped_gas_estimate_multiplier(25_000_000, Some(130), cap).unwrap(),","+            30_000_000","+        );","+        // An estimate above the cap is kept as it is, for the node to reject with its reason.","+        assert_eq!(","+            apply_capped_gas_estimate_multiplier(31_000_000, Some(130), cap).unwrap(),","+            31_000_000","+        );","+        assert_eq!(","+            apply_capped_gas_estimate_multiplier(u64::MAX, Some(101), cap).unwrap(),","+            u64::MAX","+        );","+        assert_eq!(","+            apply_capped_gas_estimate_multiplier(25_000_000, None, cap).unwrap(),","+            25_000_000","+        );","+","+        // Tempo mainnet and Moderato cap transactions at 30M, Ethereum mainnet at 2^24.","+        assert_eq!(","+            apply_gas_estimate_multiplier(25_000_000, Some(130), Some(4217)).unwrap(),","+            30_000_000","+        );","+        assert_eq!(","+            apply_gas_estimate_multiplier(25_000_000, Some(130), Some(42431)).unwrap(),","+            30_000_000","+        );","+        assert_eq!(apply_gas_estimate_multiplier(15_000_000, Some(130), Some(1)).unwrap(), 1 << 24);","+        // Chains without a known cap keep the whole margin.","+        assert_eq!(","+            apply_gas_estimate_multiplier(25_000_000, Some(130), Some(31337)).unwrap(),","+            32_500_000","+        );","     }"," ","     #[test]"],"additions":72,"deletions":7,"truncated":false},{"path":"crates/evm/core/src/evm/mod.rs","lines":["@@ -22,7 +22,7 @@ use evm2::{","     evm::precompile::PrecompileProvider, registry::TxRegistry,"," };"," use foundry_common::{FoundryReceiptResponse, FoundryTransactionBuilder, fmt::UIfmt};","-use foundry_evm_hardforks::ExecutionSpec;","+use foundry_evm_hardforks::{ExecutionSpec, FoundryHardfork};"," use foundry_evm_networks::NetworkConfigs;"," use serde::{Deserialize, Serialize};"," use std::fmt::Debug;","@@ -273,6 +273,31 @@ pub type TxResultFor<FEN> = TxResult<TypesFor<FEN>>;"," pub type FoundryEvmFor<'a, FEN> = Evm<'a, TypesFor<FEN>>;"," pub type InterpreterFor<'frame, 'host, FEN> =","     evm2::interpreter::Interpreter<'frame, 'host, TypesFor<FEN>>;","+","+/// Returns the most gas one transaction may use on a known chain at `timestamp`, as the chain's","+/// execution factory enforces it, or `None` for an unknown chain or one without such a cap.","+pub fn tx_gas_limit_cap(chain_id: u64, timestamp: u64) -> Option<u64> {","+    let hardfork = FoundryHardfork::from_chain_and_timestamp(chain_id, timestamp)?;","+    // Under EIP-8037 the cap only bounds regular gas, not the transaction's gas limit.","+    if evm2::SpecId::from(hardfork) >= evm2::SpecId::AMSTERDAM {","+        return None;","+    }","+    let version = match hardfork {","+        FoundryHardfork::Ethereum(_) => version_at::<EthEvmFactory>(hardfork, chain_id),","+        #[cfg(feature = \"optimism\")]","+        FoundryHardfork::Optimism(_) => version_at::<op_evm2::OpEvmFactory>(hardfork, chain_id),","+        #[cfg(feature = \"base\")]","+        FoundryHardfork::Base(_) => version_at::<base_evm2::BaseEvmFactory>(hardfork, chain_id),","+        FoundryHardfork::Tempo(_) => version_at::<tempo_evm::TempoEvmFactory>(hardfork, chain_id),","+        #[cfg(feature = \"monad\")]","+        FoundryHardfork::Monad(_) => version_at::<monad_evm2::MonadEvmFactory>(hardfork, chain_id),","+    }?;","+    (version.tx_gas_limit_cap != u64::MAX).then_some(version.tx_gas_limit_cap)","+}","+","+fn version_at<F: FoundryEvmFactory>(hardfork: FoundryHardfork, chain_id: u64) -> Option<Version> {","+    Some(F::default().version(SpecOf::<F>::from_foundry_hardfork(hardfork)?, chain_id))","+}"," pub type MessageFor<FEN> = evm2::interpreter::Message<TypesFor<FEN>>;"," pub type MessageResultFor<FEN> = evm2::interpreter::MessageResult<TypesFor<FEN>>;"," pub type NetworkFor<FEN> = <FEN as FoundryEvmNetwork>::Network;"],"additions":26,"deletions":1,"truncated":false},{"path":"crates/forge/src/cmd/create.rs","lines":["@@ -643,6 +643,7 @@ impl CreateArgs {","             deployer.tx.set_gas_limit(apply_gas_estimate_multiplier(","                 estimated,","                 self.gas