t.category\", \"network\", \"os\", \"MacOS\"))","+            .add(new IndexRequest(\"eql_events\").source(\"@timestamp\", \"2026-07-22T10:00:02Z\", \"event.category\", \"process\", \"os\", \"Linux\"))","+            .setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE)","+            .get();","+    }","+","+    public void testLookupJoinAfterEqlUsesLocalLookupIndex() {","+        for (String eqlSource : List.of(LOCAL_EQL_SOURCE, REMOTE_EQL_SOURCE)) {","+            for (String lookupIndex : List.of(\"os_lookup\", \"_coordinator:os_lookup\")) {","+                String query = eqlSource + \" | LOOKUP JOIN \" + lookupIndex + \" ON os | KEEP os, family | SORT os\";","+                try (EsqlQueryResponse resp = runQuery(query, null)) {","+                    assertThat(query, getValuesList(resp), equalTo(List.of(List.of(\"Android\", \"mobile\"), List.of(\"Linux\", \"desktop\"))));","+                }","+            }","+        }","+    }","+","+    public void testEnrichAfterEqlUsesLocalPolicy() {","+        for (String eqlSource : List.of(LOCAL_EQL_SOURCE, REMOTE_EQL_SOURCE)) {","+            for (Enrich.Mode mode : List.of(Enrich.Mode.ANY, Enrich.Mode.COORDINATOR)) {","+                String query = eqlSource + \" | \" + enrichVendors(mode) + \" | KEEP os, vendor | SORT os\";","+                try (EsqlQueryResponse resp = runQuery(query, null)) {","+                    assertThat(query, getValuesList(resp), equalTo(List.of(List.of(\"Android\", \"Samsung\"), List.of(\"Linux\", \"Redhat\"))));","+                }","+            }","+        }","+    }","+","+    public void testRemoteEnrichAfterEqlIsRejected() {","+        for (String eqlSource : List.of(LOCAL_EQL_SOURCE, REMOTE_EQL_SOURCE)) {","+            for (String enrich : List.of(","+                \"ENRICH _remote:vendors ON os\",","+                \"EVAL ip = \\\"192.168.1.3\\\" | ENRICH _remote:hosts_local ON ip WITH host_os = os\"","+            )) {","+                String query = eqlSource 