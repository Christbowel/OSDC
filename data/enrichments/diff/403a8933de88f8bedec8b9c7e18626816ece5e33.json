fier(result_text);"," \t\t} else if (IsSingleQuoted(result_text) && SupportsStringLiteral()) {"," \t\t\t// a single-quoted token in a table or file-name position is a path, so it is unwrapped but never folded"," \t\t\tresult_text = result_text.substr(1, result_text.size() - 2);","@@ -200,8 +210,7 @@ class ReservedIdentifierMatcher : public IdentifierMatcher {"," \t\t// unlike IdentifierMatcher this rule does not unwrap path literals, it only has to avoid folding them"," \t\tconst bool is_path_literal = IsSingleQuoted(result_text) && SupportsStringLiteral();"," \t\tif (IsQuoted(result_text)) {","-\t\t\tresult_text = result_text.substr(1, result_text.size() - 2);","-\t\t\tresult_text = StringUtil::Replace(result_text, \"\\\"\\\"\", \"\\\"\");","+\t\t\tUnquoteIdentifier(result_text);"," \t\t} else if (!is_path_literal) {"," \t\t\tstate.FoldIdentifier(result_text);"," \t\t}"],"additions":16,"deletions":7,"truncated":false},{"path":"src/parser/peg/grammar/statements/create_table.gram","lines":["@@ -72,7 +72,7 @@ TopForeignKeyConstraint <- 'FOREIGN' 'KEY' ColumnIdList ForeignKeyConstraint"," ColumnIdList <- Parens(List(ColId))"," "," PlainIdentifier <- !ReservedKeyword <[a-z_]i[a-z0-9_]i*>","-QuotedIdentifier <- '\"' [^\"]* '\"'","+QuotedIdentifier <- ('\"' [^\"]* '\"') / ('`' [^`]* '`')"," DottedIdentifier <- Identifier DotColLabel*"," DotColLabel <- '.' ColLabel"," Identifier <- QuotedIdentifier / PlainIdentifier"],"additions":1,"deletions":1,"truncated":false},{"path":"src/parser/peg/tokenizer/base_tokenizer.cpp","lines":["@@ -15,7 +15,9 @@ bool Tokenizer::BackslashEscapesStringLiterals() const {"," }"," "," bool Tokenizer::IsQuotedIdentifierDelimiter(char character) const {","-\treturn character == '\"';","+\t// double quotes are the SQL standard delimiter; backticks are accepted as an alternative","+\t// (as in several other SQL dialects), with the same doubling rule for escaping the delimiter","+\treturn character == '\"' || character == '`';"," }"," "," void Tokenizer::HandleLastToken(TokenizerBehavior &behavior, TokenizeState state, const string &sql,"],"additions":3,"deletions":1,"truncated":false},{"path":"src/parser/peg/tokenizer/parser_tokenizer.cpp","lines":["@@ -4,7 +4,10 @@"," namespace duckdb {"," "," static bool IsEmptyQuotedIdentifier(const string &sql, idx_t start, idx_t end, TokenType type) {","-\treturn type == TokenType::IDENTIFIER && end == start + 2 && sql.substr(start, 2) == \"\\\"\\\"\";","+\tif (type != TokenType::IDENTIFIER || end != start + 2) {","+\t\treturn false;","+\t}","+\treturn (sql[start] == '\"' && sql[start + 1] == '\"') || (sql[start] == '`' && sql[start + 1] == '`');"," }"," "," ParserTokenizerBehavior::ParserTokenizerBehavior(const string &sql, vector<MatcherToken> &tokens)"],"additions":4,"deletions":1,"truncated":false},{"path":"test/api/test_dialect_extension.cpp","lines":["@@ -86,12 +86,18 @@ TEST_CASE(\"Dialect tokenizer hooks are opt-in\", \"[api][dialect_extension]\") {"," \tTokenizer default_tokenizer(helper);"," \tHookTokenizer hook_tokenizer(helper, true, true, true);"," ","+\t// backticks are accepted as identifier delimiters by default, a dialect can opt out of them","+\tHookTokenizer no_backtick_tokenizer(helper, false, false, false);"," \tauto default_backtick = Tokenize(default_tokenizer, \"`a b`\");"," \tauto hooked_backtick = Tokenize(hook_tokenizer, \"`a b`\");","-\tREQUIRE(default_backtick.size() > 2);","+\tauto no_backtick = Tokenize(no_backtick_tokenizer, \"`a b`\");","+\tREQUIRE(default_backtick.size() >= 1);","+\tREQUIRE(default_backtick[0].type == TokenType::IDENTIFIER);","+\tREQUIRE(default_backtick[0].text == \"`a b`\");"," \tREQUIRE(hooked_backtick.size() >= 1);"," \tREQUIRE(hooked_backtick[0].type == TokenType::IDENTIFIER);"," \tREQUIRE(hooked_backtick[0].text == \"`a b`\");","+\tREQUIRE(no_backtick.size() > 2);"," "," \tauto default_operator = Tokenize(default_tokenizer, \">>=\");"," \tauto hooked_operator = Tokenize(hook_tokenizer, \">>=\");"],"additions":7,"deletions":1,"truncated":false},{"path":"test/sql/parser/backtick_identifiers.test","lines":["@@ -0,0 +1,250 @@","+# name: test/sql/parser/backtick_identifiers.test","+# description: Backtick-quoted identifiers are accepted as an alternative to double quotes","+# group: [parser]","+","+statement ok","+PRAGMA enable_verification","+","+# simple backtick-quoted column reference","+query I","+SELECT `x` FROM (SELECT 1 x) t;","+----","+1","+","+# backtick-quoted alias","+query I","+SELECT 42 AS `my alias`;","+----","+42","+","+query I","+SELECT `my alias` FROM (SELECT 42 AS `my alias`);","+----","+42","+","+# DDL with spaces in identifiers","+statement ok","+CREATE TABLE `my table`(`a col` INTEGER, `b col` VARCHAR);","+","+statement ok","+INSERT INTO `my table` VALUES (1, 'one'), (2, 'two');","+","+# qualified reference with backtick-quoted table alias","+query II","+SELECT `t`.`a col`, `t`.`b col` FROM `my table` `t` ORDER BY `t`.`a col`;","+----","+1\tone","+2\ttwo","+","+query II","+SELECT `t`.`a col`, `t`.`b col` FROM `my table` AS `t` ORDER BY ALL;","+----","+1\tone","+2\ttwo","+","+# backticks and double quotes refer to the same identifier","+query II","+SELECT \"a col\", `a col` FROM \"my table\" ORDER BY `a col`;","+----","+1\t1","+2\t2","+","+# schema-qualified names (`db`.`table`)","+statement ok","+CREATE SCHEMA `my schema`;","+","+statement ok","+CREATE TABLE `my schema`.`tbl`(`i` INTEGER);","+","+statement ok","+INSERT INTO `my schema`.`tbl` VALUES (7);","+","+query I","+SELECT `i` FROM `my schema`.`tbl`;","+----","+7","+","+query I","+SELECT i FROM \"my schema\".tbl;","+----","+7","+","+# backtick-quoted identifiers in other DDL positions","+statement ok","+ALTER TABLE `my table` ADD COLUMN `c col` INTEGER DEFAULT 3;","+","+query I","+SELECT `c col` FROM `my table` LIMIT 1;","+----","+3","+","+statement ok","+CREATE VIEW `my view` AS SELECT `a col` FROM `my table`;","+","+query I","+SELECT COUNT(*) FROM `my view`;","+----","+2","+","+statement ok","+UPDATE `my table` SET `b col` = 'ONE' WHERE `a col` = 1;","+","+query I","+SELECT `b col` FROM `my table` WHERE `a col` = 1;","+----","+ONE","+","+statement ok","+DELETE FROM `my table` WHERE `a col` = 2;","+","+query I","+SELECT COUNT(*) FROM `my table`;","+----","+1","+","+# a doubled backtick escapes a backtick inside the identifier","+query I","+SELECT column_name FROM (DESCRIBE SELECT 1 AS `a``b`);","+----","+a`b","+","+query I","+SELECT \"a`b\" FROM (SELECT 1 AS `a``b`);","+----","+1","+","+# a double quote has no special meaning inside backticks, and vice versa","+query I","+SELECT column_name FROM (DESCRIBE SELECT 1 AS `a\"b`);","+----","+a\"b","+","+query I","+SELECT column_name FROM (DESCRIBE SELECT 1 AS \"a`b\");","+----","+a`b","+","+query I","+SELECT `a\"b` FROM (SELECT 1 AS \"a\"\"b\");","+----","+1","+","+# backticks inside string literals are plain characters","+query I","+SELECT '`' || 'a' || '`';","+----","+`a`","+","+query I","+SELECT 'it''s `quoted`';","+----","+it's `quoted`","+","+# dollar-quoted strings are unaffected","+query I","+SELECT $$`x`$$;","+----","+`x`","+","+query I","+SELECT $tag$a ` b$tag$;","+----","+a ` b","+","+# backticks inside comments are ignored","+query I","+SELECT 1 -- `not an identifier","+;","+----","+1","+","+query I","+SELECT /* `also` not */ 2;","+----","+2","+","+# operators still work next to backtick-quoted identifiers","+query I","+SELECT `b col` || `b col` FROM `my table`;","+----","+ONEONE","+","+query I","+SELECT `a col`! FROM `my table`;","+----","+1","+","+query I","+SELECT -`a col` FROM `my table`;","+----","+-1","+","+query I","+SELECT `a col`+`c col`*2 FROM `my table`;","+----","+7","+","+# backtick-quoted identifiers are not keywords","+query I","+SELECT `select` FROM (SELECT 5 AS `select`);","+----","+5","+","+query I","+SELECT `from`.`select` FROM (SELECT 5 AS `select`) `from`;","+----","+5","+","+# quoting is not applied to functions by backtick, same as with double quotes","+query I","+SELECT `upper`('abc');","+----","+ABC","+","+# zero-length and unterminated identifiers are errors","+statement error","+SELECT ``;","+----","+Parser Error: zero-length delimited identifier","+","+statement error","+SELECT `x FROM (SELECT 1 x);","+----","+Parser Error: unterminated quoted identifier","+","+statement error","+SELECT 1 AS `a``;","+----","+Parser Error: unterminated quoted identifier","+","+# mismatched delimiters are not a quoted identifier","+statement error","+SELECT `x\" FROM (SELECT 1 x);","+----","+Parser Error: unterminated quoted identifier","+","+# backtick-quoted identifiers keep their case like double-quoted ones","+statement ok","+SET preserve_identifier_case TO 'lowercase';","+","+statement ok","+CREATE TABLE `MixedCase`(`ColA` INTEGER, ColB INTEGER);","+","+query II","+SELECT table_name, column_name FROM duckdb_columns() WHERE table_name = 'MixedCase' ORDER BY column_name;","+----","+MixedCase\tColA","+MixedCase\tcolb","+","+query II","+SELECT `ColA`, ColB FROM `MixedCase` LIMIT 0;","+----","+","+statement ok","+RESET preserve_identifier_case;","+","+# ToString round-trips: backtick-quoted identifiers are emitted with standard double quotes","+query I","+SELECT sql FROM duckdb_views() WHERE view_name = 'my view';","+----","+CREATE VIEW \"my view\" AS SELECT \"a col\" FROM \"my table\";"],"additions":250,"deletions":0,"truncated":false},{"path":"tools/shell/shell.cpp","lines":["@@ -3013,7 +3013,7 @@ bool ShellState::SQLIsComplete(const char *zSql) {"," \t\t\tnext_state = SQLParseState::WHITESPACE;"," \t\t\tbreak;"," \t\t}","-\t\t\t//\t\tcase '`': /* Grave-accent quoted symbols used by MySQL */","+\t\tcase '`': /* backtick-quoted identifiers */"," \t\tcase '\"': /* single- and double-quoted strings */"," \t\tcase '\\'': {"," \t\t\tint c = *zSql;",""],"additions":1,"deletions":1,"truncated":false}],"additions":284,"deletions":14,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-08T16:20:53.498394+00:00"}