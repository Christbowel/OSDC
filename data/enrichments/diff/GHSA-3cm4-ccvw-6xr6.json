ath(p); got {","+\t\t\tt.Errorf(\"IsForbiddenDataRelPath(%q) = true, want false\", p)","+\t\t}","+\t}","+}","+","+// TestIsForbiddenDataRelPathCaseInsensitive 在大小写不敏感的文件系统上验证大小写变体无法绕过片段匹配。","+func TestIsForbiddenDataRelPathCaseInsensitive(t *testing.T) {","+\tif runtime.GOOS != \"windows\" && runtime.GOOS != \"darwin\" {","+\t\tt.Skip(\"case-insensitive comparison only on windows/darwin\")","+\t}","+","+\tcases := []string{","+\t\tfilepath.Join(\".SIYUAN\", \"PUBLISHACCESS.JSON\"),","+\t\tstrings.ToUpper(filepath.Join(\"templates\", \"A.MD\")),","+\t\tfilepath.Join(\"SNIPPETS\", \"CONF.JSON\"),","+\t}","+\tfor _, p := range cases {","+\t\tif got := IsForbiddenDataRelPath(p); !got {","+\t\t\tt.Errorf(\"IsForbiddenDataRelPath(%q) = false, want true (case variant)\", p)","+\t\t}","+\t}","+}",""],"additions":56,"deletions":0,"truncated":false}],"additions":226,"deletions":10,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-06T14:34:56.005507+00:00"}