y/2026-08-15-120000-sync/snippets/conf.json\", http.StatusForbidden},","+\t\t{\"/history/2026-08-15-120000-sync/assets/image.png\", http.StatusOK},","+\t} {","+\t\trecorder := httptest.NewRecorder()","+\t\tengine.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, test.requestPath, nil))","+\t\tif recorder.Code != test.wantStatus {","+\t\t\tt.Fatalf(\"GET %s returned %d, want %d\", test.requestPath, recorder.Code, test.wantStatus)","+\t\t}","+\t}","+}","+","+// TestRepoDiffRouteBlocksSensitivePaths 验证 /repo/diff 路由按数据相对路径拒绝敏感文件（纵深防御），","+// 且不影响正常资源文件访问。","+func TestRepoDiffRouteBlocksSensitivePaths(t *testing.T) {","+\tgin.SetMode(gin.TestMode)","+\toriginalTempDir, originalConf := util.TempDir, model.Conf","+\tutil.TempDir = t.TempDir()","+\tmodel.Conf = model.NewAppConf()","+\tt.Cleanup(func() {","+\t\tutil.TempDir = originalTempDir","+\t\tmodel.Conf = originalConf","+\t})","+","+\tdiffDir := filepath.Join(util.TempDir, \"repo\", \"diff\")","+\tallowedPath := filepath.Join(diffDir, \"assets\", \"image.png\")","+\tif err := os.MkdirAll(filepath.Dir(allowedPath), 0755); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif err := os.WriteFile(allowedPath, []byte(\"asset\"), 0644); err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\tengine := gin.New()","+\tengine.Use(func(c *gin.Context) {","+\t\tc.Set(model.RoleContextKey, model.RoleAdministrator)","+\t\tc.Next()","+\t})","+\tserveRepoDiff(engine)","+","+\tfor _, test := range []struct {","+\t\trequestPath string","+\t\twantStatus  int","+\t}{","+\t\t{\"/repo/diff/.siyuan/publishAccess.json\", http.StatusForbidden},","+\t\t{\"/repo/diff/templates/private.md\", http.StatusForbidden},","+\t\t{\"/repo/diff/snippets/conf.json\", http.StatusForbidden},","+\t\t{\"/repo/diff/assets/image.png\", http.StatusOK},","+\t} {","+\t\trecorder := httptest.NewRecorder()","+\t\tengine.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, test.requestPath, nil))","+\t\tif recorder.Code != test.wantStatus {","+\t\t\tt.Fatalf(\"GET %s returned %d, want %d\", test.requestPath, recorder.Code, test.wantStatus)","+\t\t}","+\t}","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"kernel/util/path_guard.go","lines":["@@ -17,11 +17,10 @@"," package util"," "," import (","+\t\"path\""," \t\"path/filepath\""," \t\"runtime\""," \t\"strings\"","-","-\t\"github.com/88250/gulu\""," )"," "," // IsForbiddenAbsPath 判断绝对路径是否为敏感路径，HTTP 文件 API（kernel/api/file.go 的 refuseToAccess）","@@ -36,21 +35,40 @@ func IsForbiddenAbsPath(abs string) bool {"," \t\treturn true"," \t}"," ","+\t// 数据目录内的敏感位置（snippets/conf.json、templates、.siyuan/publishAccess.json），","+\t// 与历史快照、仓库 diff 路由（IsForbiddenDataRelPath）共用同一判断，避免黑名单分散维护。","+\tdataNorm := NormalizeAndResolve(DataDir)","+\tif rel, relErr := filepath.Rel(dataNorm, fileNorm); nil == relErr &&","+\t\t!strings.HasPrefix(rel, \"..\") && IsForbiddenDataRelPath(rel) {","+\t\treturn true","+\t}","+\treturn false","+}","+","+// IsForbiddenDataRelPath 判断数据目录下的相对路径是否指向敏感位置（data/snippets/conf.json、","+// data/templates 目录以及 data/.siyuan/publishAccess.json）。历史快照与仓库 diff 检出中的文件副本","+// 位于其他绝对路径下，无法用 IsForbiddenAbsPath 的精确匹配拦截，因此 /history 与 /repo/diff 路由","+// （kernel/server/serve.go）在去掉快照目录前缀后按数据相对路径调用本函数进行片段匹配。","+func IsForbiddenDataRelPath(rel string) bool {","+\t// 统一为斜杠并清理（path.Clean 使用斜杠语义，避免 Windows 上分隔符差异）","+\trel = path.Clean(\"/\" + filepath.ToSlash(rel))","+\t// 在 Windows 和 macOS 上文件系统通常为不区分大小写，使用小写统一比较","+\tif runtime.GOOS == \"windows\" || runtime.GOOS == \"darwin\" {","+\t\trel = strings.ToLower(rel)","+\t}","+"," \t// 禁止访问 data/snippets/conf.json","-\tsnippetPath := NormalizeAndResolve(filepath.Join(DataDir, \"snippets\", \"conf.json\"))","-\tif fileNorm == snippetPath {","+\tif rel == \"/snippets/conf.json\" {"," \t\treturn true"," \t}"," "," \t// 禁止访问 data/templates 目录（含目录本身及其全部子路径）","-\ttemplatesBase := NormalizeAndResolve(filepath.Join(DataDir, \"templates\"))","-\tif fileNorm == templatesBase || gulu.File.IsSubPath(templatesBase, fileNorm) {","+\tif rel == \