{"id":"f42421354d471d346e37c5da7af242cce13625ca","axis":"silent","repo":"vllm-project/vllm","sha":"f42421354d471d346e37c5da7af242cce13625ca","parsed":{"files":[{"path":"docs/models/supported_models.md","lines":["@@ -538,6 +538,7 @@ These models primarily accept the [`LLM.generate`](./generative_models.md#llmgen"," "," | Architecture | Models | Inputs | Example HF Models | [LoRA](../features/lora.md) | [PP](../serving/parallelism_scaling.md) |"," | ------------ | ------ | ------ | ----------------- | -------------------- | ------------------------- |","+| `Alpamayo2Super` | Alpamayo 2 Super (reasoning model) | T + I<sup>E+</sup> | `nvidia/Alpamayo2-Super` | | ✅︎ |"," | `AriaForConditionalGeneration` | Aria | T + I<sup>+</sup> | `rhymes-ai/Aria` | | |"," | `AudioFlamingo3ForConditionalGeneration` | AudioFlamingo3 | T + A | `nvidia/audio-flamingo-3-hf`, `nvidia/music-flamingo-hf` | ✅︎ | ✅︎ |"," | `BagelForConditionalGeneration` | BAGEL | T + I<sup>+</sup> | `ByteDance-Seed/BAGEL-7B-MoT` | ✅︎ | ✅︎ |","@@ -656,6 +657,16 @@ Some models are supported only via the [Transformers modeling backend](#transfor"," <sup>*</sup> Only specific variants of the model support this modality (see notes below).</br>"," <sup>Q</sup> `Qwen*-VL` officially uses `qwen_vl_utils` for image preprocessing, while vLLM uses `transformers`' `video_processing_qwen*`, which leads to slightly different results compared to the official Hugging Face repository examples."," ","+!!! note","+    `Alpamayo2Super` serves the reasoning model of `nvidia/Alpamayo2-Super`: visual","+    question answering, grounding, chain-of-causation reasoning with meta-actions, and","+    auto-labeling. The trajectory expert is not loaded, so trajectories are not produced.","+    Prompts follow the reference implementation","+    ([NVlabs/alpamayo2](https://github.com/NVlabs/alpamayo2)). Its trajectory and special","+    tokens (`<i0>`, `<|traj_history_start|>`, ...) can be written in the prompt text, since","+    vLLM selects the `alpamayo2_super` tokenizer mode, which adds them. To stop after the","+    meta-actions, pass the id of `<|traj_future_start|>` in `stop_token_ids`.","+"," !!! note","     For `Dots3NoteForCausalLM`, the vision and audio towers are only loaded when the","     corresponding modality is enabled via `--limit-mm-per-prompt`. Video inputs are"],"additions":11,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_alpamayo2_super.py","lines":["@@ -0,0 +1,81 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+import pytest","+from PIL import Image","+","+from vllm.exceptions import VLLMValidationError","+from vllm.model_executor.models.alpamayo2_super import (","+    Alpamayo2SuperForConditionalGeneration,","+)","+from vllm.multimodal import MULTIMODAL_REGISTRY","+","+from ...utils import build_model_context","+","+MODEL_ID = \"nvidia/Alpamayo2-Super\"","+IMAGE_PLACEHOLDER = \"<|vision_start|><|image_pad|><|vision_end|>\"","+","+","+@pytest.fixture(scope=\"module\")","+def processor():","+    ctx = build_model_context(MODEL_ID, limit_mm_per_prompt={\"image\": 2})","+    return MULTIMODAL_REGISTRY.create_processor(ctx.model_config)","+","+","+def test_tokenizer_adds_trajectory_and_special_tokens(processor) -> None:","+    tokenizer = processor.info.get_tokenizer()","+    config = processor.info.get_hf_config()","+    traj_ids = config.traj_ids","+","+    assert tokenizer.convert_tokens_to_ids(\"<i0>\") == traj_ids[\"history_id0\"]","+    future_id0 = f\"<i{config.history_vocab_size}>\"","+    assert tokenizer.convert_tokens_to_ids(future_id0) == traj_ids[\"future_id0\"]","+    # Trajectory tokens written in a prompt tokenize to single ids.","+    ids = tokenizer.encode(","+        \"<|traj_history_start|><i12><i999><|traj_history_end|>\",","+        add_special_tokens=False,","+    )","+    assert ids == [","+        traj_ids[\"history_start\"],","+        traj_ids[\"history_id0\"] + 12,","+        traj_ids[\"history_id0\"] + 999,","+        traj_ids[\"history_end\"],","+    ]","+    assert tokenizer.decode([traj_ids[\"future_start\"]]) == \"<|traj_future_start|>\"","+","+","+def test_images_use_the_config_pixel_budget(processor) -> None:","+    # A 1920x1080 camera frame is resized to 576x320 (163,840 to 196,608","+    # pixels), i.e. 20x36 patches and 180 image tokens.","+    processed = processor(","+        IMAGE_PLACEHOLDER,","+        mm_items=processor.info.parse_mm_data(","+            {\"image\": [Image.new(\"RGB\", (1920, 1080))]}","+        ),","+        hf_processor_mm_kwargs={},","+    )","+    grid_thw = processed[\"mm_kwargs\"].get_data()[\"image_grid_thw\"]","+    assert grid_thw.tolist() == [[1, 20, 36]]","+    assert processed[\"mm_placeholders\"][\"image\"][0].length == 180","+","+","+def test_video_input_is_rejected(processor) -> None:","+    assert set(processor.info.supported_mm_limits) == {\"image\"}","+    with pytest.raises(VLLMValidationError, match=\"At most 0 video\"):","+        processor.info.validate_num_items(\"video\", 1)","+","+","+def test_weights_mapper_unwraps_vlm_and_drops_expert() -> None:","+    mapper = Alpamayo2SuperForConditionalGeneration.hf_to_vllm_mapper","+    names = [","+        \"vlm.model.language_model.layers.0.mlp.up_proj.weight\",","+        \"vlm.model.visual.blocks.0.attn.qkv.weight\",","+        \"vlm.lm_head.weight\",","+        \"expert.expert.layers.0.mlp.up_proj.weight\",","+        \"expert.action_out_proj.weight\",","+    ]","+    assert mapper.apply_list(names) == [","+        \"language_model.model.layers.0.mlp.up_proj.weight\",","+        \"visual.blocks.0.attn.qkv.weight\",","+        \"language_model.lm_head.weight\",","+    ]"],"additions":81,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -805,6 +805,7 @@ def check_available_online("," "," _MULTIMODAL_EXAMPLE_MODELS = {","     # [Decoder-only]","+    \"Alpamayo2Super\": _HfExamplesInfo(\"nvidia/Alpamayo2-Super\", max_model_len=8192),","     \"AriaForConditionalGeneration\": _HfExamplesInfo(\"rhymes-ai/Aria\"),","     \"AudioFlamingo3ForConditionalGeneration\": _HfExamplesInfo(","         \"nvidia/audio-flamingo-3-hf\""],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/config/model.py","lines":["@@ -89,6 +89,7 @@"," TokenizerMode = Literal[","     \"auto\",","     \"hf\",","+    \"alpamayo2_super\",","     \"mistral\",","     \"deepseek_v32\",","     \"deepseek_v4\",","@@ -175,6 +176,9 @@ class ModelConfig:","     - \"auto\" will use the tokenizer from `mistral_common` for Mistral models","       if available, otherwise it will use the \"hf\" tokenizer.","     - \"hf\" will use the fast tokenizer if available.","+    - \"alpamayo2_super\" uses the \"hf\" tokenizer with Alpamayo 2 Super's","+      trajectory and special tokens added; selected automatically for","+      `nvidia/Alpamayo2-Super`.","     - \"mistral\" will always use the tokenizer from `mistral_common`.","     - \"deepseek_v32\" will always use the tokenizer from `deepseek_v32`.","     - \"deepseek_v4\" will always use the tokenizer from `deepseek_v4`.","@@ -743,6 +747,8 @@ def __post_init__(","         if self.tokenizer_mode == \"auto\":","             if self.model_impl == \"terratorch\":","                 self.tokenizer_mode = \"terratorch\"","+            elif arch == \"Alpamayo2Super\":","+                self.tokenizer_mode = \"alpamayo2_super\"","             elif arch == \"MoonshotKimiaForCausalLM\":","                 self.tokenizer_mode = \"kimi_audio\"","             elif arch == \"KimiK3ForConditionalGeneration\":"],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/alpamayo2_super.py","lines":["@@ -0,0 +1,98 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Alpamayo 2 Super: the Qwen3-VL reasoning model of NVIDIA's driving policy.","+","+The checkpoint stores a Qwen3-VL model under ``vlm.`` and a flow-matching","+trajectory expert under ``expert.``. vLLM serves the Qwen3-VL part, which","+produces every text output of the model: visual question answering,","+grounding, chain-of-causation reasoning with meta-actions, and auto-labeling.","+The trajectory itself needs the expert and is not produced here.","+\"\"\"","+","+from collections.abc import Mapping","+","+import torch","+","+from vllm.config import VllmConfig","+from vllm.model_executor.models.qwen3_vl import (","+    Qwen3VLDummyInputsBuilder,","+    Qwen3VLForConditionalGeneration,","+    Qwen3VLMultiModalProcessor,","+    Qwen3VLProcessingInfo,","+    Qwen3VLProcessor,","+)","+from vllm.model_executor.models.utils import WeightsMapper","+from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.processing import BaseProcessingInfo","+from vllm.transformers_utils.configs.alpamayo2_super import Alpamayo2SuperConfig","+","+","+class Alpamayo2SuperProcessingInfo(Qwen3VLProcessingInfo):","+    def get_hf_config(self) -> Alpamayo2SuperConfig:","+        return self.ctx.get_hf_config(Alpamayo2SuperConfig)","+","+    # Image-only: the reference implementation passes camera frames as images","+    # and never uses video input.","+    def get_supported_mm_limits(self) -> Mapping[str, int | None]:","+        return {\"image\": None}","+","+    def get_mm_max_tokens_per_item(","+        self,","+        seq_len: int,","+        mm_counts: Mapping[str, int],","+    ) -> Mapping[str, int]:","+        return {\"image\": self.get_max_image_tokens()}","+","+    def get_supported_mm_processor_kwargs(self) -> dict[str, set[str]]:","+        # Skip Qwen3-VL's override, which adds video-only kwargs.","+        return BaseProcessingInfo.get_supported_mm_processor_kwargs(self)","+","+    def get_hf_processor(self, **kwargs: object) -> Qwen3VLProcessor:","+        processor = super().get_hf_processor(**kwargs)","+        # The per-image pixel budget from the model config, which the reference","+        # implementation applies for every task; the checkpoint's preprocessor","+        # config does not carry it.","+        config = self.get_hf_config()","+        if config.min_pixels is not None and config.max_pixels is not None:","+            processor.image_processor.size = {","+                \"shortest_edge\": config.min_pixels,","+                \"longest_edge\": config.max_pixels,","+            }","+        return processor","+","+","+@MULTIMODAL_REGISTRY.register_processor(","+    Qwen3VLMultiModalProcessor,","+    info=Alpamayo2SuperProcessingInfo,","+    dummy_inputs=Qwen3VLDummyInputsBuilder,","+)","+class Alpamayo2SuperForConditionalGeneration(Qwen3VLForConditionalGeneration):","+    hf_to_vllm_mapper = WeightsMapper(","+        orig_to_new_prefix={","+            \"vlm.model.visual.\": \"visual.\",","+            \"vlm.lm_head.\": \"language_model.lm_head.\",","+            \"vlm.model.language_model.\": \"language_model.model.\",","+            # The trajectory expert is not served by vLLM.","+            \"expert.\": None,","+        }","+    )","+","+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\") -> None:","+        super().__init__(vllm_config=vllm_config, prefix=prefix)","+        config = vllm_config.model_config.hf_config","+        # Discrete trajectory tokens (<i0>, <i1>, ...) only ever appear in","+        # prompts; like the reference implementation, never sample them.","+        traj_ids = config.traj_ids","+        self.traj_vocab_start = (","+            min(traj_ids[\"history_id0\"], traj_ids[\"future_id0\"])","+            if \"history_id0\" in traj_ids and \"future_id0\" in traj_ids","+            else None","+        )","+        self.traj_vocab_size = config.traj_vocab_size","+","+    def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor | None:","+        logits = super().compute_logits(hidden_states)","+        if logits is not None and self.traj_vocab_start is not None:","+            end = self.traj_vocab_start + self.traj_vocab_size","+            logits[..., self.traj_vocab_start : end] = float(\"-inf\")","+        return logits"],"additions":98,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/registry.py","lines":["@@ -347,6 +347,7 @@"," "," _MULTIMODAL_MODELS = {","     # [Decoder-only]","+    \"Alpamayo2Super\": (\"alpamayo2_super\", \"Alpamayo2SuperForConditionalGeneration\"),","     \"AriaForConditionalGeneration\": (\"aria\", \"AriaForConditionalGeneration\"),","     \"AudioFlamingo3ForConditionalGeneration\": (","         \"audioflamingo3\","],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/renderers/registry.py","lines":["@@ -20,6 +20,7 @@"," "," "," _VLLM_RENDERERS = {","+    \"alpamayo2_super\": (\"hf\", \"HfRenderer\"),","     \"cohere\": (\"cohere\", \"CohereRenderer\"),","     \"deepseek_v32\": (\"deepseek_v32\", \"DeepseekV32Renderer\"),","     \"deepseek_v4\": (\"deepseek_v4\", \"DeepseekV4Renderer\"),"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/tokenizers/alpamayo2_super.py","lines":["@@ -0,0 +1,109 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Tokenizer for Alpamayo 2 Super.","+","+The checkpoint ships the base Qwen3-VL tokenizer. The reference implementation","+(NVlabs/alpamayo2, ``build_alpamayo2_super_tokenizer``) appends the discrete","+trajectory tokens and the model's special tokens in code; the model's","+embeddings and ``traj_ids`` assume those ids. Append them the same way, so","+prompts with ego-trajectory tokens tokenize as in training and generated","+special tokens such as ``<|traj_future_start|>`` detokenize.","+\"\"\"","+","+from pathlib import Path","+","+from transformers import AutoTokenizer","+","+from vllm.tokenizers.hf import HfTokenizer, get_cached_tokenizer","+from vllm.tokenizers.protocol import TokenizerLike","+from vllm.transformers_utils.configs.alpamayo2_super import Alpamayo2SuperConfig","+","+# The order defines the token ids that follow the trajectory tokens.","+SPECIAL_TOKENS = tuple(","+    f\"<|{name}|>\"","+    for name in (","+        \"prompt_start\",","+        \"prompt_end\",","+        \"image_start\",","+        \"image_pre_tkn\",","+        \"image_end\",","+        \"traj_history_start\",","+        \"traj_history_pre_tkn\",","+        \"traj_history_end\",","+        \"cot_start\",","+        \"cot_end\",","+        \"meta_action_start\",","+        \"meta_action_end\",","+        \"traj_future_start\",","+        \"traj_future_pre_tkn\",","+        \"traj_future_end\",","+        \"traj_history\",","+        \"traj_future\",","+        \"image_pad\",  # already in the Qwen3-VL vocabulary; keeps its id","+        \"vectorized_wm\",","+        \"vectorized_wm_start\",","+        \"vectorized_wm_end\",","+        \"vectorized_wm_pre_tkn\",","+        \"route_start\",","+        \"route_pad\",","+        \"route_end\",","+        \"question_start\",","+        \"question_end\",","+        \"answer_start\",","+        \"answer_end\",","+    )","+)","+","+# config.traj_ids key -> the token it must resolve to","+_TRAJ_ID_TOKENS = {","+    \"history_start\": \"<|traj_history_start|>\",","+    \"history_end\": \"<|traj_history_end|>\",","+    \"history_pad\": \"<|traj_history|>\",","+    \"future_start\": \"<|traj_future_start|>\",","+    \"future_end\": \"<|traj_future_end|>\",","+    \"future_pad\": \"<|traj_future|>\",","+}","+","+","+class Alpamayo2SuperTokenizer(TokenizerLike):","+    @classmethod","+    def from_pretrained(","+        cls,","+        path_or_repo_id: str | Path,","+        *args,","+        trust_remote_code: bool = False,","+        revision: str | None = None,","+        download_dir: str | None = None,","+        **kwargs,","+    ) -> HfTokenizer:","+        tokenizer = AutoTokenizer.from_pretrained(","+            path_or_repo_id,","+            *args,","+            trust_remote_code=trust_remote_code,","+            revision=revision,","+            cache_dir=download_dir,","+            **kwargs,","+        )","+        config = Alpamayo2SuperConfig.from_pretrained(","+            path_or_repo_id, revision=revision or \"main\", cache_dir=download_dir","+        )","+        # Tokens that are already present (e.g. in a pre-extended tokenizer)","+        # keep their ids.","+        tokenizer.add_tokens([f\"<i{i}>\" for i in range(config.traj_vocab_size)])","+        tokenizer.add_tokens(list(SPECIAL_TOKENS), special_tokens=True)","+","+        expected = {","+            \"history_id0\": \"<i0>\",","+            \"future_id0\": f\"<i{config.history_vocab_size}>\",","+            **_TRAJ_ID_TOKENS,","+        }","+        for key, token in expected.items():","+            if key in config.traj_ids:","+                token_id = tokenizer.convert_tokens_to_ids(token)","+                if token_id != config.traj_ids[key]:","+                    raise ValueError(","+                        f\"Alpamayo 2 Super tokenizer maps {token} to {token_id}, \"","+                        f\"but the config expects {config.traj_ids[key]} \"","+                        f\"(traj_ids[{key!r}]).\"","+                    )","+        return get_cached_tokenizer(tokenizer)"],"additions":109,"deletions":0,"truncated":false},{"path":"vllm/tokenizers/registry.py","lines":["@@ -44,6 +44,7 @@"," }"," "," _VLLM_TOKENIZERS = {","+    \"alpamayo2_super\": (\"alpamayo2_super\", \"Alpamayo2SuperTokenizer\"),","     # ``cohere`` mode uses the standard cached HF tokenizer; only the","     # renderer (template stage) is replaced with a melody-based one.","     \"cohere\": (\"hf\", \"CachedHfTokenizer\"),"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/transformers_utils/config.py","lines":["@@ -120,6 +120,7 @@ def __getitem__(self, key):"," "," "," _CONFIG_REGISTRY: dict[str, type[PreTrainedConfig]] = LazyConfigDict(","+    alpamayo2_super=\"Alpamayo2SuperConfig\",","     bagel=\"BagelConfig\",","     bailing_moe_v3_vl=\"BailingMoeV3VLConfig\",","     beam=\"BeamConfig\","],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/transformers_utils/configs/__init__.py","lines":["@@ -14,6 +14,7 @@"," import importlib"," "," _CLASS_TO_MODULE: dict[str, str] = {","+    \"Alpamayo2SuperConfig\": \"vllm.transformers_utils.configs.alpamayo2_super\",","     \"BagelConfig\": \"vllm.transformers_utils.configs.bagel\",","     \"BailingMoeV3TextConfig\": \"vllm.transformers_utils.configs.bailing_moe_v3_vl\",","     \"BailingMoeV3VisionConfig\": \"vllm.transformers_utils.configs.bailing_moe_v3_vl\",","@@ -85,6 +86,7 @@"," }"," "," __all__ = [","+    \"Alpamayo2SuperConfig\",","     \"BagelConfig\",","     \"BailingMoeV3TextConfig\",","     \"BailingMoeV3VisionConfig\","],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/transformers_utils/configs/alpamayo2_super.py","lines":["@@ -0,0 +1,62 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Alpamayo 2 Super configuration support.","+","+The released checkpoint (``model_type: alpamayo2_super``) wraps a Qwen3-VL","+model in ``vlm_config`` and stores a trajectory expert beside it. This shim","+exposes the Qwen3-VL fields at the top level, so vLLM's Qwen3-VL code can size","+the model, and keeps the wrapper's fields for the trajectory tokens.","+\"\"\"","+","+from collections.abc import Mapping","+from typing import Any","+","+from transformers import Qwen3VLConfig","+","+","+class Alpamayo2SuperConfig(Qwen3VLConfig):","+    model_type = \"alpamayo2_super\"","+","+    def __init__(","+        self,","+        *,","+        vlm_config: Mapping[str, Any] | None = None,","+        expert_config: Mapping[str, Any] | None = None,","+        traj_ids: Mapping[str, int] | None = None,","+        history_vocab_size: int = 1000,","+        future_vocab_size: int = 3000,","+        tokens_per_history_traj: int = 45,","+        include_camera_ids: bool = True,","+        frame_label: str = \"frame_num\",","+        min_pixels: int | None = 163840,","+        max_pixels: int | None = 196608,","+        **kwargs: Any,","+    ) -> None:","+        nested = dict(vlm_config or {})","+        text_config = nested.pop(\"text_config\", kwargs.pop(\"text_config\", None))","+        vision_config = nested.pop(\"vision_config\", kwargs.pop(\"vision_config\", None))","+        for key in (","+            \"image_token_id\",","+            \"video_token_id\",","+            \"vision_start_token_id\",","+            \"vision_end_token_id\",","+        ):","+            if key in nested:","+                kwargs.setdefault(key, nested[key])","+        super().__init__(","+            text_config=text_config,","+            vision_config=vision_config,","+            **kwargs,","+        )","+        self.vlm_config = dict(vlm_config or {})","+        self.expert_config = dict(expert_config or {})","+        self.traj_ids = dict(traj_ids or {})","+        self.history_vocab_size = history_vocab_size","+        self.future_vocab_size = future_vocab_size","+        # <i0>..<i{traj_vocab_size - 1}>: history bins, then future bins","+        self.traj_vocab_size = history_vocab_size + future_vocab_size","+        self.tokens_per_history_traj = tokens_per_history_traj","+        self.include_camera_ids = include_camera_ids","+        self.frame_label = frame_label","+        self.min_pixels = min_pixels","+        self.max_pixels = max_pixels",""],"additions":62,"deletions":0,"truncated":false}],"additions":374,"deletions":0,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-23T14:15:07.993117+00:00"}