{"id":"5c4b8142bd439b1c2d858867a3a826da97c5399d","axis":"silent","repo":"facebook/zstd","sha":"5c4b8142bd439b1c2d858867a3a826da97c5399d","parsed":{"files":[{"path":"programs/fileio.c","lines":["@@ -836,8 +836,29 @@ static FILE* FIO_openSrcFile(const FIO_prefs_t* const prefs, const char* srcFile","     }"," ","     {   FILE* const f = fopen(srcFileName, \"rb\");","-        if (f == NULL)","+        if (f == NULL) {","             DISPLAYLEVEL(1, \"zstd: %s: %s \\n\", srcFileName, strerror(errno));","+            return NULL;","+        }","+        {   stat_t openedStat;","+            int const fd = fileno(f);","+            if (fd < 0 || !UTIL_fstat(fd, srcFileName, &openedStat)) {","+                DISPLAYLEVEL(1, \"zstd: can't stat open file %s : %s -- ignored \\n\",","+                                srcFileName, strerror(errno));","+                fclose(f);","+                return NULL;","+            }","+            /* The pathname may have been replaced since UTIL_stat(). Never read","+             * a different file or copy the old file's permissions to its output. */","+            if (!UTIL_isSameFileStat(srcFileName, srcFileName, statbuf, &openedStat)) {","+                DISPLAYLEVEL(1, \"zstd: %s changed while opening -- ignored\\n\", srcFileName);","+                fclose(f);","+                return NULL;","+            }","+            /* Use the opened file's metadata even when its identity is unchanged.","+             * In particular, its permissions may have changed before fopen(). */","+            *statbuf = openedStat;","+        }","         return f;","     }"," }"],"additions":22,"deletions":1,"truncated":false},{"path":"tests/cli-tests/common/source-identity.c","lines":["@@ -0,0 +1,53 @@","+/*","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ * All rights reserved.","+ *","+ * This source code is licensed under both the BSD-style license (found in the","+ * LICENSE file in the root directory of this source tree) and the GPLv2 (found","+ * in the COPYING file in the root directory of this source tree).","+ * You may select, at your option, one of the above-listed licenses.","+ */","+","+/* Change one source immediately before zstd's real fopen(). */","+#define _GNU_SOURCE","+#include <dlfcn.h>","+#include <stdio.h>","+#include <stdlib.h>","+#include <string.h>","+#include <sys/stat.h>","+#include <unistd.h>","+","+typedef FILE* (*fopen_fn)(const char*, const char*);","+","+static FILE* openSource(const char* symbol, const char* path, const char* mode)","+{","+    static int changed = 0;","+    fopen_fn const realOpen = (fopen_fn)dlsym(RTLD_NEXT, symbol);","+    const char* const target = getenv(\"ZSTD_TEST_RACE_TARGET\");","+    if (realOpen == NULL) {","+        fputs(\"source-identity: cannot find real fopen\\n\", stderr);","+        _exit(90);","+    }","+    if (!changed && target != NULL && !strcmp(path, target) && !strcmp(mode, \"rb\")) {","+        const char* const replacement = getenv(\"ZSTD_TEST_RACE_REPLACEMENT\");","+        changed = 1;","+        if (replacement != NULL ? rename(replacement, path) != 0 : chmod(path, 0600) != 0) {","+            perror(\"source-identity\");","+            _exit(91);","+        }","+        fprintf(stderr, \"source-identity: changed %s\\n\", path);","+    }","+    return realOpen(path, mode);","+}","+","+FILE* fopen(const char* path, const char* mode)","+{","+    return openSource(\"fopen\", path, mode);","+}","+","+#if !defined(fopen64)","+FILE* fopen64(const char* path, const char* mode)","+{","+    return openSource(\"fopen64\", path, mode);","+}","+#endif"],"additions":53,"deletions":0,"truncated":false},{"path":"tests/cli-tests/file-handling/source-identity.sh","lines":["@@ -0,0 +1,54 @@","+#!/bin/sh","+","+set -e","+","+# The interposer requires a native 64-bit Linux binary.","+[ -z \"${EXEC_PREFIX:-}\" ] || exit 0","+[ \"$(uname -s)\" = Linux ] || exit 0","+[ \"$(getconf LONG_BIT)\" = 64 ] || exit 0","+zstd --version | grep -Fq '(64-bit)' || exit 0","+","+${CC:-cc} -Wall -Wextra -Werror -shared -fPIC \\","+    \"$COMMON/source-identity.c\" -ldl -o source-identity.so","+","+printf 'protected sentinel\\n' > protected","+chmod 600 protected","+","+checkReplacement() {","+    name=$1","+    printf 'ordinary input\\n' > \"$name\"","+    chmod 644 \"$name\"","+","+    status=0","+    LD_PRELOAD=\"$PWD/source-identity.so\" \\","+        ZSTD_TEST_RACE_TARGET=\"$name\" \\","+        ZSTD_TEST_RACE_REPLACEMENT=\"$name.replacement\" \\","+        zstd -q \"$name\" -o \"$name.zst\" 2> \"$name.stderr\" || status=$?","+","+    grep -Fxq \"source-identity: changed $name\" \"$name.stderr\"","+    if [ \"$status\" -eq 0 ]; then","+        zstd -dq \"$name.zst\" -o \"$name.decoded\"","+        cmp protected \"$name.decoded\"","+        die \"source replacement was accepted and protected data was compressed\"","+    fi","+    [ \"$status\" -eq 1 ] || die \"unexpected source-race exit status: $status\"","+    grep -Fxq \"zstd: $name changed while opening -- ignored\" \"$name.stderr\"","+    [ ! -e \"$name.zst\" ] || die \"rejected source created an output file\"","+}","+","+# Exercise both a replacement symlink and a different regular-file inode.","+ln -s \"$PWD/protected\" symlink-input.replacement","+checkReplacement symlink-input","+cp protected regular-input.replacement","+checkReplacement regular-input","+","+# Changing mode does not change identity, but the output must use the new mode.","+printf 'same inode\\n' > metadata-input","+chmod 644 metadata-input","+LD_PRELOAD=\"$PWD/source-identity.so\" \\","+    ZSTD_TEST_RACE_TARGET=metadata-input \\","+    zstd -q metadata-input -o metadata-input.zst 2> metadata-input.stderr","+grep -Fxq 'source-identity: changed metadata-input' metadata-input.stderr","+[ \"$(stat -c %a metadata-input)\" = 600 ]","+[ \"$(stat -c %a metadata-input.zst)\" = 600 ]","+zstd -dcq metadata-input.zst | cmp metadata-input -"],"additions":54,"deletions":0,"truncated":false},{"path":