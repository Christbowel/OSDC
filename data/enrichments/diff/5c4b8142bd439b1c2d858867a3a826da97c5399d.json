 1"," Trace:FileStat: > UTIL_isSameFile(file.zst, file)"," Trace:FileStat:  > UTIL_stat(-1, file.zst)"," Trace:FileStat:  < 1"],"additions":4,"deletions":0,"truncated":false},{"path":"tests/cli-tests/file-stat/decompress-file-to-stdout.sh.stderr.exact","lines":["@@ -12,6 +12,10 @@ Trace:FileStat:  < 0"," Trace:FileStat: < 0"," Trace:FileStat: > UTIL_stat(-1, file.zst)"," Trace:FileStat: < 1","+Trace:FileStat: > UTIL_stat(3, file.zst)","+Trace:FileStat: < 1","+Trace:FileStat: > UTIL_isSameFileStat(file.zst, file.zst)","+Trace:FileStat: < 1"," Trace:FileStat: > UTIL_isRegularFile(/*stdout*\\)"," Trace:FileStat:  > UTIL_stat(-1, /*stdout*\\)"," Trace:FileStat:  < 0",""],"additions":4,"deletions":0,"truncated":false}],"additions":149,"deletions":1,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-17T18:47:01.838761+00:00"}