   return typeOf(value) === 'object' ? value : {};","+    default:","+      return value;","+  }","+};","+","+/**","+ * Form for an auth method item (user, group, role, certificate) whose fields come from the mount's","+ * OpenAPI help at runtime. The path identifier is sent in the URL, not the body, and is read-only on edit.","+ */","+export default class GeneratedItemForm extends Form<GeneratedItemData> {","+  declare formFields: FormField[];","+  declare formFieldGroups: FormFieldGroup[];","+  declare identifierField: string | undefined;","+  declare initialData: GeneratedItemData;","+","+  constructor(metadata: FormMetadata, data: GeneratedItemData = {}, options: { isNew?: boolean } = {}) {","+    const { formFields, formFieldGroups } = withTooltipDescriptions(metadata);","+    const defaults: GeneratedItemData = {};","+    formFields.forEach(({ name, options }) => {","+      if (options.defaultValue !== undefined && data[name] === undefined) {","+        defaults[name] = options.defaultValue;","+      }","+    });","+    super({ ...defaults, ...data }, options);","+    this.formFields = formFields;","+    this.formFieldGroups = formFieldGroups;","+    this.identifierField = metadata.identifier;","+    this.initialData = { ...this.data };","+  }","+","+  get id() {","+    return this.identifierField ? (this.data[this.identifierField] as string) : undefined;","+  }","+","+  // Field groups for read-only views, which show the identifier as the page title instead of a row.","+  get fieldGroups() {","+    return this.formFieldGroups.map((group) =>","+      Object.fromEntries(","+        Object.entries(group).map(([name, fields]) => [","+          name,","+          fields.filter((field) => field.name !== this.identifierField),","+        ])","+      )","+    );","+  }","+","+  // Omits the identifier and any blank value the user did not change, as the Ember Data serializer did.","+  toJSON() {","+    const payload: GeneratedItemData = {};","+    this.formFields.forE