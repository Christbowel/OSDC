,"+","+const cssRuntimePublicPath: RspackOptions = {","+  module: {","+    parser: {","+      css: { exportType: 'style' },","+      'css/auto': { exportType: 'style' },","+      'css/global': { exportType: 'style' },","+      'css/module': { exportType: 'style' },","+    },","+    generator: {","+      css: { runtimePublicPath: true },","+      'css/auto': { runtimePublicPath: true },","+      'css/global': { runtimePublicPath: false },","+      'css/module': { runtimePublicPath: true },","+    },","+  },","+};","+defineConfig(cssRuntimePublicPath);","+","+const cssParserOptions: CssParserOptions = {","+  // @ts-expect-error runtimePublicPath is a generator option","+  runtimePublicPath: true,","+};","+defineConfig({ module: { parser: { css: cssParserOptions } } });"],"additions":29,"deletions":1,"truncated":false},{"path":"website/docs/en/config/module-generator.mdx","lines":["@@ -2,6 +2,7 @@"," description: 'Configure module.generator to control asset filenames and URLs, CSS Modules exports, and JSON output generation.'"," ---"," ","+import { ApiMeta, Stability } from '@components/ApiMeta';"," import Attribution from '@components/Attribution';"," "," # Module generator","@@ -601,6 +602,59 @@ export default {"," };"," ```"," ","+### [\"css/auto\"].runtimePublicPath","+","+<ApiMeta stability={Stability.Experimental} addedVersion=\"2.3.2\" />","+","+- **Type:** `boolean`","+- **Default:** `false`","+","+Resolve asset URLs in injected styles against the runtime public path. Only applies when [`parser.exportType`](/config/module-parser#cssautoexporttype) is `'style'`.","+","+By default, Rspack writes each asset URL into the injected CSS at build time, using `output.publicPath`. With `output.publicPath: 'auto'` the URL stays relative, so the browser resolves it against the page URL instead of the script URL.","+","+When enabled, Rspack prefixes each emitted asset URL with the runtime public path when the style is injected. This is the same value JavaScript chunks load from, so it follows `output.publicPath: 'auto'` and any value assigned to [`import.meta.rspackPublicPath`](/api/runtime-api/module-variables#importmetarspackpublicpath).","+","+```css","+/* style.css */","+.logo {","+  background: url('./logo.svg');","+}","+","+/* Injected with runtimePublicPath: false and output.publicPath: 'auto' */","+.logo {","+  background: url('assets/logo.svg');","+}","+","+/* Injected with runtimePublicPath: true and import.meta.rspackPublicPath = 'https://cdn.example.com/' */","+.logo {","+  background: url('https://cdn.example.com/assets/logo.svg');","+}","+```","+","+To set `import.meta.rspackPublicPath` at runtime, assign it in its own module and import that module before any styles. Static imports run before the code in the importing module, so an assignment next to the style import runs too late.","+","+Assets with their own [`generator.publicPath`](#assetpublicpath) keep that value. Inline data URLs and external URLs are unchanged.","+","+```js title=\"rspack.config.mjs\"","+export default {","+  module: {","+    rules: [","+      {","+        test: /\\.css$/,","+        type: 'css/auto',","+        parser: {","+          exportType: 'style',","+        },","+        generator: {","+          runtimePublicPath: true,","+        },","+      },","+    ],","+  },","+};","+```","+"," ### [\"css/auto\"].localIdentName"," "," - **Type:** `string`","@@ -788,6 +842,10 @@ export default {"],"additions":54,"deletions":0,"truncated":false}],"additions":344,"deletions":15,"truncated":true,"file_count":30},"error":null,"fetched_at":"2026-11-05T16:27:14.424453+00:00"}