y>","+#include <atomic>"," #include <cctype>","+#include <cstdlib>","+#include <cstring>","+#include <iostream>","+#include <optional>","+#include <sstream>","+#include <typeinfo>","+#include <unordered_set>"," #include <utility>"," ","+#include \"infer_request_utils.hpp\""," #include \"intel_npu/config/npuw.hpp\""," #include \"logging.hpp\""," #include \"npuw_transformations/collapse_unqdq.hpp\""," #include \"npuw_transformations/conv_to_matmul.hpp\""," #include \"npuw_transformations/drop_zp_subtract.hpp\"","+#include \"npuw_transformations/reshape_to_static_gqa.hpp\""," #include \"npuw_transformations/untangle_dq_scale.hpp\"","+#include \"openvino/core/descriptor/tensor.hpp\"","+#include \"openvino/core/node_vector.hpp\""," #include \"openvino/core/version.hpp\"","+#include \"openvino/op/constant.hpp\"","+#include \"openvino/op/group_query_attention.hpp\"","+#include \"openvino/op/parameter.hpp\"","+#include \"openvino/op/result.hpp\"","+#include \"openvino/op/util/op_types.hpp\"","+#include \"openvino/runtime/make_tensor.hpp\""," #include \"openvino/runtime/properties.hpp\""," #include \"serialization.hpp\"","+#include \"util.hpp\""," "," namespace {"," ","+// Reads an NPUW option from a raw properties AnyMap, falling back to its default.","+template <typename T>","+auto cfg_get(const ov::AnyMap& properties) -> typename T::ValueType {","+    const auto& opt_name = std::string(T::key());","+    if (properties.count(opt_name)) {","+        return properties.at(opt_name).as<typename T::ValueType>();","+    }","+    return T::defaultValue();","+}","+","+// Enables \"[GQA-TRACE]\" diagnostic logging via OPENVINO_NPUW_GQA_LOG=1 (developer builds only).","+bool gqa_trace_enabled() {","+#ifdef NPU_PLUGIN_DEVELOPER_BUILD","+    static const bool enabled = [] {","+        const char* value = std::getenv(\"OPENVINO_NPUW_GQA_LOG\");","+        return value != nullptr && std::string(value) == \"1\";","+    }();","+    return enabled;","+#else","+    return false;","+#endif","+}","+","+// Strictly parses env var `env_name` as a positive integer; throws on malformed values.","+std::optional<size_t> parse_positive_size_env_var(const char* env_name) {","+#ifdef NPU_PLUGIN_DEVELOPER_BUILD","+    const char* raw = std::getenv(env_name);","+    if (raw == nullptr) {","+        return std::nullopt;","+    }","+    const std::string str(raw);","+    auto parsed = ov::npuw::util::parse_positive_int_env_var(str);","+    if (!parsed) {","+        OPENVINO_THROW(env_name, \" must be a positive integer, got: '\", str, \"'\");","+    }","+    return static_cast<size_t>(*parsed);","+#else","+    (void)env_name;","+    return std::nullopt;","+#endif","+}","+","+// OPENVINO_NPUW_GQA_CTX_LEN env override for the static KV-cache reshape target; takes","+// priority over NPUW_LLM_MAX_CONTEXT_LEN.","+std::optional<size_t> gqa_ctx_len_env_override() {","+    static const std::optional<size_t> value = parse_positive_size_env_var(\"OPENVINO_NPUW_GQA_CTX_LEN\");","+    return value;","+}","+","+// OPENVINO_NPUW_GQA_SLIDING_LEN env override: best-effort default sliding-window capacity","+// when a layer has no rt_info/op-attribute signal. Lower priority than NPUW_LLM_SWA_LEN.","+std::optional<size_t> gqa_default_sliding_window_len_env_override() {","+    static const std::optional<size_t> value = parse_positive_size_env_var(\"OPENVINO_NPUW_GQA_SLIDING_LEN\");","+    return value;","+}","+","+// Resolves the sliding-window fallback capacity: NPUW_LLM_SWA_LEN property (if set), else","+// the env override, else nullopt. Never overrides rt_info or the op's own attribute.","+std::optional<size_t> resolve_default_sliding_window_capacity(const ov::AnyMap& properties) {","+    const uint32_t configured = cfg_get<::intel_npu::NPUW_LLM_SWA_LEN>(properties);","+    if (configured != 0) {","+        return static_cast<size_t>(configured);","+    }","+    return gqa_default_sliding_window_len_env_override();","+}","+"," void merge_config_with(ov::AnyMap& lhs, const ov::AnyMap& rhs) {","     for (const auto& [key, value] : rhs) {","         if (auto it = lhs.find(key); it != lhs.end()) {","@@ -36,6 +122,16 @@ enum class GQAModelStage {","     GENERATE,"," };"," ","+// V2 models ship weights as 2-bit group-quantized (u2) Parameters, unlike V0/V1's u4/u8.","+bool has_2bit_group_quantized_weights(const std::shared_ptr<const ov::Model>& model) {","+    for (const auto& parameter : model->get_parameters()) {","+        if (parameter->get_element_type() == ov::element::u2) {","+            return true;","+        }","+    }","+    return false;","+}","+"," std::pair<ov::AnyMap, GQAModelStage> with_gqa_defaults(const std::shared_ptr<ov::Model>& model,","                                                        const ov::AnyMap& properties) {","     const auto detect_gqa_model_stage = [&]() {","@@ -122,12 +218,16 @@ std::pair<ov::AnyMap, GQAModelStage> with_gqa_defaults(const std::shared_ptr<ov:","         return false;","     };"," ","-    ov::AnyMap config = {","-        {\"NPUW_ONLINE_PIPELINE\", \"REP\"},","-        {std::string(::intel_npu::NPUW_DEVICES::key()), \"NPU\"},","-        {ov::cache_mode.name(), ov::CacheMode::OPTIMIZE_SPEED},","-        {std::string(::intel_npu::NPUW_UNQDQ::key()), \"YES\"},","-    };","+    // V0/V1 are pre-assembled GQA graphs that online partitioning would only get in the way","+    // of. V2 (2-bit group-quantized weights) still benefits from online partitioning, so it","+    // keeps the default pipeline (REG) instead of being forced to NONE.","+    ov::AnyMap config = {{\"NPU_COMPILER_DYNAMIC_QUANTIZATION\", \"YES\"},","+                         {std::string(::intel_npu::NPUW_DEVICES::key()), \"NPU\"},","+                         {ov::cache_mode.name(), ov::CacheMode::OPTIMIZE_SPEED},","+                         {std::string(::intel_npu::NPUW_UNQDQ::key()), \"YES\"}};","+    if (!has_2bit_group_quantized_weights(model)) {","+        config.emplace(\"NPUW_ONLINE_PIPELINE\", \"NONE\");","+    }"," ","     const auto stage = detect_gqa_model_stage();","     if (stage == GQAModelStage::PREFILL) {","@@ -159,19 +259,38 @@ std::pair<ov::AnyMap, GQAModelStage> with_gqa_defaults(const std::shared_ptr<ov:","         LOG_INFO(\"GQA model stage unknown; FOLD disabled\");","     }","     merge_config_with(config, properties);","+    // LLM-only option; the inner CompiledModel only registers ROOT options.","+    config.erase(std::string(::intel_npu::NPUW_LLM_MAX_CONTEXT_LEN::key()));","+    config.erase(std::string(::intel_npu::NPUW_LLM_SWA_LEN::key()));","     return {config, stage};"," }"," "," }  // namespace"," ","+// Prints a \"[GQA-TRACE]\" line when OPENVINO_NPUW_GQA_LOG=1 is set; no-op otherwise.","+// `msg` is a chain of `<<`-streamed expressions. Developer builds only.","+#ifdef NPU_PLUGIN_DEVELOPER_BUILD","+#    define GQA_TRACE(msg)                                       \\","+        do {                                                     \\","+            if (gqa_trace_enabled()) {                           \\","+                std::cout << \"[GQA-TRACE] \" << msg << std::endl; \\","+            }                                                    \\","+        } while (0)","+#else","+#    define GQA_TRACE(msg)","+#endif","+"," ov::npuw::GQACompiledModel::PreparedState ov::npuw::GQACompiledModel::prepare(const std::shared_ptr<ov::Model>& model,","                                                                               const ov::AnyMap& properties) {","     auto [prepared_properties, stage] = with_gqa_defaults(model, properties);"," ","+    static std::atomic<std::size_t> mcount{0u};","+","     model->set_friendly_name(model->get_friendly_name() + \"_gqa_\" +","                              (stage == GQAModelStage::PREFILL    ? \"prefill\"","                               : stage == GQAModelStage::GENERATE ? \"generate\"","-                                                                 : \"unknown\"));","+                                                                 : \"unknown\") +","+                             std::to_string(mcount++));"," ","     // Untangle shared scale constants so every DequantizeLinear Multiply","     // gets its own copy.  Some exporters reuse a single scale node across","@@ -191,7 +310,29 @@ ov::npuw::GQACompiledModel::PreparedState ov::npuw::GQACompiledModel::prepare(co","         ov::npuw::CollapseUNQDQ collapse_unqdq;","         collapse_unqdq.run_on_model(model);","     }","-    return {model, std::move(prepared_properties)};","+","+    // Reshape kv-cache to static, if any","+    std::shared_ptr<ov::Model> compiled_model = model;","+    std::unordered_map<std::string, size_t> dynamic_kv_cache_axes;","+    uint32_t effective_max_context_len = cfg_get<::intel_npu::NPUW_LLM_MAX_CONTEXT_LEN>(properties);","+    uint32_t effective_sliding_window_capacity = 0;","+    if (has_dynamic_max_seq_len(model)) {","+        const size_t max_seq_len = gqa_ctx_len_env_override().value_or(effective_max_context_len);","+        effective_max_context_len = static_cast<uint32_t>(max_seq_len);","+        compiled_model = model->clone();","+        const auto default_sliding_window_capacity = resolve_default_sliding_window_capacity(properties);","+        effective_sliding_window_capacity = static_cast<uint32_t>(default_sliding_window_capacity.value_or(0));","+        ov::npuw::ReshapeToStaticGQA reshape_to_static_gqa(max_seq_len, default_sliding_window_capacity);","+        reshape_to_static_gqa.run_on_model(compiled_model);","+        dynamic_kv_cache_axes = reshape_to_static_gqa.dynamic_kv_cache_axes();","+    }","+","+    return {model,","+            compiled_model,","+            std::move(prepared_properties),","+            std::move(dynamic_kv_cache_axes),","+            effective_max_context_len,","+            effective_sliding_window_capacity};"," }"," "," std::shared_ptr<ov::npuw::ICompiledModel> ov::npuw::GQACompiledModel::make_compiled_model(","@@ -201,6 +342,211 @@ std::shared_ptr<ov::npuw::ICompiledModel> ov::npuw::GQACompiledModel::make_compi","     return std::make_shared<ov::npuw::CompiledModel>(model, plugin, properties);"," }"," ","+namespace {","+","+// Resolves the Parameter feeding the GQA op's TOTAL_SEQUENCE_LENGTH input, used to","+// compute an accurate present_key/present_value length at infer() time.","+std::optional<std::string> find_total_sequence_length_param_name(const std::shared_ptr<const ov::Model>& model) {","+    using ov::op::internal::GroupQueryAttention;","+    using ov::op::internal::GroupQueryAttentionInputs;","+    constexpr size_t total_seq_len_idx = static_cast<size_t>(GroupQueryAttentionInputs::TOTAL_SEQUENCE_LENGTH);","+    for (const auto& node : model->get_ordered_ops()) {","+        auto gqa = ov::as_type_ptr<GroupQueryAttention>(node);","+        if (!gqa || gqa->get_input_size() <= total_seq_len_idx) {","+            continue;","+        }","+        if (auto param =","+                ov::npuw::util::trace_back_to_parameter(gqa->input_value(total_seq_len_idx).get_node_shared_ptr())) {","+            return param->get_friendly_name();","+        }","+    }","+    return std::nullopt;","+}","+","+// Detects present_key/present_value names (underscore and HF-ONNX dot style). Shared by","+// identify_case() and find_dynamic_kv_cache_output_axes() so both agree on a match.","+bool is_present_kv_cache_output_name(const std::string& name) {","+    return ov::npuw::util::contains_ignore_case(name, \"present_key\") ||","+           ov::npuw::util::contains_ignore_case(name, \"present_value\") ||","+           ov::npuw::util::contains_ignore_case(name, \"present.\");","+}","+","+// True if `gqa` is well-formed enough to count as real GQA evidence. Shared by","+// find_valid_gqa_op() and find_all_valid_gqa_ops().","+bool is_valid_gqa_op(const ov::op::internal::GroupQueryAttention& gqa) {","+    using ov::op::internal::GroupQueryAttentionInputs;","+    constexpr size_t mandatory_inputs = static_cast<size_t>(GroupQueryAttentionInputs::TOTAL_SEQUENCE_LENGTH) + 1;","+","+    const auto num_heads = gqa.get_num_heads();","+    const auto kv_num_heads = gqa.get_kv_num_heads();","+    if (num_heads <= 0 || kv_num_heads <= 0 || num_heads % kv_num_heads != 0 ||","+        gqa.get_input_size() < mandatory_inputs) {","+        return false;  // malformed instance, doesn't count as evidence","+    }","+    if (gqa.get_do_rotary() && gqa.get_input_size() <= static_cast<size_t>(GroupQueryAttentionInputs::SIN_CACHE)) {","+        return false;  // rotary requires the cos/sin cache inputs","+    }","+    return true;","+}","+","+std::vector<std::shared_ptr<ov::op::internal::GroupQueryAttention>> find_all_valid_gqa_ops(","+    const std::shared_ptr<const ov::Model>& model) {","+    using ov::op::internal::GroupQueryAttention;","+    std::vector<std::shared_ptr<GroupQueryAttention>> result;","+    for (const auto& node : model->get_ordered_ops()) {","+        auto gqa = ov::as_type_ptr<GroupQueryAttention>(node);","+        if (gqa && is_valid_gqa_op(*gqa)) {","+            result.push_back(std::move(gqa));","+        }","+    }","+    return result;","+}","+","+std::shared_ptr<ov::op::internal::GroupQueryAttention> find_valid_gqa_op(","+    const std::shared_ptr<const ov::Model>& model) {","+    using ov::op::internal::GroupQueryAttention;","+    for (const auto& node : model->get_ordered_ops()) {","+        auto gqa = ov::as_type_ptr<GroupQueryAttention>(node);","+        if (gqa && is_valid_gqa_op(*gqa)) {","+            return gqa;","+        }","+    }","+    return nullptr;","+}","+","+}  // namespace","+","+bool ov::npuw::GQACompiledModel::supports(const std::shared_ptr<const ov::Model>& model) {","+    // identify_case() classifies GQA family regardless of dynamic shapes; this wrapper is","+    // only needed when max_seq_len is actually dynamic.","+    return identify_case(model) != Case::Unknown && has_dynamic_max_seq_len(model);","+}","+","+ov::npuw::GQACompiledModel::Case ov::npuw::GQACompiledModel::identify_case(","+    const std::shared_ptr<const ov::Model>& model) {","+    auto gqa = find_valid_gqa_op(model);","+    if (!gqa) {","+        return Case::Unknown;","+    }","+","+    // Each matched name must also be forward-reachable to the GQA op (not just same-named).","+    const auto* gqa_node = gqa.get();","+","+    // V1 uses `position_ids` for RoPE; V0/V2 use `past_seq_len`/`total_seq_len` instead.","+    // V2 is further distinguished by 2-bit group-quantized (u2) weights.","+    bool has_activation_input = false;","+    bool has_position_ids = false;","+    bool has_seq_len_signal = false;","+    bool has_past_kv_cache = false;","+    for (const auto& parameter : model->get_parameters()) {","+        const auto& name = parameter->get_friendly_name();","+        if (!ov::npuw::util::reaches(parameter.get(), gqa_node)) {","+            continue;","+        }","+        has_activation_input = has_activation_input || (name == \"input_hidden_states\" || name == \"input_ids\");","+        has_position_ids = has_position_ids || (name == \"position_ids\");","+        has_seq_len_signal = has_seq_len_signal || (name == \"past_seq_len\") || (name == \"total_seq_len\");","+        has_past_kv_cache = has_past_kv_cache || util::contains_ignore_case(name, \"past_key\") ||","+                            util::contains_ignore_case(name, \"past_value\");","+    }","+    if (!has_activation_input || !has_past_kv_cache || (!has_position_ids && !has_seq_len_signal)) {","+        return Case::Unknown;","+    }","+","+    bool has_present_kv_cache = false;","+    for (const auto& result : model->get_results()) {","+        const auto& name = result->get_friendly_name();","+        if (is_present_kv_cache_output_name(name) && ov::npuw::util::reaches(gqa_node, result.get())) {","+            has_present_kv_cache = true;","+            break;","+        }","+    }","+    if (!has_present_kv_cache) {","+        return Case::Unknown;","+    }","+","+    if (has_position