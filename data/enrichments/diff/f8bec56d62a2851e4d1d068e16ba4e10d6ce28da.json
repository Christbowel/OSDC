_ACTIVATE_NONCE?: string;","+\t}","+}","+","+const ACTIVE_THEMES_URL = '/wp/v2/themes?status=active';","+","+type ActiveTheme = { name?: { rendered?: string } };","+","+/**","+ * The actually active theme: an empty `wp_theme_preview` makes Core's","+ * middleware strip the parameter, so the endpoint reports the real active","+ * theme rather than the previewed one.","+ */","+function useActualCurrentTheme() {","+\tconst [ currentTheme, setCurrentTheme ] = useState< ActiveTheme >();","+","+\tuseEffect( () => {","+\t\tconst path = addQueryArgs( ACTIVE_THEMES_URL, {","+\t\t\tcontext: 'edit',","+\t\t\twp_theme_preview: '',","+\t\t} );","+","+\t\tapiFetch< ActiveTheme[] >( { path } )","+\t\t\t.then( ( activeThemes ) => setCurrentTheme( activeThemes[ 0 ] ) )","+\t\t\t.catch( () => {} );","+\t}, [] );","+","+\treturn currentTheme;","+}","+","+/**","+ * Activates a theme through the classic themes screen action (there is no","+ * REST endpoint for it). Core redirects to the themes screen, which","+ * announces the activation.","+ */","+function activateTheme( stylesheet: string ) {","+\twindow.location.href = addQueryArgs( 'themes.php', {","+\t\taction: 'activate',","+\t\tstylesheet,","+\t\t_wpnonce: window.WP_BLOCK_THEME_ACTIVATE_NONCE,","+\t} );","+}","+","+/**","+ * The review-and-activate panel: the same flow as site editor v1's theme","+ * preview, where activating saves any pending edits — global styles changes","+ * included — against the previewed theme first, then switches to it.","+ */","+export function ActivatePanel( {","+\tthemeName,","+\tonClose,","+}: {","+\tthemeName?: string;","+\tonClose: () => void;","+} ) {","+\tconst isDirtyProps = useEntitiesSavedStatesIsDirty();","+\tlet activateSaveLabel, successNoticeContent;","+\tif ( isDirtyProps.isDirty ) {","+\t\tactivateSaveLabel = __( 'Activate & Save' );","+\t\tsuccessNoticeContent = __( 'Theme activated and site updated.' );","+\t} else {","+\t\tactivateSaveLabel = __( 'Activate' );","+\t\tsuccessNoticeContent = __( 'Theme activated.' );","+\t}","+","+\tconst currentTheme = useActualCurrentTheme();","+","+\tconst additionalPrompt = (","+\t\t<p>","+\t\t\t{ sprintf(","+\t\t\t\t/* translators: 1: The name of active theme, 2: The name of theme to be activated. */","+\t\t\t\t__(","+\t\t\t\t\t'Saving your changes will change your active theme from %1$s to %2$s.'","+\t\t\t\t),","+\t\t\t\tcurrentTheme?.name?.rendered ?? '...',","+\t\t\t\tthemeName ?? '...'","+\t\t\t) }","+\t\t</p>","+\t);","+","+\treturn (","+\t\t<EntitiesSavedStatesExtensible","+\t\t\t{ ...isDirtyProps }","+\t\t\tadditionalPrompt={ additionalPrompt }","+\t\t\tclose={ onClose }","+\t\t\tonSave={ () => activateTheme( getPreviewedStylesheet() ) }","+\t\t\tsaveEnabled","+\t\t\tsaveLabel={ activateSaveLabel }","+\t\t\tvariant=\"inline\"","+\t\t\tsuccessNoticeContent={ successNoticeContent }","+\t\t/>","+\t);","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"routes/styles/package.json","lines":["@@ -4,10 +4,14 @@"," \t\"private\": true,"," \t\"route\": {"," \t\t\"path\": \"/styles\",","-\t\t\"page\": \"site-editor-v2\"","+\t\t\"page\": [","+\t\t\t\"site-editor-v2\",","+\t\t\t\"theme-preview\"","+\t\t]"," \t},"," \t\"dependencies\": {"," \t\t\"@wordpress/admin-ui\": \"file:../../packages/admin-ui\",","+\t\t\"@wordpress/api-fetch\": \"file:../../packages/api-fetch\","," \t\t\"@wordpress/base-styles\": \"file:../../packages/base-styles\","," \t\t\"@wordpress/components\": \"file:../../packages/components\","," \t\t\"@wordpress/compose\": \"file:../../packages/compose\",","@@ -15,6 +19,7 @@"," \t\t\"@wordpress/data\": \"file:../../packages/data\","," \t\t\"@wordpress/editor\": \"file:../../packages/editor\","," \t\t\"@wordpress/element\": \"file:../../packages/element\",","+\t\t\"@wordpress/html-entities\": \"file:../../packages/html-entities\","," \t\t\"@wordpress/i18n\": \"file:../../packages/i18n\","," \t\t\"@wordpress/icons\": \"file:../../packages/icons\","," \t\t\"@wordpress/lazy-editor\": \"file:.