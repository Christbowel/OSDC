{"id":"f8bec56d62a2851e4d1d068e16ba4e10d6ce28da","axis":"silent","repo":"WordPress/gutenberg","sha":"f8bec56d62a2851e4d1d068e16ba4e10d6ce28da","parsed":{"files":[{"path":"lib/experimental/extensible-site-editor.php","lines":["@@ -2,21 +2,18 @@"," /**","  * Extensible Site Editor experiment integration.","  *","+ * Only loaded while the `gutenberg-extensible-site-editor` experiment is","+ * enabled (see lib/load.php).","+ *","  * @package gutenberg","  */"," "," /**","- * Redirect the Appearance > Design menu to the extensible site editor","- * when the experiment is enabled.","+ * Redirect the Appearance > Design menu to the extensible site editor.","  *","  * @global array $submenu WordPress admin submenu array.","  */"," function gutenberg_redirect_to_extensible_site_editor() {","-\t// Only proceed if the experiment is enabled.","-\tif ( ! gutenberg_is_experiment_enabled( 'gutenberg-extensible-site-editor' ) ) {","-\t\treturn;","-\t}","-"," \t// Update the Design submenu item to point to the extensible site editor."," \tglobal $submenu;"," \tif ( $submenu && isset( $submenu['themes.php'] ) ) {"],"additions":4,"deletions":7,"truncated":false},{"path":"lib/experimental/theme-preview/load.php","lines":["@@ -0,0 +1,158 @@","+<?php","+/**","+ * Bootstraps the block theme preview page in wp-admin.","+ *","+ * Part of the extensible site editor experiment: only loaded while the","+ * `gutenberg-extensible-site-editor` experiment is enabled (see lib/load.php).","+ *","+ * @package gutenberg","+ */","+","+/**","+ * Builds the theme preview page URL for a theme.","+ *","+ * The page previews the theme named by the `wp_theme_preview` query","+ * parameter. Core's `wp-includes/theme-previews.php` reads that parameter on","+ * every request: it filters `stylesheet`/`template` (for users with","+ * `switch_themes`), attaches an apiFetch middleware that forwards the","+ * parameter on every REST request, and prints the activation nonce on","+ * `admin_head` — so the page needs no further wiring beyond carrying the","+ * parameter in its URL.","+ *","+ * @param string $stylesheet Stylesheet (directory name) of the theme to preview.","+ * @return string Theme preview page URL, not escaped for output.","+ */","+function gutenberg_get_theme_preview_url( $stylesheet ) {","+\tstatic $base = null;","+\tif ( null === $base ) {","+\t\t// The page renders the styles route, registered at `/styles`.","+\t\t$base = admin_url( 'admin.php?page=theme-preview-wp-admin&p=%2Fstyles' );","+\t}","+","+\treturn add_query_arg(","+\t\t'wp_theme_preview',","+\t\t// `add_query_arg` does not encode new values, so encode subdirectory","+\t\t// theme stylesheets like `parent/child` here.","+\t\trawurlencode( $stylesheet ),","+\t\t$base","+\t);","+}","+","+/**","+ * Registers the hidden wp-admin page that previews a block theme.","+ */","+function gutenberg_register_theme_preview_admin_page() {","+\t// Register with an empty parent to create a hidden admin.php?page= route","+\t// without adding an Appearance submenu item for a screen that requires a","+\t// `wp_theme_preview` parameter.","+\t$hook_suffix = add_submenu_page(","+\t\t'',","+\t\t__( 'Theme Preview', 'gutenberg' ),","+\t\t__( 'Theme Preview', 'gutenberg' ),","+\t\t'switch_themes',","+\t\t'theme-preview-wp-admin',","+\t\t'gutenberg_theme_preview_wp_admin_render_page'","+\t);","+","+\tif ( $hook_suffix ) {","+\t\tadd_action( \"load-$hook_suffix\", 'gutenberg_theme_preview_wp_admin_prepare_screen' );","+\t}","+}","+","+/**","+ * Prepares the admin chrome before wp-admin/admin-header.php renders.","+ *","+ * @global string $title        The admin page title.","+ * @global string $parent_file  The current top-level menu item.","+ * @global string $submenu_file The current submenu item.","+ */","+function gutenberg_theme_preview_wp_admin_prepare_screen() {","+\tglobal $title, $parent_file, $submenu_file;","+","+\t// Hidden pages do not resolve a title from a visible menu item, so set one","+\t// before admin-header.php formats the page title.","+\t$title = __( 'Theme Preview', 'gutenberg' );","+","+\t/*","+\t * Take the page out of the hidden `''` submenu bucket it was registered in.","+\t * Left in place, get_admin_page_parent() matches it there and resets","+\t * $parent_file to '' — and it does so *after* the `parent_file` filter runs,","+\t * so filtering cannot win. With no match it preserves a non-empty","+\t * $parent_file instead.","+\t *","+\t * Safe at this point: `load-` fires after the capability check in admin.php,","+\t * which needs the page registered, and before the menu is rendered.","+\t */","+\tremove_submenu_page( '', 'theme-preview-wp-admin' );","+","+\t// The preview is reached from the themes screen; keep Appearance current.","+\t$parent_file  = 'themes.php';","+\t$submenu_file = 'themes.php';","+}","+","+/**","+ * Points the themes screen's block theme live preview links at the theme","+ * preview page.","+ *","+ * Core builds those links as `site-editor.php?wp_theme_preview=<stylesheet>`;","+ * rewriting them here saves the round trip through site-editor.php that the","+ * redirect below would otherwise take. The active theme's entry is left","+ * alone: it carries no `wp_theme_preview` parameter and links to the site","+ * editor as a customize action.","+ *","+ * @param array $prepared_themes Themes prepared for the themes screen.","+ * @return array Themes with rewritten live preview links.","+ */","+function gutenberg_use_theme_preview_page_for_live_preview_links( $prepared_themes ) {","+\tif ( ! current_user_can( 'switch_themes' ) ) {","+\t\treturn $prepared_themes;","+\t}","+","+\t$current_stylesheet = get_stylesheet();","+\tforeach ( $prepared_themes as $stylesheet => $theme_data ) {","+\t\tif (","+\t\t\t$stylesheet === $current_stylesheet","+\t\t\t|| empty( $theme_data['blockTheme'] )","+\t\t\t|| empty( $theme_data['actions']['customize'] )","+\t\t) {","+\t\t\tcontinue;","+\t\t}","+\t\t$prepared_themes[ $stylesheet ]['actions']['customize'] = esc_url( gutenberg_get_theme_preview_url( $stylesheet ) );","+\t}","+","+\treturn $prepared_themes;","+}","+","+/**","+ * Redirects block theme previews from the site editor to the theme preview page.","+ *","+ * The links the filter above rewrites no longer reach site-editor.php; this","+ * catches the remaining entry points — bookmarks, hand-typed URLs, and the","+ * live preview link the theme installer renders after installing a theme.","+ * For users the preview filters ignore, site-editor.php behaves as before.","+ */","+function gutenberg_redirect_theme_preview_to_theme_preview_page() {","+\t// phpcs:ignore WordPress.Security.NonceVerification.Recommended -- Reading the same unauthenticated query arg Core's theme-previews.php reads to decide whether a preview is requested.","+\t$stylesheet = isset( $_GET['wp_theme_preview'] ) ? sanitize_text_field( wp_unslash( $_GET['wp_theme_preview'] ) ) : '';","+\tif ( '' === $stylesheet ) {","+\t\treturn;","+\t}","+","+\t// Core ignores the preview for users without `switch_themes`; leave them","+\t// on the site editor, which keeps showing the active theme.","+\tif ( ! current_user_can( 'switch_themes' ) ) {","+\t\treturn;","+\t}","+","+\twp_safe_redirect( gutenberg_get_theme_preview_url( $stylesheet ) );","+\texit;","+}","+","+// The render callback is generated into `build/pages`, which lib/load.php","+// requires before this file: a build that predates the page has nothing to","+// register, link, or redirect to.","+if ( function_exists( 'gutenberg_theme_preview_wp_admin_render_page' ) ) {","+\tadd_action( 'admin_menu', 'gutenberg_register_theme_preview_admin_page' );","+\tadd_filter( 'wp_prepare_themes_for_js', 'gutenberg_use_theme_preview_page_for_live_preview_links' );","+\tadd_action( 'load-site-editor.php', 'gutenberg_redirect_theme_preview_to_theme_preview_page' );","+}"],"additions":158,"deletions":0,"truncated":false},{"path":"lib/load.php","lines":["@@ -137,9 +137,13 @@ function gutenberg_is_experiment_ena