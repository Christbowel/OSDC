($value);","+        }","+","+        $host = \\substr($value, 0, $separator);","+        $port = \\substr($value, $separator + 1);","+","+        return $this->isValidHost($host) && $this->isValidPort($port);","+    }","+","+    private function isValidHost(string $host): bool","+    {","+        if (\\str_starts_with($host, '[') && \\str_ends_with($host, ']')) {","+            return \\filter_var(\\substr($host, 1, -1), FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) !== false;","+        }","+","+        return \\filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false;","+    }","+","+    private function isValidPort(string $port): bool","+    {","+        if (!\\ctype_digit($port) || \\str_starts_with($port, '0')) {","+            return false;","+        }","+","+        $number = (int) $port;","+","+        return $number >= 1 && $number <= 65535;","+    }","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"src/Appwrite/Platform/Tasks/Install.php","lines":["@@ -13,6 +13,7 @@"," use Appwrite\\Platform\\Installer\\Runtime\\State;"," use Appwrite\\Platform\\Installer\\Server as InstallerServer;"," use Appwrite\\Platform\\Installer\\Validator\\AppDomain;","+use Appwrite\\Platform\\Installer\\Validator\\Port;"," use Appwrite\\Utopia\\View;"," use Swoole\\Coroutine;"," use Utopia\\Auth\\Proofs\\Password;","@@ -70,8 +71,8 @@ public function __construct()","     {","         $this","             ->desc('Install Appwrite')","-            ->param('http-port', '', new Text(4), 'Server HTTP port', true)","-            ->param('https-port', '', new Text(4), 'Server HTTPS port', true)","+            ->param('http-port', '', new Port(), 'Server HTTP port, optionally bound to a host IP (127.0.0.1:80)', true)","+            ->param('https-port', '', new Port(), 'Server HTTPS port, optionally bound to a host IP (127.0.0.1:443)', true)","             ->param('organization', 'appwrite', new Text(0), 'Docker Registry organization', true)","             ->param('image',