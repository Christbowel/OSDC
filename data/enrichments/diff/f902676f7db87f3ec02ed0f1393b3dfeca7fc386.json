lugins select the shader language and stage through qualified injection keys.","+Luma.gl alpha.10 resolves vertex and fragment targets with the same name by","+stage. The WGSL layer call sites shown above apply color filters in the fragment stage."],"additions":40,"deletions":0,"truncated":false},{"path":"modules/core/src/shaderlib/index.ts","lines":["@@ -21,7 +21,7 @@ import picking, {pickingPlugin} from './picking/picking';"," "," const DEFAULT_MODULES = [geometry];"," ","-// WGSL targets are no-op stubs until layer call sites and extensions are wired.","+// GLSL and WGSL share target names with language-specific signatures."," const SHADER_INJECTION_TARGETS: ShaderInjectionTarget[] = [","   {","     name: 'DECKGL_FILTER_SIZE',"],"additions":1,"deletions":1,"truncated":false},{"path":"modules/core/src/shaderlib/project/project.wgsl.ts","lines":["@@ -66,16 +66,7 @@ var<storage, read> project_sizeScaleBuffer: array<vec4<f32>>;"," // state before calling the project functions below."," // -----------------------------------------------------------------------------"," ","-// Structure to carry additional geometry data used by deck.gl filters.","-struct Geometry {","-  worldPosition: vec3<f32>,","-  worldPositionAlt: vec3<f32>,","-  position: vec4<f32>,","-  normal: vec3<f32>,","-  uv: vec2<f32>,","-  pickingColor: vec3<f32>,","-};","-","+alias Geometry = VertexGeometry;"," var<private> geometry: Geometry;"," `;"," "],"additions":1,"deletions":10,"truncated":false},{"path":"modules/layers/src/arc-layer/arc-layer.wgsl.ts","lines":["@@ -287,15 +287,14 @@ fn vertexMain(","     arc.widthMinPixels,","     arc.widthMaxPixels","   );","-#ifdef ANTIALIASING","   var offset = getExtrusionOffset(","-#else","-  let offset = getExtrusionOffset(","-#endif","     (nextClip.xy - currentClip.xy) * indexDirection,","     segmentSide,","     widthPixels","   );","+  var size = vec3<f32>(offset, 0.0);","+  DECKGL_FILTER_SIZE(&size, geometry);","+  offset = size.xy;"," #ifdef ANTIALIASIN