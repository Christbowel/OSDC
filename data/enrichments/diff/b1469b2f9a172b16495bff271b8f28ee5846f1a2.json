mponent{","+\t\t\t\t\t{","+\t\t\t\t\t\tName:       \"old\",","+\t\t\t\t\t\tType:       \"webservice@v1\",","+\t\t\t\t\t\tProperties: util.Object2RawExtension(map[string]interface{}{\"image\": \"nginx\"}),","+\t\t\t\t\t\tTraits: []common.ApplicationTrait{{","+\t\t\t\t\t\t\tType:       \"label@v2\",","+\t\t\t\t\t\t\tProperties: util.Object2RawExtension(map[string]interface{}{\"labels\": map[string]string{\"pinned\": \"old\"}}),","+\t\t\t\t\t\t}},","+\t\t\t\t\t},","+\t\t\t\t\t{","+\t\t\t\t\t\tName:       \"new\",","+\t\t\t\t\t\tType:       \"webservice@v2\",","+\t\t\t\t\t\tProperties: util.Object2RawExtension(map[string]interface{}{\"image\": \"nginx\"}),","+\t\t\t\t\t\tTraits: []common.ApplicationTrait{{","+\t\t\t\t\t\t\tType:       \"label@v1\",","+\t\t\t\t\t\t\tProperties: util.Object2RawExtension(map[string]interface{}{\"labels\": map[string]string{\"pinned\": \"new\"}}),","+\t\t\t\t\t\t}},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+","+\t\texpectEachRevision := func() {","+\t\t\tEventually(func(g Gomega) {","+\t\t\t\told := &appsv1.Deployment{}","+\t\t\t\tg.Expect(k8sClient.Get(ctx, client.ObjectKey{Name: \"old\", Namespace: namespace}, old)).Should(Succeed())","+\t\t\t\tg.Expect(old.Labels).Should(HaveKeyWithValue(\"pinned\", \"old\"))","+\t\t\t\tg.Expect(old.Labels).Should(HaveKeyWithValue(\"componentdefinition.oam.dev/version\", \"v1\"), \"old is webservice@v1\")","+\t\t\t\tg.Expect(old.Labels).ShouldNot(HaveKey(\"traitdefinition.oam.dev/version\"), \"old carries label@v2\")","+","+\t\t\t\tnewer := &appsv1.Deployment{}","+\t\t\t\tg.Expect(k8sClient.Get(ctx, client.ObjectKey{Name: \"new\", Namespace: namespace}, newer)).Should(Succeed())","+\t\t\t\tg.Expect(newer.Labels).Should(HaveKeyWithValue(\"pinned\", \"new\"))","+\t\t\t\tg.Expect(newer.Labels).ShouldNot(HaveKey(\"componentdefinition.oam.dev/version\"), \"new is webservice@v2\")","+\t\t\t\tg.Expect(newer.Labels).Should(HaveKeyWithValue(\"traitdefinition.oam.dev/version\", \"v1\"), \"new carries label@v1\")","+\t\t\t}, 60*time.Second, 2*time.Second).Should(Succeed())","+\t\t}","+","+\t\tBy(\"Deploying the application\")","+\t\tExpect(k8sClient.Create(ctx, &app)).Should(Succeed())","+\t\tvar firstRun metav1.Time","+\t\tEventually(func(g Gomega) {","+\t\t\tgot := &v1beta1.Application{}","+\t\t\tg.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(&app), got)).Should(Succeed())","+\t\t\tg.Expect(got.Status.Phase).Should(Equal(common.ApplicationRunning))","+\t\t\tg.Expect(got.Status.Workflow).ShouldNot(BeNil())","+\t\t\tfirstRun = got.Status.Workflow.StartTime","+\t\t}, 120*time.Second, 2*time.Second).Should(Succeed())","+\t\texpectEachRevision()","+","+\t\tBy(\"Restarting the workflow at the same publishVersion, so it renders from the revision\")","+\t\tEventually(func() error {","+\t\t\tgot := &v1beta1.Application{}","+\t\t\tif err := k8sClient.Get(ctx, client.ObjectKeyFromObject(&app), got); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t\tgot.Annotations[oam.AnnotationWorkflowRestart] = \"true\"","+\t\t\treturn k8sClient.Update(ctx, got)","+\t\t}, 15*time.Second, time.Second).Should(Succeed())","+\t\tEventually(func(g Gomega) {","+\t\t\tgot := &v1beta1.Application{}","+\t\t\tg.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(&app), got)).Should(Succeed())","+\t\t\tg.Expect(got.Status.Workflow).ShouldNot(BeNil())","+\t\t\tg.Expect(got.Status.Workflow.StartTime.After(firstRun.Time)).Should(BeTrue(), \"the workflow has run again\")","+\t\t\tg.Expect(got.Status.Phase).Should(Equal(common.ApplicationRunning))","+\t\t}, 120*time.Second, 2*time.Second).Should(Succeed())","+\t\texpectEachRevision()","+\t})"," })"," "," var webServiceWithNoTemplate = &v1beta1.ComponentDefinition{"],"additions":83,"deletions":0,"truncated":false},{"path":"vela-templates/definitions/internal/component/worker.cue","lines":["@@ -301,6 +301,22 @@ template: {"," \t\t\tvalue?: string"," \t\t\t// +usage=Specifies a source the value of this var should come from"," \t\t\tvalueFrom?