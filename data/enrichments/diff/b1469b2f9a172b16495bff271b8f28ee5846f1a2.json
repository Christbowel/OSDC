ition: namedDef(\"bar\", \"output: revision: 2\")})","+\trequire.NoError(t, err)","+","+\taf := &Appfile{","+\t\tRelatedComponentDefinitions: map[string]*v1beta1.ComponentDefinition{},","+\t\tRelatedTraitDefinitions:     map[string]*v1beta1.TraitDefinition{},","+\t}","+\tsetComponentDefinitions(af, []*Component{v1, v2})","+","+\trequire.Contains(t, af.RelatedComponentDefinitions, \"bar@v1\")","+\trequire.Equal(t, \"output: revision: 1\", af.RelatedComponentDefinitions[\"bar@v1\"].Spec.Schematic.CUE.Template)","+\trequire.Contains(t, af.RelatedComponentDefinitions, \"bar@v2\")","+\trequire.Equal(t, \"output: revision: 2\", af.RelatedComponentDefinitions[\"bar@v2\"].Spec.Schematic.CUE.Template)","+\trequire.Contains(t, af.RelatedComponentDefinitions, \"bar\", \"the bare entry stays for readers that look up by name\")","+}","+","+func TestTraitsPinningDifferentRevisionsEachKeepTheirOwn(t *testing.T) {","+\tp := &Parser{}","+\tv1, err := p.convertTemplate2Trait(\"scaler@v1\", nil, &Template{TraitDefinition: traitDef(\"scaler\", \"\", \"outputs: revision: 1\")})","+\trequire.NoError(t, err)","+\tv2, err := p.convertTemplate2Trait(\"scaler@v2\", nil, &Template{TraitDefinition: traitDef(\"scaler\", \"\", \"outputs: revision: 2\")})","+\trequire.NoError(t, err)","+","+\tcomp := &Component{","+\t\tName:         \"web\",","+\t\tFullTemplate: &Template{ComponentDefinition: namedDef(\"web\", \"output: {}\")},","+\t\tTraits:       []*Trait{v1, v2},","+\t}","+\taf := &Appfile{","+\t\tRelatedComponentDefinitions: map[string]*v1beta1.ComponentDefinition{},","+\t\tRelatedTraitDefinitions:     map[string]*v1beta1.TraitDefinition{},","+\t}","+\tsetComponentDefinitions(af, []*Component{comp})","+","+\trequire.Contains(t, af.RelatedTraitDefinitions, \"scaler@v1\")","+\trequire.Equal(t, \"outputs: revision: 1\", af.RelatedTraitDefinitions[\"scaler@v1\"].Spec.Schematic.CUE.Template)","+\trequire.Contains(t, af.RelatedTraitDefinitions, \"scaler@v2\")","+\trequire.Equal(t, \"outputs: revision: 2\", af.RelatedTraitDefinitions[\"scaler@v2\"].Spec.Schematic.CUE.Template)","+\trequire.Contains(t, af.RelatedTraitDefinitions, \"scaler\")","+}","+","+// A replay renders a pinned component from the entry recorded for that pin,","+// and from the bare entry only when the revision predates pinned entries.","+func TestRevisionReplayReadsThePinnedEntry(t *testing.T) {","+\tdef := func(template string) *v1beta1.ComponentDefinition {","+\t\treturn &v1beta1.ComponentDefinition{","+\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"bar\"},","+\t\t\tSpec: v1beta1.ComponentDefinitionSpec{","+\t\t\t\tSchematic: &common.Schematic{CUE: &common.CUE{Template: template}},","+\t\t\t\tWorkload:  common.WorkloadTypeDescriptor{Definition: common.WorkloadGVK{APIVersion: \"v1\", Kind: \"Pod\"}},","+\t\t\t},","+\t\t}","+\t}","+\trev := func(defs map[string]*v1beta1.ComponentDefinition) *v1beta1.ApplicationRevision {","+\t\treturn &v1beta1.ApplicationRevision{","+\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"app-v1\"},","+\t\t\tSpec: v1beta1.ApplicationRevisionSpec{","+\t\t\t\tApplicationRevisionCompressibleFields: v1beta1.ApplicationRevisionCompressibleFields{ComponentDefinitions: defs},","+\t\t\t},","+\t\t}","+\t}","+","+\tt.Run(\"the pinned entry wins over the bare one\", func(t *testing.T) {","+\t\tapprev := rev(map[string]*v1beta1.ComponentDefinition{","+\t\t\t\"bar\":    def(\"output: revision: 2\"),","+\t\t\t\"bar@v1\": def(\"output: revision: 1\"),","+\t\t\t\"bar@v2\": def(\"output: revision: 2\"),","+\t\t})","+\t\ttmpl, err := LoadTemplateFromRevision(\"bar@v1\", types.TypeComponentDefinition, apprev, fakeRESTMapper{})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, \"output: revision: 1\", tmpl.TemplateStr)","+\t})","+","+\tt.Run(\"a revision with only the bare entry still replays\", func(t *testing.T) {","+\t\tapprev := rev(map[string]*v1beta1.ComponentDefinition{\"bar\": def(\"output: revision: 1\")})","+\t\ttmpl, err := LoadTemplateFromRevision(\"bar@v1\", types.TypeComponentDefinition, apprev, fakeRESTMapper{})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, \"output: revision: 1\", tmpl.TemplateStr)","+\t})","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"pkg/appfile/template.go","lines":["@@ -322,7 +322,13 @@ func IsNotFoundInAppRevision(err error) bool {"," \treturn err != nil && strings.Contains(err.Error(), \"not found in app revision\")"," }"," ","+// verifyRevisionName returns the key a revision holds capName's definition","+// under: the reference itself when the revision recorded it, or the bare","+// definition name for a revision written before references were recorded."," func verifyRevisionName(capName string, capType types.CapType, apprev *v1beta1.ApplicationRevision) string {","+\tif revisionCapabilityExists(capName, capType, apprev) {","+\t\treturn capName","+\t}"," \tif strings.Contains(capName, \"@\") {"," \t\tsplitName := capName[0:strings.LastIndex(capName, \"@\")]"," \t\tok := false"],"additions":6,"deletions":0,"truncated":false},{"path":"pkg/controller/core.oam.dev/v1beta1/application/revision.go","lines":["@@ -21,6 +21,7 @@ import ("," \t\"encoding/json\""," \t\"sort\""," \t\"strconv\"","+\t\"strings\""," "," \t\"github.com/hashicorp/go-version\""," \t\"github.com/kubevela/pkg/util/k8s\"","@@ -207,6 +208,10 @@ func (h *AppHandler) gatherRevisionSpec(af *appfile.Appfile) (*v1beta1.Applicati"," \t\t\tpd := p.FullTemplate.PolicyDefinition.DeepCopy()"," \t\t\tpd.Status = v1beta1.PolicyDefinitionStatus{}"," \t\t\tappRev.Spec.PolicyDefinitions[p.FullTemplate.PolicyDefinition.Name] = *pd","+\t\t\t// Each pinned revision also goes under its reference, as components do.","+\t\t\tif strings.Contains(p.Reference, \"@\") {","+\t\t\t\tappRev.Spec.PolicyDefinitions[p.Reference] = *pd.DeepCopy()","+\t\t\t}"," \t\t}"," \t}"," \tfor name, def := range af.RelatedComponentDefinitions {"],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/controller/core.oam.dev/v1beta1/application/revision_pinned_test.go","lines":["@@ -0,0 +1,69 @@","+/*","+Copyright 2026 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package application","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/common\"","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\"","+\t\"github.com/oam-dev/kubevela/pkg/appfile\"","+)","+","+// Policies pinning different revisions of one PolicyDefinition each get an","+// entry under their reference, beside the entry under the definition's name.","+func TestRevisionRecordsEachPinnedPolicyRevision(t *testing.T) {","+\tpolicyDef := func(data string) *v1beta1.PolicyDefinition {","+\t\treturn &v1beta1.PolicyDefinition{","+\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"configmap-policy\"},","+\t\t\tSpec: v1beta1.PolicyDefinitionSpec{","+\t\t\t\tSchematic: &common.Schematic{CUE: &common.CUE{Template: data}},","+\t\t\t},","+\t\t}","+\t}","+\tpolicy := func(ref, data string) *appfile.Component {","+\t\treturn &appfile.Component{","+\t\t\tName:         ref,","+\t\t\tReference:    ref,","+\t\t\tFullTemplate: &appfile.Template{PolicyDefinition: policyDef(data)},","+\t\t}","+\t}","+","+\th := &AppHandler{app: &v1beta1.Application{ObjectMeta: metav1.ObjectMeta{Name: \"app\", Namespace: \"default\"}}}","+\taf := &appfile.Appfile{","+\t\tParsedPolicies: []*appfile.Component{","+\t\t\tpolicy(\"configmap-policy@v1\", \"output: revision: 1\"),","+\t\t\tpolicy(\"configmap-policy@v2\", \"output: revision: 2\"),","+\t\t},","+\t\tRelatedComponentDefinitions:    map[string]*v1beta1.ComponentDefinition{},","+\t\tRelatedTraitDefinitions:        map[string]*v1beta1.TraitDefinition{},","+\t\tRelatedWorkflowStepDefinitions: map[string]*v1beta1.WorkflowStepDefinition{},","+\t}","+","+\trev, _, err := h.gatherRevisionSpec(af)","+\trequire.NoError(t, err)","+","+\tdefs := rev.Spec.PolicyDefinitions","+\trequire.Contains(t, defs, \"configmap-policy@v1\")","+\trequire.Contains(t, defs, \"configmap-policy@v2\")","+\trequire.Equal(t, \"output: revision: 1\", defs[\"configmap-policy@v1\"].Spec.Schematic.CUE.Template)","+\trequire.Equal(t, \"output: revision: 2\", defs[\"configmap-policy@v2\"].Spec.Schematic.CUE.Template)","+\trequire.Contains(t, defs, \"configmap-policy\", \"the bare entry stays for readers that look up by name\")","+}"],"additions":69,"deletions":0,"truncated":false},{"path":"pkg/definition/cuetest/testdata/golden/component/worker/a-container-resource-divisor-can-be-a-plain-number.yaml","lines":["@@ -0,0 +1,36 @@","+calls: {}","+output:","+  apiVersion: apps/v1","+  kind: Deployment","+  metadata:","+    annotations: {}","+    labels:","+      app.oam.dev/appRevision: shop-v1","+      app.oam.dev/component: queue","+      app.oam.dev/name: shop","+      app.oam.dev/namespace: default","+      app.oam.dev/resourceType: WORKLOAD","+      workload.oam.dev/type: worker","+    name: queue","+    namespace: default","+  spec:","+    selector:","+      matchLabels:","+        app.oam.dev/component: queue","+    template:","+      metadata:","+        labels:","+          app.oam.dev/component: queue","+          app.oam.dev/name: shop","+      spec:","+        containers:","+        - env:","+          - name: CPU_LIMIT","+            valueFrom:","+              resourceFieldRef:","+                divisor: 1","+                resource: limits.cpu","+  