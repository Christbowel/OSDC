              $deep,","-            );","-        } else {","-            $this->scanFile(","-                $file_path,","-                $this->config->getFiletypeScanners(),","-                isset($this->files_to_deep_scan[$file_path]),","-            );","+        try {","+            if (Perf\\Collector::$enabled) {","+                $deep = isset($this->files_to_deep_scan[$file_path]);","+                $perf_start = Perf\\Collector::fileStart();","+                // what it stays at if the file is not scanned at all","+                Perf\\Collector::setScan('cold', 0);","+                $this->scanFile($file_path, $this->config->getFiletypeScanners(), $deep);","+                Perf\\Collector::scanEnd(","+                    $file_path,","+                    $this->config->shortenFileName($file_path),","+                    $perf_start,","+                    $deep,","+                );","+            } else {","+                $this->scanFile(","+                    $file_path,","+                    $this->config->getFiletypeScanners(),","+                    isset($this->files_to_deep_scan[$file_path]),","+                );","+            }","+        } catch (Throwable $e) {","+            CrashContext::recordFile($e, 'scanning', $file_path);","+            throw $e;","         }","     }"," }"],"additions":24,"deletions":18,"truncated":false},{"path":"src/Psalm/Internal/Crash/CrashContext.php","lines":["@@ -0,0 +1,168 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Psalm\\Internal\\Crash;","+","+use Amp\\Parallel\\Worker\\TaskFailureThrowable;","+use PhpParser\\Node\\Stmt;","+use Psalm\\Internal\\Analyzer\\ClosureAnalyzer;","+use Psalm\\Internal\\Analyzer\\FunctionLikeAnalyzer;","+use Psalm\\Internal\\Analyzer\\StatementsAnalyzer;","+use Throwable;","+use WeakMap;","+","+use function serialize;","+use function unserialize;","+","+/**","+ * What Psalm was doing when an exception was thrown. It is kept beside the exception, not in a wrapper, so that","+ * Psalm's own catches and the tests still get the exception that was thrown.","+ *","+ * @internal","+ */","+final class CrashContext","+{","+    /** @var WeakMap<Throwable, self>|null */","+    private static ?WeakMap $contexts = null;","+","+    /** The interface of the plugin hook that threw */","+    public ?string $hook = null;","+","+    /**","+     * The class of the handler of that hook","+     *","+     * @var class-string|null","+     */","+    public ?string $handler = null;","+","+    /** What Psalm was doing to $file_path: \"scanning\", \"analysing\" */","+    public ?string $activity = null;","+","+    public ?string $file_path = null;","+","+    /** The line of the innermost statement being analysed */","+    public ?int $line = null;","+","+    /** The function, method or closure of that statement */","+    public ?string $function_like = null;","+","+    /**","+     * The innermost hook wins: the exception goes through the hooks that called the one that threw. Psalm's own","+     * hooks are recorded too, so that a plugin hook around them isn't taken for the one that threw.","+     *","+     * @param class-string $handler","+     */","+    public static function recordHook(Throwable $e, string $hook, string $handler): void","+    {","+        $context = self::get($e);","+        if ($context->handler === null) {","+            $context->hook = $hook;","+            $context->handler = $handler;","+        }","+    }","+","+    public static function recordFile(Throwable $e, string $activity, string $file_path): void","+    {","+        $context = self::get($e);","+        $context->activity ??= $activity;","+        $context->file_path ??= $file_path;","+    }","+","+    /**","+     * The innermost statement wins: the exception goes through the statements that contain the one that threw.","+     */","+    public static function recordStatement(Throwable $e, StatementsAnalyzer $statements_analyzer, Stmt $stmt): void","+    {","+        $context = self::get($e);","+        if ($context->line !== null) {","+            return;","+        }","+","+        $context->file_path = $statements_analyzer->getFilePath();","+        $context->line = $stmt->getStartLine();","+","+        $source = $statements_analyzer->getSource();","+        try {","+            $context->function_like = match (true) {","+                $source instanceof ClosureAnalyzer => '{closure}',","+                $source instanceof FunctionLikeAnalyzer => $source->getCorrectlyCasedMethodId(),","+                default => null,","+            };","+        } catch (Throwable) {","+            // the exception being thrown is the one to report","+        }","+    }","+","+    /**","+     * The context of an exception and of the exceptions it wraps","+     */","+    public static function of(Throwable $e): self","+    {","+        $merged = new self();","+        for ($current = $e; $current !== null; $current = $current->getPrevious()) {","+            $context = self::$contexts[$current] ?? null;","+            if ($context === null) {","+                continue;","+            }","+","+            if ($merged->handler === null) {","+                $merged->hook = $context->hook;","+                $merged->handler = $context->handler;","+            }","+","+            $merged->activity ??= $context->activity;","+            if ($merged->line === null && $context->line !== null) {","+                $merged->file_path = $context->file_path;","+                $merged->line = $context->line;","+                $merged->function_like = $context->function_like;","+            } else {","+                $merged->file_path ??= $context->file_path;","+            }","+        }","+","+        return $merged;","+    }","+","+    /**","+     * The exception a worker throws for the parent process, which gets only its class, message, code and trace:","+     * the context travels in the message of a wrapper","+     */","+    public static function forParent(Throwable $e): Throwable","+    {","+        $context = self::of($e);","+","+        return $context->handler === null && $context->file_path === null","+            ? $e","+            : new CrashContextException(serialize($context), $e);","+    }","+","+    /**","+     * The failure of a task in the parent process, with the context the worker sent","+     */","+    public static function fromWorker(TaskFailureThrowable $e): TaskFailureThrowable","+    {","+        $previous = $e->getPrevious();","+        if ($e->getOriginalClassName() !== CrashContextException::class","+            || !$previous instanceof TaskFailureThrowable","+        ) {","+            return $e;","+        }","+","+        /** @var self|false $context the only class it may make */","+        $context = unserialize($e->getOriginalMessage(), ['allowed_classes' => [self::class]]);","+        if ($context instanceof self) {","+            self::$contexts ??= new WeakMap();","+            self::$contexts[$previous] = $context;","+        }","+","+        return $previous;","+    }","+","+    private static function get(Throwable $e): self","+    {","+        self::$contexts ??= new WeakMap();","+","+        return self::$contexts[$e] ??= new self();","+    }","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Crash/CrashContextException.php","lines":["@@ -0,0 +1,24 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Psalm\\Internal\\Crash;","+","+use RuntimeException;","+use Throwable;","+","+/**","+ * Carries the serialized CrashContext of an exception from a worker to the parent process","+ *","+ * @internal","+ */","+final class CrashContextException extends RuntimeException","+{","+    /**","+     * @psalm-mutation-free","+     */","+    public function __construct(string $serialized_context, Throwable $previous)","+    {","+        parent::__construct($serialized_context, 0, $previous);","+    }","+}"],"additions":24,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Crash/CrashReport.php","lines":["@@ -0,0 +1,857 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Psalm\\Internal\\Crash;","+","+use Amp\\Parallel\\Worker\\Task;","+use Amp\\Parallel\\Worker\\TaskFailureThrowable;","+use Closure;","+use Psalm\\Config;","+use Psalm\\Exception\\ConfigException;","+use Psalm\\Internal\\CliUtils;","+use Psalm\\Internal\\FileChangedDuringRunException;","+use Psalm\\Internal\\Fork\\TaskCrashedException;","+use ReflectionClass;","+use RuntimeException;","+use Symfony\\Component\\Filesystem\\Path;","+use Throwable;","+","+use function array_column;","+use function array_map;","+use function array_reverse;","+use function count;","+use function date;","+use function defined;","+use function dirname;","+use function file_put_contents;","+use function function_exists;","+use function fwrite;","+use function get_loaded_extensions;","+use function getenv;","+use function getmypid;","+use function http_build_query;","+use function implode;","+use function is_a;","+use function is_dir;","+use function is_int;","+use function is_string;","+use function is_subclass_of;","+use function ltrim;","+use function mb_strcut;","+use function mkdir;","+use function php_uname;","+use function phpversion;","+use function preg_match;","+use function preg_replace;","+use function realpath;","+use function rtrim;","+use function simplexml_load_file;","+use function sort;","+use function str_contains;","+use function str_starts_with;","+use function strlen;","+use function strpos;","+use function strrpos;","+use function strtolower;","+use function strtr;","+use function substr;","+use function sys_get_temp_dir;","+","+use const DIRECTORY_SEPARATOR;","+use const PHP_EOL;","+use const PHP_INT_MAX;","+use const PHP_OS_FAMILY;","+use const PHP_QUERY_RFC3986;","+use const PHP_VERSION;","+use const STDERR;","+","+/**","+ * The report of an exception that crashed Psalm","+ *","+ * @internal","+ * @psalm-type Package = array{","+ *     name: string,","+ *     version: ?string,","+ *     install_path: string,","+ *     issues: ?string,","+ *     source: ?string,","+ *     plugin_class: ?string","+ * }","+ * @psalm-type Frame = array{file: ?string, line: int, call: string}","+ * @psalm-type Exception = array{class: string, message: string, file: string, line: int, frames: list<Frame>}","+ */","+final class CrashReport","+{","+    private const PSALM_ISSUES = 'https://github.com/vimeo/psalm/issues/new';","+","+    /** VS Code's cap: GitHub answers 414 to longer URLs */","+    private const MAX_URL_LENGTH = 7_500;","+","+    private const MAX_FRAMES = 10;","+","+    /** Errors of the machine Psalm runs on, and what to do about them */","+    private const ENVIRONMENT_ERRORS = [","+        'No space left on device' => 'The disk is full: free some space and run Psalm again',","+        'Too many open files' => 'Psalm has too many files open: raise the limit (ulimit -n) and run Psalm again',","+        'Permission denied' => 'Psalm may not read or write a file: check the permissions of the file in the message',","+        'Read-only file system' => 'Psalm can not write to a read-only file system: check the cache directory',","+    ];","+","+    private readonly CrashContext $context;","+","+    /** @var non-empty-list<Exception> the exception that was thrown first, then the ones it wraps */","+    private readonly array $chain;","+","+    /** @var ?Package */","+    private readonly ?array $plugin_package;","+","+    /** Whether the plugin is only guessed from the frames of the trace */","+    private readonly bool $plugin_guessed;","+","+    /** The crash on a file that Analyzer and Pool report, with a report for the console */","+    private readonly ?TaskCrashedException $task_crash;","+","+    /**","+     * @param list<Package> $packages","+     */","+    public function __construct(","+        private readonly Throwable $throwable,","+        private readonly ?Config $config,","+        private readonly array $packages,","+    ) {","+        $this->context = CrashContext::of($throwable);","+        $this->chain = self::describeChain($throwable);","+","+        $task_crash = null;","+        for ($e = $throwable; $e !== null && $task_crash === null; $e = $e->getPrevious()) {","+            $task_crash = $e instanceof TaskCrashedException ? $e : null;","+        }","+","+        $this->task_crash = $task_crash;","+","+        if ($this->context->handler !== null && str_starts_with($this->context->handler, 'Psalm\\\\Internal\\\\')) {","+            // a hook of Psalm itself (the taint handlers of Config::initializePlugins()) threw: no plugin did","+            $this->context->hook = $this->context->handler = null;","+        }","+","+        $handler_file = $this->context->handler === null ? null : self::getClassFile($this->context->handler);","+        if ($this->context->handler !== null) {","+            $this->plugin_package = $handler_file === null ? null : $this->findPackage($handler_file, false);","+            $this->plugin_guessed = false;","+        } else {","+            $this->plugin_package = $this->guessPluginPackage();","+            $this->plugin_guessed = $this->plugin_package !== null;","+        }","+    }","+","+    /**","+     * Prints the report of the crash and writes the full report to a file. A failure to make either does not hide","+     * the crash.","+     *","+     * @param resource $output","+     */","+    public static function print(Throwable $throwable, string $command_line, $output = STDERR): void","+    {","+        try {","+            $report = self::create($throwable);","+            $summary = $report->getSummary();","+        } catch (Throwable $failure) {","+            fwrite(","+                $output,","+                PHP_EOL . 'Uncaught ' . $throwable->__toString() . PHP_EOL","+                . 'Psalm could not report the crash: ' . $failure->getMessage() . PHP_EOL,","+            );","+","+            return;","+        }","+","+        fwrite($output, PHP_EOL . $summary . PHP_EOL);","+","+        try {","+            $path = $report->writeFile($command_line);","+            if ($path !== null) {","+                fwrite($output, 'Full report: ' . $path . PHP_EOL);","+            }","+        } catch (Throwable $failure) {","+            fwrite($output, 'Psalm could not write the full report: ' . $failure->getMessage() . PHP_EOL);","+        }","+","+        fwrite($output, ($report->getHint() ?? $report->getReportLine()) . PHP_EOL);","+    }","+","+    /**","+     * What the user has to do when the crash is not a bug, as in PHPStan's InternalError::shouldReportBug()","+     *","+     * @psalm-capabilities read-props","+     */","+    public function getHint(): ?string","+    {","+        $config_exception = false;","+        foreach ($this->chain as $exception) {","+            if (is_a($exception['class'], FileChangedDuringRunException::class, true)) {","+                return $exception['message'];","+            }","+","+            foreach (self::ENVIRONMENT_ERRORS as $error => $hint) {","+                if (str_contains($exception['message'], $error)) {","+                    return $hint;","+                }","+            }","+","+            $config_exception = $config_exception || is_a($exception['class'], ConfigException::class, true);","+        }","+","+        // a plugin that fails to load is wrapped in a ConfigException","+        return $config_exception && !$this->isPluginCrash()","+            ? 'Psalm could not load its configuration: fix what the message says and run Psalm again'","+            : null;","+    }","+","+    /**","+     * Where to report the crash, with a link that fills in the report","+     */","+    public function getReportLine(): string","+    {","+        $package = $this->plugin_package;","+        if ($package === null && $this->context->handler !== null) {","+            return 'Report it to