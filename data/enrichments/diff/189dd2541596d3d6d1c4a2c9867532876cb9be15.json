,"+","+/// The limit of the legacy backend; the shared one bounds the kind by its pool.","+pub const CONDITION_CACHE_BYTES: usize = 256 * 1024 * 1024;","+","+/// The rows of a block a filter selects, kept exactly when few rows pass and as granules","+/// otherwise, so that an entry takes at most a few KiB.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub enum BlockCondition {","+    /// No row.","+    Nothing,","+    /// Every row.","+    All,","+    /// The offsets of the rows, ascending.","+    Rows(Box<[u32]>),","+    /// For each granule of `granule_rows` rows, whether the filter selects a row in it: a","+    /// superset of the rows.","+    Granules { granule_rows: u32, bits: Box<[u64]> },","+}","+","+impl CachedItem for BlockCondition {","+    fn mem_bytes(&self) -> usize {","+        size_of::<Self>()","+            + match self {","+                BlockCondition::Nothing | BlockCondition::All => 0,","+                BlockCondition::Rows(rows) => rows.len() * size_of::<u32>(),","+                BlockCondition::Granules { bits, .. } => bits.len() * size_of::<u64>(),","+            }","+    }","+}","+"," /// Pruning results of deterministic scans (`enable_prune_cache`)."," pub struct PruneResult;"," "],"additions":39,"deletions":0,"truncated":false},{"path":"src/query/storages/common/cache/src/legacy/builtin.rs","lines":["@@ -90,6 +90,9 @@ impl LegacyKinds {","                 \"table_prune_partitions_count\",","                 |c, _| c.table_prune_partitions_count,","             ))","+            .register::<table::Condition>(LegacyKind::bytes(\"\", |_, _| {","+                table::CONDITION_CACHE_BYTES as u64","+            }))","             .register::<bloom::Filter>(LegacyKind::bytes(","                 \"table_bloom_index_filter_size\",","                 |c, _| c.table_bloom_index_filter_size,"],"additions":3,"deletions":0,"truncated":false},{"path":"src/query/storages/common/cache/src/lib.rs","lines":["@@ -90,6 +90,7 @@ pub use kinds::column::Col