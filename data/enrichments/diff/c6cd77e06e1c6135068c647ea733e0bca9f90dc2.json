{"id":"c6cd77e06e1c6135068c647ea733e0bca9f90dc2","axis":"silent","repo":"symfony/symfony","sha":"c6cd77e06e1c6135068c647ea733e0bca9f90dc2","parsed":{"files":[{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineDbal/README.md","lines":["@@ -80,6 +80,9 @@ When `key_management.store` is configured, this is the store-backed encrypter, a"," Otherwise, this is the encrypter of the default client, and `key` names a master key."," The bundle declares the types when the kernel boots."," ","+With the Doctrine ORM, you don't need to declare these types.","+Mark the property with the `#[Encrypted]` attribute of `symfony/doctrine-orm-key-management` instead, and the bundle registers the type of the column for you.","+"," Booting is early enough for every entry point at once, the front controller,"," the console with its schema tool and its migrations, and the test kernel, and"," it costs nothing: a DBAL connection only reaches the database on its first"],"additions":3,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/Attribute/Encrypted.php","lines":["@@ -0,0 +1,40 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Attribute;","+","+/**","+ * Encrypts the column of a property at rest.","+ *","+ *     #[ORM\\Column(nullable: true)]","+ *     #[Encrypted(key: 'speaker.contact')]","+ *     public ?string $phone = null;","+ *","+ * The column keeps the type its mapping gives it, declared on the column or guessed from the type of the property.","+ * The value is converted by that type first, then encrypted, and the column is stored as a binary one.","+ *","+ * {@see \\Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\EventListener\\EncryptedColumnListener} gives the column the encrypted type registered for its key and its type.","+ *","+ * @author Nicolas Grekas <p@tchwork.com>","+ *","+ * @experimental","+ */","+#[\\Attribute(\\Attribute::TARGET_PROPERTY)]","+final class Encrypted","+{","+    /**","+     * @param string $key The master key encrypting the values, or the scope of their data key when the encrypter uses a data key store","+     */","+    public function __construct(","+        public string $key,","+    ) {","+    }","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/DependencyInjection/RegisterEncryptedColumnsPass.php","lines":["@@ -0,0 +1,121 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\DependencyInjection;","+","+use Doctrine\\ORM\\Mapping\\Column;","+use Doctrine\\ORM\\Mapping\\DefaultTypedFieldMapper;","+use Doctrine\\ORM\\Mapping\\Embeddable;","+use Doctrine\\ORM\\Mapping\\Entity;","+use Doctrine\\ORM\\Mapping\\MappedSuperclass;","+use Symfony\\Component\\DependencyInjection\\ChildDefinition;","+use Symfony\\Component\\DependencyInjection\\Compiler\\CompilerPassInterface;","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Attribute\\Encrypted;","+","+/**","+ * Registers an encrypted type for each key and type of the columns marked with {@see Encrypted}.","+ *","+ * The types must be registered when the kernel boots, before any metadata is loaded, so they are collected when the container is compiled.","+ * {@see self::autoconfigure()} tags the entities, embeddables and mapped superclasses that the container loads with their encrypted columns.","+ * This pass then adds one type per key and type to the types declared in \"key_management.doctrine_dbal.types\".","+ * A declared type is used for the columns of its key and type, instead of registering another one.","+ *","+ * {@see \\Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\EventListener\\EncryptedColumnListener} gets the names of all these types.","+ *","+ * @author Nicolas Grekas <p@tchwork.com>","+ *","+ * @experimental","+ */","+final class RegisterEncryptedColumnsPass implements CompilerPassInterface","+{","+    private const string TAG = 'key_management.encrypted_column';","+    private const string LISTENER = 'key_management.encrypted_column_listener';","+    private const string TYPES = 'key_management.doctrine_dbal.encrypted_types';","+","+    /**","+     * Tags a class mapped by the ORM with the key and the type of each of its encrypted columns.","+     *","+     * The type is the one that the ORM gives to the column.","+     * It's the type declared on the column, or the type guessed from the type of the property.","+     * The parent classes are read too, since a parent can be outside of the directories the container loads, or not mapped by the ORM.","+     */","+    public static function autoconfigure(ChildDefinition $definition, Entity|Embeddable|MappedSuperclass $mapping, \\ReflectionClass $class): void","+    {","+        for ($reflection = $class; $reflection; $reflection = $reflection->getParentClass()) {","+            foreach ($reflection->getProperties() as $property) {","+                if ($property->class !== $reflection->name || !$attribute = $property->getAttributes(Encrypted::class)[0] ?? null) {","+                    continue;","+                }","+","+                $definition->addResourceTag(self::TAG, ['key' => $attribute->newInstance()->key, 'type' => self::typeOf($property)]);","+            }","+        }","+    }","+","+    public function process(ContainerBuilder $container): void","+    {","+        if (!$container->hasDefinition(self::LISTENER)) {","+            return;","+        }","+","+        $types = $container->hasDefinition(self::TYPES) ? $container->getDefinition(self::TYPES)->getArgument(1) : null;","+","+        $names = [];","+        foreach ($types ?? [] as $name => $type) {","+            $names[$type['key']][$type['type']] ??= $name;","+        }","+","+        foreach ($container->findTaggedResourceIds(self::TAG, false) as $id => $tags) {","+            foreach ($tags as ['key' => $key, 'type' => $type]) {","+                if (isset($names[$key][$type])) {","+                    continue;","+                }","+","+                if (null === $types) {","+                    throw new \\LogicException(\\sprintf('The encrypted columns of \"%s\" need an envelope encrypter: configure \"key_management.store\", or set \"key_management.default_client\".', $container->getDefinition($id)->getClass()));","+                }","+","+                $name = 'encrypted_'.$type.'@'.$key;","+","+                if (isset($types[$name])) {","+                    throw new \\LogicException(\\sprintf('The encrypted type \"%s\" is configured to wrap the \"%s\" type under the key \"%s\", but that name is the one given to the encrypted columns of type \"%s\" under that key. Rename it.', $name, $types[$name]['type'], $types[$name]['key'], $type));","+                }","+","+                $types[$name] = ['type' => $type, 'key' => $key];","+                $names[$key][$type] = $name;","+            }","+        }","+","+        $container->getDefinition(self::LISTENER)->setArgument(0, $names);","+","+        if (!$types) {","+            $container->removeDefinition(self::TYPES);","+        } else {","+            $container->getDefinition(self::TYPES)->setArgument(1, $types);","+        }","+    }","+","+    private static function typeOf(\\ReflectionProperty $property): string","+    {","+        $mapping = ['fieldName' => $property->name];","+","+        if (null !== $type = ($property->getAttributes(Column::class)[0] ?? null)?->newInstance()->type) {","+            $mapping['type'] = $type;","+        }","+","+        if ($property->hasType()) {","+            $mapping = (new DefaultTypedFieldMapper())->validateAndComplete($mapping, $property);","+        }","+","+        return $mapping['type'] ?? 'string';","+    }","+}"],"additions":121,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/EventListener/EncryptedColumnListener.php","lines":["@@ -0,0 +1,73 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\EventListener;","+","+use Doctrine\\ORM\\Event\\LoadClassMetadataEventArgs;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Attribute\\Encrypted;","+","+/**","+ * Gives the columns marked with {@see Encrypted} the encrypted type registered for their key and their type.","+ *","+ * It runs when the metadata of a class is loaded, so the metadata cache keeps the encrypted type.","+ * This is also why the listener doesn't register the types. It never runs when the cache is warm.","+ * The types must be registered before the first query, as the KeyManagementBundle does when the kernel boots.","+ *","+ * A column inherited from a parent class, or inlined from an embeddable, got its type when the metadata of that class was loaded.","+ *","+ * @author Nicolas Grekas <p@tchwork.com>","+ *","+ * @experimental","+ */","+final class EncryptedColumnListener","+{","+    /**","+     * @param array<string, array<string, string>> $types The names of the encrypted types, by key and by the type they wrap","+     */","+    public function __construct(","+        private readonly array $types,","+    ) {","+    }","+","+    public function loadClassMetadata(LoadClassMetadataEventArgs $event): void","+    {","+        $metadata = $event->getClassMetadata();","+        $class = $metadata->getName();","+        $seen = [];","+","+        for ($reflection = $metadata->getReflectionClass(); $reflection; $reflection = $reflection->getParentClass()) {","+            foreach ($reflection->getProperties() as $property) {","+                if (isset($seen[$property->name])) {","+                    continue;","+                }","+                $seen[$property->name] = true;","+","+                if (!$attribute = $property->getAttributes(Encrypted::class)[0] ?? null) {","+                    continue;","+                }","+","+                if (!$metadata->hasField($property->name)) {","+                    throw new \\LogicException(\\sprintf('The property \"%s::$%s\" has the \"%s\" attribute but is not a mapped column. Only the value of a column can be encrypted.', $class, $property->name, Encrypted::class));","+                }","+","+                $mapping = $metadata->getFieldMapping($property->name);","+","+                if (isset($mapping->declared)) {","+                    continue;","+                }","+","+                $key = $attribute->newInstance()->key;","+","+                $mapping->type = $this->types[$key][$mapping->type] ?? throw new \\LogicException(\\sprintf('No encrypted type is registered for the key \"%s\" and the \"%s\" type of \"%s::$%s\". The KeyManagementBundle registers the types of the \"%s\" attributes it finds in the \"resource\" directories of your services: check that \"%s\" is there and not excluded, or declare an encrypted type with that key and type in \"key_management.doctrine_dbal.types\".', $key, $mapping->type, $class, $property->name, Encrypted::class, $class));","+            }","+        }","+    }","+}"],"additions":73,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/README.md","lines":["@@ -1,7 +1,8 @@"," Symfony Doctrine ORM Key Management Bridge"," =========================================="," ","-Connects `symfony/key-management` to the Doctrine ORM: a `#[BlindIndexed]` attribute","+Connects `symfony/key-management` to the Doctrine ORM: an `#[Encrypted]` attribute","+that encrypts the column of a property, a `#[BlindIndexed]` attribute"," whose listener fills the blind index of a property on every flush, and a schema"," listener declaring the table the data key store of"," `symfony/doctrine-dbal-key-management` needs.","@@ -11,6 +12,68 @@ listener declaring the table the data key store of"," are not covered by Symfony's"," [Backward Compatibility Promise](https://symfony.com/doc/current/contributing/code/bc.html)."," ","+Encrypted columns","+-----------------","+","+The `#[Encrypted]` attribute encrypts the column of a property at rest:","+","+```php","+use Doctrine\\ORM\\Mapping as ORM;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Attribute\\Encrypted;","+","+#[ORM\\Column(nullable: true)]","+#[Encrypted(key: 'speaker.contact')]","+public ?string $phone = null;","+```","+","+The column keeps the type of its mapping, `string` here.","+That type converts the value first, then the value is encrypted under the key.","+The column is stored as a binary one.","+When the encrypter uses a data key store, the key is the scope of the data key.","+","+`EncryptedColumnListener` gives each of these columns the encrypted type registered for its key and its type.","+It runs when the metadata of a class is loaded, so the metadata cache keeps that type.","+This is why the listener doesn't register the types.","+They must be registered before the first query.","+The listener gets the names of the types, by key and by the type they wrap:","+","+```php","+use Doctrine\\DBAL\\Types\\StringType;","+use Doctrine\\DBAL\\Types\\Type;","+use Doctrine\\ORM\\Events;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineDbal\\EncryptedType;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\EventListener\\EncryptedColumnListener;","+","+Type::getTypeRegistry()->register('app_speaker_contact', new EncryptedType(new StringType(), $encrypter, 'speaker.contact'));","+","+$eventManager->addEventListener(Events::loadClassMetadata, new EncryptedColumnListener([","+    'speaker.contact' => ['string' => 'app_speaker_contact'],","+]));","+```","+","+Loading the metadata of a class fails when no encrypted type is registered for the key and the type of a column.","+It also fails when the attribute is on a property that is not a mapped column.","+","+In a Symfony application, the `KeyManagementBundle` registers the types when the kernel boots.","+When the container is compiled, the bundle finds the `#[Encrypted]` columns and registers one type per key and type.","+It looks for these columns in the entities, embeddables and mapped superclasses found in the `resource` directories of your services.","+With the default `App\\:` resource, this covers `src/Entity/`.","+The types encrypt with the encrypter `EnvelopeEncrypterInterface` resolves to, like the ones of `key_management.doctrine_dbal.types`.","+A type declared there is used for the columns of its key and type, instead of registering another one.","+","+The type of a column is read from its `#[ORM\\Column]` attribute, or guessed from the type of the property, as the ORM does by default.","+The container misses the columns of an entity that your services exclude, or that is mapped in XML.","+It can also guess another type than the ORM when you use a custom typed field mapper.","+Loading the metadata of such an entity fails, `cache:warmup` included.","+Declare its types in `key_management.doctrine_dbal.types`, and the attribute uses them:","+","+```yaml","+key_management:","+    doctrine_dbal:","+        types:","+            speaker_contact: { type: string, key: speaker.contact }","+```","+"," Blind indexes"," -------------"," "],"additions":64,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/Tests/DependencyInjection/RegisterEncryptedColumnsPassTest.php","lines":["@@ -0,0 +1,166 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\DependencyInjection;","+","+use Doctrine\\ORM\\Mapping\\Embeddable;","+use Doctrine\\ORM\\Mapping\\Entity;","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\DependencyInjection\\ChildDefinition;","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+use Symfony\\Component\\DependencyInjection\\Reference;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineDbal\\EncryptedTypes;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\DependencyInjection\\RegisterEncryptedColumnsPass;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\EventListener\\EncryptedColumnListener;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\Fixtures\\EncryptedColumnsAddress;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\Fixtures\\EncryptedColumnsEntity;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\Fixtures\\PlainEntity;","+","+class RegisterEncryptedColumnsPassTest extends TestCase","+{","+    public function testAClassIsTaggedWithTheKeyAndTheTypeOfEachEncryptedColumn()","+    {","+        $definition = new ChildDefinition('');","+","+        RegisterEncryptedColumnsPass::autoconfigure($definition, new Entity(), new \\ReflectionClass(EncryptedColumnsEntity::class));","+","+        $this->assertSame([","+            ['key' => 'person.contact', 'type' => 'string'],","+            ['key' => 'person.contact', 'type' => 'text'],","+            ['key' => 'person.contact', 'type' => 'datetime_immutable'],","+            ['key' => 'person.email', 'type' => 'string'],","+        ], $definition->getTag('key_management.encrypted_column'));","+        $this->assertTrue($definition->hasTag('container.excluded'), 'an entity is a resource, not a service.');","+    }","+","+    public function testAnEmbeddableIsTaggedLikeAnEntity()","+    {","+        $definition = new ChildDefinition('');","+","+        RegisterEncryptedColumnsPass::autoconfigure($definition, new Embeddable(), new \\ReflectionClass(EncryptedColumnsAddress::class));","+","+        $this->assertSame([['key' => 'person.address', 'type' => 'string']], $definition->getTag('key_management.encrypted_column'));","+    }","+","+    public function testAClassWithoutEncryptedColumnIsLeftAlone()","+    {","+        $definition = new ChildDefinition('');","+","+        RegisterEncryptedColumnsPass::autoconfigure($definition, new Entity(), new \\ReflectionClass(PlainEntity::class));","+","+        $this->assertSame([], $definition->getTags());","+    }","+","+    public function testEachKeyAndTypeGetsOneEncryptedType()","+    {","+        $container = $this->createContainer([]);","+        $container->register('.abstract.person', EncryptedColumnsEntity::class)","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'string'])","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'text']);","+        $container->register('.abstract.address', EncryptedColumnsAddress::class)","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'string']);","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+","+        $this->assertSame([","+            'encrypted_string@person.contact' => ['type' => 'string', 'key' => 'person.contact'],","+            'encrypted_text@person.contact' => ['type' => 'text', 'key' => 'person.contact'],","+        ], $container->getDefinition('key_management.doctrine_dbal.encrypted_types')->getArgument(1));","+        $this->assertSame(['person.contact' => [","+            'string' => 'encrypted_string@person.contact',","+            'text' => 'encrypted_text@person.contact',","+        ]], $container->getDefinition('key_management.encrypted_column_listener')->getArgument(0));","+    }","+","+    public function testAConfiguredTypeServesTheColumnsOfItsKeyAndType()","+    {","+        $container = $this->createContainer(['speaker_contact' => ['type' => 'string', 'key' => 'person.contact']]);","+        $container->register('.abstract.person', EncryptedColumnsEntity::class)","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'string'])","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'text']);","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+","+        $this->assertSame([","+            'speaker_contact' => ['type' => 'string', 'key' => 'person.contact'],","+            'encrypted_text@person.contact' => ['type' => 'text', 'key' => 'person.contact'],","+        ], $container->getDefinition('key_management.doctrine_dbal.encrypted_types')->getArgument(1));","+        $this->assertSame(['person.contact' => [","+            'string' => 'speaker_contact',","+            'text' => 'encrypted_text@person.contact',","+        ]], $container->getDefinition('key_management.encrypted_column_listener')->getArgument(0));","+    }","+","+    public function testTheConfiguredTypesAreKnownToTheListenerWithoutAnyEncryptedColumn()","+    {","+        $container = $this->createContainer(['speaker_contact' => ['type' => 'string', 'key' => 'person.contact']]);","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+","+        $this->assertSame(['person.contact' => ['string' => 'speaker_contact']], $container->getDefinition('key_management.encrypted_column_listener')->getArgument(0));","+    }","+","+    public function testTheEncryptedTypesGoWhenNothingNeedsThem()","+    {","+        $container = $this->createContainer([]);","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+","+        $this->assertFalse($container->hasDefinition('key_management.doctrine_dbal.encrypted_types'));","+        $this->assertTrue($container->hasDefinition('key_management.encrypted_column_listener'), 'the listener reports an encrypted column the container did not find.');","+    }","+","+    public function testAnEncryptedColumnNeedsAnEnvelopeEncrypter()","+    {","+        $container = $this->createContainer(null);","+        $container->register('.abstract.person', EncryptedColumnsEntity::class)","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'string']);","+","+        $this->expectException(\\LogicException::class);","+        $this->expectExceptionMessage(\\sprintf('The encrypted columns of \"%s\" need an envelope encrypter: configure \"key_management.store\", or set \"key_management.default_client\".', EncryptedColumnsEntity::class));","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+    }","+","+    public function testAConfiguredTypeCannotTakeTheNameOfAnotherOne()","+    {","+        $container = $this->createContainer(['encrypted_text@person.contact' => ['type' => 'string', 'key' => 'person.contact']]);","+        $container->register('.abstract.person', EncryptedColumnsEntity::class)","+            ->addResourceTag('key_management.encrypted_column', ['key' => 'person.contact', 'type' => 'text']);","+","+        $this->expectException(\\LogicException::class);","+        $this->expectExceptionMessage('The encrypted type \"encrypted_text@person.contact\" is configured to wrap the \"string\" type under the key \"person.contact\", but that name is the one given to the encrypted columns of type \"text\" under that key. Rename it.');","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+    }","+","+    public function testNothingHappensWithoutTheListener()","+    {","+        $container = new ContainerBuilder();","+        $container->register('key_management.doctrine_dbal.encrypted_types', EncryptedTypes::class)->setArguments([new Reference('app.envelopes'), []]);","+","+        (new RegisterEncryptedColumnsPass())->process($container);","+","+        $this->assertTrue($container->hasDefinition('key_management.doctrine_dbal.encrypted_types'));","+    }","+","+    private function createContainer(?array $types): ContainerBuilder","+    {","+        $container = new ContainerBuilder();","+        $container->register('key_management.encrypted_column_listener', EncryptedColumnListener::class)->setArguments([[]]);","+","+        if (null !== $types) {","+            $container->register('key_management.doctrine_dbal.encrypted_types', EncryptedTypes::class)->setArguments([new Reference('app.envelopes'), $types]);","+        }","+","+        return $container;","+    }","+}"],"additions":166,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/Tests/EventListener/EncryptedColumnListenerTest.php","lines":["@@ -0,0 +1,162 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\EventListener;","+","+use Doctrine\\Common\\EventManager;","+use Doctrine\\DBAL\\Connection;","+use Doctrine\\DBAL\\DriverManager;","+use Doctrine\\DBAL\\Schema\\DefaultSchemaManagerFactory;","+use Doctrine\\DBAL\\Types\\Type;","+use Doctrine\\ORM\\Configuration;","+use Doctrine\\ORM\\EntityManager;","+use Doctrine\\ORM\\EntityManagerInterface;","+use Doctrine\\ORM\\Events;","+use Doctrine\\ORM\\Mapping\\Driver\\AttributeDriver;","+use Doctrine\\ORM\\ORMSetup;","+use Doctrine\\ORM\\Tools\\SchemaTool;","+use PHPUnit\\Framework\\Attributes\\RequiresPhpExtension;","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\Cache\\Adapter\\ArrayAdapter;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineDbal\\EncryptedType;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\EventListener\\EncryptedColumnListener;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\Fixtures\\EncryptedColumnsEntity;","+use Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\Tests\\Fixtures\\EncryptedUnmappedPropertyEntity;","+use Symfony\\Component\\KeyManagement\\Envelope;","+use Symfony\\Component\\KeyManagement\\EnvelopeEncrypter;","+use Symfony\\Component\\KeyManagement\\Test\\InMemoryKms;","+","+#[RequiresPhpExtension('pdo_sqlite')]","+class EncryptedColumnListenerTest extends TestCase","+{","+    private const array TYPES = [","+        'person.contact' => [","+            'string' => 'key_management_test_contact',","+            'text' => 'key_management_test_contact_text',","+            'datetime_immutable' => 'key_management_test_contact_date',","+        ],","+        'person.email' => ['string' => 'key_management_test_email'],","+        'person.address' => ['string' => 'key_management_test_address'],","+    ];","+","+    private Connection $connection;","+    private Configuration $config;","+","+    protected function setUp(): void","+    {","+        $this->connection = DriverManager::getConnection(['driver' => 'pdo_sqlite', 'memory' => true]);","+","+        $registry = method_exists($this->connection->getConfiguration(), 'getTypeProvider') ? $this->connection->getConfiguration()->getTypeProvider() : Type::getTypeRegistry();","+        $envelopes = new EnvelopeEncrypter(new InMemoryKms());","+        foreach (self::TYPES as $key => $types) {","+            foreach ($types as $type => $name) {","+                $encryptedType = new EncryptedType($registry->get($type), $envelopes, $key);","+                $registry->has($name) ? $registry->override($name, $encryptedType) : $registry->register($name, $encryptedType);","+            }","+        }","+","+        $this->config = ORMSetup::createConfiguration(true);","+        $this->config->setMetadataDriverImpl(new AttributeDriver([__DIR__.'/../Fixtures'], true));","+        $this->config->setSchemaManagerFactory(new DefaultSchemaManagerFactory());","+        $this->config->enableNativeLazyObjects(true);","+    }","+","+    public function testAnEncryptedColumnTakesTheTypeOfItsKeyAndOfTheTypeItHadBefore()","+    {","+        $metadata = $this->entityManager()->getClassMetadata(EncryptedColumnsEntity::class);","+","+        $this->assertSame('key_management_test_contact', $metadata->getTypeOfField('phone'));","+        $this->assertSame('key_management_test_contact_text', $metadata->getTypeOfField('notes'));","+        $this->assertSame('key_management_test_contact_date', $metadata->getTypeOfField('birthday'));","+        $this->assertSame('key_management_test_email', $metadata->getTypeOfField('email'), 'a column of a mapped superclass is encrypted in the entities extending it.');","+        $this->assertSame('key_management_test_address', $metadata->getTypeOfField('address.street'), 'a column of an embeddable is encrypted in the entities embedding it.');","+        $this->assertSame('string', $metadata->getTypeOfField('name'));","+    }","+","+    public function testTheValuesAreEncryptedAtRestAndReadBack()","+    {","+        $entityManager = $this->entityManager();","+        (new SchemaTool($entityManager))->createSchema([$entityManager->getClassMetadata(EncryptedColumnsEntity::class)]);","+","+        $person = (new EncryptedColumnsEntity())->setNotes('Prefers trains')->setEmail('ada@example.org');","+        $person->phone = '+33 6 12 34 56 78';","+        $person->birthday = new \\DateTimeImmutable('1815-12-10 00:00:00');","+        $person->address->street = '12 St James Square';","+        $person->name = 'Ada';","+        $entityManager->persist($person);","+        $entityManager->flush();","+        $entityManager->clear();","+","+        $row = $this->connection->fetchAssociative('SELECT phone, notes, birthday, email, address_street, name FROM EncryptedColumnsEntity');","+        foreach (['phone', 'notes', 'birthday', 'email', 'address_street'] as $column) {","+            $this->assertInstanceOf(Envelope::class, Envelope::fromBytes($row[$column]), \\sprintf('the \"%s\" column holds an envelope.', $column));","+        }","+        $this->assertSame('Ada', $row['name']);","+","+        $person = $entityManager->find(EncryptedColumnsEntity::class, $person->id);","+","+        $this->assertSame('+33 6 12 34 56 78', $person->phone);","+        $this->assertSame('Prefers trains', $person->getNotes());","+        $this->assertEquals(new \\DateTimeImmutable('1815-12-10 00:00:00'), $person->birthday);","+        $this->assertSame('ada@example.org', $person->getEmail());","+        $this->assertSame('12 St James Square', $person->address->street);","+    }","+","+    public function testTheSchemaToolsDeclareABinaryColumnAndFindNothingToUpdateAfterwards()","+    {","+        $entityManager = $this->entityManager();"],"additions":115,"deletions":0,"truncated":false}],"additions":582,"deletions":1,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-13T15:28:42.945056+00:00"}