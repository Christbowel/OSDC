{"id":"79db1892054e4867baae8a783d8e1b718a8961d3","axis":"silent","repo":"pnpm/pnpm","sha":"79db1892054e4867baae8a783d8e1b718a8961d3","parsed":{"files":[{"path":".changeset/wasm-binary-streams.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm in StackBlitz WebContainers now passes HTTP response bodies and subprocess output to its WebAssembly engine as raw bytes. A 64 KiB chunk no longer becomes a 234 KB JSON message [pnpm/tasks#63](https://github.com/pnpm/tasks/issues/63)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/doctor/scripts.rs","lines":["@@ -27,7 +27,6 @@ use pnpm_executor::{"," };"," use std::{","     collections::HashSet,","-    env,","     ffi::OsStr,","     fmt::Write as _,","     fs,","@@ -66,7 +65,7 @@ struct UnusableNode {"," pub(super) fn check_node_on_path(path: Option<&OsStr>) -> CheckResult {","     let title = \"Node.js on PATH\";","     let dirs: Vec<PathBuf> = path","-        .map(env::split_paths)","+        .map(pnpm_fs::split_paths)","         .map(Iterator::collect)","         .unwrap_or_default();","     let (usable, unusable) = find_node_entries(&dirs);"],"additions":1,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/lib.rs","lines":["@@ -51,6 +51,9 @@ mod stdio_inheritance;"," mod virtual_terminal;"," mod with_current;"," ","+#[cfg(test)]","+mod wasm_command_inventory;","+"," use boolean_negations::with_boolean_negations;"," use clap::{","     CommandFactory,"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/wasm_command_inventory.rs","lines":["@@ -0,0 +1,115 @@","+use crate::cli_args::CliArgs;","+use clap::CommandFactory;","+use std::collections::{","+    BTreeMap,","+    BTreeSet,","+};","+","+const COMMANDS: &str = include_str!(\"../../../wasm/webcontainer-commands.tsv\");","+","+#[test]","+fn every_clap_command_has_a_webcontainer_classification() {","+    let rows = COMMANDS","+        .lines()","+        .skip(1)","+        .map(|line| {","+            let fields = line.split('\\t').collect::<Vec<_>>();","+            assert_eq!(fields.len(), 3, \"invalid command inventory row: {line}\");","+            assert!(matches!(fields[1], \"partial\" | \"routed\" | \"none\"));","+            assert!(","+                fields[0].starts_with(\"mode:\") || fields[1] != \"none\",","+                \"every CLI command must be exercised by the WebContainer routing audit: {line}\",","+            );","+            assert!(matches!(","+                fields[2],","+                \"available\" | \"host-limited\" | \"host-blocked\" | \"implementation-gap\"","+            ));","+            (fields[0].to_owned(), fields[1].to_owned(), fields[2].to_owned())","+        })","+        .collect::<Vec<_>>();","+    let classifications = rows","+        .iter()","+        .filter(|(path, _, _)| !path.starts_with(\"mode:\"))","+        .map(|(path, coverage, capability)| (path.clone(), (coverage.clone(), capability.clone())))","+        .collect::<BTreeMap<_, _>>();","+    let unique_keys = rows","+        .iter()","+        .map(|(path, _, _)| path)","+        .collect::<BTreeSet<_>>();","+    assert_eq!(unique_keys.len(), rows.len(), \"inventory keys must be unique\");","+","+    let mut actual = BTreeSet::new();","+    collect_commands(&CliArgs::command(), \"\", &mut actual);","+    let classified = classifications","+        .keys()","+        .cloned()","+        .collect::<BTreeSet<_>>();","+    assert_eq!(","+        actual, classified,","+        \"update pnpm/wasm/webcontainer-commands.tsv for the Clap command tree\",","+    );","+","+    for (classification, expected) in [","+        (\"host-blocked\", BTreeSet::from([\"pack-app\"])),","+        (\"implementation-gap\", BTreeSet::from([\"self-update\", \"setup\", \"with\"])),","+        (\"host-limited\", BTreeSet::from([\"bugs\", \"docs\", \"env\", \"login\", \"repo\", \"runtime\"])),","+    ] {","+        assert_eq!(","+            classifications","+                .iter()","+                .filter(|(path, (_, actual))| {","+                    !path.starts_with(\"alias:\") && actual == classification","+                })","+                .map(|(path, _)| path.as_str())","+                .collect::<BTreeSet<_>>(),","+            expected,","+        );","+    }","+","+    let modes = rows","+        .iter()","+        .filter(|(path, _, _)| path.starts_with(\"mode:\"))","+        .map(|(path, _, _)| path.as_str())","+        .collect::<BTreeSet<_>>();","+    assert_eq!(","+        modes,","+        BTreeSet::from([","+            \"mode:auth-and-registry-operations\",","+            \"mode:cargo-workspace-management\",","+            \"mode:command-overriding-script\",","+            \"mode:custom-network-controls\",","+            \"mode:external-script-dispatch\",","+            \"mode:filter-selection\",","+            \"mode:global-install\",","+            \"mode:interactive-terminal\",","+            \"mode:lifecycle-scripts\",","+            \"mode:metadata-rollback\",","+            \"mode:native-dependency-builds\",","+            \"mode:package-manager-version-switch\",","+            \"mode:permission-inheritance-race\",","+            \"mode:pnpm-pm-dispatch\",","+            \"mode:pnpmfile-hooks\",","+            \"mode:provenance-signing\",","+            \"mode:publish-registry\",","+            \"mode:redirect-authentication\",","+            \"mode:recursive-execution\",","+            \"mode:store-linkers\",","+            \"mode:watch-and-cancellation\",","+        ]),","+    );","+}","+","+fn collect_commands(command: &clap::Command, prefix: &str, paths: &mut BTreeSet<String>) {","+    for child in command.get_subcommands() {","+        let path = if prefix.is_empty() {","+            child.get_name().to_owned()","+        } else {","+            format!(\"{prefix} {}\", child.get_name())","+        };","+        paths.insert(path.clone());","+        for alias in child.get_all_al