");","+        byte[] msg = new byte[45];","+        for (int i = 0; i != msg.length; i++)","+        {","+            msg[i] = (byte)(i + 1);","+        }","+","+        CCMBlockCipher enc = new CCMBlockCipher(AESEngine.newInstance());","+        enc.init(true, new AEADParameters(new KeyParameter(key), 128, nonce));","+        enc.processAADBytes(msg, 0, 13);","+        enc.processBytes(msg, 0, msg.length, null, 0);","+        byte[] ct = new byte[enc.getOutputSize(0)];","+        int ctLen = enc.doFinal(ct, 0);","+","+        checkCleared(enc, \"data\", msg.length);","+        checkCleared(enc, \"associatedText\", 13);","+","+        // the cipher still works after the clearing reset: the same message gives the same ciphertext","+        enc.processAADBytes(msg, 0, 13);","+        enc.processBytes(msg, 0, msg.length, null, 0);","+        byte[] ct2 = new byte[enc.getOutputSize(0)];","+        isEquals(ctLen, enc.doFinal(ct2, 0));","+        isTrue(\"ciphertext changed after reset\", Arrays.areEqual(ct, ct2));","+","+        CCMBlockCipher dec = new CCMBlockCipher(AESEngine.newInstance());","+        dec.init(false, new AEADParameters(new KeyParameter(key), 128, nonce));","+        dec.processAADBytes(msg, 0, 13);","+        dec.processBytes(ct, 0, ctLen, null, 0);","+        byte[] pt = new byte[dec.getOutputSize(0)];","+        isEquals(msg.length, dec.doFinal(pt, 0));","+        isTrue(\"decryption failed after buffer clearing\", Arrays.areEqual(msg, pt));","+","+        checkCleared(dec, \"data\", ctLen);","+        checkCleared(dec, \"associatedText\", 13);","+    }","+","+    private void checkCleared(CCMBlockCipher cipher, String fieldName, int len)","+        throws Exception","+    {","+        java.lang.reflect.Field f = CCMBlockCipher.class.getDeclaredField(fieldName);","+        f.setAccessible(true);","+        java.io.ByteArrayOutputStream bOut = (java.io.ByteArrayOutputStream)f.get(cipher);","+","+        isEquals(fieldName + \" not reset\", 0, bOut.size());","+","+        java.lang.reflect.Method getBuffer = bOut.getClass().getDeclaredMethod(\"getBuffer\", new Class[0]);","+        getBuffer.setAccessible(true);","+        byte[] buf = (byte[])getBuffer.invoke(bOut, new Object[0]);","+","+        isTrue(fieldName + \" not cleared\", Arrays.areAllZeroes(buf, 0, len));","+    }","+","     public void performTest()","         throws Exception","     {","@@ -67,6 +127,8 @@ public void performTest()"," ","         ivParamTest(0, ccm, K1, N1);"," ","+        bufferClearingTest();","+","         //","         // 4 has a reduced associated text which needs to be replicated","         //"],"additions":62,"deletions":0,"truncated":false},{"path":"core/src/test/java/org/bouncycastle/crypto/test/EngineRekeyClearTest.java","lines":["@@ -0,0 +1,104 @@","+package org.bouncycastle.crypto.test;","+","+import java.lang.reflect.Field;","+","+import org.bouncycastle.crypto.BlockCipher;","+import org.bouncycastle.crypto.engines.AESEngine;","+import org.bouncycastle.crypto.engines.AESFastEngine;","+import org.bouncycastle.crypto.engines.AESLightEngine;","+import org.bouncycastle.crypto.engines.DESEngine;","+import org.bouncycastle.crypto.engines.DESedeEngine;","+import org.bouncycastle.crypto.params.KeyParameter;","+import org.bouncycastle.util.Arrays;","+import org.bouncycastle.util.encoders.Hex;","+import org.bouncycastle.util.test.SimpleTest;","+","+/**","+ * Re-keying the AES and DES engines clears the key schedule they held before, rather than leaving it in","+ * memory for the collector, and the engine then works under the new key.","+ */","+public class EngineRekeyClearTest","+    extends SimpleTest","+{","+    private static final byte[] KEY_A = Hex.decode(\"000102030405060708090a0b0c0d0e0f1011121314151617\");","+    private static final byte[] KEY_B = Hex.decode(\"f0e1d2c3b4a5968778695a4b3c2d1e0f0123456789abcdef\");","+","+    public String getName()","+    {","+        return \"EngineRekeyClear\";","+    }","+","+    public void performTest()","+        throws Exception","+    {","+        checkEngine(new AESEngine(), new AESEngine(), \"WorkingKey\", 16);","+        checkEngine(new AESLightEngine(), new AESLightEngine(), \"WorkingKey\", 16);","+        checkEngine(new AESFastEngine(), new AESFastEngine(), \"WorkingKey\", 16);","+        checkEngine(new DESEngine(), new DESEngine(), \"workingKey\", 8);","+        checkEngine(new DESedeEngine(), new DESedeEngine(), \"workingKey1\", 24);","+        checkEngine(new DESedeEngine(), new DESedeEngine(), \"workingKey2\", 24);","+        checkEngine(new DESedeEngine(), new DESedeEngine(), \"workingKey3\", 24);","+        checkEngine(new DESedeEngine(), new DESedeEngine(), \"workingKey1\", 16);","+    }","+","+    private void checkEngine(BlockCipher engine, BlockCipher fresh, String fieldName, int keyLen)","+        throws Exception","+    {","+        engine.init(true, new KeyParameter(KEY_A, 0, keyLen));","+        Object before = getField(engine, fieldName);","+","+        engine.init(true, new KeyParameter(KEY_B, 0, keyLen));","+        Object after = getField(engine, fieldName);","+","+        isTrue(engine.getAlgorithmName() + \" \" + fieldName + \" reused on re-key\", before != after);","+        isTrue(engine.getAlgorithmName() + \" \" + fieldName + \" not cleared on re-key\", isCleared(before));","+","+        // the re-keyed engine agrees with a fresh engine under the new key","+        fresh.init(true, new KeyParameter(KEY_B, 0, keyLen));","+        byte[] in = new byte[engine.getBlockSize()];","+        byte[] out1 = new byte[in.length];","+        byte[] out2 = new byte[in.length];","+        engine.processBlock(in, 0, out1, 0);","+        fresh.processBlock(in, 0, out2, 0);","+        isTrue(engine.getAlgorithmName() + \" output wrong after re-key\", Arrays.areEqual(out1, out2));","+    }","+","+    private static Object getField(Object engine, String fieldName)","+        throws Exception","+    {","+        Field f = engine.getClass().getDeclaredField(fieldName);","+        f.setAccessible(true);","+        return f.get(engine);","+    }","+","+    private static boolean isCleared(Object schedule)","+    {","+        if (schedule instanceof int[][])","+        {","+            int[][] rows = (int[][])schedule;","+            for (int i = 0; i != rows.length; i++)","+            {","+                if (!isCleared(rows[i]))","+                {","+                    return false;","+                }","+            }","+            return true;","+        }","+","+        int[] row = (int[])schedule;","+        for (int i = 0; i != row.length; i++)","+        {","+            if (row[i] != 0)","+            {","+                return false;","+            }","+        }","+        return true;","+    }","+","+    public static void main(String[] args)","+    {","+        runTest(new EngineRekeyClearTest());","+    }","+}"],"additions":104,"deletions":0,"truncated":false},{"path":"core/src/test/java/org/bouncycastle/crypto/test/RegressionTest.java","lines":["@@ -95,6 +95,7 @@ public class RegressionTest","             new NISTCTSTest(),","             new NISTECCTest(),","             new CCMTest(),","+            new EngineRekeyClearTest(),","             new PKCS5Test(),","             new PKCS12Test(),","             new KDF1GeneratorTest(),"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/releasenotes.md","lines":["@@ -227,6 +227,10 @@ Date: 2026, TBD"," - RecipientInformation.getMac() did not check the content-type authenticated attribute of a CMS AuthenticatedData message, so the eContentType could be changed without the MAC failing and a message whose authenticated attributes had no content-type attribute was accepted. RFC 5652 sec. 9.2 and 9.3 require the attribute whenever authenticated attributes are present and require its value to match the eContentType; getMac() now enforces both, as SignerInformation already does for SignedData."," - Both PKIXCertPathReviewer copies (org.bouncycastle.pkix.jcajce and the deprecated org.bouncycastle.x509) let a delta CRL decide the status of a certificate. A delta CRL lists only the changes since its base CRL, so a certificate revoked on the base was reported as not revoked when the CRLs the reviewer was given held a current delta and only an expired base, or earlier deltas and no base at all, and the presence of a base was checked without reading it. SignedMailValidator gives the reviewer the CRLs carried in the signed message, so the holder of a revoked signing certificate could have a message accepted by including CRLs the CA had published. As in CertPathValidator, only a complete CRL now decides the status of a certificate, whether it is found in the CertStores or fetched from a CRL distribution point; where no current complete CRL is available the reviewer reports that rather than a status."," - The PKIXCertPathReviewer copies did not refuse a CRL carrying a critical extension other than the issuing distribution point and the delta CRL indicator, as RFC 5280 sec. 5.2 requires and CertPathValidator does, and looked up a certificate on an indirect CRL by serial number alone, taking the first entry with that serial whichever certificate issuer it named. Such a CRL is now refused, and the entry is matched on the certificate issuer as well, as CertPathValidator has done since github #2464.","+- CCMBlockCipher left the message and associated data it buffers in its internal buffers after doFinal() and reset(), only rewinding them, and did not clear its working copies of the decrypted plaintext. The buffers are now zeroized on reset, which doFinal() performs, and the working copies once the plaintext has been returned or the tag check has failed.","+- The AES engines (AESEngine, AESLightEngine and the deprecated AESFastEngine) and the DES and Triple-DES engines replaced their key schedule on re-keying without clearing the previous one, and DESedeEngine also left its copies of the three DES keys in memory. The previous schedule and the key copies are now zeroized.","+- The BCFKS key store left the keys it derives from the store password, used to encrypt and decrypt key entries and the store and to calculate its integrity MAC, in memory, together with the password bytes fed to the key derivation, the plaintext encodings it builds when storing and recovering private, secret and PBE keys, and, for the immutable shared store, the password bytes of its key-entry check. Each is now zeroized as soon as it has been used, including when the operation fails. The PBE key returned by getKey() for a stored PBE key is now Destroyable, as BCPBEKey is, so a caller can clear the recovered password and key encoding.","+- BCPBEKey.getEncoded() returned the array holding the derived key itself rather than a copy, so a caller writing to the result, for example to clear it after use, changed or erased the key without the key being marked destroyed. It now returns a copy, as the other key classes do."," "," ### 2.1.3 Additional Features and Functionality"," "],"additions":4,"deletions":0,"truncated":false},{"path":"prov/src/main/java/org/bouncycastle/jcajce/provider/keystore/bcfks/BcFKSKeyStoreSpi.java","lines":["@@ -35,6 +35,7 @@"," import java.util.HashSet;"," import java.util.Iterator;"," import java.util.Map;","+import java.util.concurrent.atomic.AtomicBoolean;"," "," import javax.crypto.BadPaddingException;"," import javax.crypto.Cipher;","@@ -45,6 +46,7 @@"," import javax.crypto.SecretKeyFactory;"," import javax.crypto.interfaces.PBEKey;"," import javax.crypto.spec.SecretKeySpec;","+import javax.security.auth.Destroyable;"," "," import org.bouncycastle.asn1.ASN1Encodable;"," import org.bouncycastle.asn1.ASN1Encoding;","@@ -218,13 +220,17 @@ public Key engineGetKey(String alias, char[] password)","                 EncryptedPrivateKeyData encPrivData = EncryptedPrivateKeyData.getInstance(ent.getData());","                 EncryptedPrivateKeyInfo encInfo = EncryptedPrivateKeyInfo.getInstance(encPrivData.getEncryptedPrivateKeyInfo());"," ","+                byte[] data = null;","+                byte[] pkcs8 = null;","                 try","                 {","-                    PrivateKeyInfo pInfo = PrivateKeyInfo.getInstance(decryptData(\"PRIVATE_KEY_ENCRYPTION\", encInfo.getEncryptionAlgorithm(), password, encInfo.getEncryptedData()));","+                    data = decryptData(\"PRIVATE_KEY_ENCRYPTION\", encInfo.getEncryptionAlgorithm(), password, encInfo.getEncryptedData());","+                    PrivateKeyInfo pInfo = PrivateKeyInfo.getInstance(data);"," ","                     KeyFactory kFact = helper.createKeyFactory(getPublicKeyAlg(pInfo.getPrivateKeyAlgorithm().getAlgorithm()));"," ","-                    PrivateKey privateKey = kFact.generatePrivate(new PKCS8EncodedKeySpec(pInfo.getEncoded()));","+                    pkcs8 = pInfo.getEncoded();","+                    PrivateKey privateKey = kFact.generatePrivate(new PKCS8EncodedKeySpec(pkcs8));"," ","                     // check that the key pair and the certificate public key are consistent","                     // TODO: new ConsistentKeyPair(engineGetCertificate(alias).getPublicKey(), privateKey);","@@ -237,42 +243,70 @@ public Key engineGetKey(String alias, char[] password)","                 {","                     throw SecurityExceptions.unrecoverableKeyException(\"BCFKS KeyStore unable to recover private key (\" + alias + \"): \" + e.getMessage(), e);","                 }","+                finally","+                {","+                    Arrays.clear(data);","+                    Arrays.clear(pkcs8);","+                }","             }","             else if (ent.getType().equals(SECRET_KEY) || ent.getType().equals(PROTECTED_SECRET_KEY))","             {","                 EncryptedSecretKeyData encKeyData = EncryptedSecretKeyData.getInstance(ent.getData());"," ","+                byte[] data = null;","+                byte[] keyBytes = null;","                 try","                 {","-                    SecretKeyData keyData = SecretKeyData.getInstance(decryptData(\"SECRET_KEY_ENCRYPTION\", encKeyData.getKeyEncryptionAlgorithm(), password, encKeyData.getEncryptedKeyData()));","+                    data = decryptData(\"SECRET_KEY_ENCRYPTION\", encKeyData.getKeyEncryptionAlgorithm(), password, encKeyData.getEncryptedKeyData());","+                    SecretKeyData keyData = SecretKeyData.getInstance(data);","                     SecretKeyFactory kFact = helper.createSecretKeyFactory(keyData.getKeyAlgorithm().getId());"," ","-                    return kFact.generateSecret(new SecretKeySpec(keyData.getKeyBytes(), keyData.getKeyAlgorithm().getId()));","+                    keyBytes = keyData.getKeyBytes();","+                    return kFact.generateSecret(new SecretKeySpec(keyBytes, keyData.getKeyAlgorithm().getId()));","                 }","                 catch (Exception e)","                 {","                     throw SecurityExceptions.unrecoverableKeyException(\"BCFKS KeyStore unable to recover secret key (\" + alias + \"): \" + e.getMessage(), e);","                 }","+                finally","+                {","+                    Arrays.clear(data);","+                    Arrays.clear(keyBytes);","+                }","             }","             else if (ent.getType().equals(PBKDF_KEY))","             {","                 EncryptedSecretKeyData encKeyData = EncryptedSecretKeyData.getInstance(ent.getData());"," ","+                byte[] data = null;","+                byte[] pbePassword = null;","+                byte[] pbeEncoding = null;","                 try","                 {","-                    PbkdKeyData keyData = PbkdKeyData.getInstance(decryptData(\"SECRET_KEY_ENCRYPTION\", encKeyData.getKeyEncryptionAlgorithm(), password, encKeyData.getEncryptedKeyData()));","+                    data = decryptData(\"SECRET_KEY_ENCRYPTION\", encKeyData.getKeyEncryptionAlgorithm(), password, 