d-width rows need no scan. Both limits go through","+//! the batch analyzer: like the Parquet writer and the delayed partition path, a batch"," //! is closed once it reaches a limit, so it may exceed the row limit by less than one input vector."," void PartitionedCopyHashGroup::Plan() {"," \tconst auto &op = partitioned_copy.op;","@@ -3208,7 +3246,9 @@ void PartitionedCopyHashGroup::Plan() {"," "," \tvector<idx_t> boundaries;"," \tvector<idx_t> row_sizes;","-\tauto cursor = group->InitializeCursor();","+\tCopyBatchSlicer slicer(partitioned_copy.write_types, batch_size_bytes);","+\tconst auto fixed_row_size = slicer.FixedRowSize();","+\tauto cursor = group->InitializeCursor(slicer);"," \twhile (cursor->Next()) {"," \t\tconst auto position = cursor->Position();"," \t\tconst auto chunk_rows = cursor->Count();","@@ -3219,7 +3259,9 @@ void PartitionedCopyHashGroup::Plan() {"," \t\t\tbegin = {position, 0};"," \t\t\tbegin_at_next_chunk = false;"," \t\t}","-\t\tconst auto chunk_bytes = cursor->ByteEstimate();","+\t\tconst auto chunk_bytes = fixed_row_size.IsValid()     ? chunk_rows * fixed_row_size.GetIndex()","+\t\t                         : batch_size_bytes.IsValid() ? cursor->ByteEstimate()","+\t\t                                                      : 0;"," \t\tboundaries.clear();"," \t\tcursor->PartitionBoundaries(boundaries);"," \t\tboundaries.push_back(chunk_rows);","@@ -3236,16 +3278,20 @@ void PartitionedCopyHashGroup::Plan() {"," \t\t\t\tidx_t run_rows = boundary - row;"," \t\t\t\tif (!sized && batch_size_bytes.IsValid() && run_rows > 1 &&"," \t\t\t\t    batch_bytes + chunk_bytes * run_rows / chunk_rows >= batch_size_bytes.GetIndex()) {","-\t\t\t\t\t// the run would cross the byte limit: use the exact row sizes for the rest of this chunk","-\t\t\t\t\tcursor->RowSizes(row_sizes);","-\t\t\t\t\tif (row_sizes.size() != chunk_rows) {","-\t\t\t\t\t\tthrow InternalException(\"Partitioned copy sized %llu rows of a chunk of %llu rows\",","-\t\t\t\t\t\t                        row_sizes.size(), chunk_rows);","+\t\t\t\t\t// The run would cross the byte limit. Refine the remaining rows of this chunk.","+\t\t\t\t\tif (fixed_row_size.IsValid()) {","+\t\t\t\t\t\trow_sizes.assign(chunk_rows, fixed_row_size.GetIndex());","+\t\t\t\t\t} else {","+\t\t\t\t\t\tcursor->RowSizes(row_sizes);","+\t\t\t\t\t\tif (row_sizes.size() != chunk_rows) {","+\t\t\t\t\t\t\tthrow InternalException(\"Partitioned copy sized %llu rows of a chunk of %llu rows\",","+\t\t\t\t\t\t\t                        row_sizes.size(), chunk_rows);","+\t\t\t\t\t\t}"," \t\t\t\t\t}"," \t\t\t\t\tsized = true;"," \t\t\t\t}"," \t\t\t\tif (sized) {","-\t\t\t\t\t// take rows by their exact size until a limit is reached","+\t\t\t\t\t// take rows by their refined size until a limit is reached"," \t\t\t\t\twhile (run_rows) {"," \t\t\t\t\t\tbatch_bytes += row_sizes[row++];"," \t\t\t\t\t\t++batch_rows;"],"additions":84,"deletions":38,"truncated":false},{"path":"src/include/duckdb/common/types/column/column_data_collection.hpp","lines":["@@ -234,6 +234,8 @@ class ColumnDataChunkCursor {"," \tidx_t Count() const;"," \t//! The allocated bytes of the current chunk"," \tidx_t AllocationSize() const;","+\t//! The allocated bytes of selected columns of the current chunk","+\tidx_t AllocationSize(const vector<column_t> &column_ids) const;"," "," private:"," \tconst ColumnDataCollection &collection;"],"additions":2,"deletions":0,"truncated":false},{"path":"src/include/duckdb/common/types/column/column_data_collection_segment.hpp","lines":["@@ -118,6 +118,8 @@ struct VectorMetaData {"," struct ChunkMetaData {"," \t//! The set of vectors of the chunk"," \tvector<VectorDataIndex> vector_data;","+\t//! Allocated bytes per column, including its child vectors and buffer-managed string heaps","+\tvector<idx_t> allocation_sizes;"," \t//! The block ids referenced by the chunk"," \tunordered_set<uint32_t> block_ids;"," \t//! The number of entries in the chunk","@@ -204,6 +206,8 @@ class ColumnDataCollectionSegment {"," \tidx_t AllocationSize() const;"," \t//! Get the allocation size of the chunk"," \tidx_t GetChunkAllocationSize(idx_t chunk_index) const;","+\t//! Get the allocation size of selected columns of the chunk","+\tidx_t GetChunkAllocationSize(idx_t chunk_index, const vector<column_t> &column_ids) const;"," "," \tvoid FetchChunk(idx_t chunk_idx, DataChunk &result);"," \tvoid FetchChunk(idx_t chunk_idx, DataChunk &result, const vector<column_t> &column_ids);"],"additions":4,"deletions":0,"truncated":false},{"path":"src/include/duckdb/execution/operator/persistent/copy_batch_slicer.hpp","lines":["@@ -23,6 +23,14 @@ class CopyBatchSlicer {"," \t~CopyBatchSlicer();"," "," public:","+\t//! The fixed-width contribution, excluding tuple headers and variable payloads.","+\tidx_t GetFixedRowBytes() const {","+\t\treturn fixed_row_bytes;","+\t}","+\t//! Fixed bytes per written row, when sizing needs no values from the input.","+\toptional_idx FixedRowSize() const {","+\t\treturn batch_size_bytes.IsValid() && layout.AllConstant() ? optional_idx(fixed_row_bytes) : optional_idx();","+\t}"," \t//! Computes row sizes, including fixed-width values and variable payloads."," \tconst Vector &ComputeRowSizes(DataChunk &chunk);"," \t//! Returns the next slice and advances offset, reusing row sizes until the chunk is exhausted."],"additions":8,"deletions":0,"truncated":false},{"path":"test/sql/copy/partitioned/partitioned_written_batch_bytes.test","lines":["@@ -0,0 +1,259 @@","+# name: test/sql/copy/partitioned/partitioned_written_batch_bytes.test","+# description: Partitioned COPY sizes byte-limited batches from the columns it writes","+# group: [partitioned]","+","+require parquet","+","+statement ok","+SET threads=2;","+","+statement ok","+SET max_execution_time=60000;","+","+statement ok","+CREATE MACRO batches() AS TABLE","+SELECT regexp_extract(message, 'rows=(\\d+)', 1)::BIGINT AS rows,","+       regexp_extract(message, 'size=(\\d+)', 1)::BIGINT AS bytes,","+       regexp_extract(message, 'reason=([A-Z_]+)', 1) AS reason","+FROM duckdb_logs WHERE type='PhysicalOperator' AND message LIKE '%FlushBatch%';","+","+# Flush the small fixed-width input through planned batches instead of delayed partition buffers.","+statement ok","+SET partitioned_write_flush_threshold=16384;","+","+# The direct integer partition input stores three columns but writes only two.","+# Counting the bucket and tuple headers closed every batch below the 128 KiB target.","+statement ok","+CREATE TABLE fixed_input AS","+SELECT i AS k, 1::BIGINT AS payload, hash(i,6364136223846793005)%4 AS bucket","+FROM range(131072) t(i);","+","+# Keep the COPY and its in-memory log together under forced database restarts.","+statement ok","+BEGIN;","+","+statement ok","+CALL enable_logging(level='debug', storage='memory');","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement ok","+COPY fixed_input TO '{TEST_DIR}/fixed'","+(FORMAT PARQUET, PARTITION_BY bucket, ROW_GROUP_SIZE 4194304, ROW_GROUP_SIZE_BYTES 131072);","+","+query IIII","+SELECT count(*) FILTER (WHERE reason='BATCH_SIZE_BYTES') >= 8,","+       min(bytes) FILTER (WHERE reason='BATCH_SIZE_BYTES') >= 131072,","+       count(*) FILTER (WHERE reason='FORCED_FLUSH') <= 4,","+       sum(rows)=131072","+FROM batches();","+----","+true\ttrue\ttrue\ttrue","+","+statement ok","+COMMIT;","+","+query IIIIII","+SELECT count(*), count(DISTINCT k), min(k), max(k),","+       bool_and(payload=1), bool_and(bucket=hash(k,6364136223846793005)%4)","+FROM read_parquet('{TEST_DIR}/fixed/**/*.parquet', hive_partitioning=true);","+----","+131072\t131072\t0\t131071\ttrue\ttrue","+","+# Keep the 8000-row partitions in planned batching without an earlier flush generation.","+statement ok","+SET partitioned_write_flush_threshold=8000;","+","+# A long unwritten partition key must not contribute to the byte limit either.","+# ORDER_BY keeps the sorted backend. The byte budget spans multiple input chunks,","+# including chunks before the one that reaches the limit.","+statement ok","+CREATE TABLE nested_input AS","+SELECT i AS k, repeat(CASE WHEN i%2=0 THEN 'a' ELSE 'b' END,200) AS part,","+       repeat(md5(i::VARCHAR),8) AS s,","+       struct_pack(x := CASE WHEN i%7=0 THEN NULL ELSE i END,","+                   ys := [i, NULL, i+1]) AS payload","+FROM range(16000) t(i);","+","+statement ok","+BEGIN;","+","+statement ok","+CALL enable_logging(level='debug', storage='memory');","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement ok","+COPY nested_input TO '{TEST_DIR}/sorted'","+(FORMAT PARQUET, PARTITION_BY part, ORDER_BY k, ROW_GROUP_SIZE 4194304, ROW_GROUP_SIZE_BYTES 2097152);","+","+# Written values occupy at least 328 bytes per row. The row sizer counts 337, including","+# the list length and child validity. Allow that difference and one short tail per partition.","+# The row ceiling requires refinement of the chunk that crosses the byte limit.","+query IIII","+SELECT count(*) FILTER (WHERE bytes >= 2097152 * 328 // 337) >= 2,","+       count(*) FILTER (WHERE bytes < 2097152 * 328 // 337) <= 2,","+       max(rows) <= (2097152 + 327) // 328,","+       sum(rows)=16000","+FROM batches();","+----","+true\ttrue\ttrue\ttrue","+","+statement ok","+COMMIT;","+","+query II","+SELECT (SELECT count(*) FROM (FROM nested_input EXCEPT ALL SELECT k,part,s,payload FROM read_parquet('{TEST_DIR}/sorted/**/*.parquet',hive_partitioning=true))),","+       (SELECT count(*) FROM (SELECT k,part,s,payload FROM read_parquet('{TEST_DIR}/sorted/**/*.parquet',hive_partitioning=true) EXCEPT ALL FROM nested_input));","+----","+0\t0","+","+# When partition columns are written, their payload contributes to the same limit.","+statement ok","+BEGIN;","+","+statement ok","+CALL enable_logging(level='debug', storage='memory');","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement ok","+COPY nested_input TO '{TEST_DIR}/written_partition'","+(FORMAT PARQUET, PARTITION_BY part, ORDER_BY k, WRITE_PARTITION_COLUMNS,","+ ROW_GROUP_SIZE 4194304, ROW_GROUP_SIZE_BYTES 2097152);","+","+# Writing the 200-byte key adds its 16-byte string reference and payload to both widths.","+query IIII","+SELECT count(*) FILTER (WHERE bytes >= 2097152 * 544 // 553) >= 4,","+       count(*) FILTER (WHERE bytes < 2097152 * 544 // 553) <= 2,","+       max(rows) <= (2097152 + 543) // 544,","+       sum(rows)=16000","+FROM batches();","+----","+true\ttrue\ttrue\ttrue","+","+statement ok","+COMMIT;","+","+query II","+SELECT (SELECT count(*) FROM (FROM nested_input EXCEPT ALL SELECT k,part,s,payload FROM read_parquet('{TEST_DIR}/written_partition/**/*.parquet',hive_partitioning=false))),","+       (SELECT count(*) FROM (SELECT k,part,s,payload FROM read_parquet('{TEST_DIR}/written_partition/**/*.parquet',hive_partitioning=false) EXCEPT ALL FROM nested_input));","+----","+0\t0","+","+query I","+WITH ordered AS (","+    SELECT k, lag(k) OVER (PARTITION BY filename ORDER BY file_row_number) AS previous","+    FROM read_parquet('{TEST_DIR}/written_partition/**/*.parquet',filename=true,file_row_number=true)","+)","+SELECT count(*) FROM ordered WHERE previous > k;","+----","+0","+","+# A single VARCHAR partition without ORDER_BY uses the tuple shortcut. Its long key is","+# omitted once per row from the cached heap estimate, including chunks before the boundary.","+statement ok","+BEGIN;","+","+statement ok","+CALL enable_logging(level='debug', storage='memory');","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement ok","+COPY (SELECT k, repeat('a',200) AS part, s, payload FROM nested_input)","+TO '{TEST_DIR}/single_string_partition'","+(FORMAT PARQUET, PARTITION_BY part, ROW_GROUP_SIZE 4194304, ROW_GROUP_SIZE_BYTES 2097152);","+","+query IIII","+SELECT count(*) FILTER (WHERE bytes >= 2097152 * 328 // 337) >= 2,","+       count(*) FILTER (WHERE bytes < 2097152 * 328 // 337) <= 1,","+       max(rows) <= (2097152 + 327) // 328,","+       sum(rows)=16000","+FROM batches();","+----","+true\ttrue\ttrue\ttrue","+","+statement ok","+COMMIT;","+","+query III","+SELECT (SELECT count(*) FROM (SELECT k,s,payload FROM nested_input EXCEPT ALL SELECT k,s,payload FROM read_parquet('{TEST_DIR}/single_string_partition/**/*.parquet',hive_partitioning=true))),","+       (SELECT count(*) FROM (SELECT k,s,payload FROM read_parquet('{TEST_DIR}/single_string_partition/**/*.parquet',hive_partitioning=true) EXCEPT ALL SELECT k,s,payload FROM nested_input)),","+       (SELECT bool_and(part=repeat('a',200)) FROM read_parquet('{TEST_DIR}/single_string_partition/**/*.parquet',hive_partitioning=true));","+----","+0\t0\ttrue","+","+# The same variable-width payload through direct integer partition input, including","+# NULL partition values and duplicate rows. The two directions check multiplicities.","+statement ok","+CREATE TABLE direct_input AS","+SELECT k%100 AS k, CASE WHEN k%3=0 THEN NULL ELSE k%3 END AS part, s, payload","+FROM nested_input UNION ALL SELECT k%100, CASE WHEN k%3=0 THEN NULL ELSE k%3 END, s, payload FROM nested_input;","+","+statement ok","+BEGIN;","+","+statement ok","+CALL enable_logging(level='debug', storage='memory');","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement ok","+COPY direct_input TO '{TEST_DIR}/direct_nested'","+(FORMAT PARQUET, PARTITION_BY part, ROW_GROUP_SIZE 4194304, ROW_GROUP_SIZE_BYTES 65536);","+","+query IIII","+SELECT count(*) FILTER (WHERE bytes >= 65536 * 328 // 337) > 10,","+       count(*) FILTER (WHERE bytes < 65536 * 328 // 337) <= 3,","+       max(rows) <= (65536 + 327) // 328,","+       sum(rows)=32000","+FROM batches();","+----","+true\ttrue\ttrue\ttrue","+","+statement ok","+COMMIT;","+","+query II","+SELECT (SELECT count(*) FROM (FROM direct_input EXCEPT ALL SELECT k,part,s,payload FROM read_parquet('{TEST_DIR}/direct_nested/**/*.parquet',hive_partitioning=true))),","+       (SELECT count(*) FROM (SELECT k,part,s,payload FROM read_parquet('{TEST_DIR}/direct_nested/**/*.parquet',hive_partitioning=true) EXCEPT ALL FROM direct_input));","+----","+0\t0","+","+statement ok","+RESET partitioned_write_flush_threshold;","+","+# With no byte limit, row-limit batching and short final batches keep their behavior.","+statement ok","+BEGIN;","+","+statement ok","+CALL enable_logging(level='debug', storage='memory');","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement ok","+COPY (SELECT i AS k, i%2 AS bucket FROM range(10000) t(i))","+TO '{TEST_DIR}/row_limit' (FORMAT PARQUET, PARTITION_BY bucket, ROW_GROUP_SIZE 2048);","+","+query III","+SELECT count(*) FILTER (WHERE reason='BATCH_SIZE') > 0,","+       count(*) FILTER (WHERE reason='BATCH_SIZE_BYTES'), sum(rows)","+FROM batches();","+----","+true\t0\t10000","+","+statement ok","+COMMIT;","+","+query II","+SELECT count(*), count(DISTINCT k) FROM read_parquet('{TEST_DIR}/row_limit/**/*.parquet');","+----","+10000\t10000"],"additions":259,"deletions":0,"truncated":false},{"path":"test/sql/copy/partitioned/partitioned_written_key_edges.test","lines":["@@ -0,0 +1,68 @@","+# name: test/sql/copy/partitioned/partitioned_written_key_edges.test","+# description: Omitted constant variable partition keys do not contribute to COPY batch sizes","+# group: [partitioned]","+","+require parquet","+","+statement ok","+SET threads=1;","+","+statement ok","+SET max_execution_time=60000;","+","+statement ok","+SET partitioned_write_flush_threshold=8000;","+","+statement ok","+CREATE MACRO batches() AS TABLE","+SELECT regexp_extract(message, 'rows=(\\d+)', 1)::BIGINT AS rows,","+       regexp_extract(message, 'size=(\\d+)', 1)::BIGINT AS bytes","+FROM duckdb_logs WHERE type='PhysicalOperator' AND message LIKE '%FlushBatch%';","+","+statement ok","+CREATE TABLE key_input AS","+SELECT i AS k, repeat(md5(i::VARCHAR),8) AS s,","+       NULL::VARCHAR AS null_key, 'short' AS inline_key,","+       [repeat('a',80), NULL, repeat('b',80)] AS list_key,","+       struct_pack(s := repeat('a',160), ys := [1::BIGINT,NULL,2::BIGINT]) AS struct_key,","+       [repeat('a',80), NULL, repeat('b',80)]::VARCHAR[3] AS array_key"],"additions":28,"deletions":0,"truncated":false}],"additions":413,"deletions":43,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-29T15:21:15.342853+00:00"}