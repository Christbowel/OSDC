cgid.c","lines":["@@ -1153,7 +1153,14 @@ static const char *set_scriptlog_length(cmd_parms *cmd, void *dummy, const char","     cgid_server_conf *conf = ap_get_module_config(s->module_config,","                                                   &cgid_module);"," ","-    conf->logbytes = atol(arg);","+    apr_off_t bytes;","+","+    if (ap_size_parameter_parse(arg, &bytes) != APR_SUCCESS","+            || bytes < 0 || bytes > LONG_MAX) {","+        return \"ScriptLogLength must be a non-negative integer.\";","+    }","+","+    conf->logbytes = (long)bytes;","     return NULL;"," }"," ","@@ -1163,7 +1170,14 @@ static const char *set_scriptlog_buffer(cmd_parms *cmd, void *dummy, const char","     cgid_server_conf *conf = ap_get_module_config(s->module_config,","                                                   &cgid_module);"," ","-    conf->bufbytes = atoi(arg);","+    apr_off_t bytes;","+","+    if (ap_size_parameter_parse(arg, &bytes) != APR_SUCCESS","+            || bytes < 0 || bytes > INT_MAX) {","+        return \"ScriptLogBuffer must be a non-negative integer.\";","+    }","+","+    conf->bufbytes = (int)bytes;","     return NULL;"," }"," "],"additions":16,"deletions":2,"truncated":false},{"path":"server/core.c","lines":["@@ -3900,14 +3900,17 @@ static const char *set_limit_req_body(cmd_parms *cmd, void *conf_,","                                       const char *arg)"," {","     core_dir_config *conf = conf_;","-    char *errp;","+    apr_off_t limit;","+    apr_status_t rv;"," ","-    if (APR_SUCCESS != apr_strtoff(&conf->limit_req_body, arg, &errp, 10)) {","+    rv = ap_size_parameter_parse(arg, &limit);","+    if (rv == APR_ERANGE) {","         return \"LimitRequestBody argument is not parsable.\";","     }","-    if (*errp || conf->limit_req_body < 0) {","+    if (rv != APR_SUCCESS || limit < 0) {","         return \"LimitRequestBody requires a non-negative integer.\";","     }","+    conf->limit_req_body = limit;"," ","     return NULL;"," }"],"additions":6,"deletions":3,"truncated":false},{"path":"server/util.c","lines":["@@ -2773,6 +2773,23 @@ AP_DECLARE(apr_status_t) ap_timeout_parameter_parse(","     *timeout = (apr_interval_time_t)check;","     return APR_SUCCESS;"," }","+","+AP_DECLARE(apr_status_t) ap_size_parameter_parse(const char *parameter,","+                                                 apr_off_t *value)","+{","+    apr_off_t parsed;","+    char *end;","+","+    if (apr_strtoff(&parsed, parameter, &end, 10) != APR_SUCCESS) {","+        return APR_ERANGE;","+    }","+    if (end == parameter || *end != '\\0') {","+        return APR_EINVAL;","+    }","+","+    *value = parsed;","+    return APR_SUCCESS;","+}"," #undef CHECK_OVERFLOW"," "," AP_DECLARE(int) ap_parse_strict_length(apr_off_t *len, const char *str)"],"additions":17,"deletions":0,"truncated":false},{"path":"test/modules/core/test_012_config_off_t.py","lines":["@@ -0,0 +1,65 @@","+import os","+","+import pytest","+","+from pyhttpd.conf import HttpdConf","+","+# size and time directives parsed with ap_size_parameter_parse(), which can","+# not be negative","+DIRECTIVES = [","+    \"LimitRequestBody\",","+    \"ScriptLogLength\", \"ScriptLogBuffer\",","+    \"CacheMinFileSize\", \"CacheMaxFileSize\", \"CacheReadSize\", \"CacheReadTime\",","+    \"CacheSocacheMaxTime\", \"CacheSocacheMinTime\", \"CacheSocacheReadSize\",","+    \"CacheSocacheReadTime\",","+]","+","+","+class TestConfigOffT:","+","+    # have httpd parse the configuration, like \"httpd -t\" does","+    def check_config(self, env, directive, value):","+        conf = HttpdConf(env)","+        conf.add(f\"{directive} {value}\")","+        conf.add_vhost_test1()","+        conf.install()","+        return env.run([os.path.join(env.bin_dir, 'httpd'),","+                        \"-t\", \"-d\", env.server_dir,","+                        \"-f\", os.path.join(env.server_dir, 'conf', 'httpd.conf')])","+","+    @pytest.mark.parametrize(\"directive\", DIRECTIVES)","+    @pytest.mark.parametrize(\"value\", [\"0\", \"1\", \"123\", \"1000000\", \"00123\"])","+    def test_core_012_001(self, env, directive, value):","+        r = self.check_config(env, directive, value)","+        assert r.exit_code == 0, f\"{r.stderr}\"","+","+    # only a whole decimal number is valid","+    @pytest.mark.parametrize(\"directive\", DIRECTIVES)","+    @pytest.mark.parametrize(\"value\", [","+        \"abc\", \"abc123\", \"123abc\", \"123foo456\", \"12.3\", \"0x10\", \"1K\", \"+\", \"-\",","+    ])","+    def test_core_012_002(self, env, directive, value):","+        r = self.check_config(env, directive, value)","+        assert r.exit_code != 0, f\"{value} was accepted\"","+        assert directive in r.stderr, f\"{r.stderr}\"","+","+    # a number the directive does not accept, or too large to be stored","+    @pytest.mark.parametrize(\"directive\", DIRECTIVES)","+    @pytest.mark.parametrize(\"value\", [\"-1\", \"9223372036854775808\", \"9\" * 40])","+    def test_core_012_003(self, env, directive, value):","+        r = self.check_config(env, directive, value)","+        assert r.exit_code != 0, f\"{value} was accepted\"","+        assert directive in r.stderr, f\"{r.stderr}\"","+","+    # this one has a lower limit as well","+    @pytest.mark.parametrize(\"value, valid\", [","+        [\"1024\", True], [\"102400\", True], [\"1023\", False], [\"0\", False],","+        [\"1024abc\", False], [\"abc\", False], [\"9\" * 40, False],","+    ])","+    def test_core_012_004(self, env, value, valid):","+        r = self.check_config(env, \"CacheSocacheMaxSize\", value)","+        if valid:","+            assert r.exit_code == 0, f\"{r.stderr}\"","+        else:","+            assert r.exit_code != 0, f\"{value} was accepted\"","+            assert \"CacheSocacheMaxSize\" in r.stderr, f\"{r.stderr}\""],"additions":65,"deletions":0,"truncated":false},{"path":"test/modules/dav/test_003_config_quota.py","lines":["@@ -0,0 +1,35 @@","+import os","+","+import pytest","+","+from pyhttpd.conf import HttpdConf","+","+","+class TestConfigQuota:","+","+    # have httpd parse the configuration, like \"httpd -t\" does","+    def check_config(self, env, value):","+        conf = HttpdConf(env)","+        conf.add(f\"DavQuota {value}\")","+        conf.add_vhost_test1()","+        conf.install()","+        return env.run([os.path.join(env.bin_dir, 'httpd'),","+                        \"-t\", \"-d\", env.server_dir,","+                        \"-f\", os.path.join(env.server_dir, 'conf', 'httpd.conf')])","+","+    @pytest.mark.parametrize(\"value\", [","+        \"Off\", \"None\", \"0\", \"1\", \"123\", \"1000000\", \"00123\",","+    ])","+    def test_dav_003_01(self, env, value):","+        r = self.check_config(env, value)","+        assert r.exit_code == 0, f\"{r.stderr}\"","+","+    # not Off, None or a size, in particular no negative number, which would","+    # be taken for one of the first two","+    @pytest.mark.parametrize(\"value\", [","+        \"abc\", \"123abc\", \"12.3\", \"0x10\", \"-1\", \"-2\", \"9\" * 40,","+    ])","+    def test_dav_003_02(self, env, value):","+        r = self.check_config(env, value)","+        assert r.exit_code != 0, f\"{value} was accepted\"","+        assert \"DAVquota must be Off, None, or a size in bytes\" in r.stderr"],"additions":35,"deletions":0,"truncated":false},{"path":"test/modules/filters/env.py","lines":["@@ -12,7 +12,7 @@ class FiltersTestSetup(HttpdTestSetup):","     def __init__(self, env: 'HttpdTestEnv'):","         super().__init__(env=env)","         self.add_source_dir(os.path.dirname(inspect.getfile(FiltersTestSetup)))","-        self.add_modules([\"substitute\", \"sed\"])","+        self.add_modules([\"substitute\", \"sed\", \"buffer\"])","         self.add_cgi_module()"," "," "],"additions":1,"deletions":1,"truncated":false},{"path":"test/modules/filters/test_004_buffer_size.py","lines":["@@ -0,0 +1,31 @@","+import os","+","+import pytest","+","+from pyhttpd.conf import HttpdConf","+","+","+class TestBufferSize:","+","+    # have httpd parse the configuration, like \"httpd -t\" does","+    def check_config(self, env, value):","+        conf = HttpdConf(env)","+        conf.add([\"<Location \\\"/buffer\\\">\", f\"    BufferSize {value}\", \"</Location>\"])","+        conf.add_vhost_test1()","+        conf.install()","+        return env.run([os.path.join(env.bin_dir, 'httpd'),","+                        \"-t\", \"-d\", env.server_dir,","+                        \"-f\", os.path.join(env.server_dir, 'conf', 'httpd.conf')])","+","+    @pytest.mark.parametrize(\"value\", [\"1\", \"123\", \"131072\", \"00123\"])","+    def test_filters_004_01(self, env, value):","+        r = self.check_config(env, value)","+        assert r.exit_code == 0, f\"{r.stderr}\"","+","+    @pytest.mark.parametrize(\"value\", [","+        \"abc\", \"123abc\", \"12.3\", \"0x10\", \"0\", \"-1\", \"9\" * 40,","+    ])","+    def test_filters_004_02(self, env, value):","+        r = self.check_config(env, value)","+        assert r.exit_code != 0, f\"{value} was accepted\"","+        assert \"BufferSize must be a size in bytes\" in r.stderr",""],"additions":31,"deletions":0,"truncated":false}],"additions":220,"deletions":23,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-10-15T13:23:28.665023+00:00"}