,"+    @Test","+    public void testCanHandle() {","+        final ExportProcessGroupEndpointMerger merger = new ExportProcessGroupEndpointMerger();","+","+        assertTrue(merger.canHandle(URI.create(GLOBAL_URI), \"GET\"));","+        assertTrue(merger.canHandle(URI.create(\"/nifi-api/process-groups/root/download\"), \"GET\"));","+        assertTrue(merger.canHandle(URI.create(CONNECTOR_URI), \"GET\"));","+        assertTrue(merger.canHandle(URI.create(CONNECTOR_URI + \"?includeComponentState=true\"), \"get\"));","+","+        assertFalse(merger.canHandle(URI.create(CONNECTOR_URI), \"POST\"));","+        assertFalse(merger.canHandle(URI.create(\"/nifi-api/connectors/not-a-uuid/process-groups/\" + PROCESS_GROUP_ID + \"/download\"), \"GET\"));","+        assertFalse(merger.canHandle(URI.create(\"/nifi-api/connectors/\" + CONNECTOR_ID + \"/process-groups/not-a-uuid/download\"), \"GET\"));","+        assertFalse(merger.canHandle(URI.create(CONNECTOR_URI + \"/status\"), \"GET\"));","+    }","+","+    @Test","+    public void testMergeLocalNodeStates() {","+        final ExportProcessGroupEndpointMerger merger = new ExportProcessGroupEndpointMerger();","+        final NodeResponse firstNodeResponse = createNodeResponse(1, createSnapshot(0, \"first\"));","+        final NodeResponse secondNodeResponse = createNodeResponse(2, createSnapshot(1, \"second\"));","+","+        final NodeResponse mergedResponse = merger.merge(","+                URI.create(CONNECTOR_URI), \"GET\", Set.of(firstNodeResponse, secondNodeResponse), Collections.emptySet(), firstNodeResponse);","+","+        final ExportedFlowSnapshotEntity mergedEntity = (ExportedFlowSnapshotEntity) mergedResponse.getUpdatedEntity();","+        final List<VersionedNodeState> localNodeStates = mergedEntity.getSnapshot().getFlowContents()","+                .getProcessors().iterator().next().getComponentState().getLocalNodeStates();","+        assertEquals(2, localNodeStates.size());","+        assertEquals(\"first\",