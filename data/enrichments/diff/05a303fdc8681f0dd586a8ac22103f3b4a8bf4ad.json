{"id":"05a303fdc8681f0dd586a8ac22103f3b4a8bf4ad","axis":"silent","repo":"vllm-project/vllm","sha":"05a303fdc8681f0dd586a8ac22103f3b4a8bf4ad","parsed":{"files":[{"path":"docs/serving/online_serving/README.md","lines":["@@ -171,6 +171,14 @@ For further details on derenderer APIs, please refer to [this page](derenderer.m"," - `/scale_elastic_ep` - Trigger scaling operations"," - `/is_scaling_elastic_ep` - Check if scaling is in progress"," ","+## Process Checkpoint APIs","+","+For external checkpoint/restore orchestrators, available with `--enable-sleep-mode`. Preparing drains the engine and releases its KV cache and other external state, any number of times. Until `/checkpoint/restore`, new requests get a retryable error and `/health` still returns 200, as while asleep. `--checkpoint-prepare-on-startup` prepares each engine once it starts.","+","+- `/checkpoint/prepare` - Start preparing, draining with `?mode=wait` (default), `abort` or `keep`; 200 once started or already preparing, 400 if the engine cannot prepare now","+- `/checkpoint/status` - Return the state: 200 once prepared, 503 until then, 500 after a failure","+- `/checkpoint/restore` - Bring back released state and serve; 200 if already restoring or serving, 400 while preparing or after a failure","+"," ## Server in development mode"," "," When using the flag VLLM_SERVER_DEV_MODE=1, you enable development endpoints."],"additions":8,"deletions":0,"truncated":false},{"path":"docs/usage/security.md","lines":["@@ -207,6 +207,9 @@ The following endpoints **do not require authentication** even when `--api-key`"," - `/abort_requests` - Abort in-flight requests (causes loss of in-flight work)"," - `/scale_elastic_ep` - Trigger scaling operations"," - `/is_scaling_elastic_ep` - Check if scaling is in progress","+- `/checkpoint/prepare` - Prepare for a process checkpoint (stops serving, needs `--enable-sleep-mode`)","+- `/checkpoint/restore` - Restore after a process checkpoint (needs `--enable-sleep-mode`)","+- `/checkpoint/status` - Check if the server is prepared for a checkpoint (needs `--enable-sleep-mode`)"," - `/init_weight_transfer_engine` - Initialize weight transfer engine for RLHF"," - `/update_weights` - Update model weights (can alter model behavior)"," - `/get_world_size` - Get distributed world size"],"additions":3,"deletions":0,"truncated":false},{"path":"rust/src/engine-core-client/src/client.rs","lines":["@@ -21,7 +21,7 @@ use crate::protocol::dtype::ModelDtype;"," use crate::protocol::handshake::EngineCoreReadyResponse;"," use crate::protocol::lora::LoraRequest;"," use crate::protocol::request::{EngineCoreRequest, EngineCoreRequestType};","-use crate::protocol::utility::{EngineCoreUtilityRequest, PauseMode};","+use crate::protocol::utility::{CheckpointState, EngineCoreUtilityRequest, PauseMode};"," use crate::runtime::{BackgroundShutdownRuntime, build_zmq_runtime};"," use crate::transport::{self, ConnectedEngine};"," ","@@ -987,6 +987,43 @@ impl EngineCoreClient {","         Ok(())","     }"," ","+    /// Start preparing every engine for a process checkpoint: drain with","+    /// `mode`, then release the KV cache and what a checkpoint must not contain.","+    /// Returns the first refusal from any engine. An engine that refuses","+    /// changes nothing, but with data parallelism the others may have started.","+    pub async fn checkpoint_prepare(&self, mode: PauseMode) -> Result<Option<String>> {","+        let refusals: Vec<Option<String>> =","+            self.call_utility(\"checkpoint_prepare\", (mode,)).await?;","+        Ok(refusals.into_iter().flatten().next())","+    }","+","+    /// Bring back what `checkpoint_prepare` released and serve again.","+    pub async fn checkpoint_restore(&self) -> Result<()> {","+        self.call_utility::<(), _>(\"checkpoint_restore\", ()).await?;","+        Ok(())","+    }","+","+    /// Return the checkpoint lifecycle state and the error that failed it.","+    ///","+    /// Engines move independently: failed if any failed, otherwise the state","+    /// all engines share, otherwise the transition in progress.","+    pub async fn checkpoint_state(&self) -> Result<(CheckpointState, Option<String>)> {","+        let mut states: Vec<(CheckpointState, Option<String>)> =","+            self.call_utility(\"checkpoint_state\", ()).await?;","+        if let Some(index) = states.iter().position(|(state, _)| *state == CheckpointState::Failed)","+        {","+            return Ok(states.swap_remove(index));","+        }","+        let state = match states.iter().map(|(state, _)| *state).all_equal_value() {","+            Ok(state) => state,","+            Err(_) if states.iter().any(|(state, _)| *state == CheckpointState::Preparing) => {","+                CheckpointState::Preparing","+            }","+            Err(_) => CheckpointState::Restoring,","+        };","+        Ok((state, None))","+    }","+","     /// Return whether the scheduler is currently in any pause state.","     pub async fn is_scheduler_paused(&self) -> Result<bool> {","         self.call_utility_consensus(\"is_scheduler_paused\", ()).await"],"additions":38,"deletions":1,"truncated":false},{"path":"rust/src/engine-core-client/src/protocol/utility.rs","lines":["@@ -62,6 +62,62 @@ impl FromStr for PauseMode {","     }"," }"," ","+/// Process checkpoint lifecycle of an engine, as Python's `CheckpointState`.","+///","+/// It serves only while `Running`, and may go through the cycle any number of","+/// times. Display/from-str serde keeps the Python literal strings on the","+/// MessagePack wire and in JSON responses.","+#[derive(Debug, Clone, Copy, PartialEq, Eq, SerializeDisplay, DeserializeFromStr)]","+pub enum CheckpointState {","+    /// Serving requests.","+    Running,","+    /// Draining, then releasing what a checkpoint must not contain.","+    Preparing,","+    /// Safe to capture.","+    Prepared,","+    /// Bringing back what preparing released.","+    Restoring,","+    /// Preparing or restoring failed.","+    Failed,","+}","+","+impl CheckpointState {","+    /// Return the Python literal used on the utility-call wire.","+    pub fn as_str(self) -> &'static str {","+        match self {","+            Self::Running => \"running\",","+            Self::Preparing => \"preparing\",","+            Self::Prepared => \"prepared\",","+            Self::Restoring => \"restoring\",","+            Self::Failed => \"failed\",","+        }","+    }","+}","+","+impl fmt::Display for CheckpointState {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        f.write_str(self.as_str())","+    }","+}","+","+impl FromStr for CheckpointState {","+    type Err = String;","+","+    fn from_str(value: &str) -> std::result::Result<Self, Self::Err> {","+        match value {","+            \"running\" => Ok(Self::Running),","+            \"preparing\" => Ok(Self::Preparing),","+            \"prepared\" => Ok(Self::Prepared),","+            \"restoring\" => Ok(Self::Restoring),","+            \"failed\" => Ok(Self::Failed),","+            other => Err(format!(","+                \"invalid checkpoint state `{other}`; expected one of: running, preparing, \\","+                 prepared, restoring, failed\"","+            )),","+        }","+    }","+}","+"," /// Utility call id as carried on the engine-core MessagePack wire."," ///"," /// Python emits utility ids as MessagePack integers, including values that may"],"additions":56,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes.rs","lines":["@@ -3,6 +3,7 @@"," "," mod abort_requests;"," mod cache;","+mod checkpoint;"," mod collective_rpc;"," mod health;"," mod inference;","@@ -184,6 +185,19 @@ fn build_router_with_options(","         router = router.route(\"/tokenizer_info\", get(not_supported));","     }"," ","+    // Process checkpoint lifecycle, which requires sleep mode.","+    if state","+        .engine_core_client()","+        .ready_responses()","+        .iter()","+        .all(|ready| ready.enable_sleep_mode)","+    {","+        router = router","+            .route(\"/checkpoint/prepare\", post(checkpoint::prepare))","+            .route(\"/checkpoint/restore\", post(checkpoint::restore))","+            .route(\"/checkpoint/status\", get(checkpoint::status));","+    }","+","     if runtime_lora_updating_enabled {","         router = router","             .route(\"/v1/load_lora_adapter\", post(lora::load_lora_adapter))"],"additions":14,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes/checkpoint.rs","lines":["@@ -0,0 +1,117 @@","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+use std::sync::Arc;","+","+use axum::Json;","+use axum::extract::rejection::QueryRejection;","+use axum::extract::{Query, State};","+use axum::http::StatusCode;","+use serde::{Deserialize, Serialize};","+use vllm_engine_core_client::protocol::utility::{CheckpointState, PauseMode};","+","+use crate::error::ApiError;","+use crate::state::AppState;","+use crate::utils::utility_call_error;","+","+#[derive(Debug, Deserialize)]","+pub(crate) struct PrepareParams {","+    #[serde(default = \"default_prepare_mode\")]","+    mode: PauseMode,","+}","+","+const fn default_prepare_mode() -> PauseMode {","+    PauseMode::Wait","+}","+","+#[derive(Serialize)]","+pub(crate) struct CheckpointStateResponse {","+    state: CheckpointState,","+    #[serde(skip_serializing_if = \"Option::is_none\")]","+    error: Option<String>,","+}","+","+type CheckpointResult = Result<(StatusCode, Json<CheckpointStateResponse>), ApiError>;","+","+fn state_response(","+    status: StatusCode,","+    state: CheckpointState,","+    error: Option<String>,","+) -> CheckpointResult {","+    Ok((status, Json(CheckpointStateResponse { state, error })))","+}","+","+async fn current_state(state: &AppState) -> Result<(CheckpointState, Option<String>), ApiError> {","+    state","+        .engine_core_client()","+        .checkpoint_state()","+        .await","+        .map_err(|error| utility_call_error(\"checkpoint_state\", error))","+}","+","+/// Drain with `mode` and release what a process checkpoint must not contain.","+/// Returns once started: poll `/checkpoint/status` until it is 200. Repeating","+/// is a no-op.","+pub async fn prepare(","+    State(state): State<Arc<AppState>>,","+    params: Result<Query<PrepareParams>, QueryRejection>,","+) -> CheckpointResult {","+    let Query(params) =","+        params.map_err(|error| ApiError::invalid_request(error.body_text(), Some(\"mode\")))?;","+    let (mut checkpoint_state, mut error) = current_state(&state).await?;","+    match checkpoint_state {","+        CheckpointState::Running => {","+            if let Some(refusal) = state","+                .engine_core_client()","+                .checkpoint_prepare(params.mode)","+                .await","+                .map_err(|error| utility_call_error(\"checkpoint_prepare\", error))?","+            {","+                return state_response(StatusCode::BAD_REQUEST, checkpoint_state, Some(refusal));","+            }","+            (checkpoint_state, error) = current_state(&state).await?;","+        }","+        CheckpointState::Restoring | CheckpointState::Failed => {","+            return state_response(StatusCode::BAD_REQUEST, checkpoint_state, error);","+        }","+        CheckpointState::Preparing | CheckpointState::Prepared => {}","+    }","+    state_response(StatusCode::OK, checkpoint_state, error)","+}","+","+/// Bring back what preparing released and serve, in the restored process or","+/// in place. Orchestrators may deliver this more than once, so a restore in","+/// progress or done returns 200.","+pub async fn restore(State(state): State<Arc<AppState>>) -> CheckpointResult {","+    let (mut checkpoint_state, mut error) = current_state(&state).await?;","+    match checkpoint_state {","+        CheckpointState::Preparing | CheckpointState::Failed => {","+            return state_response(StatusCode::BAD_REQUEST, checkpoint_state, error);","+        }","+        CheckpointState::Prepared => {","+            state","+                .engine_core_client()","+                .checkpoint_restore()","+                .await","+                .map_err(|error| utility_call_error(\"checkpoint_restore\", error))?;","+            (checkpoint_state, error) = current_state(&state).await?;","+        }","+        CheckpointState::Running | CheckpointState::Restoring => {}","+    }","+    state_response(StatusCode::OK, checkpoint_state, error)","+}","+","+/// Return 200 once every engine is prepared, 503 until then and 500 if that","+/// cannot happen, so orchestrators can poll it to learn when the process is","+/// safe to capture.","+pub async fn status(State(state): State<Arc<AppState>>) -> CheckpointResult {","+    let (checkpoint_state, error) = current_state(&state).await?;","+    let status = match checkpoint_state {","+        CheckpointState::Prepared => StatusCode::OK,","+        CheckpointState::Failed => StatusCode::INTERNAL_SERVER_ERROR,","+        CheckpointState::Running | CheckpointState::Preparing | CheckpointState::Restoring => {","+            StatusCode::SERVICE_UNAVAILABLE","+        }","+    };","+    state_response(status, checkpoint_state, error)","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"tests/entrypoints/serve/middleware/test_authentication_middleware.py","lines":["@@ -63,6 +63,8 @@ class MockModelConfig:","     def __init__(self):","         self.hf_config = Namespace()","         self.hf_config.num_labels = 1","+        # Register the process checkpoint routes, which require sleep mode.","+        self.enable_sleep_mode = True"," ","     def get_pooling_task(self, supported_tasks: tuple[\"SupportedTask\", ...]):","         pooling_tasks = [s for s in supported_tasks if s in POOLING_TASKS]"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/v1/engine/test_engine_core.py","lines":["@@ -25,7 +25,12 @@"," from vllm.platforms import current_platform"," from vllm.utils.torch_utils import set_default_torch_num_threads"," from vllm.v1.core.sched.interface import PauseState","-from vllm.v1.engine import EngineCoreRequest, EngineCoreRequestType, FinishReason","+from vllm.v1.engine import (","+    CheckpointState,","+    EngineCoreRequest,","+    EngineCoreRequestType,","+    FinishReason,","+)"," from vllm.v1.engine.core import (","     DPEngineCoreProc,","     EngineCore,","@@ -852,6 +857,65 @@ def test_wake_up_republishes_kv_connector_handshake_metadata(tags, republished):","     assert calls == ([\"wake_up\", \"publish\"] if republished else [\"wake_up\"])"," "," ","+def _executor_calls(core: EngineCoreProc) -> list[str]:","+    \"\"\"Executor calls in order, naming collective RPCs by their method.\"\"\"","+    return [","+        args[0] if name == \"collective_rpc\" else name","+        for name, args, _ in core.model_executor.mock_calls","+    ]","+","+","+def test_checkpoint_prepare_then_restore_run_in_order():","+    \"\"\"Preparing drains, then discards the KV cache and releases external","+    state. Restoring brings external state back before the KV cache wakes and","+    scheduling resumes. Repeating either is a no-op.\"\"\"","+    core = _pausable_engine_core_proc()","+    core.vllm_config = MagicMock()","+    core.model_executor.is_sleeping = False","+    core._reset_caches = MagicMock()","+    core.reject_new_requests = False","+    core.scheduler.get_kv_connector.return_value = None","+","+    assert core.checkpoint_prepare(\"wait\") is None","+    assert core.checkpoint_prepare(\"wait\") is None","+    assert core.checkpoint_state() == (CheckpointState.PREPARED, None)","+    assert core.reject_new_requests","+    assert _executor_calls(core) == [","+        \"synchronize_device\",","+        \"discard\",","+        \"checkpoint_prepare\",","+        \"synchronize_device\",","+    ]","+","+    core.model_executor.reset_mock()","+    core.checkpoint_restore()","+    core.checkpoint_restore()","+    assert core.checkpoint_state() == (CheckpointState.RUNNING, None)","+    assert _executor_calls(core) == [\"checkpoint_restore\", \"wake_up\"]","+    core.scheduler.set_pause_state.assert_called_with(PauseState.UNPAUSED)","+    assert not core.reject_new_requests","+","+","+@pytest.mark.parametrize(\"deferred\", [False, True])","+def test_checkpoint_prepare_fails_on_drain_barrier_error(deferred: bool):","+    \"\"\"A failing barrier at the end of the drain leaves the engine FAILED and","+    still rejecting, whether the drain completes at once or later.\"\"\"","+    core = _pausable_engine_core_proc()","+    core.vllm_config = MagicMock()","+    core.model_executor.is_sleeping = False","+    core.model_executor.collective_rpc.side_effect = RuntimeError(\"device lost\")","+    core.reject_new_requests = False","+    core.engines_running = deferred","+","+    assert core.checkpoint_prepare(\"wait\") is None","+    if deferred:","+        assert core.checkpoint_state() == (CheckpointState.PREPARING, None)","+        core.engines_running = False","+        core._notify_idle_state_callbacks()","+    assert core.checkpoint_state() == (CheckpointState.FAILED, \"device lost\")","+    assert core.reject_new_requests","+","+"," @pytest.mark.parametrize(\"deferred\", [False, True])"," def test_pause_synchronizes_device_before_cache_reset(deferred: bool):","     \"\"\"A resolved pause promises an idle device: the barrier must run before"],"additions":65,"deletions":1,"truncated":false},{"path":"vllm/config/model.py","lines":["@@ -388,6 +388,10 @@ class ModelConfig:","     \"\"\"Enable releasing NCCL communicator memory during sleep mode","     (``ncclCommSuspend``/``ncclCommResume``). Experimental; when disabled","     (the default) sleep still releases weights/KV-cache memory as before.\"\"\"","+    checkpoint_prepare_on_startup: bool = False","+    \"\"\"Prepare each engine for a process checkpoint once it starts, as","+    `/checkpoint/prepare` does. It serves only after `/checkpoint/restore`.","+    Requires sleep mode.\"\"\"","     enable_cumem_allocator: bool = False","     \"\"\"Enable the custom cumem allocator to leverage advanced GPU memory","     allocation features such as multi-node NVLink support.","@@ -500,6 +504,7 @@ def compute_hash(self) -> str:","             \"interleave_mm_strings\",","             \"skip_mm_profiling\",","             \"mm_ipc_gpu_memory_gb\",","+            \"checkpoint_prepare_on_startup\",","         }"," ","         from vllm.config.utils import get_hash_factors, hash_factors","@@ -663,6 +668,8 @@ def __post_init__(","                 self.hf_token,","             )"," ","+        if self.checkpoint_prepare_on_startup and not self.enable_sleep_mode:","+            raise ValueError(\"checkpoint_prepare_on_startup requires enable_sleep_mode\")","         if self.enable_sleep_mode:","             if not current_platform.is_sleep_mode_available():","                 raise ValueError(\"Sleep mode is not supported on current platform.\")"],"additions":7,"deletions":0,"truncated":false},{"path":"vllm/engine/arg_utils.py","lines":["@@ -804,6 +804,7 @@ class EngineArgs:","     )","     enable_cumem_allocator: bool = ModelConfig.enable_cumem_allocator","     enable_nccl_comm_suspend: bool = ModelConfig.enable_nccl_comm_suspend","+    checkpoint_prepare_on_startup: bool = ModelConfig.checkpoint_prepare_on_startup","     override_generation_config: dict[str, Any] = get_field(","         ModelConfig, \"override_generation_config\"","     )","@@ -1064,6 +1065,10 @@ def add_cli_args(parser: FlexibleArgumentParser) -> FlexibleArgumentParser:","             \"--enable-nccl-comm-suspend\",","             **model_kwargs[\"enable_nccl_comm_suspend\"],","         )","+        model_group.add_argument(","+            \"--checkpoint-prepare-on-startup\",","+            **model_kwargs[\"checkpoint_prepare_on_startup\"],","+        )","         model_group.add_argument(\"--model-impl\", **model_kwargs[\"model_impl\"])","         model_group.add_argument(","             \"--logits-processors\", **model_kwargs[\"logits_processors\"]","@@ -2052,6 +2057,7 @@ def create_model_config(self) -> ModelConfig:","             sleep_preserve_parameter_names=self.sleep_preserve_parameter_names,","             enable_cumem_allocator=self.enable_cumem_allocator,","             enable_nccl_comm_suspend=self.enable_nccl_comm_suspend,","+            checkpoint_prepare_on_startup=self.checkpoint_prepare_on_startup,","             model_impl=self.model_impl,","             logits_processors=self.logits_processors,","             video_pruning_rate=self.video_pruning_rate,"],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/engine/protocol.py","lines":["@@ -19,7 +19,7 @@"," from vllm.renderers import BaseRenderer"," from vllm.sampling_params import SamplingParams"," from vllm.tasks import SupportedTask","-from vllm.v1.engine import EngineCoreRequest","+from vllm.v1.engine import CheckpointState, EngineCoreRequest"," from vllm.v1.engine.input_processor import InputProcessor"," from vllm.v1.fault_tolerance.utils import FaultToleranceRequest, FaultToleranceResult"," from vllm.v1.kv_hints import KvHintsEnvelope","@@ -219,6 +219,22 @@ async def is_sleeping(self) -> bool:","         \"\"\"Check whether the engine is sleeping.\"\"\"","         ..."," ","+    @abstractmethod","+    async def checkpoint_prepare(self, mode: \"PauseMode\" = \"wait\") -> str | None:","+        \"\"\"Drain with `mode`, then release what a checkpoint must not contain.","+        Returns why the engine cannot prepare, with nothing changed, or None.\"\"\"","+        ...","+","+    @abstractmethod","+    async def checkpoint_restore(self) -> None:","+        \"\"\"Bring back what preparing released, in the restored process or in place.\"\"\"","+        ...","+","+    @abstractmethod","+    async def checkpoint_state(self) -> tuple[CheckpointState, str | None]:","+        \"\"\"Return the checkpoint lifecycle state and the error that failed it.\"\"\"","+        ...","+","     @abstractmethod","     async def add_lora(self, lora_request: LoRARequest) -> bool:","         \"\"\"Load a new LoRA adapter into the engine for future requests.\"\"\""],"additions":17,"deletions":1,"truncated":false},{"path":"vllm/entrypoints/launchers/api_server/routers.py","lines":["@@ -65,6 +65,13 @@ def register_api_routers("," ","         elastic_ep_attach_router(app)"," ","+        if model_config is not None and model_config.enable_sleep_mode:","+            from vllm.entrypoints.serve.checkpoint.api_router import (","+                attach_router as checkpoint_attach_router,","+            )","+","+            checkpoint_attach_router(app)","+","     if \"generate\" in supported_tasks or \"render\" in supported_tasks:","         from vllm.entrypoints.scale_out.factories import register_scale_out_api_routers"," "],"additions":7,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/serve/checkpoint/__init__.py","lines":[],"additions":0,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/serve/checkpoint/api_router.py","lines":["@@ -0,0 +1,102 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+from http import HTTPStatus","+","+from fastapi import APIRouter, FastAPI, Request","+from fastapi.responses import JSONResponse","+from pydantic import BaseModel","+","+from vllm.engine.protocol import EngineClient","+from vllm.v1.engine import CheckpointState, PauseMode","+","+","+def engine_client(request: Request) -> EngineClient:","+    return request.app.state.engine_client","+","+","+router = APIRouter()","+","+","+class CheckpointStateResponse(BaseModel):","+    state: CheckpointState","+    error: str | None = None","+","+","+_STATE_RESPONSE = {\"model\": CheckpointStateResponse}","+","+","+def _state_response(","+    state: CheckpointState, error: str | None, status_code: HTTPStatus","+) -> JSONResponse:","+    content = CheckpointStateResponse(state=state, error=error)","+    return JSONResponse(","+        content=content.model_dump(mode=\"json\", exclude_none=True),","+        status_code=status_code.value,","+    )","+","+","+@router.post(","+    \"/checkpoint/prepare\",","+    responses={","+        HTTPStatus.OK.value: _STATE_RESPONSE,","+        HTTPStatus.BAD_REQUEST.value: _STATE_RESPONSE,","+    },","+)","+async def checkpoint_prepare(raw_request: Request, mode: PauseMode = \"wait\"):","+    \"\"\"Drain with `mode` and release what a checkpoint must not contain.","+    Returns once started; poll /checkpoint/status. Repeating is a no-op.\"\"\"","+    client = engine_client(raw_request)","+    state, error = await client.checkpoint_state()","+    if state == CheckpointState.RUNNING:","+        if refusal := await client.checkpoint_prepare(mode):","+            return _state_response(state, refusal, HTTPStatus.BAD_REQUEST)","+        state, error = await client.checkpoint_state()","+    elif state in (CheckpointState.RESTORING, CheckpointState.FAILED):","+        return _state_response(state, error, HTTPStatus.BAD_REQUEST)","+    return _state_response(state, error, HTTPStatus.OK)","+","+","+@router.post(","+    \"/checkpoint/restore\",","+    responses={","+        HTTPStatus.OK.value: _STATE_RESPONSE,","+        HTTPStatus.BAD_REQUEST.value: _STATE_RESPONSE,","+    },","+)","+async def checkpoint_restore(raw_request: Request):","+    \"\"\"Bring back what preparing released and serve. Orchestrators may","+    redeliver, so a restore in progress or done returns 200.\"\"\"","+    client = engine_client(raw_request)","+    state, error = await client.checkpoint_state()","+    if state in (CheckpointState.PREPARING, CheckpointState.FAILED):","+        return _state_response(state, error, HTTPStatus.BAD_REQUEST)","+    if state == CheckpointState.PREPARED:","+        await client.checkpoint_restore()","+        state, error = await client.checkpoint_state()","+    return _state_response(state, error, HTTPStatus.OK)","+","+","+@router.get(","+    \"/checkpoint/status\",","+    responses={","+        HTTPStatus.OK.value: _STATE_RESPONSE,","+        HTTPStatus.INTERNAL_SERVER_ERROR.value: _STATE_RESPONSE,","+        HTTPStatus.SERVICE_UNAVAILABLE.value: _STATE_RESPONSE,","+    },","+)","+async def checkpoint_status(raw_request: Request):","+    # Polled by orchestrators: 200 once prepared (safe to capture), 503 until","+    # then, 500 after a failure.","+    state, error = await engine_client(raw_request).checkpoint_state()","+    if state == CheckpointState.PREPARED:","+        status_code = HTTPStatus.OK","+    elif state == CheckpointState.FAILED:","+        status_code = HTTPStatus.INTERNAL_SERVER_ERROR","+    else:","+        status_code = HTTPStatus.SERVICE_UNAVAILABLE","+    return _state_response(state, error, status_code)","+","+","+def attach_router(app: FastAPI):","+    app.include_router(router)"],"additions":102,"deletions":0,"truncated":false},{"path":"vllm/v1/engine/__init__.py","lines":["@@ -41,6 +41,26 @@"," FT_STATUS_CALL_ID = -2"," "," ","+class CheckpointState(enum.StrEnum):","+    \"\"\"Process checkpoint lifecycle of an engine. It serves only while","+    RUNNING, and may go through the cycle any number of times.\"\"\"","+","+    RUNNING = \"running\"","+    # Draining, then releasing what a checkpoint must not contain.","+    PREPARING = \"preparing\"","+    # Safe to capture.","+    PREPARED = \"prepared\"","+    # Bringing back what preparing released.","+    RESTORING = \"restoring\"","+    FAILED = \"failed\"","+","+    @property","+    def is_restored(self) -> bool:","+        \"\"\"Whether released state is back or coming back, so memory may wake and","+        scheduling resume.\"\"\"","+        return self in (CheckpointState.RUNNING, CheckpointState.RESTORING)","+","+"," class EEPNotificationType(enum.Enum):","     RECONFIGURE_FINISHED = \"RECONFIGURE_FINISHED\"","     SHUTDOWN_COMPLETE = \"SHUTDOWN_COMPLETE\""],"additions":20,"deletions":0,"truncated":false},{"path":"vllm/v1/engine/async_llm.py","lines":["@@ -53,7 +53,7 @@"," from vllm.usage.usage_lib import UsageContext"," from vllm.utils.async_utils import cancel_task_threadsafe"," from vllm.utils.collection_utils import as_list","-from vllm.v1.engine import EngineCoreRequest, PauseMode","+from vllm.v1.engine import CheckpointState, EngineCoreRequest, PauseMode"," from vllm.v1.engine.admission_control import SharedAdmissionStats"," from vllm.v1.engine.core_client import EngineCoreClient"," from vllm.v1.engine.exceptions import EngineDeadError, EngineGenerateError","@@ -1218,11 +1218,18 @@ async def wake_up(self, tags: list[str] | None = None) -> bool:"," ","         return fully_awake"," ","-    async def checkpoint_prepare(self) -> None:","-        await self.collective_rpc(\"checkpoint_prepare\")","+    async def checkpoint_prepare(self, mode: PauseMode = \"wait\") -> str | None:","+        refusal = await self.engine_core.checkpoint_prepare_async(mode)","+        if refusal is None:","+            # Preparing resets the engine's multimodal cache.","+            await self.renderer.clear_mm_cache_async()","+        return refusal"," ","     async def checkpoint_restore(self) -> None:","-        await self.collective_rpc(\"checkpoint_restore\")","+        await self.engine_core.checkpoint_restore_async()","+","+    async def checkpoint_state(self) -> tuple[CheckpointState, str | None]:","+        return await self.engine_core.checkpoint_state_async()"," ","     async def is_sleeping(self) -> bool:","         return await self.engine_core.is_sleeping_async()"],"additions":11,"deletions":4,"truncated":false},{"path":"vllm/v1/engine/core.py","lines":["@@ -72,6 +72,7 @@"," from vllm.v1.core.single_type_kv_cache_manager import register_all_kvcache_specs"," from vllm.v1.engine import (","     EEP_NOTIFICATION_CALL_ID,","+    CheckpointState,","     EEPNotificationType,","     Engi