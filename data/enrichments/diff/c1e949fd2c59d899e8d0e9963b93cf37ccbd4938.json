/* Validate some offset, since the structure is API and src/ukify/ukify.py encodes them directly */","-assert_cc(offsetof(Device, descriptor) == 0);","-assert_cc(offsetof(Device, chid) == 4);","-assert_cc(offsetof(Device, devicetree.name_offset) == 20);","-assert_cc(offsetof(Device, devicetree.compatible_offset) == 24);","-assert_cc(offsetof(Device, uefi_fw.name_offset) == 20);","-assert_cc(offsetof(Device, uefi_fw.fwid_offset) == 24);","-assert_cc(sizeof(Device) == 28);","-"," static inline const char* device_get_name(const void *base, const Device *device) {","         size_t off = 0;","         switch (DEVICE_TYPE_FROM_DESCRIPTOR(device->descriptor)) {"],"additions":0,"deletions":55,"truncated":false},{"path":"src/boot/efi-firmware.h","lines":["@@ -3,28 +3,6 @@"," "," #include \"efi.h\""," ","-#define FWHEADERMAGIC (UINT32_C(0xfeeddead))","-","-/* The structure of the efifw UKI blob is the following:","- * ---------------------------------------------------------","- * EfiFw header|fwid|payload| reserved for future attributes","- * ---------------------------------------------------------","- * The base header defines the length of full header, fwid and payload.","- * The fwid is a NUL terminated string.","- * The payload contains the actual efi firmware. */","-typedef struct EfiFwHeader {","-        uint32_t magic; /* magic number that defines Efifw */","-        uint32_t header_len; /* total length of header including all attributes */","-        uint32_t fwid_len; /* length including the NUL terminator */","-        uint32_t payload_len; /* actual length of the efi firmware binary image */","-","-        /* The header might be extended in the future to add additional","-         * parameters. header_len will increase to indicate presence of these","-         * additional attributes.","-         */","-","-        /* next comes payload which is fwid and efi firmware binary blob */","-        uint8_t payload[] _alignas_(uint64_t);","-} EfiFwHeader;","+#include \"../fundamental/efi-firmware.h\" /* IWYU pragma: export */"," "," EFI_STATUS efi_firmware_match_by_fwid(const void *blob, size_t blob_len, const char *fwid);"],"additions":1,"deletions":23,"truncated":false},{"path":"src/boot/fuzz-bmp.c","lines":["@@ -0,0 +1,38 @@","+/* SPDX-License-Identifier: LGPL-2.1-or-later */","+","+#include <endian.h>","+","+#include \"bmp.h\"","+#include \"fuzz.h\"","+","+int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {","+        const struct bmp_dib *dib;","+        const struct bmp_map *map;","+        const uint8_t *pixmap;","+","+        if (outside_size_range(size, 0, 64 * 1024))","+                return 0;","+","+        fuzz_setup_logging();","+","+        if (bmp_parse_header(data, size, &dib, &map, &pixmap) < 0)","+                return 0;","+","+        /* systemd-stub reads the DIB header through dib, the color map through map, and the pixels through","+         * pixmap. */","+        assert_se((const uint8_t*) dib == data + sizeof(struct bmp_file));","+        assert_se((const uint8_t*) map <= pixmap);","+        assert_se(pixmap <= data + size);","+","+        uint32_t x = le32toh(dib->x), y = le32toh(dib->y);","+        uint16_t depth = le16toh(dib->depth);","+        uint64_t row_size = ((uint64_t) depth * x + 31) / 32 * 4;","+        assert_se(y > 0);","+        assert_se(row_size > 0);","+        assert_se(row_size <= (uint64_t) (data + size - pixmap) / y);","+","+        if (IN_SET(depth, 1, 4, 8))","+                assert_se((size_t) (pixmap - (const uint8_t*) map) >= sizeof(struct bmp_map) << depth);","+","+        return 0;","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"src/boot/generate-hwids-section.py","lines":["@@ -10,7 +10,7 @@"," "," BYTES_PER_LINE = 16"," ","-# Keep in sync with Device from src/boot/chid.h","+# Keep in sync with Device from src/fundamental/chid.h"," # uint32_t descriptor, EFI_GUID chid, uint32_t name_offset, uint32_t compatible_offset"," DEVICE_STRUCT_SIZE = 4 + 