age,","+            \"Error response\"","+        );","+    }","+    response","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"rust/src/server/src/middleware/mod.rs","lines":["@@ -4,6 +4,7 @@"," mod access_log;"," mod auth;"," mod cors;","+mod error_log;"," mod load;"," mod metrics;"," mod offload;","@@ -12,6 +13,7 @@ mod request_id;"," pub use access_log::log_access;"," pub use auth::authenticate_api_key;"," pub use cors::{cors_layer, strip_cors_on_no_origin};","+pub use error_log::log_error_response;"," pub use load::track_server_load;"," pub use metrics::track_http_metrics;"," pub(crate) use offload::request_runtime_layer;"],"additions":2,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes.rs","lines":["@@ -89,13 +89,6 @@ async fn not_supported(method: Method, path: MatchedPath) -> (StatusCode, Json<E","     )"," }"," ","-fn server_dev_mode_enabled() -> bool {","-    std::env::var(\"VLLM_SERVER_DEV_MODE\")","-        .ok()","-        .and_then(|value| value.parse::<i64>().ok())","-        .is_some_and(|value| value != 0)","-}","-"," fn runtime_lora_updating_enabled() -> bool {","     std::env::var(\"VLLM_ALLOW_RUNTIME_LORA_UPDATING\")","         .ok()","@@ -126,7 +119,7 @@ struct RouteGates {"," impl RouteGates {","     fn resolve(state: &AppState) -> Self {","         Self {","-            dev_mode: server_dev_mode_enabled(),","+            dev_mode: state.api_server_options.server_dev_mode,","             runtime_lora_updating: runtime_lora_updating_enabled(),","             scale_out: state.api_server_options.enable_scale_out,","             cohere_api: cohere_api_enabled(),","@@ -285,6 +278,7 @@ fn build_router_with_gates(state: Arc<AppState>, gates: RouteGates) -> Router {","     }"," ","     let enable_request_id_headers = state.api_server_options.enable_request_id_headers;","+    let log_error_stack = state.api_server_options.log_error_stack;","     let enable_api_key_auth = state.has_api_keys();","     let enable_access_log = state.access_log.enabled;","     let mut router = router","@@ -302,6 +296,10 @@ fn build_router_with_gates(state: Arc<AppState>, gates: RouteGates) -> Router {","         .layer(middleware::cors_layer(&state.cors))","         .layer(from_fn(middleware::strip_cors_on_no_origin));"," ","+    if log_error_stack {","+        router = router.layer(from_fn(middleware::log_error_response));","+    }","+","     if enable_api_key_auth {","         router = router.layer(from_fn_with_state(","             state.clone(),"],"additions":6,"deletions":8,"truncated":false},{"path":"rust/src/server/src/routes/tests.rs","lines":["@@ -867,6 +867,40 @@ async fn scale_out_generate_route_follows_api_server_options() {","     assert_eq!(response.status(), StatusCode::BAD_REQUEST);"," }"," ","+/// `VLLM_SERVER_DEV_MODE` reaches the router through `ApiServerOptions`.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+#[serial]","+async fn dev_routes_follow_api_server_options() {","+    for (server_dev_mode, expected) in [(false, StatusCode::NOT_FOUND), (true, StatusCode::OK)] {","+        let (chat, engine_task) = test_chat_with_engine_handle().await;","+        let app = build_router(Arc::new(","+            AppState::new(vec![\"model\".to_string()], chat).with_api_server_options(","+                ApiServerOptions {","+                    server_dev_mode,","+                    ..Default::default()","+                },","+            ),","+        ));","+","+        let response = app","+            .oneshot(","+                Request::builder()","+                    .uri(\"/get_world_size\")","+                    .body(Body::empty())","+                    .expect(\"build request\"),","+            )","+            .await","+            .expect(\"call app\");","+        assert_eq!(","+            response.status(),","+            expected,","+            \"server_dev_mode={server_dev_mode}\"","+        );","+","+        engine_task.abort_and_join().await;","+    }","+}","+"," /// Assert that `method uri` hits the 501 placeholder for the Python route"," /// `route`."," async fn assert_route_not_supported(app: &axum::Router, method: &str, uri: &str, route: &str) {","@@ -10619,6 +10653,91 @@ async fn access_log_disabled_logs_nothing() {","     assert_eq!(lines, Vec::<String>::new());"," }"," ","+/// Captures the `--log-error-stack` events as `LEVEL field=value ...`.","+#[derive(Clone, Default)]","+struct ErrorLogCapture(Arc<std::sync::Mutex<Vec<String>>>);","+","+impl<S: tracing::Subscriber> tracing_subscriber::Layer<S> for ErrorLogCapture {","+    fn on_event(","+        &self,","+        event: &tracing::Event<'_>,","+        _ctx: tracing_subscriber::layer::Context<'_, S>,","+    ) {","+        if event.metadata().target() != \"vllm_server::middleware::error_log\" {","+            return;","+        }","+        let mut line = event.metadata().level().to_string();","+        event.record(","+            &mut |field: &tracing::field::Field, value: &dyn fmt::Debug| {","+                line.push_str(&format!(\" {}={value:?}\", field.name()));","+            },","+        );","+        self.0.lock().expect(\"error log lock\").push(line);","+    }","+}","+","+/// Send one good and two bad requests, and return what got logged.","+async fn error_log_lines(log_error_stack: bool) -> Vec<String> {","+    use tracing_subscriber::layer::SubscriberExt as _;","+","+    let (chat, engine_task) = test_chat_with_engine_handle().await;","+    let app = build_router(Arc::new(","+        AppState::new(vec![\"test-model\".to_string()], chat).with_api_server_options(","+            ApiServerOptions {","+                log_error_stack,","+                ..Default::default()","+            },","+        ),","+    ));","+    let capture = ErrorLogCapture::default();","+    let _guard =","+        tracing::subscriber::set_default(tracing_subscriber::registry().with(capture.clone()));","+","+    let chat = |body: &str| {","+        Request::builder()","+            .method(\"POST\")","+            .uri(\"/v1/chat/completions\")","+            .header(\"content-type\", \"application/json\")","+            .body(Body::from(body.to_owned()))","+            .expect(\"build request\")","+    };","+    let requests = [","+        Request::builder()","+            .method(\"GET\")","+            .uri(\"/v1/models\")","+            .body(Body::empty())","+            .expect(\"build request\"),","+        chat(r#\"{\"model\":\"missing\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}\"#),","+        chat(\"{not json\"),","+    ];","+    for request in requests {","+        let response = app.clone().oneshot(request).await.expect(\"call app\");","+        to_bytes(response.into_body(), usize::MAX).await.expect(\"read body\");","+    }","+","+    engine_task.abort_and_join().await;","+    capture.0.lock().expect(\"error log lock\").clone()","+}","+","+/// Only the failed requests are logged.","+#[tokio::test]","+#[serial]","+async fn log_error_stack_logs_error_responses() {","+    expect_test::expect![[r#\"","+        [","+            \"ERROR message=Error response method=POST path=\\\"/v1/chat/completions\\\" status=404 error_type=\\\"NotFoundError\\\" error=\\\"The model `missing` does not exist.\\\"\",","+            \"ERROR message=Error response method=POST path=\\\"/v1/chat/completions\\\" status=400 error_type=\\\"Bad Request\\\" error=\\\"Failed to parse the request body as JSON: key must be a string at line 1 column 2\\\"\",","+        ]","+    \"#]].assert_debug_eq(&error_log_lines(true).await);","+}","+","+/// Without `--log-error-stack`, error responses are not logged.","+#[tokio::test]","+#[serial]","+async fn log_error_stack_disabled_logs_nothing() {","+    assert_eq!(error_log_lines(false).await, Vec::<String>::new());","+}","+"," /// Captures the events `--enable-log-outputs` logs, one `LEVEL field=value ...`"," /// line per event."," #[derive(Clone, Default)]",""],"additions":119,"deletions":0,"truncated":false}],"additions":267,"deletions":30,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-04T16:05:30.933302+00:00"}