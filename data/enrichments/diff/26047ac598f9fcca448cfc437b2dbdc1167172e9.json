       }","                 Err(err) if is_unique_violation(&err) => {","                     tx.rollback().await?;","-                    return self.login_after_lost_insert(username, password).await;","+                    Ok(Insert::NameTaken)","                 }","-                Err(err) => return Err(err.into()),","+                Err(err) => Err(RegistryError::from(err)),","             }","-        }","+        })","+        .await","+    }","+","+    /// Correct a counter that overcounts, reporting whether it did.","+    async fn reconcile_user_counter(&self) -> Result<bool> {","+        self.pool.run(|conn| async move { reconcile_user_counter_overcount(&conn).await }).await","     }"," ","     /// Claim a counter slot in `tx`. The transaction comes back when a slot","@@ -403,15 +441,26 @@ impl LibsqlAuth {","             verify_returning_user(username, password, stored.clone(), DEFAULT_BCRYPT_COST).await?;","         if is_sha_hash(&stored) {","             let new_hash = hash_bcrypt(password.to_string(), DEFAULT_BCRYPT_COST).await?;","-            self.conn.execute(","-                \"UPDATE users SET bcrypt_hash = ?1 WHERE username = ?2 AND bcrypt_hash = ?3\",","-                params![new_hash, username, stored],","-            )","+            self.pool.run(|conn| async move {","+                conn.execute(","+                    \"UPDATE users SET bcrypt_hash = ?1 WHERE username = ?2 AND bcrypt_hash = ?3\",","+                    params![new_hash, username, stored],","+                )","+                .await","+            })","             .await?;","         }","         Ok((outcome, user))","     }"," }"," ","+/// How a registration's insert ended, decided on its connection and acted on","+/// after the connection is returned.","+enum Insert {","+    Created,","+    NameTaken,","+    CapFull,","+}","+"," #[cfg(test)]"," mod tests;"],"additions":110,"deletions":61,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/connector/tests.rs","lines":["@@ -37,7 +37,13 @@ fn connector_trusting_test_ca() -> LibsqlConnector {"," }"," "," fn settings(url: String) -> LibsqlSettings {","-    LibsqlSettings { url, auth_token: None, replica_path: None, sync_interval_secs: None }","+    LibsqlSettings {","+        url,","+        auth_token: None,","+        replica_path: None,","+        sync_interval_secs: None,","+        max_connections: None,","+    }"," }"," "," #[tokio::test]"],"additions":7,"deletions":1,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/pool.rs","lines":["@@ -0,0 +1,71 @@","+//! The connections the libsql backend runs its operations on.","+","+use super::{Connection, Database, LibsqlError};","+use std::{future::Future, sync::Mutex};","+use tokio::sync::Semaphore;","+","+/// Connections to one database, each running one operation at a time.","+///","+/// A remote connection is a stream on the server, and each response hands the","+/// client the token for its next request on that stream. An operation dropped","+/// while a request is in flight (a client that disconnected, an auth timeout)","+/// never receives that token, so the stream rejects every later request. A","+/// failed operation can leave its stream in a state just as unknown, and one","+/// still inside a transaction would pull the next operation into it. A","+/// connection therefore returns to the pool only after its operation succeeded","+/// outside a transaction; any other is closed, and a later checkout opens a","+/// fresh one. A pooled connection keeps its HTTP client, so reusing it costs","+/// no new TCP or TLS handshake.","+pub(super) struct ConnectionPool {","+    db: Database,","+    idle: Mutex<Vec<Connection>>,","+    slots: Semaphore,","+}","+","+impl ConnectionPool {","+    /// A pool that runs at most `max_connections` operations at once.","+    pub(super) fn new(db: Database, max_connections: usize) -> Self {","+        Self { db, idle: Mutex::new(Vec::new()), slots: Semaphore::new(max_connections) }","+    }","+","+    /// Run `operation` on a pooled connection, waiting for one when every","+    /// connection is busy.","+    ///","+    /// `operation` must not call [`Self::run`] itself: with every connection","+    /// held by an operation waiting for another, the pool deadlocks.","+    pub(super) async fn run<Loaded, DbError, Operation, Pending>(","+        &self,","+        operation: Operation,","+    ) -> Result<Loaded, DbError>","+    where","+        Operation: FnOnce(Connection) -> Pending,","+        Pending: Future<Output = Result<Loaded, DbError>>,","+        DbError: From<LibsqlError>,","+    {","+        let _slot = self.slots.acquire().await.expect(\"the pool never closes its semaphore\");","+        let pooled = self.idle","+            .lock()","+            .expect(\"idle connections lock\")","+            .pop();","+        let conn = match pooled {","+            Some(conn) => conn,","+            None => self.db.connect()?,","+        };","+        let result = operation(conn.clone()).await;","+        if result.is_ok() && conn.is_autocommit() {","+            self.idle","+                .lock()","+                .expect(\"idle connections lock\")","+                .push(conn);","+        }","+        result","+    }","+","+    /// An unpooled connection, for setup that runs before any operation.","+    pub(super) fn connect(&self) -> Result<Connection, LibsqlError> {","+        self.db.connect()","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":71,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/pool/tests.rs","lines":["@@ -0,0 +1,140 @@","+use super::ConnectionPool;","+use axum::{Json, Router, extract::State, http::StatusCode, routing::post};","+use libsql::{Builder, Database};","+use serde_json::{Value, json};","+use std::{","+    collections::HashSet,","+    fmt::Write as _,","+    sync::{Arc, Mutex},","+    time::Duration,","+};","+","+/// A remote connection whose request was cut off mid-flight sends the spent","+/// baton next time, and the server refuses every later request on it.","+#[tokio::test]","+async fn a_connection_cut_off_mid_request_stays_broken() {","+    let (db, server) = baton_checking_database().await;","+    let conn = db.connect().unwrap();","+    conn.query(\"SELECT 1\", ()).await","+        .unwrap();","+    assert!(cut_off(conn.query(\"SELECT 'slow'\", ())).await);","+","+    let error = conn","+        .query(\"SELECT 1\", ())","+        .await","+        .unwrap_err();","+    server.abort();","+    assert!(error.to_string().contains(\"already been used\"), \"{error}\");","+}","+","+#[tokio::test]","+async fn the_pool_replaces_a_connection_cut_off_mid_request() {","+    let (db, server) = baton_checking_database().await;","+    let pool = ConnectionPool::new(db, 1);","+    pool.run(|conn| async move { conn.query(\"SELECT 1\", ()).await }).await","+        .unwrap();","+    assert!(cut_off(pool.run(|conn| async move { conn.query(\"SELECT 'slow'\", ()).await })).await);","+","+    let after = pool.run(|conn| async move { conn.query(\"SELECT 1\", ()).await }).await;","+    server.abort();","+    after.unwrap();","+}","+","+/// Whether `operation` was still waiting for its response when it was dropped.","+async fn cut_off<Output>(operation: impl Future<Output = Output>) -> bool {","+    tokio::time::timeout(Duration::from_millis(100), operation).await.is_err()","+}","+","+/// A database behind a Hrana server that hands out a fresh baton with every","+/// response and refuses one it has seen before, as Turso and `sqld` do. A","+/// statement containing `slow` gets its response late.","+async fn baton_checking_database() -> (Database, tokio::task::JoinHandle<()>) {","+    let app = Router::new()","+        .route(\"/v3/pipeline\", post(pipeline))","+        .route(\"/v3/cursor\", post(cursor))","+        .with_state(Arc::new(Batons::default()));","+    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();","+    let address = listener.local_addr().unwrap();","+    let server = tokio::spawn(async move {","+        axum::serve(listener, app).await.unwrap();","+    });","+    let db = Builder::new_remote(format!(\"http://{address}\"), String::new())","+        .connector(tower::service_fn(move |_| tokio::net::TcpStream::connect(address)))","+        .build()","+        .await","+        .unwrap();","+    (db, server)","+}","+","+#[derive(Default)]","+struct Batons {","+    seen: Mutex<HashSet<String>>,","+    issued: Mutex<u64>,","+}","+","+impl Batons {","+    /// Spend `baton`, refusing one already spent.","+    fn spend(&self, baton: &Value) -> Result<(), (StatusCode, &'static str)> {","+        match baton.as_str() {","+            Some(baton)","+                if !self.seen","+                    .lock()","+                    .unwrap()","+                    .insert(baton.to_string()) =>","+            {","+                Err((StatusCode::BAD_REQUEST, \"Received a baton that has already been used\"))","+            }","+            _ => Ok(()),","+        }","+    }","+","+    fn issue(&self) -> String {","+        let mut issued = self.issued.lock().unwrap();","+        *issued += 1;","+        format!(\"baton-{issued}\")","+    }","+}","+","+/// The `describe` that opens a `query`'s stream.","+async fn pipeline(","+    State(batons): State<Arc<Batons>>,","+    body: String,","+) -> Result<Json<Value>, (StatusCode, &'static str)> {","+    let body: Value = serde_json::from_str(&body).unwrap();","+    batons.spend(&body[\"baton\"])?;","+    let results: Vec<Value> = body[\"requests\"]","+        .as_array()","+        .unwrap()","+        .iter()","+        .map(|request| {","+            assert_eq!(request[\"type\"], \"describe\", \"{request}\");","+            json!({ \"type\": \"ok\", \"response\": { \"type\": \"describe\", \"result\": {","+                \"params\": [], \"cols\": [], \"is_explain\": false, \"is_readonly\": true,","+            }}})","+        })","+        .collect();","+    Ok(Json(json!({ \"baton\": batons.issue(), \"base_url\": null, \"results\": results })))","+}","+","+/// The rows of a `query`: one row holding `1`.","+async fn cursor(","+    State(batons): State<Arc<Batons>>,","+    body: String,","+) -> Result<String, (StatusCode, &'static str)> {","+    let body: Value = serde_json::from_str(&body).unwrap();","+    batons.spend(&body[\"baton\"])?;","+    if body.to_string().contains(\"slow\") {","+        tokio::time::sleep(Duration::from_secs(1)).await;","+    }","+    let lines = [","+        json!({ \"baton\": batons.issue(), \"base_url\": null }),","+        json!({ \"type\": \"step_begin\", \"step\": 0, \"cols\": [{ \"name\": \"1\", \"decltype\": null }] }),","+        json!({ \"type\": \"row\", \"row\": [{ \"type\": \"integer\", \"value\": \"1\" }] }),","+        json!({ \"type\": \"step_end\", \"affected_row_count\": 0, \"last_insert_rowid\": null }),","+    ];","+    let mut body = String::new();","+    for line in lines {","+        writeln!(body, \"{line}\").unwrap();","+    }","+    Ok(body)","+}"],"additions":140,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/tests.rs","lines":["@@ -8,11 +8,28 @@ use crate::token_store::sha256_hex;"," "," mod sync_server;"," ","-/// In-memory libsql database, exercising the same driver and SQL the","-/// networked backend uses without a server.","-async fn local_backend(max_users: MaxUsers) -> LibsqlAuth {","-    let db = Builder::new_local(\":memory:\").build().await.unwrap();","-    LibsqlAuth::from_database(db, max_users).await.unwrap()","+/// A local libsql database, exercising the same driver and SQL the","+/// networked backend uses without a server. It is a file because each pooled","+/// connection to `:memory:` would be a database of its own.","+async fn local_backend(max_users: MaxUsers) -> LocalBackend {","+    let dir = tempfile::tempdir().unwrap();","+    let db = Builder::new_local(dir.path().jo