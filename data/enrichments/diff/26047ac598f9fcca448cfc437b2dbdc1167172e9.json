          conn.query(\"SELECT 1;\", ()).await?;","+                Ok(())","+            }),","+        )","         .await","     }"," }","@@ -296,17 +310,23 @@ impl LibsqlAuth {","         password: &str,","         hash: &str,","     ) -> Result<(UpsertOutcome, String)> {","-        let inserted = self.conn.execute(","-            \"INSERT INTO users (username, bcrypt_hash) VALUES (?1, ?2)\",","-            params![username, hash],","-        )","-        .await;","-        match inserted {","-            Ok(_) => Ok((UpsertOutcome::Created, username.to_string())),","-            Err(err) if is_unique_violation(&err) => {","-                self.login_after_lost_insert(username, password).await","+        let inserted = self.pool.run(|conn| async move {","+            let inserted = conn.execute(","+                \"INSERT INTO users (username, bcrypt_hash) VALUES (?1, ?2)\",","+                params![username, hash],","+            )","+            .await;","+            match inserted {","+                Ok(_) => Ok(Insert::Created),","+                Err(err) if is_unique_violation(&err) => Ok(Insert::NameTaken),","+                Err(err) => Err(RegistryError::from(err)),","             }","-            Err(err) => Err(err.into()),","+        })","+        .await?;","+        match inserted {","+            Insert::Created => Ok((UpsertOutcome::Created, username.to_string())),","+            Insert::NameTaken => self.login_after_lost_insert(username, password).await,","+            Insert::CapFull => unreachable!(\"an uncapped insert has no cap\"),","         }","     }"," ","@@ -320,16 +340,28 @@ impl LibsqlAuth {","     ) -> Result<(UpsertOutcome, String)> {","         let mut can_retry_after_reconcile = true;","         loop {","-            let tx = self.conn.transaction_with_behavior(TransactionBehavior::Immediate).await?;","-            // The counter can overcount after an interrupted write; reconcile it","-            // once before believing the