{"id":"26047ac598f9fcca448cfc437b2dbdc1167172e9","axis":"silent","repo":"pnpm/pnpm","sha":"26047ac598f9fcca448cfc437b2dbdc1167172e9","parsed":{"files":[{"path":".changeset/libsql-connection-pool.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr no longer loses its libsql or Turso auth database after a request is cut off. Before, a client that disconnected during a token lookup could make every later login and authenticated request fail with a 500 until pnpr restarted. The new `backend.libsql.maxConnections` setting limits how many auth database operations run at once, and defaults to 10."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend.rs","lines":["@@ -19,10 +19,12 @@"," //! file, live in a `users` table here ([`super::USERS_TABLE_SQL`])."," "," mod connector;","+mod pool;"," mod schema;"," mod tokens;"," mod user_admin;"," use connector::{LibsqlConnector, is_plain_http};","+use pool::ConnectionPool;"," use schema::{","     claim_user_counter_slot, init_schema, is_unique_violation, missing_count_row,","     reconcile_user_counter_overcount, retry_database_conflicts,","@@ -51,12 +53,10 @@ const DEFAULT_AUTH_TIMEOUT: Duration = Duration::from_secs(30);"," /// generous than [`DEFAULT_AUTH_TIMEOUT`] for cold remote DDL."," const DEFAULT_STARTUP_TIMEOUT: Duration = Duration::from_mins(5);"," ","-/// Networked-SQLite auth backend. One [`Connection`] serves both record","-/// stores; the [`Database`] handle is held only to keep the connection","-/// alive.","+/// Networked-SQLite auth backend. Both record stores run their operations","+/// on one [`ConnectionPool`]."," pub struct LibsqlAuth {","-    _db: Database,","-    conn: Connection,","+    pool: ConnectionPool,","     /// Per-process secret seeding [`crate::token_store::mint_token`]. Need not match other","     /// replicas: tokens are looked up by their stored hash, never","     /// re-derived, so each replica minting with its own secret is