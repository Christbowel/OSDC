         && settings.default_registry == recorded_default_registry(config)"," }"," ","+impl SettingsComparison<'_> {","+    pub(super) fn registry_routes_differ(&self) -> bool {","+        let live = self.live.registry_routes.as_ref();","+        match self.recorded.installed_registry_routes.as_ref() {","+            Some(installed) if Some(installed) != live => true,","+            Some(_) if self.ignored.contains(&\"registryRoutes\") => false,","+            _ => self.recorded.registry_routes.as_ref() != live,","+        }","+    }","+}","+"," /// The scope routes an install resolves plain keys through, as"," /// [`WorkspaceStateSettings::registry_routes`](pnpm_workspace_state::WorkspaceStateSettings::registry_routes)"," /// records them."],"additions":15,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_state/validation.rs","lines":["@@ -419,8 +419,8 @@ fn shared_inputs_match(","             .get(&*path.to_string_lossy())","             .map(|signature| signature.digest.clone())","     };","-    // Only a resolving install records `autoDedupe` and `registryRoutes`,","-    // and only a verifying one `registryPrefixes`; none shapes a tree. Empty","+    // Only a resolving install records `autoDedupe`, and only a verifying","+    // one `registryPrefixes`. Neither shapes a tree. Empty","     // maps and `enableGlobalVirtualStore: false` match their omitted","     // defaults.","     let settings = |state: &WorkspaceState| {","@@ -428,7 +428,9 @@ fn shared_inputs_match(","         settings.auto_dedupe = None;","         settings.registry_prefixes = None;","         settings.default_registry = None;","-        settings.registry_routes = None;","+        if let Some(routes) = settings.installed_registry_routes.take() {","+            settings.registry_routes = Some(routes);","+        }","         if settings.allow_builds.as_ref().is_some_and(BTreeMap::is_empty) {","             settings.allow_builds = None;","         }"],"additions":5,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/deps_status.rs","lines":["@@ -104,10 +104,7 @@ pub fn check_deps_status_before_run(","     } else {","         Scope::Selected(selected_project_dirs)","     };","-    let mut ignored_settings = RUN_IGNORED_SETTINGS.to_vec();","-    if install_would_run_frozen(check) {","-        ignored_settings.push(\"autoDedupe\");","-    }","+    let ignored_settings = run_ignored_settings(check, scope);","     let policy = GatePolicy {","         gate: Gate::Run,","         ignored_settings: &ignored_settings,","@@ -123,6 +120,22 @@ pub fn check_deps_status_before_run(","     }"," }"," ","+fn run_ignored_settings(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    scope: Scope<'_>,","+) -> Vec<&'static str> {","+    let mut ignored_settings = RUN_IGNORED_SETTINGS.to_vec();","+    let frozen = install_would_run_frozen(check);","+    if frozen {","+        ignored_settings.push(\"autoDedupe\");","+    }","+    // Only a full resolution can replace the recorded routes of every plain key.","+    if frozen || (matches!(scope, Scope::Selected(_)) && check.config.shares_one_lockfile()) {","+        ignored_settings.push(\"registryRoutes\");","+    }","+    ignored_settings","+}","+"," /// pnpm's issue wording for a [`Stale`] verdict."," fn stale_issue(check: &OptimisticRepeatInstallCheck<'_>, stale: Stale) -> String {","     match stale {"],"additions":17,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/manifest_agreement.rs","lines":["@@ -68,6 +68,7 @@ pub(crate) fn held_projects_match_lockfile(","     held: &[&ManifestStat<'_>],","     current: &CurrentLockfile<'_>,"," ) -> Result<(), Stale> {","+    require_recorded_registry_routes(state, held)?;","     let lockfile = check.lockfile","         .get()","         .map_err(|_| Stale::Content(\"the wanted lockfile cannot be read or parsed\"))?;","@@ -106,6 +107,24 @@ pub(crate) fn held_projects_match_lockfile(","     check_projects_content(check, wanted, held).map_err(Stale::Content)"," }"," ","+fn require_recorded_registry_routes(","+    state: &WorkspaceState,","+    held: &[&ManifestStat<'_>],","+) -> Result<(), Stale> {","+    // A plain lockfile key cannot prove which registry an unrecorded project used.","+    if state.settings.installed_registry_routes.is_some()","+        && held","+            .iter()","+            .any(|stat| {","+                stat.status == ProjectStatus::Unrecorded","+                    && super::manifest_has_runtime_deps(stat.manifest)","+            })","+    {","+        return Err(Stale::SettingChanged(\"registryRoutes\"));","+    }","+    Ok(())","+}","+"," /// The current lockfile records what `wanted` materializes for each `held`"," /// project whose install was never proven against `wanted`."," fn require_installed("],"additions":19,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/installation.rs","lines":["@@ -587,6 +587,46 @@ fn returns_skipped_when_a_scope_moves_to_another_registry() {","         Decision::Skipped { reason } if reason.contains(\"settings\"),","     ));"," }","+#[test]","+fn run_checks_registry_routes_when_its_install_can_resolve_the_whole_lockfile() {","+    for (ci, filtered, shared_lockfile, expects_drift) in [","+        (true, false, true, false),","+        (false, true, true, false),","+        (false, true, false, true),","+        (false, false, true, true),","+    ] {","+        let (dir, config) = super::setup_content_check_project();","+        let mut config = config.clone();","+        config.ci = ci;","+        config.shared_workspace_lockfile = shared_lockfile;","+        config.registries_by_scope.insert(\"@example\".into(), \"https://registry.example/\".into());","+        if filtered {","+            config.filter.push(\".\".into());","+        }","+        let mut state = pnpm_workspace_state::load_workspace_state(dir.path()).unwrap().unwrap();","+        state.settings.installed_registry_routes =","+            Some(crate::install_state::settings::recorded_registry_routes(&config));","+        pnpm_workspace_state::update_workspace_state(dir.path(), &state).unwrap();","+        let manifest = PackageManifest::from_path(dir.path().join(\"package.json\")).unwrap();","+        let projects = [(dir.path().to_path_buf(), &manifest)];","+        let status = super::workspace_deps_status_for_selected(","+            &dir,","+            config.leak(),","+            &projects,","+            &[dir.path()],","+        );","+        let expected = if expects_drift {","+            super::RunDepsStatus::Outdated {","+                issue: \"The value of the registryRoutes setting has changed\".into(),","+                install_args: Vec::new(),","+            }","+        } else {","+            super::RunDepsStatus::UpToDate","+        };","+        assert_eq!(status, expected);","+    }","+}","+"," /// Drift in `minimumReleaseAgeIgnoreMissingTime` invalidates the cached"," /// state. pnpm resolves it to a concrete `true` default and records it,"," /// so pacquet records and compares it too."],"additions":40,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace-state/src/lib.rs","lines":["@@ -408,6 +408,10 @@ pub struct WorkspaceStateSettings {","     /// every unscoped package again on each switch.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub registry_routes: Option<BTreeMap<String, String>>,","+    /// The scope routes used by the install that validated the recorded projects,","+    /// when they differ from [`Self::registry_routes`].","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub installed_registry_routes: Option<BTreeMap<String, String>>,","     /// `runtime`, recorded only while it is off.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub runtime: Option<bool>,"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/docs/settings/build.md","lines":["@@ -312,6 +312,8 @@ Changing [`trustLockfile`](./dependency-resolution.md#trustlockfile) alone does"," "," When the command is filtered, for example `pnpm --filter foo run build`, the check covers the selected projects and the workspace projects they depend on, and the install it runs is filtered the same way."," ","+After a frozen or filtered install has handled a scope registry change for the selected projects, the next command can reuse that install. Run an unfiltered `pnpm install --no-frozen-lockfile` to resolve dependencies under the new registry settings.","+"," ### strictDepBuilds"," "," * Default: **true**",""],"additions":2,"deletions":0,"truncated":false}],"additions":177,"deletions":10,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-26T18:55:30.364075+00:00"}