elemetry/common/telemetry.js';","+import { AgentSession } from '../../common/agentService.js';","+import { isSubagentSession } from '../../common/state/sessionState.js';","+","+type TodoStoreOperation = 'read' | 'write' | 'mixed';","+type TodoStoreTarget = 'todos' | 'todo_deps' | 'both';","+","+type TodoStoreOperationEvent = {","+\toperation: TodoStoreOperation;","+\ttarget: TodoStoreTarget;","+\ttoolCallId: string;","+\tprovider: string;","+\tagentSessionId: string;","+\tisSubagentSession: boolean;","+};","+","+type TodoStoreOperationClassification = {","+\toperation: { classification: 'SystemMetaData'; purpose: 'FeatureInsight'; comment: 'Whether the SQL operation read from, wrote to, or both read from and wrote to todo storage.' };","+\ttarget: { classification: 'SystemMetaData'; purpose: 'FeatureInsight'; comment: 'Whether the SQL operation referenced todo items, todo dependencies, or both.' };","+\ttoolCallId: { classification: 'SystemMetaData'; purpose: 'FeatureInsight'; comment: 'The identifier of the SQL tool call, used to correlate with generic tool telemetry.' };","+\tprovider: { classification: 'SystemMetaData'; purpose: 'FeatureInsight'; comment: 'The provider handling the agent host session.' };","+\tagentSessionId: { classification: 'SystemMetaData'; purpose: 'FeatureInsight'; comment: 'The agent host session identifier.' };","+\tisSubagentSession: { classification: 'SystemMetaData'; purpose: 'FeatureInsight'; isMeasurement: true; comment: 'Whether the todo storage operation belongs to a subagent session.' };","+\towner: 'amunger';","+\tcomment: 'Tracks successful Copilot CLI SQL operations that access todo item or dependency storage.';","+};","+","+interface ITodoStoreOperationData {","+\treadonly operation: TodoStoreOperation;","+\treadonly target: TodoStoreTarget;","+}","+","+interface ISqlToken {","+\treadonly value: string;","+\treadonly kind: 'identifier' | 'punctuation';","+}","+","+export function reportCopilotTodoStoreOperation(telemetryService: ITelemetryService, session: URI, toolCallId: string, toolName: string, toolInput: Readonly<Record<string, unknown>> | undefined): void {","+\tconst operation = getCopilotTodoStoreOperationData(toolName, toolInput);","+\tif (!operation) {","+\t\treturn;","+\t}","+","+\ttelemetryService.publicLog2<TodoStoreOperationEvent, TodoStoreOperationClassification>('todoStoreOperation', {","+\t\t...operation,","+\t\ttoolCallId,","+\t\tprovider: session.scheme,","+\t\tagentSessionId: AgentSession.id(session),","+\t\tisSubagentSession: isSubagentSession(session),","+\t});","+}","+","+export function getCopilotTodoStoreOperationData(toolName: string, toolInput: Readonly<Record<string, unknown>> | undefined): ITodoStoreOperationData | undefined {","+\tif (toolName !== 'sql') {","+\t\treturn undefined;","+\t}","+","+\tconst query = toolInput?.query;","+\tif (typeof query !== 'string') {","+\t\treturn undefined;","+\t}","+","+\tconst tokens = tokenizeSql(query);","+\tconst readTargets = new Set<TodoStoreTarget>();","+\tconst writeTargets = new Set<TodoStoreTarget>();","+\tconst deleteFromIndexes = new Set<number>();","+","+\tfor (let i = 0; i < tokens.length; i++) {","+\t\tswitch (tokens[i].value) {","+\t\t\tcase 'insert':","+\t\t\tcase 'replace': {","+\t\t\t\tconst intoIndex = findToken(tokens, i + 1, 'into', ['or', 'rollback', 'abort', 'replace', 'fail', 'ignore']);","+\t\t\t\taddTodoStoreTarget(writeTargets, readTableIdentifier(tokens, intoIndex + 1));","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\tcase 'update':","+\t\t\t\taddTodoStoreTarget(writeTargets, readTableIdentifier(tokens, i + 1, ['or', 'rollback', 'abort', 'replace', 'fail', 'ignore']));","+\t\t\t\tbreak;","+\t\t\tcase 'delete': {","+\t\t\t\tconst fromIndex = findToken(tokens, i + 1, 'from');","+\t\t\t\tdeleteFromIndexes.add(fromIndex);","+\t\t\t\taddTodoStoreTarget(writeTargets, readTableIdentifier(tokens, fromIndex + 1));","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\tcase 'create':","+\t\t\tcase 'drop':","+\t\t\tcase 'alter': {","+\t\t\t\tconst tableIndex = findToken(tokens, i + 1, 'table', ['temp', 'temporary']);","+\t\t\t\taddTodoStoreTarget(writeTargets, readTableIdentifier(tokens, tableIndex + 1, ['if', 'not', 'exists']));","+\t\t\t\tbreak;","+\t\t\t}","+\t\t}","+\t}","+","+\tfor (let i = 0; i < tokens.length; i++) {","+\t\tif (tokens[i].value === 'from' && !deleteFromIndexes.has(i)) {","+\t\t\taddFromClauseTargets(tokens, i + 1, readTargets);","+\t\t} else if (tokens[i].value === 'join') {","+\t\t\taddTodoStoreTarget(readTargets, readTableIdentifier(tokens, i + 1));","+\t\t}","+\t}","+","+\tif (readTargets.size === 0 && writeTargets.size === 0) {","+\t\treturn undefined;","+\t}","+","+\tconst referencesTodos = readTargets.has('todos') || writeTargets.has('todos');","+\tconst referencesTodoDeps = readTargets.has('todo_deps') || writeTargets.has('todo_deps');","+\treturn {","+\t\toperation: readTargets.size > 0 && writeTargets.size > 0 ? 'mixed' : writeTargets.size > 0 ? 'write' : 'read',","+\t\ttarget: referencesTodos && referencesTodoDeps ? 'both' : referencesTodoDeps ? 'todo_deps' : 'todos',","+\t};","+}","+","+function tokenizeSql(query: string): ISqlToken[] {","+\tconst tokens: ISqlToken[] = [];","+\tfor (let i = 0; i < query.length;) {","+\t\tconst char = query[i];","+\t\tconst next = query[i + 1];","+\t\tif (/\\s/.test(char)) {","+\t\t\ti++;","+\t\t} else if (char === '-' && next === '-') {","+\t\t\ti = skipUntil(query, i + 2, '\\n');","+\t\t} else if (char === '/' && next === '*') {","+\t\t\ti = skipUntil(query, i + 2, '*/');","+\t\t} else if (char === '\\'') {","+\t\t\ti = skipQuoted(query, i + 1, '\\'', '\\'');","+\t\t} else if (char === '\"' || char === '`') {","+\t\t\tconst end = skipQuoted(query, i + 1, char, char);","+\t\t\ttokens.push({ value: query.slice(i + 1, end - 1).replaceAll(char + char, char).toLowerCase(), kind: 'identifier' });","+\t\t\ti = end;","+\t\t} else if (char === '[') {","+\t\t\tconst end = skipQuoted(query, i + 1, ']', ']');","+\t\t\ttokens.push({ value: query.slice(i + 1, end - 1).replaceAll(']]', ']').toLowerCase(), kind: 'identifier' });","+\t\t\ti = end;","+\t\t} else if (/[a-z_$]/i.test(char)) {","+\t\t\tlet end = i + 1;","+\t\t\twhile (end < query.length && /[\\w$]/.test(query[end])) {","+\t\t\t\tend++;","+\t\t\t}","+\t\t\ttokens.push({ value: query.slice(i, end).toLowerCase(), kind: 'identifier' });","+\t\t\ti = end;","+\t\t} else {","+\t\t\tif (char === '.' || char === ',' || char === '(' || char === ')' || char === ';') {","+\t\t\t\ttokens.push({ value: char, kind: 'punctuation' });","+\t\t\t}","+\t\t\ti++;","+\t\t}","+\t}","+\treturn tokens;","+}","+","+function skipUntil(query: string, start: number, terminator: string): number {","+\tconst index = query.indexOf(terminator, start);","+\treturn index === -1 ? query.length : index + terminator.length;","+}","+","+function skipQuoted(query: string, start: number, terminator: string, escape: string): number {","+\tfor (let i = start; i < query.length; i++) {","+\t\tif (query[i] !== terminator) {","+\t\t\tcontinue;","+\t\t}","+\t\tif (query[i + 1] === escape) {","+\t\t\ti++;","+\t\t} else {","+\t\t\treturn i + 1;","+\t\t}","+\t}","+\treturn query.length;","+}","+","+function findToken(tokens: readonly ISqlToken[], start: number, value: string, skippedValues: readonly string[] = []): number {","+\tfor (let i = start; i < tokens.length && tokens[i].value !== ';'; i++) {","+\t\tif (tokens[i].value === value) {","+\t\t\treturn i;","+\t\t}","+\t\tif (!skippedValues.includes(tokens[i].value)) {","+\t\t\tbreak;","+\t\t}","+\t}","+\treturn -1;","+}","+","+function readTableIdentifier(tokens: readonly ISqlToken[], start: number, skippedValues: readonly string[] = []): string | undefined {","+\tlet index = start;","+\twhile (index < tokens.length && skippedValues.includes(tokens[index].value)) {","+\t\tindex++;","+\t}","+\tif (tokens[index]?.kind !== 'identifier') {","+\t\treturn undefined;","+\t}","+","+\tlet table = tokens[index].value;","+\twhile (tokens[index + 1]?.value === '.' && tokens[index + 2]?.kind === 'identifier') {","+\t\ttable = tokens[index + 2].value;","+\t\tindex += 2;","+\t}","+\treturn table;","+}","+","+function addFromClauseTargets(tokens: readonly ISqlToken[], start: number, targets: Set<TodoStoreTarget>): void {","+\tconst terminators = new Set(['where', 'group', 'order', 'having', 'limit', 'union', 'intersect', 'except', 'returning', 'set', 'values', ';']);","+\tlet expectsTable = true;","+\tlet depth = 0;","+\tfor (let i = start; i < tokens.length; i++) {","+\t\tconst value = tokens[i].value;","+\t\tif (value === '(') {","+\t\t\tif (depth === 0 && expectsTable) {","+\t\t\t\texpectsTable = false;","+\t\t\t}","+\t\t\tdepth++;","+\t\t} else if (value === ')') {","+\t\t\tif (depth === 0) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tdepth--;","+\t\t} else if (depth === 0 && terminators.has(value)) {","+\t\t\treturn;","+\t\t} else if (depth === 0 && (value === ',' || value === 'join')) {","+\t\t\texpectsTable = true;","+\t\t} else if (depth === 0 && expectsTable && tokens[i].kind === 'identifier') {","+\t\t\taddTodoStoreTarget(targets, readTableIdentifier(tokens, i));","+\t\t\texpectsTable = false;","+\t\t}","+\t}","+}","+","+function addTodoStoreTarget(targets: Set<TodoStoreTarget>, identifier: string | undefined): void {","+\tif (identifier === 'todos' || identifier === 'todo_deps') {","+\t\ttargets.add(identifier);","+\t}","+}"],"additions":238,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/agentHostToolCallTelemetry.test.ts","lines":["@@ -240,6 +240,7 @@ suite('AgentSideEffects — tool call telemetry', () => {"," \t\t\t\ttoolId: 'bash',"," \t\t\t\ttoolExtensionId: undefined,"," \t\t\t\ttoolSourceKind: 'agentHost',","+\t\t\t\ttoolCallId: 'tc-1',"," \t\t\t\tprovider: 'mock',"," \t\t\t\tinvocationTimeMs: true,"," \t\t\t\tresultSizeInCharacters: 41,","@@ -265,6 +266,7 @@ suite('AgentSideEffects — tool call telemetry', () => {"," \t\t\t\ttoolId: 'lookup',"," \t\t\t\ttoolExtensionId: un