ensions\""," )"," ","-// ExtensionsConfig holds extension startup settings.","+// ExtensionsConfig controls extension activation and startup configuration."," // Changes take effect on the next daemon start."," type ExtensionsConfig struct {","-\tDirs []string `json:\"dirs,omitempty\"`","+\tEnable  []string `json:\"enable,omitempty\"`","+\tDisable []string `json:\"disable,omitempty\"`","+\tDirs    []string `json:\"dirs,omitempty\"`"," \t// Configs holds opaque configuration keyed by extension ID.","+\t// Configuration alone does not enable an extension."," \t// The entry reaches in-process Init directly or a launched binary through"," \t// the startup handshake."," \tConfigs ExtensionConfigs `json:\"configs,omitempty\"`"," }"," ","+// Validate checks extension IDs and conflicting activation settings.","+func (c ExtensionsConfig) Validate() error {","+\tfor _, id := range c.Enable {","+\t\tif err := extensions.ValidateExtensionID(extensions.ExtensionID(id)); err != nil {","+\t\t\treturn fmt.Errorf(\"extensions.enable: %w\", err)","+\t\t}","+\t\tif slices.Contains(c.Disable, id) {","+\t\t\treturn fmt.Errorf(\"extension %q is listed in both extensions.enable and extensions.disable\", id)","+\t\t}","+\t}","+\tfor _, id := range c.Disable {","+\t\tif err := extensions.ValidateExtensionID(extensions.ExtensionID(id)); err != nil {","+\t\t\treturn fmt.Errorf(\"extensions.disable: %w\", err)","+\t\t}","+\t}","+\treturn nil","+}","+"," // ExtensionConfig holds the opaque configuration for one extension."," type ExtensionConfig struct {"," \tID     extensions.ExtensionID"],"additions":24,"deletions":2,"truncated":false},{"path":"daemon/extensions.go","lines":["@@ -5,6 +5,7 @@ import ("," \t\"fmt\""," \t\"os\""," \t\"path/filepath\"","+\t\"slices\""," "," \t\"github.com/containerd/log\""," \t\"github.com/moby/extensions\"","@@ -27,10 +28,14 @@ func (daemon *Daemon) newExtensionHost(ctx context.Context) (*host.Host, error)"," \tif err := os.Chmod(runtimeDir, 0o700); err != nil {"," \t\treturn nil, fmt.Errorf(\"set permissions on extension runtime directory: %w\", err)"," \t}","+\tdefaults := slices.Concat(builtinExtensions, daemon.daemonExtensions())","+\texts, err := selectBuiltinExtensions(cfg.Extensions, defaults, daemon.optionalExtensions())","+\tif err != nil {","+\t\treturn nil, err","+\t}"," \treturn host.New(ctx,"," \t\thost.WithRuntimeDir(runtimeDir),","-\t\thost.WithExtensions(builtinExtensions...),","-\t\thost.WithExtensions(daemon.daemonExtensions()...),","+\t\thost.WithExtensions(exts...),"," \t\thost.WithDirs(extensionDirs(&cfg)...),"," \t\thost.WithClientProviders(clientProviders()...),"," \t\thost.WithProviderPolicy(host.PointPolicyFunc(func(extensions.ExtensionIdentity, extensions.PointID) host.PointPolicyResult {"],"additions":7,"deletions":2,"truncated":false},{"path":"daemon/extensions_default.go","lines":["@@ -1,9 +1,15 @@"," package daemon"," "," import (","+\t\"fmt\"","+\t\"maps\"","+\t\"slices\"","+\t\"strings\"","+"," \t\"github.com/moby/extensions\""," \t\"github.com/moby/extensions/clientpoint\""," \t\"github.com/moby/extensions/serverpoint\"","+\t\"github.com/moby/moby/v2/daemon/config\""," \t\"github.com/moby/moby/v2/daemon/internal/extensionconfig\""," \t\"github.com/moby/moby/v2/daemon/internal/extensionstorage/bbolt\""," ","@@ -21,6 +27,12 @@ var builtinExtensions = []extensions.Extension{"," \tbbolt.Extension,"," }"," ","+// optionalExtensions lists built-ins that remain inactive until explicitly","+// enabled through extensions.enable.","+func (daemon *Daemon) optionalExtensions() []extensions.Extension {","+\treturn []extensions.Extension{}","+}","+"," // daemonExtensions declares extensions that need daemon-owned state."," // Ordinary builtin definitions obtain their bootstrap settings through points."," func (daemon *Daemon) daemonExtensions() []extensions.Extension {","@@ -30,6 +42,37 @@ func (daemon *Daemon) daemonExtensions() []extensions.Extension {"," \t}"," }"," ","+// selectBuiltinExtensions applies activation settings to whole extensions.","+// Provider conflicts and required dependencies are validated by the host.","+func selectBuiltinExtensions(cfg config.ExtensionsConfig, defaults, optional []extensions.Extension) ([]extensions.Extension, error) {","+\tif err := cfg.Validate(); err != nil {","+\t\treturn nil, err","+\t}","+","+\tall := slices.Concat(defaults, optional)","+\tenabled := make(map[string]bool, len(all))","+\tfor _, ext := range optional {","+\t\tenabled[string(ext.Declaration().ID)] = false","+\t}","+\tfor _, ext := range defaults {","+\t\tenabled[string(ext.Declaration().ID)] = true","+\t}","+\tfor _, id := range slices.Concat(cfg.Enable, cfg.Disable) {","+\t\tif _, known := enabled[id]; !known {","+\t\t\treturn nil, fmt.Errorf(\"extensions: unknown built-in extension %q (available: %s)\", id, strings.Join(slices.Sorted(maps.Keys(enabled)), \", \"))","+\t\t}","+\t}","+\tfor _, id := range cfg.Enable {","+\t\tenabled[id] = true","+\t}","+\tfor _, id := range cfg.Disable {","+\t\tenabled[id] = false","+\t}","+\treturn slices.DeleteFunc(all, func(ext extensions.Extension) bool {","+\t\treturn !enabled[string(ext.Declaration().ID)]","+\t}), nil","+}","+"," // clientProviders lists generated client wiring for points that launched"," // extensions may provide."," //"],"additions":43,"deletions":0,"truncated":false},{"path":"daemon/extensions_default_test.go","lines":["@@ -0,0 +1,90 @@","+package daemon","+","+import (","+\t\"testing\"","+","+\t\"github.com/moby/extensions\"","+\t\"github.com/moby/moby/v2/daemon/config\"","+\t\"gotest.tools/v3/assert\"","+)","+","+func TestSelectBuiltinExtensions(t *testing.T) {","+\tt.Parallel()","+","+\tdefaultExtension := extensions.New(extensions.Declaration{","+\t\tID: \"org.example.default.v1\",","+\t\tProviders: []extensions.Provider{","+\t\t\t{Point: \"org.example.first.v0\", Impl: \"default-first\"},","+\t\t\t{Point: \"org.example.second.v0\", Impl: \"default-second\"},","+\t\t},","+\t})","+\toptionalExtension := extensions.New(extensions.Declaration{","+\t\tID: \"org.example.optional.v1\",","+\t\tProviders: []extensions.Provider{","+\t\t\t{Point: \"org.example.first.v0\", Impl: \"optional-first\"},","+\t\t\t{Point: \"org.example.second.v0\", Impl: \"optional-second\"},","+\t\t},","+\t})","+\tdefaults := []extensions.Extension{defaultExtension}","+\toptional := []extensions.Extension{optionalExtension}","+","+\tfor _, tc := range []struct {","+\t\tname    string","+\t\tconfig  config.ExtensionsConfig","+\t\twant    []extensions.Extension","+\t\twantErr string","+\t}{","+\t\t{","+\t\t\tname: \"defaults\", want: defaults,","+\t\t},","+\t\t{","+\t\t\tname:   \"configuration does not enable an optional extension\",","+\t\t\tconfig: config.ExtensionsConfig{Configs: config.ExtensionConfigs{{ID: \"org.example.optional.v1\", Config: map[string]any{\"enabled\": true}}}},","+\t\t\twant:   defaults,","+\t\t},","+\t\t{","+\t\t\tname:   \"enable does not implicitly replace defaults\",","+\t\t\tconfig: config.ExtensionsConfig{Enable: []string{\"org.example.optional.v1\", \"org.example.optional.v1\", \"org.example.default.v1\"}},","+\t\t\twant:   []extensions.Extension{defaultExtension, optionalExtension},","+\t\t},","+\t\t{","+\t\t\tname:   \"replace whole extension\",","+\t\t\tconfig: config.ExtensionsConfig{Enable: []string{\"org.example.optional.v1\"}, Disable: []string{\"org.example.default.v1\"}},","+\t\t\twant:   optional,","+\t\t},","+\t\t{","+\t\t\tname:   \"disable all\",","+\t\t\tconfig: config.ExtensionsConfig{Disable: []string{\"org.example.default.v1\", \"org.example.optional.v1\"}},","+\t\t},","+\t\t{","+\t\t\tname:    \"conflicting activation\",","+\t\t\tconfig:  config.ExtensionsConfig{Enable: []string{\"org.example.optional.v1\"}, Disable: []string{\"org.example.optional.v1\"}},","+\t\t\twantErr: \"listed in both extensions.enable and extensions.disable\",","+\t\t},","+\t\t{","+\t\t\tname:    \"unknown enable ID\",","+\t\t\tconfig:  config.ExtensionsConfig{Enable: []string{\"org.example.unknown.v1\"}},","+\t\t\twantErr: `unknown built-in extension \"org.example.unknown.v1\" (available: org.example.default.v1, org.example.optional.v1)`,","+\t\t},","+\t\t{","+\t\t\tname:    \"unknown disable ID\",","+\t\t\tconfig:  config.ExtensionsConfig{Disable: []string{\"org.example.unknown.v1\"}},","+\t\t\twantErr: `unknown built-in extension \"org.example.unknown.v1\" (available: org.example.default.v1, org.example.optional.v1)`,","+\t\t},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\tgot, err := selectBuiltinExtensions(tc.config, defaults, optional)","+\t\t\tif tc.wantErr != \"\" {","+\t\t\t\tassert.ErrorContains(t, err, tc.wantErr)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tassert.NilError(t, err)","+\t\t\tassert.Equal(t, len(got), len(tc.want))","+\t\t\tfor i, ext := range got {","+\t\t\t\tassert.DeepEqual(t, ext.Declaration(), tc.want[i].Declaration())","+\t\t\t}","+\t\t})","+\t}","+}",""],"additions":90,"deletions":0,"truncated":false}],"additions":207,"deletions":10,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-31T14:36:22.242189+00:00"}