ining -= captured","+\t}","+\treturn n, err","+}","+"," func (w *bodyDumpResponseWriter) WriteHeader(code int) {"," \tw.ResponseWriter.WriteHeader(code)"," }"],"additions":46,"deletions":3,"truncated":false},{"path":"middleware/body_dump_limits_test.go","lines":["@@ -0,0 +1,80 @@","+// SPDX-License-Identifier: MIT","+// SPDX-FileCopyrightText: © 2026 LabStack LLC and Echo contributors","+","+package middleware","+","+import (","+\t\"errors\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"testing\"","+\t\"testing/iotest\"","+","+\t\"github.com/labstack/echo/v4\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestBodyDumpCaptureLimits(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname                   string","+\t\treqLimit, resLimit     int64","+\t\tsize, reqWant, resWant int","+\t}{","+\t\t{\"configured\", 3, 4, 8, 3, 4},","+\t\t{\"exact\", 8, 8, 8, 8, 8},","+\t\t{\"unlimited\", -1, -1, 8, 8, 8},","+\t\t{\"default\", 0, 0, 6 << 20, 5 << 20, 5 << 20},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tpayload := strings.Repeat(\"x\", tc.size)","+\t\t\tvar requestDump, responseDump []byte","+\t\t\te := echo.New()","+\t\t\te.Use(BodyDumpWithConfig(BodyDumpConfig{MaxRequestBytes: tc.reqLimit, MaxResponseBytes: tc.resLimit,","+\t\t\t\tHandler: func(_ echo.Context, req, res []byte) { requestDump, responseDump = req, res }}))","+\t\t\te.POST(\"/\", func(c echo.Context) error {","+\t\t\t\tbody, err := io.ReadAll(c.Request().Body)","+\t\t\t\tif err != nil {","+\t\t\t\t\treturn err","+\t\t\t\t}","+\t\t\t\trequire.Equal(t, payload, string(body))","+\t\t\t\treturn c.String(http.StatusOK, string(body))","+\t\t\t})","+\t\t\trec := httptest.NewRecorder()","+\t\t\te.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, \"/\", strings.NewReader(payload)))","+\t\t\trequire.Equal(t, http.StatusOK, rec.Code)","+\t\t\trequire.Equal(t, payload, rec.Body.String())","+\t\t\trequire.Equal(t, payload[:tc.reqWant], string(requestDump))","+\t\t\trequire.Equal(t, payload[:tc.resWant], string(responseDump))","+\t\t})","+\t}","+}","+","+type bodyDumpCloseTracker struct {","+\tio.Reader","+\tclosed bool","+}","+","+func (b *bodyDumpCloseTracker) Close() error { b.closed = true; return nil }","+","+func TestBodyDumpPreservesRemainderErrorAndClose(t *testing.T) {","+\twantErr := errors.New(\"remainder failed\")","+\tbody := &bodyDumpCloseTracker{Reader: io.MultiReader(strings.NewReader(\"abcdefgh\"), iotest.ErrReader(wantErr))}","+\treq := httptest.NewRequest(http.MethodPost, \"/\", nil)","+\treq.Body = body","+\te := echo.New()","+\tc := e.NewContext(req, httptest.NewRecorder())","+\tvar dumped []byte","+\terr := BodyDumpWithConfig(BodyDumpConfig{MaxRequestBytes: 3, Handler: func(_ echo.Context, req, res []byte) { dumped = req }})(func(c echo.Context) error {","+\t\trequire.False(t, body.closed)","+\t\tdata, err := io.ReadAll(c.Request().Body)","+\t\trequire.Equal(t, \"abcdefgh\", string(data))","+\t\trequire.ErrorIs(t, err, wantErr)","+\t\trequire.NoError(t, c.Request().Body.Close())","+\t\trequire.True(t, body.closed)","+\t\treturn err","+\t})(c)","+\trequire.ErrorIs(t, err, wantErr)","+\trequire.Equal(t, \"abc\", string(dumped))","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"middleware/body_dump_security_test.go","lines":["@@ -0,0 +1,71 @@","+// SPDX-License-Identifier: MIT","+// SPDX-FileCopyrightText: © 2026 LabStack LLC and Echo contributors","+","+package middleware","+","+import (","+\t\"fmt\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/labstack/echo/v4\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestBodyDumpPreservesBodyLimit(t *testing.T) {","+\tfor _, dumpFirst := range []bool{false, true} {","+\t\tfor _, knownLength := range []bool{false, true} {","+\t\t\tt.Run(fmt.Sprintf(\"dumpFirst=%t/knownLength=%t\", dumpFirst, knownLength), func(t *testing.T) {","+\t\t\t\te := echo.New()","+\t\t\t\tdump := BodyDumpWithConfig(BodyDumpConfig{MaxRequestBytes: 4, Handler: func(echo.Context, []byte, []byte) {}})","+\t\t\t\tlimit := BodyLimit(\"5\")","+\t\t\t\tif dumpFirst {","+\t\t\t\t\te.Use(dump, limit)","+\t\t\t\t} else {","+\t\t\t\t\te.Use(limit, dump)","+\t\t\t\t}","+\t\t\t\taccepted := false","+\t\t\t\te.POST(\"/\", func(c echo.Context) error {","+\t\t\t\t\tif _, err := io.ReadAll(c.Request().Body); err != nil {","+\t\t\t\t\t\treturn err","+\t\t\t\t\t}","+\t\t\t\t\taccepted = true","+\t\t\t\t\treturn c.NoContent(http.StatusOK)","+\t\t\t\t})","+\t\t\t\treq := httptest.NewRequest(http.MethodPost, \"/\", strings.NewReader(\"ABCDEFGH\"))","+\t\t\t\tif !knownLength {","+\t\t\t\t\treq.ContentLength = -1","+\t\t\t\t\treq.TransferEncoding = []string{\"chunked\"}","+\t\t\t\t}","+\t\t\t\trec := httptest.NewRecorder()","+\t\t\t\te.ServeHTTP(rec, req)","+\t\t\t\trequire.Equal(t, http.StatusRequestEntityTooLarge, rec.Code)","+\t\t\t\trequire.False(t, accepted)","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestBodyDumpPreservesBodyLimitChunkedHTTP(t *testing.T) {","+\te := echo.New()","+\te.Use(BodyLimit(\"5\"), BodyDumpWithConfig(BodyDumpConfig{MaxRequestBytes: 4, Handler: func(echo.Context, []byte, []byte) {}}))","+\te.POST(\"/\", func(c echo.Context) error {","+\t\tbody, err := io.ReadAll(c.Request().Body)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\treturn c.String(http.StatusOK, string(body))","+\t})","+\tserver := httptest.NewServer(e)","+\tdefer server.Close()","+\treq, err := http.NewRequest(http.MethodPost, server.URL, io.NopCloser(strings.NewReader(\"ABCDEFGH\")))","+\trequire.NoError(t, err)","+\treq.TransferEncoding = []string{\"chunked\"}","+\tresponse, err := server.Client().Do(req)","+\trequire.NoError(t, err)","+\tdefer response.Body.Close()","+\trequire.Equal(t, http.StatusRequestEntityTooLarge, response.StatusCode)","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"middleware/decompress.go","lines":["@@ -19,6 +19,10 @@ type DecompressConfig struct {"," "," \t// GzipDecompressPool defines an interface to provide the sync.Pool used to create/store Gzip readers"," \tGzipDecompressPool Decompressor","+","+\t// MaxDecompressedSize limits the decompressed body in bytes. Reading beyond","+\t// the limit returns HTTP 413. Defaults to 100 MiB; -1 disables the limit.","+\tMaxDecompressedSize int64"," }"," "," // GZIPEncoding content-encoding header if set to \"gzip\", decompress body contents.","@@ -57,6 +61,9 @@ func DecompressWithConfig(config DecompressConfig) echo.MiddlewareFunc {"," \tif config.GzipDecompressPool == nil {"," \t\tconfig.GzipDecompressPool = DefaultDecompressConfig.GzipDecompressPool"," \t}","+\tif config.MaxDecompressedSize == 0 {","+\t\tconfig.MaxDecompressedSize = 100 * 1024 * 1024","+\t}"," "," \treturn func(next echo.HandlerFunc) echo.HandlerFunc {"," \t\tpool := config.GzipDecompressPool.gzipDecompressPool()","@@ -90,9 +97,43 @@ func DecompressWithConfig(config DecompressConfig) echo.MiddlewareFunc {"," \t\t\t// only Close gzip reader if it was set to a proper gzip source otherwise it will panic on close."," \t\t\tdefer gr.Close()"," ","-\t\t\tc.Request().Body = gr","+\t\t\tif config.MaxDecompressedSize > 0 {","+\t\t\t\tc.Request().Body = &limitedGzipReader{Reader: gr, remaining: config.MaxDecompressedSize}","+\t\t\t} else {","+\t\t\t\tc.Request().Body = gr","+\t\t\t}","+\t\t\tc.Request().ContentLength = -1"," "," \t\t\treturn next(c)"," \t\t}"," \t}"," }","+","+type limitedGzipReader struct {","+\t*gzip.Reader","+\tremaining int64","+}","+","+func (r *limitedGzipReader) Read(p []byte) (int, error) {","+\tif len(p) == 0 {","+\t\treturn 0, nil","+\t}","+\tif r.remaining < 0 {","+\t\treturn 0, echo.ErrStatusRequestEntityTooLarge","+\t}","+\tif r.remaining == 0 {","+\t\tvar probe [1]byte","+\t\tn, err := r.Reader.Read(probe[:])","+\t\tif n > 0 {","+\t\t\tr.remaining = -1","+\t\t\treturn 0, echo.ErrStatusRequestEntityTooLarge","+\t\t}","+\t\treturn 0, err","+\t}","+\tif int64(len(p)) > r.remaining {","+\t\tp = p[:r.remaining]","+\t}","+\tn, err := r.Reader.Read(p)","+\tr.remaining -= int64(n)","+\treturn n, err","+}"],"additions":42,"deletions":1,"truncated":false},{"path":"middleware/decompress_limits_test.go","lines":["@@ -0,0 +1,135 @@","+// SPDX-License-Identifier: MIT","+// SPDX-FileCopyrightText: © 2026 LabStack LLC and Echo contributors","+","+package middleware","+","+import (","+\t\"bytes\"","+\t\"compress/gzip\"","+\t\"fmt\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/labstack/echo/v4\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestDecompressSizeLimits(t *testing.T) {","+\tfor _, limit := range []int64{-1, 0, 7, 8, 9} {","+\t\tt.Run(fmt.Sprint(limit), func(t *testing.T) {","+\t\t\tzipped, err := gzipString(\"abcdefgh\")","+\t\t\trequire.NoError(t, err)","+\t\t\te := echo.New()","+\t\t\te.Use(DecompressWithConfig(DecompressConfig{MaxDecompressedSize: limit}))","+\t\t\te.POST(\"/\", func(c echo.Context) error {","+\t\t\t\trequire.EqualValues(t, -1, c.Request().ContentLength)","+\t\t\t\tbody, err := io.ReadAll(c.Request().Body)","+\t\t\t\tif err != nil {","+\t\t\t\t\treturn err","+\t\t\t\t}","+\t\t\t\treturn c.String(http.StatusOK, string(body))","+\t\t\t})","+\t\t\treq := httptest.NewRequest(http.MethodPost, \"/\", bytes.NewReader(zipped))","+\t\t\treq.Header.Set(echo.HeaderContentEncoding, GZIPEncoding)","+\t\t\trec := httptest.NewRecorder()","+\t\t\te.ServeHTTP(rec, req)","+\t\t\tif limit == 7 {","+\t\t\t\trequire.Equal(t, http.StatusRequestEntityTooLarge, rec.Code)","+\t\t\t} else {","+\t\t\t\trequire.Equal(t, http.StatusOK, rec.Code)","+\t\t\t\trequire.Equal(t, \"abcdefgh\", rec.Body.String())","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestDecompressReadBoundary(t *testing.T) {","+\tfor _, payload := range []string{\"A\", \"AB\"} {","+\t\tt.Run(payload, func(t *testing.T) {","+\t\t\tzipped, err := gzipString(payload)","+\t\t\trequire.NoError(t, err)","+\t\t\tgr, err := gzip.NewReader(bytes.NewReader(zipped))","+\t\t\trequire.NoError(t, err)","+\t\t\tdefer gr.Close()","+\t\t\treader := &limitedGzipReader{Reader: gr, remaining: 1}","+\t\t\tbuf := make([]byte, 1)","+\t\t\t_, err = io.ReadFull(reader, buf)","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = reader.Read(nil)","+\t\t\trequire.NoError(t, err)","+\t\t\tfor i := 0; i < 2; i++ {","+\t\t\t\tn, err := reader.Read(buf)","+\t\t\t\trequire.Zero(t, n)","+\t\t\t\tif payload == \"A\" {","+\t\t\t\t\trequire.ErrorIs(t, err, io.EOF)","+\t\t\t\t} else {","+\t\t\t\t\trequire.ErrorIs(t, err, echo.ErrStatusRequestEntityTooLarge)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestDecompressDefaultLimitStreaming(t *testing.T) {","+\tvar zipped bytes.Buffer","+\tzw := gzip.NewWriter(&zipped)","+\t// Generate compressed input incrementally; the test never buffers a 101 MiB body.","+\tfor i := 0; i < 101; i++ {","+\t\t_, err := io.Copy(zw, strings.NewReader(strings.Repeat(\"x\", 1<<20)))","+\t\trequire.NoError(t, err)","+\t}","+\trequire.NoError(t, zw.Close())","+\te := echo.New()","+\te.Use(Decompress())","+\tvar read int64","+\te.POST(\"/\", func(c echo.Context) error {","+\t\tvar err error","+\t\tread, err = io.Copy(io.Discard, c.Request().Body)","+\t\treturn err","+\t})","+\treq := httptest.NewRequest(http.MethodPost, \"/\", bytes.NewReader(zipped.Bytes()))","+\treq.Header.Set(echo.HeaderContentEncoding, GZIPEncoding)","+\trec := httptest.NewRecorder()","+\te.ServeHTTP(rec, req)","+\trequire.Equal(t, http.StatusRequestEntityTooLarge, rec.Code)","+\trequire.EqualValues(t, 100<<20, read)","+}","+","+func TestDecompressBindingLimitStatus(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname, contentType, payload string","+\t}{","+\t\t{\"json\", echo.MIMEApplicationJSON, `{\"value\":\"` + strings.Repeat(\"x\", 32) + `\"}`},","+\t\t{\"xml\", echo.MIMEApplicationXML, `<payload><value>` + strings.Repeat(\"x\", 32) + `</value></paylo