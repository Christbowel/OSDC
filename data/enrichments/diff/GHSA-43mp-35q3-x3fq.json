{"id":"GHSA-43mp-35q3-x3fq","axis":"advisories","repo":"pypa/virtualenv","sha":"2bfdc0230d1b2685fedfcfe66c835b9a2ec7c440","parsed":{"files":[{"path":"docs/changelog/3427.bugfix.rst","lines":["@@ -0,0 +1,2 @@","+Preserve file permissions when deletion fails on POSIX. On Windows, clear read-only attributes through a handle that","+opens the entry itself and prevents replacement, preserving other attributes and rejecting reparse points."],"additions":2,"deletions":0,"truncated":false},{"path":"src/virtualenv/util/path/_sync.py","lines":["@@ -5,9 +5,12 @@"," import shutil"," import sys"," from pathlib import Path","-from stat import S_IWUSR, S_IXGRP, S_IXOTH, S_IXUSR","+from stat import S_IXGRP, S_IXOTH, S_IXUSR"," from typing import TYPE_CHECKING, Final"," ","+if os.name == \"nt\":","+    from ._win import clear_readonly","+"," if TYPE_CHECKING:","     from collections.abc import Callable","     from types import TracebackType","@@ -74,11 +77,10 @@ def onerror(func: Callable[[str], object], path: str, exc_info: _ExcInfo) -> Non","         exc = exc_info[1] if isinstance(exc_info, tuple) else exc_info","         if isinstance(exc, FileNotFoundError):","             return","-        # rmtree also reports os.open/os.close/os.scandir/os.lstat; retrying one of those with a lone path raises","-        # TypeError over the real error, or deletes nothing while telling rmtree we handled the failure","-        if func not in {os.unlink, os.rmdir} or os.access(path, os.W_OK):","-            raise  # ruff:ignore[misplaced-bare-raise]","-        os.chmod(path, os.lstat(path).st_mode | S_IWUSR)","+        # POSIX deletion depends on the parent directory, so changing the entry's mode cannot help.","+        if os.name != \"nt\" or func not in {os.unlink, os.rmdir} or os.path.islink(path) or os.access(path, os.W_OK):","+            raise exc","+        clear_readonly(path)","         func(path)"," ","     if sys.version_info >= (3, 12):"],"additions":8,"deletions":6,"truncated":false},{"path":"src/virtualenv/util/path/_win.py","lines":["@@ -1,11 +1,15 @@"," from __future__ import annotations"," ","+import os","+from typing import Final","+","+if os.name == \"nt\":","+    import ctypes","+    from ctypes import wintypes","+"," "," def get_short_path_name(long_name: str) -> str:","     \"\"\"Gets the short path name of a given long path - http://stackoverflow.com/a/23598461/200291.\"\"\"","-    import ctypes  # ruff:ignore[import-outside-top-level]","-    from ctypes import wintypes  # ruff:ignore[import-outside-top-level]","-","     GetShortPathNameW = ctypes.windll.kernel32.GetShortPathNameW  # ruff:ignore[non-lowercase-variable-in-function]  # ty: ignore[unresolved-attribute]","     GetShortPathNameW.argtypes = [wintypes.LPCWSTR, wintypes.LPWSTR, wintypes.DWORD]","     GetShortPathNameW.restype = wintypes.DWORD","@@ -18,6 +22,57 @@ def get_short_path_name(long_name: str) -> str:","         output_buf_size = needed"," "," ","-__all__ = [","-    \"get_short_path_name\",","-]","+if os.name == \"nt\":","+","+    def clear_readonly(path: str) -> None:","+        kernel: Final = ctypes.WinDLL(\"kernel32\", use_last_error=True)","+        create: Final = kernel.CreateFileW","+        create.argtypes = [","+            wintypes.LPCWSTR,","+            wintypes.DWORD,","+            wintypes.DWORD,","+            wintypes.LPVOID,","+            wintypes.DWORD,","+            wintypes.DWORD,","+            wintypes.HANDLE,","+        ]","+        create.restype = wintypes.HANDLE","+        get_info: Final = kernel.GetFileInformationByHandleEx","+        get_info.argtypes = [wintypes.HANDLE, ctypes.c_int, wintypes.LPVOID, wintypes.DWORD]","+        get_info.restype = wintypes.BOOL","+        set_info: Final = kernel.SetFileInformationByHandle","+        set_info.argtypes = get_info.argtypes","+        set_info.restype = wintypes.BOOL","+        close: Final = kernel.CloseHandle","+        close.argtypes = [wintypes.HANDLE]","+        close.restype = wintypes.BOOL","+        # Open the entry itself and deny replacement while changing its read-only attribute.","+        handle: Final = create(path, 0x180, 0x3, None, 3, 0x02200000, None)","+        if handle == wintypes.HANDLE(-1).value:","+            raise ctypes.WinError(ctypes.get_last_error())","+        try:","+            info: Final = _FileBasicInfo()","+            if not get_info(handle, 0, ctypes.byref(info), ctypes.sizeof(info)):","+                raise ctypes.WinError(ctypes.get_last_error())","+            if info.attributes & 0x400:","+                msg: Final = f\"refusing to change attributes of a reparse point: {path}\"","+                raise OSError(msg)","+            info.attributes = (info.attributes & ~0x1) or 0x80","+            if not set_info(handle, 0, ctypes.byref(info), ctypes.sizeof(info)):","+                raise ctypes.WinError(ctypes.get_last_error())","+        finally:","+            close(handle)","+","+    class _FileBasicInfo(ctypes.Structure):","+        _fields_: Final = [","+            (\"creation\", ctypes.c_longlong),","+            (\"access\", ctypes.c_longlong),","+            (\"write\", ctypes.c_longlong),","+            (\"change\", ctypes.c_longlong),","+            (\"attributes\", wintypes.DWORD),","+        ]","+","+","+__all__ = [\"get_short_path_name\"]","+if os.name == \"nt\":","+    __all__ += [\"clear_readonly\"]"],"additions":61,"deletions":6,"truncated":false},{"path":"tests/unit/test_util.py","lines":["@@ -1,15 +1,18 @@"," from __future__ import annotations"," "," import concurrent.futures","+import ctypes"," import os"," import sys"," import traceback"," import zipfile","+from errno import EACCES"," from stat import S_IEXEC, S_IREAD, S_IRGRP, S_IRWXU, S_IWUSR"," from typing import TYPE_CHECKING, Final"," "," import pytest"," ","+from virtualenv import __version__"," from virtualenv.app_data import (","     AppDataDiskFolder,","     TempAppData,","@@ -23,6 +26,11 @@"," from virtualenv.util.path import