{"id":"7e189d6941bd8c0d8715be70661da363473b7c66","axis":"silent","repo":"pnpm/pnpm","sha":"7e189d6941bd8c0d8715be70661da363473b7c66","parsed":{"files":[{"path":".changeset/loose-minimum-release-age-persist.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` again records immature versions picked under `minimumReleaseAge` (when `minimumReleaseAgeStrict` is off) in `minimumReleaseAgeExclude` in `pnpm-workspace.yaml`, so a later frozen install of the same lockfile passes verification [#13687](https://github.com/pnpm/pnpm/issues/13687)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dedupe.rs","lines":["@@ -107,6 +107,10 @@ impl DedupeArgs {","             node_linker: config.node_linker,","             lockfile_only: true,","             dry_run: false,","+            // `--check` must leave the working tree untouched: the lockfile","+            // guard restores `pnpm-lock.yaml`, and this gate keeps loose","+            // minimumReleaseAge picks out of `pnpm-workspace.yaml`.","+            persist_policy_excludes: !self.check,","             update_seed_policy: pacquet_package_manager::UpdateSeedPolicy::KeepAllResolveAll,","             auth_override: None,","             resolution_observer: Some(Arc::new(DedupeResolutionReporter::<Reporter> {"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy.rs","lines":["@@ -393,6 +393,7 @@ impl DeployArgs {","             node_linker,","             lockfile_only: false,","             dry_run: false,","+            persist_policy_excludes: false,","             update_seed_policy: UpdateSeedPolicy::KeepAll,","             auth_override: None,","             resolution_observer: None,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/fetch.rs","lines":["@@ -66,6 +66,7 @@ impl FetchArgs {","             node_linker: fetch_config.node_linker,","             lockfile_only: fals