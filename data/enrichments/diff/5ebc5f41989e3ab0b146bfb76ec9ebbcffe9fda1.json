rquet keys are not persisted across restarts","+require noforcestorage","+","+# writing encrypted parquet requires a crypto provider; use the built-in mbedtls one","+statement ok","+SET force_mbedtls_unsafe = true","+","+statement ok","+PRAGMA add_parquet_key('key256', '01234567891123450123456789112345')","+","+# many small pages per column chunk, with rows ordered so that a pushed-down filter skips leading pages","+statement ok","+COPY (","+\tSELECT CASE WHEN i < 4000 THEN 'head' ELSE 'tail' END AS stream, repeat('x', 100) || i AS record","+\tFROM range(8000) t(i)","+) TO '{TEST_DIR}/encrypted_page_skip.parquet' (ENCRYPTION_CONFIG {footer_key: 'key256'}, DATA_PAGE_SIZE_LIMIT 65536)","+","+query I","+SELECT sum(length(record)) FROM read_parquet('{TEST_DIR}/encrypted_page_skip.parquet',","+\tencryption_config={footer_key: 'key256'}) WHERE stream = 'tail'","+----","+416000","+","+query I","+SELECT sum(length(record)) FROM read_parquet('{TEST_DIR}/encrypted_page_skip.parquet',","+\tencryption_config={footer_key: 'key256'}) WHERE stream = 'head'","+----","+414890","+","+# unfiltered scan as a sanity check","+query II","+SELECT count(*), sum(length(record)) FROM read_parquet('{TEST_DIR}/encrypted_page_skip.parquet',","+\tencryption_config={footer_key: 'key256'})","+----","+8000\t830890","+","+statement ok","+SET force_mbedtls_unsafe = false"],"additions":44,"deletions":0,"truncated":false},{"path":"test/sql/copy/parquet/encryption/multi_page_encryption.test","lines":["@@ -0,0 +1,49 @@","+# name: test/sql/copy/parquet/encryption/multi_page_encryption.test","+# description: Filtered scans of an encrypted Parquet file with multiple data pages per column chunk and an AAD (issue #28822)","+# group: [encryption]","+","+require parquet","+","+# parquet keys are not persisted across restarts","+require noforcestorage","+","+statement ok","+PRAGMA add_parquet_key('arrow_key_generated_files', '0123456789abcdef')","+","+# file written by parquet-rs 57 with a uniform footer key: 5000 rows of (id BIGINT, value VARCHAR),","+# dictionary + 10 data pages per column chunk, pages encrypted with an AAD that includes the page ordinal","+statement ok","+CREATE VIEW multi_page AS FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/multi_page_uniform_encryption.parquet',","+\tencryption_config={footer_key: 'arrow_key_generated_files'})","+","+# full scan reads every page of a chunk","+query II","+SELECT count(*), sum(id) FROM multi_page","+----","+5000\t12497500","+","+# Top-N re-enters page reading with a dynamic filter","+query II","+SELECT id, value FROM multi_page ORDER BY id DESC LIMIT 3","+----","+4999\tval4999","+4998\tval4998","+4997\tval4997","+","+# a pushed-down filter reads the filter column with page skipping","+query III","+SELECT count(*), min(id), sum(id) FROM multi_page WHERE id > 4489","+----","+510\t4490\t2419695","+","+# point lookup skips rows in both the filter column and the payload column","+query I","+SELECT value FROM multi_page WHERE id = 2500","+----","+val2500","+","+query II","+SELECT id, value FROM multi_page ORDER BY id LIMIT 2","+----","+0\tval0","+1\tval1"],"additions":49,"deletions":0,"truncated":false},{"path":"test/sql/copy/parquet/many_pages_per_chunk.test","lines":["@@ -0,0 +1,36 @@","+# name: test/sql/copy/parquet/many_pages_per_chunk.test","+# description: Reading a Parquet file with more than 32767 pages per column chunk","+# group: [parquet]","+","+require parquet","+","+# parquet keys are not persisted across restarts","+require noforcestorage","+","+statement ok","+COPY (FROM range(40000)) TO '{TEST_DIR}/many_pages_per_chunk.parquet' (DATA_PAGE_SIZE_LIMIT 1, ROW_GROUP_SIZE 100000)","+","+# an unencrypted file is not subject to the encryption page ordinal limit","+query II","+SELECT count(*), sum(range) FROM '{TEST_DIR}/many_pages_per_chunk.parquet'","+----","+40000\t799980000","+","+# writing encrypted parquet requires a crypto provider; use the built-in mbedtls one","+statement ok","+SET force_mbedtls_unsafe = true","+","+statement ok","+PRAGMA add_parquet_key('key256', '01234567891123450123456789112345')","+","+statement ok","+COPY (FROM range(40000)) TO '{TEST_DIR}/many_pages_per_chunk_encrypted.parquet' (ENCRYPTION_CONFIG {footer_key: 'key256'}, DATA_PAGE_SIZE_LIMIT 1, ROW_GROUP_SIZE 100000)","+","+# an encrypted column chunk that exceeds the AAD page ordinal range must raise a clear user-facing error","+statement error","+SELECT sum(range) FROM read_parquet('{TEST_DIR}/many_pages_per_chunk_encrypted.parquet', encryption_config={footer_key: 'key256'})","+----","+<REGEX>:Invalid Input Error.*maximum page ordinal.*","+","+statement ok","+SET force_mbedtls_unsafe = false",""],"additions":36,"deletions":0,"truncated":false}],"additions":157,"deletions":5,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-26T18:56:51.922485+00:00"}