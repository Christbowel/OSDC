rt',","+    );","+    expect(document.cookie).toContain(","+      'trpc-docs-tab-framework=TanStack%20Start',","+    );","+    expect(savedTab('framework')).toBe('TanStack Start');","+  });","+","+  it('reads the cookie when localStorage is blocked', () => {","+    saveTab('framework', 'Next.js');","+    vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => {","+      throw new Error('blocked');","+    });","+    expect(savedTab('framework')).toBe('Next.js');","+  });","+","+  it('has nothing saved before a pick', () => {","+    expect(savedTab('framework')).toBeNull();","+  });","+});"],"additions":35,"deletions":0,"truncated":false},{"path":"www/src/tabs.ts","lines":["@@ -33,3 +33,43 @@ export function validateTabSearch(search: Record<string, unknown>) {","   }","   return validated;"," }","+","+const storageKey = (group: string) => `trpc-docs:tab:${group}`;","+const cookieName = (group: string) =>","+  `trpc-docs-tab-${encodeURIComponent(group)}`;","+","+/**","+ * Keeps the tab the reader picked for `group`, in localStorage and a cookie,","+ * so the choice outlasts either being cleared or blocked. Only a click picks.","+ */","+export function saveTab(group: string, tab: string) {","+  document.cookie = `${cookieName(group)}=${encodeURIComponent(tab)}; Path=/; Max-Age=31536000; SameSite=Lax`;","+  try {","+    localStorage.setItem(storageKey(group), tab);","+  } catch {","+    // Storage is blocked: the cookie keeps the choice.","+  }","+}","+","+/** The tab the reader last picked for `group`: localStorage's, or else the cookie's. */","+export function savedTab(group: string) {","+  try {","+    const stored = localStorage.getItem(storageKey(group));","+    if (stored !== null) {","+      return stored;","+    }","+  } catch {","+    // Storage is blocked: read the cookie.","+  }","+  const name = `${cookieName(group)}=`;","+  const cookie = document.cookie","+    .split('; ')","+    .find((part) => part.startsWith(name));","+  try {","+    return cookie === undefined","+      ? null","+      : decodeURIComponent(cookie.slice(name.length));","+  } catch {","+    return null;","+  }","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"www/v11/docs/client/tanstack-react-query/handles.md","lines":["@@ -156,71 +156,138 @@ export function MoreByAuthor(props: { authorId: string }) {"," }"," ```"," ","-A post page at `/posts/$id` reads `id` from the URL and loads its queries in one call:","+```twoslash include handles-start","+// @filename: lib/trpc.ts","+export { useTRPC, type TRPC } from '~/trpc/client';","+// @filename: routes/__root.tsx","+import { createRootRouteWithContext } from '@tanstack/react-router';","+import type { TRPC } from '~/trpc/client';","+export const Route = createRootRouteWithContext<{ trpc: TRPC }>()();","+// @filename: routeTree.gen.ts","+import type { Route as rootRoute } from './routes/__root';","+import type { Route as postRoute } from './routes/posts.$id';","+declare module '@tanstack/react-router' {","+  interface FileRoutesByPath {","+    '/posts/$id': {","+      id: '/posts/$id';","+      path: '/posts/$id';","+      fullPath: '/posts/$id';","+      preLoaderRoute: typeof postRoute;","+      parentRoute: typeof rootRoute;","+    };","+  }","+}","+```"," ","-```ts twoslash","+## In short {#gist}","+","+Load the handles where the page starts, and read each one in a component, which never names the procedure or repeats its input:","+","+<div class=\"code-tabs\" data-tabs=\"framework\">","+<div data-tab=\"TanStack Start\">","+","+```tsx twoslash title='src/routes/posts.$id.tsx'"," // @include: handles-router"," // @include: handles-trpc","-// @filename: loader.ts","-import { trpc } from '~/trpc/server';","-declare const id: string;","+// @include: handles-components","+// @include: handles-start","+// @filename: routes/posts.$id.tsx"," // ---cut---","+// ---collapse---","+import { useSuspenseQuery } from '@tanstack/react-query';","+import { createFileRoute } from '@tanstack/react-router';"," import {","   ensureEntry,","+  fromHandle,","   loadHandles,","-  prefetchInfiniteEntry,"," } from '@trpc/tanstack-react-query/unstable-handles';","+import { useTRPC } from '~/lib/trpc';","+// ---/collapse---"," ","-const [handles] = await loadHandles(trpc, {","-  // 1. The post: the load waits for it","-  post: ensureEntry(trpc.post.byId, { id }),","-  // 2. Its comments: start at the same time, and stream in later","-  comments: prefetchInfiniteEntry(trpc.post.comments, { postId: id }),","+export const Route = createFileRoute('/posts/$id')({","+  loader: async ({ context: { trpc }, params }) => {","+    const [handles] = await loadHandles(trpc, {","+//                          ^^^^^^^^^^^","+      post: ensureEntry(trpc.post.byId, { id: params.id }),","+//          ^^^^^^^^^^^","+    });","+    return handles;","+  },","+  component: PostPage,"," });","+","+function PostPage() {","+  const handles = Route.useLoaderData();","+  const trpc = useTRPC();","+  const postQuery = useSuspenseQuery(fromHandle(trpc, handles.post));","+//                                   ^^^^^^^^^^","+  return <h1>{postQuery.data.title}</h1>;","+}"," ```"," ","-The page reads the handles:","+</div>","+<div data-tab=\"Next.js\">"," ","-```tsx twoslash","+The page, a server component, loads the handles:","+","+```tsx twoslash title='app/posts/[id]/page.tsx'"," // @include: handles-router"," // @include: handles-trpc"," // @include: handles-components","-// @filename: post-page.tsx","-import type { inferInfiniteQueryHandle, inferQueryHandle } from '@trpc/tanstack-react-query/unstable-handles';","-import type { TRPC } from '~/trpc/client';","+// @filename: app/posts/[id]/post.tsx","+export { Post } from '~/components/post';","+// @filename: app/posts/[id]/page.tsx","+// ---cut---","+// ---collapse---","+import { ensureEntry, loadHandles } from '@trpc/tanstack-react-query/unstable-handles';","+import { HydrateClient, trpc } from '~/trpc/server';","+import { Post } from './post';","+// ---/collapse---","+","+export default async function PostPage(props: { params: Promise<{ id: string }> }) {","+  const { id } = await props.params;","+  const [handles] = await loadHandles(trpc, {","+//                        ^^^^^^^^^^^","+    post: ensureEntry(trpc.post.byId, { id }),","+//        ^^^^^^^^^^^","+  });","+  return (","+    <HydrateClient>","+      <Post post={handles.post} />","+    </HydrateClient>","+  );","+}","+```","+","+A client component, in its own file, reads one:","+","+```tsx twoslash title='app/posts/[id]/post.tsx'","+// @include: handles-router","+// @include: handles-trpc","+// @filename: app/posts/[id]/post.tsx"," // ---cut---","+'use client';","+","+// ---collapse---"," import { useSuspenseQuery } from '@tanstack/react-query';","-import { fromHandle } from '@trpc/tanstack-react-query/unstable-handles';","-import { Suspense } from 'react';","-import { Comments } from '~/components/comments';","-import { MoreByAuthor } from '~/components/more-by-author';","-import { useTRPC } from '~/trpc/client';","+import { fromHandle, type inferQueryHandle } from '@trpc/tanstack-react-query/unstable-handles';","+import { useTRPC, type TRPC } from '~/trpc/client';","+// ---/collapse---"," ","-export function PostPage(props: {","-  post: inferQueryHandle<TRPC['post']['byId']>;","-  comments: inferInfiniteQueryHandle<TRPC['post']['comments']>;","-}) {","+export function Post(props: { post: inferQueryHandle<TRPC['post']['byId']> }) {","+//                                  ^^^^^^^^^^^^^^^^","   const trpc = useTRPC();","   const postQuery = useSuspenseQuery(fromHandle(trpc, props.post));","-","-  return (","-    <article>","-      <h1>{postQuery.data.title}</h1>","-      <Suspense fallback={<p>Loading comments…</p>}>","-        <Comments comments={props.comments} />","-      </Suspense>","-      {/* 3. More by the author: needs the post's authorId */}","-      <Suspense fallback={<p>Loading more by this author…</p>}>","-        <MoreByAuthor authorId={postQuery.data.authorId} />","-      </Suspense>","-    </article>","-  );","+//                                   ^^^^^^^^^^","+  return <h1>{postQuery.data.title}</h1>;"," }"," ```"," ","-- More by the author needs the post's `authorId`, which isn't in the URL, so it starts once the post has loaded: see [Dependent queries](#dependent-queries).","-- The data reaches the browser's cache through TanStack Query's dehydrate and hydrate: see [Next.js](#nextjs-app-router), [TanStack Start](/docs/client/tanstack-react-query/tanstack-start) or [React Router](#react-router).","-- Components that read handles are the same whatever loaded the handle.","+</div>","+</div>","+","+- The handle carries the procedure and its input, typed.","+- The data reaches the browser's cache through TanStack Query's dehydrate and hydrate: see [Frameworks](#frameworks)."," - Mutations don't change. To refetch a handle's query after one, invalidate `{ queryKey: handle.queryKey, exact: true }`."," "," ## Loading handles {#starting-a-query}","@@ -257,7 +324,7 @@ data.comments;"," "," - Building an entry starts nothing. The load starts every entry before it waits for any, so their order doesn't matter."," - `handles` has a handle for each entry. Return it from the loader, or pass it on as props.","-- Don't call `loadHandles` during render. A component that renders before anything loaded its query reads it with `useSuspenseQuery(trpc.x.queryOptions(input))`.","+- In a client component, don't call `loadHandles` during render: each render would start the entries again. Server components can. A client component that renders before anything loaded its query reads it with `useSuspenseQuery(trpc.x.queryOptions(input))`."," "," #### Using the data in a loader {#loader-data}"," ","@@ -284,9 +351,8 @@ Load handles where the code can wait:"," "," | Your app                       | Where                      | Proxy                                   |"," | ------------------------------ | ---------------------