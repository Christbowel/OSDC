{"id":"GHSA-7rv5-mrxv-xcr9","axis":"advisories","repo":"lxsmnsyc/seroval","sha":"3edc78b495ea0d6bd498143e5b3e56996607c5f2","parsed":{"files":[{"path":".changeset/stream-sequence-class-identity.md","lines":["@@ -0,0 +1,5 @@","+---","+\"seroval\": patch","+---","+","+Back the internal `Stream` and `Sequence` types with real classes and check their identity with `instanceof` instead of a marker property. Untrusted input can no longer forge a stream or sequence by copying a `__SEROVAL_STREAM__` or `__SEROVAL_SEQUENCE__` key. A stream or sequence read back through the eval-based `deserialize` is a plain object rather than a class instance, so re-serializing that value no longer detects it as a stream or sequence."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/seroval/src/core/sequence.ts","lines":["@@ -1,16 +1,28 @@"," import { ITERATOR_CONSTRUCTOR } from './constructors';"," import { SYM_ITERATOR } from './symbols';"," ","-export interface Sequence {","-  __SEROVAL_SEQUENCE__: true;","-","+/**","+ * An internal class rather than a tagged POJO: identity is checked with","+ * `instanceof`, which untrusted input cannot forge (the class is not exported).","+ * The eval-based `deserialize` path still rebuilds a `{__SEROVAL_SEQUENCE__…}`","+ * POJO from embedded source - it has no access to this class - so a value read","+ * back through `deserialize` is not an instance and, by design, is not treated","+ * as a genuine Sequence on re-serialization.","+ */","+export class Sequence {","   v: unknown[];","   t: number;","   d: number;","+","+  constructor(values: unknown[], throwAt: number, doneAt: number) {","+    this.v = values;","+    this.t = throwAt;","+    this.d = doneAt;","+  }"," }"," "," export function isSequence(value: object): value is Sequence {","-  return '__SEROVAL_SEQUENCE__' in value;","+  return value instanceof Sequence;"," }"," "," export function createSequence(","@@ -18,13 +30,7 @@ export function createSequence(","   throwAt: number,","   doneAt: number,"," ): Sequence {","-  return {","-    __SEROVAL_SEQUENCE__: true,","-","-    v: values,","-    t: throwAt,","-    d: doneAt,","-  };","+  return new Sequence(values, throwAt, doneAt);"," }"," "," export function createSequenceFromIterable<T>(source: Iterable<T>): Sequence {"],"additions":17,"deletions":11,"truncated":false},{"path":"packages/seroval/src/core/stream.ts","lines":["@@ -1,8 +1,4 @@","-import {","-  ASYNC_ITERATOR_CONSTRUCTOR,","-  PROMISE_CONSTRUCTOR,","-  STREAM_CONSTRUCTOR,","-} from './constructors';","+import { ASYNC_ITERATOR_CONSTRUCTOR, PROMISE_CONSTRUCTOR } from './constructors';"," import { SYM_ASYNC_ITERATOR } from './symbols';"," "," export interface StreamListener<T> {","@@ -11,22 +7,102 @@ export interface StreamListener<T> {","   return(value: T): void;"," }"," ","-export interface Stream<T> {","-  __SEROVAL_STREAM__: true;","+/**","+ * An internal class rather than a tagged POJO: identity is checked with","+ * `instanceof`, which untrusted input cannot forge (the class is not exported).","+ *","+ * The behavior is intentionally duplicated from `STREAM_CONSTRUCTOR`. That","+ * constructor's source is embedded verbatim into the eval-based `deserialize`","+ * output, which has no access to this class, so the two cannot be shared. A","+ * stream read back through `deserialize` is therefore a plain POJO and, by","+ * design, is not treated as a genuine Stream on re-serialization. Keep the two","+ * implementations in sync.","+ */","+export class Stream<T> {","+  #buffer: unknown[] = [];","+  #listeners: (StreamListener<T> | undefined)[] = [];","+  #alive = true;","+  #success = false;","+  #count = 0;"," ","-  on(listener: StreamListener<T>): () => void;","+  #flush(value: unknown, mode: 'next' | 'throw' | 'return'): void {","+    for (let x = 0; x < this.#count; x++) {","+      this.#listeners[x]?.[mode](value as T);","+    }","+  }"," ","-  next(value: T): void;","-  throw(value: unknown): void;","-  return(value: T): void;","+  #replay(listener: StreamListener<T>): void {","+    for (let x = 0, z = this.#buffer.length; x < z; x++) {","+      const current = this.#buffer[x];","+      if (!this.#alive && x === z - 1) {","+        listener[this.#success ? 'return' : 'throw'](current as T);","+      } else {","+        listener.next(current as T);","+      }","+    }","+  }","+","+  on(listener: StreamListener<T>): () => void {","+    let subscribed = this.#alive;","+    let temp = 0;","+    if (subscribed) {","+      for (; temp < this.#count; temp++) {","+        if (!this.#listeners[temp]) {","+          break;","+        }","+      }","+      if (temp === this.#count) {","+        this.#count++;","+      }","+      this.#listeners[temp] = listener;","+    }","+    this.#replay(listener);","+    return () => {","+      if (this.#alive && subscribed) {","+        subscribed = false;","+        this.#listeners[temp] = undefined;","+        while (this.#count > 0 && !this.#listeners[this.#count - 1]) {","+          this.#count--;","+        }","+        this.#listeners.length = this.#count;","+      }","+    };","+  }","+","+  next(value: T): void {","+    if (this.#alive) {","+      this.#buffer.push(value);","+      this.#flush(value, 'next');","+    }","+  }","+","+  throw(value: unknown): void {","+    if (this.#alive) {","+      this.#buffer.push(value);","+      this.#flush(value, 'throw');","+      this.#alive = false;","+      this.#success = false;","+      this.#listeners.length = 0;","+    }","+  }","+","+  return(value: T): void {","+    if (this.#alive) {","+      this.#buffer.push(value);","+      this.#flush(value, 'return');","+      this.#alive = false;","+      this.#success = true;","+      this.#listeners.length = 0;","+    }","+  }"," }"," "," export function isStream<T>(value: object): value is Stream<T> {","-  return '__SEROVAL_STREAM__' in value;","+  return value instanceof Stream;"," }"," "," export function createStream<T>(): Stream<T> {","-  return STREAM_CONSTRUCTOR() as unknown as Stream<T>;","+  return new Stream<T>();"," }"," "," export function createStreamFromAsyncIterable<T>("],"additions":89,"deletions":13,"truncated":false},{"path":"packages/seroval/test/forged-sequence.test.ts","lines":["@@ -0,0 +1,95 @@","+import { describe, expect, it } from 'vitest';","+import {","+  crossSerialize,","+  crossSerializeAsync,","+  crossSerializeStream,","+  deserialize,","+  serialize,","+  serializeAsync,","+  toJSON,","+  toJSONAsync,","+  fromJSON,","+} from '../src';","+","+// Plain data can carry a `__SEROVAL_SEQUENCE__` key. It must be serialized","+// as an ordinary object, never as an internal sequence whose `t` and `d`","+// fields are written into the output as code.","+describe('forged sequence objects', () => {","+  const PAYLOAD = '(globalThis.__SEROVAL_PWN__=1)';","+","+  function forged(): Record<string, unknown> {","+    return JSON.parse(","+      JSON.stringify({","+        __SEROVAL_SEQUENCE__: true,","+        v: [1],","+        t: PAYLOAD,","+        d: PAYLOAD,","+      }),","+    );","+  }","+","+  function check(result: string): void {","+    expect(result).not.toContain(`t:${PAYLOAD}`);","+    expect(result).not.toContain(`d:${PAYLOAD}`);","+    delete (globalThis as Record<string, unknown>).__SEROVAL_PWN__;","+    const back = deserialize(result.replace(/^\\$R\\[0\\]=/, '')) as unknown;","+    expect((globalThis as Record<string, unknown>).__SEROVAL_PWN__).toBe(","+      undefined,","+    );","+    expect(back).toStrictEqual(forged());","+  }","+","+  it('serialize', () => {","+    check(serialize(forged()));","+  });","+","+  it('serializeAsync', async () => {","+    check(await serializeAsync(forged()));","+  });","+","+  it('crossSerialize', () => {","+    const result = crossSerialize(forged());","+    expect(result).not.toContain(`t:${PAYLOAD}`);","+    expect(result).not.toContain(`d:${PAYLOAD}`);","+  });","+","+  it('crossSerializeAsync', async () => {","+    const result = await crossSerializeAsync(forged());","+    expect(result).not.toContain(`t:${PAYLOAD}`);","+    expect(result).not.toContain(`d:${PAYLOAD}`);","+  });","+","+  it('crossSerializeStream', async () => {","+    const chunks: string[] = [];","+    await new Promise<void>((resolve, reject) => {","+      crossSerializeStream(Promise.resolve(forged()), {","+        onSerialize(data) {","+          chunks.push(data);","+        },","+        onDone: resolve,","+        onError: reject,","+      });","+    });","+    const result = chunks.join('');","+    expect(result).not.toContain(`t:${PAYLOAD}`);","+    expect(result).not.toContain(`d:${PAYLOAD}`);","+  });","+","+  it('toJSON / fromJSON', async () => {","+    expect(fromJSON(toJSON(forged()))).toStrictEqual(forged());","+    expect(fromJSON(await toJSONAsync(forged()))).toStrictEqual(forged());","+  });","+","+  it('still serializes real iterables as sequences', () => {","+    const source = {","+      *[Symbol.iterator]() {","+        yield 1;","+        yield 2;","+      },","+    };","+    const result = serialize(source);","+    expect(result).toContain('__SEROVAL_SEQUENCE__:!0');","+    const back = deserialize<Iterable<number>>(result);","+    expect([...back]).toStrictEqual([1, 2]);","+  });","+});"],"additions":95,"deletions":0,"truncated":false},{"path":"packages/seroval/test/stream-sequence-brand.test.ts","lines":["@@ -0,0 +1,29 @@","+import { describe, expect, it } from 'vitest';","+import { createSequence, isSequence } from '../src/core/sequence';","+import { createStream, isStream } from '../src/core/stream';","+","+describe('Stream/Sequence identity', () => {","+  it('recognizes a genuine Stream', () => {","+    expect(isStream(createStream())).toBe(true);","+  });","+","+  it('rejects a POJO forging the Stream marker', () => {","+    const forged = {","+      __SEROVAL_STREAM__: true,","+      on: () => () => undefined,","+      next: () => undefined,","+      throw: () => undefined,","+      return: () => undefined,","+    };","+    expect(isStream(forged)).toBe(false);","+  });","+","+  it('recognizes a genuine Sequence', () => {","+    expect(isSequence(createSequence([1, 2], -1, 1))).toBe(true);","+  });","+","+  it('rejects a POJO forging the Sequence marker', () => {","+    const forged = { __SEROVAL_SEQUENCE__: true, v: [1], t: -1, d: 0 };","+    expect(isSequence(forged)).toBe(false);","+  });","+});",""],"additions":29,"deletions":0,"truncated":false}],"additions":235,"deletions":24,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-29T15:18:37.776118+00:00"}