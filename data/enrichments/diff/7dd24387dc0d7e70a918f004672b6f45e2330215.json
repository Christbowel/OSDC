absolute Mercator position for terrain FBO UV lookups","@@ -80,6 +78,10 @@ vec2 terrain_globe_to_mercator(vec3 globePosition) {","   float y = atanh(sinLat);","   return (vec2(x, y) + PI) * WORLD_SCALE;"," }","+","+float terrain_globe_latitude_scale(vec3 globePosition) {","+  return length(globePosition.xy) / length(globePosition);","+}"," `,","   fs: `${uniformBlock}in vec2 terrainMercPos;\\nin float terrainHeight;`,"," ","@@ -102,7 +104,10 @@ vec2 terrain_globe_to_mercator(vec3 globePosition) {","         terrainSkipRender","       } = opts;","       const projectUniforms = project.getUniforms(opts.project) as ProjectUniforms;","-      const {commonOrigin} = projectUniforms;","+      // Globe sampling uses absolute Mercator positions, not the sphere's common origin.","+      const commonOrigin = isFlatViewport(opts.project!.viewport)","+        ? projectUniforms.commonOrigin","+        : [0, 0, 0];"," ","       let mode: number = terrainSkipRender ? TERRAIN_MODE.SKIP : TERRAIN_MODE.NONE;","       // height map if case USE_HEIGHT_MAP, terrain cover if USE_COVER, otherwise empty","@@ -138,6 +143,7 @@ vec2 terrain_globe_to_mercator(vec3 globePosition) {","       /* eslint-disable camelcase */","       return {","         mode,","+        heightRange: opts.heightMapRange || [0, 1],","         terrain_map: sampler,","         // Convert bounds to common space, as [minX, minY, width, height]","         bounds: bounds","@@ -155,20 +161,25 @@ vec2 terrain_globe_to_mercator(vec3 globePosition) {","     // Provide the dummy texture to satisfy the terrain_map binding.","     return {","       mode: TERRAIN_MODE.NONE,","+      heightRange: opts.heightMapRange || [0, 1],","       terrain_map: opts.dummyHeightMap,","       bounds: [0, 0, 0, 0]","     };","   },","   uniformTypes: {","     mode: 'f32',","-    bounds: 'vec4<f32>'","+    bounds: 'vec4<f32>',","+    heightRange: 'vec2<f32>'","   }"," } as const satisfies ShaderModule<TerrainModuleProps, TerrainModuleUniforms, TerrainModuleBindings>;"," "," export const terrainPlugin: ShaderPlugin = {","   name: 'terrain',","   module: terrainModule,","+  interStageVariables: {terrainHeightWGSL: {type: 'f32'}},","   injections: {","+    'wgsl:vs:DECKGL_FILTER_GL_POSITION': terrainWGSLVertexInjection,","+    'wgsl:fs:#main-start': terrainWGSLFragmentInjection,","     'glsl:vs:#main-start': /* glsl */ `"," if (terrain.mode == TERRAIN_MODE_SKIP) {","   gl_Position = vec4(0.0);","@@ -201,7 +212,7 @@ if (terrain.mode == TERRAIN_MODE_USE_HEIGHT_MAP) {","     if ((project.projectionMode == PROJECTION_MODE_GLOBE || project.projectionMode == PROJECTION_MODE_GLOBE_METER_OFFSETS)) {","       // Height map is written in Mercator common space (units = TILE_SIZE / EARTH_CIRCUMFERENCE / cos(lat))","       // Convert to globe radial units (units = GLOBE_RADIUS / EARTH_RADIUS)","-      terrainZ *= cos(radians(geometry.worldPosition.y)) * PI;","+      terrainZ *= terrain_globe_latitude_scale(anchorCommon) * PI;","       geometry.position.xyz += normalize(geometry.position.xyz) * terrainZ;","     } else {","       geometry.position.z += terrainZ;"],"additions":28,"deletions":17,"truncated":false},{"path":"modules/extensions/src/terrain/shader-module.wgsl.ts","lines":["@@ -0,0 +1,108 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import {TERRAIN_MODE} from './terrain-mode';","+","+export const terrainWGSLSource = /* wgsl */ `","+${Object.entries(TERRAIN_MODE)","+  .map(([key, value]) => `const TERRAIN_MODE_${key}: f32 = ${value}.0;`)","+  .join('\\n')}","+","+struct TerrainUniforms {","+  mode: f32,","+  bounds: vec4<f32>,","+  heightRange: vec2<f32>,","+};","+@group(0) @binding(auto) var<uniform> terrain: TerrainUniforms;","+@group(0) @binding(auto) var terrain_map: texture_2d<f32>;","+","+fn terrain_globe_to_mercator(position: vec3<f32>) -> vec2<f32> {","+  let sinLat = clamp(position.z / length(position), -0.999998, 0.999998);","+  return (vec2<f32>(atan2(position.x, -position.y), atanh(sinLat)) + PI) * WORLD_SCALE;","+}","+","+fn terrain_globe_latitude_scale(position: vec3<f32>) -> f32 {","+  return length(position.xy) / length(position);","+}","+","+fn terrain_encode_height(height: f32) -> vec4<f32> {","+  let bits = bitcast<u32>(height);","+  return vec4<f32>(vec4<u32>(bits, bits >> 8u, bits >> 16u, bits >> 24u) & vec4<u32>(255u)) / 255.0;","+}","+","+fn terrain_decode_height(pixel: vec4<f32>) -> f32 {","+  let bytes = vec4<u32>(round(pixel * 255.0));","+  return bitcast<f32>(bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (bytes.w << 24u));","+}","+","+fn terrain_load_height(pixel: vec2<i32>) -> f32 {","+  let dimensions = vec2<i32>(textureDimensions(terrain_map));","+  return terrain_decode_height(textureLoad(terrain_map, clamp(pixel, vec2<i32>(0), dimensions - 1), 0));","+}","+","+fn terrain_sample_height(uv: vec2<f32>) -> f32 {","+  // WebGPU render textures have their origin at the top left.","+  let pixel = vec2<f32>(uv.x, 1.0 - uv.y) * vec2<f32>(textureDimensions(terrain_map)) - 0.5;","+  let base = vec2<i32>(floor(pixel));","+  let weight = fract(pixel);","+  let a = terrain_load_height(base);","+  let b = terrain_load_height(base + vec2<i32>(1, 0));","+  let c = terrain_load_height(base + vec2<i32>(0, 1));","+  let d = terrain_load_height(base + vec2<i32>(1, 1));","+  return mix(mix(a, b, weight.x), mix(c, d, weight.x), weight.y);","+}","+","+fn terrain_get_height(commonPosition: vec3<f32>) -> f32 {","+  let uv = (commonPosition.xy - terrain.bounds.xy) / terrain.bounds.zw;","+  if (all(uv >= vec2<f32>(0.0)) && all(uv <= vec2<f32>(1.0))) {","+    return terrain_sample_height(uv);","+  }","+  return 0.0;","+}","+`;","+","+export const terrainWGSLVertexInjection = /* wgsl */ `","+  let commonPos = geometry.position.xyz;","+  // Globe meter offsets are projected into the same globe common space as absolute positions.","+  let isGlobe = project.projectionMode == PROJECTION_MODE_GLOBE ||","+    project.projectionMode == PROJECTION_MODE_GLOBE_METER_OFFSETS;","+  var terrainMercPos = commonPos.xy;","+  terrainHeightWGSL = commonPos.z + project.commonOrigin.z;","+  if (isGlobe) {","+    terrainMercPos = terrain_globe_to_mercator(commonPos);","+    terrainHeightWGSL = length(commonPos) - GLOBE_RADIUS;","+  }","+  if (terrain.mode == TERRAIN_MODE_SKIP) {","+    *position = vec4<f32>(0.0);","+  } else if (terrain.mode == TERRAIN_MODE_WRITE_HEIGHT_MAP) {","+    let uv = (terrainMercPos - terrain.bounds.xy) / terrain.bounds.zw;","+    // Higher surfaces win independently of draw order, including below sea level.","+    let depth = (terrain.heightRange.y - terrainHeightWGSL) / (terrain.heightRange.y - terrain.heightRange.x);","+    *position = vec4<f32>(uv * 2.0 - 1.0, depth, 1.0);","+  } else if (terrain.mode == TERRAIN_MODE_USE_HEIGHT_MAP) {","+    let anchor = project_position_vec3_f32(vec3<f32>(geometry.worldPosition.xy, 0.0));","+    var anchorMerc = anchor;","+    var offset = vec3<f32>(0.0, 0.0, 1.0);","+    if (isGlobe) {","+      anchorMerc = vec3<f32>(terrain_globe_to_mercator(anchor), 0.0);","+      offset = normalize(commonPos) * terrain_globe_latitude_scale(anchor) * PI;","+    }","+    let height = terrain_get_height(anchorMerc);","+    // Preserve clip-space billboard offsets so perspective scales them at the fitted height.","+    let anchorClip = project_common_position_to_clipspace(geometry.position);","+    let clipOffset = *position - anchorClip;","+    // Keep the source elevation available for layers that sample their full footprint.","+    let fittedClip = project_common_position_to_clipspace(geometry.position + vec4<f32>(offset * height, 0.0));","+    // Billboard paths keep a fixed screen-space stroke; other billboard offsets scale with depth.","+    // Preserve any earlier camera clipping carried in clipOffset.w.","+    let screenOffsetCorrection = geometry.screenSpaceOffset * (fittedClip.w - anchorClip.w);","+    *position = fittedClip + clipOffset + vec4<f32>(screenOffsetCorrection, 0.0);","+  }","+`;","+export const terrainWGSLFragmentInjection = /* wgsl */ `","+  if (terrain.mode == TERRAIN_MODE_SKIP) { discard; }","+  if (terrain.mode == TERRAIN_MODE_WRITE_HEIGHT_MAP) {","+    return terrain_encode_height(terrainHeightWGSL);","+  }","+`;"],"additions":108,"deletions":0,"truncated":false},{"path":"modules/extensions/src/terrain/terrain-effect.ts","lines":["@@ -28,11 +28,13 @@ export class TerrainEffect implements Effect {","   /** A texture encoding the ground elevation, updated once per redraw. Used by layers with offset mode */","   private heightMap?: HeightMapBuilder;","   private terrainPass!: TerrainPass;","+  private supportsDraping = true;","   private terrainPickingPass!: TerrainPickingPass;","   /** One texture for each primitive terrain layer, into which the draped layers render */","   private terrainCovers: Map<string, TerrainCover> = new Map();"," ","   setup({device, deck}: EffectContext) {","+    this.supportsDraping = device.type !== 'webgpu';","     this.dummyHeightMap = device.createTexture({","       width: 1,","       height: 1,","@@ -62,7 +64,7 @@ export class TerrainEffect implements Effect {","     const {viewports} = opts;","     const isPicking = opts.pass.startsWith('picking');","     this.isPicking = isPicking;","-    this.isDrapingEnabled = true;","+    this.isDrapingEnabled = this.supportsDraping;"," ","     // TODO - support multiple views?","     const viewport = viewports[0];","@@ -83,6 +85,8 @@ export class TerrainEffect implements Effect {","       }","     }"," ","+    if (!this.supportsDraping) return;","+","     const drapeLayers = layers.filter(l => l.state.terrainDrawMode === 'drape');","     // Filter out the terrain effect itself to avoid feedback loops when rendering terrain covers","     // (the terrain cover FBO would be both read and written to). Other effects like MaskEffect","@@ -165,6 +169,7 @@ export class TerrainEffect implements Effect {","       shaderModuleProps: 