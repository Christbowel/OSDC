{"id":"GHSA-4fqr-96q8-xrfx","axis":"advisories","repo":"sparklemotion/sqlite3-ruby","sha":"41059aa3ccc2c0f910d6df4fccfe36b3c3c6c649","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -4,6 +4,7 @@"," "," ### Security / Stability"," ","+- Raise `RangeError` when a SQL string, a bound String or Blob value, or a String or Blob returned from a custom function or aggregate is longer than `INT_MAX` bytes. Previously the length was truncated to 32 bits, so SQLite could read only part of the string and drop trailing clauses from a query. See [GHSA-4fqr-96q8-xrfx](https://github.com/sparklemotion/sqlite3-ruby/security/advisories/GHSA-4fqr-96q8-xrfx) for more information. @flavorjones"," - Fix a crash when a custom aggregate's `finalize` returns a value that can't be converted to a SQLite result. The exception is now raised from the query and the connection remains usable. @flavorjones"," "," ### Improved"],"additions":1,"deletions":0,"truncated":false},{"path":"ext/sqlite3/database.c","lines":["@@ -529,14 +529,14 @@ set_sqlite3_func_result(sqlite3_context *ctx, VALUE result)","                 sqlite3_result_blob(","                     ctx,","                     (const void *)StringValuePtr(result),","-                    (int)RSTRING_LEN(result),","+                    RSTRING_LENINT(result),","                     SQLITE_TRANSIENT","                 );","             } else {","                 sqlite3_result_text(","                     ctx,","                     (const char *)StringValuePtr(result),","-                    (int)RSTRING_LEN(result),","+                    RSTRING_LENINT(result),","                     SQLITE_TRANSIENT","                 );","             }"],"additions":2,"deletions":2,"truncated":false},{"path":"ext/sqlite3/statement.c","lines":["@@ -75,7 +75,7 @@ prepare(VALUE self, VALUE db, VALUE sql)"," #endif","                  db_ctx->db,","                  (const char *)StringValuePtr(sql),","-                 (int)RSTRING_LEN(sql),","+                 RSTRING_LENINT(sql),","                  &ctx->st,","                  &tail","              );","@@ -279,7 +279,7 @@ bind_param(VALUE self, VALUE key, VALUE value)","                              ctx->st,","                              index,","                              (const char *)StringValuePtr(value),","-                             (int)RSTRING_LEN(value),","+                             RSTRING_LENINT(value),","                              SQLITE_TRANSIENT","                          );","             } else {","@@ -290,7 +290,7 @@ bind_param(VALUE self, VALUE key, VALUE value)","                                  ctx->st,","                                  index,","                                  (const char *)StringValuePtr(value),","-                                 (int)RSTRING_LEN(value),","+                                 RSTRING_LENINT(value),","                                  SQLITE_TRANSIENT","                              );","                 } else {","@@ -301,7 +301,7 @@ bind_param(VALUE self, VALUE key, VALUE value)","                                  ctx->st,","                                  index,","                                  (const char *)StringValuePtr(value),","-                                 (int)RSTRING_LEN(value),","+                                 RSTRING_LENINT(value),","                                  SQLITE_TRANSIENT","                              );","                 }"],"additions":4,"deletions":4,"truncated":false},{"path":"test/helper.rb","lines":["@@ -127,6 +127,16 @@ def skip_if_timing_unreliable","     def windows?","       ::RUBY_PLATFORM =~ /mingw|mswin/","     end","+","+    # SQLite takes string lengths as int, so it can't be passed a string longer than INT_MAX bytes.","+    # CRuby allocates a string of NUL bytes with calloc, which stays cheap until it's read.","+    def string_longer_than_int_max(encoding = Encoding::UTF_8)","+      skip(\"a string can't be longer than INT_MAX bytes on this platform\") if [0].pack(\"l!\").bytesize < 8","+      skip(\"only CRuby allocates this string cheaply\") if RUBY_ENGINE != \"ruby\"","+      skip(\"valgrind's calloc writes every byte\") if i_am_running_in_valgrind","+      skip(\"suspected of crashing FreeBSD CI, see #762\") if RUBY_PLATFORM.include?(\"freebsd\")","+      (\"\\0\" * (2**31)).force_encoding(encoding)","+    end","   end"," end"," "],"additions":10,"deletions":0,"truncated":false},{"path":"test/test_database.rb","lines":["@@ -585,6 +585,22 @@ def test_function_return_types","       end","     end"," ","+    def test_function_raises_on_returned_text_longer_than_int_max","+      text = string_longer_than_int_max","+      @db.define_function(\"huge\") { |a| text }","+","+      assert_raise(RangeError) { @db.execute(\"select huge(1)\") }","+      assert_equal([[2]], @db.execute(\"select 1 + 1\"))","+    end","+","+    def test_function_raises_on_returned_blob_longer_than_int_max","+      blob = string_longer_than_int_max(Encoding::BINARY)","+      @db.define_function(\"huge\") { |a| blob }","+","+      assert_raise(RangeError) { @db.execute(\"select huge(1)\") }","+      assert_equal([[2]], @db.execute(\"select 1 + 1\"))","+    end","+","     def test_function_raise_propagates_and_connection_remains_usable","       @db.define_function(\"boom\") { |a| raise \"boom: #{a}\" }"," "],"additions":16,"deletions":0,"truncated":false},{"path":"test/test_integration_aggregate.rb","lines":["@@ -218,6 +218,18 @@ def test_create_aggregate_raises_on_returned_unsupported_type","     GC.start","   end"," ","+  def test_create_aggregate_raises_on_returned_text_longer_than_int_max","+    text = string_longer_than_int_max","+    @db.create_aggregate(\"huge\", 1) do","+      step { |ctx, a| }","+      finalize { |ctx| ctx.result = text }","+    end","+","+    assert_raise(RangeError) { @db.get_first_value(\"select huge(a) from foo\") }","+    assert_equal(2, @db.get_first_value(\"select 1 + 1\"))","+    GC.start","+  end","+","   def test_create_aggregate_with_no_data","     @db.create_aggregate(\"accumulate\", 1) do","       step do |ctx, a|"],"additions":12,"deletions":0,"truncated":false},{"path":"test/test_statement.rb","lines":["@@ -223,6 +223,32 @@ def test_bind_blob","       end","     end"," ","+    def test_prepare_raises_on_sql_longer_than_int_max","+      sql = string_longer_than_int_max","+      assert_raises(RangeError) { SQLite3::Statement.new(@db, sql) }","+    end","+","+    def test_bind_param_raises_on_text_longer_than_int_max","+      text = string_longer_than_int_max","+      stmt = SQLite3::Statement.new(@db, \"select ?\")","+      assert_raises(RangeError) { stmt.bind_param(1, text) }","+      stmt.close","+    end","+","+    def test_bind_param_raises_on_utf16_text_longer_than_int_max","+      text = string_longer_than_int_max(Encoding::UTF_16LE)","+      stmt = SQLite3::Statement.new(@db, \"select ?\")","+      assert_raises(RangeError) { stmt.bind_param(1, text) }","+      stmt.close","+    end","+","+    def test_bind_param_raises_on_blob_longer_than_int_max","+      blob = string_longer_than_int_max(Encoding::BINARY)","+      stmt = SQLite3::Statement.new(@db, \"select ?\")","+      assert_raises(RangeError) { stmt.bind_param(1, blob) }","+      stmt.close","+    end","+","     def test_decltype_is_utf8","       @db.execute %(create table foo(a integer, b \"VARCHÄR(255)\"))","       @db.prepare(\"select a, b from foo\") do |stmt|",""],"additions":26,"deletions":0,"truncated":false}],"additions":71,"deletions":6,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-14T15:12:37.744417+00:00"}