e-execution capability is gated on a separate, auditable permission.","+var codeExecutingExtensions = map[string]bool{","+\tapi.BuiltinLuaExtension:  true,","+\tapi.BuiltinWasmExtension: true,","+}","+","+// HasCodeExecutingExtension reports whether any extension in the slice is a","+// code-executing type (builtin/lua or builtin/wasm).","+func (es EnvoyExtensions) HasCodeExecutingExtension() bool {","+\tfor _, e := range es {","+\t\tif codeExecutingExtensions[e.Name] {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// envoyEscapeHatchKeys is the set of Proxy.Config map keys that embed","+// arbitrary Envoy JSON into the sidecar's bootstrap configuration or xDS","+// listener/cluster resources. Any of these keys can introduce code-executing","+// HTTP filters and therefore require mesh:write in addition to service:write.","+//","+// It is unexported and accessed only through IsEnvoyEscapeHatchKey,","+// HasEnvoyEscapeHatchKey, and EnvoyEscapeHatchKeyNames so that no importing","+// package (or test) can mutate the set at runtime and silently weaken the","+// security gate.","+//","+// Bootstrap-time keys (command/connect/envoy/bootstrap_config.go):","+//","+//\tenvoy_bootstrap_json_tpl, envoy_extra_static_listeners_json,","+//\tenvoy_extra_static_clusters_json, envoy_extra_stats_sinks_json,","+//\tenvoy_stats_config_json, envoy_tracing_json","+//","+// xDS runtime keys (agent/xds/config/config.go):","+//","+//\tenvoy_public_listener_json, envoy_listener_tracing_json,","+//\tenvoy_local_cluster_json","+//","+// Per-upstream keys (agent/structs/config_entry.go UpstreamConfig):","+//","+//\tenvoy_listener_json, envoy_cluster_json","+var envoyEscapeHatchKeys = map[string]bool{","+\t\"envoy_bootstrap_json_tpl\":          true,","+\t\"envoy_extra_static_listeners_json\": true,","+\t\"envoy_public_listener_json\":        true,","+\t\"envoy_listener_json\":               true,","+\t\"envoy_cluster_json\":                true,","+\t\"envoy_local_cluster_json\":          true,","+\t\"envoy_extra_static_clusters_json\":  true,","+\t\"envoy_extra_stats_sinks_json\":      true,","+\t\"envoy_tracing_json\":                true,","+\t\"envoy_stats_config_json\":           true,","+\t\"envoy_listener_tracing_json\":       true,","+}","+","+// IsEnvoyEscapeHatchKey reports whether the given config map key is an Envoy","+// escape-hatch key. Comparison is case-insensitive: the mapstructure decoders","+// that ultimately consume these maps (command/connect/envoy/bootstrap_config.go,","+// agent/xds/config/config.go) match struct tags against map keys","+// case-insensitively by default, so an exact-case comparison here could be","+// bypassed by a caller-supplied key that only differs in case.","+func IsEnvoyEscapeHatchKey(key string) bool {","+\treturn envoyEscapeHatchKeys[strings.ToLower(key)]","+}","+","+// EnvoyEscapeHatchKeyNames returns a copy of the Envoy escape-hatch key names.","+// A fresh slice is returned on each call so callers cannot mutate the","+// underlying set.","+func EnvoyEscapeHatchKeyNames() []string {","+\tnames := make([]string, 0, len(envoyEscapeHatchKeys))","+\tfor key := range envoyEscapeHatchKeys {","+\t\tnames = append(names, key)","+\t}","+\treturn names","+}","+","+// HasEnvoyEscapeHatchKey reports whether the given opaque config map (e.g. a","+// ConnectProxyConfig.Config or Upstream.Config value) sets any Envoy","+// escape-hatch key.","+func HasEnvoyEscapeHatchKey(cfg map[string]interface{}) bool {","+\tfor key := range cfg {","+\t\tif IsEnvoyEscapeHatchKey(key) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+"," func (es EnvoyExtensions) ToAPI() []api.EnvoyExtension {"," \textensions := make([]api.EnvoyExtension, len(es))"," \tfor i, e := range es {",""],"additions":94,"deletions":0,"truncated":false}],"additions":672,"deletions":2,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-09-09T13:48:01.986060+00:00"}