{"id":"645a489cf70cf632d5b080257eab38127cf01c60","axis":"silent","repo":"hashicorp/consul","sha":"645a489cf70cf632d5b080257eab38127cf01c60","parsed":{"files":[{"path":".changelog/23901.txt","lines":["@@ -0,0 +1,11 @@","+```release-note:security","+acl: Require mesh:write in addition to service:write when attaching code-executing EnvoyExtensions (builtin/lua, builtin/wasm) or upstream escape-hatch overrides (envoy_listener_json, envoy_cluster_json in UpstreamConfig defaults or overrides) to a service-defaults config entry. Previously a holder of service:write on a service could attach a Lua script or Wasm module, or an upstream escape-hatch override, that Envoy compiled and executed on every proxied request as the sidecar process user, with access to mTLS private keys, request bodies, and the host filesystem.","+```","+","+```release-note:security","+acl: Require mesh:write in addition to service:write when registering a connect-proxy sidecar with bootstrap or xDS escape-hatch keys, whether set in the top-level Proxy.Config map or per-upstream in Proxy.Upstreams[*].Config (envoy_bootstrap_json_tpl, envoy_extra_static_listeners_json, envoy_public_listener_json, envoy_listener_json, envoy_cluster_json, envoy_local_cluster_json, envoy_extra_static_clusters_json, envoy_extra_stats_sinks_json, envoy_tracing_json, envoy_stats_config_json, envoy_listener_tracing_json). Key matching is case-insensitive to match the mapstructure decoding used downstream. Previously a holder of service:write on the proxy and its destination could inject arbitrary Envoy filter chain configuration into the sidecar bootstrap or xDS resources, including via a per-upstream override or a mixed-case key.","+```","+","+```release-note:breaking-change","+acl: Tokens that hold service:write but not mesh:write will now receive a permission-denied error when attempting to attach builtin/lua or builtin/wasm EnvoyExtensions (or upstream envoy_listener_json/envoy_cluster_json escape-hatch overrides) to a service-defaults config entry, or when registering a connect-proxy sidecar with bootstrap or xDS escape-hatch keys set in the top-level Proxy.Config map or per-upstream in Proxy.Upstreams[*].Config. Operators must grant mesh:write to any token that legitimately needs these capabilities.","+```"],"additions":11,"deletions":0,"truncated":false},{"path":"agent/acl.go","lines":["@@ -68,6 +68,16 @@ func (a *Agent) vetServiceRegisterWithAuthorizer(authz acl.Authorizer, service *"," \t\t}"," \t}"," ","+\t// Escape-hatch keys in Proxy.Config or Proxy.Upstreams[*].Config embed","+\t// arbitrary Envoy JSON into the sidecar's bootstrap configuration or xDS","+\t// listener/cluster resources. They can introduce code-executing HTTP","+\t// filters and therefore require mesh:write independently of service:write.","+\tif service.Proxy.HasEnvoyEscapeHatchOverride() {","+\t\tif err := authz.ToAllowAuthorizer().MeshWriteAllowed(&authzContext); err != nil {","+\t\t\treturn fmt.Errorf(\"mesh:write required to set an Envoy escape-hatch key in Proxy.Config or Proxy.Upstreams[*].Config: %w\", err)","+\t\t}","+\t}","+"," \treturn nil"," }"," "],"additions":10,"deletions":0,"truncated":false},{"path":"agent/acl_test.go","lines":["@@ -295,6 +295,167 @@ func TestACL_vetServiceRegister(t *testing.T) {"," \trequire.True(t, acl.IsErrPermissionDenied(err))"," }"," ","+// TestACL_vetServiceRegister_bootstrapEscapeHatch verifies that registering a","+// connect-proxy sidecar with any bootstrap escape-hatch key in Proxy.Config","+// requires mesh:write in addition to service:write (SECVULN — Vector 2).","+func TestACL_vetServiceRegister_bootstrapEscapeHatch(t *testing.T) {","+\tt.Parallel()","+\ta := NewTestACLAgent(t, t.Name(), TestACLConfig(), catalogPolicy, catalogIdent)","+","+\tnewAuthz := func(t *testing.T, rules string) acl.Authorizer {","+\t\tt.Helper()","+\t\tpolicy, err := acl.NewPolicyFromSource(rules, nil, nil)","+\t\trequire.NoError(t, err)","+\t\tauthz, err := acl.NewPolicyAuthorizerWithDefaults(acl.DenyAll(), []*acl.Policy{policy}, nil)","+\t\trequire.NoError(t, err)","+\t\treturn authz","+\t}","+","+\tsidecar := &structs.NodeService{","+\t\tID:      \"web-sidecar-proxy\",","+\t\tService: \"web-sidecar-proxy\",","+\t\tKind:    structs.ServiceKindConnectProxy,","+\t\tProxy: structs.ConnectProxyConfig{","+\t\t\tDestinationServiceName: \"web\",","+\t\t\tConfig: map[string]interface{}{","+\t\t\t\t\"envoy_extra_static_listeners_json\": `{\"name\":\"attacker-listener\"}`,","+\t\t\t},","+\t\t},","+\t}","+","+\t// service:write on both names but no mesh:write — must be denied.","+\tauthzServiceOnly := newAuthz(t, `service_prefix \"\" { policy = \"write\" }`)","+\terr := a.vetServiceRegisterWithAuthorizer(authzServiceOnly, sidecar)","+\trequire.Error(t, err)","+\trequire.True(t, acl.IsErrPermissionDenied(err), \"expected permission denied, got: %v\", err)","+","+\t// service:write + mesh:write — must be allowed.","+\tauthzWithMesh := newAuthz(t, `service_prefix \"\" { policy = \"write\" } mesh = \"write\"`)","+\terr = a.vetServiceRegisterWithAuthorizer(authzWithMesh, sidecar)","+\trequire.NoError(t, err)","+","+\t// Proxy.Config with no escape-hatch keys — service:write alone is sufficient.","+\tnormalSidecar := &structs.NodeService{","+\t\tID:      \"web-sidecar-proxy\",","+\t\tService: \"web-sidecar-proxy\",","+\t\tKind:    structs.ServiceKindConnectProxy,","+\t\tProxy: structs.ConnectProxyConfig{","+\t\t\tDestinationServiceName: \"web\",","+\t\t\tConfig: map[string]interface{}{","+\t\t\t\t\"protocol\": \"http\",","+\t\t\t},","+\t\t},","+\t}","+\terr = a.vetServiceRegisterWithAuthorizer(authzServiceOnly, normalSidecar)","+\trequire.NoError(t, err)","+","+\t// Verify every escape-hatch key triggers the mesh:write requirement.","+\tfor _, key := range structs.EnvoyEscapeHatchKeyNames() {","+\t\tt.Run(key, func(t *testing.T) {","+\t\t\tsvc := &structs.NodeService{","+\t\t\t\tID:      \"web-sidecar-proxy\",","+\t\t\t\tService: \"web-sidecar-proxy\",","+\t\t\t\tKind:    structs.ServiceKindConnectProxy,","+\t\t\t\tProxy: structs.ConnectProxyConfig{","+\t\t\t\t\tDestinationServiceName: \"web\",","+\t\t\t\t\tConfig:                 map[string]interface{}{key: `{}`},","+\t\t\t\t},","+\t\t\t}","+\t\t\terr := a.vetServiceRegisterWithAuthorizer(authzServiceOnly, svc)","+\t\t\trequire.Error(t, err, \"key %q: expected denial without mesh:write\", key)","+\t\t\trequire.True(t, acl.IsErrPermissionDenied(err), \"key %q: expected permission denied, got: %v\", key, err)","+","+\t\t\terr = a.vetServiceRegisterWithAuthorizer(authzWithMesh, svc)","+\t\t\trequire.NoError(t, err, \"key %q: expected success with mesh:write\", key)","+\t\t})","+\t}","+}","+","+// TestACL_vetServiceRegister_bootstrapEscapeHatch_Upstream verifies that","+// escape-hatch keys (envoy_listener_json, envoy_cluster_json) set on a","+// per-upstream Config map — not just the top-level Proxy.Config — also","+// require mesh:write. These keys are only ever consumed from","+// Proxy.Upstreams[*].Config (see agent/xds/listeners.go), so a check that","+// only inspects Proxy.Config would miss them entirely (SECVULN — Vector 2).","+func TestACL_vetServiceRegister_bootstrapEscapeHatch_Upstream(t *testing.T) {","+\tt.Parallel()","+\ta := NewTestACLAgent(t, t.Name(), TestACLConfig(), catalogPolicy, catalogIdent)","+","+\tnewAuthz := func(t *testing.T, rules string) acl.Authorizer {","+\t\tt.Helper()","+\t\tpolicy, err := acl.NewPolicyFromSource(rules, nil, nil)","+\t\trequire.NoError(t, err)","+\t\tauthz, err := acl.NewPolicyAuthorizerWithDefaults(acl.DenyAll(), []*acl.Policy{policy}, nil)","+\t\trequire.NoError(t, err)","+\t\treturn authz","+\t}","+","+\tauthzServiceOnly := newAuthz(t, `service_prefix \"\" { policy = \"write\" }`)","+\tauthzWithMesh := newAuthz(t, `service_prefix \"\" { policy = \"write\" } mesh = \"write\"`)","+","+\tfor _, key := range []string{\"envoy_listener_json\", \"envoy_cluster_json\"} {","+\t\tkey := key","+\t\tt.Run(key, func(t *testing.T) {","+\t\t\tsvc := &structs.NodeService{","+\t\t\t\tID:      \"web-sidecar-proxy\",","+\t\t\t\tService: \"web-sidecar-proxy\",","+\t\t\t\tKind:    structs.ServiceKindConnectProxy,","+\t\t\t\tProxy: structs.ConnectProxyConfig{","+\t\t\t\t\tDestinationServiceName: \"web\",","+\t\t\t\t\tUpstreams: structs.Upstreams{","+\t\t\t\t\t\t{","+\t\t\t\t\t\t\tDestinationName: \"db\",","+\t\t\t\t\t\t\tConfig:          map[string]interface{}{key: `{\"name\":\"attacker-listener\"}`},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t}","+\t\t\terr := a.vetServiceRegisterWithAuthorizer(authzServiceOnly, svc)","+\t\t\trequire.Error(t, err, \"upstream key %q: expected denial without mesh:write\", key)","+\t\t\trequire.True(t, acl.IsErrPermissionDenied(err), \"upstream key %q: expected permission denied, got: %v\", key, err)","+","+\t\t\terr = a.vetServiceRegisterWithAuthorizer(authzWithMesh, svc)","+\t\t\trequire.NoError(t, err, \"upstream key %q: expected success with mesh:write\", key)","+\t\t})","+\t}","+}","+","+// TestACL_vetServiceRegister_bootstrapEscapeHatch_CaseInsensitive verifies","+// that escape-hatch key matching is case-insensitive, matching the","+// case-insensitive mapstructure decoding used downstream by the bootstrap","+// and xDS config decoders. A mixed-case key must not bypass the mesh:write","+// requirement.","+func TestACL_vetServiceRegister_bootstrapEscapeHatch_CaseInsensitive(t *testing.T) {","+\tt.Parallel()","+\ta := NewTestACLAgent(t, t.Name(), TestACLConfig(), catalogPolicy, catalogIdent)","+","+\tnewAuthz := func(t *testing.T, rules string) acl.Authorizer {","+\t\tt.Helper()","+\t\tpolicy, err := acl.NewPolicyFromSource(rules, nil, nil)","+\t\trequire.NoError(t, err)","+\t\tauthz, err := acl.NewPolicyAuthorizerWithDefaults(acl.DenyAll(), []*acl.Policy{policy}, nil)","+\t\trequire.NoError(t, err)","+\t\treturn authz","+\t}","+","+\tauthzServiceOnly := newAuthz(t, `service_prefix \"\" { policy = \"write\" }`)","+","+\tsvc := &structs.NodeService{","+\t\tID:      \"web-sidecar-proxy\",","+\t\tService: \"web-sidecar-proxy\",","+\t\tKind:    structs.ServiceKindConnectProxy,","+\t\tProxy: structs.ConnectProxyConfig{","+\t\t\tDestinationServiceName: \"web\",","+\t\t\tConfig: map[string]interface{}{","+\t\t\t\t\"Envoy_Extra_Static_Listeners_JSON\": `{\"name\":\"attacker-listener\"}`,","+\t\t\t},","+\t\t},","+\t}","+\terr := a.vetServiceRegisterWithAuthorizer(authzServiceOnly, svc)","+\trequire.Error(t, err, \"expected denial for mixed-case escape-hatch key without mesh:write\")","+\trequire.True(t, acl.IsErrPermissionDenied(err), \"expected permission denied, got: %v\", err)","+}","+"," func TestACL_vetServiceUpdateWithAuthorizer(t *testing.T) {"," \tt.Parallel()"," \ta := NewTestACLAgent(t, t.Name(), TestACLConfig(), catalogPolicy, catalogIdent)"],"additions":161,"deletions":0,"truncated":false},{"path":"agent/consul/catalog_endpoint.go","lines":["@@ -288,6 +288,16 @@ func serviceACLCheckWithConsulExemption("," \t\t}"," \t}"," ","+\t// Escape-hatch keys in Proxy.Config or Proxy.Upstreams[*].Config embed","+\t// arbitrary Envoy JSON into the sidecar's bootstrap configuration or xDS","+\t// listener/cluster resources. They can introduce code-executing HTTP","+\t// filters and therefore require mesh:write independently of service:write.","+\tif service.Proxy.HasEnvoyEscapeHatchOverride() {","+\t\tif err := authz.ToAllowAuthorizer().MeshWriteAllowed(&authzContext); err != nil {","+\t\t\treturn fmt.Errorf(\"mesh:write required to set an Envoy escape-hatch key in Proxy.Config or Proxy.Upstreams[*].Config: %w\", err)","+\t\t}","+\t}","+"," \treturn nil"," }"," "],"additions":10,"deletions":0,"truncated":false},{"path":"agent/consul/catalog_endpoint_test.go","lines":["@@ -479,7 +479,160 @@ func TestCatalog_Register_ConnectProxy_invalid(t *testing.T) {"," \tassert.Contains(t, err.Error(), \"DestinationServiceName\")"," }"," ","-// Test that write is required for the proxy destination to register a proxy.","+// TestCatalog_Register_ConnectProxy_EscapeHatchKeyRequiresMeshWrite verifies","+// that registering a connect-proxy via Catalog.Register with any escape-hatch","+// key in Proxy.Config requires mesh:write in addition to service:write","+// (SECVULN — Vector 2, catalog path).","+func TestCatalog_Register_ConnectProxy_EscapeHatchKeyRequiresMeshWrite(t *testing.T) {","+\tif testing.Short() {","+\t\tt.Skip(\"too slow for testing.Short\")","+\t}","+\tt.Parallel()","+","+\tdir1, s1 := testServerWithConfig(t, func(c *Config) {","+\t\tc.PrimaryDatacenter = \"dc1\"","+\t\tc.ACLsEnabled = true","+\t\tc.ACLInitialManagementToken = \"root\"","+\t\tc.ACLResolverSettings.ACLDefaultPolicy = \"deny\"","+\t})","+\tdefer os.RemoveAll(dir1)","+\tdefer s1.Shutdown()","+\ttestrpc.WaitForTestAgent(t, s1.RPC, \"dc1\", testrpc.WithToken(\"root\"))","+\tcodec := rpcClient(t, s1)","+\tdefer codec.Close()","+","+\t// Token with service:write on both names but no mesh:write.","+\tserviceOnlyToken := createTokenWithPolicyNameFull(t, codec, \"escape-hatch-service-only\", `","+service_prefix \"\" { policy = \"write\" }","+node_prefix \"\" { policy = \"write\" }","+`, \"root\").SecretID","+","+\t// Token with service:write + mesh:write.","+\tmeshToken := createTokenWithPolicyNameFull(t, codec, \"escape-hatch-mesh-write\", `","+service_prefix \"\" { policy = \"write\" }","+node_prefix \"\" { policy = \"write\" }","+mesh = \"write\"","+`, \"root\").SecretID","+","+\tfor _, key := range structs.EnvoyEscapeHatchKeyNames() {","+\t\tkey := key","+\t\tt.Run(key, func(t *testing.T) {","+\t\t\targ := structs.RegisterRequest{","+\t\t\t\tDatacenter: \"dc1\",","+\t\t\t\tNode:       \"foo\",","+\t\t\t\tAddress:    \"127.0.0.1\",","+\t\t\t\tService: &structs.NodeService{","+\t\t\t\t\tID:      \"web-sidecar-proxy\",","+\t\t\t\t\tService: \"web-sidecar-proxy\",","+\t\t\t\t\tKind:    structs.ServiceKindConnectProxy,","+\t\t\t\t\tPort:    20000,","+\t\t\t\t\tProxy: structs.ConnectProxyConfig{","+\t\t\t\t\t\tDestinationServiceName: \"web\",","+\t\t\t\t\t\tConfig:                 map[string]interface{}{key: `{}`},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t}","+","+\t\t\tvar out struct{}","+","+\t\t\t// service:write only — must be denied.","+\t\t\targ.Token = serviceOnlyToken","+\t\t\terr := msgpackrpc.CallWithCodec(codec, \"Catalog.Register\", &arg, &out)","+\t\t\trequire.Error(t, err, \"key %q: expected denial without mesh:write\", key)","+\t\t\trequire.True(t, acl.IsErrPermissionDenied(err), \"key %q: expected permission denied, got: %v\", key, err)","+","+\t\t\t// service:write + mesh:write — ACL check must pass. The registration","+\t\t\t// may still fail with a virtual-IP error in environments where no","+\t\t\t// agent HTTP listener is running (pre-existing limitation of","+\t\t\t// testServerWithConfig); that is not caused by our ACL gate.","+\t\t\targ.Token = meshToken","+\t\t\terr = msgpackrpc.CallWithCodec(codec, \"Catalog.Register\", &arg, &out)","+\t\t\tif err != nil {","+\t\t\t\trequire.False(t, acl.IsErrPermissionDenied(err),","+\t\t\t\t\t\"key %q: mesh:write token must not be ACL-denied, got: %v\", key, err)","+\t\t\t}","+\t\t})","+\t}","+}","+","+// TestCatalog_Register_ConnectProxy_UpstreamEscapeHatchKeyRequiresMeshWrite","+// verifies that escape-hatch keys (envoy_listener_json, envoy_cluster_json)","+// set on a per-upstream Config map — not just the top-level Proxy.Config —","+// also require mesh:write via Catalog.Register (SECVULN — Vector 2, catalog","+// path, per-upstream placement).","+func TestCatalog_Register_ConnectProxy_UpstreamEscapeHatchKeyRequiresMeshWrite(t *testing.T) {","+\tif testing.Short() {","+\t\tt.Skip(\"too slow for testing.Short\")","+\t}","+\tt.Parallel()","+","+\tdir1, s1 := testServerWithConfig(t, func(c *Config) {","+\t\tc.PrimaryDatacenter = \"dc1\"","+\t\tc.ACLsEnabled = true","+\t\tc.ACLInitialManagementToken = \"root\"","+\t\tc.ACLResolverSettings.ACLDefaultPolicy = \"deny\"","+\t})","+\tdefer os.RemoveAll(dir1)","+\tdefer s1.Shutdown()","+\ttestrpc.WaitForTestAgent(t, s1.RPC, \"dc1\", testrpc.WithToken(\"root\"))","+\tcodec := rpcClient(t, s1)","+\tdefer codec.Close()","+","+\tserviceOnlyToken := createTokenWithPolicyNameFull(t, codec, \"upstream-escape-hatch-service-only\", `","+service_prefix \"\" { policy = \"write\" }","+node_prefix \"\" { policy = \"write\" }","+`, \"root\").SecretID","+","+\tmeshToken := createTokenWithPolicyNameFull(t, codec, \"upstream-escape-hatch-mesh-write\", `","+service_prefix \"\" { policy = \"write\" }","+node_prefix \"\" { policy = \"write\" }","+mesh = \"write\"","+`, \"root\").SecretID","+","+\tfor _, key := range []string{\"envoy_listener_json\", \"envoy_cluster_json\"} {","+\t\tkey := key","+\t\tt.Run(key, func(t *testing.T) {","+\t\t\targ := structs.RegisterRequest{","+\t\t\t\tDatacenter: \"dc1\",","+\t\t\t\tNode:       \"foo\",","+\t\t\t\tAddress:    \"127.0.0.1\",","+\t\t\t\tService: &structs.NodeService{","+\t\t\t\t\tID:      \"web-sidecar-proxy\",","+\t\t\t\t\tService: \"web-sidecar-proxy\",","+\t\t\t\t\tKind:    structs.ServiceKindConnectProxy,","+\t\t\t\t\tPort:    20000,","+\t\t\t\t\tProxy: structs.ConnectProxyConfig{","+\t\t\t\t\t\tDestinationServiceName: \"web\",","+\t\t\t\t\t\tUpstreams: structs.Upstreams{","+\t\t\t\t\t\t\t{","+\t\t\t\t\t\t\t\tDestinationName: \"db\",","+\t\t\t\t\t\t\t\tLocalBindPort:   9191,","+\t\t\t\t\t\t\t\tConfig:          map[string]interface{}{key: `{}`},","+\t\t\t\t\t\t\t},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t}","+","+\t\t\tvar out struct{}","+","+\t\t\t// service:write only — must be denied.","+\t\t\targ.Token = serviceOnlyToken","+\t\t\terr := msgpackrpc.CallWithCodec(codec, \"Catalog.Register\", &arg, &out)","+\t\t\trequire.Error(t, err, \"upstream key %q: expected denial without mesh:write\", key)","+\t\t\trequire.True(t, acl.IsErrPermissionDenied(err), \"upstream key %q: expected permission denied, got: %v\", key, err)","+","+\t\t\t// service:write + mesh:write — ACL check must pass.","+\t\t\targ.Token = meshTo