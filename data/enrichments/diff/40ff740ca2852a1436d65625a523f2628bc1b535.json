g &error_message, string *error_message_ptr,"," \t                        optional_ptr<const Expression> cast_source = nullptr,","-\t                        optional_idx error_location = optional_idx());","+\t                        QueryLocation error_location = QueryLocation());"," };"," "," //===--------------------------------------------------------------------===//"],"additions":2,"deletions":1,"truncated":false},{"path":"src/include/duckdb/common/query_location.hpp","lines":["@@ -0,0 +1,96 @@","+//===----------------------------------------------------------------------===//","+//                         DuckDB","+//","+// duckdb/common/query_location.hpp","+//","+//","+//===----------------------------------------------------------------------===//","+","+#pragma once","+","+#include \"duckdb/common/optional_idx.hpp\"","+","+namespace duckdb {","+","+//! A QueryLocation references a contiguous region [offset, offset + length) of the source query text.","+//! An invalid QueryLocation (offset == INVALID_OFFSET) marks \"no known location\" - e.g. for expressions","+//! that are synthesized during binding/optimization and have no corresponding source text.","+struct QueryLocation {","+\tstatic constexpr uint32_t INVALID_OFFSET = uint32_t(-1);","+","+\t//! Start byte of the region (INVALID_OFFSET when the location is unknown)","+\tuint32_t offset = INVALID_OFFSET;","+\t//! Length of the region in bytes (0 for a point / unknown extent)","+\tuint32_t length = 0;","+","+\tQueryLocation() = default;","+\t//! Construct from (offset, length). If either value does not fit in a uint32_t the QueryLocation is left invalid.","+\tQueryLocation(idx_t offset_p, idx_t length_p) {","+\t\tif (offset_p < INVALID_OFFSET && length_p < INVALID_OFFSET) {","+\t\t\toffset = static_cast<uint32_t>(offset_p);","+\t\t\tlength = static_cast<uint32_t>(length_p);","+\t\t}","+\t}","+\t//! Bridge from optional_idx (start-only), yielding a zero-length QueryLocation. An invalid or out-of-range idx","+\t//! yields an invalid QueryLocation. Intended mainly for extensions and the few core sites that only have an","+\t//! offset (casts, raw parser byte positions, legacy deserialization); prefer threading a real QueryLocation.","+\tQueryLocation(optional_idx idx) { // NOLINT: allow implicit conversion from optional_idx","+\t\tif (idx.IsValid() && idx.GetIndex() < INVALID_OFFSET) {","+\t\t\toffset = static_cast<uint32_t>(idx.GetIndex());","+\t\t}","+\t}","+","+\tstatic QueryLocation Invalid() {","+\t\treturn QueryLocation();","+\t}","+","+\tbool IsValid() const {","+\t\treturn offset != INVALID_OFFSET;","+\t}","+\tvoid SetInvalid() {","+\t\toffset = INVALID_OFFSET;","+\t\tlength = 0;","+\t}","+","+\t//! Start byte of the region","+\tuint32_t Start() const {","+\t\treturn offset;","+\t}","+\t//! One-past-the-end byte of the region","+\tuint32_t End() const {","+\t\treturn offset + length;","+\t}","+","+\t//! Bridge back to optional_idx (start offset only) for legacy single-position consumers","+\toptional_idx GetOffset() const {","+\t\treturn IsValid() ? optional_idx(offset) : optional_idx();","+\t}","+\t//! Implicit bridge to optional_idx (start offset only). Length is dropped.","+\toperator optional_idx() const { // NOLINT: allow implicit conversion to optional_idx","+\t\treturn GetOffset();","+\t}","+","+\t//! Returns the smallest QueryLocation enclosing both this and other. Invalid locations are ignored.","+\tQueryLocation Merge(const QueryLocation &other) const {","+\t\tif (!IsValid()) {","+\t\t\treturn other;","+\t\t}","+\t\tif (!other.IsValid()) {","+\t\t\treturn *this;","+\t\t}","+\t\tauto new_start = offset < other.offset ? offset : other.offset;","+\t\tauto this_end = End();","+\t\tauto other_end = other.End();","+\t\tauto new_end = this_end > other_end ? this_end : other_end;","+\t\treturn QueryLocation(new_start, new_end - new_start);","+\t}","+","+\tbool operator==(const QueryLocation &rhs) const {","+\t\treturn offset == rhs.offset && length == rhs.length;","+\t}","+\tbool operator!=(const QueryLocation &rhs) const {","+\t\treturn !(*this == rhs);","+\t}","+};","+","+} // namespace duckdb"],"additions":96,"deletions":0,"truncated":false},{"path":"src/include/duckdb/common/types/geometry.hpp","lines":["@@ -11,6 +11,7 @@"," #include \"duckdb/common/common.hpp\""," #include \"duckdb/common/types.hpp\""," #include \"duckdb/common/pair.hpp\"","+#include \"duckdb/common/query_location.hpp\""," #include \"duckdb/storage/storage_info.hpp\""," #include <limits>"," #include <cmath>","@@ -274,7 +275,7 @@ class Geometry {"," "," \t//! Convert from WKT"," \tDUCKDB_API static bool FromString(const string_t &wkt_text, string_t &result, StringHeap &heap, bool strict,","-\t                                  optional_idx query_location);","+\t                                  QueryLocation query_location);"," \tDUCKDB_API static bool FromString(const string_t &wkt_text, string_t &result, Vector &result_vector, bool strict);"," "," \t//! Convert to WKT"],"additions":2,"deletions":1,"truncated":false},{"path":"src/include/duckdb/function/cast/cast_function_set.hpp","lines":["@@ -27,7 +27,7 @@ struct GetCastFunctionInput {"," \t}"," "," \toptional_ptr<ClientContext> context;","-\toptional_idx query_location;","+\tQueryLocation query_location;"," };"," "," struct BindCastFunction {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/include/duckdb/function/cast/default_casts.hpp","lines":["@@ -12,6 +12,7 @@"," #include \"duckdb/common/types/vector.hpp\""," #include \"duckdb/common/helper.hpp\""," #include \"duckdb/common/optional_ptr.hpp\"","+#include \"duckdb/common/query_location.hpp\""," #include \"duckdb/function/scalar_function.hpp\""," "," namespace duckdb {","@@ -82,7 +83,7 @@ struct CastParameters {"," \t//! Local state"," \toptional_ptr<FunctionLocalState> local_state;"," \t//! Query location (if any)","-\toptional_idx query_location;","+\tQueryLocation query_location;"," \t//! In the case of a nested type, when fac