result !== 'boolean') {","-      setAssets(","-        assetsRef.current.map((current) => (current.id === asset.id ? (result as File) : current))","-      );","-    }","+  // Deleting from the library leaves nothing for the field to point at.","+  const handleAssetDelete = (id: number) => {","+    setAssets(assetsRef.current.filter((current) => current.id !== id));","   };"," ","   const handleSelect = (selectedAssets: File[]) => {","@@ -425,8 +434,8 @@ export const MediaLibraryInput = ({","           asset={assets[0]}","           disabled={disabled}","           onCopyLink={handleCopyLink}","-          // The details dialog needs the library's folder tree, which needs read access.","-          onEdit={canRead ? setEditedAsset : undefined}","+          // The details drawer fetches the asset from the library, which needs read access.","+          onEdit={canRead ? handleEdit : undefined}","           onRemove={handleRemove}","         />","       );","@@ -440,7 +449,7 @@ export const MediaLibraryInput = ({","             asset={asset}","             disabled={disabled}","             onCopyLink={handleCopyLink}","-            onEdit={canRead ? setEditedAsset : undefined}","+            onEdit={canRead ? handleEdit : undefined}","             onRemove={handleRemove}","           />","         ))}","@@ -457,6 +466,7 @@ export const MediaLibraryInput = ({","         <Field.Label action={labelAction}>{label}</Field.Label>","         <AddAssetMenu","           disabled={disabled}","+          preventOpen={isAnyDrawerOpen}","           onBrowseLibrary={() => setStep('browse')}","           onUploadFromDevice={() => fileInputRef.current?.click()}","           onUploadFromUrl={() => setIsUrlDialogOpen(true)}","@@ -497,17 +507,13 @@ export const MediaLibraryInput = ({","         />","       )}"," ","-      {editedAsset && (","-        <EditAssetDialog","-          open","-          asset={editedAsset as EditableAsset}","-          canUpdate={canUpdate && !disabled}","-          canCopyLink={canCopyLink}","-          canDownload={canDownload}","-          trackedLocation={CONTENT_MANAGER_LOCATION}","-          onClose={handleEditClose}","-        />","-      )}","+      <AssetDetailsDrawer","+        assetId={editedAssetId}","+        onClose={() => setEditedAssetId(null)}","+        onAssetChange={handleAssetChange}","+        onAssetDelete={handleAssetDelete}","+        trackedLocation={CONTENT_MANAGER_LOCATION}","+      />"," ","       <ImportFromUrlDialog","         open={isUrlDialogOpen}"],"additions":44,"deletions":38,"truncated":false},{"path":"packages/core/upload/admin/src/components/MediaLibraryInput/openAssetDetails.ts","lines":["@@ -0,0 +1,48 @@","+import { useId, useLayoutEffect, useSyncExternalStore } from 'react';","+","+/**","+ * The media fields that have their asset details drawer open. An entry's media","+ * fields share no parent this package owns, yet a press on any of them is a","+ * press outside another field's open drawer — which closes it, or asks about its","+ * unsaved edits. Nothing should open over that, from any field.","+ */","+const openFields = new Set<string>();","+const listeners = new Set<() => void>();","+","+const subscribe = (listener: () => void) => {","+  listeners.add(listener);","+","+  return () => {","+    listeners.delete(listener);","+  };","+};","+","+/** Read at event time, so a handler never acts on a stale render. */","+export const isAnyAssetDetailsOpen = () => openFields.size > 0;","+","+/**","+ * Registers this field's drawer while `isOpen`, and returns whether any field —","+ * this one included — has one open.","+ *","+ * A layout effect, not a plain one: the drawer that a press closes must be gone","+ * from the set before that press's click reaches the next field.","+ */","+export const useOpenAssetDetails = (isOpen: boolean) => {","+  const id = useId();","+","+  useLayoutEffect(() => {","+    if (!isOpen) {","+      return;","+    }","+","+    openFields.add(id);","+    listeners.forEach((listener) => listener());","+","+    return () => {","+      openFields.delete(id);","+      listeners.forEach((listener) => listener());","+    };","+  }, [id, isOpen]);","+","+  return useSyncExternalStore(subscribe, isAnyAssetDetailsOpen);","+};"],"additions":48,"deletions":0,"truncated":false},{"path":"packages/core/upload/admin/src/components/MediaLibraryInput/tests/MediaLibraryInput.test.tsx","lines":["@@ -2,7 +2,8 @@ import { useState } from 'react';"," "," import { adminApi, Form } from '@strapi/admin/strapi-admin';"," import { within } from '@testing-library/react';","-import { render, screen, waitFor, fireEvent, act } from '@tests/utils';","+import { render, screen, server, waitFor, fireEvent, act } from '@tests/utils';","+import { http, HttpResponse } from 'msw';"," "," import {","   uploadFileViaXHR,","@@ -45,11 +46,26 @@ jest.mock('../../../hooks/useMediaLibraryPermissions', () => ({","   useMediaLibraryPermissions: () => mockPermissions,"," }));"," ","-/**","- * Editing an asset still opens the legacy details dialog, which pulls in","- * cropperjs, and jsdom cannot parse its stylesheet.","- */","-jest.mock('cropperjs/dist/cropper.css?raw', () => '', { virtual: true });","+const mockTrackUsage = jest.fn();","+","+jest.mock('../../../hooks/useTracking', () => ({","+  ...jest.requireActual('../../../hooks/useTracking'),","+  useTracking: () => ({ trackUsage: mockTrackUsage }),","+}));","+","+// The real crop editor produces the cropped file through a canvas, which jsdom lacks.","+jest.mock('../../../pages/Assets/components/AssetDetails/AssetCropEditor', () => ({","+  AssetCropEditor: ({ onApply }: { onApply: (file: File, focalPoint: object) => void }) => (","+    <button","+      type=\"button\"","+      onClick={() =>","+        onApply(new File(['cropped'], 'cropped.png', { type: 'image/png' }), { x: 50, y: 50 })","+      }","+    >","+      Apply","+    </button>","+  ),","+}));"," "," jest.mock('../../../pages/Assets/hooks/useInfiniteScrollSentinel', () => {","   const { useRef } = jest.requireActual('react');","@@ -332,11 +348,13 @@ describe('<MediaLibraryInput /> (Content Manager)', () => {","     });"," ","     it('opens the asset details when editing the asset', async () => {","+      server.use(http.get('/upload/files/:id', () => HttpResponse.json(asset(1, 'one.png'))));","       const { user } = renderInput({}, { cover: asset(1, 'one.png') });"," ","       await user.click(screen.getByRole('button', { name: 'Edit one.png' }));"," ","-      expect(await screen.findByRole('dialog')).toBeInTheDocument();","+      const drawer = await screen.findByRole('dialog', { name: 'File details' });","+      expect(await within(drawer).findByRole('heading', { name: 'one.png' })).toBeInTheDocument();","     });"," ","     it('does not allow editing or removing the asset when the field is disabled', () => {","@@ -918,4 +936,390 @@ describe('<MediaLibraryInput /> (Content Manager)', () => {"," ","     expect(dataTransfer.dropEffect).toBe('copy');","   });","+  describe('asset details drawer', () => {","+    const REPLACED_AT = '2026-02-02T00:00:00.000Z';","+    const version = (updatedAt: string) => `v=${new Date(updatedAt).getTime()}`;","+","+    /**","+     * A small in-memory library, so what the drawer writes is what the field,","+     * the drawer and the picker read back.","+     */","+    const serveLibrary = (initial: AssetFile[]) => {","+      const library = new Map(initial.map((file) => [file.id, file]));","+      const replace = (id: number) => {","+        const replaced = { ...library.get(id)!, updatedAt: REPLACED_AT };","+        library.set(id, replaced);","+        return HttpResponse.json(replaced);","+      };","+","+      server.use(","+        http.get('*/upload/files', () =>","+          HttpResponse.json({","+            results: [...library.values()],","+            pagination: { page: 1, pageSize: 20, pageCount: 1, total: library.size },","+          })","+        ),","+        http.get('*/upload/files/:id', ({ params }) =>","+          HttpResponse.json(library.get(Number(params.id)))","+        ),","+        http.post('*/upload/files/:id/replace', ({ params }) => replace(Number(params.id))),","+        http.delete('*/upload/files/:id', ({ params }) => {","+          library.delete(Number(params.id));","+          return HttpResponse.json({ id: Number(params.id) });","+        }),","+        http.get('*/upload/folders', () => HttpResponse.json({ data: [] })),","+        http.get('*/upload/folder-structure', () => HttpResponse.json({ data: [] }))","+      );","+    };","+","+    const withAlt = (file: AssetFile) => ({ ...file, alternativeText: `${file.name} alt` });","+","+    type User = ReturnType<typeof renderInput>['user'];","+","+    const cardMenu = (name: string) =>","+      screen.getByRole('button', { name: `More actions for ${name}` });","+","+    /** A single field's row has an edit button; a multiple field's card has it in its menu. */","+    const openDrawer = async (user: User, name: string) => {","+      const editButton = screen.queryByRole('button', { name: `Edit ${name}` });","+      if (editButton) {","+        await user.click(editButton);","+      } else {","+        await user.click(cardMenu(name));","+        await user.click(await screen.findByRole('menuitem', { name: 'Edit' }));","+      }","+      const drawer = await screen.findByRole('dialog', { name: 'File details' });","+      await within(drawer).findByRole('heading', { name });","+      return drawer;","+    };","+","+    const replaceInDrawer = async (user: User) => {","+      await user.click(await screen.findByRole('button', { name: 'Replace this file' }));","+      fireEvent.click(await screen.findByRole('button', { name: 'Continue' }));","+      const drawer = screen.getByRole('dialog', { name: 'File details' });","+      // The native file picker can't be driven from jsdom: pick on the hidden input.","+      // eslint-disable-next-line testing-library/no-node-access","+      const fileInput = drawer.querySelector('input[type=\"file\"]') as HTMLInputElement;","+      fireEvent.change(fileInput, {","+        target: { files: [new File(['new'], 'one.png', { type: 'image/png' })] },","+      });","+      await screen.findByText('File replaced.');","+    };","+","+    // jsdom runs no slide-out, so the closed drawer leaves the DOM at once.","+    const closeDrawer = async (user: User) => {","+      await user.keyboard('{Escape}');","+      await waitFor(() =>","+        expect(screen.queryByRole('dialog', { name: 'File details' })).not.toBeInTheDocument()","+      );","+    };","+","+    const rowThumbnail = (name: string) => screen.getAllByAltText(`${name} alt`)[0];","+","+    // The picker showed the pre-replace asset because the replace went through","+    // a cache the picker does not read (PR #28091 review).","+    it('shows a replaced asset on the field and in the picker', async () => {","+      const one = withAlt(asset(1, 'one.png'));","+      serveLibrary([one]);","+      const { user } = renderInput({ attribute: { multiple: true } }, { cover: [one] });","+","+      // Seed the picker's list cache with the pre-replace asset, as browsing would.","+      await user.click(screen.getByRole('button', { name: 'Add asset' }));","+      await user.click(await screen.findByRole('menuitem', { name: 'Browse library' }));","+      let picker = await screen.findByRole('dialog', { name: 'Add asset for Cover' });","+      await within(picker).findAllByAltText('one.png alt');","+      await user.click(within(picker).getByRole('button', { name: 'Cancel' }));","+","+      await openDrawer(user, 'one.png');","+      await replaceInDrawer(user);","+      await closeDrawer(user);","+","+      expect(rowThumbnail('one.png')).toHaveAttribute(","+        'src',","+        expect.stringContaining(version(REPLACED_AT))","+      );","+","+      await user.click(screen.getByRole('button', { name: 'Add asset' }));","+      await user.click(await screen.findByRole('menuitem', { name: 'Browse library' }));","+      picker = await screen.findByRole('dialog', { name: 'Add asset for Cover' });","+","+      await waitFor(() =>","+        expect(within(picker).getAllByAltText('one.png alt')[0]).toHaveAttribute(","+          'src',","+          expect.stringContaining(version(REPLACED_AT))","+        )","+      );","+      fireEvent.mouseDown(within(picker).getByRole('tab', { name: /Selected assets/ }));","+      await waitFor(() =>","+        within(picker)","+          .getAllByAltText('one.png alt')","+          .forEach((thumbnail) =>","+            expect(thumbnail).toHaveAttribute('src', expect.stringContaining(version(REPLACED_AT)))","+          )","+      );","+    });","+","+    // #26836: the crop reached the server, but the field only took it on","+    // \"Finish\", so closing any other way — here Escape — left the pre-crop asset","+    // on the entry.","+    it('keeps a crop on a single-value field after the drawer closes', async () => {","+      const one = withAlt(asset(1, 'one.png'));","+      serveLibrary([one]);","+      const { user } = renderInput({}, { cover: one });","+","+      await openDrawer(user, 'one.png');","+      await user.click(await screen.findByRole('button', { name: 'Crop' }));","+      await user.click(await screen.findByRole('button', { name: 'Apply' }));","+      await screen.findByText('File updated');","+      await closeDrawer(user);","+","+      expect(rowThumbnail('one.png')).toHaveAttribute(","+        'src',","+        expect.stringContaining(version(REPLACED_AT))","+      );","+    });","+","+    it('takes an asset deleted from the library off the field', async () => {","+      const one = asset(1, 'one.png');","+      serveLibrary([one, asset(2, 'two.png')]);","+      const { user } = renderInput(","+        { attribute: { multiple: true } },","+        { cover: [one, asset(2, 'two.png')] }","+      );","+","+      await openDrawer(user, 'one.png');","+      await user.click(await screen.findByRole('button', { name: 'Delete this file' }));","+      await screen.findByText(/This file cannot be recovered/i);","+      fireEvent.click(screen.getByRole('button', { name: 'Confirm' }));","+","+      await waitFor(() =>","+        expect(","+          screen.queryByRole('button', { name: 'More actions for one.png' })","+        ).not.toBeInTheDocument()","+      );","+      expect(cardMenu('two.png')).toBeInTheDocument();","+    });","+","+    it('empties a single-value field when its asset is deleted from the library', async () => {","+      serveLibrary([asset(1, 'one.png')]);","+      const { user } = renderInput({}, { cover: asset(1, 'one.png') });","+","+      await openDrawer(user, 'one.png');","+      await user.click(await screen.findByRole('button', { name: 'Delete this file' }));","+      await screen.findByText(/This file cannot be recovered/i);","+      fireEvent.click(screen.getByRole('button', { name: 'Confirm' }));","+","+      await waitFor(() =>","+        expect(screen.queryByRole('button', { name: 'Edit one.png' })).not.toBeInTheDocument()","+      );","+      expect(screen.queryByText('one.png')).not.toBeInTheDocument();","+    });","+","+    // Analytics split Media Library and Content Manager usage on `location`.","+    it(\"tags the drawer's events with the Content Manager location\", async () => {","+      serveLibrary([asset(1, 'one.png')]);","+      mockTrackUsage.mockClear();","+      const { user } = renderInput({}, { cover: asset(1, 'one.png') });","+","+      await openDrawer(user, 'one.png');","+      await replaceInDrawer(user);","+","+      expect(mockTrackUsage).toHaveBeenCalledWith('didReplaceMedia', {","+        location: 'content-manager',","+      });","+    });","+","+    // The card's menu is not modal: it opens on the same press that closes the","+    // drawer without edits.","+    it(\"switches to another asset from that asset's card\", async () => {","+      serveLibrary([asset(1, 'one.png'), asset(2, 'two.png')]);","+      const { user } = renderInput(","+        { attribute: { multiple: true } },","+        { cover: [asset(1, 'one.png'), asset(2, 'two.png')] }","+      );","+","+      await openDrawer(user, 'one.png');","+      await user.click(cardMenu('two.png'));","+      await user.click(await screen.findByRole('menuitem', { name: 'Edit' }));","+","+      const drawer = await screen.findByRole('dialog', { name: 'File details' });","+      expect(await within(drawer).findByRole('heading', { name: 'two.png' })).toBeInTheDocument();","+    });","+","+    // The menu press is a press outside the drawer, which asks first; nothing is","+    // left open behind that question.","+    it(\"keeps unsaved edits when another card's menu is pressed\", async () => {","+      serveLibrary([asset(1, 'one.png'), asset(2, 'two.png')]);","+      const { user } = renderInput(","+        { attribute: { multiple: true } },","+        { cover: [asset(1, 'one.png'), asset(2, 'two.png')] }","+      );","+","+      const drawer = await openDrawer(user, 'one.png');","+      const caption = within(drawer).getByRole('textbox', { name: 'Caption' });","+      await waitFor(() => expect(caption).toBeEnabled());","+      await user.type(caption, 'Edited caption');","+","+      await user.click(cardMenu('two.png'));","+","+      expect(await screen.findByRole('alertdialog')).toHaveTextContent(/unsaved changes/i);","+      expect(screen.queryByRole('menu', { hidden: true })).not.toBeInTheDocument();","+      // The confirmation hides the rest of the page from assistive tech.","+      expect(","+        within(drawer).getByRole('heading', { name: 'one.png', hidden: true })","+      ).toBeInTheDocument();","+      expect(caption).toHaveValue('Edited caption');","+    });","+","+    const editCaption = async (user: User, drawer: HTMLElement) => {","+      const caption = within(drawer).getByRole('textbox', { name: 'Caption' });","+      await waitFor(() => expect(caption).toBeEnabled());","+      await user.type(caption, 'Edited caption');","+      return caption;","+    };","+","+    // Same rule as the row buttons, for the field's other ways to add assets.","+    it('keeps the Add asset menu closed over unsaved edits', async () => {","+      serveLibrary([asset(1, 'one.png')]);","+      const { user } = renderInput(","+        { attribute: { multiple: true } },","+        { cover: [asset(1, 'one.png')] }","+      );","+","+      const caption = await editCaption(user, await openDrawer(user, 'one.png'));","+      await user.click(screen.getByRole('button', { name: 'Add asset' }));","+","+      expect(await screen.findByRole('alertdialog')).toHaveTextContent(/unsaved changes/i);","+      expect(screen.queryByRole('menu', { hidden: true })).not.toBeInTheDocument();","+","+      await user.click(screen.getByRole('button', { name: 'Cancel' }));","+","+      await waitFor(() => expect(screen.queryByRole('alertdialog')).not.toBeInTheDocument());","+      expect(screen.queryByRole('menu', { hidden: true })).not.toBeInTheDocument();","+      expect(caption).toHaveValue('Edited caption');","+    });","+","+    it('closes a drawer without edits on the first Add asset press, and opens the menu on the next', async () => {","+      serveLibrary([asset(1, 'one.png')]);","+      const { user } = renderInput(","+        { attribute: { multiple: true } },","+        { cover: [asset(1, 'one.png')] }","+      );","+","+      await openDrawer(user, 'one.png');","+      await user.click(screen.getByRole('button', { name: 'Add asset' }));","+","+      await waitFor(() =>","+        expect(screen.queryByRole('dialog', { name: 'File details' })).not.toBeInTheDocument()","+      );","+      expect(screen.queryByRole('menu', { hidden: true })).not.toBeInTheDocument();","+","+      await user.click(screen.getByRole('button', { name: 'Add asset' }));","+","+      expect(await screen.findByRole('menuitem', { name: 'Browse library' })).toBeInTheDocument();","+    });","+