d ring color","+    // when focused. This is why we don't use inputSurface('within') here.","+    'has-[[data-slot=input-group-control]:focus-visible]:ring-2 has-[[data-slot=input-group-control]:focus-visible]:outline-hidden has-[[data-slot=input-group-control]:focus-visible]:not-has-[[aria-invalid=true]]:border-focus-ring has-[[data-slot=input-group-control]:focus-visible]:not-has-[[aria-invalid=true]]:ring-focus-ring/25',","     'in-data-[admin7-design=true]:has-[[data-slot=input-group-control]:focus-visible]:bg-control-surface',","   ),","   {"],"additions":3,"deletions":2,"truncated":false},{"path":"apps/shade/src/components/ui/input-group.stories.tsx","lines":["@@ -360,7 +360,7 @@ export const ErrorState: Story = {","     docs: {","       description: {","         story:","-          'Error state indicated by aria-invalid attribute. The entire group displays error styling for clear feedback.',","+          'Error state indicated by aria-invalid attribute. The entire group keeps its error border and ring color when the input is focused for correction.',","       },","     },","   },"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/shade/src/docs/tokens.mdx","lines":["@@ -145,6 +145,8 @@ Outline `Button`s use `--control-border`, not `--border-default`. In dark mode i"," "," Text-entry fields, including inputs, textareas and select triggers, take their chrome from the `inputSurface` recipe: `--field-surface`, `--field-border`, `--field-shadow` and `--radius-field`. Their surfaces follow `--control-surface` and have no resting shadow; `--field-shadow` retains its neutral value for compatibility. With `admin7Design` on, their outline uses `--color-gray-400` in light mode and `--color-gray-900` in dark mode. They also have 4px corners and 14px text (`--text-field`). With it off, they use `--control-border` and `--radius-control`. Checkboxes and radios use the recipe but keep a visible edge with `--control-surface` and `--border-strong`."," ","+Invalid input groups keep their destructive border and focus-ring color while the control is focused, so correcting a value does not hide its error state. Pair that color with a text description of the error.","+"," ## Section headings and stats"," "," With `admin7Design` on, the `section-heading` class sets a heading for a section inside a page or card, one step below the page title, at `--text-section-heading`. A page whose headings sit outside cards, like member and tag details, sets it to `--text-section-heading-lg` (21px) on the common parent of both columns so main and sidebar headings match. Section headings use Inter at medium weight, `--tracking-section-heading` (-0.01em) letter spacing, a 1.35 line height, and optical size 28. `stat-label` sets the small label above a stat or a value, and `stat-value` sets a stat's large, light number."],"additions":2,"deletions":0,"truncated":false},{"path":"e2e/tests/admin/two-factor-auth.test.ts","lines":["@@ -29,7 +29,11 @@ test.describe('Two-Factor authentication', () => {","     await loginPage.goto();","   });"," ","-  test('authenticates with 2FA token', async ({ browser, baseURL, ghostAccountOwner }) => {","+  test('automatically authenticates with 2FA token', async ({","+    browser,","+    baseURL,","+    ghostAccountOwner,","+  }) => {","     await withIsolatedPage(browser, { baseURL }, async ({ page: page }) => {","       const { email, password } = ghostAccountOwner;","       const previousCount = (await searchVerificationEmails(email)).length;","@@ -42,14 +46,13 @@ test.describe('Two-Factor authentication', () => {"," ","       const verifyPage = new LoginVerifyPage(page);","       await verifyPage.twoFactorTokenField.fill(code);","-      await verifyPage.twoFactorVerifyButton.click();"," ","       const adminAnalyticsPage = new AnalyticsOverviewPage(page);","       await expect(adminAnalyticsPage.header).toBeVisible();","     });","   });"," ","-  test('authenticates with 2FA token that was resent', async ({","+  te