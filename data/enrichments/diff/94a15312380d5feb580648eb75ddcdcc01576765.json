s a compute capability mismatch, so we only","+  // need to compare SM counts.","+  return target_device->core_count > 0 &&","+         target_device->core_count < runtime_desc.core_count();","+}","+","+}  // namespace","+"," absl::StatusOr<std::unique_ptr<dnn::DnnGraph>> CudnnSupport::DeserializeGraph(","-    Stream& stream, absl::string_view serialized_data) const {","+    Stream& stream, absl::string_view serialized_data,","+    const std::optional<dnn::DnnGraphTargetDevice>& target_device) const {","   // Deserializing a graph runs a warmup execution by default. Use a private","   // stream for the warmup to avoid race conditions.","   ABSL_ASSIGN_OR_RETURN(CudnnHandle cudnn,","                    cudnn_->GetCompilationHandle(stream.parent()));","   cudnn_frontend::graph::Graph graph;","-  RETURN_IF_CUDNN_FRONTEND_ERROR(graph.deserialize(","-      cudnn.handle(),","-      std::vector<uint8_t>(serialized_data.data(),","-                           serialized_data.data() + serialized_data.size())));","+  std::vector<uint8_t> serialized_bytes(serialized_data.begin(),","+                                        serialized_data.end());","+","+  const DeviceDescription& runtime_desc =","+      stream.parent()->GetDeviceDescription();","+  if (ShouldUseTargetDeviceProperties(target_device, runtime_desc)) {","+    LOG(WARNING) << \"Running cuDNN graph compiled for \"","+                 << target_device->core_count << \" SMs on a device with \"","+                 << runtime_desc.core_count() << \" SMs.\";","+    auto device_props = std::make_shared<cudnn_frontend::DeviceProperties>();","+    std::vector<uint8_t> prop_bytes(","+        target_device->serialized_device_properties.begin(),","+        target_device->serialized_device_properties.end());","+    RETURN_IF_CUDNN_FRONTEND_ERROR(device_props->deserialize(prop_bytes));","+    graph.set_device_properties(device_props);","+    // Deserializing with device properties has known bugs (as of cuDNN 9.23,","+    // some properties aren't populated correctly), so this may still fail. We","+    // try anyway, since without the SM count override deserialization would","+    // always fail.","+    RETURN_IF_CUDNN_FRONTEND_ERROR(graph.deserialize(serialized_bytes));","+    // The graph.deserialize with a handle does a warmup, so we also should do","+    // one here.","+    RETURN_IF_CUDNN_FRONTEND_ERROR(graph.warmup(cudnn.handle()));","+    return std::make_unique<CudnnGraph>(std::move(graph));","+  }","+","+  RETURN_IF_CUDNN_FRONTEND_ERROR(","+      graph.deserialize(cudnn.handle(), serialized_bytes));","   return std::make_unique<CudnnGraph>(std::move(graph));"," }"," "],"additions":56,"deletions":5,"truncated":false},{"path":"third_party/xla/xla/stream_executor/cuda/cuda_dnn.h","lines":["@@ -572,7 +572,9 @@ class CudnnSupport : public dnn::DnnSupport {"," ","   // Loads complete graph from its serialized representation.","   absl::StatusOr<std::unique_ptr<dnn::DnnGraph>> DeserializeGraph(","-      Stream& stream, absl::string_view serialized_data) const override;","+      Stream& stream, absl::string_view serialized_data,","+      const std::optional<dnn::DnnGraphTargetDevice>& target_device)","+      const override;","   StreamExecutor* GetParent() const { return parent_; }"," ","  private:"],"additions":3,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/stream_executor/dnn.h","lines":["@@ -1104,6 +1104,13 @@ class VersionInfo {"," "," class DnnSupport;"," ","+// The device a serialized DnnGraph was compiled for.","+struct DnnGraphTargetDevice {","+  int core_count = 0;","+  // Backend-specific serialized device properties.","+  std::string serialized_device_properties;","+};","+"," class DnnGraph {","  public:","   DnnGraph() = default;","@@ -1503,7 +1510,8 @@ class DnnSupport {"],"additions":7,"deletions":0,"truncated":false}],"additions":318,"deletions":90,"truncated":true,"file_count":19},"error":null,"fetched_at":"2026-11-06T17:00:49.910831+00:00"}