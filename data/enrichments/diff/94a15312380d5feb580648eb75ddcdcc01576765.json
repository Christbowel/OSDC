eCache file.","         xla_flags: Additional XLA_FLAGS to set during compilation.","+        gpu_target_config: Optional serialized GpuTargetConfigProto file (mutually exclusive with gpu_targets).","     \"\"\"","+    if bool(gpu_targets) == bool(gpu_target_config):","+        fail(\"Exactly one of gpu_targets or gpu_target_config must be specified.\")","+","+    targets = (","+        [(\"\", gpu_target_config)] if gpu_target_config else [","+            (target, gpu_target_config_map[target])","+            for target in gpu_targets","+        ]","+    )"," ","     res = []","-    for target in gpu_targets:","+    for target, target_config in targets:","         # Run xla_compile to generate the file containing an AotCompilationResult.","-        compiled_binary = name + \"_\" + target","+        compiled_binary = (name + \"_\" + target) if target else name","         cmd = (","             \"$(location \" + xla_compile_tool + \")\" +","             \" --module_file=$(location \" + module + \")\" +","             \" --output_file=$(location \" + compiled_binary + \")\" +","             \" --platform=gpu\" +","-            \" --gpu_target_config=$(location \" + gpu_target_config_map[target] + \")\"","+            \" --gpu_target_config=$(execpath \" + target_config + \")\"","         )","-        srcs = [module, gpu_target_config_map[target]]","+        srcs = [module, target_config]","         flags = []","         if autotune_results:","             srcs.append(autotune_results)","@@ -143,9 +153,9 @@ def xla_aot_compile_gpu(","             \"else exit 1; fi; fi\"","         )","         native.genrule(","-            name = \"gen_\" + name + \"_\" + target,","+            name = \"gen_\" + compiled_binary,","             srcs = srcs,","-            outs = [name + \"_\" + target],","+            outs = [compiled_binary],","             cmd = cmd,","             tags = [\"manual\"] if target in _MIN_CUDA_VERSION else [],","             tools = [xla_compile_tool],"