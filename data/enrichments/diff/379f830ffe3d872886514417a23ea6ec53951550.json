}","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal, Settings otherSettings) {","+        return Settings.builder()","+            .put(super.nodeSettings(nodeOrdinal, otherSettings))","+            .put(QueryLogger.QUERY_LOGGER_ENABLED.getKey(), false)","+            .build();","+    }","+","+    public void testPluginSinkReceivesSearchesWithQueryLoggingDisabled() {","+        var plugin = internalCluster().getInstance(PluginsService.class).filterPlugins(CapturePlugin.class).findFirst().orElseThrow();","+        assertEquals(1, plugin.providerCalls.get());","+        createIndex(\"test\");","+        ensureGreen(\"test\");","+","+        assertResponse(prepareSearch(\"test\"), response -> assertEquals(0, response.getHits().getHits().length));","+        assertThat(plugin.captures, contains(\"dsl:success\"));","+","+        expectThrows(IndexNotFoundException.class, () -> prepareSearch(\"missing-index\").get());","+        assertThat(plugin.captures, contains(\"dsl:success\", \"dsl:failure\"));","+","+        plugin.enabled = false;","+        assertResponse(prepareSearch(\"test\"), response -> assertEquals(0, response.getHits().getHits().length));","+        assertThat(plugin.captures, hasSize(2));","+        assertEquals(1, plugin.providerCalls.get());","+    }","+","+    /** Owns the sink state so its enablement is independent of the built-in query logger. */","+    public static class CapturePlugin extends Plugin {","+        private final List<String> captures = new CopyOnWriteArrayList<>();","+        private final AtomicInteger providerCalls = new AtomicInteger();","+        private volatile boolean enabled = true;","+    }","+","+    /** The plugin constructor also confines this SPI provider to nodes with CapturePlugin installed. */","+    public static class CaptureSinkProvider implements QuerySinkProvider {","+        private final CapturePlugin plugin;","+","+        public CaptureSinkProvider(CapturePlugin plugin) {","+            this.plugin = plugin;","+        }","+","+        @Override","+        public List<QuerySink<QueryCaptureContext>> getQuerySinks() {","+            plugin.providerCalls.incrementAndGet();","+            return List.of(new QuerySink<>(() -> \"proof-of-concept query capture\") {","+                @Override","+                public boolean isEnabled() {","+                    return plugin.enabled;","+                }","+","+                @Override","+                public void accept(QueryCaptureContext context) {","+                    if (context instanceof SearchCaptureContext) {","+                        // Retain only copied metadata, never the borrowed context or response.","+                        plugin.captures.add(context.getType() + (context.isSuccess() ? \":success\" : \":failure\"));","+                    }","+                }","+            });","+        }","+    }","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/resources/META-INF/services/org.elasticsearch.common.logging.activity.QuerySinkProvider","lines":["@@ -0,0 +1 @@","+org.elasticsearch.common.logging.activity.QuerySinkProviderIT$CaptureSinkProvider"],"additions":1,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/action/search/TransportSearchAction.java","lines":["@@ -65,6 +65,7 @@"," import org.elasticsearch.common.logging.activity.ActivityLogWriterProvider;"," import org.elasticsearch.common.logging.activity.QueryInterceptor;"," import org.elasticsearch.common.logging.activity.QueryLogger;","+import org.elasticsearch.common.logging.activity.QuerySinkRegistry;"," import org.elasticsearch.common.regex.Regex;"," import org.elasticsearch.common.settings.Setting;"," import org.elasticsearch.common.settings.Setting.Property;","@@ -221,6 +222,7 @@ public TransportSearchAction(","         SearchResponseMetrics searchResponseMetrics,","         Client client,","         UsageService usageService,","+        Query