.logging.activity;","+","+import java.util.List;","+","+/**","+ * SPI for plugins contributing query sinks. Register implementations in","+ * {@code META-INF/services/org.elasticsearch.common.logging.activity.QuerySinkProvider}.","+ * Providers may have a public no-argument constructor or a public constructor accepting their plugin instance.","+ */","+public interface QuerySinkProvider {","+    /**","+     * Creates sinks once per node. The returned sinks are shared across query types and may be called concurrently.","+     * Plugins own any resources used by their sinks and must release them when the plugin closes.","+     */","+    List<QuerySink<QueryCaptureContext>> getQuerySinks();","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/common/logging/activity/QuerySinkRegistry.java","lines":["@@ -0,0 +1,35 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the \"Elastic License","+ * 2.0\", the \"GNU Affero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+","+package org.elasticsearch.common.logging.activity;","+","+import java.util.ArrayList;","+import java.util.List;","+","+/** Node-scoped plugin sinks, shared by the interceptors for each query type. */","+public final class QuerySinkRegistry {","+    private final List<QuerySink<QueryCaptureContext>> sinks;","+","+    /** Creates the plugin sinks once, before transport actions are constructed. */","+    public QuerySinkRegistry(List<? extends QuerySinkProvider> providers) {","+        var sinks = new ArrayList<QuerySink<QueryCaptureContext>>();","+        for (var provider : providers) {","+            sinks.addAll(provider.getQuerySinks());","+        }","+        this.sinks = List.copyOf(sinks);","+    }","+","+    /** Keeps the built-in query logger alongside the independently enabled plugin sinks. */","+    public <C extends QueryCaptureContext> QueryInterceptor<C> createInterceptor(QuerySink<C> queryLogger) {","+        var allSinks = new ArrayList<QuerySink<? super C>>(sinks.size() + 1);","+        allSinks.add(queryLogger);","+        allSinks.addAll(sinks);","+        return new QueryInterceptor<>(allSinks);","+    }","+}"],"additions":35,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/node/NodeConstruction.java","lines":["@@ -84,6 +84,8 @@"," import org.elasticsearch.common.logging.HeaderWarning;"," import org.elasticsearch.common.logging.activity.ActivityLogWriterProvider;"," import org.elasticsearch.common.logging.activity.Log4jWriter;","+import org.elasticsearch.common.logging.activity.QuerySinkProvider;","+import org.elasticsearch.common.logging.activity.QuerySinkRegistry;"," import org.elasticsearch.common.network.NetworkModule;"," import org.elasticsearch.common.network.NetworkService;"," import org.elasticsearch.common.settings.ClusterSettings;","@@ -1494,6 +1496,8 @@ public <T extends TransportResponse> void sendRequest(","             () -> Log4jWriter.PROVIDER","         );"," ","+        QuerySinkRegistry querySinkRegistry = new QuerySinkRegistry(pluginsService.loadServiceProviders(QuerySinkProvider.class));","+","         ReshardingActionHelper reshardingActionHelper = new ReshardingActionHelper(clusterService, projectResolver, threadPool);"," ","         modules.add(b -> {","@@ -1546,6 +1550,7 @@ public <T extends TransportResponse> void sendRequest(","             b.bind(ProjectRoutingResolver.class).toInstance(projectRoutingResolver);","             b.bind(ActionLoggingFieldsProvider.class).toInstance(loggingFieldsProvider);","             b.bind(ActivityLogWriterProvider.class).toInstance(logWriterProvider);","+  