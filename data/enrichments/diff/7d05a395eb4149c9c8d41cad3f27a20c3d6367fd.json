   policy.matchMode: 'glob'"," ","+"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/operator-manual/rbac.md","lines":["@@ -71,19 +71,19 @@ Syntax: `p, <role/user/group>, <resource>, <action>, <object>, <effect>`"," "," Below is a table that summarizes all possible resources and which actions are valid for each of them."," ","-| Resource\\Action     | get | create | update | delete | sync | action | override | invoke |","-| :------------------ | :-: | :----: | :----: | :----: | :--: | :----: | :------: | :----: |","-| **applications**    | ✅  |   ✅   |   ✅   |   ✅   |  ✅  |   ✅   |    ✅    |   ❌   |","-| **applicationsets** | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **clusters**        | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **projects**        | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **repositories**    | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **accounts**        | ✅  |   ❌   |   ✅   |   ❌   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **certificates**    | ✅  |   ✅   |   ❌   |   ✅   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **gpgkeys**         | ✅  |   ✅   |   ❌   |   ✅   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **logs**            | ✅  |   ❌   |   ❌   |   ❌   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **exec**            | ❌  |   ✅   |   ❌   |   ❌   |  ❌  |   ❌   |    ❌    |   ❌   |","-| **extensions**      | ❌  |   ❌   |   ❌   |   ❌   |  ❌  |   ❌   |    ❌    |   ✅   |","+| Resource\\Action     | get | create | update | delete | sync | rollback | action | override | invoke |","+| :------------------ | :-: | :----: | :----: | :----: | :--: | :------: | :----: | :------: | :----: |","+| **applications**    | ✅  |   ✅   |   ✅   |   ✅   |  ✅  |    ✅    |   ✅   |    ✅    |   ❌   |","+| **applicationsets** | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **clusters**        | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **projects**        | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **repositories**    | ✅  |   ✅   |   ✅   |   ✅   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **accounts**        | ✅  |   ❌   |   ✅   |   ❌   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **certificates**    | ✅  |   ✅   |   ❌   |   ✅   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **gpgkeys**         | ✅  |   ✅   |   ❌   |   ✅   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **logs**            | ✅  |   ❌   |   ❌   |   ❌   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **exec**            | ❌  |   ✅   |   ❌   |   ❌   |  ❌  |    ❌    |   ❌   |    ❌    |   ❌   |","+| **extensions**      | ❌  |   ❌   |   ❌   |   ❌   |  ❌  |    ❌    |   ❌   |    ❌    |   ✅   |"," "," ### Application-Specific Policy"," ","@@ -210,6 +210,43 @@ To allow the user to perform any actions:"," p, example-user, applications, action/*, default/*, allow"," ```"," ","+#### The `rollback` action","+","+The `rollback` action allows rolling back applications to previously synced revisions. This is a restricted operation compared to the `sync` action with the following constraints:","+","+* Can only rollback to revisions in the application's revision history (up to the configured `revisionHistoryLimit`)","+* Cannot rollback when auto-sync is enabled","+* Supports `dryRun` and `prune` options but cannot override other sync options","+* Cannot use partial sync on specific resources","+","+#### Enabling Separate Rollback Permission","+","+The `rollback` action is **opt-in** and disabled by default for backwards compatibility. To enable it, set the following in `argocd-cm`:","+","+```yaml","+server.rbac.rollback.enforce.enable: 'true'","+```","+","+When disabled (the default), rollback operations continue to use the `sync` permission check, so existing RBAC policies continue to work without changes.","+","+> [!NOTE]","+> Once enabled, users who previously relied on `sync` permission to perform rollbacks will need to be explicitly granted the `rollback` permission.","+","+**Examples:**","+","+Allow a developer to rollback applications in the dev project:","+","+```csv","+p, developer, applications, rollback, dev-project/*, allow","+```","+","+Allow a team to rollback specific applications:","+","+```csv","+p, release-team, applications, rollback, prod-project/critical-app, allow","+p, release-team, applications, rollback, prod-project/api-service, allow","+```","+"," #### The `override` action"," "," The `override` action privilege can be used to allow passing arbitrary manifests or different revisions when syncing an `Application`. This can e.g. be used for development or testing purposes."],"additions":50,"deletions":13,"truncated":false},{"path":"docs/user-guide/commands/argocd_account_can-i.md","lines":["@@ -21,7 +21,7 @@ argocd account can-i update projects 'default'"," # Can I create a cluster?"," argocd account can-i create clusters '*'"," ","-Actions: [get create update delete sync override action invoke]","+Actions: [get create update delete sync rollback override action invoke]"," Resources: [clusters projects applications applicationsets repositories write-repositories certificates accounts gpgkeys logs exec extensions]"," "," ```"],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/apis/application/v1alpha1/types.go","lines":["@@ -2710,6 +2710,7 @@ var validActions = map[string]bool{"," \trbac.ActionDelete:   true,"," \trbac.ActionSync:     true,"," \trbac.ActionOverride: true,","+\trbac.ActionRollback: true,"," \t\"*\":                 true,"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"server/account/account.go","lines":["@@ -129,6 +129,19 @@ func (s *Server) CanI(ctx context.Context, r *account.CanIRequest) (*account.Can"," \t\treturn nil, status.Errorf(codes.InvalidArgument, \"%v does not contain %s\", rbac.Resources, r.Resource)"," \t}"," ","+\t// When server.rbac.rollback.enforce.enable is false (the default), rollback falls back","+\t// to the sync permission for backwards compatibility. Mirror that here so can-i","+\t// accurately reflects whether the caller can actually perform a rollback.","+\tif r.Action == rbac.ActionRollback {","+\t\trollbackEnforceEnable, err := s.settingsMgr.GetServerRBACRollbackEnforceEnable()","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tif !rollbackEnforceEnable {","+\t\t\tr.Action = rbac.ActionSync","+\t\t}","+\t}","+"," \tsubresource := r.Subresource"," "," \t// For project-scoped resources, normalize the subresource using security.RBACName"],"additions":13,"deletions":0,"truncated":false},{"path":"server/account/account_test.go","lines":["@@ -352,6 +352,60 @@ func TestCanI_GetLogsDeny(t *testing.T) {"," \tassert.Equal(t, \"no\", resp.Value)"," }"," ","+func TestCanI_RollbackFlagDisabled_ChecksSyncPermission(t *testing.T) {","+\tt.Parallel()","+\tt.Run(\"denied when no sync permission\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tenforcer := func(_ jwt.Claims, _ ...any) bool { return false }","+\t\taccountServer, _ := newTestAccountServerExt(t, t.Context(), enforcer, func(_ *corev1.ConfigMap, _ *corev1.Secret) {","+\t\t\t// flag not set → defaults to false","+\t\t})","+\t\tctx := projTokenContext(t.Context())","+\t\tresp, err := accountServer.CanI(ctx, &account.CanIRequest{Resource: \"applications\", Action: \"rollback\", Subresource: \"*\"})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, \"no\", resp.Value)","+\t})","+","+\tt.Run(\"allowed when sync permission granted\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tenforcer := func(_ jwt.Claims, _ ...any) bool { return true }","+\t\taccountServer, _ := newTestAccountServerExt(t, t.Context(), enforcer, func(_ *corev1.ConfigMap, _ *corev1.Secret) {","+\t\t\t// flag not set → defaults to false","+\t\t})","+\t\tctx := projTokenContext(t.Context())","+\t\tresp, err := accountServer.CanI(ctx, &account.CanIRequest{Resource: \"applications\", Action: \"rollback\", Subresource: \"*\"})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, \"yes\", resp.Value)","+\t})","+}","+","+func TestCanI_RollbackFlagEnabled_EnforcesRBAC(t *testing.T) {","+\tt.Parallel()","+\tt.Run(\"allowed\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tenforcer := func(_ jwt.Claims, _ ...any) bool { return true }","+\t\taccountServer, _ := newTestAccountServerExt(t, t.Context(), enforcer, func(cm *corev1.ConfigMap, _ *corev1.Secret) {","+\t\t\tcm.Data[\"server.rbac.rollback.enforce.enable\"] = \"true\"","+\t\t})","+\t\tctx := projTokenContext(t.Context())","+\t\tresp, err := accountServer.CanI(ctx, &account.CanIRequest{Resource: \"applications\", Action: \"rollback\", Subresource: \"*\"})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, \"yes\", resp.Value)","+\t})","+","+\tt.Run(\"denied\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tenforcer := func(_ jwt.Claims, _ ...any) bool { return false }","+\t\taccountServer, _ := newTestAccountServerExt(t, t.Context(), enforcer, func(cm *corev1.ConfigMap, _ *corev1.Secret) {","+\t\t\tcm.Data[\"server.rbac.rollback.enforce.enable\"] = \"true\"","+\t\t})","+\t\tctx := projTokenContext(t.Context())","+\t\tresp, err := accountServer.CanI(ctx, &account.CanIRequest{Resource: \"applications\", Action: \"rollback\", Subresource: \"*\"})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, \"no\", resp.Value)","+\t})","+}","+"," func TestCanI_RBACPolicyMatchingWithNormalizedSubresource(t *testing.T) {"," \tt.Parallel()"," \ttests := []struct {"],"additions":54,"deletions":0,"truncated":false},{"path":"server/application/application.go","lines":["@@ -2262,7 +2262,15 @@ func (s *Server) resolveSourceRevisions(ctx context.Context, a *v1alpha1.Applica"," }"," "," func (s *Server) Rollback(ctx context.Context, rollbackReq *application.ApplicationRollbackRequest) (*v1alpha1.Application, error) {","-\ta, _, err := s.getApplicationEnforceRBACClient(ctx, rbac.ActionSync, rollbackReq.GetProject(), rollbackReq.GetAppNamespace(), rollbackReq.GetName(), \"\")","+\trollbackEnforceEnable, err := s.settingsMgr.GetServerRBACRollbackEnforceEnable()","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"error getting server.rbac.rollback.enforce.enable config: %w\", err)","+\t}","+\taction := rbac.ActionSync","+\tif rollbackEnforceEnable {","+\t\taction = rbac.ActionRollback","+\t}","+\ta, _, err := s.getApplicationEnforceRBACClient(ctx, action, rollbackReq.GetProject(), rollbackReq.GetAppNamespace(), rollbackReq.GetName(), \"\")"," \tif err != nil {"," \t\treturn nil, err"," \t}"],"additions":9,"deletions":1,"truncated":false},{"path":"server/application/application_test.go","lines":["@@ -5372,3 +5372,247 @@ func TestGetUnstructuredLiveResourceOrAppWithImpersonation(t *testing.T) {"," \trequire.NoError(t, err)"," \tassert.Equal(t, \"system:serviceaccount:\"+test.FakeDestNamespace+\":test-sa\", config.Impersonate.UserName)"," }","+","+func TestRollbackRBACPermissions(t *testing.T) {","+\tnewTestAppWithRollbackHistory := func() *v1alpha1.Application {","+\t\tapp := newTestApp()","+\t\tapp.Spec.Project = \"default\"","+\t\tapp.Status.History = []v1alpha1.RevisionHistory{{","+\t\t\tID:        1,","+\t\t\tRevision:  \"abc\",","+\t\t\tRevisions: []string{\"abc\"},","+\t\t\tSource:    *app.Spec.Source.DeepCopy(),","+\t\t\tSources:   []v1alpha1.ApplicationSource{*app.Spec.Source.DeepCopy()},","+\t\t}}","+\t\treturn app","+\t}","+","+\tsetupServer := func(t *testing.T, testApp *v1alpha1.Application, rollbackEnforce bool) *Server {","+\t\tt.Helper()","+\t\tf := func(enf *rbac.Enforcer) {","+\t\t\t_ = enf.SetBuiltinPolicy(assets.BuiltinPolicyCSV)","+\t\t\tenf.SetDefaultRole(\"role:readonly\")","+\t\t}","+\t\tadditionalConfig := map[string]string{}","+\t\tif rollbackEnforce {","+\t\t\tadditionalConfig[\"server.rbac.rollback.enforce.enable\"] = \"true\"","+\t\t}","+\t\treturn newTestAppServerWithEnforcerConfigure(t, f, additionalConfig, testApp)","+\t}","+","+\tt.Run(\"rollback permission allows rollback when feature flag enabled\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tappServer := setupServer(t, testApp, true)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"user1\"})","+\t\trequire.NoError(t, appServer.enf.SetUserPolicy(\"p, user1, applications, rollback, default/test-app, allow\"))","+","+\t\tupdatedApp, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.NoError(t, err)","+\t\tassert.NotNil(t, updatedApp.Operation)","+\t})","+","+\tt.Run(\"rollback permission denied without sync when feature flag disabled\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tappServer := setupServer(t, testApp, false)","+\t\t// flag=false (default): server checks sync, not rollback","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"user1\"})","+\t\trequire.NoError(t, appServer.enf.SetUserPolicy(\"p, user1, applications, rollback, default/test-app, allow\"))","+","+\t\t_, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"permission denied\")","+\t})","+","+\tt.Run(\"sync permission allows rollback for backwards compatibility\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tappServer := setupServer(t, testApp, false)","+\t\t// flag=false (default): sync permission is sufficient for rollback","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"user1\"})","+\t\trequire.NoError(t, appServer.enf.SetUserPolicy(\"p, user1, applications, sync, default/test-app, allow\"))","+","+\t\tupdatedApp, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.NoError(t, err)","+\t\tassert.NotNil(t, updatedApp.Operation)","+\t})","+","+\tt.Run(\"rollback denied when feature flag enabled and only sync granted\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tappServer := setupServer(t, testApp, true)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"user1\"})","+\t\t// user has sync but NOT rollback — with flag enabled, rollback is required","+\t\trequire.NoError(t, appServer.enf.SetUserPolicy(\"p, user1, applications, sync, default/test-app, allow\"))","+","+\t\t_, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"permission denied\")","+\t})","+","+\tt.Run(\"no rollback or sync permission is denied\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tappServer := setupServer(t, testApp, true)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"user1\"})","+\t\trequire.NoError(t, appServer.enf.SetUserPolicy(\"p, user1, applications, get, default/test-app, allow\"))","+","+\t\t_, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"permission denied\")","+\t})","+}","+","+func TestRollbackRBACPermissions_ProjectScoped(t *testing.T) {","+\tconst projName = \"rollback-proj\"","+","+\tnewTestAppWithRollbackHistory := func() *v1alpha1.Application {","+\t\tapp := newTestApp()","+\t\tapp.Spec.Project = projName","+\t\tapp.Status.History = []v1alpha1.RevisionHistory{{","+\t\t\tID:        1,","+\t\t\tRevision:  \"abc\",","+\t\t\tRevisions: []string{\"abc\"},","+\t\t\tSource:    *app.Spec.Source.DeepCopy(),","+\t\t\tSources:   []v1alpha1.ApplicationSource{*app.Spec.Source.DeepCopy()},","+\t\t}}","+\t\treturn app","+\t}","+","+\tnewProjectWithRole := func(roleName string, policies []string) *v1alpha1.AppProject {","+\t\treturn &v1alpha1.AppProject{","+\t\t\tObjectMeta: metav1.ObjectMeta{Name: projName, Namespace: testNamespace},","+\t\t\tSpec: v1alpha1.AppProjectSpec{","+\t\t\t\tSourceRepos:  []string{\"*\"},","+\t\t\t\tDestinations: []v1alpha1.ApplicationDestination{{Server: \"*\", Namespace: \"*\"}},","+\t\t\t\tRoles: []v1alpha1.ProjectRole{","+\t\t\t\t\t{Name: roleName, Policies: policies},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t}","+","+\tsetupServer := func(t *testing.T, testApp *v1alpha1.Application, proj *v1alpha1.AppProject, rollbackEnforce bool) *Server {","+\t\tt.Helper()","+\t\tf := func(enf *rbac.Enforcer) {","+\t\t\t_ = enf.SetBuiltinPolicy(assets.BuiltinPolicyCSV)","+\t\t\tenf.SetDefaultRole(\"role:readonly\")","+\t\t}","+\t\tadditionalConfig := map[string]string{}","+\t\tif rollbackEnforce {","+\t\t\tadditionalConfig[\"server.rbac.rollback.enforce.enable\"] = \"true\"","+\t\t}","+\t\treturn newTestAppServerWithEnforcerConfigure(t, f, additionalConfig, testApp, proj)","+\t}","+","+\tt.Run(\"project-scoped rollback policy allows rollback when feature flag enabled\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tproj := newProjectWithRole(\"rollback-role\", []string{","+\t\t\t\"p, proj:rollback-proj:rollback-role, applications, rollback, rollback-proj/test-app, allow\",","+\t\t})","+\t\tappServer := setupServer(t, testApp, proj, true)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"proj:rollback-proj:rollback-role\"})","+","+\t\tupdatedApp, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.NoError(t, err)","+\t\tassert.NotNil(t, updatedApp.Operation)","+\t})","+","+\tt.Run(\"project-scoped rollback policy denied without sync when feature flag disabled\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tproj := newProjectWithRole(\"rollback-role\", []string{","+\t\t\t\"p, proj:rollback-proj:rollback-role, applications, rollback, rollback-proj/test-app, allow\",","+\t\t})","+\t\tappServer := setupServer(t, testApp, proj, false)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"proj:rollback-proj:rollback-role\"})","+","+\t\t_, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"permission denied\")","+\t})","+","+\tt.Run(\"project-scoped sync policy allows rollback for backwards compatibility\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tproj := newProjectWithRole(\"sync-role\", []string{","+\t\t\t\"p, proj:rollback-proj:sync-role, applications, sync, rollback-proj/test-app, allow\",","+\t\t})","+\t\tappServer := setupServer(t, testApp, proj, false)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"proj:rollback-proj:sync-role\"})","+","+\t\tupdatedApp, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.NoError(t, err)","+\t\tassert.NotNil(t, updatedApp.Operation)","+\t})","+","+\tt.Run(\"project-scoped rollback denied when feature flag enabled and only sync granted\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tproj := newProjectWithRole(\"sync-role\", []string{","+\t\t\t\"p, proj:rollback-proj:sync-role, applications, sync, rollback-proj/test-app, allow\",","+\t\t})","+\t\tappServer := setupServer(t, testApp, proj, true)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"proj:rollback-proj:sync-role\"})","+","+\t\t_, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"permission denied\")","+\t})","+","+\tt.Run(\"project-scoped no rollback or sync permission is denied\", func(t *testing.T) {","+\t\ttestApp := newTestAppWithRollbackHistory()","+\t\tproj := newProjectWithRole(\"readonly-role\", []string{","+\t\t\t\"p, proj:rollback-proj:readonly-role, applications, get, rollback-proj/test-app, allow\",","+\t\t})","+\t\tappServer := setupServer(t, testApp, proj, true)","+","+\t\t//nolint:staticcheck","+\t\tuserCtx := context.WithValue(t.Context(), \"claims\", &jwt.MapClaims{\"sub\": \"proj:rollback-proj:readonly-role\"})","+","+\t\t_, err := appServer.Rollback(userCtx, &application.ApplicationRollbackRequest{","+\t\t\tName: &testApp.Name,","+\t\t\tId:   new(int64(1)),","+\t\t})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorContains(t, err, \"permission denied\")","+\t})","+}"],"additions":244,"deletions":0,"truncated":false},{"path":"test/e2e/rollback_rbac_test.go","lines":["@@ -0,0 +1,241 @@","+package e2e","+","+import (","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/argoproj/argo-cd/gitops-engine/v3/pkg/diff\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/types\"","+","+\t. \"github.com/argoproj/argo-cd/v3/pkg/apis/application/v1alpha1\"","+\t\"github.com/argoproj/argo-cd/v3/test/e2e/fixture\"","+\taccountFixture \"github.com/argoproj/argo-cd/v3/test/e2e/fixture/account\"","+\t. \"github.com/argoproj/argo-cd/v3/test/e2e/fixture/app\"","+\tprojectFixture \"github.com/argoproj/argo-cd/v3/test/e2e/fixture/project\"","+)","+","+// waitForRBACPermission polls \"argocd account can-i\" until the RBAC policy","+// propagates to the server, ensuring SetPermissions has taken effect before","+// the actual API call. Without this, the informer update race causes flaky failures.","+func waitForRBACPermission(t *testing.T, action, resource, scope string, expectAllow bool) {","+\tt.Helper()","+\ttimeout := 15 * time.Second","+\tdeadline := time.Now().Add(timeout)","+\tfor time.Now().Before(deadline) {","+\t\toutput, _ := fixture.RunCli(\"account\", \"can-i\", action, resource, scope)","+\t\tif expectAllow && strings.Contains(output, \"yes\") {","+\t\t\treturn","+\t\t}","+\t\tif !expectAllow && strings.Contains(output, \"no\") {","+\t\t\treturn","+\t\t}","+\t\ttime.Sleep(500 * time.Millisecond)","+\t}","+\tt.Fatalf(\"RBAC policy for %s/%s/%s (expectAllow=%v) did not propagate within %v\", action, resource, scope, expectAllow, timeout)","+}","+","+func TestRollbackWithExplicitRollbackPermission(t *testing.T) {","+\tappCtx := Given(t)","+","+\tvar appName string","+\tGivenWithSameState(appCtx).","+\t\tPath(\"guestbook\").","+\t\tWhen().","+\t\tCreateApp().","+\t\tSync().","+\t\tThen().","+\t\tExpect(SyncStatusIs(SyncStatusCodeSynced)).","+\t\tAnd(func(app *Application) {","+\t\t\tappName = app.Name","+\t\t\tappWithHistory := app.DeepCopy()","+\t\t\tappWithHistory.Status.History = []RevisionHistory{","+\t\t\t\t{","+\t\t\t\t\tID:         1,","+\t\t\t\t\tRevision:   app.Status.Sync.Revision,","+\t\t\t\t\tDeployedAt: metav1.Time{Time: metav1.Now().UTC().Add(-1 * time.Minute)},","+\t\t\t\t\tSource:     app.Spec.GetSource(),","+\t\t\t\t},","+\t\t\t\t{","+\t\t\t\t\tID:         2,","+\t\t\t\t\tRevision:   \"test-revision-2\",","+\t\t\t\t\tDeployedAt: metav1.Time{Time: metav1.Now().UTC().Add(-2 * time.Minute)},","+\t\t\t\t\tSource:     app.Spec.GetSource(),","+\t\t\t\t},","+\t\t\t}","+\t\t\tpatch, _, err := diff.CreateTwoWayMergePatch(app, appWithHistory, &Application{})","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = fixture.AppClientset.ArgoprojV1alpha1().Applications(fixture.TestNamespace()).Patch(","+\t\t\t\tt.Context(), app.Name, types.MergePatchType, patch, metav1.PatchOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t})","+","+\taccountFixture.GivenWithSameState(appCtx).","+\t\tName(\"rollback-user\").","+\t\tWhen().","+\t\tCreate().","+\t\tLogin().","+\t\tSetPermissions([]fixture.ACL{","+\t\t\t{Resource: \"applications\", Action: \"get\", Scope: \"*\"},","+\t\t\t{Resource: \"applications\", Action: \"rollback\", Scope: \"*\"},","+\t\t\t{Resource: \"projects\", Action: \"get\", Scope: \"*\"},","+\t\t}, \"rollback-user\")","+","+\trequire.NoError(t, fixture.SetParamInSettingConfigMap(\"server.rbac.rollback.enforce.enable\", \"true\"))","+\twaitForRBACPermission(t, \"rollback\", \"applications\", \"*\", true)","+\t_, err := fixture.RunCli(\"app\", \"rollback\", appName, \"1\")","+\tassert.NoError(t, err, \"user with rollback permission should be able to rollback\")","+}","+","+// TestRollbackWithoutExplicitRollbackPermission verifies that users with neither rollback","+// nor sync permission are denied.","+func TestRollbackWithoutExplicitRollbackPermission(t *testing.T) {","+\tappCtx := Given(t)","+","+\tvar appName string","+\tGivenWithSameState(appCtx).","+\t\tPath(\"guestbook\").","+\t\tWhen().","+\t\tCreateApp().","+\t\tSync().","+\t\tThen().","+\t\tExpect(SyncStatusIs(SyncStatusCodeSynced)).","+\t\tAnd(func(app *Application) {","+\t\t\tappName = app.Name","+\t\t\tappWithHistory := app.DeepCopy()","+\t\t\tappWithHistory.Status.History = []RevisionHistory{","+\t\t\t\t{","+\t\t\t\t\tID:         1,","+\t\t\t\t\tRevision:   app.Status.Sync.Revision,","+\t\t\t\t\tDeployedAt: metav1.Time{Time: metav1.Now().UTC().Add(-1 * time.Minute)},","+\t\t\t\t\tSource:     app.Spec.GetSource(),","+\t\t\t\t},","+\t\t\t}","+\t\t\tpatch, _, err := diff.CreateTwoWayMergePatch(app, appWithHistory, &Application{})","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = fixture.AppClientset.ArgoprojV1alpha1().Applications(fixture.TestNamespace()).Patch(","+\t\t\t\tt.Context(), app.Name, types.MergePatchType, patch, metav1.PatchOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t})","+","+\taccountFixture.GivenWithSameState(appCtx).","+\t\tName(\"readonly-user\").","+\t\tWhen().","+\t\tCreate().","+\t\tLogin().","+\t\tSetPermissions([]fixture.ACL{","+\t\t\t{Resource: \"applications\", Action: \"get\", Scope: \"*\"},","+\t\t\t{Resource: \"projects\", Action: \"get\", Scope: \"*\"},","+\t\t}, \"readonly-user\")","+","+\trequire.NoError(t, fixture.SetParamInSettingConfigMap(\"server.rbac.rollback.enforce.enable\", \"true\"))","+\twaitForRBACPermission(t, \"rollback\", \"applications\", \"*\", false)","+\t_, err := fixture.RunCli(\"app\", \"rollback\", appName, \"1\")","+\trequire.Error(t, err, \"user without rollback or sync permission should not be able to rollback\")","+\tassert.ErrorContains(t, err, \"permission denied\")","+}","+","+// TestRollbackWithSyncPermission tests that users with sync permission can still rollback","+// for backwards compatibility","+func TestRollbackWithSyncPermission(t *testing.T) {","+\tappCtx := Given(t)","+","+\tvar appName string","+\tGivenWithSameState(appCtx).","+\t\tPath(\"guestbook\").","+\t\tWhen().","+\t\tCreateApp().","+\t\tSync().","+\t\tThen().","+\t\tExpect(SyncStatusIs(SyncStatusCodeSynced)).","+\t\tAnd(func(app *Application) {","+\t\t\tappName = app.Name","+\t\t\tappWithHistory := app.DeepCopy()","+\t\t\tappWithHistory.Status.History = []RevisionHistory{","+\t\t\t\t{","+\t\t\t\t\tID:         1,","+\t\t\t\t\tRevision:   app.Status.Sync.Revision,","+\t\t\t\t\tDeployedAt: metav1.Time{Time: metav1.Now().UTC().Add(-1 * time.Minute)},","+\t\t\t\t\tSource:     app.Spec.GetSource(),","+\t\t\t\t},","+\t\t\t}","+\t\t\tpatch, _, err := diff.CreateTwoWayMergePatch(app, appWithHistory, &Application{})","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = fixture.AppClientset.ArgoprojV1alpha1().Applications(fixture.TestNamespace()).Patch(","+\t\t\t\tt.Context(), app.Name, types.MergePatchType, patch, metav1.PatchOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t})","+","+\taccountFixture.GivenWithSameState(appCtx).","+\t\tName(\"sync-user\").","+\t\tWhen().","+\t\tCreate().","+\t\tLogin().","+\t\tSetPermissions([]fixture.ACL{","+\t\t\t{Resource: \"applications\", Action: \"get\", Scope: \"*\"},","+\t\t\t{Resource: \"applications\", Action: \"sync\", Scope: \"*\"},","+\t\t\t{Resource: \"projects\", Action: \"get\", Scope: \"*\"},","+\t\t}, \"sync-user\")","+","+\twaitForRBACPermission(t, \"sync\", \"applications\", \"*\", true)","+\t_, err := fixture.RunCli(\"app\", \"rollback\", appName, \"1\")","+\tassert.NoError(t, err, \"user with sync permission should be able to rollback for backwards compatibility\")","+}","+","+// TestRollbackWithProjectScopedRollbackPermission tests that rollback permission can be scoped to specific projects","+func TestRollbackWithProjectScopedRollbackPermission(t *testing.T) {","+\tappCtx := Given(t)","+\tprojCtx := projectFixture.GivenWithSameState(appCtx)","+\tprojCtx.Destination(\"*,*\").","+\t\tWhen().","+\t\tCreate().","+\t\tAddSource(\"*\")","+","+\tprojName := projCtx.GetName()","+","+\tvar appName string","+\tGivenWithSameState(appCtx).","+\t\tPath(\"guestbook\").","+\t\tProject(projName).","+\t\tWhen().","+\t\tCreateApp().","+\t\tSync().","+\t\tThen().","+\t\tExpect(SyncStatusIs(SyncStatusCodeSynced)).","+\t\tAnd(func(app *Application) {","+\t\t\tappName = app.Name","+\t\t\tappWithHistory := app.DeepCopy()","+\t\t\tappWithHistory.Status.History = []RevisionHistory{","+\t\t\t\t{","+\t\t\t\t\tID:         1,","+\t\t\t\t\tRevision:   app.Status.Sync.Revision,","+\t\t\t\t\tDeployedAt: metav1.Time{Time: metav1.Now().UTC().Add(-1 * time.Minute)},","+\t\t\t\t\tSource:     app.Spec.GetSource(),","+\t\t\t\t},","+\t\t\t}","+\t\t\tpatch, _, err := diff.CreateTwoWayMergePatch(app, appWithHistory, &Application{})","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = fixture.AppClientset.ArgoprojV1alpha1().Applications(fixture.TestNamespace()).Patch(","+\t\t\t\tt.Context(), app.Name, types.MergePatchType, patch, metav1.PatchOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t})","+","+\taccountFixture.GivenWithSameState(appCtx).","+\t\tName(\"scoped-rollback-user\").","+\t\tWhen().","+\t\tCreate().","+\t\tLogin().","+\t\tSetPermissions([]fixture.ACL{","+\t\t\t{Resource: \"applications\", Action: \"get\", Scope: projName + \"/*\"},","+\t\t\t{Resource: \"applications\", Action: \"rollback\", Scope: projName + \"/*\"},","+\t\t\t{Resource: \"projects\", Action: \"get\", Scope: \"*\"},","+\t\t}, \"scoped-rollback-user\")","+","+\trequire.NoError(t, fixture.SetParamInSettingConfigMap(\"server.rbac.rollback.enforce.enable\", \"true\"))","+\twaitForRBACPermission(t, \"rollback\", \"applications\", projName+\"/*\", true)","+\t_, err := fixture.RunCli(\"app\", \"rollback\", appName, \"1\")","+\tassert.NoError(t, err, \"user with rollback permission scoped to default project should be able to rollback\")","+}"],"additions":241,"deletions":0,"truncated":false},{"path":"util/rbac/rbac.go","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":621,"deletions":15,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-08-21T08:26:48.757170+00:00"}