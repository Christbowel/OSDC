n::SWOOSH: {","+            auto offset = disable_type_conversion ? \"m\"_jit : to_type(\"m\"_jit);","+            auto bias = disable_type_conversion ? \"n\"_jit : to_type(\"n\"_jit);","+            const JitTerm shifted = input - offset;","+            const JitTerm softplus = max_func(shifted, zero) + log(one + exp(neg(abs_func(shifted))));","+            const JitTerm slope_literal{std::to_string(ov::intel_gpu::op::swoosh_constants::slope)};","+            const JitTerm slope = disable_type_conversion ? slope_literal : to_type(slope_literal);","+            jitConstants.AddConstant(MakeJitConstant(","+                    macro_def,","+                    (softplus - slope * input - bias).str()));","+            break;","+        }","         case ActivationFunction::SOFTSIGN: {","             jitConstants.AddConstant(MakeJitConstant(","                     macro_def,"],"additions":22,"deletions":8,"truncated":false},{"path":"src/plugins/intel_gpu/src/kernel_selector/kernel_selector_common.cpp","lines":["@@ -84,6 +84,7 @@ std::string toString(ActivationFunction activation) {","         case ActivationFunction::ROUND_HALF_TO_EVEN:        method = \"ROUND_HALF_TO_EVEN\"; break;","         case ActivationFunction::ROUND_HALF_AWAY_FROM_ZERO: method = \"ROUND_HALF_AWAY_FROM_ZERO\"; break;","         case ActivationFunction::ERFINV:                    method = \"ERFINV\"; break;","+        case ActivationFunction::SWOOSH:                    method = \"SWOOSH\"; break;","         default: break;","     }","     return method;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/src/plugin/ops/swoosh.cpp","lines":["@@ -0,0 +1,28 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"intel_gpu/op/swoosh.hpp\"","+#include \"intel_gpu/plugin/program_builder.hpp\"","+#include \"intel_gpu/primitives/activation.hpp\"","+","+namespace ov::op::internal {","+using Swoosh = ov::intel_gpu::op::Swoosh;","+}","+","+namespace ov::intel_gpu {","+","+static void CreateSwooshOp(ProgramBuilder& p, const std::shared_ptr<ov::op::internal::Swoosh>& op) {","+    validate_inputs_count(op, {1});","+    auto inputs = p.GetInputInfo(op);","+    std::string primitive_name = layer_type_name_ID(op);","+    auto primitive = cldnn::activation(primitive_name,","+                                       inputs[0],","+                                       cldnn::activation_func::swoosh,","+                                       {op->get_offset(), op->get_bias()});","+    p.add_primitive(*op, primitive);","+}","+","+REGISTER_FACTORY_IMPL(internal, Swoosh);","+","+}  // namespace ov::intel_gpu"],"additions":28,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/src/plugin/transformations/op/swoosh.cpp","lines":["@@ -0,0 +1,35 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"intel_gpu/op/swoosh.hpp\"","+","+#include \"openvino/core/attribute_visitor.hpp\"","+","+namespace ov::intel_gpu::op {","+","+Swoosh::Swoosh(const ov::Output<Node>& data, float offset, float bias)","+    : Op({data}), m_offset(offset), m_bias(bias) {","+    validate_and_infer_types();","+}","+","+void Swoosh::validate_and_infer_types() {","+    const bool is_swoosh_l = m_offset == swoosh_constants::swoosh_l_offset && m_bias == swoosh_constants::swoosh_l_bias;","+    const bool is_swoosh_r = m_offset == swoosh_constants::swoosh_r_offset && m_bias == swoosh_constants::swoosh_r_bias;","+    OPENVINO_ASSERT(is_swoosh_l || is_swoosh_r, \"Unsupported Swoosh constants\");","+    OPENVINO_ASSERT(get_input_element_type(0).is_real(), \"Swoosh requires a floating-point input\");","+    set_output_type(0, get_input_element_type(0), get_input_partial_shape(0));","+}","+","+bool Swoosh::visit_attributes(ov::AttributeVisitor& visitor) {","+    visitor.on_attribute(\"offset\", m_offset);","+    visitor.on_attribute(\"bias\", m_bias);","+    return true;","+}","+","+std::shared_ptr<ov::Node> Swoosh::clone_with_new_inputs(const ov::OutputVector& new_args) const {","+    check_new_args_count(this, new_args);","+    return std::make_shared<Swoosh>(new_args.at(0), m_offset, m_bias);","+}","+","+}  // namespace ov::intel_gpu::op"],"additions":35,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/src/plugin/transformations/swoosh_fusion.cpp","lines":["@@ -0,0 +1,145 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"swoosh_fusion.hpp\"","+","+#include <cmath>","+#include <limits>","+","+#include \"intel_gpu/op/swoosh.hpp\"","+#include \"openvino/core/graph_util.hpp\"","+#include \"openvino/core/rt_info.hpp\"","+#include \"openvino/core/shape.hpp\"","+#include \"openvino/core/type/float16.hpp\"","+#include \"openvino/op/add.hpp\"","+#include \"openvino/op/constant.hpp\"","+#include \"openvino/op/equal.hpp\"","+#include \"openvino/op/multiply.hpp\"","+#include \"openvino/op/select.hpp\"","+#include \"openvino/op/softplus.hpp\"","+#include \"openvino/op/subtract.hpp\"","+#include \"openvino/pass/pattern/op/or.hpp\"","+#include \"openvino/pass/pattern/op/wrap_type.hpp\"","+#include \"transformations/utils/utils.hpp\"","+","+namespace ov::intel_gpu {","+namespace {","+","+namespace swoosh_constants = op::swoosh_constants;","+","+bool get_scalar_constant(const ov::Output<ov::Node>& output, float& value) {","+    auto constant = ov::as_type_ptr<ov::op::v0::Constant>(output.get_node_shared_ptr());","+    return constant && ov::shape_size(constant->get_shape()) > 0 &&","+           ov::op::util::get_single_value(constant, value, false);","+}","+","+bool matches_constant(float value, float expected, const ov::element::Type& data_type) {","+    if (data_type == ov::element::f32) {","+        return value == expected;","+    }","+    if (data_type == ov::element::f16) {","+        return value == static_cast<float>(ov::float16(expected));","+    }","+    return false;","+}","+","+}  // namespace","+","+SwooshFusion::SwooshFusion() {","+    using namespace ov::pass::pattern;","+","+    auto input_m = any_input();","+    auto shift_constant_m = wrap_type<ov::op::v0::Constant>();","+    auto shifted_lhs_m = wrap_type<ov::op::v1::Add>({input_m, shift_constant_m}, consumers_count(2));","+    auto shifted_rhs_m = wrap_type<ov::op::v1::Add>({shift_constant_m, input_m}, consumers_count(2));","+    auto shifted_m = std::make_shared<ov::pass::pattern::op::Or>(ov::OutputVector{shifted_lhs_m, shifted_rhs_m});","+    auto softplus_m = wrap_type<ov::op::v4::SoftPlus>({shifted_m}, consumers_count(2));","+","+    auto limit_constant_m = wrap_type<ov::op::v0::Constant>();","+    auto equal_lhs_m = wrap_type<ov::op::v1::Equal>({softplus_m, limit_constant_m}, consumers_count(1));","+    auto equal_rhs_m = wrap_type<ov::op::v1::Equal>({limit_constant_m, softplus_m}, consumers_count(1));","+    auto equal_m = std::make_shared<ov::pass::pattern::op::Or>(ov::OutputVector{equal_lhs_m, equal_rhs_m});","+    auto select_m = wrap_type<ov::op::v1::Select>({equal_m, shifted_m, softplus_m}, consumers_count(1));","+","+    auto slope_constant_m = wrap_type<ov::op::v0::Constant>();","+    auto scaled_lhs_m = wrap_type<ov::op::v1::Multiply>({input_m, slope_constant_m}, consumers_count(1));","+    auto scaled_rhs_m = wrap_type<ov::op::v1::Multiply>({slope_constant_m, input_m}, consumers_count(1));","+    auto scaled_m = std::make_shared<ov::pass::pattern::op::Or>(ov::OutputVector{scaled_lhs_m, scaled_rhs_m});","+","+    auto subtract_m = wrap_type<ov::op::v1::Subtract>({select_m, scaled_m}, consumers_count(1));","+    auto body_lhs_m = wrap_type<ov::op::v1::Add>({select_m, scaled_m}, consumers_count(1));","+    auto body_rhs_m = wrap_type<ov::op::v1::Add>({scaled_m, select_m}, consumers_count(1));","+    auto body_m = std::make_shared<ov::pass::pattern::op::Or>(ov::OutputVector{subtract_m, body_lhs_m, body_rhs_m});","+","+    auto bias_constant_m = wrap_type<ov::op::v0::Constant>();","+    auto root_lhs_m = wrap_type<ov::op::v1::Add>({body_m, bias_constant_m});","+    auto root_rhs_m = wrap_type<ov::op::v1::Add>({bias_constant_m, body_m});","+    auto root_m = std::make_shared<ov::pass::pattern::op::Or>(ov::OutputVector{root_lhs_m, root_rhs_m});","+","+    ov::matcher_pass_callback callback = [OV_CAPTURE_CPY_AND_THIS](Matcher& matcher) {","+        const auto& pattern_map = matcher.get_pattern_value_map();","+        const auto root = pattern_map.at(root_m).get_node_shared_ptr();","+        if (transformation_callback(root)) {","+            return false;","+        }","+","+        const auto direct_input = pattern_map.at(input_m);","+        const auto body = pattern_map.at(body_m).get_node_shared_ptr();","+        const auto scaled = pattern_map.at(scaled_m).get_node_shared_ptr();","+        const auto select = pattern_map.at(select_m).get_node_shared_ptr();","+        const auto equal = pattern_map.at(equal_m).get_node_shared_ptr();","+        const auto softplus = pattern_map.at(softplus_m).get_node_shared_ptr();","+        const auto shifted = pattern_map.at(shifted_m).get_node_shared_ptr();","+        const auto data_type = direct_input.get_element_type();","+","+        float shift = 0.0f;","+        float slope = 0.0f;","+        float equal_constant = 0.0f;","+        float final_bias = 0.0f;","+        if (!get_scalar_constant(pattern_map.at(shift_constant_m), shift) ||","+            !get_scalar_constant(pattern_map.at(slope_constant_m), slope) ||","+            !get_scalar_constant(pattern_map.at(limit_constant_m), equal_constant) ||","+            !get_scalar_constant(pattern_map.at(bias_constant_m), final_bias)) {","+            return false;","+        }","+","+        const float expected_slope = ov::is_type<ov::op::v1::Subtract>(body) ? swoosh_constants::slope : -swoosh_constants::slope;","+        if (!matches_constant(slope, expected_slope, data_type)) {","+            return false;","+        }","+","+        const bool is_positive_limit = (std::isinf(equal_constant) && equal_constant > 0.0f) ||","+                                       (data_type == ov::element::f16 &&","+                                        equal_constant == static_cast<float>(std::numeric_limits<ov::float16>::max()));","+        if (!is_positive_limit) {","+            return false;","+        }","+","+        const bool is_swoosh_l =","+            matches_constant(shift, -swoosh_constants::swoosh_l_offset, data_type) && matches_constant(final_bias, -swoosh_constants::swoosh_l_bias, data_type);","+        const bool is_swoosh_r =","+            matches_constant(shift, -swoosh_constants::swoosh_r_offset, data_type) && matches_constant(final_bias, -swoosh_constants::swoosh_r_bias, data_type);","+        if (!is_swoosh_l && !is_swoosh_r) {","+            return false;","+        }","+","+        if (root->get_output_partial_shape(0) != direct_input.get_partial_shape() ||","+            root->get_output_element_type(0) != data_type) {","+            return false;","+        }","+","+        const float offset = is_swoosh_l ? swoosh_constants::swoosh_l_offset : swoosh_constants::swoosh_r_offset;","+        const float bias = is_swoosh_l ? swoosh_constants::swoosh_l_bias : swoosh_constants::swoosh_r_bias;","+        auto swoosh = std::make_shared<ov::intel_gpu::op::Swoosh>(direct_input, offset, bias);","+        swoosh->set_friendly_name(root->get_friendly_name());","+        ov::copy_runtime_info({root, body, scaled, select, equal, softplus, shifted}, swoosh);","+        ov::replace_node(root, swoosh);","+        return true;","+    };","+","+    auto matcher = std::make_shared<Matcher>(root_m, \"SwooshFusion\");","+    register_matcher(matcher, callback);","+}","+","+}  // namespace ov::intel_gpu"],"additions":145,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/src/plugin/transformations/swoosh_fusion.hpp","lines":["@@ -0,0 +1,17 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#pragma once","+","+#include \"openvino/pass/matcher_pass.hpp\"","+","+namespace ov::intel_gpu {","+","+class SwooshFusion : public ov::pass::MatcherPass {","+public:","+    OPENVINO_MATCHER_PASS_RTTI(\"SwooshFusion\");","+    SwooshFusion();","+};","+","+}  // namespace ov::intel_gpu","\\ No newline at end of file"],"additions":17,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/src/plugin/transformations_pipeline.cpp","lines":["@@ -122,6 +122,7 @@"," #include \"plugin/transformations/lora_horizontal_fusion.hpp\""," #include \"plugin/transformations/lora_subgraph_horizontal_fusion.hpp\""," #include \"plugin/transformations/stateless_kv_fusion.hpp\"","+#include \"plugin/transformations/swoosh_fusion.hpp\""," #include \"intel_gpu/op/fully_connected.hpp\""," #include \"transformations/common_optimizations/move_fc_reshape_to_weights.hpp\""," #include \"plugin/transformations/optimize_subsequent_reshapes.hpp\"","@@ -1657,6 +1658,7 @@ void TransformationsPipeline::apply(std::shared_ptr<ov::Model> func) {","         if (device_info.supports_immad && config.get_use_onednn() && !disable_gated_mlp_fusion) {","             manager.register_pass<ov::intel_gpu::FuseGatedMLP>();","         }","+        manager.register_pass<ov::intel_gpu::SwooshFusion>();","         manager.register_pass<ov::intel_gpu::SwiGluFusionWithClamp>();","         // This Validate is needed for proper data type propagation after applying IncreasePositionIdsPrecision pass","         manager.register_pass<ov::pass::Validate>();"],"additions":2,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/tests/unit/module_tests/jitter_test.cpp","lines":["@@ -2,19 +2,26 @@"," // SPDX-License-Identifier: Apache-2.0"," //"," ","+#include \"impls/ocl_v2/utils/jitter.hpp\"","+"," #include <gtest/gtest.h>"," #include <gtest/internal/gtest-param-util.h>","-#include \"impls/ocl_v2/utils/jitter.hpp\"","+","+#include <algori