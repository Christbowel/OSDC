,"+  const cwd = process.cwd();","+  const pages = await loadPages(path.join(cwd, \"app\", \"pages\"));","+  const app = await loadAppServer(cwd);","+  if (pages.length === 0 && app === undefined) {","+    throw new Error(`Nothing to serve in \"${cwd}\": there are no pages in app/pages/ and no app/server.ts.`);","+  }","+","+  const routes: Record<string, unknown> = {};","+  const pageOfRoute: Record<string, Page> = { __proto__: null } as any;","+  for (let i = 0; i < pages.length; i++) {","+    const page = pages[i];","+    routes[page.url] = page.bundle;","+    pageOfRoute[page.url] = page;","+  }","+  const appRoutes = app?.routes;","+  if (appRoutes !== undefined) {","+    const names = ObjectKeys(appRoutes);","+    for (let i = 0; i < names.length; i++) {","+      const route = names[i];","+      const page = pageOfRoute[route];","+      if (page !== undefined) {","+        throw new Error(`The route \"${route}\" in \"${display(app!.file)}\" is also the page \"${display(page.file)}\".`);","+      }","+      routes[route] = appRoutes[route];","+    }","+  }","+","+  const fetch = app?.fetch ?? (() => new Response(\"Not found\", { status: 404 }));","+  // Like `export default` in `bun app.ts`, every option of `Bun.serve()` in the export counts. These","+  // are Bake's, and the flags come before the export's own `port` and `hostname`.","+  const exported = app?.server;","+  // Each is read once: a getter may return a new value on each read.","+  const exportedHostname = exported?.hostname;","+  const exportedPort = exported?.port;","+  // A `unix` socket in the export is kept unless a flag asks for a TCP address.","+  const useUnix = exported?.unix !== undefined && flags.hostname === undefined && flags.port === undefined;","+  const server = serveOnFreePort(","+    \"bun bake\",","+    port => {","+      const options = ObjectCreate(exported ?? null);","+      // Own properties, defined rather than assigned: the export may be frozen, or have getters.","+      const own = (key: string, value: unknown) =>","+        ObjectDefineProperty(options, key, { value, writable: true, enumerable: true, configurable: true });","+      own(\"routes\", routes);","+      own(\"fetch\", fetch);","+      own(\"development\", { console: flags.console, hmr: undefined });","+      if (useUnix) {","+        own(\"hostname\", undefined);","+        own(\"port\", undefined);","+      } else {","+        own(\"unix\", undefined);","+        own(\"hostname\", flags.hostname ?? exportedHostname ?? \"localhost\");","+        // `undefined` uses the default port via existing port detection code.","+        own(\"port\", port);","+      }","+      return options as Serve.Options<undefined>;","+    },","+    useUnix ? undefined : (flags.port ?? exportedPort),","+  );","+  const elapsed = (performance.now() - initial).toFixed(2);","+","+  const listed: { route: string; file: string }[] = [];","+  for (let i = 0; i < pages.length; i++) {","+    listed[i] = { route: pages[i].route, file: pages[i].file };","+  }","+  printBannerAndHandleShortcuts({ server, elapsed, pathname: \"/\", routes: listed });","+}","+","+export default start;"],"additions":225,"deletions":0,"truncated":false},{"path":"src/js/internal/html.ts","lines":["@@ -1,11 +1,17 @@"," // This is the file that loads when you pass a '.html' entry point to Bun."," // It imports the entry points and initializes a server.","-import type { HTMLBundle, Server } from \"bun\";","+import type { HTMLBundle } from \"bun\";"," const initial = performance.now();"," const argv = process.argv;"," "," // `import` cannot be used in this file and only Bun builtin modules can be used."," const path = require(\"node:path\");","+const {","+  defaultServeFlags,","+  parseServeFlag,","+  serveOnFreePort,","+  printBannerAndHandleShortcuts,","+} = require(\"internal/serve_cli\");"," "," const env = Bun.env;"," ","@@ -13,35 +19,14 @@ const env = Bun.env;"," async function start() {","   let args: string[] = [];","   cons