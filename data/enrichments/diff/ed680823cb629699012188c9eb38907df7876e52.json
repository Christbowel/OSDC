the page at `file`, relative to `app/pages/`, without the leading `/`. */","+function routeOfPage(file: string): string {","+  let route = file.replaceAll(\"\\\\\", \"/\").slice(0, -\".html\".length);","+  if (route === \"index\") return \"\";","+  if (route.endsWith(\"/index\")) route = route.slice(0, -\"/index\".length);","+  return route;","+}","+","+async function loadPages(pagesDir: string): Promise<Page[]> {","+  let files: string[];","+  try {","+    files = [...new Bun.Glob(\"**/*.html\").scanSync({ cwd: pagesDir, onlyFiles: true, followSymlinks: true })];","+  } catch (error: any) {","+    if (error?.code === \"ENOENT\") return [];","+    throw error;","+  }","+  files.sort((a, b) => a.localeCompare(b));","+","+  const pages: Page[] = [];","+  const fileOfRoute: Record<string, string> = { __proto__: null } as any;","+  for (const relative of files) {","+    const file = path.join(pagesDir, relative);","+    // `Bun.serve` routes read `:` as a parameter and `*` as a wildcard. `[` is the parameter syntax of page files.","+    // In a URL, `?` and `#` end the path and `%` starts an escape.","+    if (/[[\\]:*?#%]/.test(relative)) {","+      throw new Error(","+        `\"${display(file)}\": a page cannot have \"[\", \"]\", \":\", \"*\", \"?\", \"#\" or \"%\" in its path. Its URL must be fixed.`,","+      );","+    }","+    const route = routeOfPage(relative);","+    const other = fileOfRoute[route];","+    if (other !== undefined) {","+      throw new Error(`\"${display(other)}\" and \"${display(file)}\" are both the page \"/${route}\".`);","+    }","+    fileOfRoute[route] = file;","+    // Encoded as browsers send it: non-ASCII characters and spaces are, `&` and `=` are not.","+    const url = new URL(\"/\" + route, \"http://localhost\").pathname;","+    pages.push({ route, url, file, bundle: (await import(file)).default });","+  }","+  return pages;","+}","+","+async function loadAppServer(","+  cwd: string,","+): Promise<","+  { file: string; server: AppSe