{"id":"f4d3348b541edba83734fee3e486c669594e72f5","axis":"silent","repo":"elastic/elasticsearch","sha":"f4d3348b541edba83734fee3e486c669594e72f5","parsed":{"files":[{"path":"docs/changelog/162524.yaml","lines":["@@ -0,0 +1,5 @@","+area: ES|QL","+issues: []","+pr: 162524","+summary: Restrict ES|QL enrich lookup to enrich indices","+type: bug"],"additions":5,"deletions":0,"truncated":false},{"path":"x-pack/plugin/core/src/main/java/org/elasticsearch/xpack/core/enrich/EnrichPolicy.java","lines":["@@ -40,6 +40,11 @@ public final class EnrichPolicy implements Writeable, ToXContentFragment {"," ","     public static final String ENRICH_INDEX_NAME_BASE = \".enrich-\";","     public static final String ENRICH_INDEX_PATTERN = ENRICH_INDEX_NAME_BASE + \"*\";","+    /**","+     * Field in the {@code _meta} of an enrich index's mapping that names the policy the index was built for. Unlike the index name,","+     * it survives the system index migration, which renames enrich indices.","+     */","+    public static final String ENRICH_POLICY_NAME_FIELD_NAME = \"enrich_policy_name\";"," ","     public static final String MATCH_TYPE = \"match\";","     public static final String GEO_MATCH_TYPE = \"geo_match\";"],"additions":5,"deletions":0,"truncated":false},{"path":"x-pack/plugin/enrich/src/main/java/org/elasticsearch/xpack/enrich/EnrichPolicyRunner.java","lines":["@@ -89,7 +89,7 @@ public class EnrichPolicyRunner {"," ","     private static final Logger logger = LogManager.getLogger(EnrichPolicyRunner.class);"," ","-    static final String ENRICH_POLICY_NAME_FIELD_NAME = \"enrich_policy_name\";","+    static final String ENRICH_POLICY_NAME_FIELD_NAME = EnrichPolicy.ENRICH_POLICY_NAME_FIELD_NAME;","     static final String ENRICH_POLICY_TYPE_FIELD_NAME = \"enrich_policy_type\";","     static final String ENRICH_MATCH_FIELD_NAME = \"enrich_match_field\";","     static final String ENRICH_README_FIELD_NAME = \"enrich_readme\";"],"additions":1,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/enrich/EnrichLookupService.java","lines":["@@ -11,7 +11,10 @@"," import org.elasticsearch.action.ActionListener;"," import org.elasticsearch.action.ActionListenerResponseHandler;"," import org.elasticsearch.action.support.ContextPreservingActionListener;","+import org.elasticsearch.cluster.metadata.IndexMetadata;"," import org.elasticsearch.cluster.metadata.IndexNameExpressionResolver;","+import org.elasticsearch.cluster.metadata.MappingMetadata;","+import org.elasticsearch.cluster.metadata.ProjectMetadata;"," import org.elasticsearch.cluster.node.DiscoveryNode;"," import org.elasticsearch.cluster.project.ProjectResolver;"," import org.elasticsearch.cluster.service.ClusterService;","@@ -36,13 +39,17 @@"," import org.elasticsearch.index.query.SearchExecutionContext;"," import org.elasticsearch.index.shard.ShardId;"," import org.elasticsearch.indices.IndicesService;","+import org.elasticsearch.indices.SystemIndices;"," import org.elasticsearch.search.internal.AliasFilter;"," import org.elasticsearch.tasks.CancellableTask;"," import org.elasticsearch.tasks.TaskId;"," import org.elasticsearch.transport.TransportRequestOptions;"," import org.elasticsearch.transport.TransportService;","+import org.elasticsearch.xcontent.ObjectPath;"," import org.elasticsearch.xpack.core.ClientHelper;"," import org.elasticsearch.xpack.core.XPackSettings;","+import org.elasticsearch.xpack.core.enrich.EnrichMetadata;","+import org.elasticsearch.xpack.core.enrich.EnrichPolicy;"," import org.elasticsearch.xpack.core.security.SecurityContext;"," import org.elasticsearch.xpack.core.security.action.user.HasPrivilegesAction;"," import org.elasticsearch.xpack.core.security.action.user.HasPrivilegesRequest;","@@ -63,6 +70,7 @@"," import java.io.IOException;"," import java.util.Collection;"," import java.util.List;","+import java.util.Map;"," import java.util.stream.Collectors;"," "," /**","@@ -355,6 +363,19 @@ protected void sendChildRequest(","         DiscoveryNode targetNode,","         TransportRequest transportRequest","     ) {","+        ProjectMetadata project = projectResolver.getProjectMetadata(clusterService.state());","+        Map<String, EnrichPolicy> policies = project.custom(EnrichMetadata.TYPE, EnrichMetadata.EMPTY).getPolicies();","+        // The lookup below runs with the enrich origin rather than as the user, so restrict it to the","+        // indices it exists to read: those created for a local enrich policy.","+        if (isEnrichPolicyIndex(policies, project.index(transportRequest.shardId.getIndex())) == false) {","+            delegate.onFailure(","+                Exceptions.authorizationError(","+                    \"enrich lookup on index [{}] is not allowed; it is not the index of an enrich policy\",","+                    transportRequest.shardId.getIndexName()","+                )","+            );","+            return;","+        }","         ThreadContext threadContext = transportService.getThreadPool().getThreadContext();","         ActionListener<AbstractLookupService.LookupResponse> listener = ContextPreservingActionListener.wrapPreservingContext(","             delegate,","@@ -369,6 +390,24 @@ protected void sendChildRequest(","         }));","     }"," ","+    /**","+     * Whether {@code index} is an index that the enrich policy runner built for one of {@code policies}. The policy is read from","+     * the {@code _meta} of the index's mapping rather than parsed from the index name, because the system index migration renames","+     * enrich indices (appending {@link SystemIndices#UPGRADED_INDEX_SUFFIX}) but copies their mappings. The {@code .enrich-}","+     * prefix is still required, so that an index outside the enrich namespace can't pass by carrying the same {@code _meta}.","+     */","+    static boolean isEnrichPolicyIndex(Map<String, EnrichPolicy> policies, @Nullable IndexMetadata index) {","+        if (index == null || index.getIndex().getName().startsWith(EnrichPolicy.ENRICH_INDEX_NAME_BASE) == false) {","+            return false;","+        }","+        MappingMetadata mapping = index.mapping();","+        if (mapping == null) {","+            return false;","+        }","+        Object policyName = ObjectPath.eval(\"_meta.\" + EnrichPolicy.ENRICH_POLICY_NAME_FIELD_NAME, mapping.getSourceAsMap());","+        return policyName instanceof String name && policies.containsKey(name);","+    }","+","     protected void hasEnrichPrivilege(ActionListener<Void> outListener) {","         final Settings settings = clusterService.getSettings();","         String privilegeName = ClusterPrivilegeResolver.MONITOR_ENRICH.name();"],"additions":39,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/enrich/EnrichLookupServiceTests.java","lines":["@@ -0,0 +1,81 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.enrich;","+","+import org.elasticsearch.cluster.metadata.IndexMetadata;","+import org.elasticsearch.index.IndexVersion;","+import org.elasticsearch.indices.SystemIndices;","+import org.elasticsearch.test.ESTestCase;","+import org.elasticsearch.xpack.core.enrich.EnrichPolicy;","+","+import java.util.List;","+import java.util.Map;","+","+public class EnrichLookupServiceTests extends ESTestCase {","+","+    private static final Map<String, EnrichPolicy> POLICIES = Map.of(\"users\", policy(), \"multi-part-name\", policy());","+","+    public void testIndexOfExistingPolicyIsAllowed() {","+        assertTrue(isEnrichPolicyIndex(EnrichPolicy.getIndexName(\"users\", randomNonNegativeLong()), metaFor(\"users\")));","+        assertTrue(isEnrichPolicyIndex(EnrichPolicy.getIndexName(\"multi-part-name\", randomNonNegativeLong()), metaFor(\"multi-part-name\")));","+    }","+","+    public void testMigratedIndexOfExistingPolicyIsAllowed() {","+        String index = EnrichPolicy.getIndexName(\"users\", randomNonNegativeLong()) + SystemIndices.UPGRADED_INDEX_SUFFIX;","+        assertTrue(isEnrichPolicyIndex(index, metaFor(\"users\")));","+        assertTrue(isEnrichPolicyIndex(index + \"-reindexed-for-11\", metaFor(\"users\")));","+    }","+","+    public void testRegularIndexIsRejected() {","+        assertFalse(isEnrichPolicyIndex(\"users\", metaFor(\"users\")));","+        assertFalse(isEnrichPolicyIndex(\"users-1700000000000\", metaFor(\"users\")));","+    }","+","+    public void testSystemIndexIsRejected() {","+        assertFalse(isEnrichPolicyIndex(\".security-7\", metaFor(\"users\")));","+        assertFalse(isEnrichPolicyIndex(\".kibana_1\", \"{}\"));","+    }","+","+    public void testEnrichIndexWithoutPolicyNameIsRejected() {","+        assertFalse(isEnrichPolicyIndex(\".enrich-users-1700000000000\", \"{}\"));","+        assertFalse(isEnrichPolicyIndex(\".enrich-users-1700000000000\", \"{\\\"_meta\\\":{}}\"));","+        assertFalse(isEnrichPolicyIndex(\".enrich-users-1700000000000\", \"{\\\"_meta\\\":{\\\"enrich_policy_name\\\":5}}\"));","+    }","+","+    public void testEnrichIndexOfUnknownPolicyIsRejected() {","+        assertFalse(isEnrichPolicyIndex(\".enrich-users-1700000000000\", metaFor(\"other\")));","+        assertFalse(EnrichLookupService.isEnrichPolicyIndex(Map.of(), indexMetadata(\".enrich-users-1700000000000\", metaFor(\"users\"))));","+    }","+","+    public void testIndexWithoutMappingIsRejected() {","+        IndexMetadata index = IndexMetadata.builder(\".enrich-users-1700000000000\")","+            .settings(indexSettings(IndexVersion.current(), 1, 0))","+            .build();","+        assertFalse(EnrichLookupService.isEnrichPolicyIndex(POLICIES, index));","+    }","+","+    public void testMissingIndexIsRejected() {","+        assertFalse(EnrichLookupService.isEnrichPolicyIndex(POLICIES, null));","+    }","+","+    private static boolean isEnrichPolicyIndex(String index, String mapping) {","+        return EnrichLookupService.isEnrichPolicyIndex(POLICIES, indexMetadata(index, mapping));","+    }","+","+    private static IndexMetadata indexMetadata(String index, String mapping) {","+        return IndexMetadata.builder(index).settings(indexSettings(IndexVersion.current(), 1, 0)).putMapping(mapping).build();","+    }","+","+    private static String metaFor(String policyName) {","+        return \"{\\\"_meta\\\":{\\\"\" + EnrichPolicy.ENRICH_POLICY_NAME_FIELD_NAME + \"\\\":\\\"\" + policyName + \"\\\"}}\";","+    }","+","+    private static EnrichPolicy policy() {","+        return new EnrichPolicy(EnrichPolicy.MATCH_TYPE, null, List.of(\"source\"), \"key\", List.of(\"value\"));","+    }","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/plugin/RemoteEnrichIndexRewriter.java","lines":["@@ -0,0 +1,103 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.plugin;","+","+import org.elasticsearch.test.transport.MockTransportService;","+import org.elasticsearch.transport.TransportService;","+import org.elasticsearch.xpack.esql.plan.logical.Enrich;","+import org.elasticsearch.xpack.esql.plan.physical.EnrichExec;","+import org.elasticsearch.xpack.esql.plan.physical.FragmentExec;","+import org.elasticsearch.xpack.esql.plan.physical.PhysicalPlan;","+","+import java.util.HashMap;","+import java.util.Map;","+import java.util.concurrent.atomic.AtomicInteger;","+","+/**","+ * Lets a test play the part of a querying cluster that tampers with the plan it sends to a remote cluster, by pointing the","+ * remote ENRICH at an arbitrary index instead of the concrete index of the enrich policy.","+ */","+public final class RemoteEnrichIndexRewriter {","+","+    private RemoteEnrichIndexRewriter() {}","+","+    /**","+     * Rewrites every {@link ClusterComputeRequest} that {@code transportServices} send to {@code clusterAlias} so that its ENRICH","+     * reads {@code index} on that cluster. Returns the number of requests whose plan contained an ENRICH and was therefore changed.","+     * Call {@link MockTransportService#clearAllRules()} to stop rewriting.","+     */","+    public static AtomicInteger rewriteRemoteEnrichIndex(Iterable<TransportService> transportServices, String clusterAlias, String index) {","+        AtomicInteger rewritten = new AtomicInteger();","+        for (TransportService ts : transportServices) {","+            ((MockTransportService) ts).addSendBehavior((connection, requestId, action, request, options) -> {","+                if (action.equals(ComputeService.CLUSTER_ACTION_NAME)","+                    && request instanceof ClusterComputeRequest original","+                    && original.clusterAlias().equals(clusterAlias)) {","+                    RemoteClusterPlan plan = original.remoteClusterPlan();","+                    PhysicalPlan tamperedPlan = withEnrichIndex(plan.plan(), clusterAlias, index);","+                    if (tamperedPlan.equals(plan.plan()) == false) {","+                        rewritten.incrementAndGet();","+                    }","+                    ClusterComputeRequest tampered = new ClusterComputeRequest(","+                        original.clusterAlias(),","+                        original.sessionId(),","+                        original.configuration(),","+                        new RemoteClusterPlan(tamperedPlan, plan.targetIndices(), plan.originalIndices())","+                    );","+                    tampered.setParentTask(original.getParentTask());","+                    connection.sendRequest(requestId, action, tampered, options);","+                } else {","+                    connection.sendRequest(requestId, action, request, options);","+                }","+            });","+        }","+        return rewritten;","+    }","+","+    private static PhysicalPlan withEnrichIndex(PhysicalPlan plan, String clusterAlias, String index) {","+        PhysicalPlan rewritten = plan.transformUp(","+            EnrichExec.class,","+            e -> new EnrichExec(","+                e.source(),","+                e.child(),","+                e.mode(),","+                e.matchType(),","+                e.matchField(),","+                e.policyName(),","+                e.policyMatchField(),","+                withIndex(e.concreteIndices(), clusterAlias, index),","+                e.enrichFields()","+            )","+        );","+        return rewritten.transformUp(","+            FragmentExec.class,","+            f -> f.withFragment(","+                f.fragment()","+                    .transformUp(","+                        Enrich.class,","+                        e -> new Enrich(","+                            e.source(),","+                            e.child(),","+                            e.mode(),","+                            e.policyName(),","+                            e.matchField(),","+                            e.policy(),","+                            withIndex(e.concreteIndices(), clusterAlias, index),","+                            e.enrichFields()","+                        )","+                    )","+            )","+        );","+    }","+","+    private static Map<String, String> withIndex(Map<String, String> concreteIndices, String clusterAlias, String index) {","+        Map<String, String> result = new HashMap<>(concreteIndices);","+        result.put(clusterAlias, index);","+        return result;","+    }","+}"],"additions":103,"deletions":0,"truncated":false},{"path":"x-pack/plugin/security/build.gradle","lines":["@@ -73,6 +73,8 @@ dependencies {","   internalClusterTestImplementation(testArtifact(project(xpackModule('core'))))","   internalClusterTestImplementation project(xpackModule('esql'))","   internalClusterTestImplementation(testArtifact(project(xpackModule('esql'))))","+  internalClusterTestImplementation project(xpackModule('enrich'))","+  internalClusterTestImplementation project(':modules:ingest-common')","   api \"com.unboundid:unboundid-ldapsdk:${versions.ldapsdk}\""," ","   internalClusterTestImplementation project(path: ':modules:lang-painless')"],"additions":2,"deletions":0,"truncated":false},{"path":"x-pack/plugin/security/src/internalClusterTest/java/org/elasticsearch/xpack/security/authz/EsqlRemoteEnrichIndexSecurityIT.java","lines":["@@ -0,0 +1,364 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.security.authz;","+","+import org.elasticsearch.ElasticsearchSecurityException;","+import org.elasticsearch.ExceptionsHelper;","+import org.elasticsearch.ResourceNotFoundException;","+import org.elasticsearch.action.support.IndicesOptions;","+import org.elasticsearch.client.internal.Client;","+import org.elasticsearch.client.internal.OriginSettingClient;","+import org.elasticsearch.cluster.metadata.IndexMetadata;","+import org.elasticsearch.cluster.metadata.ProjectMetadata;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.core.Nullable;","+import org.elasticsearch.index.reindex.ReindexRequestBuilder;","+import org.elasticsearch.indices.SystemIndices;","+import org.elasticsearch.ingest.common.IngestCommonPlugin;","+import org.elasticsearch.integration.EsqlResolveViewRemoteClusterClientRoleIT;","+import org.elasticsearch.license.XPackLicenseState;","+import org.elasticsearch.plugins.Plugin;","+import org.elasticsearch.rest.RestStatus;","+import org.elasticsearch.test.AbstractMultiClustersTestCase;","+import org.elasticsearch.test.ESIntegTestCase;","+import org.elasticsearch.test.NodeConfigurationSource;","+import org.elasticsearch.test.SecuritySettingsSource;","+import org.elasticsearch.test.SecuritySettingsSourceField;","+import org.elasticsearch.test.transport.MockTransportService;","+import org.elasticsearch.transport.TransportService;","+import org.elasticsearch.xpack.core.enrich.EnrichPolicy;","+import org.elasticsearch.xpack.core.enrich.action.DeleteEnrichPolicyAction;","+import org.elasticsearch.xpack.core.enrich.action.ExecuteEnrichPolicyAction;","+import org.elasticsearch.xpack.core.enrich.action.PutEnrichPolicyAction;","+import org.elasticsearch.xpack.core.security.action.role.PutRoleRequestBuilder;","+import org.elasticsearch.xpack.enrich.EnrichPlugin;","+import org.elasticsearch.xpack.esql.action.EsqlQueryAction;","+import org.elasticsearch.xpack.esql.action.EsqlQueryRequest;","+import org.elasticsearch.xpack.esql.action.EsqlQueryResponse;","+import org.elasticsearch.xpack.esql.datasources.datasource.TestEncryptionServicePlugin;","+import org.elasticsearch.xpack.esql.plugin.RemoteEnrichIndexRewriter;","+import org.elasticsearch.xpack.security.LocalStateSecurity;","+import org.junit.After;","+import org.junit.Before;","+","+import java.nio.file.Path;","+import java.util.ArrayList;","+import java.util.Collection;","+import java.util.List;","+import java.util.Map;","+import java.util.Objects;","+import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.AtomicInteger;","+import java.util.stream.Stream;","+","+import static org.elasticsearch.test.SecuritySettingsSource.ES_TEST_ROOT_USER;","+import static org.elasticsearch.test.SecuritySettingsSource.TEST_USER_NAME;","+import static org.elasticsearch.test.SecuritySettingsSourceField.TEST_PASSWORD_SECURE_STRING;","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;","+import static org.elasticsearch.xpack.core.ClientHelper.MONITORING_ORIGIN;","+import static org.elasticsearch.xpack.core.ClientHelper.SECURITY_ORIGIN;","+import static org.elasticsearch.xpack.core.security.authc.support.UsernamePasswordToken.BASIC_AUTH_HEADER;","+import static org.elasticsearch.xpack.core.security.authc.support.UsernamePasswordToken.basicAuthHeaderValue;","+import static org.elasticsearch.xpack.security.support.SecuritySystemIndices.SECURITY_MAIN_ALIAS;","+import static org.hamcrest.Matchers.containsString;","+import static org.hamcrest.Matchers.equalTo;","+import static org.hamcrest.Matchers.greaterThan;","+import static org.hamcrest.Matchers.notNullValue;","+","+/**","+ * Plays the part of a querying cluster that rewrites the enrich index in the plan it sends to a remote cluster, with security","+ * enabled on both clusters, and checks that the remote cluster only runs the enrich lookup against the index of one of its own","+ * enrich policies. The querying user may only read {@code events} on the remote cluster and use its enrich policies.","+ */","+public class EsqlRemoteEnrichIndexSecurityIT extends AbstractMultiClustersTestCase {","+","+    private static final String REMOTE_CLUSTER = \"c1\";","+    private static final String POLICY_NAME = \"hosts\";","+    private static final String HOST = \"192.168.1.2\";","+    private static final String SECRET = \"TOP-SECRET\";","+    private static final String QUERY = \"FROM \" + REMOTE_CLUSTER + \":events | ENRICH _remote:hosts ON host WITH os | KEEP host, os\";","+    private static final String NO_POLICY_INDEX = \".enrich-unknown-1700000000000\";","+    private static final String UNKNOWN_POLICY_INDEX = \".enrich-other-1700000000000\";","+","+    @Nullable","+    private String migratedPolicyIndex;","+","+    @Override","+    protected List<String> remoteClusterAlias() {","+        return List.of(REMOTE_CLUSTER);","+    }","+","+    @Override","+    protected Map<String, Boolean> skipUnavailableForRemoteClusters() {","+        return Map.of(REMOTE_CLUSTER, false);","+    }","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins(String clusterAlias) {","+        // EsqlPlugin reads the EncryptionService that TestEncryptionServicePlugin registers, so the latter must come first.","+        return List.of(","+            TestEncryptionServicePlugin.class,","+            EsqlResolveViewRemoteClusterClientRoleIT.EsqlWithTrialLicensePlugin.class,","+            IngestCommonPlugin.class","+        );","+    }","+","+    /**","+     * Without an origin the framework's cluster clients run as {@code _system}, which may not wipe the clusters between tests.","+     * The test itself authenticates explicitly, as the test user or via {@link #rootClient}.","+     */","+    @Override","+    protected String internalClientOrigin() {","+        return MONITORING_ORIGIN;","+    }","+","+    @Override","+    protected NodeConfigurationSource nodeConfigurationSource() {","+        return new EnrichSecuritySettingsSource(createTempDir());","+    }","+","+    @Before","+    public void setupRemoteIndices() {","+        Client remote = rootClient(REMOTE_CLUSTER);","+        createIndex(remote, \"hosts\", \"ip\", \"os\");","+        index(remote, \"hosts\", \"ip\", HOST, \"os\", \"Windows\");","+        EnrichPolicy policy = new EnrichPolicy(EnrichPolicy.MATCH_TYPE, null, List.of(\"hosts\"), \"ip\", List.of(\"os\"));","+        remote.execute(PutEnrichPolicyAction.INSTANCE, new PutEnrichPolicyAction.Request(TEST_REQUEST_TIMEOUT, POLICY_NAME, policy))","+            .actionGet();","+        remote.execute(ExecuteEnrichPolicyAction.INSTANCE, new ExecuteEnrichPolicyAction.Request(TEST_REQUEST_TIMEOUT, POLICY_NAME))","+            .actionGet();","+","+        createIndex(remote, \"events\", \"host\");","+        index(remote, \"events\", \"host\", HOST);","+        for (String index : List.of(\"secrets\", NO_POLICY_INDEX)) {","+            createIndex(remote, index, \"ip\", \"os\");","+            index(remote, index, \"ip\", HOST, \"os\", SECRET);","+        }","+        assertAcked(","+            remote.admin()","+                .indices()","+                .prepareCreate(UNKNOWN_POLICY_INDEX)","+                .setSettings(Settings.builder().put(\"index.number_of_shards\", 1))","+                .setMapping(","+                    Map.of(","+                        \"_meta\",","+                        Map.of(EnrichPolicy.ENRICH_POLICY_NAME_FIELD_NAME, \"other\"),","+                        \"properties\",","+                        Map.of(\"ip\", Map.of(\"type\", \"keyword\"), \"os\", Map.of(\"type\", \"keyword\"))","+                    )","+                )","+        );","+        index(remote, UNKNOWN_POLICY_INDEX, \"ip\", HOST, \"os\", SECRET);","+    }","+","+    @After","+    public void cleanup() {","+        for (TransportService ts : cluster(LOCAL_CLUSTER).getInstances(TransportService.class)) {","+            ((MockTransportService) ts).clearAllRules();","+        }","+        Client remote = rootClient(REMOTE_CLUSTER);","+        try {","+            remote.execute(DeleteEnrichPolicyAction.INSTANCE, new DeleteEnrichPolicyAction.Request(TEST_REQUEST_TIMEOUT, POLICY_NAME))","+                .actionGet();","+        } catch (ResourceNotFoundException e) {","+            // setupRemoteIndices failed before creating the policy; don't hide that failure","+        }","+        assertAcked(","+            remote.admin()","+                .indices()","+                .prepareDelete(","+                    Stream.of(\"hosts\", \"events\", \"secrets\", NO_POLICY_INDEX, UNKNOWN_POLICY_INDEX, migratedPolicyIndex)","+                        .filter(Objects::nonNull)","+                        .toArray(String[]::new)","+                )","+                .setIndicesOptions(IndicesOptions.lenientExpandOpen())","+        );","+        // The test cluster wipe skips system indices, so drop the security index created by the system index test.","+        Client security = new OriginSettingClient(cluster(REMOTE_CLUSTER).client(), SECURITY_ORIGIN);","+        assertAcked(security.admin().indices().prepareDelete(SECURITY_MAIN_ALIAS).setIndicesOptions(IndicesOptions.lenientExpandOpen()));","+    }","+","+    public void testUnmodifiedRemotePlanEnrichesFromPolicyIndex() {","+        try (EsqlQueryResponse resp = runQueryAsTestUser()) {","+            assertThat(rows(resp), equalTo(List.of(List.of(HOST, \"Windows\"))));","+        }","+    }","+","+    public void testUnmodifiedRemotePlanEnrichesFromMigratedPolicyIndex() {","+        migratedPolicyIndex = migratePolicyIndex();","+        try (EsqlQueryResponse resp = runQueryAsTestUser()) {","+            assertThat(rows(resp), equalTo(List.of(List.of(HOST, \"Windows\"))));","+        }","+    }","+","+    public void testRemotePlanTargetingRegularIndexIsRejected() {","+        assertTamperedLookupRejected(\"secrets\");","+    }","+","+    public void testRemotePlanTargetingSystemIndexIsRejected() {","+        Client remote = rootClient(REMOTE_CLUSTER);","+        // The security system index is only created once something is stored in it, such as a native role.","+        new PutRoleRequestBuilder(remote).name(\"unused\").cluster(\"monitor\").get();","+        String securityIndex = cluster(REMOTE_CLUSTER).clusterService()","+            .state()","+            .metadata()","+            .getProject()","+            .getIndicesLookup()","+            .get(SECURITY_MAIN_ALIAS)","+            .getIndices()","+            .getFirst()","+            .getName();","+        assertTamperedLookupRejected(securityIndex);","+    }","+","+    public void testRemotePlanTargetingEnrichIndexWithoutPolicyIsRejected() {","+        ElasticsearchSecurityException e = assertTamperedLookupRejected(NO_POLICY_INDEX);","+        assertThat(e.getMessage(), containsString(\"enrich lookup on index [\" + NO_POL