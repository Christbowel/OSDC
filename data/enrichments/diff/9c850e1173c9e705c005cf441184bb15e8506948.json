e audit applies it to every service; normal lint","-// applies it only to entries marked migrated in the inventory.","+// Service policy applies independently of inventory and migration status."," const servicesRoot = 'ghost/core/server/services';","-const auditServices = process.env.GHOST_SERVICE_DEPENDENCY_AUDIT === '1';","-const { services } = yaml.load(","-  readFileSync(path.join(__dirname, servicesRoot, 'service-inventory.yaml'), 'utf8'),","-);","-const migratedServices = Object.entries(services)","-  .filter(([, entry]) => entry.migrated === true)","-  .map(([name]) => name.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'))","-  .join('|');"," const serviceImplementations = {","-  path: `^${servicesRoot}/(${auditServices ? '[^/]+' : migratedServices || '(?!)'})(?:/|$)`,","-  pathNot: `^${servicesRoot}/[^/]+/index\\\\.${auditServices ? '(?:js|ts)' : 'ts'}$`,","+  path: `^${servicesRoot}/([^/]+)(?:/|$)`,","+  // Legacy JS roots remain wiring candidates; nested indexes are implementations.","+  pathNot: `^${servicesRoot}/[^/]+/index\\\\.(?:js|ts)$`,"," };"," "," // Explicit code-library and contract allowances, not application instances.","@@ -364,12 +353,10 @@ module.exports = {","     webpackConfig: { fileName: './tools/scripts/ci/service-dependency-resolver.mjs' },","     // Keep incoming edges to built packages visible without scanning their output.","     doNotFollow: {","-      path: auditServices","-        ? `^(?!${servicesRoot}/)`","-        : [","-            'node_modules',","-            '^(?!ghost/core/server/services/)(apps|ghost|packages|koenig)/.*/(build|built|dist)/',","-          ],","+      path: [","+        'node_modules',","+        '^(?!ghost/core/server/services/)(apps|ghost|packages|koenig)/.*/(build|built|dist)/',","+      ],","     },","     // Skip our own tests and emitted companions. All source inside services stays visible:","     // a nested directory name must not hide a production dependency."],"additions":8,"deletions":21,"truncated"