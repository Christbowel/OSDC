\t},"," \t\t}","-\t} else {","+\tcase storageMountParams.DefaultVolumeSource != nil:","+\t\tvolumeSource = *storageMountParams.DefaultVolumeSource","+\tdefault:"," \t\tvolumeSource = corev1.VolumeSource{"," \t\t\tEmptyDir: &corev1.EmptyDirVolumeSource{},"," \t\t}"],"additions":8,"deletions":3,"truncated":false},{"path":"pkg/utils/storage_test.go","lines":["@@ -924,3 +924,148 @@ func TestAddModelMount(t *testing.T) {"," \t\tg.Expect(podSpec.Containers[0].VolumeMounts).To(gomega.BeEmpty())"," \t})"," }","+","+func TestAddModelMount_VolumeSource(t *testing.T) {","+\tg := gomega.NewGomegaWithT(t)","+","+\tcontainerName := \"kserve-container\"","+\tmountPath := constants.DefaultModelLocalMountPath","+\tvolumeName := constants.StorageInitializerVolumeName","+","+\tnewPodSpec := func() *corev1.PodSpec {","+\t\treturn &corev1.PodSpec{","+\t\t\tContainers: []corev1.Container{","+\t\t\t\t{Name: containerName},","+\t\t\t},","+\t\t}","+\t}","+","+\tt.Run(\"nil DefaultVolumeSource uses emptyDir\", func(t *testing.T) {","+\t\tpodSpec := newPodSpec()","+\t\terr := AddModelMount(StorageMountParams{","+\t\t\tMountPath:           mountPath,","+\t\t\tVolumeName:          volumeName,","+\t\t\tDefaultVolumeSource: nil,","+\t\t}, containerName, podSpec)","+\t\tg.Expect(err).ToNot(gomega.HaveOccurred())","+\t\tg.Expect(podSpec.Volumes).To(gomega.HaveLen(1))","+\t\tg.Expect(podSpec.Volumes[0].EmptyDir).ToNot(gomega.BeNil(), \"should default to emptyDir\")","+\t\tg.Expect(podSpec.Volumes[0].PersistentVolumeClaim).To(gomega.BeNil())","+\t\tg.Expect(podSpec.Volumes[0].Ephemeral).To(gomega.BeNil())","+\t})","+","+\tt.Run(\"PVCName takes precedence over DefaultVolumeSource\", func(t *testing.T) {","+\t\tpodSpec := newPodSpec()","+\t\tephemeral := &corev1.VolumeSource{","+\t\t\tEphemeral: &corev1.EphemeralVolumeSource{","+\t\t\t\tVolumeClaimTemplate: &corev1.PersistentVolumeClaimTemplate{","+\t\t\t\t\tSpec: corev1.PersistentVolumeClaimSpec{","+\t\t\t\t\t\tAccessModes: []corev1.PersistentVolumeAccessMode{corev1.ReadWriteOnce},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t\terr := AddModelMount(StorageMountParams{","+\t\t\tMountPath:           mountPath,","+\t\t\tVolumeName:          volumeName,","+\t\t\tPVCName:             \"my-pvc\",","+\t\t\tDefaultVolumeSource: ephemeral,","+\t\t}, containerName, podSpec)","+\t\tg.Expect(err).ToNot(gomega.HaveOccurred())","+\t\tg.Expect(podSpec.Volumes).To(gomega.HaveLen(1))","+\t\tg.Expect(podSpec.Volumes[0].PersistentVolumeClaim).ToNot(gomega.BeNil())","+\t\tg.Expect(podSpec.Volumes[0].PersistentVolumeClaim.ClaimName).To(gomega.Equal(\"my-pvc\"))","+\t\tg.Expect(podSpec.Volumes[0].Ephemeral).To(gomega.BeNil())","+\t})","+","+\tt.Run(\"dedicated PVC via PVCName\", func(t *testing.T) {","+\t\tpodSpec := newPodSpec()","+\t\terr := AddModelMount(StorageMountParams{","+\t\t\tMountPath:  mountPath,","+\t\t\tVolumeName: volumeName,","+\t\t\tPVCName:    \"model-cache-pvc\",","+\t\t}, containerName, podSpec)","+\t\tg.Expect(err).ToNot(gomega.HaveOccurred())","+\t\tg.Expect(podSpec.Volumes).To(gomega.HaveLen(1))","+\t\tg.Expect(podSpec.Volumes[0].PersistentVolumeClaim).ToNot(gomega.BeNil())","+\t\tg.Expect(podSpec.Volumes[0].PersistentVolumeClaim.ClaimName).To(gomega.Equal(\"model-cache-pvc\"))","+\t})","+","+\tt.Run(\"ephemeral VolumeClaimTemplate via DefaultVolumeSource\", func(t *testing.T) {","+\t\tpodSpec := newPodSpec()","+\t\tstorageClassName := \"fast-nvme\"","+\t\tephemeral := &corev1.VolumeSource{","+\t\t\tEphemeral: &corev1.EphemeralVolumeSource{","+\t\t\t\tVolumeClaimTemplate: &corev1.PersistentVolumeClaimTemplate{","+\t\t\t\t\tSpec: corev1.PersistentVolumeClaimSpec{","+\t\t\t\t\t\tAccessModes:      []corev1.PersistentVolumeAccessMode{corev1.ReadWriteOnce},","+\t\t\t\t\t\tStorageClassName: &storageClassName,","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t\terr := AddModelMount(StorageMountParams{","+\t\t\tMountPath:           mountPath,","+\t\t\tVolumeName:          volumeName,","+\t\t\tDefaultVo