table for unit tests.","+func baseStorageConfig() *kserveTypes.StorageInitializerConfig {","+\treturn &kserveTypes.StorageInitializerConfig{","+\t\tImage:         \"kserve/storage-initializer:latest\",","+\t\tCpuRequest:    \"100m\",","+\t\tCpuLimit:      \"1\",","+\t\tMemoryRequest: \"256Mi\",","+\t\tMemoryLimit:   \"1Gi\",","+\t}","+}","+","+func findVolume(podSpec *corev1.PodSpec, name string) *corev1.Volume {","+\tfor i := range podSpec.Volumes {","+\t\tif podSpec.Volumes[i].Name == name {","+\t\t\treturn &podSpec.Volumes[i]","+\t\t}","+\t}","+\treturn nil","+}","+","+// TestAttachStorageInitializer_ModelVolumeSource verifies that","+// attachStorageInitializer passes StorageConfig.ModelVolumeSource through to","+// the pod volume, covering all three storage scenarios.","+func TestAttachStorageInitializer_ModelVolumeSource(t *testing.T) {","+\tstorageClassName := \"fast-nvme\"","+","+\ttests := []struct {","+\t\tname              string","+\t\tmodelVolumeSource *corev1.VolumeSource","+\t\tcheckVolume       func(t *testing.T, vol *corev1.Volume)","+\t}{","+\t\t{","+\t\t\tname:              \"nil ModelVolumeSource uses emptyDir\",","+\t\t\tmodelVolumeSource: nil,","+\t\t\tcheckVolume: func(t *testing.T, vol *corev1.Volume) {","+\t\t\t\trequire.NotNil(t, vol.EmptyDir, \"expected emptyDir\")","+\t\t\t\tassert.Nil(t, vol.Ephemeral)","+\t\t\t\tassert.Nil(t, vol.PersistentVolumeClaim)","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"ephemeral VolumeClaimTemplate\",","+\t\t\tmodelVolumeSource: &corev1.VolumeSource{","+\t\t\t\tEphemeral: &corev1.EphemeralVolumeSource{","+\t\t\t\t\tVolumeClaimTemplate: &corev1.PersistentVolumeClaimTemplate{","+\t\t\t\t\t\tSpec: corev1.PersistentVolumeClaimSpec{","+\t\t\t\t\t\t\tAccessModes:      []corev1.PersistentVolumeAccessMode{corev1.ReadWriteOnce},","+\t\t\t\t\t\t\tStorageClassName: &storageClassName,","+\t\t\t\t\t\t\tResources: corev1.VolumeResourceRequirements{","+\t\t\t\t\t\t\t\tRequests: corev1.ResourceList{","+\t\t\t\t\t\t\t\t\tcorev1.ResourceStorage: resource.MustParse(\"50Gi\"),","+\t\t\t\t\t\t\t\t},","+\t\t\t\t\t\t\t},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t\tcheckVolume: func(t *testing.T, vol *corev1.Volume) {","+\t\t\t\trequire.NotNil(t, vol.Ephemeral, \"expected ephemeral volume\")","+\t\t\t\tassert.Nil(t, vol.EmptyDir)","+\t\t\t\tassert.Equal(t, \"fast-nvme\", *vol.Ephemeral.VolumeClaimTemplate.Spec.StorageClassName)","+\t\t\t\tassert.Equal(t, \"50Gi\", vol.Ephemeral.VolumeClaimTemplate.Spec.Resources.Requests.Storage().String())","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"dedicated PVC\",","+\t\t\tmodelVolumeSource: &corev1.VolumeSource{","+\t\t\t\tPersistentVolumeClaim: &corev1.PersistentVolumeClaimVolumeSource{","+\t\t\t\t\tClaimName: \"model-cache-pvc\",","+\t\t\t\t},","+\t\t\t},","+\t\t\tcheckVolume: func(t *testing.T, vol *corev1.Volume) {","+\t\t\t\trequire.NotNil(t, vol.PersistentVolumeClaim, \"expected PVC volume\")","+\t\t\t\tassert.Equal(t, \"model-cache-pvc\", vol.PersistentVolumeClaim.ClaimName)","+\t\t\t\tassert.Nil(t, vol.EmptyDir)","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"per-service override: pre-existing volume is not replaced\",","+\t\t\tmodelVolumeSource: &corev1.VolumeSource{","+\t\t\t\tEphemeral: &corev1.EphemeralVolumeSource{","+\t\t\t\t\tVolumeClaimTemplate: &corev1.PersistentVolumeClaimTemplate{","+\t\t\t\t\t\tSpec: corev1.PersistentVolumeClaimSpec{","+\t\t\t\t\t\t\tAccessModes: []corev1.PersistentVolumeAccessMode{corev1.ReadWriteOnce},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t\tcheckVolume: func(t *testing.T, vol *corev1.Volume) {","+\t\t\t\t// The pod already had a user-defined volume; it must survive unchanged.","+\t\t\t\trequire.NotNil(t, vol.PersistentVolumeClaim, \"user-supplied PVC must be preserved\")","+\t\t\t\tassert.Equal(t, \"user-pvc\", vol.PersistentVolumeClaim.ClaimName)","+\t\t\t\tassert.Nil(t, vol.Ephemeral, \"ModelVolumeSource must not overwrite existing volume\")","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tcfg := baseStorageConfig()","+\t\t\tcfg.ModelVolumeSource = tc.modelVolumeSource","+","+\t\t\tpodSpec := &corev1.PodSpec{","+\t\t\t\tContainers: []corev1.Container{","+\t\t\t\t\t{Name: constants.InferenceServiceContainerName},","+\t\t\t\t},","+\t\t\t}","+","+\t\t\t// For the per-service override test, pre-populate the volume.","+\t\t\tif tc.name == \"per-service override: pre-existing volume is not replaced\" {","+\t\t\t\tpodSpec.Volumes = []corev1.Volume{","+\t\t\t\t\t{","+\t\t\t\t\t\tName: constants.StorageInitializerVolumeName,","+\t\t\t\t\t\tVolumeSource: corev1.VolumeSource{","+\t\t\t\t\t\t\tPersistentVolumeClaim: &corev1.PersistentVolumeClaimVolumeSource{","+\t\t\t\t\t\t\t\tClaimName: \"user-pvc\",","+\t\t\t\t\t\t\t},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tr := &LLMISVCReconciler{}","+\t\t\tllmSvc := &v1alpha2.LLMInferenceService{}","+\t\t\terr := r.attachStorageInitializer(","+\t\t\t\tllmSvc,","+\t\t\t\t\"s3://bucket/model\",","+\t\t\t\tcorev1.PodSpec{},","+\t\t\t\tpodSpec,","+\t\t\t\tcfg,","+\t\t\t\tconstants.InferenceServiceContainerName,","+\t\t\t\tconstants.DefaultModelLocalMountPath,","+\t\t\t)","+\t\t\trequire.NoError(t, err)","+","+\t\t\tvol := findVolume(podSpec, constants.StorageInitializerVolumeName)","+\t\t\trequire.NotNil(t, vol, \"kserve-provision-location volume must be present\")","+\t\t\ttc.checkVolume(t, vol)","+\t\t})","+\t}","+}"],"additions":172,"deletions":0,"truncated":false},{"path":"pkg/types/config.go","lines":["@@ -16,6 +16,8 @@ limitations under the License."," "," package types"," ","+import corev1 \"k8s.io/api/core/v1\"","+"," // OCI model mode constants for OciModelMode field."," const ("," \tOciModelModeModelcar = \"modelcar\"","@@ -47,6 +49,12 @@ type StorageInitializerConfig struct {"," \t// opt-in, never inferred from the registry host. Wired to the init container via"," \t// the KSERVE_OCI_I