y(): Verbosity {"," \t\treturn Verbosity::from($this->output->getVerbosity());"," \t}","+","+\t#[Override]","+\tpublic function progressStart(int $max = 0): void {","+\t\t$this->symfonyStyle->progressStart($max);","+\t}","+","+\t#[Override]","+\tpublic function progressAdvance(int $step = 1): void {","+\t\t$this->symfonyStyle->progressAdvance($step);","+\t}","+","+\t#[Override]","+\tpublic function progressFinish(): void {","+\t\t$this->symfonyStyle->progressFinish();","+\t}","+","+\t#[Override]","+\tpublic function progressIterate(iterable $iterable, ?int $max = null): iterable {","+\t\treturn $this->symfonyStyle->progressIterate($iterable, $max);","+\t}"," }"],"additions":22,"deletions":0,"truncated":false},{"path":"lib/public/Console/IInput.php","lines":["@@ -60,4 +60,108 @@ public function getOption(string $name): string|bool|int|float|array|null;"," \t * @since 35.0.0"," \t */"," \tpublic function hasOption(string $name): bool;","+","+\t/**","+\t * Asks the user to provide some value.","+\t *","+\t * ```","+\t * $input->ask('What is your name?');","+\t * ```","+\t *","+\t * You can pass the default value as the second argument so the user can hit the <Enter> key to select that value:","+\t *","+\t * ```","+\t * $input->ask('Where are you from?', 'United States');","+\t * ```","+\t *","+\t * In case you need to validate the given value, pass a callback validator as the third argument:","+\t *","+\t * ```","+\t * $input->ask('Number of workers to start', '1', function (string $number): int {","+\t *     if (!is_numeric($number)) {","+\t *         throw new \\RuntimeException('You must type a number.');","+\t *     }","+\t *","+\t *     return (int) $number;","+\t * });","+\t * ```","+\t *","+\t * @param callable(string):mixed|null $validator","+\t * @since 35.0.0","+\t */","+\tpublic function ask(string $question, ?string $default = null, ?callable $validator = null): mixed;","+","+\t/**","+\t * Ask the user to provide some value but the user's input will be hidden, and it cannot define a default value.","+\t *","+\t * Use it when asking for sensitive information:","+\t *","+\t * ```","+\t * $input->askHidden('What is your password?');","+\t * ```","+\t *","+\t * In case you need to validate the given value, pass a callback validator as the second argument:","+\t *","+\t * ```","+\t * $input->askHidden('What is your password?', function (string $password): string {","+\t *     if (empty($password)) {","+\t *         throw new \\RuntimeException('Password cannot be empty.');","+\t *     }","+\t *","+\t *     return $password;","+\t * });","+\t * ```","+\t *","+\t * @param callable(string):mixed|null $validator","+\t * @since 35.0.0","+\t */","+\tpublic function askHidden(string $question, ?callable $validator = null): mixed;","+","+\t/**","+\t * Ask a Yes/No question to the user, and it only returns true or false:","+\t *","+\t * ```","+\t * $input->confirm('Restart the web server?');","+\t * ```","+\t *","+\t * You can pass the default value as the second argument so the user can hit the <Enter> key to select that value:","+\t *","+\t * ```","+\t * $input->confirm('Restart the web server?', true);","+\t * ```","+\t *","+\t * @param string $question","+\t * @since 35.0.0","+\t */","+\tpublic function confirm(string $question, bool $default = true): bool;","+","+\t/**","+\t * Ask a question whose answer is constrained to the given list of valid answers:","+\t *","+\t * ```","+\t * $input->choice('Select the queue to analyze', ['queue1', 'queue2', 'queue3']);","+\t * ```","+\t *","+\t * You can pass the default value as the third argument so the user can hit the <Enter> key to select that value:","+\t *","+\t * ```","+\t * $input->choice('Select the queue to analyze', ['queue1', 'queue2', 'queue3'], 'queue1');","+\t * ```","+\t *","+\t * Choice questions display both the choice value and a numeric index, which starts from 0 by default. To use custom indices, pass an array with custom numeric keys as the choice values:","+\t *","+\t * ```","+\t * $input->choice('Select the queue to analyze', [5 => 'queue1', 6 => 'queue2', 7 => 'queue3']);","+\t * ```","+\t *","+\t * Finally, you can allow users to select multiple choices. To do so, users must separate each choice with a comma (e.g. typing 1, 2 will select choice 1 and 2):","+\t *","+\t * ```","+\t * $input->choice('Select the queue to analyze', ['queue1', 'queue2', 'queue3'], multiSelect: true);","+\t * ```","+\t *","+\t * @param array<string> $choices","+\t * @since 35.0.0","+\t */","+\tpublic function choice(string $question, array $choices, mixed $default = null, bool $multiSelect = false): mixed;"," }"],"additions":104,"deletions":0,"truncated":false},{"path":"lib/public/Console/IOutput.php","lines":["@@ -92,4 +92,67 @@ public function writeTableInOutputFormat(array $items): void;"," \t * @since 35.0.0"," \t */"," \tpublic function writeStreamingTableInOutputFormat(\\Iterator $items, int $tableGroupSize): void;","+","+\t/**","+\t * Displays a progress bar with a number of steps equal to the argument passed to the method (don't pass any value if the length of the progress bar is unknown):","+\t *","+\t * ```","+\t * // displays a progress bar of unknown length","+\t * $output->progressStart();","+\t * ```","+\t *","+\t * ```","+\t * // displays a 100-step length progress bar","+\t * $output->progressStart(100);","+\t * ```","+\t * @since 35.0.0","+\t */","+\tpublic function progressStart(int $max = 0): void;","+","+\t/**","+\t * Make the progress bar advance the given number of steps (or 1 step if no argument is passed):","+\t *","+\t * ```","+\t * // advances the progress bar 1 step","+\t * $output->progressAdvance();","+\t * ```","+\t *","+\t * ```","+\t * // advances the progress bar 10 steps","+\t * $output->progressAdvance(10);","+\t * ```","+\t * @since 35.0.0","+\t */","+\tpublic function progressAdvance(int $step = 1): void;","+","+\t/**","+\t * Finish the progress bar (filling up all the remaining steps when its length is known):","+\t *","+\t * ```","+\t * $output->progressFinish();","+\t * ```","+\t * @since 35.0.0","+\t */","+\tpublic function progressFinish(): void;","+","+\t/**","+\t * If your progress bar loops over an iterable collection, use the progressIterate() helper:","+\t *","+\t * ```","+\t * $iterable = [1, 2];","+\t *","+\t * foreach ($output->progressIterate($iterable) as $value) {","+\t *     // ... do some work","+\t * }","+\t * ```","+\t * @template TKey","+\t * @template TValue","+\t *","+\t * @param iterable<TKey, TValue> $iterable","+\t * @param int|null $max Number of steps to complete the bar (0 if indeterminate), if null it will be inferred from $iterable","+\t *","+\t * @return iterable<TKey, TValue>","+\t * @since 35.0.0","+\t */","+\tpublic function progressIterate(iterable $iterable, ?int $max = null): iterable;"," }",""],"additions":63,"deletions":0,"truncated":false}],"additions":300,"deletions":2,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-08-12T09:21:25.932241+00:00"}