","+        const {pageSize} = scope.run(() => usePageSize(computed(() => 100)))!","+","+        expect(pageSize.value).toBe(100)","+    })","+","+    it(\"uses the remembered size when the URL size is missing\", async () => {","+        const {pageSize, rememberPageSize} = scope.run(() => usePageSize(computed(() => undefined), 25))!","+","+        rememberPageSize(100)","+","+        expect(pageSize.value).toBe(100)","+        await nextTick()","+        expect(localStorage.getItem(storageKeys.PAGINATION_SIZE)).toBe(\"100\")","+    })","+","+    it.each([\"\", \"invalid\"])(\"uses the default size when the saved value is %j\", (savedSize) => {","+        localStorage.setItem(storageKeys.PAGINATION_SIZE, savedSize)","+        const {pageSize} = scope.run(() => usePageSize(computed(() => undefined), 40))!","+","+        expect(pageSize.value).toBe(40)","+    })","+})"],"additions":38,"deletions":0,"truncated":false},{"path":"ui/src/composables/usePageSize.ts","lines":["@@ -0,0 +1,14 @@","+import {computed, type ComputedRef} from \"vue\"","+import {useStorage} from \"@vueuse/core\"","+import {storageKeys} from \"../utils/constants\"","+","+export function usePageSize(querySize: ComputedRef<unknown>, defaultSize = 25) {","+    const savedSize = useStorage(storageKeys.PAGINATION_SIZE, defaultSize, undefined, {writeDefaults: false})","+    const pageSize = computed(() => Number(querySize.value) || savedSize.value || defaultSize)","+","+    function rememberPageSize(size: number) {","+        savedSize.value = size","+    }","+","+    return {pageSize, rememberPageSize}","+}",""],"additions":14,"deletions":0,"truncated":false}],"additions":93,"deletions":11,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-09T17:51:47.276799+00:00"}