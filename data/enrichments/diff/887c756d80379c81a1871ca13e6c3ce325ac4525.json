{"id":"887c756d80379c81a1871ca13e6c3ce325ac4525","axis":"silent","repo":"salvo-rs/salvo","sha":"887c756d80379c81a1871ca13e6c3ce325ac4525","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -55,6 +55,9 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)."," - Extract tuple `ToParameters` fields in declaration order and honor field sources","   and renames, including serde defaults for absent tuple fields."," - Restore stateless crafted handlers and endpoints in generic service impls.","+","+- Skip blank values in the form, query and cookie JWT finders, so they no longer hide a","+  token that a later finder would return."," - Serve only the committed TUS upload prefix and retain read locks while","   streamed downloads use the file."," "],"additions":3,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/src/finder.rs","lines":["@@ -239,13 +239,20 @@ impl JwtTokenFinder for FormFinder {","             .as_ref()","             .is_none_or(|methods| methods.contains(req.method()))","         {","-            req.form(&self.field_name).await","+            non_blank(req.form(&self.field_name).await)","         } else {","             None","         }","     }"," }"," ","+/// A blank value is not a token. Returning it would stop `JwtAuth` from asking","+/// the finders after this one, as [`HeaderFinder`] already avoids for an empty","+/// `Bearer` credential.","+fn non_blank(token: Option<String>) -> Option<String> {","+    token.filter(|token| !token.trim().is_empty())","+}","+"," /// Extracts JWT tokens from URL query parameters."," ///"," /// This finder looks for a token in the request's query string using a specified parameter name.","@@ -322,7 +329,7 @@ impl JwtTokenFinder for QueryFinder {","             .as_ref()","             .is_none_or(|methods| methods.contains(req.method()))","         {","-            req.query(&self.query_name)","+            non_blank(req.query(&self.query_name))","         } else {","             None","         }","@@ -404,7 +411,7 @@ impl JwtTokenFinder for CookieFinder {","             .as_ref()","             .is_none_or(|methods| methods.contains(req.method()))","         {","-            req.cookie(&self.cookie_name).map(|c| c.value().to_owned())","+            non_blank(req.cookie(&self.cookie_name).map(|c| c.value().to_owned()))","         } else {","             None","         }"],"additions":10,"deletions":3,"truncated":false},{"path":"crates/jwt-auth/src/lib.rs","lines":["@@ -553,6 +553,63 @@ mod tests {","         encode_test_token(&claim, &EncodingKey::from_secret(secret))","     }"," ","+    #[tokio::test]","+    async fn blank_token_does_not_hide_a_later_finder() {","+        #[handler]","+        async fn hello() -> &'static str {","+            \"hello\"","+        }","+","+        let auth: JwtAuth<JwtClaims, _> = JwtAuth::new(ConstDecoder::from_secret(b\"secret\"))","+            .finders(vec![","+                Box::new(QueryFinder::new(\"jwt\")),","+                Box::new(CookieFinder::new(\"jwt\")),","+                Box::new(HeaderFinder::new()),","+            ]);","+        let service = Service::new(Router::new().hoop(auth).goal(hello));","+        let token = create_test_token(b\"secret\", 1);","+","+        for (url, cookie, bearer, expected) in [","+            (\"http://localhost/\", None, true, StatusCode::OK),","+            (\"http://localhost/?jwt=\", None, true, StatusCode::OK),","+            (\"http://localhost/\", Some(\"jwt=\"), true, StatusCode::OK),","+            // Without any token the request is unauthenticated, not forbidden.","+            (","+                \"http://localhost/?jwt=\",","+                None,","+                false,","+                StatusCode::UNAUTHORIZED,","+            ),","+            (","+                \"http://localhost/\",","+                Some(\"jwt=\"),","+                false,","+                StatusCode::UNAUTHORIZED,","+            ),","+            (\"http://localhost/\", None, false, StatusCode::UNAUTHORIZED),","+            // A non-blank value is still a token and is not retried elsewhere.","+            (","+                \"http://localhost/?jwt=invalid\",","+                None,","+                true,","+                StatusCode::FORBIDDEN,","+            ),","+        ] {","+            let mut request = TestClient::get(url);","+            if let Some(cookie) = cookie {","+                request = request.add_header(\"cookie\", cookie, true);","+            }","+            if bearer {","+                request = request.add_header(\"authorization\", format!(\"Bearer {token}\"), true);","+            }","+            assert_eq!(","+                request.send(&service).await.status_code,","+                Some(expected),","+                \"{url} cookie={cookie:?} bearer={bearer}\"","+            );","+        }","+    }","+","     #[tokio::test]","     async fn repeated_authentication_replaces_all_depot_state() {","         #[handler]"],"additions":57,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/tests/finder_methods.rs","lines":["@@ -146,3 +146,24 @@ fn default_settings_are_unrestricted() {","     assert_eq!(CookieFinder::default(), CookieFinder::new(\"\"));","     assert_eq!(FormFinder::default(), FormFinder::new(\"\"));"," }","+","+#[tokio::test]","+async fn blank_values_are_not_tokens() {","+    for value in [\"\", \"%20\", \"+\"] {","+        let mut request = RequestBuilder::new(","+            format!(\"http://localhost/?access_token={value}\"),","+            Method::POST,","+        )","+        .add_header(\"authorization\", \"Bearer \", true)","+        .add_header(\"cookie\", \"access_token=\", true)","+        .raw_form(format!(\"access_token={value}\"))","+        .build();","+        for finder in default_finders() {","+            assert_eq!(","+                finder.find_token(&mut request).await,","+                None,","+                \"blank value {value:?} must not be returned as a token\"","+            );","+        }","+    }","+}",""],"additions":21,"deletions":0,"truncated":false}],"additions":91,"deletions":3,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-15T15:51:45.720103+00:00"}