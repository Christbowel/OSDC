{"id":"GHSA-x6mj-8jx9-qhqv","axis":"advisories","repo":"rails/rails","sha":"0e6cf8faa89caf4c64311d35ca2bc88c1458d4e3","parsed":{"files":[{"path":"actionpack/CHANGELOG.md","lines":["@@ -1,3 +1,19 @@","+*   Don't write upgraded cookies to a response that skips the session.","+","+    Reading a signed or encrypted cookie written under a rotated secret, or in","+    the format a `:hybrid` serializer migrates from, writes it back in the","+    current format. That write ignored `request.session_options[:skip]`, so a","+    response that skips the session, such as the Active Storage proxy's","+    public, cacheable response, could still carry the session cookie in","+    `Set-Cookie`. Such a response now leaves the cookie unchanged, and a later","+    request that does not skip the session upgrades it. An application that","+    skips the session on every request no longer upgrades its signed or","+    encrypted cookies. Cookies the application sets are still written.","+","+    [GHSA-x6mj-8jx9-qhqv]","+","+    *Mike Dalessio*","+"," *   `ActionController::Parameters#each_key` returns `self` when given a block."," ","     It returned the internal `ActiveSupport::HashWithIndifferentAccess`, which"],"additions":16,"deletions":0,"truncated":false},{"path":"actionpack/lib/action_dispatch/middleware/cookies.rb","lines":["@@ -324,6 +324,7 @@ def self.build(req, cookies)","       def initialize(request)","         @set_cookies = {}","         @delete_cookies = {}","+        @upgraded_cookies = Set.new","         @request = request","         @cookies = {}","         @committed = false","@@ -386,6 +387,7 @@ def []=(name, options)","         end"," ","         handle_options(options)","+        @upgraded_cookies.delete(name.to_s)"," ","         if @cookies[name.to_s] != value || options[:expires]","           @cookies[name.to_s] = value","@@ -426,8 +428,14 @@ def clear(options = {})","         @cookies.each_key { |k| delete(k, options) }","       end"," ","+      def upgraded(name)","+        @upgraded_cookies << name.to_s","+      end","+","       def write(response)","         @set_cookies.each do |name, value|","+          next if @upgraded_cookies.include?(name) && request.session_options[:skip]","+","           if write_cookie?(value)","             response.set_cookie(name, value)","           end","@@ -533,6 +541,10 @@ def []=(name, options)","         @parent_jar[name] = options","       end"," ","+      def upgraded(name)","+        @parent_jar.upgraded(name)","+      end","+","       protected","         def request; @parent_jar.request; end"," ","@@ -599,7 +611,10 @@ def parse(name, dumped, force_reserialize: false, **)","               return","             end"," ","-            self[name] = { value: value } if force_reserialize || reserialize?(dumped)","+            if force_reserialize || reserialize?(dumped)","+              self[name] = { value: value }","+              upgraded(name)","+            end"," ","             value","           end"],"additions":16,"deletions":1,"truncated":false},{"path":"actionpack/test/dispatch/cookies_test.rb","lines":["@@ -208,6 +208,37 @@ def get_encrypted_cookie","       head :ok","     end"," ","+    def get_signed_cookie_with_session_skipped","+      request.session_options[:skip] = true","+      cookies.signed[:user_id]","+      head :ok","+    end","+","+    def get_encrypted_cookie_with_session_skipped","+      request.session_options[:skip] = true","+      cookies.encrypted[:foo]","+      head :ok","+    end","+","+    def get_signed_cookie_before_skipping_session","+      cookies.signed[:user_id]","+      request.session_options[:skip] = true","+      head :ok","+    end","+","+    def reset_signed_cookie_with_session_skipped","+      request.session_options[:skip] = true","+      cookies.signed[:user_id]","+      cookies.signed[:user_id] = 46","+      head :ok","+    end","+","+    def set_signed_cookie_with_session_skipped","+      request.session_options[:skip] = true","+      cookies.signed[:user_id] = 45","+      head :ok","+    end","+","     def set_invalid_encrypted_cookie","       cookies[:invalid_cookie] = \"invalid--9170e00a57cfc27083363b5c75b835e477bd90cf\"","       head :ok","@@ -1188,6 +1219,80 @@ def test_encrypted_cookie_rotating_secret","     assert_equal 45, encryptor.decrypt_and_verify(@response.cookies[\"foo\"])","   end"," ","+  def test_signed_cookie_rotating_secret_is_not_rewritten_when_session_is_skipped","+    secret = \"b3c631c314c0bbca50c1b2843150fe33\"","+","+    @request.env[\"action_dispatch.signed_cookie_digest\"] = \"SHA256\"","+    @request.env[\"action_dispatch.cookies_rotations\"].rotate :signed, secret, digest: \"SHA1\"","+","+    old_message = ActiveSupport::MessageVerifier.new(secret, digest: \"SHA1\", serializer: Marshal).generate(45)","+    @request.headers[\"Cookie\"] = \"user_id=#{old_message}\"","+","+    get :get_signed_cookie_with_session_skipped","+    assert_equal 45, @controller.send(:cookies).signed[:user_id]","+    assert_nil @response.headers[\"Set-Cookie\"]","+  end","+","+  def test_signed_cookie_read_before_the_session_is_skipped_is_not_rewritten","+    secret = \"b3c631c314c0bbca50c1b2843150fe33\"","+","+    @request.env[\"action_dispatch.signed_cookie_digest\"] = \"SHA256\"","+    @request.env[\"action_dispatch.cookies_rotations\"].rotate :signed, secret, digest: \"SHA1\"","+","+    old_message = ActiveSupport::MessageVerifier.new(secret, digest: \"SHA1\", serializer: Marshal).generate(45)","+    @request.headers[\"Cookie\"] = \"user_id=#{old_message}\"","+","+    get :get_signed_cookie_before_skipping_session","+    assert_nil @response.headers[\"Set-Cookie\"]","+  end","+","+  def test_rotated_signed_cookie_set_after_reading_is_written_when_session_is_skipped","+    secret = \"b3c631c314c0bbca50c1b2843150fe33\"","+","+    @request.env[\"action_dispatch.signed_cookie_digest\"] = \"SHA256\"","+    @request.env[\"action_dispatch.cookies_rotations\"].rotate :signed, secret, digest: \"SHA1\"","+","+    old_message = ActiveSupport::MessageVerifier.new(secret, digest: \"SHA1\", serializer: Marshal).generate(45)","+    @request.headers[\"Cookie\"] = \"user_id=#{old_message}\"","+","+    get :reset_signed_cookie_with_session_skipped","+    assert_equal 46, @controller.send(:cookies).signed[:user_id]","+    assert_not_nil @response.cookies[\"user_id\"]","+  end","+","+  def test_encrypted_cookie_rotating_secret_is_not_rewritten_when_session_is_skipped","+    secret = \"b3c631c314c0bbca50c1b2843150fe33\"","+","+    @request.env[\"action_dispatch.encrypted_cookie_cipher\"] = \"aes-256-gcm\"","+    @request.env[\"action_dispatch.cookies_rotations\"].rotate :encrypted, secret, digest: \"SHA1\"","+","+    old_message = ActiveSupport::MessageEncryptor.new(secret, cipher: \"aes-256-gcm\", serializer: Marshal).encrypt_and_sign(45)","+    @request.headers[\"Cookie\"] = \"foo=#{::Rack::Utils.escape old_message}\"","+","+    get :get_encrypted_cookie_with_session_skipped","+    assert_equal 45, @controller.send(:cookies).encrypted[:foo]","+    assert_nil @response.headers[\"Set-Cookie\"]","+  end","+","+  def test_encrypted_cookie_using_hybrid_serializer_is_not_rewritten_when_session_is_skipped","+    @request.env[\"action_dispatch.cookies_serializer\"] = :hybrid","+","+    secret = @request.env[\"action_dispatch.key_generator\"].generate_key(@request.env[\"action_dispatch.authenticated_encrypted_cookie_salt\"], 32)","+","+    marshal_value = ActiveSupport::MessageEncryptor.new(secret, cipher: \"aes-256-gcm\", serializer: Marshal).encrypt_and_sign(\"bar\")","+    @request.headers[\"Cookie\"] = \"foo=#{::Rack::Utils.escape marshal_value}\"","+","+    get :get_encrypted_cookie_with_session_skipped","+    assert_equal \"bar\", @controller.send(:cookies).encrypted[:foo]","+    assert_nil @response.headers[\"Set-Cookie\"]","+  end","+","+  def test_signed_cookie_is_set_when_session_is_skipped","+    get :set_signed_cookie_with_session_skipped","+    assert_equal 45, @controller.send(:cookies).signed[:user_id]","+    assert_not_nil @response.cookies[\"user_id\"]","+  end","+","   def test_cookie_with_hash_value_not_modified_by_rotation","     @request.env[\"action_dispatch.signed_cookie_digest\"] = \"SHA256\"","     @request.env[\"action_dispatch.cookies_rotations\"].rotate :signed, digest: \"SHA1\""],"additions":105,"deletions":0,"truncated":false},{"path":"activestorage/test/controllers/blobs/proxy_controller_test.rb","lines":["@@ -151,6 +151,26 @@ class ActiveStorage::Blobs::ProxyControllerTest < ActionDispatch::IntegrationTes","     assert_instance_of ActionController::Live::Response, ActiveStorage::Blobs::ProxyController.make_response!(request)","   end"," ","+  test \"a session cookie under a rotated secret is not rewritten\" do","+    old_key_generator = ActiveSupport::KeyGenerator.new(\"old secret key base\", iterations: 1000)","+    old_secret = old_key_generator.generate_key(\"authenticated encrypted cookie\", 32)","+    session_key = Rails.application.config.session_options[:key]","+","+    old_cookie_jar = ActionDispatch::Request.new(Rails.application.env_config.merge(\"action_dispatch.key_generator\" => old_key_generator)).cookie_jar","+    old_cookie_jar.encrypted[session_key] = { value: { \"session_id\" => SecureRandom.hex(16) } }","+","+    rotations = ActiveSupport::Messages::RotationConfiguration.new","+    rotations.rotate :encrypted, old_secret","+","+    with_env_config(\"action_dispatch.cookies_rotations\" => rotations) do","+      get rails_storage_proxy_url(create_file_blob(filename: \"racecar.jpg\")),","+        headers: { \"Cookie\" => \"#{session_key}=#{Rack::Utils.escape(old_cookie_jar[session_key])}\" }","+    end","+","+    assert_response :success","+    assert_nil response.headers[\"Set-Cookie\"]","+  end","+","   private","     def with_streaming_chunk_max_size(size)","       old_size = ActiveStorage.streaming_chunk_max_size","@@ -159,6 +179,15 @@ def with_streaming_chunk_max_size(size)","     ensure","       ActiveStorage.streaming_chunk_max_size = old_size","     end","+","+    def with_env_config(overrides)","+      env_config = Rails.application.env_config","+      original = env_config.slice(*overrides.keys)","+      env_config.merge!(overrides)","+      yield","+    ensure","+      env_config.except!(*overrides.keys).merge!(original)","+    end"," end"," "," class ActiveStorage::Blobs::ExpiringProxyControllerTest < ActionDispatch::IntegrationTest",""],"additions":29,"deletions":0,"truncated":false}],"additions":166,"deletions":1,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-13T17:02:31.342782+00:00"}