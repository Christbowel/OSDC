{"id":"13a2501afa0b636adc86c4e0f91ec6b0557f7a27","axis":"silent","repo":"expo/expo","sha":"13a2501afa0b636adc86c4e0f91ec6b0557f7a27","parsed":{"files":[{"path":"apps/bare-expo/ios/Podfile.lock","lines":["@@ -509,6 +509,8 @@ PODS:","     - React-RCTImage","   - ExpoMediaSession (58.0.0):","     - ExpoModulesCore","+  - ExpoMediaSession/Tests (58.0.0):","+    - ExpoModulesCore","   - ExpoMeshGradient (58.0.3):","     - ExpoModulesCore","   - ExpoModulesCore (58.0.26):","@@ -3730,6 +3732,7 @@ DEPENDENCIES:","   - ExpoMediaLibrary/Tests (from `../../../packages/expo-media-library/ios`)","   - ExpoMediaLibraryImageLoader (from `../../../packages/expo-media-library`)","   - ExpoMediaSession (from `../../../packages/expo-media-session/ios`)","+  - ExpoMediaSession/Tests (from `../../../packages/expo-media-session/ios`)","   - ExpoMeshGradient (from `../../../packages/expo-mesh-gradient/ios`)","   - ExpoModulesCore (from `../../../packages/expo-modules-core`)","   - ExpoModulesCore/Benchmarks (from `../../../packages/expo-modules-core`)","@@ -4470,7 +4473,7 @@ SPEC CHECKSUMS:","   ExpoMaps: 56acbfda3c93f738b9c7d4c54af4b4058cdd7ecf","   ExpoMediaLibrary: 7e70cbd590acc2b1a21f486ade3134890197b184","   ExpoMediaLibraryImageLoader: 6131955b7bbc3f9ce4c4c97cec9b1b6455a7828d","-  ExpoMediaSession: 12a818e0841291755b0429e1d66ff165c6358e08","+  ExpoMediaSession: 12fe9246f2363bb513dc9564d09e8ba02ab4c77f","   ExpoMeshGradient: 778fd9893abcff50f3861e13c8768c8442e6cb78","   ExpoModulesCore: db285f1afd687fdd0a6979b38d8bc6c606248c31","   ExpoModulesJSI: d9f7f7a1625c1a29cb116a6c264f1752230d4783"],"additions":4,"deletions":1,"truncated":false},{"path":"packages/expo-media-session/Package.swift","lines":["@@ -22,7 +22,7 @@ let package = Package(","         .product(name: \"ExpoModulesCoreHeaders\", package: \"ExpoModulesCoreHeaders\")","       ],","       path: \"ios\",","-      exclude: [\"ExpoMediaSession.podspec\"]","+      exclude: [\"ExpoMediaSession.podspec\", \"Tests\"]","     )","   ],","   swiftLanguageModes: [.v6]"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/expo-media-session/android/src/main/java/expo/modules/mediasession/AudioPolicy.kt","lines":["@@ -0,0 +1,134 @@","+package expo.modules.mediasession","+","+import io.github.expo.modules.v2.Enumerable","+import java.util.Objects","+","+enum class InterruptionMode(val value: String) : Enumerable {","+  MIX_WITH_OTHERS(\"mixWithOthers\"),","+  DO_NOT_MIX(\"doNotMix\"),","+  DO_NOT_MIX_PERSISTENT(\"doNotMixPersistent\"),","+  DUCK_OTHERS(\"duckOthers\");","+","+  val preventsMixing: Boolean","+    get() = this == DO_NOT_MIX || this == DO_NOT_MIX_PERSISTENT","+","+  val notifiesOthersOnDeactivation: Boolean","+    get() = this != DO_NOT_MIX_PERSISTENT","+}","+","+enum class MixingRequirement(val value: String) : Enumerable {","+  MIX_WITH_OTHERS(\"mixWithOthers\"),","+  DUCK_OTHERS(\"duckOthers\"),","+  DO_NOT_MIX(\"doNotMix\")","+}","+","+@JvmInline","+value class SessionCapability private constructor(val raw: String) {","+  companion object {","+    val RECORD = SessionCapability(\"record\")","+    val MEASUREMENT = SessionCapability(\"measurement\")","+  }","+}","+","+class AudioPolicy(","+  val playsInSilentMode: Boolean = true,","+  val interruptionMode: InterruptionMode = InterruptionMode.MIX_WITH_OTHERS,","+  val allowsRecording: Boolean = false,","+  val shouldRouteThroughEarpiece: Boolean = false","+) {","+  fun copy(","+    playsInSilentMode: Boolean = this.playsInSilentMode,","+    interruptionMode: InterruptionMode = this.interruptionMode,","+    allowsRecording: Boolean = this.allowsRecording,","+    shouldRouteThroughEarpiece: Boolean = this.shouldRouteThroughEarpiece","+  ) = AudioPolicy(","+    playsInSilentMode = playsInSilentMode,","+    interruptionMode = interruptionMode,","+    allowsRecording = allowsRecording,","+    shouldRouteThroughEarpiece = shouldRouteThroughEarpiece","+  )","+","+  fun merged(update: AudioPolicyUpdate) = copy(","+    playsInSilentMode = update.playsInSilentMode ?: playsInSilentMode,","+    interruptionMode = update.interruptionMode ?: interruptionMode,","+    allowsRecording = update.allowsRecording ?: allowsRecording,","+    shouldRouteThroughEarpiece = update.shouldRouteThroughEarpiece ?: shouldRouteThroughEarpiece","+  )","+","+  override fun equals(other: Any?) =","+    other is AudioPolicy &&","+      other.playsInSilentMode == playsInSilentMode &&","+      other.interruptionMode == interruptionMode &&","+      other.allowsRecording == allowsRecording &&","+      other.shouldRouteThroughEarpiece == shouldRouteThroughEarpiece","+","+  override fun hashCode() =","+    Objects.hash(playsInSilentMode, interruptionMode, allowsRecording, shouldRouteThroughEarpiece)","+","+  override fun toString() =","+    \"AudioPolicy(playsInSilentMode=$playsInSilentMode, interruptionMode=$interruptionMode, \" +","+      \"allowsRecording=$allowsRecording, \" +","+      \"shouldRouteThroughEarpiece=$shouldRouteThroughEarpiece)\"","+","+  companion object {","+    val DEFAULT = AudioPolicy()","+  }","+}","+","+class AudioPolicyUpdate(","+  val playsInSilentMode: Boolean? = null,","+  val interruptionMode: InterruptionMode? = null,","+  val allowsRecording: Boolean? = null,","+  val shouldRouteThroughEarpiece: Boolean? = null","+) {","+  override fun equals(other: Any?) =","+    other is AudioPolicyUpdate &&","+      other.playsInSilentMode == playsInSilentMode &&","+      other.interruptionMode == interruptionMode &&","+      other.allowsRecording == allowsRecording &&","+      other.shouldRouteThroughEarpiece == shouldRouteThroughEarpiece","+","+  override fun hashCode() =","+    Objects.hash(playsInSilentMode, interruptionMode, allowsRecording, shouldRouteThroughEarpiece)","+","+  override fun toString() =","+    \"AudioPolicyUpdate(playsInSilentMode=$playsInSilentMode, interruptionMode=$interruptionMode, \" +","+      \"allowsRecording=$allowsRecording, \" +","+      \"shouldRouteThroughEarpiece=$shouldRouteThroughEarpiece)\"","+}","+","+class SessionRequirements(","+  val mixing: MixingRequirement? = null,","+  val capabilities: Set<SessionCapability> = emptySet(),","+  val usage: Int? = null,","+  val contentType: Int? = null,","+  val pausesWhenDucked: Boolean = false","+) {","+  fun copy(","+    mixing: MixingRequirement? = this.mixing,","+    capabilities: Set<SessionCapability> = this.capabilities,","+    usage: Int? = this.usage,","+    contentType: Int? = this.contentType,","+    pausesWhenDucked: Boolean = this.pausesWhenDucked","+  ) = SessionRequirements(","+    mixing = mixing,","+    capabilities = capabilities,","+    usage = usage,","+    contentType = contentType,","+    pausesWhenDucked = pausesWhenDucked","+  )","+","+  override fun equals(other: Any?) =","+    other is SessionRequirements &&","+      other.mixing == mixing &&","+      other.capabilities == capabilities &&","+      other.usage == usage &&","+      other.contentType == contentType &&","+      other.pausesWhenDucked == pausesWhenDucked","+","+  override fun hashCode() = Objects.hash(mixing, capabilities, usage, contentType, pausesWhenDucked)","+","+  override fun toString() =","+    \"SessionRequirements(mixing=$mixing, capabilities=$capabilities, usage=$usage, \" +","+      \"contentType=$contentType, pausesWhenDucked=$pausesWhenDucked)\"","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/android/src/main/java/expo/modules/mediasession/AudioPolicyMapping.kt","lines":["@@ -0,0 +1,113 @@","+package expo.modules.mediasession","+","+import android.media.AudioAttributes","+import android.media.AudioManager","+import java.util.Objects","+","+class FocusSpec(","+  val gain: Int,","+  val usage: Int = AudioAttributes.USAGE_MEDIA,","+  val contentType: Int = AudioAttributes.CONTENT_TYPE_MUSIC,","+  val acceptsDelayedFocusGain: Boolean = true,","+  val pausesWhenDucked: Boolean = false","+) {","+  fun copy(","+    gain: Int = this.gain,","+    usage: Int = this.usage,","+    contentType: Int = this.contentType,","+    acceptsDelayedFocusGain: Boolean = this.acceptsDelayedFocusGain,","+    pausesWhenDucked: Boolean = this.pausesWhenDucked","+  ) = FocusSpec(","+    gain = gain,","+    usage = usage,","+    contentType = contentType,","+    acceptsDelayedFocusGain = acceptsDelayedFocusGain,","+    pausesWhenDucked = pausesWhenDucked","+  )","+","+  override fun equals(other: Any?) =","+    other is FocusSpec &&","+      other.gain == gain &&","+      other.usage == usage &&","+      other.contentType == contentType &&","+      other.acceptsDelayedFocusGain == acceptsDelayedFocusGain &&","+      other.pausesWhenDucked == pausesWhenDucked","+","+  override fun hashCode() = Objects.hash(gain, usage, contentType, acceptsDelayedFocusGain, pausesWhenDucked)","+","+  override fun toString() =","+    \"FocusSpec(gain=$gain, usage=$usage, contentType=$contentType, \" +","+      \"acceptsDelayedFocusGain=$acceptsDelayedFocusGain, pausesWhenDucked=$pausesWhenDucked)\"","+}","+","+class ResolvedSession internal constructor(","+  val interruptionMode: InterruptionMode,","+  val focus: FocusSpec?","+) {","+  override fun equals(other: Any?) =","+    other is ResolvedSession && other.interruptionMode == interruptionMode && other.focus == focus","+","+  override fun hashCode() = Objects.hash(interruptionMode, focus)","+","+  override fun toString() = \"ResolvedSession(interruptionMode=$interruptionMode, focus=$focus)\"","+}","+","+object SessionResolver {","+  fun resolve(policy: AudioPolicy, requirements: List<SessionRequirements>): ResolvedSession {","+    val mode = requirements","+      .mapNotNull { it.mixing?.interruptionMode }","+      .fold(policy.interruptionMode) { strictest, candidate ->","+        if (candidate.mixingRank > strictest.mixingRank) {","+          candidate","+        } else {","+          strictest","+        }","+      }","+","+    val focus = focusGain(mode)?.let { gain ->","+      FocusSpec(","+        gain = gain,","+        usage = requirements.mapNotNull { it.usage }.maxByOrNull(::usageRank) ?: AudioAttributes.USAGE_MEDIA,","+        contentType = requirements.mapNotNull { it.contentType }.maxByOrNull(::contentTypeRank)","+          ?: AudioAttributes.CONTENT_TYPE_MUSIC,","+        pausesWhenDucked = requirements.any { it.pausesWhenDucked }","+      )","+    }","+    return ResolvedSession(mode, focus)","+  }","+","+  private fun focusGain(mode: InterruptionMode): Int? = when (mode) {","+    InterruptionMode.DO_NOT_MIX_PERSISTENT -> AudioManager.AUDIOFOCUS_GAIN","+    InterruptionMode.DO_NOT_MIX -> AudioManager.AUDIOFOCUS_GAIN_TRANSIENT","+    InterruptionMode.DUCK_OTHERS -> AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK","+    InterruptionMode.MIX_WITH_OTHERS -> null","+  }","+","+  private fun usageRank(usage: Int): Int = when (usage) {","+    AudioAttributes.USAGE_VOICE_COMMUNICATION -> 2","+    AudioAttributes.USAGE_MEDIA -> 0","+    else -> 1","+  }","+","+  private fun contentTypeRank(contentType: Int): Int = when (contentType) {","+    AudioAttributes.CONTENT_TYPE_SPEECH -> 3","+    AudioAttributes.CONTENT_TYPE_MOVIE -> 2","+    AudioAttributes.CONTENT_TYPE_MUSIC -> 1","+    else -> 0","+  }","+","+  private val InterruptionMode.mixingRank: Int","+    get() = when (this) {","+      InterruptionMode.DO_NOT_MIX_PERSISTENT -> 3","+      InterruptionMode.DO_NOT_MIX -> 2","+      InterruptionMode.DUCK_OTHERS -> 1","+      InterruptionMode.MIX_WITH_OTHERS -> 0","+    }","+","+  private val MixingRequirement.interruptionMode: InterruptionMode","+    get() = when (this) {","+      MixingRequirement.DO_NOT_MIX -> InterruptionMode.DO_NOT_MIX","+      MixingRequirement.DUCK_OTHERS -> InterruptionMode.DUCK_OTHERS","+      MixingRequirement.MIX_WITH_OTHERS -> InterruptionMode.MIX_WITH_OTHERS","+    }","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/android/src/test/java/expo/modules/mediasession/AudioPolicyMappingTest.kt","lines":["@@ -0,0 +1,92 @@","+package expo.modules.mediasession","+","+import android.media.AudioAttributes","+import android.media.AudioManager","+import org.junit.Assert.assertEquals","+import org.junit.Assert.assertFalse","+import org.junit.Assert.assertNull","+import org.junit.Assert.assertTrue","+import org.junit.Test","+","+class AudioPolicyMappingTest {","+  private fun resolve(policy: AudioPolicy, vararg requirements: SessionRequirements) =","+    SessionResolver.resolve(policy, requirements.toList())","+","+  private fun gain(mode: InterruptionMode) = resolve(AudioPolicy(interruptionMode = mode)).focus?.gain","+","+  @Test","+  fun defaultPolicyIsMixWithOthers() {","+    assertEquals(InterruptionMode.MIX_WITH_OTHERS, AudioPolicy.DEFAULT.interruptionMode)","+    assertEquals(true, AudioPolicy.DEFAULT.playsInSilentMode)","+    assertNull(resolve(AudioPolicy.DEFAULT).focus)","+  }","+","+  @Test","+  fun focusGainTable() {","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN, gain(InterruptionMode.DO_NOT_MIX_PERSISTENT))","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT, gain(InterruptionMode.DO_NOT_MIX))","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK, gain(InterruptionMode.DUCK_OTHERS))","+    assertNull(gain(InterruptionMode.MIX_WITH_OTHERS))","+  }","+","+  @Test","+  fun requirementOnlyTightensMixing() {","+    val persistent = resolve(","+      AudioPolicy(interruptionMode = InterruptionMode.DO_NOT_MIX_PERSISTENT),","+      SessionRequirements(mixing = MixingRequirement.DO_NOT_MIX)","+    )","+    assertEquals(InterruptionMode.DO_NOT_MIX_PERSISTENT, persistent.interruptionMode)","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN, persistent.focus?.gain)","+","+    val mixing = resolve(","+      AudioPolicy.DEFAULT,","+      SessionRequirements(mixing = MixingRequirement.MIX_WITH_OTHERS),","+      SessionRequirements(mixing = MixingRequirement.DO_NOT_MIX)","+    )","+    assertEquals(InterruptionMode.DO_NOT_MIX, mixing.interruptionMode)","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT, mixing.focus?.gain)","+","+    val ducking = AudioPolicy(interruptionMode = InterruptionMode.DUCK_OTHERS)","+    assertEquals(","+      InterruptionMode.DUCK_OTHERS,","+      resolve(ducking, SessionRequirements(mixing = MixingRequirement.MIX_WITH_OTHERS)).interruptionMode","+    )","+    assertEquals(InterruptionMode.DUCK_OTHERS, resolve(ducking).interruptionMode)","+  }","+","+  @Test","+  fun notifyOthersOnDeactivation() {","+    assertFalse(InterruptionMode.DO_NOT_MIX_PERSISTENT.notifiesOthersOnDeactivation)","+    assertTrue(InterruptionMode.DO_NOT_MIX.notifiesOthersOnDeactivation)","+    assertTrue(InterruptionMode.DUCK_OTHERS.notifiesOthersOnDeactivation)","+    assertTrue(InterruptionMode.MIX_WITH_OTHERS.notifiesOthersOnDeactivation)","+  }","+","+  @Test","+  fun focusAttributes() {","+    val exclusive = AudioPolicy(interruptionMode = InterruptionMode.DO_NOT_MIX)","+    assertEquals(","+      FocusSpec(","+        gain = AudioManager.AUDIOFOCUS_GAIN_TRANSIENT,","+        usage = AudioAttributes.USAGE_MEDIA,","+        contentType = AudioAttributes.CONTENT_TYPE_MUSIC,","+        acceptsDelayedFocusGain = true,","+        pausesWhenDucked = false","+      ),","+      resolve(exclusive).focus","+    )","+","+    val call = resolve(","+      exclusive,","+      SessionRequirements(usage = AudioAttributes.USAGE_MEDIA, contentType = AudioAttributes.CONTENT_TYPE_MOVIE),","+      SessionRequirements(","+        usage = AudioAttributes.USAGE_VOICE_COMMUNICATION,","+        contentType = AudioAttributes.CONTENT_TYPE_SPEECH,","+        pausesWhenDucked = true","+      )","+    ).focus","+    assertEquals(AudioAttributes.USAGE_VOICE_COMMUNICATION, call?.usage)","+    assertEquals(AudioAttributes.CONTENT_TYPE_SPEECH, call?.contentType)","+    assertEquals(true, call?.pausesWhenDucked)","+  }","+}"],"additions":92,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/ios/AudioPolicy.swift","lines":["@@ -0,0 +1,108 @@","+import AVFoundation","+import ExpoModulesCore","+","+public enum InterruptionMode: String, Enumerable, Sendable {","+  case mixWithOthers","+  case doNotMix","+  case doNotMixPersistent","+  case duckOthers","+","+  public var preventsMixing: Bool {","+    self == .doNotMix || self == .doNotMixPersistent","+  }","+","+  public var notifiesOthersOnDeactivation: Bool {","+    self != .doNotMixPersistent","+  }","+}","+","+public enum MixingRequirement: String, Sendable {","+  case mixWithOthers","+  case duckOthers","+  case doNotMix","+}","+","+public struct SessionCapabilities: OptionSet, Hashable, Sendable {","+  public let rawValue: Int","+","+  public init(rawValue: Int) {","+    self.rawValue = rawValue","+  }","+","+  public static let record = SessionCapabilities(rawValue: 1 << 0)","+  public static let measurement = SessionCapabilities(rawValue: 1 << 1)","+}","+","+public struct AudioPolicy: Equatable, Sendable {","+  public var playsInSilentMode: Bool","+  public var interruptionMode: InterruptionMode","+  public var allowsRecording: Bool","+  public var shouldRouteThroughEarpiece: Bool","+","+  public init(","+    playsInSilentMode: Bool = true,","+    interruptionMode: InterruptionMode = .mixWithOthers,","+    allowsRecording: Bool = false,","+    shouldRouteThroughEarpiece: Bool = false","+  ) {","+    self.playsInSilentMode = playsInSilentMode","+    self.interruptionMode = interruptionMode","+    self.allowsRecording = allowsRecording","+    self.shouldRouteThroughEarpiece = shouldRouteThroughEarpiece","+  }","+","+  public static let `default` = AudioPolicy()","+","+  public func merged(with update: AudioPolicyUpdate) -> AudioPolicy {","+    AudioPolicy(","+      playsInSilentMode: update.playsInSilentMode ?? playsInSilentMode,","+      interruptionMode: update.interruptionMode ?? interruptionMode,","+      allowsRecording: update.allowsRecording ?? allowsRecording,","+      shouldRouteThroughEarpiece: update.shouldRouteThroughEarpiece ?? shouldRouteThroughEarpiece","+    )","+  }","+}","+","+public struct AudioPolicyUpdate: Equatable, Sendable {","+  public var playsInSilentMode: Bool?","+  public var interruptionMode: InterruptionMode?","+  public var allowsRecording: Bool?","+  public var shouldRouteThroughEarpiece: Bool?","+","+  public init(","+    playsInSilentMode: Bool? = nil,","+    interruptionMode: InterruptionMode? = nil,","+    allowsRecording: Bool? = nil,","+    shouldRouteThroughEarpiece: Bool? = nil","+  ) {","+    self.playsInSilentMode = playsInSilentMode","+    self.interruptionMode = interruptionMode","+    self.allowsRecording = allowsRecording","+    self.shouldRouteThroughEarpiece = shouldRouteThroughEarpiece","+  }","+}","+","+public struct SessionRequirements: Equatable, Sendable {","+  public var mixing: MixingRequirement?","+  public var capabilities: SessionCapabilities","+  public var mode: AVAudioSession.Mode?","+  public var extraOptions: AVAudioSession.CategoryOptions","+  public var preferredSampleRate: Double?","+  public var preferredIOBufferDuration: TimeInterval?","+","+  public init(","+    mixing: MixingRequirement? = nil,","+    capabilities: SessionCapabilities = [],","+    mode: AVAudioSession.Mode? = nil,","+    extraOptions: AVAudioSession.CategoryOptions = [],","+    preferredSampleRate: Double? = nil,","+    preferredIOBufferDuration: TimeInterval? = nil","+  ) {","+    self.mixing = mixing","+    self.capabilities = capabilities","+    self.mode = mode","+    self.extraOptions = extraOptions","+    self.preferredSampleRate = preferredSampleRate","+    self.preferredIOBufferDuration = preferredIOBufferDuration","+  }","+}"],"additions":108,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/ios/AudioPolicyMapping.swift","lines":["@@ -0,0 +1,206 @@","+import AVFoundation","+","+public struct SessionConfiguration: Equatable, Sendable {","+  public var category: AVAudioSession.Category","+  public var mode: AVAudioSession.Mode","+  public var options: AVAudioSession.CategoryOptions","+","+  public init(","+    category: AVAudioSession.Category = .playback,","+    mode: AVAudioSession.Mode = .default,","+    options: AVAudioSession.CategoryOptions = []","+  ) {","+    self.category = category","+    self.mode = mode","+    self.options = options","+  }","+}","+","+public struct ResolvedSession: Equatable, Sendable {","+  public let interruptionMode: InterruptionMode","+  public let configuration: SessionConfiguration","+  public let preferredSampleRate: Double?","+  public let preferredIOBufferDuration: TimeInterval?","+  public let notifiesOthersOnDeactivation: Bool","+}","+","+extension AudioPolicy {","+  public func validate() throws {","+    guard !playsInSilentMode else {","+      return","+    }","+    if interruptionMode == .duckOthers {","+      throw InvalidAudioPolicyException(","+        \"The audio policy sets interruptionMode to duckOthers while playsInSilentMode is false. iOS cannot duck other audio in a session that follows the silent switch. Set playsInSilentMode to true or choose another interruptionMode\"","+      )","+    }","+    if allowsRecording {","+      throw InvalidAudioPolicyException(","+        \"The audio policy sets allowsRecording to true while playsInSilentMode is false. Recording needs a session that ignores the silent switch. Set playsInSilentMode to true or allowsRecording to false\"","+      )","+    }","+  }","+}","+","+public enum SessionResolver {","+  public static func resolve(policy: AudioPolicy, requirements: [SessionRequirements]) -> ResolvedSession {","+    var interruptionMode =","+      requirements","+      .compactMap { $0.mixing?.interruptionMode }","+      .reduce(policy.interruptionMode) { $1.mixingRank > $0.mixingRank ? $1 : $0 }","+","+    var effectivePolicy = policy","+    effectivePolicy.interruptionMode = interruptionMode","+","+    let capabilities = requirements.reduce(into: SessionCapabilities()) { $0.formUnion($1.capabilities) }","+    var mode: AVAudioSession.Mode =","+      capabilities.contains(.measurement)","+      ? .measurement","+      : requirements","+        .compactMap(\\.mode)","+        .reduce(AVAudioSession.Mode.default) { specificity(of: $1) > specificity(of: $0) ? $1 : $0 }","+","+    let inputCapabilities: SessionCapabilities = [.record, .measurement]","+    let needsInput = !capabilities.isDisjoint(with: inputCapabilities)","+    let isInputOnly =","+      !requirements.isEmpty && requirements.allSatisfy { !$0.capabilities.isDisjoint(with: inputCapabilities) }","+    let needsChat = chatModes.contains(mode)","+","+    var category = baseCategory(for: effectivePolicy)","+    var options = baseOptions(for: effectivePolicy, category: category)","+","+    if needsInput || needsChat {","+      if category != .playback && category != .playAndRecord && isInputOnly && !needsChat {","+        category = .record","+        options = []","+        if !interruptionMode.preventsMixing {","+          interruptionMode = .doNotMix","+        }","+      } else {","+        category = .playAndRecord","+        options = baseOptions(for: effectivePolicy, category: category, forcingSilentModePlayback: true)","+      }","+    }","+","+    if mode == .moviePlayback && category != .playback {","+      mode = .default","+    }","+","+    for requirement in requirements {","+      options.formUnion(requirement.extraOptions.subtracting(mixingOptions))","+    }","+    options.subtract(unsupportedOptions(options, in: category))","+    if interruptionMode == .duckOthers && !options.contains(.duckOthers) {","+      interruptionMode = .mixWithOthers","+    }","+","+    return ResolvedSession(","+      interruptionMode: interruptionMode,","+      configuration: SessionConfiguration(category: category, mode: mode, options: options),","+      preferredSampleRate: requirements.compactMap(\\.preferredSampleRate).max(),","+      preferredIOBufferDuration: requirements.compactMap(\\.preferredIOBufferDuration).min(),","+      notifiesOthersOnDeactivation: interruptionMode.notifiesOthersOnDeactivation","+    )","+  }","+","+  static func unsupportedOptions(","+    _ options: AVAudioSession.CategoryOptions,","+    in category: AVAudioSession.Category","+  ) -> AVAudioSession.CategoryOptions {","+    var unsupported: AVAudioSession.CategoryOptions = []","+    if category != .playAndRecord {","+      unsupported.formUnion(options.intersection([.allowAirPlay, .allowBluetoothA2DP]))","+      #if os(iOS)","+      unsupported.formUnion(options.intersection(.defaultToSpeaker))","+      #endif","+    }","+    #if os(iOS)","+    if category != .playAndRecord && category != .record {","+      #if compiler(>=6.2)","+      unsupported.formUnion(options.intersection(.allowBluetoothHFP))","+      #else","+      unsupported.formUnion(options.intersection(.allowBluetooth))","+      #endif","+    }","+    #endif","+    return unsupported","+  }","+","+  private static let mixingOptions: AVAudioSession.CategoryOptions = [","+    .mixWithOthers, .duckOthers, .interruptSpokenAudioAndMixWithOthers,","+  ]","+","+  private static let chatModes: Set<AVAudioSession.Mode> = [.voiceChat, .videoChat, .gameChat]","+","+  private static func specificity(of mode: AVAudioSession.Mode) -> Int {","+    switch mode {","+    case .measurement: return 6","+    case .voiceChat: return 5","+    case .videoChat: return 4","+    case .moviePlayback: return 3","+    case .spokenAudio: return 2","+    case .default: return 0","+    default: return 1","+    }","+  }","+","+  private static func baseCategory(for policy: AudioPolicy) -> AVAudioSession.Category {","+    if !policy.playsInSilentMode {","+      return policy.interruptionMode.preventsMixing ? .soloAmbient : .ambient","+    }","+    return policy.allowsRecording ? .playAndRecord : .playback","+  }","+","+  private static func baseOptions(","+    for policy: AudioPolicy,","+    category: AVAudioSession.Category,","+    forcingSilentModePlaybac