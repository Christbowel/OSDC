CanonicalPackageName;","+use serde_json::Value;","+use sha2::{Digest, Sha256};","+","+/// The stored document's content identity, before response projections and overlays.","+pub(in super::super) fn revision(document: &Value) -> String {","+    let mut hasher = Sha256::new();","+    serde_json::to_writer(&mut hasher, document).expect(\"JSON values serialize into a digest\");","+    format!(\"{:x}\", hasher.finalize())","+}","+","+pub(in super::super) fn check(","+    name: &CanonicalPackageName,","+    hosted: &Value,","+    submitted: Option<&str>,","+) -> Result<(), RegistryError> {","+    if submitted == Some(revision(hosted).as_str()) {","+        return Ok(());","+    }","+    Err(RegistryError::DocumentWriteConflict { package: name.as_str().to_string() })","+}","+","+/// Limit the merge to existing versions, whose only mutable field is `deprecated`.","+pub(in super::super) fn prepare_deprecation(","+    name: &CanonicalPackageName,","+    hosted: &Value,","+    incoming: &mut Value,","+) -> Result<(), RegistryError> {","+    check(name, hosted, incoming.get(\"_rev\").and_then(Value::as_str))?;","+    if let Some(object) = incoming.as_object_mut() {","+        object.retain(|key, _| key == \"versions\");","+    }","+    Ok(())","+}"],"additions":35,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_responses.rs","lines":["@@ -200,8 +200,12 @@ pub(super) fn packument_response(","     headers: &HeaderMap,","     max_age: u64,"," ) -> Result<Response, RegistryError> {","+    let representation = Representation::requested(headers);","     let osv_index = state.inner.osv_index.as_ref();","     let mut doc: Value = serde_json::from_slice(bytes)?;","+    if view.hosted && representation == Representation::Full {","+        doc[\"_rev\"] = Value::String(super::package_mutation::revisions::revision(&doc));","+    }","     filter_osv_vulnerable_versions(&mut doc, name, osv_index);","     match view.revision_registry {","         Some(source_registry) => {","@@ -212,7 +216,6 @@ pub(super) fn packument_response(","     if let Some(table) = view.tar_integrities {","         describe_tars(&mut doc, table, view.tar_registry);","     }","-    let representation = Representation::requested(headers);","     let last_modified_source = packument_last_modified(&doc);","     let documents = &state.inner.config.http.package_documents;","     let (body, content_type) = representation.render(doc, documents)?;"],"additions":4,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/attachments.rs","lines":["@@ -162,6 +162,8 @@ pub(in super::super) struct StagedPublish {"," /// The stored document a staged publish was computed from."," #[derive(Default)]"," pub(in super::super) struct StagedBase {","+    /// A client revision precondition forbids rebasing onto another document.","+    pub(in super::super) revision_checked: bool,","     /// Its version, which the commit expects to replace; `None` when there","     /// was none.","     pub(in super::super) version: Option<HostedDocumentVersion>,","@@ -198,34 +200,21 @@ pub(in super::super) struct Verification {"," /// removed."," pub(in super::super) async fn stage_publish(","     state: &AppState,","-    doc: ValidatedPublish,","+    mut doc: ValidatedPublish,","     now_iso: &str,","     org: Option<&str>,"," ) -> Result<StagedPublish, RegistryError> {","     let storage = hosted_storage(state, org);"," ","-    let base = read_staged_base(&storage, &doc).await?;","-    let hosted = base.packument.as_ref();","-","-    check_staged_tombstone(state, &storage, &doc, hosted.is_some()).await?;","+    let mut base = read_staged_base(&storage, &doc).await?;","+    check_staged_tombstone(state, &storage, &doc, base.packument.is_some()).await?;","     let publisher = doc.publisher.username().map(str::to_string);","+    let (merged, without_any) =","+        prepare_publish_document(&storage, &mut doc, &mut base, now_iso).await?;","+    drop(doc.incoming);","