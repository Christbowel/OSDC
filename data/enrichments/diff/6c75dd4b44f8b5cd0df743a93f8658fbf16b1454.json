})","+\t}","+}","+","+func TestLocalSubjectRestrictionContract(t *testing.T) {","+\te, err := newLocalExchanger()","+\trequire.NoError(t, err)","+\tpolicy := LocalAccessPolicy{","+\t\tPluginID: \"allowed-app\", Audiences: []string{\"grafana\"},","+\t\tAllowUnattendedDelegation: true,","+\t\tDelegatedPermissions:      []string{\"datasources:read\", \"datasources:write\"},","+\t}","+\tfor _, tt := range []struct {","+\t\tname string","+\t\tbody string","+\t\twant []string","+\t}{","+\t\t{name: \"omitted\", body: `{}`, want: []string{\"datasources:read\", \"datasources:write\"}},","+\t\t{name: \"null\", body: `{\"restrictedDelegatedPermissions\":null}`, want: []string{\"datasources:read\", \"datasources:write\"}},","+\t\t{name: \"empty\", body: `{\"restrictedDelegatedPermissions\":[]}`, want: []string{\"datasources:read\", \"datasources:write\"}},","+\t\t{name: \"subset\", body: `{\"restrictedDelegatedPermissions\":[\"datasources:read\"]}`, want: []string{\"datasources:read\"}},","+\t\t{name: \"mixed\", body: `{\"restrictedDelegatedPermissions\":[\"datasources:read\",\"users:create\"]}`, want: []string{\"datasources:read\"}},","+\t\t{name: \"no overlap\", body: `{\"restrictedDelegatedPermissions\":[\"users:create\"]}`},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tvar req authnlib.TokenExchangeRequest","+\t\t\trequire.NoError(t, json.Unmarshal([]byte(tt.body), &req))","+\t\t\treq.Namespace = \"default\"","+\t\t\treq.Audiences = []string{\"grafana\"}","+\t\t\treq.Subject = &authnlib.TokenExchangeSubject{Sub: \"user:42\", Identifier: \"uid-42\", Type: \"user\", Namespace: \"default\"}","+\t\t\ttoken, err := e.signForPolicy(context.Background(), policy, req)","+\t\t\tif tt.want == nil {","+\t\t\t\trequire.ErrorIs(t, err, ErrLocalAccessDenied)","+\t\t\t\trequire.Empty(t, token)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t\tverifier := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, e