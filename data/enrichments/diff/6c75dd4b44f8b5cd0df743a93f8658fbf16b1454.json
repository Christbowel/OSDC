essPolicy {","+\treturn LocalAccessPolicy{PluginID: \"audit-app\", Audiences: []string{\"grafana\"}, Permissions: []string{\"users:create\"},","+\t\tAllowUnattendedDelegation: true,","+\t\tDelegatedPermissions:      []string{\"datasources:read\", \"datasources:write\"},","+\t}","+}","+","+func TestLocalUnattendedDelegationTokenLifetime(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname      string","+\t\tmaximum   time.Duration","+\t\trequested *int","+\t\twant      time.Duration","+\t}{","+\t\t{name: \"default\", want: 5 * time.Minute},","+\t\t{name: \"default unaffected by maximum\", maximum: time.Hour, want: 5 * time.Minute},","+\t\t{name: \"one second\", requested: new(1), want: time.Second},","+\t\t{name: \"shorter\", requested: new(60), want: time.Minute},","+\t\t{name: \"explicit default\", requested: new(300), want: 5 * time.Minute},","+\t\t{name: \"longer\", maximum: time.Hour, requested: new(900), want: 15 * time.Minute},","+\t\t{name: \"exact maximum\", maximum: time.Hour, requested: new(3600), want: time.Hour},","+\t\t{name: \"zero\", requested: new(0)},","+\t\t{name: \"negative\", requested: new(-1)},","+\t\t{name: \"above default maximum\", requested: new(301)},","+\t\t{name: \"above configured maximum\", maximum: time.Hour, requested: new(3601)},","+\t\t{name: \"duration overflow\", maximum: time.Hour, requested: new(int(^uint(0) >> 1))},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\t\te, err := newLocalExchanger()","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tpolicy := auditSubjectPolicy()","+\t\t\t\tpolicy.MaxUnattendedDelegationTokenLifetime = tc.maximum","+\t\t\t\treq := auditSubjectRequest()","+\t\t\t\treq.ExpiresIn = tc.requested","+\t\t\t\ttoken, err := e.signForPolicy(context.Background(), policy, req)","+\t\t\t\tif tc.want == 0 {","+\t\t\t\t\trequire.ErrorIs(t, err, ErrLocalAccessDenied)","+\t\t\t\t\trequire.ErrorContains(t, err, \"expiresIn\")","+\t\t\t\t\trequire.Empty(t, token)","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tv := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, e.keys)","+\t\t\t\tclaims, err := v.Verify(context.Background(), token)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, tc.want, claims.Expiry.Time().Sub(claims.IssuedAt.Time()))","+\t\t\t\ttime.Sleep(tc.want - time.Second)","+\t\t\t\t_, err = v.Verify(context.Background(), token)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\t// authlib uses go-jose's default clock-skew allowance.","+\t\t\t\ttime.Sleep(jwt.DefaultLeeway + 2*time.Second)","+\t\t\t\t_, err = v.Verify(context.Background(), token)","+\t\t\t\trequire.ErrorIs(t, err, authnlib.ErrExpiredToken)","+\t\t\t})","+\t\t})","+\t}","+}","+","+func TestLocalSubjectMetadataAndPolicyIsolation(t *testing.T) {","+\te, err := newLocalExchanger()","+\trequire.NoError(t, err)","+\tpolicy := auditSubjectPolicy()","+\treq := auditSubjectRequest()","+\treq.Subject.Email = \"asserted@example.test\"","+\treq.Subject.EmailVerified = true","+\treq.Subject.Username = \"asserted\"","+\treq.Subject.DisplayName = \"asserted\"","+\treq.Subject.AuthenticatedBy = \"asserted\"","+\treq.Subject.Role = \"Admin\"","+\treq.Subject.Groups = []string{\"asserted\"}","+\treq.RestrictedDelegatedPermissions = []string{\"datasources:read\", \"users:create\"}","+\ttoken, err := e.signForPolicy(context.Background(), policy, req)","+\trequire.NoError(t, err)","+\tv := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, e.keys)","+\tclaims, err := v.Verify(context.Background(), token)","+\trequire.NoError(t, err)","+\trequire.Empty(t, claims.Rest.Permissions)","+\trequire.Empty(t, claims.Rest.Scopes)","+\trequire.Equal(t, \"plugin:audit-app\", claims.Rest.ServiceIdentity)","+\trequire.Equal(t, []string{\"datasources:read\"}, claims.Rest.DelegatedPermissions)","+\trequire.Equal(t, &authnlib.ActorClaims{Subject: \"user:42\", IDTokenClaims: authnlib.IDTokenClaims{","+\t\tIdentifier: \"uid-42\", Type: \"user\", Namespace: \"default\",","+\t}}, claims.Rest.Actor)","+\trequire.Equal(t, []string{\"datasources:read\", \"datasources:write\"}, policy.DelegatedPermissions)","+}","+","+func TestLocalSubjectConcurrentNarrowing(t *testing.T) {","+\te, err := newLocalExchanger()","+\trequire.NoError(t, err)","+\tpolicy := auditSubjectPolicy()","+\tv := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, e.keys)","+\tvar wg sync.WaitGroup","+\tfor i := range 48 {","+\t\twg.Go(func() {","+\t\t\treq := auditSubjectRequest()","+\t\t\twant := \"datasources:read\"","+\t\t\tif i%2 != 0 {","+\t\t\t\twant = \"datasources:write\"","+\t\t\t}","+\t\t\treq.RestrictedDelegatedPermissions = []string{want}","+\t\t\ttoken, err := e.signForPolicy(context.Background(), policy, req)","+\t\t\tif err != nil {","+\t\t\t\tt.Errorf(\"sign: %v\", err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tclaims, err := v.Verify(context.Background(), token)","+\t\t\tif err != nil {","+\t\t\t\tt.Errorf(\"verify: %v\", err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif len(claims.Rest.DelegatedPermissions) != 1 || claims.Rest.DelegatedPermissions[0] != want {","+\t\t\t\tt.Errorf(\"delegation differs between concurrent requests: %v; want %s\", claims.Rest.DelegatedPermissions, want)","+\t\t\t}","+\t\t})","+\t}","+\twg.Wait()","+\trequire.Equal(t, []string{\"datasources:read\", \"datasources:write\"}, policy.DelegatedPermissions)","+}","+","+func TestLocalSubjectRejectsNoncanonicalIdentity(t *testing.T) {","+\tfor _, sub := range []string{\"\", \"user:0\", \"user:-1\", \"user:+42\", \"user:042\", \"user: 42\", \"user:42 \", \"user:4.2\", \"user:4e2\", \"user:9223372036854775808\", \"user:\", \"user:42:43\", \"service-account:42\"} {","+\t\tt.Run(sub, func(t *testing.T) {","+\t\t\treq := auditSubjectRequest()","+\t\t\treq.Subject.Sub = sub","+\t\t\t_, err := actorFromSubject(req.Subject, req.Namespace)","+\t\t\trequire.ErrorIs(t, err, ErrLocalAccessDenied)","+\t\t})","+\t}","+\tfor _, uid := range []string{\"\", \" \", \"\\t\\n\"} {","+\t\treq := auditSubjectRequest()","+\t\treq.Subject.Identifier = uid","+\t\t_, err := actorFromSubject(req.Subject, req.Namespace)","+\t\trequire.ErrorIs(t, err, ErrLocalAccessDenied)","+\t}","+}","+","+func TestLocalSubjectVerificationBoundaries(t *testing.T) {","+\te, err := newLocalExchanger()","+\trequire.NoError(t, err)","+\ttoken, err := e.signForPolicy(context.Background(), auditSubjectPolicy(), auditSubjectRequest())","+\trequire.NoError(t, err)","+\tv := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, e.keys)","+\t_, err = v.Verify(context.Background(), token)","+\trequire.NoError(t, err)","+\tfor _, part := range []int{0, 1, 2} {","+\t\tparts := strings.Split(token, \".\")","+\t\tdecoded, err := base64.RawURLEncoding.DecodeString(parts[part])","+\t\trequire.NoError(t, err)","+\t\tif part == 2 {","+\t\t\tdecoded[0] ^= 1","+\t\t} else {","+\t\t\tvar value map[string]any","+\t\t\trequire.NoError(t, json.Unmarshal(decoded, &value))","+\t\t\tif part == 0 {","+\t\t\t\tvalue[\"kid\"] = \"unknown-key\"","+\t\t\t} else {","+\t\t\t\tvalue[\"namespace\"] = \"org-2\"","+\t\t\t}","+\t\t\tdecoded, err = json.Marshal(value)","+\t\t\trequire.NoError(t, err)","+\t\t}","+\t\tparts[part] = base64.RawURLEncoding.EncodeToString(decoded)","+\t\t_, err = v.Verify(context.Background(), strings.Join(parts, \".\"))","+\t\trequire.Error(t, err, \"modified JWT part %d must fail verification\", part)","+\t}","+\twrongAudience := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"another-service\"}}, e.keys)","+\t_, err = wrongAudience.Verify(context.Background(), token)","+\trequire.ErrorIs(t, err, authnlib.ErrInvalidAudience)","+\totherProcess, err := newLocalExchanger()","+\trequire.NoError(t, err)","+\totherVerifier := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, otherProcess.keys)","+\t_, err = otherVerifier.Verify(context.Background(), token)","+\trequire.Error(t, err, \"a separate process has a different signing key even though its key ID is the same\")","+}"],"additions":198,"deletions":0,"truncated":false},{"path":"pkg/plugins/backendplugin/v3/local_subject_test.go","lines":["@@ -0,0 +1,173 @@","+package v3","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"testing\"","+\t\"testing/synctest\"","+\t\"time\"","+","+\t\"github.com/go-jose/go-jose/v4/jwt\"","+\tauthnlib \"github.com/grafana/authlib/authn\"","+\t\"github.com/grafana/authlib/types\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestLocalUnattendedDelegation(t *testing.T) {","+\te, err := newLocalExchanger()","+\trequire.NoError(t, err)","+\tpolicy := LocalAccessPolicy{","+\t\tPluginID: \"obo-poc-app\", Audiences: []string{\"grafana\"},","+\t\tPermissions:               []string{\"users:write\"},","+\t\tAllowUnattendedDelegation: true,","+\t\tDelegatedPermissions:      []string{\"datasources:read\", \"datasources:write\"},","+\t}","+\trequest := func() authnlib.TokenExchangeRequest {","+\t\treturn authnlib.TokenExchangeRequest{Namespace: \"default\", Audiences: []string{\"grafana\"}, Subject: &authnlib.TokenExchangeSubject{","+\t\t\tSub: \"user:42\", Identifier: \"user-uid\", Type: \"user\", Namespace: \"default\", Role: \"Admin\", Groups: []string{\"untrusted-group\"},","+\t\t}}","+\t}","+\tverifier := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, e.keys)","+\tfor _, typ := range []types.IdentityType{types.TypeUser, types.TypeServiceAccount} {","+\t\tt.Run(string(typ), func(t *testing.T) {","+\t\t\treq := request()","+\t\t\treq.Subject.Type = string(typ)","+\t\t\treq.Subject.Sub = types.NewTypeID(typ, \"42\")","+\t\t\ttoken, err := e.signForPolicy(context.Background(), policy, req)","+\t\t\trequire.NoError(t, er