d {","+\t\treturn nil","+\t}","+\trestrictions := strings.Fields(settings[\"unattended_delegation_permissions\"])","+\tfor _, permission := range restrictions {","+\t\taction, verb, ok := strings.Cut(permission, \":\")","+\t\tif !ok || action == \"\" || verb == \"\" || strings.Contains(permission, \",\") {","+\t\t\treturn errors.New(\"unattended_delegation_permissions requires space-separated actions\")","+\t\t}","+\t}","+\tvar maximum time.Duration","+\tif value := settings[\"unattended_delegation_max_token_lifetime\"]; value != \"\" {","+\t\tmaximum, err = time.ParseDuration(value)","+\t\tif err != nil || maximum < v3.DefaultLocalUnattendedDelegationTokenLifetime || maximum%time.Second != 0 {","+\t\t\treturn fmt.Errorf(\"unattended_delegation_max_token_lifetime must be a duration of at least %s in whole seconds\", v3.DefaultLocalUnattendedDelegationTokenLifetime)","+\t\t}","+\t}","+\tpolicy.AllowUnattendedDelegation = true","+\tif len(restrictions) > 0 {"],"additions":43,"deletions":0,"truncated":false}],"additions":520,"deletions":13,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-27T19:03:42.191303+00:00"}