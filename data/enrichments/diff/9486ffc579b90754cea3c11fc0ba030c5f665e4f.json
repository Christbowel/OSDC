custom constraints which are listed below."," With one exception also these constraints apply to the field/property level, only `@ScriptAssert` is a class-level constraint."," ","+`@BIC`:: Checks that the annotated character sequence is a valid https://en.wikipedia.org/wiki/ISO_9362[BIC] (Bank Identifier Code / SWIFT code) per ISO 9362. The structural format is validated: proper length (8 or 11 characters), valid character sets per position, and valid ISO 3166-1 alpha-2 country code. Optional filtering by country codes (`countryCodes`) and bank codes (`bankCodes`) is supported.","+    Supported data types::: `CharSequence`","+    Hibernate metadata impact::: None","+"," `@Contains(value=, minRequired=, ignoreCase=)`:: Validates that the annotated character sequence contains the specified substrings. By default, all substrings must be present. Use `minRequired` to specify a minimum number of substrings that must match (e.g., `minRequired=1` for an OR-style check). When `ignoreCase` is set to `true`, the comparison is case-insensitive."," \tSupported data types::: `CharSequence`"," \tHibernate metadata impact::: None"],"additions":4,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/cfg/defs/BICDef.java","lines":["@@ -0,0 +1,38 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.cfg.defs;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.cfg.ConstraintDef;","+import org.hibernate.validator.constraints.BIC;","+","+/**","+ * A {@link BIC} constraint definition.","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Incubating","+public class BICDef extends ConstraintDef<BICDef, BIC> {","+","+\tpublic BICDef() {","+\t\tsuper( BIC.class );","+\t}","+","+\tpublic BICDef allowLowercase(boolean allowLowercase) {","+\t\taddParameter( \"allowLowercase\", allowLowercase );","+\t\treturn this;","+\t}","+","+\tpublic BICDef countryCodes(String... countryCodes) {","+\t\taddParameter( \"countryCodes\", countryCodes );","+\t\treturn this;","+\t}","+","+\tpublic BICDef bankCodes(String... bankCodes) {","+\t\taddParameter( \"bankCodes\", bankCodes );","+\t\treturn this;","+\t}","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/constraints/BIC.java","lines":["@@ -0,0 +1,95 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.constraints;","+","+import static java.lang.annotation.ElementType.ANNOTATION_TYPE;","+import static java.lang.annotation.ElementType.CONSTRUCTOR;","+import static java.lang.annotation.ElementType.FIELD;","+import static java.lang.annotation.ElementType.METHOD;","+import static java.lang.annotation.ElementType.PARAMETER;","+import static java.lang.annotation.ElementType.TYPE_USE;","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+import java.lang.annotation.Documented;","+import java.lang.annotation.Repeatable;","+import java.lang.annotation.Retention;","+import java.lang.annotation.Target;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.constraints.BIC.List;","+","+/**","+ * Checks that the annotated character sequence is a valid","+ * <a href=\"https://en.wikipedia.org/wiki/ISO_9362\">BIC</a>","+ * (Bank Identifier Code, also known as SWIFT code).","+ * <p>","+ * The constraint validates the structure per ISO 9362:","+ * <ul>","+ *     <li>Length must be exactly 8 or 11 characters</li>","+ *     <li>Positions 1-4: Institution (bank) code - 4 letters</li>","+ *     <li>Positions 5-6: Country code - 2 letters (ISO 3166-1 alpha-2, including 'XK' for Kosovo)</li>","+ *     <li>Positions 7-8: Location code - 2 alphanumeric characters</li>","+ *     <li>Positions 9-11: Branch code - 3 alphanumeric characters (optional)</li>","+ * </ul>","+ * <p>","+ * The supported type is {@code CharSequence}. {@code null} is considered valid.","+ * <p>","+ * Optional filtering by country codes and bank codes is supported via the {@link #countryCodes()}","+ * and {@link #bankCodes()} attributes.","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Documented","+@Constraint(validatedBy = { })","+@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+@Retention(RUNTIME)","+@Repeatable(List.class)","+@Incubating","+public @interface BIC {","+","+\tString message() default \"{org.hibernate.validator.constraints.BIC.message}\";","+","+\tClass<?>[] groups() default { };","+","+\tClass<? extends Payload>[] payload() default { };","+","+\t/**","+\t * @return whether to allow lowercase letters in the BIC.","+\t * When {@code false} (default), only uppercase letters are accepted (per ISO 9362 standard).","+\t * When {@code true}, lowercase letters are normalized to uppercase during validation.","+\t */","+\tboolean allowLowercase() default false;","+","+\t/**","+\t * @return the allowed ISO 3166-1 alpha-2 country codes (positions 5-6 of the BIC).","+\t * An empty array (default) means all valid country codes are accepted.","+\t * When specified, only BICs from the listed countries will be considered valid.","+\t * Country codes are matched case-insensitively.","+\t */","+\tString[] countryCodes() default { };","+","+\t/**","+\t * @return the allowed 4-letter institution (bank) codes (positions 1-4 of the BIC).","+\t * An empty array (default) means all bank codes are accepted.","+\t * When specified, only BICs with the listed bank codes will be considered valid.","+\t * Bank codes are matched case-insensitively.","+\t */","+\tString[] bankCodes() default { };","+","+\t/**","+\t * Defines several {@code @BIC} annotations on the same element.","+\t */","+\t@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+\t@Retention(RUNTIME)","+\t@Documented","+\t@interface List {","+","+\t\tBIC[] value();","+\t}","+}"],"additions":95,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/constraintvalidators/hv/BICValidator.java","lines":["@@ -0,0 +1,418 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.internal.constraintvalidators.hv;","+","+import java.util.Collections;","+import java.util.HashSet;","+import java.util.Locale;","+import java.util.Set;","+","+import jakarta.validation.ConstraintValidator;","+import jakarta.validation.ConstraintValidatorContext;","+","+import org.hibernate.validator.constraints.BIC;","+","+/**","+ * Checks that a given character sequence is a valid BIC (Bank Identifier Code / SWIFT code).","+ * <p>","+ * Validation is performed by checking the structural format per ISO 9362:","+ * length (8 or 11), character set per position, and valid ISO 3166-1 alpha-2 country code.","+ *","+ * @author Andrea Boriero","+ */","+public class BICValidator implements ConstraintValidator<BIC, CharSequence> {","+","+\t/**","+\t * Valid ISO 3166-1 alpha-2 country codes, plus 'XK' for Kosovo (SWIFT-specific extension).","+\t */","+\tprivate static final Set<String> VALID_COUNTRY_CODES = buildValidCountryCodes();","+","+\tprivate boolean allowLowercase;","+\tprivate Set<String> allowedCountryCodes;","+\tprivate Set<String> allowedBankCodes;","+","+\t@Override","+\tpublic void initialize(BIC parameters) {","+\t\tthis.allowLowercase = parameters.allowLowercase();","+","+\t\t// Normalize country codes to uppercase for case-insensitive matching","+\t\tString[] countryCodes = parameters.countryCodes();","+\t\tif ( countryCodes.length > 0 ) {","+\t\t\tthis.allowedCountryCodes = new HashSet<>( countryCodes.length );","+\t\t\tfor ( String code : countryCodes ) {","+\t\t\t\tthis.allowedCountryCodes.add( code.toUpperCase( Locale.ROOT ) );","+\t\t\t}","+\t\t}","+\t\telse {","+\t\t\tthis.allowedCountryCodes = Collections.emptySet();","+\t\t}","+","+\t\t// Normalize bank codes to uppercase for case-insensitive matching","+\t\tString[] bankCodes = parameters.bankCodes();","+\t\tif ( bankCodes.length > 0 ) {","+\t\t\tthis.allowedBankCodes = new HashSet<>( bankCodes.length );","+\t\t\tfor ( String code : bankCodes ) {","+\t\t\t\tthis.allowedBankCodes.add( code.toUpperCase( Locale.ROOT ) );","+\t\t\t}","+\t\t}","+\t\telse {","+\t\t\tthis.allowedBankCodes = Collections.emptySet();","+\t\t}","+\t}","+","+\t@Override","+\tpublic boolean isValid(CharSequence value, ConstraintValidatorContext context) {","+\t\tif ( value == null ) {","+\t\t\treturn true;","+\t\t}","+","+\t\tString bic = value.toString();","+","+\t\t// Length must be exactly 8 (BIC8) or 11 (BIC11)","+\t\tint length = bic.length();","+\t\tif ( length != 8 && length != 11 ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Case sensitivity check","+\t\tif ( !allowLowercase && !isUpperCase( bic ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Positions 1-4: Institution (bank) code - must be letters only","+\t\t// Positions 5-6: Country code - must be letters only and a valid ISO 3166-1 alpha-2 code","+\t\tif ( !isLetters( bic, 0, 6 ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\tString countryCode = bic.substring( 4, 6 ).toUpperCase( Locale.ROOT );","+\t\tif ( !VALID_COUNTRY_CODES.contains( countryCode ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Positions 7-8: Location code - must be alphanumeric","+\t\tif ( !isAlphanumeric( bic, 6, 8 ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Positions 9-11: Branch code - must be alphanumeric (if present)","+\t\tif ( length == 11 && !isAlphanumeric( bic, 8, 11 ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Optional filtering by country code","+\t\tif ( !allowedCountryCodes.isEmpty() && !allowedCountryCodes.contains( countryCode ) ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Optional filtering by bank code","+\t\tif ( !allowedBankCodes.isEmpty() ) {","+\t\t\tif ( !allowedBankCodes.contains( bic.substring( 0, 4 ).toUpperCase( Locale.ROOT ) ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+","+\t\treturn true;","+\t}","+","+\t/**","+\t * Checks if all characters in the given range are uppercase letters or non-letters.","+\t */","+\tprivate boolean isUpperCase(String str) {","+\t\tfor ( int i = 0; i < str.length(); i++ ) {","+\t\t\tchar c = str.charAt( i );","+\t\t\tif ( Character.isLetter( c ) && !Character.isUpperCase( c ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+","+\t/**","+\t * Checks if all characters in the range [start, end) are letters.","+\t */","+\tprivate boolean isLetters(String str, int start, int end) {","+\t\tfor ( int i = start; i < end; i++ ) {","+\t\t\tchar c = str.charAt( i );","+\t\t\tif ( !Character.isLetter( c ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+","+\t/**","+\t * Checks if all characters in the range [start, end) are alphanumeric (letters or digits).","+\t */","+\tprivate boolean isAlphanumeric(String str, int start, int end) {","+\t\tfor ( int i = start; i < end; i++ ) {","+\t\t\tchar c = str.charAt( i );","+\t\t\tif ( !Character.isLetterOrDigit( c ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+","+\t/**","+\t * Builds the set of valid ISO 3166-1 alpha-2 country codes, plus SWIFT's 'XK' for Kosovo.","+\t */","+\tprivate static Set<String> buildValidCountryCodes() {","+\t\tSet<String> codes = new HashSet<>();","+\t\t// ISO 3166-1 alpha-2 country codes","+\t\tcodes.add( \"AD\" );","+\t\tcodes.add( \"AE\" );","+\t\tcodes.add( \"AF\" );","+\t\tcodes.add( \"AG\" );","+\t\tcodes.add( \"AI\" );","+\t\tcodes.add( \"AL\" );","+\t\tcodes.add( \"AM\" );","+\t\tcodes.add( \"AO\" );","+\t\tcodes.add( \"AQ\" );","+\t\tcodes.add( \"AR\" );","+\t\tcodes.add( \"AS\" );","+\t\tcodes.add( \"AT\" );","+\t\tcodes.add( \"AU\" );","+\t\tc