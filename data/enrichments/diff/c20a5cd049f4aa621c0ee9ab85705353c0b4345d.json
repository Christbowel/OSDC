"read\"","+            kWrite: \"write\"","+            kCommand: \"command\"","+    MongoExtensionCommandAllowedOnSecondary:","+        description: >-","+            Whether this command is allowed to run on secondary nodes.","+        type: string","+        values:","+            kAlways: \"always\"","+            kNever: \"never\"","+            kOptIn: \"optIn\"","+","+structs:","+    MongoExtensionCommandStaticProperties:","+        description: >-","+            Static properties of a command provided by an extension. These remain constant for the","+            lifetime of the extension and describe the command's cluster role, read/write type, and","+            other metadata.","+        strict: false","+        fields:","+            clusterRole:","+                description: Where the command should be registered (shard, router, or both).","+                type: MongoExtensionCommandClusterRole","+                default: kBoth","+            readWriteType:","+                description: The read/write classification for this command.","+                type: MongoExtensionCommandReadWriteType","+                default: kCommand","+            allowedOnSecondary:","+                description: Whether this command is allowed on secondary nodes.","+                type: MongoExtensionCommandAllowedOnSecondary","+                default: kNever","+            adminOnly:","+                description: Whether this command can only be run on the admin database.","+                type: bool","+                default: false","+            supportsWriteConcern:","+                description: Whether this command supports write concern.","+                type: bool","+                default: false","+            isSubjectToIngressAdmissionControl:","+                description: >-","+                    Whether this command should wait for ingress admission tickets before running.","+                type: bool","+                default: false","+            requiredPrivileges:","+                description: >-","+                    Privileges the client must hold to invoke this command. Each entry names action","+                    types on a resource pattern (currently the command's target namespace). An empty","+                    array means the command requires no additional privileges.","+                type: array<MongoExtensionRequiredPrivilege>"],"additions":76,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/public/extension_privilege.idl","lines":["@@ -7,6 +7,8 @@"," global:","     mod_visibility: public","     cpp_namespace: \"mongo::extension\"","+    cpp_includes:","+        - \"mongo/db/extension/shared/extension_privilege_validator.h\""," "," imports:","     - \"mongo/db/basic_types.idl\"","@@ -51,3 +53,5 @@ structs:","             actions:","                 description: Actions required on the target.","                 type: array<MongoExtensionPrivilegeActionEntry>","+                validator:","+                    callback: \"validateActionsNotEmpty\""],"additions":4,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/shared/extension_privilege_validator.cpp","lines":["@@ -0,0 +1,18 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/extension/shared/extension_privilege_validator.h\"","+","+#include \"mongo/base/error_codes.h\"","+#include \"mongo/db/extension/public/extension_privilege_gen.h\"","+","+namespace mongo::extension {","+","+Status validateActionsNotEmpty(const std::vector<MongoExtensionPrivilegeActionEntry>& actions) {","+    if (actions.empty()) {","+        return Status(ErrorCodes::ExtensionError, \"requiredPrivileges.actions must not be empty.\");","+    }","+    return Status::OK();","+}","+","+}  // namespace mongo::extension"],"additions":18,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/shared/extension_privilege_validator.h","lines":["@@ -0,0 +1,20 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/base/status.h\"","+#include \"mongo/util/modules.h\"","+","+#include <vector>","+","+namespace mongo::extension {","+class MongoExtensionPrivilegeActionEntry;","+","+/**","+ * Validates that a privilege names at least one action, since a privilege with no actions grants","+ * nothing. Shared by every extension-defined entity that declares privileges.","+ */","+Status validateActionsNotEmpty(const std::vector<MongoExtensionPrivilegeActionEntry>& actions);","+","+}  // namespace mongo::extension"],"additions":20,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/shared/tests/BUILD.bazel","lines":["@@ -14,6 +14,7 @@ mongo_cc_unit_test(","         \"api_contract_test.cpp\",","         \"byte_buf_utils_test.cpp\",","         \"capability_version_test.cpp\",","+        \"extension_command_static_properties_test.cpp\",","         \"extension_status_test.cpp\",","         \"handle_test.cpp\",","         \"vec_byte_buf_test.cpp\",","@@ -22,7 +23,10 @@ mongo_cc_unit_test(","     tags = [\"mongo_unittest_eighth_group\"],","     deps = [","         \"//src/mongo:base\",","+        \"//src/mongo/db/extension/public:extensions_api_public\",","         \"//src/mongo/db/extension/shared\",","         \"//src/mongo/db/extension/shared/handle\",","+        \"//src/mongo/idl:idl_parser\",","+        \"//src/mongo/unittest\",","     ],"," )"],"additions":4,"deletions":0,"truncated":false},{"path":"src/mongo/db/extension/shared/tests/extension_command_static_properties_test.cpp","lines":["@@ -0,0 +1,136 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/base/error_codes.h\"","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/db/extension/public/extension_command_static_properties_gen.h\"","+#include \"mongo/idl/idl_parser.h\"","+#include \"mongo/unittest/unittest.h\"","+#include \"mongo/util/assert_util.h\"","+","+namespace mongo::extension {","+namespace {","+","+using MongoExtensionCommandAllowedOnSecondaryEnum::kAlways;","+using MongoExtensionCommandAllowedOnSecondaryEnum::kNever;","+using MongoExtensionCommandClusterRoleEnum::kBoth;","+using MongoExtensionCommandClusterRoleEnum::kShard;","+using MongoExtensionCommandReadWriteTypeEnum::kCommand;","+using MongoExtensionCommandReadWriteTypeEnum::kWrite;","+using MongoExtensionPrivilegeActionEnum::kCreateSearchIndexes;","+using MongoExtensionPrivilegeResourcePatternEnum::kNamespace;","+","+TEST(ExtensionCommandStaticPropertiesTest, DefaultsAreApplied) {","+    // requiredPrivileges is a required field, so every valid document supplies it.","+    const auto properties =","+        MongoExtensionCommandStaticProperties::parse(BSON(\"requiredPrivileges\" << BSONArray()));","+","+    ASSERT_EQ(properties.getClusterRole(), kBoth);","+    ASSERT_EQ(properties.getReadWriteType(), kCommand);","+    ASSERT_EQ(properties.getAllowedOnSecondary(), kNever);","+    ASSERT_FALSE(properties.getAdminOnly());","+    ASSERT_FALSE(properties.getSupportsWriteConcern());","+    ASSERT_FALSE(properties.getIsSubjectToIngressAdmissionControl());","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, EmptyRequiredPrivilegesMeansNoPrivileges) {","+    const auto properties =","+        MongoExtensionCommandStaticProperties::parse(BSON(\"requiredPrivileges\" << BSONArray()));","+","+    ASSERT_TRUE(properties.getRequiredPrivileges().empty());","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, EmptyDeclarationIsRejected) {","+    // Unlike the aggregation-stage properties, an empty declaration is not valid here because","+    // requiredPrivileges has no default.","+    IDLParserContext ctxt(\"properties\");","+    ASSERT_THROWS_CODE_AND_WHAT(","+        MongoExtensionCommandStaticProperties::parse(BSONObj(), ctxt),","+        AssertionException,","+        ErrorCodes::IDLFailedToParse,","+        \"BSON field 'properties.requiredPrivileges' is missing but a required field\");","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, InvalidEnumValuesAreRejected) {","+    IDLParserContext ctxt(\"properties\");","+","+    ASSERT_THROWS_CODE(","+        MongoExtensionCommandStaticProperties::parse(","+            BSON(\"clusterRole\" << \"notARole\" << \"requiredPrivileges\" << BSONArray()), ctxt),","+        DBException,","+        ErrorCodes::BadValue);","+    ASSERT_THROWS_CODE(","+        MongoExtensionCommandStaticProperties::parse(","+            BSON(\"readWriteType\" << \"notAType\" << \"requiredPrivileges\" << BSONArray()), ctxt),","+        DBException,","+        ErrorCodes::BadValue);","+    ASSERT_THROWS_CODE(","+        MongoExtensionCommandStaticProperties::parse(","+            BSON(\"allowedOnSecondary\" << \"sometimes\" << \"requiredPrivileges\" << BSONArray()), ctxt),","+        DBException,","+        ErrorCodes::BadValue);","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, NonDefaultValuesParse) {","+    const auto properties = MongoExtensionCommandStaticProperties::parse(","+        BSON(\"clusterRole\" << \"shard\"","+                           << \"readWriteType\" << \"write\"","+                           << \"allowedOnSecondary\" << \"always\"","+                           << \"adminOnly\" << true << \"supportsWriteConcern\" << true","+                           << \"isSubjectToIngressAdmissionControl\" << true << \"requiredPrivileges\"","+                           << BSONArray()));","+","+    ASSERT_EQ(properties.getClusterRole(), kShard);","+    ASSERT_EQ(properties.getReadWriteType(), kWrite);","+    ASSERT_EQ(properties.getAllowedOnSecondary(), kAlways);","+    ASSERT_TRUE(properties.getAdminOnly());","+    ASSERT_TRUE(properties.getSupportsWriteConcern());","+    ASSERT_TRUE(properties.getIsSubjectToIngressAdmissionControl());","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, RequiredPrivilegesParseAndRoundTrip) {","+    // Fields are written in IDL declaration order so the serialized form compares equal.","+    const auto doc = BSON(","+        \"clusterRole\" << \"shard\"","+                      << \"readWriteType\" << \"write\"","+                      << \"allowedOnSecondary\" << \"always\"","+                      << \"adminOnly\" << true << \"supportsWriteConcern\" << true","+                      << \"isSubjectToIngressAdmissionControl\" << true << \"requiredPrivileges\"","+                      << BSON_ARRAY(BSON(\"resourcePattern\"","+                                         << \"namespace\"","+                                         << \"actions\"","+                                         << BSON_ARRAY(BSON(\"action\" << \"createSearchIndexes\")))));","+","+    const auto properties = MongoExtensionCommandStaticProperties::parse(doc);","+","+    const auto& privileges = properties.getRequiredPrivileges();","+    ASSERT_EQ(privileges.size(), 1u);","+    ASSERT_EQ(privileges[0].getResourcePattern(), kNamespace);","+    ASSERT_EQ(privileges[0].getActions().size(), 1u);","+    ASSERT_EQ(privileges[0].getActions()[0].getAction(), kCreateSearchIndexes);","+","+    ASSERT_BSONOBJ_EQ(doc, properties.toBSON());","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, EmptyActionsIsRejected) {","+    // Tests the underlying required privileges validation logic which also applies to","+    // extension-defined agg stages.","+    IDLParserContext ctxt(\"properties\");","+    ASSERT_THROWS_CODE(MongoExtensionCommandStaticProperties::parse(","+                           BSON(\"requiredPrivileges\"","+                                << BSON_ARRAY(BSON(\"resourcePattern\" << \"namespace\"","+                                                                     << \"actions\" << BSONArray()))),","+                           ctxt),","+                       AssertionException,","+                       ErrorCodes::ExtensionError);","+}","+","+TEST(ExtensionCommandStaticPropertiesTest, UnknownFieldsAreIgnored) {","+    const auto properties = MongoExtensionCommandStaticProperties::parse(","+        BSON(\"requiredPrivileges\" << BSONArray() << \"notARealField\" << 1));","+","+    ASSERT_EQ(properties.getClusterRole(), kBoth);","+}","+","+}  // namespace","+}  // namespace mongo::extension",""],"additions":136,"deletions":0,"truncated":false}],"additions":273,"deletions":7,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-04T16:06:42.292274+00:00"}