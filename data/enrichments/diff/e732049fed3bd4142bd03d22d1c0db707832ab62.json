agments that start at the empty user key.","+  ASSERT_OK(","+      db_->DeleteRange(WriteOptions(), db_->DefaultColumnFamily(), \"\", \"c\"));","+  const Snapshot* snapshot = db_->GetSnapshot();","+  ASSERT_OK(","+      db_->DeleteRange(WriteOptions(), db_->DefaultColumnFamily(), \"\", \"c\"));","+  ASSERT_OK(Flush());","+","+  std::vector<std::vector<FileMetaData>> level_to_files;","+  dbfull()->TEST_GetFilesMetaData(dbfull()->DefaultColumnFamily(),","+                                  &level_to_files);","+  ASSERT_EQ(level_to_files[0].size(), 1);","+  ASSERT_EQ(level_to_files[2].size(), 1);","+  const uint64_t l2_size = level_to_files[2][0].fd.GetFileSize();","+  ASSERT_GT(l2_size, 0);","+  // Computed at flush time","+  ASSERT_EQ(level_to_files[0][0].compensated_range_deletion_size, l2_size);","+","+  // Computed at compaction time","+  ASSERT_OK(dbfull()->TEST_CompactRange(0, nullptr, nullptr, nullptr,","+                                        true /* disallow_trivial_move */));","+  dbfull()->TEST_GetFilesMetaData(dbfull()->DefaultColumnFamily(),","+                                  &level_to_files);","+  ASSERT_EQ(level_to_files[0].size(), 0);","+  ASSERT_EQ(level_to_files[1].size(), 1);","+  ASSERT_EQ(level_to_files[1][0].compensated_range_deletion_size, l2_size);","+  db_->ReleaseSnapshot(snapshot);","+}","+"," TEST_F(DBRangeDelTest, RangetombesoneCompensateFilesizePersistDuringReopen) {","   Options opts = CurrentOptions();","   opts.disable_auto_compactions = true;"],"additions":41,"deletions":0,"truncated":false},{"path":"unreleased_history/bug_fixes/open_and_compact_unknown_column_family.md","lines":["@@ -0,0 +1 @@","+Fixed a crash in `DB::OpenAndCompact()` when the compaction input names a column family that the OPTIONS file of the input does not list. It now returns `Status::InvalidArgument`."],"additions":1,"deletions":0,"truncated":false},{"path":"unreleased_history/bug_fixes/range_del_empty_start_key_compensated_size.md","lines":["@@ -0,0 +1 @@","+