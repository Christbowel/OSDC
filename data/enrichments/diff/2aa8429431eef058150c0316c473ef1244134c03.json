{"id":"2aa8429431eef058150c0316c473ef1244134c03","axis":"silent","repo":"nrwl/nx","sha":"2aa8429431eef058150c0316c473ef1244134c03","parsed":{"files":[{"path":"astro-docs/src/content/docs/kb/troubleshoot-cache-misses.mdoc","lines":["@@ -43,3 +43,31 @@ Problem: A task is being executed when you expect it to be replayed from the cac"," {% aside type=\"note\" title=\"Note\" %}"," Nx Cloud cannot access your source code, so it can only tell you which inputs are different based on their saved content hash, but not the exact git diff of the source code."," {% /aside %}","+","+## Check 4: Check if a dependency version differs between machines","+","+If the hash inputs of the two tasks show a different version of the same package, check whether","+the project imports that package without declaring it.","+For example, one machine has `npm:is-number@3.0.0` and the other has `npm:is-number@7.0.0`.","+","+Nx hashes the version of a package that an import loads.","+An undeclared import loads whichever version the package manager placed in the root","+`node_modules`.","+When the lock file has several versions of that package, the placed version can differ between","+two machines that use the same lock file:","+","+- Optional dependencies that only install on one platform change which version ends up at the","+  root, so macOS and Linux can load different versions.","+- An install that updates an existing `node_modules` can keep a version that a fresh install","+  would replace.","+","+The two machines run different code, so their tasks don't share cache results.","+","+To fix it, declare the package with the version the project needs.","+Use the project's `package.json` if the project is a workspace package of your package manager.","+Otherwise, use the root `package.json`.","+The package manager then installs the declared version on every machine.","+","+If you can't declare the package, force a single version with your package manager's overrides,","+such as `overrides` in pnpm and npm or `resolutions` in Yarn.","+Packages that depend on another version of it get the forced version too."],"additions":28,"deletions":0,"truncated":false},{"path":"packages/nx/src/plugins/js/lock-file/bun-parser.ts","lines":["@@ -12,6 +12,7 @@ import {","   validateDependency,"," } from '../../../project-graph/project-graph-builder';"," import { parseJson } from '../../../utils/json';","+import { BUN_TEXT_LOCK_FILE } from './lock-file-names';"," "," // Highest bun.lock version this parser has been verified against:"," // - 1: workspace packages are no longer listed with their dependencies","@@ -161,8 +162,7 @@ interface PackageIndex {","   patchedPackages: Set<string>;"," }"," ","-export const BUN_LOCK_FILE = 'bun.lockb';","-export const BUN_TEXT_LOCK_FILE = 'bun.lock';","+export { BUN_LOCK_FILE, BUN_TEXT_LOCK_FILE } from './lock-file-names';"," "," let currentLockFileHash: string;"," let cachedParsedLockFile: BunLockFile;"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/nx/src/plugins/js/lock-file/lock-file-names.ts","lines":["@@ -0,0 +1,15 @@","+// No imports: the project graph builder loads this, and must not load the lock file parsers.","+","+export const YARN_LOCK_FILE = 'yarn.lock';","+export const NPM_LOCK_FILE = 'package-lock.json';","+export const PNPM_LOCK_FILE = 'pnpm-lock.yaml';","+export const BUN_LOCK_FILE = 'bun.lockb';","+export const BUN_TEXT_LOCK_FILE = 'bun.lock';","+","+export const LOCKFILES = [","+  YARN_LOCK_FILE,","+  NPM_LOCK_FILE,","+  PNPM_LOCK_FILE,","+  BUN_LOCK_FILE,","+  BUN_TEXT_LOCK_FILE,","+];"],"additions":15,"deletions":0,"truncated":false},{"path":"packages/nx/src/plugins/js/lock-file/lock-file.ts","lines":["@@ -41,11 +41,16 @@ import {"," import { workspaceRoot } from '../../../utils/workspace-root';"," import { getWorkspacePackagesFromGraph } from '../utils/get-workspace-packages-from-graph';"," import {","-  BUN_LOCK_FILE,","-  BUN_TEXT_LOCK_FILE,","   getBunTextLockfileDependencies,","   getBunTextLock