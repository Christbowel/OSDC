an> {","+        @Override","+        public LogicalPlan apply(LogicalPlan plan) {","+            if (plan.anyMatch(NestedExpand.class::isInstance) == false) {","+                return plan;","+            }","+            return plan.transformUp(EsRelation.class, relation -> {","+                List<Attribute> visible = relation.output().stream().filter(a -> isNestedScope(a) == false).toList();","+                return visible.size() == relation.output().size() ? relation : relation.withAttributes(visible);","+            });","+        }","+","+        private static boolean isNestedScope(Attribute attribute) {","+            return attribute instanceof FieldAttribute field && field.field() instanceof NestedScopeField;","+        }","+    }","+","     /**","      * Strips any {@link DatasetShadowRelation} that {@link ResolveDatasetShadow} did not fold into a","      * sibling {@code EsRelation}. The dataset analog of {@code ViewCompaction.stripViewShadowRelations},","@@ -1751,6 +1777,7 @@ protected LogicalPlan rule(LogicalPlan plan, AnalyzerContext context) {","                 case Eval p -> resolveEval(p, childrenOutput);","                 case Enrich p -> resolveEnrich(p, childrenOutput);","                 case MvExpand p -> resolveMvExpand(p, childrenOutput);","+                case NestedExpand p -> resolveNestedExpand(p, childrenOutput);","                 case Lookup l -> resolveLookup(l, childrenOutput);","                 case LookupJoin j -> resolveLookupJoin(j, context);","                 case AbstractSubqueryJoin sj -> resolveSubqueryJoin(sj);","@@ -1766,6 +1793,140 @@ protected LogicalPlan rule(LogicalPlan plan, AnalyzerContext context) {","             return resolved;","         }"," ","+        /**","+         * Binds {@code NESTED_EXPAND} to a mapped nested collection. An unknown name stays unresolved, so the verifier","+         * reports it like any other unknown column. A name that exists but is not nested fails here.","+         */","+        private LogicalPlan resolveNestedExpand(NestedExpand expand, List<Attribute> childrenOutput) {","+            if (expand.bound()) {","+                return expand;","+            }","+            NamedExpression target = expand.target();","+            String name = target.name();","+            String rootName = NestedScopeField.PREFIX + name;","+            FieldAttribute root = null;","+            Set<String> collections = new HashSet<>();","+            for (Attribute attribute : childrenOutput) {","+                if (attribute instanceof FieldAttribute field","+                    && field.field() instanceof NestedScopeField scope","+                    && scope.kind() == NestedScopeField.Kind.COLLECTION) {","+                    collections.add(scope.path());","+                    if (field.name().equals(rootName)) {","+                        root = field;","+                    }","+                }","+            }","+            if (root == null) {","+                if (childrenOutput.stream().anyMatch(a -> inNestedPath(a.name(), name) || inNestedPath(a.name(), rootName))) {","+                    throw nestedExpandError(target, \"NESTED_EXPAND requires a mapped nested field, not [\" + name + \"]\");","+                }","+                return resolveExpressions(expand, childrenOutput);","+            }","+            NestedScopeField scope = (NestedScopeField) root.field();","+            if (scope.conflict() != null) {","+                throw nestedExpandError(target, \"NESTED_EXPAND cannot read [\" + name + \"]: \" + scope.conflict());","+            }","+            String path = scope.path();","+            if (lookupSourced(expand.child(), root.id())) {","+                throw nestedExpandError(","+                    target,","+                    \"NESTED_EXPAND cannot read [\" + name + \"] from a LOOKUP JOIN index; that index's documents are not the rows being read\"","+                );","+            }","+            if (childrenOutput.stream().anyMatch(a -> a.synthetic() == false && a.name().equals(path))) {","+                throw nestedExpandError(target, \"NESTED_EXPAND cannot use [\" + path + \"]: a column of that name replaces it here\");","+            }","+            if (collections.stream().anyMatch(parent -> path.startsWith(parent + \".\"))) {","+                throw nestedExpandError(target, \"NESTED_EXPAND supports one nesting level\");","+            }","+            checkNestedExpandReadsIndexRows(expand.child(), target);","+            List<FieldAttribute> children = new ArrayList<>();","+            for (Attribute attribute : childrenOutput) {","+                if (attribute instanceof FieldAttribute field","+                    && field.field() instanceof NestedScopeField child","+                    && inNestedPath(field.name(), rootName)) {","+                    // A child that another index nests under a different path carries a conflict: one path is read for all indices","+                    if (child.conflict() != null) {","+                        String publicName = field.name().substring(NestedScopeField.PREFIX.length());","+                        throw nestedExpandError(target, \"NESTED_EXPAND cannot read [\" + publicName + \"]: \" + child.conflict());","+                    }","+                    if (child.kind() == NestedScopeField.Kind.VALUE && child.path().equals(path)) {","+                        children.add(field);","+                    }","+                }","+            }","+            children.sort(Comparator.comparing(FieldAttribute::name));","+            List<Attribute> expanded = new ArrayList<>();","+            List<String> paths = new ArrayList<>();","+            for (FieldAttribute child : children) {","+                String relative = child.name().substring(NestedScopeField.PREFIX.length() + path.length() + 1);","+                // TODO: A child keeps only its type here. Binding it as a FieldAttribute that holds NestedScopeField#leaf would let","+                // cast resolution see a type conflict, but that needs the conversion to belong to this NestedExpand rather than to the","+                // parent relation, the same conversion applied when the child is read, and ReplaceFieldWithConstantOrNull keeping the","+                // child (SearchContextStats#exists is false for nested subfields). To be done with the execution of NESTED_EXPAND.","+                expanded.add(new ReferenceAttribute(expand.source(), path + \".\" + relative, child.dataType()));","+                paths.add(relative);","+            }","+            return new NestedExpand(expand.source(), expand.child(), null, path, expanded, paths);","+        }","+","+        private static boolean inNestedPath(String attributeName, String path) {","+            return attributeName.equals(path) || attributeName.startsWith(path + \".\");","+        }","+","+        /** The collection attribute comes from the right side of a LOOKUP JOIN, whose documents are not the input rows. */","+        private static boolean lookupSourced(LogicalPlan plan, NameId id) {","+            if (plan instanceof LookupJoin join) {","+                if (containsAttribute(join.right(), id)) {","+                    return true;","+                }","+                return containsAttribute(join.left(), id) && lookupSourced(join.left(), id);","+            }","+            if (plan instanceof EsRelation) {","+                return false;","+            }","+            for (LogicalPlan child : plan.children()) {","+                if (containsAttribute(child, id)) {","+                    return lookupSourced(child, id);","+                }","+            }","+            return false;","+        }","+","+        private static boolean containsAttribute(LogicalPlan plan, NameId id) {","+            if (plan instanceof EsRelation relation) {","+                for (Attribute attribute : relation.output()) {","+                    if (attribute.id().equals(id)) {","+                        return true;","+                    }","+                }","+            }","+            for (LogicalPlan child : plan.children()) {","+                if (containsAttribute(child, id)) {","+                    return true;","+                }","+            }","+            return false;","+        }","+","+        /** Child documents belong to a parent row. A STATS replaces those rows with groups, which have none. */","+        private static void checkNestedExpandReadsIndexRows(LogicalPlan input, Expression at) {","+            LogicalPlan plan = input;","+            while (plan instanceof EsRelation == false && plan.children().isEmpty() == false) {","+                if (plan instanceof Aggregate) {","+                    throw nestedExpandError(","+                        at,","+                        \"NESTED_EXPAND reads each row's nested documents, so it cannot follow [\" + plan.sourceText() + \"]\"","+                    );","+                }","+                plan = plan instanceof Join join ? join.left() : plan.children().getFirst();","+            }","+        }","+","+        private static VerificationException nestedExpandError(Expression expression, String message) {","+            return new VerificationException(List.of(Failure.fail(expression, message)));","+        }","+","         private LogicalPlan resolveAggregate(Aggregate aggregate, List<Attribute> childrenOutput) {","             // if the grouping is resolved but the aggs are not, use the former to resolve the latter","             // e.g. STATS a ... GROUP BY a = x + 1"],"additions":162,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/core/type/NestedScopeField.java","lines":["@@ -0,0 +1,352 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; 