{"id":"9c4b738ea3452fca9840b4cc58ef60d2342b46f1","axis":"silent","repo":"rails/rails","sha":"9c4b738ea3452fca9840b4cc58ef60d2342b46f1","parsed":{"files":[{"path":"guides/source/command_line.md","lines":["@@ -1408,6 +1408,18 @@ active_record_encryption:"," secret_key_base: 6013280bda2fcbdbeda1732859df557a067ac81c423855aedba057f7a9b14161442d9cadfc7e48109c79143c5948de848ab5909ee54d04c34f572153466fc589"," ```"," ","+To check which credentials are set without revealing their values, use the","+`:keys` command. It prints the path of every key, in the same dot notation","+accepted by `credentials:fetch`:","+","+```bash","+$ bin/rails credentials:keys","+active_record_encryption.primary_key","+active_record_encryption.deterministic_key","+active_record_encryption.key_derivation_salt","+secret_key_base","+```","+"," You can learn about credentials in the [Rails Security"," Guide](security.html#encrypted-credentials-file)."," "],"additions":12,"deletions":0,"truncated":false},{"path":"railties/CHANGELOG.md","lines":["@@ -1,3 +1,17 @@","+*   Add `bin/rails credentials:keys` to list the keys in the credentials without their values.","+","+    It prints the path of every key, one per line, in the same dot notation as `credentials:fetch`,","+    so you can check which credentials are set, for example in another environment, without revealing any secret.","+","+    ```bash","+    $ bin/rails credentials:keys --environment production","+    aws.access_key_id","+    aws.secret_access_key","+    secret_key_base","+    ```","+","+    *Alessandro Rodi*","+"," *   Stop setting `config.action_mailer.delivery_job` in `config.load_defaults`."," ","     Action Mailer already defaults to `ActionMailer::MailDeliveryJob`, and"],"additions":14,"deletions":0,"truncated":false},{"path":"railties/lib/rails/commands/credentials/USAGE","lines":["@@ -55,6 +55,13 @@ Editing Credentials:","     `config/credentials.yml.enc` while the file itself is destroyed to prevent credentials","     from leaking."," ","+Listing Credentials Keys:","+    `<%= executable(:keys) %>` prints the path of every key in the decrypted","+    credentials, one per line, without their values. The paths use the same","+    dot notation as `<%= executable(:fetch) %>`. This is handy to check which","+    credentials are set, for example in another environment, without revealing","+    any secret.","+"," Environment Specific Credentials:","     The `credentials` command supports passing an `--environment` option to create an","     environment specific override. That override will take precedence over the"],"additions":7,"deletions":0,"truncated":false},{"path":"railties/lib/rails/commands/credentials/credentials_command.rb","lines":["@@ -86,7 +86,25 @@ def fetch(path)","         exit 1","       end"," ","+      desc \"keys\", \"List the paths of the keys in the decrypted credentials, without their values\"","+      def keys","+        load_environment_config!","+","+        if credentials.read.present?","+          say key_paths(credentials.config).join(\"\\n\")","+        else","+          missing_credentials!","+        end","+      end","+","       private","+        def key_paths(hash, prefix = nil)","+          hash.flat_map do |key, value|","+            path = prefix ? \"#{prefix}.#{key}\" : key.to_s","+            value.is_a?(Hash) ? key_paths(value, path) : path","+          end","+        end","+","         def config","           Rails.application.config.credentials","         end"],"additions":18,"deletions":0,"truncated":false},{"path":"railties/test/command/base_test.rb","lines":["@@ -14,7 +14,7 @@ class Rails::Command::BaseTest < ActiveSupport::TestCase","   end"," ","   test \"printing commands returns namespaced commands\" do","-    assert_equal %w(credentials:edit credentials:show credentials:diff credentials:fetch), Rails::Command::CredentialsCommand.printing_commands.map(&:first)","+    assert_equal %w(credentials:edit credentials:show credentials:diff credentials:fetch credentials:keys), Rails::Command::CredentialsCommand.printing_commands.map(&:first)","     assert_equal %w(db:system:change), Rails::Command::Db::System::ChangeCommand.printing_commands.map(&:first)","   end"," "],"additions":1,"deletions":1,"truncated":false},{"path":"railties/test/commands/credentials_test.rb","lines":["@@ -398,6 +398,36 @@ class Rails::Command::CredentialsTest < ActiveSupport::TestCase","     assert_match(\"Invalid or missing credential path: egg.spam\", stderr_output)","   end"," ","+  test \"keys lists the path of every key without the values\" do","+    write_credentials <<~YAML","+      # Commented out: true","+      foo:","+        bar:","+          baz: secret-baz","+        qux: secret-qux","+      list: [secret-1, secret-2]","+      empty:","+    YAML","+","+    output = run_keys_command","+    assert_equal \"foo.bar.baz\\nfoo.qux\\nlist\\nempty\\n\", output","+    assert_no_match \"secret\", output","+  end","+","+  test \"keys command lists keys of the credentials specified by environment option\" do","+    write_credentials \"foo: bar\", environment: \"production\"","+","+    assert_equal \"foo\\n\", run_keys_command(environment: \"production\")","+  end","+","+  test \"keys command does not raise error when require_master_key is false and master key does not exist\" do","+    remove_file \"config/master.key\"","+    add_to_config \"config.require_master_key = false\"","+","+    stderr_output = capture(:stderr) { run_keys_command(stderr: true, allow_failure: true) }","+    assert_match(/Missing 'config\\/master\\.key' to decrypt credentials/, stderr_output)","+  end","+","   private","     DEFAULT_CREDENTIALS_PATTERN = /access_key_id: 123\\n.*secret_key_base: \\h{128}\\n/m"," ","@@ -424,6 +454,11 @@ def run_fetch_command(path, **options)","       rails \"credentials:fetch\", path, **options","     end"," ","+    def run_keys_command(environment: nil, **options)","+      args = environment ? [\"--environment\", environment] : []","+      rails \"credentials:keys\", args, **options","+    end","+","     def write_credentials(content, **options)","       switch_env(\"CONTENT\", content) do","         run_edit_command(visual: %(ruby -e \"File.write ARGV[0], ENV['CONTENT']\"), **options)",""],"additions":35,"deletions":0,"truncated":false}],"additions":87,"deletions":1,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-28T17:10:30.778003+00:00"}