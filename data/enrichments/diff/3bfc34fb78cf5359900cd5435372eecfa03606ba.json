ative thread exit callbacks.","+//@only-target: linux darwin","+//@ignore-target: android","+//@run-native","+","+use std::{ffi, mem, ptr};","+","+pub type Key = libc::pthread_key_t;","+","+pub unsafe fn create(dtor: Option<unsafe extern \"C\" fn(*mut u8)>) -> Key {","+    let mut key = 0;","+    assert_eq!(libc::pthread_key_create(&mut key, mem::transmute(dtor)), 0);","+    key","+}","+","+pub unsafe fn set(key: Key, value: *mut u8) {","+    let r = libc::pthread_setspecific(key, value as *mut _);","+    assert_eq!(r, 0);","+}","+","+unsafe extern \"C\" fn dtor(_ptr: *mut u8) {","+    eprintln!(\"pthread key dtor\");","+}","+","+fn register_native<F>(f: F)","+where","+    F: FnOnce() + 'static,","+{","+    // This will receive the pointer passed into `_tlv_atexit`, which is the","+    // original `f` but boxed up.","+    unsafe extern \"C\" fn run<F>(ptr: *mut ffi::c_void)","+    where","+        F: FnOnce() + 'static,","+    {","+        let f = unsafe { Box::from_raw(ptr as *mut F) };","+        f()","+    }","+","+    cfg_select! {","+        target_os = \"linux\" => {","+            extern \"C\" {","+                #[allow(improper_ctypes)]","+                static __dso_handle: ();","+","+                fn __cxa_thread_atexit_impl(","+                    dtor: unsafe extern \"C\" fn(*mut ffi::c_void),","+                    arg: *mut ffi::c_void,","+                    dso: *const ffi::c_void,","+                ) -> ffi::c_int;","+            }","+","+            let ret = unsafe {","+                __cxa_thread_atexit_impl(","+                    run::<F>,","+                    Box::into_raw(Box::new(f)) as *mut ffi::c_void,","+                    &raw const __dso_handle as *const ffi::c_void,","+                )","+            };","+            assert_eq!(ret, 0);","+        }","+        target_vendor = \"apple\" => {","+            extern \"C\" {","+                fn _tlv_atexit(dtor: unsafe extern \"C\" fn(*mut ffi::c_void), arg: *mut ffi::c_void);","+            }","+            unsafe { _tlv_atexit(run::<F>, Box::into_raw(Box::new(f)) as *mut ffi::c_void) };","+        }","+    }","+}","+","+fn main() {","+    let t = std::thread::spawn(|| unsafe {","+        let key = create(Some(dtor));","+        set(key, ptr::without_provenance_mut(1));","+        register_native(|| eprintln!(\"native thread atexit\"));","+    });","+    t.join().unwrap()","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"src/tools/miri/tests/pass-dep/concurrency/pthread_key_drop_thread_atexit_order.stderr","lines":["@@ -0,0 +1,2 @@","+native thread atexit","+pthread key dtor"],"additions":2,"deletions":0,"truncated":false},{"path":"src/tools/miri/tests/pass/concurrency/threadname.rs","lines":["@@ -1,3 +1,4 @@","+use std::sync::Mutex;"," use std::thread;"," "," fn main() {","@@ -31,4 +32,38 @@ fn main() {"," ","     // Also check main thread name.","     assert_eq!(thread::current().name().unwrap(), \"main\");","+","+    // Thread name during TLS dtor.","+    during_dtor();","+}","+","+fn during_dtor() {","+    // Go through one round of TLS destruction first.","+    struct Defer;","+    impl Drop for Defer {","+        fn drop(&mut self) {","+            RETRIEVE.with(|_| {});","+        }","+    }","+","+    struct RetrieveName;","+    impl Drop for RetrieveName {","+        fn drop(&mut self) {","+            *NAME.lock().unwrap() = Some(thread::current().name().unwrap().to_owned());","+        }","+    }","+","+    static NAME: Mutex<Option<String>> = Mutex::new(None);","+","+    thread_local! {","+        static DEFER: Defer = const { Defer };","+        static RETRIEVE: RetrieveName = const { RetrieveName };","+    }","+","+    let t = thread::Builder::new().name(\"test\".to_owned()).spawn(|| DEFER.with(|_| {})).unwrap();","+    t.join().unwrap();","+","+    let name = NAME.lock().unwrap();","+    let name = name.as_ref().unwrap();","+    assert_eq!(name, \"test\");"," }",""],"additions":35,"deletions":0,"truncated":false}],"additions":176,"deletions":82,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-26T14:32:31.239658+00:00"}