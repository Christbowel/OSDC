orp. 2016, 2025","+ * Copyright IBM Corp. 2016, 2026","  * SPDX-License-Identifier: BUSL-1.1","  */"," "," import ApplicationSerializer from './application';","-import { EmbeddedRecordsMixin } from '@ember-data/serializer/rest';"," import engineDisplayData from 'vault/helpers/engines-display-data';"," ","-export default ApplicationSerializer.extend(EmbeddedRecordsMixin, {","-  attrs: {","-    config: { embedded: 'always' },","-  },","-","+export default ApplicationSerializer.extend({","   normalize(modelClass, data) {","-    // embedded records need a unique value to be stored","-    // set id for config to uuid of secret engine","-    if (data.config && !data.config.id) {","-      data.config.id = data.uuid;","-    }","     // move version out of options so it can be defined on secret-engine model","     data.version = data.options ? data.options.version : null;","     return this._super(modelClass, data);","@@ -81,14 +71,13 @@ export default ApplicationSerializer.extend(EmbeddedRecordsMixin, {","   serialize(snapshot) {","     const type = snapshot.record.engineType;","     const data = this._super(...arguments);","+    data.config = { ...data.config };","     // move version back to options","     data.options = data.version ? { version: data.version } : {};","     delete data.version;"," ","     if (!engineDisplayData(type)?.isWIF) {","-      // only send identity_token_key if it's set on a WIF secret engine.","-      // because of issues with the model unloading with a belongsTo relationships","-      // identity_token_key can accidentally carry over if a user backs out of the form and changes the type from WIF to non-WIF.","+      // Only WIF engines accept identity_token_key.","       delete data.config.identity_token_key;","     }"," "],"additions":4,"deletions":15,"truncated":false},{"path":"ui/e2e/tests/readonly/mount-config.spec.ts","lines":["@@ -0,0 +1,119 @@","+/**","+ * Copyright IBM Corp. 2026","+ * SPDX-License-Identifier: BUSL-1.1","+ */","+","+import { expect, type Page } from '@playwright/test';","+import { highlightElement, holdForVideo, test } from '../../fixtures/demo';","+import { ensureMount, rootApi } from '../../fixtures/root-api';","+","+const MOUNT = 'readonly-kv/mount-config';","+","+interface TuneConfig {","+  default_lease_ttl: number;","+  max_lease_ttl: number;","+}","+","+const readToken = (page: Page) =>","+  page.evaluate(() => {","+    const key = Object.keys(localStorage).find((item) => item.startsWith('vault-token'));","+    if (!key) throw new Error('No stored Vault token');","+    const value = localStorage.getItem(key);","+    if (!value) throw new Error('No stored Vault token value');","+    const token = (JSON.parse(value) as { token?: string }).token;","+    if (!token) throw new Error('Stored Vault token is empty');","+    return token;","+  });","+","+const readTuneConfig = async (page: Page): Promise<TuneConfig> => {","+  const response = await page.request.get(`/v1/sys/mounts/${MOUNT}/tune`, {","+    headers: { 'X-Vault-Token': await readToken(page) },","+  });","+  await expect(response).toBeOK();","+  const { data }: { data: TuneConfig } = await response.json();","+  return data;","+};","+","+const removeMountIfPresent = async (api: Awaited<ReturnType<typeof rootApi>>) => {","+  const response = await api.get('/v1/sys/mounts');","+  await expect(response).toBeOK();","+  const { data } = await response.json();","+  if (Object.prototype.hasOwnProperty.call(data, `${MOUNT}/`)) {","+    await expect(await api.delete(`/v1/sys/mounts/${MOUNT}`)).toBeOK();","+  }","+};","+","+test.beforeAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  try {","+    await ensureMount(api, MOUNT, 'kv-v2');","+    await expect(","+      await api.post(`/v1/sys/mounts/${MOUNT}/tune`, {","+        data: { default_lease_ttl: '2h', max_lease_ttl: '4h' },","+      })","+    ).toBeOK();","+  } finally {","+    await api.dispose();","+  }","+});","+","+test.afterAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  try {","+    await removeMountIfPresent(api);","+  } finally {","+    await api.dispose();","+  }","+});","+","+// A read-only token may inspect mount settings but must not persist configuration changes.","+test('read-only user cannot tune mount configuration', async ({ page }) => {","+  let configurationUrl = '';","+  await test.step('open the seeded mount configuration', async () => {","+    await page.goto('secrets-engines');","+    const mountRow = page.getByRole('row').filter({ hasText: `${MOUNT}/` });","+    await mountRow.getByRole('button', { name: 'Options' }).click();","+    await page.getByRole('link', { name: 'View configuration' }).click();","+","+    await expect(page.getByRole('form', { name: 'general settings form' })).toBeVisible();","+    await expect(page.getByLabel('Default time-to-live (TTL)time')).toHaveValue('2');","+    await expect(page.getByLabel('Default time-to-live (TTL)unit')).toHaveValue('h');","+    await expect(page.getByLabel('Maximum time-to-live (TTL)time')).toHaveValue('4');","+    await expect(page.getByLabel('Maximum time-to-live (TTL)unit')).toHaveValue('h');","+    configurationUrl = page.url();","+  });","+","+  await test.step('denied tune leaves backend configuration unchanged', async () => {","+    await page.goto(configurationUrl);","+    await page.getByLabel('Default time-to-live (TTL)time').fill('3');","+    const tuneResponsePromise = page.waitForResponse(","+      (response) =>","+        decodeURIComponent(new URL(response.url()).pathname) === `/v1/sys/mounts/${MOUNT}/tune` &&","+        response.request().method() === 'POST'","+    );","+    await page.getByRole('button', { name: 'Save changes' }).click();","+    const response = await tuneResponsePromise;","+    expect(response.status()).toBe(403);","+    await expect(page.getByText(/permission denied/i)).toBeVisible();","+    await highlightElement(page, page.getByText(/permission denied/i));","+    await holdForVideo(page);","+    await test.info().attach('denied-mount-tune', {","+      body: JSON.stringify({","+        method: response.request().method(),","+        status: response.status(),","+        payload: response.request().postDataJSON(),","+      }),","+      contentType: 'application/json',","+    });","+","+    const persisted = await readTuneConfig(page);","+    expect(persisted).toMatchObject({ default_lease_ttl: 7200, max_lease_ttl: 14400 });","+","+    await page.goto('secrets-engines');","+    const mountRow = page.getByRole('row').filter({ hasText: `${MOUNT}/` });","+    await mountRow.getByRole('button', { name: 'Options' }).click();","+    await page.getByRole('link', { name: 'View configuration' }).click();","+    await expect(page.getByLabel('Default time-to-live (TTL)time')).toHaveValue('2');","+    await expect(page.getByLabel('Maximum time-to-live (TTL)time')).toHaveValue('4');","+  });","+});"],"additions":119,"deletions":0,"truncated":false},{"path":"ui/e2e/tests/superuser/mount-config.spec.ts","lines":["@@ -0,0 +1,168 @@","+/**","+ * Copyright IBM Corp. 2026","+ * SPDX-License-Identifier: BUSL-1.1","+ */","+","+import { expect, type Page } from '@playwright/test';","+import { highlightElement, holdForVideo, test } from '../../fixtures/demo';","+import { rootApi } from '../../fixtures/root-api';","+import { BasePage } from '../../pages/base';","+import { ConfigurationSettingsPage } from '../../pages/configuration-settings';","+","+const MOUNT = 'mount-config-superuser';","+","+interface TuneConfig {","+  default_lease_ttl: number;","+  max_lease_ttl: number;","+}","+","+const readToken = (page: Page) =>","+  page.evaluate(() => {","+    const key = Object.keys(localStorage).find((item) => item.startsWith('vault-token'));","+    if (!key) throw new Error('No stored Vault token');","+    const value = localStorage.getItem(key);","+    if (!value) throw new Error('No stored Vault token value');","+    const token = (JSON.parse(value) as { token?: string }).token;","+    if (!token) throw new Error('Stored Vault token is empty');","+    return token;","+  });","+","+const readTuneConfig = async (page: Page): Promise<TuneConfig> => {","+  const response = await page.request.get(`/v1/sys/mounts/${MOUNT}/tune`, {","+    headers: { 'X-Vault-Token': await readToken(page) },","+  });","+  await expect(response).toBeOK();","+  const { data }: { data: TuneConfig } = await response.json();","+  return data;","+};","+","+const removeMountIfPresent = async (api: Awaited<ReturnType<typeof rootApi>>) => {","+  const response = await api.get('/v1/sys/mounts');","+  await expect(response).toBeOK();","+  const { data } = await response.json();","+  if (Object.prototype.hasOwnProperty.call(data, `${MOUNT}/`)) {","+    await expect(await api.delete(`/v1/sys/mounts/${MOUNT}`)).toBeOK();","+  }","+};","+","+test.beforeAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  try {","+    await removeMountIfPresent(api);","+  } finally {","+    await api.dispose();","+  }","+});","+","+test.afterAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  try {","+    await removeMountIfPresent(api);","+  } finally {","+    await api.dispose();","+  }","+});","+","+// Mount configuration must remain readable and durable through the Resource-backed UI.","+test('superuser can mount and persist secrets engine configuration', async ({ page }) => {","+  const basePage = new BasePage(page);","+  const configurationSettingsPage = new ConfigurationSettingsPage(page);","+","+  await test.step('mount KV with known TTL values', async () => {","+    const createResponsePromise = page.waitForResponse(","+      (response) =>","+        response.url().endsWith(`/v1/sys/mounts/${MOUNT}`) && response.request().method() === 'POST'","+    );","+    await basePage.enableEngine('kv', MOUNT, { skipEnable: true });","+    await page.getByRole('button', { name: 'View additional settings' }).click();","+    await page.locator('label').filter({ hasText: 'Default Lease TTL Vault will' }).click();","+    await page.getByLabel('TTL unit for Default Lease TTL').selectOption('h');","+    await page","+      .getByRole('group', { name: 'Default Lease TTL Lease will' })","+      .getByLabel('Number of units')","+      .fill('2');","+    await page.locator('label').filter({ hasText: 'Max Lease TTL Vault will' }).click();","+    await page.getByLabel('TTL unit for Max Lease TTL').selectOption('h');","+    await page","+      .getByRole('group', { name: 'Max Lease TTL Lease will' })","+      .getByLabel('Number of units')","+      .fill('4');","+    await page.getByRole('button', { name: 'Enable engine' }).click();","+","+    const response = await createResponsePromise;","+    expect(response.ok()).toBe(true);","+    expect(new URL(response.url()).pathname).toBe(`/v1/sys/mounts/${MOUNT}`);","+    expect(response.request().postDataJSON()).toMatchObject({","+      type: 'kv',","+      config: { default_lease_ttl: '7200s', max_lease_ttl: '14400s' },","+      options: { version: 2 },","+    });","+","+    const persisted = await readTuneConfig(page);","+    expect(persisted).toMatchObject({ default_lease_ttl: 7200, max_lease_ttl: 14400 });","+    await test.info().attach('mount-create-readback', {","+      body: JSON.stringify({ status: response.status(), config: persisted }),","+      contentType: 'application/json',","+    });","+  });","+","+  await test.step('mount remains listed after reload', async () => {","+    await page.goto('secrets-engines');","+    const mountLink = page.getByRole('link', { name: `${MOUNT}/`, exact: true });","+    await expect(mountLink).toBeVisible();","+    await page.reload();","+    await expect(page.getByRole('link', { name: `${MOUNT}/`, exact: true })).toBeVisible();","+  });","+","+  await test.step('read and update mount TTL configuration', async () => {","+    await page.goto('secrets-engines');","+    await page.getByRole('link', { name: `${MOUNT}/`, exact: true }).click();","+    await configurationSettingsPage.navigateToConfiguration(MOUNT);","+    await configurationSettingsPage.navigateToGeneralSettings('kv');","+","+    await expect(page.getByLabel('Default time-to-live (TTL)time')).toHaveValue('2');","+    await expect(page.getByLabel('Default time-to-live (TTL)unit')).toHaveValue('h');","+    await expect(page.getByLabel('Maximum time-to-live (TTL)time')).toHaveValue('4');","+    await expect(page.getByLabel('Maximum time-to-live (TTL)unit')).toHaveValue('h');","+","+    await page.getByLabel('Default time-to-live (TTL)time').fill('5');","+    await page.getByLabel('Maximum time-to-live (TTL)time').fill('6');","+    const tuneResponsePromise = page.waitForResponse(","+      (response) =>","+        response.url().endsWith(`/v1/sys/mounts/${MOUNT}/tune`) && response.request().method() === 'POST'","+    );","+    await page.getByRole('button', { name: 'Save changes' }).click();","+    const response = await tuneResponsePromise;","+    expect(response.ok()).toBe(true);","+    expect(response.request().postDataJSON()).toMatchObject({","+      default_lease_ttl: '5h',","+      max_lease_ttl: '6h',","+    });","+    await expect(page.getByRole('alert', { name: 'Configuration saved' })).toBeVisible();","+","+    const persisted = await readTuneConfig(page);","+    expect(persisted).toMatchObject({ default_lease_ttl: 18000, max_lease_ttl: 21600 });","+    await test.info().attach('mount-tune-readback', {","+      body: JSON.stringify({","+        method: response.request().method(),","+        status: response.status(),","+        payload: response.request().postDataJSON(),","+        persisted,","+      }),","+      contentType: 'application/json',","+    });","+  });","+","+  await test.step('persisted TTL values survive reopening General Settings', async () => {","+    await page.goto('secrets-engines');","+    awa