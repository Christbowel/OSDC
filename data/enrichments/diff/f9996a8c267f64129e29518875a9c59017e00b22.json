m.facebook.react.internal.featureflags.ReactNativeFeatureFlagsForTests","+import com.facebook.testutils.shadows.ShadowArguments","+import org.junit.After","+import org.junit.Before","+import org.junit.Test","+import org.junit.runner.RunWith","+import org.mockito.kotlin.any","+import org.mockito.kotlin.argumentCaptor","+import org.mockito.kotlin.atLeastOnce","+import org.mockito.kotlin.clearInvocations","+import org.mockito.kotlin.eq","+import org.mockito.kotlin.mock","+import org.mockito.kotlin.never","+import org.mockito.kotlin.times","+import org.mockito.kotlin.verify","+import org.robolectric.RobolectricTestRunner","+import org.robolectric.Shadows.shadowOf","+import org.robolectric.annotation.Config","+","+@Config(shadows = [ShadowArguments::class])","+@RunWith(RobolectricTestRunner::class)","+class JavaTimerManagerTest {","+  private lateinit var reactChoreographer: ReactChoreographer","+  private lateinit var timerExecutor: JavaScriptTimerExecutor","+","+  @Before","+  fun setUp() {","+    ReactNativeFeatureFlagsForTests.setUp()","+    reactChoreographer = mock()","+    timerExecutor = mock()","+  }","+","+  @After","+  fun tearDown() {","+    ReactNativeFeatureFlags.dangerouslyReset()","+  }","+","+  private fun newTimerManager(keepTimersRunningWhileHostPaused: Boolean): JavaTimerManager {","+    ReactNativeFeatureFlags.dangerouslyReset()","+    ReactNativeFeatureFlags.override(","+        object : ReactNativeFeatureFlagsDefaults() {","+          override fun keepTimersRunningWhileHostPausedAndroid(): Boolean =","+              keepTimersRunningWhileHostPaused","+        }","+    )","+    val timerManager =","+        JavaTimerManager(","+            mock<ReactApplicationContext>(),","+            timerExecutor,","+            reactChoreographer,","+            mock<DevSupportManager>(),","+        )","+    shadowOf(Looper.getMainLooper()).idle()","+    return timerManager","+  }","+","+  private fun postedTimerCallback(): Choreographer.FrameCallback {","+    