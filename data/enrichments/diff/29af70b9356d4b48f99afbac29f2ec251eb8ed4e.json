    let before = now_millis();","+    write(&org, \"example\", &packument(\"example\", &[\"1.0.0\"])).await;","+    storage","+        .sql_metadata()","+        .set_version_note(","+            &npm(\"example\"),","+            \"\",","+            \"1.0.0\",","+            crate::metadata::NoteChange {","+                text: Some(\"a note\".to_string()),","+                principal: \"publisher\".to_string(),","+            },","+        )","+        .await","+        .unwrap();","+    let adapter = db.adapter();","+    tokio::task::spawn_blocking(move || {","+        adapter.read(ReadSource::Primary, &mut |connection| assert_timestamps(connection, before))?;","+        Ok::<_, pnpr_error::RegistryError>(())","+    })","+    .await","+    .unwrap()","+    .unwrap();","+}","+","+fn assert_timestamps(connection: &dyn Connection, before: i64) -> pnpr_error::Result<()> {","+    for columns in [","+        (\"versions\", \"published_at\"),","+        (\"publications\", \"committed_at\"),","+        (\"tag_history\", \"changed_at\"),","+        (\"notes\", \"modified_at\"),","+        (\"note_history\", \"changed_at\"),","+    ] {","+        assert_timestamp_column(connection, columns, before)?;","+    }","+    Ok(())","+}","+","+fn assert_timestamp_column(","+    connection: &dyn Connection,","+    (table, column): (&str, &str),","+    before: i64,","+) -> pnpr_error::Result<()> {","+    let rows =","+        connection.query(&format!(\"SELECT {column}, typeof({column}) FROM {table}\"), params![])?;","+    assert!(!rows.is_empty(), \"{table}\");","+    for mut row in rows {","+        assert_eq!(row.get::<String>(1)?, \"integer\", \"{table}\");","+        let millis: i64 = row.get(0)?;","+        if table == \"versions\" {","+            assert_eq!(iso_from_unix_millis(millis), \"2026-01-01T00:00:00.000Z\");","+        } else {","+            assert!((before..=now_millis()).contains(&millis), \"{table}: {millis}\");","+        }","+    }","+    Ok(())","+}","+","+a