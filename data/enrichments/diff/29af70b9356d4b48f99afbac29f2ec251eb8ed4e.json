S blobs_by_state ON blobs (catalog, ecosystem, state);"," "," -- Each public file name of a package, mapped to the blob holding its bytes,"," -- by the commit that publishes it or an image blob's upload, and dropped","+-- with its version or package."," CREATE TABLE IF NOT EXISTS artifact_blobs (","     catalog TEXT NOT NULL,","     ecosystem TEXT NOT NULL,","@@ -286,8 +288,8 @@ CREATE INDEX IF NOT EXISTS artifact_blobs_by_integrity"," -- of its bytes ahead of the commit that claims it. The bytes stay in the"," -- hosted store under `<digest>.<incarnation>`. `state` is `incomplete`,"," -- `complete`, or `gone`; never removed, so incarnations only grow and a key","+-- a sweep may remove is never written again. `staged_at` is `0` once given","+-- back or claimed."," CREATE TABLE IF NOT EXISTS staged_archives (","     principal TEXT NOT NULL,","     digest TEXT NOT NULL,","@@ -321,7 +323,7 @@ CREATE TABLE IF NOT EXISTS removed_packages (","     ecosystem TEXT NOT NULL,","     name TEXT NOT NULL,","     maintainers TEXT NOT NULL,","-    unpublished_at TEXT NOT NULL,","+    unpublished_at INTEGER NOT NULL,","     unpublished_by TEXT,","     PRIMARY KEY (catalog, ecosystem, name)"," ) STRICT, WITHOUT ROWID;"],"additions":12,"deletions":6,"truncated":false},{"path":"pnpr/crates/storage/src/metadata/sql/tags.rs","lines":["@@ -10,7 +10,7 @@ use super::{"," };"," use crate::{","     metadata::{TagChange, TagUpdate, validate_dist_tag, validate_dist_tag_target},","-    publish::now_iso,","+    publish::{iso_from_unix_millis, now_iso, now_millis},"," };"," use pnpr_error::Result;"," use pnpr_package_name::Ecosystem;","@@ -90,7 +90,7 @@ pub(super) fn record_tag_move(commit: &Commit<'_>, change: &TagMove<'_>) -> Resu","             change.previous,","             change.target,","             change.principal,","-            now_iso(),","+            now_millis(),","         ],","     )?;","     Ok(())","@@ -241,7 +241,7 @@ pub(super) fn tag_history(","                 previous: r