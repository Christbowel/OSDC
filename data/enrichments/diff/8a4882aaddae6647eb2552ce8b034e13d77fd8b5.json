{"id":"8a4882aaddae6647eb2552ce8b034e13d77fd8b5","axis":"silent","repo":"foundry-rs/foundry","sha":"8a4882aaddae6647eb2552ce8b034e13d77fd8b5","parsed":{"files":[{"path":"crates/anvil/src/eth/backend/mem/mod.rs","lines":["@@ -3673,11 +3673,14 @@ impl<N: Network> Backend<N> {","                 inner: mut request,","                 ..","             }) => {","-                // Tempo charges the account-creation cost for nonce 0, so an omitted nonce must","-                // not default to it.","-                if self.is_tempo() && request.nonce.is_none() {","-                    request.nonce =","-                        Some(tempo_nonce(state, request.from.unwrap_or_default(), U256::ZERO)?);","+                // Account-creation gas depends on the nonce: EIP-8037 checks the address a","+                // creation would deploy to, and Tempo charges for nonce 0. So an omitted nonce","+                // must not default to 0. revm rejects a transaction nonce of `u64::MAX` even","+                // without the nonce check, so such a sender keeps the default outside Tempo,","+                // where falling back to 0 would incorrectly charge account-creation gas.","+                if request.nonce.is_none() {","+                    let nonce = tempo_nonce(state, request.from.unwrap_or_default(), U256::ZERO)?;","+                    request.nonce = (self.is_tempo() || nonce != u64::MAX).then_some(nonce);","                 }","                 self.prepare_base_call_env_with_base(","                     WithOtherFields::new(request),"],"additions":8,"deletions":5,"truncated":false},{"path":"crates/anvil/tests/it/gas.rs","lines":["@@ -850,3 +850,40 @@ async fn test_estimate_gas_transfers_across_hardforks() {","         }","     }"," }","+","+// <https://github.com/foundry-rs/foundry/issues/17540>","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_estimate_gas_create_without_nonce_amsterdam() {","+    let (api, handle) =","+        spawn(NodeConfig::test().with_hardfork(Some(EthereumHardfork::Amsterdam.into()))).await;","+    let provider = handle.http_provider();","+    let from = handle.dev_accounts().next().unwrap();","+    // An empty creation pays 24000 regular gas plus 183600 EIP-8037 account-creation state gas.","+    let expected = 207_600;","+","+    // After the first creation, the address for nonce 0 is no longer empty, but later creations","+    // still create a new account at the address for the sender's current nonce.","+    for _ in 0..2 {","+        let tx = TransactionRequest::default().with_from(from).with_deploy_code(Bytes::new());","+        assert_eq!(","+            provider.estimate_gas(WithOtherFields::new(tx.clone())).await.unwrap(),","+            expected","+        );","+","+        let receipt = provider","+            .send_transaction(WithOtherFields::new(tx.with_gas_limit(expected)))","+            .await","+            .unwrap()","+            .get_receipt()","+            .await","+            .unwrap();","+        assert!(receipt.status());","+        assert_eq!(receipt.gas_used, expected);","+    }","+","+    // A call without a nonce still runs for a sender whose nonce cannot be incremented.","+    let maxed = handle.dev_accounts().nth(1).unwrap();","+    api.anvil_set_nonce(maxed, U256::from(u64::MAX)).await.unwrap();","+    let call = TransactionRequest::default().with_from(maxed).with_to(from);","+    provider.call(WithOtherFields::new(call)).await.unwrap();","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"crates/anvil/tests/it/tempo.rs","lines":["@@ -4869,7 +4869,7 @@ async fn test_gas_estimation_with_value_fails() {"," /// as a first transaction, which Tempo charges the account-creation cost for."," #[tokio::test(flavor = \"multi_thread\")]"," async fn test_gas_estimation_without_nonce_uses_sender_nonce() {","-    let (_api, handle) = spawn(NodeConfig::test_tempo()).await;","+    let (api, handle) = spawn(NodeConfig::test_tempo()).await;","     let provider = handle.http_provider();"," ","     let accounts: Vec<Address> = handle.dev_accounts().collect();","@@ -4891,6 +4891,27 @@ async fn test_gas_estimation_without_nonce_uses_sender_nonce() {","     let without_nonce = provider.estimate_gas(WithOtherFields::new(tx.clone())).await.unwrap();","     let with_nonce = provider.estimate_gas(WithOtherFields::new(tx.nonce(nonce))).await.unwrap();","     assert_eq!(without_nonce, with_nonce);","+","+    // A maximum sender nonce must still be rejected, not priced as a first transaction.","+    api.anvil_set_nonce(sender, U256::from(u64::MAX)).await.unwrap();","+    let tx = TransactionRequest::default().from(sender).to(accounts[1]).gas_price(0);","+    assert_eq!(","+        provider.estimate_gas(WithOtherFields::new(tx.clone())).await.unwrap_err().to_string(),","+        \"server returned an error response: error code -32003: nonce has max value\"","+    );","+    assert_eq!(","+        provider","+            .call(WithOtherFields::new(tx.clone().with_gas_limit(100_000)))","+            .await","+            .unwrap_err()","+            .to_string(),","+        \"server returned an error response: error code -32003: nonce has max value\"","+    );","+","+    // Explicit nonces remain usable when the call's nonce check is disabled.","+    let tx = tx.nonce(1);","+    assert_eq!(provider.estimate_gas(WithOtherFields::new(tx.clone())).await.unwrap(), 21_000);","+    provider.call(WithOtherFields::new(tx.with_gas_limit(100_000))).await.unwrap();"," }"," "," // ============================================================================",""],"additions":22,"deletions":1,"truncated":false}],"additions":67,"deletions":6,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-13T15:27:41.466930+00:00"}