;","+        int hr = sos.GetReJITInformation((ClrDataAddress)MethodDescAddress, RejitId, &data);","+","+        Assert.Equal(S_OK, hr);","+        Assert.Equal(DacpReJitData2.Flags.kUnknown, data.flags);","+        Assert.Equal((uint)RejitId, data.rejitID);","+    }","+}",""],"additions":47,"deletions":0,"truncated":false}],"additions":86,"deletions":6,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-17T12:26:14.949682+00:00"}