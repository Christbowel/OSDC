,"+import { loader } from '../../library.js';","+","+// Config","+const config = await loader.config('default');","+","+// A page is a module such as \"account/login.js\": folders and file name made of","+// letters, numbers, \"_\" and \"-\". There is deliberately no \".\" other than the","+// extension, so \"../\" can never reach a script outside the pages folder.","+const path_pattern = /^[\\w\\/-]+\\.js$/;","+","+// Attribute names come from the query string, so only plain names are passed","+// on - and never on* names, which would be event handlers (onclick, ...).","+const attribute_pattern = /^(?!on)[a-z_][\\w-]*$/i;","+","+function escapeAttribute(value) {","+    return value.replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');","+}","+","+customElements.define('nav-dialog', class extends WebComponent {","+    static observedAttributes = ['src'];","+","+    constructor() {","+        super();","+","+        this.data = new Map();","+    }","+","+    states() { ","+        return {","+            open: false","+        };","+    }","+","+    async render() {","+\t// Get the source HTML to load","+\t\tif (!this.hasAttribute('src') || !this.getAttribute('src')) return;","+\t\t","+\t\tconsole.log('Dialog src changed:', this.getAttribute('src'));","+\t\t","+    \tlet [ path, query ] = this.getAttribute('src').split('?');","+","+        try {","+            if (!path_pattern.test(path)) {","+                throw new Error('Invalid page path');","+            }","+","+            if (!this.data.has(path)) {","+                let response = await import(config.get('config_path') + path);","+","+\t\t\t\tconsole.log('Imported module for path:', response, config.get('config_path') + path);","+","+\t\t\t\tlet tag = customElements.getName(response.default);","+\t\t\t\t","+\t\t\t\tconsole.log('Custom element tag for module:', tag);","+","+                if (!tag) {","+                    throw new Error('Module does not export a defined component as its default');","+                }","+","+                this.data.set(path, tag);","+            }","+","+            //if (request !== this.request) return;","+","+            let name = this.data.get(path);","+","+            let html = '<' + name;","+","+            for (let [ key, value] of (new URLSearchParams(query).entries())) {","+                if (!attribute_pattern.test(key)) continue;","+","+                html += ' ' + key + '=\"' + escapeAttribute(value) + '\"';","+            }","+\t\t\t","+\t\t\thtml += '></' + name + '>';","+","+\t\t\tconsole.log('Generated HTML for modal:', html);","+","+\t\t\tthis.modal.innerHTML !== undefined ? this.modal.innerHTML = html : '';","+        } catch (error) {","+            console.error('nav-include: could not load \"' + this.getAttribute('src') + '\"', error);","+","+            return '<div class=\"alert alert-danger\">The page could not be loaded.</div>';","+        }","+    }","+    ","+\tasync show() {","+        if (!this.modal.open) this.modal.showModal();","+    }","+","+    close() {","+        if (this.modal?.open) this.modal.close();","+\t}","+\t","+\tasync stateOpen(value) {","+\t\tconsole.log(value);","+\t\tconsole.log(this.modal);","+\t\t","+        return value ? await this.modal.showModal() : this.modal.close();","+    }","+","+    close() {","+        if (this.modal?.state.get('open')) this.modal.state.set('open', false);","+    }","+});","\\ No newline at end of file"],"additions":106,"deletions":0,"truncated":false},{"path":"upload/assets/framework/component/nav/include.js","lines":["@@ -17,7 +17,7 @@ function escapeAttribute(value) {","     return value.replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');"," }"," ","-customElements.define('nav-include', class Include extends WebComponent {","+customElements.define('nav-include', class extends WebComponent {","     static observedAttributes = ['src'];"," ","     constructor() {","@@