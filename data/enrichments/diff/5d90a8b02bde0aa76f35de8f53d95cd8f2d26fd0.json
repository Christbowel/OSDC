         cache: crate::BuildCacheContext {","-            maps_by_snapshot: None,","+            side_effects: crate::CachedSideEffects { overlays: None, rows: None },","             engine_name: None,","             read: false,","             write: false,","@@ -447,7 +447,7 @@ async fn missing_patch_file_path_errors_with_diagnostic() {"," ","     let err = BuildModules {","         cache: crate::BuildCacheContext {","-            maps_by_snapshot: None,","+            side_effects: crate::CachedSideEffects { overlays: None, rows: None },","             engine_name: None,","             read: false,","             write: false,"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/build_modules/tests/store.rs","lines":["@@ -130,7 +130,10 @@ fn materialization_failure_on_incomplete_slot_is_fatal() {"," ","     let result = BuildModules {","         cache: crate::BuildCacheContext {","-            maps_by_snapshot: Some(&side_effects_maps),","+            side_effects: crate::CachedSideEffects {","+                overlays: Some(&side_effects_maps),","+                rows: None,","+            },","             engine_name: Some(engine),","             read: true,","             write: false,","@@ -222,7 +225,10 @@ fn side_effects_cache_disabled_bypasses_the_gate() {"," ","     let err = BuildModules {","         cache: crate::BuildCacheContext {","-            maps_by_snapshot: Some(&side_effects_maps),","+            side_effects: crate::CachedSideEffects {","+                overlays: Some(&side_effects_maps),","+                rows: None,","+            },","             engine_name: Some(\"darwin;arm64;node20\"),","             read: false,","             write: false,","@@ -401,7 +407,7 @@ async fn write_path_populates_side_effects_row() {"," ","     BuildModules {","         cache: crate::BuildCacheContext {","-            maps_by_snapshot: None,","+            side_effects: crate::CachedSideEffects { overlays: None, rows: 