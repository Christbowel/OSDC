"," using ServiceStack.Text;"," ","@@ -68,6 +68,9 @@ public class SlackLog : ILogWithException"," ","         public SlackLog(string incomingWebHookUrl, bool debugEnabled = false)","         {","+            if (incomingWebHookUrl != null && incomingWebHookUrl.StartsWith(\"http://hooks.slack.com\", StringComparison.OrdinalIgnoreCase))","+                incomingWebHookUrl = \"https://\" + incomingWebHookUrl.Substring(7);","+","             this.incomingWebHookUrl = incomingWebHookUrl;","             this.debugEnabled = debugEnabled;","             // Init from DefaultChannel","@@ -80,11 +83,21 @@ public SlackLog(string incomingWebHookUrl, bool debugEnabled = false)"," ","         private void LogMessage(SlackLoggingData message)","         {","-            using (JsConfig.With(propertyConvention: PropertyConvention.Lenient,","-                emitLowercaseUnderscoreNames: true,","-                emitCamelCaseNames: false))","+            try","+            {","+                using (JsConfig.With(propertyConvention: PropertyConvention.Lenient,","+                    emitLowercaseUnderscoreNames: true,","+                    emitCamelCaseNames: false))","+                {","+                    var task = incomingWebHookUrl.PostJsonToUrlAsync(message);","+                    task?.ContinueWith(t => {","+                        var _ = t.Exception;","+                    }, System.Threading.Tasks.TaskContinuationOptions.OnlyOnFaulted);","+                }","+            }","+            catch","             {","-                incomingWebHookUrl.PostJsonToUrlAsync(message);","+                // Logging failures should not crash callers","             }","         }"," ","@@ -112,7 +125,8 @@ private void Write(object message, Exception execption, string channel = null)","             sb.Append(message);","             if (execption != null)","                 sb.Append(NewLine);","-            while (execption != null)","+            int depth = 0;","+            while (execption != null && depth++ < 20)","             {","                 sb.Append(\"Message: \").Append(execption.Message).Append(NewLine)","                     .Append(\"Source: \").Append(execption.Source).Append(NewLine)",""],"additions":20,"deletions":6,"truncated":false}],"additions":244,"deletions":64,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-09-03T12:17:53.917899+00:00"}