ase::runtime::IoStatsSnapshot;","+use databend_common_base::runtime::ThreadTracker;","+use databend_common_base::runtime::TrackingPayloadExt;","+use databend_common_exception::Result;","+use databend_common_expression::DataBlock;","+use databend_query::interpreters::InterpreterFactory;","+use databend_query::sessions::TableContextProgress;","+use databend_query::sessions::TableContextQueryIdentity;","+use databend_query::sql::Planner;","+use databend_query::test_kits::TestFixture;","+use futures_util::TryStreamExt;","+","+struct Observed {","+    io_stats: IoStatsSnapshot,","+    partitions_scanned: u64,","+    partitions_total: u64,","+    scan_bytes: usize,","+    write_bytes: usize,","+}","+","+/// Run `sql` on a fresh `QueryContext` created and executed *without* any","+/// tracking payload carrying `io_stats`, the way `FlightSQL` and other","+/// handlers that do not install one call the interpreter. The interpreter","+/// itself must bind the query's counter so the IO is attributed.","+async fn run_and_observe(fixture: &TestFixture, sql: &str) -> Result<Observed> {","+    let ctx = fixture.new_query_ctx().await?;","+    assert!(","+        ThreadTracker::io_stats().is_none(),","+        \"test must run outside any io_stats tracking scope to exercise the unbound path\"","+    );","+","+    let mut planner = Planner::new(ctx.clone());"],"additions":55,"deletions":0,"truncated":false}],"additions":276,"deletions":54,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-10-16T14:20:23.577493+00:00"}