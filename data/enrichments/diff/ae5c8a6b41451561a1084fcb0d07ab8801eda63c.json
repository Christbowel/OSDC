inder<'a, '_>, name: &str) -> Self {","+        let keys: Vec<_> = finder.keys_needing_peer(name).collect();","+        let positions: HashMap<_, _> = keys","+            .iter()","+            .enumerate()","+            .map(|(index, key)| (*key, index))","+            .collect();","+        let edges: Vec<Vec<usize>> = keys","+            .iter()","+            .map(|key| {","+                finder","+                    .children_needing_peer(key, name)","+                    .map(|child| positions[child])","+                    .collect()","+            })","+            .collect();","+        let components = tarjan::components(keys.len(), |index| edges[index].clone(), |_| true);","+        let mut grouped = Vec::with_capacity(components.components.len());","+        for members in &components.components {","+            grouped.push(Component {","+                references: own_references(finder, &keys, members, name),","+                descendants: descendant_components(&edges, members, &components, grouped.len()),","+            });","+        }","+        let component_of = keys","+            .into_iter()","+            .enumerate()","+            .map(|(index, key)| (key, components.component_of[&index]))","+            .collect();","+        ProviderCandidates { component_of, components: grouped, cached: VecDeque::new() }","+    }","+","+    pub(super) fn matching(","+        &mut self,","+        key: &PackageKey,","+        constraint: &ProviderConstraint,","+    ) -> Option<&'a SnapshotDepRef> {","+        let cached = if let Some(index) = self.cached","+            .iter()","+            .position(|entry| entry.constraint == *constraint)","+        {","+            self.cached.remove(index).unwrap()","+        } else {","+            if self.cached.len() == MAX_CACHED_BINDINGS {","+                self.cached.pop_front();","+            }","+            MatchingProviders {","+                constraint: constraint.clone(),","+                providers: self.matching_providers(constraint),","+            }","+        };","+        let found = cached.providers[self.component_of[key]];","+        self.cached.push_back(cached);","+        found","+    }","+","+    fn matching_providers(","+        &self,","+        constraint: &ProviderConstraint,","+    ) -> Vec<Option<&'a SnapshotDepRef>> {","+        let mut providers = Vec::with_capacity(self.components.len());","+        for component in &self.components {","+            let found = component.references","+                .iter()","+                .copied()","+                .find(|reference| constraint.matches(reference))","+                .or_else(|| {","+                    component.descendants","+                        .iter()","+                        .find_map(|&index| providers[index])","+                });","+            providers.push(found);","+        }","+        providers","+    }","+}","+","+fn own_references<'a>(","+    finder: &ProviderFinder<'a, '_>,","+    keys: &[&'a PackageKey],","+    members: &[usize],","+    name: &str,","+) -> HashSet<&'a SnapshotDepRef> {","+    members","+        .iter()","+        .flat_map(|&index| {","+            children(&finder.snapshots[keys[index]])","+                .filter_map(move |(alias, reference)| {","+                    (finder.own_peers[keys[index]].contains(alias) && alias.to_string() == name)","+                        .then_some(reference)","+                })","+        })","+        .collect()","+}","+","+fn descendant_components(","+    edges: &[Vec<usize>],","+    members: &[usize],","+    components: &tarjan::Components,","+    ready: usize,","+) -> HashSet<usize> {","+    members","+        .iter()","+        .flat_map(|&index| &edges[index])","+        .map(|child| components.component_of[child])","+        .filter(|&component| component < ready)","+        .collect()","+}","+","+#[cfg(test)]","+mod tests;"],"additions":134,"deletions":0,"truncated":false},{"path":"pnpm/crates/lockfile/src/next_format/write/peers/candidates/tests.rs","lines":["@@ -0,0 +1,157 @@","+use super::{","+    MAX_CACHED_BINDINGS, ProviderCandidates, ProviderConstraint, ProviderFinder, SnapshotDepRef,","+};","+use crate::Lockfile;","+use std::collections::{HashMap, HashSet};","+","+#[test]","+fn distinct_provider_chain_keeps_candidate_storage_linear() {","+    const LENGTH: usize = 3000;","+    let key = |version| format!(\"node-{version}@1.0.0(provider@{version}.0.0)\").parse().unwrap();","+    let mut snapshots = HashMap::new();","+    for version in 1..=LENGTH {","+        let mut dependencies = HashMap::from([(","+            \"provider\".parse().unwrap(),","+            format!(\"{version}.0.0\").parse().unwrap(),","+        )]);","+        if version < LENGTH {","+            dependencies.insert(\"next\".parse().unwrap(), SnapshotDepRef::Alias(key(version + 1)));","+        }","+        snapshots.insert(","+            key(version),","+            crate::SnapshotEntry { dependencies: Some(dependencies), ..Default::default() },","+        );","+    }","+    let own_peers = snapshots","+        .iter()","+        .map(|(key, entry)| (key, super::super::own_peer_names(key, entry, None, None)))","+        .collect();","+    let finder = ProviderFinder::new(&snapshots, &own_peers);","+    let mut candidates = ProviderCandidates::of(&finder, \"provider\");","+    assert_eq!(","+        candidates.components","+            .iter()","+            .map(|component| component.references.len())","+            .sum::<usize>(),","+        LENGTH,","+    );","+    assert_eq!(","+        candidates.components","+            .iter()","+            .map(|component| component.descendants.len())","+            .sum::<usize>(),","+        LENGTH - 1,","+    );","+    for version in (1..=MAX_CACHED_BINDINGS + 2).chain([LENGTH, 1]) {","+        let constraint = ProviderConstraint::new(","+            &\"provider\".parse().unwrap(),","+            Some(&[format!(\"provider@{version}.0.0\")]),","+            None,","+        );","+        let expected: SnapshotDepRef = format!(\"{version}.0.0\").parse().unwrap();","+        assert_eq!(candidates.matching(&key(1), &constraint), Some(&expected));","+        let tables = candidates.cached.len();","+        let slots: usize = candidates.cached","+            .iter()","+            .map(|cached| cached.providers.len())","+            .sum();","+        assert!(tables <= MAX_CACHED_BINDINGS, \"cached tables: {tables}\");","+        assert!(slots <= MAX_CACHED_BINDINGS * LENGTH, \"cached provider slots: {slots}\");","+    }","+}","+","+#[test]","+fn shared_subtrees_and_cycles_find_each_binding_and_missing_peers() {","+    let lockfile: Lockfile = serde_saphyr::from_str(","+        r\"lockfileVersion: '9.0'","+snapshots:","+  first@1.0.0:","+    dependencies:","+      second: 1.0.0","+      left: 1.0.0(provider@1.0.0)","+    transitivePeerDependencies: [provider, missing]","+  second@1.0.0:","+    dependencies:","+      first: 1.0.0","+      right: 1.0.0(provider@2.0.0)","+    transitivePeerDependencies: [provider, missing]","+  left@1.0.0(provider@1.0.0):","+    dependencies:","+      provider: 1.0.0","+  right@1.0.0(provider@2.0.0):","+    dependencies:","+      provider: 2.0.0","+\",","+    )","+    .unwrap();","+    let mut snapshots = lockfile.snapshots.unwrap();","+    let shared = snapshots[&\"first@1.0.0\".parse().unwrap()].clone();","+    for index in 0..512 {","+        snapshots.insert(format!(\"parent-{index}@1.0.0\").parse().unwrap(), shared.clone());","+    }","+    let own_peers = snapshots","+        .iter()","+        .map(|(key, entry)| (key, super::super::own_peer_names(key, entry, None, None)))","+        .collect();","+    let mut finder = ProviderFinder::new(&snapshots, &own_peers);","+    for (root, _) in","+        snapshots.iter().filter(|(_, entry)| entry.transitive_peer_dependencies.is_some())","+    {","+        for version in [\"1.0.0\", \"2.0.0\", \"3.0.0\"] {"],"additions