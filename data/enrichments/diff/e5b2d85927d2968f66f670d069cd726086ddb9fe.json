stTypes() {","+        assertInto(","+            \"ROW k = \\\"hello\\\", l = 42, d = 1.5, b = true, dt = TO_DATETIME(\\\"2026-01-15T12:34:56.789Z\\\"), ip = TO_IP(\\\"192.168.1.1\\\")\",","+            1","+        );","+        assertReadBack(List.of(List.of(true, 1.5, \"2026-01-15T12:34:56.789Z\", \"192.168.1.1\", \"hello\", 42L)));","+    }","+","+    public void testRowsAndMultiValues() {","+        assertInto(\"ROW k = [\\\"alpha\\\", \\\"beta\\\"], l = [1, 2] | MV_EXPAND k\", 2);","+        assertReadBack(\"KEEP k, l | SORT k\", List.of(List.of(\"alpha\", List.of(1L, 2L)), List.of(\"beta\", List.of(1L, 2L))));","+    }","+","+    public void testSourceOmitsNullsAndHasDatesInUtc() {","+        assertInto(","+            \"SET time_zone = \\\"Europe/Paris\\\"; ROW k = \\\"only_k\\\", l = null::long, dt = TO_DATETIME(\\\"2026-01-15T12:34:56.789Z\\\")\",","+            1","+        );","+        refresh(DESTINATION);","+        assertResponse(","+            prepareSearch(DESTINATION),","+            response -> assertThat(","+                Arrays.stream(response.getHits().getHits()).map(SearchHit::getSourceAsMap).toList(),","+                equalTo(List.of(Map.of(\"k\", \"only_k\", \"dt\", \"2026-01-15T12:34:56.789Z\")))","+            )","+        );","+    }","+","+    public void testInlineStats() {","+        assertInto(\"ROW k = [\\\"a\\\", \\\"b\\\"] | MV_EXPAND k | INLINE STATS l = COUNT(*)\", 2);","+        assertReadBack(\"KEEP k, l | SORT k\", List.of(List.of(\"a\", 2L), List.of(\"b\", 2L)));","+    }","+","+    public void testZeroRows() {","+        assertInto(\"ROW k = \\\"x\\\" | WHERE k == \\\"y\\\"\", 0);","+    }","+","+    public void testRefusedRowFailsTheQuery() {","+        ElasticsearchStatusException e = expectThrows(","+            ElasticsearchStatusException.class,","+            () -> run(\"ROW k = \\\"ok\\\", unmapped_col = \\\"nope\\\" | INTO \" + DESTINATION).close()","+        );","+        assertThat(e.status(), equalTo(RestStatus.BAD_REQUEST));","+        assertThat(e.getMessage(), containsString(\"unmapped_col\"));","+    }","+","+    private void assertInto(String producer, long rows) {","+        try (EsqlQueryResponse response = run(producer + \" | INTO \" + DESTINATION)) {","+            assertColumnNames(response.columns(), List.of(\"total\", \"created\"));","+            assertColumnTypes(response.columns(), List.of(\"long\", \"long\"));","+            assertThat(getValuesList(response), equalTo(List.of(List.of(rows, rows))));","+        }","+    }","+","+    private void assertReadBack(List<List<Object>> expected) {","+        assertReadBack(\"\", expected);","+    }","+","+    private void assertReadBack(String commands, List<List<Object>> expected) {","+        refresh(DESTINATION);","+        String query = commands.isEmpty() ? \"FROM \" + DESTINATION : \"FROM \" + DESTINATION + \" | \" + commands;","+        try (EsqlQueryResponse response = run(query)) {","+            assertThat(getValuesList(response), equalTo(expected));","+        }","+    }","+}"],"additions":112,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/antlr/EsqlBaseLexer.g4","lines":["@@ -78,6 +78,7 @@ import ChangePoint,","        Highlight,","        Inline,","        InExpression,","+       Into,","        Join,","        Lookup,","        MMR,"],"additions":1,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/antlr/EsqlBaseLexer.tokens","lines":["@@ -36,159 +36,163 @@ FUSE=35"," HIGHLIGHT=36"," INLINE=37"," INLINESTATS=38","-JOIN_LOOKUP=39","-DEV_JOIN_FULL=40","-DEV_JOIN_LEFT=41","-DEV_JOIN_INNER=42","-DEV_JOIN_RIGHT=43","-DEV_LOOKUP=44","-MMR=45","-MV_EXPAND=46","-DROP=47","-KEEP=48","-PROMQL=49","-RENAME=50","-SET=51","-SHOW=52","-UNKNOWN_CMD=53","-CHANGE_POINT_LINE_COMMENT=54","-CHANGE_POINT_MULTILINE_COMMENT=55","-CHANGE_POINT_WS=56","-ENRICH_POLICY_NAME=57","-ENRICH_LINE_COMMENT=58","-ENRICH_MULTILINE_COMMENT=59","-ENRICH_WS=60","-ENRICH_FIELD_LINE_COMMENT=61",