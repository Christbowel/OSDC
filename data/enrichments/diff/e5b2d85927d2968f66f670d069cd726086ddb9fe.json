va.util.function.Consumer;","+","+/**","+ * An {@link OutputOperator} consumer that participates in the driver lifecycle: it can hold the driver back while work","+ * is in flight and remain unfinished after the last page until outstanding work completes.","+ */","+public interface PageConsumer {","+    interface Factory {","+        PageConsumer create(DriverContext driverContext);","+","+        static Factory from(Consumer<Page> consumer) {","+            return driverContext -> PageConsumer.from(consumer);","+        }","+    }","+","+    static PageConsumer from(Consumer<Page> consumer) {","+        return new PageConsumer() {","+            @Override","+            public void consume(Page page) {","+                consumer.accept(page);","+            }","+","+            @Override","+            public IsBlockedResult isBlocked() {","+                return Operator.NOT_BLOCKED;","+            }","+","+            @Override","+            public void finish() {}","+","+            @Override","+            public boolean isFinished() {","+                return true;","+            }","+        };","+    }","+","+    void consume(Page page);","+","+    IsBlockedResult isBlocked();","+","+    void finish();","+","+    boolean isFinished();","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/compute/src/test/java/org/elasticsearch/compute/operator/OutputOperatorTests.java","lines":["@@ -7,8 +7,10 @@"," "," package org.elasticsearch.compute.operator;"," ","+import org.elasticsearch.action.support.SubscribableListener;"," import org.elasticsearch.compute.data.Page;"," import org.elasticsearch.compute.test.AnyOperatorTestCase;","+import org.elasticsearch.core.Nullable;"," import org.hamcrest.Matcher;"," "," import java.util.List;","@@ -56,4 +58,60 @@ public void testBigDescription() {","     protected void assertStatus(Map<String, Object> map, List<Page> input, List<Page> output) {","         assertThat(map, nullValue());","     }","+","+    private static class TrackingConsumer implements PageConsumer {","+        @Nullable","+        SubscribableListener<Void> blocked;","+        boolean finishCalled;","+        int pendingOps;","+","+        @Override","+        public void consume(Page page) {}","+","+        @Override","+        public IsBlockedResult isBlocked() {","+            return blocked == null ? Operator.NOT_BLOCKED : new IsBlockedResult(blocked, \"tracking\");","+        }","+","+        @Override","+        public void finish() {","+            finishCalled = true;","+        }","+","+        @Override","+        public boolean isFinished() {","+            return finishCalled && pendingOps == 0;","+        }","+    }","+","+    public void testNeedsInputFollowsTheConsumer() {","+        TrackingConsumer consumer = new TrackingConsumer();","+        try (OutputOperator operator = new OutputOperator(List.of(\"a\"), p -> p, consumer)) {","+            assertTrue(operator.needsInput());","+            assertThat(operator.isBlocked(), equalTo(Operator.NOT_BLOCKED));","+","+            SubscribableListener<Void> listener = new SubscribableListener<>();","+            consumer.blocked = listener;","+            assertFalse(operator.needsInput());","+            assertFalse(operator.isBlocked().listener().isDone());","+","+            listener.onResponse(null);","+            assertTrue(operator.isBlocked().listener().isDone());","+            assertTrue(operator.needsInput());","+        }","+    }","+","+    public void testFinishWaitsForTheConsumer() {","+        TrackingConsumer consumer = new TrackingConsumer();","+        consumer.pendingOps = 1;","+        try (OutputOperator operator = new OutputOperator(List.of(\"a\"), p -> p, consumer)) {","+            assertFalse(operator.isFinished());","+            operator.finish();","+            assertTrue(consumer.finishCalled);","+            assertFalse(operator.isFinished());","+            assertFalse(operator.needsInput());","+            consumer.pendingOps = 0;","+            assertTrue(operator.isFinished());","+        }","+    }"," }"],"additions":58,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/qa/server/src/main/java/org/elasticsearch/xpack/esql/qa/rest/generative/ForkTestUtils.java","lines":["@@ -17,6 +17,7 @@"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.ESQL_WITHOUT_GROUPING;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.EXEMPLARS_SETTING_DEVELOPMENT_V8;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.FORK_V9;","+import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.INTO_COMMAND;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.METRICS_GROUP_BY_ALL;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.OPTIONAL_FIELDS_LOAD_ALL_COMPLETION_RERANK_FUSE_HIGHLIGHT_MMR;"," import static org.elasticsearch.xpack.esql.action.EsqlCapabilities.Cap.OPTIONAL_FIELDS_LOAD_ALL_FORK;","@@ -53,6 +54,11 @@ public static void shouldSkipForkTest(CsvSpecReader.CsvTestCase testCase, RestCl","             testCase.requiredCapabilities.contains(FORK_V9.capabilityName())","         );"," ","+        assumeFalse(","+            \"Tests using INTO are not supported in FORK tests\",","+            testCase.requiredCapabilities.contains(INTO_COMMAND.capabilityName())","+        );","+","         assumeFalse(","             \"LOAD_ALL fork wrapping of existing csv-specs is not covered yet\",","             testCase.requiredCapabilities.contains(OPTIONAL_FIELDS_LOAD_ALL_V2.capabilityName())"],"additions":6,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/qa/testFixtures/src/main/resources/into.csv-spec","lines":["@@ -0,0 +1,11 @@","+rowIntoIndex","+required_capability: into_command","+","+ROW into_long = [1, 2, 3]","+| MV_EXPAND into_long","+| INTO into_destination","+;","+","+total:long | created:long","+3          | 3","+;"],"additions":11,