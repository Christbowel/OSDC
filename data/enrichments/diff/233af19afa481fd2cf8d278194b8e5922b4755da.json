= \"t.token_hash, t.username, t.created_at, t.last_used_at, t.readonly, t.cidr_whitelist, t.name, t.expires_at\";","+","+#[async_trait]","+impl TokenBackend for LibsqlAuth {","+    async fn issue_token(","+        &self,","+        username: &str,","+        new_token: NewToken,","+    ) -> Result<(String, TokenRecord)> {","+        let nonce = self.counter.fetch_add(1, Ordering::Relaxed);","+        let raw = mint_token(&self.secret, nonce, username);","+        let token_hash = sha256_hex(raw.as_bytes());","+        let now = unix_seconds();","+        let record = TokenRecord {","+            username: username.to_string(),","+            created_at: now,","+            last_used_at: now,","+            readonly: new_token.readonly,","+            cidr_whitelist: new_token.cidr_whitelist,","+            name: new_token.name,","+            expires_at: new_token.expires_at,","+        };","+        let cidr_json = serde_json::to_string(&record.cidr_whitelist)","+            .expect(\"Vec<String> always serializes to JSON\");","+        self.conn","+            .execute(","+                \"INSERT INTO tokens","+                     (token_hash, username, created_at, last_used_at, readonly, cidr_whitelist, name, expires_at)","+                 VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\",","+                params![","+                    token_hash,","+                    record.username.clone(),","+                    token_timestamp_to_sql(record.created_at),","+                    token_timestamp_to_sql(record.last_used_at),","+                    i64::from(record.readonly),","+                    cidr_json,","+                    record.name.as_deref(),","+                    record.expires_at.map(token_timestamp_to_sql),","+                ],","+            )","+            .await?;","+        Ok((raw, record))","+    }","+","+    async fn issue(&self, username: &str) -> Result<String> {","+        let (raw, _) = self.issue_token(username, NewToken::default()).