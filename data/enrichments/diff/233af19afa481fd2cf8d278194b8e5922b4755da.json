{"id":"233af19afa481fd2cf8d278194b8e5922b4755da","axis":"silent","repo":"pnpm/pnpm","sha":"233af19afa481fd2cf8d278194b8e5922b4755da","parsed":{"files":[{"path":".changeset/pnpr-token-creation-and-expiry.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+pnpr now supports token creation via `POST /-/npm/v1/tokens` with `--read-only`, CIDR restrictions, expiry, and token naming. Expired tokens are rejected during authentication. Token authentication updates the `last_used_at` timestamp. Read-only tokens are permitted to access npm audit endpoints [pnpm/tasks#131](https://github.com/pnpm/tasks/issues/131)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/htpasswd.rs","lines":["@@ -1,7 +1,5 @@","-use super::{","-    AtomicU64, HashMap, Ordering, Path, PathBuf, RegistryError, Result, UpsertOutcome,","-    validate_username,","-};","+use super::{AtomicU64, HashMap, Ordering, Path, PathBuf, RegistryError, Result, UpsertOutcome};","+use crate::validation::validate_username;"," "," // ---------------------------------------------------------------"," // htpasswd I/O"],"additions":2,"deletions":4,"truncated":false},{"path":"pnpr/crates/auth/src/identify.rs","lines":["@@ -0,0 +1,34 @@","+use super::{Result, TokenBackend};","+","+/// Identify the caller behind an HTTP request. Inspects the","+/// `Authorization` header and resolves it to a username via the token","+/// store. Only `Bearer` tokens are honored: pnpr does not accept Basic","+/// credentials on requests.","+///","+/// The scheme is matched case-insensitively (RFC 7235 §2.1: \"the","+/// scheme is case-insensitive\"), so `BEARER`, `bearer`, and `Bearer`","+/// all parse the same.","+/// `Ok(None)` covers every \"no usable credentials\" case — a missing or","+/// malformed header, a non-`Bearer` scheme (including legacy `Basic`), or a","+/// token that simply doesn't match. `Err` is reserved for a failure of the","+/// backing store (e.g. the networked auth DB is unreachable) so the caller","+/// can return a 5xx instead of a misleading 401.","+pub async fn identify(","+    header_value: Option<&str>,","+    tokens: &dyn TokenBackend,","+) -> Result<Option<String>> {","+    let Some(value) = header_value.map(str::trim) else {","+        return Ok(None);","+    };","+    let mut parts = value.splitn(2, ' ');","+    let Some(scheme) = parts.next() else {","+        return Ok(None);","+    };","+    let Some(credentials) = parts.next().map(str::trim) else {","+        return Ok(None);","+    };","+    if scheme.eq_ignore_ascii_case(\"Bearer\") {","+        return tokens.lookup(credentials).await;","+    }","+    Ok(None)","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/lib.rs","lines":["@@ -27,14 +27,14 @@"," //! doesn't grant access on its own."," "," pub mod oidc;","+pub(crate) mod validation;"," "," pub use htpasswd::verify_bcrypt;","+pub use identify::identify;"," pub use owned_tokens::OwnedTokens;","-pub use token_store::{TokenRecord, TokenStore};","+pub use token_store::{NewToken, TokenRecord, TokenStore};"," pub use user_store::UserStore;","-","-/// Maximum password length accepted by pnpr to prevent bcrypt 72-byte truncation issues.","-pub const MAX_PASSWORD_BYTES: usize = 71;","+pub use validation::MAX_PASSWORD_BYTES;"," "," mod htpasswd;"," use htpasswd::{","@@ -43,8 +43,9 @@ use htpasswd::{"," };"," "," mod token_store;","-use token_store::{fresh_secret, sha256_hex};","+use token_store::{fresh_secret, sha256_hex, unix_seconds};"," ","+mod identify;"," mod owned_tokens;"," mod user_store;"," ","@@ -93,50 +94,6 @@ where","     }"," }"," ","-pub(crate) const MAX_USERNAME_CHARS: usize = 255;","-","-pub(crate) fn validate_username(username: &str) -> Result<()> {","-    if username.is_empty() {","-        return Err(RegistryError::BadRequest { reason: \"username must not be empty\".to_string() });","-    }","-    if username.chars().count() > MAX_USERNAME_CHARS {","-        return Err(R