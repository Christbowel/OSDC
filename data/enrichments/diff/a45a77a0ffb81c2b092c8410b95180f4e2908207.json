ub(super) deploy_dir: &'a Path,","     pub(super) lockfile_dir: &'a Path,","     pub(super) deployed_project_root: &'a Path,","+    pub(super) references: ReferenceLocation,","+}","+","+#[derive(Clone, Copy)]","+pub(super) enum ReferenceLocation {","+    Workspace,","+    Deploy,"," }"," "," pub(super) fn manifest_dependency_names(","@@ -50,16 +58,18 @@ pub(super) fn create_deploy_files(","     config: &Config,","     dependency_groups: &[DependencyGroup],"," ) -> miette::Result<DeployFiles> {","-    let input_snapshot = lockfile.importers","-        .get(project_id)","-        .ok_or_else(|| DeployError::MissingImporter { project_id: project_id.to_string() })?;","     let deployed_project_root = lexical_normalize(&lockfile_dir.join(project_id));","-    let ctx = ConvertCtx {","+    let mut ctx = ConvertCtx {","         projects_by_path: &selected.projects_by_path,","         deploy_dir,","         lockfile_dir,","         deployed_project_root: &deployed_project_root,","+        references: ReferenceLocation::Workspace,","     };","+    let lockfile = &*relocate::prepare_source_lockfile(lockfile, &mut ctx)?;","+    let input_snapshot = lockfile.importers","+        .get(project_id)","+        .ok_or_else(|| DeployError::MissingImporter { project_id: project_id.to_string() })?;","     let (declared_dependencies, peer_only_dependencies) =","         dependency_name_sets(&selected.project.manifest);","     let target_snapshot = deploy_snapshot(&DeployedDependencies {"],"additions":14,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/lockfile/relocate.rs","lines":["@@ -0,0 +1,152 @@","+use super::{ConvertCtx, Lockfile, PkgName, ReferenceLocation, ResolveBases, convert_package_key};","+use crate::cli_args::deploy::resolution::{convert_importer_dep_version, convert_snapshot_dep_ref};","+use pnpm_diagnostics::miette::{self, IntoDiagnostic};","+use pnpm_lockfile::{","+    NamedBindings, NextImporter, NextImporterDep, NextRef, NextSnapshotEntry, NextSnapshots,","+    RestoreContext, restore_sections,","+};","+","+use std::borrow::Cow;","+","+/// Relocate explicit bindings before rebuilding the peer-suffixed graph.","+pub(super) fn prepare_source_lockfile<'a>(","+    lockfile: &'a Lockfile,","+    ctx: &mut ConvertCtx<'_>,","+) -> miette::Result<Cow<'a, Lockfile>> {","+    if !lockfile.is_next_format() || !has_peer_contexts(lockfile) {","+        return Ok(Cow::Borrowed(lockfile));","+    }","+    let mut sections = lockfile.to_next_sections()?;","+    for (id, importer) in &mut sections.importers {","+        let link_base = ctx.lockfile_dir.join(id);","+        let bases = ResolveBases { file_base: ctx.lockfile_dir, link_base: &link_base };","+        relocate_importer(importer, ctx, &bases)?;","+    }","+    sections.snapshots =","+        sections.snapshots.map(|snapshots| relocate_snapshots(snapshots, ctx)).transpose()?;","+    let mut relocated = lockfile.clone();","+    relocated.packages = relocated.packages","+        .map(|packages| {","+            packages","+                .into_iter()","+                .map(|(key, metadata)| Ok((convert_package_key(&key, ctx)?, metadata)))","+                .collect::<miette::Result<_>>()","+        })","+        .transpose()?;","+    let restored = restore_sections(","+        &sections,","+        RestoreContext {","+            packages: relocated.packages.as_ref(),","+            settings: relocated.settings.as_ref(),","+            patched_dependencies: relocated.patched_dependencies.as_ref(),","+        },","+    );","+    relocated.importers = restored.importers;","+    relocated.snapshots = restored.snapshots;","+    ctx.references = ReferenceLocation::Deploy;","+    Ok(Cow::Owned(relocated))","+}","+","+fn has_peer_contexts(lockfile: &Lockfile) -> bool {","+    lockfile.snapshots","+        .iter()","+        .flatten()","+        .any(|(key, _)| !key.suffix.peer().is_empty())","+}","+","+fn relocate_snapshots(","+    snapshots: NextSnapshots,","+    ctx: &ConvertCtx<'_>,","+) -> miette::Result<NextSnapshots> {","+    let bases = ResolveBases { file_base: ctx.lockfile_dir, link_base: ctx.lockfile_dir };","+    let mut relocated = NextSnapshots::new();","+    for (key, mut entries) in snapshots {","+        for entry in &mut entries {","+            relocate_snapshot(entry, ctx, &bases)?;","+        }","+        relocated","+            .entry(convert_package_key(&key, ctx)?)","+            .or_default()","+            .extend(entries);","+    }","+    Ok(relocated)","+}","+","+fn relocate_importer(","+    importer: &mut NextImporter,","+    ctx: &ConvertCtx<'_>,","+    bases: &ResolveBases<'_>,","+) -> miette::Result<()> {","+    for (alias, dependency) in [","+        &mut importer.dependencies,","+        &mut importer.dev_dependencies,","+        &mut importer.optional_dependencies,","+    ]","+    .into_iter()","+    .flatten()","+    .flatten()","+    {","+        match dependency {","+            NextImporterDep::Resolved(dependency) => {","+                dependency.version =","+                    convert_importer_dep_version(alias, &dependency.version, ctx, bases)?;","+                if let Some(peers) = &mut dependency.peers {","+                    relocate_named(peers, ctx)?;","+                }","+            }","+            NextImporterDep::Named(dependency) => relocate_named(&mut dependency.peers, ctx)?,","+            NextImporterDep::Specifier(_) => {}","+        }","+    }","+    Ok(())","+}","+","+fn relocate_snapshot(","+    snapshot: &mut NextSnapshotEntry,","+    ctx: &ConvertCtx<'_>,","+    bases: &ResolveBases<'_>,","+) -> miette::Result<()> {","+    for (alias, reference) in [","+        &mut snapshot.dependencies,","+        &mut snapshot.optional_dependencies,","+        &mut snapshot.peer_dependencies,","+        &mut snapshot.transitive_peer_dependencies,","+    ]","+    .into_iter()","+    .flatten()","+    .flatten()","+    {","+        relocate_reference(alias, reference, ctx, bases)?;","+    }","+    Ok(())","+}","+","+fn relocate_named(peers: &mut NamedBindings, ctx: &ConvertCtx<'_>) -> miette::Result<()> {","+    let bases = ResolveBases { file_base: ctx.lockfile_dir, link_base: ctx.lockfile_dir };","+    for (name, reference) in peers {","+        relocate_reference(&name.parse().into_diagnostic()?, reference, ctx, &bases)?;","+    }","+    Ok(())","+}","+","+fn relocate_reference(","+    alias: &PkgName,","+    reference: &mut NextRef,","+    ctx: &ConvertCtx<'_>,","+    bases: &ResolveBases<'_>,","+) -> miette::Result<()> {","+    let mut pending = vec![(alias.clone(), reference)];","+    while let Some((alias, reference)) = pending.pop() {","+        let version = match reference {","+            NextRef::Plain(version) => version,","+            NextRef::Named { version, peers } => {","+                for (name, reference) in peers {","+                    pending.push((name.parse().into_diagnostic()?, reference));","+                }","+                version","+            }","+        };","+        *version = convert_snapshot_dep_ref(&alias, version, ctx, bases)?;","+    }","+    Ok(())","+}"],"additions":152,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/resolution.rs","lines":["@@ -3,7 +3,7 @@ use super::{","     LockfileResolution, PackageKey, PackageMetadata, Path, PathBuf, PkgName, PkgNameVerPeer,","     ProjectInfo, ProjectPathKey, ProjectSnapshot, ResolvedDependencyMap, ResolvedDependencySpec,","     SnapshotDepRef, SnapshotEntry, TarballResolution, VersionPart, lexical_normalize,","-    relative_path, same_path,","+    lockfile::ReferenceLocation, relative_path, same_path,"," };"," "," pub(super) struct ResolveBases<'a> {","@@ -140,12 +140,16 @@ fn convert_snapshot_dep_map(","     Ok((!output.is_empty()).then_some(output))"," }"," ","-fn convert_importer_dep_version(","+pub(super) fn convert_importer_dep_version(","     alias: &PkgName,","     version: &ImporterDepVersion,","     ctx: &ConvertCtx,","     bases: &ResolveBases,"," ) -> miette::Result<ImporterDepVersion> {","+    match ctx.references {","+        ReferenceLocation::Deploy => return Ok(version.clone()),","+        ReferenceLocation::Workspace => {}","+    }","     if let Some(local) = resolve_importer_dep_version(version, bases) {","         return local_to_importer_dep_version(alias, &local, ctx);","     }","@@ -158,8 +162,13 @@ pub(super) fn convert_importer_version_to_snapshot_ref(","     ctx: &ConvertCtx,","     bases: &ResolveBases,"," ) -> miette::Result<SnapshotDepRef> {","-    if let Some(local) = resolve_importer_dep_version(version, bases) {","-        return local_to_snapshot_dep_ref(alias, &local, ctx);","+    match ctx.references {","+        ReferenceLocation::Workspace => {","+            if let Some(local) = resolve_importer_dep_version(version, bases) {","+                return local_to_snapshot_dep_ref(alias, &local, ctx);","+            }","+        }","+        ReferenceLocation::Deploy => {}","     }","     Ok(match version {","         ImporterDepVersion::Regular(version) => SnapshotDepRef::Plain(version.clone()),","@@ -172,12 +181,16 @@ pub(super) fn convert_importer_version_to_snapshot_ref(","     })"," }"," ","-fn convert_snapshot_dep_ref(","+pub(super) fn convert_snapshot_dep_ref(","     alias: &PkgName,","     dep_ref: &SnapshotDepRef,","     ctx: &ConvertCtx,","     bases: &ResolveBases,"," ) -> miette::Result<SnapshotDepRef> {","+    match ctx.references {","+        ReferenceLocation::Deploy => return Ok(dep_ref.clone()),","+        ReferenceLocation::Workspace => {}","+    }","     if let Some(local) = resolve_snapshot_dep_ref(alias, dep_ref, bases) {","         return local_to_snapshot_dep_ref(alias, &local, ctx);","     }","@@ -285,6 +298,10 @@ pub(super) fn convert_package_key(","     key: &PackageKey,","     ctx: &ConvertCtx,"," ) -> miette::Result<PackageKey> {","+    match ctx.references {","+        ReferenceLocation::Deploy => return Ok(key.c