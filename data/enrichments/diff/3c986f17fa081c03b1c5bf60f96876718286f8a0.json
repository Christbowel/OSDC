ction = config.GetSection(\"Credential\");","+                var options = new DefaultAzureCredentialOptions(new CredentialSettings(section), section);","+                options.Sources[0].Transport = transport;","+                options.Sources[0].Retry.MaxRetries = 0;","+                var credential = new ConfigurableCredential(options);","+                var chain = GetInnerCredential(credential) as ChainedTokenCredential;","+                Assert.IsNotNull(chain);","+                var sources = GetChainedTokenCredentialSources(chain);","+                Assert.AreEqual(2, sources.Length);","+                Assert.IsInstanceOf<ManagedIdentityCredential>(sources[0]);","+                var fallback = new Moq.Mock<TokenCredential>(Moq.MockBehavior.Strict);","+                sources[1] = fallback.Object;","+                var instrumented = InstrumentClient(credential);","+","+                var ex = Assert.ThrowsAsync<AuthenticationFailedException>(async () =>","+                    await instrumented.GetTokenAsync(new TokenRequestContext(MockScopes.Default)));","+","+                Assert.That(ex, Is.Not.InstanceOf<CredentialUnavailableException>());","+                Assert.That(ex.ToString(), Does.Contain(failure == \"unattached\"","+                    ? \"identity_not_found\"","+                    : Constants.MiSourceNoUserAssignedIdentityMessage));","+                Assert.That(transport.Requests, Has.Count.EqualTo(1));","+                CredentialTestHelpers.AssertArcManagedIdentityRequest(transport.Requests[0], identityParameter, identityId);","+                fallback.VerifyNoOtherCalls();","+            }","+            finally","+            {","+                ApplicationBase.ResetStateForTest();","+            }","+        }","+","         [Test]","         public void Constructor_WithChainedFederatedIdentitySource_EnableMtlsPop_CreatesPopCredential()","         {"],"additions":76,"deletions":0,"truncated":false},{"path":"sdk/core/A