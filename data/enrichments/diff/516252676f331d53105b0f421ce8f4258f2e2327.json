{"id":"516252676f331d53105b0f421ce8f4258f2e2327","axis":"silent","repo":"pnpm/pnpm","sha":"516252676f331d53105b0f421ce8f4258f2e2327","parsed":{"files":[{"path":".changeset/workspace-project-version-bump.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.status\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`verifyDepsBeforeRun` no longer reports dependencies as out of sync when only the `version` field of a workspace project changed and no dependency can resolve to that project. A script run after such a change no longer starts an install first."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -4148,6 +4148,9 @@ importers:","       '@pnpm/logger':","         specifier: 'catalog:'","         version: 1100.0.0","+      '@pnpm/resolving.local-resolver':","+        specifier: workspace:*","+        version: link:../../resolving/local-resolver","       '@pnpm/resolving.resolver-base':","         specifier: workspace:*","         version: link:../../resolving/resolver-base","@@ -4157,6 +4160,9 @@ importers:","       '@pnpm/workspace.projects-reader':","         specifier: workspace:*","         version: link:../../workspace/projects-reader","+      '@pnpm/workspace.spec-parser':","+        specifier: workspace:*","+        version: link:../../workspace/spec-parser","       '@pnpm/workspace.state':","         specifier: workspace:*","         version: link:../../workspace/state"],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_oracle.rs","lines":["@@ -89,9 +89,6 @@ enum AllowedRefusal {","     /// every selection, the ones it leaves as they are included","     /// (pnpm/tasks#219).","     Run,","-    /// A workspace project's version bump may refuse both gates, even when","-    /// nothing can resolve to the project (pnpm/tasks#246).","-    Both,"," }"," "," struct Scenario {","@@ -465,7 +462,7 @@ impl Scenario {","             self.driver,","         );","         assert!(","-            passed || !current || matches!(allowed, AllowedRefusal::Run | AllowedRefusal::Both),","+            passed || !current || allowed == AllowedRefusal::Run,","             \"{:?} ({:?}): the run gate for {selection:?} refused, but a clean install changes nothing \\","              for it\",","             self.layout,","@@ -495,7 +492,7 @@ impl Scenario {","                 self.layout,","                 self.driver,","             );","-        } else if matches!(allowed, AllowedRefusal::None | AllowedRefusal::Run) && offered {","+        } else if allowed != AllowedRefusal::Install && offered {","             assert_ne!(","                 self.snapshot(),","                 before,","@@ -1230,7 +1227,7 @@ fn manifest_edits_that_change_no_dependency(layout: Layout) {","     for (field, value, allowed) in [","         (\"description\", json!(\"edited\"), AllowedRefusal::None),","         (\"scripts\", json!({ \"build\": r#\"node -e \"\"\"# }), AllowedRefusal::None),","-        (\"version\", json!(\"1.0.1\"), AllowedRefusal::Both),","+        (\"version\", json!(\"1.0.1\"), AllowedRefusal::None),","     ] {","         manifest[field] = value;","         scenario.write_manifest(\"b\", manifest.clone());"],"additions":3,"deletions":6,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install.rs","lines":["@@ -47,6 +47,7 @@ pub(crate) use timestamps::{"," mod current_lockfile;"," mod manifest_source;"," mod modules_dirs;","+mod project_structure;"," mod relocation;"," mod settle;"," use freshness::{","@@ -56,9 +57,8 @@ use modules_dirs::{","     SelectedReach, direct_dependency_link_dangling, first_project_missing_modules_dir,","     first_selected_project_missing_modules_dir, reached_project_dirs,"," };","-use settle::{","-    current_lockfile_file_has_content, project_structure_matches, wanted_lockfile_file_has_content,","-};","+use project_structure::project_structure_matches;","+use settle::{current_lockfile_file_has_content, wanted_lockfile_file_has_content};"," "," use std::{","     collections::HashSet,","@@ -195,6 +195,7 @@ pub(crate) fn check_optimistic_repeat_install_with_state(","         check.workspace_root,","         check.project_manifests.as_slice(),","         check.config,","+        check.catalogs,","     )","     .map_or((state, false), |relocated| (relocated, true));","     let policy = GatePolicy {"],"additions":4,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/deps_status.rs","lines":["@@ -81,6 +81,7 @@ pub fn check_deps_status_before_run(","         check.workspace_root,","         check.project_manifests.as_slice(),","         check.config,","+        check.catalogs,","     );","     let moved = relocated.is_some();","     let state = relocated.as_ref().unwrap_or(state);"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/freshness.rs","lines":["@@ -255,7 +255,7 @@ fn check_settings_and_workspace_freshness(","     if !catalogs_cache_matches(state.settings.catalogs.as_ref(), catalogs) {","         return Err(Stale::CatalogsCache);","     }","-    if !project_structure_matches(state, project_manifests.as_slice(), config) {","+    if !project_structure_matches(state, project_manifests.as_slice(), config, catalogs) {","         return Err(Stale::ProjectStructure);","     }","     check_held_modules_dirs(check, state, policy, scope)"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/project_structure.rs","lines":["@@ -0,0 +1,172 @@","+//! Whether the workspace still has the projects the last install recorded.","+","+use super::{","+    Config, LinkWorkspacePackages, PackageManifest, PathBuf,","+    local_file_deps::is_workspace_path_spec, manifest_string_field,","+};","+use pnpm_catalogs_types::Catalogs;","+use pnpm_config::PackageExtension;","+use pnpm_local_spec::is_local_filesystem_specifier;","+use pnpm_package_manifest::DependencyGroup;","+use pnpm_workspace_spec::WorkspaceSpec;","+use pnpm_workspace_state::WorkspaceState;","+use std::collections::HashSet;","+","+/// Project count + per-project (key, name, version) match between the","+/// cached state and today's walk. The key is the project's root dir;","+/// `build_workspace_state` and pnpm both use it as the map key, so a","+/// renamed / removed / added project trips the check immediately.","+///","+/// A version decides only how dependencies resolve to the project, so a","+/// changed one counts only for a project [`ResolvableProjects`] holds.","+pub(super) fn project_structure_matches(","+    state: &WorkspaceState,","+    project_manifests: &[(PathBuf, &PackageManifest)],","+    config: &Config,","+    catalogs: &Catalogs,","+) -> bool {","+    if state.projects.len() != project_manifests.len() {","+        return false;","+    }","+    let mut bumped_names = Vec::new();","+    for (root_dir, manifest) in project_manifests {","+        let Some(entry) = state.projects.get(root_dir.to_string_lossy().as_ref()) else {","+            return false;","+        };","+        let name = manifest_string_field(manifest, \"name\");","+        if entry.name != name {","+            return false;","+        }","+        if entry.version.as_deref().unwrap_or(\"0.0.0\")","+            != manifest_string_field(manifest, \"version\").as_deref().unwrap_or(\"0.0.0\")","+        {","+            bumped_names.push(name);","+        }","+    }","+    if bumped_names.is_empty() {","+        return true;","+    }","+    let resolvable = ResolvableProjects::new(state, project_manifests, config, catalogs);","+    !bumped_names","+        .iter()","+        .any(|name| resolvable.holds(name.as_deref()))","+}","+","+/// The workspace projects a dependency may resolve to by their version. It","+/// errs toward holding a project: a version it wrongly ignores lets scripts","+/// run against a stale `node_modules`.","+enum ResolvableProjects<'a> {","+    /// Under [`LinkWorkspacePackages::Deep`] any transitive dependency may","+    /// resolve to a project. In a workspace of several projects a pnpmfile","+    /// hook may add a dependency on any of them, and a dependency given by a","+    /// local path may point at any of them under any alias.","+    All,","+    /// Outside deep linking, no dependency resolves to a lone project.","+    None,","+    /// The projects some dependency names, and those a setting mentions.","+    Depended { names: HashSet<String>, config: &'a Config },","+}","+","+impl<'a> ResolvableProjects<'a> {","+    fn new(","+        state: &WorkspaceState,","+        project_manifests: &[(PathBuf, &PackageManifest)],","+        config: &'a Config,","+        catalogs: &Catalogs,","+    ) -> Self {","+        if config.link_workspace_packages == LinkWorkspacePackages::Deep {","+            return Self::All;","+        }","+        if project_manifests.len() == 1 {","+            return Self::None;","+        }","+        if !state.pnpmfiles.is_empty() {","+            return Self::All;","+        }","+        let mut names = HashSet::new();","+        for (alias, spec) in dependency_specs(project_manifests, catalogs) {","+            if is_local_filesystem_specifier(spec) || is_workspace_path_spec(spec) {","+                return Self::All;","+            }","+            names.insert(depended_name(alias, spec));","+        }","+        Self::Depended { names, config }","+    }","+","+    fn holds(&self, name: Option<&str>) -> bool {","+        match self {","+            Self::All => true,","+            Self::None => false,","+            Self::Depended { names, config } => {","+                name.is_some_and(|name| names.contains(name) || settings_mention(config, name))","+            }","+        }","+    }","+}","+","+/// The `(alias, spec)` pairs of the projects' dependencies and of the","+/// catalog entries.","+fn dependency_specs<'a>(","+    project_manifests: &'a [(PathBuf, &PackageManifest)],","+    catalogs: &'a Catalogs,","+) -> impl Iterator<Item = (&'a str, &'a str)> {","+    const GROUPS: [DependencyGroup; 4] = [","+        DependencyGroup::Prod,","+        DependencyGroup::Dev,","+        DependencyGroup::Optional,","+        DependencyGroup::Peer,","+    ];","+    let manifest_dependencies = project_manifests","+        .iter()","+        .flat_map(|(_, manifest)| manifest.dependencies(GROUPS));","+    let catalog_entries = catalogs","+        .values()","+        .flatten()","+        .map(|(alias, spec)| (alias.as_str(), spec.as_str()));","+    manifest_dependencies.chain(catalog_entries)","+}","+","+/// The package name a dependency names, through an `npm:` or `workspace:`","+/// alias where there is one.","+fn depended_name(alias: &str, spec: &str) -> String {","+    match WorkspaceSpec::parse(spec) {","+        Some(workspace_spec) => workspace_spec.alias.unwrap_or_else(|| alias.to_string()),","+        None => PackageManifest::resolve_registry_dependency(alias, spec).0.to_string(),","+    }","+}","+","+/// Whether an override, a package extension, or a patch mentions `name`","+/// anywhere in its selector or its value. Each may select a project by its","+/// version or point a dependency at it, and a substring match is the","+/// cheapest test that never misses one.","+fn settings_mention(config: &Config, name: &str) -> bool {","+    let overrides = config.overrides","+        .iter()","+        .flatten()","+        .flat_map(|(selector, spec)| [selector.as_str(), spec.as_str()]);","+    let extensions = config.package_extensions","+        .iter()","+        .flatten()","+        .flat_map(|(selector, extension)| {","+            std::iter::once(selector.as_str()).chain(extension_dependencies(extension))","+        });","+    let patches = config.patched_dependencies","+        .iter()","+        .flatten()","+        .map(|(selector, _)| selector.as_str());","+    overrides","+        .chain(extensions)","+        .chain(patches)","+        .any(|text| text.contains(name))","+}","+","+fn extension_dependencies(extension: &PackageExtension) -> impl Iterator<Item = &str> {","+    [&extension.dependencies, &extension.optional_dependencies, &extension.peer_dependencies]","+        .into_iter()","+        .flatten()","+        .flatten()","+        .flat_map(|(alias, spec)| [alias.as_str(), spec.as_str()])","+}","+","+#[cfg(test)]","+mod tests;"],"additions":172,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/project_structure/tests.rs","lines":["@@ -0,0 +1,122 @@","+use super::project_structure_matches;","+use pnpm_catalogs_types::Catalogs;","+use pnpm_config::{Config, LinkWorkspacePackages, PackageExtension};","+use pnpm_package_manifest::PackageManifest;","+use pnpm_workspace_state::{ProjectEntry, WorkspaceState};","+use serde_json::{Value, json};","+use std::path::PathBuf;","+","+/// Whether the structure check accepts `app`, which declares `app_fields`,","+/// beside `lib`, recorded at `1.0.0` and now at `2.0.0`.","+fn accepts_lib_bump(app_fields: Value, config: &Config, catalogs: &Catalogs) -> bool {","+    accepts_lib_bump_with_pnpmfiles(app_fields, config, catalogs, Vec::new())","+}","+","+fn accepts_lib_bump_with_pnpmfiles(","+    app_fields: Value,","+    config: &Config,","+    catalogs: &Catalogs,","+    pnpmfiles: Vec<String>,","+) -> bool {","+    let mut app = json!({ \"name\": \"app\", \"version\": \"1.0.0\" });","+    let Value::Object(app_fields) = app_fields else { panic!(\"the fields must be an object\") };","+    app.as_object_mut()","+        .unwrap()","+        .extend(app_fields);","+    let app = PackageManifest::from_value(PathBuf::from(\"/ws/app/package.json\"), app);","+    let lib = PackageManifest::from_value(","+        PathBuf::from(\"/ws/lib/package.json\"),","+        json!({ \"name\": \"lib\", \"version\": \"2.0.0\" }),","+    );","+    let project_manifests = [(PathBuf::from(\"/ws/app\"), &app), (PathBuf::from(\"/ws/lib\"), &lib)];","+    let entry = |name: &str| ProjectEntry {","+        name: Some(name.to_string()),","+        version: Some(\"1.0.0\".to_string()),","+        has_modules_dir: true,","+    };","+    let state = WorkspaceState {","+        projects: [(\"/ws/app\".to_string(), entry(\"app\")), (\"/ws/lib\".to_string(), entry(\"lib\"))]","+            .into_iter()","+            .collect(),","+        pnpmfiles,","+        ..WorkspaceState::default()","+    };","+    project_structure_matches(&state, &project_manifests, config, catalogs)","+}","+","+#[test]","+fn ignores_the_version_of_a_project_nothing_depends_on() {","+    let dependencies = json!({ \"dependencies\": { \"library\": \"1.0.0\", \"@scope/lib\": \"1.0.0\" } });","+    assert!(accepts_lib_bump(dependencies, &Config::new(), &Catalogs::new()));","+}","+","+#[test]","+fn compares_the_version_of_a_project_a_dependency_names() {","+    for group in [\"dependencies\", \"devDependencies\", \"optionalDependencies\", \"peerDependencies\"] {","+        let fields = json!({ group: { \"lib\": \"workspace:*\" } });","+        assert!(!accepts_lib_bump(fields, &Config::new(), &Catalogs::new()), \"{group}\");","+    }","+}","+","+#[test]","+fn compares_the_version_of_a_project_an_alias_names() {","+    for spec in [\"npm:lib@^2.0.0\", \"npm:lib\", \"workspace:lib@*\"] {","+        let fields = json!({ \"dependencies\": { \"renamed\": spec } });","+        assert!(!accepts_lib_bump(fields, &Config::new(), &Catalogs::new()), \"{spec}\");","+    }","+}","+","+#[test]","+fn compares_every_version_when_a_dependency_is_a_local_path() {","+    for spec in [\"workspace:../lib\", \"file:../lib\", \"link:../lib\", \"../lib\"] {","+        let fields = json!({ \"dependencies\": { \"renamed\": spec } });","+        assert!(!accepts_lib_bump(fields, &Config::new(), &Catalogs::new()), \"{spec}\");","+    }","+}","+","+#[test]","+fn compares_the_version_of_a_project_a_catalog_entry_names() {","+    let catalogs = Catalogs::from([(","+        \"default\".to_string(),","+        [(\"renamed\".to_string(), \"npm:lib@^2.0.0\".to_string())].into(),","+    )]);","+    let fields = json!({ \"dependencies\": { \"renamed\": \"catalog:\" } });","+    assert!(!accepts_lib_bump(fields, &Config::new(), &catalogs));","+}","+","+#[test]","+fn compares_the_version_of_a_project_a_setting_mentions() {","+    let mut overridden = Config::new();","+    overridden.overrides =","+        Some(std::iter::once((\"lib@1>dep\".to_string(), \"1.0.0\".to_string())).collect());","+    let mut extended = Config::new();","+    let extension = PackageExtension {","+        dependencies: Some([(\"renamed\".to_string(), \"npm:lib@^2.0.0\".to_string())].into()),","+        ..PackageExtension::default()","+    };","+    extended.package_extensions = Some(std::iter::once((\"app\".to_string(), extension)).collect());","+    let mut patched = Config::new();","+    patched.patched_dependencies =","+        Some(std::iter::once((\"lib@1.0.0\".to_string(), \"patches/lib.patch\".to_string())).collect());","+    for config in [&overridden, &extended, &patched] {","+        assert!(!accepts_lib_bump(json!({}), config, &Catalogs::new()));","+    }","+}","+","+#[test]","+fn compares_every_version_under_deep_linking() {","+    let mut config = Config::new();","+    config.link_workspace_packages = LinkWorkspacePackages::Deep;","+    assert!(!accepts_lib_bump(json!({}), &config, &Catalogs::new()));","+}","+","+#[test]","+fn compares_every_version_when_a_pnpmfile_is_loaded() {","+    let pnpmfiles = vec![\"/ws/.pnpmfile.cjs\".to_string()];","+    assert!(!accepts_lib_bump_with_pnpmfiles(","+        json!({}),","+        &Config::new(),","+        &Catalogs::new(),","+        pnpmfiles","+    ));","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/relocation.rs","lines":["@@ -3,7 +3,7 @@"," //! tree still works where it is now."," "," use super::{","-    Config, Host, Lockfile, OptimisticRepeatInstallCheck, PackageManifest, Path, PathBuf,","+    Catalogs, Config, Host, Lockfile, OptimisticRepeatInstallCheck, PackageManifest, Path, PathBuf,","     WorkspaceState,","     current_lockfile::assert_loaded_current_lockfile_records,","     current_pnpmfiles,","@@ -22,6 +22,7 @@ pub(super) fn relocated_state(","     workspace_root: &Path,","     project_manifests: &[(PathBuf, &PackageManifest)],","     config: &Config,","+    catalogs: &Catalogs,"," ) -> Option<WorkspaceState> {","     if !recorded_elsewhere(state, project_manifests) {","         return None;","@@ -41,7 +42,7 @@ pub(super) fn relocated_state(","         .collect();","     // The validation records name the files where they were.","     let relocated = WorkspaceState { projects, pnpmfiles, validation: None, ..state.clone() };","-    project_structure_matches(&relocated, project_manifests, config).then_some(relocated)","+    project_structure_matches(&relocated, project_manifests, config, catalogs).then_some(relocated)"," }"," "," /// Whether no current project dir is a key of `state`."],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/relocation/tests.rs","lines":["@@ -1,4 +1,5 @@"," use super::relocated_state;","+use pnpm_catalogs_types::Catalogs;"," use pnpm_config::Config;"," use pnpm_package_manifest::PackageManifest;"," use pnpm_workspace_state::{ProjectEntry, WorkspaceState};","@@ -31,7 +32,7 @@ fn relocated_onto(","         .cloned()","         .zip(&manifests)","         .collect();","-    relocated_state(state, workspace_root, &project_manifests, &Config::new())","+    relocated_state(state, workspace_root, &project_manifests, &Config::new(), &Catalogs::new())"," }"," "," fn path_string(path: &Path) -> String {"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settle.rs","lines":["@@ -5