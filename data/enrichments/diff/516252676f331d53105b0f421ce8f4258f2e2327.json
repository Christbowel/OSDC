ap_or(\"0.0.0\"))","-        })","-}"],"additions":0,"deletions":33,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/workspace.rs","lines":["@@ -344,11 +344,15 @@ fn bump_lone_project_version(","     (dir, config, PackageManifest::from_path(manifest_path).unwrap())"," }"," /// Another project's dependency may resolve to a workspace project by its","-/// version, so a version bump in a workspace of several projects is drift.","+/// version, so bumping the version of a project that one depends on is drift."," #[test]","-fn install_and_run_refuse_a_version_bump_in_a_workspace_of_several_projects() {","-    let (dir, config, root) =","-        setup_fresh_install(pnpm_config::NodeLinker::Isolated, \"root\", \"1.0.0\", \"\");","+fn install_and_run_refuse_a_version_bump_of_a_depended_on_workspace_project() {","+    let (dir, config, root) = setup_fresh_install(","+        pnpm_config::NodeLinker::Isolated,","+        \"root\",","+        \"1.0.0\",","+        r#\"\"dependencies\":{\"pkg-a\":\"workspace:*\"}\"#,","+    );","     let pkg_dir = dir.path().join(\"pkg-a\");","     fs::create_dir_all(&pkg_dir).unwrap();","     fs::write(pkg_dir.join(\"package.json\"), r#\"{\"name\":\"pkg-a\",\"version\":\"1.0.1\"}\"#).unwrap();"],"additions":8,"deletions":4,"truncated":false},{"path":"pnpm11/deps/status/package.json","lines":["@@ -48,9 +48,11 @@","     \"@pnpm/lockfile.settings-checker\": \"workspace:*\",","     \"@pnpm/lockfile.utils\": \"workspace:*\",","     \"@pnpm/lockfile.verification\": \"workspace:*\",","+    \"@pnpm/resolving.local-resolver\": \"workspace:*\",","     \"@pnpm/resolving.resolver-base\": \"workspace:*\",","     \"@pnpm/types\": \"workspace:*\",","     \"@pnpm/workspace.projects-reader\": \"workspace:*\",","+    \"@pnpm/workspace.spec-parser\": \"workspace:*\",","     \"@pnpm/workspace.state\": \"workspace:*\",","     \"@pnpm/workspace.workspace-manifest-reader\": \"workspace:*\",","     \"ramda\": \"catalog:\","],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm11/deps/status/src/findWorkspaceStructureIssue.ts","lines":["@@ -1,29 +1,100 @@","+import type { Catalogs } from '@pnpm/catalogs.types'","+import { isFilespec, isLocalFilesystemSpecifier } from '@pnpm/resolving.local-resolver'","+import { WorkspaceSpec } from '@pnpm/workspace.spec-parser'"," import { importerIdOf, projectBinsDigest } from '@pnpm/workspace.state'"," import { equals, filter } from 'ramda'"," "," import type { WorkspaceDepsStatusContext } from './checkWorkspaceDepsStatus.js'"," ","-export function findWorkspaceStructureIssue ({ allProjects, opts, workspaceState }: WorkspaceDepsStatusContext): string | undefined {","+export function findWorkspaceStructureIssue (ctx: WorkspaceDepsStatusContext): string | undefined {","+  const { allProjects, opts, workspaceState } = ctx","   if (!equals(","     filter(value => value != null, workspaceState.settings.catalogs ?? {}),","     filter(value => value != null, opts.catalogs ?? {})","   )) {","     return 'Catalogs cache outdated'","   }","-  // A version decides only how dependencies resolve to the project. A lone","-  // project's version matters only when a transitive dependency may resolve to it.","-  const compareVersions = allProjects.length > 1 || opts.linkWorkspacePackages === 'deep'","-  if (allProjects.length !== Object.keys(workspaceState.projects).length ||","-    !allProjects.every((currentProject) => {","-      const prevProject = workspaceState.projects[currentProject.rootDir]","-      if (!prevProject) return false","-      return prevProject.name === currentProject.manifest.name &&","-        (!compareVersions || (prevProject.version ?? '0.0.0') === (currentProject.manifest.version ?? '0.0.0'))","-    })","-  ) {","-    return 'The workspace structure has changed since last install'","+  if (allProjects.length !== Object.keys(workspaceState.projects).length) {","+    return WORKSPACE_STRUCTURE_CHANGED","   }","-  return undefined","+  if (!allProjects.every(({ rootDir, manifest }) => {","+    const prevProject = workspaceState.projects[rootDir]","+    return prevProject != null && prevProject.name === manifest.name","+  })) {","+    return WORKSPACE_STRUCTURE_CHANGED","+  }","+  const bumpedNames = allProjects","+    .filter(({ rootDir, manifest }) => (workspaceState.projects[rootDir].version ?? '0.0.0') !== (manifest.version ?? '0.0.0'))","+    .map(({ manifest }) => manifest.name)","+  if (bumpedNames.length === 0) return undefined","+  const resolvesByVersion = createResolvableProjectsFilter(ctx)","+  return bumpedNames.some(resolvesByVersion) ? WORKSPACE_STRUCTURE_CHANGED : undefined","+}","+","+const WORKSPACE_STRUCTURE_CHANGED = 'The workspace structure has changed since last install'","+","+/**","+ * Whether a dependency may resolve to the workspace project of this name by","+ * its version. A version decides only how dependencies resolve to the","+ * project, so only these versions are compared. It errs toward `true`: a","+ * version it wrongly ignores lets scripts run against a stale `node_modules`.","+ */","+function createResolvableProjectsFilter ({ allProjects, opts, workspaceState }: WorkspaceDepsStatusContext): (name: string | undefined) => boolean {","+  // Under deep linking any transitive dependency may resolve to a project.","+  if (opts.linkWorkspacePackages === 'deep') return () => true","+  // Otherwise no dependency resolves to a lone project.","+  if (allProjects.length === 1) return () => false","+  // A pnpmfile hook may add a dependency on any project.","+  if (workspaceState.pnpmfiles.length > 0) return () => true","+  const dependencySpecs = collectDependencySpecs(allProjects, opts.catalogs)","+  // A dependency given by a local path may point at any project under any alias.","+  if (dependencySpecs.some(([, spec]) => spec != null && isLocalPath(spec))) return () => true","+  const dependedNames = new Set(dependencySpecs.map(([alias, spec]) => dependedName(alias, spec)))","+  const settingTexts = collectSettingTexts(opts)","+  return (name) => name != null &&","+    (dependedNames.has(name) || settingTexts.some((text) => text.includes(name)))","+}","+","+const DEPENDENCY_FIELDS = ['dependencies', 'devDependencies', 'optionalDependencies', 'peerDependencies'] as const","+","+/** The `[alias, spec]` pairs of the projects' dependencies and of the catalog entries. */","+function collectDependencySpecs (allProjects: WorkspaceDepsStatusContext['allProjects'], catalogs: Catalogs | undefined): Array<[string, string | undefined]> {","+  return [","+    ...allProjects.flatMap(({ manifest }) => DEPENDENCY_FIELDS.flatMap((field) => Object.entries(manifest[field] ?? {}))),","+    ...Object.values(catalogs ?? {}).flatMap((catalog) => Object.entries(catalog ?? {})),","+  ]","+}","+","+function isLocalPath (spec: string): boolean {","+  return isLocalFilesystemSpecifier(spec) || (spec.startsWith('workspace:') && isFilespec(spec.slice('workspace:'.length)))","+}","+","+/** The package name a dependency names, through an `npm:` or `workspace:` alias where there is one. */","+function dependedName (alias: string, spec: string | undefined): string {","+  if (spec == null) return alias","+  const workspaceSpec = WorkspaceSpec.parse(spec)","+  if (workspaceSpec != null) return workspaceSpec.alias ?? alias","+  if (!spec.startsWith('npm:')) return alias","+  const target = spec.slice('npm:'.length)","+  const versionSeparator = target.lastIndexOf('@')","+  return versionSeparator >= 1 ? target.slice(0, versionSeparator) : target","+}","+","+/**","+ * The selectors and values of the overrides, the package extensions, and the","+ * patches. Each may select a project by its version or point a dependency at","+ * it, and a substring match on them is the cheapest test that never misses one.","+ */","+function collectSettingTexts ({ overrides, packageExtensions, patchedDependencies }: WorkspaceDepsStatusContext['opts']): string[] {","+  return [","+    ...Object.entries(overrides ?? {}).flat(),","+    ...Object.entries(packageExtensions ?? {}).flatMap(([selector, extension]) => [","+      selector,","+      ...[extension.dependencies, extension.optionalDependencies, extension.peerDependencies]","+        .flatMap((dependencies) => Object.entries(dependencies ?? {}).flat()),","+    ]),","+    ...Object.keys(patchedDependencies ?? {}),","+  ]"," }"," "," /**"],"additions":85,"deletions":14,"truncated":false},{"path":"pnpm11/deps/status/test/findWorkspaceStructureIssue.test.ts","lines":["@@ -1,7 +1,8 @@"," import path from 'node:path'"," "," import { expect, test } from '@jest/globals'","-import type { ProjectRootDir } from '@pnpm/types'","+import type { Catalogs } from '@pnpm/catalogs.types'","+import type { ProjectManifest, ProjectRootDir } from '@pnpm/types'"," import type { ProjectsList } from '@pnpm/workspace.state'"," "," import type { WorkspaceDepsStatusContext } from '../src/checkWorkspaceDepsStatus.js'","@@ -23,27 +24,95 @@ test('a version bump of a lone project is a structure change under deep workspac","     { rootDir: workspaceDir as ProjectRootDir, manifest: { name: 'root', version: '1.0.1' } },","   ]","   expect(findWorkspaceStructureIssue(context(allProjects, { linkWorkspacePackages: 'deep' })))","-    .toBe('The workspace structure has changed since last install')","+    .toBe(STRUCTURE_CHANGED)"," })"," ","-test('a version bump in a workspace of several projects is a structure change', () => {","+// https://github.com/pnpm/tasks/issues/246"],"additions":4,"deletions":3,"truncated":false}],"additions":420,"deletions":67,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-03T16:47:46.502137+00:00"}