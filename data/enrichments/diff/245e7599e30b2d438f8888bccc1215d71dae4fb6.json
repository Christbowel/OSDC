+enum ParentKind {","+    /// A hoist root or one of its ancestors: read through symlinks.","+    Root,","+    /// A directory below a hoist root: must not be a symlink.","+    Owned,","+}","+","+/// Create `root` below its nearest existing ancestor.","+fn create_hoist_root(root: &Path) -> Result<(), crate::SymlinkPackageError> {","+    let existing = root","+        .ancestors()","+        .find(|ancestor| {","+            !matches!(std::fs::metadata(ancestor), Err(error) if error.kind() == io::ErrorKind::NotFound)","+        })","+        .ok_or_else(|| {","+            parent_dir_error(","+                root,","+                io::Error::new(","+                    io::ErrorKind::NotFound,","+                    \"workspace hoist directory has no existing ancestor\",","+                ),","+            )","+        })?;","+    create_or_validate(existing, ParentKind::Root)?;","+    create_dirs_below(existing, root, ParentKind::Root)","+}","+","+/// Create every directory from `root` (exclusive) down to `parent`.","+fn create_dirs_below(","+    root: &Path,","+    parent: &Path,","+    kind: ParentKind,","+) -> Result<(), crate::SymlinkPackageError> {","+    let relative = parent","+        .strip_prefix(root)","+        .map_err(|error| {","+            parent_dir_error(parent, io::Error::new(io::ErrorKind::InvalidInput, error))","+        })?;","+    let mut current = root.to_path_buf();","+    for component in relative.components() {","+        current.push(component);","+        create_or_validate(&current, kind)?;","+    }","+    Ok(())","+}","+","+fn create_or_validate(dir: &Path, kind: ParentKind) -> Result<(), crate::SymlinkPackageError> {","+    let shape = match probe(dir, kind) {","+        Ok(shape) => shape,","+        Err(error) if error.kind() == io::ErrorKind::NotFound => match std::fs::create_dir(dir) {","+            Ok(()) => return Ok(()),","+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {","+                probe(dir, kind).map_err(|error| parent_dir_error(dir, error))?","+            }","+            Err(error) => return Err(parent_dir_error(dir, error)),","+        },","+        Err(error) => return Err(parent_dir_error(dir, error)),","+    };","+    if shape.is_symlink || !shape.is_dir {","+        return Err(parent_dir_error(","+            dir,","+            io::Error::new(","+                io::ErrorKind::InvalidInput,","+                \"workspace hoist directory is not a real directory\",","+            ),","+        ));","+    }","+    Ok(())","+}","+","+struct ParentShape {","+    is_dir: bool,","+    is_symlink: bool,","+}","+","+fn probe(dir: &Path, kind: ParentKind) -> io::Result<ParentShape> {","+    let metadata = match kind {","+        ParentKind::Root => std::fs::metadata(dir),","+        ParentKind::Owned => std::fs::symlink_metadata(dir),","+    };","+    match metadata {","+        Ok(metadata) => Ok(ParentShape {","+            is_dir: metadata.is_dir(),","+            is_symlink: metadata.file_type().is_symlink(),","+        }),","+        #[cfg(windows)]","+        Err(error)","+            if error.raw_os_error()","+                == Some(windows_sys::Win32::Foundation::ERROR_SHARING_VIOLATION as i32) =>","+        {","+            probe_attributes(dir, kind)","+        }","+        Err(error) => Err(error),","+    }","+}","+","+/// Read the attributes of a directory another process holds open without","+/// sharing, which the metadata calls refuse. The attributes describe the","+/// link itself, so a reparse point held this way passes only as a root.","+#[cfg(windows)]","+fn probe_attributes(dir: &Path, kind: ParentKind) -> io::Result<ParentShape> {","+    use std::os::windows::ffi::OsStrExt;","+    use windows_sys::Win32::Storage::FileSystem::{","+        FILE_ATTRIBUTE_DIRECTORY, FILE_ATTRIBUTE_REPARSE_POINT, GetFileAttributesW,","+        INVALID_FILE_ATTRIBUTES,","+    };","+","+    let path = dir","+        .as_os_str()","+        .encode_wide()","+        .chain(std::iter::once(0))","+        .collect::<Vec<_>>();","+    // SAFETY: `path` is NUL-terminated and remains alive for the duration of the call.","+    let attributes = unsafe { GetFileAttributesW(path.as_ptr()) };","+    if attributes == INVALID_FILE_ATTRIBUTES {","+        return Err(io::Error::last_os_error());","+    }","+    Ok(ParentShape {","+        is_dir: attributes & FILE_ATTRIBUTE_DIRECTORY != 0,","+        is_symlink: matches!(kind, ParentKind::Owned)","+            && attributes & FILE_ATTRIBUTE_REPARSE_POINT != 0,","+    })","+}","+","+fn parent_dir_error(dir: &Path, error: io::Error) -> crate::SymlinkPackageError {","+    crate::SymlinkPackageError::CreateParentDir { dir: dir.to_path_buf(), error }","+}"],"additions":167,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/hoist/tests.rs","lines":["@@ -703,7 +703,7 @@ fn symlink_creates_fresh_multi_component_hoist_roots() {"," }"," "," #[test]","-fn symlink_rejects_symlinked_hoist_root() {","+fn symlink_accepts_symlinked_hoist_root_pointing_to_real_directory() {","     use crate::VirtualStoreLayout;","     use tempfile::tempdir;"," ","@@ -723,7 +723,7 @@ fn symlink_rejects_symlinked_hoist_root() {","             pnpm_config::default_virtual_store_dir_max_length() as usize,","         );","         let workspace_aliases = vec![(\"project\".to_string(), HoistKind::Public, project_dir)];","-        let result = super::symlink_hoisted_dependencies(","+        super::symlink_hoisted_dependencies(","             &HashMap::new(),","             &workspace_aliases,","             &HashMap::new(),","@@ -731,18 +731,123 @@ fn symlink_rejects_symlinked_hoist_root() {","             &private_hoisted,","             &public_hoisted,","             &HashSet::new(),","-        );","+        )","+        .unwrap();"," ","-        assert!(","-            matches!(result, Err(crate::SymlinkPackageError::CreateParentDir { .. })),","-            \"symlinked hoist root must be 