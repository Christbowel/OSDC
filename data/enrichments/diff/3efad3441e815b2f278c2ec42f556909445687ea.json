DownstreamNSIndex = \"mgmt-auth-gr-downstream-ns-index\"","+\t// GRBGlobalRoleIndex is the cache index name for looking up GlobalRoleBindings by the GlobalRole they reference.","+\tGRBGlobalRoleIndex = \"mgmt-auth-grb-gr-idex\""," )"," "," // BuildSubjectFromRTB This function will generate"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/controllers/globalroles/globalrole_test.go","lines":["@@ -88,7 +88,9 @@ func (s *GlobalRoleTestSuite) SetupSuite() {"," \ts.managementContext, err = scaledContext.NewManagementContext()"," \tassert.NoError(s.T(), err)"," ","-\t// Register controller","+\t// Register controller. The indexers shared with the downstream controllers are registered","+\t// separately on every replica, and the enqueuers wired by Register depend on them.","+\tglobalroles.RegisterWranglerIndexers(s.managementContext.Wrangler.Mgmt.GlobalRoleBinding().Cache())"," \tglobalroles.Register(s.ctx, s.managementContext, clusterManager)"," "," \t// Start controllers"],"additions":3,"deletions":1,"truncated":false},{"path":"tests/controllers/globalroles/indexers_test.go","lines":["@@ -0,0 +1,138 @@","+package globalroles_integration_test","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\tv3 \"github.com/rancher/rancher/pkg/apis/management.cattle.io/v3\"","+\tmanagementauth \"github.com/rancher/rancher/pkg/controllers/management/auth\"","+\t\"github.com/rancher/rancher/pkg/features\"","+\tpkgrbac \"github.com/rancher/rancher/pkg/rbac\"","+\t\"github.com/rancher/rancher/pkg/wrangler\"","+\t\"github.com/rancher/rancher/tests/controllers/common\"","+\t\"github.com/rancher/wrangler/v3/pkg/crd\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/suite\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\t\"k8s.io/client-go/rest\"","+\t\"sigs.k8s.io/controller-runtime/pkg/envtest\"","+)","+","+// IndexerTestSuite models a replica that owns a downstream cluster but is not the leader. Only the","+// registration path that every replica runs is exercised, so an indexer that moves back into the","+// leader-only globalroles.Register will fail here. See rancher/rancher#56890.","+type IndexerTestSuite struct {","+\tsuite.Suite","+\tctx             context.Context","+\tcancel          context.CancelFunc","+\ttestEnv         *envtest.Environment","+\trestCfg         *rest.Config","+\twranglerContext *wrangler.Context","+}","+","+func (s *IndexerTestSuite) SetupSuite() {","+\ts.ctx, s.cancel = context.WithCancel(context.TODO())","+","+\ts.testEnv = &envtest.Environment{}","+\trestCfg, err := s.testEnv.Start()","+\tassert.NoError(s.T(), err)","+\tassert.NotNil(s.T(), restCfg)","+\ts.restCfg = restCfg","+","+\tcommon.RegisterCRDs(s.ctx, s.T(), restCfg,","+\t\tcrd.CRD{","+\t\t\tSchemaObject: v3.GlobalRole{},","+\t\t\tNonNamespace: true,","+\t\t\tStatus:       true,","+\t\t},","+\t\tcrd.CRD{","+\t\t\tSchemaObject: v3.GlobalRoleBinding{},","+\t\t\tNonNamespace: true,","+\t\t},","+\t)","+","+\ts.wranglerContext, err = wrangler.NewContext(s.ctx, nil, restCfg)","+\tassert.NoError(s.T(), err)","+","+\t// Deliberately without globalroles.Register, which only runs on the leader.","+\tmanagementauth.RegisterWranglerIndexers(s.wranglerContext)","+","+\tcommon.StartWranglerCaches(s.ctx, s.T(), s.wranglerContext,","+\t\tschema.GroupVersionKind{","+\t\t\tGroup:   \"management.cattle.io\",","+\t\t\tVersion: \"v3\",","+\t\t\tKind:    \"GlobalRoleBinding\",","+\t\t},","+\t)","+}","+","+func (s *IndexerTestSuite) TearDownSuite() {","+\ts.cancel()","+\terr := s.testEnv.Stop()","+\tassert.NoError(s.T(), err)","+}","+","+// TestGRBByGlobalRoleIndex covers the lookup the downstream enqueue-grbs-by-namespace handler performs","+// when a namespace referenced by inheritedNamespacedRules is created after the GlobalRole.","+func (s *IndexerTestSuite) TestGRBByGlobalRoleIndex() {","+\tt := s.T()","+","+\tgr := &v3.GlobalRole{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName: \"indexed-gr\",","+\t\t},","+\t}","+\t_, err := s.wranglerContext.Mgmt.GlobalRole().Create(gr)","+\tassert.NoError(t, err)","+","+\tgrb := &v3.GlobalRoleBinding{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName: \"indexed-grb\",","+\t\t},","+\t\tGlobalRoleName: gr.Name,","+\t\tUserName:       \"u-indexed\",","+\t}","+\t_, err = s.wranglerContext.Mgmt.GlobalRoleBinding().Create(grb)","+\tassert.NoError(t, err)","+","+\t// The last result is kept so a missing indexer reports its own error rather than only a timeout.","+\tgrbCache := s.wranglerContext.Mgmt.GlobalRoleBinding().Cache()","+\tvar indexed []*v3.GlobalRoleBinding","+\tassert.Eventually(t, func() bool {","+\t\tindexed, err = grbCache.GetByIndex(pkgrbac.GRBGlobalRoleIndex, gr.Name)","+\t\treturn err == nil && len(indexed) == 1","+\t}, duration, tick)","+\tassert.NoError(t, err)","+\tif assert.Len(t, indexed, 1) {","+\t\tassert.Equal(t, grb.Name, indexed[0].Name)","+\t}","+","+\terr = s.wranglerContext.Mgmt.GlobalRoleBinding().Delete(grb.Name, &metav1.DeleteOptions{})","+\tassert.NoError(t, err)","+\terr = s.wranglerContext.Mgmt.GlobalRole().Delete(gr.Name, &metav1.DeleteOptions{})","+\tassert.NoError(t, err)","+}","+","+// TestGRBByGlobalRoleIndexWithoutMCM covers the rancher instance embedded in the cluster agent, which","+// runs the same registration with MCM off. The GlobalRoleBinding CRD is not installed there, so the","+// cache must be left alone rather than started against a resource that does not exist.","+func (s *IndexerTestSuite) TestGRBByGlobalRoleIndexWithoutMCM() {","+\tt := s.T()","+","+\tfeatures.MCM.Set(false)","+\tdefer features.MCM.Set(true)","+","+\t// A separate context so the indexer registered by the suite is not visible here.","+\tnoMCMContext, err := wrangler.NewContext(s.ctx, nil, s.restCfg)","+\tassert.NoError(t, err)","+","+\tmanagementauth.RegisterWranglerIndexers(noMCMContext)","+","+\t_, err = noMCMContext.Mgmt.GlobalRoleBinding().Cache().GetByIndex(pkgrbac.GRBGlobalRoleIndex, \"indexed-gr\")","+\tassert.ErrorContains(t, err, pkgrbac.GRBGlobalRoleIndex)","+}","+","+func TestIndexerTestSuite(t *testing.T) {","+\tsuite.Run(t, new(IndexerTestSuite))","+}",""],"additions":138,"deletions":0,"truncated":false}],"additions":196,"deletions":11,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-09-02T12:24:31.774398+00:00"}