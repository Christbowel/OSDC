rom exc","+    if not isinstance(names, list) or any(not isinstance(name, str) or not name for name in names):","+        raise ValueError(error)","+    return set(names)","+","+","+def merge_selected_tests(","+    candidates: list[str], selected: list[str], bypass: set[str]","+) -> tuple[list[str], list[str]]:","+    \"\"\"Filter candidates in their original order, preserving candidate duplicates.\"\"\"","+    allowed = set(selected) | bypass","+    return (","+        [test for test in candidates if test in allowed],","+        [test for test in candidates if test not in allowed],","+    )"],"additions":33,"deletions":0,"truncated":false},{"path":"buildscripts/tests/resmokelib/testing/BUILD.bazel","lines":["@@ -55,6 +55,11 @@ py_test(","         \"__init__.py\",","         \"test_suite.py\",","     ],","+    data = [","+        \"//buildscripts:evergreen_expansions2bash.py\",","+        \"//evergreen:prelude.sh\",","+        \"//evergreen:resmoke_tests_execute.sh\",","+    ],","     visibility = [\"//visibility:public\"],","     deps = [","         \"//buildscripts/resmokelib\","],"additions":5,"deletions":0,"truncated":false},{"path":"buildscripts/tests/resmokelib/testing/test_suite.py","lines":["@@ -1,9 +1,15 @@"," \"\"\"Unit tests for the resmokelib.testing.suite module.\"\"\""," ","+import json"," import logging"," import os","+import pathlib","+import shutil","+import subprocess","+import sys"," import tempfile"," import unittest","+from unittest.mock import patch"," "," import yaml"," from mock import MagicMock","@@ -14,6 +20,226 @@"," from buildscripts.resmokelib.testing.testcases.interface import TestCase"," "," ","+class TestBypassEnvironmentTransport(unittest.TestCase):","+    def test_patch_bypass_reaches_resmoke_as_environment_not_arguments(self):","+        # Keep Bazel's runfiles tree instead of following symlinks into the checkout.","+        root = pathlib.Path(__file__).absolute().parents[4]","+        with tempfile.TemporaryDirectory() as tmpdir:","+            workdir = pathlib.Path(tmpdir)","+            evergreen_dir = workdir / \"src/evergreen\"","+            evergreen_dir.mkdir(parents=True)","+            script = evergreen_dir / \"resmoke_tests_execute.sh\"","+            shutil.copyfile(root / \"evergreen/resmoke_tests_execute.sh\", script)","+            shutil.copyfile(root / \"evergreen/prelude.sh\", evergreen_dir / \"prelude.sh\")","+            for helper in (","+                \"prelude_workdir.sh\",","+                \"prelude_db_contrib_tool.sh\",","+                \"prelude_mongo_task_generator.sh\",","+                \"prelude_system_env_variables.sh\",","+            ):","+                (evergreen_dir / helper).write_text(\"\")","+            (evergreen_dir / \"prelude_python.sh\").write_text(","+                'test_python=\"$TEST_PYTHON\"\\n'","+                'if [ \"$OS\" = \"Windows_NT\" ]; then\\n'","+                '    test_python=$(cygpath -u \"$test_python\")\\n'","+                \"fi\\n\"","+                'run_test_python() { \"$test_python\" \"$@\"; }\\n'","+                \"python=run_test_python\\n\",","+                newline=\"\\n\",","+            )","+            (evergreen_dir / \"prelude_venv.sh\").write_text(","+                \"activate_venv() { :; }\\nsetup_db_contrib_tool() { :; }\\n\",","+                newline=\"\\n\",","+            )","+            (workdir / \"src/buildscripts\").mkdir()","+            shutil.copyfile(","+                root / \"buildscripts/evergreen_expansions2bash.py\",","+                workdir / \"src/buildscripts/evergreen_expansions2bash.py\",","+            )","+            # A failing stub skips the wrapper's successful-run core-file cleanup.","+            (workdir / \"src/buildscripts/resmoke.py\").write_text(","+                \"import json, os, pathlib, sys\\n\"","+                \"pathlib.Path('captured.json').write_text(json.dumps({\\n\"","+                \"    'bypass': os.environ.get('TEST_SELECTION_BYPASS_QUARANTINE', ''),\\n\"","+                \"    'args': sys.argv[1:],\\n\"","+                \"}))\\n\"","+                \"sys.exit(1)\\n\"","+            )","+            (workdir / \"src/etc\").mkdir()","+            (workdir / \"src/etc/expansions.default.yml\").write_text(","+                yaml.safe_dump(","+                    {","+                        \"disable_unit_tests\": \"false\",","+                        \"should_shuffle\": \"false\",","+                        \"continue_on_failure\": \"false\",","+                        \"resmoke_jobs\": \"1\",","+                        \"workdir\": \"..\",","+                    }","+                )","+            )","+            names = [","+                \"a,b.js\",","+                \" a.js \",","+                \"a  b.js\",","+                \"a\\t\\tb.js\",","+                'a\"b.js',","+                r\"a\\b.js\",","+                \"a=b.js\",","+                \"$(touch injected)\",","+                \"`touch injected`\",","+                \"';touch injected;'\",","+            ]","+            raw = json.dumps(names, indent=2)","+            for is_patch, value, inherited, expected in (","+                (\"true\", raw, None, names),","+                (\"true\", \"[]\", None, []),","+                (\"false\", raw, \"stale\", None),","+                (\"true\", None, \"stale\", None),","+            ):","+                with self.subTest(is_patch=is_patch, value=value):","+                    expansions = {\"is_patch\": is_patch}","+                    if value is not None:","+                        expansions[\"test_selection_bypass_quarantine\"] = value","+                    (workdir / \"expansions.yml\").write_text(yaml.safe_dump(expansions))","+                    env = {","+                        **os.environ,","+                        \"TEST_PYTHON\": sys.executable,","+                        \"OS\": \"Windows_NT\" if sys.platform == \"win32\" else \"\",","+                    }","+                    env.pop(\"TEST_SELECTION_BYPASS_QUARANTINE\", None)","+                    if inherited is not None:","+                        env[\"TEST_SELECTION_BYPASS_QUARANTINE\"] = inherited","+                    captured_file = workdir / \"src/captured.json\"","+                    captured_file.unlink(missing_ok=True)","+                    result = subprocess.run(","+                        [\"bash\", script.relative_to(workdir).as_posix()],","+                        cwd=workdir,","+                        text=True,","+                        capture_output=True,","+                        env=env,","+                    )","+                    self.assertEqual(","+                        0,","+                        result.returncode,","+                        msg=f\"stdout:\\n{result.stdout}\\nstderr:\\n{result.stderr}\",","+                    )","+                    captured = json.loads(captured_file.read_text())","+                    if expected is None:","+                        self.assertEqual(\"\", captured[\"bypass\"])","+                    else:","+                        # Cygwin normalizes newlines when passing JSON to native Windows Python.","+                        self.assertEqual(expected, json.loads(captured[\"bypass\"]))","+                    self.assertEqual(\"run\", captured[\"args\"][0])","+                    self.assertNotIn(\"a,b.js\", \" \".join(captured[\"args\"]))","+                    self.assertFalse((workdir / \"src/injected\").exists())","+","+","+class TestPatchTestSelectionBypass(unittest.TestCase):","+    def setUp(self):","+        for name, value in (","+            (\"EVERGREEN_TASK_ID\", \"task\"),","+            (\"ENABLE_EVERGREEN_API_TEST_SELECTION\", True),","+            (\"EVERGREEN_PATCH_BUILD\", True),","+            (\"TSS_TEST_LIST\", None),","+            (\"SHARD_COUNT\", None),","+            (\"SHARD_INDEX\", None),","+        ):","+            self.enterContext(patch.object(under_test._config, name, value))","+        self.enterContext(","+            patch.object(loggers, \"ROOT_EXECUTOR_LOGGER\", logging.getLogger(\"bypass-test\"))","+        )","+        self.enterContext(patch.dict(os.environ, {}, clear=True))","+        self.suite = under_test.Suite(\"suite_name\", {\"test_kind\": \"js_test\", \"selector\": {}})","+        self.api = MagicMock()","+        self.api.select_tests.return_value = {\"tests\": [\"a.js\", \"outside.js\"]}","+        self.client = self.enterContext(","+            patch.object(under_test.evergreen_conn, \"get_evergreen_api\", return_value=self.api)","+        )","+","+    def test_restores_only_bypassed_candidates_in_candidate_order(self):","+        os.environ[\"TEST_SELECTION_BYPASS_QUARANTINE\"] = '[\"b  b.js\",\"b  b.js\",\"outside.js\"]'","+        self.assertEqual(","+            ([\"b  b.js\", \"a.js\"], [\"b b.js\", \"c.js\"]),","+            self.suite._apply_test_selection([\"b  b.js\", \"a.js\", \"b b.js\", \"c.js\"]),","+        )","+        self.assertEqual(","+            [\"b  b.js\", \"a.js\", \"b b.js\", \"c.js\"],","+            self.api.select_tests.call_args.kwargs[\"tests\"],","+        )","+        self.assertNotIn(\"test_selection_bypass_quarantine\", self.api.select_tests.call_args.kwargs)","+","+    def test_invalid_active_bypass_fails_before_client_creation(self):","+        os.environ[\"TEST_SELECTION_BYPASS_QUARANTINE\"] = \"broken\"","+        with self.assertRaisesRegex(ValueError, \"test_selection_bypass_quarantine\"):","+            self.suite._apply_test_selection([\"a.js\"])","+        self.client.assert_not_called()","+","+    def test_absent_and_empty_bypass_preserve_selection(self):","+        for env in (","+            {},","+            {\"TEST_SELECTION_BYPASS_QUARANTINE\": \"\"},","+            {\"TEST_SELECTION_BYPASS_QUARANTINE\": \"[]\"},","+        ):","+            with self.subTest(env=env), patch.dict(os.environ, env, clear=True):","+               