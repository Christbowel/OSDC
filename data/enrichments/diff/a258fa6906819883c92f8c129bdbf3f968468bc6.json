on_error(self):","+        for raw, api_error, message in (","+            (\"broken\", None, \"test_selection_bypass_quarantine\"),","+            ('[\"b  b.js\"]', ConnectionError(\"503 error\"), \"503\"),","+        ):","+            with self.subTest(raw=raw, api_error=api_error):","+                result, consumed, error, stderr, api = self._generate_and_consume(","+                    raw, side_effect=api_error","+                )","+                self.assertEqual(","+                    {","+                        \"suite\": \"//pkg:suite\",","+                        \"status\": \"failed\",","+                        \"tests\": [\"b  b.js\", \"a.js\", \"c.js\", \"b  b.js\"],","+                    },","+                    result,","+                )","+                self.assertEqual(([\"b  b.js\", \"a.js\", \"not_in_generated_file.js\"], []), consumed)","+                self.assertIsNotNone(error)","+                self.assertIn(message, stderr)","+                if api_error is None:","+                    api.select_tests.assert_not_called()","+","+    def test_disabled_or_missing_identity_does_not_parse_invalid_bypass(self):","+        for enabled, task_id in ((False, True), (True, False)):","+            with self.subTest(enabled=enabled, task_id=task_id):","+                result, consumed, error, _, api = self._generate_and_consume(","+                    \"broken\", enabled=enabled, task_id=task_id","+                )","+                self.assertEqual(","+                    {","+                        \"suite\": \"//pkg:suite\",","+                        \"status\": \"disabled\",","+                        \"tests\": [\"b  b.js\", \"a.js\", \"c.js\", \"b  b.js\"],","+                    },","+                    result,","+                )","+                self.assertEqual(([\"b  b.js\", \"a.js\", \"not_in_generated_file.js\"], []), consumed)","+                self.assertIsNone(error)","+                api.select_tests.assert_n