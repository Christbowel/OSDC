age/jpeg')).toBe(true)","+      expect(accepts({type: 'application/pdf'}, 'application/pdf')).toBe(true)","+    })","+","+    it('for wildcard MIME type matches', () => {","+      expect(accepts({type: 'image/png'}, 'image/*')).toBe(true)","+      expect(accepts({type: 'image/jpeg'}, 'image/*')).toBe(true)","+      expect(accepts({type: 'video/mp4'}, 'video/*')).toBe(true)","+      expect(accepts({type: 'text/plain'}, 'text/*')).toBe(true)","+    })","+","+    it('for file extension matches with filename', () => {","+      expect(accepts({type: 'application/pdf', name: 'document.pdf'}, '.pdf')).toBe(true)","+      expect(accepts({type: 'image/jpeg', name: 'photo.jpg'}, '.jpg')).toBe(true)","+      expect(accepts({type: 'image/jpeg', name: 'Photo.JPG'}, '.jpg')).toBe(true)","+    })","+","+    it('for file extension without filename (fail open)', () => {","+      expect(accepts({type: 'application/pdf'}, '.pdf')).toBe(true)","+      expect(accepts({type: 'application/pdf', name: ''}, '.pdf')).toBe(true)","+    })","+","+    it('when any of multiple accept values match', () => {","+      expect(accepts({type: 'image/png'}, 'image/png,image/jpeg')).toBe(true)","+      expect(accepts({type: 'image/jpeg'}, 'image/png,image/jpeg')).toBe(true)","+      expect(accepts({type: 'image/png'}, ['image/png', 'image/jpeg'])).toBe(true)","+      expect(accepts({type: 'image/jpeg'}, ['image/png', 'image/jpeg'])).toBe(true)","+    })","+","+    it('with spaces in the accept string', () => {","+      expect(accepts({type: 'image/png'}, 'image/png, image/jpeg')).toBe(true)","+      expect(accepts({type: 'image/jpeg'}, '  image/jpeg  ')).toBe(true)","+    })","+","+    it('case-insensitively for MIME types', () => {","+      expect(accepts({type: 'IMAGE/PNG'}, 'image/png')).toBe(true)","+      expect(accepts({type: 'image/png'}, 'IMAGE/PNG')).toBe(true)","+    })","+","+    it('case-insensitively for file extensions', () => {","+      expect(accepts({type: '', name: 'document.PDF'}, '.pdf')).toBe(true)","+      expect(accepts({type: '', name: 'document.pdf'}, '.PDF')).toBe(true)","+    })","+  })","+","+  describe('returns false (rejects)', () => {","+    it('rejects everything when acceptedFiles is an empty array', () => {","+      expect(accepts({type: 'image/png'}, [])).toBe(false)","+    })","+","+    it('when MIME type does not match', () => {","+      expect(accepts({type: 'image/png'}, 'image/jpeg')).toBe(false)","+      expect(accepts({type: 'video/mp4'}, 'image/*')).toBe(false)","+    })","+","+    it('when file extension does not match (with filename)', () => {","+      expect(accepts({type: 'application/pdf', name: 'document.pdf'}, '.txt')).toBe(false)","+      expect(accepts({type: 'image/jpeg', name: 'photo.jpg'}, '.png')).toBe(false)","+    })","+","+    it('when none of multiple accept values match', () => {","+      expect(accepts({type: 'video/mp4'}, 'image/png,image/jpeg')).toBe(false)","+      expect(accepts({type: 'video/mp4'}, ['image/png', 'image/jpeg'])).toBe(false)","+    })","+","+    it('when wildcard does not match the base MIME type', () => {","+      expect(accepts({type: 'imagex/png'}, 'image/*')).toBe(false)","+      expect(accepts({type: 'text/plain'}, 'image/*')).toBe(false)","+    })","+  })","+","+  describe('edge cases', () => {","+    it('handles empty file type', () => {","+      expect(accepts({type: ''}, 'image/*')).toBe(false)","+      expect(accepts({type: ''}, '.pdf')).toBe(true)","+    })","+","+    it('handles file with only name, no type', () => {","+      expect(accepts({type: '', name: 'document.pdf'}, '.pdf')).toBe(true)","+      expect(accepts({type: '', name: 'document.txt'}, '.pdf')).toBe(false)","+    })","+","+    it('handles mixed MIME types and extensions in accept', () => {","+      expect(accepts({type: 'image/png'}, 'image/png,.pdf')).toBe(true)","+      expect(accepts({type: '', name: 'document.pdf'}, 'image/png,.pdf')).toBe(true)","+      expect(accepts({type: 'video/mp4', name: 'video.mp4'}, 'image/png,.pdf')).toBe(false)","+    })","+","+    it('handles complex accept strings', () => {","+      const acceptString = 'image/*, video/mp4, .pdf, application/msword'","+      expect(accepts({type: 'image/png'}, acceptString)).toBe(true)","+      expect(accepts({type: 'video/mp4'}, acceptString)).toBe(true)","+      expect(accepts({type: '', name: 'doc.pdf'}, acceptString)).toBe(true)","+      expect(accepts({type: 'application/msword'}, acceptString)).toBe(true)","+      expect(accepts({type: 'audio/mp3', name: 'music.mp3'}, acceptString)).toBe(false)","+    })","+","+    it('fails open for extension-based accept when file has no name (hover behavior)', () => {","+      expect(accepts({type: 'video/mp4'}, '.pdf')).toBe(true)","+      expect(accepts({type: 'video/mp4'}, 'image/png,.pdf')).toBe(true)","+      expect(accepts({type: 'audio/mp3'}, 'image/*, video/mp4, .pdf')).toBe(true)","+    })","+  })","+})"],"additions":117,"deletions":0,"truncated":false},{"path":"packages/@sanity/util/src/accepts/accepts.ts","lines":["rename from packages/@sanity/validation/src/util/accepts.ts","rename to packages/@sanity/util/src/accepts/accepts.ts","@@ -5,6 +5,11 @@","  * Inspired by https://github.com/enyo/dropzone (MIT) (c) 2021 Matias Meno","  * Based on https://github.com/react-dropzone/attr-accept (MIT) (c) 2015 Andrey Okonetchnikov","  *","+ * Diverges from attr-accept in one case: when the accept entry is an extension (e.g. `.pdf`)","+ * and the file has no name, this returns `true` (fail open). Browsers omit the file name while","+ * hovering a file over an input and only provide it on drop, so failing closed would incorrectly","+ * reject files during hover.","+ *","  * @param file - https://developer.mozilla.org/en-US/docs/Web/API/File","  * @param acceptedFiles - List of accepted mime types (comma-separated string or array)","  * @returns True if file is accepted, false otherwise","@@ -33,10 +38,6 @@ export function accepts(","       if (fileName) {","   