{"id":"5bb3175ccec08a8d1e3e47db2d98730b2a0b63a6","axis":"silent","repo":"quarkusio/quarkus","sha":"5bb3175ccec08a8d1e3e47db2d98730b2a0b63a6","parsed":{"files":[{"path":"docs/src/main/asciidoc/observability-devservices-lgtm.adoc","lines":["@@ -551,6 +551,53 @@ To set a custom dashboard as the Grafana home dashboard, point to a dashboard JS"," quarkus.observability.lgtm.grafana-home-dashboard-path=/otel-lgtm/grafana-dashboard-my-home.json"," ----"," ","+=== GCX configuration","+","+The https://grafana.com/docs/grafana-cloud/developer-resources/infrastructure-as-code/gcx/[GCX CLI] (Grafana Cloud Experience) can connect to the local LGTM stack for diagnostics, querying, and AI-assisted analysis. When the LGTM container starts, a GCX-compatible YAML configuration is automatically generated with the correct Grafana endpoint, credentials, and datasource UIDs.","+","+By default, the configuration is printed to standard output between delimiters:","+","+[source, log]","+----","+###### LGTM GCX config ######","+current-context: lgtm-local","+stacks:","+  lgtm-local:","+    grafana:","+      server: http://localhost:42797","+      org-id: 1","+      auth-method: basic","+      user: admin","+      password: admin","+contexts:","+  lgtm-local:","+    stack: lgtm-local","+    datasources:","+      prometheus: prometheus","+      loki: loki","+      tempo: tempo","+      pyroscope: pyroscope","+###### LGTM GCX config ######","+----","+","+To write the configuration to a file instead, set the `gcx-file-path` property:","+","+[source,properties]","+----","+quarkus.observability.lgtm.gcx-file-path=${user.home}/.config/gcx/config.yaml","+----","+","+The file is overwritten on each container start because the mapped Grafana port changes between restarts.","+","+Once the config file is in place, you can use `gcx` to verify connectivity and query data:","+","+[source,bash]","+----","+gcx config check --config ~/.config/gcx/config.yaml --context lgtm-local","+gcx metrics query 'vector(1)' --datasource prometheus --config ~/.config/gcx/config.yaml --context lgtm-local","+gcx traces query '{ resource.service.name = \"my-service\" }' --datasource tempo --since 5m --limit 10 --config ~/.config/gcx/config.yaml --context lgtm-local","+----","+"," === Forward telemetry to external vendors"," "," The built-in OpenTelemetry Collector can forward telemetry data to external backends via OTLP/HTTP, enabling easy comparison between the local LGTM stack and a vendor backend."],"additions":47,"deletions":0,"truncated":false},{"path":"extensions/observability-devservices/common/src/main/java/io/quarkus/observability/common/config/LgtmConfig.java","lines":["@@ -205,6 +205,13 @@ public interface LgtmConfig extends GrafanaConfig {","      */","     Optional<String> vendorOtlpHeaders();"," ","+    /**","+     * File path to write the GCX (Grafana Cloud Experience) config file.","+     * When set, the GCX YAML config is written to this path after the container starts.","+     * When not set, the GCX config is printed to standard output with delimiters.","+     */","+    Optional<String> gcxFilePath();","+","     /**","      * A way to override `quarkus.otel.metric.export.interval` property's default value.","      */"],"additions":7,"deletions":0,"truncated":false},{"path":"extensions/observability-devservices/testcontainers/src/main/java/io/quarkus/observability/testcontainers/LgtmContainer.java","lines":["@@ -429,6 +429,11 @@ public Optional<String> vendorOtlpHeaders() {","             return Optional.empty();","         }"," ","+        @Override","+        public Optional<String> gcxFilePath() {","+            return Optional.empty();","+        }","+","         @Override","         public String otelMetricExportInterval() {","             return ContainerConstants.OTEL_METRIC_EXPORT_INTERVAL;"],"additions":5,"deletions":0,"truncated":false},{"path":"extensions/observability-devservices/testlibs/devresource-lgtm/src/main/java/io/quarkus/observability/devresource/lgtm/LgtmResource.java","lines":["@@ -1,9 +1,14 @@"," package io.quarkus.observability.devresource.lgtm;"," ","+import java.io.IOException;","+import java.io.UncheckedIOException;","+import java.nio.file.Files;","+import java.nio.file.Path;"," import java.util.ArrayList;"," import java.util.HashMap;"," import java.util.List;"," import java.util.Map;","+import java.util.Optional;"," import java.util.Set;"," import java.util.function.Function;"," ","@@ -230,10 +235,56 @@ public Map<String, String> doStart() {"," ","     @Override","     public void logInfo() {","-        // move here, so we see it logged","         for (String dashboard : container.getCustomDashboards()) {","             log.infof(\"Adding custom Grafana dashboard config: %s\", dashboard);","         }","+        dumpGcxConfig();","+    }","+","+    private String buildGcxConfig() {","+        String host = container.getHost();","+        int grafanaPort = container.getGrafanaPort();","+        String username = config != null ? config.username() : \"admin\";","+        String password = config != null ? config.password() : \"admin\";","+","+        return \"current-context: lgtm-local\\n\" +","+                \"stacks:\\n\" +","+                \"  lgtm-local:\\n\" +","+                \"    grafana:\\n\" +","+                \"      server: http://\" + host + \":\" + grafanaPort + \"\\n\" +","+                \"      org-id: 1\\n\" +","+                \"      auth-method: basic\\n\" +","+                \"      user: \" + username + \"\\n\" +","+                \"      password: \" + password + \"\\n\" +","+                \"contexts:\\n\" +","+                \"  lgtm-local:\\n\" +","+                \"    stack: lgtm-local\\n\" +","+                \"    datasources:\\n\" +","+                \"      prometheus: prometheus\\n\" +","+                \"      loki: loki\\n\" +","+                \"      tempo: tempo\\n\" +","+                \"      pyroscope: pyroscope\\n\";","+    }","+","+    private void dumpGcxConfig() {","+        String gcxConfig = buildGcxConfig();","+        Optional<String> gcxFilePath = config != null ? config.gcxFilePath() : Optional.empty();","+","+        if (gcxFilePath.isPresent()) {","+            Path path = Path.of(gcxFilePath.get());","+            try {","+                Files.createDirectories(path.getParent());","+                Files.writeString(path, gcxConfig);","+                log.infof(\"GCX config written to: %s\", path);","+            } catch (IOException e) {","+                throw new UncheckedIOException(\"Failed to write GCX config to: \" + path, e);","+            }","+        } else {","+            String delimiter = \"###### LGTM GCX config ######\";","+            System.out.println(delimiter);","+            System.out.print(gcxConfig);","+            System.out.println(delimiter);","+        }","     }"," ","     @Override"],"additions":52,"deletions":1,"truncated":false},{"path":"integration-tests/observability-lgtm/src/main/resources/application.properties","lines":["@@ -11,3 +11,4 @@ quarkus.otel.metric.export.interval=1s"," #quarkus.observability.lgtm.otel-grpc-port=5317"," #quarkus.observability.lgtm.otel-http-port=5318"," ","+#quarkus.observability.lgtm.gcx-file-path=${user.home}/gcx-config.yaml",""],"additions":1,"deletions":0,"truncated":false}],"additions":112,"deletions":1,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-17T18:45:37.203266+00:00"}