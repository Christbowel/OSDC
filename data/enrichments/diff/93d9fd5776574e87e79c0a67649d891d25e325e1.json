,","+\t\t// -bs plus the default -hbs of 10 is below 1 while -bs is not.","+\t\t{\"-bs with -hbs 10\", false, func(v int) (int, int, int, int) { return v - 10, 10, 2, 1 }},","+\t}","+","+\tfor _, strategy := range []scanstrategy.ScanStrategy{scanstrategy.TemplateSpray, scanstrategy.HostSpray} {","+\t\tfor _, test := range tests {","+\t\t\tfor _, value := range []int{0, -1} {","+\t\t\t\tt.Run(fmt.Sprintf(\"%s/%s=%d\", strategy, test.name, value), func(t *testing.T) {","+\t\t\t\t\tengine, _ := newTaskEngine(strategy, nil, nil, nil)","+\t\t\t\t\tbulk, headlessBulk, threads, headlessThreads := test.values(value)","+\t\t\t\t\tengine.options.BulkSize = bulk","+\t\t\t\t\tengine.options.HeadlessBulkSize = headlessBulk","+\t\t\t\t\tengine.options.TemplateThreads = threads","+\t\t\t\t\tengine.options.HeadlessTemplateThreads = headlessThreads","+\t\t\t\t\tengine.workPool = engine.GetWorkPool()","+","+\t\t\t\t\tvar (","+\t\t\t\t\t\trunsMu sync.Mutex","+\t\t\t\t\t\truns   []string","+\t\t\t\t\t)","+","+\t\t\t\t\ttemplatesList := scanTemplates(test.workflow, engine.options, &runsMu, &runs)","+","+\t\t\t\t\t// A workflow clones its input, which needs the input's mutex.","+\t\t\t\t\ttargets := &fakeTargetProvider{}","+","+\t\t\t\t\tfor _, input := range []string{\"a\", \"b\"} {","+\t\t\t\t\t\ttarget := contextargs.NewMetaInput()","+\t\t\t\t\t\ttarget.Input = input","+\t\t\t\t\t\ttargets.values = append(targets.values, target)","+\t\t\t\t\t}","+","+\t\t\t\t\tctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)","+\t\t\t\t\tdefer cancel()","+","+\t\t\t\t\trequire.NotPanics(t, func() {","+\t\t\t\t\t\tengine.ExecuteScanWithOpts(ctx, templatesList, targets, true)","+\t\t\t\t\t})","+\t\t\t\t\trequire.Len(t, runs, 4, \"every template, or the workflow and its subtemplate, runs on every target\")","+\t\t\t\t})","+\t\t\t}","+\t\t}","+\t}","+}","+","+// NewWorkPool builds every pool even when the configured size is below 1, and","+// refreshing it with the same size leaves the pools usable.","+//","+//nolint:paralleltest // keeps the file's tests together","+func TestNewWorkPoolClampsSizeToOne(t *testing.T) {","+\tfor _, size := range []int{0, -1} {","+\t\tt.Run(strconv.Itoa(size), func(t *testing.T) {","+\t\t\tconfig := WorkPoolConfig{","+\t\t\t\tInputConcurrency:         size,","+\t\t\t\tTypeConcurrency:          size,","+\t\t\t\tHeadlessInputConcurrency: size,","+\t\t\t\tHeadlessTypeConcurrency:  size,","+\t\t\t}","+\t\t\tpool := NewWorkPool(config)","+\t\t\trequire.NotNil(t, pool.Default)","+\t\t\trequire.NotNil(t, pool.Headless)","+\t\t\trequire.Equal(t, 1, pool.Default.Size)","+\t\t\trequire.Equal(t, 1, pool.Headless.Size)","+\t\t\trequire.Equal(t, 1, pool.InputPool(tmpltypes.HTTPProtocol).Size)","+\t\t\trequire.Equal(t, 1, pool.InputPool(tmpltypes.HeadlessProtocol).Size)","+","+\t\t\tpool.RefreshWithConfig(config)","+\t\t\trequire.Equal(t, 1, pool.Default.Size)","+\t\t\trequire.Equal(t, 1, pool.Headless.Size)","+\t\t\tpool.Wait()","+\t\t})","+\t}","+}","+","+// workflowTemplate returns a workflow of one step and one subtemplate. The","+// step matches, so the subtemplate runs.","+//","+//nolint:exhaustruct,exhaustruct_v5 // fixtures keep zero-value defaults","+func workflowTemplate(options *types.Options, runsMu *sync.Mutex, runs *[]string) *templates.Template {","+\tprogressBar, _ := progress.NewStatsTicker(0, false, false, false, 0)","+\tstep := func(name string, outputs ...*output.InternalWrappedEvent) *workflows.WorkflowTemplate {","+\t\treturn &workflows.WorkflowTemplate{Executers: []*workflows.ProtocolExecuterPair{{","+\t\t\tExecuter: &mockExecuter{","+\t\t\t\tresult: true,","+\t\t\t\texecuteHook: func(input *contextargs.MetaInput) {","+\t\t\t\t\trunsMu.Lock()","+\t\t\t\t\tdefer runsMu.Unlock()","+","+\t\t\t\t\t*runs = append(*runs, name+\"@\"+input.Input)","+\t\t\t\t},","+\t\t\t\toutputs: outputs,","+\t\t\t},","+\t\t\tOptions: &protocols.ExecutorOptions{Progress: progressBar},","+\t\t}}}","+\t}","+","+\tmatched := &output.InternalWrappedEvent{OperatorsResult: &operators.Result{}, Results: []*output.ResultEvent{{}}}","+\troot := step(\"root\", matched)","+\troot.Subtemplates = []*workflows.WorkflowTemplate{step(\"sub\")}","+","+\tworkflow := &workflows.Workflow{","+\t\tOptions:   &protocols.ExecutorOptions{Options: options},","+\t\tWorkflows: []*workflows.WorkflowTemplate{root},","+\t}","+","+\treturn &templates.Template{","+\t\tID:               \"workflow.yaml\",","+\t\tPath:             \"workflow.yaml\",","+\t\tTotalRequests:    1,","+\t\tWorkflow:         *workflow,","+\t\tCompiledWorkflow: workflow,","+\t}","+}","+","+// scanTemplates returns two templates, or one workflow that runs a step and a","+// subtemplate.","+//","+//nolint:exhaustruct,exhaustruct_v5 // fixtures keep zero-value defaults","+func scanTemplates(workflow bool, options *types.Options, runsMu *sync.Mutex, runs *[]string) []*templates.Template {","+\tif workflow {","+\t\treturn []*templates.Template{workflowTemplate(options, runsMu, runs)}","+\t}","+","+\tlist := make([]*templates.Template, 0, 2)","+\tfor _, path := range []string{\"one.yaml\", \"two.yaml\"} {","+\t\tlist = append(list, &templates.Template{","+\t\t\tID:            path,","+\t\t\tPath:          path,","+\t\t\tTotalRequests: 1,","+\t\t\tExecuter:      &recordingExecuter{path: path, mu: runsMu, runs: runs},","+\t\t})","+\t}","+","+\treturn list","+}"],"additions":174,"deletions":0,"truncated":false},{"path":"pkg/protocols/common/automaticscan/automaticscan.go","lines":["@@ -130,7 +130,10 @@ func (s *Service) Execute(ctx context.Context) error {"," \t\ts.opts.Progress.AddToTotal(int64(getRequestCount(s.techTemplates)) * s.target.Count())"," \t}"," \t// setup host concurrency","-\tsg, err := syncutil.New(syncutil.WithSize(s.opts.Options.BulkSize))","+\t// syncutil.New rejects a size below 1, so a -bs below 1 scans one host at a time.","+\tbulkSize := max(s.opts.Options.BulkSize, 1)","+","+\tsg, err := syncutil.New(syncutil.WithSize(bulkSize)) //nolint:var