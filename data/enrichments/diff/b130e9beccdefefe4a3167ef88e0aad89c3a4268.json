RefExpression &col,","-                                                    const LogicalType &col_type) {","+static unique_ptr<Expression> FloatRoundingPreimage(ClientContext &context, IntegerRounding rounding,","+                                                    ExpressionType cmp, const Value &c,","+                                                    const BoundColumnRefExpression &col, const LogicalType &col_type) {"," \tconst auto value = c.GetValue<double>();"," \t// the integers next to the constant must be exact, which they are not beyond 2^24 (FLOAT) or 2^53 (DOUBLE)"," \tconst double exact_limit = col_type.id() == LogicalTypeId::FLOAT ? 16777216.0 : 9007199254740992.0;","@@ -264,7 +253,7 @@ unique_ptr<Expression> MonotonePreimageRule::Apply(LogicalOperator &op, vector<r"," "," \tint64_t dom_lo = 0, dom_hi = 0;"," \tbool has_infinity = false;","-\tFloatRounding rounding = FloatRounding::FLOOR;","+\tIntegerRounding rounding = IntegerRounding::FLOOR;"," \tconst bool is_float_rounding = GetFloatRounding(func, col_type, rounding);"," \tif (!is_float_rounding && !GetFiniteDomain(col_type, dom_lo, dom_hi, has_infinity)) {"," \t\treturn nullptr;"],"additions":9,"deletions":20,"truncated":false},{"path":"test/api/CMakeLists.txt","lines":["@@ -17,6 +17,7 @@ set(TEST_API_OBJECTS","     test_task_error_out_of_memory.cpp","     test_bind_statement.cpp","     test_function_binding.cpp","+    test_monotone_preimage.cpp","     test_singleton_group_statistics.cpp","     test_runtime_filter_input.cpp","     test_function_signature_variadic.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"test/api/test_monotone_preimage.cpp","lines":["@@ -0,0 +1,66 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+#include \"duckdb/catalog/catalog.hpp\"","+#include \"duckdb/function/scalar_function.hpp\"","+#include \"duckdb/main/client_context.hpp\"","+#include \"duckdb/parser/parsed_data/create_scalar_function_info.hpp\"","+","+using namespace duckdb;","+","+static void MonotoneIdentity(DataChunk &args, ExpressionState &, Vector &result) {","+\tresult.Reference(args.data[0]);","+}","+","+TEST_CASE(\"Rounding preimages do not apply to same-named user functions\", \"[api][monotone_preimage]\") {","+\tfor (const auto &type : vector<LogicalType> {LogicalType::FLOAT, LogicalType::DOUBLE}) {","+\t\tCAPTURE(type.ToString());","+\t\tDuckDB db(nullptr);","+\t\tConnection con(db);","+\t\tcon.BeginTransaction();","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE SCHEMA custom\"));","+\t\tfor (const auto &name : {\"floor\", \"ceil\", \"ceiling\", \"trunc\"}) {","+\t\t\tScalarFunction function(name, {type}, type, MonotoneIdentity);","+\t\t\tfunction.SetUnaryArgProperties(ArgProperties().StrictlyIncreasing());","+\t\t\tCreateScalarFunctionInfo info(function);","+\t\t\tinfo.internal = false;","+\t\t\tinfo.SetSchema(\"custom\");","+\t\t\tcon.context->RunFunctionInTransaction(","+\t\t\t    [&] { Catalog::GetCatalog(*con.context, \"memory\").CreateFunction(*con.context, info); });","+\t\t}","+\t\tcon.Commit();","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE t(d \" + type.ToString() + \")\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"INSERT INTO t VALUES (1.5), (2), (NULL)\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"SET search_path='custom,main'\"));","+\t\tfor (const auto &name : {\"floor\", \"ceil\", \"ceiling\", \"trunc\"}) {","+\t\t\tCAPTURE(name);","+\t\t\tfor (const auto &prefix : {\"custom.\", \"\"}) {","+\t\t\t\tCAPTURE(prefix);","+\t\t\t\tauto result = con.Query(\"SELECT d FROM t WHERE \" + string(prefix) + name + \"(d) = 1.5\");","+\t\t\t\tREQUIRE_NO_FAIL(*result);","+\t\t\t\tREQUIRE(result->RowCount() == 1);","+\t\t\t\tREQUIRE(result->Collection().GetValue(0, 0).GetValue<double>() == 1.5);","+","+\t\t\t\tresult = con.Query(\"SELECT d FROM t WHERE \" + string(prefix) + name + \"(d) >= 2\");","+\t\t\t\tREQUIRE_NO_FAIL(*result);","+\t\t\t\tREQUIRE(result->RowCount() == 1);","+\t\t\t\tREQUIRE(result->Collection().GetValue(0, 0).GetValue<double>() == 2);","+\t\t\t}","+\t\t\tauto result = con.Query(\"SELECT d FROM t WHERE system.main.\" + string(name) + \"(d) = 1.5\");","+\t\t\tREQUIRE_NO_FAIL(*result);","+\t\t\tREQUIRE(result->RowCount() == 0);","+\t\t}","+\t\tfor (const auto &name : {\"floor\", \"ceil\", \"ceiling\", \"trunc\"}) {","+\t\t\tCAPTURE(name);","+\t\t\tScalarFunction function(name, {type}, type, MonotoneIdentity);","+\t\t\tfunction.SetUnaryArgProperties(ArgProperties().StrictlyIncreasing());","+\t\t\tCreateScalarFunctionInfo info(function);","+\t\t\tinfo.on_conflict = OnCreateConflict::ALTER_ON_CONFLICT;","+\t\t\tcon.context->RunFunctionInTransaction(","+\t\t\t    [&] { Catalog::GetSystemCatalog(*con.context).CreateFunction(*con.context, info); });","+\t\t\tauto result = con.Query(\"SELECT d FROM t WHERE system.main.\" + string(name) + \"(d) = 1.5\");","+\t\t\tREQUIRE_NO_FAIL(*result);","+\t\t\tREQUIRE(result->RowCount() == 1);","+\t\t\tREQUIRE(result->Collection().GetValue(0, 0).GetValue<double>() == 1.5);","+\t\t}","+\t}","+}",""],"additions":66,"deletions":0,"truncated":false}],"additions":117,"deletions":23,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-26T18:56:52.290086+00:00"}