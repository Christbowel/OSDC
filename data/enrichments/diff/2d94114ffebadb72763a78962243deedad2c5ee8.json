h stores should observe both alice and bob without losing either edit","+    assert!(","+        store2","+            .password_hash(\"bob\")","+            .await","+            .unwrap()","+            .is_some(),","+    );","+    assert!(","+        store1","+            .password_hash(\"alice\")","+            .await","+            .unwrap()","+            .is_some(),","+    );","+}","+","+#[tokio::test]","+async fn holds_fails_closed_on_corrupt_htpasswd_and_reflects_deletion() {","+    let dir = tempfile::tempdir().unwrap();","+    let htpasswd_path = dir.path().join(\"htpasswd\");","+    let store = UserStore::open(htpasswd_path.clone(), MaxUsers::Unlimited).unwrap();","+","+    assert!(store.create_user(\"alice\", \"pass1\").await.unwrap());","+    assert!(store.holds(\"alice\").unwrap());","+    assert!(!store.holds(\"bob\").unwrap());","+","+    // Corrupt the htpasswd file","+    std::fs::write(&htpasswd_path, b\"invalid htpasswd line without colon\\n\").unwrap();","+    assert!(store.holds(\"alice\").is_err(), \"must fail closed on corrupt htpasswd\");","+","+    // Delete the htpasswd file: accounts are cleared","+    std::fs::remove_file(&htpasswd_path).unwrap();","+    assert!(!store.holds(\"alice\").unwrap(), \"deleted file must reflect as empty store\");","+}","+","+#[tokio::test]","+async fn concurrent_lookups_during_removal_and_replacement_do_not_deadlock() {","+    let dir = tempfile::tempdir().unwrap();","+    let htpasswd_path = dir.path().join(\"htpasswd\");","+    let store =","+        std::sync::Arc::new(UserStore::open(htpasswd_path.clone(), MaxUsers::Unlimited).unwrap());","+","+    assert!(store.create_user(\"alice\", \"pass1\").await.unwrap());","+","+    let mut handles = Vec::new();","+    for index in 0..10 {","+        let store = std::sync::Arc::clone(&store);","+        handles.push(tokio::spawn(async move {","+            for _ in 0..20 {","+                let _ = store.holds(\"alice\");","+                let _ = store.password_hash(\"alice\").await;","+                let _ = store.list_users().await;","+                tokio::time::sleep(std::time::Duration::from_millis((index % 3) + 1)).await;","+            }","+        }));","+    }","+","+    let replacer = tokio::spawn(async move {","+        for round in 0..10 {","+            let _ = std::fs::remove_file(&htpasswd_path);","+            tokio::time::sleep(std::time::Duration::from_millis(2)).await;","+            let hash = bcrypt::hash(format!(\"pass{round}\"), TEST_COST).unwrap();","+            std::fs::write(&htpasswd_path, format!(\"alice:{hash}\\n\")).unwrap();","+            tokio::time::sleep(std::time::Duration::from_millis(2)).await;","+        }","+    });","+","+    for handle in handles {","+        handle.await.unwrap();","+    }","+    replacer.await.unwrap();","+","+    assert!(store.holds(\"alice\").unwrap());","+    assert!(","+        store","+            .password_hash(\"alice\")","+            .await","+            .unwrap()","+            .is_some(),","+    );","+    assert_eq!(store.list_users().await.unwrap(), vec![\"alice\".to_string()]);","+}","+","+#[tokio::test]","+async fn same_size_replacement_reloads_users_even_if_timestamp_preserved() {","+    let dir = tempfile::tempdir().unwrap();","+    let htpasswd_path = dir.path().join(\"htpasswd\");","+    let store = UserStore::open(htpasswd_path.clone(), MaxUsers::Unlimited).unwrap();","+","+    let hash_alice = bcrypt::hash(\"pass_alice\", TEST_COST).unwrap();","+    let initial_content = format!(\"alice:{hash_alice}\\n\");","+    std::fs::write(&htpasswd_path, &initial_content).unwrap();","+","+    assert!(store.holds(\"alice\").unwrap());","+","+    let orig_mtime = std::fs::metadata(&htpasswd_path)","+        .unwrap()","+        .modified()","+        .unwrap();","+","+    let hash_bob = bcrypt::hash(\"pass_bob00\", TEST_COST).unwrap();","+    let replacement = format!(\"bob00:{hash_bob}\\n\");","+    assert_eq!(initial_content.len(), replacement.len());","+","+    let tmp_path = dir.path().join(\"htpasswd.tmp\");","+    std::fs::write(&tmp_path, &replacement).unwrap();","+    let tmp_file = std::fs::File::options()","+        .write(true)","+        .open(&tmp_path)","+        .unwrap();","+    tmp_file.set_modified(orig_mtime).unwrap();","+    drop(tmp_file);","+    std::fs::rename(&tmp_path, &htpasswd_path).unwrap();","+","+    assert!(store.holds(\"bob00\").unwrap());","+    assert!(!store.holds(\"alice\").unwrap());","+}"],"additions":144,"deletions":9,"truncated":false},{"path":"pnpr/crates/auth/src/user_store.rs","lines":["@@ -16,10 +16,21 @@ use std::{"," /// cost (`$2y$10$...`) so we never need to remember per-record metadata."," type Users = HashMap<String, String>;"," ","+mod file_stamp;","+","+use file_stamp::FileStamp;","+","+#[derive(Debug, Default)]","+struct UserStoreState {","+    users: Users,","+    last_synced: Option<FileStamp>,","+    synced_at: Option<std::time::SystemTime>,","+}","+"," /// File-backed (or in-memory) htpasswd store."," #[derive(Debug)]"," pub struct UserStore {","-    pub(crate) users: Arc<Mutex<Users>>,","+    state: Arc<Mutex<UserStoreState>>,","     path: Option<PathBuf>,","     max_users: MaxUsers,","     bcrypt_cost: u32,","@@ -67,16 +78,29 @@ impl UserStore {","     /// Like [`Self::open`] but with a configurable bcrypt cost — used","     /// by tests that want sub-100ms hashing.","     pub fn open_with_cost(path: PathBuf, max_users: MaxUsers, bcrypt_cost: u32) -> Result<Self> {","-        let users = match std::fs::read_to_string(&path) {","-            Ok(raw) => parse_htpasswd(&raw)","-                .map_err(|reason| RegistryError::InvalidHtpasswdFile {","-                    path: path.display().to_string(),","-                    reason,","-                })?,","-            Err(err) if err.kind() == std::io::ErrorKind::NotFound => HashMap::new(),","+        let now = std::time::SystemTime::now();","+        let stamp =","+            std::fs::metadata(&path).