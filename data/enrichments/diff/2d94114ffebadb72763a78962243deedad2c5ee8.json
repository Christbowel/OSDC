se(PoisonError::into_inner)","     }"," ","     /// Reject registration before spending time hashing a new password.","@@ -108,7 +190,7 @@ impl UserStore {","         match self.max_users {","             MaxUsers::Disabled => return Err(RegistryError::RegistrationDisabled),","             MaxUsers::Limited(max) => {","-                if self.snapshot().len() as u64 >= max {","+                if self.snapshot().users.len() as u64 >= max {","                     return Err(RegistryError::TooManyUsers { max });","                 }","             }","@@ -117,7 +199,56 @@ impl UserStore {","         Ok(())","     }"," ","-    /// Apply `edit` to a copy of the users. When it reports a write, save","+    fn load_users_for_update(","+        path: Option<&std::path::Path>,","+        state: &Arc<Mutex<UserStoreState>>,","+    ) -> Result<Users> {","+        let Some(path) = path else {","+            return Ok(state","+                .lock()","+                .unwrap_or_else(PoisonError::into_inner)","+                .users","+                .clone());","+        };","+        match std::fs::read_to_string(path) {","+            Ok(raw) => parse_htpasswd(&raw)","+                .map_err(|reason| RegistryError::InvalidHtpasswdFile {","+                    path: path.display().to_string(),","+                    reason,","+                }),","+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(HashMap::new()),","+            Err(err) => Err(err.into()),","+        }","+    }","+}","+","+fn lock_htpasswd(path: Option<&std::path::Path>) -> Result<Option<std::fs::File>> {","+    let Some(path) = path else {","+        return Ok(None);","+    };","+    let lock_file = std::fs::OpenOptions::new()","+        .read(true)","+        .write(true)","+        .create(true)","+        .truncate(false)","+        .open(path.with_extension(\"htpasswd.lock\"))?;","+    lock_file.lock()?;","+    Ok(Some(lock_file))","+}","+","+fn persist_users_to_disk(","+   