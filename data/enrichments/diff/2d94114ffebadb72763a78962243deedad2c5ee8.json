{"id":"2d94114ffebadb72763a78962243deedad2c5ee8","axis":"silent","repo":"pnpm/pnpm","sha":"2d94114ffebadb72763a78962243deedad2c5ee8","parsed":{"files":[{"path":".changeset/pnpr-package-ownership.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Record package maintainers on publish, support the `$owners` access token in package access rules, and handle `npm owner` maintainer mutations. Record unpublished packages and versions in tombstones to protect against package squatting and republishing of removed versions [pnpm/tasks#131](https://github.com/pnpm/tasks/issues/131)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/owned_tokens.rs","lines":["@@ -42,13 +42,17 @@ impl TokenBackend for OwnedTokens {","     }"," ","     async fn lookup(&self, raw: &str) -> Result<Option<String>> {","-        let owner = self.tokens.lookup(raw).await?;","-        Ok(owner.filter(|owner| self.users.holds(owner)))","+        let Some(owner) = self.tokens.lookup(raw).await? else {","+            return Ok(None);","+        };","+        if self.users.holds(&owner)? { Ok(Some(owner)) } else { Ok(None) }","     }"," ","     async fn lookup_record(&self, raw: &str) -> Result<Option<TokenRecord>> {","-        let record = self.tokens.lookup_record(raw).await?;","-        Ok(record.filter(|record| self.users.holds(&record.username)))","+        let Some(record) = self.tokens.lookup_record(raw).await? else {","+            return Ok(None);","+        };","+        if self.users.holds(&record.username)? { Ok(Some(record)) } else { Ok(None) }","     }"," ","     async fn find_by_key(&self, key: &str) -> Result<Option<TokenRecord>> {"],"additions":8,"deletions":4,"truncated":false},{"path":"pnpr/crates/auth/src/tests.rs","lines":["@@ -88,10 +88,7 @@ async fn user_store_rejects_invalid_username_before_persisting() {","         );","     }","     assert!(","-        store.users","-            .lock()","-            .expect(\"UserStore mutex p