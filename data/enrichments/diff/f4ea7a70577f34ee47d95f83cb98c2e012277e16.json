 &[100] } else { &[100, 2_500] }","+}","+","+/// Keys spread over the key space, with misses (keys >= `CALLBACK_TEST_KEYS`) and duplicates.","+fn callback_test_keys(batch_size: u32) -> Vec<[u8; 4]> {","+    (0..batch_size)","+        .map(|i| {","+            (i.wrapping_mul(7919) % (CALLBACK_TEST_KEYS + CALLBACK_TEST_KEYS / 10)).to_be_bytes()","+        })","+        .chain([0u32, 0, 7, 7, CALLBACK_TEST_KEYS].map(u32::to_be_bytes))","+        .collect()","+}","+","+#[rstest]","+#[case::mmap(true)]","+#[case::file(false)]","+fn batch_get_callback_once_per_index(#[case] mmap: bool) -> Result<()> {","+    use std::sync::atomic::{AtomicU32, Ordering};","+","+    let tempdir = tempfile::tempdir()?;","+    let db = open_callback_test_db(tempdir.path(), mmap)?;","+    for &batch_size in callback_test_batch_sizes() {","+        let keys = callback_test_keys(batch_size);","+        let calls: Vec<AtomicU32> = keys.iter().map(|_| AtomicU32::new(0)).collect();","+        let values: Vec<OnceLock<Option<ArcBytes>>> =","+            keys.iter().map(|_| OnceLock::new()).collect();","+        db.batch_get(0, &keys, |index, value| {","+            calls[index].fetch_add(1, Ordering::Relaxed);","+            let _ = values[index].set(value);","+            Ok(())","+        })?;","+        for (index, key) in keys.iter().enumerate() {","+            assert_eq!(","+                calls[index].load(Ordering::Relaxed),","+                1,","+                \"index {index} of a batch of {} keys\",","+                keys.len()","+            );","+            assert_eq!(","+                values[index].get().unwrap().as_deref(),","+                db.get(0, key)?.as_deref(),","+                \"index {index} of a batch of {} keys\",","+                keys.len()","+            );","+        }","+    }","+    db.shutdown();","+    Ok(())","+}","+","+#[rstest]","+#[case::mmap(true)]","+#[case::file(false)]","+fn batch_get_callback_error_propagates(#[case] mmap: bool) -> Result<()> {","+    let tempdir = tempfile::tempdir()?;","+    let db = open_callback_test_db(tempdir.path(), mmap)?;","+    for &batch_size in callback_test_batch_sizes() {","+        let keys = callback_test_keys(batch_size);","+        // Fail on a found key and, separately, on a missing key (the last key is out of range).","+        let found = keys","+            .iter()","+            .position(|key| db.get(0, key).unwrap().is_some())","+            .unwrap();","+        let missing = keys.len() - 1;","+        for failing in [found, missing] {","+            let result = db.batch_get(0, &keys, |index, _| {","+                if index == failing {","+                    anyhow::bail!(\"injected failure at index {index}\");","+                }","+                Ok(())","+            });","+            let error = result.expect_err(\"the callback error must be returned\");","+            assert!(","+                format!(\"{error:#}\").contains(&format!(\"injected failure at index {failing}\")),","+                \"unexpected error: {error:#}\"","+            );","+        }","+    }","+    db.shutdown();","+    Ok(())","+}"],"additions":170,"deletions":19,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/benches/batch_lookup.rs","lines":["@@ -1,205 +0,0 @@","-//! Benchmarks sequential vs parallel decoding of a `batch_lookup_data` batch, used to pick","-//! `PARALLEL_DECODE_THRESHOLD`.","-//!","-//! Only decoding is timed: the raw bytes are read from a real persisted database once during setup,","-//! so disk I/O does not hide the scheduling overhead of the parallel path.","-//!","-//! Gated behind `TURBOPACK_BENCH_BATCH_LOOKUP` because the setup builds and persists a task graph.","-//! Run with:","-//!","-//! ```bash","-//! TURBOPACK_BENCH_BATCH_LOOKUP=1 cargo bench -p turbo-tasks-backend --bench mod -- batch_lookup","-//! ```","-","-use std::{","-    hint::black_box,","-    time::{Duration, Instant},","-};","-","-use anyhow::Result;","-use criterion::