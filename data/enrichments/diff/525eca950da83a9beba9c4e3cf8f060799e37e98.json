"," ","+TEST_F(IngressSpanTest, RemoteUnsampledParentDoesNotBypassSampling) {","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return false; },","+                                           [] { return true; });","+    BSONObj traceCtxBson =","+        BSON(\"traceparent\" << \"00-11111111111111111111111111111111-2222222222222222-00\");","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(traceCtxBson);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    EXPECT_TRUE(isEmpty());","+}","+","+TEST_F(IngressSpanTest, RemoteUnsampledParentDoesNotConsumeExternalToken) {","+    int acceptCalls = 0;","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return false; },","+                                           [&] {","+                                               ++acceptCalls;","+                                               return true;","+                                           });","+    BSONObj traceCtxBson =","+        BSON(\"traceparent\" << \"00-11111111111111111111111111111111-2222222222222222-00\");","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(traceCtxBson);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    EXPECT_EQ(acceptCalls, 0);","+}","+","+TEST_F(IngressSpanTest, RemoteUnsampledParentInternallySampledContinuesTrace) {","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return true; },","+                                           [] { return false; });","+    BSONObj traceCtxBson =","+        BSON(\"traceparent\" << \"00-11111111111111111111111111111111-2222222222222222-00\");","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(traceCtxBson);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    ASSERT_FALSE(isEmpty());","+    auto record = getSpan(0, span_names::kTest1);","+    EXPECT_NE(record->parentId, opentelemetry::trace::SpanId());","+}","+","+const BSONObj kSampledTraceCtx =","+    BSON(\"traceparent\" << \"00-11111111111111111111111111111111-2222222222222222-01\");","+","+TEST_F(IngressSpanTest, SampledExternalTraceIsNotTracedWithSamplingFlagDisabled) {","+    unittest::ServerParameterGuard samplingOff{\"featureFlagOtelTraceSampling\", false};","+    int acceptCalls = 0;","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return true; },","+                                           [&] {","+                                               ++acceptCalls;","+                                               return true;","+                                           });","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(kSampledTraceCtx);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    EXPECT_TRUE(isEmpty());","+    EXPECT_EQ(acceptCalls, 0);","+}","+","+TEST_F(IngressSpanTest, SampledExternalTraceIsNotTracedWithTracingFlagDisabled) {","+    unittest::ServerParameterGuard tracingOff{\"featureFlagTracing\", false};","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return true; },","+                                           [] { return true; });","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(kSampledTraceCtx);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    EXPECT_TRUE(isEmpty());","+}","+","+TEST_F(IngressSpanTest, AcceptedExternalTraceDoesNotUseInternalToken) {","+    int shouldSampleCalls = 0;","+    int acceptCalls = 0;","+    auto guard = setTraceSamplingFnForTest(","+        [&](std::string_view, double) {","+            ++shouldSampleCalls;","+            return true;","+        },","+        [&] {","+            ++acceptCalls;","+            return true;","+        });","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(kSampledTraceCtx);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    ASSERT_FALSE(isEmpty());","+    EXPECT_EQ(acceptCalls, 1);","+    EXPECT_EQ(shouldSampleCalls, 0);","+}","+","+TEST_F(IngressSpanTest, RateLimitedExternalTraceFallsBackToInternalSampling) {","+    int shouldSampleCalls = 0;","+    auto guard = setTraceSamplingFnForTest(","+        [&](std::string_view, double) {","+            ++shouldSampleCalls;","+            return true;","+        },","+        [] { return false; });","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(kSampledTraceCtx);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    ASSERT_FALSE(isEmpty());","+    EXPECT_EQ(shouldSampleCalls, 1);","+    EXPECT_NE(getSpan(0, span_names::kTest1)->parentId, opentelemetry::trace::SpanId());","+}","+","+/** Sets openTelemetryExternalTracing.enabled for the lifetime of the object. */","+class ScopedExternalTracingEnabled {","+public:","+    explicit ScopedExternalTracingEnabled(bool enabled) {","+        _set(enabled);","+    }","+    ~ScopedExternalTracingEnabled() {","+        _set(true);","+    }","+","+private:","+    static void _set(bool enabled) {","+        OpenTelemetryExternalTracingServerParameter param{\"openTelemetryExternalTracing\",","+                                                          ServerParameterType::kRuntimeOnly};","+        auto storage = BSON(\"v\" << BSON(\"enabled\" << enabled));","+        ASSERT_OK(param.set(storage.firstElement(), boost::none));","+    }","+};","+","+TEST_F(IngressSpanTest, DisabledExternalTracingDoesNotSpendExternalToken) {","+    ScopedExternalTracingEnabled disabled{false};","+    int acceptCalls = 0;","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return false; },","+                                           [&] {","+                                               ++acceptCalls;","+                                               return true;","+                                           });","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(kSampledTraceCtx);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    EXPECT_TRUE(isEmpty());","+    EXPECT_EQ(acceptCalls, 0);","+}","+","+TEST_F(IngressSpanTest, DisabledExternalTracingFallsBackToInternalSampling) {","+    ScopedExternalTracingEnabled disabled{false};","+    auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return true; },","+                                           [] { return true; });","+    auto telemetryCtx = TelemetryContextSerializer::fromBSON(kSampledTraceCtx);","+    {","+        auto _ = Span::startIngressSpan(telemetryCtx, span_names::kTest1);","+    }","+    ASSERT_FALSE(isEmpty());","+    EXPECT_NE(getSpan(0, span_names::kTest1)->parentId, opentelemetry::trace::SpanId());","+}","+"," TEST_F(IngressSpanTest, RemoteParentGrandchildrenInheritHeadDecision) {","     auto guard = setTraceSamplingFnForTest([](std::string_view, double) { return false; },","                                            [] { return true; });"],"additions":171,"deletions":1,"truncated":false},{"path":"src/mongo/otel/traces/trace_sampling_parameters.cpp","lines":["@@ -1,6 +1,8 @@"," // Copyright (c) MongoDB, Inc."," // SPDX-License-Identifier: SSPL-1.0"," ","+#include \"mongo/otel/traces/trace_sampling_parameters.h\"","+"," #include \"mongo/bson/bsonelement.h\""," #include \"mongo/bson/bsonobjbuilder.h\""," #include \"mongo/bson/bsontypes.h\"","@@ -9,17 +11,35 @@"," #include \"mongo/otel/traces/sampler/sampler.h\""," #include \"mongo/otel/traces/sampler/sampling_config.h\""," #include \"mongo/otel/traces/trace_sampling_parameters_gen.h\"","+#include \"mongo/platform/atomic.h\"","+","+#include <mutex>"," "," namespace mongo::otel::traces {"," namespace {"," ","+// Whether externally-initiated traces may be continued, per openTelemetryExternalTracing.enabled.","+Atomic<bool> externalTracingEnabled{true};","+","+// Guards the external config so that an update, which may set both fields, is never observed","+// half-applied by a concurrent update or by `append`.","+std::mutex externalConfigMutex;","+"," Status applyExternalConfig(const BSONObj& obj) {","     try {","         IDLParserContext ctx(\"openTelemetryExternalTracing\");","         auto config = OpenTelemetryTracingExternalConfig::parse(obj, ctx);","-        const auto& rateLimit = config.getTokenBucketRateLimit();","-        TracingSampler::get().updateExternalConfig(","-            {rateLimit.getRefillRate(), rateLimit.getMaxTokens()});","+","+        std::lock_guard lk(externalConfigMutex);","+        // Fields that are omitted keep their current value, so a partial update such as a rate","+        // limit change does not re-enable tracing that an operator turned off.","+        if (const auto& rateLimit = config.getTokenBucketRateLimit()) {","+            TracingSampler::get().updateExternalConfig(","+                {rateLimit->getRefillRate(), rateLimit->getMaxTokens()});","+        }","+        if (const auto enabled = config.getEnabled()) {","+            externalTracingEnabled.store(*enabled);","+        }","         return Status::OK();","     } catch (const DBException& ex) {","         return ex.toStatus();","@@ -138,14 +158,20 @@ void OpenTelemetryExternalTracingServerParameter::append(OperationContext*,","                                                          BSONObjBuilder* bob,","                                                          std::string_view name,","                                                          const boost::optional<TenantId>&) {","+    std::lock_guard lk(externalConfigMutex);","     auto rateLimits = TracingSampler::get().getConfig().externalRateLimits;","     OpenTelemetryTracingTokenBucketRateLimit rateLimit;","     rateLimit.setRefillRate(rateLimits.refillRate);","     rateLimit.setMaxTokens(rateLimits.maxTokens);","     OpenTelemetryTracingExternalConfig config;","+    config.setEnabled(externalTracingEnabled.load());","     config.setTokenBucketRateLimit(std::move(rateLimit));","     BSONObjBuilder sub(bob->subobjStart(name));","     config.serialize(&sub);"," }"," ","+bool isExternalTracingEnabled() {","+    return externalTracingEnabled.loadRelaxed();","+}","+"," }  // namespace mongo::otel::traces"],"additions":29,"deletions":3,"truncated":false},{"path":"src/mongo/otel/traces/trace_sampling_parameters.h","lines":["@@ -0,0 +1,16 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/util/modules.h\"","+","+namespace mongo::otel::traces {","+","+/**","+ * Returns whether externally-initiated traces may be continued, i.e. the emergency off switch","+ * `openTelemetryExternalTracing.enabled` has not been set to false.","+ */","+[[MONGO_MOD_PUBLIC]] bool isExternalTracingEnabled();","+","+}  // namespace mongo::otel::traces"],"additions":16,"deletions":0,"truncated":false},{"path":"src/mongo/otel/traces/trace_sampling_parameters.idl","lines":["@@ -29,10 +29,19 @@ structs:","         description: \"Specifies the configuration used for traces that were externally sampled\"","         strict: false","         fields:","+            enabled:","+                description: >-","+                    Whether to continue traces whose sampled parent was started on a separate","+                    node, e.g. by a client. When false, such operations are sampled internally","+                    like any other. If omitted, the current value is kept.","+                type: bool","+                optional: true","             tokenBucketRateLimit:","-                description: The rate limit to apply to accepting an external trace.","+                description: >-","+                    The rate limit to apply to accepting an external trace. If omitted, the","+                    current rate limit is kept.","                 type: OpenTelemetryTracingTokenBucketRateLimit","-                default: true","+                optional: true"," ","     OpenTelemetryTracingSamplingStrategy:","         description: \"Describes how a set of spans should be sampled, e.g., the sampling rate.\""],"additions":11,"deletions":2,"truncated":false},{"path":"src/mongo/otel/traces/trace_sampling_parameters_test.cpp","lines":["@@ -1,6 +1,8 @@"," // Copyright (c) MongoDB, Inc."," // SPDX-License-Identifier: SSPL-1.0"," ","+#include \"mongo/otel/traces/trace_sampling_parameters.h\"","+"," #include \"mongo/bson/bsonobj.h\""," #include \"mongo/bson/bsonobjbuilder.h\""," #include \"mongo/otel/traces/sampler/sampler.h\"","@@ -327,6 +329,7 @@ class TraceExternalTracingParametersTest : public unittest::Test {","                                                       ServerParameterType::kRuntimeOnly};"," ","     void setUp() override {","+        ASSERT_OK(param.setFromString(R\"({\"enabled\": true})\", /*tenantId=*/boost::none));","         TracingSampler::get().updateExternalConfig({kDefaultRefillRate, kDefaultMaxTokens});","     }"," ","@@ -367,6 +370,37 @@ TEST_F(TraceExternalTracingParametersTest, AppendAfterMultipleSetsReflectsLastVa","     EXPECT_THAT(readExternalRateLimit(bob.obj()), FieldsAre(4.0, 15));"," }"," ","+TEST_F(TraceExternalTracingParametersTest, SetEnabledFalseDisablesExternalTraces) {","+    auto storage = BSON(\"v\" << BSON(\"enabled\" << false));","+    ASSERT_OK(param.set(storage.firstElement(), /*tenantId=*/boost::none));","+    EXPECT_FALSE(isExternalTracingEnabled());","+}","+","+TEST_F(TraceExternalTracingParametersTest, RateLimitOnlySetKeepsExternalTracingDisabled) {","+    ASSERT_OK(param.setFromString(R\"({\"enabled\": false})\", /*tenantId=*/boost::none));","+    ASSERT_OK(setRateLimit(2.0, 5));","+    EXPECT_FALSE(isExternalTracingEnabled());","+}","+","+TEST_F(TraceExternalTracingParametersTest, EnabledOnlySetKeepsRateLimit) {","+    ASSERT_OK(setRateLimit(3.0, 7));","+    ASSERT_OK(param.setFromString(R\"({\"enabled\": false})\", /*tenantId=*/boost::none));","+","+    BSONObjBuilder bob;","+    param.append(nullptr, &bob, \"openTelemetryExternalTracing\"sv, /*tenantId=*/boost::none);","+","+    EXPECT_THAT(readExternalRateLimit(bob.obj()), FieldsAre(3.0, 7));","+}","+","+TEST_F(TraceExternalTracingParametersTest, AppendReflectsEnabled) {","+    ASSERT_OK(param.setFromString(R\"({\"enabled\": false})\", /*tenantId=*/boost::none));","+","+    BSONObjBuilder bob;","+    param.append(nullptr, &bob, \"openTelemetryExternalTracing\"sv, /*tenantId=*/boost::none);","+","+    EXPECT_FALSE(bob.obj()[\"openTelemetryExternalTracing\"][\"enabled\"].Bool());","+}","+"," TEST_F(TraceExternalTracingParametersTest, NonObjectElementFails) {","     auto storage = BSON(\"v\" << 42);","     EXPECT_THAT(param.set(storage.firstElement(), /*tenantId=*/boost::none), Not(StatusIsOK()));",""],"additions":34,"deletions":0,"truncated":false}],"additions":312,"deletions":34,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-14T15:14:33.830991+00:00"}