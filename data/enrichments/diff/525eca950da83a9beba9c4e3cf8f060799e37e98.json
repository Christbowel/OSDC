{"id":"525eca950da83a9beba9c4e3cf8f060799e37e98","axis":"silent","repo":"mongodb/mongo","sha":"525eca950da83a9beba9c4e3cf8f060799e37e98","parsed":{"files":[{"path":"src/mongo/otel/traces/README.md","lines":["@@ -112,10 +112,15 @@ default)."," "," ### Externally-initiated Traces (Ingress Spans)"," ","-When an incoming command contains a trace context, the server will continue the trace, subject to a","-configurable rate limit. When the incoming command does not contain a trace context or the","-externally-initiated trace is rate limited, internal sampling may still choose to start or continue","-the trace.","+When an incoming command contains a trace context whose `traceparent` has the sampled flag set","+(trace-flags `01`), the server will continue the trace, subject to a configurable rate limit","+(`openTelemetryExternalTracing`). This lets a client request a trace for a specific command, even","+when internal sampling is disabled. Setting `enabled: false` in `openTelemetryExternalTracing` stops","+the server from continuing externally-initiated traces.","+","+When the incoming command does not contain a sampled trace context, external tracing is disabled, or","+the externally-initiated trace is rate limited, internal sampling may still choose to start or","+continue the trace."," "," ### Egress Spans"," "],"additions":9,"deletions":4,"truncated":false},{"path":"src/mongo/otel/traces/span/BUILD.bazel","lines":["@@ -48,6 +48,7 @@ mongo_cc_library(","     ] + select({","         \"@//bazel/config:build_otel_enabled\": [","             \":span_telemetry_context\",","+            \"//src/mongo/otel/traces:trace_sampling_parameters\",","             \"//src/mongo/otel/traces:tracer_provider_service\",","             \"//src/mongo/otel/traces:tracing_feature_flags\",","             \"//src/third_party/opentelemetry-cpp/api\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/otel/traces/span/span.cpp","lines":["@@ -7,6 +7,7 @@"," #include \"mongo/otel/telemetry_context_holder.h\""," #include \"mongo/otel/traces/sampler/sampler.h\""," #include \"mongo/otel/traces/span/span_telemetry_context_impl.h\"","+#include \"mongo/otel/traces/trace_sampling_parameters.h\""," #include \"mongo/otel/traces/tracer_provider_service.h\""," #include \"mongo/otel/traces/tracing_feature_flags_gen.h\""," #include \"mongo/otel/traces/tracing_utils.h\"","@@ -124,11 +125,6 @@ Span Span::_start(std::shared_ptr<TelemetryContext>& telemetryCtx,","         return Span{};","     }"," ","-    auto tracer = provider->GetTracer(\"mongodb\");","-    if (!tracer) {","-        return Span{};","-    }","-","     ScopedSpan parentSpan = nullptr;","     bool hasParent = false;","     std::shared_ptr<SpanTelemetryContextImpl> spanCtx = nullptr;","@@ -146,8 +142,9 @@ Span Span::_start(std::shared_ptr<TelemetryContext>& telemetryCtx,"," ","     const auto hasRemoteParent = hasParent && parentSpan->GetContext().IsRemote();"," ","-    // If the parent span is remote, we generally want to bypass the internal sampling mechanism","-    // to respect the sampling decision made by the remote system.","+    // A remote parent that was sampled upstream bypasses internal sampling to respect that decision","+    // (subject to the external rate limit). A remote parent that was not sampled upstream still","+    // goes through internal sampling like a root span.","     if (!hasParent || hasRemoteParent) {","         // Drop if either feature flag is disabled or the sampler rejects it.","         // (Ignore FCV check) — no VersionContext is available in this path.","@@ -160,18 +157,38 @@ Span Span::_start(std::shared_ptr<TelemetryContext>& telemetryCtx,","             return Span{};","         }"," ","-        // We need a telemetryCtx for sampling, but it is slightly expensive to create, so do so","-        // only if needed.","-        if (!telemetryCtx) {","-            spanCtx = std::make_shared<SpanTelemetryContextImpl>();","-            telemetryCtx = spanCtx;","-            parentSpan = spanCtx->getSpan();","+        auto& sampler = TracingSampler::get();","+","+        // Only spend an external token on remote parents that were sampled upstream. If external","+        // tracing is disabled or the external rate limit rejects it, internal sampling may still","+        // choose to trace it.","+        // The external token is consumed last, so that it is only spent when every other condition","+        // for accepting the trace already holds.","+        const auto bypassInternalSampling = config.isIngress && isExternalTracingEnabled() &&","+            hasRemoteParent && parentSpan->GetContext().IsSampled() &&","+            sampler.shouldAcceptExternalTrace();","+","+        if (!bypassInternalSampling) {","+            // We need a telemetryCtx for sampling, but it is slightly expensive to create, so do","+            // so only if needed.","+            if (!telemetryCtx) {","+                spanCtx = std::make_shared<SpanTelemetryContextImpl>();","+                telemetryCtx = spanCtx;","+                parentSpan = spanCtx->getSpan();","+            }","+","+            if (!sampler.shouldSample(name.getName(), spanCtx->getSamplingValue())) {","+                return Span{};","+            }","         }","+    }"," ","-        if (!config.bypassSampling &&","-            !TracingSampler::get().shouldSample(name.getName(), spanCtx->getSamplingValue())) {","-            return Span{};","-        }","+    // GetTracer() takes a process-wide mutex, so it is only called for spans that will be recorded,","+    // after sampling has decided to keep them.","+    // TODO: Cache the tracer alongside the provider to avoid the lookup entirely.","+    auto tracer = provider->GetTracer(\"mongodb\");","+    if (!tracer) {","+        return Span{};","     }"," ","     opentelemetry::trace::StartSpanOptions opts;","@@ -216,9 +233,7 @@ Span Span::start(OperationContext* opCtx, SpanName name, SpanOptions options) {"," Span Span::startIngressSpan(std::shared_ptr<TelemetryContext>& telemetryCtx,","                             SpanName name,","                             SpanOptions options) {","-    auto bypassSampling = telemetryCtx && TracingSampler::get().shouldAcceptExternalTrace();","-    return _start(","-        telemetryCtx, name, {.opts = std::move(options), .bypassSampling = bypassSampling});","+    return _start(telemetryCtx, name, {.opts = std::move(options), .isIngress = true});"," }"," "," Span Span::startEgressSpan(std::shared_ptr<TelemetryContext>& telemetryCtx,"],"additions":35,"deletions":20,"truncated":false},{"path":"src/mongo/otel/traces/span/span.h","lines":["@@ -79,9 +79,10 @@ class Span {"," ","     /**","      * Starts a new Span from an ingress source, which may be sampled differently than an","-     * internally-started span (e.g. a separate rate limit). Uses the presence of `telemetryCtx` to","-     * determine if the ingress span is part of an external trace. Defaults to SERVER span kind. If","-     * a context is created during this, `telemetryCtx` is updated in place.","+     * internally-started span (e.g. a separate rate limit). The ingress span is part of an external","+     * trace only if `telemetryCtx` carries a remote parent whose sampled flag is set; unsampled","+     * remote parents are subject to internal sampling like any other root span. Defaults to SERVER","+     * span kind. If a context is created during this, `telemetryCtx` is updated in place.","      */","     static Span startIngressSpan(std::shared_ptr<TelemetryContext>& telemetryCtx,","                                  SpanName name,","@@ -130,7 +131,8 @@ class Span {"," private:","     struct StartSpanConfig {","         SpanOptions opts;","-        bool bypassSampling = false;","+        // Whether this span is an ingress span, which may continue an external trace.","+        bool isIngress = false;","         bool preventSampling = false;","     };"," "],"additions":6,"deletions":4,"tru