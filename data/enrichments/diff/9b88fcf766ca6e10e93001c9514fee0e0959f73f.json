{"id":"9b88fcf766ca6e10e93001c9514fee0e0959f73f","axis":"silent","repo":"open-telemetry/opentelemetry-collector","sha":"9b88fcf766ca6e10e93001c9514fee0e0959f73f","parsed":{"files":[{"path":".chloggen/11449-sanitize-receiver.yaml","lines":["@@ -0,0 +1,29 @@","+# Use this changelog template to create an entry for release notes.","+","+# One of 'breaking', 'deprecation', 'new_component', 'enhancement', 'bug_fix'","+change_type: enhancement","+","+# The name of the component, or a single word describing the area of concern, (e.g. receiver/otlp)","+component: receiver/otlp","+","+# A brief description of the change.  Surround your text with quotes (\"\") if it needs to start with a backtick (`).","+note: Add `receiver.otlp.sanitizeInvalidUTF8` feature gate to replace invalid UTF-8 in OTLP requests with U+FFFD instead of forwarding invalid data downstream","+","+# One or more tracking issues or pull requests related to the change","+issues: [11449]","+","+# (Optional) One or more lines of additional information to render under the primary note.","+# These lines will be padded with 2 spaces and then inserted directly into the document.","+# Use pipe (|) for multiline entries.","+subtext: |","+  This behavior is behind the `receiver.otlp.sanitizeInvalidUTF8` feature gate.","+  When enabled, the OTLP receiver replaces every run of invalid UTF-8 bytes in the string fields of incoming traces, metrics, logs and profiles with the Unicode replacement character U+FFFD.","+  Sanitized requests are forwarded whole, without partial success counts.","+  If `receiver.otlp.rejectInvalidUTF8` is also enabled, it takes precedence and invalid items are rejected instead.","+","+# Optional: The change log or logs in which this entry should be included.","+# e.g. '[user]' or '[user, api]'","+# Include 'user' if the change is relevant to end users.","+# Include 'api' if there is a change to a library API.","+# Default: '[user]'","+change_logs: [user]"],"additions":29,"deletions":0,"truncated":false},{"path":"receiver/otlpreceiver/documentation.md","lines":["@@ -9,5 +9,6 @@ This component has the following feature gates:"," | Feature Gate | Stage | Description | From Version | To Version | Reference |"," | ------------ | ----- | ----------- | ------------ | ---------- | --------- |"," | `receiver.otlp.rejectInvalidUTF8` | alpha | Controls whether the OTLP receiver rejects telemetry items containing invalid UTF-8 and reports them through OTLP partial success. | v0.166.0 | N/A | [Link](https://github.com/open-telemetry/opentelemetry-collector/issues/11449) |","+| `receiver.otlp.sanitizeInvalidUTF8` | alpha | Controls whether the OTLP receiver replaces invalid UTF-8 in string fields with the Unicode replacement character U+FFFD. | v0.166.0 | N/A | [Link](https://github.com/open-telemetry/opentelemetry-collector/issues/11449) |"," "," For more information about feature gates, see the [Feature Gates](https://github.com/open-telemetry/opentelemetry-collector/blob/main/featuregate/README.md) documentation."],"additions":1,"deletions":0,"truncated":false},{"path":"receiver/otlpreceiver/internal/logs/otlp.go","lines":["@@ -44,6 +44,8 @@ func (r *Receiver) Export(ctx context.Context, req plogotlp.ExportRequest) (plog"," \trejectedLogRecords := 0"," \tif metadata.ReceiverOtlpRejectInvalidUTF8FeatureGate.IsEnabled() {"," \t\trejectedLogRecords = req.RejectInvalidUTF8()","+\t} else if metadata.ReceiverOtlpSanitizeInvalidUTF8FeatureGate.IsEnabled() {","+\t\treq.SanitizeUTF8()"," \t}"," \tresp := plogotlp.NewExportResponse()"," \tif rejectedLogRecords > 0 {"],"additions":2,"deletions":0,"truncated":false},{"path":"receiver/otlpreceiver/internal/logs/otlp_test.go","lines":["@@ -8,6 +8,7 @@ import ("," \t\"errors\""," \t\"net\""," \t\"testing\"","+\t\"unicode/utf8\""," "," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\"","@@ -99,6 +100,56 @@ func TestExport_InvalidUTF8FeatureGateDisabled(t *testing.T) {"," \tassert.Equal(t, 2, lds[0].LogRecordCount())"," }"," ","+func TestExport_SanitizeInvalidUTF8(t *testing.T) {","+\ttestutil.SetFeatureGate(t, metadata.ReceiverOtlpSanitizeInvalidUTF8FeatureGate.ID(), true)","+\ttestutil.SetFeatureGate(t, metadata.ReceiverOtlpRejectInvalidUTF8FeatureGate.ID(), false)","+","+\tld := testdata.GenerateLogs(2)","+\tld.ResourceLogs().At(0).ScopeLogs().At(0).LogRecords().At(0).Attributes().PutStr(\"bad\", \"bad\\xffvalue\")","+\treq := plogotlp.NewExportRequestFromLogs(ld)","+","+\ttt := componenttest.NewTelemetry()","+\tt.Cleanup(func() { require.NoError(t, tt.Shutdown(context.Background())) })","+","+\tlogSink := new(consumertest.LogsSink)","+\tlogClient := makeLogsServiceClientWithTelemetry(t, logSink, tt)","+\tresp, err := logClient.Export(context.Background(), req)","+\trequire.NoError(t, err)","+\tassert.Zero(t, resp.PartialSuccess().RejectedLogRecords())","+\tassert.Empty(t, resp.PartialSuccess().ErrorMessage())","+","+\tlds := logSink.AllLogs()","+\trequire.Len(t, lds, 1)","+\tassert.Equal(t, 2, lds[0].LogRecordCount())","+","+\tgot, ok := lds[0].ResourceLogs().At(0).ScopeLogs().At(0).LogRecords().At(0).Attributes().Get(\"bad\")","+\trequire.True(t, ok)","+\tassert.Equal(t, \"bad\\uFFFDvalue\", got.Str())","+\tassert.True(t, utf8.ValidString(got.Str()))","+","+\tassertReceiverSum(t, tt, \"otelcol_receiver_accepted_log_records\", int64(2))","+}","+","+func TestExport_SanitizeInvalidUTF8RejectTakesPrecedence(t *testing.T) {","+\ttestutil.SetFeatureGate(t, metadata.ReceiverOtlpSanitizeInvalidUTF8FeatureGate.ID(), true)","+\ttestutil.SetFeatureGate(t, metadata.ReceiverOtlpRejectInvalidUTF8FeatureGate.ID(), true)","+","+\tld := testdata.GenerateLogs(2)","+\tld.ResourceLogs().At(0).ScopeLogs().At(0).LogRecords().At(0).Attributes().PutStr(\"bad\", \"bad\\xffvalue\")","+\treq := plogotlp.NewExportRequestFromLogs(ld)","+","+\tlogSink := new(consumertest.LogsSink)","+\tlogClient := makeLogsServiceClient(t, logSink)","+\tresp, err := logClient.Export(context.Background(), req)","+\trequire.NoError(t, err)","+\tassert.Equal(t, int64(1), resp.PartialSuccess().RejectedLogRecords())","+\tassert.Equal(t, invalidUTF8Message, resp.PartialSuccess().ErrorMessage())","+","+\tlds := logSink.AllLogs()","+\trequire.Len(t, lds, 1)","+\tassert.Equal(t, 1, lds[0].LogRecordCount())","+}","+"," func TestExport_NonPermanentErrorConsumer(t *testing.T) {"," \tld := testdata.GenerateLogs(1)"," \treq := plogotlp.NewExportRequestFromLogs(ld)"],"additions":51,"deletions":0,"truncated":false},{"path":"receiver/otlpreceiver/internal/metadata/generated_feature_gates.go","lines":["@@ -13,3 +13,11 @@ var ReceiverOtlpRejectInvalidUTF8FeatureGate = featuregate.GlobalRegistry().Must"," \tfeaturegate.WithRegisterReferenceURL(\"https://github.com/open-telemetry/opentelemetry-collector/issues/11449\"),"," \tfeaturegate.WithRegisterFromVersion(\"v0.166.0\"),"," )","+","+var ReceiverOtlpSanitizeInvalidUTF8FeatureGate = featuregate.GlobalRegistry().MustRegister(","+\t\"receiver.otlp.sanitizeInvalidUTF8\",","+\tfeaturegate.StageAlpha,","+\tfeaturegate.WithRegisterDescription(\"Controls whether the OTLP receiver replaces invalid UTF-8 in string fields with the Unicode replacement character U+FFFD.\"),","+\tfeaturegate.WithRegisterReferenceURL(\"https://github.com/open-telemetry/opentelemetry-collector/issues/11449\"),","+\tfeaturegate.WithRegisterFromVersion(\"v0.166.0\"),","+)"],"additions":8,"deletions":0,"truncated":false},{"path":"receiver/otlpreceiver/internal/metrics/otlp.go","lines":["@@ -44,6 +44,8 @@ func (r *Receiver) Export(ctx context.Context, req pmetricotlp.ExportRequest) (p"," \trejectedDataPoints := 0"," \tif metadata.ReceiverOtlpRejectInvalidUTF8FeatureGate.IsEnabled() {"," \t\trejectedDataPoints = req.RejectInvalidUTF8()","+\t} else if metadata.ReceiverOtlpSanitizeInvalidUTF8FeatureGate.IsEnabled() {","+\t\treq.SanitizeUTF8()"," \t}"," \tresp := pmetricotlp.NewExportResponse()"," \tif rejectedDataPoints > 0 {"],"additions":2,"deletions":0,"truncated":fa