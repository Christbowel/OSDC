inary\")","+load(\"@rules_cc//cc/toolchains:cc_toolchain.bzl\", \"cc_toolchain\")","+load(\":toolchain_provenance.bzl\", \"toolchain_provenance\")","+load(\"//bazel/toolchains/cc:mongo_compiler_flags.bzl\", \"MONGO_GLOBAL_LINKFLAGS\")","+load(\":toolchain_versions_test.bzl\", \"disabled_linker_features_analysis_test\", \"local_cross_link_inputs_analysis_test\", \"macos_cross_compile_flags_analysis_test\", \"macos_cross_local_link_runtime_analysis_test\", \"macos_cross_remote_link_runtime_analysis_test\", \"macos_cross_toolchain_versions_analysis_test\", \"requested_linker_features_analysis_test\", \"toolchain_versions_analysis_test\")"," load(","     \"@bazel_skylib//rules:common_settings.bzl\",","     \"bool_flag\",","@@ -75,6 +79,107 @@ load(\":py_action_env_test.bzl\", \"runtime_pythonpath_test\", \"template_renderer_py"," "," package(default_visibility = [\"//visibility:public\"])"," ","+toolchain_provenance(","+    name = \"toolchain_provenance\",","+    cpp_linkflags = MONGO_GLOBAL_LINKFLAGS,","+    local_cross_link = select({","+        \":local_cross_link_version_probe\": True,","+        \"//conditions:default\": False,","+    }),","+    production_release = select({","+        \":production_release\": True,","+        \"//conditions:default\": False,","+    }),","+)","+","+toolchain_versions_analysis_test(","+    name = \"toolchain_versions_analysis_test\",","+    target_compatible_with = [\"@platforms//os:linux\"],","+    target_under_test = \"//bazel/config:toolchain_provenance\",","+)","+","+macos_cross_toolchain_versions_analysis_test(","+    name = \"macos_cross_toolchain_versions_analysis_test\",","+    tags = [\"manual\"],","+    target_under_test = \"//bazel/config:toolchain_provenance\",","+)","+","+macos_cross_compile_flags_analysis_test(","+    name = \"macos_cross_compile_flags_analysis_test\",","+    tags = [\"manual\"],","+    target_under_test = \"//bazel/toolchains/cc/mongo_linux/testdata/container_boundary:libvoidstar_cc_link_fixture\",","+)","+","+macos_cross_remote_link_runtime_analysis_test(","+    name = \"macos_cross_remote_link_runtime_analysis_test\",","+    tags = [\"manual\"],","+    target_under_test = \"//bazel/config:toolchain_provenance\",","+)","+","+macos_cross_local_link_runtime_analysis_test(","+    name = \"macos_cross_local_link_runtime_analysis_test\",","+    tags = [\"manual\"],","+    target_under_test = \"//bazel/config:toolchain_provenance\",","+)","+","+filegroup(","+    name = \"linker_features_fixture\",","+    testonly = True,","+    srcs = [","+        \"//bazel/config:toolchain_provenance\",","+        \"//bazel/toolchains/cc/mongo_linux/testdata/container_boundary:libvoidstar_cc_link_fixture\",","+    ],","+    tags = [\"manual\"],","+)","+","+requested_linker_features_analysis_test(","+    name = \"requested_linker_features_analysis_test\",","+    target_compatible_with = [\"@platforms//os:linux\"],","+    target_under_test = \":linker_features_fixture\",","+)","+","+disabled_linker_features_analysis_test(","+    name = \"disabled_linker_features_analysis_test\",","+    target_compatible_with = [\"@platforms//os:linux\"],","+    target_under_test = \":linker_features_fixture\",","+)","+","+# A minimal toolchain whose all_files excludes the native host linker archive.","+# Analysis-only tests never execute its tools.","+cc_toolchain(","+    name = \"probe_test_cc_toolchain\",","+    all_files = \":generate_config_header.bzl\",","+    ar_files = \":generate_config_header.bzl\",","+    compiler_files = \":generate_config_header.bzl\",","+    dwp_files = \":generate_config_header.bzl\",","+    linker_files = \"@mongo_toolchain_v5//:linker_files\",","+    objcopy_files = \":generate_config_header.bzl\",","+    strip_files = \":generate_config_header.bzl\",","+    tags = [\"manual\"],","+    toolchain_config = \"@mongo_toolchain_v5//:cc_clang_toolchain_config\",","+)","+","+toolchain(","+    name = \"probe_test_toolchain\",","+    exec_compatible_with = [\"@platforms//os:linux\"],","+    target_compatible_with = [\"@platforms//os:linux\"],","+    toolchain = \":probe_test_cc_toolchain\",","+    toolchain_type = \"@bazel_tools//tools/cpp:toolchain_type\",","+)","+","+toolchain_provenance(","+    name = \"local_cross_link_fixture\",","+    testonly = True,","+    local_cross_link = True,","+    tags = [\"manual\"],","+)","+","+local_cross_link_inputs_analysis_test(","+    name = \"local_cross_link_inputs_analysis_test\",","+    target_compatible_with = [\"@platforms//os:linux\"],","+    target_under_test = \":local_cross_link_fixture\",","+)","+"," runtime_pythonpath_test(name = \"runtime_pythonpath_test\")"," "," template_renderer_python_path_analysis_test(","@@ -161,6 +266,17 @@ config_setting(","     },"," )"," ","+config_setting(","+    name = \"local_cross_link_version_probe\",","+    constraint_values = [\"//bazel/platforms:use_mongo_linux_cross_toolchain\"],","+    flag_values = {\"//bazel/config:remote_link\": \"False\"},","+)","+","+config_setting(","+    name = \"production_release\",","+    define_values = {\"MONGO_PRODUCTION_RELEASE\": \"1\"},","+)","+"," selects.config_setting_group(","     name = \"gcc_or_clang\",","     match_any = ["],"additions":116,"deletions":0,"truncated":false},{"path":"bazel/config/toolchain_provenance.bzl","lines":["@@ -0,0 +1,196 @@","+\"\"\"Capture the configured tools without modifying server binaries.\"\"\"","+","+load(\"@rules_cc//cc:find_cc_toolchain.bzl\", \"find_cc_toolchain\")","+load(\"@rules_cc//cc:action_names.bzl\", \"ACTION_NAMES\")","+load(\"@bazel_skylib//rules:common_settings.bzl\", \"BuildSettingInfo\")","+load(\"//bazel/config:configs.bzl\", \"compiler_type_provider\", \"remote_link_provider\", \"sdkroot_provider\")","+load(\"@rules_cc//cc/common:cc_common.bzl\", \"cc_common\")","+","+def _target_platform_arch(ctx):","+    is_macos = ctx.target_platform_has_constraint(ctx.attr._macos_constraint[platform_common.ConstraintValueInfo])","+    arch_constraints = [","+        (ctx.attr._x86_64_constraint, \"x86_64\"),","+        (ctx.attr._aarch64_constraint, \"arm64\" if is_macos else \"aarch64\"),","+        # platform.machine() reports arm64 on macOS and aarch64 on Linux.","+        # Preserve that platform-specific spelling in build metadata.","+        (ctx.attr._arm64_constraint, \"arm64\" if is_macos else \"aarch64\"),","+        (ctx.attr._ppc64le_constraint, \"ppc64le\"),","+        (ctx.attr._s390x_constraint, \"s390x\"),","+        (ctx.attr._wasm32_constraint, \"wasm32\"),","+    ]","+    for constraint, arch in arch_constraints:","+        if ctx.target_platform_has_constraint(constraint[platform_common.ConstraintValueInfo]):","+            return arch","+    fail(\"Unable to determine target architecture from the target platform\")","+","+def _target_platform_os(ctx):","+    os_constraints = [","+        (ctx.attr._linux_constraint, \"linux\"),","+        (ctx.attr._macos_constraint, \"macOS\"),","+        (ctx.attr._windows_constraint, \"windows\"),","+        (ctx.attr._wasi_constraint, \"wasi\"),","+    ]","+    for constraint, os_name in os_constraints:","+        if ctx.target_platform_has_constraint(constraint[platform_common.ConstraintValueInfo]):","+            return os_name","+    fail(\"Unable to determine target operating system from the target platform\")","+","+def _toolchain_provenance_impl(ctx):","+    if _target_platform_os(ctx) not in [\"linux\", \"macOS\"]:","+        output = ctx.actions.declare_file(ctx.label.name + \".json\")","+        ctx.actions.write(output, json.encode({\"target_os\": _target_platform_os(ctx), \"captured\": False}))","+        return [DefaultInfo(files = depset([output]))]","+    cc_toolchain = find_cc_toolchain(ctx)","+    feature_configuration = cc_common.configure_features(","+        ctx = ctx,","+        cc_toolchain = cc_toolchain,","+        requested_features = ctx.features,","+        unsupported_features = ctx.disabled_features,","+    )","+    compiler_bin = cc_common.get_tool_for_action(","+        feature_configuration = feature_configuration,","+        action_name = ACTION_NAMES.cpp_compile,","+    )","+    compile_variables = cc_common.create_compile_variables(","+        feature_configuration = feature_configuration,","+        cc_toolchain = cc_toolchain,","+        user_compile_flags = ctx.fragments.cpp.cxxopts + ctx.fragments.cpp.copts,","+    )","+    link_flags = cc_common.get_memory_inefficient_command_line(","+        feature_configuration = feature_configuration,","+        action_name = ACTION_NAMES.cpp_link_executable,","+        variables = compile_variables,","+    )","+    probe_link_flags = link_flags + ctx.attr.cpp_linkflags + ctx.fragments.cpp.linkopts","+    compiler = ctx.attr._compiler_type[compiler_type_provider].compiler_type","+    remote_macos_cross_link = (","+        ctx.target_platform_has_constraint(ctx.attr._apple_cross[platform_common.ConstraintValueInfo]) and","+        ctx.attr._macos_cross_local_container_actions[BuildSettingInfo].value and","+        ctx.attr._remote_link[remote_link_provider].enabled","+    )","+    version_inputs = []","+    for kind, action, driver, flags, mnemonic in [","+        (\"compiler\", ACTION_NAMES.cpp_compile, compiler_bin, [], \"ConfigHeaderGen\"),","+        (\"linker\", ACTION_NAMES.cpp_link_executable, cc_common.get_tool_for_action(","+            feature_configuration = feature_configuration,","+            action_name = ACTION_NAMES.cpp_link_executable,","+        ), probe_link_flags, \"CppLink\"),","+    ]:","+        output = ctx.actions.declare_file(ctx.label.name + \"_\" + kind + \"_version.json\")","+        probe_env = cc_common.get_environment_variables(","+            feature_configuration = feature_configuration,","+            action_name = action,","+            variables = compile_variables,","+        ) | {\"SDKROOT\": ctx.attr._sdkroot[sdkroot_provider].path}","+        arguments = [","+            \"--kind\",","+            kind,","+            \"--driver\",","+            driver,","+            \"--compiler\",","+            compiler,","+            \"--flags\",","+            json.encode(flags),","+            \"--environment\",","+            json.encode(probe_env),","+            \"--output\",","+            output.path,","+        ]","+","+        executable = ctx.executable._version_probe","+        inputs = [cc_toolchain.all_files]","+        if kind == \"linker\" and ctx.attr.local_cross_link:","+            # IBM cross builds compile remotely but link on the fetching host.","+            # The composed toolchain keeps native link tools in a separate archive.","+            executable = ctx.file._host_python","+            arguments = [ctx.file._version_probe_script.path] + arguments","+            inputs += [","+                depset([ctx.file._version_probe_script]),","+                ctx.attr._host_linker_files.files,","+                ctx.attr._host_python_files.files,","+            ]","+        elif kind == \"linker\" and remote_macos_cross_link:","+            # macOS host-wrapper toolchains resolve macOS Python, but CppLink","+            # actions run on Linux when remote linking is enabled. Use the","+            # Linux worker runtime already configured for remote IDL actions.","+            python_interpreter = ctx.attr._linux_aarch64_python_interpreter","+            python_files = ctx.attr._linux_aarch64_python_files","+            if ctx.attr._macos_cross_linux_python_arch[BuildSettingInfo].value == \"x86_64\":","+                python_interpreter = ctx.attr._linux_x86_64_python_interpreter","+                python_files = ctx.attr._linux_x86_64_python_files","+            interpreters = python_interpreter.files.to_list()","+            if len(interpreters) != 1:","+                fail(\"Linux Python runtime was requested for the remote linker version probe but is not available\")","+            executable = interpreters[0]","+            arguments = [ctx.file._version_probe_script.path] + arguments","+            inputs += [depset([ctx.file._version_probe_script]), python_files.files]","+        ctx.actions.run(","+            executable = executable,","+            arguments = arguments,","+            inputs = depset(transitive = inputs),","+            outputs = [output],","+            mnemonic = mnemonic,","+            use_default_shell_env = True,","+        )","+        version_inputs.append(output)","+    output = ctx.actions.declare_file(ctx.label.name + \".json\")","+    arguments = ctx.actions.args()","+    arguments.add(\"--compiler-version-file\", version_inputs[0])","+    arguments.add(\"--linker-version-file\", version_inputs[1])","+    arguments.add(\"--target-os\", _target_platform_os(ctx))","+    arguments.add(\"--target-arch\", _target_platform_arch(ctx))","+    arguments.add(\"--toolchain-mode\", \"cross\" if any([","+        ctx.target_platform_has_constraint(target[platform_common.ConstraintValueInfo])","+        for target in [ctx.attr._linux_cross, ctx.attr._apple_cross]","+    ]) else \"native\")","+    if ctx.attr.production_release:","+        arguments.add(\"--production-release\")","+    arguments.add(\"--output\", output)","+    ctx.actions.run(","+        executable = ctx.executable._version_manifest,","+        arguments = [arguments],","+        inputs = version_inputs,","+        outputs = [output],","+        # Match the execution-platform metadata actions used by cross builds.","+        mnemonic = \"ConfigHeaderGen\",","+    )","+    return [DefaultInfo(files = depset([output]))]","+","+toolchain_provenance = rule(","+    _toolchain_provenance_impl,","+    attrs = {","+        \"_compiler_type\": attr.label(default = \"//bazel/config:compiler_type\"),","+        \"_linux_cross\": attr.label(default = \"//bazel/platforms:use_mongo_linux_cross_toolchain\"),","+        \"_apple_cross\": attr.label(default = \"//bazel/platforms:use_mongo_apple_cross_toolchain\"),","+        \"local_cross_link\": attr.bool(default = False),","+        \"production_release\": attr.bool(default = False),","+        \"_version_probe\": attr.label(default = \"//bazel/toolchains/cc:toolchain_version_probe\", executable = True, cfg = \"exec\"),","+        \"_version_probe_script\": attr.label(default = \"//bazel/toolchains/cc:toolchain_version_probe.py\", allow_single_file = True),","+        \"_host_python\": attr.label(default = \"@py_host//:interpreter\", allow_single_file = True),","+        \"_host_python_files\": attr.label(default = \"@py_host//:files\"),","+        \"_host_linker_files\": attr.label(default = \"@mongo_toolchain_v5//:all_files\"),","+        \"_macos_cross_local_container_actions\": attr.label(default = \"//bazel/config:macos_cross_local_container_actions\"),","+        \"_remote_link\": attr.label(default = \"//bazel/config:remote_link\"),","+        \"_macos_cross_linux_python_arch\": attr.label(default = \"//bazel/config:macos_cross_linux_python_arch\"),","+        \"_linux_aarch64_python_interpreter\": attr.label(default = \"@py_linux_arm64//:interpreter\"),","+        \"_linux_aarch64_python_files\": attr.label(default = \"@py_linux_arm64//:files\"),","+        \"_linux_x86_64_python_interpreter\": attr.label(default = \"@py_linux_x86_64//:interpreter\"),","+        \"_linux_x86_64_python_files\": attr.label(default = \"@py_linux_x86_64//:files\"),","+        \"cpp_linkflags\": attr.string_list(),","+        \"_version_manifest\": attr.label(default = \"//bazel/toolchains/cc:toolchain_version_manifest\", executable = True, cfg = \"exec\"),","+        \"_cc_toolchain\": attr.label(default = \"@rules_cc//cc:current_cc_toolchain\"),","+        \"_sdkroot\": attr.label(default = \"//bazel/config:sdkroot\"),","+        \"_linux_constraint\": attr.label(default = \"@platforms//os:linux\"),","+        \"_macos_constraint\": attr.label(default = \"@platforms//os:macos\"),","+        \"_windows_constraint\": attr.label(default = \"@platforms//os:windows\"),","+        \"_wasi_constraint\": attr.label(default = \"@platforms//os:wasi\"),","+        \"_x86_64_constraint\": attr.label(default = \"@platforms//cpu:x86_64\"),","+        \"_aarch64_constraint\": attr.label(default = \"@platforms//cpu:aarch64\"),","+        \"_arm64_constraint\": attr.label(default = \"@platforms//cpu:arm64\"),","+        \"_ppc64le_constraint\": attr.label(default = \"@platforms//cpu:ppc64le\"),","+        \"_s390x_constraint\": attr.label(default = \"@platforms//cpu:s390x\"),","+        \"_wasm32_constraint\": attr.label(default = \"@platforms//cpu:wasm32\"),","+    },","+    fragments = [\"cpp\"],","+    toolchains = [\"@bazel_tools//tools/cpp:toolchain_type\", \"@rules_python//python:toolchain_type\"],","+)"],"additions":196,"deletions":0,"truncated":false},{"path":"bazel/config/toolchain_versions_test.bzl","lines":["@@ -0,0 +1,162 @@","+\"\"\"Check that build metadata probes the selected compile and link actions.\"\"\"","+","+load(\"@bazel_skylib//lib:unittest.bzl\", \"analysistest\", \"asserts\")","+","+_LinkActionsInfo = provider(fields = [\"actions\"])","+","+def _link_actions_aspect_impl(target, ctx):","+    actions = list(target.actions)","+    if hasattr(ctx.rule.attr, \"srcs\"):","+        for dependency in ctx.rule.attr.srcs:","+            if _LinkActionsInfo in dependency:","+                actions += dependency[_LinkActionsInfo].actions","+    return [_LinkActionsInfo(actions = actions)]","+","+_link_actions_aspect = aspect(","+    implementation = _link_actions_aspect_impl,","+    attr_aspects = [\"srcs\"],","+)","+","+def _linker_features_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    actions = analysistest.target_under_test(env)[_LinkActionsInfo].actions","+    probes = [action for action in actions if action.argv and \"--kind\" in action.argv and action.argv[action.argv.index(\"--kind\") + 1] == \"linker\"]","+    links = [action for action in actions if action.mnemonic == \"CppLink\" and action.argv and \"--kind\" not in action.argv]","+    asserts.equals(env, 1, len(probes))","+    asserts.equals(env, 1, len(links))","+    probe_flags = json.decode(probes[0].argv[probes[0].argv.index(\"--flags\") + 1])","+    for flags in [probe_flags, links[0].argv]:","+        selection = [flag for flag in flags if flag.startswith(\"-fuse-ld=\")]","+        asserts.equals(env, [\"-fuse-ld=mold\"] if ctx.attr.mold else [], selection)","+    return analysistest.end(env)","+","+requested_linker_features_analysis_test = analysistest.make(","+    _linker_features_test_impl,","+    attrs = {\"mold\": attr.bool(default = True)},","+    extra_target_under_test_aspects = [_link_actions_aspect],","+    config_settings = {\"//command_line_option:features\": [\"linker_mold\"]},","+)","+","+disabled_linker_features_analysis_test = analysistest.make(","+    _linker_features_test_impl,","+    attrs = {\"mold\": attr.bool(default = False)},","+    extra_target_under_test_aspects = [_link_actions_aspect],","+    config_settings = {\"//command_line_option:features\": [\"-default_linker_lld\", \"-default_linker_mold\"]},","+)","+","+def _local_cross_link_inputs_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    probes = [action for action in analysistest.target_actions(env) if action.argv and \"--kind\" in action.argv and action.argv[action.argv.index(\"--kind\") + 1] == \"linker\"]","+    asserts.equals(env, 1, len(probes))","+    inputs = {file.path: True for file in probes[0].inputs.to_list()}","+    missing = [file.path for file in ctx.attr.host_linker_files.files.to_list() if file.path not in inputs]","+    asserts.equals(env, [], missing[:5], \"Missing native host linker inputs (first five)\")","+    return analysistest.end(env)","+","+local_cross_link_inputs_analysis_test = analysistest.make(","+    _local_cross_link_inputs_test_impl,","+    attrs = {\"host_linker_files\": attr.label(default = \"@mongo_toolchain_v5//:all_files\")},","+    config_settings = {\"//command_line_option:extra_toolchains\": [str(Label(\"//bazel/config:probe_test_toolchain\"))]},","+)","+","+def _version_actions_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    actions = analysistest.target_actions(env)","+    probes = [","+        action","+        for action in actions","+        if any([file.basename.endswith(\"_version.json\") for file in action.outputs.to_list()])","+    ]","+    asserts.equals(env, 2, len(probes))","+    for action in probes:","+        compiler = any([file.basename.endswith(\"_compiler_version.json\") for file in action.outputs.to_list()])","+        asserts.equals(env, \"ConfigHeaderGen\" if compiler else \"CppLink\", action.mnemonic)","+        asserts.true(env, \"--driver\" in action.argv)","+        if not compiler:","+            flags = action.argv[action.argv.index(\"--flags\") + 1]","+            asserts.true(env, \"-fuse-ld=\" in flags)","+    generator = [action for action in actions if any([file.basename == \"toolchain_provenance.json\" for file in action.outputs.to_list()])][0]","+    inputs = [file.basename for file in generator.inputs.to_list()]","+    for required in [\"toolchain_provenance_compiler_version.json\", \"toolchain_provenance_linker_version.json\"]:","+        asserts.true(env, required in inputs, \"Missing version-generator input \" + required)","+    asserts.equals(env, \"ConfigHeaderGen\", generator.mnemonic)","+    argv = generator.argv","+    asserts.equals(env, \"macOS\" if ctx.attr.macos_cross else \"linux\", argv[argv.index(\"--target-os\") + 1])","+    if ctx.attr.macos_cross:","+        asserts.equals(env, \"arm64\", argv[argv.index(\"--target-arch\") + 1])","+        asserts.equals(env, \"cross\", argv[argv.index(\"--toolchain-mode\") + 1])","+    return analysistest.end(env)","+","+toolchain_versions_analysis_test = analysistest.make(","+    _version_actions_test_impl,","+    attrs = {\"macos_cross\": attr.bool(default = False)},","+)","+","+macos_cross_toolchain_versions_analysis_test = analysistest.make(","+    _version_actions_test_impl,","+    attrs = {\"macos_cross\": attr.bool(default = True)},","+    config_settings = {","+        \"//command_line_option:platforms\": str(Label(\"//bazel/platforms:macos_arm64_cross\")),","+    },","+)","+","+def _macos_cross_compile_flags_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    actions = analysistest.target_under_test(env)[_LinkActionsInfo].actions","+    compiles = [action for action in actions if action.mnemonic == \"CppCompile\"]","+    asserts.equals(env, 1, len(compiles))","+    flags = compiles[0].argv","+    asserts.true(env, \"-Werror\" in flags, \"Cross builds must retain warnings as errors\")","+    asserts.false(env, \"-Wno-character-conversion\" in flags, \"LLVM 19 does not support this warning\")","+    return analysistest.end(env)","+","+macos_cross_compile_flags_analysis_test = analysistest.make(","+    _macos_cross_compile_flags_test_impl,","+    extra_target_under_test_aspects = [_link_actions_aspect],","+    config_settings = {","+        \"//command_line_option:platforms\": str(Label(\"//bazel/platforms:macos_arm64_cross\")),","+    },","+)","+","+def _macos_cross_probe_runtime_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    probes = [action for action in analysistest.target_actions(env) if action.argv and \"--kind\" in action.argv]","+    asserts.equals(env, 2, len(probes))","+    for action in probes:","+        kind = action.argv[action.argv.index(\"--kind\") + 1]","+        if kind == \"linker\" and ctx.attr.remote_link:","+            interpreter = ctx.attr.linux_python_interpreter.files.to_list()[0]","+            asserts.equals(env, interpreter.path, action.argv[0])","+            asserts.equals(env, \"bazel/toolchains/cc/toolchain_version_probe.py\", action.argv[1])","+            inputs = {file.path: True for file in action.inputs.to_list()}","+            missing = [file.path for file in ctx.attr.linux_python_files.files.to_list() if file.path not in inputs]","+            asserts.equals(env, [], missing[:5], \"Missing Linux Python runtime inputs (first five)\")","+            asserts.true(env, action.argv[1] in inputs)","+        else:","+            # Local probes retain the execution-platform py_binary launcher.","+            asserts.true(env, action.argv[0].endswith(\"/toolchain_version_probe\"))","+    return analysistest.end(env)","+","+macos_cross_remote_link_runtime_analysis_test = analysistest.make(","+    _macos_cross_probe_runtime_test_impl,","+    attrs = {","+        \"remote_link\": attr.bool(default = True),","+        \"linux_python_interpreter\": attr.label(default = \"@py_linux_arm64//:interpreter\"),","+        \"linux_python_files\": attr.label(default = \"@py_linux_arm64//:files\"),","+    },","+    config_settings = {","+        \"//command_line_option:platforms\": str(Label(\"//bazel/platforms:macos_arm64_cross\")),","+        str(Label(\"//bazel/config:macos_cross_local_container_actions\")): True,","+        str(Label(\"//bazel/config:remote_link\")): True,","+    },","+)","+","+macos_cross_local_link_runtime_analysis_test = analysistest.make(","+    _macos_cross_probe_runtime_test_impl,","+    attrs = {\"remote_link\": attr.bool(default = False)},","+    config_settings = {","+        \"//command_line_option:platforms\": str(Label(\"//bazel/platforms:macos_arm64_cross\")),","+        str(Label(\"//bazel/config:macos_cross_local_container_actions\")): True,","+        str(Label(\"//bazel/config:remote_link\")): False,","+    },","+)"],"additions":162,"deletions":0,"truncated":false},{"path":"bazel/docs/toolchain.md","lines":["@@ -88,3 +88,45 @@ CC=gcc-14 CXX=g++-14 bazel build \\"," "," The build only compiles cleanly with a sufficiently modern compiler and standard library — this is"," the same modernity the hermetic toolchain pins, and older toolchains will fail.","+","+# Production compiler and linker versions","+","+`buildscripts/package_test/toolchain_versions.json` pins the compiler and linker family and exact","+version for each target OS and architecture, shared by native and cross builds. Windows is currently","+excluded. The native and cross macOS archive rules read their LLVM versions from this map; archive","+checksums must also be updated when changing those versions. Native macOS link flags explicitly","+select the downloaded LLVM archive's `ld64.lld`.","+","+Both macOS toolchains enable vendor availability guards in LLVM's libc++ headers so generated code","+remains compatible with Apple's system runtime on the deployment target. The `__config_site`","+override lives in the generated toolchain repository, including when `LLVM_PATH` points to a local","+installation.","+","+Every Linux/macOS server build probes its selected compiler with `-dumpversion` (or GCC's","+`-dumpfullversion`). A separate action probes the linker selected by the link driver, including its","+target, sysroot, search paths, and linker options. These actions use the same execution strategies","+as compilation and linking, so IBM cross builds can probe the remote compiler and local linker","+independently. No target server executable runs during metadata generation.","+","+Version capture supports Clang and GCC with LLD, GNU gold, GNU ld (BFD), and mold. GCC uses","+`-dumpfullversion` to retain its minor and patch versions. Gold's `linker_version` is its own","+version (for example, `1.16`); the `ld` banner also retains the Binutils release. The capture","+follows the configured driver and does not add new `--linker` build settings.","+","+`//bazel/config:toolchain_provenance` writes a JSON record containing the target platform,","+native/cross mode, production marker, compiler/linker families, exact versions, and linker banner.","+Evergreen builds this target after the requested binaries under the same configuration, saves","+`.bazel_toolchain_provenance.json`, and uploads a Toolchain Provenance artifact for all Linux/macOS","+configurations. The probes do not modify `buildInfo` or `--version` output. Development","+configurations record versions without enforcing the production map. `--config=public-release` and","+its local/RBE variants fail provenance generation if either tool differs from its platform pin.","+Capture requests default outputs without target filters so aspect/report tasks can materialize the","+JSON record. Compile-database pseudo-targets and builds with a nonempty","+`--repo_env=no_c++_toolchain` value skip capture because they do not use a C++ toolchain.","+","+Release Binary Provenance includes the captured record in its `toolchain` object alongside binary","+hashes and the build command. Nightly builds reconstruct that record from the `archive_dist_test`","+artifacts. `test_packages` independently compares recorded production versions against the map;","+ordinary patches read the Toolchain Provenance artifact directly. Production task invocations","+require the production marker. `test_packages_release` uses the published-release path, which does","+not apply current pins to old packages."],"additions":42,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/BUILD.bazel","lines":["@@ -1,7 +1,12 @@","-load(\"@rules_python//python:defs.bzl\", \"py_library\", \"py_test\")","+load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_library\", \"py_test\")","+load(\":libcxx_config_test.bzl\", \"libcxx_vendor_availability_test\")"," "," package(default_visibility = [\"//visibility:public\"])"," ","+libcxx_vendor_availability_test(","+    name = \"libcxx_vendor_availability_test\",","+)","+"," exports_files([","     \"container_action.py\",","     \"container_engine.py\",","@@ -56,3 +61,34 @@ py_test(","     main = \"container_action_test.py\",","     deps = [\":container_action\"],"," )","+","+py_binary(","+    name = \"toolchain_version_probe\",","+    srcs = [\"toolchain_version_probe.py\"],","+    visibility = [\"//visibility:public\"],","+)","+","+py_binary(","+    name = \"toolchain_version_manifest\",","+    srcs = [\"toolchain_version_manifest.py\"],","+    deps = [\"//buildscripts/package_test:toolchain_versions\"],","+)","+","+py_test(","+    name = \"toolchain_version_probe_test\","],"additions":21,"deletions":1,"truncated":false}],"additions":540,"deletions":3,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-31T14:36:56.622816+00:00"}