d -G","-\t[ \"$output\" = \"1000 100 65534\" ]","+\tassert_output \"1000 100 65534\""," }"," "," @test \"runc exec --preserve-fds\" {","@@ -151,7 +151,7 @@ function teardown() {"," \t# fd 3 is used by bats, so we use 4"," \texec 4<preserve-fds.test"," \trun -0 runc exec --preserve-fds=2 test_busybox cat /proc/self/fd/4","-\t[ \"${output}\" = \"hello\" ]","+\tassert_output \"hello\""," }"," "," function check_exec_debug() {","@@ -331,7 +331,7 @@ function check_exec_debug() {"," \t# Test that runc exec is able to fallback to container's init cgroup"," \t# even if the original cgroup is gone."," \trun -0 runc exec test_busybox cat /proc/self/cgroup","-\t[ \"$output\" = \"0::$NEW_CGROUP_REL\" ]","+\tassert_output \"0::$NEW_CGROUP_REL\""," "," \t# Cleanup."," \trun -0 runc delete -f test_busybox","@@ -364,5 +364,5 @@ EOF"," \trun -0 runc run -d --console-socket \"$CONSOLE_SOCKET\" test"," "," \trun -0 runc exec -u 2000 test sh -c \"echo \\$HOME\"","-\t[ \"${lines[0]}\" = \"/home/tempuser\" ]","+\tassert_line --index 0 \"/home/tempuser\""," }"],"additions":7,"deletions":7,"truncated":false},{"path":"tests/integration/helpers.bash","lines":["@@ -61,6 +61,9 @@ ARCH=$(uname -m)"," # Seccomp agent socket."," SECCCOMP_AGENT_SOCKET=\"$BATS_TMPDIR/seccomp-agent.sock\""," ","+# Assertion helpers (assert_output, refute_output, assert_line).","+load lib/assert","+"," # Wrapper for runc spec."," function runc_spec() {"," \tlocal rootless=\"\""],"additions":3,"deletions":0,"truncated":false},{"path":"tests/integration/hooks.bats","lines":["@@ -36,7 +36,7 @@ function teardown() {"," \t\t# Failed poststart hooks results in container being killed,"," \t\t# but only after it has started, so output may or may not appear."," \t\tif [ \"$hook\" != \"poststart\" ]; then","-\t\t\t[[ \"$output\" != \"Hello World\" ]]","+\t\t\trefute_output \"Hello World\""," \t\tfi"," \t\t[[ \"$output\" == *\"error running $hook hook #1:\"* ]]"," \tdone"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/integration/ioprio.bats","lines":["@@ -18,11 +18,11 @@ function teardown() {"," "," \t# Check the init process."," \trun -0 runc exec test_ioprio ionice -p 1","-\t[ \"${lines[0]}\" = 'best-effort: prio 4' ]","+\tassert_line --index 0 'best-effort: prio 4'"," "," \t# Check an exec process, which should derive ioprio from config.json."," \trun -0 runc exec test_ioprio ionice","-\t[ \"${lines[0]}\" = 'best-effort: prio 4' ]","+\tassert_line --index 0 'best-effort: prio 4'"," "," \t# Check an exec with a priority taken from process.json,"," \t# which should override the ioprio in config.json.","@@ -36,5 +36,5 @@ function teardown() {"," \t\"cwd\": \"/\""," }'"," \trun -0 runc exec --process <(echo \"$proc\") test_ioprio","-\t[ \"${lines[0]}\" = 'idle' ]","+\tassert_line --index 0 'idle'"," }"],"additions":3,"deletions":3,"truncated":false},{"path":"tests/integration/lib/assert.bash","lines":["@@ -0,0 +1,93 @@","+#!/bin/bash","+#","+# The assert_* functions below implement a subset of the bats-assert library","+# (https://github.com/bats-core/bats-assert). We do not use the real thing","+# because it, together with its bats-support dependency, has to be installed","+# separately on every distribution the tests are run on.","+#","+#\tassert_output [--partial | --regexp] EXPECTED","+#\trefute_output [--partial | --regexp] UNEXPECTED","+#\tassert_line --index IDX [--partial | --regexp] EXPECTED","+#","+# This file lives in its own directory so that bats can be told to skip it","+# when capturing stack traces (see below); otherwise every failed assertion","+# is prefixed by a few useless frames pointing into this file.","+if declare -F bats_setup_tracing >/dev/null &&","+\t! declare -F __assert_orig_setup_tracing >/dev/null; then","+\t# Rename bats_setup_tracing to __assert_orig_setup_tracing ...","+\teval \"__assert_orig_setup_tracing() $(declare -f bats_setup_tracing | tail -n +2)\"","+\t# ... and wrap it, so that this directory is added to the list of paths","+\t# excluded from stack traces. This can not be done at load time, as bats","+\t# resets the exclude list in bats_setup_tracing, which runs afterwards.","+\tfunction bats_setup_tracing() {","+\t\t__assert_orig_setup_tracing \"$@\"","+\t\tbats_add_debug_exclude_path \"${BASH_SOURCE[0]%/*}\"","+\t}","+fi","+","+# __assert_matches MODE ACTUAL EXPECTED","+function __assert_matches() {","+\tcase \"$1\" in","+\texact) [ \"$2\" = \"$3\" ] ;;","+\tpartial) [[ $2 == *\"$3\"* ]] ;;","+\tregexp) [[ $2 =~ $3 ]] ;;","+\t*) fail \"assert: unknown mode: $1\" ;;","+\tesac","+}","+","+# __assert_fail WHAT MODE EXPECTED ACTUAL","+function __assert_fail() {","+\t{","+\t\techo \"-- $1 ($2) --\"","+\t\techo \"expected: ${3@Q}\"","+\t\techo \"  actual: ${4@Q}\"","+\t\techo \"--\"","+\t} >&2","+","+\treturn 1","+}","+","+# __assert_mode ARG -- prints the match mode for an optional flag.","+function __assert_mode() {","+\tcase \"$1\" in","+\t--partial) echo partial ;;","+\t--regexp) echo regexp ;;","+\t# Guard against a typo or an unimplemented bats-assert option being","+\t# silently treated as the expected value.","+\t-*) fail \"assert: unknown option: $1\" ;;","+\t*) echo exact ;;","+\tesac","+}","+","+function assert_output() {","+\tlocal mode","+\tmode=$(__assert_mode \"${1:-}\")","+\t[ \"$mode\" = exact ] || shift","+","+\t# shellcheck disable=SC2154 # $output is set by bats' run helper.","+\t__assert_matches \"$mode\" \"$output\" \"$1\" && return 0","+\t__assert_fail \"output does not match\" \"$mode\" \"$1\" \"$output\"","+}","+","+function refute_output() {","+\tlocal mode","+\tmode=$(__assert_mode \"${1:-}\")","+\t[ \"$mode\" = exact ] || shift","+","+\t# shellcheck disable=SC2154 # $output is set by bats' run helper.","+\t__assert_matches \"$mode\" \"$output\" \"$1\" || return 0","+\t__assert_fail \"output should not match\" \"$mode\" \"$1\" \"$output\"","+}","+","+function assert_line() {","+\tlocal idx mode","+\t[ \"${1:-}\" = \"--index\" ] || fail \"assert_line: --index IDX is required\"","+\tidx=\"$2\"","+\tshift 2","+\tmode=$(__assert_mode \"${1:-}\")","+\t[ \"$mode\" = exact ] || shift","+","+\t# shellcheck disable=SC2154 # $lines is set by bats' run helper.","+\t__assert_matches \"$mode\" \"${lines[idx]:-}\" \"$1\" && return 0","+\t__assert_fail \"line $idx does not match\" \"$mode\" \"$1\" \"${lines[idx]:-}\"","+}"],"additions":93,"deletions":0,"truncated":false},{"path":"tests/integration/list.bats","lines":["@@ -30,9 +30,9 @@ function teardown() {"," \t[[ \"${lines[3]}\" == *\"test_box3\"*[0-9]*\"running\"*$bundle*[0-9]* ]]"," "," \tROOT=$ALT_ROOT run -0 runc list -q","-\t[ \"${lines[0]}\" = \"test_box1\" ]","-\t[ \"${lines[1]}\" = \"test_box2\" ]","-\t[ \"${lines[2]}\" = \"test_box3\" ]","+\tassert_line --index 0 \"test_box1\"","+\tassert_line --index 1 \"test_box2\"","+\tassert_line --index 2 \"test_box3\""," "," \tROOT=$ALT_ROOT run -0 runc list --format table"," \t[[ ${lines[0]} =~ ID\\ +PID\\ +STATUS\\ +BUNDLE\\ +CREATED+ ]]"],"additions":3,"deletions":3,"truncated":false},{"path":"tests/integration/mask.bats","lines":["@@ -51,10 +51,10 @@ function teardown() {"," \trun -0 runc run -d --console-socket \"$CONSOLE_SOCKET\" test_busybox"," "," \trun -0 runc exec test_busybox sh -c \"mount | grep /testdir -c\"","-\t[[ \"${output}\" == \"1\" ]]","+\tassert_output \"1\""," "," \trun -0 runc exec test_busybox sh -c \"mount | grep /testfile -c\"","-\t[[ \"${output}\" == \"1\" ]]","+\tassert_output \"1\""," }"," "," @test \"mask paths [prohibit symlink /proc]\" {"],"additions":2,"deletions":2,"truncated":false},{"path":"tests/integration/memorypolicy.bats","lines":["@@ -18,7 +18,7 @@ function teardown() {"," \t\t\"nodes\": \"0\""," \t}'"," \trun -0 runc run test_busybox","-\t[[ \"${lines[0]}\" == \"interleave:0\" ]]","+\tassert_line --index 0 \"interleave:0\""," }"," "," @test \"runc run memory policy bind static\" {"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/integration/mounts.bats","lines":["@@ -147,7 +147,7 @@ tes