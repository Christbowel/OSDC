 quota","+    QuotaConfig quotaConfig = new QuotaConfig(null, TABLE_MAX_QPS_STR, null, QuotaEnforcementMode.SHADOW);","+    TableConfig tableConfig = generateDefaultTableConfig(OFFLINE_TABLE_NAME);","+    tableConfig.setQuotaConfig(quotaConfig);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(tableConfig, brokerResource);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME),","+        QuotaEnforcementMode.SHADOW);","+    // The quota itself is still tracked in SHADOW mode so that breaches can be detected","+    Assert.assertEquals(_queryQuotaManager.getTableQueryQuota(OFFLINE_TABLE_NAME), TABLE_MAX_QPS);","+","+    // Changing the override is picked up on the next table config update","+    quotaConfig = new QuotaConfig(null, TABLE_MAX_QPS_STR, null, QuotaEnforcementMode.DISABLED);","+    tableConfig.setQuotaConfig(quotaConfig);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(tableConfig, brokerResource);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME),","+        QuotaEnforcementMode.DISABLED);","+","+    // A mode without any QPS quota is not reported: such a table cannot breach, so it has no effect","+    quotaConfig = new QuotaConfig(\"6G\", null, null, QuotaEnforcementMode.SHADOW);","+    tableConfig.setQuotaConfig(quotaConfig);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(tableConfig, brokerResource);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME), QuotaEnforcementMode.ENFORCED);","+","+    // Removing the mode reverts to the default (null, i.e. ENFORCED)","+    tableConfig.setQuotaConfig(new QuotaConfig(null, TABLE_MAX_QPS_STR));","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(tableConfig, brokerResource);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME), QuotaEnforcementMode.ENFORCED);","+","+    // Dropping the table clears the override","+    quotaConfig = new QuotaConfig(null, TABLE_MAX_QPS_STR, null, QuotaEnforcementMode.SHADOW);","+    tableConfig.setQuotaConfig(quotaConfig);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(tableConfig, brokerResource);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME),","+        QuotaEnforcementMode.SHADOW);","+    _queryQuotaManager.dropTableQueryQuota(OFFLINE_TABLE_NAME);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME), QuotaEnforcementMode.ENFORCED);","+  }","+","+  @Test","+  public void testEnforcementModeIsRemovedWithRateLimiter()","+      throws Exception {","+    ExternalView brokerResource = generateBrokerResource(REALTIME_TABLE_NAME);","+    QuotaConfig quotaConfig = new QuotaConfig(null, TABLE_MAX_QPS_STR, null, QuotaEnforcementMode.SHADOW);","+    TableConfig tableConfig = generateDefaultTableConfig(REALTIME_TABLE_NAME);","+    tableConfig.setQuotaConfig(quotaConfig);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(tableConfig, brokerResource);","+    Assert.assertEquals(_queryQuotaManager.getRateLimiterMapSize(), 1);","+    Assert.assertEquals(queryQuotaMode(REALTIME_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+","+    // Table config deleted from the property store: the rate limiter goes away, and so does its mode","+    ZKMetadataProvider.removeResourceConfigFromPropertyStore(_testPropertyStore, REALTIME_TABLE_NAME);","+    _queryQuotaManager.processQueryRateLimitingExternalViewChange(brokerResource);","+    Assert.assertEquals(_queryQuotaManager.getRateLimiterMapSize(), 0);","+    Assert.assertEquals(queryQuotaMode(REALTIME_TABLE_NAME), QuotaEnforcementMode.ENFORCED);","+  }","+","+  private QuotaEnforcementMode queryQuotaMode(String tableName) {","+    return _queryQuotaManager.getQueryQuotaEnforcementMode(tableName);","+  }","+","+  private TableConfig tableConfigWithQueryQuotaMode(TableType tableType, QuotaEnforcementMode mode) {","+    QuotaConfig quotaConfig = new QuotaConfig(null, TABLE_MAX_QPS_STR, null, mode);","+    TableConfig tableConfig = new TableConfigBuilder(tableType).setTableName(RAW_TABLE_NAME).setQuotaConfig(quotaConfig)","+        .setRetentionTimeUnit(\"DAYS\").setRetentionTimeValue(\"1\").setSegmentPushType(\"APPEND\")","+        .setBrokerTenant(\"testBroker\").setServerTenant(\"testServer\").build();","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, tableConfig);","+    return tableConfig;","+  }","+","+  @Test","+  public void testQueryQuotaEnforcementModeForNameWithoutTypeSuffix()","+      throws Exception {","+    // Queries usually reference the raw table name, which acquire() resolves to both the OFFLINE and REALTIME table","+    ExternalView brokerResource = generateBrokerResource(OFFLINE_TABLE_NAME);","+    brokerResource.setState(REALTIME_TABLE_NAME, BROKER_INSTANCE_ID, \"ONLINE\");","+","+    // Only the OFFLINE table exists: its override applies to the raw name","+    TableConfig offline = tableConfigWithQueryQuotaMode(TableType.OFFLINE, QuotaEnforcementMode.SHADOW);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(offline, brokerResource);","+    Assert.assertEquals(queryQuotaMode(RAW_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+","+    // Hybrid table where only OFFLINE opted into SHADOW: acquire() cannot tell which side was breached, so the raw","+    // name stays ENFORCED (the strictest) rather than letting a breach on the REALTIME side through","+    TableConfig realtime = tableConfigWithQueryQuotaMode(TableType.REALTIME, null);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(realtime, brokerResource);","+    Assert.assertEquals(queryQuotaMode(RAW_TABLE_NAME), QuotaEnforcementMode.ENFORCED);","+    Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+    Assert.assertEquals(queryQuotaMode(REALTIME_TABLE_NAME), QuotaEnforcementMode.ENFORCED);","+","+    // Both sides in SHADOW: the raw name is SHADOW","+    realtime = tableConfigWithQueryQuotaMode(TableType.REALTIME, QuotaEnforcementMode.SHADOW);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(realtime, brokerResource);","+    Assert.assertEquals(queryQuotaMode(RAW_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+","+    // SHADOW is stricter than DISABLED","+    realtime = tableConfigWithQueryQuotaMode(TableType.REALTIME, QuotaEnforcementMode.DISABLED);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(realtime, brokerResource);","+    Assert.assertEquals(queryQuotaMode(RAW_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+","+    // Unknown tables default to ENFORCED","+    Assert.assertEquals(queryQuotaMode(\"unknownTable\"), QuotaEnforcementMode.ENFORCED);","+  }","+","+  @Test","+  public void testQueryQuotaEnforcementModeIgnoresSiblingWithoutQpsQuota()","+      throws Exception {","+    ExternalView brokerResource = generateBrokerResource(OFFLINE_TABLE_NAME);","+    brokerResource.setState(REALTIME_TABLE_NAME, BROKER_INSTANCE_ID, \"ONLINE\");","+","+    // The REALTIME table has no QPS quota (and no mode): it is tracked with a null rate limiter and cannot breach","+    TableConfig realtime = generateDefaultTableConfig(REALTIME_TABLE_NAME);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, realtime);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(realtime, brokerResource);","+","+    // A breach on the raw name can only come from the OFFLINE table, so its mode must apply","+    for (QuotaEnforcementMode mode : new QuotaEnforcementMode[]{QuotaEnforcementMode.SHADOW,","+        QuotaEnforcementMode.DISABLED}) {","+      TableConfig offline = tableConfigWithQueryQuotaMode(TableType.OFFLINE, mode);","+      _queryQuotaManager.initOrUpdateTableQueryQuota(offline, brokerResource);","+      Assert.assertEquals(queryQuotaMode(RAW_TABLE_NAME), mode);","+      Assert.assertEquals(queryQuotaMode(OFFLINE_TABLE_NAME), mode);","+    }","+","+    // The same holds with the roles swapped","+    _queryQuotaManager.dropTableQueryQuota(OFFLINE_TABLE_NAME);","+    _queryQuotaManager.dropTableQueryQuota(REALTIME_TABLE_NAME);","+    TableConfig offline = generateDefaultTableConfig(OFFLINE_TABLE_NAME);","+    ZKMetadataProvider.setTableConfig(_testPropertyStore, offline);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(offline, brokerResource);","+    realtime = tableConfigWithQueryQuotaMode(TableType.REALTIME, QuotaEnforcementMode.SHADOW);","+    _queryQuotaManager.initOrUpdateTableQueryQuota(realtime, brokerResource);","+    Assert.assertEquals(queryQuotaMode(RAW_TABLE_NAME), QuotaEnforcementMode.SHADOW);","+  }","+","   private TableConfig generateDefaultTableConfig(String tableName) {","     TableType tableType = TableNameBuilder.getTableTypeFromTableName(tableName);","     TableConfigBuilder builder = new TableConfigBuilder(tableType);"],"additions":148,"deletions":0,"truncated":false},{"path":"pinot-broker/src/test/java/org/apache/pinot/broker/requesthandler/BrokerQpsQuotaEnforcementModeTest.java","lines":["@@ -0,0 +1,219 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License