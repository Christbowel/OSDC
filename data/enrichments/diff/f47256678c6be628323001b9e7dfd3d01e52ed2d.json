e thing: this is not a package. Users do drop stray files","-        // into `node_modules`, and one of them must not fail the","-        // install.","-        Err(error)","-            if matches!(error.kind(), io::ErrorKind::NotFound | io::ErrorKind::NotADirectory) =>","-        {","-            return Ok(None);","+    Ok(read_package_manifest::<Sys>(location)?","+        .map(|manifest| PackageBinSource::new(location.to_path_buf(), Arc::new(manifest))))","+}","+","+/// The manifest of the package at `location`, in the first format the","+/// directory holds, in [`PROJECT_MANIFEST_BASENAMES`] order.","+///","+/// A missing manifest and a non-directory entry both mean the same thing:","+/// this is not a package. Users do drop stray files into `node_modules`, and","+/// one of them must not fail the install.","+pub fn read_package_manifest<Sys: FsReadFile>(","+    location: &Path,","+) -> Result<Option<Value>, LinkBinsError> {","+    for basename in PROJECT_MANIFEST_BASENAMES {","+        let manifest_path = location.join(basename);","+        let bytes = match Sys::read_file(&manifest_path) {","+            Ok(bytes) => bytes,","+            Err(error) if error.kind() == io::ErrorKind::NotFound => continue,","+            Err(error) if error.kind() == io::ErrorKind::NotADirectory => return Ok(None),","+            Err(error) => return Err(LinkBinsError::ReadManifest { path: manifest_path, error }),","+        };","+        return parse_package_manifest(manifest_path, &bytes).map(Some);","+    }","+    Ok(None)","+}","+","+/// A `package.json` may hold any JSON value, which is how","+/// [`parse_manifest_bytes`] reads the manifest of a registry package.","+fn parse_package_manifest(path: PathBuf, bytes: &[u8]) -> Result<Value, LinkBinsError> {","+    if path","+        .extension()","+        .is_some_and(|extension| extension == \"json\")","+    {","+        return parse_manifest_bytes(bytes)","+            .map_err(|error| LinkBinsError::ParseManifest { path, error });","+    }","+    let contents = match str::from_utf8(bytes) {","+        Ok(contents) => contents,","+        Err(error) => {","+            let source = io::Error::new(io::ErrorKind::InvalidData, error);","+            let error = PackageManifestError::Read { path, source };","+            return Err(LinkBinsError::ReadProjectManifest(error));","         }","-        Err(error) => return Err(LinkBinsError::ReadManifest { path: manifest_path, error }),","     };","-    let manifest: Value = parse_manifest_bytes(&bytes)","-        .map_err(|error| LinkBinsError::ParseManifest { path: manifest_path, error })?;","-    Ok(Some(PackageBinSource::new(location.to_path_buf(), Arc::new(manifest))))","+    parse_project_manifest(&path, contents).map_err(LinkBinsError::ReadProjectManifest)"," }"],"additions":52,"deletions":16,"truncated":false},{"path":"pnpm/crates/cmd-shim/src/link_bins/tests/manifests.rs","lines":["@@ -58,6 +58,47 @@ fn link_bins_links_a_package_whose_manifest_starts_with_a_utf8_bom() {","     assert!(bins.join(\"bom\").exists(), \"missing shim for the BOM-prefixed package\");"," }"," ","+#[test]","+fn link_bins_links_a_package_described_by_a_yaml_or_json5_manifest() {","+    let manifests = [","+        (\"package.json5\", \"{name: 'tool', bin: {'tool-cli': 'cli.js'}}\"),","+        (\"package.yaml\", \"name: tool\\nbin:\\n  tool-cli: cli.js\\n\"),","+    ];","+    for (basename, contents) in manifests {","+        let tmp = tempdir().unwrap();","+        let modules = tmp.path().join(\"node_modules\");","+        create_dir_all(modules.join(\"tool\")).unwrap();","+        write_file(modules.join(\"tool\").join(basename), contents).unwrap();","+        write_file(modules.join(\"tool/cli.js\"), \"#!/usr/bin/env node\\n\").unwrap();","+","+        let bins = modules.join(\".bin\");","+        link_bins::<Host>(&modules, &bins, &LinkBinsOptions::default()).unwrap();","+","+        assert!(bins.join(\"tool-cli\").exists(), \"missing shim for a package with {basename}\");","+    }","+}","+","+#[test]","+fn link_bins_prefers_package_json_over_the_other_manifest_formats() {","+    let tmp = tempdir().unwrap();","+    let modules = tmp.path().join(\"node_modules\");","+    create_dir_all(modules.join(\"tool\")).unwrap();","+    write_file(","+        modules.join(\"tool/package.json\"),","+        json!({\"name\": \"tool\", \"bin\": {\"from-json\": \"cli.js\"}}).to_string(),","+    )","+    .unwrap();","+    write_file(modules.join(\"tool/package.yaml\"), \"name: tool\\nbin:\\n  from-yaml: cli.js\\n\")","+        .unwrap();","+    write_file(modules.join(\"tool/cli.js\"), \"#!/usr/bin/env node\\n\").unwrap();","+","+    let bins = modules.join(\".bin\");","+    link_bins::<Host>(&modules, &bins, &LinkBinsOptions::default()).unwrap();","+","+    assert!(bins.join(\"from-json\").exists());","+    assert!(!bins.join(\"from-yaml\").exists());","+}","+"," #[test]"," fn link_bins_propagates_read_manifest_error_via_di() {","     use std::io;"],"additions":41,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/cas/bins.rs","lines":["@@ -9,7 +9,9 @@ use pnpm_cmd_shim::{","     PackageBinSource,","     get_bins_from_package_manifest_with_walk,","     link_bins_of_packages,","+    read_package_manifest,"," };","+use pnpm_package_manifest::PROJECT_MANIFEST_BASENAMES;"," use sha2::{","     Digest,","     Sha256,","@@ -17,7 +19,10 @@ use sha2::{"," use std::{","     collections::HashMap,","     io,","-    path::Path,","+    path::{","+        Path,","+        PathBuf,","+    },","     sync::Arc,"," };"," use url::Url;","@@ -81,7 +86,8 @@ fn bin_source(","                 .join(\".pnpm-loader\")","                 .join(&hash)","         });","-    let metadata = read_manifest(package, &manifest.store_dir, &manifest_root(inputs, id, &root))?;","+    let metadata =","+        read_manifest(package, &manifest.store_dir, || manifest_root(inputs, id, &root))?;","     if package.resolution.as_deref() == Some(\"node\") 