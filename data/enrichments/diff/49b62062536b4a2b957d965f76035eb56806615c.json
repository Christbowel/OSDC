Handler is null)","+\t\t\t\tthrow new ArgumentNullException(nameof(completionHandler));","+","+\t\t\tvar completion = new LifecycleEventCompletion(completionHandler);","+","+\t\t\ttry","+\t\t\t{","+\t\t\t\tif (services is not null)","+\t\t\t\t{","+\t\t\t\t\tvar delegates = new List<TDelegate>(services.GetLifecycleEventDelegates<TDelegate>());","+\t\t\t\t\tvar logger = delegates.Count > 0","+\t\t\t\t\t\t? services.GetService<ILoggerFactory>()?.CreateLogger<LifecycleEventService>()","+\t\t\t\t\t\t: null;","+","+\t\t\t\t\tfor (var i = 0; i < delegates.Count; i++)","+\t\t\t\t\t\tinvoke(delegates[i], completion.CreateCallback(logger, typeof(TDelegate).Name));","+\t\t\t\t}","+\t\t\t}","+\t\t\tcatch (Exception exception)","+\t\t\t{","+\t\t\t\ttry","+\t\t\t\t{","+\t\t\t\t\tcompletion.Fail();","+\t\t\t\t}","+\t\t\t\tcatch (Exception completionException)","+\t\t\t\t{","+\t\t\t\t\tthrow new AggregateException(exception, completionException);","+\t\t\t\t}","+","+\t\t\t\tthrow;","+\t\t\t}","+","+\t\t\tcompletion.CompleteInvocation();","+\t\t}","+"," \t\tinternal static IEnumerable<TDelegate> GetLifecycleEventDelegates<TDelegate>(this IServiceProvider services, string? eventName = null)"," \t\t\twhere TDelegate : Delegate"," \t\t{","@@ -60,5 +105,57 @@ internal static bool ContainsLifecycleEvent<TDelegate>(this IServiceProvider ser"," "," \t\t\treturn false;"," \t\t}","+","+\t\tsealed class LifecycleEventCompletion","+\t\t{","+\t\t\tAction<bool>? _completionHandler;","+\t\t\t// Keep one response pending until every handler invocation has returned successfully.","+\t\t\tint _remaining = 1;","+\t\t\tint _handled;","+\t\t\tint _invocationCompleted;","+","+\t\t\tpublic LifecycleEventCompletion(Action<bool> completionHandler) =>","+\t\t\t\t_completionHandler = completionHandler;","+","+\t\t\tpublic Action<bool> CreateCallback(ILogger? logger, string eventName)","+\t\t\t{","+\t\t\t\tInterlocked.Increment(ref _remaining);","+\t\t\t\tvar invoked = 0;","+","+\t\t\t\treturn handled =>","+\t\t\t\t{","+\t\t\t\t\tif (Interlocked.Exchange(ref invoked, 1) != 0)","+\t\t\t\t\t{","+\t\t\t\t\t\tlogger?.LogWarning(\"The {LifecycleEvent} lifecycle event handler invoked its completion callback more than once.\", eventName);","+\t\t\t\t\t\treturn;","+\t\t\t\t\t}","+","+\t\t\t\t\tComplete(handled);","+\t\t\t\t};","+\t\t\t}","+","+\t\t\tpublic void CompleteInvocation()","+\t\t\t{","+\t\t\t\tInterlocked.Exchange(ref _invocationCompleted, 1);","+\t\t\t\tComplete(false);","+\t\t\t}","+","+\t\t\tvoid Complete(bool handled)","+\t\t\t{","+\t\t\t\tif (handled)","+\t\t\t\t\tInterlocked.Exchange(ref _handled, 1);","+","+\t\t\t\tvar remaining = Interlocked.Decrement(ref _remaining);","+\t\t\t\tvar wasHandled = Volatile.Read(ref _handled) != 0;","+\t\t\t\tif (Volatile.Read(ref _invocationCompleted) != 0 && (wasHandled || remaining == 0))","+\t\t\t\t\tFinish(wasHandled);","+\t\t\t}","+","+\t\t\tpublic void Fail() =>","+\t\t\t\tFinish(false);","+","+\t\t\tvoid Finish(bool handled) =>","+\t\t\t\tInterlocked.Exchange(ref _completionHandler, null)?.Invoke(handled);","+\t\t}"," \t}"," }","\\ No newline at end of file"],"additions":97,"deletions":0,"truncated":false},{"path":"src/Core/src/LifecycleEvents/iOS/iOSLifecycle.cs","lines":["@@ -13,6 +13,29 @@ public static class iOSLifecycle"," \t\tpublic delegate void OnActivated(UIApplication application);"," \t\tpublic delegate void OnResignActivation(UIApplication application);"," \t\tpublic delegate bool OpenUrl(UIApplication app, NSUrl url, NSDictionary options);","+\t\t/// <summary>","+\t\t/// Handles a quick action delivered through the application or scene lifecycle.","+\t\t/// </summary>","+\t\t/// <param name=\"application\">The application receiving the action.</param>","+\t\t/// <param name=\"shortcutItem\">The user-selected quick action.</param>","+\t\t/// <param name=\"completionHandler\">","+\t\t/// The acknowledgement callback for this registration. Invoke it exactly once with","+\t\t/// <see langword=\"true\"/> if this handler handled the action, or <see langword=\"false\"/> otherwise.","+\t\t/// </param>","+\t\t/// <remarks>","+\t\t/// <para>","+\t\t/// Each registration receives its own callback rather than sharing the native completion callback.","+\t\t/// Existing handlers that only observe or log the action must therefore be updated to acknowledge","+\t\t/// <see langword=\"false\"/>. Acknowledgement may be deferred until asynchronous work completes;","+\t\t/// returning from the handler is not an acknowledgement.","+\t\t/// </para>","+\t\t/// <para>","+\t\t/// When dispatch does not throw, native completion waits until all handler invocations have returned","+\t\t/// and either one registration has reported <see langword=\"true\"/> or every registration has reported","+\t\t/// <see langword=\"false\"/>. If a registration never replies and none reports <see langword=\"true\"/>,","+\t\t/// native completion can remain pending.","+\t\t/// </para>","+\t\t/// </remarks>"," \t\tpublic delegate void PerformActionForShortcutItem(UIApplication application, UIApplicationShortcutItem shortcutItem, UIOperationHandler completionHandler);"," \t\tpublic delegate void WillEnterForeground(UIApplication application);"," \t\tpublic delegate void WillTerminate(UIApplication application);","@@ -26,7 +49,29 @@ public static class iOSLifecycle"," \t\tpublic delegate void SceneOnActivated(UIScene scene);"," \t\tpublic delegate void SceneOnResignActivation(UIScene scene);"," \t\tpublic delegate void SceneDidEnterBackground(UIScene scene);","+\t\t/// <summary>","+\t\t/// Handles URL contexts delivered through a scene's open-URL callback.","+\t\t/// </summary>","+\t\t/// <param name=\"scene\">The scene receiving the URLs.</param>","+\t\t/// <param name=\"urlContexts\">The URL contexts supplied by UIKit.</param>","+\t\t/// <returns><see langword=\"true\"/> if this handler handled the delivery; otherwise, <see langword=\"false\"/>.</returns>","+\t\t/// <remarks>","+\t\t/// URLs supplied when a scene connects are available in <see cref=\"UISceneConnectionOptions.UrlContexts\"/>","+\t\t/// through <see cref=\"SceneWillConnect\"/>. They are not automatically replayed through this callback.","+\t\t/// </remarks>"," \t\tpublic delegate bool SceneOpenUrl(UIScene scene, NSSet<UIOpenUrlContext> urlContexts);","+\t\t/// <summary>","+\t\t/// Handles a user activity delivered through a scene's continuation callback.","+\t\t/// </summary>","+\t\t/// <param name=\"scene\">The scene receiving the activity.</param>","+\t\t/// <param name=\"userActivity\">The user activity supplied by UIKit.</param>","+\t\t/// <returns><see langword=\"true\"/> if this handler handled the activity; otherwise, <see langword=\"false\"/>.</returns>","+\t\t/// <remarks>","+\t\t/// Activities supplied in <see cref=\"UISceneConnectionOptions.UserActivities\"/> when a scene connects","+\t\t/// are available through <see cref=\"SceneWillConnect\"/>. They are not automatically replayed through","+\t\t/// this callback. UIKit can also deliver Handoff activities separately through this callback after","+\t\t/// the scene connects.","+\t\t/// </remarks>"," \t\tpublic delegate bool SceneContinueUserActivity(UIScene scene, NSUserActivity userActivity);"," \t\tpublic delegate void SceneWillContinueUserActivity(UIScene scene, string userActivityType);"," \t\tpublic delegate void SceneDidFailToContinueUserActivity(UIScene scene, string userActivityType, NSError error);"],"additions":45,"deletions":0,"truncated":false},{"path":"src/Core/src/LifecycleEvents/iOS/iOSLifecycleBuilderExtensions.cs","lines":["@@ -12,6 +12,20 @@ public static class iOSLifecycleBuilderExtensions"," \t\tpublic static IiOSLifecycleBuilder OnActivated(this IiOSLifecycleBuilder lifecycle, iOSLifecycle.OnActivated del) => lifecycle.OnEvent(del);"," \t\tpublic static IiOSLifecycleBuilder OnResignActivation(this IiOSLifecycleBuilder lifecycle, iOSLifecycle.OnResignActivation del) => lifecycle.OnEvent(del);"," \t\tpublic static IiOSLifecycleBuilder