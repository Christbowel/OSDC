?;","+            conn.query_row(\"SELECT EXISTS(SELECT 1 FROM tokens LIMIT 1);\", [], |_row| Ok(()))?;","+            Ok(())","+        })","+        .await??;","+        Ok(())","+    }"," }"," "," impl Default for TokenStore {"],"additions":14,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/user_store.rs","lines":["@@ -259,6 +259,19 @@ impl UserBackend for UserStore {","         })","         .await","     }","+","+    async fn check_readiness(&self) -> Result<()> {","+        if let Some(path) = &self.path {","+            if path.exists() {","+                tokio::fs::metadata(path).await.map_err(RegistryError::Io)?;","+            } else if let Some(parent) = path.parent()","+                && !parent.as_os_str().is_empty()","+            {","+                tokio::fs::create_dir_all(parent).await.map_err(RegistryError::Io)?;","+            }","+        }","+        Ok(())","+    }"," }"," "," impl Default for UserStore {"],"additions":13,"deletions":0,"truncated":false},{"path":"pnpr/crates/error/src/lib.rs","lines":["@@ -52,6 +52,13 @@ pub enum RegistryError {","         upstream: String,","     },"," ","+    #[display(\"Storage is temporarily unavailable: {reason}\")]","+    #[from(skip)]","+    StorageUnavailable {","+        #[error(not(source))]","+        reason: String,","+    },","+","     #[display(\"EINTEGRITY: tarball {filename:?} for package {package:?}: {reason}\")]","     #[from(skip)]","     TarballIntegrity {"],"additions":7,"deletions":0,"truncated":false},{"path":"pnpr/crates/error/src/response.rs","lines":["@@ -66,6 +66,7 @@ impl RegistryError {"," ","     fn storage_log_kind(&self) -> &'static str {","         match self {","+            RegistryError::StorageUnavailable { .. } => \"storage_unavailable\",","             RegistryError::Internal { .. } => \"internal\",","             RegistryError::InvalidHtpasswdFile { .. } => \"invalid_htpasswd_file\",","             RegistryError::Bcrypt(_) => \"bcrypt\",","@@ -90,6 +91,7 @@ impl RegistryError {"," ","     fn storage_status_code(&self) -> StatusCode {","         match self {","+            RegistryError::StorageUnavailable { .. } => StatusCode::SERVICE_UNAVAILABLE,","             RegistryError::Internal { .. }","             | RegistryError::InvalidHtpasswdFile { .. }","             | RegistryError::Bcrypt(_)"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -83,6 +83,8 @@ mod org_access;"," use org_access::CallerOrgs;"," mod documents;"," mod ecosystem;","+mod health;","+use health::shutdown_signal;"," mod managed_state;"," mod oci;"," mod oidc;","@@ -422,11 +424,6 @@ pub async fn serve_listener(","     Ok(())"," }"," ","-async fn shutdown_signal() {","-    let _ = tokio::signal::ctrl_c().await;","-    tracing::info!(\"shutdown signal received\");","-}","-"," // --------------------------------------------------------------------"," // Account routes — adduser/login, whoami, profile, token list and"," // revocation, logout. Mounted on every tier (see the router construction","@@ -594,7 +591,3 @@ struct WriteTarget {"," fn not_found() -> Response {","     RegistryError::NotFound.into_response()"," }","-","-async fn serve_ping(State(_state): State<AppState>) -> Response {","-    (StatusCode::OK, axum::Json(serde_json::json!({}))).into_response()","-}"],"additions":2,"deletions":9,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/health.rs","lines":["@@ -0,0 +1,104 @@","+use super::AppState;","+use axum::{","+    extract::State,","+    http::StatusCode,","+    response::{IntoResponse, Response},","+};","+use pnpr_error::RegistryError;","+","+pub(crate) async fn shutdown_signal() {","+    let ctrl_c = async {","+        match tokio::signal::ctrl_c().await {","+            Ok(()) => {}","+            Err(err) => {","+                tracing::error!(error = %err, \"failed to install SIGINT (ctrl_c) handler\");","+                std::future::pending::<()>().await;","+            }","+        }","+    };","+","+    #[cfg(unix)]","+    let terminate = async {","+        match tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate()) {","+            Ok(mut signal) => {","+                signal.recv().await;","+            }","+            Err(err) => {","+                tracing::error!(error = %err, \"failed to install SIGTERM signal handler\");","+                std::future::pending::<()>().await;","+            }","+        }","+    };","+","+    #[cfg(not(unix))]","+    let terminate = std::future::pending::<()>();","+","+    tokio::select! {","+        () = ctrl_c => tracing::info!(\"SIGINT (ctrl_c) received, starting graceful shutdown\"),","+        () = terminate => tracing::info!(\"SIGTERM received, starting graceful shutdown\"),","+    }","+}","+","+pub(crate) async fn check_server_readiness(state: &AppState) -> Result<(), RegistryError> {","+    state.inner.storage.check_readiness().await?;","+    state.inner.identity.auth.check_readiness().await?;","+    Ok(())","+}","+","+pub(crate) async fn serve_ping(State(state): State<AppState>) -> Response {","+    match check_server_readiness(&state).await {","+        Ok(()) => (StatusCode::OK, axum::Json(serde_json::json!({}))).into_response(),","+        Err(err) => {","+            tracing::warn!(error = %err.log_message(), \"ping readiness check failed\");","+            (StatusCode::SERVICE_UNAVAILABLE, err.public_message()).into_response()","+        }","+    }","+}","+","+pub(crate) async fn serve_ready(State(state): State<AppState>) -> Response {","+    let storage_status = state.inner.storage.check_readiness().await;","+    let auth_status = state.inner.identity.auth.check_readiness().await;","+","+    if storage_status.is_ok() && auth_status.is_ok() {","+        (","+            StatusCode::OK,","+            axum::Json(serde_json::json!({","+                \"status\": \"ok\",","+                \"storage\": \"ok\",","+                \"auth\": \"ok\",","+            })),","+        )","+            .into_response()","+    } else {","+        let storage_msg = storage_status","+            .as_ref()","+            .err()","+            .map_or_else(|| \"ok\".to_string(), RegistryError::log_message);","+        let auth_msg = auth_status","+            .as_ref()","+            .err()","+            .map_or_else(|| \"ok\".to_string(), RegistryError::log_message);","+        tracing::warn!(storage = %storage_msg, auth = %auth_msg, \"readiness probe failed\");","+        let storage_status_val = if storage_status.is_ok() { \"ok\" } else { \"unavailable\" };","+        let auth_status_val = if auth_status.is_ok() { \"ok\" } else { \"unavailable\" };","+        (","+            StatusCode::SERVICE_UNAVAILABLE,","+            axum::Json(serde_json::json!({","+                \"status\": \"unhealthy\",","+                \"storage\": storage_status_val,","+                \"auth\": auth_status_val,","+            })),","+        )","+            .into_response()","+    }","+}","+","+pub(crate) async fn serve_live() -> Response {","+    (","+        StatusCode::OK,","+        axum::Json(serde_json::json!({","+            \"status\": \"ok\",","+        })),","+    )","+        .into_response()","+}"],"additions":104,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing.rs","lines":["@@ -45,13 +45,14 @@ use super::{","     MAX_PIPELINE_RUN_BODY_BYTES, MAX_PUBLISH_BODY_BYTES, MAX_TEAM_BODY_BYTES, TargetRegistry,","     addressed_registry, authenticate, batch, caller_scoped, cargo, compiler_cache, delete_package,","     delete_session_token, delete_tarball, delete_token_by_key, get_dist_tags, get_org_teams,","-    get_profile, get_team_members, get_token_list, get_whoami, loggable_uri, not_found, oci,","-    pnpr_protocols_disabled, private_no_cache, publish_package, put_login, pypi, remove_dist_tag,","-    require_artifact_caller, require_pipeline_caller, require_resolver_caller, serve_artifact_blob,","-    serve_artifact_blob_size, serve_batch_publish, serve_get_pipeline_run,","-    serve_list_pipeline_runs, serve_org_packages, serve_packument, serve_ping, serve_pipeline_ui,","-    serve_pnpr_handshake, serve_publish_artifact, serve_publish_pipeline_run, serve_resolve,","-    serve_resolve_artifacts, serve_revision_tarball, serve_search, serve_tarball,","+    get_profile, get_team_members, get_token_list, get_whoami,","+    health::{serve_live, serve_ping, serve_ready},","+    loggable_uri, not_found, oci, pnpr_protocols_disabled, private_no_cache, publish_package,","+    put_login, pypi, remove_dist_tag, require_artifact_caller, require_pipeline_caller,","+    require_resolver_caller, serve_artifact_blob, serve_artifact_blob_size, serve_batch_publish,","+    serve_get_pipeline_run, serve_list_pipeline_runs, serve_org_packages, serve_packument,","+    serve_pipeline_ui, serve_pnpr_handshake, serve_publish_artifact, serve_publish_pipeline_run,","+    serve_resolve, serve_resolve_artifacts, serve_revision_tarball, serve_search, serve_tarball,","     serve_upload_artifact_blob, serve_verify_lockfile, serve_version_manifest, set_dist_tag,","     staged,","     team_access::{grant_team_access, list_team_packages, revoke_team_access},","@@ -204,11 +205,18 @@ fn surface_routes(","     surfaces: EnabledSurfaces,","     ui_served: bool,"," ) -> Router<AppState> {","-    // `/-/ping` is a health check and is always served. The two","-    // configurable surfaces are mounted only when their feature is enabled,","+    // Health and probe endpoints (`/-/ping`, `/-/ready`, `/-/live`) are always served.","+    // The configurable surfaces are mounted only when their feature is enabled,","     // so resolver, registry, and artifacts can be deployed independently.","     // The config guarantees at least one is enabled.","-    let mut router: Router<AppState> = Router::new().route(\"/-/ping\", get(serve_ping));","+    let mut router: Router<AppState> = Router::new();","+    for base in [\"\", \"/~{registry}\"] {","+        let path = |tail: &str| format!(\"{base}{tail}\");","+        router = router","+            .route(&path(\"/-/ping\"), get(serve_ping))","+            .route(&path(\"/-/ready\"), get(serve_ready))","+            .route(&path(\"/-/live\"), get(serve_live));","+    }","     router = router","         .merge(super::oidc::routes(ui_served))","         .merge(account_routes())"],"additions":18,"deletions":10,"truncated":false},{"path":"pnpr/crates/pnpr/tests/server/surfaces.rs","lines":["@@ -329,3 +329,178 @@ async fn cors_allows_only_configured_origins_and_handles_preflight() {","             .any(|header| header.trim().eq_ignore_ascii_case(\"authorization\")),","     );"," }","+","+#[tokio::test]","+async fn readiness_and_liveness_endpoints_report_status() {","+    let tmp = TempDir::new().unwrap();","+    let config = config_for(\"http://upstream.invalid\", tmp.path().to_path_buf());","+    let app = router(config);","+","+    // Bare root endpoints","+    let live = app","+        .clone()","+        .oneshot(","+            Request::get(\"/-/live\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(live.status(), StatusCode::OK);","+    let live_body: Value = serde_json::from_slice(&body_bytes(live.into_body()).await).unwrap();","+    assert_eq!(live_body, json!({\"status\": \"ok\"}));","+","+    let ready = app","+        .clone()","+        .oneshot(","+            Request::get(\"/-/ready\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(ready.status(), StatusCode::OK);","+    let ready_body: Value = serde_json::from_slice(&body_bytes(ready.into_body()).await).unwrap();","+    assert_eq!(","+        ready_body,","+        json!({","+            \"status\": \"ok\",","+            \"storage\": \"ok\",","+            \"auth\": \"ok\"","+        }),","+    );","+","+    // Prefixed registry endpoints","+    let prefixed_live = app","+        .clone()","+        .oneshot(","+            Request::get(\"/~hosted/-/live\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(prefixed_live.status(), StatusCode::OK);","+","+    let prefixed_ready = app","+        .clone()","+        .oneshot(","+            Request::get(\"/~hosted/-/ready\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(prefixed_ready.status(), StatusCode::OK);","+","+    let prefixed_ping = app","+        .oneshot(","+            Request::get(\"/~hosted/-/ping\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(prefixed_ping.status(), StatusCode::OK);","+    let ping_body: Value =","+        serde_json::from_slice(&body_bytes(prefixed_ping.into_body()).await).unwrap();","+    assert_eq!(ping_body, json!({}));","+}","+","+#[tokio::test]","+async fn readiness_probe_fails_when_storage_is_inaccessible() {","+    let tmp = TempDir::new().unwrap();","+    // Create a regular file so that a child path cannot be created as a directory (ENOTDIR)","+    let blocking_file = tmp.path().join(\"blocking-file\");","+    std::fs::write(&blocking_file, b\"block\").unwrap();","+    let invalid_storage = blocking_file.join(\"sub-directory\");","+","+    let mut config = config_for(\"http://upstream.invalid\", tmp.path().to_path_buf());","+    config.storage.hosted_dir = invalid_storage;","+    let app = router(config);","+","+    // /-/ready returns 503 Service Unavailable when storage check fails","+    let ready = app","+        .clone()","+        .oneshot(","+            Request::get(\"/-/ready\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(ready.status(), StatusCode::SERVICE_UNAVAILABLE);","+    let ready_body: Value = serde_json::from_slice(&body_bytes(ready.into_body()).await).unwrap();","+    assert_eq!(ready_body[\"status\"], \"unhealthy\");","+    assert_eq!(ready_body[\"storage\"], \"unavailable\");","+    assert_eq!(ready_body[\"auth\"], \"ok\");","+","+    // /-/ping also returns 503 Service Unavailable when readiness fails","+    let ping = app","+        .oneshot(","+            Request::get(\"/-/ping\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(ping.status(), StatusCode::SERVICE_UNAVAILABLE);","+}","+","+#[tokio::test]","+async fn readiness_probe_fails_when_auth_is_inaccessible() {","+    let tmp = tempfile::tempdir().unwrap();","+    let tokens_path = tmp.path().join(\"tokens.db\");","+","+    let mut config = config_for(\"http://upstream.invalid\", tmp.path().to_path_buf());","+    config.identity.auth.tokens.file = Some(tokens_path.clone());","+    let auth = pnpr_auth::AuthState::load(&config.identity.auth, &config.identity.backend)","+        .await","+        .unwrap();","+    let app = pnpr::router_with_auth(config, auth);","+","+    // Remove the tokens database file so token store readiness fails","+    std::fs::remove_file(&tokens_path).unwrap();","+","+    // /-/ready returns 503 Service Unavailable when auth check fails","+    let ready = app","+        .clone()","+        .oneshot(","+            Request::get(\"/-/ready\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(ready.status(), StatusCode::SERVICE_UNAVAILABLE);","+    let ready_body: Value = serde_json::from_slice(&body_bytes(ready.into_body()).await).unwrap();","+    assert_eq!(ready_body[\"status\"], \"unhealthy\");","+    assert_eq!(ready_body[\"storage\"], \"ok\");","+    assert_eq!