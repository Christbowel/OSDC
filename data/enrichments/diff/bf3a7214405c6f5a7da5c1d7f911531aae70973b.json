t(input.text()).isEqualTo(\"ax\" + FAMILY + \"b\");","+","+        // Delete takes the whole family","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.DELETE));","+        assertThat(input.text()).isEqualTo(\"axb\");","+","+        // Backspace takes a flag, then a family, each whole","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.END));","+        input.insert(FAMILY + \"🇫🇷\");","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.BACKSPACE));","+        assertThat(input.text()).isEqualTo(\"axb\" + FAMILY);","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.BACKSPACE));","+        assertThat(input.text()).isEqualTo(\"axb\");","+    }","+","+    @Test","+    void upAndDownKeepTheColumnOnTheScreenAndNeverLandInsideAnEmoji() {","+        AiInputLine input = new AiInputLine();","+        input.insert(\"abcdef\\n\" + FAMILY + FAMILY + \"x\");","+","+        // after the two families, four columns in: Up goes to after the d","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.HOME));","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.RIGHT));","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.RIGHT));","+        assertThat(input.moveCursorLine(-1)).isTrue();","+        input.handleEditKey(KeyEvent.ofChar('|'));","+        assertThat(input.text()).isEqualTo(\"abcd|ef\\n\" + FAMILY + FAMILY + \"x\");","+","+        // three columns in: Down goes to after the first family, not into the second","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.BACKSPACE));","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.LEFT));","+        assertThat(input.moveCursorLine(1)).isTrue();","+        input.handleEditKey(KeyEvent.ofChar('|'));","+        assertThat(input.text()).isEqualTo(\"abcdef\\n\" + FAMILY + \"|\" + FAMILY + \"x\");","+    }","+","+    @Test","+    void theCursorMarksTheWholeEmojiUnderIt() {","+        AiInputLine input = new AiInputLine();","+        input.insert(\"a\" + FAMILY + \"b\");","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.LEFT));","+        input.handleEditKey(KeyEvent.ofKey(KeyCode.LEFT));","+","+        Buffer buffer = render(input, 20);","+","+        // after the \"> \" prompt and the a: the family in one reversed cell, then the b","+        assertThat(buffer.get(3, 0).symbol()).isEqualTo(FAMILY);","+        assertThat(buffer.get(3, 0).style().effectiveModifiers()).contains(Modifier.REVERSED);","+        assertThat(buffer.get(5, 0).symbol()).isEqualTo(\"b\");","+        assertThat(buffer.get(5, 0).style().effectiveModifiers()).doesNotContain(Modifier.REVERSED);","+    }","+","+    @Test","+    void aLongLineScrollsByColumnsAndCutsNoEmoji() {","+        AiInputLine input = new AiInputLine();"],"additions":108,"deletions":0,"truncated":false}],"additions":238,"deletions":82,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-18T13:00:59.947941+00:00"}