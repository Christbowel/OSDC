{"id":"aa134b0cc7c46ff24e8405e327787a8606997035","axis":"silent","repo":"grafana/grafana","sha":"aa134b0cc7c46ff24e8405e327787a8606997035","parsed":{"files":[{"path":".github/CODEOWNERS","lines":["@@ -754,6 +754,7 @@ i18next.config.ts @grafana/grafana-frontend-platform"," /packages/grafana-ui/src/components/DataLinks/ @grafana/dataviz-squad"," /packages/grafana-ui/src/components/RadialGauge/ @grafana/dataviz-squad"," /packages/grafana-ui/src/components/PluginSignatureBadge/ @grafana/grafana-catalog","+/packages/grafana-ui/src/components/SanitizedSVG/ @grafana/dataviz-squad"," /packages/grafana-ui/src/components/Sparkline/ @grafana/dataviz-squad"," /packages/grafana-ui/src/components/Table/ @grafana/dataviz-squad"," /packages/grafana-ui/src/components/Table/Cells/SparklineCell.tsx @grafana/dataviz-squad","@@ -907,7 +908,6 @@ playwright.storybook.config.ts @grafana/grafana-frontend-platform"," /public/app/core/components/Signup/ @grafana/grafana-frontend-navigation"," /public/app/core/components/SplashScreenModal/ @grafana/grafana-frontend-platform"," /public/app/core/components/SplitPaneWrapper/ @grafana/datapro","-/public/app/core/components/SVG/ @grafana/dataviz-squad"," /public/app/core/components/TagFilter/ @grafana/grafana-frontend-platform"," /public/app/core/components/Theme/ @grafana/grafana-frontend-platform"," /public/app/core/components/ThemeSelector/ @grafana/grafana-frontend-platform"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/grafana-data/src/text/sanitize.ts","lines":["@@ -113,6 +113,29 @@ function sanitizeSVGContent(unsanitizedString: string): string {","   return DOMPurify.sanitize(unsanitizedString, { USE_PROFILES: { svg: true, svgFilters: true } });"," }"," ","+// Attributes on the outermost <svg> that let it paint outside its own layout box,","+// e.g. style=\"position:fixed;inset:0;z-index:9999\" or transform=\"scale(100)\" to cover the page.","+const UNTRUSTED_SVG_ROOT_FORBID_ATTR = ['style', 'transform', 'overflow'];","+","+// Like sanitizeSVGContent, but for SVGs that do not ship with Grafana","+// Inlined SVG <style> applies to the whole document, and <image>/<feImage> pull in content this sanitizer","+// never inspects, so they are removed.","+function sanitizeUntrustedSVGContent(unsanitizedString: string): string {","+  const fragment = DOMPurify.sanitize(unsanitizedString, {","+    USE_PROFILES: { svg: true, svgFilters: true },","+    FORBID_TAGS: ['style', 'image', 'feImage'],","+    RETURN_DOM_FRAGMENT: true,","+  });","+","+  const container = document.createElement('div');","+  container.appendChild(fragment);","+  for (const root of container.querySelectorAll(':scope > svg')) {","+    UNTRUSTED_SVG_ROOT_FORBID_ATTR.forEach((attr) => root.removeAttribute(attr));","+  }","+","+  return container.innerHTML;","+}","+"," // Return a sanitized URL, free from XSS attacks, such as javascript:alert(1)"," export function sanitizeUrl(url: string): string {","   return braintreeSanitizeUrl(url);","@@ -186,6 +209,7 @@ export const textUtil = {","   sanitizeTextPanelContent,","   sanitizeUrl,","   sanitizeSVGContent,","+  sanitizeUntrustedSVGContent,","   sanitizeTrustedTypes,","   sanitizeTrustedTypesRSS,"," };"],"additions":24,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/SanitizedSVG/SanitizedSVG.mdx","lines":["@@ -0,0 +1,24 @@","+import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';","+import { SanitizedSVG } from './SanitizedSVG';","+","+<Meta title=\"MDX|SanitizedSVG\" component={SanitizedSVG} />","+","+# SanitizedSVG","+","+> **Unstable:** exported from `@grafana/ui/unstable` and only for use in Grafana core. Its props can change without notice. Do not use it in plugins yet.","+","+Renders an SVG inline with [react-inlinesvg](https://github.com/gilbarbara/react-inlinesvg) after sanitizing its markup. Use it instead of `react-inlinesvg` directly whenever the `src` can come from a user, a dashboard, or a plugin.","+","+SVGs that ship with Grafana (under `public/build/` and `public/img/`) keep their styles. Every other source is sanitized with stricter rules.","+","+## Usage","+","+```tsx","+<SanitizedSVG src=\"public/img/icons/marker/circle.svg\" className={styles.icon} />","+```","+","+SVGs from other sources lose their `<style>`, `<image>` and `<feImage>` elements, and the outermost `<svg>` loses its `style`, `transform` and `overflow` attributes. To style these SVGs, use inline `style` attributes on the shapes inside the SVG.","+","+Pass `cleanStyle` to scope the embedded `<style type=\"text/css\">` rules of a Grafana-shipped SVG to that SVG, so they do not leak to the rest of the page.","+","+<ArgTypes of={SanitizedSVG} />"],"additions":24,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/SanitizedSVG/SanitizedSVG.story.tsx","lines":["@@ -0,0 +1,40 @@","+import { type Meta, type StoryFn } from '@storybook/react';","+","+import { SanitizedSVG } from './SanitizedSVG';","+import mdx from './SanitizedSVG.mdx';","+","+const meta: Meta<typeof SanitizedSVG> = {","+  title: 'Iconography/SanitizedSVG',","+  component: SanitizedSVG,","+  parameters: {","+    docs: {","+      page: mdx,","+    },","+    controls: {","+      include: ['src', 'cleanStyle', 'width', 'height'],","+    },","+  },","+  args: {","+    src: 'public/build/img/icons/unicons/cloud.svg',","+    cleanStyle: false,","+    width: 48,","+    height: 48,","+  },","+};","+","+export const Basic: StoryFn<typeof SanitizedSVG> = (args) => <SanitizedSVG {...args} />;","+","+export const InlineMarkup: StoryFn<typeof SanitizedSVG> = (args) => <SanitizedSVG {...args} />;","+InlineMarkup.args = {","+  src: '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><style>circle{fill:red}</style><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"currentColor\"/></svg>',","+};","+InlineMarkup.parameters = {","+  docs: {","+    description: {","+      story:","+        'Markup passed as `src` is not a Grafana asset, so its `<style>` element is removed. The circle uses its `fill` attribute instead of the red style.',","+    },","+  },","+};","+","+export default meta;"],"additions":40,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/SanitizedSVG/SanitizedSVG.test.tsx","lines":["rename from public/app/core/components/SVG/SanitizedSVG.test.tsx","rename to packages/grafana-ui/src/components/SanitizedSVG/SanitizedSVG.test.tsx"],"additions":0,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/SanitizedSVG/SanitizedSVG.tsx","lines":["@@ -0,0 +1,63 @@","+import { useCallback } from 'react';","+import SVG, { type Props } from 'react-inlinesvg';","+","+import { textUtil } from '@grafana/data';","+","+import { svgStyleCleanup } from './utils';","+","+type SanitizedSVGProps = Props & { cleanStyle?: boolean };","+","+export const SanitizedSVG = (props: SanitizedSVGProps) => {","+  const { cleanStyle, ...inlineSvgProps } = props;","+  const trusted = isTrustedSVGSource(inlineSvgProps.src);","+  const preProcessor = useCallback(","+    (code: string) => getCleanSVG(code, trusted, Boolean(cleanStyle)),","+    [trusted, cleanStyle]","+  );","+  return <SVG {...inlineSvgProps} cacheRequests={true} preProcessor={preProcessor} />;","+};","+","+// Only SVGs that ship with Grafana (public/build and public/img) may keep <style>.","+// Everything else under the public path, such as public/plugins, can come from third parties.","+// react-inlinesvg uses `src` as markup when it contains `<svg` or is a data: URL, so those are never trusted.","+const TRUSTED_PUBLIC_DIRS = ['build/', 'img/'];","+","+export function isTrustedSVGSource(src: unknown): boolean {","+  if (typeof src !== 'string' || src.includes('<') || src.trim().toLowerCase().startsWith('data:')) {","+    return false;","+  }","+","+  try {","+    const publicPath = new URL(window.__grafana_public_path__ || 'public/', document.baseURI);","+    const url = new URL(src, document.baseURI);","+    return (","+      (url.protocol === 'http:' || url.protocol === 'https:') &&","+      url.origin === publicPath.origin &&","+      TRUSTED_PUBLIC_DIRS.some((dir) => url.pathname.startsWith(publicPath.pathname + dir))","+    );","+  } catch {","+    return false;","+  }","+}","+","+let cache = new Map<string, string>();","+","+// Untrusted SVGs never keep <style>, so cleanStyle only applies to trusted ones.","+function getCleanSVG(code: string, trusted: boolean, cleanStyle: boolean): string {","+  const key = trusted ? `t${cleanStyle ? 's' : ''}:${code}` : `u:${code}`;","+  let clean = cache.get(key);","+  if (!clean) {","+    if (trusted) {","+      clean = textUtil.sanitizeSVGContent(code);","+      if (cleanStyle && clean.indexOf('<style type=\"text/css\">') > -1) {","+        clean = svgStyleCleanup(clean);","+      }","+    } else {","+      clean = textUtil.sanitizeUntrustedSVGContent(code);","+    }","+","+    cache.set(key, clean);","+  }","+","+  return clean;","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/SanitizedSVG/SanitizedSVGSource.test.tsx","lines":["@@ -0,0 +1,87 @@","+import { render } from '@testing-library/react';","+","+import { textUtil } from '@grafana/data';","+","+import { isTrustedSVGSource, SanitizedSVG } from './SanitizedSVG';","+","+const mockPreProcessors: Array<(code: string) => string> = [];","+","+jest.mock('react-inlinesvg', () => (props: { preProcessor: (code: string) => string }) => {","+  mockPreProcessors.push(props.preProcessor);","+  return null;","+});","+","+const payload =","+  '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 10 10\"><style>body{outline:5px solid red}</style><image href=\"https://evil.example/img\"/><filter><feImage href=\"https://evil.example/fe\"/></filter><rect width=\"10\" height=\"10\"/></svg>';","+","+const buildImg = 'public/build/img/';","+","+describe('isTrustedSVGSource', () => {","+  it.each([","+    ['public/build/img/icons/unicons/cloud.svg'],","+    [`/${buildImg}icons/unicons/cloud.svg`],","+    [`${window.location.origin}/${buildImg}bg.svg`],","+    [`public/${'img'}/icons/marker/circle.svg`],","+  ])('trusts Grafana public assets: %s', (src) => {","+    expect(isTrustedSVGSource(src)).toBe(true);","+  });","+","+  it.each([","+    ['https://evil.example/icon.svg'],","+    [`${window.location.origin}/api/somewhere.svg`],","+    ['public/plugins/some-plugin/img/logo.svg'],","+    ['public/build/../plugins/some-plugin/img/logo.svg'],","+    ['data:image/svg+xml,%3Csvg%3E%3C/svg%3E'],","+    [payload],","+    [`public/build/${payload}`],","+    [undefined],","+  ])('does not trust %s', (src) => {","+    expect(isTrustedSVGSource(src)).toBe(false);","+  });","+});","+","+describe('sanitizeUntrustedSVGContent', () => {","+  it('removes style, image and feImage but keeps the shapes', () => {","+    const clean = textUtil.sanitizeUntrustedSVGContent(payload);","+    expect(clean).not.toMatch(/<style|<image|<feImage|evil\\.example/i);","+    expect(clean).toContain('<rect');","+  });","+","+  it('removes attributes that let the root svg paint outside its box', () => {","+    const overlay =","+      '<svg xmlns=\"http://www.w3.org/2000/svg\" style=\"position:fixed;inset:0;z-index:9999\" transform=\"scale(100)\" overflow=\"visible\"><rect style=\"fill:red\" width=\"10\" height=\"10\"/></svg>';","+    const root = new DOMParser()","+      .parseFromString(textUtil.sanitizeUntrustedSVGContent(overlay), 'text/html')","+      .querySelector('svg');","+    expect(root?.hasAttribute('style')).toBe(false);","+    expect(root?.hasAttribute('transform')).toBe(false);","+    expect(root?.hasAttribute('overflow')).toBe(false);","+    expect(root?.querySelector('rect')?.getAttribute('style')).toBe('fill:red');","+  });","+});","+","+describe('SanitizedSVG', () => {","+  const lastPreProcessor = () => mockPreProcessors[mockPreProcessors.length - 1];","+","+  beforeEach(() => {","+    mockPreProcessors.length = 0;","+  });","+","+  it('strips <style> and <image> when src is inline markup', () => {","+    render(<SanitizedSVG src={payload} />);","+    expect(lastPreProcessor()(payload)).not.toMatch(/<style|<image/);","+  });","+","+  it('keeps <style> for Grafana public assets', () => {","+    render(<SanitizedSVG src=\"public/build/img/icons/unicons/cloud.svg\" />);","+    expect(lastPreProcessor()(payload)).toContain('<style>');","+  });","+","+  it('passes the same preProcessor across re-renders', () => {","+    const src = 'public/build/img/icons/unicons/cloud.svg';","+    const { rerender } = render(<SanitizedSVG src={src} />);","+    rerender(<SanitizedSVG src={src} className=\"other\" />);","+    expect(mockPreProcessors).toHaveLength(2);","+    expect(mockPreProcessors[0]).toBe(mockPreProcessors[1]);","+  });","+});"],"additions":87,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/SanitizedSVG/utils.ts","lines":["rename from public/app/core/components/SVG/utils.ts","rename to packages/grafana-ui/src/components/SanitizedSVG/utils.ts"],"additions":0,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/unstable.ts","lines":["@@ -40,3 +40,4 @@ export type { QueryFieldConfig, QueryFieldConfigOptions } from './components/Que"," export { TableNG } from './components/Table/TableNG/TableNG';"," export { RangeSliderG14 } from './components/Slider/RangeSliderG14';"," export type { RangeSliderG14Props } from './components/Slider/types';","+export { SanitizedSVG } from './components/SanitizedSVG/SanitizedSVG';"],"additions":1,"deletions":0,"truncated":false},{"path":"public/app/core/components/SVG/SanitizedSVG.tsx","lines":["@@ -1,39 +0,0 @@","-import SVG, { type Props } from 'react-inlinesvg';","-","-import { textUtil } from '@grafana/data';","-","-import { svgStyleCleanup } from './utils';","-","-type SanitizedSVGProps = Props & { cleanStyle?: boolean };","-","-export const SanitizedSVG = (props: SanitizedSVGProps) => {","-  const { cleanStyle, ...in