hasCloudWorkspace = cloudWorkspaceNum !== undefined","+","+  if (!hasCloudWorkspace) {","+    return url","+  }","+","+  const parsed = new URL(url)","+  const isLocalhost = parsed.hostname === 'localhost'","+","+  if (!isLocalhost) {","+    return url","+  }","+","+  const defaultPort = parsed.protocol === 'https:' ? 443 : 80","+  const port = Number(parsed.port || defaultPort) + cloudWorkspaceNum * 10000","+  const isValidPort = port <= 65535","+","+  if (!isValidPort) {","+    throw new Error(`CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM=${cloudWorkspaceNum} produces an invalid localhost port: ${port}`)","+  }","+","+  // Keep the input's exact URL spelling; URL serialization can add a trailing slash.","+  return url.replace(/^(https?:\\/\\/localhost)(?::\\d+)?(?=\\/|$|\\?|#)/i, `$1:${port}`)","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"packages/config/src/index.ts","lines":["@@ -8,4 +8,6 @@ export { addProjectIdToCypressConfig, addToCypressConfig, addTestingTypeToCypres"," "," export * from './utils'"," ","+export * from './developmentCloudWorkspaceUrl'","+"," export { isUnsafePort } from './unsafe_ports'"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/config/src/project/utils.ts","lines":["@@ -94,6 +94,7 @@ const CYPRESS_ENV_PREFIX_LENGTH = CYPRESS_ENV_PREFIX.length"," // Names the app reads itself, which are not settings for the project's tests"," const CYPRESS_RESERVED_ENV_VARS = [","   'CYPRESS_INTERNAL_ENV',","+  'CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM',","   'CYPRESS_AGENT_MODE',"," ]"," "],"additions":1,"deletions":0,"truncated":false},{"path":"packages/config/test/developmentCloudWorkspaceUrl.spec.ts","lines":["@@ -0,0 +1,72 @@","+import { afterEach, describe, expect, it, vi } from 'vitest'","+import { resolveDevelopmentCloudWorkspaceNumber, resolveDevelopmentCloudWorkspaceUrl } from '../src/developmentCloudWorkspaceUrl'","+","+describe('resolveDevelopmentCloudWorkspaceNumber', () => {","+  it.each([1, 2, 3, 4, 5])('resolves development workspace %s', (workspace) => {","+    expect(resolveDevelopmentCloudWorkspaceNumber('development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: String(workspace) })).toBe(workspace)","+  })","+","+  it.each([undefined, '0'])('returns no workspace when the selector is %s', (workspace) => {","+    expect(resolveDevelopmentCloudWorkspaceNumber('development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: workspace })).toBeUndefined()","+  })","+","+  it.each(['production', 'staging', 'test', undefined])('ignores the selector in %s', (environment) => {","+    expect(resolveDevelopmentCloudWorkspaceNumber(environment, { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: '4' })).toBeUndefined()","+    expect(resolveDevelopmentCloudWorkspaceNumber(environment, { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: 'invalid' })).toBeUndefined()","+  })","+","+  it('rejects an invalid development workspace', () => {","+    expect(() => resolveDevelopmentCloudWorkspaceNumber('development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: '7' })).toThrow('CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM must be an integer from 0 to 5')","+  })","+})","+","+describe('resolveDevelopmentCloudWorkspaceUrl', () => {","+  afterEach(() => {","+    vi.unstubAllEnvs()","+  })","+","+  it.each([[0, 3000, 1234], [1, 13000, 11234], [2, 23000, 21234], [3, 33000, 31234], [4, 43000, 41234], [5, 53000, 51234]])('routes workspace %s to the expected localhost ports', (workspace, dashboardPort, apiPort) => {","+    const env = { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: String(workspace) }","+","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:3000', 'development', env)).toBe(`http://localhost:${dashboardPort}`)","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:1234/', 'development', env)).toBe(`http://localhost:${apiPort}/`)","+  })","+","+  it.each([undefined, '0'])('keeps default ports when the workspace is %s', (workspace) => {","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:3000', 'development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: workspace })).toBe('http://localhost:3000')","+  })","+","+  it.each(['', '6', '7', '-1', '4.5', '04', '4e0', '4abc', ' 4 ', 'NaN', 'Infinity'])('rejects malformed workspace %s in development', (workspace) => {","+    expect(() => resolveDevelopmentCloudWorkspaceUrl('http://localhost:3000', 'development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: workspace })).toThrow(","+      `CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM must be an integer from 0 to 5; received ${JSON.stringify(workspace)}`,","+    )","+  })","+","+  it.each(['production', 'staging', 'test', undefined])('ignores the selector for the %s environment', (environment) => {","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:1234/', environment, { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: '4' })).toBe('http://localhost:1234/')","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:1234/', environment, { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: 'invalid' })).toBe('http://localhost:1234/')","+  })","+","+  it('keeps non-localhost URLs unchanged', () => {","+    const url = 'https://api.cypress.io/'","+","+    expect(resolveDevelopmentCloudWorkspaceUrl(url, 'development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: '4' })).toBe(url)","+  })","+","+  it('preserves paths, query strings, fragments, and the trailing slash', () => {","+    const env = { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: '4' }","+","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:3000/path/?next=%2Ffoo#section', 'development', env)).toBe('http://localhost:43000/path/?next=%2Ffoo#section')","+    expect(resolveDevelopmentCloudWorkspaceUrl('http://localhost:3000?next=%2Ffoo', 'development', env)).toBe('http://localhost:43000?next=%2Ffoo')","+  })","+","+  it('rejects offsets that exceed the TCP port range', () => {","+    expect(() => resolveDevelopmentCloudWorkspaceUrl('http://localhost:20000', 'development', { CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM: '5' })).toThrow('inva