{"id":"9962c4fee40ebbf81632a1456f1d4fff97ea13f8","axis":"silent","repo":"cypress-io/cypress","sha":"9962c4fee40ebbf81632a1456f1d4fff97ea13f8","parsed":{"files":[{"path":"cli/lib/development-cloud-workspace.ts","lines":["@@ -0,0 +1,23 @@","+/**","+ * Returns an offset workspace for development, or undefined for the default","+ * workspace and other environments; rejects invalid development selectors. The CLI","+ * cannot import @packages/config, so keep this aligned with its resolver.","+ */","+export function resolveDevelopmentCloudWorkspaceNumber (environment: string | undefined, env: NodeJS.ProcessEnv = process.env): number | undefined {","+  const cloudWorkspaceNum = env.CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM","+  const useDevelopmentCloudWorkspace = environment === 'development' && cloudWorkspaceNum !== undefined","+","+  if (!useDevelopmentCloudWorkspace) {","+    return undefined","+  }","+","+  const isValidCloudWorkspace = /^[0-5]$/.test(cloudWorkspaceNum ?? '')","+","+  if (!isValidCloudWorkspace) {","+    throw new Error(`CYPRESS_INTERNAL_CLOUD_WORKSPACE_NUM must be an integer from 0 to 5; received ${JSON.stringify(cloudWorkspaceNum)}`)","+  }","+","+  const isDefaultCloudWorkspace = cloudWorkspaceNum === '0'","+","+  return isDefaultCloudWorkspace ? undefined : Number(cloudWorkspaceNum)","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"cli/lib/tap/events.ts","lines":["@@ -5,6 +5,7 @@ import util, { DEVELOPMENT_VERSION } from '../util'"," import { resolvedSessionIdentity } from '../cypress-sessions'"," import { detectAgent } from '@packages/agent-info'"," import type { ReportedInvocation } from './reported-invocation'","+import { resolveDevelopmentCloudWorkspaceNumber } from '../development-cloud-workspace'"," "," const debug = Debug('cypress:cli:tap')"," ","@@ -36,7 +37,11 @@ const namedCollectorEnv = (): keyof typeof CLOUD_URLS | undefined => {"," }"," "," const eventCollectorUrl = (includeMachineId = false): string => {","-  return `${CLOUD_