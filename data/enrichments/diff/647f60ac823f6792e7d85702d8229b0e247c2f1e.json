(update_selectors(&pkg.dependencies, mode, &HashMap::new())),","+        }","+    }","+","     async fn finalize_latest_runtime_selectors<Reporter: self::Reporter + 'static>(","         &self,","         pkg: &GlobalPackageInfo,","@@ -137,6 +159,7 @@ pub(super) struct GroupActivation<'a> {"," /// otherwise move backwards. `--latest` resolves the `latest` dist-tag, which"," /// points at an older release than the one installed whenever that came from"," /// another tag, or from a major that has not been promoted to `latest` yet.","+/// `--tag` resolves a tag that may likewise point at an older release."," ///"," /// The versions are resolved into `install_dir` without installing anything, so"," /// a release that is about to be rejected never gets the chance to run its","@@ -152,22 +175,19 @@ pub(super) async fn pins_for_downgrades<Reporter: self::Reporter + 'static>(","     global_pkg_dir: &Path,","     install_dir: &Path,","     pkg: &GlobalPackageInfo,","-    mode: GlobalUpdateMode,","+    (mode, target_selectors): (GlobalUpdateMode<'_>, &[String]),","     range_spec_style: RangeSpecStyle,","     supported_architectures: Option<SupportedArchitectures>,"," ) -> miette::Result<DowngradeCheck> {","-    match mode {","-        GlobalUpdateMode::DeclaredRange => {","-            return Ok(DowngradeCheck { candidate_resolved: false, pins: HashMap::new() });","-        }","-        GlobalUpdateMode::Latest => {}","+    if mode == GlobalUpdateMode::DeclaredRange {","+        return Ok(DowngradeCheck { candidate_resolved: false, pins: HashMap::new() });","     }","     let versions_before = installed_versions(&pkg.install_dir);","     // Nothing to compare a resolution against, so nothing to resolve.","     if !pkg.dependencies","         .iter()","         .any(|(alias, spec)| {","-            can_update_to_latest(alias, spec) && versions_before.contains_key(alias)","+            moves_past_declared_range(mode, alias, spec) && versions_before.contains_key(alias)","         })","     {","         return Ok(DowngradeCheck { candidate_resolved: false, pins: HashMap::new() });","@@ -176,7 +196,7 @@ pub(super) async fn pins_for_downgrades<Reporter: self::Reporter + 'static>(","         base_config,","         global_pkg_dir,","         install_dir,","-        selectors: &update_selectors(&pkg.dependencies, mode, &HashMap::new()),","+        selectors: target_selectors,","         range_spec_style,","         supported_architectures,","         allow_build: &[],","@@ -187,7 +207,7 @@ pub(super) async fn pins_for_downgrades<Reporter: self::Reporter + 'static>("," ","     let pins = pkg.dependencies","         .iter()","-        .filter(|(alias, spec)| can_update_to_latest(alias, spec))","+        .filter(|(alias, spec)| moves_past_declared_range(mode, alias, spec))","         .filter_map(|(alias, _)| {","             let before = Version::parse(versions_before.get(alias)?).ok()?;","             let now = resolved.get(alias)?;"],"additions":36,"deletions":16,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/tag_selectors.rs","lines":["@@ -0,0 +1,103 @@","+use super::{Config, State, is_registry_version_spec, warn_global};","+use derive_more::{Display, Error};","+use futures_util::future::try_join_all;","+use miette::Diagnostic;","+use pnpm_package_manager::{PickPolicy, create_configured_registry_resolver};","+use pnpm_reporter::Reporter;","+use pnpm_resolving_default_resolver::DefaultResolver;","+use pnpm_resolving_resolver_base::{","+    LatestQuery, NoMatchingVersionError, ResolveError, ResolveOptions, WantedDependency,","+};","+","+/// Resolving whether a dependency publishes the `--tag` dist-tag failed.","+#[derive(Debug, Display, Error, Diagnostic)]","+#[display(\"Failed to resolve {alias}@{tag}: {error}\")]","+#[diagnostic(code(ERR_PNPM_GLOBAL_UPDATE_TAG_RESOLUTION))]","+struct GlobalTagResolveError {","+    alias: String,","+    tag: String,","+    #[error(source)]","+    error: ResolveError,","+}","+","+/// The selectors a `--tag` update reinstalls a group with: `alias@<tag>`","+/// for every version, range, or dist-tag dependency that publishes an","+/// installable version behind the tag, and the recorded spec for every other","+/// dependency. The lookups run concurrently.","+pub(super) async fn tag_checked_selectors<Reporter: self::Reporter>(","+    base_config: &'static Config,","+    dependencies: &[(String, String)],","+    tag: &str,","+) -> miette::Result<Vec<String>> {","+    let policy = PickPolicy::from_config(base_config).map_err(miette::Report::new)?;","+    let http_client = State::new_http_client(base_config).map_err(miette::Report::new)?;","+    let resolver = create_configured_registry_resolver(base_config, http_client, &policy)","+        .map_err(miette::Report::new)?;","+    let resolve_options = tag_resolve_options(&policy);","+    try_join_all(","+        dependencies","+            .iter()","+            .map(|(alias, spec)| {","+                tag_selector::<Reporter>(&resolver, &resolve_options, alias, spec, tag)","+            }),","+    )","+    .await","+}","+","+/// `alias@<tag>` when the registry publishes an installable version behind","+/// `tag` for the dependency, the recorded spec with a warning when it does","+/// not. Every other spec form names its source and passes through unchanged.","+async fn tag_selector<Reporter: self::Reporter>(","+    resolver: &DefaultResolver,","+    resolve_options: &ResolveOptions,","+    alias: &str,","+    spec: &str,","+    tag: &str,","+) -> miette::Result<String> {","+    if !is_registry_version_spec(spec) {","+        return Ok(format!(\"{alias}@{spec}\"));","+    }","+    let query = LatestQuery {","+        wanted_dependency: WantedDependency {","+            alias: Some(alias.to_string()),","+            bare_specifier: Some(tag.to_string()),","+            ..WantedDependency::default()","+        },","+        compatible: true,","+    };","+    match resolver.resolve_latest(&query, resolve_options).await {","+        Ok(Some(latest)) if latest.latest_manifest.is_some() => Ok(format!(\"{alias}@{tag}\")),","+        // A missing tag and a tagged version a resolution policy such as","+        // `minimumReleaseAge` excludes look the same here.","+        Ok(_) => Ok(keep_spec::<Reporter>(alias, spec, tag)),","+        Err(error) if error.is::<NoMatchingVersionError>() => {","+            Ok(keep_spec::<Reporter>(alias, spec, tag))","+        }","+        Err(error) => {","+            Err(GlobalTagResolveError { alias: alias.to_string(), tag: tag.to_string(), error }","+                .into())","+        }","+    }","+}","+","+fn keep_spec<Reporter: self::Reporter>(alias: &str, spec: &str, tag: &str) -> String {","+    warn_global::<Reporter>(&format!(","+        r#\"Skipping \"{alias}\": its \"{tag}\" dist-tag names no version that can be installed, so its recorded specifier was kept.\"#,","+    ));","+    format!(\"{alias}@{spec}\")","+}","+","+fn tag_resolve_options(policy: &PickPolicy) -> ResolveOptions {","+    ResolveOptions {","+        version: pnpm_resolving_resolver_base::VersionSelectionOptions {","+            default_tag: Some(\"latest\".to_string()),","+            ..Default::default()","+        },","+        policy: pnpm_resolving_resolver_base::ResolutionPolicyOptions {","+            published_by: policy.published_by,","+            published_by_exclude: policy.published_by_exclude.clone(),","+            ..Default::default()","+        },","+        ..Default::default()","+    }","+}"],"additions":103,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/tests.rs","lines":["@@ -250,6 +250,38 @@ fn latest_update_uses_the_latest_tag_for_plain_npm_alias_and_runtime_dependencie","     );"," }"," ","+#[test]","+fn tag_update_uses_the_tag_only_for_plain_version_dependencies() {","+    let dependencies = vec![","+        (\"private-linked-pkg\".to_string(), \"link:/home/user/private-linked-pkg\".to_string()),","+        (\"aliased-pkg\".to_string(), \"npm:other-pkg@^2.0.0\".to_string()),","+        (\"named-registry-pkg\".to_string(), \"gh:^3.0.0\".to_string()),","+        (\"node\".to_string(), \"runtime:^20.0.0\".to_string()),","+        (\"git-shorthand-pkg\".to_string(), \"user/repo\".to_string()),","+        (\"relative-path-pkg\".to_string(), \"../local-pkg\".to_string()),","+        (\"foo\".to_string(), \"^1.0.0\".to_string()),","+        (\"bar\".to_string(), \"latest\".to_string()),","+    ];","+    assert_eq!(","+        update_selectors(&dependencies, GlobalUpdateMode::Tag(\"next\"), &HashMap::new()),","+        vec![","+            \"private-linked-pkg@link:/home/user/private-linked-pkg\",","+            \"aliased-pkg@npm:other-pkg@^2.0.0\",","+            \"named-registry-pkg@gh:^3.0.0\",","+            \"node@runtime:^20.0.0\",","+            \"git-shorthand-pkg@user/repo\",","+            \"relative-path-pkg@../local-pkg\",","+            \"foo@next\",","+            \"bar@next\",","+        ],","+    );","+    let pins = HashMap::from([(\"foo\".to_string(), \"1.5.0\".to_string())]);","+    assert_eq!(","+        update_selectors(&dependencies[6..], GlobalUpdateMode::Tag(\"next\"), &pins),","+        vec![\"foo@1.5.0\", \"bar@next\"],","+    );","+}","+"," #[test]"," fn latest_update_preserves_node_prerelease_channels() {","     let dependencies = vec![(\"node\".to_string(), \"runtime:22.0.0-rc.1\".to_string())];"],"additions":32,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/update_selectors.rs","lines":["@@ -2,39 +2,73 @@ use super::{","     GlobalPackageInfo, GlobalUpdateMode, HashMap, RangeSpecStyle, Version, local_file_path,","     parse_npm_spec_body,"," };","+use pnpm_lockfile_preferred_versions::get_version_selector_type;"," use pnpm_resolving_npm_resolver::calc_version_range;"," use pnpm_semver_include_prerelease::is_valid_semver_range;"," ","-/// Whether `--latest` rewrites `(alias, spec)` to a latest selector.","-pub(super) fn can_upd