: 'blog',","+    });","+  });"," });"],"additions":59,"deletions":9,"truncated":false},{"path":"packages/core/core/src/services/metrics/sender.ts","lines":["@@ -40,7 +40,7 @@ const { timeout, ...fetchDefaults } = defaultQueryOpts;","  * Add properties from the package.json strapi key in the metadata","  */"," const addPackageJsonStrapiMetadata = (metadata: Record<string, unknown>, strapi: Core.Strapi) => {","-  const { packageJsonStrapi = {} } = strapi.config;","+  const packageJsonStrapi = strapi.config.get<Record<string, unknown>>('packageJsonStrapi', {});"," ","   _.defaults(metadata, packageJsonStrapi);"," };","@@ -52,7 +52,8 @@ export default (strapi: Core.Strapi): Sender => {","   // The API test helper clears the container after a successful destroy.","   // Keep the fetch function from startup so a later send does not look it up.","   const fetch = strapi.fetch;","-  const { uuid, installId: installIdFromPackageJson } = strapi.config;","+  const uuid = strapi.config.get<string | undefined>('uuid');","+  const installIdFromPackageJson = strapi.config.get<string | undefined>('installId');"," ","   const installId = generateInstallId(uuid, installIdFromPackageJson);"," ","@@ -60,7 +61,7 @@ export default (strapi: Core.Strapi): Sender => {","   const adminRootPath = path.join(strapi.dirs.app.root, 'src', 'admin');"," ","   const anonymousUserProperties = {","-    environment: strapi.config.environment,","+    environment: strapi.config.get('environment'),","     os: os.type(),","     osPlatform: os.platform(),","     osArch: os.arch(),"],"additions":4,"deletions":3,"truncated":false},{"path":"packages/core/core/src/utils/__tests__/startup-logger.vitest.test.ts","lines":["@@ -0,0 +1,56 @@","+import { afterEach, describe, expect, it, vi } from 'vitest';","+import type { Core } from '@strapi/types';","+","+import { createStartupLogger } from '../startup-logger';","+import { createConfigProvider } from '../../services/config';","+","+const captureLogStats = (config: Core.ConfigProvider) => {","+  const lines: string[] = [];","+  vi.spyOn(console, 'log').mockImplementation((...args: unknown[]) => {","+    lines.push(args.join(' '));","+  });","+","+  createStartupLogger({ config, EE: false } as unknown as Core.Strapi).logStats();","+","+  return lines.join('\\n');","+};","+","+describe('startup logger', () => {","+  afterEach(() => {","+    vi.restoreAllMocks();","+  });","+","+  it('prints the environment, version and launch time from the config', () => {","+    vi.spyOn(Date, 'now').mockReturnValue(1_500);","+    const output = captureLogStats(","+      createConfigProvider({","+        launchedAt: 1_000,","+        environment: 'staging',","+        info: { strapi: '5.0.0' },","+      })","+    );","+","+    expect(output).toContain('500 ms');","+    expect(output).toContain('staging');","+    expect(output).toContain(`5.0.0 (node ${process.version})`);","+  });","+","+  it('prints values written with set after the config was created', () => {","+    vi.spyOn(Date, 'now').mockReturnValue(1_500);","+    const config = createConfigProvider({","+      launchedAt: 0,","+      environment: 'development',","+      info: { strapi: '0.0.0' },","+    });","+    config.set('launchedAt', 1_000);","+    config.set('environment', 'staging');","+    // Replace the whole `info` object: a nested `set('info.strapi', …)` would also reach the copy","+    config.set('info', { strapi: '5.0.0' });","+","+    const output = captureLogStats(config);","+","+    expect(output).toContain('500 ms');","+    expect(output).toContain('staging');","+    expect(output).toContain(`5.0.0 (node ${process.version})`);","+  });","+});"],"additions":56,"deletions":0,"truncated":false},{"path":"packages/core/core/src/utils/startup-logger.ts","lines":["@@ -46,10 +46,13 @@ export const createStartupLogger = (app: Core.Strapi) => {"," ","       infoTable.push(","         [chalk.blue('Time'), `${new Date()}`],","-        [chalk.blue('Launched in'), `${Date.now() - app.config.launchedAt} ms`],","-        [chalk.blue('Environment'), app.config.environment],","+        [chalk.blue('Launched in'), `${Date.now() - app.config.get<number>('launchedAt')} ms`],","+        [chalk.blue('Environment'), app.config.get<string>('environment')],","         [chalk.blue('Process PID'), process.pid],","-        [chalk.blue('Version'), `${app.config.info.strapi} (node ${process.version})`],","+        [","+          chalk.blue('Version'),","+          `${app.config.get<string>('info.strapi')} (node ${process.version})`,","+        ],","         [chalk.blue('Plan'), getPlan()],","         [chalk.blue('Database'), dbInfo?.client],","         [chalk.blue('Database name'), dbInfo?.displayName]"],"additions":6,"deletions":3,"truncated":false},{"path":"packages/core/strapi/src/cli/commands/__tests__/config-reads.test.ts","lines":["@@ -0,0 +1,136 @@","+import REPL from 'repl';","+import { get } from 'lodash';","+import { createStrapi } from '@strapi/core';","+","+import { action as reportAction } from '../report';","+import { action as consoleAction } from '../console';","+","+jest.mock('repl', () => ({ start: jest.fn() }));","+jest.mock('@strapi/core', () => ({","+  compileStrapi: jest.fn(async () => ({})),","+  createStrapi: jest.fn(),","+}));","+","+/**","+ * Mirrors the config provider: the startup copy as own keys, plus `get` over the live tree.","+ * `liveValues` stands for what `set` wrote after startup; only `get` sees it.","+ */","+const createConfig = (startupValues: object, liveValues: object = startupValues) => ({","+  ...startupValues,","+  get: (path: string, defaultValue?: unknown) => get(liveValues, path, defaultValue),","+});","+","+const mockApp = (config: ReturnType<typeof createConfig>) => {","+  const app = {","+    config,","+    EE: false,","+    destroy: jest.fn(),","+    start: jest.fn(async () => undefined),","+  };","+  const register = jest.fn(async () => app);","+  const load = jest.fn(async () => app);","+  jest.mocked(create