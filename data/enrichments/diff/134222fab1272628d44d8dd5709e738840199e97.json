)","+\t\t\t\tsrv.Shutdown()","+\t\t\t\tsrv.WaitForShutdown()","+\t\t\t}","+\t\t\tsrv = startLifecycleServer(t, port, \"right-token\")","+\t\t\tassertDelivery := func(message string) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Eventually(t, func() bool { return pub.Health(t.Context()) == nil && sub.Health(t.Context()) == nil }, 10*time.Second, 10*time.Millisecond)","+\t\t\t\twaitSubscriberReady(t, t.Context(), subscription)","+\t\t\t\trequire.NoError(t, pub.Publish(t.Context(), \"test\", []byte(message)))","+\t\t\t\tselect {","+\t\t\t\tcase got := <-received:","+\t\t\t\t\trequire.Equal(t, message, got)","+\t\t\t\tcase <-time.After(5 * time.Second):","+\t\t\t\t\tt.Fatal(\"subscription did not receive message\")","+\t\t\t\t}","+\t\t\t\tcurrentPub, err := pub.get(t.Context())","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tcurrentSub, err := sub.get(t.Context())","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Same(t, pubConn, currentPub)","+\t\t\t\trequire.Same(t, subConn, currentSub)","+\t\t\t}","+\t\t\tassertDelivery(\"initial recovery\")","+\t\t\tsrv.Shutdown()","+\t\t\tsrv.WaitForShutdown()","+\t\t\trequire.Eventually(t, func() bool { return pubConn.IsReconnecting() && subConn.IsReconnecting() }, 5*time.Second, 10*time.Millisecond)","+\t\t\trequire.Error(t, pub.Health(t.Context()))","+\t\t\trequire.Error(t, sub.Health(t.Context()))","+\t\t\trequire.Equal(t, services.Running, pub.State())","+\t\t\trequire.Equal(t, services.Running, sub.State())","+\t\t\tstartLifecycleServer(t, port, \"right-token\")","+\t\t\tassertDelivery(\"subscription restored\")","+\t\t\trequire.Eventually(t, func() bool { return reconnects.Load() > 0 }, time.Second, time.Millisecond)","+\t\t})","+\t}","+}","+","+func TestConnectionEmbeddedStartup(t *testing.T) {","+\tfor _, role := range []connRole{rolePublisher, roleSubscriber} {","+\t\tt.Run(string(role), func(t *testing.T) {","+\t\t\tserver := &Server{cfg: setting.NATSSettings{Enabled: true, Mode: setting.NATSModeEmbedded}}","+\t\t\tcfg :=