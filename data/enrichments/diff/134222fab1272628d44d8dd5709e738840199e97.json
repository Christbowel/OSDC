) {","+\t\t\t\t\tsrv := startTestServer(t)","+\t\t\t\t\tc, svc, _ := newTestClient(t, role, newTestConfig(srv, setting.NATSSettings{Enabled: true}))","+\t\t\t\t\tctx, cancel := context.WithCancel(t.Context())","+\t\t\t\t\tdefer cancel()","+\t\t\t\t\tstartService(t, ctx, svc)","+\t\t\t\t\tswitch stop {","+\t\t\t\t\tcase \"service stop\":","+\t\t\t\t\t\tsvc.StopAsync()","+\t\t\t\t\tcase \"owner close\":","+\t\t\t\t\t\tc.close()","+\t\t\t\t\tcase \"canceled before closed callback\":","+\t\t\t\t\t\tnc, err := c.get(t.Context())","+\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\tentered, release := make(chan struct{}), make(chan struct{})","+\t\t\t\t\t\tunblock := sync.OnceFunc(func() { close(release) })","+\t\t\t\t\t\tt.Cleanup(unblock)","+\t\t\t\t\t\tclosed := nc.ClosedHandler()","+\t\t\t\t\t\tnc.SetClosedHandler(func(nc *natsclient.Conn) {","+\t\t\t\t\t\t\tclose(entered)","+\t\t\t\t\t\t\t<-release","+\t\t\t\t\t\t\tclosed(nc)","+\t\t\t\t\t\t})","+\t\t\t\t\t\tnc.Close()","+\t\t\t\t\t\tselect {","+\t\t\t\t\t\tcase <-entered:","+\t\t\t\t\t\tcase <-time.After(time.Second):","+\t\t\t\t\t\t\tt.Fatal(\"closed callback did not start\")","+\t\t\t\t\t\t}","+\t\t\t\t\t\tcancel()","+\t\t\t\t\t\tunblock()","+\t\t\t\t\t}","+\t\t\t\t\tstoppedCtx, stopCancel := context.WithTimeout(t.Context(), 5*time.Second)","+\t\t\t\t\tdefer stopCancel()","+\t\t\t\t\trequire.NoError(t, svc.AwaitTerminated(stoppedCtx))","+\t\t\t\t\trequire.Equal(t, services.Terminated, svc.State())","+\t\t\t\t\trequire.Nil(t, svc.FailureCase())","+\t\t\t\t})","+\t\t\t}","+","+\t\t\tt.Run(\"reports last connection error\", func(t *testing.T) {","+\t\t\t\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tt.Cleanup(func() { _ = listener.Close() })","+\t\t\t\tpeer := make(chan net.Conn, 1)","+\t\t\t\tserverDone := make(chan struct{})","+\t\t\t\tgo func() {","+\t\t\t\t\tdefer close(serverDone)","+\t\t\t\t\tconn, err := listener.Accept()","+\t\t\t\t\tif err != nil {","+\