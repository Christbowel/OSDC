ergeAllChunksOnShard never merges across zone boundaries, and with one zone per","@@ -128,18 +119,11 @@ describe(\"chunk operations serialize with the create collection critical section","                 // is unaffected by the critical section held on the shard.","                 this.removeZoneRanges(this.ns);"," ","-                chunkOpShell = startParallelShell(","-                    funWithArgs(function (cmd) {","-                        // TODO (SERVER-133735): with setAllowChunkOperations: false, the chunk","-                        // operations will likely fail instead of serializing.","-                        assert.commandWorked(db.adminCommand(cmd));","-                    }, chunkOpCmd),","-                    this.st.s.port,","+                assert.commandFailedWithCode(","+                    this.st.s.adminCommand(chunkOpCmd),","+                    ErrorCodes.ConflictingOperationInProgress,","                 );"," ","-                // The chunk operation must wait for the critical section instead of committing or","-                // giving up.","-                sleep(kBlockedWindowMS);","                 assert.eq(","                     kNumInitialChunks,","                     this.countChunks(this.ns),","@@ -148,13 +132,10 @@ describe(\"chunk operations serialize with the create collection critical section","             } finally {","                 hangCreate.off();","                 createShell();","-                if (chunkOpShell) {","-                    chunkOpShell();","-                }","             }"," ","-            // TODO (SERVER-133735): with setAllowChunkOperations: false, the chunk operations will","-            // likely fail instead of serializing.","+            // After create finishes, the chunk operation does work.","+            assert.commandWorked(this.st.s.adminCommand(chunkOpCmd));","             assert.eq(expectedNumChunksAfterwards, this.countChunks(this.ns));","         };","     });","@@ -192,