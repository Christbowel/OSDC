DefaultCamelContext();","+        context.getComponent(\"google-calendar\", GoogleCalendarComponent.class)","+                .setClientFactory(new OAuthClientFactory(transport));","+        context.start();","+        return context;","+    }","+","+    /**","+     * Creates the client with the OAuth credential as the client factory of the component does, on a transport that","+     * records the requests.","+     */","+    private static final class OAuthClientFactory implements GoogleCalendarClientFactory {","+","+        private final JsonFactory jsonFactory = GsonFactory.getDefaultInstance();","+        private final MockHttpTransport transport;","+","+        private OAuthClientFactory(MockHttpTransport transport) {","+            this.transport = transport;","+        }","+","+        @Override","+        public Calendar makeClient(","+                String clientId, String clientSecret, Collection<String> scopes, String applicationName, String refreshToken,","+                String accessToken, String emailAddress, String p12FileName, String user) {","+            GoogleCalendarConfiguration configuration = new GoogleCalendarConfiguration();","+            configuration.setClientId(clientId);","+            configuration.setClientSecret(clientSecret);","+            configuration.setRefreshToken(refreshToken);","+            configuration.setAccessToken(accessToken);","+            try {","+                Credential credential","+                        = GoogleCredentialsHelper.getOAuthCredential(null, configuration, scopes, transport, jsonFactory);","+                return new Calendar.Builder(transport, jsonFactory, credential).setApplicationName(\"test\").build();","+            } catch (Exception e) {","+                throw new IllegalStateException(e);","+            }","+        }","+","+        @Override","+        public Calendar makeClient(","+                CamelContext camelContext, String serviceAccountKey, Collection<String> scopes, String applicationName,","+                String delegate) {","+            throw new UnsupportedOperationException(\"OAuth only\");","+        }","+    }","+","+    private static final class RecordingTransport extends MockHttpTransport {","+","+        private final List<MockLowLevelHttpRequest> requests = new CopyOnWriteArrayList<>();","+","+        @Override","+        public MockLowLevelHttpRequest buildRequest(String method, String url) {","+            MockLowLevelHttpRequest request = new MockLowLevelHttpRequest(url);","+            request.setResponse(new MockLowLevelHttpResponse().setContentType(Json.MEDIA_TYPE)","+                    .setContent(\"{\\\"id\\\":\\\"primary\\\"}\"));","+            requests.add(request);","+            return request;","+        }","+    }","+}"],"additions":145,"deletions":0,"truncated":false},{"path":"components/camel-google/camel-google-common/src/main/java/org/apache/camel/component/google/common/GoogleApiRequestHelper.java","lines":["@@ -0,0 +1,70 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *      http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.apache.camel.component.google.common;","+","+import java.util.Collections;","+import java.util.List;","+import java.util.Map;","+import java.util.Set;","+import java.util.TreeSet;","+","+import org.apache.camel.CamelContext;","+import org.apache.camel.spi.BeanIntrospection;","+import org.apache.camel.support.PluginHelper;","+","+/**","+ * Sets the options and headers of an exchange on the request that a method of a Google API client builds, for the","+ * components that are generated from a Google API client (Calendar, Drive, Mail).","+ */","+public final class GoogleApiRequestHelper {","+","+    /**","+     * The options that make up the credential of the client. The client sends the credential in the Authorization","+     * header, so they are not set on the request, where accessToken would become the access_token query parameter.","+     * p12FileName is the key file of a service account (Calendar). The names are matched ignoring case, as a header","+     * such as CamelGoogleDrive.AccessToken sets the same property as accessToken.","+     */","+    public static final Set<String> CREDENTIAL_OPTIONS;","+","+    static {","+        Set<String> names = new TreeSet<>(String.CASE_INSENSITIVE_ORDER);","+        names.addAll(List.of(\"clientId\", \"clientSecret\", \"accessToken\", \"refreshToken\", \"serviceAccountKey\", \"delegate\",","+                \"p12FileName\"));","+        CREDENTIAL_OPTIONS = Collections.unmodifiableSet(names);","+    }","+","+    private GoogleApiRequestHelper() {","+    }","+","+    /**","+     * Sets the given properties on the request, such as the optional parameters of the method and the standard","+     * parameters of the Google API, except the options of the credential (see {@link #CREDENTIAL_OPTIONS}).","+     *","+     * @param camelContext the Camel context","+     * @param request      the request built by the method of the API client","+     * @param properties   the options of the endpoint and the headers of the exchange","+     */","+    public static void configureRequest(CamelContext camelContext, Object request, Map<String, Object> properties)","+            throws Exception {","+        BeanIntrospection beanIntrospection = PluginHelper.getBeanIntrospection(camelContext);","+        for (Map.Entry<String, Object> p : properties.entrySet()) {","+            if (!CREDENTIAL_OPTIONS.contains(p.getKey())) {","+                beanIntrospection.setProperty(camelContext, request, p.getKey(), p.getValue());","+            }","+        }","+    }","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"components/camel-google/camel-google-common/src/test/java/org/apache/camel/component/google/common/GoogleApiRequestHelperTest.java","lines":["@@ -0,0 +1,75 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *      http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.apache.camel.component.google.common;","+","+import java.util.Map;","+","+import org.apache.camel.CamelContext;","+import org.apache.camel.impl.DefaultCamelContext;","+import org.junit.jupiter.api.Test;","+","+import static org.junit.jupiter.api.Assertions.assertEquals;","+import static org.junit.jupiter.api.Assertions.assertNull;","+","+class GoogleApiRequestHelperTest {","+","+    @Test","+    void shouldSetTheParametersButNotTheCredentialOptions() throws Exception {","+        try (CamelContex