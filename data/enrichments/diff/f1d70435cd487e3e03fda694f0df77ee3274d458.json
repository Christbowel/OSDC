` in an HTML string is parsed into a processing instruction node at all","+\t\t// depends on the browser - engines without that support still parse it into a comment. The flag","+\t\t// pass-through is therefore asserted on the converter, and only the end-to-end tests are conditional.","+\t\tconst supportsProcessingInstructions = new DOMParser()","+\t\t\t.parseFromString( '<body><?foo bar?></body>', 'text/html' )","+\t\t\t.body.firstChild.nodeType === Node.PROCESSING_INSTRUCTION_NODE;","+","+\t\tit( 'should pass the default flags to the DOM converter', () => {","+\t\t\tconst spy = vi.spyOn( dataProcessor.domConverter, 'domToView' );","+","+\t\t\tdataProcessor.toView( '<p>foo</p>' );","+","+\t\t\texpect( spy.mock.calls[ 0 ][ 1 ] ).toEqual( expect.objectContaining( {","+\t\t\t\tskipComments: true,","+\t\t\t\tskipProcessingInstructions: true","+\t\t\t} ) );","+\t\t} );","+","+\t\tit( 'should pass the changed flags to the DOM converter', () => {","+\t\t\tconst spy = vi.spyOn( dataProcessor.domConverter, 'domToView' );","+","+\t\t\tdataProcessor.skipComments = false;","+\t\t\tdataProcessor.skipProcessingInstructions = false;","+","+\t\t\tdataProcessor.toView( '<p>foo</p>' );","+","+\t\t\texpect( spy.mock.calls[ 0 ][ 1 ] ).toEqual( expect.objectContaining( {","+\t\t\t\tskipComments: false,","+\t\t\t\tskipProcessingInstructions: false","+\t\t\t} ) );","+\t\t} );","+","+\t\tit( 'should pass the flags independently of each other', () => {","+\t\t\tconst spy = vi.spyOn( dataProcessor.domConverter, 'domToView' );","+","+\t\t\tdataProcessor.skipComments = false;","+","+\t\t\tdataProcessor.toView( '<p>foo</p>' );","+","+\t\t\texpect( spy.mock.calls[ 0 ][ 1 ] ).toEqual( expect.objectContaining( {","+\t\t\t\tskipComments: false,","+\t\t\t\tskipProcessingInstructions: true","+\t\t\t} ) );","+\t\t} );","+","+\t\tit.skipIf( !supportsProcessingInstructions )( 'should skip processing instructions when `true`', () => {","+\t\t\tconst fragment = dataProcessor.toView(","+\t\t\t\t'<?instru