{"id":"ed6fdc05939732e837e35063d02571051952c461","axis":"silent","repo":"TYPO3/typo3","sha":"ed6fdc05939732e837e35063d02571051952c461","parsed":{"files":[{"path":"typo3/sysext/core/Configuration/DefaultConfiguration.php","lines":["@@ -111,6 +111,7 @@","             'security.frontend.reportContentSecurityPolicy' => false,","             'security.frontend.allowInsecureSiteResolutionByQueryParameters' => false,","             'security.frontend.allowInsecureFrameOptionInShowImageController' => false,","+            'security.form.allowUnrestrictedFileUploadMimeTypes' => false,","             // only file extensions configured in 'textfile_ext', 'mediafile_ext', 'miscfile_ext' are accepted","             'security.system.enforceAllowedFileExtensions' => false,","             // only files having file-extension to mime-type matches are allowed"],"additions":1,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Configuration/DefaultConfigurationDescription.yaml","lines":["@@ -220,6 +220,9 @@ SYS:","               security.frontend.allowInsecureSiteResolutionByQueryParameters:","                 type: bool","                 description: 'Site resolution can be overridden using the <code>&id=...&L=...</code> parameters. The URI path and host are then used only as defaults.'","+              security.form.allowUnrestrictedFileUploadMimeTypes:","+                type: bool","+                description: 'Restores the legacy behaviour that an empty <code>allowedMimeTypes</code> list on an ext:form FileUpload/ImageUpload element applies no MIME type restriction. This is not recommended, as it allows anonymous visitors to upload arbitrary (non-PHP) file content, including browser-active files such as <code>.html</code> and <code>.svg</code>, into public storage. When disabled (default), an empty <code>allowedMimeTypes</code> list rejects every upload.'","               security.system.enforceAllowedFileExtensions:","                 type: bool","                 description: 'Only file extensions configured in <code>textfile_ext,</code> <code>mediafile_ext</code>, and <code>miscfile_ext</code> are allowed to be processed by the File Abstraction Layer (FAL).'"],"additions":3,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/13.4.x/Important-110695-EmptyAllowedMimeTypesRefusesFileUploads.rst","lines":["@@ -0,0 +1,61 @@","+.. include:: /Includes.rst.txt","+","+.. _important-110695-1758240000:","+","+============================================================================","+Important: #110695 - Empty allowedMimeTypes refuses file uploads in EXT:form","+============================================================================","+","+See :issue:`110695`","+","+Description","+===========","+","+The :yaml:`FileUpload` and :yaml:`ImageUpload` form elements of EXT:form use the","+:yaml:`allowedMimeTypes` property as an allow list of MIME types that may be","+uploaded. Previously, an **empty** :yaml:`allowedMimeTypes` list was treated as","+\"no restriction\", so any file (except those blocked by the core file deny","+pattern, e.g. PHP files) could be uploaded - including browser-active content","+such as :file:`.html` or :file:`.svg`.","+","+For a CMS this is not appropriate: uploaded files are stored in the File","+Abstraction Layer (by default in a public web storage below :file:`fileadmin/`)","+and may later be opened by backend users in a backend context or served","+directly. Allowing arbitrary file content by default can therefore be abused,","+for example as a stored cross-site-scripting vector.","+","+TYPO3 now applies **security by default**: an empty :yaml:`allowedMimeTypes`","+list refuses file uploads for that element completely. Integrators must","+configure at least one allowed MIME type for every :yaml:`FileUpload` /","+:yaml:`ImageUpload` element, for example:","+","+..  code-block:: yaml","+","+    allowedMimeTypes:","+      - application/pdf","+      - image/jpeg","+","+The former, insecure behaviour - an empty list means no MIME type restriction at","+all - can be restored globally with the feature toggle","+:php:`security.form.allowUnrestrictedFileUploadMimeTypes` (via the","+:guilabel:`Admin Tools > Settings > Feature Toggles` module or in","+:file:`settings.php`). Enabling this toggle is **not recommended** and should","+only be used as a temporary measure while form definitions are updated to","+configure an explicit allow list.","+","+An explicitly configured :yaml:`allowedMimeTypes` list is always honoured","+unchanged, including deliberate choices such as :yaml:`text/html` or","+:yaml:`image/svg+xml`.","+","+The form editor now validates the :guilabel:`Allowed file mime types` field of","+:yaml:`FileUpload` and :yaml:`ImageUpload` elements with the :yaml:`NotEmpty`","+property validator. A form containing such an element without any selected","+mime type can not be saved in the form editor until at least one mime type is","+selected. This also applies when the feature toggle mentioned above is","+enabled, since the toggle is only meant to keep existing forms working.","+","+If a required mime type is not offered in the form editor, add it to the","+:yaml:`selectOptions` of the :yaml:`allowedMimeTypes` editor","+(:yaml:`formEditor.editors.300`) in a custom form configuration.","+","+.. index:: ext:form, YAML, Frontend, NotScanned"],"additions":61,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Classes/Mvc/Property/PropertyMappingConfiguration.php","lines":["@@ -18,6 +18,7 @@"," namespace TYPO3\\CMS\\Form\\Mvc\\Property;"," "," use TYPO3\\CMS\\Core\\Attribute\\AsEventListener;","+use TYPO3\\CMS\\Core\\Configuration\\Features;"," use TYPO3\\CMS\\Core\\Resource\\Exception\\FolderDoesNotExistException;"," use TYPO3\\CMS\\Core\\Resource\\Exception\\InsufficientFolderAccessPermissionsException;"," use TYPO3\\CMS\\Core\\Resource\\ResourceFactory;","@@ -42,6 +43,7 @@ class PropertyMappingConfiguration","     public function __construct(","         private readonly ValidatorResolver $validatorResolver,","         private readonly ResourceFactory $resourceFactory,","+        private readonly Features $features,","     ) {}"," ","     public function __invoke(AfterFormStateInitializedEvent $event): void","@@ -181,7 +183,14 @@ protected function registerMimeTypeValidator(","         if (is_array($renderable->getProperties()['allowedMimeTypes'] ?? null)) {","             $allowedMimeTypes = array_filter($renderable->getProperties()['allowedMimeTypes']);","         }","-        if ($allowedMimeTypes === []) {","+","+        // An empty \"allowedMimeTypes\" list is treated as \"no allowed mime type\" and therefore rejects every upload.","+        // The insecure legacy behaviour can be restored globally via feature toggle.","+        // @todo: In TYPO3 v15 LTS, drop the check and feature toggle in favour of an explicit per-form opt-in via","+        //        'allowedMimeTypes' => ['*'] (requires wildcard support in MimeTypeValidator).","+        if ($allowedMimeTypes === []","+            && $this->features->isFeatureEnabled('security.form.allowUnrestrictedFileUploadMimeTypes')","+        ) {","             return;","         }"," "],"additions":10,"deletions":1,"truncated":false},{"path":"typo3/sysext/form/Classes/Mvc/Validation/MimeTypeValidator.php","lines":["@@ -71,6 +71,9 @@ public function isValid(mixed $resource): void","         }"," ","         $allowedMimeTypes = $this->options['allowedMimeTypes'];","+","+        // @todo: add wildcard support (see EXT:form/Classes/Mvc/Property/PropertyMappingConfiguration.php, registerMimeTypeValidator)","+","         if (!in_array($mimeType, $allowedMimeTypes, true)) {","             $this->addError(","                 $this->translateErrorMessage("],"additions":3,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Configuration/Form/Base/FormElements/FileUpload.yaml","lines":["@@ -27,6 +27,8 @@ prototypes:","               templateName: Inspector-MultiSelectEditor","               label: formEditor.elements.FileUpload.editor.allowedMimeTypes.label","               propertyPath: properties.allowedMimeTypes","+              propertyValidators:","+                10: NotEmpty","               selectOptions:","                 10:","                   value: application/msword"],"additions":2,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Configuration/Form/Base/FormElements/ImageUpload.yaml","lines":["@@ -27,6 +27,8 @@ prototypes:","               templateName: Inspector-MultiSelectEditor","               label: formEditor.elements.ImageUpload.editor.allowedMimeTypes.label","               propertyPath: properties.allowedMimeTypes","+              propertyValidators:","+                10: NotEmpty","               selectOptions:","                 10:","                   value: image/jpeg"],"additions":2,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Documentation/I/Config/proto/formElements/formElementTypes/FileUpload/formEditor/editors/300.rst.txt","lines":["@@ -31,6 +31,8 @@ formEditor.editors.300","                 templateName: Inspector-MultiSelectEditor","                 label: formEditor.elements.FileUpload.editor.allowedMimeTypes.label","                 propertyPath: properties.allowedMimeTypes","+                propertyValidators:","+                  10: NotEmpty","                 selectOptions:","                   10:","                     value: application/msword"],"additions":2,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Documentation/I/Config/proto/formElements/formElementTypes/FileUpload/properties/allowedMimeTypes.rst.txt","lines":["@@ -41,4 +41,38 @@ properties.allowedMimeTypes","     ToDo"," "," :aspect:`Description`","-    The allowed mime types for the file uploads.","+      The allowed mime types for the file uploads, used as an allow list.","+","+      This property is mandatory. If the list is **empty**, file uploads for this","+      element are refused completely (security by default) - configure at least","+      one allowed mime type. This behavior can be disabled by enabling the","+      feature toggle :php:`security.form.allowUnrestrictedFileUploadMimeTypes`,","+      which however is not recommended.","+","+      In the form editor, only the mime types listed in the","+      :ref:`selectOptions <prototypes.prototypeIdentifier.formelementsdefinition.fileupload.formeditor.editors.300>`","+      of the editor can be selected. If a required mime type is missing, add it","+      to the select options in a","+      :ref:`custom form configuration <concepts-configuration-yamlregistration>`","+      instead of leaving the list empty:","+","+      ..  code-block:: yaml","+","+          prototypes:","+            standard:","+              formElementsDefinition:","+                FileUpload:","+                  formEditor:","+                    editors:","+                      300:","+                        selectOptions:","+                          100:","+                            value: text/plain","+                            label: 'Text file (.txt)'","+                          110:","+                            value: application/zip","+                            label: 'ZIP archive (.zip)'","+","+      Only add mime types that are safe to be uploaded by website visitors.","+      Avoid browser-active content such as :yaml:`text/html` or","+      :yaml:`image/svg+xml`."],"additions":35,"deletions":1,"truncated":false},{"path":"typo3/sysext/form/Documentation/I/Config/proto/formElements/formElementTypes/ImageUpload/formEditor/editors/300.rst.txt","lines":["@@ -31,6 +31,8 @@ formEditor.editors.300","                 templateName: Inspector-MultiSelectEditor","                 label: formEditor.elements.ImageUpload.editor.allowedMimeTypes.label","                 propertyPath: properties.allowedMimeTypes","+                propertyValidators:","+                  10: NotEmpty","                 selectOptions:","                   10:","                     value: image/jpeg"],"additions":2,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Documentation/I/Config/proto/formElements/formElementTypes/ImageUpload/properties/allowedMimeTypes.rst.txt","lines":["@@ -43,4 +43,35 @@ properties.allowedMimeTypes","     ToDo"," "," :aspect:`Description`","-    The allowed mime types for the image uploads.","+      The allowed mime types for the image uploads, used as an allow list.","+","+      This property is mandatory. If the list is **empty**, image uploads for this","+      element are refused completely (security by default) - configure at least","+      one allowed mime type. This behavior can be disabled by enabling the","+      feature toggle :php:`security.form.allowUnrestrictedFileUploadMimeTypes`,","+      which however is not recommended.","+","+      In the form editor, only the mime types listed in the","+      :ref:`selectOptions <prototypes.prototypeIdentifier.formelementsdefinition.imageupload.formeditor.editors.300>`","+      of the editor can be selected. If a required mime type is missing, add it","+      to the select options in a","+      :ref:`custom form configuration <concepts-configuration-yamlregistration>`","+      instead of leaving the list empty:","+","+      ..  code-block:: yaml","+","+          prototypes:","+            standard:","+              formElementsDefinition:","+                ImageUpload:","+                  formEditor:","+                    editors:","+                      300:","+                        selectOptions:","+                          100:","+                            value: image/webp","+                            label: 'WebP image (.webp)'","+","+      Only add mime types that are safe to be uploaded by website visitors.","+      Avoid browser-active content such as :yaml:`image/svg+xml`.","+"],"additions":32,"deletions":1,"truncated":false},{"path":"typo3/sysext/form/Tests/Functional/Mvc/Property/FileUploadMimeTypeValidatorRegistrationTest.php","lines":["@@ -19,9 +19,13 @@"," "," use PHPUnit\\Framework\\Attributes\\Test;"," use Psr\\EventDispatcher\\EventDispatcherInterface;","+use TYPO3\\CMS\\Core\\Core\\Environment;"," use TYPO3\\CMS\\Core\\Core\\SystemEnvironmentBuilder;"," use TYPO3\\CMS\\Core\\Http\\ServerRequest;","+use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;"," use TYPO3\\CMS\\Extbase\\Configuration\\ConfigurationManagerInterface as ExtbaseConfigurationManagerInterface;","+use TYPO3\\CMS\\Extbase\\Domain\\Model\\FileReference;","+use TYPO3\\CMS\\Extbase\\Error\\Error;"," use TYPO3\\CMS\\Extbase\\Mvc\\ExtbaseRequestParameters;"," use TYPO3\\CMS\\Extbase\\Mvc\\Request;"," use TYPO3\\CMS\\Form\\Domain\\Factory\\ArrayFormFactory;","@@ -29,6 +33,7 @@"," use TYPO3\\CMS\\Form\\Domain\\Runtime\\FormRuntime;"," use TYPO3\\CMS\\Form\\Domain\\Runtime\\FormRuntime\\FormSession;"," use TYPO3\\CMS\\Form\\Event\\AfterFormStateInitializedEvent;","+use TYPO3\\CMS\\Form\\Mvc\\Property\\TypeConverter\\UploadedFileReferenceConverter;"," use TYPO3\\CMS\\Form\\Mvc\\Validation\\MimeTypeValidator;"," use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;"," ","@@ -53,6 +58,13 @@ protected function setUp(): void","         // ConfigurationManager, which requires a request to be set.","         $request = new ServerRequest()->withAttribute('applicationType', SystemEnvironmentBuilder::REQUESTTYPE_BE);","         $this->get(ExtbaseConfigurationManagerInterface::class)->setRequest($request);","+        GeneralUtility::mkdir_deep(Environment::getPublicPath() . '/fileadmin/user_upload/');","+    }","+","+    protected function tearDown(): void","+    {","+        GeneralUtility::rmdir(Environment::getPublicPath() . '/fileadmin/user_upload/', true);","+        parent::tearDown();","     }"," ","     private function buildFormDefinition(array $fileUploadProperties): FormDefinition","@@ -103,6 +115,49 @@ private function processingRuleHasMimeTypeValidator(FormDefinition $formDefiniti","         return false;","     }"," ","+    /**","+     * Runs a PDF upload through the type converter with the property mapping","+     * configuration that was set up for the \"file-1\" element.","+     */","+    private function uploadPdf(FormDefinition $formDefinition): mixed","+    {","+        $tmpPath = $this->instancePath . '/typo3temp/var/transient/';","+        GeneralUtility::mkdir_deep($tmpPath);","+        copy(__DIR__ . '/TypeConverter/Fixtures/test-document.pdf', $tmpPath . 'upload.pdf');","+","+        $source = [","+            'error' => \\UPLOAD_ERR_OK,","+            'name' => 'upload.pdf',","+            'type' => 'application/pdf',","+            'tmp_name' => $tmpPath . 'upload.pdf',","+            'size' => filesize($tmpPath . 'upload.pdf'),","+        ];","+","+        return $this->get(UploadedFileReferenceConverter::class)->convertFrom(","+            $source,","+            FileReference::class,","+            [],","+            $formDefinition->getProcessingRules()['file-1']->getPropertyMappingConfiguration()","+        );","+    }","+","+    /**","+     * @return list<string>","+     */","+    private function collectUploadedFiles(): array","+    {","+        $files = [];","+        $iterator = new \\RecursiveIteratorIterator(","+            new \\RecursiveDirectoryIterator(Environment::getPublicPath() . '/fileadmin/user_upload/', \\FilesystemIterator::SKIP_DOTS)","+        );","+        foreach ($iterator as $fileInfo) {","+            if ($fileInfo->isFile() && $fileInfo->getFilename() !== 'index.html') {","+                $files[] = $fileInfo->getFilename();","+            }","+        }","+        return $files;","+    }","+","     #[Test]","     public function mimeTypeValidatorIsRegisteredForConfiguredAllowedMimeTypes(): void","     {","@@ -119,7 +174,7 @@ public function mimeTypeValidatorIsRegisteredForConfiguredAllowedMimeTypes(): vo","     }"," ","     #[Test]","-    public function mimeTypeValidatorIsNotRegisteredWhenNoAllowedMimeTypesConfigured(): void","+    public function mimeTypeValidatorIsRegisteredWhenNoAllowedMimeTypesConfigured(): void","     {","         $formDefinition = $this->buildFormDefinition(['allowedMimeTypes' => []]);"," ","@@ -127,9 +182,25 @@ public function mimeTypeValidatorIsNotRegisteredWhenNoAllowedMimeTypesConfigured","             new AfterFormStateInitializedEvent($this->runtimeAllowingSubmission($formDefinition), new Request(new ServerRequest()->withAttribute('extbase', new ExtbaseRequestParameters())))","         );"," ","+        self::assertTrue(","+            $this->processingRuleHasMimeTypeValidator($formDefinition),","+            'MimeTypeValidator must be registered even when no allowedMimeTypes are configured.'","+        );","+    }","+","+    #[Test]","+    public function mimeTypeValidatorIsNotRegisteredWhenEmptyAndFeatureToggleEnabled(): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['SYS']['features']['security.form.allowUnrestrictedFileUploadMimeTypes'] = true;","+        $formDefinition = $this->buildFormDefinition(['allowedMimeTypes' => []]);","+","+        $this->get(EventDispatcherInterface::class)->dispatch(","+            new AfterFormStateInitializedEvent($this->runtimeAllowingSubmission($formDefinition), new Request(new ServerRequest()->withAttribute('extbase', new ExtbaseRequestParameters())))","+        );","+","         self::assertFalse(","             $this->processingRuleHasMimeTypeValidator($formDefinition),","-            'MimeTypeValidator must not be registered when no allowedMimeTypes are configured.'","+            'MimeTypeValidator must not be registered when the feature toggle allows an empty list.'","         );","     }"," ","@@ -156,4 +227,45 @@ public function mimeTypeValidatorIsRegisteredOnlyOnceWhenHookRunsMultipleTimes()"," ","         self::assertSame(1, $mimeTypeValidatorCount, 'MimeTypeValidator was registered more than once.');","     }","+","+    #[Test]","+    public function uploadIsRefusedAndNotPersistedWhenNoAllowedMimeTypesConfigured(): void","+    {","+        $formDefinition = $this->buildFormDefinition([","+            'saveToFileMount' => '1:/user_upload/',","+            'allowedMimeTypes' => [],","+        ]);","+        $this->get(EventDispatcherInterface::class)->dispatch(","+            new AfterFormStateInitializedEvent(","+                $this->runtimeAllowingSubmission($formDefinition),","+                new Request(new ServerRequest()->withAttribute('extbase', new ExtbaseRequestParameters()))","+            )","+        );","+","+        $result = $this->uploadPdf($formDefinition);","+","+        self::assertInstanceOf(Error::class, $result);","+        self::assertSame(1793200460, $result->getCode());","+        self::assertSame([], $this->collectUploadedFiles(), 'A refused upload must not be persisted.');","+    }","+","+    #[Test]","+    public function uploadIsPersistedWhenMimeTypeIsAllowed(): void","+    {","+        $formDefinition = $this->buildFormDefinition([","+            'saveToFileMount' => '1:/user_upload/',","+            'allowedMimeTypes' => ['application/pdf'],","+        ]);","+        $this->get(EventDispatcherInterface::class)->dispatch(","+            new AfterFormStateInitializedEvent(","+                $this->runtimeAllowingSubmission($formDefinition),","+                new Request(new ServerRequest()->withAttribute('extbase', new ExtbaseRequestParameters()))","+            )","+        );","+","+        $result = $this->uploadPdf($formDefinition);","+","+        self::assertInstanceOf(FileReference::class, $result);","+        self::assertSame(['upload.pdf'], $this->collectUploadedFiles());","+    }"," }"],"additions":114,"deletions":2,"truncated":false},{"path":"typo3/sysext/form/Tests/Functional/Mvc/Property/PropertyMappingConfigurationTest.php","lines":["@@ -19,6 +19,7 @@"," "," use PHPUnit\\Framework\\Attributes\\Test;"," use Psr\\EventDispatcher\\EventDispatcherInterface;","+use TYPO3\\CMS\\Core\\Configuration\\Features;"," use TYPO3\\CMS\\Core\\Core\\SystemEnvironmentBuilder;"," use TYPO3\\CMS\\Core\\Http\\ServerRequest;"," use TYPO3\\CMS\\Core\\Resource\\Exception\\InsufficientFolderAccessPermissionsException;","@@ -93,7 +94,7 @@ public function uploadFolderIsNotSetIfAccessToSaveToFileMountIsDenied(): void","         $resourceFactory = self::createStub(ResourceFactory::class);","         $resourceFactory->method('getFolderObjectFromCombinedIdentifier')","             ->willThrowException(new InsufficientFolderAccessPermissionsException('Access denied', 1791380637));","-        $subject = new PropertyMappingConfiguration($this->get(ValidatorResolver::class), $resourceFactory);","+        $subject = new PropertyMappingConfiguration($this->get(ValidatorResolver::class), $resourceFactory, self::createStub(Features::class));","         $formDefinition = $this->buildFormDefinition(['saveToFileMount' => '1:/custom_uploads/']);"," ","         $subject($this->createAfterFormStateInitializedEvent($formDefinition));","@@ -109,7 +110,7 @@ public function uploadFolderIsNotResolvedInPreviewMode(): void","     {","         $resourceFactory = $this->createMock(ResourceFactory::class);","         $resourceFactory->expects($this->never())->method('getFolderObjectFromCombinedIdentifier');","-        $subject = new PropertyMappingConfiguration($this->get(ValidatorResolver::class), $resourceFactory);","+        $subject = new PropertyMappingConfiguration($this->get(ValidatorResolver::class), $resourceFactory, self::createStub(Features::class));","         $formDefinition = $this->buildFormDefinition(['saveToFileMount' => '1:/custom_uploads/']);","         $formDefinition->setRenderingOption('previewMode', true);"," ",""],"additions":3,"deletions":2,"truncated":false}],"additions":270,"deletions":7,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-17T18:45:58.917097+00:00"}