p.Request) {","+\t\t\t\t\tcalls.Add(1)","+\t\t\t\t\tw.Header().Set(\"Content-Encoding\", \"gzip\")","+\t\t\t\t\tw.Header().Set(\"Content-Type\", \"application/x-protobuf\")","+\t\t\t\t\tw.WriteHeader(tc.status)","+\t\t\t\t\tif tc.malformed {","+\t\t\t\t\t\t_, _ = w.Write(tc.body)","+\t\t\t\t\t\treturn","+\t\t\t\t\t}","+\t\t\t\t\tzw := gzip.NewWriter(w)","+\t\t\t\t\t_, _ = zw.Write(tc.body)","+\t\t\t\t\t_ = zw.Close()","+\t\t\t\t}))","+\t\t\t\tt.Cleanup(srv.Close)","+\t\t\t\topts := []otlptracehttp.Option{","+\t\t\t\t\totlptracehttp.WithEndpointURL(srv.URL),","+\t\t\t\t\totlptracehttp.WithMaxResponseSize(tc.limit),","+\t\t\t\t\totlptracehttp.WithRetry(","+\t\t\t\t\t\totlptracehttp.RetryConfig{","+\t\t\t\t\t\t\tEnabled:         true,","+\t\t\t\t\t\t\tInitialInterval: time.Millisecond,","+\t\t\t\t\t\t\tMaxInterval:     time.Millisecond,","+\t\t\t\t\t\t\tMaxElapsedTime:  time.Second,","+\t\t\t\t\t\t},","+\t\t\t\t\t),","+\t\t\t\t}","+\t\t\t\tif explicit {","+\t\t\t\t\topts = append(opts, otlptracehttp.WithHeaders(map[string]string{\"Accept-Encoding\": \"gzip\"}))","+\t\t\t\t}","+\t\t\t\tclient := otlptracehttp.NewClient(opts...)","+\t\t\t\trequire.NoError(t, client.Start(t.Context()))","+\t\t\t\tt.Cleanup(func() { _ = client.Stop(t.Context()) })","+\t\t\t\texportErr := client.UploadTraces(t.Context(), []*tracepb.ResourceSpans{{}})","+\t\t\t\tif tc.wantErr == \"\" {","+\t\t\t\t\tassert.NoError(t, exportErr)","+\t\t\t\t} else {","+\t\t\t\t\tassert.ErrorContains(t, exportErr, tc.wantErr)","+\t\t\t\t}","+\t\t\t\tassert.Equal(t, int32(1), calls.Load(), \"response must not be retried\")","+\t\t\t})","+\t\t}","+\t}","+}"],"additions":120,"deletions":0,"truncated":false},{"path":"exporters/otlp/otlptrace/otlptracehttp/internal/response.go","lines":["@@ -7,11 +7,30 @@"," package internal"," "," import (","+\t\"compress/gzip\""," \t\"errors\""," \t\"fmt\""," \t\"io\"","+\t\"net/http\"","+\t\"strings\""," )"," ","+// CopyHTTPResponseBody copies the decoded response body, enforcing 