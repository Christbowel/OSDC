lhost:3000')","+","+      const remotePort = 12345","+      const write = vi.fn()","+      const upgrade = (origin?: string) => {","+        write.mockClear()","+        server.proxyWebsockets(proxy, '/foo', {","+          url: '/foo-graphql',","+          headers: origin ? { origin } : {},","+          socket: { remotePort, remoteAddress: '127.0.0.1' },","+        }, { ...socket, write }, head)","+","+        return write.mock.calls.length > 0 ? 'refused' : 'allowed'","+      }","+","+      server.socketAllowed.add({ localPort: remotePort, once: _.noop })","+","+      for (const mode of ['proxy', 'browser'] as const) {","+        if (mode === 'browser') await enterBrowserNetworkMode(server)","+","+        expect(upgrade('http://localhost:3000'), `${mode}: primary`).toBe('allowed')","+        expect(upgrade('https://www.localhost:3000'), `${mode}: other protocol`).toBe('refused')","+        expect(upgrade('https://other.example.com'), `${mode}: other origin`).toBe('refused')","+        expect(upgrade('http://localhost:4000'), `${mode}: other port`).toBe('refused')","+        expect(upgrade(undefined), `${mode}: no origin`).toBe('refused')","+        // Firefox only runs on the proxy path, so a moz-extension origin on the browser path is some other Firefox","+        expect(upgrade('moz-extension://3f1c2b2e-0000-4000-8000-000000000000'), `${mode}: firefox extension`).toBe(mode === 'proxy' ? 'allowed' : 'refused')","+      }","+    })","+","+    it('accepts a socket upgrade from the server\\'s own origin when the primary is a component testing dev server', async () => {","+      server._openConfig = config","+      server.remoteStates.set('http://localhost:4456')","+","+      const serverPort = 4455","+","+      server._server = { address: () => ({ port: serverPort }) }","+      const remotePort = 12345","+      const write = vi.fn()","+      const upgrade = (origin: string) => {","+        write.mockClear()","+        server.proxyWebsockets(proxy, '/foo', {","+      