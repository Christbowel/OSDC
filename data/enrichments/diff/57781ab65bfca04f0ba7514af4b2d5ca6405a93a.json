{"id":"57781ab65bfca04f0ba7514af4b2d5ca6405a93a","axis":"silent","repo":"cypress-io/cypress","sha":"57781ab65bfca04f0ba7514af4b2d5ca6405a93a","parsed":{"files":[{"path":"cli/CHANGELOG.md","lines":["@@ -9,6 +9,8 @@"," "," **Bugfixes:**"," ","+- Fixed an issue where, on Apple silicon Macs without Rosetta, `cypress run` could not move the previous run's videos, screenshots, and downloads to the Trash when [`trashAssetsBeforeRuns`](https://on.cypress.io/configuration#Folders--Files) was enabled. It warned `We failed to trash the existing run results` and left the old files in place. The Apple silicon binary also no longer includes programs built only for Intel Macs, so running it no longer triggers the macOS warning about apps that need Rosetta. Fixes [#24582](https://github.com/cypress-io/cypress/issues/24582), [#30131](https://github.com/cypress-io/cypress/issues/30131) and [#35342](https://github.com/cypress-io/cypress/issues/35342).","+- On Windows, the tables that `cypress run` prints in an interactive console now fit the console's width, up to 100 columns. Previously they were always 100 columns wide, so they wrapped in narrower consoles. Output in CI is unchanged. Fixed in [#35348](https://github.com/cypress-io/cypress/pull/35348)."," - Fixed an issue where a failed assertion whose error message was very long, such as [`.should('contain.text')`](https://on.cypress.io/should) on an element with a lot of text, took minutes to report, so the run looked stuck. The browser stopped responding while it processed the error, and `cypress run` paused again after printing the failure. The failure is now reported as soon as the assertion times out. Fixes [#35335](https://github.com/cypress-io/cypress/issues/35335)."," - Fixed a regression in [16.0.0](#16-0-0) where a [`cy.intercept()`](https://on.cypress.io/intercept) response handler that changed the `Location` or `Referrer-Policy` header of a redirect had no effect in Chromium-based browsers. The browser followed the redirect as the server sent it, to the server's URL and with the server's referrer policy. Fixes [#34704](https://github.com/cypress-io/cypress/issues/34704)."," - [`.type()`](https://on.cypress.io/type) now accepts consecutive `{upArrow}` and `{downArrow}` sequences, such as `{upArrow}{upArrow}`, on `date`, `month`, `week`, `time`, and `datetime-local` inputs, and steps the value once per arrow. Previously, a single arrow worked but more than one in a row failed with an error saying the input required a valid date, month, week, time, or datetime. Fixed in [#35352](https://github.com/cypress-io/cypress/pull/35352)."],"additions":2,"deletions":0,"truncated":false},{"path":"cli/lib/util.ts","lines":["@@ -295,6 +295,7 @@ const util = {","       return value ? '1' : '0'","     })","     .extend(this.getOriginalNodeOptions())","+    .extend(this.getTerminalSize())","     .value()","   },"," ","@@ -316,6 +317,13 @@ const util = {","     }","   },"," ","+  // On Windows the binary's stdio is always piped, so it cannot measure the terminal itself","+  getTerminalSize (): { FORCE_TTY_COLUMNS?: string, FORCE_TTY_ROWS?: string } {","+    const stream = [process.stdout, process.stderr].find((s) => s.isTTY && s.columns && s.rows)","+","+    return stream ? { FORCE_TTY_COLUMNS: String(stream.columns), FORCE_TTY_ROWS: String(stream.rows) } : {}","+  },","+","   getEnvColors (): any {","     const sc = this.supportsColor()"," "],"additions":8,"deletions":0,"truncated":false},{"path":"cli/test/lib/util.spec.ts","lines":["@@ -1,4 +1,4 @@","-import { vi, describe, it, beforeEach, expect } from 'vitest'","+import { vi, describe, it, beforeEach, afterEach, expect } from 'vitest'"," import assert from 'assert'"," import hasha from 'hasha'"," import util from '../../lib/util'","@@ -346,6 +346,52 @@ describe('util', () => {","     })","   })"," ","+  describe('.getTerminalSize', () => {","+    const setStream = (stream: NodeJS.WriteStream, isTTY: boolean, columns?: number, rows?: number) => {","+      vi.spyOn(stream, 'isTTY', 'get').mockReturnValue(isTTY)","+      vi.spyOn(stream, 'columns', 'get').mockReturnValue(columns as number)","+      vi.spyOn(stream, 'rows', 'get').mockReturnValue(rows as number)","+    }","+","+    beforeEach(() => {","+      for (const stream of [process.stdout, process.stderr]) {","+        for (const key of ['isTTY', 'columns', 'rows']) {","+          Object.defineProperty(stream, key, { configurable: true, get: () => undefined })","+        }","+      }","+    })","+","+    afterEach(() => {","+      vi.restoreAllMocks()","+      for (const stream of [process.stdout, process.stderr]) {","+        for (const key of ['isTTY', 'columns', 'rows']) {","+          delete (stream as any)[key]","+        }","+      }","+    })","+","+    it('forwards the stdout terminal size', () => {","+      setStream(process.stdout, true, 133, 41)","+      setStream(process.stderr, true, 90, 30)","+","+      expect(util.getTerminalSize()).toEqual({ FORCE_TTY_COLUMNS: '133', FORCE_TTY_ROWS: '41' })","+    })","+","+    it('forwards the stderr terminal size when stdout is not a terminal', () => {","+      setStream(process.stdout, false)","+      setStream(process.stderr, true, 90, 30)","+","+      expect(util.getTerminalSize()).toEqual({ FORCE_TTY_COLUMNS: '90', FORCE_TTY_ROWS: '30' })","+    })","+","+    it('forwards nothing when neither stream is a terminal', () => {","+      setStream(process.stdout, false)","+      setStream(process.stderr, false)","+","+      expect(util.getTerminalSize()).toEqual({})","+    })","+  })","+","   describe('.getOriginalNodeOptions', () => {","     it('copy NODE_OPTIONS to ORIGINAL_NODE_OPTIONS', () => {","       vi.stubEnv('NODE_OPTIONS', '--require foo.js')"],"additions":47,"deletions":1,"truncated":false},{"path":"knip.json","lines":["@@ -766,6 +766,7 @@","     \"pgrep\",","     \"rm\",","     \"tar\",","+    \"tput\",","     \"tslint\",","     \"wc\",","     \"Xvfb\""],"additions":1,"deletions":0,"truncated":false},{"path":"packages/server/lib/util/terminal-size.ts","lines":["@@ -1,8 +1,64 @@","-import termSize from 'term-size'","+import { execFileSync } from 'child_process'","+import fs from 'fs'"," import * as env from './env'"," ","-export const get = (): { columns: number, rows: number } => {","-  const obj = termSize()","+type Size = { columns: number, rows: number }","+","+const DEFAULT_SIZE: Size = { columns: 80, rows: 24 }","+","+const create = (columns: unknown, rows: unknown): Size | undefined => {","+  const size = { columns: Number.parseInt(String(columns), 10), rows: Number.parseInt(String(rows), 10) }","+","+  return size.columns > 0 && size.rows > 0 ? size : undefined","+}","+","+const fromStream = (stream?: NodeJS.WriteStream): Size | undefined => {","+  return stream?.columns && stream?.rows ? create(stream.columns, stream.rows) : undefined","+}","+","+// Covers piped output and apps launched without a terminal on stdout/stderr","+const fromDevTty = (): Size | undefined => {","+  if (process.platform === 'win32') return","+","+  let fd: number | undefined","+","+  try {","+    // A tty.WriteStream leaves file descriptors open after destroy(), so ask stty instead","+    fd = fs.openSync('/dev/tty', 'r')","+    const [rows, columns] = execFileSync('stty', ['size'], { encoding: 'utf8', stdio: [fd, 'pipe', 'ignore'], timeout: 500 }).trim().split(/\\s+/)","+","+    return create(columns, rows)","+  } catch {","+    return","+  } finally {","+    if (fd !== undefined) fs.closeSync(fd)","+  }","+}","+","+const fromTput = (): Size | undefined => {","+  if (process.platform === 'win32') return","+","+  try {","+    const tput = (arg: string) => execFileSync('tput', [arg], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], timeout: 500 }).trim()","+","+    return create(tput('cols'), tput('lines'))","+  } catch {","+    return","+  }","+}","+","+const getSize = (): Size => {","+  return fromStream(process.stdout)","+    ?? fromStream(process.stderr)","+    ?? create(process.env.COLUMNS, process.env.LINES)","+    ?? create(process.env.FORCE_TTY_COLUMNS, process.env.FORCE_TTY_ROWS)","+    ?? fromDevTty()","+    ?? fromTput()","+    ?? { ...DEFAULT_SIZE }","+}","+","+export const get = (): Size => {","+  const obj = getSize()"," ","   if (env.get('CI')) {","     // reset to 100"],"additions":59,"deletions":3,"truncated":false},{"path":"packages/server/lib/util/trash.ts","lines":["@@ -1,31 +1,28 @@"," import { fs } from './fs'"," import os from 'os'"," import path from 'path'","-import trash from 'trash'","-","-// Trashes a single item, tolerating the case where the underlying trash","-// implementation reports a failure even though the item was actually removed.","-// On Windows, when the Recycle Bin is configured with \"Don't move files to the","-// Recycle Bin. Remove files immediately when deleted.\", windows-trash.exe","-// deletes the file but exits with a non-zero code, which `trash` surfaces as an","-// error. If the item no longer exists, the removal succeeded and we should not","-// warn.","+import { shell } from 'electron'","+import { isRunningAsElectronProcess } from './electron-app'","+"," const trashItem = async (itemPath: string): Promise<void> => {","   try {","-    await trash([itemPath])","+    await shell.trashItem(itemPath)","   } catch (error) {","-    if (await fs.pathExists(itemPath)) {","+    // Windows rejects without deleting when the Recycle Bin is set to remove files immediately","+    if (os.platform() !== 'win32') {","       throw error","     }","+","+    await fs.remove(itemPath)","   }"," }"," ","-// Moves a folder's contents to the trash (or empties it on Linux)","+// Moves a folder's contents to the trash, or empties it on Linux and when running as Node without Electron's shell"," export const folder = async (pathToFolder: string): Promise<void> => {","   try {","     await fs.statAsync(pathToFolder)"," ","-    if (os.platform() === 'linux') {","+    if (os.platform() === 'linux' || !isRunningAsElectronProcess()) {","       await fs.emptyDir(pathToFolder)"," ","       return"],"additions":10,"deletions":13,"truncated":false},{"path":"packages/server/package.json","lines":["@@ -132,9 +132,7 @@","     \"syntax-error\": \"1.4.0\",","     \"systeminformation\": \"^5.33.16\",","     \"tar\": \"^7.5.21\",","-    \"term-size\": \"2.1.0\",","     \"tough-cookie\": \"4.1.3\",","-    \"trash\": \"7.2.0\",","     \"tslib\": \"2.3.1\",","     \"tsx\": \"4.23.12\",","     \"untildify\": \"^4.0.0\","],"additions":0,"deletions":2,"truncated":false},{"path":"packages/server/test/unit/util/terminal-size.spec.ts","lines":["@@ -0,0 +1,135 @@","+import fs from 'fs'","+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'","+import * as env from '../../../lib/util/env'","+import * as terminalSize from '../../../lib/util/terminal-size'","+","+const { execFileSync } = vi.hoisted(() => ({ execFileSync: vi.fn() }))","+","+vi.mock('child_process', async (importOriginal) => {","+  const actual = await importOriginal<typeof import('child_process')>()","+","+  return { ...actual, default: { ...actual, execFileSync }, execFileSync }","+})","+","+const setStreamSize = (stream: NodeJS.WriteStream, columns?: number, rows?: number) => {","+  vi.spyOn(stream, 'columns', 'get').mockReturnValue(columns as number)","+  vi.spyOn(stream, 'rows', 'get').mockReturnValue(rows as number)","+}","+","+const withPlatform = (platform: NodeJS.Platform, fn: () => void) => {","+  const original = Object.getOwnPropertyDescriptor(process, 'platform')!","+","+  Object.defineProperty(process, 'platform', { value: platform })","+","+  try {","+    fn()","+  } finally {","+    Object.defineProperty(process, 'platform', original)","+  }","+}","+","+describe('lib/util/terminal-size', () => {","+  beforeEach(() => {","+    // vitest's worker streams are not TTYs, so give them accessors to spy on","+    for (const stream of [process.stdout, process.stderr]) {","+      Object.defineProperty(stream, 'columns', { configurable: true, get: () => undefined })","+      Object.defineProperty(stream, 'rows', { configurable: true, get: () => undefined })","+    }","+","+    vi.spyOn(env, 'get').mockReturnValue(undefined)","+    execFileSync.mockReset().mockImplementation(() => {","+      throw new Error('ENOENT')","+    })","+","+    vi.stubEnv('COLUMNS', '')","+    vi.stubEnv('LINES', '')","+    vi.stubEnv('FORCE_TTY_COLUMNS', '')","+    vi.stubEnv('FORCE_TTY_ROWS', '')","+  })","+","+  afterEach(() => {","+    vi.restoreAllMocks()","+    vi.unstubAllEnvs()","+    for (const stream of [process.stdout, process.stderr]) {","+      delete (stream as any).columns","+      delete (stream as any).rows","+    }","+  })","+","+  it('uses the stdout size', () => {","+    setStreamSize(process.stdout, 120, 40)","+    setStreamSize(process.stderr, 90, 30)","+","+    expect(terminalSize.get()).toEqual({ columns: 120, rows: 40 })","+  })","+","+  it('uses the stderr size when stdout is not a terminal', () => {","+    setStreamSize(process.stderr, 90, 30)","+","+    expect(terminalSize.get()).toEqual({ columns: 90, rows: 30 })","+  })","+","+  it('uses COLUMNS and LINES when neither stream is a terminal', () => {","+    vi.stubEnv('COLUMNS', '132')","+    vi.stubEnv('LINES', '50')","+","+    expect(terminalSize.get()).toEqual({ columns: 132, rows: 50 })","+  })","+","+  it('uses the size forwarded by the CLI when the streams are piped', () => {","+    vi.stubEnv('FORCE_TTY_COLUMNS', '133')","+    vi.stubEnv('FORCE_TTY_ROWS', '41')","+","+    expect(terminalSize.get()).toEqual({ columns: 133, rows: 41 })","+  })","+","+  it('prefers COLUMNS and LINES over the size forwarded by the CLI', () => {","+    vi.stubEnv('COLUMNS', '132')","+    vi.stubEnv('LINES', '50')","+    vi.stubEnv('FORCE_TTY_COLUMNS', '133')","+    vi.stubEnv('FORCE_TTY_ROWS', '41')","+","+    expect(terminalSize.get()).toEqual({ columns: 132, rows: 50 })","+  })","+","+  it('reads the controlling terminal size and closes the file descriptor', () => {","+    withPlatform('darwin', () => {","+      vi.spyOn(fs, 'openSync').mockReturnValue(99)","+      const closeSync = vi.spyOn(fs, 'closeSync').mockImplementation(() => {})","+","+      execFileSync.mockReturnValue('41 133\\n')","+","+      expect(terminalSize.get()).toEqual({ columns: 133, rows: 41 })","+      expect(execFileSync).toHaveBeenCalledWith('stty', ['size'], expect.objectContaining({ stdio: [99, 'pipe', 'ignore'] }))","+      expect(closeSync).toHaveBeenCalledWith(99)","+    })","+  })","+","+  it('defaults to 80x24 when no size can be found', () => {","+    withPlatform('linux', () => {","+      vi.spyOn(fs, 'openSync').mockImplementation(() => {","+        throw new Error('ENXIO')","+      })","+","+      expect(terminalSize.get()).toEqual({ columns: 80, rows: 24 })","+      expect(execFileSync).toHaveBeenCalledWith('tput', ['cols'], expect.anything())","+    })","+  })","+","+  it('does not look up the terminal on Windows when no size is available', () => {","+    withPlatform('win32', () => {","+      const openSync = vi.spyOn(fs, 'openSync')","+","+      expect(terminalSize.get()).toEqual({ columns: 80, rows: 24 })","+      expect(openSync).not.toHaveBeenCalled()","+      expect(execFileSync).not.toHaveBeenCalled()","+    })","+  })","+","+  it('sets columns to 100 in CI', () => {","+    setStreamSize(process.stdout, 120, 40)","+    vi.mocked(env.get).mockReturnValue('1')","+","+    expect(terminalSize.get()).toEqual({ columns: 100, rows: 40 })","+  })","+})"],"additions":135,"deletions":0,"truncated":false},{"path":"packages/server/test/unit/util/trash.spec.ts","lines":["@@ -7,11 +7,13 @@ import trash from '../../../lib/util/trash'"," "," const trashState = vi.hoisted(() => ({ stub: undefined as Mock | undefined }))"," ","-vi.mock('trash', async (importOriginal) => {","-  const actual = await importOriginal<{ default: (paths: string[]) => Promise<void> }>()","-","+vi.mock('electron', () => {","   return {","-    default: (paths: string[]) => (trashState.stub ?? actual.default)(paths),","+    shell: {","+      trashItem: (itemPath: string) => {","+        return trashState.stub ? trashState.stub(itemPath) : fs.promises.rm(itemPath, { recursive: true })","+      },","+    },","   }"," })"," ","@@ -42,6 +44,8 @@ describe('lib/util/trash', () => {","   let tempDir: string"," ","   beforeEach(async () => {","+    // some agent hosts set this, which would send every platform down the run-as-Node path","+    vi.stubEnv('ELECTRON_RUN_AS_NODE', '')","     tempDir = path.join(os.tmpdir(), `cypress-test-${Date.now()}`)","     await fs.promises.mkdir(tempDir, { recursive: true })","   })","@@ -49,6 +53,7 @@ describe('lib/util/trash', () => {","   afterEach(async () => {","     trashState.stub = undefined","     vi.restoreAllMocks()","+    vi.unstubAllEnvs()","     await fs.promises.rm(tempDir, { recursive: true, force: true })","   })"," ","@@ -68,23 +73,13 @@ describe('lib/util/trash', () => {","       await trash.folder(path.join(tempDir, 'bar'))","     })"," ","-    it('does not throw when trash reports a failure but the item was actually removed', async () => {","-      // Simulates the Windows behavior where the Recycle Bin is set to","-      // \"Don't move files to the Recycle Bin. Remove files immediately when","-      // deleted.\" In that case windows-trash.exe deletes the file but exits","-      // with a non-zero code, which `trash` surfaces as a rejection. See","-      // https://github.com/cypress-io/cypress/issues/32691","+    it('removes items on Windows when trashing fails because the Recycle Bin removes files immediately', async () => {","       vi.spyOn(os, 'platform').mockReturnValue('win32')","       const basePath = path.join(tempDir, 'foo')"," ","       await populateDirectories(basePath)"," ","-      const trashStub = vi.fn(async (paths: string[]) => {","-        // the underlying implementation removes the items...","-        await Promise.all(paths.