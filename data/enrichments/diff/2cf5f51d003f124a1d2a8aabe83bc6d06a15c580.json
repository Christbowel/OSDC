{"id":"2cf5f51d003f124a1d2a8aabe83bc6d06a15c580","axis":"silent","repo":"envoyproxy/envoy","sha":"2cf5f51d003f124a1d2a8aabe83bc6d06a15c580","parsed":{"files":[{"path":"api/envoy/extensions/transport_sockets/tls/v3/common.proto","lines":["@@ -107,8 +107,7 @@ message TlsParameters {","   //   Using TLS protocol versions below TLSv1_2 has serious security considerations and risks.","   TlsProtocol tls_minimum_protocol_version = 1 [(validate.rules).enum = {defined_only: true}];"," ","-  // Maximum TLS protocol version. By default, it's ``TLSv1_2`` for clients and ``TLSv1_3`` for","-  // servers.","+  // Maximum TLS protocol version. By default, it's ``TLSv1_3`` for both clients and servers.","   TlsProtocol tls_maximum_protocol_version = 2 [(validate.rules).enum = {defined_only: true}];"," ","   // If specified, the TLS listener will only support the specified `cipher list"],"additions":1,"deletions":2,"truncated":false},{"path":"changelogs/current/behavior_changes/tls__default-client-max-version-tls-1-3.rst","lines":["@@ -0,0 +1,19 @@","+Upstream TLS connections now default to a maximum TLS version of TLS 1.3 instead of TLS 1.2 when","+:ref:`tls_maximum_protocol_version","+<envoy_v3_api_field_extensions.transport_sockets.tls.v3.TlsParameters.tls_maximum_protocol_version>`","+is not set, which also lets them use the default post-quantum key exchange. When the upstream","+server supports TLS 1.3, an mTLS client certificate rejected by the upstream is reported as a reset","+after the connection is established rather than as a connection failure. In that case,","+``connect-failure`` HTTP retries and TCP proxy","+:ref:`max_connect_attempts","+<envoy_v3_api_field_extensions.filters.network.tcp_proxy.v3.TcpProxy.max_connect_attempts>` don't","+retry it on another endpoint, connect-only","+:ref:`TCP health checks <envoy_v3_api_msg_config.core.v3.HealthCheck.TcpHealthCheck>` pass, and the","+rejection isn't counted in the ``upstream_cx_connect_fail`` cluster statistic. Outlier detection","+also records the connection as successful, so the host isn't ejected for consecutive local origin","+failures caused by TCP proxy connections, or by HTTP requests when","+:ref:`split_external_local_origin_errors","+<envoy_v3_api_field_config.cluster.v3.OutlierDetection.split_external_local_origin_errors>` is","+enabled. This behavior can be reverted by setting the runtime guard","+``envoy.reloadable_features.default_client_tls_max_version_is_1_3`` to ``false``, or per cluster by","+setting ``tls_maximum_protocol_version`` to ``TLSv1_2``."],"additions":19,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -44,6 +44,7 @@ RUNTIME_GUARD(envoy_reloadable_features_conn_pool_fix_reentrancy);"," RUNTIME_GUARD(envoy_reloadable_features_conn_pool_grid_early_return_on_teardown);"," RUNTIME_GUARD(envoy_reloadable_features_connectivity_grid_prevent_double_h2_scheduled);"," RUNTIME_GUARD(envoy_reloadable_features_decouple_explicit_drain_pools_and_dns_refresh);","+RUNTIME_GUARD(envoy_reloadable_features_default_client_tls_max_version_is_1_3);"," // When enabled, which is the default, the dynamic forward proxy cluster replaces a host with a"," // new host instance when DNS resolution changes its address, publishing the change as a regular"," // priority set update (old host removed, new host added) so that connection pools to the stale"],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/tls/context_config_impl.cc","lines":["@@ -362,7 +362,8 @@ unsigned ContextConfigImpl::tlsVersionFromProto("," }"," "," const unsigned ClientContextConfigImpl::DEFAULT_MIN_VERSION = TLS1_2_VERSION;","-const unsigned ClientContextConfigImpl::DEFAULT_MAX_VERSION = TLS1_2_VERSION;","+const unsigned ClientContextConfigImpl::DEFAULT_MAX_VERSION = TLS1_3_VERSION;","+const unsigned ClientContextConfigImpl::DEFAULT_MAX_VERSION_LEGACY = TLS1_2_VERSION;"," "," const std::string ClientContextConfigImpl::DEFAULT_CIPHER_SUITES =","     \"[ECDHE-ECDSA-AES128-GCM-SHA256|ECDHE-ECDSA-CHACHA20-POLY1305]:\"","@@ -404,7 +405,11 @@ ClientContextConfigImpl::ClientContextConfigImpl(","     absl::Status& creation_status)","     : ContextConfigImpl(","           config.common_tls_context(), config.auto_sni_san_validation(), DEFAULT_MIN_VERSION,","-          DEFAULT_MAX_VERSION, FIPS_mode() ? DEFAULT_CIPHER_SUITES_FIPS : DEFAULT_CIPHER_SUITES,","+          Runtime::runtimeFeatureEnabled(","+              \"envoy.reloadable_features.default_client_tls_max_version_is_1_3\")","+              ? DEFAULT_MAX_VERSION","+              : DEFAULT_MAX_VERSION_LEGACY,","+          FIPS_mode() ? DEFAULT_CIPHER_SUITES_FIPS : DEFAULT_CIPHER_SUITES,","           Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.pqc_default_ecdh_curves\")","               ? (FIPS_mode() ? DEFAULT_CURVES_FIPS : DEFAULT_CURVES)","               : (FIPS_mode() ? DEFAULT_CURVES_FIPS_NO_PQC : DEFAULT_CURVES_NO_PQC),"],"additions":7,"deletions":2,"truncated":false},{"path":"source/common/tls/context_config_impl.h","lines":["@@ -177,6 +177,7 @@ class ClientContextConfigImpl : public ContextConfigImpl, public Envoy::Ssl::Cli"," ","   static const unsigned DEFAULT_MIN_VERSION;","   static const unsigned DEFAULT_MAX_VERSION;","+  static const unsigned DEFAULT_MAX_VERSION_LEGACY;"," ","   const std::string server_name_indication_;","   const bool auto_host_sni_ : 1;"],"additions":1,"deletions":0,"truncated":false},{"path":"test/common/tls/integration/ssl_upstream_integration_test.cc","lines":["@@ -217,5 +217,94 @@ TEST_P(SslUpstreamNulSanIntegrationTest, EmbeddedNulSanValidation) {","   expectCertValidationFailure();"," }"," ","+// The upstream rejects the client certificate that Envoy presents. With TLS 1.3, Envoy completes","+// its handshake before the upstream validates the client certificate, so the rejection is reported","+// as a reset after the connection is established rather than as a connection failure.","+class SslUpstreamClientCertRejectedIntegrationTest","+    : public testing::TestWithParam<Network::Address::IpVersion>,","+      public HttpIntegrationTest {","+public:","+  SslUpstreamClientCertRejectedIntegrationTest()","+      : HttpIntegrationTest(Http::CodecType::HTTP1, GetParam()) {","+    setUpstreamProtocol(Http::CodecType::HTTP1);","+  }","+","+  void initialize() override {","+    config_helper_.configureUpstreamTls(","+        false /* use alpn */, false /* http3 */, std::nullopt,","+        [](envoy::extensions::transport_sockets::tls::v3::UpstreamTlsContext& ctx) {","+          auto* tls_cert = ctx.mutable_common_tls_context()->add_tls_certificates();","+          tls_cert->mutable_certificate_chain()->set_filename(","+              TestEnvironment::runfilesPath(\"test/config/integration/certs/clientcert.pem\"));","+          tls_cert->mutable_private_key()->set_filename(","+              TestEnvironment::runfilesPath(\"test/config/integration/certs/clientkey.pem\"));","+        });","+    HttpIntegrationTest::initialize();","+  }","+","+  // The upstream requires a client certificate, but trusts a CA that didn't sign Envoy's.","+  Network::DownstreamTransportSocketFactoryPtr createCustomUpstreamTlsContext() {","+    envoy::extensions::transport_sockets::tls::v3::DownstreamTlsContext tls_context;","+    tls_context.mutable_require_client_certificate()->set_value(true);","+    auto* common_tls_context = tls_context.mutable_common_tls_context();","+    auto* tls_cert = common_tls_context->add_tls_certificates();","+    tls_cert->mutable_certificate_chain()->set_filename(","+        TestEnvironment::runfilesPath(\"test/config/integration/certs/upstreamcert.pem\"));","+    tls_cert->mutable_private_key()->set_filename(","+        TestEnvironment::runfilesPath(\"test/config/integration/certs/upstreamkey.pem\"));","+    common_tls_context->mutable_validation_context()->mutable_trusted_ca()->set_filename(","+        TestEnvironment::runfilesPath(\"test/config/integration/certs/upstreamcacert.pem\"));","+","+    auto cfg_or_error = Extensions::TransportSockets::Tls::ServerContextConfigImpl::create(","+        tls_context, factory_context_, {}, false);","+    RELEASE_ASSERT(cfg_or_error.ok(), std::string(cfg_or_error.status().message()));","+    auto factory_or_error = Extensions::TransportSockets::Tls::ServerSslSocketFactory::create(","+        std::move(*cfg_or_error), BaseIntegrationTest::context_manager_,","+        server_factory_context_.serverScope());","+    RELEASE_ASSERT(factory_or_error.ok(), std::string(factory_or_error.status().message()));","+    return std::move(*factory_or_error);","+  }","+","+  void createUpstreams() override {","+    for (uint32_t i = 0; i < fake_upstreams_count_; ++i) {","+      fake_upstreams_.emplace_back(std::make_unique<AutonomousUpstream>(","+          createCustomUpstreamTlsContext(), upstream_address_fn_(i), upstreamConfig(),","+          autonomous_allow_incomplete_streams_));","+    }","+  }","+};","+","+INSTANTIATE_TEST_SUITE_P(IpVersions, SslUpstreamClientCertRejectedIntegrationTest,","+                         testing::ValuesIn(TestEnvironment::getIpVersionsForTest()),","+                         TestUtility::ipTestParamsToString);","+","+// A client certificate rejected with TLS 1.3 is retried by the `reset` retry policy, but isn't","+// counted as a connection failure.","+TEST_P(SslUpstreamClientCertRejectedIntegrationTest, RetryOnReset) {","+  config_helper_.addConfigModifier(","+      [](envoy::extensions::filters::network::http_connection_manager::v3::HttpConnectionManager&","+             hcm) {","+        auto* retry_policy = hcm.mutable_route_config()","+                                 ->mutable_virtual_hosts(0)","+                                 ->mutable_routes(0)","+                                 ->mutable_route()","+                                 ->mutable_retry_policy();","+        retry_policy->set_retry_on(\"reset\");","+        retry_policy->mutable_num_retries()->set_value(1);","+      });","+  initialize();","+","+  codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+  auto response = codec_client_->makeHeaderOnlyRequest(default_request_headers_);","+  ASSERT_TRUE(response->waitForEndStream());","+  EXPECT_EQ(\"503\", response->headers().getStatusValue());","+  codec_client_->close();","+","+  // Both the request and its retry negotiated TLS 1.3 and were rejected after the handshake.","+  test_server_->waitForCounter(\"cluster.cluster_0.ssl.versions.TLSv1.3\", testing::Eq(2));","+  EXPECT_EQ(1, test_server_->counter(\"cluster.cluster_0.upstream_rq_retry\")->value());","+  EXPECT_EQ(0, test_server_->counter(\"cluster.cluster_0.upstream_cx_connect_fail\")->value());","+}","+"," } // namespace Ssl"," } // namespace Envoy"],"additions":89,"deletions":0,"truncated":false},{"path":"test/common/tls/ssl_socket_test.cc","lines":["@@ -162,6 +162,8 @@ class ClientContextImplPeer {"," "," namespace {"," ","+using TlsParameters = envoy::extensions::transport_sockets::tls::v3::TlsParameters;","+"," /**","  * A base class to hold the options for testUtil() and testUtilV2().","  */","@@ -182,6 +184,15 @@ class TestUtilOptionsBase {","   const std::string& expectedServerStats() const { return expected_server_stats_; }","   bool expectSuccess() const { return expect_success_; }","   Network::Address::IpVersion version() const { return version_; }","+  const std::optional<TlsParameters::TlsProtocol>& clientTlsVersion() const {","+    return client_tls_version_;","+  }","+  // On failure, whether the client completes its handshake before the connection is closed. Failure","+  // tests only limit the client to TLS 1.3 when the server rejects the client certificate, and with","+  // TLS 1.3 the client completes its handshake before the server validates the client certificate.","+  bool expectClientConnectedBeforeFailure() const {","+    return client_tls_version_ == TlsParameters::TLSv1_3;","+  }"," "," protected:","   TestUtilOptionsBase(bool expect_success, Network::Address::IpVersion version)","@@ -208,6 +219,11 @@ class TestUtilOptionsBase {","     expected_server_stats_ = expected_server_stats;","   }"," ","+  // Limits the client to a single TLS version.","+  void setClientTlsVersion(TlsParameters::TlsProtocol tls_version) {","+    client_tls_version_ = tls_version;","+  }","+"," private:","   const bool expect_success_;","   const Network::Address::IpVersion version_;","@@ -217,8 +233,20 @@ class TestUtilOptionsBase {","   std::vector<std::string> expected_client_cert_ip_sans_;","   std::vector<std::string> expected_client_cert_email_sans_;","   std::vector<std::string> expected_client_cert_othername_sans_;","+  std::optional<TlsParameters::TlsProtocol> client_tls_version_;"," };"," ","+// Applies the TLS version from TestUtilOptionsBase::clientTlsVersion(), if any, to the client.","+void applyClientTlsVersion(","+    const TestUtilOptionsBase& options,","+    envoy::extensions::transport_sockets::tls::v3::UpstreamTlsContext& client_tls_context) {","+  if (options.clientTlsVersion().has_value()) {","+    auto* tls_params = client_tls_context.mutable_common_tls_context()->mutable_tls_params();","+    tls_params->set_tls_minimum_protocol_version(*options.clientTlsVersion());","+    tls_params->set_tls_maximum_protocol_version(*options.clientTlsVersion());","+  }","+}","+"," /**","  * A class to hold the options for testUtil().","  */","@@ -243,6 +271,11 @@ class TestUtilOptions : public TestUtilOptionsBase {","     return *this;","   }"," ","+  TestUtilOptions& setClientTlsVersion(TlsParameters::TlsProtocol tls_version) {","+    TestUtilOptionsBase::setClientTlsVersion(tls_version);","+    return *this;","+  }","+","   bool expectNoCert() const { return expect_no_cert_; }"," ","   TestUtilOptions& setExpectNoCert() {","@@ -618,6 +651,7 @@ void testUtil(const TestUtilOptions& options) {","   envoy::extensions::transport_sockets::tls::v3::UpstreamTlsContext client_tls_context;","   TestUtility::loadFromYaml(TestEnvironment::substitute(options.clientCtxYaml()),","                             client_tls_context);","+  applyClientTlsVersion(options, client_tls_context);"," ","   Stats::TestUtil::TestStore client_stats_store;","   Api::ApiPtr client_api = Api::createApiForTest(client_stats_store, time_system);","@@ -895,10 +929,17 @@ void testUtil(const TestUtilOptions& options) {","       std::string ocsp_response{reinterpret_cast<const char*>(response_head), response_len};","       EXPECT_EQ(options.expectedOcspResponse(), ocsp_response);"," ","-      // By default, the session is not created with session resumption. The","-      // client should see a session ID but the server should not.","-      EXPECT_EQ(EMPTY_STRING, server_connection->ssl()->sessionId());","-      EXPECT_NE(EMPTY_STRING, client_connection->ssl()->sessionId());","+      // By default, the session is not created with session resumption. With TLS 1.2, the client","+      // sees a session ID but the server doesn't. TLS 1.3 has no session ID on the client. A","+      // TLS 1.3 server has no session ID with BoringSSL, but OpenSSL creates one when it sends a","+      // ticket.","+      if (client_connection->ssl()->tlsVersion() == \"TLSv1.3\") {","+        EXPECT_EQ(EMPTY_STRING, client_connection->ssl()->sessionId());","+        EXPECT_EQ(SSL_SELECT(true, false), server_connection->ssl()->sessionId().empty());","+      } else {","+        EXPECT_EQ(EMPTY_STRING, server_connection->ssl()->sessionId());","+        EXPECT_NE(EMPTY_STRING, client_connection->ssl()->sessionId());","+      }"," ","       server_connection->close(Network::ConnectionCloseType::NoFlush);","       client_connection->close(Network::ConnectionCloseType::NoFlush);","@@ -921,6 +962,9 @@ void testUtil(const TestUtilOptions& options) {","     EXPECT_CALL(client_connection_callbacks, onEvent(Network::ConnectionEvent::LocalClose));","     EXPECT_CALL(server_connection_callbacks, onEvent(Network::ConnectionEvent::LocalClose));","   } else {","+    if (options.expectClientConnectedBeforeFailure()) {","+      EXPECT_CALL(client_connection_callbacks, onEvent(Network::ConnectionEvent::Connected));","+    }","     EXPECT_CALL(client_connection_callbacks, onEvent(Network::ConnectionEvent::RemoteClose))","         .WillOnce(Invoke([&](Network::ConnectionEvent) -> void { close_second_time(); }));","     EXPECT_CALL(server_connection_callbacks, onEvent(options.expectedServerCloseEvent()))","@@ -952,6 +996,14 @@ void testUtil(const TestUtilOptions& options) {","   }"," }"," ","+// Runs testUtil() for a server that rejects the client certificate, once with TLS 1.2 and once with","+// TLS 1.3. With TLS 1.3, the client completes its handshake before the server validates the client","+// certificate, so the client sees Connected before the server closes the connection.","+void testUtilClientCertRejected(TestUtilOptions& options) {","+  testUtil(options.setClientTlsVersion(TlsParameters::TLSv1_2));","+  testUtil(options.setClientTlsVersion(TlsParameters::TLSv1_3));","+}","+"," /**","  * A class to hold the options for testUtilV2().","  */","@@ -1085,9 +1137,26 @@ class TestUtilOptionsV2 : public TestUtilOptionsBase {","   }"," ","   const std::string& expectedTransportFailureReasonContains() const {","+    if (clientTlsVersion() == TlsParameters::TLSv1_3 &&","+        !expected_tls13_transport_failure_reason_contains_.empty()) {","+      return expected_tls13_transport_failure_reason_contains_;","+    }","     return expected_transport_failure_reason_contains_;","   }"," ","+  // Overrides setExpectedTransportFailureReasonContains() when the client is limited to TLS 1.3,","+  // for failures where the server sends a different alert with TLS 1.3.","+  TestUtilOptionsV2& setExpectedTls13TransportFailureReasonContains(","+      const std::string& expected_transport_failure_reason_contains) {","+    expected_tls13_transport_failure_reason_contains_ = expected_transport_failure_reason_contains;","+    return *this;",