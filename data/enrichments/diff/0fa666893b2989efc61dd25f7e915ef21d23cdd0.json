{"id":"0fa666893b2989efc61dd25f7e915ef21d23cdd0","axis":"silent","repo":"vllm-project/vllm","sha":"0fa666893b2989efc61dd25f7e915ef21d23cdd0","parsed":{"files":[{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -576,6 +576,19 @@ steps:","       commands:","       - pytest -v -s models/qwen3_5/ kernels/mamba/test_gdn_output_projection.py"," ","+- label: \":nvidia: (B200) Nemotron Shortcut\"","+  key: nemotron-shortcut-unit-tests-b200","+  automatic_shard: true","+  timeout_in_minutes: 60","+  device: b200-k8s","+  # test_sdsa_engine.py runs TP2.","+  num_devices: 2","+  source_file_dependencies:","+  - vllm/models/nemotron_shortcut/","+  - tests/models/nemotron_shortcut/","+  commands:","+  - pytest -v -s models/nemotron_shortcut/","+"," - label: \":computer: (CPU) Basic Models Other\"","   key: basic-models-test-other-cpu","   automatic_shard: true"],"additions":13,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/configuration_nemotron4.py","lines":["@@ -0,0 +1,46 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"A stand-in for the `configuration_nemotron4.py` that Nemotron Shortcut","+checkpoints ship as remote code, for the tests' tiny random-weight models.","+vLLM reads the model's fields as attributes, so these configs keep every field","+they are given. `utils.save_checkpoint_config` saves this module next to a","+tiny model's config.json, so the engine loads it as the checkpoint's own.\"\"\"","+","+from transformers import PreTrainedConfig","+from transformers.models.pixtral import PixtralVisionConfig","+","+","+class Nemotron4TextConfig(PreTrainedConfig):","+    model_type = \"nemotron4_text\"","+    base_config_key = \"text_config\"","+","+    @property","+    def num_hidden_layers(self) -> int:","+        return len(self.layer_types)","+","+    def validate_layer_type(self):","+        # The model's own block types, e.g. \"mlp\" and \"shortcut_moe_gdp\".","+        pass","+","+","+class Nemotron4Config(PreTrainedConfig):","+    model_type = \"nemotron4\"","+    sub_configs = {","+        \"text_config\": Nemotron4TextConfig,","+        \"vision_config\": PixtralVisionConfig,","+    }","+","+    def __init__(","+        self,","+        text_config: dict | Nemotron4TextConfig | None = None,","+        vision_config: dict | PixtralVisionConfig | None = None,","+        **kwargs,","+    ):","+        kwargs.setdefault(\"architectures\", [\"Nemotron4ForConditionalGeneration\"])","+        super().__init__(**kwargs)","+        if not isinstance(text_config, Nemotron4TextConfig):","+            text_config = Nemotron4TextConfig(**(text_config or {}))","+        if not isinstance(vision_config, PixtralVisionConfig):","+            vision_config = PixtralVisionConfig(**(vision_config or {}))","+        self.text_config = text_config","+        self.vision_config = vision_config"],"additions":46,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/moe/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/moe/test_kernels.py","lines":["@@ -0,0 +1,128 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The CuTe-DSL MXFP8 experts against a reference (the Triton experts are covered","+by `test_moe.py`).\"\"\"","+","+import pytest","+import torch","+import torch.nn.functional as F","+","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(not current_platform.is_cuda(), reason=\"needs CUDA\")","+","+","+@pytest.mark.skipif(","+    not any(current_platform.is_device_capability(cap) for cap in (100, 103)),","+    reason=\"The CuTe-DSL MXFP8 experts need SM10x\",","+)","+@pytest.mark.parametrize(\"tokens\", [7, 32])","+@pytest.mark.parametrize(\"hidden,intermediate\", [(128, 256), (256, 128)])","+@torch.inference_mode()","+def test_cute_dsl_mxfp8_experts_apply_the_clamp(tokens, hidden, intermediate):","+    \"\"\"The CuTe-DSL MXFP8 experts with a clamp that bites, against a","+    reference that quantizes as they do.\"\"\"","+    from torch import nn","+","+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation","+    from vllm.model_executor.layers.fused_moe.config import (","+        FusedMoEParallelConfig,","+        FusedMoEQuantConfig,","+        RoutingMethodType,","+    )","+    from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","+        dequant_mxfp8_to_bf16,","+        mxfp8_e4m3_quantize,","+    )","+    from vllm.models.nemotron_shortcut.nvidia.moe.config import (","+        NemotronShortcutMoEConfig,","+    )","+    from vllm.models.nemotron_shortcut.nvidia.moe.flashinfer import (","+        NemotronShortcutCuteDslMxfp8Experts,","+        has_cute_dsl_mxfp8,","+    )","+","+    if not has_cute_dsl_mxfp8():","+        pytest.skip(\"FlashInfer without CuTe-DSL MXFP8 ClampedRelu2\")","+    torch.manual_seed(7)","+    device = torch.device(\"cuda\")","+    # The model's activation: relu(c * tanh(x / c)) ** 2, not gated. A small c","+    # makes the clamp change the output.","+    experts, topk, clamp = 8, 2, 0.25","+","+    def quantize(value):","+        flat = value.reshape(-1, value.shape[-1]).contiguous()","+        quant, scales = mxfp8_e4m3_quantize(flat, is_sf_swizzled_layout=False)","+        return quant.reshape(value.shape), scales.reshape(*value.shape[:-1], -1)","+","+    weights = nn.Module()","+    for name, shape in (","+        (\"w13\", (experts, intermediate, hidden)),","+        (\"w2\", (experts, hidden, intermediate)),","+    ):","+        quant, scales = quantize(","+            torch.randn(shape, device=device, dtype=torch.bfloat16) * 0.1","+        )","+        weights.register_buffer(f\"{name}_weight\", quant)","+        weights.register_buffer(f\"{name}_weight_scale\", scales)","+    config = NemotronShortcutMoEConfig(","+        num_experts=experts,","+        experts_per_token=topk,","+        hidden_dim=hidden,","+        intermediate_size=intermediate,","+        num_local_experts=experts,","+        num_logical_experts=experts,","+        moe_parallel_config=FusedMoEParallelConfig.make_no_parallel(),","+        activation=MoEActivation.RELU2_NO_MUL,","+        activation_clamp_value=clamp,","+        in_dtype=torch.bfloat16,","+        device=device,","+        routing_method=RoutingMethodType.TopK,","+        moe_backend=\"flashinfer_cutedsl\",","+    )","+    quant_config = FusedMoEQuantConfig.make(","+        \"mxfp8\",","+        w1_scale=weights.w13_weight_scale,","+        w2_scale=weights.w2_weight_scale,","+        block_shape=[1, 32],","+        is_scale_swizzled=False,","+    )","+    kernel = NemotronShortcutCuteDslMxfp8Experts(config, quant_config)","+    kernel.process_weights_after_loading(weights)","+    x = torch.randn(tokens, hidden, device=device, dtype=torch.bfloat16)","+    ids = torch.rand(tokens, experts, device=device).topk(topk, dim=-1).indices","+    routing = torch.randn(tokens, topk, device=device).softmax(-1)","+    output = torch.empty_like(x)","+    kernel.apply(","+        output,","+        x,","+        weights.w13_weight,","+        weights.w2_weight,","+        routing,","+        ids,","+        MoEActivation.RELU2_NO_MUL,","+        experts,","+        None,","+        None,","+        None,","+        None,","+        None,","+        None,","+        False,","+    )","+    xref = dequant_mxfp8_to_bf16(*quantize(x)).float()","+    w1 = dequant_mxfp8_to_bf16(weights.w13_weight, weights.w13_weight_scale).float()","+    w2 = dequant_mxfp8_to_bf16(weights.w2_weight, weights.w2_weight_scale).float()","+    expected = torch.zeros_like(output, dtype=torch.float32)","+    for expert in range(experts):","+        rows, slots = torch.where(ids == expert)","+        if rows.numel() == 0:","+            continue","+        up = F.linear(xref[rows], w1[expert])","+        activated = (clamp * torch.tanh(up / clamp)).clamp_min(0).square()","+        activated = dequant_mxfp8_to_bf16(*quantize(activated.bfloat16())).float()","+        down = F.linear(activated, w2[expert])","+        expected.index_add_(0, rows, down * routing[rows, slots, None])","+    assert torch.isfinite(output).all()","+    error = (output.float() - expected).norm() / expected.norm()","+    assert error < 0.05, error.item()"],"additions":128,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/moe/test_moe.py","lines":["@@ -0,0 +1,216 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Nemotron Shortcut's MoE layer: numerics, checkpoint loading and graph replay.\"\"\"","+","+import pytest","+import torch","+import torch.nn.functional as F","+from torch import nn","+","+from vllm.config import get_current_vllm_config","+from vllm.forward_context import set_forward_context","+from vllm.model_executor.models.utils import AutoWeightsLoader","+from vllm.models.nemotron_shortcut.nvidia.moe import NemotronShortcutMoE","+from vllm.models.nemotron_shortcut.nvidia.moe.flashinfer import has_cute_dsl_options","+from vllm.platforms import current_platform","+from vllm.utils.torch_utils import set_default_torch_dtype","+","+from ..utils import build, make_config","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_cuda(), reason=\"Triton experts need CUDA\"","+)","+","+","+@pytest.fixture(autouse=True)","+def _forward_context(dist_init, workspace_init):","+    with torch.inference_mode(), set_forward_context(None, get_current_vllm_config()):","+        yield","+","+","+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])","+@pytest.mark.parametrize(\"top_k,shared_size\", [(1, None), (2, 16)])","+@pytest.mark.parametrize(\"bias_space\", [\"score\", \"logit\"])","+def test_matches_a_per_expert_reference(dtype, top_k, shared_size, bias_space):","+    \"\"\"Selection-only bias, weighting before the down projection, FP32 sum.","+","+    `\"logit\"` selects on `logits + bias` instead of `sigmoid(logits) + bias`;","+    the mixing weights are the unbiased sigmoid scores either way.","+    \"\"\"","+    config = make_config(","+        num_experts_per_tok=top_k,","+        moe_shared_expert_intermediate_size=shared_size,","+        moe_router_bias_space=bias_space,","+    )","+    with set_default_torch_dtype(dtype):","+        moe = build(lambda: NemotronShortcutMoE(config))","+    experts = moe.experts.routed_experts","+    # Exercise the soft clamp and the low-precision rounding.","+    experts.w13_weight.mul_(100)","+    bias = moe.gate.e_score_correction_bias","+    bias.copy_(torch.linspace(-0.6, 0.6, config.n_routed_experts, device=\"cuda\"))","+    routed = torch.randn(7, config.hidden_size, device=\"cuda\", dtype=dtype) * 3","+    shared = torch.randn_like(routed)","+","+    logits = F.linear(routed.float(), moe.gate.weight.float())","+    scores = logits.sigmoid()","+    ids = ((logits if bias_space == \"logit\" else scores) + bias).topk(top_k).indices","+    if bias_space == \"logit\":","+        # Otherwise this case would not tell the two spaces apart.","+        score_ids = (scores + bias).topk(top_k).indices","+        assert not torch.equal(ids.sort(-1).values, score_ids.sort(-1).values)","+    weights = scores.gather(1, ids)","+    if top_k > 1:","+        weights /= weights.sum(-1, keepdim=True) + 1e-20","+    weights *= config.routed_scaling_factor","+    clamp = config.activation_clamp_value","+    latent = F.linear(routed, moe.fc1_latent_proj.weight)","+    expected = torch.zeros_like(latent, dtype=torch.float32)","+    for expert in range(config.n_routed_experts):","+        token, slot = torch.where(ids == expert)","+        hidden = F.linear(latent[token], experts.w13_weight[expert])","+        hidden = (clamp * torch.tanh(hidden.float() / clamp)).to(dtype)","+        hidden = (hidden.relu().square().float() * weights[token, slot, None]).to(dtype)","+        expected[token] += F.linear(hidden, experts.w2_weight[expert]).float()","+    expected = expected.to(dtype).float()","+    expected *= torch.rsqrt(","+        expected.square().mean(-1, keepdim=True) + config.rms_norm_eps","+    )","+    expected = expected.to(dtype) * moe.fc2_norm.weight","+    expected = F.linear(expected, moe.fc2_latent_proj.weight)","+    if shared_size is not None:","+        hidden = F.linear(shared, moe.shared_experts.up_proj.weight)","+        hidden = (clamp * torch.tanh(hidden.float() / clamp)).to(dtype)","+        expected += F.linear(","+            hidden.relu().square(), moe.shared_experts.down_proj.weight","+        )","+","+    torch.testing.assert_close(","+        moe(routed, shared),","+        expected,","+        atol=2e-3 if dtype == torch.bfloat16 else 2e-6,","+        rtol=2e-2 if dtype == torch.bfloat16 else 2e-5,","+    )","+","+","+def test_loads_packed_experts_and_router_bias():","+    \"\"\"Loading overwrites every declared checkpoint tensor, experts included.\"\"\"","+    moe = build(lambda: NemotronShortcutMoE(make_config()))","+    weights = {name: torch.randn_like(param) for name, param in moe.named_parameters()}","+    wrapper = nn.Module()","+    wrapper.moe = moe","+    checkpoint = {","+        \"moe.\"","+        + name.replace(\"experts.routed_experts.w13_weight\", \"experts.up_proj\").replace(","+            \"experts.routed_experts.w2_weight\", \"experts.down_proj\"","+        ): value","+        for name, value in weights.items()","+    }","+","+    assert AutoWeightsLoader(wrapper).load_weights(checkpoint.items()) == {","+        \"moe.\" + name for name in weights","+    }","+    for name, param in moe.named_parameters():","+        torch.testing.assert_close(param, weights[name], atol=0, rtol=0)","+","+","+@pytest.mark.skipif(","+    not current_platform.is_device_capability_family(100)","+    or not has_cute_dsl_options(\"routing_weights_before_fc2\", \"clamped_relu2_limit\"),","+    reason=\"NVFP4 experts need SM10x and FlashInfer's routing_weights_before_fc2\",","+)","+def test_loads_nvfp4_expert_scales_without_folding_twice():","+    \"\"\"Fused checkpoint keys keep each expert's own global scales.\"\"\"","+    from vllm.model_executor.layers.quantization.modelopt import ModelOptNvFp4Config","+","+    quant = ModelOptNvFp4Config(","+        is_checkpoint_nvfp4_serialized=True,","+        exclude_modules=[\"*.fc1_latent_proj\", \"*.fc2_latent_proj\"],","+    )","+    with set_default_torch_dtype(torch.bfloat16), torch.device(\"cuda\"):","+        moe = NemotronShortcutMoE(","+            make_config(","+                hidden_size=256,","+                moe_latent_size=256,","+                moe_intermediate_size=512,","+                moe_shared_expert_intermediate_size=None,","+            ),","+            quant_config=quant,","+            prefix=\"moe\",","+        )","+    experts = moe.experts.routed_experts","+    checkpoint, expected = {}, {}","+    per_expert = torch.arange(1, 9, device=\"cuda\").float()","+    for projection, parameter, rows, width, byte in (","+        (\"up_proj\", \"w13\", 512, 256, 17),","+        (\"down_proj\", \"w2\", 256, 512, 91),","+    ):","+        tensors = {","+            (\"\", \"_weight\"): (per_expert[:, None, None] + byte)","+            .expand(8, rows, width // 2)","+            .to(torch.uint8)","+            .contiguous(),","+            (\"_scale\", \"_weight_scale\"): (per_expert[:, None, None] / 4)","+            .expand(8, rows, width // 16)","+            .to(torch.float8_e4m3fn)","+            .contiguous(),","+            (\"_scale_2\", \"_weight_scale_2\"): per_expert / 128,","+            (\"_input_scale\", \"_input_scale\"): per_expert / 1024,","+        }","+        for (source, target), tensor in tensors.items():","+            checkpoint[f\"moe.experts.{projection}{source}\"] = tensor","+            expected[parameter + target] = tensor.reshape_as(","+                getattr(experts, parameter + target)","+            )","+    wrapper = nn.Module()","+    wrapper.moe = moe","+","+    assert AutoWeightsLoader(wrapper).load_weights(checkpoint.items()) == {","+        \"moe.experts.routed_experts.\" + name for name in expected","+    }","+    for name, tensor in expected.items():","+        actual = getattr(experts, name)","+        assert actual.dtype == tensor.dtype","+        torch.testing.assert_close(actual.float(), tensor.float(), atol=0, rtol=0)","+    experts.quant_method.process_weights_after_loading(experts)","+    assert experts.quant_method.moe_kernel is not None","+    kernel = experts.quant_method.moe_kernel.fused_experts","+    # The ModelOpt loader folds the shared activation scale exactly once.","+    for alphas, weight, activation in (","+        (kernel.g1_alphas, \"w13_weight_scale_2\", \"w13_input_scale\"),","+        (kernel.g2_alphas, \"w2_weight_scale_2\", \"w2_input_scale\"),","+    ):","+        assert alphas is not None","+        torch.testing.assert_close(","+            alphas.flatten(), expected[weight].flatten() * expected[activation].max()","+        )","+","+","+@pytest.mark.parametrize(\"compiled\", [False, True])","+def test_graph_replay_routes_the_new_inputs(compiled):","+    \"\"\"A replayed capture routes the new inputs, not the captured ones.\"\"\"","+    moe = build(lambda: NemotronShortcutMoE(make_config()))","+    forward = torch.compile(moe, fullgraph=True) if compiled else moe","+    moe.gate.e_score_correction_bias.zero_()","+    # More than 32 tokens: torch.compile cannot trace GateLinear's CuTe-DSL tier","+    # for at most 32 tokens, which vLLM never traces (it compiles at","+    # max_num_batched_tokens).","+    routed = torch.randn(48, 32, device=\"cuda\")","+    shared = torch.randn_like(routed)","+    warmup = torch.cuda.Stream()","+    warmup.wait_stream(torch.cuda.current_stream())","+    with torch.cuda.stream(warmup):","+        for _ in range(3):","+            forward(routed, shared)","+    torch.cuda.current_stream().wait_stream(warmup)","+    graph = torch.cuda.CUDAGraph()","+    with torch.cuda.graph(graph):","+        output = forward(routed, shared)","+    graph.replay()","+    first = output.clone()","+    routed.neg_()  # Top-2 of eight logits becomes the bottom-2.","+    shared.add_(1)","+    graph.replay()","+","+    torch.testing.assert_close(output, moe(routed, shared), atol=2e-6, rtol=2e-5)","+    assert not torch.equal(output, first)"],"additions":216,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/moe/test_overlap.py","lines":["@@ -0,0 +1,193 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The staged MoE overlaps the DP all-gather and reduce-scatter with the mixer","+and the shared experts, without changing the results.\"\"\"","+","+from unittest.mock import patch","+","+import pytest","+import torch","+","+from vllm.config import CUDAGraphMode, get_current_vllm_config","+from vllm.forward_context import set_forward_context","+from vllm.model_executor.layers.fused_moe.prepare_finalize import naive_dp_ep","+from vllm.model_executor.layers.fused_moe.prepare_finalize.naive_dp_ep import (","+    MoEPrepareAndFinalizeNaiveDPEPModular,","+)","+from vllm.model_executor.layers.fused_moe.prepare_finalize.no_dp_ep import (","+    MoEPrepareAndFinalizeNoDPEPModular,","+)","+from vllm.models.nemotron_shortcut.nvidia.moe import (","+    NemotronShortcutMoE,","+    NemotronShortcutMoERunner,","+)","+from vllm.platforms import current_platform","+from vllm.utils.torch_utils import set_default_torch_dtype","+","+from ..utils import build as _build","+from ..utils import make_config as _config","+","+pytestmark = pytest.mark.skipif(not current_platform.is_cuda(), reason=\"CUDA\")","+","+","+class _FakeEPGroup:","+    \"\"\"Two-rank stand-in: gather duplicates rows, reduce-scatter folds them.\"\"\"","+","+    def __init__(self) -> None:","+        self.streams: list[int] = []","+","+    def dispatch(self, x, topk_weights, topk_ids, is_sequence_parallel, extra_tensors):","+        assert extra_tensors is None","+        self.streams.append(torch.cuda.current_stream().cuda_stream)","+        # Slow enough that an unjoined consumer would observe stale data.","+        torch.cuda._sleep(2_000_000)","+        return (","+            torch.cat((x, x * 2)),","+            torch.cat((topk_weights, topk_weights * 2)),","+            torch.cat((topk_ids, topk_ids)),","+        )","+","+    def combine_into_output(self, hidden_states, output, is_sequence_parallel):","+        self.streams.append(torch.cuda.current_stream().cuda_stream)","+        torch.cuda._sleep(2_000_000)","+        rows = output.shape[0]","+        torch.add(hidden_states[:rows], hidden_states[rows:], out=output)","+        return output","+","+    def allocate_combine_input(self, shape, dtype, device, is_sequence_parallel):","+        return None","+","+","+@pytest.fixture","+def group(dist_init, workspace_init, monkeypatch):","+    group = _FakeEPGroup()","+    monkeypatch.setattr(naive_dp_ep, \"get_ep_group\", lambda: group)","+    with torch.inference_mode(), set_forward_context(None, get_current_vllm_config()):","+        yield group","+","+","+def _moe(dtype: torch.dtype) -> NemotronShortcutMoE:","+    \"\"\"A layer on the all-gather/reduce-scatter transport, sized so that BF16","+    may select FlashInfer's experts (the `FusedMoEKernel.apply` path).\"\"\"","+    config = _config(","+        hidden_size=256,","+        moe_latent_size=128,","+        moe_intermediate_size=128,","+        moe_shared_expert_intermediate_size=128,","+    )","+    with set_default_torch_dtype(dtype):","+        moe = _build(lambda: NemotronShortcutMoE(config))","+    kernel = moe.experts.routed_experts.quant_method.moe_kernel","+    kernel.impl.prepare_finalize = MoEPrepareAndFinalizeNaiveDPEPModular()","+    return moe","+","+","+def _forward(moe, routed, shared):","+    \"\"\"A shortcut block's stages, with a stand-in for the mixer.\"\"\"","+    dispatch = moe.begin_staged(routed)","+    projection = shared * 0.5","+    dispatch = moe.receive_staged(dispatch, (projection,))","+    combine = moe.run_staged_experts(dispatch, projection)","+    return moe.finish_staged(combine, shared)","+","+","+def _synchronous(moe, routed, shared, forward=_forward):","+    with patch.object(NemotronShortcutMoERunner, \"overlaps_transport\", False):","+        return forward(moe, routed, shared).clone()","+","+","+def _inputs(moe):","+    torch.manual_seed(0)","+    # More than 32 tokens: torch.compile cannot trace GateLinear's CuTe-DSL tier","+    # below that, which vLLM never traces.","+    routed = torch.randn(48, 256, device=\"cuda\", dtype=moe.gate.weight.dtype)","+    return routed, torch.randn_like(routed)","+","+","+def _warm_up(moe, routed, shared):","+    stream = torch.cuda.Stream()","+    stream.wait_stream(torch.cuda.current_stream())","+    with torch.cuda.stream(stream):","+        _forward(moe, routed, shared)","+    torch.cuda.current_stream().wait_stream(stream)","+","+","+def test_overlaps_only_the_all_gather_transport_without_dbo(group):","+    moe = _moe(torch.bfloat16)","+    runner = moe.experts","+    assert runner.overlaps_transport","+    runner.enable_dbo = True","+    assert not runner.overlaps_transport","+    runner.enable_dbo = False","+    kernel = runner.routed_experts.quant_method.moe_kernel","+    kernel.impl.prepare_finalize = MoEPrepareAndFinalizeNoDPEPModular()","+    assert not runner.overlaps_transport","+","+","+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])","+@pytest.mark.parametrize(\"compiled\", [False, True])","+def test_overlap_matches_the_synchronous_transport(group, dtype, compiled):","+    moe = _moe(dtype)","+    routed, shared = _inputs(moe)","+    forward = torch.compile(_forward, fullgraph=True) if compiled else _forward","+    # The same graph: inductor rounds the code around the stages its own way.","+    expected = _synchronous(moe, routed, shared, forward)","+    compute_stream = torch.cuda.current_stream().cuda_stream","+    group.streams.clear()","+","+    actual = forward(moe, routed, shared)","+","+    torch.testing.assert_close(actual, expected, atol=0, rtol=0)","+    assert len(group.streams) == 2","+    assert compute_stream not in group.streams","+","+","+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])","+def test_full_graph_replays_the_overlap(group, dtype):","+    \"\"\"One capture of all stages: the experts and the finish join the side","+    stream inside it.\"\"\"","+    moe = _moe(dtype)","+    routed, shared = _inputs(moe)","+    _warm_up(moe, routed, shared)","+    graph = torch.cuda.CUDAGraph()","+    with torch.cuda.graph(graph):","+        output = _forward(moe, routed, shared)","+    routed.neg_()","+    shared.mul_(-0.5)","+","+    graph.replay()","+","+    torch.testing.assert_close(","+        output, _synchronous(moe, routed, shared), atol=0, rtol=0","+    )","+","+","+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])","+def test_graph_pieces_join_the_dispatch_before_they_end(group, dtype):","+    \"\"\"Piecewise capture splits the stages at the mixer's attention op, here","+    between the two graphs: the first must join the dispatch it forked, or","+    its capture fails.\"\"\"","+    moe = _moe(dtype)","+    routed, shared = _inputs(moe)","+    _warm_up(moe, routed, shared)","+    pool = torch.cuda.graph_pool_handle()","+    before, after = torch.cuda.CUDAGraph(), torch.cuda.CUDAGraph()","+    with set_forward_context(","+        None, get_current_vllm_config(), cudagraph_runtime_mode=CUDAGraphMode.PIECEWISE","+    ):","+        with torch.cuda.graph(before, pool=pool):","+            dispatch = moe.begin_staged(routed)","+            projection = shared * 0.5","+            dispatch = moe.receive_staged(dispatch, (projection,))","+        with torch.cuda.graph(after, pool=pool):","+            combine = moe.run_staged_experts(dispatch, projection)","+            output = moe.finish_staged(combine, shared)","+    routed.neg_()","+    shared.mul_(-0.5)","+","+    before.replay()","+    after.replay()","+","+    torch.testing.assert_close(","+        output, _synchronous(moe, routed, shared), atol=0, rtol=0","+    )"],"additions":193,"deletions":0,"truncated":false},{"path":"tests/models/nemotron_shortcut/moe/test_selection.py","lines":["@@ -0,0 +1,200 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"How Nemotron Shortcut picks its experts implementation (no GPU needed).","+","+Every path must end in an experts class that applies the clamp: a generic","+ReLU² backend would run and silently drop it.","+\"\"\"","+","+from dataclasses import replace","+from types import SimpleNamespace","+from unittest.mock import Mock","+","+import pytest","+import torch","+","+from vllm.model_executor.layers.fused_moe.activation import MoEActivation","+from vllm.model_executor.layers.fused_moe.config import (","+    FusedMoEParallelConfig,","+    FusedMoEQuantConfig,","+    RoutingMethodType,","+)","+from vllm.models.nemotron_shortcut.nvidia.moe import experts as moe_experts","+from vllm.models.nemotron_shortcut.nvidia.moe import flashinfer as moe_flashinfer","+from vllm.models.nemotron_shortcut.nvidia.moe.config import NemotronShortcutMoEConfig","+","+","+def _moe_config(**overrides) -> NemotronShortcutMoEConfig:","+    values = dict(","+        num_experts=64,","+        experts_per_token=4,","+        hidden_dim=256,","+        intermediate_size=1024,","+        num_local_experts=64,","+        num_logical_experts=64,","+        moe_parallel_config=FusedMoEParallelConfig.make_no_parallel(),","+        activation=MoEActivation.RELU2_NO_MUL,","+        activation_clamp_value=4.0,","+        in_dtype=torch.bfloat16,","+        device=\"cpu\",","+        routing_method=RoutingMethodType.TopK,","+        moe_backend=\"triton\",","+    )","+    values.update(overrides)","+    return NemotronShortcutMoEConfig(**values)","+","+","+def _supported(monkeypatch, cls, supported: bool = True) -> None:","+    monkeypatch.setattr(cls, \"_supports_current_device\", lambda: supported)","+","+","+@pytest.mark.parametrize(","+    \"override\",","+    [","+        {\"pcp_size\": 2},","+        {\"sp_size\": 2},","+        {\"enable_eplb\": True},","+        {\"all2all_backend\": \"deepep_low_latency\"},","+        {\"placement\": \"round_robin\"},","+    ],","+)","+def test_expert_parallel_rejects_dispatching_tokens(override):","+    \"\"\"The experts run every token, so EP must not redistribute tokens.\"\"\"","+    options = dict(","+        use_ep=True,","+        dp_size=1,","+        pcp_size=1,","+        sp_size=1,","+        enable_eplb=False,","+        all2all_backend=\"allgather_reducescatter\",","+        placement=\"linear\",","+    )","+    options.update(override)","+    layer = SimpleNamespace(expert_placement_strategy=options.pop(\"placement\"))","+    options[\"is_sequence_parallel\"] = override.get(\"sp_size\", 1) != 1","+    config = SimpleNamespace(moe_parallel_config=SimpleNamespace(**options))","+    with pytest.raises(NotImplementedError):","+        moe_experts.NemotronShortcutRoutedExperts._get_quant_method(","+            layer, \"test\", None, config","+        )","+","+","+def test_mixed_precision_resolves_each_expert_group(monkeypatch):","+    \"\"\"One checkpoint may mix NVFP4 experts, MXFP8 experts and BF16 experts.\"\"\"","+    quant = moe_experts.ModelOptMixedPrecisionConfig.from_config(","+        {","+            \"quant_algo\": \"MIXED_PRECISION\",","+            \"quantized_layers\": {","+                \"model.language_model.layers.0.moe.experts\": {","+                    \"quant_algo\": \"NVFP4\",","+                    \"group_size\": 16,","+                },","+                \"model.language_model.layers.1.moe.experts\": {\"quant_algo\": \"MXFP8\"},","+                \"lm_head\": {\"quant_algo\": \"W4A16_NVFP4\", \"group_size\": 16},","+            },","+        }","+    )","+    monkeypatch.setattr(moe_experts.current_platform, \"is_cuda\", lambda: True)","+    monkeypatch.setattr(","+        moe_experts.current_platform, \"has_device_capability\", lambda _: True","+    )","+    config = _moe_config()","+    for index, name, args in (","+        (0, \"NemotronShortcutModelOptNvFp4MoEMethod\", (quant.nvfp4_config, config)),","+        (1, \"NemotronShortcutModelOptMxfp8MoEMethod\", (config,)),","+        (2, \"NemotronShortcutMoEMethod\", (config,)),","+    ):","+        factory = Mock()","+        monkeypatch.setattr(moe_experts, name, factory)","+        result = moe_experts.NemotronShortcutRoutedExperts._get_quant_method(","+            SimpleNamespace(),","+            f\"language_model.model.layers.{index}.moe.experts\",","+            quant,","+            config,","+        )","+        assert result is factory.return_value","+        factory.assert_called_once_with(*args)","+","+","+@pytest.mark.parametrize(\"flashinfer\", [False, True])","+def test_unquantized_experts_prefer_flashinfer(monkeypatch, flashinfer):","+    _supported(","+        monkeypatch, moe_flashinfer.NemotronShortcutFlashInferExperts, flashinfer","+    )","+    method = moe_experts.NemotronShortcutMoEMethod(_moe_config(moe_backend=\"auto\"))","+    expected = (","+        moe_flashinfer.NemotronShortcutFlashInferExperts","+        if flashinfer"],"additions":127,"deletions":0,"truncated":false}],"additions":727,"deletions":0,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-23T19:31:31.856340+00:00"}