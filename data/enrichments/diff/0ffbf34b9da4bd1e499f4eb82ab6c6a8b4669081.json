s":2,"truncated":false},{"path":"config/configtls/clientcasfilereloader.go","lines":["@@ -4,23 +4,61 @@"," package configtls // import \"go.opentelemetry.io/collector/config/configtls\""," "," import (","+\t\"crypto/sha256\""," \t\"crypto/tls\""," \t\"crypto/x509\"","-\t\"errors\""," \t\"fmt\"","+\t\"os\"","+\t\"path/filepath\""," \t\"sync\"","-","-\t\"github.com/fsnotify/fsnotify\"","+\t\"time\""," )"," ","+// defaultClientCAsReloadInterval bounds how often the client CA file is checked","+// for modifications. The check only happens while TLS handshakes are being","+// served, so an idle server does no work at all.","+const defaultClientCAsReloadInterval = time.Second","+"," type clientCAsFileReloader struct {","-\tclientCAsFile   string","+\tclientCAsFile string","+\tloader        clientCAsFileLoader","+\t// reloadInterval is the minimum duration between two checks of","+\t// clientCAsFile. Overridden by tests.","+\treloadInterval time.Duration","+","+\tlock            sync.Mutex"," \tcertPool        *x509.CertPool"," \tlastReloadError error","-\tlock            sync.RWMutex","-\tloader          clientCAsFileLoader","-\twatcher         *fsnotify.Watcher","-\tshutdownCH      chan bool","+\t// lastCheck is when clientCAsFile was most recently checked for changes.","+\tlastCheck time.Time","+\t// fileID identifies the contents of clientCAsFile as of the last check.","+\tfileID fileIdentity","+}","+","+// fileIdentity identifies the contents of a file by hash.","+//","+// Hashing the contents rather than comparing os.Stat metadata keeps detection","+// independent of how the file came to be updated. In particular, Kubernetes","+// projects ConfigMap and Secret volumes as a symlink to a timestamped directory","+// and swaps that symlink on update, so the path being read resolves to a","+// different underlying inode each time; and file modification timestamps carry","+// filesystem-dependent granularity. Reading the file each check sidesteps both.","+// The read is bounded by reloadInterval and CA bundles are small.","+type fileIdentity struct {","+\texists bool","+\tsum    [sha256.Size]byte","+}","+","+// identifyFile returns the identity of the file at path, following symlinks. A","+// path that cannot be read yields the zero identity, which never compares equal","+// to that of a readable file, so a file that disappears or reappears is always","+// treated as a change.","+func identifyFile(path string) fileIdentity {","+\tcontents, err := os.ReadFile(filepath.Clean(path))","+\tif err != nil {","+\t\treturn fileIdentity{}","+\t}","+\treturn fileIdentity{exists: true, sum: sha256.Sum256(contents)}"," }"," "," type clientCAsFileLoader interface {","@@ -28,25 +66,31 @@ type clientCAsFileLoader interface {"," }"," "," func newClientCAsReloader(clientCAsFile string, loader clientCAsFileLoader) (*clientCAsFileReloader, error) {","+\t// Identify the file before loading it, so that a change racing with the","+\t// initial load is detected by the next check rather than being missed.","+\tfileID := identifyFile(clientCAsFile)","+"," \tcertPool, err := loader.loadClientCAFile()"," \tif err != nil {"," \t\treturn nil, fmt.Errorf(\"failed to load client CA CertPool: %w\", err)"," \t}"," ","-\treloader := &clientCAsFileReloader{","-\t\tclientCAsFile: clientCAsFile,","-\t\tcertPool:      certPool,","-\t\tloader:        loader,","-\t\tshutdownCH:    nil,","-\t\twatcher:       nil,","-\t}","-","-\treturn reloader, nil","+\treturn &clientCAsFileReloader{","+\t\tclientCAsFile:  clientCAsFile,","+\t\tloader:         loader,","+\t\treloadInterval: defaultClientCAsReloadInterval,","+\t\tcertPool:       certPool,","+\t\tlastCheck:      time.Now(),","+\t\tfileID:         fileID,","+\t}, nil"," }"," "," func (r *clientCAsFileReloader) getClientConfig(original *tls.Config) (*tls.Config, error) {","-\tr.lock.RLock()","-\tdefer r.lock.RUnlock()","+\tr.lock.Lock()","+\tdefer r.lock.Unlock()","+","+\tr.reloadIfModified(time.Now())","+"," \treturn &tls.Config{"," \t\tRootCAs:              original.RootCAs,"," \t\tGetCertificate:       original.GetCertificate,","@@ -59,16 +103,31 @@ func (r *clientCAsFileReloader) getClientConfig(original *tls.Config) (*tls.Conf"," \t}, nil"," }"," ","-func (r *clientCAsFileReloader) reload() {","-\tr.lock.Lock()","-\tdefer r.lock.Unlock()","+// reloadIfModified reloads the client CA CertPool if clientCAsFile has changed","+// since the last check. Checks are rate limited to one per reloadInterval. A","+// failed reload is recorded and leaves the previously loaded CertPool in place,","+// so that a truncated or malformed file cannot break client authentication.","+//","+// The caller must hold r.lock.","+func (r *clientCAsFileReloader) reloadIfModified(now time.Time) {","+\tif now.Sub(r.lastCheck) < r.reloadInterval {","+\t\treturn","+\t}","+\tr.lastCheck = now","+","+\tfileID := identifyFile(r.clientCAsFile)","+\tif fileID == r.fileID {","+\t\treturn","+\t}","+\tr.fileID = fileID","+"," \tcertPool, err := r.loader.loadClientCAFile()"," \tif err != nil {"," \t\tr.lastReloadError = err","-\t} else {","-\t\tr.certPool = certPool","-\t\tr.lastReloadError = nil","+\t\treturn"," \t}","+\tr.certPool = certPool","+\tr.lastReloadError = nil"," }"," "," func (r *clientCAsFileReloader) getLastError() error {","@@ -76,67 +135,3 @@ func (r *clientCAsFileReloader) getLastError() error {"," \tdefer r.lock.Unlock()"," \treturn r.lastReloadError"," }","-","-func (r *clientCAsFileReloader) startWatching() error {","-\tif r.shutdownCH != nil {","-\t\treturn errors.New(\"client CA file watcher already started\")","-\t}","-","-\twatcher, err := fsnotify.NewWatcher()","-\tif err != nil {","-\t\treturn fmt.Errorf(\"failed to create watcher to reload client CA CertPool: %w\", err)","-\t}","-\tr.watcher = watcher","-","-\terr = watcher.Add(r.clientCAsFile)","-\tif err != nil {","-\t\treturn fmt.Errorf(\"failed to add client CA file to watcher: %w\", err)","-\t}","-","-\tr.shutdownCH = make(chan bool)","-\tgo r.handleWatcherEvents()","-","-\treturn nil","-}","-","-func (r *clientCAsFileReloader) handleWatcherEvents() {","-\tdefer r.watcher.Close()","-\tfor {","-\t\tselect {","-\t\tcase _, ok := <-r.shutdownCH:","-\t\t\t_ = ok","-\t\t\treturn","-\t\tcase event, ok := <-r.watcher.Events:","-\t\t\tif !ok {","-\t\t\t\tcontinue","-\t\t\t}","-\t\t\t// NOTE: k8s configmaps uses symlinks, we need this workaround.","-\t\t\t// original configmap file is removed.","-\t\t\t// SEE: https://martensson.io/go-fsnotify-and-kubernetes-configmaps/","-\t\t\tif event.Has(fsnotify.Remove) || event.Has(fsnotify.Chmod) {","-\t\t\t\t// remove the watcher since the file is removed","-\t\t\t\tif err := r.watcher.Remove(event.Name); err != nil {","-\t\t\t\t\tr.lastReloadError = err","-\t\t\t\t}","-\t\t\t\t// add a new watcher pointing to the new symlink/file","-\t\t\t\tif err := r.watcher.Add(r.clientCAsFile); err != nil {","-\t\t\t\t\tr.lastReloadError = err","-\t\t\t\t}","-\t\t\t\tr.reload()","-\t\t\t}","-\t\t\tif event.Has(fsnotify.Write) {","-\t\t\t\tr.reload()","-\t\t\t}","-\t\t}","-\t}","-}","-","-func (r *clientCAsFileReloader) shutdown() error {","-\tif r.shutdownCH == nil {","-\t\treturn errors.New(\"client CAs file watcher is not running\")","-\t}","-\tr.shutdownCH <- true","-\tclose(r.shutdownCH)","-\tr.shutdownCH = nil","-\treturn nil","-}"],"additions":84,"deletions":89,"truncated":false},{"path":"config/configtls/clientcasfilereloader_test.go","lines":["@@ -4,11 +4,12 @@"," package configtls"," "," import (","+\t\"crypto/tls\""," \t\"crypto/x509\"","-\t\"fmt\"","+\t\"errors\""," \t\"os\""," \t\"path/filepath\"","-\t\"sync/atomic\"","+\t\"sync\""," \t\"testing\""," \t\"time\""," ","@@ -16,68 +17,136 @@ import ("," \t\"github.com/stretchr/testify/require\""," )"," ","-func TestCannotShutdownIfNotWatching(t *testing.T) {","-\treloader, _, _ := createReloader(t)","-\terr := reloader.shutdown()","-\tassert.Error(t, err)","-}","+func TestReloaderLoadsOnceOnCreation(t *testing.T) {","+\trelo