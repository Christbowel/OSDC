"+\tassert.Equal(t, 2, loader.reloadNumber())","+}"," ","-\terr = reloader.shutdown()","-\tassert.NoError(t, err)","+func TestReloaderKeepsPreviousPoolWhenReloadFails(t *testing.T) {","+\treloader, loader, filePath := createReloader(t)","+\toriginalPool := loader.lastReturnedPool()","+","+\tloader.returnErrorOnSubsequentCalls(\"test error on reload\")","+\twriteFile(t, filePath, \"updated contents\")","+","+\tclientCfg, err := reloader.getClientConfig(&tls.Config{})","+\trequire.NoError(t, err)","+","+\tassert.Equal(t, 2, loader.reloadNumber())","+\tassert.Same(t, originalPool, clientCfg.ClientCAs)","+\trequire.EqualError(t, reloader.getLastError(), \"test error on reload\")"," }"," ","-func TestErrorRecordedIfFileDeleted(t *testing.T) {","+func TestReloaderRecordsErrorIfFileDeleted(t *testing.T) {"," \treloader, loader, filePath := createReloader(t)"," ","-\terr := reloader.startWatching()","+\tloader.returnErrorOnSubsequentCalls(\"test error on reload\")","+\trequire.NoError(t, os.Remove(filePath))","+","+\t_, err := reloader.getClientConfig(&tls.Config{})"," \trequire.NoError(t, err)"," ","-\tassert.Equal(t, 1, loader.reloadNumber())","+\tassert.Equal(t, 2, loader.reloadNumber())","+\trequire.EqualError(t, reloader.getLastError(), \"test error on reload\")","+","+\t// While the file stays missing, no further load attempts are made.","+\t_, err = reloader.getClientConfig(&tls.Config{})","+\trequire.NoError(t, err)","+\tassert.Equal(t, 2, loader.reloadNumber())","+}","+","+func TestReloaderRecoversAfterFileReappears(t *testing.T) {","+\treloader, loader, filePath := createReloader(t)"," "," \tloader.returnErrorOnSubsequentCalls(\"test error on reload\")","+\trequire.NoError(t, os.Remove(filePath))"," ","-\terr = os.WriteFile(filePath, []byte(\"some_data\"), 0o600)","+\t_, err := reloader.getClientConfig(&tls.Config{})"," \trequire.NoError(t, err)","+\trequire.Error(t, reloader.getLastError())"," ","-\tassert.Eventually(t, func() bool {","-\t\treturn loader.reloadNu