{"id":"0a0f0a72fe1e509d29c99f1efbaebf57b81048a4","axis":"silent","repo":"firebase/firebase-js-sdk","sha":"0a0f0a72fe1e509d29c99f1efbaebf57b81048a4","parsed":{"files":[{"path":".changeset/cookie-defaults-loopback.md","lines":["@@ -0,0 +1,5 @@","+---","+'@firebase/util': patch","+---","+","+Restrict `emulatorHosts` in the `__FIREBASE_DEFAULTS__` cookie to loopback page origins and loopback target hosts, and ignore `forceEnvironment` when supplied via cookie. Apps that relied on cookie-based emulator auto-connect from a non-loopback URL (such as a LAN IP) should call `connect*Emulator()` directly."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/util/src/defaults.ts","lines":["@@ -75,6 +75,96 @@ const getDefaultsFromEnvVariable = (): FirebaseDefaults | undefined => {","   }"," };"," ","+const LOOPBACK_HOSTNAME_RE =","+  /^(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)*localhost|127\\.0\\.0\\.1|\\[::1\\]|::1)$/i;","+","+const LOOPBACK_HOST_RE =","+  /^(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)*localhost|127\\.0\\.0\\.1|\\[::1\\]):(\\d{1,5})$/i;","+","+const loggedCookieWarnings = new Set<string>();","+","+function warnAboutCookieOnce(message: string): void {","+  if (!loggedCookieWarnings.has(message)) {","+    loggedCookieWarnings.add(message);","+    console.warn(`[@firebase/util] ${message}`);","+  }","+}","+","+function isLoopbackHostWithPort(host: unknown): host is string {","+  if (typeof host !== 'string') {","+    return false;","+  }","+  const match = LOOPBACK_HOST_RE.exec(host);","+  if (!match) {","+    return false;","+  }","+  const port = Number(match[1]);","+  return port >= 1 && port <= 65535;","+}","+","+/**","+ * Sanitize configuration loaded from the `__FIREBASE_DEFAULTS__` cookie.","+ * Cookies can be set by sibling subdomains or on non-HSTS origins, so unlike","+ * `globalThis` or environment-variable defaults they are not a trusted","+ * same-origin source. Preserve `config` (and experimental settings such as","+ * `_authTokenSyncURL`, which Auth restricts to same-origin) for deployed","+ * Firebase Web Frameworks apps, strip `forceEnvironment`, and honor","+ * `emulatorHosts` only when both the current page and each target emulator","+ * host are loopback addresses.","+ */","+function sanitizeCookieDefaults(","+  defaults: unknown","+): FirebaseDefaults | undefined {","+  if (!defaults || typeof defaults !== 'object' || Array.isArray(defaults)) {","+    return undefined;","+  }","+  const sanitized = defaults as FirebaseDefaults;","+  if ('forceEnvironment' in sanitized) {","+    warnAboutCookieOnce(","+      'Ignoring `forceEnvironment` in the __FIREBASE_DEFAULTS__ cookie.'","+    );","+    delete sanitized.forceEnvironment;","+  }","+  if ('emulatorHosts' in sanitized) {","+    const pageHostname =","+      typeof location !== 'undefined' && location","+        ? location.hostname","+        : document.location?.hostname;","+    if (!pageHostname || !LOOPBACK_HOSTNAME_RE.test(pageHostname)) {","+      warnAboutCookieOnce(","+        `Ignoring \\`emulatorHosts\\` in the __FIREBASE_DEFAULTS__ cookie because ` +","+          `'${pageHostname || 'unknown'}' is not a loopback address, so the SDK ` +","+          `will connect to production services. Call connect*Emulator() to use ` +","+          `the emulators here.`","+      );","+      delete sanitized.emulatorHosts;","+    } else if (","+      !sanitized.emulatorHosts ||","+      typeof sanitized.emulatorHosts !== 'object' ||","+      Array.isArray(sanitized.emulatorHosts)","+    ) {","+      delete sanitized.emulatorHosts;","+    } else {","+      for (const product of Object.keys(sanitized.emulatorHosts)) {","+        const host = sanitized.emulatorHosts[product];","+        if (!isLoopbackHostWithPort(host)) {","+          warnAboutCookieOnce(","+            `Ignoring \\`emulatorHosts.${product}\\` in the __FIREBASE_DEFAULTS__ ` +","+              `cookie because '${String(host)}' is not a loopback host, so ` +","+              `'${product}' will connect to production. Call connect*Emulator() ` +","+              `to use an emulator on another host.`","+          );","+          delete sanitized.emulatorHosts[product];","+        }","+      }","+      if (Object.keys(sanitized.emulatorHosts).length === 0) {","+        delete sanitized.emulatorHosts;","+      }","+    }","+  }","+  return Object.keys(sanitized).length > 0 ? sanitized : undefined;","+}","+"," const getDefaultsFromCookie = (): FirebaseDefaults | undefined => {","   if (typeof document === 'undefined') {","     return;","@@ -88,7 +178,7 @@ const getDefaultsFromCookie = (): FirebaseDefaults | undefined => {","     return;","   }","   const decoded = match && base64Decode(match[1]);","-  return decoded && JSON.parse(decoded);","+  return decoded ? sanitizeCookieDefaults(JSON.parse(decoded)) : undefined;"," };"," "," /**"],"additions":91,"deletions":1,"truncated":false},{"path":"packages/util/test/defaults.test.ts","lines":["@@ -14,11 +14,24 @@","  * See the License for the specific language governing permissions and","  * limitations under the License.","  */","-import { expect, beforeAll, afterAll, vi, MockInstance } from 'vitest';"," import {","+  expect,","+  beforeAll,","+  afterAll,","+  beforeEach,","+  afterEach,","+  vi,","+  MockInstance","+} from 'vitest';","+import { base64urlEncodeWithoutPadding } from '../src/crypt';","+import {","+  getDefaults,","+  getDefaultAppConfig,","   getDefaultEmulatorHost,","-  getDefaultEmulatorHostnameAndPort","+  getDefaultEmulatorHostnameAndPort,","+  getExperimentalSetting"," } from '../src/defaults';","+import { isNode } from '../src/environment';"," import { getGlobal } from '../src/global';"," "," describe('getDefaultEmulatorHost', () => {","@@ -195,3 +208,229 @@ describe('getDefaultEmulatorHostnameAndPort', () => {","     });","   });"," });","+","+describe('__FIREBASE_DEFAULTS__ cookie sanitization', () => {","+  const encodeCookie = (value: unknown): string =>","+    `__FIREBASE_DEFAULTS__=${base64urlEncodeWithoutPadding(","+      JSON.stringify(value)","+    )}`;","+","+  beforeEach(() => {","+    delete getGlobal().__FIREBASE_DEFAULTS__;","+    if (typeof process !== 'undefined' && process.env) {","+      delete process.env.__FIREBASE_DEFAULTS__;","+    }","+  });","+","+  if (typeof window !== 'undefined') {","+    afterEach(() => {","+      document.cookie = '__FIREBASE_DEFAULTS__=; Max-Age=0; path=/';","+    });","+","+    it('accepts loopback emulatorHosts on a loopback page', () => {","+      document.cookie = `${encodeCookie({","+        emulatorHosts: {","+          auth: 'localhost:9099',","+          database: 'sub.localhost:9000',","+          firestore: '127.0.0.1:8080',","+          storage: '[::1]:9199'","+        }","+      })}; path=/`;","+","+      expect(getDefaultEmulatorHost('auth')).to.equal('localhost:9099');","+      expect(getDefaultEmulatorHost('database')).to.equal('sub.localhost:9000');","+      expect(getDefaultEmulatorHost('firestore')).to.equal('127.0.0.1:8080');","+      expect(getDefaultEmulatorHostnameAndPort('storage')).to.eql([","+        '::1',","+        9199","+      ]);","+    });","+","+    it('drops non-loopback and malformed emulatorHosts entries with a warning', () => {","+      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});","+      document.cookie = `${encodeCookie({","+        emulatorHosts: {","+          auth: 'attacker.example.com:9099',","+          database: '8080-idx-ws.cluster.cloudworkstations.dev:443',","+          functions: '192.168.1.50:5001',","+          storage: 'localhost@attacker.example.com:9199',","+          noports: 'localhost',","+          zeroPort: '127.0.0.1:0',","+          highPort: '127.0.0.1:70000',","+          firestore: '127.0.0.1:8080'","+        }","+      })}; path=/`;","+","+      expect(getDefaultEmulatorHost('auth')).to.be.undefined;","+      expect(getDefaultEmulatorHost('database')).to.be.undefined;","+      expect(getDefaultEmulatorHost('functions')).to.be.undefined;","+      expect(getDefaultEmulatorHost('storage')).to.be.undefined;","+      expect(getDefaultEmulatorHost('noports')).to.be.undefined;","+      expect(getDefaultEmulatorHost('zeroPort')).to.be.undefined;","+      expect(getDefaultEmulatorHost('highPort')).to.be.undefined;","+      expect(getDefaultEmulatorHost('firestore')).to.equal('127.0.0.1:8080');","+      expect(warnSpy).toHaveBeenCalledTimes(7);","+","+      // Repeated reads of the same cookie do not re-log duplicate warnings.","+      expect(getDefaultEmulatorHost('auth')).to.be.undefined;","+      expect(warnSpy).toHaveBeenCalledTimes(7);","+    });","+","+    it('preserves config and _authTokenSyncURL while stripping forceEnvironment once', () => {","+      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});","+      document.cookie = `${encodeCookie({","+        config: { apiKey: 'test-key', projectId: 'demo-proj' },","+        _authTokenSyncURL: '/__session',","+        forceEnvironment: 'node'","+      })}; path=/`;","+","+      expect(getDefaultAppConfig()).to.eql({","+        apiKey: 'test-key',","+        projectId: 'demo-proj'","+      });","+      expect(getExperimentalSetting('authTokenSyncURL')).to.equal('/__session');","+      expect(getDefaults()?.forceEnvironment).to.be.undefined;","+      expect(isNode()).to.be.false;","+      expect(warnSpy).toHaveBeenCalledTimes(1);","+    });","+","+    it('returns undefined when cookie only contained rejected fields', () => {","+      vi.spyOn(console, 'warn').mockImplementation(() => {});","+      document.cookie = `${encodeCookie({","+        emulatorHosts: { auth: 'attacker.example.com:9099' },","+        forceEnvironment: 'node'","+      })}; path=/`;","+","+      expect(getDefaults()).to.be.undefined;","+    });","+","+    it('ignores non-object JSON payloads and non-object emulatorHosts values', () => {","+      for (const nonObject of [null, 42, 'str', ['array']]) {","+        document.cookie = `${encodeCookie(nonObject)}; path=/`;","+        expect(getDefaults()).to.be.undefined;","+      }","+","+      for (const badHosts of [null, '127.0.0.1:8080', ['127.0.0.1:8080']]) {","+        document.cookie = `${encodeCookie({","+          config: { apiKey: 'test-key' },","+          emulatorHosts: badHosts","+        })}; path=/`;","+        expect(getDefaultEmulatorHost('firestore')).to.be.undefined;","+        expect(getDefaultAppConfig()).to.eql({ apiKey: 'test-key' });","+      }","+    });","+  } else {","+    const g = globalThis as Record<string, unknown>;","+","+    afterEach(() => {","+      delete g.document;","+      delete g.location;","+    });","+","+    for (const hostname of [","+      'app.example.com',","+      '5000-idx-ws.cluster.cloudworkstations.dev',","+      '192.168.1.50',","+      'evil-localhost',","+      ''","+    ]) {","+      it(`ignores even loopback emulatorHosts on non-loopback page hostname '${hostname}'`, () => {","+        const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});","+        g.location = { hostname };","+        g.document = {","+          cookie: encodeCookie({","+            config: { apiKey: 'prod-key', projectId: 'prod-proj' },","+            _authTokenSyncURL: '/__session',","+            emulatorHosts: {","+              auth: '127.0.0.1:9099',","+              database: 'localhost:9000'","+            }","+          })","+        };","+","+        expect(getDefaultEmulatorHost('auth')).to.be.undefined;","+        expect(getDefaultEmulatorHost('database')).to.be.undefined;","+        expect(getDefaultAppConfig()).to.eql({","+          apiKey: 'prod-key',","+          projectId: 'prod-proj'","+        });","+        expect(getExperimentalSetting('authTokenSyncURL')).to.equal(","+          '/__session'","+        );","+        // Four getDefaults() calls above should only log the warning once.","+        expect(warnSpy).toHaveBeenCalledTimes(1);","+        expect(warnSpy.mock.calls[0][0]).to.contain(","+          'connect to production services'","+        );","+      });","+    }","+","+    it('ignores emulatorHosts when neither global location nor document.location is defined', () => {","+      vi.spyOn(console, 'warn').mockImplementation(() => {});","+      g.document = {","+        cookie: encodeCookie({","+          emulatorHosts: { firestore: '127.0.0.1:8080' }","+        })","+      };","+","+      expect(getDefaults()).to.be.undefined;","+      expect(getDefaultEmulatorHost('firestore')).to.be.undefined;","+    });","+","+    for (const hostname of [","+      'localhost',","+      'app.localhost',","+      '127.0.0.1',","+      '[::1]',","+      '::1'","+    ]) {","+      it(`accepts loopback emulatorHosts and rejects remote ones on loopback page hostname '${hostname}'`, () => {","+        vi.spyOn(console, 'warn').mockImplementation(() => {});","+        g.location = { hostname };","+        g.document = {","+          cookie: encodeCookie({","+            emulatorHosts: {","+              firestore: '127.0.0.1:8080',","+              database: 'attacker.example.com:9000'","+            }","+          })","+        };","+","+        expect(getDefaultEmulatorHost('firestore')).to.equal('127.0.0.1:8080');","+        expect(getDefaultEmulatorHost('database')).to.be.undefined;","+      });","+    }","+","+    it('falls back to document.location.hostname when global location is undefined or null', () => {","+      g.document = {","+        location: { hostname: 'localhost' },","+        cookie: encodeCookie({","+          emulatorHosts: { auth: 'localhost:9099' }","+        })","+      };","+      expect(getDefaultEmulatorHost('auth')).to.equal('localhost:9099');","+","+      g.location = null;","+      expect(getDefaultEmulatorHost('auth')).to.equal('localhost:9099');","+    });","+","+    it('ignores non-object JSON payloads and non-object emulatorHosts values', () => {","+      g.location = { hostname: 'localhost' };","+      for (const nonObject of [null, 42, 'str', ['array']]) {","+        g.document = { cookie: encodeCookie(nonObject) };","+        expect(getDefaults()).to.be.undefined;","+      }","+","+      for (const badHosts of [null, '127.0.0.1:8080', ['127.0.0.1:8080']]) {","+        g.document = {","+          cookie: encodeCookie({","+            config: { apiKey: 'test-key' },","+            emulatorHosts: badHosts","+          })","+        };","+        expect(getDefaultEmulatorHost('firestore')).to.be.undefined;","+        expect(getDefaultAppConfig()).to.eql({ apiKey: 'test-key' });","+      }","+    });","+  }","+});",""],"additions":241,"deletions":2,"truncated":false}],"additions":337,"deletions":3,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-17T18:43:48.889234+00:00"}