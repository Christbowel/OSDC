{"id":"917d6896195bb75fca87ed1ccef2301598beec80","axis":"silent","repo":"pnpm/pnpm","sha":"917d6896195bb75fca87ed1ccef2301598beec80","parsed":{"files":[{"path":".changeset/relative-injected-catalogs.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/resolving.local-resolver\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Fixed `pnpm install` failing with `ERR_PNPM_UNSUPPORTED_PROTOCOL` when a workspace package injected through a relative path, such as `workspace:../lib`, has `catalog:` dependencies. Their catalog entries now resolve the way they do for a package injected by name [#17280](https://github.com/pnpm/pnpm/issues/17280)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/inject_workspace_packages/catalogs.rs","lines":["@@ -1,4 +1,4 @@","-use crate::_utils::pacquet_in;","+use crate::_utils::{append_workspace_yaml_key, pacquet_in};"," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"," use pnpm_lockfile::Lockfile;","@@ -95,6 +95,90 @@ fn assert_frozen_install_accepts_catalog_peers(shared_lockfile: bool, peer_speci","     drop((root, mock_instance));"," }"," ","+/// A `catalog:` dependency of a package injected through a relative path","+/// (`workspace:../lib`) resolves through the catalogs, as one of a package","+/// injected by name does. The package sits outside the workspace, so","+/// nothing else resolves its specifiers. Both resolutions that walk the","+/// package are covered: recalculating the graph over a lockfile that","+/// recorded the version the package pinned itself, and a fresh lockfile.","+#[test]","+fn install_resolves_the_catalog_deps_of_a_package_injected_by_relative_path() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    append_workspace_yaml_key(&workspace, \"packages\", \"[]\");","+    append_workspace_yaml_key(&workspace, \"injectWorkspacePackages\", \"true\");","+    append_workspace_yaml_key(&workspace, \"preferFrozenLockfile\", \"false\");","+    append_workspace_yaml_key(","+        &workspace,","+        \"catalogs\",","+        \"{ project/common: { '@pnpm.e2e/foo': 1.0.0 } }\",","+    );","+    let lib = root.path().join(\"lib\");","+    fs::create_dir_all(&lib).expect(\"create lib\");","+    let lib_manifest = |foo_specifier: &str| {","+        serde_json::json!({","+            \"name\": \"lib\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"@pnpm.e2e/foo\": foo_specifier },","+        })","+        .to_string()","+    };","+    fs::write(lib.join(\"package.json\"), lib_manifest(\"1.0.0\")).expect(\"write lib manifest\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\",","+            \"private\": true,","+            \"dependencies\": { \"lib\": \"workspace:../lib\", \"@pnpm.e2e/foo\": \"catalog:project/common\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write app manifest\");","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let lib_manifest = lib_manifest(\"catalog:project/common\");","+    fs::write(lib.join(\"package.json\"), &lib_manifest).expect(\"switch lib to the catalog\");","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    fs::remove_file(workspace.join(\"pnpm-lock.yaml\")).expect(\"remove the lockfile\");","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"lib@file:../lib\"), \"lockfile:\\n{lockfile}\");","+    let injected_copy =","+        fs::canonicalize(workspace.join(\"node_modules/lib\")).expect(\"resolve node_modules/lib\");","+    let foo_manifest = fs::read_to_string(","+        injected_copy","+            .parent()","+            .expect(\"the injected copy sits in a node_modules directory\")","+            .join(\"@pnpm.e2e/foo/package.json\"),","+    )","+    .expect(\"read the manifest of the injected copy's dependency\");","+    let foo: serde_json::Value = serde_json::from_str(&foo_manifest).expect(\"parse foo manifest\");","+    assert_eq!(foo[\"version\"], \"1.0.0\", \"the catalog pins the dependency of the injected copy\");","+    assert_eq!(","+        fs::read_to_string(lib.join(\"package.json\")).expect(\"read lib manifest\"),","+        lib_manifest,","+        \"the manifest keeps its catalog reference\",","+    );","+","+    pacquet_in(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+","+    drop((root, mock_instance));","+}","+"," /// The `peerDependencies` of the `packages` entry of the injected `lib`."," fn recorded_lib_peers(lockfile_dir: &Path) -> HashMap<String, String> {","     Lockfile::load_wanted_from_dir(lockfile_dir)"],"additions":85,"deletions":1,"truncated":false},{"path":"pnpm/crates/resolving-local-resolver/src/local_resolver.rs","lines":["@@ -81,8 +81,13 @@ pub struct LocalResolveResult {","     pub manifest: Option<std::sync::Arc<serde_json::Value>>,","     pub normalized_bare_specifier: Option<String>,","     pub resolution: LockfileResolution,","-    /// `local-filesystem` — the `resolvedVia` tag this resolver stamps","-    /// on every shape it produces.","+    /// The `resolvedVia` tag: `workspace` for a `workspace:` specifier,","+    /// `local-filesystem` for every other shape. A `workspace:` specifier","+    /// gets the tag the name and range form gets in","+    /// `resolving-npm-resolver`, so the deps resolver treats the directory","+    /// as a workspace project whichever of the two claimed it: its","+    /// `catalog:` children resolve through the catalogs, and","+    /// `blockExoticSubdeps` leaves its children alone.","     pub resolved_via: &'static str,"," }"," ","@@ -254,7 +259,7 @@ async fn resolve_spec(","             manifest: None,","             normalized_bare_specifier: Some(spec.normalized_bare_specifier),","             resolution: current.resolution.clone(),","-            resolved_via: \"local-filesystem\",","+            resolved_via: spec.resolved_via,","         }));","     }"," ","@@ -271,7 +276,7 @@ async fn resolve_spec(","         resolution: LockfileResolution::Directory(DirectoryResolution {","             directory: spec.dependency_path,","         }),","-        resolved_via: \"local-filesystem\",","+        resolved_via: spec.resolved_via,","     }))"," }"," ","@@ -302,7 +307,7 @@ async fn resolve_file_spec(","                 manifest: current.manifest.as_ref().map(Arc::clone),","                 normalized_bare_specifier: Some(spec.normalized_bare_specifier.clone()),","                 resolution: current.resolution.clone(),","-                resolved_via: \"local-filesystem\",","+                resolved_via: spec.resolved_via,","             })","         }","         Err(err) => Err(err),","@@ -344,7 +349,7 @@ async fn resolve_local_tarball(","             git_hosted: None,","             path: None,","         }),","-        resolved_via: \"local-filesystem\",","+        resolved_via: spec.resolved_via,","     })"," }"," "],"additions":11,"deletions":6,"truncated":false},{"path":"pnpm/crates/resolving-local-resolver/src/parse_bare_specifier.rs","lines":["@@ -40,6 +40,8 @@ pub(crate) struct LocalPackageSpec {","     /// protocol prefix). The dispatcher writes this back to the","     /// manifest spec when `add` / `update` runs.","     pub normalized_bare_specifier: String,","+    /// See [`crate::LocalResolveResult::resolved_via`].","+    pub resolved_via: &'static str,"," }"," "," #[derive(Debug, Clone, Copy, PartialEq, Eq)]","@@ -159,9 +161,14 @@ fn from_local(","         id: PkgResolutionId::from(id_value),","         kind,","         normalized_bare_specifier,","+        resolved_via: resolved_via(bare),","     }"," }"," ","+fn resolved_via(bare: &str) -> &'static str {","+    if bare.starts_with(\"workspace:\") { \"workspace\" } else { \"local-filesystem\" }","+}","+"," /// The protocol a local specifier resolves under. A `link:` directory is"," /// referenced in place; everything else is copied, which is what `file:`"," /// means here."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-local-resolver/tests/resolve.rs","lines":["@@ -237,6 +237,7 @@ async fn resolve_workspace_directory() {"," ","     assert_eq!(result.id.as_str(), \"link:..\");","     assert_eq!(result.normalized_bare_specifier.as_deref(), Some(\"link:..\"));","+    assert_eq!(result.resolved_via, \"workspace\");"," }"," "," #[tokio::test]","@@ -251,6 +252,7 @@ async fn resolve_workspace_directory_with_inject_workspace_packages() {"," ","     assert_eq!(result.id.as_str(), \"file:..\");","     assert_eq!(result.normalized_bare_specifier.as_deref(), Some(\"file:..\"));","+    assert_eq!(result.resolved_via, \"workspace\");"," }"," "," #[tokio::test]","@@ -265,6 +267,7 @@ async fn resolve_directory_specified_using_the_file_protocol() {"," ","     assert_eq!(result.id.as_str(), \"file:..\");","     assert_eq!(result.normalized_bare_specifier.as_deref(), Some(\"file:..\"));","+    assert_eq!(result.resolved_via, \"local-filesystem\");","     let LockfileResolution::Directory(dir) = &result.resolution else {","         panic!(\"expected directory resolution\");","     };"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm11/installing/deps-installer/test/catalogs.ts","lines":["@@ -1115,6 +1115,75 @@ test('catalogs work when inject-workspace-packages=true', async () => {","   })"," })"," ","+// Regression test for https://github.com/pnpm/pnpm/issues/17280","+//","+// A relative workspace: path is claimed by the local resolver, not by the","+// workspace matching of the npm resolver. The injected package is not an","+// importer, so nothing else resolves its catalog: specifiers. Both","+// resolutions that walk the package are covered: recalculating the graph","+// over a lockfile that recorded the version the package pinned itself, and","+// a fresh lockfile.","+test('catalogs work in a package injected through a relative workspace: path', async () => {","+  expect.hasAssertions()","+","+  const { options, projects, readLockfile } = preparePackagesAndReturnObjects([","+    {","+      name: 'project1',","+      dependencies: {","+        'is-positive': 'catalog:project/common',","+        lib: 'workspace:../lib',","+      },","+    },","+  ])","+  fs.mkdirSync('lib')","+  const writeLib = (isPositiveSpecifier: string) => {","+    fs.writeFileSync('lib/package.json', JSON.stringify({","+      name: 'lib',","+      version: '1.0.0',","+      dependencies: {","+        'is-positive': isPositiveSpecifier,","+      },","+    }))","+  }","+","+  const install = () => mutateModules(installProjects(projects), {","+    ...options,","+    lockfileOnly: true,","+    injectWorkspacePackages: true,","+    preferFrozenLockfile: false,","+    catalogs: {","+      'project/common': { 'is-positive': '1.0.0' },","+    },","+  })","+","+  writeLib('1.0.0')","+  await install()","+  writeLib('catalog:project/common')","+  await expect(install()).resolves.not.toThrow()","+  fs.rmSync('pnpm-lock.yaml')","+  await expect(install()).resolves.not.toThrow()","+","+  expect(JSON.parse(fs.readFileSync('lib/package.json', 'utf8')).dependencies['is-positive']).toBe('catalog:project/common')","+","+  const lockfile = readLockfile()","+","+  expect(lockfile.importers).toEqual({","+    project1: {","+      dependencies: {","+        'is-positive': { specifier: 'catalog:project/common', version: '1.0.0' },","+        lib: { specifier: 'workspace:../lib', version: 'file:lib' },","+      },","+    },","+  })","+","+  expect(lockfile.snapshots).toStrictEqual({","+    'is-positive@1.0.0': {},","+    'lib@file:lib': {","+      dependencies: { 'is-positive': '1.0.0' },","+    },","+  })","+})","+"," describe('dedupe', () => {","   test('valid catalog resolutions are preserved when running pnpm dedupe', async () => {","     const { options, projects, readLockfile } = preparePackagesAndReturnObjects(["],"additions":69,"deletions":0,"truncated":false},{"path":"pnpm11/resolving/local-resolver/src/index.ts","lines":["@@ -8,16 +8,16 @@ import type { DirectoryResolution, LatestInfo, LatestQuery, Resolution, ResolveR"," import type { DependencyManifest, PkgResolutionId } from '@pnpm/types'"," import { readProjectManifestOnly, safeReadParentPublishManifest } from '@pnpm/workspace.project-manifest-reader'"," ","-import { barePathIsUnambiguous, isDriveLetterPrefix, isFilespec, isLocalFilesystemSpecifier, isTarballFilename, linkedDirectoryPath, localFilePath, type LocalPackageSpec, parseLocalPath, parseLocalScheme, type WantedLocalDependency } from './parseBareSpecifier.js'","+import { barePathIsUnambiguous, isDriveLetterPrefix, isFilespec, isLocalFilesystemSpecifier, isTarballFilename, linkedDirectoryPath, localFilePath, type LocalPackageSpec, type LocalResolvedVia, parseLocalPath, parseLocalScheme, type WantedLocalDependency } from './parseBareSpecifier.js'"," ","-export { barePathIsUnambiguous, isDriveLetterPrefix, isFilespec, isLocalFilesystemSpecifier, isTarballFilename, linkedDirectoryPath, localFilePath, type WantedLocalDependency }","+export { barePathIsUnambiguous, isDriveLetterPrefix, isFilespec, isLocalFilesystemSpecifier, isTarballFilename, linkedDirectoryPath, localFilePath, type LocalResolvedVia, type WantedLocalDependency }"," export { fileSpecToPackageRootLink } from './packageRootLink.js'"," "," export interface LocalResolveResult extends ResolveResult {","   manifest?: DependencyManifest","   normalizedBareSpecifier?: string","   resolution: DirectoryResolution | TarballResolution","-  re