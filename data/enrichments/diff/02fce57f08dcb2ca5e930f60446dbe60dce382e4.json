LT_CONFIGSET).create();","+","+    final Path followerConfigSet = solrHome.resolve(\"followerConfigSet\");","+    PathUtils.copyDirectory(ExternalPaths.DEFAULT_CONFIGSET, followerConfigSet);","+    final Path solrConfig = followerConfigSet.resolve(\"solrconfig.xml\");","+    final String followerHandler =","+        \"<requestHandler name=\\\"/replication\\\" class=\\\"solr.ReplicationHandler\\\">\"","+            + \"<lst name=\\\"follower\\\"><str name=\\\"leaderUrl\\\">\"","+            + solrTestRule.getBaseUrl()","+            + \"/\"","+            + CORE_NAME","+            + \"</str><str name=\\\"pollInterval\\\">01:00:00</str></lst></requestHandler></config>\";","+    Files.writeString(","+        solrConfig, Files.readString(solrConfig).replace(\"</config>\", followerHandler));","+    solrTestRule.newCollection(FOLLOWER_CORE_NAME).withConfigSet(followerConfigSet).create();","+  }","+","+  @Before","+  public void beforeEach() throws Exception {","+    setPolling(true);","+  }","+","+  @Test","+  public void testDisableThenEnablePolling() throws Exception {","+    assertEquals(Boolean.FALSE, fetchPollingDisabled());","+","+    setPolling(false);","+    assertEquals(Boolean.TRUE, fetchPollingDisabled());","+","+    setPolling(true);","+    assertEquals(Boolean.FALSE, fetchPollingDisabled());","+  }","+","+  @Test","+  public void testMissingEnabledIsRejectedAndStateUnchanged() throws Exception {","+    var request = new ReplicationApi.SetReplicationPolling(FOLLOWER_CORE_NAME);","+    RemoteSolrException ex =","+        expectThrows(","+            RemoteSolrException.class,","+            () -> request.process(solrTestRule.getSolrClient(FOLLOWER_CORE_NAME)));","+    assertEquals(SolrException.ErrorCode.BAD_REQUEST.code, ex.code());","+","+    assertEquals(Boolean.FALSE, fetchPollingDisabled());","+  }","+","+  @Test","+  public void testNoFollowerIsRejected() {","+    var request = new ReplicationApi.SetReplicationPolling(CORE_NAME);","+    request.setEnabled(true);","+    RemoteSolrException ex =","+        expectThrows(","+            RemoteSolrException.class,","+            () -> request.process(solrTestRule.getSolrClient(CORE_NAME)));","+    assertEquals(SolrException.ErrorCode.BAD_REQUEST.code, ex.code());","+  }","+","+  @Test","+  public void testNullEnabledIsRejected() {","+    var request = new ReplicationApi.SetReplicationPolling(FOLLOWER_CORE_NAME);","+    request.setEnabled(null);","+    RemoteSolrException ex =","+        expectThrows(","+            RemoteSolrException.class,","+            () -> request.process(solrTestRule.getSolrClient(FOLLOWER_CORE_NAME)));","+    assertEquals(SolrException.ErrorCode.BAD_REQUEST.code, ex.code());","+  }","+","+  private static void setPolling(boolean enabled) throws Exception {","+    var request = new ReplicationApi.SetReplicationPolling(FOLLOWER_CORE_NAME);","+    request.setEnabled(enabled);","+    var response = request.process(solrTestRule.getSolrClient(FOLLOWER_CORE_NAME));","+    assertNull(response.error);","+  }","+","+  private static Boolean fetchPollingDisabled() throws Exception {","+    var request = new ReplicationApi.FetchReplicationDetails(FOLLOWER_CORE_NAME);","+    return request.process(solrTestRule.getSolrClient(FOLLOWER_CORE_NAME))","+        .details","+        .follower","+        .isPollingDisabled;","+  }","+}"],"additions":133,"deletions":0,"truncated":false},{"path":"solr/solr-ref-guide/modules/deployment-guide/pages/user-managed-index-replication.adoc","lines":["@@ -456,14 +456,52 @@ http://{followerHost}:{port}/solr/{coreName}/replication?command=abortfetch"," `enablepoll`::"," Enable the specified follower to poll for changes on the leader."," +","+[tabs#enablepoll-request]","+======","+V1 API::","++","+===="," [source,bash]","+----"," http://{followerHost}:{port}/solr/{coreName}/replication?command=enablepoll","+----","+====","+","+V2 API::","++","+====","+[source,bash]","+----","+curl -X PUT -H 'Content-Type: application/json' -d '{\"