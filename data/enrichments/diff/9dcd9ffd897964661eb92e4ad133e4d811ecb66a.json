enerated=\"True\" extra-ref=\"IOUringFilter\"/>","+","     <variablelist class=\"dbus-property\" generated=\"True\" extra-ref=\"RuntimeDirectorySymlink\"/>"," ","     <variablelist class=\"dbus-property\" generated=\"True\" extra-ref=\"RuntimeDirectoryPreserve\"/>","@@ -13032,6 +13056,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <para><varname>LUOSession</varname> was added in version 262.</para>","       <para><varname>RestartRandomizedDelayUSec</varname> was added in version 262.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Socket Unit Objects</title>","@@ -13112,6 +13137,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <varname>XAttrListen</varname>, and","       <varname>XAttrAccept</varname> were added in version 262.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Mount Unit Objects</title>","@@ -13184,6 +13210,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <varname>CPUSetPartition</varname>, and","       <varname>OOMRules</varname> were added in version 261.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Swap Unit Objects</title>","@@ -13254,6 +13281,7 @@ $ gdbus introspect --system --dest org.freedesktop.systemd1 \\","       <varname>CPUSetPartition</varname>, and","       <varname>OOMRules</varname> were added in version 261.</para>","       <para><varname>ConfigurationDirectorySymlink</varname> was added in version 263.</para>","+      <para><varname>IOUringFilter</varname> was added in version 263.</para>","     </refsect2>","     <refsect2>","       <title>Slice Unit Objects</title>"],"additions":28,"deletions":0,"truncated":false},{"path":"man/systemd.exec.xml","lines":["@@ -2526,6 +2526,48 @@ BindReadOnlyPaths=/var/lib/systemd</programlisting>","         <xi:include href=\"version-info.xml\" xpointer=\"v211\"/></listitem>","       </varlistentry>"," ","+      <varlistentry>","+        <term><varname>IOUringFilter=</varname></term>","+","+        <listitem><para>Restricts the","+        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>","+        operations that the processes of this unit may submit. Takes a comma- or space-separated list of","+        operation names. The name of an operation is its <constant>IORING_OP_</constant> constant in lower","+        case and without the prefix, for example <literal>read</literal> for","+        <constant>IORING_OP_READ</constant>, or <literal>uring_cmd</literal> for","+        <constant>IORING_OP_URING_CMD</constant>. If the list is prefixed with <literal>~</literal>, the","+        listed operations are denied (deny-listing). Otherwise, only the listed operations are allowed","+        (allow-listing). An allow list also denies the operations of newer kernels that systemd doesn't","+        know, even though the kernel reports them as supported. Operation names that systemd doesn't know","+        are ignored.</para>","+","+        <para>This option may be specified more than once, in which case the lists are merged. If the first","+        assignment starts with <literal>~</literal>, the list is a deny list, otherwise it is an allow list.","+        Later assignments of the other type remove the listed operations from the list. If the empty string","+        is assigned, the list is reset and all prior assignments have no effect. This setting does not","+        affect commands prefixed with <literal>+</literal>.</para>","+","+        <para>Requests for denied operations fail with <constant>EACCES</constant>. The restriction applies","+        to all io_uring instances that the processes of the unit create, but not to io_uring instances that","+        they receive from other processes. <constant>IORING_REGISTER_RESTRICTIONS</constant> without an","+        io_uring instance fails with <constant>EPERM</constant> for the processes of the unit.</para>","+","+        <para>This setting requires a kernel with io_uring BPF filters (Linux 7.0 or newer). On older","+        kernels, <function>io_uring_setup()</function> fails with <constant>ENOSYS</constant> for the","+        processes of the unit instead, so that programs fall back to regular system calls. If seccomp is not","+        available either, this setting has no effect.</para>","+","+        <para>Example: to deny passthrough commands to drivers and zero-copy network operations, use:","+        <programlisting>IOUringFilter=~uring_cmd uring_cmd128 send_zc sendmsg_zc recv_zc</programlisting>","+        </para>","+","+        <para><varname>SystemCallFilter=</varname>, <varname>RestrictAddressFamilies=</varname>, and","+        <varname>RestrictSUIDSGID=</varname> apply to the equivalent io_uring operations as well. To deny","+        io_uring entirely, use <varname>SystemCallFilter=~io_uring_setup</varname>.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","       <varlistentry>","         <term><varname>RestrictFileSystems=</varname></term>"," ","@@ -3008,7 +3050,8 @@ RestrictNamespaces=~cgroup net</programlisting>","         can't pretend to succeed. The restriction applies to all io_uring instances that the processes of","         the unit create, but not to io_uring instances that they receive from other processes. On such","         kernels, <constant>IORING_REGISTER_RESTRICTIONS</constant> without an io_uring instance fails with","-        <constant>EPERM</constant> for the processes of the unit.</para>","+        <constant>EPERM</constant> for the processes of the unit. To filter individual io_uring operations,","+        use <varname>IOUringFilter=</varname>.</para>"," ","         <para>Note that on systems supporting multiple ABIs (such as x86/x86-64) it is recommended to turn","         off alternative ABIs for services, so that they cannot be used to circumvent the restrictions of this"],"additions":44,"deletions":1,"truncated":false},{"path":"src/core/dbus-execute.c","lines":["@@ -23,6 +23,7 @@"," #include \"hexdecoct.h\""," #include \"hostname-util.h\""," #include \"image-policy.h\"","+#include \"io-uring-filter.h\""," #include \"ioprio-util.h\""," #include \"iovec-util.h\""," #include \"journal-file.h\"","@@ -329,6 +330,41 @@ static int property_get_smack_process_label(","         return sd_bus_message_append(reply, \"(bs)\", c->smack_process_label_ignore, c->smack_process_label);"," }"," ","+static int property_get_io_uring_filter(","+                sd_bus *bus,","+                const char *path,","+                const char *interface,","+                const char *property,","+                sd_bus_message *reply,","+                void *userdata,","+                sd_bus_error *reterr_error) {","+","+        ExecContext *c = ASSERT_PTR(userdata);","+        _cleanup_strv_free_ char **l = NULL;","+        int r;","+","+        assert(bus);","+        assert(reply);","+","+        r = sd_bus_message_open_container(reply, 'r', \"bas\");","+        if (r < 0)","+                return r;","+","+        r = sd_bus_message_append(reply, \"b\", c->io_uring_filter_allow_list);","+        if (r < 0)","+                return r;","+","+        l = exec_context_get_io_uring_filter(c);","+        if (!l)","+                return -ENOMEM;","+","+        r = sd_bus_message_append_strv(reply, l);","+        if (r < 0)","+                return r;","+","+        return sd_bus_message_close_container(reply);","+}","+"," static int property_get_address_families(","                 sd_bus *bus,","                 const char *path,","@@ -1356,6 +1392,7 @@ const sd_bus_vtable bus_exec_vtable[] = {","         SD_BUS_PROPERTY(\"Personality\", \"s\", property_get_personality, offsetof(ExecContext, personality), SD_BUS_VTABLE_PROPERTY_CONST),","         SD_BUS_PROPERTY(\"LockPersonality\", \"b\", bus_property_get_bool, offsetof(ExecContext, lock_personality), SD_BUS_VTABLE_PROPERTY_CONST),","         SD_BUS_PROPERTY(\"RestrictAddressFamilies\", \"(bas)\", property_get_address_families, 0, SD_BUS_VTABLE_PROPERTY_CONST),","+        SD_BUS_PROPERTY(\"IOUringFilter\", \"(bas)\", property_get_io_uring_filter, 0, SD_BUS_VTABLE_PROPERTY_CONST),","         SD_BUS_PROPERTY(\"RuntimeDirectorySymlink\", \"a(sst)\", property_get_exec_dir_symlink, offsetof(ExecContext, directories[EXEC_DIRECTORY_RUNTIME]), SD_BUS_VTABLE_PROPERTY_CONST),","         SD_BUS_PROPERTY(\"RuntimeDirectoryPreserve\", \"s\", bus_property_get_exec_preserve_mode, offsetof(ExecContext, runtime_directory_preserve_mode), SD_BUS_VTABLE_PROPERTY_CONST),","         SD_BUS_PROPERTY(\"RuntimeDirectoryMode\", \"u\", bus_property_get_mode, offsetof(ExecContext, directories[EXEC_DIRECTORY_RUNTIME].mode), SD_BUS_VTABLE_PROPERTY_CONST),","@@ -2446,6 +2483,72 @@ int bus_exec_context_set_transient_property(","                 return 1;","         }"," ","+        if (streq(name, \"IOUringFilter\")) {","+                _cleanup_strv_free_ char **l = NULL;","+                int allow_list;","+","+                r = sd_bus_message_enter_container(message, 'r', \"bas\");","+                if (r < 0)","+                        return r;","+","+                r = sd_bus_message_read(message, \"b\", &allow_list);","+                if (r < 0)","+                        return r;","+","+                r = sd_bus_message_read_strv(message, &l);","+                if (r < 0)","+                        return r;","+","+                r = sd_bus_message_exit_container(message);","+                if (r < 0)","+                        return r;","+","+                STRV_FOREACH(s, l)","+                        if (io_uring_op_from_string(*s) < 0)","+                                return sd_bus_error_setf(reterr_error, SD_BUS_ERROR_INVALID_ARGS,","+                                                         \"Invalid io_uring operation: %s\", *s);","+","+                if (!UNIT_WRITE_FLAGS_NOOP(flags)) {","+                        _cleanup_free_ char *joined = NULL;","+","+                        if (strv_isempty(l)) {","+                                c->io_uring_filter_allow_list = false;","+                                c->io_uring_filter = set_free(c->io_uring_filter);","+","+                                unit_write_setting(u, flags, name, \"IOUringFilter=\");","+                                return 1;","+                        }","+","+                        if (!c->io_uring_filter) {","+                                c->io_uring_filter = set_new(/* hash_ops= */ NULL);","+                                if (!c->io_uring_filter)","+                                        return -ENOMEM;","+","+                                c->io_uring_filter_allow_list = allow_list;","+                        }","+","+                        STRV_FOREACH(s, l) {","+                                int op = io_uring_op_from_string(*s);","+                                assert(op >= 0);","+","+                                if (allow_list == c->io_uring_filter_allow_list) {","+                                        r = set_put(c->io_uring_filter, INT_TO_PTR(op + 1));","+                                        if (r < 0)","+                                                return r;","+                                } else","+                                        set_remove(c->io_uring_filter, INT_TO_PTR(op + 1));","+                        }","+","+                        joined = strv_join(l, \" \");","+                        if (!joined)","+                                return -ENOMEM;","+","+                        unit_write_settingf(u, flags, name, \"IOUringFilter=%s%s\", allow_list ? \"\" : \"~\", joined);","+                }","+","+                return 1;","+        }","+","         if (streq(name, \"MountFlags\"))","                 return bus_set_transient_mount_propagation_flag(u, name, &c->mount_propagation_flag, message, flags, reterr_error);"," "],"additions":103,"deletions":0,"truncated":false},{"path":"src/core/exec-invoke.c","lines":["@@ -1756,7 +1756,7 @@ static bool context_has_syscall_logs(const ExecContext *c) {"," static bool context_has_seccomp(const ExecContext *c) {","         assert(c);"," ","-        /* We need NNP if we have any form of seccomp and are unprivileged */","+        /* We need NNP if we have any form of seccomp or io_uring filters and are unprivileged */","         return c->lock_personality ||","                 c->memory_deny_write_execute ||","                 c->private_devices ||","@@ -1771,7 +1771,8 @@ static bool context_has_seccomp(const ExecContext *c) {","                 c->restrict_suid_sgid ||","                 !set_isempty(c->syscall_archs) ||","                 exec_context_has_syscall_filters(c) ||","-                context_has_syscall_logs(c);","+                context_has_syscall_logs(c) ||","+                exec_context_io_uring_filter_set(c);"," }"," "," static bool context_has_no_new_privileges(const ExecContext *c) {","@@ -1868,6 +1869,45 @@ static int apply_io_uring_suid_sgid(const ExecContext *c, const ExecParameters *","         return io_uring_restrict_suid_sgid();"," }"," ","+static int apply_io_uring_filter(const ExecContext *c, const ExecParameters *p) {","+        assert(c);","+        assert(p);","+","+        if (!exec_context_io_uring_filter_set(c))","+                return 0;","+","+        if (check_io_uring_bpf_filters(c, p, \"IOUringFilter=\"))","+                return io_uring_restrict_ops(c->io_uring_filter, c->io_uring_filter_allow_list);","+","+        if (syscall_filter_denies_io_uring(c))","+                return 0;","+","+#if HAVE_SECCOMP","+        /* The kernel can't filter io_uring operations, so we deny io_uring_setup() to enforce","+         * IOUringFilter=. Programs fall back to regular system calls when io_uring_setup() fails with","+         * ENOSYS. */","+        if (is_seccomp_available()) {","+                _cleanup_hashmap_free_ Hashmap *filter = NULL;","+                int r;","+","+                log_debug(\"Denying io_uring_setup() to enforce IOUringFilter=.\");","+","+                filter = hashmap_new(/* hash_ops= */ NULL);","+                if (!filter)","+                        return -ENOMEM;","+","+                r = seccomp_filter_set_add_by_name(filter, /* add= */ true, \"io_uring_setup\");","+                if (r < 0)","+                        return r;","+","+                return seccomp_load_syscall_filter_set_raw(SCMP_ACT_ALLOW, filter, SCMP_ACT_ERRNO(ENOSYS), /* log_missing= */ false);","+        }","+#endif","+","+        log_debug(\"Seccomp is not available, not applying IOUringFilter=.\");","+        return 0;","+}","+"," #if HAVE_SECCOMP"," "," static bool seccomp_allows_drop_privileges(const ExecContext *c) {","@@ -7083,6 +7123,12 @@ int exec_invoke(","                         return log_error_errno(r, \"Failed to apply SUID/SGID restrictions to io_uring: %m\");","                 }"," ","+                r = apply_io_uring_filter(context, params);","+                if (r < 0) {","+                        *exit_status = EXIT_SECCOMP;","+                        return log_error_errno(r, \"Failed to apply io_uring filters: %m\");","+                }","+"," #if HAVE_SECCOMP","                 r = apply_io_uring_syscall_filter(context, params);","                 if (r < 0) {"],"additions":48,"deletions":2,"trunc