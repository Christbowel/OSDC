      (movedKeys !== undefined && !movedKeys.has(keys[i])","+        ? untouchedWeight","+        : 1);","+    for (","+      let index = position + 1;","+      index < tree.length;","+      index += index & -index","+    ) {","+      if (isBetter(i, tree[index])) {","+        tree[index] = i;","+      }","+    }","+    if (isBetter(i, best)) {","+      best = i;","+    }","+  }","+  const stableKeys = new Set<NodeKey>();","+  for (let i = best; i >= 0; i = predecessors[i]) {","+    stableKeys.add(keys[i]);","+  }","+  return stableKeys;","+}","+"," export class CollabElementNode {","   _key: NodeKey;","   _children: (","@@ -549,8 +626,7 @@ export class CollabElementNode {","     const prevEndIndex = prevChildren.length - 1;","     const nextEndIndex = nextChildren.length - 1;","     const collabNodeMap = binding.collabNodeMap;","-    let prevChildrenSet: Set<NodeKey> | undefined;","-    let nextChildrenSet: Set<NodeKey> | undefined;","+    let stableKeys: Set<NodeKey> | undefined;","     let prevIndex = 0;","     let nextIndex = 0;"," ","@@ -558,8 +634,48 @@ export class CollabElementNode {","       const prevKey = prevChildren[prevIndex];","       const nextKey = nextChildren[nextIndex];"," ","-      if (prevKey === nextKey) {","-        // Nove move, create or remove","+      if (stableKeys === undefined) {","+        if (prevKey === nextKey) {","+          this._syncChildFromLexical(","+            binding,","+            nextIndex,","+            nextKey,","+            prevNodeMap,","+            dirtyElements,","+            dirtyLeaves,","+          );","+","+          prevIndex++;","+          nextIndex++;","+          continue;","+        }","+        stableKeys = getStableChildKeys(","+          prevChildren,","+          prevIndex,","+          nextChildren,","+          nextIndex,","+          binding._movedNodeKeys,","+        );","+      }","+","+      if (!stableKeys.has(prevKey)) {","+        // Removed, or moved elsewhere (re-created at its new pos