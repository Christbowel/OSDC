MappingTable->Lookup(token);","+","+#if !defined(DACCESS_COMPILE)","+    // Return a copy the caller owns: replacing a map frees the table's array, so a shallow","+    // copy used after the Crst is released could point at freed memory.","+    const InstrumentedILOffsetMapping & tableMapping = entry.m_mapping;","+    if (tableMapping.IsNull())","+        return InstrumentedILOffsetMapping();","+","+    UINT cMap = tableMapping.GetCount();","+    COR_IL_MAP * rgNewMap = new (nothrow) COR_IL_MAP[cMap];","+    if (rgNewMap == NULL)","+    {","+        // Leave offsets untranslated if allocation fails.","+        return InstrumentedILOffsetMapping();","+    }","+","+    memcpy(rgNewMap, tableMapping.GetOffsets(), cMap * sizeof(COR_IL_MAP));","+","+    InstrumentedILOffsetMapping ownedMapping;","+    ownedMapping.SetMappingInfo(cMap, rgNewMap);","+    return ownedMapping;","+#else","+    // The DAC reads a stopped target, so the shallow view is safe.","     return entry.m_mapping;","+#endif // !DACCESS_COMPILE"," }"," "," #undef DECODE_TYPEID"],"additions":29,"deletions":3,"truncated":false},{"path":"src/coreclr/vm/ilinstrumentation.h","lines":["@@ -56,6 +56,75 @@ struct cdac_data<InstrumentedILOffsetMapping>","     static constexpr size_t Map = offsetof(InstrumentedILOffsetMapping, m_rgMap);"," };"," ","+#if !defined(DACCESS_COMPILE)","+//---------------------------------------------------------------------------------------","+//","+// Owns a mapping returned by Module::GetInstrumentedILOffsetMapping and frees its array when","+// it leaves scope. Only for the Module table's map: the ReJIT per-version map lives on the","+// loader heap and must not be freed.","+//","+class InstrumentedILOffsetMappingHolder","+{","+public:","+    InstrumentedILOffsetMappingHolder() = default;","+","+    explicit InstrumentedILOffsetMappingHolder(const InstrumentedILOffsetMapping & mapping)","+        : m_mapping(mapping)","+    {","+        LIMITED_METHOD_CONTRACT;","+    }","+","+    ~InstrumentedILOffsetMappingHolder()","+    {","+        LIMITED_METHOD_CONTRACT;","+        m_mapping.Clear();","+    }","+","+    InstrumentedILOffsetMappingHolder(const InstrumentedILOffsetMappingHolder &) = delete;","+    InstrumentedILOffsetMappingHolder & operator=(const InstrumentedILOffsetMappingHolder &) = delete;","+","+    InstrumentedILOffsetMappingHolder(InstrumentedILOffsetMappingHolder && other)","+        : m_mapping(other.m_mapping)","+    {","+        LIMITED_METHOD_CONTRACT;","+        other.m_mapping = InstrumentedILOffsetMapping();","+    }","+","+    InstrumentedILOffsetMappingHolder & operator=(InstrumentedILOffsetMappingHolder && other)","+    {","+        LIMITED_METHOD_CONTRACT;","+        if (this != &other)","+        {","+            m_mapping.Clear();","+            m_mapping = other.m_mapping;","+            other.m_mapping = InstrumentedILOffsetMapping();","+        }","+        return *this;","+    }","+","+    // Takes ownership of a fresh mapping from the getter, freeing any array already held.","+    InstrumentedILOffsetMappingHolder & operator=(const InstrumentedILOffsetMapping & mapping)","+    {","+        LIMITED_METHOD_CONTRACT;","+        if (&mapping != &m_mapping)","+        {","+            m_mapping.Clear();","+            m_mapping = mapping;","+        }","+        return *this;","+    }","+","+    const InstrumentedILOffsetMapping & Get() const","+    {","+        LIMITED_METHOD_CONTRACT;","+        return m_mapping;","+    }","+","+private:","+    InstrumentedILOffsetMapping m_mapping;","+};","+#endif // !DACCESS_COMPILE","+"," //---------------------------------------------------------------------------------------"," //"," // Hash table entry for storing InstrumentedILOffsetMapping.  This is keyed by the MethodDef token."],"additions":69,"deletions":0,"truncated":false},{"path":"src/coreclr/vm/jitinterface.cpp","lines":["@@ -11603,7 +11603,8 @@ void CEECodeGenInfo::CompressDebugInfo(PCODE nativeEntry, NativeCodeVersion nati","     EX_TRY","     {","         const InstrumentedILOffsetMapping *pILOffsetMapping = NULL;","-        InstrumentedILOffsetMapping loadTimeMapping;","+        // Owns the copy of the load-time map. The ReJIT map is borrowed and must not be freed.","+        InstrumentedILOffsetMappingHolder loadTimeMapping;"," #ifdef FEATURE_REJIT","         ILCodeVersion ilVersion;"," ","@@ -11624,8 +11625,8 @@ void CEECodeGenInfo::CompressDebugInfo(PCODE nativeEntry, NativeCodeVersion nati","             // if there is a profiler load-time mapping and not a rejit mapping, apply that instead","             loadTimeMapping =","                 m_pMethodBeingCompiled->GetAssembly()->GetModule()->GetInstrumentedILOffsetMapping(m_pMethodBeingCompiled->GetMemberDef());","-            if (!loadTimeMapping.IsNull())","-                pILOffsetMapping = &loadTimeMapping;","+            if (!loadTimeMapping.Get().IsNull())","+                pILOffsetMapping = &loadTimeMapping.Get();","         }"," ","         PTR_BYTE pDebugInfo = CompressDebugInfo::Compress("],"additions":4,"deletions":3,"truncated":false},{"path":"src/tests/profiler/instrumentedilmap/instrumentedilmap.cs","lines":["@@ -0,0 +1,119 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using Profiler.Tests;","+using System;","+using System.Collections.Generic;","+using System.Reflection;","+using System.Runtime.CompilerServices;","+using System.Threading;","+","+public struct W<T>","+{","+    public T Value;","+}","+","+public struct X<T>","+{","+    public T Value;","+}","+","+public struct Y<T>","+{","+    public T Value;","+}","+","+public struct Z<T>","+{","+    public T Value;","+}","+","+public static class InstrumentedILMap","+{","+    private static readonly Guid ProfilerGuid = new(\"4F7C2B1E-8D3A-4E59-B6A1-2C9E5D7F3A10\");","+","+    public static int Main(string[] args)","+    {","+        if (args.Length > 0 && args[0].Equals(\"RunTest\", StringComparison.OrdinalIgnoreCase))","+        {","+            return RunTest();","+        }","+","+        return ProfilerTestRunner.Run(","+            Assembly.GetExecutingAssembly().Location,","+            testName: \"InstrumentedILMap\",","+            profilerClsid: ProfilerGuid,","+            envVars: new Dictionary<string, string>","+            {","+                // glibc fills freed memory with 0xA5, so a read of a freed instrumented map","+                // returns IL offsets the profiler detects. Other C runtimes ignore it.","+                [\"MALLOC_PERTURB_\"] = \"165\"","+            });","+    }","+","+    // The profiler replaces this method's instrumented IL map each time an instantiation is JIT-compiled.","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    public static int Target<T>(T value, int x)","+    {","+        int sum = x;","+        for (int i = 0; i < 4; i++)","+        {","+            sum += i * x;","+        }","+","+        return sum;","+    }","+","+    private static int RunTest()","+    {","+        MethodInfo target = typeof(InstrumentedILMap).GetMethod(nameof(Target));","+","+        // Value-type instantiations are compiled separately but share Target's method token, and so share","+        // one instrumented map in the runtime.","+        Type[] bases = { typeof(int), typeof(long), typeof(short), typeof(byte), typeof(uint), typeof(ulong),","+                         typeof(ushort), typeof(sbyte), typeof(double), typeof(float), typeof(char), typeof(bool) };","+        Type[] wrappers = { typeof(W<>), typeof(X<>), typeof(Y<>), typeof(Z<>) };","+        List<Type> types = new();","+        foreach (Type b in bases)","+        {","+            types.Add(b);","+            foreach (Type wrapper in wrappers)","+            {","+                Type t = b;","+                for (int depth = 1; depth < 64; depth++)","+                {","+                    t = wrapper.MakeGenericType(t);","+                    types.Add(t);","+                }","+            }","+        }","+","+        const int ThreadCount = 8;","+        using ManualResetEventSlim go = new();","+        Thread[] threads = new Thread[ThreadCount];","+        int done = 0;","+        for (int k = 0; k < ThreadCount; k++)","+        {","+            int first = k;","+            threads[k] = new Thread(() =>","+            {","+                go.Wait();","+                for (int i = first; i < types.Count; i += ThreadCount)","+                {","+                    Type t = types[i];","+                    target.MakeGenericMethod(t).Invoke(null, new object[] { Activator.CreateInstance(t), 1 });","+                    Interlocked.Increment(ref done);","+                }","+            });","+            threads[k].Start();","+        }","+","+        go.Set();","+        foreach (Thread thread in threads)","+        {","+            thread.Join();","+        }","+","+        return done == types.Count ? 100 : 1;","+    }","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"src/tests/profiler/instrumentedilmap/instrumentedilmap.csproj","lines":["@@ -0,0 +1,18 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+  <PropertyGroup>","+    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>","+    <OutputType>exe</OutputType>","+    <CLRTestPriority>1</CLRTestPriority>","+    <Optimize>true</Optimize>","+    <!-- The test reads IL-to-native mappings of JIT-compiled code, which interpreted methods do not have. -->","+    <InterpreterIncompatible>true</InterpreterIncompatible>","+    <UnloadabilityIncompatible>true</UnloadabilityIncompatible>","+    <!-- 3,036 JIT compilations take too long under GC stress, which also perturbs the race the test needs. -->","+    <GCStressIncompatible>true</GCStressIncompatible>","+  </PropertyGroup>","+  <ItemGroup>","+    <Compile Include=\"$(MSBuildProjectName).cs\" />","+    <ProjectReference Include=\"../common/profiler_common.csproj\" />","+    <CMakeProjectReference Include=\"$(MSBuildThisFileDirectory)/../native/CMakeLists.txt\" />","+  </ItemGroup>","+</Project>"],"additions":18,"deletions":0,"truncated":false},{"path":"src/tests/profiler/native/CMakeLists.txt","lines":["@@ -30,6 +30,7 @@ set(SOURCES","     handlesprofiler/handlesprofiler.cpp","     ijw/ijwprofiler.cpp","     inlining/inlining.cpp","+    instrumentedilmap/instrumentedilmap.cpp","     metadatagetdispenser/metadatagetdispenser.cpp","     moduleload/moduleload.cpp","     multiple/multiple.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"src/tests/profiler/native/classfactory.cpp","lines":["@@ -16,6 +16,7 @@"," #include \"gcprofiler/gcprofiler.h\""," #include \"handlesprofiler/handlesprofiler.h\""," #include \"ijw/ijwprofiler.h\"","+#include \"instrumentedilmap/instrumentedilmap.h\""," #include \"metadatagetdispenser/metadatagetdispenser.h\""," #include \"nullprofiler/nullprofiler.h\""," #include \"rejitprofiler/rejitprofiler.h\"","@@ -129,6 +130,10 @@ HRESULT STDMETHODCALLTYPE ClassFactory::CreateInstance(IUnknown *pUnkOuter, REFI","     {","         profiler = new ReleaseOnDetach();","     }","+    else if (clsid == InstrumentedILMapProfiler::GetClsid())","+    {","+        profiler = new InstrumentedILMapProfiler();","+    }","     else if (clsid == RuntimeAsyncApisProfiler::GetClsid())","     {","         profiler = new RuntimeAsyncApisProfiler();"],"additions":5,"deletions":0,"truncated":false},{"path":"src/tests/profiler/native/instrumentedilmap/instrumentedilmap.cpp","lines":["@@ -0,0 +1,187 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+#include \"instrumentedilmap.h\"","+#include <vector>","+","+// Every entry is (0, 0), so every ordinary IL offset translates to 0, and each such translation scans the","+// whole map while other threads replace it. Reading a freed copy may fault or yield invalid offsets.","+static const ULONG32 MapEntries = 50000;","+","+// The special IL offsets GetILToNativeMapping may report (CorDebugIlToNativeMappingTypes).","+static const ULONG32 NoMappingOffset = 0xFFFFFFFF;","+static const ULONG32 PrologOffset = 0xFFFFFFFE;","+static const ULONG32 EpilogOffset = 0xFFFFFFFD;","+","+InstrumentedILMapProfiler::InstrumentedILMapProfiler()","+    : Profiler(),","+      _failures(0),","+      _mapsSet(0),","+      _mappingsRead(0),","+      _badOffsets(0)","+{","+}","+","+GUID InstrumentedILMapProfiler::GetClsid()","+{","+    // {4F7C2B1E-8D3A-4E59-B6A1-2C9E5D7F3A10}","+    GUID clsid = {0x4f7c2b1e, 0x8d3a, 0x4e59, {0xb6, 0xa1, 0x2c, 0x9e, 0x5d, 0x7f, 0x3a, 0x10}};","+    return clsid;","+}","+","+HRESULT InstrumentedILMapProfiler::Initialize(IUnknown* pCorProfilerInfoUnk)","+{","+    HRESULT hr = Profiler::Initialize(pCorProfilerInfoUnk);","+    if (FAILED(hr))","+    {","+        return hr;","+    }","+","+    return pCorProfilerInfo->SetEventMask2(","+        COR_PRF_MONITOR_JIT_COMPILATION | COR_PRF_MONITOR_CACHE_SEARCHES, 0);","+}","+","+bool InstrumentedILMapProfiler::IsTarget(FunctionID functionId)","+{","+    // Compare the method definition's name. GetFunctionIDName appends the type arguments","+    // (\"Target<W<...>>\"), which differ for every instantiation this test compiles.","+    ClassID classId = 0;","+    ModuleID moduleId = 0;","+    mdToken token = 0;","+    ULONG32 typeArgumentCount = 0;","+    ClassID typeArguments[SHORT_LENGTH];","+    HRESULT hr = pCorProfilerInfo->GetFunctionInfo2(","+        functionId, 0, &classId, &moduleId, &token, SHORT_LENGTH, &typeArgumentCount, typeArguments);","+    if (FAILED(hr))","+    {","+        return false;","+    }","+","+    COMPtrHolder<IMetaDataImport> pIMDImport;","+    hr = pCorProfilerInfo->GetModuleMetaData(moduleId, ofRead, IID_IMetaDataImport, (IUnknown **)&pIMDImport);","+    if (FAILED(hr))","+    {","+        return false;","+    }","+","+    WCHAR methodName[STR_LENGTH];","+    hr = pIMDImport->GetMethodProps(token, NULL, methodName, STR_LENGTH, NULL, NULL, NULL, NULL, NULL, NULL);","+    if (FAILED(hr))","+    {","+        return false;","+    }","+","+    String name;","+    name += methodName;","+    if (name != WCHAR(\"Target\"))","+    {","+        return false;","+    }","+","+    std::wstring moduleName = GetModuleIDName(moduleId).ToWString();","+    return moduleName.find(L\"instrumentedilmap\") != std::wstring::npos;","+}","+","+HRESULT InstrumentedILMapProfiler::JITCompilationStarted(FunctionID functionId, BOOL fIsSafeToBlock)","+{","+    SHUTDOWNGUARD();","+","+    if (!IsTarget(functionId))","+    {","+        return S_OK;","+    }","+","+    // Every value-type instantiation of Target shares one method token, so each call after the first","+    // replaces the map the runtime holds for that token.","+    // The runtime copies the entries, so the profiler keeps ownership of this buffer.","+    std::vector<COR_IL_MAP> map(MapEntries);","+    for (ULONG32 i = 0; i < MapEntries; i++)","+    {","+        map[i].oldOffset = 0;","+        map[i].newOffset = 0;","+        map[i].fAccurate = TRUE;","+    }","+","+    HRESULT hr = pCorProfilerInfo->SetILInstrumentedCodeMap(functionId, TRUE, MapEntries, map.data());","+    if (FAILED(hr))","+    {","+        printf(\"SetILInstrumentedCodeMap failed hr=0x%x\\n\", hr);","+        _failures++;","+        return S_OK;","+    }","+","+    _mapsSet++;","+    return S_OK;","+}","+","+HRESULT InstrumentedILMapProfiler::JITCompilationFinished(","+    FunctionID functionId, HRESULT hrStatus, BOOL fIsSafeToBlock)","+{","+    SHUTDOWNGUARD();","+","+    if (!IsTarget(functionId) || FAILED(hrStatus))","+    {","+        return S_OK;","+    }","+","+    COR_DEBUG_IL_TO_NATIVE_MAP mappings[512];","+    ULONG32 mappingCount = 0;","+    HRESULT hr = pCorProfilerInfo->GetILToNativeMapping(","+        functionId, static_cast<ULONG32>(sizeof(mappings) / sizeof(mappings[0])), &mappingCount, mappings);","+    if (FAILED(hr))","+    {","+        printf(\"GetILToNativeMapping failed hr=0x%x\\n\", hr);","+        _failures++;","+        return S_OK;","+    }","+","+    if (mappingCount == 0 || mappingCount > static_cast<ULONG32>(sizeof(mappings) / sizeof(mappings[0])))","+    {","+        printf(\"GetILToNativeMapping returned %u entries\\n\", mappingCount);","+        _failures++;","+        return S_OK;","+    }","+","+    _mappingsRead++;","+    for (ULONG32 i = 0; i < mappingCount; i++)","+    {","+        ULONG32 ilOffset = mappings[i].ilOffset;","+        bool special = ilOffset == NoMappingOffset || ilOffset == PrologOffset || ilOffset == EpilogOffset;","+        if (!special && ilOffset != 0)","+        {","+            printf(\"IL offset 0x%x does not come from the instrumented map\\n\", ilOffset);","+            _badOffsets++;","+            _failures++;","+            break;","+        }","+    }","+    return S_OK;","+}","+","+HRESULT InstrumentedILMapProfiler::JITCachedFunctionSearchStarted(","+    FunctionID functionId, BOOL* pbUseCachedFunction)","+{","+    *pbUseCachedFunction = TRUE;","+    SHUTDOWNGUARD();","+","+    if (IsTarget(functionId))","+    {","+        // The test needs every instantiation JIT-compiled so the map is replaced each time.","+        *pbUseCachedFunction = FALSE;","+    }","+    return S_OK;","+}","+","+HRESULT InstrumentedILMapProfiler::Shutdown()","+{","+    HRESULT hr = Profiler::Shutdown();","+","+    printf(\"InstrumentedILMapProfiler: failures=%d mapsSet=%d mappingsRead=%d badOffsets=%d\\n\",","+           _failures.load(), _mapsSet.load(), _mappingsRead.load(), _badOffsets.load());","+","+    bool passed = SUCCEEDED(hr) && _failures == 0 && _mapsSet > 1 && _mappingsRead > 1;","+","+    printf(passed ? \"PROFILER TEST PASSES\\n\" : \"PROFILER TEST FAILED\\n\");","+    fflush(stdout);","+    return hr;","+}"],"additions":187,"deletions":0,"truncated":false},{"path":"src/tests/profiler/native/instrumentedilmap/instrumentedilmap.h","lines":["@@ -0,0 +1,32 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+#pragma once","+","+#include \"../profiler.h\"","+","+// Replaces a method's instrumented IL map on every JIT of one generic method while other threads","+// read their mappings back, and checks that every IL offset read back comes from the map.","+class InstrumentedILMapProfiler : public Profiler","+{","+public:","+    InstrumentedILMapProfiler();","+","+    static GUID GetClsid();","+    HRESULT STDMETHODCALLTYPE Initialize(IUnknown* pCorProfilerInfoUnk) override;","+    HRESULT STDMETHODCALLTYPE Shutdown() override;","+    HRESULT STDMETHODCALLTYPE JITCompilationStarted(","+        FunctionID functionId, BOOL fIsSafeToBlock) override;","+    HRESULT STDMETHODCALLTYPE JITCompilationFinished(","+        FunctionID functionId, HRESULT hrStatus, BOOL fIsSafeToBlock) override;","+    HRESULT STDMETHODCALLTYPE JITCachedFunctionSearchStarted(","+        FunctionID functionId, BOOL* pbUseCachedFunction) override;","+","+private:","+    bool IsTarget(FunctionID functionId);","+","+    std::atomic<int> _failures;","+    std::atomic<int> _mapsSet;","+    std::atomic<int> _mappingsRead;","+    std::atomic<int> _badOffsets;","+};",""],"additions":32,"deletions":0,"truncated":false}],"additions":471,"deletions":10,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-05T16:29:43.851279+00:00"}