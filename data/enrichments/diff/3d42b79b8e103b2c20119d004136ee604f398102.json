e:","                 run_logged(","                     [sys.executable, \"setup.py\", \"bdist_wheel\", \"-d\", dist],"],"additions":17,"deletions":12,"truncated":false},{"path":"eng/tools/azure-sdk-tools/ci_tools/logging/__init__.py","lines":["@@ -5,6 +5,7 @@"," import logging"," "," from logging import Logger","+from typing import Mapping"," "," from ci_tools.variables import get_log_directory, in_ci"," ","@@ -79,20 +80,27 @@ def run_logged_to_file(*args, prefix=\"\", **kwargs):","         subprocess.run(*args, **kwargs, stdout=log_output, stderr=log_output)"," "," ","-def run_logged(cmd: list[str], cwd: str, check: bool, should_stream_to_console: bool):","+def run_logged(","+    cmd: list[str],","+    cwd: str,","+    check: bool,","+    should_stream_to_console: bool,","+    env: Mapping[str, str] | None = None,","+):","     \"\"\"","     Runs a command, logging output to subprocess.PIPE or streaming live to console based on log level."," ","     Regardless of `should_stream_to_console`, if the command fails, the captured output will be logged.","+    If `env` is omitted, the command inherits the current process environment.","     \"\"\"","     try:","         if should_stream_to_console:","             # Stream live, no capturing","-            return subprocess.run(cmd, cwd=cwd, check=check, text=True, stderr=subprocess.STDOUT)","+            return subprocess.run(cmd, cwd=cwd, check=check, text=True, stderr=subprocess.STDOUT, env=env)","         else:","             # Capture merged output but don't print unless there's a failure","             return subprocess.run(","-                cmd, cwd=cwd, check=check, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT","+                cmd, cwd=cwd, check=check, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env","             )","     except subprocess.CalledProcessError as e:","         logger.error(f\"Command failed: {' '.join(cmd)}\")"],"additions":11,"deletions":3,"truncated":false},{"path":"eng/tools/azure-sdk-tools/ci_tools/windows_wheels.py","lines":["@@ -0,0 +1,156 @@","+# -------------------------------------------------------------------------","+# Copyright (c) Microsoft Corporation. All rights reserved.","+# Licensed under the MIT License. See License.txt in the project root for","+# license information.","+# --------------------------------------------------------------------------","+","+\"\"\"Provision selected Windows interpreters using the pipeline's approved NuGet feed.\"\"\"","+","+from contextlib import contextmanager","+from importlib import import_module","+from importlib.util import find_spec","+import os","+from pathlib import Path","+import platform","+import shlex","+import subprocess","+import sys","+from tempfile import TemporaryDirectory","+","+import tomli_w","+","+if sys.version_info >= (3, 11):","+    import tomllib","+else:","+    import tomli as tomllib","+","+","+def _write_pyo3_config(directory, configuration, libraries):","+    \"\"\"Write target Python metadata so Maturin does not inspect the host Python.\"\"\"","+    major, minor = configuration.version.split(\".\")[:2]","+    free_threaded = \"t-\" in configuration.identifier","+    abi_flags = \"t\" if free_threaded else \"\"","+    build_flags = \"Py_GIL_DISABLED\" if free_threaded else \"\"","+    config = [","+        \"implementation=CPython\",","+        f\"version={major}.{minor}\",","+        \"shared=true\",","+        f\"build_flags={build_flags}\",","+        \"suppress_build_script_link_lines=false\",","+        \"pointer_width=64\",","+        f\"lib_dir={libraries.as_posix()}\",","+        f\"ext_suffix=.cp{major}{minor}{abi_flags}-win_arm64.pyd\",","+    ]","+    # Maturin 1.15 derives the free-threaded wheel ABI tag from this field.","+    if free_threaded:","+        config.append(\"abiflags=t\")","+    path = directory / f\"pyo3-{configuration.identifier}.txt\"","+    path.write_text(\"\\n\".join(config) + \"\\n\", encoding=\"utf-8\")","+    return path","+","+","+@contextmanager","+def windows_wheel_config(package_dir):","+    \"\"\"Yield cibuildwheel arguments/environment, leaving non-pipeline builds unchanged.\"\"\"","+    # The pipeline sets this variable after authenticating to the approved feed.","+    # Keep ordinary local builds and non-Windows builds on cibuildwheel's normal path.","+    feed = os.environ.get(\"AZURESDK_PYTHON_NUGET_FEED\")","+    if sys.platform != \"win32\" or not feed:","+        yield [], {}","+        return","+","+    from cibuildwheel.options import CommandLineArguments, EnvironmentFormat, Options","+","+    # cibuildwheel 3+ moved its platform modules; Python 3.10 hosts still resolve 2.x.","+    module = \"cibuildwheel.platforms.windows\" if find_spec(\"cibuildwheel.platforms\") else \"cibuildwheel.windows\"","+    windows = import_module(module)","+    arguments = CommandLineArguments.defaults()","+    arguments.package_dir = Path(package_dir)","+    options = Options(platform=\"windows\", command_line_arguments=arguments, env=os.environ)","+    # Let cibuildwheel combine package config and CIBW_* variables. This keeps","+    # build, skip, requires-python, and architecture selection in one authority.","+    configurations = windows.get_python_configurations(options.globals.build_selector, options.globals.architectures)","+    cache = Path(os.environ[\"CIBW_CACHE_PATH\"]) / \"nuget-cpython\"","+    cache.mkdir(parents=True, exist_ok=True)","+    installed = set()","+    arm64_libraries = {}","+","+    for configuration in configurations:","+        if not configuration.identifier.startswith(\"cp\"):","+            continue","+        architectures = [configuration.arch]","+        # An ARM64 wheel built on an AMD64 agent needs two Python packages:","+        # ARM64 provides the target import libraries, while AMD64 runs the build tools."],"additions":83,"deletions":0,"truncated":false}],"additions":381,"deletions":77,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-07T15:03:50.362645+00:00"}