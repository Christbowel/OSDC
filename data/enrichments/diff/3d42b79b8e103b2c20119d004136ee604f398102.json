{"id":"3d42b79b8e103b2c20119d004136ee604f398102","axis":"silent","repo":"Azure/azure-sdk-for-python","sha":"3d42b79b8e103b2c20119d004136ee604f398102","parsed":{"files":[{"path":"doc/dev/packaging.md","lines":["@@ -194,8 +194,15 @@ inside each container. The pipeline forwards `PIP_INDEX_URL`,"," `MSRUSTUP_ACCESS_TOKEN`, `MSRUSTUP_FEED_URL`, and the"," `CARGO_REGISTRIES_AZURE_SDK_FOR_RUST_PUBLIC_*` index, token, and credential-provider"," variables. Credentials stay in the build environment, not checked-in files.","-On Windows, `PYTHON_ARM64_LIB_DIR` points to the pre-provisioned ARM64 Python","-import libraries; a package can use it as `PYO3_CROSS_LIB_DIR` for cross-compilation.","+On Windows, `sdk_build` provisions only the package's selected CPython targets","+from the approved Azure SDK NuGet feed. Exact interpreter versions and package","+names come from the installed `cibuildwheel`, including native interpreters needed","+to cross-compile ARM64 wheels.","+For Microsoft Rust toolchain builds, `PYTHON_ARM64_LIB_DIR` and a temporary","+`PYO3_CONFIG_FILE` are set only for ARM64 targets, using that target's Python","+import libraries. A temporary cibuildwheel configuration preserves the resolved","+package environment and hooks without changing the checked-in package configuration","+or setting a single library path for the entire job."," "," This opt-in does not provision Rust for source-installing test, documentation,"," or analysis jobs. Prepare those jobs separately before enabling a Rust package,"],"additions":9,"deletions":2,"truncated":false},{"path":"eng/pipelines/templates/jobs/live.tests.yml","lines":["@@ -185,9 +185,8 @@ jobs:","         displayName: 'Configure cibuildwheel for dev requirement builds'","         condition: and(succeeded(), eq(variables['CIBUILDWHEEL_DEV_REQ'], 'true'))"," ","-      # Windows has no cp310 interpreter on the agent and cibuildwheel fetches one from api.nuget.org,","-      # which is blocked. Pre-provision it from the Azure DevOps feed into the cibuildwheel cache.","-      # Mirrors steps/build-package-artifacts.yml, minus pythonarm64 (CIBW_ARCHS=native drops win_arm64).","+      # Download the Python versions selected by cibuildwheel from the approved feed.","+      # This test job builds only for the current machine's architecture, not ARM64.","       - task: NuGetAuthenticate@1","         displayName: 'Authenticate to NuGet feed'","         condition: and(succeeded(), eq(variables['Agent.OS'], 'Windows_NT'), eq(variables['CIBUILDWHEEL_DEV_REQ'], 'true'))","@@ -195,17 +194,9 @@ jobs:","       - pwsh: |","           $ErrorActionPreference = 'Stop'","           $feed = \"https://pkgs.dev.azure.com/azure-sdk/public/_packaging/azure-sdk-for-net/nuget/v3/index.json\"","-          $version = \"3.10.11\"","           $cache = Join-Path \"$(Agent.TempDirectory)\" \"cibw-cache\"","-          $nugetCpython = Join-Path $cache \"nuget-cpython\"","-          New-Item -ItemType Directory -Force -Path $nugetCpython | Out-Null","-          $nuget = (Get-Command nuget).Source","-          & $nuget install python -Version $version -Source $feed -OutputDirectory $nugetCpython","-          if ($LASTEXITCODE) {","-            Write-Error \"Failed to download python $version\"","-            exit 1","-          }","           Write-Host \"##vso[task.setvariable variable=CIBW_CACHE_PATH]$cache\"","+          Write-Host \"##vso[task.setvariable variable=AZURESDK_PYTHON_NUGET_FEED]$feed\"","         displayName: 'Pre-provision CPython for cibuildwheel'","         condition: and(succeeded(), eq(variables['Agent.OS'], 'Windows_NT'), eq(variables['CIBUILDWHEEL_DEV_REQ'], 'true'))"," "],"additions":3,"deletions":12,"truncated":false},{"path":"eng/pipelines/templates/steps/build-package-artifacts.yml","lines":["@@ -143,8 +143,8 @@ steps:","         Condition: and(succeeded(), eq(variables['ENABLE_EXTENSION_BUILD'], 'true'))"," ","   # Windows: cibuildwheel fetches CPython from api.nuget.org, which is blocked.","-  # Pre-provision the interpreters from the Azure DevOps NuGet feed into the","-  # cibuildwheel cache so it skips the blocked download.","+  # sdk_build provisions each package's selected interpreters from this feed,","+  # using the installed cibuildwheel's metadata and cache layout.","   - task: NuGetAuthenticate@1","     displayName: 'Authenticate to NuGet feed'","     condition: and(succeeded(), eq(variables['Agent.OS'], 'Windows_NT'), eq(variables['ENABLE_EXTENSION_BUILD'], 'true'))","@@ -152,30 +152,11 @@ steps:","   - pwsh: |","       $ErrorActionPreference = 'Stop'","       $feed = \"https://pkgs.dev.azure.com/azure-sdk/public/_packaging/azure-sdk-for-net/nuget/v3/index.json\"","-      $version = \"3.10.11\"","       $cache = Join-Path \"$(Agent.TempDirectory)\" \"cibw-cache\"","-      $nugetCpython = Join-Path $cache \"nuget-cpython\"","-      New-Item -ItemType Directory -Force -Path $nugetCpython | Out-Null","-      $nuget = (Get-Command nuget).Source","-      & $nuget install python -Version $version -Source $feed -OutputDirectory $nugetCpython","-      if ($LASTEXITCODE) { ","-        Write-Error \"Failed to download python $version\"","-        exit 1","-      }","-      & $nuget install pythonarm64 -Version $version -Source $feed -OutputDirectory $nugetCpython","-      if ($LASTEXITCODE) { ","-        Write-Error \"Failed to download pythonarm64 $version\"","-        exit 1","-      }","       Write-Host \"##vso[task.setvariable variable=CIBW_CACHE_PATH]$cache\"","-","+      Write-Host \"##vso[task.setvariable variable=AZURESDK_PYTHON_NUGET_FEED]$feed\"","       if ($env:INSTALL_MS_RUST_TOOLCHAIN -eq 'true') {","-        # Packages use this path as PYO3_CROSS_LIB_DIR when cross-compiling Windows ARM64 wheels.","-        $arm64Libs = Join-Path $nugetCpython \"pythonarm64.$version\\tools\\libs\"","-        if (-not (Test-Path $arm64Libs)) {","-          throw \"Expected ARM64 Python import libraries at $arm64Libs\"","-        }","-        Write-Host \"##vso[task.setvariable variable=PYTHON_ARM64_LIB_DIR]$arm64Libs\"","+        Write-Host \"##vso[task.setvariable variable=AZURESDK_PYTHON_ARM64_LIBS]true\"","       }","     displayName: 'Pre-provision CPython for cibuildwheel'","     condition: and(succeeded(), eq(variables['Agent.OS'], 'Windows_NT'), eq(variables['ENABLE_EXTENSION_BUILD'], 'true'))"],"additions":4,"deletions":23,"truncated":false},{"path":"eng/scripts/Save-Package-Namespaces-Property.ps1","lines":["@@ -7,7 +7,8 @@ json file."," .DESCRIPTION"," Given an artifact staging directory and the artifacts list, loop through all artifacts"," that docs that aren't skipping docs creation and add the namespace to the PackageInfo","-json file. This is done using the .whl file from the build.","+json file. This is done using the .whl files from the build, combining their","+namespaces without duplicates."," "," .PARAMETER ArtifactStagingDirectory"," The root directory of the staged artifacts. The PackageInfo files will be in the","@@ -94,14 +95,14 @@ foreach($packageInfoFile in $artifacts) {","     # From the $packageInfo piece together the path to the javadoc jar file","     $WhlDir = Join-Path $ArtifactStagingDirectory $packageInfo.Name","     $WhlName = $packageInfo.Name.Replace(\"-\",\"_\")","-    $WhlFile = Get-ChildItem -Path $WhlDir -File -Filter \"$whlName-$version*.whl\"","+    $WhlFiles = @(Get-ChildItem -Path $WhlDir -File -Filter \"$whlName-$version*.whl\")"," ","-    if (!(Test-Path $WhlFile -PathType Leaf)) {","+    if ($WhlFiles.Count -eq 0) {","         LogError \"Whl file for, $($packageInfo.Name), was not found in $WhlDir. Please ensure that a .whl file is being produced for the library.\"","         $foundError = $true","         continue","     }","-    $namespaces = Get-NamespacesFromWhlFile $packageInfo.Name $version -PythonWhlFile $WhlFile","+    $namespaces = Get-NamespacesFromWhlFile $packageInfo.Name $version -PythonWhlFile $WhlFiles.FullName","     if ($namespaces.Count -gt 0) {","         Write-Host \"Adding/Updating Namespaces property with the following namespaces:\"","         $namespaces | Write-Host"],"additions":5,"deletions":4,"truncated":false},{"path":"eng/scripts/docs/Docs-ToC.ps1","lines":["@@ -22,45 +22,46 @@ function Get-WhlFile {","   return $true"," }"," ","-# Given a library and version, download the .whl file and unpack it to get the namespaces.","-# A temp directory is used for the download and unpack which is cleaned up afterwards.","+# Given a library and version, download a wheel or inspect the supplied wheels.","+# Each wheel is unpacked in isolation and the primary namespaces are deduplicated.","+# Temporary directories are unique to each invocation and cleaned up afterwards."," function Get-NamespacesFromWhlFile {","   param(","       [Parameter(Mandatory=$true)] [string]$Library,","       [Parameter(Mandatory=$true)] [string]$Version,","       [Parameter(Mandatory=$false)] [string]$ExtraIndexUrl = \"\",","-      [Parameter(Mandatory=$false)] [string]$PythonWhlFile = $null","+      [Parameter(Mandatory=$false)] [string[]]$PythonWhlFile = $null","   )"," ","-  $destination = (Join-Path ([System.IO.Path]::GetTempPath()) \"$Library$Version\")","-  New-Item $destination -ItemType Directory | Out-Null","+  $destination = (Join-Path ([System.IO.Path]::GetTempPath()) \"$Library$Version-$([Guid]::NewGuid())\")","+  New-Item $destination -ItemType Directory -ErrorAction Stop | Out-Null","   $namespaces = @()"," ","   try {"," ","     if ($PythonWhlFile) {","-      if (Test-Path $PythonWhlFile -PathType Leaf) {","-        Write-Host \"Copying $PythonWhlFile to $destination\"","-        Copy-Item $PythonWhlFile -Destination $destination","-      } else {","-        LogWarning \"$PythonWhlFile, does not exist.\"","-      }","+      $whlFiles = $PythonWhlFile","     } else {","       $success = Get-WhlFile $Library $Version $destination $ExtraIndexUrl","       if (-not $success) {","         LogWarning \"Could not download Whl file for $Library $Version\"","       }","+      $whlFiles = @(Get-ChildItem -Path $destination -File -Filter \"*.whl\" |","+          Select-Object -ExpandProperty FullName)","     }","-    # Pulling the whl file generates output, make sure it's sent to null so","-    # it's not returned as part of this function.","-    # Each library gets its own temporary directory. There should only be one whl","-    # file in the destination directory","-    $whlFile = Get-ChildItem -Path $destination -File -Filter \"*.whl\" | Select-Object -First 1","-    # If we can't download the file or the passed in file doesn't exist then the whlFile","-    # won't exist, there's nothing to process and an empty namesapces list will be returned","-    if ($whlFile) {","-      $unpackDir = Join-Path -Path $destination -ChildPath \"$Library-$Version\"","-      Expand-Archive -Path $whlFile -DestinationPath $unpackDir","+    foreach ($whlFile in $whlFiles) {","+      if (-not (Test-Path -LiteralPath $whlFile -PathType Leaf)) {","+        LogWarning \"$whlFile, does not exist.\"","+        continue","+      }","+","+      $wheelDestination = Join-Path $destination ([Guid]::NewGuid().ToString())","+      New-Item $wheelDestination -ItemType Directory -ErrorAction Stop | Out-Null","+      Write-Host \"Copying $whlFile to $wheelDestination\"","+      Copy-Item -LiteralPath $whlFile -Destination $wheelDestination -ErrorAction Stop","+      $unpackDir = Join-Path -Path $wheelDestination -ChildPath \"$Library-$Version\"","+      $wheelCopy = Join-Path $wheelDestination (Split-Path $whlFile -Leaf)","+      Expand-Archive -LiteralPath $wheelCopy -DestinationPath $unpackDir -ErrorAction Stop"," ","       # Look for any directory that contains __init__.py with the following exceptions:","       # 1. *.dist-info directories shouldn't be included in the results.","@@ -93,6 +94,7 @@ function Get-NamespacesFromWhlFile {","           Remove-Item $destination -Recurse -Force","       }","   }","+  $namespaces = @($namespaces | Sort-Object -Unique)","   # Make sure this always returns an array","   Write-Output -NoEnumerate $namespaces"," }"],"additions":23,"deletions":21,"truncated":false},{"path":"eng/scripts/tests/Package-Namespaces.tests.ps1","lines":["@@ -0,0 +1,226 @@","+# Copyright (c) Microsoft Corporation. All rights reserved.","+# Licensed under the MIT License.","+# Run with Pester 5: Invoke-Pester -Path eng\\scripts\\tests\\Package-Namespaces.tests.ps1","+","+BeforeAll {","+    $scriptsDirectory = Split-Path $PSScriptRoot -Parent","+    . (Join-Path $scriptsDirectory \"docs\" \"Docs-ToC.ps1\")","+","+    function LogWarning($Message) {","+        Write-Warning $Message","+    }","+","+    function New-TestWheel {","+        param([string]$Path, [string[]]$Entries)","+","+        $archive = [System.IO.Compression.ZipFile]::Open($Path, [System.IO.Compression.ZipArchiveMode]::Create)","+        try {","+            foreach ($entry in $Entries) {","+                $archive.CreateEntry($entry) | Out-Null","+            }","+        }","+        finally {","+            $archive.Dispose()","+        }","+        return $Path","+    }","+}","+","+Describe \"Get-NamespacesFromWhlFile\" {","+    BeforeEach {","+        $library = \"namespace-test-$([Guid]::NewGuid().ToString('N'))\"","+        $version = \"1.0.0\"","+        $wheelDirectory = New-Item (Join-Path $TestDrive $library) -ItemType Directory","+        $firstWheel = New-TestWheel (Join-Path $wheelDirectory \"test-1.0.0-cp310-win_amd64.whl\") @(","+            \"azure/__init__.py\",","+            \"azure/_internal/__init__.py\",","+            \"test.dist-info/__init__.py\",","+            \"azure/alpha/__init__.py\",","+            \"azure/alpha/child/__init__.py\"","+        )","+        $secondWheel = New-TestWheel (Join-Path $wheelDirectory \"test-1.0.0-cp314-manylinux_x86_64.whl\") @(","+            \"azure/zeta/__init__.py\"","+        )","+    }","+","+    AfterEach {","+        $remainingDirectories = @(Get-ChildItem ([System.IO.Path]::GetTempPath()) -Directory -Filter \"$library$version*\")","+        try {","+            $remainingDirectories.Count | Should -Be 0","+        }","+        finally {","+            foreach ($directory in $remainingDirectories) {","+                Remove-Item -LiteralPath $directory.FullName -Recurse -Force","+            }","+        }","+    }","+","+    It \"preserves the single-wheel array and primary-namespace discovery rules\" {","+        $namespaces = Get-NamespacesFromWhlFile $library $version -PythonWhlFile $firstWheel","+","+        ,$namespaces | Should -BeOfType [array]","+        $namespaces.Count | Should -Be 1","+        $namespaces[0] | Should -BeExactly \"azure.alpha\"","+    }","+","+    It \"combines distinct namespaces without mixing extracted wheel contents\" {","+        $namespaces = Get-NamespacesFromWhlFile $library $version -PythonWhlFile @($firstWheel, $secondWheel)","+","+        $namespaces | Should -Be @(\"azure.alpha\", \"azure.zeta\")","+    }","+","+    It \"deduplicates namespaces from multiple platform wheels\" {","+        $duplicateWheel = New-TestWheel (Join-Path $wheelDirectory \"test-1.0.0-cp311-macosx_arm64.whl\") @(","+            \"azure/alpha/__init__.py\"","+        )","+        $namespaces = Get-NamespacesFromWhlFile $library $version -PythonWhlFile @($firstWheel, $duplicateWheel, $secondWheel)","+","+        $namespaces | Should -Be @(\"azure.alpha\", \"azure.zeta\")","+    }","+","+    It \"isolates wheels with identical filenames from different directories\" {","+        $otherDirectory = New-Item (Join-Path $wheelDirectory \"other\") -ItemType Directory","+        $sameNameWheel = New-TestWheel (Join-Path $otherDirectory (Split-Path $firstWheel -Leaf)) @(","+            \"azure/zeta/__init__.py\"","+        )","+        $namespaces = Get-NamespacesFromWhlFile $library $version -PythonWhlFile @($firstWheel, $sameNameWheel)","+","+        $namespaces | Should -Be @(\"azure.alpha\", \"azure.zeta\")","+    }","+","+    It \"does not reuse or remove a preexisting package-version directory\" {","+        $oldDestination = Join-Path ([System.IO.Path]::GetTempPath()) \"$library$version\"","+        New-Item $oldDestination -ItemType Directory | Out-Null","+        $sentinel = Join-Path $oldDestination \"sentinel.txt\"","+        Set-Content $sentinel \"unrelated contents\"","+        try {","+            Get-NamespacesFromWhlFile $library $version -PythonWhlFile $firstWheel | Should -Be @(\"azure.alpha\")","+            Get-Content $sentinel | Should -BeExactly \"unrelated contents\"","+        }","+        finally {","+            Remove-Item -LiteralPath $oldDestination -Recurse -Force","+        }","+    }","+","+    It \"warns and returns an empty array for a missing wheel\" {","+        Mock LogWarning {}","+        $missingWheel = Join-Path $wheelDirectory \"missing.whl\"","+        $namespaces = Get-NamespacesFromWhlFile $library $version -PythonWhlFile $missingWheel","+","+        ,$namespaces | Should -BeOfType [array]","+        $namespaces.Count | Should -Be 0","+        Should -Invoke LogWarning -Times 1 -Exactly -ParameterFilter { $Message -eq \"$missingWheel, does not exist.\" }","+    }","+","+    It \"preserves the download path and extra index argument\" {","+        $expectedLibrary = $library","+        $expectedVersion = $version","+        Mock Get-WhlFile {","+            param($Library, $Version, $Destination, $ExtraIndexUrl)","+            Copy-Item $firstWheel -Destination $Destination","+            return $true","+        }","+        $namespaces = Get-NamespacesFromWhlFile $library $version \"https://example.invalid/simple\"","+","+        $namespaces | Should -Be @(\"azure.alpha\")","+        Should -Invoke Get-WhlFile -Times 1 -Exactly -ParameterFilter {","+            $Library -eq $expectedLibrary -and $Version -eq $expectedVersion -and $ExtraIndexUrl -eq \"https://example.invalid/simple\"","+        }","+    }","+","+    It \"warns and returns an empty array when the wheel download fails\" {","+        Mock Get-WhlFile { return $false }","+        Mock LogWarning {}","+        $namespaces = Get-NamespacesFromWhlFile $library $version","+","+        ,$namespaces | Should -BeOfType [array]","+        $namespaces.Count | Should -Be 0","+        Should -Invoke LogWarning -Times 1 -Exactly -ParameterFilter {","+            $Message -eq \"Could not download Whl file for $library $version\"","+        }","+    }","+","+    It \"surfaces extraction errors and cleans up temporary files\" {","+        $invalidWheel = Join-Path $wheelDirectory \"invalid.whl\"","+        Set-Content $invalidWheel \"not a zip archive\"","+","+        { Get-NamespacesFromWhlFile $library $version -PythonWhlFile @($firstWheel, $invalidWheel) } | Should -Throw","+    }","+}","+","+Describe \"Save-Package-Namespaces-Property.ps1\" {","+    BeforeAll {","+        Import-Module powershell-yaml -ErrorAction Stop","+        $fixtureRoot = Join-Path $TestDrive \"repo\"","+        $fixtureScripts = Join-Path $fixtureRoot \"eng\" \"scripts\"","+        $fixtureCommon = Join-Path $fixtureRoot \"eng\" \"common\" \"scripts\"","+        New-Item (Join-Path $fixtureScripts \"docs\") -ItemType Directory -Force | Out-Null","+        New-Item (Join-Path $fixtureCommon \"Helpers\") -ItemType Directory -Force | Out-Null","+        Copy-Item (Join-Path $scriptsDirectory \"Save-Package-Namespaces-Property.ps1\") $fixtureScripts","+        Copy-Item (Join-Path $scriptsDirectory \"docs\" \"Docs-ToC.ps1\") (Join-Path $fixtureScripts \"docs\")","+        Copy-Item (Join-Path $scriptsDirectory \"..\" \"common\" \"scripts\" \"Helpers\" \"PSModule-Helpers.ps1\") (Join-Path $fixtureCommon \"Helpers\")","+        # Isolate repository discovery and logging; execute the real caller and extractor.","+        Set-Content (Join-Path $fixtureCommon \"common.ps1\") @'","+$RepoRoot = Resolve-Path (Join-Path $PSScriptRoot \"..\" \"..\" \"..\")","+. (Join-Path $RepoRoot \"eng\" \"scripts\" \"docs\" \"Docs-ToC.ps1\")","+function LogError($Message) { Write-Host \"ERROR: $Message\" }","+function LogWarning($Message) { Write-Warning $Message }","+'@","+        $serviceDirectory = Join-Path $fixtureRoot \"sdk\" \"test\"","+        New-Item $serviceDirectory -ItemType Directory -Force | Out-Null","+        Set-Content (Join-Path $serviceDirectory \"ci.yml\") @'","+extends:","+  parameters:","+    Artifacts:","+      - name: azure-test","+'@","+        $saveScript = Join-Path $fixtureScripts \"Save-Package-Namespaces-Property.ps1\"","+        $pwsh = (Get-Process -Id $PID).Path","+    }","+","+    BeforeEach {","+        $stagingDirectory = Join-Path $TestDrive ([Guid]::NewGuid().ToString())","+        $wheelDirectory = Join-Path $stagingDirectory \"azure-test\"","+        New-Item $wheelDirectory -ItemType Directory -Force | Out-Null","+        $packageInfoDirectory = New-Item (Join-Path $stagingDirectory \"PackageInfo\") -ItemType Directory","+        $packageInfoFile = Join-Path $packageInfoDirectory \"azure-test.json\"","+        @{","+            Name = \"azure-test\"","+            Version = \"1.0.0\"","+            DevVersion = \"\"","+            ServiceDirectory = \"test\"","+        } | ConvertTo-Json | Set-Content $packageInfoFile","+    }","+","+    It \"writes a deduplicated JSON array from all matching wheels\" {","+        New-TestWheel (Join-Path $wheelDirectory \"azure_test-1.0.0-cp310-win_amd64.whl\") @(\"azure/alpha/__init__.py\") | Out-Null","+        New-TestWheel (Join-Path $wheelDirectory \"azure_test-1.0.0-cp311-macosx_arm64.whl\") @(\"azure/alpha/__init__.py\") | Out-Null","+        New-TestWheel (Join-Path $wheelDirectory \"azure_test-1.0.0-cp314-manylinux_x86_64.whl\") @(\"azure/zeta/__init__.py\") | Out-Null","+        New-TestWheel (Join-Path $wheelDirectory \"azure_test-2.0.0-py3-none-any.whl\") @(\"azure/unrelated/__init__.py\") | Out-Null","+","+        $output = & $pwsh -NoProfile -File $saveScript -ArtifactStagingDirectory $stagingDirectory 2>&1","+        $LASTEXITCODE | Should -Be 0 -Because ($output -join [Environment]::NewLine)","+        $packageInfo = Get-Content $packageInfoFile -Raw | ConvertFrom-Json","+        ,$packageInfo.Namespaces | Should -BeOfType [array]","+        $packageInfo.Namespaces | Should -Be @(\"azure.alpha\", \"azure.zeta\")","+    }","+","+    It \"preserves single-wheel output as a JSON array\" {","+        New-TestWheel (Join-Path $wheelDirectory \"azure_test-1.0.0-py3-none-any.whl\") @(\"azure/alpha/__init__.py\") | Out-Null","+","+        $output = & $pwsh -NoProfile -File $saveScript -ArtifactStagingDirectory $stagingDirectory 2>&1","+        $LASTEXITCODE | Should -Be 0 -Because ($output -join [Environment]::NewLine)","+        $packageInfo = Get-Content $packageInfoFile -Raw | ConvertFrom-Json","+        ,$packageInfo.Namespaces | Should -BeOfType [array]","+        $packageInfo.Namespaces | Should -Be @(\"azure.alpha\")","+    }","+","+    It \"reports the missing wheel and exits with failure without modifying metadata\" {","+        $original = Get-Content $packageInfoFile -Raw","+        $output = & $pwsh -NoProfile -File $saveScript -ArtifactStagingDirectory $stagingDirectory 2>&1","+","+        $LASTEXITCODE | Should -Be 1","+        ($output -join [Environment]::NewLine) | Should -Match \"Whl file for, azure-test, was not found\"","+        Get-Content $packageInfoFile -Raw | Should -BeExactly $original","+    }","+}"],"additions":226,"deletions":0,"truncated":false},{"path":"eng/tools/azure-sdk-tools/ci_tools/build.py","lines":["@@ -9,6 +9,7 @@"," from ci_tools.versioning.version_shared import set_version_py, set_dev_classifier"," from ci_tools.versioning.version_set_dev import get_dev_version, format_build_id"," from ci_tools.logging import logger, configure_logging, run_logged","+from ci_tools.windows_wheels import windows_wheel_config"," "," "," def build_package() -> None:","@@ -246,12 +247,14 @@ def cre