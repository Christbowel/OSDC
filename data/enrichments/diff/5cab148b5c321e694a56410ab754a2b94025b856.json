ed Type) (bv 64)) (ret (bv 32)))","     ((args (named Type) (bv 64)) (ret (bv 64))))"," ","+;; The integer operand is converted at its full precision: it is widened to 64","+;; bits (zero- or sign-extended to match the signedness of the conversion) and","+;; handed to `to_fp`, which rounds to the destination float width. Narrowing the","+;; operand to the float width first would model, for example, `fcvt_from_uint.f32","+;; x:i64` as converting only the low 32 bits of `x`."," (spec (fcvt_from_uint ty x)","     (provide","         (= (:bits ty) (widthof result))","-        (let ((N (widthof result)))","-            (= result (to_fp_unsigned N (conv_to N (zero_ext 64 x)))))))","+        (= result (to_fp_unsigned (widthof result) (zero_ext 64 x)))))"," (instantiate fcvt_from_uint fcvt)"," "," (spec (fcvt_from_sint ty x)","     (provide","         (= (:bits ty) (widthof result))","-        (let ((N (widthof result)))","-            (= result (to_fp N (conv_to N (sign_ext 64 x)))))))","+        (= result (to_fp (widthof result) (sign_ext 64 x)))))"," (instantiate fcvt_from_sint fcvt)"," "," ;; Can trap if invalid conversion"],"additions":143,"deletions":60,"truncated":false},{"path":"cranelift/codegen/src/spec/opt.isle","lines":["@@ -0,0 +1,698 @@","+;;;; Specs for mid-end (`opt`) helper terms declared in `prelude_opt.isle`,","+;;;; rather than in the shared `inst_specs.isle`.","+","+;; Soundness contract for the top-level rewrite term: by default a rewrite must","+;; preserve the value exactly (bitwise equality). This holds for all non-floating","+;; point rules and for most float values, including deterministic float bit-ops","+;; (`fneg`/`fabs`/`fcopysign`) and float arithmetic that does not produce a NaN.","+;;","+;; The one exception is float arithmetic that produces a NaN: because Wasm","+;; arithmetic NaN payloads are nondeterministic, exact bit-equality is too","+;; strong. When the value being rewritten was produced by a float-arithmetic op","+;; that returned a