{"id":"c3176787446d0d4c7b6f2b164337c3e6b9d628ba","axis":"silent","repo":"pnpm/pnpm","sha":"c3176787446d0d4c7b6f2b164337c3e6b9d628ba","parsed":{"files":[{"path":".changeset/gvs-serialize-slot-builds.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/building.during-install\": patch","+\"@pnpm/installing.deps-restorer\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Concurrent installs that share a global virtual store now run a package's build in its shared slot one at a time. A failed build leaves the slot in place and marks it for the next install to rebuild [#15568](https://github.com/pnpm/pnpm/issues/15568)."],"additions":8,"deletions":0,"truncated":false},{"path":".changeset/shared-dir-lock.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/fs.dir-lock\": patch","+\"@pnpm/exec.commands\": patch","+\"pnpm\": patch","+---","+","+Published the cross-process directory lock as `@pnpm/fs.dir-lock` [#15568](https://github.com/pnpm/pnpm/issues/15568)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -1921,6 +1921,9 @@ importers:","       '@pnpm/exec.lifecycle':","         specifier: workspace:*","         version: link:../../exec/lifecycle","+      '@pnpm/fs.dir-lock':","+        specifier: workspace:*","+        version: link:../../fs/dir-lock","       '@pnpm/fs.hard-link-dir':","         specifier: workspace:*","         version: link:../../fs/hard-link-dir","@@ -1954,6 +1957,9 @@ importers:","       p-defer:","         specifier: 'catalog:'","         version: 4.0.1","+      path-exists:","+        specifier: 'catalog:'","+        version: 5.0.0","       ramda:","         specifier: 'catalog:'","         version: '@pnpm/ramda@0.28.1'","@@ -4415,6 +4421,9 @@ importers:","       '@pnpm/exec.pnpm-cli-runner':","         specifier: workspace:*","         version: link:../pnpm-cli-runner","+      '@pnpm/fs.dir-lock':","+        specifier: workspace:*","+        version: link:../../fs/dir-lock","       '@pnpm/installing.client