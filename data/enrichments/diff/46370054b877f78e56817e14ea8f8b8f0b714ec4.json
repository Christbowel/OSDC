catch (...)","         {","-            killQueryIfStoppedByClient(state);","             executor.cancel();","             throw;","         }","@@ -3257,21 +3207,6 @@ void TCPHandler::processCancel(QueryState & state)","     throw Exception(ErrorCodes::QUERY_WAS_CANCELLED_BY_CLIENT, \"Received 'Cancel' packet from the client, canceling the query.\");"," }"," ","-void TCPHandler::killQueryIfStoppedByClient(QueryState & state)","-{","-    {","-        std::lock_guard lock(*callback_mutex);","-        /// `out` is canceled when a write to the client fails.","-        if (!state.stop_query && !out->isCanceled())","-            return;","-    }","-","-    /// Cancelling the executor waits for its threads, and some code they run checks only the process list entry (e.g. `sleep`).","-    /// The client's exception is passed, so that it is the one the query fails with.","-    if (auto process_list_element = state.query_context->getProcessListElementSafe())","-        process_list_element->cancelQuery(CancelReason::CANCELLED_BY_USER, std::current_exception());","-}","-"," void TCPHandler::receivePacketsExpectCancel(QueryState & state, bool force)"," {","     if (!force && after_check_cancelled.elapsed() / 1000 < interactive_delay)"],"additions":86,"deletions":151,"truncated":false},{"path":"src/Server/TCPHandler.h","lines":["@@ -317,7 +317,6 @@ class TCPHandler : public Poco::Net::TCPServerConnection","     InitialAllRangesAnnouncementResponse receiveAllRangesAnnouncementResponse(QueryState & state) TSA_REQUIRES(callback_mutex);"," ","     void processCancel(QueryState & state) TSA_REQUIRES(callback_mutex);","-    void killQueryIfStoppedByClient(QueryState & state);","     void processQuery(std::shared_ptr<QueryState> & state);","     bool processData(QueryState & state, bool scalar) TSA_REQUIRES(callback_mutex);","     void processClusterNameAndSalt();"],"additions":0,"deletions":1,"truncated":false},{"path":"tests/queries/0_stateless/04117_detach_database_kill_query.sh","lines":["@@ -1,5 +1,8 @@"," #!/usr/bin/env bash","-# Tags: no-random-settings","+# Tags: no-parallel, no-random-settings","+# Tag no-parallel: killing the `SELECT` does not stop its remote part (the follower, under parallel replicas),","+# which keeps sleeping until the hung check at the end of the run reports it. Remove once a query cancelled","+# by its client stops sleeping: https://github.com/ClickHouse/ClickHouse/pull/127149"," # Tag no-random-settings: relies on predictable per-row execution timing of `sleepEachRow`"," "," CUR_DIR=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)"],"additions":4,"deletions":1,"truncated":false},{"path":"tests/queries/0_stateless/04869_opentelemetry_async_remote_query_spans.sh","lines":["@@ -224,6 +224,9 @@ for _retry in {1..100}; do"," done"," ${CLICKHOUSE_CLIENT} -q \"kill query where query_id = '$kill_query_id' sync format Null\""," wait","+# `sleep` never polls the socket the initiator's cancel arrives on, and the KILL above matched only","+# the initiator's own process-list entry, so the remote leg keeps sleeping: end it explicitly.","+${CLICKHOUSE_CLIENT} -q \"kill query where initial_query_id = '$kill_query_id' and query_id != initial_query_id sync format Null\""," "," poll_spans \"","     with UUIDNumToString(toFixedString(unhex('$trace_id'), 16)) as t"],"additions":3,"deletions":0,"truncated":false},{"path":"tests/queries/0_stateless/05025_opentelemetry_remote_query_executor_shard_spans.sh","lines":["@@ -213,6 +213,9 @@ for _retry in {1..100}; do"," done"," ${CLICKHOUSE_CLIENT} -q \"kill query where query_id = '$kill_query_id' sync format Null\""," wait","+# `sleep` never polls the socket the initiator's cancel arrives on, and the KILL above matched only","+# the initiator's own process-list entry, so the remote leg keeps sleeping: end it explicitly.","+${CLICKHOUSE_CLIENT} -q \"kill query where initial_query_id = '$kill_query_id' and query_id != initial_query_id sync format Null\""," "," poll_spans \"","     with UUIDNumToString(toFixedString(unhex('$trace_id'), 16)) as t"],"additions":3,"deletions":0,"truncated":false},{"path":"tests/queries/0_stateless/05452_cancel_by_client_stops_sleep.reference","lines":["@@ -1,9 +0,0 @@","-remote: stopped","-cluster function: stopped","-select, client killed: stopped","-insert select: stopped","-streamed insert: stopped","-streamed insert exception\tQUERY_WAS_CANCELLED_BY_CLIENT","-streamed insert, client killed: stopped","-insert select from input: stopped","-create as select: stopped"],"additions":0,"deletions":9,"truncated":false},{"path":"tests/queries/0_stateless/05452_cancel_by_client_stops_sleep.sh","lines":["@@ -1,157 +0,0 @@","-#!/usr/bin/env bash","-","-CURDIR=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)","-# shellcheck source=../shell_config.sh","-. \"$CURDIR\"/../shell_config.sh","-","-# A query cancelled by its client over the native protocol must stop a long `sleepEachRow` block (300 s here)","-# instead of running it to the end.","-","-settings=\"max_block_size = 100, max_threads = 1, function_sleep_max_microseconds_per_block = 600000000\"","-","-# The query has been running for a while, so it is sleeping.","-function wait_for_query()","-{","-    local where=$1","-    local start=$SECONDS","-    while (( SECONDS - start < 60 )); do","-        [ \"$($CLICKHOUSE_CLIENT -q \"SELECT count() FROM system.processes WHERE $where AND elapsed > 1\")\" = 1 ] && return","-        sleep 0.1","-    done","-    echo \"query did not start: $where\"","-}","-","-function wait_until_gone()","-{","-    local name=$1 where=$2","-    local start=$SECONDS","-    while (( SECONDS - start < 60 )); do","-        if [ \"$($CLICKHOUSE_CLIENT -q \"SELECT count() FROM system.processes WHERE $where\")\" = 0 ]; then","-            echo \"$name: stopped\"","-            return","-        fi","-        sleep 0.2","-    done","-    echo \"$name: still running\"","-    $CLICKHOUSE_CLIENT -q \"KILL QUERY WHERE $where SYNC FORMAT Null\"","-}","-","-# The remote part of a query whose initiator is killed: the initiator cancels it with a `Cancel` packet.","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_remote\"","-$CLICKHOUSE_CLIENT --query_id \"$query_id\" -q \"","-    SELECT count() FROM remote('127.0.0.2', numbers(100)) WHERE sleepEachRow(3) = 0","-    SETTINGS prefer_localhost_replica = 0, $settings\" >/dev/null 2>&1 &","-wait_for_query \"initial_query_id = '$query_id' AND NOT is_initial_query AND query LIKE '%sleepEachRow%'\"","-$CLICKHOUSE_CLIENT -q \"KILL QUERY WHERE query_id = '$query_id' SYNC FORMAT Null\"","-wait_until_gone \"remote\" \"initial_query_id = '$query_id'\"","-","-# The remote part of a cluster table function: one stream sleeps on the first URL (6000 rows, 300 s), the other keeps","-# asking the initiator for the next of the 300 one-row URLs, so the `Cancel` is received by a read task request","-# (`interactive_delay` keeps the connection's own thread from reading it first).","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_cluster\"","-url=\"http://127.0.0.1:${CLICKHOUSE_PORT_HTTP}/?query=SELECT+{0..300}+AS+n+FROM+numbers(6000)+WHERE+n+%3D+0+OR+number+%3D+0\"","-$CLICKHOUSE_CLIENT --query_id \"$query_id\" -q \"","-    SELECT count() FROM urlCluster('test_shard_localhost', '$url', 'TSV', 'x UInt64') WHERE x + sleepEachRow(0.05) >= 0","-    SETTINGS max_threads = 2, max_threads_min_free_memory_per_thread = 0, use_concurrency_control = 0, max_block_size = 10000,","-        input_format_parallel_parsing = 0, function_sleep_max_microseconds_per_block = 600000000, interactive_delay = 10000000","-    \" >/dev/null 2>&1 &","-wait_for_query \"initial_query_id = '$query_id' AND NOT is_initial_query AND read_rows >= 6000\"","-$CLICKHOUSE_CLIENT -q \"KILL QUERY WHERE query_id = '$query_id' SYNC FORMAT Null\"","-wait_until_gone \"cluster function\" \"initial_query_id = '$query_id'\"","-","-# The client dies while it receives the result of one stream and the other one sleeps, so the server sees that on a","-# write (`interactive_delay` keeps it from polling the socket first). The first stream is longer than the test profile's","-# `max_rows_to_read` allows.","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_select_killed\"","-$CLICKHOUSE_CLIENT --query_id \"$query_id\" --interactive_delay 600000000 -q \"","-    SELECT number, 0 AS s FROM numbers(1000000000) UNION ALL SELECT number, sleepEachRow(3) AS s FROM numbers(100)","-    SETTINGS max_threads = 2, max_threads_min_free_memory_per_thread = 0, use_concurrency_control = 0, max_block_size = 100,","-        max_rows_to_read = 0, function_sleep_max_microseconds_per_block = 600000000\" >/dev/null 2>&1 &","-client_pid=$!","-wait_for_query \"query_id = '$query_id'\"","-kill -KILL $client_pid","-wait $client_pid 2>/dev/null","-wait_until_gone \"select, client killed\" \"query_id = '$query_id'\"","-","-# A query with a completed pipeline (INSERT SELECT) cancelled by `clickhouse-client` on SIGINT.","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_insert\"","-$CLICKHOUSE_CLIENT --query_id \"$query_id\" -q \"","-    INSERT INTO FUNCTION null('x UInt8') SELECT sleepEachRow(3) FROM numbers(100)","-    SETTINGS $settings\" >/dev/null 2>&1 &","-client_pid=$!","-wait_for_query \"query_id = '$query_id'\"","-kill -INT $client_pid","-wait_until_gone \"insert select\" \"query_id = '$query_id'\"","-","-# A streamed INSERT: with `parallel_view_processing` the pipeline runs in its own threads, so the server still reads","-# from the client while the materialized view sleeps on the first block.","-$CLICKHOUSE_CLIENT -q \"","-    CREATE TABLE src (x UInt8) ENGINE = Memory;","-    CREATE TABLE dst (x UInt8) ENGINE = Memory;","-    CREATE MATERIALIZED VIEW mv TO dst AS SELECT sleepEachRow(3) + x AS x FROM src\"","-","-function start_streamed_insert()","-{","-    local query_id=$1 query=${2:-\"INSERT INTO src FORMAT TSV\"}","-    # A FIFO per query: the previous client may still be reading its own, and would take this query's data.","-    fifo=\"${CLICKHOUSE_TMP}/${query_id}.fifo\"","-    rm -f \"$fifo\"","-    mkfifo \"$fifo\"","-    $CLICKHOUSE_CLIENT --query_id \"$query_id\" --async_insert 0 --parallel_view_processing 1 --max_threads 4 \\","-        --max_threads_min_free_memory_per_thread 0 --input_format_parallel_parsing 0 --max_insert_block_size 100 \\","-        --max_block_size 100 --function_sleep_max_microseconds_per_block 600000000 \\","-        -q \"$query\" < \"$fifo\" >/dev/null 2>&1 &","-    client_pid=$!","-    # Let bash pick the descriptor: under CI, shell_config.sh sends the xtrace to fd 3.","-    exec {fifo_fd}>\"$fifo\"","-    seq 150 1>&\"${fifo_fd}\"","-    wait_for_query \"query_id = '$query_id' AND read_rows > 0\"","-}","-","-# After SIGINT, `clickhouse-client` sends a `Cancel` when it reads the next block from stdin.","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_streamed_insert\"","-start_streamed_insert \"$query_id\"","-kill -INT $client_pid","-seq 100 1>&\"${fifo_fd}\" 2>/dev/null","-wait_until_gone \"streamed insert\" \"query_id = '$query_id'\"","-exec {fifo_fd}>&-","-rm -f \"$fifo\"","-# The query ends with the client's exception, not with the generic cancellation of the process list entry.","-$CLICKHOUSE_CLIENT -q \"SYSTEM FLUSH LOGS query_log\"","-$CLICKHOUSE_CLIENT -q \"","-    SELECT 'streamed insert exception', errorCodeToName(exception_code) FROM system.query_log","-    WHERE current_database = currentDatabase() AND query_id = '$query_id' AND type = 'ExceptionWhileProcessing'\"","-","-# The client dies, so the server reads the end of the connection instead of a `Cancel`.","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_streamed_insert_killed\"","-start_streamed_insert \"$query_id\"","-kill -KILL $client_pid","-wait $client_pid 2>/dev/null","-wait_until_gone \"streamed insert, client killed\" \"query_id = '$query_id'\"","-exec {fifo_fd}>&-","-rm -f \"$fifo\"","-","-# With `input()` a pipeline thread reads the data, so it is the one that receives the `Cancel`.","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_input\"","-start_streamed_insert \"$query_id\" \"INSERT INTO src SELECT * FROM input('x UInt8') FORMAT TSV\"","-kill -INT $client_pid","-seq 100 1>&\"${fifo_fd}\" 2>/dev/null","-wait_until_gone \"insert select from input\" \"query_id = '$query_id'\"","-exec {fifo_fd}>&-","-rm -f \"$fifo\"","-","-# A completed pipeline that runs inside the query: CREATE TABLE ... AS SELECT in an Atomic database fills the table","-# before publishing it. The database is created here, so that a Replicated one does not replay the query under another query id.","-ctas_database=\"${CLICKHOUSE_DATABASE}_ctas\"","-$CLICKHOUSE_CLIENT -q \"CREATE DATABASE $ctas_database ENGINE = Atomic\"","-query_id=\"${CLICKHOUSE_TEST_UNIQUE_NAME}_ctas\"","-$CLICKHOUSE_CLIENT --query_id \"$query_id\" -q \"","-    CREATE TABLE $ctas_database.t ENGINE = Memory AS SELECT sleepEachRow(3) AS x FROM numbers(100)","-    SETTINGS $settings\" >/dev/null 2>&1 &","-client_pid=$!","-wait_for_query \"query_id = '$query_id'\"","-kill -INT $client_pid","-wait_until_gone \"create as select\" \"query_id = '$query_id'\"","-","-wait","-$CLICKHOUSE_CLIENT -q \"DROP DATABASE $ctas_database\"",""],"additions":0,"deletions":157,"truncated":false}],"additions":97,"deletions":322,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-05T16:30:04.461272+00:00"}