{"id":"899a1689e2a014ca42567bd9ae6cf96c13fe5e94","axis":"silent","repo":"vllm-project/vllm","sha":"899a1689e2a014ca42567bd9ae6cf96c13fe5e94","parsed":{"files":[{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -155,6 +155,17 @@ steps:","       commands:","       - pytest -v -s models/inkling/rocm"," ","+- label: \":nvidia: (B200) Flint\"","+  key: flint-unit-tests-b200","+  timeout_in_minutes: 30","+  device: b200-k8s","+  source_file_dependencies:","+  - vllm/models/flint/","+  - tests/models/flint/","+  commands:","+    - uv pip install --system 'gguf>=0.19.0'","+    - pytest -v -s models/flint","+"," - label: \":nvidia: (B200) Kimi K3\"","   key: kimi-k3-unit-tests-b200","   timeout_in_minutes: 40"],"additions":11,"deletions":0,"truncated":false},{"path":"docker/Dockerfile","lines":["@@ -972,12 +972,15 @@ RUN set -eux; \\"," "," # Install vllm-openai dependencies (saves ~2.6s per build)"," # These are stable packages that don't depend on vLLM itself","-# From versions.json: .openai_server_extras.timm, .openai_server_extras.runai_model_streamer","+# From versions.json: .openai_server_extras.timm, .openai_server_extras.runai_model_streamer,","+# .openai_server_extras.gguf (NVFP4 GGUF checkpoints, e.g. RecursiveSI/flint-nvfp4-gguf)"," ARG TIMM_VERSION=\">=1.0.17\""," ARG RUNAI_MODEL_STREAMER_VERSION=\">=0.15.7\"","+ARG GGUF_VERSION=\">=0.19.0\""," RUN --mount=type=cache,target=/opt/uv/cache \\","     uv pip install --system accelerate 'modelscope<1.38' \\","-        \"timm${TIMM_VERSION}\" \"runai-model-streamer[s3,gcs,azure]${RUNAI_MODEL_STREAMER_VERSION}\"","+        \"timm${TIMM_VERSION}\" \"runai-model-streamer[s3,gcs,azure]${RUNAI_MODEL_STREAMER_VERSION}\" \\","+        \"gguf${GGUF_VERSION}\""," "," # ============================================================"," # VLLM INSTALLATION (depends on build stage)"],"additions":5,"deletions":2,"truncated":false},{"path":"docker/versions.json","lines":["@@ -84,6 +84,9 @@","     },","     \"RUNAI_MODEL_STREAMER_VERSION\": {","       \"default\": \">=0.15.7\"","+    },","+    \"GGUF_VERSION\": {","+      \"default\": \">=0.19.0\"","     }","   }"," }"],"additions":3,"deletions":0,"truncated":false},{"path":"docs/models/supported_models.md","lines":["@@ -400,6 +400,7 @@ th {"," | `FalconForCausalLM` | Falcon | `tiiuae/falcon-7b`, `tiiuae/falcon-40b`, `tiiuae/falcon-rw-7b`, etc. | | ✅︎ |"," | `FalconMambaForCausalLM` | FalconMamba | `tiiuae/falcon-mamba-7b`, `tiiuae/falcon-mamba-7b-instruct`, etc. | | ✅︎ |"," | `FalconH1ForCausalLM` | Falcon-H1 | `tiiuae/Falcon-H1-34B-Base`, `tiiuae/Falcon-H1-34B-Instruct`, etc. | ✅︎ | ✅︎ |","+| `FlintForCausalLM` | Flint | `RecursiveSI/flint`, `RecursiveSI/flint-nvfp4-gguf` (GGUF) | | ✅︎ |"," | `GemmaForCausalLM` | Gemma | `google/gemma-2b`, `google/gemma-1.1-2b-it`, etc. | ✅︎ | ✅︎ |"," | `Gemma2ForCausalLM` | Gemma 2 | `google/gemma-2-9b`, `google/gemma-2-27b`, etc. | ✅︎ | ✅︎ |"," | `Gemma3ForCausalLM` | Gemma 3 | `google/gemma-3-1b-it`, etc. | ✅︎ | ✅︎ |"],"additions":1,"deletions":0,"truncated":false},{"path":"recipes/models/RecursiveSI/flint.yaml","lines":["@@ -0,0 +1,152 @@","+# yaml-language-server: $schema=https://recipes.vllm.ai/recipe.schema.json","+","+meta:","+  title: \"Flint\"","+  slug: \"flint\"","+  provider: \"RecursiveSI\"","+  description: \"39.8B-parameter (2.5B active) MoE with hybrid sliding-window / full attention, reasoning and tool calling; BF16 and NVFP4 checkpoints on a single Blackwell GPU.\"","+  date_added: 2026-10-18","+  date_updated: 2026-10-21","+  tasks:","+    - text","+  performance_headline: \"Single GB200, NVFP4: ~2.0 ms per output token at batch 1 with 100K context\"","+  related_recipes: []","+  default_hardware: gb200","+  hardware:","+    gb200: verified","+","+model:","+  model_id: \"RecursiveSI/flint\"","+  min_vllm_version: \"nightly\"","+  install:","+    pip:","+      note: \"Use a nightly wheel. The NVFP4 GGUF checkpoint also needs `pip install 'gguf>=0.19.0'`.\"","+    docker:","+      note: \"Use the vLLM nightly image.\"","+  architecture: moe","+  parameter_count: \"39.8B\"","+  active_parameters: \"2.5B\"","+  context_length: 262144","+  base_args: []","+  base_env: {}","+  rust_frontend: unsupported","+","+features:","+  tool_calling:","+    description: \"Automatic tool choice with the GLM-4.7 XML tool-call parser (Flint's chat template emits <tool_call>/<arg_key>/<arg_value>); tools are dropped from the prompt when tool_choice is none, as in the reference runtime.\"","+    args: [\"--enable-auto-tool-choice\", \"--tool-call-parser\", \"glm47\", \"--exclude-tools-when-tool-choice-none\"]","+  reasoning:","+    description: \"Return the <think>…</think> block in the reasoning field; the model decides per turn whether to reason.\"","+    args: [\"--reasoning-parser\", \"glm47\"]","+","+opt_in_features: []","+","+variants:","+  default:","+    precision: bf16","+    vram_minimum_gb: 96","+    description: \"BF16 safetensors (79.6 GB of weights).\"","+  nvfp4:","+    model_id: \"RecursiveSI/flint-nvfp4-gguf\"","+    precision: nvfp4","+    vram_minimum_gb: 29","+    description: \"NVFP4 GGUF served weight-only (W4A16); 23.5 GB resident after load (the LM head is dequantized to BF16). Config and tokenizer come from the BF16 repo.\"","+    extra_args: [\"--hf-config-path\", \"RecursiveSI/flint\", \"--tokenizer\", \"RecursiveSI/flint\"]","+","+compatible_strategies:","+  - single_node_tp","+","+hardware_overrides: {}","+","+strategy_overrides:","+  single_node_tp:","+    tp: 1","+","+guide: |","+  ## Overview","+","+  Flint is a 39.8B-parameter mixture-of-experts model (256 experts, top-6 sigmoid routing plus a","+  shared expert; ~2.5B parameters active per token) with 49 layers: 35 sliding-window layers","+  (window 513, RoPE) and 14 full-attention layers (no RoPE), GQA 32/4, attention sinks, and a","+  262,144-token context. Two checkpoints are served:","+","+  - [RecursiveSI/flint](https://huggingface.co/RecursiveSI/flint): BF16 safetensors.","+  - [RecursiveSI/flint-nvfp4-gguf](https://huggingface.co/RecursiveSI/flint-nvfp4-gguf): a single","+    NVFP4 GGUF (repacked losslessly at load and run as W4A16, like the reference runtime). It ships","+    no config or tokenizer; both come from the BF16 repo.","+","+  Tested end to end on one GB200 (TP=1, BF16 KV cache, CUDA graphs, no torch.compile) for both","+  checkpoints. On a single GPU the Flint kernels are always used (fused MoE, small-batch CuTe GEMV,","+  CuTe decode attention, low-latency decode path for <= 8 requests); TP > 1 and expert parallelism","+  fall back to stock vLLM layers and are not validated.","+","+  ## Launch","+","+  BF16:","+","+  ```bash","+  vllm serve RecursiveSI/flint --served-model-name flint \\","+    --enable-auto-tool-choice --tool-call-parser glm47 --reasoning-parser glm47 \\","+    --exclude-tools-when-tool-choice-none","+  ```","+","+  NVFP4 (requires `gguf>=0.19.0`):","+","+  ```bash","+  vllm serve RecursiveSI/flint-nvfp4-gguf \\","+    --hf-config-path RecursiveSI/flint --tokenizer RecursiveSI/flint \\","+    --served-model-name flint \\","+    --enable-auto-tool-choice --tool-call-parser glm47 --reasoning-parser glm47 \\","+    --exclude-tools-when-tool-choice-none","+  ```","+","+  ## Client usage","+","+  Use `/v1/chat/completions`. Sampling defaults from `generation_config.json`: temperature 1.0,","+  top_p 0.95, top_k 20 (greedy decoding is not validated). Reasoning is returned in `reasoning`","+  and counts toward `max_tokens`; use `max_tokens` of at least 32768 for hard problems.","+","+  ```bash","+  curl localhost:8000/v1/chat/completions -H 'Content-Type: application/json' -d '{","+    \"model\": \"flint\",","+    \"messages\": [{\"role\": \"user\", \"content\": \"What is 17*23? Answer briefly.\"}],","+    \"max_tokens\": 1024","+  }'","+  ```","+","+  Accuracy on GB200 with this recipe (BF16 / NVFP4): GSM8K 0.950 / 0.950, GPQA-Diamond (4 repeats)","+  0.721 / 0.696, MRCR (48 samples, up to 114K-token prompts) ~0.47 / ~0.46, tool-calling suite","+  (19 cases x 10: typed args, tool selection, parallel calls, multi-turn, tool_choice none,","+  escaping, streaming) 10/10 on every case.","+","+  ## Benchmarking","+","+  Forward time on one GB200 (`vllm bench forward`, batch x context, us):","+","+  | shape | BF16 | NVFP4 |","+  |---|---|---|","+  | decode 1 x 100K | 2341 | 1783 |","+  | decode 8 x 100K | 6836 | 5703 |","+  | decode 32 x 100K | 19580 | 16716 |","+  | prefill 8K @ 100K | 145617 | 144765 |","+","+  Serving (NVFP4, `vllm bench serve`, random 1000 in / 1000 out): TPOT 2.0 ms at concurrency 1,","+  2.8 ms at 8, 4.9 ms at 32, 8.5 ms at 128; median inter-token latency 2.06 ms at batch 1 with","+  100K context. Prefill runs eagerly and is CPU-bound on kernel-launch overhead: TTFT is ~60 ms","+  for a short prompt and ~125 ms for an 8K-token prompt.","+","+  ## Troubleshooting","+","+  - Rust frontend: not supported for this recipe. It rejects `--exclude-tools-when-tool-choice-none`,","+    and for NVFP4 also `--hf-config-path` / `--tokenizer`; keep the default Python frontend.","+  - Reasoning parser: the reference runtime's `deepseek-v3` name maps to vLLM's `deepseek_v3`","+    parser, which only extracts reasoning when the request enables `thinking`; with Flint the","+    reasoning then stays in `content`. Use `glm47`.","+  - If `content` contains literal `<think>` or `<tool_call>` text, the server was started without","+    the parsers above.","+  - Batch-1 decode time varies by ~3-4% between sessions (a GPU-side state, not configuration).","+","+  ## References","+","+  - [Flint (BF16) model card](https://huggingface.co/RecursiveSI/flint)","+  - [Flint NVFP4 model card](https://huggingface.co/RecursiveSI/flint-nvfp4-gguf)"],"additions":152,"deletions":0,"truncated":false},{"path":"tests/models/flint/test_decode_attention.py","lines":["@@ -0,0 +1,278 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The Flint split-KV decode attention kernel must match an fp64 reference at","+bf16 output-rounding level, mirror FlashInfer trtllm-gen's numerics, and stay","+correct under CUDA graph replay with new sequence lengths.\"\"\"","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+","+if not current_platform.is_cuda() or not current_platform.is_device_capability_family(","+    100","+):","+    pytest.skip(\"Flint decode attention targets SM100\", allow_module_level=True)","+","+from flashinfer.decode import trtllm_batch_decode_with_kv_cache  # noqa: E402","+","+from vllm.models.flint.ops.decode_attention import flint_decode_attention  # noqa: E402","+","+HQ, HKV, D, PAGE = 32, 4, 128, 16","+SCALE = D**-0.5","+WINDOW = 513","+","+","+def _make(","+    seq_lens: list[int], seed: int = 0","+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:","+    \"\"\"Random q/K/V/sinks; blocks are shuffled so block tables are non-trivial.\"\"\"","+    g = torch.Generator(device=\"cuda\").manual_seed(seed)","+    pages = [(s + PAGE - 1) // PAGE for s in seq_lens]","+    num_blocks = sum(pages) + 5","+    kv = torch.randn(num_blocks, HKV, PAGE, 2 * D, device=\"cuda\", generator=g)","+    perm = torch.randperm(num_blocks, device=\"cuda\", generator=g).int()","+    bt = torch.zeros(len(seq_lens), max(pages + [1]) + 2, dtype=torch.int32)","+    bt = bt.cuda()","+    o = 0","+    for i, n in enumerate(pages):","+        bt[i, :n] = perm[o : o + n]","+        o += n","+    q = torch.randn(len(seq_lens), HQ, D, device=\"cuda\", generator=g) * 2","+    sinks = torch.randn(HQ, device=\"cuda\", generator=g) * 2","+    sl = torch.tensor(seq_lens, dtype=torch.int32, device=\"cuda\")","+    return q.bfloat16(), kv.bfloat16(), bt, sl, sinks","+","+","+def _reference(q, kv, bt, seq_lens, sinks, window):","+    out = torch.zeros(q.shape, dtype=torch.float64, device=q.device)","+    for i, s in enumerate(seq_lens.tolist()):","+        if s == 0:","+            continue","+        n = (s + PAGE - 1) // PAGE","+        x = kv[bt[i, :n].long()].permute(1, 0, 2, 3).reshape(HKV, n * PAGE, 2 * D)","+        x = x[:, max(s - window, 0) if window else 0 : s].double()","+        k, v = x[..., :D], x[..., D:]","+        scores = torch.einsum(\"hgd,htd->hgt\", q[i].double().view(HKV, -1, D), k)","+        scores = scores * SCALE","+        sink = sinks.double().view(HKV, -1, 1)","+        m = torch.maximum(scores.amax(-1, keepdim=True), sink)","+        p = torch.exp(scores - m)","+        denom = p.sum(-1, keepdim=True) + torch.exp(sink - m)","+        out[i] = (torch.einsum(\"hgt,htd->hgd\", p, v) / denom).reshape(HQ, D)","+    return out","+","+","+def _flashinfer(q, kv, bt, seq_lens, sinks, window):","+    workspace = torch.zeros(128 << 20, dtype=torch.uint8, device=\"cuda\")","+    k_cache, v_cache = kv.split(D, dim=-1)","+    return trtllm_batch_decode_with_kv_cache(","+        q,","+        (k_cache, v_cache),","+        workspace,","+        bt,","+        seq_lens,","+        int(seq_lens.max()),","+        bmm1_scale=SCALE,","+        window_left=window - 1 if window else -1,","+        sinks=sinks,","+        kv_layout=\"HND\",","+        backend=\"trtllm-gen\",","+    )","+","+","+def _flint(q, kv, bt, seq_lens, sinks, window, out=None):","+    out = torch.empty_like(q) if out is None else out","+    return flint_decode_attention(q, kv, bt, seq_lens, sinks, window, SCALE, out)","+","+","+def _rel_err(x, ref):","+    \"\"\"|x - ref| relative to each output row's max magnitude.\"\"\"","+    scale = ref.abs().amax(-1, keepdim=True).clamp_min(1e-6)","+    return (x.double() - ref).abs() / scale","+","+","+@pytest.mark.parametrize(","+    \"seq_lens\",","+    [","+        [1],","+        [17],","+        [1000],","+        [20011],","+        [5, 77, 1000, 4097, 16, 33, 513, 3001],","+        [100, 2000, 37] * 10 + [1, 9000],","+    ],","+    ids=[\"1\", \"17\", \"1000\", \"20011\", \"mixed8\", \"mixed32\"],","+)","+@pytest.mark.parametrize(\"window\", [None, WINDOW], ids=[\"full\", \"swa\"])","+@torch.inference_mode()","+def test_matches_reference_and_flashinfer(seq_lens: list[int], window: int | None):","+    args = _make(seq_lens)","+    ref = _reference(*args, window)","+    out = _flint(*args, window)","+    fi_err = _rel_err(_flashinfer(*args, window), ref)","+    err = _rel_err(out, ref)","+    # One bf16 ulp of the row max is 2^-8; trtllm-gen also rounds its split","+    # partials to bf16, so its error bounds ours.","+    assert err.max() < 8e-3","+    assert err.max() <= fi_err.max() + 1e-3","+    assert err.mean() <= fi_err.mean() + 1e-4","+","+","+@pytest.mark.parametrize(\"seq_len\", [513, 514, 529, 530, 545, 20000])","+@torch.inference_mode()","+def test_window_crosses_block_boundary(seq_len: int):","+    \"\"\"The first attended page is partial; earlier tokens must be masked.\"\"\"","+    args = _make([seq_len, seq_len + 7], seed=seq_len)","+    err = _rel_err(_flint(*args, WINDOW), _reference(*args, WINDOW))","+    assert err.max() < 8e-3","+","+","+@torch.inference_mode()","+def test_launch_from_another_stream_waits_for_the_previous_one():","+    \"\"\"Launches share the split workspace and arrival counters, so a launch","+    from a different stream must not start before the previous one ends.\"\"\"","+    args = _make([20011] * 4)","+    _flint(*args, None)","+    stream_a, stream_b = torch.cuda.Stream(), torch.cuda.Stream()","+    torch.accelerator.synchronize()","+    with torch.cuda.stream(stream_a):","+        torch.cuda._sleep(100_000_000)  # ~50 ms at ~2 GHz","+        a_done = torch.cuda.Event()","+        _flint(*args, None)","+        a_done.record()","+    with torch.cuda.stream(stream_b):","+        _flint(*args, None)","+        b_done = torch.cuda.Event()","+        b_done.record()","+    b_done.synchronize()","+    assert a_done.query()","+","+","+@torch.inference_mode()","+def test_empty_request_writes_zeros():","+    q, kv, bt, sl, sinks = _make([0, 40])","+    out = torch.full_like(q, float(\"nan\"))","+    _flint(q, kv, bt, sl, sinks, None, out)","+    assert (out[0] == 0).all()","+    assert _rel_err(out[1:], _reference(q, kv, bt, sl, sinks, None)[1:]).max() < 8e-3","+","+","+@torch.inference_mode()","+def test_probabilities_summed_in_fp32():","+    \"\"\"Like trtllm-gen, P is rounded to bf16 for P @ V but the softmax","+    denominator sums the fp32 probabilities. With V = 1, one max-logit token","+    per page (so every split sees the same running max) and all other","+    probabilities just below a bf16 rounding midpoint, the output is visibly","+    below 1 (it would be exactly 1 with fp32 P or a bf16-P denominator).\"\"\"","+    n = 1000","+    q, kv, bt, sl, sinks = _make([n])","+    kv.zero_()","+    q.zero_()","+    q[..., 0] = 1.0","+    q[..., 1] = 2**-6","+    flat = kv.view(-1, HKV, PAGE, 2 * D)[bt[0, : (n + PAGE - 1) // PAGE].long()]","+    flat[..., 0] = -7.8125  # p = exp2((s - 0) * scale * log2e) = 0.50195..","+    flat[..., 1] = 0.9296875","+    flat[:, :, 0, :2] = 0.0  # first token of every page at the max (p = 1)","+    flat[..., D:] = 1.0","+    kv.view(-1, HKV, PAGE, 2 * D)[bt[0, : (n + PAGE - 1) // PAGE].long()] = flat","+    sinks.fill_(-100.0)","+    out = _flint(q, kv, bt, sl, sinks, None)","+    expected = _flashinfer(q, kv, bt, sl, sinks, None)","+    assert (expected == 0.99609375).all()","+    torch.testing.assert_close(out, expected, atol=0, rtol=0)","+","+","+@torch.inference_mode()","+def test_cuda_graph_replay_with_new_lengths():","+    \"\"\"Grid shape depends only on the batch size; the split-combine counters","+    reset themselves, so replays with different lengths stay correct.\"\"\"","+    lens_a = [30000, 17, 4100, 515]","+    lens_b = [1, 31000, 513, 9000]","+    q, kv, bt, sl, sinks = _make(lens_b)","+    out = torch.empty_like(q)","+    _, _, bt_a, sl_a, _ = _make(lens_a)","+    bt_a = torch.nn.functional.pad(bt_a, (0, bt.shape[1] - bt_a.shape[1]))","+    static_bt, static_sl = bt_a.clone(), sl_a.clone()","+    for window in (None, WINDOW):","+        _flint(q, kv, static_bt, static_sl, sinks, window, out)  # warm up / compile","+        graph = torch.cuda.CUDAGraph()","+        with torch.cuda.graph(graph):","+            _flint(q, kv, static_bt, static_sl, sinks, window, out)","+        for bt_x, sl_x in ((bt, sl), (bt_a, sl_a), (bt, sl)):","+            static_bt.copy_(bt_x)","+            static_sl.copy_(sl_x)","+            graph.replay()","+            ref = _reference(q, kv, static_bt, static_sl, sinks, window)","+            assert _rel_err(out, ref).max() < 8e-3","+","+","+def _early_trigger_writer():","+    \"\"\"A PDL kernel that releases its dependents immediately, idles ~2 us,","+    then writes one token's K/V into the cache, like","+    ``qk_norm_rope_cache(launch_dependents=True)``.\"\"\"","+    import cutlass","+    import cutlass.cute as cute","+    from cutlass import Int32, Int64","+","+    class Writer:","+        @cute.jit","+        def __call__(self, src, dst, cycles: Int32, stream):","+            self.kernel(src, dst, cycles).launch(","+                grid=(1, 1, 1), block=(256, 1, 1), stream=stream, use_pdl=True","+            )","+","+        @cute.kernel","+        def kernel(self, src, dst, cycles: Int32):","+            cute.arch.griddepcontrol_wait()","+            cute.arch.griddepcontrol_launch_dependents()","+            t0 = cute.arch.clock64()","+            while cute.arch.clock64() - t0 < Int64(cycles):","+                pass","+            tid, _, _ = cute.arch.thread_idx()","+            dst[tid] = src[tid]","+","+    from cutlass.cute.runtime import make_fake_stream","+    from quack.compile_utils import make_fake_tensor","+","+    bf16 = cutlass.BFloat16","+    return cute.compile(","+        Writer(),","+        make_fake_tensor(bf16, (256,), divisibility=8),","+        make_fake_tensor(bf16, (256,), divisibility=8),","+        Int32(1),","+        make_fake_stream(use_tvm_ffi_env_stream=True),","+        options=\"--enable-tvm-ffi\",","+    )","+","+","+@pytest.mark.parametrize(\"window\", [None, WINDOW], ids=[\"full\", \"swa\"])","+@torch.inference_mode()","+def test_current_token_written_by_pdl_predecessor(window: int | None):","+    \"\"\"K/V pages are prefetched before the grid-dependency wait, except the","+    page holding the current token: K/V written there by an early-triggering","+    predecessor must be seen.\"\"\"","+    writer = _early_trigger_writer()","+    # The last write (request 3, head 3) races the attention kernel; with one","+    # token, a stale read would change that output entirely.","+    lens = [20011, 4096, 17, 1]","+    q, kv, bt, sl, sinks = _make(lens)","+    new_kv = torch.randn(len(lens), HKV, 2 * D, device=\"cuda\").bfloat16() * 4","+    out = torch.empty_like(q)","+    blks = [int(bt[i, (s - 1) // PAGE]) for i, s in enumerate(lens)]","+    _flint(q, kv, bt, sl, sinks, window, out)  # compile / workspace","+    graph = torch.cuda.CUDAGraph()","+    with torch.cuda.graph(graph):","+        for i, s in enumerate(lens):","+            for h in range(HKV):","+                writer(new_kv[i, h], kv[blks[i], h, (s - 1) % PAGE], 4000)","+        _flint(q, kv, bt, sl, sinks, window, out)","+    kv_before = kv.clone()","+    graph.replay()","+    torch.accelerator.synchronize()","+    for i, s in enumerate(lens):","+        kv_before[blks[i], :, (s - 1) % PAGE] = new_kv[i]","+    assert torch.equal(kv, kv_before)","+    ref = _reference(q, kv, bt, sl, sinks, window)","+    assert _rel_err(out, ref).max() < 8e-3"],"additions":278,"deletions":0,"truncated":false},{"path":"tests/models/flint/test_flint_moe.py","lines":["@@ -0,0 +1,436 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Flint's fused NVFP4 W4A16 MoE (vllm/models/flint/ops/moe.py) must follow the","+reference rounding rule on both the decode (GEMV) and the grouped-GEMM paths","+and route exactly like sigmoid top-k.\"\"\"","+","+import pytest","+import torch","+","+from vllm.models.flint.gguf_nvfp4 import dequantize_nvfp4","+from vllm.models.flint.ops import moe","+from vllm.platforms import current_platform","+","+E, H, INTER, TOPK = 256, 2048, 512, 6","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_device_capability_family(100),","+    reason=\"SM100 only\",","+)","+","+","+def _nvfp4(rows: int, cols: int, gen: torch.Generator):","+    w = torch.randint(","+        0, 256, (E, rows, cols // 2), dtype=torch.uint8, device=\"cuda\", generator=gen","+    )","+    # E4M3 scales over ~2^-6..2^2 with all mantissas.","+    exp = torch.randint(1, 10, (E, rows, cols // 16), device=\"cuda\", generator=gen)","+    man = torch.randint(0, 8, (E, rows, cols // 16), device=\"cuda\", generator=gen)","+    s = ((exp << 3) | man).to(torch.uint8).view(torch.float8_e4m3fn)","+    gs = torch.rand(E, device=\"cuda\", generator=gen) * 2e-3 + 1e-3","+    return w, s, gs","+","+","+@pytest.fixture(scope=\"module\")","+def weights():","+    gen = torch.Generator(device=\"cuda\").manual_seed(0)","+    w13, s13, gs13 = _nvfp4(2 * INTER, H, gen)","+    w2, s2, gs2 = _nvfp4(H, INTER, gen)","+    router = (torch.randn(E, H, device=\"cuda\", generator=gen) * 0.02).bfloat16()","+    return dict(w13=w13, s13=s13, gs13=gs13, w2=w2, s2=s2, gs2=gs2, router=router)","+","+","+@pytest.fixture(scope=\"module\")","+def flint_weights(weights):","+    return moe.FlintMoEWeights.from_modelopt(","+        weights[\"w13\"],","+        weights[\"s13\"],","+        weights[\"gs13\"],","+        weights[\"w2\"],","+        weights[\"s2\"],","+        weights[\"gs2\"],","+    )","+","+","+def _inputs(num_tokens: int, seed: int | None = None):","+    gen = torch.Generator(device=\"cuda\").manual_seed(","+        num_tokens if seed is None else seed","+    )","+    x = torch.randn(num_tokens, H, device=\"cuda\", generator=gen)","+    x = (x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True))).bfloat16()","+    shared = (torch.randn(num_tokens, H, device=\"cuda\", generator=gen) * 0.1).bfloat16()","+    return x, shared","+","+","+def _reference(x, w, ids, tw, shared, bf16_points: bool):","+    \"\"\"MoE on exactly dequantized weights with fp32 GEMMs.","+","+    bf16_points=False: everything in fp32 (returns fp32).","+    bf16_points=True: the reference (TRTLLM MoE) rounding rule (returns bf16):","+    fp32 gate/up, act = bf16(silu(g) * u), y_e = bf16(acc_e * global_scale_e),","+    routed = bf16(sum_e tw_e * y_e) in fp32 (tw already bf16-rounded by the","+    router), out = bf16(routed + shared).","+    \"\"\"","+    bf = torch.bfloat16","+    routed = torch.zeros(x.shape[0], H, device=x.device)","+    for e in ids.unique().tolist():","+        tok, slot = (ids == e).nonzero(as_tuple=True)","+        w13 = dequantize_nvfp4(w[\"w13\"][e], w[\"s13\"][e], torch.tensor(1.0))","+        w2 = dequantize_nvfp4(w[\"w2\"][e], w[\"s2\"][e], torch.tensor(1.0))","+        gu = (x[tok].float() @ w13.T) * w[\"gs13\"][e]","+        g, u = gu[:, :INTER], gu[:, INTER:]","+        if bf16_points:","+            h = (torch.nn.functional.silu(g) * u).to(bf).float()","+            y = ((h @ w2.T) * w[\"gs2\"][e]).to(bf).float()","+        else:","+            h = torch.nn.functional.silu(g) * u","+            y = (h @ w2.T) * w[\"gs2\"][e]","+        routed.index_add_(0, tok, tw[tok, slot, None] * y)","+    if not bf16_points:","+        return routed + shared.float()","+    return (routed.to(bf).float() + shared.float()).to(bf)","+","+","+def _rel(a: torch.Tensor, b: torch.Tensor) -> float:","+    return float((a.float() - b.float()).norm() / b.float().norm())","+","+","+def _run(x, router, fw, shared, decode_max: int | None = None):","+    \"\"\"flint_moe with an optionally forced decode/grouped dispatch.\"\"\"","+    old = moe.DECODE_MAX_TOKENS","+    if decode_max is not None:","+        moe.DECODE_MAX_TOKENS = decode_max","+    try:","+        counter = moe.make_route_counter(\"cuda\")","+        return moe.flint_moe(x, router, fw, TOPK, counter, shared)","+    finally:","+        moe.DECODE_MAX_TOKENS = old","+","+","+@torch.inference_mode()","+def test_dequant_exact():","+    \"\"\"The E2M1 * E4M3 decode is exact for every (code, scale) pair.\"\"\"","+    import triton","+    import triton.language as tl","+","+    @triton.jit","+    def kernel(w_ptr, s_ptr, out_ptr, N: tl.constexpr):","+        offs = tl.arange(0, N)","+        o = moe._dequant8(tl.load(w_ptr + offs), tl.load(s_ptr + offs))","+        for j in tl.static_range(8):","+            tl.store(out_ptr + offs * 8 + j, o[j])","+","+    # Every non-NaN E4M3 scale applied to one 16-code block holding codes","+    # 0..15 (two int32 words).","+    scales = torch.arange(256, dtype=torch.uint8, device=\"cuda\")","+    scales = scales[(scales & 0x7F) != 0x7F]","+    codes = torch.arange(16, dtype=torch.uint8, device=\"cuda\")","+    block = codes[0::2] | (codes[1::2] << 4)","+    words = block.repeat(scales.numel()).view(torch.int32)","+    n = words.numel()","+    padded_w = torch.zeros(512, dtype=torch.int32, device=\"cuda\")","+    padded_s = torch.zeros(512, dtype=torch.uint8, device=\"cuda\")","+    padded_w[:n] = words","+    padded_s[:n] = scales.repeat_interleave(2)","+    out_dtype = torch.bfloat16 if moe._DEQUANT_BF16 else torch.float16","+    padded_out = torch.empty(512 * 8, dtype=out_dtype, device=\"cuda\")","+    kernel[(1,)](padded_w, padded_s, padded_out, N=512)","+    ref = dequantize_nvfp4(","+        block.repeat(scales.numel()).view(-1, 8),","+        scales.view(torch.float8_e4m3fn).view(-1, 1),","+        torch.tensor(1.0),","+    )","+    torch.testing.assert_close(","+        padded_out[: n * 8].float(), ref.flatten(), rtol=0, atol=0","+    )","+","+","+@pytest.mark.parametrize(","+    \"num_tokens\",","+    [1, 5, moe.ROUTE_GEMV_MAX_TOKENS, moe.ROUTE_GEMV_MAX_TOKENS + 1, 300],","+)","+@torch.inference_mode()","+def test_routing(weights, num_tokens: int):","+    x, _ = _inputs(num_tokens)","+    counter = moe.make_route_counter(\"cuda\")","+    ids, tw = moe.route(x, weights[\"router\"], TOPK, counter)","+    if num_tokens > moe.ROUTE_GEMV_MAX_TOKENS:","+        # Same cuBLAS bf16 GEMM as the kernel path; only top-k is under test.","+        logits = (x @ weights[\"router\"].T).float()","+    else:","+        logits = (x.float() @ weights[\"router\"].float().T).bfloat16().float()","+    ref_s, ref_ids = torch.sigmoid(logits).topk(TOPK, dim=-1)","+    torch.testing.assert_close(","+        ids.sort(-1).values, ref_ids.int().sort(-1).values, rtol=0, atol=0","+    )","+    # Renormalized as the reference does, then rounded to bf16.","+    ref_tw = ref_s / (ref_s.sum(-1, keepdim=True) + 1e-20)","+    ref_tw = ref_tw.bfloat16().float()","+    order, ref_order = ids.argsort(-1), ref_ids.argsort(-1)","+    got, ref_tw = tw.gather(1, order), ref_tw.gather(1, ref_order)","+    # The fp32 sigmoid / sum may differ in the last bit: rare 1-ulp bf16 flips.","+    assert (got == ref_tw).float().mean() > 0.99","+    torch.testing.assert_close(got, ref_tw, rtol=2**-7, atol=0)","+","+","+@torch.inference_mode()","+def test_topk_ties_pick_lowest_expert():","+    logits = torch.zeros(2, E, device=\"cuda\", dtype=torch.bfloat16)","+    logits[0, [7, 3, 200, 9, 100, 50, 2]] = 1.0","+    logits[1, :] = -1.0","+    ids = torch.empty(2, TOPK, dtype=torch.int32, device=\"cuda\")","+    tw = torch.empty(2, TOPK, dtype=torch.float32, device=\"cuda\")","+    moe._topk_kernel[(2,)](logits, ids, tw, E=E, TOPK=TOPK)","+    assert ids[0].tolist() == [2, 3, 7, 9, 50, 100]","+    assert ids[1].tolist() == [0, 1, 2, 3, 4, 5]","+    torch.testing.assert_close(","+        tw, torch.full_like(tw, 1 / TOPK).bfloat16().float(), rtol=0, atol=0","+    )","+","+","+@pytest.mark.parametrize(","+    \"num_tokens\",","+    [","+        1,","+        moe.DECODE_MAX_TOKENS - 1,","+        moe.DECODE_MAX_TOKENS,","+        moe.DECODE_MAX_TOKENS + 1,","+        64,","+        600,","+    ],","+)","+@torch.inference_mode()","+def test_moe_matches_reference(weights, flint_weights, num_tokens: int):","+    \"\"\"Output follows the bf16 rounding rule (bitwise on >= 99% of elements)","+    and stays at the bf16 rounding level of the fp32 reference.\"\"\"","+    x, shared = _inputs(num_tokens)","+    out = _run(x, weights[\"router\"], flint_weights, shared)","+    ids, tw = moe.route(x, weights[\"router\"], TOPK, moe.make_route_counter(\"cuda\"))","+    ref16 = _reference(x, weights, ids.long(), tw, shared, bf16_points=True)","+    ref32 = _reference(x, weights, ids.long(), tw, shared, bf16_points=False)","+    match = (out == ref16).float().mean().item()","+    assert match >= 0.99, match","+    assert _rel(out, ref32) < 1.25 * _rel(ref16, ref32)","+    tok_err = (out.float() - ref32).norm(dim=-1) / ref32.norm(dim=-1)","+    assert tok_err.max() < 0.01","+","+","+@torch.inference_mode()","+def test_experts_module_loads_per_expert_tensors(weights, flint_weights):","+    \"\"\"FlintNvfp4Experts assembles per-expert checkpoint tensors correctly and","+    repacks only once every distinct tensor is loaded.\"\"\"","+    layer = moe.FlintNvfp4Experts(E, H, INTER, TOPK).cuda()","+","+    def ckpt(experts):","+        for e in experts:","+            for proj, rows in (","+                (\"gate_proj\", slice(INTER)),","+                (\"up_proj\", slice(INTER, 2 * INTER)),","+            ):","+                yield f\"{e}.{proj}.weight\", weights[\"w13\"][e, rows]","+                yield f\"{e}.{proj}.weight_scale\", weights[\"s13\"][e, rows]","+                yield f\"{e}.{proj}.weight_scale_2\", weights[\"gs13\"][e]","+            yield f\"{e}.down_proj.weight\", weights[\"w2\"][e]","+            yield f\"{e}.down_proj.weight_scale\", weights[\"s2\"][e]","+            yield f\"{e}.down_proj.weight_scale_2\", weights[\"gs2\"][e]","+","+    # Duplicates of expert 0 must not count towards completion.","+    layer.load_weights(ckpt([0] * E))","+    assert layer.weights is None"],"additions":239,"deletions":0,"truncated":false}],"additions":689,"deletions":2,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-23T14:15:05.499831+00:00"}