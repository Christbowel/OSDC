s\\n-c 1 --url=https://example.com\\x00\","," \t\t\texpected: []ConfigurationEntry{"," \t\t\t\t{Key: \"lfs.customtransfer.demo.args\", Value: \"-c 1 --url=https://example.com\"},"," \t\t\t},"," \t\t},","+\t\t{","+\t\t\tname:   \"value with newline\",","+\t\t\tconfig: \"lfs.url\\nfirst\\nsecond\\x00\",","+\t\t\texpected: []ConfigurationEntry{","+\t\t\t\t{Key: \"lfs.url\", Value: \"first\\nsecond\"},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:   \"value with newline and equals sign\",","+\t\t\tconfig: \"lfs.url\\nfirst\\nsecond=third\\x00\",","+\t\t\texpected: []ConfigurationEntry{","+\t\t\t\t{Key: \"lfs.url\", Value: \"first\\nsecond=third\"},","+\t\t\t},","+\t\t},"," \t}"," "," \tfor _, test := range tests {","@@ -77,7 +91,7 @@ func TestParseConfigEntries(t *testing.T) {"," }"," "," func TestParseConfigEntriesPreservesOnlySafeKeys(t *testing.T) {","-\tsource := ParseConfigEntries(\"lfs.url=https://example.com/repo\", true)","+\tsource := ParseConfigEntries(\"lfs.url\\nhttps://example.com/repo\\x00\", true)"," "," \tassert.Equal(t, []ConfigurationEntry{"," \t\t{Key: \"lfs.url\", Value: \"https://example.com/repo\"},"],"additions":21,"deletions":7,"truncated":false},{"path":"t/t-config.sh","lines":["@@ -346,3 +346,52 @@ begin_test \"config: env with duplicate lfs.* values\"","   [ 0 -eq \"$(grep -c -F 'git config \"remote.origin.pushurl\"' env.log)\" ]"," )"," end_test","+","+begin_test \"config: newline in lfsconfig value does not inject another key\"","+(","+  set -e","+","+  reponame=\"config-newline-lfsconfig\"","+  git init \"$reponame\"","+  cd \"$reponame\"","+","+  # A newline embedded in one option's value must not be parsed as a","+  # separate option.  Here the value of the \"lfs.fetchinclude\" option","+  # attempts to inject an \"lfs.url\" option which would override the","+  # real endpoint because it would appear as the final \"lfs.url\" value.","+  git config --file=.lfsconfig lfs.url http://real-endpoint","+  git config --file=.lfsconfig lfs.fetchinclude \\","+    \"$(printf 'x\\nlfs.url=http://injected-endpoint')\"","+","+  git lfs env >env.log 2>&1","+","+  grep -F \"Endpoint=http://real-endpoint (auth=none)\" env.log","+","+  [ 0 -eq \"$(grep -c -F 'warning: These `git config` values clash:' env.log)\" ]","+  [ 0 -eq \"$(grep -c -F 'git config \"lfs.url\" = \"http://injected-endpoint\"' env.log)\" ]","+","+  # Stage the file and remove it from the working tree so that Git LFS reads","+  # the configuration from the index blob instead.","+  git add .lfsconfig","+  rm .lfsconfig","+","+  git lfs env >env.log 2>&1","+","+  grep -F \"Endpoint=http://real-endpoint (auth=none)\" env.log","+","+  [ 0 -eq \"$(grep -c -F 'warning: These `git config` values clash:' env.log)\" ]","+  [ 0 -eq \"$(grep -c -F 'git config \"lfs.url\" = \"http://injected-endpoint\"' env.log)\" ]","+","+  # Commit the file, then remove it from the index so that Git LFS reads","+  # the configuration from the HEAD blob instead.","+  git commit -m \"add lfsconfig\"","+  git rm --cached .lfsconfig","+","+  git lfs env >env.log 2>&1","+","+  grep -F \"Endpoint=http://real-endpoint (auth=none)\" env.log","+","+  [ 0 -eq \"$(grep -c -F 'warning: These `git config` values clash:' env.log)\" ]","+  [ 0 -eq \"$(grep -c -F 'git config \"lfs.url\" = \"http://injected-endpoint\"' env.log)\" ]","+)","+end_test"],"additions":49,"deletions":0,"truncated":false},{"path":"t/t-submodule-lfsconfig.sh","lines":["@@ -73,3 +73,122 @@ begin_test \"submodule update --init --remote with .lfsconfig\"","   grep \"$submodcontent\" sub/dir/test.dat"," )"," end_test","+","+begin_test \"submodule URL with injected custom adapter\"","+(","+  set -e","+","+  reponame=\"submodule-adapter-injection\"","+  git init \"$reponame\"","+  cd \"$reponame\"","+","+  # We generate a placeholder commit OID to use in the submodule entry and","+  # let Git choose the hash algorithm based on the value of GIT_DEFAULT_HASH.","+  git commit --allow-empty -m \"exploit submodule\"","+  exploit_submodule_oid=\"$(git rev-parse HEAD)\"","+  git update-ref -d refs/heads/main","+","+  git lfs track \"*.bin\"","+","+  contents=\"test\"","+  contents_oid=\"$(calc_oid \"$contents\")\"","+  printf \"%s\" \"$contents\" >test.bin","+","+  # We add a malicious custom transfer adapter which should not be executed","+  # when the repository is cloned.","+  cp \"$BINPATH/lfstest-exploitcheck$X\" \"adapter$X\"","+","+  exploit_submodule_url=\"$(printf \\","+    '%s/%s-submodule\\nlfs.customtransfer.lfs-standalone-file.path=./adapter%s' \\","+    \"$GITSERVER\" \"$reponame\" \"$X\" \\","+  )\"","+","+  git config --file .gitmodules submodule.exploit.path exploit-submodule","+  git config --file .gitmodules submodule.exploit.url \"$exploit_submodule_url\"","+","+  git add .gitattributes .gitmodules \"adapter$X\" test.bin","+  git update-index --add \\","+    --cacheinfo \"160000,$exploit_submodule_oid,exploit-submodule\"","+  git commit -m \"initial commit\"","+","+  cd ..","+","+  git clone \"$reponame\" \"${reponame}-assert\"","+  cd \"${reponame}-assert\"","+","+  # Git copies the submodule's URL into \".git/config\", but does not contact","+  # the URL.  The URL attempts to inject an additional configuration entry","+  # that would override the default standalone custom transfer adapter used","+  # when fetching from a local repository.  We expect that when we re-fetch","+  # an object, the default adapter is executed and not the malicious one.","+  git submodule init","+","+  rm -rf .git/lfs/objects","+","+  GIT_TRACE=1 git lfs pull 2>&1 | tee pull.log","+  rc=\"${PIPESTATUS[0]}\"","+","+  [ ! -f exploit ]","+","+  [ 0 -eq \"$rc\" ]","+","+  [ 0 -eq \"$(grep -c \"exec: .*adapter$X\" pull.log)\" ]","+","+  assert_local_object \"$contents_oid\" \"${#contents}\"","+)","+end_test","+","+begin_test \"submodule URL with injected pointer extension\"","+(","+  set -e","+","+  reponame=\"submodule-pointer-extension-injection\"","+  git init \"$reponame\"","+  cd \"$reponame\"","+","+  git lfs track \"*.bin\"","+","+  # We generate a placeholder commit OID to use in the submodule entry and","+  # let Git choose the hash algorithm based on the value of GIT_DEFAULT_HASH.","+  git commit --allow-empty -m \"exploit submodule\"","+  exploit_submodule_oid=\"$(git rev-parse HEAD)\"","+  git update-ref -d refs/heads/main","+","+  # We add a malicious pointer extension program which should not be executed","+  # when the repository is cloned.","+  cp \"$BINPATH/lfstest-exploitcheck$X\" \"ext-clean$X\"","+","+  exploit_submodule_url=\"$(printf \\","+    '%s/%s-submodule\\nlfs.extension.exploit.clean=./ext-clean%s %%f\\nlfs.extension.exploit.priority=1' \\","+    \"$GITSERVER\" \"$reponame\" \"$X\" \\","+  )\"","+","+  git config --file .gitmodules submodule.exploit.path exploit-submodule","+  git config --file .gitmodules submodule.exploit.url \"$exploit_submodule_url\"","+","+  git add .gitattributes .gitmodules \"ext-clean$X\"","+  git update-index --add \\","+    --cacheinfo \"160000,$exploit_submodule_oid,exploit-submodule\"","+","+  # Git copies the submodule's URL into \".git/config\", but does not contact","+  # the URL.  The URL attempts to inject an additional configuration entry","+  # for a Git LFS pointer extension program that would be run by our \"clean\"","+  # filter when files are added to the index.  We expect that the malicious","+  # pointer extension program is not executed when we add a file to the index.","+  git submodule init","+","+  contents=\"test\"","+  contents_oid=\"$(calc_oid \"$contents\")\"","+  printf \"%s\" \"$contents\" >test.bin","+","+  GIT_TRACE=1 git add test.bin >add.log 2>&1","+","+  [ ! -f exploit ]","+","+  [ 0 -eq \"$(grep -c \"exec: .*ext-clean$X\" add.log)\" ]","+","+  [ 0 -eq \"$(git cat-file -p :test.bin | grep -c -F \"ext-0-exploit\")\" ]","+","+  assert_local_object \"$contents_oid\" \"${#contents}\"","+)","+end_test",""],"additions":119,"deletions":0,"truncated":false}],"additions":222,"deletions":32,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-20T17:57:05.398995+00:00"}