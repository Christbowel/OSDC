  );","-    }","-  }","-};"],"additions":0,"deletions":323,"truncated":false},{"path":"ghost/core/server/services/stripe/services/webhook/subscription-checkout.ts","lines":["@@ -0,0 +1,407 @@","+import { CHECKOUT_PORT } from '@tryghost/checkout';","+import errors from '@tryghost/errors';","+import logging from '@tryghost/logging';","+import {","+  canWelcomeEmailReplaceSignupPaidEmail,","+  SIGNUP_CONTEXTS,","+} from '../../../../lib/member-signup-contexts';","+import type { MemberBindings, MetafieldPlan } from '../../../members-metafields';","+import { COLLECTION_FLAG } from '../../../stripe-checkout-config/models';","+import type { StripeCustomer } from '../../stripe-api-responses';","+import type {","+  CheckoutCompletionAttempt,","+  CheckoutWallet,","+  CollectedPhoneOutcome,","+  StripeTracking,","+  WebhookOutcome,","+} from '../../tracking';","+import { collectedOf } from '../../webhook/completed-session';","+import { FAILURE_CODES } from '../../webhook/failures';","+import type { SubscriptionCheckout } from '../../webhook/webhook-event';","+import {","+  linkOrConflict,","+  type MemberAttribution,","+  type SubscriptionLinks,","+} from './link-subscription';","+","+/** A Stripe customer that Stripe still has: a deleted customer has only its id. */","+type Customer = Exclude<StripeCustomer, { deleted: true }>;","+","+/** The attributes of a member that a paid signup or upgrade reads. */","+interface MemberAttributes {","+  name: string | null;","+  created_at: Date;","+  status: string;","+}","+","+interface Member {","+  id: string;","+  get<Attribute extends keyof MemberAttributes>(attribute: Attribute): MemberAttributes[Attribute];","+}","+","+/** The parts of the member repository a paid signup or upgrade uses. */","+interface MemberRepository extends SubscriptionLinks {","+  get(filter: { email: string } | { id: string }): Promise<Member | null>;","+  /**","+   * Creates the member with their Stripe customer, and links each of the customer's","+   * su