ifier or local model directory used for backend loading and","+    /// public model ID.","+    #[arg(value_name = \"MODEL\")]","+    #[serde(rename = \"model_tag\")]","+    pub id: String,","+","+    /// Model revision on the Hugging Face Hub (branch, tag, or commit SHA).","+    #[arg(long)]","+    #[serde(default)]","+    pub revision: Option<String>,","+","+    /// Name or path of the Hugging Face tokenizer to use. If unspecified, model","+    /// name or path will be used.","+    #[arg(long)]","+    #[serde(default)]","+    pub tokenizer: Option<String>,","+","+    /// The specific revision to use for the tokenizer on the Hugging Face Hub.","+    /// It can be a branch name, a tag name, or a commit id. If unspecified,","+    /// `--revision` will be used.","+    #[arg(long)]","+    #[serde(default)]","+    pub tokenizer_revision: Option<String>,","+","+    /// Name or path of the Hugging Face config to use. If unspecified, model","+    /// name or path will be used.","+    #[arg(long)]","+    #[serde(default)]","+    pub hf_config_path: Option<String>,","+}","+","+impl ModelArgs {","+    /// Where each group of model files is read from. Like Python, the tokenizer","+    /// defaults to the model and `--revision`, and the config repo is read at","+    /// `--revision`.","+    pub fn file_sources(&self) -> ModelFileSources {","+        let tokenizer =","+            (self.tokenizer.is_some() || self.tokenizer_revision.is_some()).then(|| ModelSource {","+                id: self.tokenizer.clone().unwrap_or_else(|| self.id.clone()),","+                revision: self.tokenizer_revision.clone().or_else(|| self.revision.clone()),","+            });","+        let hf_config = self.hf_config_path.clone().map(|id| ModelSource {","+            id,","+            revision: self.revision.clone(),","+        });","+","+        ModelFileSources {","+            model: ModelSource {","+                id: self.id.clone(),","+                revision: self.revision.clone(),","+            },","+            tokenizer,","+            hf_config,","+        }","+    }","+","+    /// Forward the revision and source options to the managed Python engine,","+    /// which loads the same model, tokenizer, and config.","+    pub fn python_args(&self) -> Vec<String> {","+        [","+            (\"--revision\", &self.revision),","+            (\"--tokenizer\", &self.tokenizer),","+            (\"--tokenizer-revision\", &self.tokenizer_revision),","+            (\"--hf-config-path\", &self.hf_config_path),","+        ]","+        .into_iter()","+        .filter_map(|(flag, value)| Some([flag.to_string(), value.clone()?]))","+        .flatten()","+        .collect()","+    }","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"rust/src/cmd/src/cli/tests.rs","lines":["@@ -7,6 +7,7 @@ use vllm_server::{","     Config, GenerationConfigMode, HttpListenerMode, LoraModulePath, ParserSelection,","     RendererSelection,"," };","+use vllm_text::backend::hf::ModelSource;"," "," use super::{BenchCommand, Cli, Command};"," ","@@ -38,6 +39,8 @@ fn render_args_build_config_without_tls() {","         \"Qwen/Qwen2.5-0.5B-Instruct\",","         \"--revision\",","         \"release\",","+        \"--tokenizer\",","+        \"Qwen/Qwen2.5-0.5B\",","         \"--port\",","         \"8080\",","         \"--max-model-len\",","@@ -58,6 +61,14 @@ fn render_args_build_config_without_tls() {"," ","     assert_eq!(config.model, \"Qwen/Qwen2.5-0.5B-Instruct\");","     assert_eq!(config.revision.as_deref(), Some(\"release\"));","+    assert_eq!(","+        config.tokenizer,","+        Some(ModelSource {","+            id: \"Qwen/Qwen2.5-0.5B\".to_string(),","+            revision: Some(\"release\".to_string()),","+        })","+    );","+    assert_eq!(config.hf_config, None);","     assert_eq!(config.host, \"127.0.0.1\");","     assert_eq!(config.port, 8080);","     assert_eq!(config.max_model_len, Some(32768));","@@ -176,8 +187,13 @@ fn serve_args_forward_python_flag