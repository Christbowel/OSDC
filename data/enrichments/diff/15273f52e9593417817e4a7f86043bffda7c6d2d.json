 = publication_name(&incoming)?;","+    let request = publication_request(state, identity, &incoming, key, name, None);","+    let packages = take_packages(&mut incoming)?;","     let validated = validate_batch_entries(state, identity, packages).await?;"," ","     // Hold every affected package's lock across the whole stage-and-commit,","@@ -163,7 +170,39 @@ async fn publish_batch(","         .map(|entry| entry.key().as_str())","         .collect();","     let _guards = state.inner.locks.packages.lock_many(&names).await;","+    // Every entry is authorized above, so a retry gets the outcome of the","+    // request it repeats only while its caller may still make it. It is looked","+    // up under the locks, so a retry that waited for the original sees its","+    // commit.","+    if let Some(replayed) = replayed_batch(state, request.as_ref(), &validated).await? {","+        return Ok(replayed);","+    }"," ","+    let staged = stage_entries(state, validated).await?;","+    let receipt = commit_publication(state, staged, request).await?;","+    Ok(publish_committed_response(&receipt))","+}","+","+/// The recorded outcome of the batch `request` repeats, in the one catalog","+/// its entries target. A request exists only with `SQLite` metadata, whose","+/// publish targets one catalog.","+async fn replayed_batch(","+    state: &AppState,","+    request: Option<&PublicationRequest>,","+    validated: &[ValidatedEntry],","+) -> Result<Option<Response>, RegistryError> {","+    if request.is_none() {","+        return Ok(None);","+    }","+    let catalog = single_catalog(validated.iter().map(ValidatedEntry::org))?;","+    replayed_outcome(state, &catalog, request).await","+}","+","+/// Stage every entry, removing what was staged when one fails.","+async fn stage_entries(","+    state: &AppState,","+    validated: Vec<ValidatedEntry>,","+) -> Result<Vec<StagedPublish>, RegistryError> {","     let now = now_iso();","     let mut staged: Vec<StagedPublish> = Vec::with_capacity(validated.len());","     for entry in validated {","@@ -177,7 +216,25 @@ async fn publish_batch(","             }","         }","     }","-    report_unrecorded(commit_publishes(state, staged).await?)","+    Ok(staged)","+}","+","+/// The `packages` array of a batch body, which must not be empty.","+fn take_packages(incoming: &mut Value) -> Result<Vec<Value>, RegistryError> {","+    let Some(Value::Array(packages)) = incoming","+        .as_object_mut()","+        .and_then(|body| body.remove(\"packages\"))","+    else {","+        return Err(RegistryError::BadRequest {","+            reason: \"body must be an object with a `packages` array\".to_string(),","+        });","+    };","+    if packages.is_empty() {","+        return Err(RegistryError::BadRequest {","+            reason: \"`packages` must not be empty\".to_string(),","+        });","+    }","+    Ok(packages)"," }"," "," /// Validate every entry of a batch, refusing a package named twice."],"additions":88,"deletions":31,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/cargo/publication.rs","lines":["@@ -124,6 +124,11 @@ impl CratePublication {","         &self.key","     }"," ","+    /// The organization whose catalog the crate is published into.","+    pub(in super::super) fn org(&self) -> &str {","+        &self.org","+    }","+","     /// The one-version document this publish contributes, which merges into","     /// whatever the registry already holds for the crate.","     pub(super) fn document(&self) -> CrateDocument {"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/oci/publication.rs","lines":["@@ -81,6 +81,11 @@ impl OciPublication {","         &self.key","     }"," ","+    /// The organization whose catalog the image is published into.","+    pub(in crate::server) fn org(&self) -> &str {","+        &self.org","+    }","+","     pub(super) fn subject(&self) -> Option<Digest> {","         self.manifest.referrer_metadata().subject","     }"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publications.rs","lines":["@@ -0,0 +1,163 @@","+//! `GET /-/publications/{org}/{id-or-name}` and","+//! `GET /-/publications/{org}?member=<ecosystem>:<name>@<version>`: the","+//! publications of an organization's hosted catalog.","+//!","+//! `-` names the catalog of the registries without an `org`. A caller sees","+//! only the members it may read, and a publication with none answers 404, so","+//! a publication never discloses a package. Publications are recorded only","+//! when the metadata lives in `SQLite`.","+","+use super::{","+    AppState, AuthedCaller, HostedGate, Identity, hosted_gate, not_found, private_no_cache,","+};","+use axum::{","+    Json,","+    extract::{Path, Query, State},","+    response::{IntoResponse, Response},","+};","+use pnpr_error::RegistryError;","+use pnpr_package_name::CanonicalPackageName;","+use pnpr_registry::{Ecosystem, Resolved};","+use pnpr_storage::metadata::{ArtifactMember, Publication};","+use serde::Deserialize;","+use serde_json::{Value, json};","+","+/// The path segment naming the catalog of registries without an `org`.","+const DEFAULT_CATALOG: &str = \"-\";","+","+pub(super) async fn serve_publication(","+    State(state): State<AppState>,","+    AuthedCaller(identity): AuthedCaller,","+    Path((org, id_or_name)): Path<(String, String)>,","+) -> Response {","+    let catalog = catalog_of(&org);","+    let Some(database) = state.inner.storage.sqlite_metadata() else { return not_found() };","+    let found = database.publication(catalog, &id_or_name).await;","+    private_no_cache(respond(&state, &identity, found))","+}","+","+#[derive(Deserialize)]","+pub(super) struct MemberQuery {","+    member: String,","+}","+","+pub(super) async fn serve_member_publication(","+    State(state): State<AppState>,","+    AuthedCaller(identity): AuthedCaller,","+    Path(org): Path<String>,","+    Query(query): Query<MemberQuery>,","+) -> Response {","+    let catalog = catalog_of(&org);","+    let Some(database) = state.inner.storage.sqlite_metadata() else { return not_found() };","+    let Some((name, version)) = parse_member(&query.member) else {","+        return RegistryError::BadRequest {","+            reason: \"`member` must be <ecosystem>:<name>@<version>\".to_string(),","+        }","+        .into_response();","+    };","+    // Only npm members carry the version they were published as.","+    if name.ecosystem() != Ecosystem::Npm {","+        return RegistryError::BadRequest {","+            reason: \"`member` looks up npm package versions only\".to_string(),","+        }","+        .into_response();","+    }","+    // A package the caller may not read answers like one that does not","+    // exist, whatever else its publication holds.","+    let queried = ArtifactMember {","+        ecosystem: name.ecosystem(),","+        name: name.as_str().to_string(),","+        version: version.to_string(),","+        artifact: String::new(),","+    };","+    if !may_read(&state, &identity, catalog, &queried) {","+        return private_no_cache(not_found());","+    }","+    let found = database.initial_publication(&name, catalog, version).await;","+    private_no_cache(respond(&state, &identity, found))","+}","+","+fn catalog_of(org: &str) -> &str {","+    if org == DEFAULT_CATALOG { \"\" } else { org }","+}","+","+/// `npm:@scope/name@1.0.0` as the package and its version.","+fn parse_member(member: &str) -> Option<(CanonicalPackageName, &str)> {","+    let (ecosystem, package) = member.split_once(':')?;","+    let ecosystem = Ecosystem::all().find(|known| known.as_str() == ecosystem)?;","+    let at = package.get(1..)?.rfind('@')? + 1;","+    let (name, version) = (&package[..at], &package[at + 1..]);","+    let name = CanonicalPackageName::parse(name, ecosystem).ok()?;","+    (!version.is_empty()).then_some((name, version))","+}","+","+fn respond(","+    state: &AppState,","+    identity: &Identity,","+    found: Result<Option<Publication>, RegistryError>,","+) -> Response {","+    match found {","+        Ok(Some(publication)) => match visible(state, identity, publication) {","+            Some(publication) => Json(publication_json(&publication)).into_response(),","+            None => not_found(),","+        },","+        Ok(None) => not_found(),","+        Err(err) => err.into_response(),","+    }","+}","+","+/// The publication with only the members `identity` may read, or `None` when","+/// it may read none of them.","+fn visible(","+    state: &AppState,","+    identity: &Identity,","+    mut publication: Publication,","+) -> Option<Publication> {","+    let catalog = publication.catalog.clone();","+    publication.members.retain(|member| may_read(state, identity, &catalog, member));","+    (!publication.members.is_empty()).then_some(publication)","+}","+","+/// Whether a hosted registry of `catalog` and the member's ecosystem claims","+/// the member's package and lets `identity` read it.","+fn may_read(state: &AppState, identity: &Identity, catalog: &str, member: &ArtifactMember) -> bool {","+    let routing = &state.inner.config.routing;","+    routing.hosted","+        .iter()","+        .any(|(source, hosted)| {","+            hosted.org == catalog","+                && routing.registries.ecosystem(source) == Some(member.ecosystem)","+                // The registry still claims the name: a package its","+                // namespace no longer covers is not served there.","+                && matches!(","+                    routing.registries.resolve(source, member.ecosystem, &member.name),","+                    Resolved::Concrete { registry, .. } if registry == source,","+                )","+                && matches!(","+                    hosted_gate(state, identity, source, &member.name),","+                    HostedGate::Allowed(org) if org == catalog,","+                )","+        })","+}","+","+fn publication_json(publication: &Publication) -> Value {","+    let members: Vec<Value> = publication.members","+        .iter()","+        .map(|member| {","+            json!({","+                \"ecosystem\": member.ecosystem.as_str(),","+                \"name\": member.name,","+                \"version\": member.version,","+                \"artifact\": member.artifact,","+            })","+        })","+        .collect();","+    json!({","+        \"id\": publication.id,","+        \"org\": publication.catalog,","+        \"name\": publication.name,","+        \"publisher\": publication.publisher,","+        \"committedAt\": publication.committed_at,","+        \"members\": members,","+    })","+}"],"additions":163,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing.rs","lines":["@@ -1,20 +1,21 @@","+pub(super) use atomic::{","+    commit_publication, publication_name, publication_request, publish_committed_response,","+    replayed_outcome, single_catalog,","+};"," pub(super) use attachments::{","     StagedPublish, ValidatedPublish, stage_publish, validate_publish_doc,"," };"," pub(super) use tombstones::check_publish_tombstone;"," ","+mod atomic;"," mod attachments;"," mod manifest;"," mod tombstones;"," "," use std::collections::{BTreeSet, HashSet};"," ","-use axum::{","-    body::Body,","-    http::{StatusCode, header},","-    response::{IntoResponse, Response},","-};","-use serde_json::{Value, json};","+use axum::response::{IntoResponse, Response};","+use serde_json::Value;"," use ssri::Integrity;"," "," use pnpr_error::RegistryError;","@@ -194,6 +195,8 @@ pub(super) async fn publish_package(","         .into_response();","     }"," ","+    let request = publication_request(state, identity, &incoming, None, None, Some(&name));","+","     // Routing, masking, and the publish rule all run inside","     // `validate_publish_doc`: the write resolves to a hosted registry (or","     // fails closed), and that registry's `packages:` rules authorize it.","@@ -202,19 +205,26 @@ pub(super) async fn publish_package(","             Ok(validated) => validated,","             Err(err) => return err.into_response(),","         };","-","     // Serialize the read-merge-write against other writers of this same","     // package on this instance, so a concurrent publish can't read the","     // same `existing`, merge a different version, and overwrite ours.","     // Held until this function returns, past the packument write below.","     let _packument_guard = state.inner.locks.packages.lock(validated.name.as_str()).await;","+    // A retry is authorized like any publish, so only a caller still allowed","+    // to make it gets the outcome of the request it repeats. It is looked up","+    // under the lock, so a retry that waited for the original sees its commit.","+    match replayed_outcome(state, &target.org, request.as_ref()).await {","+        Ok(Some(replayed)) => return replayed,","+        Ok(None) => {}","+        Err(err) => return err.into_response(),","+    }"," ","     let staged = match stage_publish(state, validated, &now_iso(), Some(&target.org)).await {","         Ok(staged) => staged,","         Err(err) => return err.into_response(),","     };","-    match commit_publishes(state, vec![staged]).await.and_then(report_unrecorded) {","-        Ok(()) => publish_created_response(),","+    match commit_publication(state, vec![staged], request).await {","+        Ok(receipt) => publish_committed_response(&receipt),","         Err(err) => err.into_response(),","     }"," }","@@ -231,6 +241,18 @@ pub(super) async fn publish_package("," pub(super) async fn commit_publishes(","     state: &AppState,","     staged: Vec<StagedPublish>,","+) -> Result<CommitOutcome, RegistryError> {","+    if state.inner.storage.sqlite_metadata().is_some() {","+        commit_publication(state, staged, None).await?;","+        return Ok(CommitOutcome::default());","+    }","+    commit_through_journal(state, staged).await","+}","+","+/// [`commit_publishes`] through the publish journal.","+async fn commit_through_journal(","+    state: &AppState,","+    staged: Vec<StagedPublish>,"," ) -> Result<CommitOutcome, RegistryError> {","     let entries: Vec<JournaledPublish<'_>> = staged","         .iter()","@@ -271,16 +293,6 @@ pub(super) fn report_unrecorded(outcome: CommitOutcome) -> Result<(), RegistryEr","     Err(RegistryError::PublishNotRecorded { packages })"," }"," ","-pub(super) fn publish_created_response() -> Response {","-    let body = json!({ \"ok\": true, \"success\": true });","-    let bytes = serde_json::to_vec(&body).expect(\"static-shape JSON serializes\");","-    Response::builder()","-        .status(StatusCode::CREATED)","-        .header(header::CONTENT_TYPE, \"application/json\")","-        .body(Body::from(bytes))","-        .expect(\"static-shape response always builds\")","-}","-"," /// Remove every tmp tarball file that a partially-completed publish"," /// already wrote. Errors are swallowed: the caller is already"," /// returning an error response, and a leftover `*.tmp.*` file is"],"additions":31,"deletions":19,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/atomic.rs","lines":["@@ -0,0 +1,412 @@","+//! Committing a publish as one metadata transaction, when the metadata lives","+//! in `SQLite`: every archive is promoted first, then every document of the","+//! request commits under one generation of its organization's catalog, or","+//! none does. Readers see the whole request or nothing of it.","+//!","+//! The request's outcome commits with it. A retry of the same request by the","+//! same principal gets that outcome back instead of a conflict, whether or not","+//! the client sent an idempotency key: without one, the digest of the whole","+//! request is the key. A retry is authorized against current permissions","+//! like any publish before its outcome is looked up.","+","+use super::{RegistryError, StagedPublish, Value, report_unrecorded};","+use crate::server::{AppState, Identity};","+use axum::{","+    body::Body,","+    http::{StatusCode, header},","+    response::Response,","+};","+use futures_util::StreamExt as _;","+use pnpr_package_name::CanonicalPackageName;","+use pnpr_storage::{","+    BlobFinalize, BlobSlot, Storage,","+    metadata::{ArtifactMember, BatchDocument, Generation, PublicationRequest},","+};","+use serde_json::json;","+use ssri::{Algorithm, IntegrityOpts};","+use std::{","+    io::{self, Write as _},","+    path::Path,","+};","+use tokio::io::AsyncReadExt as _;","+","+/// What a publish committed, as its response reports it.","+#[derive(Debug, Default)]","+pub(in super::super) struct PublishReceipt {","+    /// The generation holding the publish, when the metadata tracks them.","+    pub(in super::super) generation: Option<Generation>,","+    /// The publication the commit recorded.","+    pub(in super::super) publication: Option<u64>,","+}","+","+/// The idempotency claim of a publish request: who sent it, the request it","+/// is a retry of when it is one, and the publication's `name`. `None` for a caller with no stable","+/// principal, or a store that keeps no outcomes.","+pub(in super::super) fn publication_request(","+    state: &AppState,","+    identity: &Identity,","+    body: &Value,","+    key: Option<&str>,","+    name: Option<&str>,","+    target: Option<&CanonicalPackageName>,","+) -> Option<PublicationRequest> {","+    state.inner.storage.sqlite_metadata()?;","+    let principal = identity.username()?.to_string();","+    let request_digest = request_digest(body, target.map(CanonicalPackageName::as_str));","+    let idempotency_key = key.map_or_else(|| format!(\"request:{request_digest}\"), str::to_string);","+    let name = name.map(str::to_string);","+    Some(PublicationRequest { principal, idempotency_key, request_digest, name })","+}","+","+/// The longest publication name, in bytes: the longest npm package name.","+const MAX_PUBLICATION_NAME: usize = 214;","+","+/// The publication name a batch body gives in its top-level `name`. A name","+/// is never a decimal number, so `/-/publications/<org>/<id-or-name>` reads","+/// a segment as one or the other.","+pub(in super::super) fn publication_name(body: &Value) -> Result<Option<&str>, RegistryError> {","+    // An empty name names nothing.","+    let name = body","+        .get(\"name\")","+        .and_then(Value::as_str)","+        .filter(|name| !name.is_empty());","+    if let Some(name) = name","+        && name.len() > MAX_PUBLICATION_NAME","+    {","+        return Err(RegistryError::BadRequest {","+            reason: format!(\"a publication name is at most {MAX_PUBLICATION_NAME} bytes long\"),","+        });","+    }","+    if let Some(name) = name","+        && name.bytes().all(|byte| byte.is_ascii_digit())","+    {","+        return Err(RegistryError::BadRequest {","+            reason: format!(","+                \"publication name {name:?} must not be a decimal number, which names a \\","+                 publication by id\",","+            ),","+        });","+    }","+    Ok(name)","+}","+","+/// The response a retry of an already committed request gets: the outcome","+/// that request recorded in `catalog`, the one the retry targets. The caller","+/// authorizes the retry as a publish first.","+pub(in super::super) async fn replayed_outcome(","+    state: &AppState,","+    catalog: &str,","+    request: Option<&PublicationRequest>,","+) -> Result<Option<Response>, RegistryError> {","+    let (Some(request), Some(database)) = (request, state.inner.storage.sqlite_metadata()) else {","+        return Ok(None);","+    };","+    let Some(outcome) = database.recorded_outcome(catalog, request).await? else {","+        return Ok(None);","+    };","+    let receipt = PublishReceipt {","+        generation: Some(Generation { catalog: outcome.catalog, value: outcome.generation }),","+        publication: outcome.publication,","+    };","+    Ok(Some(publish_committed_response(&receipt)))","+}","+","+/// Commit `staged` in one transaction when the metadata lives in `SQLite`,","+/// through the publish journal otherwise.","+pub(in super::super) async fn commit_publication(","+    state: &AppState,","+    mut staged: Vec<StagedPublish>,","+    request: Option<PublicationRequest>,","+) -> Result<PublishReceipt, RegistryError> {","+    let Some(database) = state.inner.storage.sqlite_metadata().cloned() else {","+        report_unrecorded(super::commit_through_journal(state, staged).await?)?;","+        return Ok(PublishReceipt::default());","+    };","+    let orgs = staged","+        .iter()","+        .map(|stage| stage.org.as_deref().unwrap_or_default());","+    let catalog = match single_catalog(orgs) {","+        Ok(catalog) => catalog,","+        Err(err) => {","+            for stage in staged {","+                super::cleanup_tmp_slots(stage.slots).await;","+            }","+            return Err(err);","+        }","+    };","+    let promoted = promote_archives(state, &mut staged).await?;","+    let artifacts = promoted.artifacts.clone();","+    let documents = staged","+        .into_iter()","+        .map(|stage| BatchDocument {","+            ecosystem: stage.ecosystem,","+            name: stage.name.as_str().to_string(),","+            bytes: stage.document,","+            expected: stage.base_version,","+            principal: stage.publisher,","+        })","+        .collect();","+    let commit = match database.commit_publication(&catalog, documents, artifacts, request).await {","+        Ok(commit) => commit,","+        Err(err) => {","+            promoted.remove_written(state).await;","+            return Err(err);","+        }","+    };","+    Ok(PublishReceipt { generation: Some(commit.generation), publication: commit.publication })","+}","+","+/// The one organization every package of a publish belongs to. A","+/// transaction never spans organizations.","+pub(in super::super) fn single_catalog<'org>(","+    mut orgs: impl Iterator<Item = 