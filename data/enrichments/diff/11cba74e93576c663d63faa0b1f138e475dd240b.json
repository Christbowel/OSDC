-1 {","+\t\t\treturn err","+\t\t}","+\t\tsc.log.Debug(\"SMTP address unreachable, trying the next one\", \"address\", dialer.Host, \"error\", err)","+\t}","+\treturn err","+}","+","+// redactConnectError replaces a failed TCP connect with a generic error when","+// the host lists apply, because the raw error exposes resolved IPs and DNS","+// server addresses to the caller.","+func (sc *SmtpClient) redactConnectError(smtp setting.SmtpSettings, err error) error {","+\tif err == nil || !smtp.HostListsSet() || !isConnectError(err) {","+\t\treturn err","+\t}","+\t// createDialers already validated the host, so the split cannot fail here.","+\thostname, _, _ := net.SplitHostPort(smtp.Host)","+\tsc.log.Warn(\"Could not connect to SMTP host\", \"host\", hostname, \"error\", err)","+\treturn fmt.Errorf(\"could not connect to smtp host %q\", hostname)","+}","+","+// isConnectError reports whether err is a failed TCP connect. gomail returns","+// untyped errors for everything else, so the net.OpError is the only signal","+// that no SMTP session started.","+func isConnectError(err error) bool {","+\tvar opErr *net.OpError","+\treturn errors.As(err, &opErr) && opErr.Op == \"dial\"","+}","+"," // buildEmail converts the Message DTO to a gomail message."," func (sc *SmtpClient) buildEmail(ctx context.Context, smtp setting.SmtpSettings, msg *Message) *gomail.Message {"," \tm := gomail.NewMessage()","@@ -191,7 +242,7 @@ func (sc *SmtpClient) setFiles("," \t}"," }"," ","-func (sc *SmtpClient) createDialer(smtp setting.SmtpSettings) (*gomail.Dialer, error) {","+func (sc *SmtpClient) createDialers(ctx context.Context, smtp setting.SmtpSettings) ([]*gomail.Dialer, error) {"," \thost, port, err := net.SplitHostPort(smtp.Host)"," \tif err != nil {"," \t\treturn nil, err","@@ -201,6 +252,11 @@ func (sc *SmtpClient) createDialer(smtp setting.SmtpSettings) (*gomail.Dialer, e"," \t\treturn nil, err"," \t}"," ","+\tdialHosts, err := sc.resolveDialHosts(ctx, host, smtp)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+"," \ttlsconfig := &tls.Config{"," \t\tInsecureSkipVerify: smtp.SkipVerify,"," \t\tServerName:         host,","@@ -214,12 +270,66 @@ func (sc *SmtpClient) createDialer(smtp setting.SmtpSettings) (*gomail.Dialer, e"," \t\ttlsconfig.Certificates = []tls.Certificate{cert}"," \t}"," ","-\td := gomail.NewDialer(host, iPort, smtp.User, smtp.Password)","-\td.TLSConfig = tlsconfig","-\td.StartTLSPolicy = getStartTLSPolicy(smtp.StartTLSPolicy)","-\td.LocalName = smtp.EhloIdentity","+\t// gomail stores Auth on the dialer bound to its host on first Dial, so each","+\t// host needs its own dialer.","+\tdialers := make([]*gomail.Dialer, 0, len(dialHosts))","+\tfor _, dialHost := range dialHosts {","+\t\t// gomail joins host and port with Sprintf, not net.JoinHostPort, so IPv6 needs brackets.","+\t\tif addr, err := netip.ParseAddr(dialHost); err == nil && addr.Is6() {","+\t\t\tdialHost = \"[\" + dialHost + \"]\"","+\t\t}","+\t\tdialer := gomail.NewDialer(dialHost, iPort, smtp.User, smtp.Password)","+\t\tdialer.TLSConfig = tlsconfig","+\t\tdialer.StartTLSPolicy = getStartTLSPolicy(smtp.StartTLSPolicy)","+\t\tdialer.LocalName = smtp.EhloIdentity","+\t\tdialers = append(dialers, dialer)","+\t}","+","+\treturn dialers, nil","+}","+","+// resolveDialHosts applies the [security.smtp] host lists and returns the hosts","+// gomail dials. When the lists apply, it returns every address that passed the","+// check so the sender can fall back between them, and a later DNS answer cannot","+// redirect the connection.","+func (sc *SmtpClient) resolveDialHosts(ctx context.Context, hostname string, smtp setting.SmtpSettings) ([]string, error) {","+\tallow, deny := smtp.HostAllowList, smtp.HostDenyList","+\tif !smtp.HostListsSet() {","+\t\treturn []string{hostname}, nil","+\t}","+\tif allow.MatchesHost(hostname) {","+\t\treturn []string{hostname}, nil","+\t}","+","+\terrNotAllowed := fmt.Errorf(\"smtp host %q is not allowed\", hostname)","+\tif deny.MatchesHost(hostname) {","+\t\tsc.log.Warn(\"SMTP host rejected by host_deny_list\", \"host\", hostname)","+\t\treturn nil, errNotAllowed","+\t}","+","+\tvar addrs []netip.Addr","+\tif literal, err := netip.ParseAddr(setting.NormalizeSmtpHostname(hostname)); err == nil {","+\t\taddrs = []netip.Addr{literal}","+\t} else {","+\t\taddrs, err = sc.lookupIP(ctx, hostname)","+\t\tif err != nil {","+\t\t\tsc.log.Warn(\"Could not resolve SMTP host\", \"host\", hostname, \"error\", err)","+\t\t\treturn nil, fmt.Errorf(\"could not resolve smtp host %q\", hostname)","+\t\t}","+\t\tif len(addrs) == 0 {","+\t\t\treturn nil, fmt.Errorf(\"no addresses found for smtp host %q\", hostname)","+\t\t}","+\t}"," ","-\treturn d, nil","+\thosts := make([]string, 0, len(addrs))","+\tfor _, addr := range addrs {","+\t\tif !allow.MatchesAddr(addr) && deny.MatchesAddr(addr) {","+\t\t\tsc.log.Warn(\"SMTP host rejected by host_deny_list\", \"host\", hostname, \"address\", addr.String())","+\t\t\treturn nil, errNotAllowed","+\t\t}","+\t\thosts = append(hosts, addr.String())","+\t}","+\treturn hosts, nil"," }"," "," func getStartTLSPolicy(policy string) gomail.StartTLSPolicy {"],"additions":121,"deletions":11,"truncated":false},{"path":"pkg/services/notifications/smtp_test.go","lines":["@@ -7,8 +7,12 @@ import ("," \t\"errors\""," \t\"fmt\""," \t\"io\"","+\t\"net\"","+\t\"net/netip\"","+\t\"net/smtp\""," \t\"net/textproto\""," \t\"sort\"","+\t\"strconv\""," \t\"strings\""," \t\"testing\""," \t\"time\"","@@ -17,6 +21,7 @@ import ("," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\""," \t\"gopkg.in/ini.v1\"","+\tgomail \"gopkg.in/mail.v2\""," "," \t\"github.com/grafana/grafana/pkg/configprovider\""," \t\"github.com/grafana/grafana/pkg/infra/tracing\"","@@ -60,6 +65,62 @@ func setRawKeys(t *testing.T, cfg *setting.Cfg, section string, keys map[string]"," \t}"," }"," ","+// stubResolver replaces the DNS lookup of an SmtpClient and records the hosts it was asked for.","+type stubResolver struct {","+\taddrs map[string][]netip.Addr","+\tcalls []string","+}","+","+func (resolver *stubResolver) lookup(_ context.Context, host string) ([]netip.Addr, error) {","+\tresolver.calls = append(resolver.calls, host)","+\taddrs, ok := resolver.addrs[host]","+\tif !ok {","+\t\treturn nil, fmt.Errorf(\"no such host %q\", host)","+\t}","+\treturn addrs, nil","+}","+","+func newStubResolver(addrs map[string][]string) *stubResolver {","+\tresolver := &stubResolver{addrs: map[string][]netip.Addr{}}","+\tfor host, list := range addrs {","+\t\tfor _, addr := range list {","+\t\t\tresolver.addrs[host] = append(resolver.addrs[host], netip.MustParseAddr(addr))","+\t\t}","+\t}","+\treturn resolver","+}","+","+// newHostListClient returns a client for smtpHost with the given [security.smtp]","+// keys and a stub resolver.","+func newHostListClient(t *testing.T, smtpHost string, securityKeys map[string]string, resolver *stubResolver) *SmtpClient {","+\tt.Helper()","+\tcfg := smtpRawCfg(t, map[string]string{\"enabled\": \"true\", \"host\": smtpHost})","+\tsetRawKeys(t, cfg, \"security.smtp\", securityKeys)","+\tclient := newTestSmtpClient(t, cfg)","+\tclient.lookupIP = resolver.lookup","+\treturn client","+}","+","+func liveSmtpSettings(t *testing.T, client *SmtpClient) setting.SmtpSettings {","+\tt.Helper()","+\tsmtp, err := readLiveSmtpSettings(context.Background(), client.cfgProvider, client.instanceName)","+\trequire.NoError(t, err)","+\treturn smtp","+}","+","+func newDialersFor(t *testing.T, client *SmtpClient) ([]*gomail.Dialer, error) {","+\tt.Helper()","+\treturn client.createDialers(context.Background(), liveSmtpSettings(t, client))","+}","+","+func dialerHosts(dialers []*gomail.Dialer) []string {","+\thosts := make([]string, 0, len(dialers))","+\tfor _, dialer := range dialers {","+\t\thosts = append(hosts, dialer.Host)","+\t}","+\treturn hosts","+}","+"," func sentHeaders(t *testing.T, sentMsg smtpmock.Message) textproto.MIMEHeader {"," \tt.Helper()"," \thdr, err := textproto.NewReader(bufio.NewReader(strings.NewReader(sentMsg.MsgRequest()))).ReadMIMEHeader()","@@ -200,6 +261,390 @@ func TestSmtpDialer(t *testing.T) {"," \t})"," }"," ","+func TestSmtpHostLists(t *testing.T) {","+\tctx := context.Background()","+\tnewMessage := func() *Message {","+\t\treturn &Message{From: \"from@example.com\", To: []string{\"rcpt@example.com\"},","+\t\t\tSubject: \"subject\", ContentTypes: []string{\"text/plain\"}, Body: map[string]string{\"text/plain\": \"hello world\"}}","+\t}","+","+\trejectedCases := []struct {","+\t\tname         string","+\t\thost         string","+\t\tsecurityKeys map[string]string","+\t\tresolved     map[string][]string","+\t\twantHostname string","+\t}{","+\t\t{","+\t\t\tname:         \"denied resolved address\",","+\t\t\thost:         \"mail.example.com:25\",","+\t\t\tsecurityKeys: map[string]string{\"host_deny_list\": \"10.0.0.0/8\"},","+\t\t\tresolved:     map[string][]string{\"mail.example.com\": {\"10.1.2.3\"}},","+\t\t\twantHostname: \"mail.example.com\",","+\t\t},","+\t\t{","+\t\t\tname:         \"one denied address among several\",","+\t\t\thost:         \"mail.example.com:25\",","+\t\t\tsecurityKeys: map[string]string{\"host_deny_list\": \"10.0.0.0/8\"},","+\t\t\tresolved:     map[string][]string{\"mail.example.com\": {\"8.8.8.8\", \"10.1.2.3\"}},","+\t\t\twantHostname: \"mail.example.com\",","+\t\t},","+\t\t{","+\t\t\tname:         \"denied hostname in a different case with trailing dot\",","+\t\t\thost:         \"BAD.example.:25\",","+\t\t\tsecurityKeys: map[string]string{\"host_deny_list\": \"bad.example\"},","+\t\t\tresolved:     map[string][]string{\"bad.example\": {\"8.8.8.8\"}},","+\t\t\twantHostname: \"BAD.example.\",","+\t\t},","+\t\t{","+\t\t\tname:         \"IPv4-mapped IPv6 literal in a denied IPv4 range\",","+\t\t\thost:         \"[::ffff:10.0.0.1]:25\",","+\t\t\tsecurityKeys: map[string]string{\"host_deny_list\": \"10.0.0.0/8\"},","+\t\t\twantHostname: \"::ffff:10.0.0.1\",","+\t\t},","+\t\t{","+\t\t\tname:         \"allowed address does not cover another denied address\",","+\t\t\thost:         \"mail.example.com:25\",","+\t\t\tsecurityKeys: map[string]string{\"host_deny_list\": \"10.0.0.0/8\", \"host_allow_list\": \"10.1.2.3\"},","+\t\t\tresolved:     map[string][]string{\"mail.example.com\": {\"10.1.2.3\", \"10.9.9.9\"}},","+\t\t\twantHostname: \"mail.example.com\",","+\t\t},","+\t}","+\tfor _, tc := range rejectedCases {","+\t\tt.Run(\"rejects \"+tc.name, func(t *testing.T) {","+\t\t\tclient := newHostListClient(t, tc.host, tc.securityKeys, newStubResolver(tc.resolved))","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\tassert.Equal(t, 0, count)","+\t\t\trequire.EqualError(t, err, fmt.Sprintf(\"smtp host %q is not allowed\", tc.wantHostname))","+\t\t\tfor _, addrs := range tc.resolved {","+\t\t\t\tfor _, addr := range addrs {","+\t\t\t\t\tassert.NotContains(t, err.Error(), addr)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+","+\tt.Run(\"dials the checked address and keeps the hostname for TLS\", func(t *testing.T) {","+\t\tresolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"8.8.8.8\", \"9.9.9.9\"}})","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, resolver)","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\trequire.NotEmpty(t, dialers)","+\t\tassert.Equal(t, \"8.8.8.8\", dialers[0].Host)","+\t\tassert.Equal(t, \"mail.example.com\", dialers[0].TLSConfig.ServerName)","+\t\tassert.Equal(t, 25, dialers[0].Port)","+\t})","+","+\tt.Run(\"resolveDialHosts returns every checked address in resolver order\", func(t *testing.T) {","+\t\tresolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"8.8.8.8\", \"9.9.9.9\"}})","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, resolver)","+","+\t\thosts, err := client.resolveDialHosts(ctx, \"mail.example.com\", liveSmtpSettings(t, client))","+","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"8.8.8.8\", \"9.9.9.9\"}, hosts)","+\t})","+","+\tt.Run(\"createDialers returns one dialer per address with its own host\", func(t *testing.T) {","+\t\tresolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"8.8.8.8\", \"fd00::1\"}})","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, resolver)","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"8.8.8.8\", \"[fd00::1]\"}, dialerHosts(dialers))","+\t\tassert.NotSame(t, dialers[0], dialers[1])","+\t\tfor _, dialer := range dialers {","+\t\t\tassert.Equal(t, \"mail.example.com\", dialer.TLSConfig.ServerName)","+\t\t}","+\t})","+","+\tt.Run(\"allowed hostname skips the lookup\", func(t *testing.T) {","+\t\tresolver := newStubResolver(map[string][]string{\"smtpproxy\": {\"10.1.2.3\"}})","+\t\tclient := newHostListClient(t, \"smtpproxy:25\", map[string]string{","+\t\t\t\"host_deny_list\":  \"10.0.0.0/8\",","+\t\t\t\"host_allow_list\": \"smtpproxy\",","+\t\t}, resolver)","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"smtpproxy\"}, dialerHosts(dialers))","+\t\tassert.Empty(t, resolver.calls)","+\t})","+","+\tt.Run(\"allowed address is exempt from the deny list\", func(t *testing.T) {","+\t\tresolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"10.1.2.3\"}})","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{","+\t\t\t\"host_deny_list\":  \"10.0.0.0/8\",","+\t\t\t\"host_allow_list\": \"10.1.2.3\",","+\t\t}, resolver)","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"10.1.2.3\"}, dialerHosts(dialers))","+\t})","+","+\tt.Run(\"lookup failure rejects the send\", func(t *testing.T) {","+\t\tclient := newHostListClient(t, \"unknown.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, newStubResolver(nil))","+","+\t\t_, err := newDialersFor(t, client)","+","+\t\trequire.EqualError(t, err, `could not resolve smtp host \"unknown.example.com\"`)","+\t})","+","+\tt.Run(\"lookup failure does not expose the DNS server address\", func(t *testing.T) {","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, newStubResolver(nil))","+\t\tclient.lookupIP = func(context.Context, string) ([]netip.Addr, error) {","+\t\t\treturn nil, errors.New(\"lookup mail.example.com on 10.0.0.2:53: no such host\")","+\t\t}","+","+\t\t_, err := newDialersFor(t, client)","+","+\t\trequire.EqualError(t, err, `could not resolve smtp host \"mail.example.com\"`)","+\t\tassert.NotContains(t, err.Error(), \"10.0.0.2\")","+\t})","+","+\tt.Run(\"brackets an IPv6 address resolved for the dialer\", func(t *testing.T) {","+\t\tresolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"fd00::1\"}})","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, resolver)","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\trequire.Len(t, dialers, 1)","+\t\tassert.Equal(t, \"[fd00::1]\", dialers[0].Host)","+\t\tassert.Equal(t, \"mail.example.com\", dialers[0].TLSConfig.ServerName)","+\t})","+","+\tt.Run(\"brackets an IPv6 literal host when the lists are empty\", func(t *testing.T) {","+\t\tclient := newHostListClient(t, \"[::1]:25\", nil, newStubResolver(nil))","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\trequire.Len(t, dialers, 1)","+\t\tassert.Equal(t, \"[::1]\", dialers[0].Host)","+\t\tassert.Equal(t, \"::1\", dialers[0].TLSConfig.ServerName)","+\t})","+","+\tt.Run(\"brackets an allowed IPv6 literal host\", func(t *testing.T) {","+\t\tclient := newHostListClient(t, \"[fd00::1]:25\", map[string]string{","+\t\t\t\"host_deny_list\":  \"fd00::/8\",","+\t\t\t\"host_allow_list\": \"fd00::1\",","+\t\t}, newStubResolver(nil))","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"[fd00::1]\"}, dialerHosts(dialers))","+\t})","+","+\tt.Run(\"empty lists neither resolve nor change the host\", func(t *testing.T) {","+\t\tresolver := newStubResolver(nil)","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", nil, resolver)","+","+\t\tdialers, err := newDialersFor(t, client)","+","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"mail.example.com\"}, dialerHosts(dialers))","+\t\tassert.Empty(t, resolver.calls)","+\t})","+","+\tt.Run(\"invalid list entry fails the send\", func(t *testing.T) {","+\t\tclient := newHostListClient(t, \"mail.example.com:25\", map[string]string{\"host_deny_list\": \"10.0.0.0/33\"}, newStubResolver(nil))","+","+\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\tassert.Equal(t, 0, count)","+\t\trequire.ErrorContains(t, err, \"host_deny_list\")","+\t})","+","+\tt.Run(\"end to end\", func(t *testing.T) {","+\t\tsrv := smtpmock.New(smtpmock.ConfigurationAttr{HostAddress: \"127.0.0.1\"})","+\t\trequire.NoError(t, srv.Start())","+\t\tdefer func() { _ = srv.Stop() }()","+\t\tresolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"127.0.0.1\"}})","+","+\t\tt.Run(\"deny list blocks the send\", func(t *testing.T) {","+\t\t\thost := fmt.Sprintf(\"mail.example.com:%d\", srv.PortNumber())","+\t\t\tclient := newHostListClient(t, host, map[string]string{\"host_deny_list\": \"127.0.0.0/8\"}, resolver)","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\tassert.Equal(t, 0, count)","+\t\t\trequire.EqualError(t, err, `smtp host \"mail.example.com\" is not allowed`)","+\t\t\tassert.Empty(t, srv.MessagesAndPurge())","+\t\t})","+","+\t\tt.Run(\"unrelated deny list delivers through the resolved address\", func(t *testing.T) {","+\t\t\thost := fmt.Sprintf(\"mail.example.com:%d\", srv.PortNumber())","+\t\t\tclient := newHostListClient(t, host, map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, resolver)","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Equal(t, 1, count)","+\t\t\tmessages, err := srv.WaitForMessagesAndPurge(1, 5*time.Second)","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Len(t, messages, 1)","+\t\t})","+","+\t\tt.Run(\"falls back to the next address when the first refuses the connection\", func(t *testing.T) {","+\t\t\t// Nothing listens on ::1, so the first dial fails and the mock on 127.0.0.1 takes over.","+\t\t\tfailoverResolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"::1\", \"127.0.0.1\"}})","+\t\t\thost := fmt.Sprintf(\"mail.example.com:%d\", srv.PortNumber())","+\t\t\tclient := newHostListClient(t, host, map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, failoverResolver)","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Equal(t, 1, count)","+\t\t\tmessages, err := srv.WaitForMessagesAndPurge(1, 5*time.Second)","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Len(t, messages, 1)","+\t\t})","+","+\t\tt.Run(\"hides the resolved address when every address is unreachable\", func(t *testing.T) {","+\t\t\tunreachableResolver := newStubResolver(map[string][]string{\"mail.example.com\": {\"::1\"}})","+\t\t\thost := fmt.Sprintf(\"mail.example.com:%d\", srv.PortNumber())","+\t\t\tclient := newHostListClient(t, host, map[string]string{\"host_deny_list\": \"10.0.0.0/8\"}, unreachableResolver)","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\tassert.Equal(t, 0, count)","+\t\t\trequire.EqualError(t, err, `failed to send email: could not connect to smtp host \"mail.example.com\"`)","+\t\t\tassert.NotContains(t, err.Error(), \"::1\")","+\t\t\tassert.Empty(t, srv.MessagesAndPurge())","+\t\t})","+","+\t\tt.Run(\"hides the address when an allow-listed host is unreachable\", func(t *testing.T) {","+\t\t\thost := fmt.Sprintf(\"[::1]:%d\", srv.PortNumber())","+\t\t\tclient := newHostListClient(t, host, map[string]string{","+\t\t\t\t\"host_deny_list\":  \"10.0.0.0/8\",","+\t\t\t\t\"host_allow_list\": \"::1\",","+\t\t\t}, newStubResolver(nil))","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\tassert.Equal(t, 0, count)","+\t\t\trequire.EqualError(t, err, `failed to send email: could not connect to smtp host \"::1\"`)","+\t\t\tassert.NotContains(t, err.Error(), \"dial tcp\")","+\t\t\tassert.NotContains(t, err.Error(), strconv.Itoa(srv.PortNumber()))","+\t\t})","+","+\t\tt.Run(\"returns the raw connect error when both lists are empty\", func(t *testing.T) {","+\t\t\thost := fmt.Sprintf(\"[::1]:%d\", srv.PortNumber())","+\t\t\tclient := newHostListClient(t, host, nil, newStubResolver(nil))","+","+\t\t\tcount, err := client.Send(ctx, newMessage())","+","+\t\t\tassert.Equal(t, 0, count)","+\t\t\trequire.ErrorContains(t, err, \"dial tcp\")","+\t\t\tvar opErr *net.OpError","+\t\t\trequire.ErrorAs(t, err, &opErr)","+\t\t})","+\t})","+}","+","+func TestIsConnectError(t *testing.T) {","+\tcases := []struct {","+\t\tname string","+\t\terr  error","+\t\twant bool","+\t}{","+\t\t{name: \"dial op error\", err: &net.OpError{Op: \"dial\", Err: errors.New(\"refused\")}, want: true},","+\t\t{name: \"wrapped dial op error\", err: fmt.Errorf(\"wrapped: %w\", &net.OpError{Op: \"dial\", Err: errors.New(\"refused\")}), want: true},","+\t\t{name: \"read op error\", err: &net.OpError{Op: \"read\", Err: errors.New(\"reset\")}, want: false},","+\t\t{name: \"plain error\", err: errors.New(\"535 auth failed\"), want: false},","+\t\t{name: \"nil\", err: nil, want: false},","+\t}","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tassert.Equal(t, tc.want, isConnectError(tc.err))","+\t\t})","+\t}","+}","+","+fu