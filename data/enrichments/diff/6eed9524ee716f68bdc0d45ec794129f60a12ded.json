 +281,7 @@ func (r *LLMISVCConfigReconciler) enqueueOnLLMInferenceServiceChange(logger logr"," \t\t\tenqueue(ref.Name)"," \t\t}"," ","-\t\tfor _, name := range llmSvc.Status.Annotations {","+\t\tfor _, name := range llmSvc.PinnedConfigNames() {"," \t\t\tenqueue(name)"," \t\t}"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/telemetry.go","lines":["@@ -0,0 +1,238 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package llmisvc","+","+import (","+\t\"context\"","+\t\"strings\"","+\t\"sync\"","+\t\"time\"","+","+\t\"github.com/prometheus/client_golang/prometheus\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client\"","+\t\"sigs.k8s.io/controller-runtime/pkg/log\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha2\"","+\t\"github.com/kserve/kserve/pkg/constants\"","+\t\"github.com/kserve/kserve/pkg/utils\"","+)","+","+const (","+\tacceleratorCPU     = \"cpu\"","+\tacceleratorGPU     = \"gpu\"","+\tacceleratorUnknown = \"unknown\"","+)","+","+var infoDesc = prometheus.NewDesc(","+\t\"kserve_llminferenceservice_info\",","+\t\"Info metric (value=1) for each active LLMInferenceService, labeled by accelerator type and model.\",","+\t[]string{\"namespace\", \"name\", \"accelerator\", \"model_name\", \"model_uri\"},","+\tnil,","+)","+","+// InfoMetricsCollector implements prometheus.Collector to expose","+// deployment-inventory metrics for LLMInferenceServices.","+// Metrics are pulled on-demand during Prometheus scrape rather than pushed during reconciliation.","+type InfoMetricsCollector struct {","+\tclient client.Client","+\tmu     sync.Mutex","+\tlast   []prometheus.Metric","+}","+","+// NewInfoMetricsCollector creates a new collector for LLMInferenceService info metrics.","+func NewInfoMetricsCollector(c client.Client) *InfoMetricsCollector {","+\treturn &InfoMetricsCollector{client: c}","+}","+","+// Describe implements prometheus.Collector.","+func (c *InfoMetricsCollector) Describe(ch chan<- *prometheus.Desc) {","+\tch <- infoDesc","+}","+","+// Collect implements prometheus.Collector.","+// Lists LLMInferenceServices from the controller-runtime cache and emits const metrics.","+// A failed list re-emits the last successful scrape so series do not disappear.","+func (c *InfoMetricsCollector) Collect(ch chan<- prometheus.Metric) {","+\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)","+\tdefer cancel()","+\tlogger := log.FromContext(ctx).WithName(\"metrics\")","+","+\tllmisvcs := &v1alpha2.LLMInferenceServiceList{}","+\tif err := c.client.List(ctx, llmisvcs); err != nil {","+\t\tlogger.Error(err, \"failed to list LLMInferenceServices for info metrics collection\")","+\t\tc.emitLast(ch)","+\t\treturn","+\t}","+","+\tnext := collectInfoMetrics(llmisvcs.Items)","+\tc.mu.Lock()","+\tc.last = next","+\tc.mu.Unlock()","+","+\tfor _, m := range next {","+\t\tch <- m","+\t}","+}","+","+func (c *InfoMetricsCollector) emitLast(ch chan<- prometheus.Metric) {","+\tc.mu.Lock()","+\tlast := c.last","+\tc.mu.Unlock()","+\tfor _, m := range last {","+\t\tch <- m","+\t}","+}","+","+func collectInfoMetrics(items []v1alpha2.LLMInferenceService) []prometheus.Metric {","+\tout := make([]prometheus.Metric, 0, len(items))","+\tfor i := range items {","+\t\tisvc := &items[i]","+\t\tif isvc.DeletionTimestamp != nil || utils.GetForceStopRuntime(isvc) {","+\t\t\tcontinue","+\t\t}","+\t\taccelerator := isvc.Status.Annotations[constants.LLMAcceleratorAnnotationKey]","+\t\tif accelerator == \"\" {","+\t\t\taccelerator = resolveAccelerator(isvc)","+\t\t}","+\t\tout = append(out, prometheus.MustNewConstMetric(","+\t\t\tinfoDesc,","+\t\t\tprometheus.GaugeValue,","+\t\t\t1,","+\t\t\tisvc.Namespace,","+\t\t\tisvc.Name,","+\t\t\taccelerator,","+\t\t\tresolveModelName(isvc),","+\t\t\tisvc.Spec.Model.URI.String(),","+\t\t))","+\t}","+\treturn out","+}","+","+// RecordAcceleratorAnnotation resolves the accelerator type from the effective","+// (merged) spec and writes it to Status.Annotations so the pull-based Collector","+// can read it at scrape time.","+func RecordAcceleratorAnnotation(llmSvc *v1alpha2.LLMInferenceService) {","+\taccel := resolveAccelerator(llmSvc)","+\tif llmSvc.Status.Annotations == nil {","+\t\tllmSvc.Status.Annotations = map[string]string{}","+\t}","+\tllmSvc.Status.Annotations[constants.LLMAcceleratorAnnotationKey] = accel","+}","+","+func resolveAccelerator(isvc *v1alpha2.LLMInferenceService) string {","+\tpodSpecs := []*corev1.PodSpec{","+\t\tisvc.Spec.Template,","+\t\tisvc.Spec.Worker,","+\t}","+\tif isvc.Spec.Prefill != nil {","+\t\tpodSpecs = append(podSpecs, isvc.Spec.Prefill.Template, isvc.Spec.Prefill.Worker)","+\t}","+","+\tfor _, ps := range podSpecs {","+\t\tif ps == nil {","+\t\t\tcontinue","+\t\t}","+\t\tfor i := range ps.Containers {","+\t\t\tif hasGPUResources(&ps.Containers[i]) {","+\t\t\t\treturn acceleratorGPU","+\t\t\t}","+\t\t}","+\t}","+","+\tfor _, ps := range podSpecs {","+\t\tif ps == nil {","+\t\t\tcontinue","+\t\t}","+\t\tfor i := range ps.Containers {","+\t\t\tif hasExtendedResources(&ps.Containers[i]) {","+\t\t\t\treturn acceleratorUnknown","+\t\t\t}","+\t\t}","+\t}","+","+\tif hasDRAResources(isvc, podSpecs) {","+\t\treturn acceleratorUnknown","+\t}","+","+\treturn acceleratorCPU","+}","+","+// hasDRAResources returns true if any pod spec references DRA resource claims","+// or the service uses managed DRA. Without device-class mapping we cannot","+// determine whether DRA provisions a GPU or other accelerator.","+func hasDRAResources(isvc *v1alpha2.LLMInferenceService, podSpecs []*corev1.PodSpec) bool {","+\tif isvc.HasManagedDRA() {","+\t\treturn true","+\t}","+\tfor _, ps := range podSpecs {","+\t\tif ps != nil && len(ps.ResourceClaims) > 0 {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func hasExtendedResources(container *corev1.Container) bool {","+\tfor name := range container.Resources.Requests {","+\t\tif strings.Contains(string(name), \"/\") {","+\t\t\treturn true","+\t\t}","+\t}","+\tfor name := range container.Resources.Limits {","+\t\tif strings.Contains(string(name), \"/\") {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func hasGPUResources(container *corev1.Container) bool {","+\tfor name := range container.Resources.Requests {","+\t\tif isGPUResource(string(name)) {","+\t\t\treturn true","+\t\t}","+\t}","+\tfor name := range container.Resources.Limits {","+\t\tif isGPUResource(string(name)) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func isGPUResource(name string) bool {","+\tfor _, t := range constants.DefaultGPUResourceTypeList {","+\t\tif name == t {","+\t\t\treturn true","+\t\t}","+\t}","+\tif strings.HasPrefix(name, constants.NvidiaMigGPUResourceTypePrefix) {","+\t\treturn true","+\t}","+\tif strings.HasPrefix(name, \"gpu.intel.com/\") {","+\t\treturn true","+\t}","+\treturn false","+}","+","+func resolveModelName(llmSvc *v1alpha2.LLMInferenceService) string {","+\tif llmSvc.Spec.Model.Name != nil && *llmSvc.Spec.Model.Name != \"\" {","+\t\treturn *llmSvc.Spec.Model.Name","+\t}","+\treturn llmSvc.Name","+}"],"additions":238,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/telemetry_test.go","lines":["@@ -0,0 +1,640 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package llmisvc","+","+import (","+\t\"testing\"","+","+\t\"github.com/prometheus/client_golang/prometheus\"","+\tdto \"github.com/prometheus/client_model/go\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\t\"k8s.io/apimachinery/pkg/api/resource\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"knative.dev/pkg/apis\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha2\"","+\t\"github.com/kserve/kserve/pkg/constants\"","+)","+","+func testModelURI(org, model string) apis.URL {","+\treturn apis.URL{Scheme: \"hf\", Host: org, Path: \"/\" + model}","+}","+","+func cpuLLMInferenceService(name, namespace string) *v1alpha2.LLMInferenceService {","+\treturn &v1alpha2.LLMInferenceService{","+\t\tObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace},","+\t\tSpec: v1alpha2.LLMInferenceServiceSpec{","+\t\t\tModel: v1alpha2.LLMModelSpec{","+\t\t\t\tURI: testModelURI(\"facebook\", \"opt-125m\"),","+\t\t\t},","+\t\t\tWorkloadSpec: v1alpha2.WorkloadSpec{","+\t\t\t\tTemplate: &corev1.PodSpec{","+\t\t\t\t\tContainers: []corev1.Container{{","+\t\t\t\t\t\tName: \"main\",","+\t\t\t\t\t\tResources: corev1.ResourceRequirements{","+\t\t\t\t\t\t\tRequests: corev1.ResourceList{","+\t\t\t\t\t\t\t\tcorev1.ResourceCPU:    resource.MustParse(\"4\"),","+\t\t\t\t\t\t\t\tcorev1.ResourceMemory: resource.MustParse(\"16Gi\"),","+\t\t\t\t\t\t\t},","+\t\t\t\t\t\t},","+\t\t\t\t\t}},","+\t\t\t\t},","+\t\t\t},","