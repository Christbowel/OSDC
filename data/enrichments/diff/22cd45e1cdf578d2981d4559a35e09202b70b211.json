{"id":"22cd45e1cdf578d2981d4559a35e09202b70b211","axis":"silent","repo":"grafana/grafana","sha":"22cd45e1cdf578d2981d4559a35e09202b70b211","parsed":{"files":[{"path":"conf/defaults.ini","lines":["@@ -2728,6 +2728,13 @@ webhook_rate_limit_rps = 0"," "," #################################### Unified Storage ####################################"," [unified_storage]","+# Blob garbage collection requires garbage_collection_enabled. Enable it in dry-run","+# mode first and inspect grafana_unified_storage_blob_gc_candidates after the grace","+# period before allowing deletion. The general garbage_collection_dry_run setting","+# also prevents blob deletion when enabled.","+blob_garbage_collection_enabled = false","+blob_garbage_collection_dry_run = true","+"," # index_path is the path where unified storage can store its index files for search."," # If empty, defaults to \"<data_dir>/unified-search/bleve\" (see [paths] section)."," # Please note that sharing the same index_path between multiple running Grafana instances is not supported."],"additions":7,"deletions":0,"truncated":false},{"path":"pkg/setting/setting.go","lines":["@@ -871,6 +871,8 @@ type Cfg struct {"," \tResourceVersionMaxWait            time.Duration"," \tEnableGarbageCollection           bool"," \tGarbageCollectionDryRun           bool","+\tBlobGarbageCollectionEnabled      bool","+\tBlobGarbageCollectionDryRun       bool"," \tGarbageCollectionInterval         time.Duration"," \tGarbageCollectionBatchSize        int"," \tGarbageCollectionBatchWait        time.Duration"],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/setting/setting_unified_storage.go","lines":["@@ -270,6 +270,8 @@ func (cfg *Cfg) setUnifiedStorageConfig() {"," \t// garbage collection"," \tcfg.EnableGarbageCollection = section.Key(\"garbage_collection_enabled\").MustBool(true)"," \tcfg.GarbageCollectionDryRun = section.Key(\"garbage_collection_dry_run\").MustBool(false)","+\tcfg.BlobGarbageCollectionEnabled = section.Key(\"blob_garbage_collection_enabled\").MustBool(false)","+\tcfg.BlobGarbageCollectionDryRun = section.Key(\"blob_garbage_collection_dry_run\").MustBool(true)"," \tcfg.GarbageCollectionInterval = section.Key(\"garbage_collection_interval\").MustDuration(15 * time.Minute)"," \tcfg.GarbageCollectionBatchSize = section.Key(\"garbage_collection_batch_size\").MustInt(100)"," \tcfg.GarbageCollectionBatchWait = section.Key(\"garbage_collection_batch_wait\").MustDuration(1 * time.Second)"],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/setting/setting_unified_storage_test.go","lines":["@@ -10,6 +10,19 @@ import ("," \t\"github.com/stretchr/testify/require\""," )"," ","+func TestBlobGarbageCollectionDefaultsAndOverrides(t *testing.T) {","+\tcfg := NewCfg()","+\tcfg.setUnifiedStorageConfig()","+\trequire.False(t, cfg.BlobGarbageCollectionEnabled)","+\trequire.True(t, cfg.BlobGarbageCollectionDryRun)","+","+\tcfg.Raw.Section(\"unified_storage\").Key(\"blob_garbage_collection_enabled\").SetValue(\"true\")","+\tcfg.Raw.Section(\"unified_storage\").Key(\"blob_garbage_collection_dry_run\").SetValue(\"false\")","+\tcfg.setUnifiedStorageConfig()","+\trequire.True(t, cfg.BlobGarbageCollectionEnabled)","+\trequire.False(t, cfg.BlobGarbageCollectionDryRun)","+}","+"," func TestResourceVersionMaxWait(t *testing.T) {"," \tfor _, tc := range []struct {"," \t\tname  string"],"additions":13,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/blob_gc.go","lines":["@@ -0,0 +1,168 @@","+package resource","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"iter\"","+\t\"time\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/utils\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource/kv\"","+)","+","+// BlobGarbageCollector scans blobs without retaining the keys of referenced blobs.","+// Collect must be called serially.","+type BlobGarbageCollector struct {","+\tstore     BlobGCStore","+\tbatchSize int","+\tbatchWait time.Duration","+}","+","+type BlobGCStore interface {","+\tKeys(context.Context, string, kv.ListOptions) iter.Seq2[string, error]","+\tDelete(context.Context, string, string) error","+}","+","+type blobGCAgeStore interface {","+\tBlobGCStore","+\tFirstUnused(context.Context, string, time.Time) (time.Time, error)","+\tClearUnused(context.Context, string) error","+}","+","+var (","+\t_ blobGCAgeStore = (*CDKBlobGCStore)(nil)","+\t_ blobGCAgeStore = (*kv.SqlKV)(nil)","+)","+","+func NewBlobGarbageCollector(store BlobGCStore, batchSize int, batchWait time.Duration) *BlobGarbageCollector {","+\tif batchSize <= 0 {","+\t\tbatchSize = 100","+\t}","+\treturn &BlobGarbageCollector{store: store, batchSize: batchSize, batchWait: batchWait}","+}","+","+// Collect preserves blobs referenced by any retained revision, including trash.","+// referenced must fail closed on storage or decoding errors. Grace must be positive.","+func (g *BlobGarbageCollector) Collect(ctx context.Context, now time.Time, grace time.Duration, dryRun bool, referenced func(context.Context, kv.BlobKey) (bool, error)) (int, error) {","+\tif grace <= 0 {","+\t\treturn 0, fmt.Errorf(\"blob GC grace period must be positive\")","+\t}","+\t// SQL and bucket stores use upload time.","+\tages, ok := g.store.(blobGCAgeStore)","+\tif !ok {","+\t\treturn 0, fmt.Errorf(\"blob GC store does not support durable age tracking\")","+\t}","+\tkeys := g.store.Keys(ctx, kv.BlobDataSection, kv.ListOptions{})","+\tif store, ok := g.store.(interface {","+\t\tBlobGCKeys(context.Context, int) iter.Seq2[string, error]","+\t}); ok {","+\t\tkeys = store.BlobGCKeys(ctx, g.batchSize)","+\t}","+\tcount := 0","+\tprocessed := 0","+\tvar errs []error","+\tfor key, err := range keys {","+\t\tif err != nil {","+\t\t\treturn count, errors.Join(append(errs, err)...)","+\t\t}","+\t\tif err := ctx.Err(); err != nil {","+\t\t\treturn count, err","+\t\t}","+\t\tif processed > 0 && processed%g.batchSize == 0 && g.batchWait > 0 {","+\t\t\ttimer := time.NewTimer(g.batchWait)","+\t\t\tselect {","+\t\t\tcase <-ctx.Done():","+\t\t\t\ttimer.Stop()","+\t\t\t\treturn count, ctx.Err()","+\t\t\tcase <-timer.C:","+\t\t\t}","+\t\t}","+\t\tprocessed++","+\t\tbk, err := kv.ParseBlobKey(key)","+\t\tif err != nil {","+\t\t\terrs = append(errs, err)","+\t\t\tcontinue","+\t\t}","+\t\t// Provisioning preview images are referenced by PR comment URLs, not by","+\t\t// resource revisions. Their lifetime cannot be inferred from history.","+\t\t// TODO: Replace this exemption with durable URL-reference tracking and a","+\t\t// retention plan for previews already published in PR comments.","+\t\tif bk.Group == \"provisioning.grafana.app\" && bk.Resource == \"repositories\" {","+\t\t\tcontinue","+\t\t}","+\t\tlive, err := referenced(ctx, bk)","+\t\tif err != nil {","+\t\t\terrs = append(errs, err)","+\t\t\tcontinue","+\t\t}","+\t\tif live {","+\t\t\tif err := ages.ClearUnused(ctx, key); err != nil {","+\t\t\t\terrs = append(errs, err)","+\t\t\t}","+\t\t\tcontinue","+\t\t}","+\t\tfirst, err := ages.FirstUnused(ctx, key, now)","+\t\tif err != nil {","+\t\t\terrs = append(errs, err)","+\t\t\tcontinue","+\t\t}","+\t\tif first.IsZero() || now.Sub(first) < grace {","+\t\t\tcontinue","+\t\t}","+\t\tif !dryRun {","+\t\t\tif err := g.store.Delete(ctx, kv.BlobDataSection, key); err != nil {","+\t\t\t\terrs = append(errs, err)","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif err := ages.ClearUnused(ctx, key); err != nil {","+\t\t\t\terrs = append(errs, err)","+\t\t\t}","+\t\t}","+\t\tcount++","+\t}","+\treturn count, errors.Join(errs...)","+}","+","+// ResourceReferencesBlob understands both blob reference representations served by GetBlob.","+func ResourceReferencesBlob(value []byte, uid string) (bool, error) {","+\tvar obj struct {","+\t\tMetadata struct {","+\t\t\tAnnotations map[string]string `json:\"annotations\"`","+\t\t} `json:\"metadata\"`","+\t\tBlobs map[string]BlobReference `json:\"blobs\"`","+\t}","+\tif err := json.Unmarshal(value, &obj); err != nil {","+\t\treturn false, err","+\t}","+\tfor _, ref := range obj.Blobs {","+\t\tif ref.UID == uid {","+\t\t\treturn true, nil","+\t\t}","+\t}","+\tinfo := utils.ParseBlobInfo(obj.Metadata.Annotations[utils.AnnoKeyBlob])","+\treturn info != nil && info.UID == uid, nil","+}","+","+func (b *kvStorageBackend) blobReferenced(ctx context.Context, blob kv.BlobKey) (bool, error) {","+\tkey := ListRequestKey{Group: blob.Group, Resource: blob.Resource, Namespace: blob.Namespace, Name: blob.Name}","+\tfor dk, err := range b.dataStore.Keys(ctx, key, SortOrderAsc) {","+\t\tif err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\treader, err := b.dataStore.Get(ctx, dk)","+\t\tif err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\tvalue, err := readAndClose(reader)","+\t\tif err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\tlive, err := ResourceReferencesBlob(value, blob.UID)","+\t\tif err != nil || live {","+\t\t\treturn live, err","+\t\t}","+\t}","+\treturn false, nil","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/blob_gc_metrics.go","lines":["@@ -0,0 +1,54 @@","+package resource","+","+import (","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/promauto\"","+)","+","+// BlobGCMetrics records bounded, per-backend results for each collection pass.","+type BlobGCMetrics struct {","+\tRuns       prometheus.Counter","+\tCandidates prometheus.Gauge","+\tDeleted    prometheus.Counter","+\tErrors     prometheus.Counter","+}","+","+func NewBlobGCMetricsIfEnabled(reg prometheus.Registerer, backend string, enabled bool) *BlobGCMetrics {","+\tif !enabled {","+\t\treturn nil","+\t}","+\tfactory := promauto.With(prometheus.WrapRegistererWith(prometheus.Labels{\"backend\": backend}, reg))","+\treturn &BlobGCMetrics{","+\t\tRuns: factory.NewCounter(prometheus.CounterOpts{","+\t\t\tName: \"grafana_unified_storage_blob_gc_runs_total\",","+\t\t\tHelp: \"Number of blob garbage collection passes attempted.\",","+\t\t}),","+\t\tCandidates: factory.NewGauge(prometheus.GaugeOpts{","+\t\t\tName: \"grafana_unified_storage_blob_gc_candidates\",","+\t\t\tHelp: \"Number of eligible unreferenced blobs found in the latest successful collection pass (also in dry-run mode).\",","+\t\t}),","+\t\tDeleted: factory.NewCounter(prometheus.CounterOpts{","+\t\t\tName: \"grafana_unified_storage_blob_gc_deleted_total\",","+\t\t\tHelp: \"Number of blobs deleted by garbage collection.\",","+\t\t}),","+\t\tErrors: factory.NewCounter(prometheus.CounterOpts{","+\t\t\tName: \"grafana_unified_storage_blob_gc_errors_total\",","+\t\t\tHelp: \"Number of blob garbage collection passes that encountered an error.\",","+\t\t}),","+\t}","+}","+","+func (m *BlobGCMetrics) Record(count int, dryRun bool, err error) {","+\tif m == nil {","+\t\treturn","+\t}","+\tm.Runs.Inc()","+\tif err != nil {","+\t\tm.Errors.Inc()","+\t} else {","+\t\tm.Candidates.Set(float64(count))","+\t}","+\tif !dryRun {","+\t\tm.Deleted.Add(float64(count))","+\t}","+}"],"additions":54,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/blob_gc_metrics_test.go","lines":["@@ -0,0 +1,32 @@","+package resource","+","+import (","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestBlobGCMetrics(t *testing.T) {","+\treg := prometheus.NewRegistry()","+\tsql := NewBlobGCMetricsIfEnabled(reg, \"sql\", true)","+\tkv := NewBlobGCMetricsIfEnabled(reg, \"kv\", true)","+\trequire.Nil(t, NewBlobGCMetricsIfEnabled(reg, \"sql\", false))","+","+\tsql.Record(3, true, nil)","+\trequire.Equal(t, float64(3), testutil.ToFloat64(sql.Candidates))","+\trequire.Zero(t, testutil.ToFloat64(sql.Deleted))","+\tsql.Record(2, false, nil)","+\trequire.Equal(t, float64(2), testutil.ToFloat64(sql.Candidates))","+\trequire.Equal(t, float64(2), testutil.ToFloat64(sql.Deleted))","+\tsql.Record(1, false, errors.New(\"list failed\"))","+\trequire.Equal(t, float64(2), testutil.ToFloat64(sql.Candidates))","+\trequire.Equal(t, float64(3), testutil.ToFloat64(sql.Deleted))","+\trequire.Equal(t, float64(1), testutil.ToFloat64(sql.Errors))","+\trequire.Equal(t, float64(3), testutil.ToFloat64(sql.Runs))","+\trequire.Zero(t, testutil.ToFloat64(kv.Deleted))","+\t_, err := reg.Gather()","+\trequire.NoError(t, err)","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/blob_gc_test.go","lines":["@@ -0,0 +1,247 @@","+package resource","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/utils\"","+","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource/kv\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+func TestResourceReferencesBlob(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname, value   string","+\t\tlive, failure bool","+\t}{","+\t\t{name: \"snapshot\", value: `{\"blobs\":{\"dashboard\":{\"uid\":\"blob\"}}}`, live: true},","+\t\t{name: \"multiple references\", value: `{\"blobs\":{\"other\":{\"uid\":\"other\"},\"dashboard\":{\"uid\":\"blob\"}}}`, live: true},","+\t\t{name: \"annotation\", value: `{\"metadata\":{\"annotations\":{\"grafana.app/blob\":\"blob; size=12\"}}}`, live: true},","+\t\t{name: \"different uid\", value: `{\"blobs\":{\"dashboard\":{\"uid\":\"other\"}}}`},","+\t\t{name: \"inline snapshot\", value: `{\"spec\":{\"dashboard\":{}}}`},","+\t\t{name: \"malformed\", value: `{`, failure: true},","+\t\t{name: \"malformed references\", value: `{\"blobs\":{\"dashboard\":\"blob\"}}`, failure: true},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tlive, err := ResourceReferencesBlob([]byte(tc.value), \"blob\")","+\t\t\trequire.Equal(t, tc.failure, err != nil)","+\t\t\trequire.Equal(t, tc.live, live)","+\t\t})","+\t}","+}","+","+func TestBlobGarbageCollector(t *testing.T) {","+\tfor _, scenario := range []string{\"orphan\", \"referenced\", \"dry run\", \"read error\", \"reference appears\", \"restart\"} {","+\t\tt.Run(scenario, func(t *testing.T) {","+\t\t\tstore := setupSqlKV(t)","+\t\t\tkey := kv.BlobKey{Group: \"dashboard.grafana.app\", Resource: \"snapshots\", Namespace: \"default\", Name: \"snap\", UID: \"blob\"}","+\t\t\twriter, err := store.Save(t.Context(), kv.BlobDataSection, key.String())","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = writer.Write(append(kv.EncodeBlobValueHeader(\"text/plain\"), []byte(\"payload\")...))","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NoError(t, writer.Close())","+\t\t\tgc := NewBlobGarbageCollector(store, 100, 0)","+\t\t\tnow := time.Now()","+\t\t\tlive := scenario == \"referenced\"","+\t\t\tvar readErr error","+\t\t\treferenced := func(context.Context, kv.BlobKey) (bool, error) { return live, readErr }","+\t\t\tcount, err := gc.Collect(t.Context(), now, time.Hour, false, referenced)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Zero(t, count)","+\t\t\tcount, err = gc.Collect(t.Context(), now.Add(time.Minute), time.Hour, false, referenced)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Zero(t, count)","+\t\t\tswitch scenario {","+\t\t\tcase \"read error\":","+\t\t\t\treadErr = errors.New(\"unavailable\")","+\t\t\tcase \"reference appears\":","+\t\t\t\tlive = true","+\t\t\tcase \"restart\":","+\t\t\t\tgc = NewBlobGarbageCollector(store, 100, 0)","+\t\t\t}","+\t\t\tcount, err = gc.Collect(t.Context(), now.Add(2*time.Hour), time.Hour, scenario == \"dry run\", referenced)","+\t\t\trequire.Equal(t, scenario == \"read error\", err != nil)","+\t\t\texpectedCount := 0","+\t\t\tif scenario == \"orphan\" || scenario == \"dry run\" || scenario == \"restart\" {","+\t\t\t\texpectedCount = 1","+\t\t\t}","+\t\t\trequire.Equal(t, expectedCount, count)","+\t\t\treader, err := store.Get(t.Context(), kv.BlobDataSection, key.String())","+\t\t\tif scenario == \"orphan\" || scenario == \"restart\" {","+\t\t\t\trequire.ErrorIs(t, err, kv.ErrNotFound)","+\t\t\t} else {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.NoError(t, reader.Close())","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestBlobGCPagedKeys(t *testing.T) {","+\tstore := setupSqlKV(t)","+\tbase := kv.BlobKey{Group: \"group\", Resource: \"resource\", Name: \"name\", UID: \"a\"}","+\tfor _, uid := range []string{\"a\", \"a-long\", \"b\"} {","+\t\tkey := base","+\t\tkey.UID = uid","+\t\tif uid == \"a\" {","+\t\t\tkey.Name = \"z-last-resource-first-uuid\"","+\t\t}","+\t\twriter, err := store.Save(t.Context(), kv.BlobDataSection, key.String())","+\t\trequire.NoError(t, err)","+\t\t_, err = writer.Write(append(kv.EncodeBlobValueHeader(\"text/plain\"), []byte(\"payload\")...))","+\t\trequire.NoError(t, err)","+\t\trequire.NoError(t, writer.Close())","+\t}","+\tnow := time.Now()","+\tgc := NewBlobGarbageCollector(store, 1, 0)","+\tlive := func(_ context.Context, key kv.BlobKey) (bool, error) { return key.UID == \"b\", nil }","+\tcount, err := gc.Collect(t.Context(), now, time.Hour, false, live)","+\trequire.NoError(t, err)","+\trequire.Zero(t, count)","+\tgc = NewBlobGarbageCollector(store, 1, 0)","+\tcount, err = gc.Collect(t.Context(), now.Add(2*time.Hour), time.Hour, true, live)","+\trequire.NoError(t, err)","+\trequire.Equal(t, 2, count)","+\tcount, err = gc.Collect(t.Context(), now.Add(2*time.Hour), time.Hour, false, live)","+\trequire.NoError(t, err)","+\trequire.Equal(t, 2, count)","+\tkey := base","+\tkey.UID = \"b\"","+\treader, err := store.Get(t.Context(), kv.BlobDataSection, key.String())","+\trequire.NoError(t, err)","+\trequire.NoError(t, reader.Close())","+}","+","+func TestBlobGCRejectsBadgerWithoutAgeTracking(t *testing.T) {","+\tgc := NewBlobGarbageCollector(setupBadgerKV(t), 1, 0)","+\tcount, err := gc.Collect(t.Context(), time.Now(), time.Hour, false, func(context.Context, kv.BlobKey) (bool, error) {","+\t\tt.Fatal(\"must not scan unsupported backends\")","+\t\treturn false, nil","+\t})","+\trequire.ErrorContains(t, err, \"durable age tracking\")","+\trequire.Zero(t, count)","+}","+","+func TestKVBlobGCOptInAndDryRun(t *testing.T) {","+\tb := setupTestStorageBackend(t)","+\tb.kv = setupSqlKV(t)","+\tb.dataStore = newDataStore(b.kv, nil)","+\tkey := kv.BlobKey{Group: \"group\", Resource: \"resource\", Namespace: \"default\", Name: \"snap\", UID: \"unreferenced\"}","+\twriter, err := b.kv.Save(t.Context(), kv.BlobDataSection, key.String())","+\trequire.NoError(t, err)","+\t_, err = writer.Write(append(kv.EncodeBlobValueHeader(\"image/png\"), []byte(\"image\")...))","+\trequire.NoError(t, err)","+\trequire.NoError(t, writer.Close())","+","+\tb.garbageCollection.MaxAge = time.Nanosecond","+\tb.runGarbageCollection(t.Context(), time.Now().UnixMicro())","+\trequire.Nil(t, b.blobGC)","+","+\tb.garbageCollection.BlobEnabled = true","+\tb.garbageCollection.BlobDryRun = true","+\tb.collectBlobs(t.Context())","+\tb.collectBlobs(t.Context())","+\treader, err := b.kv.Get(t.Context(), kv.BlobDataSection, key.String())","+\trequire.NoError(t, err)","+\trequire.NoError(t, reader.Close())","+","+\tb.garbageCollection.BlobDryRun = false","+\tb.collectBlobs(t.Context())","+\t_, err = b.kv.Get(t.Context(), kv.BlobDataSection, key.String())","+\trequire.ErrorIs(t, err, kv.ErrNotFound)","+}","+","+func TestBlobGCPreservesProvisioningPreviewURL(t *testing.T) {","+\tstore := setupSqlKV(t)","+\tkey := kv.BlobKey{Group: \"provisioning.grafana.app\", Resource: \"repositories\", Namespace: \"default\", Name: \"repo\", UID: \"preview\"}","+\twriter, err := store.Save(t.Context(), kv.BlobDataSection, key.String())","+\trequire.NoError(t, err)","+\t_, err = writer.Write(append(kv.EncodeBlobValueHeader(\"image/png\"), []byte(\"image\")...))","+\trequire.NoError(t, err)","+\trequire.NoError(t, writer.Close())","+\tgc := NewBlobGarbageCollector(store, 100, 0)","+\tnow := time.Now()","+\tfor _, at := range []time.Time{now, now.Add(48 * time.Hour)} {","+\t\tcount, err := gc.Collect(t.Context(), at, time.Hour, false, func(context.Context, kv.BlobKey) (bool, error) {","+\t\t\treturn false, nil // URL references are not in resource history","+\t\t})","+\t\trequire.NoError(t, err)","+\t\trequire.Zero(t, count)","+\t}","+\treader, err := store.Get(t.Context(), kv.BlobDataSection, key.String())","+\trequire.NoError(t, err)","+\trequire.NoError(t, reader.Close())","+}","+","+func TestCDKBlobGCStore(t *testing.T) {","+\tbucket, err := OpenBlobBucket(t.Context(), \"mem://\")","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { require.NoError(t, bucket.Close()) })","+\tblobStore, err := NewCDKBlobSupport(t.Context(), CDKBlobSupportOptions{Bucket: bucket})","+\trequire.NoError(t, err)","+\tresourceKey := &resourcepb.ResourceKey{Group: \"dashboard.grafana.app\", Resource: \"snapshots\", Namespace: \"default\", Name: \"snap\"}","+\tresponse, err := blobStore.PutResourceBlob(t.Context(), &resourcepb.PutBlobRequest{Resource: resourceKey, ContentType: \"image/png\", Value: []byte(\"image\")})","+\trequire.NoError(t, err)","+\tstore := NewCDKBlobGCStore(bucket, \"\")","+\tgc := NewBlobGarbageCollector(store, 100, 0)","+\tnow := time.Now()","+\tkey := kv.BlobKey{Group: resourceKey.Group, Resource: resourceKey.Resource, Namespace: resourceKey.Namespace, Name: resourceKey.Name, UID: response.Uid}","+\tcount, err := gc.Collect(t.Context(), now, time.Hour, false, func(_ context.Context, got kv.BlobKey) (bool, error) {","+\t\trequire.Equal(t, key, got)","+\t\treturn false, nil","+\t})","+\trequire.NoError(t, err)","+\trequire.Zero(t, count)","+\tcount, err = gc.Collect(t.Context(), now.Add(2*time.Hour), time.Hour, false, func(context.Context, kv.BlobKey) (bool, error) { return false, nil })","+\trequire.NoError(t, err)","+\trequire.Equal(t, 1, count)","+\t_, err = blobStore.GetResourceBlob(t.Context(), resourceKey, &utils.BlobInfo{UID: response.Uid, MimeType: \"image/png\"}