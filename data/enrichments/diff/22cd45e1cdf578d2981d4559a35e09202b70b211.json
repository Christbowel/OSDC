 live)","+\trequire.NoError(t, store.Delete(t.Context(), kv.DataSection, old.String()))","+\tlive, err = backend.blobReferenced(t.Context(), blob)","+\trequire.NoError(t, err)","+\trequire.False(t, live)","+}"],"additions":247,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/cdk_blob_gc.go","lines":["@@ -0,0 +1,91 @@","+package resource","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"io\"","+\t\"iter\"","+\t\"strings\"","+\t\"time\"","+","+\t\"gocloud.dev/blob\"","+","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource/kv\"","+)","+","+// CDKBlobGCStore enumerates the objects written by cdkBlobSupport.","+type CDKBlobGCStore struct {","+\tbucket  CDKBucket","+\troot    string","+\tkey     string","+\tpath    string","+\tmodTime time.Time","+}","+","+func NewCDKBlobGCStore(bucket CDKBucket, root string) *CDKBlobGCStore {","+\treturn &CDKBlobGCStore{bucket: bucket, root: root}","+}","+","+func (s *CDKBlobGCStore) Keys(ctx context.Context, section string, _ kv.ListOptions) iter.Seq2[string, error] {","+\treturn func(yield func(string, error) bool) {","+\t\tif section != kv.BlobDataSection {","+\t\t\tyield(\"\", fmt.Errorf(\"unsupported blob GC section %q\", section))","+\t\t\treturn","+\t\t}","+\t\tit := s.bucket.List(&blob.ListOptions{Prefix: s.root})","+\t\tfor {","+\t\t\tobj, err := it.Next(ctx)","+\t\t\tif err != nil {","+\t\t\t\tif !errors.Is(err, io.EOF) {","+\t\t\t\t\tyield(\"\", err)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif obj.IsDir || !strings.HasPrefix(obj.Key, s.root) {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tpath := strings.TrimPrefix(obj.Key, s.root)","+\t\t\tparts := strings.Split(path, \"/\")","+\t\t\tif len(parts) != 5 && len(parts) != 4 {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tuid := parts[len(parts)-1]","+\t\t\tif dot := strings.IndexByte(uid, '.'); dot >= 0 {","+\t\t\t\tuid = uid[:dot]","+\t\t\t}","+\t\t\tif len(parts) == 5 {","+\t\t\t\tparts = []string{parts[1], parts[2], parts[0], parts[3], uid}","+\t\t\t} else {","+\t\t\t\tparts = []string{parts[0], parts[1], \"\", parts[2], uid}","+\t\t\t}","+\t\t\tkey := strings.Join(parts, \"/\")","+\t\t\tif _, err := kv.ParseBlobKey(key); err != nil {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\ts.key, s.path, s.modTime = key, obj.Key, obj.ModTime","+\t\t\tif !yield(key, nil) {","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t}","+}","+","+func (s *CDKBlobGCStore) Delete(ctx context.Context, section, key string) error {","+\tif section != kv.BlobDataSection {","+\t\treturn fmt.Errorf(\"unsupported blob GC section %q\", section)","+\t}","+\tif key != s.key {","+\t\treturn fmt.Errorf(\"blob GC path not found for %q\", key)","+\t}","+\treturn s.bucket.Delete(ctx, s.path)","+}","+","+func (s *CDKBlobGCStore) FirstUnused(_ context.Context, key string, _ time.Time) (time.Time, error) {","+\tif key != s.key {","+\t\treturn time.Time{}, fmt.Errorf(\"blob GC path not found for %q\", key)","+\t}","+\treturn s.modTime, nil","+}","+","+func (s *CDKBlobGCStore) ClearUnused(context.Context, string) error { return nil }"],"additions":91,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/kv/blob_data.go","lines":["@@ -10,6 +10,7 @@ import ("," \t\"errors\""," \t\"fmt\""," \t\"io\"","+\t\"iter\""," \t\"slices\""," \t\"strings\""," \t\"time\"","@@ -185,6 +186,77 @@ func (k *SqlKV) deleteBlob(ctx context.Context, key string) error {"," \treturn nil"," }"," ","+// BlobGCKeys pages by the indexed UUID rather than resource-key order. Each page","+// is closed before yielding so reference checks and deletes can use the connection.","+func (k *SqlKV) BlobGCKeys(ctx context.Context, batchSize int) iter.Seq2[string, error] {","+\treturn func(yield func(string, error) bool) {","+\t\tif batchSize <= 0 {","+\t\t\tyield(\"\", fmt.Errorf(\"blob GC batch size must be positive\"))","+\t\t\treturn","+\t\t}","+\t\tcursor := \"\"","+\t\tfor {","+\t\t\tpage, err := k.blobGCPage(ctx, cursor, batchSize)","+\t\t\tif err != nil {","+\t\t\t\tyield(\"\", err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tfor _, key := range page {","+\t\t\t\tif !yield(key.String(), nil) {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t}","+\t\t\tif len(page) < batchSize {","+\t\t\t\treturn","+\t\t\t}","+\t\t\tcursor = page[len(page)-1].UID","+\t\t}","+\t}","+}","+","+func (k *SqlKV) blobGCPage(ctx context.Context, cursor string, batchSize int) (page []BlobKey, err error) {","+\tquery := fmt.Sprintf(\"SELECT %s, %s, %s, %s, %s FROM %s\",","+\t\tk.dialect.QuoteIdent(\"group\"), k.dialect.QuoteIdent(\"resource\"), k.dialect.QuoteIdent(\"namespace\"),","+\t\tk.dialect.QuoteIdent(\"name\"), k.dialect.QuoteIdent(\"uuid\"), k.dialect.QuoteIdent(resourceBlobTable))","+\tvar args []any","+\tif cursor != \"\" {","+\t\tquery += \" WHERE \" + k.dialect.QuoteIdent(\"uuid\") + \" > \" + k.dialect.Placeholder(1)","+\t\targs = append(args, cursor)","+\t}","+\tquery += \" ORDER BY \" + k.dialect.QuoteIdent(\"uuid\") + \" ASC LIMIT \" + k.dialect.Placeholder(len(args)+1)","+\targs = append(args, batchSize)","+\trows, err := k.conn(ctx).QueryContext(ctx, query, args...)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tdefer func() { err = errors.Join(err, rows.Close()) }()","+\tpage = make([]BlobKey, 0, batchSize)","+\tfor rows.Next() {","+\t\tvar key BlobKey","+\t\tif err := rows.Scan(&key.Group, &key.Resource, &key.Namespace, &key.Name, &key.UID); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tpage = append(page, key)","+\t}","+\tif err := rows.Err(); err != nil {","+\t\treturn nil, err","+\t}","+\treturn page, nil","+}","+","+func (k *SqlKV) FirstUnused(ctx context.Context, key string, _ time.Time) (time.Time, error) {","+\tbk, err := ParseBlobKey(key)","+\tif err != nil {","+\t\treturn time.Time{}, err","+\t}","+\tquery := fmt.Sprintf(\"SELECT %s FROM %s WHERE %s\", k.dialect.QuoteIdent(\"created\"), k.dialect.QuoteIdent(resourceBlobTable), k.blobWhere(blobIdentityColumns))","+\tvar created time.Time","+\terr = k.conn(ctx).QueryRowContext(ctx, query, blobIdentityArgs(bk)...).Scan(&created)","+\treturn created, err","+}","+","+func (k *SqlKV) ClearUnused(context.Context, string) error { return nil }","+"," func (k *SqlKV) blobKeys(ctx context.Context, opt ListOptions, yield func(string, error) bool) {"," \tquery := fmt.Sprintf(\"SELECT %s, %s, %s, %s, %s FROM %s\","," \t\tk.dialect.QuoteIdent(\"group\"), k.dialect.QuoteIdent(\"resource\"), k.dialect.QuoteIdent(\"namespace\"),"],"additions":72,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/kv_backend_options_test.go","lines":["@@ -130,6 +130,8 @@ func TestNewKVBackendOptionsValues(t *testing.T) {"," \tcfg.DashboardVersionsToKeep = 7"," \tcfg.EnableGarbageCollection = true"," \tcfg.GarbageCollectionDryRun = true","+\tcfg.BlobGarbageCollectionEnabled = true","+\tcfg.BlobGarbageCollectionDryRun = true"," \tcfg.GarbageCollectionInterval = 6 * time.Minute"," \tcfg.GarbageCollectionBatchSize = 8"," \tcfg.GarbageCollectionBatchWait = 7 * time.Minute","@@ -150,6 +152,8 @@ func TestNewKVBackendOptionsValues(t *testing.T) {"," \trequire.Equal(t, GarbageCollectionConfig{"," \t\tEnabled:          true,"," \t\tDryRun:           true,","+\t\tBlobEnabled:      true,","+\t\tBlobDryRun:       true,"," \t\tInterval:         6 * time.Minute,"," \t\tBatchSize:        8,"," \t\tBatchWait:        7 * time.Minute,"],"additions":4,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/resource/server.go","lines":["@@ -701,6 +701,14 @@ func NewUninitializedResourceServer(opts ResourceServerOptions) (*server, error)"," \t\treturn nil, err"," \t}"," ","+\tif b, ok := opts.Backend.(*kvStorageBackend); ok {","+\t\tif external, ok := blobstore.(*cdkBlobSupport); ok {","+\t\t\tb.blobGCMu.Lock()","+\t\t\tb.blobGC = NewBlobGarbageCollector(NewCDKBlobGCStore(external.bucket, external.root), b.garbageCollection.BatchSize, b.garbageCollection.BatchWait)","+\t\t\tb.blobGCMu.Unlock()","+\t\t}","+\t}","+"," \tlogger := log.New(\"resource-server\")","