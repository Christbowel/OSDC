 })","     }"," ","     fn unsupported_lines(&self) -> impl Iterator<Item = String> + '_ {","         let checks = &self.notices.checks;","-        let engines = checks.unsupported_engine","+        let engines = checks.unsupported.engine","             .iter()","             .flat_map(|((engine, current), by_range)| {","                 merge_ranges(by_range, current)","@@ -188,7 +242,7 @@ impl ReporterState {","                         (format!(\"{engine} {range}, not {current}\"), packages)","                     })","             });","-        let platforms = checks.unsupported_platform","+        let platforms = checks.unsupported.platform","             .iter()","             .map(|(requirement, packages)| (requirement.clone(), packages.clone()));","         engines","@@ -203,7 +257,7 @@ impl ReporterState {","             \"{} {} {noun} {verb} {requirement}: {}\",","             self.rendering.colors.red(\"✗\"),","             packages.len(),","-            list_names(packages, |label| self.package_label(label)),","+            list_names(packages.iter(), |label| self.package_label(label)),","         )","     }"," ","@@ -224,7 +278,7 @@ impl ReporterState {","         Some(format!(","             \"{cross} {} {noun} {verb} issues: {} {see}\",","             peers.len(),","-            list_names(peers, |name| self.rendering.colors.package_name(name)),","+            list_names(peers.iter(), |name| self.rendering.colors.package_name(name)),","         ))","     }"," ","@@ -240,7 +294,7 @@ impl ReporterState {","                 \"{} {} {noun} {verb}: {} {}\",","                 self.rendering.colors.grey(\"·\"),","                 outdated.len(),","-                list_names(&outdated, |name| self.rendering.colors.package_name(name)),","+                list_names(outdated.iter(), |name| self.rendering.colors.package_name(name)),","                 self.see(\"pnpm outdated\"),","             )","         })","@@ -351,15 +405,49 @@ fn platform_values(values: &[String]) -> String {","     format!(\"other than {}\", rejected.join(\" or \"))"," }"," ","+/// Whether the event can change a line of the checks footer.","+fn changes_checks(event: &LogEvent) -> bool {","+    matches!(","+        event,","+        LogEvent::Lifecycle(pnpm_reporter::LifecycleLog {","+            message: LifecycleMessage::Script { .. } | LifecycleMessage::Exit { .. },","+            ..","+        }) | LogEvent::SideEffectsCacheHit(_)","+            | LogEvent::SkippedOptionalDependency(_)","+            | LogEvent::Deprecation(_)","+            | LogEvent::InstallCheck(_)","+            | LogEvent::PeerDependencyIssues(_)","+            | LogEvent::LockfileVerification(_)","+            | LogEvent::Pnpm(_),","+    )","+}","+","+fn count_words<'a>(","+    items: &BTreeSet<String>,","+    one: (&'a str, &'a str),","+    many: (&'a str, &'a str),","+) -> (&'a str, &'a str) {","+    if items.len() == 1 { one } else { many }","+}","+","+/// Text from a manifest or the lockfile, on one line and without control","+/// characters.","+fn sanitize(text: &str) -> String {","+    pnpm_text_sanitize::sanitize_inline(text).into_owned()","+}","+"," /// At most [`MAX_LISTED`] names, each through `paint`, then a count of"," /// the rest.","-fn list_names(names: &BTreeSet<String>, paint: impl Fn(&str) -> String) -> String {","+fn list_names<'a>(","+    names: impl ExactSizeIterator<Item = &'a String>,","+    paint: impl Fn(&str) -> String,","+) -> String {","+    let total = names.len();","     let listed: Vec<String> = names","-        .iter()","         .take(MAX_LISTED)","         .map(|name| paint(name))","         .collect();","-    let rest = names.len() - listed.len();","+    let rest = total - listed.len();","     match listed.as_slice() {","         [] => String::new(),","         [only] => only.clone(),"],"additions":115,"deletions":27,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state/checks/scripts.rs","lines":["@@ -0,0 +1,350 @@","+//! The checks footer lines about the lifecycle scripts a command ran.","+","+use super::{","+    super::{","+        Output,","+        SideEffectsCacheHitLog,","+    },","+    BTreeMap,","+    BTreeSet,","+    ReporterState,","+    count_words,","+    list_names,","+    sanitize,","+};","+","+/// The lifecycle scripts a command summarizes, see","+/// [`LifecycleOptions::summarize_scripts`](crate::state::LifecycleOptions::summarize_scripts).","+#[derive(Default)]","+pub(super) struct ScriptsRun {","+    /// `<project> <stage>` of every project script that succeeded.","+    projects: Labels,","+    /// The project scripts running now, labeled like `projects`.","+    running_projects: Labels,","+    dependencies: DependencyBuilds,","+    /// `name@version` of every dependency whose build output came from","+    /// the side-effects cache.","+    cached: BTreeSet<String>,","+    /// `name@version` of every optional dependency skipped because its","+    /// build failed.","+    failed_optional: BTreeSet<String>,","+    /// The frame of the spinner the lines of running scripts show.","+    spinner: usize,","+}","+","+/// Display labels with how many entries carry each, kept up to date as","+/// entries come and go, so a redraw reads them without collecting.","+#[derive(Default)]","+struct Labels(BTreeMap<String, usize>);","+","+impl Labels {","+    fn add(&mut self, label: String) {","+        *self.0.entry(label).or_default() += 1;","+    }","+","+    fn remove(&mut self, label: &str) {","+        let Some(count) = self.0.get_mut(label) else { return };","+        *count -= 1;","+        if *count == 0 {","+            self.0.remove(label);","+        }","+    }","+","+    fn len(&self) -> usize {","+        self.0.len()","+    }","+","+    fn is_empty(&self) -> bool {","+        self.0.is_empty()","+    }","+","+    fn names(&self) -> impl ExactSizeIterator<Item = &String> {","+        self.0.keys()","+    }","+}","+","+/// The dependency builds of the command. Peer variants share a","+/// `name@version` label, and the hoisted linker builds each copy of a","+/// package in its own directory, so builds are kept by lockfile key and","+/// by directory, with their labels counted for display.","+#[derive(Default)]","+struct DependencyBuilds {","+    /// The label of every dependency whose scripts succeeded, by lockfile","+    /// key.","+    built: BTreeMap<String, String>,","+    built_labels: Labels,","+    /// The builds running now, by the directory their scripts run in.","+    building: BTreeMap<String, DependencyBuild>,","+    building_labels: Labels,","+    /// The lockfile key of every directory a build ran in, which is how","+    /// the skip event of a project-local build names it.","+    keys: BTreeMap<String, String>,","+}","+","+struct DependencyBuild {","+    label: String,","+    key: String,","+}","+","+impl DependencyBuilds {","+    fn start(&mut self, key: &str, dir: &str, label: String) {","+        self.keys.insert(dir.to_string(), key.to_string());","+        let build = DependencyBuild { label: label.clone(), key: key.to_string() };","+        if let Some(previous) = self.building.insert(dir.to_string(), build) {","+            self.building_labels.remove(&previous.label);","+        }","+        self.building_labels.add(label);","+    }","+","+    fn finish(&mut self, dir: &str) {","+        if let Some(build) = self.building.remove(dir) {","+            self.building_labels.remove(&build.label);","+        }","+    }","+","+    fn succeed(&mut self, key: &str, label: String) {","+        if let Some(previous) = self.built.insert(key.to_string(), label.clone()) {","+            self.built_labels.remove(&previous);","+        }","+        self.built_labels.add(label);","+    }","+","+    /// Drops the result and the running copies of the build `id` names:","+    /// its lockfile key, or the directory of one of its copies.","+    fn retract(&mut self, id: &str) {","+        let key = self.keys","+            .get(id)","+            .map(String::as_str)","+            .unwrap_or(id)","+            .to_string();","+        if let Some(label) = self.built.remove(&key) {","+            self.built_labels.remove(&label);","+        }","+        let building_labels = &mut self.building_labels;","+        self.building.retain(|_, build| {","+            let retracted = build.key == key;","+            if retracted {","+                building_labels.remove(&build.label);","+            }","+            !retracted","+        });","+    }","+}","+","+/// Whether a lifecycle script belongs to a workspace project or builds a","+/// dependency.","+#[derive(Clone, Copy)]","+pub(in crate::state) enum ScriptKind {","+    Project,","+    Dependency,","+}","+","+/// A lifecycle script as the footer tracks it while it runs.","+pub(in crate::state) struct RunningScript<'a> {","+    pub(in crate::state) kind: ScriptKind,","+    /// The lockfile key of a dependency, unused for a project script.","+    pub(in crate::state) id: &'a str,","+    /// The directory the script runs in.","+    pub(in crate::state) dir: &'a str,","+    /// `<project> <stage>`, or the dependency's `name@version`.","+    pub(in crate::state) label: &'a str,","+}","+","+/// The frames of the spinner, one per [`ReporterState::tick_scripts`].","+const SPINNER: [&str; 10] = [\"⠋\", \"⠙\", \"⠹\", \"⠸\", \"⠼\", \"⠴\", \"⠦\", \"⠧\", \"⠇\", \"⠏\"];","+","+/// The texts of one kind of script for [`ReporterState::script_line`].","+struct ScriptWords {","+    /// The noun for one and for several scripts.","+    noun: (&'static str, &'static str),","+    /// The verb of finished scripts, for one and for several.","+    finished: (&'static str, &'static str),","+    /// The verb of running scripts, for one and for several.","+    running: (&'static str, &'static str),","+}","+","+const PROJECT_SCRIPTS: ScriptWords = ScriptWords {","+    noun: (\"project script\", \"project scripts\"),","+    finished: (\"ran\", \"ran\"),","+    running: (\"is running\", \"are running\"),","+};","+","+const DEPENDENCY_BUILDS: ScriptWords = ScriptWords {","+    noun: (\"dependency\", \"dependencies\"),","+    finished: (\"was built\", \"were built\"),","+    running: (\"is building\", \"are building\"),","+};","+","+impl ReporterState {","+    pub(in crate::state) fn record_project_script(&mut self, label: &str) {","+        let projects = &mut self.notices.checks.scripts.projects;","+        let label = sanitize(label);","+        if !projects.0.contains_key(&label) {","+            projects.add(label);","+        }","+    }","+","+    pub(in crate::state) fn record_dependency_built(&mut self, script: &RunningScript<'_>) {","+        self.notices.checks.scripts.dependencies.succeed(script.id, sanitize(script.label));","+    }","+","+    pub(in crate::state) fn record_script_started(&mut self, script: &RunningScript<'_>) {","+        let scripts = &mut self.notices.checks.scripts;","+        match script.kind {","+            ScriptKind::Project => scripts.running_projects.add(sanitize(script.label)),","+            ScriptKind::Dependency => {","+                scripts.dependencies.start(script.id, script.dir, sanitize(script.label));","+            }","+        }","+    }","+","+    pub(in crate::state) fn record_script_finished(&mut self, script: &RunningScript<'_>) {","+        let scripts = &mut self.notices.checks.scripts;","+        match script.kind {","+            ScriptKind::Project => scripts.running_projects.remove(&sanitize(script.label)),","+            ScriptKind::Dependency => scripts.dependencies.finish(script.dir),","+        }","+    }","+","+    /// A skipped package is not built, even when one of its scripts or","+    /// copies succeeded before another failed, and none of its scripts runs"],"additions":210,"deletions":0,"truncated":false}],"additions":454,"deletions":56,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-24T20:29:04.691540+00:00"}