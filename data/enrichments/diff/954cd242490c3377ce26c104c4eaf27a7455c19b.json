fn summarize_scripts() {","+    let _ = SUMMARIZE_SCRIPTS.set(true);","+}","+","+pub(crate) fn lifecycle_options() -> LifecycleOptions {","+    LifecycleOptions {","+        stream_output: STREAM_LIFECYCLE_OUTPUT.get().is_some_and(|value| *value),","+        aggregate_output: AGGREGATE_OUTPUT.get().is_some_and(|value| *value),","+        hide_prefix: HIDE_LIFECYCLE_PREFIX.get().is_some_and(|value| *value),","+        summarize_scripts: SUMMARIZE_SCRIPTS.get().is_some_and(|value| *value),","+        ..Default::default()","+    }","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state.rs","lines":["@@ -55,6 +55,7 @@ use pnpm_reporter::{","     RemovedRoot,","     RequestRetryLog,","     ScopeLog,","+    SideEffectsCacheHitLog,","     SkippedOptionalDependencyLog,","     SkippedOptionalPackage,","     SkippedOptionalReason,","@@ -284,6 +285,9 @@ struct LifecycleState {","     /// Events withheld under [`LifecycleOptions::aggregate_output`], keyed","     /// the same way [`Self::entries`] is.","     buffers: HashMap<String, Vec<LifecycleMessage>>,","+    /// The `$ <script>` line of a summarized script, withheld until the","+    /// script prints or fails, keyed the same way [`Self::buffers`] is.","+    headers: HashMap<String, LifecycleMessage>,","     slots: HashMap<String, BlockSlot>,","     colors: HashMap<String, usize>,","     color_wheel: usize,","@@ -381,6 +385,7 @@ impl ReporterState {","             return Output::None;","         }","         self.handle_event(event);","+        self.refresh_live_checks(event);","         self.display.finish(self.options.append_only)","     }"," ","@@ -406,6 +411,7 @@ impl ReporterState {","             LogEvent::PendingSkills(log) => self.on_pending_skills(log),","             LogEvent::UpdateCheck(log) => self.on_update_check(log),","             LogEvent::SkippedOptionalDependency(log) => self.on_skipped_optional(log),","+            LogEvent::SideEffectsCacheHit(log) => self.