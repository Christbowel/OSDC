     checks.unsupported_engine","+                    checks.unsupported.engine","                         .entry((engine, sanitize(version.as_deref().unwrap_or_default())))","                         .or_default()","                         .entry(sanitize(range))","@@ -125,11 +143,41 @@ impl ReporterState {","         self.display.finish(self.options.append_only)","     }"," ","+    /// Redraws the live checks footer pinned below the progress while an","+    /// install summarizes its scripts. Only events that change the footer","+    /// redraw it. The final footer replaces it in [`Self::render_checks`].","+    pub(super) fn refresh_live_checks(&mut self, event: &LogEvent) {","+        if !self.options.lifecycle.summarize_scripts","+            || self.options.append_only","+            || self.notices.checks.rendered","+            || !changes_checks(event)","+        {","+            return;","+        }","+        self.redraw_live_checks();","+    }","+","+    fn redraw_live_checks(&mut self) {","+        let footer = self.checks_footer(CommandOutcome::Succeeded);","+        let mut slot = std::mem::take(&mut self.notices.checks.slot);","+        match footer {","+            Some(footer) => {","+                self.display.frame.emit(&mut slot, format!(\"\\n{footer}\"), BlockPlacement::Pinned);","+            }","+            None => self.display.frame.clear(&mut slot),","+        }","+        self.notices.checks.slot = slot;","+    }","+","     pub(super) fn render_checks(&mut self, outcome: CommandOutcome) {","         if self.notices.checks.rendered {","             return;","         }","-        let Some(footer) = self.checks_footer(outcome) else { return };","+        let Some(footer) = self.checks_footer(outcome) else {","+            self.notices.checks.rendered = true;","+            self.display.frame.clear(&mut self.notices.checks.slot);","+            return;","+        };","         self.notices.checks.rendered = true;","         let mut slot = 