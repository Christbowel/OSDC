{"id":"954cd242490c3377ce26c104c4eaf27a7455c19b","axis":"silent","repo":"pnpm/pnpm","sha":"954cd242490c3377ce26c104c4eaf27a7455c19b","parsed":{"files":[{"path":".changeset/summarize-install-scripts.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pnpm\": minor","+---","+","+An install lists the lifecycle scripts it ran in the checks footer above `Done in`. One line names the project scripts that ran, one the dependencies that were built, and one the dependency builds that came from the side-effects cache. A dependency that was skipped because its optional build failed is listed as a problem.","+","+In a terminal, the footer is shown live below the progress while the install runs. While scripts run, their line shows a spinner and names the running scripts. A script that fails prints its output, as before. In CI and piped output, a script that succeeds without printing anything no longer prints any lines."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -550,6 +550,28 @@ impl CliCommand {","     }"," ","     /// See [`pnpm_default_reporter::set_edits_manifests`].","+    /// Whether the command installs dependencies, so its lifecycle scripts","+    /// are summarized in the checks footer.","+    pub(crate) fn summarizes_scripts(&self) -> bool {","+        matches!(","+            self,","+            CliCommand::Install(_)","+                | CliCommand::Add(_)","+                | CliCommand::Update(_)","+                | CliCommand::Remove(_)","+                | CliCommand::Rebuild(_)","+                | CliCommand::Rb(_)","+                | CliCommand::Link(_)","+                | CliCommand::Unlink(_)","+                | CliCommand::Prune(_)","+                | CliCommand::Dedupe(_)","+                | CliCommand::Import(_)","+                | CliCommand::Fetch(_)","+                | CliCommand::Ci(_)","+                | CliCommand::Deploy(_),","+        )","+    }","+","     pub(crate) fn edits_manifests(&self) -> bool {","         matches!(self, CliCommand::Add(_) | CliCommand::Remove(_) | CliCommand::Update(_))","     }"],"additions":22,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch.rs","lines":["@@ -138,6 +138,7 @@ impl CliArgs {","                 stream_output: self.output.lifecycle.stream,","                 aggregate_output: self.output.lifecycle.aggregate_output,","                 hide_prefix: self.output.lifecycle.hide_prefix,","+                summarize_scripts: self.command.summarizes_scripts(),","             },","         });","         configure_max_log_level(self.output.presentation.loglevel);"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/configuration.rs","lines":["@@ -480,6 +480,7 @@ impl CliArgs {","                 stream_output: cfg.stream,","                 aggregate_output: cfg.aggregate_output,","                 hide_prefix: cfg.reporter_hide_prefix.unwrap_or(false),","+                summarize_scripts: self.command.summarizes_scripts(),","             },","         });","     }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/reporter.rs","lines":["@@ -314,6 +314,7 @@ pub(crate) struct LifecycleReporterSetup {","     pub(crate) stream_output: bool,","     pub(crate) aggregate_output: bool,","     pub(crate) hide_prefix: bool,","+    pub(crate) summarize_scripts: bool,"," }"," "," /// Seed the process-global default-reporter state that can't be recovered","@@ -333,6 +334,9 @@ pub(crate) fn configure_default_reporter(setup: &DefaultReporterSetup<'_>) {","     if setup.lifecycle.hide_prefix {","         pnpm_default_reporter::hide_lifecycle_prefix();","     }","+    if setup.lifecycle.summarize_scripts {","+        pnpm_default_reporter::summarize_scripts();","+    }","     pnpm_default_reporter::set_summary_scope(setup.summary_scope);","     pnpm_default_reporter::set_reports_scope(setup.reports_scope