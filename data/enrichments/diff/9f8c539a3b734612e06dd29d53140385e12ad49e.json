 are surfaced by the next","         ``get_finished_jobs()`` call."," ","-        A load already failed with a deferred release stays pending until","-        its AbortAck, or until a missed AbortAck disconnects the session and","-        the reap's close() sets the event, so every event is set on return.","+        Inbound loads are aborted up front rather than waited out: a peer","+        that never writes would otherwise block the reset for the full load","+        timeout. Each is failed at once with a deferred release and stays","+        pending until its AbortAck, or until a missed AbortAck disconnects","+        the session and the reap's close() sets the event, so every event","+        is set on return.","         \"\"\"","         start = time.monotonic()","         self._reap_unbound_stores(force=True)","         self._kv_to_session.clear()","         for session in self._sessions.values():","             self._drain_session_stores(session)","+            session.abort_loads()"," ","         warned = False","         while True:"],"additions":7,"deletions":3,"truncated":false},{"path":"vllm/v1/kv_offload/tiering/p2p/session/client.py","lines":["@@ -217,6 +217,19 @@ def _abort_load(","             )","         )"," ","+    def abort_loads(self) -> None:","+        \"\"\"Abort every load not already aborting, for a cache reset.","+","+        Each is reported failed at once with its release deferred, so a","+        drain waits only for the AbortAcks (or the abort-ack timeout's","+        disconnect) instead of the full load timeout. Lookup state is","+        left alone.","+        \"\"\"","+        for req_id in self._active_loads:","+            for round_seq, load in self._requests[req_id].loads.items():","+                if load.aborted_at is None:","+                    self._abort_load(req_id, round_seq, load)","+","     @property","     def has_active_loads(self) -> bool:","         \"\"\"True if any kv_request_id has a fetch in flight.\"\"\""],"