 := false","+\t\t\t\t\t\t\tsql.Bus().AddEventListener(func(context.Context, *creatorRefreshFollowingEvent) error {","+\t\t\t\t\t\t\t\tfollowingEvent = true","+\t\t\t\t\t\t\t\treturn nil","+\t\t\t\t\t\t\t})","+\t\t\t\t\t\t\tcfg := setting.NewCfg()","+\t\t\t\t\t\t\tcfg.RBAC.PermissionCache = true","+\t\t\t\t\t\t\tfeatures := featuremgmt.WithFeatures()","+\t\t\t\t\t\t\tactions := resourcepermissions.NewActionSetService()","+\t\t\t\t\t\t\tcache := localcache.New(0, 0)","+\t\t\t\t\t\t\tlicense := &licensing.OSSLicensingService{}","+\t\t\t\t\t\t\tcatalog := legacypermissions.NewRoleCatalog()","+\t\t\t\t\t\t\tclient := legacypermissions.NewEmbeddedClient(legacypermissions.NewLoader(sql, catalog, actions, cache, cfg, features, license, nil), cfg)","+\t\t\t\t\t\t\tvar store accesscontrol.Store = database.ProvideService(sql)","+\t\t\t\t\t\t\tif legacy {","+\t\t\t\t\t\t\t\tstore = actest.FakeStore{ExpectedErr: errors.New(\"local enumeration must not run\")}","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tac := acimpl.ProvideOSSService(cfg, store, actions, cache, features,","+\t\t\t\t\t\t\t\ttracing.InitializeTracerForTest(), sql, permreg.ProvidePermissionRegistry(), nil, iam.Features{}, client, catalog)","+\t\t\t\t\t\t\trequester := &user.SignedInUser{UserID: 1, UserUID: \"creator\", OrgID: 1, OrgRole: org.RoleViewer, IsServiceAccount: serviceAccount}","+\t\t\t\t\t\t\tfailure := errors.New(\"failed\")","+\t\t\t\t\t\t\trecorder := &creatorPermissionRecorder{Service: ac, t: t}","+\t\t\t\t\t\t\tif outcome == \"refresh failure\" {","+\t\t\t\t\t\t\t\trecorder.refreshErr = failure","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tusers := &usertest.FakeUserService{ExpectedSignedInUser: requester}","+\t\t\t\t\t\t\tif outcome == \"permission failure\" {","+\t\t\t\t\t\t\t\tusers.ExpectedError = failure","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tvar setDefaults func(context.Context)","+\t\t\t\t\t\t\tgrant := accesscontrol.Permission{Action: accesscontrol.ActionAlertingReceiversReadSecrets, Scope: \"receivers:uid:new\"}","+\t\t\t\t\t\t\tif resource == \"receiver\" {","+\t\t\t\t\t\t\t\tsvc, err := ProvideReceiverPermissionsService(cfg, features, routing.NewRouteRegister(), sql,","+\t\t\t\t\t\t\t\t\tactest.FakeAccessControl{ExpectedEvaluate: true}, iam.Features{}, license, recorder, nil, users, nil, actions)","+\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t\tsetDefaults = func(ctx context.Context) { svc.SetDefaultPermissions(ctx, 1, requester, \"new\") }","+\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\tsvc, err := ProvideRoutePermissionsService(cfg, features, routing.NewRouteRegister(), sql,","+\t\t\t\t\t\t\t\t\tactest.FakeAccessControl{ExpectedEvaluate: true}, iam.Features{}, license, recorder, nil, users, nil, actions)","+\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t\tsetDefaults = func(ctx context.Context) {","+\t\t\t\t\t\t\t\t\terr := svc.SetDefaultPermissions(ctx, 1, requester, \"new\")","+\t\t\t\t\t\t\t\t\tif outcome == \"permission failure\" {","+\t\t\t\t\t\t\t\t\t\trequire.ErrorIs(t, err, failure)","+\t\t\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t\tgrant = accesscontrol.Permission{Action: accesscontrol.ActionAlertingRoutesPermissionsWrite, Scope: accesscontrol.AlertingNotificationsApiGroup + \"/\" + accesscontrol.AlertingRoutesResource + \":uid:new\"}","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t// Populate both identity cache keys before the write.","+\t\t\t\t\t\t\tfor _, sa := range []bool{false, true} {","+\t\t\t\t\t\t\t\tactor := *requester","+\t\t\t\t\t\t\t\tactor.IsServiceAccount = sa","+\t\t\t\t\t\t\t\tpermissions, err := ac.GetUserPermissions(ctx, &actor, accesscontrol.Options{})","+\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t\trequire.NotContains(t, permissions, grant)","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tvar err error","+\t\t\t\t\t\t\tif outcome == \"standalone\" {","+\t\t\t\t\t\t\t\tsetDefaults(ctx)","+\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\terr = sql.InTransaction(ctx, func(txCtx context.Context) error {","+\t\t\t\t\t\t\t\t\trequire.NoError(t, sql.InTransaction(context.WithValue(txCtx, creatorContextKey{}, \"inner\"), func(ctx context.Context) error {","+\t\t\t\t\t\t\t\t\t\tsetDefaults(ctx)","+\t\t\t\t\t\t\t\t\t\tsqlstore.SessionFromContext(ctx).PublishAfterCommit(&creatorRefreshFollowingEvent{})","+\t\t\t\t\t\t\t\t\t\treturn nil","+\t\t\t\t\t\t\t\t\t}))","+\t\t\t\t\t\t\t\t\trequire.Empty(t, recorder.calls, \"no cache operations before the outermost commit\")","+\t\t\t\t\t\t\t\t\t// A parallel request still sees the old cache before commit.","+\t\t\t\t\t\t\t\t\tpermissions, err := ac.GetUserPermissions(ctx, requester, accesscontrol.Options{})","+\t\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t\t\trequire.NotContains(t, permissions, grant)","+\t\t\t\t\t\t\t\t\tif outcome == \"rollback\" {","+\t\t\t\t\t\t\t\t\t\treturn failure","+\t\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t\t\tif outcome == \"commit failure\" {","+\t\t\t\t\t\t\t\t\t\ttx, err := sqlstore.SessionFromContext(txCtx).Tx()","+\t\t\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t\t\t\trequire.NoError(t, tx.Rollback())","+\t\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t\t\treturn nil","+\t\t\t\t\t\t\t\t})","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tcommitted := outcome != \"rollback\" && outcome != \"commit failure\"","+\t\t\t\t\t\t\trequire.Equal(t, committed && outcome != \"standalone\", followingEvent, \"refresh failure must not stop later events\")","+\t\t\t\t\t\t\tif committed {","+\t\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\trequire.Error(t, err)","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tif committed && outcome != \"permission failure\" {","+\t\t\t\t\t\t\t\trequire.Equal(t, []string{\"clear user\", \"clear service account\", \"refresh\"}, recorder.calls)","+\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\trequire.Empty(t, recorder.calls)","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tpermissions, err := ac.GetUserPermissions(ctx, requester, accesscontrol.Options{ReloadCache: outcome == \"refresh failure\"})","+\t\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\t\tif committed && outcome != \"permission failure\" {","+\t\t\t\t\t\t\t\trequire.Contains(t, permissions, grant)","+\t\t\t\t\t\t\t} else {","+\t\t\t\t\t\t\t\trequire.NotContains(t, permissions, grant)","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t})","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+type creatorContextKey struct{}","+type creatorRefreshFollowingEvent struct{}","+","+type creatorPermissionRecorder struct {","+\taccesscontrol.Service","+\tt          *testing.T","+\tcalls      []string","+\trefreshErr error","+}","+","+func (r *creatorPermissionRecorder) ClearUserPermissionCache(requester identity.Requester) {","+\tname := \"clear user\"","+\tif requester.IsIdentityType(claims.TypeServiceAccount) {","+\t\tname = \"clear service account\"","+\t}","+\tr.calls = append(r.calls, name)","+\tr.Service.ClearUserPermissionCache(requester)","+}","+","+func (r *creatorPermissionRecorder) GetUserPermissions(ctx context.Context, requester identity.Requester, options accesscontrol.Options) ([]accesscontrol.Permission, error) {","+\trequire.False(r.t, sqlstore.IsInTransaction(ctx))","+\trequire.True(r.t, options.ReloadCache)","+\trequire.Equal(r.t, \"owner\", ctx.Value(creatorContextKey{}))","+\tr.calls = append(r.calls, \"refresh\")","+\tif r.refreshErr != nil {","+\t\treturn nil, r.refreshErr","+\t}","+\treturn r.Service.GetUserPermissions(ctx, requester, options)","+}"],"additions":200,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/ossaccesscontrol/folder.go","lines":["@@ -9,7 +9,6 @@ import ("," \t\"github.com/grafana/grafana/pkg/api/routing\""," \t\"github.com/grafana/grafana/pkg/apimachinery/errutil\""," \t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","-\t\"github.com/grafana/grafana/pkg/infra/db\""," \tiamapi \"github.com/grafana/grafana/pkg/registry/apis/iam\""," \t\"github.com/grafana/grafana/pkg/s