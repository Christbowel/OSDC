afana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/sqlstore\"","+\t\"github.com/grafana/grafana/pkg/services/user\"","+)","+","+func TestRefreshCreatorTransactionGuard(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname      string","+\t\tsession   any","+\t\twantCalls int","+\t}{","+\t\t{name: \"no session\", wantCalls: 1},","+\t\t{name: \"typed nil\", session: (*sqlstore.DBSession)(nil), wantCalls: 1},","+\t\t{name: \"unrelated value\", session: \"not a session\", wantCalls: 1},","+\t\t{name: \"active session\", session: &sqlstore.DBSession{}, wantCalls: 0},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tctx := t.Context()","+\t\t\tif tc.session != nil {","+\t\t\t\tctx = context.WithValue(ctx, sqlstore.ContextSessionKey{}, tc.session)","+\t\t\t}","+\t\t\tcalls := 0","+\t\t\tservice := refreshService{get: func(context.Context, identity.Requester, accesscontrol.Options) ([]accesscontrol.Permission, error) {","+\t\t\t\tcalls++","+\t\t\t\treturn nil, nil","+\t\t\t}}","+\t\t\tRefreshCreator(ctx, service, &user.SignedInUser{UserID: 7, OrgID: 1})","+\t\t\trequire.Equal(t, tc.wantCalls, calls)","+\t\t})","+\t}","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/permissioncache/refresh_test.go","lines":["@@ -0,0 +1,89 @@","+package permissioncache","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+\t\"time\"","+","+\tclaims \"github.com/grafana/authlib/types\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/otel/codes\"","+\ttracesdk \"go.opentelemetry.io/otel/sdk/trace\"","+\t\"go.opentelemetry.io/otel/sdk/trace/tracetest\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/sqlstore\"","+\t\"github.com/grafana/grafana/pkg/services/user\"","+)","+","+func TestRefreshCreator(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname      string","+\t\trequester identity.Requester","+\t\tcancel    bool","+\t\terr       error","+\t}{","+\t\t{name: \"user\", requester: &user.SignedInUser{UserID: 7, OrgID: 1}},","+\t\t{name: \"service account\", requester: &user.SignedInUser{UserID: 7, OrgID: 1, IsServiceAccount: true}},","+\t\t{name: \"failure\", requester: &user.SignedInUser{UserID: 7, OrgID: 1}, err: errors.New(\"AuthZ unavailable\")},","+\t\t{name: \"cancellation\", requester: &user.SignedInUser{UserID: 7, OrgID: 1}, cancel: true},","+\t\t{name: \"nil requester\"},","+\t\t{name: \"anonymous\", requester: &identity.StaticRequester{Type: claims.TypeAnonymous}},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\ttype requestKey struct{}","+\t\t\tctx := context.WithValue(t.Context(), requestKey{}, \"metadata\")","+\t\t\tspans := tracetest.NewSpanRecorder()","+\t\t\tprovider := tracesdk.NewTracerProvider(tracesdk.WithSpanProcessor(spans))","+\t\t\tt.Cleanup(func() { require.NoError(t, provider.Shutdown(context.Background())) })","+\t\t\tctx, parent := provider.Tracer(\"test\").Start(ctx, \"create\")","+\t\t\tdefer parent.End()","+\t\t\tvar deadline time.Time","+\t\t\tif tc.cancel {","+\t\t\t\tvar cancel context.CancelFunc","+\t\t\t\tctx, cancel = context.WithTimeout(ctx, time.Second)","+\t\t\t\tdeadline, _ = ctx.Deadline()","+\t\t\t\tcancel()","+\t\t\t}","+\t\t\tcalls := 0","+\t\t\tservice := refreshService{get: func(ctx context.Context, requester identity.Requester, options accesscontrol.Options) ([]accesscontrol.Permission, error) {","+\t\t\t\tcalls++","+\t\t\t\trequire.Same(t, tc.requester, requester)","+\t\t\t\trequire.True(t, options.ReloadCache)","+\t\t\t\trequire.False(t, sqlstore.IsInTransaction(ctx))","+\t\t\t\trequire.Equal(t, \"metadata\", ctx.Value(requestKey{}))","+\t\t\t\tgot, ok := ctx.Deadline()","+\t\t\t\trequire.True(t, ok)","+\t\t\t\tif tc.cancel {","+\t\t\t\t\trequire.ErrorIs(t, ctx.Err(), context.Canceled)","+\t\t\t\t\trequire.Equal(t, deadline, got)","+\t\t\t\t} else {","+\t\t\t\t\trequire.WithinDuration(t, time.Now().Add(5*time.Second), got, time.Second)","+\t\t\t\t}","+\t\t\t\treturn nil, tc.err","+\t\t\t}}","+\t\t\tRefreshCreator(ctx, service, tc.requester)","+\t\t\tif tc.requester == nil || tc.name == \"anonymous\" {","+\t\t\t\trequire.Zero(t, calls)","+\t\t\t\trequire.Empty(t, spans.Ended())","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.Equal(t, 1, calls)","+\t\t\trequire.Len(t, spans.Ended(), 1)","+\t\t\tif tc.err != nil {","+\t\t\t\trequire.Equal(t, codes.Error, spans.Ended()[0].Status().Code)","+\t\t\t}","+\t\t})","+\t}","+}","+","+type refreshService struct {","+\taccesscontrol.Service","+\tget func(context.Context, identity.Requester, accesscontrol.Options) ([]accesscontrol.Permission, error)","+}","+","+func (s refreshService) GetUserPermissions(ctx context.Context, requester identity.Requester, options accesscontrol.Options) ([]accesscontrol.Permission, error) {","+\treturn s.get(ctx, requester, options)","+}"],"additions":89,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/resourcepermissions/cache_test.go","lines":["@@ -0,0 +1,114 @@","+package resourcepermissions","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/featuremgmt\"","+\t\"github.com/grafana/grafana/pkg/services/sqlstore\"","+\t\"github.com/grafana/grafana/pkg/services/user\"","+\t\"github.com/grafana/grafana/pkg/services/user/usertest\"","+\t\"github.com/grafana/grafana/pkg/util/testutil\"","+)","+","+func TestIntegrationPermissionCacheInvalidationAfterCommit(t *testing.T) {","+\ttestutil.SkipIntegrationTestInShortMode(t)","+\tfor _, bulk := range []bool{false, true} {","+\t\tfor _, outcome := range []string{\"commi