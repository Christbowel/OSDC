 for `Result<T, E>`"," "," error[E0277]: the trait bound `Result<(), BadType>: IntoJsResult` is not satisfied","   --> ui-tests/async-errors.rs:55:24","@@ -14,27 +12,24 @@ error[E0277]: the trait bound `Result<(), BadType>: IntoJsResult` is not satisfi"," 55 | pub async fn bad2() -> Result<(), BadType> {","    |                        ^^^^^^^^^^^^^^^^^^^ the trait `IntoJsResult` is not implemented for `Result<(), BadType>`","    |","-   = help: the following other types implement trait `IntoJsResult`:","-             Result<(), E>","-             Result<T, E>","+   = help: the trait `IntoJsResult` is implemented for `Result<T, E>`"," ","-error[E0277]: the trait bound `wasm_bindgen::JsValue: From<BadType>` is not satisfied","+error[E0277]: the trait bound `BadType: IntoJsResult` is not satisfied","   --> ui-tests/async-errors.rs:59:24","    |"," 59 | pub async fn bad3() -> BadType {","-   |                        ^^^^^^^ the trait `From<BadType>` is not implemented for `wasm_bindgen::JsValue`","-   |","-   = help: the following other types implement trait `From<T>`:","-             `wasm_bindgen::JsValue` implements `From<&String>`","-             `wasm_bindgen::JsValue` implements `From<&T>`","-             `wasm_bindgen::JsValue` implements `From<&str>`","-             `wasm_bindgen::JsValue` implements `From<*const T>`","-             `wasm_bindgen::JsValue` implements `From<*mut T>`","-             `wasm_bindgen::JsValue` implements `From<AggregateError>`","-             `wasm_bindgen::JsValue` implements `From<Array<T>>`","-             `wasm_bindgen::JsValue` implements `From<ArrayBuffer>`","+   |                        ^^^^^^^ the trait `IntoWasmAbi` is not implemented for `BadType`","+   |","+   = help: the following other types implement trait `IntoWasmAbi`:","+             &&Box<str>","+             &&Cow<'_, str>","+             &&String","+             &&str","+             &'__wbg_ref AggregateError","+             &'__wbg_ref Array<T>","+             &'__wbg_ref ArrayBuffer","+             &'__wbg_ref ArrayBufferOptions","            and $N others","-   = note: required for `BadType` to implement `Into<wasm_bindgen::JsValue>`","    = note: required for `BadType` to implement `IntoJsResult`"," "," error[E0277]: the trait bound `Result<BadType, wasm_bindgen::JsValue>: IntoJsResult` is not satisfied","@@ -43,6 +38,4 @@ error[E0277]: the trait bound `Result<BadType, wasm_bindgen::JsValue>: IntoJsRes"," 63 | pub async fn bad4() -> Result<BadType, JsValue> {","    |                        ^^^^^^^^^^^^^^^^^^^^^^^^ the trait `IntoJsResult` is not implemented for `Result<BadType, wasm_bindgen::JsValue>`","    |","-   = help: the following other types implement trait `IntoJsResult`:","-             Result<(), E>","-             Result<T, E>","+   = help: the trait `IntoJsResult` is implemented for `Result<T, E>`"],"additions":15,"deletions":22,"truncated":false},{"path":"guide/src/reference/js-promises-and-rust-futures.md","lines":["@@ -152,25 +152,20 @@ async function shim() {"," "," ## Return values of `async fn`"," ","-When using an `async fn` in Rust and exporting it to JS there are some","-restrictions on the return type. The return value of an exported Rust function","-will eventually become `Result<JsValue, JsValue>` where `Ok` turns into a","-successfully resolved promise and `Err` is equivalent to throwing an exception.","+An exported `async fn` accepts the same return types as a sync export. The","+resolved value converts exactly as a sync return of the same type would, and","+an `Err` rejects the promise the way a sync export's `Err` throws:"," ","-The following types are supported as return types from an `async fn`:","-","-* `()` — turns into a successful `undefined` in JS","-* `T: Into<JsValue>` — turns into a successful JS value","-* `Result<(), E: Into<JsValue>>` — `Ok(())` resolves to `undefined`; `Err`","+* `T: IntoWasmAbi` — resolves with `T` converted as a sync return, so `()`","+  resolves to `undefined`","+* `Result<T: IntoWasmAbi, E: Into<JsValue>>` — `Ok` resolves as above; `Err`","   rejects with `E` converted to a JS value","-* `Result<T: Into<JsValue>, E: Into<JsValue>>` — both payloads are converted","-  into a `JsValue`","-","-Note that many types implement being converted into a `JsValue`, such as all","-imported types via `#[wasm_bindgen]` (aka those in `js-sys` or `web-sys`),","-primitives like `u32`, and all exported `#[wasm_bindgen]` types. In general,","-you should be able to write code without having too many explicit conversions,","-and the macro should take care of the rest!","+","+Every type a sync export can return implements `IntoWasmAbi`, including","+imported JS types (such as those in `js-sys` or `web-sys`), primitives,","+strings, vectors and exported `#[wasm_bindgen]` types. A type that only","+implements `From<T> for JsValue` can be resolved by returning","+`JsValue::from(value)`."," "," The arguments of an exported `async fn` are converted when JS calls it, before"," its future first runs. An argument Rust rejects, such as an invalid enum value,"],"additions":12,"deletions":17,"truncated":false},{"path":"src/rt/mod.rs","lines":["@@ -1019,31 +1019,18 @@ pub trait IntoJsResult {","     fn into_js_result(self) -> Result<JsValue, JsValue>;"," }"," ","-impl IntoJsResult for () {","+// The resolved value crosses exactly as a sync return of `T` would, while","+// the rejection coerces through `Into<JsValue>` like a sync `Result` throw.","+impl<T: IntoWasmAbi> IntoJsResult for T {","     fn into_js_result(self) -> Result<JsValue, JsValue> {","-        Ok(JsValue::undefined())","+        Ok(wbg_cast(self))","     }"," }"," ","-impl<T: Into<JsValue>> IntoJsResult for T {","-    fn into_js_result(self) -> Result<JsValue, JsValue> {","-        Ok(self.into())","-    }","-}","-","-impl<T: Into<JsValue>, E: Into<JsValue>> IntoJsResult for Result<T, E> {","-    fn into_js_result(self) -> Result<JsValue, JsValue> {","-        match self {","-            Ok(e) => Ok(e.into()),","-            Err(e) => Err(e.into()),","-        }","-    }","-}","-","-impl<E: Into<JsValue>> IntoJsResult for Result<(), E> {","+impl<T: IntoWasmAbi, E: Into<JsValue>> IntoJsResult for Result<T, E> {","     fn into_js_result(self) -> Result<JsValue, JsValue> {","         match self {","-            Ok(()) => Ok(JsValue::undefined()),","+            Ok(v) => Ok(wbg_cast(v)),","             Err(e) => Err(e.into()),","         }","     }"],"additions":6,"deletions":19,"truncated":false},{"path":"tests/wasm/async_abi_returns.js","lines":["@@ -0,0 +1,16 @@","+const wasm = require('wasm-bindgen-test.js');","+const assert = require('assert');","+","+exports.js_async_abi_returns = async () => {","+    assert.strictEqual(await wasm.async_char(), 'é');","+    assert.strictEqual(await wasm.async_option_char(true), 'x');","+    assert.strictEqual(await wasm.async_option_char(false), undefined);","+    assert.strictEqual(await wasm.async_nullable(true), 7);","+    assert.strictEqual(await wasm.async_nullable(false), null);","+    assert.strictEqual(await wasm.async_result_char(true), 'y');","+    await assert.rejects(wasm.async_result_char(false), /no char/);","+    assert.strictEqual(await wasm.async_into_only_error(true), 3);","+    await assert.rejects(wasm.async_into_only_error(false), e => e === 'into only');","+    assert.strictEqual(await wasm.async_unit_error(true), undefined);","+    await assert.rejects(wasm.async_unit_error(false), e => e === 'unit');","+};"],"additions":16,"deletions":0,"truncated":false},{"path":"tests/wasm/async_abi_returns.rs","lines":["@@ -0,0 +1,66 @@","+use wasm_bindgen::prelude::*;","+use wasm_bindgen_test::*;","+","+#[wasm_bindgen(module = \"tests/wasm/async_abi_returns.js\")]","+extern \"C\" {","+    async fn js_async_abi_returns();","+}","+","+#[wasm_bindgen]","+pub async fn async_char() -> char {","+    'é'","+}","+","+#[wasm_bindgen]","+pub async fn async_option_char(some: bool) -> Option<char> {","+    some.then_some('x')","+}","+","+#[wasm_bindgen]","+pub async fn async_nullable(some: bool) -> Nullable<u32> {","+    if some {","+        Nullable::Value(7)","+    } else {","+        Nullable::Null","+    }","+}","+","+#[wasm_bindgen]","+pub async fn async_result_char(ok: bool) -> Result<char, JsError> {","+    if ok {","+        Ok('y')","+    } else {","+        Err(JsError::new(\"no char\"))","+    }","+}","+","+pub struct IntoOnlyError(&'static str);","+","+impl From<IntoOnlyError> for JsValue {","+    fn from(e: IntoOnlyError) -> JsValue {","+        JsValue::from_str(e.0)","+    }","+}","+","+#[wasm_bindgen]","+pub async fn async_into_only_error(ok: bool) -> Result<u32, IntoOnlyError> {","+    if ok {","+        Ok(3)","+    } else {","+        Err(IntoOnlyError(\"into only\"))","+    }","+}","+","+#[wasm_bindgen]","+pub async fn async_unit_error(ok: bool) -> Result<(), IntoOnlyError> {","+    if ok {","+        Ok(())","+    } else {","+        Err(IntoOnlyError(\"unit\"))","+    }","+}","+","+#[wasm_bindgen_test]","+async fn works() {","+    js_async_abi_returns().await;","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"tests/wasm/main.rs","lines":["@@ -23,6 +23,7 @@ pub mod _3944;"," pub mod api;"," pub mod arg_leaks;"," pub mod arg_names;","+pub mod async_abi_returns;"," pub mod async_import;"," pub mod async_vecs;"," pub mod bigint;",""],"additions":1,"deletions":0,"truncated":false}],"additions":211,"deletions":109,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-11-05T16:29:42.359139+00:00"}