ery key)","-          pure (keyRecv *> queryRecv)","+          -- Run both recv actions and combine their Either results on the","+          -- inner Either monad (Left-biased): a Parse-time ServerError on","+          -- keyRecv wins over the Execute's PGRES_PIPELINE_ABORTED sentinel","+          -- on queryRecv. So we capture the original error in the pipeline","+          -- instead of subsequent PGRES_PIPELINE_ABORTED errors masking it.","+          pure (liftA2 (*>) keyRecv queryRecv)","           where","             (oidList, valueAndFormatList) =","               Encoders.Params.compilePreparedStatementData encoder integerDatetimes params","@@ -172,11 +177,21 @@ statement params (Statement.Statement sql (Encoders.Params encoder) (Decoders.Re","                     else","                       (False,) . Left . commandToSessionError . ClientError <$> Pq.errorMessage connection","                   where","-                    recv =","-                      fmap (first commandToSessionError)","-                        $ (<*)","-                        <$> Decoders.Results.run (Decoders.Results.single Decoders.Result.noResult) connection integerDatetimes","-                        <*> Decoders.Results.run Decoders.Results.dropRemainders connection integerDatetimes","+                    -- The key was registered at send time, but the server","+                    -- only creates the statement if this Parse succeeds. If","+                    -- it fails, or is skipped because an earlier statement","+                    -- aborted the pipeline (PGRES_PIPELINE_ABORTED), drop","+                    -- the key so later uses re-prepare it instead of hitting","+                    -- \"prepared statement does not exist\".","+                    recv = do","+                      result <-","+                        fmap (first commandToSessionError)","+                          $ (<*)","+                          <$> Decoders.Results.run (Decoders.Results.single Decoders.Result.noResult) connection integerDatetimes","+                          <*> Decoders.Results.run Decoders.Results.dropRemainders connection integerDatetimes","+                      when (isLeft result)","+                        $ PreparedStatementRegistry.delete localKey registry","+                      pure result","                 onOldRemoteKey key =","                   pure (Right (key, pure (Right ())))"," "],"additions":21,"deletions":6,"truncated":false},{"path":"src/hasql/Hasql/PreparedStatementRegistry.hs","lines":["@@ -2,6 +2,7 @@ module Hasql.PreparedStatementRegistry","   ( PreparedStatementRegistry","   , new","   , update","+  , delete","   , reset","   , LocalKey (..)","   )","@@ -10,7 +11,7 @@ where"," import ByteString.StrictBuilder qualified as B"," import Data.HashTable.IO qualified as A"," ","-import Hasql.Prelude hiding (lookup, reset)","+import Hasql.Prelude hiding (delete, lookup, reset)"," "," import Hasql.LibPq14 qualified as Pq"," ","@@ -45,6 +46,14 @@ update localKey onNewRemoteKey onOldRemoteKey (PreparedStatementRegistry table c","     old =","       onOldRemoteKey"," ","+-- |","+-- Forget a local key, so that the next use re-prepares it under a fresh","+-- remote key. Used when the server never actually created the statement,","+-- e.g. its Parse was skipped because an earlier pipeline statement failed.","+delete :: LocalKey -> PreparedStatementRegistry -> IO ()","+delete localKey (PreparedStatementRegistry table _) =","+  A.delete table localKey","+"," reset :: PreparedStatementRegistry -> IO ()"," reset (PreparedStatementRegistry table counter) = do","   -- TODO: This is a temporary measure."],"additions":10,"deletions":1,"truncated":false},{"path":"src/hasql/Hasql/StatementRunner.hs","lines":["@@ -0,0 +1,24 @@","+module Hasql.StatementRunner","+  ( StatementRunner (..)","+  )","+where","+","+import Hasql.Pipeline (Pipeline)","+import Hasql.Prelude","+import Hasql.Session (Session)","+import Hasql.Statement (Statement)","+","+import Hasql.Pipeline qualified as Pipeline","+import Hasql.Session qualified as Session","+","+-- | Statement transport. A 'Session' sends one statement and waits for its","+-- result before sending the next. 'Pipeline' sends them all and reads all the","+-- results back with one round trip. No result can be seen mid-batch.","+class (Applicative t) => StatementRunner t where","+  runStatement :: Statement () a -> t a","+","+instance StatementRunner Session where","+  runStatement = Session.statement ()","+","+instance StatementRunner Pipeline where","+  runStatement = Pipeline.statement ()"],"additions":24,"deletions":0,"truncated":false},{"path":"src/hasql/Hasql/Transaction.hs","lines":["@@ -3,7 +3,6 @@"," module Hasql.Transaction","   ( -- * Transaction monad","     Transaction","-  , condemn","   , sql","   , statement","   )"],"additions":0,"deletions":1,"truncated":false},{"path":"src/hasql/Hasql/Transaction/Private/Transaction.hs","lines":["@@ -39,10 +39,3 @@ sql ="," statement :: a -> A.Statement a b -> Transaction b"," statement params statement' =","   Transaction . lift $ B.statement params statement'","-","-{-# INLINE condemn #-}","-condemn :: Transaction ()","-condemn =","-  Transaction $ put False"],"additions":0,"deletions":5,"truncated":false},{"path":"src/hasql/Hasql/Transaction/Sessions.hs","lines":["@@ -1,5 +1,9 @@"," module Hasql.Transaction.Sessions","   ( transactionNoRetry","+  , TxEnd (..)","+  , transactionSequential","+  , transactionPipelined","+  , transactionPipelinedStaticEnd"," ","     -- * Transaction settings","   , C.Mode (..)","@@ -7,8 +11,16 @@ module Hasql.Transaction.Sessions","   )"," where"," ","+import Hasql.Pipeline (Pipeline)","+import Hasql.Statement (Statement (..))","+import Hasql.StatementRunner (StatementRunner (..))","+import Hasql.Transaction.Private.Prelude","+","+import Hasql.Decoders qualified as Decoders","+import Hasql.Encoders qualified as Encoders"," import Hasql.Session qualified as B"," import Hasql.Transaction.Config qualified as C","+import Hasql.Transaction.Private.SQL qualified as SQL"," import Hasql.Transaction.Private.Transaction qualified as A"," "," -- |","@@ -17,3 +29,64 @@ import Hasql.Transaction.Private.Transaction qualified as A"," transactionNoRetry :: C.IsolationLevel -> C.Mode -> A.Transaction a -> B.Session a"," transactionNoRetry isolation mode transaction' =","   A.run transaction' isolation mode","+","+-- | How the transaction ends. 'TxAbort' carries whether deferred constraints are","+-- checked first, which is what still surfaces a constraint violation on a request","+-- that asked not to commit.","+data TxEnd","+  = TxCommit","+  | TxAbort Bool","+","+-- | A transaction-control statement. libpq rejects the simple query protocol","+-- inside a pipeline, so these cannot go through 'B.sql' -- they have to be","+-- extended-protocol statements like every other one. They are marked","+-- preparable so hasql prepares them once per connection and reuses them by","+-- name: on a connection running at loadtest rates the saved parses of","+-- BEGIN/COMMIT/ABORT (and SET CONSTRAINTS when a request rolls back) dominate","+-- the registry overhead.","+control :: ByteString -> Statement () ()","+control statementSql = Statement statementSql Encoders.noParams Decoders.noResult True","+","+beginStmt :: C.IsolationLevel -> C.Mode -> Statement () ()","+beginStmt isoLvl mode = control $ SQL.beginTransaction isoLvl mode","+","+terminate :: (StatementRunner t) => TxEnd -> t ()","+terminate TxCommit = runStatement $ control \"COMMIT\"","+terminate (TxAbort checkDeferred) =","+  when checkDeferred (runStatement $ control \"SET CONSTRAINTS ALL IMMEDIATE\") *> runStatement (control \"ABORT\")","+","+-- | Cleans up after a failed statement. An error inside a pipeline for","+-- BEGIN..COMMIT leaves the session in an aborted transaction. Postgres treats","+-- ROLLBACK with no transaction in progress as a no-op, so this is equally","+-- safe on a path that never opened one.","+rollbackOnError :: B.Session a -> B.Session a","+rollbackOnError session = session `catchError` \\err -> B.sql \"ROLLBACK\" >> throwError err","+","+-- | Run a sequential transaction: BEGIN, then the body, then the chosen terminator.","+-- Every statement is its own round trip.","+transactionSequential :: C.IsolationLevel -> C.Mode -> B.Session (a, TxEnd) -> B.Session a","+transactionSequential isoLvl mode body = rollbackOnError $ do","+  runStatement $ beginStmt isoLvl mode","+  (res, end) <- body","+  terminate end","+  pure res","+","+-- | Run a pipelined transaction where the terminator depends on the body result.","+-- BEGIN rides with the body in a single round trip; the terminator takes a second","+-- round trip because its choice (COMMIT vs ABORT) cannot be made until the body","+-- has been read.","+transactionPipelined :: C.IsolationLevel -> C.Mode -> Pipeline (a, TxEnd) -> B.Session a","+transactionPipelined isoLvl mode body = rollbackOnError $ do","+  (res, end) <- B.pipeline $ runStatement (beginStmt isoLvl mode) *> body","+  terminate end","+  pure res","+","+-- | Run a pipelined transaction with a terminator chosen in advance. BEGIN, the","+-- body, and the terminator all fit in one round trip.","+transactionPipelinedStaticEnd :: C.IsolationLevel -> C.Mode -> TxEnd -> Pipeline a -> B.Session a","+transactionPipelinedStaticEnd isoLvl mode end body =","+  rollbackOnError","+    $ B.pipeline","+    $ runStatement (beginStmt isoLvl mode)","+    *> body","+    <* terminate end"],"additions":73,"deletions":0,"truncated":false},{"path":"src/library/PostgREST/Config.hs","lines":["@@ -88,6 +88,7 @@ data AppConfig = AppConfig","     configDbExtraSearchPath :: [Text],","     configDbHoistedTxSettings :: [Text],","     configDbMaxRows :: Maybe Integer,","+    configDbPipelineMode :: Bool,","     configDbPlanEnabled :: Bool,","     configDbPoolSize :: Int,","     configDbPoolAcquisitionTimeout :: Int,","@@ -179,6 +180,7 @@ toText conf =","               (