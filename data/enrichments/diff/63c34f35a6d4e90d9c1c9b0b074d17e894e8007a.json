ant : uint8_t {","+\t//! The source reported invalid progress while it was producing data","+\tUNSUPPORTED_SOURCE,","+\t//! The sink turned valid source progress into invalid progress","+\tUNSUPPORTED_SINK,","+\t//! The source reported progress that is not finite or outside of [0, total]","+\tMALFORMED_SOURCE,","+\t//! The sink reported progress that is not finite or outside of [0, total]","+\tMALFORMED_SINK,","+\t//! The progress of the pipeline decreased","+\tNON_MONOTONIC,","+\t//! The pipeline ran to completion but did not report 100% progress","+\tINCOMPLETE,","+\t//! The progress of the pipeline did not change while it produced many chunks","+\tSTALLED,","+\t//! The source progress deviates strongly from the fraction of rows produced (log-only)","+\tINACCURATE","+};","+","+//! The ProgressVerifier samples the progress of every pipeline after each source chunk and at the end of the query,","+//! and verifies that the reported progress is well-formed, monotonic, moving and complete","+class ProgressVerifier {","+public:","+\tProgressVerifier(ClientContext &context, DebugProgressVerification mode, const string &ignore_list);","+","+public:","+\t//! Samples the progress of a pipeline after a non-empty source chunk was pushed through the pipeline","+\tvoid OnSourceChunk(Pipeline &pipeline, idx_t count);","+\t//! Called when a pipeline executor finished without exhausting its source (e.g. because of a LIMIT)","+\tvoid OnEarlyExit(Pipeline &pipeline);","+\t//! Called when the source or sink state of a pipeline is reset - this starts a new run of the pipeline","+\tvoid OnReset(Pipeline &pipeline);","+\t//! Takes a final sample of the given (completed) pipelines and verifies all traces","+\t//! Returns an error message if any violation that fails the query was found","+\tstring Finalize(const vector<shared_ptr<Pipeline>> &pipelines);","+","+\t//! The name that is used to attribute a violation to an operator","+\tstatic string OperatorName(const PhysicalOperator &op);","+","+private:","+\tstruct ProgressSample {","+\t\t//! Progress fraction reported by the source - or NaN if the source progress was invalid","+\t\tdouble source_fraction;","+\t\t//! Progress fraction of the pipeline - or NaN if the pipeline progress was invalid","+\t\tdouble fraction;","+\t\t//! Rows produced by the source at the time of the sample","+\t\tidx_t rows;","+\t};","+\tstruct PipelineRun {","+\t\tvector<ProgressSample> samples;","+\t\tidx_t rows = 0;","+\t\tidx_t chunks = 0;","+\t\tbool early_exit = false;","+\t\tbool has_final_sample = false;","+\t\toptional_idx first_unsupported_source;","+\t\toptional_idx first_unsupported_sink;","+\t};","+\tstruct PipelineTrace {","+\t\t//! Held while sampling, so samples are recorded in the order in which they were taken","+\t\tmutex lock;","+\t\tstring source_name;","+\t\tstring sink_name;","+\t\tPipelineRun run;","+\t};","+\tstruct Violation {","+\t\tProgressInvariant invariant;","+\t\tstring operator_name;","+\t\tstring pipeline;","+\t\tstring detail;","+\t};","+","+private:","+\tPipelineTrace &GetTrace(Pipeline &pipeline);","+\tvoid Sample(Pipeline &pipeline, PipelineTrace &trace, bool is_final);","+\tvoid VerifyRun(PipelineTrace &trace);","+\tvoid AddViolation(const PipelineTrace &trace, ProgressInvariant invariant, const string &operator_name,","+\t                  const string &detail);","+\tbool IsIgnored(const Violation &violation) const;","+\tstatic bool FailsQuery(ProgressInvariant invariant);","+","+private:","+\tClientContext &context;","+\tDebugProgressVerification mode;","+\tunordered_set<string> ignore_list;","+","+\t//! Protects the traces map and the violations","+\tmutex lock;","+\tunordered_map<const Pipeline *, unique_ptr<PipelineTrace>> traces;","+\tvector<Violation> violations;","+\tunordered_set<string> reported;","+};","+","+} // namespace duckdb"],"additions":116,"deletions":0,"truncated":false},{"path":"src/logging/log_manager.cpp","lines":["@@ -285,6 +285,7 @@ void LogManager::RegisterDef