{"id":"0255c743fe5fd5307846d8b22e805a0b45809fc9","axis":"silent","repo":"QwikDev/qwik","sha":"0255c743fe5fd5307846d8b22e805a0b45809fc9","parsed":{"files":[{"path":".changeset/short-debug-chunk-names.md","lines":["@@ -0,0 +1,5 @@","+---","+'@qwik.dev/core': patch","+---","+","+fix: debug builds shorten chunk file names that would pass file system limits"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/qwik-vite/src/plugins/rolldown.ts","lines":["@@ -18,7 +18,12 @@ import {","   type QwikPlugin,","   type QwikPluginOptions,"," } from './plugin';","-import { createRolldownError, flattenToChunkName, isVirtualId } from './vite-utils';","+import {","+  createRolldownError,","+  flattenToChunkName,","+  isVirtualId,","+  shortenChunkName,","+} from './vite-utils';"," "," type QwikRolldownPluginApi = {","   getOptimizer: () => Optimizer;","@@ -157,7 +162,7 @@ const getChunkFileName = (opts: NormalizedQwikPluginOptions, optimizer: Optimize"," ","       // Flatten path-like names so debug output stays flat in build/.","       const relativePath = optimizer.sys.path.relative(optimizer.sys.cwd(), chunkInfo.name);","-      return `${chunkPathPrefix}${flattenToChunkName(relativePath)}.js`;","+      return `${chunkPathPrefix}${shortenChunkName(flattenToChunkName(relativePath))}.js`;","     };","   }"," };"],"additions":7,"deletions":2,"truncated":false},{"path":"packages/qwik-vite/src/plugins/rolldown.unit.ts","lines":["@@ -5,6 +5,7 @@ import type { OptimizerOptions, SegmentAnalysis } from '../types';"," import { createQwikPlugin, type NormalizedQwikPluginOptions } from './plugin';"," import { assert, expect, test, vi } from 'vitest';"," import { normalizePath } from '../../../qwik/src/testing/util';","+import { shortenChunkName } from './vite-utils';"," "," const cwd = process.cwd();"," ","@@ -530,6 +531,20 @@ test.each([true, false])(","   }"," );"," ","+test('debug build shortens long chunk file names', async () => {","+  const plugin = qwikRolldown({","+    optimizerOptions: mockOptimizerOptions(),","+    buildMode: 'production',","+    debug: true,","+  });","+  await plugin.options!({});","+  const output: Rolldown.OutputOptions = await plugin.outputOptions!({});","+  const chunkFileNames = output.chunkFileNames as (chunk: Rolldown.PreRenderedChunk) => string;","+  const name = `segment_app.tsx_App_component_${'div_'.repeat(60)}button_q_e_click_ppvuTaDoEGk`;","+","+  expect(chunkFileNames({ name, moduleIds: [] } as any)).toBe(`build/${shortenChunkName(name)}.js`);","+});","+"," test('codeSplitting starts with the qwik groups and disables dependency recursion', async () => {","   const codeSplitting = await clientCodeSplitting({});"," "],"additions":15,"deletions":0,"truncated":false},{"path":"packages/qwik-vite/src/plugins/vite-utils.ts","lines":["@@ -1,4 +1,5 @@"," import type { Rolldown } from 'vite';","+import { hashCode } from '../../../qwik/src/core/shared/utils/hash_code';"," "," export interface Loc {","   file: string;","@@ -156,6 +157,24 @@ export const flattenToChunkName = (name: string) =>","     .replace(/^[/\\\\]+/, '')","     .replace(/[/\\\\]+/g, '-');"," ","+const MAX_CHUNK_NAME_BYTES = 200;","+const KEPT_CHUNK_NAME_END_BYTES = 90;","+const utf8Encoder = new TextEncoder();","+const utf8Decoder = new TextDecoder();","+","+const decodeWholeCharacters = (bytes: Uint8Array) =>","+  utf8Decoder.decode(bytes).replace(/^\\uFFFD+|\\uFFFD+$/g, '');","+","+export const shortenChunkName = (name: string) => {","+  const bytes = utf8Encoder.encode(name);","+  if (bytes.length <= MAX_CHUNK_NAME_BYTES) {","+    return name;","+  }","+  const start = decodeWholeCharacters(bytes.subarray(0, KEPT_CHUNK_NAME_END_BYTES));","+  const end = decodeWholeCharacters(bytes.subarray(-KEPT_CHUNK_NAME_END_BYTES));","+  return `${start}~${hashCode(name)}~${end}`;","+};","+"," // A user chunk with these names would hijack the manifest."," const RESERVED_CHUNK_NAMES = new Set(['qwik-core', 'qwikloader', 'qwik-preloader']);"," "],"additions":19,"deletions":0,"truncated":false},{"path":"packages/qwik-vite/src/plugins/vite-utils.unit.ts","lines":["@@ -1,5 +1,5 @@"," import { describe, expect, test } from 'vitest';","-import { sanitizeChunkGroupName } from './vite-utils';","+import { sanitizeChunkGroupName, shortenChunkName } from './vite-utils';"," "," describe('sanitizeChunkGroupName', () => {","   test('returns null for empty names', () => {","@@ -25,3 +25,31 @@ describe('sanitizeChunkGroupName', () => {","     expect(sanitizeChunkGroupName('qwik-preloader')).toBe('qwik-preloader-segment');","   });"," });","+","+describe('shortenChunkName', () => {","+  test('keeps names up to 200 bytes as-is', () => {","+    expect(shortenChunkName('a'.repeat(200))).toBe('a'.repeat(200));","+  });","+","+  test('shortens a longer name to 200 bytes, keeping its start and end', () => {","+    const name = `segment_app.tsx_App_component_${'div_'.repeat(60)}button_q_e_click_ppvuTaDoEGk`;","+    const shortened = shortenChunkName(name);","+","+    expect(Buffer.byteLength(shortened)).toBeLessThanOrEqual(200);","+    expect(shortened).toMatch(/^segment_app\\.tsx_App_component_div_/);","+    expect(shortened).toMatch(/_button_q_e_click_ppvuTaDoEGk$/);","+  });","+","+  test('keeps long names that differ only in the middle apart', () => {","+    const withMiddle = (middle: string) => `app.tsx_${'a'.repeat(150)}${middle}${'z'.repeat(150)}`;","+","+    expect(shortenChunkName(withMiddle('b'))).not.toBe(shortenChunkName(withMiddle('c')));","+  });","+","+  test.each(['', 'a', 'ab'])('cuts multi-byte names on whole characters (padding %j)', (pad) => {","+    const shortened = shortenChunkName(`${pad}${'组'.repeat(100)}${pad}`);","+","+    expect(Buffer.byteLength(shortened)).toBeLessThanOrEqual(200);","+    expect(shortened).not.toContain('\\uFFFD');","+  });","+});",""],"additions":29,"deletions":1,"truncated":false}],"additions":75,"deletions":3,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-07T15:03:18.554511+00:00"}