d a true 24H","+  // change, and keeps it available when the OHLCV API fails.","+  const candle24hChange = useCandle24hChange({","+    chainId,","+    address,","+    currency,","+    candlePrice,","+    candleCurrency: resolvedCurrency,","+    currentPrice,","+    enabled: !isLineChart,","+  });","   const candleHeader = {","-    price: ohlcvPrice,","-    percentChange: ohlcvPercentChange,","-    timestamp: ohlcvTimestamp,","+    price: candlePrice,","+    percentChange: candle24hChange.percentChange,","+    // Candle mode shows the last-24H change, labelled \"Today\" to match mobile,","+    // instead of the latest bar's date.","+    timestamp: undefined as number | undefined,","+    periodLabel: t('today'),","     loading: isOhlcvLoading,","     // The price API does not quote every fiat, so label whatever came back.","     currency: resolvedCurrency,","@@ -294,6 +326,7 @@ export const AdvancedChartSection = ({","         percentChange={header.percentChange}","         currency={header.currency}","         timestamp={header.timestamp}","+        periodLabel={header.periodLabel}","         loading={header.loading}","       />"," "],"additions":41,"deletions":8,"truncated":false},{"path":"ui/pages/asset/components/chart/token-price-header.test.tsx","lines":["@@ -1,7 +1,11 @@"," import React from 'react';"," import { render, screen } from '@testing-library/react';","+// eslint-disable-next-line import-x/no-restricted-paths","+import messages from '../../../../../app/_locales/en/messages.json';"," import TokenPriceHeader from './token-price-header';"," ","+const TODAY_LABEL = messages.today.message;","+"," // Mock useFormatters hook"," jest.mock('../../../../hooks/useFormatters', () => ({","   useFormatters: () => ({","@@ -159,6 +163,43 @@ describe('TokenPriceHeader', () => {","     });","   });"," ","+  describe('periodLabel display', () => {","+    it('displays the periodLabel instead of the formatted timestamp', () => {","+      const timestamp = new Date(2025, 5,