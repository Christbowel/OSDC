e history. Candle mode only. */","   price?: number;","-  percentChange?: number;","   timestamp?: number;","   isLoading: boolean;","   error: string | null;","@@ -92,8 +91,7 @@ export function useAdvancedChartData({","       : ohlcvData;","   }, [ohlcvData, latestBar]);"," ","-  const { price, percentChange, timestamp } =","-    useOHLCVPriceData(mergedOhlcvData);","+  const { price, timestamp } = useOHLCVPriceData(mergedOhlcvData);"," ","   return {","     ohlcvData,","@@ -101,7 +99,6 @@ export function useAdvancedChartData({","     realtimePrice: latestBar?.close,","     realtimeTimestamp: latestBar?.time,","     price,","-    percentChange,","     timestamp,","     isLoading,","     error,"],"additions":1,"deletions":4,"truncated":false},{"path":"ui/pages/asset/components/chart/useCandle24hChange.test.ts","lines":["@@ -0,0 +1,106 @@","+import { renderHook } from '@testing-library/react';","+import { Hex } from '@metamask/utils';","+import { useHistoricalPrices } from '../../hooks/useHistoricalPrices';","+import { useCandle24hChange } from './useCandle24hChange';","+","+jest.mock('../../hooks/useHistoricalPrices');","+","+const mockUseHistoricalPrices = jest.mocked(useHistoricalPrices);","+","+// P1D series opens at 100 (price ~24h ago) and most recently reads 120.","+const PRICES = [","+  { x: 1_699_000_000_000, y: 100 },","+  { x: 1_699_086_400_000, y: 120 },","+];","+","+function setupHistorical(","+  overrides: Partial<ReturnType<typeof useHistoricalPrices>> = {},","+) {","+  mockUseHistoricalPrices.mockReturnValue({","+    data: { prices: PRICES, metadata: {} },","+    loading: false,","+    isFetching: false,","+    isFetchedAfterMount: true,","+    isPlaceholderData: false,","+    ...overrides,","+  } as ReturnType<typeof useHistoricalPrices>);","+}","+","+const BASE_OPTIONS = {","+  chainId: '0x1' as Hex,","+  address: '0x0000000000000000000000000000000000000000',","+  currency: 'EUR',","+  candlePrice: 150,","+  candleCurrency: 'eur',","+  currentPrice: 200,","+  enabled: true,","+};","+","+function render(overrides: Partial<typeof BASE_OPTIONS> = {}) {","+  return renderHook(() =>","+    useCandle24hChange({ ...BASE_OPTIONS, ...overrides }),","+  );","+}","+","+describe('useCandle24hChange', () => {","+  beforeEach(() => {","+    jest.clearAllMocks();","+    setupHistorical();","+  });","+","+  it('fetches the interval-independent P1D series', () => {","+    render();","+","+    expect(mockUseHistoricalPrices).toHaveBeenCalledWith(","+      expect.objectContaining({ timeRange: 'P1D', enabled: true }),","+    );","+  });","+","+  it('uses the live candle price against the P1D open when currencies match', () => {","+    // (150 - 100) / 100 = +50%.","+    const { result } = render({ candleCurrency: 'eur', currency: 'EUR' });","+","+    expect(result.current.percentChange).toBe(50);","+  });","+","+  it('does not mix currencies: uses a currency-denominated price when the candle resolved to another fiat', () => {","+    // Candle is USD but the user currency is EUR, so the USD candle price must","+    // not be compared to the EUR baseline. Uses currentPrice (200) vs 100.","+    const { result } = render({","+      candleCurrency: 'usd',","+      currency: 'EUR',","+      candlePrice: 150,","+      currentPrice: 200,","+    });","+","+    expect(result.current.percentChange).toBe(100);","+  });","+","+  it('falls back to the latest P1D point when the candle resolved to another fiat and there is no current price', () => {","+    // (120 - 100) / 100 = +20%.","+    const { result } = render({","+      candleCurrency: 'usd',","+      currency: 'EUR',","+      currentPrice: undefined,","+    });","+","+    expect(result.current.percentChange).toBe(20);","+  });","+","+  it('returns no percentage while the historical data is placeholder', () => {","+    setupHistorical({ isPlaceholderData: true });","+","+    const { result } = render();","+","+    expect(result.current.percentChange).toBeUndefined();","+    expect(result.current.loading).toBe(true);","+  });","+","+  it('keeps the query idle in line mode', () => {","+    render({ enabled: false });","+","+    expect(mockUseHistoricalPrices).toHaveBeenCalledWith(","+      expect.objectContaining({ enabled: false }),","+    );","+  });","+});"],"additions":106,"deletions":0,"truncated":false},{"path":"ui/pages/asset/components/chart/useCandle24hChange.ts","lines":["@@ -0,0 +1,104 @@","+import { useMemo } from 'react';","+import { Hex } from '@metamask/utils';","+import { useHistoricalPrices } from '../../hooks/useHistoricalPrices';","+import { computePercentChange } from '../../../../components/app/assets/util/percentChange';","+","+/**","+ * Time range for the interim 24H-change source. `P1D` is interval-independent,","+ * so it yields a true last-24H change regardless of the selected candle","+ * interval (candle data is interval-bucketed and would drift).","+ */","+const TWENTY_FOUR_HOUR_RANGE = 'P1D';","+","+export type UseCandle24hChangeOptions = {","+  chainId: Hex;","+  address: string;","+  /** The user's display currency. */","+  currency: string;","+  /** Latest/live candle close price, quoted in `candleCurrency`. */","+  candlePrice?: number;","+  /**","+   * The currency the candle price is actually quoted in (the OHLCV resolved","+   * currency, which falls back to USD when the API cannot quote `currency`).","+   */","+  candleCurrency: string;","+  /** The wallet's current price, always quoted in the user's `currency`. */","+  currentPrice?: number;","+  /** Candle mode only. Keeps the underlying source idle in line mode. */","+  enabled: boolean;","+};","+","+export type Candle24hChange = {","+  /** The last-24H percent change (e.g. 5.25 for +5.25%), or undefined. */","+  percentChange: number | undefined;","+  /** True while the source has not produced a usable value yet. */","+  loading: boolean;","+};","+","+/**","+ * The candlestick header's \"last 24H\" percent change.","+ *","+ * This hook is the single seam for *where* the 24H change comes from. The","+ * chart component only consumes the returned `percentChange`, so changing the","+ * source does not touch any component.","+ *","+ * Interim source: the interval-independent `P1D` historical-prices series.","+ * Candles are interval-bucketed, so a candle-derived 24H baseline drifts with","+ * the interval and collapses to 0% on coarse intervals like `1w`.","+ *","+ * Future source: when the backend ships the `percentChange1D` WebSocket","+ * stream, replace the body of this hook with that stream (and delete the","+ * historical fetch below). Nothing else needs to change.","+ *","+ * The percentage must be a ratio of two prices in the *same* currency, so the","+ * current value is only taken from the candle price when it resolved in the","+ * user's `currency`; otherwise a `currency`-denominated price is used.","+ *","+ * @param options - See {@link UseCandle24hChangeOptions}.","+ * @param options.chainId - The asset's chain ID.","+ * @param options.address - The asset's address.","+ * @param options.currency - The user's display currency.","+ * @param options.candlePrice - Latest/live candle close price, in `candleCurrency`.","+ * @param options.candleCurrency - The currency the candle price is quoted in.","+ * @param options.currentPrice - The wallet's current price, in `currency`.","+ * @param options.enabled - False in line mode, to keep the source idle.","+ * @returns The 24H percent change and its loading state.","+ */","+export function useCandle24hChange({","+  chainId,","+  address,","+  currency,","+  candlePrice,","+  candleCurrency,","+  currentPrice,","+  enabled,","+}: UseCandle24hChangeOptions): Candle24hChange {","+  // ─── Interim source: P1D historical prices ──────────────────────────────","+  // Replace this (and the derivation below) with the `percentChange1D` WS","+  // stream once it is available.","+  const historical = useHistoricalPrices({","+    chainId,","+    address,","+    currency,","+    timeRange: TWENTY_FOUR_HOUR_RANGE,","+    enabled,","+  });","+","+  return useMemo(() => {","+    const baseline = historical.isPlaceholderData","+      ? undefined","+      : historical.data.prices?.[0]?.y;","+    const current =","+      candleCurrency === currency.toLowerCase()","+        ? candlePrice","+        : (currentPrice ??","+          (historical.isPlaceholderData","+            ? undefined","+            : historical.data.prices?.at(-1)?.y));","+","+    return {","+      percentChange: computePercentChange(current, baseline),","+      loading: historical.loading || historical.isPlaceholderData,","+    };","+  }, [historical, candlePrice, candleCurrency, currency, currentPrice]);","+}"],"additions":104,"deletions":0,"truncated":false},{"path":"ui/pages/asset/components/chart/useOHLCVPriceData.test.ts","lines":["@@ -2,6 +2,10 @@ import { renderHook } from '@testing-library/react';"," import { useOHLCVPriceData } from './useOHLCVPriceData';"," import type { OHLCVBar } from './useOHLCVChart';"," ","+const HOUR_MS = 60 * 60 * 1000;","+// Arbitrary base time in milliseconds (OHLCV bar `time` is ms).","+const BASE_TIME = 1_700_000_000_000;","+"," describe('useOHLCVPriceData', () => {","   const createBar = (","     time: number,","@@ -12,113 +16,53 @@ describe('useOHLCVPriceData', () => {","     volume = 100,","   ): OHLCVBar => ({ time, open, high, low, close, volume });"," ","-  describe('price calculation', () => {","+  describe('price', () => {","     it('returns undefined values when ohlcvData is empty', () => {","       const { result } = renderHook(() => useOHLCVPriceData([]));"," ","       expect(result.current.price).toBeUndefined();","-      expect(result.current.percentChange).toBeUndefined();","       expect(result.current.timestamp).toBeUndefined();","     });"," ","-    it('returns latest close price as price', () => {","-      const bars = [","-        createBar(1700000000, 100, 105),","-        createBar(1700003600, 105, 110),","-        createBa