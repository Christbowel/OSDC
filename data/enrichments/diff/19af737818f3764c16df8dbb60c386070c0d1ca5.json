allback;","+            $pool = $wrapper->pool;","+        }","+","         try {","             $item = clone $item;","             $item->set(null);","@@ -29,7 +41,9 @@ public static function create(ReverseContainer $reverseContainer, callable $call","             return null;","         }"," ","-        $pool = $reverseContainer->getId($pool);","+        if (null === $pool = $reverseContainer->getId($pool)) {","+            return null;","+        }"," ","         if ($callback instanceof \\Closure && !($r = new \\ReflectionFunction($callback))->isAnonymous()) {","             $callback = [$r->getClosureThis() ?? $r->getClosureCalledClass()?->name, $r->name];"],"additions":15,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/Cache/Tests/Fixtures/EarlyExpirationComputation.php","lines":["@@ -0,0 +1,39 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Cache\\Tests\\Fixtures;","+","+use Symfony\\Component\\Cache\\CacheItem;","+","+class EarlyExpirationComputation","+{","+    public int $calls = 0;","+    public bool $save = true;","+","+    public function __construct(private array $values = [1, 2])","+    {","+    }","+","+    public function __invoke(CacheItem $item, bool &$save): mixed","+    {","+        $item->expiresAfter(3600);","+        // Ensure a non-zero computation time for probabilistic early expiration.","+        usleep(1000);","+        $save = $this->save;","+        $value = $this->values[$this->calls++];","+","+        if ($value instanceof \\Throwable) {","+            throw $value;","+        }","+","+        return $value;","+    }","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Cache/Tests/Messenger/ChainAdapterEarlyExpirationTest.php","lines":["@@ -0,0 +1,328 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Cache\\Tests\\Messenger;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Group;","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\Cache\\Adapter\\AdapterInterface;","+use Symfony\\Component\\Cache\\Adapter\\ArrayAdapter;","+use Symfony\\Component\\Cache\\Adapter\\ChainAdapter;","+use Symfony\\Component\\Cache\\Adapter\\FilesystemAdapter;","+use Symfony\\Component\\Cache\\CacheItem;","+use Symfony\\Component\\Cache\\LockRegistry;","+use Symfony\\Component\\Cache\\Messenger\\EarlyExpirationDispatcher;","+use Symfony\\Component\\Cache\\Messenger\\EarlyExpirationHandler;","+use Symfony\\Component\\Cache\\Messenger\\EarlyExpirationMessage;","+use Symfony\\Component\\Cache\\Tests\\Fixtures\\EarlyExpirationComputation;","+use Symfony\\Component\\DependencyInjection\\Container;","+use Symfony\\Component\\DependencyInjection\\ReverseContainer;","+use Symfony\\Component\\DependencyInjection\\ServiceLocator;","+use Symfony\\Component\\Filesystem\\Filesystem;","+use Symfony\\Component\\Messenger\\Handler\\HandlersLocator;","+use Symfony\\Component\\Messenger\\MessageBus;","+use Symfony\\Component\\Messenger\\MessageBusInterface;","+use Symfony\\Component\\Messenger\\Middleware\\HandleMessageMiddleware;","+use Symfony\\Component\\Messenger\\Middleware\\SendMessageMiddleware;","+use Symfony\\Component\\Messenger\\Stamp\\ReceivedStamp;","+use Symfony\\Component\\Messenger\\Transport\\InMemory\\InMemoryTransport;","+use Symfony\\Component\\Messenger\\Transport\\Sender\\SendersLocator;","+use Symfony\\Component\\Messenger\\Transport\\Serialization\\PhpSerializer;","+","+#[Group('time-sensitive')]","+class ChainAdapterEarlyExpirationTest extends TestCase","+{","+    public static function tearDownAfterClass(): void","+    {","+        (new Filesystem())->remove(sys_get_temp_dir().'/symfony-cache');","+    }","+","+    #[DataProvider('provideChains')]","+    public function testAsynchronousRecomputation(string $callbackForm, bool $clearUpperLayers, float $beta)","+    {","+        [$pool, $adapters] = $this->createChain();","+        $computation = new EarlyExpirationComputation();","+        $callback = match ($callbackForm) {","+            'object' => $computation,","+            'array' => [$computation, '__invoke'],","+            'closure' => $computation(...),","+        };","+        [$bus, $reverseContainer, $transport] = $this->createBus($pool, $computation);","+","+        $this->assertSame(1, $pool->get('key', $callback));","+        $this->assertSame(1, $computation->calls);","+        $this->assertCount(0, $transport->getSent());","+","+        if ($clearUpperLayers) {","+            foreach (\\array_slice($adapters, 0, -1) as $adapter) {","+                $adapter->clear();","+            }","+        }","+","+        $before = $this->snapshot($adapters);","+        $value = $pool->get('key', $callback, $beta);","+","+        $this->assertCount(1, $transport->getSent());","+        $this->assertSame(1, $value);","+        $this->assertSame(1, $computation->calls);","+        $this->assertSame($before, $this->snapshot($adapters));","+","+        $envelope = $transport->get()[0];","+        $message = $envelope->getMessage();","+        $this->assertInstanceOf(EarlyExpirationMessage::class, $message);","+        $this->assertSame('pool', $message->getPool());","+        $this->assertSame($pool, $message->findPool($reverseContainer));","+        $this->assertSame('object' === $callbackForm ? '@callback' : ['@callback', '__invoke'], $message->getCallback());","+        $this->assertSame($computation, \\is_array($reversedCallback = $message->findCallback($reverseContainer)) ? $reversedCallback[0] : $reversedCallback);","+","+        $bus->dispatch($envelope->with(new ReceivedStamp('async')));","+","+        $this->assertSame(2, $computation->calls);","+        $this->assertGreaterThan(0, $adapters[array_key_last($adapters)]->getItem('key')->getMetadata()[CacheItem::METADATA_CTIME] ?? 0);","+        foreach ($adapters as $adapter) {","+            $item = $adapter->getItem('key');","+            $this->assertTrue($item->isHit());","+            $this->assertSame(2, $item->get());","+        }","+    }","+","+    public function testSynchronousRecomputationReturnsAndCachesNull()","+    {","+        [$pool, $adapters] = $this->createChain();","+        $computation = new EarlyExpirationComputation([1, null]);","+        [$bus, $reverseContainer] = $this->createBus($pool, $computation, false);","+        $dispatcherBus = $this->createMock(MessageBusInterface::class);","+        $dispatcherBus->expects($this->once())->method('dispatch')->willReturnCallback($bus->dispatch(...));","+        $pool->setCallbackWrapper(new EarlyExpirationDispatcher($dispatcherBus, $reverseContainer));","+","+        $this->assertSame(1, $pool->get('key', $computation));","+        $this->assertNull($pool->get('key', $computation, \\INF));","+        $this->assertSame(2, $computation->calls);","+","+        foreach ($adapters as $adapter) {","+            $item = $adapter->getItem('key');","+            $this->assertTrue($item->isHit());","+            $this->assertNull($item->get());","+            $this->assertArrayHasKey(CacheItem::METADATA_EXPIRY, $item->getMetadata());","+        }","+    }","+","+    #[DataProvider('provideDispatchModes')]","+    public function testRecomputationCanSkipSaving(bool $async)","+    {","+        [$pool, $adapters] = $this->createChain();","+        $computation = new EarlyExpirationComputation();","+        [$bus, , $transport] = $this->createBus($pool, $computation, $async);","+","+        $this->assertSame(1, $pool->get('key', $computation));","+        $before = $this->snapshot($adapters);","+        $computation->save = false;","+","+        $this->assertSame($async ? 1 : 2, $pool->get('key', $computation, \\INF));","+        if ($async) {","+            $this->assertCount(1, $transport->getSent());","+            $bus->dispatch($transport->get()[0]->with(new ReceivedStamp('async')));","+        }","+","+        $this->assertSame(2, $computation->calls);","+        $this->assertSame($before, $this->snapshot($adapters));","+    }","+","+    public function testUnreversibleCallbackIsComputedOnline()","+    {","+        [$pool, $adapters] = $this->createChain();","+        $computation = new EarlyExpirationComputation();","+        [, , $transport] = $this->createBus($pool, $computation);","+","+        $this->assertSame(1, $pool->get('key', $computation));","+        $this->assertSame('online', $pool->get('key', static fn () => 'online', \\INF));","+        $this->assertCount(0, $transport->getSent());","+        foreach ($adapters as $adapter) {","+            $this->assertSame('online', $adapter->getItem('key')->get());","+        }","+    }","+","+    public function testUnreversiblePoolIsComputedOnline()","+    {","+        [$pool, $adapters] = $this->createChain();","+        $computation = new EarlyExpirationComputation();","+        [, , $transport] = $this->createBus($pool, $computation, true, false);","+","+        $this->assertSame(1, $pool->get('key', $computation));","+        $adapters[0]->clear();","+","+        $this->assertSame(2, $pool->get('key', $computation, 1e12));","+        $this->assertSame(2, $computation->calls);","+        $this->assertCount(0, $transport->getSent());","+        foreach ($adapters as $adapter) {","+            $this->assertSame(2, $adapter->getItem('key')->get());","+        }","+    }","+","+    public function testOnlineLockingPreservesPropagationLifetimeAndSaveFlag()","+    {","+        $fast = new ArrayAdapter(200);","+        $slow = new FilesystemAdapter('chain-early-expiration', 300);","+        $slow->clear();","+        $pool = new ChainAdapter([$fast, $slow], 100);","+        $computation = new EarlyExpirationComputation();","+        [$bus, $reverseContainer, $transport] = $this->createBus($pool, $computation);","+        $wrapper = static function (\\Closure $callback, CacheItem $item, bool &$save, AdapterInterface $backend, \\Closure $setMetadata) use ($slow) {","+            self::assertSame($slow, $backend);","+","+            return LockRegistry::compute($callback, $item, $save, $backend, $setMetadata);","+        };","+        $pool->setCallbackWrapper(new EarlyExpirationDispatcher($bus, $reverseContainer, $wrapper));","+","+        $this->assertSame('value', $pool->get('key', static fn () => 'value'));","+        $this->assertEqualsWithDelta(microtime(true) + 100, $fast->getItem('key')->getMetadata()[CacheItem::METADATA_EXPIRY], 1);","+        $this->assertSame('unsaved', $pool->get('other', static function (CacheItem $item, bool &$save) {","+            $save = false;","+","+            return 'unsaved';","+        }));","+        $this->assertFalse($fast->hasItem('other'));","+        $this->assertFalse($slow->hasItem('other'));","+        $this->assertCount(0, $transport->getSent());","+    }","+","+    public function testComputationCanBeRetriedAfterFailure()","+    {","+        [$pool, $adapters] = $this->createChain();"],"additions":200,"deletions":0,"truncated":false}],"additions":524,"deletions":23,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-11-14T15:14:06.371119+00:00"}