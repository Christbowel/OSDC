nd `-rev` markers do: whatever stands to their left is the package.","+fn npm_package_routes(router: Router<AppState>, base: &str) -> Router<AppState> {","+    let path = |tail: &str| format!(\"{base}{tail}\");","+    router","+        .route(&path(\"/{name}\"), get(get_packument).put(put_package).delete(unpublish_package))","+        .route(","+            &path(\"/{first}/{second}\"),","+            get(get_packument_or_version_manifest)","+                .put(put_scoped_package)","+                .delete(delete_scoped_package),","+        )","+        .route(&path(\"/{name}/-/{filename}\"), get(get_tarball).delete(unpublish_tarball))","+        .route(&path(\"/{name}/-rev/{rev}\"), put(put_packument_revision).delete(unpublish_package))","+        .route(","+            &path(\"/{scope}/{name}/-rev/{rev}\"),","+            put(put_scoped_packument_revision).delete(unpublish_scoped_package),","+        )","+        .route(&path(\"/{scope}/{name}/{version}\"), get(get_scoped_version_manifest))","+        .route(","+            &path(\"/{scope}/{name}/-/{filename}\"),","+            get(get_scoped_tarball).delete(unpublish_scoped_tarball),","+        )","+        .route(&path(\"/{name}/-/{filename}/-rev/{rev}\"), delete(unpublish_tarball))","+        .route(&path(\"/{scope}/{name}/-/{filename}/-rev/{rev}\"), delete(unpublish_scoped_tarball))","+}","+"," /// `npm ping` asks the registry URL, not the server root."," fn ping_route(router: Router<AppState>, base: &str) -> Router<AppState> {","     router.route(&format!(\"{base}/-/ping\"), get(serve_ping))"],"additions":32,"deletions":28,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing/npm_handlers.rs","lines":["@@ -342,9 +342,9 @@ pub(super) async fn put_scoped_packument_revision(","     update_packument(&state, &identity, registry.as_deref(), &full, &body_bytes).await"," }"," ","-/// `DELETE {base}/{pkg}/-rev/{rev}` — remove a whole package","-/// (`pnpm unpublish --force`), or remove one version's tarb