_login_body_is_rejected() {","     // Login is the one body-accepting endpoint reachable anonymously on"],"additions":23,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/package_ownership.rs","lines":["@@ -179,20 +179,22 @@ async fn get_couchdb_user_endpoint() {","     assert_eq!(doc[\"_id\"], \"org.couchdb.user:admin_alice\");","     assert_eq!(doc[\"roles\"], json!([]));"," ","-    // Check normal user in htpasswd auth backend","-    let response = app","-        .clone()","-        .oneshot(","-            Request::get(\"/-/user/org.couchdb.user:normal_bob\")","-                .body(Body::empty())","-                .unwrap(),","-        )","-        .await","-        .unwrap();","-    assert_eq!(response.status(), StatusCode::OK);","-    let doc = body_json(response.into_body()).await;","-    assert_eq!(doc[\"name\"], \"normal_bob\");","-    assert_eq!(doc[\"_id\"], \"org.couchdb.user:normal_bob\");","+    // Check normal user in htpasswd auth backend (legacy and bare user paths)","+    for path in [\"/-/user/org.couchdb.user:normal_bob\", \"/-/user/normal_bob\"] {","+        let response = app","+            .clone()","+            .oneshot(","+                Request::get(path)","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::OK, \"path {path}\");","+        let doc = body_json(response.into_body()).await;","+        assert_eq!(doc[\"name\"], \"normal_bob\");","+        assert_eq!(doc[\"_id\"], \"org.couchdb.user:normal_bob\");","+    }"," ","     // Check non-existent user","     let response = app"],"additions":16,"deletions":14,"truncated":false},{"path":"pnpr/crates/pnpr/tests/server/registry_routing.rs","lines":["@@ -548,6 +548,10 @@ async fn a_scoped_address_whose_first_segment_is_not_a_scope_is_not_found() {","         (\"GET\", \"/npm/~npmjs/notascope/widget/-/widget-1.0.0.tgz\"),","         (\"PUT\", \"/npm/notascope/widget\"),","         (\"PUT\", \"/npm/~npmjs/notascope/widget\"),","+        (\"DELETE\", \"/npm/notascope/widget\"),","+        (\"DELETE\", \"/npm/~npmjs/notascope/widget\"),","+        (\"DELETE\", \"/npm/notascope/widget/-/widget-1.0.0.tgz\"),","+        (\"DELETE\", \"/npm/~npmjs/notascope/widget/-/widget-1.0.0.tgz\"),","         (\"DELETE\", \"/npm/notascope/widget/-/widget-1.0.0.tgz/-rev/1\"),","         (\"DELETE\", \"/npm/~npmjs/notascope/widget/-/widget-1.0.0.tgz/-rev/1\"),","     ] {","@@ -574,8 +578,8 @@ async fn a_method_the_address_does_not_serve_is_method_not_allowed() {","     let app = router(config);"," ","     for (method, path) in [","-        // `/{name}` reads and publishes.","-        (\"DELETE\", \"/npm/widget\"),","+        // `/{name}` reads, publishes, and unpublishes.","+        (\"POST\", \"/npm/widget\"),","         // `/{name}/-rev/{rev}` updates and unpublishes.","         (\"GET\", \"/npm/widget/-rev/1\"),","         (\"GET\", \"/npm/~npmjs/widget/-rev/1\"),"],"additions":6,"deletions":2,"truncated":false},{"path":"pnpr/docs/endpoints.md","lines":["@@ -254,11 +254,12 @@ a hosted registry."," | `PUT` | `/@scope/{name}` | Publish a scoped package. Body is the npm publish document with `_attachments`. Requires `publish`. |"," | `PUT` | `/-/pnpm/v1/publish` | pnpm batch publish. Body is `{\"packages\":[<publish document>, ...]}`. The batch is all-or-nothing and each package requires `publish`. For a release that spans ecosystems, use [`PUT /-/pnpr/v0/publish`](ecosystems.md#one-publish-for-a-workspace-that-spans-ecosystems) instead. |"," | `PUT` | `/{package}/-rev/{rev}` | Replace a packument, used by partial unpublish. Requires both `publish` and `unpublish`. Use a percent-encoded scoped package name, for example `@scope%2Fname`. |","-| `DELETE` | `/{package}/-rev/{rev}` | Remove an entire package, used by force unpublish. Requires `unpublish`. Use a percent-encoded scoped package name for scoped packages. |","-| `DELETE` | `/{name}@{version}/-rev/{rev}` | Remove an unscoped version's tarball. Requires `unpublish`. |","-| `DELETE` | `/@scope/{name}@{version}/-rev/{rev}` | Remove a scoped version's tarball. Requires `unpublish`. |","-| `DELETE` | `/{name}/-/{filename}/-rev/{rev}` | Remove an unscoped tarball. Requires `unpublish`. |","-| `DELETE` | `/@scope/{name}/-/{filename}/-rev/{rev}` | Remove a scoped tarball. Requires `unpublish`. |","+| `DELETE` | `/{name}` | Remove an entire unscoped package, used by force unpublish. Requires `unpublish`. Legacy `/{package}/-rev/{rev}` is also accepted. |","+| `DELETE` | `/@scope/{name}` | Remove an entire scoped package, used by force unpublish. Requires `unpublish`. Legacy `/@scope/{name}/-rev/{rev}` is also accepted. |","+| `DELETE` | `/{name}@{version}` | Remove an unscoped version's tarball. Requires `unpublish`. Legacy `/{name}@{version}/-rev/{rev}` is also accepted. |","+| `DELETE` | `/@scope/{name}@{version}` | Remove a scoped version's tarball. Requires `unpublish`. Legacy `/@scope/{name}@{version}/-rev/{rev}` is also accepted. |","+| `DELETE` | `/{name}/-/{filename}` | Remove an unscoped tarball. Requires `unpublish`. Legacy `/{name}/-/{filename}/-rev/{rev}` is also accepted. |","+| `DELETE` | `/@scope/{name}/-/{filename}` | Remove a scoped tarball. Requires `unpublish`. Legacy `/@scope/{name}/-/{filename}/-rev/{rev}` is also accepted. |"," | `PUT` | `/-/package/{package}/dist-tags/{tag}` | Add or update a dist-tag. Body is a JSON string version, for example `\"1.0.0\"`. Requires `publish`. |"," | `DELETE` | `/-/package/{package}/dist-tags/{tag}` | Remove a dist-tag. Requires `publish`. |"," ","@@ -381,7 +382,8 @@ resolver-only server that exposes no registry surface."," | `POST` | `/-/v1/login` | Initiates npm/pnpm browser SSO login. Returns `202 Accepted` with `loginUrl` and `doneUrl` when OIDC login is configured, or `404` to fall back to basic auth. |"," | `GET` | `/-/v1/login/start` | Browser entry point for SSO login. Validates the session and redirects to the configured OIDC provider or renders a provider picker. |"," | `GET` | `/-/v1/login/poll/{session}` | CLI polling endpoint (`doneUrl`). Returns `202 Accepted` with `Retry-After: 1` while pending, or `200 OK` with the bearer token once authenticated. |","-| `PUT` | `/-/user/org.couchdb.user:{name}` | npm adduser/login endpoint. Creates a user only when `auth.htpasswd.max_users` allows registration; existing users can log in with the correct password. Returns a bearer token. |","+| `PUT` | `/-/user/{name}` | npm adduser/login endpoint. Also accepts legacy `/-/user/org.couchdb.user:{name}`. Creates a user only when `auth.htpasswd.max_users` allows registration; existing users can log in with the correct password. Returns a bearer token. |","+| `GET` | `/-/user/{name}` | User lookup endpoint. Also accepts legacy `/-/user/org.couchdb.user:{name}`. Returns the public user document when the account exists. |"," | `GET` | `/-/whoami` | Returns `{\"username\": ...}` for the authenticated caller. |"," | `GET` | `/-/npm/v1/user` | npm profile endpoint. Returns the authenticated username and placeholder profile fields. |"," | `GET` | `/-/npm/v1/tokens` | Lists bearer tokens for the authenticated caller in npm-compatible shape. The server records a token's last use at most once a minute. |",""],"additions":8,"deletions":6,"truncated":false}],"additions":198,"deletions":71,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-26T14:31:53.328175+00:00"}