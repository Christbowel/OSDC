{"id":"93a1a1cc944fd3ef0cc7234cbf1cfd3d52b05268","axis":"silent","repo":"pnpm/pnpm","sha":"93a1a1cc944fd3ef0cc7234cbf1cfd3d52b05268","parsed":{"files":[{"path":".changeset/pnpr-clean-delete-and-user-routes.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+Added `DELETE /{name}`, `DELETE /@{scope}/{name}`, `DELETE /{name}@{version}`, `DELETE /@{scope}/{name}@{version}`, `DELETE /{name}/-/{filename}`, and `DELETE /@{scope}/{name}/-/{filename}` routes that do not require a trailing `/-rev/{rev}` segment. `PUT /-/user/{name}` and `GET /-/user/{name}` now accept bare usernames in addition to the legacy `org.couchdb.user:` prefix."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing.rs","lines":["@@ -24,7 +24,7 @@ use team_handlers::team_routes;"," "," mod npm_handlers;"," use npm_handlers::{","-    delete_package_dist_tag, get_package_dist_tags, get_packument,","+    delete_package_dist_tag, delete_scoped_package, get_package_dist_tags, get_packument,","     get_packument_or_version_manifest, get_scoped_tarball, get_scoped_version_manifest, get_search,","     get_tarball, put_package, put_package_dist_tag, put_packument_revision, put_scoped_package,","     put_scoped_packument_revision, unpublish_package, unpublish_scoped_package,","@@ -302,7 +302,7 @@ fn npm_registry_routes() -> Router<AppState> {","     for base in [\"\", \"/~{registry}\"] {","         let path = |tail: &str| format!(\"{base}{tail}\");","         let with_teams = team_routes(staged_routes(ping_route(router, base), base), base);","-        router = super::security_audit::routes(with_teams, base)","+        let with_audit = super::security_audit::routes(with_teams, base)","             .route(&path(\"/-/v1/search\"), get(get_search))","             .route(&path(\"/-/npm/v1/keys\"), get(super::attestations::get_keys))","             .route(","@@ -313,37 +313,41 @@ fn npm_registry_routes() -> Router<AppState> {","             .route(","    