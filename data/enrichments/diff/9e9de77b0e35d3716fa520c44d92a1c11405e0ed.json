," fn prune(workspace: &Path) {","     let output = pacquet_at(workspace)","         .with_args([\"store\", \"prune\"])","@@ -336,6 +349,114 @@ fn store_prune_keeps_global_virtual_store_packages_with_a_cli_only_modules_dir()","     assert!(target.is_file(), \"the global virtual store package must survive\");"," }"," ","+#[test]","+fn store_prune_keeps_global_virtual_store_packages_with_a_cli_only_modules_dir_it_cannot_walk_to() {","+    for modules_dir in [\"../external_modules\", \".deps\"] {","+        let CommandTempCwd { root, workspace, npmrc_info, .. } =","+            CommandTempCwd::init().add_mocked_registry();","+        write_manifest(&workspace);","+        enable_gvs_in_workspace_yaml(&workspace, \"\");","+        pacquet_at(&workspace)","+            .with_args([\"install\", &format!(\"--modules-dir={modules_dir}\"), \"--reporter=silent\"])","+            .assert()","+            .success();","+        let manifest = workspace.join(modules_dir).join(\"is-positive/package.json\");","+        let installed = fs::read(&manifest).expect(\"read the installed package\");","+        let target = dunce::canonicalize(&manifest).expect(\"resolve the installed package\");","+","+        prune_outside_the_workspace(root.path(), &npmrc_info);","+","+        assert_eq!(","+            fs::read(&manifest).expect(\"the dependency link must remain valid\"),","+            installed,","+            \"{modules_dir}\",","+        );","+        assert!(target.is_file(), \"{modules_dir}: the global virtual store package must survive\");","+    }","+}","+","+#[test]","+fn store_prune_keeps_global_virtual_store_packages_of_a_workspace_package_with_a_hidden_cli_only_modules_dir()","+ {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    fs::write(workspace.join(\"package.json\"), \"{}\").expect(\"write the root manifest\");","+    append_workspace_yaml(&workspace, \"packages: [project]\\n\");","+    let project = workspace.join(\"project\");","+    fs::create_dir_all(&project).expect(\"create workspace package\");","+    write_manifest(&project);","+    enable_gvs_in_workspace_yaml(&workspace, \"\");","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--modules-dir=.deps\", \"--reporter=silent\"])","+        .assert()","+        .success();","+    let manifest = project.join(\".deps/is-positive/package.json\");","+    let installed = fs::read(&manifest).expect(\"read the installed package\");","+","+    prune_outside_the_workspace(root.path(), &npmrc_info);","+","+    assert_eq!(fs::read(&manifest).expect(\"the dependency link must remain valid\"), installed);","+}","+","+#[test]","+fn store_prune_keeps_global_virtual_store_packages_of_a_pnp_project_without_symlinks() {","+    for extra_yaml in [\"lockfileDir: lock\\n\", \"\"] {","+        let CommandTempCwd {","+            root: _root, workspace, npmrc_info, ..","+        } = CommandTempCwd::init().add_mocked_registry();","+        let AddMockedRegistry {","+            mock_instance: _mock_instance,","+            store_dir,","+            ..","+        } = npmrc_info;","+        write_manifest(&workspace);","+        enable_gvs_in_workspace_yaml(","+            &workspace,","+            &format!(\"nodeLinker: pnp\\nsymlink: false\\n{extra_yaml}\"),","+        );","+        pacquet_at(&workspace)","+            .with_args([\"install\", \"--reporter=silent\"])","+            .assert()","+            .success();","+        let links = StoreDir::from(store_dir).links();","+        let slots =","+            || fs::read_dir(links.join(\"@/is-positive/1.0.0\")).map(Iterator::count).unwrap_or(0);","+        assert_eq!(slots(), 1, \"{extra_yaml:?}: the install must use the global virtual store\");","+","+        prune(&workspace);","+","+        assert_eq!(","+            slots(),","+            1,","+            \"{extra_yaml:?}: the PnP project's global virtual store package must survive\",","+        );","+    }","+}","+","+#[test]","+fn store_prune_keeps_global_virtual_store_packages_of_a_workspace_package_under_a_hidden_dir() {","+    let CommandTempCwd {","+        root: _root, workspace, npmrc_info, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance: _mock_instance, .. } = npmrc_info;","+    fs::write(workspace.join(\"package.json\"), \"{}\").expect(\"write the root manifest\");","+    append_workspace_yaml(&workspace, \"packages: ['.packages/*']\\n\");","+    let project = workspace.join(\".packages/app\");","+    fs::create_dir_all(&project).expect(\"create workspace package\");","+    write_manifest(&project);","+    enable_gvs_in_workspace_yaml(&workspace, \"\");","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--reporter=silent\"])","+        .assert()","+        .success();","+    let manifest = project.join(\"node_modules/is-positive/package.json\");","+    let installed = fs::read(&manifest).expect(\"read the installed package\");","+","+    prune(&workspace);","+","+    assert_eq!(fs::read(&manifest).expect(\"the dependency link must remain valid\"), installed);","+}","+"," #[test]"," fn store_prune_keeps_global_virtual_store_slots_from_package_configs_modules_dir() {","     assert_prune_keeps_global_virtual_store_slots(|workspace| {"],"additions":121,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/pnp.rs","lines":["@@ -74,6 +74,80 @@ fn render_pnp_loader(registry: &str, modules_dir: &str) -> String {","     loader"," }"," ","+/// Error type of [`read_pnp_package_dirs`].","+#[derive(Debug, Display, Error)]","+pub enum ReadPnpFileError {","+    #[display(\"failed to read {path:?}: {error}\")]","+    Read {","+        path: PathBuf,","+        #[error(source)]","+        error: std::io::Error,","+    },","+    #[display(\"{path:?} was generated by pnpm, but its package registry cannot be read\")]","+    Unreadable { path: PathBuf },","+}","+","+/// Larger than any loader pnpm writes, which holds one registry entry per","+/// installed package.","+const MAX_PNP_FILE_BYTES: usize = 512 * 1024 * 1024;","+","+/// The package directories the `.pnp.cjs` in `lockfile_dir` resolves to, as","+/// its loader resolves them. Empty when there is no `.pnp.cjs`, it is not a","+/// regular file, or pnpm did not generate it, as with Yarn's.","+pub fn read_pnp_package_dirs(lockfile_dir: &Path) -> Result<Vec<PathBuf>, ReadPnpFileError> {","+    let path = lockfile_dir.join(PNP_FILENAME);","+    let read = |error| ReadPnpFileError::Read { path: path.clone(), error };","+    let dir = match pnpm_fs::OpenDir::open(lockfile_dir) {","+        Ok(dir) => dir,","+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),","+        Err(error) => return Err(read(error)),","+    };","+    let Some(bytes) =","+        dir.read_child_file_bounded(PNP_FILENAME.as_ref(), MAX_PNP_FILE_BYTES).map_err(read)?","+    else {","+        return Ok(Vec::new());","+    };","+    let contents = String::from_utf8_lossy(&bytes);","+    if contents.lines().next() != Some(generated_marker()) {","+        return Ok(Vec::new());","+    }","+    package_dirs_of_loader(&contents, lockfile_dir).ok_or(ReadPnpFileError::Unreadable { path })","+}","+","+/// The first line of every loader pnpm writes.","+fn generated_marker() -> &'static str {","+    PNP_EXPORTS_RESOLVER","+        .lines()","+        .next()","+        .unwrap_or(PNP_EXPORTS_RESOLVER)","+}","+","+/// Parses the values [`render_pnp_loader`] wrote. Each is single-line JSON,","+/// which cannot hold a raw newline, so it ends where its line does.","+fn package_dirs_of_loader(contents: &str, lockfile_dir: &Path) -> Option<Vec<PathBuf>> {","+    let line_value = |prefix: &str, suffix: &str| {","+        contents","+            .lines()","+            .find_map(|line| line.strip_prefix(prefix)?.strip_suffix(suffix))","+    };","+    let registry: serde_json::Value =","+        serde_json::from_str(line_value(\"const registry = \", \".packages\")?).ok()?;","+    let modules_dir: String =","+        serde_json::from_str(line_value(\"const modulesDir = path.resolve(__dirname, \", \")\")?).ok()?;","+    let modules_dir_url = url::Url::from_directory_path(lockfile_dir.join(modules_dir)).ok()?;","+    registry","+        .get(\"packages\")?","+        .as_object()?","+        .values()","+        .map(|package| {","+            let url = modules_dir_url","+                .join(package.get(\"url\")?.as_str()?)","+                .ok()?;","+            url.to_file_path().ok()","+        })","+        .collect()","+}","+"," #[must_use]"," pub fn pnp_path_for_execution(config: &pnpm_config::Config, dir: &Path) -> Option<PathBuf> {","     find_execution_file(config, dir, Path::new(PNP_FILENAME))"],"additions":74,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/pnp/tests.rs","lines":["@@ -2,7 +2,13 @@","     clippy::disallowed_methods,","     reason = \"test setup starts processes the executor does not run\""," )]","-use super::render_pnp_loader;","+use super::{","+    PNP_FILENAME,","+    ReadPnpFileError,","+    package_dirs_of_loader,","+    read_pnp_package_dirs,","+    render_pnp_loader,","+};"," use command_extra::CommandExtra;"," "," #[test]","@@ -114,3 +120,65 @@ fn execution_uses_the_configured_lockfile_directory() {","     std::fs::remove_file(lockfile_dir.join(super::PNP_FILENAME)).unwrap();","     assert_eq!(super::pnp_path_for_execution(&config, &workspace), None);"," }","+","+#[test]","+fn package_dirs_are_read_back_as_the_loader_resolves_them() {","+    let root = tempfile::tempdir().unwrap();","+    let lockfile_dir = root.path().join(\"project\");","+    let store_package = root.path().join(\"store dir/links/@/a/1.0.0/hash/node_modules/a\");","+    let absolute_url = url::Url::from_directory_path(&store_package).unwrap();","+    let registry = serde_json::json!({ \"packages\": {","+        \"a@1.0.0\": { \"url\": \"../../store%20dir/links/@/a/1.0.0/hash/node_modules/a/\", \"dependencies\": {} },","+        \"b@1.0.0\": { \"url\": absolute_url.as_str(), \"dependencies\": {} },","+        \".\": { \"url\": \"../\", \"dependencies\": {} },","+    }});","+    let loader = render_pnp_loader(&registry.to_string(), r#\"\"node_modules\"\"#);","+","+    let mut dirs: Vec<_> = package_dirs_of_loader(&loader, &lockfile_dir)","+        .unwrap()","+        .into_iter()","+        .map(|dir| pnpm_fs::lexical_normalize(&dir))","+        .collect();","+    dirs.sort();","+","+    let mut expected = vec![lockfile_dir, store_package.clone(), store_package];","+    expected.sort();","+    assert_eq!(dirs, expected);","+}","+","+#[test]","+fn a_loader_without_the_registry_is_unrecognized() {","+    assert_eq!(package_dirs_of_loader(\"module.exports = {}\\n\", std::path::Path::new(\"/p\")), None);","+}","+","+#[test]","+fn reading_a_loader_skips_foreign_and_rejects_unreadable_pnpm_loaders() {","+    let dir = tempfile::tempdir().unwrap();","+    let pnp = dir.path().join(PNP_FILENAME);","+","+    assert_eq!(read_pnp_package_dirs(dir.path()).unwrap(), Vec::<std::path::PathBuf>::new());","+","+    std::fs::write(&pnp, \"#!/usr/bin/env node\\n/* yarn */\\n\").unwrap();","+    assert_eq!(read_pnp_package_dirs(dir.path()).unwrap(), Vec::<std::path::PathBuf>::new());","+","+    let bundled = format!(\"#!/usr/bin/env node\\n{}\", super::PNP_EXPORTS_RESOLVER);","+    std::fs::write(&pnp, bundled).unwrap();","+    assert_eq!(read_pnp_package_dirs(dir.path()).unwrap(), Vec::<std::path::PathBuf>::new());","+","+    let registry = serde_json::json!({ \"packages\": { \".\": { \"url\": \"../\", \"dependencies\": {} } } });","+    let loader = render_pnp_loader(&registry.to_string(), r#\"\"node_modules\"\"#);","+    std::fs::write(&pnp, &loader).unwrap();","+    assert_eq!(read_pnp_package_dirs(dir.path()).unwrap().len(), 1);","+","+    std::fs::write(&pnp, loader.replace(\"const registry = \", \"const registry =\\n  \")).unwrap();","+    assert!(matches!(read_pnp_package_dirs(dir.path()), Err(ReadPnpFileError::Unreadable { .. }),));","+}","+","+#[cfg(unix)]","+#[test]","+fn reading_a_loader_does_not_follow_a_symlink() {","+    let dir = tempfile::tempdir().unwrap();","+    std::os::unix::fs::symlink(\"/dev/zero\", dir.path().join(PNP_FILENAME)).unwrap();","+","+    assert_eq!(read_pnp_package_dirs(dir.path()).unwrap(), Vec::<std::path::PathBuf>::new());","+}"],"additions":69,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/errors.rs","lines":["@@ -48,7 +48,17 @@ pub(super) fn map_fresh_lockfile_error(error: InstallWithFreshLockfileError) ->"," #[derive(Debug, Display, Error, Diagnostic)]"," pub enum InstallError {","     #[diagnostic(transparent)]","-    RegisterLoadedProject(#[error(source)] pnpm_store_dir::RegisterProjectError),","+    RegisterProject(#[error(source)] pnpm_store_dir::RegisterProjectError),","+","+    #[display(","+        \"Failed to create the modules directory at {dir:?} to register it in the store: {error}\"","+    )]","+    #[diagnostic(code(ERR_PNPM_CREATE_MODULES_DIR))]","+    CreateModulesDirForRegistry {","+        dir: std::path::PathBuf,","+        #[error(source)]","+        error: std::io::Error,","+    },"," ","     #[display(\"Failed to create the store loader directory at {dir:?}: {error}\")]","     #[diagnostic(code(ERR_PNPM_CREATE_STORE_LOADER_DIR))]"],"additions":11,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run/fast_path.rs","lines":["@@ -204,34 +204,29 @@ pub(super) fn report_already_up_to_date<Reporter: self::Reporter>("," /// fast paths call it before they short-circuit, so a project installed"," /// unregistered still gets an entry. Store prune walks the workspace's"," /// `node_modules` to find every installed package, so one entry per","-/// workspace is enough. A frozen store is read-only, but a global virtual","-/// store install still registers