{"id":"3d6ff9f6fa9cdc857bfb180736dc06b043f55384","axis":"silent","repo":"mongodb/mongo","sha":"3d6ff9f6fa9cdc857bfb180736dc06b043f55384","parsed":{"files":[{"path":"bazel/platforms/BUILD.bazel","lines":["@@ -1,10 +1,17 @@"," # Define supported build platforms."," load(\"//bazel/platforms:platform_util.bzl\", \"setup_platform\")","+load(\"@rules_python//python:defs.bzl\", \"py_test\")"," "," package(default_visibility = [\"//visibility:public\"])"," "," exports_files([\"platform_util.bzl\"])"," ","+py_test(","+    name = \"local_config_platform_test\",","+    srcs = [\"local_config_platform_test.py\"],","+    data = [\"local_config_platform.bzl\"],","+)","+"," constraint_setting(name = \"mongo_toolchain\")"," "," constraint_value("],"additions":7,"deletions":0,"truncated":false},{"path":"bazel/platforms/local_config_platform.bzl","lines":["@@ -3,6 +3,31 @@ load(\"//bazel/platforms:normalize.bzl\", \"ARCH_NORMALIZE_MAP\", \"ARCH_TO_PLATFORM_"," load(\"//bazel/toolchains/cc/mongo_linux:mongo_toolchain_version.bzl\", \"TOOLCHAIN_MAP\")"," load(\"//bazel:utils.bzl\", \"get_host_distro_major_version\")"," ","+def _write_windows_cross_execution_platform(ctx):","+    # Only the opted-in Windows wrapper supplies these values. Keep the normal","+    # host platform unchanged, and override inherited remote properties on the","+    # cross execution platform itself rather than remote-default properties.","+    image = ctx.os.environ.get(\"MONGO_WINDOWS_CROSS_RBE_PLATFORM_IMAGE\")","+    if not image:","+        return","+    distro = ctx.os.environ.get(\"MONGO_WINDOWS_CROSS_RBE_PLATFORM_DISTRO\")","+    if distro not in REMOTE_EXECUTION_CONTAINERS:","+        fail(\"Unsupported Windows cross execution distro: %s\" % distro)","+    pool = ctx.os.environ.get(\"MONGO_WINDOWS_CROSS_RBE_POOL\") or \"x86_64\"","+    if pool.lower() in [\"arm64\", \"aarch64\", \"default\"]:","+        fail(\"Windows cross execution requires an x86_64 pool\")","+    ctx.file(\"windows_cross/BUILD.bazel\", \"\"\"","+package(default_visibility = [\"//visibility:public\"])","+platform(","+    name = \"exec\",","+    parents = [%s],","+    exec_properties = %s,","+)","+\"\"\" % (","+        json.encode(\"@//bazel/platforms:%s_amd64_windows_cross_exec\" % distro),","+        json.encode({\"container-image\": image, \"Pool\": pool, \"dockerNetwork\": \"standard\"}),","+    ))","+"," def _setup_local_config_platform(ctx):","     \"\"\"","     Generates our own local_config_platform, overriding bazel's built in generation.","@@ -11,6 +36,8 @@ def _setup_local_config_platform(ctx):","     without need to specify a specific platform.","     \"\"\""," ","+    _write_windows_cross_execution_platform(ctx)","+","     if \"win\" in ctx.os.name:","         os = \"windows\"","     elif \"mac\" in ctx.os.name:","@@ -137,9 +164,25 @@ setup_local_config_platform = repository_rule(","             doc = \"Template modeling the builtin local config platform constraints file.\",","         ),","     },","+    # Track these inputs so Bazel regenerates the platforms when their values change.","     environ = [","+        # User override for the detected distro used to configure the normal host platform.","+        # The Windows-cross wrapper also uses it when selecting its Linux execution distro.","         \"MONGO_HERMETIC_CONTAINER_DISTRO\",","+        # User override for the RBE image on the normal host platform. Also serves as the","+        # Windows-cross image fallback when MONGO_WINDOWS_CROSS_RBE_CONTAINER_IMAGE is unset.","         \"MONGO_HERMETIC_CONTAINER_IMAGE\",","+        # Resolved docker:// image supplied by the Windows-cross wrapper. Its presence","+        # enables the separate Linux execution platform used for Windows-cross actions.","+        \"MONGO_WINDOWS_CROSS_RBE_PLATFORM_IMAGE\",","+        # Resolved Linux distro supplied by that wrapper; selects the execution platform's","+        # parent constraints and compiler flags while preserving the Windows host platform.","+        \"MONGO_WINDOWS_CROSS_RBE_PLATFORM_DISTRO\",","+        # EngFlow worker pool for Windows-cross actions. Defaults to x86_64; custom pools","+        # must provide Linux x86_64 workers for the cross toolchain.","+        \"MONGO_WINDOWS_CROSS_RBE_POOL\",","+        # Set to 1 to select the native toolchain for the normal host platform instead of","+        # configuring the managed MongoDB toolchain and its remote container image.","         \"USE_NATIVE_TOOLCHAIN\",","     ],"," )"],"additions":43,"deletions":0,"truncated":false},{"path":"bazel/platforms/local_config_platform_test.py","lines":["@@ -0,0 +1,77 @@","+\"\"\"Tests for the repository-generated Windows cross execution platform.\"\"\"","+","+import ast","+import json","+import unittest","+from pathlib import Path","+from types import SimpleNamespace","+from unittest import mock","+","+","+class WindowsCrossExecutionPlatformTest(unittest.TestCase):","+    def setUp(self):","+        path = Path(__file__).with_name(\"local_config_platform.bzl\")","+        tree = ast.parse(path.read_text())","+        helper = next(","+            node","+            for node in tree.body","+            if isinstance(node, ast.FunctionDef)","+            and node.name == \"_write_windows_cross_execution_platform\"","+        )","+        self.namespace = {","+            \"json\": SimpleNamespace(encode=json.dumps),","+            \"REMOTE_EXECUTION_CONTAINERS\": {\"ubuntu24\": {}},","+            \"fail\": lambda message: (_ for _ in ()).throw(ValueError(message)),","+        }","+        exec(compile(ast.Module(body=[helper], type_ignores=[]), str(path), \"exec\"), self.namespace)","+","+    def test_selected_properties_override_parent_and_preserve_constraints(self):","+        image = \"docker://example.com/custom@sha256:abc\"","+        ctx = SimpleNamespace(","+            os=SimpleNamespace(","+                environ={","+                    \"MONGO_WINDOWS_CROSS_RBE_PLATFORM_IMAGE\": image,","+                    \"MONGO_WINDOWS_CROSS_RBE_PLATFORM_DISTRO\": \"ubuntu24\",","+                    \"MONGO_WINDOWS_CROSS_RBE_POOL\": \"custom-x64\",","+                }","+            ),","+            file=mock.Mock(),","+        )","+        self.namespace[\"_write_windows_cross_execution_platform\"](ctx)","+        native_platform = mock.Mock()","+        exec(ctx.file.call_args.args[1], {\"package\": mock.Mock(), \"platform\": native_platform})","+        platform = native_platform.call_args.kwargs","+        self.assertEqual(","+            platform[\"parents\"], [\"@//bazel/platforms:ubuntu24_amd64_windows_cross_exec\"]","+        )","+        self.assertEqual(","+            platform[\"exec_properties\"],","+            {\"container-image\": image, \"Pool\": \"custom-x64\", \"dockerNetwork\": \"standard\"},","+        )","+","+    def test_native_platform_generation_is_unchanged(self):","+        ctx = SimpleNamespace(os=SimpleNamespace(environ={}), file=mock.Mock())","+        self.namespace[\"_write_windows_cross_execution_platform\"](ctx)","+        ctx.file.assert_not_called()","+","+    def test_invalid_distro_or_incompatible_pool_is_rejected(self):","+        for overrides in (","+            {\"MONGO_WINDOWS_CROSS_RBE_PLATFORM_DISTRO\": \"unknown\"},","+            {\"MONGO_WINDOWS_CROSS_RBE_POOL\": \"arm64\"},","+        ):","+            ctx = SimpleNamespace(","+                os=SimpleNamespace(","+                    environ={","+                        \"MONGO_WINDOWS_CROSS_RBE_PLATFORM_IMAGE\": \"docker://image\",","+                        \"MONGO_WINDOWS_CROSS_RBE_PLATFORM_DISTRO\": \"ubuntu24\",","+                        **overrides,","+                    }","+                ),","+                file=mock.Mock(),","+            )","+            with self.subTest(overrides=overrides), self.assertRaises(ValueError):","+                self.namespace[\"_write_windows_cross_execution_platform\"](ctx)","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"additions":77,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/BUILD.bazel","lines":["@@ -11,6 +11,17 @@ exports_files(["," py_library(","     name = \"container_action\",","     srcs = [\"container_action.py\"],","+    data = [\":container_action_scripts\"],","+)","+","+filegroup(","+    name = \"container_action_scripts\",","+    srcs = [","+        \"scripts/action_supervisor.sh\",","+        \"scripts/input_probe.sh\",","+        \"scripts/input_probe_setup.sh\",","+        \"scripts/mount_windows_drives.sh\",","+    ],"," )"," "," py_library("],"additions":11,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/container_action.py","lines":["@@ -62,49 +62,21 @@"," ACTION_LEASE_SECONDS = 30"," ACTION_HEARTBEAT_INTERVAL_SECONDS = 5"," ACTION_TERMINATION_GRACE_SECONDS = 1","+# Opt-in scratch ownership stays with the supervisor, outside the tool process group.","+# It can therefore remove link temporary files even after killing an unresponsive tool.","+ACTION_PRIVATE_SCRATCH_ENV = \"MONGO_CROSS_ACTION_PRIVATE_SCRATCH\""," # Bash job control gives only this tool and its descendants a fresh process group. The"," # supervisor stays outside that group so it can stop and reap the tool before acknowledging"," # cancellation. A renewable lease also stops actions when Windows terminates the host runner"," # without giving Python a chance to run a signal handler or finally block.","-ACTION_OUTPUT_CAPTURE_SCRIPT = f\"\"\"","-log=\"${ACTION_OUTPUT_LOG_ENV}\"","-/bin/mkdir -p \"${{log%/*}}\" || exit 125","-set -m","-\"$0\" \"$@\" >\"$log\" 2>&1 &","-tool_pid=$!","-set +m","-terminate_tool() {{","-    trap '' INT TERM HUP","-    kill -TERM -- \"-$tool_pid\" 2>/dev/null || true","-    /bin/sleep {ACTION_TERMINATION_GRACE_SECONDS}","-    kill -KILL -- \"-$tool_pid\" 2>/dev/null || true","-    wait \"$tool_pid\" 2>/dev/null || true","-}}","-trap 'terminate_tool; printf \"125\\\\n\" >\"$log{ACTION_EXIT_FILE_SUFFIX}\"; exit 125' INT TERM HUP","-heartbeat=\"\"","-renewed=$SECONDS","-while kill -0 \"$tool_pid\" 2>/dev/null; do","-    current=\"\"","-    if [ -f \"$log{ACTION_HEARTBEAT_SUFFIX}\" ]; then","-        IFS= read -r current <\"$log{ACTION_HEARTBEAT_SUFFIX}\" || true","-    fi","-    if [ -n \"$current\" ] && [ \"$current\" != \"$heartbeat\" ]; then","-        heartbeat=\"$current\"","-        renewed=$SECONDS","-    fi","-    if [ -f \"$log{ACTION_CANCEL_SUFFIX}\" ] || (( SECONDS - renewed >= {ACTION_LEASE_SECONDS} )); then","-        terminate_tool","-        printf \"125\\\\n\" >\"$log{ACTION_EXIT_FILE_SUFFIX}\"","-        exit 125","-    fi","-    /bin/sleep 0.1","-done","-wait \"$tool_pid\"","-status=$?","-# A tool that finishes before a background child must not leave that child in the container.","-kill -KILL -- \"-$tool_pid\" 2>/dev/null || true","-printf '%s\\\\n' \"$status\" >\"$log{ACTION_EXIT_FILE_SUFFIX}\"","-\"\"\"","+# Only policy values are rendered; the shell program is a standalone source file.","+ACTION_OUTPUT_CAPTURE_SCRIPT = (","+    f\"lease_seconds={ACTION_LEASE_SECONDS}\\n\"","+    f\"termination_grace_seconds={ACTION_TERMINATION_GRACE_SECONDS}\\n\"","+    + (pathlib.Path(__file__).parent / \"scripts\" / \"action_supervisor.sh\").read_text(","+        encoding=\"utf-8\"","+    )","+)"," ACTION_COMPLETION_TIMEOUT_ENV = \"MONGO_CROSS_ACTION_TIMEOUT_SECONDS\""," ACTION_COMPLETION_TIMEOUT_DEFAULT_SECONDS = 10800.0"," ACTION_COMPLETION_POLL_SECONDS = 0.25","@@ -156,34 +128,18 @@ def _request_timeout(deadline: float) -> float:","     return max(0.001, min(ACTION_HEARTBEAT_INTERVAL_SECONDS, deadline - time.monotonic()))"," "," ","-CONTAINER_INPUT_PROBE_SETUP_SCRIPT = r\"\"\"","-probe=$1","-owner=$2","-umask 077","-/bin/chmod 700 \"$probe\" &&","-    /bin/chmod 600 \"$probe/manifest\" &&","-    /bin/chown -- \"$owner\" \"$probe/manifest\" &&","-    : >\"$probe/ready\" &&","-    /bin/chown -- \"$owner\" \"$probe\"","-\"\"\"","+CONTAINER_INPUT_PROBE_SETUP_SCRIPT = (","+    pathlib.Path(__file__).parent / \"scripts\" / \"input_probe_setup.sh\"","+).read_text(encoding=\"utf-8\")"," ","-CONTAINER_INPUT_PROBE_SCRIPT = r\"\"\"","-probe=$1","-budget=$2","-count=$3","-/usr/bin/timeout --kill-after=1s \"${budget}s\" /bin/bash -c '","-    while [ ! -e \"$1/ready\" ]; do /bin/sleep 0.05; done","-    exec >\"$1/result.tmp\" || exit 1","-    index=0","-    while IFS= read -r -d \"\" path; do","-        [ -e \"$path\" ] || printf \"%s\\n\" \"$index\"","-        index=$((index + 1))","-    done <\"$1/manifest\"","-    [ \"$index\" -eq \"$2\" ] || exit 1","-    printf \"done %s\\n\" \"$index\"","-' _ \"$probe\" \"$count\" &&","-    /bin/mv \"$probe/result.tmp\" \"$probe/result\"","-\"\"\"","+CONTAINER_INPUT_PROBE_SCRIPT = (","+    pathlib.Path(__file__).parent / \"scripts\" / \"input_probe.sh\"","+).read_text(encoding=\"utf-8\")","+","+","+WINDOWS_DRIVE_MOUNT_SCRIPT = (","+    pathlib.Path(__file__).parent / \"scripts\" / \"mount_windows_drives.sh\"","+).read_text(encoding=\"utf-8\")"," "," "," def missing_container_path_indices(","@@ -451,17 +407,22 @@ def mount_windows_drives_in_docker_vm(","     \"\"\"","     if not drives:","         return True, \"no drives to mount\"","-    steps = []","-    for drive in drives:","-        mountpoint = f\"{prefix}/{drive}\"","-        steps.append(","-            f\"mkdir -p {mountpoint}; \"","-            f\"mountpoint -q {mountpoint} || mount -t drvfs {drive.upper()}: {mountpoint} || \"","-            f\"echo mount of {drive.upper()}: at {mountpoint} failed\"","-        )","-    script = \"; \".join(steps) + \"; grep -E ' /mnt/[a-z]+ ' /proc/mounts; ls -la /mnt\"","     exit_code, logs = _run_helper_container(","-        docker, image, [\"nsenter\", \"-t\", \"1\", \"-m\", \"--\", \"sh\", \"-c\", script]","+        docker,","+        image,","+        [","+            \"nsenter\",","+            \"-t\",","+            \"1\",","+            \"-m\",","+            \"--\",","+            \"sh\",","+            \"-c\",","+            WINDOWS_DRIVE_MOUNT_SCRIPT,","+            \"mount-windows-drives\",","+            prefix,","+            *drives,","+        ],","     )","     ok = exit_code == 0 and \"failed\" not in logs","     return ok, f\"exit {exit_code}\\n{logs}\""],"additions":37,"deletions":76,"truncated":false},{"path":"bazel/toolchains/cc/container_action_test.py","lines":["@@ -453,9 +453,7 @@ def fake_run(args, *, stdout=None, stderr=None, timeout=None):","                             _, capture = shared._action_output_capture(","                                 pathlib.PurePosixPath(root / \"lost.log\"), command","                             )","-                            capture[2] = capture[2].replace(","-                                \"SECONDS - renewed >= 30\", \"SECONDS - renewed >= 1\"","-                            )","+                            capture[2] = capture[2].replace(\"lease_seconds=30\", \"lease_seconds=1\")","                             environment = dict(","                                 os.environ, MONGO_CROSS_ACTION_OUTPUT_LOG=str(root / \"lost.log\")","                             )","@@ -934,13 +932,47 @@ def fake_run(args, *, stdout=None, stderr=None, timeout=None):","         self.assertEqual(","             run_call[image_index + 1 : image_index + 7], [\"nsenter\", \"-t\", \"1\", \"-m\", \"--\", \"sh\"]","         )","-        script = run_call[-1]","-        self.assertIn(\"mount -t drvfs C: /mnt/c\", script)","-        self.assertIn(\"mount -t drvfs Z: /mnt/z\", script)","-        self.assertIn(\"mountpoint -q /mnt/z\", script)","+        self.assertEqual(","+            run_call[image_index + 7 :],","+            [\"-c\", shared.WINDOWS_DRIVE_MOUNT_SCRIPT, \"mount-windows-drives\", \"/mnt\", \"c\", \"z\"],","+        )","         # The helper container is always removed again.","         self.assertTrue(any(\"rm\" in call and \"-f\" in call for call in calls))"," ","+    @unittest.skipIf(os.name == \"nt\", \"The mount helper executes inside Linux containers\")","+    def test_drive_mount_script_preserves_prefix_and_uppercases_drives(self):","+        with tempfile.TemporaryDirectory() as directory:","+            root = pathlib.Path(directory)","+            for name in (\"mkdir\", \"mountpoint\", \"mount\", \"grep\", \"ls\"):","+                command = root / name","+                command.write_text(","+                    \"#!/bin/sh\\n\"","+                    'printf \"%s\\\\0\" \"${0##*/}\" \"$@\" >>\"$COMMAND_LOG\"\\n'","+                    'printf \"\\\\n\" >>\"$COMMAND_LOG\"\\n'","+                    '[ \"${0##*/}\" != \"mountpoint\" ]\\n',","+                    encoding=\"utf-8\",","+                )","+                command.chmod(0o755)","+            log = root / \"commands\"","+            prefix = \"/drive mounts;literal'\"","+            result = subprocess.run(","+                [\"/bin/sh\", \"-c\", shared.WINDOWS_DRIVE_MOUNT_SCRIPT, \"_\", prefix, \"c\", \"z\"],","+                env={**os.environ, \"PATH\": f\"{root}:/usr/bin:/bin\", \"COMMAND_LOG\": str(log)},","+                capture_output=True,","+                timeout=5,","+            )","+            self.assertEqual(result.returncode, 0, result.stderr)","+            calls = [","+                line.decode().rstrip(\"\\0\").split(\"\\0\") for line in log.read_bytes().splitlines()","+            ]","+            self.assertEqual(","+                [call for call in calls if call[0] == \"mount\"],","+                [","+                    [\"mount\", \"-t\", \"drvfs\", \"C:\", f\"{prefix}/c\"],","+                    [\"mount\", \"-t\", \"drvfs\", \"Z:\", f\"{prefix}/z\"],","+                ],","+            )","+","     def test_mount_windows_drives_in_docker_vm_reports_failures(self):","         def fake_run(args, *, stdout=None, stderr=None, timeout=None):","             if \"run\" in args:"],"additions":39,"deletions":7,"truncated":false},{"path":"bazel/toolchains/cc/mongo_apple_cross/BUILD.bazel","lines":["@@ -14,6 +14,7 @@ sh_binary(","     data = [","         \"//bazel:hermetic_container/container_paths.py\",","         \"//bazel/toolchains/cc:container_action.py\",","+        \"//bazel/toolchains/cc:container_action_scripts\",","         \"//bazel/toolchains/cc:container_engine.py\",","         \"//bazel/toolchains/cc:container_mounts.py\",","     ],"],"additions":1,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/BUILD.bazel","lines":["@@ -1,4 +1,4 @@","-load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_test\")","+load(\"@rules_python//python:defs.bzl\", \"py_binary\", \"py_library\", \"py_test\")"," load(\"@rules_shell//shell:sh_binary.bzl\", \"sh_binary\")"," "," package(default_visibility = [\"//visibility:public\"])","@@ -9,6 +9,7 @@ exports_files([","     \"windows_cross_lib_aliases.py\",","     \"write_case_insensitive_vfs.py\",","     \"windows_cross_action_wrapper.py\",","+    \"windows_container_action_wrapper.py\","," ])"," "," sh_binary(","@@ -59,3 +60,24 @@ py_test(","     ],","     main = \"windows_cross_toolchain_test.py\","," )","+","+py_library(","+    name = \"windows_container_action_wrapper_lib\",","+    srcs = [\"windows_container_action_wrapper.py\"],","+    data = [","+        \"scripts/action.sh\",","+        \"scripts/diagnostics.sh\",","+        \"scripts/mount_probe.sh\",","+    ],","+    deps = [","+        \"//bazel:container_paths\",","+        \"//bazel/toolchains/cc:container_runtime\",","+    ],","+)","+","+py_test(","+    name = \"windows_container_action_wrapper_test\",","+    srcs = [\"windows_container_action_wrapper_test.py\"],","+    main = \"windows_container_action_wrapper_test.py\",","+    deps = [\":windows_container_action_wrapper_lib\"],","+)"],"additions":23,"deletions":1,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/scripts/action.sh","lines":["@@ -0,0 +1,3 @@","+#!/bin/sh","+# Scratch cleanup belongs to the shared supervisor, so replace this shim with the tool.","+exec \"$@\""],"additions":3,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/scripts/diagnostics.sh","lines":["@@ -0,0 +1,11 @@","+#!/bin/sh","+# $1: action working directory, $2: executable. Use the container utilities' PATH.","+PATH=\"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\"","+echo \"working directory: $1\"","+ls -ld \"$1\" 2>&1","+echo \"tool: $2\"","+ls -lL \"$2\" 2>&1","+readlink -f \"$2\" 2>&1","+echo \"drive mounts inside the container:\"","+grep -E ' /mnt/[a-z]+(/| )' /proc/mounts 2>&1","+ls -la /mnt 2>&1"],"additions":11,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/scripts/mount_probe.sh","lines":["@@ -0,0 +1,44 @@","+#!/bin/sh","+# $1/$2: output-base/repository probes, $3: sandbox probe, $4: optional NTFS","+# symlink probe, $5: expected target. Write checks run in subshells so an expected","+# read-only redirection failure cannot abort the remaining checks.","+# Use the container utilities' PATH without changing the tool action's PATH.","+PATH=\"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\"","+status=0","+present() {","+    if [ -e \"$1\" ]; then echo \"present: $1\"; else","+        echo \"MISSING: $1\"","+        status=1","+    fi","+}","+can_write() {","+    (: >\"$1\") 2>/dev/null","+}","+present \"$1\"","+present \"$2\"","+present \"$3\"","+if can_write \"$1.container-write\"; then","+    rm -f \"$1.container-write\"","+    echo \"WRITABLE (expected read-only): ${1%/*}\"","+    status=1","+else","+    echo \"read-only: ${1%/*}\"","+fi","+if can_write \"$3.container-write\"; then","+    rm -f \"$3.container-write\"","+    echo \"writable: ${3%/*}\"","+else","+    echo \"NOT WRITABLE: ${3%/*}\"","+    status=1","+fi","+if [ -n \"$4\" ]; then","+    target=\"$(readlink \"$4\" 2>&1)\"","+    echo \"symlink: $4 -> $target\"","+    if [ -f \"$4\" ]; then","+        echo \"symlink resolves: $4\"","+    else","+        echo \"SYMLINK DOES NOT RESOLVE (expected target $5): $4\"","+        status=1","+    fi","+fi","+exit $status"],"additions":44,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_container_action_wrapper.py","lines":["@@ -0,0 +1,867 @@","+#!/usr/bin/env python3","+\"\"\"Runs Windows-host cross build actions inside a persistent Linux action container.","+","+Invoked by Bazel's persistent-container spawn strategy on Windows hosts with the same","+contract as bazel/toolchains/cc/mongo_linux/linux_container_action_wrapper.py:","+","+    windows_container_action_wrapper.py CONFIG_JSON REAL_TOOL [ARGS...]","+    windows_container_action_wrapper.py --ensure-container CONFIG_JSON","+","+CONFIG_JSON is written to the Bazel output base by bazel/wrapper_hook/hermetic_container_integration.py","+before the build starts. Bazel prepares the action's declared-input sandbox on the Windows host","+and runs this script with the sandbox execroot as its working directory; the script executes","+REAL_TOOL at the same location inside the container.","+","+The container is started from the pinned image the Windows cross configuration advertises for","+remote execution, so a link that runs here produces the same result as one that runs on RBE.","+","+Windows-specific behaviour, compared with the Linux runner:","+","+* The Linux Docker Engine on the Windows CI images runs inside a WSL2 distribution, where the","+  Windows drives appear as ``/mnt/<drive>``. Every host path is translated to that layout and the","+  drives are mounted at the same ``/mnt/<drive>`` paths inside the container, so the NTFS symlinks","+  Bazel plants in the sandbox resolve to the same targets inside the container.","+* That engine is reached over TCP and does not deliver ``docker exec`` output or exit statuses","+  reliably, so actions run detached and report through files in the container that are copied","+  back with ``docker cp``.","+* Windows has no uid mapping into the container; actions run as the image's default user.","+\"\"\"","+","+from __future__ import annotations","+","+import contextlib","+import hashlib","+import json","+import os","+import pathlib","+import re","+import shlex","+import shutil","+import subprocess","+import sys","+import tempfile","+import uuid","+from collections.abc import Iterator, Mapping, Sequence","+","+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[4]))","+from bazel.hermetic_container import container_paths","+from bazel.toolchains.cc import container_action as shared","+from bazel.toolchains.cc import container_engine as engine","+","+_CONTAINER_LAYOUT_VERSION = \"windows-v3\"","+_WORKSPACE_LABEL = \"com.mongodb.windows-container-actions.workspace\"","+_ACTION_CONTAINER_ENV = \"MONGO_LINUX_ACTION_CONTAINER\"","+_DEFAULT_DRIVE_MOUNT_PREFIX = \"/mnt\"","+_DEFAULT_DOCKER_HOST = \"tcp://127.0.0.1:2375\"","+_WSL_DOCKER_HOST_MODES = frozenset({\"wsl\", \"wsl-local\"})","+_START_LOCK_FILENAME = \"windows-container-actions.lock\"","+_RUNNER_SCRATCH_DIRNAME = \"windows-container-runner\"","+_MOUNT_PROBE_PREFIX = \".mongo-windows-action-mount-\"","+_PREFLIGHT_COMMAND_TIMEOUT_SECONDS = 180.0","+_DIAGNOSTIC_COMMAND_TIMEOUT_SECONDS = 60.0","+_ENV_FILE_UNSUPPORTED_MARKER = \"unknown flag: --env-file\"","+_DRIVE_PATH_RE = re.compile(r\"^[A-Za-z]:[\\\\/]\")","+","+# Environment variables that describe the Windows host or this runner's own Docker routing.","+# They are meaningless inside the Linux container and must not leak into the action, which","+# otherwise sees the environment Bazel computed for it (also what the RBE workers see).","+_HOST_ONLY_ENVIRONMENT = frozenset(","+    {","+        \"ALLUSERSPROFILE\",","+        \"APPDATA\",","+        \"COMMONPROGRAMFILES\",","+        \"COMMONPROGRAMFILES(X86)\",","+        \"COMMONPROGRAMW6432\",","+        \"COMPUTERNAME\",","+        \"COMSPEC\",","+        \"DOCKER_API_VERSION\",","+        \"DOCKER_CERT_PATH\",","+        \"DOCKER_CONFIG\",","+        \"DOCKER_CONTEXT\",","+        \"DOCKER_HOST\",","+        \"DOCKER_TLS_VERIFY\",","+        \"DRIVERDATA\",","+        \"HOME\",","+        \"HOMEDRIVE\",","+        \"HOMEPATH\",","+        \"LOCALAPPDATA\",","+        \"LOGONSERVER\",","+        \"NUMBER_OF_PROCESSORS\",","+        \"OS\",","+        \"PATHEXT\",","+        \"PROCESSOR_ARCHITECTURE\",","+        \"PROCESSOR_IDENTIFIER\",","+        \"PROCESSOR_LEVEL\",","+        \"PROCESSOR_REVISION\",","+        \"PROGRAMDATA\",","+        \"PROGRAMFILES\",","+        \"PROGRAMFILES(X86)\",","+        \"PROGRAMW6432\",","+        \"PSMODULEPATH\",","+        \"PUBLIC\",","+        \"PWD\",","+        \"SESSIONNAME\",","+        \"SYSTEMDRIVE\",","+        \"SYSTEMROOT\",","+        \"TEMP\",","+        \"TMP\",","+        \"TMPDIR\",","+        \"USERDOMAIN\",","+        \"USERDOMAIN_ROAMINGPROFILE\",","+        \"USERNAME\",","+        \"USERPROFILE\",","+        \"WINDIR\",","+        shared.ACTION_OUTPUT_LOG_ENV,","+        engine.DOCKER_HOST_MODE_ENV,","+        engine.WSL_DISTRIBUTION_ENV,","+        engine.WSL_DOCKER_SOCKET_ENV,","+    }","+)","+","+# The shared supervisor owns private temporary/home directories so cleanup survives tool","+# cancellation. Replace the shim with the tool rather than adding another process to reap.","+_ACTION_SHIM = (pathlib.Path(__file__).parent / \"scripts\" / \"action.sh\").read_text(encoding=\"utf-8\")","+","+# Read scripts on the host and transmit them through the shared runner: they need not","+# be mounted inside the container or have an NTFS executable bit.","+_MOUNT_PROBE_SCRIPT = (pathlib.Path(__file__).parent / \"scripts\" / \"mount_probe.sh\").read_text(","+    encoding=\"utf-8\"","+)","+","+_DIAGNOSTICS_SCRIPT = (pathlib.Path(__file__).parent / \"scripts\" / \"diagnostics.sh\").read_text(","+    encoding=\"utf-8\"","+)","+","+","+def _read_config(config_path: pathlib.Path) -> dict:","+    config = json.loads(config_path.read_text(encoding=\"utf-8\"))","+    if not isinstance(config, dict):","+        raise ValueError(\"container action config must be a JSON object\")","+    for key in (\"image\", \"docker_command\", \"repo_root\", \"sandbox_base\"):","+        if not config.get(key):","+            raise ValueError(f\"container action config is missing {key!r}\")","+    return config","+","+","+def _apply_runner_environment(config: Mapping[str, object]) -> None:","+    \"\"\"Restores the host settings the Docker CLI needs.","+","+    Bazel starts the runner with the action's environment, which has no Windows system","+    variables and a PATH made of the toolchain's relative directories. The wrapper hook","+    records what the CLI needs when it writes the config.","+    \"\"\"","+    runner_environment = config.get(\"runner_environment\") or {}","+    if isinstance(runner_environment, Mapping):","+        for key, value in runner_environment.items():","+            if isinstance(key, str) and isinstance(value, str):","+                os.environ[key] = value","+    os.environ[engine.DOCKER_HOST_MODE_ENV] = str(config.get(\"docker_host_mode\") or \"\")","+    if config.get(\"docker_host_mode\") == engine.WSL_DOCKER_HOST_MODE:","+        os.environ.setdefault(\"DOCKER_HOST\", _DEFAULT_DOCKER_HOST)","+    if _uses_wsl_engine(config):","+        # DOCKER_CONTEXT takes precedence over DOCKER_HOST in the Docker CLI.","+        os.environ.pop(\"DOCKER_CONTEXT\", None)","+","+","+def _uses_wsl_engine(config: Mapping[str, object]) -> bool:","+    return str(config.get(\"docker_host_mode\") or \"\").lower() in _WSL_DOCKER_HOST_MODES","+","+","+def _docker_command(config: Mapping[str, object]) -> list[str]:","+    docker = shlex.split(str(config[\"docker_command\"]))","+    if docker and pathlib.PureWindowsPath(docker[0]).name.lower() == \"wsl.exe\":","+        # A Linux CLI opened through WSL cannot read Windows paths passed to --env-file","+        # or docker cp. Keep this boundary local to the runner; shared transport still","+        # receives the host paths it uses for files and cleanup.","+        return [","+            sys.executable,","+            str(pathlib.Path(__file__).resolve()),","+            \"--docker-cli\",","+            json.dumps(docker),","+            _drive_mount_prefix(config),","+        ]","+    return docker","+","+","+def _wsl_client_file_args(","+    args: Sequence[str], prefix: str = _DEFAULT_DRIVE_MOUNT_PREFIX","+) -> list[str]:","+    \"\"\"Translate CLI-owned files without rewriting container paths or action arguments.\"\"\"","+    args = list(args)","+    if args and args[0] == \"cp\":","+        for index in range(1, len(args)):","+            if _DRIVE_PATH_RE.match(args[index]):","+                args[index] = _container_path(args[index], prefix).as_posix()","+    elif args and args[0] == \"exec\":","+        index = 1","+        value_options = {","+            \"-w\",","+            \"--workdir\",","+            \"-u\",","+            \"--user\",","+            \"-e\",","+            \"--env\",","+            \"--env-file\",","+            \"--detach-keys\",","+        }","+        while index < len(args) and args[index].startswith(\"-\"):","+            option = args[index]","+            if option == \"--env-file\" and index + 1 < len(args):","+                index += 1","+                if _DRIVE_PATH_RE.match(args[index]):","+                    args[index] = _container_path(args[index], prefix).as_posix()","+            elif option in value_options:","+                index += 1","+            index += 1","+    return args","+","+","+def _drive_mount_prefix(config: Mapping[str, object]) -> str:","+    return container_paths.drive_mount_prefix(","+        str(config.get(\"drive_mount_prefix\") or _DEFAULT_DRIVE_MOUNT_PREFIX)","+    )","+","+","+def _container_path(","+    path: pathlib.PurePath | str, prefix: str = _DEFAULT_DRIVE_MOUNT_PREFIX","+) -> pathlib.PurePosixPath:","+    \"\"\"Translate a drive-qualified host path using the shared WSL path policy.\"\"\"","+    if not _DRIVE_PATH_RE.match(os.fspath(path)):","+        raise ValueError(f\"expected an absolute Windows drive path, got {path!r}\")","+    return pathlib.PurePosixPath(container_paths.wsl_volume_source(path, prefix))","+","+","+def _drive_letters(paths: Sequence[object]) -> list[str]:","+    drives: set[str] = set()","+    for path in paths:","+        if not path:","+            continue","+        value = os.fspath(path) if isinstance(path, (str, os.PathLike)) else str(path)"],"additions":239,"deletions":0,"truncated":false}],"additions":535,"deletions":84,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-10-30T15:57:10.876551+00:00"}