t))","+\t\t}","+\t}","+","+\tif hasCelSelector && len(ManagedDRACelSelectors(annotations)) == 0 {","+\t\tallErrs = append(allErrs, field.Invalid(","+\t\t\tannotationsPath.Key(constants.ManagedDRACelSelectorAnnotationKey),","+\t\t\tannotations[constants.ManagedDRACelSelectorAnnotationKey],","+\t\t\t\"cel selector must contain at least one non-empty CEL expression\",","+\t\t))","+\t}","+","+\tif trimmed, present := ManagedDRAContainerName(annotations); present {","+\t\traw := annotations[constants.ManagedDRAContainerNameAnnotationKey]","+\t\tif trimmed == \"\" {","+\t\t\tallErrs = append(allErrs, field.Invalid(","+\t\t\t\tannotationsPath.Key(constants.ManagedDRAContainerNameAnnotationKey),","+\t\t\t\traw,","+\t\t\t\t\"container name must not be empty\",","+\t\t\t))","+\t\t} else if errs := validation.IsDNS1123Label(trimmed); len(errs) > 0 {","+\t\t\tallErrs = append(allErrs, field.Invalid(","+\t\t\t\tannotationsPath.Key(constants.ManagedDRAContainerNameAnnotationKey),","+\t\t\t\traw,","+\t\t\t\t\"container name must be a DNS label: \"+strings.Join(errs, \"; \"),","+\t\t\t))","+\t\t}","+\t}","+","+\treturn allErrs","+}"],"additions":165,"deletions":0,"truncated":false},{"path":"pkg/validation/managed_dra_test.go","lines":["@@ -0,0 +1,155 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package validation","+","+import (","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/kserve/kserve/pkg/constants\"","+)","+","+func TestHasManagedDRA(t *testing.T) {","+\tassert.False(t, HasManagedDRA(nil))","+\tassert.False(t, HasManagedDRA(map[string]string{\"foo\": \"bar\"}))","+\tassert.True(t, HasManagedDRA(map[string]string{constants.ManagedDRADeviceClassAnnotationKey: \"gpu.nvidia.com\"}))","+}","+","+func TestManagedDRADeviceCount(t *testing.T) {","+\tt.Run(\"missing defaults to 1\", func(t *testing.T) {","+\t\tcount, err := ManagedDRADeviceCount(nil)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, 1, count)","+\t})","+\tt.Run(\"valid\", func(t *testing.T) {","+\t\tcount, err := ManagedDRADeviceCount(map[string]string{constants.ManagedDRADeviceCountAnnotationKey: \"4\"})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, 4, count)","+\t})","+\tt.Run(\"zero rejected\", func(t *testing.T) {","+\t\t_, err := ManagedDRADeviceCount(map[string]string{constants.ManagedDRADeviceCountAnnotationKey: \"0\"})","+\t\tassert.Error(t, err)","+\t})","+\tt.Run(\"non-numeric rejected\", func(t *testing.T) {","+\t\t_, err := ManagedDRADeviceCount(map[string]string{constants.ManagedDRADeviceCountAnnotationKey: \"abc\"})","+\t\tassert.Error(t, err)","+\t})","+}","+","+func TestValidateManagedDRAAnnotations(t *testing.T) {","+\tconst (","+\t\tdeviceClassKey   = \"serving.kserve.io/exp-dra-device-class\"","+\t\tdeviceCountKey   = \"serving.kserve.io/exp-dra-device-count\"","+\t\tcelSelectorKey   = \"serving.kserve.io/exp-dra-cel-selector\"","+\t\tcontainerNameKey = \"serving.kserve.io/exp-dra-container-name\"","+\t)","+","+\ttests := []struct {","+\t\tname         string","+\t\tannotations  map[string]string","+\t\twantErrCount int","+\t\twantErrField string","+\t}{","+\t\t{","+\t\t\tname:         \"no annotations\",","+\t\t\tannotations:  nil,","+\t\t\twantErrCount: 0,","+\t\t},","+\t\t{","+\t\t\tname:         \"valid: device class only\",","+\t\t\tannotations:  map[string]string{deviceClassKey: \"gpu.nvidia.com\"},","+\t\t\twantErrCount: 0,","+\t\t},","+\t\t{","+\t\t\tname: \"valid: full valid set\",","+\t\t\tannotations: map[string]string{","+\t\t\t\tdeviceClassKey:   \"gpu.nvidia.com\",","+\t\t\t\tdeviceCountKey:   \"4\",","+\t\t\t\tcelSelectorKey:   \"device.attributes['gpu.nvidia.com']['type'] == 'A100'\",","+\t\t\t\tcontainerNameKey: \"vllm\",","+\t\t\t},","+\t\t\twantErrCount: 0,","+\t\t},","+\t\t{","+\t\t\tname:         \"invalid: empty device class\",","+\t\t\tannotations:  map[string]string{deviceClassKey: \"   \"},","+\t\t\twantErrCount: 1,","+\t\t\twantErrField: deviceClassKey,","+\t\t},","+\t\t{","+\t\t\tname:         \"invalid: device count without device class\",","+\t\t\tannotations:  map[string]string{deviceCountKey: \"2\"},","+\t\t\twantErrCount: 1,","+\t\t\twantErrField: deviceClassKey,","+\t\t},","+\t\t{","+\t\t\tname: \"invalid: device count non-numeric\",","+\t\t\tannotations: map[string]string{","+\t\t\t\tdeviceClassKey: \"gpu.nvidia.com\",","+\t\t\t\tdeviceCountKey: \"abc\",","+\t\t\t},","+\t\t\twantErrCount: 1,","+\t\t\twantErrField: deviceCountKey,","+\t\t},","+\t\t{","+\t\t\tname: \"invalid: empty cel selector\",","+\t\t\tannotations: map[string]string{","+\t\t\t\tdeviceClassKey: \"gpu.nvidia.com\",","+\t\t\t\tcelSelectorKey: \"\\n  \\n\",","+\t\t\t},","+\t\t\twantErrCount: 1,","+\t\t\twantErrField: celSelectorKey,","+\t\t},","+\t\t{","+\t\t\tname: \"invalid: empty container name\",","+\t\t\tannotations: map[string]string{","+\t\t\t\tdeviceClassKey:   \"gpu.nvidia.com\",","+\t\t\t\tcontainerNameKey: \"   \",","+\t\t\t},","+\t\t\twantErrCount: 1,","+\t\t\twantErrField: containerNameKey,","+\t\t},","+\t\t{","+\t\t\tname: \"invalid: multiple errors surfaced\",","+\t\t\tannotations: map[string]string{","+\t\t\t\tdeviceClassKey: \"BAD CLASS\",","+\t\t\t\tdeviceCountKey: \"abc\",","+\t\t\t},","+\t\t\twantErrCount: 2,","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\terrs := ValidateManagedDRAAnnotations(tt.annotations)","+\t\t\trequire.Len(t, errs, tt.wantErrCount, \"errors: %v\", errs)","+\t\t\tif tt.wantErrField != \"\" {","+\t\t\t\tfound := false","+\t\t\t\tfor _, e := range errs {","+\t\t\t\t\tif strings.Contains(e.Field, tt.wantErrField) {","+\t\t\t\t\t\tfound = true","+\t\t\t\t\t\tbreak","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tassert.True(t, found, \"expected error on field %q, got: %v\", tt.wantErrField, errs)","+\t\t\t}","+\t\t})","+\t}","+}",""],"additions":155,"deletions":0,"truncated":false}],"additions":527,"deletions":130,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-08-01T09:54:02.219232+00:00"}