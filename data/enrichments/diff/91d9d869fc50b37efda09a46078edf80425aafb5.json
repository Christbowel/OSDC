{"id":"91d9d869fc50b37efda09a46078edf80425aafb5","axis":"silent","repo":"ray-project/ray","sha":"91d9d869fc50b37efda09a46078edf80425aafb5","parsed":{"files":[{"path":"python/ray/experimental/sandbox/backend/gvisor.py","lines":["@@ -102,6 +102,23 @@"," # overlay state."," _RAY_SANDBOX_DIR = \"/tmp/ray/sandbox\""," ","+","+def runsc_env() -> Dict[str, str]:","+    \"\"\"The environment for runsc CLI subprocesses: GOMAXPROCS=2 unless set.","+","+    Each runsc CLI call (run, restore, exec, state, kill, delete, spec, trace,","+    pause, resume, checkpoint) is a Go process, and Go sizes its runtime to every CPU it can see: on a many-core","+    node, dozens of concurrent calls then cost much more CPU than their work","+    (measured on a 64-core node, 64 `runsc exec` calls at a time: 0.023 CPU-s","+    per exec, 0.013 with GOMAXPROCS=2). gVisor's containerd shim runs runsc","+    with GOMAXPROCS=2 for this reason, and runsc doesn't pass the variable on","+    to the sandbox and gofer processes it starts.","+    \"\"\"","+    env = dict(os.environ)","+    env.setdefault(\"GOMAXPROCS\", \"2\")","+    return env","+","+"," # `runsc run --pid-file` (and `runsc restore`) writes this file once the"," # container exists. The start loop stats it every _START_POLL_SECONDS and"," # asks `runsc state` (a Go process per call) whether the container runs only","@@ -998,6 +1015,7 @@ def _run_until_running(","                 stdin=subprocess.DEVNULL,","                 stdout=subprocess.DEVNULL,","                 stderr=stderr_file,","+                env=runsc_env(),","             )","         except Exception:","             stderr_file.close()","@@ -1035,6 +1053,7 @@ def stderr_text() -> str:","                             capture_output=True,","                             text=True,","                             timeout=max(1.0, timeout - (time.time() - start_time)),","+                            env=runsc_env(),","                         )","                     except subp