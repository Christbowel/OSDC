 path: str) -> bytes:","             stdin=subprocess.DEVNULL,","             stdout=subprocess.PIPE,","             stderr=subprocess.PIPE,","+            env=runsc_env(),","         )","         stdout, stderr = proc.communicate()","         if proc.returncode != 0:","@@ -1593,7 +1619,11 @@ def _run_runsc_command(","         \"\"\"Execute a runsc lifecycle control command (e.g. pause, resume, state).\"\"\"","         args = self._runsc_base_args(config) + [subcommand, *extra_args, sandbox_id]","         res = subprocess.run(","-            args, capture_output=True, text=True, timeout=timeout_seconds","+            args,","+            capture_output=True,","+            text=True,","+            timeout=timeout_seconds,","+            env=runsc_env(),","         )","         if res.returncode != 0:","             raise SandboxError(","@@ -1741,6 +1771,7 @@ def restore_after_failure() -> None:","                         capture_output=True,","                         text=True,","                         timeout=timeout_seconds,","+                        env=runsc_env(),","                     )","                 except subprocess.TimeoutExpired:","                     # The timeout kills only the runsc client: the save goes","@@ -2147,7 +2178,7 @@ def _delete_container_state(self, config: SandboxConfig, sandbox_id: str) -> Non","         \"\"\"","         del_args = self._runsc_base_args(config) + [\"delete\", \"-force\", sandbox_id]","         try:","-            subprocess.run(del_args, capture_output=True, timeout=10)","+            subprocess.run(del_args, capture_output=True, timeout=10, env=runsc_env())","         except (subprocess.TimeoutExpired, OSError):","             pass"," ","@@ -2560,7 +2591,10 @@ def _reclaim_if_unowned(self, root_dir: str, sandbox_id: str) -> bool:","             ):","                 try:","                     subprocess.run(","-                        [*runsc_args, *action], capture_output=True, timeout=10","+                        [*runsc_args, *action],","+                        capture_output=True,","+                        timeout=10,","+                        env=runsc_env(),","                     )","                 except (OSError, subprocess.TimeoutExpired):","                     pass","@@ -2652,6 +2686,7 @@ def _check_runsc_runs_cdi_hooks(self) -> None:","                 timeout=10,","                 text=True,","                 check=True,","+                env=runsc_env(),","             )","         except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as e:","             raise SandboxCreationError(","@@ -2703,6 +2738,7 @@ def _list_nvproxy_supported_drivers(self) -> Set[str]:","                 timeout=10,","                 text=True,","                 check=True,","+                env=runsc_env(),","             )","         except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as e:","             stderr = getattr(e, \"stderr\", None)"],"additions":40,"deletions":4,"truncated":false},{"path":"python/ray/experimental/sandbox/image_manager.py","lines":["@@ -37,8 +37,10 @@ def get_default_oci_spec() -> Dict[str, Any]:","     Returns:","         Dictionary representation of the default OCI config.json generated by `runsc spec`.","     \"\"\"","+    from ray.experimental.sandbox.backend.gvisor import runsc_env","+","     with tempfile.TemporaryDirectory() as temp_dir:","-        subprocess.run([\"runsc\", \"spec\"], cwd=temp_dir, check=True)","+        subprocess.run([\"runsc\", \"spec\"], cwd=temp_dir, check=True, env=runsc_env())","         config_path = os.path.join(temp_dir, \"config.json\")","         with open(config_path, \"r\", encoding=\"utf-8\") as f:","             return json.load(f)"],"additions":3,"deletions":1,"truncated":false},{"path":"python/ray/experimental/sandbox/tests/test_checkpoint_restore.py","lines":["@@ -329,6 +329,32 @@ def test_build_restore_command(self):","             == run_public[2]","         )"," ","+    def test_lifecycle_commands_run_runsc_with_gomaxprocs(self):","+        \"\"\"runsc pause, resume and checkpoint, and the restore that follows a","+        checkpoint, run with runsc_env()'s GOMAXPROCS like every runsc call.\"\"\"","+        sandbox_id, _ = self._create_mock_sandbox(rootless=False)","+        stack, mock_run, mock_popen = self._fake_runsc()","+        with stack, patch.dict(os.environ):","+            os.environ.pop(\"GOMAXPROCS\", None)","+            self.backend.pause_sandbox(sandbox_id)","+            self.backend.resume_sandbox(sandbox_id)","+            self.backend.checkpoint_sandbox(","+                sandbox_id, checkpoint_path=os.path.join(self.temp_dir, \"ckpt\")","+            )","+","+        calls = {","+            subcommand: [","+                call","+                for call in mock_run.call_args_list","+                if call[0] and subcommand in call[0][0]","+            ]","+            for subcommand in (\"pause\", \"resume\", \"checkpoint\")","+        }","+        (restore,) = mock_popen.call_args_list","+        for call in [*calls[\"pause\"], *calls[\"resume\"], *calls[\"checkpoint\"], restore]:","+            assert call.kwargs[\"env\"][\"GOMAXPROCS\"] == \"2\"","+        assert all(calls.values())","+","     def test_checkpoint_already_paused_sandbox_remains_paused(self):","         sandbox_id, root_dir = self._create_mock_sandbox(rootless=False)","         self.backend._sandbox_metadata[sandbox_id][\"status\"] = SandboxStatus.PAUSED"],"additions":26,"deletions":0,"truncated":false},{"path":"python/ray/experimental/sandbox/tests/test_gvisor_backend.py","lines":["@@ -40,6 +40,7 @@","     _namespace_ids,","     _render_egress_ruleset,","     _write_egress_ruleset,","+    runsc_env,"," )"," from ray.experimental.sandbox.config import (","     ALLOW_ALL_CIDRS,","@@ -398,6 +399,25 @@ def test_runsc_built_from_source_is_accepted_with_a_warning(monkeypatch, sandbox","     assert \"release-20260520.0 or newer\" in sandbox_log.text"," "," ","+def test_gpu_checks_run_runsc_with_runsc_env(monkeypatch):","+    \"\"\"The runsc calls that check GPU support get runsc_env()'s GOMAXPROCS,","+    like every other runsc call.\"\"\"","+    monkeypatch.delenv(\"GOMAXPROCS\", raising=False)","+    envs = []","+","+    def run(args, **kwargs):","+        envs.append(kwargs.get(\"env\") or {})","+        if \"--version\" in args:","+            return subprocess.CompletedProcess(args, 0, \"runsc version x\\n\", \"\")","+        return subprocess.CompletedProcess(args, 0, \"580.126.20\\n\", \"\")","+","+    monkeypatch.setattr(gvisor.subprocess, \"run\", run)","+    backend = GVisorSandboxBackend()","+    backend._check_runsc_runs_cdi_hooks()","+    assert backend._list_nvproxy_supported_drivers() == {\"580.126.20\"}","+    assert [env.get(\"GOMAXPROCS\") for env in envs] == [\"2\", \"2\"]","+","+"," def test_validate_gpu_ids_accepts_subset_of_ray_assignment():","     with patch(\"ray.get_gpu_ids\", return_value=[\"0\", \"1\"]):","         GVisorSandboxBackend._validate_gpu_ids([\"0\"])","@@ -3342,5 +3362,60 @@ def unreadable(sandbox_id, path):","         backend._resolve_exec_user(\"sb-1\", \"postfix\")"," "," ","+def test_runsc_env_caps_gomaxprocs_unless_set(monkeypatch):","+    \"\"\"runsc CLI calls run with GOMAXPROCS=2, as gVisor's containerd shim","+    runs them, unless the worker's environment sets it.\"\"\"","+    monkeypatch.delenv(\"GOMAXPROCS\", raising=False)","+    assert runsc_env()[\"GOMAXPROCS\"] == \"2\"","+    monkeypatch.setenv(\"GOMAXPROCS\", \"8\")","+    assert runsc_env()[\"GOMAXPROCS\"] == \"8\"","+","+","+def test_runsc_run_starts_with_gomaxprocs(monkeypatch):","+    \"\"\"A sandbox's attached `runsc run` gets runsc_env()'s GOMAXPROCS.\"\"\"","+    monkeypatch.delenv(\"GOMAXPROCS\", raising=False)","+    backend = GVisorSandboxBackend()","+    sandbox_id = backend.create_sandbox(","+        GVisorSandboxConfig(image=\"busybox:latest\", shell=\"/bin/sh\")","+    )","+    try:","+        proc = backend._sandbox_metadata[sandbox_id][\"proc\"]","+        with open(f\"/proc/{proc.pid}/environ\", \"rb\") as f:","+            assert b\"GOMAXPROCS=2\" in f.read().split(b\"\\0\")","+    finally:","+        backend.delete_sandbox(sandbox_id)","+","+","+def test_exec_kill_and_reclaim_run_runsc_with_gomaxprocs(private_bundles, monkeypatch):","+    \"\"\"Killing a timed-out command's processes and reclaiming an unowned","+    bundle run runsc with runsc_env()'s GOMAXPROCS too.\"\"\"","+    monkeypatch.delenv(\"GOMAXPROCS\", raising=False)","+    monkeypatch.delenv(\"RAY_SANDBOX_IGNORE_CGROUPS\", raising=False)","+    # Log GOMAXPROCS with the arguments, and list no processes, so the kill","+    # falls back to the command's own PID.","+    (private_bundles / \"runsc\").write_text(","+        \"#!/bin/sh\\n\"","+        'echo \"GOMAXPROCS=$GOMAXPROCS $*\" >> \"$(dirname \"$0\")/runsc.log\"\\n'","+        'case \" $* \" in *\" trace \"*) exit 1 ;; esac\\n'","+    )","+    sandbox_id = \"ray-sandbox-00000000000f\"","+    config = GVisorSandboxConfig(image=\"busybox:latest\", rootless=False)","+    backend = GVisorSandboxBackend(image_manager=_RecordingImageManager())","+    pid_file = private_bundles / \"exec.pid\"","+    pid_file.write_text(\"7\")","+    backend._kill_exec(config, sandbox_id, str(pid_file))","+    root = Path(gvisor._RAY_SANDBOX_DIR, sandbox_id)","+    root.mkdir(parents=True)","+    # An owner file that no live owner holds or names: the bundle is unowned.","+    (root / \".owner\").write_text(json.dumps({\"image\": \"busybox:latest\"}))","+    assert backend._reclaim_unowned_bundles() == [sandbox_id]","+    assert (private_bundles / \"runsc.log\").read_text().splitlines() == [","+        f\"GOMAXPROCS=2 --root /tmp/runsc trace procfs {sandbox_id}\",","+        f\"GOMAXPROCS=2 --root /tmp/runsc kill --pid 7 {sandbox_id} SIGKILL\",","+        f\"GOMAXPROCS=2 --root /tmp/runsc kill {sandbox_id} SIGKILL\",","+        f\"GOMAXPROCS=2 --root /tmp/runsc delete -force {sandbox_id}\",","+    ]","+","+"," if __name__ == \"__main__\":","     sys.exit(pytest.main([\"-v\", __file__]))",""],"additions":75,"deletions":0,"truncated":false}],"additions":144,"deletions":5,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-10T17:06:16.311442+00:00"}