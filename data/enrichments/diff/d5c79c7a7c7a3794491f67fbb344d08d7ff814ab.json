-content'))","+      .toBe('nested-inner')","+","+    for (const file of [","+      'page-a.js',","+      'page-nested.js',","+      'page-nested-inner.js',","+    ]) {","+      expect(","+        lazyResponses.some((res) => lazyIdOf(res.url()).includes(file)),","+        file,","+      ).toBe(true)","+    }","+    for (const res of lazyResponses) {","+      expect(new URL(res.url()).pathname).toBe('/foo/@vite/lazy')","+      expect(res.status()).toBe(200)","+    }","+  })","+})"],"additions":47,"deletions":0,"truncated":false},{"path":"playground/lazy-compilation/index.html","lines":["@@ -15,4 +15,9 @@ <h1>Lazy compilation</h1>","   <div id=\"route-c-content\">pending</div>"," </section>"," ","+<section>","+  <button id=\"route-nested-btn\">load nested</button>","+  <div id=\"route-nested-content\">pending</div>","+</section>","+"," <script type=\"module\" src=\"/main.js\"></script>"],"additions":5,"deletions":0,"truncated":false},{"path":"playground/lazy-compilation/main.js","lines":["@@ -1,4 +1,4 @@","-// Three lazy \"routes\" that all statically import shared.js. Each button starts","+// Lazy \"routes\". A, B and C all statically import shared.js. Each button starts"," // its import right away and never waits for the others, so a spec can hold"," // A's response in the browser while B is requested and evaluated."," // A failed import is written to the DOM so the spec can read the error.","@@ -19,3 +19,7 @@ function load(name, importer) {"," load('route-a', () => import('./page-a.js'))"," load('route-b', () => import('./page-b.js'))"," load('route-c', () => import('./page-c.js'))","+// A route whose lazy chunk has its own lazy import","+load('route-nested', () =>","+  import('./page-nested.js').then((mod) => mod.loadInner()),","+)"],"additions":5,"deletions":1,"truncated":false},{"path":"playground/lazy-compilation/page-nested-inner.js","lines":["@@ -0,0 +1 @@","+export const value = 'nested-inner'"],"additions":1,"deletions":0,"truncated":false},{"path":"playgro