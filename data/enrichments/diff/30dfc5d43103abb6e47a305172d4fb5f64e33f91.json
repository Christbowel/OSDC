,","+        license: { ...LICENSE_MOCK.license, projectUsage: PROJECT_USAGE },","+      });","+","+      const { getByText, queryByText } = render(<AdminSeatInfoEE />);","+","+      expect(getByText('Active admin users across all environments')).toBeInTheDocument();","+      expect(getByText('8 / 10')).toBeInTheDocument();","+      expect(getByText(/^Last updated /)).toBeInTheDocument();","+      expect(queryByText('Over limit')).not.toBeInTheDocument();","+      // Shown next to this instance's seats, which are still enforced","+      expect(getByText('Admin seats')).toBeInTheDocument();","+      expect(withMarkup(getByText)('10/100')).toBeInTheDocument();","+    });","+","+    test('shows an over-limit status above the contracted number', () => {","+      // @ts-expect-error – mocked","+      useLicenseLimits.mockReturnValue({","+        ...LICENSE_MOCK,","+        license: {","+          ...LICENSE_MOCK.license,","+          projectUsage: { ...PROJECT_USAGE, activeUsers: 12 },","+        },","+      });","+","+      const { getByText } = render(<AdminSeatInfoEE />);","+","+      expect(getByText('12 / 10')).toBeInTheDocument();","+      expect(getByText('Over limit')).toBeInTheDocument();","+    });","+","+    test('shows only the count when the license sets no contracted number', () => {","+      // @ts-expect-error – mocked","+      useLicenseLimits.mockReturnValue({","+        ...LICENSE_MOCK,","+        license: {","+          ...LICENSE_MOCK.license,","+          permittedSeats: null,","+          projectUsage: { ...PROJECT_USAGE, activeUsers: 42, contractedUsers: null },","+        },","+      });","+","+      const { getByText, queryByText } = render(<AdminSeatInfoEE />);","+","+      expect(getByText('Active admin users across all environments')).toBeInTheDocument();","+      expect(getByText('42')).toBeInTheDocument();","+      expect(queryByText('Over limit')).not.toBeInTheDocument();","+    });","+","+    test('shows only the seat count when the usage is null', () => {","+      // @ts-expect-error – mocked","+      useLicenseLimits.mockReturnValue({","+        ...LICENSE_MOCK,","+        license: { ...LICENSE_MOCK.license, projectUsage: null },","+      });","+","+      const { getByText, queryByText } = render(<AdminSeatInfoEE />);","+","+      expect(getByText('Admin seats')).toBeInTheDocument();","+      expect(withMarkup(getByText)('10/100')).toBeInTheDocument();","+      expect(queryByText('Active admin users across all environments')).not.toBeInTheDocument();","+    });","+  });","+","   // The per-plan billing links that used to live under the seat count were removed: the Plan card","   // now carries a single Manage/View subscription button that covers both cases.","   test.each([['gold'], ['bronze']])('Render no billing link (%s license)', (type) => {"],"additions":74,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/admin/src/pages/SettingsPage/pages/Users/ListPage.tsx","lines":["@@ -1,8 +1,10 @@"," import { ListPageCE } from '../../../../../../../admin/src/pages/Settings/pages/Users/ListPage';"," import { useLicenseLimitNotification } from '../../../../hooks/useLicenseLimitNotification';"," ","+import { LicenseUsageBanner } from './components/LicenseUsageBanner';","+"," export const UserListPageEE = () => {","   useLicenseLimitNotification();"," ","-  return <ListPageCE />;","+  return <ListPageCE banner={<LicenseUsageBanner />} />;"," };"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/core/admin/ee/admin/src/pages/SettingsPage/pages/Users/components/LicenseUsageBanner.tsx","lines":["@@ -0,0 +1,66 @@","+import * as React from 'react';","+","+import { Alert, Box, Link } from '@strapi/design-system';","+import { useIntl } from 'react-intl';","+","+import { useLicenseLimits } from '../../../../../hooks/useLicenseLimits';","+","+const CONTACT_SALES_URL = 'mailto:sales@strapi.io';","+const MANAGE_SUBSCRIPTION_URL = 'https://billing.strapi.io';","+","+/**","+ * Informational banner shown once the active admin users counted by the license registry, across","+ * every environment of the project, reach the number the license covers. Information only: seats","+ * are enforced per instance, against this instance's own active users.","+ */","+export const LicenseUsageBanner = () => {","+  const { formatMessage } = useIntl();","+  const { license } = useLicenseLimits();","+  const [isDismissed, setIsDismissed] = React.useState(false);","+","+  const usage = license?.projectUsage;","+","+  if (","+    isDismissed ||","+    !usage ||","+    usage.contractedUsers === null ||","+    usage.activeUsers < usage.contractedUsers","+  ) {","+    return null;","+  }","+","+  const isOverLimit = usage.activeUsers > usage.contractedUsers;","+  const isEnterprise = license?.type === 'gold';","+","+  return (","+    <Box paddingBottom={4}>","+      <Alert","+        variant={isOverLimit ? 'warning' : 'default'}","+        closeLabel={formatMessage({ id: 'global.close', defaultMessage: 'Close' })}","+        onClose={() => setIsDismissed(true)}","+        action={","+          <Link href={isEnterprise ? CONTACT_SALES_URL : MANAGE_SUBSCRIPTION_URL} isExternal>","+            {isEnterprise","+              ? formatMessage({","+                  id: 'Settings.permissions.users.license-usage.contact-sales',","+                  defaultMessage: 'Contact sales',","+                })","+              : formatMessage({","+                  id: 'Settings.application.plan.manage-subscription',","+                  defaultMessage: 'Manage subscription',","+                })}","+          </Link>","+        }","+      >","+        {formatMessage(","+          {","+            id: 'Settings.permissions.users.license-usage.banner',","+            defaultMessage:","+              'Your license covers {contractedUsers} active admin users across all environments. {activeUsers} are currently active.',","+          },","+          { contractedUsers: usage.contractedUsers, activeUsers: usage.activeUsers }","+        )}","+      </Alert>","+    </Box>","+  );","+};"],"additions":66,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/admin/src/pages/SettingsPage/pages/Users/components/tests/LicenseUsageBanner.test.tsx","lines":["@@ -0,0 +1,85 @@","+import { render, screen } from '@tests/utils';","+","+import { useLicenseLimits } from '../../../../../../hooks/useLicenseLimits';","+import { LicenseUsageBanner } from '../LicenseUsageBanner';","+","+jest.mock('../../../../../../hooks/useLicenseLimits');","+","+const PROJECT_USAGE = {","+  activeUsers: 10,","+  contractedUsers: 10,","+  updatedAt: '2026-11-13T10:00:00.000Z',","+};","+","+const mockLicense = (license: Record<string, unknown> | undefined) => {","+  // @ts-expect-error – mocked","+  useLicenseLimits.mockReturnValue({ license, isError: false, isLoading: false });","+};","+","+const MESSAGE =","+  'Your license covers 10 active admin users across all environments. 12 are currently active.';","+","+describe('<LicenseUsageBanner />', () => {","+  afterEach(() => {","+    jest.clearAllMocks();","+  });","+","+  it.each([","+    ['no license', undefined],","+    ['no usage', { type: 'gold', projectUsage: null }],","+    ['an older server without the usage', { type: 'gold' }],","+    ['no contracted number', { projectUsage: { ...PROJECT_USAGE, contractedUsers: null } }],","+    ['a usage below the contracted number', { projectUsage: { ...PROJECT_USAGE, activeUsers: 9 } }],","+  ])('renders nothing with %s', (_label, license) => {","+    mockLicense(license);","+","+    render(<LicenseUsageBanner />);","+","+    expect(screen.queryByText(/Your license covers/)).not.toBeInTheDocument();","+  });","+","+  it('informs when the usage reaches the contracted number', () => {","+    mockLicense({ type: 'gold', projectUsage: PROJECT_USAGE });","+","+    render(<LicenseUsageBanner />);","+","+    expect(","+      screen.getByText(","+        'Your license covers 10 active admin users across all environments. 10 are currently active.'","+      )","+    ).toBeInTheDocument();","+  });","+","+  it('informs when the usage is over the contracted number, with a link to sales', () => {","+    mockLicense({ type: 'gold', projectUsage: { ...PROJECT_USAGE, activeUsers: 12 } });","+","+    render(<LicenseUsageBanner />);","+","+    expect(screen.getByText(MESSAGE)).toBeInTheDocument();","+    expect(screen.getByRole('link', { name: /Contact sales/ })).toHaveAttribute(","+      'href',","+      'mailto:sales@strapi.io'","+    );","+  });","+","+  it('links to the subscription for a non-Enterprise license', () => {","+    mockLicense({ type: 'silver', projectUsage: { ...PROJECT_USAGE, activeUsers: 12 } });","+","+    render(<LicenseUsageBanner />);","+","+    expect(screen.getByRole('link', { name: /Manage subscription/ })).toHaveAttribute(","+      'href',","+      'https://billing.strapi.io'","+    );","+  });","+","+  it('can be dismissed', async () => {","+    mockLicense({ type: 'gold', projectUsage: { ...PROJECT_USAGE, activeUsers: 12 } });","+","+    const { user } = render(<LicenseUsageBanner />);","+","+    await user.click(screen.getByRole('button', { name: 'Close' }));","+","+    expect(screen.queryByText(MESSAGE)).not.toBeInTheDocument();","+  });","+});"],"additions":85,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/server/src/controllers/__tests__/admin.license.vitest.test.ts","lines":["@@ -568,6 +568,111 @@ describe('licenseLimitInformation (planEntitlements)', () => {","   });"," });"," ","+describe('licenseLimitInformation (projectUsage)', () => {","+  const OLD_ENV = process.env;","+  const USAGE = { activeUsers: 12, contractedUsers: 10, updatedAt: '2026-11-13T10:00:00.000Z' };","+","+  beforeEach(() => {","+    process.env = { ...OLD_ENV };","+  });","+  afterEach(() => {","+    process.env = OLD_ENV;","+  });","+","+  const withStoredUsage = (value: unknown) => {","+    const get = vi.fn(async () => value);","+    (glo