{"id":"7bce843a08fd3119766cd73d346bce481ede2544","axis":"silent","repo":"vllm-project/vllm","sha":"7bce843a08fd3119766cd73d346bce481ede2544","parsed":{"files":[{"path":"docs/design/moe_kernel_features.md","lines":["@@ -103,6 +103,7 @@ To be used with a particular `FusedMoEPrepareAndFinalizeModular` subclass, MoE k"," | trtllm | standard | mxfp4,</br>nvfp4 | G(16),G(32) | <sup>7</sup> | N | Y | [`TrtLlmMxfp4ExpertsMonolithic`][vllm.model_executor.layers.fused_moe.experts.trtllm_mxfp4_moe.TrtLlmMxfp4ExpertsMonolithic],</br>[`TrtLlmMxfp4ExpertsModular`][vllm.model_executor.layers.fused_moe.experts.trtllm_mxfp4_moe.TrtLlmMxfp4ExpertsModular],</br>[`TrtLlmNvFp4ExpertsMonolithic`][vllm.model_executor.layers.fused_moe.experts.trtllm_nvfp4_moe.TrtLlmNvFp4ExpertsMonolithic],</br>[`TrtLlmNvfp4ExpertsModular`][vllm.model_executor.layers.fused_moe.experts.trtllm_nvfp4_moe.TrtLlmNvFp4ExpertsModular] |"," | hpc | standard | fp8 | G(128),T | silu | Y | Y | [`HPCExperts`][vllm.model_executor.layers.fused_moe.hpc_moe.HPCExperts] |"," | rocm aiter moe | standard | none,</br>mxfp4,</br>fp8 | G(32),G(128),A,T | silu, gelu,</br>swigluoai,</br>situ | Y | Y | [`rocm_aiter_fused_experts`][vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe.rocm_aiter_fused_experts],</br>[`AiterUnquantizedExperts`][vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe.AiterUnquantizedExperts],</br>[`AiterFp8BlockExperts`][vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe.AiterFp8BlockExperts],</br>[`AiterFp8TensorExperts`][vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe.AiterFp8TensorExperts],</br>[`AiterFp8ChannelExperts`][vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe.AiterFp8ChannelExperts],</br>[`AiterMxfp4Experts`][vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe.AiterMxfp4Experts] |","+| rocm aiter triton mxfp8 | standard | mxfp8 | G(32) | silu,</br>swigluoai | Y | N | [`AiterTritonMxfp8ExpertsMonolithic`][vllm.model_executor.layers.fused_moe.experts.aiter_mxfp8_moe.AiterTritonMxfp8ExpertsMonolithic] |"," | cpu_moe | standard | N/A | N/A | silu, gelu,</br>gelu_tanh,</br>swigluoai | Y | N | [`X86CPUUnquantizedExperts`][vllm.model_executor.layers.fused_moe.experts.cpu_moe.X86CPUUnquantizedExperts],</br>[`ArmCPUUnquantizedExperts`][vllm.model_executor.layers.fused_moe.experts.cpu_moe.ArmCPUUnquantizedExperts],</br>[`CPUUnquantizedExperts`][vllm.model_executor.layers.fused_moe.experts.cpu_moe.CPUUnquantizedExperts] |"," | naive batched<sup>4</sup> | batched | int8,</br>fp8 | G,A,T | silu, gelu | <sup>6</sup> | Y | [`NaiveBatchedExperts`][vllm.model_executor.layers.fused_moe.experts.fused_batched_moe.NaiveBatchedExperts] |"," "],"additions":1,"deletions":0,"truncated":false},{"path":"docs/features/quantization/online.md","lines":["@@ -120,8 +120,9 @@ vllm serve <model> --quantization-config.moe.activation mxfp8"," "," `quantization_config` lets you select an activation format independently of"," the weight format. For online quantization, it can be used to override the","-default activation quantization of MXFP4 layers; other online weight formats","-reject an activation override.","+default activation quantization of MXFP4 layers. Online MXFP8 MoE layers accept","+only `\"activation\": \"mxfp8\"`, their default; other online weight formats reject","+an activation override."," "," For example, to enable MXFP4 MoE weights along MXFP8 activations:"," "],"additions":3,"deletions":2,"truncated":false},{"path":"recipes/models/tencent/Hy4-preview.yaml","lines":["@@ -98,9 +98,8 @@ hardware_overrides:"," strategy_overrides:","   single_node_tp:","     hardware_overrides:","-      # gfx942 stores the MXFP8 checkpoint as BF16. The shared AMD window","-      # (262144, 8192 batched tokens) stays the MI355X path.","-      # These flags replace that window on MI325X only.","+      # The shared AMD window (262144, 8192 batched tokens) stays the MI355X","+      # path. These flags replace that window on MI325X only.","       mi325x:","         extra_args:","           - \"--trust-remote-code\"","@@ -205,11 +204,15 @@ guide: |"," ","   ### Serving on 8×AMD MI325X (gfx942)"," ","-  Select the FP8 variant. Since gfx942 dequantizes MXFP8 weights to BF16,","-  the context window is not the same as on the MI355X. The verified serve","-  is context 139264, FP8 KV, and the AITER MoE, MHA, RMSNorm, and linear toggles.","-  At GPU memory utilization 0.96 the KV cache holds 530,912 tokens,","-  about 3.81× one 139,264-token request.","+  Select the FP8 variant. vLLM keeps the MXFP8 experts in MXFP8 and runs them","+  with the AITER Triton MXFP8 MoE backend, which it selects automatically on","+  gfx942 (`--moe-backend aiter_triton_mxfp8_mxfp8` pins it; the startup log","+  shows `Using AITER_TRITON_MXFP8_MXFP8 Mxfp8 MoE backend`). Compared with","+  converting the experts to BF16 at load, it measured 109 instead of 196 GiB","+  of weights per GPU, 13-23% more output throughput at 8K-128K input, and","+  unchanged GSM8K (96.8%) in a TP8 serve at a 262,144-token window.","+  The verified serve is context 139264, FP8 KV, and the AITER MoE, MHA,","+  RMSNorm, and linear toggles.","   ","   ```bash","   export VLLM_ROCM_USE_AITER=1"],"additions":11,"deletions":8,"truncated":false},{"path":"tests/kernels/moe/test_mxfp8_aiter_backend_selection.py","lines":["@@ -1,6 +1,7 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project","-\"\"\"MXFP8 MoE backend selection for the AITER FlyDSL kernel (gfx950).","+\"\"\"MXFP8 MoE backend selection for the AITER kernels: FlyDSL (gfx950) and","+Triton `moe_gemm_a8w8` (gfx942)."," "," GPU-free: mocks the platform (gfx950) and the aiter fused-MoE enable flag, then"," exercises the oracle so the FlyDSL backend is auto-picked when usable (including","@@ -23,10 +24,14 @@"," from vllm.model_executor.layers.fused_moe.activation import (  # noqa: E402","     MoEActivation,"," )","+from vllm.model_executor.layers.fused_moe.config import (  # noqa: E402","+    RoutingMethodType,","+)"," from vllm.model_executor.layers.fused_moe.experts.aiter_mxfp8_moe import (  # noqa: E402","     _AITER_SWIGLU_ALPHA,","     _AITER_SWIGLU_BETA,","     AiterMxfp8Experts,","+    AiterTritonMxfp8ExpertsMonolithic,"," )"," from vllm.model_executor.layers.fused_moe.experts.mxfp8_emulation_moe import (  # noqa: E402","     Mxfp8EmulationTritonExperts,","@@ -167,10 +172,91 @@ def test_gfx950_picks_aiter():","     assert experts_cls is AiterMxfp8Experts"," "," ","-def test_gfx942_picks_emulation():","-    \"\"\"Flydsl unusable (e.g. gfx942, no FlyDSL support) -> native Triton","-    dot_scaled backend wins instead.\"\"\"","-    with patch(f\"{_AITER_MOD}.current_platform.supports_mx\", return_value=False):","+def test_no_aiter_picks_emulation():","+    \"\"\"Neither AITER kernel usable (no MX hardware, not gfx942) -> EMULATION.\"\"\"","+    with (","+        patch(f\"{_AITER_MOD}.current_platform.supports_mx\", return_value=False),","+        _gfx942(False),","+    ):","         backend, experts_cls = select_mxfp8_moe_backend(_config())","     assert backend is Fp8MoeBackend.EMULATION","     assert experts_cls is Mxfp8EmulationTritonExperts","+","+","+# --- gfx942: AITER Triton moe_gemm_a8w8 --------------------------------------","+","+","+def _gfx942(on: bool):","+    return patch(\"vllm.platforms.rocm.on_gfx942\", return_value=on)","+","+","+def _triton_config(**overrides):","+    cfg = make_dummy_moe_config(","+        num_experts=128,","+        experts_per_token=8,","+        hidden_dim=6144,","+        activation=MoEActivation.SILU,","+    )","+    fse = overrides.pop(\"is_fused_shared_expert_requested\", False)","+    overrides.setdefault(\"routing_method\", RoutingMethodType.DeepSeekV3)","+    cfg = dataclasses.replace(cfg, **overrides)","+    # __post_init__ derives this from the env, so set it afterwards.","+    cfg.is_fused_shared_expert_requested = fse","+    return cfg","+","+","+def test_gfx942_picks_aiter_triton():","+    with (","+        patch(f\"{_AITER_MOD}.current_platform.supports_mx\", return_value=False),","+        _gfx942(True),","+        _aiter_moe_enabled(True),","+    ):","+        backend, experts_cls = select_mxfp8_moe_backend(_triton_config())","+    assert backend is Fp8MoeBackend.AITER_TRITON_MXFP8_MXFP8","+    assert experts_cls is AiterTritonMxfp8ExpertsMonolithic","+","+","+@pytest.mark.parametrize(","+    \"gfx942,aiter_moe,overrides,reason\",","+    [","+        (True, True, {}, None),","+        (False, True, {}, \"current device\"),  # e.g. gfx950","+        (True, False, {}, \"current device\"),  # VLLM_ROCM_USE_AITER_MOE=0","+        (True, True, {\"has_bias\": True}, \"bias\"),","+        (True, True, {\"is_fused_shared_expert_requested\": True}, \"shared experts\"),","+        (True, True, {\"routing_method\": RoutingMethodType.Llama4}, \"routing method\"),","+        (True, True, {\"use_ep\": True}, \"parallel config\"),","+    ],","+)","+def test_aiter_triton_is_supported_config(gfx942, aiter_moe, overrides, reason):","+    if overrides.pop(\"use_ep\", False):","+        cfg = _triton_config()","+        overrides[\"moe_parallel_config\"] = dataclasses.replace(","+            cfg.moe_parallel_config, ep_size=2, use_ep=True","+        )","+    with _gfx942(gfx942), _aiter_moe_enabled(aiter_moe):","+        ok, why = AiterTritonMxfp8ExpertsMonolithic.is_supported_config(","+            AiterTritonMxfp8ExpertsMonolithic,","+            _triton_config(**overrides),","+            kMxfp8Static,","+            kMxfp8Dynamic,","+            FusedMoEActivationFormat.Standard,","+        )","+    assert ok is (reason is None)","+    if reason is not None:","+        assert why is not None and reason in why","+","+","+@pytest.mark.parametrize(\"gfx942\", [True, False])","+def test_explicit_moe_backend_aiter_triton(gfx942):","+    \"\"\"--moe-backend aiter_triton_mxfp8_mxfp8 selects the gfx942 experts, and","+    raises rather than falling back where they cannot run.\"\"\"","+    cfg = _triton_config(moe_backend=\"aiter_triton_mxfp8_mxfp8\")","+    with _gfx942(gfx942), _aiter_moe_enabled(True):","+        if not gfx942:","+            with pytest.raises(ValueError, match=\"does not support current device\"):","+                select_mxfp8_moe_backend(cfg)","+            return","+        backend, experts_cls = select_mxfp8_moe_backend(cfg)","+    assert backend is Fp8MoeBackend.AITER_TRITON_MXFP8_MXFP8","+    assert experts_cls is AiterTritonMxfp8ExpertsMonolithic"],"additions":91,"deletions":5,"truncated":false},{"path":"tests/kernels/moe/test_ocp_mx_moe.py","lines":["@@ -44,14 +44,16 @@"," ROCM_AVAILABLE = current_platform.is_rocm()"," ROCM_TRITON_KERNELS_AVAILABLE = False"," ROCM_AITER_AVAILABLE = is_aiter_found()","+ROCM_GFX942 = False"," ROCM_GFX950 = False"," ROCM_GFX1250 = False"," "," if ROCM_AVAILABLE:","-    from vllm.platforms.rocm import on_gfx950, on_gfx1250","+    from vllm.platforms.rocm import on_gfx942, on_gfx950, on_gfx1250","     from vllm.utils.import_utils import has_triton_kernels"," ","     ROCM_TRITON_KERNELS_AVAILABLE = has_triton_kernels()","+    ROCM_GFX942 = on_gfx942()","     ROCM_GFX950 = on_gfx950()","     ROCM_GFX1250 = on_gfx1250()"," ","@@ -1716,6 +1718,7 @@ class RocmBackendConfig(TypedDict):","     requires_aiter: bool","     requires_gfx950: bool","     requires_gfx1250: NotRequired[bool]","+    requires_gfx942: NotRequired[bool]","     interleaved_layout: NotRequired[bool]","     act_type: NotRequired[str]"," ","@@ -2238,6 +2241,252 @@ def run(unpadded: int) -> torch.Tensor:","     torch.testing.assert_close(padded, unpadded, atol=1e-2, rtol=1e-2)"," "," ","+ROCM_MXFP8_BACKEND_CONFIGS: dict[str, RocmBackendConfig] = {","+    \"AITER_TRITON_MXFP8_MXFP8\": {","+        \"activation\": \"SILU\",","+        \"rtol\": 1e-2,","+        \"percent\": 0.99,","+        \"requires_aiter\": True,","+        \"requires_gfx950\": False,","+        \"requires_gfx942\": True,","+    },","+}","+","+","+def _mxfp8_moe_reference(","+    x: torch.Tensor,","+    w13: torch.Tensor,","+    w2: torch.Tensor,","+    topk_weights: torch.Tensor,","+    topk_ids: torch.Tensor,","+    apply_router_weight_on_input: bool,","+    activation,","+) -> torch.Tensor:","+    \"\"\"`torch_experts` on dequantized weights, except the intermediate","+    activation is rounded to MXFP8 before the second GEMM, like the kernel.\"\"\"","+    from vllm.model_executor.layers.fused_moe.activation import apply_moe_activation","+    from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","+        mxfp8_e4m3_quantize,","+    )","+","+    out = torch.zeros(x.shape[0], w2.shape[1], dtype=torch.float32, device=x.device)","+    for k in range(topk_ids.shape[1]):","+        for e in topk_ids[:, k].unique().tolist():","+            rows = (topk_ids[:, k] == e).nonzero().flatten()","+            gate = topk_weights[rows, k].float().unsqueeze(1)","+            xe = x[rows].float() * gate if apply_router_weight_on_input else x[rows]","+            h = (xe.float() @ w13[e].float().T).to(torch.bfloat16)","+            act = h.new_empty(h.shape[0], h.shape[1] // 2)","+            apply_moe_activation(activation, act, h)","+            act = mxfp8_dequantize(*mxfp8_e4m3_quantize(act)).float()","+            y = act @ w2[e].float().T","+            out[rows] += y if apply_router_weight_on_input else y * gate","+    return out.to(x.dtype)","+","+","+@pytest.mark.parametrize(\"backend_name\", list(ROCM_MXFP8_BACKEND_CONFIGS.keys()))","+@pytest.mark.parametrize(","+    \"routing_method_name,activation_name,topk,apply_router_weight_on_input\",","+    [","+        (\"Renormalize\", \"SILU\", 4, False),","+        (\"RenormalizeNaive\", \"SILU\", 4, False),","+        (\"MiniMax2\", \"SILU\", 4, False),","+        (\"DeepSeekV3\", \"SILU\", 4, False),","+        (\"Renormalize\", \"SWIGLUOAI\", 4, False),","+        (\"MiniMax2\", \"SILU\", 1, True),","+    ],","+)","+@pytest.mark.parametrize(\"num_tokens\", [1, 37, 300])","+@pytest.mark.skipif(not ROCM_AVAILABLE, reason=\"ROCm is required for this test\")","+@torch.inference_mode()","+def test_rocm_mxfp8_moe_oracle(","+    backend_name: str,","+    routing_method_name: str,","+    activation_name: str,","+    topk: int,","+    apply_router_weight_on_input: bool,","+    num_tokens: int,","+    monkeypatch: pytest.MonkeyPatch,","+):","+    \"\"\"MXFP8 counterpart of `test_rocm_mxfp4_moe_oracle`: the oracle picks the","+    backend and the assembled kernel matches `_mxfp8_moe_reference` on the","+    dequantized weights, routed by vLLM's top-k functions.\"\"\"","+    config = ROCM_MXFP8_BACKEND_CONFIGS[backend_name]","+    if config[\"requires_aiter\"] and not ROCM_AITER_AVAILABLE:","+        pytest.skip(f\"Backend {backend_name} requires AITER\")","+    if config.get(\"requires_gfx942\") and not ROCM_GFX942:","+        pytest.skip(f\"Backend {backend_name} requires GFX942\")","+","+    from vllm.config import VllmConfig, set_current_vllm_config","+    from vllm.model_executor.layers.fused_moe import FusedMoEConfig","+    from vllm.model_executor.layers.fused_moe.activation import MoEActivation","+    from vllm.model_executor.layers.fused_moe.config import (","+        FusedMoEParallelConfig,","+        RoutingMethodType,","+    )","+    from vllm.model_executor.layers.fused_moe.oracle.fp8 import (","+        Fp8MoeBackend,","+        convert_to_fp8_moe_kernel_format,","+        make_fp8_moe_kernel,","+        make_fp8_moe_quant_config,","+    )","+    from vllm.model_executor.layers.fused_moe.oracle.mxfp8 import (","+        select_mxfp8_moe_backend,","+    )","+    from vllm.model_executor.layers.fused_moe.routed_experts_capturer import (","+        RoutedExpertsSink,","+    )","+    from vllm.model_executor.layers.fused_moe.router.fused_topk_router import (","+        fused_topk,","+    )","+    from vllm.model_executor.layers.fused_moe.router.grouped_topk_router import (","+        grouped_topk,","+    )","+    from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","+        mxfp8_e4m3_quantize,","+    )","+","+    monkeypatch.setattr(rocm_aiter_ops, \"_AITER_ENABLED\", True)","+    monkeypatch.setattr(rocm_aiter_ops, \"_FMOE_ENABLED\", True)","+","+    # w13 is [E, 768, 512] and w2 is [E, 512, 384]: non-square on purpose.","+    num_experts, hidden_size, intermediate_size = 16, 512, 384","+    routing_method = RoutingMethodType[routing_method_name]","+    activation = MoEActivation[activation_name]","+    torch.manual_seed(42)","+    device = \"cuda:0\"","+","+    moe_config = FusedMoEConfig(","+        num_experts=num_experts,","+        experts_per_token=topk,","+        hidden_dim=hidden_size,","+        intermediate_size=intermediate_size,","+        num_local_experts=num_experts,","+        num_logical_experts=num_experts,","+        moe_parallel_config=FusedMoEParallelConfig.make_no_parallel(),","+        activation=activation,","+        in_dtype=torch.bfloat16,","+        device=\"cuda\",","+        routing_method=routing_method,","+        max_num_tokens=512,","+    )","+    backend, experts_cls = select_mxfp8_moe_backend(moe_config)","+    assert backend == Fp8MoeBackend[backend_name]","+","+    def quantize(*shape: int) -> tuple[torch.Tensor, torch.Tensor]:","+        w = torch.randn(*shape, dtype=torch.bfloat16, device=device) / shape[-1] ** 0.5","+        w_q, w_s = mxfp8_e4m3_quantize(w.view(-1, shape[-1]))","+        return w_q.view(shape), w_s.view(torch.uint8).view(*shape[:-1], -1)","+","+    w13_q, w13_s = quantize(num_experts, 2 * intermediate_size, hidden_size)","+    w2_q, w2_s = quantize(num_experts, hidden_size, intermediate_size)","+    # The conversion rewrites the weights in place; dequantize them first.","+    w13_dq = mxfp8_dequantize(w13_q.clone(), w13_s).to(torch.bfloat16)","+    w2_dq = mxfp8_dequantize(w2_q.clone(), w2_s).to(torch.bfloat16)","+    w13, w2, w13_scale, w2_scale = convert_to_fp8_moe_kernel_format(","+        backend, torch.nn.Module(), w13_q, w2_q, w13_s, w2_s, None, None","+    )","+    quant_config = make_fp8_moe_quant_config(","+        fp8_backend=backend,","+        w1_scale=w13_scale,","+        w2_scale=w2_scale,","+        a1_scale=None,","+        a2_scale=None,","+        block_shape=[1, 32],","+    )","+","+    # MXFP8-representable input, so the kernel's input quantization is exact.","+    x = torch.randn(num_tokens, hidden_size, dtype=torch.bfloat16, device=device)","+    x = mxfp8_dequantize(*mxfp8_e4m3_quantize(x)).to(torch.bfloat16)","+    router_logits = torch.randn(","+        num_tokens, num_experts, dtype=torch.float32, device=device","+    )","+    routing_kwargs: dict = {}","+    if routing_method in (RoutingMethodType.DeepSeekV3, RoutingMethodType.MiniMax2):","+        groups = 4 if routing_method == RoutingMethodType.DeepSeekV3 else 1","+        routing_kwargs = dict(","+            num_expert_group=groups,","+            topk_group=min(groups, 2),","+            e_score_correction_bias=0.1 * torch.randn(num_experts, device=device),","+            routed_scaling_factor=2.5,","+        )","+        topk_weights, topk_ids = grouped_topk(","+            x, router_logits, topk, True, scoring_func=\"sigmoid\", **routing_kwargs","+        )","+    else:","+        topk_weights, topk_ids, _ = fused_topk(x, router_logits, topk, True)","+","+    captured: list[torch.Tensor] = []","+    sink = RoutedExpertsSink(moe_config, lambda ids: captured.append(ids.clone()))","+    with set_current_vllm_config(VllmConfig()):","+        kernel = make_fp8_moe_kernel(","+            moe_quant_config=quant_config,","+            moe_config=moe_config,","+            experts_cls=experts_cls,","+            fp8_backend=backend,","+        )","+        assert kernel.is_monolithic","+        out = kernel.apply_monolithic(","+            hidden_states=x,","+            w1=w13,","+            w2=w2,","+            router_logits=router_logits,","+            activation=activation,","+            global_num_experts=num_experts,","+            expert_map=None,","+            apply_router_weight_on_input=apply_router_weight_on_input,","+            routing_sink=sink,","+            **routing_kwargs,","+        )","+        ref = _mxfp8_moe_reference(","+            x,","+            w13_dq,","+            w2_dq,","+            topk_weights,","+            topk_ids,","+            apply_router_weight_on_input,","+            activation,","+        )","+","+    check_accuracy(ref, out, atol=1e-2, rtol=config[\"rtol\"], percent=config[\"percent\"])","+    # Routed-experts capture reports the experts the reference routed to.","+    assert len(captured) == 1","+    torch.testing.assert_close(","+        captured[0].long().sort(-1).values, topk_ids.long().sort(-1).values","+    )","+","+","+def test_mxfp8_e4m3fn_to_e4m3fnuz_keeps_values():","+    \"\"\"The fn -> fnuz weight conversion of gfx942 MXFP8 MoE is value-exact.\"\"\"","+    from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","+        dequant_mxfp8_to_bf16,","+        mxfp8_e4m3fn_to_e4m3fnuz,","+    )","+","+    gen = torch.Generator().manual_seed(0)","+    bits = torch.randint(-128, 128, (4, 64, 64), dtype=torch.int8, generator=gen)","+    bits[(bits & 0x7F) == 0x7F] = 0  # drop e4m3fn NaN encodings","+    bits[0, 0, :8] = -128  # 0x80 is -0 in fn, NaN in fnuz","+    w = bits.view(torch.float8_e4m3fn)","+    scale = torch.randint(100, 150, (4, 64, 2), dtype=torch.uint8, generator=gen)","+    scale[0, 0, 0], scale[0, 0, 1], scale[1, 0, 0] = 253, 254, 255","+","+    ref = dequant_mxfp8_to_bf16(w.clone(), scale).float()","+    w_fnuz, s_fnuz = mxfp8_e4m3fn_to_e4m3fnuz(w.clone(), scale)","+    assert w_fnuz.dtype == torch.float8_e4m3fnuz","+    assert not (w_fnuz.view(torch.int8) == -128).any()","+","+    got = (","+        w_fnuz.float().view(4, 64, 2, 32)","+        * torch.exp2(s_fnuz.float() - 127).unsqueeze(-1)","+    ).view(4, 64, 64)","+    finite = (s_fnuz != 255).repeat_interleave(32, dim=-1)","+    torch.testing.assert_close(got[finite], ref[finite], atol=0, rtol=0)","+    # 253 -> 254 stays finite; 254 and 255 cannot be bumped and become NaN.","+    assert s_fnuz[0, 0, 0] == 254","+    assert s_fnuz[0, 0, 1] == 255 and s_fnuz[1, 0, 0] == 255","+","+"," # -----------------------------------------------------------------------------"," # MXFP4 size-rounding tests"," # -----------------------------------------------------------------------------"],"additions":250,"deletions":1,"truncated":false},{"path":"tests/quantization/test_auto_round.py","lines":["@@ -1069,6 +1069,57 @@ class DummyMoeConfig:","         )"," "," ","+def test_inc_mxfp8_moe_method_forwards_monolithic_kernel(monkeypatch) -> None:","+    \"\"\"A monolithic MXFP8 MoE kernel (e.g. the AITER Triton one on gfx942) gets","+    the router logits and the layer's routing parameters.\"\"\"","+    from unittest.mock import Mock","+","+    monkeypatch.setattr(","+        \"vllm.model_executor.layers.quantization.inc.schemes.\"","+        \"inc_mxfp8_moe.select_mxfp8_moe_backend\",","+        lambda *, config: (object(), object()),","+    )","+    from vllm.model_executor.layers.quantization.inc.schemes.inc_mxfp8_moe import (","+        INCMxfp8MoEMethod,","+    )","+","+    method = INCMxfp8MoEMethod(cast(Any, SimpleNamespace(is_act_and_mul=True)))","+    method.moe_kernel = Mock(is_monolithic=True)","+    layer = SimpleNamespace(","+        w13_weight=object(),","+        w2_weight=object(),","+        activation=object(),","+        global_num_experts=8,","+        expert_map=None,","+        apply_router_weight_on_input=False,","+        num_expert_group=4,","+        topk_group=2,","+        e_score_correction_bias=object(),","+        routed_scaling_factor=2.5,","+        routing_sink=object(),","+    )","+    x, router_logits = object(), object()","+","+    out = method.apply_monolithic(cast(Any, layer), x, router_logits)","+","+    assert out is method.moe_kernel.apply_monolithic.return_value","+    method.moe_kernel.apply_monolithic.assert_called_once_with(","+        x,","+        layer.w13_weight,","+        layer.w2_weight,","+        router_logits,","+        activation=layer.activation,","+        global_num_experts=layer.global_num_experts,","+        expert_map=layer.expert_map,","+        apply_router_weight_on_input=layer.apply_router_weight_on_input,","+        num_expert_group=layer.num_expert_group,","+        topk_group=layer.topk_group,","+        e_score_correction_bias=layer.e_score_correction_bias,","+        routed_scaling_factor=layer.routed_scaling_factor,","+        routing_sink=layer.routing_sink,","+    )","+","+"," def test_inc_mxfp4_linear_method_registers_and_processes_weights(","     monkeypatch,"," ) -> None:"],"additions":51,"deletions":0,"truncated":false},{"path":"tests/quantization/test_online.py","lines":["@@ -57,6 +57,7 @@"," from vllm.model_executor.layers.fused_moe import FusedMoEFactory, RoutedExperts"," from vllm.model_executor.layers.fused_moe.oracle import nvfp4 as nvfp4_oracle"," from vllm.model_executor.layers.fused_moe.oracle.base import RequantizationSourceExperts","+from vllm.model_executor.layers.fused_moe.oracle.fp8 import Fp8MoeBackend"," from vllm.model_executor.layers.fused_moe.oracle.mxfp4 import (","     Mxfp4MoeBackend,","     _backend_activation_key,","@@ -272,31 +273,34 @@ def test_online_linear_methods_resolve_activation_quant_key("," "," "," @pytest.mark.parametrize(","-    (\"layer_kind\", \"layer_cls\", \"weight_key\", \"raises\"),","+    (\"layer_kind\", \"layer_cls\", \"weight_key\", \"accepted\", \"error\"),","     [","-        (\"linear\", _TestLinear, kFp8StaticTensorSym, True),","-        (\"linear\", _TestLinear, kFp8Static128BlockSym, True),","-        (\"linear\", _TestLinear, kMxfp8Static, True),","-        (\"linear\", _TestLinear, kMxfp4Static, False),","-        (\"linear\", _TestLinear, kNvfp4Static, True)