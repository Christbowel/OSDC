nt_key is None","+    moe_spec = moe_args if isinstance(moe_args, dict) else target_specs.get(\"*experts*\")","+    if isinstance(moe_spec, dict) and \"activation\" in moe_spec:","+        activation = moe_spec[\"activation\"]","+        assert moe._quant_method.activation_quant_key == (","+            None if activation is None else QUANT_KEY_NAMES[activation]","+        )","+    if expected_moe_cls is Mxfp8OnlineMoEMethod and on_gfx942() and use_rocm_aiter:","+        assert moe._quant_method.fp8_backend == Fp8MoeBackend.AITER_TRITON_MXFP8_MXFP8"," ","     if model_name == PARTIALLY_PREQUANTIZED_MODEL_NAME and isinstance(","         o_proj.quant_method.kernel, (MarlinMxfp8LinearKernel, HummingMxfp8LinearKernel)"],"additions":42,"deletions":21,"truncated":false},{"path":"vllm/config/kernel.py","lines":["@@ -146,6 +146,7 @@ def with_default(","     \"aiter_mega_moe\",","     \"aiter_triton_mxfp4_bf16\",","     \"aiter_triton_mxfp4_mxfp4\",","+    \"aiter_triton_mxfp8_mxfp8\",","     \"flydsl\",","     \"hpc\",","     \"emulation\",","@@ -372,6 +373,8 @@ class KernelConfig:","       (moe_gemm_a16w4) MoE kernel (ROCm gfx942/gfx950/gfx1250)","     - \"aiter_triton_mxfp4_mxfp4\": Use the AITER Triton/Gluon MXFP4 W4A4","       (moe_gemm_a4w4) MoE kernel (ROCm gfx1250)","+    - \"aiter_triton_mxfp8_mxfp8\": Use the AITER Triton MXFP8 W8A8","+      (moe_gemm_a8w8) MoE kernel (ROCm gfx942)","     - \"flydsl\": Use AMD FlyDSL kernels (ROCm only)","     - \"rdna3\": Use the fused RDNA3 W4A16 HIP kernel (ROCm gfx1100 only)","     - \"rdna3_int4_int8\": Int4 MoE decode with int8 activations per 32 values"],"additions":3,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/experts/aiter_mxfp8_moe.py","lines":["@@ -1,9 +1,13 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":0,"deletions":0,"truncated":false}],"additions":452,"deletions":37,"truncated":true,"file_count":9},"er