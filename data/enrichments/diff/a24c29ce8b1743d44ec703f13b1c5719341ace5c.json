ize(\"started\", [False, True])","+async def test_unregister_shutdown(started):","+    called = False","+","+    async def cleanup():","+        nonlocal called","+        called = True","+","+    tasks = async_utils._shutdown_tasks.copy()","+    count = len(tasks)","+    unregister = async_utils.on_shutdown(cleanup)","+    (task,) = async_utils._shutdown_tasks - tasks","+    if started:","+        await asyncio.sleep(0)","+    unregister()","+    unregister()","+    with pytest.raises(asyncio.CancelledError):","+        await task","+    assert not called","+    assert len(async_utils._shutdown_tasks) == count","+","+","+@pytest.mark.asyncio","+async def test_shutdown_cleanup_error():","+    async def cleanup():","+        raise ValueError(\"cleanup failed\")","+","+    tasks = async_utils._shutdown_tasks.copy()","+    count = len(tasks)","+    async_utils.on_shutdown(cleanup)","+    (task,) = async_utils._shutdown_tasks - tasks","+    await asyncio.sleep(0)","+    task.cancel()","+    with pytest.raises(ValueError, match=\"cleanup failed\"):","+        await task","+    await asyncio.sleep(0)","+    assert len(async_utils._shutdown_tasks) == count","+","+","+@pytest.mark.asyncio","+async def test_shutdown_cleanup_unregisters_itself():","+    finished = False","+","+    async def cleanup():","+        nonlocal finished","+        unregister()","+        await asyncio.sleep(0)","+        finished = True","+","+    tasks = async_utils._shutdown_tasks.copy()","+    unregister = async_utils.on_shutdown(cleanup)","+    (task,) = async_utils._shutdown_tasks - tasks","+    await asyncio.sleep(0)","+    task.cancel()","+    with pytest.raises(asyncio.CancelledError):","+        await task","+    assert finished","+    assert task not in async_utils._shutdown_tasks","+","+","+@pytest.mark.parametrize(\"closed_loop\", [False, True])","+@pytest.mark.parametrize(\"running_loop\", [False, True])","+def test_unregister_shutdown_other_loop(closed_loop, running_loop):","+    async def cleanup():","+        pytest.fail(\"Unregistered cleanup must not run\")","+","+    async def register():","+        return async_utils.on_shutdown(cleanup)","+","+    tasks = async_utils._shutdown_tasks.copy()","+    count = len(tasks)","+    loop = asyncio.new_event_loop()","+    unregister = loop.run_until_complete(register())","+    (task,) = async_utils._shutdown_tasks - tasks","+    if closed_loop:","+        loop.close()","+","+    async def unregister_async():","+        unregister()","+","+    try:","+        if running_loop:","+            asyncio.run(unregister_async())","+        else:","+            unregister()","+        unregister()","+        assert task not in async_utils._shutdown_tasks","+        assert len(async_utils._shutdown_tasks) == count","+    finally:","+        if closed_loop:","+            task.get_coro().close()","+            loop.set_exception_handler(lambda loop, context: None)","+        else:","+            loop.run_until_complete(asyncio.gather(task, return_exceptions=True))","+            loop.close()","+","+"," def test_exit_handler():","     result = None","     sync = Synchronizer()","@@ -338,7 +436,7 @@ async def cleanup():","         result = \"bye\""," ","     async def _setup_code():","-        async_utils.on_shutdown(cleanup())","+        async_utils.on_shutdown(cleanup)"," ","     setup_code = sync.create_blocking(_setup_code)","     setup_code()"],"additions":99,"deletions":1,"truncated":false},{"path":"py/test/auth_token_manager_test.py","lines":["@@ -62,6 +62,54 @@ def token_due_for_refresh():","     return jwt.encode(payload, SECRET_KEY, algorithm=\"HS256\")"," "," ","+@pytest.mark.asyncio","+@pytest.mark.parametrize(\"state\", [\"empty\", \"cached\", \"refreshing\", \"failed\"])","+async def test_reset(client, valid_jwt_token, another_valid_jwt_token, state):","+    started = asyncio.Event()","+    refreshing = False","+    failing = False","+    calls = 0","+","+    async def fetch(retry):","+        nonlocal calls","+        calls += 1","+        if failing:","+            raise RuntimeError(\"auth server unavailable\")","+        if refreshing:","+            started.set()","+            await asyncio.Event().wait()","+        return valid_jwt_token if calls == 1 else another_valid_jwt_token","+","+    manager = _AuthTokenManager(client._stub, fetch=fetch)","+    caller = None","+    if state in {\"cached\", \"refreshing\"}:","+        assert await manager.get_token() == valid_jwt_token","+    if state == \"refreshing\":","+        refreshing = True","+        manager._refresh_at = 0.0","+        caller = asyncio.create_task(manager.get_token())","+        await started.wait()","+    elif state == \"failed\":","+        failing = True","+        with pytest.raises(RuntimeError, match=\"auth server unavailable\"):","+            await manager.get_token()","+","+    await manager.reset()","+    await manager.reset()","+    if caller is not None:","+        with pytest.raises(asyncio.CancelledError):","+            await caller","+    assert manager._token == \"\"","+    assert manager._expiry == manager._refresh_at == manager._retry_after == 0.0","+    assert manager._refresh_task is None","+    assert manager._backoff == manager.FAILURE_BACKOFF_BASE","+","+    refreshing = failing = False","+    calls_before = calls","+    assert await manager.get_token() == (valid_jwt_token if calls_before == 0 else another_valid_jwt_token)","+    assert calls == calls_before + 1","+","+"," @pytest.mark.asyncio"," async def test_get_token_initial_fetch(auth_token_manager, valid_jwt_token, client, servicer):","     \"\"\"Test getting token when no token exists.\"\"\"","@@ -657,6 +705,28 @@ def exp_time(token: str):","     return jwt.decode(token, options={\"verify_signature\": False})[\"exp\"]"," "," ","+@pytest.mark.asyncio","+async def test_close_cancels_refresh(client):","+    started = asyncio.Event()","+    cancelled = asyncio.Event()","+","+    async def fetch(retry):","+      