ata = bytes(1024 * 1024)","+","+    async def cycle():","+        payload = Payload()","+        client = await _Client.from_credentials(*credentials)","+        refs = [weakref.ref(obj) for obj in (payload, client, asyncio.get_running_loop())]","+        await client.close()","+        return refs","+","+    count = len(_shutdown_tasks)","+    for _ in range(5):","+        refs = asyncio.run(cycle())","+        gc.collect()","+        assert all(ref() is None for ref in refs)","+        assert len(_shutdown_tasks) == count","+","+","+@pytest.mark.parametrize(\"oauth\", [False, True])","+def test_credentials_context_manager(servicer, server_url_env, credentials, oauth):","+    token_id, token_secret = credentials","+    if oauth:","+        client = Client.from_oauth_credentials(","+            f\"{token_id}.{token_secret}\", oauth_client_id=\"oc-client\", oauth_client_secret=\"ov-secret\"","+        )","+    else:","+        client = Client.from_credentials(*credentials)","+    with client as entered:","+        assert entered is client","+        client.hello()","+    assert client.is_closed()","+    client.close()","+    with pytest.raises(ClientClosed):","+        client.hello()","+","+","+@pytest.mark.asyncio","+async def test_public_close_async(servicer, server_url_env, credentials):","+    async with await Client.from_credentials.aio(*credentials) as client:","+        await client.hello.aio()","+    await client.close.aio()","+    with pytest.raises(ClientClosed):","+        await client.hello.aio()","+","+","+def test_close_preserves_env_client(servicer, server_url_env, token_env):","+    env_client = Client.from_env()","+    client = Client.from_credentials(\"ak-other\", \"as-other\")","+    client.close()","+    assert Client.from_env() is env_client","+    env_client.hello()","+","+","+def test_close_releases_public_client(server_url_env, credentials):","+    client = Client.from_credentials(*credentials)","+    ref = weakref.ref(client)","+    client.close()","+    del client","+    gc.collect()","+    assert ref() is None","+","+","+@pytest.mark.asyncio","+async def test_close_releases_input_plane_stubs(servicer, server_url_env, credentials):","+    client = await _Client.from_credentials(*credentials)","+    stub = await client._get_stub(servicer.client_addr)","+    manager = weakref.ref(client._connection_manager)","+    auth = weakref.ref(client._auth_token_manager)","+    await client.close()","+    assert client._cancellation_context_event_loop is None","+    gc.collect()","+    assert manager() is None","+    assert auth() is None","+    with pytest.raises(ClientClosed):","+        await stub.ClientHello(Empty())","+    with pytest.raises(ClientClosed):","+        await client.get_input_plane_metadata(\"us-east\")","+","+","+@pytest.mark.asyncio","+@pytest.mark.parametrize(\"private_close\", [False, True])","+async def test_enter_closed_client(server_url_env, credentials, private_close):","+    client = await _Client.from_credentials(*credentials)","+    if private_close:","+        await client.close()","+    else:","+        await client.close()","+    with pytest.raises(ClientClosed):","+        async with client:","+            pytest.fail(\"Closed clients must not reopen\")","+","+","+@pytest.mark.asyncio","+async def test_snapshot_prep_closed_client(server_url_env, credentials):","+    client = await _Client.from_credentials(*credentials)","+    await client.close()","+    with pytest.raises(ClientClosed):","+        await client._prep_for_snapshot()","+","+","+@pytest.mark.asyncio","+async def test_snapshot_prep_preserves_shutdown_hook(server_url_env, credentials):","+    tasks = _shutdown_tasks.copy()","+    count = len(tasks)","+    client = await _Client.from_credentials(*credentials)","+    (task,) = _shutdown_tasks - tasks","+    auth_manager = client._auth_token_manager","+    stub = client._stub","+    await client._prep_for_snapshot()","+    assert not client.is_closed()","+    assert client.