ed as Parquet.","+","+        .. versionadded:: 4.5.0","+","+        Parameters","+        ----------","+        path : str","+            Directory holding the dataset. The caller supplies it, so a scheduled pipeline can","+            keep its runs apart by including a run identifier in it.","+        create : function","+            Zero-argument function returning the :class:`DataFrame` to store. It is called only","+            when ``path`` does not already hold a complete dataset.","+","+        Returns","+        -------","+        :class:`DataFrame`","+","+        Notes","+        -----","+        Supports Spark Classic only.","+","+        This API is experimental.","+","+        Completeness is tracked with a marker file written under ``path`` once the data is","+        stored, so a path left behind by an interrupted write is recomputed rather than read","+        back as if it were finished.","+","+        Examples","+        --------","+        >>> import tempfile","+        >>> with tempfile.TemporaryDirectory() as d:","+        ...     path = os.path.join(d, \"ids\")","+        ...     spark.getOrCreateDataFrame(path, lambda: spark.range(3)).count()","+        ...     spark.getOrCreateDataFrame(path, lambda: spark.range(100)).count()","+        3","+        3","+        \"\"\"","+        if not self._jsparkSession.isDataFrameMaterialized(path):","+            self._jsparkSession.materializeDataFrame(create()._jdf, path)","+        return self.read.parquet(path)","+","     @property","     def read(self) -> DataFrameReader:","         \"\"\""],"additions":44,"deletions":2,"truncated":false},{"path":"python/pyspark/sql/tests/test_session.py","lines":["@@ -16,6 +16,7 @@"," #"," "," import os","+import tempfile"," import unittest"," import unittest.mock"," from io import StringIO","@@ -262,6 +263,38 @@ def test_get_active_session_after_create_dataframe(self):","                 session2.stop()"," "," ","+class SparkSessionGetOrCreateDataFrameTests(ReusedSQLTestCase):","+    def test_computes_and_stores_the_dataset_on_the_first_call(self):","+        with tempfile.TemporaryDirectory(prefix=\"get_or_create\") as d:","+            path = os.path.join(d, \"ids\")","+            df = self.spark.getOrCreateDataFrame(path, lambda: self.spark.range(3))","+","+            self.assertEqual(df.count(), 3)","+            self.assertTrue(self.spark._jsparkSession.isDataFrameMaterialized(path))","+            self.assertEqual(self.spark.read.parquet(path).count(), 3)","+","+    def test_loads_existing_dataset_instead_of_recomputing(self):","+        with tempfile.TemporaryDirectory(prefix=\"get_or_create\") as d:","+            path = os.path.join(d, \"ids\")","+            calls = []","+","+            def create():","+                calls.append(1)","+                return self.spark.range(3)","+","+            self.assertEqual(self.spark.getOrCreateDataFrame(path, create).count(), 3)","+            self.assertEqual(self.spark.getOrCreateDataFrame(path, create).count(), 3)","+            self.assertEqual(len(calls), 1)","+","+    def test_recomputes_when_the_stored_dataset_has_no_marker(self):","+        with tempfile.TemporaryDirectory(prefix=\"get_or_create\") as d:","+            path = os.path.join(d, \"ids\")","+            self.spark.range(2).write.parquet(path)","+","+            df = self.spark.getOrCreateDataFrame(path, lambda: self.spark.range(3))","+            self.assertEqual(df.count(), 3)","+","+"," class SparkSessionTests5(unittest.TestCase):","     def setUp(self):","         # These tests require restarting the Spark context so we set up a new one for each test"],"additions":33,"deletions":0,"truncated":false},{"path":"sql/api/src/main/scala/org/apache/spark/sql/SparkSession.scala","lines":["@@ -343,6 +343,30 @@ abstract class SparkSession extends Serializable with Closeable {","   @ClassicOnly","   def baseRelationToDataFrame(baseRelation: BaseRelation): DataFrame"," ","+  /**","+   * Returns the `DataFrame` stored at `path`, computing and storing it first if it is not already","+   * there. The dataset is stored as Parquet.","+   *","+   * This lets a rerun skip work that an earlier run finished. `create` is evaluated only when","+   * `path` does not already hold a complete dataset:","+   *","+   * {{{","+   *   val df = spark.getOrCreateDataFrame(path, () => expensiveTransform(src))","+   * }}}","+   *","+   * Completeness is tracked with a marker file written under `path` once the data is stored, so a","+   * path left behind by an interrupted write is recomputed rather than read back as if it were","+   * finished. The caller supplies `path`, so a scheduled pipeline can keep its runs apart by","+   * including a run identifier in it.","+   *","+   * @note","+   *   this is only supported in Classic.","+   * @since 4.5.0","+   */","+  @ClassicOnly","+  @Experimental","+  def getOrCreateDataFrame(path: String, create: () => DataFrame): DataFrame","+","   /* ------------------------------- *","    |  Methods for creating DataSets  |","    * ------------------------------- */"],"additions":24,"deletions":0,"truncated":false},{"path":"sql/connect/common/src/main/scala/org/apache/spark/sql/connect/ConnectClientUnsupportedErrors.scala","lines":["@@ -39,6 +39,9 @@ private[sql] object ConnectClientUnsupportedErrors {","   def experimental(): SparkUnsupportedOperationException =","     unsupportedFeatureException(\"SESSION_EXPERIMENTAL_METHODS\")"," ","+  def getOrCreateDataFrame(): SparkUnsupportedOperationException =","+    unsupportedFeatureException(\"SESSION_GET_OR_CREATE_DATAFRAME\")","+","   def listenerManager(): SparkUnsupportedOperationException =","     unsupportedFeatureException(\"SESSION_LISTENER_MANAGER\")"," "],"additions":3,"deletions":0,"truncated":false},{"path":"sql/connect/common/src/main/scala/org/apache/spark/sql/connect/SparkSession.scala","lines":["@@ -301,6 +301,12 @@ class SparkSession private[sql] (","   override def baseRelationToDataFrame(baseRelation: BaseRelation): DataFrame =","     throw ConnectClientUnsupportedErrors.baseRelationToDataFrame()"," ","+  /** @inheritdoc */","+  override def getOrCreateDataFrame(","+      path: String,","+      create: () => org.apache.spark.sql.DataFrame): DataFrame =","+    throw ConnectClientUnsupportedErrors.getOrCreateDataFrame()","+","   /** @inheritdoc */","   override def executeCommand(","       runner: String,"],"additions":6,"deletions":0,"truncated":false},{"path":"sql/core/src/main/scala/org/apache/spark/sql/classic/SparkSession.scala","lines":["@@ -28,6 +28,8 @@ import scala.jdk.CollectionConverters._"," import scala.reflect.runtime.universe.TypeTag"," import scala.util.control.NonFatal"," ","+import org.apache.hadoop.fs.Path","+"," import org.apache.spark.{SPARK_VERSION, SparkConf, SparkContext, SparkException, TaskContext}"," import org.apache.spark.annotation.{DeveloperApi, Experimental, Stable, Unstable}"," import org.apache.spark.api.java.JavaRDD","@@ -37,7 +39,7 @@ import org.apache.spark.internal.config.{ConfigEntry, EXECUTOR_ALLOW_SPARK_CONTE"," import org.apache.spark.rdd.RDD"," import org.apache.spark.scheduler.{SparkListener, SparkListenerApplicationEnd}"," import org.apache.spark.sql","-import org.apache.spark.sql.{AnalysisException, Artifact, DataSourceRegistration, Encoder, Encoders, ExperimentalMethods, Row, SparkSessionBuilder, SparkSessionCompanion, SparkSessionExtensions, SparkSessionExtensionsProvider, UDTFRegistration}","+import org.apache.spark.sql.{AnalysisException, Artifact, DataSourceRegistration, Encoder, Encoders, ExperimentalMethods, Row, SaveMode, SparkSessionBuilder, SparkSessionCompanion, SparkSessionExtensions, SparkSessionExtensionsProvider, UDTFRegistration}"," import org.apache.spark.sql.api.python.PythonSQLUtils"," import org.apache.spark.sql.artifact.ArtifactManager"," import org.apache.spark.sql.catalyst._","@@ -421,6 +423,30 @@ class SparkSession private(","     new Dataset(self, Range(start, end, step, numPartitions), Encoders.LONG)","   }"," ","+  /** @inheritdoc */","+  override def getOrCreateDataFrame(","+      path: String,","+      create: () => org.apache.spark.sql.DataFrame): DataFrame = {","+    if (!isDataFrameMaterialized(path)) {","+      materializeDataFrame(create(), path)","+    }","+    read.parquet(path)","+  }","+","+  private[sql] def isDataFrameMaterialized(path: String): Boolean = {","+    val markerPath = new Path(path, SparkSession.GET_OR_CREATE_MARKER)","+    markerPath.getFileSystem(sessionState.newHadoopConf()).exists(markerPath)","+  }","+","+  private[sql] def materializeDataFrame(df: org.apache.spark.sql.DataFrame, path: String): Unit = {","+    // Overwrite instead of failing, so that a partial dataset left by an interrupted write is","+    // replaced instead of blocking every later run.","+    df.write.mode(SaveMode.Overwrite).parquet(path)","+    // Written last, so that the marker is only there once the data is complete.","+    val markerPath = new Path(path, SparkSession.GET_OR_CREATE_MARKER)","+    markerPath.getFileSystem(sessionState.newHadoopConf()).create(markerPath, true).close()","+  }","+","   /**","    * Creates a `DataFrame` from an `RDD[InternalRow]`.","    */","@@ -949,6 +975,12 @@ class SparkSession private("," object SparkSession extends SparkSessionCompanion with Logging {","   override private[sql] type Session = SparkSession"," ","+  /**","+   * Name of the file that marks a dataset written by `SparkSession.getOrCreateDataFrame` as","+   * complete. It starts with an underscore so that it is ignored when the dataset is read back.","+   */","+  private[sql] val GET_OR_CREATE_MARKER = \"_spark_getorcreate_success\"","+","   /**","    * Builder for [[SparkSession]].","    */"],"additions":33,"deletions":1,"truncated":false},{"path":"sql/core/src/test/scala/org/apache/spark/sql/SparkSessionGetOrCreateDataFrameSuite.scala","lines":["@@ -0,0 +1,61 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *    http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+package org.apache.spark.sql","+","+import java.io.File","+","+import org.apache.spark.sql.classic","+import org.apache.spark.sql.test.SharedSparkSession","+","+class SparkSessionGetOrCreateDataFrameSuite extends QueryTest with SharedSparkSession {","+","+  private val threeRows = Seq(Row(0L), Row(1L), Row(2L))","+","+  test(\"SPARK-60775: computes and stores the dataset on the first call\") {","+    withTempPath { dir =>","+      val path = dir.getCanonicalPath","+      checkAnswer(spark.getOrCreateDataFrame(path, () => spark.range(3).toDF()), threeRows)","+      assert(new File(dir, classic.SparkSession.GET_OR_CREATE_MARKER).exists())","+      checkAnswer(spark.read.parquet(path), threeRows)","+    }","+  }","+","+  test(\"SPARK-60775: loads existing dataset instead of recomputing\") {","+    withTempPath { dir =>","+      val path = dir.getCanonicalPath","+      var calls = 0","+      def create(): classic.DataFrame = {","+        calls += 1","+        spark.range(3).toDF()","+      }","+","+      checkAnswer(spark.getOrCreateDataFrame(path, () => create()), threeRows)","+      checkAnswer(spark.getOrCreateDataFrame(path, () => create()), threeRows)","+      assert(calls === 1)","+    }","+  }","+","+  test(\"SPARK-60775: recomputes when the stored dataset has no marker\") {","+    withTempPath { dir =>","+      val path = dir.getCanonicalPath","+      spark.range(2).toDF().write.parquet(path)","+","+      checkAnswer(spark.getOrCreateDataFrame(path, () => spark.range(3).toDF()), threeRows)","+    }","+  }","+}",""],"additions":61,"deletions":0,"truncated":false}],"additions":226,"deletions":4,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-26T18:56:22.641373+00:00"}