ted as static content.","+ * Returns `undefined` if any child isn't a plain-text or literal-expression node.","+ */","+function collapseLiteralChildren(children: unknown[]): string | undefined {","+\tlet value = '';","+\tfor (const child of children) {","+\t\tconst node = child as { type: string; value?: string; data?: { estree?: Program } };","+\t\tif (node.type === 'text') {","+\t\t\tvalue += node.value;","+\t\t} else if (node.type === 'mdxTextExpression' || node.type === 'mdxFlowExpression') {","+\t\t\tconst literal = literalExpressionValue(node);","+\t\t\tif (literal === undefined) return undefined;","+\t\t\tvalue += literal;","+\t\t} else {","+\t\t\treturn undefined;","+\t\t}","+\t}","+\treturn value;","+}","+","+/**","+ * For MDX `<script>`/`<style>` elements, collapses literal (non-interpolated) string","+ * content into a `set:html` attribute instead of leaving it as JSX children. This lets","+ * the renderer treat literal author- or plugin-authored code/CSS as trusted, the same","+ * way `set:html` already works, while any remaining dynamic children are rendered","+ * (and escaped) normally.","+ */","+export const rehypeCollapseScriptStyle: RehypePlugin = () => {","+\treturn (tree) => {","+\t\tvisit(tree as any, (node: ScriptStyleNode) => {","+\t\t\tif (!isScriptOrStyle(node) || node.children.length === 0 || hasSetDirective(node)) return;","+","+\t\t\tconst value = collapseLiteralChildren(node.children as unknown[]);","+\t\t\tif (value === undefined) return;","+","+\t\t\tif (node.type === 'element') {","+\t\t\t\tnode.properties['set:html'] = value;","+\t\t\t} else {","+\t\t\t\tnode.attributes.push({ type: 'mdxJsxAttribute', name: 'set:html', value });","+\t\t\t}","+\t\t\tnode.children = [];","+\t\t});","+\t};","+};"],"additions":97,"deletions":0,"truncated":false},{"path":"packages/markdown/satteri/src/mdx/create-processor.ts","lines":["@@ -30,6 +30,10 @@ import {"," } from '../satteri-processor.js';"," import { shouldAddCharset } from './charset.js';"," im