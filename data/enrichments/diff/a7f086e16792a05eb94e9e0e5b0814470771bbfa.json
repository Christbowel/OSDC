ving/v1alpha1\"","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+\tkernelcachelabels \"github.com/kserve/kserve/pkg/kernelcache/labels\"","+)","+","+// reconcilePrefetchServiceAccountAccess reconciles the prefetch ServiceAccount","+// and its source-namespace RoleBinding. It returns false while a non-terminal","+// prefetch Job still depends on the current binding.","+func (r *KernelCacheReconciler) reconcilePrefetchServiceAccountAccess(","+\tctx context.Context,","+\tkernelCache *v1alpha1.KernelCache,","+\tconfig *v1beta1.KernelCacheConfig,","+) (bool, error) {","+\trequiresPullBinding := config.Registry.Auth.Type ==","+\t\tv1beta1.KernelCacheRegistryAuthTypeServiceAccountToken","+","+\tif requiresPullBinding && config.Registry.Auth.PullRoleRef == nil {","+\t\treturn false, errors.New(\"registry pull RoleRef is required for serviceAccountToken authentication\")","+\t}","+","+\tif err := r.ensurePrefetchServiceAccount(ctx, config.JobNamespace); err != nil {","+\t\treturn false, err","+\t}","+","+\tdesired := buildPrefetchImagePullRoleBinding(kernelCache.Namespace, config.JobNamespace, config.Registry.Auth.PullRoleRef)","+\tcurrent := &rbacv1.RoleBinding{}","+\terr := r.Get(ctx, client.ObjectKeyFromObject(desired), current)","+\tif apierrors.IsNotFound(err) {","+\t\tif !requiresPullBinding {","+\t\t\treturn true, nil","+\t\t}","+\t\tif err := r.Create(ctx, desired); err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\treturn true, nil","+\t}","+\tif err != nil {","+\t\treturn false, err","+\t}","+","+\tif current.Labels[kernelCachePrefetchManagedLabel] != \"true\" {","+\t\tif !requiresPullBinding {","+\t\t\treturn true, nil","+\t\t}","+\t\treturn false, fmt.Errorf(\"reserved RoleBinding %s/%s already exists and is not managed by KernelCache\", kernelCache.Namespace, kernelCachePrefetchRoleBinding)","+\t}","+\tif len(current.Subjects) != 1 || current.Subjects[0].Kind != \"ServiceAccount\" || current.Subjects[0].Name != kernelCachePrefetchServiceAccount {","+\t\treturn false, fmt.Errorf(\"managed RoleBinding %s/%s has an unexpected ServiceAccount subject\", kernelCache.Namespace, kernelCachePrefetchRoleBinding)","+\t}","+","+\tjobNamespaces := prefetchJobServiceAccountNamespaces(current, config.JobNamespace)","+\thasActiveJobs, err := r.hasActivePrefetchJobsUsingSourceNamespace(ctx, kernelCache.Namespace, jobNamespaces)","+\tif err != nil {","+\t\treturn false, err","+\t}","+\tif hasActiveJobs {","+\t\treturn false, nil","+\t}","+","+\tif !requiresPullBinding {","+\t\tif err := r.deleteManagedPrefetchRoleBinding(ctx, current); err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\treturn true, nil","+\t}","+","+\tif current.RoleRef != desired.RoleRef {","+\t\tif err := r.replaceManagedPrefetchRoleBinding(ctx, current, desired); err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\treturn true, nil","+\t}","+","+\tif len(current.Subjects) == 1 && current.Subjects[0] == desired.Subjects[0] {","+\t\treturn true, nil","+\t}","+","+\tbase := current.DeepCopy()","+\tcurrent.Subjects = desired.Subjects","+\tif err := r.Patch(ctx, current, client.MergeFromWithOptions(base, client.MergeFromWithOptimisticLock{})); err != nil {","+\t\treturn false, err","+\t}","+\treturn true, nil","+}","+","+// cleanupPrefetchRoleBindingAfterKernelCacheDeletion removes the shared pull","+// RoleBinding when no KernelCache or non-terminal prefetch Job still uses it.","+// It returns false while a prefetch Job still depends on the binding.","+func (r *KernelCacheReconciler) cleanupPrefetchRoleBindingAfterKernelCacheDeletion(","+\tctx context.Context,","+\tsourceNamespace string,","+\tconfig *v1beta1.KernelCacheConfig,","+) (bool, error) {","+\tkernelCaches := &v1alpha1.KernelCacheList{}","+\treader := r.Reader","+\tif reader == nil {","+\t\treader = r.Client","+\t}","+\tif err := reader.List(ctx, kernelCaches, client.InNamespace(sourceNamespace)); err != nil {","+\t\treturn false, err","+\t}","+\tif len(kernelCaches.Items) != 0 {","+\t\treturn true, nil","+\t}","+","+\tbinding := &rbacv1.RoleBinding{}","+\tif err := r.Get(ctx, client.ObjectKey{Namespace: sourceNamespace, Name: kernelCachePrefetchRoleBinding}, binding); err != nil {","+\t\treturn true, client.IgnoreNotFound(err)","+\t}","+\tif binding.Labels[kernelCachePrefetchManagedLabel] != \"true\" {","+\t\treturn true, nil","+\t}","+\tif len(binding.Subjects) != 1 || binding.Subjects[0].Kind != \"ServiceAccount\" || binding.Subjects[0].Name != kernelCachePrefetchServiceAccount {","+\t\treturn false, fmt.Errorf(\"managed RoleBinding %s/%s has an unexpected ServiceAccount subject\", sourceNamespace, kernelCachePrefetchRoleBinding)","+\t}","+","+\tjobNamespaces := prefetchJobServiceAccountNamespaces(binding, config.JobNamespace)","+\thasActiveJobs, err := r.hasActivePrefetchJobsUsingSourceNamespace(ctx, sourceNamespace, jobNamespaces)","+\tif err != nil {","+\t\treturn false, err","+\t}","+\tif hasActiveJobs {","+\t\treturn false, nil","+\t}","+\treturn true, r.deleteManagedPrefetchRoleBinding(ctx, binding)","+}","+","+func buildPrefetchImagePullRoleBinding(sourceNamespace, jobNamespace string, roleRef *v1beta1.KernelCacheRegistryRoleRef) *rbacv1.RoleBinding {","+\tvar desiredRoleRef rbacv1.RoleRef","+\tif roleRef != nil {","+\t\tdesiredRoleRef = kernelCacheRegistryRoleRef(roleRef)","+\t}","+\treturn &rbacv1.RoleBinding{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      kernelCachePrefetchRoleBinding,","+\t\t\tNamespace: sourceNamespace,","+\t\t\tLabels:    map[string]string{kernelCachePrefetchManagedLabel: \"true\"},","+\t\t},","+\t\tRoleRef: desiredRoleRef,","+\t\tSubjects: []rbacv1.Subject{{","+\t\t\tKind:      \"ServiceAccount\",","+\t\t\tName:      kernelCachePrefetchServiceAccount,","+\t\t\tNamespace: jobNamespace,","+\t\t}},","+\t}","+}","+","+func prefetchJobServiceAccountNamespaces(binding *rbacv1.RoleBinding, desiredJobNamespace string) []string {","+\tnamespaces := make([]string, 0, 2)","+\tseen := map[string]struct{}{}","+\tadd := func(namespace string) {","+\t\tif namespace == \"\" {","+\t\t\treturn","+\t\t}","+\t\tif _, exists := seen[namespace]; exists {","+\t\t\treturn","+\t\t}","+\t\tseen[namespace] = struct{}{}","+\t\tnamespaces = append(namespaces, namespace)","+\t}","+\tadd(desiredJobNamespace)","+\tif len(binding.Subjects) == 1 && binding.Subjects[0].Kind == \"ServiceAccount\" {","+\t\tadd(binding.Subjects[0].Namespace)","+\t}","+\treturn namespaces","+}","+","+func (r *KernelCacheReconciler) hasActivePrefetchJobsUsingSourceNamespace(ctx context.Context, sourceNamespace string, jobNamespaces []string) (bool, error) {","+\tfor _, jobNamespace := range jobNamespaces {","+\t\tjobs := &batchv1.JobList{}","+\t\tif err := r.List(ctx, jobs, client.InNamespace(jobNamespace), client.MatchingLabels{","+\t\t\tkernelcachelabels.KernelCacheNamespaceLabel: kernelcachelabels.Value(sourceNamespace),","+\t\t}); err != nil {","+\t\t\treturn false, err","+\t\t}","+\t\tfor index := range jobs.Items {","+\t\t\tif !isPrefetchJobTerminal(&jobs.Items[index]) {","+\t\t\t\treturn true, nil","+\t\t\t}","+\t\t}","+\t}","+\treturn false, nil","+}","+","+func isPrefetchJobTerminal(job *batchv1.Job) bool {","+\tfor _, condition := range job.Status.Conditions {","+\t\tif condition.Type == batchv1.JobComplete || condition.Type == batchv1.JobFailed {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func (r *KernelCacheReconciler) deleteManagedPrefetchRoleBinding(ctx context.Context, binding *rbacv1.RoleBinding) error {","+\treturn client.IgnoreNotFound(r.Delete(ctx, binding, client.Preconditions{","+\t\tUID:             &binding.UID,","+\t\tResourceVersion: &binding.ResourceVersion,","+\t}))","+}","+","+func (r *KernelCacheReconciler) replaceManagedPrefetchRoleBinding(ctx context.Context, current, desired *rbacv1.RoleBinding) error {","+\tif err := r.validatePrefetchRoleBindingCreation(ctx, desired); err != nil {","+\t\treturn fmt.Errorf(\"cannot apply prefetch RoleBinding %s/%s: %w\", desired.Namespace, desired.Name, err)","+\t}","+\tif err := r.deleteManagedPrefetchRoleBinding(ctx, current); err != nil {","+\t\treturn err","+\t}","+\treturn r.Create(ctx, desired)","+}","+","+func (r *KernelCacheReconciler) validatePrefetchRoleBindingCreation(ctx context.Context, desired *rbacv1.RoleBinding) error {","+\tprobe := &rbacv1.RoleBinding{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tNamespace:    desired.Namespace,","+\t\t\tGenerateName: \"kserve-kernelcache-rb-check-\",","+\t\t\tLabels:       desired.Labels,","+\t\t},","+\t\tRoleRef:  desired.RoleRef,","+\t\tSubjects: desired.Subjects,","+\t}","+\treturn r.Create(ctx, probe, client.DryRunAll)","+}"],"additions":251,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha1/kernelcache/reconcilers/prefetch_auth_test.go","lines":["@@ -0,0 +1,192 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package reconcilers","+","+import (","+\t\"testing\"","+","+\tbatchv1 \"k8s.io/api/batch/v1\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\trbacv1 \"k8s.io/api/rbac/v1\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client/fake\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha1\"","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","+\tkernelcac