{"id":"GHSA-xp7j-h7jc-4w8p","axis":"advisories","repo":"semaphoreui/semaphore","sha":"7e8a9434bd81b82cf42220151c74801ea97542d6","parsed":{"files":[{"path":"db/Repository.go","lines":["@@ -144,6 +144,10 @@ func (r Repository) Validate() error {"," \t\treturn &ValidationError{\"repository url can't be empty\"}"," \t}"," ","+\tif err := ValidateGitURL(r.GitURL, \"repository\"); err != nil {","+\t\treturn err","+\t}","+"," \tif r.GetType() != RepositoryLocal && r.GitBranch == \"\" {"," \t\treturn &ValidationError{\"repository branch can't be empty\"}"," \t}"],"additions":4,"deletions":0,"truncated":false},{"path":"db/git_url.go","lines":["@@ -0,0 +1,19 @@","+package db","+","+import \"strings\"","+","+// ValidateGitURL rejects repository URLs that git would interpret as a","+// command-line option instead of a repository location. The CmdGitClient","+// passes the URL to the git binary as a positional argument, so a value","+// beginning with \"-\" (e.g. \"--upload-pack=/path/to/script\") would be parsed","+// by git as an option and could lead to arbitrary command execution","+// (git option injection). Legitimate git URLs (https://, ssh://, git://,","+// file://, scp-like user@host:path, or local filesystem paths) never begin","+// with \"-\", so rejecting them here is safe.","+func ValidateGitURL(url string, objectName string) error {","+\tif strings.HasPrefix(strings.TrimSpace(url), \"-\") {","+\t\treturn NewValidationError(objectName + \" url is invalid\")","+\t}","+","+\treturn nil","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"db/git_url_test.go","lines":["@@ -0,0 +1,65 @@","+package db","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestValidateGitURL(t *testing.T) {","+\ttests := []struct {","+\t\tname    string","+\t\turl     string","+\t\twantErr bool","+\t}{","+\t\t{\"https\", \"https://github.com/semaphoreui/semaphore.git\", false},","+\t\t{\"http\", \"http://example.com/repo.git\", false},","+\t\t{\"ssh scheme\", \"ssh://git@example.com/repo.git\", false},","+\t\t{\"scp-like ssh\", \"git@github.com:semaphoreui/semaphore.git\", false},","+\t\t{\"git scheme\", \"git://example.com/repo.git\", false},","+\t\t{\"file scheme\", \"file:///srv/git/repo.git\", false},","+\t\t{\"local absolute path\", \"/srv/git/repo.git\", false},","+\t\t{\"empty\", \"\", false}, // emptiness is handled separately by Repository.Validate","+","+\t\t{\"upload-pack option injection\", \"--upload-pack=/tmp/evil.sh\", true},","+\t\t{\"single dash option\", \"-oProxyCommand=evil\", true},","+\t\t{\"leading whitespace then dash\", \"  --upload-pack=/tmp/evil.sh\", true},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\terr := ValidateGitURL(tt.url, \"repository\")","+\t\t\tif tt.wantErr {","+\t\t\t\trequire.Error(t, err)","+\t\t\t\tassert.ErrorContains(t, err, \"repository url is invalid\")","+\t\t\t} else {","+\t\t\t\tassert.NoError(t, err)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestRepositoryValidate_RejectsOptionInjectionURL(t *testing.T) {","+\trepo := Repository{","+\t\tName:      \"rce\",","+\t\tGitURL:    \"--upload-pack=/tmp/evil.sh\",","+\t\tGitBranch: \"main\",","+\t\tSSHKeyID:  1,","+\t}","+","+\terr := repo.Validate()","+\trequire.Error(t, err)","+\tassert.ErrorContains(t, err, \"repository url is invalid\")","+}","+","+func TestRepositoryValidate_AcceptsNormalURL(t *testing.T) {","+\trepo := Repository{","+\t\tName:      \"ok\",","+\t\tGitURL:    \"https://github.com/semaphoreui/semaphore.git\",","+\t\tGitBranch: \"main\",","+\t\tSSHKeyID:  1,","+\t}","+","+\tassert.NoError(t, repo.Validate())","+}"],"additions":65,"deletions":0,"truncated":false},{"path":"db_lib/CmdGitClient.go","lines":["@@ -115,6 +115,7 @@ func (c CmdGitClient) Clone(r GitRepository) error {"," \t\t\"--recursive\","," \t\t\"--branch\","," \t\tr.Repository.GitBranch,","+\t\t\"--end-of-options\","," \t\tr.Repository.GetGitURL(false),"," \t\tdirName)"," }","@@ -122,7 +123,7 @@ func (c CmdGitClient) Clone(r GitRepository) error {"," func (c CmdGitClient) Pull(r GitRepository) error {"," \tr.Logger.Log(\"Updating Repository \" + r.Repository.GitURL)"," ","-\terr := c.run(r, GitRepositoryFullPath, \"pull\", \"origin\", r.Repository.GitBranch)","+\terr := c.run(r, GitRepositoryFullPath, \"pull\", \"origin\", \"--end-of-options\", r.Repository.GitBranch)"," \tif err != nil {"," \t\treturn err"," \t}","@@ -167,7 +168,7 @@ func (c CmdGitClient) GetLastCommitHash(r GitRepository) (hash string, err error"," }"," "," func (c CmdGitClient) GetLastRemoteCommitHash(r GitRepository) (hash string, err error) {","-\tout, err := c.output(r, GitRepositoryTmpPath, \"ls-remote\", r.Repository.GetGitURL(false), r.Repository.GitBranch)","+\tout, err := c.output(r, GitRepositoryTmpPath, \"ls-remote\", \"--end-of-options\", r.Repository.GetGitURL(false), r.Repository.GitBranch)"," \tif err != nil {"," \t\treturn"," \t}","@@ -185,7 +186,7 @@ func (c CmdGitClient) GetLastRemoteCommitHash(r GitRepository) (hash string, err"," }"," "," func (c CmdGitClient) GetRemoteBranches(r GitRepository) ([]string, error) {","-\tout, err := c.output(r, GitRepositoryTmpPath, \"ls-remote\", \"--heads\", r.Repository.GetGitURL(false))","+\tout, err := c.output(r, GitRepositoryTmpPath, \"ls-remote\", \"--heads\", \"--end-of-options\", r.Repository.GetGitURL(false))"," \tif err != nil {"," \t\treturn nil, err"," \t}"],"additions":4,"deletions":3,"truncated":false},{"path":"db_lib/CmdGitClient_injection_test.go","lines":["@@ -0,0 +1,128 @@","+package db_lib","+","+import (","+\t\"os\"","+\t\"os/exec\"","+\t\"path/filepath\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/semaphoreui/semaphore/db\"","+\t\"github.com/semaphoreui/semaphore/pkg/ssh\"","+\t\"github.com/semaphoreui/semaphore/pkg/task_logger\"","+\t\"github.com/semaphoreui/semaphore/util\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// nopKeyInstaller is an AccessKeyInstaller that installs nothing (as for AccessKeyNone).","+type nopKeyInstaller struct{}","+","+func (nopKeyInstaller) Install(key db.AccessKey, usage db.AccessKeyRole, logger task_logger.Logger) (ssh.AccessKeyInstallation, error) {","+\treturn ssh.AccessKeyInstallation{}, nil","+}","+","+// nopLogger is a no-op task_logger.Logger for tests.","+type nopLogger struct{}","+","+func (nopLogger) Log(string)                                   {}","+func (nopLogger) Logf(string, ...any)                          {}","+func (nopLogger) LogWithTime(time.Time, string)                {}","+func (nopLogger) LogfWithTime(time.Time, string, ...any)       {}","+func (nopLogger) LogCmd(*exec.Cmd)                             {}","+func (nopLogger) SetStatus(task_logger.TaskStatus)             {}","+func (nopLogger) AddStatusListener(task_logger.StatusListener) {}","+func (nopLogger) AddLogListener(task_logger.LogListener)       {}","+func (nopLogger) SetCommit(string, string)                     {}","+func (nopLogger) WaitLog()                                     {}","+","+func gitInit(t *testing.T, dir string) {","+\tt.Helper()","+\trun := func(args ...string) {","+\t\tcmd := exec.Command(\"git\", args...)","+\t\tcmd.Dir = dir","+\t\tout, err := cmd.CombinedOutput()","+\t\trequire.NoError(t, err, string(out))","+\t}","+\trun(\"init\", \"-q\", \"-b\", \"main\")","+\trun(\"config\", \"user.email\", \"t@t\")","+\trun(\"config\", \"user.name\", \"t\")","+\trequire.NoError(t, os.WriteFile(filepath.Join(dir, \"f\"), []byte(\"hi\"), 0644))","+\trun(\"add\", \"f\")","+\trun(\"commit\", \"-qm\", \"init\")","+}","+","+func newTestGitRepo(t *testing.T, gitURL, gitBranch string) GitRepository {","+\tt.Helper()","+\treturn GitRepository{","+\t\tRepository: db.Repository{","+\t\t\tProjectID: 1,","+\t\t\tGitURL:    gitURL,","+\t\t\tGitBranch: gitBranch,","+\t\t\tSSHKey:    db.AccessKey{Type: db.AccessKeyNone},","+\t\t},","+\t\tLogger: nopLogger{},","+\t}","+}","+","+// setupGitClientTest initializes util.Config with a temp dir and restores it afterwards.","+func setupGitClientTest(t *testing.T) {","+\tt.Helper()","+\toriginal := util.Config","+\tt.Cleanup(func() { util.Config = original })","+\tutil.Config = &util.ConfigType{TmpPath: t.TempDir(), Process: &util.ConfigProcess{}}","+}","+","+// TestCmdGitClient_OptionInjectionNeutralized proves that a GitURL crafted as a git","+// option (e.g. \"--upload-pack=/path/to/script\") is NOT executed by the remote git","+// operations, because \"--end-of-options\" is inserted before the URL positional.","+func TestCmdGitClient_OptionInjectionNeutralized(t *testing.T) {","+\tsetupGitClientTest(t)","+","+\ttmp := t.TempDir()","+\tmarker := filepath.Join(tmp, \"PWNED\")","+\tevil := filepath.Join(tmp, \"evil.sh\")","+\trequire.NoError(t, os.WriteFile(evil,","+\t\t[]byte(\"#!/bin/sh\\necho pwned > \"+marker+\"\\n\"), 0755))","+","+\tclient := CreateCmdGitClient(nopKeyInstaller{})","+\trepo := newTestGitRepo(t, \"--upload-pack=\"+evil, \"main\")","+","+\tt.Run(\"GetLastRemoteCommitHash\", func(t *testing.T) {","+\t\t_, err := client.GetLastRemoteCommitHash(repo)","+\t\tassert.Error(t, err, \"injected upload-pack must not succeed\")","+\t\tassert.NoFileExists(t, marker, \"payload must not be executed\")","+\t})","+","+\trequire.NoError(t, os.RemoveAll(marker))","+","+\tt.Run(\"GetRemoteBranches\", func(t *testing.T) {","+\t\t_, err := client.GetRemoteBranches(repo)","+\t\tassert.Error(t, err, \"injected upload-pack must not succeed\")","+\t\tassert.NoFileExists(t, marker, \"payload must not be executed\")","+\t})","+}","+","+// TestCmdGitClient_LegitRemoteOperations makes sure \"--end-of-options\" does not break","+// normal remote operations against a valid repository.","+func TestCmdGitClient_LegitRemoteOperations(t *testing.T) {","+\tsetupGitClientTest(t)","+","+\tupstream := t.TempDir()","+\tgitInit(t, upstream)","+","+\tclient := CreateCmdGitClient(nopKeyInstaller{})","+\trepo := newTestGitRepo(t, upstream, \"main\")","+","+\tt.Run(\"GetLastRemoteCommitHash\", func(t *testing.T) {","+\t\thash, err := client.GetLastRemoteCommitHash(repo)","+\t\trequire.NoError(t, err)","+\t\tassert.Len(t, hash, 40, \"expected a full commit hash\")","+\t})","+","+\tt.Run(\"GetRemoteBranches\", func(t *testing.T) {","+\t\tbranches, err := client.GetRemoteBranches(repo)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, []string{\"main\"}, branches)","+\t})","+}",""],"additions":128,"deletions":0,"truncated":false}],"additions":220,"deletions":3,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-09-09T13:46:31.284130+00:00"}