ges/grafana-ui/src/components/DateTimePickers/TimeRangePicker/TimeRangeSelector.story.tsx","lines":["@@ -0,0 +1,40 @@","+import { type Meta, type StoryFn } from '@storybook/react';","+import { action } from 'storybook/actions';","+import { useArgs } from 'storybook/preview-api';","+","+import { rangeUtil } from '@grafana/data';","+","+import { TimeRangeSelector } from './TimeRangeSelector';","+import mdx from './TimeRangeSelector.mdx';","+","+const meta: Meta<typeof TimeRangeSelector> = {","+  title: 'Date time pickers/TimeRangeSelector',","+  component: TimeRangeSelector,","+  args: {","+    value: rangeUtil.convertRawToRange({ from: 'now-6h', to: 'now' }, 'utc'),","+    timeZone: 'utc',","+  },","+  parameters: {","+    docs: { page: mdx },","+    controls: { exclude: ['onChange', 'onChangeTimeZone', 'onChangeFiscalYearStartMonth', 'onError'] },","+  },","+};","+","+export const Basic: StoryFn<typeof TimeRangeSelector> = (args) => {","+  const [, updateArgs] = useArgs();","+  return (","+    <TimeRangeSelector","+      {...args}","+      onChange={(value) => {","+        action('onChange')(value);","+        updateArgs({ value });","+      }}","+      onChangeTimeZone={(timeZone) => {","+        action('onChangeTimeZone')(timeZone);","+        updateArgs({ timeZone });","+      }}","+    />","+  );","+};","+","+export default meta;"],"additions":40,"deletions":0,"truncated":false},{"path":"packages/grafana-ui/src/components/DateTimePickers/TimeRangePicker/TimeRangeSelector.test.tsx","lines":["@@ -0,0 +1,33 @@","+import { render, screen, within } from '@testing-library/react';","+import userEvent from '@testing-library/user-event';","+","+import { rangeUtil } from '@grafana/data';","+","+import { TimeRangeSelector, type TimeRangeSelectorProps } from '../../../unstable';","+","+describe('TimeRangeSelector', () => {","+  it.each([","+    { name: 'default', quickOptions: undefined, label: 'Last 5 minutes', from: 'now-5m' },","+    {","+      name: 'custom',","+      q