ector_index_filter_memory_ratio: 25,","+                    ..Default::default()","+                },","+                Some(max_server_memory_usage / 4),","+            ),","+            (","+                CacheConfig {","+                    vector_index_filter_size: 0,","+                    ..Default::default()","+                },","+                None,","+            ),","+            (","+                CacheConfig {","+                    enable_table_meta_cache: false,","+                    ..Default::default()","+                },","+                None,","+            ),","+        ];","+        for (config, capacity) in cases {","+            let manager = CacheManager::try_new(&config, &max_server_memory_usage, \"test\", false)?;","+            let cache = manager.get_vector_index_cache();","+            assert_eq!(cache.is_some(), capacity.is_some());","+            assert_eq!(cache.bytes_capacity(), capacity.unwrap_or_default());","+            // The same budget must not also be allocated to serialized files in memory.","+            assert!(","+                manager","+                    .get_vector_index_file_cache()","+                    .in_memory_cache()","+                    .is_none()","+            );","+            assert!(","+                manager","+                    .get_vector_index_file_cache()","+                    .on_disk_cache()","+                    .is_none()","+            );","+            if config.enable_table_meta_cache {","+                assert_eq!(","+                    manager.get_vector_index_meta_cache().items_capacity(),","+                    config.vector_index_meta_count","+                );","+            }","+        }","+        Ok(())","+    }","+","+    #[test]","+    fn test_vector_index_capacity_names_resize_the_same_budget() -> Result<()> {","+        let config = CacheConfig {","+            vector_index_filter_size: 0,","+            ..Default::default()","+        };","+        let manager = CacheManager::try_new(&config, &(1024 * 1024), \"test\", false)?;","+        assert!(manager.get_vector_index_cache().is_none());","+        for name in [HYBRID_CACHE_VECTOR_INDEX_FILE, MEMORY_CACHE_VECTOR_INDEX] {","+            manager.set_cache_capacity(name, 12345)?;","+            let cache = manager.get_vector_index_cache().unwrap();","+            assert_eq!(cache.bytes_capacity(), 12345);","+            assert!(","+                manager","+                    .get_vector_index_file_cache()","+                    .in_memory_cache()","+                    .is_none()","+            );","+            manager.set_cache_capacity(name, 0)?;","+            assert_eq!(cache.bytes_capacity(), 0);","+            assert_eq!(manager.get_vector_index_cache().bytes_capacity(), 0);","+        }","+        Ok(())","+    }","+","+    #[test]","+    fn test_vector_index_cache_memory_clearance() -> Result<()> {","+        use databend_common_expression::Column;","+        use databend_common_expression::types::F32;","+        use databend_common_expression::types::VectorColumn;","+        use databend_storages_common_index::DistanceType;","+        use databend_storages_common_index::HNSWIndex;","+","+        use crate::CachedVectorIndex;","+","+        let config = CacheConfig {","+            vector_index_filter_size: 1024 * 1024,","+            ..Default::default()","+        };","+        let manager = CacheManager::try_new(&config, &(1024 * 1024), \"test\", false)?;","+        let cache = manager.get_vector_index_cache().unwrap();","+        let values = (0..64)","+            .map(|i| F32::from((i as f32 * 0.17).sin()))","+            .collect::<Vec<_>>();","+        let column = Column::Vector(VectorColumn::Float32((values.into(), 8)));","+        let (_, entries) = HNSWIndex::build(4, 8, 0, column, DistanceType::L2)?;","+        let columns = entries.iter().map(|entry| entry.to_column()).collect();","+        let index = HNSWIndex::open(DistanceType::L2, 8, 8, columns)?;","+        let reader = cache.insert(\"index\".to_string(), CachedVectorIndex::new(index));","+        manager.release_cache_memory(CacheClearanceLevel::Basic);","+        assert!(cache.is_empty());","+        assert!(cache.bytes_size() > 0);","+        drop(reader);","+        assert_eq!(cache.bytes_size(), 0);","+        Ok(())","+    }","+","+    #[test]","+    fn test_vector_index_files_remain_disk_only_when_memory_budget_changes() -> Result<()> {","+        use crate::VectorIndexFile;","+","+        let temp_dir = TempDir::new()?;","+        let cache_path = temp_dir.path().to_string_lossy();","+        let mut config = config_with_disk_cache_enabled(&cache_path);","+        config.vector_index_filter_size = 12345;","+        let manager = CacheManager::try_new(&config, &(1024 * 1024), \"test\", true)?;","+        let files = manager.get_vector_index_file_cache().unwrap();","+        assert!(files.in_memory_cache().is_none());","+        let disk_capacity = config.disk_cache_vector_index_data_size;","+        assert_eq!(","+            files.on_disk_cache().unwrap().bytes_capacity(),","+            disk_capacity","+        );","+        let data = Bytes::from_static(b\"persisted vector index\");","+        files.insert(","+            \"index\".to_string(),","+            VectorIndexFile::create(\"graph_links\".to_string(), data.clone()),","+        );","+        // Once the padding item leaves the single-worker queue, the first write has completed.","+        files.insert(","+            \"padding\".to_string(),","+            VectorIndexFile::create(\"padding\".to_string(), Bytes::new()),","+        );","+        files","+            .on_disk_cache()","+            .unwrap()","+            .till_no_pending_items_in_queue();","+        for name in [HYBRID_CACHE_VECTOR_INDEX_FILE, MEMORY_CACHE_VECTOR_INDEX] {","+            for capacity in [54321, 0] {","+                manager.set_cache_capacity(name, capacity)?;","+                assert_eq!(manager.get_vector_index_cache().bytes_capacity(), capacity);","+                let files = manager.get_vector_index_file_cache().unwrap();","+                assert!(files.in_memory_cache().is_none());","+                assert_eq!(","+                    files.on_disk_cache().unwrap().bytes_capacity(),","+                    disk_capacity","+                );","+                assert_eq!(files.get(\"index\").unwrap().data, data);","+            }","+        }","+        manager.release_cache_memory(CacheClearanceLevel::Basic);","+        assert_eq!(files.get(\"index\").unwrap().data, data);","+        manager.set_allows_disk_cache(false);","+        assert!(","+            manager","+                .get_vector_index_file_cache()","+                .on_disk_cache()","+                .is_none()","+        );","+        manager.set_allows_disk_cache(true);","+        assert_eq!(","+            manager","+                .get_vector_index_file_cache()","+                .get(\"index\")","+                .unwrap()","+                .data,","+            data","+        );","+        Ok(())","+    }","+","     #[test]","     fn test_inverted_index_cache_capacities_are_independent() -> Result<()> {","         let max_server_memory_usage = 1024 * 1024;"],"additions":222,"deletions":10,"truncated":false},{"path":"src/query/storages/common/cache/src/vector_index_cache.rs","lines":["@@ -0,0 +1,191 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+use std::sync::Arc;","+use std::sync::atomic::AtomicUsize;","+use std::sync::atomic::Ordering;","+","+use databend_common_cache::Cache;","+use databend_common_cache::LruCache;","+use databend_common_metrics::cache::metrics_inc_cache_access_count;","+use databend_common_metrics::cache::metrics_inc_cache_hit_count;","+use databend_common_metrics::cache::metrics_inc_cache_miss_bytes;","+use databend_common_metrics::cache::metrics_inc_cache_miss_count;","+use databend_storages_common_index::HNSWIndex;","+use parking_lot::RwLock;","+","+use crate::CacheAccessor;","+use crate::CacheValue;","+","+// Keep the existing name for monitoring and runtime capacity controls; its memory tier now","+// retains decoded indexes rather than serialized file bytes.","+pub const MEMORY_CACHE_VECTOR_INDEX: &str = \"memory_cache_vector_index_file\";","+","+/// A loaded index and, when admitted to the cache, its lifetime-based memory charge.","+/// Keeping this wrapper outside HNSWIndex leaves the search implementation cache-independent.","+pub struct CachedVectorIndex {","+    index: HNSWIndex,","+    memory_size: usize,","+    _reservation: Option<IndexReservation>,","+}","+","+impl CachedVectorIndex {","+    pub fn new(index: HNSWIndex) -> Self {","+        let memory_size = index.memory_size() + std::mem::size_of::<Self>()","+            - std::mem::size_of::<HNSWIndex>()","+            + 2 * std::mem::size_of::<usize>(); // Arc reference counts.","+        Self {","+            index,","+            memory_size,","+            _reservation: None,","+        }","+    }","+","+    pub fn index(&self) -> &HNSWIndex {","+        &self.index","+    }","+}","+","+struct IndexReservation {","+    bytes: usize,","+    resident_bytes: Arc<AtomicUsize>,","+}","+","+impl Drop for IndexReservation {","+    fn drop(&mut self) {","+        self.resident_bytes.fetch_sub(self.bytes, Ordering::Relaxed);","+    }","+}","+","+/// A byte-limited cache of decoded indexes. Its budget includes admitted objects still held","+/// by readers after eviction or clearance. If readers pin the budget, new indexes are returned","+/// uncached, just as on the original query-local loading path.","+#[derive(Clone)]","+pub struct VectorIndexCache {","+    inner: Arc<RwLock<LruCache<String, CacheValue<CachedVectorIndex>>>>,","+    resident_bytes: Arc<AtomicUsize>,","+}","+","+impl VectorIndexCache {","+    pub fn new(capacity: usize) -> Self {","+        Self {","+            inner: Arc::new(RwLock::new(LruCache::with_bytes_capacity(capacity))),","+            resident_bytes: Arc::new(AtomicUsize::new(0)),","+        }","+    }","+","+    pub fn set_bytes_capacity(&self, capacity: usize) {","+        // Shrinking can evict reader-held objects, but their charges live until the last reader.","+        self.inner.write().set_bytes_capacity(capacity);","+    }","+}","+","+impl CacheAccessor for VectorIndexCache {","+    type V = CachedVectorIndex;","+","+    fn get<Q: AsRef<str>>(&self, key: Q) -> Option<Arc<Self::V>> {","+        metrics_inc_cache_access_count(1, self.name());","+        let value = self","+            .inner","+            .write()","+            .get(key.as_ref())","+            .map(CacheValue::get_inner);","+        if value.is_some() {","+            metrics_inc_cache_hit_count(1, self.name());","+        } else {","+            metrics_inc_cache_miss_count(1, self.name());","+        }","+        value","+    }","+","+    fn get_sized<Q: AsRef<str>>(&self, key: Q, len: u64) -> Option<Arc<Self::V>> {","+        let value = self.get(key);","+        if value.is_none() {","+            metrics_inc_cache_miss_bytes(len, self.name());","+        }","+        value","+    }","+","+    fn insert(&self, key: String, mut value: Self::V) -> Arc<Self::V> {","+        let mut cache = self.inner.write();","+        if let Some(existing) = cache.get(key.as_str()) {","+            return existing.get_inner();","+        }","+","+        let size = value.memory_size;","+        let capacity = cache.bytes_capacity() as usize;","+        // Reject oversized entries before evicting any useful cached indexes.","+        if size > capacity {","+            return Arc::new(value);","+        }","+","+        while self.resident_bytes.load(Ordering::Relaxed) > capacity - size {","+            // Evict the least-recently-used unpinned entry. Dropping a reader-held entry cannot","+            // make room, and would needlessly discard a useful cache reference.","+            let victim = cache","+                .iter()","+                .find(|(_, entry)| !entry.is_shared())","+                .map(|(key, _)| key.clone());","+            let Some(victim) = victim else {","+                return Arc::new(value);","+            };","+            cache.pop(victim.as_str());","+        }","+","+        self.resident_bytes.fetch_add(size, Ordering::Relaxed);","+        value._reservation = Some(IndexReservation {","+            bytes: size,","+            resident_bytes: self.resident_bytes.clone(),","+        });","+        let value = CacheValue::new(value, size);","+        let result = value.get_inner();","+        cache.insert(key, value);","+        result","+    }","+","+    fn evict(&self, key: &str) -> bool {","+        self.inner.write().pop(key).is_some()","+    }","+","+    fn contains_key(&self, key: &str) -> bool {","+        self.inner.read().contains(key)","+    }","+","+    fn bytes_size(&self) -> u64 {","+        self.resident_bytes.load(Ordering::Relaxed) as u64","+    }","+","+    fn items_capacity(&self) -> u64 {","+        self.inner.read().items_capacity()","+    }","+","+    fn bytes_capacity(&self) -> u64 {","+        self.inner.read().bytes_capacity()","+    }","+","+    fn len(&self) -> usize {","+        self.inner.read().len()","+    }","+","+    fn name(&self) -> &str {","+        MEMORY_CACHE_VECTOR_INDEX","+    }","+","+    fn clear(&self) {","+        self.inner.write().clear();","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":191,"deletions":0,"truncated":false},{"path":"src/query/storages/common/cache/src/vector_index_cache/tests.rs","lines":["@@ -0,0 +1,189 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+use databend_common_expression::Column;","+use databend_common_expression::types::F32;","+use databend_common_expression::types::VectorColumn;","+use databend_storages_common_index::DistanceType;","+","+use super::*;","+","+const COUNT: usize = 8;","+","+fn index_columns(dim: usize) -> Vec<Column> {","+    let values = (0..COUNT * dim)","+        .map(|i| F32::from((i as f32 * 0.17).sin()))","+        .collect::<Vec<_>>();","+    let column = Column::Vector(VectorColumn::Float32((values.into(), dim)));","+    let (_, entries) = HNSWIndex::build(4, 8, 0, column, DistanceType::L2).unwrap();","+    entries.iter().map(|entry| entry.to_column()).collect()","+}","+","+fn index(columns: &[Column], dim: usize) -> CachedVectorIndex {","+    CachedVectorIndex::new(HNSWIndex::open(DistanceType::L2, dim, COUNT, columns.to_vec()).unwrap())","+}","+","+#[test]","+fn test_evicted_index_stays_charged_until_last_reader() {","+    let columns = index_columns(8);","+    let value = index(&columns, 8);","+    let size = value.memory_size as u64;","+    let cache = VectorIndexCache::new(size as usize);","+    let reader = cache.insert(\"index\".to_string(), value);","+    assert_eq!(cache.bytes_size(), size);","+    assert!(cache.evict(\"index\"));","+    assert!(cache.is_empty());","+    assert_eq!(cache.bytes_size(), size);","+","+    let another_reader = reader.clone();","+    drop(reader);","+    assert_eq!(cache.bytes_size(), size);","+    drop(another_reader);","+    assert_eq!(cache.bytes_size(), 0);","+}","+","+#[test]","+fn test_oversized_index_does_not_evict_hot_index() {","+    let columns = index_columns(8);","+    let value = index(&columns, 8);","+    let size = value.memory_size;","+    let cache = VectorIndexCache::new(size);","+    drop(cache.insert(\"hot\".to_string(), value));","+","+    let large_columns = index_columns(256);","+    let large = index(&large_columns, 256);","+    assert!(large.memory_size > size);","+    let reader = cache.insert(\"large\".to_string(), large);","+    let baseline = HNSWIndex::open(DistanceType::L2, 256, COUNT, large_columns).unwrap();","+    let query = vec![0.0; 256];","+    assert_eq!(","+        reader.index().search(3, &query).unwrap(),","+        baseline.search(3, &query).unwrap()","+    );","+    assert_eq!(","+        reader","+            .index()","+            .generate_scores(COUNT as u32, &query)","+            .unwrap(),","+        baseline.generate_scores(COUNT as u32, &query).unwrap()","+    );","+    assert!(!cache.contains_key(\"large\"));","+    assert!(cache.contains_key(\"hot\"));","+    assert_eq!(cache.bytes_size(), size as u64);","+    drop(reader);","+    assert_eq!(cache.bytes_size(), size as u64);","+}","+","+#[test]","+fn test_pinned_budget_bypasses_admission_then_allows_lru_eviction() {","+    let columns = index_columns(8);","+    let value = index(&columns, 8);","+    let size = value.memory_size;","+    let cache = VectorIndexCache::new(size);","+    let pinned = cache.insert(\"first\".to_string(), value);","+","+    let bypassed = cache.insert(\"second\".to_string(), index(&columns, 8));","+    assert!(cache.contains_key(\"first\"));","+    assert!(!cache.contains_key(\"second\"));","+    assert_eq!(cache.bytes_size(), size as u64);","+    drop(bypassed);","+    drop(pinned);","+","+    let second = cache.insert(\"second\".to_string(), index(&columns, 8));","+    assert!(!cache.contains_key(\"first\"));","+    assert!(cache.contains_key(\"second\"));","+    assert_eq!(cache.bytes_size(), size as u64);","+    cache.clear();","+    assert!(cache.is_empty());","+    assert_eq!(cache.bytes_size(), size as u64);","+    drop(second);","+    assert_eq!(cache.bytes_size(), 0);","+}","+","+#[test]","+fn test_shrinking_and_disabling_preserve_live_charges() {","+    let columns = index_columns(8);","+    let first = index(&columns, 8);","+    let size = first.memory_size;","+    let cache = VectorIndexCache::new(size * 2);","+    let first = cache.insert(\"first\".to_string(), first);","+    let second = cache.insert(\"second\".to_string(), index(&columns, 8));","+    assert_eq!(cache.bytes_size(), (size * 2) as u64);","+","+    cache.set_bytes_capacity(size);","+    assert_eq!(cache.len(), 1);","+    assert_eq!(cache.bytes_size(), (size * 2) as u64);","+    drop(first);","+    assert_eq!(cache.bytes_size(), size as u64);","+","+    cache.set_bytes_capacity(0);","+    assert!(cache.is_empty());","+    let bypassed = cache.insert(\"disabled\".to_string(), index(&columns, 8));","+    assert!(cache.is_empty());","+    assert_eq!(cache.bytes_size(), size as u64);","+    drop(second);","+    drop(bypassed);","+    assert_eq!(cache.bytes_size(), 0);","+}","+","+#[test]","+fn test_lru_order_and_duplicate_insertion() {","+    let columns = index_columns(8);","+    let first = index(&columns, 8);","+    let cache = VectorIndexCache::new(first.memory_size * 2);","+    drop(cache.insert(\"first\".to_string(), first));","+    drop(cache.insert(\"second\".to_string(), index(&columns, 8)));","+    let first = cache.get(\"first\").unwrap();","+    let duplicate = cache.insert(\"first\".to_string(), index(&columns, 8));","+    assert!(Arc::ptr_eq(&first, &duplicate));","+    drop(first);","+    drop(duplicate);","+    drop(cache.insert(\"third\".to_string(), index(&columns, 8)));","+    assert!(cache.contains_key(\"first\"));","+    assert!(!cache.contains_key(\"second\"));","+    assert!(cache.contains_key(\"third\"));","+}","+","+#[test]","+fn test_shared_index_search_and_counter_wraparound() {","+    let columns = index_columns(8);","+    let baseline = HNSWIndex::open(DistanceType::L2, 8, COUNT, columns.clone()).unwrap();","+    let cache = VectorIndexCache::new(1024 * 1024);","+    let shared = cache.insert(\"shared\".to_string(), index(&columns, 8));","+    let size = cache.bytes_size();","+    std::thread::scope(|scope| {","+        for thread in 0..4 {","+            let shared = &shared;","+            let baseline = &baseline;","+            scope.spawn(move || {","+                let query = vec![thread as f32 * 0.1; 8];","+                let expected = baseline.search(3, &query).unwrap();","+                let expected_scores = baseline.generate_scores(COUNT as u32, &query).unwrap();","+                // More than u8::MAX searches exercise reset of the reusable visited counters.","+                for _ in 0..300 {","+                    assert_eq!(shared.index().search(3, &query).unwrap(), expected);","+                    assert_eq!(","+                        shared","+                            .index()","+                            .generate_scores(COUNT as u32, &query)","+                            .unwrap(),","+                        expected_scores","+                    );","+                }","+            });","+        }","+    });","+    assert_eq!(cache.bytes_size(), size);","+    assert_eq!(shared.index().memory_size(), baseline.memory_size());","+}"],"additions":189,"deletions":0,"truncated":false},{"path":"src/query/storages/common/index/src/hnsw_index/common/fixed_length_priority_queue.rs","lines":[],"additions":0,"deletions":