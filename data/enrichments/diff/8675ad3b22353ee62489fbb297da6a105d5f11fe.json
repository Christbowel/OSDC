6 +550,7 @@ impl CacheManager {","                 inverted_index_full_payload_cache,","                 vector_index_meta_cache,","                 vector_index_file_cache,","+                vector_index_cache,","                 spatial_index_meta_cache,","                 spatial_index_file_cache,","                 virtual_column_meta_cache,","@@ -589,6 +599,7 @@ impl CacheManager {","             // are retained until deep clearance.","             CacheManager::clear_cache(&me.inverted_index_full_payload_cache);","             CacheManager::clear_cache(&me.inverted_index_payload_cache);","+            CacheManager::clear_cache(&me.vector_index_cache);","         }"," ","         fn clear_extra_caches(me: &CacheManager) {","@@ -680,12 +691,16 @@ impl CacheManager {","                     name,","                 );","             }","-            HYBRID_CACHE_VECTOR_INDEX_FILE | IN_MEMORY_HYBRID_CACHE_VECTOR_INDEX_FILE => {","-                Self::set_hybrid_cache_bytes_capacity(","-                    &self.vector_index_file_cache,","-                    new_capacity,","-                    name,","-                );","+            HYBRID_CACHE_VECTOR_INDEX_FILE | MEMORY_CACHE_VECTOR_INDEX => {","+                let capacity = usize::try_from(new_capacity).map_err(|_| {","+                    ErrorCode::BadArguments(\"decoded vector-index cache size exceeds this platform\")","+                })?;","+                if let Some(cache) = self.vector_index_cache.get() {","+                    cache.set_bytes_capacity(capacity);","+                } else if capacity > 0 {","+                    self.vector_index_cache","+                        .set(Some(VectorIndexCache::new(capacity)));","+                }","             }","             HYBRID_CACHE_SPATIAL_INDEX_FILE_META_DATA","             | IN_MEMORY_HYBRID_CACHE_SPATIAL_INDEX_FILE_META_DATA => {","@@ -891,6 +906,10 @@ impl CacheManager {","         self.get_hybrid_cache(self.vector_index_file_cache.g