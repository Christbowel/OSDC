 \"10GB\", \"500MB\", or raw bytes).","+        #[arg(long)]","+        max_size: Option<String>,","+        /// Maximum file age in seconds. Entries older than this are deleted.","+        #[arg(long)]","+        max_age_secs: Option<u64>,","+        /// Only prune orphaned upstream namespaces without evicting active cache files.","+        #[arg(long)]","+        orphans_only: bool,","+    },","+    /// Validate configuration and report diagnostics.","+    #[command(name = \"config-check\", alias = \"check-config\", alias = \"check\")]","+    ConfigCheck,","+    /// Configuration management commands.","+    Config {","+        #[command(subcommand)]","+        action: ConfigSubcommand,","+    },","+    /// Verify every document against its blobs (tarballs, attestations).","+    Verify {","+        /// Skip cryptographic hash verification (SHA-512 / SHA-1) of stored blobs against packument integrity.","+        #[arg(long, alias = \"no-check-hashes\")]","+        skip_hashes: bool,","+        /// Remove orphaned blobs from storage.","+        #[arg(long)]","+        prune_orphans: bool,","+        /// Minimum age in seconds before an unreferenced blob is considered for pruning.","+        #[arg(long, default_value_t = 86400)]","+        min_age_secs: u64,","+    },","+    /// Export hosted packages and blobs to a directory.","+    Export {","+        /// Target directory to export packages into.","+        #[arg(long)]","+        out: PathBuf,","+        /// Include auth files (htpasswd, tokens.db) in export.","+        #[arg(long)]","+        include_auth: bool,","+    },","+    /// Migrate hosted packages and blobs from local disk storage to S3.","+    MigrateStorage {","+        /// Source local storage directory. Defaults to config storage directory.","+        #[arg(long)]","+        from: Option<PathBuf>,","+        /// Destination S3 bucket name. Defaults to config S3 bucket.","+        #[arg(long)]","+        to_bucket: Option<String>,","+        /// Destination S3 region. Defaults to config S3 region.","+        #[arg(long)]","+        to_region: Option<String>,","+        /// Destination S3 endpoint URL. Defaults to config S3 endpoint.","+        #[arg(long)]","+        to_endpoint: Option<String>,","+        /// Destination S3 prefix. Defaults to config S3 prefix.","+        #[arg(long)]","+        to_prefix: Option<String>,","+        /// Report what would be migrated without writing to S3.","+        #[arg(long)]","+        dry_run: bool,","+        /// Verify uploaded blobs in target store after writing.","+        #[arg(long)]","+        verify: bool,","+    },","+    /// Import users from an existing Verdaccio or Apache htpasswd file.","+    ImportHtpasswd {","+        /// Path to source htpasswd file.","+        #[arg(long)]","+        source: PathBuf,","+        /// Path to target htpasswd file. Defaults to config htpasswd file.","+        #[arg(long)]","+        target: Option<PathBuf>,","+        /// Report what would be imported without writing to target file.","+        #[arg(long)]","+        dry_run: bool,","+        /// Overwrite conflicting credentials for existing users in destination file.","+        #[arg(long)]","+        overwrite: bool,","+    },","+}","+","+#[derive(Debug, Subcommand)]","+pub enum ConfigSubcommand {","+    /// Validate configuration and report diagnostics.","+    Check,","+}","+","+pub async fn run_command(config: &Config, command: Command) -> miette::Result<()> {","+    match command {","+        Command::OciGc { .. } => run_oci_gc_command(config, command).await,","+        Command::CacheGc { .. } => run_cache_gc_command(config, command).await,","+        Command::ConfigCheck | Command::Config { .. } => run_config_check(),","+        Command::Verify { .. } => run_verify_command(config, command).await,","+        Command::Export { .. } => run_export_command(config, command).await,","+        Command::MigrateStorage { .. } => run_migrate_command(config, command).await,","+        Command::ImportHtpasswd { .. } => run_import_command(config, command),","+    }","+}","+","+async fn run_oci_gc_command(config: &Config, command: Command) -> miette::Result<()> {","+    let Command::OciGc { registry, dry_run, min_age_secs } = command else {","+        return Ok(());","+    };","+    run_oci_gc(config, registry, dry_run, min_age_secs).await","+}","+","+async fn run_cache_gc_command(config: &Config, command: Command) -> miette::Result<()> {","+    let Command::CacheGc {","+        dry_run,","+        max_size,","+        max_age_secs,","+        orphans_only,","+    } = command","+    else {","+        return Ok(());","+    };","+    run_cache_gc(config, dry_run, max_size, max_age_secs, orphans_only).await","+}","+","+async fn run_verify_command(config: &Config, command: Command) -> miette::Result<()> {","+    let Command::Verify {","+        skip_hashes,","+        prune_orphans,","+        min_age_secs,","+    } = command","+    else {","+        return Ok(());","+    };","+    run_verify(config, !skip_hashes, prune_orphans, min_age_secs).await","+}","+","+async fn run_export_command(config: &Config, command: Command) -> miette::Result<()> {","+    let Command::Export { out, include_auth } = command else {","+        return Ok(());","+    };","+    run_export(config, out, include_auth).await","+}","+","+async fn run_migrate_command(config: &Config, command: Command) -> miette::Result<()> {","+    let Command::MigrateStorage {","+        from,","+        to_bucket,","+        to_region,","+        to_endpoint,","+        to_prefix,","+        dry_run,","+        verify,","+    } = command","+    else {","+        return Ok(());","+    };","+    let options = pnpr::migrate_storage::MigrateStorageOptions {","+        from,","+        to_bucket,","+        to_region,","+        to_endpoint,","+        to_prefix,","+        dry_run,","+        verify,","+    };","+    run_migrate_storage(config, options).await","+}","+","+fn run_import_command(config: &Config, command: Command) -> miette::Result<()> {"],"additions":187,"deletions":0,"truncated":false}],"additions":455,"deletions":38,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-10-17T12:24:51.173593+00:00"}