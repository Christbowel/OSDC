67,23 @@ impl AuthSqlBackend for PostgresDatabase {","         Ok(updated.rows_affected() > 0)","     }"," ","+    async fn update_user_hash_if_current(","+        &self,","+        username: &str,","+        old_hash: &str,","+        new_hash: &str,","+    ) -> Result<bool> {","+        let updated = sqlx::query(","+            \"UPDATE users SET bcrypt_hash = $3 WHERE username = $1 AND bcrypt_hash = $2\",","+        )","+        .bind(username)","+        .bind(old_hash)","+        .bind(new_hash)","+        .execute(&self.pool)","+        .await?;","+        Ok(updated.rows_affected() > 0)","+    }","+","     async fn delete_user(&self, username: &str) -> Result<bool> {","         let mut tx = self.pool.begin().await?;","         let removed = sqlx::query(\"DELETE FROM users WHERE username = $1\")","@@ -193,8 +210,8 @@ impl AuthSqlBackend for PostgresDatabase {"," impl PostgresDatabase {","     async fn init_schema(&self) -> Result<()> {","         sqlx::query(super::super::USERS_TABLE_SQL).execute(&self.pool).await?;","-        sqlx::query(super::super::token_store::TOKENS_TABLE_SQL).execute(&self.pool).await?;","-        sqlx::query(super::super::token_store::TOKENS_INDEX_SQL).execute(&self.pool).await?;","+        sqlx::query(super::super::token_store::sqlite::TOKENS_TABLE_SQL).execute(&self.pool).await?;","+        sqlx::query(super::super::token_store::sqlite::TOKENS_INDEX_SQL).execute(&self.pool).await?;","         sqlx::query(\"ALTER TABLE tokens ADD COLUMN IF NOT EXISTS name VARCHAR(255)\")","             .execute(&self.pool)","             .await?;"],"additions":19,"deletions":2,"truncated":false},{"path":"pnpr/crates/auth/src/tests.rs","lines":["@@ -873,3 +873,42 @@ async fn verify_bcrypt_handles_passwords_exceeding_72_bytes() {","     let password_72 = \"a\".repeat(72);","     assert!(!super::verify_bcrypt(password_72, hash).await.unwrap());"," }","+","+#[test]","+fn parse_htpasswd_accepts_sha1_entries() {","+    let raw = \"alice:{SHA}qUqP5cyxm6YcTAhz05Hph5gvu9M=\\nbob:$2y$04$somevalidhashhere12345678901234567890123456789012\\n\";","+    let users = super::parse_htpasswd(raw).unwrap();","+    assert_eq!(users.get(\"alice\"), Some(&\"{SHA}qUqP5cyxm6YcTAhz05Hph5gvu9M=\".to_string()));","+    assert!(users.contains_key(\"bob\"));","+}","+","+#[tokio::test]","+async fn sha1_user_authenticates_and_upgrades_to_bcrypt() {","+    let dir = tempfile::tempdir().unwrap();","+    let path = dir.path().join(\"htpasswd\");","+    // \"test\" hashed with SHA-1 in Apache/Verdaccio format","+    std::fs::write(&path, \"verdaccio_user:{SHA}qUqP5cyxm6YcTAhz05Hph5gvu9M=\\n\").unwrap();","+","+    let store =","+        UserStore::open_with_cost(path.clone(), pnpr_config::MaxUsers::Unlimited, TEST_COST)","+            .unwrap();","+","+    // Wrong password fails","+    let err = store.add_or_login(\"verdaccio_user\", \"wrong\").await.unwrap_err();","+    assert!(matches!(err, pnpr_error::RegistryError::Unauthenticated { .. }));","+","+    // Correct password succeeds","+    let (outcome, user) = store.add_or_login(\"verdaccio_user\", \"test\").await.unwrap();","+    assert_eq!(outcome, super::UpsertOutcome::LoggedIn);","+    assert_eq!(user, \"verdaccio_user\");","+","+    // File on disk is now upgraded to bcrypt","+    let content = std::fs::read_to_string(&path).unwrap();","+    assert!(!content.contains(\"{SHA}\"));","+    assert!(content.contains(\"verdaccio_user:$2y$\"));","+","+    // Verify returning user can log in with new bcrypt hash","+    let (outcome2, user2) = store.add_or_login(\"verdaccio_user\", \"test\").await.unwrap();","+    assert_eq!(outcome2, super::UpsertOutcome::LoggedIn);","+    assert_eq!(user2, \"verdaccio_user\");","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/token_store.rs","lines":["@@ -1,7 +1,5 @@"," pub(super) mod sqlite;"," ","-pub(super) use sqlite::{TOKENS_INDEX_SQL, TOKENS_TABLE_SQL};","-"," use super::{","     AtomicU64, Connection, Digest, HashMap, Hash