{"id":"141dcd53ccdef0d8e208c63c6262e7e586a5ea8f","axis":"silent","repo":"envoyproxy/envoy","sha":"141dcd53ccdef0d8e208c63c6262e7e586a5ea8f","parsed":{"files":[{"path":"changelogs/current/bug_fixes/alts__end-of-stream-with-last-handshake-message.rst","lines":["@@ -0,0 +1,2 @@","+Fixed the ALTS transport socket dropping the peer's end of stream when it arrived together with the","+peer's last handshake message. The end of stream is now reported once the handshake completes."],"additions":2,"deletions":0,"truncated":false},{"path":"changelogs/current/minor_behavior_changes/alts__async-handshaker-service-calls.rst","lines":["@@ -0,0 +1,9 @@","+The ALTS transport socket's server-side (downstream) handshakes now talk to the ALTS handshaker","+service through Envoy's async gRPC client instead of blocking gRPC calls. Previously, each call","+blocked the worker thread until the handshaker service responded, for up to 30 seconds, so a slow","+or unreachable handshaker service stalled every connection on that worker. A worker now keeps","+serving its other connections while a handshake waits, a handshake whose connection closes is","+cancelled, and the handshaker service streams are counted in the ``grpc.alts_handshaker.*`` gRPC","+client stats. Client-side (upstream) handshakes still make blocking calls. This behavior can be","+temporarily reverted by setting runtime guard ``envoy.reloadable_features.alts_async_handshaker``","+to ``false``."],"additions":9,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -35,6 +35,11 @@"," // If issues are found that require a runtime feature to be disabled, it should be reported"," // ASAP by filing a bug on github. Overriding non-buggy code is strongly discouraged to avoid the"," // problem of the bugs being found after the old code path has been removed.","+","+// When enabled, which is the default, the ALTS transport socket's server-side handshakes talk to","+// the ALTS handshaker service through Envoy's async gRPC client, so a worker thread never waits for","+// the handshaker service. Disable to restore the previous blocking gRPC calls.","+RUNTIME_GUARD(envoy_reloadable_features_alts_async_handshaker);"," RUNTIME_GUARD(envoy_reloadable_features_async_host_selection);"," RUNTIME_GUARD(envoy_reloadable_features_cache_parsed_tls_certificates);"," RUNTIME_GUARD(envoy_reloadable_features_cares_dual_resolution_preserve_failure);"],"additions":5,"deletions":0,"truncated":false},{"path":"source/extensions/transport_sockets/alts/BUILD","lines":["@@ -34,12 +34,23 @@ envoy_cc_extension(","     ],","     deps = [","         \":alts_channel_pool\",","+        \":alts_tsi_handshaker\",","         \":tsi_handshaker\",","         \":tsi_socket\",","+        \"//envoy/event:dispatcher_interface\",","+        \"//envoy/grpc:async_client_interface\",","+        \"//envoy/grpc:async_client_manager_interface\",","+        \"//envoy/network:address_interface\",","         \"//envoy/registry\",","         \"//envoy/server:transport_socket_config_interface\",","+        \"//envoy/stats:stats_interface\",","+        \"//envoy/upstream:cluster_manager_interface\",","+        \"//source/common/common:minimal_logger_lib\",","         \"//source/common/grpc:google_grpc_context_lib\",","+        \"//source/common/runtime:runtime_features_lib\",","         \"@abseil-cpp//absl/container:node_hash_set\",","+        \"@abseil-cpp//absl/status:statusor\",","+        \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/transport_sockets/alts/v3:pkg_cc_proto\",","     ],"," )","@@ -133,6 +144,33 @@ envoy_cc_library(","         \"@abseil-cpp//absl/memory\",","         \"@abseil-cpp//absl/status\",","         \"@abseil-cpp//absl/status:statusor\",","+        \"@abseil-cpp//absl/strings\",","+        \"@abseil-cpp//absl/time\",","+        \"@grpc//src/proto/grpc/gcp:alts_handshaker_cc_grpc\",","+    ],","+)","+","+envoy_cc_library(","+    name = \"alts_async_proxy\",","+    srcs = [\"alts_async_proxy.cc\"],","+    hdrs = [\"alts_async_proxy.h\"],","+    deps = [","+        \":alts_proxy\",","+        \"//envoy/grpc:async_client_interface\",","+        \"//envoy/grpc:status\",","+        \"//envoy/http:async_client_interface\",","+        \"//envoy/http:header_map_interface\",","+        \"//source/common/common:assert_lib\",","+        \"//source/common/common:minimal_logger_lib\",","+        \"//source/common/grpc:typed_async_client_lib\",","+        \"//source/common/protobuf\",","+        \"@abseil-cpp//absl/functional:any_invocable\",","+        \"@abseil-cpp//absl/memory\",","+        \"@abseil-cpp//absl/status\",","+        \"@abseil-cpp//absl/status:statusor\",","+        \"@abseil-cpp//absl/strings\",","+        \"@abseil-cpp//absl/time\",","+        \"@abseil-cpp//absl/types:span\",","         \"@grpc//src/proto/grpc/gcp:alts_handshaker_cc_grpc\",","     ],"," )","@@ -143,10 +181,14 @@ envoy_cc_library(","     hdrs = [\"alts_tsi_handshaker.h\"],","     external_deps = [\"grpc\"],","     deps = [","+        \":alts_async_proxy\",","         \":alts_proxy\",","         \":tsi_frame_protector\",","+        \"//envoy/grpc:async_client_interface\",","+        \"//source/common/common:assert_lib\",","         \"@abseil-cpp//absl/memory\",","         \"@abseil-cpp//absl/status\",","+        \"@abseil-cpp//absl/strings\",","         \"@grpc//src/proto/grpc/gcp:alts_handshaker_cc_grpc\",","     ],"," )"],"additions":42,"deletions":0,"truncated":false},{"path":"source/extensions/transport_sockets/alts/alts_async_proxy.cc","lines":["@@ -0,0 +1,162 @@","+#include \"source/extensions/transport_sockets/alts/alts_async_proxy.h\"","+","+#include <cstdint>","+#include <memory>","+#include <string>","+#include <utility>","+","+#include \"envoy/grpc/async_client.h\"","+#include \"envoy/grpc/status.h\"","+#include \"envoy/http/async_client.h\"","+","+#include \"source/common/common/assert.h\"","+#include \"source/common/common/logger.h\"","+#include \"source/common/grpc/typed_async_client.h\"","+#include \"source/common/protobuf/protobuf.h\"","+#include \"source/extensions/transport_sockets/alts/alts_proxy.h\"","+","+#include \"absl/memory/memory.h\"","+#include \"absl/status/status.h\"","+#include \"absl/strings/str_cat.h\"","+#include \"absl/time/time.h\"","+#include \"absl/types/span.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace TransportSockets {","+namespace Alts {","+","+using ::grpc::gcp::HandshakerReq;","+using ::grpc::gcp::HandshakerResp;","+","+namespace {","+","+// Returns the descriptor of the method that streams ALTS handshakes.","+const Protobuf::MethodDescriptor& doHandshakeMethod() {","+  static const Protobuf::MethodDescriptor* const method = [] {","+    return Protobuf::DescriptorPool::generated_pool()->FindMethodByName(","+        \"grpc.gcp.HandshakerService.DoHandshake\");","+  }();","+","+  RELEASE_ASSERT(method != nullptr, \"grpc.gcp.HandshakerService.DoHandshake not found\");","+  return *method;","+}","+","+absl::StatusCode toAbslStatusCode(Grpc::Status::GrpcStatus status) {","+  // gRPC and absl status codes have the same numeric values.","+  if (status < 0 || status > Grpc::Status::WellKnownGrpcStatus::MaximumKnown) {","+    return absl::StatusCode::kUnknown;","+  }","+  return static_cast<absl::StatusCode>(status);","+}","+","+} // namespace","+","+absl::StatusOr<std::unique_ptr<AltsAsyncProxy>>","+AltsAsyncProxy::create(Grpc::RawAsyncClientSharedPtr handshaker_client,","+                       const absl::string_view target_name) {","+  if (handshaker_client == nullptr) {","+    return absl::InvalidArgumentError(\"Handshaker service client is null.\");","+  }","+  auto proxy = absl::WrapUnique(new AltsAsyncProxy(std::move(handshaker_client), target_name));","+  Http::AsyncClient::StreamOptions options;","+  options.setTimeout(absl::ToChronoMilliseconds(AltsClientContextDeadline));","+  proxy->stream_ = proxy->client_.start(doHandshakeMethod(), *proxy, options);","+  if (proxy->stream_ == nullptr) {","+    // The gRPC client normally reports why via onRemoteClose() first.","+    if (proxy->remote_close_status_.ok()) {","+      return absl::UnavailableError(\"Failed to start a stream to the handshaker service.\");","+    }","+    return proxy->remote_close_status_;","+  }","+  return proxy;","+}","+","+AltsAsyncProxy::AltsAsyncProxy(Grpc::RawAsyncClientSharedPtr handshaker_client,","+                               const absl::string_view target_name)","+    : client_(std::move(handshaker_client)), target_name_(target_name) {}","+","+AltsAsyncProxy::~AltsAsyncProxy() {","+  // Whether the owner is abandoning a request that still waits for the handshaker service.","+  const bool request_outstanding = on_response_ != nullptr;","+","+  // The owner is going away: a failure that the gRPC client reports while the","+  // stream closes must not reach it.","+  on_response_ = nullptr;","+  if (stream_ != nullptr && !remote_closed_) {","+    if (request_outstanding) {","+      // Cancel the call now, so that its stream on the handshaker service","+      // connection is freed right away instead of after remote_close_timeout.","+      stream_.resetStream();","+    } else {","+      stream_.closeStream();","+      stream_.waitForRemoteCloseAndDelete();","+    }","+  }","+}","+","+absl::Status AltsAsyncProxy::sendStartClientHandshakeReq(OnResponse on_response) {","+  return send(AltsProxy::makeStartClientHandshakeReq(target_name_), std::move(on_response));","+}","+","+absl::Status AltsAsyncProxy::sendStartServerHandshakeReq(const absl::Span<const uint8_t> in_bytes,","+                                                         OnResponse on_response) {","+  return send(AltsProxy::makeStartServerHandshakeReq(in_bytes), std::move(on_response));","+}","+","+absl::Status AltsAsyncProxy::sendNextHandshakeReq(const absl::Span<const uint8_t> in_bytes,","+                                                  OnResponse on_response) {","+  return send(AltsProxy::makeNextHandshakeReq(in_bytes), std::move(on_response));","+}","+","+absl::Status AltsAsyncProxy::send(const HandshakerReq& request, OnResponse on_response) {","+  // create() only returns a proxy whose stream started. Once the handshaker","+  // service closes the stream, the client deletes it, and remote_closed_ guards that.","+  ASSERT(stream_ != nullptr);","+","+  if (on_response_ != nullptr) {","+    return absl::FailedPreconditionError(","+        \"A request to the handshaker service is already outstanding.\");","+  }","+  if (remote_closed_) {","+    return remote_close_status_;","+  }","+  // Store the callback before sending: a failure may be reported while sending.","+  on_response_ = std::move(on_response);","+  stream_.sendMessage(request, /*end_stream=*/false);","+  return absl::OkStatus();","+}","+","+void AltsAsyncProxy::onReceiveMessage(Grpc::ResponsePtr<HandshakerResp>&& response) {","+  if (on_response_ == nullptr) {","+    ENVOY_LOG(debug, \"ALTS: ignoring an unexpected message from the handshaker service\");","+    return;","+  }","+  OnResponse on_response = std::move(on_response_);","+  on_response_ = nullptr;","+  on_response(AltsProxy::checkResponse(std::move(*response)));","+}","+","+void AltsAsyncProxy::onRemoteClose(const Grpc::Status::GrpcStatus status,","+                                   const std::string& message) {","+  remote_closed_ = true;","+  if (status == Grpc::Status::WellKnownGrpcStatus::Ok) {","+    remote_close_status_ = absl::InternalError(\"The handshaker service closed the stream.\");","+  } else {","+    remote_close_status_ = absl::Status(","+        toAbslStatusCode(status),","+        message.empty() ? \"The stream to the handshaker service failed.\"","+                        : absl::StrCat(\"The stream to the handshaker service failed: \", message));","+  }","+  ENVOY_LOG(debug, \"ALTS: handshaker service stream closed: {}\", remote_close_status_.ToString());","+  if (on_response_ != nullptr) {","+    OnResponse on_response = std::move(on_response_);","+    on_response_ = nullptr;","+    on_response(remote_close_status_);","+  }","+}","+","+} // namespace Alts","+} // namespace TransportSockets","+} // namespace Extensions","+} // namespace Envoy"],"additions":162,"deletions":0,"truncated":false},{"path":"source/extensions/transport_sockets/alts/alts_async_proxy.h","lines":["@@ -0,0 +1,85 @@","+#pragma once","+","+#include <cstdint>","+#include <memory>","+#include <string>","+","+#include \"envoy/grpc/async_client.h\"","+#include \"envoy/grpc/status.h\"","+#include \"envoy/http/header_map.h\"","+","+#include \"source/common/common/logger.h\"","+#include \"source/common/grpc/typed_async_client.h\"","+","+#include \"absl/functional/any_invocable.h\"","+#include \"absl/status/status.h\"","+#include \"absl/status/statusor.h\"","+#include \"absl/strings/string_view.h\"","+#include \"absl/types/span.h\"","+#include \"src/proto/grpc/gcp/handshaker.pb.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace TransportSockets {","+namespace Alts {","+","+// Manages a bidirectional stream to the ALTS handshaker service over Envoy's","+// asynchronous gRPC client. An AltsAsyncProxy instance is tied to a single ALTS","+// handshake and must not be reused.","+//","+// Unlike AltsProxy, no method blocks: a request is sent without waiting, and","+// the handshaker service's response is delivered later, on the thread that owns","+// the gRPC client, i.e. the worker thread performing the ALTS handshake. While a","+// request is outstanding, that worker keeps serving its other connections.","+class AltsAsyncProxy : public Grpc::AsyncStreamCallbacks<grpc::gcp::HandshakerResp>,","+                       Logger::Loggable<Logger::Id::connection> {","+public:","+  // Receives the handshaker service's response to a request, or the reason why","+  // there is none.","+  using OnResponse = absl::AnyInvocable<void(absl::StatusOr<grpc::gcp::HandshakerResp>)>;","+","+  // Starts a stream to the ALTS handshaker service. handshaker_client must","+  // belong to the calling thread.","+  static absl::StatusOr<std::unique_ptr<AltsAsyncProxy>>","+  create(Grpc::RawAsyncClientSharedPtr handshaker_client, absl::string_view target_name = \"\");","+","+  // Cancels the stream if a request is outstanding;","+  // otherwise half-closes it if the handshaker service has not closed it yet.","+  ~AltsAsyncProxy() override;","+","+  // Each of the following sends one request to the ALTS handshaker service. If","+  // this returns OK, on_response is invoked exactly once, with the response or","+  // with an error, unless this AltsAsyncProxy is destroyed first. If this","+  // returns an error, on_response is never invoked. At most one request may be","+  // outstanding at a time.","+  absl::Status sendStartClientHandshakeReq(OnResponse on_response);","+  absl::Status sendStartServerHandshakeReq(absl::Span<const uint8_t> in_bytes,","+                                           OnResponse on_response);","+  absl::Status sendNextHandshakeReq(absl::Span<const uint8_t> in_bytes, OnResponse on_response);","+","+  // Grpc::AsyncStreamCallbacks","+  void onCreateInitialMetadata(Http::RequestHeaderMap&) override {}","+  void onReceiveInitialMetadata(Http::ResponseHeaderMapPtr&&) override {}","+  void onReceiveMessage(Grpc::ResponsePtr<grpc::gcp::HandshakerResp>&& response) override;","+  void onReceiveTrailingMetadata(Http::ResponseTrailerMapPtr&&) override {}","+  void onRemoteClose(Grpc::Status::GrpcStatus status, const std::string& message) override;","+","+private:","+  AltsAsyncProxy(Grpc::RawAsyncClientSharedPtr handshaker_client, absl::string_view target_name);","+","+  absl::Status send(const grpc::gcp::HandshakerReq& request, OnResponse on_response);","+","+  Grpc::AsyncClient<grpc::gcp::HandshakerReq, grpc::gcp::HandshakerResp> client_;","+  Grpc::AsyncStream<grpc::gcp::HandshakerReq> stream_;","+  const std::string target_name_;","+  // The callback of the outstanding request, if any.","+  OnResponse on_response_;","+  // Set once the stream has been closed by the handshaker service, or has failed.","+  bool remote_closed_{false};","+  absl::Status remote_close_status_;","+};","+","+} // namespace Alts","+} // namespace TransportSockets","+} // namespace Extensions","+} // namespace Envoy"],"additions":85,"deletions":0,"truncated":false},{"path":"source/extensions/transport_sockets/alts/alts_channel_pool.cc","lines":["@@ -1,6 +1,7 @@"," #include \"source/extensions/transport_sockets/alts/alts_channel_pool.h\""," "," #include <algorithm>","+#include <cstdlib>"," #include <cstring>"," #include <memory>"," #include <string>","@@ -10,6 +11,7 @@"," #include \"absl/memory/memory.h\""," #include \"absl/strings/string_view.h\""," #include \"absl/synchronization/mutex.h\"","+#include \"grpc/grpc.h\""," #include \"grpcpp/channel.h\""," #include \"grpcpp/create_channel.h\""," #include \"grpcpp/security/credentials.h\"","@@ -29,16 +31,23 @@ constexpr int ExperimentalKeepAliveTimeoutMs = 10 * 1000;"," // 10 minutes"," constexpr int ExperimentalKeepAliveTimeMs = 10 * 60 * 1000;"," ","+std::vector<std::pair<std::string, int>> AltsChannelPool::channelArgs() {","+  std::vector<std::pair<std::string, int>> channel_args = {{GRPC_ARG_USE_LOCAL_SUBCHANNEL_POOL, 1}};","+  const char* keep_alive = std::getenv(UseGrpcExperimentalAltsHandshakerKeepaliveParams);","+  if (keep_alive != nullptr && std::strcmp(keep_alive, \"true\") == 0) {","+    channel_args.emplace_back(GRPC_ARG_KEEPALIVE_TIMEOUT_MS, ExperimentalKeepAliveTimeoutMs);","+    channel_args.emplace_back(GRPC_ARG_KEEPALIVE_TIME_MS, ExperimentalKeepAliveTimeMs);","+  }","+  return channel_args;","+}","+"," std::unique_ptr<AltsChannelPool>"," AltsChannelPool::create(absl::string_view handshaker_service_address) {","   std::vector<std::shared_ptr<grpc::Channel>> channel_pool;","   channel_pool.reserve(ChannelPoolSize);","   grpc::ChannelArguments channel_args;","-  channel_args.SetInt(GRPC_ARG_USE_LOCAL_SUBCHANNEL_POOL, 1);","-  const char* keep_alive = std::getenv(UseGrpcExperimentalAltsHandshakerKeepaliveParams);","-  if (keep_alive != nullptr && std::strcmp(keep_alive, \"true\") == 0) {","-    channel_args.SetInt(GRPC_ARG_KEEPALIVE_TIMEOUT_MS, ExperimentalKeepAliveTimeoutMs);","-    channel_args.SetInt(GRPC_ARG_KEEPALIVE_TIME_MS, ExperimentalKeepAliveTimeMs);","+  for (const auto& [key, value] : channelArgs()) {","+    channel_args.SetInt(key, value);","   }","   for (std::size_t i = 0; i < ChannelPoolSize; ++i) {","     channel_pool.push_back(grpc::CreateCustomChannel("],"additions":14,"deletions":5,"truncated":false},{"path":"source/extensions/transport_sockets/alts/alts_channel_pool.h","lines":["@@ -2,6 +2,8 @@"," "," #include <cstddef>"," #include <memory>","+#include <string>","+#include <utility>"," #include <vector>"," "," #include \"absl/strings/string_view.h\"","@@ -18,6 +20,10 @@ class AltsChannelPool {"," public:","   static std::unique_ptr<AltsChannelPool> create(absl::string_view handshaker_service_address);"," ","+  // Returns the arguments of every channel to the ALTS handshaker service. Also","+  // used for the channels of Envoy's async gRPC client to that service.","+  static std::vector<std::pair<std::string, int>> channelArgs();","+","   // Gets a channel to the ALTS handshaker service. The caller is responsible","   // for checking that the channel is non-null.","   std::shared_ptr<grpc::Channel> getChannel();"],"additions":6,"deletions":0,"truncated":false},{"path":"source/extensions/transport_sockets/alts/alts_proxy.cc","lines":["@@ -1,5 +1,6 @@"," #include \"source/extensions/transport_sockets/alts/alts_proxy.h\""," ","+#include <cstdint>"," #include <memory>"," #include <utility>"," ","@@ -25,9 +26,6 @@ using ::grpc::gcp::ServerHandshakeParameters;"," using ::grpc::gcp::StartClientHandshakeReq;"," using ::grpc::gcp::StartServerHandshakeReq;"," ","-// TODO(matthewstevenson88): Make this deadline configurable.","-constexpr absl::Duration AltsClientContextDeadline = absl::Seconds(30);","-"," void AltsProxy::setRpcProtocolVersions(grpc::gcp::RpcProtocolVersions* rpc_protocol_versions) {","   rpc_protocol_versions->mutable_max_rpc_version()->set_major(MaxMajorRpcVersion);","   rpc_protocol_versions->mutable_max_rpc_version()->set_minor(MaxMinorRpcVersion);","@@ -43,7 +41,6 @@ AltsProxy::create(std::shared_ptr<grpc::Channel> handshaker_service_channel,","   }","   auto client_context = std::make_unique<grpc::ClientContext>();","   client_context->set_deadline(absl::ToChronoTime(absl::Now() + AltsClientContextDeadline));","-  // TODO(matthewstevenson88): Investigate using Envoy's async gRPC client.","   auto stub = HandshakerService::NewStub(handshaker_service_channel);","   if (stub == nullptr) {","     return absl::InvalidArgumentError(\"Handshaker service stub is null.\");","@@ -70,7 +67,7 @@ AltsProxy::~AltsProxy() {","   }"," }"," ","-absl::StatusOr<HandshakerResp> AltsProxy::sendStartClientHandshakeReq() {","+HandshakerReq AltsProxy::makeStartClientHandshakeReq(absl::string_view target_name) {","   // Prepare the StartClientHandshakeReq message. Ignore the target name field,","   // it should never be populated for Envoy's use of ALTS.","   HandshakerReq request;","@@ -80,9 +77,44 @@ absl::StatusOr<HandshakerResp> AltsProxy::sendStartClientHandshakeReq() {","   client_start->add_record_protocols(RecordProtocol);","   setRpcProtocolVersions(client_start->mutable_rpc_versions());","   client_start->set_max_frame_size(MaxFrameSize);","-  if (!target_name_.empty()) {","-    client_start->set_target_name(target_name_);","+  if (!target_name.empty()) {","+    client_start->set_target_name(target_name);","+  }","+  return request;","+}","+","+HandshakerReq AltsProxy::makeStartServerHandshakeReq(absl::Span<const uint8_t> in_bytes) {","+  // Prepare the StartServerHandshakeReq message.","+  ServerHandshakeParameters server_parameters;","+  server_parameters.add_