: string, includedOutpu"," \tconst includedFiles = new Set(splitNulSeparated(includedOutput));"," \tconst wholeDirectories = new Set(splitNulSeparated(directoryOutput).filter(entry => entry.endsWith('/')));"," \tconst worktreeFiles = new Set(splitNulSeparated(worktreeOutput));","+\tconst excludedDirectories = new Set(excludedFolders.map(folder => folder.endsWith('/') ? folder : `${folder}/`));"," "," \t// Every ancestor directory of a tracked path, with the trailing `/` used"," \t// by `git ls-files --directory`, so a source path can be checked against","@@ -56,7 +58,7 @@ export function resolveWorktreeIncludePaths(ignoredOutput: string, includedOutpu"," \tconst matchedFiles: string[] = [];"," \tconst nonCollapsibleDirectories = new Set<string>();"," \tfor (const file of ignoredFiles) {","-\t\tif (includedFiles.has(file) && !hasWorktreePathCollision(file, worktreeFiles, worktreeDirectories)) {","+\t\tif (includedFiles.has(file) && findContainingDirectory(file, excludedDirectories) === undefined && !hasWorktreePathCollision(file, worktreeFiles, worktreeDirectories)) {"," \t\t\tmatchedFiles.push(file);"," \t\t} else if (wholeDirectories.size > 0) {"," \t\t\tconst containingDirectory = findContainingDirectory(file, wholeDirectories);"],"additions":4,"deletions":2,"truncated":false},{"path":"extensions/git/src/worktreeSymlink.ts","lines":["@@ -0,0 +1,128 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import * as fsPromises from 'fs/promises';","+import * as path from 'path';","+import { isDescendant } from './util';","+","+export type WorktreeSymlinkStatus = 'created' | 'sourceContainsWorktree' | 'targetExists';","+","+/**","+ * Returns the ancestor