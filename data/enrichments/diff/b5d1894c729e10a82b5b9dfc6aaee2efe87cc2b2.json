 catch (err) {","+\t\t\tthis.logger.warn(`[Repository][_symlinkWorktreeFolders] Failed to symlink folders to worktree: ${err}`);","+\t\t\treturn [];","+\t\t}","+\t}","+","+\tprivate async _getWorktreeSymlinkFolders(): Promise<string[]> {","+\t\tconst config = workspace.getConfiguration('git', Uri.file(this.root));","+\t\tconst worktreeSymlinkFolders = config.get<string[]>('worktreeSymlinkFolders', []);","+","+\t\tconst patterns = sanitizeWorktreeIncludePatterns(worktreeSymlinkFolders);","+\t\tif (patterns.length !== worktreeSymlinkFolders.length) {","+\t\t\tthis.logger.warn(`[Repository][_getWorktreeSymlinkFolders] Ignoring ${worktreeSymlinkFolders.length - patterns.length} pattern(s) containing line breaks.`);","+\t\t}","+\t\tif (patterns.length === 0) {","+\t\t\treturn [];","+\t\t}","+","+\t\tconst tempDir = await fsPromises.mkdtemp(path.join(os.tmpdir(), 'vscode-git-worktree-symlink-'));","+\t\tconst patternsFile = path.join(tempDir, 'patterns');","+","+\t\ttry {","+\t\t\tawait fsPromises.writeFile(patternsFile, patterns.join('\\n') + '\\n', 'utf8');","+","+\t\t\tconst tryExec = async (cwd: string, args: string[], input?: string, allowNoMatches = false): Promise<string | undefined> => {","+\t\t\t\ttry {","+\t\t\t\t\treturn (await this.repository.git.exec(cwd, args, { input })).stdout;","+\t\t\t\t} catch (err) {","+\t\t\t\t\tif (allowNoMatches && err instanceof GitError && err.exitCode === 1) {","+\t\t\t\t\t\treturn '';","+\t\t\t\t\t}","+\t\t\t\t\tthis.logger.warn(`[Repository][_getWorktreeSymlinkFolders] Failed to execute 'git ${args.join(' ')}': ${err}`);","+\t\t\t\t\treturn undefined;","+\t\t\t\t}","+\t\t\t};","+","+\t\t\tconst baseArgs = ['ls-files', '--others', '--ignored', '-z'];","+\t\t\tconst [ignoredOutput, matchedOutput, directoryOutput] = await Promise.all([","+\t\t\t\ttryExec(this.root, [...baseArgs, '--exclude-standard']),","+\t\t\t\ttryExec(this.root, [...baseArgs, `--exclude-from=${patternsFile}`]),","+\t\t\t\ttryExec(this.root, [...baseArgs, '--exclude-standard', '--directory'])","+\t\t\t]);","+\t\t\tif (ignoredOutput === undefined || matchedOutput === undefined || directoryOutput === undefined) {","+\t\t\t\treturn [];","+\t\t\t}","+","+\t\t\tconst candidates = getWorktreeSymlinkFolderCandidates(ignoredOutput, matchedOutput);","+\t\t\tif (candidates.length === 0) {","+\t\t\t\treturn [];","+\t\t\t}","+","+\t\t\tconst matcherRoot = path.join(tempDir, 'matcher');","+\t\t\tawait fsPromises.mkdir(matcherRoot);","+\t\t\tif (await tryExec(matcherRoot, ['init', '--quiet']) === undefined) {","+\t\t\t\treturn [];","+\t\t\t}","+","+\t\t\tconst candidateInput = candidates.map(candidate => `${candidate}/`).join('\\0');","+\t\t\tconst [ignoredDirectoriesOutput, matchedDirectoriesOutput] = await Promise.all([","+\t\t\t\ttryExec(this.root, ['check-ignore', '--no-index', '-z', '--stdin'], candidateInput, true),","+\t\t\t\ttryExec(matcherRoot, ['-c', `core.excludesFile=${patternsFile}`, 'check-ignore', '--no-index', '-z', '--stdin'], candidateInput, true)","+\t\t\t]);","+\t\t\tif (ignoredDirectoriesOutput === undefined || matchedDirectoriesOutput === undefined) {","+\t\t\t\treturn [];","+\t\t\t}","+","+\t\t\treturn filterWorktreeSymlinkFolders(candidates, ignoredDirectoriesOutput, matchedDirectoriesOutput, directoryOutput);","+\t\t} finally {","+\t\t\ttry {","+\t\t\t\tawait fsPromises.rm(tempDir, { recursive: true, force: true });","+\t\t\t} catch {","+\t\t\t\t// best-effort","+\t\t\t}","+\t\t}","+\t}","+"," \tprivate async _runWorktreeCreatedTasks(worktreePath: string): Promise<void> {"," \t\ttry {"," \t\t\tconst allTasks = await tasks.fetchTasks();","@@ -2025,7 +2149,7 @@ export class Repository implements Disposable {"," \t * `git.worktreeIncludeFiles` patterns are matched by git using"," \t * `.gitignore` semantics."," \t */","-\tprivate async _getWorktreeIncludePaths(worktreePath: string): Promise<string[]> {","+\tprivate async _getWorktreeIncludePaths(worktreePath: string, excludedFolders: readonly string[]): Promise<str