le\" });","+\t\t\treturn true;","+\t\t} catch (_err2) {","+\t\t\t// Neither: both minifiers are held to refusing it alike.","+\t\t\treturn false;","+\t\t}","+\t}","+};","+","+/**","+ * One of swc's minifier tests, as swc's own harness reads it: the compress","+ * options of the nearest `config.json` up the tree, and a `mangle.json` beside","+ * the input. A source that parses only as a module is read as one.","+ * @param {string} file the input","+ * @param {CaseReader} reader terser's own modules, unpatched","+ * @returns {Source[]} the test as one source","+ */","+const readSwcTest = (file, { knows }) => {","+\tif (!knows) {","+\t\tthrow new Error(","+\t\t\t\"swc's tests are read with terser's own options, from test/external/terser, which is not checked out\"","+\t\t);","+\t}","+\tconst input = fs.readFileSync(file, \"utf8\");","+\t/**","+\t * @param {string} at a file","+\t * @returns {EXPECTED_ANY} its JSON, or undefined where there is none","+\t */","+\tconst readJson = (at) =>","+\t\tfs.existsSync(at) ? JSON.parse(fs.readFileSync(at, \"utf8\")) : undefined;","+\tlet dir = path.dirname(file);","+\twhile (dir.startsWith(swcTestsDir) && !fs.existsSync(path.join(dir, \"config.json\"))) {","+\t\tdir = path.dirname(dir);","+\t}","+\t// swc reads a config that leaves `defaults` unnamed as naming it true, where","+\t// terser's own tests leave it off; read as terser's, most passes never run.","+\tconst compress = dir.startsWith(swcTestsDir)","+\t\t? { defaults: true, ...readJson(path.join(dir, \"config.json\")) }","+\t\t: undefined;","+\treturn [","+\t\t{","+\t\t\tname: path.relative(swcTestsDir, file),","+\t\t\tinput,","+\t\t\tmodule: readsAsModule(input),","+\t\t\town: compress && {","+\t\t\t\tcompress: knownTo(compress, \"compress\", knows),","+\t\t\t\tmangle: knownTo(","+\t\t\t\t\treadJson(path.join(path.dirname(file), \"mangle.json\")),","+\t\t\t\t\t\"mangle\",","+\t\t\t\t\tknows","+\t\t\t\t),","+\t\t\t\tformat: undefined,","+\t\t\t\tparse: undefined","+\t\t\t}","+\t\t}","+\t];","+};","+","+/**","+ * A Rust string literal starting at `at`, read as Rust reads it: `r#\"…\"#` raw,","+ * or `\"…\"` with its escapes.","+ * @param {string} text the source","+ * @param {number} at where a literal may start","+ * @returns {{ value: string, end: number } | undefined} the string, and where it ends","+ */","+const readRustString = (text, at) => {","+\tconst raw = /^r(#*)\"/.exec(text.slice(at, at + 16));","+\tif (raw) {","+\t\tconst close = `\"${raw[1]}`;","+\t\tconst start = at + raw[0].length;","+\t\tconst end = text.indexOf(close, start);","+\t\treturn { value: text.slice(start, end), end: end + close.length };","+\t}","+\tif (text[at] !== '\"') return undefined;","+\t/** @type {Record<string, string>} */","+\tconst escaped = { n: \"\\n\", r: \"\\r\", t: \"\\t\", 0: \"\\0\", \"\\\\\": \"\\\\\", '\"': '\"', \"'\": \"'\" };","+\tlet value = \"\";","+\tlet i = at + 1;","+\tfor (; text[i] !== '\"'; i++) {","+\t\tif (text[i] !== \"\\\\\") {","+\t\t\tvalue += text[i];","+\t\t\tcontinue;","+\t\t}","+\t\tconst next = text[++i];","+\t\tif (next === \"u\") {","+\t\t\tconst close = text.indexOf(\"}\", i);","+\t\t\tvalue += String.fromCodePoint(Number.parseInt(text.slice(i + 2, close), 16));","+\t\t\ti = close;","+\t\t} else if (next === \"x\") {","+\t\t\tvalue += String.fromCharCode(Number.parseInt(text.slice(i + 1, i + 3), 16));","+\t\t\ti += 2;","+\t\t} else if (next === \"\\n\") {","+\t\t\t// A line continuation, which drops the break and the indent after it.","+\t\t\twhile (/\\s/.test(text[i + 1])) i++;","+\t\t} else {","+\t\t\tvalue += escaped[next];","+\t\t}","+\t}","+\treturn { value, end: i + 1 };","+};","+","+// The mangle options swc's exec tests run with, by the helper each calls.","+const SWC_EXEC_MANGLE = { keep_fnames: true, toplevel: true };","+","+/**","+ * The tests swc writes inline in `exec.rs`, as the helper each calls runs them:","+ * its source, and a config read with `defaults` on where it leaves it unnamed.","+ * @param {string} file `exec.rs`","+ * @param {CaseReader} reader terser's own modules, unpatched","+ * @returns {Source[]} one source per test","+ */","+const readSwcExecTests = (file, { knows }) => {","+\tconst text = fs.readFileSync(file, \"utf8\");","+\t/** @type {Source[]} */","+\tconst sources = [];","+\tfor (const test of text.split(\"#[test]\").slice(1)) {","+\t\tconst name = /** @type {RegExpExecArray} */ (/fn\\s+(\\w+)/.exec(test))[1];","+\t\tconst call =","+\t\t\t/\\b(run_exec_test|run_default_exec_test|run_mangle_props_exec_test)\\(/.exec(","+\t\t\t\ttest","+\t\t\t);","+\t\t// A test with a harness of its own, which reads no one source.","+\t\tif (!call) continue;","+\t\t/** @type {Map<string, string>} */","+\t\tconst bound = new Map();","+\t\tfor (const binding of test.matchAll(/let\\s+(\\w+)\\s*=\\s*/g)) {","+\t\t\tconst literal = readRustString(","+\t\t\t\ttest,","+\t\t\t\t/** @type {number} */ (binding.index) + binding[0].length","+\t\t\t);","+\t\t\tif (literal) bound.set(binding[1], literal.value);","+\t\t}","+\t\t/** @type {(string | boolean | undefined)[]} */","+\t\tconst args = [];","+\t\tlet i = call.index + call[0].length;","+\t\tfor (;;) {","+\t\t\twhile (/[\\s,]/.test(test[i])) i++;","+\t\t\tif (test[i] === \")\") break;","+\t\t\tconst literal = readRustString(test, i);","+\t\t\tif (literal) {","+\t\t\t\targs.push(literal.value);","+\t\t\t\ti = literal.end;","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tconst word = /^\\w+/.exec(test.slice(i));","+\t\t\tif (!word) throw new Error(`Unread argument to ${call[1]} in ${name}`);","+\t\t\targs.push(","+\t\t\t\tword[0] === \"true\" ? true : word[0] === \"false\" ? false : bound.get(word[0])","+\t\t\t);","+\t\t\ti += word[0].length;","+\t\t}","+\t\tconst [input, config, skipMangle] = args;","+\t\tif (typeof input !== \"string\") {","+\t\t\tthrow new Error(`Unread source for ${call[1]} in ${name}`);","+\t\t}","+\t\t/** @type {EXPECTED_ANY} */","+\t\tlet compress = { defaults: true, toplevel: true };","+\t\t/** @type {EXPECTED_ANY} */","+\t\tlet mangle = SWC_EXEC_MANGLE;","+\t\tif (call[1] === \"run_exec_test\") {","+\t\t\tcompress = { defaults: true, ...JSON.parse(/** @type {string} */ (config)) };","+\t\t\tmangle = skipMangle ? false : SWC_EXEC_MANGLE;","+\t\t} else if (call[1] === \"run_mangle_props_exec_test\") {","+\t\t\tcompress = false;","+\t\t\tmangle = { toplevel: true, properties: {} };","+\t\t}","+\t\tsources.push({","+\t\t\tname,","+\t\t\tinput,","+\t\t\tmodule: readsAsModule(input),","+\t\t\town: {","+\t\t\t\tcompress: knownTo(compress, \"compress\", knows),","+\t\t\t\tmangle: knownTo(mangle, \"mangle\", knows),","+\t\t\t\tformat: undefined,","+\t\t\t\tparse: undefined","+\t\t\t}","+\t\t});","+\t}","+\treturn sources;","+};","+","+/**","+ * The tests swc writes inline in `mangle.rs`: each source, and the options its","+ * `MangleOptions` literal names. Rust spells three of terser's options its own","+ * way, `top_level`, `props` and `atom!` names, so those are read by name; a","+ * field terser does not read is cut as any other test's is.","+ * @param {string} file `mangle.rs`","+ * @param {CaseReader} reader terser's own modules, unpatched","+ * @returns {Source[]} one source per test","+ */","+const readSwcMangleTests = (file, { knows }) => {","+\tconst text = fs.readFileSync(file, \"utf8\");","+\t/**","+\t * @param {string} list a `vec![atom!(\"…\"), …]`","+\t * @returns {string[]} the names in it","+\t */","+\tconst atoms = (list) => [...list.matchAll(/atom!\\(\"([^\"]*)\"\\)/g)].map((m) => m[1]);","+\t/** @type {Source[]} */","+\tconst sources = [];","+\tfor (const test of text.split(\"#[test]\").slice(1)) {","+\t\tconst name = /** @type {RegExpExecArray} */ (/fn\\s+(\\w+)/.exec(test))[1];","+\t\tconst binding = /let\\s+src\\s*=\\s*/.exec(test);","+\t\tconst at = test.indexOf(\"MangleOptions {\");","+\t\tif (!binding || at === -1) continue;","+\t\tconst literal = readRustString(","+\t\t\ttest,","+\t\t\t/** @type {number} */ (binding.index) + binding[0].length","+\t\t);","+\t\tif (!literal) throw new Error(`Unread source in ${name}`);","+\t\tconst struct = test.slice(at);","+\t\tconst props = /props:\\s*Some\\(ManglePropertiesOptions\\s*\\{([\\s\\S]*?)\\}\\)/.exec(","+\t\t\tstruct","+\t\t);","+\t\tconst outside = props ? struct.replace(props[0], \"\") : struct;","+\t\t/** @type {Record<string, EXPECTED_ANY>} */","+\t\tconst mangle = {};","+\t\tconst topLevel = /top_level:\\s*Some\\((true|false)\\)/.exec(outside);","+\t\tif (topLevel) mangle.toplevel = topLevel[1] === \"true\";","+\t\tconst reserved = /reserved:\\s*(vec!\\[[^\\]]*\\])/.exec(outside);","+\t\tif (reserved) mangle.reserved = atoms(reserved[1]);","+\t\tfor (const field of outside.matchAll(/(\\w+):\\s*(true|false)\\b/g)) {","+\t\t\tmangle[field[1]] = field[2] === \"true\";","+\t\t}","+\t\tif (props) {","+\t\t\tconst kept = /reserved:\\s*(vec!\\[[^\\]]*\\])/.exec(props[1]);","+\t\t\tmangle.properties = kept ? { reserved: atoms(kept[1]) } : {};","+\t\t}","+\t\t// A field read by none of the above is an option this would drop unseen.","+\t\tconst read = new Set([\"top_level\", \"reserved\", ...Object.keys(mangle)]);","+\t\tfor (const [scope, fields] of [","+\t\t\t[\"MangleOptions\", outside.slice(0, outside.indexOf(\"..Default::default()\"))],","+\t\t\t[\"ManglePropertiesOptions\", props ? props[1] : \"\"]","+\t\t]) {","+\t\t\tfor (const field of fields","+\t\t\t\t.replace(/\\.\\.Default::default\\(\\)/g, \"\")","+\t\t\t\t.matchAll(/(\\w+):/g)) {","+\t\t\t\tif (!read.has(field[1])) {","+\t\t\t\t\tthrow new Error(`Unread ${scope} field ${field[1]} in ${name}`);","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tsources.push({","+\t\t\tname,","+\t\t\tinput: literal.value,","+\t\t\tmodule: readsAsModule(literal.value),","+\t\t\town: {","+\t\t\t\tcompress: false,","+\t\t\t\tmangle: knownTo(mangle, \"mangle\", knows),","+\t\t\t\tformat: undefined,","+\t\t\t\tparse: undefined","+\t\t\t}","+\t\t});","+\t}","+\treturn sources;","+};","+"," /**","  * @param {string} directory a cor