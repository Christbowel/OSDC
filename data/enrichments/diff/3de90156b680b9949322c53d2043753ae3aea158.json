, LoadWorkspaceYamlError> {","+        Self::find_and_read(start_dir, false)","+    }","+","+    /// [`Self::find_and_load`], with [`Self::read_at`]'s `skip_unreadable`.","+    pub(crate) fn find_and_read(","+        start_dir: &Path,","+        skip_unreadable: bool,","     ) -> Result<Option<(PathBuf, Self)>, LoadWorkspaceYamlError> {","         for dir in start_dir.ancestors() {","-            if let Some(settings) = Self::load_at(dir)? {","+            if let Some(settings) = Self::read_at(dir, skip_unreadable)? {","                 return Ok(Some((dir.join(WORKSPACE_MANIFEST_FILENAME), settings)));","             }","         }"],"additions":35,"deletions":10,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests.rs","lines":["@@ -91,3 +91,5 @@ mod registry_network_concurrency;"," mod publish_wait_timeout;"," "," mod env_placeholders;","+","+mod readable_settings;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/readable_settings.rs","lines":["@@ -0,0 +1,106 @@","+use super::{EnvVar, PmOnFail, WORKSPACE_MANIFEST_FILENAME, WorkspaceSettings, assert_eq, fs};","+use crate::workspace_yaml::{parse_settings, read_readable_settings};","+use pnpm_env_replace::SystemEnv;","+","+struct Env;","+","+impl EnvVar for Env {","+    fn var(name: &str) -> Option<String> {","+        (name == \"PNPM_TEST_LINKER\").then(|| \"not-a-linker\".to_owned())","+    }","+}","+","+fn read<Sys: EnvVar>(text: &str) -> Result<WorkspaceSettings, Box<serde_saphyr::Error>> {","+    read_readable_settings(text, parse_settings::<Sys>)"],"additions":14,"deletions":0,"truncated":false}],"additions":402,"deletions":103,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-08T16:16:27.994065+00:00"}