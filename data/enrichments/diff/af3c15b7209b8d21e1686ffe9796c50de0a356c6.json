-717,6 +717,40 @@ public void testWildcardInPassThroughViewBodyBesideIndexDoesNotMatchDatasets() {","         }","     }"," ","+    /**","+     * A view's own {@code SET wildcards_match_datasets} opens wildcards in that definition only. It does not leak into","+     * a nested view, and a nested view that SETs the flag does not need the enclosing view to.","+     */","+    public void testWildcardMatchDatasetsSetInsideViewAppliesToThatBodyOnly() {","+        registerEmployees();","+        registerEmployeesAlt();","+        createView(\"emp_star_on\", \"\"\"","+            SET wildcards_match_datasets = true;","+            FROM employees*","+            \"\"\");","+        try (var response = run(syncEsqlQueryRequest(\"FROM emp_star_on | KEEP emp_no | SORT emp_no\"))) {","+            assertThat(getValuesList(response), equalTo(List.of(List.of(1), List.of(2), List.of(3), List.of(10), List.of(11))));","+        }","+","+        createView(\"inner_plain\", \"FROM employees*\");","+        createView(\"outer_on\", \"\"\"","+            SET wildcards_match_datasets = true;","+            FROM inner_plain","+            \"\"\");","+        try (var response = run(syncEsqlQueryRequest(\"FROM outer_on | STATS c = COUNT(*)\"))) {","+            assertThat(getValuesList(response), equalTo(List.of(List.of(0L))));","+        }","+","+        createView(\"inner_on\", \"\"\"","+            SET wildcards_match_datasets = true;","+            FROM employees*","+            \"\"\");","+        createView(\"outer_plain\", \"FROM inner_on\");","+        try (var response = run(syncEsqlQueryRequest(\"FROM outer_plain | KEEP emp_no | SORT emp_no\"))) {","+            assertThat(getValuesList(response), equalTo(List.of(List.of(1), List.of(2), List.of(3), List.of(10), List.of(11))));","+        }","+    }","+","     public void testWildcardInNestedViewBodyDoesNotMatchDatasets() {","         registerEmployees();","         registerEmployeesAlt();"],"additions":34,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/ViewIT.java","lines":["@@ -109,11 +109,26 @@ public void testInvalidSyntaxQueryIsRejected() {","     public void testSetIsRejected() {","         expectThrows(","             ElasticsearchException.class,","-            containsString(\"SET statements are not allowed in views\"),","+            containsString(\"SET [time_zone] is not allowed in views\"),","             () -> createView(\"my_view\", \"SET time_zone=\\\"Europe/Berlin\\\"; FROM index\")","         );","     }"," ","+    public void testBoundaryScopedSettingsAreAccepted() {","+        assertAcked(createView(\"load_view\", \"SET unmapped_fields=\\\"load\\\"; FROM index\"));","+        assertAcked(createView(\"null_view\", \"SET unmapped_fields=\\\"nullify\\\"; FROM index\"));","+        assertAcked(createView(\"views_view\", \"SET wildcards_match_views=true; FROM index\"));","+        assertAcked(createView(\"datasets_view\", \"SET wildcards_match_datasets=false; FROM index\"));","+    }","+","+    public void testLoadAllInsideViewIsRejected() {","+        expectThrows(","+            ElasticsearchException.class,","+            containsString(\"SET unmapped_fields=\\\"LOAD_ALL\\\" is not supported in views\"),","+            () -> createView(\"my_view\", \"SET unmapped_fields=\\\"LOAD_ALL\\\"; FROM index\")","+        );","+    }","+","     public void testTsWithoutStatsIsRejected() {","         expectThrows(","             IllegalArgumentException.class,"],"additions":16,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/ViewSettingsIT.java","lines":["@@ -7,18 +7,29 @@"," "," package org.elasticsearch.xpack.esql.action;"," ","+import org.elasticsearch.ResourceNotFoundException;","+import org.elasticsearch.action.ActionListener;"," import org.elasticsearch.action.support.WriteRequest;"," import org.elasticsearch.action.support.master.AcknowledgedResponse;"," import org.elasticsearch.cluster.metadata.View;","+import org.elasticsearch.common.logging.HeaderWarning;","+import org.elasticsearch.transport.TransportService;"," import org.elasticsearch.xpack.esql.VerificationException;","+import org.elasticsearch.xpack.esql.view.DeleteViewAction;"," import org.elasticsearch.xpack.esql.view.PutViewAction;","+import org.junit.After;"," "," import java.util.Arrays;","+import java.util.LinkedHashSet;"," import java.util.List;","+import java.util.Set;","+import java.util.concurrent.CopyOnWriteArrayList;","+import java.util.concurrent.CountDownLatch;"," import java.util.concurrent.TimeUnit;"," "," import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;"," import static org.elasticsearch.xpack.esql.EsqlTestUtils.getValuesList;","+import static org.elasticsearch.xpack.esql.action.EsqlQueryRequest.syncEsqlQueryRequest;"," import static org.hamcrest.Matchers.containsString;"," import static org.hamcrest.Matchers.equalTo;"," import static org.hamcrest.Matchers.hasItem;","@@ -28,10 +39,14 @@","  * The caller's query settings stop at view boundaries: a view must produce the same rows","  * whatever the caller SET — a materialized view would have baked its contents in. Covers {@code unmapped_fields}","  * (not reaching inside view bodies, null-filling at the view output instead) and {@code wildcards_match_views}","- * (a wildcard inside a view body never matches views). See also {@code SETTINGS_SCOPED_AT_VIEW_BOUNDARIES}.","+ * (a wildcard inside a view body never matches views). A view definition may {@code SET} those same settings for","+ * its own body; that {@code SET} does not leak into a nested view. Dataset wildcards are covered in","+ * {@link FromDatasetViewIT}. See {@code SETTINGS_SCOPED_AT_VIEW_BOUNDARIES} and {@code SET_IN_VIEW_DEFINITIONS}.","  */"," public class ViewSettingsIT extends AbstractEsqlIntegTestCase {"," ","+    private final Set<String> createdViews = new LinkedHashSet<>();","+","     /**","      * Two indices with dynamic mapping off, so {@code extra} is present in {@code _source} but unmapped:","      * {@code view_source} (ids 1-2) backs the views, {@code caller_idx} (id 3) is the caller's own pattern.","@@ -445,10 +460,317 @@ public void testClusterDefaultOfWildcardsMatchViewsDoesNotReachViewBody() {","         }","     }"," ","+    /**","+     * A cluster default of {@code unmapped_fields=nullify} applies to a query run on its own. The same text stored as a","+     * view does not pick it up: a definition that does not {@code SET} the mode keeps the registry default, so the","+     * view does not change if the cluster default later changes.","+     */","+    public void testClusterDefaultOfUnmappedFieldsDoesNotReachViewBody() {","+        setupUnmappedIndices();","+        assertAcked(createView(\"plain_view\", \"FROM view_source | KEEP id, extra\"));","+        String key = \"esql.query.settings.unmapped_fields\";","+        updateClusterSettings(org.elasticsearch.common.settings.Settings.builder().put(key, \"nullify\"));","+        try {","+            try (var resp = run(\"FROM view_source | KEEP id, extra | SORT id\")) {","+                assertThat(getValuesList(resp), equalTo(List.of(Arrays.asList(1, null), Arrays.asList(2, null))));","+            }","+            expectThrows(VerificationException.class, containsString(\"Unknown column [extra]\"), () -> run(\"FROM plain_view\").close());","+        } finally {","+            updateClusterSettings(org.elasticsearch.common.settings.Settings.builder().putNull(key));","+        }","+    }","+","+    public void testLoadSetInsideViewLoadsFullyUnmappedField() {","+        setupUnmappedIndices();","+        assertAcked(createView(\"load_view\", \"\"\"","+            SET unmapped_fields=\"load\";","+            FROM view_source | KEEP id, extra","+            \"\"\"));","+        // The caller set nothing. The view's own SET loads extra from view_source.","+        try (var resp = run(\"FROM load_view | SORT id\")) {","+            assertThat(getValuesList(resp), equalTo(List.of(List.of(1, \"e1\"), List.of(2, \"e2\"))));","+        }","+        // The caller's nullify does not override the definition.","+        try (var resp = run(\"\"\"","+            SET unmapped_fields=\"nullify\";","+            FROM load_view | SORT id","+            \"\"\")) {","+            assertThat(getValuesList(resp), equalTo(List.of(List.of(1, \"e1\"), List.of(2, \"e2\"))));","+        }","+    }","+","+    public void testNullifySetInsideViewNullFillsAndIgnoresCallerLoad() {","+        setupUnmappedIndices();","+        assertAcked(createView(\"null_view\", \"\"\"","+            SET unmapped_fields=\"nullify\";","+            FROM view_source | KEEP id, extra","+            \"\"\"));","+        // The view's nullify applies on its own, with no caller SET to keep its view branch.","+        try (var resp = run(\"FROM null_view | SORT id\")) {","+            assertThat(getValuesList(resp), equalTo(List.of(Arrays.asList(1, null), Arrays.asList(2, null))));","+        }","+        try (var resp = run(\"\"\"","+            SET unmapped_fields=\"load\";","+            FROM null_view | SORT id","+            \"\"\")) {","+            assertThat(getValuesList(resp), equalTo(List.of(Arrays.asList(1, null), Arrays.asList(2, null))));","+        }","+    }","+","+    public void testLoadSetInsideViewDoesNotLeakIntoNestedView() {","+        setupUnmappedIndices();","+        assertAcked(createView(\"inner_plain\", \"FROM view_source | KEEP id, extra\"));","+        assertAcked(createView(\"outer_load\", \"\"\"","+            SET unmapped_fields=\"load\";","+            FROM inner_plain","+            \"\"\"));","+        // extra is referenced in inner_plain, which did not SET load. The enclosing SET must not reach it.","+        expectThrows(VerificationException.class, containsString(\"Unknown column [extra]\"), () -> run(\"FROM outer_load\").close());","+    }","+","+    public void testLoadSetInsideNestedViewAppliesWithoutEnclosingSet() {","+        setupUnmappedIndices();","+        assertAcked(createView(\"inner_load\", \"\"\"","+            SET unmapped_fields=\"load\";","+            FROM view_source | KEEP id, extra","+            \"\"\"));","+        assertAcked(createView(\"outer_plain\", \"FROM inner_load\"));","+        try (var resp = run(\"FROM outer_plain | SORT id\")) {","+            assertThat(getValuesList(resp), equalTo(List.of(List.of(1, \"e1\"), List.of(2, \"e2\"))));","+        }","+    }","+","+    /**","+     * {@code foo} is {@code double} in {@code mt_a}, {@code long} in {@code mt_b}, and present only in {@code _source} in","+     * {@code mt_c}. The view loads it, so {@code TO_DEGREES(foo)} is a type conflict even when the caller set nothing.","+     */","+    public void testLoadSetInsideViewReportsMixedTypeConflictWhenCallerUsesDefault() {","+        String dynamicOff = \"{\\\"dynamic\\\": false, \\\"properties\\\": {\\\"id\\\": {\\\"type\\\": \\\"integer\\\"}}}\";","+        assertAcked(indicesAdmin().prepareCreate(\"mt_a\").setMapping(\"\"\"","+            {\"dynamic\": false, \"properties\": {\"id\": {\"type\": \"integer\"}, \"foo\": {\"type\": \"double\"}}}","+            \"\"\"));","+        assertAcked(indicesAdmin().prepareCreate(\"mt_b\").setMapping(\"\"\"","+            {\"dynamic\": false, \"properties\": {\"id\": {\"type\": \"integer\"}, \"foo\": {\"type\": \"long\"}}}","+            \"\"\"));","+        assertAcked(indicesAdmin().prepareCreate(\"mt_c\").setMapping(dynamicOff));","+        prepareIndex(\"mt_a\").setSource(\"id\", 1, \"foo\", 1.5).setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE).get();","+        prepareIndex(\"mt_b\").setSource(\"id\", 2, \"foo\", 2).setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE).get();","+        prepareIndex(\"mt_c\").setSource(\"id\", 3, \"foo\", \"3\").setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE).get();","+        assertAcked(createView(\"mt_view\", \"\"\"","+            SET unmapped_fields=\"load\";","+            FROM mt_a, mt_b, mt_c | EVAL x = TO_DEGREES(foo) | KEEP id, x","+            \"\"\"));","+        for (String query : List.of(","+            \"FROM mt_view\",","+            \"SET unmapped_fields=\\\"nullify\\\"; FROM mt_view\",","+            \"SET unmapped_fields=\\\"load\\\"; FROM mt_view\"","+        )) {","+            expectThrows(","+                VerificationException.class,","+                containsString(\"Cannot use field [foo] due to ambiguities\"),","+                () -> run(query).close()","+            );","+        }","+    }","+","+    /**","+     * Loading a subfield of a flattened field is rejected under {@code load}, and a view that SETs {@code load} must reject it","+     * the same way when the caller set nothing. {@code foo} is flattened in {@code flat_a}; {@code foo.bar} is a keyword in","+     * {@code flat_b}, so {@code foo} is type-conflicted over both; {@code flat_c} maps neither, so over {@code flat_a, flat_c}","+     * {@code foo} is flattened in only one index.","+     */","+    public void testLoadSetInsideViewRejectsFlattenedSubfield() {","+        assertAcked(indicesAdmin().prepareCreate(\"flat_a\").setMapping(\"\"\"","+            {\"dynamic\": false, \"properties\": {\"id\": {\"type\": \"integer\"}, \"foo\": {\"type\": \"flattened\"}}}","+            \"\"\"));","+        assertAcked(indicesAdmin().prepareCreate(\"flat_b\").setMapping(\"\"\"","+            {\"dynamic\": false, \"properties\": {\"id\": {\"type\": \"integer\"}, \"foo.bar\": {\"type\": \"keyword\"}}}","+            \"\"\"));","+        assertAcked(indicesAdmin().prepareCreate(\"flat_c\").setMapping(\"\"\"","+            {\"dynamic\": false, \"properties\": {\"id\": {\"type\": \"integer\"}}}","+            \"\"\"));","+        List<List<String>> cases = List.of(","+            List.of(\"FROM flat_a | KEEP foo.a\", \"Loading subfield [foo.a] when parent [foo]\"),","+            List.of(\"FROM flat_a, flat_b | WHERE foo.bar == \\\"x\\\"\", \"Loading subfield [foo.bar] when parent [foo]\"),","+            List.of(\"FROM flat_a, flat_c | KEEP foo.a\", \"Loading subfield [foo.a] when parent [foo]\")","+        );","+        for (int i = 0; i < cases.size(); i++) {","+            String body = cases.get(i).get(0);","+            String error = cases.get(i).get(1) + \" is of flattened field type is not supported with unmapped_fields=\\\"load\\\"\";","+            String viewName = \"flat_view_\" + i;","+            expectThrows(VerificationException.class, containsString(error), () -> run(\"SET unmapped_fields=\\\"load\\\"; \" + body).close());","+            assertAcked(createView(viewName, \"SET unmapped_fields=\\\"load\\\"; \" + body));","+            expectThrows(VerificationException.class, containsString(error), () -> run(\"FROM \" + viewName).close());","+        }","+    }","+","+    /**","+     * {@code t} is {@code text} in {@code tp_a} and only in {@code _source} in {@code tp_b}. Loading it nulls the unmapped","+     * value and warns. The warning follows the view's SET, not the caller's.","+     */","+    public void testLoadSetInsideViewWarnsAboutPartiallyUnmappedText() throws Exception {"],"additions":165,"deletions":1,"truncated":false}],"additions":319,"deletions":22,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-20T14:25:31.163241+00:00"}