{"id":"3b8ca28ec23bca26c4c2138b2bf09629cfffa5db","axis":"silent","repo":"vercel/next.js","sha":"3b8ca28ec23bca26c4c2138b2bf09629cfffa5db","parsed":{"files":[{"path":"crates/next-napi-bindings/src/next_api/endpoint.rs","lines":["@@ -300,8 +300,10 @@ async fn endpoint_client_changed_with_issues_operation(","     endpoint_op: OperationVc<OptionEndpoint>,"," ) -> Result<Vc<Completion>> {","     let changed_op = endpoint_client_changed_operation(endpoint_op);","-    let Err(err) = changed_op.connect().await else {","-        return Ok(changed_op.connect());","+    // Collectibles are only stable after a strongly consistent read of their source.","+    let err = match changed_op.resolve().strongly_consistent().await {","+        Ok(changed) => return Ok(*changed),","+        Err(err) => err,","     };","     let filter = issue_filter_from_endpoint(endpoint_op).await;","     let issues = get_issues(changed_op, &filter).await?;"],"additions":4,"deletions":2,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/benches/collectibles.rs","lines":["@@ -100,7 +100,8 @@ async fn emitting_operation(count: u32) -> Result<Vc<()>> {"," async fn collecting_operation(count: u32, take: bool, iteration: u32) -> Result<Vc<u32>> {","     let _ = iteration;","     let source = emitting_operation(count);","-    source.connect().await?;","+    // Collectibles are only stable after a strongly consistent read of their source.","+    source.read_strongly_consistent().await?;","     let collectibles = if take {","         source.take_collectibles::<Box<dyn ValueToString>>()","     } else {"],"additions":2,"deletions":1,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/src/backend/mod.rs","lines":["@@ -532,6 +532,31 @@ impl TurboTasksBackend {","         Some(get_aggregation_number(&task))","     }"," ","+    /// The number of collectibles with changes that `task` hasn't sent to its uppers yet, because","+    /// the task is dirty (see delayed collectible propagation in `