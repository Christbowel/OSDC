-editor.org/rfc/rfc9110.html).","+\t    \"accept\",              // Accepted media types and parameters.","+\t    \"accept-charset\",      // Accepted character sets.","+\t    \"accept-encoding\",     // Accepted content codings.","+\t    \"accept-language\",     // Preferred response languages.","+\t    \"connection\",          // Connection handling options.","+\t    \"content-encoding\",    // Applied content codings.","+\t    \"content-language\",    // Languages of the intended audience.","+\t    \"content-length\",      // Content size in bytes.","+\t    \"content-type\",        // Content media type and parameters.","+\t    \"date\",                // Message timestamp.","+\t    \"expect\",              // Expected server behavior before sending content.","+\t    \"if-modified-since\",   // Modification timestamp used for conditional requests.","+\t    \"if-unmodified-since\", // Modification timestamp used for conditional requests.","+\t    \"max-forwards\",        // Remaining forwarding limit.","+\t    \"range\",               // Requested ranges.","+\t    \"te\",                  // Accepted transfer codings and trailer support.","+\t    \"trailer\",             // Names of fields sent in trailers.","+\t    \"upgrade\",             // Proposed or selected protocols.","+\t    \"user-agent\",          // Client product and version information.","+\t    // \"via\",                 // Intermediary protocols, hosts and software comments.","+\t    // \"authorization\", // Contains credentials and signatures.","+\t    // \"content-location\", // URI can contain sensitive paths or query parameters.","+\t    // \"from\", // Contains the user's email address.","+\t    // \"host\", // Identifies the endpoint, including bucket or tenant names.","+\t    // \"if-match\", // Contains opaque resource validators.","+\t    // \"if-none-match\", // Contains opaque resource validators.","+\t    // \"if-range\", // Can contain an opaque resource validator instead of a date.",