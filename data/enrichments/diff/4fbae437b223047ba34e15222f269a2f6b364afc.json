cryption key.","+\t    // \"x-amz-version-id\", // Identifies an object version.","+\t};","+\treturn allow_list;","+}","+"," HTTPLogType::HTTPLogType() : LogType(NAME, LEVEL, GetLogType()) {"," }"," ","@@ -86,16 +210,56 @@ LogicalType HTTPLogType::GetLogType() {"," \treturn LogicalType::STRUCT(child_list);"," }"," ","-static Value CreateHTTPHeadersValue(const HTTPHeaders &headers) {","+static Value CreateHTTPHeadersValue(const HTTPHeaders &headers, const case_insensitive_set_t &allow_list,","+                                    bool redact_http_logs) {"," \tvector<Value> keys;"," \tvector<Value> values;"," \tfor (const auto &header : headers) {"," \t\tkeys.emplace_back(header.first);","-\t\tvalues.emplace_back(header.second);","+\t\tconst bool allow_value = !redact_http_logs || allow_list.find(header.first) != allow_list.end();","+\t\tvalues.emplace_back(allow_value ? header.second : HTTPLogType::REDACTED_VALUE);"," \t}"," \treturn Value::MAP(LogicalType::VARCHAR, LogicalType::VARCHAR, keys, values);"," }"," ","+static string BuildLogURL(const BaseRequest &request, bool redact_http_logs) {","+\tstring url;","+\turl.reserve(request.proto_host_port.size() + request.path.size());","+","+\tif (!redact_http_logs) {","+\t\turl.append(request.proto_host_port);","+\t\turl.append(request.path);","+\t\treturn url;","+\t}","+","+\t// Redact user info, e.g. https://user:pass@duckdb.org -> https://redacted@duckdb.org","+\tconst auto pos_at = request.proto_host_port.rfind('@');","+\tif (pos_at != string::npos) {","+\t\tauto pos_proto_end = request.proto_host_port.find(\"://\");","+\t\tif (pos_proto_end == string::npos) {","+\t\t\t// Without a scheme separator, redact from the start.","+\t\t\tpos_proto_end = 0;","+\t\t} else {","+\t\t\tpos_proto_end += 3;","+\t\t}","+\t\turl.append(request.proto_host_port, 0, pos_proto_end);","+\t\turl.append(HTTPLogType::REDACTED_VALUE);","+\t\turl.append(request.proto_host_port, pos_at, string::npos);","+\t} else {","+\t\turl += request.proto_host_port;","+\t}","+","+\t// Redact the query parameters or fragment","+\tconst auto pos_end_of_path = request.path.find_first_of(\"?#\");","+\tif (pos_end_of_path == string::npos) {","+\t\turl += request.path;","+\t} else {","+\t\turl.append(request.path, 0, pos_end_of_path + 1);","+\t\turl.append(HTTPLogType::REDACTED_VALUE);","+\t}","+\treturn url;","+}","+"," static string HTTPStatusToLogString(HTTPStatusCode status) {"," \ttry {"," \t\treturn EnumUtil::ToString(status);","@@ -104,11 +268,12 @@ static string HTTPStatusToLogString(HTTPStatusCode status) {"," \t}"," }"," ","-string HTTPLogType::ConstructLogMessage(BaseRequest &request, optional_ptr<HTTPResponse> response) {","+string HTTPLogType::ConstructLogMessage(BaseRequest &request, optional_ptr<HTTPResponse> response,","+                                        bool redact_http_logs) {"," \tchild_list_t<Value> request_child_list = {"," \t    {\"type\", Value(EnumUtil::ToString(request.type))},","-\t    {\"url\", Value(request.url)},","-\t    {\"headers\", CreateHTTPHeadersValue(request.headers)},","+\t    {\"url\", Value(BuildLogURL(request, redact_http_logs))},","+\t    {\"headers\", CreateHTTPHeadersValue(request.headers, HTTPRequestHeaderAllowList(), redact_http_logs)},"," \t    {\"start_time\", request.have_request_timing ? Value::TIMESTAMP(request.request_system_start) : Value()},"," \t    {\"duration_ms\","," \t     request.have_request_timing","@@ -121,7 +286,7 @@ string HTTPLogType::ConstructLogMessage(BaseRequest &request, optional_ptr<HTTPR"," \t\tchild_list_t<Value> response_child_list = {"," \t\t    {\"status\", Value(HTTPStatusToLogString(response->status))},"," \t\t    {\"reason\", Value(response->reason.empty() ? response->GetRequestError() : response->reason)},","-\t\t    {\"headers\", CreateHTTPHeadersValue(response->headers)},","+\t\t    {\"headers\", CreateHTTPHeadersValue(response->headers, HTTPResponseHeaderAllowList(), redact_http_logs)},"," \t\t};"," \t\tresponse_value = Value::STRUCT(response_child_list);"," \t}"],"additions":171,"deletions":6,"truncated":false},{"path":"src/main/config.cpp","lines":["@@ -237,6 +237,7 @@ static const ConfigurationOption internal_options[] = {","     DUCKDB_LOCAL(ProfilingRendererSettingsSetting),","     DUCKDB_LOCAL(ProgressBarTimeSetting),","     DUCKDB_SETTING_CALLBACK(ReadAheadDepthSetting),","+    DUCKDB_SETTING(RedactHttpLogsSetting),","     DUCKDB_SETTING_CALLBACK(RegexMatchOperatorSemanticsSetting),","     DUCKDB_SETTING(ScalarSubqueryErrorOnMultipleRowsSetting),","     DUCKDB_SETTING(SchedulerProcessPartialSetting),"],"additions":1,"deletions":0,"truncated":false},{"path":"src/main/http/http_util.cpp","lines":["@@ -18,6 +18,10 @@ namespace duckdb {"," HTTPParams::~HTTPParams() {"," }"," ","+bool HTTPParams::ShouldRedactLogs() const {","+\treturn !db || Settings::Get<RedactHttpLogsSetting>(*db);","+}","+"," idx_t HTTPParams::GetTransportReuseDomain() const {"," \treturn transport_reuse_domain;"," }","@@ -250,7 +254,7 @@ void HTTPUtil::LogRequest(BaseRequest &request, optional_ptr<HTTPResponse> respo"," \tif (!request.params.logger || !request.params.logger->ShouldLog(HTTPLogType::NAME, HTTPLogType::LEVEL)) {"," \t\treturn;"," \t}","-\tauto log_string = HTTPLogType::ConstructLogMessage(request, response);","+\tauto log_string = HTTPLogType::ConstructLogMessage(request, response, request.params.ShouldRedactLogs());"," \trequest.params.logger->WriteLog(HTTPLogType::NAME, HTTPLogType::LEVEL, log_string);"," }"," ","@@ -448,7 +452,7 @@ HTTPUtil::RunRequestWithRetry(const std::function<unique_ptr<HTTPResponse>(void)"," }"," "," void HTTPParams::Initialize(optional_ptr<FileOpener> opener) {","-\tauto db = FileOpener::TryGetDatabase(opener);","+\tdb = FileOpener::TryGetDatabase(opener);"," \tif (db) {"," \t\tauto &http_proxy_setting = db->config.options.http_proxy;"," \t\tif (!http_proxy_setting.empty()) {"],"additions":6,"deletions":2,"truncated":false},{"path":"test/api/test_reset.cpp","lines":["@@ -115,6 +115,7 @@ OptionValueSet GetValueForOption(const string &name, const LogicalType &type) {"," \t    {\"logging_mode\", {\"ENABLE_SELECTED\"}},"," \t    {\"logging_level\", {\"FATAL\"}},"," \t    {\"logging_storage\", {\"stdout\"}},","+\t    {\"redact_http_logs\", {false}},"," \t    {\"enable_progress_bar_print\", {false}},"," \t    {\"scalar_subquery_error_on_multiple_rows\", {false}},"," \t    {\"ieee_floating_point_ops\", {false}},"],"additions":1,"deletions":0,"truncated":false},{"path":"test/sql/logging/http_request_log_redaction.test","lines":["@@ -0,0 +1,96 @@","+# name: test/sql/logging/http_request_log_redaction.test","+# description: HTTP request logging redacts headers unless explicitly enabled","+# group: [logging]","+","+require httpfs","+","+require noforcestorage","+","+require skip_reload","+","+statement ok","+CALL enable_logging('HTTP', storage = 'memory');","+","+statement ok","+SET enable_external_file_cache = false;","+","+statement ok","+SET enable_http_metadata_cache = false;","+","+statement ok","+CREATE SECRET http_log_headers (","+    TYPE HTTP,","+    SCOPE 'https://raw.githubusercontent.com/duckdb/duckdb/v2.0-cyanoptera/data/csv/header.csv',","+    EXTRA_HTTP_HEADERS MAP {","+        'aUtHoRiZaTiOn': 'dummy-authorization',","+        'Cookie': 'dummy-cookie',","+        'x-amz-security-token': 'dummy-token',","+        'X-Custom': 'dummy-custom',","+        'ETag': 'dummy-etag',","+        'AcCePt': 'text/csv',","+        'AcCePt-EnCoDiNg': 'identity'","+    }","+);","+","+# HTTPFS supplies the secret headers, while core redacts their values in the HTTP logs.","+statement maybe","+FROM 'https://raw.githubusercontent.com/duckdb/duckdb/v2.0-cyanoptera/data/csv/header.csv';","+----","+","+query TT rowsort","+SELECT DISTINCT entry.key, entry.value","+FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(request.headers)) AS headers(entry)","+WHERE lower(entry.key) IN ('authorization', 'cookie', 'x-amz-security-token', 'x-custom', 'etag', 'accept', 'accept-encoding');","+----","+AcCePt\ttext/csv","+AcCePt-EnCoDiNg\tidentity","+Cookie\tredacted","+ETag\tredacted","+X-Custom\tredacted","+aUtHoRiZaTiOn\tredacted","+x-amz-security-token\tredacted","+","+statement ok","+SET redact_http_logs = false;","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+FROM 'https://raw.githubusercontent.com/duckdb/duckdb/v2.0-cyanoptera/data/csv/header.csv';","+----","+","+query TT rowsort","+SELECT DISTINCT entry.key, entry.value","+FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(request.headers)) AS headers(entry)","+WHERE lower(entry.key) IN ('authorization', 'cookie', 'x-amz-security-token', 'x-custom', 'etag', 'accept', 'accept-encoding');","+----","+AcCePt\ttext/csv","+AcCePt-EnCoDiNg\tidentity","+Cookie\tdummy-cookie","+ETag\tdummy-etag","+X-Custom\tdummy-custom","+aUtHoRiZaTiOn\tdummy-authorization","+x-amz-security-token\tdummy-token","+","+statement ok","+RESET redact_http_logs;","+","+query I","+SELECT current_setting('redact_http_logs');","+----","+true","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+FROM 'https://raw.githubusercontent.com/duckdb/duckdb/v2.0-cyanoptera/data/csv/header.csv';","+----","+","+query I","+SELECT count(*) > 0 AND bool_and(entry.value = 'redacted')","+FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(request.headers)) AS headers(entry)","+WHERE lower(entry.key) = 'authorization';","+----","+true"],"additions":96,"deletions":0,"truncated":false},{"path":"test/sql/logging/http_response_log_redaction.test","lines":["@@ -0,0 +1,72 @@","+# name: test/sql/logging/http_response_log_redaction.test","+# description: Core HTTP response logging redacts headers unless explicitly enabled","+# group: [logging]","+","+require noforcestorage","+","+require skip_reload","+","+statement ok","+SET extension_directory = '{TEST_DIR}/http_response_log_redaction';","+","+statement ok","+SET autoload_known_extensions = false;","+","+statement ok","+SET autoinstall_known_extensions = false;","+","+statement ok","+CALL enable_logging('HTTP', storage = 'memory');","+","+# INSTALL over HTTP uses core's built-in client without HTTPFS. GitHub redirects to HTTPS,","+# which this path does not follow, so installation fails without installing an extension.","+# The redirect still produces a response log with Location and allowed protocol headers.","+statement maybe","+INSTALL 'http://github.com/duckdb/duckdb';","+----","+","+query TI rowsort","+SELECT lower(entry.key), bool_and(CASE lower(entry.key)","+    WHEN 'location' THEN entry.value = 'redacted'","+    WHEN 'content-length' THEN TRY_CAST(entry.value AS BIGINT) >= 0","+END)","+FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(response.headers)) AS headers(entry)","+WHERE lower(entry.key) IN ('location', 'content-length')","+GROUP BY lower(entry.key);","+----","+content-length\ttrue","+location\ttrue","+","+statement ok","+SET redact_http_logs = false;","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+INSTALL 'http://github.com/duckdb/duckdb';","+----","+","+query I","+SELECT count(*) > 0 AND bool_and(entry.value = 'https://github.com/duckdb/duckdb')","+FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(response.headers)) AS headers(entry)","+WHERE lower(entry.key) = 'location';","+----","+true","+","+statement ok","+RESET redact_http_logs;","+","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+INSTALL 'http://github.com/duckdb/duckdb';","+----","+","+query I","+SELECT count(*) > 0 AND bool_and(entry.value = 'redacted')","+FROM duckdb_logs_parsed('HTTP'), UNNEST(map_entries(response.headers)) AS headers(entry)","+WHERE lower(entry.key) = 'location';","+----","+true"],"additions":72,"deletions":0,"truncated":false},{"path":"test/sql/logging/http_url_log_redaction.test","lines":["@@ -0,0 +1,158 @@","+# name: test/sql/logging/http_url_log_redaction.test","+# description: Core HTTP logging redacts URL query strings and fragments","+# group: [logging]","+","+require noforcestorage","+","+require skip_reload","+","+statement ok","+SET extension_directory = '{TEST_DIR}/http_url_log_redaction';","+","+statement ok","+SET autoload_known_extensions = false;","+","+statement ok","+SET autoinstall_known_extensions = false;","+","+statement ok","+CALL enable_logging('HTTP', storage = 'memory');","+","+# INSTALL over HTTP uses core's built-in client without HTTPFS. GitHub redirects to HTTPS","+# or rejects the request target. Redirects are not followed, so no extension is installed.","+foreach redact true false","+","+statement ok","+SET redact_http_logs = {redact};","+","+# URLs without sensitive components retain the host and path.","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+INSTALL 'http://github.com/duckdb/duckdb';","+----","+","+query I","+SELECT count(*) > 0 AND bool_and(request.url = 'http://github.com/duckdb/duckdb')","+FROM duckdb_logs_parsed('HTTP');","+----","+true","+","+# Redact the entire query, including unknown keys and values containing '@'.","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+INSTALL 'http://github.com/duckdb/duckdb?custom_token=dummy-token&email=dummy@example.com';","+----","+","+query I","+SELECT count(*) > 0 AND bool_and(request.url = CASE WHEN {redact}","+    THEN 'http://github.com/duckdb/duckdb?redacted'","+    ELSE 'http://github.com/duckdb/duckdb?custom_token=dummy-token&email=dummy@example.com'","+END)","+FROM duckdb_logs_parsed('HTTP');","+----","+true","+","+# Fragments in the supplied URL can contain credentials.","+statement ok","+CALL truncate_duckdb_logs();","+","+statement maybe","+INSTALL 'http://github.com/duckdb/duckdb#dummy-token';","+----","+","+query I","+SELECT count(*) > 0 AND bool_and(request.url = CASE WHEN {redact}","+    THEN 'http://github.com/duckdb/duckdb#redacted'","+    ELSE 'http://github.com/duckdb/duckdb#dummy-token'","+END)","+FROM duckdb_logs_parsed('HTTP');","+----","+true","+"