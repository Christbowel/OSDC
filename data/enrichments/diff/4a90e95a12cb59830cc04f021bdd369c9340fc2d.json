{"id":"4a90e95a12cb59830cc04f021bdd369c9340fc2d","axis":"silent","repo":"facebook/lexical","sha":"4a90e95a12cb59830cc04f021bdd369c9340fc2d","parsed":{"files":[{"path":".github/workflows/call-e2e-all-tests.yml","lines":["@@ -180,6 +180,19 @@ jobs:","       browser: ${{ matrix.browser }}","       editor-mode: 'rich-text-with-collab-v2'"," ","+  collab-y-linux:","+    needs: [build-ubuntu]","+    strategy:","+      matrix:","+        node-version: [24.x]","+        browser: ['chromium', 'firefox']","+    uses: ./.github/workflows/call-e2e-test.yml","+    with:","+      os: 'ubuntu-latest'","+      node-version: ${{ matrix.node-version }}","+      browser: ${{ matrix.browser }}","+      editor-mode: 'rich-text-with-collab-y'","+","   collab-windows:","     needs: [build-windows]","     strategy:"],"additions":13,"deletions":0,"truncated":false},{"path":".github/workflows/call-e2e-test.yml","lines":["@@ -46,8 +46,8 @@ jobs:","         shell: bash","         run: |","           pnpm exec concurrently -k -s first \\","-            \"pnpm run collab\" \\","-            \"pnpm run test-e2e-collab-${{ inputs.editor-mode == 'rich-text-with-collab-v2' && 'v2-' || '' }}${{ inputs.prod && 'prod-' || '' }}${{ inputs.browser }} --shard=${{ inputs.shard-index }}/${{ inputs.shard-total }}\"","+            \"pnpm run ${{ inputs.editor-mode == 'rich-text-with-collab-y' && 'collab:y' || 'collab' }}\" \\","+            \"pnpm run test-e2e-collab-${{ inputs.editor-mode == 'rich-text-with-collab-v2' && 'v2-' || inputs.editor-mode == 'rich-text-with-collab-y' && 'y-' || '' }}${{ inputs.prod && 'prod-' || '' }}${{ inputs.browser }} --shard=${{ inputs.shard-index }}/${{ inputs.shard-total }}\"","       - name: Upload Artifacts","         if: ${{ !cancelled() }}","         uses: actions/upload-artifact@v7"],"additions":2,"deletions":2,"truncated":false},{"path":"AGENTS.md","lines":["@@ -29,7 +29,10 @@ For E2E testing workflow:"," - `pnpm run start` - Start playground dev server + collab server (http://localhost:3000)"," - `pnpm run dev` - Start only the playground dev server (no collab)"," - `pnpm run start:website` - Start Docusaurus website (http://localhost:3001)","-- `pnpm run collab` - Start collab server on localhost:1234","+- `pnpm run collab` - Start collab server on localhost:1234 (collab v1/v2, `@lexical/yjs`)","+- `pnpm run collab:y` - Start the Yjs 14 collab server on localhost:1235 (collab Y, the experimental `@lexical/y`; open the playground with `?isCollab=true&useCollabY=true`)","+- `pnpm run start:y` - Start playground dev server + the Yjs 14 collab server","+- `pnpm run test-e2e-collab-y-chromium` - Run the collab Y E2E specs (`Collaboration.spec.mjs`, `CollabY*.spec.mjs`; needs `pnpm run start:y`)"," "," ### Code Quality"," - `pnpm run lint` - Run ESLint on all files"],"additions":4,"deletions":1,"truncated":false},{"path":"CONTRIBUTING.md","lines":["@@ -29,7 +29,7 @@ Note that the local server needs to be running in order to run the e2e tests."," - `pnpm run start`"," - `pnpm run test-e2e-chromium` (to run only chromium e2e tests)"," ","-`pnpm run start` will start both the dev server and collab server. If you don't need collab, use `pnpm run dev` to start just the dev server.","+`pnpm run start` will start both the dev server and collab server. If you don't need collab, use `pnpm run dev` to start just the dev server. To try the experimental `@lexical/y` collaboration (`?isCollab=true&useCollabY=true`), use `pnpm run start:y`, which starts the dev server and its Yjs 14 collab server (`pnpm run collab:y`)."," "," If you're contributing to the website or documentation, you can run docusaurus"," with:"],"additions":1,"deletions":1,"truncated":false},{"path":"package.json","lines":["@@ -16,6 +16,7 @@","     \"start:dev-example\": \"sh -c '(cd \\\"dev-examples/$0\\\"; pnpm run dev)'\",","     \"start:dev-example:mdast-editor\": \"pnpm run start:dev-example mdast-editor\",","     \"start\": \"cross-env NODE_ENV=development concurrently \\\"pnpm:collab\\\" \\\"pnpm -C packages/lexical-playground run dev\\\"\",","+    \"start:y\": \"cross-env NODE_ENV=development concurrently \\\"pnpm:collab:y\\\" \\\"pnpm -C packages/lexical-playground run dev\\\"\",","     \"start:website\": \"pnpm -C packages/lexical-website run start --port 3001\",","     \"start:playground\": \"pnpm run start-test-server\",","     \"dev\": \"pnpm -C packages/lexical-playground run dev\",","@@ -43,6 +44,7 @@","     \"tsc-website\": \"pnpm --filter @lexical/website run tsc\",","     \"tsc-watch\": \"tsc -w\",","     \"collab\": \"cross-env HOST=localhost PORT=1234 pnpm exec y-websocket\",","+    \"collab:y\": \"cross-env HOST=localhost PORT=1235 node packages/lexical-playground/scripts/collab-y-server.mjs\",","     \"vitest\": \"vitest\",","     \"test-unit\": \"vitest --project unit --project scripts-unit --no-watch\",","     \"test-unit-watch\": \"vitest --project unit --project scripts-unit\",","@@ -61,8 +63,11 @@","     \"test-e2e-collab-firefox\": \"cross-env E2E_BROWSER=firefox E2E_EDITOR_MODE=rich-text-with-collab playwright test --project=\\\"firefox\\\"\",","     \"test-e2e-collab-webkit\": \"cross-env E2E_BROWSER=webkit E2E_EDITOR_MODE=rich-text-with-collab playwright test --project=\\\"webkit\\\"\",","     \"test-e2e-collab-v2-chromium\": \"cross-env E2E_BROWSER=chromium E2E_EDITOR_MODE=rich-text-with-collab-v2 playwright test --project=\\\"chromium\\\"\",","+    \"test-e2e-collab-y-chromium\": \"cross-env E2E_BROWSER=chromium E2E_EDITOR_MODE=rich-text-with-collab-y playwright test --project=\\\"chromium\\\"\",","     \"test-e2e-collab-v2-firefox\": \"cross-env E2E_BROWSER=firefox E2E_EDITOR_MODE=rich-text-with-collab-v2 playwright test --project=\\\"firefox\\\"\",","+    \"test-e2e-collab-y-firefox\": \"cross-env E2E_BROWSER=firefox E2E_EDITOR_MODE=rich-text-with-collab-y playwright test --project=\\\"firefox\\\"\",","     \"test-e2e-collab-v2-webkit\": \"cross-env E2E_BROWSER=webkit E2E_EDITOR_MODE=rich-text-with-collab-v2 playwright test --project=\\\"webkit\\\"\",","+    \"test-e2e-collab-y-webkit\": \"cross-env E2E_BROWSER=webkit E2E_EDITOR_MODE=rich-text-with-collab-y playwright test --project=\\\"webkit\\\"\",","     \"test-e2e-prod-chromium\": \"cross-env E2E_BROWSER=chromium E2E_PORT=4000 playwright test --project=\\\"chromium\\\"\",","     \"test-e2e-collab-prod-chromium\": \"cross-env E2E_BROWSER=chromium E2E_PORT=4000 E2E_EDITOR_MODE=rich-text-with-collab playwright test --project=\\\"chromium\\\"\",","     \"test-e2e-ci-chromium\": \"pnpm run prepare-ci && cross-env E2E_PORT=4000 pnpm run test-e2e-chromium\","],"additions":5,"deletions":0,"truncated":false},{"path":"packages/lexical-playground/__tests__/e2e/CollabYNodes.spec.mjs","lines":["@@ -0,0 +1,243 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// Collab Y (`@lexical/y`): tables under concurrent edits, decorator nodes","+// with nested editors (image captions), and IME composition while a peer","+// edits the same line.","+","+import {expect} from '@playwright/test';","+","+import {","+  closeSessions,","+  converge,","+  findType,","+  finish,","+  openClients,","+  seed,","+  textOf,","+} from '../utils/collabY.mjs';","+import {test} from '../utils/index.mjs';","+","+test.skip(({isCollab}) => isCollab !== 'y', 'Requires collab Y (@lexical/y)');","+test.afterEach(closeSessions);","+","+/** Each table as rows of cell texts. */","+const tableShape = json =>","+  findType(json, 'table').map(table =>","+    table.children.map(row => row.children.map(cell => textOf(cell))),","+  );","+","+test.describe('Collab Y: tables', () => {","+  test('typing in cells, then a row and a column inserted at the same time', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['tt0z']);","+    await a.caret('tt0z');","+    await a.insertTable(2, 2);","+    let json = await converge(clients);","+    expect(tableShape(json)).toEqual([","+      [","+        ['', ''],","+        ['', ''],","+      ],","+    ]);","+    await a.cell(0, 0);","+    await b.cell(1, 1);","+    await session.delay();","+    await Promise.all([a.type('ta1z'), b.type('tb1z')]);","+    json = await converge(clients);","+    expect(tableShape(json)).toEqual([","+      [","+        ['ta1z', ''],","+        ['', 'tb1z'],","+      ],","+    ]);","+    // A inserts a row below row 0 while B inserts a column after column 1.","+    await a.caret('ta1z');","+    await b.caret('tb1z');","+    await session.delay();","+    await Promise.all([","+      a.tableAction('table-insert-row-below'),","+      b.tableAction('table-insert-column-after'),","+    ]);","+    json = await converge(clients);","+    // Both inserts are kept. The row A inserted has the two columns A saw:","+    // a table a race left ragged is shown as stored until a local table","+    // command pads it.","+    expect(tableShape(json)[0].map(row => row.length)).toEqual([3, 2, 3]);","+    // A client that loads the document now shows it as stored too.","+    const loader = await session.open('G');","+    expect(tableShape(await loader.json())[0].map(row => row.length)).toEqual([","+      3, 2, 3,","+    ]);","+    expect(await converge(clients)).toEqual(json);","+    // Both type in one cell, then A types in the new row.","+    await a.caret('ta1z');","+    await b.caret('ta1z', 'before');","+    await session.delay();","+    await Promise.all([a.type(' ka1z'), b.type('kb1z ')]);","+    await converge(clients);","+    await a.cell(1, 0);","+    await b.caret('tb1z');","+    await session.delay();","+    await Promise.all([","+      (async () => {","+        await a.type('ka2z');","+        await a.press('Enter');","+        await a.type('ka3z');","+      })(),","+      b.type(' kb2z'),","+    ]);","+    const final = await finish([...clients, loader], {","+      present: ['tt0z', 'ta1z', 'tb1z', 'ka1z', 'kb1z', 'ka2z', 'ka3z', 'kb2z'],","+    });","+    // Still as stored: typing in its cells pads nothing.","+    expect(tableShape(final.json)).toEqual([","+      [","+        ['kb1z ta1z ka1z', '', ''],","+        ['ka2z|ka3z', ''],","+        ['', 'tb1z kb2z', ''],","+      ],","+    ]);","+  });","+","+  test('two clients insert a row at the same place while a third types in the table', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser, {n: 3});","+    const [a, b, c] = clients;","+    await seed(clients, ['tt0z']);","+    await a.caret('tt0z');","+    await a.insertTable(2, 2);","+    await converge(clients);","+    await a.cell(0, 0);","+    await a.type('ta1z');","+    await converge(clients);","+    await a.caret('ta1z');","+    await b.caret('ta1z');","+    await c.cell(1, 1);","+    await session.delay();","+    await Promise.all([","+      a.tableAction('table-insert-row-below'),","+      b.tableAction('table-insert-row-below'),","+      c.type('kc1z'),","+    ]);","+    const {json} = await finish(clients, {present: ['tt0z', 'ta1z', 'kc1z']});","+    const [shape] = tableShape(json);","+    expect(shape.map(row => row.length)).toEqual([2, 2, 2, 2]);","+    expect(shape[3][1]).toBe('kc1z');","+  });","+});","+","+test.describe('Collab Y: images', () => {","+  test('an image syncs; its caption (a nested editor) cannot be added', async ({","+    browser,","+  }) => {","+    const {clients} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['im1z']);","+    await a.caret('im1z');","+    await a.page","+      .locator('.toolbar-item[aria-label=\"Insert specialized editor node\"]')","+      .click();","+    await a.page.locator('.dropdown .item .image').click();","+    await a.page","+      .locator('button[data-test-id=\"image-modal-option-sample\"]')","+      .click();","+    await expect(b.page.locator('.editor-image img')).toBeVisible();","+    // `@lexical/y` does not sync nested editors, so the playground does not","+    // offer to add a caption in this mode.","+    await a.page.locator('.editor-image img').click();","+    await expect(a.page.locator('.image-resizer').first()).toBeVisible();","+    await expect(a.page.locator('.image-caption-button')).toHaveCount(0);","+    const {json} = await finish(clients, {present: ['im1z']});","+    expect(findType(json, 'image').map(image => image.showCaption)).toEqual([","+      false,","+    ]);","+  });","+});","+","+const NIHON = ['n', 'に', 'にh', 'にほ', 'にほn', 'にほん'];","+const TOKYO = ['t', 'と', 'とう', 'とうk', 'とうきょ', 'とうきょう'];","+","+test.describe('Collab Y: IME', () => {","+  test.skip(","+    ({browserName}) => browserName !== 'chromium',","+    'IME composition is driven through CDP',","+  );","+","+  test('compose in a line while a peer types in the same line', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['i1z i2z i3z']);","+    await a.caret('i2z');","+    await a.type(' ');","+    await b.caret('i3z');","+    await session.delay();","+    await Promise.all([","+      a.ime(NIHON, '日本', 80),","+      b.type(' kb1z kb2z kb3z', 30),","+    ]);","+    await a.type(' ka1z');","+    const {blocks} = await finish(clients, {","+      present: ['i1z', 'i2z', 'i3z', '日本', 'ka1z', 'kb1z', 'kb2z', 'kb3z'],","+    });","+    expect(blocks).toEqual(['paragraph:i1z i2z 日本 ka1z i3z kb1z kb2z kb3z']);","+  });","+","+  test('compose while a peer splits the line before the composition', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['s1z s2z s3z']);","+    await a.caret('s3z');","+    await a.type(' ');","+    await b.caret('s1z');","+    await session.delay();","+    await Promise.all([","+      a.ime(NIHON, '日本', 80),","+      (async () => {","+        await b.page.waitForTimeout(120);","+        await b.press('Enter');","+        await b.type('kb1z ');","+      })(),","+    ]);","+    const {blocks} = await finish(clients, {","+      present: ['s1z', 's2z', 's3z', '日本', 'kb1z'],","+    });","+    expect(blocks).toEqual(['paragraph:s1z', 'paragraph:kb1z  s2z s3z 日本']);","+  });","+","+  test('compose in a line while a peer joins it into the previous line', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['j1z', 'j2z j3z']);","+    await a.caret('j2z');","+    await a.type(' ');","+    await b.block(1, 'start');","+    await session.delay();","+    await Promise.all([","+      a.ime(TOKYO, '東京', 80),","+      (async () => {","+        await b.page.waitForTimeout(120);","+        await b.press('Backspace');","+      })(),","+    ]);","+    const {blocks} = await finish(clients, {","+      present: ['j1z', 'j2z', 'j3z', '東京'],","+    });","+    expect(blocks).toEqual(['paragraph:j1zj2z 東京 j3z']);","+  });","+});"],"additions":243,"deletions":0,"truncated":false},{"path":"packages/lexical-playground/__tests__/e2e/CollabYStructure.spec.mjs","lines":["@@ -0,0 +1,262 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// Collab Y (`@lexical/y`): line structure (Enter, Backspace, Delete, block","+// types, list indentation) changed by one client while others type. See","+// ../utils/collabY.mjs for how the clients are driven.","+","+import {expect} from '@playwright/test';","+","+import {","+  closeSessions,","+  converge,","+  findType,","+  finish,","+  openClients,","+  seed,","+  textOf,","+  tokens,","+} from '../utils/collabY.mjs';","+import {test} from '../utils/index.mjs';","+","+test.skip(({isCollab}) => isCollab !== 'y', 'Requires collab Y (@lexical/y)');","+test.afterEach(closeSessions);","+","+test.describe('Collab Y: structure while typing', () => {","+  test('three clients type in the same line', async ({browser}) => {","+    const {clients, session} = await openClients(browser, {n: 3});","+    const [a, b, c] = clients;","+    await seed(clients, ['s0z m0z e0z']);","+    const [ta, tb, tc] = [tokens('ka', 4), tokens('kb', 4), tokens('kc', 4)];","+    await a.caret('e0z');","+    await b.caret('m0z');","+    await c.caret('e0z');","+    await session.delay();","+    await Promise.all([","+      a.type(' ' + ta.join(' ')),","+      b.type(' ' + tb.join(' ')),","+      c.type(' ' + tc.join(' ')),","+    ]);","+    const {blocks} = await finish(clients, {","+      present: ['s0z', 'm0z', 'e0z', ...ta, ...tb, ...tc],","+    });","+    expect(blocks.length).toBe(1);","+    // Each client's run stays in one piece, in order.","+    for (const run of [ta, tb, tc]) {","+      expect(blocks[0]).toContain(run.join(' '));","+    }","+  });","+","+  test('Enter in the middle of a line while a peer types at its end', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['h1z h2z h3z h4z']);","+    const tb = tokens('kb', 4);","+    await a.caret('h2z');","+    await b.caret('h4z');","+    await session.delay();","+    await Promise.all([","+      (async () => {","+        await a.press('Enter');","+        await a.type('ka1z');","+      })(),","+      b.type(' ' + tb.join(' ')),","+    ]);","+    const {blocks} = await finish(clients, {","+      present: ['h1z', 'h2z', 'h3z', 'h4z', 'ka1z', ...tb],","+    });","+    expect(blocks).toEqual([","+      'paragraph:h1z h2z',","+      `paragraph:ka1z h3z h4z ${tb.join(' ')}`,","+    ]);","+  });","+","+  test('Backspace joins a line while peers type at its start and end', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser, {n: 3});","+    const [a, b, c] = clients;","+    await seed(clients, ['j1z j2z', 'j3z j4z', 'j5z']);","+    const [tb, tc] = [tokens('kb', 3), tokens('kc', 3)];","+    await a.block(1, 'start');","+    await b.caret('j4z');","+    await c.caret('j3z', 'before');","+    await session.delay();","+    await Promise.all([","+      a.press('Backspace'),","+      b.type(' ' + tb.join(' ')),","+      c.type(tc.join(' ') + ' '),","+    ]);","+    const {blocks} = await finish(clients, {","+      present: ['j1z', 'j2z', 'j3z', 'j4z', 'j5z', ...tb, ...tc],","+    });","+    expect(blocks).toEqual([","+      `paragraph:j1z j2z${tc.join(' ')} j3z j4z ${tb.join(' ')}`,","+      'paragraph:j5z',","+    ]);","+  });","+","+  test('Delete at a line end while a peer types at the start of the next line', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['d1z d2z', 'd3z d4z']);","+    const tb = tokens('kb', 3);","+    await a.caret('d2z');","+    await b.caret('d3z', 'before');","+    await session.delay();","+    await Promise.all([a.press('Delete'), b.type(tb.join(' ') + ' ')]);","+    const {blocks} = await finish(clients, {","+      present: ['d1z', 'd2z', 'd3z', 'd4z', ...tb],","+    });","+    expect(blocks).toEqual([`paragraph:d1z d2z${tb.join(' ')} d3z d4z`]);","+  });","+","+  test('two clients press Enter at the same position and type', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['e1z e2z']);","+    await a.caret('e1z');","+    await b.caret('e1z');","+    await session.delay();","+    await Promise.all([","+      (async () => {","+        await a.press('Enter');","+        await a.type('ka1z');","+      })(),","+      (async () => {","+        await b.press('Enter');","+        await b.type('kb1z');","+      })(),","+    ]);","+    const {blocks} = await finish(clients, {","+      present: ['e1z', 'e2z', 'ka1z', 'kb1z'],","+    });","+    expect(blocks.length).toBe(3);","+    expect(blocks[0]).toBe('paragraph:e1z');","+  });","+","+  test('heading and quote toggles while peers type in the line', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser, {n: 3});","+    const [a, b, c] = clients;","+    await seed(clients, ['q1z', 'q2z q3z', 'q4z']);","+    await a.caret('q2z');","+    await b.caret('q3z');","+    await c.caret('q4z', 'before');","+    await session.delay();","+    await Promise.all([","+      a.blockType('h1'),","+      b.type(' kb1z kb2z'),","+      (async () => {","+        await c.blockType('h2');","+        await c.type('kc1z ');","+      })(),","+    ]);","+    await converge(clients);","+    await a.caret('q2z');","+    await session.delay();","+    await Promise.all([a.blockType('quote'), b.type(' kb3z')]);","+    const {blocks} = await finish(clients, {","+      present: ['q1z', 'q2z', 'q3z', 'q4z', ...tokens('kb', 3), 'kc1z'],","+    });","+    expect(blocks).toEqual([","+      'paragraph:q1z',","+      'quote:q2z q3z kb1z kb2z kb3z',","+      'heading/h2:kc1z q4z',","+    ]);","+  });","+","+  test('list: create, indent, Enter and outdent while a peer types', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['li1z', 'li2z', 'li3z', 'li4z']);","+    // A makes a bullet list of three lines while B types in line 2.","+    await a.range('li1z', 'li3z');","+    await b.caret('li2z');","+    await session.delay();","+    await Promise.all([a.blockType('bullet-list'), b.type(' kb1z kb2z')]);","+    await converge(clients);","+    // A indents item 2 while B types in item 3.","+    await a.caret('li2z', 'before');","+    await b.caret('li3z');","+    await session.delay();","+    await Promise.all([a.press('Tab'), b.type(' kb3z')]);","+    await converge(clients);","+    // A presses Enter at the end of item 3 and types, B types in item 2.","+    await a.caret('kb3z');","+    await b.caret('kb2z');","+    await session.delay();","+    await Promise.all([","+      (async () => {","+        await a.press('Enter');","+        await a.type('ka1z');","+      })(),","+      b.type(' kb4z'),","+    ]);","+    await converge(clients);","+    // A outdents item 2 while B types in item 1.","+    await a.caret('li2z', 'before');","+    await b.caret('li1z');","+    await session.delay();","+    await Promise.all([a.press('Shift+Tab'), b.type(' kb5z')]);","+    const {blocks, json} = await finish(clients, {","+      present: ['li1z', 'li2z', 'li3z', 'li4z', 'ka1z', ...tokens('kb', 5)],","+    });","+    expect(blocks).toEqual([","+      'list/bullet:li1z kb5z|li2z kb1z kb2z kb4z|li3z kb3z|ka1z',","+      'paragraph:li4z',","+    ]);","+    expect(json.children[0].children.map(item => item.value)).toEqual([","+      1, 2, 3, 4,","+    ]);","+  });","+","+  test('link while peers type inside and after the linked text', async ({","+    browser,","+  }) => {","+    const {clients, session} = await openClients(browser, {n: 3});","+    const [a, b, c] = clients;","+    await seed(clients, ['w1z w2z w3z w4z']);","+    await a.range('w2z', 'w3z');","+    await b.caret('w2z');","+    await c.caret('w4z');","+    await session.delay();","+    await Promise.all([a.insertLink(), b.type(' kb1z'), c.type(' kc1z')]);","+    let json = await converge(clients);","+    const links = findType(json, 'link');","+    expect(links.map(link => link.url)).toEqual(['https://']);","+    // Text typed inside the range while it was linked is part of the link.","+    expect(textOf(links[0])).toBe('w2z kb1z w3z');","+    // A sets the URL; B then types at the end of the link.","+    await a.caret('kb1z');","+    await a.setLinkURL('https://a.example/');","+    json = await converge(clients);","+    expect(findType(json, 'link').map(link => link.url)).toEqual([","+      'https://a.example/',","+    ]);","+    // A removes the link while B types inside it.","+    await a.caret('kb1z');","+    await b.caret('w2z');","+    await session.delay();","+    await Promise.all([a.insertLink(), b.type(' kb2z')]);","+    const final = await finish(clients, {","+      present: ['w1z', 'w2z', 'w3z', 'w4z', 'kb1z', 'kb2z', 'kc1z'],","+    });","+    expect(findType(final.json, 'link')).toEqual([]);","+    expect(final.blocks).toEqual(['paragraph:w1z w2z kb2z kb1z w3z w4z kc1z']);","+  });","+});"],"additions":262,"deletions":0,"truncated":false},{"path":"packages/lexical-playground/__tests__/e2e/CollabYSync.spec.mjs","lines":["@@ -0,0 +1,471 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// Collab Y (`@lexical/y`): clients that open a new document at once,","+// clients that edit while disconnected (the toolbar's connect button) and","+// reconnect, undo that only reverts the client's own changes, the version","+// gate, a client waiting for its first sync, and provider connections that","+// fail.","+","+import {expect} from '@playwright/test';","+import {createServer} from 'node:net';","+","+import {","+  closeSessions,","+  converge,","+  finish,","+  openClients,","+  seed,","+  tokens,","+} from '../utils/collabY.mjs';","+import {E2E_PORT, test} from '../utils/index.mjs';","+","+test.skip(({isCollab}) => isCollab !== 'y', 'Requires collab Y (@lexical/y)');","+test.afterEach(closeSessions);","+","+/** Call the editor's `setEditable` directly, as any code on the page could. */","+async function setEditable(client, editable) {","+  await client.evaluate(value => {","+    document","+      .querySelector('[data-lexical-editor]')","+      .__lexicalEditor.setEditable(value);","+  }, editable);","+}","+","+test.describe('Collab Y: a new document', () => {","+  test('clients that open a new document at once write one paragraph', async ({","+    browser,","+  }) => {","+    // Each client writes its initial state (an empty paragraph) into the","+    // empty document when it first syncs; identical seeds merge into one.","+    const {clients} = await openClients(browser, {n: 3, together: true});","+    const {blocks} = await finish(clients);","+    expect(blocks).toEqual(['paragraph:']);","+    const [a, b] = clients;","+    await a.editor.focus();","+    await a.type('ka1z');","+    await converge(clients);","+    await b.editor.focus();","+    await b.press('End');","+    await b.type(' kb1z');","+    const after = await finish(clients, {present: ['ka1z', 'kb1z']});","+    expect(after.blocks).toEqual(['paragraph:ka1z kb1z']);","+  });","+","+  test('the split view shows the first paragraph once', async ({page}) => {","+    const params = new URLSearchParams({","+      collabId: `y-split-${test.info().project.name}-${Date.now()}`,","+      emptyEditor: 'true',","+      isCollab: 'true',","+      isRichText: 'true',","+      showTreeView: 'false',","+      useCollabY: 'true',","+    });","+    await page.goto(`http://localhost:${E2E_PORT}/split/?${params}`);","+    for (const name of ['left', 'right']) {","+      const editor = page","+        .frameLocator(`iframe[name=\"${name}\"]`)","+        .locator('[data-lexical-editor=\"true\"]');","+      await expect(editor).toHaveAttribute('contenteditable', 'true', {","+        timeout: 20000,","+      });","+    }","+    // Both frames initialized the new document; give their writes time to","+    // reach each other.","+    await page.waitForTimeout(1000);","+    for (const name of ['left', 'right']) {","+      await expect(","+        page","+          .frameLocator(`iframe[name=\"${name}\"]`)","+          .locator('[data-lexical-editor=\"true\"] > *'),","+      ).toHaveCount(1);","+    }","+  });","+});","+","+test.describe('Collab Y: offline', () => {","+  test('both sides edit text and structure while one is offline, then reconnect', async ({","+    browser,","+  }) => {","+    const {clients} = await openClients(browser, {n: 3});","+    const [a, b, c] = clients;","+    await seed(clients, ['o1z o2z', 'o3z o4z', 'o5z']);","+    await b.setOnline(false);","+    // Online: A types in line 1 and splits line 2; C makes line 3 a heading.","+    await a.caret('o1z');","+    await a.type(' ka1z');","+    await a.caret('o3z');","+    await a.press('Enter');","+    await a.type('ka2z ');","+    await c.caret('o5z');","+    await c.blockType('h1');","+    await c.type(' kc1z');","+    // Offline: B types in lines 1 and 2, and joins line 3 into line 2.","+    await b.caret('o2z');","+    await b.type(' kb1z');","+    await b.caret('o4z');","+    await b.type(' kb2z');","+    await b.block(2, 'start');","+    await b.press('Backspace');","+    await b.type('kb3z ');","+    await converge([a, c]);","+    expect((await b.blocks()).join('|')).not.toContain('ka1z');","+    expect((await a.blocks()).join('|')).not.toContain('kb1z');","+    await b.setOnline(true);","+    const {blocks} = await finish(clients, {","+      present: [","+        ...['o1z', 'o2z', 'o3z', 'o4z', 'o5z'],","+        ...['ka1z', 'ka2z', 'kc1z', 'kb1z', 'kb2z', 'kb3z'],","+      ],","+    });","+    expect(blocks[0]).toBe('paragraph:o1z ka1z o2z kb1z');","+    expect(blocks.length).toBe(3);","+  });","+","+  test('large divergence: 30 lines on each side, lists, headings and joins', async ({","+    browser,","+  }) => {","+    test.setTimeout(240000);","+    const {clients} = await openClients(browser);","+    const [a, b] = clients;","+    const base = tokens('bl', 8);","+    await seed(clients, base);","+    await b.setOnline(false);","+    // A appends 30 lines, makes a list of lines 2-4, a heading of line 6,","+    // and types in every line.","+    const ta = tokens('ka', 30);","+    await a.block(7, 'end');","+    for (const t of ta) {","+      await a.press('Enter');","+      await a.type(t, 0);","+    }","+    await a.range('bl2z', 'bl4z');","+    await a.blockType('bullet-list');","+    await a.caret('bl6z');","+    await a.blockType('h2');","+    const tx = tokens('kx', 8);","+    for (let i = 0; i < 8; i++) {","+      await a.caret(base[i]);","+      await a.type(` ${tx[i]}`, 0);","+    }","+    // B, offline, prepends 30 lines, types in every line, joins two pairs","+    // of lines and splits line 3.","+    const tb = tokens('kb', 30);","+    await b.block(0, 'start');","+    for (const t of tb) {","+      await b.type(t, 0);","+      await b.press('Enter');","+    }","+    const ty = tokens('ky', 8);","+    for (let i = 0; i < 8; i++) {","+      await b.caret(base[i], 'before');","+      await b.type(`${ty[i]} `, 0);","+    }","+    for (const i of [5, 7]) {","+      await b.caret(ty[i], 'before');","+      await b.press('Backspace');","+    }","+    await b.caret('bl3z');","+    await b.press('Enter');","+    await b.type('kb31z', 0);","+    await b.setOnline(true);","+    await finish(clients, {","+      present: [...base, ...ta, ...tb, ...tx, ...ty, 'kb31z'],","+    });","+  });","+});","+","+test.describe('Collab Y: undo isolation', () => {","+  test('undo and redo own typing after a peer typed in the same line', async ({","+    browser,","+  }) => {","+    const {clients} = await openClients(browser);","+    const [a, b] = clients;","+    await seed(clients, ['u1z u2z']);","+    await a.caret('u2z');","+    await a.type(' ka1z');","+    await a.stopCapturing();","+    await converge(clients);","+    await b.caret('u1z', 'before');","+    await b.type('kb1z ');","+    await b.caret('ka1z');","+    await b.type(' kb2z');","+    await converge(clients);","+    await a.undo();","+    await converge(clients);","+    expect(await a.blocks()).toEqual(['paragraph:kb1z u1z u2z kb2z']);","+    await a.redo();"],"additions":202,"deletions":0,"truncated":false}],"additions":732,"deletions":4,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-29T15:19:17.813105+00:00"}