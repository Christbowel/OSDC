ivity while preserving host-owned workspace information and user flags. Host-reported activity takes precedence over discovery for the rest of that adapter's lifetime, including after disconnection; older discovery responses cannot replace a newer discovery result. The Agents Window's persisted discovery baselines let title, timestamp, and project fields continue to refresh until the host changes them. Missing activity does not clear a previously reported status. Sandbox connection availability and read-only interactivity remain separate from conversation activity, so disconnection does not turn a reported input request into a conversation error."],"additions":2,"deletions":0,"truncated":false},{"path":"src/vs/sessions/contrib/providers/remoteAgentHost/browser/entryDrivenProviderContribution.ts","lines":["@@ -82,7 +82,7 @@ export abstract class EntryDrivenProviderContribution extends Disposable {"," \t\tfor (const entry of entries) {"," \t\t\tconst address = getEntryAddress(entry);"," \t\t\tconst existing = this._providerInstances.get(address);","-\t\t\tif (existing && existing.label !== (entry.name || address)) {","+\t\t\tif (existing && existing.defaultLabel !== (entry.name || address)) {"," \t\t\t\tthis._providerStores.deleteAndDispose(address);"," \t\t\t}"," \t\t\tif (!this._providerStores.has(address)) {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/vs/sessions/contrib/providers/remoteAgentHost/browser/manageRemoteAgentHosts.ts","lines":["@@ -133,11 +133,16 @@ registerAction2(class extends Action2 {"," \t\t\tconst subscribeToProviders = () => {"," \t\t\t\tobserverStore.clear();"," \t\t\t\tfor (const p of sessionsProvidersService.getProviders()) {","-\t\t\t\t\tif (isAgentHostProvider(p) && p.connectionStatus) {","-\t\t\t\t\t\tobserverStore.add(autorun(reader => {","-\t\t\t\t\t\t\tp.connectionStatus!.read(reader);","-\t\t\t\t\t\t\trefresh();","-\t\t\t\t\t\t}));","+\t\t\t\t\tif (isAgentHostProvider(p)) {","+\t\t\t\t\t\tif (p.connectionStatus) {","+