d' => Id::unique(), 'name' => 'Key From JWT', 'scopes' => ['users.read']]],","+            'ephemeral' => [Client::METHOD_POST, $this->keysPath() . '/ephemeral', ['scopes' => ['users.read'], 'duration' => 60]],","+            'update' => [Client::METHOD_PUT, $this->keysPath() . '/' . $keyId, ['name' => 'Key From JWT', 'scopes' => ['users.read']]],","+        ];","+","+        foreach ($refused as $case => [$method, $path, $params]) {","+            $response = $this->client->call($method, $path, $asJWT, $params);","+            $this->assertSame(403, $response['headers']['status-code'], $case);","+            $this->assertSame('key_creation_denied', $response['body']['type'], $case);","+        }","+","+        // Cleanup","+        $this->deleteKey($keyId);","+    }","+","     // =========================================================================","     // Delete key tests","     // =========================================================================",""],"additions":43,"deletions":0,"truncated":false}],"additions":93,"deletions":0,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-24T12:58:57.045839+00:00"}