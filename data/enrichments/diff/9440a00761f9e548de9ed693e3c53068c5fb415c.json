 a private staging dir inside a data root,","+        # never the shared system temp dir (CWE-377), and is removed after.","+        staging_dir = make_staging_dir(prefix=\"nltk_tp_train_\", cleanup=True)","+        input_file = tempfile.NamedTemporaryFile(","+            prefix=\"transition_parse.train\", dir=staging_dir, delete=False","+        )","         try:","-            input_file = tempfile.NamedTemporaryFile(","-                prefix=\"transition_parse.train\", dir=tempfile.gettempdir(), delete=False","-            )","-","             if self._algorithm == self.ARC_STANDARD:","                 self._create_training_examples_arc_std(depgraphs, input_file)","             else:","@@ -622,7 +625,11 @@ def train(self, depgraphs, modelfile, verbose=True):","             with pathsec_open(modelfile, \"wb\", context=\"TransitionParser.train\") as f:","                 pickle_dump(model, f)","         finally:","-            remove(input_file.name)","+            input_file.close()","+            pathsec.unlink(input_file.name, context=\"TransitionParser.train\")","+            pathsec.remove_tree(","+                staging_dir, context=\"TransitionParser.train\", ignore_errors=True","+            )"," ","     def parse(self, depgraphs, modelFile):","         \"\"\""],"additions":13,"deletions":6,"truncated":false},{"path":"nltk/sem/boxer.py","lines":["@@ -30,13 +30,12 @@"," "," import operator"," import os","-import shutil"," import subprocess"," import tempfile"," from functools import reduce"," from optparse import OptionParser"," ","-from nltk import redos","+from nltk import pathsec, redos"," from nltk.internals import find_binary_absolute"," from nltk.pathsec import TrustError, has_line_unsafe_char, spawn_trusted"," from nltk.sem.drt import (","@@ -272,7 +271,9 @@ def _call_boxer(self, candc_out, verbose=False):","             temp_filename,","         ]","         stdout = self._call(None, self._boxer_bin, args, verbose)","-        shutil.rmtree(staging_dir, ignore_errors=True)","+        pathsec.remove_tree(","+            staging_dir, context=\"Boxer._call_boxer\", ignore_errors=True","+        )","         return stdout"," ","     def _find_binary(self, name, bin_dir, verbose=False):"],"additions":4,"deletions":3,"truncated":false},{"path":"nltk/tag/stanford.py","lines":["@@ -170,7 +170,7 @@ def tag_sents(self, sentences):","         finally:","             if input_file_path:","                 try:","-                    os.unlink(input_file_path)","+                    pathsec.unlink(input_file_path, context=\"StanfordTagger\")","                 except FileNotFoundError:","                     pass","                 except OSError:"],"additions":1,"deletions":1,"truncated":false},{"path":"nltk/test/unit/test_downloader.py","lines":["@@ -143,7 +143,7 @@ class DummyInfo:","     ) as pathsec_open_mock, unittest.mock.patch(","         \"nltk.downloader.validate_path\"","     ) as validate_path_mock, unittest.mock.patch(","-        \"nltk.downloader.os.replace\"","+        \"nltk.downloader.pathsec.replace\"","     ) as replace_mock, unittest.mock.patch(","         \"nltk.downloader.os.makedirs\"","     ), unittest.mock.patch(","@@ -192,7 +192,9 @@ class DummyInfo:","             required_root=download_dir,","         )"," ","-        replace_mock.assert_called_once_with(tmp_file, final_file)","+        replace_mock.assert_called_once_with(","+            tmp_file, final_file, context=\"Downloader._download_package\"","+        )"," ","         # Sanity check: the PR-specific path scoping does not change builtins.open.","         assert open is __builtins__[\"open\"]"],"additions":4,"deletions":2,"truncated":false},{"path":"nltk/test/unit/test_pathsec_routing.py","lines":["@@ -0,0 +1,351 @@","+\"\"\"The file operations modules used to roll themselves now route through pathsec.","+","+Two pathsec additions are tested on their own (``remove_tree`` with the","+descriptor-based fast path and ``ignore_errors``, and ``ensure_private_dir``),","+then each routed site is exercised: the downloader's privacy predicate is","+pathsec's, the transition parser stages its scratch file inside a data root,","+PanLex binds its sqlite open to the checked inode, and the tool wrappers","+remove their scratch files by name through pathsec.","+\"\"\"","+","+import os","+import sqlite3","+import stat","+import sys","+","+import pytest","+","+from nltk import pathsec","+","+POSIX = os.name == \"posix\"","+","+","+# =========================================================================== #","+# pathsec.remove_tree                                                          #","+# =========================================================================== #","+","+","+def _tree(root):","+    \"\"\"A small tree with a file at every level.\"\"\"","+    (root / \"a\" / \"b\").mkdir(parents=True)","+    (root / \"top.txt\").write_text(\"top\")","+    (root / \"a\" / \"mid.txt\").write_text(\"mid\")","+    (root / \"a\" / \"b\" / \"leaf.txt\").write_text(\"leaf\")","+    return root","+","+","+def test_remove_tree_removes_a_tree_inside_the_root(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    target = _tree(root / \"tree\")","+    pathsec.remove_tree(str(target), context=\"test\")","+    assert not target.exists()","+","+","+def test_remove_tree_refuses_a_tree_outside_the_root(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    target = _tree(outside / \"tree\")","+    with pytest.raises(PermissionError, match=\"Security Violation\"):","+        pathsec.remove_tree(str(target), context=\"test\")","+    assert (target / \"a\" / \"b\" / \"leaf.txt\").exists()","+","+","+@pytest.mark.skipif(not POSIX, reason=\"symlinks\")","+def test_remove_tree_never_follows_a_link_inside_the_tree(pathsec_sandbox):","+    \"\"\"A link planted inside the tree, pointing outside, is removed as a link;","+    the target it points at keeps every file.\"\"\"","+    root, outside = pathsec_sandbox","+    victim = _tree(outside / \"victim\")","+    target = _tree(root / \"tree\")","+    os.symlink(str(victim), str(target / \"a\" / \"escape\"))","+    pathsec.remove_tree(str(target), context=\"test\")","+    assert not target.exists()","+    assert (victim / \"a\" / \"b\" / \"leaf.txt\").read_text() == \"leaf\"","+","+","+@pytest.mark.skipif(not POSIX, reason=\"symlinks\")","+def test_remove_tree_refuses_a_link_standing_as_the_tree(pathsec_sandbox):","+    \"\"\"The root itself being a link is refused outright, whatever","+    ``ignore_errors`` says: the security refusals are never swallowed.\"\"\"","+    root, outside = pathsec_sandbox","+    victim = _tree(outside / \"victim\")","+    link = root / \"tree\"","+    os.symlink(str(victim), str(link))","+    for ignore in (False, True):","+        with pytest.raises(PermissionError, match=\"Security Violation\"):","+            pathsec.remove_tree(str(link), context=\"test\", ignore_errors=ignore)","+    assert os.path.islink(link) and (victim / \"top.txt\").exists()","+    # a link to a directory INSIDE the root passes containment and is refused","+    # by the not-a-link check itself","+    inside = _tree(root / \"inside\")","+    link2 = root / \"tree2\"","+    os.symlink(str(inside), str(link2))","+    for ignore in (False, True):","+        with pytest.raises(PermissionError, match=\"not a directory to remove\"):","+            pathsec.remove_tree(str(link2), context=\"test\", ignore_errors=ignore)","+    assert os.path.islink(link2) and (inside / \"top.txt\").exists()","+","+","+def test_remove_tree_refuses_a_plain_file(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    target = root / \"file.txt\"","+    target.write_text(\"x\")","+    with pytest.raises(PermissionError, match=\"not a directory to remove\"):","+        pathsec.remove_tree(str(target), context=\"test\")","+    assert target.exists()","+","+","+@pytest.mark.skipif(","+    not POSIX or os.geteuid() == 0, reason=\"a mode bit stops nothing for root\"","+)","+def test_remove_tree_ignore_errors_swallows_only_the_removal_failure(pathsec_sandbox):","+    \"\"\"A directory whose entries cannot be unlinked (no write bit on it) makes","+    the plain call raise and the ignore_errors call return; what could not be","+    removed is still there either way, nothing else is touched.\"\"\"","+    root, outside = pathsec_sandbox","+    target = _tree(root / \"tree\")","+    locked = target / \"a\" / \"b\"","+    os.chmod(locked, 0o500)","+    try:","+        with pytest.raises(OSError):","+            pathsec.remove_tree(str(target), context=\"test\")","+        assert (locked / \"leaf.txt\").exists()","+        pathsec.remove_tree(str(target), context=\"test\", ignore_errors=True)","+        assert (locked / \"leaf.txt\").exists()","+    finally:","+        os.chmod(locked, 0o700)","+    pathsec.remove_tree(str(target), context=\"test\")","+    assert not target.exists()","+","+","+# =========================================================================== #","+# pathsec.ensure_private_dir                                                   #","+# =========================================================================== #","+","+","+def test_ensure_private_dir_creates_a_missing_dir_privately(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    target = root / \"out\"","+    old_umask = os.umask(0o000)","+    try:","+        made = pathsec.ensure_private_dir(str(target), context=\"test\")","+    finally:","+        os.umask(old_umask)","+    assert os.path.isdir(made) and os.path.samefile(made, target)","+    if POSIX:","+        assert stat.S_IMODE(os.stat(target).st_mode) == 0o700","+","+","+def test_ensure_private_dir_accepts_an_existing_private_dir(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    target = root / \"out\"","+    target.mkdir(mode=0o700)","+    (target / \"keep.txt\").write_text(\"kept\")","+    pathsec.ensure_private_dir(str(target), context=\"test\")","+    assert (target / \"keep.txt\").read_text() == \"kept\"","+","+","+def test_ensure_private_dir_refuses_a_dir_outside_the_root(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    with pytest.raises(PermissionError, match=\"Security Violation\"):","+        pathsec.ensure_private_dir(str(outside / \"out\"), context=\"test\")","+    assert not (outside / \"out\").exists()","+","+","+@pytest.mark.skipif(not POSIX or os.geteuid() == 0, reason=\"root owns every mode\")","+@pytest.mark.parametrize(\"mode\", [0o777, 0o775, 0o757])","+def test_ensure_private_dir_refuses_a_dir_another_account_can_write(","+    pathsec_sandbox, mode","+):","+    root, outside = pathsec_sandbox","+    target = root / \"shared\"","+    target.mkdir()","+    os.chmod(target, mode)","+    try:","+        with pytest.raises(PermissionError, match=\"writable by another account\"):","+            pathsec.ensure_private_dir(str(target), context=\"test\")","+    finally:","+        os.chmod(target, 0o700)","+","+","+@pytest.mark.skipif(not POSIX, reason=\"symlinks\")","+def test_ensure_private_dir_refuses_a_link_to_outside(pathsec_sandbox):","+    root, outside = pathsec_sandbox","+    (outside / \"real\").mkdir()","+    link = root / \"out\"","+    os.symlink(str(outside / \"real\"), str(link))","+    with pytest.raises(PermissionError, match=\"Security Violation\"):","+        pathsec.ensure_private_dir(str(link), context=\"test\")","+","+","+# =========================================================================== #","+# the routed sites                                                             #","+# =========================================================================== #","+","+","+@pytest.mark.skipif(not POSIX, reason=\"the predicate is POSIX only\")","+def test_downloader_not_ours_is_pathsec_private_stat():","+    \"\"\"The downloader's install-tree predicate is pathsec's privacy predicate,","+    not a second copy: for every owner and mode the two must agree.\"\"\"","+    from nltk.downloader import _not_ours","+","+    me = os.geteuid()","+    for uid in (me, 0, me + 1):","+        for mode in (0o600, 0o644, 0o664, 0o666, 0o700, 0o755, 0o775, 0o777):","+            st = os.stat_result((stat.S_IFREG | mode, 1, 1, 1, uid, 0, 0, 0, 0, 0))","+            assert _not_ours(st) == (not pathsec._private_stat(st)), (uid, oct(mode))","+","+","+def test_downloader_cleanup_goes_through_pathsec(pathsec_sandbox, monkeypatch):","+    \"\"\"``_safe_rmtree`` and ``_safe_remove`` call pathsec.remove_tree and","+    pathsec.unlink: the module holds no removal of its own.\"\"\"","+    import inspect","+","+    from nltk import downloader","+","+    src = \"\\n\".join(","+        line","+        for line in inspect.getsource(","+            downloader.Downloader._download_package","+        ).splitlines()","+        if not line.lstrip().startswith(\"#\")","+    )","+    assert \"pathsec.remove_tree(\" in src and \"pathsec.unlink(\" in src","+    assert \"shutil.rmtree(\" not in src and \"os.remove(\" not in src","+    assert \"pathsec.replace(\" in src and \"os.replace(\" not in src","+","+","+def test_transition_parser_stages_its_scratch_file_inside_a_data_root(","+    pathsec_sandbox, monkeypatch","+):","+    \"\"\"The training scratch file lands in a private staging dir under the","+    allowed root, never in the shared system temp dir, and is gone after.\"\"\"","+    pytest.importorskip(\"sklearn\")","+    pytest.importorskip(\"scipy\")","+    import tempfile","+","+    import nltk.data","+    from nltk.parse import transitionparser","+    from nltk.parse.dependencygraph import DependencyGraph","+","+    root, outside = pathsec_sandbox","+    staged = []","+    real = nltk.data.make_staging_dir","+","+    def spy(*args, **kwargs):","+        path = real(*args, **kwargs)","+        staged.append(path)","+        return path","+","+    monkeypatch.setattr(transitionparser, \"make_staging_dir\", spy)","+    scratch_before = {","+        name","+        for name in os.listdir(tempfile.gettempdir())","+        if name.startswith(\"transition_parse.train\")","+    }","+    gold = DependencyGraph(\"the\\tDT\\t2\\tdet\\ndog\\tNN\\t3\\tnsubj\\nbarks\\tVBZ\\t0\\troot\\n\")","+    parser = transitionparser.TransitionParser(\"arc-standard\")","+    model = str(root / \"model.pickle\")","+    parser.train([gold] * 4, model, verbose=False)","+    assert os.path.exists(model)","+    assert len(staged) == 1, staged","+    assert os.path.realpath(staged[0]).startswith(os.path.realpath(str(root)))","+    assert not os.path.exists(staged[0]), \"the staging dir is removed after\"","+    scratch_after = {","+        name","+        for name in os.listdir(tempfile.gettempdir())","+        if name.startswith(\"transition_parse.train\")","+    }","+    assert scratch_after == scratch_before, \"nothing landed in the shared temp dir\"","+","+","+def _panlex_db(path):","+    connection = sqlite3.connect(str(path))","+    connection.execute(\"CREATE TABLE lv (uid text, lv int)\")","+    connection.execute(\"INSERT INTO lv VALUES ('eng-000', 187)\")","+    connection.commit()","+    connection.close()","+","+","+def test_panlex_reader_binds_sqlite_to_the_checked_inode(pathsec_sandbox, monkeypatch):","+    from nltk.corpus.reader import panlex_lite","+","+    root, outside = pathsec_sandbox","+    corpus = root / \"panlex\"","+    corpus.mkdir()","+    _panlex_db(corpus / \"db.sqlite\")","+    seen = {}","+    real = pathsec.connect_sqlite_read_only","+","+    def spy(path, names=None, context=None):","+        seen[\"path\"], seen[\"names\"], seen[\"context\"] = path, names, context","+        return real(path, names=names, context=context)","+","+    monkeypatch.setattr(pathsec, \"connect_sqlite_read_only\", spy)","+    reader = panlex_lite.PanLexLiteCorpusReader(str(corpus))","+    assert reader._uid_lv == {\"eng-000\": 187}","+    assert os.path.samefile(seen[\"path\"], corpus / \"db.sqlite\")","+    assert seen[\"names\"] == [","+        seen[\"path\"] + suffix for suffix in (\"\", \"-journal\", \"-wal\", \"-shm\")","+    ]","+    assert seen[\"context\"] == \"PanLexLiteCorpusReader\"","+","+","+def test_panlex_reader_connection_is_read_only(pathsec_sandbox):","+    from nltk.corpus.reader import panlex_lite","+","+    root, outside = pathsec_sandbox","+    corpus = root / \"panlex\""],"additions":297,"deletions":0,"truncated":false}],"additions":374,"deletions":95,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-10-13T15:28:07.766127+00:00"}