      # that follows has its directory instead of failing on ENOTDIR.","+            # A link, file or special entry standing where the package","+            # directory belongs is stale state: removed by name, never followed","+            # (CWE-59 / CWE-22), so the extraction that follows has its","+            # directory instead of failing on ENOTDIR. A directory goes through","+            # pathsec.remove_tree, which never follows a link inside it either.","+            if os.path.islink(path) or not os.path.isdir(path):","                 if os.path.lexists(path):","                     _safe_remove(path)","                 return","-            # os.walk lists a directory and descends into it later by path, so","-            # a subdirectory swapped for a symlink in between is followed and","-            # its target emptied; the fd-based rmtree pins each directory.","-            if shutil.rmtree.avoids_symlink_attacks:","-                shutil.rmtree(path, ignore_errors=True)","-                return","-            for root, dirs, files in os.walk(path, topdown=False):","-                for name in files:","-                    try:","-                        os.remove(os.path.join(root, name))","-                    except OSError:","-                        pass","-                for name in dirs:","-                    full = os.path.join(root, name)","-                    # os.walk (followlinks=False) lists but does not descend","-                    # symlinked subdirs; remove the link, never its target.","-                    if os.path.islink(full):","-                        _safe_remove(full)","-                        continue","-                    try:","-                        os.rmdir(full)","-                    except OSError:","-                        pass","             try:","-                os.rmdir(path)","+                pathsec.remove_tree(","+                    path, context=\"Downloader._download_package\", ignore_errors=True","+                )","             except OSError:","                 pass"," ","@@ -1482,7 +1452,9 @@ def _installed_now():","                         context=\"Downloader._download_package\",","                         required_root=download_dir,","                     )","-                    os.replace(tmp_filepath, filepath)","+                    pathsec.replace(","+                        tmp_filepath, filepath, context=\"Downloader._download_package\"","+                    )","                     self._status_cache.pop(info.id, None)","                 except (OSError, ValueError, http.client.HTTPException) as e:","                     # A malformed status line, a truncated body or a refused URL","@@ -3546,7 +3518,7 @@ def _unzip_iter(","                     extracted += placed.st_size","                 if extracted > expected_size + UNZIPPED_SIZE_SLACK:","                     if placed is not None and stat.S_ISREG(placed.st_mode):","-                        os.remove(written)","+                        pathsec.unlink(written, context=\"Downloader._unzip_iter\")","                     yield ErrorMessage(","                         filename,","                         f\"Unzipped size blocked: extraction passed the \""],"additions":19,"deletions":47,"truncated":false},{"path":"nltk/parse/malt.py","lines":["@@ -12,6 +12,7 @@"," import sys"," import tempfile"," ","+from nltk import pathsec"," from nltk.data import ZipFilePathPointer, make_staging_dir"," from nltk.internals import (","     find_dir,","@@ -273,7 +274,9 @@ def parse_tagged_sents(self, sentences, verbose=False, top_relation_label=\"null\"","             for filename in (input_file_name, output_file_name):","                 if filename:","                     try:","-                        os.remove(filename)","+                        pathsec.unlink(","+                            filename, context=\"MaltParser.parse_tagged_sents\"","+                        )","                     exc