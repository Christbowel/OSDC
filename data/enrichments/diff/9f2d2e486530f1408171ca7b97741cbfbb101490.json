":"packages/memory/src/kv/types/config.ts","lines":["@@ -2,6 +2,7 @@ import type { Redis } from 'ioredis';"," "," export interface ExtendedRedis extends Redis {"," \tsetMax(key: string, value: number): Promise<number>;","+\tsetMaxField(hash: string, field: string, value: number, ttl: number): Promise<number>;"," \trelease(key: string, value: string): Promise<number>;"," }"," ","@@ -33,7 +34,7 @@ export interface KvConfigRedis extends KvConfigAbstract {"," \ttype: 'redis';"," "," \t/**","-\t * Used to prefix the keys","+\t * Used to prefix the keys, or to name the hash the keys are kept in when `hash` is enabled"," \t */"," \tnamespace: string;"," ","@@ -66,8 +67,21 @@ export interface KvConfigRedis extends KvConfigAbstract {"," "," \t/**"," \t * Time-to-Live expires keys after duration in milliseconds","+\t *","+\t * With `hash` enabled the TTL applies to the namespace as a whole and is refreshed on every write."," \t */"," \tttl?: number;","+","+\t/**","+\t * Store the keys as fields of a single Redis hash named after the namespace, rather than as","+\t * individual `namespace:key` keys, making `clear` a single unlink instead of a keyspace scan.","+\t *","+\t * The `ttl` applies to the hash as a whole; locks are unaffected as they can't live in a hash.","+\t * When Redis 7.4+ becomes the only lts, we can improve this even further by using TTL + Hashsets","+\t *","+\t * @default false","+\t */","+\thash?: boolean;"," }"," "," export type KvConfig = KvConfigLocal | KvConfigRedis;"],"additions":15,"deletions":1,"truncated":false},{"path":"packages/memory/test/docker-compose.yml","lines":["@@ -0,0 +1,12 @@","+services:","+  redis:","+    image: ${REDIS_IMAGE:-redis:6-alpine}","+    # Host port 0 lets Docker pick a free one, so the suite can't collide with a Redis the","+    # developer already has running. The mapping is read back with `docker compose port`","+    ports:","+      - '0:6379'","+    healthcheck:","+      test: ['CMD', 'redis-cli', 'ping']","+      interval: 1s","+      timeout: 3s","+      retries: 30"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/memory/test/global-setup.ts","lines":["@@ -0,0 +1,51 @@","+import { execFile } from 'node:child_process';","+import { dirname, join } from 'node:path';","+import { fileURLToPath } from 'node:url';","+import { promisify } from 'node:util';","+import type { TestProject } from 'vitest/node';","+","+const exec = promisify(execFile);","+","+const COMPOSE_FILE = join(dirname(fileURLToPath(import.meta.url)), 'docker-compose.yml');","+","+/** Suffixed with the image so that switching `REDIS_IMAGE` doesn't reuse the previous container */","+const PROJECT = `directus-memory-test-${(process.env['REDIS_IMAGE'] ?? 'redis:6-alpine').replace(/[^a-z0-9]/gi, '-')}`;","+","+const compose = (...args: string[]) => exec('docker', ['compose', '-p', PROJECT, '-f', COMPOSE_FILE, ...args]);","+","+/** Set to reuse an already running Redis (e.g. a CI service container) instead of spinning one up */","+const externalPort = process.env['REDIS_TEST_PORT'];","+","+export async function setup(project: TestProject) {","+\tif (externalPort) {","+\t\tproject.provide('redisPort', Number(externalPort));","+\t\treturn;","+\t}","+","+\ttry {","+\t\tawait exec('docker', ['ps']);","+\t} catch {","+\t\tthrow new Error(","+\t\t\t'These tests need Docker to spin up Redis. Start Docker, or point REDIS_TEST_PORT at a running instance.',","+\t\t);","+\t}","+","+\tawait compose('up', '-d', '--wait');","+","+\t// Resolves to `0.0.0.0:<port>`, with a line per address family","+\tconst { stdout } = await compose('port', 'redis', '6379');","+\tconst mapping = stdout.trim().split('\\n')[0];","+\tconst port = Number(mapping?.split(':').pop());","+","+\tif (!port) {","+\t\tthrow new Error(`Could not determine the mapped Redis port from \"${stdout.trim()}\"`);","+\t}","+","+\tproject.provide('redisPort', port);","+}","+","+export async function teardown() {","+\tif (externalPort) return;","+","+\tawait compose('down', '-v');","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"packages/memory/test/redis.test.ts","lines":["@@ -0,0 +1,521 @@","+import { Redis } from 'ioredis';","+import { afterAll, beforeAll, describe, expect, inject, test } from 'vitest';","+import { CLEAR_SCAN_COUNT, KvRedis } from '../src/kv/lib/redis.js';","+","+/**","+ * Exercises `KvRedis` against the Redis instance spun up by `test/global-setup.ts`, as the unit","+ * tests can only assert which commands are handed to ioredis, not that the resulting layout,","+ * expiry and locking behave the way they're expected to","+ */","+","+let redis: Redis;","+let namespaceCount = 0;","+","+/** Each test gets its own namespace so nothing has to be flushed between them */","+const uniqueNamespace = () => `kv-test-${process.pid}-${namespaceCount++}`;","+","+const createKv = (config: { namespace: string; hash: boolean; ttl?: number; compressionMinSize?: number }) =>","+\tnew KvRedis({ redis, compression: true, ...config });","+","+beforeAll(async () => {","+\tredis = new Redis({ host: '127.0.0.1', port: inject('redisPort') });","+\tawait redis.ping();","+});","+","+afterAll(async () => {","+\tawait redis.quit();","+});","+","+test('Runs against the expected Redis', async () => {","+\tconst info = await redis.info('server');","+\texpect(info).toMatch(/redis_version:/);","+});","+","+describe.each([","+\t{ label: 'namespaced keys', hash: false },","+\t{ label: 'namespace hash', hash: true },","+])('$label', ({ hash }) => {","+\tdescribe('get / set', () => {","+\t\ttest.each([","+\t\t\t{ label: 'object', value: { a: 1, b: 'two', c: [3, null] } },","+\t\t\t{ label: 'array', value: [1, 'two', { three: true }] },","+\t\t\t{ label: 'string', value: 'hello' },","+\t\t\t{ label: 'number', value: 42 },","+\t\t\t{ label: 'negative number', value: -7.5 },","+\t\t\t{ label: 'boolean', value: true },","+\t\t\t{ label: 'null', value: null },","+\t\t\t{ label: 'empty object', value: {} },","+\t\t])('Round-trips a $label', async ({ value }) => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait kv.set('key', value);","+","+\t\t\texpect(await kv.get('key')).toStrictEqual(value);","+\t\t});","+","+\t\ttest('Returns undefined for a key that was never set', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\texpect(await kv.get('missing')).toBe(undefined);","+\t\t});","+","+\t\ttest('Overwrites an existing value', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait kv.set('key', 'first');","+\t\t\tawait kv.set('key', 'second');","+","+\t\t\texpect(await kv.get('key')).toBe('second');","+\t\t});","+","+\t\ttest('Round-trips a value large enough to be compressed', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash, compressionMinSize: 100 });","+\t\t\tconst value = { blob: 'a'.repeat(5000) };","+","+\t\t\tawait kv.set('key', value);","+","+\t\t\texpect(await kv.get('key')).toStrictEqual(value);","+\t\t});","+","+\t\ttest('Actually gzips values over the compression threshold', async () => {","+\t\t\tconst namespace = uniqueNamespace();","+\t\t\tconst kv = createKv({ namespace, hash, compressionMinSize: 100 });","+","+\t\t\tawait kv.set('big', { blob: 'a'.repeat(5000) });","+\t\t\tawait kv.set('small', { blob: 'a' });","+","+\t\t\tconst big = hash ? await redis.hgetBuffer(namespace, 'big') : await redis.getBuffer(`${namespace}:big`);","+\t\t\tconst small = hash ? await redis.hgetBuffer(namespace, 'small') : await redis.getBuffer(`${namespace}:small`);","+","+\t\t\t// Gzip magic number","+\t\t\texpect(big?.subarray(0, 3)).toStrictEqual(Buffer.from([0x1f, 0x8b, 0x08]));","+\t\t\texpect(small?.subarray(0, 3)).not.toStrictEqual(Buffer.from([0x1f, 0x8b, 0x08]));","+\t\t});","+","+\t\ttest('Is visible to a second instance on the same namespace', async () => {","+\t\t\tconst namespace = uniqueNamespace();","+\t\t\tconst writer = createKv({ namespace, hash });","+\t\t\tconst reader = createKv({ namespace, hash });","+","+\t\t\tawait writer.set('key', { shared: true });","+","+\t\t\texpect(await reader.get('key')).toStrictEqual({ shared: true });","+\t\t});","+","+\t\ttest('Is isolated from another namespace', async () => {","+\t\t\tconst other = createKv({ namespace: uniqueNamespace(), hash });","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait kv.set('key', 'mine');","+","+\t\t\texpect(await other.get('key')).toBe(undefined);","+\t\t});","+\t});","+","+\tdescribe('has / delete', () => {","+\t\ttest('Reports whether a key exists', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\texpect(await kv.has('key')).toBe(false);","+","+\t\t\tawait kv.set('key', 'value');","+\t\t\texpect(await kv.has('key')).toBe(true);","+","+\t\t\tawait kv.delete('key');","+\t\t\texpect(await kv.has('key')).toBe(false);","+\t\t\texpect(await kv.get('key')).toBe(undefined);","+\t\t});","+","+\t\ttest('Deleting a missing key is a no-op', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait expect(kv.delete('missing')).resolves.not.toThrow();","+\t\t});","+","+\t\ttest('Deleting one key leaves the others alone', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait kv.set('a', 1);","+\t\t\tawait kv.set('b', 2);","+\t\t\tawait kv.delete('a');","+","+\t\t\texpect(await kv.has('a')).toBe(false);","+\t\t\texpect(await kv.get('b')).toBe(2);","+\t\t});","+\t});","+","+\tdescribe('increment', () => {","+\t\ttest('Counts up from zero', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\texpect(await kv.increment('count')).toBe(1);","+\t\t\texpect(await kv.increment('count')).toBe(2);","+\t\t\texpect(await kv.increment('count', 5)).toBe(7);","+\t\t\texpect(await kv.increment('count', -3)).toBe(4);","+\t\t});","+","+\t\ttest('Increments a value written through set, and stays readable through get', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait kv.set('count', 10);","+","+\t\t\texpect(await kv.increment('count')).toBe(11);","+\t\t\texpect(await kv.get('count')).toBe(11);","+\t\t});","+","+\t\ttest('Stays consistent under concurrent increments', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait Promise.all(Array.from({ length: 50 }, () => kv.increment('count')));","+","+\t\t\texpect(await kv.get('count')).toBe(50);","+\t\t});","+\t});","+","+\tdescribe('setMax', () => {","+\t\ttest('Writes when no value exists yet', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\texpect(await kv.setMax('max', 10)).toBe(true);","+\t\t\texpect(await kv.get('max')).toBe(10);","+\t\t});","+","+\t\ttest('Only writes strictly larger values', async () => {","+\t\t\tconst kv = createKv({ namespace: uniqueNamespace(), hash });","+","+\t\t\tawait kv.setMax('max', 10);","+","+\t\t\texpect(await kv.setMax('max', 5)).toBe(false);","+\t\t\texpect(await kv.setMax('max', 10)).toBe(false);","+\t\t\texpect(await kv.get('max')).toBe(10);","+","+\t\t\texpect(await kv.setMax('max', 11)).toBe(true);"],"additions":192,"deletions":0,"truncated":false}],"additions":664,"deletions":30,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-01T14:59:36.923055+00:00"}