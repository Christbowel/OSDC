 local ttl = tonumber(ARGV[3])","+","+  local oldValue = redis.call('HGET', hash, field)","+","+  if oldValue and value <= tonumber(oldValue) then","+    return 0","+  end","+","+  redis.call('HSET', hash, field, value)","+","+  if ttl > 0 then","+    redis.call('PEXPIRE', hash, ttl)","+  end","+","+  return 1"," `;"," "," const RELEASE_SCRIPT = `","@@ -45,6 +76,7 @@ export class KvRedis implements Kv {"," \tprivate lockTimeout: number;"," \tprivate redlock;"," \tprivate ttl: number | undefined;","+\tprivate hash: boolean;"," "," \tconstructor(config: Omit<KvConfigRedis, 'type'>) {"," \t\tif ('setMax' in config.redis === false) {","@@ -54,6 +86,13 @@ export class KvRedis implements Kv {"," \t\t\t});"," \t\t}"," ","+\t\tif ('setMaxField' in config.redis === false) {","+\t\t\tconfig.redis.defineCommand('setMaxField', {","+\t\t\t\tnumberOfKeys: 1,","+\t\t\t\tlua: SET_MAX_FIELD_SCRIPT,","+\t\t\t});","+\t\t}","+"," \t\tif ('release' in config.redis === false) {"," \t\t\tconfig.redis.defineCommand('release', {"," \t\t\t\tnumberOfKeys: 1,","@@ -66,6 +105,7 @@ export class KvRedis implements Kv {"," \t\tthis.compression = config.compression ?? true;"," \t\tthis.compressionMinSize = config.compressionMinSize ?? 1000;"," \t\tthis.lockTimeout = config.lockTimeout ?? 5000;","+\t\tthis.hash = config.hash ?? false;"," "," \t\tthis.redlock = new Redlock([this.redis], {"," \t\t\tretryDelay: 50,","@@ -78,7 +118,9 @@ export class KvRedis implements Kv {"," \t}"," "," \tasync get<T = unknown>(key: string): Promise<T | undefined> {","-\t\tconst value = await this.redis.getBuffer(withNamespace(key, this.namespace));","+\t\tconst value = this.hash","+\t\t\t? await this.redis.hgetBuffer(this.namespace, key)","+\t\t\t: await this.redis.getBuffer(withNamespace(key, this.namespace));"," "," \t\tif (value === null) {"," \t\t\treturn undefined;","@@ -95,41 +137,59 @@ export class KvRedis implements Kv {"," "," \tasync set<T = unknown>(key: string, value: T): Promise<void> {"," \t\tif (typeof v