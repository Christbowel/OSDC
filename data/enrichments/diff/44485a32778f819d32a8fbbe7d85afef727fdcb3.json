{"id":"44485a32778f819d32a8fbbe7d85afef727fdcb3","axis":"silent","repo":"TYPO3/typo3","sha":"44485a32778f819d32a8fbbe7d85afef727fdcb3","parsed":{"files":[{"path":"typo3/sysext/core/Classes/Domain/Page.php","lines":["@@ -19,10 +19,12 @@"," "," use TYPO3\\CMS\\Core\\Domain\\Exception\\RecordPropertyNotFoundException;"," use TYPO3\\CMS\\Core\\Domain\\Record\\ComputedProperties;","+use TYPO3\\CMS\\Core\\Domain\\Record\\PagePermissions;"," use TYPO3\\CMS\\Core\\Domain\\Record\\SystemProperties;"," "," /**","- * @internal not part of public API, as this needs to be streamlined and proven","+ * Represents a page record, including the workspace and language overlay information","+ * of the context it was retrieved in.","  */"," class Page extends Record implements \\ArrayAccess"," {","@@ -100,6 +102,14 @@ public function getRequestedLanguage(): ?int","         return $this->specialProperties['_REQUESTED_OVERLAY_LANGUAGE'] ?? null;","     }"," ","+    /**","+     * Returns null if the page was retrieved without its permission fields.","+     */","+    public function getPermissions(): ?PagePermissions","+    {","+        return PagePermissions::fromRecord($this->rawRecord->toArray());","+    }","+","     public function toArray(bool $includeSystemProperties = false): array","     {","         if ($includeSystemProperties) {"],"additions":11,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/RawRecord.php","lines":["@@ -22,8 +22,6 @@"," "," /**","  * Holds all properties of a raw database row with unfiltered and unprocessed values.","- *","- * @internal not part of public API, as this needs to be streamlined and proven","  */"," readonly class RawRecord implements RecordInterface"," {"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Record.php","lines":["@@ -26,8 +26,6 @@"," "," /**","  * Represents a record with all properties valid for this record type.","- *","- * @internal not part of public API, as this needs to be streamlined and proven","  */"," class Record implements RecordInterface"," {"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Record/ComputedProperties.php","lines":["@@ -21,8 +21,6 @@"," "," /**","  * Contains all information about computed properties for the current context.","- *","- * @internal not part of public API, as this needs to be streamlined and proven","  */"," readonly class ComputedProperties"," {"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Record/LanguageInfo.php","lines":["@@ -19,8 +19,6 @@"," "," /**","  * Contains all information about language for a language-aware record.","- *","- * @internal not part of public API, as this needs to be streamlined and proven","  */"," readonly class LanguageInfo"," {"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Record/PagePermissions.php","lines":["@@ -0,0 +1,85 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Domain\\Record;","+","+use TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission;","+","+/**","+ * Contains the permission settings stored in a page record: the owning backend","+ * user and group, and what the owner, the group and everybody else may do.","+ *","+ * These settings are the same for every backend user. Whether a specific backend","+ * user is granted a permission also depends on the user being an administrator","+ * and on the groups the user is member of.","+ */","+final readonly class PagePermissions","+{","+    private const array FIELDS = ['perms_userid', 'perms_groupid', 'perms_user', 'perms_group', 'perms_everybody'];","+","+    public function __construct(","+        private int $ownerUserId,","+        private int $ownerGroupId,","+        private int $ownerPermissions,","+        private int $groupPermissions,","+        private int $everybodyPermissions,","+    ) {}","+","+    /**","+     * Returns null if the record does not contain all permission fields.","+     */","+    public static function fromRecord(array $record): ?self","+    {","+        foreach (self::FIELDS as $field) {","+            if (!array_key_exists($field, $record)) {","+                return null;","+            }","+        }","+        return new self(","+            (int)$record['perms_userid'],","+            (int)$record['perms_groupid'],","+            (int)$record['perms_user'],","+            (int)$record['perms_group'],","+            (int)$record['perms_everybody'],","+        );","+    }","+","+    public function getOwnerUserId(): int","+    {","+        return $this->ownerUserId;","+    }","+","+    public function getOwnerGroupId(): int","+    {","+        return $this->ownerGroupId;","+    }","+","+    public function getOwnerPermissions(): Permission","+    {","+        return new Permission($this->ownerPermissions);","+    }","+","+    public function getGroupPermissions(): Permission","+    {","+        return new Permission($this->groupPermissions);","+    }","+","+    public function getEverybodyPermissions(): Permission","+    {","+        return new Permission($this->everybodyPermissions);","+    }","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Record/SystemProperties.php","lines":["@@ -19,8 +19,6 @@"," "," /**","  * Contains all information about system-related properties for the current record.","- *","- * @internal not part of public API, as this needs to be streamlined and proven","  */"," readonly class SystemProperties"," {"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Record/VersionInfo.php","lines":["@@ -21,8 +21,6 @@"," "," /**","  * Contains all information about versioning for a workspace-aware record.","- *","- * @internal not part of public API, as this needs to be streamlined and proven","  */"," readonly class VersionInfo"," {"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/RecordFactory.php","lines":["@@ -51,8 +51,6 @@","  * - a DateTime field.","  *","  * This means that the field value of a \"Resolved Record\" is expanded to the actual types (Date objects etc.)","- *","- * @internal not part of TYPO3 Core API yet.","  */"," #[Autoconfigure(public: true)]"," readonly class RecordFactory"],"additions":0,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Feature-111301-DeclareRecordAPIPublicAndExposePagePermissionSettings.rst","lines":["@@ -0,0 +1,72 @@","+..  include:: /Includes.rst.txt","+","+..  _feature-111301-1793444414:","+","+================================================================================","+Feature: #111301 - Declare Record API public and expose page permission settings","+================================================================================","+","+See :issue:`111301`","+","+Description","+===========","+","+Record API","+----------","+","+The objects representing database records, introduced with TYPO3 v13, are","+now part of the public TYPO3 Core API:","+","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\Record`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\RawRecord`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\Page`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\Record\\ComputedProperties`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\Record\\SystemProperties`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\Record\\LanguageInfo`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\Record\\VersionInfo`","+*   :php:`\\TYPO3\\CMS\\Core\\Domain\\RecordFactory`, which creates these objects","+","+These objects were already handed out by public API, for example by","+:php:`\\TYPO3\\CMS\\Core\\Domain\\RecordInterface::getRawRecord()`, by the","+:php-short:`\\TYPO3\\CMS\\Core\\Domain\\Event\\BeforePageIsRetrievedEvent` or","+by the `record-transformation` data processor in Fluid templates.","+","+Page permission settings","+------------------------","+","+The new method :php:`\\TYPO3\\CMS\\Core\\Domain\\Page::getPermissions()`","+returns the permission settings of a page as an immutable value object","+:php:`\\TYPO3\\CMS\\Core\\Domain\\Record\\PagePermissions`:","+","+*   :php:`getOwnerUserId()` and :php:`getOwnerGroupId()` return the owning","+    backend user and backend user group.","+*   :php:`getOwnerPermissions()`, :php:`getGroupPermissions()` and","+    :php:`getEverybodyPermissions()` return a","+    :php-short:`\\TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission` object each.","+","+The permission fields are not part of the TCA of the `pages` table, so they","+are not available as regular properties of a :php-short:`\\TYPO3\\CMS\\Core\\Domain\\Page`","+object. :php:`getPermissions()` reads them from the raw database row and","+returns :php:`null` if the page was retrieved without them.","+","+The settings are the same for every backend user. Whether a specific backend","+user is granted a permission is still determined by","+:php:`\\TYPO3\\CMS\\Core\\Authentication\\BackendUserAuthentication`.","+","+..  code-block:: php","+    :caption: Check whether everybody may view a page","+","+    $permissions = $page->getPermissions();","+    if ($permissions?->getEverybodyPermissions()->showPagePermissionIsGranted()) {","+        // ...","+    }","+","+Impact","+======","+","+Extensions can type against the record objects and rely on them following","+the regular deprecation policy of the TYPO3 Core. The permission settings of","+a page are available in a typed way, without reading the `perms_*` fields of","+the database row.","+","+..  index:: PHP-API, ext:core"],"additions":72,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Domain/RecordFactoryTest.php","lines":["@@ -56,6 +56,16 @@ public function uidAndPidPropertiesAreAccessible(): void","         self::assertSame(0, $result->get('pid'));","     }"," ","+    #[Test]","+    public function pagePermissionsAreAvailableFromRawRecord(): void","+    {","+        $dbRow = BackendUtility::getRecord('pages', 1);","+        $result = $this->get(RecordFactory::class)->createFromDatabaseRow('pages', $dbRow);","+        self::assertInstanceOf(Page::class, $result);","+        self::assertFalse($result->has('perms_everybody'));","+        self::assertSame(15, $result->getPermissions()->getEverybodyPermissions()->__toInt());","+    }","+","     #[Test]","     public function typesAreResolvedProperlyForPageRecord(): void","     {"],"additions":10,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Unit/Domain/Record/PagePermissionsTest.php","lines":["@@ -0,0 +1,78 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Tests\\Unit\\Domain\\Record;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\Domain\\Page;","+use TYPO3\\CMS\\Core\\Domain\\Record\\PagePermissions;","+use TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission;","+use TYPO3\\TestingFramework\\Core\\Unit\\UnitTestCase;","+","+final class PagePermissionsTest extends UnitTestCase","+{","+    private const array PAGE_ROW = [","+        'uid' => 3,","+        'pid' => 1,","+        'doktype' => 1,","+        'perms_userid' => 7,","+        'perms_groupid' => '4',","+        'perms_user' => Permission::ALL,","+        'perms_group' => Permission::PAGE_SHOW | Permission::CONTENT_EDIT,","+        'perms_everybody' => Permission::NOTHING,","+    ];","+","+    #[Test]","+    public function fromRecordReadsPermissionFields(): void","+    {","+        $subject = PagePermissions::fromRecord(self::PAGE_ROW);","+        self::assertSame(7, $subject->getOwnerUserId());","+        self::assertSame(4, $subject->getOwnerGroupId());","+        self::assertSame(Permission::ALL, $subject->getOwnerPermissions()->__toInt());","+        self::assertTrue($subject->getGroupPermissions()->editContentPermissionIsGranted());","+        self::assertFalse($subject->getGroupPermissions()->editPagePermissionIsGranted());","+        self::assertTrue($subject->getEverybodyPermissions()->nothingIsGranted());","+    }","+","+    #[Test]","+    public function fromRecordReturnsNullIfAPermissionFieldIsMissing(): void","+    {","+        $row = self::PAGE_ROW;","+        unset($row['perms_everybody']);","+        self::assertNull(PagePermissions::fromRecord($row));","+    }","+","+    #[Test]","+    public function returnedPermissionsDoNotChangeTheSettings(): void","+    {","+        $subject = PagePermissions::fromRecord(self::PAGE_ROW);","+        $subject->getEverybodyPermissions()->set(Permission::PAGE_SHOW);","+        self::assertTrue($subject->getEverybodyPermissions()->nothingIsGranted());","+    }","+","+    #[Test]","+    public function pageReturnsPermissions(): void","+    {","+        self::assertEquals(PagePermissions::fromRecord(self::PAGE_ROW), new Page(self::PAGE_ROW)->getPermissions());","+    }","+","+    #[Test]","+    public function pageWithoutPermissionFieldsReturnsNull(): void","+    {","+        self::assertNull(new Page(['uid' => 3, 'pid' => 1, 'doktype' => 1])->getPermissions());","+    }","+}",""],"additions":78,"deletions":0,"truncated":false}],"additions":256,"deletions":15,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-01T15:16:32.530811+00:00"}