{"id":"038606d60475ba892a80e71f4dd8d28049176ece","axis":"silent","repo":"pnpm/pnpm","sha":"038606d60475ba892a80e71f4dd8d28049176ece","parsed":{"files":[{"path":".changeset/pnpm-config-home.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+Set `PNPM_CONFIG_HOME` to choose the directory containing `config.yaml` and `auth.ini`. Global configuration commands read and write files in this directory. A non-empty value takes precedence over `XDG_CONFIG_HOME` and the platform defaults."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/config_home.rs","lines":["@@ -0,0 +1,75 @@","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::{bin::CommandTempCwd, command_env::CommandTestExt};","+use pretty_assertions::assert_eq;","+use std::{fs, process::Command};","+","+#[test]","+fn pnpm_config_home_routes_global_reads_writes_and_deletes() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let config_home = root.path().join(\"custom-config\");","+    let xdg_home = root.path().join(\"xdg-config\");","+    fs::create_dir_all(xdg_home.join(\"pnpm\")).unwrap();","+    fs::write(xdg_home.join(\"pnpm/config.yaml\"), \"fetchRetries: 3\\n\").unwrap();","+    let command = || {","+        Command::cargo_bin(\"pnpm\")","+            .unwrap()","+            .with_current_dir(&workspace)","+            .without_ambient_pnpm_config()","+            .with_env(\"PNPM_CONFIG_HOME\", &config_home)","+            .with_env(\"XDG_CONFIG_HOME\", &xdg_home)","+    };","+    command()","+        .with_args([\"config\", \"set\", \"--global\", \"fetch-retries\", \"7\"])","+        .assert()","+        .success();","+    command()","+        .with_args([\"config\", \"get\", \"fetch-retries\"])","+        .assert()","+        .success()","+        .stdout(\"7\\n\");","+    command()","+        .with_args([\"config\", \"get\", \"globalconfig\"])","+        .assert()","+        .success()","+        .stdout(format!(\"{}\\n\", config_home.join(\"config.yaml\").display()));","+    command()","+        .with_args([","+            \"config\",","+            \"set\",","+            \"--global\",","+            \"//registry.example.test/:_authToken\",","+            \"test-token\",","+        ])","+        .assert()","+        .success();","+    command()","+        .with_args([\"config\", \"get\", \"//registry.example.test/:_authToken\"])","+        .assert()","+        .success()","+        .stdout(\"test-token\\n\");","+    assert!(fs::read_to_string(config_home.join(\"auth.ini\")).unwrap().contains(\"test-token\"));","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"fetchRetries: 8\\n\").unwrap();","+    command()","+        .with_args([\"config\", \"get\", \"fetch-retries\"])","+        .assert()","+        .success()","+        .stdout(\"8\\n\");","+    command()","+        .with_env(\"PNPM_CONFIG_FETCH_RETRIES\", \"9\")","+        .with_args([\"config\", \"get\", \"fetch-retries\"])","+        .assert()","+        .success()","+        .stdout(\"9\\n\");","+    fs::remove_file(workspace.join(\"pnpm-workspace.yaml\")).unwrap();","+    command()","+        .with_args([\"config\", \"delete\", \"--global\", \"fetch-retries\"])","+        .assert()","+        .success();","+    command()","+        .with_args([\"config\", \"get\", \"fetch-retries\"])","+        .assert()","+        .success()","+        .stdout(\"undefined\\n\");","+    assert_eq!(fs::read_to_string(xdg_home.join(\"pnpm/config.yaml\")).unwrap(), \"fetchRetries: 3\\n\");","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -40,6 +40,7 @@ mod completion;"," mod concurrency_groups;"," mod config_dependencies;"," mod config_get_set;","+mod config_home;"," mod config_includes;"," mod convergence_overrides;"," mod create;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/defaults.rs","lines":["@@ -170,6 +170,11 @@ pub fn default_config_dir<Sys>() -> Option<PathBuf>"," where","     Sys: EnvVar + GetHomeDir,"," {","+    if let Some(config_home) =","+        read_dir_env::<Sys>(\"PNPM_CONFIG_HOME\").filter(|value| !value.is_empty())","+    {","+        return Some(PathBuf::from(config_home));","+    }","     let xdg_config_home = read_dir_env::<Sys>(\"XDG_CONFIG_HOME\");","     let local_app_data = read_dir_env::<Sys>(\"LOCALAPPDATA\");","     pnpm_config_dir::config_dir("],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/defaults/tests.rs","lines":["@@ -522,3 +522,46 @@ fn the_install_command_matches_the_host_shell() {","     );","     assert_eq!(install_command_for(false), \"curl -fsSL https://get.pnpm.io/install.sh | sh -\");"," }","+","+#[test]","+fn pnpm_config_home_overrides_platform_config_directories() {","+    struct CustomConfigHome;","+    impl EnvVar for CustomConfigHome {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"PNPM_CONFIG_HOME\" => Some(\"/custom/config\".to_owned()),","+                \"XDG_CONFIG_HOME\" | \"LOCALAPPDATA\" => Some(\"/other/config\".to_owned()),","+                _ => None,","+            }","+        }","+    }","+    impl GetHomeDir for CustomConfigHome {","+        fn home_dir() -> Option<PathBuf> {","+            unreachable!(\"PNPM_CONFIG_HOME bypasses home directory lookup\")","+        }","+    }","+    assert_eq!(default_config_dir::<CustomConfigHome>(), Some(PathBuf::from(\"/custom/config\")));","+}","+","+#[test]","+fn empty_pnpm_config_home_falls_back_to_xdg() {","+    struct EmptyConfigHome;","+    impl EnvVar for EmptyConfigHome {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"PNPM_CONFIG_HOME\" => Some(String::new()),","+                \"XDG_CONFIG_HOME\" => Some(\"/other/config\".to_owned()),","+                _ => None,","+            }","+        }","+    }","+    impl GetHomeDir for EmptyConfigHome {","+        fn home_dir() -> Option<PathBuf> {","+            unreachable!(\"XDG_CONFIG_HOME bypasses home directory lookup\")","+        }","+    }","+    assert_eq!(","+        default_config_dir::<EmptyConfigHome>(),","+        Some(PathBuf::from(\"/other/config\").join(\"pnpm\")),","+    );","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/windows_path_env.rs","lines":["@@ -22,8 +22,6 @@ pub struct UnexpandedWindowsEnvVar {","     pub(crate) reference: String,"," }"," ","-const DIR_ENV_WITH_FALLBACK: &[&str] = &[\"XDG_CACHE_HOME\", \"XDG_CONFIG_HOME\", \"XDG_STATE_HOME\"];","-"," /// Reject directory environment variables that still contain `%VAR%` on Windows."," ///"," /// Precedence matches the directory resolvers: `XDG_DATA_HOME` is ignored","@@ -46,10 +44,18 @@ pub(crate) fn ensure_windows_dir_envs_on<Sys: EnvVar>(","     if os != \"windows\" {","         return Ok(());","     }","-    for name in DIR_ENV_WITH_FALLBACK {","+    let pnpm_config_home = Sys::var(\"PNPM_CONFIG_HOME\").unwrap_or_default();","+    let config_home =","+        if expand_dir_env(\"windows\", \"PNPM_CONFIG_HOME\", &pnpm_config_home, Sys::var)?.is_empty() {","+            \"XDG_CONFIG_HOME\"","+        } else {","+            \"PNPM_CONFIG_HOME\"","+        };","+    let dirs_with_fallback = [\"XDG_CACHE_HOME\", config_home, \"XDG_STATE_HOME\"];","+    for name in dirs_with_fallback {","         expand_if_set::<Sys>(name)?;","     }","-    if DIR_ENV_WITH_FALLBACK","+    if dirs_with_fallback","         .iter()","         .any(|name| Sys::var(name).is_none())","     {"],"additions":10,"deletions":4,"truncated":false},{"path":"pnpm/crates/config/src/windows_path_env/tests.rs","lines":["@@ -157,3 +157,56 @@ fn home_dir_check_rejects_an_unexpanded_local_app_data_fallback() {","     let error = ensure_windows_home_dir_env_on::<BadLocalAppData>(\"windows\").unwrap_err();","     assert_eq!(error.variable, \"LOCALAPPDATA\");"," }","+","+#[test]","+fn pnpm_config_home_rejects_unexpanded_windows_references() {","+    struct UnexpandedConfigHome;","+    impl EnvVar for UnexpandedConfigHome {","+        fn var(name: &str) -> Option<String> {","+            (name == \"PNPM_CONFIG_HOME\").then(|| r\"%MISSING%\\config\".to_owned())","+        }","+    }","+    let error = ensure_windows_dir_envs_on::<UnexpandedConfigHome>(\"windows\").unwrap_err();","+    assert_eq!(error.variable, \"PNPM_CONFIG_HOME\");","+    assert_eq!(error.reference, \"%MISSING%\");","+}","+","+#[test]","+fn pnpm_config_home_bypasses_unused_windows_config_fallbacks() {","+    struct ExpandedConfigHome;","+    impl EnvVar for ExpandedConfigHome {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"PNPM_CONFIG_HOME\" => Some(r\"%ROOT%\\config\".to_owned()),","+                \"ROOT\" | \"PNPM_HOME\" | \"XDG_CACHE_HOME\" | \"XDG_STATE_HOME\" => {","+                    Some(r\"C:\\tools\".to_owned())","+                }","+                \"XDG_CONFIG_HOME\" | \"LOCALAPPDATA\" => Some(r\"%MISSING%\\config\".to_owned()),","+                _ => None,","+            }","+        }","+    }","+    ensure_windows_dir_envs_on::<ExpandedConfigHome>(\"windows\").unwrap();","+    assert_eq!(","+        expand_dir_env(\"windows\", \"PNPM_CONFIG_HOME\", r\"%ROOT%\\config\", ExpandedConfigHome::var)","+            .unwrap(),","+        r\"C:\\tools\\config\",","+    );","+}","+","+#[test]","+fn empty_expanded_pnpm_config_home_validates_the_xdg_fallback() {","+    struct EmptyConfigHome;","+    impl EnvVar for EmptyConfigHome {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"PNPM_CONFIG_HOME\" => Some(\"%EMPTY%\".to_owned()),","+                \"EMPTY\" => Some(String::new()),","+                \"XDG_CONFIG_HOME\" => Some(r\"%MISSING%\\config\".to_owned()),","+                _ => None,","+            }","+        }","+    }","+    let error = ensure_windows_dir_envs_on::<EmptyConfigHome>(\"windows\").unwrap_err();","+    assert_eq!(error.variable, \"XDG_CONFIG_HOME\");","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"pnpm/docs/cli/config.md","lines":["@@ -10,7 +10,7 @@ Manage the configuration files."," pnpm settings are split across two kinds of configuration files:"," "," * **Legacy and npm-compatible registry/authentication settings** live in INI","-  files: the global `rc` file, `auth.ini`, and local `.npmrc` files.","+  files: the global `auth.ini` file and local `.npmrc` files."," * **pnpm settings** live in YAML files: the global `config.yaml` and the","   per-project `pnpm-workspace.yaml`. The global file may also hold the","   structured [`_auth`](../npmrc.md#_auth) and [`registries`](../registries.md)","@@ -18,17 +18,13 @@ pnpm settings are split across two kinds of configuration files:"," "," The local workspace configuration file is located at the root of the project and is named `pnpm-workspace.yaml`. The global YAML configuration file (`config.yaml`) is located at:"," ","-* If the **$XDG_CONFIG_HOME** env variable is set, then **$XDG_CONFIG_HOME/pnpm/config.yaml**","+* If **$PNPM_CONFIG_HOME** is non-empty, then **$PNPM_CONFIG_HOME/config.yaml**","+* Otherwise, if the **$XDG_CONFIG_HOME** env variable is set, then **$XDG_CONFIG_HOME/pnpm/config.yaml**"," * On Windows: **~/AppData/Local/pnpm/config/config.yaml**"," * On macOS: **~/Library/Preferences/pnpm/config.yaml**"," * On Linux: **~/.config/pnpm/config.yaml**"," ","-The global `rc` file (registry/auth settings only) is at:","-","-* If the **$XDG_CONFIG_HOME** env variable is set, then **$XDG_CONFIG_HOME/pnpm/rc**","-* On Windows: **~/AppData/Local/pnpm/config/rc**","-* On macOS: **~/Library/Preferences/pnpm/rc**","-* On Linux: **~/.config/pnpm/rc**","+The global `auth.ini` file uses the same directory. See [Auth file locations](../npmrc.md#auth-file-locations)."," "," You can also retrieve the path to your global config file by running:"," "],"additions":4,"deletions":8,"truncated":false},{"path":"pnpm/docs/configuring.md","lines":["@@ -25,11 +25,14 @@ saveExact: true"," "," The global YAML config file (`config.yaml`) is located at one of the following paths:"," ","-* If the **$XDG_CONFIG_HOME** env variable is set, then **$XDG_CONFIG_HOME/pnpm/config.yaml**","+* If **$PNPM_CONFIG_HOME** is non-empty, then **$PNPM_CONFIG_HOME/config.yaml**","+* Otherwise, if the **$XDG_CONFIG_HOME** env variable is set, then **$XDG_CONFIG_HOME/pnpm/config.yaml**"," * On Windows: **%LOCALAPPDATA%\\pnpm\\config\\config.yaml**"," * On macOS: **~/Library/Preferences/pnpm/config.yaml**"," * On Linux: **~/.config/pnpm/config.yaml**"," ","+`PNPM_CONFIG_HOME` selects the directory containing `config.yaml` and `auth.ini`. pnpm uses it directly, without appending `pnpm`. An empty value uses the default locations above. This also controls where global configuration commands, `pnpm login`, and `pnpm logout` write.","+"," Not every setting may be set in the global `config.yaml`. Settings that apply to the whole machine, such as `storeDir`, `cacheDir`, `packageImportMethod`, `minimumReleaseAge`, and network settings, may be set there. Settings that define the structure of a project's `node_modules` or workspace, such as `nodeLinker`, `hoistPattern`, `publicHoistPattern`, `shamefullyHoist`, or `linkWorkspacePackages`, are project-only: they have to be set in `pnpm-workspace.yaml`, so that the project installs the same way on every machine. Registry routes may be set globally, but the server descriptions `serverType` and `supportsTimeField` are read only from `pnpm-workspace.yaml` (see [Registries](./registries.md#where-the-setting-may-live))."," "," `pnpm config set --global` refuses project-only settings with `ERR_PNPM_CONFIG_SET_UNSUPPORTED_YAML_CONFIG_KEY`. If they are written to `config.yaml` by hand, pnpm prints a warning that names them and ignores them."],"additions":4,"deletions":1,"truncated":false},{"path":"pnpm/docs/npmrc.md","lines":["@@ -45,7 +45,8 @@ The global `<pnpm config>/config.yaml` holds the [`_auth`](#_auth) setting."," "," The `<pnpm config>` directory is:"," ","-* `$XDG_CONFIG_HOME/pnpm/`, if `XDG_CONFIG_HOME` is set","+* `$PNPM_CONFIG_HOME/`, if `PNPM_CONFIG_HOME` is non-empty","+* Otherwise, `$XDG_CONFIG_HOME/pnpm/`, if `XDG_CONFIG_HOME` is set"," * `~/AppData/Local/pnpm/config/` on Windows"," * `~/Library/Preferences/pnpm/` on macOS"," * `~/.config/pnpm/` on Linux",""],"additions":2,"deletions":1,"truncated":false}],"additions":202,"deletions":14,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-20T17:58:14.923987+00:00"}