"-\t\t\t\t\t * enforces an HTTP(S) scheme and blocks private, local, and otherwise","-\t\t\t\t\t * disallowed hosts, guarding the sideload against SSRF.","-\t\t\t\t\t */","-\t\t\t\t\tif ( false === wp_http_validate_url( $url ) ) {","-\t\t\t\t\t\treturn new WP_Error(","-\t\t\t\t\t\t\t'rest_invalid_url',","-\t\t\t\t\t\t\t__( 'Invalid URL. Provide a valid, publicly reachable HTTP or HTTPS image URL.' ),","-\t\t\t\t\t\t\tarray( 'status' => 400 )","-\t\t\t\t\t\t);","-\t\t\t\t\t}","+\t\t$args['generate_sub_sizes'] = array(","+\t\t\t'type'        => 'boolean',","+\t\t\t'default'     => true,","+\t\t\t'description' => __( 'Whether to generate image sub sizes.' ),","+\t\t);"," ","-\t\t\t\t\treturn true;","-\t\t\t\t},","-\t\t\t);","-\t\t}","+\t\t$args['convert_format'] = array(","+\t\t\t'type'        => 'boolean',","+\t\t\t'default'     => true,","+\t\t\t'description' => __( 'Whether to convert image formats.' ),","+\t\t);","+","+\t\t$args['url'] = array(","+\t\t\t'type'              => 'string',","+\t\t\t'format'            => 'uri',","+\t\t\t'description'       => __( 'URL of an external image to sideload into the media library, instead of uploading a file.' ),","+\t\t\t'sanitize_callback' => 'sanitize_url',","+\t\t\t'validate_callback' => static function ( $url, $request, $param ) {","+\t\t\t\t/*","+\t\t\t\t * A custom validate_callback replaces the default","+\t\t\t\t * rest_validate_request_arg(), so re-apply it first to keep","+\t\t\t\t * the schema checks (string type, uri format) enforced.","+\t\t\t\t */","+\t\t\t\t$valid = rest_validate_request_arg( $url, $request, $param );","+\t\t\t\tif ( is_wp_error( $valid ) ) {","+\t\t\t\t\treturn $valid;","+\t\t\t\t}","+","+\t\t\t\t/*","+\t\t\t\t * Reject URLs that are not safe to request server-side. wp_http_validate_url()","+\t\t\t\t * enforces an HTTP(S) scheme and blocks private, local, and otherwise","+\t\t\t\t * disallowed hosts, guarding the sideload against SSRF.","+\t\t\t\t */","+\t\t\t\tif ( false === wp_http_validate_url( $url ) ) {","+\t\t\t\t\treturn new WP_Error(","+\t\t\t\t\t\t'rest_invalid_url',","+\t\t\t\t\t\t__( 'Invalid URL. Provide a valid, publicly reachable HTTP or HTTPS image URL.' ),","+\t\t\t\t\t\tarray( 'status' => 400 )","+\t\t\t\t\t);","+\t\t\t\t}","+","+\t\t\t\treturn true;","+\t\t\t},","+\t\t);"," "," \t\treturn $args;"," \t}","@@ -381,9 +385,15 @@ public function create_item_permissions_check( $request ) {"," \t\t */"," \t\t$prevent_unsupported_uploads = apply_filters( 'wp_prevent_unsupported_mime_type_uploads', true, $files['file']['type'] ?? null );"," ","-\t\t// When the client handles image processing (generate_sub_sizes is false),","-\t\t// skip the server-side image editor support check.","-\t\tif ( false === $request['generate_sub_sizes'] ) {","+\t\t/*","+\t\t * When the client handles image processing (generate_sub_sizes is false),","+\t\t * skip the server-side image editor support check. This check exists","+\t\t * because the server cannot process the image, so it is only relaxed when","+\t\t * client side media processing is enabled and something else can. Asking","+\t\t * to skip sub sizes on a site without it does not make an unsupported","+\t\t * image type any more usable.","+\t\t */","+\t\tif ( wp_is_client_side_media_processing_enabled() && false === $request['generate_sub_sizes'] ) {"," \t\t\t$prevent_unsupported_uploads = false;"," \t\t}"," "],"additions":55,"deletions":45,"truncated":false},{"path":"tests/phpunit/tests/rest-api/rest-attachments-controller.php","lines":["@@ -207,6 +207,18 @@ private function enable_client_side_media_processing(): void {"," \t\tdo_action( 'rest_api_init', $wp_rest_server );"," \t}"," ","+\t/**","+\t * Turns client-side media processing off and rebuilds the REST server so the","+\t * routes are registered with the feature disabled.","+\t */","+\tprivate function disable_client_side_media_processing(): void {","+\t\tadd_filter( 'wp_client_side_media_processing_enabled', '__return_false' );","+","+\t\tglobal $wp_rest_server;","+\t\t$wp_rest_server = new Spy_REST_Server();","+\t\tdo_action( 'rest_api_init', $wp_rest_server );","+\t}","+"," \tpublic function test_register_routes() {"," \t\t$routes = rest_get_server()->get_routes();"," \t\t$this->assertArrayHasKey( '/wp/v2/media', $routes );","@@ -3412,9 +3424,16 @@ public function test_upload_unsupported_image_type_with_filter() {"," \t * Tests the permissions check directly with file params set, since the core"," \t * check uses get_file_params() which is only populated for multipart uploads."," \t *","+\t * The check is only relaxed when client-side media processing is enabled,","+\t * since that is what makes the client able to handle the image, so the","+\t * feature is enabled here.","+\t *"," \t * @ticket 64836","+\t * @ticket 65517"," \t */"," \tpublic function test_upload_unsupported_image_type_skipped_when_not_generating_sub_sizes() {","+\t\t$this->enable_client_side_media_processing();","+"," \t\twp_set_current_user( self::$author_id );"," "," \t\tadd_filter( 'wp_image_editors', '__return_empty_array' );","@@ -5830,6 +5849,166 @@ public function test_url_registered_as_creatable_arg() {"," \t\t$this->assertSame( 'uri', $creatable['args']['url']['format'] );"," \t}"," ","+\t/**","+\t * Verifies that the media creation arguments are registered even when","+\t * client-side media processing is disabled.","+\t *","+\t * The feature is determined per request, from the scheme and host, so gating","+\t * the schema on it would advertise different arguments for the same site","+\t * depending on how it was reached.","+\t *","+\t * @ticket 65517","+\t *","+\t * @covers WP_REST_Attachments_Controller::get_endpoint_args_for_item_schema","+\t */","+\tpublic function test_creatable_args_registered_without_client_side_media_processing() {","+\t\t$this->disable_client_side_media_processing();","+","+\t\t$routes    = rest_get_server()->get_routes();","+\t\t$creatable = null;","+\t\tforeach ( $routes['/wp/v2/media'] as $route ) {","+\t\t\tif ( ! empty( $route['methods'][ WP_REST_Server::CREATABLE ] ) ) {","+\t\t\t\t$creatable = $route;","+\t\t\t\tbreak;","+\t\t\t}","+\t\t}","+","+\t\t$this->assertNotNull( $creatable, 'The media route should register a CREATABLE handler.' );","+\t\t$this->assertArrayHasKey( 'url', $creatable['args'] );","+\t\t$this->assertArrayHasKey( 'generate_sub_sizes', $creatable['args'] );","+\t\t$this->assertArrayHasKey( 'convert_format', $creatable['args'] );","+\t}","+","+\t/**","+\t * Verifies that sideloading an external image works when client-side media","+\t * processing is disabled.","+\t *","+\t * @ticket 65517","+\t *","+\t * @covers WP_REST_Attachments_Controller::create_item","+\t * @covers WP_REST_Attachments_Controller::create_item_from_url","+\t */","+\tpublic function test_create_item_from_url_without_client_side_media_processing() {","+\t\t$this->disable_client_side_media_processing();","+","+\t\twp_set_current_user( self::$superadmin_id );","+","+\t\tadd_filter( 'pre_http_request', array( $this, 'mock_image_download' ), 10, 3 );","+","+\t\t$request = new WP_REST_Request( 'POST', '/wp/v2/media' );","+\t\t$request->set_param( 'url', 'https://example.com/photo.jpg' );","+","+\t\t$response = rest_get_server()->dispatch( $request );","+","+\t\tremove_filter( 'pre_http_request', array( $this, 'mock_image_download' ), 10 );","+","+\t\t$data = $response->get_data();","+","+\t\t$this->assertSame( 201, $response->get_status() );","+\t\t$this->assertSame( 'image', $data['media_type'] );","+\t\t$this->assertSame( 'https://example.com/photo.jpg', $this->last_download_url );","+\t}","+","+\t/**","+\t * Verifies that the `url` argument's validation runs when client-side media","+\t * processing is disabled, so an unsafe URL is rejected with a 400 rather than","+\t * reaching the download.","+\t *","+\t * @ticket 65517","+\t *","+\t * @covers WP_REST_Attachments_Controller::get_endpoint_args_for_item_schema","+\t */","+\tpublic function test_url_arg_rejects_unsafe_urls_without_client_side_media_processing() {","+\t\t$this->disable_client_side_media_processing();","+","+\t\twp_set_current_user( self::$superadmin_id );","+","+\t\t$request = new WP_REST_Request( 'POST', '/wp/v2/media' );","+\t\t$request->set_param( 'url', 'http://127.0.0.1/private.jpg' );","+","+\t\t$response = rest_get_server()->dispatch( $request );","+","+\t\t$this->assertErrorResponse( 'rest_invalid_param', $response, 400 );","+\t}","+","+\t/**","+\t * Verifies that `generate_sub_sizes` is honored when client-side media","+\t * processing is disabled.","+\t *","+\t * Skipping sub-size generation is a request the server can carry out on its","+\t * own, so it does not depend on the feature. Sub-sizes can still be added","+\t * later with wp_update_image_subsizes().","+\t *","+\t * @ticket 65517","+\t *","+\t * @covers WP_REST_Attachments_Controller::create_item","+\t */","+\tpublic function test_generate_sub_sizes_honored_without_client_side_media_processing() {","+\t\t$this->disable_client_side_media_processing();","+","+\t\twp_set_current_user( self::$superadmin_id );","+","+\t\tadd_filter( 'pre_http_request', array( $this, 'mock_image_download' ), 10, 3 );","+","+\t\t$request = new WP_REST_Request( 'POST', '/wp/v2/media' );","+\t\t$request->set_param( 'url', 'https://example.com/photo.jpg' );","+\t\t$request->set_param( 'generate_sub_sizes', false );","+","+\t\t$response = rest_get_server()->dispatch( $request );","+","+\t\tremove_filter( 'pre_http_request', array( $this, 'mock_image_download' ), 10 );","+","+\t\t$data = $response->get_data();","+","+\t\t$this->assertSame( 201, $response->get_status() );","+","+\t\t$metadata = wp_get_attachment_metadata( $data['id'], true );","+\t\t$this->assertEmpty(","+\t\t\t$metadata['sizes'] ?? array(),","+\t\t\t'Sub-sizes should not be generated when generate_sub_sizes is false.'","+\t\t);","+\t}","+","+\t/**","+\t * Verifies that `generate_sub_sizes` does not relax the unsupported image","+\t * type check when client-side media processing is disabled.","+\t *","+\t * That check exists because the server cannot process the image, so it should","+\t * only be relaxed when the client can process it instead. Otherwise the","+\t * upload is stored unprocessable.","+\t *","+\t * @ticket 65517","+\t *","+\t * @covers WP_REST_Attachments_Controller::create_item_permissions_check","+\t */","+\tpublic function test_unsupported_image_type_still_checked_without_client_side_media_processing() {","+\t\t$this->disable_client_side_media_processing();","+","+\t\twp_set_current_user( self::$author_id );","+","+\t\tadd_filter( 'wp_image_editors', '__return_empty_array' );","+","+\t\t$request = new WP_REST_Request( 'POST', '/wp/v2/media' );","+\t\t$request->set_file_params(","+\t\t\tarray(","+\t\t\t\t'file' => array(","+\t\t\t\t\t'name'     => 'avif-lossy.avif',","+\t\t\t\t\t'type'     => 'image/avif',","+\t\t\t\t\t'tmp_name' => self::$test_avif_file,","+\t\t\t\t\t'error'    => 0,","+\t\t\t\t\t'size'     => filesize( self::$test_avif_file ),","+\t\t\t\t),","+\t\t\t)","+\t\t);","+\t\t$request->set_param( 'generate_sub_sizes', false );","+","+\t\t$controller = new WP_REST_Attachments_Controller( 'attachment' );","+\t\t$result     = $controller->create_item_permissions_check( $request );","+","+\t\t$this->assertWPError( $result );","+\t\t$this->assertSame( 'rest_upload_image_type_not_supported', $result->get_error_code() );","+\t}","+"," \t/**"," \t * Verifies that the `url` argument rejects values that are not safe to"," \t * request server-side, guarding the sideload against SSRF.",""],"additions":179,"deletions":0,"truncated":false}],"additions":234,"deletions":45,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-08-05T10:24:36.025259+00:00"}