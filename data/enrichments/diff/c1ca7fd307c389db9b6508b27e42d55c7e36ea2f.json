ction testScanErrors() { $this->markTestSkipped(); }","     public function testConnectDatabaseSelect() { $this->markTestSkipped(); }","+    public function testPersistentReadTimeoutWithoutPool() { $this->markTestSkipped(); }","     /* BLESS SCAN cursors are per node, so RedisCluster needs a key or node */","     protected function blessScan(?string $directive, ?array $options = null, $node = 'bless') {","         return $this->redis->bless('SCAN', null, $directive, $options, $node);","@@ -90,6 +91,29 @@ public function testReconnectPooledConnection() {","         $client->close();","     }"," ","+    /* A pooled node connection must use the read timeout of the object taking","+     * it, not the one of its last user. */","+    public function testPooledReadTimeout() {","+        if (!ini_get('redis.pconnect.pooling_enabled'))","+            $this->markTestSkipped('Requires connection pooling');","+","+        $key = uniqid('pooled-read-timeout:', true);","+        $class = $this->getRedisClusterClass();","+","+        /* Freeing the object hands every node connection back to the pool */","+        $first = new $class(NULL, self::$seeds, 5, 5, true, $this->getAuth());","+        foreach ($first->_masters() as $master)","+            $this->assertTrue($first->ping($master));","+        unset($first);","+","+        $second = new $class(NULL, self::$seeds, 5, 1, true, $this->getAuth());","+        try {","+            $this->assertReadTimesOut($second, $key);","+        } finally {","+            $second->close();","+        }","+    }","+","     public function testReconnect() {","         $class = $this->getRedisClusterClass();","         $masters = $this->redis->_masters();"],"additions":24,"deletions":0,"truncated":false},{"path":"tests/RedisTest.php","lines":["@@ -7505,6 +7505,74 @@ public function testReconnectPooledConnection() {","         $client->close();","     }"," ","+    /* A blocking read on $key must give up after a read timeout of 1 second */","+    protected function assertReadTimesOut($client, string $key) {","+        $startTime = microtime(true);","+        $this->assertThrowsMatch($client, function ($client) use ($key) {","+            $client->blPop([$key], 4);","+        });","+        $this->assertLT(2.5, microtime(true) - $startTime);","+    }","+","+    private function newPersistentInstance(float $read_timeout, $persistent = true) {","+        $class = $this->getRedisClass();","+        $redis = new $class(['host' => $this->getHost(), 'port' => $this->getPort(),","+                             'persistent' => $persistent, 'readTimeout' => $read_timeout]);","+        if ($this->getAuth())","+            $this->assertTrue($redis->auth($this->getAuth()));","+        $this->assertTrue($redis->ping());","+","+        return $redis;","+    }","+","+    /* A pooled connection must use the read timeout of the object taking it,","+       not the one of its last user. */","+    public function testPooledReadTimeout() {","+        if (!ini_get('redis.pconnect.pooling_enabled'))","+            $this->markTestSkipped('Requires connection pooling');","+","+        $key = uniqid('pooled-read-timeout:', true);","+","+        /* Freeing the object hands its connection back to the pool */","+        $first = $this->newPersistentInstance(5);","+        unset($first);","+","+        $second = $this->newPersistentInstance(1);","+        $this->assertReadTimesOut($second, $key);","+","+        /* Zero means default_socket_timeout, as it does for a new connection */","+        $this->assertTrue($second->ping());","+        $this->assertTrue($second->setOption(Redis::OPT_READ_TIMEOUT, 0));","+        $this->assertTrue($second->ping());","+        $second->close();","+    }","+","+    /* Without pooling, PHP hands back the open stream of the same persistent ID,","+       and a read timeout of 0 must still mean default_socket_timeout. */","+    public function testPersistentReadTimeoutWithoutPool() {","+        $pooling = ini_get('redis.pconnect.pooling_enabled');","+        $socket_timeout = ini_get('default_socket_timeout');","+        $key = uniqid('persistent-read-timeout:', true);","+        $id = uniqid('persistent-read-timeout-', true);","+","+        ini_set('redis.pconnect.pooling_enabled', '0');","+        ini_set('default_socket_timeout', '1');","+        try {","+            /* Freeing the object leaves its stream open for the same ID */","+            $first = $this->newPersistentInstance(5, $id);","+            $client_id = $first->client('id');","+            unset($first);","+","+            $second = $this->newPersistentInstance(0, $id);","+            $this->assertEquals($client_id, $second->client('id'));","+            $this->assertReadTimesOut($second, $key);","+            $second->close();","+        } finally {","+            ini_set('redis.pconnect.pooling_enabled', $pooling);","+            ini_set('default_socket_timeout', $socket_timeout);","+        }","+    }","+","     public function testReconnectFailure() {","         if (!$this->minVersionCheck('6.0') || $this->is_keydb)","             $this->markTestSkipped('Requires Redis ACLs');",""],"additions":68,"deletions":0,"truncated":false}],"additions":138,"deletions":24,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-26T18:56:33.975293+00:00"}