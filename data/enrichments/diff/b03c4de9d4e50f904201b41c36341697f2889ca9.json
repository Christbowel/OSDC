de controllers.","+type inheritedNamespacedRulesHandler struct {","+\tgrCache      mgmtv3.GlobalRoleCache","+\tgrbCache     mgmtv3.GlobalRoleBindingCache","+\troles        wrbacv1.RoleClient","+\troleCache    wrbacv1.RoleCache","+\troleBindings wrbacv1.RoleBindingClient","+\trbCache      wrbacv1.RoleBindingCache","+\tclusterName  string","+}","+","+// RegisterInheritedNamespacedRulesHandler wires the handler onto the cluster's namespace","+// controller. Split from Register so tests can run the owner-plane registration without the","+// rest of the user context.","+func RegisterInheritedNamespacedRulesHandler(","+\tctx context.Context,","+\tnamespaces corew.NamespaceController,","+\tglobalRoles mgmtv3.GlobalRoleController,","+\tglobalRoleBindings mgmtv3.GlobalRoleBindingController,","+\troles wrbacv1.RoleController,","+\troleBindings wrbacv1.RoleBindingController,","+\tclusterName string,","+) {","+\t// InheritedNamespacedRules apply to downstream clusters only; the leader-side GlobalRole and","+\t// GlobalRoleBinding controllers deliberately exclude the local cluster, and so must this handler.","+\tif clusterName == \"local\" {","+\t\treturn","+\t}","+\th := &inheritedNamespacedRulesHandler{","+\t\tgrCache:      globalRoles.Cache(),","+\t\tgrbCache:     globalRoleBindings.Cache(),","+\t\troles:        roles,","+\t\troleCache:    roles.Cache(),","+\t\troleBindings: roleBindings,","+\t\trbCache:      roleBindings.Cache(),","+\t\tclusterName:  clusterName,","+\t}","+\tnamespaces.OnChange(ctx, inheritedNamespacedRulesHandlerName, h.onNamespaceChange)","+","+\t// A namespace event can fire before this replica's caches have observed the GlobalRole or","+\t// GlobalRoleBinding it depends on; an empty lookup is not an error, so nothing would retry.","+\t// Watching the grant objects themselves closes that race: whichever event arrives last","+\t// re-enqueues the namespace, and each watch is guaranteed to see its own object.","+\trelatedresource.WatchClusterScoped(ctx, inheritedNamespacedRulesHandlerName+\"-gr\",","+\t\th.globalRoleEnqueueNamespaces, namespaces, globalRoles)","+\trelatedresource.WatchClusterScoped(ctx, inheritedNamespacedRulesHandlerName+\"-grb\",","+\t\th.globalRoleBindingEnqueueNamespaces, namespaces, globalRoleBindings)","+}","+","+// globalRoleEnqueueNamespaces enqueues the namespaces named in a changed GlobalRole's","+// InheritedNamespacedRules.","+func (h *inheritedNamespacedRulesHandler) globalRoleEnqueueNamespaces(_, _ string, obj runtime.Object) ([]relatedresource.Key, error) {","+\tif obj == nil {","+\t\treturn nil, nil","+\t}","+\tgr, ok := obj.(*v3.GlobalRole)","+\tif !ok {","+\t\tlogrus.Errorf(\"[%s] unable to convert object: %[2]v, type %[2]T to a GlobalRole\", inheritedNamespacedRulesHandlerName, obj)","+\t\treturn nil, nil","+\t}","+\tkeys := make([]relatedresource.Key, 0, len(gr.InheritedNamespacedRules))","+\tfor ns := range gr.InheritedNamespacedRules {","+\t\tkeys = append(keys, relatedresource.Key{Name: ns})","+\t}","+\treturn keys, nil","+}","+","+// globalRoleBindingEnqueueNamespaces enqueues the namespaces named in the InheritedNamespacedRules","+// of a changed GlobalRoleBinding's GlobalRole.","+func (h *inheritedNamespacedRulesHandler) globalRoleBindingEnqueueNamespaces(_, _ string, obj runtime.Object) ([]relatedresource.Key, error) {","+\tif obj == nil {","+\t\treturn nil, nil","+\t}","+\tgrb, ok := obj.(*v3.GlobalRoleBinding)","+\tif !ok {","+\t\tlogrus.Errorf(\"[%s] unable to convert object: %[2]v, type %[2]T to a GlobalRoleBinding\", inheritedNamespacedRulesHandlerName, obj)","+\t\treturn nil, nil","+\t}","+\tgr, err := h.grCache.Get(grb.GlobalRoleName)","+\tif err != nil {","+\t\t// A GlobalRole not observed yet is not an error: its own event enqueues its namespaces.","+\t\tif apierrors.IsNotFound(err) {","+\t\t\treturn nil, nil","+\t\t}","+\t\treturn nil, fmt.Errorf(\"failed to get GlobalRole %s for GlobalRoleBinding %s: %w\", grb.GlobalRoleName, grb.Name, err)","+\t}","+\tkeys := make([]relatedresource.Key, 0, len(gr.InheritedNamespacedRules))","+\tfor ns := range gr.InheritedNamespacedRules {","+\t\tkeys = append(keys, relatedresource.Key{Name: ns})","+\t}","+\treturn keys, nil","+}","+","+func (h *inheritedNamespacedRulesHandler) onNamespaceChange(_ string, ns *corev1.Namespace) (*corev1.Namespace, error) {","+\tif ns == nil || ns.DeletionTimestamp != nil {","+\t\treturn ns, nil","+\t}","+","+\tgrs, err := h.grCache.GetByIndex(pkgrbac.GRDownstreamNSIndex, ns.Name)","+\tif err != nil {","+\t\treturn ns, fmt.Errorf(\"failed to list GlobalRoles for namespace %s: %w\", ns.Name, err)","+\t}","+","+\tvar returnError error","+\tfor _, gr := range grs {","+\t\tif _, ok := gr.InheritedNamespacedRules[ns.Name]; !ok {","+\t\t\tcontinue","+\t\t}","+\t\tif err := h.ensureRole(gr, ns.Name); err != nil {","+\t\t\treturnError = errors.Join(returnError, err)","+\t\t\tcontinue","+\t\t}","+","+\t\tgrbs, err := h.grbCache.GetByIndex(pkgrbac.GRBGlobalRoleIndex, gr.Name)","+\t\tif err != nil {","+\t\t\treturnError = errors.Join(returnError, fmt.Errorf(\"failed to list GlobalRoleBindings for GlobalRole %s: %w\", gr.Name, err))","+\t\t\tcontinue","+\t\t}","+\t\tfor _, grb := range grbs {","+\t\t\tif err := h.ensureRoleBinding(grb, ns.Name); err != nil {","+\t\t\t\treturnError = errors.Join(returnError, err)","+\t\t\t}","+\t\t}","+\t}","+","+\treturn ns, returnError","+}","+","+// ensureRole creates or updates the Role for a GlobalRole's inherited rules in the namespace.","+func (h *inheritedNamespacedRulesHandler) ensureRole(gr *v3.GlobalRole, ns string) error {","+\tdesired := pkgrbac.BuildInheritedRole(gr, ns)","+","+\t// A matching cached Role means there is nothing to write; skip the API round-trip.","+\tif cached, err := h.roleCache.Get(ns, desired.Name); err == nil && pkgrbac.AreRolesSame(cached, desired) {","+\t\treturn nil","+\t}","+","+\t_, err := pkgrbac.CreateOrUpdateNamespacedResource(desired, h.roles, pkgrbac.AreRolesSame)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"failed to ensure Role for GlobalRole %s in namespace %s in cluster %s: %w\", gr.Name, ns, h.clusterName, err)","+\t}","+\treturn nil","+}","+","+// ensureRoleBinding creates the RoleBinding for a GlobalRoleBinding in the namespace. An existing","+// RoleBinding with incorrect content is deleted and recreated because RoleRef is immutable.","+func (h *inheritedNamespacedRulesHandler) ensureRoleBinding(grb *v3.GlobalRoleBinding, ns string) error {","+\tdesired := pkgrbac.BuildInheritedRoleBinding(grb, ns)","+","+\texisting, err := h.rbCache.Get(ns, desired.Name)","+\tif err != nil && !apierrors.IsNotFound(err) {","+\t\treturn fmt.Errorf(\"failed to get RoleBinding %s in namespace %s in cluster %s: %w\", desired.Name, ns, h.clusterName, err)","+\t}","+","+\tif existing != nil {","+\t\tlabelCorrect := existing.Labels != nil && existing.Labels[pkgrbac.GrbOwnerLabel] == desired.Labels[pkgrbac.GrbOwnerLabel]","+\t\tif labelCorrect && pkgrbac.IsRoleBindingContentSame(existing, desired) {","+\t\t\treturn nil","+\t\t}","+\t\tif err := pkgrbac.DeleteNamespacedResource(ns, desired.Name, h.roleBindings); err != nil {","+\t\t\treturn fmt.Errorf(\"failed to delete incorrect RoleBinding %s in namespace %s in cluster %s: %w\", desired.Name, ns, h.clusterName, err)","+\t\t}","+\t}","+","+\tlogrus.Infof(\"[%s] Creating RoleBinding %s in namespace %s in cluster %s\", inheritedNamespacedRulesHandlerName, desired.Name, ns, h.clusterName)","+\tif _, err := h.roleBindings.Create(desired); err != nil && !apierrors.IsAlreadyExists(err) {","+\t\treturn fmt.Errorf(\"failed to create RoleBinding %s in namespace %s in cluster %s: %w\", desired.Name, ns, h.clusterName, err)","+\t}","+\treturn nil","+}"],"additions":199,"deletions":0,"truncated":false},{"path":"pkg/controllers/managementuser/rbac/globalrole_namespace_handler_long_name_test.go","lines":["@@ -0,0 +1,141 @@","+package rbac","+","+import (","+\t\"testing\"","+","+\tv3 \"github.com/rancher/rancher/pkg/apis/management.c