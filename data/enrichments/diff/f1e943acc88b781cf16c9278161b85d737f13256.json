lume."," const MIN_DISK_CACHE_BYTES: u64 = 1024;"," ","+/// `cache.disk.max_bytes` unset sizes the cache to at most this: the pools index every entry","+/// in memory, a few hundred bytes each. A larger cache is configured in bytes.","+pub const MAX_AUTO_DISK_CACHE_BYTES: u64 = 1 << 40;","+","+/// `cache.disk.max_bytes` unset keeps the cache this many percent of the file system below","+/// `watermark_ratio`: filled to the watermark itself, the growth of any other file would evict","+/// it under disk pressure at every write, and a watermark of 100 would let it fill the disk.","+pub const AUTO_HEADROOM_PERCENT: u64 = 5;","+","+/// `cache.disk.max_bytes` unset holds the writer to this `watermark_ratio` at most, and sizes","+/// the cache from it. The pools count entries by length, the disk fills by blocks: entries of a","+/// fraction of a block take more than the pools count, and only the writer's watermark, which","+/// reads the file system, keeps them from filling the disk. 100 would never evict.","+pub const MAX_AUTO_WATERMARK_RATIO: u64 = 100 - AUTO_HEADROOM_PERCENT;","+"," /// Version of the directory layout, `<path>/<tenant>/v2/<pool>/<kind>/<prefix>/<hash>`. Other"," /// entries under `<path>/<tenant>` are from older layouts and are removed in the background."," const LAYOUT_DIR: &str = \"v2\";","@@ -133,7 +151,8 @@ pub struct DiskCache {"," "," impl DiskCache {","     /// The disk cache of the node, or `None` when `cache.data_cache_storage` is not `disk`,","-    /// `max_bytes` is too small, or the build is not EE.","+    /// `max_bytes` is too small, or the build is not EE. `max_bytes` unset is sized from the","+    /// file system under `<cache.disk.path>/<tenant>` (see `auto_max_bytes`).","     pub fn from_config(","         config: &CacheConfig,","         tenant_id: &str,","@@ -141,32 +160,54 @@ impl DiskCache {","     ) -> Result<Option<Arc<DiskCache>>> {","         let disk = &config.disk_cache_config;","         if config.data_cache_storage != CacheStorageTypeConfig::Disk","-            || disk.max_bytes <= MIN_DISK_CACHE_BYTES","+            || disk","+                .max_bytes","+                .is_some_and(|bytes| bytes <= MIN_DISK_CACHE_BYTES)","             || !ee_mode","         {","             info!(","-                \"[DiskCache] off: storage {:?}, max_bytes {}, ee mode {ee_mode}\",","+                \"[DiskCache] off: storage {:?}, max_bytes {:?}, ee mode {ee_mode}\",","                 config.data_cache_storage, disk.max_bytes","             );","             return Ok(None);","         }","-        let caps = split_caps(disk.max_bytes, [","+        // Checked before the file system is looked at: `auto_max_bytes` takes the watermark.","+        let mut writer = writer_options(disk)?;","+        let tenant_root = PathBuf::from(&disk.path).join(tenant_id);","+        let max_bytes = match disk.max_bytes {","+            Some(bytes) => bytes,","+            None => {","+                writer.watermark_ratio = writer.watermark_ratio.min(MAX_AUTO_WATERMARK_RATIO);","+                let bytes = size_from_file_system(&tenant_root, writer.watermark_ratio)?;","+                if bytes <= MIN_DISK_CACHE_BYTES {","+                    warn!(","+                        \"[DiskCache] off: max_bytes unset and the file system under {:?} has no \\","+                         room {AUTO_HEADROOM_PERCENT}% below the watermark of {}%\",","+                        tenant_root, writer.watermark_ratio","+                    );","+                    // The files of a previous run, counted as room, left none: no writer would","+                    // evict them while the cache is off, so they are deleted, whatever the policy.","+                    remove_layouts_in_background(tenant_root);","+                    return Ok(None);","+                }","+                bytes","+            }","+        };","+        let caps = split_caps(max_bytes, [","             disk.meta_max_ratio,","             disk.index_max_ratio,","             disk.data_max_ratio,","         ])?;","-        let tenant_root = PathBuf::from(&disk.path).join(tenant_id);","         if config.data_cache_key_reload_policy == DiskCacheKeyReloadPolicy::Reset {","             // Starts empty: the files of the previous run are set aside at once, then deleted","             // with the older layouts in the background. Nothing cached before a restart is read","             // after it, whatever happened to the objects meanwhile.","             set_aside_layout(&tenant_root)?;","         }","-        let writer = writer_options(disk)?;","-        let cache = DiskCache::with_writer(&tenant_root, disk.max_bytes, caps, writer)?;","+        let cache = DiskCache::with_writer(&tenant_root, max_bytes, caps, writer)?;","         info!(","             \"[DiskCache] on: {} bytes, meta {} / index {} / data {}, under {:?}\",","-            disk.max_bytes, caps[0], caps[1], caps[2], tenant_root","+            max_bytes, caps[0], caps[1], caps[2], tenant_root","         );","         let cache = Arc::new(cache);","         cache.clone().start_reload(tenant_root);","@@ -566,6 +607,90 @@ pub fn split_caps(max_bytes: u64, ratios: [u64; 3]) -> Result<[u64; 3]> {","     Ok(ratios.map(|r| (max_bytes as u128 * r as u128 / total) as u64))"," }"," ","+/// `cache.disk.max_bytes` when unset, in bytes: the room a file system of `total` bytes,","+/// `available` of them free, leaves the cache `AUTO_HEADROOM_PERCENT` below `watermark_ratio`","+/// percent of it in use, past which the writer evicts. The `cached` bytes of the cache's own","+/// files count as room: those of a previous run are freed or indexed by the restart, and","+/// leaving them out would size the cache smaller at each restart. At most","+/// `MAX_AUTO_DISK_CACHE_BYTES`.","+pub fn auto_max_bytes(total: u64, available: u64, cached: u64, watermark_ratio: u64) -> u64 {","+    let reserved_percent = (100 + AUTO_HEADROOM_PERCENT).saturating_sub(watermark_ratio);","+    let reserved = total as u128 * reserved_percent as u128 / 100;","+    let room = (available as u128 + cached as u128).saturating_sub(reserved);","+    room.min(MAX_AUTO_DISK_CACHE_BYTES as u128) as u64","+}","+","+/// `auto_max_bytes` of the file system under `tenant_root`, the cache's files being those under","+/// it, of every layout. The file system the cache writes to and the writer watches: not that of","+/// `cache.disk.path` when the tenant directory is a mount point or a link to another one.","+fn size_from_file_system(tenant_root: &Path, watermark_ratio: u64) -> Result<u64> {","+    fs::create_dir_all(tenant_root).map_err(|e| {","+        ErrorCode::StorageOther(format!(","+            \"failed to create disk cache directory {tenant_root:?}: {e}\"","+        ))","+    })?;","+    let stat = rustix::fs::statvfs(tenant_root).map_err(|e| {","+        ErrorCode::StorageOther(format!(","+            \"failed to size the disk cache from the file system under {tenant_root:?}: {e}\"","+        ))","+    })?;","+    // Block counts are in fragments; `f_frsize` is 0 on some file systems.","+    let block = if stat.f_frsize > 0 {","+        stat.f_frsize","+    } else {","+        stat.f_bsize","+    };","+    let total = stat.f_blocks.saturating_mul(block);","+    let available = stat.f_bavail.saturating_mul(block);","+    let cached = cached_bytes(tenant_root);","+    let bytes = auto_max_bytes(total, available, cached, watermark_ratio);","+    info!(","+        \"[DiskCache] max_bytes unset: {bytes} bytes, from {total} bytes in the file system under \\","+         {tenant_root:?}, {available} available and {cached} in cache files, {AUTO_HEADROOM_PERCENT}% \\","+         below the watermark of {watermark_ratio}%, at most {MAX_AUTO_DISK_CACHE_BYTES}\"","+    );","+    Ok(bytes)","+}","+","+/// Bytes the files under `tenant_root` take on disk, which deleting them frees: their blocks,","+/// as `available` counts, not their lengths, smaller for files of a fraction of a block. Files","+/// it could not see count for none, sizing the cache smaller.","+pub fn cached_bytes(tenant_root: &Path) -> u64 {","+    // Not held to the memory limit, on this thread or the workers', like the restart scan.","+    let _unlimited = LimitMemGuard::enter_unlimited();","+    let complete = AtomicBool::new(true);","+    let bytes = scan_files(tenant_root, &complete)","+        .par_iter()","+        .map(|path| {","+            let _unlimited = LimitMemGuard::enter_unlimited();","+            // `st_blocks` is in 512 byte units, whatever the block size.","+            fs::metadata(path).map_or(0, |meta| meta.blocks().saturating_mul(512))","+        })","+        .sum();","+    if !complete.into_inner() {","+        warn!(","+            \"[DiskCache] the scan of {tenant_root:?} is incomplete; files it missed are not room\"","+        );","+    }","+    bytes","+}","+","+/// Deletes every file under `tenant_root`, every layout included, in a background thread: the","+/// disk cache stays off, and nothing else would.","+fn remove_layouts_in_background(tenant_root: PathBuf) {","+    let spawned = std::thread::Builder::new()","+        .name(\"disk-cache-delete\".to_string())","+        .spawn(move || {","+            if let Err(e) = set_aside_layout(&tenant_root) {","+                warn!(\"[DiskCache] {}\", e.message());","+            }","+            remove_old_layouts(&tenant_root);","+        });","+    if let Err(e) = spawned {","+        warn!(\"[DiskCache] failed to spawn the delete thread: {e}\");","+    }","+}","+"," fn delete_in_background(pool: Arc<DiskPool>, victims: Vec<String>) {","     let _unlimited = LimitMemGuard::enter_unlimited();","     if victims.is_empty() {"],"additions":133,"deletions":8,"truncated":false},{"path":"src/query/storages/common/cache/src/disk/disk_pool.rs","lines":["@@ -731,7 +731,7 @@ fn remove_files(root: &Path, rels: &[String]) -> Result<(), (std::io::Error, Has"," "," /// Every file under `root`, recursively, scanning directories in parallel. `complete` is"," /// cleared when a directory or entry could not be read.","-fn scan_files(root: &Path, complete: &AtomicBool) -> Vec<PathBuf> {","+pub(crate) fn scan_files(root: &Path, complete: &AtomicBool) -> Vec<PathBuf> {","     let entries = match fs::read_dir(root) {","         Ok(entries) => entries,","         Err(e) => {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/query/storages/common/cache/src/disk/disk_writer.rs","lines":["@@ -53,7 +53,8 @@ pub struct WriterOptions {","     /// How long a reader waits for room in the queue before dropping its entry.","     pub queue_wait: Duration,","     pub sync_data: bool,","-    /// Percent of the file system in use above which the writer evicts before it writes.","+    /// Percent of the file system in use, of its blocks or its inodes, above which the writer","+    /// evicts before it writes.","     pub watermark_ratio: u64,","     /// Whether the file system under the root is over `watermark_ratio` percent in use.","     pub over_watermark: fn(&Path, u64) -> bool,","@@ -454,13 +455,22 @@ impl Shared {","     }"," }"," ","-/// Over `percent` of the file system in use.","+/// Over `percent` of the file system in use, of its blocks or of its inodes: entries much","+/// smaller than a block run out of inodes first, and a full file system fails to create files","+/// either way, spill files among them. File systems that report no inodes are checked by blocks."," fn fs_over_watermark(root: &Path, percent: u64) -> bool {","     match rustix::fs::statvfs(root) {","-        Ok(stat) if stat.f_blocks > 0 => {","-            let used = stat.f_blocks.saturating_sub(stat.f_bavail);","-            used as u128 * 100 > stat.f_blocks as u128 * percent as u128","+        Ok(stat) => {","+            over_percent(stat.f_blocks, stat.f_bavail, percent)","+                || over_percent(stat.f_files, stat.f_favail, percent)","         }","-        _ => false,","+        Err(_) => false,