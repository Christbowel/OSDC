the cache as a start","+    // without them would: its files do not shrink it.","+    assert_eq!(","+        auto_max_bytes(total, 600 * GIB, 300 * GIB, 90),","+        auto_max_bytes(total, 900 * GIB, 0, 90)","+    );","+    assert_eq!(auto_max_bytes(total, 600 * GIB, 300 * GIB, 90), 750 * GIB);","+    // Other files at or over the line already leave nothing: the cache is off.","+    assert_eq!(auto_max_bytes(total, 50 * GIB, 0, 90), 0);","+    assert_eq!(auto_max_bytes(total, 150 * GIB, 0, 90), 0);","+    assert_eq!(auto_max_bytes(0, 0, 0, 90), 0);","+    // A watermark of 100 never evicts; the headroom still keeps the cache off the full disk.","+    assert_eq!(auto_max_bytes(total, total, 0, 100), 950 * GIB);","+    assert_eq!(auto_max_bytes(total, 600 * GIB, 0, 100), 550 * GIB);","+    // A watermark under the headroom reserves everything.","+    assert_eq!(auto_max_bytes(total, total, 0, 1), 0);","+    // Large disks are capped, without overflow.","+    assert_eq!(","+        auto_max_bytes(16 << 40, 16 << 40, 0, 90),","+        MAX_AUTO_DISK_CACHE_BYTES","+    );","+    assert_eq!(","+        auto_max_bytes(u64::MAX, u64::MAX, u64::MAX, 90),","+        MAX_AUTO_DISK_CACHE_BYTES","+    );","+}","+","+/// The files of a previous run count by the blocks they take, which deleting them frees, as","+/// `du` reports it: for files much smaller than a block, far more than their lengths."],"additions":44,"deletions":0,"truncated":false}],"additions":288,"deletions":34,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-22T16:23:18.299719+00:00"}