{"id":"325a5a0da76191d5deba65aaefa5ebaedaf09ee9","axis":"silent","repo":"supabase/supabase","sha":"325a5a0da76191d5deba65aaefa5ebaedaf09ee9","parsed":{"files":[{"path":"apps/design-system/config/docs.ts","lines":["@@ -127,11 +127,6 @@ export const docsConfig: DocsConfig = {","           href: '/docs/fragments/admonition',","           items: [],","         },","-        {","-          title: 'Collapsible Alert',","-          href: '/docs/fragments/collapsible-alert',","-          items: [],","-        },","         {","           title: 'Collapsible Card Section',","           href: '/docs/fragments/collapsible-card-section',"],"additions":0,"deletions":5,"truncated":false},{"path":"apps/design-system/content/docs/components/alert.mdx","lines":["@@ -11,7 +11,7 @@ Alert is the low-level shadcn primitive that forms the foundation for [Admonitio"," "," Examples where Alert may be appropriate include bespoke icons, custom internal layouts, or wrapper components that need direct access to `alertVariants`."," ","-Use [Collapsible Alert](../fragments/collapsible-alert) when a callout also needs expandable detail. Use [Collapsible](./collapsible) only for generic disclosure behaviour that is not itself an alert.","+Compose Alert with [Collapsible](./collapsible) when a callout needs expandable detail. Use [DialogDisclosure](./dialog#optional-details) for optional details in a dialog."," "," <ComponentPreview name=\"alert-demo\" peekCode wide />"," "],"additions":1,"deletions":1,"truncated":false},{"path":"apps/design-system/content/docs/components/collapsible.mdx","lines":["@@ -6,7 +6,7 @@ component: true"," "," Collapsible is a low-level primitive for revealing and hiding related content. Use it when a component needs custom trigger or content composition."," ","-Use Collapsible for generic disclosure behaviour: rows, sections, menus, tool details, and custom layouts. Use [Collapsible Alert](../fragments/collapsible-alert) instead when the disclosure is an alert-styled callout that should keep standard alert padding, variants, trigger styling, and toggle treatment.","+Use Collapsible for generic disclosure behavior: rows, sections, menus, tool details, and custom layouts. Use [DialogDisclosure](./dialog#optional-details) for optional details in a dialog."," "," <ComponentPreview name=\"collapsible-demo\" peekCode wide />"," "],"additions":1,"deletions":1,"truncated":false},{"path":"apps/design-system/content/docs/components/dialog.mdx","lines":["@@ -65,6 +65,14 @@ import {"," "," ## Examples"," ","+### Optional details","+","+Use `DialogDisclosure` to reveal optional help or context inside a dialog. Put the trigger in the dialog body above the footer, and add a section separator when the disclosure follows other content. Keep the primary action visible while the details are open or closed.","+","+`Collapsible` provides the open and closed state. `DialogDisclosure` adds the trigger and content presentation used in dialogs. Use `Accordion` when several related sections each need a heading and expandable content.","+","+<ComponentPreview name=\"dialog-disclosure-demo\" peekCode wide />","+"," ### Custom close button"," "," <ComponentPreview name=\"dialog-close-button\" />"],"additions":8,"deletions":0,"truncated":false},{"path":"apps/design-system/content/docs/fragments/admonition.mdx","lines":["@@ -15,7 +15,7 @@ Admonition provides the standard product callout pattern for situations that req"," "," Use Admonition instead of the low-level [Alert](../components/alert) primitive unless you specifically need custom composition. If in doubt, stick with Admonition."," ","-Use [Collapsible Alert](./collapsible-alert) when the callout needs to remain visible while optional detail can be expanded. Use [Collapsible](../components/collapsible) for generic disclosure behaviour that is not itself a callout.","+Use [Collapsible](../components/collapsible) for custom expandable content. Use [DialogDisclosure](../components/dialog#optional-details) for optional details in a dialog."," "," Use `title` for the heading slot when the callout needs its own heading. `title` is optional: short callouts may use `description` without a title when nearby content already provides enough context."," "],"additions":1,"deletions":1,"truncated":false},{"path":"apps/design-system/content/docs/fragments/collapsible-alert.mdx","lines":["@@ -1,43 +0,0 @@","-title: Collapsible Alert","-description: An alert-styled block with a collapsible content section, toggled by an icon button.","-fragment: true","-","-Collapsible Alert combines an Alert-style container with a collapsible content section. Use it when the callout itself needs to stay visible while optional detail can be expanded.","-","-Use Collapsible Alert when the disclosure is itself a callout. It owns the alert styling, padding, trigger treatment, and toggle button. Use [Collapsible](../components/collapsible) instead when you only need generic reveal and hide behaviour and the surrounding layout is not an alert.","-","-For non-expandable product callouts, use [Admonition](./admonition). Use the low-level [Alert](../components/alert) primitive only when a wrapper or bespoke composition needs direct control over the alert structure.","-","-<ComponentPreview name=\"collapsible-alert-demo\" peekCode wide />","-","-## Usage","-","-```tsx","-import { CollapsibleAlert } from 'ui-patterns/collapsible-alert'","-```","-","-```tsx","-<CollapsibleAlert trigger=\"Need help?\">","-  <p>Content revealed when expanded.</p>","-</CollapsibleAlert>","-```","-","-### Default open","-","-```tsx","-<CollapsibleAlert trigger=\"Details\" defaultOpen>","-  <p>This section is expanded by default.</p>","-</CollapsibleAlert>","-```","-","-### Variants","-","-Supports the same `variant` prop as Alert: `default`, `destructive`, and `warning`.","-","-```tsx","-<CollapsibleAlert trigger=\"Warning\" variant=\"warning\">","-  <p>Something needs attention.</p>","-</CollapsibleAlert>","-```"],"additions":0,"