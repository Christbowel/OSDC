                   }","-                }","-                finally","-                {","-                    try","-                    {","-                        File.Delete(solutionFile);","-                    }","-                    catch","-                    {","-                        // ignore","-                    }","+                    return false;","                 }","             }"," "],"additions":5,"deletions":18,"truncated":false},{"path":"src/sdk/src/Dotnet.Watch/Watch/Utilities/TemporaryFileManager.cs","lines":["@@ -0,0 +1,73 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.ComponentModel;","+using System.ComponentModel.DataAnnotations;","+using System.Runtime.Versioning;","+using System.Security.AccessControl;","+using System.Security.Principal;","+","+namespace Microsoft.DotNet.Watch;","+","+/// <summary>","+/// Creates temporary files under a private directory in the process temp path.","+/// The directory is owner-only, so another user cannot write to files created there or squat on their names.","+/// </summary>","+internal sealed partial class TemporaryFileManager : IDisposable","+{","+    internal readonly struct TemporaryFile(FileStream stream) : IDisposable","+    {","+        public FileStream Stream => stream;","+","+        public void Dispose()","+        {","+            try","+            {","+                stream.Dispose();","+            }","+            catch","+            {","+                // Ignore exceptions","+            }","+","+            try","+            {","+                File.Delete(stream.Name);","+            }","+            catch","+            {","+                // Ignore exceptions","+            }","+        }","+    }","+","+    private const string TempDirectoryPrefix = \"dotnet-watch-\";","+","+    /// <summary>","+    /// Private directory in which the manager creates temporary files.","+    /// Assumes that the directory returned by <see cref=\"Path.GetTempPath\"/> is user-private on Windows and","+    /// the environment is not configured such that this is not true.","+    /// </summary>","+    private readonly string _directory = Directory.CreateTempSubdirectory(TempDirectoryPrefix).FullName;","+","+    private int _uniqueFileId;","+","+    public void Dispose()","+    {","+        try","+        {","+            Directory.Delete(_directory, recursive: true);","+        }","+        catch","+        {","+            // Ignore exceptions","+        }","+    }","+","+    public TemporaryFile Create(string extension, FileShare share)","+        => new(new FileStream(","+            path: Path.Combine(_directory, Interlocked.Increment(ref _uniqueFileId) + extension),","+            mode: FileMode.CreateNew,","+            access: FileAccess.ReadWrite,","+            share: share));","+}"],"additions":73,"deletions":0,"truncated":false},{"path":"src/sdk/test/TestAssets/TestPackages/TemplateEngine/test_templates/SourceWithExcludeAndWithout/With/bar.cs","lines":["old mode 100644","new mode 100755"],"additions":0,"deletions":0,"truncated":false},{"path":"src/sdk/test/TestAssets/TestPackages/TemplateEngine/test_templates/SourceWithExcludeAndWithout/With/packages.lock.json","lines":["old mode 100644","new mode 100755"],"additions":0,"deletions":0,"truncated":false},{"path":"src/sdk/test/dotnet-watch.Tests/Utilities/TemporaryFileManagerTests.cs","lines":["@@ -0,0 +1,58 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.Runtime.Versioning;","+","+namespace Microsoft.DotNet.Watch.UnitTests;","+","+public class TemporaryFileManagerTests","+{","+    [Fact]","+    public void CreateFile_IsOwnerOnlyAndRemovedOnDispose()","+    {","+        string path1;","+        string path2;","+        string directory;","+        using (var manager = new TemporaryFileManager())","+        {","+            using var file1 = manager.Create(\".slnx\", FileShare.Read);","+            using var file2 = manager.Create(\".tmp\", FileShare.Read);","+            path1 = file1.Stream.Name;","+            path2 = file2.Stream.Name;","+","+            directory = Path.GetDirectoryName(path1)!;","+            Assert.Equal(directory, Path.GetDirectoryName(path2));","+","+            Assert.Equal(\"1.slnx\", Path.GetFileName(path1));","+            Assert.Equal(\"2.tmp\", Path.GetFileName(path2));","+            Assert.False(File.Exists(path1));","+            Assert.False(File.Exists(path2));","+            Assert.StartsWith(Path.GetFullPath(Path.GetTempPath()), Path.GetFullPath(path1), PathComparison);","+","+            File.WriteAllText(path1, \"<Solution />\");","+            Assert.Equal(\"<Solution />\", File.ReadAllText(path1));","+","+            if (!OperatingSystem.IsWindows())","+            {","+                AssertUnixOwnerOnly(directory);","+            }","+        }","+","+        Assert.False(File.Exists(path1));","+        Assert.False(File.Exists(path2));","+        Assert.False(Directory.Exists(directory));","+    }","+","+    [UnsupportedOSPlatform(\"windows\")]","+    private static void AssertUnixOwnerOnly(string path)","+    {","+        var mode = File.GetUnixFileMode(path);","+        const UnixFileMode nonOwnerBits =","+            UnixFileMode.GroupRead | UnixFileMode.GroupWrite | UnixFileMode.GroupExecute |","+            UnixFileMode.OtherRead | UnixFileMode.OtherWrite | UnixFileMode.OtherExecute;","+        Assert.Equal(UnixFileMode.None, mode & nonOwnerBits);","+    }","+","+    private static StringComparison PathComparison","+        => OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;","+}",""],"additions":58,"deletions":0,"truncated":false}],"additions":142,"deletions":18,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-11T15:37:26.560824+00:00"}