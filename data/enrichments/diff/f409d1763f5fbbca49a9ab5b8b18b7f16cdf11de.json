raw_fog.ts';","+import {createStyleLayer} from '../../style/create_style_layer.ts';","+","+import type {LayerSpecification} from '@maplibre/maplibre-gl-style-spec';","+import type {StyleLayer} from '../../style/style_layer.ts';","+","+function buildLayers(specs: LayerSpecification[]): {layerIds: string[]; layers: Record<string, StyleLayer>} {","+    const layers: Record<string, StyleLayer> = {};","+    for (const spec of specs) {","+        layers[spec.id] = createStyleLayer(spec, {});","+    }","+    return {layerIds: specs.map(spec => spec.id), layers};","+}","+","+describe('getLastDrapedLayerIndex', () => {","+    test('returns the index of the last visible draped layer', () => {","+        const {layerIds, layers} = buildLayers([","+            {id: 'bg', type: 'background'},","+            {id: 'labels', type: 'symbol', source: 's'},","+            {id: 'fill', type: 'fill', source: 's'},","+            {id: 'hidden-fill', type: 'fill', source: 's', minzoom: 20},","+            {id: 'dots', type: 'circle', source: 's'}","+        ]);","+","+        expect(getLastDrapedLayerIndex(layerIds, layers, 10)).toBe(2);","+    });","+","+    test('returns -1 when no visible draped layer exists', () => {","+        const {layerIds, layers} = buildLayers([","+            {id: 'hidden-bg', type: 'background', minzoom: 20},","+            {id: 'labels', type: 'symbol', source: 's'}","+        ]);","+","+        expect(getLastDrapedLayerIndex(layerIds, layers, 10)).toBe(-1);","+    });","+});"],"additions":37,"deletions":0,"truncated":false},{"path":"src/webgl/draw/draw_fog.ts","lines":["@@ -0,0 +1,58 @@","+import {DepthMode} from '../depth_mode.ts';","+import {CullFaceMode} from '../cull_face_mode.ts';","+import {ColorMode} from '../color_mode.ts';","+import {fogUniformValues} from '../program/fog_program.ts';","+import {isRenderedToTexture} from '../render_to_texture.ts';","+import {calculateFogBlendOpacity} from '../../style/sky.ts';","+import {getCameraMath} from '../../camera/camera_math_factory.ts';","+","+import type {FrameRenderContext} from '../../render/frame_render_context.ts';","+import type {StyleLayer} from '../../style/style_layer.ts';","+import type {Terrain} from '../../render/terrain.ts';","+","+/**","+ * How much of the fog {@link drawFog} draws over the terrain. It is 0 without terrain, on the globe, when the sky","+ * has no fog, or when the pitch keeps the horizon out of view.","+ */","+export function getTerrainFogOpacity(frameRenderContext: FrameRenderContext): number {","+    const {sky, isRenderingGlobe} = frameRenderContext.data;","+    if (!frameRenderContext.terrain || isRenderingGlobe || !sky || sky['fog-ground-blend'] >= 1) return 0;","+    return calculateFogBlendOpacity(frameRenderContext.projectedCamera.pitch);","+}","+","+/**","+ * Returns the index in `layerIds` of the last visible draped layer at `zoom`, or -1 when none is draped.","+ */","+export function getLastDrapedLayerIndex(layerIds: readonly string[], layers: Record<string, StyleLayer>, zoom: number): number {","+    for (let i = layerIds.length - 1; i >= 0; i--) {","+        const layer = layers[layerIds[i]];","+        if (isRenderedToTexture(layer) && !layer.isHidden(zoom)) return i;","+    }","+    return -1;","+}","+","+/**","+ * Draws the fog over the terrain meshes once, reading the depth buffer written by the terrain drapes and using a","+ * stencil pass so overlapping tile edges are fogged only once.","+ */","+export function drawFog(terrain: Terrain, opacity: number, frameRenderContext: FrameRenderContext): void {","+    const {sky} = frameRenderContext.data;","+    const context = frameRenderContext.context;","+    const gl = context.gl;","+    const projectedCamera = frameRenderContext.projectedCamera;","+    const program = frameRenderContext.useProgram('fog');","+    const depthMode = new DepthMode(gl.LEQUAL, DepthMode.ReadOnly, frameRenderContext.depthRangeFor3D);","+    const stencilMode = frameRenderContext.stencilModeFor3D();","+    const eleDelta = terrain.getSkirtLength(projectedCamera.zoom);","+    const cameraMath = getCameraMath(projectedCamera);","+","+    for (const tile of terrain.tileManager.getRenderableTiles()) {","+        const mesh = terrain.getTerrainMesh(tile.tileID, false);","+        const terrainData = terrain.getTerrainData(tile.tileID);","+        const fogMatrix = cameraMath.calculateFogMatrix(projectedCamera, tile.tileID.toUnwrapped());","+        const uniformValues = fogUniformValues(eleDelta, fogMatrix, sky, opacity);","+        const projectionData = frameRenderContext.getProjectionDataForTile(tile.tileID, {applyTerrainMatrix: false});","+        program.draw(context, gl.TRIANGLES, depthMode, stencilMode, ColorMode.alphaBlended, CullFaceMode.backCCW,","+            uniformValues, terrainData, projectionData, 'fog', mesh.vertexBuffer, mesh.indexBuffer, mesh.segments);","+    }","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"src/webgl/draw/draw_terrain.ts","lines":["@@ -58,8 +58,7 @@ function drawTerrain(painter: Painter, terrain: Terrain, tiles: Tile[], frameRen","         context.activeTexture.set(gl.TEXTURE0);","         texture.bind(gl.LINEAR, gl.CLAMP_TO_EDGE, gl.LINEAR_MIPMAP_LINEAR);","         const eleDelta = terrain.getSkirtLength(projectedCamera.zoom);","-        const fogMatrix = getCameraMath(projectedCamera).calculateFogMatrix(projectedCamera, tile.tileID.toUnwrapped());","-        const uniformValues = terrainUniformValues(eleDelta, fogMatrix, frameRenderContext.data.sky, projectedCamera.pitch, isRenderingGlobe);","+        const uniformValues = terrainUniformValues(eleDelta);","         const projectionData = frameRenderContext.getProjectionDataForTile(tile.tileID, {applyTerrainMatrix: false});","         program.draw(context, gl.TRIANGLES, depthMode, StencilMode.disabled, colorMode, CullFaceMode.backCCW, uniformValues, terrainData, projectionData, 'terrain', mesh.vertexBuffer, mesh.indexBuffer, mesh.segments);","     }"],"additio