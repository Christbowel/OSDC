{"id":"GHSA-vxj4-q4g9-crj7","axis":"advisories","repo":"pypa/virtualenv","sha":"c3104e02474b652832a9bbaae79f6e1696296932","parsed":{"files":[{"path":"docs/changelog/3390.bugfix.rst","lines":["@@ -0,0 +1,3 @@","+Escape the environment name in the bash activator for both of bash's ``PS1`` passes, so a name or ``--prompt`` value","+with a backslash before ``$(...)`` or backticks no longer runs as a command each time bash draws the prompt - by","+:user:`gaborbernat`."],"additions":3,"deletions":0,"truncated":false},{"path":"src/virtualenv/activation/bash/activate.sh","lines":["@@ -131,7 +131,13 @@ if [ -z \"${VIRTUAL_ENV_DISABLE_PROMPT-}\" ] ; then","     # bash, and zsh under PROMPT_SUBST, re-expand backslashes, dollar signs and backticks in PS1 on every redraw;","     # zsh gets the escaping even without the option, since a user can set it after activation. The guards keep","     # the substitution away from POSIX shells such as dash, which reject it with \"Bad substitution\"","-    if [ -n \"${BASH_VERSION-}${ZSH_VERSION-}\" ]; then","+    if [ -n \"${BASH_VERSION-}\" ]; then","+        # bash first decodes its backslash prompt escapes, turning \\\\ into \\ and \\$ into $ (or # for root), and only","+        # then expands the result, so each character needs escaping for both passes","+        _VIRTUAL_PROMPT=\"${_VIRTUAL_PROMPT//\\\\/\\\\\\\\\\\\\\\\}\"","+        _VIRTUAL_PROMPT=\"${_VIRTUAL_PROMPT//\\$/\\\\\\\\\\$}\"","+        _VIRTUAL_PROMPT=\"${_VIRTUAL_PROMPT//\\`/\\\\\\\\\\`}\"","+    elif [ -n \"${ZSH_VERSION-}\" ]; then","         _VIRTUAL_PROMPT=\"${_VIRTUAL_PROMPT//\\\\/\\\\\\\\}\"","         _VIRTUAL_PROMPT=\"${_VIRTUAL_PROMPT//\\$/\\\\\\$}\"","         _VIRTUAL_PROMPT=\"${_VIRTUAL_PROMPT//\\`/\\\\\\`}\""],"additions":7,"deletions":1,"truncated":false},{"path":"tests/unit/activation/test_bash.py","lines":["@@ -286,6 +286,8 @@ def build(prompt: str | None, env_name: str) -> tuple[Path, str]:","         pytest.param(\"x$(touch PWNED)y\", \"env\", id=\"prompt-command-substitution\"),","         pytest.param(\"x`touch PWNED`y\", \"env\", id=\"prompt-backticks\"),","         pytest.param(\"x${$(touch PWNED)}y\", \"env\", id=\"prompt-parameter-expansion\"),","+        pytest.param(\"x\\\\$(touch PWNED)y\", \"env\", id=\"prompt-backslash-command-substitution\"),","+        pytest.param(\"x\\\\`touch PWNED`y\", \"env\", id=\"prompt-backslash-backticks\"),","         pytest.param(None, \"x$(touch PWNED)y\", id=\"dirname-command-substitution\"),","         pytest.param(None, \"A__VIRTUAL_NAME__B/x'$(touch PWNED)'y\", id=\"placeholder-in-parent-dir\"),","     ],","@@ -304,6 +306,10 @@ def test_prompt_does_not_run_commands(","     [","         pytest.param(\"myenv\", id=\"plain\"),","         pytest.param(\"a%n$HOME\\\\b`c`\", id=\"special-characters\"),","+        pytest.param(\"a\\\\$HOME\", id=\"backslash-before-dollar\"),","+        pytest.param(\"a\\\\`c`\", id=\"backslash-before-backtick\"),","+        pytest.param(\"x\\\\\\\\y\", id=\"doubled-backslash\"),","+        pytest.param(\"e\\\\\", id=\"trailing-backslash\"),","     ],"," )"," def test_prompt_renders_name_literally(",""],"additions":6,"deletions":0,"truncated":false}],"additions":16,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-22T13:43:46.638221+00:00"}