s":["@@ -0,0 +1,65 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package loadbalancer","+","+import (","+\t\"net/netip\"","+","+\t\"github.com/cilium/cilium/pkg/datapath/tables\"","+)","+","+// RSSConfig contains the source prefixes used for DSR IPIP RSS.","+type RSSConfig struct {","+\tipv4Prefix netip.Prefix","+\tipv6Prefix netip.Prefix","+}","+","+// NewRSSConfig resolves configured RSS prefixes, falling back to preferred","+// addresses on the direct-routing device and, finally, unspecified addresses.","+func NewRSSConfig(ipv4Prefix, ipv6Prefix netip.Prefix, directRoutingDevice *tables.Device) RSSConfig {","+\tconfig := RSSConfig{","+\t\tipv4Prefix: netip.PrefixFrom(netip.IPv4Unspecified(), 32),","+\t\tipv6Prefix: netip.PrefixFrom(netip.IPv6Unspecified(), 128),","+\t}","+","+\tif ipv4Prefix.IsValid() {","+\t\tconfig.ipv4Prefix = ipv4Prefix","+\t}","+\tif ipv6Prefix.IsValid() {","+\t\tconfig.ipv6Prefix = ipv6Prefix","+\t}","+","+\tif directRoutingDevice == nil {","+\t\treturn config","+\t}","+","+\tif !ipv4Prefix.IsValid() {","+\t\tif addr := tables.PreferredIPv4Address(directRoutingDevice.Addrs); addr.IsValid() {","+\t\t\tconfig.ipv4Prefix = netip.PrefixFrom(addr, 32)","+\t\t}","+\t}","+\tif !ipv6Prefix.IsValid() {","+\t\tif addr := tables.PreferredIPv6Address(directRoutingDevice.Addrs); addr.IsValid() {","+\t\t\tconfig.ipv6Prefix = netip.PrefixFrom(addr, 128)","+\t\t}","+\t}","+","+\treturn config","+}","+","+// IPv4Prefix returns the resolved IPv4 RSS prefix.","+func (c RSSConfig) IPv4Prefix() netip.Prefix {","+\tif !c.ipv4Prefix.IsValid() {","+\t\treturn netip.PrefixFrom(netip.IPv4Unspecified(), 32)","+\t}","+\treturn c.ipv4Prefix","+}","+","+// IPv6Prefix returns the resolved IPv6 RSS prefix.","+func (c RSSConfig) IPv6Prefix() netip.Prefix {","+\tif !c.ipv6Prefix.IsValid() {","+\t\treturn netip.PrefixFrom(netip.IPv6Unspecified(), 128)","+\t}","+\treturn c.ipv6Prefix","+}"],"additions":65,"deletions":0,"truncated":false},{"path":"pkg/loadbalancer/rss_config_test.go","lines":["@@ -0,0 +1,59 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package loadbalancer","+","+import (","+\t\"net/netip\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/cilium/cilium/pkg/datapath/tables\"","+)","+","+func TestNewRSSConfig(t *testing.T) {","+\tdirectRoutingDevice := &tables.Device{","+\t\tAddrs: []tables.DeviceAddress{","+\t\t\t{Addr: netip.MustParseAddr(\"192.0.2.10\")},","+\t\t\t{Addr: netip.MustParseAddr(\"2001:db8::10\")},","+\t\t},","+\t}","+","+\ttests := []struct {","+\t\tname         string","+\t\tipv4Prefix   netip.Prefix","+\t\tipv6Prefix   netip.Prefix","+\t\tdevice       *tables.Device","+\t\texpectedIPv4 netip.Prefix","+\t\texpectedIPv6 netip.Prefix","+\t}{","+\t\t{","+\t\t\tname:         \"configured prefixes\",","+\t\t\tipv4Prefix:   netip.MustParsePrefix(\"198.51.100.0/24\"),","+\t\t\tipv6Prefix:   netip.MustParsePrefix(\"2001:db8:1::/64\"),","+\t\t\tdevice:       directRoutingDevice,","+\t\t\texpectedIPv4: netip.MustParsePrefix(\"198.51.100.0/24\"),","+\t\t\texpectedIPv6: netip.MustParsePrefix(\"2001:db8:1::/64\"),","+\t\t},","+\t\t{","+\t\t\tname:         \"direct-routing device fallbacks\",","+\t\t\tdevice:       directRoutingDevice,","+\t\t\texpectedIPv4: netip.MustParsePrefix(\"192.0.2.10/32\"),","+\t\t\texpectedIPv6: netip.MustParsePrefix(\"2001:db8::10/128\"),","+\t\t},","+\t\t{","+\t\t\tname:         \"unspecified fallbacks\",","+\t\t\texpectedIPv4: netip.MustParsePrefix(\"0.0.0.0/32\"),","+\t\t\texpectedIPv6: netip.MustParsePrefix(\"::/128\"),","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tactual := NewRSSConfig(tt.ipv4Prefix, tt.ipv6Prefix, tt.device)","+\t\t\trequire.Equal(t, tt.expectedIPv4, actual.IPv4Prefix())","+\t\t\trequire.Equal(t, tt.expectedIPv6, actual.IPv6Prefix())","+\t\t})","+\t}","+}",""],"additions":59,"deletions":0,"truncated":false}],"additions":145,"deletions":26,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-09-08T12:19:33.791463+00:00"}