\"config_name\", extension_name.empty() ? \"default\" : extension_name}},","+          absl::StrCat(\"extension_config_discovery.bootstrap.\",","+                       Stats::Utility::sanitizeStatsName(name), \".\",","+                       Stats::Utility::sanitizeStatsName(","+                           extension_name.empty() ? \"default\" : extension_name)))) {}","+","+absl::StatusOr<std::unique_ptr<ExtensionConfigSubscription>> ExtensionConfigSubscription::create(","+    absl::string_view name, const envoy::config::core::v3::ExtensionConfigSource& source,","+    absl::string_view extension_name, Server::Configuration::ServerFactoryContext& context,","+    UpdateCallback callback) {","+  if (name.empty() || name == \"*\") {","+    return absl::InvalidArgumentError(\"bootstrap ECDS requires a single resource name\");","+  }","+  auto normalized = Config::XdsResourceIdentifier::normalizeResourceName(name);","+  RETURN_IF_NOT_OK(normalized.status());","+  if (Config::XdsResourceIdentifier::hasXdsTpScheme(name)) {","+    auto urn = Config::XdsResourceIdentifier::decodeUrn(name);","+    RETURN_IF_NOT_OK(urn.status());","+    if (absl::EndsWith(urn->id(), \"*\")) {","+      return absl::InvalidArgumentError(\"bootstrap ECDS does not support wildcard resource names\");","+    }","+  }","+  MessageUtil::validate(source, context.messageValidationContext().dynamicValidationVisitor());","+  MessageUtil::validate(source.config_source(),","+                        context.messageValidationContext().dynamicValidationVisitor());","+  if (std::any_of(source.type_urls().begin(), source.type_urls().end(),","+                  [](const auto& type) { return type.empty(); })) {","+    return absl::InvalidArgumentError(\"bootstrap ECDS payload type URLs must be nonempty\");","+  }","+  if (source.has_default_config() || source.apply_default_config_without_warming()) {","+    return absl::InvalidArgumentError(\"bootstrap ECDS does not support default configurations\");","+  }","+  auto result = std::unique_ptr<ExtensionConfigSubscription>(new ExtensionConfigSubscription(","+      *normalized, source, extension_name, context, std::move(callback)));","+  if (source.config_source().has_ads() || Config::XdsResourceIdentifier::hasXdsTpScheme(name)) {","+    auto reservation =","+        Config::EcdsSubscriptionRegistry::get(context.singletonManager())","+            ->reserve(*normalized, Config::EcdsSubscriptionRegistry::Sharing::Exclusive);","+    RETURN_IF_NOT_OK(reservation.status());","+    result->name_reservation_ = std::move(*reservation);","+  }","+  auto subscription = context.xdsManager().subscribeToSingletonResource(","+      *normalized, source.config_source(),","+      Config::getTypeUrl<envoy::config::core::v3::TypedExtensionConfig>(), *result->scope_, *result,","+      result->resource_type_.resourceDecoder(), {});","+  RETURN_IF_NOT_OK(subscription.status());","+  result->subscription_ = std::move(*subscription);","+  result->subscriptions_ = ExtensionConfigSubscriptions::get(context);","+  result->subscriptions_->subscriptions_.insert(result.get());","+  return result;","+}","+","+ExtensionConfigSubscription::~ExtensionConfigSubscription() {","+  if (subscriptions_ != nullptr) {","+    subscriptions_->subscriptions_.erase(this);","+  }","+}","+","+void ExtensionConfigSubscription::start() { subscription_->start({name_}); }","+","+void ExtensionConfigSubscription::removeConfig() {","+  if (!callback_(name_, \"\", \"\", envoy_dynamic_module_type_bootstrap_ecds_config_encoding_Protobuf,","+                 std::nullopt)) {","+    ENVOY_LOG(warn, \"bootstrap module rejected ECDS removal for {}\", name_);"],"additions":118,"deletions":0,"truncated":false}],"additions":429,"deletions":2,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-21T16:32:28.126739+00:00"}