"lines":["@@ -1,31 +0,0 @@","-<?php","-/**","- * Preload paths for the DataForm-based editor inspector experiment.","- *","- * @package gutenberg","- */","-","-/**","- * Filters the block editor preload paths.","- *","- * @param array                   $paths   REST API paths to preload.","- * @param WP_Block_Editor_Context $context Block editor context.","- * @return array Filtered preload paths.","- */","-function gutenberg_dataform_inspector_preload_paths( $paths, $context ) {","-\tif ( 'core/edit-post' !== $context->name || ! isset( $context->post ) ) {","-\t\treturn $paths;","-\t}","-","-\t// `DataFormPostSummary` requests the post type form config through","-\t// `useViewConfig` with `fields: [ 'form' ]`, so the preload path must","-\t// match the resulting `_fields=form` REST API request.","-\t$paths[] = '/wp/v2/view-config?kind=postType&name=' . $context->post->post_type . '&_fields=form';","-","-\t// `DataFormPostSummary` reads the fields of the post type through","-\t// `useFields`, from the `wp/v2/entity-fields` route.","-\t$paths = array_merge( $paths, _gutenberg_get_post_type_fields_preload_paths( array( $context->post->post_type ) ) );","-","-\treturn $paths;","-}","-add_filter( 'block_editor_rest_api_preload_paths', 'gutenberg_dataform_inspector_preload_paths', 10, 2 );"],"additions":0,"deletions":31,"truncated":false},{"path":"lib/experimental/editor-settings.php","lines":["@@ -23,9 +23,6 @@ function gutenberg_enable_experiments() {"," \tif ( gutenberg_is_experiment_enabled( 'gutenberg-extensible-site-editor' ) ) {"," \t\twp_add_inline_script( 'wp-block-editor', 'window.__experimentalExtensibleSiteEditor = true', 'before' );"," \t}","-\tif ( gutenberg_is_experiment_enabled( 'gutenberg-dataform-inspector' ) ) {","-\t\twp_add_inline_script( 'wp-editor', 'window.__experimentalDataFormInspector = true', 'before' );","-\t}"," \tif ( gutenberg_is_experiment_enabled( 'gutenberg-media-editor' ) ) {"," \t\twp_add_inline_script( 'wp-block-editor', 'window.__ex