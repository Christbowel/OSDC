 post type from the server, through the Entity fields API. The media editor also lays out the attachment fields with the form of the attachment view configuration ([#84700](https://github.com/WordPress/gutenberg/pull/84700))."," -   Notes: Mark noted content in the author's color at rest. Inline notes get a tint and an underline that thickens when the note is selected, and block-level notes tint the whole block with an outline around it. Selecting a note outlines its block instead of dimming the rest of the canvas, and hiding notes hides the marks ([#80578](https://github.com/WordPress/gutenberg/pull/80578))."],"additions":1,"deletions":0,"truncated":false},{"path":"packages/editor/src/components/post-template/block-theme.jsx","lines":["@@ -138,6 +138,8 @@ export default function BlockThemeControl() {"," \t\t\t\t\t\t\t) }"," \t\t\t\t\t\t\t<SwapTemplateButton"," \t\t\t\t\t\t\t\tonClick={ () => setActiveModal( 'swap' ) }","+\t\t\t\t\t\t\t\t// The menu has its own \"Use default template\" item.","+\t\t\t\t\t\t\t\tincludeDefaultTemplate={ false }"," \t\t\t\t\t\t\t/>"," \t\t\t\t\t\t\t<ResetDefaultTemplate />"," \t\t\t\t\t\t\t{ canCreateTemplate && (","@@ -178,6 +180,7 @@ export default function BlockThemeControl() {"," \t\t\t{ activeModal === 'swap' && ("," \t\t\t\t<SwapTemplateModal"," \t\t\t\t\tonRequestClose={ () => setActiveModal( null ) }","+\t\t\t\t\tincludeDefaultTemplate={ false }"," \t\t\t\t/>"," \t\t\t) }"," \t\t\t{ activeModal === 'create' && ("],"additions":3,"deletions":0,"truncated":false},{"path":"packages/editor/src/components/post-template/hooks.js","lines":["@@ -58,7 +58,16 @@ function useTemplates( postType ) {"," \t);"," }"," ","-export function useAvailableTemplates() {","+/**","+ * Returns the templates the edited post can switch to.","+ *","+ * @param {Object}  [options]","+ * @param {boolean} [options.includeDefaultTemplate] Whether to append the default template.","+ * @return {Array|false} The templates, or `false` when switching is not allowed.