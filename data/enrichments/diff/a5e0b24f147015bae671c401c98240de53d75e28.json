,"+\tit( 'returns an existing sync manager after real-time collaboration is disabled', () => {","+\t\twindow.__experimentalEnableRealTimeCollaboration = true;","+\t\tconst { getSyncManager } = loadSync();","+\t\tconst existingSyncManager = getSyncManager();","+","+\t\twindow.__experimentalEnableRealTimeCollaboration = false;","+","+\t\texpect( getSyncManager() ).toBe( existingSyncManager );","+\t\texpect( mockCreateSyncManager ).toHaveBeenCalledTimes( 1 );","+\t} );","+} );"],"additions":56,"deletions":0,"truncated":false},{"path":"packages/editor/CHANGELOG.md","lines":["@@ -2,6 +2,10 @@"," "," ## Unreleased"," ","+### Internal","+","+-   Check the `window.__experimentalEnableRealTimeCollaboration` flag set by the Real-Time Collaboration experiment, instead of `window._wpCollaborationEnabled`, when determining whether collaboration is enabled for the current post ([#80658](https://github.com/WordPress/gutenberg/pull/80658)).","+"," ### Bug Fixes"," "," -   Register the editor and block editor keyboard shortcuts from the editor provider, so shortcuts work for consumers that mount the editor without rendering `EditorKeyboardShortcutsRegister` themselves ([#81580](https://github.com/WordPress/gutenberg/pull/81580))."],"additions":4,"deletions":0,"truncated":false},{"path":"packages/editor/src/store/private-selectors.js","lines":["@@ -594,7 +594,7 @@ export const isCollaborationEnabledForCurrentPost = createRegistrySelector("," \t\treturn Boolean("," \t\t\tsyncConfig &&"," \t\t\t\tsyncConfig.supportsPersistence &&","-\t\t\t\twindow._wpCollaborationEnabled &&","+\t\t\t\twindow.__experimentalEnableRealTimeCollaboration &&"," \t\t\t\tfalse !=="," \t\t\t\t\tsyncConfig.shouldSync?.("," \t\t\t\t\t\t`postType/${ currentPostType }`,"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/editor/src/store/test/private-selectors.js","lines":["@@ -85,12 +85,14 @@ describe( 'isCollaborationEnabledForCurrentPost', () => {"," \tlet originalCollaborationEnabled;"," "," \tbeforeEach( () => {","-\t\toriginalCollaborationEnabled = window._wpCollaborationEnabled;","-\t\twindow._wpCollaborationEnabled = true;","+\t\toriginalCollaborationEnabled =","+\t\t\twindow.__experimentalEnableRealTimeCollaboration;","+\t\twindow.__experimentalEnableRealTimeCollaboration = true;"," \t} );"," "," \tafterEach( () => {","-\t\twindow._wpCollaborationEnabled = originalCollaborationEnabled;","+\t\twindow.__experimentalEnableRealTimeCollaboration =","+\t\t\toriginalCollaborationEnabled;"," \t} );"," "," \tfunction setupRegistry( {"],"additions":5,"deletions":3,"truncated":false},{"path":"packages/sync/CHANGELOG.md","lines":["@@ -5,6 +5,7 @@"," ### Internal"," "," -   Split tsconfig into a build project and a default dev project so dev files are type checked without publishing their declarations. ([#81514](https://github.com/WordPress/gutenberg/pull/81514))","+-   Provide the default HTTP polling provider only when the Real-Time Collaboration experiment sets `window.__experimentalEnableRealTimeCollaboration`, replacing the `window._wpCollaborationEnabled` option flag ([#80658](https://github.com/WordPress/gutenberg/pull/80658))."," "," ## 1.53.0 (2026-08-12)"," "],"additions":1,"deletions":0,"truncated":false},{"path":"packages/sync/CODE.md","lines":["@@ -12,7 +12,7 @@ Relevant docs and discussions:"," "," -   **CRDT document**: A [Yjs `Y.Doc`](https://docs.yjs.dev/api/y.doc) that holds synced entity data. CRDTs (Conflict-free Replicated Data Types) allow concurrent edits from multiple peers to be merged automatically without conflicts."," -   **Sync manager**: Orchestrates the lifecycle of synced entities: creating CRDT documents, connecting providers, attaching observers, and coordinating updates.","--   **Provider**: A transport layer that syncs CRDT document updates between peers. The default provider uses HTTP polling; plugins can substitute their own provider via the `sync.providers` filter.","+-   **Provider**: A transport layer that syncs CRDT document updates between peers. The Real-Time Collaboration experiment uses HTTP polling by default; plugins can replace it via the `sync.providers` filter."," -   **Awareness**: Ephemeral presence state (e.g., cursor positions, user identity) shared between peers. Unlike CRDT document state, awareness is not persisted."," -   **Sync config**: An entity-level configuration object that defines how local changes are written to the CRDT document and how remote changes are extracted from it. See the `SyncConfig` type in `src/types.ts`."," -   **Origin**: A value attached to each Yjs transaction to identify the source of a change (e.g., local editor, sync manager, undo manager, or remote peer). Origins are used to decide which changes should trigger store updates and which should be tracked by the undo manager.","@@ -60,9 +60,9 @@ The sync config \"owns\" the sync behavior of the entity; it has sole knowledge of"," "," A provider is a transport layer that syncs Yjs document updates between peers. This package uses a pluggable provider system defined in `src/providers/`."," ","-### Default: HTTP polling","+### Default HTTP polling provider"," ","-The default provider (`src/providers/http-polling/`) uses HTTP polling to exchange updates with a central sync server. A shared polling manager batches updates for all rooms (entities) into a single request per poll cycle. See [the HTTP polling README](./src/providers/http-polling/README.md) for full details including the REST API format, sync protocol, and compaction.","+When the **Real-Time Collaboration** experiment is enabled, the default provider (`src/providers/http-polling/`) uses HTTP polling to exchange updates with a central sync server. Plugins can replace the polling provider through the `sync.providers` filter. A shared polling manager batches updates for all rooms (entities) into a single request per poll cycle. See [the HTTP polling README](./src/providers/http-polling/README.md) for full details including the REST API format, sync protocol, and compaction."," "," -   Poll interval: 4 seconds when editing alone, 1 second when collaborators are detected."," -   The `sync.pollingManager.pollingInterval` and `sync.pollingManager.pollingIntervalWithCollaborators` filters can make active-tab polling faster, but slower values are clamped to the defaults."],"additions":3,"deletions":3,"truncated":false},{"path":"packages/sync/src/providers/http-polling/README.md","lines":["@@ -2,9 +2,11 @@"," "," A Yjs provider for Gutenberg that enables real-time synchronization via HTTP polling. Since PHP has no native Yjs library, this implementation uses a relay approach where the server stores and forwards messages while clients handle all CRDT operations."," ","+When the **Real-Time Collaboration** experiment is enabled, HTTP polling is enabled as the default sync provider. Plugins can replace it through the `sync.providers` filter.","+"," ## Architecture"," ","-```","+```text"," ┌─────────────────┐                              ┌─────────────────┐"," │    Client A     │                              │    Client B     │"," │  ┌───────────┐  │                              │  ┌───────────┐  │"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/sync/src/providers/index.ts","lines":["@@ -5,13 +5,15 @@ import type { ProviderCreator } from '../types';"," let providerCreators: ProviderCreator[] | null = null;"," "," /**","- * Returns the defeault provider creators. HTTP polling is the current default","- * provider.","+ * Returns the default provider creators. HTTP polling is the default when","+ * real-time collaboration is enabled.","  *","  * @return {ProviderCreator[]} Creator functions for Yjs providers.","  */"," export function getDefaultProviderCreators(): ProviderCreator[] {","-\treturn [ createHttpPollingProvider() ];","+\treturn window.__experimentalEnableRealTimeCollaboration","+\t\t? [ createHttpPollingProvider() ]","+\t\t: [];"," }"," "," /**","@@ -34,8 +36,8 @@ export function getProviderCreators(): ProviderCreator[] {"," \t\treturn providerCreators;"," \t}"," ","-\t// Check if real-time collaboration is enabled via WordPress setting.","-\tif ( ! window._wpCollaborationEnabled ) {","+\t// Check if real-time collaboration is enabled.","+\tif ( ! window.__experimentalEnableRealTimeCollaboration ) {"," \t\treturn [];"," \t}"," "],"additions":7,"deletions":5,"truncated":false},{"path":"packages/sync/src/providers/test/index.test.ts","lines":["@@ -0,0 +1,88 @@","+import { afterEach, describe, expect, it, jest } from '@jest/globals';","+import type { ProviderCreator } from '../../types';","+","+type ProvidersModule = typeof import('../index');","+type ApplyFilters = ( hookName: string, defaultValue: unknown ) => unknown;","+","+function createMockProviderCreator(): ProviderCreator {","+\treturn async () => ( {"],"additions":8,"deletions":0,"truncated":false}],"additions":231,"deletions":169,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-08-19T08:08:01.255811+00:00"}