ect(popover).toHaveTextContent('Fee breakdown');","+    expect(trigger).toHaveAttribute('aria-describedby', popover.id);","+","+    await act(async () => {","+      fireEvent.mouseLeave(trigger);","+    });","+    await waitFor(() => {","+      expect(screen.queryByTestId('sample-tooltip')).not.toBeInTheDocument();","+    });","+","+    await act(async () => {","+      fireEvent.focus(trigger);","+    });","+    expect(screen.getByTestId('sample-tooltip')).toHaveTextContent(","+      'Fee breakdown',","+    );","+","+    await act(async () => {","+      fireEvent.blur(trigger);","+    });","+    expect(screen.queryByTestId('sample-tooltip')).not.toBeInTheDocument();","+","+    await act(async () => {","+      fireEvent.click(trigger);","+    });","+    expect(screen.getByTestId('sample-tooltip')).toHaveTextContent(","+      'Fee breakdown',","+    );","+  });","+","+  it('stays open when clicked after mouseEnter and focus', async () => {","+    renderWithProvider(","+      <DottedTriggerTooltip data-testid=\"click-after-hover\" text=\"$1.23\">","+        <span>Fee breakdown</span>","+      </DottedTriggerTooltip>,","+      store,","+    );","+","+    const trigger = screen.getByTestId('click-after-hover-trigger');","+","+    await act(async () => {","+      fireEvent.mouseEnter(trigger);","+      fireEvent.focus(trigger);","+      fireEvent.click(trigger);","+    });","+","+    expect(screen.getByTestId('click-after-hover')).toHaveTextContent(","+      'Fee breakdown',","+    );","+  });","+","+  it('stays open when moving the pointer from the trigger onto the popover', async () => {","+    renderWithProvider(","+      <DottedTriggerTooltip data-testid=\"hover-bridge-tooltip\" text=\"$1.23\">","+        <span>Fee breakdown</span>","+      </DottedTriggerTooltip>,","+      store,","+    );","+","+    const trigger = screen.getByTestId('hover-bridge-tooltip-trigger');","+","+    await act(async () => {","+      fireEvent.mouseEnter(trigger);","+    });","+    const po