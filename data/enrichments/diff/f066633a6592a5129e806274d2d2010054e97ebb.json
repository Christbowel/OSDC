ttonElement | null>(null);","+  const closeTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);","+  const popoverId = useId();","+","+  const clearCloseTimer = useCallback(() => {","+    if (closeTimerRef.current !== null) {","+      clearTimeout(closeTimerRef.current);","+      closeTimerRef.current = null;","+    }","+  }, []);","+","+  useEffect(() => clearCloseTimer, [clearCloseTimer]);","+","+  const setTriggerRef = useCallback((node: HTMLButtonElement | null) => {","+    setReferenceElement(node);","+  }, []);","+","+  const handleOpen = useCallback(() => {","+    clearCloseTimer();","+    setIsOpen(true);","+  }, [clearCloseTimer]);","+","+  const handleClose = useCallback(() => {","+    clearCloseTimer();","+    setIsOpen(false);","+  }, [clearCloseTimer]);","+","+  const handleScheduleClose = useCallback(() => {","+    clearCloseTimer();","+    closeTimerRef.current = setTimeout(() => {","+      closeTimerRef.current = null;","+      setIsOpen(false);","+    }, POPOVER_CLOSE_DELAY_MS);","+  }, [clearCloseTimer]);","+","+  return (","+    <Box>","+      <DottedTrigger","+        ref={setTriggerRef}","+        aria-describedby={isOpen ? popoverId : undefined}","+        color={textColor}","+        data-testid={dataTestId ? `${dataTestId}-trigger` : undefined}","+        onBlur={handleClose}","+        onClick={handleOpen}","+        onFocus={handleOpen}","+        onMouseEnter={handleOpen}","+        onMouseLeave={handleScheduleClose}","+        text={text}","+        variant={textVariant}","+      />","+      <Popover","+        data-testid={dataTestId}","+        flip","+        hasArrow","+        id={popoverId}","+        isOpen={isOpen}","+        isPortal","+        offset={offset}","+        onClickOutside={handleClose}","+        onMouseEnter={handleOpen}","+        onMouseLeave={handleScheduleClose}","+        onPressEscKey={handleClose}","+        position={position}","+        preventOverflow","+        referenceElement={referenceElemen