builds(&config).unwrap();","+","+    assert_eq!(pending.by_package, self::pending(&[(\"drizzle-kit\", &[Skills])]));","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global.rs","lines":["@@ -729,6 +729,64 @@ fn approve_builds_global_approves_every_install_group() {","     drop(root);"," }"," ","+/// A denial recorded after the install, here in the global packages","+/// directory's `pnpm-workspace.yaml`, survives `--all` although the stale","+/// `ignoredBuilds` still lists the package.","+#[cfg(unix)]","+#[test]","+fn approve_builds_global_all_keeps_a_legacy_denial() {","+    use assert_cmd::assert::OutputAssertExt;","+","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let pnpm_home = root.path().join(\"pnpm-home\");","+    let global_pkg_dir = pnpm_home.join(\"global\").join(\"v11\");","+    prepare_global_home(&pnpm_home, &npmrc_info);","+","+    for package in [","+        \"@pnpm.e2e/install-script-example@1.0.0\",","+        \"@pnpm.e2e/pre-and-postinstall-scripts-example@1.0.0\",","+    ] {","+        global_command(&workspace, &pnpm_home)","+            .with_args([\"add\", \"-g\", package])","+            .assert()","+            .success();","+    }","+    fs::write(","+        global_pkg_dir.join(\"pnpm-workspace.yaml\"),","+        \"allowBuilds:\\n  '@pnpm.e2e/pre-and-postinstall-scripts-example': false\\n\",","+    )","+    .expect(\"write the legacy denial\");","+","+    global_command(&workspace, &pnpm_home)","+        .with_args([\"approve-builds\", \"-g\", \"--all\"])","+        .assert()","+        .success();","+","+    let built = |name: &str, file: &str| {","+        pnpm_global::find_global_package(&global_pkg_dir, name)","+            .expect(\"scan global packages\")","+            .expect(\"find the install group\")","+            .install_dir","+            .join(\"node_modules\")","+            .join(name)","+            .join(file)","+            .exists()","+    };","+    assert!(built(\"@pnpm.e2e/install-script-example\", \"generated-by-install.js\"));","+    assert!(","+        !built(\"@pnpm.e2e/pre-and-postinstall-scripts-example\", \"generated-by-postinstall.js\"),","+        \"the denied build must not run\",","+    );","+    assert_eq!(","+        fs::read_to_string(global_config_yaml(&pnpm_home)).expect(\"read the global config\"),","+        \"globalPackagesConfig:\\n  permissions:\\n    '@pnpm.e2e/install-script-example':\\n      build: true\\n    '@pnpm.e2e/pre-and-postinstall-scripts-example':\\n      build: false\\n\",","+    );","+","+    drop(npmrc_info);","+    drop(root);","+}","+"," #[cfg(unix)]"," #[test]"," fn global_add_runs_the_builds_global_packages_allows() {"],"additions":58,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/build_modules/allow_build_policy.rs","lines":["@@ -4,6 +4,7 @@ pub use pnpm_package_name::{","     git_repo_allow_build_key_from_dep_path,","     is_git_hosted_dep_path,","     parse_dep_path_name_version,","+    registry_version,","     short_package_label,"," };"," ","@@ -185,7 +186,9 @@ impl AllowBuildPolicy {","         let git_repo_key = git_repo_allow_build_key_from_dep_path(&normalized_dep_path);","         let git_repo_key = git_repo_key.as_deref();","         let (name, version) = parse_name_version_from_key(&normalized_dep_path);","-        let name_at_version = format!(\"{name}@{version}\");","+        // A `name@version` denial also blocks the same version from a named","+        // registry. Approvals stay registry-exact, see below.","+        let name_at_version = format!(\"{name}@{}\", registry_version(&version).unwrap_or(&version));","         if self.denies(&normalized_dep_path, git_repo_key, (&name, &name_at_version)) {","             return Some(false);","         }","@@ -198,10 +201,13 @@ impl AllowBuildPolicy {","             return Some(true);","         }","         // Package-name rules re