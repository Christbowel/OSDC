ualHostExists(\"nonexistent.com\"));","+    EXPECT_FALSE(config.virtualHostExists(\"example.org\"));","+","+    // Wildcard domain match (suffix and prefix)","+    EXPECT_TRUE(config.virtualHostExists(\"sub.wildcard-suffix.com\"));","+    EXPECT_TRUE(config.virtualHostExists(\"wildcard-prefix.net\"));","+    EXPECT_FALSE(config.virtualHostExists(\"wildcard-suffix.com\"));","+    EXPECT_FALSE(config.virtualHostExists(\"other-prefix.com\"));","+","+    // Port in domain with ignore_port_in_host_matching = false (returns false)","+    EXPECT_FALSE(config.virtualHostExists(\"example.com:8080\"));","+    EXPECT_FALSE(config.virtualHostExists(\"sub.wildcard-suffix.com:443\"));","+  }","+","+  // Set ignore_port_in_host_matching to true","+  route_configuration.set_ignore_port_in_host_matching(true);","+  {","+    TestConfigImpl config(route_configuration, factory_context_, true, creation_status_);","+","+    // Port in domain with ignore_port_in_host_matching = true (returns true)","+    EXPECT_TRUE(config.virtualHostExists(\"example.com:8080\"));","+    EXPECT_TRUE(config.virtualHostExists(\"EXAMPLE.COM:8080\"));","+    EXPECT_TRUE(config.virtualHostExists(\"sub.wildcard-suffix.com:443\"));","+    EXPECT_FALSE(config.virtualHostExists(\"nonexistent.com:8080\"));","+  }","+","+  // Default virtual host (\"*\") returns true for arbitrary domains","+  const std::string default_vhost_yaml = R\"EOF(","+virtual_hosts:","+- name: default_vhost","+  domains: [\"*\"]","+  routes:","+  - match:","+      prefix: \"\"","+    route:","+      cluster: dummy","+  )EOF\";","+  auto default_route_configuration = parseRouteConfigurationFromYaml(default_vhost_yaml);","+  {","+    TestConfigImpl config(default_route_configuration, factory_context_, true, creation_status_);","+","+    EXPECT_TRUE(config.virtualHostExists(\"example.com\"));","+    EXPECT_TRUE(config.virtualHostExists(\"any.random.domain.org\"));","+    EXPECT_TRUE(config.virtualHostExists(\"\"));","+  }","+","+  // Empty virtual_hosts returns false for all domains","+  {","+    envoy::config::route::v3::RouteConfiguration empty_route_configuration;","+    TestConfigImpl config(empty_route_configuration, factory_context_, true, creation_status_);","+","+    EXPECT_FALSE(config.virtualHostExists(\"example.com\"));","+    EXPECT_FALSE(config.virtualHostExists(\"\"));","+  }","+","+  // Alternate vhost_header does not affect direct domain matching in virtualHostExists","+  {","+    auto vhost_header_route_configuration = route_configuration;","+    vhost_header_route_configuration.set_vhost_header(\"alternate\");","+    TestConfigImpl config(vhost_header_route_configuration, factory_context_, true,","+                          creation_status_);","+","+    EXPECT_TRUE(config.virtualHostExists(\"example.com\"));","+    EXPECT_FALSE(config.virtualHostExists(\"nonexistent.com\"));","+  }","+}","+"," TEST_F(RouteMatcherTest, Priority) {","   const std::string yaml = R\"EOF("," virtual_hosts:"],"additions":108,"deletions":0,"truncated":false},{"path":"test/common/router/static_route_provider_impl_test.cc","lines":["@@ -184,8 +184,7 @@ name: foo","   EXPECT_EQ(\"foo\", provider.configCast()->name());","   EXPECT_TRUE(provider.configInfo().has_value());","   auto config_impl = std::static_pointer_cast<const ConfigImpl>(provider.configCast());","-  EXPECT_TRUE(config_impl->virtualHostExists(","-      Http::TestRequestHeaderMapImpl{{\":authority\", \"example.com\"}}));","+  EXPECT_TRUE(config_impl->virtualHostExists(\"example.com\"));"," }"," "," // An inline route configuration that uses VHDS warms up: whatever initializes with it, i.e. the","@@ -260,8 +259,7 @@ name: foo","   EXPECT_OK(vhds_callbacks->onConfigUpdate(decoded_resources.refvec_, {}, \"1\"));"," ","   const auto config_impl = std::static_pointer_cast<const ConfigImpl>(provider.configCast());","-  EXPECT_TRUE(","-      config_impl->virtualHostExists(Http::TestRequestHeaderMapImpl{{\":authority\", \"vhds.com\"}}));","+  EXPECT_TRUE(conf