{"id":"c4b5c5f416bf09574a53bc5a90f5061f0b2ff659","axis":"silent","repo":"pnpm/pnpm","sha":"c4b5c5f416bf09574a53bc5a90f5061f0b2ff659","parsed":{"files":[{"path":".changeset/hoisted-project-modules-dir.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.deps-restorer\": patch","+\"pacquet\": patch","+\"pnpm\": patch","+---","+","+With `nodeLinker: hoisted` and a custom `modulesDir`, pnpm now installs a workspace project's dependencies that cannot be hoisted to the root into the project's `modulesDir`. The next install that relinks the project removes the copies that earlier installs left in its `node_modules`. Package directories that pnpm did not install are now also moved to `.ignored` in a custom `modulesDir`."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hoisted_node_linker.rs","lines":["@@ -1204,6 +1204,8 @@ fn peer_variants_with_distinct_peers_are_nested_for_node_resolution() {"," #[cfg(unix)]"," mod local_symlinks;"," ","+mod modules_dir;","+"," mod repeat_install;"," "," mod scripts;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hoisted_node_linker/modules_dir.rs","lines":["@@ -0,0 +1,157 @@","+use super::{","+    AddMockedRegistry, CommandTempCwd, fs, fs_remove_dir_all, is_real_dir, pacquet_at,","+    read_pkg_version, write_workspace_yaml,","+};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use std::path::Path;","+","+fn write_workspace_with_conflicting_ms(workspace: &Path) {","+    write_workspace_yaml(","+        workspace,","+        \"nodeLinker: hoisted\\nmodulesDir: vendor\\npackages:\\n  - 'packages/*'\\n\",","+    );","+    let root_manifest = serde_json::json!({","+        \"name\": \"ws-root\",","+        \"version\": \"0.0.0\",","+        \"private\": true,","+        \"dependencies\": { \"ms\": \"2.1.3\" },","+    });","+    fs::write(workspace.join(\"package.json\"), root_manifest.to_string())","+        .expect(\"write root package.json\");","+    fs::create_dir_all(workspace.join(\"packages/foo\")).expect(\"mkdir packages/foo\");","+    let foo_manifest = serde_json::json!({","+        \"name\": \"foo\",","+        \"version\": \"1.0.0\",","+        \"dependencies\": { \"ms\": \"2.0.0\" },","+    });","+    fs::write(workspace.join(\"packages/foo/package.json\"), foo_manifest.to_string())","+        .expect(\"write packages/foo/package.json\");","+}","+","+fn assert_ms_in_vendor_dirs(workspace: &Path) {","+    assert!(is_real_dir(workspace, \"vendor/ms\"));","+    assert_eq!(read_pkg_version(workspace, \"vendor/ms\"), \"2.1.3\");","+    assert!(is_real_dir(workspace, \"packages/foo/vendor/ms\"));","+    assert_eq!(read_pkg_version(workspace, \"packages/foo/vendor/ms\"), \"2.0.0\");","+    assert!(!workspace.join(\"node_modules/ms\").exists());","+    assert!(!workspace.join(\"packages/foo/node_modules/ms\").exists());","+}","+","+#[test]","+fn a_project_dependency_kept_in_the_project_goes_in_its_modules_dir() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace_with_conflicting_ms(&workspace);","+","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert_ms_in_vendor_dirs(&workspace);","+","+    pacquet_at(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert_ms_in_vendor_dirs(&workspace);","+","+    fs_remove_dir_all(&workspace.join(\"vendor\"));","+    fs_remove_dir_all(&workspace.join(\"packages/foo/vendor\"));","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+    assert_ms_in_vendor_dirs(&workspace);","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn an_unplanned_package_in_a_modules_dir_is_quarantined() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace_with_conflicting_ms(&workspace);","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    for modules_dir in [\"vendor\", \"packages/foo/vendor\"] {","+        let stray = workspace.join(modules_dir).join(\"stray\");","+        fs::create_dir_all(&stray).expect(\"mkdir stray\");","+        fs::write(stray.join(\"package.json\"), r#\"{\"name\":\"stray\",\"version\":\"1.0.0\"}\"#)","+            .expect(\"write stray package.json\");","+    }","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--force\"])","+        .assert()","+        .success();","+","+    for modules_dir in [\"vendor\", \"packages/foo/vendor\"] {","+        let modules_dir = workspace.join(modules_dir);","+        eprintln!(\"checking {modules_dir:?}\");","+        assert!(!modules_dir.join(\"stray\").exists());","+        assert!(modules_dir.join(\".ignored/stray/package.json\").exists());","+    }","+","+    drop((root, mock_instance));","+}","+","+/// Only the recorded locations name the copy in `node_modules`. A changed","+/// manifest makes the install relink rather than report it up to date.","+#[test]","+fn an_install_removes_a_project_copy_an_earlier_layout_left_in_node_modules() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace_with_conflicting_ms(&workspace);","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let legacy_copy = workspace.join(\"packages/foo/node_modules/ms\");","+    fs::create_dir_all(legacy_copy.parent().unwrap()).expect(\"mkdir packages/foo/node_modules\");","+    fs::rename(workspace.join(\"packages/foo/vendor/ms\"), &legacy_copy).expect(\"move the copy\");","+    let modules_yaml = workspace.join(\"vendor/.modules.yaml\");","+    let manifest = fs::read_to_string(&modules_yaml).expect(\"read .modules.yaml\");","+    assert!(manifest.contains(\"packages/foo/vendor/ms\"), \"{manifest}\");","+    let legacy_manifest =","+        manifest.replace(\"packages/foo/vendor/ms\", \"packages/foo/node_modules/ms\");","+    fs::write(&modules_yaml, legacy_manifest).expect(\"write .modules.yaml\");","+","+    let foo_manifest = serde_json::json!({","+        \"name\": \"foo\",","+        \"version\": \"1.0.0\",","+        \"dependencies\": { \"ms\": \"~2.0.0\" },","+    });","+    fs::write(workspace.join(\"packages/foo/package.json\"), foo_manifest.to_string())","+        .expect(\"write packages/foo/package.json\");","+    pacquet_at(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    assert!(!legacy_copy.exists());","+    assert_ms_in_vendor_dirs(&workspace);","+","+    drop((root, mock_instance));","+}"],"additions":157,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/modules_dir.rs","lines":["@@ -505,14 +505,17 @@ fn the_hoisted_linker_installs_into_a_custom_modules_dir() {","             .success();","         assert_eq!(installed_version(&workspace.join(\"deps/vendor\")), \"3.1.0\", \"{args:?}\");","         assert_eq!(","-            installed_version(&workspace.join(\"project-1/node_modules\")),","+            installed_version(&workspace.join(\"project-1/deps/vendor\")),","             \"1.0.0\",","             \"{args:?}\",","         );","+        assert!(!workspace.join(\"project-1/node_modules\").exists(), \"{args:?}\");","         assert!(!workspace.join(\"node_modules/is-positive\").exists(), \"{args:?}\");","         assert!(workspace.join(\"deps/vendor/.pnpm/lock.yaml\").is_file(), \"{args:?}\");","         assert!(!workspace.join(\"vendor\").exists(), \"{args:?}\");","         fs::remove_dir_all(workspace.join(\"deps/vendor\")).expect(\"remove deps/vendor\");","+        fs::remove_dir_all(workspace.join(\"project-1/deps/vendor\"))","+            .expect(\"remove project-1/deps/vendor\");","     }"," ","     drop((root, mock_instance));"],"additions":4,"deletions":1,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/hoisted_dep_graph.rs","lines":["@@ -24,7 +24,9 @@ use presence::{"," mod walk;"," use walk::{PackageLocations, WalkState, walk_deps};"," ","-use crate::{HoistedLocations, safe_join_modules_dir::InvalidDependencyAliasError};","+use crate::{","+    HoistedLocations, ImporterModulesDirs, safe_join_modules_dir::InvalidDependencyAliasError,","+};"," use derive_more::{Display, Error, From};"," use miette::Diagnostic;"," use pnpm_lockfile::{Lockfile, LockfileResolution, ParsePkgNameVerPeerError, PkgIdWithPatchHash};","@@ -34,7 +36,7 @@ use pnpm_patching::PatchInfo;"," use pnpm_real_hoist::{HoistError, HoistOpts, hoist};"," use std::{","     collections::{BTreeMap, BTreeSet},","-    path::PathBuf,","+    path::{Path, PathBuf},"," };"," "," /// One node in a hoisted-linker dependency graph. Keyed in the","@@ -149,15 +151,10 @@ pub struct LockfileToDepGraphResult {"," pub struct LockfileToHoistedDepGraphOptions<'a> {","     pub installability: HoistedInstallability,","     pub placement: HoistedPlacementOptions,","-    /// Project / workspace root. Used as the base for relativizing","-    /// `hoisted_locations` entries and for placing the root's modules","-    /// directory.","-    pub lockfile_dir: PathBuf,","-    /// The root's modules directory, the configured `modulesDir`,","-    /// resolved against [`lockfile_dir`](Self::lockfile_dir) when","-    /// relative. Workspace projects and package directories keep","-    /// `node_modules`, as pnpm's `lockfileToHoistedDepGraph` does.","