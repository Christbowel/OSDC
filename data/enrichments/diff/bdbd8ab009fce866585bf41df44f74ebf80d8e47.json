{"id":"bdbd8ab009fce866585bf41df44f74ebf80d8e47","axis":"silent","repo":"pnpm/pnpm","sha":"bdbd8ab009fce866585bf41df44f74ebf80d8e47","parsed":{"files":[{"path":".changeset/registry-env-placeholder-fails.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/config.reader\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+A `${VAR}` placeholder in a registry URL in `pnpm-workspace.yaml` or the project `.npmrc` now fails the command. pnpm does not expand environment variables in these files. Before, pnpm ignored such a URL and resolved packages from another registry, such as npmjs.org. pnpm now warns when it ignores a placeholder in a proxy, `pnprServer`, or `userAgent` setting in `pnpm-workspace.yaml` [#17762](https://github.com/pnpm/pnpm/issues/17762)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install/configuration.rs","lines":["@@ -479,8 +479,12 @@ fn install_resolves_env_var_in_user_npmrc_registry() {","     drop((root, mock_instance));"," }"," ","+/// The project `.npmrc` comes with the repository, so pnpm does not expand","+/// `${VAR}` in its registry URL. Ignoring the URL would resolve every package","+/// from another registry, so the install fails instead, even though the user","+/// `.npmrc` names a registry. <https://github.com/pnpm/pnpm/issues/17762>"," #[test]","-fn install_ignores_env_var_in_project_npmrc_registry() {","+fn install_fails_on_env_var_in_project_npmrc_registry() {","     let CommandTempCwd {","         pacquet,","         root,","@@ -514,17 +518,18 @@ fn install_ignores_env_var_in_project_npmrc_registry() {","     fs::write(&manifest_path, package_json_content.to_string()).expect(\"write to package.json\");"," ","     eprintln!(\"Executing command with PACQUET_TEST_REGISTRY set...\");","-    pacquet","+    let assert = pacquet","         .with_env(\"PACQUET_TEST_REGISTRY\", \"http://127.0.0.1:9/leaked/\")","         .with_arg(\"--npmrc-auth-file\")","         .with_arg(user_npmrc_path)","         .with_arg(\"install\")","         .assert()","-        .success();","-","-    let symlink_path = workspace.join(\"node_modules/@pnpm.e2e/hello-world-js-bin-parent\");","-    let installed = is_symlink_or_junction(&symlink_path).unwrap();","-    assert!(installed, \"expected installed symlink/junction at {symlink_path:?}\");","+        .failure();","+    let stderr = String::from_utf8_lossy(&assert.get_output().stderr);","+    eprintln!(\"STDERR:\\n{stderr}\\n\");","+    assert!(stderr.contains(\"ERR_PNPM_REGISTRY_ENV_NOT_EXPANDED\"), \"got:\\n{stderr}\");","+    assert!(!stderr.contains(\"leaked\"), \"got:\\n{stderr}\");","+    assert!(!workspace.join(\"node_modules\").exists());"," ","     drop((root, mock_instance));"," }"],"additions":12,"deletions":7,"truncated":false},{"path":"pnpm/crates/config/src/auth_sources.rs","lines":["@@ -18,39 +18,6 @@ impl AuthSources {","     }"," }"," ","-/// The project `.npmrc`, parsed as untrusted unless the user-level auth","-/// file explicitly points at it.","-fn project_auth_source<Sys>(","-    project_npmrc_dir: &Path,","-    user_npmrc_path: Option<&Path>,","-) -> Option<NpmrcAuth>","-where","-    Sys: EnvVar + GetCurrentDir,","-{","-    let project_npmrc_path = project_npmrc_dir.join(\".npmrc\");","-    // When npmrcAuthFile explicitly points at the project .npmrc, the user has","-    // opted in to trusting it — allow auth env expansion and suppress the warning.","-    // A relative value (e.g. `PNPM_CONFIG_NPMRC_AUTH_FILE=.npmrc`) is anchored","-    // at the cwd — where the user-level read actually reads it from, and","-    // how pnpm's `path.resolve` anchors it.","-    let project_is_trusted_auth_file = user_npmrc_path.is_some_and(|user| {","-        if user.is_absolute() {","-            user == project_npmrc_path","-        } else {","-            Sys::current_dir().is_ok_and(|cwd| cwd.join(user) == project_npmrc_path)","-        }","-    });","-    npmrc_source::<Host>(&project_npmrc_path, |text| {","-      