\"),","+    ] {","+        let project = tempdir().expect(\"project tempdir\");","+        write_file(&project.path().join(file_name), contents);","+","+        let result = Config::default().current::<HostNoHome>(project.path());","+        eprintln!(\"{file_name}: {result:?}\");","+        assert!(matches!(","+            result,","+            Err(LoadWorkspaceYamlError::RegistryEnvNotExpanded { setting, .. })","+                if setting == expected_setting","+        ));","+    }","+}","+","+/// The load that switches to the pinned pnpm leaves out what this pnpm","+/// refuses, so a newer or older pinned pnpm still gets to decide.","+#[test]","+pub fn readable_load_leaves_out_a_registry_with_env_placeholder() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        \"registry: http://localhost:${MOCK_PORT}/\\nregistries:\\n  '@acme': http://localhost:${MOCK_PORT}/\\n  '@good': https://good.example/\\nlockfile: false\\n\",","+    );","+    write_file(","+        &project.path().join(\".npmrc\"),","+        \"registry=http://localhost:${MOCK_PORT}/\\n@other:registry=http://localhost:${MOCK_PORT}/\\n\",","+    );","+","+    let config = Config { settings_read: crate::SettingsRead::Readable, ..Config::default() }","+        .current::<HostNoHome>(project.path())","+        .expect(\"load config\");","+","+    assert!(!config.lockfile);","+    assert_eq!(config.registry, \"https://registry.npmjs.org/\");","+    assert_eq!(config.registries_by_scope.get(\"@acme\"), None);","+    assert_eq!(","+        config.registries_by_scope.get(\"@good\").map(String::as_str),","+        Some(\"https://good.example/\"),","+    );","+    assert_eq!(config.registries_by_scope.get(\"@other\"), None);","+}","+","+#[test]","+pub fn repository_proxy_with_env_placeholder_warns() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        \"httpsProxy: http://localhost:${MOCK_PORT}/\\n\",","+    );","+","+    let config = Config::default().current::<HostNoHome>(project.path()).expect(\"load config\");","+","+    assert_eq!(config.proxy, pnpm_network::ProxyConfig::default());","+    dbg!(&config.npmrc_warnings);","+    assert!(","+        config.npmrc_warnings","+            .iter()","+            .any(|warning| warning.starts_with(r#\"Ignored \"httpsProxy\" in pnpm-workspace.yaml\"#)),","+    );","+}","+"," /// End-to-end: malformed `pnpm_config__auth` JSON aborts the load with an"," /// error rather than silently dropping the auth."," #[test]"],"additions":74,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_settings.rs","lines":["@@ -97,7 +97,14 @@ impl Config {","         // `virtualStoreDir` set in the global `config.yaml` still counts as","         // \"explicitly set\" when the workspace yaml leaves it unset.","         explicit.note(&settings);","-        settings.substitute_env_untrusted::<Sys>();","+        let ignored_settings = match settings.substitute_env_untrusted::<Sys>() {","+            Err(_) if self.settings_read.skips_unreadable() => {","+                settings.drop_unexpanded_registries();","+                settings.substitute_env_untrusted::<Sys>()?","+            }","+            result => result?,","+        };","+        self.npmrc_warnings.extend(ignored_settings);","         if for_self_update {","             settings.clear_self_update_policy();","         }"],"additions":8,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/env.rs","lines":["@@ -1,5 +1,6 @@"," use super::{","-    EnvVar, GetHomeDir, Path, WorkspaceSettings, has_env_placeholder, join_fragment, registries,","+    EnvVar, GetHomeDir, LoadWorkspaceYamlError, Path, WORKSPACE_MANIFEST_FILENAME,","+    WorkspaceSettings, has_env_placeholder, join_fragment, redact_registry_url, registries,","     substitute_json_string, substi