"+","+def _register_action(action: Action, deprecated: bool, deprecated_actions: set):","+    # Hidden option strings stay registered with the parser but leave help.","+    if isinstance(action, EnableDisableAction):","+        action.option_strings = action.visible_option_strings","+    if deprecated:","+        deprecated_actions.add(action)","+","+"," class FlexibleArgumentParser(ArgumentParser):","     \"\"\"ArgumentParser that allows both underscore and dash in names.\"\"\""," ","@@ -139,6 +176,7 @@ def __init__(self, *args, **kwargs):","         # Pop kwarg \"add_json_tip\" to control whether to add the JSON tip","         self.add_json_tip = kwargs.pop(\"add_json_tip\", True)","         super().__init__(*args, **kwargs)","+        self.register(\"action\", BooleanOptionalAction, EnableDisableAction)","         self._show_serve_task_hint = False"," ","     def error(self, message: str) -> NoReturn:","@@ -169,29 +207,28 @@ def parse_known_args(self, args=None, namespace=None):","                     logger.warning_once(\"argument '%s' is deprecated\", dest)","             return namespace, args"," ","+    def add_argument(self, *args, **kwargs):","+        # Python 3.13+ handles the deprecated kwarg natively","+        deprecated = sys.version_info < (3, 13) and kwargs.pop(\"deprecated\", False)","+        action = super().add_argument(*args, **kwargs)","+        _register_action(action, deprecated, self._deprecated)","+        return action","+","+    class _FlexibleArgumentGroup(_ArgumentGroup):","+        def __init__(self, container, *args, **kwargs):","+            super().__init__(container, *args, **kwargs)","+            self._deprecated: set[Action] = container._deprecated","+","         def add_argument(self, *args, **kwargs):","-            deprecated = kwargs.pop(\"deprecated\", False)","+            deprecated = sys.version_info < (3, 13) and kwargs.pop(\"deprecated\", False)","             action = super().add_argument(*args, **kwargs)","-            if deprecated:","-                self._deprecated.add(action)","+            _register_action(action, deprecated, self._deprecated)","             return action"," ","-        class _FlexibleArgumentGroup(_ArgumentGroup):","-            def __init__(self, container, *args, **kwargs):","-                super().__init__(container, *args, **kwargs)","-                self._deprecated: set[Action] = container._deprecated","-","-            def add_argument(self, *args, **kwargs):","-                deprecated = kwargs.pop(\"deprecated\", False)","-                action = super().add_argument(*args, **kwargs)","-                if deprecated:","-                    self._deprecated.add(action)","-                return action","-","-        def add_argument_group(self, *args, **kwargs):","-            group = self._FlexibleArgumentGroup(self, *args, **kwargs)","-            self._action_groups.append(group)","-            return group","+    def add_argument_group(self, *args, **kwargs):","+        group = self._FlexibleArgumentGroup(self, *args, **kwargs)","+        self._action_groups.append(group)","+        return group"," ","     def format_help(self):","         # Only use custom help formatting for bottom level parsers",""],"additions":56,"deletions":19,"truncated":false}],"additions":118,"deletions":36,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-15T13:22:03.603502+00:00"}