sert args.enable_feature is True"," "," ","+@pytest.fixture","+def bool_parser():","+    parser = FlexibleArgumentParser()","+    serve = parser.add_subparsers().add_parser(\"serve\")","+    group = serve.add_argument_group(\"group\")","+    group.add_argument(","+        \"--enable-feature\", \"-ef\", action=BooleanOptionalAction, default=None","+    )","+    group.add_argument(\"--disable-logs\", action=BooleanOptionalAction, default=False)","+    group.add_argument(\"--plain\", action=BooleanOptionalAction, default=None)","+    return parser, serve","+","+","+@pytest.mark.parametrize(","+    (\"args\", \"expected\"),","+    [","+        ([], (None, False, None)),","+        ([\"--enable-feature\", \"--disable-logs\"], (True, True, None)),","+        ([\"-ef\", \"--enable-logs\"], (True, False, None)),","+        ([\"--disable-feature\"], (False, False, None)),","+        ([\"--disable_feature\"], (False, False, None)),","+        # Hidden backwards-compatible spellings","+        ([\"--no-enable-feature\", \"--no-disable-logs\"], (False, False, None)),","+        ([\"--plain\"], (None, False, True)),","+        ([\"--no-plain\"], (None, False, False)),","+    ],","+)","+def test_enable_disable_flags(bool_parser, args, expected):","+    \"\"\"`--enable-x`/`--disable-x` are inverses, and `--no-*` still works.\"\"\"","+    parser, _ = bool_parser","+    ns = parser.parse_args([\"serve\", *args])","+    assert (ns.enable_feature, ns.disable_logs, ns.plain) == expected","+","+","+def test_enable_disable_flags_help(bool_parser):","+    \"\"\"Help advertises `--enable-x`/`--disable-x` but not `--no-enable-x`.\"\"\"","+    _, serve = bool_parser","+    usage = serve.format_usage()","+    assert \"[--enable-feature | -ef | --disable-feature]\" in usage","+    assert \"[--disable-logs | --enable-logs]\" in usage","+    assert \"[--plain | --no-plain]\" in usage","+    assert \"--no-enable-feature\" not in usage","+    assert \"--no-disable-logs\" not in usage","+","+"," def test_invalid_choice(parser):","     with pytest.raises(SystemExit):","         parser.parse_args([\"--image_input_type\", \"invalid_choice\"])"],"additions":45,"deletions":0,"truncated":false},{"path":"vllm/config/pooler.py","lines":["@@ -67,7 +67,7 @@ class PoolerConfig:","     \"\"\"","     Whether the engine-side late-interaction scorer may use the fused","     flash-maxsim Triton kernel. Disabled automatically when the API server","-    is started with `--no-enable-flash-late-interaction`; the reference","+    is started with `--disable-flash-late-interaction`; the reference","     scorer is used instead.","     \"\"\""," "],"additions":1,"deletions":1,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -2177,10 +2177,10 @@ def has_blocked_weights():","         self._verify_aux_output_compatibility()"," ","         # Hybrid KV cache manager (HMA) runtime rules:","-        # - Explicit enable (--no-disable-kv-cache-manager): error if runtime","+        # - Explicit enable (--enable-hybrid-kv-cache-manager): error if runtime","         #   disables it","         # - No preference: auto-disable for unsupported features or connector configs","-        # - Explicit disable (--disable-kv-cache-manager): always respect it","+        # - Explicit disable (--disable-hybrid-kv-cache-manager): always respect it","         need_disable_hybrid_kv_cache_manager = False","         # logger should only print warning message for hybrid models. As we","         # can't know whether the model is hybrid or not now, so we don't log","@@ -2241,7 +2241,7 @@ def has_blocked_weights():","             raise ValueError(","                 \"Hybrid KV cache manager was explicitly enabled but is not \"","                 \"supported in this configuration. Consider omitting the \"","-                \"--no-disable-hybrid-kv-cache-manager flag to let vLLM decide\"","+                \"--enable-hybrid-kv-cache-manager flag to let vLLM decide\"","                 \" automatically.\"