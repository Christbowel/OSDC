uote-for-log';","+","+describe('quoteForLog', () => {","+  test('Quotes an ordinary value', () => {","+    expect(quoteForLog('Editor')).toBe('\"Editor\"');","+  });","+","+  test('Escapes quotes, backslashes and C0 controls as JSON does', () => {","+    expect(quoteForLog('a\\nb\\r\\tc\"d\\\\e\\u001b[31m')).toBe('\"a\\\\nb\\\\r\\\\tc\\\\\"d\\\\\\\\e\\\\u001b[31m\"');","+  });","+","+  test('Escapes DEL and C1 controls, which JSON.stringify leaves raw', () => {","+    expect(quoteForLog('a\\u007fb\\u0085c\\u009bd')).toBe('\"a\\\\u007fb\\\\u0085c\\\\u009bd\"');","+  });","+","+  test('Escapes line and paragraph separators', () => {","+    expect(quoteForLog('a\\u2028b\\u2029c')).toBe('\"a\\\\u2028b\\\\u2029c\"');","+  });","+","+  test('Escapes bidirectional controls and zero-width format characters', () => {","+    expect(quoteForLog('a\\u202eb\\u2066c\\u2069d\\u200be\\u00adf\\ufeffg\\u{e0001}h')).toBe(","+      '\"a\\\\u202eb\\\\u2066c\\\\u2069d\\\\u200be\\\\u00adf\\\\ufeffg\\\\u{e0001}h\"'","+    );","+  });","+","+  test('Keeps printable non-ASCII characters', () => {","+    expect(quoteForLog('Éditeur 编辑 🚀')).toBe('\"Éditeur 编辑 🚀\"');","+  });","+","+  test('Truncates a value longer than 100 code points', () => {","+    expect(quoteForLog('k'.repeat(101))).toBe(`\"${'k'.repeat(100)}…\"`);","+    expect(quoteForLog('k'.repeat(100))).toBe(`\"${'k'.repeat(100)}\"`);","+    expect(quoteForLog('🚀'.repeat(101))).toBe(`\"${'🚀'.repeat(100)}…\"`);","+  });","+","+  test('Prints null and undefined without quotes', () => {","+    expect(quoteForLog(null)).toBe('null');","+    expect(quoteForLog(undefined)).toBe('undefined');","+  });","+});"],"additions":41,"deletions":0,"truncated":false},{"path":"packages/core/utils/src/index.ts","lines":["@@ -53,4 +53,5 @@ export * from './security';"," export * from './publication-filter';"," export * from './has-published-version-param';"," export { hasSort } from './sort-query';","+export { quoteForLog } from './quote-for-log';"," export { emitAudit, type AuditEmitter } from './audit-logs';"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/core/utils/src/quote-for-log.ts","lines":["@@ -0,0 +1,40 @@","+/**","+ * Longest value, in code points, printed in a log line before it is truncated","+ */","+const MAX_LOGGED_VALUE_LENGTH = 100;","+","+const escapeCodePoint = (character: string): string => {","+  const codePoint = character.codePointAt(0) ?? 0;","+  const hex = codePoint.toString(16);","+","+  return codePoint > 0xffff ? `\\\\u{${hex}}` : `\\\\u${hex.padStart(4, '0')}`;","+};","+","+/**","+ * Quotes a value such as a filter key, a role or token name, an action or a subject for a log line.","+ * These values can come from a request or from a user, so:","+ * - control characters (line breaks, ANSI escapes, DEL, C1 controls), format characters","+ *   (bidirectional overrides and isolates, zero-width characters) and line separators","+ *   are escaped, to keep one readable message on one log line;","+ * - quotes and backslashes are escaped as in JSON;","+ * - long values are truncated.","+ *","+ * `null` and `undefined` print as `null` and `undefined`, without quotes.","+ */","+export const quoteForLog = (value: string | null | undefined): string => {","+  if (value === undefined) {","+    return 'undefined';","+  }","+","+  if (value === null) {","+    return 'null';","+  }","+","+  const codePoints = Array.from(value);","+  const truncated =","+    codePoints.length > MAX_LOGGED_VALUE_LENGTH","+      ? `${codePoints.slice(0, MAX_LOGGED_VALUE_LENGTH).join('')}…`","+      : value;","+","+  return JSON.stringify(truncated).replace(/[\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]/gu, escapeCodePoint);","+};",""],"additions":40,"deletions":0,"truncated":false}],"additions":178,"deletions":57,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-13T17:03:27.485746+00:00"}