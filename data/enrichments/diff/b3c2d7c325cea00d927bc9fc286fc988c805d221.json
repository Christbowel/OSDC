mpt fails without ever reaching TCP.","+    HostAndPort unresolvable(\"does-not-exist.invalid\", tla().listenerMainPort());","+    auto session = tla()","+                       .asyncConnect(unresolvable,","+                                     ConnectSSLMode::kDisableSSL,","+                                     reactor,","+                                     Milliseconds{10 * 1000},","+                                     std::make_shared<ConnectionMetrics>(","+                                         getServiceContext()->getFastClockSource()),","+                                     nullptr)","+                       .getNoThrow();","+    ASSERT_NOT_OK(session);","+","+    // The resolution attempt is counted even though it failed.","+    if (capturer.canReadMetrics()) {","+        ASSERT_GE(capturer.readInt64Counter(MetricNames::kNetworkEgressResolutionOperations), 1);","+    }","+}","+"," #ifdef MONGO_CONFIG_SSL"," // TODO SERVER-62035: enable the following on Windows."," #if MONGO_CONFIG_SSL_PROVIDER == MONGO_CONFIG_SSL_PROVIDER_OPENSSL","@@ -1362,6 +1395,57 @@ TEST_F(AsioTransportLayerWithServiceContextTest, ShutdownDuringSSLHandshake) {","                        DBException,","                        ErrorCodes::HostUnreachable);"," }","+","+/**","+ * Fixture whose ingress side ends sessions without ever speaking TLS, so that an egress TLS","+ * handshake against the listener fails promptly.","+ */","+class AsioTransportLayerFailedSSLHandshakeTest : public AsioTransportLayerWithServiceContextTest {","+public:","+    void setUp() override {","+        onStartSession = [](test::SessionThread& sessionThread) {","+            sessionThread.schedule([](Session& session) { session.end(); });","+        };","+        AsioTransportLayerWithServiceContextTest::setUp();","+    }","+};","+","+TEST_F(AsioTransportLayerFailedSSLHandshakeTest,","+       AsyncConnectCountsFailedEgressSSLHandshakeAttempts) {","+    otel::metrics::OtelMetricsCapturer capturer;","+","+    au