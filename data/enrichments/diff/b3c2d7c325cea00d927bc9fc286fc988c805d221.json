{"id":"b3c2d7c325cea00d927bc9fc286fc988c805d221","axis":"silent","repo":"mongodb/mongo","sha":"b3c2d7c325cea00d927bc9fc286fc988c805d221","parsed":{"files":[{"path":"jstests/noPassthrough/observability/network_egress_resolution_ssl_metrics.js","lines":["@@ -0,0 +1,56 @@","+/**","+ * Tests that network.egress.resolutionOperations advances when a node dials a peer, by forcing a","+ * secondary to reconnect to the primary.","+ *","+ * @tags: [requires_replication]","+ */","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+","+describe(\"egress resolution and SSL operation counters\", function () {","+    let rs;","+    let secondary;","+    let initialResolution, finalResolution;","+","+    before(function () {","+        rs = new ReplSetTest({nodes: 2});","+        rs.startSet();","+        rs.initiate();","+        rs.awaitSecondaryNodes();","+        secondary = rs.getSecondary();","+","+        const primary = rs.getPrimary();","+        initialResolution = secondary.adminCommand({serverStatus: 1}).metrics.network.egress","+            .resolutionOperations;","+","+        // Dropping the connection forces a reconnect, which re-triggers host resolution.","+        assert.commandWorked(","+            secondary.adminCommand({dropConnections: 1, hostAndPort: [primary.host]}),","+        );","+        assert.commandWorked(primary.getDB(\"test\").foo.insert({_id: 1}, {writeConcern: {w: 2}}));","+","+        assert.soon(","+            () => {","+                finalResolution = secondary.adminCommand({serverStatus: 1}).metrics.network.egress","+                    .resolutionOperations;","+                return finalResolution > initialResolution;","+            },","+            () =>","+                `resolutionOperations did not increase: initial ${initialResolution}, final ${finalResolution}`,","+        );","+    });","+","+    after(function () {","+        if (rs) {","+            rs.stopSet();","+        }","+    });","+","+    it(\"increments resolutionOperations when the secondary reconnects to the primary\", function () {","+        assert.gt(","+            finalResolution,","+            initialResolution,","+            \"Expected network.egress.resolutionOperations to increase after forcing a reconnect\",","+        );","+    });","+});"],"additions":56,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/observability/server_status_otel_metrics.js","lines":["@@ -46,4 +46,12 @@ describe(\"OTel metrics reported under serverStatus\", function () {","             );","         }","     });","+","+    it(\"reports the egress resolution and SSL operation counters under metrics.network.egress\", function () {","+        // A standalone mongod never dials a peer, so these must be present and zero.","+        const egress = this.mongod.getDB(jsTestName()).serverStatus().metrics.network.egress;","+        for (const counter of [\"resolutionOperations\", \"sslOperations\"]) {","+            assert.eq(egress[counter], 0, `Expected ${counter} to be present and zero`, {egress});","+        }","+    });"," });"],"additions":8,"deletions":0,"truncated":false},{"path":"src/mongo/db/stats/counters.cpp","lines":["@@ -4,6 +4,7 @@"," #include \"mongo/db/stats/counters.h\""," "," #include \"mongo/base/error_codes.h\"","+#include \"mongo/base/init.h\""," #include \"mongo/bson/bsonelement.h\""," #include \"mongo/client/authenticate.h\""," #include \"mongo/db/commands/server_status/server_status.h\"","@@ -85,13 +86,28 @@ NetworkCounter::NetworkCounter()","           MetricNames::kNetworkEgressBytesOut,","           \"Total number of logical bytes sent on egress (outbound client) connections.\",","           MetricUnit::kBytes)),","+      _egressResolutionOperations(MetricsService::instance().createInt64Counter(","+          MetricNames::kNetworkEgressResolutionOperations,","+          \"Total number of host resolution operations on egres