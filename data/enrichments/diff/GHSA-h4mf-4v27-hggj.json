{"id":"GHSA-h4mf-4v27-hggj","axis":"advisories","repo":"rclone/rclone","sha":"59b513b0e74fd2943ccbb8891d5ce00f860e6d26","parsed":{"files":[{"path":"backend/webdav/webdav.go","lines":["@@ -180,6 +180,10 @@ to an unknown webserver."," However this is desirable in some circumstances. If you are getting"," an error like \"401 Unauthorized\" when rclone is attempting to read"," files from the webdav server then you can try this option.","+","+Note that enabling this also permits sending your credentials over a","+plaintext HTTP connection if the server redirects from HTTPS to HTTP,","+which rclone otherwise refuses to do."," `,"," \t\t\t\tAdvanced: true,"," \t\t\t\tDefault:  false,","@@ -511,6 +515,8 @@ func NewFs(ctx context.Context, name, root string, m configmap.Mapper) (fs.Fs, e"," \t\t\trt: ntlmssp.Negotiator{RoundTripper: t},"," \t\t}"," \t}","+\t// Refuse redirects that downgrade HTTPS to plaintext HTTP.","+\tclient.CheckRedirect = rest.RefuseHTTPSDowngradeRedirectFn"," \tf.srv = rest.NewClient(client).SetRoot(u.String())"," "," \tf.features = (&fs.Features{"],"additions":6,"deletions":0,"truncated":false},{"path":"lib/rest/rest.go","lines":["@@ -215,22 +215,55 @@ func ClientWithNoRedirects(c *http.Client) *http.Client {"," \treturn &clientCopy"," }"," ","+// ErrHTTPSDowngrade is returned by the redirect handlers when a server tries to","+// redirect an HTTPS request to a plaintext HTTP URL. Following such a redirect","+// would replay any credentials over the network in cleartext, so rclone refuses.","+var ErrHTTPSDowngrade = errors.New(\"refusing to follow HTTPS to HTTP redirect: would send credentials in cleartext\")","+","+// isHTTPSDowngrade reports whether following the redirect to req would","+// move from an https:// URL to a plaintext http:// URL.","+func isHTTPSDowngrade(req *http.Request, via []*http.Request) bool {","+\tif len(via) == 0 {","+\t\treturn false","+\t}","+\tprev := via[len(via)-1]","+\treturn prev.URL.Scheme == \"https\" && req.URL.Scheme == \"http\"","+}","+"," // PreserveMethodRedirectFn is a CheckRedirect function that"," // preserves the original HTTP method on redirects."," //"," // By default Go's http.Client changes the method to GET on 301, 302,"," // and 303 redirects. This function overrides that behaviour so the"," // original method (e.g. PROPFIND being preserved across a 307) is kept.","+//","+// It refuses an HTTPS to HTTP downgrade with ErrHTTPSDowngrade."," func PreserveMethodRedirectFn(req *http.Request, via []*http.Request) error {"," \tif len(via) >= 10 {"," \t\treturn errors.New(\"stopped after 10 redirects\")"," \t}","+\tif isHTTPSDowngrade(req, via) {","+\t\treturn ErrHTTPSDowngrade","+\t}"," \tif len(via) > 0 {"," \t\treq.Method = via[0].Method"," \t}"," \treturn nil"," }"," ","+// RefuseHTTPSDowngradeRedirectFn is a CheckRedirect function that follows","+// redirects like the default net/http client but refuses to follow one","+// that downgrades from HTTPS to plaintext HTTP, returning ErrHTTPSDowngrade.","+func RefuseHTTPSDowngradeRedirectFn(req *http.Request, via []*http.Request) error {","+\tif len(via) >= 10 {","+\t\treturn errors.New(\"stopped after 10 redirects\")","+\t}","+\tif isHTTPSDowngrade(req, via) {","+\t\treturn ErrHTTPSDowngrade","+\t}","+\treturn nil","+}","+"," // Do calls the internal http.Client.Do method"," func (api *Client) Do(req *http.Request) (*http.Response, error) {"," \treturn api.c.Do(req)"],"additions":33,"deletions":0,"truncated":false},{"path":"lib/rest/rest_test.go","lines":["@@ -0,0 +1,146 @@","+package rest","+","+import (","+\t\"context\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"sync/atomic\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// mkRedirectReq makes a minimal *http.Request pointing at rawURL for","+// exercising the CheckRedirect functions.","+func mkRedirectReq(t *testing.T, rawURL, method string) *http.Request {","+\tu, err := url.Parse(rawURL)","+\trequire.NoError(t, err)","+\treturn &http.Request{URL: u, Method: method, Header: http.Header{}}","+}","+","+func TestPreserveMethodRedirectFn(t *testing.T) {","+\tt.Run(\"PreservesMethod\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"https://example.com/a\", \"PROPFIND\")","+\t\tnext := mkRedirectReq(t, \"https://example.com/b\", \"GET\")","+\t\trequire.NoError(t, PreserveMethodRedirectFn(next, []*http.Request{orig}))","+\t\tassert.Equal(t, \"PROPFIND\", next.Method)","+\t})","+\tt.Run(\"RefusesDowngrade\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"https://example.com/a\", \"PROPFIND\")","+\t\tnext := mkRedirectReq(t, \"http://example.com/b\", \"PROPFIND\")","+\t\tassert.ErrorIs(t, PreserveMethodRedirectFn(next, []*http.Request{orig}), ErrHTTPSDowngrade)","+\t})","+\tt.Run(\"AllowsCrossHostHTTPS\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"https://example.com/a\", \"PROPFIND\")","+\t\tnext := mkRedirectReq(t, \"https://other.example.com/b\", \"PROPFIND\")","+\t\tassert.NoError(t, PreserveMethodRedirectFn(next, []*http.Request{orig}))","+\t})","+\tt.Run(\"AllowsPlainHTTP\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"http://example.com/a\", \"PROPFIND\")","+\t\tnext := mkRedirectReq(t, \"http://example.com/b\", \"PROPFIND\")","+\t\tassert.NoError(t, PreserveMethodRedirectFn(next, []*http.Request{orig}))","+\t})","+\tt.Run(\"TooManyRedirects\", func(t *testing.T) {","+\t\tnext := mkRedirectReq(t, \"https://example.com/b\", \"GET\")","+\t\tvia := make([]*http.Request, 10)","+\t\tassert.Error(t, PreserveMethodRedirectFn(next, via))","+\t})","+}","+","+func TestRefuseHTTPSDowngradeRedirectFn(t *testing.T) {","+\tt.Run(\"RefusesDowngrade\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"https://example.com/a\", \"GET\")","+\t\tnext := mkRedirectReq(t, \"http://example.com/b\", \"GET\")","+\t\tassert.ErrorIs(t, RefuseHTTPSDowngradeRedirectFn(next, []*http.Request{orig}), ErrHTTPSDowngrade)","+\t})","+\tt.Run(\"AllowsUpgrade\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"http://example.com/a\", \"GET\")","+\t\tnext := mkRedirectReq(t, \"https://example.com/b\", \"GET\")","+\t\tassert.NoError(t, RefuseHTTPSDowngradeRedirectFn(next, []*http.Request{orig}))","+\t})","+\tt.Run(\"AllowsSameScheme\", func(t *testing.T) {","+\t\torig := mkRedirectReq(t, \"https://example.com/a\", \"GET\")","+\t\tnext := mkRedirectReq(t, \"https://example.com/b\", \"GET\")","+\t\tassert.NoError(t, RefuseHTTPSDowngradeRedirectFn(next, []*http.Request{orig}))","+\t})","+\tt.Run(\"TooManyRedirects\", func(t *testing.T) {","+\t\tnext := mkRedirectReq(t, \"https://example.com/b\", \"GET\")","+\t\tvia := make([]*http.Request, 10)","+\t\tassert.Error(t, RefuseHTTPSDowngradeRedirectFn(next, via))","+\t})","+}","+","+// newDowngradeServers returns an HTTPS server that redirects every","+// request to a plaintext HTTP server on the same host, together with a","+// flag that records whether the plaintext server ever received an","+// Authorization header. Use tlsSrv.Client() for a client that trusts the","+// test certificate.","+func newDowngradeServers(t *testing.T) (tlsSrv *httptest.Server, sawAuth *atomic.Bool) {","+\tt.Helper()","+\tsawAuth = new(atomic.Bool)","+","+\t// Plaintext HTTP target that records whether it received credentials.","+\ttarget := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tif r.Header.Get(\"Authorization\") != \"\" {","+\t\t\tsawAuth.Store(true)","+\t\t}","+\t\tw.WriteHeader(http.StatusOK)","+\t}))","+\tt.Cleanup(target.Close)","+","+\t// HTTPS server that redirects to the plaintext target on the same host.","+\ttlsSrv = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\thttp.Redirect(w, r, target.URL+r.URL.Path, http.StatusTemporaryRedirect)","+\t}))","+\tt.Cleanup(tlsSrv.Close)","+","+\treturn tlsSrv, sawAuth","+}","+","+// TestRefuseHTTPSDowngradeRedirectEndToEnd drives a real HTTPS-to-HTTP","+// redirect through rest.Client with credentials set via SetUserPass, the","+// same way the webdav backend does. It shows that the default client","+// leaks credentials to the plaintext hop, whereas the redirect handlers","+// refuse to follow the downgrade and the plaintext hop never sees them.","+func TestRefuseHTTPSDowngradeRedirectEndToEnd(t *testing.T) {","+\tctx := context.Background()","+","+\t// Baseline: without any check the credentials set by SetUserPass are","+\t// forwarded over the plaintext hop, which is the vulnerability.","+\tt.Run(\"DefaultLeaks\", func(t *testing.T) {","+\t\ttlsSrv, sawAuth := newDowngradeServers(t)","+\t\tapi := NewClient(tlsSrv.Client()).SetRoot(tlsSrv.URL)","+\t\tapi.SetUserPass(\"user\", \"pass\")","+\t\t_, err := api.Call(ctx, &Opts{Method: \"GET\", Path: \"/file\", NoResponse: true})","+\t\trequire.NoError(t, err)","+\t\tassert.True(t, sawAuth.Load(), \"expected credentials to be sent over plaintext\")","+\t})","+","+\t// Default path (all normal webdav calls): the client refuses the","+\t// downgrade so nothing is sent.","+\tt.Run(\"DefaultPathRefused\", func(t *testing.T) {","+\t\ttlsSrv, sawAuth := newDowngradeServers(t)","+\t\tclient := tlsSrv.Client()","+\t\tclient.CheckRedirect = RefuseHTTPSDowngradeRedirectFn","+\t\tapi := NewClient(client).SetRoot(tlsSrv.URL)","+\t\tapi.SetUserPass(\"user\", \"pass\")","+\t\t_, err := api.Call(ctx, &Opts{Method: \"GET\", Path: \"/file\", NoResponse: true})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorIs(t, err, ErrHTTPSDowngrade)","+\t\tassert.False(t, sawAuth.Load(), \"plaintext hop must not receive credentials\")","+\t})","+","+\t// PROPFIND path (readMetaDataForPath): the per-call CheckRedirect","+\t// refuses the downgrade too.","+\tt.Run(\"PropfindPathRefused\", func(t *testing.T) {","+\t\ttlsSrv, sawAuth := newDowngradeServers(t)","+\t\tapi := NewClient(tlsSrv.Client()).SetRoot(tlsSrv.URL)","+\t\tapi.SetUserPass(\"user\", \"pass\")","+\t\t_, err := api.Call(ctx, &Opts{Method: \"PROPFIND\", Path: \"/dir\", NoResponse: true, CheckRedirect: PreserveMethodRedirectFn})","+\t\trequire.Error(t, err)","+\t\tassert.ErrorIs(t, err, ErrHTTPSDowngrade)","+\t\tassert.False(t, sawAuth.Load(), \"plaintext hop must not receive credentials\")","+\t})","+}",""],"additions":146,"deletions":0,"truncated":false}],"additions":185,"deletions":0,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-08-06T10:23:38.809726+00:00"}