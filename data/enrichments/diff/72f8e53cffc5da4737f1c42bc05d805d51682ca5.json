"+","+async fn assert_rejected(addr: &str, headers: Fields) {","+    let err = client::send(request(addr, \"/victim\", headers))","+        .await","+        .err()","+        .expect(\"request with multiple `content-length` values must be rejected\");","+    assert!(","+        matches!(&err, ErrorCode::InternalError(Some(msg)) if msg.contains(\"content-length\")),","+        \"unexpected error: {err:?}\"","+    );","+}","+","+impl test_programs::p3::exports::wasi::cli::run::Guest for Component {","+    async fn run() -> Result<(), ()> {","+        let addr = test_programs::p3::wasi::cli::environment::get_environment()","+            .into_iter()","+            .find_map(|(k, v)| k.eq(\"HTTP_SERVER\").then_some(v))","+            .unwrap();","+","+        println!(\"forwarding response headers\");","+        assert_rejected(&addr, duplicate_headers(&addr).await).await;","+","+        println!(\"forwarding cloned response headers\");","+        assert_rejected(&addr, duplicate_headers(&addr).await.clone()).await;","+","+        Ok(())","+    }","+}","+","+fn main() {}"],"additions":65,"deletions":0,"truncated":false},{"path":"crates/wasi-http/Cargo.toml","lines":["@@ -51,7 +51,7 @@ test-programs-artifacts = { workspace = true }"," test-log = { workspace = true }"," tracing-subscriber = { workspace = true }"," wasmtime = { workspace = true, features = ['default', 'anyhow'] }","-tokio = { workspace = true, features = ['fs', 'macros'] }","+tokio = { workspace = true, features = ['fs', 'macros', 'io-util'] }"," futures = { workspace = true, default-features = false, features = ['alloc', 'async-await'] }"," sha2 = { workspace = true }"," base64 = { workspace = true }"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/wasi-http/src/p2/http_impl.rs","lines":["@@ -1,6 +1,5 @@"," //! Implementation of the `wasi:http/outgoing-handler` interface."," ","-use crate::WasiHttpCtxView;"," use crate::p2::{","     HttpResult,","     bindings::http::{","@@ -11,6 +10,7 @@ use crate::p2::{","     http_request_error,","     types::{HostFutureIncomingResponse, HostOutgoingRequest},"," };","+use crate::{WasiHttpCtxView, get_content_length};"," use bytes::Bytes;"," use http_body_util::{BodyExt, Empty};"," use hyper::Method;","@@ -31,6 +31,17 @@ impl outgoing_handler::Host for WasiHttpCtxView<'_> {","         };"," ","         let req = self.table.delete(request_id)?;","+","+        // The `content-length` header is otherwise only validated in","+        // `outgoing-request.body` and `outgoing-body.finish`, neither of which","+        // a guest is required to call. Validate it here too so that malformed","+        // requests never reach the wire.","+        let content_length =","+            get_content_length(&req.headers).map_err(|err| internal_error(format!(\"{err:#}\")))?;","+        if req.body.is_none() && content_length.is_some_and(|n| n != 0) {","+            return Err(types::ErrorCode::HttpRequestBodySize(Some(0)).into());","+        }","+","         let mut builder = hyper::Request::builder();"," ","         builder = builder.method(match req.method {"],"additions":12,"deletions":1,"truncated":false},{"path":"crates/wasi-http/tests/all/http_server.rs","lines":["@@ -3,7 +3,9 @@ use hyper::service::service_fn;"," use hyper::{Request, Response};"," use std::future::Future;"," use std::net::{SocketAddr, TcpStream};","+use std::sync::{Arc, Mutex};"," use std::thread::JoinHandle;","+use tokio::io::{AsyncReadExt as _, AsyncWriteExt as _};"," use tokio::net::TcpListener;"," use tracing::{debug, trace, warn};"," use wasmtime::{Result, error::Context as _};","@@ -36,7 +38,7 @@ pub struct Server {"," impl Server {","     fn new<F>(","         conns: usize,","-        run: impl Fn(TokioIo<tokio::net::TcpStream>) -> F + Send + 'static,","+        run: impl Fn(tokio::net::TcpStream) -> F + Send + 'static,","     ) -> Result<Self>","     where","         F: Future<Output = Result<()>>,","@@ -62,7 +64,7 @@ impl Server {","                 