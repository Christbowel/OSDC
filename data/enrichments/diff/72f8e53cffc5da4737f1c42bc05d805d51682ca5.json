 let response = future.get().unwrap().unwrap().unwrap();","+    let headers = response.headers();","+    assert_eq!(","+        headers.get(\"content-length\"),","+        [b\"5\".to_vec(), b\"100\".to_vec()],","+        \"precondition: the response must carry both values\"","+    );","+    headers","+}","+","+fn assert_rejected(addr: &str, headers: Fields) {","+    let err = outgoing_handler::handle(request(addr, \"/victim\", headers), None)","+        .err()","+        .expect(\"request with multiple `content-length` values must be rejected\");","+    assert!(","+        matches!(&err, ErrorCode::InternalError(Some(msg)) if msg.contains(\"content-length\")),","+        \"unexpected error: {err:?}\"","+    );","+}","+","+fn main() {","+    let addr = std::env::var(\"HTTP_SERVER\").unwrap();","+","+    println!(\"forwarding response headers\");","+    assert_rejected(&addr, duplicate_headers(&addr));","+","+    println!(\"forwarding cloned response headers\");","+    assert_rejected(&addr, duplicate_headers(&addr).clone());","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"crates/test-programs/src/bin/p3_http_outbound_request_content_length.rs","lines":["@@ -2,7 +2,7 @@ use futures::join;"," use test_programs::p3::wasi::http::client;"," use test_programs::p3::wasi::http::types::{ErrorCode, Headers, Method, Request, Scheme, Trailers};"," use test_programs::p3::{wit_future, wit_stream};","-use wit_bindgen::{FutureReader, FutureWriter, StreamWriter};","+use wit_bindgen::{FutureReader, FutureWriter, StreamReader, StreamWriter};"," "," struct Component;"," ","@@ -15,10 +15,21 @@ fn make_request() -> (","     FutureReader<Result<(), ErrorCode>>,"," ) {","     let (contents_tx, contents_rx) = wit_stream::new();","+    let (request, trailers_tx, transmit) = make_request_with_contents(Some(contents_rx));","+    (request, contents_tx, trailers_tx, transmit)","+}","+","+fn make_request_with_contents(","+    contents_rx: Option<StreamReader<u8>>,","+) -> (","+    