tures::StreamExt as _;","                 let stream = futures::stream::once(async {","@@ -144,7 +149,8 @@ impl Server {"," ","     pub fn http2(conns: usize) -> Result<Self> {","         debug!(\"initializing http2 server\");","-        Self::new(conns, |io| async move {","+        Self::new(conns, |stream| async move {","+            let io = TokioIo::new(stream);","             let mut builder = hyper::server::conn::http2::Builder::new(TokioExecutor);","             let http = builder.max_concurrent_streams(20);"," ","@@ -164,11 +170,71 @@ impl Server {","         })","     }"," ","+    /// Test-only: a raw HTTP/1.1 server which doesn't go through `hyper`, for","+    /// sending responses `hyper` would refuse to produce.","+    ///","+    /// For each connection the request head (everything up to and including","+    /// the blank line) is read and passed to `respond`, whose return value is","+    /// written back verbatim before the connection is closed. Request heads","+    /// are recorded and can be retrieved with [`RawRequests::get`]; request","+    /// bodies are neither read nor recorded.","+    pub fn raw(","+        conns: usize,","+        respond: impl Fn(&[u8]) -> Vec<u8> + Send + Sync + 'static,","+    ) -> Result<(Self, RawRequests)> {","+        debug!(\"initializing raw http1 server\");","+        let requests = RawRequests::default();","+        let recorded = requests.clone();","+        let respond = Arc::new(respond);","+        let server = Self::new(conns, move |mut stream| {","+            let recorded = recorded.clone();","+            let respond = respond.clone();","+            async move {","+                let mut head = Vec::new();","+                let mut buf = [0; 1024];","+                loop {","+                    // Any body bytes read along with the head are dropped.","+                    if let Some(end) = head.windows(4).position(|w| w == b\"\\r\\n\\r\\n\") {","+                        head.truncate(end + 4);","+                        break;","+                    }","+                    let n = stream.read(&mut buf).await?;","+                    if n == 0 {","+                        break;","+                    }","+                    head.extend_from_slice(&buf[..n]);","+                }","+                // `Drop for Server` connects without sending anything to","+                // unblock the accept loop; don't record those.","+                if head.is_empty() {","+                    return Ok(());","+                }","+                trace!(head = %String::from_utf8_lossy(&head), \"raw request\");","+                let response = respond(&head);","+                recorded.0.lock().unwrap().push(head);","+                stream.write_all(&response).await?;","+                stream.shutdown().await?;","+                Ok(())","+            }","+        })?;","+        Ok((server, requests))","+    }","+","     pub fn addr(&self) -> String {","         self.addr.to_string()","     }"," }"," ","+/// The request heads received by a [`Server::raw`], in order.","+#[derive(Clone, Default)]","+pub struct RawRequests(Arc<Mutex<Vec<Vec<u8>>>>);","+","+impl RawRequests {","+    pub fn get(&self) -> Vec<Vec<u8>> {","+        self.0.lock().unwrap().clone()","+    }","+}","+"," impl Drop for Server {","     fn drop(&mut self) {","         debug!(\"shutting down http1 server\");","@@ -193,3 +259,38 @@ where","         tokio::task::spawn(fut);","     }"," }","+","+#[cfg(test)]","+mod tests {","+    use super::Server;","+    use std::io::{Read as _, Write as _};","+    use std::net::TcpStream;","+","+    #[test]","+    fn raw_server_records_and_responds() {","+        const RESPONSE: &[u8] = b\"HTTP/1.1 200 OK\\r\\n\\","+            content-length: 5\\r\\n\\","+            content-length: 100\\r\\n\\","+            transfer-encoding: chunked\\r\\n\\","+            \\r\\n\\","+            0\\r\\n\\r\\n\";","+        let (server, requests) = Server::raw(2, |head| {","+            assert!(head.starts_with(b\"GET /dup \"));","+            RESPONSE.to_vec()","+        })","+        .unwrap();","+","+        // Send a body in the same write as the head; only the head is recorded.","+        let request = b\"GET /dup HTTP/1.1\\r\\nhost: example.com\\r\\ncontent-length: 4\\r\\n\\r\\n\";","+        let mut stream = TcpStream::connect(server.addr()).unwrap();","+        stream.write_all(&[&request[..], b\"body\"].concat()).unwrap();","+        let mut response = Vec::new();","+        stream.read_to_end(&mut response).unwrap();","+        assert_eq!(response, RESPONSE);","+","+        // Dropping the server connects once more for the unused connection;","+        // that empty connection must not be recorded.","+        drop(server);","+        assert_eq!(requests.get(), [request.to_vec()]);","+    }","+}"],"additions":107,"deletions":6,"truncated":false},{"path":"crates/wasi-http/tests/all/p2/async_.rs","lines":["@@ -126,6 +126,18 @@ async fn p2_http_outbound_request_content_length() -> Result<()> {","     run(P2_HTTP_OUTBOUND_REQUEST_CONTENT_LENGTH_COMPONENT, &server).await"," }"," ","+#[test_log::test(tokio::test(flavor = \"multi_thread\"))]","+async fn p2_http_outbound_request_forward_duplicate_content_length() -> Result<()> {","+    crate::shared::forward_duplicate_content_length(async |server| {","+        run(","+            P2_HTTP_OUTBOUND_REQUEST_FORWARD_DUPLICATE_CONTENT_LENGTH_COMPONENT,","+            server,","+        )","+        .await","+    })","+    .await","+}","+"," #[test_log::test(tokio::test(flavor = \"multi_thread\"))]"," async fn p2_http_outbound_request_missing_path_and_query() -> Result<()> {","     let server = Server::http1(1)?;"],"additions":12,"deletions":0,"truncated":false},{"path":"crates/wasi-http/tests/all/p2/sync.rs","lines":["@@ -123,6 +123,20 @@ fn p2_http_outbound_request_content_length() -> Result<()> {","     run(P2_HTTP_OUTBOUND_REQUEST_CONTENT_LENGTH_COMPONENT, &server)"," }"," ","+#[test_log::test]","+fn p2_http_outbound_request_forward_duplicate_content_length() -> Result<()> {","+    // `run` blocks on its own runtime so this can't be driven by another one,","+    // but nothing here awaits anything, so a single poll completes it.","+    crate::shared::forward_duplicate_content_length(async |server| {","+        run(","+            P2_HTTP_OUTBOUND_REQUEST_FORWARD_DUPLICATE_CONTENT_LENGTH_COMPONENT,","+            server,","+        )","+    })","+    .now_or_never()","+    .expect(\"future completes without awaiting\")","+}","+"," #[test_log::test]"," fn p2_http_outbound_request_missing_path_and_query() -> Result<()> {","     let server = Server::http1(1)?;"],"additions":14,"deletions":0,"truncated":false},{"path":"crates/wasi-http/tests/all/p3/mod.rs","lines":["@@ -383,9 +383,21 @@ async fn p3_http_outbound_request_response_build() -> wasmtime::Result<()> {","     run_cli(P3_HTTP_OUTBOUND_REQUEST_RESPONSE_BUILD_COMPONENT, &server).await"," }"," ","+#[test_log::test(tokio::test(flavor = \"multi_thread\"))]","+async fn p3_http_outbound_request_forward_duplicate_content_length() -> wasmtime::Result<()> {","+    crate::shared::forward_duplicate_content_length(async |server| {","+        run_cli(","+            P3_HTTP_OUTBOUND_REQUEST_FORWARD_DUPLICATE_CONTENT_LENGTH_COMPONENT,","+            server,","+        )","+        .await","+    })","+    .await","+}","+"," #[test_log::test(tokio::test(flavor = \"multi_thread\"))]"," async fn p3_http_outbound_request_content_length() -> wasmtime::Result<()> {","-    let server = Server::http1(3)?;","+    let server = Server::http1(4)?;","     run_cli(P3_HTTP_OUTBOUND_REQUEST_CONTENT_LENGTH_COMPONENT, &server).await"," }"," "],"additions":13,"deletions":1,"truncated":false},{"path":"crates/wasi-http/tests/all/shared.rs","lines":["@@ -1,3 +1,4 @@","+use crate::http_server::Server;"," use wasmtime::component::{Component, Linker, ResourceTable};"," use wasmtime::{Result, Store};"," use wasmtime_wasi::{NamedId, WasiCtx, WasiCtxView, WasiView};","@@ -95,3 +96,46 @@ pub async fn run_named_imports_test<T>(","     })?;","     run(&mut store, &component, &linker).await"," }","+","+/// Runs a guest which fetches `/dup` from a raw server, whose response","+/// carries two conflicting `content-length` values, and then forwards those","+/// headers in a new request to `/victim`, which the host must reject.","+///","+/// `run_guest` instantiates and runs the guest against the given server; the","+/// guest itself asserts the error it observes. Afterwards this asserts that","+/// nothing but the guest's `/dup` requests ever reached the wire.","+pub async fn forward_duplicate_content_length(","+    run_guest: impl AsyncFnOnce(&Server) -> Result<()>,","+) -> Result<()> {","+    // `hyper`'s client accepts this response since `transfer-encoding` takes","+    // precedence over `content-length`, but both values reach the guest.","+    const DUP: &[u8] = b\"HTTP/1.1 200 OK\\r\\n\\","+        content-length: 5\\r\\n\\","+        content-length: 100\\r\\n\\","+        transfer-encoding: chunked\\r\\n\\","+        \\r\\n\\","+        0\\r\\n\\r\\n\";","+    // The guest fetches `/dup` twice, and must never send `/victim`; the","+    // extra connections let a `/victim` request be observed should it","+    // escape.","+    let (server, requests) = Server::raw(4, |head| {","+        if head.starts_with(b\"GET /dup \") {","+            DUP.to_vec()","+        } else {","+            b\"HTTP/1.1 200 OK\\r\\ncontent-length: 0\\r\\n\\r\\n\".to_vec()","+        }","+    })?;","+    run_guest(&server).await?;","+    drop(server);","+","+    let requests = requests.get();","+    assert_eq!(requests.len(), 2, \"unexpected requests: {requests:?}\");","+    for head in &requests {","+        assert!(","+            head.starts_with(b\"GET /dup \"),","+            \"unexpected request reached the wire: {}\",","+            String::from_utf8_lossy(head)","+        );","+    }","+    Ok(())","+}",""],"additions":44,"deletions":0,"truncated":false}],"additions":377,"deletions":12,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-30T15:56:57.926801+00:00"}