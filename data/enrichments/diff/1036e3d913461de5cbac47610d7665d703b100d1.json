o through sess->heap after the SSL is gone. */","     ExpectNotNull(dup = wolfSSL_SESSION_dup(sess));","     ExpectPtrEq(dup->heap, hint);","-    ExpectIntEQ(hint->refCount, 2);","+    ExpectIntGT(wolfSSL_RefCur(hint->refCount), refs);","     wolfSSL_SESSION_free(dup);","-    ExpectIntEQ(hint->refCount, 1);","-    /* The last reference: the hint goes back to the pool (checked below). */","+    ExpectIntEQ(wolfSSL_RefCur(hint->refCount), refs);","+    /* Last holder: the hint goes back to the pool. */","     wolfSSL_SESSION_free(sess);"," ","     /* Everything allocated for the SSL went back to the pool. Stats are not","@@ -39905,6 +39905,7 @@ static int test_wolfSSL_session_ticket_static_heap(void)","     WOLFSSL_SESSION* sess = NULL;","     WOLFSSL_SESSION* dup = NULL;","     WOLFSSL_HEAP_HINT* hint = NULL;","+    int refs = 0;","     WOLFSSL_MEM_STATS before;","     WOLFSSL_MEM_STATS after;","     char buf[1];","@@ -39953,29 +39954,27 @@ static int test_wolfSSL_session_ticket_static_heap(void)","     ssl_c = NULL;","     wolfSSL_free(ssl_s);","     ssl_s = NULL;","-    /* The retained session keeps the client's per-SSL hint alive. */","-    ExpectIntEQ(hint->refCount, 1);","+    /* The session keeps the client's hint alive. */","+    ExpectIntGE(refs = wolfSSL_RefCur(hint->refCount), 1);"," ","     /* Resume with the session on a new SSL; a new ticket replaces the old. */","     ExpectIntEQ(test_session_static_heap_new_pair(&test_ctx, &ctx_c, &ctx_s,","         &ssl_c, &ssl_s, sess), TEST_SUCCESS);","     ExpectIntEQ(wolfSSL_session_reused(ssl_c), 1);","-    /* The new SSL took sess, then copied it (from sess->heap) before storing","-     * the new ticket, so the first SSL's hint is held twice. */","+    /* sess was copied from sess->heap, so both are on the first hint. */","     ExpectPtrNE(ssl_c->heap, hint);","     ExpectPtrNE(ssl_c->session, sess);","     ExpectPtrEq(ssl_c->session->heap, hint);","-    ExpectIntEQ(hint->refCount, 2);","+    ExpectIntGT(wolfSSL