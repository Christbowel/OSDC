LFMEM_TRACK_STATS, 1), WOLFSSL_SUCCESS);","+    /* IO buffers go into the same CTX hint. */","+    ExpectIntEQ(wolfSSL_CTX_load_static_memory(&ctx_c, NULL, cliIoMem,","+        sizeof(cliIoMem), ioFlag, 1), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_CTX_load_static_memory(&ctx_s,","+        wolfSSLv23_server_method_ex, svrMem, sizeof(svrMem),","+        WOLFMEM_GENERAL, 1), WOLFSSL_SUCCESS);","+    if (EXPECT_SUCCESS()) {","+        wolfSSL_CTX_set_verify(ctx_c, WOLFSSL_VERIFY_NONE, NULL);","+        wolfSSL_SetIORecv(ctx_c, test_memio_read_cb);","+        wolfSSL_SetIOSend(ctx_c, test_memio_write_cb);","+        wolfSSL_SetIORecv(ctx_s, test_memio_read_cb);","+        wolfSSL_SetIOSend(ctx_s, test_memio_write_cb);","+    }","+    ExpectIntEQ(wolfSSL_CTX_use_certificate_file(ctx_s, svrCertFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_CTX_use_PrivateKey_file(ctx_s, svrKeyFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+","+    /* A first connection makes the one-time allocations for the CTXs; take","+     * the baseline after it. */","+    ExpectIntEQ(test_memio_setup(&test_ctx, &ctx_c, &ctx_s, &ssl_c, &ssl_s,","+        NULL, NULL), 0);","+    ExpectIntEQ(test_memio_do_handshake(ssl_c, ssl_s, 10, NULL), 0);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_c, &before), 1);","+    ExpectIntGT(before.avaIO, 0);","+","+    /* The session outlives the SSL whose IO buffers came from the pool. */","+    test_memio_clear_buffer(&test_ctx, 1);","+    test_memio_clear_buffer(&test_ctx, 0);","+    ExpectIntEQ(test_memio_setup(&test_ctx, &ctx_c, &ctx_s, &ssl_c, &ssl_s,","+        NULL, NULL), 0);","+    ExpectIntEQ(test_memio_do_handshake(ssl_c, ssl_s, 10, NULL), 0);","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl_c->heap);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl_c));","+    ExpectPtrEq(sess->heap, hint);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    ExpectIntGE(wolfSSL_RefCur(hint->refCount), 1);","+    /* All IO buffers are back in the pool while the hint lives on. */","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_c, &stats), 1);","+    ExpectIntEQ(stats.avaIO, before.avaIO);","+    /* Last holder: the hint goes back to the pool. */","+    wolfSSL_SESSION_free(sess);","+    sess = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_c, &stats), 1);","+    ExpectIntEQ(stats.curAlloc, before.curAlloc);","+    ExpectIntEQ(stats.avaIO, before.avaIO);","+","+    /* IO buffers taken directly from the per-SSL hint. Fixed ones belong to","+     * the SSL and hold no ref; pool ones hold one, and realloc keeps it. */","+    ExpectNotNull(ssl_c = wolfSSL_new(ctx_c));","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl_c->heap);","+    if (EXPECT_SUCCESS())","+        refs = wolfSSL_RefCur(hint->refCount);","+    ExpectNotNull(io = XMALLOC(64, hint, DYNAMIC_TYPE_IN_BUFFER));","+    ExpectIntEQ(wolfSSL_RefCur(hint->refCount), fixed ? refs : refs + 1);","+#ifndef WOLFSSL_NO_REALLOC","+    ExpectNotNull(tmp = XREALLOC(io, 128, hint, DYNAMIC_TYPE_IN_BUFFER));","+    /* IO buffers are fixed size, so resized in place. */","+    ExpectPtrEq(tmp, io);","+    ExpectIntEQ(wolfSSL_RefCur(hint->refCount), fixed ? refs : refs + 1);","+#else","+    (void)tmp;","+#endif","+    XFREE(io, hint, DYNAMIC_TYPE_IN_BUFFER);","+    io = NULL;","+    ExpectIntEQ(wolfSSL_RefCur(hint->refCount), refs);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_c, &stats), 1);","+    ExpectIntEQ(stats.curAlloc, before.curAlloc);","+    ExpectIntEQ(stats.avaIO, before.avaIO);","+","+    wolfSSL_CTX_free(ctx_c);","+    wolfSSL_CTX_free(ctx_s);","+    return EXPECT_RESULT();","+}","+#endif","+","+/* IO pool and fixed IO blocks keep the per-SSL hint's ref count balanced. */","+static int test_wolfSSL_static_heap_io_refs(void)","+{","+    EXPECT_DECLS;","+#if defined(WOLFSSL_STATIC_MEMORY) && !defined(WOLFSSL_STATIC_MEMORY_LEAN) && \\","+    defined(HAVE_MANUAL_MEMIO_TESTS_DEPENDENCIES) && \\","+    !defined(NO_SESSION_CACHE) && !defined(NO_RSA)","+    ExpectIntEQ(test_static_heap_io_refs(WOLFMEM_IO_POOL_FIXED), TEST_SUCCESS);","+    ExpectIntEQ(test_static_heap_io_refs(WOLFMEM_IO_POOL), TEST_SUCCESS);","+#endif","+    return EXPECT_RESULT();","+}","+","+/* A reallocated block keeps its ref on the per-SSL hint, even as the last","+ * holder after wolfSSL_free(). */","+static int test_wolfSSL_static_heap_realloc_refs(void)","+{","+    EXPECT_DECLS;","+#if defined(WOLFSSL_STATIC_MEMORY) && !defined(WOLFCRYPT_ONLY) && \\","+    !defined(NO_TLS) && !defined(NO_WOLFSSL_CLIENT) && \\","+    !defined(WOLFSSL_NO_REALLOC)","+    byte mem[TEST_TLS_STATIC_MEMSZ];","+    WOLFSSL_HEAP_HINT* heap = NULL;","+    WOLFSSL_CTX* ctx = NULL;","+    WOLFSSL* ssl = NULL;","+    WOLFSSL_HEAP_HINT* hint = NULL;","+    void* p = NULL;","+    void* tmp = NULL;","+    int refs = 0;","+    WOLFSSL_MEM_STATS before;","+    WOLFSSL_MEM_STATS after;","+","+    XMEMSET(&before, 0, sizeof(before));","+    XMEMSET(&after, 0, sizeof(after));","+    ExpectIntEQ(wc_LoadStaticMemory(&heap, mem, sizeof(mem),","+        WOLFMEM_GENERAL | WOLFMEM_TRACK_STATS, 1), 0);","+    ExpectNotNull(ctx = wolfSSL_CTX_new_ex(wolfSSLv23_client_method_ex(heap),","+        heap));","+    /* The first SSL makes a one-time allocation for the CTX; take the","+     * baseline after it. */","+    ExpectNotNull(ssl = wolfSSL_new(ctx));","+    wolfSSL_free(ssl);","+    ssl = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx, &before), 1);","+","+    ExpectNotNull(ssl = wolfSSL_new(ctx));","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl->heap);","+    if (EXPECT_SUCCESS())","+        refs = wolfSSL_RefCur(hint->refCount);","+    ExpectNotNull(p = XMALLOC(64, hint, DYNAMIC_TYPE_TMP_BUFFER));","+    ExpectIntEQ(wolfSSL_RefCur(hint->