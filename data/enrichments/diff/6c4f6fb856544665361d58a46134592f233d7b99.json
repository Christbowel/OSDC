seed-val"," ","-# Enable support for forkless snapshot operations by allocating metadata for each key.","-# This is an immutable configuration that must be set at server startup and","-# cannot be changed at runtime.","+# Forkless background operations do their work on a background thread instead of","+# fork()'ing, avoiding the copy-on-write memory overhead a fork can incur under","+# write-heavy load."," #","-# When enabled, the server allocates 4 additional bytes per key.","+# Two configs control this:"," #","-# Note: This only enables the infrastructure support. The actual forkless save","-# behavior is controlled separately by 'bgsave-default-method forkless'.","+# forkless-infrastructure-enabled: enables the required per-key metadata. It is","+# immutable (must be set at startup) and costs 4 additional bytes per key. It","+# only enables support; on its own it does not change behavior.","+#","+# forkless-policy: chooses fork vs forkless for background operations:","+#","+#   require-fork      Always fork; never use forkless.","+#   prefer-forkless   Use forkless when possible, falling back to fork otherwise.","+#","+# 'prefer-forkless' can only be selected when 'forkless-infrastructure-enabled","+# yes' was set at startup."," #"," # forkless-infrastructure-enabled no","+# forkless-policy require-fork"," "," ################################ SNAPSHOTTING  ################################"," ","@@ -616,13 +626,6 @@ locale-collate \"\""," # permissions, and so forth."," stop-writes-on-bgsave-error yes"," ","-# Default method for background saves (BGSAVE and automatic periodic saves).","-#","-# 'forkless' can only be selected when the server was started with","-# 'forkless-infrastructure-enabled yes'. Otherwise setting it is rejected.","-#","-# bgsave-default-method fork","-"," # Control compression for RDB persistence and RDB-encoded AOF base files."],"additions":16,"deletions":13,"truncated":false}],"additions":99,"deletions":80,"truncated":true,"file_count":11},