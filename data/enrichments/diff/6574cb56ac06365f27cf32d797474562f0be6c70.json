n/Call/StaticCallAnalyzer.php","lines":["@@ -603,6 +603,7 @@ public static function taintReturnType(","                 $codebase,","                 $method_storage,","                 $template_result,","+                $stmt->isFirstClassCallable() ? [] : $stmt->getArgs(),","             )","             : 0;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Codebase/ClassLikes.php","lines":["@@ -711,6 +711,16 @@ public function addClassAlias(string $fq_class_name, string $alias_name): void","         $this->existing_classlike_aliases[$alias_name] = true;","     }"," ","+    /**","+     * Whether class_alias() gives a class the name","+     *","+     * @psalm-mutation-free","+     */","+    public function isClassAlias(string $name): bool","+    {","+        return isset($this->classlike_aliases_map[strtolower($name)]);","+    }","+","     /** @psalm-mutation-free */","     public function getUnAliasedName(string $alias_name): string","     {"],"additions":10,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Codebase/TaintFlowResolution.php","lines":["@@ -2227,15 +2227,25 @@ private function walkEdges(int $state, string $from_id): void","         $kept = $this->state_kept[$state];","         $added = $this->state_added[$state];"," ","+        $input_taints = $this->codebase->getInputTaints();","+","         foreach ($this->forward_edges[$from_id] as $to_id => $path) {","             $removed_taints = $path->removed_taints;","-            $next_added = ($added | $path->added_taints) & ~$removed_taints;","+            $path_added = $path->added_taints;","+","+            // A path adds the input taints (a decoder giving back what escapes removed) to a flow of input only: a","+            // flow of secrets doesn't become user input. A source of input a plugin adds is a source of its own.","+            if ((($kept | $added) & $input_taints) === 0) {","+                $path_added &= ~$input_taints;","+            }","+","+            $next_added = ($added | $path_added) & ~$removed_taints;"," ","             // What a builtin decodes from a string (json_decode(), unserialize(), parse_str(), ...) can be an array","             // or an object again, whatever the string's type took away: decoded user input can be a NoSQL query.","             // In the walk of an entry, the taints the calls keep aren't known: any of them may be user input.","             if ($path->type === DataFlowGraph::UNSERIALIZATION_PATH_TYPE","-                && (($kept | $next_added) & ~$removed_taints & $this->codebase->getInputTaints()) !== 0","+                && (($kept | $next_added) & ~$removed_taints & $input_taints) !== 0","             ) {","                 $next_added |= TaintKind::ARRAY_ONLY;","             }"],"additions":12,"deletions":2,"truncated":false},{"path":"src/Psalm/Internal/PreloaderList.php","lines":["@@ -934,8 +934,9 @@ final class PreloaderList {","         \\Psalm\\Internal\\Preloader::class,","         \\Psalm\\Internal\\PreloaderList::class,","         \\Psalm\\Internal\\PrettyPrinter::class,","+        \\Psalm\\Internal\\Provider\\AddRemoveTaints\\ConstantFlags::class,","         \\Psalm\\Internal\\Provider\\AddRemoveTaints\\HtmlFunctionTainter::class,","-        \\Psalm\\Internal\\Provider\\AddRemoveTaints\\JsonEncodeTainter::class,","+        \\Psalm\\Internal\\Provider\\AddRemoveTaints\\JsonFunctionTainter::class,","         \\Psalm\\Internal\\Provider\\ClassLikeStorageCacheProvider::class,","         \\Psalm\\Internal\\Provider\\ClassLikeStorageProvider::class,","         \\Psalm\\Internal\\Provider\\DynamicFunctionStorageProvider::class,"],"additions":2,"deletions":1,"truncated":false},{"path":"src/Psalm/Internal/Provider/AddRemoveTaints/ConstantFlags.php","lines":["@@ -0,0 +1,678 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Psalm\\Internal\\Provider\\AddRemoveTaints;","+","+use PhpParser\\Node;","+use PhpParser\\Node\\Arg;","+use PhpParser\\Node\\ArrayItem;","+use PhpParser\\Node\\Const_;","+use PhpParser\\Node\\Expr;","+use PhpParser\\Node\\Expr\\ArrowFunction;","+use PhpParser\\Node\\Expr\\Assign;","+use PhpParser\\Node\\Expr\\AssignOp;","+use PhpParser\\Node\\Expr\\AssignRef;","+use PhpParser\\Node\\Expr\\BinaryOp\\BitwiseAnd;","+use PhpParser\\Node\\Expr\\BinaryOp\\BitwiseOr;","+use PhpParser\\Node\\Expr\\CallLike;","+use PhpParser\\Node\\Expr\\ClassConstFetch;","+use PhpParser\\Node\\Expr\\Closure;","+use PhpParser\\Node\\Expr\\ConstFetch;","+use PhpParser\\Node\\Expr\\Eval_;","+use PhpParser\\Node\\Expr\\FuncCall;","+use PhpParser\\Node\\Expr\\Include_;","+use PhpParser\\Node\\Expr\\PostDec;","+use PhpParser\\Node\\Expr\\PostInc;","+use PhpParser\\Node\\Expr\\PreDec;","+use PhpParser\\Node\\Expr\\PreInc;","+use PhpParser\\Node\\Expr\\Ternary;","+use PhpParser\\Node\\Expr\\Variable;","+use PhpParser\\Node\\FunctionLike;","+use PhpParser\\Node\\Identifier;","+use PhpParser\\Node\\Name;","+use PhpParser\\Node\\Scalar\\Int_;","+use PhpParser\\Node\\StaticVar;","+use PhpParser\\Node\\Stmt\\Catch_;","+use PhpParser\\Node\\Stmt\\ClassLike;","+use PhpParser\\Node\\Stmt\\ClassMethod;","+use PhpParser\\Node\\Stmt\\Foreach_;","+use PhpParser\\Node\\Stmt\\Function_;","+use PhpParser\\Node\\Stmt\\Global_;","+use PhpParser\\Node\\Stmt\\Namespace_;","+use PhpParser\\Node\\Stmt\\Static_;","+use PhpParser\\Node\\Stmt\\Unset_;","+use PhpParser\\NodeFinder;","+use Psalm\\Codebase;","+use Psalm\\Internal\\Analyzer\\FunctionLikeAnalyzer;","+use Psalm\\Internal\\Analyzer\\MethodAnalyzer;","+use Psalm\\Internal\\Analyzer\\StatementsAnalyzer;","+use Psalm\\Internal\\Analyzer\\TraitAnalyzer;","+use Psalm\\Internal\\Provider\\FileStorageProvider;","+use Psalm\\Storage\\ClassLikeStorage;","+use ReflectionClass;","+","+use function array_map;","+use function array_values;","+use function class_exists;","+use function count;","+use function get_defined_constants;","+use function in_array;","+use function interface_exists;","+use function is_array;","+use function is_int;","+use function is_string;","+use function strtolower;","+","+/**","+ * The bits of the flags of a call, which tell the escapes it does. Only a compile-time constant expression tells them:","+ * an int literal, a builtin constant (no code can redefine one), a class constant whose declared value is such an","+ * expression, a variable of a function-like only ever assigned such expressions, and `|`, `&` and ternaries of them.","+ * Anything else (a property, a parameter, a call) may hold any bits whatever its inferred type, which an assert()","+ * compiled out in production, a `@var`, a `@param` with a suppressed or baselined wrong caller or a `$$name` write can","+ * make a literal the runtime value doesn't have.","+ *","+ * So a taint is only removed for the bits a constant expression has, while the taints given back by the bits a value","+ * may have go by its inferred type: there, an unknown type gives back more.","+ *","+ * @internal","+ */","+final class ConstantFlags","+{","+    /** The bits of a value that isn't constant: it has none for sure, and may have any */","+    private const UNKNOWN = [0, -1];","+","+    /** The builtin functions taking flags, which take all of their arguments by value */","+    private const FLAG_FUNCTIONS = [","+        'html_entity_decode',","+        'htmlentities',","+        'htmlspecialchars',","+        'htmlspecialchars_decode',","+        'json_decode',","+        'json_encode',","+    ];","+","+    /**","+     * The bits every value of the expression has, and those its values may have","+     *","+     * @return array{int, int}","+     */","+    public static function getBits(StatementsAnalyzer $statements_analyzer, Expr $expr): array","+    {","+        $codebase = $statements_analyzer->getCodebase();","+","+        // self:: is the class of a method only: a closure may be bound to another scope, and the self:: of a trait","+        // method is each class using it","+        $source = $statements_analyzer->getSource();","+        $class = $source instanceof MethodAnalyzer && !$source->getSource() instanceof TraitAnalyzer","+            ? $source->getFQCLN()","+            : null;","+        $self = $class !== null ? self::getClass($codebase, $class) : null;","+","+        return self::getExpressionBits($codebase, $expr, $self, true, [], $statements_analyzer);","+    }","+","+    /**","+     * @param bool $static_is_self whether `static::` may be the class of $self (it can't be in the value of a constant)","+     * @param array<string, true> $visited the class constants and variables being evaluated, against cycles","+     * @param ?StatementsAnalyzer $statements_analyzer the analyzer of the code the variables are read in, if any","+     * @return array{int, int}","+     */","+    private static function getExpressionBits(","+        Codebase $codebase,","+        Expr $expr,","+        ?ClassLikeStorage $self,","+        bool $static_is_self,","+        array $visited,","+        ?StatementsAnalyzer $statements_analyzer = null,","+    ): array {","+        if ($expr instanceof Int_) {","+            return [$expr->value, $expr->value];","+        }","+","+        if ($expr instanceof ConstFetch) {","+            $value = self::getBuiltinConstant($expr->name);","+","+            return $value !== null ? [$value, $value] : self::UNKNOWN;","+        }","+","+        if ($expr instanceof ClassConstFetch) {","+            return self::getClassConstantBits($codebase, $expr, $self, $static_is_self, $visited);","+        }","+","+        if ($expr instanceof BitwiseOr || $expr instanceof BitwiseAnd) {","+            [$left_certain, $left_possible] = self::getExpressionBits(","+                $codebase,","+                $expr->left,","+                $self,","+                $static_is_self,","+                $visited,","+                $statements_analyzer,","+            );","+            [$right_certain, $right_possible] = self::getExpressionBits(","+                $codebase,","+                $expr->right,","+                $self,","+                $static_is_self,","+                $visited,","+                $statements_analyzer,","+            );","+","+            return $expr instanceof BitwiseOr","+                ? [$left_certain | $right_certain, $left_possible | $right_possible]","+                : [$left_certain & $right_certain, $left_possible & $right_possible];","+        }","+","+        if ($expr instanceof Ternary) {","+            // the value is one of the branches: the first one of `?:` is the condition","+            [$if_certain, $if_possible] = self::getExpressionBits(","+                $codebase,","+                $expr->if ?? $expr->cond,","+                $self,","+                $static_is_self,","+                $visited,","+                $statements_analyzer,","+            );","+            [$else_certain, $else_possible] = self::getExpressionBits(","+                $codebase,","+                $expr->else,","+                $self,","+                $static_is_self,","+                $visited,","+                $statements_analyzer,","+            );","+","+            return [$if_certain & $else_certain, $if_possible | $else_possible];","+        }","+","+        if ($expr instanceof Variable && is_string($expr->name) && $statements_analyzer !== null) {","+            return self::getVariableBits(","+                $codebase,","+                $statements_analyzer,","+                $expr,","+                $expr->name,","+                $self,","+                $static_is_self,","+                $visited,","+            );","+        }","+","+        return self::UNKNOWN;","+    }","+","+    /**","+     * A variable of a function-like that is only ever written by assignments of constant expressions has the bits","+     * all of them have. Its inferred type, an int, tells it is set before it is read.","+     *","+     * @param array<string, true> $visited","+     * @return array{int, int}","+     */","+    private static function getVariableBits(","+        Codebase $codebase,","+        StatementsAnalyzer $statements_analyzer,","+        Variable $variable,","+        string $name,","+        ?ClassLikeStorage $self,","+        bool $static_is_self,","+        array $visited,","+    ): array {","+        $type = $statements_analyzer->node_data->getType($variable);","+        $source = $statements_analyzer->getSource();","+","+        if ($type === null","+            || !$type->isInt()","+            || $type->possibly_undefined","+            || $type->possibly_undefined_from_try","+            || isset($visited['$' . $name])","+            || !$source instanceof FunctionLikeAnalyzer","+        ) {","+            return self::UNKNOWN;","+        }","+","+        $assigned = self::getAssignedValues($statements_analyzer, $source->getFunctionNode(), $name);","+","+        if ($assigned === null || $assigned === []) {","+            return self::UNKNOWN;","+        }","+","+        $visited['$' . $name] = true;","+        $certain = -1;","+        $possible = 0;","+","+        foreach ($assigned as $value) {","+            [$value_certain, $value_possible] = self::getExpressionBits(","+                $codebase,","+                $value,","+                $self,","+                $static_is_self,","+                $visited,","+                $statements_analyzer,","+            );","+            $certain &= $value_certain;","+            $possible |= $value_possible;","+        }","+","+        return [$certain, $possible];","+    }","+","+    /**","+     * The values the plain assignments of the function-like give the variable, or null if anything else may write","+     * it: a parameter, a closure `use`, a reference, a by-reference argument, a loop, `unset()`, `global`, `static`,","+     * `catch`, `$$name`, `extract()`, `eval()` or an included file. An arrow function reads the variables of the","+     * code around it.","+     *","+     * @return list<Expr>|null","+     */","+    private static function getAssignedValues(","+        StatementsAnalyzer $statements_analyzer,","+        Closure|Function_|ClassMethod|ArrowFunction $function,","+        string $name,","+    ): ?array {","+        if ($function instanceof ArrowFunction) {","+            return null;","+        }","+","+        foreach ($function->getParams() as $param) {","+            if ($param->var instanceof Variable && $param->var->name === $name) {","+                return null;","+            }","+        }","+","+        if ($function instanceof Closure) {","+            foreach ($function->uses as $use) {","+                if ($use->var->name === $name) {","+                    return null;","+                }","+            }","+        }","+","+        $assigned = [];","+","+        foreach ($function->getStmts() ?? [] as $stmt) {","+            if (!self::collectAssignedValues($statements_analyzer, $stmt, $name, $assigned)) {","+                return null;","+            }","+        }","+","+        return $assigned;","+    }","+","+    /**","+     * @param list<Expr> $assigned","+     * @return bool false if the node may write the variable otherwise than by a plain assignment","+     */","+    private static function collectAssignedValues(","+        StatementsAnalyzer $statements_analyzer,","+        Node $node,","+        string $name,","+        array &$assigned,","+    ): bool {","+        if ($node instanceof Closure) {","+            foreach ($node->uses as $use) {","+                if ($use->byRef && $use->var->name === $name) {","+                    return false;","+                }","+            }","+","+            return true;","+        }","+","+        // their variables are their own","+        if ($node instanceof FunctionLike || $node instanceof ClassLike) {","+            return true;","+        }","+","+        if (($node instanceof Variable && !is_string($node->name))","