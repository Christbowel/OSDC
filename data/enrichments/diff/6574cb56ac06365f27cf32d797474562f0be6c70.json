{"id":"6574cb56ac06365f27cf32d797474562f0be6c70","axis":"silent","repo":"vimeo/psalm","sha":"6574cb56ac06365f27cf32d797474562f0be6c70","parsed":{"files":[{"path":"docs/security_analysis/custom_taint_sources.md","lines":["@@ -150,3 +150,5 @@ class TaintBadDataPlugin implements AddTaintsInterface","     }"," }"," ```","+","+The taints a handler adds make the expression a source of its own."],"additions":2,"deletions":0,"truncated":false},{"path":"docs/security_analysis/index.md","lines":["@@ -349,6 +349,7 @@ function processVar(string $str, bool $escape = true): string {"," "," echo processVar($_GET['text'], false); // TaintedHtml"," echo processVar($_GET['text'], true); // no issue","+echo processVar(...[$_GET['text'], true]); // TaintedHtml: an unpacked argument isn't read"," ```"," "," Where you can, accept and store user input as plain text fields rather than blocks of HTML, so that it can always be","@@ -369,10 +370,45 @@ function sanitizeHTML(string $html): string {"," }"," ```"," ","-**Note on `json_encode()`:** Psalm automatically strips `html` when the flags are statically known to include both","-`JSON_HEX_TAG` and `JSON_HEX_AMP`. It never strips `has_quotes`, because JSON strings are wrapped in `\"` which can break","-out of a double-quoted HTML attribute. If your helper only outputs JSON inside `<script>` tags — or passes","-`JSON_HEX_APOS` for a single-quoted attribute — add `@psalm-taint-escape has_quotes` to the helper.","+#### Escaping by flags","+","+What `json_encode()`, `htmlspecialchars()` and `htmlentities()` escape depends on their flags. Psalm reads them from","+constant expressions only: int literals, builtin and class constants, variables only ever assigned such expressions,","+and `|`, `&` and ternaries of them, never from a type. In a namespace, write `\\JSON_HEX_TAG` or import it with","+`use const`. The decoders give back what the escapes removed:","+","+```php","+<?php","+","+final class Json","+{","+    public const FLAGS = JSON_HEX_TAG | JSON_HEX_AMP;","+}","+","+/** @param 3 $three */","+function show(int $flags, int $three): void","+{","+    echo json_encode($_GET['a'], Json::FLAGS); // TaintedTextWithQuotes, but no TaintedHtml","+    $hex = JSON_HEX_TAG | JSON_HEX_AMP;","+    echo json_encode($_GET['a'], $hex); // TaintedTextWithQuotes, but no TaintedHtml","+    echo json_encode($_GET['a'], $flags | JSON_HEX_TAG | JSON_HEX_AMP); // TaintedTextWithQuotes","+    echo json_encode($_GET['a'], $three); // TaintedHtml","+    echo json_decode(json_encode($_GET['a'], Json::FLAGS)); // TaintedHtml","+    echo htmlspecialchars($_GET['a'], ENT_QUOTES); // no issue","+    echo htmlspecialchars($_GET['a'], ENT_NOQUOTES); // TaintedTextWithQuotes","+    echo htmlspecialchars(...[$_GET['a'], ENT_QUOTES]); // TaintedTextWithQuotes","+    echo html_entity_decode(htmlspecialchars($_GET['a'], ENT_QUOTES)); // TaintedHtml","+    header('X-Data: ' . json_encode($_GET['a'])); // no issue","+    header('X-Data: ' . json_encode($_GET['a'], JSON_PRETTY_PRINT)); // TaintedHeader","+}","+```","+","+`json_encode()` always keeps `has_quotes`, because the `\"` around a JSON string ends a double-quoted attribute. If your","+helper only outputs JSON inside `<script>` tags, add `@psalm-taint-escape has_quotes` to it.","+","+Psalm reads a class constant only from a project class declared once, unconditionally, under its own name, while no","+scanned `class_alias()` call has an alias Psalm can't tell. It reads `static::` only on a natively final class or","+constant."," "," ## Reports through shared code"," "],"additions":40,"deletions":4,"truncated":false},{"path":"src/Psalm/Config.php","lines":["@@ -44,7 +44,7 @@"," use Psalm\\Internal\\Lz4Serializer;"," use Psalm\\Internal\\Perf;"," use Psalm\\Internal\\Provider\\AddRemoveTaints\\HtmlFunctionTainter;","-use Psalm\\Internal\\Provider\\AddRemoveTaints\\JsonEncodeTainter;","+use Psalm\\Internal\\Provider\\AddRemoveTaints\\JsonFunctionTainter;"," use Psalm\\Internal\\Scanner\\FileScanner;"," use Psalm\\Internal\\ZstdSerializer;"," use Psalm\\Issue\\ArgumentIssue;","@@ -2289,10 +2289,10 @@ public function initializePlugins(ProjectAnalyzer $project_analyzer): void","         }"," ","         new HtmlFunctionTainter();","-        new JsonEncodeTainter();","+        new JsonFunctionTainter();"," ","         $socket->registerHooksFromClass(HtmlFunctionTainter::class);","-        $socket->registerHooksFromClass(JsonEncodeTainter::class);","+        $socket->registerHooksFromClass(JsonFunctionTainter::class);","     }"," ","     private function loadPlugin(ProjectAnalyzer $projectAnalyzer, string $pluginClassName): PluginInterface"],"additions":3,"deletions":3,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/FunctionLikeAnalyzer.php","lines":["@@ -3024,6 +3024,14 @@ private function findAssignments(): void","         }","     }"," ","+    /**","+     * @psalm-mutation-free","+     */","+    public function getFunctionNode(): Closure|Function_|ClassMethod|ArrowFunction","+    {","+        return $this->function;","+    }","+","     /**","      * The storage this analyzer was created with (the one of the function-like being analysed).","      *"],"additions":8,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/Call/FunctionCallReturnTypeFetcher.php","lines":["@@ -30,6 +30,8 @@"," use Psalm\\Internal\\DataFlow\\DataFlowNode;"," use Psalm\\Internal\\FileManipulation\\FileManipulationBuffer;"," use Psalm\\Internal\\MethodIdentifier;","+use Psalm\\Internal\\Provider\\AddRemoveTaints\\HtmlFunctionTainter;","+use Psalm\\Internal\\Provider\\AddRemoveTaints\\JsonFunctionTainter;"," use Psalm\\Internal\\Type\\Comparator\\CallableTypeComparator;"," use Psalm\\Internal\\Type\\TemplateBound;"," use Psalm\\Internal\\Type\\TemplateInferredTypeReplacer;","@@ -57,6 +59,7 @@"," use UnexpectedValueException;"," "," use function array_all;","+use function array_any;"," use function array_values;"," use function count;"," use function explode;","@@ -1586,12 +1589,21 @@ private static function holdsOnlyArrays(Union $type): bool","     /**","      * The taints a call removes because of the arguments it is given (`@psalm-taint-escape ($escape is true ? \"html\" :","      * null)`): a condition the arguments can't decide removes nothing","+     *","+     * @param array<PhpParser\\Node\\Arg> $args the arguments of a PHP call, if any: an unpacked one removes nothing","      */","     public static function getConditionallyRemovedTaints(","         Codebase $codebase,","         FunctionLikeStorage $storage,","         TemplateResult $template_result,","+        array $args = [],","     ): int {","+        // the parameters an unpacked argument gives are inferred from all of its items, of which it may lack those","+        // after the first: `json_encode(...$args)` may be without the flags of the second item","+        if (array_any($args, static fn(PhpParser\\Node\\Arg $arg): bool => $arg->unpack)) {","+            return 0;","+        }","+","         $conditionally_removed_taints = 0;"," ","         foreach ($storage->conditionally_removed_taints as $conditionally_removed_taint) {","@@ -1642,7 +1654,11 @@ private static function taintReturnType(","         $codebase = $statements_analyzer->getCodebase();","         $event = new AddRemoveTaintsEvent($stmt, $context, $statements_analyzer, $codebase);"," ","-        $added_taints = $codebase->config->eventDispatcher->dispatchAddTaints($event);","+        $added_taints = $codebase->config->eventDispatcher->dispatchAddTaints($event)","+            // what the decoders give back of the taints escapes removed: their flows only, not a source of input","+            // anywhere the call is (an argument, an array item...), as a handler of the event would be","+            | JsonFunctionTainter::getGivenBackTaints($statements_analyzer, $stmt)","+            | HtmlFunctionTainter::getGivenBackTaints($statements_analyzer, $stmt);","         $remove