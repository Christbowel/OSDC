scribing the build"," if [[ \"$TFCI_INDEX_HTML_ENABLE\" == 1 ]]; then"],"additions":18,"deletions":3,"truncated":false},{"path":"ci/official/utilities/setup_docker.sh","lines":["@@ -78,4 +78,4 @@ if ! docker container inspect tf >/dev/null 2>&1 ; then","   fi"," "," fi","-tfrun() { docker exec tf \"$@\"; }","+_tfrun_exec() { docker exec tf \"$@\"; }",""],"additions":1,"deletions":1,"truncated":false}],"additions":30,"deletions":8,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-03T16:48:16.827011+00:00"}