{"id":"GHSA-rg72-5958-c65m","axis":"advisories","repo":"silverstripe/silverstripe-framework","sha":"bb4d04a498c34e21e428d029c4ce82bbdcce31b1","parsed":{"files":[{"path":"src/Security/Group.php","lines":["@@ -517,11 +517,7 @@ public function validate(): ValidationResult","         if ($this->Parent()->exists() && !Permission::check('ADMIN')) {","             $privilegedCodes = Permission::config()->get('privileged_permissions');","             if (!empty($privilegedCodes)) {","-                $inheritedCodes = Permission::get()->filter([","-                    'GroupID' => $this->Parent()->collateAncestorIDs(),","-                    'Code' => $privilegedCodes,","-                ]);","-                if ($inheritedCodes->exists()) {","+                if ($this->anyGroupGrantsPermission($this->Parent()->collateAncestorIDs(), $privilegedCodes)) {","                     $result->addError(","                         _t(","                             'SilverStripe\\\\Security\\\\Group.HierarchyPermsError',","@@ -594,7 +590,7 @@ protected function onBeforeDelete()"," ","     /**","      * Checks for permission-code CMS_ACCESS_SecurityAdmin.","-     * If the group has ADMIN permissions, it requires the user to have ADMIN permissions as well.","+     * If the group grants a permission leading to ADMIN, it requires the user to have ADMIN permissions as well.","      *","      * @param Member $member Member","      * @return boolean","@@ -614,11 +610,11 @@ public function canEdit($member = null)","         if (// either we have an ADMIN","             (bool)Permission::checkMember($member, \"ADMIN\")","             || (","-                // or a privileged CMS user and a group without ADMIN permissions.","+                // or a privileged CMS user and a group that does not grant a permission leading to ADMIN.","                 // without this check, a user would be able to add himself to an administrators group","                 // with just access to the \"Security\" admin interface","                 Permission::checkMember($member, \"CMS_ACCESS_SecurityAdmin\") &&","-                !Permission::get()->filter(['GroupID' => $this->ID, 'Code' => 'ADMIN'])->exists()","+                !$this->grantsEscalatingPermissions()","             )","         ) {","             return true;","@@ -627,6 +623,39 @@ public function canEdit($member = null)","         return false;","     }"," ","+    /**","+     * Determine whether a member of this group would receive a permission that leads to ADMIN, whether granted","+     * directly, via an assigned PermissionRole, or inherited from an ancestor group. Used to stop a non-admin user","+     * with only CMS_ACCESS_SecurityAdmin from editing an admin-equivalent group and escalating their own privileges.","+     */","+    private function grantsEscalatingPermissions(): bool","+    {","+        if (!$this->exists()) {","+            return false;","+        }","+        $privilegedCodes = Permission::config()->get('privileged_permissions') ?? [];","+        // EDIT_PERMISSIONS is privileged but cannot reach ADMIN - PermissionCheckboxSetField::saveInto()","+        // strips every privileged code from a non-admin's submission","+        $escalatingCodes = array_diff($privilegedCodes, ['EDIT_PERMISSIONS']);","+        return $this->anyGroupGrantsPermission($this->collateAncestorIDs(), $escalatingCodes);","+    }","+","+    /**","+     * Determine whether any of the given groups grants any of the given permission codes to its members,","+     * whether the code is assigned to the group directly or via an assigned PermissionRole.","+     *","+     * @param int[] $groupIDs","+     * @param string|string[] $codes","+     */","+    private function anyGroupGrantsPermission(array $groupIDs, array|string $codes): bool","+    {","+        if (empty($groupIDs) || empty($codes)) {","+            return false;","+        }","+        $grantingGroupIDs = Permission::get_groups_by_permission($codes)->columnUnique('ID');","+        return !empty(array_intersect($groupIDs, $grantingGroupIDs));","+    }","+","     /**","      * Checks for permission-code CMS_ACCESS_SecurityAdmin.","      *"],"additions":37,"deletions":8,"truncated":false},{"path":"tests/php/Security/GroupTest.php","lines":["@@ -3,7 +3,9 @@"," namespace SilverStripe\\Security\\Tests;"," "," use InvalidArgumentException;","+use PHPUnit\\Framework\\Attributes\\DataProvider;"," use SilverStripe\\Control\\Controller;","+use SilverStripe\\Core\\Validation\\ValidationException;"," use SilverStripe\\Dev\\FunctionalTest;"," use SilverStripe\\Forms\\Validation\\RequiredFieldsValidator;"," use SilverStripe\\Model\\List\\ArrayList;","@@ -11,6 +13,8 @@"," use SilverStripe\\Security\\Group;"," use SilverStripe\\Security\\Member;"," use SilverStripe\\Security\\Permission;","+use SilverStripe\\Security\\PermissionRole;","+use SilverStripe\\Security\\PermissionRoleCode;"," use SilverStripe\\Security\\Tests\\GroupTest\\TestMember;"," "," class GroupTest extends FunctionalTest","@@ -373,4 +377,195 @@ public function testSettingCodeRepeatedly()","         $group->write();","         $this->assertEquals($previousCode, $group->Code);","     }","+","+    /**","+     * A user with only CMS_ACCESS_SecurityAdmin (and not ADMIN) must not be able to edit any group that","+     * grants an effective permission leading to ADMIN - whether that permission is assigned directly, via","+     * an assigned PermissionRole, or inherited from an ancestor group. Otherwise that user could add their","+     * own account to such a group and escalate to full ADMIN, either immediately or by then applying an","+     * ADMIN role with the APPLY_ROLES permission they gained.","+     */","+    public static function provideCannotEditEscalatingGroup(): array","+    {","+        return [","+            'direct ADMIN permission' => ['direct', 'ADMIN'],","+            'ADMIN granted via role' => ['role', 'ADMIN'],","+            'ADMIN inherited from ancestor' => ['inherited', 'ADMIN'],","+            'ADMIN inherited from ancestor via role' => ['inherited-role', 'ADMIN'],","+            'direct APPLY_ROLES permission' => ['direct', 'APPLY_ROLES'],","+            'APPLY_ROLES granted via role' => ['role', 'APPLY_ROLES'],","+        ];","+    }","+","+    #[DataProvider('provideCannotEditEscalatingGroup')]","+    public function testCannotEditEscalatingGroup(string $adminSource, string $code): void","+    {","+        // Setting up privileged groups/roles itself requires ADMIN access, so do it as an admin","+        $this->logInWithPermission('ADMIN');","+","+        $securityAdmin = new Member();","+        $securityAdmin->write();","+        $securityAdminGroup = new Group();","+        $securityAdminGroup->Title = 'Security Admin Group';","+        $securityAdminGroup->write();","+        $securityAdminGroup->Members()->add($securityAdmin);","+        Permission::grant($securityAdminGroup->ID, 'CMS_ACCESS_SecurityAdmin');","+","+        $privilegedGroup = $this->createGroupGrantingPermission($adminSource, $code);","+","+        // Evaluate canEdit() as the SecurityAdmin-only user, not the admin used for setup","+        $this->logOut();","+","+        $this->assertFalse($privilegedGroup->canEdit($securityAdmin));","+    }","+","+    /**","+     * EDIT_PERMISSIONS is a privileged permission, but it is not a route to ADMIN - a non-admin saving","+     * PermissionCheckboxSetField has every privileged code stripped from their submission. Groups granting","+     * it must stay editable, otherwise a delegated security admin cannot administer their own group.","+     */","+    public static function provideCanEditGroupGrantingEditPermissions(): array","+    {","+        return [","+            'direct EDIT_PERMISSIONS permission' => ['direct'],","+            'EDIT_PERMISSIONS granted via role' => ['role'],","+            'EDIT_PERMISSIONS inherited from ancestor' => ['inherited'],","+        ];","+    }","+","+    #[DataProvider('provideCanEditGroupGrantingEditPermissions')]","+    public function testCanEditGroupGrantingEditPermissions(string $source): void","+    {","+        $this->logInWithPermission('ADMIN');","+","+        $securityAdmin = new Member();","+        $securityAdmin->write();","+        $securityAdminGroup = new Group();","+        $securityAdminGroup->Title = 'Security Admin Group';","+        $securityAdminGroup->write();","+        $securityAdminGroup->Members()->add($securityAdmin);","+        Permission::grant($securityAdminGroup->ID, 'CMS_ACCESS_SecurityAdmin');","+","+        $group = $this->createGroupGrantingPermission($source, 'EDIT_PERMISSIONS');","+","+        $this->logOut();","+","+        $this->assertTrue($group->canEdit($securityAdmin));","+    }","+","+    /**","+     * A non-admin user must not be able to reparent a group they may legitimately edit underneath a group","+     * that grants privileged permissions, since the child group's members - including that user - would","+     * then inherit those permissions. Effective grants count, not just permissions assigned to the parent","+     * chain directly.","+     */","+    public static function provideValidatesEffectivePrivilegeLevelOfParent(): array","+    {","+        return [","+            'ADMIN granted via role' => ['role', 'ADMIN'],","+            'ADMIN inherited from ancestor via role' => ['inherited-role', 'ADMIN'],","+            'APPLY_ROLES granted via role' => ['role', 'APPLY_ROLES'],","+            'EDIT_PERMISSIONS granted via role' => ['role', 'EDIT_PERMISSIONS'],","+        ];","+    }","+","+    #[DataProvider('provideValidatesEffectivePrivilegeLevelOfParent')]","+    public function testValidatesEffectivePrivilegeLevelOfParent(string $source, string $code): void","+    {","+        $this->logInWithPermission('ADMIN');","+        $privilegedGroup = $this->createGroupGrantingPermission($source, $code);","+        $ordinaryGroup = new Group();","+        $ordinaryGroup->Title = 'Ordinary Group';","+        $ordinaryGroup->write();","+","+        $this->logInWithPermission('CMS_ACCESS_SecurityAdmin');","+        $ordinaryGroup->ParentID = $privilegedGroup->ID;","+","+        $this->expectException(ValidationException::class);","+        $ordinaryGroup->write();","+    }","+","+    public function testCanReparentUnderNonPrivilegedGroup(): void","+    {","+        $this->logInWithPermission('CMS_ACCESS_SecurityAdmin');","+        $parentGroup = new Group();","+        $parentGroup->Title = 'Ordinary Parent Group';","+        $parentGroup->write();","+        $childGroup = new Group();","+        $childGroup->Title = 'Ordinary Child Group';","+        $childGroup->ParentID = $parentGroup->ID;","+        $childGroup->write();","+","+        $this->assertSame($parentGroup->ID, Group::get()->byID($childGroup->ID)->ParentID);","+    }","+","+    /**","+     * Build a group whose members effectively receive $code through the given source","+     */","+    private function createGroupGrantingPermission(string $source, string $code): Group","+    {","+        $group = new Group();","+        $group->Title = \"{$source} {$code} group\";","+        switch ($source) {","+            case 'direct':","+                $group->write();","+                Permission::grant($group->ID, $code);","+                break;","+            case 'role':","+                $group->write();","+                $group->Roles()->add($this->createRoleGrantingPermission($code));","+                break;","+            case 'inherited':","+                $parentGroup = new Group();","+                $parentGroup->Title = \"{$source} {$code} parent group\";","+                $parentGroup->write();","+                Permission::grant($parentGroup->ID, $code);","+                $group->ParentID = $parentGroup->ID;","+                $group->write();","+                break;","+            case 'inherited-role':","+                $parentGroup = new Group();","+                $parentGroup->Title = \"{$source} {$code} parent group\";","+                $parentGroup->write();","+                $parentGroup->Roles()->add($this->createRoleGrantingPermission($code));","+                $group->ParentID = $parentGroup->ID;","+                $group->write();","+                break;","+            default:","+                throw new InvalidArgumentException(\"Unknown permission source {$source}\");","+        }","+        return $group;","+    }","+","+    private function createRoleGrantingPermission(string $code): PermissionRole","+    {","+        $role = new PermissionRole();","+        $role->Title = \"{$code} role\";","+        $role->write();","+        $roleCode = new PermissionRoleCode();","+        $roleCode->Code = $code;","+        $roleCode->RoleID = $role->ID;","+        $roleCode->write();","+        return $role;","+    }","+","+    /**","+     * A SecurityAdmin-only user should still be able to edit ordinary, non-admin groups.","+     */","+    public function testCanEditNonAdminGroup(): void","+    {","+        $securityAdmin = new Member();","+        $securityAdmin->write();","+        $securityAdminGroup = new Group();","+        $securityAdminGroup->Title = 'Security Admin Group';","+        $securityAdminGroup->write();","+        $securityAdminGroup->Members()->add($securityAdmin);","+        Permission::grant($securityAdminGroup->ID, 'CMS_ACCESS_SecurityAdmin');","+","+        $ordinaryGroup = new Group();","+        $ordinaryGroup->Title = 'Ordinary Group';","+        $ordinaryGroup->write();","+","+        $this->assertTrue($ordinaryGroup->canEdit($securityAdmin));","+    }"," }",""],"additions":195,"deletions":0,"truncated":false}],"additions":232,"deletions":8,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-17T18:43:06.051337+00:00"}