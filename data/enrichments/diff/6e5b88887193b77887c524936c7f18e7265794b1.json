t Option options_end[],","+                int argc, char *argv[],","+                char ***ret_args) {","+","+        assert(argc >= 0);","+        assert(argv);","+        assert(ret_args);","+","+        /* The COMMAND description must reference the option namespace defined below, otherwise","+         * --help and --introspect-cli would not find the options. */","+        const CommandDescription *cmd = NULL;","+        assert_se(_verbs_find_command(verbs, verbs_end, \"common\", &cmd));","+        assert(streq_ptr(cmd->option_namespace, \"common\"));","+","+        OptionParser opts = { argc, argv, .namespace = \"common\" };","+","+        FOREACH_OPTION_OR_RETURN(c, &opts)","+                switch (c) {","+","+                OPTION_NAMESPACE(\"common\"): {}","+","+                OPTION_COMMON_HELP:","+                        return _command_print_help_full(","+                                        verbs, verbs_end,","+                                        options, options_end,","+                                        cmd->names,","+                                        /* footer_ansi_seq= */ NULL);","+","+                OPTION_COMMON_VERSION:","+                        return version();","+","+                OPTION_COMMON_INTROSPECT_CLI:","+                        return _introspect_cli(","+                                        verbs, verbs_end,","+                                        options, options_end,","+                                        SD_JSON_FORMAT_OFF);","+                }","+","+        *ret_args = option_parser_get_args(&opts);","+        return 1; /* Further action */","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"src/shared/verbs.h","lines":["@@ -202,3 +202,27 @@ int _introspect_cli(","                 __start_SYSTEMD_VERBS, __stop_SYSTEMD_VERBS,            \\","                 __start_SYSTEMD_OPTIONS, __stop_SYSTEMD_OPTIONS,        \\","                 flags)","+","+/* Parse the command line of a program which has no options of its own, i.e. which accepts only the","+ * common --help, --version, and --introspect-cli. The implementation is defined in libsystemd-shared,","+ * in the \"common\" option namespace, and the program's COMMAND() must declare","+ * .option_namespace = \"common\" so that --help and --introspect-cli finds it.","+ *","+ * The positional arguments are returned in *ret_args, typically to be passed to dispatch_verb().","+ * Returns 1 if the program shall continue, 0 if it shall exit immediately (--help, --version, or","+ * --introspect-cli has been handled), and a negative errno on error. */","+int _common_parse_argv(","+                const Verb verbs[],","+                const Verb verbs_end[],","+                const Option options[],","+                const Option options_end[],","+                int argc, char *argv[],","+                char ***ret_args);","+/* The macro inserts the calling binary's verb section, where its COMMAND is found, and its option","+ * section, which is empty (both symbols are NULL) unless the binary also implements other commands","+ * with options of their own. */","+#define common_parse_argv(argc, argv, ret_args)                         \\","+        _common_parse_argv(                                             \\","+                __start_SYSTEMD_VERBS, __stop_SYSTEMD_VERBS,            \\","+                __start_SYSTEMD_OPTIONS, __stop_SYSTEMD_OPTIONS,        \\","+                argc, argv, ret_args)"],"additions":24,"deletions":0,"truncated":false},{"path":"src/sleep/sleep.c","lines":["@@ -20,7 +20,6 @@"," #include \"battery-capacity.h\""," #include \"battery-util.h\""," #include \"blockdev-util.h\"","-#include \"build.h\""," #include \"bus-error.h\""," #include \"bus-locator.h\""," #include \"bus-unit-util.h\"","@@ -49,6 +48,7 @@ COMMAND(","         \"systemd-sleep\\0\",","         \"Suspend the system, hibernate the system, or both.\",","         .man_pages = \"systemd-suspend.service(8)\\0\",