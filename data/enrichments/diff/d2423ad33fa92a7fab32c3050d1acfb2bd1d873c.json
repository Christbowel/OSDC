mport java.util.List;","+import java.util.concurrent.TimeUnit;","+","+/**","+ * Compares charging the request breaker directly with charging it through the breaker of a query, as ES|QL drivers and","+ * {@link BigArrays} do once their reserve is used up. The request breaker is the node's, from","+ * {@link HierarchyCircuitBreakerService}. Run with {@code -t} to compare contended charges from many threads.","+ */","+@Fork(1)","+@Warmup(iterations = 3, time = 1)","+@Measurement(iterations = 5, time = 1)","+@BenchmarkMode(Mode.AverageTime)","+@OutputTimeUnit(TimeUnit.NANOSECONDS)","+@State(Scope.Benchmark)","+@SuppressWarnings(\"unused\") // invoked by benchmarking framework","+public class QueryCircuitBreakerBenchmark {","+","+    static {","+        BenchmarkLogging.configure();","+    }","+","+    /** {@code request} charges the node's request breaker, {@code query} the breaker of a query on top of it. */","+    @Param({ \"request\", \"query\" })","+    private String breaker;","+","+    private QueryScheduler.QueryPart part;","+    private CircuitBreaker target;","+","+    @Setup(Level.Trial)","+    public void setup() {","+        HierarchyCircuitBreakerService service = new HierarchyCircuitBreakerService(","+            CircuitBreakerMetrics.NOOP,","+            Settings.EMPTY,","+            List.of(),","+            new ClusterSettings(Settings.EMPTY, ClusterSettings.BUILT_IN_CLUSTER_SETTINGS)","+        );","+        CircuitBreaker request = service.getBreaker(CircuitBreaker.REQUEST);","+        QueryScheduler scheduler = new QueryScheduler(System::nanoTime, request);","+        part = scheduler.part(new TaskId(\"coordinator\", 1), 1);","+        target = breaker.equals(\"query\") ? part.breaker() : request;","+    }","+","+    @TearDown(Level.Trial)","+    public void tearDown() {","+        part.close();","+    }","+","+    /** One charge of a page and its release. */","+    @Benchmark","+    public void chargeAndRelease() {","+        target.addEstimateByte