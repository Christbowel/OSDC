{"id":"c01c4ee85f73cda43e0204b35aca709c3449312f","axis":"silent","repo":"argoproj/argo-cd","sha":"c01c4ee85f73cda43e0204b35aca709c3449312f","parsed":{"files":[{"path":"cmd/argocd-commit-server/commands/argocd_commit_server.go","lines":["@@ -24,6 +24,7 @@ import ("," \t\"github.com/argoproj/argo-cd/v3/util/env\""," \t\"github.com/argoproj/argo-cd/v3/util/errors\""," \t\"github.com/argoproj/argo-cd/v3/util/gpgsign\"","+\tutilgrpc \"github.com/argoproj/argo-cd/v3/util/grpc\""," \t\"github.com/argoproj/argo-cd/v3/util/healthz\""," \tutilio \"github.com/argoproj/argo-cd/v3/util/io\""," \t\"github.com/argoproj/argo-cd/v3/util/sourceintegrity\"","@@ -91,7 +92,7 @@ func NewCommand() *cobra.Command {"," \t\t\t\tif val, ok := r.URL.Query()[\"full\"]; ok && len(val) > 0 && val[0] == \"true\" {"," \t\t\t\t\t// connect to itself to make sure commit server is able to serve connection"," \t\t\t\t\t// used by liveness probe to auto restart commit server","-\t\t\t\t\tconn, err := apiclient.NewConnection(fmt.Sprintf(\"localhost:%d\", listenPort))","+\t\t\t\t\tconn, err := apiclient.NewConnection(utilgrpc.SelfHealthCheckTarget(listenHost, listenPort))"," \t\t\t\t\tif err != nil {"," \t\t\t\t\t\treturn err"," \t\t\t\t\t}"],"additions":2,"deletions":1,"truncated":false},{"path":"cmd/argocd-repo-server/commands/argocd_repo_server.go","lines":["@@ -32,6 +32,7 @@ import ("," \t\"github.com/argoproj/argo-cd/v3/util/cli\""," \t\"github.com/argoproj/argo-cd/v3/util/env\""," \t\"github.com/argoproj/argo-cd/v3/util/errors\"","+\tutilgrpc \"github.com/argoproj/argo-cd/v3/util/grpc\""," \t\"github.com/argoproj/argo-cd/v3/util/healthz\""," \t\"github.com/argoproj/argo-cd/v3/util/profile\""," \t\"github.com/argoproj/argo-cd/v3/util/sourceintegrity\"","@@ -190,7 +191,7 @@ func NewCommand() *cobra.Command {"," \t\t\t\t\t// connect to itself to make sure the repo server is able to serve the connection"," \t\t\t\t\t// used by liveness probe to auto-restart repo server"," \t\t\t\t\t// see https://github.com/argoproj/argo-cd/issues/5110 for more information","-\t\t\t\t\tconn, err := apiclient.NewConnection(fmt.Sprintf(\"localhost:%d\", listenPort), 60, healthCheckTLSConfig)","+\t\t\t\t\tconn, err := apiclient.NewConnection(utilgrpc.SelfHealthCheckTarget(listenHost, listenPort), 60, healthCheckTLSConfig)"," \t\t\t\t\tif err != nil {"," \t\t\t\t\t\treturn err"," \t\t\t\t\t}"],"additions":2,"deletions":1,"truncated":false},{"path":"util/grpc/self_health_check.go","lines":["@@ -0,0 +1,37 @@","+package grpc","+","+import (","+\t\"net\"","+\t\"strconv\"","+)","+","+// SelfHealthCheckTarget returns how the process should dial its own gRPC port for","+// /healthz?full=true. It uses the passthrough resolver so the endpoint bypasses","+// gRPC's dns resolver, which issues _grpclb SRV queries when grpclb is linked.","+// Unspecified listen addresses are rewritten to loopback (127.0.0.1 or ::1) so","+// the probe does not dial a wildcard.","+func SelfHealthCheckTarget(listenHost string, port int) string {","+\treturn \"passthrough:\" + net.JoinHostPort(selfHealthCheckHost(listenHost), strconv.Itoa(port))","+}","+","+// selfHealthCheckHost returns a bare host for net.JoinHostPort. Bracketed IPv6","+// literals (e.g. \"[::]\") are unwrapped. Empty or unspecified addresses","+// (0.0.0.0, ::) become the matching loopback (127.0.0.1 or ::1), since a client","+// cannot dial a wildcard. Any other host is returned unchanged.","+func selfHealthCheckHost(listenHost string) string {","+\thost := listenHost","+\tif len(host) >= 2 && host[0] == '[' && host[len(host)-1] == ']' {","+\t\thost = host[1 : len(host)-1]","+\t}","+\tif host == \"\" {","+\t\treturn \"127.0.0.1\"","+\t}","+\tip := net.ParseIP(host)","+\tif ip == nil || !ip.IsUnspecified() {","+\t\treturn host","+\t}","+\tif ip.To4() != nil {","+\t\treturn \"127.0.0.1\"","+\t}","+\treturn \"::1\"","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"util/grpc/self_health_check_test.go","lines":["@@ -0,0 +1,152 @@","+package grpc","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"net\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"google.golang.org/grpc\"","+\t_ \"google.golang.org/grpc/balancer/grpclb\"","+\t\"google.golang.org/grpc/credentials/insecure\"","+\t\"google.golang.org/grpc/health\"","+\thealthpb \"google.golang.org/grpc/health/grpc_health_v1\"","+)","+","+func startDelayingDNSServer(t *testing.T, delay time.Duration) (addr string) {","+\tt.Helper()","+\tlc := net.ListenConfig{}","+\tpc, err := lc.ListenPacket(t.Context(), \"udp\", \"127.0.0.1:0\")","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { _ = pc.Close() })","+","+\tgo func() {","+\t\tbuf := make([]byte, 512)","+\t\tfor {","+\t\t\tn, remote, err := pc.ReadFrom(buf)","+\t\t\tif err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\treq := append([]byte(nil), buf[:n]...)","+\t\t\tgo func() {","+\t\t\t\ttime.Sleep(delay)","+\t\t\t\tif len(req) < 12 {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tresp := append([]byte(nil), req...)","+\t\t\t\tresp[2] = 0x81 // response","+\t\t\t\tresp[3] = 0x82 // SERVFAIL","+\t\t\t\tresp[6], resp[7] = 0, 0","+\t\t\t\tresp[8], resp[9] = 0, 0","+\t\t\t\tresp[10], resp[11] = 0, 0","+\t\t\t\t_, _ = pc.WriteTo(resp, remote)","+\t\t\t}()","+\t\t}","+\t}()","+\treturn pc.LocalAddr().String()","+}","+","+// withSlowGRPCLBDNS points name resolution at a DNS server that answers only","+// after the given delay, simulating an environment where the `_grpclb` SRV","+// lookup stalls. The original resolver is restored on cleanup.","+//","+// WARNING: this replaces the process-wide net.DefaultResolver and therefore cannot be parallelized.","+func withSlowGRPCLBDNS(t *testing.T, delay time.Duration) {","+\tt.Helper()","+\tdnsAddr := startDelayingDNSServer(t, delay)","+\torig := net.DefaultResolver","+\tnet.DefaultResolver = &net.Resolver{","+\t\tPreferGo: true,","+\t\tDial: func(ctx context.Context, network, _ string) (net.Conn, error) {","+\t\t\tvar d net.Dialer","+\t\t\treturn d.DialContext(ctx, network, dnsAddr)","+\t\t},","+\t}","+\tt.Cleanup(func() { net.DefaultResolver = orig })","+}","+","+func startHealthServer(t *testing.T, listenAddr string) (port int, stop func()) {","+\tt.Helper()","+\tlc := net.ListenConfig{}","+\tlis, err := lc.Listen(t.Context(), \"tcp\", listenAddr)","+\tif err != nil {","+\t\tif listenAddr == \"[::1]:0\" {","+\t\t\tt.Skipf(\"IPv6 loopback not available: %v\", err)","+\t\t}","+\t\trequire.NoError(t, err)","+\t}","+","+\tsrv := grpc.NewServer()","+\ths := health.NewServer()","+\thealthpb.RegisterHealthServer(srv, hs)","+\ths.SetServingStatus(\"\", healthpb.HealthCheckResponse_SERVING)","+","+\tdone := make(chan struct{})","+\tgo func() {","+\t\tdefer close(done)","+\t\t_ = srv.Serve(lis)","+\t}()","+","+\treturn lis.Addr().(*net.TCPAddr).Port, func() {","+\t\tsrv.GracefulStop()","+\t\t<-done","+\t}","+}","+","+func healthCheckWithBudget(t *testing.T, target string, budget time.Duration) error {","+\tt.Helper()","+\tconn, err := grpc.NewClient(target, grpc.WithTransportCredentials(insecure.NewCredentials()))","+\trequire.NoError(t, err)","+\tdefer func() { _ = conn.Close() }()","+","+\tctx, cancel := context.WithTimeout(t.Context(), budget)","+\tdefer cancel()","+","+\t_, err = healthpb.NewHealthClient(conn).Check(ctx, &healthpb.HealthCheckRequest{})","+\treturn err","+}","+","+func TestSelfHealthCheckTarget_SurvivesSlowGRPCLBSRV(t *testing.T) {","+\tport, stop := startHealthServer(t, \"127.0.0.1:0\")","+\tdefer stop()","+","+\twithSlowGRPCLBDNS(t, 3*time.Second)","+","+\tconst probeBudget = 500 * time.Millisecond","+","+\tt.Run(\"legacy localhost target exceeds probe budget\", func(t *testing.T) {","+\t\terr := healthCheckWithBudget(t, fmt.Sprintf(\"localhost:%d\", port), probeBudget)","+\t\trequire.Error(t, err, \"slow _grpclb SRV must cause the health Check to fail under the probe budget\")","+\t\tassert.Contains(t, err.Error(), \"DeadlineExceeded\")","+\t})","+","+\tt.Run(\"SelfHealthCheckTarget succeeds under probe budget\", func(t *testing.T) {","+\t\terr := healthCheckWithBudget(t, SelfHealthCheckTarget(\"127.0.0.1\", port), probeBudget)","+\t\trequire.NoError(t, err)","+\t})","+}","+","+func TestSelfHealthCheckTarget_Format(t *testing.T) {","+\tassert.Equal(t, \"passthrough:127.0.0.1:8081\", SelfHealthCheckTarget(\"\", 8081))","+\tassert.Equal(t, \"passthrough:127.0.0.1:8081\", SelfHealthCheckTarget(\"0.0.0.0\", 8081))","+\tassert.Equal(t, \"passthrough:[::1]:8081\", SelfHealthCheckTarget(\"0000:0000:0000:0000:0000:0000:0000:0000\", 8081))","+\tassert.Equal(t, \"passthrough:[::1]:8081\", SelfHealthCheckTarget(\"::\", 8081))","+\tassert.Equal(t, \"passthrough:[::1]:8081\", SelfHealthCheckTarget(\"[::]\", 8081))","+\tassert.Equal(t, \"passthrough:[::1]:8081\", SelfHealthCheckTarget(\"::0\", 8081))","+\tassert.Equal(t, \"passthrough:[::1]:8081\", SelfHealthCheckTarget(\"::1\", 8081))","+\tassert.Equal(t, \"passthrough:127.0.0.1:8081\", SelfHealthCheckTarget(\"127.0.0.1\", 8081))","+\tassert.Equal(t, \"passthrough:10.0.0.5:8081\", SelfHealthCheckTarget(\"10.0.0.5\", 8081))","+\tassert.Equal(t, \"passthrough:[2001:db8::1]:8081\", SelfHealthCheckTarget(\"2001:db8::1\", 8081))","+\tassert.Equal(t, \"passthrough:repo-server.example.com:8081\", SelfHealthCheckTarget(\"repo-server.example.com\", 8081))","+}","+","+func TestSelfHealthCheckTarget_IPv6Listener(t *testing.T) {","+\tport, stop := startHealthServer(t, \"[::1]:0\")","+\tdefer stop()","+","+\terr := healthCheckWithBudget(t, SelfHealthCheckTarget(\"::\", port), time.Second)","+\trequire.NoError(t, err)","+}",""],"additions":152,"deletions":0,"truncated":false}],"additions":193,"deletions":2,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-09-29T14:22:40.632656+00:00"}