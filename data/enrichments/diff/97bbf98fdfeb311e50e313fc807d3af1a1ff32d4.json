,","-\t\t\t\thelp: 'Show MCP in the sidebar, to add and manage MCP servers. Servers already added keep working while it is hidden.',","-\t\t\t\tkey: SETTINGS_KEYS.SHOW_MCP,","-\t\t\t\tlabel: 'Show MCP',","-\t\t\t\ttype: SettingsFieldType.CHECKBOX","-\t\t\t},"," \t\t\t{"," \t\t\t\tdefaultValue: true,"," \t\t\t\thelp: 'Choose how conversation titles are generated. The first non-empty line uses a fast deterministic rule; the LLM option uses a model-generated title from the first message exchange.',","@@ -530,6 +523,13 @@ export const SETTINGS_REGISTRY: SettingsSectionEntry[] = ["," \t{"," \t\ticon: ListRestart,"," \t\tsettings: [","+\t\t\t{","+\t\t\t\tdefaultValue: false,","+\t\t\t\thelp: 'Show MCP in the sidebar, to add and manage MCP servers. Servers already added keep working while it is hidden.',","+\t\t\t\tkey: SETTINGS_KEYS.SHOW_MCP,","+\t\t\t\tlabel: 'Show MCP',","+\t\t\t\ttype: SettingsFieldType.CHECKBOX","+\t\t\t},"," \t\t\t{"," \t\t\t\tdefaultValue: DEFAULT_AGENTIC_CONFIG.maxTurns,"," \t\t\t\thelp: 'Maximum number of tool execution cycles before stopping (prevents infinite loops).',","@@ -882,6 +882,17 @@ function toSettingsSection(section: SettingsSectionEntry): SettingsSection {"," /** Sidebar sections in custom display order (the registry array order). */"," export const SETTINGS_CHAT_SECTIONS: SettingsSection[] = SETTINGS_REGISTRY.map(toSettingsSection);"," ","+/** The sections to show: without the agentic features there are no tools, no loop and no MCP to set up, which are all in Tools and Agentic. */","+export function settingsChatSections(agentic: boolean): SettingsSection[] {","+\tif (agentic) return SETTINGS_CHAT_SECTIONS;","+","+\treturn SETTINGS_CHAT_SECTIONS.filter(","+\t\t(section) =>","+\t\t\tsection.slug !== SETTINGS_SECTION_SLUGS.TOOLS &&","+\t\t\tsection.slug !== SETTINGS_SECTION_SLUGS.AGENTIC","+\t);","+}","+"," /** INPUT-type settings whose value is a number. */"," export const NUMERIC_FIELDS = getAllSettings()"," \t.filter((s) => s.type ==