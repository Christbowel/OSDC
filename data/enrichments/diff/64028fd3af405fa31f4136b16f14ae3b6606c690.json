{"id":"64028fd3af405fa31f4136b16f14ae3b6606c690","axis":"silent","repo":"mongodb/mongo","sha":"64028fd3af405fa31f4136b16f14ae3b6606c690","parsed":{"files":[{"path":"jstests/core/query/doc_validation/malformed_collection_validator.js","lines":["@@ -0,0 +1,109 @@","+/**","+ * A collection whose validator failed to parse retains it and rejects writes until collMod","+ * replaces it. Run against standalone, replica set, and sharded fixtures.","+ * @tags: [","+ *   # The setup uses a mongod failpoint to retain a validator parse error.","+ *   not_allowed_with_signed_security_token,","+ *   does_not_support_stepdowns,","+ *   # Newly added shards would not have the node-local failpoint enabled.","+ *   assumes_stable_shard_list,","+ *   requires_non_retryable_commands,","+ *   requires_fcv_91,","+ *   # Views and time series collections do not support validators.","+ *   incompatible_with_views,","+ *   exclude_from_timeseries_crud_passthrough,","+ * ]","+ */","+import {","+    assertCreateCollection,","+    assertDropCollection,","+} from \"jstests/libs/collection_drop_recreate.js\";","+import {configureFailPointForRS} from \"jstests/libs/fail_point_util.js\";","+import {FixtureHelpers} from \"jstests/libs/fixture_helpers.js\";","+import {afterEach, before, beforeEach, describe, it} from \"jstests/libs/mochalite.js\";","+import {OverrideHelpers} from \"jstests/libs/override_methods/override_helpers.js\";","+","+// Invalid because '*' is a quantifier that does not follow a repeatable item.","+const malformedValidator = {email: {$regex: \"^*\"}};","+const kValidatorParseErrorCode = 51091;","+const collName = jsTestName();","+let coll;","+const document = {email: \"x@example.com\"};","+","+describe(\"collection whose validator this node failed to parse\", function () {","+    before(function () {","+        assertDropCollection(db, collName);","+    });","+","+    beforeEach(function () {","+        // Mirroring sends commands to cluster roots; mongos cannot forward this mongod-only failpoint.","+        this.failPoint = OverrideHelpers.withPreOverrideRunCommand(() => {","+            const clusterDbs = TestData.fixtureClusterConnectionStrings","+                ? TestData.fixtureClusterConnectionStrings.map((uri) => connect(uri))","+                : [db];","+            const primaries = clusterDbs.flatMap((clusterDb) =>","+                FixtureHelpers.mapOnEachShardNode({","+                    db: clusterDb,","+                    primaryNodeOnly: true,","+                    func: (primaryDb) => primaryDb.getMongo(),","+                }),","+            );","+            // Retain the parse error so writes fail; the default bypasses validator parsing.","+            return configureFailPointForRS(primaries, \"allowSettingMalformedCollectionValidators\", {","+                parseValidator: true,","+            });","+        });","+","+        coll = assertCreateCollection(db, collName, {validator: malformedValidator});","+    });","+","+    afterEach(function () {","+        try {","+            // Migrations may recreate the malformed validator until the collection is dropped.","+            assertDropCollection(db, collName);","+        } finally {","+            OverrideHelpers.withPreOverrideRunCommand(() => this.failPoint?.off());","+        }","+    });","+","+    it(\"keeps the broken validator and fails writes to that collection\", function () {","+        assert.docEq(coll.getMetadata().options.validator, malformedValidator);","+        assert.commandFailedWithCode(coll.insert(document), kValidatorParseErrorCode);","+    });","+","+    it(\"still accepts writes to other collections\", function () {","+        const unrelated = db[jsTestName() + \"_unrelated\"];","+","+        try {","+            assert.commandWorked(unrelated.insert(document));","+        } finally {","+            assertDropCollection(db, unrelated.getName());","+        }","+    });","+","+    describe(\"after replacing the malformed validator with collMod\", function () {","+        beforeEach(function () {","+            assert.docEq(coll.getMetadata().options.validator, malformedValidator);","+            assert.commandFailedWithCode(coll.insert(document), kValidatorParseErrorCode);","+","+            const validValidator = {email: {$regex: \"^[^@]+@[^@]+$\"}};","+            assert.commandWorked(","+                db.runCommand({collMod: coll.getName(), validator: validValidator}),","+            );","+            assert.docEq(coll.getMetadata().options.validator, validValidator);","+        });","+","+        it(\"accepts valid writes\", function () {","+            assert.commandWorked(coll.insert(document));","+            assert.eq(coll.countDocuments({}), 1);","+        });","+","+        it(\"rejects invalid writes\", function () {","+            assert.commandFailedWithCode(","+                coll.insert({email: \"x\"}),","+                ErrorCodes.DocumentValidationFailure,","+            );","+            assert.eq(coll.countDocuments({}), 0);","+        });","+    });","+});"],"additions":109,"deletions":0,"truncated":false},{"path":"jstests/libs/override_methods/query/multiple_crud_ops_as_bulk_write.js","lines":["@@ -8,6 +8,9 @@ import {OverrideHelpers} from \"jstests/libs/override_methods/override_helpers.js"," let normalCluster = connect(TestData.normalCluster).getMongo();"," let bulkWriteCluster = connect(TestData.bulkWriteCluster).getMongo();"," ","+// Node-local setup must reach both clusters without going through command mirroring.","+TestData.fixtureClusterConnectionStrings = [TestData.bulkWriteCluster, TestData.normalCluster];","+"," let normalClusterRunCommand = TestData.preOverrideRunCommand;"," "," jsTestLog(\"Normal Cluster: \" + normalCluster);"],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/catalog/invalid_collection_validator_at_startup.js","lines":["@@ -5,52 +5,94 @@","  * We restart mongod during the test and expect it to have the same data 