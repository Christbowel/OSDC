{"id":"2bba75db2d5e22e2d1d03c2a57f16095e6dc62bd","axis":"silent","repo":"micronaut-projects/micronaut-core","sha":"2bba75db2d5e22e2d1d03c2a57f16095e6dc62bd","parsed":{"files":[{"path":".github/workflows/python-static-compilation.yml","lines":["@@ -0,0 +1,115 @@","+name: Python Static Compilation CI","+# Runs the Python test corpus of inject-python-test with every eligible function body compiled to Java","+# (static compilation mode `all`), so whatever the compiler compiles there is checked against tests written","+# for the interpreted bodies; plus the corpus of test-suite-python-corpus. The regular Python CI runs them","+# in the default mode only. Runs when the static compiler or the runtime it calls changes, and on demand.","+# Unlike python.yml, this file is not synced from micronaut-project-template.","+on:","+  pull_request:","+    branches:","+      - master","+      - main","+      - '[0-9]+.[0-9]+.x'","+      - 'python/**'","+      - 'python-*'","+      - 'stack/**'","+    types: [opened, synchronize, reopened, ready_for_review]","+    paths:","+      - 'inject-python/src/main/java/io/micronaut/python/processing/staticcompile/**'","+      - 'inject-python/src/main/java/io/micronaut/python/processing/PythonStubGenerator.java'","+      - 'inject-python/src/main/java/io/micronaut/python/processing/PythonAstParser.java'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_processor.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_transformer.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_static.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_lowering.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_typecheck.py'","+      - 'context-python/src/main/java/io/micronaut/context/python/PythonStatic.java'","+      - 'context-python/src/main/java/io/micronaut/context/python/aop/StaticAdvice*.java'","+      - 'test-suite-python-corpus/**'","+      - '.github/workflows/python-static-compilation.yml'","+  push:","+    branches:","+      - '[0-9]+.[0-9]+.x'","+    paths:","+      - 'inject-python/src/main/java/io/micronaut/python/processing/staticcompile/**'","+      - 'inject-python/src/main/java/io/micronaut/python/processing/PythonStubGenerator.java'","+      - 'inject-python/src/main/java/io/micronaut/python/processing/PythonAstParser.java'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_processor.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_transformer.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_static.py'","+      - 'inject-python/src/main/resources/GRAALPY-VFS/io.micronaut/micronaut-inject-python/src/micronaut_lowering.py'","+      - 'context-python/src/main/java/io/micronaut/context/python/PythonStatic.java'","+      - '.github/workflows/python-static-compilation.yml'","+  workflow_dispatch:","+# A new push to a pull request cancels its older run; pushes and manual runs get a group of their own.","+concurrency:","+  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.run_id }}","+  cancel-in-progress: true","+jobs:","+  build:","+    name: \"mode all (${{ matrix.shard }}/2)\"","+    if: github.repository == 'micronaut-projects/micronaut-core' && (github.event_name != 'pull_request' || github.event.pull_request.draft == false)","+    runs-on: ubuntu-latest","+    timeout-minutes: 90","+    strategy:","+      fail-fast: false","+      matrix:","+        # the shards of python.yml (python-ci-shards in gradle.properties)","+        shard: [1, 2]","+    env:","+      TESTCONTAINERS_RYUK_DISABLED: true","+      # like the pull request builds of gradle.yml, only read the remote build cache","+      ORG_GRADLE_PROJECT_cachePush: false","+    steps:","+      # https://github.com/actions/virtual-environments/issues/709","+      - name: Remove system JDKs","+        run: |","+          sudo rm -rf /usr/lib/jvm/*","+          unset JAVA_HOME","+          export PATH=$(echo \"$PATH\" | tr ':' '\\n' | grep -v '/usr/lib/jvm' | paste -sd:)","+      - name: \"🗑 Free disk space\"","+        run: |","+          sudo rm -rf \"/usr/local/share/boost\"","+          sudo rm -rf \"$AGENT_TOOLSDIRECTORY\"","+          sudo rm -rf \"/opt/ghc\"","+          sudo rm -rf \"/usr/share/dotnet\"","+          sudo rm -rf \"/usr/local/lib/android\"","+          sudo apt-get clean","+          df -h","+      - name: \"📥 Checkout repository\"","+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7","+        with:","+          fetch-depth: 0","+      - name: \"🔧 Setup GraalVM CE\"","+        uses: graalvm/setup-graalvm@0426e2e191540e8514dff98dc52a5f5146a2a276 # v1","+        with:","+          distribution: 'graalvm'","+          java-version: '25'","+          version: '25.4'","+          github-token: ${{ secrets.GITHUB_TOKEN }}","+      - name: \"🔧 Setup Gradle\"","+        uses: gradle/actions/setup-gradle@9c971963bec38e04b3d30dcc455b5382be2fdbfb # v6","+        with:","+          develocity-access-key: >-","+            ${{ (github.event_name == 'push' && secrets.GRADLE_ENTERPRISE_ACCESS_KEY) ||","+                (github.event_name != 'push' && (secrets.DEVELOCITY_PULL_REQUEST_ACCESS_KEY || secrets.GRADLE_ENTERPRISE_ACCESS_KEY)) ||","+                '' }}","+      - name: \"🐍 Run the Python tests with static compilation mode all\"","+        env:","+          GH_TOKEN_PUBLIC_REPOS_READONLY: ${{ secrets.GH_TOKEN_PUBLIC_REPOS_READONLY }}","+          GH_USERNAME: ${{ secrets.GH_USERNAME }}","+        # inject-python-test forwards the system property to its test JVMs (see its build script)","+        run: |","+          ./gradlew :micronaut-inject-python-test:test \\","+            -Ppython-ci -Ppython-ci-shard=${{ matrix.shard }}/2 -Dmicronaut.python.compile.static=all \\","+            --no-daemon --continue","+      - name: \"🐍 Check the decisions of the corpus applications\"","+        if: matrix.shard == 1","+        run: ./gradlew :test-suite-python-corpus:test -Ppython-ci --no-daemon","+      - name: \"📊 Publish Test Report\"","+        if: always()","+        uses: mikepenz/action-junit-report@a9170d5795813c01ab4901ffb045b52bab4ab09d # v6","+        with:","+          check_name: \"Python Static Compilation CI / Test Report (${{ matrix.shard }}/2)\"","+          report_paths: '**/build/test-results/test/TEST-*.xml'","+          check_retries: 'true'"],"additions":115,"deletions":0,"truncated":false},{"path":"build.gradle","lines":["@@ -59,10 +59,15 @@ def pythonTestProjects = [","         \":micronaut-inject-python-test\",","         \":micronaut-context-python\",","         \":micronaut-context-python-netty\",","-        \":test-suite-dev-python\"","+        \":test-suite-dev-python\",","+        \":test-suite-python-corpus\"","+]","+// Projects whose tests all run in the first Python CI job instead of being split across the jobs: the","+// corpus is one test class","+def pythonUnshardedProjects = [","+        \":test-suite-dev-python\",","+        \":test-suite-python-corpus\""," ]","-// Projects whose tests all run in the first Python CI job instead of being split across the jobs","-def pythonUnshardedProjects = [\":test-suite-dev-python\"]"," def pythonProjects = pythonTestProjects + [\":test-suite-python\"]"," "," if (System.getenv(\"SONAR_TOKEN\") != null) {"],"additions":8,"deletions":3,"truncated":false},{"path":"gradle/libs.versions.toml","lines":["@@ -50,6 +50,7 @@ micronaut-validation = \"5.1.0\""," micronaut-rxjava3 = \"4.1.0\""," micronaut-reactor = \"4.1.0\""," micronaut-data = \"5.0.5\"","+micronaut-platform = \"5.1.0\""," micronaut-serde = \"3.1.0\""," micronaut-kotlin = \"5.1.0\""," native-gradle-plugin = \"0.11.5\"","@@ -116,6 +117,7 @@ test-boms-micronaut-reactor = { module = \"io.micronaut.reactor:micronaut-reactor"," test-boms-micronaut-kotlin = { module = \"io.micronaut.kotlin:micronaut-kotlin-bom\", version.ref = \"micronaut-kotlin\" }"," test-boms-micronaut-data = { module = \"io.micronaut.data:micronaut-data-bom\", version.ref = \"micronaut-data\" }"," test-boms-micronaut-serde = { module = \"io.micronaut.serde:micronaut-serde-bom\", version.ref = \"micronaut-serde\" }","+test-boms-micronaut-platform = { module = \"io.micronaut.platform:micronaut-platform\", version.ref = \"micronaut-platform\" }"," "," boms-groovy = { module = \"org.apache.groovy:groovy-bom\", version.ref = \"managed-groovy\" }"," boms-kotlin = { module = \"org.jetbrains.kotlin:kotlin-bom\", version.ref = \"managed-kotlin\" }"],"additions":2,"deletions":0,"truncated":false},{"path":"settings.gradle","lines":["@@ -91,6 +91,7 @@ include \"test-suite-kotlin-ksp-all-open\""," include \"test-suite-kotlinx-reactor\""," include \"test-suite-groovy\""," include \"test-suite-python\"","+include \"test-suite-python-corpus\""," include \"test-suite-dev-python\""," include \"test-suite-logback\""," include \"test-suite-logback-external-configuration\""],"additions":1,"deletions":0,"truncated":false},{"path":"test-suite-python-corpus/build.gradle.kts","lines":["@@ -0,0 +1,113 @@","+// The corpus of real Pyronaut applications, compiled with the type checker and the static compiler","+// of this build: see src/corpus/README.md. The io.micronaut:* coordinates the applications depend","+// on are substituted with the projects of this build by the base convention plugin; the rest is","+// resolved through the Micronaut platform BOM. Runs with the other Python tests:","+//   ./gradlew :test-suite-python-corpus:test -Ppython-ci","+plugins {","+    id(\"io.micronaut.build.internal.convention-test-library\")","+}","+","+fun corpusClasspath(name: String) = configurations.create(name) {","+    isCanBeConsumed = false","+    isCanBeResolved = true","+    attributes {","+        attribute(Usage.USAGE_ATTRIBUTE, objects.named(Usage.JAVA_RUNTIME))","+        attribute(Category.CATEGORY_ATTRIBUTE, objects.named(Category.LIBRARY))","+        attribute(LibraryElements.LIBRARY_ELEMENTS_ATTRIBUTE, objects.named(LibraryElements.JAR))","+    }","+    // the applications pin GraalJS for their views; a compilation loads neither GraalJS nor a second GraalPy","+    exclude(group = \"org.graalvm.js\")","+    exclude(group = \"org.graalvm.truffle\")","+    exclude(group = \"org.graalvm.polyglot\")","+}","+","+val fullstackClasspath = corpusClasspath(\"fullstackClasspath\")","+val fullstackProcessorPath = corpusClasspath(\"fullstackProcessorPath\")","+val petclinicClasspath = corpusClasspath(\"petclinicClasspath\")","+val petclinicProcessorPath = corpusClasspath(\"petclinicProcessorPath\")","+","+// the dependency lists of the applications' pyproject.toml files, minus the artifacts a compilation does not","+// load: the JDBC drivers and pools, Flyway and the control panel, which no source imports, only run the applications","+val fullstackDependencies = listOf(","+    \"io.micronaut:micronaut-http-server-netty\",","+    \"io.micronaut.data:micronaut-data-jdbc\",","+    \"io.micronaut.serde:micronaut-serde-jackson\",","+    \"io.micronaut.validation:micronaut-validation\",","+    \"io.micronaut.security:micronaut-security-jwt\",","+    \"org.springframework.security:spring-security-crypto:7.1.1\",","+    \"org.springframework:spring-core:7.0.9\",","+    \"io.micronaut.email:micronaut-email-javamail\",","+    \"io.micronaut.email:micronaut-email-template\",","+    \"org.eclipse.angus:angus-mail\",","+    \"io.micronaut.views:micronaut-views-react:6.2.0\",","+    \"io.micronaut:micronaut-context-python\",","+)","+val fullstackProcessors = listOf(","+    \"io.micronaut:micronaut-context-python\",","+    \"io.micronaut:micronaut-inject-python\",","+    \"io.micronaut.data:micronaut-data-processor\",","+    \"io.micronaut.serde:micronaut-serde-processor\",","+    \"io.micronaut.validation:micronaut-validation-processor\",","+    \"io.micronaut.security:micronaut-security-annotations\",","+)","+val petclinicDependencies = listOf(","+    \"io.micronaut:micronaut-http-server-netty\",","+    \"io.micronaut.cache:micronaut-cache-core\",","+    \"io.micronaut.data:micronaut-data-jdbc\",","+    \"io.micronaut.serde:micronaut-serde-jackson\",","+    \"com.fasterxml.jackson.core:jackson-databind:2.22.1\",","+    \"io.micronaut.validation:micronaut-validation\",","+    \"io.micronaut.views:micronaut-views-jinjava\",","+    \"io.micronaut:micronaut-context-python\",","+)","+val petclinicProcessors = listOf(","+    \"io.micronaut:micronaut-context-python\",","+    \"io.micronaut:micronaut-inject-python\",","+    \"io.micronaut.data:micronaut-data-processor\",","+    \"io.micronaut.serde:micronaut-serde-processor\",","+    \"io.micronaut.validation:micronaut-validation-processor\",","+)","+","+dependencies {","+    testImplementation(projects.micronautInjectPython)","+    testImplementation(projects.micronautContextPython)","+    testImplementation(libs.junit.jupiter)","+    testImplementation(libs.junit.jupiter.params)","+","+    for ((configuration, artifacts) in listOf(","+        fullstackClasspath to fullstackDependencies,","+        fullstackProcessorPath to fullstackProcessors,","+        petclinicClasspath to petclinicDependencies,","+        petclinicProcessorPath to petclinicProcessors,","+    )) {","+        configuration(platform(libs.test.boms.micronaut.platform))","+        artifacts.forEach { configuration(it) }","+    }","+}","+","+tasks.named<Test>(\"test\") {","+    useJUnitPlatform()","+    maxHeapSize = \"4g\"","+    inputs.files(fullstackClasspath, fullstackProcessorPath, petclinicClasspath, petclinicProcessorPath)","+        .withPropertyName(\"corpusClasspaths\").withNormalizer(ClasspathNormalizer::class.java)","+    inputs.dir(\"src/corpus\").withPropertyName(\"corpus\").withPathSensitivity(PathSensitivity.RELATIVE)","+    // the test cleans and writes build/corpus/<name>: the classes, the report and the decisions of each compilation","+    outputs.dir(layout.buildDirectory.dir(\"corpus\")).withPropertyName(\"corpusOutput\")","+    // a checkout of an application instead of its pinned copy: -Dcorpus.<name>.dir=<path to src>, its","+    // path (a system property of the test) and its sources inputs of the task as the copy is","+    listOf(\"fullstack\", \"petclinic\").forEach { corpus ->","+        val override = providers.systemProperty(\"corpus.$corpus.dir\")","+        if (override.isPresent) {","+            systemProperty(\"corpus.$corpus.dir\", override.get())","+        }","+        inputs.files(override.map { files(it) }.orElse(files()))","+            .withPropertyName(\"corpus.$corpus.dir\").withPathSensitivity(PathSensitivity.RELATIVE)","+    }","+    // the class paths of the applications, given to the compiler by the test","+    doFirst {","+        systemProperty(\"corpus.fullstack.classpath\", fullstackClasspath.asPath)","+        systemProperty(\"corpus.fullstack.processorPath\", fullstackProcessorPath.asPath)","+        systemProperty(\"corpus.petclinic.classpath\", petclinicClasspath.asPath)","+        systemProperty(\"corpus.petclinic.processorPath\", petclinicProcessorPath.asPath)","+    }","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"test-suite-python-corpus/src/corpus/README.md","lines":["@@ -0,0 +1,28 @@","+# The corpus","+","+Pinned copies of the Python sources of two real Pyronaut applications, compiled by","+`StaticCompilationCorpusTest` with the type checker at `error` and static compilation in mode","+`all`. The test asserts that both build, that the checker reports nothing, and that every","+decision of the static compiler (each function with its outcome) is the one recorded in","+`<name>.decisions.txt`: a regression in the compile rate of either project fails the build, and","+so does a change that loses some compiled bodies while gaining others.","+","+| Corpus | Origin | Commit | License |","+|---|---|---|---|","+| `fullstack` | https://github.com/micronaut-projects/pyronaut-full-stack-template (`src`) | `8850c126e7118c732a2ece758aba7690a29a68e3` | Apache License 2.0, as declared in the project's README at that commit (the repository has no LICENSE file) |","+| `petclinic` | https://github.com/micronaut-projects/pyronaut-petclinic (`src`) | `9cdff239414604f89bcaf68222f2e9536891a756` | None declared at that commit: the repository has no LICENSE file and its README and `pyproject.toml` state no license |","+","+Both projects belong to the `micronaut-projects` organization, as this repository does. The","+copies are the projects' code as written, not adapted to the compiler: what they leave in Python","+(unhinted helper parameters, `**kwargs`, lambdas, standard library code) is the record of what the","+compiler does not take yet.","+","+When the compiler changes what it compiles, the test fails with the decisions no longer made and","+those newly made; when the change is intended, copy `build/corpus/<name>/decisions.txt` over","+`<name>.decisions.txt`. Each run cleans `build/corpus/<name>` first, then writes the classes, the","+static compilation report and the decisions of the compilation there.","+","+To compile a checkout of a project instead of its copy, run the test with","+`-Dcorpus.fullstack.dir=<path to src>` or `-Dcorpus.petclinic.dir=<path to src>`: the path and","+the sources it holds are inputs of the task, and the decisions are written to","+`build/corpus/<name>/decisions.txt` without being compared."],"additions":28,"deletions":0,"truncated":false},{"path":"test-suite-python-corpus/src/corpus/fullstack.decisions.txt","lines":["@@ -0,0 +1,119 @@","+? ApiError.__init__ NOT_CANDIDATE","+? Item.__init__ NOT_CANDIDATE","+? ItemCreate.__init__ NOT_CANDIDATE","+? ItemPublic.__init__ NOT_CANDIDATE","+? ItemUpdate.__init__ NOT_CANDIDATE","+? ItemsPublic.__init__ NOT_CANDIDATE","+? Message.__init__ NOT_CANDIDATE","+? NewPassword.__init__ NOT_CANDIDATE","+? UpdatePassword.__init__ NOT_CANDIDATE","+? User.__init__ NOT_CANDIDATE","+? UserCreate.__init__ NOT_CANDIDATE","+? UserPublic.__init__ NOT_CANDIDATE","+? UserRegister.__init__ NOT_CANDIDATE","+? UserUpdate.__init__ NOT_CANDIDATE","+? UserUpdateMe.__init__ NOT_CANDIDATE","+? UsersPublic.__init__ NOT_CANDIDATE","+app/bootstrap.py FirstSuperuserBootstrap.__init__ NOT_CANDIDATE","+app/bootstrap.py FirstSuperuserBootstrap.onApplicationEvent SKIPPED","+app/config.py AppConfigGuard.__init__ NOT_CANDIDATE","+app/config.py AppConfigGuard.check SKIPPED","+app/controllers/errors.py ValidationExceptionHandler.handle SKIPPED","+app/controllers/errors.py _field_of SKIPPED","+app/controllers/items.py ItemController.__init__ NOT_CANDIDATE","+app/controllers/items.py ItemController._current COMPILED","+app/controllers/items.py ItemController.create_item SKIPPED","+app/controllers/items.py ItemController.delete_item COMPILED","+app/controllers/items.py ItemController.list_items SKIPPED","+app/controllers/items.py ItemController.read_item SKIPPED","+app/controllers/items.py ItemController.update_item SKIPPED","+app/controllers/login.py LoginController.__init__ NOT_CANDIDATE","+app/controllers/login.py LoginController.recover_password COMPILED","+app/controllers/login.py LoginController.reset_password COMPILED","+app/controllers/login.py LoginController.test_token SKIPPED","+app/controllers/private.py PrivateController.__init__ NOT_CANDIDATE","+app/controllers/private.py PrivateController.create_user_directly SKIPPED","+app/controllers/users.py UserController.__init__ NOT_CANDIDATE","+app/controllers/users.py UserController._current COMPILED","+app/controllers/users.py UserController.create_user SKIPPED","+app/cont