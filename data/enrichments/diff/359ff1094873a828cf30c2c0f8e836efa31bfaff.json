{"id":"359ff1094873a828cf30c2c0f8e836efa31bfaff","axis":"silent","repo":"pnpm/pnpm","sha":"359ff1094873a828cf30c2c0f8e836efa31bfaff","parsed":{"files":[{"path":".changeset/required-scripts-recursive-run.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm -r run <script>` now honors the `requiredScripts` setting from `pnpm-workspace.yaml`. If the script is listed there and a selected project does not define it, the run fails with `ERR_PNPM_RECURSIVE_RUN_NO_SCRIPT` and names the projects that lack it."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/run/recursive.rs","lines":["@@ -52,9 +52,9 @@ use pnpm_workspace_task_scheduler::{"," use script_budget::{ScriptBudget, ScriptPermit, run_script_budget};"," use selection::{","     HiddenScriptCheck, RunReporting, a_project_has_the_script, build_run_task_graph,","-    check_a_project_has_the_script, filter_hidden_requested_scripts, print_run_dry_run,","-    print_selected_project_commands, report_run_outcome, resume_task_graph, run_concurrency,","-    run_process_tracker, run_state_settings, run_tasks,","+    check_a_project_has_the_script, check_required_script, filter_hidden_requested_scripts,","+    print_run_dry_run, print_selected_project_commands, report_run_outcome, resume_task_graph,","+    run_concurrency, run_process_tracker, run_state_settings, run_tasks,"," };"," use std::{","     collections::{HashMap, HashSet},","@@ -87,6 +87,15 @@ pub enum RecursiveRunError {","         script_name: String,","     },"," ","+    #[display(\"Missing script \\\"{script_name}\\\" in packages: {packages}\")]","+    #[diagnostic(code(ERR_PNPM_RECURSIVE_RUN_NO_SCRIPT))]","+    MissingRequiredScript {","+        #[error(not(source))]","+        script_name: String,","+        /// The comma-separated names of the projects that lack it.","+        packages: String,","+    },","+","     #[display(\"\\\"pnpm recursive run\\\" failed in {count} packages\")]","     #[diagnostic(code(ERR_PNPM_RECURSIVE_FAIL))]","     RecursiveFail {","@@ -349,6 +358,13 @@ impl RecursiveRun<'_, '_> {","         task_graph: &mut TaskGraph,","         full_task_graph: &TaskGraph,","     ) -> miette::Result<()> {","+        check_required_script(","+            task_graph,","+            self.graph,","+            self.script.script_name,","+            &self.config.required_scripts,","+        )?;","+","         // Hidden scripts (names starting with `.`) can only be invoked from","         // within another script, detected by an inherited","         // `npm_lifecycle_event`. Checked only for the tasks the invocation"],"additions":19,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/run/recursive/selection.rs","lines":["@@ -7,6 +7,7 @@ use super::{","     render_task_graph_dry_run, resume_task_graph_from, reverse_task_graph, task_graph_to_json,","     task_run_execution_settings, throw_or_filter_hidden_scripts, write_recursive_summary,"," };","+use pnpm_workspace_projects_graph::BaseProject;"," "," /// Whether a task name addresses scripts by `RegExp` literal rather than by"," /// name.","@@ -31,6 +32,40 @@ pub(super) fn check_a_project_has_the_script(","     Err(no_requested_script_error(script_name, all_packages_selected).into())"," }"," ","+/// A script listed in `requiredScripts` must exist in every requested","+/// project.","+pub(super) fn check_required_script(","+    task_graph: &TaskGraph,","+    graph: &ProjectGraph<GraphPkg<'_>>,","+    script_name: &str,","+    required_scripts: &[String],","+) -> Result<(), RecursiveRunError> {","+    if !required_scripts","+        .iter()","+        .any(|required| required == script_name)","+    {","+        return Ok(());","+    }","+    let missing: Vec<String> = task_graph","+        .values()","+        .filter(|node| node.requested && node.scripts.is_empty())","+        .map(|node| project_display_name(graph, &node.project))","+        .collect();","+    if missing.is_empty() {","+        return Ok(());","+    }","+    Err(RecursiveRunError::MissingRequiredScript {","+        script_name: script_name.to_string(),","+        packages: missing.join(\", \"),","+    })","+}","+","+fn project_display_name(graph: &ProjectGraph<GraphPkg<'_>>, project: &Path) -> String {","+    graph[project].package","+        .manifest_name()","+        .map_or_else(|| project.display().to_string(), str::to_string)","+}","+"," pub(super) fn a_project_has_the_script(task_graph: &TaskGraph) -> bool {","     task_graph","         .values()"],"additions":35,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/run_recursive.rs","lines":["@@ -1070,3 +1070,5 @@ mod concurrency;"," mod output;"," "," mod environment;","+","+mod required_scripts;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/run_recursive/required_scripts.rs","lines":["@@ -0,0 +1,127 @@","+use super::{CommandExtra, CommandTempCwd, Path, build_writes_marker, fs, json, write_workspace};","+use assert_cmd::assert::OutputAssertExt as _;","+use pnpm_testing_utils::diagnostics::assert_diagnostic_contains;","+","+/// A script listed in `requiredScripts` must exist in every selected","+/// project. The run fails before any script starts and names each project","+/// that lacks it.","+#[test]","+fn recursive_run_fails_when_a_project_lacks_a_required_script() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(","+        &workspace,","+        &[","+            (\"project-1\", json!({ \"name\": \"project-1\", \"version\": \"1.0.0\" })),","+            (\"project-2\", build_writes_marker(\"project-2\")),","+            (\"project-3\", json!({ \"name\": \"project-3\", \"version\": \"1.0.0\" })),","+        ],","+    );","+    require_scripts(&workspace, \"build\");","+","+    let output = pacquet","+        .with_args([\"-r\", \"run\", \"build\"])","+        .output()","+        .expect(\"spawn pacquet\");","+","+    assert!(!output.status.success(), \"a project without the required script must fail the run\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert_diagnostic_contains(&stderr, \"ERR_PNPM_RECURSIVE_RUN_NO_SCRIPT\");","+    assert_diagnostic_contains(","+        &stderr,","+        r#\"Missing script \"build\" in packages: project-1, project-3\"#,","+    );","+    assert!(","+        !workspace.join(\"project-2/ran.txt\").exists(),","+        \"no script may run once a required script is missing\",","+    );","+","+    drop(root);","+}","+","+/// `requiredScripts` constrains only the scripts it lists.","+#[test]","+fn recursive_run_ignores_projects_without_an_unlisted_script() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(","+        &workspace,","+        &[","+            (\"project-1\", json!({ \"name\": \"project-1\", \"version\": \"1.0.0\" })),","+            (\"project-2\", build_writes_marker(\"project-2\")),","+        ],","+    );","+    require_scripts(&workspace, \"lint\");","+","+    pacquet","+        .with_args([\"-r\", \"run\", \"build\"])","+        .assert()","+        .success();","+    assert!(workspace.join(\"project-2/ran.txt\").exists(), \"project-2 should run build\");","+","+    drop(root);","+}","+","+/// A project without a `name` is listed by its directory.","+#[test]","+fn recursive_run_lists_a_nameless_project_by_its_directory() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(","+        &workspace,","+        &[","+            (\"project-1\", json!({ \"name\": \"project-1\", \"version\": \"1.0.0\" })),","+            (\"nameless\", json!({ \"version\": \"1.0.0\" })),","+        ],","+    );","+    require_scripts(&workspace, \"build\");","+","+    let output = pacquet","+        .with_args([\"-r\", \"run\", \"build\"])","+        .output()","+        .expect(\"spawn pacquet\");","+","+    assert!(!output.status.success(), \"a project without the required script must fail the run\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    let unwrapped: String = stderr","+        .chars()","+        .filter(|char| !char.is_whitespace() && *char != '│')","+        .collect();","+    // The message spells the temp dir as the OS prints it (on Windows a","+    // long or verbatim form of the same path), so match its last components.","+    let nameless_suffix = Path::new(\"workspace\")","+        .join(\"nameless\")","+        .display()","+        .to_string();","+    let listed = unwrapped.contains(&nameless_suffix);","+    assert!(listed, \"the nameless project should be listed by its directory, got: {stderr}\");","+    assert!(unwrapped.contains(\"project-1\"), \"project-1 should be listed too, got: {stderr}\");","+","+    drop(root);","+}","+","+/// Only the projects selected for the run must have the script.","+#[test]","+fn filtered_recursive_run_checks_only_the_selected_projects() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(","+        &workspace,","+        &[","+            (\"project-1\", json!({ \"name\": \"project-1\", \"version\": \"1.0.0\" })),","+            (\"project-2\", build_writes_marker(\"project-2\")),","+        ],","+    );","+    require_scripts(&workspace, \"build\");","+","+    pacquet","+        .with_args([\"-r\", \"--filter\", \"project-2\", \"run\", \"build\"])","+        .assert()","+        .success();","+    assert!(workspace.join(\"project-2/ran.txt\").exists(), \"project-2 should run build\");","+","+    drop(root);","+}","+","+fn require_scripts(workspace: &Path, script: &str) {","+    let workspace_yaml = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&workspace_yaml).expect(\"read pnpm-workspace.yaml\");","+    fs::write(&workspace_yaml, format!(\"{yaml}requiredScripts:\\n  - {script}\\n\"))","+        .expect(\"write pnpm-workspace.yaml\");","+}"],"additions":127,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -1404,6 +1404,11 @@ pub struct Config {","     /// re-synced from its source.","     pub sync_injected_deps_after_scripts: Vec<String>,"," ","+    /// `requiredScripts` from `pnpm-workspace.yaml`. A recursive run of a","+    /// script named here fails with `ERR_PNPM_RECURSIVE_RUN_NO_SCRIPT`","+    /// when a selected project lacks it.","+    pub required_scripts: Vec<String>,","+","     /// `changedFilesIgnorePattern` from `pnpm-workspace.yaml` /","     /// `PNPM_CONFIG_CHANGED_FILES_IGNORE_PATTERN`, overridable by the","     /// `--changed-files-ignore-pattern` CLI flag. Glob patterns of"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml.rs","lines":["@@ -260,7 +260,7 @@ macro_rules! identically_named_settings {","             virtual_store_only, enable_modules_dir,","             git_shallow_hosts,","             test_pattern, changed_files_ignore_pattern, legacy_dir_filtering,","-            sync_injected_deps_after_scripts,","+            sync_injected_deps_after_scripts, required_scripts,","             resolution_mode, catalog_mode, catalog_prune,","             minimum_release_age_exclude_prune, save_peer, save_exact, save_types,","             registry_supports_time_field,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/settings.rs","lines":["@@ -639,6 +639,10 @@ pub struct WorkspaceSettings {","     /// [`Config::sync_injected_deps_after_scripts`](crate::settings::Config::sync_injected_deps_after_scripts).","     pub sync_injected_deps_after_scripts: Option<Vec<String>>,"," ","+    /// `requiredScripts` from `pnpm-workspace.yaml` — see","+    /// [`Config::required_scripts`](crate::settings::Config::required_scripts).","+    pub required_scripts: Option<Vec<String>>,","+","     /// `supportedArchitectures` from `pnpm-workspace.yaml`. Drives the","     /// optional-dependency platform check at install time: a","     /// `name: ['darwin'], cpu: ['arm64']` setting tells pacquet to"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/files.rs","lines":["@@ -93,6 +93,22 @@ changedFilesIgnorePattern:","     assert_eq!(config.changed_files_ignore_pattern, [\".github/**\", \"**/README.md\"]);"," }"," ","+/// `requiredScripts` comes from `pnpm-workspace.yaml` only: the global","+/// `config.yaml` cannot set it.","+#[test]","+fn required_scripts_applies_from_workspace_yaml_and_not_from_global_config() {","+    let yaml = \"requiredScripts:\\n  - build\\n\";","+    let settings: WorkspaceSettings = serde_saphyr::from_str(yaml).unwrap();","+    let mut config = Config::new();","+    assert!(config.required_scripts.is_empty());","+    settings.apply_to(&mut config, Path::new(\"/irrelevant\"));","+    assert_eq!(config.required_scripts, [\"build\"]);","+","+    let mut global: WorkspaceSettings = serde_saphyr::from_str(yaml).unwrap();","+    global.clear_workspace_only_fields();","+    assert!(global.required_scripts.is_none());","+}","+"," #[test]"," fn find_walks_up_to_parent_dir() {","     let tmp = tempfile::tempdir().unwrap();"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/workspace_scope.rs","lines":["@@ -68,6 +68,7 @@ impl WorkspaceSettings {","         // same holds for the pipelines built from them.","         self.tasks = None;","         self.pipelines = None;","+        self.required_scripts = None;","         self.pipeline_base = None;","         // A pnpmfile belongs to the project that ships it, and pnpm reads","         // `ignorePnpmfile` from `pnpm-workspace.yaml` and the environment but"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_package_from_registry/tests.rs","lines":["@@ -222,6 +222,7 @@ fn create_config(","    