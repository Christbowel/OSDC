           result = self.forward_body(&sender) => result,","             };","             drop(self);","             let _ = completion_sender.send(result);","@@ -370,6 +361,36 @@ impl ThrottledResponse {","     }"," }"," ","+impl ThrottledResponse {","+    /// Send each chunk of the body to `sender`. Fails when the next chunk","+    /// takes longer than the idle timeout to arrive, or the reader takes","+    /// longer than it to accept one, so a stalled reader releases the","+    /// permits too.","+    async fn forward_body(","+        &mut self,","+        sender: &tokio::sync::mpsc::Sender<bytes::Bytes>,","+    ) -> std::io::Result<()> {","+        let stalled = |what: &str| {","+            std::io::Error::new(","+                std::io::ErrorKind::TimedOut,","+                format!(\"{what} stalled past the timeout\"),","+            )","+        };","+        loop {","+            let chunk = tokio::time::timeout(self.idle_timeout, self.response.chunk())","+                .await","+                .map_err(|_| stalled(\"the upstream response body\"))?","+                .map_err(std::io::Error::other)?;","+            let Some(chunk) = chunk else { return Ok(()) };","+            match tokio::time::timeout(self.idle_timeout, sender.send(chunk)).await {","+                Ok(Ok(())) => {}","+                Ok(Err(_)) => return Ok(()),","+                Err(_) => return Err(stalled(\"the reader of the response body\")),","+            }","+        }","+    }","+}","+"," impl Deref for ThrottledResponse {","     type Target = reqwest::Response;"," ","@@ -383,8 +404,7 @@ impl std::fmt::Debug for ThrottledResponse {","         formatter","             .debug_struct(\"ThrottledResponse\")","             .field(\"response\", &self.response)","-            .field(\"body_timeout\", &self.body_timeout)","-            .field(\"received_at\", &self.received_at)","+            .field(\"idle_timeout\", &self.idle_timeout)","             .finish_non_exhaustive()"," 