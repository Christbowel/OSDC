{"id":"af8349235d04c39d8705acd938e9ff0b581dfbca","axis":"silent","repo":"pnpm/pnpm","sha":"af8349235d04c39d8705acd938e9ff0b581dfbca","parsed":{"files":[{"path":".changeset/pnpr-upstream-idle-timeout.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+A tarball that pnpr downloads from an upstream registry is no longer cut off after the upstream `timeout` while it is still arriving. The `timeout` now limits how long pnpr waits for the upstream to answer and for each further part of the download. Before, a tarball that took longer than 30 seconds to download from a slow upstream failed every time."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -6833,9 +6833,11 @@ version = \"0.0.0\""," dependencies = [","  \"assert_cmd\",","  \"axum 0.8.9\",","+ \"bytes\",","  \"command-extra\",","  \"dunce\",","  \"flate2\",","+ \"futures-util\",","  \"pipe-trait\",","  \"pnpm-fs\",","  \"pnpm-workspace-state\","],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/network/src/lib.rs","lines":["@@ -22,6 +22,7 @@ pub use limited_body::{"," };"," pub use proxy::{NoProxySetting, ProxyConfig, ProxyError};"," pub use redirect_guard::{RedirectGuard, origins_redirect_guard};","+pub use requests::HeadError;"," pub use retry::{","     RetryOpts, retry_async, send_with_retry, send_with_retry_at_priority, should_retry_status,"," };","@@ -288,8 +289,8 @@ pub struct ThrottledResponse {","     _permit: Permit,","     _host_permit: Option<Permit>,","     _origin_permit: Option<OriginPermit>,","-    body_timeout: Duration,","-    received_at: Instant,","+    /// How long [`Self::bytes_stream`] waits for each chunk of the body.","+    idle_timeout: Duration,"," }"," "," impl ThrottledClientGuard<'_> {","@@ -302,19 +303,20 @@ impl ThrottledClientGuard<'_> {","     }"," ","     /// Transfer both concurrency permits to the response body owner.","+    /// `idle_timeout` bounds each wait for more of the body, not the whole","+    