Client {","         url: &str,","         configure: impl Fn(reqwest::RequestBuilder, &str) -> reqwest::RequestBuilder,","     ) -> Result<(reqwest::Response, ThrottledClientGuard<'_>), reqwest::Error> {","-        self.response_with_scoped_headers(reqwest::Method::HEAD, url, configure).await","+        self.response_with_scoped_headers(reqwest::Method::HEAD, url, None, configure)","+            .await","+            .map_err(HeadError::into_request_error)","     }"," ","     async fn response_with_scoped_headers(","         &self,","         method: reqwest::Method,","         url: &str,","+        head_timeout: Option<Duration>,","         configure: impl Fn(reqwest::RequestBuilder, &str) -> reqwest::RequestBuilder,","-    ) -> Result<(reqwest::Response, ThrottledClientGuard<'_>), reqwest::Error> {","+    ) -> Result<(reqwest::Response, ThrottledClientGuard<'_>), HeadError> {","         let mut current_url = url.to_string();","+        let mut head_budget = head_timeout;","         for redirect_count in 0..=MAX_REDIRECT_HOPS {","             let client =","                 self.acquire_for_url_without_redirects_with_priority(&current_url, UNPRIORITIZED)","                     .await;","+            let hop_started = client.acquired_at();","+            let deadline = head_budget.map(|budget| hop_started + budget);","             let request = configure(client.request(method.clone(), &current_url), &current_url);","-            let response = request","-                .send()","-                .await","-                .inspect_err(|error| self.downscale_on_timeout(&current_url, error))?;","+            // A head timeout lowers the origin's cap the way a request timeout","+            // does, while this hop still holds its permit.","+            let response = within(deadline, request.send()).await","+                .inspect_err(|_| {","+                    self.downscale_while_peers_active(&current_url);","+                })?","+                .inspect_err(|error| self.downscale_on_timeout(&current_url, error))","+                .map_err(HeadError::Request)?;","             let target = response","                 .headers()","                 .get(reqwest::header::LOCATION)","@@ -160,6 +186,8 @@ impl ThrottledClient {","                 && redirect_count < MAX_REDIRECT_HOPS","                 && let Some(target) = target","             {","+                head_budget =","+                    head_budget.map(|budget| budget.saturating_sub(hop_started.elapsed()));","                 current_url = target.to_string();","                 continue;","             }","@@ -225,3 +253,31 @@ pub(super) fn authorize_without_downgrade<'auth>(","         auth_headers.for_url(url)","     }"," }","+","+/// Why [`ThrottledClient::get_response_head_within`] returned no response.","+#[derive(Debug, derive_more::Display, derive_more::Error)]","+pub enum HeadError {","+    Request(reqwest::Error),","+    /// The response head did not arrive in time.","+    #[display(\"the response head did not arrive in time\")]","+    TimedOut,","+}","+","+impl HeadError {","+    /// The request error of a call that set no head deadline.","+    fn into_request_error(self) -> reqwest::Error {","+        match self {","+            Self::Request(error) => error,","+            Self::TimedOut => unreachable!(\"a request without a head deadline cannot time out\"),","+        }","+    }","+}","+","+/// Await `future`, failing with [`HeadError::TimedOut`] at `deadline`.","+async fn within<Output>(","+    deadline: Option<Instant>,","+    future: impl Future<Output = Output>,","+) -> Result<Output, HeadError> {","+    let Some(deadline) = deadline else { return Ok(future.await) };","+    tokio::time::timeout_at(deadline.into(), future).await.map_err(|_| HeadError::TimedOut)","+}"],"additions":65,"deletions":9,"truncated":false},{"path":"pnpm/crates/network/src/retry/tests.rs","lines":["@@ -534,6 +534,20 @@ async fn a_timeout_while_another_request_is_in_flight_downscales_concurrency() {","     assert!(client.is_origin_downscaled(&url));"," }"," ","+#[tokio::test]","+async fn a_head_deadline_timeout_while_another_request_is_in_flight_downscales_concurrency() {","+    let addr = spawn_stalling_server(b\"\").await;","+    let client = ThrottledClient::default();","+    let url = format!(\"http://{addr}/pkg.tgz\");","+    let head_timeout = Duration::from_millis(200);","+    let first = client.get_response_head_within(&url, head_timeout, |request, _| request);","+    let second = client.get_response_head_within(&url, head_timeout, |request, _| request);","+    let (left, right) = tokio::join!(first, second);","+    assert!(matches!(left, Err(crate::HeadError::TimedOut)), \"{:?}\", left.err());","+    assert!(matches!(right, Err(crate::HeadError::TimedOut)), \"{:?}\", right.err());","+    assert!(client.is_origin_downscaled(&url));","+}","+"," #[tokio::test]"," async fn a_metadata_body_timeout_while_another_request_is_in_flight_downscales_concurrency() {","     let addr = spawn_stalling_server(b\"HTTP/1.1 200 OK\\r\\ncontent-length: 100\\r\\n\\r\\n{\").await;"],"additions":14,"deletions":0,"truncated":false},{"path":"pnpm/crates/network/src/tests/behavior_a_body_that_keeps.rs","lines":["@@ -364,7 +364,7 @@ async fn zero_max_sockets_leaves_proxied_origins_uncapped() {"," }"," "," #[tokio::test]","-async fn stalled_consumers_release_permits_on_deadline_or_cancellation() {","+async fn stalled_consumers_release_permits_on_timeout_or_cancellation() {","     use futures_util::StreamExt;"," ","     let mut server = mockito::Server::new_async().await;","@@ -393,7 +393,7 @@ async fn stalled_consumers_release_permits_on_deadline_or_cancellation() {","         } else {","             let guard = tokio::time::timeout(Duration::from_secs(1), client.acquire_for_url(&url))","                 .await","-                .expect(\"deadline releases a stalled stream's permits\");","+                .expect(\"the timeout releases a stalled stream's permits\");","             drop(guard);","             drain_until_timed_out(&mut stream).await;","         }"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/testing-utils/Cargo.toml","lines":["@@ -13,9 +13,11 @@ repository.workspace = true"," [dependencies]"," assert_cmd = { workspace = true }"," axum = { workspace = true }","+bytes = { workspace = true }"," command-extra = { workspace = true }"," dunce = { workspace = true }"," flate2 = { workspace = true }","+futures-util = { workspace = true }"," pipe-trait = { workspace = true }"," pnpr = { workspace = true }"," rustls = { workspace = true }"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/testing-utils/src/lib.rs","lines":["@@ -14,3 +14,5 @@ pub mod stall_report;"," pub mod trusted_tls_server;"," pub mod turborepo_cache;"," pub mod untrusted_tls_server;","+","+mod registry_activity;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/testing-utils/src/registry.rs","lines":["@@ -1,3 +1,4 @@","+use crate::registry_activity;"," use pnpr::{Config, Ecosystem};"," use pnpr_fixtures::{MockConfigPresets, RemovedVersionField};"," use std::{","@@ -242,12 +243,17 @@ fn run_registry(config: Config, listener: TcpListener, requests: Option<RequestL","         .expect(\"create test registry runtime\");"," ","     runtime.block_on(async move {","+        let registry = config.http.public_url.clone();","         let listener = tokio::net::TcpListener::from_std(listener).expect(\"create tokio listener\");","+        let tracked = |app: axum::Router| {","+            app.layer(axum::middleware::from_fn_with_state(registry, registry_activity::track))","+        };","         let Some(requests) = requests else {","-            pnpr::serve_listener(config, listener).await.expect(\"serve test registry\");","+            pnpr::serve_listener_with(config, listener, tracked).await","+                .expect(\"serve test registry\");","             return;","         };","-        let app = pnpr::router(config)","+        let app = tracked(pnpr::router(config))","             .layer(axum::middleware::from_fn_with_state(requests, record_request));","         axum::serve(listener, app).await.expect(\"serve test registry\");","     });"],"additions":8,"deletions":2,"truncated":false},{"path":"pnpm/crates/testing-utils/src/registry_activity.rs","lines":["@@ -0,0 +1,211 @@","+//! A journal of the requests this test process's mock registries receive,","+//! so the report of a stalled command shows whether it waits on one of them.","+","+use axum::{","+    body::{Body, HttpBody},","+    extract::{Request, State},","+    http::{HeaderValue, Method, header},","+    middleware::Next,","+    response::Response,","+};","+use bytes::Bytes;","+use futures_util::{Stream, StreamExt};","+use std::{","+    fmt::Write as _,","+    pin::Pin,","+    sync::{LazyLock, Mutex, PoisonError},","+    task::{Context, Poll},","+    time::Instant,","+};","+","+/// How many finished requests the report lists, most recent last.","+const FINISHED_IN_REPORT: usize = 10;","+","+static JOURNAL: LazyLock<Mutex<Vec<Entry>>> = LazyLock::new(Mutex::default);","+","+#[derive(Debug)]","+struct Entry {","+    registry: String,","+    method: Method,","+    path: String,","+    started: Instant,","+    /// The status and when the response head was ready.","+    response: Option<(u16, Instant)>,","+    body: BodyState,","+}","+","+#[derive(Debug, Clone, Copy)]","+enum BodyState {","+    Streaming { bytes: u64 },","+    Ended { bytes: u64, at: Instant, how: BodyEnd },","+}","+","+#[derive(Debug, Clone, Copy)]","+enum BodyEnd {","+    Done,","+    Failed,","+    /// The client went away before the body ended.","+    Dropped,","+}","+","+impl Entry {","+    fn is_finished(&self) -> bool {","+        matches!(self.body, BodyState::Ended { how: BodyEnd::Done, .. })","+    }","+}","+","+/// Middleware recording each request of the registry at `registry` in the","+/// journal, through the end of its response body.","+pub(crate) async fn track(","+    State(registry): State<String>,","+    request: Request,","+    next: Next,","+) -> Response {","+    let index = record_start(registry, &request);","+    let response = next.run(request).await;","+    let status = response.status().as_u16();","+    update(index, |entry| entry.response = Some((status, Instant::now())));","+    let (mut parts, body) = response.into_parts();","+    let exact_len = body.size_hint().exact();","+    if exact_len == Some(0) {","+        // An empty body is left alone: a HEAD, 204, or 304 response must","+        // not gain a `Content-Length`.","+        let done = BodyState::Ended { bytes: 0, at: Instant::now(), how: BodyEnd::Done };","+        update(index, |entry| entry.body = done);","+        return Response::from_parts(parts, body);","+    }","+    if let Some(len) = exact_len {","+        // A stream has no exact size, so keep the framing the body had.","+        parts.headers.entry(header::CONTENT_LENGTH).or_insert_with(|| HeaderValue::from(len));","+    }","+    let declared = parts.headers","+        .get(header::CONTENT_LENGTH)","+        .and_then(|value| value.to_str().ok()?.parse().ok());","+    let tracked =","+        TrackedBody { inner: body.into_data_stream(), index, bytes: 0, declared, ended: false };","+    Response::from_parts(parts, Body::from_stream(tracked))","+}","+","+fn record_start(registry: String, request: &Request) -> usize {","+    let entry = Entry {","+        registry,","+        method: request.method().clone(),","+        path: request.uri().path().to_string(),","+        started: Instant::now(),","+        response: None,","+        body: BodyState::Streaming { bytes: 0 },","+    };","+    let mut journal = JOURNAL.lock().unwrap_or_else(PoisonError::into_inner);","+    journal.push(entry);","+    journal.len() - 1","+}","+","+fn update(index: usize, change: impl FnOnce(&mut Entry)) {","+    let mut journal = JOURNAL.lock().unwrap_or_else(PoisonError::into_inner);","+    if let Some(entry) = journal.get_mut(index) {","+        change(entry);","+    }","+}","+","+/// The response body, passed through unchanged while its progress is","+/// recorded.","+struct TrackedBody {","+    inner: axum::body::BodyDataStream,","+    index: usize,","+    bytes: u64,","+    /// The `Content-Length`. The server stops polling once it has sent that","+    /// many bytes, so such a body never reports its end.","+    declared: Option<u64>,","+    ended: bool,","+}","+","+impl TrackedBody {","+    fn end(&mut self, how: BodyEnd) {","+        self.ended = true;","+        let ended = BodyState::Ended { bytes: self.bytes, at: Instant::now(), how };","+        update(self.index, |entry| entry.body = ended);","+    }","+}","+","+impl Stream for TrackedBody {","+    type Item = Result<Bytes, axum::Error>;","+","+    fn poll_next(mut self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<Option<Self::Item>> {","+        let polled = self.inner.poll_next_unpin(context);","+        match &polled {","+            Poll::Ready(Some(Ok(chunk))) => {","+                self.bytes += chunk.len() as u64;","+                if self.declared == Some(self.bytes) {","+                    self.end(BodyEnd::Done);","+                } else {","+                    let streaming = BodyState::Streaming { bytes: self.bytes };","+                    update(self.index, |entry| entry.body = streaming);","+                }","+            }","+            Poll::Ready(Some(Err(_))) => self.end(BodyEnd::Failed),","+            Poll::Ready(None) => self.end(BodyEnd::Done),","+            Poll::Pending => {}","+        }","+        polled","+    }","+}","+","+impl Drop for TrackedBody {","+    fn drop(&mut self) {","+        if !self.ended {","+            self.end(BodyEnd::Dropped);","+        }","+    }","+}","+","+/// The requests that have not finished, and the last ones that have, or an","+/// empty string when no mock registry of this process received a request.","+pub(crate) fn report() -> String {","+    let journal = JOURNAL.lock().unwrap_or_else(PoisonError::into_inner);","+    if journal.is_empty() {","+        return String::new();","+    }","+    let now = Instant::now();","+    let (finished, unfinished) = journal.iter().partition::<Vec<_>, _>(|entry| entry.is_finished());","+    let mut text = format!(","+        \"mock registry requests: {} unfinished, {} finished\\n\",","+        unfinished.len(),","+        finished.len(),","+    );","+    let recent = finished.len().saturating_sub(FINISHED_IN_REPORT);","+    for entry in unfinished","+        .iter()","+        .chain(&finished[recent..])","+    {","+        let _ = writeln!(text, \"  {}\", describe(entry, now));","+    }","+    text","+}","+","+fn describe(entry: &Entry, now: Instant) -> String {","+    let since_start = |at: Instant| at.duration_since(entry.started).as_secs_f32();","+    let response = match entry.response {","+        Some((status, at)) => format!(\"status {status} after {:.1}s\", since_start(at)),","+        None => \"no response yet\".to_string(),","+    };","+    let body = match entry.body {","+        BodyState::Streaming { bytes } if entry.response.is_some() => {","+            format!(\"body still streaming, {bytes} bytes sent\")","+        }","+        BodyState::Streaming { .. } => String::new(),","+        BodyState::Ended { bytes, at, how } => {","+            format!(\"body {how:?} after {:.1}s, {bytes} bytes\", since_start(at))","+        }","+    };","+    format!(","+        \"{} {}{}: started {:.1}s ago, {response}{}{body}\",","+        entry.method,","+        entry.registry,","+        entry.path,","+        now.duration_since(entry.started).as_secs_f32(),","+        if body.is_empty() { \"\" } else { \", \" },","+    )","+}","+","+#[cfg(test)]","+mod tests;"],"additions":211,"deletions":0,"truncated":false},{"path":"pnpm/crates/testing-utils/src/registry_activity/tests.rs","lines":["@@ -0,0 +1,75 @@","+use super::{report, track};","+use axum::{Router, body::Body, routing::get};","+use bytes::Bytes;","+use futures_util::stream;","+use std::{convert::Infallible, time::Duration};","+use tokio::{","+    io::{AsyncReadExt, AsyncWriteExt},","+    net::{TcpListener, TcpStream},","+};","+","+const FULL_BODY: &str = \"a complete body\";","+","+async fn serve_tracked() -> String {","+    let stalled = || async {","+        let first = stream::iter([Ok::<_, Infallible>(Bytes::from_static(b\"12345\"))]);","+        Body::from_stream(futures_util::StreamExt::chain(first, stream::pending()))","+    };","+    let app = Router::new()","+        .route(\"/full\", get(|| async { FULL_BODY }))","+        .route(\"/stalled\", get(stalled))","+        .route(\"/unanswered\", get(std::future::pending::<&'static str>));","+    let listener = TcpListener::bind(\"127.0.0.1:0\").await.unwrap();","+    let address = format!(\"127.0.0.1:{}\", listener.local_addr().unwrap().port());","+    let app = app.layer(axum::middleware::from_fn_with_state(address.clone(), track));","+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });","+    address","+}","+","+/// Sends a GET for `path` and returns what arrives within `wait`.","+async fn get_raw(address: &str, path: &str, wait: Duration) -> String {","+    let mut socket = TcpStream::connect(address).await.unwrap();","+    let request = format!(\"GET {path} HTTP/1.1\\r\\nHost: {address}\\r\\nConnection: close\\r\\n\\r\\n\");","+    socket.write_all(request.as_bytes()).await.unwrap();","+    let mut received = Vec::new();","+    let _ = tokio::time::timeout(wait, socket.read_to_end(&mut received)).await;","+    String::from_utf8_lossy(&received).into_owned()","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn the_report_lists_unfinished_requests_and_keeps_the_framing() {","+    let address = serve_tracked().await;","+    let full = get_raw(&address, \"/full\", Duration::from_secs(5)).await;","+    eprintln!(\"FULL RESPONSE:\\n{full}\");","+    let stalled_client = {","+        let address = address.clone();","+        tokio::spawn(async move { get_raw(&address, \"/stalled\", Duration::from_secs(30)).await })","+    };","+    let unanswered_client = {","+        let address = address.clone();","+        tokio::spawn(async move { get_raw(&address, \"/unanswered\", Duration::from_secs(30)).await })","+    };","+    tokio::time::sleep(Duration::from_millis(500)).await;","+","+    let report = report();","+    eprintln!(\"REPORT:\\n{report}\");","+    stalled_client.abort();","+    unanswered_client.abort();","+","+    assert!(full.contains(&format!(\"content-length: {}\", FULL_BODY.len())));","+    assert!(!full.contains(\"transfer-encoding\"));","+    assert!(report.contains(\"mock registry requests: 2 unfinished, 1 finished\"));","+    let line = |path: &str| {","+        let prefix = format!(\"GET {address}{path}: started \");","+        report","+            .lines()","+            .find(|line| line.trim_start().starts_with(&prefix))","+            .unwrap_or_else(|| panic!(\"the report lists {path}\"))","+            .to_string()","+    };","+    assert!(line(\"/stalled\").ends_with(\"body still streaming, 5 bytes sent\"));","+    assert!(line(\"/unanswered\").ends_with(\"no response yet\"));","+    let full_line = line(\"/full\");","+    assert!(full_line.contains(\"body Done after \"));","+    assert!(full_line.ends_with(&format!(\", {} bytes\", FULL_BODY.len())));","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"pnpm/crates/testing-utils/src/stall_report.rs","lines":["@@ -103,8 +103,9 @@ fn fail_stalled(stall: Stall) -> ! {","         None => \"was still running\".to_string(),","     };","     panic!(","-        \"the command {state} after {deadline:?}; its processes:\\n{report}\\","+        \"the command {state} after {deadline:?}; its processes:\\n{report}{}\\","          stdout so far:\\n{}\\nstderr so far:\\n{}\",","+        crate::registry_activity::