{"id":"39bb7b93c5a88ac3e34176b122930953b00073cb","axis":"silent","repo":"pnpm/pnpm","sha":"39bb7b93c5a88ac3e34176b122930953b00073cb","parsed":{"files":[{"path":".changeset/relink-missing-workspace-dependency.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.status\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm install` now relinks a `workspace:` or `link:` dependency whose link was deleted from `node_modules`. It used to report \"Already up to date\" and leave the link missing [#17485](https://github.com/pnpm/pnpm/issues/17485)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/tests/lockfile_recovery.rs","lines":["@@ -131,6 +131,10 @@ fn sync_fast_path_reads_the_workspace_root_wanted_lockfile_from_a_member() {","     std::fs::create_dir_all(&project_root).expect(\"create workspace member\");","     std::fs::create_dir_all(project_root.join(\"node_modules\"))","         .expect(\"create member modules directory\");","+    // The member's `link:` dependency is linked on every install, so the","+    // recorded state has to see the entry.","+    std::fs::create_dir_all(project_root.join(\"node_modules\").join(\"sibling\"))","+        .expect(\"create the member's link entry\");","     std::fs::create_dir_all(&virtual_store_dir).expect(\"create virtual store\");","     std::fs::write(workspace_root.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","         .expect(\"write workspace manifest\");"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/tests/repeat_install.rs","lines":["@@ -48,6 +48,10 @@ async fn optimistic_repeat_install_skips_entire_pipeline_when_state_is_fresh() {","     std::fs::create_dir_all(&dirs.project_root).expect(\"create project root\");","     std::fs::create_dir_all(&dirs.modules_dir)","         .expect(\"create modules dirs.dir so the deps gate passes\");","+    // A fresh install links a `link:` dependency,