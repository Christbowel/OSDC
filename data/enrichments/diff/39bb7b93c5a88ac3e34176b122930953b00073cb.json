t_decision(r#\"\"dependencies\":{\"lib\":\"workspace:*\"}\"#, |modules_dir| {","+        fs::remove_dir(modules_dir.join(\"lib\")).unwrap();","+    });","+    assert!(","+        matches!(","+            &decision,","+            Decision::Skipped { reason } if reason.contains(\"direct dependency link is missing\")","+        ),","+        \"expected the fast path to stand down, got {decision:?}\",","+    );","+}","+","+#[test]","+fn a_linked_workspace_dependency_keeps_the_fast_path() {","+    let decision = root_decision(r#\"\"dependencies\":{\"lib\":\"workspace:*\"}\"#, |modules_dir| {","+        fs::create_dir_all(modules_dir.join(\"lib\")).unwrap();","+    });","+    assert_eq!(decision, Decision::UpToDate);","+}","+","+/// The absence check stays off for a registry dependency: an excluded or","+/// skipped optional one has no entry, and a full install would not create one","+/// either.","+#[test]","+fn a_missing_registry_dependency_keeps_the_fast_path() {","+    let decision = root_decision(r#\"\"dependencies\":{\"foo\":\"1.0.0\"}\"#, |_| {});","+    assert_eq!(decision, Decision::UpToDate);","+}","+","+/// The wanted lockfile of the workspace [`workspace_link_dangling`] checks:","+/// both projects link the `lib` project.","+const LINKED_LIB_LOCKFILE: &str = \"lockfileVersion: '9.0'","+","+importers:","+","+  .:","+    dependencies:","+      lib:"],"additions":85,"deletions":0,"truncated":false}],"additions":424,"deletions":56,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-30T15:55:32.916626+00:00"}