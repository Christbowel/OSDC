{","         Stale::CatalogsCache => \"catalogs cache outdated\",","         Stale::ProjectStructure => \"workspace project list changed\",","         Stale::MissingModulesDir(_) => \"project has dependencies but no node_modules directory\",","-        Stale::DanglingDirectLink => \"a direct dependency link points to a missing target\",","+        Stale::DanglingDirectLink => {","+            \"a direct dependency link is missing or points to a missing target\"","+        }","         Stale::MissingBranchLockfile => \"the branch lockfile is missing\",","         Stale::Pnpmfile(_) => \"a pnpmfile changed since the last validation\",","         Stale::Unprovable => \"the lockfile cannot be read\",","@@ -370,31 +373,46 @@ fn patch_modified_since(path: &Path, cutoff_ms: i64) -> bool {"," }"," "," /// The first project `scope` holds that needs a modules directory and lacks","-/// one. A state that leaves some project unproven, such as one a filtered","-/// install wrote, holds only the selected projects to it.","+/// one."," fn first_held_project_missing_modules_dir(","     check: &OptimisticRepeatInstallCheck<'_>,","     state: &WorkspaceState,","     scope: Scope<'_>,"," ) -> Option<String> {","+    match held_selection(state, scope) {","+        Some((selected, reach)) => {","+            first_selected_project_missing_modules_dir(check, state, selected, reach)","+        }","+        None => first_project_missing_modules_dir(check, state),","+    }","+}","+","+/// The projects `scope` holds to the modules directory checks, lexically","+/// normalized, or `None` for every project.","+fn held_project_dirs(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    state: &WorkspaceState,","+    scope: Scope<'_>,","+) -> Option<HashSet<PathBuf>> {","+    held_selection(state, scope)","+        .map(|(selected, reach)| reached_project_dirs(check, state, selected, reach))","+}","+","+/// The selection `scope` holds, or `None` for every project. A state that","+/// leaves some project unproven, such as one a filtered install wrote, holds","+/// only the selected projects.","+fn held_selection<'a>(","+    state: &WorkspaceState,","+    scope: Scope<'a>,","+) -> Option<(&'a [&'a Path], SelectedReach)> {","     match scope {","         Scope::Selected(selected) if state.filtered_install => {","-            first_selected_project_missing_modules_dir(","-                check,","-                state,","-                selected,","-                SelectedReach::SelectedOnly,","-            )","+            Some((selected, SelectedReach::SelectedOnly))","         }","         Scope::Command(selected) if state.filtered_install => {","-            first_selected_project_missing_modules_dir(","-                check,","-                state,","-                selected,","-                SelectedReach::WithWorkspaceDeps,","-            )","+            Some((selected, SelectedReach::WithWorkspaceDeps))","         }","-        _ => first_project_missing_modules_dir(check, state),","+        _ => None,","     }"," }"," "],"additions":35,"deletions":17,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/deps_status.rs","lines":["@@ -123,7 +123,7 @@ fn stale_issue(check: &OptimisticRepeatInstallCheck<'_>, stale: Stale) -> String","             format!(\"Workspace package {id} has dependencies but does not have a modules directory\")","         }","         Stale::DanglingDirectLink => {","-            \"a direct dependency link points to a missing target\".to_string()","+            \"a direct dependency link is missing or points to a missing target\".to_string()","         }","         Stale::MissingBranchLockfile | Stale::NoLockfile => {","             format!(\"Cannot find a lockfile in {}\", check.workspace_root.display())"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/freshness.rs","lines":["@@ -15,8 +15,8 @@ use super::{","     deps_status::config_dependencies_drifted,","     direct_dependency_link_dangling, filesystem_now_ms_in_modules,","     first_held_project_missing_modules_dir, first_lockfile_requiring_conflict_safe_install,","-    first_setting_drift, held_projects_match_lockfile, local_file_blocks_fast_path,","-    pnpmfiles_drift, project_structure_matches,","+    first_setting_drift, held_project_dirs, held_projects_match_lockfile,","+    local_file_blocks_fast_path, pnpmfiles_drift, project_structure_matches,","     relocation::{prove_move, rekeyed_validation_now},","     settle::{","         current_lockfile_unusable_with_non_empty_wanted, regenerate_wanted_lockfile_if_missing,","@@ -121,7 +121,8 @@ pub(crate) enum Stale {","     /// A held project with dependencies lacks its modules directory, named by","     /// its id.","     MissingModulesDir(String),","-    /// A direct dependency link in a project's modules directory is dangling.","+    /// A direct dependency link in a project's modules directory is dangling,","+    /// or absent for a dependency the linker always links.","     DanglingDirectLink,","     /// `useGitBranchLockfile` is enabled and the branch lockfile is absent.","     MissingBranchLockfile,","@@ -257,10 +258,23 @@ fn check_settings_and_workspace_freshness(","     if !project_structure_matches(state, project_manifests.as_slice()) {","         return Err(Stale::ProjectStructure);","     }","+    check_held_modules_dirs(check, state, policy, scope)","+}","+","+/// The modules directories of the projects `scope` holds: each one the linker","+/// needs exists, and holds no broken direct dependency link.","+fn check_held_modules_dirs(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    state: &WorkspaceState,","+    policy: &GatePolicy<'_>,","+    scope: Scope<'_>,","+) -> Result<(), Stale> {","     if let Some(id) = first_held_project_missing_modules_dir(check, state, scope) {","         return Err(Stale::MissingModulesDir(id));","     }","-    if policy.check_dangling_direct_links && direct_dependency_link_dangling(check) {","+    if policy.check_dangling_direct_links","+        && direct_dependency_link_dangling(check, held_project_dirs(check, state, scope).as_ref())","+    {","         return Err(Stale::DanglingDirectLink);","     }","     Ok(())"],"additions":18,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/modules_dirs.rs","lines":["@@ -1,4 +1,6 @@","-mod workspace_deps;","+pub(super) mod direct_links;","+","+pub(super) use direct_links::direct_dependency_link_dangling;"," "," use super::{","     OptimisticRepeatInstallCheck, manifest_has_required_peers, manifest_has_runtime_deps,","@@ -11,14 +13,14 @@ use pnpm_modules_yaml::IncludedDependencies;"," use pnpm_package_manifest::{DependencyGroup, PackageManifest};"," use pnpm_workspace::importer_id_from_root_dir;"," use pnpm_workspace_state::WorkspaceState;","-use rayon::prelude::*;"," use std::{","     collections::HashSet,","-    fs,","     path::{Path, PathBuf},"," };"," use workspace_deps::reached_workspace_project_dirs;"," ","+mod workspace_deps;","+"," /// The id (`name` field, falling back to the root dir) of the first"," /// project that declares dependencies but has no modules directory, or"," /// `None` when every project with dependencies has one.","@@ -45,7 +47,20 @@ pub(super) fn first_selected_project_missing_modules_dir(","     selected_project_dirs: &[&Path],","     reach: SelectedReach,"," ) -> Option<String> {","-    let selected = match reach {","+    let selected = reached_project_dirs(check, state, selected_project_dirs, reach);","+    first_missing_modules_dir(check, state, &|root_dir| {","+        selected.contains(&lexical_normalize(root_dir))","+    })","+}","+","+/// The selected projects, as far as `reach` takes them, lexically normalized.","+pub(super) fn reached_project_dirs(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    state: &WorkspaceState,","+    selected_project_dirs: &[&Path],","+    reach: SelectedReach,","+) -> HashSet<PathBuf> {","+    match reach {","         SelectedReach::WithWorkspaceDeps => {","             reached_workspace_project_dirs(check, state, selected_project_dirs)","         }","@@ -53,10 +68,7 @@ pub(super) fn first_selected_project_missing_modules_dir(","             .iter()","             .map(|dir| lexical_normalize(dir))","             .collect(),","-    };","-    first_missing_modules_dir(check, state, &|root_dir| {","-        selected.contains(&lexical_normalize(root_dir))","-    })","+    }"," }"," /// The first project that needs a modules directory and lacks one, over the"," /// projects `is_selected` accepts.","@@ -161,28 +173,6 @@ fn first_project_without_modules_dir(","         })"," }"," ","-/// Whether a direct dependency's entry in its project's modules directory is","-/// a link whose target no longer exists. Nothing the fast path records moves","-/// when a link is broken or retargeted outside pnpm, and the full install","-/// relinks it. A missing entry is not a broken link: skipped optional and","-/// excluded dependencies have none, and a healthy entry costs one `stat`.","-/// The hoisted linker places a sibling's dependencies in the root modules","-/// directory too, so both are probed there.","-pub(super) fn direct_dependency_link_dangling(check: &OptimisticRepeatInstallCheck<'_>) -> bool {","-    let groups = included_groups(check.layout.included);","-    check.project_manifests","-        .par_iter()","-        .any(|(root_dir, manifest)| {","-            project_modules_dirs(check, root_dir, manifest)","-                .iter()","-                .any(|modules_dir| {","-                    manifest","-                        .dependencies(groups.iter().copied())","-                        .any(|(alias, _)| is_dangling_link(&modules_dir.join(alias)))","-                })","-        })","-}","-"," /// The modules directories the linker may place a project's direct"," /// dependencies in."," fn project_modules_dirs(","@@ -195,6 +185,8 @@ fn project_modules_dirs(","         return vec![config.modules_dir.clone()];","     }","     let own = sibling_modules_dir(config, root_dir, manifest);","+    // The hoisted linker places a sibling's dependencies in the root modules","+    // directory too.","     if check.layout.node_linker == NodeLinker::Hoisted {","         vec![own, config.modules_dir.clone()]","     } else {","@@ -202,10 +194,6 @@ fn project_modules_dirs(","     }"," }"," ","-fn is_dangling_link(path: &Path) -> bool {","-    fs::metadata(path).is_err() && fs::symlink_metadata(path).is_ok()","-}","-"," /// The modules directory an isolated install creates for the workspace"," /// project at `root_dir`."," fn sibling_modules_dir(config: &Config, root_dir: &Path, manifest: &PackageManifest) -> PathBuf {"],"additions":22,"deletions":34,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/modules_dirs/direct_links.rs","lines":["@@ -0,0 +1,223 @@","+//! The direct dependency links of each project: whether one is broken, or a","+//! local link the last install made is gone.","+","+use super::{OptimisticRepeatInstallCheck, included_groups, project_modules_dirs};","+use crate::optimistic_repeat_install::manifest_string_field;","+use pnpm_config::NodeLinker;","+use pnpm_fs::lexical_normalize;","+use pnpm_lockfile::{Lockfile, PkgName};","+use pnpm_package_manifest::DependencyGroup;","+use pnpm_workspace::importer_id_from_root_dir;","+use rayon::prelude::*;","+use std::{","+    collections::{HashMap, HashSet},","+    fs,","+    path::{Path, PathBuf},","+    sync::OnceLock,","+};","+","+/// Whether a direct dependency's entry in its project's modules directory is","+/// a link whose target no longer exists, or a local link the last install","+/// made and that is gone. Nothing the fast path records moves when a link is","+/// broken, deleted, or retargeted outside pnpm, and the full install relinks","+/// it.","+///","+/// A missing entry counts only for a `workspace:` or `link:` spec of a","+/// project in `held_project_dirs` (every project when `None`), only when the","+/// linker symlinks direct dependencies ([`links_local_dependencies`]), and","+/// only when [`local_link_missing`] confirms it against the lockfile.","+/// A registry dependency may be absent because it is an excluded or skipped","+/// optional one, and a healthy entry costs one `stat`, so it stays out of","+/// that check.","+pub(in crate::optimistic_repeat_install) fn direct_dependency_link_dangling(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    held_project_dirs: Option<&HashSet<PathBuf>>,","+) -> bool {","+    let groups = included_groups(check.layout.included);","+    let links_local_deps = links_local_dependencies(check);","+    let project_dirs_by_name = OnceLock::new();","+    check.project_manifests","+        .par_iter()","+        .any(|(root_dir, manifest)| {","+            let modules_dirs = project_modules_dirs(check, root_dir, manifest);","+            let held = links_local_deps","+                && held_project_dirs.is_none_or(|held| held.contains(&lexical_normalize(root_dir)));","+            manifest","+                .dependencies(groups.iter().copied())","+                .any(|(alias, spec)| {","+                    let own_entry = entry_state(&modules_dirs[0].join(alias));","+                    own_entry == EntryState::Dangling","+                        || modules_dirs[1..]","+                            .iter()","+                            .any(|modules_dir| {","+                                entry_state(&modules_dir.join(alias)) == EntryState::Dangling","+                            })","+                        || (own_entry == EntryState::Missing","+                            && held","+                            && is_local_link_spec(spec)","+                            && local_link_missing(","+                                LocalLinkCheck {","+                                    check,","+                                    groups: &groups,","+                                    project_dirs_by_name: &project_dirs_by_name,","+                                },","+                                root_dir,","+                                &modules_dirs[0],","+                                (alias, spec),","+                            ))","+                })","+        })","+}","+","+/// Whether the linker symlinks every `link:` dependency of the lockfile into","+/// its project's modules directory. `symlink: false` links no direct","+/// dependency, and the pnp and loaded linkers lay out no `node_modules` tree.","+fn links_local_dependencies(check: &OptimisticRepeatInstallCheck<'_>) -> bool {","+    check.config.symlink","+        && matches!(check.layout.node_linker, NodeLinker::Isolated | NodeLinker::Hoisted)","+}","+","+/// What [`local_link_missing`] reads besides the dependency itself.","+#[derive(Clone, Copy)]","+struct LocalLinkCheck<'a> {","+    check: &'a OptimisticRepeatInstallCheck<'a>,","+    groups: &'a [DependencyGroup],","+    /// Each workspace project's directory by name, built on first use.","+    project_dirs_by_name: &'a OnceLock<HashMap<String, PathBuf>>,","+}","+","+/// Whether the lockfile links `alias` of the project at `root_dir`, whose","+/// own entry is missing, to a local directory that no root entry the linker","+/// may have placed holds. The lockfile, not the manifest, says what the last","+/// install linked: an override or a `readPackage` hook may drop or rewrite the","+/// declared spec, and an injected workspace dependency resolves to a `file:`","+/// snapshot that a platform check may skip. It is read only once no root","+/// entry links the target `spec` names.","+///","+/// The hoisted linker may place a sibling's dependency in the root modules","+/// directory, and under `dedupeDirectDeps` a shared-lockfile install links","+/// the root's entry in place of a sibling's to the same target, so a root","+/// entry counts when it resolves to that target.","+fn local_link_missing(","+    LocalLinkCheck { check, groups, project_dirs_by_name }: LocalLinkCheck<'_>,","+    root_dir: &Path,","+    own_modules_dir: &Path,","+    (alias, spec): (&str, &str),","+) -> bool {","+    let is_root = lexical_normalize(root_dir) == lexical_normalize(check.workspace_root);","+    let shares_root_modules_dir = !is_root","+        && (check.layout.node_linker == NodeLinker::Hoisted","+            || (check.config.dedupe_direct_deps && check.config.shared_workspace_lockfile));","+    let root_entry = check.config.modules_dir.join(alias);","+    if shares_root_modules_dir","+        && declared_link_target(check, project_dirs_by_name, root_dir, (alias, spec))","+            .is_some_and(|target| resolves_to(&root_entry, &target))","+    {","+        return false;","+    }","+    let Some(target) = locked_link_target(check, groups, root_dir, own_modules_dir, alias) else {","+        return false;","+    };","+    !(shares_root_modules_dir && resolves_to(&root_entry, &target))","+}","+","+/// The directory `spec` names for `alias` of the project at `root_dir`: a","+/// `link:` path, or the workspace project a `workspace:` spec selects by name.","+fn declared_link_target(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    project_dirs_by_name: &OnceLock<HashMap<String, PathBuf>>,","+    root_dir: &Path,","+    (alias, spec): (&str, &str),","+) -> Option<PathBuf> {","+    if let Some(path) = spec.strip_prefix(\"link:\") {","+        return Some(root_dir.join(path));","+    }","+    let range = spec.strip_prefix(\"workspace:\")?;","+    let name = match range.rfind('@') {","+        Some(at) if at > 0 => &range[..at],","+        _ => alias,","+    };","+    project_dirs_by_name","+        .get_or_init(|| {","+            check.project_manifests","+                .iter()","+                .filter_map(|(project_dir, manifest)| {","+                    Some((manifest_string_field(manifest, \"name\")?, project_dir.clone()))","+                })","+                .collect()","+        })","+        .get(name)","+        .cloned()","+}","+","+/// The directory the lockfile links `alias` of the project at `root_dir` to,","+/// or `None` when it records no `link:` for it or none can be read. The","+/// project's lockfile is the shared wanted lockfile, or its own under","+/// `sharedWorkspaceLockfile: false`. The current lockfile stands in for a","+/// missing wanted one, as it does for the rest of the fast path.","+fn locked_link_target(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    groups: &[DependencyGroup],","+    root_dir: &Path,","+    own_modules_dir: &Path,","+    alias: &str,","+) -> Option<PathBuf> {","+    let alias = PkgName::parse(alias).ok()?;","+    let target_in = |lockfile: &Lockfile, importer_id: &str| {","+        lockfile.importers","+            .get(importer_id)?","+            .dependencies_by_groups(groups.iter().copied())","+            .find(|(name, _)| **name == alias)","+            .and_then(|(_, dep)| dep.version.as_link_target())","+            .map(|target| root_dir.join(target))","+    };","+    let is_root = lexical_normalize(root_dir) == lexical_normalize(check.workspace_root);","+    if check.config.shared_workspace_lockfile || is_root {","+        let importer_id = importer_id_from_root_dir(check.workspace_root, root_dir);","+        if let Ok(Some(lockfile)) = check.lockfile.get() {","+            return target_in(lockfile, &importer_id);","+        }","+        let current =","+            Lockfile::load_current_from_install_state_dir(&check.config.install_state_dir).ok()??;","+        return target_in(&current, &importer_id);","+    }","+    let lockfile = match Lockfile::load_wanted_from_dir(root_dir) {","+        Ok(Some(lockfile)) => lockfile,","+        _ => Lockfile::load_current_from_install_state_dir(&own_modules_dir.join(\".pnpm\")).ok()??,","+    };","+    target_in(&lockfile, \".\")","+}","+","+/// Whether `entry` exists and resolves to the directory `target` names.","+fn resolves_to(entry: &Path, target: &Path) -> bool {","+    match (fs::canonicalize(entry), fs::canonicalize(target)) {","+        (Ok(entry), Ok(target)) => entry == target,","+        _ => false,","+    }","+}","+","+/// A spec the linker may link to a local directory: a path (`link:`) or a","+/// workspace project (`workspace:`).","+pub(in crate::optimistic_repeat_install) fn is_local_link_spec(spec: &str) -> bool {","+    spec.starts_with(\"workspace:\") || spec.starts_with(\"link:\")","+}","+","+/// What a direct dependency's entry in a modules directory is.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+enum EntryState {","+    Present,","+    /// A link whose target is gone.","+    Dangling,","+    Missing,","+}","+","+/// The state of `path`, at one `stat` for a healthy entry.","+fn entry_state(path: &Path) -> EntryState {","+    if fs::metadata(path).is_ok() {","+        EntryState::Present","+    } else if fs::symlink_metadata(path).is_ok() {","+        EntryState::Dangling","+    } else {","+        EntryState::Missing","+    }","+}"],"additions":223,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests.rs","lines":["@@ -380,6 +380,18 @@ fn setup_fresh_install_with_config(","     // Pre-create the modules dir so the \"missing node_modules\" guard","     // doesn't fire on the happy-path tests.","     fs::create_dir_all(&config.modules_dir).unwrap();","+    // A fresh install links every `workspace:`/`link:` dependency, so a","+    // fixture that claims a fresh state has to show those entries too. A test","+    // that wants one gone removes it itself.","+    for (alias, spec) in manifest.dependencies([","+        pnpm_package_manifest::DependencyGroup::Prod,","+        pnpm_package_manifest::DependencyGroup::Dev,","+        pnpm_package_manifest::DependencyGroup::Optional,","+    ]) {","+        if super::modules_