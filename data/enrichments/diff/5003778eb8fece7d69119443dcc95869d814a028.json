r multi-CTA is not supported internally on H100/B200 MIG slices."," +# https://docs.cloud.google.com/kubernetes-engine/docs/how-to/gpus-multi "," +# because the operations for inter- CTA synchronization are not supported on MIG.","- ","--","--@pytest.mark.skipif(not is_cuda() or torch.cuda.get_device_capability()[0] < 9,","--                    reason=\"num_ctas > 1 requires NVIDIA SM90+ (Hopper)\")","--@pytest.mark.skipif(is_sm12x(), reason=\"scalar multi-CTA atomic_cas is not supported on sm120 (consumer Blackwell)\")","++"," +@pytest.mark.skipif(True,"," +                    reason=\"num_ctas > 1 (Cluster Multi-CTA) is not supported internally on H100/B200 MIG slices\")","  def test_scalar_atomic_cas_multicta_result(device):","  ","      @triton.jit","-@@ -1969,8 +1970,8 @@ def test_scalar_atomic_cas_multicta_result(device):","+@@ -2005,8 +2011,8 @@ def test_scalar_atomic_cas_multicta_result(device):","      torch.testing.assert_close(output, torch.full_like(output, 7))","  ","  ","@@ -64,7 +62,7 @@","  @pytest.mark.parametrize(\"size\", [1, 4, 16, 128, 512])","  def test_tensor_atomic_cas_multicta_result(size, device):","  ","-@@ -2021,8 +2022,8 @@ def test_tensor_atomic_cas(sem, size, dtype_str, num_ctas, device):","+@@ -2057,8 +2063,8 @@ def test_tensor_atomic_cas(sem, size, dtype_str, num_ctas, device):","  ","  ","  @pytest.mark.interpreter","@@ -101,3 +99,25 @@","          capture_output=True,","          env=env,"," ","+--- a/python/triton/_test_runner.py","+@@ -211,9 +211,17 @@","+ ","+ ","+ def _suite(args):","++    old_junit_dir = os.environ.get(\"TRITON_TEST_JUNIT_DIR\")","+     if args.junit_dir is not None:","+         os.environ[\"TRITON_TEST_JUNIT_DIR\"] = args.junit_dir","+-    return {\"unit\": _unit, \"gsan\": _gsan, \"gluon\": _gluon}[args.name](args)","++    try:","++        return {\"unit\": _unit, \"gsan\": _gsan, \"gluon\": _gluon}[args.name](args)","++    finally:","++        if args.junit_dir is not None:","++            if old_junit_dir is not None:","++                os.environ[\"TRITON_TEST_JUNIT_DIR\"] = old_junit_dir","++            else:","++                os.environ.pop(\"TRITON_TEST_JUNIT_DIR\", None)","+ ","+ ","+ def _report(args):","+"],"additions":30,"deletions":11,"truncated":false},{"path":"third_party/xla/third_party/triton/common/old_ptxas.patch","lines":["@@ -18,7 +18,7 @@ On Blackwell architectures with PTX 8.8+, upstream Triton generates 256-bit glob"," "," --- a/test/Conversion/tritongpu_to_llvm_blackwell_256bit.mlir"," +++ b/test/Conversion/tritongpu_to_llvm_blackwell_256bit.mlir","-@@ -5,7 +5,7 @@","+@@ -8,7 +8,7 @@","  #blocked_8xf32 = #ttg.blocked<{sizePerThread = [8], threadsPerWarp = [32], warpsPerCTA = [1], order = [0]}>","  module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","    // BW256-LABEL: global_load_v8_b32","@@ -27,7 +27,7 @@ On Blackwell architectures with PTX 8.8+, upstream Triton generates 256-bit glob","    // PRE_BW-LABEL: global_load_v8_b32","    // PRE_BW-NOT: ld.global.v8.b32","    // PRE_BW: ld.global.v4.b32","-@@ -29,7 +29,7 @@ module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","+@@ -32,7 +32,7 @@ module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","  #blocked_8xf32 = #ttg.blocked<{sizePerThread = [8], threadsPerWarp = [32], warpsPerCTA = [1], order = [0]}>","  module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","    // BW256-LABEL: global_store_v8_b32","@@ -36,7 +36,7 @@ On Blackwell architectures with PTX 8.8+, upstream Triton generates 256-bit glob","    // PRE_BW-LABEL: global_store_v8_b32","    // PRE_BW-NOT: st.global.v8.b32","    // PRE_BW: st.global.v4.b32","-@@ -54,7 +54,7 @@ module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","+@@ -57,7 +57,7 @@ module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","  #blocked_4xf64 = #ttg.blocked<{sizePerThread = [4], threadsPerWarp = [32], warpsPerCTA = [1], order = [0]}>","  module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 1 : i32} {","    // BW256-LABEL: global_load_v4_b64","@@ -48,7 +48,7 @@ On Blackwell architectures with PTX 8.8+, upstream Triton generates 256-bit glob"," "," --- a/third_party/nvidia/lib/TritonNVIDIAGPUToLLVM/LoadStoreOpToLLVM.cpp"," +++ b/third_party/nvidia/lib/TritonNVIDIAGPUToLLVM/LoadStoreOpToLLVM.cpp","-@@ -94,12 +94,9 @@ struct LoadStoreConversionBase {","+@@ -96,12 +96,9 @@ struct LoadStoreConversionBase {","      auto pointeeBitWidth = triton::getPointeeBitWidth(tensorTy);","      LDBG(\"getVectorSize contiguity = \" << contiguity << \" pointeeBitWidth = \"","                                         << pointeeBitWidth);"],"additions":4,"deletions":4,"truncated":false},{"path":"third_party/xla/third_party/triton/common/proxy_fence_insertion_speedup.patch","lines":["@@ -0,0 +1,188 @@","+Optimize ProxyFenceInsertion and memory frontier/buffer region analysis.","+","+This patch accelerates proxy fence insertion and related analysis:","+- Short-circuits comparison in AddressSet::operator< using equality, empty(),","+  find_first(), and count() before element-wise iteration.","+- Reorders fields in BufferRegionView::key() to compare scalar/base attributes","+  prior to the full region.","+- Adds early-return and empty fast-paths in ScopedMemoryFrontier::join,","+  eraseScopes, hasHazard, and intersects.","+- Adds empty() check and self-join fast path in ProxyBlockInfo::join, and guards","+  applyEffects() with !effects.empty().","+- Adds AddressSetOrdering unit test in UtilityTest.","+","+Upstream PR #11468 fixes the","+problem at an architectural level. This patch can be dropped once that change","+is integrated.","+","+--- a/include/triton/Analysis/BufferRegion.h","+@@ -53,6 +53,16 @@","+     return addresses == other.addresses;","+   }","+   bool operator<(const AddressSet &other) const {","++    if (addresses == other.addresses)","++      return false;","++    if (empty() != other.empty())","++      return empty();","++    int first = addresses.find_first();","++    int otherFirst = other.addresses.find_first();","++    if (first != otherFirst)","++      return first < otherFirst;","++    if (addresses.count() != other.addresses.count())","++      return addresses.count() < other.addresses.count();","+     auto lhs = begin();","+     auto rhs = other.begin();","+     while (lhs != end() && rhs != other.end()) {","+@@ -137,8 +147,9 @@","+ ","+ private:","+   auto key() const {","+-    return std::tie(allocationFrame, region, storageBase, affineOffset,","+-                    affinePartitionOffset, affineCTAOffset, partitionBases);","++    return std::tie(allocationFrame, storageBase, affineOffset,","++                    affinePartitionOffset, affineCTAOffset, partitionBases,","++                    region);","+   }","+ ","+ public:","+","+--- a/include/triton/Analysis/MemoryFrontier.h","+@@ -23,30 +23,53 @@","+     add(/*isWrite=*/true, std::move(access), scopes);","+   }","+ ","++  bool empty() const { return accesses[0].empty() && accesses[1].empty(); }","++","+   ScopedMemoryFrontier &join(const ScopedMemoryFrontier &other) {","+-    for (unsigned i = 0; i < accesses.size(); ++i)","++    if (this == &other)","++      return *this;","++    for (unsigned i = 0; i < accesses.size(); ++i) {","++      if (other.accesses[i].empty())","++        continue;","++      if (accesses[i].empty()) {","++        accesses[i] = other.accesses[i];","++        continue;","++      }","+       for (const auto &[access, scopes] : other.accesses[i])","+         accesses[i][access] |= scopes;","++    }","+     return *this;","+   }","+ ","+   void join(const ScopedMemoryFrontier &other, ScopeMaskT scopes) {","+-    for (unsigned i = 0; i < accesses.size(); ++i)","++    if (!scopes)","++      return;","++    for (unsigned i = 0; i < accesses.size(); ++i) {","++      if (other.accesses[i].empty())","++        continue;","+       for (const auto &[access, accessScopes] : other.accesses[i])","+         if (ScopeMaskT activeScopes = accessScopes & scopes)","+           accesses[i][access] |= activeScopes;","++    }","+   }","+ ","+   void eraseScopes(ScopeMaskT scopes) {","+-    for (AccessMap &map : accesses)","++    if (!scopes)","++      return;","++    for (AccessMap &map : accesses) {","++      if (map.empty())","++        continue;","+       for (auto it = map.begin(); it != map.end();)","+         if (it->second &= ~scopes)","+           ++it;","+         else","+           it = map.erase(it);","++    }","+   }","+ ","+   bool hasHazard(const ScopedMemoryFrontier &other, ScopeMaskT scope) const {","++    if (!scope || other.empty() || empty())","++      return false;","+     return intersects(other, /*lhsWrite=*/true, /*rhsWrite=*/false, scope) ||","+            intersects(other, /*lhsWrite=*/false, /*rhsWrite=*/true, scope) ||","+            intersects(other, /*lhsWrite=*/true, /*rhsWrite=*/true, scope);","+@@ -72,6 +95,8 @@","+ ","+   bool intersects(const ScopedMemoryFrontier &other, bool lhsWrite,","+                   bool rhsWrite, ScopeMaskT scope) const {","++    if (accesses[lhsWrite].empty() || other.accesses[rhsWrite].empty())","++      return false;","+     for (const auto &[left, leftScopes] : accesses[lhsWrite]) {","+       if (!(leftScopes & scope))","+         continue;","+","+--- a/lib/Dialect/TritonNvidiaGPU/Transforms/ProxyFenceInsertion.cpp","+@@ -44,7 +44,13 @@","+   // Scopes fenced on every path from the function entry.","+   uint8_t entryGenericFenced = 0;","+ ","++  bool empty() const {","++    return generic.empty() && async.empty() && entryGenericFenced == 0;","++  }","++","+   ProxyBlockInfo &join(const ProxyBlockInfo &other) {","++    if (this == &other)","++      return *this;","+     generic.join(other.generic);","+     async.join(other.async);","+     entryGenericFenced &= other.entryGenericFenced;","+@@ -139,7 +145,8 @@","+       effects.generic.addRead(scratch, scopes);","