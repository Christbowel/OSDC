{"id":"5003778eb8fece7d69119443dcc95869d814a028","axis":"silent","repo":"tensorflow/tensorflow","sha":"5003778eb8fece7d69119443dcc95869d814a028","parsed":{"files":[{"path":"third_party/xla/third_party/triton/common/allocator.patch","lines":["@@ -14,7 +14,7 @@"," # =============================================================================="," --- a/python/test/gsan/test_allocator.py"," +++ b/python/test/gsan/test_allocator.py","-@@ -427,12 +427,18 @@ def test_export_import_allocation_handles_maps_real_and_shadow(_direct_allocator","+@@ -626,12 +626,18 @@ def test_export_import_allocation_handles_maps_real_and_shadow(_direct_allocator","      ],","  )","  def test_export_import_fabric_handles(explicit_config, allocator_config):","@@ -45,7 +45,7 @@"," "," --- a/python/triton/experimental/gsan/src/GSanAllocator.cc"," +++ b/python/triton/experimental/gsan/src/GSanAllocator.cc","-@@ -372,8 +372,14 @@ CUresult ensureContext(int device) {","+@@ -377,8 +377,14 @@ CUresult ensureContext(int device) {","    CUresult res = cuCtxGetCurrent(&ctx);","    if (res != CUDA_SUCCESS)","      return res;"],"additions":2,"deletions":2,"truncated":false},{"path":"third_party/xla/third_party/triton/common/amd_range_analysis.patch","lines":["@@ -0,0 +1,57 @@","+Fix signed integer overflow in AMD RangeAnalysis trip count calculations.","+","+In maybeGetTripCount, (max - min) / step can overflow signed 64-bit integers;","+this patch extends the bitwidth via APInt before division. In getTotalLoopTripCount,","+intermediate trip count multiplication could overflow; this patch bounds checks","+at each step against kDefaultMaxTripCount.","+","+Lifecycle: Upstream this fix to triton-lang/triton and remove the patch in the next integration.","+","+--- a/third_party/amd/lib/Analysis/RangeAnalysis.cpp","+@@ -314,13 +314,16 @@","+   // loop can run. Over-estimating is safe because extra backedges only widen","+   // loop carried values; under-estimating is not. Loops which may not run at","+   // all are handled by always propagating the init args.","+-  int64_t tripCount = llvm::divideCeilSigned(","+-      max.getSExtValue() - min.getSExtValue(), stepVal.getSExtValue());","+-  // A negative count means the subtraction above overflowed, i.e. we do not","+-  // have a usable bound on the number of iterations.","+-  if (tripCount < 0)","++  APInt diff = max.sext(width + 1) - min.sext(width + 1);","++  APInt stepSext = stepVal.sext(width + 1);","++  if (stepSext.isNegative())","+     return {};","+-  return tripCount;","++  APInt tripCount = diff.sdiv(stepSext);","++  if (!diff.srem(stepSext).isZero())","++    tripCount += 1;","++  if (tripCount.isNegative() || tripCount.getActiveBits() > 63)","++    return {};","++  return tripCount.getSExtValue();","+ }","+ ","+ bool isEmptyInitializedRange(ConstantIntRanges rv) {","+@@ -384,11 +387,16 @@","+ TritonIntegerRangeAnalysis::getTotalLoopTripCount(LoopLikeOpInterface loop) {","+   SmallVector<LoopLikeOpInterface> loops{loop};","+   getEnclosingLoops(*loop, loops);","+-  return std::accumulate(loops.begin(), loops.end(), (int64_t)1,","+-                         [this](int64_t accum, LoopLikeOpInterface loop) {","+-                           return accum * maybeGetTripCount(loop).value_or(","+-                                              kDefaultMaxTripCount + 1);","+-                         });","++  int64_t total = 1;","++  for (LoopLikeOpInterface l : loops) {","++    int64_t tripCount = maybeGetTripCount(l).value_or(kDefaultMaxTripCount + 1);","++    if (tripCount > kDefaultMaxTripCount)","++      return kDefaultMaxTripCount + 1;","++    total *= tripCount;","++    if (total > kDefaultMaxTripCount)","++      return kDefaultMaxTripCount + 1;","++  }","++  return total;","+ }","+ ","+ int64_t","+"],"additions":56,"deletions":0,"truncated":false},{"path":"third_party/xla/third_party/triton/common/blackwell_nvfp4_mn_major_fallback.patch","lines":["@@ -20,51 +20,6 @@ to mxf8f6f4 if either operand is not K-packed. However, mxf4nvf4 supports UE4M3/"," scales while the mxf8f6f4 fallback only supports E8M0 scales; this patch adds validation"," to disallow unsupported scale formats with MN-major operands and configures FP4 padding."," ","-+++ b/lib/Dialect/TritonGPU/Transforms/AccelerateMatmul.cpp","-@@ -887,18 +887,34 @@","-     // MMA_K = 64 is also not supported when BLOCK_M = 64.","-     auto blockK = dotOp.getA().getType().getShape().back() * (isAFP4 ? 2 : 1);","-     auto blockM = dotOp.getA().getType().getShape()[0];","--    // mxf4/mxf4nvf4 do not support MN-major operands, so fp4 x fp4 falls","--    // back to mxf8f6f4 if either operand is not K-packed. The mxf8f6f4","--    // shared-memory packing format requires padding for every fp4 operand,","--    // even if the operand is K packed.","--    bool isFp4MMAUsingMxf8f6f4 =","-+    bool hasMNMajorFp4Operand =","-         isFp4MMA && (!dotOp.getLhsKPack() || !dotOp.getRhsKPack());","-+    auto aScaleType = dotOp.getAScale().getType();","-+    auto bScaleType = dotOp.getBScale().getType();","-+    auto aScaleElemType = aScaleType.getElementType();","-+    auto bScaleElemType = bScaleType.getElementType();","-+    auto isBlock16Scale = [blockK](RankedTensorType scaleType) {","-+      return scaleType.getShape().back() * 16 == blockK;","-+    };","-+    bool hasUE4M3Scale = isa<Float8E4M3FNType>(aScaleElemType) ||","-+                         isa<Float8E4M3FNType>(bScaleElemType);","-+    bool hasUE5M3Scale =","-+        (aScaleElemType.isInteger(8) && isBlock16Scale(aScaleType)) ||","-+        (bScaleElemType.isInteger(8) && isBlock16Scale(bScaleType));","-+    // mxf4nvf4 supports UE4M3/UE5M3 scales but not MN-major operands, while","-+    // the mxf8f6f4 fallback for MN-major FP4 only supports E8M0 scales.","-+    if (hasMNMajorFp4Operand && (hasUE4M3Scale || hasUE5M3Scale))","-+      return failure();","-+    // mxf4 does not support MN-major operands, so mxfp4 x mxfp4 falls back to","-+    // mxf8f6f4 if either operand is not K-packed. The mxf8f6f4 shared-memory","-+    // packing format requires padding for every fp4 operand, even if the","-+    // operand is K packed.","-     bool isMMAv5Fp4PaddedLhs =","--        isFp4MMAUsingMxf8f6f4 ||","-+        hasMNMajorFp4Operand ||","-         (IsAMixedPrecFp4 && (requiresFp4Padding || blockM == 64 ||","-                              blockK == 32 || !dotOp.getLhsKPack()));","-     bool isMMAv5Fp4PaddedRhs =","--        isFp4MMAUsingMxf8f6f4 ||","-+        hasMNMajorFp4Operand ||","-         (IsBMixedPrecFp4 &&","-          (requiresFp4Padding || blockK == 32 || !dotOp.getRhsKPack()));","- ","-"," --- a/python/test/conftest.py"," +++ b/python/test/conftest.py"," @@ -1,4 +1,15 @@","@@ -86,15 +41,15 @@ to disallow unsupported scale formats with MN-major operands and configures FP4"," "," --- a/python/test/unit/language/test_warp_specialization.py"," +++ b/python/test/unit/language/test_warp_specialization.py","-@@ -7,6 +7,10 @@","- ","+@@ -8,6 +8,10 @@ import triton.language as tl","  from triton._internal_testing import is_compile_warmup, is_hip, is_hopper, is_blackwell","  from triton.tools.tensor_descriptor import TensorDescriptor","-+","+ "," +# Attempts to dlopen cuBLAS, prevent this path"," +# TODO: b/436154455 - Re-enable once we can link in cuBLAS properly"," +cublas = None","- ","++","  pytestmark = pytest.mark.enable_warmup(min_capability=9)","  ","+ "," "],"additions":4,"deletions":48,"truncated":false},{"path":"third_party/xla/third_party/triton/common/convert_layout_heuristic.patch","lines":["@@ -24,7 +24,7 @@ See also b/422133176"," "," --- a/lib/Dialect/TritonGPU/Transforms/RemoveLayoutConversions.cpp"," +++ b/lib/Dialect/TritonGPU/Transforms/RemoveLayoutConversions.cpp","-@@ -344,6 +344,15 @@ SmallVector<Value> LayoutPropagation::propagateToUsers(Value value,","+@@ -338,6 +338,15 @@ SmallVector<Value> LayoutPropagation::propagateToUsers(Value value,","      if (auto reshapeOp = dyn_cast<ReshapeOp>(user);","          reshapeOp && reshapeOp.getEfficientLayout())","        continue;"],"additions":1,"deletions":1,"truncated":false},{"path":"third_party/xla/third_party/triton/common/disable_amd_test.patch","lines":["@@ -18,7 +18,7 @@ would not be able to get run on presubmit anyway."," "," --- a/python/test/unit/language/test_compile_only.py"," +++ b/python/test/unit/language/test_compile_only.py","-@@ -333,6 +333,8 @@ def test_signature_ordering():","+@@ -347,6 +347,8 @@ def test_signature_ordering():","      triton.compile(src=src, target=target)","  ","  "],"additions":1,"deletions":1,"truncated":false},{"path":"third_party/xla/third_party/triton/common/llvm_cl966791199.patch","lines":["@@ -14,7 +14,7 @@"," # =============================================================================="," --- a/test/LLVMIR/convert-to-llvmir-with-dbg-info.mlir"," +++ b/test/LLVMIR/convert-to-llvmir-with-dbg-info.mlir","-@@ -37,13 +37,13 @@","+@@ -37,13 +37,13 @@ module attributes {\"ttg.num-ctas\" = 1 : i32, \"ttg.num-warps\" = 4 : i32} {","  ","      // CHECK: !DILocalVariable(name: \"x\", scope:","      %x_ptr = llvm.getelementptr %arg0[%block_start] : (!llvm.ptr<1>, i32) -> !llvm.ptr<1>, f32"],"additions":1,"deletions":1,"truncated":false},{"path":"third_party/xla/third_party/triton/common/llvm_cl974500093.patch","lines":["@@ -25,7 +25,7 @@"," +    // COMMON: rocdl.raw.ptr.buffer.load.async.lds {{.*}} <{alias_scopes = [[[$ASYNC_COPY_SCOPE]]]","      // Check that store for 'other' has alias information set","      // COMMON: llvm.store {{.*}} {alias_scopes = [[[$LOCAL_LOAD_SCOPE]]], {{.*}}, noalias_scopes = [[[$ASYNC_COPY_SCOPE]]]","-     %65 = amdg.buffer_load_to_local %arg1[%arg2] mask=%mask other=%other into %arg3 : <f32>[tensor<8x64xi32, #blocked>] tensor<8x64xf32, #blocked> -> <8x64xf32, #shared, #smem, mutable>","+     %65 = amdg.buffer_load_to_local %arg1[%arg2] mask=%mask other=%other into %arg3 : !tt.ptr<f32>[tensor<8x64xi32, #blocked>] tensor<8x64xf32, #blocked> -> <8x64xf32, #shared, #smem, mu