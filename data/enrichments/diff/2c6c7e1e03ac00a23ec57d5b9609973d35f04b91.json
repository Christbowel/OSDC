filtering_required: u8,","     has_partial_aggregate: u8,","     plan_ptr: *const u8,","     plan_len: i64,","@@ -1233,6 +1234,7 @@ pub unsafe extern \"C\" fn df_create_session_context(","                 shard_view_ptr,","                 table_name,","                 context_id,","+                deleted_doc_filtering_required != 0,","                 has_partial_aggregate != 0,","                 query_config,","                 plan_bytes,","@@ -1273,6 +1275,7 @@ pub unsafe extern \"C\" fn df_create_session_context_indexed(","     tree_shape: i32,","     delegated_predicate_count: i32,","     requests_row_ids: u8,","+    deleted_doc_filtering_required: u8,","     has_partial_aggregate: u8,","     query_config_ptr: i64,","     plan_ptr: *const u8,","@@ -1303,6 +1306,7 @@ pub unsafe extern \"C\" fn df_create_session_context_indexed(","                 tree_shape,","                 delegated_predicate_count,","                 requests_row_ids != 0,","+                deleted_doc_filtering_required != 0,","                 has_partial_aggregate != 0,","                 query_config,","                 plan_bytes,"],"additions":4,"deletions":0,"truncated":false},{"path":"sandbox/plugins/analytics-backend-datafusion/rust/src/indexed_executor.rs","lines":["@@ -137,6 +137,7 @@ pub async fn execute_indexed_query(","             crate::query_tracker::QueryType::Shard,","         ),","         table_name: table_name.clone(),","+        deleted_doc_filtering_required: false,","         indexed_config: None, // derive classification from tree","         query_config: Arc::unwrap_or_clone(query_config),","         io_handle: tokio::runtime::Handle::current(),","@@ -398,6 +399,53 @@ fn single_collector_id(tree: &BoolNode) -> Option<i32> {","     }"," }"," ","+/// Reserved annotation id resolved by the Java `FilterDelegationHandle` to a","+/// `MatchAllDocsQuery` whose per-RG collector emits the segment's liveDocs.","+/// Coordinator-assigned annotation ids are non-negative (`PlannerContext.nextAnnotationId`","+/// counter), so negative ids can never collide. Must match","+/// `FilterDelegationHandle.LIVE_DOCS_MATCH_ALL_ANNOTATION_ID` on the Java side.","+pub const LIVE_DOCS_MATCH_ALL_ANNOTATION_ID: i32 = -2;","+","+/// The reserved match-all Collector leaf (Java resolves the id to a `MatchAllDocsQuery` whose","+/// per-RG collector emits the segment's liveDocs).","+fn live_docs_collector() -> BoolNode {","+    BoolNode::Collector {","+        annotation_id: LIVE_DOCS_MATCH_ALL_ANNOTATION_ID,","+    }","+}","+","+/// Constrain the extracted filter to live documents by AND-ing the reserved match-all Collector","+/// leaf into the decoded tree (deleted-doc filtering, no dedicated liveDocs FFI). Called only when","+/// the shard has deletions. Returns the extraction unchanged when a correctness Collector already","+/// guarantees live-only output ([`BoolNode::is_covered_by_live_docs`]). Shapes:","+/// - No filter (`count(*)`): a bare match-all Collector — the SingleCollector arm resolves it as","+///   the correctness collector, so per-RG candidates are exactly the segment's live docs.","+/// - AND trees (pure-DF / DelegationPossible): the match-all Collector is prepended at the root,","+///   keeping the tree `SingleCollector` with the predicates as the residual.","+/// - Other shapes (OR/NOT over collectors and predicates): the match-all Collector is AND'ed at the","+///   root — required under NOT, where leaf-level liveDocs filtering readmits deleted docs but a","+///   top-level AND with the live set masks them regardless of the inner shape.","+fn ensure_live_docs_coverage(extraction: Option<ExtractionResult>) -> ExtractionResult {","+    let tree = match extraction {","+        None => live_docs_collector(),","+        Some(extraction) if extraction.tree.is_covered_by_live_docs() => {","+            return extraction;","+        }","+        Some(extraction) => match Arc::unwrap_or_clone(extraction.tree) {","+            BoolNode::And(mut children) => {","+                // Keep the mandatory visibility mask first so downstream evaluation can narrow","+                // candidates before other predicates.","+                children.insert(0, live_docs_collector());","+                BoolNode::And(children)","+            }","+            other => BoolNode::And(vec![live_docs_collector(), other]),","+        },","+    };","+    ExtractionResult {","+        tree: Arc::new(tree),","+    }","+}","+"," /// For a tree classified as `SingleCollector`, return the residual"," /// (all non-Collector parts of the AND tree, re-assembled into a"," /// single BoolNode). Recursively strips Collector leaves from nested","@@ -802,6 +850,180 @@ mod tests {","         assert_eq!(segs[0].global_base, 7);","         assert_eq!(segs[0].max_doc, 42);","     }","+","+    fn extraction_of(tree: BoolNode) -> Option<ExtractionResult> {","+        Some(ExtractionResult {","+            tree: Arc::new(tree),","+        })","+    }","+","+    fn is_live_docs_leaf(node: &BoolNode) -> bool {","+        matches!(","+            node,","+            BoolNode::Collector { annotation_id } if *annotation_id == LIVE_DOCS_MATCH_ALL_ANNOTATION_ID","+        )","+    }","+","+    #[test]","+    fn coverage_no_filter_becomes_bare_live_docs_collector() {","+        // `count(*)` on a shard with deletions: candidates must be exactly the live docs.","+        let out = ensure_live_docs_coverage(None);","+        assert!(is_live_docs_leaf(&out.tree));","+        assert_eq!(","+            single_collector_id(&out.tree),","+            Some(LIVE_DOCS_MATCH_ALL_ANNOTATION_ID)","+        );","+    }","+","+    #[test]","+    fn coverage_pure_predicate_tree_prepends_collector_and_stays_single_collector() {","+        // Pure-DF predicate AND tree: match-all becomes the correctness collector,","+        // predicates stay as the residual. Classification must remain SingleCollector.","+        let out = ensure_live_docs_coverage(extraction_of(BoolNode::And(vec![pred(), pred()])));","+        match out.tree.as_ref() {","+            BoolNode::And(children) => {","+                assert_eq!(children.len(), 3);","+                assert!(is_live_docs_leaf(&children[0]));","+                assert!(children[1..].iter().all(is_predicate));","+            }","+            other => panic!(\"expected And, got {:?}\", other),","+        }","+        assert_eq!(classify_filter(&out.tree), FilterClass::SingleCollector);","+        assert_eq!(","+            single_collector_id(&out.tree),","+            Some(LIVE_DOCS_MATCH_ALL_ANNOTATION_ID)","+        );","+        // Residual (what DF evaluates) keeps both predicates.","+        let residual = extract_single_collector_residual(&out.tree).unwrap();","+        match residual {","+            BoolNode::And(children) => assert_eq!(children.len(), 2),","+            other => panic!(\"expected And residual, got {:?}\", other),","+        }","+    }","+","+    #[test]","+    fn coverage_or_predicate_tree_wraps_in_and() {","+        // Pure-DF OR tree (no collectors): AND(live_docs, OR(P, P)) — still SingleCollector","+        // (the OR subtree has no collectors, so it rides as the residual).","+        let out = ensure_live_docs_coverage(extraction_of(BoolNode::Or(vec![pred(), pred()])));","+        match out.tree.as_ref() {","+            BoolNode::And(children) => {","+                assert_eq!(children.len(), 2);","+                assert!(is_live_docs_leaf(&children[0]));","+                assert!(matches!(children[1], BoolNode::Or(_)));","+            }","+            other => panic!(\"expected And, got {:?}\", other),","+        }","+        assert_eq!(classify_filter(&out.tree), FilterClass::SingleCollector);","+    }","+","+    #[test]","+    fn coverage_skips_existing_single_collector_shape() {","+        // AND(Collector, P) — the existing correctness collector's bitmap is already","+        // live-docs-filtered on the Java side; injecting a second collector would demote","+        // SingleCollector → Tree. Tree must be unchanged.","+        let out =","+            ensure_live_docs_coverage(extraction_of(BoolNode::And(vec![collector(7), pred()])));","+        match out.tree.as_ref() {","+            BoolNode::And(children) => {","+                assert_eq!(children.len(), 2);","+                assert!(matches!(","+                    children[0],","+                    BoolNode::Collector { annotation_id: 7 }","+                ));","+            }","+            other => panic!(\"expected unchanged And, got {:?}\", other),","+        }","+        assert_eq!(single_collector_id(&out.tree), Some(7));","+    }","+","+    #[test]","+    fn coverage_skips_bare_collector() {","+        let out = ensure_live_docs_coverage(extraction_of(collector(3)));","+        assert!(matches!(","+            out.tree.as_ref(),","+            BoolNode::Collector { annotation_id: 3 }","+        ));","+    }","+","+    #[test]","+    fn coverage_skips_or_of_collectors() {","+        // OR(C₁, C₂) is covered: the union of two live-filtered collector bitmaps still","+        // excludes deleted docs, so no live-docs collector is injected. Tree unchanged.","+        let out = ensure_live_docs_coverage(extraction_of(BoolNode::Or(vec![","+            collector(1),","+            collector(2),","+        ])));","+        match out.tree.as_ref() {","+            BoolNode::Or(children) => {","+                assert_eq!(children.len(), 2);","+                assert!(children","+                    .iter()","+                    .all(|c| matches!(c, BoolNode::Collector { .. })));","+            }","+            other => panic!(\"expected unchanged Or, got {:?}\", other),","+        }","+    }","+","+    #[test]","+    fn coverage_or_with_uncovered_branch_wraps_in_and() {","+        // OR(C, P): the predicate branch re-admits deleted docs into the union, so the tree","+        // is NOT covered and the live-docs collector must be AND'ed at the root.","+        let out =","+            ensure_live_docs_coverage(extraction_of(BoolNode::Or(vec![collector(1), pred()])));","+        match out.tree.as_ref() {","+            BoolNode::And(children) => {","+                assert_eq!(children.len(), 2);","+                assert!(is_live_docs_leaf(&children[0]));","+                assert!(matches!(children[1], BoolNode::Or(_)));","+            }","+            other => panic!(\"expected And, got {:?}\", other),","+        }","+    }","+","+    #[test]","+    fn coverage_skips_and_with_covered_collector_and_not() {","+        // AND(C, NOT(C₂)): the AND is covered by C — intersecting with C's live-only bitmap","+        // masks the deleted docs that NOT(C₂) would otherwise re-admit. Tree unchanged.","+        let out = ensure_live_docs_coverage(extraction_of(BoolNode::And(vec![","+            collector(1),","+            BoolNode::Not(Box::new(collector(2))),","+        ])));","+        match out.tree.as_ref() {","+            BoolNode::And(children) => {","+                assert_eq!(children.len(), 2);","+                assert!(matches!(","+                    children[0],","+                    BoolNode::Collector { annotation_id: 1 }","+                ));","+                assert!(matches!(children[1], BoolNode::Not(_)));","+            }","+            other => panic!(\"expected unchanged And, got {:?}\", other),","+        }","+    }","+","+    #[test]","+    fn coverage_tree_class_not_over_collector_gets_top_level_and() {","+        // NOT(C) readmits deleted docs at the leaf level — the root AND with the live set","+        // is what masks them.","+        let out = ensure_live_docs_coverage(extraction_of(BoolNode::Not(Box::new(collector(4)))));","+        match out.tree.as_ref() {","+            BoolNode::And(children) => {","+                assert_eq!(children.len(), 2);","+                assert!(is_live_docs_leaf(&children[0]));","+                assert!(matches!(children[1], BoolNode::Not(_)));","+            }","+            other => panic!(\"expected And, got {:?}\", other),","+        }","+        assert_eq!(classify_filter(&out.tree), FilterClass::Tree);","+    }","+","+    #[test]","+    fn injected_live_docs_id_is_negative_and_reserved() {","+        // Coordinator annotation ids are non-negative (PlannerContext counter); the reserved","+        // id must never collide.","+        assert!(LIVE_DOCS_MATCH_ALL_ANNOTATION_ID < 0);","+    }"," }"," "," /// Instruction-based indexed execution path. Consumes a pre-configured SessionContextHandle","@@ -893,6 +1115,9 @@ async unsafe fn execute_indexed_with_context_inner(","         .indexed_config","         .as_ref()","         .is_some_and(|c| c.requests_row_ids);","+    // Per-shard hasDeletions signal from the Java ShardScan handlers; drives the live-docs","+    // Collector injection below.","+    let deleted_doc_filtering_required = handle.deleted_doc_filtering_required;","     let classification_override = handle.indexed_config.map(|config| {","         // FilterTreeShape: 1 = CONJUNCTIVE → SingleCollector, 2 = INTERLEAVED → Tree.","         match (config.tree_shape, config.delegated_predicate_count) {","@@ -999,6 +1224,14 @@ async unsafe fn execute_indexed_with_context_inner(","         ),","     };"," ","+    // On a shard with deletions, constrain the decoded tree to live docs (see","+    // ensure_live_docs_coverage). The coordinator's plan bytes are never modified.","+    let extraction = if deleted_doc_filtering_required {","+        Some(ensure_live_docs_coverage(extraction))","+    } else {","+        extraction","+    };","+","     // Resolve classification: from Java config if available, otherwise derive from tree","     let classification = match classification_override {","         Some(c) => c,"],"additions":233,"deletions":0,"truncated":false},{"path":"sandbox/plugins/analytics-backend-datafusion/rust/src/indexed_table/bool_tree.rs","lines":["@@ -104,6 +104,33 @@ impl BoolNode {","         }","     }"," ","+    /// Whether every row this tree can emit is guaranteed to pass through a","+    /// correctness `Collector`, so deleted docs are already excluded and no","+    /// synthetic live-docs Collector needs to be injected (see","+    /// `inject_live_docs_collector`). Coverage is decided over this executor's","+    /// bitmap-composition model, where the per-RG candidate universe still","+    /// contains deleted docs:","+    /// - `Collector` leaf: covered — its bitmap is live-docs-filtered on the","+    ///   Java side (`collectDocs` applies the segment's liveDocs).","+    /// - `DelegationPossible` / `Predicate` leaf: not covered — evaluated by the","+    ///   driving backend over a universe that still includes deleted docs.","+    /// - `And`: covered if ANY child is covered (intersection with a live-only","+    ///   set removes deleted docs regardless of the other operands).","+    /// - `Or`: covered only if ALL children are covered (the union re-admits","+    ///   deleted docs through any uncovered branch).","+    /// - `Not`: never covered — a `NOT` inverts against the RG universe, so a","+    ///   `NOT(Collector)` re-admits the deleted docs the collector had excluded.","+    ///   Coverage is only recovered by a covered sibling under an enclosing AND.","+    pub fn is_covered_by_live_docs(&self) -> bool {","+        match self {","+            BoolNode::Collector { .. } => true,","+            BoolNode::DelegationPossible { .. } | BoolNode::Predicate(_) => false,","+            BoolNode::And(children) => children.iter().any(|c| c.is_covered_by_live_docs()),","+            BoolNode::Or(children) => children.iter().all(|c| c.is_covered_by_live_docs()),","+            BoolNode::Not(_) => false,","+        }","+    }","+","     /// Count `DelegationPossible` (performance-delegated) leaves in the tree (DFS).","     /// Used by `classify_filter` to disqualify trees where a Performance leaf","     /// sits under OR/NOT — those need Tree-path support which isn't implemented"],"additions":27,"deletions":0,"truncated":false},{"path":"sandbox/plugins/analytics-backend-datafusion/rust/src/session_context.rs","lines":["@@ -54,6 +54,11 @@ pub struct SessionContextHandle {","     pub sort_orders: Vec<String>,","     pub query_context: QueryTrackingContext,","     pub table_name: String,","+    /// When true, the shard has deleted docs: the indexed executor ANDs a synthetic match-all","+    /// Collector leaf (reserved annotation id) into the decoded filter tree so deleted rows are","+    /// excluded via the ordinary Lucene collector machinery. Sourced from the Java per-shard","+    /// hasDeletions probe; false on shards without deletions (zero overhead).","+    pub deleted_doc_filtering_required: bool,","     /// When set, indicates this session uses the indexed execution path with filter delegation.","     pub indexed_config: Option<IndexedExecutionConfig>,","     /// Per-query tuning knobs (batch size, partitions, filter strategies, etc.)","@@ -176,6 +181,7 @@ pub async unsafe fn create_session_context(","     shard_view_ptr: i64,","     table_name: &str,","     context_id: i64,","+    deleted_doc_filtering_required: bool,","     has_partial_aggregate: bool,","     query_config: DatafusionQueryConfig,","     plan_bytes: &[u8],","@@ -421,6 +427,7 @@ pub async unsafe fn create_session_context(","         sort_orders: shard_view.sort_orders.clone(),","         query_context,","         table_name: table_name.to_string(),","+        deleted_doc_filtering_required,","         indexed_config: None,","         query_config,","         io_handle: tokio::runtime::Handle::current(),","@@ -508,6 +515,7 @@ pub async unsafe fn create_worker_session_context(","         sort_fields: Vec::new(),","         sort_orders: Vec::new(),","         table_name: String::new(),","+        deleted_doc_filtering_required: false,","         indexed_config: None,","         query_config,","         aggregate_mode: crate::agg_mod