ub.mu.Unlock()","+\t\t}","+\t}()","+","+\t// Reader: mirrors sentinelFailover.listen calling pubsub.getContext().","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tfor i := 0; i < iters; i++ {","+\t\t\t_ = pubsub.getContext()","+\t\t}","+\t}()","+","+\twg.Wait()","+}","+","+// TestPubSubReceiveTimeoutGetContextRace verifies that active execution of ReceiveTimeout","+// synchronizes c.cmd updates with concurrent getContext reads.","+func TestPubSubReceiveTimeoutGetContextRace(t *testing.T) {","+\tpubsub := &PubSub{","+\t\topt: &Options{},","+\t}","+\tpubsub.init()","+","+\tc1, c2 := net.Pipe()","+\tdefer c1.Close()","+\tdefer c2.Close()","+\tpubsub.SetNetConn(c1)","+","+\tctx, cancel := context.WithCancel(context.Background())","+\tdefer cancel()","+","+\tconst iters = 500","+","+\tvar wg sync.WaitGroup","+\twg.Add(2)","+","+\t// Writer: actively invokes ReceiveTimeout which writes c.cmd in its reader loop.","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tfor i := 0; i < iters; i++ {","+\t\t\t_, _ = pubsub.ReceiveTimeout(ctx, time.Microsecond)","+\t\t}","+\t}()","+","+\t// Reader: mirrors sentinelFailover.listen calling pubsub.getContext().","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tfor i := 0; i < iters; i++ {","+\t\t\t_ = pubsub.getContext()","+\t\t}","+\t}()","+","+\twg.Wait()","+}","+","+// TestPubSubReceiveTimeoutReusesCmdPerConn verifies that ReceiveTimeout","+// allocates c.cmd once per connection, reuses it across frames and AUTH-OK","+// retries, resets it on closeTheCn, and remains race-free with getContext.","+func TestPubSubReceiveTimeoutReusesCmdPerConn(t *testing.T) {","+\tclient := NewClient(&Options{Addr: \"127.0.0.1:1\", Protocol: 3})","+\tdefer client.Close()","+","+\tps := client.pubSub()","+\tdefer ps.Close()","+","+\tc1, c2 := net.Pipe()","+\tdefer c1.Close()","+\tdefer c2.Close()","+\tps.SetNetConn(c1)","+\tps.cn.SetResp3(true)","+","+\tdone := make(chan struct{})","+\tvar readerWG sync.WaitGroup","+\treaderWG.Add(1)","+\tgo func() {","+\t\tdefer readerWG.Done()","+\t\tfor {","+\t\t\tselect {","+\t\t\tcase <-done:","+\t\t\t\treturn","+\t\t\tdefault:","+\t\t\t\t_ = ps.getContext()","+\t\t\t}","+\t\t}","+\t}()","+\tdefer func() {","+\t\tclose(done)","+\t\treaderWG.Wait()","+\t}()","+","+\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)","+\tdefer cancel()","+","+\t// Frame 1 initializes ps.cmd once for the active connection.","+\tgo func() {","+\t\t_, _ = c2.Write([]byte(\">3\\r\\n$7\\r\\nmessage\\r\\n$2\\r\\nch\\r\\n$2\\r\\nm1\\r\\n\"))","+\t}()","+\tmsg, err := ps.ReceiveTimeout(ctx, time.Second)","+\tif err != nil {","+\t\tt.Fatalf(\"first ReceiveTimeout failed: %v\", err)","+\t}","+\tm, ok := msg.(*Message)","+\tif !ok || m.Payload != \"m1\" {","+\t\tt.Fatalf(\"unexpected first message: %#v\", msg)","+\t}","+","+\tps.mu.Lock()","+\tfirstCmd := ps.cmd","+\tps.mu.Unlock()","+\tif firstCmd == nil {","+\t\tt.Fatal(\"expected ps.cmd to be initialized after first ReceiveTimeout\")","+\t}","+","+\t// Frame 2 + AUTH-OK internal retry reuse the exact same *Cmd instance.","+\tps.mu.Lock()","+\tps.authPending++","+\tps.mu.Unlock()","+","+\tgo func() {","+\t\t_, _ = c2.Write([]byte(\"+OK\\r\\n\"))","+\t\t_, _ = c2.Write([]byte(\">3\\r\\n$7\\r\\nmessage\\r\\n$2\\r\\nch\\r\\n$2\\r\\nm2\\r\\n\"))","+\t}()","+\tmsg, err = ps.ReceiveTimeout(ctx, time.Second)","+\tif err != nil {","+\t\tt.Fatalf(\"second ReceiveTimeout failed: %v\", err)","+\t}","+\tm, ok = msg.(*Message)","+\tif !ok || m.Payload != \"m2\" {","+\t\tt.Fatalf(\"unexpected second message: %#v\", msg)","+\t}","+","+\tps.mu.Lock()","+\treusedCmd := ps.cmd","+\tauthPending := ps.authPending","+\tps.mu.Unlock()","+\tif reusedCmd != firstCmd {","+\t\tt.Fatalf(\"expected ps.cmd pointer reuse (%p), got %p\", firstCmd, reusedCmd)","+\t}","+\tif authPending != 0 {","+\t\tt.Fatalf(\"expected authPending decremented to 0, got %d\", authPending)","+\t}","+","+\t// Closing the connection resets ps.cmd so a new connection allocates cleanly.","+\tps.