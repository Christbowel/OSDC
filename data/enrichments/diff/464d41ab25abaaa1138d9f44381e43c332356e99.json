+\t\t\treturn","+\t\t}","+\t\tline = strings.TrimRight(line, \"\\r\\n\")","+\t\tif !strings.HasPrefix(line, \"*\") {","+\t\t\tcontinue","+\t\t}","+\t\tn, err := strconv.Atoi(strings.TrimPrefix(line, \"*\"))","+\t\tif err != nil || n <= 0 {","+\t\t\tcontinue","+\t\t}","+","+\t\targs := make([]string, n)","+\t\tfor i := 0; i < n; i++ {","+\t\t\tlenLine, err := rd.ReadString('\\n')","+\t\t\tif err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\targLen, _ := strconv.Atoi(strings.TrimSpace(strings.TrimPrefix(lenLine, \"$\")))","+\t\t\targBuf := make([]byte, argLen+2)","+\t\t\tif _, err := io.ReadFull(rd, argBuf); err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\targs[i] = string(argBuf[:argLen])","+\t\t}","+","+\t\tcmdName := strings.ToUpper(args[0])","+","+\t\ts.mu.Lock()","+\t\ts.commands = append(s.commands, args)","+\t\tauthErr := s.authErr","+\t\thelloErr := s.helloErr","+\t\ts.mu.Unlock()","+","+\t\tswitch cmdName {","+\t\tcase \"HELLO\":","+\t\t\tif helloErr != nil {","+\t\t\t\t_, _ = c.Write([]byte(fmt.Sprintf(\"-ERR %s\\r\\n\", helloErr.Error())))","+\t\t\t} else {","+\t\t\t\t_, _ = c.Write([]byte(\"%2\\r\\n+server\\r\\n+redis\\r\\n+proto\\r\\n:3\\r\\n\"))","+\t\t\t}","+\t\tcase \"CLIENT\":","+\t\t\t_, _ = c.Write([]byte(\"+OK\\r\\n\"))","+\t\tcase \"SUBSCRIBE\":","+\t\t\tchannel := \"channel\"","+\t\t\tif len(args) > 1 {","+\t\t\t\tchannel = args[1]","+\t\t\t}","+\t\t\tprefix := \">3\"","+\t\t\tif helloErr != nil {","+\t\t\t\tprefix = \"*3\"","+\t\t\t}","+\t\t\tresp := fmt.Sprintf(\"%s\\r\\n$9\\r\\nsubscribe\\r\\n$%d\\r\\n%s\\r\\n:1\\r\\n\", prefix, len(channel), channel)","+\t\t\t_, _ = c.Write([]byte(resp))","+\t\t\tselect {","+\t\t\tcase s.subscribed <- struct{}{}:","+\t\t\tdefault:","+\t\t\t}","+\t\tcase \"AUTH\":","+\t\t\tif authErr != nil {","+\t\t\t\t_, _ = c.Write([]byte(fmt.Sprintf(\"-WRONGPASS %s\\r\\n\", authErr.Error())))","+\t\t\t} else {","+\t\t\t\t_, _ = c.Write([]byte(\"+OK\\r\\n\"))","+\t\t\t}","+\t\tcase \"PING\":","+\t\t\t_, _ = c.Write([]byte(\"+PONG\\r\\n\"))","+\t\tdefault:","+\t\t\t_, _ = c.Write([]byte(\"+OK\\r\\n\"))","+\t\t}","+\t}","+}","+","+func (s *mockRESP3Server) Publish(channel, payload string) {","+\ts.mu.Lock()","+\tdefer s.mu.Unlock()","+\tprefix := \">3\"","+\tif s.helloErr != nil {","+\t\tprefix = \"*3\"","+\t}","+\tresp := fmt.Sprintf(\"%s\\r\\n$7\\r\\nmessage\\r\\n$%d\\r\\n%s\\r\\n$%d\\r\\n%s\\r\\n\",","+\t\tprefix, len(channel), channel, len(payload), payload)","+\tfor _, c := range s.conns {","+\t\t_, _ = c.Write([]byte(resp))","+\t}","+}","+","+func (s *mockRESP3Server) HasCommand(name string, matchArg string) bool {","+\ts.mu.Lock()","+\tdefer s.mu.Unlock()","+\tfor _, cmd := range s.commands {","+\t\tif strings.EqualFold(cmd[0], name) {","+\t\t\tif matchArg == \"\" {","+\t\t\t\treturn true","+\t\t\t}","+\t\t\tfor _, arg := range cmd[1:] {","+\t\t\t\tif strings.Contains(arg, matchArg) {","+\t\t\t\t\treturn true","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+\treturn false","+}","+","+func TestPubSubRESP3StreamingCredsActiveReader(t *testing.T) {","+\tsrv := newMockRESP3Server(t)","+\tdefer srv.Close()","+","+\tprovider := newTestStreamingProvider(\"init_user\", \"init_pass\")","+\tclient := redis.NewClient(&redis.Options{","+\t\tAddr:                         srv.ln.Addr().String(),","+\t\tProtocol:                     3,","+\t\tStreamingCredentialsProvider: provider,","+\t\tPoolSize:                     1,","+\t\tReadTimeout:                  3 * time.Second,","+\t\tWriteTimeout:                 3 * time.Second,","+\t\tDisableIdentity:              true,","+\t\tMaintNotificationsConfig: &maintnotifications.Config{","+\t\t\tMode: maintnotifications.ModeDisabled,","+\t\t},","+\t})","+\tdefer client.Close()","+","+\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)","+\tdefer cancel()","+","+\tps := client.Subscribe(ctx, \"alerts\")","+\tdefer ps.Close()","+","+\t// Wait for subscription confirmation","+\tmsg, err := ps.Receive(ctx)","+\tif err != nil {","+\t\tt.F