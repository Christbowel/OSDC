{"id":"GHSA-p6wj-qrr4-pgh5","axis":"advisories","repo":"getkin/kin-openapi","sha":"30e292371a89ca6d1f91a9553e0aa518b49f838d","parsed":{"files":[{"path":"openapi3filter/array_items_nil_panic_test.go","lines":["@@ -0,0 +1,178 @@","+package openapi3filter_test","+","+import (","+\t\"bytes\"","+\t\"context\"","+\t\"io\"","+\t\"mime/multipart\"","+\t\"net/http\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/getkin/kin-openapi/openapi3\"","+\t\"github.com/getkin/kin-openapi/openapi3filter\"","+\t\"github.com/getkin/kin-openapi/routers/gorillamux\"","+)","+","+// These tests cover the fix for a nil-pointer panic: an OpenAPI 3.1 document","+// may legally declare `type: array` without `items`, which passes","+// doc.Validate() with Schema.Items == nil. Several openapi3filter decoders","+// used to dereference Items with no nil check, panicking on any request that","+// reached the affected operation. The decoders must instead return a clean","+// error.","+","+const urlencodedArrayNoItemsSpec31 = `","+openapi: 3.1.0","+info: {title: t, version: 1.0.0}","+paths:","+  /f:","+    post:","+      requestBody:","+        required: true","+        content:","+          application/x-www-form-urlencoded:","+            schema:","+              type: object","+              properties:","+                tags: {type: array}","+      responses:","+        '200': {description: ok}","+`","+","+const multipartArrayNoItemsSpec31 = `","+openapi: 3.1.0","+info: {title: t, version: 1.0.0}","+paths:","+  /upload:","+    post:","+      requestBody:","+        required: true","+        content:","+          multipart/form-data:","+            schema:","+              type: object","+              properties:","+                tags: {type: array}","+      responses:","+        '200': {description: ok}","+`","+","+const responseHeaderArrayNoItemsSpec31 = `","+openapi: 3.1.0","+info: {title: t, version: 1.0.0}","+paths:","+  /hdr:","+    get:","+      responses:","+        '200':","+          description: ok","+          headers:","+            X-Tags:","+              schema: {type: array}","+`","+","+func catchPanicValue(fn func()) (panicValue any) {","+\tdefer func() { panicValue = recover() }()","+\tfn()","+\treturn nil","+}","+","+// The 3.1 schema without items must still be accepted by Validate (spec-legal","+// under JSON Schema 2020-12), leaving Items == nil.","+func TestArrayItemsNil_OpenAPI31Accepts(t *testing.T) {","+\tloader := openapi3.NewLoader()","+\tdoc, err := loader.LoadFromData([]byte(urlencodedArrayNoItemsSpec31))","+\trequire.NoError(t, err)","+\trequire.NoError(t, doc.Validate(loader.Context))","+\tschema := doc.Paths.Value(\"/f\").Post.RequestBody.Value.Content.","+\t\tGet(\"application/x-www-form-urlencoded\").Schema.Value.Properties[\"tags\"].Value","+\trequire.True(t, schema.Type.Is(\"array\"))","+\trequire.Nil(t, schema.Items)","+}","+","+func TestArrayItemsNil_UrlencodedNoPanic(t *testing.T) {","+\tloader := openapi3.NewLoader()","+\tdoc, err := loader.LoadFromData([]byte(urlencodedArrayNoItemsSpec31))","+\trequire.NoError(t, err)","+\trequire.NoError(t, doc.Validate(loader.Context))","+\trouter, err := gorillamux.NewRouter(doc)","+\trequire.NoError(t, err)","+","+\treq, err := http.NewRequest(http.MethodPost, \"/f\", strings.NewReader(\"tags=a\"))","+\trequire.NoError(t, err)","+\treq.Header.Set(\"Content-Type\", \"application/x-www-form-urlencoded\")","+\troute, pathParams, err := router.FindRoute(req)","+\trequire.NoError(t, err)","+","+\tvar reqErr error","+\tpanicVal := catchPanicValue(func() {","+\t\treqErr = openapi3filter.ValidateRequest(context.Background(), &openapi3filter.RequestValidationInput{","+\t\t\tRequest: req, PathParams: pathParams, Route: route,","+\t\t\tOptions: &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc},","+\t\t})","+\t})","+\trequire.Nil(t, panicVal, \"must not panic\")","+\trequire.Error(t, reqErr, \"must return a clean error\")","+\trequire.Contains(t, reqErr.Error(), \"array items required\")","+}","+","+func TestArrayItemsNil_MultipartNoPanic(t *testing.T) {","+\tloader := openapi3.NewLoader()","+\tdoc, err := loader.LoadFromData([]byte(multipartArrayNoItemsSpec31))","+\trequire.NoError(t, err)","+\trequire.NoError(t, doc.Validate(loader.Context))","+\trouter, err := gorillamux.NewRouter(doc)","+\trequire.NoError(t, err)","+","+\tvar buf bytes.Buffer","+\tw := multipart.NewWriter(&buf)","+\trequire.NoError(t, w.WriteField(\"tags\", \"a\"))","+\trequire.NoError(t, w.Close())","+","+\treq, err := http.NewRequest(http.MethodPost, \"/upload\", &buf)","+\trequire.NoError(t, err)","+\treq.Header.Set(\"Content-Type\", w.FormDataContentType())","+\troute, pathParams, err := router.FindRoute(req)","+\trequire.NoError(t, err)","+","+\tvar reqErr error","+\tpanicVal := catchPanicValue(func() {","+\t\treqErr = openapi3filter.ValidateRequest(context.Background(), &openapi3filter.RequestValidationInput{","+\t\t\tRequest: req, PathParams: pathParams, Route: route,","+\t\t\tOptions: &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc},","+\t\t})","+\t})","+\trequire.Nil(t, panicVal, \"must not panic\")","+\trequire.Error(t, reqErr, \"must return a clean error\")","+}","+","+func TestArrayItemsNil_ResponseHeaderNoPanic(t *testing.T) {","+\tloader := openapi3.NewLoader()","+\tdoc, err := loader.LoadFromData([]byte(responseHeaderArrayNoItemsSpec31))","+\trequire.NoError(t, err)","+\trequire.NoError(t, doc.Validate(loader.Context))","+\trouter, err := gorillamux.NewRouter(doc)","+\trequire.NoError(t, err)","+","+\treq, err := http.NewRequest(http.MethodGet, \"/hdr\", nil)","+\trequire.NoError(t, err)","+\troute, pathParams, err := router.FindRoute(req)","+\trequire.NoError(t, err)","+","+\tvar respErr error","+\tpanicVal := catchPanicValue(func() {","+\t\trespErr = openapi3filter.ValidateResponse(context.Background(), &openapi3filter.ResponseValidationInput{","+\t\t\tRequestValidationInput: &openapi3filter.RequestValidationInput{","+\t\t\t\tRequest: req, PathParams: pathParams, Route: route,","+\t\t\t\tOptions: &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc},","+\t\t\t},","+\t\t\tStatus: http.StatusOK,","+\t\t\tHeader: http.Header{\"X-Tags\": []string{\"a,b\"}},","+\t\t\tBody:   io.NopCloser(strings.NewReader(\"\")),","+\t\t})","+\t})","+\trequire.Nil(t, panicVal, \"must not panic\")","+\trequire.Error(t, respErr, \"must return a clean error\")","+}"],"additions":178,"deletions":0,"truncated":false},{"path":"openapi3filter/req_resp_decoder.go","lines":["@@ -1124,6 +1124,9 @@ func pathFromKeys(kk []string) []any {"," // Every item is parsed as a primitive value."," // The function returns an error when an error happened while parse array's items."," func parseArray(raw []string, schemaRef *openapi3.SchemaRef) ([]any, error) {","+\tif schemaRef.Value.Items == nil || schemaRef.Value.Items.Value == nil {","+\t\treturn nil, fmt.Errorf(\"array items schema is required for decoding\")","+\t}"," \tvar value []any"," \tfor i, v := range raw {"," \t\titem, err := parsePrimitive(v, schemaRef.Value.Items)","@@ -1418,6 +1421,9 @@ func UrlencodedBodyDecoder(body io.Reader, header http.Header, schema *openapi3."," \t\tcase propType.Is(\"object\"):"," \t\t\treturn nil, fmt.Errorf(\"unsupported schema of request body's property %q\", propName)"," \t\tcase propType.Is(\"array\"):","+\t\t\tif propSchema.Value.Items == nil || propSchema.Value.Items.Value == nil {","+\t\t\t\treturn nil, fmt.Errorf(\"unsupported schema of request body's property %q: array items required\", propName)","+\t\t\t}"," \t\t\titems := propSchema.Value.Items.Value"," \t\t\tif !(items.Type.Is(\"string\") || items.Type.Is(\"integer\") || items.Type.Is(\"number\") || items.Type.Is(\"boolean\")) {"," \t\t\t\treturn nil, fmt.Errorf(\"unsupported schema of request body's property %q\", propName)","@@ -1561,6 +1567,9 @@ func Multipar