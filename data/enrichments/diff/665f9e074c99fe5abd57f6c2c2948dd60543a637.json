uestion{","+\t\t\tType: question.Type, Instructions: field.Description, Options: field.options,","+\t\t}})","+\t}","+\treturn nil","+}","+","+func kevField(name string, question Question) (compiledField, error) {","+\tfield := compiledField{Field: Field{Name: name}, typ: question.Type}","+\tif strings.TrimSpace(name) == \"\" {","+\t\treturn field, fmt.Errorf(\"field name must not be empty\")","+\t}","+\tif len(question.Instructions) != 0 {","+\t\tvar err error","+\t\tfield.Description, err = kevContent(question.Instructions)","+\t\tif err != nil {","+\t\t\treturn field, fmt.Errorf(\"instructions: %w\", err)","+\t\t}","+\t}","+\tadd := func(value any, description, option string) {","+\t\tfield.Choices = append(field.Choices, Choice{Value: value, Description: description})","+\t\tfield.options = append(field.options, option)","+\t}","+\tswitch question.Type {","+\tcase \"noul\":","+\t\tcriteria := orderedmap.New[string, json.RawMessage]()","+\t\tif len(question.Criteria) > 0 && string(question.Criteria) != \"null\" {","+\t\t\tif err := json.Unmarshal(question.Criteria, criteria); err != nil {","+\t\t\t\treturn field, fmt.Errorf(\"noul criteria must be an object\")","+\t\t\t}","+\t\t}","+\t\tfor _, item := range []struct {","+\t\t\tkey   string","+\t\t\tlabel string","+\t\t\tvalue bool","+\t\t}{{\"false\", \"no\", false}, {\"true\", \"yes\", true}} {","+\t\t\tdescription := \"\"","+\t\t\tif raw, ok := criteria.Get(item.key); ok {","+\t\t\t\tvar err error","+\t\t\t\tdescription, err = kevContent(raw)","+\t\t\t\tif err != nil {","+\t\t\t\t\treturn field, err","+\t\t\t\t}","+\t\t\t}","+\t\t\toption := item.label","+\t\t\tif description != \"\" {","+\t\t\t\toption += \": \" + description","+\t\t\t}","+\t\t\tadd(item.value, description, option)","+\t\t}","+\t\tfor key := range criteria.All() {","+\t\t\tif key != \"false\" && key != \"true\" {","+\t\t\t\treturn field, fmt.Errorf(\"unknown noul criterion %q\", key)","+\t\t\t}","+\t\t}","+\tcase \"choice\":","+\t\tcriteria := orderedmap.New[string, json.RawMessage]()","+\t\tif err := json.Unmarshal(question.Criteria, criteria); err != nil {","+\t\t\treturn field, fmt.Errorf(\"choice criteria must be an object\")","+\t\t}","+\t\tfor key, raw := range criteria.All() {","+\t\t\tif strings.TrimSpace(key) == \"\" {","+\t\t\t\treturn field, fmt.Errorf(\"choice keys must not be empty\")","+\t\t\t}","+\t\t\tdescription, err := kevContent(raw)","+\t\t\tif err != nil {","+\t\t\t\treturn field, err","+\t\t\t}","+\t\t\toption := key","+\t\t\tif description != \"\" {","+\t\t\t\toption += \": \" + description","+\t\t\t}","+\t\t\tadd(key, description, option)","+\t\t}","+\tcase \"score\":","+\t\tvar criteria []json.RawMessage","+\t\tif err := json.Unmarshal(question.Criteria, &criteria); err != nil {","+\t\t\treturn field, fmt.Errorf(\"score criteria must be an array\")","+\t\t}","+\t\tfor index, raw := range criteria {","+\t\t\ttext, err := kevContent(raw)","+\t\t\tif err != nil {","+\t\t\t\treturn field, err","+\t\t\t}","+\t\t\tadd(strconv.Itoa(index), text, text)","+\t\t}","+\tdefault:","+\t\treturn field, fmt.Errorf(\"type must be choice, noul, or score\")","+\t}","+\tif len(field.options) < 1 || len(field.options) > 255 || (question.Type == \"noul\" && len(field.options) != 2) {","+\t\treturn field, fmt.Errorf(\"criteria must contain 1–255 options\")","+\t}","+\treturn field, nil","+}","+","+// kevContent renders JSON values as the labels and indented lines seen during","+// Kev training. A streaming decoder preserves object key order.","+func kevContent(raw json.RawMessage) (string, error) {","+\tif len(raw) == 0 {","+\t\treturn \"\", nil","+\t}","+\tif !json.Valid(raw) {","+\t\treturn \"\", fmt.Errorf(\"invalid JSON value\")","+\t}","+\tdec := json.NewDecoder(bytes.NewReader(raw))","+\tdec.UseNumber()","+\tvalue, _, err := kevValue(dec, 0)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\tif _, err = dec.Token(); err != io.EOF {","+\t\treturn \"\", fmt.Errorf(\"extra JSON input\")","+\t}","+\treturn value, nil","+}","+","+func kevValue(dec *json.Decoder, depth int) (string, bool, error) {","+\tif depth > 64 {","+\t\treturn \"\", false, fmt.Errorf(\"content nesting exceeds 64 levels\")","+\t}","+\ttoken, err := dec.Token()","+\tif err != nil {","+\t\treturn \"\", false, err","+\t}","+\tdelim, ok := token.(json.Delim)","+\tif !ok {","+\t\treturn kevScalar(token), false, nil","+\t}","+\tpad := strings.Repeat(\"  \", depth)","+\tvar lines []string","+\tswitch delim {","+\tcase '{':","+\t\tfor dec.More() {","+\t\t\tkey, err := dec.Token()","+\t\t\tif err != nil {","+\t\t\t\treturn \"\", false, err","+\t\t\t}","+\t\t\tvalue, nested, err := kevValue(dec, depth+1)","+\t\t\tif err != nil {","+\t\t\t\treturn \"\", false, err","+\t\t\t}","+\t\t\tseparator := \": \"","+\t\t\tif nested {","+\t\t\t\tseparator = \":\\n\"","+\t\t\t}","+\t\t\tlines = append(lines, pad+key.(string)+separator+value)","+\t\t}","+\tcase '[':","+\t\tfor dec.More() {","+\t\t\tvalue, _, err := kevValue(dec, depth+1)","+\t\t\tif err != nil {","+\t\t\t\treturn \"\", false, err","+\t\t\t}","+\t\t\tlines = append(lines, pad+\"- \"+strings.TrimLeftFunc(value, unicode.IsSpace))","+\t\t}","+\tdefault:","+\t\treturn \"\", false, fmt.Errorf(\"unexpected JSON delimiter %q\", delim)","+\t}","+\tif _, err := dec.Token(); err != nil {","+\t\treturn \"\", false, err","+\t}","+\treturn strings.Join(lines, \"\\n\"), true, nil","+}","+","+func kevScalar(value any) string {","+\tswitch v := value.(type) {","+\tcase nil:","+\t\treturn \"\"","+\tcase bool:","+\t\tif v {","+\t\t\treturn \"True\"","+\t\t}","+\t\treturn \"False\"","+\tcase string:","+\t\treturn v","+\tcase json.Number:","+\t\tif !strings.ContainsAny(string(v), \".eE\") {","+\t\t\treturn string(v)","+\t\t}","+\t\tf, err := strconv.ParseFloat(string(v), 64)","+\t\tif err != nil {","+\t\t\treturn string(v)","+\t\t}","+\t\tif f == 0 || math.Abs(f) >= 1e-4 && math.Abs(f) < 1e16 {","+\t\t\tout := strconv.FormatFloat(f, 'f', -1, 64)","+\t\t\tif !strings.Contains(out, \".\") {","+\t\t\t\tout += \".0\"","+\t\t\t}","+\t\t\treturn out","+\t\t}","+\t\treturn strconv.FormatFloat(f, 'e', -1, 64)","+\tdefault:","+\t\treturn fmt.Sprint(v)","+\t}","+}","+","+func roundKev(value float64) float64 { return math.RoundToEven(value*1e4) / 1e4 }","+","+func kevConfidence(probabilities []float64, kind string) float64 {","+\tif len(probabilities) == 1 {","+\t\treturn 1","+\t}","+\tmode := 0","+\tfor i := 1; i < len(probabilities); i++ {","+\t\tif probabilities[i] > probabilities[mode] {","+\t\t\tmode = i","+\t\t}","+\t}","+\tif kind == \"choice\" {","+\t\tuniform := 1 / float64(len(probabilities))","+\t\treturn (probabilities[mode] - uniform) / (1 - uniform)","+\t}","+\tcenter := float64(len(probabilities)-1) / 2","+\tvar spread, deviation float64","+\tfor i, p := range probabilities {","+\t\tspread += p * math.Abs(float64(i-mode))","+\t\tdeviation += math.Abs(float64(i) - center)","+\t}","+\treturn max(0, 1-spread/(deviation/float64(len(probabilities))))","+}"],"additions":261,"deletions":0,"truncated":false},{"path":"decision/kev_test.go","lines":["@@ -0,0 +1,123 @@","+package decision","+","+import (","+\t\"encoding/json\"","+\t\"fmt\"","+\t\"math\"","+\t\"slices\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/ollama/ollama/api\"","+\t\"github.com/ollama/ollama/llm\"","+)","+","+func TestKevRequestAndAnswers(t *testing.T) {","+\tvar req Request","+\tinput := `{\"model\":\"kev:test\",\"state\":{\"subject\":\"Charged twice\",\"details\":[\"café\",{\"count\":1e6,\"urgent\":true}]},\"questions\":{\"team\":{\"type\":\"choice\",\"instructions\":{\"goal\":\"Pick a team\"},\"criteria\":{\"billing\":\"Payments\",\"shipping\":null}},\"urgent\":{\"type\":\"noul\",\"instructions\":\"Urgent?\",\"criteria\":{\"true\":\"escalate\"}},\"level\":{\"type\":\"score\",\"instructions\":\"How urgent?\",\"criteria\":[\"low\",null,{\"high\":true}]}}}`","+\tif err := json.Unmarshal([]byte(input), &req); err != nil {","+\t\tt.Fatal(err)","+\t}",