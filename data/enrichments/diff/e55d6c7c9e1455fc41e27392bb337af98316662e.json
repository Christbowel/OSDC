{"id":"e55d6c7c9e1455fc41e27392bb337af98316662e","axis":"silent","repo":"pnpm/pnpm","sha":"e55d6c7c9e1455fc41e27392bb337af98316662e","parsed":{"files":[{"path":".changeset/repeat-install-readpackage-project-specifier.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pacquet\": patch","+---","+","+A repeat `pnpm install` reports \"Already up to date\" again when a pnpmfile `readPackage` hook changes the dependencies of a workspace project. Since 12.15.0, every such install ran in full [#17468](https://github.com/pnpm/pnpm/issues/17468).","+","+After an edit to a project's `package.json`, `pnpm install` and `verifyDepsBeforeRun` now run the pnpmfile's `readPackage` hook on the edited manifest before comparing it with the lockfile. They could report the project up to date when the hook rewrote the edited dependency to a specifier the lockfile did not record."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_oracle.rs","lines":["@@ -964,6 +964,58 @@ fn a_pnpmfile_hook_edited(layout: Layout) {","     scenario.check_gates_after_a_workspace_input_edit();"," }"," ","+/// A `readPackage` hook that rewrites a workspace project's own specifier of","+/// `a`. It maps `workspace:*` too, so a manifest can declare the specifier the","+/// lockfile records while the hook resolves another one.","+const PNPMFILE_REWRITING_A_PROJECT_SPECIFIER: &str =","+    \"module.exports = { hooks: { readPackage (pkg) {","+  const rewritten = { '*': 'workspace:*', 'workspace:*': 'workspace:^' }[pkg.dependencies?.a]","+  if (rewritten) pkg.dependencies.a = rewritten","+  return pkg","+} } }","+\";","+","+/// A `readPackage` hook that rewrites `c`'s specifier of its sibling `a`, then","+/// edits to that specifier, then an edit to `c` that leaves its dependencies","+/// alone.","+fn a_pnpmfile_hook_rewriting_a_project_specifier(layout: Layout) {","+    let mut scenario = Scenario::new(layout);","+    scenario.install(&[]);","+    fs::write(scenario.workspace().join(\".pnpmfile.cjs\"), PNPMFILE_REWRITING_A_PROJECT_SPECIFIER)","+        .expect(\"write the pnpmfile\");","+    scenario.check_gates_after_a_workspace_input_edit();","+    let dependencies = |specifier| json!({ \"a\": specifier, \"@pnpm.e2e/bar\": \"100.0.0\" });","+    for specifier in [\"*\", \"workspace:*\"] {","+        scenario.set_dependencies(\"c\", &dependencies(specifier));","+        scenario.check_gates();","+    }","+    scenario.write_manifest(","+        \"c\",","+        json!({ \"description\": \"edited\", \"dependencies\": dependencies(\"workspace:*\") }),","+    );","+    scenario.check_gates();","+}","+","+/// A `packageExtensions` entry that adds a dependency to the workspace project","+/// `c`, then an edit to `c` that leaves its dependencies alone.","+fn a_package_extension_of_a_project_then_an_edit(layout: Layout) {","+    let mut scenario = Scenario::new(layout);","+    scenario.install(&[]);","+    scenario.set_workspace_setting(","+        \"packageExtensions\",","+        Some(\"{ c: { dependencies: { '@pnpm.e2e/foo': '100.0.0' } } }\"),","+    );","+    scenario.check_gates_after_a_workspace_input_edit();","+    scenario.write_manifest(","+        \"c\",","+        json!({","+            \"description\": \"edited\",","+            \"dependencies\": { \"a\": \"workspace:*\", \"@pnpm.e2e/bar\": \"100.0.0\" },","+        }),","+    );","+    scenario.check_gates();","+}","+"," /// `patchedDependencies` added, its patch file edited, and the entry removed."," fn a_patch_added_edited_and_removed(layout: Layout) {","     let mut scenario = Scenario::new(layout);","@@ -1108,6 +1160,8 @@ macro_rules! matrix {","                     a_workspace_without_a_root_manifest,","                     overrides_edited,","                     a_pnpmfile_hook_edited,","+                    a_pnpmfile_hook_rewriting_a_project_specifier,","+                    a_package_extension_of_a_project_then_an_edit,","                     a_patch_added_edited_and_removed,","                     dedupe_peers_toggled,","                     a_workspace_bin_renamed,"],"additions":54,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install.rs","lines":["@@ -17,6 +17,7 @@ pub(crate) use modules_state::{","     frozen_tree_intact, hoisted_linker_workspace_links_intact, hoisted_workspace_packages_present,","     modules_layout_consistent_with, moved_tree_is_reusable, tree_may_move,"," };","+pub(crate) use run::hook_one_manifest;"," pub use run::{InstallExecution, InstallLockfilePolicy, ResolutionInputs};"," pub(crate) use workspace_state::{","     CarriedSettings, StateProjects, StateWrite, configured_or_discovered_workspace_dir,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization.rs","lines":["@@ -265,7 +265,7 @@ fn peer_report_workspace<'a>(","     crate::peer_dependency_issues::PeerReportWorkspace {","         lockfile_dir: &inputs.projects.workspace_root,","         catalogs: inputs.completion.catalog_context_present.then_some(&inputs.completion.catalogs),","-        project_manifests: inputs.projects.importers.declared_manifests,","+        project_manifests: inputs.projects.importers.declared_manifests.as_slice(),","     }"," }"," ","@@ -314,7 +314,7 @@ fn finish_apply<Reporter: self::Reporter>(","             catalogs: peer_catalogs,","             workspace_root: &inputs.projects.workspace_root,","             workspace_manifest_dir: &inputs.completion.workspace_manifest_dir,","-            project_manifests: inputs.projects.importers.declared_manifests,","+            project_manifests: inputs.projects.importers.declared_manifests.as_slice(),","         },"," ","         prefix: inputs.completion.prefix,","@@ -382,7 +382,7 @@ fn write_applied_workspace_state<Reporter: self::Reporter>(","         },","         catalogs: &inputs.completion.catalogs,","         projects: crate::install::StateProjects {","-            manifests: inputs.