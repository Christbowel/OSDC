{"id":"ad48b838fffcf1538107b60209eeee6f1dc25589","axis":"silent","repo":"mongodb/mongo","sha":"ad48b838fffcf1538107b60209eeee6f1dc25589","parsed":{"files":[{"path":"jstests/auth/after_op_time_requires_internal.js","lines":["@@ -0,0 +1,331 @@","+/**","+ * Tests that readConcern.afterOpTime is only accepted from clients that hold ActionType::internal,","+ * on both mongod and mongos, and that the same commands without afterOpTime are unaffected.","+ *","+ * The authorization failure is rewrapped as \"not authorized on <db> to execute command <cmd>\", so","+ * rather than matching the error message, each rejected command is paired with a control that runs","+ * the same command without afterOpTime and must succeed for the same user.","+ *","+ * The 'allowDeprecatedAfterOpTimeReadConcern' server parameter drops the restriction entirely.","+ * Those tests flip it on at runtime, check that the commands that were rejected are then accepted,","+ * and flip it back off.","+ *","+ * @tags: [requires_sharding]","+ */","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+import {ShardingTest} from \"jstests/libs/shardingtest.js\";","+","+const kPwd = \"pwd\";","+const kDbName = \"after_op_time_requires_internal\";","+const kCollName = \"coll\";","+const kRootUser = \"rootUser\";","+const kInternalUser = \"internalUser\";","+","+const withTopLevelReadConcern = (cmd, readConcern) => ({...cmd, readConcern});","+","+// 'ping' and 'hello' need no privileges of their own. 'withReadConcern' builds the variant of 'cmd'","+// that carries the read concern; by default it is a top-level generic argument.","+const kCommands = [","+    {name: \"find\", dbName: kDbName, cmd: {find: kCollName, filter: {}}},","+    {name: \"aggregate\", dbName: kDbName, cmd: {aggregate: kCollName, pipeline: [], cursor: {}}},","+    {","+        name: \"insert\",","+        dbName: kDbName,","+        cmd: {insert: kCollName, documents: [{_id: \"afterOpTimeProbe\"}]},","+        // The rejected variant never executes, so it can reuse the control's document. When the","+        // argument is accepted the insert does execute, so it needs an _id of its own.","+        cmdIfAccepted: (cmd, readConcern) => ({","+            ...cmd,","+            documents: [{_id: \"afterOpTimeProbeAccepted\"}],","+            readConcern,","+        }),","+    },","+    {name: \"ping\", dbName: \"admin\", cmd: {ping: 1}},","+    {name: \"hello\", dbName: \"admin\", cmd: {hello: 1}},","+    {","+        name: \"explain with outer readConcern\",","+        dbName: kDbName,","+        cmd: {explain: {find: kCollName, filter: {}}, verbosity: \"queryPlanner\"},","+    },","+    {","+        // The nested command is authorized recursively, so its own readConcern must be checked.","+        name: \"explain with inner readConcern\",","+        dbName: kDbName,","+        cmd: {explain: {find: kCollName, filter: {}}, verbosity: \"queryPlanner\"},","+        withReadConcern: (cmd, readConcern) => ({","+            ...cmd,","+            explain: {...cmd.explain, readConcern},","+        }),","+    },","+];","+","+function createUsers(adminDB) {","+    assert.commandWorked(adminDB.runCommand({createUser: kRootUser, pwd: kPwd, roles: [\"root\"]}));","+    assert(adminDB.auth(kRootUser, kPwd));","+    assert.commandWorked(","+        adminDB.runCommand({createUser: kInternalUser, pwd: kPwd, roles: [\"__system\"]}),","+    );","+    adminDB.logout();","+}","+","+function connectAs(host, user) {","+    const conn = new Mongo(host);","+    if (user) {","+        assert(conn.getDB(\"admin\").auth(user, kPwd), `failed to authenticate as ${user}`);","+    }","+    return conn;","+}","+","+function assertAfterOpTimeRejected(conn, afterOpTime) {","+    for (const {name, dbName, cmd, withReadConcern = withTopLevelReadConcern} of kCommands) {","+        const testDB = conn.getDB(dbName);","+","+        assert.commandWorked(testDB.runCommand(cmd), `control failed for ${name}`);","+        assert.commandFailedWithCode(","+            testDB.runCommand(withReadConcern(cmd, {afterOpTime})),","+            ErrorCodes.Unauthorized,","+            `afterOpTime should have been rejected for ${name}`,","+        );","+    }","+}","+","+function assertUnauthenticatedPingRejected(host, afterOpTime) {","+    const adminDB = connectAs(host).getDB(\"admin\");","+    assert.commandWorked(adminDB.runCommand({ping: 1}));","+    assert.commandFailedWithCode(","+        adminDB.runCommand({ping: 1, readConcern: {afterOpTime}}),","+        ErrorCodes.Unauthorized,","+    );","+}","+","+// When the 'allowDeprecatedAfterOpTimeReadConcern' escape hatch is on, every client is treated as","+// if it held ActionType::internal, so the commands that 'assertAfterOpTimeRejected' rejects must","+// now succeed. There is no control to compare against here: the failure of the same command","+// without afterOpTime is already covered above.","+function assertAfterOpTimeAccepted(conn, afterOpTime) {","+    for (const {name, dbName, cmd, cmdIfAccepted = withTopLevelReadConcern} of kCommands) {","+        assert.commandWorked(","+            conn.getDB(dbName).runCommand(cmdIfAccepted(cmd, {afterOpTime})),","+            `afterOpTime should have been accepted for ${name}`,","+        );","+    }","+}","+","+// Flips the escape hatch. It is settable at runtime, so the tests below enable it, check the","+// behavior it is meant to change, and then disable it again.","+function setAllowDeprecatedAfterOpTimeReadConcern(conn, enabled) {","+    assert.commandWorked(","+        conn.getDB(\"admin\").runCommand({","+            setParameter: 1,","+            allowDeprecatedAfterOpTimeReadConcern: enabled,","+        }),","+    );","+}","+","+function getAfterOpTimeCounters(conn) {","+    // Don't return defaultRWConcern: asking for it can refresh the read write concern defaults,","+    // which runs commands of its own.","+    const status = assert.commandWorked(","+        conn.getDB(\"admin\").runCommand({serverStatus: 1, defaultRWConcern: false}),","+    );","+    const counters = status.readConcernCounters && status.readConcernCounters.afterOpTime;","+    assert(counters, \"Missing 'readConcernCounters.afterOpTime' from serverStatus\", {","+        readConcernCounters: status.readConcernCounters,","+    });","+    return counters;","+}","+","+describe(\"readConcern.afterOpTime on mongod\", function () {","+    before(function () {","+        this.rst = new ReplSetTest({nodes: 1, keyFile: \"jstests/libs/key1\"});","+        this.rst.startSet();","+        this.rst.initiate();","+        this.primary = this.rst.getPrimary();","+        createUsers(this.primary.getDB(\"admin\"));","+","+        // Seed the collection and capture an optime that is already satisfied.","+        this.internalConn = connectAs(this.primary.host, kInternalUser);","+        assert.commandWorked(this.internalConn.getDB(kDbName)[kCollName].insert({_id: 0}));","+        const lastOp = this.internalConn","+            .getDB(\"local\")","+            .oplog.rs.find()","+            .sort({$natural: -1})","+            .limit(1)","+            .next();","+        this.afterOpTime = {ts: lastOp.ts, t: lastOp.t};","+    });","+","+    after(function () {","+        this.rst.stopSet();","+    });","+","+    it(\"is rejected for an authenticated user without internal\", function () {","+        assertAfterOpTimeRejected(connectAs(this.primary.host, kRootUser), this.afterOpTime);","+    });","+","+    it(\"is rejected for an unauthenticated connection, even for commands needing no auth\", function () {","+        assertUnauthenticatedPingRejected(this.primary.host, this.afterOpTime);","+    });","+","+    it(\"is accepted for a user with internal\", function () {","+        for (const {name, dbName, cmd} of kCommands.filter(","+            ({name}) => name === \"find\" || name === \"ping\",","+        )) {","+            assert.commandWorked(","+                this.internalConn","+                    .getDB(dbName)","+                    .runCommand(withTopLevelReadConcern(cmd, {afterOpTime: this.afterOpTime})),","+                `afterOpTime should be accepted for ${name}`,","+            );","+        }","+    });","+","+    describe(\"with allowDeprecatedAfterOpTimeReadConcern enabled\", function () {","+        before(function () {","+            // Only an authenticated connection can change a server parameter: the framework's","+            // connection to the primary is not authenticated, it created the users through the","+            // localhost exception and then logged out.","+            this.rootConn = connectAs(this.primary.host, kRootUser);","+            setAllowDeprecatedAfterOpTimeReadConcern(this.rootConn, true);","+        });","+","+        after(function () {","+            setAllowDeprecatedAfterOpTimeReadConcern(this.rootConn, false);","+        });","+","+        it(\"is accepted for an authenticated user without internal\", function () {","+            assertAfterOpTimeAccepted(this.rootConn, this.afterOpTime);","+        });","+","+        it(\"is accepted for an unauthenticated connection, even for commands needing no auth\", function () {","+            const adminDB = connectAs(this.primary.host).getDB(\"admin\");","+            assert.commandWorked(","+                adminDB.runCommand({ping: 1, readConcern: {afterOpTime: this.afterOpTime}}),","+            );","+        });","+","+        it(\"is counted as accepted rather than rejected\", function () {","+            const before = getAfterOpTimeCounters(this.internalConn);","+","+            assert.commandWorked(","+                this.rootConn.getDB(kDbName).runCommand({","+                    find: kCollName,","+                    filter: {},","+                    readConcern: {afterOpTime: this.afterOpTime},","+                }),","+            );","+","+            const after = getAfterOpTimeCounters(this.internalConn);","+            // Other operations can also carry an afterOpTime, so 'accepted' is only bounded from","+            // below; 'rejected' must not move at all.","+            assert.gte(","+                after.accepted,","+                before.accepted + 1,","+                \"afterOpTime was not counted as accepted\",","+                {before, after},","+            );","+            assert.eq(after.rejected, before.rejected, \"afterOpTime was counted as rejected\", {","+                before,","+                after,","+            });","+        });","+","+        it(\"is rejected again once the parameter is disabled\", function () {","+            setAllowDeprecatedAfterOpTimeReadConcern(this.rootConn, false);","+","+            // Only one command here: 'assertAfterOpTimeRejected' would run its insert control a","+            // second time, and the document it writes is already there from the test above.","+            const testDB = connectAs(this.primary.host, kRootUser).getDB(kDbName);","+            assert.commandFailedWithCode(","+                testDB.runCommand({","+                    find: kCollName,","+                    filter: {},","+                    readConcern: {afterOpTime: this.afterOpTime},","+                }),","+                ErrorCodes.Unauthorized,","+            );","+        });","+    });","+});","+","+describe(\"readConcern.afterOpTime on mongos\", function () {","+    // Its value only needs to be well-formed: the router rejects the request before forwarding it.","+    const kOpTimeForRouter = {ts: Timestamp(1, 1), t: NumberLong(1)};","+","+    before(function () {","+        this.st = new ShardingTest({shards: 1, config: 1, other: {keyFile: \"jstests/libs/key1\"}});","+        createUsers(this.st.s.getDB(\"admin\"));","+    });","+","+    after(function () {","+        this.st.stop();","+    });","+","+    it(\"is rejected for an authenticated user without internal\", function () {","+        assertAfterOpTimeRejected(connectAs(this.st.s.host, kRootUser), kOpTimeForRouter);","+    });","+","+    it(\"is rejected for an unauthenticated connection, even for commands needing no auth\", function () {","+        assertUnauthenticatedPingRejected(this.st.s.host, kOpTimeForRouter);","+    });","+","+    it(\"is counted in the router's serverStatus\", function () {","+        // The counters are updated on the router too, so the section has to be registered for the","+        // router role. A request rejected here never reaches a shard, so a shard-only section would","+        // leave these rejections unobservable.","+        const rootConn = connectAs(this.st.s.host, kRootUser);","+        const before = getAfterOpTimeCounters(rootConn);","+","+        assert.commandFailedWithCode(","+            rootConn.getDB(kDbName).runCommand({","+                find: kCollName,","+                filter: {},","+                readConcern: {afterOpTime: kOpTimeForRouter},","+            }),","+            ErrorCodes.Unauthorized,","+        );","+","+        const after = getAfterOpTimeCounters(rootConn);","+        assert.eq(after.rejected, before.rejected + 1, \"the router rejection was not counted\", {","+            before,","+            after,","+        });","+    });","+","+    describe(\"with allowDeprecatedAfterOpTimeReadConcern enabled\", function () {","+        before(function () {","+            // The router applies the check itself, and then forwards the client's readConcern","+            // ('readConcern' is a generic argument that is forwarded to shards) to the shard.","+            // Enable the parameter on both rather than rely on how the shard authorizes requests","+            // coming from the router. Neither framework connection is authenticated: 'createUsers'","+            // logged out of the router, and jsTest.authenticate() is a no-op here since the","+            // keyfile is only passed to the ShardingTest. So the router is reached as the root","+            // user, and the shard, which does not have the users created through the router, as","+            // the cluster.","+            this.rootConn = connectAs(this.st.s.host, kRootUser);","+            this.setAllowOnRouterAndShard = (enabled) => {","+                setAllowDeprecatedAfterOpTimeReadConcern(this.rootConn, enabled);","+                authutil.asCluster(this.st.shard0, \"jstests/libs/key1\", () =>","+                    setAllowDeprecatedAfterOpTimeReadConcern(this.st.shard0, enabled),","+                );","+            };","+            this.setAllowOnRouterAndShard(true);","+        });","+","+        after(function () {","+            this.setAllowOnRouterAndShard(false);","+        });","+","+        it(\"is accepted for an authenticated user without internal\", function () {","+            assertAfterOpTimeAccepted(this.rootConn, kOpTimeForRouter);","+        });","+","+        it(\"is accepted for an unauthenticated connection, even for commands needing no auth\", function () {","+            const adminDB = connectAs(this.st.s.host).getDB(\"admin\");","+            assert.commandWorked(","+                adminDB.runCommand({ping: 1, readConcern: {afterOpTime: kOpTimeForRouter}}),","+            );","+        });","+    });","+});"],"additions":331,"deletions":0,"truncated":false},{"path":"src/mongo/db/BUILD.bazel","lines":["@@ -799,6 +799,7 @@ mongo_cc_library(","         \"//src/mongo/db/shard_role/ddl:coll_mod_command_idl\",","         \"//src/mongo/db/shard_role/ddl:index_commands_idl\",","         \"//src/mongo/db/shard_role/shard_catalog:collection_options\",","+        \"//src/mongo/db/stats:server_read_concern_write_concern_metrics\",","         \"//src/mongo/db/stats:timer_stats\",","         \"//src/mongo/db/storage:execution_context\",","         \"//src/mongo/db/storage:prepare_conflict_tracker\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/commands.cpp","lines":["@@ -21,6 +21,7 @@"," #include \"mongo/db/namespace_string.h\""," #include \"mongo/db/namespace_string_util.h\""," #include \"mongo/db/service_context.h\"","+#include \"mongo/db/stats/server_read_concern_metrics.h\""," #include \"mongo/db/tenant_id.h\""," #include \"mongo/db/topology/cluster_role.h\""," #include \"mongo/db/version_context.h\"","@@ -123,6 +124,36 @@ void checkAuthForRawData(OperationContext* opCtx,","             authSession->isAuthorizedForActionsOnNamespace(ns, ActionType::internal));"," }"," ","+/**","+ * Rejects a client-supplied readConcern.afterOpTime unless the client holds ActionType::internal.","+ *","+ * Both outcomes are counted in the 'readConcernCounters' server status section, so that operators","+ * can see how much the deprecated argument is still relied upon before it is removed.","+ */","+void checkAuthForAfterOpTime(OperationContext* opCtx, const GenericArguments& genArg) {","+    const auto& readConcern = genArg.getReadConcern();","+    if (MONGO_likely(!readConcern || !readConcern->getArgsOpTime()))","+        return;","+","+    auto* metrics = ServerReadConcernMetrics::get(opCtx);","+","+    if (MONGO_unlikely(repl::gAllowDeprecatedAfterOpTimeReadConcern.load())) {","+        metrics->recordAcceptedAfterOpTime();","+        return;","+    }","+","+    auto authSession = AuthorizationSession::get(opCtx->getClient());","+    const bool isInternal = authSession->isAuthorizedForActionsOnResource(","+        ResourcePattern::forClusterResource(boost::none), ActionType::internal);","+    if (isInternal) {","+        metrics->recordAcceptedAfterOpTime();","+    } else {","+        metrics->recordRejectedAfterOpTime();","+        uasserted(ErrorCodes::Unauthorized,","+                  \"Not authorized to run command with readConcern.afterOpTime\");","+    }","+}","+"," auto getCommandInvocationHooks =","     ServiceContext::declareDecoration<std::unique_ptr<CommandInvocationHooks>>();"," ","@@ -936,6 +967,7 @@ void CommandInvocation::checkAuthorization(OperationContext* opCtx,","         } else {","             try {","                 checkAuthForRawData(opCtx, getGenericArguments(), request);","+                checkAuthForAfterOpTime(opCtx, getGenericArguments());","                 doCheckAuthorization(opCtx);","             } catch (const ExceptionFor<ErrorCodes::Unauthorized>&) {","                 namespace mmb = mutablebson;"],"additions":32,"deletions":0,"truncated":false},{"path":"src/mongo/db/repl/read_concern.idl","lines":["@@ -60,3 +60,15 @@ structs:","                 type: bool","                 cpp_name: waitLastStableRecoveryTimestamp","                 optional: true","+","+server_parameters:","+    allowDeprecatedAfterOpTimeReadConcern:","+        description: >-","+            Permit clients to send the deprecated readConcern.afterOpTime argument. When false,","+            the server rejects that argument on requests received from clients. Intended only as a","+            temporary escape hatch for deployments that still depend on it.","+        set_at: [startup, runtime]","+        cpp_vartype: AtomicWord<bool>","+        cpp_varname: gAllowDeprecatedAfterOpTimeReadConcern","+        default: false","+        redact: false"],"additions":12,"deletions":0,"truncated":false},{"path":"src/mongo/db/stats/read_concern_stats.idl","lines":["@@ -86,11 +86,26 @@ structs:","                 # Not supported in transactions.","                 optional: true"," ","+    AfterOpTimeOps:","+        description:","+            \"A struct representing the number of operations that supplied the deprecated","+            readConcern.afterOpTime argument, split by whether the argument was accepted or rejected\"","+        strict: true","+        fields:","+            accepted:","+                type: long","+                default: 0","+            rejected:","+                type: long","+                default: 0","+","     ReadConcernStats:","         description: \"A struct representing the section of the server status","             command with information about readConcern levels used by operations\"","         strict: true","         fields:","+            afterOpTime:","+                type: AfterOpTimeOps","             nonTransactionOps:","                 type: ReadConcernOps","             transactionOps:"],"additions":15,"deletions":0,"truncated":false},{"path":"src/mongo/db/stats/server_read_concern_metrics.cpp","lines":["@@ -93,6 +93,14 @@ void ServerReadConcernMetrics::recordReadConcern(const repl::ReadConcernArgs& re","     ops.recordReadConcern(readConcernArgs, isTransaction);"," }"," ","+void ServerReadConcernMetrics::recordAcceptedAfterOpTime() {","+    _afterOpTime.accepted.fetchAndAdd(1);","+}","+","+void ServerReadConcernMetrics::recordRejectedAfterOpTime() {","+    _afterOpTime.rejected.fetchAndAdd(1);","+}","+"," void ServerReadConcernMetrics::ReadConcernLevelCounters::updateStats(ReadConcernOps* stats,","                                                                      bool isTransaction) {","     SnapshotOps snapshotOps;","@@ -145,6 +153,11 @@ void ServerReadConcernMetrics::ReadConcernCounters::updateStats(ReadConcernOps*"," }"," "," void ServerReadConcernMetrics::updateStats(ReadConcernStats* stats, OperationContext* opCtx) {","+    AfterOpTimeOps afterOpTime;","+    afterOpTime.setAccepted(_afterOpTime.accepted.load());","+    afterOpTime.setRejected(_afterOpTime.rejected.load());","+    stats->setAfterOpTime(afterOpTime);","+","     ReadConcernOps nonTransactionOps;","     _nonTransactionOps.updateStats(&nonTransactionOps, /*isTransaction=*/false);","     stats->setNonTransactionOps(nonTransactionOps);","@@ -173,7 +186,9 @@ class ReadConcernCountersSSS : public ServerStatusSection {","     }"," };"," auto readConcernCountersSSS =","-    *ServerStatusSectionBuilder<ReadConcernCountersSSS>(\"readConcernCounters\").forShard();","+    *ServerStatusSectionBuilder<ReadConcernCountersSSS>(\"readConcernCounters\")","+         .forShard()","+         .forRouter();"," }  // namespace"," "," }  // namespace mongo"],"additions":16,"deletions":1,"truncated":false},{"path":"src/mongo/db/stats/server_read_concern_metrics.h","lines":["@@ -30,6 +30,16 @@ class [[MONGO_MOD_PUBLIC]] ServerReadConcernMetrics {","      */","     void recordReadConcern(const repl::ReadConcernArgs& readConcernArgs, bool isTransaction);"," ","+    /**","+     * Records that a client-supplied readConcern.afterOpTime argument was accepted.","+     */","+    void recordAcceptedAfterOpTime();","+","+    /**","+     * Records that a client-supplied readConcern.afterOpTime argument was rejected.","+     */","+    void recordRejectedAfterOpTime();","+","     /**","      * Appends the accumulated stats to a readConcern stats object.","      */","@@ -74,6 +84,18 @@ class [[MONGO_MOD_PUBLIC]] ServerReadConcernMetrics {","     };","     ReadConcernCounters _nonTransactionOps;","     ReadConcernCounters _transactionOps;","+","+    /**","+     * Counters for operations that supplied the deprecated readConcern.afterOpTime argument, split","+     * by whether the argument was accepted or rejected. Unlike the level counters above, these are","+     * not broken down by readConcern level: 'afterOpTime' is orthogonal to the level, and may only","+     * not be combined with 'snapshot'.","+     */","+    struct AfterOpTimeCounters {","+        Atomic<unsigned long long> accepted{0};","+        Atomic<unsigned long long> rejected{0};","+    };","+    AfterOpTimeCounters _afterOpTime;"," };"," "," }  // namespace mongo",""],"additions":22,"deletions":0,"truncated":false}],"additions":429,"deletions":1,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-19T18:00:31.411755+00:00"}