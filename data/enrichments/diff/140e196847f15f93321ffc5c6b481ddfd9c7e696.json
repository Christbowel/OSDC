ision]:"," ","         Returns:","             The health decision to carry out, or ``None`` while the checks run.","+            ``Noop()`` if no on-demand check is running.","         \"\"\"","+        if not self._on_demand_evaluators:","+            return Noop()","         status = self._node_monitor_group.poll_probe_results()","         if status is None:","             return None","         evaluators, self._on_demand_evaluators = self._on_demand_evaluators, []","-        return self._decide(","+        decision = self._decide(","             evaluators, _to_health_state(status, self._on_demand_probes)","         )","+        # The controller logs every other decision when it acts on it. A Noop","+        # has no action, so log here that the checks, such as a Diagnose's,","+        # are done and found nothing.","+        if isinstance(decision, Noop):","+            logger.info(\"The on-demand health checks found nothing to act on.\")","+        return decision","+","+    def start_and_evaluate_on_demand_checks(","+        self,","+        checks: Sequence[HealthCheck],","+        timeout: float = DEFAULT_ON_DEMAND_PROBE_TIMEOUT_S,","+    ) -> HealthDecision:","+        \"\"\"Run on-demand checks once on the monitored nodes, and wait for their","+        decision: until their results are back, or the timeout passed.","+","+        Args:","+            checks: The checks, such as the pre-flight checks that stop the","+                workers.","+            timeout: Timeout in seconds for the nodes to answer.","+","+        Returns:","+            The health decision to carry out. ``Noop()`` if there is nothing to","+            do.","+        \"\"\"","+        self.start_on_demand_checks(checks, timeout)","+        decision = self.evaluate_on_demand_checks()","+        while decision is None:","+            time.sleep(DEFAULT_ON_DEMAND_PROBE_POLL_INTERVAL_S)","+            decision = self.evaluate_on_demand_checks()","+        return decision"," ","     def _poll_node_monitor_group_status(self, timeout: float) -> None:","         \"\"\"Poll each ``NodeMonitor``, and merge its new status into its last"],"additions":69,"deletions":5,"truncated":false},{"path":"python/ray/train/health/check.py","lines":["@@ -17,10 +17,16 @@ class HealthCheck:","     Attributes:","         probe_creator: Returns the check's probes. Defaults to none.","         evaluator_creator: Returns the check's evaluators. Defaults to none.","+        requires_idle_workers: Whether the probes need the workers not to be","+            training, such as an all-reduce test. Such a check runs at the","+            start of an attempt, and training waits for it to decide: as a","+            pre-flight check, or after its ``Diagnose`` restarts the worker","+            group.","     \"\"\""," ","     probe_creator: ProbeCreator = lambda: []","     evaluator_creator: EvaluatorCreator = lambda: []","+    requires_idle_workers: bool = False"," "," "," @PublicAPI(stability=\"alpha\")","@@ -32,7 +38,8 @@ class PeriodicHealthCheck(HealthCheck):","         poll_interval_s: Seconds between polls of the check's probes."," ","     Raises:","-        ValueError: If ``poll_interval_s`` is not positive.","+        ValueError: If ``poll_interval_s`` is not positive, or","+            ``requires_idle_workers`` is set.","     \"\"\""," ","     poll_interval_s: float","@@ -42,6 +49,8 @@ def __post_init__(self):","             raise ValueError(","                 f\"poll_interval_s must be positive, got {self.poll_interval_s}.\"","             )","+        if self.requires_idle_workers:","+            raise ValueError(\"A PeriodicHealthCheck runs during training.\")"," "," "," @PublicAPI(stability=\"alpha\")","@@ -51,8 +60,8 @@ class HealthConfig:"," ","     Attributes:","         inflight_checks: Checks that run during training.","-        preflight_checks: Checks that run once on each node before training","-            starts.","+        preflight_checks: Checks that run once on each attempt's nodes as its","+            workers start. See ``HealthCheck.requires_idle_workers``.","     \"\"\""," ","     inflight_checks: List[PeriodicHealthCheck] = field(default_factory=list)"],"additions":12,"deletions":3,"truncated":false},{"path":"python/ray/train/v2/BUILD.bazel","lines":["@@ -415,6 +415,38 @@ py_test(","     ],"," )"," ","+py_test(","+    name = \"test_health_controller\",","+    size = \"medium\",","+    srcs = [\"tests/test_health_controller.py\"],","+    env = _TRAIN_V2_TEST_ENV,","+    tags = [","+        \"exclusive\",","+        \"team:ml\",","+        \"train_v2\",","+    ],","+    deps = [","+        \":conftest\",","+        \"//:ray_lib\",","+    ],","+)","+","+py_test(","+    name = \"test_health_e2e\",","+    size = \"medium\",","+    srcs = [\"tests/test_health_e2e.py\"],","+    env = _TRAIN_V2_TEST_ENV,","+    tags = [","+        \"exclusive\",","+        \"team:ml\",","+        \"train_v2\",","+    ],","+    deps = [","+        \":conftest\",","+        \"//:ray_lib\",","+    ],","+)","+"," py_test(","     name = \"test_health_manager\",","     size = \"medium\","],"additions":32,"deletions":0,"truncated":false},{"path":"python/ray/train/v2/_internal/callbacks/health_callback.py","lines":["@@ -0,0 +1,79 @@","+from typing import TYPE_CHECKING, List","+","+from ray.train.health import Evict, HealthCheck, Reattempt","+from ray.train.v2._internal.execution.callback import WorkerGroupCallback","+from ray.train.v2.api.exceptions import HealthCheckError","+","+if TYPE_CHECKING:","+    from ray.train.health._internal.manager import HealthManager","+    from ray.train.v2._internal.execution.worker_group import (","+        WorkerGroup,","+        WorkerGroupContext,","+    )","+","+","+class HealthCallback(WorkerGroupCallback):","+    \"\"\"Runs a ``HealthManager``'s checks on each attempt's worker group: runs","+    the pre-flight checks as its workers start, and monitors the attempt's","+    nodes while they run.","+","+    Args:","+        health_manager: The run's ``HealthManager``. The ``TrainController``","+            creates it from ``RunConfig.health_config``, and evaluates its","+            checks while the attempt runs.","+        preflight_checks: The checks to run once at the start of each attempt.","+    \"\"\"","+","+    def __init__(","+        self, health_manager: \"HealthManager\", preflight_checks: List[HealthCheck]","+    ):","+        self._health_manager = health_manager","+        self._preflight_checks = preflight_checks","+        # Checks to run once at the start of the next attempt only.","+        self._next_start_checks: List[HealthCheck] = []","+","+    def run_at_next_start(self, checks: List[HealthCheck]) -> None:","+        \"\"\"Run some checks once at the start of the next attempt, with its","+        pre-flight checks.","+","+        Args:","+            checks: The checks, such as those of a ``Diagnose`` that stop the","+                workers.","+        \"\"\"","+        self._next_start_checks.extend(checks)","+","+    def after_worker_group_start(self, worker_group: \"WorkerGroup\") -> None:","+        \"\"\"Reset the ``HealthManager`` for the attempt, and run its pre-flight","+        checks on demand. Training starts once the checks that stop the","+        workers decide, alongside the other checks.","+","+        Args:","+            worker_group: The attempt's worker group.","+","+        Raises:","+            HealthCheckError: If the checks that require idle workers decide to","+                ``Reattempt`` or ``Evict``, which keeps training from starting.","+        \"\"\"","+        node_ids = {worker.metadata.node_id for worker in worker_group.get_workers()}","+        self._health_manager.reset(sorted(node_ids))","+","+        checks = self._preflight_checks + self._next_start_checks","+        self._next_start_checks = []","+        blocking_checks = [c for c in checks if c.requires_idle_workers]","+        if blocking_checks:","+            decision = self._health_manager.start_and_evaluate_on_demand_checks(","+                blocking_checks","+            )","+            if isinstance(decision, (Reattempt, Evict)):","+                self._health_manager.shutdown()","+                raise HealthCheckError(decision)","+","+        other_checks = [c for c in checks if not c.requires_idle_workers]","+        if other_checks:","+            self._health_manager.start_on_demand_checks(other_checks)","+","+    def before_worker_group_shutdown(self, worker_group: \"WorkerGroup\"):","+        self._health_manager.shutdown()","+","+    def before_worker_group_abort(self, worker_group_context: \"WorkerGroupContext\"):","+        self._health_manager.shutdown()"],"additions":79,"deletions":0,"truncated":false},{"path":"python/ray/train/v2/_internal/callbacks/user_callback.py","lines":["@@ -1,6 +1,7 @@","-from typing import Any, Dict, List","+from typing import TYPE_CHECKING, Any, Dict, List"," "," from ray.train.v2._internal.execution.callback import (","+    ControllerCallback,","     ReportCallback,","     WorkerGroupCallback,"," )","@@ -9,8 +10,11 @@"," from ray.train.v2._internal.execution.worker_group import WorkerGroupPollStatus"," from ray.train.v2.api.callback import UserCallback"," ","+if TYPE_CHECKING:","+    from ray.train.health import HealthDecision"," ","-class UserCallbackHandler(WorkerGroupCallback, ReportCallback):","+","+class UserCallbackHandler(WorkerGroupCallback, ReportCallback, ControllerCallback):","     \"\"\"Responsible for calling methods of subscribers implementing","     the `UserCallback` interface.","     \"\"\"","@@ -52,3 +56,14 @@ def after_worker_group_poll_status(","                 run_context=self._train_run_context,","                 worker_exceptions=worker_group_status.errors,","             )","+","+    # --------------------------","+    # ControllerCallback","+    # --------------------------","+","+    def after_health_decision(self, health_decision: \"HealthDecision\"):","+        for user_callback in self._user_callbacks:","+            user_callback.after_health_decision(","+                run_context=self._train_run_context,","+                health_decision=health_decision,","+            )"],"additions":17,"deletions":2,"truncated":false},{"path":"python/ray/train/v2/_internal/execution/callback.py","lines":["@@ -7,6 +7,7 @@"," from ray.util.annotations import DeveloperAPI"," "," if TYPE_CHECKING:","+    from ray.train.health import HealthDecision","     from ray.train.v2._internal.execution.context import TrainRunContext","     from ray.train.v2._internal.execution.controller import (","         TrainControllerState,","@@ -168,6 +169,11 @@ def before_controller_execute_resize_decision(","         \"\"\"Called before the controller executes a resize decision.\"\"\"","         pass"," ","+    def after_health_decision(self, health_decision: \"HealthDecision\"):","+        \"\"\"Called after the health checks decide on something other than a","+        ``Noop``, before the controller acts on it.\"\"\"","+        pass","+","     def after_controller_finish(self, result: \"Result\"):","         \"\"\"Called after the training run completes, providing access to the final result."," "],"additions":6,"deletions":0,"truncated":false},{"path":"python/ray/train/v2/_internal/execution/controller/controller.py","lines":["@@ -10,6 +10,9 @@"," import ray"," import ray._private.ray_constants as ray_constants"," from ray.exceptions import AsyncioActorExit","+from ray.train.health import Diagnose, Evict, HealthDecision, Noop, Reattempt","+from ray.train.health._internal.manager import HealthManager","+from ray.train.v2._internal.callbacks.health_callback import HealthCallback"," from ray.train.v2._internal.constants import (","     DEFAULT_ENABLE_CONTROLLER_LOGGING,","     DEFAULT_ENABLE_PREEMPTION_WATCHER,","@@ -75,6 +78,7 @@"," from ray.train.v2.api.callback import RayTrainCallback"," from ray.train.v2.api.exceptions import (","     ControllerError,","+    HealthCheckError,","     PreemptionError,","     TrainingFailedError,"," )","@@ -221,6 +225,16 @@ def __init__("," ","             self._worker_group_callbacks_to_propagate.append(PreemptionCallback())"," ","+        self._health_manager = None","+        self._health_callback = None","+        health_config = self._run_config.health_config","+        if health_config is not None:","+            self._health_manager = HealthManager(health_config.inflight_checks)","+            self._health_callback = HealthCallback(","+                self._health_manager, health_config.preflight_checks","+            )","+            self._worker_group_callbacks_to_propagate.append(self._health_callback)","+","         self._worker_group: Optional[WorkerGroup] = None","         self._state = InitializingState()","         self._return_value: Optional[Any] = None","@@ -311,10 +325,17 @@ def _execute_resize_decision(","             # Standard: full restart.","             if self._worker_group:","                 self._shutdown_worker_group()","-            self._start_worker_group(","-                num_workers=decision.num_workers,","-                resources_per_worker=decision.resources_per_worker,","-            )","+            try:","+                self._start_worker_group(","+                    num_workers=decision.num_workers,","+                    resources_per_worker=decision.resources_per_worker,","+                )","+            except HealthCheckError as e:","+                # Only HealthCallback.after_worker_group_start raises this: a","+                # pre-flight check that requires idle workers decided to","+                # Reattempt or Evict. WorkerGroup._start() shut down the","+                # started workers before re-raising it.","+                return self._execute_health_decision(e.decision)"," ","         return TrainControllerLoopIterationResult(","             run_attempt_id=self._get_run_attempt_id(),","@@ -694,6 +715,13 @@ async def _step(self) -> TrainControllerLoopIterationResult:","                     failure_decision, training_failed_error=worker_group_error","                 )"," ","+            if self._health_manager is not None:","+                health_decision = self._health_manager.evaluate()","+                if not isinstance(health_decision, Noop):","+                    health_result = self._execute_health_decision(health_decision)","+                    if health_result:","+                        return health_result","+","             scaling_decision = (","                 self._scaling_policy.make_decision_for_running_worker_group(","                     worker_group_state=self.get_worker_group().get_worker_group_state(),","@@ -730,6 +758,68 @@ async def _step(self) -> TrainControllerLoopIterationResult:","         else:","             raise ValueError(f\"Unexpected controller state: {controller_state}\")"," ","+    def _execute_health_decision(","+        self, decision: HealthDecision","+    ) -> Optional[TrainControllerLoopIterationResult]:","+        \"\"\"Act on a health decision: from the pre-flight checks before","+        training, or from the in-flight checks or a ``Diagnose`` during","+        training.","+","+        A ``Reattempt`` restarts the worker group through the failure policy,","+        like a worker error. An ``Evict`` restarts it outside the failure","+        policy. A ``Diagnose`` starts its checks while training continues, and","+        a later ``HealthManager.evaluate()`` decides on their results. If a","+        check requires idle workers, the ``Diagnose`` restarts the worker group","+        outside the failure policy instead, and the checks run at the start of","+        the next attempt, like pre-flight checks.","+","+        Args:","+            decision: The health decision, other than a ``Noop``.","+","+        Returns:","+            The result of the iteration, or ``None`` to keep running.","+        \"\"\"","+        failure_result = self._run_controller_hook(\"after_health_decision\", decision)","+        if failure_result:","+            return failure_result","+","+        error = HealthCheckError(decision)","+        if isinstance(decision, Diagnose):","+            if not any(check.requires_idle_workers for check in decision.checks):","+                logger.info(\"Diagnosing while training continues: %s\", decision.reason)","+                self._health_manager.start_on_demand_checks(decision.checks)","+                return None","+            logger.warning(","+                \"Restarting the worker group to diagnose: %s\", decision.reason","+            )","+            self._health_callback.run_at_next_start(decision.checks)","+            return TrainControllerLoopIterationResult(","+                run_attempt_id=self._get_run_attempt_id(),","+                previous_state=self.get_state(),","+                next_state=self._get_retry_state(self.get_state(), error),","+            )","+","+        if isinstance(decision, Reattempt):","+            logger.warning(\"Reattempting: %s\", decision.reason)","+            failure_decision = self._failure_policy.make_decision(","+                training_failed_error=error","+            )","+            return self._execute_failure_decision(","+                failure_decision, training_failed_error=error","+            )","+        if isinstance(decision, Evict):","+            logger.warning(","+                \"Evicting nodes %s and restarting the worker group: %s\",","+                decision.target_nodes,","+                decision.reason,","+            )","+            return TrainControllerLoopIterationResult(","+                run_attempt_id=self._get_run_attempt_id(),","+                previous_state=self.get_state(),","+                next_state=self._get_retry_state(self.get_state(), error),","+            )","+        return None","+","     @staticmethod","     def _is_training_succeeded(","         worker_group_status: WorkerGroupPollStatus,"],"additions":94,"deletions":4,"truncated":false},{"path":"python/ray/train/v2/api/callback.py","lines":["@@ -1,6 +1,7 @@"," from typing import Any, Dict, List, Optional"," "," from ray.train import Checkpoint","+from ray.train.health import HealthDecision"," from ray.train.v2._internal.execution.context import TrainRunContext"," from ray.util.annotations import DeveloperAPI"," ","@@ -51,3 +52,15 @@ def after_exception(","                 raised by that worker.","         \"\"\"","         pass","+","+    def after_health_decision(","+        self, run_context: TrainRunContext, health_decision: HealthDecision","+    ):","+        \"\"\"Called after the health checks of ``RunConfig.health_config`` decide","+        on something other than a ``Noop``, before Ray Train acts on it.","+","+        Args:","+            run_context: The `TrainRunContext` for the current training run.","+            health_decision: The ``Reattempt``, ``Evict`` or ``Diagnose``.","+        \"\"\"","+        pass"],"additions":13,"deletions":0,"truncated":false},{"path":"python/ray/train/v2/api/config.py","lines":["@@ -23,6 +23,7 @@"," "," if TYPE_CHECKING:","     from ray.train import UserCallback","+    from ray.train.health import HealthConfig"," "," logger = logging.getLogger(__name__)"," ","@@ -460,6 +461,8 @@ class RunConfig:","             for all Ray Train worker actors.","         logging_config: Configuration for Ray Train's logging behavior.","             See :class:`LoggingConfig` for details.","+        health_config: [Alpha] The health checks to run during training. See","+            ``ray.train.health.HealthConfig``.","     \"\"\""," ","     name: Optional[str] = None","@@ -470,6 +473,7 @@ class RunConfig:","     callbacks: Optional[List[\"UserCallback\"]] = None","     worker_runtime_env: Optional[Union[dict, RuntimeEnv]] = None","     logging_config: Optional[LoggingConfig] = None","+    health_config: Optiona