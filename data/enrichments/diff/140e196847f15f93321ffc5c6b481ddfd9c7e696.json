(self):","+        return self.decisions.pop(0) if self.decisions else Noop()","+","+    def start_on_demand_checks(self, checks):","+        self.on_demand_checks.append(checks)","+","+","+class RecordingCallback(ControllerCallback):","+    def __init__(self):","+        self.decisions = []","+","+    def after_health_decision(self, health_decision):","+        self.decisions.append(health_decision)","+","+","+@pytest.fixture(autouse=True)","+def patch_controller(monkeypatch):","+    monkeypatch.setattr(TrainController, \"worker_group_cls\", DummyWorkerGroup)","+    monkeypatch.setattr(controller_module, \"HealthManager\", FakeHealthManager)","+    monkeypatch.setenv(HEALTH_CHECK_INTERVAL_S_ENV_VAR, \"0\")","+    ray.init()","+    yield","+    ray.shutdown()","+","+","+def _step(controller):","+    asyncio.run(controller._run_control_loop_iteration())","+","+","+def _controller(failure_policy):","+    scaling_policy = MockScalingPolicy(scaling_config=ScalingConfig())","+    callback = RecordingCallback()","+    controller = TrainController(","+        train_fn_ref=DummyObjectRefWrapper(lambda: None),","+        train_run_context=create_dummy_run_context(","+            run_config=RunConfig(name=\"test\", health_config=HealthConfig()),","+            scaling_config=ScalingConfig(num_workers=2),","+        ),","+        scaling_policy=scaling_policy,","+        failure_policy=failure_policy,","+        callbacks=[callback],","+    )","+    for _ in range(2):","+        scaling_policy.queue_recovery_decision(","+            ResizeDecision(num_workers=2, resources_per_worker={})","+        )","+    return controller, callback","+","+","+def _running_controller(failure_policy):","+    controller, callback = _controller(failure_policy)","+    _step(controller)","+    _step(controller)","+    assert isinstance(controller.get_state(), RunningState)","+    return controller, callback","+","+","+def test_diagnose_starts_its_checks_while_training_continues():","+    controller, callback = _running_controller(MockFailurePolicy(None))","+    check = HealthCheck()","+    controller._health_manager.decisions = [Diagnose(reason=\"slow\", checks=[check])]","+","+    _step(controller)","+    assert isinstance(controller.get_state(), RunningState)","+    assert controller._health_manager.on_demand_checks == [[check]]","+    assert [d.reason for d in callback.decisions] == [\"slow\"]","+","+","+def test_a_diagnose_that_requires_idle_workers_restarts_outside_the_failure_policy():","+    failure_policy = MockFailurePolicy(None)","+    failure_policy.make_decision = MagicMock()","+    controller, callback = _running_controller(failure_policy)","+    checks = [HealthCheck(requires_idle_workers=True), HealthCheck()]","+    controller._health_manager.decisions = [Diagnose(reason=\"slow\", checks=checks)]","+","+    _step(controller)","+    assert isinstance(controller.get_state(), RestartingState)","+    failure_policy.make_decision.assert_not_called()","+    assert controller._health_manager.on_demand_checks == []","+    assert controller._health_callback._next_start_checks == checks","+    assert [type(d) for d in callback.decisions] == [Diagnose]","+","+","+def test_reattempt_goes_through_the_failure_policy():","+    failure_policy = MockFailurePolicy(None)","+    failure_policy.make_decision = MagicMock(return_value=FailureDecision.RETRY)","+    controller, callback = _running_controller(failure_policy)","+    controller._health_manager.decisions = [Reattempt(reason=\"loss spiked\")]","+","+    _step(controller)","+    state = controller.get_state()","+    assert isinstance(state, RestartingState)","+    error = failure_policy.make_decision.call_args.kwargs[\"training_failed_error\"]","+    assert isinstance(error, HealthCheckError)","+    assert \"loss spiked\" in str(error)","+    assert state.training_failed_error is error","+    assert [type(d) for d in callback.decisions] == [Reattempt]"],"additions":149,"deletions":0,"truncated":false}],"additions":510,"deletions":14,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-13T17:04:12.902471+00:00"}