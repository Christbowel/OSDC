(&self.script))","+                && values(&entry[\"artifacts\"]).flat_map(values).flat_map(values).any(|artifact| {","+                    artifact[\"build_id\"].as_str().is_some_and(|id| without_input.contains(id))","+                }))","+        });","+        if files.len() == len {","+            return Ok(());","+        }","+        // A new file replaces the cache at once, so an interrupted write leaves no partial cache.","+        let temp = paths.cache.with_extension(\"json.tmp\");","+        fs::write(&temp, serde_json::to_vec(&cache)?)","+            .and_then(|()| fs::rename(&temp, &paths.cache))","+            .wrap_err_with(|| format!(\"failed to write {}\", paths.cache.display()))","+    }","+","     /// Returns the configured [VyperSettings] that includes:","     /// - evm version","     pub fn vyper_settings(&self) -> Result<VyperSettings, SolcError> {","@@ -3189,6 +3250,7 @@ impl Default for Config {","             sparse_mode: false,","             build_info: false,","             build_info_path: None,","+            build_info_without_ast: false,","             fmt: Default::default(),","             lint: Default::default(),","             doc: Default::default(),","@@ -6173,6 +6235,24 @@ mod tests {","         assert_eq!(settings.cli_settings.extra_args, vec![\"--via-ssa-cfg\".to_string()]);","     }"," ","+    #[test]","+    fn debug_build_info_leaves_out_the_ast_unless_build_info_is_on() {","+        let requests_ast = |config: &Config| {","+            config.solc_settings().unwrap().settings.output_selection.as_ref()[\"*\"]","+                .get(\"\")","+                .is_some_and(|outputs| outputs.contains(&\"ast\".to_string()))","+        };","+","+        let mut config = Config::default();","+        config.enable_debug_build_info().unwrap();","+        assert!(config.build_info);","+        assert!(!requests_ast(&config));","+","+        let mut config = Config { build_info: true, ..Config::default() };","+        config.ena