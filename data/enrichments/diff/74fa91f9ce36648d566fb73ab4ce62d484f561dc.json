me timeStamp, DateTime priority, bool read","         /// <remarks>","         /// Participant access counts, pending-call state, and joined branches remain local to each instance.","         /// </remarks>","+        /// <exception cref=\"ArgumentNullException\"><paramref name=\"other\"/> is <see langword=\"null\"/>.</exception>","         public TransactionInfo(TransactionInfo other) : this()","         {","+            ArgumentNullException.ThrowIfNull(other);","             this.TransactionId = other.TransactionId;","             this.TryToCommit = other.TryToCommit;","             this.IsReadOnly = other.IsReadOnly;","@@ -136,8 +138,10 @@ public TransactionInfo Fork()","         /// Queues a completed transaction branch for reconciliation with this instance.","         /// </summary>","         /// <param name=\"x\">The completed transaction branch to join.</param>","+        /// <exception cref=\"ArgumentNullException\"><paramref name=\"x\"/> is <see langword=\"null\"/>.</exception>","         public void Join(TransactionInfo x)","         {","+            ArgumentNullException.ThrowIfNull(x);","             joined.Enqueue(x);","         }"," ","@@ -149,10 +153,14 @@ public void Join(TransactionInfo x)","         /// The recorded abort exception, an orphan-call exception for outstanding calls, or <see langword=\"null\"/>","         /// when the transaction has no mandatory abort condition.","         /// </returns>","+        /// <exception cref=\"ArgumentNullException\">","+        /// <paramref name=\"serializer\"/> is <see langword=\"null\"/> when a recorded exception requires deserialization.","+        /// </exception>","         public OrleansTransactionAbortedException? MustAbort(Serializer<OrleansTransactionAbortedException> serializer)","         {","             if (OriginalException != null)","             {","+                ArgumentNullException.ThrowIfNull(serializer);","                 return serializer.Deserialize(OriginalException);","             }","             else if (PendingCalls != 0)","@@ -170,10 +178,14 @@ public void Join(TransactionInfo x)","         /// </summary>","         /// <param name=\"e\">The exception raised during transaction execution.</param>","         /// <param name=\"sm\">The serializer used to store the exception for transaction propagation.</param>","+        /// <exception cref=\"ArgumentNullException\">","+        /// <paramref name=\"sm\"/> is <see langword=\"null\"/> when recording the first exception.","+        /// </exception>","         public void RecordException(Exception e, Serializer<OrleansTransactionAbortedException> sm)","         {","             if (OriginalException == null)","             {","+                ArgumentNullException.ThrowIfNull(sm);","                 var exception = (e as OrleansTransactionAbortedException)","                     ?? new OrleansTransactionAbortedException(TransactionId.ToString(), e);"," "],"additions":12,"deletions":0,"truncated":false},{"path":"test/Transactions/Orleans.Transactions.Tests/ConsistencyTestGrainTests.cs","lines":["@@ -0,0 +1,55 @@","+using Orleans.Transactions.TestKit.Consistency;","+using TestExtensions;","+using Xunit;","+","+namespace Orleans.Transactions.Tests;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"Transactions\")]","+[TestCategory(\"BVT\"), TestCategory(\"Transactions\")]","+public class ConsistencyTestGrainTests(MemoryTransactionsFixture fixture) : IClassFixture<MemoryTransactionsFixture>","+{","+    private static long _nextGrainKey;","+","+    [Theory]","+    [InlineData(false, true, 1)]","+    [InlineData(true, true, 1)]","+    [InlineData(false, false, 6)]","+    [InlineData(true, false, 6)]","+    public async Task Run_CollectsCompletedRecursiveCalls(","+        bool avoidDeadlocks,","+        bool deadlineExpired,","+        int expectedWrites)","+    {","+        var key = Interlocked.Increment(ref _nextGrainKey) * ConsistencyTestOptions.MaxGrains;","+        var options = new ConsistencyTestOptions","+        {","+            // This seed selects recursion, then a write in the first nested call and six writes in all ten calls.","+            RandomSeed = 213,","+            NumGrains = 1,","+            MaxDepth = 1,","+            AvoidDeadlocks = avoidDeadlocks,","+            ReadWrite = ReadWriteDetermination.PerAccess,","+            GrainOffset = key,","+        };","+        var grain = fixture.GrainFactory.GetGrain<IConsistencyTestGrain>(key);","+","+        var observations = await grain.Run(","+            options,","+            depth: 0,","+            stack: \"(0)\",","+            max: 1,","+            stopAfter: deadlineExpired ? DateTime.MinValue : DateTime.MaxValue)","+            .WaitAsync(TestContext.Current.CancellationToken);","+","+        Assert.Equal(Enumerable.Range(0, expectedWrites + 1), observations.Select(observation => observation.SeqNo).Order());","+        var transactionId = Assert.Single(observations.Select(observation => observation.ExecutingTx).Distinct());","+        Assert.True(Guid.TryParse(transactionId, out _));","+        Assert.All(observations, observation =>","+        {","+            Assert.Equal(0, observation.Grain);","+            Assert.Equal(observation.SeqNo == 0 ? ConsistencyTestHarness.InitialTx : transactionId, observation.WriterTx);","+        });","+    }","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"test/Transactions/Orleans.Transactions.Tests/TransactionInfoBoundaryTests.cs","lines":["@@ -0,0 +1,127 @@","+using Microsoft.Extensions.DependencyInjection;","+using Orleans.Serialization;","+using Orleans.Transactions;","+using TestExtensions;","+using Xunit;","+","+namespace Orleans.Transactions.Tests;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"Transactions\")]","+[TestCategory(\"BVT\"), TestCategory(\"Transactions\")]","+public sealed class TransactionInfoBoundaryTests","+{","+    [Fact]","+    public void CopyConstructor_RejectsMissingSource()","+    {","+        Assert.Throws<ArgumentNullException>(\"other\", () => new TransactionInfo(null!));","+    }","+","+    [Fact]","+    public void CopyConstructor_PreservesMetadataAndStartsIndependentBranchState()","+    {","+        var timestamp = new DateTime(2026, 8, 8, 12, 0, 0, DateTimeKind.Utc);","+        var original = new TransactionInfo(Guid.NewGuid(), timestamp, timestamp.AddSeconds(1), readOnly: true)","+        {","+            TryToCommit = false,","+            UseExclusiveLock = true,","+            Timeout = TimeSpan.FromSeconds(30),","+            OriginalException = [1],","+            PendingCalls = 2,","+        };","+","+        var copy = new TransactionInfo(original);","+","+        Assert.Equal(original.TransactionId, copy.TransactionId);","+        Assert.Equal(timestamp, copy.TimeStamp);","+        Assert.Equal(timestamp.AddSeconds(1), copy.Priority);","+        Assert.True(copy.IsReadOnly);","+        Assert.False(copy.TryToCommit);","+        Assert.True(copy.UseExclusiveLock);","+        Assert.Equal(TimeSpan.FromSeconds(30), copy.Timeout);","+        Assert.Equal(0, copy.PendingCalls);","+        Assert.Null(copy.OriginalException);","+        Assert.NotSame(original.Participants, copy.Participants);","+        Assert.Empty(copy.Participants);","+    }","+","+    [Fact]","+    public void Join_RejectsMissingBranchBeforeChangingReconciliation()","+    {","+        var transaction = new TransactionInfo();","+        var branch = transaction.Fork();","+        branch.TimeStamp = new DateTime(2026, 8, 8, 12, 0, 0, DateTimeKind.Utc);","+        branch.TryToCommit = false;","+","+        Assert.Throws<ArgumentNullException>(\"x\", () => transaction.Join(null!));","+","+        transaction.Join(branch);","+        transaction.ReconcilePending();","+        Assert.Equal(0, transaction.PendingCalls);","+        Assert.Equal(branch.TimeStamp, transaction.TimeStamp);","+        Assert.False(transaction.TryToCommit);","+    }","+","+    [Fact]","+    public void MustAbort_RequiresSerializerForStoredException()","+    {","+        byte[] storedException = [1];","+        var transaction = new TransactionInfo { OriginalException = storedException };","+","+        Assert.Throws<ArgumentNullException>(\"serializer\", () => transaction.MustAbort(null!));","+","+        Assert.Same(storedException, transaction.OriginalException);","+    }","+","+    [Theory]","+    [InlineData(false)]","+    [InlineData(true)]","+    public void MustAbort_WithoutStoredExceptionDoesNotUseSerializer(bool pendingCall)","+    {","+        var transaction = new TransactionInfo();","+        if (pendingCall)","+        {","+            transaction.Fork();","+        }","+","+        var result = transaction.MustAbort(null!);","+","+        if (pendingCall)","+        {","+            Assert.IsType<OrleansOrphanCallException>(result);","+            Assert.Equal(1, transaction.PendingCalls);","+        }","+        else","+        {","+            Assert.Null(result);","+        }","+    }","+","+    [Fact]","+    public void RecordException_RequiresSerializerBeforeChangingStoredException()","+    {","+        var transaction = new TransactionInfo();","+","+        Assert.Throws<ArgumentNullException>(\"sm\",","+            () => transaction.RecordException(new InvalidOperationException(\"first failure\"), null!));","+","+        Assert.Null(transaction.OriginalException);","+    }","+","+    [Fact]","+    public void RecordException_PreservesFirstFailureWithoutUsingLaterSerializer()","+    {","+        using var services = new ServiceCollection().AddSerializer().BuildServiceProvider();","+        var serializer = services.GetRequiredService<Serializer<OrleansTransactionAbortedException>>();","+        var transaction = new TransactionInfo();","+        transaction.RecordException(new InvalidOperationException(\"first failure\"), serializer);","+        var storedException = transaction.OriginalException;","+","+        transaction.RecordException(new OperationCanceledException(\"later failure\"), null!);","+","+        Assert.Same(storedException, transaction.OriginalException);","+        var aborted = Assert.IsType<OrleansTransactionAbortedException>(transaction.MustAbort(serializer));","+        Assert.Equal(\"first failure\", Assert.IsType<InvalidOperationException>(aborted.InnerException).Message);","+    }","+}",""],"additions":127,"deletions":0,"truncated":false}],"additions":219,"deletions":3,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-14T15:14:27.979896+00:00"}