size_oblivious(u0 == 5)","+        self.assertIs(guard_size_oblivious(True), True)","+","+    def test_guard_size_oblivious_dynamo_unbacked(self):","+        @torch.compile(backend=\"eager\", fullgraph=True)","+        def f(x):","+            if guard_size_oblivious(x.numel() != 0):","+                return x + 1","+            return x","+","+        x = torch.ones(4)","+        torch._dynamo.decorators.mark_unbacked(x, 0)","+        self.assertEqual(f(x), x + 1)","+","     def test_baddbmm_symint(self):","         from torch._subclasses.fake_tensor import FakeTensorMode"," ","@@ -8352,8 +8416,7 @@ def test_transfer_is_self_short_circuit(self):","     def test_transfer_constrains_size_on_cache_hit(self):","         \"\"\"When is_size=True and the expression resolves to a single Symbol","         from the cache (cached via a non-size path earlier),","-        _constrain_range_for_size is still applied; the symbol ends up in","-        size_like.\"\"\"","+        _constrain_range_for_size is still applied on the cache hit.\"\"\"","         foreign_env = ShapeEnv()","         u0 = foreign_env.create_unbacked_symint()"," ","@@ -8363,17 +8426,16 @@ def test_transfer_constrains_size_on_cache_hit(self):","             local_env, u0, source=self._make_source(\"raw\")","         )","         raw = raw_symint.node.expr","-        self.assertNotIn(raw, local_env.size_like)","+        self.assertEqual(local_env.var_to_range[raw].lower, -int_oo)"," ","         # Now: transfer the same u0 as a tensor size dim (is_size=True via","         # transfer_symbols_from_foreign_shape_env's UNBACKED path).","         new_sizes, _, _ = local_env.transfer_symbols_from_foreign_shape_env(","             (u0,), (1,), 0, source=self._make_source(\"tensor\")","         )","-        # Same cached local symbol reused.","+        # Same cached local symbol reused, now with the size lower bound.","         self.assertEqual(new_sizes[0].node.expr, raw)","-        # And now it carries the size lower