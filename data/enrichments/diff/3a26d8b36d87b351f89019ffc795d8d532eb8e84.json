{"id":"3a26d8b36d87b351f89019ffc795d8d532eb8e84","axis":"silent","repo":"matomo-org/matomo","sha":"3a26d8b36d87b351f89019ffc795d8d532eb8e84","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -8,6 +8,7 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," "," ### New config.ini.php settings"," * `[log] log_format` (and `log_format_<writer>` per writer) lets the file, database, errorlog and syslog log writers write `json`, `loggly` or `logstash` instead of `text`.","+* `[General] archive_failure_retry_delays` and `[General] archive_failure_max_attempts` set how long `core:archive` waits before retrying a failed archive and after how many failed attempts it stops retrying. Jobs still running after `[General] archive_failure_recovery_timeout` now count as a failed attempt instead of being queued again right away."," "," ### New APIs"," * Controller actions can ask the user to confirm with their second factor, e.g. a two-factor authentication code, by calling `Piwik\\Plugins\\Login\\SecondFactorVerifier::requireSecondFactorConfirmed()`. Each confirmation can be used once, for that action only.","@@ -15,6 +16,10 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," * The *Administration → Development → Component Library* page, available in development mode, documents the generic components, starting with the selector (`.mtm-selector`), and what each Matomo version changes in them."," * The `ExpandOnHover` Vue directive now takes the `expandedClass` option of `ExpandOnClick`, and both directives accept a list of classes for it."," * The Monolog plugin's DI entry `log.formatter.classes` maps log format names to formatter classes and can be extended by plugins to add log formats.","+* `archive_invalidations.status` can now be `Piwik\\Archive\\ArchiveInvalidator::INVALIDATION_STATUS_ON_HOLD` (`2`): `core:archive` doesn't process such invalidations until the failed archive they wait for can be retried.","+","+### New commands","+* `core:archive-failures` lists the archives `core:archive` failed to process and resets them, so they are retried in the next run."," "," ### Deprecations"," * The `disabled` class on a `.mtm-selector` is deprecated and will be removed in Matomo 7; use the `mtm-selector--disabled` modifier instead."],"additions":5,"deletions":0,"truncated":false},{"path":"config/global.ini.php","lines":["@@ -404,6 +404,15 @@"," ; Do not configure this value lower than the maximum time it can take for the longest running archiving job to finish"," archive_failure_recovery_timeout = 86400"," ","+; core:archive skips an archive that failed, and the periods built from it, until this many seconds have passed.","+; One comma separated value per failed attempt, the last one is used for any further attempt. Each value is capped at","+; one year, an invalid list is ignored in favour of the default.","+archive_failure_retry_delays = \"3600,21600,86400\"","+","+; After this many failed attempts core:archive stops retrying an archive (minimum 1).","+; Use ./console core:archive-failures to list failed archives and retry them.","+archive_failure_max_attempts = 5","+"," ; This setting is overridden in the UI, under \"General Settings\"."," ; The default value is to allow browsers to trigger the Matomo archiving process."," ; This setting is only used if it hasn't been overridden via the UI yet, or if enable_general_settings_admin=0"],"additions":9,"deletions":0,"truncated":false},{"path":"core/Archive/ArchiveInvalidator.php","lines":["@@ -61,6 +61,11 @@ class ArchiveInvalidator","     public const INVALIDATION_STATUS_QUEUED = 0;","     public const INVALIDATION_STATUS_IN_PROGRESS = 1;"," ","+    /**","+     * Not processed until a failure of its archive, or of an archive it is built from, can be retried.","+     */","+    public const INVALIDATION_STATUS_ON_HOLD = 2;","+","     private $rememberArchivedReportIdStart = 'report_to_invalidate_';"," ","     private Model $model;"],"additions":5,"deletions":0,"truncated":false},{"path":"core/CronArchive.php","lines":["@@ -22,6 +22,7 @@"," use Piwik\\CronArchive\\QueueConsumer;"," use Piwik\\CronArchive\\SharedSiteIds;"," use Piwik\\CronArchive\\StopArchiverException;","+use Piwik\\DataAccess\\ArchiveFailures;"," use Piwik\\DataAccess\\ArchiveSelector;"," use Piwik\\DataAccess\\ArchiveWriter;"," use Piwik\\DataAccess\\Model;","@@ -89,6 +90,12 @@ class CronArchive","      */","     private $model;"," ","+    private ArchiveFailures $archiveFailures;","+","+    private int $failedArchivesCount = 0;","+","+    private bool $isUpdatedWhileArchiving = false;","+","     private $lastSuccessRunTimestamp = false;","     private $errors = [];"," ","@@ -249,6 +256,9 @@ class CronArchive","     private const STEP_SCHEDULED_TASKS = 3;","     private const STEP_FINISH = 4;"," ","+    private const UNSUPPORTED_SEGMENT_PATTERN = \"/Segment (.*?) is not a supported segment/i\";","+    private const UPDATE_REQUIRED_PATTERN = \"/some plugins have been upgraded to a new version|Database Upgrade Required\\\\. Your Matomo database is out-of-date/\";","+","     public function __construct(?LoggerInterface $logger = null)","     {","         $this->logger = $logger ?: StaticContainer::get(LoggerInterface::class);","@@ -259,6 +269,7 @@ public function __construct(?LoggerInterface $logger = null)","         $this->isArchiveProfilingEnabled = Config::getInstance()->Debug['archiving_profile'] == 1;"," ","         $this->model = StaticContainer::get(Model::class);","+        $this->archiveFailures = new ArchiveFailures();"," ","         $this->periodIdsToLabels = array_flip(Piwik::$idPeriods);"," ","@@ -412,12 +423,7 @@ public function run()","             $this->invalidator->applyScheduledReArchiving();","         });"," ","-        $failedJobs = $this->model->resetFailedArchivingJobs();","-        if ($failedJobs) {","-            $this->logger->info(\"Found {failed} failed jobs (ts_invalidated older than 1 day), resetting status to try them again.\", [","-                'failed' => $failedJobs,","-            ]);","-        }","+        $this->handleTimedOutArchivingJobs();"," ","         $countOfProcesses = $this->getMaxConcurrentApiRequests();"," ","@@ -468,6 +474,10 @@ public function run()"," ","             $successCount = $this->launchArchivingFor($archivesToProcess, $queueConsumer);","             $numArchivesFinished += $successCount;","+","+            if ($this->isUpdatedWhileArchiving) {","+                break;","+            }","             if ($this->maxArchivesToProcess && $numArchivesFinished >= $this->maxArchivesToProcess) {","                 $this->logger->info(\"Maximum number of archives to process per execution has been reached.\");","                 break;","@@ -485,6 +495,7 @@ public function run()"," ","         $this->logSection(\"SUMMARY\");","         $this->logger->info(\"Processed $numArchivesFinished archives.\");","+        $this->logArchiveFailuresSummary();","         $this->logger->info(\"Total API requests: {$this->requests}\");"," ","         $this->logger->info(\"done: \" . $this->requests . \" req, \" . round($timer->getTimeMs()) . \" ms, \" . (empty($this->errors)","@@ -552,7 +563,8 @@ private function launchArchivingFor($archives, QueueConsumer $queueConsumer)","                 $archiveWriter->finalizeArchive();"," ","                 // site is using the tracker, but there are no visits for this period, so just delete the archive and move on","-                $this->deleteInvalidatedArchives($archive);","+                $this->model->deleteProcessedInvalidation($archive);","+                $this->releaseArchivesHeldBy($archive);","                 continue;","             }"," ","@@ -576,34 +588,49 @@ private function launchArchivingFor($archives, QueueConsumer $queueConsumer)","         $timers = $this->cliMultiHandler->getTimers();","         $successCount = 0;"," ","+        $isUpdateRequired = false;","+","         foreach ($urls as $index => $url) {","             $content = array_key_exists($index, $responses) ? $responses[$index] : null;","+            $archive = $archivesBeingQueried[$index];"," ","-            if (null !== $this->signal && empty($content)) {","+            $stats = json_decode((string) $content, $assoc = true);","+            $isErrorResponse = !is_array($stats) || ($stats['result'] ?? null) === 'error';","+","+            if (null !== $this->signal && $isErrorResponse) {","                 // processes killed by system","-                $idinvalidation = $archivesBeingQueried[$index]['idinvalidation'];","+                $this->model->releaseInProgressInvalidations([$archive['idinvalidation']]);","+                $this->logger->info('Archiving process killed, reset invalidation with id ' . $archive['idinvalidation']);","+","+                continue;","+            }"," ","-                $this->model->releaseInProgressInvalidations([$idinvalidation]);","-                $this->logger->info('Archiving process killed, reset invalidation with id ' . $idinvalidation);","+            if ($isErrorResponse && preg_match(self::UPDATE_REQUIRED_PATTERN, (string) $content)) {","+                // Matomo was updated while archiving, the archive itself did not fail","+                $this->model->releaseInProgressInvalidations([$archive['idinvalidation']]);","+                $isUpdateRequired = true;"," ","                 continue;","             }"," ","             $checkInvalid = $this->checkResponse($content, $url);"," ","-            $stats = json_decode($content, $assoc = true);","             if (!is_array($stats)) {","                 $this->logger->info(var_export($content, true));"," ","-                $idinvalidation = $archivesBeingQueried[$index]['idinvalidation'];","-                $this->model->releaseInProgressInvalidations([$idinvalidation]);","-","-                $queueConsumer->ignoreIdInvalidation($idinvalidation);","+                $this->handleFailedArchive($archive, empty($content) ? 'Empty response' : (string) $content, $queueConsumer);"," ","                 $this->logError(\"Error unserializing the following response from $url: '\" . $content . \"'\");","                 continue;","             }"," ","+            $errorMessage = isset($stats['message']) && is_scalar($stats['message']) ? (string) $stats['message'] : null;","+            if ($isErrorResponse && !preg_match(self::UNSUPPORTED_SEGMENT_PATTERN, (string) $errorMessage)) {","+                // the error was already logged by checkResponse()","+                $this->handleFailedArchive($archive, $errorMessage ?? (string) $content, $queueConsumer);","+                continue;","+            }","+","             $visitsForPeriod = $this->getVisitsFromApiResponse($stats);","             $peakMemory = $this->getPeakMemoryFromApiResponse($stats);"," ","@@ -611,24 +638,163 @@ private function launchArchivingFor($archives, QueueConsumer $queueConsumer)","                 $url,","                 $timers[$index],","                 $visitsForPeriod,","-                $archivesBeingQueried[$index]['plugin'],","-                $archivesBeingQueried[$index]['report'],","+                $archive['plugin'],","+                $archive['report'],","                 !$checkInvalid,","                 $peakMemory","             );"," ","-            $this->deleteInvalidatedArchives($archivesBeingQueried[$index]);","+            $this->model->deleteProcessedInvalidation($archive);","+            $this->releaseArchivesHeldBy($archive);"," ","-            $this->repairInvalidationsIfNeeded($archivesBeingQueried[$index]);","+            $this->repairInvalidationsIfNeeded($archive);"," ","             ++$successCount;","         }"," ","+        if ($isUpdateRequired) {","+            $this->isUpdatedWhileArchiving = true;","+            $this->logError(\"Archiving stopped because Matomo or plugins were updated while archiving. Run ./console core:update before archiving again.\");","+        }","+","         $this->requests += count($urls);"," ","         return $successCount;","     }"," ","+    /**","+     * @param array<array-key, string|int|float|null> $archive","+     */","+    private function handleFailedArchive(array $archive, string $error, QueueConsumer $queueConsumer): void","+    {","+        $queueConsumer->ignoreIdInvalidation($archive['idinvalidation']);","+        ++$this->failedArchivesCount;","+","+        if (!ArchiveFailures::isAvailable()) {","+            $this->model->releaseInProgressInvalidations([$archive['idinvalidation']]);","+            return;","+        }","+","+        $this->recordFailureOfHeldJob($archive, $error);","+    }","+","+    /**","+     * Jobs still in progress after archive_failure_recovery_timeout count as failed, so a job that hangs every time","+     * doesn't block another archiver each day.","+     */","+    private function handleTimedOutArchivingJobs(): void","+    {","+        if (!ArchiveFailures::isAvailable()) {","+            $this->model->resetFailedArchivingJobs();","+            return;","+        }","+","+        $timedOutJobs = $this->model->getTimedOutArchivingJobs();","+        if (empty($timedOutJobs)) {","+            return;","+        }","+","+        $this->logger->warning(\"Found {count} archiving jobs that did not finish within [General] archive_failure_recovery_timeout.\", [","+            'count' => count($timedOutJobs),","+        ]);","+","+        foreach ($timedOutJobs as $job) {","+            $this->recordFailureOfHeldJob($job, sprintf(","+                'Archiving did not finish within %d seconds (started %s UTC on host %s, process %s)',","+                $job['recovery_timeout'],","+                $job['ts_started'],","+                $job['processing_host'] ?? '',","+                $job['process_id'] ?? ''","+            ));","+        }","+    }","+","+    /**","+     * Puts the invalidation of a failed job on hold, then records the failure. Holding it first makes sure a failure is","+     * counted once, eg when a job that timed out and was reset by another archiver fails later, and not at all if the","+     * job finished meanwhile.","+     *","+     * @param array<array-key, string|int|float|null> $archive","+     */","+    private function recordFailureOfHeldJob(array $archive, string $error): void","+    {","+        if (!$this->model->holdFailedInvalidation($archive)) {","+            return;","+        }","+","+        try {","+            $failure = $this->archiveFailures->recordFailure($archive, $error);","+        } catch (\\Exception $e) {","+            // the invalidation is released again when its site is processed","+            $this->logError(\"Could not record the failed archive of invalidation {$archive['idinvalidation']}: \" . $e->getMessage());","+            return;","+        }","+","+        if (null !== $failure) {","+            $this->logFailedArchive($archive, $failure);","+        }","+    }","+","+    /**","+     * @param array<array-key, string|int|float|null> $archive","+     * @param array{attempts: int, maxAttempts: int, retryAfter: string, givenUp: bool} $failure","+     */","+    private function logFailedArchive(array $archive, array $failure): void","+    {","+        $period = $this->periodIdsToLabels[(int) $archive['period']];","+        // jobs that timed out are read from the database, without the segment definition","+        $description = \"idSite = {$archive['idsite']}, period = $period, date = {$archive['date1']},{$archive['date2']}\"","+            . (array_key_exists('segment', $archive) ? \", segment = '\" . $archive['segment'] . \"'\" : \", name = {$archive['name']}\")","+            . (!empty($archive['plugin']) ? \", plugin = {$archive['plugin']}\" : '')","+            . (!empty($archive['report']) ? \", report = {$archive['report']}\" : '');","+","+        if ($failure['givenUp']) {","+            $this->logger->warning(\"Archiving failed for $description (attempt {$failure['attempts']} of {$failure['maxAttempts']}), giving up. \"","+                . \"Run ./console core:archive-failures to list failed archives and retry them.\");","+        } else {","+            $this->logger->info(\"Archiving failed for $description (attempt {$failure['attempts']} of {$failure['maxAttempts']}), \"","+                . \"it will be retried after {$failure['retryAfter']} UTC.\");","+        }","+    }","+","+    /**","+     * Once an archive that had failed is processed, the archives that were on hold because of it can be processed.","+     *","+     * @param array<array-key, string|int|float|null> $archive","+     */","+    private function releaseArchivesHeldBy(array $archive): void","+    {","+        if ($this->archiveFailures->deleteFailure($archive) === 0) {","+            return;","+        }","+","+        $released = $this->archiveFailures->releaseUnblockedInvalidations((int) $archive['idsite'], $archive);","+        if ($released > 0) {","+            $this->logger->debug(\"Released {released} invalidations that were on hold until {name} for {period} {date1},{date2} was archived.\", [","+                'released' => $released,","+                'name' => $archive['name'],","+                'period' => $this->periodIdsToLabels[(int) $archive['period']],","+                'date1' => $archive['date1'],","+                'date2' => $archive['date2'],","+            ]);","+        }","+    }","+","+    private function logArchiveFailuresSummary(): void","+    {","+        if (!ArchiveFailures::isAvailable()) {","+            return;","+        }","+","+        $counts = $this->archiveFailures->getFailureCounts();","+        if ($this->failedArchivesCount === 0 && $counts['waiting'] === 0 && $counts['givenUp'] === 0) {","+            return;","+        }","+","+        $this->logger->info(\"Archiving failed for {$this->failedArchivesCount} archives in this run. {$counts['waiting']} failed archives are \"","+            . \"waiting for a retry and {$counts['givenUp']} were given up. Run ./console core:archive-failures for details.\");","+    }","+","     private function deleteInvalidatedArchives($archive)","     {","         $this->model->deleteInvalidations([$archive]);","@@ -834,7 +1000,7 @@ public function logError($m)","     private function logNetworkError($url, $response)","     {"," ","-        if (preg_match(\"/Segment (.*?) is not a supported segment/i\", $response, $match)) {","+        if (preg_match(self::UNSUPPORTED_SEGMENT_PATTERN, $response, $match)) {","             $this->logger->info($match[0]);","             return false;","         }","@@ -1213,7 +1379,8 @@ public function repairInvalidationsIfNeeded($archiveToProcess)","         }"," ","         $sql = \"SELECT DISTINCT period FROM `$table`","-                 WHERE idsite = ? AND name = ? AND period > ? AND ? >= date1 AND date2 >= ? AND status = \" . ArchiveInvalidator::INVALIDATION_STATUS_QUEUED . \" $reportClause\";","+                 WHERE idsite = ? AND name = ? AND period > ? AND ? >= date1 AND date2 >= ?","+                   AND status IN (\" . ArchiveInvalidator::INVALIDATION_STATUS_QUEUED . \", \" . ArchiveInvalidator::INVALIDATION_STATUS_ON_HOLD . \") $reportClause\";"," ","         $higherPeriods = Db::fetchAll($sql, $bind);","         $higherPeriods = array_column($higherPeriods, 'period');"],"additions":189,"deletions":22,"truncated":false},{"path":"core/CronArchive/QueueConsumer.php","lines":["@@ -12,6 +12,7 @@"," use Piwik\\ArchiveProcessor\\Parameters;"," use Piwik\\ArchiveProcessor\\Rules;"," use Piwik\\CronArchive;","+use Piwik\\DataAccess\\ArchiveFailures;"," use Piwik\\DataAccess\\ArchiveSelector;"," use Piwik\\DataAccess\\Model;"," use Piwik\\Date;","@@ -56,6 +57,8 @@ class QueueConsumer"," ","     private array $invalidationsToExclude;"," ","+    private ArchiveFailures $archiveFailures;","+","     /**","      * @var string[]","      */","@@ -110,6 +113,7 @@ public function __construct(","         // if we skip or can't process an idarchive, we want to ignore it the next time we look for an invalidated","         // archive. these IDs are stored here (using a list like this serves to keep our SQL simple).","         $this->invalidationsToExclude = [];","+        $this->archiveFailures = new ArchiveFailures();"," ","         $this->periodIdsToLabels = array_flip(Piwik::$idPeriods);","     }","@@ -159,6 +163,8 @@ public function getNextArchivesToProcess()","             // and then stop until the next hour.","             $this->cronArchive->invalidateArchivedReportsForSitesThatNeedToBeArchivedAgain($this->idSite);"," ","+            $this->cleanUpArchiveFailures((int) $this->idSite);","+","             $this->currentSiteArchivingStartTime = Date::now()->getDatetime();","         }"," ","@@ -170,6 +176,10 @@ public function getNextArchivesToProcess()"," ","         $siteCreationTime = Date::factory(Site::getCreationDateFor($this->idSite));"," ","+        // checked per batch: a failure recorded meanwhile is seen by the next one, and startArchive() refuses the","+        // archives it blocks anyway","+        $siteHasArchiveFailures = $this->archiveFailures->hasFailures((int) $this->idSite);","+","         // get archives to process simultaneously","         $archivesToProcess = [];","         while (count($archivesToProcess) < $this->countOfProcesses) {","@@ -202,6 +212,14 @@ public function getNextArchivesToProcess()","                 continue;","             }"," ","+            // archives that failed recently or were given up, and the periods built from them, wait until a retry","+            $holdResult = $siteHasArchiveFailures ? $this->archiveFailures->holdIfBlocked($invalidatedArchive) : null;","+            if (null !== $holdResult) {","+                $this->logger->debug(\"Invalidation {$holdResult} because a failed archive blocks it: $invalidationDesc\");","+                $this->addInvalidationToExclude($invalidatedArchive);","+                continue;","+            }","+","             if ($this->archiveArrayContainsArchive($archivesToProcess, $invalidatedArchive)) {","                 $this->logger->debug(\"Found duplicate invalidated archive {$invalidatedArchive['idarchive']}, ignoring: $invalidationDesc\");","                 $this->addInvalidationToExclude($invalidatedArchive);","@@ -262,7 +280,7 @@ public function getNextArchivesToProcess()"," ","             $started = $this->model->startArchive($invalidatedArchive);","             if (!$started) { // another process started on this archive, pull another one","-                $this->logger->debug(\"Archive invalidation is being handled by another process: $invalidationDesc\");","+                $this->logger->debug(\"Archive invalidation is being handled by another process or failed recently: $invalidationDesc\");","                 $this->addInvalidationToExclude($invalidatedArchive);","                 continue;","             }","@@ -511,6 +529,78 @@ public function ignoreIdInvalidation($idinvalidation): void","         $this->invalidationsToExclude[$idinvalidation] = $idinvalidation;","     }"," ","+    /**","+     * Removes failures whose invalidations can no longer be processed (eg segment deleted, plugin deactivated), and","+     * releases the invalidations on hold that no failure blocks anymore, eg because the retry delay passed. Those","+     * of removed failures get deleted when they are fetched.","+     */","+    private function cleanUpArchiveFailures(int $idSite): void","+    {","+        $this->removeArchiveFailuresThatCanNotBeProcessed($idSite);","+","+        $released = $this->archiveFailures->releaseUnblockedInvalidations($idSite);","+        if ($released > 0) {","+            $this->logger->info(\"Released {released} invalidations that were on hold because of failed archives.\", ['released' => $released]);","+        }","+    }","+","+    private function removeArchiveFailuresThatCanNotBeProcessed(int $idSite): void","+    {","+        $archiveFailures = $this->archiveFailures;","+        $failures = $archiveFailures->getFailures([$idSite], false, false);","+        if (empty($failures)) {","+            return;","+        }","+","+        if ($archiveFailures->deleteFailuresWithoutInvalidations($idSite) > 0) {","+            $failures = $archiveFailures->getFailures([$idSite], false, false);","+        }","+","+        $siteCreationDate = Date::factory(Site::getCreationDateFor($idSite))->toString();","+        $idFailuresToDelete = [];","+        $skippedCounts = [ArchiveFailures::STATE_WAITING => 0, ArchiveFailures::STATE_GIVEN_UP => 0];","+        // the checks only depend on the period and the done flag, which many failures share","+        $isPeriodProcessable = [];","+        $isNameProcessable = [];","+","+        foreach ($failures as $failure) {","+            $period = (int) $failure['period'];","+            $name = (string) $failure['name'];","+","+            if (!isset($isPeriodProcessable[$period])) {","+                $periodLabel = $this->periodIdsToLabels[$period] ?? null;","+                $isPeriodProcessable[$period] = !empty($periodLabel)","+                    && PeriodFactory::isPeriodEnabledForAPI($periodLabel)","+                    && !PeriodFactory::isAnyLowerPeriodDisabledForAPI($periodLabel);","+            }","+","+            if (!isset($isNameProcessable[$name])) {","+                $plugin = $this->getPluginNameForArchiveIfAny($failure);","+                $isNameProcessable[$name] = (empty($plugin) || Manager::getInstance()->isPluginActivated($plugin))","+                    && $this->findSegmentForArchive($failure);","+            }","+","+            if (","+                !$isPeriodProcessable[$period]","+                || !$isNameProcessable[$name]","+                || $failure['date2'] < $siteCreationDate","+            ) {","+                $idFailuresToDelete[] = (int) $failure['idfailure'];","+            } elseif (isset($skippedCounts[$failure['state']])) {","+                ++$skippedCounts[$failure['state']];","+            }","+        }","+","+        $archiveFailures->deleteFailuresById($idFailuresToDelete);","+","+        if ($skippedCounts[ArchiveFailures::STATE_WAITING] > 0 || $skippedCounts[ArchiveFailures::STATE_GIVEN_UP] > 0) {","+            $this->logger->info(\"Holding back {waiting} archives that failed recently and {givenUp} that were given up, along with the periods built from them. Run ./console core:archive-failures for details.\", [","+                'waiting' => $skippedCounts[ArchiveFailures::STATE_WAITING],","+                'givenUp' => $skippedCounts[ArchiveFailures::STATE_GIVEN_UP],","+            ]);","+        }","+    }","+","     public function skipToNextSite(): void","     {","         $this->idSite = null;"],"additions":91,"deletions":1,"truncated":false},{"path":"core/DataAccess/ArchiveFailures.php","lines":["@@ -0,0 +1,745 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\DataAccess;","+","+use Piwik\\Archive\\ArchiveInvalidator;","+use Piwik\\Common;","+use Piwik\\Config\\GeneralConfig;","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Date;","+use Piwik\\Db;","+use Piwik\\DbHelper;","+use Piwik\\Period\\Range;","+use Piwik\\Log\\LoggerInterface;","+use Piwik\\Piwik;","+","+/**","+ * Archives that core:archive failed to process. Their invalidations, and those of the periods built from them, are","+ * put on hold (ArchiveInvalidator::INVALIDATION_STATUS_ON_HOLD) until the retry delay has passed, and for good once","+ * the maximum attempts are reached.","+ *","+ * @phpstan-type DbRow array<array-key, string|int|float|null>","+ * @phpstan-type BindValues list<string|int|float|null>","+ *","+ * @internal","+ */","+class ArchiveFailures","+{","+    public const STATE_WAITING = 'waiting';","+    public const STATE_RETRY_PENDING = 'retry pending';","+    public const STATE_GIVEN_UP = 'given up';","+","+    private const DEFAULT_MAX_ATTEMPTS = 5;","+    private const DEFAULT_RETRY_DELAYS = [3600, 21600, 86400];","+    private const MAX_RETRY_DELAY = 31536000;","+    private const MAX_ERROR_LENGTH = 1000;","+    private const INVALIDATIONS_CHUNK_SIZE = 50000;","+    private const FAILURES_CHUNK_SIZE = 10000;","+","+    private static bool $isAvailable = false;","+","+    public static function getTable(): string","+    {","+        return Common::prefixTable('archive_failures');","+    }","+","+    /**","+     * The table does not exist yet while the database upgrade that adds it is pending.","+     */","+    public static function isAvailable(): bool","+    {","+        if (!self::$isAvailable) {","+            self::$isAvailable = DbHelper::tableExists(self::getTable());","+        }","+","+        return self::$isAvailable;","+    }","+","+    public static function getMaxAttempts(int $idSite): int","+    {","+        $maxAttempts = GeneralConfig::getIntegerConfigValue('archive_failure_max_attempts', self::DEFAULT_MAX_ATTEMPTS, $idSite);","+","+        return max(1, $maxAttempts);","+    }","+","+    /**","+     * Seconds to wait before retrying an archive that failed for the given number of times.","+     */","+    public static function getRetryDelay(int $idSite, int $attempts): int","+    {","+        $configuredDelays = GeneralConfig::getConfigValue('archive_failure_retry_delays', $idSite);","+        if (!is_array($configuredDelays)) {","+            $configuredDelays = explode(',', is_scalar($configuredDelays) ? (string) $configuredDelays : '');","+        }","+","+        $delays = [];","+        foreach ($configuredDelays as $delay) {","+            $delay = is_scalar($delay) ? trim((string) $delay) : '';","+            if (!ctype_digit($delay) || (int) $delay === 0) {","+                // an invalid list is ignored as a whole rather than misread, eg \"1h\" as 1 second","+                StaticContainer::get(LoggerInterface::class)->warning(","+                    'Invalid value for [General] archive_failure_retry_delays, it must be a comma separated list of seconds. Using the default instead.'","+                );","+                $delays = self::DEFAULT_RETRY_DELAYS;","+                break;","+            }","+","+            $delays[] = min((int) $delay, self::MAX_RETRY_DELAY);","+        }","+","+        if (empty($delays)) {","+            $delays = self::DEFAULT_RETRY_DELAYS;","+        }","+","+        return $delays[min(max($attempts, 1), count($delays)) - 1];","+    }","+","+    /**","+     * Records a failed attempt to process the archive of the given invalidation.","+     *","+     * @param DbRow $invalidation","+     * @return array{attempts: int, maxAttempts: int, retryAfter: string, givenUp: bool}|null null if failures can't be recorded yet","+     */","+    public function recordFailure(array $invalidation, string $error): ?array","+    {","+        if (!self::isAvailable()) {","+            return null;","+        }","+","+        $idSite = (int) $invalidation['idsite'];","+        $now = Date::now();","+        $error = $this->trimError($error);","+","+        // the row must never look retryable before its final retry time is set below","+        $retryAfter = $this->getRetryAfter($now, $idSite, 1);","+","+        $table = self::getTable();","+        Db::query(","+            \"INSERT INTO `$table` (idsite, period, date1, date2, archive_hash, name, `report`, attempts, last_error, ts_first_failed, ts_last_failed, ts_retry_after)"],"additions":127,"deletions":0,"truncated":false}],"additions":426,"deletions":23,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-11-16T17:23:56.227710+00:00"}