] == \"open_at_stop\")","+            window_end = next(e for e in events if e[\"name\"] == \"Record Window End\")","+            # Decimal preserves nanosecond precision for large trace timestamps.","+            span_end = span[\"ts\"] + span[\"dur\"]","+            # The trace ends at the stop, not when it is processed after the sleep.","+            self.assertNotIn(\"aten::mul_\", names, finish)","+            self.assertGreaterEqual(span_end, add[\"ts\"] + add[\"dur\"], finish)","+            self.assertLessEqual(span_end, window_end[\"ts\"], finish)","+            # An op still running at the stop ends inside the window too.","+            open_end = open_at_stop[\"ts\"] + open_at_stop[\"dur\"]","+            self.assertLessEqual(open_end, window_end[\"ts\"], finish)","+            self.assertLess(window_end[\"ts\"] - span[\"ts\"], 500_000, finish)","+","     def test_profiler_correlation_id(self):","         \"\"\"","         We expect the correlation_id of CPU operator events to be unique across"],"additions":42,"deletions":0,"truncated":false},{"path":"torch/_C/_autograd.pyi","lines":["@@ -124,6 +124,7 @@ def _toggle_collection_dynamic(","     activities: set[ProfilerActivity],"," ) -> None: ..."," def _toggle_python_collection_dynamic(enable: bool) -> None: ...","+def _stop_profiler_collection() -> None: ..."," def _disable_profiler() -> _ProfilerResult: ..."," def _profiler_enabled() -> bool: ..."," def _add_metadata_json(key: str, value: str) -> None: ..."],"additions":1,"deletions":0,"truncated":false},{"path":"torch/autograd/__init__.py","lines":["@@ -727,6 +727,7 @@ def variable(*args, **kwargs):","     _record_function_with_args_enter,","     _record_function_with_args_exit,","     _set_empty_test_observer,","+    _stop_profiler_collection,","     _supported_activities,","     _toggle_collection_dynamic,","     DeviceType,"],"additions":1,"deletions":0,"truncated":false},{"path":"torch/autograd/profiler.py","lines":["@@ -23,6 +23,7 @@","     _kineto