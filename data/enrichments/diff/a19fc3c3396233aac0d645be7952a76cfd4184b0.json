ector<ResourceInfo> getResourceInfos() override {","+    return {};","+  }","+  std::unique_ptr<CpuTraceBuffer> getTraceBuffer() override {","+    return nullptr;","+  }","+  void toggleCollectionDynamic(bool enable) override {","+    calls_.emplace_back(enable ? \"toggle on\" : \"toggle off\");","+  }","+","+ private:","+  std::vector<std::string>& calls_;","+};","+","+class RecordingProfiler : public IActivityProfiler {","+ public:","+  explicit RecordingProfiler(std::vector<std::string>& calls) : calls_(calls) {}","+  const std::string& name() const override {","+    return name_;","+  }","+  const std::set<ActivityType>& availableActivities() const override {","+    return activities_;","+  }","+  std::unique_ptr<IActivityProfilerSession> configure(","+      const std::set<ActivityType>& /*activityTypes*/,","+      const Config& /*config*/) override {","+    return std::make_unique<RecordingSession>(calls_);","+  }","+  std::unique_ptr<IActivityProfilerSession> configure(","+      int64_t /*tsMs*/,","+      int64_t /*durationMs*/,","+      const std::set<ActivityType>& activityTypes,","+      const Config& config) override {","+    return configure(activityTypes, config);","+  }","+","+ private:","+  const std::string name_{\"RecordingProfiler\"};","+  const std::set<ActivityType> activities_;","+  std::vector<std::string>& calls_;","+};","+","+} // namespace","+","+TEST(SyncActivityProfilerHandler, StopCollectionEndsTraceBeforeProcessing) {","+  GpuHookCounter profiler;","+  std::vector<std::string> calls;","+  profiler.addChildActivityProfiler(std::make_unique<RecordingProfiler>(calls));","+  SyncActivityProfilerHandler handler(profiler);","+","+  prepareTrace(handler, \"\");","+  handler.startTrace();","+  handler.stopCollection();","+  const int64_t stopped = libkineto::timeSinceEpoch(system_clock::now());","+  EXPECT_EQ(profiler.disableCalls, 1);","+  EXPECT_EQ(profiler.processCalls, 0);","+","+  // Collection stays stopped: a toggle does nothing, and stopTrace() only","+  // processes.","+  std::this_thread::sleep_for(milliseconds(10));","+  handler.stopCollection();","+  handler.toggleCollectionDynamic(true);","+  EXPECT_FALSE(profiler.toggledOn());","+  handler.stopTrace();","+","+  EXPECT_EQ(profiler.disableCalls, 1);","+  EXPECT_EQ(profiler.processCalls, 1);","+  EXPECT_LE(profiler.windowEnd(), stopped);","+  const std::vector<std::string> expected{\"stop\", \"process\"};","+  EXPECT_EQ(calls, expected);","+  EXPECT_FALSE(handler.isSyncActive());","+}","+","+TEST(SyncActivityProfilerHandler, CancelAfterStopCollectionStopsOnce) {","+  GpuHookCounter profiler;","+  std::vector<std::string> calls;","+  profiler.addChildActivityProfiler(std::make_unique<RecordingProfiler>(calls));","+  SyncActivityProfilerHandler handler(profiler);","+","+  prepareTrace(handler, \"\");","+  handler.startTrace();","+  handler.stopCollection();","+  handler.cancel();","+  EXPECT_FALSE(handler.isSyncActive());","+  EXPECT_EQ(profiler.disableCalls, 1);","+  EXPECT_EQ(calls, std::vector<std::string>{\"stop\"});","+","+  // The next trace stops and processes as usual.","+  calls.clear();","+  prepareTrace(handler, \"\");","+  handler.startTrace();","+  handler.stopTrace();","+  const std::vector<std::string> expected{\"stop\", \"process\"};","+  EXPECT_EQ(calls, expected);","+}"],"additions":124,"deletions":0,"truncated":false},{"path":"torch/csrc/profiler/kineto_shim.cpp","lines":["@@ -505,6 +505,12 @@ void toggleCollectionDynamic(const bool enable) {"," #endif // USE_KINETO"," }"," ","+void stopCollection() {","+#ifdef USE_KINETO","+  libkineto::api().activityProfiler().stopCollection();","+#endif // USE_KINETO","+}","+"," void startTrace() {"," #ifdef USE_KINETO","   libkineto::api().activityProfiler().startTrace();"],"additions":6,"deletions":0,"truncated":false},{"path":"torch/csrc/profiler/kineto_shim.h","lines":["@@ -134,6 +134,7 @@ TORCH_API void prepareTrace(","     const ProfilerExtensionMap& profiler_extensions = {});"," "," voi