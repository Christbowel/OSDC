{"id":"0188f021ef8e7d2fb70870c05f2838b7670eb9af","axis":"silent","repo":"matomo-org/matomo","sha":"0188f021ef8e7d2fb70870c05f2838b7670eb9af","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -75,6 +75,7 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," * `Piwik\\Plugins\\AIProviders\\AIRequestDecision::reportUsage()` lets an `AIProviders.checkFeatureAllowed` listener that allows an action still report the used, limit and remaining figures, which `getUsed()`, `getLimit()` and `getRemaining()` previously returned only after `deny()`. It is ignored once the decision is denied. With several listeners the report with the least remaining wins, and a report without a remaining figure (unlimited) never replaces one that has it."," * The `Archiver.filterRecordBuilders` event now also receives the `ArchiveProcessor` of the archive being built, so a listener can restrict or replace RecordBuilders for a specific site, period or segment. The RecordBuilder instances are shared by every archive built in the same request, so a listener should replace or remove entries rather than modify an instance. Existing listeners that take only `$recordBuilders` are unaffected."," * The new `Marketplace.pluginTrialRequested` event is posted after a user requests a trial of a plugin, with the plugin's name and display name, so an audit trail can record it. The requesting user is the current user.","+* The new `Marketplace.trialRequestEmailsUnsubscribed` event is posted with a user's login after they turn off plugin trial request emails from the link in one of those emails, so an audit trail can record it. The current user may be anonymous or someone other than that user, and a link that repeats the state the user is already in posts nothing."," "," ### Deprecations"," * `Piwik\\Tracker\\Visit::getTimeSpentReferrerAction()` and the `log_link_visit_action.time_spent_ref_action` column are deprecated. The accurate per-pageview time-on-page metric is now sourced from the new `log_page_view_time` log table written by `Piwik\\Plugins\\Actions\\Tracker\\PageViewTimeWriter`. The deprecated method and column remain functional through 6.x, because the archiver and the visits log still read them for pageviews that have no measured row (tracked before the upgrade, while `record_accurate_page_view_time` was off, or whose row could not be written). They are scheduled for removal in a future major version."],"additions":1,"deletions":0,"truncated":false},{"path":"core/Email/ContentGenerator.php","lines":["@@ -16,9 +16,12 @@ class ContentGenerator"," {","     /**","      * @param View|string $body","+     * @param string|null $unsubscribeLink When set, the footer shows a line with this link to unsubscribe","+     * @param string|null $unsubscribeFooterKey Translation key for that line, with a `%1$s` placeholder for","+     *                                          the link. Defaults to the scheduled report wording.","      * @return string","      */","-    public function generateHtmlContent($body)","+    public function generateHtmlContent($body, ?string $unsubscribeLink = null, ?string $unsubscribeFooterKey = null)","     {","         if ($body instanceof View) {","             HtmlReportEmailHeaderView::assignCommonParameters($body);","@@ -33,6 +36,8 @@ public function generateHtmlContent($body)"," ","         $footer = new View(\"@CoreHome/_htmlEmailFooter.twig\");","         HtmlReportEmailHeaderView::assignCommonParameters($footer);","+        $footer->unsubscribeLink = $unsubscribeLink;","+        $footer->unsubscribeFooterKey = $unsubscribeFooterKey;","         $footerHtml = $footer->render();"," ","         return $headerHtml . $bodyHtml . $footerHtml;"],"additions":6,"deletions":1,"truncated":false},{"path":"plugins/AnonymousPiwikUsageMeasurement","lines":["@@ -1 +1 @@","-Subproject commit b7fb2a0ad83d927b802fdcd130ac5e0c35eb0973","+Subproject commit a7269619ac24f89c2852c8fbf7834fed07397457"],"additions":1,"deletions":1,"truncated":false},{"path":"plugins/CoreHome/templates/_htmlEmailFooter.twig","lines":["@@ -20,7 +20,7 @@"," "," {% if unsubscribeLink|default is not empty %}","     {% set unsubLink %}<a style=\"color:#439fe0;\" href=\"{{ unsubscribeLink|e('html_attr') }}\">{{ 'ScheduledReports_Unsubscribe'|translate }}</a>{% endset %}","-    <p style='{{ footerParagraphStyle }}{% if hasWhiteLabel %}padding-top:30px;{% endif %}'>{{ 'ScheduledReports_UnsubscribeFooter'|translate(unsubLink)|raw }}.</p>","+    <p style='{{ footerParagraphStyle }}{% if hasWhiteLabel %}padding-top:30px;{% endif %}'>{{ unsubscribeFooterKey|default('ScheduledReports_UnsubscribeFooter')|translate(unsubLink)|raw }}.</p>"," {% endif %}"," "," </div>"],"additions":1,"deletions":1,"truncated":false},{"path":"plugins/Marketplace/Controller.php","lines":["@@ -32,10 +32,13 @@"," use Piwik\\Plugins\\Marketplace\\Input\\Sort;"," use Piwik\\Plugins\\Marketplace\\Plugins\\InvalidLicenses;"," use Piwik\\Plugins\\Marketplace\\PluginTrial\\Service as PluginTrialService;","+use Piwik\\Plugins\\Marketplace\\PluginTrial\\UnsubscribeToken;","+use Piwik\\Plugins\\UsersManager\\Model as UsersModel;"," use Piwik\\ProxyHttp;"," use Piwik\\Request;"," use Piwik\\SettingsPiwik;"," use Piwik\\SettingsServer;","+use Piwik\\Settings\\Storage\\UserScopedSettingsAccessManager;"," use Piwik\\Url;"," use Piwik\\View;"," ","@@ -44,6 +47,7 @@ class Controller extends \\Piwik\\Plugin\\ControllerAdmin","     public const UPDATE_NONCE = 'Marketplace.updatePlugin';","     public const INSTALL_NONCE = 'Marketplace.installPlugin';","     public const DOWNLOAD_NONCE_PREFIX = 'Marketplace.downloadPlugin.';","+    public const UNSUBSCRIBE_TRIAL_REQUEST_EMAILS_NONCE = 'Marketplace.unsubscribeTrialRequestEmails';"," ","     private const FAILURE_SUMMARY_NOTIFICATION_ID = 'Marketplace_PluginsCouldNotBeUpdated';"," ","@@ -443,6 +447,58 @@ private function keepPluginCardFields(array $plugin): array","         return array_intersect_key($plugin, array_flip($cardFields));","     }"," ","+    /**","+     * Linked from the trial request email, so it works without logging in: the token authorises the login.","+     */","+    public function unsubscribeTrialRequestEmails(): string","+    {","+        $view = new View('@Marketplace/unsubscribeTrialRequestEmails');","+        $this->setBasicVariablesNoneAdminView($view);","+        $view->linkTitle = Piwik::getRandomTitle();","+","+        $request = Request::fromRequest();","+        $login = $request->getStringParameter('login', '');","+        $token = $request->getStringParameter('token', '');","+","+        if (","+            !StaticContainer::get(UnsubscribeToken::class)->isValid($login, $token)","+            || empty((new UsersModel())->getUser($login))","+        ) {","+            $view->error = Piwik::translate('Marketplace_RequestTrialUnsubscribeInvalidLink');","+            return $view->render();","+        }","+","+        if ($request->getStringParameter('confirm', '') !== '') {","+            Nonce::checkNonce(self::UNSUBSCRIBE_TRIAL_REQUEST_EMAILS_NONCE);","+            $settings = StaticContainer::get(UserScopedSettingsAccessManager::class);","+            $wasOn = (bool) $settings->get('Marketplace', $login, UserSettings::NOTIFY_ON_PLUGIN_REQUEST, true);","+            $settings->set('Marketplace', $login, UserSettings::NOTIFY_ON_PLUGIN_REQUEST, false);","+","+            if ($wasOn) {","+                /**","+                 * Triggered after a user has turned off plugin trial request emails from the link in one of those","+                 * emails, so an audit trail can record it. Not posted when they were already off. The current user may","+                 * be anonymous or someone other than `$login`, so use `$login`.","+                 *","+                 * **Example**","+                 *","+                 *     Piwik::addAction('Marketplace.trialRequestEmailsUnsubscribed', function ($login) {","+                 *         $this->logActivity($login, 'unsubscribed from plugin trial request emails');","+                 *     });","+                 *","+                 * @param string $login The login of the user who unsubscribed.","+                 */","+                Piwik::postEvent('Marketplace.trialRequestEmailsUnsubscribed', [$login]);","+            }","+","+            $view->success = true;","+        } else {","+            $view->nonce = Nonce::getNonce(self::UNSUBSCRIBE_TRIAL_REQUEST_EMAILS_NONCE);","+        }","+","+        return $view->render();","+    }","+","     public function installAllPaidPlugins()","     {","         Piwik::checkUserHasSuperUserAccess();"],"additions":56,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/Emails/RequestTrialNotificationEmail.php","lines":["@@ -11,8 +11,11 @@"," "," namespace Piwik\\Plugins\\Marketplace\\Emails;"," ","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Email\\ContentGenerator;"," use Piwik\\Mail;"," use Piwik\\Piwik;","+use Piwik\\Plugins\\Marketplace\\PluginTrial\\UnsubscribeToken;"," use Piwik\\SettingsPiwik;"," use Piwik\\View;"," ","@@ -70,6 +73,20 @@ private function setUpEmail(): void","         $this->addTo($this->emailAddress);","         $this->setSubject($this->getDefaultSubject());","         $this->addReplyTo($this->getFrom(), $this->getFromName());","-        $this->setWrappedHtmlBody($this->getDefaultBodyView());","+        $this->setBodyHtml(StaticContainer::get(ContentGenerator::class)->generateHtmlContent(","+            $this->getDefaultBodyView(),","+            $this->getUnsubscribeLink(),","+            'Marketplace_RequestTrialUnsubscribeFooter'","+        ));","+    }","+","+    private function getUnsubscribeLink(): string","+    {","+        return SettingsPiwik::getPiwikUrl() . 'index.php?' . http_build_query([","+            'module' => 'Marketplace',","+            'action' => 'unsubscribeTrialRequestEmails',","+            'login' => $this->login,","+            'token' => StaticContainer::get(UnsubscribeToken::class)->generate($this->login),","+        ]);","     }"," }"],"additions":18,"deletions":1,"truncated":false},{"path":"plugins/Marketplace/PluginTrial/Request.php","lines":["@@ -14,6 +14,8 @@"," use Piwik\\Piwik;"," use Piwik\\Plugin\\Manager;"," use Piwik\\Plugins\\Marketplace\\Emails\\RequestTrialNotificationEmail;","+use Piwik\\Plugins\\Marketplace\\UserSettings;","+use Piwik\\Settings\\Storage\\UserScopedSettingsAccessManager;"," "," class Request"," {","@@ -89,13 +91,19 @@ public function wasRequested(): bool","     }"," ","     /**","-     * Send notification email to all super users","+     * Send notification email to all super users who have not turned these emails off","      */","     private function sendEmailToSuperUsers(): void","     {","         $superUsers = Piwik::getAllSuperUserAccessEmailAddresses();","+        $settings = StaticContainer::get(UserScopedSettingsAccessManager::class)","+            ->getValuesForAllUsers('Marketplace', [UserSettings::NOTIFY_ON_PLUGIN_REQUEST]);"," ","         foreach ($superUsers as $login => $email) {","+            if (!($settings[$login][UserSettings::NOTIFY_ON_PLUGIN_REQUEST] ?? true)) {","+                continue;","+            }","+","             $email = StaticContainer::getContainer()->make(","                 RequestTrialNotificationEmail::class,","                 ["],"additions":9,"deletions":1,"truncated":false},{"path":"plugins/Marketplace/PluginTrial/UnsubscribeToken.php","lines":["@@ -0,0 +1,33 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Plugins\\Marketplace\\PluginTrial;","+","+use Piwik\\SettingsPiwik;","+","+/**","+ * Signs the login in a trial request email's unsubscribe link, so the link works without logging in","+ * but cannot be altered to unsubscribe another user.","+ */","+class UnsubscribeToken","+{","+    private const PURPOSE = 'Marketplace.unsubscribeTrialRequestEmails';","+","+    public function generate(string $login): string","+    {","+        return hash_hmac('sha256', self::PURPOSE . '|' . $login, (string) SettingsPiwik::getSalt());","+    }","+","+    public function isValid(string $login, string $token): bool","+    {","+        return $login !== '' && hash_equals($this->generate($login), $token);","+    }","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/UserSettings.php","lines":["@@ -0,0 +1,44 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Plugins\\Marketplace;","+","+use Piwik\\Piwik;","+use Piwik\\Settings\\FieldConfig;","+use Piwik\\Settings\\Plugin\\UserSetting;","+","+class UserSettings extends \\Piwik\\Settings\\Plugin\\UserSettings","+{","+    public const NOTIFY_ON_PLUGIN_REQUEST = 'notifyOnPluginRequest';","+","+    public UserSetting $notifyOnPluginRequest;","+","+    protected function init()","+    {","+        $this->title = Piwik::translate('Marketplace_PluginRequestsSettingsTitle');","+","+        $this->notifyOnPluginRequest = $this->makeSetting(","+            self::NOTIFY_ON_PLUGIN_REQUEST,","+            true,","+            FieldConfig::TYPE_BOOL,","+            function (FieldConfig $field) {","+                $field->title = Piwik::translate('Marketplace_NotifyOnPluginRequest');","+                $field->uiControl = FieldConfig::UI_CONTROL_CHECKBOX;","+                $field->inlineHelp = Piwik::translate('Marketplace_NotifyOnPluginRequestHelp');","+            }","+        );","+","+        // only super users are sent plugin request emails","+        if (!Piwik::hasUserSuperUserAccess()) {","+            $this->notifyOnPluginRequest->setIsWritableByCurrentUser(false);","+        }","+    }","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/lang/en.json","lines":["@@ -116,6 +116,9 @@","         \"PluginUpdateAvailable\": \"You are using version %1$s and a new version %2$s is available.\",","         \"PluginVersionInfo\": \"%1$s from %2$s\",","         \"PluginWebsite\": \"Plugin Website\",","+        \"PluginRequestsSettingsTitle\": \"Plugin Requests\",","+        \"NotifyOnPluginRequest\": \"Notify me when a user requests a plugin.\",","+        \"NotifyOnPluginRequestHelp\": \"When enabled, you will receive an email when a user requests a plugin.\",","         \"TrialRequested\": \"Trial requested\",","         \"TrialRequestedNotification1\": \"A user has requested to start a trial of the %1$s plugin. To start this trial for free, go to %2$sthe marketplace%3$s and click on “Start free trial”.\",","         \"TrialRequestedNotification2\": \"For more information about the %1$s plugin, %2$sclick here%3$s.\",","@@ -131,6 +134,12 @@","         \"RequestTrialNotificationEmailMoreInfo\": \"For more information about the %1$s plugin, %2$sclick here%3$s.\",","         \"RequestTrialNotificationEmailSubject\": \"Matomo user request: free trial for %s plugin\",","         \"RequestTrialSubmitted\": \"Trial requested for plugin %s.\",","+        \"RequestTrialUnsubscribeConfirmation\": \"Are you sure you want to unsubscribe from plugin request email notifications?\",","+        \"RequestTrialUnsubscribeConfirmationDetail\": \"You will no longer receive emails when users request a plugin.\",","+        \"RequestTrialUnsubscribeFooter\": \"To unsubscribe from plugin request email notifications, please follow this link: %1$s\",","+        \"RequestTrialUnsubscribeInvalidLink\": \"This unsubscribe link is not valid.\",","+        \"RequestTrialUnsubscribeSuccess\": \"You have been successfully unsubscribed from plugin request email notifications.\",","+        \"RequestTrialUnsubscribeTitle\": \"Unsubscribe from plugin request emails\",","         \"ResetFilters\": \"Clear search\",","         \"ResultsFoundFor\": \"%1$s results found for \\\"%2$s\\\"\",","         \"Reviews\": \"Reviews\","],"additions":9,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/stylesheets/marketplace.less","lines":["@@ -228,3 +228,30 @@","         padding-bottom: 0;","     }"," }","+","+.marketplaceUnsubscribePage {","+    .loginSection {","+        margin-top: 32px;","+","+        > .col {","+            max-width: 750px;","+            float: none;","+            margin-left: auto;","+            margin-right: auto;","+        }","+    }","+","+    .loginForm form {","+        .row,","+        .submit {","+            margin-bottom: 0;","+        }","+    }","+","+    // the ID is needed to outrank Login's `#loginPage .message`","+    &#loginPage .loginForm .message {","+        .inDarkMode({","+            background-color: transparent;","+        });","+    }","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/templates/unsubscribeTrialRequestEmails.twig","lines":["@@ -0,0 +1,66 @@","+{% extends '@Morpheus/layout.twig' %}","+","+{% block meta %}","+    <meta name=\"robots\" content=\"noindex,nofollow\">","+{% endblock %}","+","+{% set title %}{{ 'Marketplace_RequestTrialUnsubscribeTitle'|translate }}{% endset %}","+","+{% set bodyId = 'loginPage' %}","+{% set bodyClass = 'marketplaceUnsubscribePage' %}","+","+{% block body %}","+","+    {{ postEvent(\"Template.beforeTopBar\", \"login\") }}","+    {{ postEvent(\"Template.beforeContent\", \"login\") }}","+","+    {% include \"_iframeBuster.twig\" %}","+","+    <div id=\"notificationContainer\">","+    </div>","+    <nav>","+        <div class=\"nav-wrapper\">","+            {% include \"@CoreHome/_logo.twig\" with { 'logoLink': 'https://matomo.org', 'centeredLogo': true, 'useLargeLogo': false } %}","+        </div>","+    </nav>","+","+    <section class=\"loginSection row\">","+        <div class=\"col s12 m6 l4\">","+","+            <div class=\"contentForm loginForm\">","+                {% embed 'contentBlock.twig' with {'title': 'Marketplace_RequestTrialUnsubscribeTitle'|translate} %}","+                {% block content %}","+                    {% if error is defined %}","+                        <div vue-entry=\"CoreHome.Notification\"","+                             noclear=\"true\"","+                             context=\"&quot;error&quot;\">","+                            <strong>{{ 'General_Error'|translate }}</strong>: {{ error }}<br/>","+                        </div>","+                    {% elseif success is defined %}","+                        <p class=\"message\">{{ 'Marketplace_RequestTrialUnsubscribeSuccess'|translate }}</p>","+                    {% else %}","+                        <form method=\"POST\">","+                            <div class=\"row\">","+                                <div class=\"col s12\">","+                                    <br/>","+                                    <p>{{ 'Marketplace_RequestTrialUnsubscribeConfirmation'|translate }}</p>","+                                    <p>{{ 'Marketplace_RequestTrialUnsubscribeConfirmationDetail'|translate }}</p>","+                                    <br /><br /><br />","+                                    <input type=\"hidden\" name=\"nonce\" value=\"{{ nonce }}\"/>","+                                    <input class=\"submit btn\" type=\"submit\" name=\"confirm\" value=\"{{ 'ScheduledReports_Unsubscribe'|translate }}\"/>","+                                </div>","+                            </div>","+                        </form>","+                    {% endif %}","+                    {% if isCustomLogo %}","+                        <p id=\"piwik\">","+                            <i><a href=\"{{ 'https://matomo.org/'|trackmatomolink }}\" rel=\"noreferrer noopener\" target=\"_blank\">{{ linkTitle }}</a></i>","+                        </p>","+                    {% endif %}","+                {% endblock %}","+                {% endembed %}","+            </div>","+        </div>","+    </section>","+","+{% endblock %}"],"additions":66,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/tests/Integration/ControllerTest.php","lines":["@@ -11,6 +11,8 @@"," "," use Piwik\\Access;"," use Piwik\\Cache;","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Date;"," use Piwik\\DI;"," use Piwik\\FrontController;"," use Piwik\\Nonce;","@@ -23,7 +25,11 @@"," use Piwik\\Plugins\\Marketplace\\Api\\Service\\Exception as ServiceException;"," use Piwik\\Plugins\\Marketplace\\Controller;"," use Piwik\\Plugins\\Marketplace\\LicenseKey;","+use Piwik\\Plugins\\Marketplace\\PluginTrial\\UnsubscribeToken;"," use Piwik\\Plugins\\Marketplace\\tests\\Framework\\Mock\\Service;","+use Piwik\\Plugins\\Marketplace\\UserSettings;","+use Piwik\\Plugins\\UsersManager\\Model as UsersModel;","+use Piwik\\Settings\\Storage\\UserScopedSettingsAccessManager;"," use Piwik\\Tests\\Framework\\Fixture;"," use Piwik\\Tests\\Framework\\TestCase\\IntegrationTestCase;"," use Piwik\\Url;","@@ -588,6 +594,123 @@ public function testSubscriptionOverviewClearsTheInvalidLicensesCache()","         self::assertNotSame($stale, Cache::getEagerCache()->fetch($this->invalidLicensesCacheKey));","     }"," ","+    public function testUnsubscribeTrialRequestEmailsAsksForConfirmationWithoutChangingTheSetting()","+    {","+        Fixture::createSuperUser();","+","+        $html = $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $this->unsubscribeToken(Fixture::ADMIN_USER_LOGIN));","+","+        self::assertStringContainsString('Are you sure you want to unsubscribe from plugin request email notifications?', $html);","+        self::assertStringContainsString('name=\"confirm\"', $html);","+        self::assertNull($this->getNotifySetting(Fixture::ADMIN_USER_LOGIN));","+    }","+","+    public function testUnsubscribeTrialRequestEmailsRejectsATokenForAnotherLogin()","+    {","+        Fixture::createSuperUser();","+","+        $html = $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $this->unsubscribeToken('someoneElse'), true);","+","+        self::assertStringContainsString('This unsubscribe link is not valid.', $html);","+        self::assertNull($this->getNotifySetting(Fixture::ADMIN_USER_LOGIN));","+    }","+","+    public function testUnsubscribeTrialRequestEmailsRejectsAValidTokenForAnUnknownUser()","+    {","+        $html = $this->dispatchUnsubscribe('unknownUser', $this->unsubscribeToken('unknownUser'));","+","+        self::assertStringContainsString('This unsubscribe link is not valid.', $html);","+    }","+","+    public function testUnsubscribeTrialRequestEmailsTurnsTheEmailsOffForThatUserOnConfirm()","+    {","+        Fixture::createSuperUser();","+        (new UsersModel())->addUser('otherUser', 'password', 'other@example.org', Date::now()->getDatetime());","+","+        $html = $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $this->unsubscribeToken(Fixture::ADMIN_USER_LOGIN), true);","+","+        self::assertStringContainsString('You have been successfully unsubscribed from plugin request email notifications.', $html);","+        self::assertFalse((bool) $this->getNotifySetting(Fixture::ADMIN_USER_LOGIN));","+        self::assertNull($this->getNotifySetting('otherUser'));","+    }","+","+    public function testUnsubscribeTrialRequestEmailsPostsTheEventOnlyWhenItTurnsTheEmailsOff()","+    {","+        Fixture::createSuperUser();","+        $token = $this->unsubscribeToken(Fixture::ADMIN_USER_LOGIN);","+","+        $postedFor = [];","+        Piwik::addAction('Marketplace.trialRequestEmailsUnsubscribed', function (string $login) use (&$postedFor) {","+            $postedFor[] = $login;","+        });","+","+        $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $token);","+        self::assertSame([], $postedFor);","+","+        $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $token, true);","+        self::assertSame([Fixture::ADMIN_USER_LOGIN], $postedFor);","+","+        // eg the link in an older email, once the emails are already off","+        $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $token, true);","+        self::assertSame([Fixture::ADMIN_USER_LOGIN], $postedFor);","+    }","+","+    public function testUnsubscribeTrialRequestEmailsRejectsAConfirmWithAnInvalidNonce()","+    {","+        Fixture::createSuperUser();","+        $bufferLevel = ob_get_level();","+","+        try {","+            $this->dispatchUnsubscribe(Fixture::ADMIN_USER_LOGIN, $this->unsubscribeToken(Fixture::ADMIN_USER_LOGIN), true, 'invalid');","+            self::fail('Expected the nonce check to throw');","+        } catch (\\Exception $e) {","+            self::assertSame(Piwik::translate('General_ExceptionSecurityCheckFailed'), $e->getMessage());","+        } finally {","+            // the dispatch throws before closing the output buffer it opened","+            while (ob_get_level() > $bufferLevel) {","+                ob_end_clean();","+            }","+        }","+","+        self::assertNull($this->getNotifySetting(Fixture::ADMIN_USER_LOGIN));","+    }","+","+    private function dispatchUnsubscribe(string $login, string $token, bool $confirm = false, ?string $nonce = null): string","+    {","+        $_GET = [","+            'module' => 'Marketplace',","+            'action' => 'unsubscribeTrialRequestEmails',","+            'login' => $login,","+            'token' => $token,","+        ];","+","+        if ($confirm) {","+            $_GET['confirm'] = '1';","+            $_GET['nonce'] = $nonce ?? Nonce::getNonce(Controller::UNSUBSCRIBE_TRIAL_REQUEST_EMAILS_NONCE);","+        }","+","+        // the link is opened from an email, so the action must work without a session","+        Access::getInstance()->setSuperUserAccess(false);","+        Access::getInstance()->reloadAccess();","+        $this->assertTrue(Piwik::isUserIsAnonymous());","+","+        return FrontController::getInstance()->fetchDispatch('Marketplace', 'unsubscribeTrialRequestEmails');","+    }","+","+    private function unsubscribeToken(string $login): string","+    {","+        return StaticContainer::get(UnsubscribeToken::class)->generate($login);","+    }","+","+    /**","+     * @return mixed the stored value, or null when the user never set it","+     */","+    private function getNotifySetting(string $login)","+    {","+        return StaticContainer::get(UserScopedSettingsAccessManager::class)","+            ->get('Marketplace', $login, UserSettings::NOTIFY_ON_PLUGIN_REQUEST);","+    }","+","     /**","      * @param array<string, string> $params","      */"],"additions":123,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/tests/Integration/Emails/RequestTrialNotificationEmailTest.php","lines":["@@ -0,0 +1,71 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Marketplace\\tests\\Integration\\Emails;","+","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Email\\ContentGenerator;","+use Piwik\\Plugins\\Marketplace\\Emails\\RequestTrialNotificationEmail;","+use Piwik\\Plugins\\Marketplace\\PluginTrial\\UnsubscribeToken;","+use Piwik\\Tests\\Framework\\Fixture;","+use Piwik\\Tests\\Framework\\TestCase\\IntegrationTestCase;","+use Piwik\\View;","+use Piwik\\View\\HtmlReportEmailHeaderView;","+","+/**","+ * @group Marketplace","+ * @group PluginTrial","+ * @group Plugins","+ */","+class RequestTrialNotificationEmailTest extends IntegrationTestCase","+{","+    public function setUp(): void","+    {","+        parent::setUp();","+","+        Fixture::loadAllTranslations();","+    }","+","+    public function tearDown(): void","+    {","+        Fixture::resetTranslations();","+","+        parent::tearDown();","+    }","+","+    public function testBodyLinksToTheMarketplaceUnsubscribePageForTheRecipient()","+    {","+        $email = new RequestTrialNotificationEmail('some.user', 'some.user@example.org', 'PremiumPlugin', 'Premium Plugin');","+        $body = html_entity_decode($email->getBodyHtml());","+","+        $token = StaticContainer::get(UnsubscribeToken::class)->generate('some.user');","+        self::assertStringContainsString(","+            'index.php?module=Marketplace&action=unsubscribeTrialRequestEmails&login=some.user&token=' . $token,","+            $body","+        );","+        self::assertStringContainsString('To unsubscribe from plugin request email notifications, please follow this link:', $body);","+        self::assertStringNotContainsString('To unsubscribe from this report', $body);","+    }","+","+    public function testScheduledReportFooterKeepsTheReportWording()","+    {","+        $footer = new View('@CoreHome/ReportRenderer/_htmlReportFooter.twig');","+        HtmlReportEmailHeaderView::assignCommonParameters($footer);","+        $footer->unsubscribeLink = 'https://example.org/unsubscribe';","+","+        self::assertStringContainsString('To unsubscribe from this report please follow this link:', $footer->render());","+    }","+","+    public function testDefaultBodyHasNoUnsubscribeLine()","+    {","+        $body = StaticContainer::get(ContentGenerator::class)->generateHtmlContent('body');","+","+        self::assertStringNotContainsString('unsubscribe', strtolower($body));","+    }","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"plugins/Marketplace/tests/Integration/PluginTrial/RequestTest.php","lines":["@@ -9,11 +9,16 @@"," "," namespace Piwik\\Plugins\\Marketplace\\tests\\Integration\\PluginTrial;"," ","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Date;"," use Piwik\\Mail;"," use Piwik\\Piwik;"," use Piwik\\Plugins\\Marketplace\\Emails\\RequestTrialNotificationEmail;"," use Piwik\\Plugins\\Marketplace\\PluginTrial\\Request;"," use Piwik\\P