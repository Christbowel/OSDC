rs' => ['exp', 'iat', 'nbf'],","+    ];","+","+    private const NESTED_TOKEN_BUILDER = [","+        'signature_algorithms' => ['RS256', 'HS256'],","+        'encryption_algorithms' => ['RSA-OAEP-256', 'A256GCM', 'RSA1_5'],","+        'jws_serializers' => ['jws_compact', 'jws_json_general'],","+        'jwe_serializers' => ['jwe_compact', 'jwe_json_general'],","+    ];","+","+    /**","+     * @param list<string> $service","+     * @param array<string, list<string>> $definition","+     */","+    #[Test]","+    #[DataProvider('checkerLists')]","+    public function aSecondCheckerListAddsItsCheckersToTheFirstOne(","+        array $service,","+        array $definition,","+        string $list","+    ): void {","+        $config = self::process(","+            self::nest($service, $definition),","+            self::nest($service, [","+                $list => ['custom_checker'],","+            ])","+        );","+","+        static::assertSame([...$definition[$list], 'custom_checker'], self::read($config, [...$service, $list]));","+    }","+","+    /**","+     * @param list<string> $service","+     * @param array<string, list<string>> $definition","+     */","+    #[Test]","+    #[DataProvider('checkerLists')]","+    public function aCheckerListedInBothConfigurationsIsKeptOnce(","+        array $service,","+        array $definition,","+        string $list","+    ): void {","+        $config = self::process(","+            self::nest($service, $definition),","+            self::nest($service, [","+                $list => [$definition[$list][1], 'custom_checker'],","+            ])","+        );","+","+        static::assertSame([...$definition[$list], 'custom_checker'], self::read($config, [...$service, $list]));","+    }","+","+    /**","+     * @return iterable<string, array{list<string>, array<string, list<string>>, string}>","+     */","+    public static function checkerLists(): iterable","+    {","+        yield 'checkers.claims.*.claims' => [","+            ['