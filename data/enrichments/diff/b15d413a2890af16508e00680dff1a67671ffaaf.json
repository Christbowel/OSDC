{"id":"b15d413a2890af16508e00680dff1a67671ffaaf","axis":"silent","repo":"envoyproxy/envoy","sha":"b15d413a2890af16508e00680dff1a67671ffaaf","parsed":{"files":[{"path":"changelogs/current/bug_fixes/admin__sanitize-detailed-histogram-names.rst","lines":["@@ -0,0 +1,4 @@","+Sanitize histogram names rendered as JSON into the inline scripts of the admin","+``/stats?format=html&histogram_buckets=detailed`` page, so that a stat name cannot close the script","+element and inject markup. This change is guarded by the runtime guard","+``envoy.reloadable_features.sanitize_html_stats_names``."],"additions":4,"deletions":0,"truncated":false},{"path":"source/server/admin/stats_html_render.cc","lines":["@@ -117,7 +117,12 @@ void StatsHtmlRender::generate(Buffer::Instance& response, const std::string& na","       response.add(\"<script>\\n\");","     }","     response.add(\"renderHistogram(histogramDiv, supportedPercentiles,\\n\");","-    {","+    // JSON sanitization does not escape '<', so a stat name containing","+    // \"</script>\" would terminate this inline script.","+    if (Html::Utility::requiresSanitization(name) && sanitize_html_stats_names_) {","+      StatsJsonRender::generateHistogramDetail(Html::Utility::sanitize(name), histogram,","+                                               *streamer.makeRootMap());","+    } else {","       StatsJsonRender::generateHistogramDetail(name, histogram, *streamer.makeRootMap());","     }","     response.add(\");\\n</script>\\n\");"],"additions":6,"deletions":1,"truncated":false},{"path":"test/server/admin/stats_handler_test.cc","lines":["@@ -248,6 +248,42 @@ TEST_F(AdminStatsTest, HandlerStatsHtml) {","   test(\"&usedonly\", {\"foo.c0: 0\", \"foo.c1: 1\"},      // expected","        {\"scope1.scope2.unset\"});                     // not expected"," }","+","+// Stat names may contain downstream-controlled bytes, so every place a stat name","+// is written into the HTML stats page must be escaped.","+TEST_F(AdminStatsTest, HandlerStatsHtmlSanitizesNames) {","+  const std::string payload = \"</script><script>alert(1)</script>\";","+  const std::string html_escaped = \"&lt;/script&gt;&lt;script&gt;alert(1)&lt;/script&gt;\";","+","+  store_->counterFromString(absl::StrCat(\"counter\", payload)).add(1);","+  store_->gaugeFromString(absl::StrCat(\"gauge\", payload), Stats::Gauge::ImportMode::Accumulate)","+      .set(2);","+  store_->textReadoutFromString(absl::StrCat(\"text\", payload)).set(payload);","+  endpoints_helper_.makeCluster(absl::StrCat(\"cluster\", payload), 1);","+  Stats::Histogram& h = store_->histogramFromString(absl::StrCat(\"histogram\", payload),","+                                                    Stats::Histogram::Unit::Unspecified);","+  EXPECT_CALL(sink_, onHistogramComplete(Ref(h), 200));","+  h.recordValue(200);","+  store_->mergeHistograms([]() -> void {});","+","+  const std::vector<std::string> expected_names = {","+      absl::StrCat(\"counter\", html_escaped, \": 1\"),","+      absl::StrCat(\"gauge\", html_escaped, \": 2\"),","+      absl::StrCat(\"text\", html_escaped, \": \\\"\", html_escaped, \"\\\"\"),","+      absl::StrCat(\"cluster.cluster\", html_escaped, \".endpoint.127.0.0.1_80.c1: 11\"),","+      absl::StrCat(\"histogram\", html_escaped),","+  };","+  for (absl::string_view buckets :","+       {\"\", \"&histogram_buckets=summary\", \"&histogram_buckets=cumulative\",","+        \"&histogram_buckets=disjoint\", \"&histogram_buckets=detailed\"}) {","+    CodeResponse code_response = handlerStats(absl::StrCat(\"/stats?format=html\", buckets));","+    EXPECT_EQ(Http::Code::OK, code_response.first);","+    EXPECT_THAT(code_response.second, Not(HasSubstr(payload))) << buckets;","+    for (const std::string& expected : expected_names) {","+      EXPECT_THAT(code_response.second, HasSubstr(expected)) << buckets;","+    }","+  }","+}"," #endif"," "," TEST_F(AdminStatsTest, HandlerStatsPlainTextHistogramBucketsCumulative) {"],"additions":36,"deletions":0,"truncated":false},{"path":"test/server/admin/stats_html_render_test.cc","lines":["@@ -131,5 +131,28 @@ TEST_F(StatsHtmlRenderTest, SanitizeNameInHistogramTextMode) {","   EXPECT_THAT(result, Not(HasSubstr(\"<script>alert(1)</script>:\")));"," }"," ","+TEST_F(StatsHtmlRenderTest, SanitizeNameInHistogramDetailedMode) {","+  TestScopedRuntime scoped_runtime;","+  scoped_runtime.mergeValues({{\"envoy.reloadable_features.sanitize_html_stats_names\", \"true\"}});","+  params_.histogram_buckets_mode_ = Utility::HistogramBucketsMode::Detailed;","+  StatsHtmlRender renderer{response_headers_, response_, params_};","+  Stats::ParentHistogram& histogram = populateHistogram(\"h1\", {200, 300, 300});","+  std::string result = render<>(renderer, \"</script><script>alert(1)</script>\", histogram);","+  EXPECT_THAT(result, Not(HasSubstr(\"<script>alert(1)\")));","+  EXPECT_THAT(result,","+              HasSubstr(\"{\\\"name\\\":\\\"&lt;/script&gt;&lt;script&gt;alert(1)&lt;/script&gt;\\\",\"","+                        \"\\\"totals\\\":[\"));","+}","+","+TEST_F(StatsHtmlRenderTest, DoNotSanitizeNameInHistogramDetailedModeWhenDisabled) {","+  TestScopedRuntime scoped_runtime;","+  scoped_runtime.mergeValues({{\"envoy.reloadable_features.sanitize_html_stats_names\", \"false\"}});","+  params_.histogram_buckets_mode_ = Utility::HistogramBucketsMode::Detailed;","+  StatsHtmlRender renderer{response_headers_, response_, params_};","+  Stats::ParentHistogram& histogram = populateHistogram(\"h1\", {200, 300, 300});","+  std::string result = render<>(renderer, \"<b>h1</b>\", histogram);","+  EXPECT_THAT(result, HasSubstr(\"{\\\"name\\\":\\\"<b>h1</b>\\\",\\\"totals\\\":[\"));","+}","+"," } // namespace Server"," } // namespace Envoy",""],"additions":23,"deletions":0,"truncated":false}],"additions":69,"deletions":1,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-06T17:01:19.519537+00:00"}