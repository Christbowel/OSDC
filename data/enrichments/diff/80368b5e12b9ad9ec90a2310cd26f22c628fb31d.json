ock key is ``f\"{job_name}:{params_hash}\"`` and on the Huey engine it lives in a per-job-name","-    store, so it cannot span two job functions -- and its contention behaviour is to cancel the","-    loser, which would silently discard a run the user had just asked for.","+    Checked here as well as through the scheduled job's exclusive lock, so that an occurrence due","+    while the last one is still going stays unclaimed for a later pass, rather than queued behind","+    it with the window it was given."," ","     A run is only counted while its job could still be alive. Past the job engine's default","-    timeout the job is gone, so a run left RUNNING by a worker that died cannot block detection","+    timeout the job is gone, so a run left RUNNING by a worker that died cannot block the schedule","     for this experiment forever."," ","     Args:","@@ -51,7 +53,12 @@ def in_flight_detection_run(store, experiment_id: str, now_ms: int | None = None","             deciding about rather than with wall time.","     \"\"\"","     from mlflow.environment_variables import MLFLOW_SERVER_JOB_DEFAULT_TIMEOUT","-    from mlflow.utils.mlflow_tags import MLFLOW_RUN_TYPE, MLFLOW_RUN_TYPE_ISSUE_DETECTION","+    from mlflow.utils.mlflow_tags import (","+        MLFLOW_ISSUE_DETECTION_TRIGGER,","+        MLFLOW_ISSUE_DETECTION_TRIGGER_SCHEDULE,","+        MLFLOW_RUN_TYPE,","+        MLFLOW_RUN_TYPE_ISSUE_DETECTION,","+    )","     from mlflow.utils.time import get_current_time_millis"," ","     now_ms = get_current_time_millis() if now_ms is None else now_ms","@@ -60,6 +67,8 @@ def in_flight_detection_run(store, experiment_id: str, now_ms: int | None = None","         experiment_ids=[experiment_id],","         filter_string=(","             f\"tags.`{MLFLOW_RUN_TYPE}` = '{MLFLOW_RUN_TYPE_ISSUE_DETECTION}' \"","+            f\"AND tags.`{MLFLOW_ISSUE_DETECTION_TRIGGER}` = \"","+            f\"'{MLFLOW_ISSUE_DETECTION_TRIGGER_SCHEDULE}' \"","             f\"AND attributes.statu