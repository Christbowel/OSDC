+    filter_string: str | None = None,","+) -> dict[str, Any]:","     \"\"\"","     Job function to run issue detection on traces."," ","+    Analyzes ``trace_ids`` when given. When ``trace_ids`` is ``None``, the run samples the traces","+    matching ``filter_string`` instead -- the same way and up to the same size a scheduled","+    occurrence does -- so a filter matching a large share of the experiment cannot make one run","+    analyze an unbounded number of traces. Sampling happens here rather than in the request","+    because it reads whole traces.","+","     Note: Provider credentials should be passed via environment variables set by submit_job().","     \"\"\"","     # Identifies the caller to the gateway for judge calls on a `gateway:/` model.","@@ -168,8 +180,27 @@ def invoke_issue_detection_job(","         if internal_token := _MLFLOW_INTERNAL_GATEWAY_AUTH_TOKEN.get():","             os.environ[\"MLFLOW_TRACKING_PASSWORD\"] = internal_token"," ","+    client = MlflowClient()","+    if trace_ids is None:","+        try:","+            traces = sample_traces(","+                MAX_SCHEDULED_SESSION_SAMPLE_SIZE,","+                search_kwargs={\"experiment_ids\": [experiment_id], \"filter_string\": filter_string},","+            )","+            trace_ids = [trace.info.trace_id for trace in traces]","+            client.set_tag(run_id, \"total_traces\", str(len(trace_ids)))","+            if not trace_ids:","+                # Nothing matched, so there is nothing to analyze: finish the run over zero traces","+                # rather than failing it, as a scheduled occurrence over a quiet window does.","+                client.set_tag(run_id, \"total_cost_usd\", 0.0)","+                client.set_tag(run_id, \"total_traces_analyzed\", 0)","+                client.set_terminated(run_id, RunStatus.to_string(RunStatus.FINISHED))","+                return {\"total_traces_analyzed\": 0, \"total_cost_usd\": 0.0}","+        except Exception as error:","+       