{"id":"31ca3acb381c94cef86ce9af46292efbda31f273","axis":"silent","repo":"dotnet/aspnetcore","sha":"31ca3acb381c94cef86ce9af46292efbda31f273","parsed":{"files":[{"path":"src/Security/Authorization/Core/src/AuthorizationHandler.cs","lines":["@@ -1,7 +1,6 @@"," // Licensed to the .NET Foundation under one or more agreements."," // The .NET Foundation licenses this file to you under the MIT license."," ","-using System.Linq;"," using System.Threading.Tasks;"," "," namespace Microsoft.AspNetCore.Authorization;","@@ -19,7 +18,7 @@ public abstract class AuthorizationHandler<TRequirement> : IAuthorizationHandler","     /// <param name=\"context\">The authorization context.</param>","     public virtual async Task HandleAsync(AuthorizationHandlerContext context)","     {","-        foreach (var req in context.Requirements.OfType<TRequirement>())","+        foreach (var req in new RequirementsOfType<TRequirement>(context.Requirements))","         {","             await HandleRequirementAsync(context, req).ConfigureAwait(false);","         }","@@ -50,7 +49,7 @@ public virtual async Task HandleAsync(AuthorizationHandlerContext context)","     {","         if (context.Resource is TResource resource)","         {","-            foreach (var req in context.Requirements.OfType<TRequirement>())","+            foreach (var req in new RequirementsOfType<TRequirement>(context.Requirements))","             {","                 await HandleRequirementAsync(context, req, resource).ConfigureAwait(false);","             }"],"additions":2,"deletions":3,"truncated":false},{"path":"src/Security/Authorization/Core/src/PassThroughAuthorizationHandler.cs","lines":["@@ -1,7 +1,6 @@"," // Licensed to the .NET Foundation under one or more agreements."," // The .NET Foundation licenses this file to you under the MIT license."," ","-using System.Linq;"," using System.Threading.Tasks;"," using Microsoft.Extensions.Options;"," ","@@ -34,7 +33,7 @@ public PassThroughAuthorizationHandler(IOptions<AuthorizationOptions> options)","     /// <param name=\"context\">The authorization context.</param>","     public async Task HandleAsync(AuthorizationHandlerContext context)","     {","-        foreach (var handler in context.Requirements.OfType<IAuthorizationHandler>())","+        foreach (var handler in new RequirementsOfType<IAuthorizationHandler>(context.Requirements))","         {","             await handler.HandleAsync(context).ConfigureAwait(false);","             if (!_options.InvokeHandlersAfterFailure && context.HasFailed)"],"additions":1,"deletions":2,"truncated":false},{"path":"src/Security/Authorization/Core/src/RequirementsOfType.cs","lines":["@@ -0,0 +1,82 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System;","+using System.Collections.Generic;","+using System.Collections.ObjectModel;","+using System.Linq;","+","+namespace Microsoft.AspNetCore.Authorization;","+","+/// <summary>","+/// Equivalent to <c>requirements.OfType&lt;T&gt;()</c>, but avoids allocating on the common path.","+/// </summary>","+/// <remarks>","+/// <para>","+/// Fast path: <see cref=\"AuthorizationPolicy.Requirements\"/> is created with <see cref=\"List{T}.AsReadOnly\"/>, so the","+/// requirements passed to <see cref=\"AuthorizationHandlerContext\"/> are usually a <see cref=\"ReadOnlyCollection{T}\"/>.","+/// In that case the enumerator indexes into the collection directly and creates no enumerator.","+/// </para>","+/// <para>","+/// What's saved: <c>OfType&lt;T&gt;()</c> allocates an iterator plus a boxed enumerator over the source on every","+/// <see cref=\"IAuthorizationHandler.HandleAsync(AuthorizationHandlerContext)\"/> call. This struct enumerable avoids","+/// both, and is safe to use in <c>foreach</c> inside async handlers because it is not a ref struct.","+/// </para>","+/// <para>","+/// Fallback: any other <see cref=\"IEnumerable{T}\"/> goes through <c>OfType&lt;T&gt;()</c> unchanged.","+/// </para>","+/// <para>","+/// <typeparamref name=\"T\"/> is intentionally unconstrained because <see cref=\"Infrastructure.PassThroughAuthorizationHandler\"/>","+/// uses it with <see cref=\"IAuthorizationHandler\"/>, which does not derive from <see cref=\"IAuthorizationRequirement\"/>.","+/// </para>","+/// </remarks>","+internal readonly struct RequirementsOfType<T>","+{","+    private readonly IEnumerable<IAuthorizationRequirement> _requirements;","+","+    public RequirementsOfType(IEnumerable<IAuthorizationRequirement> requirements)","+    {","+        _requirements = requirements;","+    }","+","+    public Enumerator GetEnumerator() => new(_requirements);","+","+    public struct Enumerator : IDisposable","+    {","+        private readonly ReadOnlyCollection<IAuthorizationRequirement>? _list;","+        private readonly IEnumerator<T>? _fallback;","+        private int _index;","+        private T _current;","+","+        internal Enumerator(IEnumerable<IAuthorizationRequirement> requirements)","+        {","+            _list = requirements as ReadOnlyCollection<IAuthorizationRequirement>;","+            _fallback = _list is null ? requirements.OfType<T>().GetEnumerator() : null;","+            _index = -1;","+            _current = default!;","+        }","+","+        public readonly T Current => _list is null ? _fallback!.Current : _current;","+","+        public bool MoveNext()","+        {","+            if (_list is null)","+            {","+                return _fallback!.MoveNext();","+            }","+","+            while (++_index < _list.Count)","+            {","+                if (_list[_index] is T requirement)","+                {","+                    _current = requirement;","+                    return true;","+                }","+            }","+","+            return false;","+        }","+","+        public readonly void Dispose() => _fallback?.Dispose();","+    }","+}"],"additions":82,"deletions":0,"truncated":false},{"path":"src/Security/Authorization/test/DefaultAuthorizationServiceTests.cs","lines":["@@ -1388,4 +1388,107 @@ static void Assertion(LogLevel level, EventId eventId, object state, Exception e"," ","         // Assert","     }","+","+    public static TheoryData<string> RequirementCollectionKinds => new() { \"ReadOnlyCollection\", \"List\", \"Array\", \"Enumerable\" };","+","+    private static IEnumerable<IAuthorizationRequirement> CreateRequirements(string kind, params IAuthorizationRequirement[] requirements)","+        => kind switch","+        {","+            \"ReadOnlyCollection\" => new AuthorizationPolicy(requirements, Array.Empty<string>()).Requirements,","+            \"List\" => new List<IAuthorizationRequirement>(requirements),","+            \"Array\" => requirements,","+            \"Enumerable\" => requirements.Select(r => r),","+            _ => throw new ArgumentOutOfRangeException(nameof(kind)),","+        };","+","+    [Theory]","+    [MemberData(nameof(RequirementCollectionKinds))]","+    public async Task Authorize_InvokesTypedHandlersForEachMatchingRequirement(string kind)","+    {","+        var counter = new CountingRequirementHandler();","+        var authorizationService = BuildAuthorizationService(services =>","+        {","+            services.AddSingleton<IAuthorizationHandler>(counter);","+            services.AddSingleton<IAuthorizationHandler, StringResourceRequirementHandler>();","+        });","+        var user = new ClaimsPrincipal(new ClaimsIdentity(new[] { new Claim(ClaimTypes.Name, \"Name\") }, \"AuthType\"));","+        var counted = new CountedRequirement();","+        var requirements = CreateRequirements(","+            kind,","+            counted,","+            new StringResourceRequirement(),","+            new DenyAnonymousAuthorizationRequirement(),","+            counted);","+","+        var allowed = await authorizationService.AuthorizeAsync(user, \"resource\", requirements);","+        var deniedForWrongResource = await authorizationService.AuthorizeAsync(user, 42, requirements);","+","+        Assert.True(allowed.Succeeded);","+        Assert.False(deniedForWrongResource.Succeeded);","+        Assert.Equal(4, counter.Invocations);","+    }","+","+    [Theory]","+    [MemberData(nameof(RequirementCollectionKinds))]","+    public async Task Authorize_PassThroughHandlerStopsAfterFailure(string kind)","+    {","+        var authorizationService = BuildAuthorizationService(services =>","+            services.Configure<AuthorizationOptions>(options => options.InvokeHandlersAfterFailure = false));","+        var user = new ClaimsPrincipal(new ClaimsIdentity());","+        var after = new SelfHandlingRecordingRequirement(fail: false);","+        var requirements = CreateRequirements(kind, new SelfHandlingRecordingRequirement(fail: true), after);","+","+        var result = await authorizationService.AuthorizeAsync(user, null, requirements);","+","+        Assert.False(result.Succeeded);","+        Assert.False(after.Invoked);","+    }","+","+    private sealed class CountedRequirement : IAuthorizationRequirement","+    {","+    }","+","+    private sealed class CountingRequirementHandler : AuthorizationHandler<CountedRequirement>","+    {","+        public int Invocations { get; private set; }","+","+        protected override Task HandleRequirementAsync(AuthorizationHandlerContext context, CountedRequirement requirement)","+        {","+            Invocations++;","+            context.Succeed(requirement);","+            return Task.CompletedTask;","+        }","+    }","+","+    private sealed class StringResourceRequirement : IAuthorizationRequirement","+    {","+    }","+","+    private sealed class StringResourceRequirementHandler : AuthorizationHandler<StringResourceRequirement, string>","+    {","+        protected override Task HandleRequirementAsync(AuthorizationHandlerContext context, StringResourceRequirement requirement, string resource)","+        {","+            context.Succeed(requirement);","+            return Task.CompletedTask;","+        }","+    }","+","+    private sealed class SelfHandlingRecordingRequirement(bool fail) : IAuthorizationRequirement, IAuthorizationHandler","+    {","+        public bool Invoked { get; private set; }","+","+        public Task HandleAsync(AuthorizationHandlerContext context)","+        {","+            Invoked = true;","+            if (fail)","+            {","+                context.Fail();","+            }","+            else","+            {","+                context.Succeed(this);","+            }","+            return Task.CompletedTask;","+        }","+    }"," }"],"additions":103,"deletions":0,"truncated":false},{"path":"src/Security/Authorization/test/RequirementsOfTypeTests.cs","lines":["@@ -0,0 +1,192 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.Collections;","+using System.Collections.ObjectModel;","+using System.Linq;","+","+namespace Microsoft.AspNetCore.Authorization.Test;","+","+public class RequirementsOfTypeTests","+{","+    public static TheoryData<string> CollectionKinds => new() { \"ReadOnlyCollection\", \"List\", \"Array\", \"Enumerable\" };","+","+    [Theory]","+    [MemberData(nameof(CollectionKinds))]","+    public void EmptyRequirements_YieldsNothing(string kind)","+    {","+        var requirements = CreateRequirements(kind);","+","+        Assert.Empty(Enumerate<MatchingRequirement>(requirements));","+    }","+","+    [Theory]","+    [MemberData(nameof(CollectionKinds))]","+    public void SingleMatchingRequirement_YieldsIt(string kind)","+    {","+        var matching = new MatchingRequirement();","+        var requirements = CreateRequirements(kind, matching);","+","+        Assert.Same(matching, Assert.Single(Enumerate<MatchingRequirement>(requirements)));","+    }","+","+    [Theory]","+    [MemberData(nameof(CollectionKinds))]","+    public void SingleNonMatchingRequirement_YieldsNothing(string kind)","+    {","+        var requirements = CreateRequirements(kind, new OtherRequirement());","+","+        Assert.Empty(Enumerate<MatchingRequirement>(requirements));","+    }","+","+    [Theory]","+    [MemberData(nameof(CollectionKinds))]","+    public void OnlyNonMatchingRequirements_YieldsNothing(string kind)","+    {","+        var requirements = CreateRequirements(kind, new OtherRequirement(), new OtherRequirement(), new OtherRequirement());","+","+        Assert.Empty(Enumerate<MatchingRequirement>(requirements));","+    }","+","+    [Theory]","+    [MemberData(nameof(CollectionKinds))]","+    public void ManyMixedRequirements_YieldsMatchesInOrderLikeOfType(string kind)","+    {","+        var first = new MatchingRequirement();","+        var second = new MatchingRequirement();","+        var derived = new DerivedMatchingRequirement();","+        var requirements = CreateRequirements(","+            kind,","+            new OtherRequirement(),","+            first,","+            null,","+            new OtherRequirement(),","+            second,","+            first,","+            derived,","+            new OtherRequirement());","+","+        var result = Enumerate<MatchingRequirement>(requirements);","+","+        Assert.Equal(new MatchingRequirement[] { first, second, first, derived }, result);","+        Assert.Equal(requirements.OfType<MatchingRequirement>(), result);","+    }","+","+    [Theory]","+    [MemberData(nameof(CollectionKinds))]","+    public void FiltersByInterfaceNotImplementingIAuthorizationRequirement(string kind)","+    {","+        var selfHandling = new SelfHandlingRequirement();","+        var requirements = CreateRequirements(kind, new OtherRequirement(), selfHandling, new MatchingRequirement());","+","+        Assert.Same(selfHandling, Assert.Single(Enumerate<IAuthorizationHandler>(requirements)));","+    }","+","+    [Fact]","+    public void ReadOnlyCollection_DoesNotCallGetEnumerator()","+    {","+        var matching = new MatchingRequirement();","+        var inner = new TrackingList(new IAuthorizationRequirement[] { new OtherRequirement(), matching });","+        var requirements = new ReadOnlyCollection<IAuthorizationRequirement>(inner);","+","+        var result = Enumerate<MatchingRequirement>(requirements);","+","+        Assert.Same(matching, Assert.Single(result));","+        Assert.Equal(0, inner.GetEnumeratorCalls);","+    }","+","+    [Fact]","+    public void NonReadOnlyCollection_EnumeratesLazilyAndDisposesSourceEnumerator()","+    {","+        var matching = new MatchingRequirement();","+        var requirements = new TrackingEnumerable(new IAuthorizationRequirement[] { matching, new OtherRequirement(), new MatchingRequirement() });","+","+        foreach (var requirement in new RequirementsOfType<MatchingRequirement>(requirements))","+        {","+            Assert.Same(matching, requirement);","+            break;","+        }","+","+        Assert.Equal(1, requirements.MoveNextCalls);","+        Assert.True(requirements.Disposed);","+    }","+","+    private static List<T> Enumerate<T>(IEnumerable<IAuthorizationRequirement> requirements)","+    {","+        var result = new List<T>();","+        foreach (var requirement in new RequirementsOfType<T>(requirements))","+        {","+            result.Add(requirement);","+        }","+        return result;","+    }","+","+    private static IEnumerable<IAuthorizationRequirement> CreateRequirements(string kind, params IAuthorizationRequirement[] requirements)","+        => kind switch","+        {","+            \"ReadOnlyCollection\" => new List<IAuthorizationRequirement>(requirements).AsReadOnly(),","+            \"List\" => new List<IAuthorizationRequirement>(requirements),","+            \"Array\" => requirements,","+            \"Enumerable\" => requirements.Select(r => r),","+            _ => throw new ArgumentOutOfRangeException(nameof(kind)),","+        };","+","+    private class MatchingRequirement : IAuthorizationRequirement","+    {","+    }","+","+    private sealed class DerivedMatchingRequirement : MatchingRequirement","+    {","+    }","+","+    private sealed class OtherRequirement : IAuthorizationRequirement","+    {","+    }","+","+    private sealed class SelfHandlingRequirement : IAuthorizationRequirement, IAuthorizationHandler","+    {","+        public Task HandleAsync(AuthorizationHandlerContext context) => Task.CompletedTask;","+    }","+","+    private sealed class TrackingList(IList<IAuthorizationRequirement> inner) : Collection<IAuthorizationRequirement>(inner), IEnumerable<IAuthorizationRequirement>","+    {","+        public int GetEnumeratorCalls { get; private set; }","+","+        IEnumerator<IAuthorizationRequirement> IEnumerable<IAuthorizationRequirement>.GetEnumerator()","+        {","+            GetEnumeratorCalls++;","+            return base.GetEnumerator();","+        }","+","+        IEnumerator IEnumerable.GetEnumerator()","+        {","+            GetEnumeratorCalls++;","+            return base.GetEnumerator();","+        }","+    }","+","+    private sealed class TrackingEnumerable(IAuthorizationRequirement[] items) : IEnumerable<IAuthorizationRequirement>","+    {","+        public int MoveNextCalls { get; private set; }","+","+        public bool Disposed { get; private set; }","+","+        public IEnumerator<IAuthorizationRequirement> GetEnumerator()","+        {","+            try","+            {","+                foreach (var item in items)","+                {","+                    MoveNextCalls++;","+                    yield return item;","+                }","+            }","+            finally","+            {","+                Disposed = true;","+            }","+        }","+","+        IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();","+    }","+}"],"additions":192,"deletions":0,"truncated":false},{"path":"src/Security/perf/Microbenchmarks/AuthorizationServiceBenchmark.cs","lines":["@@ -0,0 +1,77 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.Security.Claims;","+using BenchmarkDotNet.Attributes;","+using Microsoft.AspNetCore.Authentication;","+using Microsoft.AspNetCore.Authorization;","+using Microsoft.AspNetCore.Http;","+using Microsoft.AspNetCore.Http.Features.Authentication;","+using Microsoft.AspNetCore.Routing;","+using Microsoft.Extensions.DependencyInjection;","+","+namespace Microsoft.AspNetCore.Security;","+","+public class AuthorizationServiceBenchmark","+{","+    private IAuthorizationService _authorizationService;","+    private AuthorizationPolicy _defaultPolicy;","+    private AuthorizationPolicy _claimsPolicy;","+    private ClaimsPrincipal _user;","+    private AuthorizationMiddleware _authorizationMiddleware;","+    private DefaultHttpContext _httpContext;","+","+    [GlobalSetup]","+    public void Setup()","+    {","+        var services = new ServiceCollection()","+            .AddLogging()","+            .AddSingleton<EndpointDataSource>(new DefaultEndpointDataSource())","+            .AddAuthorization(options =>","+            {","+                options.AddPolicy(\"Claims\", policy => policy.RequireClaim(\"scope\", \"read\").RequireRole(\"admin\"));","+            })","+            .BuildServiceProvider();","+","+        _authorizationService = services.GetRequiredService<IAuthorizationService>();","+        var policyProvider = services.GetRequiredService<IAuthorizationPolicyProvider>();","+        _defaultPolicy = policyProvider.GetDefaultPolicyAsync().GetAwaiter().GetResult();","+        _claimsPolicy = policyProvider.GetPolicyAsync(\"Claims\").GetAwaiter().GetResult();","+","+        _user = new ClaimsPrincipal(new ClaimsIdentity(","+            [","+                new Claim(ClaimTypes.Name, \"user\"),","+                new Claim(ClaimTypes.Role, \"admin\"),","+                new Claim(\"scope\", \"read\"),","+            ],","+            \"Test\"));","+","+        _authorizationMiddleware = new AuthorizationMiddleware(_ => Task.CompletedTask, policyProvider, services);","+","+        var endpoint = new Endpoint(_ => Task.CompletedTask, new EndpointMetadataCollection(new AuthorizeAttribute()), \"Authorized endpoint\");","+        _httpContext = new DefaultHttpContext { RequestServices = services };","+        _httpContext.SetEndpoint(endpoint);","+        var authFeature = new AuthenticationFeature { User = _user, AuthenticateResult = AuthenticateResult.Success(new AuthenticationTicket(_user, \"Test\")) };","+        _httpContext.Features.Set<IAuthenticateResultFeature>(authFeature);","+        _httpContext.Features.Set<IHttpAuthenticationFeature>(authFeature);","+    }","+","+    [Benchmark]","+    public Task<AuthorizationResult> AuthorizeAsync_DefaultPolicy()","+        => _authorizationService.AuthorizeAsync(_user, resource: null, _defaultPolicy);","+","+    [Benchmark]","+    public Task<AuthorizationResult> AuthorizeAsync_ClaimsAndRolePolicy()","+        => _authorizationService.AuthorizeAsync(_user, resource: null, _claimsPolicy);","+","+    [Benchmark]","+    public Task Invoke_HasEndpoint_Authorize()","+        => _authorizationMiddleware.Invoke(_httpContext);","+","+    private sealed class AuthenticationFeature : IAuthenticateResultFeature, IHttpAuthenticationFeature","+    {","+        public AuthenticateResult AuthenticateResult { get; set; }","+","+        public ClaimsPrincipal User { get; set; }","+    }","+}",""],"additions":77,"deletions":0,"truncated":false}],"additions":457,"deletions":5,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-08T15:21:43.475980+00:00"}