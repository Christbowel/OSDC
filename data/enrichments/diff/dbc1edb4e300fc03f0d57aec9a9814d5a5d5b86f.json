   * Saves the attachments before they are replaced by the secured ones of WS-Security, which happens in","+     * the POST_PROTOCOL phase, or while the message is written with the streaming WS-Security. The","+     * attachments added by the marshalling, like the MTOM ones, are saved in the POST_MARSHAL phase, but","+     * not the secured ones, which have the IDs of the attachments they replace.","+     */","+    static class AttachmentSaveInterceptor extends AbstractPhaseInterceptor<Message> {","+        private final List<Attachment> attachments;","+","+        AttachmentSaveInterceptor(Collection<Attachment> attachments) {","+            super(Phase.POST_MARSHAL);","+            this.attachments = attachments == null ? new ArrayList<>() : new ArrayList<>(attachments);","+        }","+","+        @Override","+        public void handleMessage(Message message) throws Fault {","+            if (message.getAttachments() == null) {","+                return;","+            }","+            Set<String> ids = new HashSet<>();","+            Set<Attachment> saved = Collections.newSetFromMap(new IdentityHashMap<>());","+            saved.addAll(attachments);","+            for (Attachment a : attachments) {","+                ids.add(a.getId());","+            }","+            for (Attachment a : message.getAttachments()) {","+                String id = a.getId();","+                if ((id == null || ids.add(id)) && saved.add(a)) {","+                    attachments.add(a);","+                }","+            }","+            message.put(RMMessageConstants.SAVED_ATTACHMENTS, attachments);","+        }","+    }","+","     private static class CaptureStart extends AbstractPhaseInterceptor<Message> {","         CaptureStart() {","             super(Phase.PRE_PROTOCOL);"],"additions":42,"deletions":0,"truncated":false},{"path":"rt/ws/rm/src/main/java/org/apache/cxf/ws/rm/RMManager.java","lines":["@@ -21,6 +21,7 @@"," "," import java.io.Closeable;"," import java.io.IOExcep