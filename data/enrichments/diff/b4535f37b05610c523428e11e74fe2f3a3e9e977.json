or agreed to in writing, software","+## distributed under the License is distributed on an \"AS IS\" BASIS,","+## WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+## See the License for the specific language governing permissions and","+## limitations under the License.","+","+statement ok","+drop database if exists materialized_view_view_scope","+","+statement ok","+create database materialized_view_view_scope","+","+statement ok","+use materialized_view_view_scope","+","+statement ok","+create table foo(x int)","+","+statement ok","+insert into foo values (1)","+","+statement ok","+create table src(x int) change_tracking = true","+","+statement ok","+insert into src values (1)","+","+# The regular view's scalar subquery must stay independent of the caller's CTE.","+# A fresh non-aggregating MV exercises the final-projection output context.","+statement ok","+create materialized view mv_detail as select x from src","+","+statement ok","+refresh materialized view mv_detail","+","+statement ok","+create view v as select (select max(x) from foo) as x from mv_detail","+","+query II","+with foo as (select 99 as x) select v.x, foo.x from v, foo","+----","+1 99","+","+# A fresh aggregating MV also exercises the state-merge output context.","+statement ok","+create materialized view mv_aggregate as select sum(x) as x from src","+","+statement ok","+refresh materialized view mv_aggregate","+","+statement ok","+create view v_aggregate as select (select max(x) from foo) as x from mv_aggregate","+","+query II","+with foo as (select 99 as x) select v_aggregate.x, foo.x from v_aggregate, foo","+----","+1 99","+","+statement ok","+drop database materialized_view_view_scope"],"additions":68,"deletions":0,"truncated":false},{"path":"tests/sqllogictests/suites/query/cte/view_cte_scope.test","lines":["@@ -0,0 +1,189 @@","+# View definitions have independent name scopes. Issue #20651.","+# Alias-reuse and multiple-CTE cases adapted from DuckDB test/sql/cte/t