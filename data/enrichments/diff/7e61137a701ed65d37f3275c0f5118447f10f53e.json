e;","+}","+","+bool ParseRoute(const base::DictValue& dict,","+                ProtocolSource::Route* route,","+                std::string* error) {","+  const base::DictValue* source = dict.FindDict(\"source\");","+  if (!source)","+    return Fail(error, \"Each route needs a 'source'\");","+  if (const base::Value* match = dict.Find(\"match\")) {","+    if (!match->is_dict())","+      return Fail(error, \"'match' must be an object\");","+    if (const base::Value* host = match->GetDict().Find(\"host\")) {","+      url::CanonHostInfo info;","+      std::string canonical =","+          host->is_string() ? net::CanonicalizeHost(host->GetString(), &info)","+                            : std::string();","+      if (canonical.empty() ||","+          (!info.IsIPAddress() &&","+           !net::IsCanonicalizedHostCompliant(canonical))) {","+        return Fail(error, \"'match.host' must be a valid host name\");","+      }","+      route->host = std::move(canonical);","+    }","+    if (const base::Value* path = match->GetDict().Find(\"path\")) {","+      if (!path->is_string() || !path->GetString().starts_with('/') ||","+          GURL(\"http://x\" + path->GetString()).path() != path->GetString()) {","+        return Fail(error, \"'match.path' must be a URL path starting with '/'\");","+      }","+      route->path_prefix = path->GetString();","+    }","+  }","+  if (route->path_prefix.empty() || route->path_prefix.back() != '/')","+    route->path_prefix += '/';","+","+  if (const std::string* type = source->FindString(\"type\");","+      !type || *type != \"directory\") {","+    return Fail(error, \"'source.type' must be 'directory'\");","+  }","+  if (const std::string* root = source->FindString(\"root\");","+      root && !root->empty()) {","+    route->root = base::FilePath::FromUTF8Unsafe(*root);","+  } else {","+    return Fail(error, \"A directory source needs a 'root'\");","+  }","+  if (!route->root.IsAbsolute())","+    return Fail(error, \"'source.root' must be an absolute path\");","+  route->root = route->root.StripTrailingSeparators();","+  // Requests are confined to the directory root really is, so a link under it","+  // cannot lead elsewhere; see AsarURLLoader. Files are opened through the path","+  // asar integrity looks archives up by: resolved, except on Windows.","+  {","+    ScopedAllowBlockingForElectron allow_blocking;","+    base::FilePath archive, inside, real;","+    if (!asar::GetAsarArchivePath(route->root, &archive, &inside, true))","+      archive = route->root;","+    route->real_root = base::NormalizeFilePath(archive, &real)","+                           ? real.Append(inside)","+                           : route->root;","+#if !BUILDFLAG(IS_WIN)","+    route->root = route->real_root;","+#endif","+  }","+  if (const base::Value* index = source->Find(\"index\")) {","+    if (!index->is_string() ||","+        index->GetString().find_first_of(\"/\\\\\") != std::string::npos ||","+        index->GetString() == \"..\") {","+      return Fail(error, \"'source.index' must be a file name\");","+    }","+    route->index = index->GetString();","+  } else {","+    route->index = \"index.html\";","+  }","+  // Unlike file:, responses on a custom scheme carry a status line and any","+  // headers the route adds.","+  route->headers =","+      base::MakeRefCounted<net::HttpResponseHeaders>(\"HTTP/1.1 200 OK\");","+  if (const base::Value* headers = source->Find(\"headers\")) {","+    if (!headers->is_dict())","+      return Fail(error, \"'source.headers' must be an object\");","+    for (const auto [name, value] : headers->GetDict()) {","+      if (!value.is_string() || !net::HttpUtil::IsValidHeaderName(name) ||","+          !net::HttpUtil::IsValidHeaderValue(value.GetString())) {","+        return Fail(error, \"Invalid response header '\" + name + \"'\");","+      }","+      route->headers->AddHeader(name, value.GetString());"],"additions":127,"deletions":0,"truncated":false}],"additions":414,"deletions":33,"t