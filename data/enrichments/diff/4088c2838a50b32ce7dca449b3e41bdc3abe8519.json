ve the same size and no systematic difference (scale","+    bias); under DCP8 also their LSEs.\"\"\"","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.dsa.attn_fi import (","+        KERNELS,","+        FlashInferCore,","+        kernel_for,","+    )","+","+    if not has_flashinfer_prims_ts_sparse_mla():","+        pytest.skip(\"FlashInfer has no prims_ts sparse MLA\")","+    dcp = 8 if heads == 128 else 1","+    # The policy runs prims_ts on this batch (the stock decode: trtllm-gen).","+    assert kernel_for(rows, dcp > 1, KERNELS) == \"prims_ts\"","+    live = HEADS * 8 if dcp > 1 else HEADS","+    gen = torch.Generator(device=\"cuda\").manual_seed(rows * 31 + len(counts) + peak)","+    e4m3 = torch.float8_e4m3fn","+    block, pool = UNIT, 8192","+    cache = packed_cache(pool // block, block, FP8_ROW, gap=0)","+    keys = torch.randn(pool, FP8_ROW, generator=gen, device=\"cuda\")","+    cache.view(-1, FP8_ROW).copy_(keys.to(e4m3).view(torch.uint8))","+    flat = cache.view(-1, FP8_ROW).view(e4m3).float()","+    # Score std ~1.7 sigma_q: flat ~1, peaked ~5 (much of the row underflows E4M3).","+    sigma = 3.0 if peak else 0.6","+    query = torch.zeros(rows, heads, FP8_ROW, dtype=torch.uint8, device=\"cuda\")","+    q = torch.randn(rows, live, FP8_ROW, generator=gen, device=\"cuda\") * sigma","+    query[:, :live] = q.to(e4m3).view(torch.uint8)","+    width = 2048","+    slots = torch.full((rows, width), -1, dtype=torch.int32, device=\"cuda\")","+    valid = torch.zeros(rows, dtype=torch.int32, device=\"cuda\")","+    for t in range(rows):","+        if counts == \"tile\":","+            n = 32","+        elif counts == \"dcp\":","+            n = int(torch.randint(200, 320, (1,), generator=gen, device=\"cuda\"))","+        else:","+            n = width","+        pick = torch.randperm(pool, generator=gen, device=\"cuda\")[:n]","+        slots[t, :n] = pick.int()","+        valid[t] = n","+","+    outs, lses = {}, {}","+    for kernel in (\"trtll