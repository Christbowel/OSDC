{"id":"4088c2838a50b32ce7dca449b3e41bdc3abe8519","axis":"silent","repo":"vllm-project/vllm","sha":"4088c2838a50b32ce7dca449b3e41bdc3abe8519","parsed":{"files":[{"path":"tests/models/kimi_k3/nvidia/specialized_decode/test_specialized_decode_dep.py","lines":["@@ -10,6 +10,7 @@"," import torch"," "," from vllm.platforms import current_platform","+from vllm.v1.attention.backends.mla.flashinfer_mla_sparse import _prims_ts_row_buckets"," "," pytestmark = pytest.mark.skipif(","     not current_platform.is_device_capability_family(100),","@@ -285,10 +286,218 @@ def test_dep_linear_policies():","     assert DEP_ROWS[\"fp8\"] == DEP_ROWS[\"nvfp4_ds_mla\"] == DEP_MAX_ROWS"," "," ","+def dep_layer_step(core, batch, q, contexts):","+    \"\"\"One decode step of a real 96-head (TP1) K3.1 DSA layer through the stock","+    KimiK3DSAAttention forward and through runtime.dep.DepAttention.run_wide (the","+    DEP step's attention: split-K / cuBLAS projection, PreparedDsa at 96 heads,","+    o_proj), each over its own copy of the same caches (written by the stock","+    writers), on the same metadata. Returns both outputs, both rows entering","+    o_proj, the top-k and what the FP32 reference needs.\"\"\"","+    from types import SimpleNamespace","+","+    from tests.models.kimi_k3.nvidia.specialized_decode.test_specialized_decode_dsa import (  # noqa: E501","+        GAP,","+        LAYER_CORES,","+        LAYER_HIDDEN,","+        UNIT,","+        assert_index_nan_free,","+        common_metadata,","+        dsa_layer,","+        index_row,","+        layer_config,","+        owned_slots,","+        paged_rows,","+    )","+    from vllm import _custom_ops as ops","+    from vllm.config import set_current_vllm_config","+    from vllm.forward_context import create_forward_context, override_forward_context","+    from vllm.models.kimi_k3.nvidia.ops.dsa_indexer import (","+        indexer_k_norm_quant_insert,","+    )","+    from vllm.models.kimi_k3.nvidia.ops.dsa_indexer_mxfp4 import (","+        mxfp4_k_norm_quant_insert,","+    )","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.dsa.attn_fi import (","+        fi_kernels,","+    )","+    from vllm.models.kimi_k3.nvidia.specialized_decode.runtime.dep import (","+        DepAttention,","+    )","+    from vllm.v1.attention.backends.mla.indexer import (","+        DeepseekV32IndexerMetadataBuilder,","+    )","+    from vllm.v1.kv_cache_interface import get_block_table_width","+","+    cache_dtype, _, kernel = LAYER_CORES[core]","+    config = layer_config(core, q)","+    length = config.model_config.max_model_len","+    row = {\"fp8\": FP8_ROW, \"nvfp4_ds_mla\": NVFP4_ROW}[cache_dtype]","+    dev = torch.device(\"cuda\", torch.accelerator.current_device_index())","+    bf = torch.bfloat16","+    with set_current_vllm_config(config):","+        topk_buffer = torch.full((length, 2048), -1, dtype=torch.int32, device=dev)","+        attn = dsa_layer(config, topk_buffer, HEADS)","+        layer, indexer = attn.mla_attn.mla_attn, attn.dsa_indexer","+        spec = layer.get_kv_cache_spec(config)","+        builder = layer.attn_backend.get_builder_cls()(","+            spec, [layer.layer_name], config, dev","+        )","+        index_spec = indexer.k_cache.get_kv_cache_spec(config)","+        index_builder = DeepseekV32IndexerMetadataBuilder(","+            index_spec,","+            [indexer.k_cache.prefix],","+            config,","+            dev,","+            block_table_width=get_block_table_width(","+                index_spec.max_num_blocks_per_req(config, length), UNIT","+            ),","+        )","+        reqs = batch // q","+        gen = torch.Generator(device=dev).manual_seed(batch + q)","+        contexts = [contexts[r % len(contexts)] + 3 * r for r in range(reqs)]","+        mla, mla_table = paged_rows([c + q for c in contexts], UNIT, row, UNIT, gen)","+        index, index_table = paged_rows(","+            [c + q for c in contexts], UNIT, index_row(indexer), GAP, gen","+        )","+        old = [range(c) for c in contexts]","+        old_mla = owned_slots(mla_table, old)","+        old_index = owned_slots(index_table, old)","+        n = old_mla.numel()","+        unit = torch.ones(1, dtype=torch.float32, device=dev)","+        kv_c = torch.randn(n, 512, device=dev, dtype=bf, generator=gen)","+        k_pe = torch.randn(n, 64, device=dev, dtype=bf, generator=gen)","+        ops.concat_and_cache_mla(kv_c, k_pe, mla, old_mla, cache_dtype, unit)","+        keys = torch.randn(n, 128, device=dev, dtype=bf, generator=gen)","+        scratch = torch.empty(n, 2048, dtype=torch.int32, device=dev)","+        norm = torch.ones(128, dtype=bf, device=dev)","+        args = (norm, torch.zeros_like(norm), EPS, old_index, index, scratch, n)","+        insert = indexer_k_norm_quant_insert","+        if indexer.use_fp4_cache:","+            insert = mxfp4_k_norm_quant_insert","+        insert(keys, *args)","+        assert_index_nan_free(index)","+        new = [range(c, c + q) for c in contexts]","+        new_mla = owned_slots(mla_table, new)","+        new_index = owned_slots(index_table, new)","+        hidden = torch.randn(batch, LAYER_HIDDEN, device=dev, dtype=bf, generator=gen)","+        positions = torch.tensor([p for pos in new for p in pos], device=dev)","+        names = layer.layer_name, indexer.k_cache.prefix","+","+        def step(mla_cache, index_cache):","+            layer.kv_cache, indexer.k_cache.kv_cache = mla_cache, index_cache","+            md = builder.build(0, common_metadata(contexts, q, mla_table, new_mla))","+            index_md = index_builder.build(","+                0, common_metadata(contexts, q, index_table, new_index)","+            )","+            context = create_forward_context(","+                dict(zip(names, (md, index_md))),","+                config,","+                slot_mapping=dict(zip(names, (new_mla, index_md.slot_mapping))),","+            )","+            return md, override_forward_context(context)","+","+        entering = []","+        hook = attn.o_proj.register_forward_pre_hook(","+            lambda _, args: entering.append(args[0].clone())","+        )","+        stock_mla, stock_index = mla.clone(), index.clone()","+        _, context = step(stock_mla, stock_index)","+        with context:","+            stock = attn(positions, hidden)","+        hook.remove()","+        stock_topk = topk_buffer[:batch].clone()","+","+        policy = dict(kernels=(kernel,)) if kernel not in (None, \"auto\") else {}","+        runtime = SimpleNamespace(","+            device=dev,","+            buffers={},","+            wide=(batch,),","+            queries=(q,),","+            fi_kernels=policy.get(\"kernels\", fi_kernels(cache_dtype)),","+            prims_ts_rows=_prims_ts_row_buckets(config),","+        )","+        dep = DepAttention(SimpleNamespace(self_attn=attn), runtime)","+        ours_mla, ours_index = mla.clone(), index.clone()","+        md, context = step(ours_mla, ours_index)","+        dep.prepare_layout([ours_mla])","+        if dep.core.fused is not None:","+            dep.core.fused.write_ids(topk_buffer)","+        topk_buffer.fill_(-1)","+        with context:","+            out = dep.run_wide(hidden, [ours_mla], md, {names[0]: new_mla}, q)","+        torch.accelerator.synchronize()","+    return SimpleNamespace(","+        attn=attn,","+        out=out,","+        stock=stock,","+        local=dep.local[:batch].clone(),","+        entering=entering[0],","+        topk=topk_buffer[:batch].clone(),","+        stock_topk=stock_topk,","+        projected=dep.projected[:batch].clone(),","+        caches=(ours_mla, stock_mla),","+        mla_table=mla_table,","+        kv=cache_dtype,","+    )","+","+"," def relative(x, ref):","     return float((x.float() - ref.float()).norm() / ref.float().norm())"," "," ","+@pytest.mark.parametrize(\"core\", [\"fi-auto\", \"fi-prims_ts\"])","+@pytest.mark.parametrize(\"batch,q\", [(5, 5), (20, 5), (80, 5), (8, 1)])","+def test_dep_attention_matches_stock_short_context(","+    workspace_init, dist_init, core, batch, q","+):","+    \"\"\"DepAttention.run_wide against the stock 96-head DSA layer at contexts below","+    the top-k (2048): both attend over every token (no top-k tie can separate","+    them), and both pre-o_proj rows against FP32 attention over the dequantized","+    cache: ours at least as accurate as stock.","+","+    The two paths differ by ~2.8% (rel. RMS) at equal accuracy (~3.4% each vs","+    FP32), from two sources, both rounding-order effects (bisected stage by stage):","+    (1) the stock q_a / kv_a RMSNorm (native) rounds x * rstd to BF16 before the","+    weight multiply, ours rounds x * rstd * w once (the vllm_c kernel's math): 27%","+    of the q_c elements differ by one BF16 ulp, which flips ~10% of the FP8 query","+    codes (ours matches a single-rounding reference to <0.05% of bytes); (2) the FP8","+    sparse MLA kernels quantize P to E4M3 per KV tile, so the same top-k set in another","+    order changes the output by ~2.4% (the stock kernel against itself with its","+    top-k rows permuted); the fused indexer emits key order, stock's top-k its own","+    order. With identical inputs the core is the stock kernel.\"\"\"","+    from tests.models.kimi_k3.nvidia.specialized_decode.test_specialized_decode_dsa import (  # noqa: E501","+        layer_reference,","+    )","+","+    step = dep_layer_step(core, batch, q, (600, 1100, 1500, 1980, 37))","+    # Every token selected on both paths (contexts + q <= 2048).","+    for t in range(batch):","+        a = set(step.topk[t].tolist()) - {-1}","+        b = set(step.stock_topk[t].tolist()) - {-1}","+        assert a == b, t","+    # Each pre-o_proj row set against its own FP32 reference (same top-k).","+    args = step.attn, step.projected","+    ours_ref = layer_reference(","+        *args, step.caches[0], step.mla_table, step.topk, q, step.kv","+    )","+    stock_ref = layer_reference(","+        *args, step.caches[1], step.mla_table, step.stock_topk, q, step.kv","+    )","+    ours_err, stock_err = (","+        relative(step.local, ours_ref),","+        relative(step.entering, stock_ref),","+    )","+    between = relative(step.local, step.entering)","+    print(","+        f\"pre-o_proj vs FP32: ours {ours_err:.4f} stock {stock_err:.4f}; \"","+        f\"ours vs stock {between:.4f}; layer output vs stock \"","+        f\"{relative(step.out, step.stock):.4f}\"","+    )","+    assert ours_err <= 1.1 * stock_err + 1e-3, (ours_err, stock_err)","+    assert between < 0.04, between","+    assert relative(step.out, step.stock) < 0.04","+","+"," @pytest.mark.parametrize(\"heads,batch\", [(96, 80), (96, 320), (12, 80), (12, 320)])"," def test_value_bmm_gate_matches_mla_value(heads, batch):","     \"\"\"The wide value projection (the stock W_UV bmm over the heads, then MlaGate)"],"additions":209,"deletions":0,"truncated":false},{"path":"tests/models/kimi_k3/nvidia/specialized_decode/test_specialized_decode_dsa.py","lines":["@@ -4,15 +4,19 @@"," layer kernels against the stock cache writers, quantizers and a torch sparse"," attention reference.\"\"\""," ","+import gc"," import math"," import os"," from functools import partial"," from types import SimpleNamespace","+from typing import Any"," "," import pytest"," import torch"," "," from vllm.platforms import current_platform","+from vllm.utils.flashinfer import has_flashinfer_prims_ts_sparse_mla","+from vllm.v1.attention.backends.mla.flashinfer_mla_sparse import FlashInferMLASparseImpl"," "," pytestmark = pytest.mark.skipif(","     not current_platform.is_device_capability_family(100),","@@ -1125,6 +1129,172 @@ def test_fused_indexer_high_pages(mode):","             assert torch.equal(ids.sort().values, exact_topk(logits[t, :length], n))"," "," ","+@pytest.mark.parametrize(\"reqs,q\", [(4, 1), (8, 5), (12, 5)])","+@pytest.mark.parametrize(\"kernel\", [\"trtllm\", \"prims_ts\", \"nvfp4\"])","+def test_flashinfer_dcp_core_merges_to_full_attention(","+    default_vllm_config, dist_init, kernel, reqs, q","+):","+    \"\"\"DCP8 on FlashInfer sparse (per-tensor FP8): each rank's dcp_core over its","+    shard of a packed cache, its gathered 96-head query padded to 128 and the","+    global top-k, merged by LSE in the kernel's base, is the sparse attention","+    over the whole context. `q` rows per request (DSpark verify), each row with","+    its own top-k; request 0 lies on rank 0 only (empty shards: an LSE DcpValue","+    drops, with no masking kernel). `nvfp4`: prims_ts over an nvfp4_ds_mla","+    cache.\"\"\"","+    from vllm.model_executor.layers.linear import ColumnParallelLinear","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.dsa.attn_fi import (","+        FlashInferCore,","+    )","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.dsa.prepared import (","+        PreparedDsa,","+    )","+","+    if kernel != \"trtllm\" and not has_flashinfer_prims_ts_sparse_mla():","+        pytest.skip(\"FlashInfer has no prims_ts sparse MLA\")","+    nvfp4 = kernel == \"nvfp4\"","+    kernel = \"prims_ts\" if nvfp4 else kernel","+    default_vllm_config.kernel_config.flashinfer_sparse_mla_kernel = kernel","+    text = SimpleNamespace(kv_lora_rank=512, qk_rope_head_dim=64)","+    object.__setattr__(","+        default_vllm_config, \"model_config\", SimpleNamespace(hf_text_config=text)","+    )","+    dcp, heads, topk, block, context = 8, HEADS * 8, 2048, UNIT, 5000","+    rows_n = reqs * q","+    impl = FlashInferMLASparseImpl(","+        num_heads=heads,","+        head_size=FP8_ROW,","+        scale=192**-0.5,","+        num_kv_heads=1,","+        alibi_slopes=None,","+        sliding_window=None,","+        kv_cache_dtype=\"nvfp4_ds_mla\" if nvfp4 else \"fp8_e4m3\",","+        logits_soft_cap=None,","+        attn_type=\"decoder\",","+        kv_sharing_target_layer_name=None,","+        q_lora_rank=None,","+        kv_lora_rank=512,","+        qk_nope_head_dim=128,","+        qk_rope_head_dim=64,","+        qk_head_dim=192,","+        v_head_dim=128,","+        kv_b_proj=ColumnParallelLinear(512, heads * 256, bias=False),","+    )","+    impl.need_to_return_lse_for_decode = True","+    impl._workspace_buffer = torch.zeros(1 << 30, dtype=torch.int8, device=\"cuda\")","+    layer = SimpleNamespace(_q_scale_float=1.0, _k_scale_float=1.0)","+    e4m3 = torch.float8_e4m3fn","+","+    gen = torch.Generator(device=\"cuda\").manual_seed(0)","+    # Each rank's latents are offset differently and the scores are peaked, so the","+    # shards' partial outputs and LSEs differ: a wrong LSE base misweights them.","+    owner = torch.arange(context, device=\"cuda\") % dcp","+    if nvfp4:  # the shards' block scales differ","+        kv = random_nvfp4(reqs, context, gen=gen)","+        kv[..., 320:] = 0x18 + 2 * owner.view(1, -1, 1).to(torch.uint8)","+        row_bytes = NVFP4_ROW","+    else:","+        kv = torch.rand(reqs, context, FP8_ROW, generator=gen, device=\"cuda\") - 0.5","+        kv[..., :512] += 0.2 * owner.view(1, -1, 1)","+        kv = kv.to(e4m3)","+        row_bytes = FP8_ROW","+    query = torch.zeros(rows_n, 128, FP8_ROW, dtype=torch.uint8, device=\"cuda\")","+    rand = torch.rand(rows_n, heads, FP8_ROW, generator=gen, device=\"cuda\")","+    query[:, :heads] = (8 * (rand - 0.5)).to(e4m3).view(torch.uint8)","+    tokens = torch.full((rows_n, topk), -1, dtype=torch.int32, device=\"cuda\")","+    for t in range(rows_n):","+        r = t // q","+        # Row t of a request sees its context up to its own position.","+        end, step = context - (q - 1 - t % q), dcp if r == 0 else 1","+        pool = torch.arange(0, end, step, device=\"cuda\")","+        pick = pool[torch.randperm(pool.numel(), generator=gen, device=\"cuda\")]","+        n = min(topk - 37 * (t % 9), pick.numel())","+        tokens[t, :n] = pick[:n].int()","+","+    local = -(-context // dcp)","+    blocks_per_req = -(-local // block)","+    rows, lses = [], []","+    for rank in range(dcp):","+        # FlashInfer aligns packed block strides to its 32-row pages.","+        cache = packed_cache(reqs * blocks_per_req, block, row_bytes, gap=block)","+        order = torch.randperm(reqs * blocks_per_req, generator=gen, device=\"cuda\")","+        table = order.view(reqs, blocks_per_req).int()","+        for r in range(reqs):","+            mine = torch.arange(rank, context, dcp, device=\"cuda\")","+            slot = torch.arange(mine.numel(), device=\"cuda\")","+            physical = table[r, slot // block].long()","+            cache[physical, slot % block] = kv[r, mine].view(torch.uint8)","+        req_ids = torch.arange(rows_n, dtype=torch.int32, device=\"cuda\") // q","+        md = SimpleNamespace(","+            req_id_per_token=req_ids, block_table=table, block_size=block","+        )","+        box = torch.zeros(2, rows_n, 128, FP8_ROW, dtype=torch.uint8, device=\"cuda\")","+        box[0] = query","+        buffers = fi_buffers(rows_n, 128)","+        fi = FlashInferCore(impl, layer, 128, buffers, {rows_n: kernel}, dcp, rank)","+        core = SimpleNamespace(","+            fi=fi,","+            indexer=SimpleNamespace(cp_kv_cache_interleave_size=1),","+            parity=0,","+            box=SimpleNamespace(q=box),","+            # This test covers the FlashInfer decode core (not the sparse one).","+            cores={(rows_n, 1): kernel},","+        )","+        # Stale rows and LSEs of an earlier layer must not leak into empty rows.","+        buffers[2].fill_(float(\"nan\"))","+        buffers[3].fill_(1.0)","+        row, lse, valid = PreparedDsa.dcp_core(core, cache, tokens, md, rows_n)","+        assert row.shape == (rows_n, 128, 512) and lse.shape == (rows_n, 128)","+        assert row.data_ptr() == buffers[2].data_ptr()","+        assert lse.data_ptr() == buffers[3].data_ptr()","+        if rank:","+            assert (valid[:q] == 0).all(), \"an empty shard must not count\"","+        # As DcpValue: the rows of no valid entries are dropped (LSE unused).","+        lse = lse.masked_fill((valid == 0).view(-1, 1), -torch.inf)","+        rows.append(row[:, :heads].float())","+        lses.append(lse[:, :heads].float())","+","+    lse = torch.stack(lses)","+    if not impl.lse_base_on_e:","+        lse = lse * torch.log(torch.tensor(2.0, device=\"cuda\"))","+    weights = torch.softmax(lse, dim=0).unsqueeze(-1)","+    merged = (weights * torch.stack(rows).nan_to_num()).sum(0)","+","+    queries = query[:, :heads].view(e4m3).float()","+    for t in range(rows_n):","+        picked = tokens[t][tokens[t] >= 0].long()","+        keys = kv[t // q, picked]","+        keys = nvfp4_rows(keys, e4m3=True) if nvfp4 else keys.float()","+        probs = torch.softmax(queries[t] @ keys.T * impl.scale, dim=-1)","+        ref = probs @ keys[:, :512]","+        torch.testing.assert_close(merged[t], ref, atol=3e-2, rtol=3e-2)","+","+","+def test_flashinfer_kernel_policy():","+    \"\"\"The FlashInfer sparse MLA kernel per batch: one runnable kernel is always","+    taken, else the measured table per topology.\"\"\"","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.common.policy import (","+        batch_table,","+    )","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.dsa.attn_fi import (","+        FI_KERNEL,","+        KERNELS,","+        kernel_for,","+    )","+","+    for dcp in (False, True):","+        table = batch_table(FI_KERNEL[\"dcp\" if dcp else \"tp\"])","+        assert set(range(1, 321)) <= set(table) and set(table.values()) <= {*KERNELS}","+        for rows in (1, 5, 40, 60, 64, 320):","+            assert kernel_for(rows, dcp, KERNELS) == table[rows]","+            for kernel in KERNELS:","+                assert kernel_for(rows, dcp, (kernel,)) == kernel","+    # DCP8 batches whose KV split schedules differ between the kernels (trtllm-gen","+    # splits each row up to 39 rows, prims_ts only on plans of up to 19) stay on","+    # the stock decode's kernel (test_flashinfer_kernels_share_precision).","+    for rows in range(20, 40):","+        assert kernel_for(rows, True, KERNELS) == \"trtllm\"","+","+"," def fi_buffers(rows, heads, topk=2048):","     \"\"\"FlashInferCore's shared buffers: flat rows, counts, latent and LSE.\"\"\"","     i32 = dict(dtype=torch.int32, device=\"cuda\")","@@ -1136,12 +1306,142 @@ def fi_buffers(rows, heads, topk=2048):","     )"," "," ","+def flashinfer_impl(heads, kernel, config, kv_cache_dtype=\"fp8_e4m3\"):","+    \"\"\"A FlashInfer sparse MLA impl at K3.1's MLA sizes on `kernel` (trtllm-gen or","+    prims_ts), with a workspace.\"\"\"","+    from vllm.model_executor.layers.linear import ColumnParallelLinear","+","+    config.kernel_config.flashinfer_sparse_mla_kernel = kernel","+    text = SimpleNamespace(kv_lora_rank=512, qk_rope_head_dim=64)","+    object.__setattr__(config, \"model_config\", SimpleNamespace(hf_text_config=text))","+    impl = FlashInferMLASparseImpl(","+        num_heads=heads,","+        head_size=FP8_ROW,","+        scale=192**-0.5,","+        num_kv_heads=1,","+        alibi_slopes=None,","+        sliding_window=None,","+        kv_cache_dtype=kv_cache_dtype,","+        logits_soft_cap=None,","+        attn_type=\"decoder\",","+        kv_sharing_target_layer_name=None,","+        q_lora_rank=None,","+        kv_lora_rank=512,","+        qk_nope_head_dim=128,","+        qk_rope_head_dim=64,","+        qk_head_dim=192,","+        v_head_dim=128,","+        kv_b_proj=ColumnParallelLinear(512, heads * 256, bias=False),","+    )","+    impl._workspace_buffer = torch.zeros(1 << 30, dtype=torch.int8, device=\"cuda\")","+    return impl","+","+"," def random_fp8(*shape, gen=None):","     \"\"\"FP8 E4M3 bytes of magnitude below 2 (no NaN codes).\"\"\"","     raw = torch.randint(0, 256, shape, dtype=torch.uint8, device=\"cuda\", generator=gen)","     return raw & 0xBF"," "," ","+@pytest.mark.parametrize(\"context\", [600, 4096, 33000])","+@pytest.mark.parametrize(","+    \"batch,q\", [(1, 1), (5, 5), (10, 5), (40, 5), (60, 5), (64, 1)]","+)","+@pytest.mark.parametrize(\"kernel\", [\"trtllm\", \"prims_ts\", \"nvfp4\"])","+def test_flashinfer_sparse_core_tp(","+    default_vllm_config, dist_init, kernel, batch, q, context","+):","+    \"\"\"TP8 (12 local heads, the whole context) on FlashInfer sparse (per-tensor","+    FP8): the sparse core's logical -> physical top-k conversion and sparse decode","+    of the FP8 query rows over the flat rows of a packed cache, against softmax","+    attention over the gathered rows. `q` rows per request (DSpark verify) each","+    see their context up to their own position; contexts around `context` (some","+    shorter than the top-k, -1 padded), one row without entries. The latent lands","+    in the shared buffer, as MlaValue reads it. `nvfp4`: prims_ts over an","+    nvfp4_ds_mla cache.\"\"\"","+    from vllm.models.kimi_k3.nvidia.specialized_decode.cutedsl.dsa.attn_fi import (","+        FlashInferCore,","+    )","+","+    if kernel != \"trtllm\" and not has_flashinfer_prims_ts_sparse_mla():","+        pytest.skip(\"FlashInfer has no prims_ts sparse MLA\")","+    nvfp4 = kernel == \"nvfp4\"","+    kv_dtype = \"nvfp4_ds_mla\" if nvfp4 else \"fp8_e4m3\"","+    kernel = \"prims_ts\" if nvfp4 else kernel","+    impl = flashinfer_impl(HEADS, kernel, default_vllm_config, kv_dtype)","+    topk_buffer = torch.full((64, 2048), -1, dtype=torch.int32, device=\"cuda\")","+    layer = SimpleNamespace(_q_scale_float=1.0, _k_scale_float=1.0)","+","+    gen = torch.Generator(device=\"cuda\").manual_seed(batch * 7 + context)","+    reqs, block = batch // q, UNIT","+    lengths = context + torch.randint(-300, 300, (reqs,), generator=gen, device=\"cuda\")","+    lengths = lengths.clamp(min=q).tolist()","+    pages = [-(-n // block) for n in lengths]","+    # Blocks lie a block apart (other layers' pages), in a random order.","+    if nvfp4:","+        mla = packed