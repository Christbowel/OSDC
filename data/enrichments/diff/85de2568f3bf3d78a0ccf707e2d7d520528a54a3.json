,"+/* The `ca` option: every CERTIFICATE block of `content` as DER into `certs`. User-supplied certificates are validated","+ * with a full parse here so a bad one fails the context rather than a later handshake; the parsed object is dropped and","+ * the store keeps the DER lazily. Returns the number appended, or -1 for content that is not PEM or whose first","+ * certificate block does not decode or parse. As with a PEM_read_bio_X509 loop, a PEM document with no certificates","+ * (Node's tests pass a private key) counts as zero, and blocks after one that fails are ignored. */","+static int us_collect_ca_pem(SSL_CTX *ctx, const char *content, STACK_OF(CRYPTO_BUFFER) *certs) {","+  if (content == NULL) return 0;","+  ERR_clear_error();","+  BIO *in = BIO_new_mem_buf(content, strlen(content));","+  if (in == NULL) return -1;","+  int count = 0;","+  for (;;) {","+    uint8_t *der = NULL;","+    long der_len = 0;","+    char *name = NULL;","+    if (!PEM_bytes_read_bio(&der, &der_len, &name, PEM_STRING_X509, in, SSL_CTX_get_default_passwd_cb(ctx),","+                            SSL_CTX_get_default_passwd_cb_userdata(ctx))) {","+      break;","+    }","+    OPENSSL_free(name);","+    CRYPTO_BUFFER *buf = CRYPTO_BUFFER_new(der, der_len, NULL);","+    OPENSSL_free(der);","+    X509 *parsed = buf != NULL ? X509_parse_from_buffer(buf) : NULL;","+    if (parsed == NULL) {","+      CRYPTO_BUFFER_free(buf);","+      buf = NULL;","+    }","+    X509_free(parsed);","+    if (buf == NULL || !sk_CRYPTO_BUFFER_push(certs, buf)) {","+      CRYPTO_BUFFER_free(buf);","+      if (count == 0) count = -1;","+      break;","+    }","+    count++;","+  }","+  BIO_free(in);","+  if (count == 0) {","+    unsigned long pem_err = ERR_peek_last_error();","+    if (!((pem_err == 0 || (ERR_GET_LIB(pem_err) == ERR_LIB_PEM && ERR_GET_REASON(pem_err) == PEM_R_NO_START_LINE)) &&","+          strstr(content, \"-----BEGIN \") != NULL)) {","+      count = -1;","+    }","+  }","+  ERR_clear_error();","+  return count;","+}","+","+static int us_crypto_buffer_cmp(const CRYPTO_BUFFER *const *a, const CRYPTO_BUFFER *const *b) {","+  size_t al = CRYPTO_BUFFER_len(*a), bl = CRYPTO_BUFFER_len(*b);","+  if (al != bl) return al < bl ? -1 : 1;","+  return memcmp(CRYPTO_BUFFER_data(*a), CRYPTO_BUFFER_data(*b), al);","+}","+","+/* Trusts the DER certificates in `certs` (duplicates dropped) through one lazily-parsed set on `store`, and makes their","+ * subjects the context's client-CA list, as X509_STORE_add_cert + SSL_CTX_add_client_CA per parsed certificate did.","+ * Consumes `certs`. */","+static int us_install_ca_buffers(SSL_CTX *ctx, X509_STORE *store, STACK_OF(CRYPTO_BUFFER) *certs) {","+  int ok = 1;","+  size_t n = sk_CRYPTO_BUFFER_num(certs);","+  if (n > 1) {","+    sk_CRYPTO_BUFFER_set_cmp_func(certs, us_crypto_buffer_cmp);","+    sk_CRYPTO_BUFFER_sort(certs);","+    size_t kept = 0;","+    for (size_t i = 0; i < n; i++) {","+      CRYPTO_BUFFER *buf = sk_CRYPTO_BUFFER_value(certs, i);","+      const CRYPTO_BUFFER *prev = kept > 0 ? sk_CRYPTO_BUFFER_value(certs, kept - 1) : NULL;","+      if (prev != NULL && us_crypto_buffer_cmp((const CRYPTO_BUFFER *const *)&buf, &prev) == 0) {","+        CRYPTO_BUFFER_free(buf);","+        continue;","+      }","+      sk_CRYPTO_BUFFER_set(certs, kept++, buf);","+    }","+    while (sk_CRYPTO_BUFFER_num(certs) > kept) sk_CRYPTO_BUFFER_pop(certs);","+    n = kept;","+  }","+  if (n > 0) {","+    CRYPTO_BUFFER **bufs = (CRYPTO_BUFFER **)malloc(n * sizeof(CRYPTO_BUFFER *));","+    for (size_t i = 0; bufs != NULL && i < n; i++) bufs[i] = sk_CRYPTO_BUFFER_value(certs, i);","+    X509_LAZY_CERT_SET *set = bufs != NULL ? X509_LAZY_CERT_SET_new(bufs, n) : NULL;","+    free(bufs);","+    STACK_OF(CRYPTO_BUFFER) *names = sk_CRYPTO_BUFFER_new_null();","+    ok = set != NULL && names != NULL && X509_STORE_add_lazy_cert_set(store, set);","+    for (size_t i = 0; ok && i < n; i++) {","+      const uint8_t *subject;","+      size_t subject_le