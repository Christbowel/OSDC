, &a_begin, &a_end));","+  ASSERT_EQ(db_->Get(ReadOptions(), \"a_lost\", &value).code(),","+            Status::kNotFound);","+  ASSERT_EQ(Get(\"a_live\"), \"healthy\");","+  Reopen(options);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"a_lost\", &value).code(),","+            Status::kNotFound);","+  ASSERT_EQ(Get(\"a_live\"), \"healthy\");","+}","+"," TEST_F(DBBlobBasicTest, GetMergeBlobWithPut) {","   Options options = GetDefaultOptions();","   options.merge_operator = MergeOperators::CreateStringAppendOperator();","@@ -2315,6 +2711,179 @@ class DBBlobWithTimestampTest : public DBBasicTestWithTimestampBase {","       : DBBasicTestWithTimestampBase(\"db_blob_with_timestamp_test\") {}"," };"," ","+TEST_F(DBBlobWithTimestampTest, RepairPreservesTimestampHistoryAfterRecovery) {","+  Options options = GetDefaultOptions();","+  options.create_if_missing = true;","+  options.enable_blob_files = true;","+  options.min_blob_size = 0;","+  options.enable_blob_garbage_collection = false;","+  options.disable_auto_compactions = true;","+  options.num_levels = 3;","+  options.level_compaction_dynamic_level_bytes = false;","+  TestComparator test_cmp(Timestamp(0, 0).size());","+  options.comparator = &test_cmp;","+  DestroyAndReopen(options);","+  Defer close_db([this]() { Close(); });","+  const std::string old_timestamp = Timestamp(1, 0);","+  const std::string middle_timestamp = Timestamp(2, 0);","+  const std::string lost_timestamp = Timestamp(3, 0);","+  const std::string latest_timestamp = Timestamp(4, 0);","+  const Slice old_ts(old_timestamp);","+  const Slice middle_ts(middle_timestamp);","+  const Slice lost_ts(lost_timestamp);","+  const Slice latest_ts(latest_timestamp);","+  ReadOptions healthy_read;","+  healthy_read.verify_checksums = true;","+  healthy_read.timestamp = &latest_ts;","+  std::string healthy_value;","+  ASSERT_OK(db_->Put(WriteOptions(), \"a\", old_ts, \"healthy\"));","+  ASSERT_OK(db_->Put(WriteOptions(), \"b\", old_ts, \"older\"));","+  const Sequen