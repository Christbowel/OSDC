+TEST_F(DBBlobBasicTest, RepairMissingNonOldestBlobAfterBestEffortsRecovery) {","+  Options options = MissingBlobRepairOptions();","+  options.statistics = CreateDBStatistics();","+  uint64_t missing_blob_file = 0;","+  ASSERT_NO_FATAL_FAILURE(","+      RecoverMissingNonOldestBlob(options, false, &missing_blob_file));","+  const std::vector<uint64_t> healthy_blob_files = GetBlobFileNumbers();","+  ColumnFamilyMetaData before;","+  db_->GetColumnFamilyMetaData(db_->DefaultColumnFamily(), &before);","+","+  CompactRangeOptions repair;","+  repair.skip_missing_blob_files = true;","+  repair.bottommost_level_compaction = BottommostLevelCompaction::kSkip;","+  repair.max_subcompactions = 2;","+  repair.blob_garbage_collection_policy = BlobGarbageCollectionPolicy::kDisable;","+  ASSERT_OK(options.statistics->Reset());","+  ASSERT_OK(db_->CompactRange(repair, nullptr, nullptr));","+  ASSERT_GT(options.statistics->getTickerCount(COMPACT_READ_BYTES), 0);","+  ASSERT_EQ(options.statistics->getTickerCount(BLOB_DB_BLOB_FILE_BYTES_READ),","+            0);","+","+  ColumnFamilyMetaData after;","+  db_->GetColumnFamilyMetaData(db_->DefaultColumnFamily(), &after);","+  std::set<std::string> input_files;","+  for (const LevelMetaData& before_level : before.levels) {","+    for (const SstFileMetaData& input : before_level.files) {","+      input_files.insert(input.name);","+    }","+  }","+  for (const LevelMetaData& after_level : after.levels) {","+    for (const SstFileMetaData& output : after_level.files) {","+      ASSERT_EQ(input_files.count(output.name), 0);","+    }","+  }","+  ASSERT_EQ(GetBlobFileNumbers(), healthy_blob_files);","+  ASSERT_EQ(Get(\"a\"), \"va\");","+  ASSERT_EQ(Get(\"c\"), \"vc\");","+  std::string value;","+  ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kNotFound);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"d\", &value).code(), Status::kNotFound);","+","+  Reopen(options);","+  ASSERT_EQ(Get(\"a\"), \"va\");","+  ASSERT_EQ(Get(\"c\"), \"vc\");","+  ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kNotFound);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"d\", &value).code(), Status::kNotFound);","+}","+","+TEST_F(DBBlobBasicTest, MissingBlobRepairIsScopedToCompactRange) {","+  Options options = MissingBlobRepairOptions();","+  options.paranoid_checks = false;","+  uint64_t missing_blob_file = 0;","+  ASSERT_NO_FATAL_FAILURE(","+      RecoverMissingNonOldestBlob(options, false, &missing_blob_file));","+  ASSERT_OK(Put(\"b\", \"replacement\"));","+  ASSERT_OK(Flush());","+","+  const Status normal_compaction =","+      db_->CompactRange(CompactRangeOptions(), nullptr, nullptr);","+  ASSERT_EQ(normal_compaction.code(), Status::kCorruption);","+  ASSERT_NE(normal_compaction.ToString().find(\"unknown blob file\"),","+            std::string::npos);","+","+  CompactRangeOptions repair;","+  repair.skip_missing_blob_files = true;","+  ASSERT_OK(db_->CompactRange(repair, nullptr, nullptr));","+  ASSERT_EQ(Get(\"b\"), \"replacement\");","+  ASSERT_EQ(Get(\"a\"), \"va\");","+  std::string value;","+  ASSERT_EQ(db_->Get(ReadOptions(), \"d\", &value).code(), Status::kNotFound);","+  ASSERT_OK(db_->CompactRange(CompactRangeOptions(), nullptr, nullptr));","+  Reopen(options);","+  ASSERT_EQ(Get(\"b\"), \"replacement\");","+","+  const uint64_t later_missing_blob = GetBlobFileNumbers().back();","+  Close();","+  ASSERT_OK(env_->DeleteFile(BlobFileName(dbname_, later_missing_blob)));","+  Reopen(options);","+  const Status later_corruption = db_->Get(ReadOptions(), \"b\", &value);","+  ASSERT_FALSE(later_corruption.ok());","+  ASSERT_TRUE(later_corruption.IsCorruption() || later_corruption.IsIOError() ||","+              later_corruption.IsNotFound())","+      << later_corruption.ToString();","+}","+","+TEST_F(DBBlobBasicTest, RepairMissingBlobsAcrossSubcompactions) {","+  Options options = MissingBlobRepairOptions();","+  options.statistics = CreateDBStatistics();","+  options.compression = kNoCompressio