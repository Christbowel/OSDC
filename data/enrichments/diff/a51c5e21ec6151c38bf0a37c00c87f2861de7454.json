t Version with deletions","+// or entities containing the surviving columns. Input values must already be","+// prepared, as they are for compaction input. Neither input is owned.","+class MissingBlobRepairIterator : public InternalIterator {","+ public:","+  MissingBlobRepairIterator(InternalIterator* input,","+                            const VersionStorageInfo* input_storage,","+                            size_t timestamp_size)","+      : input_(input),","+        input_storage_(input_storage),","+        timestamp_size_(timestamp_size) {","+    assert(input_);","+    assert(input_storage_);","+    Update();","+  }","+","+  bool Valid() const override { return input_->Valid() && status_.ok(); }","+","+  void SeekToFirst() override {","+    input_->SeekToFirst();","+    Update();","+  }","+","+  void SeekToLast() override {","+    input_->SeekToLast();","+    Update();","+  }","+","+  void Seek(const Slice& target) override {","+    // A rewritten type can sort after its original type at the same sequence.","+    const std::string target_copy = target.ToString();","+    ParsedInternalKey parsed;","+    status_ = ParseInternalKey(target_copy, &parsed, false);","+    if (!status_.ok()) {","+      return;","+    }","+    InternalKey seek_key(parsed.user_key, parsed.sequence, kValueTypeForSeek);","+    input_->Seek(seek_key.Encode());","+    Update();","+    while (Valid() && input_storage_->InternalComparator()->Compare(","+                          key(), target_copy) < 0) {","+      Next();","+    }","+  }","+","+  void SeekForPrev(const Slice& target) override {","+    const std::string target_copy = target.ToString();","+    input_->SeekForPrev(target_copy);","+    Update();","+    while (Valid() && input_storage_->InternalComparator()->Compare(","+                          key(), target_copy) > 0) {","+      Prev();","+    }","+  }","+","+  void Next() override {","+    assert(Valid());","+    input_->Next();","+    Update();","+  }","+","+  void Prev() override {","+    assert(Valid());"],"additions":84,"deletions":0,"truncated":false}],"additions":683,"deletions":1,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-04T16:05:51.989301+00:00"}