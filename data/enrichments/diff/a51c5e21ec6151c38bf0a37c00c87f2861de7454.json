adOptions(), Key(key), &value).code(),","+                Status::kNotFound);","+    }","+  }","+}","+","+TEST_F(DBBlobBasicTest, RepairPropagatesKnownBlobFileIoFailureDuringGc) {","+  Options options = MissingBlobRepairOptions();","+  DestroyAndReopen(options);","+  ASSERT_OK(Put(\"key\", \"value\"));","+  ASSERT_OK(Flush());","+  const std::vector<uint64_t> blob_files = GetBlobFileNumbers();","+  ASSERT_EQ(blob_files.size(), 1);","+  Close();","+  ASSERT_OK(env_->DeleteFile(BlobFileName(dbname_, blob_files.front())));","+  Reopen(options);","+  ASSERT_EQ(GetBlobFileNumbers(), blob_files);","+  ASSERT_NO_FATAL_FAILURE(AssertBlobReference(\"key\", blob_files.front()));","+","+  std::atomic<size_t> blob_file_opens{0};","+  SyncPoint::GetInstance()->SetCallBack(","+      \"BlobFileReader::OpenFile:NewRandomAccessFile\",","+      [&blob_file_opens](void*) { ++blob_file_opens; });","+  Defer clear_sync_points([]() {","+    SyncPoint::GetInstance()->DisableProcessing();","+    SyncPoint::GetInstance()->ClearAllCallBacks();","+  });","+  SyncPoint::GetInstance()->EnableProcessing();","+  CompactRangeOptions repair;","+  repair.skip_missing_blob_files = true;","+  repair.blob_garbage_collection_policy = BlobGarbageCollectionPolicy::kForce;","+  repair.blob_garbage_collection_age_cutoff = 1.0;","+  const Status status = db_->CompactRange(repair, nullptr, nullptr);","+  ASSERT_FALSE(status.ok());","+  ASSERT_TRUE(status.IsIOError() || status.IsCorruption() ||","+              status.IsNotFound())","+      << status.ToString();","+  ASSERT_GT(blob_file_opens.load(), 0);","+  ASSERT_EQ(GetBlobFileNumbers(), blob_files);","+  ASSERT_NO_FATAL_FAILURE(AssertBlobReference(\"key\", blob_files.front()));","+}","+","+TEST_F(DBBlobBasicTest, RepairMissingBlobPreservesSnapshotDeletionSemantics) {","+  for (const bool use_merge : {false, true}) {","+    SCOPED_TRACE(\"use_merge=\" + std::to_string(use_merge));","+    Options options = MissingBlobRepairOptions();","+    if (use_merge) {","+      options.merge_operator = MergeOperators::CreateStringAppendOperator();","+    }","+    uint64_t missing_blob_file = 0;","+    ASSERT_NO_FATAL_FAILURE(","+        RecoverMissingNonOldestBlob(options, true, &missing_blob_file));","+    {","+      const Snapshot* snapshot = db_->GetSnapshot();","+      Defer release_snapshot(","+          [this, snapshot]() { db_->ReleaseSnapshot(snapshot); });","+      if (use_merge) {","+        ASSERT_OK(Merge(\"b\", \"replacement\"));","+      } else {","+        ASSERT_OK(Put(\"b\", \"replacement\"));","+      }","+      ASSERT_OK(Flush());","+","+      CompactRangeOptions repair;","+      repair.skip_missing_blob_files = true;","+      ASSERT_OK(db_->CompactRange(repair, nullptr, nullptr));","+      ASSERT_EQ(Get(\"b\"), \"replacement\");","+      ReadOptions read;","+      read.snapshot = snapshot;","+      std::string value;","+      ASSERT_EQ(db_->Get(read, \"b\", &value).code(), Status::kNotFound);","+      ASSERT_OK(db_->Get(read, \"a\", &value));","+      ASSERT_EQ(value, \"va\");","+    }","+    Reopen(options);","+    ASSERT_EQ(Get(\"b\"), \"replacement\");","+  }","+}","+","+TEST_F(DBBlobBasicTest, RepairMissingBlobPairedWithSingleDelete) {","+  Options options = MissingBlobRepairOptions();","+  uint64_t missing_blob_file = 0;","+  ASSERT_NO_FATAL_FAILURE(","+      RecoverMissingNonOldestBlob(options, false, &missing_blob_file));","+  {","+    const Snapshot* snapshot = db_->GetSnapshot();","+    Defer release_snapshot(","+        [this, snapshot]() { db_->ReleaseSnapshot(snapshot); });","+    ASSERT_OK(SingleDelete(\"b\"));","+    ASSERT_OK(Flush());","+","+    CompactRangeOptions repair;","+    repair.skip_missing_blob_files = true;","+    ASSERT_OK(db_->CompactRange(repair, nullptr, nullptr));","+    std::string value;","+    ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kNotFound);","+    ReadOptions read;","+    read.snapshot = snapshot;","+    ASSERT_EQ(db_->Get(read, \"b\", &value).code(), Status::kNotFound);","+    ASSERT_OK(db_->Get(read, \"a\", &value));","+    ASSERT_EQ(value, \"va\");","+  }","+","+  CompactRangeOptions normal;","+  normal.bottommost_level_compaction = BottommostLevelCompaction::kForce;","+  ASSERT_OK(db_->CompactRange(normal, nullptr, nullptr));","+  Reopen(options);","+  std::string value;","+  ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kNotFound);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"d\", &value).code(), Status::kNotFound);","+  ASSERT_EQ(Get(\"a\"), \"va\");","+  ASSERT_EQ(Get(\"c\"), \"vc\");","+}","+","+TEST_F(DBBlobBasicTest, RepairMissingBlobWithNoLiveBlobMetadata) {","+  Options options = MissingBlobRepairOptions();","+  uint64_t missing_blob_file = 0;","+  ASSERT_NO_FATAL_FAILURE(","+      RecoverMissingNonOldestBlob(options, false, &missing_blob_file));","+  ASSERT_OK(Delete(\"a\"));","+  ASSERT_OK(Delete(\"c\"));","+  ASSERT_OK(Flush());","+  ASSERT_OK(db_->CompactRange(CompactRangeOptions(), nullptr, nullptr));","+  ASSERT_TRUE(GetBlobFileNumbers().empty());","+  ASSERT_NO_FATAL_FAILURE(AssertBlobReference(\"b\", missing_blob_file));","+  ASSERT_NO_FATAL_FAILURE(AssertBlobReference(\"d\", missing_blob_file));","+  std::string value;","+  ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kCorruption);","+","+  CompactRangeOptions repair;","+  repair.skip_missing_blob_files = true;","+  ASSERT_OK(db_->CompactRange(repair, nullptr, nullptr));","+  ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kNotFound);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"d\", &value).code(), Status::kNotFound);","+  Reopen(options);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"b\", &value).code(), Status::kNotFound);","+  ASSERT_EQ(db_->Get(ReadOptions(), \"d\", &value).code(), Status::kNotFound);","+}","+","+TEST_F(DBBlobBasicTest, RepairRetainsHealthyBlobsReferencedByUntouchedSsts) {","+  Options options = MissingBlobRepairOptions();","+  options.sst_partitioner_factory = NewSstPartiti