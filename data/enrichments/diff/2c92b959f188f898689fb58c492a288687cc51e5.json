{"id":"2c92b959f188f898689fb58c492a288687cc51e5","axis":"silent","repo":"datafuselabs/databend","sha":"2c92b959f188f898689fb58c492a288687cc51e5","parsed":{"files":[{"path":"src/common/column/src/bitmap/utils/slice_iterator.rs","lines":["@@ -102,24 +102,34 @@ impl Iterator for SlicesIterator<'_> {","             }"," ","             if self.mask == 1 {","-                // at the beginning of a byte => try to skip it all together","-                match (self.on_region, self.current_byte) {","-                    (true, &255u8) => {","-                        self.len = std::cmp::min(self.max_len - self.start, self.len + 8);","-                        if let Some(v) = self.values.next() {","-                            self.current_byte = v;","-                        };","-                        continue;","-                    }","-                    (false, &0) => {","-                        self.len = std::cmp::min(self.max_len - self.start, self.len + 8);","-                        if let Some(v) = self.values.next() {","-                            self.current_byte = v;","-                        };","-                        continue;","+                // At the beginning of a byte: a byte of the current region's kind (all","+                // zeros off a region, all ones on one) is skipped whole, followed by the","+                // 64-bit words of that kind after it, so a sparse bitmap costs one","+                // comparison per word rather than one step per byte.","+                let same = if self.on_region { u8::MAX } else { 0 };","+                if *self.current_byte == same {","+                    let word = [same; 8];","+                    let words = self","+                        .values","+                        .as_slice()","+                        .as_chunks::<8>()","+                        .0","+                        .iter()","+                        .take_while(|chunk| **chunk == word)","+                        .count();","+                    if words > 0 {","+                        self.values.nth(words * 8 - 1);","                     }","-                    _ => (), // we need to run over all bits of this byte","+                    // The bytes skipped may reach past the end of the bitmap. Clamping the","+                    // length to it is also what ends the iteration: the loop stops when","+                    // `current_len()` is exactly `max_len`.","+                    self.len = std::cmp::min(self.max_len - self.start, self.len + 8 + words * 64);","+                    if let Some(v) = self.values.next() {","+                        self.current_byte = v;","+                    };","+                    continue;","                 }","+                // otherwise we need to run over all bits of this byte","             };"," ","             let value = (self.current_byte & self.mask) != 0;"],"additions":26,"deletions":16,"truncated":false},{"path":"src/common/column/tests/it/bitmap/utils/slice_iterator.rs","lines":["@@ -163,3 +163,116 @@ fn remainder_1() {","     let chunks = iter.collect::<Vec<_>>();","     assert_eq!(chunks, vec![(2, 1), (4, 1)]);"," }","+","+/// The runs of set bits of `bitmap`, one bit at a time.","+fn naive_slices(bitmap: &Bitmap) -> Vec<(usize, usize)> {","+    let mut slices = Vec::new();","+    let mut run: Option<(usize, usize)> = None;","+    for (i, set) in bitmap.iter().enumerate() {","+        match (set, run) {","+            (true, Some((start, len))) => run = Some((start, len + 1)),","+            (true, None) => run = Some((i, 1)),","+            (false, Some(r)) => {","+                slices.push(r);","+                run = None;","+            }","+            (false, None) => {}","+        }","+    }","+    slices.extend(run);","+    slices","+}","+","+fn assert_slices(bitmap: &Bitmap) {","+    let iter = SlicesIterator::new(bitmap);","+    assert_eq!(iter.slots(), bitmap.len() - bitmap.null_count());","+    assert_eq!(iter.collect::<Vec<_>>(), naive_slices(bitmap));","+}","+","+/// Set bits around the byte and 64-bit word boundaries that the whole-byte and","+/// whole-word skipping of zeros and ones steps over.","+fn boundary_positions(len: usize) -> Vec<usize> {","+    let mut positions = Vec::new();","+    for boundary in [","+        0usize, 7, 8, 63, 64, 65, 127, 128, 191, 192, 200, 511, 512, 513,","+    ] {","+        for p in [boundary.wrapping_sub(1), boundary, boundary + 1] {","+            if p < len {","+                positions.push(p);","+            }","+        }","+    }","+    positions.extend([len / 2, len - 2, len - 1].into_iter().filter(|p| *p < len));","+    positions.sort_unstable();","+    positions.dedup();","+    positions","+}","+","+#[test]","+fn sparse_runs_skip_whole_words() {","+    // A few set rows in a block of 400k, as a TopN row selection.","+    let len = 400_000;","+    let mut set = boundary_positions(len);","+    set.extend([70_001, 70_002, 70_003, 131_072, 262_143, 262_144, 399_000]);","+    let bitmap = (0..len).map(|i| set.contains(&i)).collect::<Bitmap>();","+    assert_slices(&bitmap);","+    assert_eq!(","+        SlicesIterator::new(&bitmap).count(),","+        naive_slices(&bitmap).len()","+    );","+}","+","+#[test]","+fn dense_runs_skip_whole_words() {","+    let len = 400_000;","+    let unset = boundary_positions(len);","+    let bitmap = (0..len).map(|i| !unset.contains(&i)).collect::<Bitmap>();","+    assert_slices(&bitmap);","+}","+","+#[test]","+fn uniform_bitmaps_of_every_length_near_word_boundaries() {","+    for len in (1..=16).chain(56..=72).chain(120..=136).chain(504..=520) {","+        assert_slices(&Bitmap::new_zeroed(len));","+        assert_slices(&Bitmap::new_trued(len));","+    }","+}","+","+#[test]","+fn sliced_bitmaps_reach_byte_alignment_inside_words() {","+    let len = 1024 + 37;","+    let set = boundary_positions(len);","+    let full = (0..len).map(|i| set.contains(&i)).collect::<Bitmap>();","+    let dense = (0..len).map(|i| !set.contains(&i)).collect::<Bitmap>();","+    for offset in [0, 1, 3, 7, 8, 9, 15, 16, 61, 64, 67, 130] {","+        for sub_len in [1, 5, 8, 63, 64, 65, 200, len - offset] {","+            if offset + sub_len <= len {","+                assert_slices(&full.clone().sliced(offset, sub_len));","+                assert_slices(&dense.clone().sliced(offset, sub_len));","+            }","+        }","+    }","+}","+","+proptest! {","+    /// The slices are the runs of set bits, for bitmaps long enough to be skipped by whole","+    /// words, at any offset.","+    #[test]","+    #[cfg_attr(miri, ignore)]","+    fn slices_are_the_runs_of_set_bits(","+        (bits, offset, len) in prop::collection::vec(prop::bool::weighted(0.02), 1..3000)","+            .prop_flat_map(|bits| {","+                let n = bits.len();","+                (Just(bits), 0..n)","+            })","+            .prop_flat_map(|(bits, offset)| {","+                let n = bits.len();","+                (Just(bits), Just(offset), 1..=n - offset)","+            })","+    ) {","+        let bitmap = Bitmap::from(&bits).sliced(offset, len);","+        assert_slices(&bitmap);","+        let bitmap = bits.iter().map(|b| !b).collect::<Bitmap>().sliced(offset, len);","+        assert_slices(&bitmap);","+    }","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"src/query/storages/fuse/src/operations/read/mod.rs","lines":["@@ -36,3 +36,4 @@ pub use read_state::BlockScanStats;"," pub use read_state::ReadState;"," pub use read_state::ReadStateOutput;"," pub use util::need_reserve_block_info;","+pub use util::selected_row_offsets;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/query/storages/fuse/src/operations/read/parquet_data_source_deserializer.rs","lines":["@@ -38,12 +38,12 @@ use databend_common_pipeline::core::InputPort;"," use databend_common_pipeline::core::OutputPort;"," use databend_common_pipeline::core::Processor;"," use databend_common_pipeline::core::Pro