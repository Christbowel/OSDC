his file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package meshwatcher","+","+import (","+\t\"time\"","+","+\t\"google.golang.org/protobuf/proto\"","+","+\tmeshconfig \"istio.io/api/mesh/v1alpha1\"","+\t\"istio.io/istio/pkg/kube/krt\"","+\t\"istio.io/istio/pkg/ptr\"","+\t\"istio.io/istio/pkg/slices\"","+\t\"istio.io/istio/pkg/util/protomarshal\"","+)","+","+// NewRestrictedCollection exposes only trust domain and service-scope configuration.","+// Wait for the remote source's initial events before synchronizing, or use the local","+// fallback after syncTimeout. A zero timeout waits indefinitely; a nil remote source","+// requires no wait. Remote updates continue to apply after the timeout.","+func NewRestrictedCollection(","+\tlocal krt.Singleton[MeshConfigResource],","+\tremote krt.Singleton[MeshConfigResource],","+\tsyncTimeout time.Duration,","+\topts krt.OptionsBuilder,","+) krt.Singleton[RestrictedMeshConfig] {","+\tvar remoteConfig krt.Collection[MeshConfigResource]","+\tif remote == nil {","+\t\tremoteConfig = krt.NewDisabledCollection[MeshConfigResource](opts.WithName(\"OptionalRemoteMeshConfig\")...)","+\t} else {","+\t\tsnapshot := krt.NewStatic[MeshConfigResource](nil, false, opts.WithName(\"OptionalRemoteMeshConfig\")...)","+\t\tremoteConfig = snapshot.AsCollection()","+\t\treg := remote.AsCollection().RegisterBatch(func(events []krt.Event[MeshConfigResource]) {","+\t\t\tsnapshot.Set(remote.Get())","+\t\t}, true)","+\t\tvar timer *time.Timer","+\t\tif syncTimeout > 0 {","+\t\t\ttimer = time.AfterFunc(syncTimeout, snapshot.MarkSynced)","+\t\t}","+\t\tgo func() {","+\t\t\t// Waiting for the registration also ensures the initial remote value","+\t\t\t// has reached the snapshot before downstream collections can sync.","+\t\t\tif reg.WaitUntilSynced(opts.Stop()) {","+\t\t\t\tsnapshot.MarkSynced()","+\t\t\t}","+\t\t\tif timer != nil {","+\t\t\t\ttimer.Stop()","+\t\t\t}","+\t\t\t<-opts.Stop()","+\t\t\treg.UnregisterHandler()","+\t\t}()","+\t}","+","+\treturn krt.NewSingleton(func(ctx krt.HandlerContext) *RestrictedMeshConfig {","+\t\tfallbackConfig := ptr.OrEmpty(krt.FetchOne(ctx, local.AsCollection())).MeshConfig","+\t\tprimaryConfig := ptr.OrEmpty(krt.FetchOne(ctx, remoteConfig)).MeshConfig","+\t\tselected := primaryConfig","+\t\tif selected == nil {","+\t\t\tselected = fallbackConfig","+\t\t}","+\t\ttrustDomain := selected.GetTrustDomain()","+\t\tif trustDomain == \"\" {","+\t\t\ttrustDomain = fallbackConfig.GetTrustDomain()","+\t\t}","+\t\treturn &RestrictedMeshConfig{","+\t\t\tTrustDomain:         trustDomain,","+\t\t\tServiceScopeConfigs: slices.Map(selected.GetServiceScopeConfigs(), protomarshal.Clone),","+\t\t}","+\t}, opts.WithName(\"RestrictedMeshConfig\")...)","+}","+","+// RestrictedMeshConfig is the per-cluster configuration consumers are allowed to read.","+// Keeping a separate type prevents access to unrelated remote mesh settings.","+type RestrictedMeshConfig struct {","+\tTrustDomain         string","+\tServiceScopeConfigs []*meshconfig.MeshConfig_ServiceScopeConfigs","+}","+","+func (m RestrictedMeshConfig) ResourceName() string {","+\treturn \"RestrictedMeshConfig\"","+}","+","+func (m RestrictedMeshConfig) Equals(other RestrictedMeshConfig) bool {","+\treturn m.TrustDomain == other.TrustDomain &&","+\t\tslices.EqualFunc(m.ServiceScopeConfigs, other.ServiceScopeConfigs, func(a, b *meshconfig.MeshConfig_ServiceScopeConfigs) bool {","+\t\t\treturn proto.Equal(a, b)","+\t\t})","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"pkg/config/mesh/meshwatcher/restricted_test.go","lines":["@@ -0,0 +1,100 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package meshwatcher","+","+import (","+\t\"fmt\"","+\t\"testing\"","+\t\"time\"","+","+\tmeshconfig \"istio.io/api/mesh/v1alpha1\"","+\t\"istio.io/istio/pkg/kube/krt\"","+\t\"istio.io/istio/pkg/test\"","+\t\"istio.io/istio/pkg/test/util/assert\"","+)","+","+func TestRestrictedCollection(t *testing.T) {","+\tstop := test.NewStop(t)","+\tlocal := NewTestWatcher(&meshconfig.MeshConfig{TrustDomain: \"local\", RootNamespace: \"private\"})","+\tremote := krt.NewStatic[MeshConfigResource](nil, false)","+\trestricted := NewRestrictedCollection(local, remote, 20*time.Millisecond, krt.NewOptionsBuilder(stop, \"test\", nil))","+\tassert.EventuallyEqual(t, restricted.AsCollection().HasSynced, true)","+\tassert.EventuallyEqual(t, restricted.Get, &RestrictedMeshConfig{TrustDomain: \"local\"})","+\tlocal.Set(&meshconfig.MeshConfig{TrustDomain: \"updated-local\"})","+\tassert.EventuallyEqual(t, restricted.Get, &RestrictedMeshConfig{TrustDomain: \"updated-local\"})","+\tremote.Set(&MeshConfigResource{&meshconfig.MeshConfig{","+\t\tTrustDomain: \"remote\", RootNamespace: \"forbidden\",","+\t\tServiceScopeConfigs: []*meshconfig.MeshConfig_ServiceScopeConfigs{{}},","+\t}})","+\tremote.MarkSynced()","+\tassert.EventuallyEqual(t, restricted.Get, &RestrictedMeshConfig{","+\t\tTrustDomain:         \"remote\",","+\t\tServiceScopeConfigs: []*meshconfig.MeshConfig_ServiceScopeConfigs{{}},","+\t})","+\t// An empty remote trust domain falls back, while an explicitly empty service","+\t// scope remains remote-owned (matching the previous watcher contract).","+\tlocal.Set(&meshconfig.MeshConfig{TrustDomain: \"updated-local\", ServiceScopeConfigs: []*meshconfig.MeshConfig_ServiceScopeConfigs{{}}})","+\tremote.Set(&MeshConfigResource{&meshconfig.MeshConfig{}})","+\tassert.EventuallyEqual(t, restricted.Get, &RestrictedMeshConfig{TrustDomain: \"updated-local\"})","+\tremote.Set(nil)","+\tassert.EventuallyEqual(t, restricted.Get, &RestrictedMeshConfig{","+\t\tTrustDomain:         \"updated-local\",","+\t\tServiceScopeConfigs: []*meshconfig.MeshConfig_ServiceScopeConfigs{{}},","+\t})","+}","+","+func TestRestrictedCollectionInitialSync(t *testing.T) {","+\tfor _, timeout := range []time.Duration{0, time.Hour} {","+\t\tt.Run(timeout.String(), func(t *testing.T) {","+\t\t\tstop := test.NewStop(t)","+\t\t\tlocal := NewTestWatcher(&meshconfig.MeshConfig{TrustDomain: \"local\"})","+\t\t\tremote := krt.NewStatic[MeshConfigResource](nil, false)","+\t\t\trestricted := NewRestrictedCollection(local, remote, timeout, krt.NewOptionsBuilder(stop, \"test\", nil))","+\t\t\t// Allow the transformation to start; it must not sync with the fallback","+\t\t\t// while the remote source is pending and its deadline has not elapsed.","+\t\t\ttime.Sleep(20 * time.Millisecond)","+\t\t\tassert.Equal(t, restricted.AsCollection().HasSynced(), false)","+\t\t\tremote.Set(&MeshConfigResource{&meshconfig.MeshConfig{TrustDomain: \"remote\"}})","+\t\t\tremote.MarkSynced()","+\t\t\tassert.EventuallyEqual(t, restricted.AsCollection().HasSynced, true)","+\t\t\tassert.Equal(t, restricted.Get(), &RestrictedMeshConfig{TrustDomain: \"remote\"})","+\t\t})","+\t}","+}","+","+func TestRestrictedCollectionEmptySource(t *testing.T) {","+\tfor _, withRemote := range []bool{false, true} {","+\t\tt.Run(fmt.Sprint(withRemote), func(t *testing.T) {","+\t\t\tstop := test.NewStop(t)","+\t\t\tlocal := NewTestWatcher(&meshconfig.MeshConfig{TrustDomain: \"local\"})","+\t\t\tvar remote krt.Singleton[MeshConfigResource]","+\t\t\tif withRemote {","+\t\t\t\tremote = krt.NewStatic[MeshConfigResource](nil, true)","+\t\t\t}","+\t\t\trestricted := NewRestrictedCollection(local, remote, time.Hour, krt.NewOptionsBuilder(stop, \"test\", nil))","+\t\t\tassert.EventuallyEqual(t, restricted.AsCollection().HasSynced, true)","+\t\t\tassert.Equal(t, restricted.Get(), &RestrictedMeshConfig{TrustDomain: \"local\"})","+\t\t})","+\t}","+}","+","+func TestRestrictedCollectionStopBeforeSync(t *testing.T) {","+\tstop := make(chan struct{})","+\tlocal := NewTestWatcher(nil)","+\tremote := krt.NewStatic[MeshConfigResource](nil, false)","+\trestricted := NewRestrictedCollection(local, remote, time.Hour, krt.NewOptionsBuilder(stop, \"test\", nil))","+\tclose(stop)","+\tassert.Equal(t, restricted.AsCollection().HasSynced(), false)","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"pkg/config/mesh/meshwatcher/watcher_test_utils.go","lines":["@@ -20,8 +20,6 @@ import ("," \t\"istio.io/istio/pkg/kube/krt\""," )"," ","-var _ mesh.RestrictedConfigWatcher = &TestWatcher{}","-"," // TestWatcher provides an interface that takes a static MeshConfig which can be updated explicitly."," // It is intended for tests"," type TestWatcher struct {","@@ -33,14 +31,6 @@ func (w TestWatcher) Set(n *meshconfig.MeshConfig) {"," \tw.col.Set(&MeshConfigResource{n})"," }"," ","-func (w TestWatcher) TrustDomain() string {","-\treturn w.Mesh().GetTrustDomain()","-}","-","-func (w TestWatcher) ServiceScopeConfigs() []*meshconfig.MeshConfig_ServiceScopeConfigs {","-\treturn w.Mesh().GetServiceScopeConfigs()","-}","-"," // NewTestWatcher creates a new Watcher that always returns the given mesh config."," func NewTestWatcher(m *meshconfig.MeshConfig) TestWatcher {"," \tif m == nil {"],"additions":0,"deletions":10,"truncated":false},{"path":"pkg/