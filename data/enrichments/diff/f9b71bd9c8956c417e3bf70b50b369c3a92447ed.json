(*authn.TokenExchangeClient, error) {","+\tgRPCAuth := cfg.SectionWithEnvOverrides(\"grpc_client_authentication\")","+","+\ttoken := gRPCAuth.Key(\"token\").String()","+\tif token == \"\" {","+\t\treturn nil, fmt.Errorf(\"token is required in [grpc_client_authentication] section\")","+\t}","+\ttokenExchangeURL := gRPCAuth.Key(\"token_exchange_url\").String()","+\tif tokenExchangeURL == \"\" {","+\t\treturn nil, fmt.Errorf(\"token_exchange_url is required in [grpc_client_authentication] section\")","+\t}","+","+\tclient, err := authn.NewTokenExchangeClient(authn.TokenExchangeConfig{","+\t\tTokenExchangeURL: tokenExchangeURL,","+\t\tToken:            token,","+\t})","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to create token exchange client: %w\", err)","+\t}","+\treturn client, nil","+}","+","+// RESTConfig builds a client config for the apiserver at [operator]","+// serverURLKey, exchanging tokens for audience. Each API group can live on its","+// own apiserver, so each gets its own config.","+func RESTConfig(cfg *setting.Cfg, serverURLKey, audience string) (*rest.Config, error) {","+\tserverURL := cfg.SectionWithEnvOverrides(\"operator\").Key(serverURLKey).String()","+\tif serverURL == \"\" {","+\t\treturn nil, fmt.Errorf(\"%s is required in [operator] section\", serverURLKey)","+\t}","+\ttlsConfig, err := TLSConfig(cfg)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\ttokenExchangeClient, err := TokenExchangeClient(cfg)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn &rest.Config{","+\t\tAPIPath:         \"/apis\",","+\t\tHost:            serverURL,","+\t\tWrapTransport:   clientauth.NewStaticTokenExchangeTransportWrapper(tokenExchangeClient, audience, clientauth.WildcardNamespace),","+\t\tTLSClientConfig: tlsConfig,","+\t\tRateLimiter:     flowcontrol.NewFakeAlwaysRateLimiter(),","+\t}, nil","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"pkg/operators/runner/clients_test.go","lines":["@@ -0,0 +1,85 @@","+package runner","+","+import (","+\t\"crypto/rand\"","+\t\"crypto/rsa\"","+\t\"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"encoding/pem\"","+\t\"math/big\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func generateTestCAPEM(t *testing.T) []byte {","+\tt.Helper()","+","+\tkey, err := rsa.GenerateKey(rand.Reader, 2048)","+\trequire.NoError(t, err)","+","+\ttemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(1),","+\t\tSubject:               pkix.Name{CommonName: \"test-ca\"},","+\t\tNotBefore:             time.Now(),","+\t\tNotAfter:              time.Now().Add(time.Hour),","+\t\tIsCA:                  true,","+\t\tKeyUsage:              x509.KeyUsageCertSign,","+\t\tBasicConstraintsValid: true,","+\t}","+","+\tder, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)","+\trequire.NoError(t, err)","+","+\treturn pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: der})","+}","+","+func TestBuildTLSConfig(t *testing.T) {","+\tt.Run(\"no TLS options set\", func(t *testing.T) {","+\t\ttlsConfig, err := buildTLSConfig(false, \"\", \"\", \"\")","+\t\trequire.NoError(t, err)","+\t\trequire.False(t, tlsConfig.Insecure)","+\t\trequire.Empty(t, tlsConfig.CertFile)","+\t\trequire.Empty(t, tlsConfig.KeyFile)","+\t\trequire.Empty(t, tlsConfig.CAData)","+\t})","+","+\tt.Run(\"insecure flag is passed through\", func(t *testing.T) {","+\t\ttlsConfig, err := buildTLSConfig(true, \"\", \"\", \"\")","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, tlsConfig.Insecure)","+\t})","+","+\tt.Run(\"cert and key files are set\", func(t *testing.T) {","+\t\ttlsConfig, err := buildTLSConfig(false, \"/path/to/cert.pem\", \"/path/to/key.pem\", \"\")","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, \"/path/to/cert.pem\", tlsConfig.CertFile)","+\t\trequire.Equal(t, \"/path/to/key.pem\", tlsConfig.KeyFile)","+\t})","+","+\tt.Run(\"valid CA file is read and parsed\", func(t *testing.T) {","+\t\tcaPEM := generateTestCAPEM(t)","+\t\tcaFile := filepath.Join(t.TempDir(), \"ca.crt\")","+\t\trequire.NoError(t, os.WriteFile(caFile, caPEM, 0o600))","+","+\t\ttlsConfig, err := buildTLSConfig(false, \"\", \"\", caFile)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, caPEM, tlsConfig.CAData)","+\t})","+","+\tt.Run(\"missing CA file returns an error\", func(t *testing.T) {","+\t\t_, err := buildTLSConfig(false, \"\", \"\", filepath.Join(t.TempDir(), \"does-not-exist.crt\"))","+\t\trequire.ErrorContains(t, err, \"failed to read CA certificate file\")","+\t})","+","+\tt.Run(\"invalid PEM content returns an error\", func(t *testing.T) {","+\t\tcaFile := filepath.Join(t.TempDir(), \"ca.crt\")","+\t\trequire.NoError(t, os.WriteFile(caFile, []byte(\"not a valid PEM certificate\"), 0o600))","+","+\t\t_, err := buildTLSConfig(false, \"\", \"\", caFile)","+\t\trequire.ErrorContains(t, err, \"failed to parse CA certificate\")","+\t})","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"pkg/operators/runner/runner.go","lines":["@@ -0,0 +1,273 @@","+// Package runner owns the plumbing every standalone operator shares: logging,","+// the NATS subscriber, client configuration, service supervision, readiness","+// and shutdown. An operator only declares its controllers and services.","+package runner","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"log/slog\"","+\t\"os\"","+\t\"strings\"","+\t\"sync\"","+\t\"time\"","+","+\t\"github.com/grafana/dskit/services\"","+\t\"github.com/grafana/grafana-app-sdk/logging\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+","+\t\"github.com/grafana/grafana/pkg/infra/nats\"","+\t\"github.com/grafana/grafana/pkg/infra/tracing\"","+\t\"github.com/grafana/grafana/pkg/operators/supervision\"","+\t\"github.com/grafana/grafana/pkg/server\"","+\t\"github.com/grafana/grafana/pkg/setting\"","+)","+","+// Operator declares a standalone operator.","+type Operator struct {","+\tName        string","+\tDescription string","+\t// Logger names the operator's log lines; it defaults to Name.","+\tLogger string","+\t// NoNATS leaves Runtime.Subscriber nil for operators that consume no NATS","+\t// deltas, so they neither register its metrics nor dial NATS.","+\tNoNATS bool","+\t// Build wires the operator from its runtime. It runs before any service","+\t// starts, so it should only read configuration and construct things.","+\tBuild func(rt *Runtime) (*Parts, error)","+}","+","+// Parts is what an operator runs.","+type Parts struct {","+\t// Services start in order after the NATS subscriber and stop in reverse","+\t// order; any of them failing stops the operator.","+\tServices []services.Service","+\t// Run runs the controllers until ctx is done and calls ready once they","+\t// serve. ctx is also cancelled when a supervised service fails.","+\tRun func(ctx context.Context, ready func()) error","+\t// ShutdownTimeout bounds how long Run may take to return once ctx is","+\t// done, so a stuck controller cannot block the process from exiting.","+\t// Zero waits for Run.","+\tShutdownTimeout time.Duration","+}","+","+// Runtime carries what every operator gets from the runner.","+type Runtime struct {","+\tCfg        *setting.Cfg","+\tLogger     logging.Logger","+\tRegisterer prometheus.Registerer","+\tTracer     tracing.Tracer","+\t// Subscriber is the operator's NATS subscriber. The runner supervises it","+\t// when [nats] is enabled; use nats.Enabled to choose a delta source.","+\tSubscriber *nats.SubscriberService","+}","+","+// Register adds op to the operators the Grafana binary can run.","+func Register(op Operator) {","+\tserver.RegisterOperator(op.ServerOperator())","+}","+","+// ServerOperator adapts op to the server's operator registry.","+func (op Operator) ServerOperator() server.Operator {","+\treturn server.Operator{Name: op.Name, Description: op.Description, RunFunc: op.Run}","+}","+","+// Run runs op until ctx is done or one of its services fails.","+func (op Operator) Run(ctx context.Context, deps server.OperatorDependencies) (runErr error) {","+\tname := op.Logger","+\tif name == \"\" {","+\t\tname = op.Name","+\t}","+\trt := &Runtime{","+\t\tCfg:        deps.Config,","+\t\tLogger:     NewLogger(deps.Config, name),","+\t\tRegisterer: deps.Registerer,","+\t\tTracer:     deps.Tracer,","+\t}","+\tif !op.NoNATS {","+\t\trt.Subscriber = NewSubscriber(deps.Config, deps.Registerer)","+\t}","+\trt.Logger.Info(\"starting operator\", \"operator\", op.Name)","+","+\tparts, err := op.Build(rt)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"setup %s: %w\", op.Name, err)","+\t}","+","+\tsupervised := parts.Services","+\tif nats.Enabled(rt.Subscriber) {","+\t\tsupervised = append([]services.Service{rt.Subscriber}, supervised...)","+\t}","+\tctx, stop, err := supervision.Start(ctx, supervised...)","+\thealth := &readiness{ctx: ctx, notifier: deps.HealthNotifier}","+\tdefer func() {","+\t\thealth.stop()","+\t\trunErr = joinStopError(runErr, stop())","+\t}()","+\tif err != nil {","+\t\treturn err","+\t}","+","+\tdone := make(chan error, 1)","+\tgo func() {","+\t\tdone <- parts.Run(ctx, func() {","+\t\t\tif health.ready() {","+\t\t\t\trt.Logger.Info(\"operator is ready\", \"operator\", op.Name)","+\t\t\t}","+\t\t})","+\t}()","+","+\treturn dependencyCause(ctx, op.await(ctx, rt.Logger, health, parts, done))","+}","+","+func (op Operator) await(ctx context.Context, logger logging.Logger, health *readiness, parts *Parts, done <-chan error) error {","+\tselect {","+\tcase err := <-done:","+\t\treturn err","+\tcase <-ctx.Done():","+\t}","+\thealth.stop()","+\tlogger.Info(\"operator shutting down\", \"operator\", op.Name)","+\tif parts.ShutdownTimeout <= 0 {","+\t\treturn <-done","+\t}","+\tselect {","+\tcase err := <-done:","+\t\treturn err","+\tcase <-time.After(parts.ShutdownTimeout):","+\t\tlogger.Warn(\"shutdown timeout exceeded, forcing exit\", \"timeout\", parts.ShutdownTimeout)","+\t\treturn nil","+\t}","+}","+","+// joinStopError adds a failure to stop the services to Run's error. The","+// module server ignores errors matching context.Canceled, so when the result","+// also holds a real failure, the cancellation branches are dropped to keep","+// that failure visible.","+func joinStopError(runErr, stopErr error) error {","+\terr := runErr","+\tif stopErr != nil {","+\t\terr = errors.Join(runErr, stopErr)","+\t}","+\tif !errors.Is(err, context.Canceled) {","+\t\treturn err","+\t}","+\tif failures := withoutCancellation(err); failures != nil {","+\t\treturn failures","+\t}","+\treturn err","+}","+","+// withoutCancellation returns err without its context.Canceled branches, or","+// nil if nothing else is left.","+func withoutCancellation(err error) error {","+\tif !errors.Is(err, context.Canceled) {","+\t\treturn err","+\t}","+\tswitch e := err.(type) { //nolint:errorlint // walks this error's own unwrap tree one level at a time","+\tcase interface{ Unwrap() []error }:","+\t\tvar kept []error","+\t\tfor _, child := range e.Unwrap() {","+\t\t\tif child = withoutCancellation(child); child != nil {","+\t\t\t\tkept = append(kept, child)","+\t\t\t}","+\t\t}","+\t\treturn errors.Join(kept...)","+\tcase interface{ Unwrap() error }:","+\t\tif inner := e.Unwrap(); inner != nil {","+\t\t\tif stripped := withoutCancellation(inner); stripped != nil {","+\t\t\t\treturn &strippedError{msg: err.Error(), err: stripped}","+\t\t\t}"],"additions":181,"deletions":0,"truncated":false}],"additions":415,"deletions":269,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-26T18:56:04.707142+00:00"}