@@ -71,17 +73,53 @@ export interface MongoExecutionStack<TTargetId extends string = 'mongo'> {","   readonly extensions: readonly MongoRuntimeExtensionDescriptor<TTargetId>[];"," }"," ","-export function createMongoExecutionStack<TTargetId extends string = 'mongo'>(options: {","+/**","+ * The binding type is erased to `unknown` here, as in `SqlRuntimeDriverInstance`. A target client such as `mongo()` resolves the concrete binding before it calls `driver.connect(binding)`.","+ */","+export type MongoRuntimeDriverInstance<TTargetId extends string = 'mongo'> = RuntimeDriverInstance<","+  'mongo',","+  TTargetId","+> &","+  MongoDriver<unknown>;","+","+export type MongoExecutionStackWithDriver<TTargetId extends string = 'mongo'> =","+  MongoExecutionStack<TTargetId> & {","+    readonly driver: RuntimeDriverDescriptor<","+      'mongo',","+      TTargetId,","+      unknown,","+      MongoRuntimeDriverInstance<TTargetId>","+    >;","+  };","+","+interface MongoExecutionStackOptions<TTargetId extends string> {","   readonly target: MongoRuntimeTargetDescriptor<TTargetId>;","   readonly adapter: MongoRuntimeAdapterDescriptor<TTargetId>;","   readonly extensions?: readonly MongoRuntimeExtensionDescriptor<TTargetId>[] | undefined;","-}): MongoExecutionStack<TTargetId> {","-  const { target, adapter, extensions } = createExecutionStack({","+}","+","+export function createMongoExecutionStack<TTargetId extends string = 'mongo'>(","+  options: MongoExecutionStackOptions<TTargetId> & {","+    readonly driver: MongoExecutionStackWithDriver<TTargetId>['driver'];","+  },","+): MongoExecutionStackWithDriver<TTargetId>;","+export function createMongoExecutionStack<TTargetId extends string = 'mongo'>(","+  options: MongoExecutionStackOptions<TTargetId>,","+): MongoExecutionStack<TTargetId>;","+export function createMongoExecutionStack<TTargetId extends string = 'mongo'>(","+  options: MongoExecutionStackOptions<TTargetId> & {","+    readonly driver?: MongoExecutionStackWithDriver<TTargetId>['driver'];","+  },","+): MongoExecutionStack<TTargetId> | MongoExecutionStackWithDriver<TTargetId> {","+  const { target, adapter, driver, extensions } = createExecutionStack({","     target: options.target,","     adapter: options.adapter,","+    driver: options.driver,","     extensions: options.extensions,","   });","-  return { target, adapter, extensions };","+  return driver === undefined","+    ? { target, adapter, extensions }","+    : { target, adapter, driver, extensions };"," }"," "," export function createMongoExecutionContext<"],"additions":44,"deletions":6,"truncated":false},{"path":"packages/2-mongo-family/7-runtime/src/mongo-runtime.ts","lines":["@@ -21,6 +21,7 @@ import type {"," } from '@internal/mongo-query-ast/execution';"," import { blindCast } from '@internal/utils/casts';"," import { ifDefined } from '@internal/utils/defined';","+import { type StructuredError, structuredError } from '@internal/utils/structured-error';"," import { decodeMongoRow } from './codecs/decoding';"," import { computeMongoContentHash } from './content-hash';"," import type { MongoExecutionPlan } from './mongo-execution-plan';","@@ -64,6 +65,13 @@ function invalidStatisticsResult(commandKind: string, countField: string): Error","   );"," }"," ","+function runtimeClosedError(): StructuredError {","+  return structuredError('DRIVER.NOT_CONNECTED', 'Runtime is closed', {","+    why: 'close() was called on this runtime, or on the client or connection that owns it. An await using scope calls close() when it ends.',","+    fix: 'Await every query before close(). The usual cause is a query returned without await from an await using scope.',","+  });","+}","+"," /**","  * Mongo runtime options.","  *","@@ -72,7 +80,7 @@ function invalidStatisticsResult(commandKind: string, countField: string): Error"," export interface MongoRuntimeOptions {","   readonly context: MongoExecutionContext;","   readonly adapter: MongoAdapter;","-  readonly driver: MongoDriver;","+  readonly driver: MongoDriver<unknown>;","   readonly middleware?: readonly MongoMiddleware[];","   readonly mode?: RuntimeMode;"," }","@@ -109,9 +117,10 @@ class MongoRuntimeImpl","   implements MongoRuntime"," {","   readonly #adapter: MongoAdapter;","-  readonly #driver: MongoDriver;","+  readonly #driver: MongoDriver<unknown>;","   readonly #codecs: MongoCodecLookup;","   readonly #contextFields: ActivityContextFields<MongoMiddlewareContext>;","+  #closed = false;"," ","   constructor(options: MongoRuntimeOptions) {","     const middleware = options.middleware ?? [];","@@ -161,6 +170,9 @@ class MongoRuntimeImpl","   /* v8 ignore stop */"," ","   protected override runDriver(exec: MongoExecutionPlan): AsyncIterable<Record<string, unknown>> {","+    if (this.#closed) {","+      throw runtimeClosedError();","+    }","     return this.#driver.execute<Record<string, unknown>>(exec.command);","   }"," ","@@ -267,6 +279,9 @@ class MongoRuntimeImpl","   }"," ","   async #readDriverStatistics(exec: MongoExecutionPlan): Promise<RuntimeStatementStats> {","+    if (this.#closed) {","+      throw runtimeClosedError();","+    }","     const countField = statisticsCountField(exec.command.kind);","     if (countField === undefined) {","       throw runtimeError(","@@ -294,6 +309,7 @@ class MongoRuntimeImpl","   }"," ","   override async close(): Promise<void> {","+    this.#closed = true;","     await this.#driver.close();","   }"," }"],"additions":18,"deletions":2,"truncated":false},{"path":"packages/2-mongo-family/7-runtime/test/execution-stack.test.ts","lines":["@@ -0,0 +1,92 @@","+import type { RuntimeDriverDescriptor } from '@internal/framework-components/execution';","+import { newMongoCodecRegistry } from '@internal/mongo-codec';","+import { describe, expect, it, vi } from 'vitest';","+import {","+  createMongoExecutionStack,","+  type MongoRuntimeAdapterDescriptor,","+  type MongoRuntimeDriverInstance,","+  type MongoRuntimeTargetDescriptor,","+} from '../src/mongo-execution-stack';","+","+function target(sessionSettings?: Record<string, string>): MongoRuntimeTargetDescriptor<'mongo'> {","+  return {","+    kind: 'target',","+    id: 'test-target',","+    familyId: 'mongo',","+    targetId: 'mongo',","+    version: '0.0.1',","+    codecs: newMongoCodecRegistry,","+    create: () => ({ familyId: 'mongo', targetId: 'mongo' }),","+    ...(sessionSettings === undefined ? {} : { sessionSettings }),","+  };","+}","+","+const adapter: MongoRuntimeAdapterDescriptor<'mongo'> = {","+  kind: 'adapter',","+  id: 'test-adapter',","+  familyId: 'mongo',","+  targetId: 'mongo',","+  version: '0.0.1',","+  codecs: newMongoCodecRegistry,","+  create: () => {","+    throw new Error('the stack never instantiates the adapter');","+  },","+};","+","+function driverDescriptor() {","+  const instance: MongoRuntimeDriverInstance<'mongo'> = {","+    familyId: 'mongo',","+    targetId: 'mongo',","+    connect: async () => undefined,","+    execute: () => ({","+      [Symbol.asyncIterator]: () => ({ next: async () => ({ done: true, value: undefined }) }),","+    }),","+    run: async () => undefined,","+    close: async () => undefined,","+  };","+  const create = vi.fn(() => instance);","+  const descriptor: RuntimeDriverDescriptor<","+    'mongo',","+    'mongo',","+    unknown,","+    MongoRuntimeDriverInstance<'mongo'>","+  > = {","+    kind: 'driver',","+    id: 'test-driver',","+    familyId: 'mongo',","+    targetId: 'mongo',","+    version: '0.0.1',","+    create,","+  };","+  return { descriptor, create, instance };","+}","+","+describe('createMongoExecutionStack', () => {","+  it('creates the driver with the session settings the target declares', () => {","+    const { descriptor, create, instance } = driverDescriptor();","+    const stack = createMongoExecutionStack({","+      target: target({ TimeZone: 'UTC' }),","+      adapter,","+      driver: descriptor,","+    });","+","+    expect(stack.driver.create()).toBe(instance);","+    expect(create).toHaveBeenC