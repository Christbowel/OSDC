.driver.create();","+    await driver.connect({ kind: 'url', url: replSet.getUri(), dbName });","     runtime = createMongoRuntime({ context, adapter: stack.adapter.create(stack), driver });","   }, timeouts.spinUpMongoMemoryServer);"," "],"additions":4,"deletions":2,"truncated":false},{"path":"packages/2-mongo-family/6-transport/mongo-lowering/README.md","lines":["@@ -5,4 +5,4 @@ Adapter and driver interface contracts for the MongoDB transport layer."," ## Responsibilities"," "," - **Adapter interface**: `MongoAdapter` — defines `lower(plan: MongoQueryPlan): Promise<AnyMongoWireCommand>` (one-shot `resolveParams(structuralLower(plan))`), plus the two-phase split `structuralLower` / `resolveParams` used by `@internal/mongo-runtime` so `beforeEncode` middleware can mutate `MongoParamRef` leaves before codec resolution. Those phase methods are public on this SPI (unlike SQL's private `lowerToDraft` / `encodeDraftParams` on the SQL runtime) because lowering is target-owned through the adapter on the execution stack. Rationale and SQL contrast: [ADR 215 — Mongo family: lifecycle parity and intentional placement asymmetries](../../../../docs/architecture%20docs/adrs/ADR%20215%20-%20Runtime%20middleware%20lifecycle%20beforeExecute%20before%20encodeParams.md#mongo-family-lifecycle-parity-and-intentional-placement-asymmetries).","-- **Driver interface**: `MongoDriver` — defines `execute<Row>(wireCommand): AsyncIterable<Row>` and `close()`, the contract for sending wire commands to a MongoDB instance","+- **Driver interfaces**: `MongoQueryable` defines `execute<Row>(wireCommand): AsyncIterable<Row>` and `run(wireCommand)`, as `SqlQueryable` does for SQL. `MongoDriver<TBinding>` extends it with `connect(binding)` and `close()`, as `SqlDriver<TBinding>` does. `MongoControlDriverInstance` extends `MongoQueryable` and the framework's control driver instance, not `MongoDriver`, so a control driver has no `connect`. Code that only sends commands takes `MongoQueryable`, the contract for sending wire commands to a MongoDB instance"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/2-mongo-family/6-transport/mongo-lowering/src/driver-types.ts","lines":["@@ -2,14 +2,18 @@ import type { ControlDriverInstance } from '@internal/framework-components/contr"," import type { AnyMongoDdlWireCommand, AnyMongoDmlWireCommand } from '@internal/mongo-wire';"," import type { Db } from 'mongodb';"," ","-export interface MongoDriver {","+export interface MongoQueryable {","   execute<Row>(wireCommand: AnyMongoDmlWireCommand): AsyncIterable<Row>;","   run(wireCommand: AnyMongoDdlWireCommand): Promise<void>;","+}","+","+export interface MongoDriver<TBinding = void> extends MongoQueryable {","+  connect(binding: TBinding): Promise<void>;","   close(): Promise<void>;"," }"," "," export interface MongoControlDriverInstance","   extends ControlDriverInstance<'mongo', 'mongo'>,","-    MongoDriver {","+    MongoQueryable {","   readonly db: Db;"," }"],"additions":6,"deletions":2,"truncated":false},{"path":"packages/2-mongo-family/6-transport/mongo-lowering/src/exports/index.ts","lines":["@@ -1,2 +1,2 @@"," export type { MongoAdapter, MongoDdlPlan, MongoLoweredDraft } from '../adapter-types';","-export type { MongoControlDriverInstance, MongoDriver } from '../driver-types';","+export type { MongoControlDriverInstance, MongoDriver, MongoQueryable } from '../driver-types';"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/2-mongo-family/7-runtime/README.md","lines":["@@ -22,7 +22,7 @@ Example:"," "," ```ts"," import mongoRuntimeAdapter from '@internal/adapter-mongo/runtime';","-import { createMongoDriver } from '@internal/driver-mongo';","+import mongoRuntimeDriver from '@internal/driver-mongo/runtime';"," import {","   createMongoExecutionContext,","   createMongoExecutionStack,","@@ -33,13 +33,17 @@ import mongoRuntimeTarget from '@internal/target-mongo/runtime';"," const stack = createMongoExecutionStack({","   target: mongoRuntimeTarget,","   adapter: mongoRuntimeAdapter,","+  driver: mongoRuntimeDriver,"," });"," const context = createMongoExecutionContext({ contract, stack });"," ","+const driver = stack.driver.create();","+await driver.connect({ kind: 'url', url, dbName });","+"," const runtime = createMongoRuntime({","   context,","   adapter: stack.adapter.create(stack),","-  driver: await createMongoDriver(url, dbName),","+  driver,"," });"," ```"," ","@@ -47,12 +51,12 @@ Custom or third-party codecs (encryption, vendor scalars) are contributed via an"," "," ## Responsibilities"," ","-- **Stack/context composition**: `createMongoExecutionStack` and `createMongoExecutionContext` mirror SQL's `createSqlExecutionStack` / `createExecutionContext`. The context aggregates codec contributions from `[stack.target, stack.adapter, ...stack.extensions]` into a single `MongoCodecRegistry`. The `MongoExecutionContext` type is declared in `@internal/mongo-query-ast`, as SQL's `ExecutionContext` is declared in relational-core, and holds no stack: the query lanes build against it, and the runtime receives the adapter as its own option.","+- **Stack/context composition**: `createMongoExecutionStack` and `createMongoExecutionContext` mirror SQL's `createSqlExecutionStack` / `createExecutionContext`. Given a driver descriptor, `createMongoExecutionStack` returns a `MongoExecutionStackWithDriver`, whose `driver.create()` passes the target's session settings to the descriptor, as `SqlExecutionStackWithDriver` does. Without one it returns a `MongoExecutionStack`, which `mongoStatic` uses so that it never loads `mongodb`. The context aggregates codec contributions from `[stack.target, stack.adapter, ...stack.extensions]` into a single `MongoCodecRegistry`. The `MongoExecutionContext` type is declared in `@internal/mongo-query-ast`, as SQL's `ExecutionContext` is declared in relational-core, and holds no stack: the query lanes build against it, and the runtime receives the adapter as its own option."," - **Runtime executor**: `createMongoRuntime({ context, adapter, driver, ... })` composes context, adapter and driver into a `MongoRuntime`, as the SQL runtime does. The caller creates the adapter with `stack.adapter.create(stack)`, and the runtime checks middleware against the target named by `context.contract.target`. The runtime has separate `query(plan)` and `execute(plan)` operations accepting `MongoQueryPlan<Row>` from `@internal/mongo-query-ast`. `query()` yields decoded rows, while `execute()` returns statement statistics. Both operations lower the plan with the adapter, and run the wire command on the driver; `query()` **optionally decodes** each row when `plan.resultShape` is present."," - **Operation flow**: Row-producing work uses `query(plan)` and the query middleware lifecycle; statistics-producing work uses `execute(plan)` and the execute middleware lifecycle. Each operation allocates its own `CodecCallContext` and threads it through its codec dispatches."," - **Lowering**: Happens in the adapter (`lower(plan)`), wrapped by the runtime's `lower` override into a `MongoExecutionPlan`."," - **Middleware lifecycle inheritance**: `MongoRuntime` extends `RuntimeCore<MongoQueryPlan, MongoExecutionPlan, MongoMiddleware>` and runs every `query()` and `execute()` as a statement activity: `activityStarted`, `beforeEncode` (before `resolveParams`), `intercept.onQuery` / `intercept.onExecute`, `onRow`, `activityEnded`, then `activityFinalized` right away, because Mongo has no transactions. Mongo does **not** override `runBeforeCompile` (Mongo middleware has no `beforeCompile` hook today).","-- **Lifecycle management**: Connection lifecycle via `close()`.","+- **Lifecycle management**: `close()` closes the driver. After it, `query()` and `execute()` reject with `DRIVER.NOT_CONNECTED` \"Runtime is closed\", the error the SQL runtime gives."," "," ## Architecture"," "],"additions":8,"deletions":4,"truncated":false},{"path":"packages/2-mongo-family/7-runtime/src/exports/index.ts"