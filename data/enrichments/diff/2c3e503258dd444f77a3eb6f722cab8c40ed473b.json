t::init_logger();"," ","             // Sequential instances.","             for _ in 0..3 {"],"additions":1,"deletions":1,"truncated":false},{"path":"xtask/src/test.rs","lines":["@@ -87,6 +87,13 @@ pub fn run_tests(","         &[\"nextest\", \"run\"]","     };"," ","+    // Test concurrency, and therefore how much contention the tests see, follows","+    // the CPU count. See <https://github.com/gfx-rs/wgpu/issues/9248>.","+    match std::thread::available_parallelism() {","+        Ok(n) => log::info!(\"Host reports {n} logical CPUs\"),","+        Err(e) => log::info!(\"Could not determine the host CPU count: {e}\"),","+    }","+","     log::info!(\"Generating .gpuconfig file based on gpus on the system\");"," ","     // We use a test to generate the .gpuconfig file instead of using the cli directly",""],"additions":7,"deletions":0,"truncated":false}],"additions":122,"deletions":7,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-09-28T17:12:29.934995+00:00"}