ver = await serve((await _createConfig(options))[0]);","+      }, 10000);","+      afterAll(() => devServer.close());","+","+      it.each([","+        ['a foreign origin', 'https://evil.example', null],","+        [","+          'a host that only starts with localhost',","+          'http://localhost.evil.example',","+          null,","+        ],","+        ['localhost', 'http://localhost:4000', 'http://localhost:4000'],","+        [","+          'a localhost subdomain',","+          'https://app.localhost',","+          'https://app.localhost',","+        ],","+        ['127.0.0.1', 'http://127.0.0.1:8080', 'http://127.0.0.1:8080'],","+        ['[::1]', 'http://[::1]:3000', 'http://[::1]:3000'],","+      ])('answers a request from %s', async (_, origin, allowed) => {","+        const { headers } = await devServer.send('GET', '/main.js', {","+          origin,","+        });","+","+        expect(headers.get(ALLOW_ORIGIN)).toBe(allowed);","+        expect(headers.get('vary')).toBe('Origin');","+      });","+","+      it('answers a preflight request from localhost and lets the proxy forward it', async () => {","+        const preflight = {","+          origin: 'http://localhost:4000',","+          'access-control-request-method': 'PUT',","+          'access-control-request-headers': 'content-type,x-token',","+        };","+","+        const asset = await devServer.send('OPTIONS', '/main.js', preflight);","+        expect(asset.status).toBe(204);","+        expect(Object.fromEntries(asset.headers)).toMatchObject({","+          [ALLOW_ORIGIN]: 'http://localhost:4000',","+          'access-control-allow-methods': 'GET,HEAD,PUT,PATCH,POST,DELETE',","+          'access-control-allow-headers': 'content-type,x-token',","+          vary: 'Origin, Access-Control-Request-Headers',","+        });","+","+        const proxied = await devServer.send('OPTIONS', '/api/data', preflight);","+        expect(await proxied.text()).toBe('proxied');","+        expect(proxied.headers.get(ALLOW_ORIGIN)).toBe('http://localhost:4000');","+","+        const foreign = await devServer.send('OPTIONS', '/main.js', {","+          ...preflight,","+          origin: 'https://evil.example',","+        });","+        expect(foreign.headers.get(ALLOW_ORIGIN)).toBeNull();","+      });","+    });","+","+    const setCustomOrigin: Handler = (_, res, next) => {","+      res.setHeader('Access-Control-Allow-Origin', 'https://custom.example');","+      next();","+    };","+    it.each<[string, Parameters<typeof createConfig>[0]]>([","+      [","+        'devServer.headers',","+        {","+          options: {","+            ...options,","+            devServer: {","+              headers: {","+                'Access-Control-Allow-Origin': 'https://custom.example',","+              },","+            },","+          },","+        },","+      ],","+      [","+        'rspackConfigOverrides.devServer.headers',","+        {","+          options,","+          rspackConfigOverrides: {","+            devServer: {","+              headers: {","+                'access-control-allow-origin': 'https://custom.example',","+              },","+            },","+          },","+        },","+      ],","+      [","+        'a middleware that setupMiddlewares puts first',","+        {","+          options,","+          rspackConfigOverrides: {","+            devServer: {","+              setupMiddlewares: (middlewares) => [","+                setCustomOrigin,","+                ...middlewares,","+              ],","+            },","+          },","+        },","+      ],","+    ])(","+      'keeps the allowed origin that %s sets',","+      async (_, config) => {","+        const devServer = await serve((await createConfig(config))[0]);","+        try {","+          const { headers } = await devServer.send('GET', '/main.js', {","+            origin: 'http://localhost:4000',","+          });","+","+          expect(headers.get(ALLOW_ORIGIN)).toBe('https://custom.example');","+        } finally {","+          await devServer.close();","+        }","+      },","+      10000","+    );","+  });"," });"],"additions":223,"deletions":2,"truncated":false},{"path":"packages/angular-rspack/src/lib/plugins/ng-rspack.ts","lines":["@@ -11,6 +11,7 @@ import type {","   I18nOptions,","   NormalizedAngularRspackPluginOptions,"," } from '../models';","+import { applyDevServerCors } from '../utils/dev-server-cors';"," import {","   applyDevServerReadySignal,","   ssrServerEmitsReadySignal,","@@ -88,6 +89,8 @@ export class NgRspackPlugin implements RspackPluginInstance {","     const isDevServer = isServeMode();","     const ssrReloadServer = this.ssrReloadServer;"," ","+    applyDevServerCors(compiler);","+","     if (","       !isDevServer ||","       !this.pluginOptions.hasServer ||"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/angular-rspack/src/lib/utils/dev-server-cors.ts","lines":["@@ -0,0 +1,75 @@","+import type { Compiler } from '@rspack/core';","+import type { IncomingMessage, ServerResponse } from 'node:http';","+","+// Vite's default `server.cors` origins, used by `ng serve` from Angular 22:","+// http(s) on localhost, its subdomains, 127.0.0.1 and [::1], with any port","+const LOCALHOST_ORIGIN =","+  /^https?:\\/\\/(?:(?:[^:]+\\.)?localhost|127\\.0\\.0\\.1|\\[::1\\])(?::\\d+)?$/;","+","+/**","+ * Lets pages on localhost origins read dev server responses, as `ng serve`","+ * does from Angular 22. Runs before the dev server's middlewares, so `headers`,","+ * proxied responses and later middlewares win, and passes preflights on to the","+ * proxy.","+ * Applied after the config merge: webpack-merge would join a config","+ * `setupMiddlewares` with an override's into one that returns the list twice.","+ */","+export function applyDevServerCors(compiler: Compiler): void {","+  const devServer = compiler.options.devServer;","+  if (!devServer) {","+    return;","+  }","+  const setupMiddlewares = devServer.setupMiddlewares;","+  devServer.setupMiddlewares = (middlewares, server) => {","+    middlewares.unshift({","+      name: 'angular-cors',","+      middleware: allowLocalhostOrigins,","+    });","+    return setupMiddlewares","+      ? setupMiddlewares(middlewares, server)","+      : middlewares;","+  };","+}","+","+function allowLocalhostOrigins(","+  req: IncomingMessage,","+  res: ServerResponse,","+  next: () => void","+): void {","+  const origin = req.headers.origin;","+  if (origin && LOCALHOST_ORIGIN.test(origin)) {","+    setUnlessSet(res, 'Access-Control-Allow-Origin', origin);","+  }","+  addVary(res, 'Origin');","+  if (req.method === 'OPTIONS') {","+    setUnlessSet(","+      res,","+      'Access-Control-Allow-Methods',","+      'GET,HEAD,PUT,PATCH,POST,DELETE'","+    );","+    const requestHeaders = req.headers['access-control-request-headers'];","+    if (requestHeaders) {","+      setUnlessSet(res, 'Access-Control-Allow-Headers', requestHeaders);","+    }","+    addVary(res, 'Access-Control-Request-Headers');","+  }","+  next();","+}","+","+// A middleware the user's `setupMiddlewares` puts first keeps its value","+function setUnlessSet(res: ServerResponse, name: string, value: string): void {","+  if (!res.hasHeader(name)) {","+    res.setHeader(name, value);","+  }","+}","+","+function addVary(res: ServerResponse, field: string): void {","+  const vary = [res.getHeader('Vary') ?? []].flat().join(', ');","+  const fields = vary","+    .toLowerCase()","+    .split(',')","+    .map((name) => name.trim());","+  if (!fields.includes('*') && !fields.includes(field.toLowerCase())) {","+    res.setHeader('Vary', vary ? `${vary}, ${field}` : field);","+  }","+}",""],"additions":75,"deletions":0,"truncated":false}],"additions":307,"deletions":6,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-12T17:12:10.227907+00:00"}