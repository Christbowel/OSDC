me::SystemTime};"," "," use rspack_paths::{InternedPath, InternedPathDashSet};","-use rspack_util::time::{mtime_safe_time, system_time_to_millis};","+use rspack_util::time::system_time_to_millis;"," use tokio::sync::mpsc::UnboundedSender;"," "," use super::{EventBatch, FsEvent, FsEventKind, PathManager};","-use crate::paths::disk_mtime;","+use crate::{","+  paths::disk_mtime,","+  time::{mtime_accuracy, mtime_safe_time},","+};"," "," // Scanner will scann the path whether it is exist or not in disk on initialization"," pub struct Scanner {","@@ -166,13 +169,16 @@ fn send_events("," /// coarse mtime granularity is still caught. A failed stat (missing/unreadable)"," /// counts as unchanged."," fn changed_since(path: &InternedPath, start_time: SystemTime) -> bool {","-  let Ok(mtime) = path","-    .metadata()","-    .and_then(|m| m.modified().or_else(|_| m.created()))","-  else {","+  let Ok(metadata) = path.metadata() else {","     return false;","   };","-  mtime_safe_time(system_time_to_millis(mtime)) >= system_time_to_millis(start_time)","+  let Ok(mtime) = metadata.modified().or_else(|_| metadata.created()) else {","+    return false;","+  };","+  if !metadata.is_dir() {","+    mtime_accuracy(mtime);","+  }","+  mtime_safe_time(mtime) >= system_time_to_millis(start_time)"," }"," "," #[cfg(test)]"],"additions":13,"deletions":7,"truncated":false},{"path":"crates/rspack_watcher/src/time.rs","lines":["@@ -0,0 +1,51 @@","+use std::{","+  sync::atomic::{AtomicU64, Ordering},","+  time::{SystemTime, UNIX_EPOCH},","+};","+","+use rspack_util::time::current_time;","+","+static FS_ACCURACY: AtomicU64 = AtomicU64::new(2000);","+","+pub(crate) fn fs_accuracy() -> u64 {","+  FS_ACCURACY.load(Ordering::Relaxed)","+}","+","+/// Match Node's `Stats.mtime`: `new Date(Math.round(mtimeMs))`.","+pub(crate) fn mtime_to_millis(mtime: SystemTime) -> u64 {","+  mtime.duration_since(UNIX_EPOCH).map_or(0, |duration| {","+    (duration.as_secs() as f64 * 1000.0 + f64::from(duration.subsec_nanos()) / 1_000_000.0).round()","+      as u64","+  })","+}","+","+/// Watchpack's `ensureFsAccuracy`, shared by all native watchers independently","+/// of cache snapshots. Its `% 1` branch cannot match integer `Stats.mtime`.","+pub(crate) fn mtime_accuracy(mtime: SystemTime) -> u64 {","+  let mtime_ms = mtime_to_millis(mtime);","+  let mut accuracy = fs_accuracy();","+  loop {","+    let next = if accuracy > 10 && !mtime_ms.is_multiple_of(10) {","+      10","+    } else if accuracy > 100 && !mtime_ms.is_multiple_of(100) {","+      100","+    } else if accuracy > 1000 && !mtime_ms.is_multiple_of(1000) {","+      1000","+    } else {","+      accuracy","+    };","+    if next == accuracy {","+      return accuracy;","+    }","+    match FS_ACCURACY.compare_exchange_weak(accuracy, next, Ordering::Relaxed, Ordering::Relaxed) {","+      Ok(_) => return next,","+      Err(current) => accuracy = current,","+    }","+  }","+}","+","+pub(crate) fn mtime_safe_time(mtime: SystemTime) -> u64 {","+  current_time()","+    .min(mtime_to_millis(mtime))","+    .saturating_add(fs_accuracy())","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"crates/rspack_watcher/tests/fs_accuracy.rs","lines":["@@ -74,7 +74,7 @@ fn a_recorded_accuracy_narrows_with_the_filesystem_accuracy() {","     \"precondition: nothing narrowed the accuracy yet\"","   );"," ","-  // A new context's scan of a file on an odd millisecond narrows it to 1ms.","+  // A new context's scan of a file on an odd millisecond narrows it to 10ms.","   std::fs::create_dir_all(helper.join(\"ctx2\")).unwrap();","   helper.file(\"ctx2/fine\");","   set_modified(","@@ -92,6 +92,9 @@ fn a_recorded_accuracy_narrows_with_the_filesystem_accuracy() {","   );"," ","   let (safe_time, timestamp, accuracy) = accuracy_of(&helper, \"ctx/coarse\");","-  assert_eq!(accuracy, 1, \"the coarse record keeps a 2s accuracy\");","-  assert_eq!(safe_time, timestamp + 1);","+  assert_eq!(","+    accuracy, 10,","+    \"the coarse record must use the learned accuracy\"","+  );","+  assert_eq!(safe_time, timestamp + 10);"," }"],"additions":6,"deletions":3,"truncated":false},{"path":"crates/rspack_watcher/tests/watcher.rs","lines":["@@ -1520,7 +1520,9 @@ fn a_scan_updates_a_recorded_file_whose_mtime_moved_on() {"," ","   // The change event is dropped, so only a scan can see the new mtime.","   hide.store(true, Ordering::SeqCst);","-  let moved_on = std::time::SystemTime::now() - std::time::Duration::from_secs(1800);","+  let moved_on = std::time::UNIX_EPOCH","+    + std::time::Duration::from_millis(1_700_000_000_000)","+    + std::time::Duration::from_micros(500);","   set_modified(helper.join(\"ctx/sub/found\").as_std_path(), moved_on).unwrap();","   std::thread::sleep(std::time::Duration::from_millis(500));","   hide.store(false, Ordering::SeqCst);","@@ -1532,11 +1534,10 @@ fn a_scan_updates_a_recorded_file_whose_mtime_moved_on() {","   else {","     panic!(\"ctx/sub/found is not a file entry\");","   };","-  let moved_on_millis = moved_on","-    .duration_since(std::time::UNIX_EPOCH)","-    .unwrap()","-    .as_millis() as u64;","-  assert_eq!(timestamp, moved_on_millis, \"the scan kept the old mtime\");","+  assert_eq!(","+    timestamp, 1_700_000_000_001,","+    \"the scan must round like Stats.mtime\"","+  );"," }"," "," /// With `ctx` and `ctx/sub` both registered, a removed `ctx/sub` that is then"],"additions":7,"deletions":6,"truncated":false},{"path":"crates/rspack_watcher_testing/Cargo.toml","lines":["@@ -12,6 +12,7 @@ test    = false"," [dev-dependencies]"," notify         = { workspace = true }"," rspack_paths   = { workspace = true }","+rspack_util    = { workspace = true }"," rspack_watcher = { workspace = true, features = [\"testing\"] }"," tempfile       = { workspace = true }"," tokio          = { workspace = true, features = [\"rt\", \"macros\", \"time\"] }"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/rspack_watcher_testing/tests/fs_accuracy.rs","lines":["@@ -0,0 +1,190 @@","+use std::{","+  fs,","+  time::{Duration, SystemTime, UNIX_EPOCH},","+};","+","+use rspack_paths::InternedPath;","+use rspack_util::{","+  fx_hash::FxHashSet,","+  time::{fs_accuracy, mtime_accuracy},","+};","+use rspack_watcher::{","+  EventAggregateHandler, EventHandler, FsEventKind, FsWatcher, TimeInfoEntry,","+  testing::DirectoryAnalyzer,","+};","+","+struct Handler;","+impl EventAggregateHandler for Handler {","+  fn on_event_handle(&self, _: FxHashSet<String>, _: FxHashSet<String>) {}","+}","+impl EventHandler for Handler {}","+","+async fn watch_file(path: &InternedPath) -> FsWatcher {","+  let watcher = FsWatcher::new(Default::default(), Default::default());","+  watcher","+    .watch(","+      (vec![path.clone()].into_iter(), std::iter::empty()),","+      (std::iter::empty(), std::iter::empty()),","+      (std::iter::empty(), std::iter::empty()),","+      SystemTime::now(),","+      Box::new(Handler),","+      Box::new(Handler),","+    )","+    .await;","+  watcher","+}","+","+fn assert_accuracy(watcher: &FsWatcher, path: &InternedPath, expected: u64) -> u64 {","+  let (entries, _) = watcher.collect_time_info_entries();","+  let entry = entries","+    .iter()","+    .find(|(name, _)| name == &path.to_string_lossy())","+    .expect(\"file entry\");","+  match entry.1 {","+    TimeInfoEntry::Entry {","+      safe_time,","+      timestamp,","+      accuracy,","+    } => {","+      assert_eq!(accuracy, expected);","+      assert_eq!(safe_time, timestamp + expected);","+      timestamp","+    }","+    ref other => panic!(\"expected a file entry, got {other:?}\"),","+  }","+}","+","+// A separate test binary keeps both monotonic, process-wide states pristine.","+#[tokio::test]","+async fn watcher_accuracy_is_shared_between_instances_and_isolated_from_cache() {","+  let temp = tempfile::tempdir().expect(\"create fixture\");","+  let base = temp.path().canonicalize().expect(\"resolve fixture\");","+  let coarse = InternedPath::from(base.join(\"coarse\"));","+  fs::write(&coarse, \"coarse\").expect(\"create coarse file\");","+  let round = UNIX_EPOCH + Duration::from_millis(1_700_000_000_000);","+  fs::File::options()","+    .write(true)","+    .open(&coarse)","+    .expect(\"open coarse file\")","+    .set_modified(round)","+    .expect(\"set coarse mtime\");","+  let first = watch_file(&coarse).await;","+  assert_accuracy(&first, &coarse, 2000);","+","+  let context = InternedPath::from(base.join(\"context\"));","+  fs::create_dir(&context).expect(\"create context\");","+  fs::create_dir(base.join(\"context/empty\")).expect(\"create empty child directory\");","+  let context_watcher = FsWatcher::new(Default::default(), Default::default());","+  context_watcher","+    .watch(","+      (std::iter::empty(), std::iter::empty()),","+      (vec![context.clone()].into_iter(), std::iter::empty()),","+      (std::iter::empty(), std::iter::empty()),","+      round,","+      Box::new(Handler),","+      Box::new(Handler),","+    )","+    .await;","+  assert_accuracy(&first, &coarse, 2000);","+  context_watcher","+    .close()","+    .await","+    .expect(\"close context watcher\");","+  let mut analyzer = DirectoryAnalyzer::default();","+  analyzer","+    .update(","+      (vec![], vec![]),","+      (vec![context.clone()], vec![]),","+      (vec![], vec![]),","+    )","+    .await","+    .expect(\"register context\");","+  analyzer.scan(round);","+  let events = tokio::time::timeout(Duration::from_secs(5), analyzer.next_events())","+    .await","+    .expect(\"report changed directory\");","+  assert!(events.contains(&(context, FsEventKind::Change)));","+  assert_accuracy(&first, &coarse, 2000);","+","+  for (offset, expected, rounded_millis) in [","+    (Duration::from_micros(499), 2000, 0),","+    (Duration::from_millis(1000), 2000, 1000),","+    (Duration::from_millis(100), 1000, 100),","+    (Duration::from_millis(10), 100, 10),","+    (Duration::from_millis(1), 10, 1),","+    (Duration::from_micros(500), 10, 1),","+    (Duration::from_micros(999), 10, 1),","+    (Duration::from_micros(1500), 10, 2),","+    (Duration::ZERO, 10, 0),","+  ] {","+    let path = InternedPath::from(base.join(format!(\"fine-{}\", offset.as_nanos())));","+    fs::write(&path, \"fine\").expect(\"create fine file\");","+    let mtime = round + offset;","+    fs::File::options()","+      .write(true)","+      .open(&path)","+      .expect(\"open fine file\")","+      .set_modified(mtime)","+      .expect(\"set fine mtime\");","+    assert_eq!(","+      fs::metadata(&path)","+        .expect(\"stat fine file\")","+        .modified()","+        .expect(\"read mtime\"),","+      mtime","+    );","+    let watcher = watch_file(&path).await;","+    let timestamp = assert_accuracy(&watcher, &path, expected);","+    assert_eq!(timestamp, 1_700_000_000_000 + rounded_millis);","+    assert_accuracy(&first, &coarse, expected);","+    if expected == 1000 {","+      assert_eq!(","+        fs_accuracy(),","+        2000,","+        \"watcher must not narrow cache accuracy\"","+      );","+      assert_eq!(mtime_accuracy(1_700_000_000_001), 1);","+      assert_accuracy(&first, &coarse, 1000);","+    }","+    if offset == Duration::from_millis(1) {","+      let mut analyzer = DirectoryAnalyzer::default();","+      analyzer","+        .update(","+          (vec![path.clone()], vec![]),","+          (vec![], vec![]),","+          (vec![], vec![]),","+        )","+        .await","+        .expect(\"register scanned file\");","+      analyzer.scan(mtime + Duration::from_millis(5));","+      let events = tokio::time::timeout(Duration::from_secs(5), analyzer.next_events())","+        .await","+        .expect(\"scanner must use watcher accuracy despite cache accuracy of 1ms\");","+      assert!(events.contains(&(path.clone(), FsEventKind::Change)));","+      fs::File::options()","+        .write(true)","+        .open(&path)","+        .expect(\"open live file\")","+        .set_modified(round + Duration::from_micros(1500))","+        .expect(\"set live mtime\");","+      analyzer.on_native_event(","+        notify::Event::new(notify::EventKind::Modify(notify::event::ModifyKind::Data(","+          notify::event::DataChange::Any,","+        )))","+        .add_path(path.as_ref().to_path_buf()),","+      );","+      let events = tokio::time::timeout(Duration::from_secs(5), analyzer.next_events())","+        .await","+        .expect(\"report live change\");","+      assert!(events.contains(&(path.clone(), FsEventKind::Change)));","+      assert_accuracy(&first, &coarse, 10);","+      analyzer.scan(round + Duration::from_millis(5));","+      let events = tokio::time::timeout(Duration::from_secs(5), analyzer.next_events())","+        .await","+        .expect(\"sub-millisecond mtime must retain Watchpack's scan window\");","+      assert!(events.contains(&(path.clone(), FsEventKind::Change)));","+    }","+    watcher.close().await.expect(\"close watcher\");","+  }","+  first.close().await.expect(\"close first watcher\");","+}",""],"additions":190,"deletions":0,"truncated":false}],"additions":290,"deletions":38,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-09T17:51:02.667078+00:00"}