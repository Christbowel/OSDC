tFOREIGN KEY (c) REFERENCES p(id)","+NOT NULL\tt_c_not_null\t[c]\tNOT NULL","+PRIMARY KEY\tt_c_pkey\t[c]\tPRIMARY KEY(c)","+","+query III","+SELECT column_name, column_default, is_nullable FROM duckdb_columns() WHERE table_name = 't' ORDER BY column_index;","+----","+a\tNULL\tfalse","+b\t5\ttrue","+c\tNULL\tfalse","+","+statement ok","+INSERT INTO t (a, c) VALUES (1, 1);","+","+query III","+SELECT * FROM t;","+----","+1\t5\t1","+","+statement error","+INSERT INTO t VALUES (0, 6, 2);","+----","+Constraint Error: CHECK constraint failed","+","+statement error","+INSERT INTO t VALUES (NULL, 6, 2);","+----","+Constraint Error: NOT NULL constraint failed","+","+statement error","+INSERT INTO t VALUES (1, -1, 2);","+----","+Constraint Error: CHECK constraint failed","+","+statement error","+INSERT INTO t VALUES (1, 5, 2);","+----","+Constraint Error: Duplicate key \"b: 5\"","+","+statement error","+INSERT INTO t VALUES (1, 6, 3);","+----","+Constraint Error: Violates foreign key constraint","+","+statement error","+CREATE TABLE t_err(a INT CONSTRAINT c CONSTRAINT d CHECK (a > 0));","+----","+Parser Error: syntax error",""],"additions":76,"deletions":0,"truncated":false}],"additions":160,"deletions":15,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-13T15:29:17.617550+00:00"}