nos[segmentKey{segment, stream}] = &atomic.Int64{}","+\t\t}","+\t}","+","+\tstats := &Stats{","+\t\trecorder:      recorder,","+\t\tvalueEncoding: valueEncoding,","+\t\tencodeNanos:   encodeNanos,","+\t}","+\tstats.wireEncoding.Store(&wireEncoding)","+\treturn stats, defineHistograms(recorder)","+}","+","+// WireEncoding returns the payload format currently in use.","+func (s *Stats) WireEncoding() string {","+\tif s == nil {","+\t\treturn \"\"","+\t}","+\treturn *s.wireEncoding.Load()","+}","+","+// SetWireEncoding records that the run switched payload format, which happens","+// when a server rejects the typed format and the run downgrades to JSONL.","+func (s *Stats) SetWireEncoding(wireEncoding string) {","+\tif s == nil {","+\t\treturn","+\t}","+\ts.wireEncoding.Store(&wireEncoding)","+}","+","+// RecordSegment reports one execution of an encode segment and adds it to the","+// run's total for that segment.","+func (s *Stats) RecordSegment(","+\tctx context.Context,","+\tsegment string,","+\tstream string,","+\tduration time.Duration,","+) {","+\tif s == nil {","+\t\treturn","+\t}","+","+\tif total, ok := s.encodeNanos[segmentKey{segment, stream}]; ok {","+\t\ttotal.Add(int64(duration))","+\t}","+}","+","+// AddRow adds one history row to the run's totals.","+func (s *Stats) AddRow(cells int) {"],"additions":264,"deletions":0,"truncated":false}],"additions":439,"deletions":64,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-09-24T13:04:40.962446+00:00"}