entUploadIngest reads history items on the upload path.","+\tSegmentUploadIngest = \"upload_ingest\"","+","+\t// SegmentUploadRender produces the payload for one history row.","+\tSegmentUploadRender = \"upload_render\"","+","+\t// SegmentRequestMarshal marshals the request including the body.","+\tSegmentRequestMarshal = \"request_marshal\"","+","+\t// SegmentRequestCompress compresses the request body.","+\tSegmentRequestCompress = \"request_compress\"","+)","+","+// Streams are the filestream data streams. The values match the server's","+// stream tag, so client and server series can be compared directly.","+const (","+\tStreamHistory = \"history\"","+\tStreamSummary = \"summary\"","+\tStreamEvents  = \"events\"","+\tStreamLog     = \"log\"","+","+\t// StreamNone is for a segment that belongs to the request rather than","+\t// to one stream, such as marshaling or compressing the body. A request","+\t// carries several streams at once, so no single one owns that cost.","+\t//","+\t// An empty attribute is dropped, so these records carry no stream tag.","+\tStreamNone = \"\"","+)","+","+// Value encodings describe what was written for a history value.","+const (","+\tValueEncodingJSON      = \"json\"","+\tValueEncodingTyped     = \"typed\"","+\tValueEncodingJSONTyped = \"json_typed\"","+)","+","+// Wire encodings describe the upload payload format.","+const (","+\tWireEncodingJSONL   = \"jsonl\"","+\tWireEncodingProtoV1 = \"proto_v1\"","+)","+","+// Content encodings describe the request body encoding.","+const (","+\tContentEncodingRaw  = \"raw\"","+\tContentEncodingGzip = \"gzip\"","+)","+","+// Metric names. The convention is","+// <application>.<subsystem>.<entity>.<measurement>.","+const (","+\tMetricEncodeDuration    = \"wandb.filestream.encode.duration\"","+\tMetricEncodeDurationSum = \"wandb.filestream.encode.duration.sum\"","+\tMetricRunCount          = \"wandb.filestream.run.count\"","+\tMetricRequestSize       = \"wandb.filestream.request.size\"","+\tMe