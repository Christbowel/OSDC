{"id":"GHSA-42gh-23hr-vphw","axis":"advisories","repo":"py-pdf/pypdf","sha":"b891fef37000cd86baa6e9848a3387d080b3b03e","parsed":{"files":[{"path":"pypdf/_doc_common.py","lines":["@@ -44,7 +44,7 @@"," from ._configuration import get_configuration"," from ._encryption import Encryption"," from ._page import PageObject, _VirtualList","-from ._page_labels import index2label as page_index2page_label","+from ._page_labels import index2labels"," from ._utils import (","     _TraversalState,","     deprecate_no_replacement,","@@ -1295,7 +1295,7 @@ def page_labels(self) -> list[str]:","         This property is read-only. The labels are in the order that the pages","         appear in the document.","         \"\"\"","-        return [page_index2page_label(self, i) for i in range(len(self.pages))]","+        return index2labels(self, len(self.pages))"," ","     @property","     def page_layout(self) -> Optional[str]:"],"additions":2,"deletions":2,"truncated":false},{"path":"pypdf/_page_labels.py","lines":["@@ -65,6 +65,8 @@"," from .generic import (","     ArrayObject,","     DictionaryObject,","+    IndirectObject,","+    NameObject,","     NullObject,","     NumberObject,","     is_null_or_none,","@@ -280,6 +282,70 @@ def index2label(reader: PdfCommonDocProtocol, index: int) -> str:","     return str(index + 1)  # Fallback if neither /Nums nor /Kids is in the number_tree"," "," ","+def _get_single_pass_nums_length(nums: ArrayObject, page_count: int) -> Optional[int]:","+    \"\"\"","+    Get how much of a flat ``/Nums`` array labels the first ``page_count`` pages.","+","+    ``get_label_from_nums`` always reads the first pair, then stops at the first","+    key above the page index, so only the array up to the first key at or above","+    ``page_count`` after the first pair matters. Returns ``None`` unless that","+    part consists of pairs of increasing integer keys and direct values, which","+    is what lets ``index2labels`` read it once for all pages.","+    \"\"\"","+    nums_length = len(nums)","+    previous = None","+    for i in range(0, nums_length, 2):","+        key = nums[i]","+        if (","+            i + 1 >= nums_length","+            or not isinstance(key, NumberObject)","+            or isinstance(nums[i + 1], IndirectObject)","+            or (previous is not None and key <= previous)","+        ):","+            return None","+        if key >= page_count and i > 0:","+            return i + 2","+        previous = key","+    return nums_length or None","+","+","+def _index2labels_page_by_page(pdf: PdfCommonDocProtocol, page_count: int) -> list[str]:","+    return [index2label(pdf, index) for index in range(page_count)]","+","+","+def index2labels(pdf: PdfCommonDocProtocol, page_count: int) -> list[str]:","+    \"\"\"","+    Labels of the first ``page_count`` pages, as ``index2label`` would return them.","+","+    A flat ``/Nums`` array with integer keys in increasing order and direct","+    values is walked once for all pages instead of from the start for every","+    page. Any other number tree is resolved page by page.","+    \"\"\"","+    if page_count <= 0:","+        return []","+    root = cast(DictionaryObject, pdf.root_object)","+    if \"/PageLabels\" not in root:","+        return _index2labels_page_by_page(pdf, page_count)","+    number_tree = root[\"/PageLabels\"].get_object()","+    if not isinstance(number_tree, DictionaryObject) or \"/Nums\" not in number_tree:","+        return _index2labels_page_by_page(pdf, page_count)","+    nums = number_tree[\"/Nums\"]","+    if not isinstance(nums, ArrayObject):","+        return _index2labels_page_by_page(pdf, page_count)","+    nums_length = _get_single_pass_nums_length(nums, page_count)","+    if nums_length is None:","+        return _index2labels_page_by_page(pdf, page_count)","+","+    labels = []","+    position = 0","+    for index in range(page_count):","+        while position + 2 < nums_length and nums[position + 2] <= index:","+            position += 2","+        entry = DictionaryObject({NameObject(\"/Nums\"): ArrayObject(nums[position : position + 2])})","+        labels.append(get_label_from_nums(entry, index))","+    return labels","+","+"," def nums_insert(","     key: NumberObject,","     value: DictionaryObject,"],"additions":66,"deletions":0,"truncated":false},{"path":"tests/test_page_labels.py","lines":["@@ -7,6 +7,7 @@"," from pypdf._page_labels import (","     get_label_from_nums,","     index2label,","+    index2labels,","     number2lowercase_letter,","     number2lowercase_roman_numeral,","     number2uppercase_letter,","@@ -473,3 +474,84 @@ def test_get_label_from_nums__regular__limits(caplog):","     assert caplog.messages == [","         \"Ignoring malformed page label entry in /Nums (/St=15000, /P=''): Number is too large.\"","     ]","+","+","+def _build_label(*, style=None, prefix=None, start=None) -> DictionaryObject:","+    entry = DictionaryObject()","+    if style is not None:","+        entry[NameObject(\"/S\")] = NameObject(style)","+    if prefix is not None:","+        entry[NameObject(\"/P\")] = TextStringObject(prefix)","+    if start is not None:","+        entry[NameObject(\"/St\")] = NumberObject(start)","+    return entry","+","+","+@pytest.mark.parametrize(","+    \"nums\",","+    [","+        pytest.param(","+            [0, _build_label(style=\"/r\"), 4, _build_label(style=\"/D\"), 10, _build_label(style=\"/A\", prefix=\"App-\")],","+            id=\"roman-decimal-letters-with-prefix\",","+        ),","+        pytest.param([3, _build_label(style=\"/D\", start=7)], id=\"first-key-after-first-page-with-start\"),","+        pytest.param(","+            [0, _build_label(style=\"/D\"), 1, _build_label(style=\"/R\"), 2, _build_label(prefix=\"Cover\")],","+            id=\"prefix-without-style\",","+        ),","+        pytest.param([0, _build_label(style=\"/X\"), 5, _build_label(style=\"/D\")], id=\"unknown-style\"),","+        pytest.param([0, NullObject(), 6, _build_label(style=\"/a\")], id=\"value-not-a-dictionary\"),","+        pytest.param([8, _build_label(style=\"/D\"), 2, _build_label(style=\"/r\")], id=\"keys-not-sorted\"),","+        pytest.param([0, _build_label(style=\"/D\"), 5], id=\"last-key-without-value\"),","+        pytest.param([0, _build_label(style=\"/D\"), 0, _build_label(style=\"/r\")], id=\"duplicate-keys\"),","+        pytest.param([40, _build_label(style=\"/D\")], id=\"only-key-after-last-page\"),","+        pytest.param(","+            [40, _build_label(style=\"/D\"), 0, _build_label(style=\"/r\")],","+            id=\"first-key-after-last-page-then-smaller-key\",","+        ),","+        pytest.param(","+            [40, _build_label(style=\"/D\"), 50, _build_label(style=\"/r\")],","+            id=\"first-key-after-last-page-then-larger-key\",","+        ),","+        pytest.param(","+            [key for i in range(100) for key in (i * 3, _build_label(style=\"/D\", prefix=f\"P{i}-\"))],","+            id=\"more-ranges-than-pages\",","+        ),","+        pytest.param(","+            [0, _build_label(style=\"/D\"), 10, _build_label(style=\"/r\"), 50],","+            id=\"key-without-value-after-last-page\",","+        ),","+    ],","+)","+def test_index2labels_matches_index2label(nums, caplog):","+    reader = PdfReader(RESOURCE_ROOT / \"crazyones.pdf\")","+    reader.root_object[NameObject(\"/PageLabels\")] = DictionaryObject(","+        {NameObject(\"/Nums\"): ArrayObject(NumberObject(n) if isinstance(n, int) else n for n in nums)}","+    )","+","+    expected = [index2label(reader, index) for index in range(30)]","+    expected_messages = caplog.messages[:]","+    caplog.clear()","+","+    assert index2labels(reader, 30) == expected","+    assert caplog.messages == expected_messages","+","+","+def test_index2labels__no_pages():","+    reader = PdfReader(RESOURCE_ROOT / \"crazyones.pdf\")","+    reader.root_object[NameObject(\"/PageLabels\")] = NullObject()","+","+    assert index2labels(reader, 0) == []","+","+","+def test_index2labels__nums_not_an_array(caplog):","+    reader = PdfReader(RESOURCE_ROOT / \"crazyones.pdf\")","+    reader.root_object[NameObject(\"/PageLabels\")] = DictionaryObject(","+        {NameObject(\"/Nums\"): DictionaryObject({NameObject(\"/A\"): NumberObject(1)})}","+    )","+    expected = [index2label(reader, index) for index in range(3)]","+    expected_messages = caplog.messages[:]","+    caplog.clear()","+","+    assert index2labels(reader, 3) == expected","+    assert caplog.messages == expected_messages",""],"additions":82,"deletions":0,"truncated":false}],"additions":150,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-31T14:35:27.984718+00:00"}