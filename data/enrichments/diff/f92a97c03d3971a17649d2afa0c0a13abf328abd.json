{"id":"f92a97c03d3971a17649d2afa0c0a13abf328abd","axis":"silent","repo":"pnpm/pnpm","sha":"f92a97c03d3971a17649d2afa0c0a13abf328abd","parsed":{"files":[{"path":".changeset/cargo-build-std-dependencies.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` now downloads the Rust standard library's dependencies when Cargo configuration enables `build-std` [pnpm/pnpm#14944](https://github.com/pnpm/pnpm/issues/14944)."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/fix-cargo-git-workspaces.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` now accepts Rust git dependencies that omit a package version. pnpm also generates Cargo lockfiles for workspaces with git dependencies [pnpm/pnpm#14944](https://github.com/pnpm/pnpm/issues/14944)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cargo-resolver/src/lib.rs","lines":["@@ -3,7 +3,7 @@"," #![cfg_attr(dylint_lib = \"perfectionist\", feature(register_tool))]"," #![cfg_attr(dylint_lib = \"perfectionist\", register_tool(perfectionist))]"," ","-pub use metadata::resolve_inputs;","+pub use metadata::{git_dependency_sources, resolve_inputs};"," pub use registry::{","     CRATES_IO_SPARSE_INDEX, download_url, index_prefix, is_crates_io, latest_version,","     registry_source, sparse_source,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cargo-resolver/src/metadata.rs","lines":["@@ -9,6 +9,23 @@ pub(crate) fn parse_metadata(metadata: &str) -> Result<CargoMetadata> {","     serde_json::from_str(metadata).into_diagnostic().wrap_err(\"parse cargo metadata\")"," }"," ","+/// Git sources declared by the packages in a Cargo metadata document.","+/// The metadata need not contain a resolved dependency graph.","+pub fn git_dependency_sources(metadata: &str) -> Result<Vec<cargo_lock::SourceId>> {","+    parse_metadata(metadata)?.packages","+        .into_iter()","+        .flat_map(|package| package.depende