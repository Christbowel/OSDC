s.ServiceA>(KnownResourceNames.AspireDashboard, launchProfileName: null)","+            : builder.AddExecutable(KnownResourceNames.AspireDashboard, \"command\", \"\");","+        AddDashboardTunnelEndpoints(dashboard, includeGrpc: true, includeHttp: true);","+        var container = builder.AddContainer(\"consumer\", \"image\");","+        if (withExporter)","+        {","+            container.WithOtlpExporter();","+        }","+","+        switch (referenceKind)","+        {","+            case \"environment\":","+                container.WithEnvironment(\"DASHBOARD_UI\", dashboard.GetEndpoint(\"http\"));","+                break;","+            case \"arguments\":","+                container.WithArgs(dashboard.GetEndpoint(\"http\"));","+                break;","+            case \"expression\":","+                container.WithEnvironment(\"DASHBOARD_UI\", ReferenceExpression.Create($\"{dashboard.GetEndpoint(\"http\")}/path\"));","+                break;","+            case \"property\":","+                container.WithEnvironment(\"DASHBOARD_PORT\", dashboard.GetEndpoint(\"http\").Property(EndpointProperty.Port));","+                break;","+            case \"reference\":","+                container.WithReference(dashboard.GetEndpoint(\"http\"));","+                break;","+            case \"all-references\":","+                container.WithReference(dashboard);","+                break;","+            case \"excluded-reference\":","+                container.WithReference(dashboard.GetEndpoint(\"diagnostics\"));","+                break;","+            case \"host-url\":","+                container.WithEnvironment(\"DASHBOARD_UI\", new HostUrl(\"http://localhost:18888/path\"));","+                break;","+            default:","+                throw new InvalidOperationException($\"Unexpected reference kind '{referenceKind}'.\");","+        }","+","+        var kubernetesService = new TestKubernetesService();","+        using var app = builder.Build