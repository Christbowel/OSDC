ned(\"SERIALIZER_JSON\", sizeof(\"SERIALIZER_JSON\") - 1, 1);"," \tzend_declare_class_constant_ex(class_entry, const_SERIALIZER_JSON_name, &const_SERIALIZER_JSON_value, ZEND_ACC_PUBLIC, NULL);"," \tzend_string_release(const_SERIALIZER_JSON_name);","+#if defined(HAVE_REDIS_PHPSER)","+","+\tzval const_SERIALIZER_PHPSER_value;","+\tZVAL_LONG(&const_SERIALIZER_PHPSER_value, REDIS_SERIALIZER_PHPSER);","+\tzend_string *const_SERIALIZER_PHPSER_name = zend_string_init_interned(\"SERIALIZER_PHPSER\", sizeof(\"SERIALIZER_PHPSER\") - 1, 1);","+\tzend_declare_class_constant_ex(class_entry, const_SERIALIZER_PHPSER_name, &const_SERIALIZER_PHPSER_value, ZEND_ACC_PUBLIC, NULL);","+\tzend_string_release(const_SERIALIZER_PHPSER_name);","+#endif"," "," \tzval const_COMPRESSION_NONE_value;"," \tZVAL_LONG(&const_COMPRESSION_NONE_value, REDIS_COMPRESSION_NONE);"],"additions":9,"deletions":1,"truncated":false},{"path":"tests/RedisTest.php","lines":["@@ -36,6 +36,8 @@ protected function getSerializers() {","             $result['json'] = Redis::SERIALIZER_JSON;","         if (defined('Redis::SERIALIZER_MSGPACK'))","             $result['msgpack'] = Redis::SERIALIZER_MSGPACK;","+        if (defined('Redis::SERIALIZER_PHPSER'))","+            $result['phpser'] = Redis::SERIALIZER_PHPSER;"," ","         return $result;","     }","@@ -5548,6 +5550,70 @@ public function testSerializerJSON() {","         $this->redis->setOption(Redis::OPT_PREFIX, '');","     }"," ","+    public function testSerializerPhpser() {","+        if ( ! defined('Redis::SERIALIZER_PHPSER'))","+            $this->markTestSkipped('Redis::SERIALIZER_PHPSER is not defined');","+","+        $this->checkSerializer(Redis::SERIALIZER_PHPSER);","+","+        // with prefix","+        $this->redis->setOption(Redis::OPT_PREFIX, 'test:');","+        $this->checkSerializer(Redis::SERIALIZER_PHPSER);","+        $this->redis->setOption(Redis::OPT_PREFIX, '');","+","+        /* With phpser.key set, a value that fails verification or decoding","+           comes back as false and never as the raw bytes stored in Redis.","+           Without a key, phpser falls back to the raw bytes like igbinary","+           and the PHP serializer, so counters and foreign writes stay","+           readable. */","+        $signed = strlen((string)ini_get('phpser.key')) > 0;","+        $value = ['a' => 1, 'b' => [true, null, 1.5]];","+        $keys = ['phpser-raw', 'phpser-empty', 'phpser-plain', 'phpser-tampered',","+                 'phpser-context', 'phpser-incr'];","+","+        $this->redis->del($keys);","+","+        $this->redis->set('phpser-raw', 'not a phpser value');","+        $this->redis->set('phpser-empty', '');","+        $this->redis->set('phpser-plain', phpser_serialize($value));","+        $this->redis->set('phpser-incr', 5);","+","+        $this->redis->setOption(Redis::OPT_SERIALIZER, Redis::SERIALIZER_PHPSER);","+        $this->assertEquals(6, $this->redis->incr('phpser-incr'));","+        $this->assertTrue($this->redis->set('phpser-tampered', $value));","+        $this->assertEquals($value, $this->redis->get('phpser-tampered'));","+","+        $this->assertThrowsMatch(NULL, function () {","+            @$this->redis->_unserialize('not a phpser value');","+        }, '/Invalid serialized data/');","+","+        if ($signed) {","+            $this->redis->setOption(Redis::OPT_SERIALIZER, Redis::SERIALIZER_NONE);","+            $payload = $this->redis->get('phpser-tampered');","+            $payload[0] = chr(ord($payload[0]) ^ 1);","+            $this->redis->set('phpser-tampered', $payload);","+            $this->redis->set('phpser-context', phpser_serialize_keyed($value, 'memcached'));","+            $this->redis->setOption(Redis::OPT_SERIALIZER, Redis::SERIALIZER_PHPSER);","+","+            foreach ($keys as $key) {","+                $this->assertFalse(@$this->redis->get($key));","+            }","+            $this->assertEquals(array_fill(0, count($keys), false),","+                                @$this->redis->mGet($keys));","+        } else {","+            $this->assertEquals('not a phpser value', $this->redis->get('phpser-raw'));","+            $this->assertEquals('', $this->redis->get('phpser-empty'));","+            $this->assertEquals('6', $this->redis->get('phpser-incr'));","+            $this->assertEquals($value, $this->redis->get('phpser-plain'));","+            $this->assertEquals(['not a phpser value', '', '6', $value],","+                $this->redis->mGet(['phpser-raw', 'phpser-empty', 'phpser-incr',","+                                    'phpser-plain']));","+        }","+","+        $this->redis->setOption(Redis::OPT_SERIALIZER, Redis::SERIALIZER_NONE);","+        $this->redis->del($keys);","+    }","+","     private function checkSerializer($mode) {","         $this->redis->del('key');","         $this->assertEquals(Redis::SERIALIZER_NONE, $this->redis->getOption(Redis::OPT_SERIALIZER));   // default"],"additions":66,"deletions":0,"truncated":false},{"path":"tests/windows-smoke.php","lines":["@@ -26,8 +26,8 @@"," }"," "," // The first Windows package has no optional serializer/compression dependencies.","-foreach (['SERIALIZER_IGBINARY', 'SERIALIZER_MSGPACK', 'COMPRESSION_LZF',","-          'COMPRESSION_LZ4', 'COMPRESSION_ZSTD'] as $constant) {","+foreach (['SERIALIZER_IGBINARY', 'SERIALIZER_MSGPACK', 'SERIALIZER_PHPSER',","+          'COMPRESSION_LZF', 'COMPRESSION_LZ4', 'COMPRESSION_ZSTD'] as $constant) {","     if (defined(\"Redis::$constant\")) {","         throw new RuntimeException(\"Unexpected optional feature $constant\");","     }",""],"additions":2,"deletions":2,"truncated":false}],"additions":296,"deletions":42,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-10-15T13:23:13.216565+00:00"}