+1624,10 @@ classes, interfaces, traits and enums. @psalm-suppress of Tainted* issues is","             --stats","                 Shows a breakdown of Psalm’s ability to infer types in the codebase"," ","+            --min-type-coverage=PERCENTAGE","+                Exit with status 2 when Psalm infers types for less than PERCENTAGE (0 to 100) of the codebase.","+                Checked on full runs only. Overrides the minTypeCoverage config option","+","         Reports:","             --report=PATH","                 The path where to output report file. The output format is based on the file extension."],"additions":51,"deletions":2,"truncated":false},{"path":"src/Psalm/Internal/CliUtils.php","lines":["@@ -277,18 +277,35 @@ public static function rejectUnrecognisedOptions(","         }","     }"," ","+    /**","+     * The long options that require a value but were given without one, as \"--name=\" or as the last argument:","+     * getOptions() leaves them out, like getopt() does","+     *","+     * @param list<string> $args the arguments, without the script name","+     * @param list<string> $short_options","+     * @param list<string> $long_options","+     * @return list<string> their names, like \"threads\", once per occurrence","+     * @psalm-capabilities read-props|write-this-props|write-refs","+     */","+    public static function getLongOptionsWithoutValue(array $args, array $short_options, array $long_options): array","+    {","+        return self::parseOptions($args, $short_options, $long_options)[2];","+    }","+","     /**","      * @param list<string> $args","      * @param list<string> $short_options","      * @param list<string> $long_options","-     * @return array{array<string, false|list<false|string>|string>, list<string>} the options like getopt()","-     *      returns them, and the options that aren't in $short_options and $long_options, like \"-z\"","+     * @return array{array<string, false|list<false|string>|string>, list<string>, list<string>} the options like","+     *      getopt() returns them, the options that aren't in $short_options and $long_options, like \"-z\", and","+     *      the long options that require a value but were given without one, like \"threads\"","      * @psalm-capabilities read-props|write-this-props|write-refs","      */","     private static function parseOptions(array $args, array $short_options, array $long_options): array","     {","         $options = [];","         $unrecognised = [];","+        $without_value = [];"," ","         for ($i = 0, $count = count($args); $i < $count; ++$i) {","             $arg = $args[$i];","@@ -317,6 +334,9 @@ private static function parseOptions(array $args, array $short_options, array $l","                     $unrecognised[] = '--' . $name;","                 } elseif ($value === '') {","                     // getopt() drops an option given as --name=","+                    if ($arity === ':') {","+                        $without_value[] = $name;","+                    }","                     continue;","                 } elseif ($arity === '') {","                     self::addOption($options, $name, false);","@@ -326,6 +346,8 @@ private static function parseOptions(array $args, array $short_options, array $l","                     self::addOption($options, $name, $value);","                 } elseif (isset($args[$i + 1])) {","                     self::addOption($options, $name, $args[++$i]);","+                } else {","+                    $without_value[] = $name;","                 }"," ","                 continue;","@@ -358,7 +380,7 @@ private static function parseOptions(array $args, array $short_options, array $l","             }","         }"," ","-        return [$options, $unrecognised];","+        return [$options, $unrecognised, $without_value];","     }"," ","     /**"],"additions":25,"deletions":3,"truncated":false},{"path":"src/Psalm/IssueBuffer.php","lines":["@@ -1072,6 +1072,12 @@ public static function finish(","         // runs), so cached taint sinks/sources keep matching after the analysis is reused from cache.","         $project_analyzer->persistCustomTaints();"," ","+        $type_coverage_message = self::checkMinTypeCoverage($codebase, $is_full);","+","+        if ($type_coverage_message !== null) {","+            fwrite(STDERR, $type_coverage_message . PHP_EOL);","+        }","+","         // a taint analysis run in GitHub Actions that writes a SARIF report exits successfully, so that a following","         // step can upload the report; every other combination exits with an error when issues were found","         if ($error_count","@@ -1082,6 +1088,10 @@ public static function finish(","             exit(2);","         }"," ","+        if ($type_coverage_message !== null) {","+            exit(2);","+        }","+","         // like Rector, a dry run that would change files exits with an error so it can gate CI","         if ($codebase->alter_code","             && $project_analyzer->dry_run","@@ -1106,6 +1116,50 @@ public static function hasSarifReport(array $generated_report_options): bool","         return false;","     }"," ","+    /**","+     * @internal","+     * @return string|null why the run fails the minimum type coverage, null if it passes or doesn't check it","+     * @psalm-capabilities read-props|write-props|write-refs","+     */","+    public static function checkMinTypeCoverage(Codebase $codebase, bool $is_full): ?string","+    {","+        $min_type_coverage = $codebase->config->min_type_coverage;","+","+        // only a full run measures the coverage of the whole project; a diff run counts the unchanged files from","+        // the cache","+        if (!$is_full || $min_type_coverage === null) {","+            return null;","+        }","+","+        return self::getTypeCoverageBelowMinimumMessage(","+            $codebase->analyzer->getTotalTypeCoverage($codebase),","+            $min_type_coverage,","+        );","+    }","+","+    /**","+     * @internal","+     * @param array{int, int} $type_coverage the counts of mixed and of non-mixed expressions","+     * @psalm-pure","+     */","+    public static function getTypeCoverageBelowMinimumMessage(array $type_coverage, float $min_type_coverage): ?string","+    {","+        [$mixed_count, $nonmixed_count] = $type_coverage;","+        $total = $mixed_count + $nonmixed_count;","+","+        // without expressions there is no type that Psalm couldn't infer","+        if ($total === 0 || 100 * $nonmixed_count / $total >= $min_type_coverage) {","+            return null;","+        }","+","+        // rounded down, so that a coverage below the minimum never prints as reaching it","+        return sprintf(","+            'Type coverage %s%% is below the minimum of %s%%',","+            number_format(intdiv(10_000 * $nonmixed_count, $total) / 100, 2),","+            number_format($min_type_coverage, 2),","+        );","+    }","+","     private static function printAlterSummary(","         int $changed_files_count,","         bool $dry_run,"],"additions":54,"deletions":0,"truncated":false},{"path":"tests/Config/ConfigTest.php","lines":["@@ -1362,6 +1362,21 @@ public function testConfigPathErrorOfTheProjectFilesNamesTheElement(): void","         );","     }"," ","+    public function testMinTypeCoverageAboveOneHundredIsAConfigError(): void","+    {","+        $this->expectException(ConfigException::class);","+        $this->expectExceptionMessage(\"attribute 'minTypeCoverage'\");","+        Config::loadFromXML(","+            dirname(__DIR__, 2),","+            '<?xml version=\"1.0\"?>","+            <psalm minTypeCoverage=\"101\">","+                <projectFiles>","+                    <directory name=\"src\" />","+                </projectFiles>","+            </psalm>',","+        );","+    }","+","     public function testImpossibleIssue(): void","     {","         $this->expectExceptionMessage('This element is not expected');"],"additions":15,"deletions":0,"truncated":false},{"path":"tests/EndToEnd/PsalmEndToEndTest.php","lines":["@@ -13,6 +13,7 @@"," use function basename;"," use function file_get_contents;"," use function file_put_contents;","+use function in_array;"," use function json_decode;"," use function mkdir;"," use function preg_replace;","@@ -395,4 +396,120 @@ public static function provideInvalidThreadsArguments(): iterable","         yield 'psalm --scan-threads=-1' => ['psalm', ['--scan-threads=-1'], '--scan-threads' . $message];","         yield 'psalter --threads=abc' => ['psalter', ['--issues=all', '--threads=abc'], '--threads' . $message];","     }","+","+    /**","+     * @param list<string> $args","+     */","+    #[DataProvider('provideTypeCoverageBelowTheMinimum')]","+    public function testTypeCoverageBelowTheMinimumFailsAFullRun(string $attributes, array $args): void","+    {","+        $process = $this->runPsalmOnAProjectWithTypeCoverage($attributes, [...$args, '--output-format=json']);","+","+        $this->assertSame(2, $process->getExitCode(), $process->getOutput() . $process->getErrorOutput());","+        $this->assertSame(\"Type coverage 77.77% is below the minimum of 95.00%\\n\", $process->getErrorOutput());","+        $this->assertSame(\"[]\\n\", $process->getOutput());","+    }","+","+    /**","+     * @return iterable<string, array{string, list<string>}>","+     * @psalm-pure","+     */","+    public static function provideTypeCoverageBelowTheMinimum(): iterable","+    {","+        yield 'option' => ['', ['--min-type-coverage=95']];","+        yield 'config' => ['minTypeCoverage=\"95\"', []];","+    }","+","+    /**","+     * @param list<string> $args","+     */","+    #[DataProvider('provideTypeCoverageNotChecked')]","+    public function testTypeCoverageNotBelowTheMinimumOrNotCheckedPasses(string $attributes, array $args): void","+    {","+        $flag_shaped_path = self::$tmpDir . '/--min-type-coverage';","+","+        if (in_array('--', $args, true)) {","+            // the path after \"--\" looks like the option","+            file_put_contents($flag_shaped_path, \"<?php\\n\");","+        }","+","+        try {","+            $process = $this->runPsalmOnAProjectWithTypeCoverage($attributes, ['--output-format=json', ...$args]);","+","+            $this->assertSame(0, $process->getExitCode(), $process->getOutput() . $process->getErrorOutput());","+            $this->assertSame('', $process->getErrorOutput());","+        } finally {","+            @unlink($flag_shaped_path);","+        }","+    }","+","+    /**","+     * @return iterable<string, array{string, list<string>}>","+     * @psalm-pure","+     */","+    public static function provideTypeCoverageNotChecked(): iterable","+    {","+        yield 'option overrides config' => ['minTypeCoverage=\"95\"', ['--min-type-coverage=77.77']];","+        yield 'partial run with the config attribute' => ['minTypeCoverage=\"95\"', ['src/Untyped.php']];","+        yield 'a path after the terminator' => ['', ['--', '--min-type-coverage']];","+    }","+","+    /**","+     * @param list<string> $args","+     */","+    #[DataProvider('provideInvalidMinTypeCoverage')]","+    public function testInvalidMinTypeCoverageIsAnError(array $args, string $message): void","+    {","+        $process = $this->runPsalmOnAProjectWithTypeCoverage('', $args);","+","+        $this->assertSame(1, $process->getExitCode(), $process->getOutput() . $process->getErrorOutput());","+        $this->assertSame($message . \"\\n\", $process->getErrorOutput());","+    }","+","+    /**","+     * @return iterable<string, array{list<string>, string}>","+     * @psalm-pure","+     */","+    public static function provideInvalidMinTypeCoverage(): iterable","+    {","+        $message = '--min-type-coverage expects a percentage from 0 to 100 with at most two decimals';","+","+        yield 'three decimals' => [['--min-type-coverage=95.555'], $message];","+        yield 'above 100' => [['--min-type-coverage=100.01'], $message];","+        yield 'not a number' => [['--min-type-coverage=abc'], $message];","+        yield 'empty value' => [['--min-type-coverage='], $message];","+        yield 'without a value' => [['--min-type-coverage'], $message];","+        yield 'empty value after a valid one' => [['--min-type-coverage=0', '--min-type-coverage='], $message];","+        yield 'paths' => [","+            ['--min-type-coverage=95', 'src/Untyped.php'],","+            'Cannot check the minimum type coverage when checking specific files',","+        ];","+    }","+","+    /**","+     * @param list<string> $args","+     */","+    private function runPsalmOnAProjectWithTypeCoverage(string $attributes, array $args): Process","+    {","+        @unlink(self::$tmpDir . '/src/FileWithErrors.php');","+        file_put_contents(","+            self::$tmpDir . '/psalm.xml',","+            '<?xml version=\"1.0\"?>","+            <psalm errorLevel=\"8\" runTaintAnalysis=\"false\" findUnusedCode=\"false\" ' . $attributes . '>","+                <projectFiles><directory name=\"src\"/></projectFiles>","+            </psalm>',","+        );","+        // Psalm infers the types of 7 of the 9 expressions: 77.7778%","+        file_put_contents(self::$tmpDir . '/src/Typed.php', \"<?php\\nfunction typed(int \\$a): int { \\$b = \\$a + 1; return \\$b * 2; }\\n\");","+        file_put_contents(self::$tmpDir . '/src/Untyped.php', \"<?php\\nfunction untyped(\\$a) { return \\$a->foo(\\$a->bar); }\\n\");","+","+        $process = self::newProcess(","+            [PHP_BINARY, $this->psalm, '--no-progress', '--no-cache', ...$args],","+            self::$tmpDir,","+            self::agentEnvVarsToUnset(),","+        );","+        $process->run();","+","+        return $process;","+    }"," }"],"additions":117,"deletions":0,"truncated":false},{"path":"tests/Internal/CliUtilsTest.php","lines":["@@ -299,6 +299,28 @@ public static function provideOptionsAndPaths(): iterable","         ];","     }"," ","+    /**","+     * @param list<string> $args","+     * @param list<string> $expected","+     */","+    #[DataProvider('provideLongOptionsWithoutValue')]","+    public function testLongOptionsWithoutValue(array $args, array $expected): void","+    {","+        self::assertSame($expected, CliUtils::getLongOptionsWithoutValue($args, ['c:'], ['issues:', 'no-cache']));","+    }","+","+    /**","+     * @return iterable<string, array{list<string>, list<string>}>","+     * @psalm-pure","+     */","+    public static function provideLongOptionsWithoutValue(): iterable","+    {","+        yield 'an empty value after a value' => [['--issues=x', '--issues='], ['issues']];","+        yield 'the last argument' => [['--no-cache', '--issues'], ['issues']];","+        yield 'the value of another option' => [['-c', '--issues'], []];","+        yield 'a path after the terminator' => [['--', '--issues'], []];","+    }","+","     public function testEverythingAfterTheTerminatorIsAPath(): void","     {","         $dir = (string)tempnam(sys_get_temp_dir(), 'CliUtilsTest_');"],"additions":22,"deletions":0,"truncated":false},{"path":"tests/IssueBufferTest.php","lines":["@@ -183,6 +183,31 @@ public function testNoGeneratedReportIsNotSarif(): void","         self::assertFalse(IssueBuffer::hasSarifReport([]));","     }"," ","+    /**","+     * @param array{int, int} $type_coverage","+     */","+    #[DataProvider('providerTypeCoverageAndMinimum')]","+    public function testTypeCoverageBelowTheMinimumIsReported(","+        array $type_coverage,","+        float $min_type_coverage,","+        ?string $message,","+    ): void {","+        self::assertSame($message, IssueBuffer::getTypeCoverageBelowMinimumMessage($type_coverage, $min_type_coverage));","+    }","+","+    /**","+     * @return iterable<string, array{array{int, int}, float, ?string}>","+     * @psalm-pure","+     */","+    public static function providerTypeCoverageAndMinimum(): iterable","+    {","+        yield 'equal to the minimum' => [[5, 95], 95.0, null];","+        yield 'just below, rounded down' => [[5_001, 94_999], 95.0, 'Type coverage 94.99% is below the minimum of 95.00%'];","+        // floor(100 * 23 / 125 * 100) is 1839","+        yield 'two decimals without float error' => [[102, 23], 95.0, 'Type coverage 18.40% is below the minimum of 95.00%'];","+        yield 'no expressions' => [[0, 0], 95.0, null];","+    }","+","     /**","      * The issues of a group that two workers send, in either order, leave the one at the earliest location: by file","      * path, then line, then column. An issue of another type or message, or of no group, stays."],"additions":25,"deletions":0,"truncated":false},{"path":"tests/ProjectCheckerTest.php","lines":["@@ -30,6 +30,7 @@"," use Psalm\\Tests\\Progress\\EchoProgress;"," use Psalm\\Tests\\TestConfig;"," ","+use function array_keys;"," use function array_map;"," use function get_class;"," use function getcwd;","@@ -673,6 +674,80 @@ public function __construct()","         );","     }"," ","+    public function testDiffRunChecksTheMinimumTypeCoverageOfTheWholeProject(): void","+    {","+        $project_dir = (string) getcwd()","+            . DIRECTORY_SEPARATOR . 'tests'","+            . DIRECTORY_SEPARATOR . 'fixtures'","+            . DIRECTORY_SEPARATOR . 'DummyProject';","+","+        $this->file_provider->registerFile(","+            $project_dir . DIRECTORY_SEPARATOR . 'Untyped.php',","+            '<?php","+","+namespace Vimeo\\Test\\DummyProject;","+","+/**","+ * @param mixed $a","+ * @return mixed","+ */","+function untyped($a)","+{","+    return $a->foo($a->bar);","+}","+',","+        );","+","+        $this->project_analyzer = $this->getProjectAnalyzerWithConfig(","+            Config::loadFromXML(","+                (string)getcwd(),","+                '<?xml version=\"1.0\"?>","+                <psalm minTypeCoverage=\"75\">","+                    <projectFiles>","+                        <directory name=\"tests/fixtures/DummyProject\" />","+                    </projectFiles>","+                </psalm>',","+            ),","+        );","+","+        $this->assertNotNull($this->project_analyzer->stdout_report_options);","+","+        $this->project_analyzer->stdout_report_options->format = Report::TYPE_JSON;","+","+        $this->project_analyzer->check('tests/fixtures/DummyProject', true);","+        ob_start();","+        // 80% of the expressions are typed, above the minimum","+        IssueBuffer::finish($this->project_analyzer, true, microtime(true));","+        ob_end_clean();","+","+        $codebase = $this->project_analyzer->getCodebase();","+        $full_run_coverage = $codebase->analyzer->getTotalTypeCoverage($codebase);","+","+        // unlike a method, a function of a changed file is always analyzed again","+        $untyped_file_path = $project_dir . DIRECTORY_SEPARATOR . 'Untyped.php';","+        $this->file_provider->registerFile($untyped_file_path, $this->file_provider->getContents($untyped_file_path) . \"\\n\");","+","+        $codebase->reloadFiles($this->project_analyzer, []);","+","+        $this->project_analyzer->check('tests/fixtures/DummyProject', true);","+        ob_start();","+        IssueBuffer::finish($this->project_analyzer, true, microtime(true));","+        ob_end_clean();","+","+        $this->assertTrue($codebase->diff_run);","+        // the counts of the other files come from the cache","+        $this->assertSame([$untyped_file_path], array_keys($codebase->analyzer->getMixedCounts()));","+        $this->assertSame([2, 8], $full_run_coverage);","+        $this->assertSame($full_run_coverage, $codebase->analyzer->getTotalTypeCoverage($codebase));","+","+        $codebase->config->min_type_coverage = 95.0;","+        $this->assertSame(","+            'Type coverage 80.00% is below the minimum of 95.00%',","+            IssueBuffer::checkMinTypeCoverage($codebase, true),","+        );","+        $this->assertNull(IssueBuffer::checkMinTypeCoverage($codebase, false));","+    }","+"