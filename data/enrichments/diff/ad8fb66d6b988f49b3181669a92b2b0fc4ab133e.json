a/xla/backends/gpu/codegen/triton/tests/concat/concat_simplify_offset.hlo","lines":["@@ -0,0 +1,37 @@","+// RUN: fusion_to_triton %s --xla_gpu_experimental_enable_tiling_propagation 2>&1 | FileCheck %s","+// RUN: triton_test_correctness %s --xla_gpu_experimental_enable_tiling_propagation","+","+// Both branches of concat access whole second dimension of parameters and we","+// can simplify offset of it to 0 constant.","+","+// CHECK:      xtile.entry_func @triton_fn","+// CHECK:        %[[C0:.*]] = arith.constant 0 : index","+// CHECK:        scf.if","+// CHECK:          %[[ROW_0:.*]] = xla.apply_indexing #indexing_map1(%arg3)","+// CHECK:          xtile.extract %arg0[%[[ROW_0]], %[[C0]]] [16, 128] [1, 1]","+// CHECK:        } else {","+// CHECK:          %[[ROW_1:.*]] = xla.apply_indexing #indexing_map1(%arg3)","+// CHECK:          xtile.extract %arg1[%[[ROW_1]], %[[C0]]] [16, 128] [1, 1]","+","+fusion {","+  p0 = f32[64,128] parameter(0)","+  c0 = bf16[64,128] convert(p0)","+  p1 = f32[64,128] parameter(1)","+  c1 = bf16[64,128] convert(p1)","+  concat = bf16[64,256] concatenate(c0, c1), dimensions={1}","+  ROOT reshape = bf16[2,32,256] reshape(concat)","+}","+","+ENTRY main {","+  p0 = f32[64,128] parameter(0)","+  p1 = f32[64,128] parameter(1)","+  ROOT fusion = bf16[2,32,256] fusion(p0, p1), kind=kCustom,","+    calls=fusion, backend_config={","+    \"fusion_backend_config\":{","+      \"kind\":\"__triton_nested_gemm_fusion\",","+      \"block_level_fusion_config\":{","+        \"output_tiles\":[{\"sizes\":[\"1\",\"16\",\"128\"]}],","+        \"num_warps\":\"1\",","+        \"num_ctas\":\"1\",","+        \"num_stages\":\"1\"}}}","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/concat/concat_slice_inactive_operand.hlo","lines":["@@ -0,0 +1,44 @@","+// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation %s 2>&1 | FileCheck %s","+// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation %s","+","+// The slice effectively accesses only second parameter so we can skip scf.if .","+","+// CHECK:      xtile.entry_func @triton_fn","+// CHECK-NOT:    scf.if","+// CHECK:        %[[C0:.*]] = arith.constant 0 : index","+// CHECK-NEXT:   %[[EXTRACT:.*]] = xtile.extract %arg1[%[[C0]], %[[C0]]] [32, 16] [1, 1] : memref<32x16xf32> -> tensor<32x16xf32>","+// CHECK-NEXT:   xtile.insert %[[EXTRACT]] into %arg2[%[[C0]], %[[C0]]] [32, 16] [1, 1]","+// CHECK-NEXT:   xtile.return","+","+HloModule concat_slice_second_operand, is_scheduled=true, entry_computation_layout={(f32[64,16]{1,0}, f32[32,16]{1,0})->f32[32,16]{1,0}}","+","+%fused_computation (param_0: f32[64,16], param_1: f32[32,16]) -> f32[32,16] {","+  %param_0 = f32[64,16]{1,0} parameter(0)","+  %param_1 = f32[32,16]{1,0} parameter(1)","+  %concat = f32[96,16]{1,0} concatenate(%param_0, %param_1), dimensions={0}","+  ROOT %slice = f32[32,16]{1,0} slice(%concat), slice={[64:96], [0:16]}","+}","+","+ENTRY %entry_computation (param_0: f32[64,16], param_1: f32[32,16]) -> f32[32,16] {","+  %param_0 = f32[64,16]{1,0} parameter(0)","+  %param_1 = f32[32,16]{1,0} parameter(1)","+  ROOT %fusion = f32[32,16]{1,0} fusion(%param_0, %param_1), kind=kCustom, calls=%fused_computation,","+    backend_config={","+      \"operation_queue_id\":\"0\",","+      \"fusion_backend_config\":{","+        \"kind\":\"__triton\",","+        \"block_level_fusion_config\":{","+          \"num_warps\":\"4\",","+          \"output_tiles\":[{\"sizes\":[\"32\",\"16\"]}],","+          \"num_ctas\":1,","+          \"num_stages\":1,","+          \"is_tma_allowed\":true,","+          \"is_warp_specialization_allowed\":false,","+          \"waves_per_eu\":0","+        }","+      },","+      \"force_earliest_schedule\":false,","+      \"reification_cost\":[],","+      \"device_type\":\"DEVICE_TYPE_INVALID\"","+    }","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/codegen/tiling/BUILD"