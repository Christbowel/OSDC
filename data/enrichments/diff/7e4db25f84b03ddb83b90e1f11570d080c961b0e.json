{"id":"7e4db25f84b03ddb83b90e1f11570d080c961b0e","axis":"silent","repo":"pnpm/pnpm","sha":"7e4db25f84b03ddb83b90e1f11570d080c961b0e","parsed":{"files":[{"path":".changeset/pnpr-web-ui.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/pnpr\": minor","+\"@pnpm/pnpr-ui\": minor","+---","+","+pnpr serves a web UI at `/-/ui/` when the new `@pnpm/pnpr-ui` package is installed next to it, for example with `pnpm add -g @pnpm/pnpr,@pnpm/pnpr-ui`. The new `ui` setting turns the UI off or serves it from another directory."],"additions":6,"deletions":0,"truncated":false},{"path":".github/workflows/release.yml","lines":["@@ -1447,6 +1447,39 @@ jobs:","             *.tar.gz","             *.sha256"," ","+  build-pnpr-ui:","+    name: Build the pnpr web UI","+    needs: plan","+    if: needs.plan.outputs.pnpr == 'true' && !inputs.verify_ts_release","+    runs-on: ubuntu-latest","+    permissions:","+      contents: read","+    steps:","+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+        with:","+          persist-credentials: false","+","+      - name: Install pnpm and Node","+        uses: pnpm/setup@fbda4c85fc2e1e08721cd8763afea8f48d60f024 # v3.0.0","+        with:","+          runtime: node@22","+          install: false","+","+      - name: Build","+        # pnpr/ui is a workspace of its own: it installs the UI's components","+        # from bit.cloud's registry and writes the bundle into","+        # pnpr/npm/pnpr-ui/dist.","+        run: |","+          pnpm --dir pnpr/ui install --frozen-lockfile","+          pnpm --dir pnpr/ui build","+","+      - name: Upload Artifact","+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1","+        with:","+          name: pnpr-ui","+          path: pnpr/npm/pnpr-ui/dist","+          if-no-files-found: error","+","   verify-pnpr-artifacts:","     name: Verify pnpr npm artifacts","     runs-on: ubuntu-latest","@@ -1455,6 +1488,7 @@ jobs:","     needs:","       - plan","       - build-pnpr","+      - build-pnpr-ui","     steps:","       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","         with:","@@ -1472,6 +1506,12 @@ jobs:","           pattern: binaries-pnpr-*","           merge-multiple: true"," ","+      - name: Download the web UI","+        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1","+        with:","+          name: pnpr-ui","+          path: pnpr/npm/pnpr-ui/dist","+","       - name: Unzip","         uses: montudor/action-zip@0852c26906e00f8a315c704958823928d8018b28 # v1.0.0","         with:","@@ -1559,6 +1599,20 @@ jobs:","           node \"$smoke_dir/node_modules/@pnpm/pnpr/install.js\"","           \"$smoke_dir/node_modules/@pnpm/pnpr/bin/pnpr\" --version"," ","+          # pnpr finds the web UI installed next to it and serves it.","+          ui_tarball=$(find \"$release_tarballs/pnpr_npm_pnpr-ui\" -type f -name '*.tgz' -print -quit)","+          test -n \"$ui_tarball\"","+          mkdir -p \"$smoke_dir/node_modules/@pnpm/pnpr-ui\"","+          tar -xzf \"$ui_tarball\" -C \"$smoke_dir/node_modules/@pnpm/pnpr-ui\" --strip-components=1","+          (cd \"$smoke_dir\" && ./node_modules/@pnpm/pnpr/bin/pnpr --listen 127.0.0.1:7690 > pnpr.log 2>&1) &","+          pnpr_pid=$!","+          trap 'kill \"$pnpr_pid\" 2>/dev/null || true' EXIT","+          curl --silent --show-error --retry 30 --retry-connrefused --retry-delay 1 --output /dev/null http://127.0.0.1:7690/-/ping","+          curl --silent --show-error --fail http://127.0.0.1:7690/-/ui/ | grep -F '<base href=\"./\">' || {","+            cat \"$smoke_dir/pnpr.log\"","+            exit 1","+          }","+","   publish-pnpr:","     name: Publish @pnpm/pnpr to npm","     runs-on: ubuntu-latest","@@ -1571,6 +1625,7 @@ jobs:","     needs:","       - plan","       - build-pnpr","+      - build-pnpr-ui","       - verify-pnpr-artifacts","     steps:","       - uses: actions/checkout@3d3c42e5aac5ba80