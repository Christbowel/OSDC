LI (`pnpm`) leads an epic that bands every library package","   # under pnpm11/ to the CLI's major: while `pnpm` is on major 11 the libraries","@@ -191,6 +194,7 @@ versioning:","         - '!./pnpm11/pnpm/artifacts/**'","   lanes:","     '@pnpm/pnpr': alpha","+    '@pnpm/pnpr-ui': alpha"," "," allowBuilds:","   '@parcel/watcher': false"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/config_file.rs","lines":["@@ -185,6 +185,9 @@ pub(super) struct ConfigFile {","     /// when this block is absent or its allowlist is empty.","     #[serde(default)]","     pub(super) cors: CorsFile,","+    /// pnpr-only web UI settings.","+    #[serde(default)]","+    pub(super) ui: UiFile,","     #[serde(default)]","     pub(super) oci: OciConfig,","     /// pnpr-only block: store the hosted (published) packages in an","@@ -259,6 +262,19 @@ pub(super) struct CorsFile {","     pub(super) allowed_origins: Vec<String>,"," }"," ","+#[derive(Debug, Deserialize)]","+#[serde(default, rename_all = \"camelCase\", deny_unknown_fields)]","+pub(super) struct UiFile {","+    pub(super) enabled: bool,","+    pub(super) dir: Option<String>,","+}","+","+impl Default for UiFile {","+    fn default() -> Self {","+        Self { enabled: true, dir: None }","+    }","+}","+"," /// Marker for a present top-level `packages:` key, whatever its value."," #[derive(Debug, Default)]"," pub(super) struct RemovedPackagesBlock;"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -18,6 +18,7 @@ pub use pnpr_policy::{TeamDirectory, Teams};"," "," pub use s3::{HostedStoreConfig, S3Settings, build_s3_store, normalize_key_prefix};"," pub use scim::ScimConfig;","+pub use web_ui::UiConfig;"," "," pub use self::upstream::{RedactedHeaders, UpstreamConfig, UpstreamRequestPolicy};"," ","@@ -58,6 +59,9 @@ use access::{build_admins, build_teams};"," mod s3;"," mod scim;"," ","+mod web_ui;","+use web_ui::build_ui_config;","+"," mod upstream;"," "