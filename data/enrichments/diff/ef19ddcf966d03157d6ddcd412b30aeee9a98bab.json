{"id":"ef19ddcf966d03157d6ddcd412b30aeee9a98bab","axis":"silent","repo":"pnpm/pnpm","sha":"ef19ddcf966d03157d6ddcd412b30aeee9a98bab","parsed":{"files":[{"path":".changeset/global-config-scope-routing.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm config set --global --json tools` now writes `tools` to the global `config.yaml` and validates its structure before saving. `pnpm config set --global` also accepts `pm-on-fail` and `runtime-on-fail`. `blockExoticSubdeps` and `excludeLinksFromLockfile` set in the global `config.yaml` now take effect during installs and appear in `pnpm config get --global`. pnpm now ignores workspace-only settings in the global `config.yaml` and prints a warning, matching `pnpm config set --global`."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -5042,6 +5042,7 @@ dependencies = [","  \"tracing\",","  \"tracing-subscriber\",","  \"url\",","+ \"yaml_serde\","," ]"," "," [[package]]"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config.rs","lines":["@@ -19,11 +19,13 @@ use derive_more::{Display, Error};"," use indexmap::IndexMap;"," use miette::Diagnostic;"," use pnpm_config::{","-    Config, DEFAULT_JSR_REGISTRY, GLOBAL_CONFIG_YAML_FILENAME, MacosBackupSettings,","-    WORKSPACE_MANIFEST_FILENAME, config_types, naming_cases, property_path, property_path::Segment,","-    protected_settings, refused_keys,","+    Config, DEFAULT_JSR_REGISTRY, GLOBAL_CONFIG_YAML_FILENAME, WORKSPACE_MANIFEST_FILENAME,","+    YamlConfigTarget, config_types, naming_cases, property_path, property_path::Segment,","+    protected_settings, refused_keys, validate_structured_setting,","+};","+use pnpm_workspace_manifest_writer::{","+    update_manifest_field, update_private_manifest_field, update_workspace_setting,"," };","-use pnpm_workspace_manifest_writer::{update_manifest_field, update_workspace_setting};"," use serde_json::{Map, Value};"," use std::path::{Path, PathBuf};"," use values::{","@@ -169,11 +171,8 @@ pub enum ConfigError {","     SetUnsupportedWorkspaceKey { key: String, camel: String },"," ","     #[display(\"The key {key:?} isn't supported by the global config.yaml file\")]","-    #[diagnostic(","-        code(ERR_PNPM_CONFIG_SET_UNSUPPORTED_YAML_CONFIG_KEY),","-        help(\"Try setting them instead to the local pnpm-workspace.yaml file\")","-    )]","-    SetUnsupportedYamlConfigKey { key: String },","+    #[diagnostic(code(ERR_PNPM_CONFIG_SET_UNSUPPORTED_YAML_CONFIG_KEY), help(\"{hint}\"))]","+    SetUnsupportedYamlConfigKey { key: String, hint: String },"," ","     /// A project's `pnpm-workspace.yaml` carries no machine-level state, so","     /// writing such a key there would only leave behind one pnpm ignores.","@@ -328,38 +327,62 @@ fn set_yaml_setting(","     key: &str,","     value: Value,"," ) -> miette::Result<()> {","+    let target = if config_file_name == WORKSPACE_MANIFEST_FILENAME {","+        YamlConfigTarget::Project","+    } else {","+        YamlConfigTarget::Global","+    };","     let write = |key: &str, value: &Value| {","-        if config_file_name == WORKSPACE_MANIFEST_FILENAME {","-            update_workspace_setting(config_dir, key, value)","-        } else {","-            update_manifest_field(&config_dir.join(config_file_name), key, value)","+        match target {","+            YamlConfigTarget::Project => update_workspace_setting(config_dir, key, value),","+            YamlConfigTarget::Global if carries_global_credentials(key, value) => {","+                update_private_manifest_field(&config_dir.join(config_file_name), key, value)","+            }","+            YamlConfigTarget::Global => {","+                update_manifest_field(&config_dir.join(config_file_name), key, value)","+            }","         }","         .map_err(miette::Report::new)","     };","     let given_key = key;","-    let key = if config_file_name == GLOBAL_CONFIG_YAML_FILENAME {","-        validate_yaml_config_key(key)?","-    } else {","-        key.to_string()","-    };","-    let key = validate_workspace_key(&key)?;","-    let cast = cast_field(value, &naming_cases::to_kebab_case(&key));","-    if config_file_name == WORKSPACE_MANIFEST_FILENAME","-        && !cast.is_null()","-        && refused_keys::is_refused_by_a_project_manifest(&key)","-    {","-        return Err(ConfigError::SetNotAProjectSetting {","-            belongs: refused_keys::where_refused_key_belongs(&key),","-            key,","-        }","-        .into());","-    }","-    validate_macos_backup_value(&key, &cast)?;","-    write(&key, &cast)?;","+    let cast = cast_field(value, &naming_cases::to_kebab_case(key));","     if cast.is_null() {","-        clear_other_spellings(&key, given_key, write)?;","+        let camel_key = naming_cases::to_camel_case(key);","+        write(&camel_key, &Value::Null)?;","+        return clear_other_spellings(&camel_key, given_key, write);","+    }","+    let key = validate_yaml_target_key(key, target)?;","+    validate_structured_setting(&key, &cast, target)","+        .map_err(|reason| ConfigError::SetStructuredValue { key: key.clone(), reason })?;","+    write(&key, &cast)","+}","+","+fn carries_global_credentials(camel_key: &str, value: &Value) -> bool {","+    !value.is_null()","+        && (matches!(camel_key, \"remoteCache\" | \"remoteSideEffectsCache\")","+            || (camel_key == \"sideEffectsCache\"","+                && value","+                    .as_object()","+                    .is_some_and(|object| object.contains_key(\"remote\"))))","+}","+","+fn validate_yaml_target_key(key: &str, target: YamlConfigTarget) -> Result<String, ConfigError> {","+    match target {","+        YamlConfigTarget::Project => {","+            let key = validate_workspace_key(key)?;","+            if refused_keys::is_refused_by_a_project_manifest(&key) {","+                return Err(ConfigError::SetNotAProjectSetting {","+                    belongs: refused_keys::where_refused_key_belongs(&key),","+                    key,","+                });","+            }","+            Ok(key)","+        }","+        YamlConfigTarget::Global => {","+            let kebab = validate_yaml_config_key(key)?;","+            validate_workspace_key(&kebab)","+        }","     }","-    Ok(())"," }"," "," /// A hand-edited file may carry a spelling pnpm did not write, and that is the","@@ -379,31 +402,6 @@ fn clear_other_spellings(","     Ok(())"," }"," ","-fn validate_macos_backup_value(key: &str, value: &Value) -> Result<(), ConfigError> {","-    if key != \"macosBackup\" || value.is_null() {","-        return Ok(());","-    }","-    if let Some(unknown) = value","-        .as_object()","-        .and_then(|object| {","-            object","-                .keys()","-                .find(|field| !matches!(field.as_str(), \"excludeModulesDir\" | \"excludeStoreDir\"))","-        })","-    {","-        return Err(ConfigError::SetStructuredValue {","-            key: key.to_string(),","-            reason: format!(\"unknown field {unknown:?}\"),","-        });","-    }","-    serde_json::from_value::<MacosBackupSettings>(value.clone())","-        .map(|_| ())","-        .map_err(|error| ConfigError::SetStructuredValue {","-            key: key.to_string(),","-            reason: error.to_string(),","-        })","-}","-"," /// Write an auth setting to the global `auth.ini` or the directory's"," /// `.npmrc`."," fn set_auth_setting("],"additions":57,"deletions":59,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config/tests.rs","lines":["@@ -1311,3 +1311,5 @@ fn global_flag_and_global_location_are_the_same_scope() {","     assert!(!flags(true, Some(ConfigLocation::Project), false).is_global());","     assert!(!flags(false, None, false).is_global());"," }","+","+mod scope_routing;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config/tests/scope_routing.rs","lines":["@@ -0,0 +1,518 @@","+use super::{","+    Config, ConfigLocation, TempDir, Value, config_get, config_list, config_set, config_with_dir,","+    flags, json, load_isolated_project_config, read_yaml,","+};","+use pnpm_config::TrustedSettings;","+use std::path::Path;","+","+fn load_global_only_config(config_dir: &Path) -> Config {","+    let mut config = config_with_dir(config_dir);","+    if let Some(trusted) = TrustedSettings::load_global(config_dir).expect(\"load global config\") {","+        config.record_explicit_settings(&trusted);","+        trusted.apply_to(&mut config, config_dir);","+    }","+    config","+}","+","+#[test]","+fn set_get_and_delete_global_tools_round_trip() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    let tools = json!({","+        \"node\": {","+            \"mirror\": \"https://mirror.example.com/node/download\",","+            \"channels\": {","+                \"nightly\": \"https://nightly.example.com/\"","+            }","+        },","+        \"python\": {","+            \"mirror\": \"https://mirror.example.com/python\"","+        }","+    });","+    config_set(&config, tmp.path(), flags(true, None, true), \"tools\", Some(tools.to_string()))","+        .unwrap();","+","+    assert_eq!(read_yaml(&config_dir.join(\"config.yaml\")).unwrap(), json!({ \"tools\": tools }));","+","+    let loaded = load_global_only_config(&config_dir);","+    let got: Value =","+        serde_json::from_str(&config_get(&loaded, flags(true, None, false), \"tools\").unwrap())","+            .unwrap();","+    assert_eq!(got[\"node\"][\"mirror\"], json!(\"https://mirror.example.com/node/download\"));","+    assert_eq!(got[\"node\"][\"channels\"][\"nightly\"], json!(\"https://nightly.example.com/\"));","+    assert_eq!(got[\"python\"][\"mirror\"], json!(\"https://mirror.example.com/python\"));","+    assert_eq!(","+        config_get(&loaded, flags(true, None, false), \"tools.node.mirror\").unwrap(),","+        \"https://mirror.example.com/node/download\",","+    );","+","+    let listed: Value = serde_json::from_str(&config_list(&loaded)).unwrap();","+    assert_eq!(listed[\"tools\"][\"node\"][\"mirror\"], got[\"node\"][\"mirror\"]);","+","+    config_set(&config, tmp.path(), flags(true, None, false), \"tools\", None).unwrap();","+    assert!(!config_dir.join(\"config.yaml\").exists());","+}","+","+#[test]","+fn set_global_tools_rejects_invalid_values_without_writing_config_yaml() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    let scalar_err = config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, false),","+        \"tools\",","+        Some(\"https://mirror.example.com\".into()),","+    )","+    .unwrap_err();","+    assert_eq!(scalar_err.code().unwrap().to_string(), \"ERR_PNPM_CONFIG_SET_STRUCTURED_VALUE\");","+    assert!(!config_dir.join(\"config.yaml\").exists());","+","+    for invalid_json in [","+        r#\"{\"node\":\"22.0.0\"}\"#,","+        r#\"{\"deno\":{\"mirror\":\"https://mirror.example.com\"}}\"#,","+        r#\"{\"python\":{\"channels\":{\"rc\":\"https://mirror.example.com\"}}}\"#,","+        r#\"{\"node\":{\"unknownField\":true}}\"#,","+    ] {","+        let err = config_set(","+            &config,","+            tmp.path(),","+            flags(true, None, true),","+            \"tools\",","+            Some(invalid_json.into()),","+        )","+        .unwrap_err();","+        assert_eq!(","+            err.code().unwrap().to_string(),","+            \"ERR_PNPM_CONFIG_SET_STRUCTURED_VALUE\",","+            \"{invalid_json}\",","+        );","+        assert!(!config_dir.join(\"config.yaml\").exists(), \"{invalid_json}\");","+    }","+}","+","+#[test]","+fn set_project_tools_refuses_and_points_to_global_config_set() {","+    let tmp = TempDir::new().unwrap();","+    let config = config_with_dir(&tmp.path().join(\"global-config\"));","+","+    let err = config_set(","+        &config,","+        tmp.path(),","+        flags(false, Some(ConfigLocation::Project), true),","+        \"tools\",","+        Some(r#\"{\"node\":{\"mirror\":\"https://mirror.example.com/node/download\"}}\"#.into()),","+    )","+    .unwrap_err();","+","+    assert_eq!(err.code().unwrap().to_string(), \"ERR_PNPM_CONFIG_SET_NOT_A_PROJECT_SETTING\");","+    let help = err","+        .help()","+        .expect(\"refused-key help\")","+        .to_string();","+    assert_eq!(help, \"Set it for the machine instead: pnpm config set --global tools\");","+    assert!(","+        !tmp.path()","+            .join(\"pnpm-workspace.yaml\")","+            .exists(),","+    );","+}","+","+#[test]","+fn global_block_exotic_subdeps_and_exclude_links_from_lockfile_round_trip() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, false),","+        \"blockExoticSubdeps\",","+        Some(\"true\".into()),","+    )","+    .unwrap();","+    config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, false),","+        \"excludeLinksFromLockfile\",","+        Some(\"true\".into()),","+    )","+    .unwrap();","+","+    let loaded_global = load_global_only_config(&config_dir);","+    assert_eq!(","+        config_get(&loaded_global, flags(true, None, false), \"blockExoticSubdeps\").unwrap(),","+        \"true\",","+    );","+    assert_eq!(","+        config_get(&loaded_global, flags(true, None, false), \"exclude-links-from-lockfile\")","+            .unwrap(),","+        \"true\",","+    );","+","+    let project_runtime = load_isolated_project_config(config, tmp.path());","+    assert!(project_runtime.block_exotic_subdeps);","+    assert!(project_runtime.exclude_links_from_lockfile);","+}","+","+#[test]","+fn global_pm_on_fail_and_runtime_on_fail_round_trip() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    config_set(&config, tmp.path(), flags(true, None, false), \"pm-on-fail\", Some(\"ignore\".into()))","+        .unwrap();","+    config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, false),","+        \"runtime-on-fail\",","+        Some(\"error\".into()),","+    )","+    .unwrap();","+","+    let loaded_global = load_global_only_config(&config_dir);","+    assert_eq!(","+        config_get(&loaded_global, flags(true, None, false), \"pm-on-fail\").unwrap(),","+        \"ignore\",","+    );","+    assert_eq!(","+        config_get(&loaded_global, flags(true, None, false), \"runtimeOnFail\").unwrap(),","+        \"error\",","+    );","+","+    let project_runtime = load_isolated_project_config(config, tmp.path());","+    assert_eq!(project_runtime.pm_on_fail, Some(pnpm_config::PmOnFail::Ignore));","+    assert_eq!(project_runtime.runtime_on_fail, Some(pnpm_config::RuntimeOnFail::Error));","+}","+","+#[test]","+fn max_sockets_coerces_to_number_and_round_trips_in_both_spellings() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    config_set(&config, tmp.path(), flags(true, None, false), \"maxSockets\", Some(\"5\".into()))","+        .unwrap();","+    assert_eq!(read_yaml(&config_dir.join(\"config.yaml\")).unwrap(), json!({ \"maxSockets\": 5 }));","+","+    let loaded_global = load_global_only_config(&config_dir);","+    assert_eq!(loaded_global.max_sockets, Some(5));","+    assert_eq!(config_get(&loaded_global, flags(true, None, false), \"maxSockets\").unwrap(), \"5\");","+    assert_eq!(config_get(&loaded_global, flags(true, None, false), \"max-sockets\").unwrap(), \"5\");","+    assert_eq!(config_get(&loaded_global, flags(true, None, false), \"maxsockets\").unwrap(), \"5\");","+","+    config_set(","+        &config,","+        tmp.path(),","+        flags(false, Some(ConfigLocation::Project), false),","+        \"maxSockets\",","+        Some(\"8\".into()),","+    )","+    .unwrap();","+    assert_eq!(","+        read_yaml(&tmp.path().join(\"pnpm-workspace.yaml\")).unwrap(),","+        json!({ \"maxSockets\": 8 }),","+    );","+}","+","+#[test]","+fn delete_global_clears_unsupported_and_refused_keys_without_failing() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    std::fs::create_dir_all(&config_dir).unwrap();","+    std::fs::write(","+        config_dir.join(\"config.yaml\"),","+        \"nodeLinker: hoisted\\nauto-install-peers: false\\nconfigDir: /tmp/x\\nstoreDir: ~/store\\n\",","+    )","+    .unwrap();","+    let config = config_with_dir(&config_dir);","+","+    for key in [\"node-linker\", \"autoInstallPeers\", \"config-dir\"] {","+        config_set(&config, tmp.path(), flags(true, None, false), key, None).unwrap();","+    }","+","+    assert_eq!(read_yaml(&config_dir.join(\"config.yaml\")), Some(json!({ \"storeDir\": \"~/store\" })));","+}","+","+#[test]","+fn set_global_unsupported_key_gives_accurate_hint_for_refused_vs_workspace_keys() {","+    let tmp = TempDir::new().unwrap();","+    let config = config_with_dir(&tmp.path().join(\"global-config\"));","+","+    let dir_err =","+        config_set(&config, tmp.path(), flags(true, None, false), \"dir\", Some(\"/tmp/x\".into()))","+            .unwrap_err();","+    assert_eq!(","+        dir_err.code().unwrap().to_string(),","+        \"ERR_PNPM_CONFIG_SET_UNSUPPORTED_YAML_CONFIG_KEY\",","+    );","+    assert_eq!(dir_err.help().unwrap().to_string(), \"Pass --dir on the command line instead\");","+","+    let cfg_dir_err = config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, false),","+        \"config-dir\",","+        Some(\"/tmp/x\".into()),","+    )","+    .unwrap_err();","+    assert_eq!(cfg_dir_err.help().unwrap().to_string(), \"This is not a pnpm setting\");","+","+    let ws_err = config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, false),","+        \"node-linker\",","+        Some(\"hoisted\".into()),","+    )","+    .unwrap_err();","+    assert_eq!(","+        ws_err.help().unwrap().to_string(),","+        \"Try setting them instead to the local pnpm-workspace.yaml file\",","+    );","+}","+","+#[test]","+fn set_structured_setting_with_env_placeholder_preserves_placeholder_and_loads() {","+    let tmp = TempDir::new().unwrap();","+    let config = config_with_dir(&tmp.path().join(\"global-config\"));","+","+    config_set(","+        &config,","+        tmp.path(),","+        flags(false, Some(ConfigLocation::Project), true),","+        \"nodePackageMap\",","+        Some(r#\"{\"mode\":\"${PNPM_TEST_UNSET_MAP_MODE:-load}\"}\"#.into()),","+    )","+    .unwrap();","+","+    let raw = std::fs::read_to_string(tmp.path().join(\"pnpm-workspace.yaml\")).unwrap();","+    assert!(raw.contains(\"${PNPM_TEST_UNSET_MAP_MODE:-load}\"), \"{raw}\");","+","+    let loaded = pnpm_config::WorkspaceSettings::load_at(tmp.path()).unwrap().unwrap();","+    assert_eq!(loaded.node_package_map.unwrap().mode, Some(pnpm_config::NodePackageMapMode::Load));","+}","+","+#[test]","+fn set_registry_maps_with_env_placeholder_rejected_in_project_and_allowed_globally() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    for (key, payload) in [","+        (\"namedRegistries\", r#\"{\"corp\":\"${PNPM_TEST_UNSET_REG_URL}\"}\"#),","+        (\"registries\", r#\"{\"@corp\":\"${PNPM_TEST_UNSET_REG_URL}\"}\"#),","+    ] {","+        let err = config_set(","+            &config,","+            tmp.path(),","+            flags(false, Some(ConfigLocation::Project), true),","+            key,","+            Some(payload.into()),","+        )","+        .unwrap_err();","+        assert_eq!(err.code().unwrap().to_string(), \"ERR_PNPM_CONFIG_SET_STRUCTURED_VALUE\");","+        assert!(","+            !tmp.path()","+                .join(\"pnpm-workspace.yaml\")","+                .exists(),","+        );","+","+        config_set(&config, tmp.path(), flags(true, None, true), key, Some(payload.into()))","+            .unwrap();","+    }","+    assert!(TrustedSettings::load_global(&config_dir).unwrap().is_some());","+}","+","+#[test]","+fn set_structured_string_with_multiple_trailing_newlines_round_trips() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+    let payload = json!({","+        \"url\": \"https://cache.example.com\",","+        \"privateKey\": \"line1\\nline2\\n\\n\"","+    });","+","+    config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, true),","+        \"remote-cache\",","+        Some(payload.to_string()),","+    )","+    .unwrap();","+","+    assert_eq!(","+        read_yaml(&config_dir.join(\"config.yaml\")).unwrap()[\"remoteCache\"][\"privateKey\"],","+        json!(\"line1\\nline2\\n\\n\"),","+    );","+    let loaded = TrustedSettings::load_global(&config_dir).unwrap().unwrap();","+    assert_eq!(","+        loaded.settings.remote_cache.unwrap().private_key.as_deref(),","+        Some(\"line1\\nline2\\n\\n\"),","+    );","+}","+","+#[test]","+fn set_side_effects_cache_rejects_project_trust_material_and_allows_global_and_bool() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    let signed = json!({","+        \"read\": true,","+        \"remote\": {","+            \"org\": \"acme\",","+            \"packages\": [\"pkg\"],","+            \"privateKey\": \"secret-key\"","+        }","+    });","+    let err = config_set(","+        &config,","+        tmp.path(),","+        flags(false, Some(ConfigLocation::Project), true),","+        \"sideEffectsCache\",","+        Some(signed.to_string()),","+    )","+    .unwrap_err();","+    assert_eq!(err.code().unwrap().to_string(), \"ERR_PNPM_CONFIG_SET_STRUCTURED_VALUE\");","+    assert!(err.to_string().contains(\"sideEffectsCache.remote.privateKey\"), \"{err}\");","+    assert!(","+        !tmp.path()","+            .join(\"pnpm-workspace.yaml\")","+            .exists(),","+    );","+","+    config_set(","+        &config,","+        tmp.path(),","+        flags(false, Some(ConfigLocation::Project), false),","+        \"sideEffectsCache\",","+        Some(\"true\".into()),","+    )","+    .unwrap();","+    assert_eq!(","+        read_yaml(&tmp.path().join(\"pnpm-workspace.yaml\")).unwrap(),","+        json!({ \"sideEffectsCache\": true }),","+    );","+","+    config_set(","+        &config,","+        tmp.path(),","+        flags(true, None, true),","+        \"sideEffectsCache\",","+        Some(signed.to_string()),","+    )","+    .unwrap();","+    assert!(TrustedSettings::load_global(&config_dir).unwrap().is_some());","+}","+","+#[test]","+fn list_and_get_censor_global_cache_signing_keys() {","+    let tmp = TempDir::new().unwrap();","+    let config_dir = tmp.path().join(\"global-config\");","+    let config = config_with_dir(&config_dir);","+","+    for (key, payload) in [","+        (\"remote-cache\", json!({ \"url\": \"https://cache.example.com\", \"privateKey\": \"sec-rc\" })),","+        (","+            \"remote-side-effects-cache\",","+            json!({ \"org\": \"acme\", \"packages\": [\"pkg\"], \"privateKey\": \"sec-rsec\" }),","+        ),","+        (","+            \"side-effects-cache\",","+            json!({","+                \"read\": true,","+                \"remote\": { \"org\": \"acme\", \"packages\": [\"pkg\"], \"privateKey\": \"sec-sec\" }","+            }),","+        ),","+    ] {","+        config_set(&config, tmp.path(), flags(true, None, true), key, Some(payload.to_string()))","+            .unwrap();","+    }","+","+    let loaded = load_global_only_config(&config_dir);","+    let listed = config_list(&loaded);","+    assert!(","+        !listed.contains(\"sec-rc\") && !listed.contains(\"sec-rsec\") && !listed.contains(\"sec-sec\"),","+    );","+","+    let listed_json: Value = serde_json::from_str(&listed).unwrap();","+    assert_eq!(listed_json[\"remoteCache\"][\"privateKey\"], json!(\"(protected)\"));","+    assert_eq!(listed_json[\"remoteSideEffectsCache\"][\"privateKey\"], json!(\"(protected)\"));","+    assert_eq!(listed_json[\"sideEffectsCache\"][\"remote\"][\"privateKey\"], json!(\"(protected)\"));","+","+    for key in [\"remote-cache\", \"remote-side-effects-cache\", \"side-effects-cache\"] {","+        let output = config_get(&loaded, flags(true, None, false), key).unwrap();","+        assert!(output.contains(\"(protected)\"), \"{key} output: {output}\");","+        assert!(!output.contains(\"sec-\"), \"{key} leaked key: {output}\");","+    }","+    for path in [","+        \"remoteCache.privateKey\",","+        \"remoteSideEffectsCache.privateKey\",","+        \"sideEffectsCache.remote.privateKey\",","+    ] {","+        assert_eq!(config_get(&loaded, flags(true, None, false), path).unwrap(), \"(protected)\");","+    }","+}","+","+#[cfg(unix)]","+#[test]","+fn set_global_remote_cache_sections_writes_owner_only_permissions() {","+    use std::os::unix::fs::PermissionsExt;","+","+    for (key, payload) in [","+        (\"remote-cache\", json!({ \"url\": \"https://cache.example.com\", \"privateKey\": \"secret\" })),","+        (","+            \"remote-side-effects-cache\",","+            json!({ \"org\": \"acme\", \"packages\": [\"pkg\"], \"privateKey\": \"secret\" }),","+        ),","+        (","+            \"side-effects-cache\",","+            json!({ \"remote\": { \"org\": \"acme\", \"packages\": [\"pkg\"], \"privateKey\": \"secret\" } }),","+        ),","+    ] {","+        let tmp = TempDir::new().unwrap();","+        let config_dir = tmp.path().join(\"global-config\");","+        let config_path = config_dir.join(\"config.yaml\");","+        let config = config_with_dir(&config_dir);","+","+        config_set(&config, tmp.path(), flags(true, None, true), key, Some(payload.to_string()))","+            .unwrap();","+        let mode = std::fs::metadata(&config_path)","+            .unwrap()","+            .permissions()","+            .mode()","+            & 0o777;","+        assert_eq!(mode, 0o600, \"new config.yaml for {key} got mode {mode:o}\");","+","+        // Tightens an existing world-readable config.yaml and keeps 0600 on later edits.","+        std::fs::set_permissions(&config_path, std::fs::Permissions::from_mode(0o644)).unwrap();","+        config_set(&config, tmp.path(), flags(true, None, true), key, Some(payload.to_string()))","+            .unwrap();","+        let tightened = std::fs::metadata(&config_path)","+            .unwrap()","+            .permissions()","+            .mode()","+            & 0o777;","+        assert_eq!(tightened, 0o600, \"existing 0644 config.yaml for {key} got {tightened:o}\");","+","+        config_set(&config, tmp.path(), flags(true, None, false), \"store-dir\", Some(\"/s\".into()))","+            .unwrap();","+        let preserved = std::fs::metadata(&config_path)","+            .unwrap()","+            .permissions()","+            .mode()","+            & 0o777;","+        assert_eq!(preserved, 0o600, \"subsequent edit for {key} changed mode to {preserved:o}\");","+    }","+}"],"additions":518,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config/values.rs","lines":["@@ -102,7 +102,12 @@ pub(super) fn validate_yaml_config_key(key: &str) -> Result<String, ConfigError>","     if config_types::is_config_file_key(&kebab) {","   