on::RemoteExpr;"," use databend_common_meta_app::principal::OnErrorMode;"," use databend_common_pipeline::core::InputError;"," use databend_common_storage::CopyStatus;","@@ -26,20 +27,22 @@ use databend_common_storage::FileStatus;"," "," type OnErrorMap = Arc<DashMap<String, HashMap<u16, InputError>>>;"," ","-pub struct CopyState {","-    on_error_map: RwLock<Option<OnErrorMap>>,","-    on_error_mode: RwLock<Option<OnErrorMode>>,","-    copy_status: Arc<CopyStatus>,","+/// The options of the running COPY, set while the query is planned and read while it runs.","+#[derive(Default)]","+struct CopySettings {","+    on_error_map: Option<OnErrorMap>,","+    on_error_mode: Option<OnErrorMode>,","+    /// The cluster key of a COPY with `SORTED_BY_CLUSTER_KEY = TRUE`: when set, each input file's","+    /// order is preserved.","+    file_sort_keys: Option<Arc<[RemoteExpr<String>]>>,"," }"," ","-impl Default for CopyState {","-    fn default() -> Self {","-        Self {","-            on_error_map: RwLock::new(None),","-            on_error_mode: RwLock::new(None),","-            copy_status: Default::default(),","-        }","-    }","+#[derive(Default)]","+pub struct CopyState {","+    settings: RwLock<CopySettings>,","+    // Updated for every chunk by the decoding threads, so it keeps its own concurrent map","+    // instead of sharing the lock of the settings.","+    copy_status: Arc<CopyStatus>,"," }"," "," impl CopyState {","@@ -52,19 +55,29 @@ impl CopyState {","     }"," ","     pub fn set_on_error_map(&self, map: OnErrorMap) {","-        *self.on_error_map.write().unwrap() = Some(map);","+        self.settings.write().unwrap().on_error_map = Some(map);","     }"," ","     pub fn get_on_error_map(&self) -> Option<OnErrorMap> {","-        self.on_error_map.read().unwrap().as_ref().cloned()","+        self.settings.read().unwrap().on_error_map.clone()","     }"," ","     pub fn get_on_error_mode(&self) -> Option<OnErrorMode> {","-        self.on_error_mode.read().unwrap().clone()","+        self.settings.read().unwrap().on_error_mode.clone()","     }"," ","     pub fn set_on_error_mode(&self, mode: OnErrorMode) {","-        *self.on_error_mode.write().unwrap() = Some(mode);","+        self.settings.write().unwrap().on_error_mode = Some(mode);","+    }","+","+    pub fn set_file_sort_keys(&self, keys: Option<Vec<RemoteExpr<String>>>) {","+        self.settings.write().unwrap().file_sort_keys = keys.map(Into::into);","+    }","+","+    /// The cluster key of the running COPY, if `SORTED_BY_CLUSTER_KEY` requires preserving the","+    /// input order.","+    pub fn get_file_sort_keys(&self) -> Option<Arc<[RemoteExpr<String>]>> {","+        self.settings.read().unwrap().file_sort_keys.clone()","     }"," ","     pub fn get_maximum_error_per_file(&self) -> Option<HashMap<String, ErrorCode>> {"],"additions":29,"deletions":16,"truncated":false},{"path":"src/query/expression/src/utils/mod.rs","lines":["@@ -23,6 +23,7 @@ pub mod display;"," pub mod filter_helper;"," pub(crate) mod json_path_transform;"," pub mod serialize;","+pub mod sort_key_order;"," pub mod udf_client;"," pub mod variant_transform;"," pub mod visitor;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/query/expression/src/utils/sort_key_order.rs","lines":["@@ -0,0 +1,189 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+//! Evaluates and compares declared sort keys, ascending with NULLs last, which is the order a","+//! linear cluster key sorts by.","+//!","+//! Only the first and last rows of each block are checked, which makes the check cheap and","+//! repeatable. Disorder between them goes unnoticed. It never changes the loaded data, because","+//! blocks are sorted again and their statistics recomputed on write, but it makes the blocks","+//! written from that range overlap: one wider block, or several overlapping ones when the range","+//! is split to the target block size.","+","+use std::cmp::Ordering;","+","+use databend_common_exception::ErrorCode;","+use databend_common_exception::Result;","+","+use crate::Column;","+use crate::ColumnRef;","+use crate::DataBlock;","+use crate::DataSchema;","+use crate::Evaluator;","+use crate::Expr;","+use crate::FunctionContext;","+use crate::RemoteExpr;","+use crate::Scalar;","+use crate::function::FunctionRegistry;","+use crate::type_check::check_cast;","+","+/// The sort key values of one row.","+pub type SortKeyRow = Vec<Scalar>;","+","+/// Evaluates declared sort keys, bound to target table columns by name, on blocks of a","+/// source schema whose column types may differ from the table's.","+#[derive(Clone)]","+pub struct SortKeyEvaluator {","+    /// Expressions over the source block that produce the key inputs in the table types.","+    inputs: Vec<Expr>,","+    /// The sort keys, over the key input block.","+    keys: Vec<Expr>,","+    func_ctx: FunctionContext,","+}","+","+impl SortKeyEvaluator {","+    pub fn try_create(","+        keys: &[RemoteExpr<String>],","+        source_schema: &DataSchema,","+        func_ctx: FunctionContext,","+        registry: &FunctionRegistry,","+    ) -> Result<Self> {","+        let mut input_names: Vec<String> = Vec::new();","+        let mut inputs = Vec::new();","+        let mut key_exprs = Vec::with_capacity(keys.len());","+        for key in keys {","+            let expr = key.as_expr(registry);","+            let mut column_refs = expr.column_refs().into_iter().collect::<Vec<_>>();","+            column_refs.sort_by(|a, b| a.0.cmp(&b.0));","+            for (name, data_type) in column_refs {","+                if input_names.contains(&name) {","+                    continue;","+                }","+                let offset = find_field(source_schema, &name)?;","+                let source_type = source_schema.field(offset).data_type().clone();","+                let column = Expr::ColumnRef(ColumnRef {","+                    span: None,","+                    id: offset,","+                    data_type: source_type.clone(),","+                    display_name: name.clone(),","+                });","+                // The same cast as the one that brings the source to the table schema later.","+                let input = check_cast(None, false, column, &data_type, registry)?;","+                input_names.push(name);","+                inputs.push(input);","+            }","+            key_exprs.push(expr.project_column_ref(|name| {","+                Ok(input_names","+                    .iter()","+                    .position(|input| input == name)","+                    .expect(\"column ref must be collected\"))","+            })?);","+        }","+        Ok(Self {","+            inputs,","+            keys: key_exprs,","+            func_ctx,","+        })","+    }","+","+    pub fn num_keys(&self) -> usize {","+        self.keys.len()","+    }","+","+    /// Returns the sort keys of the first and the last rows of `block`, if it has rows.","+    pub fn boundary_keys(","+        &self,","+        block: &DataBlock,","+        registry: &FunctionRegistry,","+    ) -> Result<Option<(SortKeyRow, SortKeyRow)>> {","+        let num_rows = block.num_rows();","+        if num_rows == 0 {","+            return Ok(None);","+        }","+        let rows = [0, (num_rows - 1) as u32];","+        let keys = self.eval(&block.take(rows.as_slice())?, registry)?;","+        Ok(Some((sort_key_row(&keys, 0), sort_key_row(&keys, 1))))","+    }","+","+    /// Evaluates the sort key columns of `block`.","+    pub fn eval(&self, block: &DataBlock, registry: &FunctionRegistry) -> Result<Vec<Column>> {","+        let num_rows = block.num_rows();","+        let evaluator = Evaluator::new(block, &self.func_ctx, registry);","+        let mut entries = Vec::with_capacity(self.inputs.len());","+        for input in &self.inputs {","+            let value = evaluator.run(input)?;","+            entries.push(value.into_full_column(input.data_type(), num_rows).into());","+        }","+        let input_block = DataBlock::new(entries, num_rows);","+        let evaluator = Evaluator::new(&input_block, &self.func_ctx, registry);","+        self.keys","+            .iter()","+            .map(|key| {","+                let value = evaluator.run(key)?;","+                Ok(value.into_full_column(key.data_type(), num_rows))","+            })","+            .collect()","+    }","+}","+","+fn find_field(schema: &DataSchema, name: &str) -> Result<usize> {","+    let fields = schema.fields();","+    fields","+        .iter()","+        .position(|field| field.name() == name)","+        .or_else(|| {","+            // Matches the binder, which refers to the source columns by lowercase name.","+            let name = name.to_lowercase();","+            fields","+                .iter()","+                .position(|field| field.name().to_lowercase() == name)","+        })","+        .ok_or_else(|| {","+            ErrorCode::Internal(format!(","+                \"sort key column `{name}` is missing from the input schema\"","+            ))","+        })","+}","+","+/// Compares two key rows, ascending with NULLs last.","+pub fn compare_sort_key_rows(left: &[Scalar], right: &[Scalar]) -> Ordering {","+    for (l, r) in left.iter().zip(right.iter()) {","+        let ordering = l.as_ref().cmp(&r.as_ref());","+        if ordering != Ordering::Equal {","+            return ordering;","+        }",