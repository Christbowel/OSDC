n string, req *http.Request, verifier authnlib.Verifier[authnlib.AccessTokenClaims], keys authnlib.KeyRetriever) (*authnlib.Claims[authnlib.AccessTokenClaims], error) {","+\tclaims, err := verifier.Verify(ctx, token)","+\tif !errors.Is(err, authnlib.ErrInvalidAudience) || keys == nil {","+\t\treturn claims, err","+\t}","+\tgroup := utils.APIGroupFromRequest(req)","+\tif group == \"\" {","+\t\treturn nil, err","+\t}","+\taudiences := []string{group}","+\tif isDatasourceGroup(group) {","+\t\taudiences = append(audiences, datasourceAudience)","+\t}","+\treturn authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: audiences}, keys).Verify(ctx, token)","+}","+","+// isDatasourceGroup reports whether group is <type>.datasource.grafana.app for","+// a single-segment type. The shared datasource.grafana.app group is not one.","+func isDatasourceGroup(group string) bool {","+\tdatasourceType, ok := strings.CutSuffix(group, \".datasource.grafana.app\")","+\treturn ok && datasourceType != \"\" && !strings.Contains(datasourceType, \".\")","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"pkg/services/authn/access_token_test.go","lines":["@@ -0,0 +1,95 @@","+package authn","+","+import (","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"encoding/json\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-jose/go-jose/v4\"","+\t\"github.com/go-jose/go-jose/v4/jwt\"","+\tauthnlib \"github.com/grafana/authlib/authn\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestIsDatasourceGroup(t *testing.T) {","+\tfor group, want := range map[string]bool{","+\t\t\"loki.datasource.grafana.app\":                          true,","+\t\t\"grafana-postgresql-datasource.datasource.grafana.app\": true,","+\t\t\"datasource.grafana.app\":                               false,","+\t\t\".datasource.grafana.app\":                              false,","+\t\t\"foo.bar.datasource.grafana.app\":                       false,","+\t\t\"folder.grafana.app\":                                   false,","+\t\t\"example-aisdk-app\":                                    false,","+\t\t\"\":                                                     false,","+\t} {","+\t\trequire.Equal(t, want, isDatasourceGroup(group), group)","+\t}","+}","+","+func TestVerifyAccessTokenForRequest(t *testing.T) {","+\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err)","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\trequire.NoError(t, json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &key.PublicKey, KeyID: \"test-key\", Algorithm: string(jose.ES256), Use: \"sig\"}}}))","+\t}))","+\tdefer server.Close()","+\tkeys := authnlib.NewKeyRetriever(authnlib.KeyRetrieverConfig{SigningKeysURL: server.URL})","+\tverifier := authnlib.NewAccessTokenVerifier(authnlib.VerifierConfig{AllowedAudiences: []string{\"grafana\"}}, keys)","+","+\tsign := func(exp time.Time, audiences ...string) string {","+\t\tt.Helper()","+\t\tsigner, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.ES256, Key: key}, (&jose.SignerOptions{}).WithType(jose.ContentType(authnlib.TokenTypeAccess)).WithHeader(\"kid\", \"test-key\"))","+\t\trequire.NoError(t, err)","+\t\ttoken, err := jwt.Signed(signer).Claims(jwt.Claims{","+\t\t\tSubject: \"access-policy:example\", Audience: audiences, Expiry: jwt.NewNumericDate(exp),","+\t\t}).Claims(authnlib.AccessTokenClaims{Namespace: \"stacks-1\"}).Serialize()","+\t\trequire.NoError(t, err)","+\t\treturn token","+\t}","+\tvalid := time.Now().Add(time.Minute)","+\tconst lokiPath = \"/apis/loki.datasource.grafana.app/v0alpha1/namespaces/stacks-1/datasources\"","+","+\tfor _, tc := range []struct {","+\t\tname  string","+\t\ttoken string","+\t\tpath  string","+\t\tkeys  authnlib.KeyRetriever","+\t\terr   error","+\t}{","+\t\t{name: \"configured audience, any path\", token: sign(valid, \"grafana\"), path: \"/api/user\", keys: keys},","+\t\t{name: \"configured audience, api group path\", token: sign(valid, \"grafana\"), path: \"/apis/folder.grafana.app/v1/folders\", keys: keys},","+\t\t{name: \"app plugin audience, its group\", token: sign(valid, \"example-aisdk-app\"), path: \"/apis/example-aisdk-app/v1\", keys: keys},","+\t\t{name: \"datasource plugin audience, its group\", token: sign(valid, \"github-datasource\"), path: \"/apis/github-datasource/v1\", keys: keys},","+\t\t{name: \"plugin audience, other plugin\", token: sign(valid, \"example-aisdk-app\"), path: \"/apis/github-datasource/v1\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"plugin audience, non-canonical path\", token: sign(valid, \"example-aisdk-app\"), path: \"/apis/example-aisdk-app/../github-datasource/v1\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"group audience, its group\", token: sign(valid, \"folder.grafana.app\"), path: \"/apis/folder.grafana.app/v1/folders\", keys: keys},","+\t\t{name: \"group audience among others\", token: sign(valid, \"iam.grafana.app\", \"folder.grafana.app\"), path: \"/apis/folder.grafana.app/v1/folders\", keys: keys},","+\t\t{name: \"group audience, other group\", token: sign(valid, \"iam.grafana.app\"), path: \"/apis/folder.grafana.app/v1/folders\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"group audience, not an api path\", token: sign(valid, \"folder.grafana.app\"), path: \"/api/folders\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"group audience, discovery\", token: sign(valid, \"folder.grafana.app\"), path: \"/apis\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"group audience, non-canonical path\", token: sign(valid, \"folder.grafana.app\"), path: \"/apis/folder.grafana.app/../iam.grafana.app/v0alpha1/whoami\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"group audience without keys\", token: sign(valid, \"folder.grafana.app\"), path: \"/apis/folder.grafana.app/v1/folders\", err: authnlib.ErrInvalidAudience},","+\t\t{name: \"expired group audience\", token: sign(time.Now().Add(-2*time.Minute), \"folder.grafana.app\"), path: \"/apis/folder.grafana.app/v1/folders\", keys: keys, err: authnlib.ErrExpiredToken},","+\t\t{name: \"datasource audience, a datasource group\", token: sign(valid, datasourceAudience), path: lokiPath, keys: keys},","+\t\t{name: \"datasource group audience, its group\", token: sign(valid, \"loki.datasource.grafana.app\"), path: lokiPath, keys: keys},","+\t\t{name: \"datasource audience, another group\", token: sign(valid, datasourceAudience), path: \"/apis/folder.grafana.app/v1/folders\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t\t{name: \"datasource audience, the shared datasource group\", token: sign(valid, datasourceAudience), path: \"/apis/datasource.grafana.app/v0alpha1/namespaces/stacks-1/datasources\", keys: keys, err: authnlib.ErrInvalidAudience},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\treq := httptest.NewRequest(http.MethodGet, tc.path, nil)","+\t\t\tclaims, err := VerifyAccessTokenForRequest(t.Context(), tc.token, req, verifier, tc.keys)","+\t\t\tif tc.err != nil {","+\t\t\t\trequire.ErrorIs(t, err, tc.err)","+\t\t\t\trequire.Nil(t, claims)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, \"access-policy:example\", claims.Subject)","+\t\t})","+\t}","+}"],"additions":95,"deletions":0,"truncated":false},{"path":"pkg/services/authn/clients/ext_jwt.go","lines":["@@ -90,6 +90,7 @@ func ProvideExtendedJWTWithPluginAuth(cfg *setting.Cfg, tracer trace.Tracer, plu"," \t\tlog:                 logger,"," \t\tnamespaceMapper:     request.GetNamespaceMapper(cfg),"," \t\taccessTokenVerifier: accessTokenVerifier,","+\t\taccessTokenKeys:     keys,"," \t\tidTokenVerifier:     idTokenVerifier,"," \t\ttracer:              tracer,"," \t}","@@ -102,6 +103,7 @@ type ExtendedJWT struct {"," \tlocalKeys   