{"id":"261042baa696a1412816508e6189587606bc64a7","axis":"silent","repo":"vllm-project/vllm","sha":"261042baa696a1412816508e6189587606bc64a7","parsed":{"files":[{"path":"tests/v1/core/test_encoder_cache_manager.py","lines":["@@ -7,6 +7,7 @@"," from vllm.v1.core.encoder_cache_manager import (","     EncoderCacheManager,","     EncoderDecoderCacheManager,","+    compute_mm_encoder_budget,"," )"," "," pytestmark = pytest.mark.cpu_test","@@ -505,3 +506,64 @@ def test_encoder_decoder_cache_manager_reset_allows_fresh_allocations():"," ","     assert manager.num_free_slots == 2","     assert \"img2\" in manager.allocated","+","+","+# ------------------ encoder_cache_size configuration ------------------ #","+def _scheduler_config(**kwargs):","+    from vllm.config.scheduler import SchedulerConfig","+","+    return SchedulerConfig(max_model_len=16384, is_encoder_decoder=False, **kwargs)","+","+","+def test_encoder_cache_size_defaults_to_max_num_batched_tokens():","+    config = _scheduler_config(max_num_batched_tokens=16384)","+    assert config.encoder_cache_size == 16384","+","+    compute_budget, cache_size = compute_mm_encoder_budget(config, {\"image\": 2048})","+    assert (compute_budget, cache_size) == (16384, 16384)","+","+","+def test_encoder_cache_size_is_independent_of_the_compute_budget():","+    config = _scheduler_config(max_num_batched_tokens=16384, encoder_cache_size=65536)","+","+    compute_budget, cache_size = compute_mm_encoder_budget(config, {\"image\": 2048})","+    # The per-step compute budget must not move with the cache capacity.","+    assert compute_budget == 16384","+    assert cache_size == 65536","+","+","+def test_encoder_cache_size_is_floored_to_the_largest_item():","+    config = _scheduler_config(max_num_batched_tokens=16384, encoder_cache_size=100)","+","+    _, cache_size = compute_mm_encoder_budget(config, {\"image\": 2048, \"video\": 512})","+    # Otherwise a single item could never be admitted.","+    assert cache_size == 2048","+","+","+def test_encoder_cache_size_rejects_non_positive_values():","+    with pytest.raises(ValueError):","+        _scheduler_config(max_num_batched_tokens=16384, encoder_cache_size=0)","+","+","+def test_capacity_decides_whether_reuse_survives_another_request():","+    \"\"\"One item's encoder output is reusable by a later request only while it fits.\"\"\"","+    req_a = MockRequest(\"r1\", [\"imgA\"], [4])","+    req_b = MockRequest(\"r2\", [\"imgB\"], [4])","+    req_a_again = MockRequest(\"r3\", [\"imgA\"], [4])","+","+    # Room for both items: imgA survives imgB and the third request reuses it.","+    roomy = EncoderCacheManager(cache_size=8)","+    for req in (req_a, req_b):","+        assert roomy.can_allocate(req, 0, int(1e9), 0)","+        roomy.allocate(req, 0)","+        roomy.free_encoder_input(req, 0)","+    assert roomy.check_and_update_cache(req_a_again, 0)","+","+    # Room for one: admitting imgB evicts imgA, so the third request must re-encode.","+    tight = EncoderCacheManager(cache_size=4)","+    tight.allocate(req_a, 0)","+    tight.free_encoder_input(req_a, 0)","+    assert tight.can_allocate(req_b, 0, int(1e9), 0)","+    tight.allocate(req_b, 0)","+    tight.free_encoder_input(req_b, 0)","+    assert not tight.check_and_update_cache(req_a_again, 0)"],"additions":62,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_encoder_runner.py","lines":["@@ -30,6 +30,7 @@"," from vllm.v1.worker.gpu.mm.encoder_cache import EncoderCache"," from vllm.v1.worker.gpu.mm.encoder_runner import EncoderRunner"," from vllm.v1.worker.gpu.model_states.interface import ModelState","+from vllm.v1.worker.utils import reserve_encoder_cache_residency"," "," pytestmark = pytest.mark.cpu_test"," ","@@ -474,3 +475,37 @@ def test_consumed_cpu_input_releases_storage_before_request_finishes():","     cache.update_encoder_inputs(\"a\", {0: None})","     assert ref() is None","     assert \"a\" in cache.mm_features","+","+","+# ------------------ encoder cache residency profiling ------------------ #","+def _dummy_outputs(num_items: int, tokens: int, hidden: int = 16):","+    return [torch.zeros(tokens, hidden, dtype=torch.bfloat16) for _ in range(num_items)]","+","+","+def test_residency_reservation_covers_the_cache_shortfall():","+    \"\"\"The dummy batch only covers the compute budget; the cache may hold more.\"\"\"","+    cache: dict[str, torch.Tensor] = {}","+    outputs = _dummy_outputs(num_items=2, tokens=100)","+","+    cache_bytes = reserve_encoder_cache_residency(cache, outputs, 1000)","+","+    # 1000 tokens of capacity, 200 already resident in the dummy outputs.","+    assert cache[\"tmp_residency\"].shape == (800, 16)","+    assert cache[\"tmp_residency\"].dtype == torch.bfloat16","+    assert cache_bytes == 1000 * 16 * 2","+","+","+def test_residency_reservation_is_a_noop_when_the_batch_already_fills_the_cache():","+    cache: dict[str, torch.Tensor] = {}","+    outputs = _dummy_outputs(num_items=2, tokens=100)","+","+    cache_bytes = reserve_encoder_cache_residency(cache, outputs, 200)","+","+    assert cache == {}","+    assert cache_bytes == 200 * 16 * 2","+","+","+def test_residency_reservation_tolerates_no_dummy_outputs():","+    cache: dict[str, torch.Tensor] = {}","+    assert reserve_encoder_cache_residency(cache, [], 1000) == 0","+    assert cache == {}"],"additions":35,"deletions":0,"truncated":false},{"path":"vllm/config/scheduler.py","lines":["@@ -175,12 +175,22 @@ class SchedulerConfig:","     NOTE: This is not currently configurable. It will be overridden by","     max_num_batched_tokens in case max multimodal embedding size is larger.\"\"\""," ","-    # TODO (ywang96): Make this configurable.","-    encoder_cache_size: int = Field(init=False)","-    \"\"\"Multimodal encoder cache size, only used in V1.","+    encoder_cache_size: int | None = Field(default=None, ge=1)","+    \"\"\"Multimodal encoder cache size in tokens, only used in V1, or None to","+    derive it from `max_num_batched_tokens`."," ","-    NOTE: This is not currently configurable. It will be overridden by","-    max_num_batched_tokens in case max multimodal embedding size is larger.\"\"\"","+    This is a *capacity*: how many tokens of encoder output may stay resident,","+    including across requests, so a later request reusing the same image can skip","+    the encoder. It is unrelated to how much encoder work one step may do","+    (`max_num_encoder_input_tokens`), and deriving it from a per-step batch budget","+    caps cross-request reuse at `max_num_batched_tokens / tokens_per_item` items.","+    Size it as `in_flight_items * tokens_per_item` when a workload sends several","+    requests against the same image.","+","+    Raised to the largest single item if that would not fit. Costs GPU memory at","+    the model's multimodal embedding width, which is taken from the KV cache.","+","+    Resolved in `__post_init__`; never None afterwards.\"\"\""," ","     policy: SchedulerPolicy = \"fcfs\"","     \"\"\"The scheduling policy to use:","@@ -362,7 +372,8 @@ def __post_init__(self, max_model_len: int, is_encoder_decoder: bool) -> None:","             )"," ","         self.max_num_encoder_input_tokens = self.max_num_batched_tokens","-        self.encoder_cache_size = self.max_num_batched_tokens","+        if self.encoder_cache_size is None:","+            self.encoder_cache_size = self.max_num_batched_tokens"," ","         if self.enable_chunked_prefill:","             logger.info_once("],"additions":17,"deletions":6,"truncated":false},{"path":"vllm/engine/arg_utils.py","lines":["@@ -718,6 +718,7 @@ class EngineArgs:"," ","     enable_chunked_prefill: bool | None = None","     disable_chunked_mm_input: bool = SchedulerConfig.disable_chunked_mm_input","+    encoder_cache_size: int | None = None"," ","     scheduler_reserve_full_isl: bool = SchedulerConfig.scheduler_reserve_full_isl","     prefill_schedule_interval: int = SchedulerConfig.prefill_schedule_interval","@@ -1828,6 +1829,9 @@ def add_cli_args(parser: FlexibleArgumentParser) -> FlexibleArgumentParser:","         scheduler_group.add_argument(","             \"--disable-chunked-mm-input\", **scheduler_kwargs[\"disable_chunked_mm_input\"]","         )","+        scheduler_group.add_argument(","+            \"--encoder-cache-size\", **scheduler_kwargs[\"encoder_cache_size\"]","+        )","         scheduler_group.add_argument(","             \"--scheduler-cls\", **scheduler_kwargs[\"scheduler_cls\"]","         )","@@ -2725,6 +2729,7 @@ def create_engine_config(","             max_model_len=model_config.max_model_len,","             enable_chunked_prefill=self.enable_chunked_prefill,","             disable_chunked_mm_input=self.disable_chunked_mm_input,","+            encoder_cache_size=self.encoder_cache_size,","             is_multimodal_model=model_config.is_multimodal_model,","             is_encoder_decoder=model_config.is_encoder_decoder,","             policy=self.scheduling_policy,"],"additions":5,"deletions":0,"truncated":false},{"path":"vllm/v1/core/encoder_cache_manager.py","lines":["@@ -369,9 +369,18 @@ def compute_mm_encoder_budget(","     encoder_compute_budget = max(","         scheduler_config.max_num_encoder_input_tokens, max_tokens_per_mm_item","     )","-    encoder_cache_size = max(","-        scheduler_config.encoder_cache_size, max_tokens_per_mm_item","+    # None when a config was built without `__post_init__` resolution.","+    requested_cache_size = (","+        scheduler_config.encoder_cache_size or scheduler_config.max_num_batched_tokens","     )","+    encoder_cache_size = max(requested_cache_size, max_tokens_per_mm_item)","+    if encoder_cache_size > requested_cache_size:","+        logger.warning(","+            \"Raising encoder_cache_size from %d to %d tokens so one %s item fits.\",","+            requested_cache_size,","+            encoder_cache_size,","+            max(mm_max_toks_per_item, key=lambda m: mm_max_toks_per_item[m]),","+        )"," ","     return encoder_compute_budget, encoder_cache_size"," "],"additions":11,"deletions":2,"truncated":false},{"path":"vllm/v1/worker/cpu/encoder_runner.py","lines":["@@ -21,6 +21,7 @@"," from vllm.v1.worker.cpu.encoder_cache import EncoderCache"," from vllm.v1.worker.utils import (","     EncoderTimingStats,","+    reserve_encoder_cache_residency,","     sanity_check_mm_encoder_outputs,"," )"," ","@@ -109,6 +110,11 @@ def profile_encoder_cache(","         self.encoder_cache.encoder_outputs.update(","             (f\"tmp_{i}\", output) for i, output in enumerate(dummy_encoder_outputs)","         )","+        reserve_encoder_cache_residency(","+            self.encoder_cache.encoder_outputs,","+            dummy_encoder_outputs,","+            budget.encoder_cache_size,","+        )"," ","     @torch.inference_mode()","     def execute_mm_encoder("],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/v1/worker/gpu/mm/encoder_runner.py","lines":["@@ -18,10 +18,12 @@","     group_and_batch_mm_kwargs,","     set_mm_embedding_modality,"," )","+from vllm.utils.mem_utils import format_gib"," from vllm.utils.torch_utils import PIN_MEMORY, async_tensor_h2d"," from vllm.v1.worker.gpu.mm.encoder_cache import EncoderCache"," from vllm.v1.worker.utils import (","     EncoderTimingStats,","+    reserve_encoder_cache_residency,","     sanity_check_mm_encoder_outputs,"," )"," ","@@ -145,6 +147,18 @@ def profile_encoder_cache(","         self.encoder_cache.encoder_outputs.update(","             (f\"tmp_{i}\", output) for i, output in enumerate(dummy_encoder_outputs)","         )","+        cache_bytes = reserve_encoder_cache_residency(","+            self.encoder_cache.encoder_outputs,","+            dummy_encoder_outputs,","+            budget.encoder_cache_size,","+        )","+        logger.info_once(","+            \"Encoder cache can hold %s tokens of %s embeddings across requests \"","+            \"(%s GiB, taken from the KV cache).\",","+            budget.encoder_cache_size,","+            dummy_modality,","+            format_gib(cache_bytes),","+        )"," ","     @torch.inference_mode()","     def execute_mm_encoder("],"additions":14,"deletions":0,"truncated":false},{"path":"vllm/v1/worker/utils.py","lines":["@@ -768,6 +768,30 @@ def sanity_check_mm_encoder_outputs(","     )"," "," ","+def reserve_encoder_cache_residency(","+    encoder_outputs: dict[str, torch.Tensor],","+    dummy_outputs: Sequence[torch.Tensor],","+    encoder_cache_size: int,","+) -> int:","+    \"\"\"Reserve the encoder cache's resident footprint during profiling, in bytes.","+","+    The dummy run only materialises one compute batch, so a cache larger than the","+    compute budget would be under-reserved and the surplus handed to the KV cache.","+    \"\"\"","+    if not dummy_outputs:","+        return 0","+","+    # `sanity_check_mm_encoder_outputs` guarantees 2-D (tokens, hidden) outputs.","+    ref = dummy_outputs[0]","+    bytes_per_token = ref.element_size() * ref.shape[1]","+    shortfall = encoder_cache_size - sum(out.shape[0] for out in dummy_outputs)","+    if shortfall > 0:","+        encoder_outputs[\"tmp_residency\"] = torch.empty(","+            (shortfall, ref.shape[1]), dtype=ref.dtype, device=ref.device","+        )","+    return encoder_cache_size * bytes_per_token","+","+"," def request_memory(","     init_snapshot: MemorySnapshot,","     cache_config: CacheConfig,",""],"additions":24,"deletions":0,"truncated":false}],"additions":174,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-15T15:51:27.819112+00:00"}