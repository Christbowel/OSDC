+}","+","+TEST_CASE(\"Test ToString of doubles\", \"[string_util]\") {","+\tREQUIRE(StringUtil::ToString(10.0) == \"10.000000\");","+\tREQUIRE(StringUtil::ToString(-2.25) == \"-2.250000\");","+\tREQUIRE(StringUtil::ToString(1.0 / 3.0) == \"0.333333\");","+\tREQUIRE(StringUtil::ToString(1e20) == \"100000000000000000000.000000\");"," }"," "," TEST_CASE(\"Test CIHash is independent of char signedness\", \"[string_util]\") {"],"additions":8,"deletions":0,"truncated":false},{"path":"test/issues/general/test_27102.test","lines":["@@ -0,0 +1,159 @@","+# name: test/issues/general/test_27102.test","+# description: Issue 27102: fmod returns the exact floored remainder for large quotients","+# group: [general]","+","+query RRRRRR","+SELECT fmod(1e16, 3.0), fmod(-1e16, 3.0), fmod(1e16, -3.0), fmod(-1e16, -3.0), fmod(1e300, 7.0), fmod(-1e-300, 3)","+----","+1.0\t2.0\t-2.0\t-1.0\t1.0\t3.0","+","+# remainders use the stored DOUBLE values","+query III","+SELECT fmod(6.0, 0.2)::VARCHAR, fmod(-6.0, 0.2)::VARCHAR, fmod(1e308, 1e-308)::VARCHAR","+----","+0.19999999999999968\t3.3306690738754696e-16\t3.498445546245627e-309","+","+statement ok","+CREATE TABLE vals AS SELECT * FROM (VALUES (1e16::DOUBLE, 3), (1e16, -3), (-1e16, 3), (10, 3), (10, -3), (-10, 3), (-10, -3), (NULL, 3), (10, NULL)) t(x, y)","+","+query R","+SELECT fmod(x, y) FROM vals","+----","+1.0","+-2.0","+2.0","+1.0","+-2.0","+2.0","+-1.0","+NULL","+NULL","+","+# FLOAT arguments are computed and returned as FLOAT, all other numeric arguments as DOUBLE","+query IIIIII","+SELECT typeof(fmod(10::FLOAT, 3::FLOAT)), typeof(fmod(10::FLOAT, 3)), typeof(fmod(10, 3)), typeof(fmod(10.5, 3)), typeof(fmod(10::HUGEINT, 3)), typeof(fmod(10::FLOAT, 3::DOUBLE))","+----","+FLOAT\tFLOAT\tDOUBLE\tDOUBLE\tDOUBLE\tDOUBLE","+","+query RR","+SELECT fmod(1e16::FLOAT, 3::FLOAT), fmod(-10::FLOAT, 3::FLOAT)","+----","+2.0\t2.0","+","+# an exact zero remainder is a positive zero","+query IIII","+SELECT fmod(-6.0, 3)::VARCHAR, fmod(6.0, -3)::VARCHAR, fmod(-6::FLOAT, 3::FLOAT)::VARCHAR, fmod(6::FLOAT, -3::FLOAT)::VARCHAR","+----","+0.0\t0.0\t0.0\t0.0","+","+# each argument is evaluated once","+statement ok","+CREATE SEQUENCE dividends","+","+statement ok","+CREATE SEQUENCE divisors","+","+query RR","+SELECT fmod(nextval('dividends'), 4), fmod(10, nextval('divisors')) FROM range(4)","+----","+1.0\t0.0","+2.0\t0.0","+3.0\t1.0","+0.0\t2.0","+","+query II","+SELECT currval('dividends'), currval('divisors')","+----","+4\t4","+","+query R","+SELECT fmod(y := 3, x := -10)","+----","+2.0","+","+# infinite divisors keep the dividend, or the divisor when the signs differ","+query RRRR","+SELECT fmod(5, 'inf'::DOUBLE), fmod(-5, 'inf'::DOUBLE), fmod(5, '-inf'::DOUBLE), fmod(-5, '-inf'::DOUBLE)","+----","+5.0\tinf\t-inf\t-5.0","+","+query III","+SELECT isnan(fmod('inf'::DOUBLE, 3)), isnan(fmod('nan'::DOUBLE, 3)), isnan(fmod(3, 'nan'::DOUBLE))","+----","+true\ttrue\ttrue","+","+# with IEEE semantics a zero divisor gives NaN","+query III","+SELECT isnan(fmod(42, 0)), isnan(fmod(42::FLOAT, 0::FLOAT)), isnan(fmod(42, -0.0::DOUBLE))","+----","+true\ttrue\ttrue","+","+statement ok","+CREATE TABLE zero_divisors AS SELECT * FROM (VALUES (5.0::DOUBLE, 0.0::DOUBLE), (5, 2), (NULL, 0)) t(x, y)","+","+statement ok","+CREATE TABLE float_zero_divisors AS SELECT x::FLOAT AS x, y::FLOAT AS y FROM zero_divisors","+","+foreach table zero_divisors float_zero_divisors","+","+query I","+SELECT isnan(fmod(x, y)) FROM {table}","+----","+true","+false","+NULL","+","+endloop","+","+statement ok","+SET ieee_floating_point_ops=false;","+","+statement error","+SELECT fmod(42, 0)","+----","+Division by zero","+","+statement error","+SELECT fmod(42::FLOAT, 0::FLOAT)","+----","+Division by zero","+","+statement error","+SELECT fmod(42, -0.0::DOUBLE)","+----","+Division by zero","+","+foreach table zero_divisors float_zero_divisors","+","+statement error","+SELECT fmod(x, y) FROM {table}","+----","+Division by zero","+","+query R","+SELECT TRY(fmod(x, y)) FROM {table}","+----","+NULL","+1.0","+NULL","+","+endloop","+","+statement ok","+SET error_on_division_by_zero=false;","+","+query RR","+SELECT fmod(42, 0), fmod(42::FLOAT, 0::FLOAT)","+----","+NULL\tNULL","+","+foreach table zero_divisors float_zero_divisors","+","+query R","+SELECT fmod(x, y) FROM {table}","+----","+NULL","+1.0","+NULL","+","+endloop"],"additions":159,"deletions":0,"truncated":false},{"path":"test/sql/cast/boolean_to_decimal_cast.test","lines":["@@ -0,0 +1,73 @@","+# name: test/sql/cast/boolean_to_decimal_cast.test","+# description: Casting true to a DECIMAL without integer digits fails","+# group: [cast]","+","+# every internal width of a DECIMAL whose width equals its scale","+foreach width 1 4 5 9 10 18 19 38","+","+statement error","+SELECT true::DECIMAL({width}, {width})","+----","+Could not cast value true to DECIMAL(","+","+query II","+SELECT TRY_CAST(true AS DECIMAL({width}, {width})) IS NULL, false::DECIMAL({width}, {width}) = 0","+----","+true\ttrue","+","+endloop","+","+# one integer digit is enough","+query IIIII","+SELECT true::DECIMAL(2,1), true::DECIMAL(5,4), true::DECIMAL(10,9), true::DECIMAL(19,18), true::DECIMAL(38,37)","+----","+1.0\t1.0000\t1.000000000\t1.000000000000000000\t1.0000000000000000000000000000000000000","+","+# more than one vector of true, false and NULL","+statement ok","+CREATE TABLE bools AS SELECT CASE WHEN i % 3 = 0 THEN NULL ELSE i % 3 = 1 END AS b FROM range(5000) t(i);","+","+statement error","+SELECT b::DECIMAL(4,4) FROM bools","+----","+Could not cast value true to DECIMAL(4,4)","+","+query IIIII","+SELECT count(*), count(TRY_CAST(b AS DECIMAL(4,4))), count(TRY_CAST(b AS DECIMAL(18,18))),","+       count(TRY_CAST(b AS DECIMAL(38,38))), sum(TRY_CAST(b AS DECIMAL(9,9))) = 0","+FROM bools","+----","+5000\t1666\t1666\t1666\ttrue","+","+query II","+SELECT count(*), sum(b::DECIMAL(4,4)) = 0 FROM bools WHERE NOT b","+----","+1666\ttrue","+","+query I","+SELECT count(*) FROM bools WHERE b::DECIMAL(4,3) = 1","+----","+1667","+","+# implicit casts on insert","+statement ok","+CREATE TABLE dt (x DECIMAL(2,2));","+","+statement error","+INSERT INTO dt VALUES (true)","+----","+Could not cast value true to DECIMAL(2,2)","+","+statement error","+INSERT INTO dt SELECT b FROM bools","+----","+Could not cast value true to DECIMAL(2,2)","+","+statement ok","+INSERT INTO dt VALUES (false), (NULL)","+","+query I","+SELECT x = 0 FROM dt ORDER BY x NULLS LAST","+----","+true","+NULL"],"additions":73,"deletions":0,"truncated":false},{"path":"test/sql/collate/test_collate_list_has_any_all.test","lines":["@@ -0,0 +1,72 @@","+# name: test/sql/collate/test_collate_list_has_any_all.test","+# description: list_has_any and list_has_all compare the elements under their collation","+# group: [collate]","+","+query IIII","+SELECT list_has_any(['A' COLLATE NOCASE, 'b'], ['B', 'z']), list_has_any(['A', 'b'], ['B' COLLATE NOCASE]),","+\tlist_has_all(['A' COLLATE NOCASE, 'b'], ['a', 'B']), list_has_all(['A', 'b'], ['B' COLLATE NOCASE, 'c'])","+----","+true\ttrue\ttrue\tfalse","+","+# without a collation the comparison stays binary","+query II","+SELECT list_has_any(['A', 'b'], ['a', 'B']), list_has_all(['A', 'b'], ['a'])","+----","+false\tfalse","+","+# combined collations","+query II","+SELECT list_has_any(['héllo'], ['HELLO' COLLATE NOACCENT.NOCASE]), list_has_all(['HÉLLO', 'x'], ['hello' COLLATE NOACCENT.NOCASE])","+----","+true\ttrue","+","+# NULL elements and empty lists","+query IIII","+SELECT list_has_any([NULL, 'BB'], ['bb' COLLATE NOCASE]), list_has_all([NULL, 'BB'], ['bb' COLLATE NOCASE, NULL]),","+\tlist_has_any([]::VARCHAR[], ['a' COLLATE NOCASE]), list_has_all(['A' COLLATE NOCASE], []::VARCHAR[])","+----","+true\ttrue\tfalse\ttrue","+","+# the aliases and operators","+query IIIIII","+SELECT array_has_any(['A' COLLATE NOCASE], ['a']), array_has_all(['A' COLLATE NOCASE], ['a']),","+\t['A' COLLATE NOCASE] && ['a'], ['A' COLLATE NOCASE] @> ['a'], ['a'] <@ ['A' COLLATE NOCASE],","+\t['A'] <@ ['a' COLLATE NOCASE, 'b']","+----","+true\ttrue\ttrue\ttrue\ttrue\ttrue","+","+# an array next to a collated list","+query III","+SELECT list_has_any(['A', 'B']::VARCHAR[2], ['b' COLLATE NOCASE]), list_has_all(['A', 'B']::VARCHAR[2], ['b' COLLATE NOCASE, 'a']),","+\tlist_has_any(['A', 'B']::VARCHAR[2], ['b'])","+----","+true\ttrue\tfalse","+","+# collated fields of a struct, and variant fields of a struct, which compare by value","+query III","+SELECT list_has_any([{'s': 'A' COLLATE NOCASE}], [{'s': 'a'}]),","+\tlist_has_any([{'v': 1::TINYINT::VARIANT}], [{'v': 1::BIGINT::VARIANT}]),","+\tlist_has_all([{'v': 1::TINYINT::VARIANT}, {'v': 'x'::VARIANT}], [{'v': 1::BIGINT::VARIANT}])","+----","+true\ttrue\ttrue","+","+statement error","+SELECT list_has_any(['A' COLLATE NOCASE], ['a' COLLATE NOACCENT])","+----","+Cannot combine types with different collation","+","+# a collated column in a filter, over more than one vector","+statement ok","+CREATE TABLE t AS SELECT i AS id, ['A' || (i % 7), 'B'] AS tags, ('a' || (i % 3))::VARCHAR COLLATE NOCASE AS needle","+FROM range(5000) r(i);","+","+query II","+SELECT count(*) FILTER (WHERE list_has_any(tags, [needle])), count(*) FILTER (WHERE list_has_all(tags, [needle, 'b']))","+FROM t","+----","+716\t716","+","+query I","+SELECT count(*) FROM t WHERE list_has_any(tags, [needle]) = list_contains(tags, needle)","+----","+5000"],"additions":72,"deletions":0,"truncated":false},{"path":"test/sql/function/date/week_parts_minimum_date.test","lines":["@@ -0,0 +1,33 @@","+# name: test/sql/function/date/week_parts_minimum_date.test","+# description: Week-based date parts of dates in the first year, whose January 1 comes before the first date","+# group: [date]","+","+# 5877642 BC repeats the calendar of 359, which is 14695 cycles of 400 years later","+query IIIII","+SELECT weekofyear(d), isoyear(d), yearweek(d), week(d), strftime(d, '%U %W %V')","+FROM (VALUES (DATE '5877642-06-25 (BC)'), (DATE '0359-06-25')) t(d) ORDER BY d;","+----","+26\t-