{"id":"219c298d671069274ede6f848116312ff25ddb83","axis":"silent","repo":"elastic/elasticsearch","sha":"219c298d671069274ede6f848116312ff25ddb83","parsed":{"files":[{"path":"x-pack/plugin/esql/qa/security/src/javaRestTest/java/org/elasticsearch/xpack/esql/EsqlSecurityIntoIT.java","lines":["@@ -7,26 +7,36 @@"," "," package org.elasticsearch.xpack.esql;"," ","+import org.apache.http.HttpStatus;","+import org.apache.http.util.EntityUtils;"," import org.elasticsearch.client.Request;"," import org.elasticsearch.client.RequestOptions;"," import org.elasticsearch.client.Response;","+import org.elasticsearch.client.ResponseException;"," import org.elasticsearch.client.WarningsHandler;"," import org.elasticsearch.common.Strings;","+import org.elasticsearch.common.io.Streams;"," import org.elasticsearch.common.settings.SecureString;"," import org.elasticsearch.common.settings.Settings;"," import org.elasticsearch.common.util.concurrent.ThreadContext;","+import org.elasticsearch.common.xcontent.XContentHelper;"," import org.elasticsearch.test.cluster.ElasticsearchCluster;"," import org.elasticsearch.test.cluster.FeatureFlag;","+import org.elasticsearch.test.cluster.LogType;"," import org.elasticsearch.test.cluster.local.distribution.DistributionType;"," import org.elasticsearch.test.cluster.util.resource.Resource;"," import org.elasticsearch.test.rest.ESRestTestCase;","+import org.elasticsearch.xcontent.XContentType;"," import org.elasticsearch.xcontent.json.JsonXContent;","+import org.elasticsearch.xpack.esql.action.EsqlIntoDestinationAction;"," import org.junit.Before;"," import org.junit.ClassRule;"," "," import java.io.IOException;","+import java.util.ArrayList;"," import java.util.Arrays;"," import java.util.List;","+import java.util.Map;"," "," import static org.elasticsearch.xpack.esql.qa.rest.RestEsqlTestCase.hasCapabilities;"," import static org.hamcrest.Matchers.containsString;","@@ -38,10 +48,17 @@","  * {@code INTO} under real security. Writing the rows needs the {@code write} index privilege, but refreshing the destination","  * afterwards needs {@code maintenance}, which a user who may only write does not have. The destination turns its own refresh off,","  * so the rows can be searched only if {@code INTO} refreshed it.","+ * <p>","+ * A ROW source needs no index privilege, so the destination is authorized by {@code INTO} itself, before anything about it is","+ * reported: a caller who may not write gets the same 403 whether or not the destination exists.","  */"," public class EsqlSecurityIntoIT extends ESRestTestCase {","     private static final String DESTINATION = \"into-dest\";","     private static final String PASSWORD = \"x-pack-test-password\";","+    private static final String EXISTING = \"into-existing\";","+    private static final String READ_ONLY_USER = \"into_read_only_user\";","+    private static final String CREATE_DOC_USER = \"into_create_doc_user\";","+    private static final String CREATE_DOC_ELSEWHERE_USER = \"into_create_doc_elsewhere_user\";"," ","     @ClassRule","     public static ElasticsearchCluster cluster = ElasticsearchCluster.local()","@@ -51,12 +68,16 @@ public class EsqlSecurityIntoIT extends ESRestTestCase {","         .feature(FeatureFlag.BATCH_INDEXING)","         .setting(\"xpack.license.self_generated.type\", \"trial\")","         .setting(\"xpack.security.enabled\", \"true\")","+        .setting(\"xpack.security.audit.enabled\", \"true\")","         .setting(\"indices.batch_indexing\", \"true\")","         .rolesFile(Resource.fromClasspath(\"roles.yml\"))","         .user(\"test-admin\", PASSWORD, \"test-admin\", true)","         .user(\"into_writer\", PASSWORD, \"into_write_only\", false)","         .user(\"into_maintainer\", PASSWORD, \"into_write_and_maintenance\", false)","         .user(\"into_maintainer_elsewhere\", PASSWORD, \"into_write_and_maintenance_elsewhere\", false)","+        .user(READ_ONLY_USER, PASSWORD, \"into_read_only\", false)","+        .user(CREATE_DOC_USER, PASSWORD, \"into_create_doc_only\", false)","+        .user(CREATE_DOC_ELSEWHERE_USER, PASSWORD, \"into_create_doc_elsewhere\", false)","         .build();"," ","     @Override","@@ -135,6 +156,91 @@ public void testWriterWithMaintenanceSeesTheRowsWhenTheQueryReturns() throws IOE","         assertThat(\"INTO refreshed the destination\", countDestination(), equalTo(2L));","     }"," ","+    /**","+     * A caller who may not write to the destination gets a 403 that is the same for an existing and a missing destination, and is told","+     * nothing about the existing one: its ingest pipeline is not reported. That holds for a caller who may only read it, and for one","+     * who may write, but to another index.","+     */","+    public void testDestinationDeniedWithoutWriteAccess() throws IOException {","+        createDestinationWithPipeline();","+","+        assertDenied(READ_ONLY_USER, \"into_read_only\");","+        assertDenied(CREATE_DOC_ELSEWHERE_USER, \"into_create_doc_elsewhere\");","+    }","+","+    private static void assertDenied(String user, String role) throws IOException {","+        ResponseException existing = expectThrows(ResponseException.class, () -> intoDestination(user, EXISTING));","+        ResponseException missing = expectThrows(ResponseException.class, () -> intoDestination(user, \"into-missing\"));","+        String existingBody = EntityUtils.toString(existing.getResponse().getEntity());","+        String missingBody = EntityUtils.toString(missing.getResponse().getEntity());","+        assertThat(existingBody, existing.getResponse().getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_FORBIDDEN));","+        assertThat(missingBody, missing.getResponse().getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_FORBIDDEN));","+        assertDeniedByTheFilter(existingBody, user, role, EXISTING);","+        assertDeniedByTheFilter(missingBody, user, role, \"into-missing\");","+    }","+","+    /** The denial is the one of the security filter, which audits it, and which names the roles and the privileges that grant it. */","+    private static void assertDeniedByTheFilter(String body, String user, String role, String destination) {","+        String action = \"action [\" + EsqlIntoDestinationAction.NAME + \"] is unauthorized for user [test-admin] run as [\";","+        assertThat(body, containsString(action + user + \"] with effective roles [\" + role + \"]\"));","+        assertThat(body, containsString(\"on indices [\" + destination + \"], this action is granted by the index privileges [\"));","+    }","+","+    /** A denied destination is audited as the write that it is: the action of the check, the destination, the caller, and who ran it for them. */","+    public void testDeniedDestinationIsAudited() throws Exception {","+        expectThrows(ResponseException.class, () -> intoDestination(READ_ONLY_USER, \"into-audited\"));","+","+        assertBusy(() -> {","+            try (var auditLog = cluster.getNodeLog(0, LogType.AUDIT)) {","+                List<Map<String, Object>> denials = new ArrayList<>();","+                for (String line : Streams.readAllLines(auditLog)) {","+                    Map<String, Object> event = XContentHelper.convertToMap(XContentType.JSON.xContent(), line, false);","+                    if (\"access_denied\".equals(event.get(\"event.action\"))","+                        && EsqlIntoDestinationAction.NAME.equals(event.get(\"action\"))","+                        && READ_ONLY_USER.equals(event.get(\"user.name\"))","+                    // The cluster is shared with the other tests, which are denied the same action as this user","+                        && List.of(\"into-audited\").equals(event.get(\"indices\"))) {","+                        denials.add(event);","+                    }","+                }","+                assertThat(denials, hasSize(1));","+                assertThat(denials.getFirst().get(\"user.run_by.name\"), equalTo(\"test-admin\"));","+            }","+        });","+    }","+","+    /**","+     * A writer passes the authorization without any read access to the destination, and may then be told what a bulk would tell","+     * them: that the pipeline of the destination cannot be used. A missing destination is an error for them too, as INTO does not","+     * create indices. A writer can write to an existing destination that has no pipeline.","+     */","+    public void testWriterWithoutReadAccessIsAuthorized() throws IOException {","+        createDestinationWithPipeline();","+","+        ResponseException refusal = expectThrows(ResponseException.class, () -> intoDestination(CREATE_DOC_USER, EXISTING));","+        String body = EntityUtils.toString(refusal.getResponse().getEntity());","+        assertThat(body, refusal.getResponse().getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_BAD_REQUEST));","+        assertThat(body, containsString(\"does not support ingest pipelines\"));","+","+        ResponseException missing = expectThrows(ResponseException.class, () -> intoDestination(CREATE_DOC_USER, \"into-missing\"));","+        assertThat(missing.getResponse().getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_NOT_FOUND));","+        assertThat(","+            EntityUtils.toString(missing.getResponse().getEntity()),","+            containsString(\"INTO destination [into-missing] does not exist\")","+        );","+","+        createIndex(","+            adminClient(),","+            \"into-plain\",","+            Settings.builder().put(\"index.batch_indexing\", true).build(),","+            \"\\\"properties\\\": {\\\"x\\\": {\\\"type\\\": \\\"long\\\"}}\"","+        );","+        assertThat(intoDestination(CREATE_DOC_USER, \"into-plain\").getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_OK));","+        assertOK(adminClient().performRequest(new Request(\"POST\", \"into-plain/_refresh\")));","+        Response count = adminClient().performRequest(new Request(\"GET\", \"into-plain/_count\"));","+        assertThat(entityAsMap(count).get(\"count\"), equalTo(1));","+    }","+","     private static Response runInto(String user, String options) throws IOException {","         String query = \"ROW k = [\\\"a\\\", \\\"b\\\"] | MV_EXPAND k | INTO \" + DESTINATION + options;","         Request request = new Request(\"POST\", \"_query\");","@@ -145,6 +251,81 @@ private static Response runInto(String user, String options) throws IOException","         return client().performRequest(request);","     }"," ","+    /** A data stream is a destination too, and has to get through the filter, which leaves data streams out of a request that says so. */","+    public void testWriterCanWriteToADataStream() throws IOException {","+        Request template = new Request(\"PUT\", \"_index_template/into-ds-template\");","+        template.setJsonEntity(\"\"\"","+            {","+              \"index_patterns\": [\"into-ds\"],","+              \"data_stream\": {},","+              \"template\": {","+                \"settings\": {\"index.batch_indexing\": true},","+                \"mappings\": {\"properties\": {\"@timestamp\": {\"type\": \"date\"}, \"x\": {\"type\": \"long\"}}}","+              }","+            }\"\"\");","+        assertOK(adminClient().performRequest(template));","+        assertOK(adminClient().performRequest(new Request(\"PUT\", \"_data_stream/into-ds\")));","+","+        Response response = intoDestination(CREATE_DOC_USER, \"ROW `@timestamp` = TO_DATETIME(\\\"2026-01-01T00:00:00Z\\\"), x = 1\", \"into-ds\");","+        assertThat(response.getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_OK));","+        assertThat(countOf(\"into-ds\"), equalTo(1));","+    }","+","+    public void testWriterCanWriteToAnAliasWithAWriteIndex() throws IOException {","+        createIndex(","+            adminClient(),","+            \"into-alias-index\",","+            Settings.builder().put(\"index.batch_indexing\", true).build(),","+            \"\\\"properties\\\": {\\\"x\\\": {\\\"type\\\": \\\"long\\\"}}\",","+            \"\\\"into-alias\\\": {\\\"is_write_index\\\": true}\"","+        );","+","+        assertThat(intoDestination(CREATE_DOC_USER, \"into-alias\").getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_OK));","+        assertThat(countOf(\"into-alias\"), equalTo(1));","+    }","+","+    /** The alias exists, so the destination check passes. It has nowhere to write, which only the bulk finds out, as it would for a bulk. */","+    public void testAliasWithoutAWriteIndexFailsAtTheBulk() throws IOException {","+        createIndex(","+            adminClient(),","+            \"into-nowrite-index\",","+            Settings.builder().put(\"index.batch_indexing\", true).build(),","+            \"\\\"properties\\\": {\\\"x\\\": {\\\"type\\\": \\\"long\\\"}}\",","+            \"\\\"into-nowrite-alias\\\": {\\\"is_write_index\\\": false}\"","+        );","+","+        ResponseException e = expectThrows(ResponseException.class, () -> intoDestination(CREATE_DOC_USER, \"into-nowrite-alias\"));","+        assertThat(e.getResponse().getStatusLine().getStatusCode(), equalTo(HttpStatus.SC_BAD_REQUEST));","+        assertThat(EntityUtils.toString(e.getResponse().getEntity()), containsString(\"no write index is defined for alias\"));","+    }","+","+    private static Object countOf(String index) throws IOException {","+        assertOK(adminClient().performRequest(new Request(\"POST\", index + \"/_refresh\")));","+        return entityAsMap(adminClient().performRequest(new Request(\"GET\", index + \"/_count\"))).get(\"count\");","+    }","+","+    private static void createDestinationWithPipeline() throws IOException {","+        Request pipeline = new Request(\"PUT\", \"_ingest/pipeline/into-pipeline\");","+        pipeline.setJsonEntity(\"{\\\"processors\\\": []}\");","+        assertOK(adminClient().performRequest(pipeline));","+        createIndex(adminClient(), EXISTING, Settings.builder().put(\"index.default_pipeline\", \"into-pipeline\").build());","+    }","+","+    /** Writes one row into the given destination as the given user. A user without {@code maintenance} also gets a refresh warning. */","+    private static Response intoDestination(String user, String destination) throws IOException {","+        return intoDestination(user, \"ROW x = 1\", destination);","+    }","+","+    private static Response intoDestination(String user, String rows, String destination) throws IOException {","+        Request request = new Request(\"POST\", \"_query\");","+        String query = rows + \" | INTO \" + destination;","+        request.setJsonEntity(Strings.toString(JsonXContent.contentBuilder().startObject().field(\"query\", query).endObject()));","+        request.setOptions(","+            RequestOptions.DEFAULT.toBuilder().addHeader(\"es-security-runas-user\", user).setWarningsHandler(WarningsHandler.PERMISSIVE)","+        );","+        return client().performRequest(request);","+    }","+","     private static void assertSummary(Response response) throws IOException {","         assertThat(response.getStatusLine().getStatusCode(), equalTo(200));","         // total, created, failures, failure_details"],"additions":181,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/qa/security/src/javaRestTest/resources/roles.yml","lines":["@@ -658,3 +658,31 @@ into_write_and_maintenance_elsewhere:","       privileges: [ 'write' ]","     - names: [ 'into-unrelated' ]","       privileges: [ 'read', 'maintenance' ]","+","+# Can read an INTO destination, but not write to it, so INTO is denied, as it is for a destination that does not exist.","+into_read_only:","+  cluster: []","+  indices:","+    - names: [ 'into-existing' ]","+      privileges: [ 'read' ]","+","+# Can create documents in a destination, with no read access to it. Only such a caller is told what a bulk would tell, such as that a","+# destination has an ingest pipeline or does not exist. ES|QL needs some read privilege to run at all, so the role reads an index that","+# is not a destination.","+into_create_doc_only:","+  cluster: []","+  indices:","+    - names: [ 'into-existing', 'into-missing', 'into-plain', 'into-ds', 'into-alias', 'into-nowrite-alias' ]","+      privileges: [ 'create_doc' ]","+    - names: [ 'into-unrelated' ]","+      privileges: [ 'read' ]","+","+# Can create documents, but in another index than the destinations, so INTO is denied. A check of whether the caller may write","+# anywhere would let this role through.","+into_create_doc_elsewhere:","+  cluster: []","+  indices:","+    - names: [ 'into-elsewhere' ]","+      privileges: [ 'create_doc' ]","+    - names: [ 'into-unrelated' ]","+      privileges: [ 'read' ]"],"additions":28,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/qa/testFixtures/src/main/resources/into.csv-spec","lines":["@@ -1,11 +0,0 @@","-rowIntoIndex","-required_capability: into_command","-","-ROW into_long = [1, 2, 3]","-| MV_EXPAND into_long","-| INTO into_destination","-;","-","-total:long | created:long | failures:long | failure_details:keyword","-3          | 3            | 0             | null","-;"],"additions":0,"deletions":11,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/CrossClusterIntoIT.java","lines":["@@ -40,8 +40,8 @@ protected Settings nodeSettings() {","     }"," ","     @Before","-    public void requiresSnapshot() {","-        assumeTrue(\"INTO is only enabled in snapshot builds\", EsqlCapabilities.Cap.INTO_COMMAND.isEnabled());","+    public void requiresIntoCommand() {","+        assumeTrue(\"INTO command required\", EsqlCapabilities.Cap.INTO_COMMAND.isEnabled());","     }"," ","     public void testRemoteSourceIsRejected() throws Exception {"],"additions":2,"deletions":2,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/IntoIT.java","lines":["@@ -8,6 +8,7 @@"," package org.elasticsearch.xpack.esql.action;"," "," import org.elasticsearch.ElasticsearchStatusException;","+import org.elasticsearch.ExceptionsHelper;"," import org.elasticsearch.action.ActionListener;"," import org.elasticsearch.action.NoShardAvailableActionException;"," import org.elasticsearch.action.admin.indices.alias.IndicesAliasesRequest;","@@ -43,6 +44,7 @@"," import java.util.List;"," import java.util.Map;"," import java.util.Set;","+import java.util.concurrent.CountDownLatch;"," import java.util.concurrent.TimeUnit;"," import java.util.concurrent.atomic.AtomicInteger;"," import java.util.stream.Collectors;","@@ -113,7 +115,7 @@ protected Settings nodeSettings(int nodeOrdinal, Settings otherSettings) {"," ","     @Before","     public void createDestination() {","-        assumeTrue(\"INTO is only enabled in snapshot builds\", EsqlCapabilities.Cap.INTO_COMMAND.isEnabled());","+        assumeTrue(\"INTO command required\", EsqlCapabilities.Cap.INTO_COMMAND.isEnabled());","         assumeTrue(\"INTO writes through batch indexing\", BatchIndexingEnabled.FEATURE_FLAG.isEnabled());","         assertAcked(indicesAdmin().prepareCreate(DESTINATION).setSettings(batchIndexingSettings()).setMapping(MAPPING));","     }","@@ -171,7 +173,7 @@ public void testDateMathDestinationCannotAlsoBeRead() {","         );","         assertThat(","             e.getMessage(),","-            containsString(\"INTO destination [\" + dateMathDest + \"] is also read by the query, through [\" + resolvedDest + \"]\")","+            containsString(\"INTO destination [\" + resolvedDest + \"] is also read by the query, through [\" + resolvedDest + \"]\")","         );","     }"," ","@@ -193,6 +195,16 @@ public void testExplainIntoDoesNotIndex() {","         assertReadBack(List.of());","     }"," ","+    /** An EXPLAIN never writes, so a destination that is not there is fine, and the EXPLAIN does not create it. */","+    public void testExplainIntoMissingDestinationDoesNotCreateIt() {","+        String missing = \"dest-into-missing\";","+        try (EsqlQueryResponse response = run(\"EXPLAIN (ROW k = \\\"explained\\\" | INTO \" + missing + \")\")) {","+            List<String> plans = getValuesList(response).stream().map(row -> (String) row.getLast()).toList();","+            assertThat(plans, hasItem(containsString(\"IntoExec\")));","+        }","+        assertFalse(indexExists(missing));","+    }","+","     public void testRefusedRowFailsTheQuery() {","         ElasticsearchStatusException e = expectThrows(","             ElasticsearchStatusException.class,","@@ -545,6 +557,53 @@ public void testFailureDuringTheWriteIsNotRetried() {","         assertReadBack(\"STATS c = COUNT(*) BY k | STATS most = MAX(c)\", List.of(List.of(1L)));","     }"," ","+    /**","+     * The destination passes the coordinator's check and then gets an ingest pipeline, before a data node plans the write. The coordinator","+     * is the one that authorizes the caller, so the data node must not tell the caller what is wrong with the destination. A single shard","+     * means a single data node request, which is held until the destination has changed.","+     */","+    public void testDestinationThatChangesBeforeADataNodePlansTheWriteFailsWithoutSayingWhy() throws Exception {","+        createSource(indexSettings(1, 0), MAPPING);","+        indexRandom(true, client().prepareIndex(SOURCE).setSource(\"k\", \"a\"));","+        CountDownLatch requestArrived = new CountDownLatch(1);","+        CountDownLatch destinationChanged = new CountDownLatch(1);","+        for (String node : internalCluster().getNodeNames()) {","+            MockTransportService.getInstance(node)","+                .addRequestHandlingBehavior(ComputeService.DATA_ACTION_NAME, (handler, request, channel, task) -> {","+                    requestArrived.countDown();","+                    destinationChanged.await();","+                    handler.messageReceived(request, channel, task);","+                });","+        }","+        try {","+            // The query is expected to fail. The listener only borrows a response, which the action releases afterwards.","+            PlainActionFuture<Exception> outcome = new PlainActionFuture<>();","+            client().execute(","+                EsqlQueryAction.INSTANCE,","+                syncEsqlQueryRequest(\"FROM \" + SOURCE + \" | KEEP k | INTO \" + DESTINATION).pragmas(getPragmas()),","+                ActionListener.wrap(response -> outcome.onResponse(null), outcome::onResponse)","+            );","+            try {","+                safeAwait(requestArrived);","+                assertAcked(","+                    indicesAdmin().prepareUpdateSettings(DESTINATION)","+                        .setSettings(Settings.builder().put(IndexSettings.DEFAULT_PIPELINE.getKey(), \"some-pipeline\"))","+                );","+            } finally {","+                destinationChanged.countDown();","+            }","+            Exception failure = safeGet(outcome);","+            assertNotNull(\"the query was expected to fail\", failure);","+            ElasticsearchStatusException e = (ElasticsearchStatusException) ExceptionsHelper.unwrapCause(failure);","+            assertThat(e.status(), equalTo(RestStatus.CONFLICT));","+            assertThat(e.getMessage(), not(containsString(\"pipeline\")));","+        } finally {","+            for (String node : internalCluster().getNodeNames()) {","+                MockTransportService.getInstance(node).clearAllRules();","+            }","+        }","+    }","+","     public void testAllowPartialResultsDoesNotBypassRowFailure() {","         ElasticsearchStatusException failed = expectThrows(","             ElasticsearchStatusException.class,"],"additions":61,"deletions":2,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlCapabilities.java","lines":["@@ -5040,6 +5040,13 @@ public enum Cap {","          */","         INTO_COMMAND(Build.current().isSnapshot()),"," ","+        /**","+         * {@code INTO} authorizes its destination before planning, and a destination that does not exist is a 404 instead of being","+         * created. Nodes without this create the destination on the first write, so a mixed cluster must not run tests of the new","+         * behavior.","+         */","+        INTO_AUTHORIZES_DESTINATION(Build.current().isSnapshot()),","+","         /**","          * Support for {@code ROW} under {@code unmapped_fields=\"LOAD_ALL\"}, alone or as a branch of a subquery next to an index. A","          * {@code ROW} has no {@code _source}, so it adds no unmapped fields and its rows have a null {@code _unmapped_fields}. Only"],"additions":7,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlIntoDestinationAction.java","lines":["@@ -0,0 +1,113 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.action.ActionListener;","+import org.elasticsearch.action.ActionRequest;","+import org.elasticsearch.action.ActionRequestValidationException;","+import org.elasticsearch.action.ActionResponse;","+import org.elasticsearch.action.ActionType;","+import org.elasticsearch.action.IndicesRequest;","+import org.elasticsearch.action.ResolvedIndexExpressions;","+import org.elasticsearch.action.index.TransportIndexAction;","+import org.elasticsearch.action.support.ActionFilters;","+import org.elasticsearch.action.support.IndicesOptions;","+import org.elasticsearch.action.support.TransportAction;","+import org.elasticsearch.common.io.stream.StreamOutput;","+import org.elasticsearch.common.util.concurrent.EsExecutors;","+import org.elasticsearch.injection.guice.Inject;","+import org.elasticsearch.tasks.Task;","+import org.elasticsearch.transport.TransportService;","+","+import java.util.Arrays;","+","+/**","+ * Lets the security filter authorize, and audit, a write by an {@code INTO} to its destination before anything about the destination is","+ * reported. It does nothing else, and without security it succeeds.","+ * <p>","+ * It is named after what the filter authorizes for each document that a bulk creates, so that the callers whom a bulk would allow to","+ * create a document there pass, and a denial is audited as the write would be. A bulk also needs its own actions","+ * ({@code indices:data/write/bulk*}), which a custom role can lack, and which are not checked here. The name copies","+ * {@code AuthorizationService.IMPLIED_CREATE_ACTION}, which is private to the security plugin.","+ */","+public class EsqlIntoDestinationAction extends TransportAction<EsqlIntoDestinationAction.Request, EsqlIntoDestinationAction.Response> {","+    public static final String NAME = TransportIndexAction.NAME + \":op_type/create\";","+    public static final ActionType<Response> TYPE = new ActionType<>(NAME);","+","+    @Inject","+    public EsqlIntoDestinationAction(TransportService transportService, ActionFilters actionFilters) {","+        super(NAME, actionFilters, transportService.getTaskManager(), EsExecutors.DIRECT_EXECUTOR_SERVICE);","+    }","+","+    @Override","+    protected void doExecute(Task task, Request request, ActionListener<Response> listener) {","+        listener.onResponse(new Response());","+    }","+","+    /**","+     * Local only, so it never crosses the wire. The destination is one concrete name: a pattern would be expanded by the security","+     * filter, and an empty name list reads as {@code _all} to its resolver, so the caller of this request validates the name first.","+     */","+    public static class Request extends ActionRequest implements IndicesRequest.Replaceable {","+        private String[] indices;","+        private ResolvedIndexExpressions resolvedIndexExpressions;","+","+        public Request(String destination) {","+            this.indices = new String[] { destination };","+        }","+","+        @Override","+        public String[] indices() {","+            return indices;","+        }","+","+        @Override","+        public IndicesRequest indices(String... indices) {","+            this.indices = indices;","+            return this;","+        }","+","+        @Override","+        public IndicesOptions indicesOptions() {","+            // A destination that does not exist is authorized by its name too, and an unauthorized one is a denial, not a narrowing","+            return IndicesOptions.strictSingleIndexNoExpandForbidClosed();","+        }","+","+        @Override","+        public void setResolvedIndexExpressions(ResolvedIndexExpressions expressions) {","+            this.resolvedIndexExpressions = expressions;","+        }","+","+        @Override","+        public ResolvedIndexExpressions getResolvedIndexExpressions() {","+            return resolvedIndexExpressions;","+        }","+","+        @Override","+        public ActionRequestValidationException validate() {","+            return null;","+        }","+","+        @Override","+        public void writeTo(StreamOutput out) {","+            TransportAction.localOnly();","+        }","+","+        @Override","+        public String toString() {","+            return \"EsqlIntoDestinationAction.Request{indices:\" + Arrays.toString(indices) + \"}\";","+        }","+    }","+","+    public static class Response extends ActionResponse {","+        @Override","+        public void writeTo(StreamOutput out) {","+            TransportAction.localOnly();","+        }","+    }","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/into/IntoDestinationAuthorizer.java","lines":["@@ -0,0 +1,57 @@","+/*","+ * Copyright Elasticsearch 