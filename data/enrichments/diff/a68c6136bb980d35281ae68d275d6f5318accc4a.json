{"id":"a68c6136bb980d35281ae68d275d6f5318accc4a","axis":"silent","repo":"ggerganov/llama.cpp","sha":"a68c6136bb980d35281ae68d275d6f5318accc4a","parsed":{"files":[{"path":"common/arg.cpp","lines":["@@ -4522,6 +4522,14 @@ common_params_context common_params_parser_init(common_params & params, llama_ex","             params.tts_speaker_file = value;","         }","     ).set_examples({LLAMA_EXAMPLE_TTS}));","+    add_opt(common_arg(","+        {\"--tts-speaker-text\"}, \"TEXT\",","+        \"transcript of --tts-speaker-file, for models that need it to clone the voice\\n\"","+        \"see docs/multimodal/tts.md for per-model usage notes\",","+        [](common_params & params, const std::string & value) {","+            params.tts_speaker_text = value;","+        }","+    ).set_examples({LLAMA_EXAMPLE_TTS}));"," ","     //","     // diffusion params"],"additions":8,"deletions":0,"truncated":false},{"path":"common/common.h","lines":["@@ -796,6 +796,7 @@ struct common_params {","     std::string tts_lang = \"\";","     std::string tts_voice = \"\";","     std::string tts_speaker_file = \"\";","+    std::string tts_speaker_text = \"\";"," ","     bool is_gen_docs = false; // whether we are running inside llama-gen-docs"," };"],"additions":1,"deletions":0,"truncated":false},{"path":"conversion/__init__.py","lines":["@@ -336,6 +336,7 @@","     \"XverseForCausalLM\": \"xverse\",","     \"YoutuForCausalLM\": \"deepseek\",","     \"YoutuVLForConditionalGeneration\": \"deepseek\",","+    \"fish_qwen3_omni\": \"fish_s2\",","     \"modeling_grove_moe.GroveMoeForCausalLM\": \"grovemoe\",","     \"modeling_sarvam_moe.SarvamMoEForCausalLM\": \"bailingmoe\","," }","@@ -438,6 +439,7 @@","     \"VoxtralForConditionalGeneration\": \"ultravox\",","     \"VoxtralRealtimeForConditionalGeneration\": \"ultravox\",","     \"YoutuVLForConditionalGeneration\": \"youtuvl\",","+    \"fish_qwen3_omni\": \"fish_s2\","," }"," "," "],"additions":2,"deletions":0,"truncated":false},{"path":"conversion/base.py","lines":["@@ -3488,6 +3488,9 @@ def get_model_architecture(hparams: dict[str, Any], model_type: ModelType) -> st","     # some models (llava_onevision2) only declare the architecture inside text_config","     if arch is None and text_config.get(\"architectures\") is not None:","         arch = text_config[\"architectures\"][0]","+    # some configs only have a model_type (fishaudio/s2-pro)","+    if arch is None:","+        arch = hparams.get(\"model_type\")","     if arch is None:","         raise ValueError(\"Failed to detect model architecture\")","     return arch"],"additions":3,"deletions":0,"truncated":false},{"path":"conversion/drama3.py","lines":["@@ -18,6 +18,30 @@"," _TOWER_RESIDUAL = \"audio_decoder_mtp.layers.\""," "," ","+def load_codec(dir_model) -> dict[str, Tensor]:","+    sd = torch.load(dir_model / \"codec.pth\", map_location=\"cpu\", mmap=True, weights_only=True)","+    return sd.get(\"state_dict\", sd)","+","+","+def fold_conv(sd: dict[str, Tensor], prefix: str) -> Tensor:","+    # fold weight norm","+    if prefix + \".conv.weight\" in sd:","+        return sd[prefix + \".conv.weight\"].float()","+    g = sd[prefix + \".conv.parametrizations.weight.original0\"].float()","+    v = sd[prefix + \".conv.parametrizations.weight.original1\"].float()","+    return g * v / v.norm(dim=(1, 2), keepdim=True)","+","+","+def fold_wn(g: Tensor, v: Tensor) -> Tensor:","+    # fold old-style weight norm of a 1x1 conv, returns [out, in]","+    return (g.float() * v.float() / v.float().norm(dim=(1, 2), keepdim=True)).squeeze(-1)","+","+","+def fold_snake(alpha: Tensor) -> tuple[Tensor, Tensor]:","+    alpha = alpha.float().flatten()","+    return alpha, 1.0 / (alpha + 1e-9)","+","+"," @ModelBase.register(\"FishOmniModel\")"," @ModelBase.example(\"fishaudio/drama-3\")"," class Drama3TextModel(Qwen3_5MoeTextModel):","@@ -36,6 +60,7 @@ def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Ca"," class Drama3MmprojModel(MmprojModel):","     has_vision_encoder = False","     has_audio_encoder = False","+    gen_projector_type = gguf.VisionProjectorType.DRAMA3_GEN"," ","     _LAYER_MAP = {","         \"enorm.weight\":                                 (gguf.MODEL_TENSOR.A_GEN_CODE_ENORM, True),","@@ -69,7 +94,7 @@ def set_gguf_parameters(self):","         cfg = self.hparams","         self.gguf_writer.add_file_type(self.ftype)","         self.gguf_writer.add_clip_has_gen_audio_encoder(True)","-        self.gguf_writer.add_clip_gen_audio_projector_type(gguf.VisionProjectorType.DRAMA3_GEN)","+        self.gguf_writer.add_clip_gen_audio_projector_type(self.gen_projector_type)","         self.gguf_writer.add_gen_audio_projection_dim(self.n_embd_text)","         self.gguf_writer.add_gen_audio_embedding_length(cfg[\"dim\"])","         self.gguf_writer.add_gen_audio_feed_forward_length(cfg[\"intermediate_size\"])","@@ -153,32 +178,20 @@ def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iter"," ","     def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:","         # only the DAC decoder, the encoder is for voice cloning (not supported yet)","-        sd = torch.load(self.dir_model / \"codec.pth\", map_location=\"cpu\", mmap=True, weights_only=True)","-        sd = sd.get(\"state_dict\", sd)","+        sd = load_codec(self.dir_model)","         T = gguf.MODEL_TENSOR"," ","         def get(name: str) -> Tensor:","             return sd[name].float()"," ","         def conv(prefix: str) -> Tensor:","-            # fold weight norm","-            if prefix + \".conv.weight\" in sd:","-                return get(prefix + \".conv.weight\")","-            g = get(prefix + \".conv.parametrizations.weight.original0\")","-            v = get(prefix + \".conv.parametrizations.weight.original1\")","-            return g * v / v.norm(dim=(1, 2), keepdim=True)","+            return fold_conv(sd, prefix)"," ","         def quant_table(prefix: str) -> Tensor:","             # fold out_proj into the codebook, so decoding is a row lookup","-            g = get(prefix + \".out_proj.weight_g\")","-            v = get(prefix + \".out_proj.weight_v\")","-            w = (g * v / v.norm(dim=(1, 2), keepdim=True)).squeeze(-1)","+            w = fold_wn(sd[prefix + \".out_proj.weight_g\"], sd[prefix + \".out_proj.weight_v\"])","             return get(prefix + \".codebook.weight\") @ w.T + get(prefix + \".out_proj.bias\")"," ","-        def snake(alpha: Tensor) -> tuple[Tensor, Tensor]:","-            alpha = alpha.flatten()","-            return alpha, 1.0 / (alpha + 1e-9)","-","         q = \"quantizer.\"","         yield (self.format_tensor_name(T.A_GEN_WAV_QUANT_FIRST_CB), quant_table(q + \"semantic_quantizer.quantizers.0\"))","         n_rest = sum(1 for k in sd if k.startswith(q + \"quantizer.quantizers.\") and k.endswith(\".codebook.weight\"))","@@ -228,7 +241,7 @@ def neox_rows(w: Tensor) -> Tensor:","         yield (self.format_tensor_name(T.A_GEN_WAV_DAC_ENTRY, suffix=\".bias\"), get(d + \"0.conv.bias\"))","         for bid in range(4):","             p = f\"{d}{bid + 1}.block.\"","-            a, b = snake(get(p + \"0.alpha\"))","+            a, b = fold_snake(get(p + \"0.alpha\"))","             yield (self.format_tensor_name(T.A_GEN_WAV_DAC_UP_SNAKE, bid, suffix=\".alpha\"), a)","             yield (self.format_tensor_name(T.A_GEN_WAV_DAC_UP_SNAKE, bid, suffix=\".beta\"), b)","             yield (self.format_tensor_name(T.A_GEN_WAV_DAC_UP_CONV, bid, suffix=\".weight\"), conv(p + \"1\"))","@@ -236,7 +249,7 @@ def neox_rows(w: Tensor) -> Tensor:","             for xid in range(3):","                 r = f\"{p}{xid + 2}.block.\"","                 for act, tensor in ((\"0\", T.A_GEN_WAV_DAC_RES_ACT1), (\"2\", T.A_GEN_WAV_DAC_RES_ACT2)):","-                    a, b = snake(get(r + act + \".alpha\"))","+                    a, b = fold_snake(get(r + act + \".alpha\"))","                     name = gguf.TENSOR_NAMES[tensor].format(bid=bid, xid=xid)","                     yield (name + \".alpha\", a)","                     yield (name + \".beta\", b)","@@ -244,7 +257,7 @@ def neox_rows(w: Tensor) -> Tensor:","                     name = gguf.TENSOR_NAMES[tensor].format(bid=bid, xid=xid)","                     yield (name + \".weight\", conv(r + cv))","                     yield (name + \".bias\", get(r + cv + \".conv.bias\"))","-        a, b = snake(get(d + \"5.alpha\"))","+        a, b = fold_snake(get(d + \"5.alpha\"))","         yield (self.format_tensor_name(T.A_GEN_WAV_DAC_POST_SNAKE, suffix=\".alpha\"), a)","         yield (self.format_tensor_name(T.A_GEN_WAV_DAC_POST_SNAKE, suffix=\".beta\"), b)","         yield (self.format_tensor_name(T.A_GEN_WAV_DAC_POST_CONV, suffix=\".weight\"), conv(d + \"6\"))"],"additions":32,"deletions":19,"truncated":false},{"path":"conversion/fish_s2.py","lines":["@@ -0,0 +1,276 @@","+from __future__ import annotations","+","+from pathlib import Path","+from typing import Any, Callable, Iterable, TYPE_CHECKING","+","+import torch","+","+if TYPE_CHECKING:","+    from torch import Tensor","+","+from .base import ModelBase, gguf","+from .drama3 import Drama3MmprojModel, fold_conv, fold_snake, fold_wn, load_codec","+from .qwen import Qwen3Model","+","+# Fish Audio S2 Pro (dual-AR)","+# text model: Qwen3 backbone (slow AR), samples the semantic code of each frame","+# mmproj: fast AR code predictor (other codebooks) and Fish DAC decoder (codec.pth, same as drama3)","+","+# residual codebook size of codec.pth, the fast AR head is cut to it","+_N_RESIDUAL_CODES = 1024","+","+# codec encoder strides (encoder_rates of the codec config), the quantizer then downsamples 2x2","+_CODEC_ENC_STRIDES = (2, 4, 8, 8)","+","+# codec encoder transformers, both 1024 wide with 16 heads of 64","+# generic audio layers a.blk.0..3: last encoder block, a.blk.4..11: quantizer pre_module","+_N_ENC_TFM_LAYERS = 4","+_N_PRE_TFM_LAYERS = 8","+_CODEC_HEAD_DIM = 64","+","+","+def _load_hparams(dir_model: Path) -> dict[str, Any]:","+    hparams = ModelBase.load_hparams(dir_model, is_mistral_format=False)","+    cfg = hparams[\"text_config\"]","+    hparams[\"text_config\"] = {","+        \"hidden_size\":             cfg[\"dim\"],","+        \"num_hidden_layers\":       cfg[\"n_layer\"],","+        \"num_attention_heads\":     cfg[\"n_head\"],","+        \"num_key_value_heads\":     cfg[\"n_local_heads\"],","+        \"head_dim\":                cfg[\"head_dim\"],","+        \"intermediate_size\":       cfg[\"intermediate_size\"],","+        \"rms_norm_eps\":            cfg[\"norm_eps\"],","+        \"rope_theta\":              cfg[\"rope_base\"],","+        \"max_position_embeddings\": cfg[\"max_seq_len\"],","+        \"vocab_size\":              cfg[\"vocab_size\"],","+        \"tie_word_embeddings\":     cfg[\"tie_word_embeddings\"],","+    }","+    return hparams","+","+","+def _neox_rows(w: Tensor, head_dim: int) -> Tensor:","+    # checkpoint uses interleaved RoPE, reorder the rows of each head so NEOX RoPE gives the same result","+    order = torch.cat([torch.arange(0, head_dim, 2), torch.arange(1, head_dim, 2)])","+    return w.reshape(-1, head_dim, *w.shape[1:])[:, order].reshape(w.shape)","+","+","+@ModelBase.register(\"fish_qwen3_omni\")","+@ModelBase.example(\"fishaudio/s2-pro\")","+class FishS2TextModel(Qwen3Model):","+    model_arch = gguf.MODEL_ARCH.QWEN3","+","+    def __init__(self, dir_model: Path, *args, **kwargs):","+        kwargs.pop(\"hparams\", None)","+        super().__init__(dir_model, *args, hparams=_load_hparams(dir_model), **kwargs)","+","+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:","+        # the rest is mapped by tensor_mapping.py","+        name = name.removeprefix(\"text_model.\")","+        T = gguf.MODEL_TENSOR","+        head_dim = self.hparams[\"head_dim\"]","+        if name.endswith(\".attention.wqkv.weight\"):","+            n_q  = self.hparams[\"num_attention_heads\"] * head_dim","+            n_kv = self.hparams[\"num_key_value_heads\"] * head_dim","+            q, k, v = data_torch.split([n_q, n_kv, n_kv], dim=0)","+            yield (self.format_tensor_name(T.ATTN_Q, bid), _neox_rows(q, head_dim))","+            yield (self.format_tensor_name(T.ATTN_K, bid), _neox_rows(k, head_dim))","+            yield (self.format_tensor_name(T.ATTN_V, bid), v)","+            return","+        if name.endswith(\".attention.q_norm.weight\"):","+            yield (self.format_tensor_name(T.ATTN_Q_NORM, bid), _neox_rows(data_torch, head_dim))","+            return","+        if name.endswith(\".attention.k_norm.weight\"):","+            yield (self.format_tensor_name(T.ATTN_K_NORM, bid), _neox_rows(data_torch, head_dim))","+            return","+        yield from super().modify_tensors(data_torch, name, bid)","+","+","+@ModelBase.register(\"fish_qwen3_omni\")","+@ModelBase.example(\"fishaudio/s2-pro\")","+class FishS2MmprojModel(Drama3MmprojModel):","+    has_audio_encoder = True  # codec encoder, for voice cloning","+    gen_projector_type = gguf.VisionProjectorType.FISH_S2_GEN","+","+    _FAST_AR_MAP = {","+        \"attention_norm.weight\":     gguf.MODEL_TENSOR.A_GEN_CODE_ATTN_NORM,","+        \"attention.wo.weight\":       gguf.MODEL_TENSOR.A_GEN_CODE_ATTN_OUT,","+        \"ffn_norm.weight\":           gguf.MODEL_TENSOR.A_GEN_CODE_FFN_NORM,","+        \"feed_forward.w1.weight\":    gguf.MODEL_TENSOR.A_GEN_CODE_FFN_GATE,","+        \"feed_forward.w3.weight\":    gguf.MODEL_TENSOR.A_GEN_CODE_FFN_UP,","+        \"feed_forward.w2.weight\":    gguf.MODEL_TENSOR.A_GEN_CODE_FFN_DOWN,","+    }","+","+    def __init__(self, dir_model: Path, *args, **kwargs):","+        kwargs.pop(\"hparams\", None)","+        super().__init__(dir_model, *args, hparams=_load_hparams(dir_model), **kwargs)","+","+    def get_audio_config(self) -> dict[str, Any] | None:","+        cfg = dict(self.global_config[\"audio_decoder_config\"])","+        cfg[\"num_hidden_layers\"] = cfg[\"n_layer\"]","+        return cfg","+","+    def set_gguf_parameters(self):","+        super().set_gguf_parameters()","+        # codec encoder: raw 44.1 kHz waveform -> backbone input rows, other hparams are hardcoded in tools/mtmd","+        self.gguf_writer.add_clip_has_audio_encoder(True)","+        self.gguf_writer.add_clip_audio_projector_type(gguf.VisionProjectorType.FISH_S2_SPKENC)","+        self.gguf_writer.add_audio_projection_dim(self.n_embd_text)","+        self.gguf_writer.add_audio_num_mel_bins(1)","+        self.gguf_writer.add_audio_block_count(_N_ENC_TFM_LAYERS + _N_PRE_TFM_LAYERS)","+        self.gguf_writer.add_audio_embedding_length(1024)","+        self.gguf_writer.add_audio_feed_forward_length(3072)","+        self.gguf_writer.add_audio_head_count(1024 // _CODEC_HEAD_DIM)","+        self.gguf_writer.add_audio_attention_layernorm_eps(1e-5)","+","+    def tensor_force_quant(self, name, new_name, bid, n_dims):","+        # the VQ picks the nearest codebook entry, small errors in the encoder change the codes","+        if new_name.startswith(\"a.codec.\"):","+            return gguf.GGMLQuantizationType.F32","+        # codec transformers: F16 gives codes closer to the reference than BF16","+        if new_name.startswith(\"a.blk.\") and n_dims == 2:","+            return gguf.GGMLQuantizationType.F16","+        return super().tensor_force_quant(name, new_name, bid, n_dims)","+","+    @classmethod","+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:","+        name = item[0]","+        if name.startswith(\"audio_decoder.\") or name == \"text_model.model.embeddings.weight\":","+            return item","+        return None","+","+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:","+        T = gguf.MODEL_TENSOR","+        cfg = self.hparams","+","+        # already named by generate_extra_tensors()","+        if name.startswith(\"a.\"):","+            yield (name, data_torch)","+            return","+","+        if name == \"text_model.model.embeddings.weight\":","+            # semantic band of the backbone embeddings","+            begin = self.global_config[\"semantic_start_token_id\"]","+            yield (self.format_tensor_name(T.A_GEN_CODE_OUT_EMBD), data_torch[begin:begin + cfg[\"vocab_size\"]])","+            return","+","+        if name == \"audio_decoder.codebook_embeddings.weight\":","+            # backbone input of a speech row, one table per codebook","+            yield (self.format_tensor_name(T.A_GEN_CODE_EMBD), data_torch.reshape(cfg[\"num_codebooks\"], -1, data_torch.shape[-1]))","+            return","+","+        if name == \"audio_decoder.embeddings.weight\":","+            yield (self.format_tensor_name(T.A_GEN_CODE_TOK_EMBD), data_torch)","+            return","+","+        if name == \"audio_decoder.output.weight\":","+            yield (self.format_tensor_name(T.A_GEN_CODE_HEAD), data_torch[:_N_RESIDUAL_CODES])","+            return","+","+        if name == \"audio_decoder.norm.weight\":","+            yield (self.format_tensor_name(T.A_GEN_CODE_OUTPUT_NORM), data_torch)","+            return","+","+        assert bid is not None and name.startswith(f\"audio_decoder.layers.{bid}.\")","+        key = name.removeprefix(f\"audio_decoder.layers.{bid}.\")","+        if key == \"attention.wqkv.weight\":","+            head_dim = cfg[\"head_dim\"]","+            n_q  = cfg[\"n_head\"] * head_dim","+            n_kv = cfg[\"n_local_heads\"] * head_dim","+            q, k, v = data_torch.split([n_q, n_kv, n_kv], dim=0)","+            yield (self.format_tensor_name(T.A_GEN_CODE_ATTN_Q, bid), _neox_rows(q, head_dim))","+            yield (self.format_tensor_name(T.A_GEN_CODE_ATTN_K, bid), _neox_rows(k, head_dim))","+            yield (self.format_tensor_name(T.A_GEN_CODE_ATTN_V, bid), v)","+            return","+        yield (self.format_tensor_name(self._FAST_AR_MAP[key], bid), data_torch)","+","+    def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:","+        yield from super().generate_extra_tensors()","+","+        sd = load_codec(self.dir_model)","+        T = gguf.MODEL_TENSOR","+","+        def get(name: str) -> Tensor:","+            return sd[name].float()","+","+        def tn(tensor: gguf.MODEL_TENSOR, bid: int | None = None, xid: int | None = None) -> str:","+            return gguf.TENSOR_NAMES[tensor].format(bid=bid, xid=xid)","+","+        def conv_wb(tensor: gguf.MODEL_TENSOR, prefix: str, bid: int | None = None, xid: int | None = None, stride: int = 1):","+            # taps-major [K / stride, OC, stride * IC], see conv() in tools/mtmd/models/fish-s2-spkenc.cpp","+            w = fold_conv(sd, prefix)","+            n_out, n_in, k = w.shape","+            w = w.reshape(n_out, n_in, k // stride, stride).permute(2, 0, 3, 1).reshape(k // stride, n_out, stride * n_in)","+            yield (tn(tensor, bid, xid) + \".weight\", w)","+            yield (tn(tensor, bid, xid) + \".bias\", get(prefix + \".conv.bias\"))","+","+        def snake_ab(tensor: gguf.MODEL_TENSOR, name: str, bid: int | None = None, xid: int | None = None):","+            a, b = fold_snake(get(name))","+            yield (tn(tensor, bid, xid) + \".alpha\", a)","+            yield (tn(tensor, bid, xid) + \".beta\", b)","+","+        def tfm_layers(prefix: str, n_layer: int, offset: int):","+            for il in range(n_layer):","+                p = f\"{prefix}layers.{il}.\"","+                bid = offset + il","+                wq, wk, wv = get(p + \"attention.wqkv.weight\").chunk(3, dim=0)","+                yield (self.format_tensor_name(T.A_ENC_ATTN_Q,       bid), _neox_rows(wq, _CODEC_HEAD_DIM))","+                yield (self.format_tensor_name(T.A_ENC_ATTN_K,       bid), _neox_rows(wk, _CODEC_HEAD_DIM))","+                yield (self.format_tensor_name(T.A_ENC_ATTN_V,       bid), wv)","+                yield (self.format_tensor_name(T.A_ENC_OUTPUT,       bid), get(p + \"attention.wo.weight\"))","+                yield (self.format_tensor_name(T.A_ENC_INPUT_NORM,   bid), get(p + \"attention_norm.weight\"))","+                yield (self.format_tensor_name(T.A_ENC_ATTN_SCALE,   bid), get(p + \"attention_layer_scale.gamma\"))","+                yield (self.format_tensor_name(T.A_ENC_OUTPUT_NORM,  bid), get(p + \"ffn_norm.weight\"))","+                yield (self.format_tensor_name(T.A_ENC_FFN_GATE,     bid), get(p + \"feed_forward.w1.weight\"))","+                yield (self.format_tensor_name(T.A_ENC_FFN_UP,       bid), get(p + \"feed_forward.w3.weight\"))","+                yield (self.format_tensor_name(T.A_ENC_FFN_DOWN,     bid), get(p + \"feed_forward.w2.weight\"))","+                yield (self.format_tensor_name(T.A_ENC_FFN_SCALE_LS, bid), get(p + \"ffn_layer_scale.gamma\"))","+","+        # encoder: entry conv, 4x (3 residual units, Snake, strided conv), Snake, post conv","+        e = \"encoder.block.\"","+        yield from conv_wb(T.A_CODEC_ENC_ENTRY, e + \"0\")","+        for bid, stride in enumerate(_CODEC_ENC_STRIDES):","+            p = f\"{e}{bid + 1}.block.\"","+            for xid in range(3):","+                r = f\"{p}{xid}.block.\"","+                yield from snake_ab(T.A_CODEC_ENC_RES_ACT1, r + \"0.alpha\", bid, xid)","+                yield from conv_wb(T.A_CODEC_ENC_RES_CONV1, r + \"1\", bid, xid)","+                yield from snake_ab(T.A_CODEC_ENC_RES_ACT2, r + \"2.alpha\", bid, xid)","+                yield from conv_wb(T.A_CODEC_ENC_RES_CONV2, r + \"3\", bid, xid)","+            yield from snake_ab(T.A_CODEC_ENC_SNAKE, p + \"3.alpha\", bid)","+            yield from conv_wb(T.A_CODEC_ENC_CONV, p + \"4\", bid, stride=stride)","+        # the last block ends with a windowed transformer","+        yield from tfm_layers(f\"{e}4.block.5.\", _N_ENC_TFM_LAYERS, 0)","+        yield (self.format_tensor_name(T.A_POST_NORM), get(f\"{e}4.block.5.norm.weight\"))","+        yield from snake_ab(T.A_CODEC_ENC_POST_SNAKE, e + \"5.alpha\")","+        yield from conv_wb(T.A_CODEC_ENC_POST_CONV, e + \"6\")","+","+        # quantizer: 2x (strided conv + ConvNeXt), windowed transformer, then semantic + residual VQ","+        q = \"quantizer.\"","+        for bid in range(2):","+            p = f\"{q}downsample.{bid}.\"","+            yield from conv_wb(T.A_CODEC_DOWN_CONV, p + \"0\", bid, stride=2)","+            # depthwise: one [C] row per tap","+            yield (tn(T.A_CODEC_DOWN_DWCONV, bid) + \".weight\", fold_conv(sd, p + \"1.dwconv\").squeeze(1).T.contiguous())","+            yield (tn(T.A_CODEC_DOWN_DWCONV, bid) + \".bias\", get(p + \"1.dwconv.conv.bias\"))","+            for key, tensor in ((\"norm\", T.A_CODEC_DOWN_NORM), (\"pwconv1\", T.A_CODEC_DOWN_PW1), (\"pwconv2\", T.A_CODEC_DOWN_PW2)):","+                yield (tn(tensor, bid) + \".weight\", get(f\"{p}1.{key}.weight\"))","+                yield (tn(tensor, bid) + \".bias\", get(f\"{p}1.{key}.bias\"))","+            yield (tn(T.A_CODEC_DOWN_GAMMA, bid), get(p + \"1.gamma\"))","+        yield from tfm_layers(q + \"pre_module.\", _N_PRE_TFM_LAYERS, _N_ENC_TFM_LAYERS)","+        yield (self.format_tensor_name(T.A_CODEC_PRE_NORM), get(q + \"pre_module.norm.weight\"))","+","+        # nearest codebook entry by cosine similarity, see VectorQuantize.decode_latents()","+        def vq(prefix: str) -> tuple[Tensor, Tensor, Tensor]:","+            w = fold_wn(sd[prefix + \".in_proj.weight_g\"], sd[prefix + \".in_proj.weight_v\"])","+            cb = torch.nn.functional.normalize(get(prefix + \".codebook.weight\"), dim=-1)","+            return w, get(prefix + \".in_proj.bias\"), cb","+","+        w, b, cb = vq(q + \"semantic_quantizer.quantizers.0\")","+        yield (self.format_tensor_name(T.A_CODEC_VQ_FIRST_IN, suffix=\".weight\"), w)","+        yield (self.format_tensor_name(T.A_CODEC_VQ_FIRST_IN, suffix=\".bias\"), b)","+        yield (self.format_tensor_name(T.A_CODEC_VQ_FIRST_CB), cb)","+        n_rest = self.hparams[\"num_codebooks\"] - 1","+        rest = [vq(f\"{q}quantizer.quantizers.{i}\") for i in range(n_rest)]","+        yield (self.format_tensor_name(T.A_CODEC_VQ_REST_IN, suffix=\".weight\"), torch.stack([r[0] for r in rest]))","+        yield (self.format_tensor_name(T.A_CODEC_VQ_REST_IN, suffix=\".bias\"), torch.stack([r[1] for r in rest]))","+        yield (self.format_tensor_name(T.A_CODEC_VQ_REST_CB), torch.stack([r[2] for r in rest]))"],"additions":276,"deletions":0,"truncated":false},{"path":"docs/multimodal/tts.md","lines":["@@ -12,6 +12,7 @@ Supported models:"," - [Chatterbox](#chatterbox)"," - [Drama 3](#drama-3)"," - [ZONOS3](#zonos3)","+- [Fish Audio S2 Pro](#fish-audio-s2-pro)"," "," The sections below list the params supported by each model, with `llama-tts` examples. In `llama-server`, the same options are set with `--tts-lang` and `--tts-voice`, or per request (see the [`/tts` endpoint](../../tools/server/README.md#post-tts-generate-speech-audio-from-text))."," ","@@ -215,3 +216,45 @@ Convert the root of the release repository, not the `lm/` subdirectory. The mmpr"," python convert_hf_to_gguf.py path/to/ZONOS3-Mini --outtype q8_0 --outfile zonos3-mini.gguf"," python convert_hf_to_gguf.py path/to/ZONOS3-Mini --mmproj --outtype f32 --outfile mmproj-zonos3-mini.gguf"," ```","+","+## Fish Audio S2 Pro","+","+[Fish Audio S2 Pro](https://huggingface.co/fishaudio/s2-pro): a Qwen3 backbone (4B) samples each frame's semantic token, a 4-layer fast AR predicts the 9 other codes, and the Fish DAC (same as Drama 3) decodes them to 44.1 kHz audio.","+","+Available params:","+- Speaker tags `<|speaker:0|>`, `<|speaker:1|>`, ... in the text give each character its own voice, a text without a tag starts with `<|speaker:0|>`","+- Inline instructions in brackets control the delivery, for example `[laughing]`, `[whisper]` or `[pause]`","+- The language is the one of the text, `--tts-lang` is not used","+- Voice cloning: `--tts-speaker-file` with the reference clip, optionally `--tts-speaker-text` with its transcript (it is put in the prompt as the reference does). The clip is encoded by the codec encoder half of `codec.pth`, it is truncated to the first 30 s","+- Note: `--temp`, `--top-k` and `--top-p` are not used (only `--seed`), frames are sampled with the settings of the reference (semantic token: repetition penalty 1.1 over the last 16 frames, top-k 30, top-p 0.8, temperature 0.8, or top-p 0.9 and temperature 1.0 when the last 4 frames repeat a token; other codes: greedy)","+- Each frame is 2048 samples (about 46 ms), generation stops at the end-of-speech token","+","+Example usage:","+","+```sh","+llama-tts -m s2-pro.gguf \\","+    -mm mmproj-s2-pro.gguf \\","+    -p \"<|speaker:0|>Did you remember to buy the bread? <|speaker:1|>Of course I did [laughing] it is on the kitchen table.\" \\","+    -n 1000 \\","+    --output out.wav","+```","+","+Voice cloning (`--tts-speaker-text` can be left out):","+","+```sh","+llama-tts -m s2-pro.gguf \\","+    -mm mmproj-s2-pro.gguf \\","+    --tts-speaker-file reference.wav \\","+    --tts-speaker-text \"The words spoken in reference.wav.\" \\","+    -p \"Hello, this is a cloned voice.\" \\","+    --output out.wav","+```","+","+**Note for GGUF conversion:**","+","+The mmproj holds the fast AR and `codec.pth` (the encoder half for voice cloning, the decoder half for the audio), it is best kept in BF16. The codec encoder is always stored in F16/F32, small errors in it change the codes picked by its VQ:","+","+```sh","+python convert_hf_to_gguf.py path/to/s2-pro --outtype q8_0 --outfile s2-pro.gguf","+python convert_hf_to_gguf.py path/to/s2-pro --mmproj --outtype bf16 --outfile mmproj-s2-pro.gguf","+```"],"additions":43,"deletions":0,"truncated":false},{"path":"gguf-py/gguf/constants.py","lines":["@@ -1335,6 +1335,28 @@ class MODEL_TENSOR(IntEnum):","     A_GEN_CODE_EH_PROJ     = auto() # drama3: per-layer [code embd; hidden] -> hidden projection","     A_GEN_CODE_BLK_EMBD    = auto() # drama3: per-layer code embedding table","     A_GEN_CODE_BLK_OUT_NORM = auto() # drama3: per-layer output norm","+    A_GEN_CODE_TOK_EMBD    = auto() # fish_s2: code predictor input embedding, shared by all codebooks","+    # fish_s2 codec encoder (voice cloning): reference clip -> codes","+    A_CODEC_ENC_ENTRY      = auto() # entry conv","+    A_CODEC_ENC_SNAKE      = auto() # encoder block, Snake before the strided conv","+    A_CODEC_ENC_CONV       = auto() # encoder block, strided conv","+    A_CODEC_ENC_RES_ACT1   = auto()","+    A_CODEC_ENC_RES_CONV1  = auto()","+    A_CODEC_ENC_RES_ACT2   = auto()","+    A_CODEC_ENC_RES_CONV2  = auto()","+    A_CODEC_ENC_POST_SNAKE = auto()","+    A_CODEC_ENC_POST_CONV  = auto()","+    A_CODEC_DOWN_CONV      = auto() # quantizer downsample, strided conv + ConvNeXt","+    A_CODEC_DOWN_DWCONV    = auto()","+    A_CODEC_DOWN_NORM      = auto()","+    A_CODEC_DOWN_PW1       = auto()","+    A_CODEC_DOWN_PW2       = auto()","+    A_CODEC_DOWN_GAMMA     = auto()","+    A_CODEC_PRE_NORM       = auto() # output norm of the quantizer pre_module","+    A_CODEC_VQ_FIRST_IN    = auto() # semantic VQ input projection","+    A_CODEC_VQ_FIRST_CB    = auto() # semantic VQ codebook, l2-normalized","+    A_CODEC_VQ_REST_IN     = auto() # residual VQ input projections, merged 3D","+    A_CODEC_VQ_REST_CB     = auto() # residual VQ codebooks, l2-normalized, merged 3D","     # qwen3tts code2wav: RVQ codes -> raw PCM","     A_GEN_WAV_QUANT_FIRST_IN       = auto() # semantic RVQ, in_proj (1x1 conv, loaded as 2D)","     A_GEN_WAV_QUANT_FIRST_OUT      = auto() # semantic RVQ, out_proj","@@ -2277,6 +2299,27 @@ class MODEL_TENSOR(IntEnum):","     MODEL_TENSOR.A_GEN_CODE_EH_PROJ:        \"a.gen.code.blk.{bid}.eh_proj\",","     MODEL_TENSOR.A_GEN_CODE_BLK_EMBD:       \"a.gen.code.blk.{bid}.embd\",","     MODEL_TENSOR.A_GEN_CODE_BLK_OUT_NORM:   \"a.gen.code.blk.{bid}.out_norm\",","+    MODEL_TENSOR.A_GEN_CODE_TOK_EMBD:       \"a.gen.code.tok_embd\",","+    MODEL_TENSOR.A_CODEC_ENC_ENTRY:         \"a.codec.enc.entry\",","+    MODEL_TENSOR.A_CODEC_ENC_SNAKE:         \"a.codec.enc.blk.{bid}.snake\",","+    MODEL_TENSOR.A_CODEC_ENC_CONV:          \"a.codec.enc.blk.{bid}.conv\",","+    MODEL_TENSOR.A_CODEC_ENC_RES_ACT1:      \"a.codec.enc.blk.{bid}.res.{xid}.act1\",","+    MODEL_TENSOR.A_CODEC_ENC_RES_CONV1:     \"a.codec.enc.blk.{bid}.res.{xid}.conv1\",","+    MODEL_TENSOR.A_CODEC_ENC_RES_ACT2:      \"a.codec.enc.blk.{bid}.res.{xid}.act2\",","+    MODEL_TENSOR.A_CODEC_ENC_RES_CONV2:     \"a.codec.enc.blk.{bid}.res.{xid}.conv2\",","+    MODEL_TENSOR.A_CODEC_ENC_POST_SNAKE:    \"a.codec.enc.post_snake\",","+    MODEL_TENSOR.A_CODEC_ENC_POST_CONV:     \"a.codec.enc.post_conv\",","+    MODEL_TENSOR.A_CODEC_DOWN_CONV:         \"a.codec.down.blk.{bid}.conv\",","+    MODEL_TENSOR.A_CODEC_DOWN_DWCONV:       \"a.codec.down.blk.{bid}.dwconv\",","+    MODEL_TENSOR.A_CODEC_DOWN_NORM:         \"a.codec.down.blk.{bid}.norm\",","+    MODEL_TENSOR.A_CODEC_DOWN_PW1:          \"a.codec.down.blk.{bid}.pw1\",","+    MODEL_TENSOR.A_CODEC_DOWN_PW2:          \"a.codec.down.blk.{bid}.pw2\",","+    MODEL_TENSOR.A_CODEC_DOWN_GAMMA:        \"a.codec.down.blk.{bid}.gamma\",","+    MODEL_TENSOR.A_CODEC_PRE_NORM:          \"a.codec.pre_norm\",","+    MODEL_TENSOR.A_CODEC_VQ_FIRST_IN:       \"a.codec.vq.first.in_proj\",","+    MODEL_TENSOR.A_CODEC_VQ_FIRST_CB:       \"a.codec.vq.first.codebook\",","+    MODEL_TENSOR.A_CODEC_VQ_REST_IN:        \"a.codec.vq.rest.in_proj\",","+    MODEL_TENSOR.A_CODEC_VQ_REST_CB:        \"a.codec.vq.rest.codebook\",","     MODEL_TENSOR.A_GEN_WAV_QUANT_FIRST_IN:  \"a.gen.wav.quant.first.in_proj\",","     MODEL_TENSOR.A_GEN_WAV_QUANT_FIRST_OUT: \"a.gen.wav.quant.first.out_proj\",","     MODEL_TENSOR.A_GEN_WAV_QUANT_FIRST_CB:  \"a.gen.wav.quant.first.codebook\",","@@ -2711,6 +2754,27 @@ class MODEL_TENSOR(IntEnum):","         MODEL_TENSOR.A_GEN_CODE_EH_PROJ,"],"additions"