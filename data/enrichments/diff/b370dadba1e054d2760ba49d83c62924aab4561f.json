{"id":"b370dadba1e054d2760ba49d83c62924aab4561f","axis":"silent","repo":"grafana/grafana","sha":"b370dadba1e054d2760ba49d83c62924aab4561f","parsed":{"files":[{"path":"pkg/storage/secret/database/retry.go","lines":["@@ -0,0 +1,56 @@","+package database","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"time\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/grafana/dskit/backoff\"","+\t\"github.com/jackc/pgx/v5/pgconn\"","+\t\"github.com/lib/pq\"","+","+\t\"github.com/grafana/grafana/pkg/util/sqlite\"","+)","+","+var transientTransactionBackoff = backoff.Config{","+\tMinBackoff: 25 * time.Millisecond,","+\tMaxBackoff: 100 * time.Millisecond,","+\tMaxRetries: 4,","+}","+","+func RetryOnTransientTransactionError(ctx context.Context, operation func() error) error {","+\tboff := backoff.New(ctx, transientTransactionBackoff)","+\tvar err error","+\tfor boff.Ongoing() {","+\t\terr = operation()","+\t\tif err == nil || !isTransientTransactionError(err) {","+\t\t\treturn err","+\t\t}","+\t\tboff.Wait()","+\t}","+\tif ctxErr := ctx.Err(); ctxErr != nil {","+\t\treturn ctxErr","+\t}","+\treturn err","+}","+","+func isTransientTransactionError(err error) bool {","+\tif err == nil {","+\t\treturn false","+\t}","+\tif sqlite.IsBusyOrLocked(err) {","+\t\treturn true","+\t}","+\tif mysqlErr, ok := errors.AsType[*mysql.MySQLError](err); ok {","+\t\treturn mysqlErr.Number == 1213 || mysqlErr.Number == 1205","+\t}","+\tif pgErr, ok := errors.AsType[*pgconn.PgError](err); ok {","+\t\treturn pgErr.Code == \"40P01\" || pgErr.Code == \"40001\"","+\t}","+\tif pqErr, ok := errors.AsType[*pq.Error](err); ok {","+\t\treturn string(pqErr.Code) == \"40P01\" || string(pqErr.Code) == \"40001\"","+\t}","+","+\treturn false","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"pkg/storage/secret/database/retry_test.go","lines":["@@ -0,0 +1,108 @@","+package database","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/jackc/pgx/v5/pgconn\"","+\t\"github.com/lib/pq\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestIsTransientTransactionError(t *testing.T) {","+\tt.Parallel()","+","+\ttests := []struct {","+\t\tname string","+\t\terr  error","+\t\twant bool","+\t}{","+\t\t{name: \"nil\", err: nil, want: false},","+\t\t{name: \"unrelated\", err: errors.New(\"unrelated\"), want: false},","+\t\t{name: \"mysql deadlock\", err: &mysql.MySQLError{Number: 1213}, want: true},","+\t\t{name: \"mysql lock timeout\", err: &mysql.MySQLError{Number: 1205}, want: true},","+\t\t{name: \"wrapped mysql deadlock\", err: fmt.Errorf(\"wrapped: %w\", &mysql.MySQLError{Number: 1213}), want: true},","+\t\t{name: \"pgx deadlock\", err: &pgconn.PgError{Code: \"40P01\"}, want: true},","+\t\t{name: \"pgx serialization\", err: &pgconn.PgError{Code: \"40001\"}, want: true},","+\t\t{name: \"pq deadlock\", err: &pq.Error{Code: \"40P01\"}, want: true},","+\t\t{name: \"pq serialization\", err: &pq.Error{Code: \"40001\"}, want: true},","+\t\t{name: \"stringified mysql deadlock\", err: errors.New(\"Error 1213 (40001): Deadlock found when trying to get lock\"), want: false},","+\t\t{name: \"stringified postgres serialization\", err: errors.New(\"SQLSTATE 40001\"), want: false},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\trequire.Equal(t, tt.want, isTransientTransactionError(tt.err))","+\t\t})","+\t}","+}","+","+func TestRetryTransientTransaction(t *testing.T) {","+\tt.Run(\"retries a transient error until success\", func(t *testing.T) {","+\t\tattempts := 0","+\t\terr := RetryOnTransientTransactionError(t.Context(), func() error {","+\t\t\tattempts++","+\t\t\tif attempts < 3 {","+\t\t\t\treturn &mysql.MySQLError{Number: 1213}","+\t\t\t}","+\t\t\treturn nil","+\t\t})","+","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, 3, attempts)","+\t})","+","+\tt.Run(\"does not retry a permanent error\", func(t *testing.T) {","+\t\tattempts := 0","+\t\tpermanentErr := errors.New(\"permanent\")","+\t\terr := RetryOnTransientTransactionError(t.Context(), func() error {","+\t\t\tattempts++","+\t\t\treturn permanentErr","+\t\t})","+","+\t\trequire.ErrorIs(t, err, permanentErr)","+\t\trequire.Equal(t, 1, attempts)","+\t})","+","+\tt.Run(\"stops after the maximum attempts\", func(t *testing.T) {","+\t\tattempts := 0","+\t\tdeadlockErr := &mysql.MySQLError{Number: 1213}","+\t\terr := RetryOnTransientTransactionError(t.Context(), func() error {","+\t\t\tattempts++","+\t\t\treturn deadlockErr","+\t\t})","+","+\t\trequire.ErrorIs(t, err, deadlockErr)","+\t\trequire.Equal(t, transientTransactionBackoff.MaxRetries, attempts)","+\t})","+","+\tt.Run(\"does not invoke operation when already canceled\", func(t *testing.T) {","+\t\tctx, cancel := context.WithCancel(t.Context())","+\t\tcancel()","+\t\terr := RetryOnTransientTransactionError(ctx, func() error {","+\t\t\tt.Fatal(\"operation called after cancellation\")","+\t\t\treturn nil","+\t\t})","+","+\t\trequire.ErrorIs(t, err, context.Canceled)","+\t})","+","+\tt.Run(\"honors context cancellation while waiting\", func(t *testing.T) {","+\t\tctx, cancel := context.WithCancel(t.Context())","+\t\tdefer cancel()","+\t\tattempts := 0","+\t\terr := RetryOnTransientTransactionError(ctx, func() error {","+\t\t\tattempts++","+\t\t\ttime.AfterFunc(time.Millisecond, cancel)","+\t\t\treturn &mysql.MySQLError{Number: 1213}","+\t\t})","+","+\t\trequire.ErrorIs(t, err, context.Canceled)","+\t\trequire.Equal(t, 1, attempts)","+\t})","+}"],"additions":108,"deletions":0,"truncated":false},{"path":"pkg/storage/secret/metadata/secure_value_store.go","lines":["@@ -15,6 +15,7 @@ import ("," \tsecretv1beta1 \"github.com/grafana/grafana/apps/secret/pkg/apis/secret/v1beta1\""," \t\"github.com/grafana/grafana/pkg/registry/apis/secret/contracts\""," \t\"github.com/grafana/grafana/pkg/registry/apis/secret/xkube\"","+\tsecretdatabase \"githu