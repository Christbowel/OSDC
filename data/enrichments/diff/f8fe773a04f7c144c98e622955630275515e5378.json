ame.isBlank()) {","+            return \"Name must not be empty\";","+        }","+        String trimmed = name.trim();","+        if (trimmed.equals(\".\") || trimmed.equals(\"..\")) {","+            return \"Invalid name: \" + trimmed;","+        }","+        // A name is a single path segment: reject anything that could turn it into a path (absolute paths such as","+        // /usr/evil, parent traversal, drive letters like C:\\).","+        if (trimmed.indexOf('/') >= 0 || trimmed.indexOf('\\\\') >= 0) {","+            return \"Name must not contain path separators\";","+        }","+        if (trimmed.indexOf(':') >= 0) {","+            return \"Name must not contain ':'\";","+        }","+        if (trimmed.length() > 255) {","+            return \"Name is too long (max 255 characters)\";"],"additions":54,"deletions":0,"truncated":false}],"additions":468,"deletions":36,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-09-03T12:17:23.283511+00:00"}