{"id":"c3bb69bcb8dedb1053465d3076c417ed38a86980","axis":"silent","repo":"comet-ml/comet-llm","sha":"c3bb69bcb8dedb1053465d3076c417ed38a86980","parsed":{"files":[{"path":"apps/opik-backend/config.yml","lines":["@@ -2344,3 +2344,125 @@ redaction:","   # on long base64 payloads. The match budget now bounds that rather than leaving it to the pattern, but an","   # anchored rule is still the difference between exact masking and a value withheld whole.","   rules: '${OPIK_REDACTION_RULES:-[]}'","+","+# ai-labels: AI-generated labels (e.g. a trace summary) for every ended trace in opted-in workspaces, computed by","+# opik-inference. Off by default and on only in Comet-hosted deployments; opt-in is the ai_label_workspaces table.","+# Requires databaseAnalyticsDataModel.traceColumnsNonNullable (the cut-over traces table).","+aiLabels:","+  #  Default: false","+  #  Description: Runs the ai-labels job. Server-side only, never exposed to the UI.","+  enabled: ${AI_LABELS_ENABLED:-false}","+  #  Default: unset (the tasks bundled under ai-labels/tasks/)","+  #  Description: Directory of task YAML to load instead of the bundled tasks","+  tasksDir: ${AI_LABELS_TASKS_DIR:-}","+  inference:","+    #  Description: opik-inference base URL. Required when enabled.","+    url: ${AI_LABELS_INFERENCE_URL:-}","+    #  Description: opik-inference deployment credential, from a secret. Required when enabled. Never logged.","+    credential: ${AI_LABELS_INFERENCE_CREDENTIAL:-}","+    #  Default: 5s","+    #  Description: Per call to opik-inference, cut to the time left before the tick's deadline","+    connectTimeout: ${AI_LABELS_INFERENCE_CONNECT_TIMEOUT:-5s}","+    #  Default: 30s","+    #  Description: Per call to opik-inference, cut to the time left before the tick's deadline. Also the time a tick's","+    #  sends get past tickBudget, so it lengthens the leader lease","+    readTimeout: ${AI_LABELS_INFERENCE_READ_TIMEOUT:-30s}","+  #  Default: 16777216 (16 MiB, about 3 minutes of one L40S on the 4B model at 22K tokens/s)","+  #  Description: Global in-flight work: the cost of submitted items not yet loaded. Set as throughput x the queue time accepted","+  budgetBytes: ${AI_LABELS_BUDGET_BYTES:-16777216}","+  #  Default: 2000","+  #  Description: An item's cost per engine call beyond its request bytes. Fit from the pool's load test","+  perCallBytes: ${AI_LABELS_PER_CALL_BYTES:-2000}","+  #  Default: 16384 (16 KiB)","+  #  Description: The least an item costs. At most budgetBytes / (2 x the dispatchers' batch slots)","+  minItemBytes: ${AI_LABELS_MIN_ITEM_BYTES:-16384}","+  #  Default: 60s","+  #  Description: How often the leader ticks: polls, loads, sweeps and submits","+  tickInterval: ${AI_LABELS_TICK_INTERVAL:-60s}","+  #  Default: 25s","+  #  Description: Each tick stops starting work after this long. Must be under tickInterval","+  tickBudget: ${AI_LABELS_TICK_BUDGET:-25s}","+  #  Default: 55s","+  #  Description: Under tickInterval, so every tick sweeps; a tick only submits what its own sweep found","+  sweepInterval: ${AI_LABELS_SWEEP_INTERVAL:-55s}","+  #  Default: 5m","+  #  Description: How often the backlog and latency gauges are recomputed, one sweep-sized query per bucket","+  healthInterval: ${AI_LABELS_HEALTH_INTERVAL:-5m}","+  #  Default: 7d","+  #  Description: H, how far back (by trace created_at) traces are labeled; under overload the oldest age out of it.","+  #  The sweep scans every trace in H each tick, so its cost grows with H","+  horizon: ${AI_LABELS_HORIZON:-7d}","+  #  Default: 1h","+  #  Description: Q, how long a trace must go without updates before it is labeled","+  quietPeriod: ${AI_LABELS_QUIET_PERIOD:-1h}","+  #  Default: 15m","+  #  Description: The labeling SLO is quietPeriod + sloSlack; only the headline gauges use it","+  sloSlack: ${AI_LABELS_SLO_SLACK:-15m}","+  retry:","+    #  Default: 2","+    #  Description: X, Opik-side attempts per (trace, task), on top of the service's own retries","+    maxAttempts: ${AI_LABELS_RETRY_MAX_ATTEMPTS:-2}","+    #  Default: 15m","+    #  Description: D, the wait before a retryable failure is picked up again","+    delay: ${AI_LABELS_RETRY_DELAY:-15m}","+  #  Default: 1000","+  #  Description: The most traces one submit turn renders","+  chunkTraces: ${AI_LABELS_CHUNK_TRACES:-1000}","+  #  Default: 4","+  #  Description: Finished jobs whose results are read in parallel","+  loadConcurrency: ${AI_LABELS_LOAD_CONCURRENCY:-4}","+  #  Default: 200000","+  #  Description: A tick stops starting job loads once it holds this many label and status rows","+  loadMaxRows: ${AI_LABELS_LOAD_MAX_ROWS:-200000}","+  #  Default: 2000","+  #  Description: C, the most candidates one sweep returns per workspace. About 2 x budgetBytes / minItemBytes, the most","+  #  traces one tick admits; scale it with the budget","+  perWorkspaceCandidates: ${AI_LABELS_PER_WORKSPACE_CANDIDATES:-2000}","+  #  Default: 2097152 (2 MiB; the opik-inference gateway rejects bodies over 8 MiB)","+  #  Description: A submitted job's request body is kept under this size","+  maxJobBytes: ${AI_LABELS_MAX_JOB_BYTES:-2097152}","+  #  Default: 49152 (48 KiB, about 12k tokens at UTF-8 bytes / 4)","+  #  Description: The rendered trace's share of the model input","+  renderBudgetBytes: ${AI_LABELS_RENDER_BUDGET_BYTES:-49152}","+  #  Default: 100000","+  #  Description: The whole model input: a task's prompt plus the rendered trace. Must be over renderBudgetBytes","+  modelInputBudgetBytes: ${AI_LABELS_MODEL_INPUT_BUDGET_BYTES:-100000}","+  #  Default: 4","+  #  Description: Traces rendered in parallel by a submit turn","+  renderThreads: ${AI_LABELS_RENDER_THREADS:-4}","+  #  Default: 200","+  #  Description: A trace's spans are read in start order up to this many; 200 keeps every span of 99.8% of traces","+  maxSpansPerTrace: ${AI_LABELS_MAX_SPANS_PER_TRACE:-200}","+  #  Default: 16777216 (16 MiB)","+  #  Description: A trace's spans are read in start order up to this much input and output","+  maxSpanBytesPerTrace: ${AI_LABELS_MAX_SPAN_BYTES_PER_TRACE:-16777216}","+  #  Default: 67108864 (64 MiB)","+  #  Description: A chunk's spans are read in batches of traces up to this much span input and output","+  renderReadBytes: ${AI_LABELS_RENDER_READ_BYTES:-67108864}","+  #  Default: 1048576 (1 MiB)","+  #  Description: A larger trace or span field is replaced whole in SQL, before it reaches the JVM","+  maxFieldBytes: ${AI_LABELS_MAX_FIELD_BYTES:-1048576}","+  history:","+    #  Default: 20","+    #  Description: K, the most earlier turns of a trace's thread read for tasks that use {{history}}","+    turns: ${AI_LABELS_HISTORY_TURNS:-20}","+    #  Default: 2048","+    #  Description: Each earlier turn's input and output is cut in the middle to this many UTF-8 bytes","+    maxFieldBytes: ${AI_LABELS_HISTORY_MAX_FIELD_BYTES:-2048}","+    #  Default: 24h","+    #  Description: Earlier turns whose id time is more than this before the trace's are not read","+    lookback: ${AI_LABELS_HISTORY_LOOKBACK:-24h}","+  sweep:","+    #  Default: 8","+    #  Description: N, enabled workspaces are split into this many buckets, one sweep query each","+    buckets: ${AI_LABELS_SWEEP_BUCKETS:-8}","+    #  Default: 30000000","+    #  Description: Per sweep query on the shared ClickHouse; a trip skips that bucket for the tick","+    maxRowsToRead: ${AI_LABELS_SWEEP_MAX_ROWS_TO_READ:-30000000}","+    #  Default: 1073741824 (1 GiB)","+    #  Description: Per sweep query on the shared ClickHouse; a trip skips that bucket for the tick","+    maxMemoryUsage: ${AI_LABELS_SWEEP_MAX_MEMORY_USAGE:-1073741824}","+    #  Default: 50s","+    #  Description: Per sweep query on the shared ClickHouse; a trip skips that bucket for the tick. Lengthens the leader","+    #  lease when over readTimeout","+    maxExecutionTime: ${AI_LABELS_SWEEP_MAX_EXECUTION_TIME:-50s}"],"additions":122,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/api/resources/v1/events/TraceDeletedListener.java","lines":["@@ -5,6 +5,8 @@"," import com.comet.opik.domain.CommentService;"," import com.comet.opik.domain.FeedbackScoreService;"," import com.comet.opik.domain.SpanService;","+import com.comet.opik.domain.ailabels.AiLabelStatusDAO;","+import com.comet.opik.domain.ailabels.AiLabelsDAO;"," import com.comet.opik.domain.attachment.AttachmentService;"," import com.comet.opik.infrastructure.auth.RequestContext;"," import com.google.common.eventbus.Subscribe;","@@ -29,10 +31,12 @@ public class TraceDeletedListener {","     private final @NonNull CommentService commentService;","     private final @NonNull AttachmentService attachmentService;","     private final @NonNull SpanService spanService;","+    private final @NonNull AiLabelsDAO aiLabelsDAO;","+    private final @NonNull AiLabelStatusDAO aiLabelStatusDAO;"," ","     /**","      * Handles the TracesDeleted event by asynchronously deleting related entities.","-     * This includes feedback scores, comments, attachments, and spans associated with the deleted traces.","+     * This includes feedback scores, comments, attachments, ai-labels and spans associated with the deleted traces.","      *","      * @param event the TracesDeleted event containing the trace IDs that were deleted","      */","@@ -77,6 +81,15 @@ private Mono<Void> processTraceDeletion(Set<UUID> traceIds, @NonNull UUID projec","                 .then(Mono.defer(() -> commentService.deleteByEntityIds(CommentDAO.EntityType.TRACE, traceIds,","                         projectId)))","                 .then(Mono.defer(() -> attachmentService.deleteByEntityIds(TRACE, traceIds, projectId)))","+                // Unconditional, even with ai-labels off: labels hold trace-derived text and must not outlive the trace.","+                // A failure there must not skip the span cascade; retention removes any rows left behind.","+                .then(Mono.defer(() -> aiLabelsDAO.deleteByTraceIds(traceIds, projectId)","+                        .then(aiLabelStatusDAO.deleteByTraceIds(traceIds, projectId))","+                        .onErrorResume(error -> {","+                            log.error(\"Failed to delete ai-labels for deleted traces, count '{}'\", traceIds.size(),","+                                    error);","+                            return Mono.empty();","+                        })))","                 .then(Mono.defer(() -> spanService.deleteByTraceIds(traceIds, projectId)));","     }"," }"],"additions":14,"deletions":1,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabel.java","lines":["@@ -0,0 +1,51 @@","+package com.comet.opik.domain.ailabels;","+","+import com.fasterxml.jackson.annotation.JsonValue;","+import lombok.Builder;","+import lombok.Getter;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+","+import java.util.Map;","+import java.util.UUID;","+","+/**","+ * One row of {@code ai_labels}: one value of one (trace, task). {@code key} is a question id without its task prefix,","+ * or {@code output} for a generate task. Only the columns of its {@code answerType} are set.","+ */","+@Builder(toBuilder = true)","+public record AiLabel(","+        @NonNull String workspaceId,","+        @NonNull UUID projectId,","+        @NonNull String task,","+        @NonNull UUID traceId,","+        @NonNull String key,","+        int taskVersion,","+        @NonNull AnswerType answerType,","+        Float noul,","+        Float score,","+        String choice,","+        Float confidence,","+        @NonNull Map<String, Float> probabilities,","+        @NonNull Map<String, String> legend,","+        @NonNull String output) {","+","+    public static final String OUTPUT_KEY = \"output\";","+","+    public AiLabel {","+        probabilities = Map.copyOf(probabilities);","+        legend = Map.copyOf(legend);","+    }","+","+    @Getter","+    @RequiredArgsConstructor","+    public enum AnswerType {","+        NOUL(\"noul\"),","+        CHOICE(\"choice\"),","+        SCORE(\"score\"),","+        OUTPUT(\"output\");","+","+        @JsonValue","+        private final String value;","+    }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelEndpoint.java","lines":["@@ -0,0 +1,16 @@","+package com.comet.opik.domain.ailabels;","+","+import com.comet.opik.infrastructure.db.HasValue;","+import com.fasterxml.jackson.annotation.JsonValue;","+import lombok.Getter;","+import lombok.RequiredArgsConstructor;","+","+@Getter","+@RequiredArgsConstructor","+public enum AiLabelEndpoint implements HasValue {","+    DECIDE(\"decide\"),","+    GENERATE(\"generate\");","+","+    @JsonValue","+    private final String value;","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelJob.java","lines":["@@ -0,0 +1,36 @@","+package com.comet.opik.domain.ailabels;","+","+import com.comet.opik.infrastructure.db.HasValue;","+import jakarta.annotation.Nullable;","+import lombok.Builder;","+import lombok.Getter;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+","+import java.time.Instant;","+","+/**","+ * One row of {@code ai_label_jobs}: an opik-inference batch job. {@code bytes}, its items' cost, is what it costs","+ * against the in-flight budget while {@code submitted}.","+ */","+@Builder(toBuilder = true)","+public record AiLabelJob(","+        @NonNull String jobId,","+        @NonNull String workspaceId,","+        @NonNull AiLabelEndpoint endpoint,","+        boolean cache,","+        int itemCount,","+        long bytes,","+        @NonNull Status status,","+        @NonNull Instant submittedAt,","+        @Nullable Instant terminalAt) {","+","+    @Getter","+    @RequiredArgsConstructor","+    public enum Status implements HasValue {","+        SUBMITTED(\"submitted\"),","+        LOADED(\"loaded\");","+","+        private final String value;","+    }","+}"],"additions":36,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelJobDAO.java","lines":["@@ -0,0 +1,95 @@","+package com.comet.opik.domain.ailabels;","+","+import com.comet.opik.infrastructure.db.AbstractEnumColumnMapper;","+import com.comet.opik.infrastructure.db.UUIDArgumentFactory;","+import org.jdbi.v3.sqlobject.config.RegisterArgumentFactory;","+import org.jdbi.v3.sqlobject.config.RegisterColumnMapper;","+import org.jdbi.v3.sqlobject.config.RegisterConstructorMapper;","+import org.jdbi.v3.sqlobject.customizer.Bind;","+import org.jdbi.v3.sqlobject.customizer.BindList;","+import org.jdbi.v3.sqlobject.customizer.BindMethods;","+import org.jdbi.v3.sqlobject.statement.SqlBatch;","+import org.jdbi.v3.sqlobject.statement.SqlQuery;","+import org.jdbi.v3.sqlobject.statement.SqlUpdate;","+","+import java.time.Instant;","+import java.util.Arrays;","+import java.util.Collection;","+import java.util.List;","+","+/**","+ * The opik-inference jobs ai-labels has submitted, and the (trace, task) items of those still in flight. A job and its","+ * items are written in one transaction, and its items are deleted in the one that marks it loaded. An empty id list","+ * matches nothing.","+ */","+@RegisterArgumentFactory(AiLabelJobDAO.EndpointMapper.class)","+@RegisterArgumentFactory(AiLabelJobDAO.StatusMapper.class)","+@RegisterArgumentFactory(UUIDArgumentFactory.class)","+@RegisterColumnMapper(AiLabelJobDAO.EndpointMapper.class)","+@RegisterColumnMapper(AiLabelJobDAO.StatusMapper.class)","+@RegisterConstructorMapper(AiLabelJob.class)","+@RegisterConstructorMapper(AiLabelJobItem.class)","+public interface AiLabelJobDAO {","+","+    @SqlUpdate(\"\"\"","+            INSERT INTO ai_label_jobs (job_id, workspace_id, endpoint, cache, item_count, bytes, status, submitted_at,","+                terminal_at)","+            VALUES (:jobId, :workspaceId, :endpoint, :cache, :itemCount, :bytes, :status, :submittedAt, :terminalAt)","+            \"\"\")","+    void insert(@BindMethods AiLabelJob job);","+","+    @SqlBatch(\"\"\"","+            INSERT INTO ai_label_job_items (job_id, workspace_id, project_id, trace_id, trace_created_at, task,","+                task_version, renderer_version, compaction_level, attempt)","+            VALUES (:jobId, :workspaceId, :projectId, :traceId, :traceCreatedAt, :task, :taskVersion, :rendererVersion,","+                :compactionLevel, :attempt)","+            \"\"\")","+    void insertItems(@BindMethods List<AiLabelJobItem> items);","+","+    @SqlQuery(\"SELECT * FROM ai_label_jobs WHERE status = 'submitted' ORDER BY submitted_at\")","+    List<AiLabelJob> submitted();","+","+    @SqlQuery(\"SELECT * FROM ai_label_job_items WHERE job_id IN (<jobIds>)\")","+    List<AiLabelJobItem> findItems(","+            @BindList(value = \"jobIds\", onEmpty = BindList.EmptyHandling.NULL_STRING) Collection<String> jobIds);","+","+    /** The traces with a task in flight in any of the workspaces: the sweep leaves them out. */","+    @SqlQuery(\"SELECT DISTINCT trace_id FROM ai_label_job_items WHERE workspace_id IN (<workspaceIds>)\")","+    List<String> inFlightTraceIds(","+            @BindList(value = \"workspaceIds\", onEmpty = BindList.EmptyHandling.NULL_STRING) Collection<String> workspaceIds);","+","+    @SqlUpdate(\"UPDATE ai_label_jobs SET status = 'loaded', terminal_at = :terminalAt WHERE job_id IN (<jobIds>)\")","+    int markLoaded(@BindList(value = \"jobIds\", onEmpty = BindList.EmptyHandling.NULL_STRING) Collection<String> jobIds,","+            @Bind(\"terminalAt\") Instant terminalAt);","+","+    @SqlUpdate(\"DELETE FROM ai_label_job_items WHERE job_id IN (<jobIds>)\")","+    int deleteItems(","+            @BindList(value = \"jobIds\", onEmpty = BindList.EmptyHandling.NULL_STRING) Collection<String> jobIds);","+","+    @SqlQuery(\"SELECT COALESCE(SUM(bytes), 0) FROM ai_label_jobs WHERE status = 'submitted'\")","+    long inFlightBytes();","+","+    @SqlUpdate(\"DELETE FROM ai_label_jobs WHERE status = 'loaded' AND terminal_at < :before\")","+    int deleteLoadedBefore(@Bind(\"before\") Instant before);","+","+    class EndpointMapper extends AbstractEnumColumnMapper<AiLabelEndpoint> {","+        public EndpointMapper() {","+            super(value -> Arrays.stream(AiLabelEndpoint.values())","+                    .filter(endpoint -> endpoint.getValue().equals(value))","+                    .findFirst()","+                    .orElseThrow(() -> new IllegalArgumentException(\"Unknown ai-label endpoint '%s'\".formatted(value))),","+                    \"ai_label_endpoint\");","+        }","+    }","+","+    class StatusMapper extends AbstractEnumColumnMapper<AiLabelJob.Status> {","+        public StatusMapper() {","+            super(value -> Arrays.stream(AiLabelJob.Status.values())","+                    .filter(status -> status.getValue().equals(value))","+                    .findFirst()","+                    .orElseThrow(","+                            () -> new IllegalArgumentException(\"Unknown ai-label job status '%s'\".formatted(value))),","+                    \"ai_label_job_status\");","+        }","+    }","+}"],"additions":95,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelJobItem.java","lines":["@@ -0,0 +1,51 @@","+package com.comet.opik.domain.ailabels;","+","+import lombok.Builder;","+import lombok.NonNull;","+","+import java.time.Instant;","+import java.util.UUID;","+","+/**","+ * One row of {@code ai_label_job_items}: a (trace, task) in flight in a submitted job, with what its status row needs","+ * once the job loads: the attempt, the versions and the {@code compaction_level} recorded at submit.","+ */","+@Builder(toBuilder = true)","+public record AiLabelJobItem(","+        @NonNull String jobId,","+        @NonNull String workspaceId,","+        @NonNull UUID projectId,","+        @NonNull UUID traceId,","+        @NonNull Instant traceCreatedAt,","+        @NonNull String task,","+        int taskVersion,","+        int rendererVersion,","+        @NonNull String compactionLevel,","+        int attempt) {","+","+    public AiLabelStatus status(@NonNull AiLabelStatus.Status status, boolean retryable, @NonNull String errorCode) {","+        return AiLabelStatus.builder()","+                .workspaceId(workspaceId)","+                .projectId(projectId)","+                .task(task)","+                .traceId(traceId)","+                .traceCreatedAt(traceCreatedAt)","+                .taskVersion(taskVersion)","+                .rendererVersion(rendererVersion)","+                .status(status)","+                .retryable(retryable)","+                .attempt(attempt)","+                .errorCode(errorCode)","+                .jobId(jobId)","+                .compactionLevel(compactionLevel)","+                .build();","+    }","+","+    public AiLabelStatus done() {","+        return status(AiLabelStatus.Status.DONE, false, \"\");","+    }","+","+    public AiLabelStatus failed(@NonNull String errorCode, boolean retryable) {","+        return status(AiLabelStatus.Status.FAILED, retryable, errorCode);","+    }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelStatus.java","lines":["@@ -0,0 +1,41 @@","+package com.comet.opik.domain.ailabels;","+","+import com.fasterxml.jackson.annotation.JsonValue;","+import lombok.Builder;","+import lombok.Getter;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+","+import java.time.Instant;","+import java.util.UUID;","+","+/**","+ * One row of {@code ai_label_status}: the pipeline state of one (trace, task). The latest row per (trace, task) is","+ * authoritative; {@code updated_at} is set by ClickHouse at insert.","+ */","+@Builder(toBuilder = true)","+public record AiLabelStatus(","+        @NonNull String workspaceId,","+        @NonNull UUID projectId,","+        @NonNull String task,","+        @NonNull UUID traceId,","+        @NonNull Instant traceCreatedAt,","+        int taskVersion,","+        int rendererVersion,","+        @NonNull Status status,","+        boolean retryable,","+        int attempt,","+        @NonNull String errorCode,","+        @NonNull String jobId,","+        @NonNull String compactionLevel) {","+","+    @Getter","+    @RequiredArgsConstructor","+    public enum Status {","+        DONE(\"done\"),","+        FAILED(\"failed\");","+","+        @JsonValue","+        private final String value;","+    }","+}"],"additions":41,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelStatusDAO.java","lines":["@@ -0,0 +1,132 @@","+package com.comet.opik.domain.ailabels;","+","+import com.comet.opik.infrastructure.db.JsonEachRowBulkInsert;","+import com.comet.opik.utils.JsonUtils;","+import io.r2dbc.spi.ConnectionFactory;","+import io.r2dbc.spi.Row;","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import org.apache.commons.collections4.CollectionUtils;","+import reactor.core.publisher.Flux;","+import reactor.core.publisher.Mono;","+","+import java.time.Instant;","+import java.util.Arrays;","+import java.util.List;","+import java.util.Map;","+import java.util.Objects;","+import java.util.Set;","+import java.util.UUID;","+import java.util.function.Function;","+import java.util.stream.Collectors;","+","+import static com.comet.opik.infrastructure.FilterUtils.getLogComment;","+import static com.comet.opik.infrastructure.FilterUtils.getSTWithLogComment;","+","+/**","+ * {@code ai_label_status}: the outcome of each (trace, task), whose latest row is authoritative. Writes are","+ * plain batched inserts; {@code updated_at} is stamped by ClickHouse. Reads dedupe explicitly with {@code LIMIT 1 BY}","+ * and never rely on merges. The sweep and headline queries live with the sweep.","+ */","+@Singleton","+@RequiredArgsConstructor(onConstructor_ = @Inject)","+public class AiLabelStatusDAO {","+","+    static final String TABLE = \"ai_label_status\";","+","+    private static final Map<String, AiLabelStatus.Status> STATUSES = Arrays.stream(AiLabelStatus.Status.values())","+            .collect(Collectors.toUnmodifiableMap(AiLabelStatus.Status::getValue, Function.identity()));","+","+    /**","+     * The latest row of every (trace, task) of the given traces. Filters on mutable columns go after the dedup, so an","+     * older row can never stand in for the latest.","+     */","+    private static final String FIND_LATEST_BY_TRACE_IDS = \"\"\"","+            SELECT workspace_id, project_id, task, trace_id, trace_created_at, task_version, renderer_version, status,","+                retryable, attempt, error_code, job_id, compaction_level","+            FROM ai_label_status","+            WHERE workspace_id = :workspace_id","+            AND trace_id IN :trace_ids","+            ORDER BY workspace_id, project_id, task, trace_id, updated_at DESC","+            LIMIT 1 BY workspace_id, project_id, task, trace_id","+            SETTINGS log_comment = '<log_comment>'","+            \"\"\";","+","+    private final @NonNull ConnectionFactory connectionFactory;","+    private final @NonNull JsonEachRowBulkInsert jsonBulkInsert;","+    private final @NonNull AiLabelTableDeletes deletes;","+","+    public Mono<Long> insert(List<AiLabelStatus> rows) {","+        if (CollectionUtils.isEmpty(rows)) {","+            return Mono.just(0L);","+        }","+        return jsonBulkInsert.insert(","+                TABLE,","+                getLogComment(\"ai-labels:insert_status\", null, null, \"rows=%d\".formatted(rows.size())),","+                rows,","+                row -> {","+                    var node = JsonUtils.createObjectNode();","+                    node.put(\"workspace_id\", row.workspaceId());","+                    node.put(\"project_id\", row.projectId().toString());","+                    node.put(\"task\", row.task());","+                    node.put(\"trace_id\", row.traceId().toString());","+                    node.put(\"trace_created_at\", row.traceCreatedAt().toString());","+                    node.put(\"task_version\", row.taskVersion());","+                    node.put(\"renderer_version\", row.rendererVersion());","+                    node.put(\"status\", row.status().getValue());","+                    node.put(\"retryable\", row.retryable());","+                    node.put(\"attempt\", row.attempt());","+                    node.put(\"error_code\", row.errorCode());","+                    node.put(\"job_id\", row.jobId());","+                    node.put(\"compaction_level\", row.compactionLevel());","+                    return node;","+                });","+    }","+","+    public Flux<AiLabelStatus> findLatestByTraceIds(@NonNull String workspaceId, @NonNull Set<UUID> traceIds) {","+        if (traceIds.isEmpty()) {","+            return Flux.empty();","+        }","+        var template = getSTWithLogComment(FIND_LATEST_BY_TRACE_IDS, \"ai-labels:find_latest_status\", workspaceId,","+                null, \"trace_ids=%d\".formatted(traceIds.size()));","+        return Mono.from(connectionFactory.create())","+                .flatMapMany(connection -> connection.createStatement(template.render())","+                        .bind(\"workspace_id\", workspaceId)","+                        .bind(\"trace_ids\", traceIds.stream().map(UUID::toString).toArray(String[]::new))","+                        .execute())","+                .flatMap(result -> result.map((row, metadata) -> toStatus(row)));","+    }","+","+    public Mono<Long> deleteForRetention(List<String> workspaceIds, UUID cutoffId, UUID lowerBound) {","+        return deletes.deleteForRetention(TABLE, workspaceIds, cutoffId, lowerBound);","+    }","+","+    public Mono<Long> deleteForRetentionBounded(Map<String, UUID> workspaceMinIds, UUID cutoffId, UUID lowerBound) {","+        return deletes.deleteForRetentionBounded(TABLE, workspaceMinIds, cutoffId, lowerBound);","+    }","+","+    /** The trace-delete cascade; workspace from the reactive context. */","+    public Mono<Void> deleteByTraceIds(Set<UUID> traceIds, UUID projectId) {","+        return deletes.deleteByTraceIds(TABLE, traceIds, projectId);","+    }","+","+    private static AiLabelStatus toStatus(Row row) {","+        return AiLabelStatus.builder()","+                .workspaceId(row.get(\"workspace_id\", String.class))","+                .projectId(UUID.fromString(row.get(\"project_id\", String.class)))","+                .task(row.get(\"task\", String.class))","+                .traceId(UUID.fromString(row.get(\"trace_id\", String.class)))","+                .traceCreatedAt(row.get(\"trace_created_at\", Instant.class))","+                .taskVersion(row.get(\"task_version\", Long.class).intValue())","+                .rendererVersion(row.get(\"renderer_version\", Long.class).intValue())","+                .status(Objects.requireNonNull(STATUSES.get(row.get(\"status\", String.class))))","+                .retryable(row.get(\"retryable\", Boolean.class))","+                .attempt(row.get(\"attempt\", Integer.class))","+                .errorCode(row.get(\"error_code\", String.class))","+                .jobId(row.get(\"job_id\", String.class))","+                .compactionLevel(row.get(\"compaction_level\", String.class))","+                .build();","+    }","+}"],"additions":132,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/ailabels/AiLabelTableDeletes.java","lines":["@@ -0,0 +1,193 @@","+package com.comet.opik.domain.ailabels;","+","+import com.comet.opik.utils.WeeklyPartitions;","+import com.google.common.base.Preconditions;","+import com.google.common.collect.Lists;","+import io.r2dbc.spi.ConnectionFactory;","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import lombok.extern.slf4j.Slf4j;","+import org.apache.commons.collections4.CollectionUtils;","+import reactor.core.publisher.Flux;","+import reactor.core.publisher.Mono;","+","+import java.util.Collection;","+import java.util.List;","+import java.util.Map;","+import java.util.Set;","+import java.util.UUID;","+","+import static com.comet.opik.infrastructure.FilterUtils.ANALYTICS_DELETE_BATCH_SIZE;","+import static com.comet.opik.infrastructure.FilterUtils.getSTWithLogComment;","+import static com.comet.opik.utils.AsyncUtils.makeMonoContextAware;","+import static com.comet.opik.utils.template.TemplateUtils.getQueryItemPlaceHolder;","+","+/**","+ * The deletes {@code ai_labels} and {@code ai_label_status} share. Both are keyed by {@code trace_id} and partitioned","+ * by the trace's week exactly as {@code traces_local_v2} is, so their rows are deleted with their traces: by","+ * retention, with the trace sweep's own workspaces, id range, week predicate and experiment exclusion, and by the","+ * trace-delete cascade.","+ */","+@Slf4j","+@Singleton","+@RequiredArgsConstructor(onConstructor_ = @Inject)"],"additions":35,"deletions":0,"truncated":false}],"additions":593,"deletions":1,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-21T13:28:11.152427+00:00"}