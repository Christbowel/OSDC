ffero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+","+package org.elasticsearch.index.engine;","+","+import org.elasticsearch.index.IndexMode;","+import org.elasticsearch.telemetry.TelemetryProvider;","+import org.elasticsearch.telemetry.metric.LongCounter;","+import org.elasticsearch.telemetry.metric.MeterRegistry;","+import org.elasticsearch.telemetry.metric.MetricAttributes;","+","+import java.util.Map;","+","+/**","+ * APM metrics for flushes. The failure count is for internal alerting on unexpected flush failures, so it is not part of the public","+ * stats API.","+ */","+public class FlushMetrics {","+","+    public static final String FLUSH_UNEXPECTED_FAILURE_TOTAL = \"es.flush.unexpected_failure.total\";","+    public static final String FLUSH_UNEXPECTED_FAILURE_BLOBSTORE_TRANSIENT_TOTAL = \"es.flush.unexpected_failure.blobstore_transient.total\";","+    public static final FlushMetrics NOOP = new FlushMetrics(TelemetryProvider.NOOP.getMeterRegistry());","+","+    private final LongCounter flushFailures;","+    private final LongCounter flushBlobStoreTransientFailures;","+","+    public FlushMetrics(MeterRegistry meterRegistry) {","+        flushFailures = meterRegistry.registerLongCounter(","+            FLUSH_UNEXPECTED_FAILURE_TOTAL,","+            \"Number of flushes that failed for a reason not expected during normal operation; \"","+                + \"flushes rejected because the shard, engine, index writer or translog is already closed, \"","+                + \"or because of a pending translog recovery, are not counted\",","+            \"unit\"","+        );","+        flushBlobStoreTransientFailures = meterRegistry.registerLongCounter(","+            FLUSH_UNEXPECTED_FAILURE_BLOBSTORE_TRANSIENT_TOTAL,","+            \"Number of flushes that failed because the blob store was unreachable or closed; also counted in \"","+                + FLUSH_UNEXPECTED_FAILURE_TOTAL,","+            \"unit\"","+        );","+    }","+","+    public void onFailure(IndexMode indexMode, Throwable error) {","+        // the engine wraps every commit or refresh failure, so report the cause to tell those failures apart","+        final Throwable cause = error instanceof FlushFailedEngineException && error.getCause() != null ? error.getCause() : error;","+        final Map<String, Object> attributes = Map.of(","+            MetricAttributes.ES_INDEX_MODE,","+            indexMode.getName(),","+            MetricAttributes.ERROR_TYPE,","+            MetricAttributes.errorType(cause)","+        );","+        flushFailures.incrementBy(1, attributes);","+        if (MergeMetrics.isBlobStoreClientFailure(error)) {","+            flushBlobStoreTransientFailures.incrementBy(1, attributes);","+        }","+    }","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/index/engine/InternalEngine.java","lines":["@@ -3196,9 +3196,11 @@ protected void flushHoldingLock(boolean force, boolean waitIfOngoing, FlushResul","                 listener.afterFlushWithLock(generation);","             } catch (FlushFailedEngineException ex) {","                 maybeFailEngine(\"flush\", ex);","+                reportFlushFailure(ex);","                 listener.onFailure(ex);","                 return;","             } catch (Exception e) {","+                reportFlushFailure(e);","                 listener.onFailure(e);","                 return;","             } finally {","@@ -4055,7 +4057,7 @@ protected void ensureCanFlush() {","         // engine otherwise we might loose documents if the flush succeeds","         // and the translog recovery fails when we \"commit\" the translog on flush.","         if (pendingTranslogRecovery.get()) {","-       