{"id":"947265f0075329ac8de10189c0c6bf51bcb544a1","axis":"silent","repo":"pnpm/pnpm","sha":"947265f0075329ac8de10189c0c6bf51bcb544a1","parsed":{"files":[{"path":".changeset/v13-lockfile-records-resolution-settings.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+A lockfile in the experimental `v13` format now always records `autoDedupe`, `dedupeInjectedDeps`, `dedupePeerDependents` and `linkWorkspacePackages`, as `lockfile.includeResolutionSettings` does for the `v9` format. After `pnpm install --frozen-lockfile` with `autoDedupe`, `pnpm run` no longer starts another install. Run `pnpm install` once to record the settings in a `v13` lockfile written by an earlier version, since `pnpm install --frozen-lockfile` fails on it [#16583](https://github.com/pnpm/pnpm/issues/16583)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/tests.rs","lines":["@@ -482,6 +482,9 @@ fn deploy_workspace_settings_preserves_v13_lockfile_format_and_tarball_url() {","         })),","     );","     assert_eq!(manifest.get(\"lockfileIncludeTarballUrl\"), Some(&json!(true)));","+    // The v13 format records these, so the deployed workspace pins them.","+    assert_eq!(manifest.get(\"autoDedupe\"), Some(&json!(false)));","+    assert_eq!(manifest.get(\"linkWorkspacePackages\"), Some(&json!(false)));"," ","     let mut target_config = Config::default();","     settings.apply_to_config(&mut target_config, Path::new(\"deploy\"));"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/workspace_manifest.rs","lines":["@@ -70,6 +70,7 @@ pub(super) struct DeployLockfileSettings {","     pub(super) format: pnpm_lockfile::LockfileFormat,","     pub(super) include_resolution_settings: bool,","     pub(super) include_tarball_url: bool,","+    pub(super) records_resolution_settings: bool,","     pub(super) integrity_target: pnpm_lockfile::IntegrityTarget,","     pub(super) link_workspace_packages: bool,"," }","@@ -82,6 +83,7 @@ impl DeployLockfileSettings {","             format: config.lockfile_format,","             include_resolution_settings: config.lockfile_include_resolution_settings,","             include_tarball_url: config.lockfile_include_tarball_url,","+            records_resolution_settings: config.lockfile_records_resolution_settings(),","             integrity_target: config.lockfile_integrity_target,","             link_workspace_packages: false,","         }","@@ -120,12 +122,14 @@ impl DeployLockfileSettings {","                 serde_json::json!(self.integrity_target),","             );","         }","-        if self.include_resolution_settings {","+        if self.records_resolution_settings {","             manifest.insert(\"autoDedupe\".to_string(), Value::Bool(self.auto_dedupe));","             manifest.insert(","                 \"linkWorkspacePackages\".to_string(),","                 Value::Bool(self.link_workspace_packages),","             );","+        }","+        if self.include_resolution_settings {","             lockfile_settings.insert(\"includeResolutionSettings\".to_string(), Value::Bool(true));","         }","         if !lockfile_settings.is_empty() {"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_config_validation.rs","lines":["@@ -45,7 +45,7 @@ pub(super) struct AutoDedupeWithPnpr;"," "," #[derive(Debug, Display, Error, Diagnostic)]"," #[display(","-    \"Recording resolution settings in the lockfile requires local dependency resolution. Remove pnprServer or set lockfile.includeResolutionSettings to false.\"","+    \"Recording resolution settings in the lockfile requires local dependency resolution. Remove pnprServer, or set lockfile.includeResolutionSettings to false and lockfile.format to v9.\""," )]"," #[diagnostic(code(ERR_PNPM_RESOLUTION_SETTINGS_WITH_PNPR_SERVER))]"," pub(super) struct ResolutionSettingsWithPnpr;","@@ -64,7 +64,7 @@ pub(super) fn validate_pnpr_con