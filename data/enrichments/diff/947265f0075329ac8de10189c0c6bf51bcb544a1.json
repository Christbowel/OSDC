the lockfile has settings\")","         .resolution"," }"," ","@@ -77,17 +83,17 @@ fn the_lockfile_records_resolution_settings_only_when_asked() {","     install(&workspace, &[\"install\"]);","     assert_eq!(recorded(&workspace), ResolutionSettings::default());"," ","-    write_injected_workspace(&workspace, RECORDING);","-    install(&workspace, &[\"install\"]);","-    assert_eq!(","-        recorded(&workspace),","-        ResolutionSettings {","-            auto_dedupe: Some(false),","-            dedupe_injected_deps: Some(true),","-            dedupe_peer_dependents: Some(true),","-            link_workspace_packages: Some(Value::Bool(false)),","-        },","-    );","+    let defaults = ResolutionSettings {","+        auto_dedupe: Some(false),","+        dedupe_injected_deps: Some(true),","+        dedupe_peer_dependents: Some(true),","+        link_workspace_packages: Some(Value::Bool(false)),","+    };","+    for settings in [V13, RECORDING] {","+        write_injected_workspace(&workspace, settings);","+        install(&workspace, &[\"install\"]);","+        assert_eq!(recorded(&workspace), defaults, \"{settings}\");","+    }","     drop((root, mock_instance));"," }"," ","@@ -149,13 +155,22 @@ fn write_project_with_script(workspace: &Path, version: &str) {"," /// re-resolves it ([pnpm/pnpm#16583](https://github.com/pnpm/pnpm/issues/16583))."," #[test]"," fn a_frozen_install_of_a_recorded_dedupe_needs_no_further_resolution() {","+    a_frozen_install_of_a_recorded_dedupe_needs_no_further_resolution_with(RECORDING);","+}","+","+#[test]","+fn a_frozen_install_of_a_v13_lockfile_with_dedupe_needs_no_further_resolution() {","+    a_frozen_install_of_a_recorded_dedupe_needs_no_further_resolution_with(V13);","+}","+","+fn a_frozen_install_of_a_recorded_dedupe_needs_no_further_resolution_with(recording: &str) {","     let CommandTempCwd { root, workspace, npmrc_info, .. } =","         CommandTempCwd::init().add_mocked_registry();","     let AddMockedRegistry { moc