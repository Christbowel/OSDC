orded(&workspace).dedupe_injected_deps, Some(true));","     drop((root, mock_instance));"," }","+","+#[test]","+fn switching_to_the_v13_format_records_the_settings() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_injected_workspace(&workspace, \"\");","+    install(&workspace, &[\"install\"]);","+    write_injected_workspace(&workspace, V13);","+    install(&workspace, &[\"install\"]);","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).unwrap();","+    assert!(lockfile.contains(\"13.0\"), \"{lockfile}\");","+    assert_eq!(recorded(&workspace).dedupe_injected_deps, Some(true));","+    drop((root, mock_instance));","+}","+","+/// A `v13` lockfile written before the format recorded the resolution","+/// settings fails a frozen install until a regular install records them.","+#[test]","+fn a_v13_lockfile_without_the_settings_needs_a_regular_install() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_injected_workspace(&workspace, V13);","+    install(&workspace, &[\"install\"]);","+    let lockfile_path = workspace.join(\"pnpm-lock.yaml\");","+    let lockfile = fs::read_to_string(&lockfile_path).unwrap();","+    let keys =","+        [\"autoDedupe\", \"dedupeInjectedDeps\", \"dedupePeerDependents\", \"linkWorkspacePackages\"];","+    let mut stripped = lockfile","+        .lines()","+        .filter(|line| {","+            !keys","+                .iter()","+                .any(|key| {","+                    line.trim_start()","+                        .starts_with(&format!(r#\"\"{key}\"\"#))","+                })","+        })","+        .collect::<Vec<_>>()","+        .join(\"\\n\");","+    stripped.push('\\n');","+    assert_ne!(stripped, lockfile);","+    fs::write(&lockfile_path, stripped).unwrap();","+    assert_eq!(recorded(&workspace), ResolutionSettings::default());","+","+    let output = pnpm_at(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .output()","+        .unwrap();","+    assert!(!output.status.success(), \"{output:?}\");","+    let combined = format!(","+        \"{}{}\",","+        String::from_utf8_lossy(&output.stdout),","+        String::from_utf8_lossy(&output.stderr),","+    );","+    assert!(combined.contains(\"ERR_PNPM_LOCKFILE_CONFIG_MISMATCH\"), \"{combined}\");","+","+    install(&workspace, &[\"install\"]);","+    assert_eq!(recorded(&workspace).dedupe_injected_deps, Some(true));","+    drop((root, mock_instance));","+}"],"additions":111,"deletions":32,"truncated":false},{"path":"pnpm/crates/config/src/layout.rs","lines":["@@ -108,6 +108,16 @@ impl Config {","         self.lockfile_dir.is_some() || self.shared_workspace_lockfile","     }"," ","+    /// Whether the lockfile records the resolution settings","+    /// ([`pnpm_lockfile::ResolutionSettings`]). The `v13` format always does.","+    /// The `v9` format does when [`Self::lockfile_include_resolution_settings`]","+    /// is on, since older pnpm versions drop the keys from a `v9` lockfile.","+    #[must_use]","+    pub fn lockfile_records_resolution_settings(&self) -> bool {","+        self.lockfile_include_resolution_settings","+            || self.lockfile_format == pnpm_lockfile::LockfileFormat::V13","+    }","+","     /// Whether [`Self::project_scoped_optional_peers`] changes a resolution.","     /// It has no effect while [`Self::dedupe_peer_dependents`] is off,","     /// because optional peers are then project-scoped already."],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -686,7 +686,9 @@ pub struct Config {","     /// Record `autoDedupe`, `dedupeInjectedDeps`, `dedupePeerDependents` and","     /// `linkWorkspacePackages` in the lockfile's `settings`, so a lockfile","     /// resolved under other values counts as outdated. The","-    /// `lockfile.includeResolutionSettings` setting.","+    /// `lockfile.includeResolutionSettings` setting. Read it through","+    /// [`Self::lockfile_records_resolution_settings`], which the `v13` format","+    /// also turns on.","     pub lockfile_include_resolution_settings: bool,"," ","     /// Which hash the `integrity` of a package tarball entry in the lockfile"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/lockfile/src/resolution_settings.rs","lines":["@@ -5,10 +5,10 @@ use serde::{"," };"," use serde_json::Value;"," ","-/// The settings `lockfile.includeResolutionSettings` records in the","-/// lockfile's `settings`. Each one changes what a resolution writes, so a","-/// lockfile resolved under other values is outdated. Every field is unset","-/// unless that setting is on.","+/// The settings the lockfile's `settings` records under","+/// `lockfile.includeResolutionSettings` or `lockfile.format: v13`. Each one","+/// changes what a resolution writes, so a lockfile resolved under other","+/// values is outdated. Every field is unset when neither is on."," #[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]"," #[serde(rename_all = \"camelCase\")]"," pub struct ResolutionSettings {"],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/dependencies_graph_to_lockfile/tests/peer_proptest/model.rs","lines":["@@ -438,6 +438,8 @@ pub(super) fn lockfile_with_settings(","         Some(settings.peers_suffix_max_length.try_into().unwrap());","     options.catalogs = &fixture.catalogs;","     options.metadata_sources.lockfile_format = settings.format;","+    options.settings.resolution =","+        crate::fast_update_settings::resolution_settings_from_config(&fixture.config(settings));","     options.importers = fixture.manifests","         .iter()","         .map(|(id, manifest)| {"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/fast_update_settings.rs","lines":["@@ -42,10 +42,10 @@ pub(crate) fn lockfile_settings_from_config(config: &Config) -> LockfileSettings","     }"," }"," ","-/// The values `lockfile.includeResolutionSettings` records, all unset when","-/// that setting is off.","+/// The resolution settings the lockfile records, all unset unless","+/// [`Config::lockfile_records_resolution_settings`]."," pub(crate) fn resolution_settings_from_config(config: &Config) -> ResolutionSettings {","-    if !config.lockfile_include_resolution_settings {","+    if !config.lockfile_records_resolution_settings() {","         return ResolutionSettings::default();","     }","     ResolutionSettings {"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/settings.rs","lines":["@@ -146,9 +146,9 @@ pub(crate) fn check_lockfile_settings_drift(","     // from what the lockfile recorded.","     let patched_dependency_hashes =","         config.patched_dependency_hashes().map_err(FreshnessCheckError::CalcPatchHashes)?;","-    let resolution_settings = config.lockfile_include_resolution_settings.then(|| {","-        crate::fast_update_settings::resolution_settings_from_config(config)","-    });","+    let resolution_settings = config","+        .lockfile_records_resolution_settings()","+        .then(|| crate::fast_update_settings::resolution_settings_from_config(config));","     pnpm_lockfile::check_lockfile_settings(","         lockfile,","         pnpm_lockfile::LockfileSettingsCheck {"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run/auto_dedupe.rs","lines":["@@ -101,7 +101,7 @@ impl Settled<'_, '_> {","     /// `pnpmfileChecksum`, so a hook the resolution ran could have changed it.","     fn lockfile_records_auto_dedupe(self) -> bool {","         let config = self.install.context.config;","-        config.lockfile_include_resolution_settings","+        config.lockfile_records_resolution_settings()","             && !config.ignore_pnpmfile","             && self.lockfiles.wanted.loaded.is_some_and(|lockfile| {","                 lockfile.settings","@@ -129,7 +129,7 @@ pub(super) fn suggest_recording_auto_dedupe<Reporter: self::Reporter>(","     if take_frozen_path","         || !config.auto_dedupe","         || !config.lockfile","-        || config.lockfile_include_resolution_settings","+        || config.lockfile_records_resolution_settings()","         || settled.install.execution.dry_run","     {","         return;"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state.rs","lines":["@@ -322,13 +322,13 @@ pub(crate) fn registry_keys_current("," "," /// The `autoDedupe` an install records in the workspace state."," ///","-/// With `lockfile.includeResolutionSettings`, the lockfile records","+/// When [`Config::lockfile_records_resolution_settings`], the lockfile records"," /// `autoDedupe` and its freshness check holds that value to the config, so"," /// every install that kept the lockfile records the config's value."," /// Otherwise only a resolving install establishes the dedupe baseline, and"," /// `established` is what this write knows of it."," pub(crate) fn recorded_auto_dedupe(config: &Config, established: Option<bool>) -> Option<bool> {","-    if config.lockfile && config.lockfile_include_resolution_settings {","+    if config.lockfile && config.lockfile_records_resolution_settings() {","         return config.auto_dedupe.then_some(true);","     }","     established"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_state/settings.rs","lines":["@@ -402,7 +402,7 @@ fn recorded_allow_builds("," fn current_policy_settings(config: &Config) -> WorkspaceStateSettings {","     WorkspaceStateSettings {","         lockfile_include_resolution_settings: config","-            .lockfile_include_resolution_settings","+            .lockfile_records_resolution_settings()","             .then_some(true),","         lockfile_integrity_target: (config.lockfile_integrity_target","             != pnpm_lockfile::IntegrityTarget::Resource)"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/injected.rs","lines":["@@ -58,6 +58,15 @@ fn injected_sibling_decision(","     injected_sibling_decision_with_lockfile(shared_workspace_lockfile, sibling_manifest, LOCKFILE)"," }"," ","+/// [`LOCKFILE`] under `lockfileVersion: '13.0'`, which records the","+/// resolution settings at their defaults.","+fn v13_lockfile() -> String {","+    LOCKFILE.replace(\"'9.0'\", \"'13.0'\").replace(","+        \"settings:\\n\",","+        \"settings:\\n  autoDedupe: false\\n  dedupeInjectedDeps: true\\n  dedupePeerDependents: true\\n  linkWorkspacePackages: false\\n\",","+    )","+}","+"," fn injected_sibling_decision_with_lockfile(","     shared_workspace_lockfile: bool,","     sibling_manifest: Option<&serde_json::Value>,","@@ -260,7 +269,7 @@ fn assert_skipped_for_local_file_dependency(decision: &Decision) {"," "," #[test]"," fn recorded_injected_inputs_allow_a_dedicated_lockfile_repeat_install() {","-    let lockfile = LOCKFILE.replace(\"'9.0'\", \"'13.0'\");","+    let lockfile = v13_lockfile();","     assert_eq!(","         injected_sibling_decision_with_lockfile(false, Some(&unchanged_sibling()), &lockfile),","         Decision::UpToDate,","@@ -275,7 +284,7 @@ fn recorded_injected_inputs_allow_a_dedicated_lockfile_repeat_install() {"," /// its manifest."," #[test]"," fn recorded_injected_inputs_do_not_vouch_for_a_changed_nested_project() {","-    let lockfile = LOCKFILE.replace(\"'9.0'\", \"'13.0'\")","+    let lockfile = v13_lockfile()","         .replace(","             \"  pkg-a: {}\\n\",","             \"  pkg-a:\\n    dependencies:\\n      bar:\\n        specifier: 1.0.0\\n        version: 1.0.0\\n\\n  pkg-b: {}\\n\","],"additions":11,"deletions":2,"truncated":false},{"path":"pnpm/crates/workspace-state/src/lib.rs","lines":["@@ -327,7 +327,9 @@ pub struct WorkspaceStateSettings {","     pub inject_workspace_packages: Option<bool>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub link_workspace_packages: Option<serde_json::Value>,","-    /// `lockfile.includeResolutionSettings`, recorded only while it is on.","+    /// Whether the lockfile records the resolution settings, which","+    /// `lockfile.includeResolutionSettings` or `lockfile.format: v13` turns","+    /// on. Recorded only while it does.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub lockfile_include_resolution_settings: Option<bool>,","     /// `lockfile.integrityTarget`, recorded only while it is not the"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/docs/settings/store.md","lines":["@@ -216,6 +216,8 @@ A lockfile that records other values than the current settings is outdated. `pnp"," "," With `autoDedupe`, an install reuses a lockfile that records `autoDedupe: true` when nothing else changed. This also holds on a machine that did not write the lockfile, such as a server that runs `pnpm install --frozen-lockfile` and then `pnpm run`."," ","+The [`v13` format](#lockfileformat) always records these settings.","+"," pnpm v11 and earlier v12 versions do not keep these settings and remove them when they rewrite the lockfile. pnpm v12 versions before v12.10.0 fail to read a `pnpm-workspace.yaml` that sets `lockfile` to an object. Turn this setting on when everyone working on the project uses v12.10.0 or later."," "," This setting needs local dependency resolution, so an install that is not frozen fails when `pnprServer` is set.","@@ -277,6 +279,7 @@ The format differs from today's in these ways:"," - A project that a `workspace:` dependency links to records its `name`."," - The hash of a patched package is recorded once, under `patchedDependencies`. A package's deprecation message is not recorded."," - The `settings` section holds everything the lockfile records from `pnpm-workspace.yaml`: the resolution settings, `catalogs`, `overrides`, `patchedDependencies`, `ignoredOptionalDependencies` and the two checksums. A catalog entry is its specifier alone when the version follows from it.","+- The resolution settings include the ones [`lockfile.includeResolutionSettings`](#lockfileincluderesolutionsettings) lists, whatever that setting says."," "," When a peer dependency is updated, only the lines that record it change."," ","@@ -284,6 +287,8 @@ When a peer dependency is updated, only the lines that record it change."," "," pnpm reads lockfiles in both formats whatever this setting is. It writes the format this setting names whenever it resolves dependencies, and when you run `pnpm install --lockfile-only`. Versions of pnpm without this setting cannot read a lockfile in the `v13` format. The format is still changing, so a lockfile written with this setting may need regenerating with a later pnpm."," ","+The `v13` format records the [resolution settings](#lockfileincluderesolutionsettings). The next install resolves again a lockfile that does not record them yet, such as a `v9` lockfile written without `lockfile.includeResolutionSettings`, or a `v13` lockfile written by an earlier pnpm. `pnpm install --frozen-lockfile` fails on such a lockfile until a regular install records them. An install that is not frozen fails when `pnprServer` is set, because pnpr does not receive these settings.","+"," The boot document that records config dependencies and the pinned pnpm version follows the pinned pnpm, not this setting. While the project pins pnpm 13 or earlier, it keeps today's format, so that a pnpm from before this format can read the pinned version and switch to it. A project that pins pnpm 14 or later gets a boot document in the `v13` format."," "," ### gitBranchLockfile",""],"additions":5,"deletions":0,"truncated":false}],"additions":175,"deletions":54,"truncated":false,"file_count":17},"error":null,"fetched_at":"2026-11-21T16:31:58.667706+00:00"}