28::from(nonce) - i128::from(previous);","+        self.persistent_writes.push(PersistentWrite::Nonce(address, delta));","+        Ok(())","+    }","+","+    /// Reapplies the persistent writes recorded since `start` after a failed frame restored the","+    /// world.","+    ///","+    /// Forge's cheatcodes write balances and nonces outside the journal, so a revert only undoes","+    /// the journaled changes made on top of them: balances keep the write's wrapping delta, and","+    /// nonces keep its delta, saturated at the nonce bounds, unless the revert undoes the","+    /// account's creation, which resets the nonce. A failed frame that restored a snapshot","+    /// returns to the state from just before the first restore made since it started, so later","+    /// writes are dropped.","+    pub(crate) fn replay_persistent_writes(","+        &mut self,","+        cx: &mut SymCx,","+        executor: &ExecutorView<'_>,","+        start: usize,","+    ) -> Result<(), SymbolicError> {","+        let mut nonce_deltas = HashMap::<Address, i128>::default();","+        let mut created = HashSet::<Address>::default();","+        for write in self.persistent_writes.split_off(start) {","+            match write {","+                PersistentWrite::Balance(address, delta) => {","+                    let balance = self.world.balance_word_for_address(cx, executor, address);","+                    let balance = SymExpr::binop(cx, SymBinOp::Add, balance, delta.clone());","+                    self.world.set_balance_word(address, balance);","+                    self.persistent_writes.push(PersistentWrite::Balance(address, delta));","+                }","+                PersistentWrite::Nonce(address, delta) => {","+                    *nonce_deltas.entry(address).or_default() += delta;","+                }","+                PersistentWrite::Created(address) => {","+                    created.insert(address);","+                }","+                PersistentWrite::Restore => break,","+            }","+        }","+        // Each account's nonce writes are recorded again as one net change, so an enclosing","+        // replay keeps this replay's saturation.","+        for (address, delta) in nonce_deltas {","+            let previous = self.world.nonce(executor, address)?;","+            let nonce = if created.contains(&address) {","+                0","+            } else {","+                u64::try_from((i128::from(previous) + delta).max(0)).unwrap_or(u64::MAX)","+            };","+            if nonce != previous {","+                self.set_persistent_nonce(executor, address, nonce)?;","+            }","+        }","+        Ok(())","+    }"," }"," "," #[derive(Clone, Copy, Debug, PartialEq, Eq)]","@@ -2047,7 +2129,7 @@ impl SymbolicWorld {","             .push((address, key.clone()));","     }"," ","-    fn merge_replay_metadata_from(&mut self, other: &Self) {","+    pub(crate) fn merge_replay_metadata_from(&mut self, other: &Self) {","         for (symbol, slots) in &other.replay_storage_slots {","             for slot in slots {","                 self.record_replay_storage_slot(*symbol, slot.address, slot.slot);","@@ -2604,3 +2686,17 @@ impl SymbolicBlock {","         Ok(result)","     }"," }","+","+/// A cheatcode write that survives a revert of the frame that made it, see","+/// [`PathState::replay_persistent_writes`].","+#[derive(Clone, Debug)]","+pub(crate) enum PersistentWrite {","+    /// Adds a wrapping delta to an account's balance.","+    Balance(Address, SymExpr),","+    /// Adds a delta to an account's nonce.","+    Nonce(Address, i128),","+    /// Marks an account created, so a revert that undoes the creation resets its nonce.","+    Created(Address),","+    /// Marks a snapshot restore.","+    Restore,","+}"],"additions":97,"deletions":1,"truncated":false},{"path":"crates/forge/tests/cli/test_cmd/symbolic_cheatcodes.rs","lines":["@@ -2288,6 +2288,253 @@ Suite result: FAILED. 0 passed; 2 failed; 0 skipped; [ELAPSED]","     assert!(!stdout.contains(\"[PASS]\"), \"{stdout}\");"," }"," ","+#[forgetest_init]","+fn symbolic_cheat_writes_survive_reverting_call(prj: _, cmd: _) {","+    skip_unless_z3!(\"symbolic_cheat_writes_survive_reverting_call\");","+","+    prj.add_test(","+        \"SymbolicCheatWritesSurviveRevert.t.sol\",","+        r#\"","+import \"forge-std/Test.sol\";","+","+address constant TARGET = address(0x1234);","+address constant SET = address(0x1001);","+address constant UNSAFE = address(0x1002);","+address constant RESET = address(0x1003);","+Vm constant VM = Vm(address(uint160(uint256(keccak256(\"hevm cheat code\")))));","+","+interface StorageHookVm {","+    function registerSstoreHook(address target, bytes4 callback) external;","+}","+","+contract Probe {}","+","+contract HookedStore {","+    uint256 value;","+","+    function store() external {","+        value = 1;","+    }","+}","+","+contract DealingStoreHook {","+    constructor(address target) {","+        StorageHookVm(address(VM)).registerSstoreHook(target, DealingStoreHook.onStore.selector);","+    }","+","+    function onStore(address, bytes32, bytes32, bytes32) external {","+        VM.deal(address(0x2004), 1);","+        revert();","+    }","+}","+","+contract Killable {","+    function kill() external {","+        selfdestruct(payable(msg.sender));","+    }","+}","+","+contract RevertingConstructor {","+    constructor() {","+        VM.deal(address(0x2003), 1);","+        VM.setNonce(address(this), 10);","+        revert();","+    }","+}","+","+contract CheatHelper {","+    function writeAndRevert(uint256 amount) external {","+        VM.deal(TARGET, amount);","+        VM.setNonce(SET, 7);","+        VM.setNonceUnsafe(UNSAFE, 3);","+        VM.resetNonce(RESET);","+        VM.store(TARGET, 0, bytes32(uint256(1)));","+        revert();","+    }","+","+    function dealAndHalt(address who) external {","+        VM.deal(who, 1);","+        assembly {","+            invalid()","+        }","+    }","+","+    function dealAndRevert(address who) external {","+        VM.deal(who, 1);","+        revert();","+    }","+","+    function deployAndRevert() external {","+        address deployed = VM.deployCode(\"SymbolicCheatWritesSurviveRevert.t.sol:Probe\");","+        VM.setNonce(deployed, 10);","+        revert();","+    }","+","+    function restoreAndRevert() external {","+        uint256 snapshot = VM.snapshotState();","+        VM.deal(address(0x2005), 10);","+        VM.setNonce(address(0x2005), 7);","+        VM.revertToState(snapshot);","+        VM.deal(address(0x2005), 20);","+        VM.setNonce(address(0x2005), 11);","+        revert();","+    }","+","+    function dealSelfAndRevert() external payable {","+        VM.deal(address(this), 123);","+        revert();","+    }","+","+    function setNonceCreateAndRevert() external {","+        VM.setNonce(address(this), 123);","+        new Probe();","+        revert();","+    }","+","+    function nestedNonceAndRevert() external {","+        new Probe();","+        try this.lowerNonceAndRevert() {} catch {}","+        VM.setNonce(address(this), 5);","+        revert();","+    }","+","+    function lowerNonceAndRevert() external {","+        new Probe();","+        VM.setNonceUnsafe(address(this), 0);","+        revert();","+    }","+","+    function destroyedNonceAndRevert() external {","+        Killable killable = new Killable();","+        killable.kill();","+        VM.setNonce(address(killable), 10);","+        revert();","+    }","+}","+","+contract Forwarder {","+    function forward(CheatHelper helper, uint256 amount) external {","+        helper.writeAndRevert(amount);","+    }","+}","+","+// Like Forge, balance and nonce cheatcode writes survive the revert of the frame that made them,","+// while storage writes roll back.","+contract SymbolicCheatWritesSurviveRevert is Test {","+    CheatHelper helper;","+    Forwarder forwarder;","+","+    function setUp() public {","+        helper = new CheatHelper();","+        forwarder = new Forwarder();","+    }","+","+    function checkWritesSurviveNestedRevert(uint256 amount) public {","+        vm.setNonce(UNSAFE, 9);","+        vm.setNonce(RESET, 4);","+        (bool ok,) = address(forwarder).call(abi.encodeCall(Forwarder.forward, (helper, amount)));","+        assertFalse(ok);","+        assertEq(TARGET.balance, amount);","+        assertEq(vm.getNonce(SET), 7);","+        assertEq(vm.getNonce(UNSAFE), 3);","+        assertEq(vm.getNonce(RESET), 0);","+        assertEq(vm.load(TARGET, 0), bytes32(0));","+    }","+","+    function checkWritesSurviveFailedFrames() public {","+        (bool ok,) = address(helper).call(abi.encodeCall(CheatHelper.dealAndHalt, (address(0x2001))));","+        assertFalse(ok);","+        vm.expectRevert();","+        helper.dealAndRevert(address(0x2002));","+        address created = vm.computeCreateAddress(address(this), vm.getNonce(address(this)));","+        try new RevertingConstructor() {} catch {}","+        address deployed = vm.computeCreateAddress(address(helper), vm.getNonce(address(helper)));","+        (ok,) = address(helper).call(abi.encodeCall(CheatHelper.deployAndRevert, ()));","+        assertFalse(ok);","+        HookedStore hooked = new HookedStore();","+        new DealingStoreHook(address(hooked));","+        (ok,) = address(hooked).call(abi.encodeCall(HookedStore.store, ()));","+        assertFalse(ok);","+        assertEq(address(0x2001).balance, 1);","+        assertEq(address(0x2002).balance, 1);","+        assertEq(address(0x2003).balance, 1);","+        assertEq(address(0x2004).balance, 1);","+        // Undoing the creation resets the nonce.","+        assertEq(vm.getNonce(created), 0);","+        assertEq(vm.getNonce(deployed), 0);","+    }","+","+    function checkSymbolicTargetWriteSurvivesRevert(address who) public {","+        (bool ok,) = address(helper).call(abi.encodeCall(CheatHelper.dealAndRevert, (who)));","+        assertFalse(ok);","+        assertEq(who.balance, 1);","+    }","+","+    function checkWritesSurviveAsDeltas() public {","+        // The revert still undoes the call value and CREATE nonce bump made after the write.","+        vm.deal(address(this), 5);","+        CheatHelper funded = new CheatHelper();","+        (bool ok,) = address(funded).call{value: 5}(abi.encodeCall(CheatHelper.dealSelfAndRevert, ()));","+        assertFalse(ok);","+        assertEq(address(funded).balance, 118);","+","+        CheatHelper creator = new CheatHelper();","+        (ok,) = address(creator).call(abi.encodeCall(CheatHelper.setNonceCreateAndRevert, ()));","+        assertFalse(ok);","+        assertEq(vm.getNonce(address(creator)), 123);","+","+        // The inner revert saturates the nonce at 0; the outer one undoes only its own bump.","+        CheatHelper nested = new CheatHelper();","+        (ok,) = address(nested).call(abi.encodeCall(CheatHelper.nestedNonceAndRevert, ()));","+        assertFalse(ok);","+        assertEq(vm.getNonce(address(nested)), 4);","+","+        CheatHelper destroyer = new CheatHelper();","+        address killable = vm.computeCreateAddress(address(destroyer), vm.getNonce(address(destroyer)));","+        (ok,) = address(destroyer).call(abi.encodeCall(CheatHelper.destroyedNonceAndRevert, ()));","+        assertFalse(ok);","+        assertEq(vm.getNonce(killable), 0);","+    }","+","+    function checkWritesBeforeSnapshotRestoreSurvive() public {","+        // A failed frame returns to the state from just before its first snapshot restore.","+        (bool ok,) = address(helper).call(abi.encodeCall(CheatHelper.restoreAndRevert, ()));","+        assertFalse(ok);","+        assertEq(address(0x2005).balance, 10);","+        assertEq(vm.getNonce(address(0x2005)), 7);","+    }","+","+    function checkRolledBackDealFails(uint256 amount) public {","+        vm.assume(amount != 0);","+        (bool ok,) = address(helper).call(abi.encodeCall(CheatHelper.writeAndRevert, (amount)));","+        assertFalse(ok);","+        assertEq(TARGET.balance, 0);","+    }","+}","+\"#,","+    );","+","+    assert_symbolic_witness(cmd.args([","+        \"test\",","+        \"--symbolic\",","+        \"--match-contract\",","+        \"SymbolicCheatWritesSurviveRevert\",","+    ]))","+    .failure()","+    .stdout_eq(str![[r#\"","+...","+Ran 6 tests for test/SymbolicCheatWritesSurviveRevert.t.sol:SymbolicCheatWritesSurviveRevert","+[FAIL: assertion failed: [..] != 0; counterexample: \t\t[SENDER] [SENDER] [CALLDATA] [ARGS]] checkRolledBackDealFails(uint256) ([METRICS])","+[PASS] checkSymbolicTargetWriteSurvivesRevert(address) ([METRICS])","+[PASS] checkWritesBeforeSnapshotRestoreSurvive() ([METRICS])","+[PASS] checkWritesSurviveAsDeltas() ([METRICS])","+[PASS] checkWritesSurviveFailedFrames() ([METRICS])","+[PASS] checkWritesSurviveNestedRevert(uint256) ([METRICS])","+Suite result: FAILED. 5 passed; 1 failed; 0 skipped; [ELAPSED]","+...","+\"#]]);","+}","+"," #[forgetest_init]"," fn symbolic_expect_call_follows_function_mock_redirect(prj: _, cmd: _) {","     skip_unless_z3!(\"symbolic_expect_call_follows_function_mock_redirect\");",""],"additions":247,"deletions":0,"truncated":false}],"additions":383,"deletions":15,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-06T17:00:34.455155+00:00"}