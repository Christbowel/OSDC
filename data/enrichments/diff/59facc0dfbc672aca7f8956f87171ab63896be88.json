{"id":"59facc0dfbc672aca7f8956f87171ab63896be88","axis":"silent","repo":"mongodb/mongo","sha":"59facc0dfbc672aca7f8956f87171ab63896be88","parsed":{"files":[{"path":"src/third_party/wiredtiger/import.data","lines":["@@ -2,5 +2,5 @@","     \"vendor\": \"wiredtiger\",","     \"github\": \"wiredtiger/wiredtiger\",","     \"branch\": \"mongodb-master\",","-    \"commit\": \"4324a8b4c1bb68dc5bf12c6cceb42a6f8f4e5962\"","+    \"commit\": \"27dd98a1e7516dff85df4a33699509a7799bbb8a\""," }"],"additions":1,"deletions":1,"truncated":false},{"path":"src/third_party/wiredtiger/src/cursor/cur_layered_private.h","lines":["@@ -40,10 +40,9 @@ struct __wti_cursor_layered {"," ","     uint64_t next_random_seed;","     u_int next_random_sample_size;","-","+    uint32_t txn_mod_count;              /* Transaction modification count on last access */","     uint64_t snapshot_gen;               /* Snapshot generation on last access */","     uint64_t read_timestamp;             /* Read timestamp on last access */","-    uint32_t txn_mod_count;              /* Transaction modification count on last access */","     uint64_t stable_checkpoint_meta_lsn; /* Checkpoint LSN stable cursor is on */","     WTI_CLAYERED_ROLE last_role;         /* Last-observed leader/follower role (change-detection) */"," "],"additions":1,"deletions":2,"truncated":false},{"path":"src/third_party/wiredtiger/src/evict/evict_conn.c","lines":["@@ -284,20 +284,25 @@ __wt_evict_config(WT_SESSION_IMPL *session, const char *cfg[], bool reconfig)","       &cache->cache_eviction_controls.cache_tolerance_for_app_eviction,","       (((uint8_t)cval.val / 10) * 10));"," ","-    /* FIXME-WT-19007: the options below are only ever set, so reconfigure cannot turn them off. */","+    /* The boolean options are set or cleared on every reconfigure, so they can be turned off. */","     WT_RET(__wt_config_gets(session, cfg, \"eviction.incremental_app_eviction\", &cval));","     if (cval.val != 0)","         F_SET_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_EVICT_INCREMENTAL_APP);","+    else","+        F_CLR_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_EVICT_INCREMENTAL_APP);"," ","     WT_RET(__wt_config_gets(session, cfg, \"eviction.prefer_scrub_eviction\", &cval));","     if (cval.val != 0)","         F_SET_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_PREFER_SCRUB_EVICTION);","+    else","+        F_CLR_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_PREFER_SCRUB_EVICTION);"," ","     WT_RET(__wt_config_gets(session, cfg, \"eviction.skip_update_obsolete_check\", &cval));","     if (cval.val != 0)","         F_SET_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_SKIP_UPDATE_OBSOLETE_CHECK);","+    else","+        F_CLR_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_SKIP_UPDATE_OBSOLETE_CHECK);"," ","-    /* The options below are set or cleared on every reconfigure, so they can be turned off. */","     WT_RET(__wt_config_gets(session, cfg, \"eviction.bounded_wake\", &cval));","     if (cval.val != 0)","         F_SET_ATOMIC_32(&(cache->cache_eviction_controls), WT_CACHE_BOUNDED_WAKE);"],"additions":7,"deletions":2,"truncated":false},{"path":"src/third_party/wiredtiger/src/txn/txn_log.c","lines":["@@ -209,25 +209,31 @@ __txn_logrec_init(WT_SESSION_IMPL *session)","     size_t header_size;","     uint32_t rectype;","     const char *fmt;","+    bool claimed_prepare;"," ","     txn = session->txn;","     rectype = WT_LOGREC_COMMIT;","     fmt = WT_UNCHECKED_STRING(Iq);"," ","+    /* Diagnostic logging must preserve the absence of an ID for claimed prepared transactions. */","+    claimed_prepare = FLD_ISSET(S2C(session)->debug.flags, WT_CONN_DEBUG_TABLE_LOGGING) &&","+      F_ISSET(txn, WT_TXN_PREPARE) &&","+      F_ISSET(&txn->time_point, WT_TXN_TIME_POINT_HAS_PREPARED_ID) &&","+      txn->time_point.id == WT_TXN_NONE;","+","     if (txn->txn_log.logrec != NULL) {","-        WT_ASSERT(session, F_ISSET(&txn->time_point, WT_TXN_TIME_POINT_HAS_ID));","+        WT_ASSERT(session, F_ISSET(&txn->time_point, WT_TXN_TIME_POINT_HAS_ID) || claimed_prepare);","         return (0);","     }"," ","     /*","-     * The only way we should ever get in here without a txn id is if we are recording diagnostic","-     * information. In that case, allocate an id.","+     * Allocate an ID for diagnostic records unless the transaction was claimed after recovery.","      */","     if (FLD_ISSET(S2C(session)->debug.flags, WT_CONN_DEBUG_TABLE_LOGGING) &&","-      txn->time_point.id == WT_TXN_NONE)","+      txn->time_point.id == WT_TXN_NONE && !claimed_prepare)","         WT_RET(__wt_txn_id_check(session));","     else","-        WT_ASSERT(session, txn->time_point.id != WT_TXN_NONE);","+        WT_ASSERT(session, txn->time_point.id != WT_TXN_NONE || claimed_prepare);"," ","     WT_RET(__wt_struct_size(session, &header_size, fmt, rectype, txn->time_point.id));","     WT_RET(__wt_logrec_alloc(session, header_size, &logrec));"],"additions":11,"deletions":5,"truncated":false},{"path":"src/third_party/wiredtiger/src/txn/txn_timestamp.c","lines":["@@ -1332,6 +1332,7 @@ __txn_set_rollback_timestamp(WT_SESSION_IMPL *session, wt_timestamp_t rollback_t","           __wt_timestamp_to_string(rollback_ts, ts_string[0]),","           __wt_timestamp_to_string(stable_ts, ts_string[1]));","     }","+    WT_RET(__txn_check_follower_checkpoint_ts(session, \"rollback\", rollback_ts));","     txn->time_point.rollback_timestamp = rollback_ts;","     F_SET(&txn->time_point, WT_TXN_TIME_POINT_HAS_TS_ROLLBACK);"," "],"additions":1,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/test/catch2/misc_tests/test_evict_bool_options_reconfigure.cpp","lines":["@@ -0,0 +1,59 @@","+/*-","+ * Copyright (c) 2014-present MongoDB, Inc.","+ * Copyright (c) 2008-2014 WiredTiger, Inc.","+ *\tAll rights reserved.","+ *","+ * See the file LICENSE for redistribution information.","+ */","+","+#include <string>","+","+#include <catch2/catch.hpp>","+","+#include \"wt_internal.h\"","+#include \"../wrappers/connection_wrapper.h\"","+","+/* Turning a boolean eviction option on and then off with reconfigure must leave it off. */","+TEST_CASE(\"Boolean eviction options can be reconfigured on and off\", \"[evict]\")","+{","+    connection_wrapper conn_wrapper = connection_wrapper(\".\", \"create\");","+    WT_CONNECTION *conn = conn_wrapper.get_wt_connection();","+    WT_CACHE_EVICTION_CONTROLS *controls =","+      &conn_wrapper.get_wt_connection_impl()->cache->cache_eviction_controls;","+","+    struct {","+        const char *name;","+        uint32_t flag;","+    } options[] = {{\"incremental_app_eviction\", WT_CACHE_EVICT_INCREMENTAL_APP},","+      {\"prefer_scrub_eviction\", WT_CACHE_PREFER_SCRUB_EVICTION},","+      {\"skip_update_obsolete_check\", WT_CACHE_SKIP_UPDATE_OBSOLETE_CHECK},","+      {\"bounded_wake\", WT_CACHE_BOUNDED_WAKE}};","+","+    for (auto &option : options) {","+        const std::string on = std::string(\"eviction=[\") + option.name + \"=true]\";","+        const std::string off = std::string(\"eviction=[\") + option.name + \"=false]\";","+","+        INFO(option.name);","+        REQUIRE(conn->reconfigure(conn, on.c_str()) == 0);","+        REQUIRE(F_ISSET_ATOMIC_32(controls, option.flag));","+        REQUIRE(conn->reconfigure(conn, off.c_str()) == 0);","+        REQUIRE(!F_ISSET_ATOMIC_32(controls, option.flag));","+    }","+}","+","+/* A reconfigure that does not name a boolean eviction option must leave its current value alone. */","+TEST_CASE(\"Unrelated reconfigure preserves boolean eviction options\", \"[evict]\")","+{","+    connection_wrapper conn_wrapper =","+      connection_wrapper(\".\", \"create,eviction=[prefer_scrub_eviction=true]\");","+    WT_CONNECTION *conn = conn_wrapper.get_wt_connection();","+    WT_CACHE_EVICTION_CONTROLS *controls =","+      &conn_wrapper.get_wt_connection_impl()->cache->cache_eviction_controls;","+","+    REQUIRE(conn->reconfigure(conn, \"eviction=[incremental_app_eviction=true]\") == 0);","+    REQUIRE(conn->reconfigure(conn, \"eviction_dirty_target=6\") == 0);","+    REQUIRE(conn->reconfigure(conn, \"eviction=[app_eviction_min_cache_fill_ratio=10]\") == 0);","+","+    REQUIRE(F_ISSET_ATOMIC_32(controls, WT_CACHE_PREFER_SCRUB_EVICTION));","+    REQUIRE(F_ISSET_ATOMIC_32(controls, WT_CACHE_EVICT_INCREMENTAL_APP));","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/test/evergreen.yml","lines":["@@ -385,7 +385,7 @@ functions:","           DEFINED_EVERGREEN_CONFIG_FLAGS=${DEFINED_EVERGREEN_CONFIG_FLAGS/\\-DHAVE_BUILTIN_EXTENSION_ZSTD=1/}","         fi"," ","-        if [[ \"${build_variant|}\" =~ \"macos-14\" ]]; then","+        if [[ \"${build_variant|}\" =~ \"macos-15\" ]]; then","           # For mac builds, we want explicitly tell cmake which python to use, as","           # well as the matching library directory and header files. The find_libpython","           # module gives us the library.","@@ -411,7 +411,7 @@ functions:","              fi","           fi"," ","-          if [ \"${build_variant|}\" = \"macos-14-arm64\" ]; then","+          if [ \"${build_variant|}\" = \"macos-15-arm64\" ]; then","             DEFINED_EVERGREEN_CONFIG_FLAGS=\"$DEFINED_EVERGREEN_CONFIG_FLAGS -DPython3_EXECUTABLE=$SYSPY -DPython3_LIBRARY=$SYSPYLIB -DPython3_INCLUDE_DIR=$SYSPYINCDEF\"","           else","             DEFINED_EVERGREEN_CONFIG_FLAGS=\"$DEFINED_EVERGREEN_CONFIG_FLAGS -DPYTHON_EXECUTABLE:FILEPATH=$SYSPY -DPYTHON_LIBRARY=$SYSPYLIB -DPYTHON_INCLUDE_DIR=$SYSPYINCDEF\"","@@ -7685,10 +7685,10 @@ buildvariants:","     - name: catch2-test"," "," - <<: *mac_test_template","-  name: macos-14-arm64","-  display_name: \"macOS 14 (ARM64)\"","+  name: macos-15-arm64","+  display_name: \"macOS 15 (ARM64)\"","   run_on:","-    - macos-14-arm64","+    - macos-15-arm64","   batchtime: 120 # 2 hours","   expansions:","     python_binary: '/Library/Frameworks/Python.framework/Versions/3.11/bin/python3.11'"],"additions":5,"deletions":5,"truncated":false},{"path":"src/third_party/wiredtiger/test/evergreen_disagg.yml","lines":["@@ -389,7 +389,7 @@ functions:","           DEFINED_EVERGREEN_CONFIG_FLAGS=${DEFINED_EVERGREEN_CONFIG_FLAGS/\\-DHAVE_BUILTIN_EXTENSION_ZSTD=1/}","         fi"," ","-        if [[ \"${build_variant|}\" =~ \"macos-14\" ]]; then","+        if [[ \"${build_variant|}\" =~ \"macos-15\" ]]; then","           # For mac builds, we want explicitly tell cmake which python to use, as","           # well as the matching library directory and header files. The find_libpython","           # module gives us the library.","@@ -415,7 +415,7 @@ functions:","              fi","           fi"," ","-          if [ \"${build_variant|}\" = \"macos-14-arm64\" ]; then","+          if [ \"${build_variant|}\" = \"macos-15-arm64\" ]; then","             DEFINED_EVERGREEN_CONFIG_FLAGS=\"$DEFINED_EVERGREEN_CONFIG_FLAGS -DPython3_EXECUTABLE=$SYSPY -DPython3_LIBRARY=$SYSPYLIB -DPython3_INCLUDE_DIR=$SYSPYINCDEF\"","           else","             DEFINED_EVERGREEN_CONFIG_FLAGS=\"$DEFINED_EVERGREEN_CONFIG_FLAGS -DPYTHON_EXECUTABLE:FILEPATH=$SYSPY -DPYTHON_LIBRARY=$SYSPYLIB -DPYTHON_INCLUDE_DIR=$SYSPYINCDEF\""],"additions":2,"deletions":2,"truncated":false},{"path":"src/third_party/wiredtiger/test/suite/test_layered_stepup18.py","lines":["@@ -0,0 +1,165 @@","+#!/usr/bin/env python3","+#","+# Public Domain 2014-present MongoDB, Inc.","+# Public Domain 2008-2014 WiredTiger, Inc.","+#","+# This is free and unencumbered software released into the public domain.","+#","+# Anyone is free to copy, modify, publish, use, compile, sell, or","+# distribute this software, either in source code form or as a compiled","+# binary, for any purpose, commercial or non-commercial, and by any","+# means.","+#","+# In jurisdictions that recognize copyright laws, the author or authors","+# of this software dedicate any and all copyright interest in the","+# software to the public domain. We make this dedication for the benefit","+# of the public at large and to the detriment of our heirs and","+# successors. We intend this dedication to be an overt act of","+# relinquishment in perpetuity of all present and future rights to this","+# software under copyright law.","+#","+# THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,","+# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF","+# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.","+# IN NO EVENT SHALL THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR","+# OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,","+# ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR","+# OTHER DEALINGS IN THE SOFTWARE.","+#","+# A prepared transaction replicated to a follower is captured as prepared by a checkpoint the","+# follower adopts while its stable timestamp is behind that checkpoint. The follower rolls the","+# transaction back and then steps up. The rollback timestamp must follow the adopted checkpoint,","+# and the rolled-back state must hold on the new leader and in its next checkpoint.","+","+import os, wiredtiger, wttest","+from helper_disagg import disagg_test_class, gen_disagg_storages","+from wtscenario import make_scenarios","+","+@disagg_test_class","+class test_layered_stepup18(wttest.WiredTigerTestCase):","+    uri = 'layered:test_layered_stepup18'","+    prepared_id = 1","+","+    conn_base_config = 'statistics=(fast),precise_checkpoint=true,preserve_prepared=true,'","+    disagg_storages = gen_disagg_storages(disagg_only=True)","+    # The rolled-back key reads as it did before the prepare.","+    ops = [","+        ('insert', dict(op='insert', key=2, value=None)),","+        ('update', dict(op='update', key=1, value='committed')),","+        ('remove', dict(op='remove', key=1, value='committed')),","+    ]","+    scenarios = make_scenarios(disagg_storages, ops)","+","+    def conn_config(self):","+        return self.conn_base_config + 'disaggregated=(role=\"leader\")'","+","+    def open_follower(self, home):","+        return self.wiredtiger_open(home, self.extensionsConfig() + ',create,' +","+            self.conn_base_config + 'disaggregated=(role=\"follower\")')","+","+    def checkpoint(self, conn):","+        session = conn.open_session()","+        session.checkpoint()","+        session.close()","+","+    def prepare(self, conn):","+        session = conn.open_session()","+        cursor = session.open_cursor(self.uri)","+        session.begin_transaction()","+        if self.op == 'remove':","+            cursor.set_key(self.key)","+            self.assertEqual(cursor.remove(), 0)","+        else:","+            cursor[self.key] = 'prepared'","+        cursor.close()","+        session.prepare_transaction('prepare_timestamp=' + self.timestamp_str(100) +","+            ',prepared_id=' + self.prepared_id_str(self.prepared_id))","+        return session","+","+    def read(self, conn, ts):","+        session = conn.open_session()","+        cursor = session.open_cursor(self.uri)","+        session.begin_transaction('read_timestamp=' + self.timestamp_str(ts))","+        cursor.set_key(self.key)","+        try:","+            ret = cursor.search()","+            return cursor.get_value() if ret == 0 else None","+        except wiredtiger.WiredTigerError as e:","+            self.fail(f'reading key {self.key} at timestamp {ts} failed: {e}')","+        finally:","+            session.rollback_transaction()","+            cursor.close()","+            session.close()","+","+    def check_reads(self, conn):","+        for ts in (90, 200):","+            self.assertEqual(self.read(conn, ts), self.value)","+","+    def test_follower_rollback_resolved_by_step_up(self):","+        self.session.create(self.uri, 'key_format=i,value_format=S')","+        self.conn.set_timestamp('oldest_timestamp=' + self.timestamp_str(50) +","+            ',stable_timestamp=' + self.timestamp_str(50))","+        cursor = self.session.open_cursor(self.uri)","+        self.session.begin_transaction()","+        cursor[1] = 'committed'","+        self.session.commit_transaction('commit_timestamp=' + self.timestamp_str(60))","+        cursor.close()","+        self.conn.set_timestamp('stable_timestamp=' + self.timestamp_str(70))","+        self.checkpoint(self.conn)","+","+        conn_follow = self.open_follower('follower')","+        session_follow = conn_follow.open_session()","+        session_follow.create(self.uri, 'key_format=i,value_format=S')","+        self.disagg_advance_checkpoint_and_wait(conn_follow)","+        conn_follow.set_timestamp('stable_timestamp=' + self.timestamp_str(70))","+","+        # The same prepared transaction runs on both nodes, as if replicated.","+        leader_prepared = self.prepare(self.conn)","+        follower_prepared = self.prepare(conn_follow)","+","+        # The leader checkpoints the prepared update and the follower adopts that checkpoint while","+        # its own stable timestamp stays behind it.","+        self.conn.set_timestamp('stable_timestamp=' + self.timestamp_str(150))","+        self.checkpoint(self.conn)","+        self.disagg_advance_checkpoint_and_wait(conn_follow)","+","+        # A rollback timestamp between the follower's stable timestamp and the adopted checkpoint","+        # timestamp is rejected. A rollback_transaction call whose timestamp is rejected panics","+        # while prepared, so the timestamp is set first and the rollback takes none.","+        try:","+            self.assertRaisesWithMessage(wiredtiger.WiredTigerError,","+                lambda: follower_prepared.timestamp_transaction(","+                    'rollback_timestamp=' + self.timestamp_str(120)),","+                '/rollback timestamp .* must be after the last checkpoint timestamp .*/')","+            follower_prepared.timestamp_transaction('rollback_timestamp=' + self.timestamp_str(151))","+        finally:","+            follower_prepared.rollback_transaction()","+        follower_prepared.close()","+","+        leader_prepared.rollback_transaction('rollback_timestamp=' + self.timestamp_str(210))","+        leader_prepared.close()","+","+        # Hand leadership to the follower without a further checkpoint from the old leader.","+        self.conn.reconfigure('disaggregated=(role=\"follower\")')","+        conn_follow.reconfigure('disaggregated=(role=\"leader\")')","+        self.check_reads(conn_follow)","+","+        conn_follow.set_timestamp('stable_timestamp=' + self.timestamp_str(250))","+        self.checkpoint(conn_follow)","+        self.check_reads(conn_follow)","+        checkpoint_meta = self.disagg_get_complete_checkpoint_meta(conn_follow)","+        session_follow.close()","+        conn_follow.close('debug=(skip_checkpoint=true)')","+","+        # A node opening the new leader's checkpoint finds nothing left prepared.","+        os.mkdir('follower2')","+        os.symlink('../kv_home', 'follower2/kv_home', target_is_directory=True)","+        conn_new = self.open_follower('follower2')","+        conn_new.reconfigure(f'disaggregated=(checkpoint_meta=\"{checkpoint_meta}\")')","+        session_new = conn_new.open_session()","+        discover = session_new.open_cursor('prepared_discover:')","+        self.assertEqual(discover.next(), wiredtiger.WT_NOTFOUND)","+        discover.close()","+        session_new.close()","+        self.check_reads(conn_new)","+        conn_new.close()"],"additions":165,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/test/suite/test_layered_txn04.py","lines":["@@ -198,3 +198,105 @@ def test_follower_prepared_durable_must_follow_adopted_checkpoint(self):","                 cursor.close()","             for session in sessions:","                 session.close()","+","+    def test_follower_prepared_rollback_must_follow_adopted_checkpoint(self):","+        self.setup_leader(keys=range_inclusive(1, self.nitems))","+        self.leader_checkpoint(10)","+","+        conn_follow, session_follow = self.open_follower()","+        with closing(conn_follow), closing(session_follow):","+            self.disagg_wait_for_adoption(conn_follow)","+","+            # Keep the follower's stable timestamp behind the checkpoint it adopts below, so the","+            # stable timestamp check alone accepts every rollback timestamp in these cases.","+            conn_follow.set_timestamp('stable_timestamp=' + self.timestamp_str(10))","+","+            # Each case resolves its own prepared transaction, since a rejected timestamp leaves","+            # a prepared transaction that can only be rolled back.","+            cases = [(api, rollback_ts) for api in ('timestamp', 'timestamp_uint')","+                     for rollback_ts in (40, 50, 51)]","+            sessions = [conn_follow.open_session() for _ in cases]","+            cursors = [session.open_cursor(self.uri) for session in sessions]","+            for i, (session, cursor) in enumerate(zip(sessions, cursors)):","+                session.begin_transaction()","+                cursor[self.key(self.nitems + 1 + i)] = 'prepared'","+                session.prepare_transaction('prepare_timestamp=' + self.timestamp_str(20))","+","+            # The checkpoint moves past the prepared transactions before they resolve.","+            self.leader_checkpoint(50)","+            self.disagg_advance_checkpoint_and_wait(conn_follow)","+","+            # Collect every failure before failing, so each prepared transaction is resolved","+            # whichever case fails. A rollback_transaction call whose timestamp is rejected panics","+            # while prepared, so the timestamp is set first and the rollback takes none.","+            failures = []","+            expected_error = '/rollback timestamp .* must be after the last checkpoint timestamp .*/'","+            for session, (api, rollback_ts) in zip(sessions, cases):","+                if api == 'timestamp':","+                    set_timestamp = lambda: session.timestamp_transaction(","+                        'rollback_timestamp=' + self.timestamp_str(rollback_ts))","+                else:","+                    set_timestamp = lambda: session.timestamp_transaction_uint(","+                        wiredtiger.WT_TS_TXN_TYPE_ROLLBACK, rollback_ts)","+                try:","+                    if rollback_ts <= 50:","+                        self.assertRaisesWithMessage(","+                            wiredtiger.WiredTigerError, set_timestamp, expected_error)","+                    else:","+                        set_timestamp()","+                except (AssertionError, wiredtiger.WiredTigerError) as e:","+                    failures.append(f'{api} rollback_timestamp={rollback_ts}: {e}')","+                session.rollback_transaction()","+            if failures:","+                self.fail('\\n'.join(failures))","+","+            for cursor in cursors:","+                cursor.close()","+            for session in sessions:","+                session.close()","+","+    def test_follower_rollback_after_stable_ahead_of_checkpoint(self):","+        self.setup_leader(keys=range_inclusive(1, self.nitems))","+        self.leader_checkpoint(10)","+","+        conn_follow, session_follow = self.open_follower()","+        with closing(conn_follow), closing(session_follow):","+            self.disagg_wait_for_adoption(conn_follow)","+            conn_follow.set_timestamp('stable_timestamp=' + self.timestamp_str(10))","+","+            # Timestamp 40 fails both the stable and the checkpoint requirement, 55 only the","+            # stable one, and 61 neither.","+            rollback_timestamps = (40, 55, 61)","+            sessions = [conn_follow.open_session() for _ in rollback_timestamps]","+            cursors = [session.open_cursor(self.uri) for session in sessions]","+            for i, (session, cursor) in enumerate(zip(sessions, cursors)):","+                session.begin_transaction()","+                cursor[self.key(self.nitems + 1 + i)] = 'prepared'","+                session.prepare_transaction('prepare_timestamp=' + self.timestamp_str(20))","+","+            # The follower's stable timestamp moves past the adopted checkpoint timestamp.","+            self.leader_checkpoint(50)","+            self.disagg_advance_checkpoint_and_wait(conn_follow)","+            conn_follow.set_timestamp('stable_timestamp=' + self.timestamp_str(60))","+","+            failures = []","+            expected_error = '/rollback timestamp .* is not newer than the stable timestamp .*/'","+            for session, rollback_ts in zip(sessions, rollback_timestamps):","+                set_timestamp = lambda: session.timestamp_transaction(","+                    'rollback_timestamp=' + self.timestamp_str(rollback_ts))","+                try:","+                    if rollback_ts <= 60:","+                        self.assertRaisesWithMessage(","+                            wiredtiger.WiredTigerError, set_timestamp, expected_error)","+                    else:","+                        set_timestamp()","+                except (AssertionError, wiredtiger.WiredTigerError) as e:","+                    failures.append(f'rollback_timestamp={rollback_ts}: {e}')","+                session.rollback_transaction()","+            if failures:","+                self.fail('\\n'.join(failures))","+","+            for cursor in cursors:","+                cursor.close()","+            for session in sessions:","+                session.close()"],"additions":102,"deletions":0,"truncated":false},{"path":"src/third_party/wiredtiger/test/suite/test_prepare_discover02.py","lines":["@@ -27,8 +27,9 @@"," # OTHER DEALINGS IN THE SOFTWARE."," #"," # Test that pending prepared transaction artifacts can be discovered after recovery","-# and committed","+# and committed or rolled back."," ","+import json"," import wiredtiger"," from suite_subprocess import suite_subprocess"," import wttest"