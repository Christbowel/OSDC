all traces (including on-demand), passing `profileStartTime()` epoch ms and `profileDuration()` ms. The OpenReg stub ignores scheduling and delegates to the first overload; vendors use `ts_ms`/`duration_ms` to defer device-SDK activation."," * **`IActivityProfilerSession`** — per-trace session. `start()`/`stop()` manage the profiling window and toggle activity tracing via `orActivityEnableTracing()`/`orActivityDisableTracing()`; `getTraceBuffer()` returns the buffer to Kineto."],"additions":1,"deletions":1,"truncated":false},{"path":"test/cpp/profiler/test_mtia_activity_filter.cpp","lines":["@@ -78,19 +78,16 @@ TEST(MtiaActivityFilterTest, CollectiveSelectionUsesFiltersAndAvailability) {","   libkineto::api().registerProfilerFactory([configured_activities]() {","     return std::make_unique<CapturingProfiler>(configured_activities);","   });","+  // Register without device support to keep the test hardware-independent","+  // while exercising the same activity selection logic passed to registered","+  // profilers.","+  libkineto_init(/*cpuOnly=*/true, /*logOnError=*/true);"," ","   const auto prepareAndCapture = [&](const ActivitySet& activities,","                                      const ActivityFilter& activity_filter,","                                      const ExperimentalConfig& config) {","     configured_activities->clear();","-    // Keep the test hardware-independent while exercising the same activity","-    // selection logic passed to registered profilers.","-    prepareTrace(","-        /*cpuOnly=*/true,","-        activities,","-        config,","-        /*trace_id=*/\"\",","-        activity_filter);","+    prepareTrace(activities, config, /*trace_id=*/\"\", activity_filter);","   };"," ","   const std::set<libkineto::ActivityType> default_cpu_activities{"],"additions":5,"deletions":8,"truncated":false},{"path":"test/cpp/profiler/test_xpu_activity_filter.cpp","lines":["@@ -74,6 +74,8 @@ TEST(XpuActivityFilterTest, SyncSelectionFollowsDefaultsAnd