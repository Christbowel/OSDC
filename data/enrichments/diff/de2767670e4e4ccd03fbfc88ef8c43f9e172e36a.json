a full run),","-    and decoded-record native state can leak between tests. Re-running the test alone in","-    a child gives it a clean process: setUpModule's finalize releases the child's own","-    prime, so Cuspy subscribes, with no cross-test interference.\"\"\"","+    any kineto-CUDA profile runs, and decoded-record native state can leak between","+    tests. Re-running the test alone in a child gives it a clean process, so Cuspy","+    subscribes, with no cross-test interference.\"\"\""," ","     @functools.wraps(test_fn)","     def wrapper(self):"],"additions":3,"deletions":20,"truncated":false},{"path":"test/profiler/test_kineto_registration.py","lines":["@@ -0,0 +1,87 @@","+# Owner(s): [\"oncall: profiler\"]","+","+import json","+import unittest","+","+import torch","+from torch._C._profiler import _ExperimentalConfig","+from torch.profiler import (","+    DeviceType,","+    kineto_available,","+    profile,","+    ProfilerActivity,","+    supported_activities,","+)","+from torch.testing._internal.common_device_type import instantiate_device_type_tests","+from torch.testing._internal.common_utils import (","+    HardwareClassification,","+    run_tests,","+    TestCase,","+)","+","+","+# NOTE: Each test needs to be run in a brand new process. The first profiling","+# session in a process registers Kineto, and nothing can undo that. run_test.py","+# runs this file with --subprocess.","+","+# The device runtime and driver events that a session collecting CPU activity","+# asks for. A session without a device records them only if it armed device","+# tracing.","+RUNTIME_ACTIVITY_TYPES = {","+    \"cuda_runtime\",","+    \"cuda_driver\",","+    \"xpu_runtime\",","+    \"xpu_driver\",","+    \"privateuse1_runtime\",","+    \"privateuse1_driver\",","+}","+","+","+@unittest.skipIf(not kineto_available(), \"Kineto is required\")","+class TestKinetoRegistration(TestCase):","+    hw_classification = HardwareClassification.ACCELERATOR","+","+    def test_device_tracing_decided_per_session(self, device):","+        # Runs several profiling sessions, some with the device and some without.","+        # Sessions without the device must see no device traces, and sessions","+        # with the device must see them. That a session without the device never","+        # arms device tracing at all is checked by libkineto's","+        # SyncActivityProfilerHandlerTest.","+        device_type = torch.device(device).type","+        device_activity = getattr(ProfilerActivity, device_type.upper(), None)","+        if device_activity not in supported_activities():","+            self.skipTest(f\"The profiler cannot trace {device_type}\")","+        x = torch.ones(64, 64, device=device)","+","+        def run(activities, experimental_config=None):","+            with profile(","+                activities=activities, experimental_config=experimental_config","+            ) as prof:","+                x @ x","+                torch.accelerator.synchronize()","+            events = prof.profiler.kineto_results.events()","+            device_events = sum(e.device_type() != DeviceType.CPU for e in events)","+            runtime = sum(e.activity_type() in RUNTIME_ACTIVITY_TYPES for e in events)","+            return device_events, runtime","+","+        cpu = [ProfilerActivity.CPU]","+        with_device = [ProfilerActivity.CPU, device_activity]","+        self.assertEqual(run(cpu), (0, 0))","+        device_events, _ = run(with_device)","+        self.assertGreater(device_events, 0)","+        self.assertEqual(run(cpu), (0, 0))","+        # Kineto stops parsing a config at its first malformed line, which a","+        # multi-line custom config contains.","+        multi_line = _ExperimentalConfig(","+            custom_profiler_config=json.dumps({\"unused\": 1}, indent=2)","+        )","+        self.assertEqual(run(cpu, multi_line), (0, 0))","+","+","+instantiate_device_type_tests(","+    TestKinetoRegistration, globals(), except_for=\"cpu\", allow_xpu=True","+)","+","+","+if __name__ == \"__main__\":","+    run_tests()"],"additions":87,"deletions":0,"truncated":false},{"path":"test/profiler/test_profiler.py","lines":["@@ -58,7 +58,6 @@","     onlyAccelerator,","     skipXPUIf,"," )","-from torch.testing._internal.common_profiler import initialize_kineto_with_accelerator"," from torch.testing._internal.common_utils import (","     HardwareClassification,","     instantiate_parametrized_tests,","@@ -95,10 +94,6 @@ def get_profiler_activities(device_type):","     return activities"," "," ","-def setUpModule():","-    initialize_kineto_with_accelerator()","-","-"," # if tqdm is not shutdown properly, it will leave the monitor thread alive."," # This causes an issue in the multithreading test because we check all events"," # in that test with their tids. The events that correspond to these lingering","@@ -209,7 +204,7 @@ def test_cudagraph_profiling_workaround(self):","                 \"\"\""," import os"," import torch","-from torch.profiler import ProfilerActivity, profile","+from torch.profiler import DeviceType, ProfilerActivity, profile"," "," def add_one(in_: torch.Tensor):","     return in_ + 1","@@ -228,8 +223,11 @@ def add_one(in_: torch.Tensor):"," with profile(activities=[ProfilerActivity.CPU]):","     add_one_graphed(zeros)"," ","-with profile(activities=[ProfilerActivity.CUDA]):","+with profile(activities=[ProfilerActivity.CUDA]) as prof:","     add_one_graphed(zeros)","+    torch.cuda.synchronize()","+if not any(e.device_type == DeviceType.CUDA for e in prof.events()):","+    raise AssertionError(\"Expected device events from the graphed callable\")"," \"\"\",","             ],","             text=True,","@@ -476,6 +474,17 @@ def test_activity_filter_mixed_syntax(self):","                 y = torch.mm(x, x)","         self.assertGreater(len(p.events()), 0)"," ","+    @unittest.skipIf(not kineto_available(), \"Kineto is required\")","+    def test_toggle_cpu_without_cpu_is_noop(self):","+        # 