tions = [","       { name: \"Md5Node\", Impl: Md5Node },","     ],","   },","+  {","+    title: \"XXH64\",","+    headers: [\"Size\", \"Xxh64 (JS)\"],","+    impls: [{ name: \"Xxh64\", Impl: Xxh64 }],","+  },","+  {","+    title: \"XXH3_64\",","+    headers: [\"Size\", \"Xxh3_64 (JS)\"],","+    impls: [{ name: \"Xxh3_64\", Impl: Xxh3_64 }],","+  },","+  {","+    title: \"XXH3_128\",","+    headers: [\"Size\", \"Xxh3_128 (JS)\"],","+    impls: [{ name: \"Xxh3_128\", Impl: Xxh3_128 }],","+  },"," ];"," "," console.log(\"Warming up...\");"],"additions":47,"deletions":1,"truncated":false},{"path":"packages-internal/checksums/src/checksum-equivalency.spec.ts","lines":["@@ -2,14 +2,15 @@ import { AwsCrc32c } from \"@aws-crypto/crc32c\";"," import { Crc32cJs } from \"@aws-sdk/checksums/crc\";"," import { Crc32cNode } from \"@aws-sdk/checksums/crc\";"," import { Crc64NvmeJs } from \"@aws-sdk/checksums/crc\";","+import { Sha512 } from \"@aws-sdk/checksums/sha\";"," import { Sha1Js } from \"@aws-sdk/checksums/sha\";"," import { Sha1Node } from \"@aws-sdk/checksums/sha\";"," import { Sha1WebCrypto } from \"@aws-sdk/checksums/sha\";","+import { Sha512Js } from \"@aws-sdk/checksums/sha\";","+import { Sha512WebCrypto } from \"@aws-sdk/checksums/sha\";"," import { randomBytes } from \"node:crypto\";"," import { describe, expect, it } from \"vitest\";","-"," import { toHex } from \"./checksum.fixture\";","-"," /**","  * Generate chunk sizes: [0, 1x10, then doubling 2,3,5,9,17,...] up to ~100MB total.","  */","@@ -31,7 +32,9 @@ function chunkSequence(target: number): number[] {","   return sizes;"," }"," ","-const TARGET = 100 * 1024 * 1024; // ~100MB","+// WHY: >8MB crosses Sha512WebCrypto's break-out to Sha512Js; kept low so the","+// pure-JS SHA-512 hash finishes well under the 30s timeout under full-suite load.","+const TARGET = 16 * 1024 * 1024;"," "," describe(\"checksum-equivalency\", () => {","   it(\"CRC-32C: Crc32cJs vs Crc32cNode vs AwsCrc32c\", async () => {","@@ -133,4 +136,45 @@ describe(\"checksum-equivalency\", () => {","     expect(dJs).toBe(dNode);","     expect(dJs).toBe(dWeb);","   }, 30_000);","+","+  it(\"SHA-512: Sha512Js vs Sha512 (native) vs WebCrypto\", async () => {","+    const js = new Sha512Js();","+    const node = new Sha512();","+    const web = new Sha512WebCrypto();","+    const sizes = chunkSequence(TARGET);","+","+    for (let i = 0; i < sizes.length; ++i) {","+      const chunk = randomBytes(sizes[i]);","+      js.update(chunk);","+      node.update(chunk);","+      web.update(chunk);","+    }","+","+    const dJs = toHex(await js.digest());","+    const dNode = toHex(await node.digest());","+    const dWeb = toHex(await web.digest());","+    expect(dJs).toBe(dNode);","+    expect(dJs).toBe(dWeb);","+  }, 30_000);","+","+  it(\"SHA-512 HMAC: Sha512Js vs Sha512 (native) vs WebCrypto\", async () => {","+    const secret = randomBytes(64);","+    const js = new Sha512Js(secret);","+    const node = new Sha512(secret);","+    const web = new Sha512WebCrypto(secret);","+    const sizes = chunkSequence(TARGET);","+","+    for (let i = 0; i < sizes.length; ++i) {","+      const chunk = randomBytes(sizes[i]);","+      js.update(chunk);","+      node.update(chunk);","+      web.update(chunk);","+    }","+","+    const dJs = toHex(await js.digest());","+    const dNode = toHex(await node.digest());","+    const dWeb = toHex(await web.digest());","+    expect(dJs).toBe(dNode);","+    expect(dJs).toBe(dWeb);","+  }, 30_000);"," });"],"additions":47,"deletions":3,"truncated":false},{"path":"packages-internal/checksums/src/checksum-s3.e2e.spec.ts","lines":["@@ -0,0 +1,94 @@","+import { getE2eTestResources } from \"@aws-sdk/aws-util-test/src\";","+import { Sha512 } from \"@aws-sdk/checksums/sha\";","+import { Xxh3_64, Xxh3_128, Xxh64 } from \"@aws-sdk/checksums/xxh\";","+import { ChecksumAlgorithm, S3 } from \"@aws-sdk/client-s3\";","+import type { ChecksumConstructor } from \"@smithy/types\";","+import { beforeAll, describe, expect, test as it } from \"vitest\";","+","+// WHY: these algorithms are not built into flexible-checksums' selectChecksumAlgorithmFunction;","+// they are registered per-client through the checksum extension seam (the `extensions` ctor","+// property), which lands the constructor in runtimeConfig.checksumAlgorithms[id] where the","+// middleware's default branch resolves it by the S3 model's ChecksumAlgorithm value.","+const NEW_ALGORITHMS: Record<string, ChecksumConstructor> = {","+  [ChecksumAlgorithm.SHA512]: Sha512,","+  [ChecksumAlgorithm.XXHASH64]: Xxh64,","+  [ChecksumAlgorithm.XXHASH3]: Xxh3_64,","+  [ChecksumAlgorithm.XXHASH128]: Xxh3_128,","+};","+","+function registerChecksumsExtension() {","+  return {","+    configure(extensionConfiguration: any) {","+      for (const [id, ctor] of Object.entries(NEW_ALGORITHMS)) {","+        extensionConfiguration.addChecksumAlgorithm({","+          algorithmId: () => id,","+          checksumConstructor: () => ctor,","+        });","+      }","+    },","+  };","+}","+","+// Byte-length boundaries exercising each algorithm's internal path transitions:","+// xxh3 small/medium/large splits (<=16, 17-128, 129-240, >240), sha/xxh64 block","+// boundaries (64/128), and the S3 8KiB request-buffer threshold.","+const SIZES = [0, 1, 16, 17, 64, 128, 129, 240, 241, 256, 1024, 8192, 8193];","+","+describe(\"S3 checksum round-trip for SDK-vended algorithms\", () => {","+  let s3: S3;","+  let Bucket: string;","+  let region: string;","+","+  function body(size: number): Uint8Array {","+    const b = new Uint8Array(size);","+    for (let i = 0; i < size; ++i) {","+      b[i] = (i * 31 + 7) & 0xff;","+    }","+    return b;","+  }","+","+  beforeAll(async () => {","+    const e2eTestResourcesEnv = await getE2eTestResources();","+    Object.assign(process.env, e2eTestResourcesEnv);","+    region = process.env.AWS_SMOKE_TEST_REGION as string;","+    Bucket = process.env.AWS_SMOKE_TEST_BUCKET as string;","+","+    s3 = new S3({","+      region,","+      requestStreamBufferSize: 8 * 1024,","+      extensions: [registerChecksumsExtension()],","+    });","+  });","+","+  async function roundTrip(algo: string, size: number): Promise<void> {","+    const Key = `checksum-e2e/${algo}/${size}`;","+    const data = body(size);","+","+    await s3.putObject({","+      Bucket,","+      Key,","+      Body: data,","+      ContentLength: size,","+      ChecksumAlgorithm: algo as ChecksumAlgorithm,","+    });","+","+    const get = await s3.getObject({ Bucket, Key, ChecksumMode: \"ENABLED\" });","+    expect(get.$metadata.httpStatusCode).toEqual(200);","+","+    // S3 validated and stored the client-computed checksum server-side; its","+    // presence on the response is the authoritative cross-check of our impl.","+    expect(get[`Checksum${algo}` as keyof typeof get]).toBeDefined();","+","+    const retrieved = await get.Body?.transformToByteArray();","+    expect(retrieved?.byteLength).toEqual(size);","+    expect(Array.from(retrieved ?? [])).toEqual(Array.from(data));","+  }","+","+  for (const algo of Object.keys(NEW_ALGORITHMS)) {","+    // All byte-length boundaries run concurrently; Promise.all surfaces the","+    // first rejection, which is sufficient to fail the algorithm.","+    it(`${algo}: put and get across byte-length boundaries`, async () => {","+      await Promise.all(SIZES.map((size) => roundTrip(algo, size)));","+    });","+  }","+}, 120_000);"],"additions":94,"deletions":0,"truncated":false},{"path":"packages-internal/checksums/src/sha512.spec.ts","lines":["@@ -0,0 +1,125 @@","+import { Sha512, Sha512Js, Sha512WebCrypto } from \"@aws-sdk/checksums/sha\";","+import { createHash, createHmac } from \"node:crypto\";","+import { describe, expect, it } from \"vitest\";","+","+import { toHex, utf8 } from \"./checksum.fixture\";","+","+// FIPS 180-4 / NIST CAVP known-answer vectors.","+const VECTORS: Array<{ description: string; input: Uint8Array; expected: string }> = [","+  {","+    description: \"empty\",","+    input: new Uint8Array(0),","+    expected:","+      \"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e\",","+  },","+  {","+    description: '\"abc\"',","+    input: utf8(\"abc\"),","+    expected:","+      \"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f\",","+  },","+  {","+    description: \"896-bit two-block message\",","+    input: utf8(","+      \"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu\"","+    ),","+    expected:","+      \"8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909\",","+  },","+];","+","+// Each class under test, with the matching HMAC availability.","+const IMPLS: Array<{ name: string; Ctor: new (secret?: any) => any; hmac: boolean }> = [","+  { name: \"Sha512\", Ctor: Sha512 as any, hmac: true },","+  { name: \"Sha512Js\", Ctor: Sha512Js, hmac: true },","+  { name: \"Sha512WebCrypto\", Ctor: Sha512WebCrypto, hmac: true },","+];","+","+describe.each(IMPLS)(\"$name\", ({ Ctor, hmac }) => {","+  it(\"has digestLength 64\", () => {","+    expect(new Ctor().digestLength).toBe(64);","+  });","+","+  it(\"returns a 64-byte Uint8Array digest\", async () => {","+    const h = new Ctor();","+    h.update(new Uint8Array(0));","+    const d = await h.digest();","+    expect(d).toBeInstanceOf(Uint8Array);","+    expect(d.length).toBe(64);","+  });","+","+  it.each(VECTORS)(\"$description\", async ({ input, expected }) => {","+    const h = new Ctor();","+    h.update(input);","+    expect(toHex(await h.digest())).toBe(expected);","+  });","+","+  it(\"incremental: abc split byte-by-byte\", async () => {","+    const h = new Ctor();","+    h.update(utf8(\"a\"));","+    h.update(utf8(\"b\"));","+    h.update(utf8(\"c\"));","+    expect(toHex(await h.digest())).toBe(VECTORS[1].expected);","+  });","+","+  it(\"reset returns to initial state\", async () => {","+    const h = new Ctor();","+    h.update(utf8(\"abc\"));","+    h.reset();","+    h.update(new Uint8Array(0));","+    expect(toHex(await h.digest())).toBe(VECTORS[0].expected);","+  });","+","+  it.each([0, 1, 63, 111, 112, 127, 128, 129, 200, 1000, 4096])(","+    \"matches node:crypto for length %i (incl. block boundaries)\",","+    async (len) => {","+      const input = new Uint8Array(len);","+      for (let i = 0; i < len; ++i) {","+        input[i] = (i * 31 + 7) & 0xff;","+      }","+      const h = new Ctor();","+      // split across several updates to exercise buffering.","+      h.update(input.subarray(0, Math.floor(len / 3)));","+      h.update(input.subarray(Math.floor(len / 3), Math.floor((2 * len) / 3)));","+      h.update(input.subarray(Math.floor((2 * len) / 3)));","+      const expected = createHash(\"sha512\").update(input).digest(\"hex\");","+      expect(toHex(await h.digest())).toBe(expected);","+    }","+  );","+","+  if (hmac) {","+    it.each([3, 64, 128, 200])(\"HMAC-SHA-512 matches node:crypto for key length %i\", async (keyLen) => {","+      const key = new Uint8Array(keyLen);","+      for (let i = 0; i < keyLen; ++i) {","+        key[i] = (i * 17 + 3) & 0xff;","+      }","+      const msg = utf8(\"The quick brown fox jumps over the lazy dog\");","+      const h = new Ctor(key);","+      h.update(msg);","+      const expected = createHmac(\"sha512\", Buffer.from(key)).update(msg).digest(\"hex\");","+      expect(toHex(await h.digest())).toBe(expected);","+    });","+","+    it.each([","+      [\"empty string\", \"\"],","+      [\"empty Uint8Array\", new Uint8Array(0)],","+    ])(\"HMAC-SHA-512 with %s key matches node:crypto\", async (_, key) => {","+      const msg = utf8(\"abc\");","+      const h = new Ctor(key);","+      h.update(msg);","+      const expected = createHmac(\"sha512\", Buffer.alloc(0)).update(msg).digest(\"hex\");","+      expect(toHex(await h.digest())).toBe(expected);","+    });","+","+    it(\"HMAC instance is reusable after reset\", async () => {","+      const key = utf8(\"key\");","+      const h = new Ctor(key);","+      h.update(utf8(\"first\"));","+      await h.digest();","+      h.reset();","+      h.update(utf8(\"second\"));","+      const expected = createHmac(\"sha512\", Buffer.from(key)).update(\"second\").digest(\"hex\");","+      expect(toHex(await h.digest())).toBe(expected);","+    });","+  }","+});"],"additions":125,"deletions":0,"truncated":false},{"path":"packages-internal/checksums/src/submodules/sha/index.browser.ts","lines":["@@ -3,4 +3,7 @@ const no = Symbol.for(\"node-only\");"," export { Sha1Js, Sha1Js as Sha1 } from \"./sha1/Sha1Js\";"," export const Sha1Node = no;"," ","+export { Sha512WebCrypto, Sha512WebCrypto as Sha512 } from \"./sha512/Sha512WebCrypto\";","+export { Sha512Js } from \"./sha512/Sha512Js\";","+"," export { Sha256, Sha256Js, Sha256Node, Sha256WebCrypto } from \"@smithy/core/checksum\";"],"additions":3,"deletions":0,"truncated":false},{"path":"packages-internal/checksums/src/submodules/sha/index.ts","lines":["@@ -2,4 +2,8 @@ export { Sha1Js } from \"./sha1/Sha1Js\";"," export { Sha1Node, Sha1Node as Sha1 } from \"./sha1/Sha1Node\";"," export { Sha1WebCrypto } from \"./sha1/Sha1WebCrypto\";"," ","+export { Sha512 } from \"./sha512/Sha512\";","+export { Sha512Js } from \"./sha512/Sha512Js\";","+export { Sha512WebCrypto } from \"./sha512/Sha512WebCrypto\";","+"," export { Sha256, Sha256Js, Sha256Node } from \"@smithy/core/checksum\";"],"additions":4,"deletions":0,"truncated":false},{"path":"packages-internal/checksums/src/submodules/sha/sha512/Sha512.ts","lines":["@@ -0,0 +1,87 @@","+import type { SourceData } from \"@smithy/types\";","+import { createHash, createHmac } from \"node:crypto\";","+","+import { Sha512Js } from \"./Sha512Js\";","+","+// Cached on first construction rather than at module load.","+let nativeSupported: boolean | undefined;","+","+function detectNative(): boolean {","+  if (nativeSupported === undefined) {","+    try {","+      createHash(\"sha512\");","+      nativeSupported = true;","+    } catch {","+      nativeSupported = false;","+    }","+  }","+  return nativeSupported;","+}","+","+/**","+ * SHA-512, using Node.js native crypto when available and falling back to the","+ * inherited pure-JS implementation otherwise.","+ * @public","+ */","+export class Sha512 extends Sha512Js {","+  private native?: ReturnType<typeof createHash> | ReturnType<typeof createHmac>;","+  private readonly nativeSecret?: SourceData;","+  private nativeFinished = false;","+","+  public constructor(secret?: SourceData) {","+    super(secret);","+    this.nativeSecret = secret;","+    if (detectNative()) {","+      this.native = this.createNative();","+    }","+  }","+","+  public update(data: Uint8Array): void {","+    if (!this.native) {","+      super.update(data);","+      return;","+    }","+    if (this.nativeFinished) {","+      throw new Error(\"Attempted to update an already finished hash.\");","+    }","+    this.native.update(data);","+  }","+","+  public async digest(): Promise<Uint8Array> {","+    if (!this.native) {","+      return super.digest();","+    }","+    let buf: Buffer;","+    if (this.nativeSecret !== undefined) {","+      this.nativeFinished = true;","+      buf = (this.native as ReturnType<typeof createHmac>).digest();","+    } else {","+      // copy() keeps digest() non-destructive for plain hashes.","+      buf = (this.native as ReturnType<typeof createHash>).copy().digest();","+    }","+    return new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength);","+  }","+","+  public reset(): void {","+    if (!this.native) {","+      super.reset();","+      return;","+    }","+    this.native = this.createNative();","+    this.nativeFinished = false;","+  }","+","+  private createNative() {","+    return this.nativeSecret !== undefined ? createHmac(\"sha512\", toBuffer(this.nativeSecret)) : createHash(\"sha512\");","+  }","+}","+","+function toBuffer(data: SourceData): Buffer | string {","+  if (typeof data === \"string\") {","+    return data;","+  }","+  if (ArrayBuffer.isView(data)) {","+    return Buffer.from(data.buffer, data.byteOffset, data.byteLength);","+  }","+  return Buffer.from(data);","+}"],"additions":87,"deletions":0,"truncated":false},{"path":"packages-internal/checksums/src/submodules/sha/sha512/Sha512Js.ts","lines":["@@ -0,0 +1,360 @@","+import { toUint8Array } from \"@smithy/core/serde\";","+import type { Checksum, SourceData } from \"@smithy/types\";","+","+const BLOCK = 128;","+const DIGEST_LENGTH = 64;","+const MAX_HASHABLE_LENGTH = 2 ** 53 - 1;","+","+// SHA-512 initial hash values (FIPS 180-4 §5.3.5), as [hi, lo] u32 pairs.","+const INIT = new Uint32Array([","+  0x6a09e667, 0xf3bcc908, 0xbb67ae85, 0x84caa73b, 0x3c6ef372, 0xfe94f82b, 0xa54ff53a, 0x5f1d36f1, 0x510e527f,","+  0xade682d1, 0x9b05688c, 0x2b3e6c1f, 0x1f83d9ab, 0xfb41bd6b, 0x5be0cd19, 0x137e2179,","+]);","+","+// SHA-512 round constants (FIPS 180-4 §4.2.3), 80 words as [hi, lo] u32 pairs.","+// prettier-ignore","+const K = new Uint32Array([","+  0x428a2f98, 0xd728ae22, 0x71374491, 0x23ef65cd, 0xb5c0fbcf, 0xec4d3b2f, 0xe9b5dba5, 0x8189dbbc,","+  0x3956c25b, 0xf348b538, 0x59f111f1, 0xb605d019, 0x923f82a4, 0xaf194f9b, 0xab1c5ed5, 0xda6d8118,","+  0xd807aa98, 0xa3030242, 0x12835b01, 0x45706fbe, 0x243185be, 0x4ee4b28c, 0x550c7dc3, 0xd5ffb4e2,","+  0x72be5d74, 0xf27b896f, 0x80deb1fe, 0x3b1696b1, 0x9bdc06a7, 0x25c71235, 0xc19bf174, 0xcf692694,","+  0xe49b69c1, 0x9ef14ad2, 0xefbe4786, 0x384f25e3, 0x0fc19dc6, 0x8b8cd5b5, 0x240ca1cc, 0x77ac9c65,","+  0x2de92c6f, 0x592b0275, 0x4a7484aa, 0x6ea6e483, 0x5cb0a9dc, 0xbd41fbd4, 0x76f988da, 0x831153b5,","+  0x983e5152, 0xee66dfab, 0xa831c66d, 0x2db43210, 0xb00327c8, 0x98fb213f, 0xbf597fc7, 0xbeef0ee4,"],"additions":23,"deletions":0,"truncated":false}],"additions":549,"deletions":