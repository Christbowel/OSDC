ASE(false, 1)} or {@code 1/0}).","+     * Arguments that aren't foldable, like options maps, are kept as they are.","+     * <p>","+     * All foldable arguments are folded, even after one folds to {@code null}, so their warnings don't depend on","+     * the order of the arguments.","+     * </p>","+     *","+     * @return {@code null} if any argument folds to {@code null};","+     *         a copy of the expression with its foldable arguments replaced by their folded {@link Literal}s;","+     *         or the expression itself if they were already literals.","+     */","+    static Expression foldArguments(Expression expression, FoldContext ctx) {","+        List<Expression> arguments = expression.children();","+        List<Expression> foldedArguments = new ArrayList<>(arguments.size());","+        boolean changed = false;","+        boolean anyNull = false;","+        for (Expression argument : arguments) {","+            if (argument.foldable() == false) {","+                foldedArguments.add(argument);","+                continue;","+            }","+            Literal folded = Literal.of(ctx, argument);","+            anyNull |= folded.value() == null;","+            changed |= folded != argument;","+            foldedArguments.add(folded);","+        }","+        if (anyNull) {","+            return null;","+        }","+        return changed ? expression.replaceChildren(foldedArguments) : expression;","+    }","+}"],"additions":46,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/evaluator/mapper/EvaluatorMapper.java","lines":["@@ -20,6 +20,7 @@"," import org.elasticsearch.indices.breaker.AllCircuitBreakerStats;"," import org.elasticsearch.indices.breaker.CircuitBreakerService;"," import org.elasticsearch.indices.breaker.CircuitBreakerStats;","+import org.elasticsearch.xpack.esql.core.expression.AnyNullIsNull;"," import org.elasticsearch.xpack.esql.core.expression.Expression;"," import org.elasticse