  text-transform: none;","+        font-weight: 600;","+        color: #1a202c;","+    }","+","+    .md-typeset h6 {","+        font-weight: 600;","+        color: #2d3748;","+    }","+","+    /* Inline code styling - orange color like links */","+    .md-typeset p code,","+    .md-typeset li code,","+    .md-typeset td code,","+    .md-typeset th code {","+        border: 1px solid #e1e4e5;","+        color: #e74c3c; /* Same orange color as links */","+    }","+","+    /* Code blocks should keep default styling */","+    .md-typeset pre code {","+        border: none;","+    }","+","+    .md-typeset .admonition.important,","+    .md-typeset details.important {","+        border-color: #dd4814;","+    }","+","+    .md-typeset .important > .admonition-title,","+    .md-typeset .important > summary {","+        background-color: #dd4814;","+        color: white;","+    }","+","+    .md-typeset .important > .admonition-title:before,","+    .md-typeset .important > summary:before {","+        background-color: white;","+        -webkit-mask-image: var(--md-admonition-icon--warning);","+        mask-image: var(--md-admonition-icon--warning);","+    }","+","+    /* Note admonition styling */","+    .md-typeset .admonition.note,","+    .md-typeset details.note {","+        border-color: #448aff;","+    }","+","+    .md-typeset .note > .admonition-title,","+    .md-typeset .note > summary {","+        background-color: #448aff;","+        color: white;","+    }","+","+    .md-typeset .note > .admonition-title:before,","+    .md-typeset .note > summary:before {","+        background-color: white;","+        -webkit-mask-image: var(--md-admonition-icon--note);","+        mask-image: var(--md-admonition-icon--note);","+    }","+","+    /* Warning admonition styling */","+    .md-typeset .admonition.warning,","+    .md-typeset details.warning {","+        border-color: #ff9800;","+    }","+","+    .md-typeset .warning > .admonition-title,","+    .md-typeset .warning > summary {