{"id":"8e03e034c06404eab25d800347b676ba613d76c3","axis":"silent","repo":"codeigniter4/CodeIgniter4","sha":"8e03e034c06404eab25d800347b676ba613d76c3","parsed":{"files":[{"path":".editorconfig","lines":["@@ -13,3 +13,7 @@ trim_trailing_whitespace = true"," "," [*.{yml,yaml}]"," indent_size = 2","+","+# Two trailing spaces are a hard line break in the converted pages.","+[docs/**.md]","+trim_trailing_whitespace = false"],"additions":4,"deletions":0,"truncated":false},{"path":".gitattributes","lines":["@@ -36,5 +36,7 @@ AGENTS.md                    export-ignore"," "," # source user guide"," user_guide_src/ export-ignore","+docs/           export-ignore","+mkdocs.yml      export-ignore"," .nojekyll       export-ignore"," phpdoc.dist.xml export-ignore"],"additions":2,"deletions":0,"truncated":false},{"path":".github/workflows/test-userguide.yml","lines":["@@ -1,13 +1,18 @@"," # When a Pull Request is opened that modifies"," # the User Guide source, build the User Guide","-# with Sphinx and let the contributor know of","-# any errors.","+# with Sphinx or MkDocs and let the contributor","+# know of any errors."," name: Test User Guide"," "," on:","   pull_request:","     paths:","       - 'user_guide_src/**'","+      - 'docs/**'","+      - 'mkdocs.yml'","+      - 'admin/anchors.py'","+      - 'admin/llms.py'","+      - 'admin/update-docs-nav.php'","       - '.github/workflows/test-userguide.yml'"," "," concurrency:","@@ -42,3 +47,42 @@ jobs:","       - name: Build Docs with Sphinx","         run: make html SPHINXOPTS=\"-W --keep-going -w /tmp/sphinx-log\"","         working-directory: user_guide_src","+","+  markdown_check:","+    name: Check Markdown User Guide","+    runs-on: ubuntu-24.04","+","+    steps:","+      - name: Checkout","+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+        with:","+          persist-credentials: false","+","+      - name: Setup PHP","+        uses: shivammathur/setup-php@eb7c497e18156a6bbabfef1d3a82760b9eda3962 # 2.40.0","+        with:","+          php-version: '8.2'","+          coverage: none","+","+      - name: Setup Python","+        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0","+        with:","+          python-version: '3.12'","+","+      - name: Install MkDocs","+        run: |","+          python -m pip install --upgrade pip","+          pip install -r docs/requirements.txt","+","+      - name: Check that every page is in the nav","+        run: php admin/update-docs-nav.php --check","+","+      - name: Build Docs with MkDocs","+        env:","+          NO_MKDOCS_2_WARNING: '1'","+        run: mkdocs build --strict","+","+      - name: Write the llms files and the anchor aliases","+        run: |","+          python admin/llms.py","+          python admin/anchors.py"],"additions":46,"deletions":2,"truncated":false},{"path":".gitignore","lines":["@@ -75,6 +75,9 @@ php_errors.log"," # User Guide Temp Files"," #-------------------------"," /user_guide_src/build/*","+/site/","+/venv/","+__pycache__/"," "," #-------------------------"," # Test Files"],"additions":3,"deletions":0,"truncated":false},{"path":"admin/anchors.py","lines":["@@ -0,0 +1,42 @@","+\"\"\"Adds the legacy anchor ids listed in the docs' .anchors.json to the headings of the built site.\"\"\"","+","+from __future__ import annotations","+","+import html","+import json","+import re","+import sys","+from pathlib import Path","+","+from llms import load","+","+","+def main(config_path: Path) -> None:","+    config = load(config_path)","+    base = config_path.parent","+    docs = base / config.get(\"docs_dir\", \"docs\")","+    site = base / config.get(\"site_dir\", \"site\")","+    aliases = json.loads((docs / \".anchors.json\").read_text(encoding=\"utf-8\"))","+","+    for page, headings in aliases.items():","+        target = site / (page.removesuffix(\".md\") + \".html\")","+","+        if not target.is_file():","+            print(f\"WARNING - {page} has aliases but was not built\", file=sys.stderr)","+            continue","+","+        content = target.read_text(encoding=\"utf-8\")","+","+        for heading, ids in headings.items():","+            opening = re.compile(rf'(<h[1-6]\\b[^>]*\\bid=\"{re.escape(html.escape(heading))}\"[^>]*>)')","+            anchors = \"\".join(f'<a id=\"{html.escape(id_)}\"></a>' for id_ in ids)","+            content, count = opening.subn(lambda match: match.group(1) + anchors, content, count=1)","+","+            if count == 0:","+                print(f\"WARNING - {page} has no heading #{heading} for its aliases\", file=sys.stderr)","+","+        target.write_text(content, encoding=\"utf-8\")","+","+","+if __name__ == \"__main__\":","+    main(Path(sys.argv[1] if len(sys.argv) > 1 else \"mkdocs.yml\"))"],"additions":42,"deletions":0,"truncated":false},{"path":"admin/llms.py","lines":["@@ -0,0 +1,95 @@","+\"\"\"Writes llms.txt, llms-full.txt and each page's Markdown beside its HTML in the built site.\"\"\"","+","+from __future__ import annotations","+","+import re","+import sys","+from pathlib import Path","+","+import yaml","+","+","+class Loader(yaml.SafeLoader):","+    pass","+","+","+Loader.add_multi_constructor(\"!\", lambda loader, suffix, node: None)","+","+","+def load(path: Path) -> dict:","+    return yaml.load(path.read_text(encoding=\"utf-8\"), Loader=Loader) or {}","+","+","+def title_of(markdown: Path) -> str:","+    fenced = False","+","+    for line in markdown.read_text(encoding=\"utf-8\").splitlines():","+        if line.startswith(\"```\"):","+            fenced = not fenced","+        elif not fenced and (match := re.match(r\"# (.+?)\\s*#*\\s*$\", line)):","+            return match.group(1)","+","+    return markdown.stem","+","+","+def index_lines(items: list, docs: Path, depth: int = 0) -> list[str]:","+    indent = \"    \" * max(depth - 1, 0)","+    lines: list[str] = []","+","+    for item in items:","+        title, target = next(iter(item.items())) if isinstance(item, dict) else (None, item)","+","+        if isinstance(target, list):","+            lines += [\"\", f\"## {title}\", \"\"] if depth == 0 else [f\"{indent}- {title}\"]","+            lines += index_lines(target, docs, depth + 1)","+        elif isinstance(target, str) and target.endswith(\".md\"):","+            lines.append(f\"{indent}- [{title or title_of(docs / target)}]({target})\")","+","+    return lines","+","+","+def nav_pages(items: list) -> list[str]:","+    pages: list[str] = []","+","+    for item in items:","+        target = next(iter(item.values())) if isinstance(item, dict) else item","+","+        if isinstance(target, list):","+            pages += nav_pages(target)","+        elif isinstance(target, str) and target.endswith(\".md\"):","+            pages.append(target)","+","+    return pages","+","+","+def main(config_path: Path) -> None:","+    config = load(config_path)","+    base = config_path.parent","+    nav = config.get(\"nav\") or load(base / config[\"INHERIT\"]).get(\"nav\", [])","+    docs = base / config.get(\"docs_dir\", \"docs\")","+    site = base / config.get(\"site_dir\", \"site\")","+","+    in_nav = nav_pages(nav)","+    outside_nav = sorted(","+        path.relative_to(docs).as_posix() for path in docs.rglob(\"*.md\") if path.relative_to(docs).as_posix() not in in_nav","+    )","+    pages = in_nav + outside_nav","+","+    for page in pages:","+        (site / page).write_text((docs / page).read_text(encoding=\"utf-8\"), encoding=\"utf-8\")","+","+    index = [f\"# {config['site_name']}\", \"\", f\"> {config['site_description']}\", \"\", *index_lines(nav, docs)]","+","+    if outside_nav:","+        index += [\"\", \"## Other pages\", \"\"]","+        index += [f\"- [{title_of(docs / page)}]({page})\" for page in outside_nav]","+","+    (site / \"llms.txt\").write_text(\"\\n\".join(index) + \"\\n\", encoding=\"utf-8\")","+    (site / \"llms-full.txt\").write_text(","+        \"\\n\\n\".join((docs / page).read_text(encoding=\"utf-8\").strip() for page in pages) + \"\\n\",","+        encoding=\"utf-8\",","+    )","+","+","+if __name__ == \"__main__\":","+    main(Path(sys.argv[1] if len(sys.argv) > 1 else \"mkdocs.yml\"))"],"additions":95,"deletions":0,"truncated":false},{"path":"admin/update-docs-nav.php","lines":["@@ -0,0 +1,246 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * This file is part of CodeIgniter 4 framework.","+ *","+ * (c) CodeIgniter Foundation <admin@codeigniter.com>","+ *","+ * For the full copyright and license information, please view","+ * the LICENSE file that was distributed with this source code.","+ */","+","+/**","+ * Adds the pages of the user guide that are missing from its nav (docs/.nav.yml).","+ *","+ * A page goes into the section whose first page links to it, after the page","+ * that precedes it in that list. With --check, nothing is changed, and the","+ * script exits with 1 when a page is missing or a nav entry has no file.","+ *","+ * Usage: php admin/update-docs-nav.php [--check] [--docs=<directory>]","+ */","+","+/**","+ * @return list<string> Markdown pages under $docs, relative to it","+ */","+function docs_pages(string $docs): array","+{","+    $pages    = [];","+    $iterator = new RecursiveIteratorIterator(","+        new RecursiveDirectoryIterator($docs, FilesystemIterator::SKIP_DOTS),","+    );","+","+    foreach ($iterator as $file) {","+        $page = str_replace('\\\\', '/', substr($file->getPathname(), strlen($docs) + 1));","+","+        if ($file->getExtension() === 'md' && ! str_starts_with($page, 'overrides/')) {","+            $pages[] = $page;","+        }","+    }","+","+    sort($pages);","+","+    return $pages;","+}","+","+/**","+ * @param list<string> $lines","+ *","+ * @return array{indent: int, page: string|null, section: bool}|null","+ */","+function parse_nav_line(array $lines, int $i): ?array","+{","+    if (preg_match('/^(\\s*)- (?:(?:\"[^\"]*\"|[^:]+): )?([^\\s:]+\\.md)\\s*$/', $lines[$i], $matches) === 1) {","+        return ['indent' => strlen($matches[1]), 'page' => $matches[2], 'section' => false];","+    }","+","+    if (preg_match('/^(\\s*)- (?:\"[^\"]*\"|[^:]+):\\s*$/', $lines[$i], $matches) === 1) {","+        $head = isset($lines[$i + 1]) ? parse_nav_line($lines, $i + 1) : null;","+","+        return ['indent' => strlen($matches[1]), 'page' => $head['page'] ?? null, 'section' => true];","+    }","+","+    return null;","+}","+","+/**","+ * @param list<string> $lines","+ *","+ * @return list<string>","+ */","+function nav_pages(array $lines): array","+{","+    $pages = [];","+","+    foreach (array_keys($lines) as $i) {","+        $entry = parse_nav_line($lines, $i);","+","+        if ($entry !== null && ! $entry['section']) {","+            $pages[] = $entry['page'];","+        }","+    }","+","+    return $pages;","+}","+","+/**","+ * @return list<string> Pages that $page links to, in order, as paths relative to $docs","+ */","+function linked_pages(string $docs, string $page): array","+{","+    preg_match_all('/\\]\\(([^)#\\s]+\\.md)(?:#[^)]*)?\\)/', (string) file_get_contents($docs . '/' . $page), $matches);","+","+    $links = [];","+","+    foreach ($matches[1] as $link) {","+        if (str_contains($link, '://')) {","+            continue;","+        }","+","+        $parts = [];","+","+        foreach (explode('/', dirname($page) . '/' . $link) as $part) {","+            if ($part === '..') {","+                array_pop($parts);","+            } elseif ($part !== '.' && $part !== '') {","+                $parts[] = $part;","+            }","+        }","+","+        $links[] = implode('/', $parts);","+    }","+","+    return array_values(array_unique($links));","+}","+","+/**","+ * The index of the last line of the entry at $i, including the entries nested in it.","+ *","+ * @param list<string> $lines","+ */","+function entry_end(array $lines, int $i): int","+{","+    $indent = parse_nav_line($lines, $i)['indent'];","+    $end    = $i;","+","+    for ($j = $i + 1; $j < count($lines); $j++) {","+        $entry = parse_nav_line($lines, $j);","+","+        if ($entry === null || $entry['indent'] <= $indent) {","+            break;","+        }","+","+        $end = $j;","+    }","+","+    return $end;","+}","+","+/**","+ * Inserts $page into $lines, returning the title of the section it went into, or null when no section links to it.","+ *","+ * @param list<string> $lines","+ */","+function insert_page(array &$lines, string $docs, string $page): ?string","+{","+    $target = null;","+","+    foreach (array_keys($lines) as $i) {","+        $section = parse_nav_line($lines, $i);","+","+        if ($section === null || ! $section['section'] || $section['page'] === null) {","+            continue;","+        }","+","+        if (! in_array($page, linked_pages($docs, $section['page']), true)) {","+            continue;","+        }","+","+        // The index of an outer section also lists the pages of the sections nested in it.","+        if ($target === null || $section['indent'] > $target['indent']) {","+            $target = $section + ['line' => $i];","+        }","+    }","+","+    if ($target === null) {","+        return null;","+    }","+","+    $order       = linked_pages($docs, $target['page']);","+    $position    = array_search($page, $order, true);","+    $after       = $target['line'] + 1;","+    $childIndent = $target['indent'] + 4;","+    $end         = entry_end($lines, $target['line']);","+","+    for ($j = $target['line'] + 1; $j <= $end; $j++) {","+        $entry = parse_nav_line($lines, $j);","+","+        if ($entry === null || $entry['indent'] !== $childIndent || $entry['page'] === null) {","+            continue;","+        }","+","+        $before = array_search($entry['page'], $order, true);","+","+        if ($j === $target['line'] + 1 || ($before !== false && $before < $position)) {","+            $after = entry_end($lines, $j);","+        }","+    }","+","+    array_splice($lines, $after + 1, 0, [str_repeat(' ', $childIndent) . '- ' . $page]);","+","+    return $target['page'];","+}","+","+$check = in_array('--check', $argv, true);","+$docs  = 'docs';","+","+foreach ($argv as $argument) {","+    if (str_starts_with($argument, '--docs=')) {","+        $docs = rtrim(substr($argument, strlen('--docs=')), '/');","+    }","+}","+","+$navFile = $docs . '/.nav.yml';","+","+if (! is_file($navFile)) {","+    echo \"{$navFile} is not found.\\n\";","+","+    exit(1);","+}","+","+$lines   = explode(\"\\n\", rtrim((string) file_get_contents($navFile), \"\\n\"));","+$pages   = docs_pages($docs);","+$missing = array_values(array_diff($pages, nav_pages($lines)));","+$stale   = array_values(array_diff(nav_pages($lines), $pages));","+","+foreach ($stale as $page) {","+    echo \"The nav lists {$page}, which does not exist.\\n\";","+}","+","+foreach ($missing as $page) {","+    if ($check) {","+        echo \"{$page} is missing from the nav.\\n\";","+","+        continue;","+    }","+","+    $section = insert_page($lines, $docs, $page);","+","+    if ($section === null) {","+        $lines[] = '  - ' . $page;","+        echo \"Added {$page} at the end of the nav, since no section links to it. Move it by hand.\\n\";","+    } else {","+        echo \"Added {$page} to the section of {$section}.\\n\";","+    }","+}","+","+if (! $check && $missing !== []) {","+    file_put_contents($navFile, implode(\"\\n\", $lines) . \"\\n\");","+}","+","+if ($check && ($missing !== [] || $stale !== [])) {","+    echo \"Run \\\"php admin/update-docs-nav.php\\\" to update docs/.nav.yml.\\n\";","+}","+","+exit($check && ($missing !== [] || $stale !== []) ? 1 : 0);"],"additions":246,"deletions":0,"truncated":false},{"path":"docs/overrides/assets/css/code.css","lines":["@@ -0,0 +1,98 @@","+/* The theme turns ligatures off in code. */","+.md-typeset code,","+.md-typeset pre {","+    font-variant-ligatures: normal;","+}","+","+/* Pygments marks most PHP identifiers Name.Other, which the theme leaves at body color. */","+.highlight .nx {","+    color: var(--md-code-hl-function-color);","+}","+","+/* Light-scheme code colors matched to VS Code's Light Modern token palette, on the theme's own background. */","+[data-md-color-scheme=\"codeigniter\"] {","+    --md-code-fg-color: #3b3b3b;","+    --md-code-hl-keyword-color: #0000ff;","+    --md-code-hl-function-color: #795e26;","+    --md-code-hl-string-color: #a31515;","+    --md-code-hl-number-color: #098658;","+    --md-code-hl-comment-color: #008000;","+    --md-code-hl-variable-color: #001080;","+    --md-code-hl-operator-color: #3b3b3b;","+    --md-code-hl-punctuation-color: #3b3b3b;","+    --md-code-hl-constant-color: #0070c1;","+    --md-code-hl-name-color: #3b3b3b;","+    --md-code-hl-special-color: #811f3f;","+}","+","+[data-md-color-scheme=\"codeigniter\"] .highlight .nc,","+[data-md-color-scheme=\"codeigniter\"] .highlight .nn,","+[data-md-color-scheme=\"codeigniter\"] .highlight .nx.nx-class {","+    color: #267f99;","+}","+","+[data-md-color-scheme=\"codeigniter\"] .highlight .si {","+    color: #001080;","+}","+","+[data-md-color-scheme=\"codeigniter\"] .highlight .k.k-control {","+    color: #af00db;","+}","+","+[data-md-color-scheme=\"codeigniter\"] .highlight .nv.nv-this {","+    color: #0000ff;","+}","+","+[data-md-color-scheme=\"codeigniter\"] .highlight .nx.nx-constant {","+    color: #0070c1;","+}","+","+[data-md-color-scheme=\"codeigniter\"] .highlight .na.na-call {","+    color: #795e26;","+}","+","+/* Dark-scheme code colors matched to VS Code's Dark Modern token palette. */","+[data-md-color-scheme=\"slate\"] {","+    --md-code-bg-color: #1f1f1f;","+    --md-code-fg-color: #cccccc;","+    --md-code-hl-keyword-color: #569cd6;","+    --md-code-hl-function-color: #dcdcaa;","+    --md-code-hl-string-color: #ce9178;","+    --md-code-hl-number-color: #b5cea8;","+    --md-code-hl-comment-color: #6a9955;","+    --md-code-hl-variable-color: #9cdcfe;","+    --md-code-hl-operator-color: #