ndAdvance);","+    }","+","+    Status waitForData() override {","+        return Status::OK();","+    }","+","+    Future<void> asyncWaitForData() override {","+        return Future<void>::makeReady();","+    }","+","+    Status sinkMessage(Message) override {","+        _clock.advance(_writeAdvance);","+        return _writeStatus;","+    }","+","+    Future<void> asyncSinkMessage(Message message, const BatonHandle& = nullptr) override {","+        return Future<void>::makeReady(sinkMessage(std::move(message)));","+    }","+","+    StatusWith<Message> sourceMessage() override {","+        _clock.advance(_readAdvance);","+        if (!_readStatus.isOK()) {","+            return _readStatus;","+        }","+        if (_replies.empty()) {","+            return Status(ErrorCodes::HostUnreachable, \"No fake reply was queued\");","+        }","+        auto reply = std::move(_replies.front());","+        _replies.pop_front();","+        return reply;","+    }","+","+    Future<Message> asyncSourceMessage(const BatonHandle& = nullptr) override {","+        auto reply = sourceMessage();","+        return reply.isOK() ? Future<Message>(std::move(reply.getValue()))","+                            : Future<Message>(reply.getStatus());","+    }","+","+    void queueReply(Message reply) {","+        _replies.push_back(std::move(reply));","+    }","+","+    void setWriteAdvance(Microseconds advance) {","+        _writeAdvance = advance;","+    }","+","+    void setReadAdvance(Microseconds advance) {","+        _readAdvance = advance;","+    }","+","+    void setEndAdvance(Microseconds advance) {","+        _endAdvance = advance;","+    }","+","+    void setWriteStatus(Status status) {","+        _writeStatus = std::move(status);","+    }","+","+    void setReadStatus(Status status) {","+        _readStatus = std::move(status);","+    }","+","+private:","+    TickSourceMock<Microseconds>& _clock;","+    std::deque<Message> _replies;","+    Microseconds _writeAdvance{0};","+    Microseconds _readAdvance{0};","+    Microseconds _endAdvance{0};","+    Status _writeStatus = Status::OK();","+    Status _readStatus = Status::OK();","+};","+","+class FakeSyncConnection : public DBClientConnection {","+public:","+    explicit FakeSyncConnection(TickSourceMock<Microseconds>& clock, bool autoReconnect = false)","+        : DBClientConnection({.autoReconnect = autoReconnect}),","+          _fakeSession(std::make_shared<FakeSyncSession>(clock)) {","+        setTickSource_forTest(&clock);","+    }","+","+    FakeSyncSession& fakeSession() {","+        return *_fakeSession;","+    }","+","+    void setMakeSessionStatus(Status status) {","+        _makeSessionStatus = std::move(status);","+    }","+","+    void markFailed() {","+        _markFailed(kSetFlag);","+    }","+","+private:","+    StatusWith<std::shared_ptr<transport::Session>> _makeSession(","+        const HostAndPort&,","+        transport::ConnectSSLMode,","+        Milliseconds,","+        const boost::optional<TransientSSLParams>&) override {","+        if (!_makeSessionStatus.isOK()) {","+            return _makeSessionStatus;","+        }","+        return std::static_pointer_cast<transport::Session>(_fakeSession);","+    }","+","+    void _reconnectSession() override {","+        connect(_serverAddress, \"test\", boost::none);","+    }","+","+    void _killSession() override {","+        _fakeSession->end();","+    }","+","+    std::shared_ptr<FakeSyncSession> _fakeSession;","+    Status _makeSessionStatus = Status::OK();","+};","+","+class DBClientConnectionTimingFixture : public ServiceContextTest {","+protected:","+    void setUp() override {","+        ServiceContextTest::setUp();","+        if (!_capturer.canReadMetrics()) {","+            GTEST_SKIP() << \"OTel metrics reader unavailable\";","+        }","+    }","+","+    int64_t countFor(std::string_view kind) {","+        try {","+            return _capturer","+                .readInt64Histogram(otel::metrics::MetricNames::kNetworkRpcLocalLatency,","+                                    std::tuple{kind, \"sync\"sv})","+                .count;","+        } catch (const DBException&) {","+            return 0;","+        }","+    }","+","+    int64_t sumFor(std::string_view kind) {","+        try {","+            return _capturer","+                .readInt64Histogram(otel::metrics::MetricNames::kNetworkRpcLocalLatency,","+                                    std::tuple{kind, \"sync\"sv})","+                .sum;","+        } catch (const DBException&) {","+            return 0;","+        }","+    }","+","+    void connect(FakeSyncConnection& connection) {","+        connection.connectNoHello(HostAndPort(\"localhost\", 27017), boost::none);","+    }","+","+    TickSourceMock<Microseconds> _clock;","+","+private:","+    otel::metrics::OtelMetricsCapturer _capturer;","+};","+","+TEST_F(DBClientConnectionTimingFixture, RunCommandRecordsLocalTimeOnceAndExcludesReadWait) {","+    FakeSyncConnection connection(_clock);","+    connect(connection);","+    connection.fakeSession().queueReply(makeOpMsg(BSON(\"ok\" << 1)));","+    connection.fakeSession().setWriteAdvance(Microseconds{3000});","+    connection.fakeSession().setReadAdvance(Seconds{10});","+    connection.setRequestMetadataWriter([&](OperationContext*, BSONObjBuilder*) {","+        _clock.advance(Microseconds{2000});","+        return Status::OK();","+    });","+    connection.setReplyMetadataReader([&](OperationContext*, const BSONObj&, std::string_view) {","+        _clock.advance(Microseconds{700});","+        return Status::OK();","+    });","+","+    connection.runCommandWithTarget(makeCommandRequest());","+","+    EXPECT_EQ(countFor(\"initial\"), 1);","+    EXPECT_EQ(sumFor(\"initial\"), 5700);","+}","+","+TEST_F(DBClientConnectionTimingFixture, FireAndForgetRecordsItsOwnKindOnce) {","+    FakeSyncConnection connection(_clock);","+    connect(connection);","+    connection.fakeSession().setWriteAdvance(Microseconds{3000});","+","+    const auto nss = NamespaceString::createNamespaceString_forTest(\"test\", \"coll\");","+    EXPECT_EQ(&connection, connection.runFireAndForgetCommand(makeCommandRequest()));","+    connection.killCursor(nss, 42);","+","+    EXPECT_EQ(countFor(\"fire_and_forget\"), 2);","+    EXPECT_EQ(sumFor(\"fire_and_forget\"), 6000);","+    EXPECT_EQ(countFor(\"initial\"), 0);","+}","+","+TEST_F(DBClientConnectionTimingFixture, ExhaustCursorRecordsContinuationsWithoutCallerGaps) {","+    FakeSyncConnection connection(_clock);","+    connect(connection);","+    connection.fakeSession().setWriteAdvance(Microseconds{3000});","+    connection.fakeSession().setReadAdvance(Seconds{10});","+","+    const NamespaceString nss = NamespaceString::createNamespaceString_forTest(\"test\", \"coll\");","+    FindCommandRequest findCmd{nss};","+    DBClientCursor cursor(&connection, findCmd, ReadPreferenceSetting{}, true /* isExhaust */);","+    cursor.setBatchSize(0);","+","+    BSONArrayBuilder emptyBatch;","+    auto initialReply = makeOpMsg(BSON(\"ok\" << 1 << \"cursor\"","+                                            << BSON(\"id\" << 42LL << \"ns\" << \"test.coll\"","+                                                         << \"firstBatch\" << emptyBatch.arr())));","+    OpMsg::setFlag(&initialReply, OpMsg::kMoreToCome);","+    const auto initialReplyId = initialReply.header().getId();","+    connection.fakeSession().queueReply(std::move(initialReply));","+","+    ASSERT(cursor.init());","+","+    auto firstContinuation =","+        makeOpMsg(BSON(\"ok\" << 1 << \"cursor\"","+                            << BSON(\"id\" << 42LL << \"ns\" << \"test.coll\"","+                                         << \"nextBatch\" << BSON_ARRAY(BSON(\"_id\" << 1)))));","+    OpMsg::setFlag(&firstContinuation, OpMsg::kMoreToCome);","+    firstContinuation.header().setResponseToMsgId(initialReplyId);","+    const auto firstContinuationId = firstContinuation.header().getId();","+    connection.fakeSession().queueReply(std::move(firstContinuation));","+","+    auto finalContinuation =","+        makeOpMsg(BSON(\"ok\" << 1 << \"cursor\"","+                            << BSON(\"id\" << 0LL << \"ns\" << \"test.coll\"","+                                         << \"nextBatch\" << BSON_ARRAY(BSON(\"_id\" << 2)))));","+    finalContinuation.header().setResponseToMsgId(firstContinuationId);","+    connection.fakeSession().queueReply(std::move(finalContinuation));","+","+    ASSERT(cursor.more());","+    EXPECT_THAT(cursor.next(), unittest::match::BSONObjEQ(BSON(\"_id\" << 1)));","+    _clock.advance(Seconds{5});","+    ASSERT(cursor.more());","+    EXPECT_THAT(cursor.next(), unittest::match::BSONObjEQ(BSON(\"_id\" << 2)));","+    EXPECT_TRUE(cursor.isDead());","+","+    EXPECT_EQ(countFor(\"initial\"), 1);","+    EXPECT_EQ(sumFor(\"initial\"), 3000);","+    EXPECT_EQ(countFor(\"exhaust_continuation\"), 2);","+    EXPECT_EQ(sumFor(\"exhaust_continuation\"), 0);","+}","+","+TEST_F(DBClientConnectionTimingFixture, FailedReadStillRecordsTheAttempt) {","+    FakeSyncConnection connection(_clock);","+    connect(connection);","+    connection.fakeSession().setWriteAdvance(Microseconds{3000});","+    connection.fakeSession().setReadAdvance(Seconds{10});","+    connection.fakeSession().setEndAdvance(Microseconds{1000});","+    connection.fakeSession().setReadStatus(","+        Status(ErrorCodes::HostUnreachable, \"fake read failure\"));","+","+    ASSERT_THROWS_CODE(connection.runCommandWithTarget(makeCommandRequest()),","+                       DBException,","+                       ErrorCodes::HostUnreachable);","+","+    EXPECT_EQ(countFor(\"initial\"), 1);","+    EXPECT_EQ(sumFor(\"initial\"), 4000);","+}","+","+TEST_F(DBClientConnectionTimingFixture, FailedConnectRestoresTimingSuppression) {","+    FakeSyncConnection connection(_clock);","+    connect(connection);","+    connection.setMakeSessionStatus(","+        Status(ErrorCodes::HostUnreachable, \"fake connection setup failure\"));","+    ASSERT_THROWS_CODE(connection.connect(HostAndPort(\"localhost\", 27017), \"test\", boost::none),","+                       DBException,","+                       ErrorCodes::HostUnreachable);","+    EXPECT_EQ(countFor(\"initial\"), 0);","+","+    connection.setMakeSessionStatus(Status::OK());","+    connect(connection);","+    connection.fakeSession().queueReply(makeOpMsg(BSON(\"ok\" << 1)));","+    connection.runCommandWithTarget(makeCommandRequest());","+    EXPECT_EQ(countFor(\"initial\"), 1);","+}","+","+TEST_F(DBClientConnectionTimingFixture, ExplicitConnectDoesNotRecordHandshake) {","+    FakeSyncConnection connection(_clock);","+    connection.fakeSession().queueReply(makeHelloReply());","+    connection.connect(HostAndPort(\"localhost\", 27017), \"test\", boost::none);","+","+    EXPECT_EQ(countFor(\"initial\"), 0);","+    EXPECT_EQ(countFor(\"fire_and_forget\"), 0);","+    EXPECT_EQ(countFor(\"exhaust_continuation\"), 0);","+}","+","+TEST_F(DBClientConnectionTimingFixture, ReconnectHandshakeTimeIsIncludedInCommandSample) {","+    FakeSyncConnection connection(_clock, true /* autoReconnect */);","+    connect(connection);","+    connection.markFailed();","+    connection.fakeSession().queueReply(makeHelloReply());","+    connection.fakeSession().queueReply(makeOpMsg(BSON(\"ok\" << 1)));","+    connection.fakeSession().setReadAdvance(Microseconds{7000});","+","+    connection.runCommandWithTarget(makeCommandRequest());","+","+    EXPECT_EQ(countFor(\"initial\"), 1);","+    EXPECT_EQ(sumFor(\"initial\"), 7000);","+}","+","+TEST_F(DBClientConnectionTimingFixture, FailedWriteStillRecordsTheAttempt) {","+    FakeSyncConnection connection(_clock);","+    connect(connection);","+    connection.fakeSession().setWriteAdvance(Microseconds{3000});","+    connection.fakeSession().setWriteStatus(","+        Status(ErrorCodes::HostUnreachable, \"fake write failure\"));","+","+    ASSERT_THROWS_CODE(connection.runCommandWithTarget(makeCommandRequest()),","+                       DBException,","+                       ErrorCodes::HostUnreachable);","+","+    EXPECT_EQ(countFor(\"initial\"), 1);","+    EXPECT_EQ(sumFor(\"initial\"), 3000);","+}","+","+}  // namespace"," "," class DBClientConnectionFixture : public unittest::Test {};"," "],"additions":356,"deletions":0,"truncated":false},{"path":"src/mongo/client/dbclient_session.cpp","lines":["@@ -18,6 +18,7 @@"," #include \"mongo/bson/util/builder_fwd.h\""," #include \"mongo/client/authenticate.h\""," #include \"mongo/client/replica_set_monitor.h\"","+#include \"mongo/client/rpc_local_timing.h\""," #include \"mongo/client/sasl_client_authenticate.h\""," #include \"mongo/client/sasl_client_session.h\""," #include \"mongo/config.h\"  // IWYU pragma: keep","@@ -30,6 +31,7 @@"," #include \"mongo/db/stats/counters.h\""," #include \"mongo/db/wire_version.h\""," #include \"mongo/executor/remote_command_response.h\"","+#include \"mongo/executor/rpc_local_timing.h\""," #include \"mongo/logv2/log.h\""," #include \"mongo/rpc/get_status_from_command_result.h\""," #include \"mongo/rpc/metadata/client_metadata.h\"","@@ -46,6 +48,7 @@"," #include \"mongo/util/net/ssl_peer_info.h\""," #include \"mongo/util/scopeguard.h\""," #include \"mongo/util/str.h\"","+#include \"mongo/util/system_tick_source.h\""," #include \"mongo/util/time_support.h\""," #include \"mongo/util/version.h\""," ","@@ -73,6 +76,28 @@ auto& dbClientSessionReconnectAttempts ="," // ensureConnection() with autoReconnect = false so does not try to reconnect."," auto& dbClientSessionWithoutAutoReconnectFailures =","     *MetricBuilder<Counter64>(\"network.dbClientSessionWithoutAutoReconnectFailures\");","+","+/**","+ * Helper class to track the time spent waiting for a response in the RPC local timing via its","+ * lifetime.","+ */","+class RpcLocalTimingResponseWait {","+public:","+    explicit RpcLocalTimingResponseWait(RpcLocalTiming* timing) : _timing(timing) {","+        if (_timing) {","+            _timing->begin