{"id":"5c1ae54b0e546b3038f6748935ad6711e1e01862","axis":"silent","repo":"web-token/jwt-framework","sha":"5c1ae54b0e546b3038f6748935ad6711e1e01862","parsed":{"files":[{"path":"src/Library/Core/Exception/JsonBoundExceededException.php","lines":["@@ -0,0 +1,14 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Jose\\Component\\Core\\Exception;","+","+/**","+ * Thrown when the JSON documents of a token go beyond the bounds this library decodes: more JSON values than","+ * BoundedJsonDecoder::MAX_VALUES, or a document nested more deeply than json_decode() reads. The JSON may be valid: the","+ * token is rejected for its size or its depth, not for its syntax.","+ */","+class JsonBoundExceededException extends InvalidArgumentException","+{","+}"],"additions":14,"deletions":0,"truncated":false},{"path":"src/Library/Core/Util/BoundedJsonDecoder.php","lines":["@@ -5,6 +5,7 @@"," namespace Jose\\Component\\Core\\Util;"," "," use Jose\\Component\\Core\\Exception\\InvalidArgumentException;","+use Jose\\Component\\Core\\Exception\\JsonBoundExceededException;"," use SensitiveParameter;"," use function preg_replace;"," use function sprintf;","@@ -17,8 +18,8 @@","  * limits the depth: a document of brackets decodes to a hundred times its size, and colliding member names make it","  * quadratic.","  *","- * A document rejected for the values it holds or for its depth is rejected with a message that names the bound; the","- * other errors of json_decode() keep the exception of JsonConverter::decode().","+ * A document rejected for the values it holds or for its depth is rejected with a JsonBoundExceededException, whose","+ * message names the bound; the other errors of json_decode() keep the exception of JsonConverter::decode().","  *","  * @internal","  */","@@ -31,15 +32,16 @@ final class BoundedJsonDecoder","     private bool $exceededMaxDepth = false;"," ","     /**","-     * @throws InvalidArgumentException if the document is not valid JSON, if it is nested too deeply, or if the","-     *                                  documents given to this decoder hold more than MAX_VALUES values. The code of","-     *                                  the exception is that of the JSON error, 0 for the values.","+     * @throws JsonBoundExceededException if the document is nested too deeply, or if the documents given to this","+     *                                    decoder hold more than MAX_VALUES values. The code of the exception is that of","+     *                                    the JSON error, 0 for the values.","+     * @throws InvalidArgumentException if the document is not valid JSON","      */","     public function decode(#[SensitiveParameter] string $json): mixed","     {","         $this->remainingValues -= self::countValues($json);","         if ($this->remainingValues < 0) {","-            throw new InvalidArgumentException(sprintf(","+            throw new JsonBoundExceededException(sprintf(","                 'The JSON documents of the token hold more JSON values than the %d that are decoded.',","                 self::MAX_VALUES","             ));","@@ -51,7 +53,7 @@ public function decode(#[SensitiveParameter] string $json): mixed","                 throw $exception;","             }","             $this->exceededMaxDepth = true;","-            throw new InvalidArgumentException(","+            throw new JsonBoundExceededException(","                 'A JSON document of the token is nested too deeply.',","                 $exception->getCode(),","                 $exception->getPrevious()"],"additions":9,"deletions":7,"truncated":false},{"path":"src/Library/Encryption/Serializer/JWESerializerManager.php","lines":["@@ -6,8 +6,10 @@"," "," use InvalidArgumentException;"," use Jose\\Component\\Core\\Exception\\InvalidSerializationException;","+use Jose\\Component\\Core\\Exception\\JsonBoundExceededException;"," use Jose\\Component\\Core\\Exception\\UnsupportedSerializerException;"," use Jose\\Component\\Encryption\\JWE;"