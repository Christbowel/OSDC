Result","     {","         $lastError = null;","+        $boundError = null;","         foreach ($this->serializers as $serializer) {","             try {","                 return new UnserializationResult($serializer->unserialize($input), $serializer->name());","             } catch (InvalidArgumentException $invalidArgumentException) {","                 $lastError = $invalidArgumentException;","+                if (self::goesBackToAJsonBound($invalidArgumentException)) {","+                    $boundError = $invalidArgumentException;","+                }"," ","                 continue;","             }","         }"," ","-        throw new InvalidSerializationException('Unsupported input.', 0, $lastError);","+        throw new InvalidSerializationException('Unsupported input.', 0, $boundError ?? $lastError);","+    }","+","+    /**","+     * Whether the exception, or one of the exceptions it chains, rejects the input for a bound of the JSON decoder.","+     */","+    private static function goesBackToAJsonBound(?Throwable $throwable): bool","+    {","+        while ($throwable !== null) {","+            if ($throwable instanceof JsonBoundExceededException) {","+                return true;","+            }","+            $throwable = $throwable->getPrevious();","+        }","+","+        return false;","     }"," }"],"additions":28,"deletions":5,"truncated":false},{"path":"src/Library/Signature/Serializer/JWSSerializerManager.php","lines":["@@ -6,9 +6,11 @@"," "," use InvalidArgumentException;"," use Jose\\Component\\Core\\Exception\\InvalidSerializationException;","+use Jose\\Component\\Core\\Exception\\JsonBoundExceededException;"," use Jose\\Component\\Core\\Exception\\UnsupportedSerializerException;"," use Jose\\Component\\Signature\\JWS;"," use SensitiveParameter;","+use Throwable;"," use function func_num_args;"," use function sprintf;"," use function trigger_deprecation;","@@ -59,8 +61,8 @@ public function serialize(string $name, JWS $jws, ?int $signatur