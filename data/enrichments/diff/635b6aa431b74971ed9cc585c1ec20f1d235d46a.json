eypatch, config.OPIK_WORKSPACE_DEFAULT_NAME)"],"additions":11,"deletions":0,"truncated":false},{"path":"sdks/typescript/src/opik/cli/analytics.ts","lines":["@@ -1,8 +1,9 @@","-import { createHash, randomBytes } from \"node:crypto\";","+import { randomBytes } from \"node:crypto\";"," import fs from \"node:fs\";"," import os from \"node:os\";"," import path from \"node:path\";"," import ini from \"ini\";","+import { clientIdentifier } from \"../utils/clientId\";"," "," /**","  * Reports what this command did to Comet's stats collector, which forwards to","@@ -156,10 +157,7 @@ export function userIdentifier(","     return workspace;","   }"," ","-  const machine = createHash(\"sha256\")","-    .update(os.hostname() + userName())","-    .digest(\"hex\");","-  return `${WORKSPACE_DEFAULT_NAME}_${machine}`;","+  return `${WORKSPACE_DEFAULT_NAME}_${clientIdentifier()}`;"," }"," "," export function createReporter(","@@ -254,11 +252,3 @@ function workspaceFromConfigFile(env: NodeJS.ProcessEnv, home: string): string {"," function blankToUndefined(value: string | undefined): string | undefined {","   return value === undefined || value.trim() === \"\" ? undefined : value;"," }","-","-function userName(): string {","-  try {","-    return os.userInfo().username;","-  } catch {","-    return \"\";","-  }","-}"],"additions":3,"deletions":13,"truncated":false},{"path":"sdks/typescript/src/opik/client/OpikApiClientTemp.ts","lines":["@@ -1,6 +1,7 @@"," import { OpikApiClient } from \"@/rest_api\";"," import { RequestOptions } from \"@/types/request\";"," import { Supplier } from \"@/rest_api/core\";","+import { CLIENT_ID_HEADER, clientIdentifier } from \"@/utils/clientId\";"," "," export interface OpikApiClientTempOptions extends OpikApiClient.Options {","   requestOptions?: RequestOptions;","@@ -12,6 +13,7 @@ export class OpikApiClientTemp extends OpikApiClient {","   constructor(options?: OpikApiClientTempOptions) {","     // Merge headers from options and requestOptions","     const mergedHeaders: Record<string, string | Supplier<string | null | undefined> | null | undefined> = {","+      [CLIENT_ID_HEADER]: clientIdentifier(),","       ...options?.headers,","       ...options?.requestOptions?.headers,","     };"],"additions":2,"deletions":0,"truncated":false},{"path":"sdks/typescript/src/opik/utils/clientId.ts","lines":["@@ -0,0 +1,29 @@","+import { createHash } from \"node:crypto\";","+import os from \"node:os\";","+","+/** Lets an installation count its distinct SDK clients. */","+export const CLIENT_ID_HEADER = \"X-Opik-Client-Id\";","+","+/**","+ * An anonymous identifier for this machine and OS user: a hash of the hostname","+ * and username, never the raw values. Derived the way the Python SDK's","+ * `get_client_identifier` is, so one machine counts once across both SDKs.","+ */","+export function clientIdentifier(): string {","+  return createHash(\"sha256\")","+    .update(os.hostname() + userName())","+    .digest(\"hex\");","+}","+","+// Mirrors Python's `getpass.getuser()` and Opik's \"unknown\" fallback, so a host","+// with no passwd entry (e.g. a container running as an arbitrary UID) hashes the same in both SDKs.","+export function userName(env: NodeJS.ProcessEnv = process.env): string {","+  for (const name of [\"LOGNAME\", \"USER\", \"LNAME\", \"USERNAME\"]) {","+    if (env[name]) return env[name];","+  }","+  try {","+    return os.userInfo().username;","+  } catch {","+    return \"unknown\";","+  }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"sdks/typescript/tests/unit/client/clientId.test.ts","lines":["@@ -0,0 +1,51 @@","+import os from \"node:os\";","+import { afterEach, describe, expect, it, vi } from \"vitest\";","+import { OpikApiClientTemp } from \"@/client/OpikApiClientTemp\";","+import { CLIENT_ID_HEADER, clientIdentifier, userName } from \"@/utils/clientId\";","+","+afterEach(() => {","+  vi.restoreAllMocks();","+});","+","+describe(\"userName\", () => {","+  it(\"prefers the environment, in the order Python's getpass uses\", () => {","+    expect(userName({ USER: \"bob\", LOGNAME: \"alice\" })).toBe(\"alice\");","+  });","+","+  it(\"falls back to 'unknown' like the Python SDK when there is no passwd entry\", () => {","+    vi.spyOn(os, \"userInfo\").mockImplementation(() => {","+      throw new Error(\"no passwd entry\");","+    });","+","+    expect(userName({})).toBe(\"unknown\");","+  });","+});","+","+describe(\"OpikApiClientTemp client id header\", () => {","+  const sentHeaders = async (client: OpikApiClientTemp) => {","+    const fetchSpy = vi","+      .spyOn(globalThis, \"fetch\")","+      .mockResolvedValue(new Response(\"{}\", { status: 200 }));","+    await client.projects.findProjects();","+    return new Headers(fetchSpy.mock.calls[0][1]?.headers);","+  };","+","+  it(\"sends the client identifier on every request\", async () => {","+    const headers = await sentHeaders(","+      new OpikApiClientTemp({ environment: \"http://localhost/api\" }),","+    );","+","+    expect(headers.get(CLIENT_ID_HEADER)).toBe(clientIdentifier());","+  });","+","+  it(\"lets caller-supplied headers override it\", async () => {","+    const headers = await sentHeaders(","+      new OpikApiClientTemp({","+        environment: \"http://localhost/api\",","+        requestOptions: { headers: { [CLIENT_ID_HEADER]: \"custom\" } },","+      }),","+    );","+","+    expect(headers.get(CLIENT_ID_HEADER)).toBe(\"custom\");","+  });","+});",""],"additions":51,"deletions":0,"truncated":false}],"additions":149,"deletions":16,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-16T14:19:40.076822+00:00"}