const stored = localStorage.getItem(BROWSER_ID_KEY);","+    if (stored) return stored;","+    const id = uuidv4();","+    localStorage.setItem(BROWSER_ID_KEY, id);","+    return id;","+  } catch {","+    // Storage blocked (private mode, disabled site data): count this page load on its own.","+    return uuidv4();","+  }","+};","+const browserId = getBrowserId();","+// Opik backend only: other services reached through this instance (BASE_OPIK_AI_URL)","+// may be cross-origin, and an unknown header would fail their CORS preflight.","+axiosInstance.interceptors.request.use((config) => {","+  const isOpikBackend =","+    (config.baseURL ?? BASE_API_URL) === BASE_API_URL &&","+    !/^https?:\\/\\//.test(config.url ?? \"\");","+  if (isOpikBackend) {","+    config.headers.set(\"X-Opik-Browser-Id\", browserId);","+  }","+  return config;","+});","+"," export const CODE_EXECUTOR_SERVICE_URL = import.meta.env","   .VITE_GET_STARTED_API_URL;"," export const FEATURE_TOGGLES_REST_ENDPOINT = \"/v1/private/toggles/\";"],"additions":28,"deletions":0,"truncated":false},{"path":"sdks/python/src/opik/environment.py","lines":["@@ -59,9 +59,20 @@ def get_user_identifier() -> str:","     if workspace and workspace != opik.config.OPIK_WORKSPACE_DEFAULT_NAME:","         return workspace"," ","-    hashed_part = _hash(get_hostname() + get_user())","+    return f\"{opik.config.OPIK_WORKSPACE_DEFAULT_NAME}_{get_client_identifier()}\""," ","-    return f\"{opik.config.OPIK_WORKSPACE_DEFAULT_NAME}_{hashed_part}\"","+","+@functools.lru_cache","+def get_client_identifier() -> str:","+    \"\"\"","+    An anonymous identifier for this machine and OS user: a hash of the hostname and","+    username, never the raw values.","+","+    Sent to the backend on every request so an installation can estimate how many","+    distinct clients use it. Unlike `get_user_identifier` it ignores the workspace,","+    which every member of a team shares and would make them count as one client.","+    \"\"\"","+  