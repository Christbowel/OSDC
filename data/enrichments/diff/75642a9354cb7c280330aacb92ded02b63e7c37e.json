{"id":"75642a9354cb7c280330aacb92ded02b63e7c37e","axis":"silent","repo":"envoyproxy/envoy","sha":"75642a9354cb7c280330aacb92ded02b63e7c37e","parsed":{"files":[{"path":"CODEOWNERS","lines":["@@ -166,6 +166,7 @@"," /*/extensions/resource_monitors/downstream_connections @nezdolik @mattklein123"," /*/extensions/resource_monitors/cpu_utilization @cancecen @kbaichoo @nix1n"," /*/extensions/resource_monitors/cgroup_memory @botengyao @kbaichoo @alesabater","+/*/extensions/resource_monitors/dynamic_modules @agrawroh @mathetake @wbpcode"," /*/extensions/retry/priority @ravenblackx @mattklein123"," /*/extensions/retry/priority/previous_priorities @ravenblackx @mattklein123"," /*/extensions/retry/host @ravenblackx @mattklein123"],"additions":1,"deletions":0,"truncated":false},{"path":"api/BUILD","lines":["@@ -434,6 +434,7 @@ proto_library(","         \"//envoy/extensions/resource_monitors/cgroup_memory/v3:pkg\",","         \"//envoy/extensions/resource_monitors/cpu_utilization/v3:pkg\",","         \"//envoy/extensions/resource_monitors/downstream_connections/v3:pkg\",","+        \"//envoy/extensions/resource_monitors/dynamic_modules/v3:pkg\",","         \"//envoy/extensions/resource_monitors/fixed_heap/v3:pkg\",","         \"//envoy/extensions/resource_monitors/injected_resource/v3:pkg\",","         \"//envoy/extensions/retry/host/omit_canary_hosts/v3:pkg\","],"additions":1,"deletions":0,"truncated":false},{"path":"api/envoy/extensions/resource_monitors/dynamic_modules/v3/BUILD","lines":["@@ -0,0 +1,12 @@","+# DO NOT EDIT. This file is generated by tools/proto_format/proto_sync.py.","+","+load(\"@envoy_api//bazel:api_build_system.bzl\", \"api_proto_package\")","+","+licenses([\"notice\"])  # Apache 2","+","+api_proto_package(","+    deps = [","+        \"//envoy/extensions/dynamic_modules/v3:pkg\",","+        \"@xds//udpa/annotations:pkg\",","+    ],","+)"],"additions":12,"deletions":0,"truncated":false},{"path":"api/envoy/extensions/resource_monitors/dynamic_modules/v3/dynamic_modules.proto","lines":["@@ -0,0 +1,46 @@","+syntax = \"proto3\";","+","+package envoy.extensions.resource_monitors.dynamic_modules.v3;","+","+import \"envoy/extensions/dynamic_modules/v3/dynamic_modules.proto\";","+","+import \"google/protobuf/any.proto\";","+","+import \"udpa/annotations/status.proto\";","+import \"validate/validate.proto\";","+","+option java_package = \"io.envoyproxy.envoy.extensions.resource_monitors.dynamic_modules.v3\";","+option java_outer_classname = \"DynamicModulesProto\";","+option java_multiple_files = true;","+option go_package = \"github.com/envoyproxy/go-control-plane/envoy/extensions/resource_monitors/dynamic_modules/v3;dynamic_modulesv3\";","+option (udpa.annotations.file_status).package_version_status = ACTIVE;","+","+// [#protodoc-title: Dynamic Modules Resource Monitor]","+// [#extension: envoy.resource_monitors.dynamic_modules]","+","+// Configuration for an :ref:`overload manager <arch_overview_overload_manager>` resource monitor","+// implemented by a dynamic module, which reports the pressure of the monitored resource. The","+// pressure is the ratio of the usage of the resource to its limit. See","+// :ref:`Dynamic Modules <config_overload_manager_dynamic_modules>`.","+message DynamicModuleResourceMonitor {","+  // Specifies the shared-object level configuration. This field is required.","+  //","+  // Only the ``name`` and ``module.local.filename`` sources are supported. Remote module sources","+  // are not supported because resource monitors are created without a factory context.","+  envoy.extensions.dynamic_modules.v3.DynamicModuleConfig dynamic_module_config = 1","+      [(validate.rules).message = {required: true}];","+","+  // The name identifying the resource monitor implementation within the module. This is passed to","+  // the module's resource monitor init function so that a module can host multiple","+  // implementations. This field is required.","+  string resource_monitor_name = 2 [(validate.rules).string = {min_len: 1}];","+","+  // The configuration for the implementation chosen by ``resource_monitor_name``. If not","+  // specified, an empty configuration is passed to the module.","+  //","+  // ``google.protobuf.Struct`` and the ``value`` field of ``xds.type.v3.TypedStruct`` are","+  // serialized as JSON before passing them to the module.","+  // ``google.protobuf.BytesValue`` and ``google.protobuf.StringValue`` are passed directly without","+  // the wrapper. Otherwise the serialized bytes of the configured message are passed.","+  google.protobuf.Any resource_monitor_config = 3;","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"api/versioning/BUILD","lines":["@@ -369,6 +369,7 @@ proto_library(","         \"//envoy/extensions/resource_monitors/cgroup_memory/v3:pkg\",","         \"//envoy/extensions/resource_monitors/cpu_utilization/v3:pkg\",","         \"//envoy/extensions/resource_monitors/downstream_connections/v3:pkg\",","+        \"//envoy/extensions/resource_monitors/dynamic_modules/v3:pkg\",","         \"//envoy/extensions/resource_monitors/fixed_heap/v3:pkg\",","         \"//envoy/extensions/resource_monitors/injected_resource/v3:pkg\",","         \"//envoy/extensions/retry/host/omit_canary_hosts/v3:pkg\","],"additions":1,"deletions":0,"truncated":false},{"path":"changelogs/current/new_features/dynamic_modules__add-resource-monitor-support.rst","lines":["@@ -0,0 +1,11 @@","+Added a dynamic modules resource monitor extension (``envoy.resource_monitors.dynamic_modules``)","+that lets a dynamic module report the pressure of an overload manager resource at each refresh, or","+later from any thread through a scheduler. The module creates the scheduler with","+``envoy_dynamic_module_callback_resource_monitor_config_scheduler_new``, reports through it with","+``envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_resource_usage`` and","+``envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_failure``, and deletes it","+with ``envoy_dynamic_module_callback_resource_monitor_config_scheduler_delete``. The Rust SDK","+exposes this through the ``resource_monitor:`` arm of ``declare_all_init_functions!``,","+``ResourceMonitor::update_resource_usage``, ``EnvoyResourceMonitorConfig::new_config_scheduler``,","+and the ``report_resource_usage`` and ``report_failure`` methods of","+``EnvoyResourceMonitorConfigScheduler``."],"additions":11,"deletions":0,"truncated":false},{"path":"docs/root/configuration/operations/overload_manager/overload_manager.rst","lines":["@@ -87,6 +87,37 @@ This can be combined with actions to shed load when memory pressure increases:","            threshold:","              value: 0.95  # Trigger at 95% memory utilization"," ","+.. _config_overload_manager_dynamic_modules:","+","+Dynamic Modules","+^^^^^^^^^^^^^^^","+","+A :ref:`dynamic module <arch_overview_dynamic_modules>` can implement a resource monitor through the","+:ref:`dynamic module resource monitor","+<envoy_v3_api_msg_extensions.resource_monitors.dynamic_modules.v3.DynamicModuleResourceMonitor>`.","+At each refresh interval the module reports the pressure of the resource, right away or later from","+any thread through a scheduler. Envoy treats a pressure above 1 as 1, and a negative or non-finite","+pressure as a failed update.","+","+The following configuration sheds new requests once the pressure that the module reports for the","+``queue_latency`` resource reaches 0.9.","+","+.. code-block:: yaml","+","+   resource_monitors:","+     - name: \"queue_latency\"","+       typed_config:","+         \"@type\": type.googleapis.com/envoy.extensions.resource_monitors.dynamic_modules.v3.DynamicModuleResourceMonitor","+         dynamic_module_config:","+           name: \"my_module\"","+         resource_monitor_name: \"latency\"","+   loadshed_points:","+     - name: \"envoy.load_shed_points.http_connection_manager_decode_headers\"","+       triggers:","+         - name: \"queue_latency\"","+           threshold:","+             value: 0.9","+"," .. _config_overload_manager_triggers:"," "," Triggers"],"additions":31,"deletions":0,"truncated":false},{"path":"docs/root/intro/arch_overview/advanced/dynamic_modules.rst","lines":["@@ -27,6 +27,8 @@ Currently, dynamic modules are supported at the following extension points:"," * As a :ref:`formatter <envoy_v3_api_msg_extensions.formatter.dynamic_modules.v3.DynamicModuleFormatter>`."," * As a :ref:`stats sink <envoy_v3_api_msg_extensions.stat_sinks.dynamic_modules.v3.DynamicModuleStatsSink>`","   (:ref:`configuration <config_stat_sinks_dynamic_modules>`).","+* As a :ref:`resource monitor <envoy_v3_api_msg_extensions.resource_monitors.dynamic_modules.v3.DynamicModuleResourceMonitor>`","+  (:ref:`configuration <config_overload_manager_dynamic_modules>`)."," * As a :ref:`network filter <envoy_v3_api_msg_extensions.filters.network.dynamic_modules.v3.DynamicModuleNetworkFilter>`."," * As an :ref:`HTTP filter <envoy_v3_api_msg_extensions.filters.http.dynamic_modules.v3.DynamicModuleFilter>`."," * As an :ref:`HTTP early header mutation <envoy_v3_api_msg_extensions.http.early_header_mutation.dynamic_modules.v3.DynamicModuleEarlyHeaderMutation>`.","@@ -200,7 +202,7 @@ Statistics"," "," Dynamic-module extension types that receive a factory context emit the following statistics in the shared ``dynamic_modules.`` namespace."," These stats track failures encountered while loading the extension's configuration. Extension points created without a factory context, such","-as config validators and the upstream HTTP TCP bridge, cannot emit these shared counters. Each one is tagged with","+as config validators, resource monitors and the upstream HTTP TCP bridge, cannot emit these shared counters. Each one is tagged with"," ``config_name``, set to the configured name of the dynamic-module extension instance — for example the"," :ref:`filter_name"," <envoy_v3_api_field_extensions.filters.http.dynamic_modules.v3.DynamicModuleFilter.filter_name>`"],"additions":3,"deletions":1,"truncated":false},{"path":"source/extensions/dynamic_modules/abi/abi.h","lines":["@@ -19827,6 +19827,200 @@ bool envoy_dynamic_module_on_header_formatter_format(","     envoy_dynamic_module_type_header_formatter_module_ptr formatter_module_ptr,","     envoy_dynamic_module_type_envoy_buffer key, envoy_dynamic_module_type_module_buffer* result);"," ","+// =============================================================================","+// ============================= Resource Monitor ==============================","+// =============================================================================","+//","+// This extension enables custom overload manager resource monitors via dynamic modules. At each","+// refresh interval of the overload manager, the module reports the pressure of the monitored","+// resource, which is the ratio of its usage to its limit. The overload actions and load shed points","+// with a trigger on the resource act on that pressure.","+","+// =============================================================================","+// Resource Monitor Types","+// =============================================================================","+","+/**","+ * envoy_dynamic_module_type_resource_monitor_config_envoy_ptr is a raw pointer to the","+ * DynamicModuleResourceMonitorConfig class in Envoy.","+ *","+ * OWNERSHIP: Envoy owns the pointer. It remains valid until","+ * envoy_dynamic_module_on_resource_monitor_config_destroy returns, or until","+ * envoy_dynamic_module_on_resource_monitor_config_new returns if that returns nullptr.","+ */","+typedef void* envoy_dynamic_module_type_resource_monitor_config_envoy_ptr;","+","+/**","+ * envoy_dynamic_module_type_resource_monitor_config_module_ptr is a pointer to an in-module","+ * resource monitor configuration.","+ *","+ * OWNERSHIP: The module is responsible for managing the lifetime of the pointer.","+ */","+typedef const void* envoy_dynamic_module_type_resource_monitor_config_module_ptr;","+","+/**","+ * envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr is a raw pointer to the","+ * DynamicModuleResourceMonitorConfigScheduler class in Envoy.","+ *","+ * The scheduler reports the outcome of a pending update from any thread, which lets a module","+ * compute the pressure off the main thread. It is created by","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_new, used via","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_resource_usage and","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_failure, and destroyed by","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_delete.","+ *","+ * OWNERSHIP: The allocation is done by Envoy but the module is responsible for managing the","+ * lifetime of the pointer. Since its lifecycle is owned by the module, this has the _module_ptr","+ * suffix.","+ */","+typedef void* envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr;","+","+/**","+ * envoy_dynamic_module_type_resource_monitor_update_status is returned by","+ * envoy_dynamic_module_on_resource_monitor_update_resource_usage to report the outcome of an","+ * update. There is no related C++ enum. Envoy reports a successful update with","+ * Server::ResourceUpdateCallbacks::onSuccess and a failed one with onFailure.","+ */","+typedef enum envoy_dynamic_module_type_resource_monitor_update_status {","+  // The module wrote the pressure of the resource to resource_pressure.","+  envoy_dynamic_module_type_resource_monitor_update_status_Success = 0,","+  // The update failed. The overload manager counts it in the failed_updates statistic of the","+  // resource and keeps acting on the last reported pressure.","+  envoy_dynamic_module_type_resource_monitor_update_status_Failure = 1,","+  // The module reports the outcome later with","+  // envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_resource_usage or","+  // envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_failure.","+  envoy_dynamic_module_type_resource_monitor_update_status_Pending = 2,","+} envoy_dynamic_module_type_resource_monitor_update_status;","+","+// =============================================================================","+// Resource Monitor Event Hooks","+// =============================================================================","+","+/**","+ * envoy_dynamic_module_on_resource_monitor_config_new is called by the main thread when the","+ * overload manager creates the resource monitor during server initialization. This happens before","+ * clusters, listeners and worker threads are created.","+ *","+ * @param config_envoy_ptr is the pointer to the DynamicModuleResourceMonitorConfig object in Envoy.","+ * @param name is the resource_monitor_name from the configuration. It is owned by Envoy and valid","+ * only for the duration of this call.","+ * @param config is the resource monitor configuration bytes owned by Envoy and valid only for the","+ * duration of this call.","+ * @return a pointer to the in-module resource monitor configuration. Returning nullptr indicates a","+ * failure to initialize the module, and Envoy fails to start.","+ */","+envoy_dynamic_module_type_resource_monitor_config_module_ptr","+envoy_dynamic_module_on_resource_monitor_config_new(","+    envoy_dynamic_module_type_resource_monitor_config_envoy_ptr config_envoy_ptr,","+    envoy_dynamic_module_type_envoy_buffer name, envoy_dynamic_module_type_envoy_buffer config);","+","+/**","+ * envoy_dynamic_module_on_resource_monitor_config_destroy is called by the main thread when the","+ * resource monitor is destroyed. This happens when the server shuts down, and during startup when","+ * Envoy rejects the configuration after the module has created its own. Worker threads can still be","+ * running at that point, so state that the module shares with its other extensions must stay","+ * valid. A pending update is dropped without being reported. The module may be unloaded once this","+ * returns, so it must stop the threads it started before returning.","+ *","+ * In validation mode, the module must not call envoy_dynamic_module_callback_get_concurrency or","+ * envoy_dynamic_module_callback_is_validation_mode here.","+ *","+ * @param config_module_ptr is the pointer to the in-module resource monitor configuration.","+ */","+void envoy_dynamic_module_on_resource_monitor_config_destroy(","+    envoy_dynamic_module_type_resource_monitor_config_module_ptr config_module_ptr);","+","+/**","+ * envoy_dynamic_module_on_resource_monitor_update_resource_usage is called by the main thread at","+ * each refresh interval of the overload manager to get the pressure of the resource.","+ * Implementations must not block. A module that needs slow work returns","+ * envoy_dynamic_module_type_resource_monitor_update_status_Pending and reports the outcome later.","+ *","+ * While an update is pending, the overload manager skips the following refreshes of the resource","+ * and counts them in the skipped_updates statistic of the resource. Envoy does not time out a","+ * pending update, so the overload manager keeps acting on the last reported pressure until the","+ * module reports the outcome.","+ *","+ * @param config_envoy_ptr is the pointer to the DynamicModuleResourceMonitorConfig object in Envoy.","+ * @param config_module_ptr is the pointer to the in-module resource monitor configuration.","+ * @param resource_pressure is where the module writes the pressure of the resource before it","+ * returns envoy_dynamic_module_type_resource_monitor_update_status_Success. The pressure is the","+ * ratio of the resource usage to its limit. Envoy treats a value above 1 as 1, and a negative or","+ * non-finite value as a failed update.","+ * @return the outcome of the update.","+ */","+envoy_dynamic_module_type_resource_monitor_update_status","+envoy_dynamic_module_on_resource_monitor_update_resource_usage(","+    envoy_dynamic_module_type_resource_monitor_config_envoy_ptr config_envoy_ptr,","+    envoy_dynamic_module_type_resource_monitor_config_module_ptr config_module_ptr,","+    double* resource_pressure);","+","+// =============================================================================","+// Resource Monitor Callbacks","+// =============================================================================","+","+/**","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_new creates a new resource","+ * monitor configuration scheduler, which reports the outcome of a pending update from any thread,","+ * including the ones managed by the module.","+ *","+ * The caller must delete the scheduler with","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_delete when it is no longer","+ * needed. See the comment on","+ * envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr.","+ *","+ * @param config_envoy_ptr is the pointer to the DynamicModuleResourceMonitorConfig object in Envoy.","+ * @return a pointer to the created scheduler.","+ */","+envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr","+envoy_dynamic_module_callback_resource_monitor_config_scheduler_new(","+    envoy_dynamic_module_type_resource_monitor_config_envoy_ptr config_envoy_ptr);","+","+/**","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_resource_usage reports","+ * the pressure of the resource for the update that","+ * envoy_dynamic_module_on_resource_monitor_update_resource_usage left pending.","+ *","+ * This can be called from any thread. Envoy applies the report on the main thread to the update","+ * that is pending then, and drops it if no update is pending or the resource monitor is destroyed","+ * or the server shuts down first.","+ *","+ * @param scheduler_module_ptr is the pointer to the scheduler created by","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_new.","+ * @param resource_pressure is the pressure of the resource. Envoy treats a value above 1 as 1, and","+ * a negative or non-finite value as a failed update.","+ */","+void envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_resource_usage(","+    envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr scheduler_module_ptr,","+    double resource_pressure);","+","+/**","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_failure reports that the","+ * update that envoy_dynamic_module_on_resource_monitor_update_resource_usage left pending failed.","+ *","+ * This can be called from any thread. Envoy applies the report on the main thread to the update","+ * that is pending then, and drops it if no update is pending or the resource monitor is destroyed","+ * or the server shuts down first.","+ *","+ * @param scheduler_module_ptr is the pointer to the scheduler created by","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_new.","+ */","+void envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_failure(","+    envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr scheduler_module_ptr);","+","+/**","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_delete deletes the scheduler","+ * created by envoy_dynamic_module_callback_resource_monitor_config_scheduler_new.","+ *","+ * This can be called from any thread, even after the resource monitor is destroyed.","+ *","+ * @param scheduler_module_ptr is the pointer to the scheduler created by","+ * envoy_dynamic_module_callback_resource_monitor_config_scheduler_new.","+ */","+void envoy_dynamic_module_callback_resource_monitor_config_scheduler_delete(","+    envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr scheduler_module_ptr);","+"," #ifdef __cplusplus"," }"," #endif"],"additions":194,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/abi_impl.cc","lines":["@@ -3712,6 +3712,25 @@ WEAK_STUB(envoy_dynamic_module_type_host_health,"," WEAK_STUB(bool, envoy_dynamic_module_callback_health_checker_set_health_metadata, false,","           envoy_dynamic_module_type_health_checker_session_envoy_ptr,","           envoy_dynamic_module_type_module_buffer, envoy_dynamic_module_type_module_buffer)","+","+// ---------------------- Resource Monitor callbacks ------------------------","+// These are weak symbols that provide default stub implementations. The actual implementations","+// are provided in the resource monitor abi_impl.cc when the resource monitor extension is used.","+","+WEAK_STUB(envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr,","+          envoy_dynamic_module_callback_resource_monitor_config_scheduler_new, nullptr,","+          envoy_dynamic_module_type_resource_monitor_config_envoy_ptr)","+","+WEAK_STUB_VOID(","+    envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_resource_usage,","+    envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr, double)","+","+WEAK_STUB_VOID(envoy_dynamic_module_callback_resource_monitor_config_scheduler_report_failure,","+               envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr)","+","+WEAK_STUB_VOID(envoy_dynamic_module_callback_resource_monitor_config_scheduler_delete,","+               envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr)","+"," #undef WEAK_STUB"," #undef WEAK_STUB_VOID"," "],"additions":19,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/lib.rs","lines":["@@ -33,6 +33,7 @@ pub mod load_balancer;"," pub mod matcher;"," pub mod matcher_data_input;"," pub mod network;","+pub mod resource_monitor;"," pub mod route_specifier;"," pub mod stats_sink;"," pub mod timing;","@@ -822,6 +823,7 @@ macro_rules! declare_network_filter_init_functions {"," /// - `header_formatter:` — [`NewHeaderFormatterConfigFunction`] for HTTP/1 header formatters"," /// - `tls_certificate_selector:` — [`NewTlsCertificateSelectorConfigFunction`] for TLS certificate"," ///   selectors","+/// - `resource_monitor:` — [`NewResourceMonitorConfigFunction`] for resource monitors"," ///"," /// # Examples"," ///","@@ -1084,6 +1086,13 @@ macro_rules! declare_all_init_functions {","       \"NEW_TLS_CERTIFICATE_SELECTOR_CONFIG_FUNCTION\"","     );","   };","+  (@register resource_monitor : $fn:expr) => {","+    envoy_proxy_dynamic_modules_rust_sdk::set_factory_once!(","+      envoy_proxy_dynamic_modules_rust_sdk::NEW_RESOURCE_MONITOR_CONFIG_FUNCTION,","+      $fn,","+      \"NEW_RESOURCE_MONITOR_CONFIG_FUNCTION\"","+    );","+  };"," }"," "," /// The function signature for the new network filter configuration function.","@@ -2022,6 +2031,29 @@ pub static NEW_TLS_CERTIFICATE_SELECTOR_CONFIG_FUNCTION: OnceLock<","   NewTlsCertificateSelectorConfigFunction,"," > = OnceLock::new();"," ","+// =================================================================================================","+// Resource Monitor Dynamic Module","+// =================================================================================================","+","+/// The function signature for creating a new resource monitor.","+///","+/// The `name` is the value of `resource_monitor_name` from the `dynamic_modules` resource monitor","+/// configuration, allowing a single module to dispatch to different implementations. The `config`","+/// is the raw bytes from the `resource_monitor_config` field. The `envoy_config` handle creates a","+/// [`resource_monitor::EnvoyResourceMonitorConfigScheduler`] while the configuration is being","+/// created. Returning `None` causes Envoy to fail to start.","+pub type NewResourceMonitorConfigFunction =","+  fn(","+    name: &str,","+    config: &[u8],","+    envoy_config: &mut resource_monitor::EnvoyResourceMonitorConfig,","+  ) -> Option<Box<dyn resource_monitor::ResourceMonitor>>;","+","+/// The global factory function for resource monitors. This is set via the `resource_monitor:` arm","+/// of [`declare_all_init_functions!`] and is not intended to be set directly.","+pub static NEW_RESOURCE_MONITOR_CONFIG_FUNCTION: OnceLock<NewResourceMonitorConfigFunction> =","+  OnceLock::new();","+"," // ============================================================================="," // Config Validator"," // ============================================================================="],"additions":32,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/lib_test.rs","lines":["@@ -14643,3 +14643,255 @@ fn test_envoy_route_specifier_config_impl() {","     route_specifier::envoy_dynamic_module_on_route_specifier_config_destroy(config_ptr);","   }"," }","+","+// =============================================================================","+// Resource Monitor","+// =============================================================================","+","+thread_local! {","+  // The id of the last scheduler created on this thread.","+  static LAST_RESOURCE_MONITOR_SCHEDULER_ID: std::cell::Cell<u64> =","+    const { std::cell::Cell::new(0) };","+}","+","+// A scheduler can be used and dropped on any thread, so its events are kept per scheduler id.","+static NEXT_RESOURCE_MONITOR_SCHEDULER_ID: std::sync::atomic::AtomicU64 =","+  std::sync::atomic::AtomicU64::new(1);","+static RESOURCE_MONITOR_SCHEDULER_EVENTS: std::sync::Mutex<Vec<(u64, String)>> =","+  std::sync::Mutex::new(Vec::new());","+","+// Stands for the Envoy side configuration, so the stubs can check that the SDK passes it on.","+fn resource_monitor_envoy_config(","+) -> abi::envoy_dynamic_module_type_resource_monitor_config_envoy_ptr {","+  static ENVOY_CONFIG: u8 = 0;","+  &ENVOY_CONFIG as *const u8 as *mut _","+}","+","+fn record_resource_monitor_scheduler_event(","+  scheduler: abi::envoy_dynamic_module_type_resource_monitor_config_scheduler_module_ptr,","+  event: String,","+) {","+  let id = u