ep must not","+\t\t// retain, modify, or append to it. Reads of one query can call the same Keep","+\t\t// at the same time, so it must be safe for concurrent use."," \t\tKeep func(line []byte) bool"," \t}"," "],"additions":4,"deletions":0,"truncated":false},{"path":"pkg/dataobj/sections/logs/row_reader.go","lines":["@@ -110,10 +110,11 @@ func (r *RowReader) SetPredicates(p []RowPredicate) error {"," //"," // The field of a column that is not read comes back as its zero value."," //","-// The columns a stream match or a predicate needs are read whether or not they are listed,","-// because a predicate that finds no column reduces to \"drop every row\". A column added","-// that way is decoded into the [Record] as well, so a pushed-down metadata predicate makes","-// its key visible even when the caller did not project it.","+// The reader reads the columns a stream match or a predicate needs, even when the caller does","+// not list them. A column added that way is decoded into the [Record] as well.","+//","+// When the section holds no such column, a metadata or message predicate evaluates against the","+// empty value."," //"," // When SetProjectedColumns is not called, every recognized column is read."," //","@@ -431,17 +432,17 @@ func translateLogsPredicate(p RowPredicate, dsetColumns []dataset.Column, actual"," \t\t\treturn col.Type == ColumnTypeMessage"," \t\t})"," \t\tif messageColumn == nil {","-\t\t\treturn dataset.FalsePredicate{}","+\t\t\t// The section holds no message column, so every row reads as an empty line.","+\t\t\treturn dataset.NewConstPredicate(p.Keep(nil))"," \t\t}"," "," \t\treturn dataset.FuncPredicate{"," \t\t\tColumn: messageColumn,"," \t\t\tKeep: func(_ dataset.Column, value dataset.Value) bool {","-\t\t\t\tif value.Type() == datasetmd.PHYSICAL_TYPE_BINARY {","-\t\t\t\t\t// To handle older dataobjs that still use string type for message column. This can be removed in future.","-\t\t\t\t\treturn p.Keep(value.Binary())","+\t\t\t\t// A nil v