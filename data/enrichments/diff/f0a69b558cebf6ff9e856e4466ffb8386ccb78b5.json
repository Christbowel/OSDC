atchStreams(slices.Values([]int64{2})))","+\t\trequire.NoError(t, reader.SetProjectedColumns([]ColumnType{ColumnTypeStreamID, ColumnTypeMessage}, nil))","+\t\trequire.NoError(t, reader.SetPredicates([]RowPredicate{","+\t\t\tLogMessageFilterRowPredicate{Keep: func(line []byte) bool {","+\t\t\t\tseen = append(seen, string(line))","+\t\t\t\treturn true","+\t\t\t}},","+\t\t}))","+\t\trequire.NoError(t, reader.Open(t.Context()))","+\t\tt.Cleanup(func() { require.NoError(t, reader.Close()) })","+","+\t\trequire.Len(t, readAllRecords(t, reader), 2)","+\t\trequire.ElementsMatch(t, []string{\"line-2\", \"line-3\"}, seen)","+\t})","+","+\tt.Run(\"a message predicate listed first runs on every row, because the reader applies predicates in order\", func(t *testing.T) {","+\t\tvar seen []string","+\t\treader := NewRowReader(section)","+\t\trequire.NoError(t, reader.SetProjectedColumns([]ColumnType{ColumnTypeStreamID, ColumnTypeMessage}, nil))","+\t\trequire.NoError(t, reader.SetPredicates([]RowPredicate{","+\t\t\tLogMessageFilterRowPredicate{Keep: func(line []byte) bool {","+\t\t\t\tseen = append(seen, string(line))","+\t\t\t\treturn true","+\t\t\t}},","+\t\t\tMetadataMatcherRowPredicate{Key: \"env\", Value: \"prod\"},","+\t\t}))","+\t\trequire.NoError(t, reader.Open(t.Context()))","+\t\tt.Cleanup(func() { require.NoError(t, reader.Close()) })","+","+\t\trequire.Len(t, readAllRecords(t, reader), 2)","+\t\trequire.ElementsMatch(t, []string{\"line-1\", \"line-2\", \"line-3\"}, seen)","+\t})","+","+\tt.Run(\"a message predicate that drops every row ends the read with no record\", func(t *testing.T) {","+\t\treader := NewRowReader(section)","+\t\trequire.NoError(t, reader.SetPredicates([]RowPredicate{","+\t\t\tLogMessageFilterRowPredicate{Keep: func([]byte) bool { return false }},","+\t\t}))","+\t\trequire.NoError(t, reader.Open(t.Context()))","+\t\tt.Cleanup(func() { require.NoError(t, reader.Close()) })","+","+\t\trequire.Empty(t, readAllRecords(t, reader))","+\t})","+","+\tt.Run(