h from `--baseline` or configuration\"","+                                ));","+                            };","+                            let result = ty_project::baseline::write(db, baseline_path, result)?;","+                            if !result.diagnostics.is_empty() {","+                                self.write_diagnostics(db, &result.diagnostics, None)?;","+                            }","+","+                            if settings.terminal().output_format.is_human_readable() {","+                                let count = result.count;","+                                writeln!(","+                                    self.printer.stream_for_requested_summary(),","+                                    \"Updated baseline `{baseline_path}` with {count} diagnostic{}.\",","+                                    if count == 1 { \"\" } else { \"s\" }","+                                )?;","+                            }","+                            Ok(result.diagnostics)","+                        }","                     };"," ","                     let exit_status = match result.as_deref() {","@@ -673,6 +709,7 @@ impl MainLoop {"," enum MainLoopMode {","     Check,","     Fix(FixMode),","+    UpdateBaseline,"," }"," "," #[derive(Copy, Clone, Debug)]","@@ -681,6 +718,12 @@ enum FixMode {","     ApplyFixes,"," }"," ","+fn retain_visible_diagnostics(diagnostics: &mut Vec<Diagnostic>) {","+    diagnostics.retain(|diagnostic| {","+        !(diagnostic.severity() == Severity::Hint && diagnostic.id().is_lint())","+    });","+}","+"," fn exit_status_from_diagnostics(","     diagnostics: &[Diagnostic],","     terminal_settings: &TerminalSettings,","@@ -702,7 +745,7 @@ fn exit_status_from_diagnostics(","     }"," ","     match max_severity {","-        Severity::Info => ExitStatus::Success,","+        Severity::Hint | Severity::Info => ExitStatus::Success,","         Severity::Warning => {","             if terminal_settings.error_on_warning {","                 ExitStatus::Failure"],"additions":45,"deletions":2,"truncated":false},{"path":"crates/ty/tests/cli/baseline.rs","lines":["@@ -0,0 +1,549 @@","+use std::fs;","+","+use insta::assert_snapshot;","+use insta_cmd::assert_cmd_snapshot;","+","+use crate::CliTest;","+","+#[test]","+fn update_and_use_configured_baseline() -> anyhow::Result<()> {","+    let case = CliTest::with_files([","+        (","+            \"pyproject.toml\",","+            r\"","+            [tool.ty]","+            baseline = 'baseline.json'","+            \",","+        ),","+        (","+            \"test.py\",","+            r#\"","+            from typing_extensions import reveal_type","+","+            x: int = \"wrong\"","+            reveal_type(x)","+            \"#,","+        ),","+    ])?;","+","+    // `reveal_type` is not a lint, so it remains visible when the assignment error is baselined.","+    assert_cmd_snapshot!(case.command().arg(\"--update-baseline\"), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    info[revealed-type]: Revealed type","+     --> test.py:5:13","+      |","+    5 | reveal_type(x)","+      |             ^ `int`","+","+    Found 1 diagnostic","+    Updated baseline `<temp_dir>/baseline.json` with 1 diagnostic.","+","+    ----- stderr -----","+    \");","+","+    let serialized = fs::read_to_string(case.root().join(\"baseline.json\"))?;","+    assert_snapshot!(serialized, @r#\"","+    {","+      \"version\": 0,","+      \"files\": {","+        \"test.py\": [","+          {","+            \"rule\": \"invalid-assignment\",","+            \"startColumn\": 9,","+            \"endColumn\": 16,","+            \"lineCount\": 1","+          }","+        ]","+      }","+    }","+    \"#);","+","+    assert_cmd_snapshot!(case.command(), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    info[revealed-type]: Revealed type","+     --> test.py:5:13","+      |","+    5 | reveal_type(x)","+      |             ^ `int`","+","+    Found 1 diagnostic","+","+    ----- stderr -----","+    \");","+","+    case.write_file(","+        \"test.py\",","+        r#\"","+        from typing_extensions import reveal_type","+","+        x: int = \"wrong\"","+        y: int = \"new\"","+        reveal_type(x)","+        \"#,","+    )?;","+    assert_cmd_snapshot!(case.command().arg(\"--output-format=concise\"), @r#\"","+    success: false","+    exit_code: 1","+    ----- stdout -----","+    test.py:5:10: error[invalid-assignment] Object of type `Literal[\"new\"]` is not assignable to `int`","+    test.py:6:13: info[revealed-type] Revealed type: `int`","+    Found 2 diagnostics","+","+    ----- stderr -----","+    \"#);","+","+    assert_cmd_snapshot!(case.command().arg(\"--update-baseline\"), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    info[revealed-type]: Revealed type","+     --> test.py:6:13","+      |","+    6 | reveal_type(x)","+      |             ^ `int`","+","+    Found 1 diagnostic","+    Updated baseline `<temp_dir>/baseline.json` with 2 diagnostics.","+","+    ----- stderr -----","+    \");","+    Ok(())","+}","+","+#[test]","+fn matches_duplicate_ranges_in_source_order() -> anyhow::Result<()> {","+    let source = \"\\","+𐐀: int = '''a","+🍎'''","+x: int = 1.5","+\";","+    let case = CliTest::with_file(\"test.py\", source)?;","+","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"baseline.json\", \"--update-baseline\"]), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    Updated baseline `<temp_dir>/baseline.json` with 2 diagnostics.","+","+    ----- stderr -----","+    \");","+    assert_snapshot!(fs::read_to_string(case.root().join(\"baseline.json\"))?, @r#\"","+    {","+      \"version\": 0,","+      \"files\": {","+        \"test.py\": [","+          {","+            \"rule\": \"invalid-assignment\",","+            \"startColumn\": 9,","+            \"endColumn\": 4,","+            \"lineCount\": 2","+          },","+          {","+            \"rule\": \"invalid-assignment\",","+            \"startColumn\": 9,","+            \"endColumn\": 12,","+            \"lineCount\": 1","+          }","+        ]","+      }","+    }","+    \"#);","+","+    // The inserted assignment has the same rule and columns as the final assignment.","+    // The multiline diagnostic between them lets Myers distinguish the two occurrences.","+    case.write_file(\"test.py\", &format!(\"y: int = 0.5\\n{source}\"))?;","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"baseline.json\", \"--output-format=concise\"]), @\"","+    success: false","+    exit_code: 1","+    ----- stdout -----","+    test.py:1:10: error[invalid-assignment] Object of type `float*` is not assignable to `int`","+    Found 1 diagnostic","+","+    ----- stderr -----","+    \");","+    Ok(())","+}","+","+#[test]","+fn update_baseline_is_idempotent() -> anyhow::Result<()> {","+    let case = CliTest::with_file(","+        \"test.py\",","+        r\"","+        x: int = 'wrong'","+        print(missing)","+        \",","+    )?;","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"baseline.json\", \"--update-baseline\", \"--warn\", \"invalid-assignment\"]), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    Updated baseline `<temp_dir>/baseline.json` with 2 diagnostics.","+","+    ----- stderr -----","+    \");","+    let baseline = fs::read_to_string(case.root().join(\"baseline.json\"))?;","+","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"baseline.json\", \"--update-baseline\", \"--warn\", \"unresolved-reference\"]), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    Updated baseline `<temp_dir>/baseline.json` with 2 diagnostics.","+","+    ----- stderr -----","+    \");","+    assert_eq!(","+        fs::read_to_string(case.root().join(\"baseline.json\"))?,","+        baseline","+    );","+    Ok(())","+}","+","+#[test]","+fn ignore_comment_replaces_baseline_entry() -> anyhow::Result<()> {","+    let case = CliTest::with_files([","+        (","+            \"pyproject.toml\",","+            r\"","+            [tool.ty]","+            baseline = 'baseline.json'","+","+            [tool.ty.rules]","+            unused-ignore-comment = 'error'","+            \",","+        ),","+        (","+            \"test.py\",","+            r\"","+            x: int = 'wrong'","+            \",","+        ),","+    ])?;","+","+    assert_cmd_snapshot!(case.command().arg(\"--update-baseline\"), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    Updated baseline `<temp_dir>/baseline.json` with 1 diagnostic.","+","+    ----- stderr -----","+    \");","+","+    case.write_file(","+        \"test.py\",","+        r\"","+        x: int = 'wrong'  # ty: ignore[invalid-assignment]","+        \",","+    )?;","+    assert_cmd_snapshot!(case.command(), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    All checks passed!","+","+    ----- stderr -----","+    \");","+","+    assert_cmd_snapshot!(case.command().arg(\"--update-baseline\"), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    Updated baseline `<temp_dir>/baseline.json` with 0 diagnostics.","+","+    ----- stderr -----","+    \");","+    assert_snapshot!(fs::read_to_string(case.root().join(\"baseline.json\"))?, @r#\"","+    {","+      \"version\": 0,","+      \"files\": {}","+    }","+    \"#);","+    Ok(())","+}","+","+#[test]","+fn cli_baseline_path() -> anyhow::Result<()> {","+    let source_path = r\"nested/a\\b.py\";","+    let case = CliTest::with_file(","+        source_path,","+        r\"","+        x: int = 'wrong'","+        \",","+    )?;","+","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"state/baseline.json\", \"--update-baseline\"]), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    Updated baseline `<temp_dir>/state/baseline.json` with 1 diagnostic.","+","+    ----- stderr -----","+    \");","+    let baseline: serde_json::Value =","+        serde_json::from_slice(&fs::read(case.root().join(\"state/baseline.json\"))?)?;","+    // A backslash separates directories on Windows and is part of the filename on Unix.","+    let expected_path = if cfg!(windows) {","+        \"nested/a/b.py\"","+    } else {","+        source_path","+    };","+    assert_eq!(","+        baseline[\"files\"][expected_path][0][\"rule\"],","+        \"invalid-assignment\"","+    );","+","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"state/baseline.json\"]), @\"","+    success: true","+    exit_code: 0","+    ----- stdout -----","+    All checks passed!","+","+    ----- stderr -----","+    \");","+    Ok(())","+}","+","+#[test]","+fn update_baseline_requires_path() -> anyhow::Result<()> {","+    let case = CliTest::with_file(","+        \"test.py\",","+        r\"","+        x: int = 'wrong'","+        \",","+    )?;","+    assert_cmd_snapshot!(case.command().arg(\"--update-baseline\"), @\"","+    success: false","+    exit_code: 2","+    ----- stdout -----","+","+    ----- stderr -----","+    ty failed","+      Cause: `--update-baseline` requires a baseline path from `--baseline` or configuration","+    \");","+    Ok(())","+}","+","+#[test]","+fn update_baseline_conflicts_with_fix() -> anyhow::Result<()> {","+    let case = CliTest::with_file(","+        \"test.py\",","+        r\"","+        x: int = 'wrong'","+        \",","+    )?;","+    assert_cmd_snapshot!(case.command().args([\"--baseline\", \"baseline.json\", \"--update-baseline\", \"--fix\"]), @\"","+    success: false","+    exit_code: 2","+    ----- stdout -----","+","+    ----- stderr -----","+    error: the argument '--update-baseline' cannot be used with '--fix'","+","+    Usage: ty check --baseline <PATH> --update-baseline [PATH]...","+","+    For more information, try '--help'.","+    \");","+    Ok(())","+}","+","+#