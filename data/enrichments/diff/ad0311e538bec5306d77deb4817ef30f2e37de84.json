of an infinite loop, and the mutant would be wrongly counted as detected.","+     */","+    private static function isTimeoutExpected(MutantProcess $mutantProcess): bool","+    {","+        $timeout = $mutantProcess->getProcess()->getTimeout();","+","+        return $timeout !== null","+            && $mutantProcess->getMutant()->getMutation()->getNominalTestExecutionTime() >= $timeout;","+    }"," }"],"additions":16,"deletions":1,"truncated":false},{"path":"src/Mutation/Mutation.php","lines":["@@ -181,6 +181,14 @@ public function getNominalTestExecutionTime(): float","         return $this->nominalTimeToTest ??= (new TestTotalTimeCalculator($this->tests))->getTotalTestTime();","     }"," ","+    /**","+     * Time needed to run the fastest known test for a mutation","+     */","+    public function getShortestTestExecutionTime(): float","+    {","+        return (new TestTotalTimeCalculator($this->tests))->getShortestTestTime();","+    }","+","     public function getHash(): string","     {","         return $this->hash ??= $this->createHash();"],"additions":8,"deletions":0,"truncated":false},{"path":"src/Process/Runner/MutationTestingRunner.php","lines":["@@ -165,8 +165,8 @@ private function uncoveredByTest(Mutant $mutant): bool"," ","     private function takingTooLong(Mutant $mutant): bool","     {","-        // TODO refactor this comparison into a dedicated comparer to make it possible to swap strategies","-        if ($mutant->getMutation()->getNominalTestExecutionTime() < $this->timeout) {","+        // any test running within the timeout may still kill the mutant, so we skip only when all of them are too slow.","+        if ($mutant->getMutation()->getShortestTestExecutionTime() < $this->timeout) {","             return true;","         }"," "],"additions":2,"deletions":2,"truncated":false},{"path":"src/TestFramework/Tracing/TestTotalTimeCalculator.php","lines":["@@ -38,6 +38,7 @@"," use function array_key_exists;"," use function array_sum;"," use Infection\\AbstractTestFramework\\Coverage\\TestLocation;","+use function min;"," use function strpos;"," use function substr;"," ","@@ -61,6 +62,17 @@ public function getTotalTestTime(): float","         );","     }"," ","+    public function getShortestTestTime(): float","+    {","+        $timings = $this->uniqueTestLocations();","+","+        if ($timings === []) {","+            return 0.0;","+        }","+","+        return (float) min($timings);","+    }","+","     /**","      * Returns unique test cases with timings. Timings are per test suite, not per test, therefore, we have to unique by test suite name.","      *"],"additions":12,"deletions":0,"truncated":false},{"path":"tests/e2e/TimeoutSkippedByFastestTest/README.md","lines":["@@ -0,0 +1,11 @@","+# Timeout skipped by the fastest test","+","+* Related to https://github.com/infection/infection/issues/1965","+","+A mutant is skipped only when even its fastest test (test class) is over the timeout, not when the","+sum of all the tests covering it is:","+","+* `add()` is covered by a fast test and two slow ones adding up over the timeout: the fast test kills the mutant.","+* `isPositive()` has the same coverage, but no test kills the mutant: running all the tests is known to exceed","+  the timeout, so it is reported as skipped, not as timed out.","+* `decrement()` is covered only by tests that are each over the timeout: the mutant is skipped without being run."],"additions":11,"deletions":0,"truncated":false},{"path":"tests/e2e/TimeoutSkippedByFastestTest/composer.json","lines":["@@ -0,0 +1,15 @@","+{","+    \"require-dev\": {","+        \"phpunit/phpunit\": \"^12.5\"","+    },","+    \"autoload\": {","+        \"psr-4\": {","+            \"TimeoutSkippedByFastestTest\\\\\": \"src/\"","+        }","+    },","+    \"autoload-dev\": {","+        \"psr-4\": {","+            \"TimeoutSkippedByFastestTest\\\\Test\\\\\": \"tests/\"","+        }","+    }","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"tests/