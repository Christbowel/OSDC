t` points at, resolved the way an agent","+    // reading the output file would resolve it.","+    function resolveRoot(agentsMdPath) {","+      return path.resolve(path.dirname(agentsMdPath), readIndex(agentsMdPath).root)","+    }","+","+    beforeEach(() => {","+      originalCwd = process.cwd()","+      // Stub the download so the `.next-docs` branch is testable offline.","+      pullDocsSpy = jest","+        .spyOn(agentsMdLib, 'pullDocs')","+        .mockImplementation(async ({ docsDir }) => {","+          const sectionDir = path.join(docsDir, '01-app')","+          fs.mkdirSync(sectionDir, { recursive: true })","+          fs.writeFileSync(path.join(sectionDir, 'downloaded.md'), '# Docs')","+          return { success: true, docsPath: docsDir }","+        })","+    })","+","+    afterEach(() => {","+      process.chdir(originalCwd)","+      pullDocsSpy.mockRestore()","+    })","+","+    it('links bundled docs relative to an output file outside the cwd', async () => {","+      const appDir = path.join(testProjectDir, 'apps', 'web')","+      installNextIsolated(testProjectDir, appDir, '16.4.0')","+      process.chdir(appDir)","+","+      await runAgentsMd({ output: '../../AGENTS.md' })","+","+      const agentsMdPath = path.join(testProjectDir, 'AGENTS.md')","+      expect(readIndex(agentsMdPath).root).toBe(","+        './apps/web/node_modules/next/dist/docs'","+      )","+      expect(","+        fs.existsSync(path.join(resolveRoot(agentsMdPath), '01-app'))","+      ).toBe(true)","+      expect(pullDocsSpy).not.toHaveBeenCalled()","+    })","+","+    it('links downloaded docs relative to an output file outside the cwd', async () => {","+      const appDir = path.join(testProjectDir, 'apps', 'web')","+      fs.mkdirSync(appDir, { recursive: true })","+      process.chdir(appDir)","+","+      await runAgentsMd({ version: '15.0.0', output: '../../AGENTS.md' })","+","+      const agentsMdPath = path.join(testProjectDir, 'AGENTS.md')","+      expect(readIndex(agentsMdPath).root).toBe('./apps/web/.next-docs')","+      expect(fs.realpathSync(resolveRoot(agentsMdPath))).toBe(","+        fs.realpathSync(path.join(appDir, '.next-docs'))","+      )","+    })","+","+    it('keeps the ./ prefix for the .next-docs dot-directory', async () => {","+      process.chdir(testProjectDir)","+","+      await runAgentsMd({ version: '15.0.0', output: 'AGENTS.md' })","+","+      expect(readIndex(path.join(testProjectDir, 'AGENTS.md')).root).toBe(","+        './.next-docs'","+      )","+    })","+","+    it('links the indexed install when the output dir resolves a different next', async () => {","+      // Root has a hoisted next@16.3.0; the app has its own next@16.4.0.","+      writeBundledNextPackage(","+        path.join(testProjectDir, 'node_modules', 'next'),","+        '16.3.0'","+      )","+      const appDir = path.join(testProjectDir, 'apps', 'web')","+      installNextIsolated(testProjectDir, appDir, '16.4.0')","+      process.chdir(appDir)","+","+      await runAgentsMd({ output: '../../AGENTS.md' })","+","+      const agentsMdPath = path.join(testProjectDir, 'AGENTS.md')","+      const linkedPkg = JSON.parse(","+        fs.readFileSync(","+          path.join(resolveRoot(agentsMdPath), '..', '..', 'package.json'),","+          'utf-8'","+        )","+      )","+      expect(linkedPkg.version).toBe('16.4.0')","+      expect(readIndex(agentsMdPath).content).toContain('docs-16.4.0.md')","+    })","+","+    it('writes a regeneration hint that is relative to the output file', async () => {","+      const appDir = path.join(testProjectDir, 'apps', 'web')","+      installNextIsolated(testProjectDir, appDir, '16.4.0')","+      process.chdir(appDir)","+","+      await runAgentsMd({ output: '../../AGENTS.md' })","+","+      const { content } = readIndex(path.join(testProjectDir, 'AGENTS.md'))","+      expect(content).toContain(","+        \"If docs missing, run this command from this file's directory: npx @next/codemod agents-md --output AGENTS.md|\"","+      )","+      expect(content).not.toContain('--output ../../AGENTS.md')","+    })","+","+    it('supports an absolute --output path', async () => {","+      const appDir = path.join(testProjectDir, 'apps', 'web')","+      installNextIsolated(testProjectDir, appDir, '16.4.0')","+      const outputDir = path.join(testProjectDir, 'docs-out')","+      fs.mkdirSync(outputDir)","+      const agentsMdPath = path.join(outputDir, 'CLAUDE.md')","+      process.chdir(appDir)","+","+      await runAgentsMd({ output: agentsMdPath })","+","+      expect(fs.existsSync(agentsMdPath)).toBe(true)","+      const { root, content } = readIndex(agentsMdPath)","+      expect(root).toBe('../apps/web/node_modules/next/dist/docs')","+      expect(","+        fs.existsSync(path.join(resolveRoot(agentsMdPath), '01-app'))","+      ).toBe(true)","+      expect(content).toContain('--output CLAUDE.md|')","+    })","+","+    // The cwd/output path and the path `next` resolves to can be spelled","+    // differently for the same directory: a symlinked alias, or an 8.3 short","+    // name like `C:\\Users\\RUNNER~1\\...` on Windows, where `process.cwd()`","+    // keeps the short name while module resolution returns the long one.","+    // Links must still be computed between consistent spellings.","+    describe('when the cwd is spelled differently than the realpath', () => {","+      let aliasBase","+      let aliasDir","+      let cwdSpy","+","+      // Run from `dir` (inside the real project) while `process.cwd()`","+      // reports it through the alias, like a non-canonical cwd on Windows.","+      function chdirViaAlias(dir) {","+        process.chdir(dir)","+        const aliased = path.join(","+          aliasDir,","+          path.relative(fs.realpathSync(testProjectDir), fs.realpathSync(dir))","+        )","+        cwdSpy = jest.spyOn(process, 'cwd').mockReturnValue(aliased)","+      }","+","+      beforeEach(() => {","+        aliasBase = fs.mkdtempSync(path.join(os.tmpdir(), 'agents-md-alias-'))","+        aliasDir = path.join(aliasBase, 'project')","+        fs.symlinkSync(testProjectDir, aliasDir, 'junction')","+      })","+","+      afterEach(() => {","+        cwdSpy?.mockRestore()","+        cwdSpy = undefined","+        fs.rmSync(aliasBase, { recursive: true, force: true })","+      })","+","+      it('links the conventional path through a symlinked cwd', async () => {","+        writeBundledNextPackage(","+          path.join(testProjectDir, 'node_modules', 'next'),","+          '16.4.0'","+        )","+        chdirViaAlias(testProjectDir)","+","+        await runAgentsMd({ output: 'AGENTS.md' })","+","+        const agentsMdPath = path.join(testProjectDir, 'AGENTS.md')","+        expect(readIndex(agentsMdPath).root).toBe(","+          './node_modules/next/dist/docs'","+        )","+      })","+","+      it('links a hoisted install canonically through a symlinked cwd', async () => {","+        writeBundledNextPackage(","+          path.join(testProjectDir, 'node_modules', 'next'),","+          '16.4.0'","+        )","+        const appDir = path.join(testProjectDir, 'apps', 'web')","+        fs.mkdirSync(appDir, { recursive: true })","+        chdirViaAlias(appDir)","+","+        await runAgentsMd({ output: 'AGENTS.md' })","+","+        const agentsMdPath = path.join(testProjectDir, 'apps', 'web', 'AGENTS.md')","+        expect(readIndex(agentsMdPath).root).toBe(","+          '../../node_modules/next/dist/docs'","+        )","+        expect(","+          fs.existsSync(path.join(resolveRoot(agentsMdPath), '01-app'))","+        ).toBe(true)","+      })","+","+      it('detects the same install when only the native realpath canonicalizes', async () => {","+        // Simulate Windows 8.3 short names: the JS `fs.realpathSync` leaves","+        // the alias spelling as-is, while `fs.realpathSync.native` expands it.","+        writeBundledNextPackage(","+          path.join(testProjectDir, 'node_modules', 'next'),","+          '16.4.0'","+        )","+        chdirViaAlias(testProjectDir)","+        const nativeRealpath = fs.realpathSync.native","+        const realpathSpy = jest","+          .spyOn(fs, 'realpathSync')","+          .mockImplementation((p) => path.resolve(String(p)))","+        fs.realpathSync.native = nativeRealpath","+","+        try {","+          await runAgentsMd({ output: 'AGENTS.md' })","+        } finally {","+          realpathSpy.mockRestore()","+        }","+","+        expect(readIndex(path.join(testProjectDir, 'AGENTS.md')).root).toBe(","+          './node_modules/next/dist/docs'","+        )","+      })","+    })","+","+    it('always prefixes relative links with ./ or ../', () => {","+      const { getRelativeLinkPath } = agentsMdLib","+      const base = path.join(testProjectDir, 'a', 'b')","+","+      expect(getRelativeLinkPath(base, base)).toBe('./')","+      expect(getRelativeLinkPath(base, path.join(testProjectDir, 'a'))).toBe(","+        '../'","+      )","+      expect(getRelativeLinkPath(base, path.join(base, '.next-docs'))).toBe(","+        './.next-docs'","+      )","+      expect(","+        getRelativeLinkPath(base, path.join(testProjectDir, 'a', 'docs'))","+      ).toBe('../docs')","+      expect(getRelativeLinkPath(base, path.join(base, '..docs'))).toBe(","+        './..docs'","+      )","+    })","+  })","+","   describe('getNextjsVersion', () => {","     const fixturesDir = path.join(__dirname, 'fixtures/agents-md')"," "],"additions":278,"deletions":0,"truncated":false},{"path":"packages/next-codemod/lib/agents-md.ts","lines":["@@ -88,6 +88,8 @@ export function getNextjsVersion(cwd: string): NextjsVersionResult {"," interface BundledDocsInfo {","   docsPath: string","   version: string","+  /** Directory `next` was resolved from. */","+  resolvedFrom: string"," }"," "," /**","@@ -104,21 +106,74 @@ export function getBundledDocsInfo(cwd: string): BundledDocsInfo | null {","     if (!pkg.version || collectDocFiles(docsPath).length === 0) {","       