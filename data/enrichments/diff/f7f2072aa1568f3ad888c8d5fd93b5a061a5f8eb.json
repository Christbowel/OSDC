at executor, with as many threads, so that such","+/// queries do not spawn and join pruning threads of their own.","+#[derive(Clone)]","+pub struct GlobalPruningRuntime(Arc<Runtime>);","+","+impl GlobalPruningRuntime {","+    pub fn init(threads: usize) -> Result<()> {","+        let rt = Runtime::with_worker_threads(threads, Some(\"pruning-worker\".to_owned()))?;","+        GlobalInstance::set(GlobalPruningRuntime(Arc::new(rt)));","+        Ok(())","+    }","+","+    /// The runtime, `None` where the global queries executor is not enabled.","+    pub fn try_instance() -> Option<Arc<Runtime>> {","+        GlobalInstance::try_get::<GlobalPruningRuntime>().map(|runtime| runtime.0)","+    }","+}","+"," impl GlobalQueryRuntime {","     #[inline(always)]","     pub fn runtime(self: &Arc<Self>) -> &Runtime {"],"additions":19,"deletions":0,"truncated":false},{"path":"src/common/base/src/runtime/mod.rs","lines":["@@ -42,6 +42,7 @@ pub use executor_stats::ExecutorStatsSlot;"," pub use executor_stats::ExecutorStatsSnapshot;"," pub use global_runtime::GlobalControlRuntime;"," pub use global_runtime::GlobalIORuntime;","+pub use global_runtime::GlobalPruningRuntime;"," pub use global_runtime::GlobalQueryRuntime;"," pub use memory::GLOBAL_MEM_STAT;"," pub use memory::GLOBAL_QUERIES_MANAGER;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/base/src/runtime/runtime.rs","lines":["@@ -28,6 +28,7 @@ use tokio::runtime::Handle;"," use tokio::runtime::Id;"," use tokio::sync::OwnedSemaphorePermit;"," use tokio::sync::Semaphore;","+use tokio::task::JoinError;"," use tokio::task::JoinHandle;"," "," use super::watchdog::WatchdogEvent;","@@ -220,7 +221,8 @@ impl Runtime {","     {","         let iter = futures.into_iter();","         let (lower, upper) = iter.size_hint();","-        let mut handlers = Vec::with_capacity(upper.unwrap_or(lower));","+        // Waiting for a permit, the caller may go away with tasks spawned.","+        let mut handlers = AbortOnDrop(Vec::with_capacity(upper.unwrap_or(lower)));","         for fut in iter {","             let semaphore = semaphore.clone();","             // Although async task is rather lightweight, it do consumes resources,","@@ -239,10 +241,23 @@ impl Runtime {","                     fut(permit).await","                 }),","             ));","-            handlers.push(handler)","+            handlers.0.push(handler)","         }"," ","-        Ok(handlers)","+        Ok(std::mem::take(&mut handlers.0))","+    }","+","+    /// Waits for all the tasks of `handles`, like `futures::future::try_join_all`,","+    /// and aborts the ones that are not finished when it is dropped.","+    ///","+    /// A dropped `JoinHandle` detaches its task. On a runtime that outlives the","+    /// caller, such as a global one, the tasks of a caller that went away would","+    /// run to their end, e.g. reading from storage for a query that is gone.","+    pub async fn try_join_all<T>(","+        handles: impl IntoIterator<Item = JoinHandle<T>>,","+    ) -> std::result::Result<Vec<T>, JoinError> {","+        let mut handles = AbortOnDrop(handles.into_iter().collect());","+        future::try_join_all(handles.0.iter_mut()).await","     }"," ","     // TODO(Winter): remove","@@ -302,6 +317,18 @@ impl Runtime {","     }"," }"," ","+/// The handles of a batch of tasks, which are aborted when it is dropped.","+/// Aborting a finished task does nothing.","+struct AbortOnDrop<T>(Vec<JoinHandle<T>>);","+","+impl<T> Drop for AbortOnDrop<T> {","+    fn drop(&mut self) {","+        for handle in &self.0 {","+            handle.abort();","+        }","+    }","+}","+"," /// Dropping the dropper will cause runtime to shutdown."," pub struct Dropper {","     name: Option<String>,"],"additions":30,"deletions":3,"truncated":false},{"path":"src/common/base/tests/it/main.rs","lines":["@@ -21,6 +21,7 @@ mod metrics;"," mod progress;"," mod range_merger;"," mod runtime;","+mod singleton_instance;"," mod string;"," mod time_series;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/base/tests/it/runtime.rs","lines":["@@ -229,3 +229,57 @@ async fn test_runtime_try_spawn_batch() -> anyhow::Result<()> {","     assert_eq!(result.len(), 20);","     Ok(())"," }","+","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+async fn test_runtime_try_join_all_aborts_on_drop() -> anyhow::Result<()> {","+    let runtime = Runtime::with_worker_threads(2, Some(\"runtime-join-test\".to_string()))?;","+","+    // It joins the tasks, in their order.","+    let handles = (0..4).map(|i| runtime.spawn(async move { i }));","+    assert_eq!(Runtime::try_join_all(handles).await?, vec![0, 1, 2, 3]);","+","+    // The caller goes away while its tasks run: they are aborted, not left to","+    // run to their end on a runtime that outlives the caller.","+    let finished = Arc::new(Mutex::new(0));","+    let (started_tx, started_rx) = mpsc::channel();","+    let handles = (0..4)","+        .map(|_| {","+            let finished = finished.clone();","+            let started_tx = started_tx.clone();","+            runtime.spawn(async move {","+                let _ = started_tx.send(());","+                sleep(Duration::from_millis(500)).await;","+                *finished.lock().unwrap() += 1;","+            })","+        })","+        .collect::<Vec<_>>();","+    let join = Runtime::try_join_all(handles);","+    for _ in 0..4 {","+        started_rx.recv_timeout(Duration::from_secs(10))?;","+    }","+    let joined = tokio::time::timeout(Duration::from_millis(10), join).await;","+    assert!(joined.is_err(), \"the tasks sleep longer than the timeout\");","+    sleep(Duration::from_secs(1)).await;","+    assert_eq!(*finished.lock().unwrap(), 0);","+","+    // The same while the batch is spawned: with one permit, the caller goes","+    // away waiting for the permit of the second task, the first one running.","+    let (started_tx, started_rx) = mpsc::channel();","+    let tasks = (0..4).map(|_| {","+        let finished = finished.clone();","+        let started_tx = started_tx.clone();","+        move |permit| async move {","+            let _permit = permit;","+            let _ = started_tx.send(());","+            sleep(Duration::from_millis(500)).await;","+            *finished.lock().unwrap() += 1;","+        }","+    });","+    let spawn = runtime.try_spawn_batch_with_owned_semaphore(Arc::new(Semaphore::new(1)), tasks);","+    let spawned = tokio::time::timeout(Duration::from_millis(100), spawn).await;","+    assert!(spawned.is_err(), \"the first task holds the permit longer\");","+    started_rx.recv_timeout(Duration::from_secs(10))?;","+    sleep(Duration::from_secs(1)).await;","+    assert_eq!(*finished.lock().unwrap(), 0);","+    Ok(())","+}"],"additions":54,"deletions":0,"truncated":false},{"path":"src/common/base/tests/it/singleton_instance.rs","lines":["@@ -0,0 +1,35 @@","+// Copyright 2022 Datafuse Labs.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+#![cfg(debug_assertions)]","+","+use databend_common_base::base::GlobalInstance;","+","+#[test]","+fn test_try_get_unset_type() {","+    #[derive(Clone)]","+    struct Unset;","+","+    // A type that was never set is absent, whether or not the registry is","+    // initiated: `try_get` must not panic like `get` does.","+    assert!(GlobalInstance::try_get::<Unset>().is_none());","+","+    let thread_name = std::thread::current().