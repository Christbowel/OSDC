le and buffer has the advertised capacity.","+        let len = unsafe {","+            GetFinalPathNameByHandleW(","+                file.as_raw_handle(),","+                buffer.as_mut_ptr(),","+                buffer.len() as u32,","+                FILE_NAME_NORMALIZED | VOLUME_NAME_DOS,","+            )","+        };","+        if len == 0 {","+            return Err(io::Error::last_os_error());","+        }","+        let len = len as usize;","+        if len < buffer.len() {","+            let path = String::from_utf16(&buffer[..len])","+                .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;","+            return Ok(dunce::simplified(std::path::Path::new(&path)).to_owned());","+        }","+        buffer.resize(len + 1, 0);","+    }","+}","+","+#[cfg(all(test, any(target_os = \"linux\", target_os = \"macos\", windows)))]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn resolves_the_opened_file_after_path_replacement() {","+        let tmp = tempfile::tempdir().unwrap();","+        let root = dunce::canonicalize(tmp.path()).unwrap();","+        let original = root.join(\"original\");","+        let moved = root.join(\"moved\");","+        std::fs::write(&original, \"opened\").unwrap();","+        let file = File::open(&original).unwrap();","+        std::fs::rename(&original, &moved).unwrap();","+        std::fs::write(&original, \"replacement\").unwrap();","+        assert_eq!(file_realpath(&file).unwrap(), moved);","+        assert_ne!(file_realpath(&file).unwrap(), original);","+    }","+}","+","+#[cfg(not(any(target_os = \"linux\", target_os = \"macos\", windows)))]","+pub fn file_realpath(_: &File) -> io::Result<PathBuf> {","+    Err(io::Error::new(","+        io::ErrorKind::Unsupported,","+        \"opened-file paths are unavailable\",","+    ))","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"crates/turborepo-paths/src/lib.rs","lines":["@@ -41,6 +41,8 @@ mod absolute_system_path;"," mod ab