adedExecutableOp used to contain the","+// mesh name the IFRT atom program will execute on. The mesh name is used as a","+// key into a mapping of optional compile options provided by users per mesh.","+// If no compile options are provided for a mesh, then the default compile","+// options are used.","+inline constexpr llvm::StringLiteral kIfrtMeshNameAttrName = \"ifrt.mesh_name\";","+"," // String value used as a default value for an optional `mlir::StringAttr` when"," // converting to and from VIFRT."," inline constexpr llvm::StringLiteral kVifrtDefaultString = \"vifrt.default\";"],"additions":7,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/python/ifrt/ir/conversions/mpmd/lower_to_ifrt.cc","lines":["@@ -30,6 +30,7 @@ limitations under the License."," #include \"llvm/ADT/STLFunctionalExtras.h\""," #include \"llvm/ADT/StringMap.h\""," #include \"llvm/Support/LogicalResult.h\"","+#include \"mlir/Dialect/Func/IR/FuncDialect.h\""," #include \"mlir/Dialect/Func/IR/FuncOps.h\""," #include \"mlir/IR/Builders.h\""," #include \"mlir/IR/BuiltinAttributes.h\"","@@ -182,7 +183,7 @@ class FragmentCallOpPattern final","         rewriter.getDenseI32ArrayAttr(donated_input_indices));","     // Set the mesh name in an attribute. The mesh name is used to get optional","     // per-mesh compile options users might have provided.","-    ifrt_call_op->setAttr(kIfrtMeshNameAttrName,","+    ifrt_call_op->setAttr(xla::ifrt::kIfrtMeshNameAttrName,","                           rewriter.getStringAttr(mesh_name));","     rewriter.replaceOp(op, ifrt_call_op.getOutputs());","     return mlir::success();","@@ -407,11 +408,12 @@ class BuildCompileOptionsPass","                             reserved_hbm_bytes.getInt());","       };"," ","-      auto mesh_name_attr =","-          call_op->getAttrOfType<mlir::StringAttr>(kIfrtMeshNameAttrName);","+      auto mesh_name_attr = call_op->getAttrOfType<mlir::StringAttr>(","+          xla::ifrt::kIfrtMeshNameAttrName);","       if (mesh_name_attr == nullptr) {","         call_op.emitError()","-            << \" is missing \" << kIfrtMeshNameAttrName.str() << \" attribute\";","+            << \" is missing \" << xla::ifrt::kIfrtMeshNameAttrName.str()","+            << \" attribute\";","         return mlir::WalkResult::interrupt();","       }","       // While the users provide per-mesh compilation options, we need to"],"additions":6,"deletions":4,"truncated":false},{"path":"third_party/xla/xla/python/ifrt/ir/conversions/mpmd/lower_to_ifrt.h","lines":["@@ -43,12 +43,6 @@ using EnvOptionsOverride ="," // options."," using CompileOptionsMap = absl::flat_hash_map<std::string, xla::CompileOptions>;"," ","-// Name of StringAttr on ifrt.CallOp used to contain the mesh name the IFRT","-// atom program will execute on. The mesh name is used as a key into a mapping","-// of optional compile options provided by users per mesh. If no compile options","-// are provided for a mesh, then the default compile options are used.","-inline constexpr llvm::StringLiteral kIfrtMeshNameAttrName = \"ifrt.mesh_name\";","-"," std::unique_ptr<mlir::Pass> CreateLowerToIfrtPass();"," "," // Registers -mpmd-lower-to-ifrt and -ifrt-mpmd-lower-to-ifrt-pipeline."],"additions":0,"deletions":6,"truncated":false},{"path":"third_party/xla/xla/python/ifrt/ir/ifrt_dialect.cc","lines":["@@ -27,19 +27,24 @@ limitations under the License."," #include \"llvm/ADT/STLExtras.h\""," #include \"llvm/ADT/STLFunctionalExtras.h\""," #include \"llvm/ADT/SmallVector.h\"","+#include \"llvm/ADT/StringRef.h\""," #include \"llvm/ADT/TypeSwitch.h\"  // IWYU pragma: keep"," #include \"llvm/Support/Casting.h\""," #include \"llvm/Support/raw_ostream.h\""," #include \"mlir/Dialect/Func/IR/FuncOps.h\""," #include \"mlir/IR/Attributes.h\"","+#include \"mlir/IR/Block.h\""," #include \"mlir/IR/Builders.h\""," #include \"mlir/IR/BuiltinAttributes.h\""," #include \"mlir/IR/BuiltinDialect.h\"","+#include \"mlir/IR/BuiltinOps.h\""," #include \"mlir/IR/BuiltinTypes.h\""," #include \"mlir/IR/Diagnostics.h\""," #include \"mlir/IR/Dialect.h\""," #include \"mlir/IR/DialectImplementation.h\""," #include \"mlir/IR/OpImplementation.h\"","+#include \"mlir/IR/Operation.h\"","+#include \"mlir/IR/Types.h\""," #include \"mlir/Support/DebugStringHelper.h\""," #include \"mlir/Support/LLVM.h\""," #include \"mlir/Support/LogicalResult.h\"","@@ -104,18 +109,231 @@ IfrtAsmDialectInterface::AliasResult IfrtAsmDialectInterface::getAlias(","   return AliasResult::NoAlias;"," }"," ","+namespace {","+","+enum class RegionAttrKind { kArg, kResult };","+","+// Verifies the common invariants shared by `ifrt.function` and","+// `ifrt.reshard_function` attributes and returns the `func::FuncOp` on success.","+mlir::FailureOr<mlir::func::FuncOp> VerifyIfrtFunctionCommon(","+    mlir::Operation* op, mlir::NamedAttribute attr) {","+  mlir::func::FuncOp func_op = llvm::dyn_cast<mlir::func::FuncOp>(op);","+  if (func_op == nullptr) {","+    return op->emitOpError() << \"has `\" << attr.getName().getValue()","+                             << \"` attr but is not a function\";","+  }","+  if (!mlir::isa<mlir::UnitAttr>(attr.getValue())) {","+    return op->emitOpError() << \"has `\" << attr.getName().getValue()","+                             << \"` attr that is not a UnitAttr\";","+  }","+  if (op->hasAttr(kIfrtFunctionAttrName) &&","+      op->hasAttr(kIfrtReshardFunctionAttrName)) {","+    return op->emitOpError()","+           << \"cannot have both `\" << kIfrtFunctionAttrName << \"` and `\"","+           << kIfrtReshardFunctionAttrName << \"` attrs\";","+  }","+  if (!llvm::isa_and_nonnull<mlir::ModuleOp>(op->getParentOp())) {","+    return op->emitOpError()","+           << \"with `\" << attr.getName().getValue()","+           << \"` attr must be nested directly in a `builtin.module` op\";","+  }","+  if (op->getNumRegions() != 1 || !func_op.getBody().hasOneBlock()) {","+    return op->emitOpError() << \"with `\" << attr.getName().getValue()","+                             << \"` attr must have a single-block body\";","+  }","+  mlir::TypeAttr func_type_attr = func_op.getFunctionTypeAttr();","+  if (func_type_attr == nullptr || func_type_attr.getValue() == nullptr ||","+      !mlir::isa<mlir::FunctionType>(func_type_attr.getValue())) {","+    return op->emitOpError() << \"with `\" << attr.getName().getValue()","+                             << \"` attr must have a valid `FunctionType`\";","+  }","+  mlir::Block& block = func_op.getBody().front();","+  if (block.empty() || !llvm::isa<mlir::func::ReturnOp>(block.back())) {","+    return op->emitOpError() << \"with `\" << attr.getName().getValue()","+                             << \"` attr must end with `func.return`\";","+  }","+  return func_op;","+}","+","+// Verifies an `ifrt.function` operation attribute on `op`.","+mlir::LogicalResult VerifyIfrtFunctionAttr(mlir::Operation* op,","+                                           mlir::NamedAttribute attr) {","+  mlir::FailureOr<mlir::func::FuncOp> func_op =","+      VerifyIfrtFunctionCommon(op, attr);","+  if (mlir::failed(func_op)) {","+    return mlir::failure();","+  }","+  mlir::FunctionType func_type = func_op->getFunctionType();","+  for (mlir::Type input_type : func_type.getInputs()) {","+    if (!llvm::isa<IfrtArrayType, IfrtControlType>(input_type)) {","+      return func_op->emitOpError()","+             << \"with `\" << kIfrtFunctionAttrName","+             << \"` attr must have only `!ifrt.array` or `!ifrt.control` \"","+                \"argument types, got \"","+             << input_type;","+    }","+  }","+  for (mlir::Type result_type : func_type.getResults()) {","+    if (!llvm::isa<IfrtArrayType, IfrtControlType>(result_type)) {","+      return func_op->emitOpError()","+             << \"with `\" << kIfrtFunctionAttrName","+             << \"` attr must have only `!ifrt.array` or `!ifrt.control` \"","+                \"result types, got \"","+             << result_type;","+    }","+  }","+  return mlir::success();","+}","+","+// Verifies an `ifrt.reshard_function` operation attribute on `op`.","+mlir::LogicalResult VerifyIfrtReshardFunctionAttr(mlir::Operation* op,","+                                                  mlir::NamedAttribute attr) {","+  mlir::FailureOr<mlir::func::FuncOp> func_op =","+      VerifyIfrtFunctionCommon(op, attr);","+  if (mlir::failed(func_op)) {","+    return mlir::failure();","+  }","+  mlir::FunctionType func_type = func_op->getFunctionType();","+  for (mlir::Type input_type : func_type.getInputs()) {","+    if (!llvm::isa<IfrtArrayType>(input_type)) {","+      return func_op->emitOpError()","+             << \"with `\" << kIfrtReshardFunctionAttrName","+             << \"` attr must have only `!ifrt.array` argument types, got \"","+             << input_type;","+    }","+  }","+  for (mlir::Type result_type : func_type.getResults()) {","+    if (!llvm::isa<IfrtArrayType>(result_type)) {","+      return func_op->emitOpError()","+             << \"with `\" << kIfrtReshardFunctionAttrName","+             << \"` attr must have only `!ifrt.array` result types, got \"","+             << result_type;","+    }","+  }","+  for (mlir::Operation& body_op : func_op->getBody().front()) {","+    if (!llvm::isa<ReshardOp, CopyArraysOp, RemapArraysOp, BitcastArraysOp,","+                   AssembleOp, DisassembleOp, mlir::func::ReturnOp>(&body_op)) {","+      return func_op->emitOpError()","+             << \"with `\" << kIfrtReshardFunctionAttrName","+             << \"` attr may only contain resharding ops and `func.return`, \"","+                \"got `\"","+             << body_op.getName() << \"`\";","+    }","+  }","+  return mlir::success();","+}","+","+// Verifies that `attr` holds a non-empty `mlir::StringAttr`.","+mlir::LogicalResult VerifyNonEmptyStringAttr(mlir::Operation* op,","+                                             mlir::NamedAttribute attr) {","+  mlir::StringAttr str_attr = llvm::dyn_cast<mlir::StringAttr>(attr.getValue());","+ 