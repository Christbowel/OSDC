atement> ClientContext::PrepareInternal(ClientContextLock &lock,","                                                              unique_ptr<SQLStatement> statement) {","+\tif (is_connected) {","+\t\t// the connected database runs the statement as written, at each execution","+\t\tif (!statement->named_param_map.empty()) {","+\t\t\tthrow InvalidInputException(CONNECTED_PARAMETERS_ERROR);","+\t\t}","+\t\tif (statement->type != StatementType::DISCONNECT_STATEMENT) {","+\t\t\t// it runs on the connected database only, also when parsed before CONNECT","+\t\t\tauto passthrough = make_uniq<PassthroughStatement>();","+\t\t\tpassthrough->query = std::move(statement->query);","+\t\t\tpassthrough->stmt_location = statement->stmt_location;","+\t\t\tstatement = std::move(passthrough);","+\t\t}","+\t\treturn make_uniq<PreparedStatement>(shared_from_this(), std::move(statement));","+\t}"," \t// Only a pragma or a multi-statement can expand, and only one that does not expand into exactly one statement"," \t// keeps the statement as written, to expand it again at each execution"," \tunique_ptr<SQLStatement> written_statement;","@@ -735,16 +752,15 @@ unique_ptr<QueryResult> ClientContext::SubmitStatement(ClientContextLock &lock,","                                                        Retention retention) {"," \t// CONNECT chokepoint: when connected, non-control SQL is rewritten in place and falls through to"," \t// the normal pipeline. No recursion — the rewrite goes through SubmitStatementInternal, not back here.","+\tbool outside_local_transaction = false;"," \tif (is_connected) {"," \t\tif (!IsConnectControlStatement(statement->type)) {"," \t\t\t// Parameterized prepared statements would need parameter substitution we don't do in v0 — reject."," \t\t\t// No-param prepared statements have a fully-resolved `query` already, route them.","-\t\t\tif (HasBoundParameterValues(*statement)) {","-\t\t\t\treturn ErrorResult<QueryResult>(","-\t\t\t\t    ErrorData(InvalidInputException(\"Parameterized prepared statements cannot be executed while \"","-\t\t\t\t                                    \"CONNECT-ed; DISCONNECT first, or run the SQL as a fresh \"","-\t\t\t\t                                    \"statement to route through the CONNECT binding\")),","-\t\t\t\t    statement->query);","+\t\t\tif (HasBoundParameterValues(*statement) ||","+\t\t\t    (parameters.statement_args && !parameters.statement_args->empty())) {","+\t\t\t\treturn ErrorResult<QueryResult>(ErrorData(InvalidInputException(CONNECTED_PARAMETERS_ERROR)),","+\t\t\t\t                                statement->query);"," \t\t\t}"," \t\t\tauto live = TryGetConnectedCatalog();"," \t\t\tif (!live) {","@@ -757,11 +773,20 @@ unique_ptr<QueryResult> ClientContext::SubmitStatement(ClientContextLock &lock,"," \t\t\t}"," \t\t\t// Dispatch via the catalog — Supports(CONNECT) was validated at CONNECT time, so RemoteExecute"," \t\t\t// is contracted to be implemented. Wrap the returned TableRef into a SelectStatement.","-\t\t\tauto remote_ref = live->GetCatalog().RemoteExecute(*this, statement->query);","+\t\t\tunique_ptr<TableRef> remote_ref;","+\t\t\ttry {","+\t\t\t\tremote_ref = live->GetCatalog().RemoteExecute(*this, statement->query);","+\t\t\t} catch (std::exception &ex) {","+\t\t\t\tAttachedDatabase::InvokeCloseIfLastReference(live, *this);","+\t\t\t\treturn ErrorResult<QueryResult>(ErrorData(ex), statement->query);","+\t\t\t}"," \t\t\tauto rewritten = WrapAsSelect(std::move(remote_ref));"," \t\t\t// the rewrite is invisible to the user - keep reporting the SQL they issued"," \t\t\trewritten->query = std::move(statement->query);"," \t\t\tstatement = std::move(rewritten);","+\t\t\t// it shares the transaction the local one holds on the connected database, if there is one","+\t\t\toutside_local_transaction =","+\t\t\t    !transaction.HasActiveTransaction() || !MetaTransaction::Get(*this).TryGetTransaction(*live);"," \t\t\tAttachedDatabase::InvokeCloseIfLastReference(live, *this);"," \t\t\t// statement is now SELECT * FROM <remote-ref>; fall through."," \t\t}","@@ -806,6 +831,7 @@ unique_ptr<QueryResult> ClientContext::SubmitStatement(ClientContextLock &lock,"," \t\t}"," \t\treturn ErrorResult<QueryResult>(std::move(error), query);"," \t}","+\tactive_query->outside_local_transaction = outside_local_transaction;"," "," \tunique_ptr<QueryResult> handle;"," \tunique_ptr<QueryResult> result;"],"additions":37,"deletions":11,"truncated":false},{"path":"src/main/client_context_execution.cpp","lines":["@@ -98,6 +98,7 @@ ErrorData ClientContext::EndQueryInternal(ClientContextLock &lock, bool success,"," \t}"," \tactive_query->progress_bar.reset();"," \tD_ASSERT(active_query.get());","+\tinvalidate_transaction = invalidate_transaction && !active_query->outside_local_transaction;"," \tactive_query.reset();"," \tquery_deadline.SetInvalid();"," \tquery_progress.Initialize();"],"additions":1,"deletions":0,"truncated":false},{"path":"src/main/prepared_statement.cpp","lines":["@@ -13,12 +13,12 @@ PreparedStatement::PreparedStatement(const shared_ptr<ClientContext> &context_p,"," }"," "," PreparedStatement::PreparedStatement(const shared_ptr<ClientContext> &context_p, unique_ptr<SQLStatement> statement)","-    : context(context_p), query(statement->query), success(true), expanding_statement(std::move(statement)) {","+    : context(context_p), query(statement->query), success(true), written_statement(std::move(statement)) {"," \tD_ASSERT(!context.expired());"," \t// The placeholder the planner reports for a result known only at execution. The properties describe nothing"," \tinfo.names = {Identifier(\"unknown\")};"," \tinfo.types = {LogicalTypeId::UNKNOWN};","-\tinfo.statement_type = expanding_statement->type;","+\tinfo.statement_type = written_statement->type;"," \tinfo.properties.always_require_rebind = true;"," }"," ","@@ -26,7 +26,7 @@ PreparedStatement::PreparedStatement(ErrorData error) : success(false), error(st"," }"," "," PreparedStatement::~PreparedStatement() {","-\tif (expanding_statement) {","+\tif (written_statement) {"," \t\t// nothing was prepared in the client context"," \t\treturn;"," \t}","@@ -109,16 +109,16 @@ case_insensitive_map_t<LogicalType> PreparedStatement::GetExpectedParameterTypes"," }"," "," bool PreparedStatement::MetadataAvailable() const {","-\treturn !expanding_statement && info.properties.bound_all_parameters;","+\treturn !written_statement && info.properties.bound_all_parameters;"," }"," "," unique_ptr<SQLStatement> PreparedStatement::CreateStatement(identifier_map_t<BoundParameterData> &named_values,","                                                             QueryParameters &parameters) const {","-\tif (expanding_statement) {","+\tif (written_statement) {"," \t\tif (!named_values.empty()) {"," \t\t\tparameters.statement_args = named_values;"," \t\t}","-\t\treturn expanding_statement->Copy();","+\t\treturn written_statement->Copy();"," \t}"," \tauto execute = make_uniq<ExecuteStatement>();"," \texecute->name = Identifier(name);"],"additions":6,"deletions":6,"truncated":false},{"path":"src/planner/binder/statement/bind_connect.cpp","lines":["@@ -50,6 +50,8 @@ BoundStatement Binder::Bind(DisconnectStatement &stmt) {"," "," \tauto &properties = GetStatementProperties();"," \tproperties.return_type = StatementReturnType::NOTHING;","+\t// DISCONNECT returns to LOCAL also in an aborted transaction, so that it can be rolled back","+\tproperties.requires_valid_transaction = false;"," \treturn result;"," }"," "],"additions":2,"deletions":0,"truncated":false},{"path":"test/api/CMakeLists.txt","lines":["@@ -16,6 +16,7 @@ set(TEST_API_OBJECTS","     test_scalar_function_decimal_return.cpp","     test_aggregate_state_bind_data.cpp","     test_config.cpp","+    test_connect_prepare.cpp","     test_os_util.cpp","     test_compression_select.cpp","     test_connection_secrets.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"test/api/test_api.cpp","lines":["@@ -528,6 +528,31 @@ TEST_CASE(\"Test prepare dependencies with multiple connections\", \"[catalog]\") {"," \tREQUIRE_NO_FAIL(con3->Query(\"COMMIT\"));"," }"," ","+TEST_CASE(\"Extract the plan of joins the optimizer rewrites\", \"[api]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE a AS SELECT 1 AS id, DATE '2025-01-01' AS dt\"));","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE r AS SELECT 1 AS id, DATE '2024-01-01' AS rd, NULL::DATE AS fd\"));","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE p (pid BIGINT PRIMARY KEY)\"));","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE knows (p1 BIGINT, p2 BIGINT, PRIMARY KEY (p1, p2))\"));","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE interest (pid BIGINT, tag BIGINT, PRIMARY KEY (pid, tag))\"));","+\tconst vector<string> queries {","+\t    \"SELECT a.id FROM a JOIN r ON r.id = a.id WHERE r.rd <= a.dt\",","+\t    \"SELECT a.id FROM a JOIN r ON r.id = a.id WHERE r.fd IS NULL OR r.fd > a.dt\",","+\t    // an ANTI join that closes a join cycle","+\t    \"SELECT count(i.tag) FROM p AS p1 JOIN knows AS k1 ON k1.p1 = p1.pid JOIN knows AS k2 ON k1.p2 = k2.p1 \"","+\t    \"JOIN p AS p3 ON k2.p2 = p3.pid JOIN interest AS i ON i.pid = p3.pid \"","+\t    \"ANTI JOIN knows AS k3 ON k3.p1 = p1.pid AND k3.p2 = p3.pid\"};","+\tfor (auto &query : queries) {","+\t\tauto plan = con.ExtractPlan(query);","+\t\tREQUIRE(plan);","+\t\tauto result = con.Query(query);","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(plan->types == result->GetTypes());","+\t}","+}","+"," TEST_CASE(\"Test connection API\", \"[api]\") {"," \tDuckDB db(nullptr);"," \tConnection con(db);"],"additions":25,"deletions":0,"truncated":false},{"path":"test/api/test_connect_prepare.cpp","lines":["@@ -0,0 +1,179 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+#include \"duckdb/catalog/duck_catalog.hpp\"","+#include \"duckdb/main/config.hpp\"","+#include \"duckdb/parser/expression/constant_expression.hpp\"","+#include \"duckdb/parser/parsed_data/attach_info.hpp\"","+#include \"duckdb/parser/query_node/select_node.hpp\"","+#include \"duckdb/parser/statement/select_statement.hpp\"","+#include \"duckdb/parser/tableref/emptytableref.hpp\"","+#include \"duckdb/parser/tableref/subqueryref.hpp\"","+#include \"duckdb/storage/storage_extension.hpp\"","+#include \"duckdb/transaction/duck_transaction_manager.hpp\"","+","+using namespace duckdb;","+","+namespace {","+","+//! The SQL of every statement routed to the connected database","+vector<string> routed_queries;","+","+//! A catalog that can be CONNECT-ed to, and answers every routed statement with its SQL and the catalog name","+class RoutingCatalog : public DuckCatalog {","+public:","+\texplicit RoutingCatalog(AttachedDatabase &db) : DuckCatalog(db) {","+\t}","+","+public:","+\tusing DuckCatalog::RemoteExecute;","+","+\tbool Supports(RemoteCapability capability) const override {","+\t\treturn capability == RemoteCapability::CONNECT;","+\t}","+","+\tunique_ptr<TableRef> RemoteExecute(ClientContext &context, const string &sql) override {","+\t\tif (sql == \"UNREACHABLE\") {","+\t\t\tthrow IOException(\"the connected database is unreachable\");","+\t\t}","+\t\trouted_queries.push_back(sql);","+\t\tauto node = make_uniq<SelectNode>();","+\t\tnode->select_list.push_back(ConstantExpression::String(sql));","+\t\tnode->select_list.push_back(ConstantExpression::String(GetName().GetIdentifierName()));","+\t\tnode->from_table = make_uniq<EmptyTableRef>();","+\t\tauto select = make_uniq<SelectStatement>();","+\t\tselect->node = std::move(node);","+\t\treturn make_uniq<SubqueryRef>(std::move(select));","+\t}","+};","+","+struct RoutingStorageExtension : StorageExtension {","+\tRoutingStorageExtension() {","+\t\tattach = [](optional_ptr<StorageExtensionInfo>, ClientContext &, AttachedDatabase &db, const string &,","+\t\t            AttachInfo &info, AttachOptions &) -> unique_ptr<Catalog> {","+\t\t\tinfo.path = IN_MEMORY_PATH;","+\t\t\treturn make_uniq_base<Catalog, RoutingCatalog>(db);","+\t\t};","+\t\tcreate_transaction_manager = [](optional_ptr<StorageExtensionInfo>, AttachedDatabase &db,","+\t\t                                Catalog &) -> unique_ptr<TransactionManager> {","+\t\t\treturn make_uniq<DuckTransactionManager>(db);","+\t\t};","+\t}","+};","+","+} // namespace","+","+TEST_CASE(\"Prepare statements while CONNECT-ed\", \"[api][connect]\") {","+\tDBConfig config;","+\tStorageExtension::Register(config, \"connect_routing_test\", make_shared_ptr<RoutingStorageExtension>());","+\tDuckDB db(nullptr, &config);","+\tConnection con(db);","+","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE t (i INTEGER)\"));","+\tREQUIRE_NO_FAIL(con.Query(\"ATTACH 'routed' AS remote (TYPE connect_routing_test)\"));","+\t// parsed before CONNECT, with the local grammar","+\tauto parsed_insert = con.ExtractStatements(\"INSERT INTO t VALUES (2)\");","+\tauto parsed_connect = con.ExtractStatements(\"CONNECT remote\");","+\tauto parameterized = con.ExtractStatements(\"SELECT $1::INTEGER\");","+\tREQUIRE_NO_FAIL(con.Query(\"CONNECT remote\"));","+\trouted_queries.clear();","+","+\t// preparing routes nothing","+\tauto select = con.Prepare(\"SELECT 42\");","+\tREQUIRE(!select->HasError());","+\tauto insert = con.Prepare(\"INSERT INTO t VALUES (1)\");","+\tREQUIRE(!insert->HasError());","+\tREQUIRE(routed_queries.empty());","+","+\t// each execution routes the statement as written","+\tauto result = select->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"SELECT 42\"}));","+\tresult = insert->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"INSERT INTO t VALUES (1)\"}));","+\tresult = insert->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"INSERT INTO t VALUES (1)\"}));","+\tREQUIRE(routed_queries == vector<string> {\"SELECT 42\", \"INSERT INTO t VALUES (1)\", \"INSERT INTO t VALUES (1)\"});","+\tauto parsed = con.Prepare(std::move(parsed_insert[0]));","+\tREQUIRE(!parsed->HasError());","+\tREQUIRE(routed_queries.size() == 3);","+\tresult = parsed->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"INSERT INTO t VALUES (2)\"}));","+\tREQUIRE(routed_queries.size() == 4);","+\tauto handle = select->Submit();","+\tREQUIRE_NO_FAIL(*handle);","+\thandle->Complete();","+\tREQUIRE(CHECK_COLUMN(handle, 0, {\"SELECT 42\"}));","+\tREQUIRE(CHECK_COLUMN(handle, 1, {\"remote\"}));","+\tREQUIRE(routed_queries.size() == 5);","+\t// the result is known only at execution","+\tREQUIRE(!select->MetadataAvailable());","+\tREQUIRE(select->GetStatementType() == StatementType::PASSTHROUGH_STATEMENT);","+","+\t// parameter values cannot be routed","+\tREQUIRE(insert->GetParameterCount() == 0);","+\tvector<Value> values {Value::INTEGER(1)};","+\tresult = insert->Execute(values);","+\tREQUIRE_FAIL(result);","+\tREQUIRE(StringUtil::Contains(result->GetError(), \"cannot be executed while CONNECT-ed\"));","+\tauto prepared = con.Prepare(std::move(parameterized[0]));","+\tREQUIRE(prepared->HasError());","+\tREQUIRE(StringUtil::Contains(prepared->GetError(), \"cannot be executed while CONNECT-ed\"));","+\tREQUIRE_FAIL(insert->Submit(values));","+\tREQUIRE(routed_queries.size() == 5);","+","+\t// CONNECT is routed too, however it was parsed","+\tauto connect = con.Prepare(\"CONNECT remote\");","+\tREQUIRE(!connect->HasError());","+\tresult = connect->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"CONNECT remote\"}));","+\tauto parsed_connect_prepared = con.Prepare(std::move(parsed_connect[0]));","+\tREQUIRE(!parsed_connect_prepared->HasError());","+\tresult = parsed_connect_prepared->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"CONNECT remote\"}));","+\tREQUIRE(routed_queries.size() == 7);","+","+\t// DISCONNECT prepared while CONNECT-ed runs locally","+\tauto disconnect = con.Prepare(\"DISCONNECT\");","+\tREQUIRE(!disconnect->HasError());","+\tREQUIRE_NO_FAIL(disconnect->Execute());","+\tREQUIRE(!con.context->IsConnected());","+\tREQUIRE(routed_queries.size() == 7);","+","+\t// statements prepared for the connected database do not run locally","+\tREQUIRE_FAIL(select->Execute());","+\tREQUIRE_FAIL(insert->Execute());","+\tREQUIRE_FAIL(parsed->Execute());","+\tREQUIRE_FAIL(connect->Execute());","+\tREQUIRE_FAIL(parsed_connect_prepared->Execute());","+\tREQUIRE(!con.context->IsConnected());","+\tresult = con.Query(\"SELECT count(*) FROM t\");","+\tREQUIRE(CHECK_COLUMN(result, 0, {0}));","+\tREQUIRE(routed_queries.size() == 7);","+","+\t// they run on the database that is connected at execution","+\tREQUIRE_NO_FAIL(con.Query(\"ATTACH 'routed' AS other (TYPE connect_routing_test)\"));","+\tREQUIRE_NO_FAIL(con.Query(\"CONNECT other\"));","+\tresult = select->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 0, {\"SELECT 42\"}));","+\tREQUIRE(CHECK_COLUMN(result, 1, {\"other\"}));","+\tREQUIRE(routed_queries.size() == 8);","+","+\t// a statement that cannot be routed fails at execution, and the connection stays usable","+\tauto unreachable = con.Prepare(\"UNREACHABLE\");","+\tREQUIRE(!unreachable->HasError());","+\tresult = unreachable->Execute();","+\tREQUIRE_FAIL(result);","+\tREQUIRE(StringUtil::Contains(result->GetError(), \"unreachable\"));","+\tREQUIRE_FAIL(unreachable->Submit());","+\tresult = select->Execute();","+\tREQUIRE(CHECK_COLUMN(result, 1, {\"other\"}));","+\tREQUIRE(routed_queries.size() == 9);","+","+\t// they fail once another connection detached the connected database","+\tConnection detacher(db);","+\tREQUIRE_NO_FAIL(detacher.Query(\"DETACH other\"));","+\tresult = select->Execute();","+\tREQUIRE_FAIL(result);","+\tREQUIRE(StringUtil::Contains(result->GetError(), \"has been detached\"));","+\tREQUIRE(routed_queries.size() == 9);","+\tREQUIRE_NO_FAIL(con.Query(\"DISCONNECT\"));","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"test/sql/connect/connect_failure_keeps_local_transaction.test","lines":["@@ -0,0 +1,139 @@","+# name: test/sql/connect/connect_failure_keeps_local_transaction.test","+# description: A statement that fails while CONNECT-ed leaves the local transaction valid","+# group: [connect]","+","+require quack","+","+require httpfs","+","+statement ok","+CALL quack_serve('quack:127.0.0.1:9618', token = 'test_token');","+","+statement ok","+ATTACH 'quack:127.0.0.1:9618' AS qk (TOKEN 'test_token');","+","+# the server answers PREPARE without rows, so a failure at run time arrives while the rows are fetched","+statement ok","+SET GLOBAL quack_prepare_inline_rows = 0;","+","+statement ok","+CREATE TABLE local_t AS SELECT 1 AS i;","+","+statement ok","+BEGIN;","+","+statement ok","+INSERT INTO local_t VALUES (2);","+","+statement ok","+CONNECT qk;","+","+# rejected by the connected database","+statement error","+CREATE GRANT;","+----","+syntax error at or near \"GRANT\"","+","+# fails while the rows are fetched","+statement error","+SELECT CASE WHEN i < 3 THEN i ELSE error('late failure') END FROM range(10) t(i);","+----","+late failure","+","+# rejected locally, before it is forwarded","+statement error","+SELECT 'unterminated","+----","+unterminated string literal","+","+query I","+SELECT 42;","+----","+42","+","+statement ok","+DISCONNECT;","+","+query I","+SELECT sum(i) FROM local_t;","+----","+3","+","+statement ok","+COMMIT;","+","+query I","+SELECT sum(i) FROM local_t;","+----","+3","+","+# a failure aborts the transaction of the connected database, not the local one","+statement ok","+BEGIN;","+","+statement ok","+INSERT INTO local_t VALUES (3);","+","+statement ok","+CONNECT qk;","+","+statement ok","+BEGIN;","+","+statement error","+CREATE GRANT;","+----","+syntax error at or near \"GRANT\"","+","+statement error","+SELECT 42;","+----","+Current transaction is aborted","+","+statement ok","+ROLLBACK;","+","+query I","+SELECT 42;","+----","+42","+","+statement ok","+DISCONNECT;","+","+statement ok","+COMMIT;","+","+query I","+SELECT sum(i) FROM local_t;","+----","+6","+","+# the same with a CONNECT by connection string","+statement ok","+BEGIN;","+","+statement ok","+INSERT INTO local_t VALUES (4);","+","+statement ok","+CONNECT 'quack:127.0.0.1:9618' (TOKEN 'test_token');","+","+statement error","+SELECT * FROM no_such_table;","+----","+no_such_table","+","+statement ok","+DISCONNECT;","+","+statement ok","+COMMIT;","+","+query I","+SELECT sum(i) FROM local_t;","+----","+10","+","+statement ok","+CALL quack_stop('quack:127.0.0.1:9618');"],"additions":139,"deletions":0,"truncated":false},{"path":"test/sql/connect/connect_string_ephemeral.test","lines":["@@ -20,3 +20,20 @@ statement error"," DISCONNECT;"," ----"," <REGEX>:.*no active CONNECT.*","+","+# DISCONNECT does not need a valid transaction, it reports the missing CONNECT also in an aborted one","+statement ok","+BEGIN;","+","+statement error","+SELECT error('boom');","+----","+boom","+","+statement error","+DISCONNECT;","+----","+<REGEX>:.*no active CONNECT.*","+","+statement ok","+ROLLBACK;"],"additions":17,"deletions":0,"truncated":false},{"path":"test/sql/connect/disconnect_aborted_transaction.test","lines":["@@ -0,0 +1,62 @@","+# name: test/sql/connect/disconnect_aborted_transaction.test","+# description: A failure while CONNECT-ed aborts the local transaction when it runs in a transaction of the local one","+# group: [connect]","+","+require quack","+","+require httpfs","+","+statement ok","+CALL quack_serve('quack:127.0.0.1:9619', token = 'test_token');","+","+statement ok","+CREATE TABLE remote_t (i INT);","+","+statement ok","+CREATE TABLE local_t (i INT);","+","+statement ok","+ATTACH 'quack:127.0.0.1:9619' AS qk (TOKEN 'test_token');","+","+statement ok","+BEGIN;","+","+# the local transaction starts a transaction on the connected database","+statement ok","+INSERT INTO qk.remote_t VALUES (1);","+","+statement ok","+INSERT INTO local_t VALUES (1);","+","+statement ok","+CONNECT qk;","+","+# the statements run in that transaction","+query I","+SELECT count(*) FROM remote_t;","+----","+1","+","+statement error","+SELECT error('boom');","+----","+boom","+","+statement ok","+DISCONNECT;","+","+statement error","+SELECT count(*) FROM local_t;","+----","+Current transaction is aborted","+","+statement ok","+ROLLBACK;","+","+query II","+SELECT (SELECT count(*) FROM local_t), (SELECT count(*) FROM remote_t);","+----","+0\t0","+","+statement ok","+CALL quack_stop('quack:127.0.0.1:9619');",""],"additions":62,"deletions":0,"truncated":false}],"additions":482,"deletions":23,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-23T14:16:56.263065+00:00"}