  #[test]","+    fn test_missing_query_does_not_record_login_failure() {","+        let req = Request::builder()","+            .uri(\"/v1/query/missing/page/1\".parse().unwrap())","+            .finish();","+        let mut history = LoginHistory::new();","+        assert!(!history.disable_write);","+        let before = serde_json::to_value(&history).unwrap();","+        let response = auth_error_response(","+            EndpointKind::PollQuery,","+            ErrorCode::UnknownQuery(\"Query ID missing not found on node test\"),","+            &mut history,","+            &req,","+            req.headers(),","+        );","+        assert_eq!(response.status(), StatusCode::NOT_FOUND);","+        assert_eq!(serde_json::to_value(&history).unwrap(), before);","+    }","+","+    #[test]","+    fn test_authentication_failure_still_records_login_failure() {","+        let req = Request::builder()","+            .uri(\"/v1/query/existing/page/1\".parse().unwrap())","+            .finish();","+        for (kind, err, expected_status) in [","+            (","+                EndpointKind::PollQuery,","+                ErrorCode::AuthenticateFailure(\"Invalid query token\"),","+                StatusCode::UNAUTHORIZED,","+            ),","+            (","+                EndpointKind::StartQuery,","+                ErrorCode::UnknownQuery(\"not a poll request\"),","+                StatusCode::INTERNAL_SERVER_ERROR,","+            ),","+        ] {","+            let mut history = LoginHistory::new();","+            let message = err.to_string();","+            let response = auth_error_response(kind, err, &mut history, &req, req.headers());","+            assert_eq!(response.status(), expected_status);","+            assert!(matches!(history.event_type, LoginEventType::LoginFailed));","+            assert_eq!(history.error_message, message);","+            assert!(!history.disable_write);","+        }","+    }"," ","     #[test]","     fn test_request_info_does_not_expose