version(&packument, version_or_tag) {","+        return Ok(Some(packument));","+    }","+    match reload_source_packument_lacking_version(state, identity, source, name).await? {","+        Some(bytes) => Ok(Some(serde_json::from_slice(&bytes)?)),","+        None => Ok(Some(packument)),","+    }","+}","+","+fn lists_version(packument: &Value, version_or_tag: &str) -> bool {","+    let version = resolve_version_or_tag(packument, version_or_tag);","+    packument","+        .get(\"versions\")","+        .and_then(|versions| versions.get(version))","+        .is_some()"," }"," "," async fn read_hosted_version_packument(","@@ -201,12 +218,7 @@ async fn read_hosted_version_packument(","         .for_hosted(&namespace, pnpr_registry::Ecosystem::Npm)","         .lookup_in_hosted_document(name, move |bytes| {","             let packument: Value = serde_json::from_slice(bytes)?;","-            let resolved = resolve_version_or_tag(&packument, &requested);","-            let present = packument","-                .get(\"versions\")","-                .and_then(|versions| versions.get(resolved))","-                .is_some();","-            Ok(present.then_some(packument))","+            Ok(lists_version(&packument, &requested).then_some(packument))","         })","         .await?;","     Ok(lookup.found())"],"additions":22,"deletions":10,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/state.rs","lines":["@@ -63,6 +63,7 @@ pub(super) struct ProxyState {","     pub(super) background_tar_scans: Arc<super::BackgroundTarScans>,","     pub(super) integrity_backfill: super::upstream_integrity::BackgroundIntegrity,","     pub(super) version_tgzs: super::VersionTgzCache,","+    pub(super) packument_refetches: super::PackumentRefetches,"," }"," "," pub(super) struct MutationLocks {","@@ -161,6 +162,7 @@ impl ProxyState {","             background_tar_scans: super::BackgroundTarScans::new(),","             integrity_backfill: super::upstream_integrity::BackgroundIntegrity::default(),","             version_tgzs: super::VersionTgzCache::default(),","+            packument_refetches: super::PackumentRefetches::default(),","         }","     }"," }"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/upstream_packuments.rs","lines":["@@ -1,3 +1,8 @@","+pub(super) use missing_versions::{","+    PackumentRefetches, reload_source_packument_lacking_version,","+    reload_upstream_packument_lacking_version,","+};","+"," use super::{","     Action, AppState, CacheValidators, CanonicalPackageName, DistView, Duration, Ecosystem,","     HeaderMap, HostedGate, Identity, PackumentFetch, RegistryError, RegistrySource, Response,","@@ -7,7 +12,9 @@ use super::{","     packument_response, resolve_registry_source, timed, upstream_cache_namespace,"," };"," use axum::{body::Bytes, response::IntoResponse};","-use std::sync::Arc;","+use std::{future::Future, sync::Arc};","+","+mod missing_versions;"," "," /// The stored packument of whichever source a registry routes this package to."," ///","@@ -84,6 +91,12 @@ pub(super) struct AdmittedPackument {","     _admission: SourceAdmission,"," }"," ","+impl AdmittedPackument {","+    fn new(bytes: Vec<u8>, admission: SourceAdmission) -> Arc<Self> {","+        Arc::new(Self { bytes: bytes.into(), _admission: admission })","+    }","+}","+"," async fn fetch_coalesced_upstream_packument(","     state: &AppState,","     namespace: &str,","@@ -91,21 +104,32 @@ async fn fetch_coalesced_upstream_packument(","     name: &CanonicalPackageName,","     ttl: Duration,"," ) -> Result<Option<Arc<AdmittedPackument>>, RegistryError> {","-    let key = (namespace.to_string(), name.clone());","-    Box::pin(state.inner.proxy.packument_singleflight.work(key, || {","-        Box::pin(async {","-            let admission =","-                state.inner.packuments.admissions.acquire(DocumentSource::Upstream(namespace))","-                    .await;","-            let fetched =","-                fetch_and_cache_upstream_packument(state, namespace, upstream, name, ttl).await?;","-            Ok(fetched.map(|bytes| {","-                Arc::new(AdmittedPackument { bytes: bytes.into(), _admission: admission })","-            }))","-        })","-    }))","+    coalesce_upstream_packument(state, namespace, name, || async {","+        let admission =","+            state.inner.packuments.admissions.acquire(DocumentSource::Upstream(namespace)).await;","+        let fetched =","+            fetch_and_cache_upstream_packument(state, namespace, upstream, name, ttl).await?;","+        Ok(fetched.map(|bytes| AdmittedPackument::new(bytes, admission)))","+    })","     .await","-    .map_err(RegistryError::Shared)","+}","+","+/// Run `read` as the one in-flight read of an upstream package's packument,","+/// or wait for the read already in flight for it.","+async fn coalesce_upstream_packument<Read, Pending>(","+    state: &AppState,","+    namespace: &str,","+    name: &CanonicalPackageName,","+    read: Read,","+) -> Result<Option<Arc<AdmittedPackument>>, RegistryError>","+where","+    Read: FnOnce() -> Pending + Send,","+    Pending: Future<Output = Result<Option<Arc<AdmittedPackument>>, Arc<RegistryError>>> + Send,","+{","+    let key = (namespace.to_string(), name.clone());","+    Box::pin(state.inner.proxy.packument_singleflight.work(key, || Box::pin(read())))","+        .await","+        .map_err(RegistryError::Shared)"," }"," "," async fn fetch_and_cache_upstream_packument(","@@ -131,6 +155,7 @@ async fn fetch_and_cache_upstream_packument(","     {","         Ok(fetched) => fetched,","         Err(err) => {","+            state.inner.proxy.packument_refetches.record_failure(namespace, name);","             return recover_stale_upstream_packument(state, namespace, upstream, name, err)","                 .await","                 .map_err(Arc::new);"],"additions":40,"deletions":15,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/upstream_packuments/missing_versions.rs","lines":["@@ -0,0 +1,131 @@","+//! Refetching a fresh cached packument that does not list a requested","+//! version.","+","+use super::{","+    AdmittedPackument, AppState, CanonicalPackageName, DocumentSource, Duration, Identity,","+    RegistryError, RegistrySource, Upstream, authorized_upstream, coalesce_upstream_packument,","+    fetch_and_cache_upstream_packument, upstream_cache_namespace,","+};","+use std::{collections::HashMap, sync::Mutex, time::Instant};","+","+#[cfg(test)]","+mod tests;","+","+/// How long after a packument's fetch, a failed fetch, or a refetch attempt,","+/// a request for a version it does not list waits before refetching it. A","+/// version published upstream after the fetch is then served before the","+/// packument TTL expires, and requests for versions that do not exist reach","+/// the upstream at most once per package per interval.","+const REFETCH_INTERVAL: Duration = Duration::from_secs(60);","+","+/// Packages tracked before attempts are dropped: those older than","+/// [`REFETCH_INTERVAL`], and a quarter of the rest if that frees none.","+const CAPACITY: usize = 16 * 1024;","+","+/// When each package's packument was last refetched for a version it did","+/// not list, whether or not the refetch succeeded.","+#[derive(Default)]","+pub(in crate::server) struct PackumentRefetches {","+    attempts: Mutex<HashMap<(String, CanonicalPackageName), Instant>>,","+}","+","+impl PackumentRefetches {","+    /// Record an attempt for the package. `false` when one was recorded","+    /// within [`REFETCH_INTERVAL`].","+    fn claim(&self, namespace: &str, name: &CanonicalPackageName) -> bool {","+        let mut attempts = self.attempts.lock().expect(\"packument refetch lock poisoned\");","+        let key = (namespace.to_string(), name.clone());","+        if attempts","+            .get(&key)","+            .is_some_and(|attempted| attempted.elapsed() < REFETCH_INTERVAL)","+        {","+            return false;","+        }","+        insert_attempt(&mut attempts, key);","+        true","+    }","+","+    /// Record a failed upstream fetch of the package's packument, so a","+    /// missing-version refetch does not ask the upstream again within","+    /// [`REFETCH_INTERVAL`].","+    pub(in crate::server) fn record_failure(&self, namespace: &str, name: &CanonicalPackageName) {","+        let mut attempts = self.attempts.lock().expect(\"packument refetch lock poisoned\");","+        insert_attempt(&mut attempts, (namespace.to_string(), name.clone()));","+    }","+}","+","+fn insert_attempt(","+    attempts: &mut HashMap<(String, CanonicalPackageName), Instant>,","+    key: (String, CanonicalPackageName),","+) {","+    if attempts.len() >= CAPACITY {","+        attempts.retain(|_, attempted| attempted.elapsed() < REFETCH_INTERVAL);","+    }","+    if attempts.len() >= CAPACITY {","+        let evicted: Vec<_> = attempts","+            .keys()","+            .take(CAPACITY / 4)","+            .cloned()","+            .collect();","+        for evicted in evicted {","+            attempts.remove(&evicted);","+        }","+    }","+    attempts.insert(key, Instant::now());","+}","+","+/// [`reload_upstream_packument_lacking_version`] for the upstream `source`","+/// routes the package to. `None` for any other source.","+pub(in crate::server) async fn reload_source_packument_lacking_version(","+    state: &AppState,","+    identity: &Identity,","+    source: &RegistrySource,","+    name: &CanonicalPackageName,","+) -> Result<Option<Vec<u8>>, RegistryError> {","+    let RegistrySource::Upstream(id) = source else { return Ok(None) };","+    let namespace = upstream_cache_namespace(state, id);","+    let upstream = authorized_upstream(state, identity, id)?;","+    reload_upstream_packument_lacking_version(state, &namespace, &upstream, name).await","+}","+","+/// The packument to read again after its fresh cached copy did not list a","+/// requested version:","+///","+/// - the cached copy if it was fetched within [`REFETCH_INTERVAL`], as","+///   another request may have refetched it since;","+/// - the result of a refetch already in flight for the package;","+/// - a refetch, unless a refetch or a failed fetch was attempted within","+///   [`REFETCH_INTERVAL`], which leaves the cached copy.","+///","+/// `None` when the upstream is not cached.","+pub(in crate::server) async fn reload_upstream_packument_lacking_version(","+    state: &AppState,","+    namespace: &str,","+    upstream: &Upstream,","+    name: &CanonicalPackageName,","+) -> Result<Option<Vec<u8>>, RegistryError> {","+    if !upstream.caches() {","+        return Ok(None);","+    }","+    let storage = &state.inner.storage;","+    if let Some(recent) = storage.read_upstream_document(namespace, name, REFETCH_INTERVAL).await? {","+        return Ok(Some(recent));","+    }","+    // The claim is taken by the flight's leader, so a request arriving","+    // during a refetch waits for it rather than finding the claim taken.","+    let document = coalesce_upstream_packument(state, namespace, name, || async {","+        let admissions = &state.inner.packuments.admissions;","+        if !state.inner.proxy.packument_refetches.claim(namespace, name) {","+            let admission = admissions.acquire(DocumentSource::Stored).await;","+            let cached = storage.read_upstream_document_any(namespace, name).await?;","+            return Ok(cached.map(|bytes| AdmittedPackument::new(bytes, admission)));","+        }","+        let admission = admissions.acquire(DocumentSource::Upstream(namespace)).await;","+        let fetched =","+            fetch_and_cache_upstream_packument(state, namespace, upstream, name, REFETCH_INTERVAL)","+                .await?;","+        Ok(fetched.map(|bytes| AdmittedPackument::new(bytes, admission)))","+    })","+    .await?;","+    Ok(document.map(|document| document.bytes.to_vec()))","+}"],"additions":131,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/upstream_packuments/missing_versions/tests.rs","lines":["@@ -0,0 +1,182 @@","+use super::{AppState, CAPACITY, CanonicalPackageName, PackumentRefetches};","+use pnpr_config::Config;","+use pnpr_fixtures::MockConfigPresets;","+use std::{","+    path::Path,","+    sync::Arc,","+    time::{Duration, SystemTime},","+};","+use tempfile::TempDir;","+","+fn package(name: &str) -> CanonicalPackageName {","+    CanonicalPackageName::parse(name, pnpr_package_name::Ecosystem::Npm).unwrap()","+}","+","+#[test]","+fn a_package_is_claimed_once_per_interval() {","+    let refetches = PackumentRefetches::default();","+    assert!(refetches.claim(\"npmjs\", &package(\"example-widget\")));","+    assert!(!refetches.claim(\"npmjs\", &package(\"example-widget\")));","+    assert!(refetches.claim(\"npmjs\", &package(\"example-gadget\")));","+    assert!(refetches.claim(\"mirror\", &package(\"example-widget\")));","+}","+","+#[test]","+fn a_new_package_is_claimed_when_recent_attempts_fill_the_table() {","+    let refetches = PackumentRefetches::default();","+    for index in 0..CAPACITY {","+        assert!(refetches.claim(\"npmjs\", &package(&format!(\"example-widget-{index}\"))));","+    }","+    assert!(refetches.claim(\"npmjs\", &package(\"example-gadget\")));","+    assert!(refetches.attempts.lock().unwrap().len() <= CAPACITY);","+}","+","+/// Another request can refetch the packument between the caller's read and","+/// its reload. The reload then returns that copy rather than nothing.","+#[tokio::test]","+async fn a_packument_refetched_since_the_read_is_returned_without_a_fetch() {","+    let mut upstream = mockito::Server::new_async().await;","+    let fetch = upstream","+        .mock(\"GET\", \"/example-widget\")","+        .expect(0)","+        .create_async()","+        .await;","+    let storage = TempDir::new().unwrap();","+    let state = proxy_state(&upstream.url(), storage.path());","+    let namespace = crate::server::upstream_cache_namespace(&state, \"npmjs\");","+    let name = package(\"example-widget\");","+    let refetched = br#\"{\"name\":\"example-widget\",\"versions\":{}}\"#;","+    state.inner.storage.write_upstream_document(&namespace, &name, refetched).await.unwrap();","+","+    let reloaded = reload(&state, &name).await;","+","+    assert_eq!(reloaded.as_deref(), Some(refetched.as_slice()));","+    fetch.assert_async().await;","+}","+","+/// The claim is taken once a refetch starts, so a request arriving during it","+/// must wait for its result rather than give up.","+#[tokio::test]","+async fn a_request_during_a_refetch_gets_its_result() {","+    use axum::{Json, Router, routing::get};","+","+    let release = Arc::new(tokio::sync::Notify::new());","+    let held = Arc::clone(&release);","+    let (fetched_tx, mut fetched) = tokio::sync::mpsc::unbounded_channel();","+    let listing = serde_json::json!({\"name\": \"example-widget\", \"versions\": {\"2.0.0\": {}}});","+    let served = listing.clone();","+    let origin = Router::new()","+        .route(","+            \"/example-widget\",","+            get(move || async move {","+                fetched_tx.send(()).unwrap();","+                held.notified().await;","+                Json(served)","+            }),","+        );","+    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();","+    let address = listener.local_addr().unwrap();","+    let origin = tokio::spawn(async move { axum::serve(listener, origin).await.unwrap() });","+    let storage = TempDir::new().unwrap();","+    let state = proxy_state(&format!(\"http://{address}\"), storage.path());","+    let namespace = crate::server::upstream_cache_namespace(&state, \"npmjs\");","+    let name = package(\"example-widget\");","+    let cached = br#\"{\"name\":\"example-widget\",\"versions\":{}}\"#;","+    state.inner.storage.write_upstream_document(&namespace, &name, cached).await.unwrap();","+    date_back(storage.path(), Duration::from_mins(2));","+","+    let first = tokio::spawn({","+        let state = state.clone();","+        let name = name.clone();","+        async move { reload(&state, &name).await }","+    });","+    fetched.recv().await.unwrap();","+    let second = tokio::spawn({","+        let state = state.clone();","+        let name = name.clone();","+        async move { reload(&state, &name).await }","+    });","+    tokio::time::sleep(Duration::from_millis(100)).await;","+    release.notify_waiters();","+","+    for reloaded in [first.await.unwrap(), second.await.unwrap()] {","+        let reloaded: serde_json::Value = serde_json::from_slice(&reloaded.unwrap()).unwrap();","+        assert!(reloaded[\"versions\"].get(\"2.0.0\").is_some());","+    }","+    assert!(fetched.try_recv().is_err(), \"one upstream fetch serves both requests\");","+    origin.abort();","+}","+","+/// A packument can expire between the caller's read and its reload. Only a","+/// failed fetch, not the clock, says the upstream was already asked.","+#[tokio::test]","+async fn a_packument_that_expired_since_the_read_is_refetched() {","+    let mut upstream = mockito::Server::new_async().await;","+    let listing = r#\"{\"name\":\"example-widget\",\"versions\":{\"2.0.0\":{}}}\"#;","+    let fetch = upstream","+        .mock(\"GET\", \"/example-widget\")","+        .with_header(\"content-type\", \"application/json\")","+        .with_body(listing)","+        .expect(1)","+        .create_async()","+        .await;","+    let storage = TempDir::new().unwrap();","+    let state = proxy_state(&upstream.url(), storage.path());","+    let namespace = crate::server::upstream_cache_namespace(&state, \"npmjs\");","+    let name = package(\"example-widget\");","+    let cached = br#\"{\"name\":\"example-widget\",\"versions\":{}}\"#;","+    state.inner.storage.write_upstream_document(&namespace, &name, cached).await.unwrap();","+    date_back(storage.path(), Duration::from_hours(25));","+","+    let reloaded: serde_json::Value =","+        serde_json::from_slice(&reload(&state, &name).await.unwrap()).unwrap();","+","+    assert!(reloaded[\"versions\"].get(\"2.0.0\").is_some());","+    fetch.assert_async().await;","+}","+","+fn proxy_state(upstream: &str, storage: &Path) -> AppState {","+    let mut config = Config::proxy(\"127.0.0.1:0\".parse().unwrap(), storage.to_path_buf());","+    let npmjs = config.routing.upstreams.get_mut(\"npmjs\").unwrap();","+    npmjs.url = upstream.to_string();","+    npmjs.packument_ttl = Some(Duration::from_hours(24));","+    config.http.public_url = \"http://example.test\".to_string();","+    config.routing.route_policy.allowed_private_networks =","+        vec![pnpr_config::IpNetwork::parse(\"127.0.0.0/8\").unwrap()];","+    AppState {","+        inner: Arc::new(","+            crate::server::state::AppInner::new(config, pnpr_auth::AuthState::in_memory(), None)","+                .unwrap(),","+        ),","+    }","+}","+","+async fn reload(state: &AppState, name: &CanonicalPackageName) -> Option<Vec<u8>> {","+    let namespace = crate::server::upstream_cache_namespace(state, \"npmjs\");","+    super::reload_upstream_packument_lacking_version(","+        state,","+        &namespace,","+        &state.routing().upstream_clients[\"npmjs\"],","+        name,","+    )","+    .await","+    .unwrap()","+}","+","+/// Date every file under `dir` back by `age`, so a cached packument reads as","+/// fetched that long ago.","+fn date_back(dir: &Path, age: Duration) {","+    let fetched = SystemTime::now() - age;","+    let files = walkdir::WalkDir::new(dir)","+        .into_iter()","+        .map(Result::unwrap)","+        .filter(|entry| entry.file_type().is_file());","+    for entry in files {","+        std::fs::File::options()","+            .write(true)","+            .open(entry.path())","+            .unwrap()","+            .set_modified(fetched)","+            .unwrap();","+    }","+}"],"additions":182,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/upstream_tarballs.rs","lines":["@@ -5,8 +5,9 @@ use self::background_scan::{"," use super::{","     AppState, CanonicalPackageName, Duration, FetchOutcome, Identity, Integrity, RegistryError,","     Response, TarballDist, Upstream, authorized_upstream, ensure_osv_allowed,","-    expected_tarball_dist, load_upstream_packument, not_found, streaming, tarball_response,","-    tarball_stream_error, timed, upstream_cache_namespace,","+    expected_tarball_dist, load_upstream_packument, not_found,","+    reload_upstream_packument_lacking_version, streaming, tarball_response, tarball_stream_error,","+    timed, upstream_cache_namespace,"," };"," use axum::response::IntoResponse;"," ","@@ -174,7 +175,13 @@ pub(super) async fn bind_tarball_to_packument(","     let Some(packument) = packument else {","         return Ok(None);","     };","-    let result = parse_tarball_dist(state, packument, name, filename).await;","+    let mut result = parse_tarball_dist(state, packument, name, filename).await;","+    if matches!(result, Ok(None))","+        && let Some(packument) =","+            reload_upstream_packument_lacking_version(state, namespace, upstream, name).await?","+    {","+        result = parse_tarball_dist(state, packument, name, filename).await;","+    }","     if result.is_ok() {","         return result;","     }"],"additions":10,"deletions":3,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/version_tarballs/dist.rs","lines":["@@ -4,7 +4,10 @@ use super::{","     cache::{DistOrigin, VersionTgz, version_manifest_tgz, version_tgz},","     hosted_read_namespace, timed, upstream_cache_namespace,"," };","-use crate::server::{authorize, read_source_packument, recover_stale_upstream_packument};","+use crate::server::{","+    authorize, read_source_packument, recover_stale_upstream_packument,","+    reload_source_packument_lacking_version,","+};"," use pnpr_storage::DocumentStamp;"," use std::{sync::Arc, time::Instant};"," ","@@ -105,6 +108,27 @@ impl VersionRequest<'_> {","         else {","