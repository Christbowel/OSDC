rity,","+};","+use std::{path::Path, time::SystemTime};","+","+const TTL: Duration = Duration::from_hours(24);","+","+async fn get(app: &axum::Router, uri: &str) -> axum::response::Response {","+    app.clone()","+        .oneshot(","+            Request::get(uri)","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap()","+}","+","+fn packument(upstream: &str, versions: &[(&str, &[u8])]) -> String {","+    let manifests: serde_json::Map<String, serde_json::Value> = versions","+        .iter()","+        .map(|(version, tgz)| {","+            let manifest = json!({ \"name\": \"foo\", \"version\": version, \"dist\": {","+                \"tarball\": format!(\"{upstream}/foo/-/foo-{version}.tgz\"),","+                \"integrity\": sha512_integrity(tgz),","+            } });","+            (version.to_string(), manifest)","+        })","+        .collect();","+    let latest = versions.last().unwrap().0;","+    json!({ \"name\": \"foo\", \"dist-tags\": { \"latest\": latest }, \"versions\": manifests }).to_string()","+}","+","+fn app(upstream: &str, storage: &Path) -> axum::Router {","+    let mut config = config_for(upstream, storage.to_path_buf());","+    config.routing.upstreams.get_mut(\"npmjs\").unwrap().packument_ttl = Some(TTL);","+    router(config)","+}","+","+/// Date every file under `dir` back by `age`, so each cached packument reads","+/// as fetched that long ago and stays within [`TTL`].","+fn age_cached_packuments(dir: &Path, age: Duration) {","+    let fetched = SystemTime::now() - age;","+    let files = walkdir::WalkDir::new(dir)","+        .into_iter()","+        .map(Result::unwrap)","+        .filter(|entry| entry.file_type().is_file());","+    for entry in files {","+        let path = entry.path();","+        if path","+            .file_name()","+            .is_some_and(|name| name == \"fetched-at.json\")","+        {","+            std::fs::write(path, serde_json::to_vec(&fetched).unwrap()).unwrap();","+        }","+        std::fs::File::options()","+            .write(true)","+            .open(path)","+            .unwrap()","+            .set_modified(fetched)","+            .unwrap();","+    }","+}","+","+/// Cache `foo`'s packument listing only 1.0.0.","+async fn cache_first_version(upstream: &mut mockito::ServerGuard, app: &axum::Router) {","+    let cached = upstream","+        .mock(\"GET\", \"/foo\")","+        .with_header(\"content-type\", \"application/json\")","+        .with_body(packument(&upstream.url(), &[(\"1.0.0\", b\"old\")]))","+        .expect(1)","+        .create_async()","+        .await;","+    let response = get(app, \"/npm/foo\").await;","+    assert_eq!(response.status(), StatusCode::OK);","+    cached.assert_async().await;","+    cached.remove_async().await;","+}","+","+/// Cache `foo`'s packument listing only 1.0.0, then publish 1.0.1 upstream.","+/// Returns the mock that serves the packument with both versions.","+async fn publish_after_caching(","+    upstream: &mut mockito::ServerGuard,","+    app: &axum::Router,","+    new_tgz: &[u8],","+) -> mockito::Mock {","+    cache_first_version(upstream, app).await;","+    upstream","+        .mock(\"GET\", \"/foo/-/foo-1.0.1.tgz\")","+        .with_body(new_tgz)","+        .create_async()","+        .await;","+    upstream","+        .mock(\"GET\", \"/foo\")","+        .with_header(\"content-type\", \"application/json\")","+        .with_body(packument(&upstream.url(), &[(\"1.0.0\", b\"old\"), (\"1.0.1\", new_tgz)]))","+        .expect(1)","+        .create_async()","+        .await","+}","+","+/// Cache `foo`'s packument listing only 1.0.0, date it back by `age`, and","+/// make the upstream fail. Returns the mock that fails."],"additions":108,"deletions":0,"truncated":false}],"additions":534,"deletions":33,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-17T18:44:13.322710+00:00"}