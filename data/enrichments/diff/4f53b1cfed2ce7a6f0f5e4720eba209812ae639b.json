 ","+/**","+ * @public","+ * @enum","+ */","+export const SeverityLabel = {","+  critical: \"critical\",","+  high: \"high\",","+  informational: \"informational\",","+  low: \"low\",","+  medium: \"medium\",","+} as const;","+/**","+ * @public","+ */","+export type SeverityLabel = (typeof SeverityLabel)[keyof typeof SeverityLabel];","+"," /**","  * @public","  * @enum"],"additions":16,"deletions":0,"truncated":false},{"path":"clients/client-ec2/src/models/models_4.ts","lines":["@@ -95,6 +95,7 @@ import type {","   Scope,","   SecondaryInterfaceStatus,","   SecondaryInterfaceType,","+  SeverityLabel,","   SpotAllocationStrategy,","   SpotInstanceInterruptionBehavior,","   SqlServerLicenseUsage,","@@ -3070,6 +3071,73 @@ export interface DescribeImagesRequest {","    *             </li>","    *             <li>","    *                <p>","+   *                   <code>scan-result.critical-fix-available-since</code> - The earliest date and time, in","+   *           the ISO 8601 format in the UTC time zone (YYYY-MM-DDThh:mm:ss.sssZ), at which Amazon","+   *           Inspector reported a fix as available for a <code>critical</code> severity finding on the","+   *           AMI.</p>","+   *             </li>","+   *             <li>","+   *                <p>","+   *                   <code>scan-result.finding-scan-date</code> - The date and time, in the ISO 8601","+   *           format in the UTC time zone (YYYY-MM-DDThh:mm:ss.sssZ), of the most recent Amazon","+   *           Inspector scan of the AMI.</p>","+   *             </li>","+   *             <li>","+   *                <p>","+   *                   <code>scan-result.high-fix-available-since</code> - The earliest date and time, in the","+   *           ISO 8601 format in the UTC time zone (YYYY-MM-DDThh:mm:ss.sssZ), at which Amazon Inspector","+   *           reported a fix as available for a <code>high</code> severity finding on the AMI.</p>","+   *             </li>","+   *             <li>","+   *                <p>","+   *                   <code>scan-result.highest-finding-severity-label</code> - The highest severity among","+   *           the AMI's Amazon Inspector findings, whether or not a fix is available. The valid values","+   *           are the following Amazon Inspector severity levels:</p>","+   *                <ul>","+   *                   <li>","+   *                      <p>","+   *                         <code>informational</code> - CVSS score of 0.</p>","+   *                   </li>","+   *                   <li>","+   *                      <p>","+   *                         <code>low</code> - CVSS score of 0.1 to 3.9.</p>","+   *                   </li>","+   *                   <li>","+   *                      <p>","+   *                         <code>medium</code> - CVSS score of 4.0 to 6.9.</p>","+   *                   </li>","+   *                   <li>","+   *                      <p>","+   *                         <code>high</code> - CVSS score of 7.0 to 8.9.</p>","+   *                   </li>","+   *                   <li>","+   *                      <p>","+   *                         <code>critical</code> - CVSS score of 9.0 to 10.0.</p>","+   *                   </li>","+   *                </ul>","+   *             </li>","+   *             <li>","+   *                <p>","+   *                   <code>scan-result.informational-fix-available-since</code> - The earliest date and","+   *           time, in the ISO 8601 format in the UTC time zone (YYYY-MM-DDThh:mm:ss.sssZ), at which","+   *           Amazon Inspector reported a fix as available for an <code>informational</code> severity","+   *           finding on the AMI.</p>","+   *             </li>","+   *             <li>","+   *                <p>","+   *                   <code>scan-result.low-fix-available-since</code> - The earliest date and time, in the","+   *           ISO 8601 format in the UTC time zone (YYYY-MM-DDThh:mm:ss.sssZ), at which Amazon Inspector","+