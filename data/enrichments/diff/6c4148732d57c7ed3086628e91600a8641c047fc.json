NO_FAIL(conn.Query(\"SELECT 42\"));"," }","+","+namespace {","+","+//! Counts the statement and query notifications and fails StatementEnd while the shared failures last","+struct FailingStatementEndState : ClientContextState {","+\tFailingStatementEndState(string name_p, idx_t &failures_left_p, string &first_failure_p, bool &fatal_after_first_p)","+\t    : name(std::move(name_p)), failures_left(failures_left_p), first_failure(first_failure_p),","+\t      fatal_after_first(fatal_after_first_p) {","+\t}","+\tusing ClientContextState::QueryEnd;","+\tusing ClientContextState::StatementEnd;","+","+\tvoid StatementBegin(ClientContext &) override {","+\t\tstatement_begins++;","+\t}","+\tvoid StatementEnd(ClientContext &, optional_ptr<ErrorData> error) override {","+\t\tstatement_ends++;","+\t\tif (error && error->HasError()) {","+\t\t\tstatement_end_errors++;","+\t\t}","+\t\tif (failures_left > 0) {","+\t\t\tfailures_left--;","+\t\t\tif (first_failure.empty()) {","+\t\t\t\tfirst_failure = name;","+\t\t\t}","+\t\t\tif (fail_with_binder_error) {","+\t\t\t\tthrow BinderException(name + \" StatementEnd failed\");","+\t\t\t}","+\t\t\tif (fail_with_fatal_error || (fatal_after_first && first_failure != name)) {","+\t\t\t\tthrow FatalException(name + \" StatementEnd failed\");","+\t\t\t}","+\t\t\tthrow IOException(name + \" StatementEnd failed\");","+\t\t}","+\t}","+\tvoid QueryEnd(ClientContext &, optional_ptr<ErrorData> error) override {","+\t\tquery_ends++;","+\t\tif (error && error->HasError()) {","+\t\t\tquery_end_errors.push_back(error->Message());","+\t\t}","+\t}","+","+\tstring name;","+\t//! Shared by the states, so the first StatementEnd dispatched fails whichever state receives it","+\tidx_t &failures_left;","+\t//! The name of the state that failed first, shared by the states","+\tstring &first_failure;","+\t//! Whether the failures after the first one are fatal errors, shared by the states","+\tbool &fatal_after_first;","+\t//! Whether the failure is an error of a kind that does not invalidate transactions under the permissive policy","+\tbool fail_with_binder_error = false;","+\t//! Whether the failure is a fatal error, which invalidates the database","+\tbool fail_with_fatal_error = false;","+\tidx_t statement_begins = 0;","+\tidx_t statement_ends = 0;","+\tidx_t statement_end_errors = 0;","+\tidx_t query_ends = 0;","+\tvector<string> query_end_errors;","+};","+","+//! Two registered states on a connection whose StatementEnd fails the given number of times","+struct FailingStatementEnds {","+\texplicit FailingStatementEnds(Connection &conn_p) : conn(conn_p) {","+\t\talpha = make_shared_ptr<FailingStatementEndState>(\"alpha\", failures_left, first_failure, fatal_after_first);","+\t\tbeta = make_shared_ptr<FailingStatementEndState>(\"beta\", failures_left, first_failure, fatal_after_first);","+\t\tconn.context->Services().GetRegisteredState().Insert(\"alpha\", alpha);","+\t\tconn.context->Services().GetRegisteredState().Insert(\"beta\", beta);","+\t}","+","+\ttemplate <class CALLBACK>","+\tvoid ForEachState(CALLBACK &&callback) {","+\t\tcallback(*alpha);","+\t\tcallback(*beta);","+\t}","+","+\tvoid ResetCounts() {","+\t\tForEachState([](FailingStatementEndState &state) {","+\t\t\tstate.statement_begins = 0;","+\t\t\tstate.statement_ends = 0;","+\t\t\tstate.statement_end_errors = 0;","+\t\t\tstate.query_ends = 0;","+\t\t\tstate.query_end_errors.clear();","+\t\t});","+\t}","+","+\tvoid FailWithBinderError() {","+\t\tForEachState([](FailingStatementEndState &state) { state.fail_with_binder_error = true; });","+\t}","+","+\t//! The message of the error the state that failed first threw","+\tstring FirstError() {","+\t\tREQUIRE(!first_failure.empty());","+\t\treturn first_failure + \" StatementEnd failed\";","+\t}","+","+\t//! Every state saw the statement begin and end once, and the query end once with the first failure","+\tvoid RequireEndedOnce() {","+\t\tForEachState([&](FailingStatementEndState &state) {","+\t\t\tREQUIRE(state.statement_begins == 1);","+\t\t\tREQUIRE(state.statement_ends == 1);","+\t\t\tREQUIRE(state.query_ends == 1);","+\t\t\tREQUIRE(state.query_end_errors.size() == 1);","+\t\t\tREQUIRE_THAT(state.query_end_errors[0], Contains(FirstError()));","+\t\t});","+\t\tREQUIRE(!conn.context->transaction.HasActiveTransaction());","+\t}","+","+\tConnection &conn;","+\tidx_t failures_left = 0;","+\tstring first_failure;","+\tbool fatal_after_first = false;","+\tshared_ptr<FailingStatementEndState> alpha;","+\tshared_ptr<FailingStatementEndState> beta;","+};","+","+} // namespace","+","+TEST_CASE(\"A failing StatementEnd ends the query on every state\", \"[api]\") {","+\tDuckDB db(nullptr);","+\tConnection conn(db);","+\tREQUIRE_NO_FAIL(conn.Query(\"CREATE TABLE t(i INT)\"));","+\tFailingStatementEnds test(conn);","+","+\tSECTION(\"Query reports the failure and rolls the statement back\") {","+\t\ttest.failures_left = 1;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"INSERT INTO t VALUES (1)\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE_THAT(result->GetError(), Contains(test.FirstError()));","+\t\ttest.RequireEndedOnce();","+\t\t// the state that did not fail saw a statement without error","+\t\tREQUIRE(test.alpha->statement_end_errors + test.beta->statement_end_errors == 0);","+","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t\tauto count = conn.Query(\"SELECT count(*) FROM t\");","+\t\tREQUIRE(CHECK_COLUMN(count, 0, {0}));","+\t}","+","+\tSECTION(\"Every state fails\") {","+\t\ttest.failures_left = 2;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"SELECT 42\"));","+\t\tREQUIRE(result->HasError());","+\t\t// the first failure is the one reported, also to the states","+\t\tREQUIRE_THAT(result->GetError(), Contains(test.FirstError()));","+\t\ttest.RequireEndedOnce();","+\t\tREQUIRE(test.failures_left == 0);","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t}","+","+\tSECTION(\"A statement that failed keeps its own error\") {","+\t\ttest.failures_left = 1;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"SELECT * FROM missing_table\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE_THAT(result->GetError(), Contains(\"missing_table\"));","+\t\ttest.ForEachState([](FailingStatementEndState &state) {","+\t\t\tREQUIRE(state.statement_ends == 1);","+\t\t\tREQUIRE(state.statement_end_errors == 1);","+\t\t\tREQUIRE(state.query_ends == 1);","+\t\t\tREQUIRE(state.query_end_errors.size() == 1);","+\t\t\tREQUIRE_THAT(state.query_end_errors[0], Contains(\"missing_table\"));","+\t\t});","+\t\tREQUIRE(!conn.context->transaction.HasActiveTransaction());","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t}","+","+\tSECTION(\"Stepping with ExecuteTask ends the query\") {","+\t\tauto handle = conn.Submit(\"SELECT 42\");","+\t\tREQUIRE_NO_FAIL(*handle);","+\t\thandle->Materialize();","+\t\ttest.failures_left = 1;","+\t\tQueryResultState state = QueryResultState::NOT_READY;","+\t\tREQUIRE_NOTHROW([&]() {","+\t\t\twhile (!IsTerminal(state = handle->ExecuteTask())) {","+\t\t\t\tif (state == QueryResultState::BLOCKED || state == QueryResultState::NO_TASKS_AVAILABLE) {","+\t\t\t\t\thandle->WaitForTask();","+\t\t\t\t}","+\t\t\t}","+\t\t}());","+\t\tREQUIRE(state == QueryResultState::EXECUTION_ERROR);","+\t\tREQUIRE(handle->HasError());","+\t\tREQUIRE_THAT(handle->GetError(), Contains(test.FirstError()));","+\t\ttest.RequireEndedOnce();","+\t\t// the connection is free before the handle is destroyed","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t}","+","+\tSECTION(\"A statement that wrote aborts its explicit transaction\") {","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE'\"));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"BEGIN\"));","+\t\ttest.ResetCounts();","+\t\t// an error of a kind that would leave the transaction valid","+\t\ttest.FailWithBinderError();","+\t\ttest.failures_left = 1;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"INSERT INTO t VALUES (1)\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE_THAT(result->GetError(), Contains(\"StatementEnd failed\"));","+\t\ttest.ForEachState([](FailingStatementEndState &state) {","+\t\t\tREQUIRE(state.statement_ends == 1);","+\t\t\tREQUIRE(state.query_ends == 1);","+\t\t});","+\t\t// the row cannot be committed, since the statement reported a failure","+\t\tREQUIRE(conn.context->transaction.HasActiveTransaction());","+\t\tREQUIRE_FAIL(conn.Query(\"SELECT 42\"));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"ROLLBACK\"));","+\t\tauto count = conn.Query(\"SELECT count(*) FROM t\");","+\t\tREQUIRE(CHECK_COLUMN(count, 0, {0}));","+\t}","+","+\tSECTION(\"A statement that read follows the invalidation policy\") {","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE'\"));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"BEGIN\"));","+\t\ttest.FailWithBinderError();","+\t\ttest.failures_left = 1;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"SELECT 42\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE_THAT(result->GetError(), Contains(\"StatementEnd failed\"));","+\t\t// a binder error does not invalidate the transaction under this policy","+\t\tREQUIRE(conn.context->transaction.HasActiveTransaction());","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"COMMIT\"));","+","+\t\t// an IO error does","+\t\tREQUIRE_NO_FAIL(conn.Query(\"BEGIN\"));","+\t\ttest.ForEachState([](FailingStatementEndState &state) { state.fail_with_binder_error = false; });","+\t\ttest.failures_left = 1;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"SELECT 42\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE(conn.context->transaction.HasActiveTransaction());","+\t\tREQUIRE_FAIL(conn.Query(\"SELECT 42\"));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"ROLLBACK\"));","+\t}","+","+\tSECTION(\"The error is processed like the error of a statement\") {","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SET errors_as_json = true\"));","+\t\ttest.failures_left = 1;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"SELECT 42\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE_THAT(result->GetError(), Contains(\"\\\"exception_type\\\":\\\"IO\\\"\"));","+\t\tREQUIRE_THAT(result->GetError(), Contains(test.FirstError()));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t}","+","+\tSECTION(\"Between the statements of a query that expands into several\") {","+\t\tREQUIRE_NO_FAIL(conn.Query(\"CREATE TABLE sales(city VARCHAR, year INTEGER, amount INTEGER)\"));","+\t\tREQUIRE_NO_FAIL(conn.Query(\"INSERT INTO sales VALUES ('ams', 2023, 10), ('ams', 2024, 20)\"));","+\t\ttest.ResetCounts();","+\t\t// the dynamic PIVOT runs a statement for the distinct years before the one that returns the rows","+\t\ttest.failures_left = 1;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"PIVOT sales ON year USING sum(amount) ORDER BY city\"));","+\t\tREQUIRE(result->HasError());","+\t\tREQUIRE_THAT(result->GetError(), Contains(\"StatementEnd failed\"));","+\t\t// the end that failed is not sent again when the query fails","+\t\ttest.RequireEndedOnce();","+\t\tREQUIRE_NO_FAIL(conn.Query(\"SELECT 42\"));","+\t}","+}","+","+TEST_CASE(\"Destroying a connection whose StatementEnd keeps failing does not terminate\", \"[api]\") {","+\tDuckDB db(nullptr);","+\t{","+\t\tConnection conn(db);","+\t\tFailingStatementEnds test(conn);","+\t\ttest.failures_left = 3;","+\t\tunique_ptr<QueryResult> result;","+\t\tREQUIRE_NOTHROW(result = conn.Query(\"SELECT 42\"));","+\t\tREQUIRE(result->HasError());","+\t\ttest.RequireEndedOnce();","+\t\t// the query ended, so destroying the connection has nothing to end","+\t}","+\t{","+\t\tConnection conn(db);","+\t\tFailingStatementEnds test(conn);","+\t\tauto handle = conn.Submit(\"SELECT 42\");","+\t\tREQUIRE_NO_FAIL(*handle);","+\t\ttest.failures_left = 3;","+\t\t// the open result keeps the query active while the context is destroyed","+\t\tREQUIRE_NOTHROW(conn.context->Destroy());","+\t\ttest.ForEachState([](FailingStatementEndState &state) { REQUIRE(state.statement_ends == 1); });","+\t\tREQUIRE(!conn.context->transaction.HasActiveTransaction());"],"additions":285,"deletions":0,"truncated":false}],"additions":434,"deletions":33,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-06T17:02:17.432683+00:00"}