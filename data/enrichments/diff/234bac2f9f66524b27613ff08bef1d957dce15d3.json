{"id":"234bac2f9f66524b27613ff08bef1d957dce15d3","axis":"silent","repo":"directus/directus","sha":"234bac2f9f66524b27613ff08bef1d957dce15d3","parsed":{"files":[{"path":".changeset/brave-moons-argue.md","lines":["@@ -0,0 +1,15 @@","+---","+'@directus/api': patch","+'@directus/storage-driver-cloudinary': major","+'@directus/storage-driver-s3': major","+'@directus/storage-driver-local': major","+'@directus/storage-driver-supabase': major","+'@directus/storage-driver-azure': patch","+'@directus/storage-driver-gcs': patch","+---","+","+::: notice","+`exists()` now throws when the lookup itself fails, for example on a timeout, a connection error or rejected credentials, instead of also reporting `false`. Callers that relied on a `false` result for any failure need to handle the error. Note that S3 answers 403 rather than 404 for a missing object when the credentials cannot list the bucket, so granting `s3:ListBucket` is needed to keep getting a clean \"missing\" answer.","+:::","+","+Fixed storage connections leaking when asset requests were cancelled or a transformation failed, which eventually made every asset request return a permission error until Directus was restarted"],"additions":15,"deletions":0,"truncated":false},{"path":"api/src/controllers/assets.test.ts","lines":["@@ -0,0 +1,169 @@","+import { createServer, type Server } from 'node:http';","+import type { AddressInfo } from 'node:net';","+import { PassThrough } from 'node:stream';","+import express from 'express';","+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';","+import { getRouteHandler } from '../test-utils/controllers.js';","+","+const { getAsset } = vi.hoisted(() => ({ getAsset: vi.fn() }));","+","+vi.mock('../database/index.js', async () => {","+\tconst { mockDatabase } = await import('../test-utils/database.js');","+\treturn mockDatabase();","+});","+","+vi.mock('../logger/index.js', () => ({","+\tuseLogger: () => ({ error: vi.fn(), warn: vi.fn(), info: vi.fn(), debug: vi.fn(), trace: vi.fn() }),","+}));","+","+vi.mock('../middleware/is-locked.js', () => ({","+\tdefault: () => (_req: unknown, _res: unknown, next: () => void) => next(),","+}));","+","+vi.mock('../services/payload.js', () => ({ PayloadService: vi.fn() }));","+vi.mock('../services/files.js', () => ({ FilesService: vi.fn() }));","+vi.mock('../permissions/modules/validate-access/validate-access.js', () => ({ validateAccess: vi.fn() }));","+vi.mock('../services/assets.js', () => ({ AssetsService: vi.fn(() => ({ getAsset })) }));","+","+const { default: router } = await import('./assets.js');","+","+function deferred<T = void>() {","+\tlet resolve!: (value: T) => void;","+\tconst promise = new Promise<T>((r) => (resolve = r));","+\treturn { promise, resolve };","+}","+","+/**","+ * Mounts only the final \"return file\" handler of `GET /:pk/:filename?`, with the response `locals`","+ * the preceding query validation middleware would have set.","+ */","+function createApp() {","+\tconst handlers = getRouteHandler(router, 'GET', '/:pk/:filename?');","+","+\t// Retarget deliberately: only the last layer serves the file","+\texpect(handlers).toHaveLength(3);","+","+\tconst returnFile = handlers.at(-1)!;","+","+\tconst closed = deferred();","+","+\tconst app = express();","+","+\tapp.get(","+\t\t'/:pk',","+\t\t(_req, res, next) => {","+\t\t\tres.locals['shortcuts'] = [];","+\t\t\tres.locals['transformation'] = {};","+\t\t\t// Registered before the handler runs, so it always fires first","+\t\t\tres.on('close', () => closed.resolve());","+\t\t\tnext();","+\t\t},","+\t\t(req, res, next) => returnFile.handle(req, res, next),","+\t);","+","+\treturn { app, closed: closed.promise };","+}","+","+let server: Server;","+","+async function listen(app: express.Express) {","+\tserver = createServer(app);","+\tawait new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));","+\treturn `http://127.0.0.1:${(server.address() as AddressInfo).port}`;","+}","+","+beforeEach(() => {","+\tvi.clearAllMocks();","+});","+","+afterEach(async () => {","+\tif (server?.listening) {","+\t\tserver.closeAllConnections();","+\t\tawait new Promise((resolve) => server.close(resolve));","+\t}","+});","+","+describe('GET /:pk/:filename?', () => {","+\t/**","+\t * The storage stream holds a socket from the driver's connection pool. If the client disconnects","+\t * while the stream is still being opened, nothing consumes or destroys it, so the socket stays","+\t * checked out of the agent forever. Once `maxSockets` worth of them accumulate, every subsequent","+\t * storage call starves and times out, which `exists()` turns into a bare 403 for every asset.","+\t */","+\ttest('destroys the storage stream when the client disconnects while the stream is being opened', async () => {","+\t\tconst sourceStream = new PassThrough();","+\t\tsourceStream.write('some-image-bytes');","+","+\t\tconst streamRequested = deferred();","+\t\tconst releaseStream = deferred();","+","+\t\tgetAsset.mockImplementation(async () => ({","+\t\t\tfile: { id: 'file-1', type: 'image/webp', filename_download: 'file-1.webp' },","+\t\t\tstat: { size: 16 },","+\t\t\tstream: async () => {","+\t\t\t\tstreamRequested.resolve();","+\t\t\t\tawait releaseStream.promise;","+\t\t\t\treturn sourceStream;","+\t\t\t},","+\t\t}));","+","+\t\tconst { app, closed } = createApp();","+\t\tconst url = await listen(app);","+","+\t\tconst controller = new AbortController();","+\t\tconst request = fetch(`${url}/00000000-0000-0000-0000-000000000000`, { signal: controller.signal });","+","+\t\t// Disconnect mid-flight: after the storage stream was requested, before it resolved","+\t\tawait streamRequested.promise;","+\t\tcontroller.abort();","+\t\tawait expect(request).rejects.toThrowError(expect.objectContaining({ name: 'AbortError' }));","+\t\tawait closed;","+","+\t\treleaseStream.resolve();","+\t\tawait vi.waitFor(() => expect(sourceStream.destroyed).toBe(true));","+\t});","+","+\ttest('serves the whole body to a client that stays connected', async () => {","+\t\tconst sourceStream = new PassThrough();","+\t\tsourceStream.end('some-image-bytes');","+","+\t\tgetAsset.mockImplementation(async () => ({","+\t\t\tfile: { id: 'file-1', type: 'image/webp', filename_download: 'file-1.webp' },","+\t\t\tstat: { size: 16 },","+\t\t\tstream: async () => sourceStream,","+\t\t}));","+","+\t\tconst { app } = createApp();","+\t\tconst url = await listen(app);","+","+\t\tconst response = await fetch(`${url}/00000000-0000-0000-0000-000000000000`);","+","+\t\texpect(response.status).toBe(200);","+\t\tawait expect(response.text()).resolves.toBe('some-image-bytes');","+\t});","+","+\ttest('destroys the storage stream when the client disconnects while the body is being piped', async () => {","+\t\tconst sourceStream = new PassThrough();","+\t\t// Enough to flush the response headers, less than the announced size so the body stays open","+\t\tsourceStream.write('some-image-bytes');","+","+\t\tgetAsset.mockImplementation(async () => ({","+\t\t\tfile: { id: 'file-1', type: 'image/webp', filename_download: 'file-1.webp' },","+\t\t\tstat: { size: 1024 },","+\t\t\tstream: async () => sourceStream,","+\t\t}));","+","+\t\tconst { app, closed } = createApp();","+\t\tconst url = await listen(app);","+","+\t\tconst controller = new AbortController();","+\t\tconst response = await fetch(`${url}/00000000-0000-0000-0000-000000000000`, { signal: controller.signal });","+","+\t\texpect(response.status).toBe(200);","+","+\t\tcontroller.abort();","+\t\tawait closed;","+","+\t\tawait vi.waitFor(() => expect(sourceStream.destroyed).toBe(true));","+\t});","+});"],"additions":169,"deletions":0,"truncated":false},{"path":"api/src/controllers/assets.ts","lines":["@@ -18,6 +18,7 @@ import { AssetsService } from '../services/assets.js';"," import { FilesService } from '../services/files.js';"," import { PayloadService } from '../services/payload.js';"," import asyncHandler from '../utils/async-handler.js';","+import { de