t');","         }"," ","-        try {","-            $currentThumbnailsValue = $this->configurationManager->getLocalConfigurationValueByPath('GFX/thumbnails');","-        } catch (MissingArrayPathException) {","-            $currentThumbnailsValue = $this->configurationManager->getDefaultConfigurationValueByPath('GFX/thumbnails');","-        }","-","         if (!$currentEnabledValue) {","             if ($currentPathValue != '') {","                 $changedValues['GFX/processor_path'] = '';","@@ -553,9 +549,6 @@ protected function disableImageMagickDetailSettingsIfImageMagickIsDisabled(): vo","             if ($currentImageFileExtValue !== 'gif,jpg,jpeg,png') {","                 $changedValues['GFX/imagefile_ext'] = 'gif,jpg,jpeg,png';","             }","-            if ($currentThumbnailsValue != 0) {","-                $changedValues['GFX/thumbnails'] = 0;","-            }","         }","         if (!empty($changedValues)) {","             $this->configurationManager->setLocalConfigurationValuesByPathValuePairs($changedValues);"],"additions":2,"deletions":9,"truncated":false},{"path":"typo3/sysext/core/Configuration/DefaultConfiguration.php","lines":["@@ -38,7 +38,6 @@","         ],","     ],","     'GFX' => [ // Configuration of the image processing features in TYPO3. 'IM' and 'GD' are short for ImageMagick and GD library respectively.","-        'thumbnails' => true,","         'imagefile_ext' => 'gif,jpg,jpeg,tif,tiff,bmp,pcx,tga,png,pdf,ai,svg,webp,avif',","         'imageFileConversionFormats' => [","             // Default \"pass through\" web formats"],"additions":0,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Configuration/DefaultConfigurationDescription.yaml","lines":["@@ -3,9 +3,6 @@ GFX:","     type: container","     description: 'Image Processing'","     items:","-        thumbnails:","-            type: bool","-            description: 'Enables the use of thumbnails in the backend interface.'","         imagefile_ext:","             type: list","             description: 'Commalist of file extensions perceived as images by TYPO3. List should be set to \"gif,png,jpeg,jpg\" if ImageMagick is not available. Lowercase and no spaces between! To configure default conversion formats, please manually configure the extra array \"imageFileConversionFormats\" in settings.php.'"],"additions":0,"deletions":3,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Breaking-111108-ThumbnailsSettingRemoved.rst","lines":["@@ -0,0 +1,48 @@","+..  include:: /Includes.rst.txt","+","+..  _breaking-111108-1792227470:","+","+==================================================","+Breaking: #111108 - GFX setting thumbnails removed","+==================================================","+","+See :issue:`111108`","+","+Description","+===========","+","+The setting :php:`$GLOBALS['TYPO3_CONF_VARS']['GFX']['thumbnails']` has been","+removed. It is removed from :file:`config/system/settings.php` on upgrade.","+","+The setting turned off thumbnails of images in the page module, in the file","+references of records, in the file list, the file browser and the link","+browser. The rest of the backend, for example the clipboard, the metadata of","+files, the live search and the workspaces module, showed thumbnails","+regardless of it.","+","+The backend now shows thumbnails of images everywhere. Whether the file list,","+the file browser and the link browser show them is still chosen by every user.","+In the file list, :typoscript:`options.file_list.enableDisplayThumbnails` in","+user TSconfig still controls that choice.","+","+Impact","+======","+","+Installations that had turned thumbnails off show thumbnails of images in the","+page module, in the file references of records and, where users choose so, in","+the file list, the file browser and the link browser.","+","+Affected installations","+======================","+","+Installations whose :file:`config/system/settings.php` sets","+:php:`$GLOBALS['TYPO3_CONF_VARS']['GFX']['thumbnails']` to `false`, and","+extensions that read the setting. The extension scanner reports them.","+","+Migration","+=========","+","+None for installations, the upgrade removes the setting. Extensions that read","+it drop that condition.","+","+..  index:: Backend, LocalConfiguration, FullyScanned, ext:backend, ext:filelist"],"additions":48,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Service/SilentConfigurationUpgradeServiceTest.php","lines":["@@ -274,7 +274,6 @@ public function disableImageMagickDetailSettingsIfImageMagickIsDisabled(): void","             'GFX' => [","                 'processor_enabled' => false,","                 'imagefile_ext' => 'gif,jpg,png',","-                'thumbnails' => 0,","             ],","         ];","         $configurationManager = $this->get(ConfigurationManager::class);","@@ -767,4 +766,22 @@ public function obsoleteLangParserSettingIsRemoved(): void","             self::assertArrayNotHasKey('parser', $settings['SYS']['lang']);","         }","     }","+","+    #[Test]","+    public function obsoleteThumbnailsSettingIsRemoved(): void","+    {","+        $configurationManager = $this->get(ConfigurationManager::class);","+        $configurationManager->updateLocalConfiguration(['GFX' => ['thumbnails' => 0]]);","+","+        $subject = $this->get(SilentConfigurationUpgradeService::class);","+        $exceptionCaught = false;","+        try {","+            $subject->execute();","+        } catch (ConfigurationChangedException) {","+            $exceptionCaught = true;","+        } finally {","+            self::assertTrue($exceptionCaught);","+            self::assertArrayNotHasKey('thumbnails', $configurationManager->getLocalConfiguration()['GFX']);","+        }","+    }"," }"],"additions":18,"deletions":1,"truncated":false},{"path":"typo3/sysext/filelist/Classes/Controller/FileListController.php","lines":["@@ -309,7 +309,7 @@ protected function initializeFileList(ServerRequestInterface $request): void","         // Create the file list","         $this->filelist = GeneralUtility::makeInstance(FileList::class, $request);","         $this->filelist->viewMode = ViewMode::tryFrom($this->moduleData->get('viewMode')) ?? ViewMode::TILES;","-        $this->filelist->thumbs = ($GLOBALS['TYPO3_CONF_VARS']['GFX']['thumbnails'] ?? false) && $this->moduleData->get('displayThumbs');","+        $this->filelist->thumbs = (bool)$this->moduleData->get('displayThumbs');"," ","         // Create clipboard object and initialize it","         $CB = array_replace_recursive($request->getQueryParams()['CB'] ?? [], $request->getParsedBody()['CB'] ?? []);","@@ -507,7 +507,7 @@ protected function registerAdditionalDocHeaderButtons(): void","             ->setLabel($lang->sL('LLL:EXT:core/Resources/Private/Language/locallang_core.xlf:labels.view.list'))","             ->setIcon($this->iconFactory->getIcon('actions-viewmode-list'));","         $viewModeItems[] = $this->componentFactory->createDropDownDivider();","-        if ($GLOBALS['TYPO3_CONF_VARS']['GFX']['thumbnails'] && ($this->getBackendUser()->getTSConfig()['options.']['file_list.']['enableDisplayThumbnails'] ?? '') === 'selectable') {","+        if (($this->getBackendUser()->getTSConfig()['options.']['file_list.']['enableDisplayThumbnails'] ?? '') === 'selectable') {","             $viewModeItems[] = $this->componentFactory->createDropDownToggle()","                 ->setActive((bool)$this->moduleData->get('displayThumbs'))","                 ->setHref($this->filelist->createModuleUri(['displayThumbs' => $this->moduleData->get('displayThumbs') ? 0 : 1]))"],"additions":2,"deletions":2,"truncated":false},{"path":"typo3/sysext/filelist/Classes/ElementBrowser/AbstractResourceBrowser.php","lines":["@@ -123,7 +123,7 @@ protected function initVariables(ServerRequestInterface $request): void"," ","         $this->filelist = GeneralUtility::makeInstance(FileList::class, $this->getRequest());","         $this->filelist->viewMode = $this->viewMode;","-        $this->filelist->thumbs = ($GLOBALS['TYPO3_CONF_VARS']['GFX']['thumbnails'] ?? false) && $this->displayThumbs;","+        $this->filelist->thumbs = $this->displayThumbs;","     }"," ","     /**"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/filelist/Classes/LinkHandler/AbstractResourceLinkHandler.php","lines":["@@ -197,7 +197,7 @@ public function initializeVariables(ServerRequestInterface $request): void"," ","         $this->filelist = GeneralUtility::makeInstance(FileList::class, $request);","         $this->filelist->viewMode = $this->viewMode;","-        $this->filelist->thumbs = ($GLOBALS['TYPO3_CONF_VARS']['GFX']['thumbnails'] ?? false) && $this->displayThumbs;","+        $this->filelist->thumbs = $this->displayThumbs;","     }"," ","     public function modifyLinkAttributes(array $fieldDefinitions): array"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/install/Configuration/ExtensionScanner/Php/ArrayDimensionMatcher.php","lines":["@@ -1378,4 +1378,9 @@","             'Breaking-109783-DeprecatedFunctionalityRemoved.rst',","         ],","     ],","+    '$GLOBALS[\\'TYPO3_CONF_VARS\\'][\\'GFX\\'][\\'thumbnails\\']' => [","+        'restFiles' => [","+            'Breaking-111108-ThumbnailsSettingRemoved.rst',","+        ],","+    ],"," ];",""],"additions":5,"deletions":0,"truncated":false}],"additions":116,"deletions":61,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-18T13:01:09.227077+00:00"}