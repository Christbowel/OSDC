ers: {","+          [name: string]: unknown","+        }","+        content?: never","+      }","+      /** @description Unexpected error while restarting pipeline. */","+      500: {","+        headers: {","+          [name: string]: unknown","+        }","+        content?: never","+      }","+    }","+  }","   ReplicationPipelinesController_getPipelineStatus: {","     parameters: {","       query?: never",""],"additions":78,"deletions":0,"truncated":false}],"additions":157,"deletions":45,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-08-07T08:37:21.434553+00:00"}