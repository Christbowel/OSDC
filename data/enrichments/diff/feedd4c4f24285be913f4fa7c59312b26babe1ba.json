32(&session->active_tasks); /* last: at zero the event thread can free the session */","     return NULL;"," }"," "],"additions":4,"deletions":6,"truncated":false},{"path":"modules/http3/h3_threads.c","lines":["@@ -103,7 +103,7 @@ void* APR_THREAD_FUNC h3_event_thread(apr_thread_t* thread, void* data)","             } while (pumped > 0 && ++pump_rounds < H3_PUMP_BUDGET);","         }"," ","-        if (io->thread_running && !io->draining)","+        if (io->thread_running)","         {","             for (;;)","             {","@@ -112,6 +112,11 @@ void* APR_THREAD_FUNC h3_event_thread(apr_thread_t* thread, void* data)","                 {","                     break;","                 }","+                if (io->draining)","+                {","+                    h3q_conn_free(conn); /* no new connections during a graceful stop */","+                    continue;","+                }","                 ap_log_error(APLOG_MARK, APLOG_INFO, 0, io->server, \"accepted new QUIC connection\");","                 if (h3_io_at_connection_limit(io))","                 {"],"additions":6,"deletions":1,"truncated":false},{"path":"modules/http3/quic/h3q_conn.c","lines":["@@ -590,14 +590,14 @@ void h3q_conn_free(h3q_conn* conn)","             break;","         }","     }","-    for (h3q_conn** slot = &engine->accept_head; *slot; slot = &(*slot)->next_accept)","+    for (h3q_conn *prev = NULL, **slot = &engine->accept_head; *slot; prev = *slot, slot = &(*slot)->next_accept)","     {","         if (*slot == conn)","         {","             *slot = conn->next_accept;","-            if (!*slot)","+            if (engine->accept_tail == conn)","             {","-                engine->accept_tail = NULL;","+                engine->accept_tail = prev;","             }","             break;","         }"],"additions":3,"deletions":3,"truncated":false},{"path":"modules/http3/quic/h3q_stream.c","lines":["@@ -241,14 +241,14 @@ void h3q_stream_free(h3q_stream* st)","             bre