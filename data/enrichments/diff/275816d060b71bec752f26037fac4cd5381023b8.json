{"id":"275816d060b71bec752f26037fac4cd5381023b8","axis":"silent","repo":"vllm-project/vllm","sha":"275816d060b71bec752f26037fac4cd5381023b8","parsed":{"files":[{"path":"docs/features/quantization/online.md","lines":["@@ -52,6 +52,7 @@ vllm serve Qwen/Qwen3.5-35B-A3B --quantization mxfp4 \\"," | `fp8_per_block` | fp8_e4m3 data, fp32 per-128x128-block scale | fp8_e4m3 data, fp32 per-1x128-block scale | |"," | `mxfp8` | fp8_e4m3 data, e8m0 per-1x32-block scale | fp8_e4m3 data, e8m0 per-1x32-block scale | Requires SM 100+ (Blackwell or newer) for w8a8, other GPUs use a w8a16 fallback |"," | `mxfp4` | fp4_e2m1 data, e8m0 per-1x32-block scale ([OCP MX specs](https://www.opencompute.org/documents/ocp-microscaling-formats-mx-v1-0-spec-final-pdf)) | - linear: fp4_e2m1 data, e8m0 per-1x32-block scale in some backends, or BF16. <br> - MOE: fp4_e2m1 data, e8m0 per-1x32-block scale. | Linear MXFP4 backend is auto-selected per platform, not enforcing activation dtype. Some use BF16 activation. Use `--linear-backend` to pin one (e.g. `--linear-backend flashinfer`). |","+| `mxfp4_hadamard32` | `mxfp4`, with the weight rotated along its input dimension by a 32-wide block Hadamard matrix before quantization | `mxfp4`, with activations rotated by the same matrix before quantization | Linear only. The rotation is orthogonal, so the GEMM is unchanged up to quantization error, which it shrinks by spreading outliers across each 32-element block. The activation rotation runs in PyTorch before the selected MXFP4 linear backend. |"," "," ## Advanced Configuration"," ","@@ -64,6 +65,7 @@ quantization_config:","   linear:","     weight: <name>      # see QUANT_KEY_NAMES in vllm/config/quantization.py","     activation: <name>","+    hadamard_size: 32   # optional power of two, so far mxfp4 only: see `mxfp4_hadamard32`","   moe:","     weight: <name>","     activation: <name>","@@ -226,7 +228,7 @@ llm = LLM("," "," ### Fine-Grained Per-Layer Quantization Schemes"," ","-Use the `targets` parameter to apply different online shorthands to different layers, instead of one scheme applied everywhere via `linear`/`moe`. Keys are exact layer names, regex patterns (prefixed with `re:`), or patterns understood by [`fnmatch.fnmatch`](https://docs.python.org/3/library/fnmatch.html#fnmatch.fnmatch); values are shorthand names (`fp8_per_tensor`, `fp8_per_block`, `fp8_per_channel`, `mxfp8`, `int8_per_channel_weight_only`, `nvfp4_per_token`).","+Use the `targets` parameter to apply different online shorthands to different layers, instead of one scheme applied everywhere via `linear`/`moe`. Keys are exact layer names, regex patterns (prefixed with `re:`), or patterns understood by [`fnmatch.fnmatch`](https://docs.python.org/3/library/fnmatch.html#fnmatch.fnmatch); values are shorthand names (`fp8_per_tensor`, `fp8_per_block`, `fp8_per_channel`, `mxfp8`, `mxfp4`, `mxfp4_hadamard32`, `int8_per_channel_weight_only`, `nvfp4_per_token`)."," "," Example:"," "],"additions":3,"deletions":1,"truncated":false},{"path":"tests/quantization/test_input_hadamard.py","lines":["@@ -0,0 +1,257 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Tests for `InputHadamardLinearMethod`, the format-agnostic block Hadamard","+rotation of linear-layer inputs.\"\"\"","+","+import pytest","+import torch","+","+from vllm.config.model import ModelConfig","+from vllm.model_executor.kernels.linear.mxfp4.aiter import AiterMxfp4LinearKernel","+from vllm.model_executor.kernels.linear.mxfp4.base import MxFp4LinearLayerConfig","+from vllm.model_executor.kernels.linear.mxfp4.emulation import (","+    EmulationMxfp4LinearKernel,","+)","+from vllm.model_executor.layers.linear import LinearMethodBase","+from vllm.model_executor.layers.quantization.input_hadamard import (","+    InputHadamardLinearMethod,","+    block_hadamard_rotate,","+    hadamard_matrix,","+)","+from vllm.model_executor.layers.quantization.online.mxfp4 import (","+    Mxfp4OnlineLinearMethod,","+)","+from vllm.model_executor.layers.quantization.utils.quant_utils import kMxfp4Dynamic","+from vllm.model_executor.model_loader.reload.layerwise import (","+    finalize_layerwise_reload,","+    initialize_layerwise_reload,","+    record_metadata_for_reloading,","+)","+from vllm.model_executor.model_loader.weight_utils import default_weight_loader","+from vllm.model_executor.utils import replace_parameter, set_weight_attrs","+from vllm.platforms import current_platform","+from vllm.utils.torch_utils import set_random_seed","+","+","+@pytest.mark.parametrize(\"size\", [16, 32, 64])","+def test_block_hadamard_rotate_preserves_products(size: int):","+    h = hadamard_matrix(size, torch.device(\"cpu\"))","+    torch.testing.assert_close(h @ h.T, torch.eye(size))","+    assert torch.equal(h.abs(), torch.full_like(h, size**-0.5))","+","+    x = torch.randn(8, 256, dtype=torch.float64)","+    w = torch.randn(16, 256, dtype=torch.float64)","+    torch.testing.assert_close(","+        block_hadamard_rotate(x, h).double() @ block_hadamard_rotate(w, h).double().T,","+        x @ w.T,","+        rtol=1e-5,","+        atol=1e-5,","+    )","+","+","+class _DenseOnlineMethod(LinearMethodBase):","+    \"\"\"Stand-in for an online method: plain fp32 GEMM that, like the online","+    methods, flags the layer once it has processed the weight.\"\"\"","+","+    def create_weights(","+        self,","+        layer,","+        input_size_per_partition,","+        output_partition_sizes,","+        input_size,","+        output_size,","+        params_dtype,","+        **extra_weight_attrs,","+    ):","+        weight = torch.nn.Parameter(","+            torch.zeros(sum(output_partition_sizes), input_size_per_partition),","+            requires_grad=False,","+        )","+        set_weight_attrs(weight, extra_weight_attrs)","+        layer.register_parameter(\"weight\", weight)","+","+    def process_weights_after_loading(self, layer):","+        if getattr(layer, \"_already_called_process_weights_after_loading\", False):","+            return","+        layer.processed_weight = layer.weight.detach().clone()","+        layer._already_called_process_weights_after_loading = True","+","+    def apply(self, layer, x, bias=None):","+        return x @ layer.weight.T","+","+","+def _make_layer(","+    rotate_weight: bool, input_size: int = 128, output_size: int = 16, size: int = 32","+) -> tuple[torch.nn.Module, InputHadamardLinearMethod]:","+    layer = torch.nn.Module()","+    layer.weight_loader = \"v1\"","+    method = InputHadamardLinearMethod(_DenseOnlineMethod(), size, rotate_weight)","+    method.create_weights(","+        layer,","+        input_size,","+        [output_size],","+        input_size,","+        output_size,","+        torch.float32,","+        weight_loader=\"v2\",","+    )","+    return layer, method","+","+","+def test_rotates_weight_once_and_input_on_apply():","+    layer, method = _make_layer(rotate_weight=True)","+    assert layer.weight.weight_loader == \"v1\", \"wrapped v1 methods keep the v1 loader\"","+    assert not hasattr(layer, \"input_rotation\")","+    set_random_seed(0)","+    w = torch.randn(16, 128)","+    x = torch.randn(4, 128)","+    layer.weight.data.copy_(w)","+","+    method.process_weights_after_loading(layer)","+    method.process_weights_after_loading(layer)  # e.g. after layerwise loading","+","+    h = hadamard_matrix(32, w.device)","+    torch.testing.assert_close(layer.processed_weight, block_hadamard_rotate(w, h))","+    torch.testing.assert_close(method.apply(layer, x), x @ w.T, rtol=1e-4, atol=1e-4)","+","+","+def test_checkpoint_rotation_is_checked_and_dropped():","+    layer, method = _make_layer(rotate_weight=False)","+    set_random_seed(0)","+    w = torch.randn(16, 128)","+    x = torch.randn(4, 128)","+    h = hadamard_matrix(32, w.device)","+    layer.weight.data.copy_(block_hadamard_rotate(w, h))","+    signs = (h * 32**0.5).round().to(torch.int8)","+    layer.input_rotation.weight_loader(layer.input_rotation, signs)","+","+    method.process_weights_after_loading(layer)","+","+    assert not hasattr(layer, \"input_rotation\")","+    torch.testing.assert_close(method.apply(layer, x), x @ w.T, rtol=1e-4, atol=1e-4)","+","+","+def test_rejects_non_sylvester_and_missing_rotation():","+    layer, method = _make_layer(rotate_weight=False)","+    flipped = (hadamard_matrix(32, torch.device(\"cpu\")) * 32**0.5).round()","+    flipped[0] = -flipped[0]","+    with pytest.raises(NotImplementedError, match=\"Sylvester\"):","+        layer.input_rotation.weight_loader(layer.input_rotation, flipped.to(torch.int8))","+    with pytest.raises(ValueError, match=\"input_rotation\"):","+        method.process_weights_after_loading(layer)","+","+","+@pytest.mark.parametrize(\"rotate_weight\", [True, False])","+def test_layerwise_reload(rotate_weight: bool, default_vllm_config):","+    \"\"\"Reloading reruns the weight rotation, or the input_rotation check and","+    drop, on the new weights, and keeps the processed tensors in place.\"\"\"","+    default_vllm_config.model_config = ModelConfig()","+    layer = torch.nn.Module()","+    layer.weight_loader = default_weight_loader","+    method = InputHadamardLinearMethod(_DenseOnlineMethod(), 32, rotate_weight)","+    method.create_weights(","+        layer, 128, [16], 128, 16, torch.float32, weight_loader=default_weight_loader","+    )","+    layer.quant_method = method","+    model = torch.nn.Sequential(layer)","+    record_metadata_for_reloading(model)","+    h = hadamard_matrix(32, torch.device(\"cpu\"))","+    signs = (h * 32**0.5).round().to(torch.int8)","+","+    def load(w: torch.Tensor) -> None:","+        layer.weight.weight_loader(","+            layer.weight, w if rotate_weight else block_hadamard_rotate(w, h)","+        )","+        if not rotate_weight:","+            layer.input_rotation.weight_loader(layer.input_rotation, signs)","+","+    set_random_seed(0)","+    load(torch.randn(16, 128))","+    method.process_weights_after_loading(layer)","+    weight = layer.weight","+    w = torch.randn(16, 128)","+    x = torch.randn(4, 128)","+","+    initialize_layerwise_reload(model)","+    load(w)","+    finalize_layerwise_reload(model, default_vllm_config.model_config)","+","+    assert layer.weight is weight","+    assert not hasattr(layer, \"input_rotation\")","+    torch.testing.assert_close(layer.weight, block_hadamard_rotate(w, h))","+    torch.testing.assert_close(method.apply(layer, x), x @ w.T, rtol=1e-4, atol=1e-4)","+","+","+def test_rejects_indivisible_input_size():","+    with pytest.raises(ValueError, match=\"divisible\"):","+        _make_layer(rotate_weight=True, input_size=48)","+","+","+def _online_mxfp4(","+    weight: torch.Tensor, x: torch.Tensor, kernel_cls: type, hadamard_size: int | None","+) -> torch.Tensor:","+    output_size, input_size = weight.shape","+    inner = Mxfp4OnlineLinearMethod()","+    inner.kernel = kernel_cls(","+        MxFp4LinearLayerConfig(activation_quant_key=kMxfp4Dynamic)","+    )","+    if isinstance(inner.kernel, AiterMxfp4LinearKernel):","+        # The ASM GEMM writes bf16 only; serving sets the default dtype to bf16.","+        inner.kernel.out_dtype = torch.bfloat16","+    method: LinearMethodBase = inner","+    if hadamard_size is not None:","+        method = InputHadamardLinearMethod(inner, hadamard_size, rotate_weight=True)","+    layer = torch.nn.Module()","+    layer.weight_loader = default_weight_loader","+    method.create_weights(","+        layer=layer,","+        input_size_per_partition=input_size,","+        output_partition_sizes=[output_size],","+        input_size=input_size,","+        output_size=output_size,","+        params_dtype=torch.bfloat16,","+        weight_loader=default_weight_loader,","+    )","+    replace_parameter(layer, \"weight\", weight.clone())","+    method.process_weights_after_loading(layer)","+    return method.apply(layer, x)","+","+","+@pytest.mark.skipif(","+    not current_platform.supports_mx(), reason=\"MXFP4 kernels need MX support.\"","+)","+@pytest.mark.parametrize(","+    \"kernel_cls\", [EmulationMxfp4LinearKernel, AiterMxfp4LinearKernel]","+)","+@pytest.mark.parametrize(\"num_tokens\", [16, 256])","+def test_online_mxfp4_hadamard(kernel_cls, num_tokens, default_vllm_config, dist_init):","+    \"\"\"The rotated layer computes the same GEMM with less MXFP4 error, and","+    matches the unrotated layer run on explicitly rotated operands.\"\"\"","+    supported, reason = kernel_cls.is_supported()","+    if not supported:","+        pytest.skip(reason)","+    default_vllm_config.model_config = ModelConfig()","+    input_size, output_size = 2048, 256","+    set_random_seed(0)","+    with torch.device(current_platform.device_type):","+        x = torch.randn(num_tokens, input_size, dtype=torch.bfloat16)","+        x[:, torch.randperm(input_size)[:16]] *= 50.0","+        weight = torch.randn(output_size, input_size, dtype=torch.bfloat16) * 0.02","+        weight[:, torch.randperm(input_size)[:16]] *= 10.0","+        want = x.float() @ weight.float().T","+","+        plain = _online_mxfp4(weight, x, kernel_cls, None)","+        rotated = _online_mxfp4(weight, x, kernel_cls, 32)","+        h = hadamard_matrix(32, x.device)","+        explicit = _online_mxfp4(","+            block_hadamard_rotate(weight, h),","+            block_hadamard_rotate(x, h),","+            kernel_cls,","+            None,","+        )","+","+    def rel_err(y: torch.Tensor) -> float:","+        return ((y.float() - want).norm() / want.norm()).item()","+","+    assert rel_err(rotated) < 0.7 * rel_err(plain), (rel_err(rotated), rel_err(plain))","+    assert ((rotated.float() - explicit.float()).norm() / want.norm()).item() < 1e-2"],"additions":257,"deletions":0,"truncated":false},{"path":"tests/quantization/test_quantization_config_args.py","lines":["@@ -11,6 +11,7 @@","     QuantSpec,","     resolve_quantization_config,"," )","+from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts"," from vllm.model_executor.layers.linear import LinearBase"," from vllm.model_executor.layers.quantization.online.base import (","     OnlineQuantizationConfig,","@@ -23,6 +24,7 @@","     kFp8StaticTensorSym,","     kInt4Static32,","     kInt8StaticChannelSym,","+    kMxfp4Static,","     kMxfp8Dynamic,","     kNvfp4DynamicToken,","     kNvfp4Static,","@@ -243,3 +245,56 @@ def test_targets_reject_moe_only_shorthand_for_linear_layer():"," ","     with pytest.raises(ValueError, match=\"does not define a QuantSpec\"):","         config.resolve_quant_method_cls(LinearBase, \"model.layers.0.self_attn.o_proj\")","+","+","+# ---- hadamard_size ---------------------------------------------------------","+","+","+def test_mxfp4_hadamard32_target_resolves_to_rotated_mxfp4_linear():","+    from vllm.model_executor.layers.quantization.online.mxfp4 import (","+        Mxfp4OnlineLinearMethod,","+    )","+","+    config = OnlineQuantizationConfig(","+        QuantizationConfigArgs(","+            targets={\"re:.*linear_attn\\\\.out_proj\": \"mxfp4_hadamard32\"}","+        )","+    )","+    resolved = config.resolve_quant_method_cls(","+        LinearBase, \"model.layers.0.linear_attn.out_proj\"","+    )","+    assert resolved is not None","+    _, quant_key_str, _, spec, method_cls = resolved","+    assert quant_key_str == \"mxfp4_hadamard32\"","+    assert spec.hadamard_size == 32","+    assert method_cls is Mxfp4OnlineLinearMethod","+","+","+def test_rocm_platform_supports_mxfp4_hadamard32():","+    \"\"\"`--quantization mxfp4_hadamard32` reaches the ROCm allowlist unchanged.\"\"\"","+    try:","+        from vllm.platforms.rocm import RocmPlatform","+    except ImportError:","+        pytest.skip(\"vllm.platforms.rocm not importable outside a ROCm stack\")","+","+    RocmPlatform.verify_quantization(\"mxfp4_hadamard32\")","+","+","+@pytest.mark.parametrize(\"size\", [0, 24, 33])","+def test_hadamard_size_must_be_power_of_two(size):","+    with pytest.raises(ValueError, match=\"power of two\"):","+        quant_config_args(linear={\"weight\": kMxfp4Static, \"hadamard_size\": size})","+","+","+@pytest.mark.parametrize(","+    \"linear,moe\",","+    [","+        ({\"weight\": \"fp8_per_block_static\", \"hadamard_size\": 32}, None),","+        (None, {\"weight\": kMxfp4Static, \"hadamard_size\": 32}),","+    ],","+)","+def test_hadamard_size_not_implemented_for_unvalidated_methods(linear, moe):","+    config = OnlineQuantizationConfig(quant_config_args(linear=linear, moe=moe))","+    layer_cls = LinearBase if linear is not None else RoutedExperts","+    with pytest.raises(NotImplementedError, match=\"hadamard_size\"):","+        config.resolve_quant_method_cls(layer_cls, \"model.layers.0.mlp.down_proj\")"],"additions":55,"deletions":0,"truncated":false},{"path":"tests/quantization/test_quark.py","lines":["@@ -1811,6 +1811,30 @@ def test_mxfp4_gsm8k_correctness(config: AccuracyTestConfig):","     ), f\"Expected: {EXPECTED_VALUE} |  Measured: {measured_value}\""," "," ","+# Quark MXFP4 with an online 64-wide Hadamard rotation on q/k/v/gate/up","+# (`input_rotation` tensors). The weights are stored rotated, so a loader that","+# skips the activation rotation produces garbage.","+ONLINE_ROTATION_CONFIG = AccuracyTestConfig(","+    model_name=\"amd-quark/internal-testing-qwen3_0.6b-mxfp4-hadamard\",","+    excepted_value=45.9,","+)","+","+","+@pytest.mark.skipif(not current_platform.supports_mx(), reason=\"requires MX support\")","+def test_quark_online_rotation_wikitext():","+    config = ONLINE_ROTATION_CONFIG","+    results = lm_eval.simple_evaluate(","+        model=\"vllm\",","+        model_args=config.get_model_args(","+            tp_size=1, kwargs={\"cudagraph_capture_sizes\": [16]}","+        ),","+        tasks=\"wikitext\",","+        batch_size=64,","+    )","+    measured_value = results[\"results\"][\"wikitext\"][\"word_perplexity,none\"]","+    assert measured_value == pytest.approx(config.excepted_value, abs=0.1)","+","+"," @pytest.mark.skipif(","     not QUARK_MXFP4_AVAILABLE,","     reason=f\"amd-quark>={QUARK_MXFP4_MIN_VERSION} is not available\","],"additions":24,"deletions":0,"truncated":false},{"path":"tools/pre_commit/test_tethering_allowlist.txt","lines":["@@ -85,6 +85,7 @@ tests/quantization/test_gptq_dynamic.py  # CI jobs disabled pending locked torch"," tests/quantization/test_humming_compile.py  # CI jobs disabled pending locked torchao transitive dependencies"," tests/quantization/test_humming_ignore.py  # CI jobs disabled pending locked torchao transitive dependencies"," tests/quantization/test_humming_mxfp4_block_fp8.py  # CI jobs disabled pending locked torchao transitive dependencies","+tests/quantization/test_input_hadamard.py  # CI jobs disabled pending locked torchao transitive dependencies"," tests/quantization/test_int8_moe_oracle.py  # CI jobs disabled pending locked torchao transitive dependencies"," tests/quantization/test_lm_head.py  # CI jobs disabled pending locked torchao transitive dependencies"," tests/quantization/test_mixed_precision.py  # CI jobs disabled pending locked torchao transitive dependencies"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/config/quantization.py","lines":["@@ -91,6 +91,20 @@ class QuantSpec:","     activation: QuantKeyField = None","     \"\"\"Activation quantization key, or a name from QUANT_KEY_NAMES.\"\"\""," ","+    hadamard_size: int | None = None","+    \"\"\"Block size (a power of two) of an orthonormal Hadamard rotation applied","+    along the input dimension of both the weight and the activation before","+    quantization (see `InputHadamardLinearMethod`). The GEMM result is","+    unchanged up to quantization error, which the rotation shrinks by spreading","+    outliers across each block. Linear layers only; validated with MXFP4.\"\"\"","+","+    @field_validator(\"hadamard_size\")","+    @classmethod","+    def _check_hadamard_size(cls, size: int | None) -> int | None:","+        if size is not None and (size <= 0 or size & (size - 1)):","+            raise ValueError(f\"hadamard_size must be a power of two, got {size}\")","+        return size","+","     def __str__(self) -> str:","         def quant_key_str(quant_key: QuantKey | None) -> str:","             if quant_key is None:","@@ -104,7 +118,10 @@ def quant_key_str(quant_key: QuantKey | None) -> str:","                 str(quant_key),","             )"," ","-        return quant_key_str(self.weight)","+        name = quant_key_str(self.weight)","+        if self.hadamard_size is not None:","+            name = f\"{name}_hadamard{self.hadamard_size}\"","+        return name"," "," "," @config","@@ -215,6 +232,11 @@ def _validate_targets_exclusivity(self) -> \"QuantizationConfigArgs\":","         linear=QuantSpec(weight=kMxfp4Static),","         moe=QuantSpec(weight=kMxfp4Static),","     ),","+    # MXFP4 linear with a 32-wide Hadamard rotation of weights and activations;","+    # MoE stays unquantized (no `moe` field).","+    \"mxfp4_hadamard32\": QuantizationConfigArgs(","+        linear=QuantSpec(weight=kMxfp4Static, hadamard_size=32),","+    ),","     # INT8 weight-only on MoE; linear stays unquantized (no `linear` field).","     \"int8_per_channel_weight_only\": QuantizationConfigArgs(","         moe=QuantSpec(weight=kInt8StaticChannelSym),"],"additions":23,"deletions":1,"truncated":false},{"path":"vllm/model_executor/layers/quantization/__init__.py","lines":["@@ -45,6 +45,7 @@","     \"int8_per_channel_weight_only\",","     \"nvfp4_per_token\",","     \"mxfp8\",","+    \"mxfp4_hadamard32\","," ]"," QUANTIZATION_METHODS: list[str] = list(get_args(QuantizationMethods))"," "],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/quantization/base_config.py","lines":["@@ -360,6 +360,11 @@ def resolve_quant_method(","         if online_target is None:","             # The checkpoint quant method is applied as there is no online override.","             return base_quant_method","+        if online_target[3].hadamard_size is not None:","+            raise NotImplementedError(","+                f\"{prefix}: online hadamard_size on an already quantized layer \"","+                \"(requantization) is not supported yet.\"","+            )"," ","         online_quant_method = online_config.get_quant_method(layer, prefix)"," "],"additions":5,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/quantization/input_hadamard.py","lines":["@@ -0,0 +1,150 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Block Hadamard rotation of linear-layer inputs, independent of the weight","+format.","+","+Rotating each contiguous block of the input dimension by an orthonormal","+Hadamard matrix ``H`` on both operands leaves the product unchanged,","+``(x H)(w H)^T = x w^T``, while spreading outliers across each block, which","+shrinks the error of block-scaled quantization (MXFP4, MXFP8, ...).","+\"\"\"","+","+import functools","+","+import torch","+","+from vllm.model_executor.layers.linear import (","+    WEIGHT_LOADER_V2_SUPPORTED,","+    LinearMethodBase,","+    register_weight_loader_v2_supported_method,","+)","+from vllm.model_executor.utils import set_weight_attrs","+","+","+@functools.cache","+def hadamard_matrix(size: int, device: torch.device) -> torch.Tensor:","+    \"\"\"Orthonormal Sylvester Hadamard matrix, ``scipy.linalg.hadamard(size)``","+    scaled by ``1 / sqrt(size)``, in fp32. ``size`` must be a power of two.\"\"\"","+    if size <= 0 or size & (size - 1):","+        raise ValueError(f\"Hadamard size must be a power of two, got {size}\")","+    h = torch.ones(1, 1, dtype=torch.float32, device=device)","+    while h.shape[0] < size:","+        h = torch.cat([torch.cat([h, h], 1), torch.cat([h, -h], 1)], 0)","+    return h / size**0.5","+","+","+def block_hadamard_rotate(x: torch.Tensor, hadamard: torch.Tensor) -> torch.Tensor:","+    \"\"\"Rotate each contiguous ``hadamard.shape[0]``-wide block of the last","+    dimension of ``x`` by ``hadamard``, computed in fp32 and returned in","+    ``x.dtype``.\"\"\"","+    size = hadamard.shape[0]","+    rotated = x.float().unflatten(-1, (-1, size)) @ hadamard","+    return rotated.flatten(-2).to(x.dtype)","+","+","+@register_weight_loader_v2_supported_method","+class InputHadamardLinearMethod(LinearMethodBase):","+    \"\"\"Wraps a linear method and rotates the layer input by an orthonormal","+    block Hadamard matrix before the wrapped `apply`, in the manner of","+    `CompressedTensorsLinearTransformMethod`.","+","+    With ``rotate_weight``, the weight (``[out, in]``) is rotated the same way","+    right before the wrapped method processes it, for example before online","+    quantization. Otherwise the checkpoint stores the weight already rotated,","+    together with an int8 ``input_rotation`` tensor holding the unnormalized","+    (+-1) Sylvester matrix, which is checked and then dropped.","+    \"\"\"","+","+    # TODO: the rotation runs in PyTorch before the wrapped method; let kernels","+    # that can rotate inside their activation quantization (AITER's MXFP4 HIP","+    # quant, CUDA hadacore) take it over.","+","+    def __init__(","+        self, quant_method: LinearMethodBase, size: int, rotate_weight: bool","+    ) -> None:","+        self.quant_method = quant_method","+        self.size = size","+        self.rotate_weight = rotate_weight","+","+    @property","+    def uses_meta_device(self) -> bool:  # type: ignore[override]","+        return self.quant_method.uses_meta_device","+","+    def create_weights(","+        self,","+        layer: torch.nn.Module,","+        input_size_per_partition: int,","+        output_partition_sizes: list[int],","+        input_size: int,","+        output_size: int,","+        params_dtype: torch.dtype,","+        **extra_weight_attrs,","+    ):","+        if input_size_per_partition % self.size != 0:","+            raise ValueError(","+                f\"Input size per partition {input_size_per_partition} is not \"","+                f\"divisible by the Hadamard size {self.size}.\"","+            )","+        # This class is registered for weight_loader_v2; hand v1 to wrapped","+        # methods that are not, as CompressedTensorsLinearTransformMethod does.","+        if self.quant_method.__class__.__name__ not in WEIGHT_LOADER_V2_SUPPORTED:","+            extra_weight_attrs[\"weight_loader\"] = layer.weight_loader","+        self.quant_method.create_weights(","+            layer,","+            input_size_per_partition,","+            output_partition_sizes,","+            input_size,","+            output_size,","+            params_dtype,","+            **extra_weight_attrs,","+        )","+        if not self.rotate_weight:","+            input_rotation = torch.nn.Parameter(","+                torch.zeros(self.size, self.size, dtype=torch.int8),","+                requires_grad=False,","+            )","+            set_weight_attrs(","+                input_rotation, {\"weight_loader\": self._load_input_rotation}","+            )","+            layer.register_parameter(\"input_rotation\", input_rotation)","+","+    def _load_input_rotation(","+        self, param: torch.nn.Parameter, loaded_weight: torch.Tensor, *args, **kwargs","+    ) -> None:","+        \"\"\"Every shard of a fused layer carries the same rotation, and it must","+        be the Sylvester matrix `apply` rotates by.\"\"\"","+        hadamard = hadamard_matrix(self.size, loaded_weight.device)","+        if not torch.equal(loaded_weight.float(), (hadamard * self.size**0.5).round()):","+            raise NotImplementedError(","+                \"Only the Sylvester Hadamard input rotation is supported; random \"","+                \"or trained rotations are not.\"","+            )","+        param.data.copy_(loaded_weight)","+","+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:","+        # Online methods may be called again after quantizing; rotate once.","+        weight: torch.Tensor = layer.weight","+        if not getattr(layer, \"_already_called_process_weights_after_loading\", False):","+            if self.rotate_weight:","+                hadamard = hadamard_matrix(self.size, weight.device)","+                weight.data.copy_(block_hadamard_rotate(weight.data, hadamard))","+            else:","+                input_rotation: torch.Tensor = layer.input_rotation","+                if not input_rotation.any():","+                    raise ValueError(","+                        \"The checkpoint did not provide the input_rotation of an \"","+                        \"online-rotated layer.\"","+                    )","+                del layer.input_rotation","+        self.quant_method.process_weights_after_loading(layer)","+        layer.input_hadamard = hadamard_matrix(self.size, layer.weight.device)","+","+    def apply(","+        self,","+        layer: torch.nn.Module,","+        x: torch.Tensor,","+        bias: torch.Tensor | None = None,","+    ) -> torch.Tensor:","+        hadamard: torch.Tensor = layer.input_hadamard","+        x = block_hadamard_rotate(x, hadamard)","+        return self.quant_method.apply(layer, x, bias)"],"additions":150,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/quantization/online/base.py","lines":["@@ -33,6 +33,9 @@"," from vllm.model_executor.layers.quantization.compressed_tensors.utils import (","     should_ignore_layer,"," )","+from vllm.model_executor.layers.quantization.input_hadamard import (","+    InputHadamardLinearMethod,","+)"," from vllm.model_executor.layers.quantization.online.fp8 import (","     Fp8PerBlockOnlineLinearMethod,","     Fp8PerBlockOnlineMoEMethod,","@@ -99,6 +102,9 @@ class OnlineQuantizationSource(str, Enum):","     kMxfp4Static: Mxfp4OnlineLinearMethod,"," }"," ","+# Online linear