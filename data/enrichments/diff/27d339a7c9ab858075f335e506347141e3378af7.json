{"id":"27d339a7c9ab858075f335e506347141e3378af7","axis":"silent","repo":"elastic/elasticsearch","sha":"27d339a7c9ab858075f335e506347141e3378af7","parsed":{"files":[{"path":"docs/changelog/164141.yaml","lines":["@@ -0,0 +1,6 @@","+area: ES|QL","+issues:","+ - 164140","+pr: 164141","+summary: Fix coordinator OOM with concurrent INLINE STATS queries","+type: bug"],"additions":6,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/CrossClusterSerializedPlanBreakerIT.java","lines":["@@ -0,0 +1,119 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.action.bulk.BulkRequestBuilder;","+import org.elasticsearch.action.support.WriteRequest;","+import org.elasticsearch.client.internal.Client;","+import org.elasticsearch.common.breaker.CircuitBreaker;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.compute.operator.exchange.ExchangeService;","+import org.elasticsearch.core.Releasable;","+import org.elasticsearch.indices.breaker.CircuitBreakerService;","+import org.elasticsearch.test.transport.MockTransportService;","+import org.elasticsearch.transport.TransportService;","+import org.elasticsearch.xpack.esql.EsqlTestUtils;","+import org.elasticsearch.xpack.esql.plugin.ComputeService;","+","+import java.util.List;","+import java.util.Map;","+","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;","+import static org.elasticsearch.xpack.esql.action.EsqlQueryRequest.syncEsqlQueryRequest;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.NUM_DOCS;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.QUERY_TAIL;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.SERIALIZED_REQUEST_LABEL;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.assertTrippedOn;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.fillBreakerAfterNthSend;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.key;","+import static org.hamcrest.Matchers.containsString;","+import static org.hamcrest.Matchers.lessThan;","+","+/**","+ * The coordinator charges its request breaker for each serialized request that carries the sub-plan result to a remote","+ * cluster, until that request has been written. The trip tests fill the breaker once the first remote cluster's main-plan","+ * request has been written, so only the second one trips.","+ */","+public class CrossClusterSerializedPlanBreakerIT extends AbstractCrossClusterTestCase {","+","+    private static final String INDEX = \"breaker_idx\";","+    private static final String QUERY = \"FROM \" + REMOTE_CLUSTER_1 + \":\" + INDEX + \",\" + REMOTE_CLUSTER_2 + \":\" + INDEX + QUERY_TAIL;","+","+    @Override","+    protected Map<String, Boolean> skipUnavailableForRemoteClusters() {","+        return Map.of(REMOTE_CLUSTER_1, false, REMOTE_CLUSTER_2, false);","+    }","+","+    @Override","+    protected Settings nodeSettings() {","+        return Settings.builder()","+            .put(super.nodeSettings())","+            .put(SerializedPlanBreakerIT.memoryRequestBreaker())","+            // The base class reaps inactive exchanges within seconds, which would hide one that a trip leaves on a remote cluster.","+            .put(ExchangeService.INACTIVE_SINKS_INTERVAL_SETTING, ExchangeService.INACTIVE_SINKS_INTERVAL_DEFAULT)","+            .build();","+    }","+","+    public void testTripFailsQueryWithoutPartialResults() {","+        populateRemotes();","+        String coordinator = cluster(LOCAL_CLUSTER).getRandomNodeName();","+        try (Releasable filled = fillCoordinatorBreaker(coordinator)) {","+            Exception e = expectThrows(Exception.class, () -> run(coordinator, false).close());","+            assertTrippedOn(e, SERIALIZED_REQUEST_LABEL);","+        }","+    }","+","+    public void testTripDropsClusterWithPartialResults() {","+        populateRemotes();","+        String coordinator = cluster(LOCAL_CLUSTER).getRandomNodeName();","+        try (Releasable filled = fillCoordinatorBreaker(coordinator); EsqlQueryResponse resp = run(coordinator, true)) {","+            assertTrue(resp.isPartial());","+            List<List<Object>> rows = EsqlTestUtils.getValuesList(resp);","+            assertThat(((Number) rows.get(0).get(0)).longValue(), lessThan((long) NUM_DOCS));","+            StringBuilder failures = new StringBuilder();","+            for (String alias : List.of(REMOTE_CLUSTER_1, REMOTE_CLUSTER_2)) {","+                failures.append(resp.getExecutionInfo().getCluster(alias).getFailures());","+            }","+            assertThat(failures.toString(), containsString(\"data for [\" + SERIALIZED_REQUEST_LABEL + \"]\"));","+        }","+    }","+","+    private void populateRemotes() {","+        for (String alias : List.of(REMOTE_CLUSTER_1, REMOTE_CLUSTER_2)) {","+            Client remote = client(alias);","+            assertAcked(remote.admin().indices().prepareCreate(INDEX).setMapping(\"k\", \"type=keyword\"));","+            BulkRequestBuilder bulk = remote.prepareBulk().setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE);","+            for (int i = 0; i < NUM_DOCS / 2; i++) {","+                bulk.add(remote.prepareIndex(INDEX).setSource(\"k\", alias + key(i)));","+            }","+            assertFalse(bulk.get().hasFailures());","+        }","+    }","+","+    private Releasable fillCoordinatorBreaker(String coordinator) {","+        return fillBreakerAfterNthSend(","+            coordinatorTransport(coordinator),","+            coordinatorBreaker(coordinator),","+            ComputeService.CLUSTER_ACTION_NAME,","+            3","+        );","+    }","+","+    private MockTransportService coordinatorTransport(String coordinator) {","+        return (MockTransportService) cluster(LOCAL_CLUSTER).getInstance(TransportService.class, coordinator);","+    }","+","+    private CircuitBreaker coordinatorBreaker(String coordinator) {","+        return cluster(LOCAL_CLUSTER).getInstance(CircuitBreakerService.class, coordinator).getBreaker(CircuitBreaker.REQUEST);","+    }","+","+    private EsqlQueryResponse run(String coordinator, boolean allowPartialResults) {","+        var request = syncEsqlQueryRequest(QUERY).allowPartialResults(allowPartialResults);","+        return cluster(LOCAL_CLUSTER).client(coordinator).execute(EsqlQueryAction.INSTANCE, request).actionGet(TEST_REQUEST_TIMEOUT);","+    }","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/ExternalSerializedPlanBreakerIT.java","lines":["@@ -0,0 +1,118 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.common.breaker.CircuitBreaker;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.core.Releasable;","+import org.elasticsearch.indices.breaker.CircuitBreakerService;","+import org.elasticsearch.plugins.Plugin;","+import org.elasticsearch.test.ESIntegTestCase;","+import org.elasticsearch.test.transport.MockTransportService;","+import org.elasticsearch.transport.TransportService;","+import org.elasticsearch.xpack.esql.datasource.csv.CsvDataSourcePlugin;","+import org.elasticsearch.xpack.esql.datasources.spi.StoragePath;","+import org.elasticsearch.xpack.esql.plugin.ComputeService;","+import org.elasticsearch.xpack.esql.plugin.QueryPragmas;","+","+import java.nio.charset.StandardCharsets;","+import java.nio.file.Files;","+import java.nio.file.Path;","+import java.util.ArrayList;","+import java.util.Collection;","+import java.util.List;","+import java.util.Map;","+","+import static org.elasticsearch.xpack.esql.action.EsqlQueryRequest.syncEsqlQueryRequest;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.NUM_DOCS;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.QUERY_TAIL;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.SERIALIZED_REQUEST_LABEL;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.assertTrippedOn;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.fillBreakerAfterNthSend;","+import static org.elasticsearch.xpack.esql.action.SerializedPlanBreakerIT.key;","+","+/**","+ * The coordinator charges its request breaker for each serialized request that carries the sub-plan result to an external","+ * worker, until that request has been written. A dedicated coordinator is never a worker, and the breaker is filled once the","+ * first worker's main-plan request has been written, so only the second one trips.","+ */","+@ESIntegTestCase.ClusterScope(scope = ESIntegTestCase.Scope.TEST, numDataNodes = 0, numClientNodes = 0)","+public class ExternalSerializedPlanBreakerIT extends AbstractExternalDataSourceIT {","+","+    private static final int FILES = 15;","+","+    @Override","+    protected Collection<Class<? extends Plugin>> formatPlugins() {","+        return List.of(CsvDataSourcePlugin.class);","+    }","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins() {","+        List<Class<? extends Plugin>> plugins = new ArrayList<>(super.nodePlugins());","+        plugins.add(MockTransportService.TestPlugin.class);","+        return plugins;","+    }","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal, Settings otherSettings) {","+        return Settings.builder()","+            .put(super.nodeSettings(nodeOrdinal, otherSettings))","+            .put(SerializedPlanBreakerIT.memoryRequestBreaker())","+            .build();","+    }","+","+    public void testTripFailsQueryWithoutPartialResults() throws Exception {","+        assertTripFailsQuery(false);","+    }","+","+    /** A failed external worker fails the whole query, so a trip does too, even when partial results are allowed. */","+    public void testTripFailsQueryWithPartialResults() throws Exception {","+        assertTripFailsQuery(true);","+    }","+","+    private void assertTripFailsQuery(boolean allowPartialResults) throws Exception {","+        internalCluster().startMasterOnlyNode();","+        internalCluster().startDataOnlyNodes(2);","+        String coordinator = internalCluster().startCoordinatingOnlyNode(Settings.EMPTY);","+        ensureStableCluster(4);","+        registerDataSource(\"breaker_ds\", Map.of());","+        registerDataset(\"breaker_dataset\", \"breaker_ds\", StoragePath.fileUri(writeFixture()) + \"/*.csv\", Map.of());","+","+        var request = syncEsqlQueryRequest(\"FROM breaker_dataset\" + QUERY_TAIL).allowPartialResults(allowPartialResults);","+        request.pragmas(new QueryPragmas(Settings.builder().put(QueryPragmas.EXTERNAL_DISTRIBUTION.getKey(), \"round_robin\").build()));","+        request.acceptedPragmaRisks(true);","+        try (","+            Releasable filled = fillBreakerAfterNthSend(","+                (MockTransportService) internalCluster().getInstance(TransportService.class, coordinator),","+                internalCluster().getInstance(CircuitBreakerService.class, coordinator).getBreaker(CircuitBreaker.REQUEST),","+                ComputeService.DATA_ACTION_NAME,","+                3","+            )","+        ) {","+            Exception e = expectThrows(","+                Exception.class,","+                () -> client(coordinator).execute(EsqlQueryAction.INSTANCE, request).actionGet(TIMEOUT).close()","+            );","+            assertTrippedOn(e, SERIALIZED_REQUEST_LABEL);","+        }","+    }","+","+    private Path writeFixture() throws Exception {","+        Path root = createTempDir().resolve(\"breaker_dataset\");","+        Files.createDirectories(root);","+        int rowsPerFile = NUM_DOCS / FILES;","+        for (int f = 0; f < FILES; f++) {","+            StringBuilder body = new StringBuilder(\"k\\n\");","+            for (int i = 0; i < rowsPerFile; i++) {","+                body.append(key(f * rowsPerFile + i)).append('\\n');","+            }","+            Files.writeString(root.resolve(\"part_\" + f + \".csv\"), body.toString(), StandardCharsets.UTF_8);","+        }","+        return root;","+    }","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/SerializedPlanBreakerIT.java","lines":["@@ -0,0 +1,213 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.ExceptionsHelper;","+import org.elasticsearch.action.bulk.BulkRequestBuilder;","+import org.elasticsearch.action.support.WriteRequest;","+import org.elasticsearch.cluster.node.DiscoveryNode;","+import org.elasticsearch.common.breaker.CircuitBreaker;","+import org.elasticsearch.common.breaker.CircuitBreakingException;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.common.unit.ByteSizeValue;","+import org.elasticsearch.core.Releasable;","+import org.elasticsearch.indices.breaker.CircuitBreakerService;","+import org.elasticsearch.indices.breaker.HierarchyCircuitBreakerService;","+import org.elasticsearch.plugins.Plugin;","+import org.elasticsearch.rest.RestStatus;","+import org.elasticsearch.test.ESIntegTestCase;","+import org.elasticsearch.test.transport.MockTransportService;","+import org.elasticsearch.transport.RemoteClusterService;","+import org.elasticsearch.transport.TransportMessageListener;","+import org.elasticsearch.transport.TransportRequest;","+import org.elasticsearch.transport.TransportRequestOptions;","+import org.elasticsearch.transport.TransportService;","+import org.elasticsearch.xpack.esql.EsqlTestUtils;","+import org.elasticsearch.xpack.esql.plugin.ComputeService;","+","+import java.util.ArrayList;","+import java.util.Collection;","+import java.util.List;","+import java.util.concurrent.CountDownLatch;","+import java.util.concurrent.atomic.AtomicInteger;","+import java.util.concurrent.atomic.AtomicLong;","+","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;","+import static org.elasticsearch.xpack.esql.action.EsqlQueryRequest.syncEsqlQueryRequest;","+import static org.hamcrest.Matchers.containsString;","+import static org.hamcrest.Matchers.equalTo;","+import static org.hamcrest.Matchers.lessThan;","+import static org.hamcrest.Matchers.notNullValue;","+","+/**","+ * The coordinator charges its request breaker for each serialized request that carries the sub-plan result to a remote data","+ * node, until that request has been written. A dedicated coordinator sends every request remotely, and the trip tests fill","+ * the breaker once the first main-plan request has been written, so only the second one trips.","+ */","+@ESIntegTestCase.ClusterScope(scope = ESIntegTestCase.Scope.TEST, numDataNodes = 2, numClientNodes = 0, supportsDedicatedMasters = false)","+public class SerializedPlanBreakerIT extends AbstractEsqlIntegTestCase {","+","+    static final int NUM_DOCS = 15_000;","+    static final String QUERY_TAIL = \" | INLINE STATS c = COUNT(*) BY k | STATS n = COUNT(*), s = SUM(c)\";","+    /** The breaker label of the transport's serialized outbound messages. */","+    static final String SERIALIZED_REQUEST_LABEL = \"RecyclerBytesStreamOutput\";","+    /** Well below the sub-plan result of {@link #NUM_DOCS} {@link #key keys}, and above what the rest of the query allocates. */","+    private static final ByteSizeValue HEADROOM = ByteSizeValue.ofMb(1);","+","+    /**","+     * A unique key with a random suffix. The test cluster sometimes compresses transport messages, and only the compressed bytes","+     * are charged, so the keys must not compress below {@link #HEADROOM}.","+     */","+    static String key(int i) {","+        return i + randomAlphaOfLength(200);","+    }","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins() {","+        List<Class<? extends Plugin>> plugins = new ArrayList<>(super.nodePlugins());","+        plugins.add(MockTransportService.TestPlugin.class);","+        return plugins;","+    }","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal, Settings otherSettings) {","+        return Settings.builder().put(super.nodeSettings(nodeOrdinal, otherSettings)).put(memoryRequestBreaker()).build();","+    }","+","+    /** The test cluster sometimes picks the {@code noop} request breaker, which never trips. */","+    static Settings memoryRequestBreaker() {","+        return Settings.builder()","+            .put(","+                HierarchyCircuitBreakerService.REQUEST_CIRCUIT_BREAKER_TYPE_SETTING.getKey(),","+                HierarchyCircuitBreakerService.REQUEST_CIRCUIT_BREAKER_TYPE_SETTING.getDefault(Settings.EMPTY)","+            )","+            .put(","+                HierarchyCircuitBreakerService.REQUEST_CIRCUIT_BREAKER_OVERHEAD_SETTING.getKey(),","+                HierarchyCircuitBreakerService.REQUEST_CIRCUIT_BREAKER_OVERHEAD_SETTING.getDefault(Settings.EMPTY)","+            )","+            .build();","+    }","+","+    /**","+     * Fills {@code breaker} once the {@code n}th {@code action} request has been written, leaving less headroom than the","+     * sub-plan result. INLINE STATS sends one request per target for its sub-plan, which carries no local data, then one per","+     * target for the main plan. The requests are serialized one at a time, and the fill waits until the {@code n}th is","+     * written, when its own charge is gone, so the next request is the one that trips.","+     */","+    static Releasable fillBreakerAfterNthSend(MockTransportService transportService, CircuitBreaker breaker, String action, int n) {","+        AtomicInteger sends = new AtomicInteger();","+        AtomicLong nthRequestId = new AtomicLong(-1);","+        CountDownLatch nthWritten = new CountDownLatch(1);","+        AtomicLong filled = new AtomicLong();","+        TransportMessageListener writtenListener = new TransportMessageListener() {","+            @Override","+            public void onRequestSent(","+                DiscoveryNode node,","+                long requestId,","+                String sentAction,","+                TransportRequest request,","+                TransportRequestOptions options,","+                int networkMessageSize","+            ) {","+                if (requestId == nthRequestId.get()) {","+                    nthWritten.countDown();","+                }","+            }","+        };","+        transportService.addMessageListener(writtenListener);","+        Object serializeOneAtATime = new Object();","+        transportService.addSendBehavior((connection, requestId, sentAction, request, options) -> {","+            if (action.equals(sentAction) == false) {","+                connection.sendRequest(requestId, sentAction, request, options);","+                return;","+            }","+            synchronized (serializeOneAtATime) {","+                if (sends.incrementAndGet() != n) {","+                    connection.sendRequest(requestId, sentAction, request, options);","+                    return;","+                }","+                nthRequestId.set(requestId);","+                connection.sendRequest(requestId, sentAction, request, options);","+                safeAwait(nthWritten);","+                long fill = breaker.getLimit() - breaker.getUsed() - HEADROOM.getBytes();","+                breaker.addWithoutBreaking(fill);","+                filled.set(fill);","+            }","+        });","+        return () -> {","+            transportService.clearAllRules();","+            transportService.removeMessageListener(writtenListener);","+            breaker.addWithoutBreaking(-filled.getAndSet(0));","+        };","+    }","+","+    static void assertTrippedOn(Exception e, String label) {","+        assertThat(ExceptionsHelper.status(e), equalTo(RestStatus.TOO_MANY_REQUESTS));","+        Throwable cause = ExceptionsHelper.unwrap(e, CircuitBreakingException.class);","+        assertThat(e.toString(), cause, notNullValue());","+        assertThat(cause.getMessage(), containsString(\"data for [\" + label + \"]\"));","+    }","+","+    public void testTripFailsQueryWithoutPartialResults() {","+        String coordinator = setupCoordinatorAndIndex();","+        try (Releasable filled = fillCoordinatorBreaker(coordinator)) {","+            Exception e = expectThrows(Exception.class, () -> run(coordinator, false).close());","+            assertTrippedOn(e, SERIALIZED_REQUEST_LABEL);","+        }","+    }","+","+    public void testTripDropsShardsWithPartialResults() {","+        String coordinator = setupCoordinatorAndIndex();","+        try (Releasable filled = fillCoordinatorBreaker(coordinator); EsqlQueryResponse resp = run(coordinator, true)) {","+            assertTrue(resp.isPartial());","+            List<List<Object>> rows = EsqlTestUtils.getValuesList(resp);","+            assertThat(((Number) rows.get(0).get(0)).longValue(), lessThan((long) NUM_DOCS));","+            EsqlExecutionInfo.Cluster local = resp.getExecutionInfo().getCluster(RemoteClusterService.LOCAL_CLUSTER_GROUP_KEY);","+            assertThat(local.getStatus(), equalTo(EsqlExecutionInfo.Cluster.Status.PARTIAL));","+            assertThat(local.getFailures().toString(), containsString(\"data for [\" + SERIALIZED_REQUEST_LABEL + \"]\"));","+        }","+    }","+","+    private String setupCoordinatorAndIndex() {","+        String coordinator = internalCluster().startCoordinatingOnlyNode(Settings.EMPTY);","+        assertAcked(","+            indicesAdmin().prepareCreate(\"idx\")","+                .setMapping(\"k\", \"type=keyword\")","+                .setSettings(indexSettings(2, 0).put(\"index.routing.allocation.total_shards_per_node\", 1))","+        );","+        ensureGreen(\"idx\");","+        BulkRequestBuilder bulk = client().prepareBulk().setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE);","+        for (int i = 0; i < NUM_DOCS; i++) {","+            bulk.add(prepareIndex(\"idx\").setSource(\"k\", key(i)));","+        }","+        assertFalse(bulk.get().hasFailures());","+        return coordinator;","+    }","+","+    private Releasable fillCoordinatorBreaker(String coordinator) {","+        return fillBreakerAfterNthSend(","+            coordinatorTransport(coordinator),","+            coordinatorBreaker(coordinator),","+            ComputeService.DATA_ACTION_NAME,","+            3","+        );","+    }","+","+    private MockTransportService coordinatorTransport(String coordinator) {","+        return (MockTransportService) internalCluster().getInstance(TransportService.class, coordinator);","+    }","+","+    private CircuitBreaker coordinatorBreaker(String coordinator) {","+        return internalCluster().getInstance(CircuitBreakerService.class, coordinator).getBreaker(CircuitBreaker.REQUEST);","+    }","+","+    private EsqlQueryResponse run(String coordinator, boolean allowPartialResults) {","+        var request = syncEsqlQueryRequest(\"FROM idx\" + QUERY_TAIL).allowPartia