<QueryNode> TransformDescribeSelect(PEGTransformer &transformer,"],"additions":2,"deletions":1,"truncated":false},{"path":"src/parser/peg/grammar/statements/describe.gram","lines":["@@ -2,7 +2,10 @@ DescribeStatement <- ShowExternalResources / ShowTables / ShowDeprecatedSelect /"," "," # \"SHOW [ALL] EXTERNAL RESOURCES\" is a query over duckdb_external_resources, so it works as a subquery too. It comes"," # first: \"SHOW ALL\" alone is ShowAllTables, and \"SHOW <name>\" is ShowByName, and neither can be retried once matched.","-ShowExternalResources <- ShowRule 'ALL'? 'EXTERNAL' 'RESOURCES'","+ShowExternalResources <- ShowRule 'ALL'? 'EXTERNAL' 'RESOURCES' ShowExternalResourcesType?","+# \"WITH TYPE 'aws:s3tables:table-bucket'\" restricts the listing (and the discovery) to one type; a bare identifier","+# is passed through as the type name as well.","+ShowExternalResourcesType <- 'WITH' 'TYPE' ColIdOrString"," "," # \"DESCRIBE (query)\" and \"SUMMARIZE (query)\" describe the query's columns. \"SHOW (query)\" does too but is deprecated,"," # so ShowDeprecatedSelect is parsed yet suppressed from autocomplete (matcher_factory.cpp) - SHOW won't offer to complete a query."],"additions":4,"deletions":1,"truncated":false},{"path":"src/parser/peg/peg_rule_id.cpp","lines":["@@ -435,6 +435,7 @@ static const char *const PEG_RULE_NAMES[] = {","     \"DeleteUsingClause\",","     \"DescribeStatement\",","     \"ShowExternalResources\",","+    \"ShowExternalResourcesType\",","     \"ShowDeprecatedSelect\",","     \"DescribeSelect\",","     \"ShowAllTables\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/parser/peg/transformer/transform_external_resource.cpp","lines":["@@ -49,16 +49,27 @@ unique_ptr<SQLStatement> PEGTransformerFactory::TransformDestroyExternalResource"," \treturn std::move(result);"," }"," ","-// SHOW [ALL] EXTERNAL RESOURCES is the query `SELECT * FROM duckdb_external_resources(discover := <all>)`, so it","-// can be used wherever a query can, such as a subquery.","-unique_ptr<QueryNode> PEGTransformerFactory::TransformShowExternalResources(PEGTransformer &transformer,","-                                                                            const ShowType &show_rule,","-                                                                            const bool &has_result) {","+//! A named argument of a table function call: the name goes on the argument and, for the binder, on the expression.","+static void AddNamedArgument(vector<FunctionArgument> &children, const string &name,","+                             unique_ptr<ParsedExpression> value) {","+\tvalue->SetAlias(Identifier(name));","+\tchildren.emplace_back(Identifier(name), std::move(value));","+}","+","+// SHOW [ALL] EXTERNAL RESOURCES [WITH TYPE t] is the query","+// `SELECT * FROM duckdb_external_resources(discover := <all>, type := t)`, so it can be used wherever a query can,","+// such as a subquery.","+unique_ptr<QueryNode>","+PEGTransformerFactory::TransformShowExternalResources(PEGTransformer &transformer, const ShowType &show_rule,","+                                                      const bool &has_result,","+                                                      optional<Identifier> show_external_resources_type) {"," \tvector<FunctionArgument> children;"," \tif (has_result) {","-\t\tauto discover = ConstantExpression::Boolean(true);","-\t\tdiscover->SetAlias(\"discover\");","-\t\tchildren.emplace_back(Identifier(\"discover\"), std::move(discover));","+\t\tAddNamedArgument(children, \"discover\", ConstantExpression::Boolean(true));","+\t}","+\tif (show_external_resources_type) {","+\t\tauto type = ConstantExpression::String(show_external_resources_type->GetIdentifierName());","+\t\tAddNamedArgument(children, \"type\", std::move(type));"," \t}"," \tauto table_function = make_uniq<TableFunctionRef>();"," \ttable_function->function = make_uniq<FunctionExpression>(\"duckdb_external_resources\", std::move(children));"],"additions":19,"deletions":8,"truncated":false},{"path":"src/parser/peg/transformer/transform_generated_trampoline.cpp","lines":["@@ -2298,14 +2298,21 @@ static const TransformChildPlan FRAME_CHILDREN_159[] = {{PEGRuleId::TableRef,","                                                          {0, TRANSFORM_PATH_END, 0},","                                                          {0, TRANSFORM_PATH_END, 0}}};"," static const TransformFramePlan FRAME_PLAN_172 = {FRAME_CHILDREN_159, 1, 1, true, 0, {}};","-static const TransformChildPlan FRAME_CHILDREN_160[] = {{PEGRuleId::ShowRule,","+static const TransformChildPlan FRAME_CHILDREN_160[] = {{PEGRuleId::ShowExternalResourcesType,","+                                                         TransformChildKind::OPTIONAL,","+                                                         4,","+                                                         1,","+                                                         false,","+                                                         {0, TRANSFORM_PATH_END, 0},","+                                                         {0, TRANSFORM_PATH_END, 0}},","+                                                        {PEGRuleId::ShowRule,","                                                          TransformChildKind::REQUIRED,","                                                          0,","                                                          0,","                                                          false,","                                                          {0, TRANSFORM_PATH_END, 0},","                                                          {0, TRANSFORM_PATH_END, 0}}};","-static const TransformFramePlan FRAME_PLAN_173 = {FRAME_CHILDREN_160, 1, 1, false, 0, {}};","+static const TransformFramePlan FRAME_PLAN_173 = {FRAME_CHILDREN_160, 2, 2, false, 0, {}};"," static const TransformChildPlan FRAME_CHILDREN_161[] = {{PEGRuleId::SelectStatementInternal,","                                                          TransformChildKind::REQUIRED,","                                                          1,","@@ -7721,6 +7728,8 @@ static const TransformFrameOps GENERATED_FRAME_OPS[] = {","      &PEGTransformerFactory::FinalizeDescribeStatementTrampoline, &FRAME_PLAN_1},","     {\"ShowExternalResources\", &PEGTransformerFactory::InitializePlannedTrampoline,","      &PEGTransformerFactory::FinalizeShowExternalResourcesTrampoline, &FRAME_PLAN_173},","+    {\"ShowExternalResourcesType\", &PEGTransformerFactory::InitializePlannedTrampoline,","+     &PEGTransformerFactory::FinalizePassthroughTrampoline, &FRAME_PLAN_13},","     {\"ShowDeprecatedSelect\", &PEGTransformerFactory::InitializePlannedTrampoline,","      &PEGTransformerFactory::FinalizeShowDeprecatedSelectTrampoline, &FRAME_PLAN_174},","     {\"DescribeSelect\", &PEGTransformerFactory::InitializePlannedTrampoline,","@@ -12852,7 +12861,11 @@ PEGTransformerFactory::FinalizeShowExternalResourcesTrampoline(PEGTransformer &t"," \tbool has_result {};"," \tauto &has_result_opt = list_pr.GetChild(1).Cast<OptionalParseResult>();"," \thas_result = has_result_opt.HasResult();","-\tauto result = TransformShowExternalResources(transformer, show_rule, has_result);","+\toptional<Identifier> show_external_resources_type {};","+\tif (process.child_results[1]) {","+\t\tshow_external_resources_type = process.TakeResult<Identifier>(1);","+\t}","+\tauto result = TransformShowExternalResources(transformer, show_rule, has_result, show_external_resources_type);"," \treturn transformer.MakeResult<unique_ptr<QueryNode>>(std::move(result));"," }"," "],"additions":16,"deletions":3,"truncated":false},{"path":"test/configs/force_storage_restart.json","lines":["@@ -176,7 +176,8 @@","         \"test/sql/attach/external_resource_option_collision.test\",","         \"test/sql/attach/external_resource_attach_failure.test\",","         \"test/sql/attach/external_resource_null_handle.test\",","-        \"test/sql/attach/external_resource_show_subquery.test\"","+        \"test/sql/attach/external_resource_show_subquery.test\",","+        \"test/sql/attach/external_resource_show_with_type.test\"","       ]","     },","     {"],"additions":2,"deletions":1,"truncated":false},{"path":"test/sql/attach/external_resource_show_with_type.test","lines":["@@ -0,0 +1,160 @@","+# name: test/sql/attach/external_resource_show_with_type.test","+# description: SHOW [ALL] EXTERNAL RESOURCES WITH TYPE '<type>' restricts the listing to one type, and discovers only it","+# group: [attach]","+","+# Each list callback bumps its own sequence, so the sequences count how often discovery called it.","+statement ok","+CREATE SEQUENCE calls_a;","+","+statement ok","+CREATE SEQUENCE calls_b;","+","+statement ok","+CREATE MACRO list_a(opts) AS TABLE","+    SELECT MAP {'id': 'a' || nextval('calls_a')::VARCHAR} AS handle, 'a-ref' AS reference, 'running' AS state;","+","+statement ok","+CREATE MACRO list_b(opts) AS TABLE","+    SELECT MAP {'id': 'b' || nextval('calls_b')::VARCHAR} AS handle, 'b-ref' AS reference, 'running' AS state;","+","+statement ok","+CALL register_external_resource_type('a@st', kind := 'catalog', create_function := 'noop_create', list_function := 'list_a');","+","+statement ok","+CALL register_external_resource_type('b@st', kind := 'catalog', create_function := 'noop_create', list_function := 'list_b');","+","+statement ok","+CALL register_external_resource('a@st', 'local_a', MAP {'id': 'x'});","+","+# currval needs a prior nextval","+query II","+SELECT nextval('calls_a'), nextval('calls_b');","+----","+1\t1","+","+# Without a type, SHOW ALL discovers every type.","+query I","+SELECT count(*) FROM (SHOW ALL EXTERNAL RESOURCES);","+----","+3","+","+query II","+SELECT currval('calls_a'), currval('calls_b');","+----","+2\t2","+","+# With a type, only that type's callback runs; its registered resources are listed as managed.","+query TTTTTTTT rowsort","+SHOW ALL EXTERNAL RESOURCES WITH TYPE 'a@st';","+----","+NULL\ta@st\tfalse\trunning\ta-ref\tNULL\tNULL\t{id=a3}","+local_a\ta@st\ttrue\tNULL\tNULL\tNULL\tNULL\t{id=x}","+","+query II","+SELECT currval('calls_a'), currval('calls_b');","+----","+3\t2","+","+query TTTTTTTT","+SHOW ALL EXTERNAL RESOURCES WITH TYPE 'b@st';","+----","+NULL\tb@st\tfalse\trunning\tb-ref\tNULL\tNULL\t{id=b3}","+","+query II","+SELECT currval('calls_a'), currval('calls_b');","+----","+3\t3","+","+# It is the query duckdb_external_resources(discover := true, type := '...'), so it works as a subquery too.","+query I","+SELECT count(*) FROM (SHOW ALL EXTERNAL RESOURCES WITH TYPE 'a@st');","+----","+2","+","+query II","+SELECT currval('calls_a'), currval('calls_b');","+----","+4\t3","+","+# Without ALL there is no discovery: the type restricts the registry listing and no callback runs.","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE 'a@st';","+----","+local_a\ta@st\ttrue\tNULL\tNULL\tNULL\tNULL\t{id=x}","+","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE 'b@st';","+----","+","+# An unknown type is not an error for the registry listing: nothing is registered under it, so nothing is listed.","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE 'none@st';","+----","+","+# Discovering a type nothing provides is an error (most likely a typo), and calls nothing.","+statement error","+SHOW ALL EXTERNAL RESOURCES WITH TYPE 'none@st';","+----","+<REGEX>:.*unknown resource type \"none@st\".*","+","+query II","+SELECT currval('calls_a'), currval('calls_b');","+----","+4\t3","+","+# A type nothing provides but the registry knows (its extension is not loaded) lists what is registered under it.","+statement ok","+CALL register_external_resource('orphan@st', 'kept', MAP {'id': 'o'});","+","+query TTTTTTTT","+SHOW ALL EXTERNAL RESOURCES WITH TYPE 'orphan@st';","+----","+kept\torphan@st\ttrue\tNULL\tNULL\tNULL\tNULL\t{id=o}","+","+# The type is a string literal, so it may need escaping; it is matched exactly, no patterns.","+statement ok","+CALL register_external_resource('it''s@st', 'quoted', MAP {'id': 'q'});","+","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE 'it''s@st';","+----","+quoted\tit's@st\ttrue\tNULL\tNULL\tNULL\tNULL\t{id=q}","+","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE '%@st';","+----","+","+# A bare identifier is the type name as well, for types that are plain names.","+statement ok","+CALL register_external_resource('plain', 'bare', MAP {'id': 'p'});","+","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE plain;","+----","+bare\tplain\ttrue\tNULL\tNULL\tNULL\tNULL\t{id=p}","+","+query TTTTTTTT","+SHOW EXTERNAL RESOURCES WITH TYPE \"it's@st\";","+----","+quoted\tit's@st\ttrue\tNULL\tNULL\tNULL\tNULL\t{id=q}","+","+query II","+SELECT currval('calls_a'), currval('calls_b');","+----","+4\t3","+","+# The type is required after WITH TYPE, and WITH alone is not accepted.","+statement error","+SHOW ALL EXTERNAL RESOURCES WITH TYPE;","+----","+<REGEX>:Parser Error.*","+","+statement error","+SHOW ALL EXTERNAL RESOURCES WITH 'a@st';","+----","+<REGEX>:Parser Error.*","+","+statement error","+SHOW ALL EXTERNAL RESOURCES 'a@st';","+----","+<REGEX>:Parser Error.*"],"additions":160,"deletions":0,"truncated":false},{"path":"test/sql/parser/external_resource_roundtrip.test","lines":["@@ -104,6 +104,21 @@ REGISTER EXTERNAL RESOURCE 'aws:ec2:quack' AS x FROM 'plain-handle'"," statement ok"," SHOW EXTERNAL RESOURCES"," ","+# the optional type is a named argument of the table function, printed as a string literal","+statement ok","+SHOW EXTERNAL RESOURCES WITH TYPE 'aws:ec2:quack'","+","+statement ok","+SHOW EXTERNAL RESOURCES WITH TYPE 'aws:ec2:it''s quacky'","+","+statement ok","+SHOW EXTERNAL RESOURCES WITH TYPE quack","+","+statement error","+SHOW ALL EXTERNAL RESOURCES WITH TYPE 'aws:ec2:it''s quacky'","+----","+<REGEX>:.*unknown resource type \"aws:ec2:it's quacky\".*","+"," statement ok"," SELECT count(*) FROM duckdb_external_resources()"," ",""],"additions":15,"deletions":0,"truncated":false}],"additions":229,"deletions":16,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-06T17:02:19.580197+00:00"}