s stored one pointer-sized slot later. A frame whose first word is","@@ -47,12 +48,10 @@ internal sealed class WasmUnwinder","     // Sp values at or below the lowest linear-memory page carry nothing meaningful.","     private const ulong LinearStackFloor = 0x1000;"," ","-    // WASM_STACKFRAME_FUNCTION_INDEX_OFFSET: tagged frame identity (32-bit).","+    // WASM_STACKFRAME_FUNCTION_INDEX_OFFSET: tagged frame identity (UINT_PTR). The sentinels below","+    // are compared as the 32-bit word native reads (int32_t).","     private const ulong FrameIdentityOffset = 0;"," ","-    // WASM_STACKFRAME_VIRTUALIP_OFFSET: function-local virtual IP / 2 (always 32-bit).","-    private const ulong VirtualIpOffset = 4;","-","     // STACK_WALK_INDIRECT_TO_FRAMEPOINTER: this slot is not the frame base; the real base","     // pointer follows one pointer-sized slot later (localloc frames).","     private const uint StackWalkIndirectToFramePointer = 0;","@@ -75,6 +74,42 @@ public WasmUnwinder(Target target, IWasmR2RInfo r2rInfo)","         _pointerSize = (ulong)target.PointerSize;","     }"," ","+    // WASM_STACKFRAME_VIRTUALIP_OFFSET (TARGET_POINTER_SIZE): function-local virtual IP / 2 (always 32-bit).","+    private ulong VirtualIpOffset => _pointerSize;","+","+    private ulong ReadFrameIdentity(ulong frame) => _target.ReadPointer(frame + FrameIdentityOffset).Value;","+","+    // Native tests a UINT_PTR identity with static_cast<INT_PTR>.","+    private bool IsNegativeIdentity(ulong frameIdentity)","+        => _pointerSize == sizeof(ulong) ? (long)frameIdentity < 0 : (int)(uint)frameIdentity < 0;","+","+    /// <summary>","+    /// Advances a WASM context by one ReadyToRun frame over the managed linear stack. When the caller","+    /// is not R2R code (an interpreter transition, native code above a reverse P/Invoke, or the stack","+    /// top), StackPointer is the caller's SP and the IP and FP are null; the walker continues through","+    /// the explicit Frame chain / interpreter frame chain.","+    /// </summary>","+    internal void UnwindContext<TContext>(ref TContext context) where TContext : struct, IPlatformContext","+    {","+        TargetPointer sp = context.StackPointer;","+        if (TryUnwindOneFrame(ref sp, context.InstructionPointer, out TargetCodePointer ip))","+        {","+            context.StackPointer = sp;","+            context.InstructionPointer = ip;","+            // Native WasmUnwindStackFrame recomputes the caller's frame pointer from its stack pointer;","+            // funclets report the establishing method's frame base (GetWasmFramePointerFromStackPointer).","+            context.FramePointer = ip != TargetCodePointer.Null && TryGetLogicalFramePointer(sp, out TargetPointer fp)","+                ? fp","+                : TargetPointer.Null;","+        }","+        else","+        {","+            context.StackPointer = TargetPointer.Null;","+            context.InstructionPointer = TargetCodePointer.Null;","+            context.FramePointer = TargetPointer.Null;","+        }","+    }","+","     /// <summary>","     /// Resolves the R2R frame base for a stack pointer, mirroring","     /// <c>GetWasmFramePointerFromStackPointer_Internal</c>. Returns false when there is no R2R","@@ -112,7 +147,7 @@ private bool TryGetEstablishingFramePointer(TargetPointer frameBase, out TargetP","         establishingFrame = frameBase;","         for (int i = 0; i < MaxEstablishingFrameDepth; i++)","         {","-            uint identity = _target.Read<uint>(establishingFrame.Value + FrameIdentityOffset);","+            ulong identity = ReadFrameIdentity(establishingFrame.Value);","             if ((identity & FrameIdentityTagMask) != EstablishingFrameTag)","                 return true;"," ","@@ -143,7 +178,7 @@ public TargetCodePointer GetVirtualIP(TargetPointer sp)","         if (!TryGetEstablishingFramePointer(frameBase, out TargetPointer establishingFrame))","             return TargetCodePointer.Null;"," ","-        uint frameIdentity = _target.Read<uint>(establishingFrame.Value + FrameIdentityOffset);","+        ulong frameIdentity = ReadFrameIdentity(establishingFrame.Value);","         if (!_r2rInfo.TryGetVirtualIPBase(frameIdentity, out ulong baseVirtualIP, out TargetPointer unwindData) || baseVirtualIP == 0)","             return TargetCodePointer.Null;"," ","@@ -178,7 +213,7 @@ public bool TryUnwindOneFrame(ref TargetPointer sp, TargetCodePointer controlPC,","             return false;","         }"," ","-        uint frameIdentity = _target.Read<uint>(frameBase.Value + FrameIdentityOffset);","+        ulong frameIdentity = ReadFrameIdentity(frameBase.Value);","         ulong address = unwindData.Value;","         uint frameSize = DecodeULEB128(ref address);","         if (frameSize == 0)","@@ -189,7 +224,7 @@ public bool TryUnwindOneFrame(ref TargetPointer sp, TargetCodePointer controlPC,","         }"," ","         sp = new TargetPointer(frameBase.Value + frameSize);","-        if ((frameIdentity & 1) != 0 && (int)frameIdentity > 0)","+        if ((frameIdentity & 1) != 0 && !IsNegativeIdentity(frameIdentity))","         {","             // Positive odd identities are reverse P/Invoke roots. Their caller is native, so","             // preserve the caller SP for the Frame-chain walk but do not interpret it as an R2R"],"additions":46,"deletions":11,"truncated":false},{"path":"src/native/managed/cdac/Microsoft.Diagnostics.DataContractReader.Contracts/Contracts/StackWalk/Context/Wasm64Context.cs","lines":["@@ -0,0 +1,109 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System;","+using System.Runtime.InteropServices;","+","+namespace Microsoft.Diagnostics.DataContractReader.Contracts.StackWalkHelpers;","+","+/// <summary>","+/// Platform context for CoreCLR on 64-bit WebAssembly (memory64). Identical in meaning to","+/// <see cref=\"WasmContext\"/>; only the slot width differs.","+/// </summary>","+[StructLayout(LayoutKind.Sequential)]","+internal struct Wasm64Context : IPlatformContext","+{","+    // Field order and size mirror the native wasm64 T_CONTEXT (src/coreclr/pal/inc/pal.h):","+    //   ContextFlags @0 (ULONG, then 4 bytes of padding), InterpreterWalkFramePointer @8,","+    //   InterpreterSP @16, InterpreterFP @24, InterpreterIP @32 (ULONG_PTR each; 40 bytes).","+    private uint _contextFlags;","+    private ulong _interpreterWalkFramePointer;","+    private ulong _interpreterSP;","+    private ulong _interpreterFP;","+    private ulong _interpreterIP;","+","+    public readonly uint Size => 40;","+","+    public readonly uint ContextControlFlags => 0;","+","+    public readonly uint FullContextFlags => 0;","+","+    public readonly uint AllContextFlags => 0;","+","+    public readonly int StackPointerRegister => -1;","+","+    public TargetPointer StackPointer","+    {","+        readonly get => new(_interpreterSP);","+        set => _interpreterSP = value.Value;","+    }","+","+    public TargetCodePointer InstructionPointer","+    {","+        readonly get => new(_interpreterIP);","+        set => _interpreterIP = value.Value;","+    }","+","+    public TargetPointer FramePointer","+    {","+        readonly get => new(_interpreterFP);","+        set => _interpreterFP = value.Value;","+    }","+","+    public uint RawContextFlags { readonly get => _contextFlags; set => _contextFlags = value; }","+","+    public void Unwind(Target target)","+        => new Wasm.WasmUnwinder(target, new Wasm.WasmR2RInfo(target)).UnwindContext(ref this);","+","+    public void UnsetSingleStepFlag() { }","+","+    public bool TrySetRegister(string name, TargetNUInt value)","+    {","+        if (name.Equals(\"pc\", StringComparison.OrdinalIgnoreCase) || name.Equals(\"ip\", StringComparison.OrdinalIgnoreCase))","+            _interpreterIP = value.Value;","+        else if (name.Equals(\"sp\", StringComparison.OrdinalIgnoreCase))","+            _interpreterSP = value.Value;","+        else if (name.Equals(\"fp\", StringComparison.OrdinalIgnoreCase))","+            _interpreterFP = value.Value;","+        else if (name.Equals(WasmContext.InterpreterWalkFramePointerRegister, StringComparison.OrdinalIgnoreCase))","+            _interpreterWalkFramePointer = value.Value;","+        else","+            return false;","+        return true;","+    }","+","+    public readonly bool TryReadRegister(string name, out TargetNUInt value)","+    {","+        if (name.Equals(\"pc\", StringComparison.OrdinalIgnoreCase) || name.Equals(\"ip\", StringComparison.OrdinalIgnoreCase))","+            value = new TargetNUInt(_interpreterIP);","+        else if (name.Equals(\"sp\", StringComparison.OrdinalIgnoreCase))","+            value = new TargetNUInt(_interpreterSP);","+        else if (name.Equals(\"fp\", StringComparison.OrdinalIgnoreCase))","+            value = new TargetNUInt(_interpreterFP);","+        else if (name.Equals(WasmContext.InterpreterWalkFramePointerRegister, StringComparison.OrdinalIgnoreCase))","+            value = new TargetNUInt(_interpreterWalkFramePointer);","+        else","+        {","+            value = default;","+            return false;","+        }","+        return true;","+    }","+","+    public bool TrySetRegister(int number, TargetNUInt value) => false;","+","+    public readonly bool TryReadRegister(int number, out TargetNUInt value)","+    {","+        value = default;","+        return false;","+    }","+","+    public readonly bool TryReadFloatingPointRegister(int index, out double value)","+    {","+        value = default;","+        return false;","+    }","+","+    public readonly bool TryWriteFloatingPointRegister(int index, double value) => false;","+    public readonly void CopyContext(ReadOnlySpan<byte> source) { }","+}"],"additions":109,"deletions":0,"truncated":false},{"path":"src/native/managed/cdac/Microsoft.Diagnostics.DataContractReader.Contracts/Contracts/StackWalk/Context/WasmContext.cs","lines":["@@ -19,9 +19,10 @@ namespace Microsoft.Diagnostics.DataContractReader.Contracts.StackWalkHelpers;"," /// <c>InterpreterFrame.TopInterpMethodContextFrame</c> -&gt; <c>InterpMethodContextFrame.pParent</c>"," /// chain. A real stack is a mix of the two."," ///","-/// The instruction/stack/frame pointer slots are 32-bit (wasm32): <see cref=\"StackPointer\"/> is","-/// the managed linear stack pointer and <see cref=\"InstructionPointer\"/> is the current virtual IP.","-/// <see cref=\"Unwind\"/> advances the context by one ReadyToRun frame.","+/// The instruction/stack/frame pointer slots are 32-bit (wasm32; <see cref=\"Wasm64Context\"/> is the","+/// wasm64 layout): <see cref=\"StackPointer\"/> is the managed linear stack pointer and","+/// <see cref=\"InstructionPointer\"/> is the current virtual IP. <see cref=\"Unwind\"/> advances the","+/// context by one ReadyToRun frame."," /// </remarks>"," [StructLayout(LayoutKind.Sequential)]"," internal struct WasmContext : IPlatformContext","@@ -83,31 +84,7 @@ public void Unwind(Target target)","         Unwind(unwinder);","     }"," ","-    internal void Unwind(Wasm.WasmUnwinder unwinder)","-    {","-        // Advance one ReadyToRun frame over the managed linear stack. When the caller is not R2R","-        // code (an interpreter transition, native code above a reverse P/Invoke, or the stack top),","-        // StackPointer is the caller's SP and the IP and FP are null; the walker continues through","-        // the explicit Frame chain / interpreter frame chain.","-        TargetPointer sp = StackPointer;","-        if (unwinder.TryUnwindOneFrame(ref sp, InstructionPointer, out TargetCodePointer ip))","-        {","-            StackPointer = sp;","-            InstructionPointer = ip;","-            // Native WasmUnwindStackFrame recomputes the caller's frame pointer from its stack pointer;","-            // funclets report the establishing method's frame base (GetWasmFramePointerFromStackPointer).","-            FramePointer = ip != TargetCodePointer.Null","-                && unwinder.TryGetLogicalFramePointer(sp, out TargetPointer fp)","-                    ? fp","-                    : TargetPointer.Null;","-        }","-        else","-        {","-            StackPointer = TargetPointer.Null;","-            InstructionPointer = TargetCodePointer.Null;","-            FramePointer = TargetPointer.Null;","-        }","-    }","+    internal void Unwind(Wasm.WasmUnwinder unwinder) => unwinder.UnwindContext(ref this);"," ","     // WASM has no hardware single-step flag; like other architectures without one (ARM, LoongArch64,","     // RISC-V) this is a no-op. Callers (e.g. Debugger_1.PrepareExceptionHijack) invoke it"],"additions":5,"deletions":28,"truncated":false},{"path":"src/native/managed/cdac/Microsoft.Diagnostics.DataContractReader.Contracts/Contracts/StackWalk/FrameHandling/FrameHelpers.cs","lines":["@@ -606,7 +606,10 @@ private IPlatformFrameHandler GetFrameHandler(IPlatformAgnosticContext context)","             return new LoongArch64FrameHandler(_target, loongArch64Context);"," ","         if (TargetArchitectureSupport.IsWasmSupported && context is ContextHolder<WasmContext> wasmContext)","-            return new WasmFrameHandler(_target, wasmContext);","+            return new WasmFrameHandler<WasmContext>(_target, wasmContext);","+","+        if (TargetArchitectureSupport.IsWasmSupported && context is ContextHolder<Wasm64Context> wasm64Context)","+            return new WasmFrameHandler<Wasm64Context>(_target, wasm64Context);"," ","         throw new InvalidOperationException($\"Unsupported context type {context.GetType()}\");","     }"],"additions":4,"deletions":1,"truncated":false},{"path":"src/native/managed/cdac/Microsoft.Diagnostics.DataContractReader.Contracts/Contracts/StackWalk/FrameHandling/WasmFrameHandler.cs","lines":["@@ -23,14 +23,15 @@ namespace Microsoft.Diagnostics.DataContractReader.Contracts.StackWalkHelpers;"," ///"," /// Hijack frames are a debugger / GC-suspension concept that is not yet supported on WASM."," /// </remarks>","-internal sealed class WasmFrameHandler(Target target, ContextHolder<WasmContext> contextHolder)","+internal sealed class WasmFrameHandler<TContext>(Target target, ContextHolder<TContext> contextHolder)","     : BaseFrameHandler(target, contextHolder), IPlatformFrameHandler","+    where TContext : unmanaged, IPlatformContext"," {","     // INLINED_PINVOKE_FROM_R2R from src/coreclr/vm/frames.h. An R2R inlined P/Invoke has no native","     // return address on WASM, so the runtime stores this marker and derives IP/SP from CallSiteSP.","     private const ulong InlinedPInvokeFromR2R = 1;"," ","-    private readonly ContextHolder<WasmContext> _holder = contextHolder;","+    private readonly ContextHolder<TContext> _holder = contextHolder;"," ","     public override void HandleInlinedCallFrame(InlinedCallFrame inlinedCallFrame)","     {","@@ -74,7 +75,7 @@ public override void HandleInlinedCallFrame(InlinedCallFrame inlinedCallFrame)","     // so the base handler would leave FP stale.","     public override void HandleSoftwareExceptionFrame(SoftwareExceptionFrame softwareExceptionFrame)","     {","-        ContextHolder<WasmContext> saved = new();","+        ContextHolder<TContext> saved = new();","         saved.ReadFromAddress(_target, softwareExceptionFrame.TargetContext);"," ","         _holder.Context.InstructionPointer = saved.Context.InstructionPointer;"],"additions":4,"deletions":3,"truncated":false},{"path":"src/native/managed/cdac/tests/UnitTests/StackWalkTests.cs","lines":["@@ -2362,6 +2362,98 @@ public void UpdateContextFromFrame_WasmR2RInlinedCallFrame_DerivesVirtualIPFromC","         Assert.Equal(shadowFrameAddr, context.FramePointer.Value);","     }"," ","+    // On wasm64 (memory64 + table64) the R2R shadow frame stores its identity as a UINT_PTR at offset 0","+    // and the function-local virtual IP in the second pointer-sized slot (WASM_STACKFRAME_VIRTUALIP_OFFSET","+    // is TARGET_POINTER_SIZE), and virtual IPs start at (1 << 63) | 1 (ExecutionManager::WasmInitialVirtualIP).","+    // The shadow frame and the PortableEntryPoint are above 4 GiB, so a 32-bit read of any of them is wrong.","+    [Theory]","+    [InlineData(false)]","+    [InlineData(true)]","+    public void UpdateContextFromFrame_Wasm64R2RInlinedCallFrame_DerivesVirtualIPFromCallSiteSP(bool coreLibIdentity)","+    {","+        MockTarget.Architecture wasm64Arch = new() { IsLittleEndian = true, Is64Bit = true };","+        const uint FunctionTableIndex = 5;","+        const ulong Wasm64InitialVirtualIP = 0x8000_0000_0000_0001;","+        const uint FunctionBeginAddress = 0x100;","+        const uint LocalVirtualIPHalf = 3;","+        const ulong HighMemory = 0x1_0000_0000;","+","+        ulong shadowFrameAddr = 0;","+        MockInlinedCallFrame? icf = null;","+        TestPlaceholderTarget target = CreateTarget(","+            wasm64Arch,","+            threadBuilder => threadBuilder.AddThread(1, 1234),","+            frameBuilder => icf = frameBuilder.AddInlinedCallFrame(callerReturnAddress: 1, datum: 0, callSiteSP: 0, calleeSavedFP: 0xBAD0),","+            runtimeArchitecture: RuntimeInfoArchitecture.Wasm,","+            configureTarget: targetBuilder =>","+            {","+                MockMemorySpace.BumpAllocator allocator = targetBuilder.MemoryBuilder.CreateAllocator(0x0010_0000, 0x0010_4000);","+                MockMemorySpace.BumpAllocator highAllocator = targetBuilder.MemoryBuilder.CreateAllocator(HighMemory + 0x0010_0000, HighMemory + 0x0010_4000);","+                AddWasmR2RFunction(targetBuilder, allocator, FunctionTableIndex, Wasm64InitialVirtualIP, FunctionBeginAddress);","+                // CoreLib identities are ~(runtimeFunctionIndex << 1) at pointer width.","+                ulong frameIdentity = coreLibIdentity","+                    ? ~0ul","+                    : AddWasmPortableEntryPointAddress(targetBuilder, highAllocator, FunctionTableIndex);","+","+                TargetTestHelpers helpers = targetBuilder.MemoryBuilder.TargetTestHelpers;","+                MockMemorySpace.HeapFragment shadowFrame = highAllocator.Allocate(16, \"R2RShadowFrame\");","+                helpers.WritePointer(shadowFrame.Data.AsSpan(0, helpers.PointerSize), frameIdentity);","+                helpers.Write(shadowFrame.Data.AsSpan(helpers.PointerSize, sizeof(uint)), LocalVirtualIPHalf);","+                shadowFrameAddr = shadowFrame.Address;","+                icf!.CallSiteSP = shadowFrameAddr;","+            });","+","+        IPlatformAgnosticContext context = IPlatformAgnosticContext.GetContextForPlatform(target);","+        FrameHelpers frameHelpers = new(target);","+        Data.Frame frame = target.ProcessedData.GetOrAdd<Data.Frame>(icf!.Address);","+        frameHelpers.UpdateContextFromFrame(frame, context);","+","+        Assert.Equal(shadowFrameAddr, context.StackPointer.Value);","+        Assert.Equal(Wasm64InitialVirtualIP + FunctionBeginAddress + LocalVirtualIPHalf * 2, context.InstructionPointer.Value);","+        Assert.Equal(shadowFrameAddr, context.FramePointer.Value);","+    }","+","+    // The wasm64 native T_CONTEXT (src/coreclr/pal/inc/pal.h) is a ULONG ContextFlags followed by four","+    // ULONG_PTR slots: InterpreterWalkFramePointer @8, InterpreterSP @16, InterpreterFP @24, InterpreterIP @32.","+    [Fact]","+    public void GetContextForPlatform_Wasm64_MirrorsNativeLayoutAndRoundTripsRegisters()","+    {","+        MockTarget.Architecture wasm64Arch = new() { IsLittleEndian = true, Is64Bit = true };","+        TestPlaceholderTarget target = CreateTarget(","+            wasm64Arch,","+            threadBuilder => threadBuilder.AddThread(1, 1234),","+            runtimeArchitecture: RuntimeInfoArchitecture.Wasm);","+","+        IPlatformAgnosticContext context = IPlatformAgnosticContext.GetContextForPlatform(target);","+        Assert.Equal(40u, context.Size);","+","+        const ulong WalkFramePointer = 0x1_0004_9000;","+        const ulong StackPointer = 0x1_0004_1000;","+        const ulong FramePointer = 0x1_0004_3000;","+        const ulong InstructionPointer = 0x8000_0000_0000_2001;","+        Assert.True(context.TrySetRegister(\"interpreterwalkframepointer\", new TargetNUInt(WalkFramePointer)));","+        context.StackPointer = new TargetPointer(StackPointer);","+        context.FramePointer = new TargetPointer(FramePointer);","+        context.InstructionPointer = new TargetCodePointer(InstructionPointer);","+        context.RawContextFlags = 0x8000000; // CONTEXT_EXCEPTION_ACTIVE","+","+        ReadOnlySpan<byte> bytes = context.GetBytes();","+        Assert.Equal(40, bytes.Length);","+        Assert.Equal(0x8000000u, System.Buffers.Binary.BinaryPrimitives.ReadUInt32LittleEndian(bytes));","+        Assert.Equal(WalkFramePointer, System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(bytes[8..]));","+        Assert.Equal(StackPointer, System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(bytes[16..]));","+        Assert.Equal(FramePointer, System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(bytes[24..]));","+        Assert.Equal(InstructionPointer, System.Buffers.Binary.BinaryPrimitives.ReadUInt64LittleEndian(bytes[32..]));","+","+        IPlatformAgnosticContext copy = IPlatformAgnosticContext.GetContextForPlatform(target);","+        copy.FillFromBuffer(bytes.ToArray());","+        Assert.True(copy.TryReadRegister(\"interpreterwalkframepointer\", out TargetNUInt walkFp));","+        Assert.Equal(WalkFramePointer, walkFp.Value);","+        Assert.Equal(StackPointer, copy.StackPointer.Value);","+        Assert.Equal(FramePointer, copy.FramePointer.Value);","+        Assert.Equal(InstructionPointer, copy.InstructionPointer.Value);","+    }","+","     // A WASM walk seeded from the Frame chain must terminate when an active InlinedCallFrame does","     // not lead to managed code: e