{"id":"0fda86a35419c9c70dbfada224c838c10fbb62ad","axis":"silent","repo":"vllm-project/vllm","sha":"0fda86a35419c9c70dbfada224c838c10fbb62ad","parsed":{"files":[{"path":"docs/models/pooling_models/classify.md","lines":["@@ -43,6 +43,7 @@ The most fundamental application of classification models is to categorize input"," | Architecture | Models | Inputs | Example HF Models | [LoRA](../../features/lora.md) | [PP](../../serving/parallelism_scaling.md) |"," | ------------ | ------ | ------ | ----------------- | ------------------------------ | ------------------------------------------ |"," | `Qwen2_5_VLForSequenceClassification`<sup>C</sup> | Qwen2_5_VL-based | T + I<sup>E+</sup> + V<sup>E+</sup> | `muziyongshixin/Qwen2.5-VL-7B-for-VideoCls` | | |","+| `ShieldGemma2ForImageClassification` | ShieldGemma 2 | T + I<sup>E+</sup> | `google/shieldgemma-2-4b-it` | | |"," | `*ForConditionalGeneration`<sup>C</sup>, `*ForCausalLM`<sup>C</sup>, etc. | Generative models | \\* | N/A | \\* | \\* |"," "," <sup>C</sup> Automatically converted into a classification model via `--convert classify`. ([details](./README.md#model-conversion))  "],"additions":1,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/pooling/test_shieldgemma2.py","lines":["@@ -0,0 +1,133 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import jinja2","+import pytest","+import requests","+from transformers import ShieldGemma2Config","+","+from tests.utils import RemoteOpenAIServer, large_gpu_test","+from vllm.assets.base import VLLM_S3_BUCKET_URL","+from vllm.config import ModelConfig","+from vllm.entrypoints.pooling.classify.protocol import ClassificationResponse","+from vllm.model_executor.models.shieldgemma2 import ShieldGemma2ForImageClassification","+from vllm.transformers_utils.chat_templates import (","+    get_chat_template_override_path,","+)","+from vllm.transformers_utils.model_arch_config_convertor import (","+    ModelArchConfigConvertorBase,","+)","+from vllm.transformers_utils.repo_utils import get_hf_file_to_dict","+","+MODEL_NAME = \"google/shieldgemma-2-4b-it\"","+MODEL_TYPE = \"shieldgemma2\"","+TEMPLATE_PATH = get_chat_template_override_path(MODEL_TYPE, MODEL_NAME)","+BOS = \"<bos>\"","+POLICY = \"No Violence/Gore content: example policy.\"","+IMAGE_URL = f\"{VLLM_S3_BUCKET_URL}/multimodal_asset/cat_snow.jpg\"","+","+","+def render_prompt(template_source: str) -> str:","+    environment = jinja2.Environment(trim_blocks=True, lstrip_blocks=True)","+    template = environment.from_string(template_source)","+    content = [{\"type\": \"image\"}, {\"type\": \"text\", \"text\": POLICY}]","+    return template.render(","+        bos_token=BOS,","+        messages=[{\"role\": \"user\", \"content\": content}],","+        raise_exception=pytest.fail,","+    )","+","+","+def load_hub_template() -> str:","+    config = get_hf_file_to_dict(\"chat_template.json\", MODEL_NAME)","+    assert config is not None, f\"Cannot download {MODEL_NAME} chat template\"","+    return config[\"chat_template\"]","+","+","+def test_template_is_registered_over_the_hub_template():","+    assert TEMPLATE_PATH is not None","+    assert TEMPLATE_PATH.name == \"template_shieldgemma2.jinja\"","+","+","+def test_template_is_hub_template_plus_one_bos():","+    # transformers' ShieldGemma2Processor ends up with two <bos>: the Hub","+    # template writes one and the tokenizer adds another.","+    assert TEMPLATE_PATH is not None","+    ours = render_prompt(TEMPLATE_PATH.read_text())","+    hub = render_prompt(load_hub_template())","+    assert hub.startswith(BOS + \"<start_of_turn>user\\n<start_of_image>\")","+    assert ours == BOS + hub","+","+","+def test_weight_names_map_to_gemma3_layout():","+    mapper = ShieldGemma2ForImageClassification.hf_to_vllm_mapper","+    cases = {","+        \"model.language_model.model.layers.0.mlp.up_proj.weight\": (","+            \"language_model.model.layers.0.mlp.up_proj.weight\"","+        ),","+        \"model.language_model.lm_head.weight\": \"language_model.lm_head.weight\",","+        \"model.vision_tower.vision_model.post_layernorm.weight\": (","+            \"vision_tower.vision_model.post_layernorm.weight\"","+        ),","+        \"model.multi_modal_projector.mm_input_projection_weight\": (","+            \"multi_modal_projector.mm_input_projection_weight\"","+        ),","+    }","+    for original, expected in cases.items():","+        assert mapper.map_name(original) == expected","+","+","+def test_config_selects_two_way_softmax_over_no_yes():","+    model_config = ModelConfig(MODEL_NAME, runner=\"pooling\")","+    hf_config = model_config.hf_config","+    text_config = hf_config.get_text_config()","+","+    assert text_config.method == \"from_2_way_softmax\"","+    assert text_config.classifier_from_token == [\"No\", \"Yes\"]","+    assert hf_config.num_labels == text_config.num_labels == 1","+","+","+def test_config_rejects_logit_softcap():","+    hf_overrides = {\"text_config\": {\"final_logit_softcapping\": 30.0}}","+","+    with pytest.raises(ValueError, match=\"final_logit_softcapping\"):","+        ModelConfig(MODEL_NAME, runner=\"pooling\", hf_overrides=hf_overrides)","+","+","+def test_image_tokens_attend_bidirectionally():","+    # Gemma3 image tokens need the bidirectional (mm prefix) mask; it is keyed","+    # on hf_config.model_type, so \"shieldgemma2\" must be listed too.","+    config = ShieldGemma2Config()","+    convertor = ModelArchConfigConvertorBase(config, config.get_text_config())","+    assert convertor.is_mm_prefix_lm()","+","+","+@pytest.fixture(scope=\"module\")","+def server():","+    args = [\"--runner\", \"pooling\", \"--max-model-len\", \"4096\", \"--enforce-eager\"]","+    with RemoteOpenAIServer(MODEL_NAME, args) as remote_server:","+        yield remote_server","+","+","+@large_gpu_test(min_gb=24)","+def test_classify_image_policy(server: RemoteOpenAIServer):","+    # The template opens a turn per content item, so the image goes first.","+    messages = [","+        {","+            \"role\": \"user\",","+            \"content\": [","+                {\"type\": \"image_url\", \"image_url\": {\"url\": IMAGE_URL}},","+                {\"type\": \"text\", \"text\": POLICY},","+            ],","+        }","+    ]","+","+    response = requests.post(","+        server.url_for(\"classify\"),","+        json={\"model\": MODEL_NAME, \"messages\": messages},","+    )","+    response.raise_for_status()","+","+    output = ClassificationResponse.model_validate(response.json())","+    assert len(output.data) == 1","+    assert len(output.data[0].probs) == 1","+    assert output.data[0].probs[0] < 0.5"],"additions":133,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -775,6 +775,7 @@ def check_available_online(","     \"RobertaForSequenceClassification\": _HfExamplesInfo(","         \"cross-encoder/quora-roberta-base\"","     ),","+    \"ShieldGemma2ForImageClassification\": _HfExamplesInfo(\"google/shieldgemma-2-4b-it\"),","     \"XLMRobertaForSequenceClassification\": _HfExamplesInfo(\"BAAI/bge-reranker-v2-m3\"),"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/config/model.py","lines":["@@ -2601,6 +2601,7 @@ def str_dtype_to_torch_dtype(type: str):","     \"gemma3\": \"Numerical instability. Please use bfloat16 or float32 instead.\",","     \"gemma3_text\": \"Numerical instability. Please use bfloat16 or float32 instead.\",","     \"glm4\": \"Numerical instability. Please use bfloat16 or float32 instead.\",","+    \"shieldgemma2\": \"Numerical instability. Please use bfloat16 or float32 instead.\","," }"," "," "],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/config.py","lines":["@@ -1491,6 +1491,22 @@ def verify_and_update_model_config(model_config: \"ModelConfig\") -> None:","         text_config.classifier_from_token = tokens"," "," ","+class ShieldGemma2ForImageClassificationConfig(VerifyAndUpdateConfig):","+    @staticmethod","+    def verify_and_update_model_config(model_config: \"ModelConfig\") -> None:","+        hf_config = model_config.hf_config","+        text_config = hf_config.get_text_config()","+        # A logit softcap would make the two-way softmax shortcut inexact.","+        if getattr(text_config, \"final_logit_softcapping\", None) is not None:","+            raise ValueError(\"ShieldGemma 2 does not support final_logit_softcapping\")","+","+        # Same Yes/No ids as ShieldGemma2ForImageClassification in transformers.","+        text_config.method = \"from_2_way_softmax\"","+        text_config.classifier_from_token = [\"No\", \"Yes\"]","+        hf_config.num_labels = 1","+        text_config.num_labels = 1","+","+"," class Qwen3VLForSequenceClassificationConfig(Qwen3ForSequenceClassificationConfig):","     pass"," ","@@ -1931,6 +1947,7 @@ def verify_and_update_config(vllm_config: \"VllmConfig\") -> None:","     \"Qwen4ExpForCausalLM\": Qwen4ExpForCausalLMConfig,","     \"Qwen4ExpForConditionalGeneration\": (Qwen4ExpForConditionalGenerationConfig),","     \"Qwen4ExpMTP\": Qwen4ExpMTPConfig,","+    \"ShieldGemma2ForImageClassification\": (ShieldGemma2ForImageClassificationConfig),","     \"UnlimitedOCRForCausalLM\": UnlimitedOCRForCausalLMConfig,","     \"VoyageQwen3BidirectionalEmbedModel\": VoyageQwen3BidirectionalEmbedModelConfig,","     \"XLMRobertaModel\": JinaRobertaModelConfig,"],"additions":17,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/registry.py","lines":["@@ -345,6 +345,10 @@","         \"nemotron_vl\",","         \"LlamaNemotronVLForSequenceClassification\",","     ),","+    \"ShieldGemma2ForImageClassification\": (","+        \"shieldgemma2\",","+        \"ShieldGemma2ForImageClassification\",","+    ),"," }"," "," _MULTIMODAL_MODELS = {"],"additions":4,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/shieldgemma2.py","lines":["@@ -0,0 +1,56 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"ShieldGemma 2 (google/shieldgemma-2-*) served natively as a classifier.","+","+The original checkpoint is a Gemma3 VLM whose answer is the logits of the","+\"Yes\" and \"No\" tokens at the last position. A two-way softmax over those two","+logits equals sigmoid((lm_head[Yes] - lm_head[No]) . h), so the model is a","+Gemma3 converted with `as_seq_cls_model` and the output is P(Yes) of that","+two-way softmax. `ShieldGemma2ForImageClassificationConfig` selects the","+conversion.","+\"\"\"","+","+from typing import TYPE_CHECKING","+","+from transformers import ShieldGemma2Config","+","+from vllm.multimodal import MULTIMODAL_REGISTRY","+","+from .adapters import as_seq_cls_model","+from .gemma3_mm import (","+    Gemma3DummyInputsBuilder,","+    Gemma3ForConditionalGeneration,","+    Gemma3MultiModalProcessor,","+    Gemma3ProcessingInfo,","+)","+from .interfaces_base import default_pooling_type","+from .utils import WeightsMapper","+","+","+class ShieldGemma2ProcessingInfo(Gemma3ProcessingInfo):","+    def get_hf_config(self):","+        return self.ctx.get_hf_config(ShieldGemma2Config)","+","+","+if TYPE_CHECKING:","+    _ShieldGemma2Base = Gemma3ForConditionalGeneration","+else:","+    _ShieldGemma2Base = as_seq_cls_model(Gemma3ForConditionalGeneration)","+","+","+@default_pooling_type(seq_pooling_type=\"LAST\")","+@MULTIMODAL_REGISTRY.register_processor(","+    Gemma3MultiModalProcessor,","+    info=ShieldGemma2ProcessingInfo,","+    dummy_inputs=Gemma3DummyInputsBuilder,","+)","+class ShieldGemma2ForImageClassification(_ShieldGemma2Base):","+    # The checkpoint nests the text model one level deeper than Gemma3's.","+    hf_to_vllm_mapper = WeightsMapper(","+        orig_to_new_prefix={","+            \"model.language_model.model.\": \"language_model.model.\",","+            \"model.language_model.lm_head.\": \"language_model.lm_head.\",","+            \"model.vision_tower.\": \"vision_tower.\",","+            \"model.multi_modal_projector.\": \"multi_modal_projector.\",","+        }","+    )"],"additions":56,"deletions":0,"truncated":false},{"path":"vllm/transformers_utils/chat_templates/registry.py","lines":["@@ -37,6 +37,7 @@ def _get_minicpmv_chat_template_fallback(tokenizer_name_or_path: str) -> Path |","     \"minicpmv4_7\": _get_minicpmv_chat_template_fallback,","     \"openvla\": CHAT_TEMPLATES_DIR / \"template_openvla.jinja\",","     \"paligemma\": CHAT_TEMPLATES_DIR / \"template_basic.jinja\",","+    \"shieldgemma2\": CHAT_TEMPLATES_DIR / \"template_shieldgemma2.jinja\",","     \"siglip\": CHAT_TEMPLATES_DIR / \"template_siglip.jinja\",","     \"siglip2\": CHAT_TEMPLATES_DIR / \"template_siglip.jinja\","," }","@@ -44,7 +45,9 @@ def _get_minicpmv_chat_template_fallback(tokenizer_name_or_path: str) -> Path |"," # Model types whose fallback also replaces a chat template shipped with the"," # tokenizer. SigLIP2 checkpoints (model_type \"siglip\") reuse the Gemma tokenizer,"," # whose chat template wraps embedding text in chat turns and drops EOS.","-_MODEL_TYPES_OVERRIDING_TOKENIZER_CHAT_TEMPLATE = {\"siglip\"}","+# ShieldGemma 2 ships a template with one <bos>; the reference processor feeds","+# the model two.","+_MODEL_TYPES_OVERRIDING_TOKENIZER_CHAT_TEMPLATE = {\"siglip\", \"shieldgemma2\"}"," "," "," def register_chat_template_fallback_path(","@@ -82,7 +85,9 @@ def get_chat_template_override_path("," ) -> Path | None:","     \"\"\"Return the predefined template that replaces the tokenizer's own."," ","-    Only for model types whose Hub tokenizers ship a wrong chat template. Remove","+    Only for model types whose Hub tokenizers ship a wrong chat template. Also","+    for \"shieldgemma2\": its Hub template is right for Transformers, which adds","+    <bos> when tokenizing, but vLLM's chat path does not. Remove","     \"siglip\" from `_MODEL_TYPES_OVERRIDING_TOKENIZER_CHAT_TEMPLATE` once the","     SigLIP2 checkpoints drop the Gemma template upstream:","     https://huggingface.co/google/siglip2-base-patch16-224/discussions/23"],"additions":7,"deletions":2,"truncated":false},{"path":"vllm/transformers_utils/chat_templates/template_shieldgemma2.jinja","lines":["@@ -0,0 +1,33 @@","+{{ bos_token }}{{ bos_token }}","+{%- for message in messages -%}","+    {%- if message['content'] is iterable -%}","+        {%- for item in message['content'] -%}","+            {{ '<start_of_turn>user","+' }}","+            {%- if item['type'] == 'image' -%}","+                {{ '<start_of_image>' }}","+            {%- elif item['type'] == 'text' -%}","+                {{ 'You are a policy expert trying to help determine whether a generated or real image is in' }}","+                {{ ' violation of the safety policy below. Your decision must very clearly follow the specific'}}","+                {{ ' language used in the safety policy and should not include any interpretation outside of the' }}","+                {{ ' safety policy.","+","+' }}","+                {{ '<BEGIN_SAFETY_POLICY>","+' }}","+                {{ item['text'] + '","+' }}","+                {{ '</END_SAFETY_POLICY>","+","+' }}","+                {{ 'Does the image violate the above policy? Your Answer must start with \\'Yes\\' or \\'No\\'.' }}","+                {{ '<end_of_turn>","+' }}","+            {%- endif -%}","+        {%- endfor -%}","+        {{'<start_of_turn>model","+'}}","+    {%- else -%}","+        {{ raise_exception(\"Conversation messages must contain iterable content containing images and policy definitions in text.\") }}","+    {%- endif -%}","+{%- endfor -%}"],"additions":33,"deletions":0,"truncated":false},{"path":"vllm/transformers_utils/model_arch_config_convertor.py","lines":["@@ -365,6 +365,7 @@ def is_mm_prefix_lm(self, supports_multimodal: bool = True) -> bool:","             \"molmo2\",","             \"moondream3\",","             \"paligemma\",","+            \"shieldgemma2\",","         )","         if not hasattr(self.hf_config, \"model_type\"):","             return False",""],"additions":1,"deletions":0,"truncated":false}],"additions":254,"deletions":2,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-20T17:58:38.345749+00:00"}