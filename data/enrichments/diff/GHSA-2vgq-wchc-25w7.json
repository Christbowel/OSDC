{"id":"GHSA-2vgq-wchc-25w7","axis":"advisories","repo":"digitalbazaar/forge","sha":"81774ff99e2da64aec9a43591df45a360040c136","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -173,6 +173,19 @@ Forge ChangeLog","   - Reported by Brian Lee (Georgia Tech SSLab, Team Atlanta).","   - CVE ID: [CVE-TBD]()","   - GHSA ID: [GHSA-9wg5-mj3p-v49q](https://github.com/digitalbazaar/forge/security/advisories/GHSA-9wg5-mj3p-v49q)","+- **LOW**: Incomplete PKCS#7 padding validation in CBC and ECB decryption.","+  - An Improper Validation of Integrity Check Value (CWE-354) vulnerability in","+    node-forge versions 1.4.0 and below makes `decipher.finish()` accept","+    malformed padding in CBC and ECB mode. Only the last byte was checked,","+    against a limit of four blocks, so mismatched padding bytes, a zero count","+    and counts larger than a block were accepted, and up to four blocks of","+    plaintext could be removed. CBC and ECB without a MAC never provide","+    integrity, and this fix doesn't change that; use AES-GCM or authenticate","+    the ciphertext.","+  - Reported by Oren Yomtov (Fireblocks), @zebbern, and Brian Lee (Georgia","+    Tech SSLab, Team Atlanta).","+  - CVE ID: [CVE-TBD]()","+  - GHSA ID: [GHSA-2vgq-wchc-25w7](https://github.com/digitalbazaar/forge/security/advisories/GHSA-2vgq-wchc-25w7)"," "," ### Fixed"," - [rsa] Require a canonical DER DigestInfo in RSASSA PKCS#1 v1.5 signature","@@ -227,6 +240,13 @@ Forge ChangeLog","     when encrypting, now means the default of 128 bits. Data previously","     encrypted with an empty tag can no longer be decrypted, since accepting","     an empty tag is the authentication bypass.","+- [cipher] Require valid PKCS#7 padding when decrypting in CBC and ECB mode:","+  a count from 1 to the block size, and every padding byte equal to the","+  count.","+  - **NOTE**: Data with other padding, such as ANSI X.923, ISO 10126 or","+    XML Encryption padding, used to decrypt because only the last byte was","+    checked, and now fails. To decrypt it, set `decipher.mode.unpad = false`","+    before `finish()` and remove the padding in your code."," "," ## 1.4.0 - 2026-03-24"," "],"additions":20,"deletions":0,"truncated":false},{"path":"lib/cipherModes.js","lines":["@@ -82,13 +82,25 @@ modes.ecb.prototype.unpad = function(output, options) {","     return false;","   }"," ","-  // ensure padding byte count is valid","+  // nothing to unpad, e.g. the caller already read all output","   var len = output.length();","+  if(len === 0) {","+    return true;","+  }","+","+  // ensure padding byte count is valid","   var count = output.at(len - 1);","-  if(count > (this.blockSize << 2)) {","+  if(count === 0 || count > this.blockSize || count > len) {","     return false;","   }"," ","+  // ensure all padding bytes match the padding count (RFC 5652 6.3)","+  for(var i = 2; i <= count; ++i) {","+    if(output.at(len - i) !== count) {","+      return false;","+    }","+  }","+","   // trim off padding bytes","   output.truncate(count);","   return true;","@@ -183,13 +195,25 @@ modes.cbc.prototype.unpad = function(output, options) {","     return false;","   }"," ","-  // ensure padding byte count is valid","+  // nothing to unpad, e.g. the caller already read all output","   var len = output.length();","+  if(len === 0) {","+    return true;","+  }","+","+  // ensure padding byte count is valid","   var count = output.at(len - 1);","-  if(count > (this.blockSize << 2)) {","+  if(count === 0 || count > this.blockSize || count > len) {","     return false;","   }"," ","+  // ensure all padding bytes match the padding count (RFC 5652 6.3)","+  for(var i = 2; i <= count; ++i) {","+    if(output.at(len - i) !== count) {","+      return false;","+    }","+  }","+","   // trim off padding bytes","   output.truncate(count);","   return true;"],"additions":28,"deletions":4,"truncated":false},{"path":"tests/unit/aes.js","lines":["@@ -1687,5 +1687,99 @@ var UTIL = require('../../lib/util');","         })(i);","       }","     })();","+","+    describe('PKCS#7 padding checks', function() {","+      // see GHSA-2vgq-wchc-25w7","+      // Wycheproof aes_cbc_pkcs5_test.json vectors","+      // https://github.com/C2SP/wycheproof","+      var key = 'db4f3e5e3795cc09a073fa6a81e5a6bc';","+      var iv = '23468aa734f5f0f19827316ff168e94f';","+","+      function _decrypt(key, iv, ct) {","+        var decipher = CIPHER.createDecipher('AES-CBC', UTIL.hexToBytes(key));","+        decipher.start({iv: UTIL.hexToBytes(iv)});","+        decipher.update(UTIL.createBuffer(UTIL.hexToBytes(ct)));","+        return decipher.finish() ? decipher.output.toHex() : false;","+      }","+","+      it('should decrypt valid PKCS#7 padding', function() {","+        // tcId 1: empty message, a full block of padding","+        ASSERT.equal(_decrypt(","+          'e34f15c7bd819930fe9d66e0c166e61c',","+          'da9520f7d3520277035173299388bee2',","+          'b10ab60153276941361000414aed0a9d'), '');","+        // tcId 2: message size divisible by block size","+        ASSERT.equal(_decrypt(","+          'e09eaa5a3f5e56d279d5e7a03373f6ea',","+          'c9ee3cd746bf208c65ca9e72a266d54f',","+          'd1fa697f3e2e04d64f1a0da203813ca5' +","+          'bc226a0b1d42287b2a5b994a66eaf14a'),","+        'ef4eab37181f98423e53e947e7050fd0');","+      });","+","+      var invalid = {","+        // tcId 26","+        'zero padding': 'aa62606a287476777b92d8e4c4e53028',","+        // tcId 44","+        'padding longer than 1 block':","+          'd17ccbb26f0aa95f397b20063547349bac24c5429cbea591e96595cccc11451b',","+        // tcId 50","+        'ANSI X.923 padding': 'ca5dd2d09bd56eec9e8acaeca20af68e',","+        // tcId 60","+        'padding longer than the message': 'd17ccbb26f0aa95f397b20063547349b',","+        // tcId 70","+        'mismatched padding bytes':","+          '87ff6a2fc6920ce4769cbf6532f84dde389de7c3b693c5e0ceff182842411005' +","+          'bde40966f0eb8b4f598c61158aebc9d3'","+      };","+      Object.keys(invalid).forEach(function(name) {","+        it('should reject ' + name, function() {","+          ASSERT.strictEqual(_decrypt(key, iv, invalid[name]), false);","+        });","+      });","+","+      ['ecb', 'cbc'].forEach(function(name) {","+        it('should check every padding byte (' + name + ')', function() {","+          var mode = new CIPHER.modes[name]({blockSize: 16});","+          function unpad(bytes) {","+            var buffer = UTIL.createBuffer(bytes);","+            return mode.unpad(buffer, {overflow: 0}) ?","+              buffer.getBytes() : false;","+          }","+          var data = UTIL.fillString('A', 12);","+          ASSERT.equal(unpad(data + '\\x04\\x04\\x04\\x04'), data);","+          ASSERT.equal(","+            unpad(data + 'AAAA' + UTIL.fillString('\\x10', 16)), data + 'AAAA');","+          ASSERT.strictEqual(unpad(data + '\\x03\\x02\\x01\\x04'), false);","+          ASSERT.strictEqual(unpad(data + '\\x04\\x04\\x05\\x04'), false);","+          ASSERT.strictEqual(","+            unpad(data + UTIL.fillString('A', 19) + '\\x20'), false);","+          ASSERT.strictEqual(unpad(data + '\\x00\\x00\\x00\\x00'), false);","+        });","+      });","+","+      it('should decrypt other padding with unpad disabled', function() {","+        // tcId 50 (ANSI X.923 padding): the caller removes the padding","+        var decipher = CIPHER.createDecipher('AES-CBC', UTIL.hexToBytes(key));","+        decipher.mode.unpad = false;","+        decipher.start({iv: UTIL.hexToBytes(iv)});","+        decipher.update(UTIL.createBuffer(","+          UTIL.hexToBytes('ca5dd2d09bd56eec9e8acaeca20af68e')));","+        ASSERT.equal(decipher.finish(), true);","+        ASSERT.equal(decipher.output.toHex(),","+          '00000000000000000000000000000010');","+      });","+","+      it('should finish after all output was read', function() {","+        var decipher = CIPHER.createDecipher(","+          'AES-CBC', UTIL.hexToBytes('e09eaa5a3f5e56d279d5e7a03373f6ea'));","+        decipher.start(","+          {iv: UTIL.hexToBytes('c9ee3cd746bf208c65ca9e72a266d54f')});","+        decipher.update(UTIL.createBuffer(UTIL.hexToBytes(","+          'd1fa697f3e2e04d64f1a0da203813ca5bc226a0b1d42287b2a5b994a66eaf14a')));","+        decipher.output.getBytes();","+        ASSERT.equal(decipher.finish(), true);","+      });","+    });","   });"," })();",""],"additions":94,"deletions":0,"truncated":false}],"additions":142,"deletions":4,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-11T15:37:44.344721+00:00"}