","+                'configured_layout.html.twig',","+                'form.html.twig',","+                'form_div_layout.html.twig',","+                'grandparent_layout.html.twig',","+                'named_layout.html.twig',","+                'parent_layout.html.twig',","+                'unused_layout.html.twig',","+                'unused_parent_layout.html.twig',","+            ],","+            $sorted","+        );","+    }","+","     private function createKernelMock(): Kernel","     {","         $bundle = $this->createStub(BundleInterface::class);",""],"additions":42,"deletions":0,"truncated":false}],"additions":245,"deletions":8,"truncated":false,"file_count":17},"error":null,"fetched_at":"2026-09-28T17:12:17.861435+00:00"}