te());","+","+  startRequest(true);","+","+  // Encoder filter 1 stops headers iteration.","+  EXPECT_CALL(*encoder_filters_[1], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::StopIteration));","+","+  decoder_filters_[1]->callbacks_->streamInfo().setResponseCodeDetails(\"\");","+  decoder_filters_[1]->callbacks_->encodeHeaders(","+      makeHeaderMap<TestResponseHeaderMapImpl>({{\":status\", \"200\"}}), true, \"details\");","+","+  EXPECT_CALL(*encoder_filters_[0], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[0], encodeComplete());","+  EXPECT_CALL(response_encoder_, encodeHeaders(_, true));","+  expectOnDestroy();","+","+  encoder_filters_[1]->callbacks_->injectEncodedHeadersToFilterChain(true);","+}","+","+// Encoder filter calls injectEncodedHeadersToFilterChain a second time, which should be a no-op.","+TEST_F(HttpConnectionManagerImplTest, FilterStopIterationInjectEncodedHeadersCalledTwiceNoOp) {","+  setup();","+  setupFilterChain(2, 2);","+","+  EXPECT_CALL(*decoder_filters_[0], decodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[0], decodeComplete());","+  EXPECT_CALL(*decoder_filters_[1], decodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[1], decodeComplete());","+","+  startRequest(true);","+","+  EXPECT_CALL(*encoder_filters_[1], encodeHeaders(_, false))","+      .WillOnce(Return(FilterHeadersStatus::StopIteration));","+","+  decoder_filters_[1]->callbacks_->streamInfo().setResponseCodeDetails(\"\");","+  decoder_filters_[1]->callbacks_->encodeHeaders(","+      makeHeaderMap<TestResponseHeaderMapImpl>({{\":status\", \"200\"}}), false, \"details\");","+","+  EXPECT_CALL(*encoder_filters_[0], encodeHeaders(_, false))","+      .Times(1)","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(response_encoder_, encodeHeaders(_, false));","+","+  encoder_filters_[1]->callbacks_->injectEncodedHeadersToFilterChain(false);","+  // Second call does not trigger encodeHeaders again.","+  encoder_filters_[1]->callbacks_->injectEncodedHeadersToFilterChain(false);","+","+  EXPECT_CALL(*encoder_filters_[1], encodeData(_, true))","+      .WillOnce(Return(FilterDataStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[1], encodeComplete());","+  EXPECT_CALL(*encoder_filters_[0], encodeData(_, true))","+      .WillOnce(Return(FilterDataStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[0], encodeComplete());","+  EXPECT_CALL(response_encoder_, encodeData(_, true));","+  expectOnDestroy();","+","+  Buffer::OwnedImpl data(\"response body\");","+  decoder_filters_[1]->callbacks_->encodeData(data, true);","+}","+"," // Filter continues headers iteration without ending the stream, then injects a body later."," TEST_F(HttpConnectionManagerImplTest, FilterContinueDontEndStreamInjectBody) {","   setup();"],"additions":236,"deletions":0,"truncated":false},{"path":"test/common/tcp_proxy/tcp_proxy_test.cc","lines":["@@ -1274,6 +1274,7 @@ TEST_P(TcpProxyTest, StreamDecoderFilterCallbacks) {","   Buffer::OwnedImpl inject_data;","   EXPECT_NO_THROW(stream_decoder_callbacks.addDecodedData(inject_data, false));","   EXPECT_NO_THROW(stream_decoder_callbacks.injectDecodedDataToFilterChain(inject_data, false));","+  EXPECT_NO_THROW(stream_decoder_callbacks.injectDecodedHeadersToFilterChain(false));","   EXPECT_NO_THROW(stream_decoder_callbacks.addDecodedData(inject_data, false));","   EXPECT_NO_THROW(stream_decoder_callbacks.addDecodedTrailers());","   EXPECT_NO_THROW(stream_decoder_callbacks.addDecodedMetadata());"],"additions":1,"deletions":0,"truncated":false},{"path":"test/mocks/http/mocks.h","lines":["@@ -324,6 +324,7 @@ class MockStreamDecoderFilterCallbacks : public StreamDecoderFilterCallbacks,","   MOCK_METHOD(void, continueDecoding, ());","   MOCK_METHOD(void, addDecodedData, (Buffer::Instan