acks_->injectEncodedDataToFilterChain(data2, true);"," }"," ","+// Filter stops headers iteration, then injects headers later.","+TEST_F(HttpConnectionManagerImplTest, FilterStopIterationInjectHeaders) {","+  setup();","+  setupFilterChain(2, 2);","+","+  EXPECT_CALL(*decoder_filters_[0], decodeHeaders(_, false))","+      .WillOnce(Return(FilterHeadersStatus::StopIteration));","+","+  // Kick off the incoming request.","+  startRequest(false);","+","+  // Filter 0 now injects headers to the rest of the filter chain.","+  EXPECT_CALL(*decoder_filters_[1], decodeHeaders(_, false))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+","+  decoder_filters_[0]->callbacks_->injectDecodedHeadersToFilterChain(false);","+","+  // Subsequent data is processed normally.","+  EXPECT_CALL(*decoder_filters_[0], decodeData(_, true))","+      .WillOnce(Return(FilterDataStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[0], decodeComplete());","+  EXPECT_CALL(*decoder_filters_[1], decodeData(_, true))","+      .WillOnce(Return(FilterDataStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[1], decodeComplete());","+","+  Buffer::OwnedImpl data(\"hello\");","+  decoder_->decodeData(data, true);","+","+  // Clean up stream by sending response.","+  EXPECT_CALL(*encoder_filters_[1], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[1], encodeComplete());","+  EXPECT_CALL(*encoder_filters_[0], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[0], encodeComplete());","+  EXPECT_CALL(response_encoder_, encodeHeaders(_, true));","+  expectOnDestroy();","+","+  decoder_filters_[1]->callbacks_->streamInfo().setResponseCodeDetails(\"\");","+  decoder_filters_[1]->callbacks_->encodeHeaders(","+      makeHeaderMap<TestResponseHeaderMapImpl>({{\":status\", \"200\"}}), true, \"details\");","+}","+","+// Filter stops headers iteration for a header-only request, then injects headers with end_stream.","+TEST_F(HttpConnectionManagerImplTest, FilterStopIterationInjectHeadersEndStream) {","+  setup();","+  setupFilterChain(2, 2);","+","+  EXPECT_CALL(*decoder_filters_[0], decodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::StopIteration));","+  EXPECT_CALL(*decoder_filters_[0], decodeComplete());","+","+  startRequest(true);","+","+  // Filter 0 now injects headers with end_stream to the rest of the filter chain.","+  EXPECT_CALL(*decoder_filters_[1], decodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[1], decodeComplete());","+","+  decoder_filters_[0]->callbacks_->injectDecodedHeadersToFilterChain(true);","+","+  // Clean up stream by sending response.","+  EXPECT_CALL(*encoder_filters_[1], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[1], encodeComplete());","+  EXPECT_CALL(*encoder_filters_[0], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[0], encodeComplete());","+  EXPECT_CALL(response_encoder_, encodeHeaders(_, true));","+  expectOnDestroy();","+","+  decoder_filters_[1]->callbacks_->streamInfo().setResponseCodeDetails(\"\");","+  decoder_filters_[1]->callbacks_->encodeHeaders(","+      makeHeaderMap<TestResponseHeaderMapImpl>({{\":status\", \"200\"}}), true, \"details\");","+}","+","+// Filter calls injectDecodedHeadersToFilterChain a second time, which should be a no-op.","+TEST_F(HttpConnectionManagerImplTest, FilterStopIterationInjectHeadersCalledTwiceNoOp) {","+  setup();","+  setupFilterChain(2, 2);","+","+  EXPECT_CALL(*decoder_filters_[0], decodeHeaders(_, false))","+      .WillOnce(Return(FilterHeadersStatus::StopIteration));","+","+  startRequest(false);","+","+  EXPECT_CALL(*decoder_filters_[1], decodeHeaders(_, false))","+      .Times(1)","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+","+  decoder_filters_[0]->callbacks_->injectDecodedHeadersToFilterChain(false);","+  // Second call does not trigger decodeHeaders on decoder_filters_[1] again.","+  decoder_filters_[0]->callbacks_->injectDecodedHeadersToFilterChain(false);","+","+  EXPECT_CALL(*decoder_filters_[0], decodeData(_, true))","+      .WillOnce(Return(FilterDataStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[0], decodeComplete());","+  EXPECT_CALL(*decoder_filters_[1], decodeData(_, true))","+      .WillOnce(Return(FilterDataStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[1], decodeComplete());","+","+  Buffer::OwnedImpl data(\"hello\");","+  decoder_->decodeData(data, true);","+","+  EXPECT_CALL(*encoder_filters_[1], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[1], encodeComplete());","+  EXPECT_CALL(*encoder_filters_[0], encodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*encoder_filters_[0], encodeComplete());","+  EXPECT_CALL(response_encoder_, encodeHeaders(_, true));","+  expectOnDestroy();","+","+  decoder_filters_[1]->callbacks_->streamInfo().setResponseCodeDetails(\"\");","+  decoder_filters_[1]->callbacks_->encodeHeaders(","+      makeHeaderMap<TestResponseHeaderMapImpl>({{\":status\", \"200\"}}), true, \"details\");","+}","+","+// Encoder filter stops headers iteration, then injects encoded headers later.","+TEST_F(HttpConnectionManagerImplTest, FilterStopIterationInjectEncodedHeaders) {","+  setup();","+  setupFilterChain(2, 2);","+","+  EXPECT_CALL(*decoder_filters_[0], decodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[0], decodeComplete());","+  EXPECT_CALL(*decoder_filters_[1], decodeHeaders(_, true))","+      .WillOnce(Return(FilterHeadersStatus::Continue));","+  EXPECT_CALL(*decoder_filters_[1], decodeComplete());","+","+  startRequest(true);"