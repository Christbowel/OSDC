sportCredentials(insecure.NewCredentials())),","+\t)","+\texp, err := otlptrace.New(ctx, client)","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { require.NoError(t, exp.Shutdown(ctx)) })","+","+\trequire.NoError(t, exp.ExportSpans(ctx, roSpans))","+}","+","+// Guards against accidental replacement by an unrelated WithDialOption call:","+// it must not silently drop the exporter's default grpc.WithUserAgent dial option.","+func TestWithDialOptionPreservesDefaultUserAgent(t *testing.T) {","+\tmc := runMockCollector(t)","+\tt.Cleanup(func() { require.NoError(t, mc.stop()) })","+","+\tctx := context.Background() //nolint:usetesting // required to avoid getting a canceled context at cleanup.","+\texp := newGRPCExporter(ctx, t, mc.endpoint,","+\t\totlptracegrpc.WithDialOption(grpc.WithConnectParams(grpc.ConnectParams{","+\t\t\tBackoff:           backoff.DefaultConfig,","+\t\t\tMinConnectTimeout: time.Second,","+\t\t})),","+\t)","+\tt.Cleanup(func() { require.NoError(t, exp.Shutdown(ctx)) })","+\trequire.NoError(t, exp.ExportSpans(ctx, roSpans))","+","+\theaders := mc.getHeaders()","+\twantUserAgent := \"OTel OTLP Exporter Go/\" + otlptrace.Version()","+\trequire.Contains(t, headers.Get(\"user-agent\")[0], wantUserAgent)","+}","+","+// Confirms WithDialOption's contract: repeated calls replace, not accumulate.","+func TestWithDialOptionLastCallWins(t *testing.T) {","+\tmc := runMockCollector(t)","+\tt.Cleanup(func() { require.NoError(t, mc.stop()) })","+","+\tconst firstUserAgent, secondUserAgent = \"first-user-agent\", \"second-user-agent\"","+\tctx := context.Background() //nolint:usetesting // required to avoid getting a canceled context at cleanup.","+\texp := newGRPCExporter(ctx, t, mc.endpoint,","+\t\totlptracegrpc.WithDialOption(grpc.WithUserAgent(firstUserAgent)),","+\t\totlptracegrpc.WithDialOption(grpc.WithUserAgent(secondUserAgent)),","+\t)","+\tt.Cleanup(func() { require.NoError(t, exp.Shutdown(ctx)) })","+\trequire.NoError(t, exp.ExportSpans(ctx, roSpans))