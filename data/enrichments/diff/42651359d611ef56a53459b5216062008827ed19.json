{"id":"42651359d611ef56a53459b5216062008827ed19","axis":"silent","repo":"pnpm/pnpm","sha":"42651359d611ef56a53459b5216062008827ed19","parsed":{"files":[{"path":".changeset/dist-tag-oidc.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`pnpm dist-tag add`, `rm`, and `ls` now support OIDC authentication in CI. Enable \"Allow npm dist-tag\" in the package's trusted publishing settings to manage tags without a stored npm token."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/quiet-audience-checks.md","lines":["@@ -0,0 +1,6 @@","+---","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm publish` now uses an `NPM_ID_TOKEN` only if its `aud` claim matches the selected registry, such as `npm:registry.npmjs.org`. A token for another registry is skipped with a warning, and pnpm falls back to the configured credentials."],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_query/registry.rs","lines":["@@ -75,7 +75,7 @@ pub(in super::super) fn dist_tag<'a>("," ) -> miette::Result<CommandFuture<'a>> {","     let cfg: &Config = (ctx.loaders.config)()?;","     Ok(Box::pin(async move {","-        if let Some(output) = args.run(cfg).await? {","+        if let Some(output) = args.run::<CliReporter>(cfg).await? {","             let output = super::super::sanitize::sanitize(&output);","             if output.is_empty() {","                 return Ok(());"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dist_tag.rs","lines":["@@ -12,6 +12,7 @@ use pnpm_network::{","     RetryOpts, ThrottledClient, encode_uri_component, read_limited_body, redact_url_credentials,","     retry_async, send_with_retry,"," };","+use pnpm_reporter::Reporter;"," use registry::{","     DeleteDistTagRequest, SetDistTagRequest, auth_header_for_registry, delete_dist_tag,","     fetch_dist_tags, package_name_for_url, registry_for_package, set_dist_tag,","@@ -175,16 +176,21 @@ struct DistTagContext<'a> {"," }"," "," impl DistTagArgs {","-    pub async fn run(self, config: &Config) -> miette::Result<Option<String>> {","+    pub async fn run<Reporter: self::Reporter>(","+        self,","+        config: &Config,","+    ) -> miette::Result<Option<String>> {","         let context = self.context(config)?;","         let Some(subcommand) = self.params.first().map(String::as_str) else {","-            return dist_tag_ls(&context, &[]).await.map(Some);","+            return dist_tag_ls::<Reporter>(&context, &[]).await.map(Some);","         };","         match subcommand {","-            \"add\" => dist_tag_add(&context, &self.params[1..]).await.map(Some),","-            \"rm\" => dist_tag_rm(&context, &self.params[1..]).await.map(Some),","-            \"ls\" | \"list\" => dist_tag_ls(&context, &self.params[1..]).await.map(Some),","-            _ => dist_tag_ls(&context, &self.params).await.map(Some),","+            \"add\" => dist_tag_add::<Reporter>(&context, &self.params[1..]).await.map(Some),","+            \"rm\" => dist_tag_rm::<Reporter>(&context, &self.params[1..]).await.map(Some),","+            \"ls\" | \"list\" => {","+                dist_tag_ls::<Reporter>(&context, &self.params[1..]).await.map(Some)","+            }","+            _ => dist_tag_ls::<Reporter>(&context, &self.params).await.map(Some),","         }","     }"," ","@@ -207,11 +213,15 @@ impl DistTagArgs {","     }"," }"," ","-async fn dist_tag_ls(context: &DistTagContext<'_>, params: &[String]) -> miette::Result<String> {","+async fn dist_tag_ls<Reporter: self::Reporter>(","+    context: &DistTagContext<'_>,","+    params: &[String],","+) -> miette::Result<String> {","     let package_name = params.first().ok_or(DistTagError::LsPackageRequired)?;","     let package_name = package_name_for_url(package_name)?;","     let registry_url = registry_for_package(context, &package_name);","-    let auth_header = auth_header_for_registry(context, &registry_url, &package_name);","+    let auth_header =","+        auth_header_for_registry::<Reporter>(context, &registry_url, &package_name).await?;","     let dist_tags =","         fetch_dist_tags(context, &package_name, &registry_url, auth_header.as_deref()).await?;","     let mut lines = Vec::with_capacity(dist_tags.len());","@@ -221,7 +231,10 @@ async fn dist_tag_ls(context: &DistTagContext<'_>, params: &[String]) -> miette:","     Ok(lines.join(\"\\n\"))"," }"," ","-async fn dist_tag_add(context: &DistTagContext<'_>, params: &[String]) -> miette::Result<String> {","+async fn dist_tag_add<Reporter: self::Reporter>(","+    context: &DistTagContext<'_>,","+    params: &[String],","+) -> miette::Result<String> {","     let spec = params.first().ok_or(DistTagError::AddSpecRequired)?;","     let PackageSpec { name: package_name, version } = parse_package_spec(spec)?;","     let raw_version = version.ok_or(DistTagError::AddVersionRequired)?;","@@ -230,7 +243,8 @@ async fn dist_tag_add(context: &DistTagContext<'_>, params: &[String]) -> miette","     };","     let tag = params.get(1).map_or(\"latest\", String::as_str);","     let registry_url = registry_for_package(context, &package_name);","-    let auth_header = auth_header_for_registry(context, &registry_url, &package_name);","+    let auth_header =","+        auth_header_for_registry::<Reporter>(context, &registry_url, &package_name).await?;","     let auth_type = if context.otp.is_some() { AuthType::Legacy } else { AuthType::Web };","     set_dist_tag(","         context,","@@ -248,7 +262,10 @@ async fn dist_tag_add(context: &DistTagContext<'_>, params: &[String]) -> miette","     Ok(format!(\"+{tag}: {package_name}@{version}\"))"," }"," ","-async fn dist_tag_rm(context: &DistTagContext<'_>, params: &[String]) -> miette::Result<String> {","+async fn dist_tag_rm<Reporter: self::Reporter>(","+    context: &DistTagContext<'_>,","+    params: &[String],","+) -> miette::Result<String> {","     if params.len() < 2 {","         return Err(DistTagError::RmArgsRequired.into());","     }","@@ -258,7 +275,8 @@ async fn dist_tag_rm(context: &DistTagContext<'_>, params: &[String]) -> miette:","         return Err(DistTagError::RmLatest.into());","     }","     let registry_url = registry_for_package(context, &package_name);","-    let auth_header = auth_header_for_registry(context, &registry_url, &package_name);","+    let auth_header =","+        auth_header_for_registry::<Reporter>(context, &registry_url, &package_name).await?;","     let dist_tags =","         fetch_dist_tags(context, &package_name, &registry_url, auth_header.as_deref()).await?;","     let version = dist_tags"],"additions":30,"deletions":12,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dist_tag/registry.rs","lines":["@@ -11,6 +11,8 @@ use crate::cli_args::{","     },"," };"," use pnpm_network::escaped_package_name;","+use pnpm_publish::{Host, OidcHttpOptions, fetch_token_and_provenance_by_oidc};","+use pnpm_reporter::Reporter;"," "," pub(super) struct SetDistTagRequest<'a> {","     pub(super) package_name: &'a str,","@@ -265,12 +267,30 @@ pub(super) fn registry_for_package(context: &DistTagContext<'_>, package_name: &","     )"," }"," ","-pub(super) fn auth_header_for_registry(","+pub(super) async fn auth_header_for_registry<Reporter: self::Reporter>(","     context: &DistTagContext<'_>,","     registry_url: &str,","     package_name: &str,","-) -> Option<String> {","-    auth_header_for_package(context.config, registry_url, package_name)","+) -> miette::Result<Option<String>> {","+    let config = context.config;","+    let http = OidcHttpOptions {","+        fetch_retries: Some(config.fetch_retries),","+        fetch_retry_factor: Some(f64::from(config.fetch_retry_factor)),","+        fetch_retry_maxtimeout: Some(config.fetch_retry_maxtimeout),","+        fetch_retry_mintimeout: Some(config.fetch_retry_mintimeout),","+        fetch_timeout: Some(config.fetch_timeout),","+    };","+    // Dist-tag requests need only the token, so skip the publish provenance probe.","+    let oidc = fetch_token_and_provenance_by_oidc::<Host, Reporter>(","+        package_name,","+        registry_url,","+        Some(false),","+        &http,","+    )","+    .await?;","+    Ok(oidc","+        .map(|token| format!(\"Bearer {}\", token.auth_token))","+        .or_else(|| auth_header_for_package(config, registry_url, package_name)))"," }"," "," fn dist_tags_url(package_name: &str, registry_url: &str) -> miette::Result<String> {"],"additions":23,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/dist_tag.rs","lines":["@@ -1,3 +1,5 @@","+mod oidc;","+"," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"," use mockito::Matcher;","@@ -43,6 +45,10 @@ fn run_dist_tag_command(","         .with_arg(auth_file)","         .with_arg(command)","         .with_args(args)","+        .without_env(\"NPM_ID_TOKEN\")","+        .without_env(\"GITHUB_ACTIONS\")","+        .without_env(\"ACTIONS_ID_TOKEN_REQUEST_TOKEN\")","+        .without_env(\"ACTIONS_ID_TOKEN_REQUEST_URL\")","         .output()","         .expect(\"spawn pacquet dist-tag\")"," }"],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/dist_tag/oidc.rs","lines":["@@ -0,0 +1,314 @@","+use super::{configure, nerf, pacquet_at};","+use command_extra::CommandExtra;","+use mockito::Matcher;","+use pnpm_testing_utils::bin::CommandTempCwd;","+use std::{fs, path::Path, process::Output};","+","+const NPM_ID_TOKEN: &str = \"header.eyJhdWQiOiJucG06MTI3LjAuMC4xIn0.signature\";","+","+fn run_with_oidc(","+    workspace: &Path,","+    auth_file: &Path,","+    args: &[&str],","+    env: &[(&str, &str)],","+) -> Output {","+    let mut command = pacquet_at(workspace)","+        .with_arg(\"--npmrc-auth-file\")","+        .with_arg(auth_file)","+        .with_arg(\"dist-tag\")","+        .with_args(args)","+        .without_env(\"NPM_ID_TOKEN\")","+        .without_env(\"GITLAB_CI\")","+        .without_env(\"GITHUB_ACTIONS\")","+        .without_env(\"ACTIONS_ID_TOKEN_REQUEST_TOKEN\")","+        .without_env(\"ACTIONS_ID_TOKEN_REQUEST_URL\");","+    command.envs(env.iter().copied());","+    command.output().expect(\"spawn pnpm dist-tag with OIDC token\")","+}","+","+#[test]","+fn oidc_authenticates_add_rm_and_ls_with_registry_override() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let registry = format!(\"{}/\", server.url());","+    let identity_url = format!(\"{}/identity\", server.url());","+    let identity = server","+        .mock(\"GET\", \"/identity\")","+        .match_query(Matcher::Any)","+        .expect(0)","+        .create();","+    let exchange = server","+        .mock(\"POST\", \"/-/npm/v1/oidc/token/exchange/package/@scope%2fpkg\")","+        .match_header(\"authorization\", Matcher::Exact(format!(\"Bearer {NPM_ID_TOKEN}\")))","+        .with_status(200)","+        .with_body(r#\"{\"token\":\"oidc-registry-token\"}\"#)","+        .expect(3)","+        .create();","+    let add = server","+        .mock(\"PUT\", \"/-/package/@scope%2fpkg/dist-tags/beta\")","+        .match_header(\"authorization\", \"Bearer oidc-registry-token\")","+        .match_body(Matcher::Exact(r#\"\"1.0.0\"\"#.to_string()))","+        .with_status(201)","+        .create();","+    let tags = server","+        .mock(\"GET\", \"/-/package/@scope%2fpkg/dist-tags\")","+        .match_header(\"authorization\", \"Bearer oidc-registry-token\")","+        .with_status(200)","+        .with_body(r#\"{\"beta\":\"1.0.0\"}\"#)","+        .expect(2)","+        .create();","+    let remove = server","+        .mock(\"DELETE\", \"/-/package/@scope%2fpkg/dist-tags/beta\")","+        .match_header(\"authorization\", \"Bearer oidc-registry-token\")","+        .with_status(200)","+        .create();","+    let visibility = server","+        .mock(\"GET\", \"/-/package/@scope%2fpkg/visibility\")","+        .expect(0)","+        .create();","+    let auth_contents = format!(\"{}:_authToken=configured-token\\n\", nerf(&registry));","+    let auth_file = configure(root.path(), &workspace, \"http://127.0.0.1:1/\", &auth_contents);","+    let project_npmrc = fs::read(workspace.join(\".npmrc\")).expect(\"read project npmrc\");","+","+    for (args, expected) in [","+        (vec![\"add\", \"@scope/pkg@1.0.0\", \"beta\"], \"+beta: @scope/pkg@1.0.0\\n\"),","+        (vec![\"rm\", \"@scope/pkg\", \"beta\"], \"-beta: @scope/pkg@1.0.0\\n\"),","+        (vec![\"ls\", \"@scope/pkg\"], \"beta: 1.0.0\\n\"),","+    ] {","+        let mut args = args;","+        args.extend([\"--registry\", &registry]);","+        let output = run_with_oidc(","+            &workspace,","+            &auth_file,","+            &args,","+            &[","+                (\"NPM_ID_TOKEN\", NPM_ID_TOKEN),","+                (\"GITHUB_ACTIONS\", \"true\"),","+                (\"ACTIONS_ID_TOKEN_REQUEST_TOKEN\", \"request-token\"),","+                (\"ACTIONS_ID_TOKEN_REQUEST_URL\", &identity_url),","+            ],","+        );","+        assert!(output.status.success(), \"stderr: {}\", String::from_utf8_lossy(&output.stderr));","+        assert_eq!(String::from_utf8_lossy(&output.stdout), expected);","+    }","+","+    exchange.assert();","+    identity.assert();","+    add.assert();","+    tags.assert();","+    remove.assert();","+    visibility.assert();","+    assert_eq!(fs::read(workspace.join(\".npmrc\")).unwrap(), project_npmrc);","+    assert_eq!(fs::read_to_string(&auth_file).unwrap(), auth_contents);","+    drop((root, server));","+}","+","+#[test]","+fn oidc_exchange_rejection_falls_back_to_configured_token() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let registry = format!(\"{}/\", server.url());","+    let exchange = server","+        .mock(\"POST\", \"/-/npm/v1/oidc/token/exchange/package/pkg\")","+        .match_header(\"authorization\", Matcher::Exact(format!(\"Bearer {NPM_ID_TOKEN}\")))","+        .with_status(401)","+        .with_body(r#\"{\"body\":{\"message\":\"exchange rejected\"}}\"#)","+        .create();","+    let add = server","+        .mock(\"PUT\", \"/-/package/pkg/dist-tags/beta\")","+        .match_header(\"authorization\", \"Bearer configured-token\")","+        .with_status(201)","+        .create();","+    let auth_contents = format!(\"{}:_authToken=configured-token\\n\", nerf(&registry));","+    let auth_file = configure(root.path(), &workspace, &registry, &auth_contents);","+","+    let output = run_with_oidc(","+        &workspace,","+        &auth_file,","+        &[\"add\", \"pkg@1.0.0\", \"beta\"],","+        &[(\"NPM_ID_TOKEN\", NPM_ID_TOKEN)],","+    );","+","+    exchange.assert();","+    add.assert();","+    assert!(output.status.success(), \"stderr: {}\", String::from_utf8_lossy(&output.stderr));","+    assert!(String::from_utf8_lossy(&output.stdout).ends_with(\"+beta: pkg@1.0.0\\n\"));","+    assert_eq!(fs::read_to_string(&auth_file).unwrap(), auth_contents);","+    drop((root, server));","+}","+","+#[test]","+fn github_oidc_uses_the_packages_scoped_registry() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let registry = format!(\"{}/\", server.url());","+    let identity = server","+        .mock(\"GET\", \"/identity\")","+        .match_query(Matcher::UrlEncoded(\"audience\".into(), \"npm:127.0.0.1\".into()))","+        .match_header(\"authorization\", \"Bearer request-token\")","+        .with_status(200)","+        .with_body(r#\"{\"value\":\"test-id-token\"}\"#)","+        .create();","+    let exchange = server","+        .mock(\"POST\", \"/-/npm/v1/oidc/token/exchange/package/@scope%2fpkg\")","+        .match_header(\"authorization\", \"Bearer test-id-token\")","+        .with_status(200)","+        .with_body(r#\"{\"token\":\"oidc-registry-token\"}\"#)","+        .create();","+    let tags = server","+        .mock(\"GET\", \"/-/package/@scope%2fpkg/dist-tags\")","+        .match_header(\"authorization\", \"Bearer oidc-registry-token\")","+        .with_status(200)","+        .with_body(r#\"{\"latest\":\"1.0.0\"}\"#)","+        .create();","+    let visibility = server","+        .mock(\"GET\", \"/-/package/@scope%2fpkg/visibility\")","+        .expect(0)","+        .create();","+    let auth_file = configure(root.path(), &workspace, \"http://127.0.0.1:1/\", \"\");","+    fs::write(","+        workspace.join(\".npmrc\"),","+        format!(\"registry=http://127.0.0.1:1/\\n@scope:registry={registry}\\n\"),","+    )","+    .expect(\"write scoped registry\");","+","+    let output = pacquet_at(&workspace)","+        .with_arg(\"--npmrc-auth-file\")","+        .with_arg(&auth_file)","+        .with_args([\"dist-tag\", \"ls\", \"@scope/pkg\"])","+        .without_env(\"NPM_ID_TOKEN\")","+        .without_env(\"GITLAB_CI\")","+        .env(\"GITHUB_ACTIONS\", \"true\")","+        .env(\"ACTIONS_ID_TOKEN_REQUEST_TOKEN\", \"request-token\")","+        .env(\"ACTIONS_ID_TOKEN_REQUEST_URL\", format!(\"{}/identity\", server.url()))","+        .output()","+        .expect(\"spawn pnpm dist-tag with GitHub OIDC\");","+","+    assert!(output.status.success(), \"stderr: {}\", String::from_utf8_lossy(&output.stderr));","+    assert!(String::from_utf8_lossy(&output.stdout).contains(\"latest: 1.0.0\"));","+    identity.assert();","+    exchange.assert();","+    tags.assert();","+    visibility.assert();","+    assert_eq!(fs::read(&auth_file).unwrap(), b\"\");","+    drop((root, server));","+}","+","+#[test]","+fn gitlab_uses_a_forwarded_token_without_provenance() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let registry = format!(\"{}/\", server.url());","+    let exchange = server","+        .mock(\"POST\", \"/-/npm/v1/oidc/token/exchange/package/pkg\")","+        .match_header(\"authorization\", Matcher::Exact(format!(\"Bearer {NPM_ID_TOKEN}\")))","+        .with_status(200)","+        .with_body(r#\"{\"token\":\"oidc-registry-token\"}\"#)","+        .create();","+    let tags = server","+        .mock(\"GET\", \"/-/package/pkg/dist-tags\")","+        .match_header(\"authorization\", \"Bearer oidc-registry-token\")","+        .with_status(200)","+        .with_body(r#\"{\"latest\":\"1.0.0\"}\"#)","+        .create();","+    let visibility = server","+        .mock(\"GET\", \"/-/package/pkg/visibility\")","+        .expect(0)","+        .create();","+    let auth_file = configure(root.path(), &workspace, &registry, \"\");","+    let output = run_with_oidc(","+        &workspace,","+        &auth_file,","+        &[\"ls\", \"pkg\"],","+        &[(\"GITLAB_CI\", \"true\"), (\"NPM_ID_TOKEN\", NPM_ID_TOKEN)],","+    );","+    assert!(output.status.success(), \"stderr: {}\", String::from_utf8_lossy(&output.stderr));","+    assert_eq!(String::from_utf8_lossy(&output.stdout), \"latest: 1.0.0\\n\");","+    exchange.assert();","+    tags.assert();","+    visibility.assert();","+    assert_eq!(fs::read(&auth_file).unwrap(), b\"\");","+    drop((root, server));","+}","+","+#[test]","+fn unavailable_oidc_uses_configured_credentials_without_network_overhead() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let registry = format!(\"{}/\", server.url());","+    let identity_url = format!(\"{}/identity\", server.url());","+    let identity = server","+        .mock(\"GET\", \"/identity\")","+        .match_query(Matcher::Any)","+        .expect(0)","+        .create();","+    let exchange = server","+        .mock(\"POST\", \"/-/npm/v1/oidc/token/exchange/package/pkg\")","+        .expect(0)","+        .create();","+    let add = server","+        .mock(\"PUT\", \"/-/package/pkg/dist-tags/beta\")","+        .match_header(\"authorization\", \"Bearer configured-token\")","+        .with_status(201)","+        .expect(4)","+        .create();","+    let auth_contents = format!(\"{}:_authToken=configured-token\\n\", nerf(&registry));","+    let auth_file = configure(root.path(), &workspace, &registry, &auth_contents);","+    let cases: &[&[(&str, &str)]] = &[","+        &[],","+        &[(\"GITHUB_ACTIONS\", \"true\")],","+        &[(\"GITHUB_ACTIONS\", \"true\"), (\"ACTIONS_ID_TOKEN_REQUEST_URL\", &identity_url)],","+        &[(\"GITLAB_CI\", \"true\")],","+    ];","+    for env in cases {","+        let output = run_with_oidc(&workspace, &auth_file, &[\"add\", \"pkg@1.0.0\", \"beta\"], env);","+        assert!(output.status.success(), \"stderr: {}\", String::from_utf8_lossy(&output.stderr));","+    }","+    identity.assert();","+    exchange.assert();","+    add.assert();","+    assert_eq!(fs::read_to_string(&auth_file).unwrap(), auth_contents);","+    drop((root, server));","+}","+","+#[test]","+fn rejected_github_identity_uses_configured_credentials() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let registry = format!(\"{}/\", server.url());","+    let identity_url = format!(\"{}/identity\", server.url());","+    let identity = server","+        .mock(\"GET\", \"/identity\")","+        .match_query(Matcher::UrlEncoded(\"audience\".into(), \"npm:127.0.0.1\".into()))","+        .match_header(\"authorization\", \"Bearer request-token\")","+        .with_status(403)","+        .with_body(\"forbidden\")","+        .create();","+    let exchange = server","+        .mock(\"POST\", \"/-/npm/v1/oidc/token/exchange/package/pkg\")","+        .expect(0)","+        .create();","+    let add = server","+        .mock(\"PUT\", \"/-/package/pkg/dist-tags/beta\")","+        .match_header(\"authorization\", \"Bearer configured-token\")","+        .with_status(201)","+        .create();","+    let auth_contents = format!(\"{}:_authToken=conf