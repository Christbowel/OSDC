-suggestions';","+","+const homeLink = {","+\tid: 'core/home-link',","+\tname: 'core/home-link',","+\ttitle: 'Home Link',","+\ticon: { src: 'home' },","+};","+const pageList = {","+\tid: 'core/page-list',","+\tname: 'core/page-list',","+\ttitle: 'Page List',","+\ticon: { src: 'list' },","+\tkeywords: [ 'menu', 'navigation' ],","+};","+const pageLinkVariation = {","+\tid: 'core/navigation-link/page',","+\tname: 'core/navigation-link',","+\ttitle: 'Page Link',","+\ticon: { src: 'page' },","+};","+const homePage = {","+\tid: 1,","+\ttitle: 'Home Office',","+\ttype: 'page',","+\tkind: 'post-type',","+\turl: '/home-office',","+};","+const menuPage = {","+\tid: 2,","+\ttitle: 'Menu',","+\ttype: 'page',","+\tkind: 'post-type',","+\turl: '/menu',","+};","+","+describe( 'addBlockSuggestions', () => {","+\tit( 'describes a block as a suggestion that is not a link', () => {","+\t\tconst [ suggestion ] = addBlockSuggestions( [], [ homeLink ], 'Home' );","+","+\t\texpect( suggestion ).toEqual( {","+\t\t\tid: 'core/home-link',","+\t\t\tblockItemId: 'core/home-link',","+\t\t\ttype: BLOCK_SUGGESTION_TYPE,","+\t\t\ttitle: 'Home Link',","+\t\t\ticon: expect.anything(),","+\t\t\ttypeLabel: 'Block',","+\t\t} );","+\t} );","+","+\t// LinkControl renders an icon it is given as is, so the block's icon","+\t// object is turned into an element here, where blocks are known about.","+\tit( 'renders the block icon the way the inserter does', () => {","+\t\tconst [ suggestion ] = addBlockSuggestions( [], [ homeLink ], 'Home' );","+","+\t\texpect( suggestion.icon.type ).toBe( BlockIcon );","+\t\texpect( suggestion.icon.props.icon ).toBe( homeLink.icon );","+\t} );","+","+\tit( 'puts a block whose title starts with the search before the links', () => {","+\t\tconst suggestions = addBlockSuggestions(","+\t\t\t[ homePage ],","+\t\t\t[ homeLink ],","+\t\t\t'home'","+\t\t);","+","+\t\texpect( suggestions.map( ( { title } ) => title ) ).toEqual( [","+\t\t\t'Home Link',","+\t\t\t'Home Office',","+\t\t] );","+\t} );","+","+\tit( 'puts a block that matches any other way after the links', () => {","+\t\t// Page List matches \"menu\" by keyword, not by title.","+\t\tconst suggestions = addBlockSuggestions(","+\t\t\t[ menuPage ],","+\t\t\t[ pageList ],","+\t\t\t'menu'","+\t\t);","+","+\t\texpect( suggestions.map( ( { title } ) => title ) ).toEqual( [","+\t\t\t'Menu',","+\t\t\t'Page List',","+\t\t] );","+\t} );","+","+\tit( 'leaves out the link variations, which the links already cover', () => {","+\t\tconst suggestions = addBlockSuggestions(","+\t\t\t[],","+\t\t\t[ pageLinkVariation ],","+\t\t\t'page'","+\t\t);","+","+\t\texpect( suggestions ).toEqual( [] );","+\t} );","+","+\tit( 'leaves out blocks that cannot be inserted', () => {","+\t\tconst suggestions = addBlockSuggestions(","+\t\t\t[],","+\t\t\t[ { ...homeLink, isDisabled: true } ],","+\t\t\t'home'","+\t\t);","+","+\t\texpect( suggestions ).toEqual( [] );","+\t} );","+","+\tit( 'adds every block that matches', () => {","+\t\tconst items = Array.from( { length: 5 }, ( _, index ) => ( {","+\t\t\tid: `test/home-${ index }`,","+\t\t\tname: `test/home-${ index }`,","+\t\t\ttitle: `Home ${ index }`,","+\t\t} ) );","+","+\t\texpect( addBlockSuggestions( [], items, 'home' ) ).toHaveLength( 5 );","+\t} );","+","+\tit( 'returns the links unchanged when no block matches', () => {","+\t\tconst suggestions = [ homePage ];","+","+\t\texpect(","+\t\t\taddBlockSuggestions( suggestions, [ homeLink ], 'office' )","+\t\t).toBe( suggestions );","+\t} );","+","+\tit( 'returns the links unchanged when nothing is searched', () => {","+\t\tconst suggestions = [ homePage ];","+","+\t\texpect( addBlockSuggestions( suggestions, [ homeLink ], '' ) ).toBe(","+\t\t\tsuggestions","+\t\t);","+\t} );","+","+\t// A site can register a post type called \"block\", whose results arrive","+\t// with that type, so a block is recognized by something only it carries.","+\tit( 'tells a block apart from a post of a type called \"block\"', () => {","+\t\tconst [ blockSuggestion ] = addBlockSuggestions(","+\t\t\t[],","+\t\t\t[ homeLink ],","+\t\t\t'Home'","+\t\t);","+\t\tconst postOfTypeBlock = {","+\t\t\tid: 12,","+\t\t\ttitle: 'Home',","+\t\t\ttype: 'block',","+\t\t\tkind: 'post-type',","+\t\t\turl: '/block/home',","+\t\t};","+","+\t\texpect( isBlockSuggestion( blockSuggestion ) ).toBe( true );","+\t\texpect( isBlockSuggestion( postOfTypeBlock ) ).toBe( false );","+\t} );","+} );"],"additions":158,"deletions":0,"truncated":false},{"path":"packages/block-library/src/navigation-link/shared/use-block-suggestions.js","lines":["@@ -0,0 +1,192 @@","+import { __, sprintf } from '@wordpress/i18n';","+import { speak } from '@wordpress/a11y';","+import { createElement, useCallback } from '@wordpress/element';","+import { useDispatch, useSelect } from '@wordpress/data';","+import {","+\tcreateBlock,","+\tcreateBlocksFromInnerBlocksTemplate,","+} from '@wordpress/blocks';","+import {","+\tBlockIcon,","+\tstore as blockEditorStore,","+\tprivateApis as blockEditorPrivateApis,","+} from '@wordpress/block-editor';","+import { unlock } from '../../lock-unlock';","+","+const { searchItems, normalizeString } = unlock( blockEditorPrivateApis );","+","+/**","+ * The `type` of a suggestion that inserts a block rather than setting a link.","+ */","+export const BLOCK_SUGGESTION_TYPE = 'block';","+","+/**","+ * Whether a suggestion inserts a block rather than setting a link.","+ *","+ * The `type` alone is not enough: a site can register a post type called","+ * \"block\", whose results arrive with that type. Only a block suggestion","+ * carries the inserter item it was made from.","+ *","+ * @param {Object} suggestion A link suggestion.","+ * @return {boolean} Whether it is a block suggestion.","+ */","+export function isBlockSuggestion( suggestion ) {","+\treturn (","+\t\tsuggestion?.type === BLOCK_SUGGESTION_TYPE &&","+\t\ttypeof suggestion.blockItemId === 'string'","+\t);","+}","+","+/**","+ * The link variations are left out: searching already finds the pages, posts","+ * and terms they would link to.","+ */","+const EXCLUDED_BLOCK_NAMES = [ 'core/navigation-link' ];","+","+// Match on what a block is called, not on its description or category, which","+// would list blocks for words that only happen to describe them.","+const SEARCH_FIELDS = [","+\t{ get: ( item ) => item.title },","+\t{ get: ( item ) => item.keywords },","+];","+","+/**","+ * Adds the blocks that match a search to the link suggestions.","+ *","+ * A block whose title starts with the search is what was asked for by name,","+ * so it goes before the links. Any other matching block goes after them.","+ *","+ * @param {Array}  suggestions Link suggestions.","+ * @param {Array}  blockItems  Inserter items the Navigation allows.","+ * @param {string} searchTerm  What the user typed.","+ * @return {Array} The suggestions, with any matching blocks added.","+ */","+export function addBlockSuggestions( suggestions, blockItems, searchTerm ) {","+\tif ( ! searchTerm?.trim() ) {","+\t\treturn suggestions;","+\t}","+","+\tconst matches = searchItems( blockItems, searchTerm, {","+\t\tfields: SEARCH_FIELDS,","+\t\tfilter: ( item ) =>","+\t\t\t! item.isDisabled && ! EXCLUDED_BLOCK_NAMES.includes( item.name ),","+\t} );","+","+\tif ( ! matches.length ) {","+\t\treturn suggestions;","+\t}","+","+\tconst search = normalizeString( searchTerm.trim() );","+\tconst before = [];","+\tconst after = [];","+","+\tfor ( const item of matches ) {","+\t\tconst suggestion = {","+\t\t\tid: item.id,","+\t\t\tblockItemId: item.id,","+\t\t\ttype: BLOCK_SUGGESTION_TYPE,","+\t\t\ttitle: item.title,","+\t\t\ticon: createElement( BlockIcon, { icon: item.icon } ),","+\t\t\ttypeLabel: __( 'Block' ),","+\t\t};","+","+\t\tif ( normalizeString( item.title ).startsWith( search ) ) {","+\t\t\tbefore.push( suggestion );","+\t\t} else {","+\t\t\tafter.push( suggestion );","+\t\t}","+\t}","+","+\treturn [ ...before, ...suggestions, ...after ];","+}","+","+/**","+ * Lists the blocks a Navigation allows in a link's search results, and","+ * inserts the one that is chosen.","+ *","+ * The allowed blocks are read when a search runs, not subscribed to, so an","+ * open link UI does no work as the editor changes.","+ *","+ * @param {Object}    options               Hook options.","+ * @param {string}    options.clientId      Client ID of the link or submenu.","+ * @param {boolean}   options.isEnabled     Whether to list blocks at all.","+ * @param {Function=} options.onBlockInsert Called with the inserted block by a","+ *                                          caller that tracks the new link,","+ *                                          such as the list view.","+ * @param {Function=} options.onClose       Closes the link UI.","+ * @return {{ transformSuggestions: Function|undefined, insertBlockFromSuggestion: Function }}","+ * The `transformSuggestions` to give LinkControl, and the handler for a chosen","+ * block suggestion.","+ */","+export function useBlockSuggestions( {","+\tclientId,","+\tisEnabled,","+\tonBlockInsert,","+\tonClose,","+} ) {","+\tconst {","+\t\tgetBlockIndex,","+\t\tgetBlockOrder,","+\t\tgetBlockRootClientId,","+\t\tgetInserterItems,","+\t} = useSelect( blockEditorStore );","+\tconst { insertBlock, replaceBlock } = useDispatch( blockEditorStore );","+","+\tconst transformSuggestions = useCallback(","+\t\t( suggestions, { isInitialSuggestions, searchTerm } ) =>","+\t\t\tisInitialSuggestions","+\t\t\t\t? suggestions","+\t\t\t\t: addBlockSuggestions(","+\t\t\t\t\t\tsuggestions,","+\t\t\t\t\t\tgetInserterItems( getBlockRootClientId( clientId ) ),","+\t\t\t\t\t\tsearchTerm","+\t\t\t\t\t),","+\t\t[ clientId, getBlockRootClientId, getInserterItems ]","+\t);","+","+\tconst insertBlockFromSuggestion = ( itemId ) => {","+\t\tconst rootClientId = getBlockRootClientId( clientId );","+\t\tconst item = getInserterItems( rootClientId ).find(","+\t\t\t( { id } ) => id === itemId","+\t\t);","+","+\t\tif ( ! item ) {","+\t\t\treturn;","+\t\t}","+","+\t\tconst block = createBlock(","+\t\t\titem.name,","+\t\t\titem.initialAttributes,","+\t\t\tcreateBlocksFromInnerBlocksTemplate( item.innerBlocks )","+\t\t);","+\t\tconst index = getBlockIndex( clientId );","+","+\t\tif ( onBlockInsert ) {","+\t\t\t// A caller that tracks the new link, such as the list view, removes","+\t\t\t// it itself once told about the block, as with the \"Add block\" pane.","+\t\t\tinsertBlock( block, index, rootClientId, false );","+\t\t\tonBlockInsert( block );","+\t\t} else if ( getBlockOrder( clientId ).length ) {","+\t\t\t// A submenu keeps its items, so the block goes before it, where the","+\t\t\t// \"Add block\" pane puts it.","+\t\t\tinsertBlock( block, index, rootClientId );","+\t\t\tonClose?.();","+\t\t} else {","+\t\t\t// An empty link is replaced by the block.","+\t\t\treplaceBlock( clientId, block );","+\t\t}","+","+\t\tspeak(","+\t\t\tsprintf(","+\t\t\t\t/* translators: %s: The title of the block that was added. */","+\t\t\t\t__( '%s block added.' ),","+\t\t\t\titem.title","+\t\t\t)","+\t\t);","+\t};","+","+\treturn {","+\t\ttransformSuggestions: isEnabled ? transformSuggestions : undefined,","+\t\tinsertBlockFromSuggestion,","+\t};","+}"],"additions":192,"deletions":0,"truncated":false},{"path":"test/e2e/specs/editor/blocks/navigation-list-view.spec.js","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":717,"deletions":12,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-10-03T13:28:15.589302+00:00"}