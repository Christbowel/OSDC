{"id":"5039fca81e27597f8ac547a0ebd4b3ec05965d55","axis":"silent","repo":"pnpm/pnpm","sha":"5039fca81e27597f8ac547a0ebd4b3ec05965d55","parsed":{"files":[{"path":".changeset/local-path-parentheses.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+Fixed `pnpm install` failing or writing an incomplete lockfile key when a `file:` dependency path contains parentheses [#18443](https://github.com/pnpm/pnpm/issues/18443)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install.rs","lines":["@@ -1666,3 +1666,34 @@ fn a_publish_directory_beneath_a_registry_package_follows_its_project_manifest()","         \"the frozen install must reject the stale lockfile: {stderr}\",","     );"," }","+","+#[test]","+fn frozen_install_preserves_parentheses_in_local_dependency_paths() {","+    let fixture = WorkspaceFixture::new();","+    let deps = [","+        (\"trailing\", \"file:vendor/(kit)\"),","+        (\"nested\", r\"file:vendor\\(kit)\\component\"),","+        (\"literal\", \"file:vendor/%28kit%29\"),","+    ];","+    fixture.write_root_manifest(\"root\", ManifestDeps { prod: &deps, ..Default::default() });","+    for (alias, specifier) in deps {","+        let directory = fixture.workspace.join(","+            specifier","+                .strip_prefix(\"file:\")","+                .unwrap()","+                .replace('\\\\', \"/\"),","+        );","+        write_project_manifest(&directory, \"example-kit\", ManifestDeps::default());","+        fs::write(directory.join(\"marker\"), alias).unwrap();","+    }","+    assert_success(&fixture.command_at(&fixture.workspace, [\"install\"]));","+    fs::remove_dir_all(fixture.workspace.join(\"node_modules\")).unwrap();","+    assert_success(&fixture.command_at(&fixture.workspace, [\"install\", \"--frozen-lockfile\"]));","+    for (alias, _) in deps {","+        let marker = fixture.workspace","+            .join(\"node_modules\")","+            .join(alias)","+            .