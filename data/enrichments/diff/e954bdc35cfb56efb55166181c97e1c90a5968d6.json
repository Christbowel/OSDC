{"id":"e954bdc35cfb56efb55166181c97e1c90a5968d6","axis":"silent","repo":"projectdiscovery/subfinder","sha":"e954bdc35cfb56efb55166181c97e1c90a5968d6","parsed":{"files":[{"path":"README.md","lines":["@@ -106,6 +106,7 @@ DEBUG:","   -v                  show verbose output","   -nc, -no-color      disable color in output","   -ls, -list-sources  list all available sources (-oJ for JSON)","+  -ck, -check-keys    check the configured provider keys and report their status (-oJ for JSON)"," "," OPTIMIZATION:","   -timeout int                  seconds to wait before timing out (default 30)"],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/runner/initialize.go","lines":["@@ -30,6 +30,8 @@ func (r *Runner) initializePassiveEngine(providerKeys map[string][]string) {"," \t\t}"," \t}"," ","+\tr.providerKeys = keys","+"," \tsources, excluded := slices.Clone(r.options.Sources), slices.Clone(r.options.ExcludeSources)"," \tall, recursive := r.options.All, r.options.OnlyRecursive"," \tr.newPassiveAgent = func() *passive.Agent {"],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/runner/keys.go","lines":["@@ -0,0 +1,217 @@","+package runner","+","+import (","+\t\"cmp\"","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/url\"","+\t\"slices\"","+\t\"strconv\"","+\t\"strings\"","+\t\"sync\"","+\t\"time\"","+","+\t\"github.com/projectdiscovery/subfinder/v2/pkg/passive\"","+\t\"github.com/projectdiscovery/subfinder/v2/pkg/subscraping\"","+)","+","+// keyProbeDomain is enumerated when no -d is given. It only needs to be a","+// domain every source accepts; the key status comes from the responses.","+const keyProbeDomain = \"projectdiscovery.io\"","+","+// KeyStatus is the outcome of probing one provider key.","+type KeyStatus string","+","+const (","+\tKeyValid       KeyStatus = \"valid\"","+\tKeyInvalid     KeyStatus = \"invalid\"","+\tKeyRateLimited KeyStatus = \"rate-limited\"","+\tKeyError       KeyStatus = \"error\"","+\t// KeySkipped means the source did not use the key, usually a malformed one.","+\tKeySkipped KeyStatus = \"skipped\"","+\t// KeyUnverified means the probe got no error and no result, so the key","+\t// could not be confirmed. A timeout or a quota body lands here too.","+\tKeyUnverified KeyStatus = \"unverified\"","+)","+","+// KeyCheck is the result of probing one configured key of a source.","+type KeyCheck struct {","+\tSource string    `json:\"source\"`","+\tKey    int       `json:\"key\"`","+\tStatus KeyStatus `json:\"status\"`","+\tError  string    `json:\"error,omitempty\"`","+}","+","+// CheckKeys probes every configured key of the selected sources, one key per","+// request so a bad key cannot hide behind a good one, and writes a status per key.","+func (r *Runner) CheckKeys(ctx context.Context, writer io.Writer) error {","+\tchecks := r.checkKeys(ctx)","+\tif r.options.JSON {","+\t\tencoder := json.NewEncoder(writer)","+\t\tfor _, check := range checks {","+\t\t\tif err := encoder.Encode(check); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t\treturn nil","+\t}","+\tif len(checks) == 0 {","+\t\t_, err := fmt.Fprintln(writer, \"no provider keys configured\")","+\t\treturn err","+\t}","+\tfor _, check := range checks {","+\t\tline := fmt.Sprintf(\"%s key %d: %s\", check.Source, check.Key, check.Status)","+\t\tif check.Error != \"\" {","+\t\t\tline += \" (\" + check.Error + \")\"","+\t\t}","+\t\tif _, err := fmt.Fprintln(writer, line); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+\treturn nil","+}","+","+func (r *Runner) checkKeys(ctx context.Context) []KeyCheck {","+\tdomain := keyProbeDomain","+\tif len(r.options.Domain) > 0 {","+\t\tdomain = r.options.Domain[0]","+\t}","+","+\tvar (","+\t\tmu     sync.Mutex","+\t\tchecks []KeyCheck","+\t\twg     sync.WaitGroup","+\t)","+\tfor _, name := range r.keyedSources() {","+\t\tkeys := r.providerKeys[name]","+\t\t// One budget per source, shared by all of its keys, so the source's","+\t\t// rate limit holds across the probes.","+\t\tbase := passive.NewWithProviderConfig([]string{name}, nil, false, false, map[string][]string{name: keys})","+\t\tlimiter, err := base.NewRateLimiter(ctx, r.options.RateLimit, r.rateLimit)","+\t\tif err != nil {","+\t\t\tmu.Lock()","+\t\t\tchecks = append(checks, KeyCheck{Source: name, Status: KeyError, Error: err.Error()})","+\t\t\tmu.Unlock()","+\t\t\tcontinue","+\t\t}","+\t\twg.Add(1)","+\t\t// Keys of one source run in sequence to respect its rate limit.","+\t\tgo func(name string, keys []string, limiter *passive.RateLimiter) {","+\t\t\tdefer wg.Done()","+\t\t\tdefer func() { _ = limiter.Close() }()","+\t\t\tfor i, key := range keys {","+\t\t\t\tcheck := r.probeKey(ctx, name, key, domain, limiter)","+\t\t\t\tcheck.Key = i + 1","+\t\t\t\tmu.Lock()","+\t\t\t\tchecks = append(checks, check)","+\t\t\t\tmu.Unlock()","+\t\t\t}","+\t\t}(name, keys, limiter)","+\t}","+\twg.Wait()","+","+\tslices.SortFunc(checks, func(a, b KeyCheck) int {","+\t\treturn cmp.Or(cmp.Compare(a.Source, b.Source), cmp.Compare(a.Key, b.Key))","+\t})","+\treturn checks","+}","+","+// keyedSources returns the names of the sources with configured keys, narrowed","+// by -s and -es. Custom sources registered in NameSourceMap are included.","+func (r *Runner) keyedSources() []string {","+\tvar names []string","+\tfor name, source := range passive.NameSourceMap {","+\t\tif source.KeyRequirement() == subscraping.NoKey || len(r.providerKeys[name]) == 0 {","+\t\t\tcontinue","+\t\t}","+\t\tif len(r.options.Sources) > 0 && !slices.Contains(r.options.Sources, name) {","+\t\t\tcontinue","+\t\t}","+\t\tif slices.Contains(r.options.ExcludeSources, name) {","+\t\t\tcontinue","+\t\t}","+\t\tnames = append(names, name)","+\t}","+\treturn names","+}","+","+func (r *Runner) probeKey(ctx context.Context, name, key, domain string, limiter *passive.RateLimiter) KeyCheck {","+\tctx, cancel := context.WithCancel(ctx)","+\tdefer cancel()","+","+\tagent := passive.NewWithProviderConfig([]string{name}, nil, false, false, map[string][]string{name: {key}})","+\tresults := agent.EnumerateSubdomainsWithCtx(ctx, domain, r.options.Proxy, r.options.RateLimit, r.options.Timeout,","+\t\ttime.Duration(r.options.Timeout)*time.Second,","+\t\tpassive.WithRateLimiter(limiter),","+\t\tpassive.WithMaxResults(1),","+\t\tpassive.WithMaxResponseBodySize(int64(r.options.MaxResponseBodySize)),","+\t)","+","+\t// A key is valid only when the source returned a result for it. No error","+\t// and no result (a quota body, a timeout) cannot confirm the key.","+\tcheck := KeyCheck{Source: name, Status: KeyUnverified}","+\tvar firstErr error","+\tfor result := range results {","+\t\tswitch result.Type {","+\t\tcase subscraping.Subdomain:","+\t\t\t// One result proves the key works; stop spending its quota.","+\t\t\tcheck.Status = KeyValid","+\t\t\tfirstErr = nil","+\t\t\tcancel()","+\t\tcase subscraping.Error:","+\t\t\tif check.Status != KeyValid && firstErr == nil && ctx.Err() == nil {","+\t\t\t\tfirstErr = result.Error","+\t\t\t}","+\t\t}","+\t}","+\tswitch {","+\tcase check.Status == KeyValid:","+\tcase firstErr != nil:","+\t\tcheck.Status, check.Error = classifyKeyError(firstErr, key)","+\tcase agent.GetStatistics()[name].Skipped:","+\t\tcheck.Status = KeySkipped","+\t}","+\treturn check","+}","+","+func classifyKeyError(err error, key string) (KeyStatus, string) {","+\tvar statusErr *subscraping.StatusCodeError","+\tif errors.As(err, &statusErr) {","+\t\tmessage := fmt.Sprintf(\"status %d\", statusErr.StatusCode)","+\t\tswitch statusErr.StatusCode {","+\t\tcase http.StatusUnauthorized, http.StatusForbidden:","+\t\t\treturn KeyInvalid, message","+\t\tcase http.StatusTooManyRequests:","+\t\t\treturn KeyRateLimited, message","+\t\t}","+\t\treturn KeyError, message","+\t}","+\treturn KeyError, redactKey(err.Error(), key)","+}","+","+// minRedactLen keeps short fragments of a key from mangling unrelated text.","+const minRedactLen = 6","+","+// redactKey removes the key from an error message, since sources often put it","+// in the request URL. Multi-part keys (\"user:secret\") are redacted per part.","+// Each part is also redacted in its escaped and URL-encoded forms, because Go","+// quotes a key with a newline or special characters before it reaches the error.","+func redactKey(message, key string) string {","+\tfor _, part := range append([]string{key}, strings.Split(key, \":\")...) {","+\t\tif len(part) < minRedactLen {","+\t\t\tcontinue","+\t\t}","+\t\tforms := []string{part, url.QueryEscape(part), url.PathEscape(part)}","+\t\tif quoted := strconv.Quote(part); len(quoted) >= 2 {","+\t\t\tforms = append(forms, quoted[1:len(quoted)-1])","+\t\t}","+\t\tfor _, form := range forms {","+\t\t\tmessage = strings.ReplaceAll(message, form, \"[redacted]\")","+\t\t}","+\t}","+\treturn message","+}"],"additions":217,"deletions":0,"truncated":false},{"path":"pkg/runner/keys_test.go","lines":["@@ -0,0 +1,167 @@","+package runner","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"sync\"","+\t\"testing\"","+","+\t\"github.com/projectdiscovery/subfinder/v2/pkg/passive\"","+\t\"github.com/projectdiscovery/subfinder/v2/pkg/subscraping\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// keyedSource sends its key in the query string, as many real sources do, and","+// skips like they do when the key is malformed.","+type keyedSource struct {","+\turl     string","+\tmu      sync.Mutex","+\tkey     string","+\tskipped bool","+}","+","+func (s *keyedSource) Run(ctx context.Context, domain string, session *subscraping.Session) <-chan subscraping.Result {","+\tresults := make(chan subscraping.Result)","+\tgo func() {","+\t\tdefer close(results)","+\t\ts.mu.Lock()","+\t\tkey := s.key","+\t\ts.skipped = key == \"malformed\"","+\t\ts.mu.Unlock()","+\t\tif key == \"malformed\" {","+\t\t\treturn","+\t\t}","+\t\tresp, err := session.SimpleGet(ctx, s.url+\"?apikey=\"+key)","+\t\tresult := subscraping.Result{Type: subscraping.Subdomain, Source: s.Name(), Value: \"www.\" + domain}","+\t\tif err != nil {","+\t\t\tresult = subscraping.Result{Type: subscraping.Error, Source: s.Name(), Error: err}","+\t\t}","+\t\tsession.DiscardHTTPResponse(resp)","+\t\tresults <- result","+\t}()","+\treturn results","+}","+func (*keyedSource) Name() string                               { return \"test-keyed\" }","+func (*keyedSource) IsDefault() bool                            { return false }","+func (*keyedSource) HasRecursiveSupport() bool                  { return false }","+func (*keyedSource) NeedsKey() bool                             { return true }","+func (*keyedSource) KeyRequirement() subscraping.KeyRequirement { return subscraping.RequiredKey }","+func (s *keyedSource) AddApiKeys(keys []string) {","+\ts.mu.Lock()","+\tdefer s.mu.Unlock()","+\ts.key = keys[0]","+}","+func (s *keyedSource) Statistics() subscraping.Statistics {","+\ts.mu.Lock()","+\tdefer s.mu.Unlock()","+\treturn subscraping.Statistics{Skipped: s.skipped}","+}","+","+func TestCheckKeys(t *testing.T) {","+\tstatusByKey := map[string]int{\"good\": 200, \"revoked\": 401, \"banned\": 403, \"exhausted\": 429, \"secret-broken\": 500}","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tw.WriteHeader(statusByKey[r.URL.Query().Get(\"apikey\")])","+\t}))","+\tdefer server.Close()","+","+\tsource := &keyedSource{url: server.URL}","+\tname := source.Name()","+\tpassive.NameSourceMap[name] = source","+\tt.Cleanup(func() { delete(passive.NameSourceMap, name) })","+","+\tr := &Runner{","+\t\toptions: &Options{Timeout: 5, JSON: true, Sources: []string{name}},","+\t\tproviderKeys: map[string][]string{","+\t\t\tname: {\"good\", \"revoked\", \"banned\", \"exhausted\", \"secret-broken\", \"malformed\"},","+\t\t},","+\t}","+\tvar out strings.Builder","+\trequire.NoError(t, r.CheckKeys(context.Background(), &out))","+","+\tvar got []KeyCheck","+\tfor _, line := range strings.Split(strings.TrimSpace(out.String()), \"\\n\") {","+\t\tvar check KeyCheck","+\t\trequire.NoError(t, json.Unmarshal([]byte(line), &check))","+\t\tgot = append(got, check)","+\t}","+\trequire.Equal(t, []KeyCheck{","+\t\t{Source: name, Key: 1, Status: KeyValid},","+\t\t{Source: name, Key: 2, Status: KeyInvalid, Error: \"status 401\"},","+\t\t{Source: name, Key: 3, Status: KeyInvalid, Error: \"status 403\"},","+\t\t{Source: name, Key: 4, Status: KeyRateLimited, Error: \"status 429\"},","+\t\t{Source: name, Key: 5, Status: KeyError, Error: \"status 500\"},","+\t\t{Source: name, Key: 6, Status: KeySkipped},","+\t}, got)","+\trequire.NotContains(t, out.String(), \"secret\")","+}","+","+func TestRedactKey(t *testing.T) {","+\tmessage := `Get \"https://api.example/?email=me@example.com&key=s3cr3t\": dial tcp: timeout`","+\trequire.Equal(t, `Get \"https://api.example/?email=[redacted]&key=[redacted]\": dial tcp: timeout`, redactKey(message, \"me@example.com:s3cr3t\"))","+}","+","+// silentSource accepts any key and returns nothing, like a quota body or a","+// timeout does. Its key must not be reported as valid.","+type silentSource struct{}","+","+func (*silentSource) Run(_ context.Context, _ string, _ *subscraping.Session) <-chan subscraping.Result {","+\tresults := make(chan subscraping.Result)","+\tclose(results)","+\treturn results","+}","+func (*silentSource) Name() string                               { return \"test-silent\" }","+func (*silentSource) IsDefault() bool                            { return false }","+func (*silentSource) HasRecursiveSupport() bool                  { return false }","+func (*silentSource) NeedsKey() bool                             { return true }","+func (*silentSource) KeyRequirement() subscraping.KeyRequirement { return subscraping.RequiredKey }","+func (*silentSource) AddApiKeys([]string)                        {}","+func (*silentSource) Statistics() subscraping.Statistics         { return subscraping.Statistics{} }","+","+func TestCheckKeysNoResultIsUnverified(t *testing.T) {","+\tsource := &silentSource{}","+\tname := source.Name()","+\tpassive.NameSourceMap[name] = source","+\tt.Cleanup(func() { delete(passive.NameSourceMap, name) })","+","+\tr := &Runner{","+\t\toptions:      &Options{Timeout: 5, JSON: true, Sources: []string{name}},","+\t\tproviderKeys: map[string][]string{name: {\"unconfirmed-key\"}},","+\t}","+\tvar out strings.Builder","+\trequire.NoError(t, r.CheckKeys(context.Background(), &out))","+\trequire.Contains(t, out.String(), `\"status\":\"unverified\"`)","+\trequire.NotContains(t, out.String(), `\"status\":\"valid\"`)","+}","+","+func TestRedactKeyQuotedAndShortParts(t *testing.T) {","+\t// A key with a newline reaches the error quoted, as \\n.","+\trequire.Equal(t, `Get \"https://api.example/?k=[redacted]\": refused`,","+\t\tredactKey(`Get \"https://api.example/?k=abc\\ndef-secret\": refused`, \"abc\\ndef-secret\"))","+\t// A short part (under minRedactLen) must not mangle unrelated text.","+\trequire.Equal(t, `reason: abx [redacted]`, redactKey(\"reason: abx verylongsecret\", \"ab:verylongsecret\"))","+}","+","+// -check-keys with -o must write the report to the file, not only to stdout.","+func TestCheckKeysWritesOutputFile(t *testing.T) {","+\tsource := &silentSource{}","+\tname := source.Name()","+\tpassive.NameSourceMap[name] = source","+\tt.Cleanup(func() { delete(passive.NameSourceMap, name) })","+","+\tfile := filepath.Join(t.TempDir(), \"keys.json\")","+\tr := &Runner{","+\t\toptions: &Options{Timeout: 5, JSON: true, CheckKeys: true, Sources: []string{name},","+\t\t\tOutputFile: file, Output: io.Discard},","+\t\tproviderKeys: map[string][]string{name: {\"unconfirmed-key\"}},","+\t}","+\trequire.NoError(t, r.RunEnumerationWithCtx(context.Background()))","+\tdata, err := os.ReadFile(file)","+\trequire.NoError(t, err)","+\trequire.Contains(t, string(data), `\"status\":\"unverified\"`)","+}"],"additions":167,"deletions":0,"truncated":false},{"path":"pkg/runner/options.go","lines":["@@ -38,6 +38,7 @@ type Options struct {"," \tHostIP             bool                // HostIP specifies whether to write subdomains in host:ip format"," \tSilent             bool                // Silent suppresses any extra text and only writes subdomains to screen"," \tListSources        bool                // ListSources specifies whether to list all available sources","+\tCheckKeys          bool                // CheckKeys probes each configured provider key and reports its status"," \tRemoveWildcard     bool                // RemoveWildcard specifies whether to remove potential wildcard or dead subdomains from the results."," \tCaptureSources     bool                // CaptureSources specifies whether to save all sources that returned a specific domains or just the first source"," \tStdin              bool                // Stdin specifies whether stdin input was given to the process","@@ -149,6 +150,7 @@ func ParseOptions() *Options {"," \t\tflagSet.BoolVar(&options.Verbose, \"v\", false, \"show verbose output\"),"," \t\tflagSet.BoolVarP(&options.NoColor, \"no-color\", \"nc\", false, \"disable color in output\"),"," \t\tflagSet.BoolVarP(&options.ListSources, \"list-sources\", \"ls\", false, \"list all available sources (-oJ for JSON)\"),","+\t\tflagSet.BoolVarP(&options.CheckKeys, \"check-keys\", \"ck\", false, \"check the configured provider keys and report their status (-oJ for JSON)\"),"," \t\tflagSet.BoolVar(&options.Statistics, \"stats\", false, \"report source statistics\"),"," \t)"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/runner/runner.go","lines":["@@ -30,6 +30,7 @@ import ("," type Runner struct {"," \toptions           *Options"," \tpassiveAgent      *passive.Agent","+\tproviderKeys      map[string][]string"," \tresolverClient    *resolve.Resolver"," \trateLimit         *subscraping.CustomRateLimit"," \tnewPassiveAgent   func() *passive.Agent","@@ -101,6 +102,19 @@ func (r *Runner) RunEnumeration() error {"," "," // RunEnumerationWithCtx runs the subdomain enumeration flow on the targets specified"," func (r *Runner) RunEnumerationWithCtx(ctx context.Context) error {","+\tif r.options.CheckKeys {","+\t\twriter := r.options.Output","+\t\tif r.options.OutputFile != \"\" {","+\t\t\tfile, err := NewOutputWriter(r.options.JSON).createFile(r.options.OutputFile, false)","+\t\t\tif err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t\tdefer func() { _ = file.Close() }()","+\t\t\twriter = io.MultiWriter(r.options.Output, file)","+\t\t}","+\t\treturn r.CheckKeys(ctx, writer)","+\t}","+"," \toutputs := []io.Writer{r.options.Output}"," "," \tif len(r.options.Domain) > 0 {"],"additions":14,"deletions":0,"truncated":false},{"path":"pkg/runner/validate.go","lines":["@@ -18,7 +18,7 @@ import ("," func (options *Options) validateOptions() error {"," \t// Check if domain, list of domains, or stdin info was provided."," \t// If none was provided, then return.","-\tif len(options.Domain) == 0 && options.DomainsFile == \"\" && !options.Stdin {","+\tif !options.CheckKeys && len(options.Domain) == 0 && options.DomainsFile == \"\" && !options.Stdin {"," \t\treturn errors.New(\"no input list provided\")"," \t}"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/subscraping/agent.go","lines":["@@ -189,7 +189,17 @@ func httpRequestWrapper(client *http.Client, request *http.Request, maxResponseB"," \t\t\t_, _ = buffer.ReadFrom(response.Body)"," \t\t\treturn fmt.Sprintf(\"Response for failed request against %s:\\n%s\", requestURL, buffer.String())"," \t\t})","-\t\treturn response, fmt.Errorf(\"unexpected status code %d received from %s\", response.StatusCode, requestURL)","+\t\treturn response, &StatusCodeError{StatusCode: response.StatusCode, URL: requestURL}"," \t}"," \treturn response, nil"," }","+","+// StatusCodeError is returned for a source response whose status is not 200 OK.","+type StatusCodeError struct {","+\tStatusCode int","+\tURL        string","+}","+","+func (e *StatusCodeError) Error() string {","+\treturn fmt.Sprintf(\"unexpected status code %d received from %s\", e.StatusCode, e.URL)","+}"],"additions":11,"deletions":1,"truncated":false},{"path":"pkg/subscraping/sources/virustotal/virustotal.go","lines":["@@ -79,7 +79,10 @@ func (s *Source) Run(ctx context.Context, domain string, session *subscraping.Se"," \t\t\t\t// generic \"unexpected status code 429\" so operators know to supply an"," \t\t\t\t// enterprise key or lower the scope (see #1718)."," \t\t\t\tif resp != nil && resp.StatusCode == http.StatusTooManyRequests {","-\t\t\t\t\terr = fmt.Errorf(\"virustotal quota exhausted (HTTP 429); some subdomains for %s may be missing\", domain)","+\t\t\t\t\t// Wrap the status error so callers such as -check-keys can","+\t\t\t\t\t// still classify the 429 as rate-limited.","+\t\t\t\t\terr = fmt.Errorf(\"virustotal quota exhausted (HTTP 429); some subdomains for %s may be missing: %w\", domain,","+\t\t\t\t\t\t&subscraping.StatusCodeError{StatusCode: http.StatusTooManyRequests, URL: url})"," \t\t\t\t}"," \t\t\t\tresults <- subscraping.Result{Source: s.Name(), Type: subscraping.Error, Error: err}"," \t\t\t\tstats.Errors++",""],"additions":4,"deletions":1,"truncated":false}],"additions":419,"deletions":3,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-26T18:56:14.455889+00:00"}