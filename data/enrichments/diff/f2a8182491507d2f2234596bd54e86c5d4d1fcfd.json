on( \"Different instances registered for pessimistic force increment: \" + key );","+\t\t}","+\t}","+","+\t/// Called after every post-load notification for a cursor's logical result.","+\tpublic void finishLogicalResult() {","+\t\tcheckActive();","+\t\tif ( cursorAcquisition != null ) {","+\t\t\tcursorAcquisition.run();","+\t\t}","+\t}","+","+\tpublic void registerCursorAcquisition(Runnable acquisition) {","+\t\tcursorAcquisition = acquisition;","+\t}","+","+\t/// Complete the whole acquisition unit before starting any owned increment.","+\t/// Integrations retain their existing acquisition and cache helper extension points.","+\tpublic void complete(Runnable acquisition, SharedSessionContractImplementor session) {","+\t\tcheckActive();","+\t\ttry {","+\t\t\tpending.forEach( (key, entity) -> managedEntry( key, entity, session ) );","+\t\t\tacquisition.run();","+\t\t\tpending.forEach( (key, entity) -> {","+\t\t\t\tfinal var entry = managedEntry( key, entity, session );","+\t\t\t\tif ( entry.getLockMode().lessThan( LockMode.PESSIMISTIC_FORCE_INCREMENT ) ) {","+\t\t\t\t\tOptimisticLockHelper.forceVersionIncrement( entity, entry, session );","+\t\t\t\t}","+\t\t\t} );","+\t\t\tpending.clear();","+\t\t}","+\t\tcatch (RuntimeException | Error failure) {","+\t\t\tfail();","+\t\t\tthrow failure;","+\t\t}","+\t}","+","+\tpublic void fail() {","+\t\tfailed = true;","+\t\tpending.clear();","+\t}","+","+\tpublic void checkActive() {","+\t\tif ( failed ) {","+\t\t\tthrow new HibernateException( \"Cannot resume failed direct-locking completion\" );","+\t\t}","+\t}","+","+\tprivate static EntityEntry managedEntry(EntityKey key, Object entity, SharedSessionContractImplementor session) {","+\t\tfinal var context = session.getPersistenceContextInternal();","+\t\tfinal var entry = context.getEntry( entity );","+\t\tif ( entry == null || context.getEntity( key ) != entity ) {","+\t\t\tthrow new HibernateException( \"Cannot complete pessimistic force increment for \" + key","+\t\t\t\t\t