{"id":"cc0dcce3339faf69de4b6ba5b19dd24ff4a2d1a6","axis":"silent","repo":"redis/go-redis","sha":"cc0dcce3339faf69de4b6ba5b19dd24ff4a2d1a6","parsed":{"files":[{"path":"README.md","lines":["@@ -199,6 +199,15 @@ type Credentials interface {"," }"," ```"," ","+Providers can optionally implement `auth.ContextStreamingCredentialsProvider` by","+adding `SubscribeWithContext(ctx, listener)` alongside `Subscribe`. go-redis uses","+this method during connection initialization so the caller's context can bound","+the wait for credentials. This applies whether or not `ContextTimeoutEnabled` is","+set. Canceling that context must not end an established subscription or cancel","+token acquisition shared with other connections. Providers","+and wrappers without this method retain synchronous `Subscribe` behavior; there","+is no goroutine fallback. go-redis-entraid v1.1.0 and later support this method.","+"," Example usage:"," ```go"," rdb := redis.NewClient(&redis.Options{"],"additions":9,"deletions":0,"truncated":false},{"path":"auth/auth.go","lines":["@@ -2,6 +2,8 @@"," // It also includes a basic implementation of credentials using username and password."," package auth"," ","+import \"context\"","+"," // StreamingCredentialsProvider is an interface that defines the methods for a streaming credentials provider."," // It is used to provide credentials for authentication."," // The CredentialsListener is used to receive updates when the credentials change.","@@ -21,10 +23,21 @@ type StreamingCredentialsProvider interface {"," \t// the most recently returned UnsubscribeFunc and rely on it to fully"," \t// unsubscribe the listener."," \t//","-\t// TODO(ndyakov): Should we add context to the Subscribe method?"," \tSubscribe(listener CredentialsListener) (Credentials, UnsubscribeFunc, error)"," }"," ","+// ContextStreamingCredentialsProvider is an optional extension for providers","+// that can cooperatively cancel subscription setup using the caller's context.","+// The context bounds only the initial SubscribeWithContext call; it does not","+// define the lifetime of a successfully established subscription. Canceling one","+// caller must not abort token acquisition or subscriptions shared by other","+// connections. Provider wrappers must forward SubscribeWithContext to retain","+// this behavior; otherwise go-redis calls the legacy Subscribe method.","+type ContextStreamingCredentialsProvider interface {","+\tStreamingCredentialsProvider","+\tSubscribeWithContext(ctx context.Context, listener CredentialsListener) (Credentials, UnsubscribeFunc, error)","+}","+"," // UnsubscribeFunc is a function that is used to cancel the subscription to the credentials provider."," // It is used to unsubscribe from the provider when the credentials are no longer needed."," //"],"additions":14,"deletions":1,"truncated":false},{"path":"auth_context_streaming.go","lines":["@@ -0,0 +1,18 @@","+package redis","+","+import (","+\t\"context\"","+","+\t\"github.com/redis/go-redis/v9/auth\"","+)","+","+func subscribeStreamingCredentials(","+\tctx context.Context,","+\tprovider auth.StreamingCredentialsProvider,","+\tlistener auth.CredentialsListener,","+) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tif contextProvider, ok := provider.(auth.ContextStreamingCredentialsProvider); ok {","+\t\treturn contextProvider.SubscribeWithContext(ctx, listener)","+\t}","+\treturn provider.Subscribe(listener)","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"auth_context_streaming_test.go","lines":["@@ -0,0 +1,412 @@","+package redis","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"io\"","+\t\"net\"","+\t\"sync\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/redis/go-redis/v9/auth\"","+\t\"github.com/redis/go-redis/v9/internal/pool\"","+\t\"github.com/redis/go-redis/v9/internal/proto\"","+\t\"github.com/redis/go-redis/v9/maintnotifications\"","+)","+","+type contextStreamingTestProvider struct {","+\tcalled       chan context.Context","+\twait         bool","+\tregistered   *atomic.Bool","+\tunsubscribed chan struct{}","+}","+","+func (p *contextStreamingTestProvider) Subscribe(auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tpanic(\"legacy Subscribe called\")","+}","+","+func (p *contextStreamingTestProvider) SubscribeWithContext(ctx context.Context, listener auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tp.called <- ctx","+\tif p.wait {","+\t\t<-ctx.Done()","+\t\treturn nil, nil, ctx.Err()","+\t}","+\tif p.registered != nil {","+\t\tp.registered.Store(true)","+\t}","+\treturn auth.NewBasicCredentials(\"user\", \"pass\"), func() error {","+\t\tif p.unsubscribed != nil {","+\t\t\tclose(p.unsubscribed)","+\t\t}","+\t\treturn nil","+\t}, nil","+}","+","+func TestSubscribeStreamingCredentialsPrefersContextMethod(t *testing.T) {","+\tctx, cancel := context.WithCancel(context.Background())","+\tdefer cancel()","+\tprovider := &contextStreamingTestProvider{","+\t\tcalled:       make(chan context.Context, 1),","+\t\tunsubscribed: make(chan struct{}),","+\t}","+\tlistener := &testCredentialsListener{}","+","+\tcreds, unsubscribe, err := subscribeStreamingCredentials(ctx, provider, listener)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif got := <-provider.called; got != ctx {","+\t\tt.Fatalf(\"SubscribeWithContext got context %p, want caller context %p\", got, ctx)","+\t}","+\tif creds == nil || unsubscribe == nil {","+\t\tt.Fatalf(\"subscription = (%v, %v); want credentials and unsubscribe\", creds, unsubscribe)","+\t}","+\tcancel()","+\tselect {","+\tcase <-provider.unsubscribed:","+\t\tt.Fatal(\"canceling the caller context ended the established subscription\")","+\tdefault:","+\t}","+}","+","+type legacyStreamingTestProvider struct {","+\tcalled  chan struct{}","+\trelease chan struct{}","+}","+","+func (p *legacyStreamingTestProvider) Subscribe(auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tp.called <- struct{}{}","+\t<-p.release","+\treturn auth.NewBasicCredentials(\"legacy\", \"pass\"), func() error { return nil }, nil","+}","+","+func TestSubscribeStreamingCredentialsKeepsLegacySubscribeSynchronous(t *testing.T) {","+\tprovider := &legacyStreamingTestProvider{called: make(chan struct{}, 1), release: make(chan struct{})}","+\tresult := make(chan error, 1)","+\tctx, cancel := context.WithCancel(context.Background())","+\tdefer cancel()","+\tgo func() {","+\t\t_, _, err := subscribeStreamingCredentials(ctx, provider, &testCredentialsListener{})","+\t\tresult <- err","+\t}()","+\t<-provider.called","+\tcancel()","+\tselect {","+\tcase err := <-result:","+\t\tt.Fatalf(\"legacy Subscribe returned before it was released: %v\", err)","+\tcase <-time.After(20 * time.Millisecond):","+\t}","+\tclose(provider.release)","+\tif err := <-result; err != nil {","+\t\tt.Fatal(err)","+\t}","+}","+","+func TestSubscribeStreamingCredentialsReturnsCooperativeCancellation(t *testing.T) {","+\tctx, cancel := context.WithCancel(context.Background())","+\tprovider := &contextStreamingTestProvider{called: make(chan context.Context, 1), wait: true}","+\tlistener := &testCredentialsListener{}","+\tregistered := &atomic.Bool{}","+\tprovider.registered = registered","+\terrCh := make(chan error, 1)","+\tgo func() {","+\t\t_, _, err := subscribeStreamingCredentials(ctx, provider, listener)","+\t\terrCh <- err","+\t}()","+\t<-provider.called","+\tcancel()","+\tselect {","+\tcase err := <-errCh:","+\t\tif !errors.Is(err, context.Canceled) {","+\t\t\tt.Fatalf(\"Subscribe returned %v, want context.Canceled\", err)","+\t\t}","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"cooperative context-aware Subscribe did not return promptly\")","+\t}","+\tif registered.Load() {","+\t\tt.Fatal(\"listener registered after canceled subscription\")","+\t}","+}","+","+func TestStreamingSubscriptionCancellationClosesInitializingConn(t *testing.T) {","+\tctx, cancel := context.WithCancel(context.Background())","+\tdefer cancel()","+\tprovider := &contextStreamingTestProvider{called: make(chan context.Context, 1), wait: true}","+\tvar peer net.Conn","+\tclient := NewClient(&Options{","+\t\tAddr: \"test\",","+\t\tDialer: func(context.Context, string, string) (net.Conn, error) {","+\t\t\tclientConn, serverConn := net.Pipe()","+\t\t\tpeer = serverConn","+\t\t\treturn clientConn, nil","+\t\t},","+\t\tStreamingCredentialsProvider: provider,","+\t})","+\tdefer client.Close()","+","+\terrCh := make(chan error, 1)","+\tgo func() { errCh <- client.Ping(ctx).Err() }()","+\t<-provider.called","+\tcloseErrCh := make(chan error, 1)","+\tgo func() { closeErrCh <- client.Close() }()","+\tselect {","+\tcase err := <-closeErrCh:","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"Close returned %v\", err)","+\t\t}","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"client Close blocked while provider subscription was waiting\")","+\t}","+\tcancel()","+\tselect {","+\tcase err := <-errCh:","+\t\tif !errors.Is(err, context.Canceled) {","+\t\t\tt.Fatalf(\"Ping returned %v, want context.Canceled\", err)","+\t\t}","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"connection initialization did not return after cooperative cancellation\")","+\t}","+\tif peer == nil {","+\t\tt.Fatal(\"dialer did not create the server-side socket\")","+\t}","+\t_ = peer.SetReadDeadline(time.Now().Add(time.Second))","+\tbuf := make([]byte, 1)","+\tif _, err := peer.Read(buf); err == nil {","+\t\tt.Fatal(\"server-side socket remained open after failed initialization\")","+\t}","+\t_ = peer.Close()","+}","+","+type lateSuccessStreamingProvider struct {","+\tcalled      chan struct{}","+\treturnNow   chan struct{}","+\tunsubscribe atomic.Int32","+}","+","+func (p *lateSuccessStreamingProvider) Subscribe(auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tpanic(\"legacy Subscribe called\")","+}","+","+func (p *lateSuccessStreamingProvider) SubscribeWithContext(context.Context, auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tclose(p.called)","+\t<-p.returnNow","+\treturn auth.NewBasicCredentials(\"user\", \"pass\"), func() error {","+\t\tp.unsubscribe.Add(1)","+\t\treturn nil","+\t}, nil","+}","+","+func TestStreamingSubscriptionSuccessAfterConnCloseUnsubscribesOnce(t *testing.T) {","+\tfor _, pubsub := range []bool{false, true} {","+\t\tfor _, closeBeforeReturn := range []bool{true, false} {","+\t\t\tname := fmt.Sprintf(\"pubsub=%t/closeBeforeReturn=%t\", pubsub, closeBeforeReturn)","+\t\t\tt.Run(name, func(t *testing.T) {","+\t\t\t\tprovider := &lateSuccessStreamingProvider{called: make(chan struct{}), returnNow: make(chan struct{})}","+\t\t\t\tclientConn, peer := net.Pipe()","+\t\t\t\tt.Cleanup(func() { _ = peer.Close() })","+\t\t\t\tclient := NewClient(&Options{","+\t\t\t\t\tAddr:                         \"test\",","+\t\t\t\t\tStreamingCredentialsProvider: provider,","+\t\t\t\t\tDialer:                       func(context.Context, string, string) (net.Conn, error) { return clientConn, nil },","+\t\t\t\t})","+\t\t\t\tt.Cleanup(func() { _ = client.Close() })","+\t\t\t\tcn := pool.NewConn(clientConn)","+\t\t\t\tif pubsub {","+\t\t\t\t\tvar err error","+\t\t\t\t\tcn, err = client.pubSubPool.NewConn(context.Background(), \"tcp\", \"test\", nil)","+\t\t\t\t\tif err != nil {","+\t\t\t\t\t\tt.Fatal(err)","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tt.Cleanup(func() { _ = cn.Close() })","+\t\t\t\trelease := sync.OnceFunc(func() { close(provider.returnNow) })","+\t\t\t\tinitDone := make(chan error, 1)","+\t\t\t\tgo func() { initDone <- client.initConn(context.Background(), cn) }()","+\t\t\t\tt.Cleanup(release)","+\t\t\t\tselect {","+\t\t\t\tcase <-provider.called:","+\t\t\t\tcase <-time.After(time.Second):","+\t\t\t\t\tt.Fatal(\"subscription setup did not start\")","+\t\t\t\t}","+\t\t\t\tif !client.streamingCredentialsManager.IsTracking(cn.GetID()) {","+\t\t\t\t\tt.Fatal(\"listener not tracked during setup\")","+\t\t\t\t}","+\t\t\t\tcloseDone := make(chan error, 1)","+\t\t\t\tif closeBeforeReturn {","+\t\t\t\t\tcloseDone <- cn.Close()","+\t\t\t\t\trelease()","+\t\t\t\t} else {","+\t\t\t\t\tstartRace := make(chan struct{})","+\t\t\t\t\tgo func() { <-startRace; closeDone <- cn.Close() }()","+\t\t\t\t\tgo func() { <-startRace; release() }()","+\t\t\t\t\tclose(startRace)","+\t\t\t\t}","+\t\t\t\tselect {","+\t\t\t\tcase err := <-closeDone:","+\t\t\t\t\tif err != nil {","+\t\t\t\t\t\tt.Fatal(err)","+\t\t\t\t\t}","+\t\t\t\tcase <-time.After(time.Second):","+\t\t\t\t\tt.Fatal(\"connection Close did not finish\")","+\t\t\t\t}","+\t\t\t\tselect {","+\t\t\t\tcase err := <-initDone:","+\t\t\t\t\tif err == nil {","+\t\t\t\t\t\tt.Fatal(\"initialization succeeded after connection close\")","+\t\t\t\t\t}","+\t\t\t\t\tif closeBeforeReturn && !errors.Is(err, ErrClosed) {","+\t\t\t\t\t\tt.Fatalf(\"initialization returned %v, want ErrClosed\", err)","+\t\t\t\t\t}","+\t\t\t\tcase <-time.After(time.Second):","+\t\t\t\t\tt.Fatal(\"connection initialization did not finish\")","+\t\t\t\t}","+\t\t\t\t_ = cn.Close()","+\t\t\t\tif got := provider.unsubscribe.Load(); got != 1 {","+\t\t\t\t\tt.Fatalf(\"unsubscribe called %d times, want exactly once\", got)","+\t\t\t\t}","+\t\t\t\tif pubsub && client.streamingCredentialsManager.IsTracking(cn.GetID()) {","+\t\t\t\t\tt.Fatal(\"closed Pub/Sub connection still has re-auth state\")","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}","+","+// Exercise successful subscription setup through a real client and a local","+// RESP peer; the peer is deliberately not a Redis or Azure service.","+func TestStreamingSubscriptionSurvivesRequestCancellation(t *testing.T) {","+\tprovider := &contextStreamingTestProvider{","+\t\tcalled:       make(chan context.Context, 2),","+\t\tunsubscribed: make(chan struct{}),","+\t}","+\tclientEnd, serverEnd := net.Pipe()","+\tt.Cleanup(func() { _ = serverEnd.Close() })","+\tpeerDone := make(chan struct{})","+\tgo func() {","+\t\tdefer close(peerDone)","+\t\trd := proto.NewReader(serverEnd)","+\t\tfor {","+\t\t\targs, err := rd.ReadSlice()","+\t\t\tif err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\treply := \"+OK\\r\\n\"","+\t\t\tswitch args[0] {","+\t\t\tcase \"hello\":","+\t\t\t\treply = \"%0\\r\\n\"","+\t\t\tcase \"ping\":","+\t\t\t\treply = \"+PONG\\r\\n\"","+\t\t\t}","+\t\t\tif _, err := serverEnd.Write([]byte(reply)); err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t}()","+\tclient := NewClient(&Options{","+\t\tStreamingCredentialsProvider: provider,","+\t\tContextTimeoutEnabled:        true,","+\t\tDisableIdentity:              true,","+\t\tMaxRetries:                   -1,","+\t\tMaintNotificationsConfig:     &maintnotifications.Config{Mode: maintnotifications.ModeDisabled},","+\t\tDialer:                       func(context.Context, string, string) (net.Conn, error) { return clientEnd, nil },","+\t})","+\tt.Cleanup(func() { _ = client.Close(); <-peerDone })","+\tctx, cancel := context.WithTimeout(context.Background(), time.Second)","+\tdefer cancel()","+\tif err := client.Ping(ctx).Err(); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif got := <-provider.called; got != ctx {","+\t\tt.Fatal(\"provider did not receive caller context\")","+\t}","+\tcancel()","+\tselect {","+\tcase <-provider.unsubscribed:","+\t\tt.Fatal(\"canceling request removed established subscription\")","+\tdefault:","+\t}","+\tif err := client.Ping(context.Background()).Err(); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tselect {","+\tcase <-provider.called:","+\t\tt.Fatal(\"client resubscribed instead of reusing authenticated connection\")","+\tdefault:","+\t}","+\tif err := client.Close(); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tselect {","+\tcase <-provider.unsubscribed:","+\tdefault:","+\t\tt.Fatal(\"closing client did not unsubscribe\")","+\t}","+}","+","+type testCredentialsListener struct{}","+","+func (*testCredentialsListener) OnNext(auth.Credentials) {}","+func (*testCredentialsListener) OnError(error)           {}","+","+type deadlineStreamingProvider struct {","+\tentered chan struct{}","+\trelease chan struct{}","+}","+","+func (p *deadlineStreamingProvider) Subscribe(auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tclose(p.entered)","+\t<-p.release","+\treturn nil, nil, errors.New(\"acquisition released by test cleanup\")","+}","+","+func (p *deadlineStreamingProvider) SubscribeWithContext(ctx context.Context, _ auth.CredentialsListener) (auth.Credentials, auth.UnsubscribeFunc, error) {","+\tclose(p.entered)","+\t<-ctx.Done()","+\treturn nil, nil, ctx.Err()","+}","+","+func TestStreamingCredentialWaitHonorsDeadline(t *testing.T) {","+\tp := &deadlineStreamingProvider{make(chan struct{}), make(chan struct{})}","+\tclientEnd, serverEnd := net.Pipe()","+\tt.Cleanup(func() { _ = serverEnd.Close() })","+\tc := NewClient(&Options{","+\t\tStreamingCredentialsProvider: p,","+\t\tContextTimeoutEnabled:        true,","+\t\tMaxRetries:                   -1,","+\t\tDialerRetries:                -1,","+\t\tDialer:                       func(context.Context, string, string) (net.Conn, error) { return clientEnd, nil },","+\t})","+\tt.Cleanup(func() { _ = c.Close() })","+\tctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)","+\tdefer cancel()","+\tdone := make(chan error, 1)","+\tfinished := make(chan struct{})","+\tgo func() {","+\t\tdefer close(finished)","+\t\tdone <- c.Ping(ctx).Err()","+\t}()","+\tt.Cleanup(func() { close(p.release); <-finished })","+\tselect {","+\tcase <-p.entered:","+\tcase <-ctx.Done():","+\t\tt.Fatal(\"setup failed: provider was not entered\")","+\t}","+\t<-ctx.Done()","+\tselect {","+\tcase err := <-done:","+\t\tif !errors.Is(err, context.DeadlineExceeded) {","+\t\t\tt.Fatalf(\"Ping returned %v, want context.DeadlineExceeded\", err)","+\t\t}","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"Ping still blocked in Subscribe after its deadline\")","+\t}","+\t// Failed initialization must close its transport, not just mark it closed.","+\t_ = serverEnd.SetReadDeadline(time.Now().Add(time.Second))","+\tvar b [1]byte","+\tif _, err := serverEnd.Read(b[:]); !errors.Is(err, io.EOF) {","+\t\tt.Fatalf(\"expected EOF after canceled initialization, got %v\", err)","+\t}","+}"],"additions":412,"deletions":0,"truncated":false},{"path":"redis.go","lines":["@@ -1155,8 +1155,9 @@ func (c *baseClient) initConn(ctx context.Context, cn *pool.Conn) error {"," \t\t\treturn fmt.Errorf(\"failed to create credentials listener: %w\", initErr)"," \t\t}"," ","-\t\tcredentials, unsubscribeFromCredentialsProvider, initErr := c.opt.StreamingCredentialsProvider.","-\t\t\tSubscribe(credListener)","+\t\tcredentials, unsubscribeFromCredentialsProvider, initErr := subscribeStreamingCredentials(","+\t\t\tctx, c.opt.StreamingCredentialsProvider, credListener,","+\t\t)"," \t\tif initErr != nil {"," \t\t\tcn.GetStateMachine().Transition(pool.StateClosed)"," \t\t\treturn fmt.Errorf(\"failed to subscribe to streaming credentials: %w\", initErr)","@@ -1194,6 +1195,14 @@ func (c *baseClient) initConn(ctx context.Context, cn *pool.Conn) error {"," \t\t}"," \t\tcn.SetOnClose(onClose)"," ","+\t\t// Close may have run while subscription setup was waiting, before","+\t\t// onClose was installed. Re-run teardown in that case; Conn.Close","+\t\t// atomically claims callbacks, so unsubscribe still runs only once.","+\t\tif cn.IsClosed() {","+\t\t\t_ = cn.Close()","+\t\t\treturn fmt.Errorf(\"connection closed during streaming credentials setup: %w\", pool.ErrClosed)","+\t\t}","+"," \t\tusername, password = credentials.BasicAuth()"," \t} else {"," \t\tusername, password, initErr = c.opt.resolveCredentials(ctx)",""],"additions":11,"deletions":2,"truncated":false}],"additions":464,"deletions":3,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-05T16:28:27.360704+00:00"}