{"id":"GHSA-r3h5-4585-7x3w","axis":"advisories","repo":"withastro/astro","sha":"7da442bb286e0c29e1c9e1add6727b7cbf434f1a","parsed":{"files":[{"path":".changeset/case-sensitive-image-path.md","lines":["@@ -0,0 +1,6 @@","+---","+'@astrojs/internal-helpers': patch","+'astro': patch","+---","+","+Fixes the image endpoint treating directories whose names differ only by letter case as being inside the build output directory on case-sensitive filesystems"],"additions":6,"deletions":0,"truncated":false},{"path":"packages/internal-helpers/src/path.ts","lines":["@@ -235,8 +235,14 @@ export function isParentDirectory(parentPath: string, childPath: string): boolea"," \t\treturn false;"," \t}"," ","-\tconst normalizedParent = appendForwardSlash(slash(parentPath).toLowerCase());","-\tconst normalizedChild = slash(childPath).toLowerCase();","+\t// Windows drive-letter paths live on case-insensitive filesystems, so","+\t// fold case there. Everywhere else, compare exactly: on case-sensitive","+\t// filesystems, `/app/DIST/client` is a different directory from","+\t// `/app/dist/client` and must not be treated as being inside it.","+\tconst caseInsensitive = isWindowsAbsolutePath(parentPath) && isWindowsAbsolutePath(childPath);","+\tconst fold = (p: string) => (caseInsensitive ? p.toLowerCase() : p);","+\tconst normalizedParent = appendForwardSlash(fold(slash(parentPath)));","+\tconst normalizedChild = fold(slash(childPath));"," "," \t// Don't allow same path (parent can't be parent of itself)"," \tif (normalizedParent === normalizedChild || normalizedParent === normalizedChild + '/') {","@@ -246,6 +252,12 @@ export function isParentDirectory(parentPath: string, childPath: string): boolea"," \treturn normalizedChild.startsWith(normalizedParent);"," }"," ","+const WINDOWS_ABSOLUTE_PATH = /^[a-zA-Z]:[\\\\/]/;","+","+function isWindowsAbsolutePath(path: string) {","+\treturn WINDOWS_ABSOLUTE_PATH.test(path);","+}","+"," export function slash(path: string) {"," \treturn path.replace(/\\\\/g, '/');"," }"],"additions":14,"deletions":2,"truncated":false},{"path":"packages/internal-helpers/test/path.test.ts","lines":["@@ -680,6 +680,12 @@ describe('isParentDirectory', () => {"," \t\t\t['src/components/Button', 'src/components'], // Parent longer"," \t\t\t['/home/user', '/home'], // Reversed relationship"," ","+\t\t\t// Case-variant directories are distinct on case-sensitive filesystems","+\t\t\t['/app/dist/client', '/app/DIST/client/secret.png'],","+\t\t\t['/app/dist/client/', '/app/dist/CLIENT/secret.png'],","+\t\t\t['/srv/app/dist', '/srv/App/dist/file.png'],","+\t\t\t['src/components', 'SRC/components/Button.astro'],","+"," \t\t\t// Different drives on Windows"," \t\t\t['C:\\\\Users', 'D:\\\\Users'],"," \t\t\t['C:\\\\', 'D:\\\\'],",""],"additions":6,"deletions":0,"truncated":false}],"additions":26,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-14T15:12:41.192797+00:00"}