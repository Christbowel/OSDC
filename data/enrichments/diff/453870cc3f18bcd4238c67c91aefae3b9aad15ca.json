{"id":"453870cc3f18bcd4238c67c91aefae3b9aad15ca","axis":"silent","repo":"pnpm/pnpm","sha":"453870cc3f18bcd4238c67c91aefae3b9aad15ca","parsed":{"files":[{"path":".changeset/injected-copy-keeps-links-v11.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/workspace.injected-deps-syncer\": patch","+\"@pnpm/fetching.directory-fetcher\": patch","+\"@pnpm/fs.indexed-pkg-importer\": patch","+\"pnpm\": patch","+---","+","+A script listed in `syncInjectedDepsAfterScripts` now keeps a package's links to its own files as links in the injected copies, the way `pnpm install` writes them. It no longer fails when the package links to one directory twice or links back to a directory above the link. `pnpm install` with `deployAllFiles` no longer fails on such a link back either."],"additions":8,"deletions":0,"truncated":false},{"path":".changeset/injected-copy-keeps-links.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+A script listed in `syncInjectedDepsAfterScripts` now keeps a package's links to its own files as links in the injected copies, the way `pnpm install` writes them. Before, a directory link the script added became a real directory in the copies, or went missing with `deployAllFiles`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -10614,6 +10614,9 @@ importers:","       '@pnpm/fs.graceful-fs':","         specifier: workspace:*","         version: link:../../fs/graceful-fs","+      '@pnpm/fs.indexed-pkg-importer':","+        specifier: workspace:*","+        version: link:../../fs/indexed-pkg-importer","       '@pnpm/installing.modules-yaml':","         specifier: workspace:*","         version: link:../../installing/modules-yaml"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/injected_copy_symlinks.rs","lines":["@@ -0,0 +1,157 @@","+//! An injected copy holds the package's links to its own content the way","+//! the install writes them, after a script listed in","+//! `syncInjectedDepsAfterScripts` too (pnpm/tasks#147).","+","+#![cfg(unix)]","+","+use crate::_utils::{WorkspaceFixture, assert_success};","+","+use std::{","+    collections::BTreeMap,","+    fs,","+    os::unix::fs::symlink,","+    path::{Path, PathBuf},","+};","+","+use serde_json::json;","+use walkdir::WalkDir;","+","+/// The build replaces a file under a linked directory and adds a new link.","+const BUILD: &str = \"const fs = require('fs')\\n\\","+fs.rmSync(__dirname + '/files/foo/a.txt')\\n\\","+fs.writeFileSync(__dirname + '/files/foo/a.txt', 'rebuilt')\\n\\","+fs.symlinkSync('files/foo', __dirname + '/new-link')\\n\";","+","+#[derive(Debug, PartialEq, Eq)]","+enum Entry {","+    Dir,","+    File(String),","+    Link(PathBuf),","+}","+","+/// `app` injects `lib`, which links to its own directories: two links to","+/// one directory, and a link to the package root.","+fn workspace(deploy_all_files: bool) -> WorkspaceFixture {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(&format!(","+        \"deployAllFiles: {deploy_all_files}\\ndedupeInjectedDeps: false\\n\\","+         syncInjectedDepsAfterScripts:\\n  - build\\n\",","+    ));","+    let write = |path: &str, contents: &str| {","+        let path = fixture.workspace.join(path);","+        fs::create_dir_all(path.parent().expect(\"a parent\")).expect(\"create a directory\");","+        fs::write(path, contents).expect(\"write a file\");","+    };","+    write(\"package.json\", &json!({ \"name\": \"root\", \"private\": true }).to_string());","+    write(","+        \"packages/app/package.json\",","+        &json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"lib\": \"workspace:*\" },","+            \"dependenciesMeta\": { \"lib\": { \"injected\": true } },","+        })","+        .to_string(),","+    );","+    write(","+        \"packages/lib/package.json\",","+        &json!({ \"name\": \"lib\", \"version\": \"1.0.0\", \"scripts\": { \"build\": \"node build.cjs\" } })","+            .to_string(),","+    );","+    write(\"packages/lib/build.cjs\", BUILD);","+    write(\"packages/lib/files/foo/a.txt\", \"a\");","+    write(\"packages/lib/shared/x.txt\", \"x\");","+    let lib = fixture.workspace.join(\"packages/lib\");","+    for (target, link) in","+        [(\"files/foo\", \"link-to-a-dir\"), (\"shared\", \"a\"), (\"shared\", \"b\"), (\".\", \"loop\")]","+    {","+        symlink(target, lib.join(link)).expect(\"create a link\");","+    }","+    fixture","+}","+","+/// The copy of `lib` that `app` resolves in `workspace`.","+fn injected_copy(workspace: &Path) -> PathBuf {","+    let copy = fs::canonicalize(workspace.join(\"packages/app/node_modules/lib\"))","+        .expect(\"app resolves lib\");","+    let source = fs::canonicalize(workspace.join(\"packages/lib\")).expect(\"canonicalize lib\");","+    assert_ne!(copy, source, \"lib is linked, not injected\");","+    copy","+}","+","+/// Every entry under `dir` outside `node_modules`, without following links.","+fn tree(dir: &Path) -> BTreeMap<String, Entry> {","+    WalkDir::new(dir)","+        .min_depth(1)","+        .into_iter()","+        .filter_entry(|entry| entry.file_name() != \"node_modules\")","+        .map(|entry| entry.expect(\"walk the copy\"))","+        .map(|entry| {","+            let relative = entry","+                .path()","+                .strip_prefix(dir)","+                .expect(\"under the copy\")","+                .to_string_lossy()","+                .into_owned();","+            let kind = if entry.path_is_symlink() {","+                Entry::Link(fs::read_link(entry.path()).expect(\"read a link\"))","+            } else if entry.file_type().is_dir() {","+                Entry::Dir","+            } else {","+                Entry::File(fs::read_to_string(entry.path()).expect(\"read a file\"))","+            };","+            (relative, kind)","+        })","+        .collect()","+}","+","+/// A copy of the sources under `from`, links kept as links.","+fn copy_keeping_links(from: &Path, to: &Path) {","+    for entry in WalkDir::new(from)","+        .into_iter()","+        .filter_entry(|entry| entry.file_name() != \"node_modules\")","+    {","+        let entry = entry.expect(\"walk the workspace\");","+        let target = to.join(","+            entry","+                .path()","+                .strip_prefix(from)","+                .expect(\"under the workspace\"),","+        );","+        if entry.path_is_symlink() {","+            symlink(fs::read_link(entry.path()).expect(\"read a link\"), &target)","+                .expect(\"copy a link\");","+        } else if entry.file_type().is_dir() {","+            fs::create_dir_all(&target).expect(\"create a directory\");","+        } else {","+            fs::copy(entry.path(), &target).expect(\"copy a file\");","+        }","+    }","+}","+","+fn check(deploy_all_files: bool) {","+    let fixture = workspace(deploy_all_files);","+    let workspace = fixture.workspace.clone();","+    assert_success(&fixture.command_at(&workspace, [\"install\"]));","+    assert_success(&fixture.command_at(&workspace.join(\"packages/lib\"), [\"run\", \"build\"]));","+","+    let clean = workspace.with_file_name(\"clean\");","+    copy_keeping_links(&workspace, &clean);","+    assert_success(&fixture.command_at(&clean, [\"install\", \"--frozen-lockfile\"]));","+","+    assert_eq!(","+        tree(&injected_copy(&workspace)),","+        tree(&injected_copy(&clean)),","+        \"deployAllFiles: {deploy_all_files}: the synced copy differs from the one a fresh install writes\",","+    );","+}","+","+#[test]","+fn a_listed_script_keeps_links_as_the_install_writes_them() {","+    check(false);","+}","+","+#[test]","+fn a_listed_script_keeps_links_as_the_install_writes_them_with_deploy_all_files() {","+    check(true);","+}"],"additions":157,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -81,6 +81,7 @@ mod import_yarn_patches;"," mod init;"," mod inject_workspace_packages;"," mod injected_copy_equivalence;","+mod injected_copy_symlinks;"," mod injected_deps_with_dedicated_lockfiles;"," mod injected_freshness_matrix;"," mod install;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/import_indexed_dir/placement/symlinks.rs","lines":["@@ -4,7 +4,7 @@ use super::{ImportIndexedDirError, Placement, clear_dir_blocking_file, file_matc"," use pnpm_fs::Host;"," use std::{","     collections::{HashMap, HashSet},","-    fs, io,","+    fs,","     path::{Path, PathBuf},"," };"," ","@@ -63,7 +63,7 @@ fn validate_symlink_target(","     pkg_root: &Path,"," ) -> Result<PathBuf, ImportIndexedDirError> {","     let link_target = pnpm_fs::read_symlink_dir(store_path)","-        .map(|link| relative_to_link(store_path, link))","+        .map(|link| pnpm_fs::relative_link_target(store_path, link))","         .map_err(|error| {","             ImportIndexedDirError::LinkFile(crate::link_file::LinkFileError::Import {","                 from: store_path.to_path_buf(),","@@ -83,19 +83,6 @@ fn validate_symlink_target(","     Ok(link_target)"," }"," ","-/// `link`, a link target read from `link_path`, with an absolute one made","-/// relative to the link's directory. Both sides are canonicalized first:","-/// the directory fetcher lists links under the canonical package root,","-/// while the link text may reach the same place through another path.","-fn relative_to_link(link_path: &Path, link: PathBuf) -> PathBuf {","-    let (true, Some(parent)) = (link.is_absolute(), link_path.parent()) else {","-        return link;","-    };","-    let parent = fs::canonicalize(parent).unwrap_or_else(|_| parent.to_path_buf());","-    let link = fs::canonicalize(&link).unwrap_or(link);","-    pathdiff::diff_paths(&link, &parent).unwrap_or(link)","-}","-"," /// Recreate the symlink at `store_path` as `target`, reporting whether the"," /// entry is handled. A link whose target the import leaves out is not"," /// recreated: a file link is left for the caller to import as a file, and","@@ -120,7 +107,7 @@ pub(super) fn place_symlink_entry(","         let final_target = final_link_target(target, &link_target, roots);","         pnpm_fs::symlink_dir_with_contents(&final_target, &link_target, &temp)","     } else {","-        create_file_link(&link_target, store_path, &temp)","+        pnpm_fs::symlink_file_or_copy(&link_target, store_path, &temp)","     };","     if let Err(error) = created {","         let _ = pnpm_fs::remove_dirent(&temp);","@@ -144,26 +131,6 @@ fn imports_link_target(target: &Path, link_target: &Path, roots: SymlinkRoots<'_","         .is_some_and(|rel| roots.imported.contains(rel.replace('\\\\', \"/\").as_str()))"," }"," ","-/// A file symlink has no junction to fall back to, so a process Windows","-/// refuses symlinks gets a copy of the linked file.","-fn create_file_link(link_target: &Path, store_path: &Path, temp: &Path) -> io::Result<()> {","-    let result = pnpm_fs::create_symlink(link_target, temp, false);","-    #[cfg(windows)]","-    {","-        if let Err(error) = &result","-            && error.raw_os_error() == Some(ERROR_PRIVILEGE_NOT_HELD)","-        {","-            return fs::copy(store_path, temp).map(drop);","-        }","-    }","-    #[cfg(not(windows))]","-    let _ = store_path;","-    result","-}","-","-#[cfg(windows)]","-const ERROR_PRIVILEGE_NOT_HELD: i32 = 1314;","-"," /// The absolute path `link_target` resolves to from `target` once the"," /// written directory has moved to its final place."," pub(super) fn final_link_target(","@@ -204,5 +171,5 @@ pub(super) fn symlink_matches_store_entry(target: &Path, store_path: &Path) -> b","     else {","         return false;","     };","-    target_link == relative_to_link(store_path, store_link)","+    target_link == pnpm_fs::relative_link_target(store_path, store_link)"," }"],"additions":4,"deletions":37,"truncated":false},{"path":"pnpm/crates/fs/src/internal_symlink.rs","lines":["@@ -0,0 +1,42 @@","+//! A package's symlink to something inside the package, as a copy of the","+//! package recreates it.","+","+use std::{","+    fs, io,","+    path::{Path, PathBuf},","+};","+","+/// `link`, a link target read from `link_path`, with an absolute one made","+/// relative to the link's directory. Both sides are canonicalized first:","+/// a directory walk lists links under the canonical package root, while the","+/// link text may reach the same place through another path.","+#[must_use]","+pub fn relative_link_target(link_path: &Path, link: PathBuf) -> PathBuf {","+    let (true, Some(parent)) = (link.is_absolute(), link_path.parent()) else {","+        return link;","+    };","+    let parent = fs::canonicalize(parent).unwrap_or_else(|_| parent.to_path_buf());","+    let link = fs::canonicalize(&link).unwrap_or(link);","+    pathdiff::diff_paths(&link, &parent).unwrap_or(link)","+}","+","+/// Create a file link at `link` holding `contents`. A file symlink has no","+/// junction to fall back to, so a process Windows refuses symlinks gets a","+/// copy of `original`, the file the link points at.","+pub fn symlink_file_or_copy(contents: &Path, original: &Path, link: &Path) -> io::Result<()> {","+    let result = crate::create_symlink(contents, link, false);","+    #[cfg(windows)]","+    {","+        if let Err(error) = &result","+            && error.raw_os_error() == Some(ERROR_PRIVILEGE_NOT_HELD)","+        {","+            return fs::copy(original, link).map(drop);","+        }","+    }","+    #[cfg(not(windows))]","+    let _ = original;","+    result","+}","+","+#[cfg(windows)]","+const ERROR_PRIVILEGE_NOT_HELD: i32 = 1314;"],"additions":42,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/lib.rs","lines":["@@ -13,6 +13,7 @@ pub use dir_lock::DirLock;"," pub use ensure_file::*;"," #[cfg(not(target_os = \"wasi\"))]"," pub use file_lock::{lock_file, try_lock_file};","+pub use internal_symlink::{relative_link_target, symlink_file_or_copy};"," pub use is_not_found::is_not_found;"," pub use is_subdir::is_subdir;"," pub use lexical_normalize::{lexical_normalize, lexical_normalize_posix};","@@ -55,6 +56,7 @@ mod dir_lock;"," mod ensure_file;"," #[cfg(not(target_os = \"wasi\"))]"," mod file_lock;","+mod internal_symlink;"," mod is_not_found;"," mod is_subdir;"," mod lexical_normalize;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/injected-deps-syncer/src/dir_patcher.rs","lines":["@@ -43,6 +43,12 @@ pub struct FileId {"," pub enum Value {","     Dir,","     File(FileId),","+    /// A link to something inside the tree, by a hash of the path it points","+    /// at relative to the tree's root. The source and a copy hold the same","+    /// link exactly when their links point at the same relative path,","+    /// whatever the link text, so a Windows junction's absolute target","+    /// matches the relative one it was made from.","+    Symlink(u64),"," }"," "," /// Relative path → inode type, for every file and directory in a tree.","@@ -219,7 +225,7 @@ fn apply_change_with_link<Sys: FsHardLink>(","                 .map_err(|error| PatchError::CreateDir { path: target_path.clone(), error })","         }),","         Value::File(_) => {","-            let source_path = source_dir.join(&change.path);","+            let source_path = linked_file(&source_dir.join(&change.path));","             retry_over_blocking_inode(&target_path, || {","                 link_or_copy::<Sys>(&source_path, &target_path)","                     .map_err(|error| PatchError::Link {","@@ -229,7 +235,45 @@ fn apply_change_with_link<Sys: FsHardLink>(","                     })","             })","         }","+        Value::Symlink(_) => {","+            let source_path = source_dir.join(&change.path);","+            retry_over_blocking_inode(&target_path, || place_link(&source_path, &target_path))","+        }","+    }","+}","+","+/// The file at `path`, or the file it links to: a link the install imports as","+/// a file is a file in the copy, and a hardlink of the link would be another","+/// link, one the copy cannot resolve.","+fn linked_file(path: &Path) -> PathBuf {","+    if fs::symlink_metadata(path).is_ok_and(|metadata| metadata.file_type().is_symlink()) {","+        fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf())","+    } else {","+        path.to_path_buf()","+    }","+}","+","+/// Recreate the link at `source_path` at `target_path`, the way the install","+/// recreates a package's link to its own content.","+fn place_link(source_path: &Path, target_path: &Path) -> Result<(), PatchError> {","+    let link_error = |error| PatchError::Link {","+        source: source_path.to_path_buf(),","+        target: target_path.to_path_buf(),","+        error,","+    };","+    let contents = pnpm_fs::read_symlink_dir(source_path)","+        .map(|link| pnpm_fs::relative_link_target(source_path, link))","+        .map_err(link_error)?;","+    let link_dir = target_path.parent().unwrap_or_else(|| Path::new(\"\"));","+    fs::create_dir_all(link_dir)","+        .map_err(|error| PatchError::CreateDir { path: link_dir.to_path_buf(), error })?;","+    if fs::metadata(source_path).is_ok_and(|metadata| metadata.is_dir()) {","+        let original = pnpm_fs::lexical_normalize(&link_dir.join(&contents));","+        pnpm_fs::symlink_dir_with_contents(&original, &contents, target_path)","+    } else {","+        pnpm_fs::symlink_file_or_copy(&contents, source_path, target_path)","     }","+    .map_err(link_error)"," }"," "," /// A source directory's files, read once per poll and published to each of","@@ -273,6 +317,7 @@ pub fn publish_edits(","         }","         ensure_directory(&target_dir.join(path), target_map.get(path))?;","     }","+    publish_links(source, target_dir, &target_map)?;","     for (path, value) in source_map {","         let Value::File(source_id) = value else {","             continue;","@@ -285,6 +330,23 @@ pub fn publish_edits(","     Ok(())"," }"," ","+/// Recreate each link of `source` that `target_map` does not hold.","+fn publish_links(","+    source: &PublishSource<'_>,","+    target_dir: &Path,","+    target_map: &InodeMap,","+) -> Result<(), PatchError> {","+    for (path, value) in &source.map {","+        if !matches!(value, Value::Symlink(_)) || target_map.get(path) == Some(value) {","+            continue;","+        }","+        let target_path = target_dir.join(path);","+        remove_recursive(&target_path)?;","+        place_link(&source.dir.join(path), &target_path)?;","+    }","+    Ok(())","+}","+"," fn should_publish(source: &FileId, target: Option<&Value>, edited_since: SystemTime) -> bool {","     let Some(Value::File(target_id)) = target else {","         return true;"],"additions":63,"deletions":1,"truncated":false},{"path":"pnpm/crates/injected-deps-syncer/src/dir_patcher/inode_map.rs","lines":["@@ -3,8 +3,10 @@"," use super::{FileId, InodeMap, PatchError, Value};"," use pnpm_directory_fetcher::DirectoryFetcher;"," use std::{","-    collections::HashMap,","-    fs, io,","+    collections::{HashMap, HashSet},","+    fs,","+    hash::{DefaultHasher, Hash, Hasher},","+    io,","     path::{Path, PathBuf},","     time::SystemTime,"," };","@@ -14,9 +16,20 @@ pub(super) fn load_inode_map(","     include_only_package_files: bool,"," ) -> Result<InodeMap, PatchError> {","     let files_map = list_files(dir, include_only_package_files)?;","-    let mut inode_map = extend_files_map(&files_map)?;","-    if include_only_package_files {","-        add_files_under_listed_directories(dir, &files_map, &mut inode_map)?;","+    let listed = listed_paths(files_map.keys());","+    let mut inode_map = InodeMap::from([(\".\".to_string(), Value::Dir)]);","+    for (relative_path, path) in &files_map {","+        let Some(metadata) = stat_skipping_missing(path, |path| fs::symlink_metadata(path))? else {","+            continue;","+     