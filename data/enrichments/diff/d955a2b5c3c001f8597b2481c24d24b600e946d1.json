  auto& stream = *source.stream;","+        stream.clear();","+        stream.seekg(source.start + static_cast<std::streamoff>(located.entry.offset));","+        OPENVINO_ASSERT(stream, \"Failed to seek to a HETERO compiled submodel section\");","+        ov::hetero::BoundedStreamBuffer buffer{stream, located.entry.size};","+        std::istream payload{&buffer};","+        auto compiled_model = core->import_model(payload, device, load_config);","+        // The sub-device may leave the shared stream in a failed state; other sections are read next.","+        stream.clear();","+        return compiled_model;","+    }","+","+    const auto view = located.section.view();","+    OPENVINO_ASSERT(!view.empty(), \"HETERO compiled submodel section is empty\");","+    if (source.tensor.get_element_type() == ov::element::u8 && source.tensor.get_shape().size() == 1 &&","+        device_imports_tensor(core, device)) {","+        // A view of the mapped container lets the sub-device keep its weights zero-copy.","+        return core->import_model(ov::hetero::read_hsm_tensor(located, source), device, load_config);","+    }","+    ov::SharedStreamBuffer buffer{view.data(), view.size()};","+    std::istream payload{&buffer};","+    return core->import_model(payload, device, load_config);","+}","+"," class CountingOutputBuffer : public std::streambuf {"," public:","     std::uint64_t size() const {","@@ -124,6 +184,84 @@ void write_framed_payload_via_seekable_stream(std::ostream& modelStream,","     ov::hetero::write_framed_payload(modelStream, payloadType, payloadStream, payloadSize);"," }"," ","+ov::hetero::Configuration hetero_read_config(const pugi::xml_node& hetero_node, const ov::hetero::Configuration& base) {","+    using namespace ov::util::pugixml;","+","+    ov::AnyMap properties;","+    auto hetero_configs_node = hetero_node.child(\"hetero_config\");","+    FOREACH_CHILD (hetero_config_node, hetero_configs_node, \"config\") {","+        properties.emplace(get_str_attr(he