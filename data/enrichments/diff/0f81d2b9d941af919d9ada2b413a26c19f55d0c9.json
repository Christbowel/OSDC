 {","+    lockout.lockout_threshold = String(saved.user_lockout_threshold);","+  }","+  if (saved.user_lockout_duration) lockout.lockout_duration = `${saved.user_lockout_duration}s`;","+  if (saved.user_lockout_counter_reset_duration) {","+    lockout.lockout_counter_reset_duration = `${saved.user_lockout_counter_reset_duration}s`;","+  }","+  if (saved.user_lockout_disable !== undefined) lockout.lockout_disable = saved.user_lockout_disable;","+  return lockout;","+};"," "," export default class ClusterSettingsAuthConfigureRoute extends Route {","   @service declare readonly api: ApiService;","@@ -25,14 +43,17 @@ export default class ClusterSettingsAuthConfigureRoute extends Route {"," ","   modelForOptions() {","     const { methodOptions, method } = this.configRouteModel;","-    const config = methodOptions.config as MountConfig;","+    // the saved lockout settings are read here and sent back under the keys Vault accepts, not as part of config","+    const { user_lockout_config: savedLockoutConfig, ...config } = methodOptions.config as MountConfig & {","+      user_lockout_config?: UserLockoutConfigResponse;","+    };","     const listing_visibility = config.listing_visibility === 'unauth' ? true : false;"," ","     const form = new AuthMethodForm({","       ...methodOptions,","       path: method.id,","       config: { ...config, listing_visibility },","-      user_lockout_config: {},","+      user_lockout_config: lockoutConfigForForm(savedLockoutConfig),","     });","     // `type` is a tracked property on the form class and not a field param","     // so we need to set it here even though it is spread in methodOptions above."],"additions":23,"deletions":2,"truncated":false},{"path":"ui/e2e/tests/superuser/auth-lockout-config.spec.ts","lines":["@@ -0,0 +1,100 @@","+/**","+ * Copyright IBM Corp. 2026","+ * SPDX-License-Identifier: BUSL-1.1","+ */","+","+import { expect } from '@playwright/test';","+import { highlightText, holdForVideo, test } from '../../fixtures/demo';","+import { rootApi } from '../../fixtures/root-api';","+","+const AUTH = 'lockout-config-userpass';","+","+// Setup and cleanup live in hooks so the mount is removed even when a test fails or retries.","+test.beforeAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  await api.delete(`/v1/sys/auth/${AUTH}`);","+  await expect(await api.post(`/v1/sys/auth/${AUTH}`, { data: { type: 'userpass' } })).toBeOK();","+  await api.dispose();","+});","+","+test.afterAll(async ({ playwright }, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  await api.delete(`/v1/sys/auth/${AUTH}`);","+  await api.dispose();","+});","+","+const label = (name: string) => ({","+  toggle: `[data-test-toggle-label=\"${name}\"]`,","+  value: `[data-test-ttl-value=\"${name}\"]`,","+  unit: `[data-test-ttl-unit=\"${name}\"] select`,","+});","+","+// Clicking first moves the recorded cursor to the input; fill alone types without it.","+const enterDuration = async (","+  page: import('@playwright/test').Page,","+  name: string,","+  value: string,","+  unit: string","+) => {","+  const field = label(name);","+  await page.locator(field.toggle).click();","+  await page.locator(field.value).click();","+  await page.locator(field.value).fill(value);","+  await page.locator(field.unit).selectOption(unit);","+};","+","+// The counter reset field used to send a key Vault does not read, so it was never stored.","+test('lockout settings are stored by Vault and shown when the page is opened again', async ({","+  page,","+  playwright,","+}, testInfo) => {","+  const api = await rootApi(playwright, testInfo);","+  const options = `settings/auth/configure/${AUTH}/options`;","+  const tune = async () => (await (await api.get(`/v1/sys/auth/${AUTH}/tune`)).json()).data;","+","+  // Disposed in a finally block so the request context is released even when a step fails.","+  try {","+    await test.step('save a threshold, a lockout duration and a counter reset', async () => {","+      await page.goto(options);","+      await page.locator('[data-test-input=\"user_lockout_config.lockout_threshold\"]').click();","+      await page.locator('[data-test-input=\"user_lockout_config.lockout_threshold\"]').fill('7');","+      await enterDuration(page, 'Lockout duration', '10', 'm');","+      await enterDuration(page, 'Lockout counter reset', '30', 'm');","+      await page.getByRole('button', { name: 'Update options' }).click();","+      await expect(page.getByText('The configuration was saved successfully.')).toBeVisible();","+    });","+","+    await test.step('Vault stores all three values', async () => {","+      expect(await tune()).toMatchObject({","+        user_lockout_threshold: 7,","+        user_lockout_duration: 600,","+        user_lockout_counter_reset_duration: 1800,","+      });","+    });","+","+    await test.step('opening the page again shows the saved values', async () => {","+      await page.goto(options);","+      await expect(page.locator(label('Lockout duration').value)).toHaveValue('10');","+      await expect(page.locator(label('Lockout counter reset').value)).toHaveValue('30');","+      await expect(page.locator(label('Lockout counter reset').unit)).toHaveValue('m');","+      await expect(page.locator('[data-test-input=\"user_lockout_config.lockout_threshold\"]')).toHaveValue(","+        '7'","+      );","+      const counterReset = page.getByText('Lockout counter reset', { exact: true });","+      await highlightText(page, counterReset.locator('..'), 'Lockout counter reset');","+      await holdForVideo(page);","+    });","+","+    await test.step('saving again without changes keeps the values', async () => {","+      await page.getByRole('button', { name: 'Update options' }).click();","+      await expect(page.getByText('The configuration was saved successfully.')).toBeVisible();","+      expect(await tune()).toMatchObject({","+        user_lockout_threshold: 7,","+        user_lockout_duration: 600,","+        user_lockout_counter_reset_duration: 1800,","+      });","+    });","+  } finally {","+    await api.dispose();","+  }","+});"],"additions":100,"deletions":0,"truncated":false},{"path":"ui/tests/acceptance/settings/auth/configure/section-test.js","lines":["@@ -1,5 +1,5 @@"," /**","- * Copyright IBM Corp. 2016, 2025","+ * Copyright IBM Corp. 2016, 2026","  * SPDX-License-Identifier: BUSL-1.1","  */"," ","@@ -15,6 +15,7 @@ import page from 'vault/tests/pages/settings/auth/configure/section';"," import indexPage from 'vault/tests/pages/settings/auth/configure/index';"," import consolePanel from 'vault/tests/pages/components/console/ui-panel';"," import { login } from 'vault/tests/helpers/auth/auth-helpers';","+import { TTL_PICKER } from 'vault/tests/helpers/components/ttl-picker-selectors';"," "," import { GENERAL } from 'vault/tests/helpers/general-selectors';"," ","@@ -62,6 +63,36 @@ module('Acceptance | settings/auth/configure/section', function (hooks) {","     );","   });"," ","+  // Runs against a real Vault so a key it does not recognise would show up as a value that is not kept.","+  test('it saves lockout settings and shows them when the page is opened again', async function (assert) {","+    assert.expect(7);","+","+    const path = `userpass-lockout-${this.uid}`;","+    await enablePage.enable('userpass', path);","+    await page.visit({ path, section: 'options' });","+","+    await fillIn(GENERAL.inputByAttr('user_lockout_config.lockout_threshold'), '7');","+    await click(GENERAL.ttl.toggle('Lockout duration'));","+    await fillIn(GENERAL.ttl.input('Lockout duration'), '10');","+    await fillIn(TTL_PICKER.unitInputByLabel('Lockout duration'), 'm');","+    await click(GENERAL.ttl.toggle('Lockout counter reset'));","+    await fillIn(GENERAL.ttl.input('Lockout counter reset'), '30');","+    await fillIn(TTL_PICKER.unitInputByLabel('Lockout counter reset'), 'm');","+    await click(GENERAL.submitButton);","+    assert.strictEqual(page.flash.latestMessage, 'The configuration was saved successfully.');","+","+    await page.visit({ path, section: 'options' });","+    assert.dom(GENERAL.inputByAttr('user_lockout_config.lockout_threshold')).hasValue('7');","+    assert.dom(GENERAL.ttl.input('Lockout duration')).hasValue('10');","+    assert.dom(TTL_PICKER.unitInputByLabel('Lockout duration')).hasValue('m');","+    assert.dom(GENERAL.ttl.input('Lockout counter reset')).hasValue('30');","+    assert.dom(TTL_PICKER.unitInputByLabel('Lockout counter reset')).hasValue('m');","+","+    await click(GENERAL.submitButton);","+    await page.visit({ path, section: 'options' });","+    assert.dom(GENERAL.ttl.input('Lockout counter reset')).hasValue('30', 'saving again keeps the values');","+  });","+","   for (const type of ['aws', 'azure', 'gcp', 'github', 'kubernetes']) {","     test(`it shows tabs for auth method: ${type}`, async function (assert) {","       const path = `${type}-showtab-${this.uid}`;"],"additions":32,"deletions":1,"truncated":false},{"path":"ui/tests/integration/components/auth-config-form/options-test.js","lines":["@@ -89,6 +89,51 @@ module('Integration | Component | auth-config-form options', function (hooks) {","     );","   });"," ","+  // Defined before the loops below: the `return` in the unsupported-types loop ends this module's setup.","+  module('saved lockout settings', function () {","+    test('it shows the saved values and saves them back unchanged', async function (assert) {","+      assert.expect(8);","+      const path = 'my-userpass-auth';","+      const requests = [];","+      this.server.post(`sys/mounts/auth/${path}/tune`, (schema, req) => {","+        requests.push(JSON.parse(req.requestBody));","+        return {};","+      });","+      this.form = new AuthMethodForm({","+        path,","+        config: { listing_visibility: false },","+        user_lockout_config: {","+          lockout_threshold: '7',","+          lockout_duration: '600s',","+          lockout_counter_reset_duration: '1800s',","+          lockout_disable: true,","+        },","+      });","+      this.form.type = 'userpass';","+      await render(hbs`<AuthConfigForm::Options @form={{this.form}} />`);","+","+      assert.dom(GENERAL.inputByAttr('user_lockout_config.lockout_threshold')).hasValue('7');","+      assert.dom(GENERAL.inputByAttr('user_lockout_config.lockout_disable')).isChecked();","+      assert.dom(GENERAL.ttl.input('Lockout duration')).hasValue('10');","+      assert.dom(TTL_PICKER.unitInputByLabel('Lockout duration')).hasValue('m');","+      assert.dom(GENERAL.ttl.input('Lockout counter reset')).hasValue('30');","+      assert.dom(TTL_PICKER.unitInputByLabel('Lockout counter reset')).hasValue('m');","+","+      await click(GENERAL.submitButton);","+      assert.strictEqual(requests.length, 1, 'it saves once');","+      assert.propEqual(","+        requests[0].user_lockout_config,","+        {","+          lockout_threshold: '7',","+          lockout_duration: '600s',","+          lockout_counter_reset_duration: '1800s',","+          lockout_disable: true,","+        },","+        'the saved values are sent back with the keys Vault reads'","+      );","+    });","+  });","+","   // Defined before the loops below: the `return` in the unsupported-types loop ends this module's setup.","   module('durations longer than Vault supports', function (hooks) {","     hooks.beforeEach(function () {","@@ -109,7 +154,7 @@ module('Integration | Component | auth-config-form options', function (hooks) {","       ['Default Lease TTL', 'config.default_lease_ttl'],","       ['Max Lease TTL', 'config.max_lease_ttl'],","       ['Lockout duration', 'user_lockout_config.lockout_duration'],","-      ['Lockout counter reset', 'user_lockout_config.lockout_counter_reset'],","+      ['Lockout counter reset', 'user_lockout_config.lockout_counter_reset_duration'],","     ];"," ","     for (const [label, attr] of FIELDS) {","@@ -189,7 +234,7 @@ module('Integration | Component | auth-config-form options', function (hooks) {","           user_lockout_config: {","             lockout_threshold: '7',","             lockout_duration: '600s',","-            lockout_counter_reset: '5s',","+            lockout_counter_reset_duration: '5s',","             lockout_disable: true,","           },","         };"],"additions":47,"deletions":2,"truncated":false},{"path":"ui/tests/unit/routes/vault/cluster/settings/auth/configure/section-test.js","lines":["@@ -27,6 +27,80 @@ module('Unit | Route | vault/cluster/settings/auth/configure/section', function","     };","   });"," ","+  module('options', function (hooks) {","+    hooks.beforeEach(function () {","+      this.optionsFor = (config) => {","+        this.modelForStub.returns({","+          method: { id: 'userpass/' },","+          methodOptions: { type: 'userpass', config: { default_lease_ttl: 0, ...config } },","+        });","+        return this.route.modelForOptions().form;","+      };","+    });","+","+    test('it shows the lockout settings saved on the mount', function (assert) {","+      const form = this.optionsFor({","+        user_lockout_config: {","+          user_lockout_threshold: 7,","+          user_lockout_duration: 600,","+          user_lockout_counter_reset_duration: 1800,","+          user_lockout_disable: true,","+        },","+      });","+","+      assert.propEqual(","+        form.data.user_lockout_config,","+        {","+          lockout_threshold: '7',","+          lockout_duration: '600s',","+          lockout_counter_reset_duration: '1800s',","+          lockout_disable: true,","+        },","+        'saved settings use the keys the form sends back'","+      );","+    });","+","+    test('it leaves unset lockout settings empty', function (assert) {","+      const form = this.optionsFor({","+        user_lockout_config: {","+          user_lockout_threshold: 3,","+          user_lockout_duration: 0,","+          user_lockout_counter_reset_duration: 0,","+