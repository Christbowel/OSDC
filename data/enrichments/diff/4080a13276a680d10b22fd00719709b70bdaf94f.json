StructArray<T>(), new ExternalKeyOfUsedGenericStructArray<T>(), new ExternalKeyOf2<T, T>(),","+                new Wrapper<T>(), new Wrapper2<T>(), new GenericStruct<T>[1],","+            ];","+        }","+","+        public static void Run()","+        {","+            typeof(TestInteropMapTypeLoaderKeys).GetMethod(nameof(MakeTemplates)).MakeGenericMethod(Hide(typeof(Atom))).Invoke(null, []);","+","+            var proxyMap = TypeMapping.GetOrCreateProxyTypeMapping<Universe>();","+            var externalMap = TypeMapping.GetOrCreateExternalTypeMapping<Universe>();","+","+            Type atom = Hide(typeof(Atom));","+            Type atomB = Hide(typeof(AtomB));","+            Type atomC = Hide(typeof(AtomC));","+            _ = Hide(typeof(AtomD));","+","+            // The struct is present, but there is no array of it. Single-dimensional arrays need a template and there","+            // is no shared template for arrays of a non-generic struct, so the type loader can't create the array.","+            _ = Hide(typeof(Struct));","+","+            // The array of this struct is present, so the type loader can create the key.","+            Type arrayOfUsedStruct = Hide(typeof(UsedStruct[]));","+","+            // The element of this array is a generic type over a type that is present, so the type loader can create it.","+            Type arrayOfGenericStructOfAtom = MakeGeneric(typeof(GenericStruct<>), Hide(typeof(Atom))).MakeArrayType();","+","+            // Keys with two generic arguments. Each argument is either present or can be created by the type loader.","+            Type pairBothPresent = MakeGeneric(typeof(KeyOf2<,>), atom, atomB);","+            Type pairBothLoadable = MakeGeneric(typeof(KeyOf2<,>), MakeGeneric(typeof(Wrapper<>), atomB), MakeGeneric(typeof(Wrapper<>), atomC));","+","+            // The generic argument is a type that doesn't exist in the compilation, but the type loader can create it.","+            Type wrapperOfAtom = MakeGeneric(t