e {@link InterceptorBindingQualifier#resolveBoundOccurrences(AnnotationValue, AnnotationMetadata, boolean)}.","      */","     private boolean matches(AnnotationValue<?> interceptorAnnotationValue,","                             AnnotationMetadata interceptorMetadata,","@@ -205,6 +209,7 @@ private boolean matches(AnnotationValue<?> interceptorAnnotationValue,","         }","         final List<AnnotationValue<?>> interceptorOccurrences =","             InterceptorBindingQualifier.resolveBoundOccurrences(interceptorAnnotationValue, interceptorMetadata);","+        final boolean matchAllOccurrences = interceptorAnnotationValue.booleanValue(InterceptorBinding.META_MATCH_ALL_OCCURRENCES).orElse(false);","         boolean boundByOccurrences = false;","         boolean boundByNoOccurrences = false;","         for (AnnotationValue<?> applicableValue : interceptPointBindings) {","@@ -225,7 +230,9 @@ private boolean matches(AnnotationValue<?> interceptorAnnotationValue,","                 continue;","             }","             boundByOccurrences = true;","-            if (InterceptorBindingQualifier.anyMatch(interceptorOccurrences, interceptPointOccurrences)) {","+            if (matchAllOccurrences","+                ? allMatch(interceptorOccurrences, interceptPointOccurrences)","+                : InterceptorBindingQualifier.anyMatch(interceptorOccurrences, interceptPointOccurrences)) {","                 return true;","             }","         }","@@ -233,6 +240,27 @@ private boolean matches(AnnotationValue<?> interceptorAnnotationValue,","         return boundByNoOccurrences && !boundByOccurrences;","     }"," ","+    /**","+     * Whether every occurrence declared on an interceptor is the same annotation as one of the occurrences at the","+     * interception point, which may declare more.","+     */","+    private static boolean allMatch(List<AnnotationValue<?>> interceptorOccurrences,","+                                    List<AnnotationValue<?>> interceptPointOccurrences) {","+        for (AnnotationValue<?> required : interceptorOccurrences) {","+            boolean found = false;","+            for (AnnotationValue<?> present : interceptPointOccurrences) {","+                if (required.matches(present)) {","+                    found = true;","+                    break;","+                }","+            }","+            if (!found) {","+                return false;","+            }","+        }","+        return true;","+    }","+","     private <T> boolean isApplicableByType(BeanRegistration<Interceptor<T, ?>> beanRegistration,","                                            AnnotationValue<?> applicableValue) {","         AnnotationClassValue<?> interceptorType = applicableValue.annotationClassValue(InterceptorBindingQualifier.META_MEMBER_INTERCEPTOR_TYPE).orElse(null);"],"additions":30,"deletions":2,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/aop/binding/RepeatableBindingOverrideSpec.groovy","lines":["@@ -0,0 +1,102 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.aop.binding","+","+import io.micronaut.annotation.processing.test.AbstractTypeElementSpec","+import io.micronaut.core.annotation.AnnotationUtil","+import io.micronaut.inject.qualifiers.InterceptorBindingQualifier","+","+class RepeatableBindingOverrideSpec extends AbstractTypeElementSpec {","+","+    void 'the occurrences declared on a method replace those of its class only when opted in: #all, #tags'() {","+        given:","+        def context = buildContext(\"\"\"","+package repeatableoverride;","+","+import io.micronaut.aop.*;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@Repeatable(Tags.class)","+@Around","+@InterceptorBinding(bindMembers = true, matchAllOccurrences = $all)","+@interface Tag {","+    String value();","+}","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@interface Tags {","+    Tag[] value();","+}","+","+@Singleton","+@Tag(\"a\")","+class AInterceptor implements MethodInterceptor<Object, Object> {","+    static int calls;","+    public Object intercept(MethodInvocationContext<Object, Object> context) {","+        calls++;","+        return context.proceed();","+    }","+}","+","+@Singleton","+@Tag(\"b\")","+class BInterceptor implements MethodInterceptor<Object, Object> {","+    static int calls;","+    public Object intercept(MethodInvocationContext<Object, Object> context) {","+        calls++;","+        return context.proceed();","+    }","+}","+","+@Singleton","+@Tag(\"a\")","+class TargetBean {","+    ${tags.collect { '@Tag(\"' + it + '\")' }.join('\\n')}","+    public String work() {","+        return \"done\";","+    }","+}","+\"\"\")","+        def targetType = context.classLoader.loadClass('repeatableoverride.TargetBean')","+        def method = context.getBeanDefinition(targetType).getRequiredMethod('work')","+        def binding = method.annotationMetadata.getAnnotationValuesByName(AnnotationUtil.ANN_INTERCEPTOR_BINDING)","+            .find { it.stringValue().orElse('') == 'repeatableoverride.Tag' }","+","+        when:","+        context.getBean(targetType).work()","+","+        then:","+        context.classLoader.loadClass('repeatableoverride.AInterceptor').calls == aCalls","+        context.classLoader.loadClass('repeatableoverride.BInterceptor').calls == bCalls","+        InterceptorBindingQualifier.resolveBoundOccurrences(binding, method.annotationMetadata, true)","+            .collect { it.stringValue().get() }.toSet() == effective.toSet()","+","+        cleanup:","+        context.close()","+","+        where:","+        all      | tags       | aCalls | bCalls | effective","+        false    | ['b']      | 1      | 1      | ['a', 'b']","+        true     | ['b']      | 0      | 1      | ['b']","+        true     | ['b', 'c'] | 0      | 1      | ['b', 'c']","+        false    | []         | 1      | 0      | ['a']","+        true     | []         | 1      | 0      | ['a']","+    }","+}"],"additions":102,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/aop/binding/RepeatableBindingSelectionSpec.groovy","lines":["@@ -0,0 +1,189 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.aop.binding","+","+import io.micronaut.annotation.processing.test.AbstractTypeElementSpec","+import io.micronaut.core.annotation.AnnotationUtil","+","+class RepeatableBindingSelectionSpec extends AbstractTypeElementSpec {","+","+    void 'repeatable bindings match every occurrence only when opted in: #all, #tags'() {","+        given:","+        def context = buildContext(source(all, tags))","+        def targetType = context.classLoader.loadClass('repeatablebinding.TargetBean')","+        def interceptorType = context.classLoader.loadClass('repeatablebinding.TagInterceptor')","+","+        when:","+        context.getBean(targetType).work()","+","+        then:","+        interceptorType.calls == expected","+        context.getBeanDefinition(interceptorType).annotationMetadata","+            .getAnnotationValuesByName(AnnotationUtil.ANN_INTERCEPTOR_BINDING)","+            .find { it.stringValue().orElse('') == 'repeatablebinding.Tag' }","+            .booleanValue('matchAllOccurrences').orElse(false) == all","+","+        cleanup:","+        context.close()","+","+        where:","+        all   | tags           | expected","+        false | ['a']          | 1","+        true  | ['a']          | 0","+        true  | ['a', 'b']     | 1","+        true  | ['a', 'b', 'c'] | 1","+        true  | ['b', 'c']     | 0","+    }","+","+    void 'a method narrowing the group of its class loses an interceptor requiring the whole group: #all'() {","+        given:","+        def context = buildContext(\"\"\"","+package repeatablegroup;","+","+import io.micronaut.aop.*;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD, ElementType.ANNOTATION_TYPE})","+@Repeatable(Tags.class)","+@Around","+@InterceptorBinding(bindMembers = true, matchAllOccurrences = $all)","+@interface Tag {","+    String value();","+}","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD, ElementType.ANNOTATION_TYPE})","+@interface Tags {","+    Tag[] value();","+}","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@Tag(\"a\")","+@Tag(\"b\")","+@interface TaggedAB {","+}","+","+@Singleton","+@Tag(\"a\")","+@Tag(\"b\")","+class TagInterceptor implements MethodInterceptor<Object, Object> {","+    static java.util.List<String> calls = new java.util.ArrayList<>();","+","+    public Object intercept(MethodInvocationContext<Object, Object> context) {","+        calls.add(context.getMethodName());","+        return context.proceed();","+    }","+}","+","+@Singleton","+@Tag(\"a\")","+@Tag(\"b\")","+class TargetBean {","+    public void inherited() {","+    }","+","+    @Tag(\"b\")","+    public void narrowed() {","+    }","+","+    @Tag(\"a\")","+    @Tag(\"b\")","+    @Tag(\"c\")","+    public void widened() {","+    }","+","+    @Tag(\"c\")","+    @TaggedAB","+    public void composed() {","+    }","+}","+\"\"\")","+        def targetType = context.classLoader.loadClass('repeatablegroup.TargetBean')","+        def calls = context.classLoader.loadClass('repeatablegroup.TagInterceptor').calls","+        def target = context.getBean(targetType)","+        def binding = context.getBeanDefinition(targetType).getRequiredMethod('narrowed').annotationMetadata","+            .getAnnotationValuesByName(AnnotationUtil.ANN_INTERCEPTOR_BINDING)","+            .find { it.stringValue().orElse('') == 'repeatablegroup.Tag' }","+","+        when:","+        target.inherited()","+        target.narrowed()","+        target.widened()","+        target.composed()","+","+        then:","+        calls == expected","+        binding.booleanValue('matchAllOccurrences').orElse(false) == all","+","+        cleanup:","+        context.close()","+","+        where:","+        all   | expected","+        false | ['inherited', 'narrowed', 'widened', 'composed']","+        true  | ['inherited', 'widened', 'composed']","+    }","+","+    private static String source(boolean all, List<String> tags) {","+        return \"\"\"","+package repeatablebinding;","+","+import io.micronaut.aop.*;","+import io.micronaut.context.annotation.NonBinding;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@Repeatable(Tags.class)","+@Around","+@InterceptorBinding(bindMembers = true, matchAllOccurrences = $all)","+@interface Tag {","+    String value();","+    @NonBinding String description() default \"\";","+}","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@interface Tags {","+    Tag[] value();","+}","+","+@Singleton","+@Tag(value = \"a\", description = \"interceptor a\")","+@Tag(value = \"b\", description = \"interceptor b\")","+class TagInterceptor implements MethodInterceptor<Object, Object> {","+    static int calls;","+","+    public Object intercept(MethodInvocationContext<Object, Object> context) {","+        calls++;","+        return context.proceed();","+    }","+}","+","+@Singleton","+${tags.collect { '@Tag(value = \"' + it + '\", description = \"target\")' }.join('\\n')}","+class TargetBean {","+    public String work() {","+        return \"done\";","+    }","+}","+\"\"\"","+    }","+}"],"additions":189,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/aop/binding/RepeatableBindingWrappedMetadataSpec.groovy","lines":["@@ -0,0 +1,100 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.aop.binding","+","+import io.micronaut.annotation.processing.test.AbstractTypeElementSpec","+","+class RepeatableBindingWrappedMetadataSpec extends AbstractTypeElementSpec {","+","+    void 'every occurrence is matched when the metadata of the target is wrapped: #label'() {","+        given:","+        def context = buildContext(\"\"\"","+package wrappedgroup;","+","+import io.micronaut.aop.*;","+import jakarta.inject.Singleton;","+import java.lang.annotation.*;","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@Repeatable(Tags.class)","+@Around(proxyTarget = true)","+@InterceptorBinding(bindMembers = true, matchAllOccurrences = true)","+@interface Tag {","+    String value();","+}","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE, ElementType.METHOD})","+@interface Tags {","+    Tag[] value();","+}","+","+@Retention(RetentionPolicy.RUNTIME)","+@java.lang.annotation.Target({ElementType.TYPE})","+@interface Label {","+    String value();","+}","+","+@Singleton","+@Tag(\"a\")","+@Tag(\"b\")","+class TagInterceptor implements MethodInterceptor<Object, Object> {","+    static java.util.List<String> calls = new java.util.ArrayList<>();","+","+    public Object intercept(MethodInvocationContext<Object, Object> context) {","+        calls.add(context.getMethodName());","+        return context.proceed();","+    }","+}","+","+@Singleton","+@Label(\"$label\")","+@Tag(\"a\")","+@Tag(\"b\")","+class TargetBean {","+    public void inherited() {","+    }","+","+    @Tag(\"b\")","+    public void narrowed() {","+    }","+","+    @Tag(\"a\")","+    @Tag(\"b\")","+    @Tag(\"c\")","+    public void widened() {","+    }","+}","+\"\"\")","+        def target = context.getBean(context.classLoader.loadClass('wrappedgroup.TargetBean'))","+        def calls = context.classLoader.loadClass('wrappedgroup.TagInterceptor').calls","+","+        when:","+        target.inherited()","+        target.narrowed()","+        target.widened()","+","+        then:","+        calls == ['inherited', 'widened']","+","+        cleanup:","+        context.close()","+","+        where:","+        label << ['constant', '${label:constant}', '#{true}']","+    }","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"inject-python-test/src/test/groovy/io/micronaut/python/annotation/processing/test/RepeatableBindingSelectionSpec.groovy","lines":["@@ -0,0 +1,79 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.python.annotation.processing.test","+","+/**","+ * Selection of interceptors bound by a repeatable binding annotation applied to Python classes.","+ */","+class RepeatableBindingSelectionSpec extends AbstractPythonTypeElementSpec {","+","+    void \"repeatable bindings on Python classes match every occurrence only when opted in: #tag\"() {","+        given:","+        def context = buildContext(\"\"\"","+from io.micronaut.python.annotation.processing.test.aop import ${tag}","+from micronaut.aop import MethodInvocationContext","+from micronaut.context.annotation import Executable","+from jakarta.inject import Singleton","+import java","+","+MethodInterceptor = java.type(\"io.micronaut.aop.MethodInterceptor\")","+","+@Singleton","+@${tag}(\"a\", note=\"interceptor\")","+@${tag}(\"b\")","+class TagInterceptor(MethodInterceptor):","+    def intercept(self, context: MethodInvocationContext):","+        return f\"[tagged] {context.proceed()}\"","+","+@Singleton","+@${tag}(\"a\", note=\"target\")","+@${tag}(\"b\")","+class Target:","+    def inherited(self) -> str:","+        return \"inherited\"","+","+    @${tag}(\"b\")","+    def narrowed(self) -> str:","+        return \"narrowed\"","+","+    @${tag}(\"a\")","+    @${tag}(\"b\")","+    @${tag}(\"c\")","+    def widened(self) -> str:","+        return \"widened\"","+","+@Singleton","+class Caller:","+    def __init__(self, target: Target):","+        self.target = target","+","+    @Executable","+    def call(self) -> str:","+        return \",\".join([self.target.inherited(), self.target.narrowed(), self.target.widened()])","+\"\"\")","+","+        expect:","+        getBean(context, \"python.Caller\").call() == expected","+","+        cleanup:","+        context?.close()","+","+        where:","+        tag      | expected","+        'AnyTag' | '[tagged] inherited,[tagged] narrowed,[tagged] widened'","+        'AllTag' | '[tagged] inherited,narrowed,[tagged] widened'","+    }","+}"],"additions":79,"deletions":0,"truncated":false},{"path":"inject-python-test/src/test/java/io/micronaut/python/annotation/processing/test/aop/AllTag.java","lines":["@@ -0,0 +1,39 @@","+/*","+ * Copyright 2017-2026 original authors","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ * https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package io.micronaut.python.annotation.processing.test.aop;","+","+import io.micronaut.aop