{"id":"GHSA-w4v4-9rw7-5326","axis":"advisories","repo":"traefik/traefik","sha":"a277e94664ffc1ce9543df552d3bbf48d4d3b8b3","parsed":{"files":[{"path":"docs/content/migration/v2.md","lines":["@@ -1129,3 +1129,40 @@ as the HTTP weighted service already was."," Such a parent service previously reported neither an error nor a status."," "," This only changes what is reported: the routers referencing the parent service were already not created.","+","+## v2.11.57","+","+### h2c Upgrade Requests","+","+Starting with `v2.11.57`, Traefik does not forward the `Upgrade: h2c` and `HTTP2-Settings` request headers","+to the backends anymore.","+","+Traefik does not implement the deprecated h2c upgrade mechanism, it only serves unencrypted HTTP/2 with prior knowledge.","+Forwarding those headers let a backend accept an upgrade that Traefik itself had not negotiated with the client.","+","+A backend that used to accept such an upgrade now serves those requests over HTTP/1.1.","+To reach a backend over unencrypted HTTP/2, declare its servers with the `h2c` scheme:","+","+```yaml tab=\"File (YAML)\"","+## Dynamic configuration","+http:","+  services:","+    my-service:","+      loadBalancer:","+        servers:","+        - url: \"h2c://private-ip-server-1:8080\"","+```","+","+```toml tab=\"File (TOML)\"","+## Dynamic configuration","+[http.services]","+  [http.services.my-service.loadBalancer]","+","+    [[http.services.my-service.loadBalancer.servers]]","+      url = \"h2c://private-ip-server-1:8080\"","+```","+","+The providers exposing a scheme instead of a server URL take it the same way,","+with the `traefik.http.services.<service_name>.loadbalancer.server.scheme=h2c` label,","+the `scheme: h2c` option of the Kubernetes CRD,","+or the `traefik.ingress.kubernetes.io/service.serversscheme: h2c` Kubernetes Ingress annotation."],"additions":37,"deletions":0,"truncated":false},{"path":"pkg/server/service/proxy.go","lines":["@@ -148,7 +148,7 @@ func buildProxy(passHostHeader *bool, responseForwarding *dynamic.ResponseForwar"," \t\t},"," \t}"," ","-\treturn newConnectHandler(proxy), nil","+\treturn newConnectHandler(newH2CUpgradeHandler(proxy)), nil"," }"," "," // isTLSError returns true if the error is a TLS error which is related to configuration."],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/server/service/upgrade.go","lines":["@@ -0,0 +1,37 @@","+package service","+","+import (","+\t\"net/http\"","+","+\t\"golang.org/x/net/http/httpguts\"","+)","+","+// h2cUpgradeHandler removes a client-initiated h2c upgrade before the request reaches the reverse proxy.","+// Since go1.24, unencrypted HTTP/2 is served through http.Server#Protocols, which supports prior knowledge only and","+// not the deprecated \"Upgrade: h2c\" mechanism (https://go.dev/doc/go1.24#nethttppkgnethttp).","+// As Traefik no longer honors an h2c upgrade, the token has no reason to reach a backend.","+//","+// This is a temporary workaround for httputil.ReverseProxy, which forwards the token, see https://go.dev/issue/80416.","+// It has to be removed once the go directive in go.mod requires a Go release carrying that fix.","+type h2cUpgradeHandler struct {","+\tnext http.Handler","+}","+","+// newH2CUpgradeHandler wraps next with the h2c upgrade removal behavior.","+func newH2CUpgradeHandler(next http.Handler) http.Handler {","+\treturn &h2cUpgradeHandler{next: next}","+}","+","+func (h *h2cUpgradeHandler) ServeHTTP(rw http.ResponseWriter, req *http.Request) {","+\tif httpguts.HeaderValuesContainsToken(req.Header[\"Connection\"], \"Upgrade\") &&","+\t\thttpguts.HeaderValuesContainsToken([]string{req.Header.Get(\"Upgrade\")}, \"h2c\") {","+\t\t// Removing the Upgrade header is enough: the reverse proxy then computes an empty upgrade type, removes","+\t\t// Connection as a hop-by-hop header, and adds neither of them back.","+\t\tdelete(req.Header, \"Upgrade\")","+\t}","+","+\t// HTTP2-Settings is connection-specific (RFC 7540 section 3.2.1), so it is not forwarded either.","+\tdelete(req.Header, \"Http2-Settings\")","+","+\th.next.ServeHTTP(rw, req)","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"pkg/server/service/upgrade_test.go","lines":["@@ -0,0 +1,147 @@","+package service","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"golang.org/x/net/http/httpguts\"","+)","+","+const http2Settings = \"AAMAAABkAAQAoAAAAAIAAAAA\"","+","+func TestH2CUpgradeNotForwarded(t *testing.T) {","+\ttestCases := []struct {","+\t\tdesc            string","+\t\trequestHeaders  http.Header","+\t\texpectedHeaders http.Header","+\t}{","+\t\t{","+\t\t\tdesc: \"h2c upgrade with HTTP2-Settings listed in Connection\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\":     {\"Upgrade, HTTP2-Settings\"},","+\t\t\t\t\"Upgrade\":        {\"h2c\"},","+\t\t\t\t\"Http2-Settings\": {http2Settings},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"h2c upgrade with HTTP2-Settings smuggled out of Connection\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\":     {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":        {\"h2c\"},","+\t\t\t\t\"Http2-Settings\": {http2Settings},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"h2c upgrade without HTTP2-Settings\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"h2c\"},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"h2c upgrade with an uppercase token\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"H2C\"},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"h2c upgrade combined with a websocket upgrade\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"websocket, h2c\"},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"HTTP2-Settings without an upgrade\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Http2-Settings\": {http2Settings},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"websocket upgrade is preserved\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"websocket\"},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"websocket\"},","+\t\t\t},","+\t\t},","+\t\t// Only the first Upgrade value is inspected, as the upstream fix does, hence the two outcomes below.","+\t\t// Both are equivalent in the end: the reverse proxy replaces the Upgrade values it forwards with the first","+\t\t// one, so a later h2c value never reaches the backend either.","+\t\t{","+\t\t\tdesc: \"h2c as the first Upgrade value drops every upgrade\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"h2c\", \"websocket\"},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{},","+\t\t},","+\t\t{","+\t\t\tdesc: \"h2c as a later Upgrade value keeps the first one\",","+\t\t\trequestHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"websocket\", \"h2c\"},","+\t\t\t},","+\t\t\texpectedHeaders: http.Header{","+\t\t\t\t\"Connection\": {\"Upgrade\"},","+\t\t\t\t\"Upgrade\":    {\"websocket\"},","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, test := range testCases {","+\t\tt.Run(test.desc, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\tbackend := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\t\t\tforwarded := http.Header{}","+\t\t\t\tfor _, name := range []string{\"Connection\", \"Upgrade\", \"Http2-Settings\"} {","+\t\t\t\t\tif values := req.Header.Values(name); len(values) > 0 {","+\t\t\t\t\t\tforwarded[name] = values","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tassert.Equal(t, test.expectedHeaders, forwarded)","+","+\t\t\t\t// The backend switches to h2c on any Upgrade: h2c, without the validations RFC 7540 section 3.2.1 requires.","+\t\t\t\tif !httpguts.HeaderValuesContainsToken([]string{req.Header.Get(\"Upgrade\")}, \"h2c\") {","+\t\t\t\t\treturn","+\t\t\t\t}","+","+\t\t\t\trw.Header().Set(\"Connection\", \"Upgrade\")","+\t\t\t\trw.Header().Set(\"Upgrade\", \"h2c\")","+\t\t\t\trw.WriteHeader(http.StatusSwitchingProtocols)","+\t\t\t}))","+\t\t\tt.Cleanup(backend.Close)","+","+\t\t\tproxyHandler, err := buildProxy(new(true), nil, http.DefaultTransport, nil)","+\t\t\trequire.NoError(t, err)","+","+\t\t\tproxy := createProxyWithForwarder(t, proxyHandler, backend.URL)","+\t\t\tt.Cleanup(proxy.Close)","+","+\t\t\treq, err := http.NewRequest(http.MethodGet, proxy.URL+\"/public\", http.NoBody)","+\t\t\trequire.NoError(t, err)","+","+\t\t\treq.Header = test.requestHeaders","+","+\t\t\tresp, err := proxy.Client().Do(req)","+\t\t\trequire.NoError(t, err)","+\t\t\tt.Cleanup(func() { _ = resp.Body.Close() })","+","+\t\t\tassert.Equal(t, http.StatusOK, resp.StatusCode)","+\t\t})","+\t}","+}",""],"additions":147,"deletions":0,"truncated":false}],"additions":222,"deletions":1,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-09-11T13:01:01.989251+00:00"}