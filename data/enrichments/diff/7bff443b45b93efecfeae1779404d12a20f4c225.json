 /// Whether the next byte is inside a string.","+    lexer: JsonLexer,","+    /// Index of the frame's first bracket.","+    start_idx: usize,","+    /// Whitespace bytes in the frame.","+    whitespaces: usize,","+}","+","+impl FrameScan {","+    /// Scans the bytes not scanned yet and returns the index of the frame's last byte, once the","+    /// frame is complete.","+    fn advance(&mut self, bytes: &[u8]) -> Option<usize> {","         const fn is_whitespace(byte: u8) -> bool {","             matches!(byte, 0x0D | 0x0A | 0x20 | 0x09)","         }"," ","-        let mut depth = 0;","-        let mut in_str = false;","-        let mut is_escaped = false;","-        let mut start_idx = 0;","-        let mut whitespaces = 0;","-","-        for idx in 0..buf.as_ref().len() {","-            let byte = buf.as_ref()[idx];","+        while let Some(&byte) = bytes.get(self.next_idx) {","+            let idx = self.next_idx;","+            self.next_idx += 1;","             let mut malformed = false;"," ","-            if (byte == b'{' || byte == b'[') && !in_str {","-                if depth == 0 {","-                    start_idx = idx;","-                }","-                depth += 1;","-            } else if (byte == b'}' || byte == b']') && !in_str {","-                if depth == 0 {","-                    malformed = true;","-                } else {","-                    depth -= 1;","-                }","-            } else if byte == b'\"' && !is_escaped {","-                in_str = !in_str;","-            } else if is_whitespace(byte) {","-                whitespaces += 1;","+            self.lexer = match self.lexer {","+                JsonLexer::Outside => match byte {","+                    b'{' | b'[' => {","+                        if self.depth == 0 {","+                            // Whitespace before the frame's first bracket is not part of it.","+                            self.start_idx = idx;","+                            self.whitespaces = 0;","+                        }","+                        self.depth += 1;","+                        JsonLexer::Outside","+                    }","+                    b'}' | b']' => {","+                        if self.depth == 0 {","+                            malformed = true;","+                        } else {","+                            self.depth -= 1;","+                        }","+                        JsonLexer::Outside","+                    }","+                    b'\"' => JsonLexer::InString,","+                    _ => JsonLexer::Outside,","+                },","+                JsonLexer::InString => match byte {","+                    b'\"' => JsonLexer::Outside,","+                    b'\\\\' => JsonLexer::Escaped,","+                    _ => JsonLexer::InString,","+                },","+                JsonLexer::Escaped => JsonLexer::InString,","+            };","+            if is_whitespace(byte) {","+                self.whitespaces += 1;","+            }","+","+            if malformed","+                || (self.depth == 0","+                    && idx != self.start_idx","+                    && idx - self.start_idx + 1 > self.whitespaces)","+            {","+                return Some(idx);","             }","-            is_escaped = byte == b'\\\\' && !is_escaped && in_str;","-","-            if malformed || (depth == 0 && idx != start_idx && idx - start_idx + 1 > whitespaces) {","-                let bts = buf.split_to(idx + 1);","-                return match String::from_utf8(bts.as_ref().to_vec()) {","-                    Ok(val) => Ok(Some(val)),","-                    Err(_) => Ok(None),","-                };","+        }","+        None","+    }","+}","+","+// Adapted from <https://github.com/paritytech/jsonrpc/blob/38af3c9439aa75481805edf6c05c6622a5ab1e70/server-utils/src/stream_codec.rs#L47-L105>","+impl tokio_util::codec::Decoder for JsonRpcCodec {","+    type Item = String;","+    type Error = io::Error;","+","+    fn decode(&mut self, buf: &mut BytesMut) -> io::Result<Option<Self::Item>> {","+        loop {","+            let Some(end) = self.scan.advance(buf.as_ref()) else { return Ok(None) };","+            self.scan = FrameScan::default();","+            let bts = buf.split_to(end + 1);","+            // Drop a frame that is not UTF-8 and frame what follows it, which would otherwise","+            // wait in the buffer until the peer sends more bytes.","+            if let Ok(val) = String::from_utf8(bts.as_ref().to_vec()) {","+                return Ok(Some(val));","             }","         }","-        Ok(None)","     }"," }"," ","@@ -188,3 +248,64 @@ fn to_name(path: &std::ffi::OsStr) -> io::Result<ls::Name<'_>> {","         ls::ToFsName::to_fs_name::<ls::GenericFilePath>(path)","     }"," }","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+    use tokio_util::codec::Decoder;","+","+    fn decode_all(input: &str) -> Vec<String> {","+        let mut buf = BytesMut::from(input);","+        let mut codec = JsonRpcCodec::default();","+        let mut out = Vec::new();","+        while let Some(msg) = codec.decode(&mut buf).unwrap() {","+            out.push(msg);","+        }","+        out","+    }","+","+    #[test]","+    fn splits_messages_ignoring_brackets_and_quotes_in_strings() {","+        let first = r#\"{\"a\":\"}]{[\",\"b\":\"\\\"}\",\"c\":\"\\\\\"}\"#;","+        let second = r#\" [1, {\"d\": \"x\\\\\\\"]\"}]\"#;","+        assert_eq!(decode_all(&format!(\"{first}{second}\\n {{\")), [first, second]);","+    }","+","+    #[test]","+    fn closing_bracket_without_opening_is_returned() {","+        assert_eq!(decode_all(\" ]{}\"), [\" ]\", \"{}\"]);","+    }","+","+    #[test]","+    fn leading_whitespace_does_not_hide_short_message() {","+        // An empty batch after a CRLF-terminated message must not swallow the next request.","+        let next = r#\"{\"id\":1}\"#;","+        assert_eq!(decode_all(&format!(\"\\r\\n[]\\r\\n{next}\")), [\"\\r\\n[]\", &for