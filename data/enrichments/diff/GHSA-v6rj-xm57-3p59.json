{"id":"GHSA-v6rj-xm57-3p59","axis":"advisories","repo":"rails/rails","sha":"06938194b4fd59e1d2c8ab4a781f3c1e2b763425","parsed":{"files":[{"path":"actionview/CHANGELOG.md","lines":["@@ -1,3 +1,19 @@","+*   Escape the matched phrase before substituting it into `highlight`'s","+    `:highlighter`.","+","+    A match was copied into each `\\1` of the highlighter as it appeared in","+    the sanitized text, which keeps `\"` and `'` as they are, so a match","+    containing a quote ended a quoted attribute value such as the","+    documented `'<a href=\"search?q=\\1\">\\1</a>'` and added attributes of","+    its own. Each substituted group now goes through","+    `ERB::Util.html_escape_once`, so quotes in a match render as `&quot;`","+    and `&#39;`. Only the numbered placeholders `\\0` to `\\9` are expanded,","+    and a match never replaces the `>` that closes a tag.","+","+    [GHSA-v6rj-xm57-3p59]","+","+    *Jeremy Daer*","+"," *   Require rails-html-sanitizer 1.7.2 or later."," ","     With the HTML5 sanitizer, Nokogiri before 1.19.5 left `<` and `>`"],"additions":16,"deletions":0,"truncated":false},{"path":"actionview/lib/action_view/helpers/text_helper.rb","lines":["@@ -143,8 +143,15 @@ def truncate(text, options = {}, &block)","       #","       # [+:highlighter+]","       #   The highlighter string. Uses <tt>\\1</tt> as the placeholder for a","-      #   phrase, similar to +String#sub+. Defaults to <tt>\"<mark>\\1</mark>\"</tt>.","-      #   This option is ignored if a block is specified.","+      #   phrase. Defaults to <tt>\"<mark>\\1</mark>\"</tt>. The numbered placeholders","+      #   <tt>\\0</tt> to <tt>\\9</tt> are expanded; other +String#sub+ replacement escapes","+      #   are not. The phrase is HTML escaped, quotes included. This option","+      #   is ignored if a block is specified.","+      #","+      #   WARNING: Put a placeholder only in element content or inside a","+      #   quoted attribute value. HTML escaping does not make the phrase safe","+      #   in an unquoted attribute value, in a URL, JavaScript or CSS","+      #   context, or in an attribute whose value is HTML, such as +srcdoc+.","       #","       # [+:sanitize+]","       #   Whether to sanitize +text+ before highlighting. Defaults to true.","@@ -163,8 +170,8 @@ def truncate(text, options = {}, &block)","       #   highlight('You searched for: rails', ['for', 'rails'], highlighter: '<em>\\1</em>')","       #   # => \"You searched <em>for</em>: <em>rails</em>\"","       #","-      #   highlight('You searched for: rails', 'rails', highlighter: '<a href=\"search?q=\\1\">\\1</a>')","-      #   # => \"You searched for: <a href=\\\"search?q=rails\\\">rails</a>\"","+      #   highlight('You searched for: rails', 'rails', highlighter: '<mark title=\"\\1\">\\1</mark>')","+      #   # => \"You searched for: <mark title=\\\"rails\\\">rails</mark>\"","       #","       #   highlight('You searched for: rails', 'rails') { |match| link_to(search_path(q: match)) }","       #   # => \"You searched for: <a href=\\\"search?q=rails\\\">rails</a>\"","@@ -179,14 +186,23 @@ def highlight(text, phrases, options = {}, &block)","         else","           patterns = Array(phrases).map { |phrase| Regexp === phrase ? phrase : Regexp.escape(phrase) }","           pattern = /(#{patterns.join(\"|\")})/i","+          # The text after a tag begins with the \">\" that closes it. Leave it","+          # in the segment so phrases can see it as context, but keep it out","+          # of the match so the highlighter can't take the place of the \">\".","+          pattern_after_tag = /(?!\\A)#{pattern}/","           highlighter = options.fetch(:highlighter, '<mark>\\1</mark>') unless block"," ","-          text.scan(/<[^>]*|[^<]+/).each do |segment|","+          text.scan(/<[^>]*|[^<]+/).each_with_index do |segment, index|","             if !segment.start_with?(\"<\")","+              segment_pattern = index > 0 ? pattern_after_tag : pattern","+","               if block","-                segment.gsub!(pattern, &block)","+                segment.gsub!(segment_pattern, &block)","               else","-                segment.gsub!(pattern, highlighter)","+                segment.gsub!(segment_pattern) do","+                  match = Regexp.last_match","+                  highlighter.gsub(/\\\\(\\d)/) { ERB::Util.html_escape_once(match[$1.to_i]) }","+                end","               end","             end","           end.join"],"additions":23,"deletions":7,"truncated":false},{"path":"actionview/test/template/text_helper_test.rb","lines":["@@ -275,6 +275,66 @@ def test_highlight_with_html","     )","   end"," ","+  def test_highlight_escapes_quotes_in_the_highlighted_phrase","+    assert_equal(","+      \"<a href=\\\"search?q=rails&quot; onclick=&quot;alert(1)\\\">rails&quot; onclick=&quot;alert(1)</a>\",","+      highlight(\"rails\\\" onclick=\\\"alert(1)\", \"rails\\\" onclick=\\\"alert(1)\", highlighter: '<a href=\"search?q=\\1\">\\1</a>')","+    )","+    assert_equal(","+      \"<a title='rails&#39; onclick=&#39;alert(1)'>rails&#39; onclick=&#39;alert(1)</a>\",","+      highlight(\"rails' onclick='alert(1)\", /rails.*/, highlighter: \"<a title='\\\\1'>\\\\1</a>\")","+    )","+    assert_equal(","+      \"<a title=\\\"rails&quot; onclick=&quot;alert(1)\\\">rails&quot; onclick=&quot;alert(1)</a>\",","+      highlight(\"rails\\\" onclick=\\\"alert(1)\", /rails.*/, highlighter: '<a title=\"\\0\">\\0</a>', sanitize: false)","+    )","+  end","+","+  def test_highlight_does_not_escape_the_highlighted_phrase_twice","+    assert_equal(","+      \"<mark title=\\\"ruby &amp; rails\\\">ruby &amp; rails</mark>\",","+      highlight(\"ruby & rails\", /ruby.*rails/, highlighter: '<mark title=\"\\1\">\\1</mark>')","+    )","+  end","+","+  def test_highlight_with_regexp_groups_in_highlighter","+    assert_equal(","+      \"ruby <b>on</b> <i title=\\\"&quot;rails&quot;\\\">&quot;rails&quot;</i>\",","+      highlight(\"ruby on \\\"rails\\\"\", /(on) (\\S+)/, highlighter: '<b>\\2</b> <i title=\"\\3\">\\3</i>\\4')","+    )","+  end","+","+  def test_highlight_with_html_safe_highlighter","+    assert_equal(","+      \"<mark title=\\\"&quot;rails&quot;\\\">&quot;rails&quot;</mark>\",","+      highlight(\"\\\"rails\\\"\", \"\\\"rails\\\"\", highlighter: content_tag(:mark, '\\1', title: '\\1'))","+    )","+  end","+","+  def test_highlight_does_not_replace_the_end_of_a_tag","+    text = \"<img src=\\\"x\\\"> onerror=alert(1) a=\\\" <b>end</b>\"","+    assert_equal text, highlight(text, \">\", highlighter: '\\1')","+    assert_equal text, highlight(text, \">\") { |match| \"\" }","+    assert_equal text, highlight(text, /.*end/, highlighter: '\\1')","+    assert_equal text, highlight(text, />.*/, highlighter: '\\1')","+    assert_equal text, highlight(text, \">\", highlighter: '\\1', sanitize: false)","+    assert_equal text, highlight(text, />.*/, highlighter: '\\1', sanitize: false)","+","+    assert_equal \"<p>rails</p>\", highlight(\"<p>rails</p>\", \">\")","+    assert_equal \"<p>rails</p>\", highlight(\"<p>rails</p>\", />rails/)","+    assert_equal \"<p><mark>rails</mark></p>\", highlight(\"<p>rails</p>\", /.*rails.*/)","+    assert_equal \"<p><mark>rails</mark></p>\", highlight(\"<p>rails</p>\", /.*rails.*/) { |match| \"<mark>#{match}</mark>\" }","+","+    assert_equal \"<mark>&gt;</mark> 1 <mark>&gt;</mark> 2\", highlight(\"> 1 > 2\", \"&gt;\")","+    assert_equal \"<mark>&gt;</mark> 1 <mark>&gt;</mark> 2\", highlight(\"> 1 > 2\", \">\", sanitize: false)","+    assert_equal \"<p>1 <mark>&gt;</mark> 2</p>\", highlight(\"<p>1 > 2</p>\", \">\", sanitize: false)","+  end","+","+  def test_highlight_preserves_regexp_boundaries_after_a_tag","+    assert_equal \"<p>rails</p>\", highlight(\"<p>rails</p>\", /\\Arails/)","+    assert_equal \"<p><mark>rails</mark></p>\", highlight(\"<p>rails</p>\", /(?<=>)rails/)","+  end","+","   def test_highlight_does_not_modify_the_options_hash","     options = { highlighter: '<b>\\1</b>', sanitize: false }","     passed_options = options.dup",""],"additions":60,"deletions":0,"truncated":false}],"additions":99,"deletions":7,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-13T17:02:33.081045+00:00"}