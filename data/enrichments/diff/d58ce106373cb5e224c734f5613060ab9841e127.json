d = false;","+\tbool nullable;","+\tswitch (matcher.Type()) {","+\tcase MatcherType::LIST:","+\t\t// the first non-nullable element ends the FIRST set of a sequence","+\t\tnullable = true;","+\t\tfor (auto &child : matcher.Cast<ListMatcher>().matchers) {","+\t\t\tauto &child_first = child.get().first_set;","+\t\t\tchanged |= first.Merge(child_first);","+\t\t\tif (!child_first.nullable) {","+\t\t\t\tnullable = false;","+\t\t\t\tbreak;","+\t\t\t}","+\t\t}","+\t\tbreak;","+\tcase MatcherType::CHOICE:","+\t\tnullable = false;","+\t\tfor (auto &child : matcher.Cast<ChoiceMatcher>().matchers) {","+\t\t\tauto &child_first = child.get().first_set;","+\t\t\tchanged |= first.Merge(child_first);","+\t\t\tnullable = nullable || child_first.nullable;","+\t\t}","+\t\tbreak;","+\tcase MatcherType::OPTIONAL:","+\t\tchanged |= first.Merge(matcher.Cast<OptionalMatcher>().GetChildMatcher().first_set);","+\t\tnullable = true;","+\t\tbreak;","+\tcase MatcherType::REPEAT: {","+\t\tauto &child_first = matcher.Cast<RepeatMatcher>().GetChildMatcher().first_set;","+\t\tchanged |= first.Merge(child_first);","+\t\tnullable = child_first.nullable;","+\t\tbreak;","+\t}","+\tdefault:","+\t\tthrow InternalException(\"UpdateFirstSet called on a matcher that is not composite\");","+\t}","+\tif (nullable && !first.nullable) {","+\t\tfirst.nullable = true;","+\t\tchanged = true;","+\t}","+\treturn changed;","+}","+","+struct FirstSetTraversalEntry {","+\texplicit FirstSetTraversalEntry(Matcher &matcher) : matcher(matcher) {","+\t}","+","+\treference<Matcher> matcher;","+\tbool expanded = false;","+};","+","+void ComputeFirstSets(Matcher &root, const GrammarLiteralTable &table) {","+\t// collect the reachable matchers, children before their parents (except for recursive references)","+\tvector<reference<Matcher>> matchers;","+\tvector<reference<Matcher>> composites;","+\treference_set_t<Matcher> seen;","+\tvector<FirstSetTraversalEntry> pending;","+\tpending.emplace_back(root);","+\tseen.insert(root);"