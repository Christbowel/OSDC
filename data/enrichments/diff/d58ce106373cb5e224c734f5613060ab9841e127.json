pe::IDENTIFIER);"," \tTokenIterator edited(tokens);"," \tREQUIRE(edited.CurrentLiteralInfo(*second).LiteralId() == 0);"," \tbranch.Advance();","@@ -994,6 +997,238 @@ TEST_CASE(\"Matcher driver preserves overrides on derived built-in matchers\", \"[a"," \tREQUIRE(lifetime.destroyed.size() == lifetime.depth);"," }"," ","+class DerivedChoiceTestMatcher final : public ChoiceMatcher {","+public:","+\tDerivedChoiceTestMatcher() : child(\"ANSWER\", KeywordInfo()) {","+\t}","+","+\tarena_ptr<MatchProcess> StartMatch(MatchState &state) const override {","+\t\treturn state.Make<GrammarExtensionTestMatchProcess>(child, state);","+\t}","+","+private:","+\tKeywordMatcher child;","+};","+","+TEST_CASE(\"FIRST sets do not assume built-in semantics for derived matchers\", \"[api][grammar_extension]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto grammar = CompiledGrammar::Get(*con.context);","+\tDerivedChoiceTestMatcher derived;","+\tListMatcher list;","+\tlist.SetStructural();","+\tlist.matchers.push_back(derived);","+\tComputeFirstSets(list, grammar->GetKeywordHelper().GetLiteralTable());","+","+\tvector<MatcherToken> tokens {MatcherToken(\"answer\", 0, TokenType::IDENTIFIER)};","+\tTokenIterator iterator(tokens);","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator allocator;","+\tidx_t max_token_index = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, allocator, process_allocator, max_token_index);","+\tMatchState state(iterator, context);","+\tREQUIRE(list.MatchParseResult(state).IsSuccess());","+}","+","+static vector<MatcherToken> TokenizeFirstSetTestInput(const CompiledGrammar &grammar, const string &sql) {","+\tvector<MatcherToken> tokens;","+\tParserTokenizerBehavior behavior(sql, tokens);","+\tgrammar.GetTokenizer().TokenizeInput(behavior);","+\treturn tokens;","+}","+","+TEST_CASE(\"Tokenizer assigns FIRST set token classes\", \"[api][grammar_extension]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto grammar = CompiledGrammar::Get(*con.context);","+\tauto token_class = [&](const string &sql) {","+\t\tauto tokens = TokenizeFirstSetTestInput(*grammar, sql);","+\t\tREQUIRE(tokens.size() == 2);","+\t\treturn tokens[0].token_class;","+\t};","+\tconst uint8_t generic_operator = MatcherTokenClass::OPERATOR | MatcherTokenClass::GENERIC_OPERATOR;","+\tconst uint8_t string_literal = MatcherTokenClass::STRING | MatcherTokenClass::WORD;","+","+\tREQUIRE(token_class(\"select\") == MatcherTokenClass::WORD);","+\tREQUIRE(token_class(\"some_column\") == MatcherTokenClass::WORD);","+\tREQUIRE(token_class(\"\\\"quoted name\\\"\") == MatcherTokenClass::WORD);","+\t// string literals are accepted in identifier positions","+\tREQUIRE(token_class(\"'str'\") == string_literal);","+\tREQUIRE(token_class(\"E'str'\") == string_literal);","+\tREQUIRE(token_class(\"$$str$$\") == string_literal);","+\tREQUIRE(token_class(\"42\") == MatcherTokenClass::NUMBER);","+\tREQUIRE(token_class(\".5\") == MatcherTokenClass::NUMBER);","+\tREQUIRE(token_class(\"1e10\") == MatcherTokenClass::NUMBER);","+\tREQUIRE(token_class(\"+\") == generic_operator);","+\tREQUIRE(token_class(\"||\") == generic_operator);","+\tREQUIRE(token_class(\"(\") == generic_operator);","+\t// operators with their own precedence level are not generic operators","+\tREQUIRE(token_class(\"<=\") == MatcherTokenClass::OPERATOR);","+\tREQUIRE(token_class(\"=\") == MatcherTokenClass::OPERATOR);","+\t// terminators and the end of input are only matched as literals","+\tauto tokens = TokenizeFirstSetTestInput(*grammar, \";\");","+\tREQUIRE(tokens.size() == 2);","+\tREQUIRE(tokens[0].type == TokenType::TERMINATOR);","+\tREQUIRE(tokens[0].token_class == 0);","+\tREQUIRE(tokens[1].type == TokenType::END_OF_INPUT);","+\tREQUIRE(tokens[1].token_class == 0);","+\t// re-typing a matched token does not change its class","+\ttokens = TokenizeFirstSetTestInput(*grammar, \"'path'\");","+\tTokenIterator iterator(tokens);","+\titerator.Advance();","+\titerator.SetPreviousTokenType(TokenType::TABLE_NAME);","+\tREQUIRE(tokens[0].token_class == string_literal);","+}","+","+//! Checks MightMatch against the expectation, and that a rejected matcher indeed fails to match","+static void CheckFirstSet(const CompiledGrammar &grammar, const Matcher &matcher, const string &sql, bool expected) {","+\tINFO(\"Matcher \" << matcher.ToString() << \" on input \\\"\" << sql << \"\\\"\");","+\tauto tokens = TokenizeFirstSetTestInput(grammar, sql);","+\tTokenIterator iterator(tokens);","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator allocator;","+\tidx_t max_token_index = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, allocator, process_allocator, max_token_index);","+\tMatchState state(iterator, context);","+\tauto might_match = matcher.first_set.MightMatch(state);","+\tREQUIRE(might_match == expected);","+\tif (!might_match) {","+\t\tREQUIRE_FALSE(matcher.MatchParseResult(state).IsSuccess());","+\t}","+}","+","+TEST_CASE(\"FIRST sets only reject tokens a matcher cannot start with\", \"[api][grammar_extension]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto grammar = CompiledGrammar::Get(*con.context);","+\tauto &helper = grammar->GetKeywordHelper();","+","+\t// keyword matchers created by the factory are matched by literal id","+\tauto keyword_grammar = ParsedGrammar::Parse(\"Program <- 'SELECT'\");","+\tauto keyword_rules = CompileTestProgramRule(keyword_grammar);","+\tMatcherAllocator matcher_allocator;","+\tMatcherFactory factory(matcher_allocator, keyword_grammar, keyword_rules, helper, {});","+\tauto &select = factory.CreateRootMatcher(\"Program\").Cast<ListMatcher>().matchers[0].get();","+\tREQUIRE(select.Type() == MatcherType::KEYWORD);","+\t// other keyword matchers can have their own semantics","+\tKeywordMatcher custom_keyword(\"SELECT\", KeywordInfo(), helper);","+\tIdentifierMatcher identifier(SuggestionState::SUGGEST_COLUMN_NAME, helper);","+\tNumberLiteralMatcher number;","+\tStringLiteralMatcher string_literal;","+\tOperatorMatcher generic_operator;","+\tOperatorMatcher any_operator(OperatorMatcherMode::ALL_OPERATORS);","+\tArithmeticOperatorMatcher arithmetic_operator;","+\tGrammarExtensionTestMatcher custom;","+","+\t// SELECT / NUMBER","+\tChoiceMatcher choice({select, number});","+\t// NUMBER? IDENTIFIER","+\tOptionalMatcher optional_number(number);","+\tListMatcher optional_prefix({optional_number, identifier});","+\t// NUMBER?","+\tListMatcher nullable_list({optional_number});","+\t// STRING*","+\tRepeatMatcher repeat(string_literal);","+\t// (SELECT / NUMBER) IDENTIFIER: the identifier is not part of the FIRST set","+\tListMatcher sequence({choice, identifier});","+\t// custom matchers provide no information","+\tListMatcher custom_list({custom, number});","+\t// a list that is not known to run the built-in list semantics","+\tListMatcher unmarked_list({number});","+\tListMatcher uncomputed_list({number});","+","+\tChoiceMatcher root({choice, optional_prefix, nullable_list, repeat, sequence, custom_list, unmarked_list,","+\t                    identifier, string_literal, generic_operator, any_operator, arithmetic_operator,","+\t                    custom_keyword});","+\tfor (auto matcher : vector<reference<Matcher>> {choice, optional_number, optional_prefix, nullable_list, repeat,","+\t                                                sequence, custom_list, root}) {","+\t\tmatcher.get().SetStructural();","+\t}","+\tComputeFirstSets(root, helper.GetLiteralTable());","+","+\tSECTION(\"Atomic matchers\") {","+\t\tCheckFirstSet(*grammar, identifier, \"some_column\", true);","+\t\tCheckFirstSet(*grammar, identifier, \"\\\"quoted name\\\"\", true);","+\t\tCheckFirstSet(*grammar, identifier, \"'path'\", true);","+\t\tCheckFirstSet(*grammar, identifier, \"42\", false);","+\t\tCheckFirstSet(*grammar, identifier, \"+\", false);","+\t\tCheckFirstSet(*grammar, identifier, \";\", false);","+\t\tCheckFirstSet(*grammar, identifier, \"\", false);","+","+\t\tCheckFirstSet(*grammar, string_literal, \"'str'\", true);","+\t\tCheckFirstSet(*grammar, string_literal, \"E'str'\", true);","+\t\tCheckFirstSet(*grammar, string_literal, \"$$str$$\", true);","+\t\tCheckFirstSet(*grammar, string_literal, \"some_column\", false);","+\t\tCheckFirstSet(*grammar, string_literal, \"42\", false);","+","+\t\tCheckFirstSet(*grammar, generic_operator, \"+\", true);","+\t\tCheckFirstSet(*grammar, generic_operator, \"<=\", false);","+\t\tCheckFirstSet(*grammar, generic_operator, \"some_column\", false);"],"additions":173,"deletions":1,"truncated":false}],"additions":524,"deletions":10,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-10-08T16:20:55.466055+00:00"}