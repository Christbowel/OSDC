rt { getBundleInstallDefaultLocation as getCloudClientLocation } from '../../nx-cloud/update-manager';","+import {","+  getBundleInstallDefaultLocation as getCloudClientLocation,","+  NxCloudClientUnavailableError,","+} from '../../nx-cloud/update-manager';"," import { removeStaleTempInstallDirectories } from '../../utils/package-manager';"," "," // Wait at max 5 seconds before giving up on a failing operation.","@@ -153,8 +156,26 @@ function cleanupDaemonWorkspaceData() {"," async function resetCloudClient() {","   // Remove nx cloud marker files. This helps if the use happens to run `nx-cloud start-ci-run` or","   // similar commands on their local machine.","+  let client: Awaited<ReturnType<typeof getCloudClient>>;","+  try {","+    client = await getCloudClient(getCloudOptions());","+  } catch (e) {","+    // Nothing to invoke, and removeInstalledNxCloudClient deletes the install","+    // next, so reset has still done its job.","+    if (e instanceof NxCloudClientUnavailableError) {","+      return;","+    }","+    throw e;","+  }","+","+  // Bundles older than the command export no `cleanup`, and invoking it would","+  // throw UnknownCommandError.","+  if (!client.availableCommands.includes('cleanup')) {","+    return;","+  }","+","   // `exit` would end the process here, before reset reports its result.","-  await (await getCloudClient(getCloudOptions())).invoke('cleanup', false);","+  await client.invoke('cleanup', false);"," }"," "," function removeInstalledNxCloudClient() {"],"additions":23,"deletions":2,"truncated":false},{"path":"packages/nx/src/nx-cloud/update-manager.spec.ts","lines":["@@ -902,3 +902,217 @@ describe('update-manager download lock', () => {","     expect(Date.now() - start).toBeGreaterThanOrEqual(400);","   });"," });","+","+describe('update-manager client loading', () => {","+  const VERSION = '2611.09.0031';","+  // A loadable bundle needs `commands`, which the outdated-image check looks","+  // for. `marker` is how a test tells which bundle ran.","+  const clientSource = (marker: string) =>","+    `module.exports = { commands: {}, marker: '${marker}' };`;","+","+  let workspace: string;","+  let installDir: string;","+  let stateDir: string;","+  let updateManager: UpdateManager;","+  let apiClient: HttpClient;","+  let consoleError: ReturnType<typeof vi.spyOn>;","+","+  /**","+   * A stand-in cloud api. `verify` is handed the query params the code sent,","+   * so a response can depend on whether a bundle was reported at all. Either","+   * hook returns an Error to fail that request.","+   */","+  function cloudApi(options: {","+    verify: (params: Record<string, unknown>) => unknown;","+    bundle?: () => Readable | Error;","+  }): HttpClient {","+    return {","+      get: vi.fn(async (path: string, config?: any) => {","+        if (path === '/nx-cloud/client/verify') {","+          const data = options.verify(config?.params ?? {});","+          if (data instanceof Error) throw data;","+          return { data };","+        }","+        const bundle = options.bundle","+          ? options.bundle()","+          : bundleTarball({ 'index.js': clientSource('downloaded') });","+        if (bundle instanceof Error) throw bundle;","+        return { data: bundle };","+      }),","+    } as unknown as HttpClient;","+  }","+","+  const servesFreshBundle = {","+    verify: () => ({ valid: false, url: '/bundle.tar.gz', version: VERSION }),","+  };","+","+  /** A bundle directory at the bare version, as an older nx named them. */","+  function seedBundle(files: Record<string, string>): string {","+    const dir = join(installDir, VERSION);","+    mkdirSync(dir, { recursive: true });","+    for (const [name, content] of Object.entries(files)) {","+      writeFileSync(join(dir, name), content);","+    }","+    return dir;","+  }","+","+  /** The lock an earlier nx command in the same job leaves behind. */","+  function skipVerification(): void {","+    writeFileSync(join(stateDir, 'verify.lock'), Date.now().toString());","+  }","+","+  const marker = (result: { nxCloudClient: unknown }) =>","+    (result.nxCloudClient as { marker: string }).marker;","+","+  beforeAll(() => {","+    originalCacheDirEnv = process.env[CACHE_DIR_ENV];","+  });","+","+  beforeEach(async () => {","+    workspace = mkdtempSync(join(tmpdir(), 'nx-update-manager-load-'));","+    writeFileSync(join(workspace, 'nx.json'), '{}');","+","+    // Before resetModules: the module graph reads this at import time.","+    pinCacheDirTo(workspace);","+","+    vi.resetModules();","+    vi.doMock('./utilities/nx-cloud-http-client', () => ({","+      createApiHttpClient: () => apiClient,","+    }));","+    const { setWorkspaceRoot } = await import('../utils/workspace-root');","+    setWorkspaceRoot(workspace);","+    const { resetSharedRootCacheForTesting, workspaceDataDirectory } =","+      await import('../utils/cache-directory');","+    resetSharedRootCacheForTesting();","+","+    updateManager = await import('./update-manager');","+    installDir = updateManager.getBundleInstallDefaultLocation();","+    assertContainedInFixture(installDir, workspace);","+    stateDir = join(workspaceDataDirectory, 'nx-cloud');","+    assertContainedInFixture(stateDir, workspace);","+    mkdirSync(installDir, { recursive: true });","+    mkdirSync(stateDir, { recursive: true });","+","+    consoleError = vi.spyOn(console, 'error').mockImplementation(() => {});","+  });","+","+  afterEach(() => {","+    consoleError?.mockRestore();","+    vi.doUnmock('./utilities/nx-cloud-http-client');","+    vi.resetModules();","+    removeFixtureDir(workspace, workspace);","+    removeFixtureDir(installDir, workspace);","+  });","+","+  afterAll(restoreCacheDirEnv);","+","+  it.each([","+    ['nothing in it', {}],","+    ['no entry point', { 'stray.js': 'module.exports = 1;' }],","+    ['an entry point missing a chunk', { 'index.js': \"require('./chunk');\" }],","+    ['a truncated entry point', { 'index.js': 'module.exports = {' }],","+  ])(","+    'replaces a bundle with %s rather than failing the command',","+    async (_shape, files) => {","+      // The reported failure. A verification skipped for 30 minutes never asks","+      // the server about the bundle, so nothing else replaces a damaged one.","+      const damaged = seedBundle(files);","+      skipVerification();","+      apiClient = cloudApi(servesFreshBundle);","+","+      const result = await updateManager.verifyOrUpdateNxCloudClient({});","+","+      expect(result.version).toBe(VERSION);","+      expect(marker(result)).toBe('downloaded');","+      expect(existsSync(damaged)).toBe(false);","+    }","+  );","+","+  it('loads the installed bundle without asking the server when verification is skipped', async () => {","+    seedBundle({ 'index.js': clientSource('installed') });","+    skipVerification();","+    apiClient = cloudApi({","+      verify: () => new Error('the server must not be asked'),","+    });","+","+    const result = await updateManager.verifyOrUpdateNxCloudClient({});","+","+    expect(marker(result)).toBe('installed');","+    expect(apiClient.get).not.toHaveBeenCalled();","+  });","+","+  it('replaces a bundle the server calls valid but which does not load', async () => {","+    const damaged = seedBundle({});","+    apiClient = cloudApi({","+      // Valid while a bundle is reported, and the fresh one once the retry","+      // reports none - which is what a server answers with no hash to check.","+      verify: (params) =>","+        params.version","+          ? { valid: true, url: null, version: null }","+          : servesFreshBundle.verify(),","+    });","+","+    const result = await updateManager.verifyOrUpdateNxCloudClient({});","+","+    expect(marker(result)).toBe('downloaded');","+    expect(existsSync(damaged)).toBe(false);","+  });","+","+  it('leaves no verification lock behind when the bundle it approved did not load', async () => {","+    // A lock here would park the damaged bundle behind the 30 minute skip, so","+    // the next command would fail the way this one just did.","+    seedBundle({});","+    apiClient = cloudApi({","+      verify: (params) =>","+        params.version","+          ? { valid: true, url: null, version: null }","+          : servesFreshBundle.verify(),","+      bundle: () => new Error('connection reset'),","+    });","+","+    await expect(updateManager.verifyOrUpdateNxCloudClient({})).rejects.toThrow(","+      'connection reset'","+    );","+","+    expect(existsSync(join(stateDir, 'verify.lock'))).toBe(false);","+  });","+","+  it('downloads once and reports the failure when the fresh bundle does not load either', async () => {","+    seedBundle({});","+    skipVerification();","+    apiClient = cloudApi({","+      ...servesFreshBundle,","+      bundle: () => bundleTarball({ 'stray.js': 'module.exports = 1;' }),","+    });","+","+    // The error names the directory just downloaded into, not the seeded one,","+    // and one verify plus one download is the whole of it, because a server","+    // that keeps serving an unloadable bundle must not be asked in a loop.","+    await expect(updateManager.verifyOrUpdateNxCloudClient({})).rejects.toThrow(","+      new RegExp(`${VERSION}-[0-9a-f-]{36}`)","+    );","+    expect(apiClient.get).toHaveBeenCalledTimes(2);","+  });","+","+  it('reports the client unavailable when the server is unreachable and the bundle does not load', async () => {","+    seedBundle({});","+    skipVerification();","+    apiClient = cloudApi({ verify: () => new Error('ECONNREFUSED') });","+","+    // Nothing to run and nowhere to download from, which callers already treat","+    // as \"carry on without Nx Cloud\". One attempt at the unreachable server.","+    await expect(updateManager.verifyOrUpdateNxCloudClient({})).rejects.toThrow(","+      updateManager.NxCloudClientUnavailableError","+    );","+    expect(apiClient.get).toHaveBeenCalledTimes(1);","+  });","+","+  it('falls back to a loadable installed bundle when the server is unreachable', async () => {","+    seedBundle({ 'index.js': clientSource('installed') });","+    apiClient = cloudApi({ verify: () => new Error('ECONNREFUSED') });","+","+    const result = await updateManager.verifyOrUpdateNxCloudClient({});","+","+    expect(marker(result)).toBe('installed');","+  });","+});"],"additions":214,"deletions":0,"truncated":false},{"path":"packages/nx/src/nx-cloud/update-manager.ts","lines":["@@ -74,6 +74,14 @@ export class NxCloudClientUnavailableError extends Error {","   }"," }"," ","+// Raised where an unloadable install can still be replaced by a download, and","+// caught only in verifyOrUpdateNxCloudClient. Never escapes this module.","+class UnloadableClientBundleError extends Error {","+  constructor(fullPath: string) {","+    super(`Installed Nx Cloud client bundle could not be loaded: ${fullPath}`);","+  }","+}","+"," export interface NxCloudClient {","   configureLightClientRequire: () => (paths: string[]) => void;","   commands: Record<string, () => Promise<void>>;","@@ -99,7 +107,31 @@ export async function verifyOrUpdateNxCloudClient(options?: {","   customProxyConfigPath?: string;"," }): Promise<{ nxCloudClient: NxCloudClient; version: string } | null> {","   debugLog('Verifying current cloud bundle');","-  const currentBundle = getLatestInstalledRunnerBundle();","+","+  try {","+    return await loadOrUpdateNxCloudClient(","+      getLatestInstalledRunnerBundle(),","+      options","+    );","+  } catch (e) {","+    if (!(e instanceof UnloadableClientBundleError)) {","+      throw e;","+    }","+    // Nothing can repair the directory on disk, so this attempt runs as if","+    // nothing were installed and downloads a fresh bundle. Passing null keeps","+    // it off both paths that raise this error, so it cannot land back here.","+    debugLog(e.message, ' - downloading a fresh bundle');","+    return await loadOrUpdateNxCloudClient(null, options);","+  }","+}","+","+async function loadOrUpdateNxCloudClient(","+  currentBundle: CloudBundleInstall | null,","+  options?: {","+    url?: string;","+    customProxyConfigPath?: string;","+  }","+): Promise<{ nxCloudClient: NxCloudClient; version: string }> {","   const apiUrl =","     process.env.NX_CLOUD_API || options?.url || 'https://cloud.nx.app';"," ","@@ -132,7 +164,12 @@ export async function verifyOrUpdateNxCloudClient(options?: {","         throw new NxCloudEnterpriseOutdatedError(apiUrl);","       }"," ","-      const nxCloudClient = require(currentBundle.fullPath);","+      const nxCloudClient = loadInstalledBundle(currentBundle);","+      if (nxCloudClient === null) {","+        // The server is unreachable and the installed copy does not load, so","+        // there is neither a client to run nor a url to download one from.","+        throw new NxCloudClientUnavailableError();","+      }","       if (nxCloudClient.commands === undefined) {","         throw new NxCloudEnterpriseOutdatedError(apiUrl);","       }","@@ -145,10 +182,21 @@ export async function verifyOrUpdateNxCloudClient(options?: {"," ","     if (verifyBundleResponse.data.valid) {","       debugLog('Currently installed bundle is valid');","+      if (currentBundle === null) {","+        // Valid with nothing installed leaves nothing to load.","+        throw new NxCloudClientUnavailableError();","+      }","+      const nxCloudClient = loadInstalledBundle(currentBundle);","+      if (nxCloudClient === null) {","+        throw new UnloadableClientBundleError(currentBundle.fullPath);","+      }","+      // Written after the load, so the lock always stands for a bundle that","+      // ran. Writing it first would park a damaged one behind the 30 minute","+      // verification skip.","       writeBundleVerificationLock();","       return {","         version: currentBundle.version,","-        nxCloudClient: require(currentBundle.fullPath),","+        nxCloudClient,","       };","     }"," ","@@ -172,7 +220,9 @@ export async function verifyOrUpdateNxCloudClient(options?: {"," ","     debugLog('Done: ', installedBundle.fullPath);"," ","-    const nxCloudClient = require(installedBundle.fullPath);","+    // Deliberately unguarded. Another download would fetch the same bundle, so","+    // a failure loading a fresh extract is reported rather than retried.","+    const nxCloudClient: NxCloudClient = require(installedBundle.fullPath);"," ","     if (nxCloudClient.commands === undefined) {","       throw new NxCloudEnterpriseOutdatedError(apiUrl);","@@ -184,14 +234,37 @@ export async function verifyOrUpdateNxCloudClient(options?: {","     throw new NxCloudClientUnavailableError();","   }"," ","+  const nxCloudClient = loadInstalledBundle(currentBundle);","+  if (nxCloudClient === null) {","+    // This path never asks the server about the bundle, so a damaged one is","+    // never replaced on its own.","+    throw new UnloadableClientBundleError(currentBundle.fullPath);","+  }","+","   debugLog('Done: ', currentBundle.fullPath);"," ","   return {","     version: currentBundle.version,","-    nxCloudClient: require(currentBundle.fullPath),","+    nxCloudClient,","   };"," }"," ","+/**","+ * The installed bundle's exports, or null when the directory does not load.","+ * Any failure counts, not just MODULE_NOT_FOUND, since a truncated file is a","+ * SyntaxError. Being that broad costs nothing, because the retry's own","+ * `require` is unguarded and a failure that was never the disk's fault still","+ * surfaces from there.","+ */","+function loadInstalledBundle(bundle: CloudBundleInstall): NxCloudClient | null {","+  try {","+    return require(bundle.fullPath);","+  } catch (e) {","+    debugLog('Could not load installed cloud bundle: ', bundle.fullPath, e);","+    return null;","+  }","+}","+"," /**","  * Null outside a workspace when there is no home directory apart from the","  * shared temp dir, since the bundle would then be `require`d from, and resolve",""],"additions":78,"deletions":5,"truncated":fa