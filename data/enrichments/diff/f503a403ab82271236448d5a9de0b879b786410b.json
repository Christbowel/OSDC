{"id":"f503a403ab82271236448d5a9de0b879b786410b","axis":"silent","repo":"PyCQA/pylint","sha":"f503a403ab82271236448d5a9de0b879b786410b","parsed":{"files":[{"path":"tests/functional/d/deprecated/deprecated_class_sys_guard_py312.py","lines":["@@ -0,0 +1,14 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/10043.","+","+``importlib.abc.TraversableResources`` is deprecated since Python 3.12. An","+import of it that only runs on older versions, behind a version guard, is","+not a use of a deprecated class.","+\"\"\"","+# pylint: disable=unused-import","+","+import sys","+","+if sys.version_info >= (3, 12):","+    from importlib.resources.abc import TraversableResources","+else:","+    from importlib.abc import TraversableResources"],"additions":14,"deletions":0,"truncated":false},{"path":"tests/functional/d/deprecated/deprecated_class_sys_guard_py312.rc","lines":["@@ -0,0 +1,2 @@","+[testoptions]","+min_pyver=3.12"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/functional/ext/docparams/parameter/missing_param_doc_numpy_grouped.py","lines":["@@ -0,0 +1,58 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/3420.","+","+Numpy style docstrings can document several parameters on one line,","+``x, y, z : int``. Those count as documented, also when other parameters","+follow on their own line.","+\"\"\"","+","+","+def grouped_only(valx, valy, valz):","+    \"\"\"Add three numbers.","+","+    Parameters","+    ----------","+    valx, valy, valz : int","+        The numbers to add.","+","+    Returns","+    -------","+    int","+        The sum.","+    \"\"\"","+    return valx + valy + valz","+","+","+def grouped_then_single(valx, valy, valz, factor):","+    \"\"\"Add three numbers, then multiply the sum.","+","+    Parameters","+    ----------","+    valx, valy, valz : int","+        The numbers to add.","+    factor : int","+        What to multiply the sum by.","+","+    Returns","+    -------","+    int","+        The sum times the factor.","+    \"\"\"","+    return (valx + valy + valz) * factor","+","+","+def grouped_with_missing(valx, valy, valz, factor):  # [missing-param-doc, missing-type-doc]","+    \"\"\"Add three numbers, then multiply the sum.","+","+    Parameters","+    ----------","+    valx, valy : int","+        Two of the numbers to add.","+    factor : int","+        What to multiply the sum by.","+","+    Returns","+    -------","+    int","+        The sum times the factor.","+    \"\"\"","+    return (valx + valy + valz) * factor"],"additions":58,"deletions":0,"truncated":false},{"path":"tests/functional/ext/docparams/parameter/missing_param_doc_numpy_grouped.rc","lines":["@@ -0,0 +1,7 @@","+[MAIN]","+load-plugins = pylint.extensions.docparams","+","+[BASIC]","+accept-no-param-doc=no","+docstring-min-length: -1","+no-docstring-rgx=^$"],"additions":7,"deletions":0,"truncated":false},{"path":"tests/functional/ext/docparams/parameter/missing_param_doc_numpy_grouped.txt","lines":["@@ -0,0 +1,2 @@","+missing-param-doc:43:0:43:24:grouped_with_missing:\"\"\"valz\"\" missing in parameter documentation\":HIGH","+missing-type-doc:43:0:43:24:grouped_with_missing:\"\"\"valz\"\" missing in parameter type documentation\":HIGH"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/functional/n/no/no_member_generic_class_getitem.py","lines":["@@ -0,0 +1,39 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/7379.","+","+A generic class that overrides ``__class_getitem__`` with a ``super()`` call","+still gives its members to the classes that subclass ``Base[int]``.","+\"\"\"","+","+# pylint: disable=too-few-public-methods","+","+from typing import Generic, TypeVar","+","+T = TypeVar(\"T\")","+","+","+class Base(Generic[T]):","+    \"\"\"Overrides ``__class_getitem__`` and calls the parent's.\"\"\"","+","+    name = \"base\"","+","+    def __class_getitem__(cls, item):","+        return super().__class_getitem__(item)","+","+","+class Child(Base[int]):","+    \"\"\"Inherits ``name``.\"\"\"","+","+    def get_name(self):","+        \"\"\"Read the inherited attribute.\"\"\"","+        return self.name","+","+","+class GenericChild(Base[T]):","+    \"\"\"Inherits ``name`` and stays generic.\"\"\"","+","+    def get_name(self):","+        \"\"\"Read the inherited attribute.\"\"\"","+        return self.name","+","+","+print(Child.name, Child().get_name(), GenericChild.name, GenericChild().get_name())"],"additions":39,"deletions":0,"truncated":false},{"path":"tests/functional/n/no/no_member_super_classmethod_instance.py","lines":["@@ -0,0 +1,39 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/981.","+","+A classmethod that calls the parent classmethod through ``super()`` gets an","+instance of ``cls``, the subclass, not of the parent class. Its members are","+those of the subclass.","+\"\"\"","+","+# pylint: disable=too-few-public-methods","+","+","+class Parent:","+    \"\"\"Builds an instance of whatever class it is called on.\"\"\"","+","+    @classmethod","+    def build(cls):","+        \"\"\"Return a new instance of ``cls``.\"\"\"","+        return cls()","+","+    def parent_method(self):","+        \"\"\"Defined on the parent.\"\"\"","+        print(self)","+","+","+class Child(Parent):","+    \"\"\"Calls the parent's classmethod with ``super()``.\"\"\"","+","+    @classmethod","+    def build(cls):","+        \"\"\"Return a new instance of ``cls``, built by the parent.\"\"\"","+        instance = super(Child, cls).build()","+        instance.parent_method()","+        instance.child_method()","+        other = super().build()","+        other.child_method()","+        return instance","+","+    def child_method(self):","+        \"\"\"Defined on the child only.\"\"\"","+        print(self)"],"additions":39,"deletions":0,"truncated":false},{"path":"tests/functional/n/no/no_member_super_returns_self.py","lines":["@@ -0,0 +1,29 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/7991.","+","+A parent method that returns ``self``, called with ``super()`` from a","+subclass, returns the subclass instance with all its members.","+\"\"\"","+","+# pylint: disable=too-few-public-methods,useless-parent-delegation","+","+","+class Parent:","+    \"\"\"Returns itself.\"\"\"","+","+    def save(self):","+        \"\"\"Return the instance.\"\"\"","+        return self","+","+","+class Child(Parent):","+    \"\"\"Adds an attribute and calls the parent's ``save``.\"\"\"","+","+    def __init__(self):","+        self.value = 12","+","+    def save(self):","+        \"\"\"Return what the parent returns: this instance.\"\"\"","+        return super().save()","+","+","+print(Child().save().value)"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/functional/n/no/no_value_for_parameter_enum_custom_new.py","lines":["@@ -0,0 +1,28 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/1801.","+","+An enum with a custom ``__new__`` taking several values is looked up by its","+value alone: ``Planet(1)`` passes one argument, not the arguments of","+``__new__``.","+\"\"\"","+","+from enum import Enum","+","+","+class EnumWithDoc(Enum):","+    \"\"\"Each member carries a value and a doc string.\"\"\"","+","+    def __new__(cls, value, doc):","+        obj = object.__new__(cls)","+        obj._value_ = value","+        obj.doc = doc","+        return obj","+","+","+class Planet(EnumWithDoc):","+    \"\"\"Two members, built with a value and a doc each.\"\"\"","+","+    MERCURY = (1, \"The first planet\")","+    VENUS = (2, \"The second planet\")","+","+","+print(Planet(1).doc)"],"additions":28,"deletions":0,"truncated":false},{"path":"tests/functional/r/regression_03/regression_8739_property_fset.py","lines":["@@ -0,0 +1,21 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/8739.","+","+Reading ``fset`` of a property that has no setter crashed with an uncaught","+``InferenceError``.","+\"\"\"","+","+# pylint: disable=too-few-public-methods,pointless-statement","+","+","+class Config:","+    \"\"\"A read-only property.\"\"\"","+","+    @property","+    def size(self):","+        \"\"\"No setter.\"\"\"","+        return 1","+","+","+Config.size.fset","+Config.size.fget","+Config.size.fdel"],"additions":21,"deletions":0,"truncated":false},{"path":"tests/functional/u/undefined/undefined_variable_walrus_in_decorator.py","lines":["@@ -0,0 +1,29 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/5735.","+","+A name bound by ``:=`` in the condition of a comprehension, inside a decorator","+call, is defined for the rest of that comprehension.","+\"\"\"","+","+# pylint: disable=missing-function-docstring","+","+DATA = [\"abcdef\", \"qwerty\"]","+","+","+def preprocess(text):","+    return text + \"xyz\"","+","+","+def decorator(arg):","+    print(arg)","+    return lambda function: function","+","+","+@decorator(","+    [","+        found.upper()","+        for string in DATA","+        if (found := preprocess(string)).startswith(\"abc\") and \"bcd\" in found","+    ],","+)","+def decorated():","+    pass"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/functional/u/used/used_before_assignment_method_named_like_builtin.py","lines":["@@ -0,0 +1,22 @@","+\"\"\"Regression test for https://github.com/pylint-dev/pylint/issues/9115.","+","+Class annotations that name a builtin, ``str`` or ``dict``, are not uses of a","+method of the same name defined later in the class body.","+\"\"\"","+","+# pylint: disable=too-few-public-methods","+","+","+class Message:","+    \"\"\"Attributes annotated with builtins, and methods named after them.\"\"\"","+","+    message_type: str","+    payload: dict | str","+","+    def dict(self):","+        \"\"\"Return the message as a dictionary.\"\"\"","+        return {\"message_type\": self.message_type, \"payload\": self.payload}","+","+    def str(self):","+        \"\"\"Return the message as text.\"\"\"","+        return repr(self.dict())",""],"additions":22,"deletions":0,"truncated":false}],"additions":290,"deletions":0,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-19T17:58:44.751251+00:00"}