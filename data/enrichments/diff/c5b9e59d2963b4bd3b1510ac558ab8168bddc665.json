 \"run\", \"build\", \"--hoist-pattern=eslint\"]));"," }"," ","+#[test]","+fn camel_case_dotted_settings_validate_values_like_kebab_case() {","+    for flag in [","+        \"--config.trustPolicy=typo\",","+        \"--config.shamefullyHoist=yes\",","+        \"--config.childConcurrency=lots\",","+        \"--config.linkWorkspacePackages=shallow\",","+    ] {","+        let (overrides, remaining) = ConfigOverrides::extract(argv([\"pacquet\", \"install\", flag]));","+        assert_eq!(remaining, argv([\"pacquet\", \"install\", flag]), \"{flag}\");","+","+        let mut config = Config::default();","+        overrides.apply(&mut config, Path::new(\"/workspace\"));","+        assert!(config.explicit_settings.is_empty(), \"{flag}\");","+        assert_eq!(config.trust_policy, Config::default().trust_policy, \"{flag}\");","+        assert_eq!(config.shamefully_hoist, Config::default().shamefully_hoist, \"{flag}\");","+        assert_eq!(config.child_concurrency, Config::default().child_concurrency, \"{flag}\");","+        assert_eq!(","+            config.link_workspace_packages,","+            Config::default().link_workspace_packages,","+            \"{flag}\",","+        );","+    }","+","+    let (overrides, remaining) = ConfigOverrides::extract(argv([","+        \"pacquet\",","+        \"install\",","+        \"--config.trustPolicy=no-downgrade\",","+        \"--config.shamefullyHoist=true\",","+        \"--config.childConcurrency=3\",","+        \"--config.linkWorkspacePackages=deep\",","+    ]));","+    assert_eq!(remaining, argv([\"pacquet\", \"install\"]));","+","+    let mut config = Config::default();","+    overrides.apply(&mut config, Path::new(\"/workspace\"));","+    assert_eq!(config.trust_policy, super::super::TrustPolicy::NoDowngrade);","+    assert!(config.shamefully_hoist);","+    assert_eq!(config.child_concurrency, 3);","+    assert_eq!(config.link_workspace_packages, super::super::LinkWorkspacePackages::Deep);","+}","+"," /// A setting is stripped from argv before clap runs, so one spelled like"," /// a *global* option would claim that option on every command line, a"," /// command's own option is left for clap instead, and can collide."],"additions":42,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests/paths.rs","lines":["@@ -505,3 +505,33 @@ fn store_dir_override_matching_the_relocated_default_does_not_warn() {","     assert_eq!(config.store_dir.root(), relocated.join(STORE_VERSION));","     assert_eq!(config.bypassed_home_store_warning(), None);"," }","+","+#[test]","+fn camel_case_dotted_store_and_state_dir_rewrite_to_global_flags() {","+    let (overrides, remaining) = ConfigOverrides::extract(argv([","+        \"pacquet\",","+        \"--config.storeDir=dotted-store\",","+        \"--config.stateDir=/custom/state\",","+        \"install\",","+    ]));","+    assert_eq!(","+        remaining,","+        argv([\"pacquet\", \"--store-dir=dotted-store\", \"--state-dir=/custom/state\", \"install\"]),","+    );","+    assert_eq!(","+        overrides.cli_layer(None).npmrc_tokens,","+        [","+            (\"storeDir\".to_owned(), \"dotted-store\".to_owned()),","+            (\"stateDir\".to_owned(), \"/custom/state\".to_owned()),","+        ],","+    );","+","+    let (_, remaining) = ConfigOverrides::extract(argv([","+        \"pacquet\",","+        \"--config.storeDir=\",","+        \"--config.stateDir=\",","+        \"store\",","+        \"path\",","+    ]));","+    assert_eq!(remaining, argv([\"pacquet\", \"--store-dir=\", \"--state-dir=\", \"store\", \"path\"]));","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tokens.rs","lines":["@@ -8,6 +8,7 @@ use super::{","     RuntimeOnFail,","     SaveWorkspaceProtocol,","     TrustPolicy,","+    to_kebab_case,"," };"," "," /// Whether the token at `index` belongs to the forwarded child command line.","@@ -249,7 +250,7 @@ fn named_bare_setting_flag(key: &str) -> Option<(&'s