  // value types or require nullable and non-nullable types to match.","+            if function.return_type.remove_nullable() != source.column.data_type.remove_nullable() {","+                return None;","+            }","+            let input = expr.unary_child();","+            let partial = match input.plan() {","+                PhysicalRelOperator::Exchange(_) => input.unary_child(),","+                _ => input,","+            };","+            let PhysicalRelOperator::Aggregate(partial_agg) = partial.plan() else {","+                return None;","+            };","+            if partial_agg.mode != AggregateMode::Partial","+                || partial_agg.aggregate.grouping_sets.is_some()","+                || !partial_agg","+                    .aggregate","+                    .aggregate_functions","+                    .iter()","+                    .any(|partial_item| partial_item == item)","+            {","+                return None;","+            }","+            direct_scan_table_index(metadata, partial.unary_child(), source.column.index)","+        }","+        PhysicalRelOperator::EvalScalar(eval) => {","+            let column = match eval.items.iter().find(|item| item.index == column) {","+                Some(item) => match &item.scalar {","+                    ScalarExpr::BoundColumnRef(source) => source.column.index,","+                    _ => return None,","+                },","+                None => column,","+            };","+            min_max_output_table_index(metadata, expr.unary_child(), column)","+        }","+        PhysicalRelOperator::Filter(_)","+        | PhysicalRelOperator::Sort(_)","+        | PhysicalRelOperator::Limit(_)","+        | PhysicalRelOperator::Exchange(_) => {","+            min_max_output_table_index(metadata, expr.unary_child(), column)","+        }","+        _ => None,","+    }","+}","+","+/// Require one actual scan and an unchanged column path to it. Metadata alone","+/// is insufficient: a de