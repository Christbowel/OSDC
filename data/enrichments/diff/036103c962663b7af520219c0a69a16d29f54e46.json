+      Replica nonLeader =","+          slice.getReplicas().stream()","+              .filter(rep -> rep.getName().equals(slice.getLeader().getName()) == false)","+              .findFirst()","+              .orElseThrow();","+      setProp(slice, nonLeader, \"preferredLeader\");","+    }","+","+    ZkController zkController =","+        cluster.getRandomJetty(random()).getCoreContainer().getZkController();","+    Set<String> idsBefore = asyncIds(zkController);","+","+    int maxWaitSeconds = 60;","+    long start = System.nanoTime();","+    CollectionAdminResponse resp =","+        CollectionAdminRequest.rebalanceLeaders(COLLECTION_NAME)","+            .setMaxWaitSeconds(maxWaitSeconds)","+            .process(cluster.getSolrClient());","+    long elapsedSeconds = TimeUnit.NANOSECONDS.toSeconds(System.nanoTime() - start);","+    assertTrue(","+        resp.getResponse().toString(),","+        resp.getResponse().get(\"Summary\").toString().contains(\"Success\"));","+    assertNotNull(\"No leader change was requested\", resp.getResponse().get(\"successes\"));","+    assertTrue(","+        \"Waited \" + elapsedSeconds + \"s, hit maxWaitSeconds\", elapsedSeconds < maxWaitSeconds);","+","+    Set<String> leftover = asyncIds(zkController);","+    leftover.removeAll(idsBefore);","+    assertTrue(\"Async ids not cleared: \" + leftover, leftover.isEmpty());","+  }","+","+  private Set<String> asyncIds(ZkController zkController) throws Exception {","+    Optional<DistributedCollectionConfigSetCommandRunner> runner =","+        zkController.getDistributedCommandRunner();","+    if (runner.isPresent()) {","+      return new HashSet<>(runner.get().getTrackedAsyncIds());","+    }","+    Set<String> ids = new HashSet<>(zkController.getOverseerCompletedMap().keys());","+    ids.addAll(zkController.getOverseerFailureMap().keys());","+    ids.addAll(Overseer.getAsyncIdsMap(zkController.getZkClient()).keys());","+    return ids;","+  }","+","   // Ensure that the property is set on only one replica per slice when changing a unique property","   // on an individual","   // replica.",""],"additions":50,"deletions":0,"truncated":false}],"additions":92,"deletions":26,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-21T13:28:44.658596+00:00"}