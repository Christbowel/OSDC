{"id":"128f4a9478e99b9534138825a4dd2ec06157b99c","axis":"silent","repo":"jest-community/jest-extended","sha":"128f4a9478e99b9534138825a4dd2ec06157b99c","parsed":{"files":[{"path":".changeset/fresh-vitest-matchers.md","lines":["@@ -0,0 +1,5 @@","+---","+'jest-extended': minor","+---","+","+Add a dedicated `jest-extended/vitest.js` entry point for Vitest 5 with compatible matcher declarations and registration types. It preserves Vitest's overlapping matchers and does not require Jest ambient types, a registration cast, or `skipLibCheck`."],"additions":5,"deletions":0,"truncated":false},{"path":".github/workflows/ci.yaml","lines":["@@ -82,10 +82,30 @@ jobs:","           else","             echo \"No disallowed .js files found in src/ or test/. Check passed.\"","           fi","+  test-vitest:","+    name: Test Vitest 5 on Node.js v${{ matrix.node-version }}","+    strategy:","+      fail-fast: false","+      matrix:","+        node-version: [22.x, 24.x]","+    runs-on: ubuntu-latest","+    steps:","+      - uses: actions/checkout@v7","+      - run: corepack enable","+      - uses: actions/setup-node@v7","+        with:","+          node-version: ${{ matrix.node-version }}","+          cache: 'yarn'","+      - name: Use npm 11 for the packed consumer","+        run: npm install --global npm@11.20.0","+      - run: yarn install --immutable","+      - run: yarn build","+      - run: yarn test:vitest","+","   release:","     name: Run publish action","     if: ${{ github.event_name == 'push' && (github.event.ref == 'refs/heads/main' || github.event.ref == 'refs/heads/next') }}","-    needs: [lint, test-node, test-os]","+    needs: [lint, test-node, test-os, test-vitest]","     runs-on: ubuntu-latest","     steps:","       - name: Checkout Repo"],"additions":21,"deletions":1,"truncated":false},{"path":"eslint.config.cjs","lines":["@@ -97,7 +97,7 @@ module.exports = defineConfig([globalIgnores([\"**/dist\", \"**/examples\", \"**/webs","         \"import/no-default-export\": \"error\",","     },"," }, {","-    files: [\"**/*.ts\"],","+    files: [\"**/*.ts\", \"**/*.mts\"],","     extends: compat.extends(\"plugin:@typescript-eslint/recommended\"),"," ","     plugins: {"],"additions":1,"deletions":1,"truncated":false},{"path":"examples/vitest/README.md","lines":["@@ -0,0 +1,17 @@","+# Vitest 5","+","+This example imports `jest-extended/vitest.js` and registers its matchers without a cast or a custom declaration file. TypeScript checks dependency declarations with `skipLibCheck: false`; no Jest types are installed. The explicit `.js` extension also supports native Node ESM resolution without changing the package's existing exports.","+","+Run from the repository root after installing dependencies, using npm 11.20.0 for the consumer install:","+","+```text","+yarn build","+yarn test:vitest","+```","+","+CI pins npm 11.20.0 because npm 10 bundled with Node 22 crashes while resolving this example's optional peer dependencies","+([npm/cli#9787](https://github.com/npm/cli/issues/9787)).","+","+The runner packs the library, creates a temporary consumer outside the checkout, installs the example's pinned dependencies, checks its types, runs Vitest, and verifies that invalid matcher usage fails compilation. It leaves the temporary consumer available for inspection and prints its location.","+","+The tests cover synchronous, asynchronous, negated, and asymmetric matchers, plus Vitest's native overlapping matchers. They also check that the consumer does not load Jest ambient declarations."],"additions":17,"deletions":0,"truncated":false},{"path":"examples/vitest/interop.mjs","lines":["@@ -0,0 +1,8 @@","+import assert from 'node:assert/strict';","+import { createRequire } from 'node:module';","+import matchers, { toStartWith } from 'jest-extended/vitest.js';","+","+const require = createRequire(import.meta.url);","+assert.equal(require('jest-extended/vitest'), matchers);","+assert.equal(toStartWith, matchers.toStartWith);","+console.log('The packed entry point loads through native ESM and CommonJS.');"],"additions":8,"deletions":0,"truncated":false},{"path":"examples/vitest/matchers.test.ts","lines":["@@ -0,0 +1,101 @@","+import { expect, expectTypeOf, test, vi, type MatcherState } from 'vitest';","+import matchers from 'jest-extended/vitest.js';","+","+declare module 'vitest' {","+  interface Matchers<R, T> {","+    toHaveMessage(message: string): R;","+  }","+}","+","+test('plain and negated assertions', () => {","+  const result = expect('hello world').toStartWith('hello');","+  expectTypeOf(result).toEqualTypeOf<void>();","+  expect('hello world').not.toStartWith('goodbye');","+});","+","+test('resolved and rejected assertions', async () => {","+  const result = expect(Promise.resolve('hello world')).resolves.toStartWith('hello');","+  expectTypeOf(result).toEqualTypeOf<Promise<void>>();","+  await result;","+  await expect(Promise.reject('hello world')).rejects.toStartWith('hello');","+  await expect(Promise.resolve('hello world')).resolves.not.toStartWith('goodbye');","+  await expect(Promise.reject('hello world')).rejects.not.toStartWith('goodbye');","+});","+","+test('async matchers have promise return types', async () => {","+  const resolved = expect(Promise.resolve('hello')).toResolve();","+  const rejected = expect(Promise.reject('hello')).toReject();","+  expectTypeOf(resolved).toEqualTypeOf<Promise<void>>();","+  expectTypeOf(rejected).toEqualTypeOf<Promise<void>>();","+  await resolved;","+  await rejected;","+});","+","+test('asymmetric and negated asymmetric assertions', () => {","+  expect({ message: 'hello world' }).toEqual({ message: expect.toStartWith('hello') });","+  expect({ message: 'hello world' }).toEqual({ message: expect.not.toStartWith('goodbye') });","+});","+","+test('array, number, object, and passing assertions', () => {","+  expect([1, 2, 3]).toBeArrayOfSize(3);","+  expect(4).toBeEven();","+  expect(4).toBeInteger();","+  expect(Object.seal({})).toBeSealed();","+  expect('anything').pass('passes');","+});","+","+test('generic assertions preserve their argument types', () => {","+  expect({ message: 'hello' }).toContainEntry<{ message: string }>(['message', 'hello']);","+  expect([1, 2]).toSatisfyAll<number>(value => value > 0);","+  let message = 'before';","+  expect(() => {","+    message = 'after';","+  }).toChange(() => message);","+});","+","+test('generic implementation functions retain their type parameters', () => {","+  expectTypeOf(matchers.toContainEntry<{ message: string }>)","+    .parameter(1)","+    .toEqualTypeOf<readonly ['message', string]>();","+  expectTypeOf(matchers.toSatisfyAll<number>)","+    .parameter(1)","+    .toEqualTypeOf<(value: number) => boolean>();","+});","+","+test('implementation functions can be reused in custom matchers', () => {","+  const toContainEntry = matchers.toContainEntry<{ message: string }>;","+  expect.extend({","+    toHaveMessage(this: MatcherState, received: unknown, message: string) {","+      return toContainEntry.call(this, received, ['message', message]);","+    },","+  });","+  expect({ message: 'hello' }).toHaveMessage('hello');","+});","+","+test('incorrect values fail assertions', () => {","+  expect(() => expect('goodbye').toStartWith('hello')).toThrow();","+  expect(() => expect('hello').not.toStartWith('hello')).toThrow();","+  expect(() => expect({ message: 'goodbye' }).toEqual({ message: expect.toStartWith('hello') })).toThrow();","+});","+","+test('native membership retains Set support', () => {","+  expect('hello').toBeOneOf(new Set(['hello', 'world']));","+  expect({ message: 'hello' }).toEqual({ message: expect.toBeOneOf(new Set(['hello', 'world'])) });","+});","+","+test('native predicate retains its optional message', () => {","+  expect(4).toSatisfy(value => value % 2 === 0, 'expected an even number');","+});","+","+test('native call-order matchers accept Vitest mocks', () => {","+  const first = vi.fn();","+  const second = vi.fn();","+  first();","+  second();","+  expect(first).toHaveBeenCalledBefore(second);","+  expect(second).toHaveBeenCalledAfter(first);","+});","+","+test('native failure helper is preserved', () => {","+  expect(() => expect.fail('native failure')).toThrow('native failure');","+});"],"additions":101,"deletions":0,"truncated":false},{"path":"examples/vitest/package.json","lines":["@@ -0,0 +1,15 @@","+{","+  \"name\": \"jest-extended-vitest-example\",","+  \"private\": true,","+  \"type\": \"module\",","+  \"scripts\": {","+    \"test\": \"tsc --noEmit && tsc --noEmit --module NodeNext --moduleResolution NodeNext && node interop.mjs && vitest run && node verify-types.mjs\"","+  },","+  \"devDependencies\": {","+    \"@types/node\": \"22.19.0\",","+    \"jest-extended\": \"file:jest-extended.tgz\",","+    \"typescript\": \"5.9.3\",","+    \"vite\": \"8.3.6\",","+    \"vitest\": \"5.0.5\"","+  }","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"examples/vitest/run.cjs","lines":["@@ -0,0 +1,29 @@","+const assert = require('node:assert/strict');","+const { execSync } = require('node:child_process');","+const { copyFileSync, mkdtempSync, renameSync } = require('node:fs');","+const { tmpdir } = require('node:os');","+const path = require('node:path');","+","+const root = path.resolve(__dirname, '../..');","+const consumer = mkdtempSync(path.join(tmpdir(), 'jest-extended-vitest-'));","+const [archive] = JSON.parse(execSync('npm pack --ignore-scripts --json', { cwd: root, encoding: 'utf8' }));","+const archivePath = path.resolve(root, archive.filename);","+assert.equal(path.dirname(archivePath), root);","+renameSync(archivePath, path.join(consumer, 'jest-extended.tgz'));","+","+for (const file of [","+  'package.json',","+  'interop.mjs',","+  'tsconfig.json',","+  'vitest.config.ts',","+  'testSetup.ts',","+  'matchers.test.ts',","+  'type-errors.ts',","+  'verify-types.mjs',","+]) {","+  copyFileSync(path.join(__dirname, file), path.join(consumer, file));","+}","+","+console.log(`Testing the packed package in ${consumer}`);","+execSync('npm install --ignore-scripts --no-package-lock --no-audit --no-fund', { cwd: consumer, stdio: 'inherit' });","+execSync('npm test', { cwd: consumer, stdio: 'inherit' });"],"additions":29,"deletions":0,"truncated":false},{"path":"examples/vitest/testSetup.ts","lines":["@@ -0,0 +1,4 @@","+import { expect } from 'vitest';","+import matchers from 'jest-extended/vitest.js';","+","+expect.extend(matchers);"],"additions":4,"deletions":0,"truncated":false},{"path":"examples/vitest/tsconfig.json","lines":["@@ -0,0 +1,13 @@","+{","+  \"compilerOptions\": {","+    \"target\": \"ES2022\",","+    \"module\": \"ESNext\",","+    \"moduleResolution\": \"Bundler\",","+    \"strict\": true,","+    \"skipLibCheck\": false,","+    \"noEmit\": true,","+    \"types\": [\"node\"]","+  },","+  \"include\": [\"*.ts\"],","+  \"exclude\": [\"type-errors.ts\"]","+}"],"additions":13,"deletions":0,"truncated":false},{"path":"examples/vitest/type-errors.ts","lines":["@@ -0,0 +1,8 @@","+import { expect } from 'vitest';","+import matchers from 'jest-extended/vitest.js';","+","+expect('hello').toStartWith(123);","+expect([1]).toBeArrayOfSize('one');","+expect('hello').nonexistentMatcher();","+const wrong: number = expect(Promise.resolve('hello')).resolves.toStartWith('hello');","+matchers.toStartWith('hello', 123);"],"additions":8,"deletions":0,"truncated":false},{"path":"examples/vitest/verify-types.mjs","lines":["@@ -0,0 +1,35 @@","+import assert from 'node:assert/strict';","+import ts from 'typescript';","+import matchers from 'jest-extended/vitest.js';","+","+const config = ts.readConfigFile('tsconfig.json', ts.sys.readFile);","+const parsed = ts.parseJsonConfigFileContent(config.config, ts.sys, process.cwd());","+assert.equal(parsed.options.skipLibCheck, false);","+","+const program = ts.createProgram([...parsed.fileNames, 'type-errors.ts'], parsed.options);","+const diagnostics = ts.getPreEmitDiagnostics(program);","+const messages = diagnostics.map(diagnostic => ts.flattenDiagnosticMessageText(diagnostic.messageText, '\\n'));","+assert.equal(diagnostics.length, 5, messages.join('\\n'));","+for (const text of [\"type 'number'\", \"type 'string'\", 'nonexistentMatcher', \"Type 'Promise<void>'\"]) {","+  assert.ok(","+    messages.some(message => message.includes(text)),","+    `Expected diagnostic containing ${text}`,","+  );","+}","+assert.ok(diagnostics.every(diagnostic => diagnostic.file.fileName.endsWith('type-errors.ts')));","+assert.ok(!program.getSourceFiles().some(file => /[\\\\/]@types[\\\\/]jest[\\\\/]/.test(file.fileName)));","+assert.ok(!program.getSourceFiles().some(file => /[\\\\/]jest-extended[\\\\/]types[\\\\/]index.d.ts$/.test(file.fileName)));","+const setup = program.getSourceFiles().find(file => file.fileName.endsWith('testSetup.ts'));","+const matcherImport = setup.statements.find(","+  statement => ts.isImportDeclaration(statement) && statement.moduleSpecifier.text === 'jest-extended/vitest.js',","+);","+const checker = program.getTypeChecker();","+const matcherType = checker.getTypeAtLocation(matcherImport.importClause.name);","+assert.deepEqual(","+  checker","+    .getPropertiesOfType(matcherType)","+    .map(property => property.name)","+    .sort(),","+  Object.keys(matchers).sort(),","+);","+console.log('Invalid matcher usage is rejected without loading Jest ambient types.');"],"additions":35,"deletions":0,"truncated":false},{"path":"examples/vitest/vitest.config.ts","lines":["@@ -0,0 +1,7 @@","+import { defineConfig } from 'vitest/config';","+","+export default defineConfig({","+  test: {","+    setupFiles: ['./testSetup.ts'],","+  },","+});"],"additions":7,"deletions":0,"truncated":false},{"path":"package.json","lines":["@@ -7,7 +7,11 @@","   \"files\": [","     \"dist\",","     \"types/index.d.ts\",","-    \"all.js\"","+    \"types/matchers.d.ts\",","+    \"all.js\",","+    \"vitest.js\",","+    \"vitest.d.ts\",","+    \"vitest.d.mts\"","   ],","   \"scripts\": {","     \"clean\": \"node clean.js\",","@@ -22,6 +26,7 @@","     \"test:updateSnapshot\": \"yarn test --updateSnapshot\",","     \"test:coverage\": \"yarn test --coverage\",","     \"test:watch\": \"yarn test --watch\",","+    \"test:vitest\": \"node examples/vitest/run.cjs\",","     \"typecheck\": \"tsc --noEmit\",","     \"dev:docs\": \"cd website && yarn start\"","   },","@@ -133,7 +138,8 @@","   },","   \"peerDependencies\": {","     \"jest\": \">=27.2.5\",","-    \"typescript\": \">=5.0.0\"","+    \"typescript\": \">=5.0.0\",","+    \"vitest\": \">=5.0.0\"","   },","   \"peerDependenciesMeta\": {","     \"jest\": {","@@ -141,6 +147,9 @@","     },","     \"typescript\": {","       \"optional\": false","+    },","+    \"vitest\": {","+      \"optional\": true","     }","   },","   \"packageManager\": \"yarn@4.19.0\""],"additions":11,"deletions":2,"truncated":false},{"path":"src/matchers/toChange.ts","lines":["@@ -1,7 +1,7 @@"," /**","  * Use `.toChange` when checking if a value has changed.","  */","-export function toChange(mutator: () => unknown | void, checker: () => number) {","+export function toChange(mutator: () => unknown | void, checker: () => unknown) {","   // @ts-expect-error OK to have implicit any for this.utils","   const { printReceived: print, matcherHint: hint } = this.utils;"," "],"additions":1,"deletions":1,"truncated":false},{"path":"src/vitest.ts","lines":["@@ -0,0 +1,71 @@","+export { pass } from './matchers/pass';","+export { toBeAfter } from './matchers/toBeAfter';","+export { toBeAfterOrEqualTo } from './matchers/toBeAfterOrEqualTo';","+export { toBeArray } from './matchers/toBeArray';","+export { toBeArrayOfSize } from './matchers/toBeArrayOfSize';","+export { toBeBefore } from './matchers/toBeBefore';","+export { toBeBeforeOrEqualTo } from './matchers/toBeBeforeOrEqualTo';","+export { toBeBetween } from './matchers/toBeBetween';","+export { toBeBigInt } from './matchers/toBeBigInt';","+export { toBeBoolean } from './matchers/toBeBoolean';","+export { to