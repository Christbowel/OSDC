":["@@ -5,14 +5,19 @@ package certutil"," "," import ("," \t\"bytes\"","+\t\"crypto/x509\""," \t\"fmt\""," \t\"time\""," ","-\tctx509 \"github.com/google/certificate-transparency-go/x509\""," \t\"github.com/hashicorp/errwrap\"","+\t\"github.com/hashicorp/vault/sdk/helper/certutil/x509verify\""," )"," ","-func VerifyCertificateChain(parsedBundle *ParsedCertBundle, options ctx509.VerifyOptions, rootChainOnly bool) error {","+// VerifyCertificateChain validates the certificate chain in parsedBundle using","+// the supplied options. When rootChainOnly is true, at least one root CA must","+// be present in the chain; otherwise intermediates may serve as trust anchors","+// when no root is available.","+func VerifyCertificateChain(parsedBundle *ParsedCertBundle, options x509verify.VerifyOptions, rootChainOnly bool) error {"," \t// If private key exists, check if it matches the public key of cert"," \tif parsedBundle.PrivateKey != nil && parsedBundle.Certificate != nil {"," \t\tequal, err := ComparePublicKeys(parsedBundle.Certificate.PublicKey, parsedBundle.PrivateKey.Public())","@@ -24,13 +29,17 @@ func VerifyCertificateChain(parsedBundle *ParsedCertBundle, options ctx509.Verif"," \t\t}"," \t}"," ","-\trootCertPool := ctx509.NewCertPool()","-\tintermediateCertPool := ctx509.NewCertPool()","+\trootCertPool := x509verify.NewCertPool()","+\tintermediateCertPool := x509verify.NewCertPool()"," ","-\tfor index, certificate := range parsedBundle.CAChain {","-\t\tcert, err := convertCertificate(certificate.Bytes)","-\t\tif err != nil {","-\t\t\treturn fmt.Errorf(\"could not parse certificate number %v in chain: %w\", index, err)","+\tfor index, certBlock := range parsedBundle.CAChain {","+\t\tcert := certBlock.Certificate","+\t\tif cert == nil {","+\t\t\tvar err error","+\t\t\tcert, err = x509.ParseCertificate(certBlock.Bytes)","+\t\t\tif err != nil {","+\t\t\t\treturn fmt.Errorf(\"could not parse certificate number %v in chain: %w\", index, err)","+\t\t\t}"," \t\t}"," \t\tif index > 0 && !cert.IsCA {"," \t\t\t// Sometimes the leaf certificate is contained inside the bundle","@@ -45,7 +54,7 @@ func VerifyCertificateChain(parsedBundle *ParsedCertBundle, options ctx509.Verif"," \t\t}"," \t}"," ","-\tif !rootChainOnly && len(rootCertPool.Subjects()) < 1 {","+\tif !rootChainOnly && rootCertPool.Len() < 1 {"," \t\t// In this case, we don't have the root CA.  In some cases systems do trust an intermediate"," \t\t// directly, and this will work.  To accommodate those cases, we'll treat the intermediate"," \t\t// as the root.","@@ -58,30 +67,26 @@ func VerifyCertificateChain(parsedBundle *ParsedCertBundle, options ctx509.Verif"," \t\trootCertPool, intermediateCertPool = intermediateCertPool, rootCertPool"," \t}"," ","-\t// Note that we use github.com/google/certificate-transparency-go/x509 to perform certificate verification,","-\t// since that library provides options to disable checks that the standard library does not.","-"," \toptions.Roots = rootCertPool"," \toptions.Intermediates = intermediateCertPool"," \toptions.CurrentTime = time.Now()"," ","-\tcertificate, err := convertCertificate(parsedBundle.CertificateBytes)","-\tif err != nil {","-\t\treturn err","+\tcert := parsedBundle.Certificate","+\tif cert == nil {","+\t\tvar err error","+\t\tcert, err = x509.ParseCertificate(parsedBundle.CertificateBytes)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"cannot parse certificate for validation: %w\", err)","+\t\t}"," \t}"," ","-\t_, err = certificate.Verify(options)","+\t_, err := x509verify.Verify(cert, options)"," \treturn err"," }"," ","-func VerifyCertificate(parsedBundle *ParsedCertBundle, options ctx509.VerifyOptions) error {","+// VerifyCertificate validates the certificate chain in parsedBundle using the","+// supplied options, treating intermediates as trust anchors when no root is","+// present.","+func VerifyCertificate(parsedBundle *ParsedCertBundle, options x509verify.VerifyOptions) error {"," \treturn VerifyCertificateChain(parsedBundle, options, false)"," }","-","-func convertCertificate(certBytes []byte) (*ctx509.Certificate, error) {","-\tret, err := ctx509.ParseCertificate(certBytes)","-\tif err != nil {","-\t\treturn nil, fmt.Errorf(\"cannot convert certificate for validation: %w\", err)","-\t}","-\treturn ret, nil","-}"],"additions":30,"deletions":25,"truncated":false},{"path":"sdk/helper/certutil/cert_verification_test.go","lines":["@@ -0,0 +1,479 @@","+// Copyright IBM Corp. 2025","+// SPDX-License-Identifier: MPL-2.0","+","+package certutil","+","+import (","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"math/big\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/hashicorp/vault/sdk/helper/certutil/x509verify\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// buildTestChain generates a self-signed root CA, an intermediate CA signed by","+// the root, and a leaf certificate signed by the intermediate. It returns","+// parsedBundles suitable for passing to VerifyCertificateChain.","+//","+// The notBefore/notAfter parameters control the leaf certificate's validity","+// window, making it easy to create expired certificates for negative testing.","+func buildTestChain(t *testing.T, leafNotBefore, leafNotAfter time.Time) *ParsedCertBundle {","+\tt.Helper()","+","+\t// Root CA key and self-signed certificate.","+\trootKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err, \"generate root key\")","+","+\trootTemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(1),","+\t\tSubject:               pkix.Name{CommonName: \"Test Root CA\"},","+\t\tNotBefore:             time.Now().Add(-2 * time.Hour),","+\t\tNotAfter:              time.Now().Add(10 * 365 * 24 * time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t\tKeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRLSign,","+\t}","+\trootDER, err := x509.CreateCertificate(rand.Reader, rootTemplate, rootTemplate, &rootKey.PublicKey, rootKey)","+\trequire.NoError(t, err, \"create root certificate\")","+\trootCert, err := x509.ParseCertificate(rootDER)","+\trequire.NoError(t, err, \"parse root certificate\")","+","+\t// Intermediate CA key and certificate signed by root.","+\tintermediateKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err, \"generate intermediate key\")","+","+\tintermediateTemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(2),","+\t\tSubject:               pkix.Name{CommonName: \"Test Intermediate CA\"},","+\t\tNotBefore:             time.Now().Add(-1 * time.Hour),","+\t\tNotAfter:              time.Now().Add(10 * 365 * 24 * time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t\tKeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRLSign,","+\t}","+\tintermediateDER, err := x509.CreateCertificate(rand.Reader, intermediateTemplate, rootCert, &intermediateKey.PublicKey, rootKey)","+\trequire.NoError(t, err, \"create intermediate certificate\")","+\tintermediateCert, err := x509.ParseCertificate(intermediateDER)","+\trequire.NoError(t, err, \"parse intermediate certificate\")","+","+\t// Leaf certificate signed by the intermediate.","+\tleafKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err, \"generate leaf key\")","+","+\tleafTemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(3),","+\t\tSubject:               pkix.Name{CommonName: \"Test Leaf\"},","+\t\tNotBefore:             leafNotBefore,","+\t\tNotAfter:              leafNotAfter,","+\t\tBasicConstraintsValid: false,","+\t\tKeyUsage:              x509.KeyUsageDigitalSignature,","+\t\tExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageAny},","+\t}","+\tleafDER, err := x509.CreateCertificate(rand.Reader, leafTemplate, intermediateCert, &leafKey.PublicKey, intermediateKey)","+\trequire.NoError(t, err, \"create leaf certificate\")","+","+\treturn &ParsedCertBundle{","+\t\tCertificateBytes: leafDER,","+\t\tCAChain: []*CertBlock{","+\t\t\t{Bytes: intermediateDER},","+\t\t\t{Bytes: rootDER},","+\t\t},","+\t}","+}","+","+// TestVerifyCertificateChain_ValidChain verifies that a well-formed three-tier","+// chain (root → intermediate → leaf) passes verification with default options.","+func TestVerifyCertificateChain_ValidChain(t *testing.T) {","+\tt.Parallel()","+","+\tnow := time.Now()","+\tbundle := buildTestChain(t, now.Add(-1*time.Hour), now.Add(24*time.Hour))","+\topts := x509verify.VerifyOptions{","+\t\tKeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},","+\t}","+","+\terr := VerifyCertificateChain(bundle, opts, false)","+\trequire.NoError(t, err, \"valid chain should verify successfully\")","+}","+","+// TestVerifyCertificateChain_ExpiredLeaf verifies that an expired leaf","+// certificate causes verification to fail when time checks are enabled, and","+// succeeds when DisableTimeChecks is set — which is the behaviour required by","+// Vault's PKI engine when issuing certificates without enforcing validity windows.","+func TestVerifyCertificateChain_ExpiredLeaf(t *testing.T) {","+\tt.Parallel()","+","+\tpast := time.Now().Add(-48 * time.Hour)","+\tbundle := buildTestChain(t, past.Add(-1*time.Hour), past)","+","+\topts := x509verify.VerifyOptions{","+\t\tKeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},","+\t}","+","+\terr := VerifyCertificateChain(bundle, opts, false)","+\trequire.Error(t, err, \"expired leaf should fail verification with time checks enabled\")","+","+\topts.DisableTimeChecks = true","+\terr = VerifyCertificateChain(bundle, opts, false)","+\trequire.NoError(t, err, \"expired leaf should pass verification when DisableTimeChecks is true\")","+}","+","+// TestVerifyCertificateChain_NoRoot verifies that when no root CA is present in","+// the chain, the intermediate is promoted to the trust anchor (rootChainOnly=false),","+// while rootChainOnly=true causes verification to fail.","+func TestVerifyCertificateChain_NoRoot(t *testing.T) {","+\tt.Parallel()","+","+\tnow := time.Now()","+\tfullBundle := buildTestChain(t, now.Add(-1*time.Hour), now.Add(24*time.Hour))","+","+\t// Strip the root from the CA chain, leaving only the intermediate.","+\tbundleNoRoot := &ParsedCertBundle{","+\t\tCertificateBytes: fullBundle.CertificateBytes,","+\t\tCAChain:          fullBundle.CAChain[:1], // intermediate only","+\t}","+","+\topts := x509verify.VerifyOptions{","+\t\tKeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},","+\t}","+","+\terr := VerifyCertificateChain(bundleNoRoot, opts, false)","+\trequire.NoError(t, err, \"intermediate as trust anchor should succeed when rootChainOnly is false\")","+","+\terr = VerifyCertificateChain(bundleNoRoot, opts, true)","+\trequire.Error(t, err, \"verification should fail when rootChainOnly is true and no root is present\")","+}","+","+// TestVerifyCertificateChain_SelfSigned verifies that a self-signed certificate","+// with its chain pointing to itself is accepted — this is the case where Vault","+// stores the issuer as both root and leaf.","+func TestVerifyCertificateChain_SelfSigned(t *testing.T) {","+\tt.Parallel()","+","+\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err, \"generate key\")","+","+\tnow := time.Now()","+\ttemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(1),","+\t\tSubject:               pkix.Name{CommonName: \"Self-Signed Root\"},","+\t\tNotBefore:             now.Add(-1 * time.Hour),","+\t\tNotAfter:              now.Add(24 * time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t\tKeyUsage:              x509.KeyUsageCertSign,","+\t\tExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageAny},","+\t}","+\tder, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)","+\trequire.NoError(t, err, \"create self-signed certificate\")","+","+\tbundle := &ParsedCertBundle{","+\t\tCertificateBytes: der,","+\t\tCAChain: []*CertBlock{","+\t\t\t{Bytes: der},","+\t\t},","+\t}","+","+\topts := x509verify.VerifyOptions{","+\t\tKeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},","+\t}","+\terr = VerifyCertificateChain(bundle, opts, false)","+\trequire.NoError(t, err, \"self-signed certificate should verify successfully\")","+}","+","+// TestVerifyCertificateChain_DisablePathLenChecks verifies that path length constraint","+// violations can be bypassed when DisablePathLenChecks is true.","+func TestVerifyCertificateChain_DisablePathLenChecks(t *testing.T) {","+\tt.Parallel()","+","+\trootKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err)","+","+\tnow := time.Now()","+\trootTemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(1),","+\t\tSubject:               pkix.Name{CommonName: \"Root CA\"},","+\t\tNotBefore:             now.Add(-1 * time.Hour),","+\t\tNotAfter:              now.Add(24 * time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t\tMaxPathLen:            0,","+\t\tMaxPathLenZero:        true,","+\t\tKeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRLSign,","+\t}","+\trootDER, err := x509.CreateCertificate(rand.Reader, rootTemplate, rootTemplate, &rootKey.PublicKey, rootKey)","+\trequire.NoError(t, err)","+\trootCert, err := x509.ParseCertificate(rootDER)","+\trequire.NoError(t, err)","+","+\tintKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err)","+\tintTemplate := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(2),","+\t\tSubject:               pkix.Name{CommonName: \"Intermediate CA\"},","+\t\tNotBefore:             now.Add(-1 * time.Hour),","+\t\tNotAfter:              now.Add(24 * time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t\tKeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRL