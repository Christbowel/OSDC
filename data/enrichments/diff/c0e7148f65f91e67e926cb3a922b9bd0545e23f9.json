{"id":"c0e7148f65f91e67e926cb3a922b9bd0545e23f9","axis":"silent","repo":"symfony/symfony","sha":"c0e7148f65f91e67e926cb3a922b9bd0545e23f9","parsed":{"files":[{"path":"src/Symfony/Bundle/FrameworkBundle/CHANGELOG.md","lines":["@@ -4,6 +4,7 @@ CHANGELOG"," 8.2"," ---"," ","+ * Pass the token of `KernelBrowser::loginUser()` with each request, so that stateless firewalls can read it","  * Assert each constraint of the DomCrawler and BrowserKit assertions on its own, so that their failure messages describe the failed check instead of dumping the crawler, the response or the client","  * Add the `expression_language.compiled` tag to decorate an expression language with `CompiledExpressionLanguage`","  * Register the `lint:expressions` command"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/KernelBrowser.php","lines":["@@ -15,6 +15,7 @@"," use Symfony\\Component\\BrowserKit\\Cookie;"," use Symfony\\Component\\BrowserKit\\CookieJar;"," use Symfony\\Component\\BrowserKit\\History;","+use Symfony\\Component\\BrowserKit\\Request as DomRequest;"," use Symfony\\Component\\DependencyInjection\\ContainerInterface;"," use Symfony\\Component\\HttpFoundation\\Request;"," use Symfony\\Component\\HttpFoundation\\Response;","@@ -36,6 +37,11 @@ class KernelBrowser extends HttpKernelBrowser","     private bool $reboot = true;","     private ?\\Closure $containerConfigurator = null;"," ","+    /**","+     * @var array<string, TestBrowserToken>","+     */","+    private array $tokens = [];","+","     public function __construct(KernelInterface $kernel, array $server = [], ?History $history = null, ?CookieJar $cookieJar = null)","     {","         parent::__construct($kernel, $server, $history, $cookieJar);","@@ -152,6 +158,13 @@ public function insulate(bool $insulated = true): void","         parent::insulate($insulated);","     }"," ","+    public function restart(): void","+    {","+        parent::restart();","+","+        $this->tokens = [];","+    }","+","     /**","      * @param UserInterface        $user","      * @param array<string, mixed> $tokenAttributes","@@ -171,6 +184,9 @@ public function loginUser(object $user, string $firewallContext = 'main', array","         $token = new TestBrowserToken($user->getRoles(), $user, $firewallContext);","         $token->setAttributes($tokenAttributes);"," ","+        // stateless firewalls don't read the session, so the token is also sent with each request","+        $this->tokens[$firewallContext] = $token;","+","         $container = $this->getContainer();","         $container->get('security.untracked_token_storage')->setToken($token);"," ","@@ -192,6 +208,17 @@ public function loginUser(object $user, string $firewallContext = 'main', array","         return $this;","     }"," ","+    protected function filterRequest(DomRequest $request): Request","+    {","+        $httpRequest = parent::filterRequest($request);","+","+        if ($this->tokens) {","+            $httpRequest->attributes->set('_security_test_tokens', $this->tokens);","+        }","+","+        return $httpRequest;","+    }","+","     /**","      * @param Request $request","      */"],"additions":27,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/KernelBrowserTest.php","lines":["@@ -12,9 +12,11 @@"," namespace Symfony\\Bundle\\FrameworkBundle\\Tests;"," "," use Symfony\\Bundle\\FrameworkBundle\\KernelBrowser;","+use Symfony\\Bundle\\FrameworkBundle\\Test\\TestBrowserToken;"," use Symfony\\Bundle\\FrameworkBundle\\Tests\\Functional\\AbstractWebTestCase;"," use Symfony\\Component\\HttpFoundation\\Response;"," use Symfony\\Component\\HttpKernel\\KernelInterface;","+use Symfony\\Component\\Security\\Core\\User\\InMemoryUser;"," "," class KernelBrowserTest extends AbstractWebTestCase"," {","@@ -69,6 +71,26 @@ public function testGetProfileWithoutRequest()","         $this->assertFalse($browser->getProfile());","     }"," ","+    public function testLoginUserPassesTheTokenWithEachRequest()","+    {","+        $client = static::createClient(['test_case' => 'Security', 'root_config' => 'config.yml']);","+        $client->loginUser(new InMemoryUser('stateless-username', 'the-password', ['ROLE_FOO']), 'stateless', ['foo' => 'bar']);","+","+        $client->request('GET', '/stateless/user_profile');","+        $client->request('GET', '/stateless/user_profile');","+","+        $token = $client->getRequest()->attributes->get('_security_test_tokens')['stateless'];","+        $this->assertInstanceOf(TestBrowserToken::class, $token);","+        $this->assertSame('stateless', $token->getFirewallName());","+        $this->assertSame('stateless-username', $token->getUserIdentifier());","+        $this->assertSame(['foo' => 'bar'], $token->getAttributes());","+","+        $client->restart();","+        $client->request('GET', '/stateless/user_profile');","+","+        $this->assertFalse($client->getRequest()->attributes->has('_security_test_tokens'));","+    }","+","     private function getKernelMock()","     {","         $mock = $this->getMockBuilder($this->getKernelClass())"],"additions":22,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/CHANGELOG.md","lines":["@@ -4,6 +4,7 @@ CHANGELOG"," 8.2"," ---"," ","+ * Make `KernelBrowser::loginUser()` work on the stateless firewalls that use the `access_token` authenticator","  * Compile the expressions of `access_control` rules and of `#[IsGranted]` and `#[IsCsrfTokenValid]` attributes when warming up the cache","  * Deprecate the `ExpressionCacheWarmer` class","  * Add the `dpop` option to the `access_token` authenticator, to accept only the access tokens bound to a key the request proves it holds (RFC 9449)"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/DependencyInjection/SecurityExtension.php","lines":["@@ -18,6 +18,7 @@"," use Symfony\\Bundle\\SecurityBundle\\DependencyInjection\\Security\\Factory\\FirewallListenerFactoryInterface;"," use Symfony\\Bundle\\SecurityBundle\\DependencyInjection\\Security\\Factory\\StatelessAuthenticatorFactoryInterface;"," use Symfony\\Bundle\\SecurityBundle\\DependencyInjection\\Security\\UserProvider\\UserProviderFactoryInterface;","+use Symfony\\Bundle\\SecurityBundle\\Security\\TestBrowserAccessTokenAuthenticator;"," use Symfony\\Component\\Config\\Definition\\ConfigurationInterface;"," use Symfony\\Component\\Config\\Definition\\Exception\\InvalidConfigurationException;"," use Symfony\\Component\\Config\\FileLocator;","@@ -683,6 +684,17 @@ private function createAuthenticationListeners(ContainerBuilder $container, stri","                 }"," ","                 $authenticators = $factory->createAuthenticator($container, $id, $firewall[$key], $userProvider);","+","+                // a stateless firewall doesn't read the session, so the test client sends its token with each request instead","+                // this decorator is removed when there is no test client, that is outside test mode","+                if ('access_token' === $key && $firewall['stateless']) {","+                    $container->register($testBrowserId = 'security.authenticator.access_token.test_browser.'.$id, TestBrowserAccessTokenAuthenticator::class)","+                        ->setDecoratedService($authenticators)","+                        ->setArguments([new Reference($testBrowserId.'.inner'), $id, $userProvider ? new Reference($userProvider) : null])","+                        ->addTag('container.remove_if_missing', ['service' => 'test.client'])","+                    ;","+                }","+","                 if (\\is_array($authenticators)) {","                     foreach ($authenticators as $authenticator) {","                         $authenticationProviders[$authenticator] = $authenticator;"],"additions":12,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/Security/TestBrowserAccessTokenAuthenticator.php","lines":["@@ -0,0 +1,99 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bundle\\SecurityBundle\\Security;","+","+use Symfony\\Component\\HttpFoundation\\Request;","+use Symfony\\Component\\HttpFoundation\\Response;","+use Symfony\\Component\\Security\\Core\\Authentication\\Token\\TokenInterface;","+use Symfony\\Component\\Security\\Core\\Exception\\AuthenticationException;","+use Symfony\\Component\\Security\\Core\\User\\UserProviderInterface;","+use Symfony\\Component\\Security\\Http\\Authenticator\\AuthenticatorInterface;","+use Symfony\\Component\\Security\\Http\\Authenticator\\Passport\\Badge\\UserBadge;","+use Symfony\\Component\\Security\\Http\\Authenticator\\Passport\\Passport;","+use Symfony\\Component\\Security\\Http\\Authenticator\\Passport\\SelfValidatingPassport;","+use Symfony\\Component\\Security\\Http\\EntryPoint\\AuthenticationEntryPointInterface;","+use Symfony\\Component\\Security\\Http\\EntryPoint\\FallbackAuthenticationEntryPointInterface;","+","+/**","+ * Authenticates the user of KernelBrowser::loginUser() on a stateless firewall that uses the \"access_token\" authenticator.","+ *","+ * A stateless firewall doesn't read the session, so the test client sends its token with each request, in a request attribute.","+ * Only code that runs in the same process can set this attribute.","+ * The user is loaded like for a real access token, and the token attributes given to loginUser() are added to the authenticated token.","+ * When the request contains its own access token, the decorated authenticator handles it.","+ *","+ * @author Nicolas Grekas <p@tchwork.com>","+ *","+ * @internal","+ */","+final class TestBrowserAccessTokenAuthenticator implements AuthenticatorInterface, FallbackAuthenticationEntryPointInterface","+{","+    public function __construct(","+        private readonly AuthenticatorInterface&AuthenticationEntryPointInterface $authenticator,","+        private readonly string $firewallName,","+        private readonly ?UserProviderInterface $userProvider = null,","+    ) {","+    }","+","+    public function supports(Request $request): ?bool","+    {","+        $supports = $this->authenticator->supports($request);","+","+        return false === $supports && $this->getTestToken($request) ? null : $supports;","+    }","+","+    public function authenticate(Request $request): Passport","+    {","+        if (false !== $this->authenticator->supports($request) || !$token = $this->getTestToken($request)) {","+            return $this->authenticator->authenticate($request);","+        }","+","+        $user = $token->getUser();","+        $passport = new SelfValidatingPassport(new UserBadge($user->getUserIdentifier(), $this->userProvider ? $this->userProvider->loadUserByIdentifier(...) : static fn () => $user));","+        $passport->setAttribute(self::class, $token->getAttributes());","+","+        return $passport;","+    }","+","+    public function createToken(Passport $passport, string $firewallName): TokenInterface","+    {","+        $token = $this->authenticator->createToken($passport, $firewallName);","+","+        if (null !== $attributes = $passport->getAttribute(self::class)) {","+            $token->setAttributes($attributes + $token->getAttributes());","+        }","+","+        return $token;","+    }","+","+    public function onAuthenticationSuccess(Request $request, TokenInterface $token, string $firewallName): ?Response","+    {","+        return $this->authenticator->onAuthenticationSuccess($request, $token, $firewallName);","+    }","+","+    public function onAuthenticationFailure(Request $request, AuthenticationException $exception): ?Response","+    {","+        return $this->authenticator->onAuthenticationFailure($request, $exception);","+    }","+","+    public function start(Request $request, ?AuthenticationException $authException = null): Response","+    {","+        return $this->authenticator->start($request, $authException);","+    }","+","+    private function getTestToken(Request $request): ?TokenInterface","+    {","+        $token = $request->attributes->get('_security_test_tokens')[$this->firewallName] ?? null;","+","+        return $token instanceof TokenInterface && $token->getUser() ? $token : null;","+    }","+}"],"additions":99,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/Tests/DependencyInjection/SecurityExtensionTest.php","lines":["@@ -18,6 +18,7 @@"," use Symfony\\Bundle\\SecurityBundle\\DependencyInjection\\Security\\Factory\\FirewallListenerFactoryInterface;"," use Symfony\\Bundle\\SecurityBundle\\DependencyInjection\\SecurityExtension;"," use Symfony\\Bundle\\SecurityBundle\\Routing\\OidcLoginRouteLoader;","+use Symfony\\Bundle\\SecurityBundle\\Security\\TestBrowserAccessTokenAuthenticator;"," use Symfony\\Bundle\\SecurityBundle\\SecurityBundle;"," use Symfony\\Bundle\\SecurityBundle\\Tests\\DependencyInjection\\Fixtures\\UserProviderFactory\\CustomProviderFactory;"," use Symfony\\Bundle\\SecurityBundle\\Tests\\DependencyInjection\\Fixtures\\UserProviderFactory\\DummyProviderFactory;","@@ -1332,6 +1333,57 @@ public static function provideAccessTokenEntryPointFirewalls(): iterable","         yield 'explicitly configured' => [['http_basic' => true, 'entry_point' => 'access_token'], 'security.authenticator.access_token.main'];","     }"," ","+    public function testStatelessAccessTokenFirewallReadsTheUserOfTheTestClientInTestMode()","+    {","+        $container = $this->getRawContainer();","+        $container->register('test.client', \\stdClass::class);","+        $container->register('token_handler', \\stdClass::class);","+        $container->loadFromExtension('security', [","+            'providers' => [","+                'default' => ['id' => 'foo'],","+            ],","+            'firewalls' => [","+                'main' => ['stateless' => true, 'access_token' => ['token_handler' => 'token_handler']],","+            ],","+        ]);","+","+        $container->compile();","+","+        $definition = $container->getDefinition('security.authenticator.access_token.test_browser.main');","+        $this->assertSame(TestBrowserAccessTokenAuthenticator::class, $definition->getClass());","+        $this->assertSame(['security.authenticator.access_token.main', null, 0], $definition->getDecoratedService());","+        $this->assertEquals([new Reference('security.authenticator.access_token.test_browser.main.inner'), 'main', new Reference('foo')], $definition->getArguments());","+    }","+","+    #[DataProvider('provideFirewallsNotReadingTheUserOfTheTestClient')]","+    public function testFirewallDoesNotReadTheUserOfTheTestClient(bool $stateless, bool $testMode)","+    {","+        $container = $this->getRawContainer();","+        if ($testMode) {","+            $container->register('test.client', \\stdClass::class);","+        }","+        $container->register('token_handler', \\stdClass::class);","+        $container->loadFromExtension('security', [","+            'providers' => [","+                'default' => ['id' => 'foo'],","+            ],","+            'firewalls' => [","+                'main' => ['stateless' => $stateless, 'access_token' => ['token_handler' => 'token_handler']],","+            ],","+        ]);","+","+        $container->compile();","+","+        $this->assertFalse($container->hasDefinition('security.authenticator.access_token.test_browser.main'));","+    }","+","+    public static function provideFirewallsNotReadingTheUserOfTheTestClient(): iterable","+    {","+        yield 'stateless outside test mode' => [true, false];","+        // the test client stores its token in the session of a stateful firewall","+        yield 'stateful in test mode' => [false, true];","+    }","+","     public static function provideEntryPointFirewalls(): iterable","     {","         // only one entry point available"],"additions":52,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/Tests/Functional/AccessTokenTest.php","lines":["@@ -27,6 +27,8 @@"," use Symfony\\Component\\HttpClient\\MockHttpClient;"," use Symfony\\Component\\HttpClient\\Response\\MockResponse;"," use Symfony\\Component\\HttpFoundation\\Response;","+use Symfony\\Component\\Security\\Core\\User\\InMemoryUser;","+use Symfony\\Component\\Security\\Http\\Authenticator\\AccessTokenAuthenticator;"," "," class AccessTokenTest extends AbstractWebTestCase"," {","@@ -678,6 +680,77 @@ public function testCasSuccess()","         $this->assertSame(['message' => 'Welcome @dunglas!'], json_decode($response->getContent(), true));","     }"," ","+    public function testLoginUserOnAStatelessFirewallSurvivesKernelReboots()","+    {","+        $client = $this->createClient(['test_case' => 'AccessToken', 'root_config' => 'config_login_user.yml']);","+        $client->loginUser(new InMemoryUser('dunglas', null, ['ROLE_USER']), 'api');","+","+        $client->request('GET', '/foo');","+","+        $this->assertSame(200, $client->getResponse()->getStatusCode());","+        $this->assertSame(['message' => 'Welcome @dunglas!'], json_decode($client->getResponse()->getContent(), true));","+","+        $client->request('GET', '/foo');","+","+        $this->assertSame(200, $client->getResponse()->getStatusCode());","+        $this->assertSame(['message' => 'Welcome @dunglas!'], json_decode($client->getResponse()->getContent(), true));","+    }","+","+    public function testLoginUserOnAStatelessFirewallGivesTheTokenAttributes()","+    {","+        $client = $this->createClient(['test_case' => 'AccessToken', 'root_config' => 'config_login_user.yml']);","+","+        $client->loginUser(new InMemoryUser('dunglas', null, ['ROLE_USER']), 'api', [AccessTokenAuthenticator::SCOPE_ATTRIBUTE => ['profile:write']]);","+        $client->request('GET', '/scoped');","+","+        $this->assertSame(200, $client->getResponse()->getStatusCode());","+        $this->assertSame(['message' => 'Welcome @dunglas!'], json_decode($client->getResponse()->getContent(), true));","+","+        $client->loginUser(new InMemoryUser('dunglas', null, ['ROLE_USER']), 'api', [AccessTokenAuthenticator::SCOPE_ATTRIBUTE => ['profile:read']]);","+        $client->request('GET', '/scoped');","+","+        $this->assertSame(403, $client->getResponse()->getStatusCode());","+        $this->assertSame('Bearer realm=\"My API\",error=\"insufficient_scope\",error_description=\"The request requires higher privileges than provided by the access token.\",scope=\"profile:write\"', $client->getResponse()->headers->get('WWW-Authenticate'));","+    }","+","+    public function testLoginUserOnAStatelessFirewallLoadsTheUserFromItsUserProvider()","+    {","+        $client = $this->createClient(['test_case' => 'AccessToken', 'root_config' => 'config_login_user.yml']);","+        $client->loginUser(new InMemoryUser('unknown', null, ['ROLE_USER']), 'api');","+","+        $client->request('GET', '/foo');","+","+        $this->assertSame(401, $client->getResponse()->getStatusCode());","+        $this->assertSame('Bearer realm=\"My API\",error=\"invalid_token\",error_description=\"Invalid credentials.\"', $client->getResponse()->headers->get('WWW-Authenticate'));","+    }","+","+    public function testAnAccessTokenSentWithTheRequestPrevailsOverLoginUser()","+    {","+        $client = $this->createClient(['test_case' => 'AccessToken', 'root_config' => 'config_login_user.yml']);","+        $client->loginUser(new InMemoryUser('dunglas', null, ['ROLE_USER']), 'api');","+","+        $client->request('GET', '/foo', [], [], ['HTTP_AUTHORIZATION' => 'Bearer INVALID_ACCESS_TOKEN']);","+","+        $this->assertSame(401, $client->getResponse()->getStatusCode());","+        $this->assertSame('Bearer realm=\"My API\",error=\"invalid_token\",error_description=\"Invalid credentials.\"', $client->getResponse()->headers->get('WWW-Authenticate'));","+    }","+","+    public function testRestartLogsOutOfAStatelessFirewall()","+    {","+        $client = $this->createClient(['test_case' => 'AccessToken', 'root_config' => 'config_login_user.yml']);","+        $client->loginUser(new InMemoryUser('dunglas', null, ['ROLE_USER']), 'api');","+","+        $client->request('GET', '/foo');","+","+        $this->assertSame(200, $client->getResponse()->getStatusCode());","+","+        $client->restart();","+        $client->request('GET', '/foo');","+","+        $this->assertSame(401, $client->getResponse()->getStatusCode());","+        $this->assertSame('Bearer realm=\"My API\"', $client->getResponse()->headers->get('WWW-Authenticate'));","+    }","+","     public static function validAccessTokens(): array","     {","         if (!\\extension_loaded('openssl')) {"],"additions":73,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/Tests/Functional/app/AccessToken/config_login_user.yml","lines":["@@ -0,0 +1,35 @@","+imports:","+    - { resource: ./../config/framework.yml }","+","+framework:","+    serializer: ~","+","+security:","+    password_hashers:","+        Symfony\\Component\\Security\\Core\\User\\InMemoryUser: plaintext","+","+    providers:","+        in_memory:","+            memory:","+                users:","+                    dunglas: { password: foo, roles: [ROLE_USER] }","+","+    firewalls:","+        api:","+            pattern: ^/","+            stateless: true","+            access_token:","+                token_handler:","+                    oidc:","+                        claim: 'username'","+                        audience: 'Symfony OIDC'","+                        issuers: [ 'https://www.example.com' ]","+                        algorithms: [ 'ES256' ]","+                        enforce_at_jwt_type: true","+                        # a public key only, so that no test can sign a token for this handler","+                        keyset: '{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"0QEAsI1wGI-dmYatdUZoWSRWggLEpyzopuhwk-YUnA4\",\"y\":\"KYl-qyZ26HobuYwlQh-r0iHX61thfP82qqEku7i0woo\"}]}'","+                token_extractors: 'header'","+                realm: 'My API'","+","+    access_control:","+        - { path: ^/foo, roles: ROLE_USER }"],"additions":35,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/Tests/Security/TestBrowserAccessTokenAuthenticatorTest.php","lines":["@@ -0,0 +1,58 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Bundle\\SecurityBundle\\Tests\\Security;","+","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Bundle\\FrameworkBundle\\Test\\TestBrowserToken;","+use Symfony\\Bundle\\SecurityBundle\\Security\\TestBrowserAccessTokenAuthenticator;","+use Symfony\\Component\\HttpFoundation\\Request;","+use Symfony\\Component\\Security\\Core\\User\\InMemoryUser;","+use Symfony\\Component\\Security\\Http\\AccessToken\\AccessTokenHandlerInterface;","+use Symfony\\Component\\Security\\Http\\AccessToken\\HeaderAccessTokenExtractor;","+use Symfony\\Component\\Security\\Http\\Authenticator\\AccessTokenAuthenticator;","+","+class TestBrowserAccessTokenAuthenticatorTest extends TestCase","+{","+    public function testAuthenticatesTheUserOfTheTestClientOnAFirewallWithoutUserProvider()","+    {","+        $user = new InMemoryUser('dunglas', null, ['ROLE_USER']);","+        $token = new TestBrowserToken($user->getRoles(), $user, 'api');","+        $token->setAttributes(['foo' => 'bar']);","+        $request = Request::create('/');","+        $request->attributes->set('_security_test_tokens', ['api' => $token]);","+","+        $authenticator = new TestBrowserAccessTokenAuthenticator(new AccessTokenAuthenticator($this->createStub(AccessTokenHandlerInterface::class), new HeaderAccessTokenExtractor()), 'api');","+","+        $this->assertNull($authenticator->supports($request));","+","+        $passport = $authenticator->authenticate($request);","+","+        $this->assertSame($user, $passport->getUser());","+","+        $authenticatedToken = $authenticator->createToken($passport, 'api');","+","+        $this->assertSame($user, $authenticatedToken->getUser());","+        $this->assertSame(['ROLE_USER'], $authenticatedToken->getRoleNames());","+        $this->assertSame(['foo' => 'bar', AccessTokenAuthenticator::SCOPE_ATTRIBUTE => []], $authenticatedToken->getAttributes());","+    }","+","+    public function testIgnoresTheUserOfTheTestClientOnAnotherFirewall()","+    {","+        $user = new InMemoryUser('dunglas', null, ['ROLE_USER']);","+        $request = Request::create('/');","+        $request->attributes->set('_security_test_tokens', ['main' => new TestBrowserToken($user->getRoles(), $user, 'main')]);","+","+        $authenticator = new TestBrowserAccessTokenAuthenticator(new AccessTokenAuthenticator($this->createStub(AccessTokenHandlerInterface::class), new HeaderAccessTokenExtractor()), 'api');","+","+        $this->assertFalse($authenticator->supports($request));","+    }","+}",""],"additions":58,"deletions":0,"truncated":false}],"additions":380,"deletions":0,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-12T18:19:18.899839+00:00"}