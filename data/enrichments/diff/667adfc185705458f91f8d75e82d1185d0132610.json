e, the value","+        // cannot trigger a navigation and belongs to another meta type. Whitespace means","+        // the ASCII whitespace of the specification, which \\s does not match exactly.","+        if (!preg_match('/^([ \\t\\n\\f\\r]*(?:\\d[\\d.]*|\\.[\\d.]*))(.*)$/s', $value, $m)) {","+            return $value;","+        }","+","+        [, $time, $rest] = $m;","+","+        // Nothing follows the time: the directive reloads the current document.","+        if ('' === $rest) {","+            return $value;","+        }","+","+        // The time is followed by a semicolon, a comma or ASCII whitespace, the latter","+        // optionally followed by a semicolon or a comma. Anything else is dropped instead","+        // of being trusted, so that a spelling this parser does not know about cannot slip","+        // an unsanitized URL through.","+        if (!preg_match('/^((?:[;,]|[ \\t\\n\\f\\r]+[;,]?)[ \\t\\n\\f\\r]*)(.*)$/s', $rest, $m)) {","+            return null;","+        }","+","+        [, $separator, $url] = $m;","+","+        $keyword = '';","+        $quote = '';","+        $trailing = '';","+","+        // An incomplete \"url=\" keyword is part of the URL and disables the quote handling.","+        $stripQuotes = 'u' !== strtolower($url[0] ?? '');","+","+        if (preg_match('/^(url[ \\t\\n\\f\\r]*=[ \\t\\n\\f\\r]*)(.*)$/is', $url, $m)) {","+            [, $keyword, $url] = $m;","+            $stripQuotes = true;","+        }","+","+        if ($stripQuotes && ('\"' === ($first = $url[0] ?? '') || \"'\" === $first)) {","+            $quote = $first;","+            $url = substr($url, 1);","+","+            // Everything after the closing quote is ignored by browsers.","+            if (false !== $end = strpos($url, $quote)) {","+                $url = substr($url, 0, $end);","+            }","+        } else {","+            $trimmed = rtrim($url, \" \\t\\n\\f\\r\");","+            $trailing = substr($url, \\strlen($trimmed));","+            $url = $trimmed;","+        }","+","+        // An empty URL resolves to the document's own URL: the directive reloads the","+        // current document, exactly like a directive made of a time only.","+        if ('' === $url) {","             return $value;","         }"," ","         $sanitized = UrlSanitizer::sanitize(","-            $m[3],","+            $url,","             $config->getAllowedLinkSchemes(),","             $config->getForceHttpsUrls(),","             $config->getAllowedLinkHosts(),","@@ -51,6 +108,6 @@ public function sanitizeAttribute(string $element, string $attribute, string $va","             return null;","         }"," ","-        return $m[1].$m[2].$sanitized.$m[2].$m[4];","+        return $time.$separator.$keyword.$quote.$sanitized.$quote.$trailing;","     }"," }",""],"additions":61,"deletions":4,"truncated":false}],"additions":137,"deletions":4,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-04T16:06:12.474495+00:00"}