de=\"$(RepoRoot)\\src\\tests\\FunctionalTests\\tvOS\\Simulator\\**\\*.Test.csproj\"","+    <ProjectReference Include=\"$(RepoRoot)\\src\\tests\\FunctionalTests\\AppleMobile\\Simulator\\**\\*.Test.csproj\"","                       Exclude=\"@(ProjectExclusions)\"","                       BuildInParallel=\"false\" />","   </ItemGroup>"],"additions":24,"deletions":21,"truncated":false},{"path":"src/tasks/AndroidAppBuilder/Templates/monodroid-coreclr.c","lines":["@@ -15,6 +15,7 @@"," #include <unistd.h>"," #include <coreclrhost.h>"," #include <dirent.h>","+#include <dlfcn.h>"," "," #include <corehost/host_runtime_contract.h>"," ","@@ -140,6 +141,17 @@ external_assembly_probe(const char* relative_assembly_path, void** data, int64_t","     return true;"," }"," ","+static const void*","+pinvoke_override (const char* library_name, const char* entry_point_name)","+{","+    if (strcmp (library_name, \"__Internal\") == 0)","+    {","+        return dlsym (RTLD_DEFAULT, entry_point_name);","+    }","+","+    return NULL;","+}","+"," static void"," free_resources ()"," {","@@ -199,6 +211,7 @@ mono_droid_runtime_init (const char* executable)","     chdir (g_bundle_path);"," ","     g_host_contract.external_assembly_probe = &external_assembly_probe;","+    g_host_contract.pinvoke_override = &pinvoke_override;"," ","     const char* appctx_keys[PROPERTY_COUNT];"," %AppContextKeys%"],"additions":13,"deletions":0,"truncated":false},{"path":"src/tests/FunctionalTests/Android/Device_Emulator/CrashChaining/Program.cs","lines":["@@ -5,11 +5,9 @@"," using System.Runtime.InteropServices;"," "," /// <summary>","-/// Test that crash chaining preserves signal handlers during","-/// mono_handle_native_crash. When crash_chaining is enabled,","-/// mono_handle_native_crash should NOT reset SIGABRT etc. to SIG_DFL,","-/// because that would let secondary signals (e.g. FORTIFY aborts on","-/// other threads) kill the process before the crash can be chained.","+/// Test that runtime crash chaining preserves previously installed signal handlers.","+/// A secondary signal raised from a chained crash handler must reach the handler","+/// that was installed before the runtime initialized."," /// </summary>"," public static class Program"," {"],"additions":3,"deletions":5,"truncated":false},{"path":"src/tests/FunctionalTests/Android/Device_Emulator/CrashChaining/test_crash_chaining.c","lines":["@@ -11,18 +11,19 @@"," int test_crash_chaining(void);"," "," /*","- * Test for crash chaining: verify that mono_handle_native_crash does not","- * reset SIGABRT to SIG_DFL when crash_chaining is enabled.","+ * Test for crash chaining: verify that a secondary signal raised from a","+ * chained crash handler reaches the handler installed before the runtime.","  *","  * Strategy:","- *   1. Install pre-Mono SIGSEGV and SIGABRT handlers before mono_jit_init.","+ *   1. Install SIGSEGV and SIGABRT handlers before the runtime initializes.","  *   2. Trigger a SIGSEGV from a non-JIT native function.","- *   3. Mono chains to our SIGSEGV handler (because signal_chaining is enabled).","- *   4. Our handler checks that SIGABRT was restored to the pre-Mono handler.","+ *   3. The runtime chains to our SIGSEGV handler.","+ *   4. Our handler raises SIGABRT and verifies that the pre-runtime handler ran.","  *","  * Returns 0 on success, non-zero on failure.","  */"," static volatile sig_atomic_t g_test_crash_chain_result = -1;","+static volatile sig_atomic_t g_sigabrt_handler_called = 0;"," static sigjmp_buf g_test_jmpbuf;"," "," __attribute__((noinline))","@@ -36,42 +37,35 @@ static void"," test_sigabrt_handler(int signum)"," {","     (void)signum;","+    g_sigabrt_handler_called = 1;"," }"," "," /**","- * Pre-Mono SIGSEGV handler installed before mono_jit_init. Mono's","- * signal chaining saves this handler and calls it via mono_chain_signal","- * when a native crash occurs.","- *","- * After Mono's crash diagnostics (mono_handle_native_crash) run, this","- * handler verifies that SIGABRT was restored to the pre-Mono handler.","- * Without the fix, mono_handle_native_crash unconditionally resets","- * SIGABRT to SIG_DFL. With the fix, SIGABRT is restored to the","- * pre-Mono handler (test_sigabrt_handler).","+ * SIGSEGV handler installed before the runtime. The runtime saves this","+ * handler and invokes it when a native crash cannot be handled.","  */"," static void","-test_pre_mono_sigsegv_handler(int signum, siginfo_t *info, void *context)","+test_pre_runtime_sigsegv_handler(int signum, siginfo_t *info, void *context)"," {","     (void)signum;","     (void)info;","     (void)context;"," ","-    // By the time Mono chains to us, mono_handle_native_crash has","-    // already run. Check if SIGABRT was restored to our pre-Mono handler.","-    struct sigaction current_abrt;","-    sigaction(SIGABRT, NULL, &current_abrt);","-","-    g_test_crash_chain_result = (current_abrt.sa_handler == test_sigabrt_handler) ? 0 : 1;","+    // By the time the runtime chains to us, its crash diagnostics have already run.","+    // Raise SIGABRT to verify that its previously installed handler is still chained.","+    g_sigabrt_handler_called = 0;","+    raise(SIGABRT);","+    g_test_crash_chain_result = g_sigabrt_handler_called ? 0 : 1;"," ","     siglongjmp(g_test_jmpbuf, 1);"," }"," "," __attribute__((constructor))","-static void install_pre_mono_handler(void)","+static void install_pre_runtime_handler(void)"," {","     struct sigaction sa;","     memset(&sa, 0, sizeof(sa));","-    sa.sa_sigaction = test_pre_mono_sigsegv_handler;","+    sa.sa_sigaction = test_pre_runtime_sigsegv_handler;","     sa.sa_flags = SA_SIGINFO;","     sigemptyset(&sa.sa_mask);","     sigaction(SIGSEGV, &sa, NULL);"],"additions":17,"deletions":23,"truncated":false},{"path":"src/tests/FunctionalTests/AppleMobile/Device/AOT/Device.Aot.Test.csproj","lines":["rename from src/tests/FunctionalTests/iOS/Device/AOT/iOS.Device.Aot.Test.csproj","rename to src/tests/FunctionalTests/AppleMobile/De