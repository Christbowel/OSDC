tory = factory.unwrap( HibernateValidatorFactory.class );","+\t\t\tassertThat( hibernateFactory.getBeanResolver().namedConfiguredForRole( AccessorFactory.class ) ).containsKey( \"default\" );","+\t\t\ttry ( BeanHolder<AccessorFactory> defaultFactory = hibernateFactory.getBeanResolver()","+\t\t\t\t\t.resolve( AccessorFactory.class, \"default\", BeanRetrieval.BUILTIN ) ) {","+\t\t\t\tassertThat( defaultFactory.get().getClass() ).isEqualTo( hibernateFactory.getAccessorFactory().getClass() );","+\t\t\t}","+\t\t\tassertThat( factory.getValidator().validate( new Bean() ) ).hasSize( 1 );","+\t\t}","+\t}","+","+\t@Test(dataProvider = \"scopes\")","+\tpublic void explicitInstanceTakesPrecedenceOverProperty(boolean predefinedScope) {","+\t\tTrackingAccessorFactory accessorFactory = new TrackingAccessorFactory();","+\t\ttry ( ValidatorFactory factory = configuration( predefinedScope )","+\t\t\t\t.accessorFactory( accessorFactory )","+\t\t\t\t.addProperty( HibernateValidatorConfiguration.ACCESSOR_FACTORY_CLASSNAME, \"missing.AccessorFactory\" )","+\t\t\t\t.buildValidatorFactory() ) {","+\t\t\tassertThat( factory.unwrap( HibernateValidatorFactory.class ).getAccessorFactory() ).isSameAs( accessorFactory );","+\t\t\tassertThat( factory.getValidator().validate( new Bean() ) ).hasSize( 1 );","+\t\t\tassertThat( accessorFactory.fieldReaders ).isPositive();","+\t\t}","+\t}","+","+\t@Test(dataProvider = \"scopes\")","+\tpublic void propertyUsesConstructorAndExternalClassLoader(boolean predefinedScope) {","+\t\tAtomicInteger classLoads = new AtomicInteger();","+\t\tClassLoader externalClassLoader = new ClassLoader( getClass().getClassLoader() ) {","+\t\t\t@Override","+\t\t\tpublic Class<?> loadClass(String name) throws ClassNotFoundException {","+\t\t\t\tif ( name.equals( TestAccessorFactory.class.getName() ) ) {","+\t\t\t\t\tclassLoads.incrementAndGet();","+\t\t\t\t}","+\t\t\t\treturn super.loadClass( name );","+\t\t\t}","+\t\t};","+\t\ttry ( ValidatorFactory factory = configuration( p