ion when it has one, and a unique style-probing sentinel","+/// used while probing whether the target setting accepts free text."," pub(super) struct Placeholder {","-    pub(super) range: std::ops::Range<usize>,","-    pub(super) resolved: String,","+    pub(super) range: Range<usize>,","+    pub(super) resolved: Option<String>,","+    pub(super) sentinel: String,"," }"," ","-/// The placeholders of `text` that may stand in for what a setting is written","-/// as, in the order they appear.","+/// All unescaped `${...}` placeholders in a YAML document, paired with a","+/// sentinel prefix absent from both the source text and every resolved value.","+pub(super) struct DocumentPlaceholders {","+    sentinels: SentinelPlaceholders,","+    pub(super) items: Vec<Placeholder>,","+    pub(super) resolvable: Vec<usize>,","+}","+","+/// Collect the `${...}` placeholders of `text` in source order, returning","+/// `None` when `text` contains none."," ///","-/// A placeholder qualifies only when it resolves to a bare token — ASCII","-/// letters, digits, `-`, `_`, and `.`. A variant name, a boolean, and a","-/// number each are one; a URL, a path, an unresolved placeholder, and an","-/// empty expansion are not. That bounds what resolving one can do twice over:","-/// the text put back cannot spell yaml of its own, and it cannot name a","-/// request destination.","-pub(super) fn resolvable_placeholders<Sys: EnvVar>(text: &str) -> Vec<Placeholder> {","-    placeholder_ranges(text)","+/// Only a placeholder that resolves without missing variables to a bare token","+/// (`[A-Za-z0-9_.-]+`) outside YAML anchor/alias/tag tokens (`&`, `*`, `!`) and","+/// incomplete `\\x`/`\\u`/`\\U` hex escapes receives `resolved: Some(...)`. Every","+/// placeholder also receives a style-probing `sentinel` whose prefix cannot","+/// appear in `text` (even after YAML double-quoted unescaping) or in any","+/// resolved value, so YAML syntax indicators inside `${...}` (such as `{`, `}`,","+/// or `: `) do not prevent a free-text setting from parsing with its","+/// placeholder left unexpanded.","+pub(super) fn document_placeholders<Sys: EnvVar>(text: &str) -> Option<DocumentPlaceholders> {","+    let ranges = SentinelPlaceholders::single_line_ranges(text);","+    if ranges.is_empty() {","+        return None;","+    }","+    let resolved_values = resolve_bare_tokens::<Sys>(text, &ranges);","+    let sentinels = SentinelPlaceholders::with_extra(","+        text,","+        ranges.clone(),","+        resolved_values.iter().filter_map(Option::as_deref),","+    )?;","+    let mut items = Vec::with_capacity(ranges.len());","+    let mut resolvable = Vec::new();","+    for (index, (range, resolved)) in ranges","         .into_iter()","-        .filter_map(|range| {","-            let (resolved, unresolved) = env_replace_lossy::<Sys>(&text[range.clone()]);","-            (unresolved.is_empty() && is_bare_token(&resolved)).then_some(Placeholder {","-                range,","-                resolved,","-            })","-        })","-        .collect()","-}","-","-/// `text` with the `selected` placeholders resolved and every other byte of","-/// it left alone, so a scalar this did not resolve reaches the reader as the","-/// file spells it.","-pub(super) fn resolve_placeholders(","-    text: &str,","-    placeholders: &[Placeholder],","-    selected: impl Fn(usize) -> bool,","-) -> String {","-    let mut resolved = String::with_capacity(text.len());","-    let mut copied = 0;","-    for (index, placeholder) in placeholders.iter().enumerate() {","-        if !selected(index) {","-            continue;","+        .zip(resolved_values)","+        .enumerate()","+    {","+        if resolved.is_some() {","+            resolvable.push(index);","         }","-        resolved.push_str(&text[copied..placeholder.range.start]);","-        resolved.push_str(&placeholder.resolved);","-        copied = placeholder.range.end;","+        items.push(Placeholder { range, resolved, sentinel: sentinels.sentinel(index) });","+    }","+    Some(DocumentPlaceholders { sentinels, items, resolvable })","+}","+","+fn resolve_bare_tokens<Sys: EnvVar>(text: &str, ranges: &[Range<usize>]) -> Vec<Option<String>> {","+    let mut in_meta_token = false;","+    let mut cursor = 0;","+    let mut resolved = Vec::with_capacity(ranges.len());","+    for range in ranges {","+        advance_yaml_meta_state(&mut in_meta_token, &text[cursor..range.start]);","+        cursor = range.end;","+        let eligible = !in_meta_token && !has_incomplete_hex_escape_before(&text[..range.start]);","+        resolved.push(","+            eligible","+                .then(|| resolve_bare_token::<Sys>(&text[range.clone()]))","+                .flatten(),","+        );","     }","-    resolved.push_str(&text[copied..]);","     resolved"," }"," ","-/// `text` with every placeholder replaced by `null`, leaving the document the","-/// file describes apart from the settings a placeholder decides.","-pub(super) fn drop_placeholders(text: &str, placeholders: &[Placeholder]) -> String {","-    let dropped: Vec<Placeholder> = placeholders","+fn advance_yaml_meta_state(in_meta_token: &mut bool, segment: &str) {","+    for character in segment.chars() {","+        if matches!(character, '&' | '*' | '!') {","+            *in_meta_token = true;","+        } else if matches!(character, ' ' | '\\t' | '\\r' | '\\n' | ',' | '[' | ']' | '{' | '}') {","+            *in_meta_token = false;","+        }","+    }","+}","+","+fn has_incomplete_hex_escape_before(prefix: &str) -> bool {","+    let bytes = prefix.as_bytes();","+    let hex_len = bytes","         .iter()","-        .map(|placeholder| Placeholder {","-            range: placeholder.range.clone(),","-            resolved: \"null\".to_string(),","-        })","-        .collect();","-    resolve_placeholders(text, &dropped, |_| true)","+        .rev()","+        .take(8)","+        .take_while(|byte| byte.is_ascii_hexdigit())","+        .count();","+    let Some(escape_pos) = bytes.len().checked_sub(hex_len + 1) else {","+        return false;","+    };","+    let required_digits = match bytes[escape_pos] {","+        b'x' => 2,","+        b'u' => 4,","+        b'U' => 8,","+        _ => return false,","+    };","+    if hex_len >= required_digits {","+        return false;","+    }","+    let backslashes = bytes[..escape_pos]","+        .iter()","+        .rev()","+        .take_while(|&&byte| byte == b'\\\\')","+        .count();","+    backslashes % 2 == 1","+}","+","+fn resolve_bare_token<Sys: EnvVar>(placeholder: &str) -> Option<String> {","+    let (expanded, unresolved) = env_replace_lossy::<Sys>(placeholder);","+    (unresolved.is_empty() && is_bare_token(&expanded)).then_some(expanded)","+}","+","+impl DocumentPlaceholders {","+    /// Render `text` replacing each placeholder with `replacement(index, item)`.","+    pub(super) fn render<'out>(","+        &'out self,","+        text: &'out str,","+        replacement: impl Fn(usize, &'out Placeholder) -> &'out str,","+    ) -> String {","+        let mut rendered = String::with_capacity(text.len());","+        let mut copied = 0;","+        for (index, placeholder) in self.items.iter().enumerate() {","+            rendered.push_str(&text[copied..placeholder.range.start]);","+            rendered.push_str(replacement(index, placeholder));","+            copied = placeholder.range.end;","+        }","+        rendered.push_str(&text[copied..]);","+        rendered","+    }","+","+    pub(super) fn may_contain_sentinel(&self, value: &str) -> bool {","+        self.sentinels.may_contain_sentinel(value)","+    }","+","+    /// Restore every sentinel token in `value` back to its `${...}` text","+    /// decoded according to the enclosing YAML scalar style.","+    pub(super) fn try_restore(&self, original_text: &str, value: &str) -> Option<String> {","+        self.sentinels.try_restore(original_text, value)","+    }"," }"," "," fn is_bare_token(value: &str) -> bool {"],"additions":132,"deletions":52,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/parse_settings.rs","lines":["@@ -1,8 +1,9 @@","-use super::{","-    EnvVar, Placeholder, drop_placeholders, resolvable_placeholders, resolve_placeholders,","-};","+use super::{DocumentPlaceholders, EnvVar, Placeholder, document_placeholders};","+use restore::deserialize_restoring;"," use serde::de::DeserializeOwned;"," ","+mod restore;","+"," /// What a failed read reports in place of a value that came from the"," /// environment. `nodeLinker: ${NPM_TOKEN}` written by mistake must not put"," /// the token in a build log.","@@ -22,101 +23,169 @@ const INVALID_EXPANSION: &str = \"invalid environment-expanded value\";"," /// anything written by hand, and is read as written."," const MAX_DOCUMENT_READS: u32 = 512;"," ","+#[derive(Clone, Copy, PartialEq, Eq)]","+enum PlaceholderChoice {","+    Sentinel,","+    Expanded,","+}","+","+struct Prober<'text> {","+    text: &'text str,","+    placeholders: &'text DocumentPlaceholders,","+    choices: Vec<PlaceholderChoice>,","+    reads: u32,","+}","+","+impl<'text> Prober<'text> {","+    fn new(text: &'text str, placeholders: &'text DocumentPlaceholders) -> Self {","+        let choices = placeholders.items","+            .iter()","+            .map(|placeholder| {","+                if placeholder.resolved.is_some() {","+                    PlaceholderChoice::Expanded","+                } else {","+                    PlaceholderChoice::Sentinel","+                }","+            })","+            .collect();","+        Self { text, placeholders, choices, reads: 0 }","+    }","+","+    fn read<Settings: DeserializeOwned + Default>(&self) -> Option<Settings> {","+        read_candidate(self.text, self.placeholders, &self.choices)","+    }","+","+    /// Demote as many indices in `group` as possible from `Expanded` to","+    /// `Sentinel` while `self.read::<Settings>()` continues to succeed,","+    /// returning `false` if [`MAX_DOCUMENT_READS`] is exceeded.","+    fn demote<Settings: DeserializeOwned + Default>(&mut self, group: &[usize]) -> bool {","+        if group.is_empty() {","+            return true;","+        }","+        if self.reads >= MAX_DOCUMENT_READS {","+            return false;","+        }","+        self.reads += 1;","+        self.set_group(group, PlaceholderChoice::Sentinel);","+        if self.read::<Settings>().is_some() {","+            return true;","+        }","+        self.set_group(group, PlaceholderChoice::Expanded);","+        if group.len() == 1 {","+            return true;","+        }","+        let (left, right) = group.split_at(group.len() / 2);","+        self.demote::<Settings>(left) && self.demote::<Settings>(right)","+    }","+","+    /// Confirm every placeholder left `Expanded` is rejected even as an","+    /// unrestored sentinel by `serde_saphyr`, ruling out free-text slots whose","+    /// restoration failed on a quote or duplicate-key check.","+    fn verify_expanded_require_resolution<Settings: DeserializeOwned + Default>(&mut self) -> bool {","+        for index in 0..self.choices.len() {","+            if self.choices[index] != PlaceholderChoice::Expanded {","+                continue;","+            }","+            if self.reads >= MAX_DOCUMENT_READS {","+                return false;","+            }","+            self.reads += 1;","+            self.choices[index] = PlaceholderChoice::Sentinel;","+            let candidate = render_choices(self.text, self.placeholders, &self.choices);","+            self.choices[index] = PlaceholderChoice::Expanded;","+            if serde_saphyr::from_str::<Option<Settings>>(&candidate).is_ok() {","+                return false;","+            }","+        }","+        true","+    }","+","+    fn set_group(&mut self, group: &[usize], choice: PlaceholderChoice) {","+        for &index in group {","+            self.choices[index] = choice;","+        }","+    }","+}","+"," /// Read the settings of a `pnpm-workspace.yaml` / `config.yaml`, resolving a"," /// setting written as `${VAR}` or `${VAR:-fallback}`."," ///"," /// Only the placeholders the document cannot be read without are resolved","-/// here. A setting that takes free text reads as written, so its placeholder","-/// is left for the trusted / untrusted substitution that follows — which is","-/// what keeps a repository-controlled file from naming a request destination","-/// out of the environment. A document that reads as written resolves nothing","-/// at all and is returned exactly as it was read, so what a file means today","-/// it goes on meaning.","+/// here. Placeholders whose YAML syntax indicators (`{`, `}`, `: `) would","+/// break parsing stand in as style-probing sentinels and are restored to their","+/// decoded `${...}` text as serde reads string values. Free-text settings are","+/// therefore always left unexpanded for the trusted / untrusted substitution","+/// that follows. A document that reads as written resolves nothing at all."," pub(crate) fn parse_settings<Sys: EnvVar, Settings: DeserializeOwned + Default>(","     text: &str,"," ) -> Result<Settings, Box<serde_saphyr::Error>> {","-    // A placeholder reaches serde as its own text, which only a string-valued","-    // setting can hold, so a document carrying one for any other setting has","-    // to be read a second time with that placeholder already resolved.","     let as_written = match serde_saphyr::from_str::<Option<Settings>>(text) {","         Ok(Some(settings)) => return Ok(settings),","         Ok(None) => return Ok(Settings::default()),","         Err(error) => error,","     };","-    let placeholders = resolvable_placeholders::<Sys>(text);","-    if placeholders.is_empty() {","+    let Some(placeholders) = document_placeholders::<Sys>(text) else {","         return Err(Box::new(as_written));","+    };","+    let mut prober = Prober::new(text, &placeholders);","+    prober.reads = 1;","+    if p