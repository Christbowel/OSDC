{"id":"743855de4882db85ac2c047af5db8f00eb178566","axis":"silent","repo":"pnpm/pnpm","sha":"743855de4882db85ac2c047af5db8f00eb178566","parsed":{"files":[{"path":".changeset/fix-106-workspace-yaml-flow-env.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`${VAR}` placeholders in `pnpm-workspace.yaml` written with YAML flow syntax now fail on registry URLs with `ERR_PNPM_REGISTRY_ENV_NOT_EXPANDED`. Placeholders in flow-style proxy, `pnprServer`, and `userAgent` settings are now ignored with a warning [#18074](https://github.com/pnpm/pnpm/pull/18074)."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -6927,6 +6927,7 @@ dependencies = [","  \"miette 7.6.0\",","  \"pathdiff\",","  \"pnpm-catalogs-types\",","+ \"pnpm-env-replace\",","  \"pnpm-fs\",","  \"pnpm-local-spec\",","  \"pnpm-package-manifest\","],"additions":1,"deletions":0,"truncated":false},{"path":"crate-layers.toml","lines":["@@ -351,7 +351,7 @@ pnpm-testing-utils = 4"," pnpm-version-policy = 1"," pnpm-versioning = 3"," pnpm-which = 1","-pnpm-workspace = 5","+pnpm-workspace = 6"," pnpm-workspace-manifest-writer = 7"," pnpm-workspace-projects-filter = 7"," pnpm-workspace-projects-graph = 6"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/config_get_set.rs","lines":["@@ -367,3 +367,131 @@ fn global_get_and_list_ignore_the_project_settings() {"," ","     drop(root);"," }","+","+#[test]","+fn flow_mapping_workspace_yaml_rejects_registry_env_and_drops_proxy_env() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\": \"demo-app\", \"version\": \"1.0.0\"}\"#)","+        .expect(\"write package.json\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"{registry: https://example.invalid/${DEMO_REG_VAR}/}\\n\",","+    )","+    .expect(\"write flow pnpm-workspace.yaml\");","+","+    let registry_out = pacquet_in(&workspace)","+        .with_env(\"DEMO_REG_VAR\", \"subpath\")","+        .with_args([\"config\", \"get\", \"registry\"])","+        .output()","+        .expect(\"run pacquet config get registry\");","+    let stderr = String::from_utf8_lossy(&registry_out.stderr);","+    let stdout = String::from_utf8_lossy(&registry_out.stdout);","+    assert!(!registry_out.status.success(), \"expected failure, stdout={stdout}, stderr={stderr}\");","+    assert!(stderr.contains(\"ERR_PNPM_REGISTRY_ENV_NOT_EXPANDED\"), \"stderr={stderr}\");","+    assert!(!stdout.contains(\"subpath\") && !stderr.contains(\"subpath\"), \"leaked env value\");","+","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"{httpsProxy: http://127.0.0.1:8080/${DEMO_REG_VAR}, shamefullyHoist: ${DEMO_HOIST}}\\n\",","+    )","+    .expect(\"write flow proxy pnpm-workspace.yaml\");","+    let proxy_get = pacquet_in(&workspace)","+        .with_env(\"DEMO_REG_VAR\", \"subpath\")","+        .with_env(\"DEMO_HOIST\", \"true\")","+        .with_args([\"config\", \"get\", \"httpsProxy\"])","+        .output()","+        .expect(\"run pacquet config get httpsProxy\");","+    assert!(proxy_get.status.success(), \"stderr={}\", String::from_utf8_lossy(&proxy_get.stderr));","+    assert_eq!(String::from_utf8_lossy(&proxy_get.stdout).trim_end(), \"undefined\");","+","+    let proxy_list = pacquet_in(&workspace)","+        .with_env(\"DEMO_REG_VAR\", \"subpath\")","+        .with_env(\"DEMO_HOIST\", \"true\")","+        .with_args([\"config\", \"list\"])","+        .output()","+        .expect(\"run pacquet config list\");","+    let list_stderr = String::from_utf8_lossy(&proxy_list.stderr);","+    let list_stdout = String::from_utf8_lossy(&proxy_list.stdout);","+    assert!(proxy_list.status.success(), \"stderr={list_stderr}\");","+    assert!(list_stderr.contains(r#\"Ignored \"httpsProxy\"\"#), \"stderr={list_stderr}\");","+    assert!(!list_stdout.contains(\"subpath\") && !list_stderr.contains(\"subpath\"));","+    assert!(list_stdout.contains(r#\"\"shamefullyHoist\": true\"#), \"stdout={list_stdout}\");","+","+    let config_home = root.path().join(\"xdg-config\");","+    fs::create_dir_all(config_home.join(\"pnpm\")).expect(\"create global config directory\");","+    fs::write(","+        config_home.join(\"pnpm/config.yaml\"),","+        \"{registry: https://example.invalid/${DEMO_REG_VAR}/}\\n\",","+    )","+    .expect(\"write global config.yaml\");","+    let pnpm_home = root.path().join(\"pnpm-home\");","+    fs::create_dir_all(&pnpm_home).expect(\"create pnpm home\");","+    let global_out = pacquet_in(&workspace)","+        .with_env(\"XDG_CONFIG_HOME\", &config_home)","+        .with_env(\"PNPM_HOME\", &pnpm_home)","+        .with_env(\"DEMO_REG_VAR\", \"subpath\")","+        .with_args([\"config\", \"get\", \"registry\", \"--global\"])","+        .output()","+        .expect(\"run global config get registry\");","+    assert!(global_out.status.success(), \"stderr={}\", String::from_utf8_lossy(&global_out.stderr));","+    assert_eq!(","+        String::from_utf8_lossy(&global_out.stdout).trim_end(),","+        \"https://example.invalid/subpath/\",","+    );","+","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"{include: {'./shared.yaml': [shamefullyHoist]}, userAgent: agent/${DEMO_UNSET_VAR}}\\n\",","+    )","+    .expect(\"write root include flow pnpm-workspace.yaml\");","+    fs::write(workspace.join(\"shared.yaml\"), \"shamefullyHoist: true\\n\").expect(\"write shared.yaml\");","+    let include_get = pacquet_in(&workspace)","+        .with_args([\"config\", \"get\", \"shamefully-hoist\"])","+        .output()","+        .expect(\"run config get shamefully-hoist with include\");","+    assert!(","+        include_get.status.success(),","+        \"stderr={}\",","+        String::from_utf8_lossy(&include_get.stderr),","+    );","+    assert_eq!(String::from_utf8_lossy(&include_get.stdout).trim_end(), \"true\");","+","+    let include_list = pacquet_in(&workspace)","+        .with_args([\"config\", \"list\"])","+        .output()","+        .expect(\"run config list with include\");","+    let include_list_stderr = String::from_utf8_lossy(&include_list.stderr);","+    let include_list_stdout = String::from_utf8_lossy(&include_list.stdout);","+    assert!(include_list.status.success(), \"stderr={include_list_stderr}\");","+    assert!(include_list_stderr.contains(r#\"Ignored \"userAgent\"\"#), \"stderr={include_list_stderr}\");","+    assert!(","+        include_list_stdout.contains(r#\"\"shamefullyHoist\": true\"#),","+        \"stdout={include_list_stdout}\",","+    );","+","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"include:\\n  ./shared.yaml: [registry]\\n\")","+        .expect(\"write include registry pnpm-workspace.yaml\");","+    fs::write(","+        workspace.join(\"shared.yaml\"),","+        \"{registry: https://example.invalid/${DEMO_REG_VAR}/}\\n\",","+    )","+    .expect(\"write flow registry shared.yaml\");","+    let include_reg = pacquet_in(&workspace)","+        .with_env(\"DEMO_REG_VAR\", \"subpath\")","+        .with_args([\"config\", \"get\", \"registry\"])","+        .output()","+        .expect(\"run config get registry with included flow placeholder\");","+    let include_reg_stderr = String::from_utf8_lossy(&include_reg.stderr);","+    let include_reg_stdout = String::from_utf8_lossy(&include_reg.stdout);","+    assert!(","+        !include_reg.status.success(),","+        \"stdout={include_reg_stdout}, stderr={include_reg_stderr}\",","+    );","+    assert!(","+        include_reg_stderr.contains(\"ERR_PNPM_REGISTRY_ENV_NOT_EXPANDED\"),","+        \"stderr={include_reg_stderr}\",","+    );","+    assert!(!include_reg_stdout.contains(\"subpath\") && !include_reg_stderr.contains(\"subpath\"));","+","+    drop(root);","+}"],"additions":128,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml.rs","lin