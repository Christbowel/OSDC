slowestFirst) {","             ordered.sort(Comparator.comparingLong((StartupStep st) -> st.duration).reversed());","+        } else if (hasIds(steps)) {","+            ordered = depthFirst(steps);","         } else if (steps.stream().anyMatch(st -> st.beginTime > 0)) {","             ordered.sort(Comparator.comparingLong((StartupStep st) -> st.beginTime).thenComparingInt(st -> st.level));","         }","         return ordered;","     }"," ","+    /** Whether every step has its own id, so the steps can be put under their parents. */","+    private static boolean hasIds(List<StartupStep> steps) {","+        Set<Integer> ids = new HashSet<>();","+        for (StartupStep st : steps) {","+            if (st.id <= 0 || !ids.add(st.id)) {","+                return false;","+            }","+        }","+        return true;","+    }","+","+    /**","+     * Each step followed by its children: the recorder gives the ids in the order the steps begin, so ordering by id","+     * keeps the begin order even where two steps began in the same millisecond, and a step whose parent is not in the","+     * list is a root.","+     */","+    private static List<StartupStep> depthFirst(List<StartupStep> steps) {","+        Set<Integer> ids = new HashSet<>();","+        steps.forEach(st -> ids.add(st.id));","+        List<StartupStep> byId = new ArrayList<>(steps);","+        byId.sort(Comparator.comparingInt(st -> st.id));","+        Map<Integer, List<StartupStep>> children = new HashMap<>();","+        List<StartupStep> roots = new ArrayList<>();","+        for (StartupStep st : byId) {","+            if (st.parentId != st.id && ids.contains(st.parentId)) {","+                children.computeIfAbsent(st.parentId, k -> new ArrayList<>()).add(st);","+            } else {","+                roots.add(st);","+            }","+        }","+        List<StartupStep> answer = new ArrayList<>(steps.size());","+        Set<Integer> visited = new HashSet<>();","+        Deque<StartupStep> sta