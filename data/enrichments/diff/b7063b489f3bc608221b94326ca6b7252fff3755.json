{"id":"b7063b489f3bc608221b94326ca6b7252fff3755","axis":"silent","repo":"hashicorp/consul","sha":"b7063b489f3bc608221b94326ca6b7252fff3755","parsed":{"files":[{"path":".changelog/24198.txt","lines":["@@ -0,0 +1,11 @@","+```release-note:improvement","+cli: The `consul resource apply-grpc`, `read-grpc`, `list-grpc`, and `delete-grpc` commands now verify the server's certificate when using TLS and require TLS 1.2 or later. Previously, certificate verification was skipped unless `CONSUL_GRPC_TLS_VERIFY=true` was set. If the server's certificate is not signed by a system-trusted CA, provide the CA with `-ca-file` or `CONSUL_GRPC_CACERT`. Use the new `-tls-server-name` flag or `CONSUL_GRPC_TLS_SERVER_NAME` to set the expected server name, for example when connecting by IP address. Verification can be disabled with the new `-grpc-tls-verify=false` flag or `CONSUL_GRPC_TLS_VERIFY=false`.","+```","+","+```release-note:bug","+api: Fix an invalid value for the `CONSUL_HTTP_SSL_VERIFY` environment variable, such as `yes` or a typo, disabling TLS certificate verification. Only `false` or `0` now disables verification, and a warning is logged for invalid values.","+```","+","+```release-note:bug","+api: Fix an invalid value for the `CONSUL_HTTP_SSL` environment variable, such as `yes` or a typo, falling back to plain HTTP. Only `false` or `0` now selects HTTP, and a warning is logged for invalid values.","+```"],"additions":11,"deletions":0,"truncated":false},{"path":"api/api.go","lines":["@@ -67,7 +67,9 @@ const ("," \tHTTPTLSServerName = \"CONSUL_TLS_SERVER_NAME\""," "," \t// HTTPSSLVerifyEnvName defines an environment variable name which sets","-\t// whether or not to disable certificate checking.","+\t// whether to verify the server's certificate when communicating over TLS.","+\t// Verification is enabled by default; only a false value disables it, and","+\t// a value that cannot be parsed as a boolean leaves it enabled."," \tHTTPSSLVerifyEnvName = \"CONSUL_HTTP_SSL_VERIFY\""," "," \t// GRPCAddrEnvName defines an environment variable name which sets the gRPC","@@ -507,7 +509,11 @@ func defaultConfig(logger hclog.Logger, transportFn func() *http.Transport) *Con"," \tif ssl := os.Getenv(HTTPSSLEnvName); ssl != \"\" {"," \t\tenabled, err := strconv.ParseBool(ssl)"," \t\tif err != nil {","-\t\t\tlogger.Warn(fmt.Sprintf(\"could not parse %s\", HTTPSSLEnvName), \"error\", err)","+\t\t\t// An unparseable value must not fall back to plain HTTP, which","+\t\t\t// would send the ACL token unencrypted; only an explicit false","+\t\t\t// value disables TLS.","+\t\t\tlogger.Warn(fmt.Sprintf(\"could not parse %s, using HTTPS\", HTTPSSLEnvName), \"error\", err)","+\t\t\tenabled = true"," \t\t}"," "," \t\tif enabled {","@@ -533,9 +539,10 @@ func defaultConfig(logger hclog.Logger, transportFn func() *http.Transport) *Con"," \tif v := os.Getenv(HTTPSSLVerifyEnvName); v != \"\" {"," \t\tdoVerify, err := strconv.ParseBool(v)"," \t\tif err != nil {","-\t\t\tlogger.Warn(fmt.Sprintf(\"could not parse %s\", HTTPSSLVerifyEnvName), \"error\", err)","-\t\t}","-\t\tif !doVerify {","+\t\t\t// An unparseable value must not disable verification; only an","+\t\t\t// explicit false value does.","+\t\t\tlogger.Warn(fmt.Sprintf(\"could not parse %s, TLS certificate verification remains enabled\", HTTPSSLVerifyEnvName), \"error\", err)","+\t\t} else if !doVerify {"," \t\t\tconfig.TLSConfig.InsecureSkipVerify = true"," \t\t}"," \t}"],"additions":12,"deletions":5,"truncated":false},{"path":"api/api_test.go","lines":["@@ -546,6 +546,67 @@ func TestAPI_DefaultConfig_env(t *testing.T) {"," \t}"," }"," ","+func TestAPI_DefaultConfig_SSLVerifyEnv(t *testing.T) {","+\tcases := []struct {","+\t\tvalue          string","+\t\texpectInsecure bool","+\t}{","+\t\t{value: \"true\", expectInsecure: false},","+\t\t{value: \"1\", expectInsecure: false},","+\t\t{value: \"false\", expectInsecure: true},","+\t\t{value: \"0\", expectInsecure: true},","+\t\t// Values that cannot be parsed must not disable verification.","+\t\t{value: \"yes\", expectInsecure: false},","+\t\t{value: \"on\", expectInsecure: false},","+\t\t{value: \"no\", expectInsecure: false},","+\t\t{value: \"ture\", expectInsecure: false},","+\t\t{value: \"TRUE \", expectInsecure: false},","+\t}","+\tfor _, tc := range cases {","+\t\tt.Run(tc.value, func(t *testing.T) {","+\t\t\tt.Setenv(HTTPSSLVerifyEnvName, tc.value)","+","+\t\t\tconfig := DefaultConfigWithLogger(testutil.Logger(t))","+\t\t\trequire.Equal(t, tc.expectInsecure, config.TLSConfig.InsecureSkipVerify)","+\t\t})","+\t}","+","+\tt.Run(\"unset\", func(t *testing.T) {","+\t\tt.Setenv(HTTPSSLVerifyEnvName, \"\")","+\t\trequire.False(t, DefaultConfig().TLSConfig.InsecureSkipVerify)","+\t})","+}","+","+func TestAPI_DefaultConfig_SSLEnv(t *testing.T) {","+\tcases := []struct {","+\t\tvalue        string","+\t\texpectScheme string","+\t}{","+\t\t{value: \"true\", expectScheme: \"https\"},","+\t\t{value: \"1\", expectScheme: \"https\"},","+\t\t{value: \"false\", expectScheme: \"http\"},","+\t\t{value: \"0\", expectScheme: \"http\"},","+\t\t// Values that cannot be parsed must not fall back to plain HTTP.","+\t\t{value: \"yes\", expectScheme: \"https\"},","+\t\t{value: \"no\", expectScheme: \"https\"},","+\t\t{value: \"ture\", expectScheme: \"https\"},","+\t\t{value: \"TRUE \", expectScheme: \"https\"},","+\t}","+\tfor _, tc := range cases {","+\t\tt.Run(tc.value, func(t *testing.T) {","+\t\t\tt.Setenv(HTTPSSLEnvName, tc.value)","+","+\t\t\tconfig := DefaultConfigWithLogger(testutil.Logger(t))","+\t\t\trequire.Equal(t, tc.expectScheme, config.Scheme)","+\t\t})","+\t}","+","+\tt.Run(\"unset\", func(t *testing.T) {","+\t\tt.Setenv(HTTPSSLEnvName, \"\")","+\t\trequire.Equal(t, \"http\", DefaultConfig().Scheme)","+\t})","+}","+"," func TestAPI_SetupTLSConfig(t *testing.T) {"," \t// if this test is failing because of expired certificates"," \t// use the procedure in test/CA-GENERATION.md"],"additions":61,"deletions":0,"truncated":false},{"