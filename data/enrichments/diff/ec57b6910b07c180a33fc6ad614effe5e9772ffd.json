ed_tests,","     parametrize,","@@ -41,6 +43,7 @@","     requires_cuda_and_triton,","     requires_gpu_and_triton,"," )","+from torch.utils._triton import has_triton_stable_tma_api"," "," "," def _code_for(fn, *args, **config_kwargs):","@@ -260,6 +263,29 @@ def test_kernels_are_defined_at_module_level(self, fn):","         self.assertEqual(len(kernels), len(set(kernels)), kernels)","         self.assertIn(\"# kernel path:\", code)"," ","+    @requires_cuda_and_triton","+    @unittest.skipIf(","+        not (SM90OrLater and has_triton_stable_tma_api()) or torch.version.hip,","+        \"requires NVIDIA sm90+ with Triton tensor descriptors\",","+    )","+    def test_optional_kernel_stays_async(self):","+        x = torch.randn(4096, 4096, device=\"cuda\", dtype=torch.bfloat16)","+        result, code = _code_for(","+            torch.nn.functional.silu,","+            x,","+            assume_aligned_inputs=True,","+            max_autotune_pointwise=True,","+            **{","+                \"triton.autotune_tensor_descriptor\": \"auto\",","+                \"triton.use_tensor_descriptor\": True,","+            },","+        )","+        self.assertEqual(result, torch.nn.functional.silu(x))","+        # The baseline is defined at module level, and only the optional TMA variant stays a string for AsyncCompile.","+        self.assertTrue(re.search(r\"^def triton_\\w+\\(\", code, re.MULTILINE))","+        self.assertEqual(code.count(\"async_compile.triton(\"), 1)","+        self.assertIn(\"optional=True\", code)","+","     @requires_gpu_and_triton","     @parametrize(\"autotune_at_compile_time\", [None, True])","     def test_module_runs_from_its_file(self, autotune_at_compile_time):"],"additions":26,"deletions":0,"truncated":false},{"path":"test/inductor/test_multi_kernel.py","lines":["@@ -9,13 +9,16 @@"," import torch"," from torch import nn"," from torch._dynamo.testing import reset_rng_state","+from torch._dynamo.utils import counters"," from torch._inductor import config, test_operators","+from torch._inductor.async_compile import AsyncCompile"," from torch._inductor.codegen.multi_kernel import MultiKernelCall"," from torch._inductor.runtime.benchmarking import set_gpu_benchmark_lock_context"," from torch._inductor.test_case import TestCase"," from torch._inductor.utils import run_and_get_code"," from torch.nn import functional as F"," from torch.testing import make_tensor","+from torch.testing._internal.common_cuda import SM90OrLater"," from torch.testing._internal.common_utils import (","     instantiate_parametrized_tests,","     parametrize,","@@ -28,6 +31,7 @@","     IS_BIG_GPU,","     requires_triton,"," )","+from torch.utils._triton import has_triton_stable_tma_api"," "," "," class TransformerSnippet(nn.Module):","@@ -112,6 +116,82 @@ def kernel(index):","         }","         return multi_kernel_call"," ","+    def test_run_binds_the_picked_kernel(self):","+        events = []","+        call = self._benchmark_lock_call(events)","+        call.picked_kernel, call._recorded = 1, True","+        call.run(\"arg\")","+        self.assertIs(call.run, call._kernels[1].run)","+        # Args split across slices still need filtering, so that call stays unbound.","+        split = self._benchmark_lock_call(events)","+        split.arg_index = {i: [slice(0, 1), slice(2, 3)] for i in (0, 1)}","+        split.picked_kernel, split._recorded = 0, True","+        split.run(\"a\", \"b\", \"c\")","+        self.assertNotIn(\"run\", vars(split))","+        self.assertEqual(events, [\"run_1\", \"run_0\"])","+","+    @parametrize(\"baseline_us,picked\", [(15, 0), (30, 1)])","+    def test_tma_pick_needs_a_20us_baseline(self, baseline_us, picked):","+        call = self._benchmark_lock_call([])","+        call.multi_kernel_name = \"multi_kernel_test\"","+        call.picked_kernel, call.disable_cache, call._recorded = None, True, True","+        for kernel, meta in zip(call._kernels, ({}, {\"tma_variant\": True})):","+            kernel.inductor_meta, kernel.size_hints = meta, {\"x\": 1}","+        timings = [baseline_us / 1000, baseline_us / 1500]","+        with unittest.mock.patch.object(","+            call, \"benchmark_sub_kernels\", return_value=timings","+        ):","+            call.run(\"arg\")","+        self.assertEqual(call.picked_kernel, picked)","+","+    def test_cache_file_path_separates_coordinate_descent(self):","+        def call_with_cd(cd):","+            call = self._benchmark_lock_call([])","+            for i, kernel in enumerate(call._kernels):","+                kernel.fn = SimpleNamespace(cache_key=f\"k{i}\")","+                kernel.size_hints = {\"x\": 1}","+                kernel.triton_meta = {\"signature\": {}}","+                kernel.inductor_meta = {\"coordinate_descent_tuning\": cd and i == 0}","+            return call","+","+        self.assertNotEqual(","+            call_with_cd(False).cache_file_path(),","+            call_with_cd(True).cache_file_path(),","+        )","+        self.assertEqual(","+            call_with_cd(False).cache_file_path(),","+            call_with_cd(False).cache_file_path(),","+        )","+","+    def test_failed_subkernels_remap_args_and_skip_single_survivor_benchmark(self):","+        # A failed optional sub-kernel comes back as its exception, as one missing under no_compilation() does.","+        counters.clear()","+        with torch.compiler.precompile.no_compilation():","+            failed = AsyncCompile().triton(","+                \"triton_missing\", \"def triton_missing():\\n    pass\\n\", optional=True","+            )","+        self.assertEqual(counters[\"precompile\"][\"forbidden_compilation\"], 0)","+        events = []","+        call = self._benchmark_lock_call(events)","+        k0, k1 = call._kernels","+        call.multi_kernel_name = \"multi_kernel_test\"","+        call._kernels = [k0, failed, k1]","+        call.arg_index = {i: [slice(i, i + 1)] for i in range(3)}","+        self.assertEqual(call.kernels, [k0, k1])","+        self.assertEqual(call.arg_index, {0: [slice(0, 1)], 1: [slice(2, 3)]})","+        self.assertEqual(call._get_filtered_args((\"a\", \"b\", \"c\"), 1), [\"c\"])","+","+        single = self._benchmark_lock_call(events)","+        single.multi_kernel_name = \"multi_kernel_test\"","+        single._kernels[0] = failed","+        single.arg_index = {0: [slice(0, 1)], 1: [slice(1, 2)]}","+        single.picked_kernel, single._recorded = None, True","+        with unittest.mock.patch.object(single, \"benchmark_sub_kernels\") as benchmark:","+            single.run(\"a\", \"b\")","+        benchmark.assert_not_called()","+        self.assertEqual(single.picked_kernel, 0)","+        self.assertEqual(events, [\"run_1\"])","+","     def test_benchmark_sub_kernels_holds_gpu_lock_across_candidates(self):","         events = []","         multi_kernel_call = self._benchmark_lock_call(events)","@@ -258,6 +338,87 @@ def test_softmax(self, expect_multi_kernel=True):","         else:","             self.assertFalse(_contains_multi_kernel_code(wrapper_code))"," ","+    @requires_triton()","+    @config.patch(","+        {","+            \"bundle_triton_into_fx_graph_cache\": True,","+            \"use_static_triton_launcher\": True,","+            \"fx_graph_cache\": True,","+            \"fx_graph_remote_cache\": False,","+            \"compile_threads\": 1,","+            \"triton.multi_kernel\": 1,","+        }","+    )","+    def test_warm_fx_graph_cache(self):","+        # The warm compile rebuilds sub-kernels from the FX graph cache, and MultiKernelCall hashes their fn.cache_key.","+        from torch._inductor import codecache","+","+        x = torch.rand(2, 1024, device=GPU_TYPE)","+        ref = torch.softmax(x, -1)","+        for _ in range(2):","+            codecache.PyCodeCache.cache_clear(purge=True)","+            result, (code,) = run_and_get_code(torch.compile(torch.softmax), x, -1)","+            self.assertEqual(result, ref)","+            self.assertTrue(_contains_multi_kernel_code(code))","+        # Otherwise a cache miss on the second compile would pass without restoring any sub-kernel.","+        self.assertGreater(","+            counters[\"inductor\"][\"triton_bundler_load_static_autotuner\"], 0","+        )","+","+    @requires_triton()","+    @unittest.skipIf(","+        not (SM90OrLater and has_triton_stable_tma_api()) or torch.version.hip,","+        \"requires NVIDIA sm90+ with Triton tensor descriptors\",","+    )","+    @config.patch(","+        {","+            \"assume_aligned_inputs\": True,","+            \"compile_threads\": 2,","+            \"max_autotune_pointwise\": True,","+            \"triton.autotune_tensor_descriptor\": \"auto\",","+            \"triton.cudagraphs\": False,","+            \"triton.multi_kernel\": 0,","+            \"triton.use_tensor_descriptor\": True,","+        }","+    )","+    def test_multi_kernel_resolves_triton_futures_once(self):","+        if not AsyncCompile.wait_process_pool_ready():","+            self.skipTest(\"requires the parallel compile pool\")","+","+        def fn(x, weight):","+            scale = torch.rsqrt(x.float().pow(2).mean(-1, keepdim=True) + 1e-6)","+            return (x.float() * scale).to(x.dtype) * weight","+","+        # This decoder reduction shape reproduces duplicate resolution.","+        x = torch.randn(4096, 4096, device=GPU_TYPE, dtype=torch.bfloat16)","+        weight = torch.ones(","+            4096, device=GPU_TYPE, dtype=torch.bfloat16, requires_grad=True","+        )","+        with torch.no_grad():","+            ref = fn(x, weight)","+","+        def forward_backward(x, weight):","+            out = torch.compile(fn)(x, weight)","+            out.float().pow(2).mean().backward()","+            return out","+","+        counters.clear()","+        actual, codes = run_and_get_code(forward_backward, x, weight)","+        self.assertEqual(actual, ref)","+        self.assertTrue(any(_contains_multi_kernel_code(code) for code in codes))","+        self.assertIn(\"'tma_variant': True\", \"\\n\".join(codes))","+","+        submitted = (","+            counters[\"inductor\"][\"async_compile_cache_miss\"]","+            - counters[\"inductor\"][\"async_compile_cache_hit\"]","+        )","+        self.assertGreater(submitted, 0)","+        self.assertEqual(","+            counters[\"inductor\"][\"async_compile_triton_get_result\"],","+            submitted,","+            \"Triton future resolved more than once\",","+        )","+","     @requires_triton()","     @unittest.skipIf(not IS_BIG_GPU, \"templates require big gpu\")","     @skipIfXpu(msg=\"driver issue, torch-xpu-ops: 2295\")"],"additions":161,"deletions":0,"truncated":false},{"path":"test/inductor/test_torchinductor_strided_blocks.py","lines":["@@ -14,11 +14,16 @@"," import torch"," import torch.utils._pytree as pytree"," from torch._dynamo.debug_utils import InputReader","+from torch._dynamo.utils import counters"," from torch._inductor import config, ir, metrics"," from torch._inductor.choices import InductorChoices"," from torch._inductor.codegen.simd import SIMDScheduling"," from torch._inductor.codegen.simd_kernel_features import SIMDKernelFeatures","-from torch._inductor.codegen.triton import FixedTritonConfig, TritonKernel","+from torch._inductor.codegen.triton import (","+    FixedTritonConfig,","+    TritonKernel,","+    TritonScheduling,","+)"," from torch._inductor.runtime.hints import (","     DeviceProperties,","     ReductionHint,","@@ -28,10 +33,12 @@"," from torch._inductor.test_case import TestCase as InductorTestCase"," from torch._inductor.utils import run_and_get_code"," from torch._inductor.virtualized import V","-from torch.testing._internal.common_cuda import SM100OrLater","+from torch.testing import FileCheck","+from torch.testing._internal.common_cuda import SM100OrLater, SM90OrLater"," from torch.testing._internal.common_device_type import largeTensorTest"," from torch.testing._internal.common_utils import (","     decorateIf,","+    DeterministicGuard,","     instantiate_parametrized_tests,","     MI200_ARCH,","     NAVI_ARCH,","@@ -49,6 +56,7 @@","     TRITON_HAS_CPU,"," )"," from torch.utils._ordered_set import OrderedSet","+from torch.utils._triton import has_triton_stable_tma_api"," "," "," try:","@@ -4072,6 +4080,212 @@ def fn(x):","         self.assertNotIn(\"host_tma_descriptor_args\", \"\\n\".join(code_list))"," "," ","+@unittest.skipIf(","+    not (SM90OrLater and has_triton_stable_tma_api()) or torch.version.hip,","+    \"requires NVIDIA sm90+ with Triton tensor descriptors\",","+)","+@config.patch(","+    {","+        \"triton.use_tensor_descriptor\": True,","+        \"triton.autotune_tensor_descriptor\": \"auto\",","+        \"max_autotune_pointwise\": True,","+        \"assume_aligned_inputs\": True,","+    }","+)","+class TritonTensorDescriptorAutotuneTestCUDA(InductorTestCase):","+    def test_pool_pins(self):","+        pins = TritonScheduling.tensor_descriptor_variant_pins","+        cuda = DeviceProperties(","+            type=\"cuda\",","+            index=0,","+            multi_processor_count=1,","+            cc=90,","+            major=9,","+            warp_size=32,","+        )","+        self.assertEqual(","+            pins(cuda),","+            [","+                {\"override_tensor_descriptor\": False},","+                {\"override_tensor_descriptor\": True, \"override_host_side_tma\": True},","+            ],","+        )","+        self.assertEqual(pins(cuda._replace(cc=80, major=8)), [])","+        self.assertEqual(pins(cuda._replace(type=\"hip\")), [])","+        self.assertEqual(pins(cuda._replace(type=\"xpu\")), [])","+        with config.patch({\"triton.autotune_tensor_descriptor\": \"all\"}):","+            self.assertEqual(len(pins(cuda)), 3)","+        for patches in (","+            {\"triton.autotune_tensor_descriptor\": \"off\"},","+            {\"max_autotune_pointwise\": False},","+            {\"assume_aligned_inputs\": False},","+            {\"deterministic\": True},","+            {\"batch_invariant\": True},","+            {\"triton.multi_kernel\": 2},","+            {\"cpp_wrapper\": True},","+            {\"fx_wrapper\": True},","+        ):","+            with config.patch(patches):","+                self.assertEqual(pins(cuda), [], msg=str(patches))","+        with DeterministicGuard(True):","+            self.assertEqual(pins(cuda), [])","+","+    def test_auto_and_all_pool_contents(self):","+        def fn(x):","+            return torch.nn.functional.silu(x)","+","+        x = torch.randn(4096, 4096, dtype=torch.bfloat16, device=GPU_TYPE)","+","+        def check_pool(pool, num_kernels, num_tma):","+            with config.patch({\"triton.autotune_tensor_descriptor\": pool}):","+                result, (code,) = run_and_get_code(torch.compile(fn), x)","+            self.assertEqual(result, fn(x), exact_device=True)","+            FileCheck().check(\"async_compile.multi_kernel\").run(code)","+            FileCheck().check_count(\"@triton.jit\", num_kernels, exactly=True).run(code)","+            FileCheck().check_count(\"'tma_variant': True\", num_tma, exactly=True).run(","+                code","+            )","+            # Only the baseline keeps max-autotune's config search.","+            FileCheck().check_count(","+                \"'max_autotune_pointwise': False\", num_tma, exactly=True","+            ).run(code)","+","+        check_pool(\"auto\", 2, 1)","+        check_pool(\"all\", 3, 2)","+        # 2**23 elements is the largest kernel that gets no pool.","+        small = x[:2048]","+        result, (code,) = run_and_get_code(torch.compile(fn, dynamic=False), small)","+        self.assertEqual(result, fn(small), exact_device=True)","+        FileCheck().check_count(\"@triton.jit\", 1, exactly=True).run(code)","+        FileCheck().check_not(\"async_compile.multi_kernel\").run(code)","+","+    @config.patch({\"nvgemm_pdl\": \"auto\", \"triton.enable_pdl\": False})","+    def test_dynamic_shapes_and_pdl_consumers_skip_the_pool(self):","+        from torch._inductor.codegen.nv_universal_gemm.nv_universal_gemm_scheduling import (","+            NVUniversalGemmScheduling,","+        )","+","+        def rmsnorm(x, weight):","+            x_float = x.float()","+            scale = torch.rsqrt(x_float.pow(2).mean(-1, keepdim=True) + 1e-6)","+            return (x_float * scale).to(x.dtype) * weight","+","+        x = torch.randn(4096, 4096, device=GPU_TYPE, dtype=torch.bfloat16)","+        weight = torch.randn(4096, device=GPU_TYPE, dtype=torch.bfloat16)","+        result, (code,) = run_and_get_code(","+            torch.compile(rmsnorm, dynamic=True), x, weight","+        )","+        self.assertEqual(result, rmsnorm(x, weight), exact_device=True)","+        FileCheck().check_not(\"async_compile.multi_kernel\").run(code)","+        FileCheck().check_not(\"host_tma_descriptor_args\").check_not(","+            \"tl.make_tensor_descriptor\"","+        ).run(code)","+","+        def scale_rows(x, y):","+            return y * x.amax(-1)","+","+        y = torch.randn(4096, 4096, device=GPU_TYPE, dtype=torch.bfloat16)","+        # A PDL-enabled NVGEMM needs NVFP4 on datacenter Blackwell, so the amax kernel stands in for one.","+        with mock.patch.object(","+            NVUniversalGemmScheduling, \"is_pdl_enabled_template\", return_value=True","+        ):","+            result, (code,) = run_and_get_code(torch.compile(scale_rows), x, y)","+        self.assertEqual(result, scale_rows(x, y), exact_device=True)","+        # Only a single launch takes selective PDL, so a pooled consumer would show none.","+        FileCheck().check_count(\"'launch_pdl': True\", 1, exactly=True).run(code)","+","+    @config.patch({\"split_reductions\": False})","+    def test_mix_order_reductions_skip_the_pool(self):","+        if not config.triton.mix_order_reduction:","+            self.skipTest(\"Mix order reduction not enabled\")","+","+        def rmsnorm(x, w):","+            x_float = x.float()","+            rsqrt = torch.rsqrt((x_float * x_float).mean(-1, keepdim=True) + 1e-5)","+            return (x_float * rsqrt * w).to(x.dtype)","+","+        x = torch.randn(","+            32768, 768, device=GPU_TYPE, dtype=torch.bfloat16, requires_grad=True","+        )","+        w = torch.randn(768, device=GPU_TYPE, dtype=torch.bfloat16, requires_grad=True)","+        dy = torch.randn_like(x)","+","+        def fwd_bwd(fn):","+            x.grad = w.grad = None","+            fn(x, w).backward(dy)","+            return x.grad, w.grad","+","+        expected = fwd_bwd(rmsnorm)","+        metrics.reset()","+        result, (_, bwd_code) = run_and_get_code(fwd_bwd, torch.compile(rmsnorm))","+        self.assertEqual(result, expected, atol=1e-2, rtol=1e-2)","+        self.assertEqual(metrics.codegen_mix_order_reduction, 1)","+        # RSPLIT_SIZE marks the mix-order kernel, which no pool measures, so it keeps pointer loads.","+        FileCheck().check(\"'RSPLIT_SIZE': 'constexpr'\").check_not(","+            \"'uses_tma': True\"","+        ).check(\"@triton.jit\").run(bwd_code)","+","+    @config.patch(","+        {","+            \"triton.autotune_tensor_descriptor\": \"all\",","+            \"bundle_triton_into_fx_graph_cache\": True,","+            \"use_static_triton_launcher\": True,","+            \"fx_graph_cache\": True,","+            \"fx_graph_remote_cache\": False,","+        }","+    )","+    def test_tma_variants_that_fail_precompile_are_dropped(self):","+        from torch._inductor.codecache import PyCodeCache","+        from torch._inductor.runtime.triton_heuristics import CachingAutotuner","+","+        make_launchers = CachingAutotuner._make_launchers","+","+        def fail_tma_launchers(autotuner):","+            if autotuner.inductor_meta.get(\"tma_variant\"):","+                raise RuntimeError(\"injected TMA precompile failure\")","+            return make_launchers(autotuner)","+","+        def fn(x):","+            return torch.softmax(x, dim=-1)","+","+        x = torch.randn(4096, 4096, dtype=torch.bfloat16, device=GPU_TYPE)","+        # The second compile loads the graph from the FX graph cache, with the dropped variants bundled.","+        with mock.patch.object(CachingAutotuner, \"_make_launchers\", fail_tma_launchers):","+            for cache_hits in range(2):","+                torch._dynamo.reset()","+                PyCodeCache.cache_clear(purge=True)","+                dropped = counters[\"inductor\"][\"multi_kernel_sub_kernel_dropped\"]","+                self.assertEqual(torch.compile(fn)(x), fn(x), atol=1e-2, rtol=1.6e-2)","+                self.assertEqual(counters[\"inductor\"][\"fxgraph_cache_hit\"], cache_hits)","+                self.assertGreater(","+                    counters[\"inductor\"][\"multi_kernel_sub_kernel_dropped\"], dropped","+                )","+","+    @config.patch({\"force_disable_caches\": True})","+    def test_tma_variants_that_cannot_join_the_pool_are_dropped(self):","+        build_choices = TritonScheduling.create_kernel_choices","+        choice_counts = []","+","+        def count_choices(scheduling, *args, **kwargs):","+            choices = build_choices(scheduling, *args, **kwargs)","+            choice_counts.append(len(choices))","+            return choices","+","+        # Bool has no tensor-map dtype, so the TMA choice repeats the baseline.","+        flags = torch.randint(0, 2, (4096, 4096), dtype=torch.bool, device=GPU_TYPE)","+        metrics.reset()","+        with mock.patch.object(","+            TritonScheduling, \"create_kernel_choices\", count_choices","+        ):","+            result, (code,) = run_and_get_code(torch.compile(torch.logical_not), flags)","+        self.assertEqual(result, torch.logical_not(flags), exact_device=True)","+        # The pool was built with a TMA choice, and only the baseline was emitted and counted.","+        self.assertEqual(choice_counts, [2])","+        FileCheck().check_count(\"@triton.jit\", 1, exactly=True).run(code)","+        FileCheck().check_not(\"async_compile.multi_kernel\").run(code)","+        self.assertEqual(metrics.generated_kernel_count, 1)","+","+"," if __name__ == \"__main__\":","     from torch._inductor.test_case import run_tests"," "],"additions":216,"deletions":2,"truncated":false},{"path":"test/inductor/test_triton_heuristics.py","lines":["@@ -67,6 +67,7 @@","     _enforce_reduction_config_block_minimums,","     _find_names,","     _get_nd_pointwise_numels,","+    _maybe_filter_configs_for_tma_restrictions,","     _num_warps,","     _persistent_reduction_configs,","     _reduction_configs,","@@ -82,6 +83,7 @@","     GridExpr,","     GridND,","     make_matmul_triton_config,","+    pointwise,","     PrecomputedGrid,","     template,","     triton_config,","@@ -500,6 +502,40 @@ def test_reduction_config_budget_expansion(self, reduction_hints, budget, expect","         )","         self.assertEqual(cfg.kwargs, {\"XBLOCK\": 8, \"YBLOCK\": 4, **expected})"," ","+    def test_tma_filter_keeps_valid_first_config_once(self):","+        configs = [","+            triton.Config({\"XBLOCK\": 16}, num_warps=4),","+            triton.Config({\"XBLOCK\": 32}, num_warps=4),","+        ]","+","+        result = _maybe_filter_configs_for_tma_restrictions(","+            {\"tma_min_block_sizes\": {\"XBLOCK\": 16}}, configs","+        )","+","+        self.assertEqual(result, configs)","+","+    @parametrize(\"cc,xblock,num_warps\", [(90, 1024, 4), (100, 2048, 2), (103, 1024, 4)])","+    def test_tma_pointwise_config_is_sm100_specific(self, cc, xblock, num_warps):","+        device = DeviceProperties(","+            type=\"cuda\",","+            index=0,","+            multi_processor_count=1,","+            cc=cc,","+            major=cc // 10,","+            max_threads_per_block=1024,","+            warp_size=32,","+        )","+        configs = pointwise(","+            {\"x\"