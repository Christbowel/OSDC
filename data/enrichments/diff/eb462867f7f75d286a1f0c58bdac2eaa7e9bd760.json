getMajorVersion()","+            : VersionProperties.getBundledJdkMajorVersion();","+        return Integer.parseInt(major);","+    }","+","+    /**","+     * The architectures a JDK of the given major version is bundled for on the given platform.","+     *","+     * @param platform one of {@code linux}, {@code darwin} or {@code windows}","+     */","+    public static List<String> architecturesFor(String platform, int bundledJdkMajor) {","+        return switch (platform) {","+            case \"linux\" -> List.of(\"x64\", \"aarch64\");","+            case \"darwin\" -> bundledJdkMajor < FIRST_MAJOR_WITHOUT_DARWIN_X64 ? List.of(\"x64\", \"aarch64\") : List.of(\"aarch64\");","+            case \"windows\" -> List.of(\"x64\");","+            default -> throw new IllegalArgumentException(\"Unknown platform [\" + platform + \"]\");","+        };","+    }","+","+    /**","+     * Whether a JDK of the given major version is bundled for the given platform and architecture.","+     */","+    public static boolean isSupported(String platform, String architecture, int bundledJdkMajor) {","+        return architecturesFor(platform, bundledJdkMajor).contains(architecture);","+    }","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"build-tools-internal/src/test/java/org/elasticsearch/gradle/internal/checks/ValidateBuildGradleScriptsTaskTests.java","lines":["@@ -88,6 +88,129 @@ public void testIgnoreSuppressesViolation() throws Exception {","         assertOutputMarkerWritten(task);","     }"," ","+    @Test","+    public void testFailsForDirectBundledJdkVersionUseInDistributionScript() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(","+            project,","+            \"distribution/archives/build.gradle\",","+            List.of(\"if (Integer.parseInt(VersionProperties.bundledJdkMajorVersion) < 27) {\", \"  println 'x'\", \"}\")","+        );","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        try {","+            task.validateScripts();","+            fail(\"GradleException was expected\");","+        } catch (GradleException e) {","+            assertTrue(e.getMessage().contains(\"distribution-bundled-jdk-source-of-truth\"));","+            assertTrue(e.getMessage().contains(\"distribution/archives/build.gradle:1\"));","+        }","+    }","+","+    @Test","+    public void testFailsForClosureAssignmentInDistributionScript() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(project, \"distribution/build.gradle\", List.of(\"def architecturesFor = { String platform -> ['x64'] }\"));","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        try {","+            task.validateScripts();","+            fail(\"GradleException was expected\");","+        } catch (GradleException e) {","+            assertTrue(e.getMessage().contains(\"distribution-closure-assignment\"));","+            assertTrue(e.getMessage().contains(\"distribution/build.gradle:1\"));","+        }","+    }","+","+    @Test","+    public void testAllowsClosureAssignmentOutsideDistributionScripts() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(project, \"x-pack/build.gradle\", List.of(\"def helper = { String name -> name }\"));","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        task.validateScripts();","+","+        assertOutputMarkerWritten(task);","+    }","+","+    @Test","+    public void testFailsForExtClosureAssignmentInDistributionScript() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(project, \"distribution/docker/build.gradle\", List.of(\"ext.expansions = { Architecture architecture -> [:] }\"));","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        try {","+            task.validateScripts();","+            fail(\"GradleException was expected\");","+        } catch (GradleException e) {","+            assertTrue(e.getMessage().contains(\"distribution-ext-closure-api\"));","+            assertTrue(e.getMessage().contains(\"distribution/docker/build.gradle:1\"));","+        }","+    }","+","+    @Test","+    public void testAllowsExtClosureAssignmentOutsideDistributionScripts() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(project, \"x-pack/build.gradle\", List.of(\"ext.helper = { String name -> name }\"));","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        task.validateScripts();","+","+        assertOutputMarkerWritten(task);","+    }","+","+    @Test","+    public void testCountedIgnoreSuppressesExactlyTheBaselinedNumberOfViolations() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(","+            project,","+            \"distribution/build.gradle\",","+            List.of(\"def one = { }\", \"def two = { }\")","+        );","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+        task.getIgnore().set(java.util.Map.of(\"distribution-closure-assignment\", List.of(\"distribution/build.gradle::2\")));","+","+        task.validateScripts();","+","+        assertOutputMarkerWritten(task);","+    }","+","+    @Test","+    public void testCountedIgnoreFailsWhenAdditionalViolationIsAddedToBaselinedFile() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(","+            project,","+            \"distribution/build.gradle\",","+            List.of(\"def one = { }\", \"def two = { }\", \"def three = { }\")","+        );","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+        task.getIgnore().set(java.util.Map.of(\"distribution-closure-assignment\", List.of(\"distribution/build.gradle::2\")));","+","+        try {","+            task.validateScripts();","+            fail(\"GradleException was expected\");","+        } catch (GradleException e) {","+            assertTrue(e.getMessage().contains(\"distribution-closure-assignment\"));","+            assertTrue(e.getMessage().contains(\"distribution/build.gradle:3\"));","+        }","+    }","+","+    @Test","+    public void testCountedIgnoreFailsWhenBaselineCountBecomesStale() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(project, \"distribution/build.gradle\", List.of(\"def one = { }\"));","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+        task.getIgnore().set(java.util.Map.of(\"distribution-closure-assignment\", List.of(\"distribution/build.gradle::2\")));","+","+        try {","+            task.validateScripts();","+            fail(\"GradleException was expected\");","+        } catch (GradleException e) {","+            assertTrue(e.getMessage().contains(\"stale-ignore-entry\"));","+            assertTrue(e.getMessage().contains(\"distribution-closure-assignment -> distribution/build.gradle::2\"));","+        }","+    }","+","     @Test","     public void testFailsForStaleIgnoreEntry() throws Exception {","         Project project = createProject();","@@ -134,6 +257,21 @@ public void testBlankIgnorePathFailsClearly() throws Exception {","         }","     }"," ","+    @Test","+    public void testInvalidIgnoreCountFailsClearly() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(project, \"distribution/build.gradle\", List.of(\"def one = { }\"));","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+        task.getIgnore().set(java.util.Map.of(\"distribution-closure-assignment\", List.of(\"distribution/build.gradle::abc\")));","+","+        try {","+            task.vali