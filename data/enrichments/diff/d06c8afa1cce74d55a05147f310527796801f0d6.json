{"id":"d06c8afa1cce74d55a05147f310527796801f0d6","axis":"silent","repo":"ray-project/ray","sha":"d06c8afa1cce74d55a05147f310527796801f0d6","parsed":{"files":[{"path":"python/ray/autoscaler/_private/constants.py","lines":["@@ -81,6 +81,16 @@ def env_integer(key, default):","     \"RAY_AUTOSCALER_AVAILABILITY_RECOVERY_S\", 600"," )"," ","+# Autoscaler v2 only. If set to a non-negative value, pending worker nodes (not","+# yet running ray) that are not needed by any resource demands for longer than","+# this are terminated. It's separate from the idle timeout, since pending nodes","+# may take a while to provision and are expensive to relaunch. Disabled by","+# default (negative value): pending nodes are only terminated when they time out","+# (see RAY_AUTOSCALER_RECONCILE_ALLOCATE_STATUS_TIMEOUT_S).","+RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S = env_integer(","+    \"RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S\", -1","+)","+"," AUTOSCALER_REPORT_PER_NODE_STATUS = (","     env_integer(\"AUTOSCALER_REPORT_PER_NODE_STATUS\", 1) == 1"," )"],"additions":10,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/v2/instance_manager/config.py","lines":["@@ -16,6 +16,7 @@","     DEFAULT_UPSCALING_SPEED,","     DISABLE_LAUNCH_CONFIG_CHECK_KEY,","     DISABLE_NODE_UPDATERS_KEY,","+    RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S,"," )"," from ray.autoscaler._private.kuberay.autoscaling_config import AutoscalingConfigProducer"," from ray.autoscaler._private.monitor import BASE_READONLY_CONFIG","@@ -403,6 +404,14 @@ def get_idle_timeout_s(self) -> Optional[float]:","         idle_timeout_s = self.get_config(\"idle_timeout_minutes\", None)","         return idle_timeout_s * 60 if idle_timeout_s is not None else None"," ","+    def get_pending_idle_timeout_s(self) -> Optional[float]:","+        \"\"\"","+        Returns the idle timeout in seconds for the pending nodes not needed by any","+        resource demands, or None if they should never be terminated for it.","+        \"\"\"","+        timeout_s = RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S","+        return float(timeout_s) if timeout_s >= 0 else None","+","     def disable_launch_config_check(self) -> bool:","         provider_config = self.get_provider_config()","         return provider_config.get(DISABLE_LAUNCH_CONFIG_CHECK_KEY, True)"],"additions":9,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/v2/instance_manager/reconciler.py","lines":["@@ -1249,6 +1249,7 @@ def _scale_cluster(","             cluster_resource_constraints=ray_state.cluster_resource_constraints,","             current_instances=autoscaler_instances,","             idle_timeout_s=autoscaling_config.get_idle_timeout_s(),","+            pending_idle_timeout_s=autoscaling_config.get_pending_idle_timeout_s(),","             disable_launch_config_check=(","                 autoscaling_config.disable_launch_config_check()","             ),"],"additions":1,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/v2/scheduler.py","lines":["@@ -61,6 +61,9 @@ class SchedulingRequest:","     max_num_nodes: Optional[int] = None","     # Idle timeout in seconds.","     idle_timeout_s: Optional[float] = None","+    # Idle timeout in seconds for the pending nodes not needed by any resource","+    # demands. None to never terminate them for not being needed.","+    pending_idle_timeout_s: Optional[float] = None","     # TODO: This prob could be refactored into the ClusterStatus data class later.","     # The current ray resource requests.","     resource_requests: List[ResourceRequestByCount] = field(default_factory=list)","@@ -912,8 +915,23 @@ class ResourceDemandScheduler(IResourceScheduler):","         4. Schedule the tasks/actor resource requests","     \"\"\""," ","+    # Statuses of pending (not yet running ray) instances that could be terminated","+    # without draining ray when they are not needed. REQUESTED is excluded since","+    # an in-flight launch request can't be cancelled.","+    PENDING_TERMINABLE_STATUSES = (","+        Instance.QUEUED,","+        Instance.ALLOCATED,","+        Instance.RAY_INSTALLING,","+    )","+","     def __init__(self, event_logger: Optional[AutoscalerEventLogger] = None):","         self._event_logger = event_logger","+        # Pending instances have no idle duration reported by GCS. For each node","+        # type, the k-th entry is the monotonic time since which at least k + 1","+        # pending nodes of that type have been continuously not needed by any","+        # resource demands. It's tracked by counts rather than by instances, since","+        # pending nodes of the same type are interchangeable for scheduling.","+        self._pending_unneeded_since_s: Dict[NodeType, List[float]] = {}"," ","     @dataclass","     class ScheduleContext:","@@ -932,6 +950,9 @@ class ScheduleContext:","         _max_num_nodes: Optional[int] = None","         # The idle timeout in seconds.","         _idle_timeout_s: Optional[float] = None","+        # The idle timeout in seconds for the pending nodes not needed by any","+        # resource demands.","+        _pending_idle_timeout_s: Optional[float] = None","         # The current schedulable nodes (including pending nodes and pending requests).","         _nodes: List[SchedulingNode] = field(default_factory=list)","         # The number of nodes by node types available for launching based on the max","@@ -963,6 +984,7 @@ def __init__(","             max_num_nodes: Optional[int] = None,","             idle_timeout_s: Optional[float] = None,","             ippr_specs: Optional[IPPRSpecs] = None,","+            pending_idle_timeout_s: Optional[float] = None,","         ):","             self._nodes = nodes","             self._node_type_configs = node_type_configs","@@ -971,6 +993,7 @@ def __init__(","             )","             self._max_num_nodes = max_num_nodes","             self._idle_timeout_s = idle_timeout_s","+            self._pending_idle_timeout_s = pending_idle_timeout_s","             self._disable_launch_config_check = disable_launch_config_check","             self._ippr_specs = ippr_specs","             self._cloud_resource_availabilities = cloud_resource_availabilities","@@ -1028,6 +1051,7 @@ def from_schedule_request(","                 disable_launch_config_check=req.disable_launch_config_check,","                 max_num_nodes=req.max_num_nodes,","                 idle_timeout_s=req.idle_timeout_s,","+                pending_idle_timeout_s=req.pending_idle_timeout_s,","                 ippr_specs=req.ippr_specs,","             )"," ","@@ -1108,6 +1132,9 @@ def get_cluster_resources(self) -> Dict[str, float]:","         def get_idle_timeout_s(self) -> Optional[float]:","             return self._idle_timeout_s"," ","+        def get_pending_idle_timeout_s(self) -> Optional[float]:","+            return self._pending_idle_timeout_s","+","         def get_cloud_resource_availabilities(self) -> Dict[NodeType, float]:","             return copy.deepcopy(self._cloud_resource_availabilities)"," ","@@ -1237,9 +1264,15 @@ def schedule(self, request: SchedulingRequest) -> SchedulingReply:","             ResourceRequestUtil.ungroup_by_count(request.resource_requests),","         )"," ","+        # Pending nodes not needed by the resource demands are considered idle.","+        if ctx.get_pending_idle_timeout_s() is not None:","+            self._update_pending_nodes_idle_duration(ctx)","+","         # Shutdown any idle nodes that's not needed (e.g. no resource constraints.","         # not needed by min_worker count, etc.)","         ResourceDemandScheduler._enforce_idle_termination(ctx)","+        if ctx.get_pending_idle_timeout_s() is not None:","+            self._release_terminated_pending_nodes_idle_duration(ctx)"," ","         cluster_resources = ctx.get_cluster_resources()"," ","@@ -2105,6 +2138,93 @@ def _terminate_outdated_nodes("," ","         ctx.update(nodes)"," ","+    def _update_pending_nodes_idle_duration(","+        self,","+        ctx: \"ResourceDemandScheduler.ScheduleContext\",","+    ) -> None:","+        \"\"\"","+        Set the idle duration of the pending nodes not needed by any resource","+        demands or cluster resource constraints, so that they are subject to idle","+        termination like the running nodes.","+","+        The durations are tracked by the number of unneeded pending nodes per node","+        type rather than by instance, so they don't depend on which of the","+        interchangeable pending nodes the requests happen to be scheduled on. With","+        N unneeded pending nodes of a type, the k-th (k < N) longest duration is","+        how long at least k + 1 of them have been continuously not needed.","+","+        Args:","+            ctx: The schedule context, after all resource demands are scheduled.","+        \"\"\"","+        now_s = time.monotonic()","+        nodes = ctx.get_nodes()","+        unneeded_nodes_by_type: Dict[NodeType, List[SchedulingNode]] = defaultdict(list)","+        for node in nodes:","+            if (","+                node.status != SchedulingNodeStatus.SCHEDULABLE","+                or node.node_kind == NodeKind.HEAD","+                or node.im_instance_status","+                not in ResourceDemandScheduler.PENDING_TERMINABLE_STATUSES","+                or any(node.sched_requests.values())","+            ):","+                continue","+            unneeded_nodes_by_type[node.node_type].append(node)","+","+        unneeded_since_s: Dict[NodeType, List[float]] = {}","+        for node_type, unneeded_nodes in unneeded_nodes_by_type.items():","+            # Keep the oldest timestamps when the count drops, and start new ones","+            # when it grows. A node type without any unneeded pending nodes is","+            # dropped, which resets its durations.","+            prev_since_s = self._pending_unneeded_since_s.get(node_type, [])","+            since_s = prev_since_s[: len(unneeded_nodes)]","+            since_s += [now_s] * (len(unneeded_nodes) - len(since_s))","+            unneeded_since_s[node_type] = since_s","+","+            # Assign the longest durations to the least progressed nodes, which are","+            # the cheapest to terminate (e.g. QUEUED ones have no cloud instance).","+            unneeded_nodes.sort(","+                key=lambda n: ResourceDemandScheduler.PENDING_TERMINABLE_STATUSES.index(","+                    n.im_instance_status","+                )","+            )","+            for node, node_since_s in zip(unneeded_nodes, since_s):","+                node.idle_duration_ms = int((now_s - node_since_s) * 1000)","+","+        self._pending_unneeded_since_s = unneeded_since_s","+        ctx.update(nodes)","+","+    def _release_terminated_pending_nodes_idle_duration(","+        self,","+        ctx: \"ResourceDemandScheduler.ScheduleContext\",","+    ) -> None:","+        \"\"\"","+        Drop the idle durations taken by the pending nodes being idle terminated.","+","+        Otherwise, once the terminated nodes are gone, their (expired) durations","+        would be inherited by the remaining unneeded pending nodes of the same","+        type, which may have been unneeded for much shorter.","+","+        Only the idle terminations are released: nodes terminated for other causes","+        (e.g. outdated, max_worker_nodes) are terminated before the unneeded pending","+        nodes are counted, so they never take a duration in this round.","+","+        Args:","+            ctx: The schedule context, after idle termination is enforced.","+        \"\"\"","+        for node in ctx.get_nodes():","+            if (","+                node.termination_request is None","+                or node.termination_request.cause != TerminationRequest.Cause.IDLE","+                or node.im_instance_status","+                not in ResourceDemandScheduler.PENDING_TERMINABLE_STATUSES","+            ):","+                continue","+            # Idle termination visits the longest idle nodes first, so the ones","+            # terminated always hold the oldest timestamps of their type.","+            since_s = self._pending_unneeded_since_s.get(node.node_type)","+            if since_s:","+                since_s.pop(0)","+","     @staticmethod","     def _enforce_idle_termination(","         ctx: \"ResourceDemandScheduler.ScheduleContext\",","@@ -2122,7 +2242,12 @@ def _enforce_idle_termination("," ","         nodes = ctx.get_nodes()","         s_to_ms = 1000","-        for node in nodes:","+        # Visit the nodes in termination preference order, i.e. pending nodes and","+        # nodes idle for longer first, so that the nodes kept for min_worker_nodes","+        # are the most useful ones.","+        for node in sorted(","+            nodes, key=ResourceDemandScheduler._sort_nodes_for_termination","+        ):","             if node.status != SchedulingNodeStatus.SCHEDULABLE:","                 # We don't need to care about the non-running nodes.","                 continue","@@ -2131,12 +2256,19 @@ def _enforce_idle_termination(","                 # The head node is not subject to idle termination.","                 continue"," ","-            idle_timeout_s = ctx.get_idle_timeout_s()","-            # Override the scheduler idle_timeout_s if set for this node_type.","             node_type = node.node_type","-            if node_type in node_type_configs:","-                if node_type_configs[node_type].idle_timeout_s is not None:","-                    idle_timeout_s = node_type_configs[node_type].idle_timeout_s","+            if (","+                node.im_instance_status","+                in ResourceDemandScheduler.PENDING_TERMINABLE_STATUSES","+            ):","+                # Pending nodes have their own idle timeout.","+                idle_timeout_s = ctx.get_pending_idle_timeout_s()","+            else:","+                idle_timeout_s = ctx.get_idle_timeout_s()","+                # Override the scheduler idle_timeout_s if set for this node_type.","+                if node_type in node_type_configs:","+                    if node_type_configs[node_type].idle_timeout_s is not None:","+                        idle_timeout_s = node_type_configs[node_type].idle_timeout_s","             if idle_timeout_s is None:","                 # No idle timeout is set, skip the idle termination.","                 continue","@@ -2195,8 +2327,11 @@ def _enforce_idle_termination(","                 instance_type=node.node_type,","                 instance_status=node.im_instance_status,","                 idle_duration_ms=node.idle_duration_ms,","-                details=f\"idle for {node.idle_duration_ms/s_to_ms} secs > \"","-                f\"timeout={idle_timeout_s} secs\",","+                details=(","+                    f\"{'idle' if node.ray_node_id else 'pending and not needed'} \"","+                    f\"for {node.idle_duration_ms/s_to_ms} secs > \"","+                    f\"timeout={idle_timeout_s} secs\"","+                ),","             )"," ","         ctx.update(nodes)"],"additions":143,"deletions":8,"truncated":false},{"path":"python/ray/autoscaler/v2/tests/test_allocation_timeout_recovery.py","lines":["@@ -83,6 +83,9 @@ def disable_launch_config_check(self):","     def get_idle_timeout_s(self):","         return self._configs.get(\"idle_timeout_s\", 999)"," ","+    def get_pending_idle_timeout_s(self):","+        return self._configs.get(\"pending_idle_timeout_s\", 999)","+","     def get_provider_instance_type(self, ray_node_type):","         return \"\""," "],"additions":3,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/v2/tests/test_config.py","lines":["@@ -1,4 +1,5 @@"," # coding: utf-8","+import importlib"," import os"," import sys"," import tempfile","@@ -156,6 +157,37 @@ def test_node_type_configs():","     assert node_type_configs[\"worker_nodes1\"].labels == {\"foo\": \"bar\"}"," "," ","+@pytest.mark.parametrize(","+    \"env_value, expected\",","+    [(600, 600.0), (30, 30.0), (0, 0.0), (-1, None)],","+)","+def test_pending_idle_timeout_s(monkeypatch, env_value, expected):","+    monkeypatch.setattr(","+        config_mod, \"RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S\", env_value","+    )","+    config = FileConfigReader(","+        get_test_config_path(\"test_ray_complex.yaml\")","+    ).get_cached_autoscaling_config()","+    assert config.get_pending_idle_timeout_s() == expected","+","+","+def test_pending_idle_timeout_s_disabled_by_default(monkeypatch):","+    monkeypatch.delenv(\"RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S\", raising=False)","+    # Re-evaluate the constant without the env var set.","+    constants = importlib.reload(","+        importlib.import_module(\"ray.autoscaler._private.constants\")","+    )","+    monkeypatch.setattr(","+        config_mod,","+        \"RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S\",","+        constants.RAY_AUTOSCALER_PENDING_NODE_IDLE_TIMEOUT_S,","+    )","+    config = FileConfigReader(","+        get_test_config_path(\"test_ray_complex.yaml\")","+    ).get_cached_autoscaling_config()","+    assert config.get_pending_idle_timeout_s() is None","+","+"," def test_read_config():","     # Make a temp config file from aws/defaults.yaml","     with tempfile.NamedTemporaryFile(mode=\"w\", delete=False) as f:"],"additions":32,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/v2/tests/test_reconciler.py","lines":["@@ -83,6 +83,9 @@ def disable_launch_config_check(self):","     def get_idle_timeout_s(self):","         return self._configs.get(\"idle_timeout_s\", 999)"," ","+    def get_pending_idle_timeout_s(self):","+        return self._configs.get(\"pending_idle_timeout_s\", 999)","+","     def get_provider_instance_type(self, ray_node_type):","         return self._configs.get(\"provider_instance_types\", {}).get(ray_node_type, \"\")"," "],"additions":3,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/v2/tests/test_scheduler.py","lines":["@@ -59,6 +59,7 @@ def sched_request(","     cluster_resource_constraints: Optional[List[ResourceRequest]] = None,","     instances: Optional[List[AutoscalerInstance]] = None,","     idle_timeout_s: Optional[float] = None,","+    pending_idle_timeout_s: Optional[float] = None,","     disable_launch_config_check: Optional[bool] = False,","     ippr_specs: Optional[IPPRSpecs] = None,","     ippr_statuses: Optional[Dict[str, IPPRStatus]] = None,","@@ -98,6 +99,7 @@ def sched_request(","         node_type_configs=node_type_configs,","         max_num_nodes=max_num_nodes,","         idle_timeout_s=idle_timeout_s,","+        pending_idle_timeout_s=pending_idle_timeout_s,","         disable_launch_config_check=disable_launch_config_check,","         ippr_specs=ippr_specs,","         ippr_statuses=ippr_statuses,","@@ -1682,6 +1684,322 @@ def test_idle_termination_with_node_type_idle_timeout(node_type_idle_timeout_s):","         assert len(to_terminate) == 0"," "," ","+def _pending_instance(","+    instance_id: str, status: Instance.InstanceStatus, instance_type: str = \"type_cpu\"","+) -> AutoscalerInstance:","+    return make_autoscaler_instance(","+        im_instance=Instance(","+            instance_id=instance_id,","+            instance_type=instance_type,","+            status=status,","+            launch_config_hash=\"hash1\",","+        ),","+        cloud_instance_id=(f\"c-{instance_id}\" if status != Instance.QUEUED else None),","+    )","+","+","+def _running_instance(","+    instance_id: str, idle_duration_ms: int, instance_type: str = \"type_cpu\"","+) -> AutoscalerInstance:","+    return make_autoscaler_instance(","+        im_instance=Instance(","+            instance_id=instance_id,","+            instance_type=instance_type,","+            status=Instance.RAY_RUNNING,","+            launch_config_hash=\"hash1\",","+            node_id=f\"r-{instance_id}\",","+        ),","+        ray_node=NodeState(","+            node_id=f\"r-{instance_id}\".encode(),","+            ray_node_type_name=instance_type,","+            available_resources={\"CPU\": 1},","+            total_resources={\"CPU\": 1},","+            idle_duration_ms=idle_duration_ms,","+            status=NodeStatus.IDLE,","+        ),","+        cloud_instance_id=f\"c-{instance_id}\",","+    )","+","+","+@pytest.mark.parametrize(","+    \"status\",","+    [","+        Instance.QUEUED,","+        Instance.REQUESTED,","+        Instance.ALLOCATED,","+        Instance.RAY_INSTALLING,","+    ],","+    ids=Instance.InstanceStatus.Name,","+)","+def test_idle_termination_pending_nodes(status):","+    \"\"\"","+    Test that pending nodes not needed by any resource demands are terminated","+    after being continuously unneeded for the idle timeout, except for the","+    REQUESTED ones whose launch requests can't be cancelled.","+    \"\"\"","+    idle_timeout_s = 10","+    scheduler = ResourceDemandScheduler(event_logger)","+    node_type_configs = {","+        \"type_cpu\": NodeTypeConfig(","+            name=\"type_cpu\",","+            resources={\"CPU\": 1},","+            min_worker_nodes=0,","+            max_worker_nodes=5,","+            launch_config_hash=\"hash1\",","+        ),","+    }","+","+    def _schedule(now_s: float, resource_requests: List[ResourceRequest]):","+        request = sched_request(","+            node_type_configs=node_type_configs,","+            instances=[_pending_instance(\"i-1\", status)],","+            idle_timeout_s=idle_timeout_s,","+            pending_idle_timeout_s=idle_timeout_s,","+            # KubeRay disables the launch config check.","+            disable_launch_config_check=True,","+            resource_requests=resource_requests,","+        )","+        with patch(\"time.monotonic\", return_value=now_s):","+            return _launch_and_terminate(scheduler.schedule(request))","+","+    # Not needed, but not for long enough.","+    assert _schedule(0, []) == ({}, [])","+    assert _schedule(idle_timeout_s, []) == ({}, [])","+    # Needed again by a pending demand, which resets the idle duration.","+    assert _schedule(idle_timeout_s + 1, [ResourceRequestUtil.make({\"CPU\": 1})]) == (","+        {},","+        [],","+    )","+    assert _schedule(idle_timeout_s + 2, []) == ({}, [])","+    assert _schedule(2 * idle_timeout_s + 2, []) == ({}, [])","+","+    # Not needed since t=idle_timeout_s + 2, so it has now been continuously","+    # unneeded for idle_timeout_s + 1 secs, which exceeds the idle timeout.","+    _, to_terminate = _schedule(2 * idle_timeout_s + 3, [])","+    if status == Instance.REQUESTED:","+        assert to_terminate == []","+    else:","+        assert to_terminate == [(\"i-1\", \"\", TerminationRequest.Cause.IDLE)]","+","+","+def test_idle_termination_pending_nodes_needed_by_constraints():","+    \"\"\"","+    Test that pending nodes needed by cluster resource constraints are not","+    terminated.","+    \"\"\"","+    scheduler = ResourceDemandScheduler(event_logger)","+    node_type_configs = {","+        \"type_cpu\": NodeTypeConfig(","+            name=\"type_cpu\",","+            resources={\"CPU\": 1},","+            min_worker_nodes=0,","+            max_worker_nodes=5,","+            launch_config_hash=\"hash1\",","+        ),","+    }","+    request = sched_request(","+        node_type_configs=node_type_configs,","+        instances=[","+            _pending_instance(\"i-1\", Instance.ALLOCATED),","+            _pending_instance(\"i-2\", Instance.ALLOCATED),","+        ],","+        idle_timeout_s=1,","+        pending_idle_timeout_s=1,","+        disable_launch_config_check=True,","+        cluster_resource_constraints=[ResourceRequestUtil.make({\"CPU\": 1})],","+    )","+    for now_s in [0, 10]:","+        with patch(\"time.monotonic\", return_value=now_s):","+            _, to_terminate = _launch_and_terminate(scheduler.schedule(request))","+    # Only one of the pending nodes is needed by the constraints.","+    assert len(to_terminate) == 1","+    assert to_terminate[0][2] == TerminationRequest.Cause.IDLE","+","+","+def test_idle_termination_pending_nodes_with_min_worker():","+    \"\"\"","+    Test that the min_worker_nodes are honored when terminating the unneeded","+    pending nodes, and the pending nodes are terminated before the running ones.","+    \"\"\"","+    scheduler = ResourceDemandScheduler(event_logger)","+    node_type_configs = {","+        \"type_cpu\": NodeTypeConfig(","+            name=\"type_cpu\",","+            resources={\"CPU\": 1},","+            min_worker_nodes=2,","+            max_worker_nodes=5,","+            launch_config_hash=\"hash1\",","+        ),","+    }","+    request = sched_request(","+        node_type_configs=node_type_configs,","+        instances=[","+            _running_instance(\"i-1\", idle_duration_ms=100 * 1000),","+            _pending_instance(\"i-2\", Instance.ALLOCATED),","+            _pending_instance(\"i-3\", Instance.QUEUED),","+        ],","+        idle_timeout_s=1,","+        pending_idle_timeout_s=1,","+        disable_launch_config_check=True,","+    )","+    for now_s in [0, 10]:","+        with patch(\"time.monotonic\", return_value=now_s):","+            _, to_terminate = _launch_and_terminate(scheduler.schedule(request))","+    assert len(to_terminate) == 1","+    # All 3 nodes are idle for longer than the timeouts, but min_worker_nodes=2","+    # only allows terminating 1 of them. Idle termination visits the pending","+    # nodes (i-2, i-3) before the running one (i-1), even though i-1 has been","+    # idle for longer, so the one terminated is pending and i-1 is kept. i-2 and","+    # i-3 have been unneeded for the same duration, so either may be picked.","+    assert to_terminate[0][0] in (\"i-2\", \"i-3\")","+","+","+def _pending_idle_test_configs() -> Dict[NodeType, NodeTypeConfig]:","+    return {","+        \"type_cpu\": NodeTypeConfig(","+            name=\"type_cpu\",","+            resources={\"CPU\": 1},","+            min_worker_nodes=0,","+            max_worker_nodes=5,","+            launch_config_hash=\"hash1\",","+        ),","+    }","+","+","+def _schedule_pending_at(","+    scheduler: ResourceDemandScheduler,","+    now_s: float,","+    instance_ids: List[str],","+    num_cpu_requests: int,","+    idle_timeout_s: float,","+) -> List[str]:","+    request = sched_request(","+        node_type_configs=_pending_idle_test_configs(),","+        instances=[_pending_instance(i, Instance.ALLOCATED) for i in instance_ids],","+        idle_timeout_s=idle_timeout_s,","+        pending_idle_timeout_s=idle_timeout_s,","+        disable_launch_config_check=True,","+        resource_requests=[ResourceRequestUtil.make({\"CPU\": 1})] * num_cpu_requests,","+    )","+    with patch(\"time.monotonic\", return_value=now_s):","+        _, to_terminate = _launch_and_terminate(scheduler.schedule(request))","+    return [instance_id for instance_id, _, _ in to_terminate]","+","+","+def test_idle_termination_pending_nodes_tracked_by_node_type():","+    \"\"\"","+    Test that the idle durations of the pending nodes are tracked per node type,","+    so they don't reset when the requests land on a different pending node of","+    the same type in each round.","+    \"\"\"","+    idle_timeout_s = 10","+    scheduler = ResourceDemandScheduler(event_logger)","+","+    # One of the two pending nodes is needed by the request. The request lands on","+    # a different pending node each round, as the instance order changes.","+    assert _schedule_pending_at(scheduler, 0, [\"i-1\", \"i-2\"], 1, idle_timeout_s) == []","+    assert _schedule_pending_at(scheduler, 6, [\"i-2\", \"i-1\"], 1, idle_timeout_s) == []","+    assert _schedule_pending_at(scheduler, 11, [\"i-1\", \"i-2\"], 1, idle_timeout_s) in (","+        [\"i-1\"],","+        [\"i-2\"],","+    )","+","+","+def test_idle_termination_pending_nodes_count_changes():","+    \"\"\"","+    Test that the oldest idle durations are kept when the number of unneeded","+    pending nodes drops, and that the durations of the terminated nodes are not","+    inherited by the remaining ones.","+    \"\"\"","+    idle_timeout_s = 10","+    scheduler = ResourceDemandScheduler(event_logger)","+","+    # 2 unneeded pending nodes since t=0.","+    assert _schedule_pending_at(scheduler, 0, [\"i-1\", \"i-2\"], 0, idle_timeout_s) == []","+    # Only 1 unneeded pending node since t=5, which keeps the duration since t=0.","+    assert _schedule_pending_at(scheduler, 5, [\"i-1\", \"i-2\"], 1, idle_timeout_s) == []","+    # 2 unneeded pending nodes again, the 2nd one since t=8.","+    assert _schedule_pending_at(scheduler, 8, [\"i-1\", \"i-2\"], 0, idle_timeout_s) == []","+    # The 1st one has been unneeded since t=0 and is terminated.","+    terminated = _schedule_pending_at(scheduler, 11, [\"i-1\", \"i-2\"], 0, idle_timeout_s)","+    assert len(terminated) == 1","+    remaining = \"i-2\" if terminated == [\"i-1\"] else \"i-1\"","+    # The remaining one has only been unneeded since t=8.","+    assert _schedule_pending_at(scheduler, 12, [remaining], 0, idle_timeout_s) == []","+    assert _schedule_pending_at(scheduler, 19, [remaining], 0, idle_timeout_s) == [","+        remaining","+    ]","+","+","+def test_idle_termination_pending_nodes_after_max_workers_termination():","+    \"\"\"","+    Test that the pending nodes terminated for max_worker_nodes don't take away","+    the idle durations of the remaining unneeded pending nodes, since they are","+    terminated before the unneeded pending nodes are counted.","+    \"\"\"","+    idle_timeout_s = 10","+    scheduler = ResourceDemandScheduler(event_logger)","+","+    def _schedule(now_s: float, instance_ids: List[str], max_workers: int):","+        configs = _pending_idle_test_configs()","+        configs[\"type_cpu\"].max_worker_nodes = max_workers","+        request = sched_request(","+            node_type_configs=configs,","+            instances=[_pending_instance(i, Instance.ALLOCATED) for i in instance_ids],","+            idle_timeout_s=idle_timeout_s,","+            pending_idle_timeout_s=idle_timeout_s,","+            disable_launch_config_check=True,","+        )","+        with patch(\"time.monotonic\", return_value=now_s):","+            _, to_terminate = _launch_and_terminate(scheduler.schedule(request))","+        return to_terminate","+","+    # All 3 pending nodes are unneeded since t=0.","+    instance_ids = [\"i-1\", \"i-2\", \"i-3\"]","+    assert _schedule(0, instance_ids, max_workers=3) == []","+","+    # Lowering max_worker_nodes terminates 1 of them.","+    to_terminate = _schedule(5, instance_ids, max_workers=2)","+    assert len(to_terminate) == 1","+    assert to_terminate[0][2] == TerminationRequest.Cause.MAX_NUM_NODE_PER_TYPE","+    instance_ids.remove(to_terminate[0][0])","+","+    # Both remaining pending nodes keep their durations since t=0.","+    to_terminate = _schedule(11, instance_ids, max_workers=2)","+    assert sorted(to_terminate) == sorted(","+        (i, \"\", TerminationRequest.Cause.IDLE) for i in instance_ids","+    )","+","+","+@pytest.mark.parametrize(\"pending_idle_timeout_s\", [5, 100, None])","+def test_idle_termination_pending_nodes_timeout(pending_idle_timeout_s):","+    \"\"\"","+    Test that the pending nodes use their own idle timeout, independent of the","+    regular idle timeout, and are never terminated when it's disabled.","+    \"\"\"","+    scheduler = ResourceDemandScheduler(event_logger)","+    request = sched_request(","+        node_type_configs=_pending_idle_test_configs(),","+        instances=[","+            _running_instance(\"i-1\", idle_duration_ms=50 * 1000),","+            _pending_instance(\"i-2\", Instance.ALLOCATED),"],"additions":301,"deletions":0,"truncated":false}],"additions":502,"deletions":8,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-23T14:15:17.583978+00:00"}