{"id":"ab043e9aaaa3baa2a7b6e53c60825f41a31b9570","axis":"silent","repo":"drupal/drupal","sha":"ab043e9aaaa3baa2a7b6e53c60825f41a31b9570","parsed":{"files":[{"path":"core/config/schema/core.data_types.schema.yml","lines":["@@ -121,6 +121,22 @@ text:","       match: false","       message: 'Text is not allowed to contain control characters, only visible characters.'"," ","+# An arbitrary string of HTML.","+html_fragment:","+  type: string","+  label: 'HTML fragment'","+  constraints:","+    Html:","+      mode: fragment","+","+# A full HTML document.","+html_document:","+  type: string","+  label: 'HTML document'","+  constraints:","+    Html:","+      mode: document","+"," # A UUID."," uuid:","   type: string","@@ -164,6 +180,13 @@ machine_name:","       # @see \\Drupal\\Core\\Config\\Entity\\ConfigEntityStorage::MAX_ID_LENGTH","       max: 166"," ","+# A valid regular expression.","+regex:","+  type: string","+  label: 'Regular expression'","+  constraints:","+    ValidRegex: ~","+"," # A language identifier."," langcode:","   type: string"],"additions":23,"deletions":0,"truncated":false},{"path":"core/lib/Drupal/Core/Validation/Plugin/Validation/Constraint/HtmlConstraint.php","lines":["@@ -0,0 +1,47 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Drupal\\Core\\Validation\\Plugin\\Validation\\Constraint;","+","+use Drupal\\Core\\StringTranslation\\TranslatableMarkup;","+use Symfony\\Component\\Validator\\Constraint as SymfonyConstraint;","+use Drupal\\Core\\Validation\\Attribute\\Constraint;","+use Symfony\\Component\\Validator\\Exception\\InvalidArgumentException;","+","+/**","+ * Valid HTML constraint.","+ *","+ * Determines if a string is valid HTML5.","+ */","+#[Constraint(","+  id: 'Html',","+  label: new TranslatableMarkup('Valid HTML', [], ['context' => 'Validation'])","+)]","+class HtmlConstraint extends SymfonyConstraint {","+","+  /**","+   * Constructs an HtmlConstraint object.","+   *","+   * @param string $mode","+   *   The html parser mode, valid values are 'fragment' or 'document'.","+   * @param array|null $groups","+   *   The validation groups.","+   * @param mixed $payload","+   *   The payload.","+   *","+   * @throws \\Symfony\\Component\\Validator\\Exception\\InvalidArgumentException","+   *   Thrown when the mode is not 'fragment' or 'document'.","+   */","+  public function __construct(","+    public readonly string $mode,","+    ?array $groups = NULL,","+    mixed $payload = NULL,","+  ) {","+    if (!in_array($mode, ['fragment', 'document'], TRUE)) {","+      throw new InvalidArgumentException('Invalid HTML parsing mode. the `mode` argument must be \"fragment\" or \"document\".');","+    }","+    parent::__construct(groups: $groups, payload: $payload);","+  }","+","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"core/lib/Drupal/Core/Validation/Plugin/Validation/Constraint/HtmlConstraintValidator.php","lines":["@@ -0,0 +1,46 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Drupal\\Core\\Validation\\Plugin\\Validation\\Constraint;","+","+use Masterminds\\HTML5;","+use Symfony\\Component\\Validator\\Constraint;","+use Symfony\\Component\\Validator\\ConstraintValidator;","+use Symfony\\Component\\Validator\\Exception\\UnexpectedTypeException;","+use Symfony\\Component\\Validator\\Exception\\UnexpectedValueException;","+","+/**","+ * Validator for Html constraint.","+ */","+class HtmlConstraintValidator extends ConstraintValidator {","+","+  /**","+   * {@inheritdoc}","+   */","+  public function validate(mixed $value, Constraint $constraint): void {","+    if (!$constraint instanceof HtmlConstraint) {","+      throw new UnexpectedTypeException($constraint, HtmlConstraint::class);","+    }","+","+    if ($value === NULL) {","+      return;","+    }","+    if (!is_string($value) && !$value instanceof \\Stringable) {","+      throw new UnexpectedValueException($value, 'string|\\Stringable');","+    }","+","+    $value = (string) $value;","+    $parser = new HTML5(['disable_html_ns' => TRUE, 'encoding' => 'UTF-8']);","+","+    match ($constraint->mode) {","+      'fragment' => $parser->loadHTMLFragment($value),","+      'document' => $parser->loadHTML($value),","+    };","+","+    foreach ($parser->getErrors() as $error) {","+      $this->context->addViolation($error);","+    }","+  }","+","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"core/lib/Drupal/Core/Validation/Plugin/Validation/Constraint/ValidRegexConstraint.php","lines":["@@ -0,0 +1,27 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Drupal\\Core\\Validation\\Plugin\\Validation\\Constraint;","+","+use Drupal\\Core\\StringTranslation\\TranslatableMarkup;","+use Drupal\\Core\\Validation\\Attribute\\Constraint;","+use Symfony\\Component\\Validator\\Constraint as SymfonyConstraint;","+","+/**","+ * Determines if a string is a valid regular expression.","+ */","+#[Constraint(","+  id: 'ValidRegex',","+  label: new TranslatableMarkup('Valid regular expression', [], ['context' => 'Validation'])","+)]","+class ValidRegexConstraint extends SymfonyConstraint {","+","+  /**","+   * The error message if validation fails.","+   *","+   * @var string","+   */","+  public string $message = 'The value \"@regex\" is not a valid regular expression: @message.';","+","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"core/lib/Drupal/Core/Validation/Plugin/Validation/Constraint/ValidRegexConstraintValidator.php","lines":["@@ -0,0 +1,45 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Drupal\\Core\\Validation\\Plugin\\Validation\\Constraint;","+","+use Symfony\\Component\\Validator\\Constraint;","+use Symfony\\Component\\Validator\\ConstraintValidator;","+use Symfony\\Component\\Validator\\Exception\\UnexpectedTypeException;","+use Symfony\\Component\\Validator\\Exception\\UnexpectedValueException;","+","+/**","+ * Validator for Valid Regex constraint.","+ */","+class ValidRegexConstraintValidator extends ConstraintValidator {","+","+  /**","+   * {@inheritdoc}","+   */","+  public function validate(mixed $value, Constraint $constraint): void {","+    if (!$constraint instanceof ValidRegexConstraint) {","+      throw new UnexpectedTypeException($constraint, ValidRegexConstraint::class);","+    }","+    if ($value === NULL) {","+      return;","+    }","+","+    if (!is_string($value) && !$value instanceof \\Stringable) {","+      throw new UnexpectedValueException($value, 'string|\\Stringable');","+    }","+","+    $value = (string) $value;","+    $valid_regex = @preg_match($value, \"\") !== FALSE;","+    if (!$valid_regex || preg_last_error() !== PREG_NO_ERROR) {","+      // The violation builder uses preg_match and will clear the error, so","+      // capture it now.","+      $message = preg_last_error_msg();","+      $this->context->buildViolation($constraint->message)","+        ->setParameter('@regex', $value)","+        ->setParameter('@message', $message)","+        ->addViolation();","+    }","+  }","+","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"core/modules/system/config/schema/system.schema.yml","lines":["@@ -185,6 +185,8 @@ system.logging:"," system.performance:","   type: config_object","   label: 'Performance settings'","+  constraints:","+    FullyValidatable: ~","   mapping:","     cache:","       type: mapping","@@ -197,6 +199,11 @@ system.performance:","             max_age:","               type: integer","               label: 'Max age'","+              constraints:","+                # @see \\Drupal\\system\\Form\\PerformanceForm::buildForm()","+                Range:","+                  min: 0","+                  max: 31536000","     css:","       type: mapping","       label: 'CSS performance settings'","@@ -208,21 +215,8 @@ system.performance:","           type: boolean","           label: 'Compress CSS files'","     fast_404:","-      type: mapping","+      type: system.performance.fast_404.[enabled]","       label: 'Fast 404 settings'","-      mapping:","- 