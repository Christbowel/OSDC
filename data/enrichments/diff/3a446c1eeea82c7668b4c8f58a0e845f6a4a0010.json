{"id":"3a446c1eeea82c7668b4c8f58a0e845f6a4a0010","axis":"silent","repo":"pnpm/pnpm","sha":"3a446c1eeea82c7668b4c8f58a0e845f6a4a0010","parsed":{"files":[{"path":".changeset/install-check-footer.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pnpm\": minor","+---","+","+An install lists the dependencies that don't support the current Node.js version or platform in the checks footer above `Done in`. Each line says what the packages want, such as `✗ 15 packages want Node.js ^18.18.0 || ^20.9.0 || >=21.1.0, not 12.0.0: …`. When packages declare different Node.js ranges, the line shows the versions that satisfy all of them. pnpm no longer prints a warning for each of these packages.","+","+The `pnpm:install-check` log event of an unsupported engine or platform now carries the error `code`, the `pkgId`, and what the package wants in `wanted`. An unsupported engine event also carries the `current` versions."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install/diagnostics.rs","lines":["@@ -24,13 +24,16 @@ fn required_engine_mismatch_warns_on_fresh_and_frozen_install() {","                 String::from_utf8_lossy(&output.get_output().stderr),","             );","             eprintln!(\"{reporter}, frozen={frozen}:\\n{combined}\");","-            assert!(combined.contains(\"Unsupported engine for\"), \"{combined}\");","-            assert!(combined.contains(\"incompatible-engine\"), \"{combined}\");","             assert!(","                 fixture.workspace.join(\"node_modules/incompatible-engine/package.json\").exists(),","             );","             if reporter != \"--reporter=ndjson\" {","-                assert!(combined.contains(\"[WARN]\"), \"{combined}\");","+                assert!(","+                    combined.contains(","+                        \"✗ 1 package wants Node.js >=999.0.0, not 20.0.0: incompatible-engine@\",","+                    ),","+                    \"{combined}\",","+                );","                 continue;","             }","             let records = ndjson_records(output.get_output());","@@ -39,6 +42,8 @@ fn required_engine_mismatch_warns_on_fresh_and_frozen_install() {","                 .find(|record| record[\"name\"] == \"pnpm:install-check\")","                 .expect(\"install-check warning\");","             assert_eq!(warning[\"level\"], \"warn\");","+            assert_eq!(warning[\"code\"], \"ERR_PNPM_UNSUPPORTED_ENGINE\");","+            assert_eq!(warning[\"current\"][\"node\"], \"20.0.0\");","             let prefix = dunce::canonicalize(&fixture.workspace).unwrap();","             assert_eq!(warning[\"prefix\"], prefix.display().to_string());","             assert!("],"additions":8,"deletions":3,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state.rs","lines":["@@ -39,6 +39,7 @@ use pnpm_reporter::{","     FetchingProgressMessage,","     HookLog,","     IgnoredScriptsLog,","+    InstallCheckLog,","     InstallingConfigDepsLog,","     InstallingConfigDepsStatus,","     LifecycleMessage,","@@ -60,8 +61,10 @@ use pnpm_reporter::{","     Stage,","     StatsMessage,","     SummaryLog,","+    UnsupportedPackage,","     UnusedOverrideLog,","     UpdateCheckLog,","+    WantedPlatform,"," };"," use serde_json::Value;"," ","@@ -403,12 +406,7 @@ impl ReporterState {","             LogEvent::PendingSkills(log) => self.on_pending_skills(log),","             LogEvent::UpdateCheck(log) => self.on_update_check(log),","             LogEvent::SkippedOptionalDependency(log) => self.on_skipped_optional(log),","-            // The message names a package from the lockfile, which a contributor can edit.","-            LogEvent::InstallCheck(log) => self.on_pnpm(","-                log.level,","-                &pnpm_text_sanitize::sanitize_inline(&log.message),","-                &log.prefix,","-            ),","+            LogEvent::InstallCheck(log) => self.on_install_check(log),","             LogEvent::InstallingConfigDeps(log) => self.on_config_deps(log),","             LogEvent::LockfileVerification(log) => self.on_lockfile_verification(&log.message),","             LogEvent::Lockfile(log) => self.on_pnpm(log.level, &log.message, &log.prefix),","@@ -507,6 +505,8 @@ mod progress;"," mod summary;"," "," mod checks;","+","+mod engine_ranges;"," use checks::{","     ChecksState,","     RESOLUTION_SKIPPED,"],"additions":6,"deletions":6,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state/checks.rs","lines":["@@ -9,19 +9,24 @@"," //! with no trailing period. A command to learn more follows in"," //! `(see \"...\")`."," //!","-//! The deprecation and peer checks print nothing when they pass, as they","-//! did before the footer existed.","+//! The deprecation, peer, engine, and platform checks print nothing when","+//! they pass, as they did before the footer existed."," "," use super::{","+    BTreeMap,","     BTreeSet,","     BlockPlacement,","     BlockSlot,","     DeprecationLog,","+    InstallCheckLog,","     MaxLogLevel,","     Output,","     PeerDependencyIssuesLog,","     ReporterState,","+    UnsupportedPackage,","     Value,","+    WantedPlatform,","+    engine_ranges::merge_ranges,","     is_strictly_newer,"," };"," ","@@ -49,6 +54,12 @@ pub(super) struct ChecksState {","     peer_issues: Option<BTreeSet<String>>,","     /// `name@version` of every deprecated package resolution reported.","     deprecated: BTreeSet<String>,","+    /// The packages that reject an engine, by the engine and its current","+    /// version, then by the range they declare.","+    unsupported_engine: BTreeMap<(&'static str, String), BTreeMap<String, BTreeSet<String>>>,","+    /// The packages that reject the platform, by what they want, such as","+    /// `os darwin`.","+    unsupported_platform: BTreeMap<String, BTreeSet<String>>,","     slot: BlockSlot,","     rendered: bool,"," }","@@ -72,6 +83,41 @@ impl ReporterState {","         self.notices.checks.deprecated.insert(pkg_label(log));","     }"," ","+    pub(super) fn on_install_check(&mut self, log: &InstallCheckLog) {","+        // The package comes from the lockfile, which a contributor can edit.","+        let sanitize = |text: &str| pnpm_text_sanitize::sanitize_inline(text).into_owned();","+        let Some(unsupported) = &log.unsupported else {","+            return self.on_pnpm(log.level, &sanitize(&log.message), &log.prefix);","+        };","+        if self.options.max_log_level < MaxLogLevel::Warn {","+            return;","+        }","+        let checks = &mut self.notices.checks;","+        match unsupported {","+            UnsupportedPackage::Platform { pkg_id, wanted } => {","+                checks.unsupported_platform","+                    .entry(sanitize(&platform_requirement(wanted)))","+                    .or_default()","+                    .insert(sanitize(pkg_id));","+            }","+            UnsupportedPackage::Engine { pkg_id, wanted, current } => {","+                let engines = [","+                    (\"Node.js\", &wanted.node, &current.node),","+                    (\"pnpm\", &wanted.pnpm, &current.pnpm),","+                ];","+                for (engine, range, version) in engines {","+                    let Some(range) = range else { continue };","+                    checks.unsupported_engine","+                        .entry((engine, sanitize(version.as_deref().unwrap_or_default())))","+                        .or_default()","+                        .entry(sanitize(range))","+                        .or_default()","+                        .insert(sanitize(pkg_id));","+                }","+            }","+        }","+    }","+","     /// Print the footer when the command ends, once. A command that ends","     /// without a `Done in ...` line to carry it flushes it here.","     pub fn flush_pending_checks(&mut self, outcome: CommandOutcome) -> Output {","@@ -97,16 +143,17 @@ impl ReporterState {","             CommandOutcome::Succeeded => self.options.max_log_level >= MaxLogLevel::Info,","             CommandOutcome::Failed => false,","         };","-        let lines: Vec<String> = [","-            self.passed_line().filter(|_| shows_info),","-            self.deprecated_line(),","-            self.peer_issues_line(),","-            self.outdated_line().filter(|_| shows_info),","-            self.resolution_skipped_line().filter(|_| shows_info),","-        ]","-        .into_iter()","-        .flatten()","-        .collect();","+        let lines: Vec<String> =","+            [self.passed_line().filter(|_| shows_info), self.deprecated_line()]","+                .into_iter()","+                .chain(self.unsupported_lines().map(Some))","+                .chain([","+                    self.peer_issues_line(),","+                    self.outdated_line().filter(|_| shows_info),","+                    self.resolution_skipped_line().filter(|_| shows_info),","+                ])","+                .flatten()","+                .collect();","         (!lines.is_empty()).then(|| lines.join(\"\\n\"))","     }"," ","@@ -130,6 +177,36 @@ impl ReporterState {","         })","     }"," ","+    fn unsupported_lines(&self) -> impl Iterator<Item = String> + '_ {","+        let checks = &self.notices.checks;","+        let engines = checks.unsupported_engine","+            .iter()","+            .flat_map(|((engine, current), by_range)| {","+                merge_ranges(by_range, current)","+                    .into_iter()","+                    .map(move |(range, packages)| {","+                        (format!(\"{engine} {range}, not {current}\"), packages)","+                    })","+            });","+        let platforms = checks.unsupported_platform","+            .iter()","+            .map(|(requirement, packages)| (requirement.clone(), packages.clone()));","+        engines","+            .chain(platforms)","+            .map(|(requirement, packages)| self.unsupported_line(&requirement, &packages))","+    }","+","+    fn unsupported_line(&self, requirement: &str, packages: &BTreeSet<String>) -> String {","+        let (noun, verb) =","+            if packages.len() == 1 { (\"package\", \"wants\") } else { (\"packages\", \"want\") };","+        format!(","+            \"{} {} {noun} {verb} {requirement}: {}\",","+            self.rendering.colors.red(\"✗\"),","+            packages.len(),","+            list_names(packages, |label| self.package_label(label)),","+        )","+    }","+","     fn peer_issues_line(&self) -> Option<String> {","         let command =","             if self.options.scope.is_global { \"pnpm peers check -g\" } else { \"pnpm peers check\" };","@@ -240,6 +317,40 @@ fn pkg_label(log: &DeprecationLog) -> String {","         .into_owned()"," }"," ","+/// The declared `os`, `cpu`, and `libc` lists, such as","+/// `os darwin or linux and cpu arm64`.","+fn platform_requirement(wanted: &WantedPlatform) -> String {","+    let fields: Vec<String> = [(\"os\", &wanted.os), (\"cpu\", &wanted.cpu), (\"libc\", &wanted.libc)]","+        .into_iter()","+        .filter_map(|(field, values)| Some((field, values.as_deref()?)))","+        .filter(|(_, values)| !values.is_empty())","+        .map(|(field, values)| format!(\"{field} {}\", platform_values(values)))","+        .collect();","+    if fields.is_empty() {","+        return \"another platform\".to_string();","+    }","+    fields.join(\" and \")","+}","+","+/// The values of one platform field. A `!value` entry rejects that value,","+/// so a list of them reads `other than a or b`. A list with plain values","+/// needs one of them, which already leaves out the rejected ones.","+fn platform_values(values: &[String]) -> String {","+    let wanted: Vec<&str> = values","+        .iter()","+        .map(String::as_str)","+        .filter(|value| !value.starts_with('!'))","+        .collect();","+    if !wanted.is_empty() {","+        return wanted.join(\" or \");","+    }","+    let rejected: Vec<&str> = values","+        .iter()","+        .filter_map(|value| value.strip_prefix('!'))","+        .collect();","+    format!(\"other than {}\", rejected.join(\" or \"))","+}","+"," /// At most [`MAX_LISTED`] names, each through `paint`, then a count of"," /// the rest."," fn list_names(names: &BTreeSet<String>, paint: impl Fn(&str) -> String) -> String {"],"additions":123,"deletions":12,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state/engine_ranges.rs","lines":["@@ -0,0 +1,225 @@","+//! Merges the `engines` ranges of the packages that reject the host, so the","+//! footer prints one line per set of packages that one version satisfies.","+","+use node_semver::{","+    Range,","+    Version,","+};","+use pnpm_semver_include_prerelease::IncludePrereleaseRange;","+use std::collections::{","+    BTreeMap,","+    BTreeSet,","+};","+","+/// Packages whose ranges have a version in common.","+struct Group {","+    declared: String,","+    /// The intersection of the group's ranges. `None` when the declared","+    /// range does not parse, so the group holds only that range.","+    shared: Option<Range>,","+    merged: bool,","+    packages: BTreeSet<String>,","+}","+","+/// Groups the packages by their declared range, adding each range to the","+/// first group it has a version in common with. Each group comes with the","+/// range its line prints: the declared range of a group with one range, or","+/// the intersection of a merged group. A printed range never accepts","+/// `current`, the version the packages reject.","+pub(super) fn merge_ranges(","+    by_range: &BTreeMap<String, BTreeSet<String>>,","+    current: &str,","+) -> Vec<(String, BTreeSet<String>)> {","+    let mut groups: Vec<Group> = Vec::new();","+    for (declared, packages) in by_range {","+        let parsed = declared.parse::<Range>().ok();","+        let joined = parsed","+            .as_ref()","+            .and_then(|range| {","+                groups","+                    .iter_mut()","+                    .find_map(|group| {","+                        let shared = group.shared.as_ref()?.intersect(range)?;","+                        Some((group, shared))","+                    })","+            });","+        match joined {","+            Some((group, shared)) => {","+                group.shared = Some(shared);","+                group.merged = true;","+                group.packages.extend(packages.iter().cloned());","+            }","+            None => groups.push(Group {","+                declared: declared.clone(),","+                shared: parsed,","+                merged: false,","+                packages: packages.clone(),","+            }),","+        }","+    }","+    let current = Version::parse(current).ok();","+    groups","+        .into_iter()","+        .map(|group| group.into_line(current.as_ref()))","+        .collect()","+}","+","+impl Group {","+    /// The compact form of the range when it still rejects `current`, or","+    /// else with `-0` upper bounds, which [`Range`] drops from a declared","+    /// bound such as `<26`.","+    fn into_line(self, current: Option<&Version>) -> (String, BTreeSet<String>) {","+        let rejects_current = |range: &String| {","+            current.is_none_or(|current| !IncludePrereleaseRange::parse(range).satisfies(current))","+        };","+        let range = match &self.shared {","+            Some(shared) => {","+                let printed = shared.to_string();","+                let exact = if self.merged {","+                    printed","+                        .split(\"||\")","+                        .collect::<Vec<_>>()","+                        .join(\" || \")","+                } else {","+                    self.declared","+                };","+                [Bounds::Release, Bounds::Prerelease]","+                    .into_iter()","+                    .map(|bounds| shorten(&printed, bounds))","+                    .filter(|short| self.merged || short.len() < exact.len())","+                    .find(rejects_current)","+                    .unwrap_or(exact)","+            }","+            None => self.declared,","+        };","+        (range, self.packages)","+    }","+}","+","+/// How [`shorten`] prints an upper bound that is not part of a caret range.","+#[derive(Clone, Copy)]","+enum Bounds {","+    /// `<26.0.0`.","+    Release,","+    /// `<26.0.0-0`, which also rejects the prereleases of `26.0.0`.","+    Prerelease,","+}","+","+/// One `||` set of a range: versions from `lower` (inclusive) up to `upper`","+/// (exclusive). `None` leaves that side open.","+struct Interval {","+    lower: Option<Version>,","+    upper: Option<UpperBound>,","+}","+","+struct UpperBound {","+    version: Version,","+    /// Whether the bound was printed with `-0`, so it also excludes the","+    /// prereleases of `version`, as the bound of a caret range does.","+    excludes_prereleases: bool,","+}","+","+/// The range as [`Range`] prints it, desugared into comparators, written","+/// compactly: touching or overlapping sets are joined, a caret range is","+/// written as one again, and the `-0` of upper bounds is dropped.","+/// `>=18.0.0 <19.0.0-0||>=19.0.0 <20.0.0-0` is `>=18.0.0 <20.0.0`.","+fn shorten(range: &str, bounds: Bounds) -> String {","+    let sets: Vec<&str> = range","+        .split(\"||\")","+        .map(str::trim)","+        .collect();","+    let Some(mut intervals) = sets","+        .iter()","+        .map(|set| parse_interval(set))","+        .collect::<Option<Vec<_>>>()","+    else {","+        return sets.join(\" || \");","+    };","+    intervals.sort_by(|left, right| left.lower.cmp(&right.lower));","+    join_touching(intervals)","+        .iter()","+        .map(|interval| format_interval(interval, bounds))","+        .collect::<Vec<_>>()","+        .join(\" || \")","+}","+","+/// `None` for a set with a comparator other than `>=` and `<`, which","+/// [`shorten`] leaves as printed.","+fn parse_interval(set: &str) -> Option<Interval> {","+    let mut interval = Interval { lower: None, upper: None };","+    for comparator in set.split_whitespace() {","+        if comparator == \"*\" {","+            continue;","+        }","+        if let Some(version) = comparator.strip_prefix(\">=\") {","+            interval.lower = Some(Version::parse(version).ok()?);","+        } else if let Some(version) = comparator.strip_prefix('<')","+            && !version.starts_with('=')","+        {","+            let stripped = version.strip_suffix(\"-0\");","+            interval.upper = Some(UpperBound {","+                version: Version::parse(stripped.unwrap_or(version)).ok()?,","+                excludes_prereleases: stripped.is_some(),","+            });","+        } else {","+            return None;","+        }","+    }","+    Some(interval)","+}","+","+/// Joins each interval with the previous one when they touch or overlap.","+/// `intervals` is sorted by lower bound, an open one first.","+fn join_touching(intervals: Vec<Interval>) -> Vec<Interval> {","+    let mut joined: Vec<Interval> = Vec::new();","+    for interval in intervals {","+        let Some(last) = joined.last_mut() else {","+            joined.push(interval);","+            continue;","+        };","+        let touches = match (&last.upper, &interval.lower) {","+            (None, _) | (_, None) => true,","+            (Some(upper), Some(lower)) => *lower <= upper.version,","+        };","+        if !touches {","+            joined.push(interval);","+            continue;","+        }","+        last.upper = match (last.upper.take(), interval.upper) {","+            (Some(left), Some(right)) if left.version >= right.version => Some(left),","+            (Some(_), Some(right)) => Some(right),","+            _ => None,","+        };","+    }","+    joined","+}","+","+fn format_interval(interval: &Interval, bounds: Bounds) -> String {","+    let upper = |upper: &UpperBound| match bounds {","+        Bounds::Prerelease if upper.version.pre_release.is_empty() => {","+            format!(\"{}-0\", upper.version)","+        }","+        Bounds::Release | Bounds::Prerelease => upper.version.to_string(),","+    };","+    match (&interval.lower, &interval.upper) {","+        (Some(lower), Some(bound)) if is_caret(lower, bound) => format!(\"^{lower}\"),","+        (Some(lower), Some(bound)) => format!(\">={lower} <{}\", upper(bound)),","+        (Some(lower), None) => format!(\">={lower}\"),","+        (None, Some(bound)) => format!(\"<{}\", upper(bound)),","+        (None, None) => \"*\".to_string(),","+    }","+}","+","+/// Whether `[lower, upper)` is `^lower`.","+fn is_caret(lower: &Version, upper: &UpperBound) -> bool {","+    let bound = match (lower.major, lower.minor) {","+        (0, 0) => (0, 0, lower.patch + 1),","+        (0, minor) => (0, minor + 1, 0),","+        (major, _) => (major + 1, 0, 0),","+    };","+    let upper_version = &upper.version;","+    upper.excludes_prereleases","+        && lower.pre_release.is_empty()","+        && upper_version.pre_release.is_empty()","+        && (upper_version.major, upper_version.minor, upper_version.patch) == bound","+}"],"additions":225,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/tests/render.rs","lines":["@@ -20,12 +20,14 @@ use pnpm_reporter::{","     DedupeCheckLog,","     DependencyType,","     DeprecationLog,","+    EngineVersions,","     ExecutionTimeLog,","     FetchingProgressLog,","     FetchingProgressMessage,","     GlobalLog,","     HookLog,","     IgnoredScriptsLog,","+    InstallCheckLog,","     LifecycleLog,","     LifecycleMessage,","     LifecycleStdio,","@@ -55,8 +57,10 @@ use pnpm_reporter::{","     StatsLog,","     StatsMessage,","     SummaryLog,","+    UnsupportedPackage,","     UnusedOverrideLog,","     UpdateCheckLog,","+    WantedPlatform,"," };"," "," const CWD: &str = \"/repo\";","@@ -473,6 +477,9 @@ mod peers;"," #[path = \"render/deprecations.rs\"]"," mod deprecations;"," ","+#[path = \"render/install_checks.rs\"]","+mod install_checks;","+"," #[path = \"render/workspace_summary.rs\"]"," mod workspace_summary;"," "],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/tests/render/dependencies.rs","lines":["@@ -18,42 +18,6 @@ use super::{","     update_check,"," };"," ","-#[test]","-fn install_check_warns_at_warn_level_but_not_error_level() {","-    for (max_log_level, expected) in [","-        (super::MaxLogLevel::Warn, \"[WARN] Unsupported engine for required@1.0.0\"),","-        (super::MaxLogLevel::Error, \"\"),","-    ] {","-        let mut reporter = super::state_with_options(super::ReporterOptions {","-            max_log_level,","-            ..Default::default()","-        });","-        let frame = render(","-            &mut reporter,","-            vec![LogEvent::InstallCheck(super::PnpmLog {","-                level: LogLevel::Warn,","-                message: \"Unsupported engine for required@1.0.0\".to_string(),","-                prefix: CWD.to_string(),","-            })],","-        );","-        assert_eq!(frame, expected);","-    }","-}","-","-#[test]","-fn install_check_strips_control_characters() {","-    let mut reporter = state(false);","-    let frame = render(","-        &mut reporter,","-        vec![LogEvent::InstallCheck(super::PnpmLog {","-            level: LogLevel::Warn,","-            message: \"Unsupported engine for evil\\n\\u{1b}[2Jpkg@1.0.0\".to_string(),","-            prefix: CWD.to_string(),","-        })],","-    );","-    assert_eq!(frame, \"[WARN] Unsupported engine for evil[2Jpkg@1.0.0\");","-}","-"," #[test]"," fn summary_groups_by_dependency_type_in_order() {","     let mut reporter = state(false);"],"additions":0,"deletions":36,"truncated":false},{"path":"pnpm/crates/default-reporter/tests/render/install_checks.rs","lines":["@@ -0,0 +1,266 @@","+use super::{","+    CWD,","+    EngineVersions,","+    InstallCheckLog,","+    LogEvent,","+    LogLevel,","+    Output,","+    UnsupportedPackage,","+    WantedPlatform,","+    flush_checks,","+    render,","+    state,","+};","+","+fn install_check(message: &str, unsupported: Option<UnsupportedPackage>) -> LogEvent {","+    LogEvent::InstallCheck(InstallCheckLog {","+        level: LogLevel::Warn,","+        message: message.to_string(),","+        prefix: CWD.to_string(),","+        unsupported,","+    })","+}","+","+fn unsupported_node(pkg_id: &str, range: &str) -> LogEvent {","+    unsupported_node_on(pkg_id, range, \"26.13.0\")","+}","+","+fn unsupported_node_on(pkg_id: &str, range: &str, current: &str) -> LogEvent {","+    install_check(","+        &format!(\"Unsupported engine for {pkg_id}\"),","+        Some(UnsupportedPackage::Engine {","+            pkg_id: pkg_id.to_string(),","+            wanted: EngineVersions { node: Some(range.to_string()), pnpm: None },","+            current: EngineVersions { node: Some(current.to_string()), pnpm: None },","+        }),","+    )","+}","+","+fn unsupported_platform(pkg_id: &str, wanted: WantedPlatform) -> LogEvent {","+    install_check(","+        &format!(\"Unsupported platform for {pkg_id}\"),","+        Some(UnsupportedPackage::Platform { pkg_id: pkg_id.to_string(), wanted }),","+    )","+}","+","+fn darwin_only() -> WantedPlatform {","+    WantedPlatform { os: Some(vec![\"darwin\".to_string()]), ..Default::default() }","+}","+","+fn footer(events: Vec<LogEvent>) -> String {","+    let mut reporter = state(false);","+    let frame = render(&mut reporter, events);","+    assert_eq!(frame, \"\", \"the checks print nothing before the footer\");","+    match flush_checks(&mut reporter) {","+        Output::Frame(frame) => frame,","+        _ => String::new(),","+    }","+}","+","+#[test]","+fn footer_lists_the_packages_that_want_another_node_version() {","+    let events = [\"a@1.0.0\", \"b@2.0.0\", \"c@1.0.0\", \"d@1.0.0\", \"b@2.0.0\"]","+        .map(|pkg_id| unsupported_node(pkg_id, \">=18 <26\"))","+        .into();","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 4 packages want Node.js >=18 <26, not 26.13.0: a@1.0.0, b@2.0.0, c@1.0.0 and 1 more\\n\",","+    );","+}","+","+#[test]","+fn footer_merges_ranges_into_their_intersection() {","+    let events = [","+        (\"a@1.0.0\", \">=12.22\"),","+        (\"b@1.0.0\", \">=16.0.0\"),","+        (\"c@1.0.0\", \"^12.22.0 || ^14.17.0 || >=16.0.0\"),","+        (\"d@1.0.0\", \"^18.0.0 || >=20.0.0\"),","+        (\"e@1.0.0\", \"^18.18.0 || ^20.9.0 || >=21.1.0\"),","+    ]","+    .map(|(pkg_id, range)| unsupported_node_on(pkg_id, range, \"12.0.0\"))","+    .into();","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 5 packages want Node.js ^18.18.0 || ^20.9.0 || >=21.1.0, not 12.0.0: \\","+         a@1.0.0, b@1.0.0, c@1.0.0 and 2 more\\n\",","+    );","+}","+","+#[test]","+fn footer_keeps_bounds_that_are_not_a_caret_range() {","+    let events = vec![","+        unsupported_node(\"a@1.0.0\", \">=18.0.0 <26\"),","+        unsupported_node(\"b@1.0.0\", \">=20\"),","+        unsupported_node(\"c@1.0.0\", \"^0.10.1 || >=20.5.0\"),","+    ];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 3 packages want Node.js >=20.5.0 <26.0.0, not 26.13.0: a@1.0.0, b@1.0.0 and c@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_joins_adjacent_ranges() {","+    let events = vec![","+        unsupported_node(\"a@1.0.0\", \"^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0\"),","+        unsupported_node(\"b@1.0.0\", \">=18\"),","+        unsupported_node(\"c@1.0.0\", \"8 || 9 || 10 || 11 || 12\"),","+    ];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 1 package wants Node.js >=8.0.0 <13.0.0, not 26.13.0: c@1.0.0\\n\\","+         ✗ 2 packages want Node.js >=18.0.0 <23.0.0, not 26.13.0: a@1.0.0 and b@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_keeps_an_explicit_upper_bound_out_of_a_caret_range() {","+    let events =","+        vec![unsupported_node(\"a@1.0.0\", \">=18.0.0 <19.0.0\"), unsupported_node(\"b@1.0.0\", \">=17\")];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 2 packages want Node.js >=18.0.0 <19.0.0, not 26.13.0: a@1.0.0 and b@1.0.0\\n\",","+    );","+}","+","+/// The compact `<26.0.0` would accept the running `26.0.0-rc.1`.","+#[test]","+fn footer_keeps_prerelease_bounds_that_reject_a_prerelease_node() {","+    let events = vec![","+        unsupported_node_on(\"a@1.0.0\", \">=18 <26\", \"26.0.0-rc.1\"),","+        unsupported_node_on(\"b@1.0.0\", \">=20 <26\", \"26.0.0-rc.1\"),","+    ];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 2 packages want Node.js >=20.0.0 <26.0.0-0, not 26.0.0-rc.1: a@1.0.0 and b@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_prints_a_line_per_range_that_has_no_version_in_common() {","+    let events = vec![","+        unsupported_node(\"a@1.0.0\", \">=18 <26\"),","+        unsupported_node(\"b@1.0.0\", \">=28\"),","+        unsupported_node(\"c@1.0.0\", \">=18 <26\"),","+    ];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 2 packages want Node.js >=18 <26, not 26.13.0: a@1.0.0 and c@1.0.0\\n\\","+         ✗ 1 package wants Node.js >=28, not 26.13.0: b@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_prints_a_range_that_does_not_parse_on_its_own_line() {","+    let events = vec![","+        unsupported_node_on(\"a@1.0.0\", \"not a range\", \"12.0.0\"),","+        unsupported_node_on(\"b@1.0.0\", \">=18\", \"12.0.0\"),","+        unsupported_node_on(\"c@1.0.0\", \">=20\", \"12.0.0\"),","+    ];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 2 packages want Node.js >=20.0.0, not 12.0.0: b@1.0.0 and c@1.0.0\\n\\","+         ✗ 1 package wants Node.js not a range, not 12.0.0: a@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_lists_the_packages_that_want_another_platform() {","+    let linux_arm = WantedPlatform {","+        os: Some(vec![\"linux\".to_string(), \"android\".to_string()]),","+        cpu: Some(vec![\"arm64\".to_string()]),","+        libc: Some(Vec::new()),","+    };","+    assert_eq!(","+        footer(vec![","+            unsupported_platform(\"fsevents@2.3.3\", darwin_only()),","+            unsupported_platform(\"native@1.0.0\", linux_arm),","+            unsupported_platform(\"odd@1.0.0\", WantedPlatform::default()),","+        ]),","+        \"\\n✗ 1 package wants another platform: odd@1.0.0\\n\\","+         ✗ 1 package wants os darwin: fsevents@2.3.3\\n\\","+         ✗ 1 package wants os linux or android and cpu arm64: native@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_reads_rejected_platform_values_as_exclusions() {","+    let not_darwin_or_linux = WantedPlatform {","+        os: Some(vec![\"!darwin\".to_string(), \"!linux\".to_string()]),","+        ..Default::default()","+    };","+    assert_eq!(","+        footer(vec![unsupported_platform(\"win-only@1.0.0\", not_darwin_or_linux)]),","+        \"\\n✗ 1 package wants os other than darwin or linux: win-only@1.0.0\\n\",","+    );","+}","+","+#[test]","+fn footer_puts_engine_lines_before_platform_lines() {","+    let events = vec![","+        unsupported_platform(\"fsevents@2.3.3\", darwin_only()),","+        unsupported_node(\"old@1.0.0\", \">=99\"),","+        install_check(","+            \"Unsupported engine for tool@1.0.0\",","+            Some(UnsupportedPackage::Engine {","+                pkg_id: \"tool@1.0.0\".to_string(),","+                wanted: EngineVersions {","+                    node: Some(\">=99\".to_string()),","+                    pnpm: Some(\">=99\".to_string()),","+                },","+                current: EngineVersions {","+                    node: Some(\"26.13.0\".to_string()),","+                    pnpm: Some(\"12.0.0\".to_string()),","+                },","+            }),","+        ),","+    ];","+    assert_eq!(","+        footer(events),","+        \"\\n✗ 2 packages want Node.js >=99, not 26.13.0: old@1.0.0 and tool@1.0.0\\n\\","+         ✗ 1 package wants pnpm >=99, not 12.0.0: tool@1.0.0\\n\\","+         ✗ 1 package wants os darwin: fsevents@2.3.3\\n\",","+    );"],"additions":223,"deletions":0,"truncated":false}],"additions":599,"deletions":57,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-24T20:29:05.721869+00:00"}