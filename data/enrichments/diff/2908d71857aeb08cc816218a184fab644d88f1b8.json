{"id":"2908d71857aeb08cc816218a184fab644d88f1b8","axis":"silent","repo":"salvo-rs/salvo","sha":"2908d71857aeb08cc816218a184fab644d88f1b8","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -6,6 +6,11 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)."," "," ## [Unreleased]"," ","+### Added","+","+- Expose client certificate chains, SNI and ALPN through `Request::tls_info` for","+  Rustls and Rustls-backed HTTP/3 connections, with an mTLS authorization example.","+"," ### Changed"," "," - Raise the minimum supported Rust version to 1.95 for Salvo and its examples.","@@ -19,7 +24,6 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)."," - Cancel HTTP/3 request tasks when their connection closes or the server stops","   forcefully, while allowing accepted requests to finish on graceful shutdown."," ","-### Fixed"," - Preserve outer request extensions across direct Tower service calls, including","   failures and cancellation."," - Keep static directory slash redirects on the same origin for paths beginning","@@ -32,6 +36,8 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)."," - Fail dependency security CI on RustSec `unsound` advisories as well as","   vulnerability advisories, with an offline regression for the audit policy."," ","+- Use the same explicit crypto provider for Rustls client certificate verification","+  and server configuration, avoiding ambiguous provider selection with mTLS."," - Reject `QueryString` in `ToParameters` derives instead of producing an invalid","   schema and extracting a named query parameter. Use `Query` for named values","   or construct a whole-query parameter with `content` manually."],"additions":7,"deletions":1,"truncated":false},{"path":"README.md","lines":["@@ -176,6 +176,7 @@ salvo new my_project"," - [Official Website](https://salvo.rs)"," - [API Documentation](https://docs.rs/salvo)"," - [Examples](./examples/)","+- [mTLS authentication and certificate-based authorization](./examples/mtls-rustls/)"," - [MCP server using the Rust SDK and Tower compatibility](./examples/mcp/)"," - [Feature-specific crates](./crates/)"," "],"additions":1,"deletions":0,"truncated":false},{"path":"README.zh-hant.md","lines":["@@ -177,6 +177,7 @@ salvo new my_project"," - [官方網站](https://salvo.rs)"," - [API 文件](https://docs.rs/salvo)"," - [範例程式碼](./examples/)","+- [mTLS 認證與基於用戶端憑證的授權](./examples/mtls-rustls/)"," - [按功能拆分的 crate](./crates/)"," "," ## 推薦專案"],"additions":1,"deletions":0,"truncated":false},{"path":"README.zh.md","lines":["@@ -179,6 +179,7 @@ salvo new my_project"," - [官方网站](https://salvo.rs)"," - [API 文档](https://docs.rs/salvo)"," - [示例代码](./examples/)","+- [mTLS 认证与基于客户端证书的授权](./examples/mtls-rustls/)"," - [按功能拆分的 crate](./crates/)"," "," ## 推荐项目"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/core/Cargo.toml","lines":["@@ -153,6 +153,7 @@ zstd = { workspace = true, optional = true, features = [\"default\"] }"," nix = { workspace = true, optional = true, features = [\"fs\", \"user\"] }"," "," [dev-dependencies]","+rcgen = { workspace = true }"," tracing-test = { workspace = true }"," criterion = { workspace = true }"," fastrand = { workspace = true }"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/core/src/conn.rs","lines":["@@ -67,6 +67,8 @@ mod proto;"," pub use proto::HttpBuilder;"," mod ctrl;"," pub use ctrl::ConnCtrl;","+mod tls;","+pub use tls::TlsInfo;"," mod stream;"," pub use stream::*;"," "],"additions":2,"deletions":0,"truncated":false},{"path":"crates/core/src/conn/ctrl.rs","lines":["@@ -22,6 +22,11 @@ struct Inner {","     state: AtomicU8,","     notify: Notify,","     relax: AtomicBool,","+    // Reuse the connection state already exposed on Request. Request dispatch","+    // needs no additional extension insertion, certificate clone, or synchronization.","+    // Boxing keeps connections without TLS from reserving a full TlsInfo.","+    #[cfg(feature = \"rustls\")]","+    tls_info: std::sync::OnceLock<Box<super::TlsInfo>>,"," }"," "," impl Default for ConnCtrl {","@@ -47,10 +52,22 @@ impl ConnCtrl {","                 state: AtomicU8::new(RUNNING),","                 notify: Notify::new(),","                 relax: AtomicBool::new(false),","+                #[cfg(feature = \"rustls\")]","+                tls_info: std::sync::OnceLock::new(),","             }),","         }","     }"," ","+    #[cfg(feature = \"rustls\")]","+    pub(crate) fn set_tls_info(&self, info: super::TlsInfo) {","+        let _ = self.inner.tls_info.set(Box::new(info));","+    }","+","+    #[cfg(feature = \"rustls\")]","+    pub(crate) fn tls_info(&self) -> Option<&super::TlsInfo> {","+        self.inner.tls_info.get().map(Box::as_ref)","+    }","+","     /// Stops accepting new requests and lets accepted requests finish.","     ///","     /// A later call to [`abort`](Self::abort) escalates graceful shutdown to an"],"additions":17,"deletions":0,"truncated":false},{"path":"crates/core/src/conn/quinn/builder.rs","lines":["@@ -131,6 +131,9 @@ impl Builder {","             raw_conn.close(0u32.into(), b\"handshake timed out\");","             return Ok(());","         }","+        if let Some(tls_info) = crate::conn::TlsInfo::from_quinn(&raw_conn) {","+            conn_ctrl.set_tls_info(tls_info);","+        }","         let mut conn = self","             .inner","             .build::<salvo_http3::quinn::Connection, bytes::Bytes>(inner)"],"additions":3,"deletions":0,"truncated":false},{"path":"crates/core/src/conn/rustls/config.rs","lines":["@@ -141,7 +141,14 @@ fn alpn_protocols() -> Vec<Vec<u8>> {","     alpn_protocols"," }"," ","-/// Builder to set the configuration for the Tls server.","+/// Builder to set the configuration for the TLS server.","+///","+/// Use [`client_auth_required`](Self::client_auth_required) or","+/// [`client_auth_optional`](Self::client_auth_optional) with PEM-encoded client","+/// CA certificates to enable mTLS. After the handshake, handlers can read the","+/// client certificate chain through [`Request::tls_info`](crate::Request::tls_info)","+/// and apply application-specific authorization. Certificate authentication does","+/// not grant access to every resource automatically."," #[derive(Clone, Debug)]"," pub struct RustlsConfig {","     /// Fallback keycert.","@@ -170,10 +177,12 @@ impl RustlsConfig {","         }","     }"," ","-    /// Sets the trust anchor for optional Tls client authentication via file path.","+    /// Sets PEM-encoded client CA certificates for optional TLS authentication from a file.","     ///","     /// Anonymous and authenticated clients will be accepted. If no trust anchor is provided by any","     /// of the `client_auth_` methods, then client authentication is disabled by default.","+    /// A presented but invalid certificate is rejected during the handshake. Anonymous","+    /// requests have an empty certificate chain in [`Request::tls_info`](crate::Request::tls_info).","     pub fn client_auth_optional_path(mut self, path: impl AsRef<Path>) -> IoResult<Self> {","         let mut data = vec![];","         let mut file = File::open(path)?;","@@ -182,20 +191,24 @@ impl RustlsConfig {","         Ok(self)","     }"," ","-    /// Sets the trust anchor for optional Tls client authentication via bytes slice.","+    /// Sets PEM-encoded client CA certificates for optional TLS authentication.","     ///","     /// Anonymous and authenticated clients will be accepted. If no trust anchor is provided by any","     /// of the `client_auth_` methods, then client authentication is disabled by default.","+    /// A presented but invalid certificate is rejected during the handshake. Anonymous","+    /// requests have an empty certificate chain in [`Request::tls_info`](crate::Request::tls_info).","     #[must_use]","     pub fn client_auth_optional(mut self, trust_anchor: impl Into<Vec<u8>>) -> Self {","         self.client_auth = TlsClientAuth::Optional(trust_anchor.into());","         self","     }"," ","-    /// Sets the trust anchor for required Tls client authentication via file path.","+    /// Sets PEM-encoded client CA certificates for required TLS authentication from a file.","     ///","     /// Only authenticated clients will be accepted. If no trust anchor is provided by any of the","     /// `client_auth_` methods, then client authentication is disabled by default.","+    /// Missing or invalid certificates fail the handshake before an HTTP handler runs.","+    /// Handlers can inspect the chain using [`Request::tls_info`](crate::Request::tls_info).","     pub fn client_auth_required_path(mut self, path: impl AsRef<Path>) -> IoResult<Self> {","         let mut data = vec![];","         let mut file = File::open(path)?;","@@ -204,10 +217,12 @@ impl RustlsConfig {","         Ok(self)","     }"," ","-    /// Sets the trust anchor for required Tls client authentication via bytes slice.","+    /// Sets PEM-encoded client CA certificates for required TLS authentication.","     ///","     /// Only authenticated clients will be accepted. If no trust anchor is provided by any of the","     /// `client_auth_` methods, then client authentication is disabled by default.","+    /// Missing or invalid certificates fail the handshake before an HTTP handler runs.","+    /// Handlers can inspect the chain using [`Request::tls_info`](crate::Request::tls_info).","     #[inline]","     #[must_use]","     pub fn client_auth_required(mut self, trust_anchor: impl Into<Vec<u8>>) -> Self {","@@ -276,22 +291,29 @@ impl RustlsConfig {","             }","         }"," ","+        let provider = default_crypto_provider();","         let client_auth = match &self.client_auth {","             TlsClientAuth::Off => WebPkiClientVerifier::no_client_auth(),","             TlsClientAuth::Optional(trust_anchor) => {","-                WebPkiClientVerifier::builder(read_trust_anchor(trust_anchor)?.into())","+                WebPkiClientVerifier::builder_with_provider(","+                    read_trust_anchor(trust_anchor)?.into(),","+                    provider.clone(),","+                )","                     .allow_unauthenticated()","                     .build()","                     .map_err(|e| IoError::other(format!(\"failed to build server config: {e}\")))?","             }","             TlsClientAuth::Required(trust_anchor) => {","-                WebPkiClientVerifier::builder(read_trust_anchor(trust_anchor)?.into())","+                WebPkiClientVerifier::builder_with_provider(","+                    read_trust_anchor(trust_anchor)?.into(),","+                    provider.clone(),","+                )","                     .build()","                     .map_err(|e| IoError::other(format!(\"failed to build server config: {e}\")))?","             }","         };"," ","-        let mut config = ServerConfig::builder_with_provider(default_crypto_provider())","+        let mut config = ServerConfig::builder_with_provider(provider)","             .with_protocol_versions(self.tls_versions)","             .map_err(|e| IoError::other(format!(\"failed to build server config: {e}\")))?","             .with_client_cert_verifier(client_auth)"],"additions":30,"deletions":8,"truncated":false},{"path":"crates/core/src/conn/rustls/listener.rs","lines":["@@ -214,9 +214,15 @@ where","         let Some(tls_acceptor) = self.current_acceptor.load_full() else {","             return Err(IoError::other(\"rustls: no active tls config\"));","         };","+        let tls_conn_ctrl = conn_ctrl.clone();","+        let handshake = async move {","+            let stream = tls_acceptor.accept(stream).await?;","+            tls_conn_ctrl.set_tls_info(crate::conn::TlsInfo::from_rustls(stream.get_ref().1));","+            Ok(stream)","+        };","         Ok(Accepted {","             coupler: TcpCoupler::new(),","-            stream: HandshakeStream::new(tls_acceptor.accept(stream), fuse_config),","+            stream: HandshakeStream::new(handshake, fuse_config),","             fuse_config,","             conn_ctrl,","             local_addr,"],"additions":7,"deletions":1,"truncated":false},{"path":"crates/core/src/conn/tls.rs","lines":["@@ -0,0 +1,76 @@","+/// TLS metadata shared by all requests on a connection.","+///","+/// Retrieved with [`Request::tls_info`](crate::Request::tls_info). Certificate","+/// bytes are captured once after the handshake; reading them does not copy or","+/// parse certificates. Salvo's Rustls listener and Rustls-backed Quinn listener","+/// populate this metadata. Other TLS backends currently do not.","+#[derive(Debug)]","+pub struct TlsInfo {","+    pub(crate) peer_certificates: Vec<Vec<u8>>,","+    pub(crate) server_name: Option<String>,","+    pub(crate) alpn_protocol: Option<Vec<u8>>,","+}","+","+impl TlsInfo {","+    /// Returns the peer's DER-encoded certificate chain, leaf first.","+    ///","+    /// On the server these are the client's certificates. An empty slice means","+    /// the TLS connection has no client certificate, for example when client","+    /// authentication is disabled or an optional-authentication client is anonymous.","+    /// Verification follows the listener's TLS configuration; applications using","+    /// a custom verifier must enforce their own trust policy. With a custom","+    /// Rustls raw-public-key verifier, the single entry is a DER SubjectPublicKeyInfo","+    /// rather than an X.509 certificate, matching Rustls's `peer_certificates` API.","+    #[must_use]","+    pub fn peer_certificates(&self) -> &[Vec<u8>] {","+        &self.peer_certificates","+    }","+","+    /// Returns the server name requested through SNI, when provided by the client.","+    #[must_use]","+    pub fn server_name(&self) -> Option<&str> {","+        self.server_name.as_deref()","+    }","+","+    /// Returns the negotiated ALPN protocol, for example `b\"h2\"`.","+    #[must_use]","+    pub fn alpn_protocol(&self) -> Option<&[u8]> {","+        self.alpn_protocol.as_deref()","+    }","+","+    #[cfg(feature = \"rustls\")]","+    pub(crate) fn from_rustls(connection: &rustls::ServerConnection) -> Self {","+        Self {","+            peer_certificates: connection","+                .peer_certificates()","+                .unwrap_or_default()","+                .iter()","+                .map(|cert| cert.as_ref().to_vec())","+                .collect(),","+            server_name: connection.server_name().map(str::to_owned),","+            alpn_protocol: connection.alpn_protocol().map(<[u8]>::to_vec),","+        }","+    }","+","+    #[cfg(feature = \"quinn\")]","+    pub(crate) fn from_quinn(connection: &quinn::Connection) -> Option<Self> {","+        let handshake = connection","+            .handshake_data()?","+            .downcast::<quinn::crypto::rustls::HandshakeData>()","+            .ok()?;","+        let certificates = connection","+            .peer_identity()","+            .and_then(|identity| {","+                identity","+                    .downcast::<Vec<rustls::pki_types::CertificateDer<'static>>>()","+                    .ok()","+            })","+            .map(|chain| chain.iter().map(|cert| cert.as_ref().to_vec()).collect())","+            .unwrap_or_default();","+        Some(Self {","+            peer_certificates: certificates,","+            server_name: handshake.server_name,","+            alpn_protocol: handshake.protocol,","+        })","+    }","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"crates/core/src/http/request.rs","lines":["@@ -756,6 +756,36 @@ impl Request {","         &self.extensions","     }"," ","+    /// Borrows TLS metadata from the connection serving this request.","+    ///","+    /// Available after a successful handshake on `RustlsListener`","+    /// and Rustls-backed `QuinnListener`","+    /// connections, including TLS without client authentication. An empty","+    /// [`peer_certificates`](crate::conn::TlsInfo::peer_certificates) slice means","+    /// no client certificate was supplied. Returns `None` for plain HTTP, other","+    /// TLS backends, and requests without connection metadata (such as TestClient).","+    ///","+    /// The certificates describe the direct TLS peer. If a proxy terminates TLS,","+    /// they do not describe the original client. Reading this information performs","+    /// no certificate parsing, allocation, or certificate copying.","+    ///","+    /// ```","+    /// # use salvo_core::Request;","+    /// let req = Request::new();","+    /// assert!(req.tls_info().is_none());","+    /// ```","+    #[must_use]","+    pub fn tls_info(&self) -> Option<&crate::conn::TlsInfo> {","+        #[cfg(feature = \"rustls\")]","+        {","+            self.extensions.get::<crate::conn::ConnCtrl>()?.tls_info()","+        }","+        #[cfg(not(feature = \"rustls\"))]","+        {","+            None","+        }","+    }","+","     /// Sets the maximum allowed body size for this request.","     ///","     /// This overrides both the global default and any value set by the"],"additions":30,"deletions":0,"truncated":false},{"path":"crates/core/tests/tls_info.rs","lines":["@@ -0,0 +1,542 @@","+//! Exercise the public Request API through real sockets and TLS handshakes.","+#![cfg(all(feature = \"server\", feature = \"server-handle\", feature = \"http1\"))]","+#![allow(clippy::unwrap_used)]","+","+use std::time::Duration;","+","+use bytes::Bytes;","+use http_body_util::{BodyExt, Empty};","+use hyper_util::rt::TokioIo;","+use salvo_core::conn::{Acceptor, TcpListener};","+use salvo_core::prelude::*;","+use serde_json::{Value, json};","+use tokio::io::{AsyncRead, AsyncWrite};","+use tokio::net::TcpStream;","+","+#[handler]","+async fn inspect(req: &mut Request, res: &mut Response) {","+    res.render(Json(match req.tls_info() {","+        None => Value::Null,","+        Some(info) => json!({","+            \"certificates\": info.peer_certificates(),","+            \"sni\": info.server_name(),","+            \"alpn\": info.alpn_protocol(),","+            \"shared\": format!(\"{info:p}\"),","+        }),","+    }));","+}","+","+struct Running {","+    handle: salvo_core::server::ServerHandle,","+    task: tokio::task::JoinHandle<()>,","+}","+","+impl Running {","+    fn start<A: Acceptor + 'static>(acceptor: A) -> Self {","+        let server = Server::new(acceptor);","+        let handle = server.handle();","+        let task = tokio::spawn(server.serve(Router::new().get(inspect)));","+        Self { handle, task }","+    }","+","+    async fn stop(self) {","+        self.handle.stop_forceful();","+        tokio::time::timeout(Duration::from_secs(5), self.task)","+            .await","+            .unwrap()","+            .unwrap();","+    }","+}","+","+async fn http1<S>(stream: S) -> hyper::client::conn::http1::SendRequest<Empty<Bytes>>","+where","+    S: AsyncRead + AsyncWrite + Unpin + Send + 'static,","+{","+    let (sender, connection) = hyper::client::conn::http1::handshake(TokioIo::new(stream))","+        .await","+        .unwrap();","+    tokio::spawn(async move {","+        let _ = connection.await;","+    });","+    sender","+}","+","+fn request() -> hyper::Request<Empty<Bytes>> {","+    hyper::Request::builder()","+        .uri(\"https://localhost/\")","+        .header(\"host\", \"localhost\")","+        .body(Empty::new())","+        .unwrap()","+}","+","+async fn decode(response: hyper::Response<hyper::body::Incoming>) -> Value {","+    assert_eq!(response.status(), StatusCode::OK);","+    let bytes = response.into_body().collect().await.unwrap().to_bytes();","+    serde_json::from_slice(&bytes).unwrap()","+}","+","+#[tokio::test]","+async fn plain_http_has_no_tls_info_even_with_https_uri_or_forwarded_headers() {","+    let acceptor = TcpListener::new(\"127.0.0.1:0\").bind().await;","+    let addr = acceptor.local_addr().unwrap();","+    let server = Running::start(acceptor);","+    let mut sender = http1(TcpStream::connect(addr).await.unwrap()).await;","+    let mut req = request();","+    req.headers_mut()","+        .insert(\"x-forwarded-proto\", \"https\".parse().unwrap());","+    req.headers_mut()","+        .insert(\"x-forwarded-client-cert\", \"spoofed\".parse().unwrap());","+    assert_eq!(","+        decode(sender.send_request(req).await.unwrap()).await,","+        Value::Null","+    );","+    server.stop().await;","+}","+","+#[test]","+fn constructed_request_has_no_tls_info() {","+    assert!(Request::new().tls_info().is_none());","+}","+","+#[cfg(feature = \"rustls\")]","+mod tls {","+    use std::sync::Arc;","+","+    use rcgen::{","+        BasicConstraints, Certificate, CertificateParams, CertifiedIssuer, DnType,","+        ExtendedKeyUsagePurpose, IsCa, KeyPair, KeyUsagePurpose,","+    };","+    use rustls::pki_types::{PrivatePkcs8KeyDer, ServerName};","+    use rustls::{ClientConfig, RootCertStore};","+    use salvo_core::conn::rustls::{Keycert, RustlsConfig, default_crypto_provider};","+    use tokio_rustls::TlsConnector;","+    use tokio_rustls::client::TlsStream;","+","+    use super::*;","+","+    struct Identity {","+        certificate: Certificate,","+        key: KeyPair,","+    }","+","+    struct Pki {","+        ca: CertifiedIssuer<'static, KeyPair>,","+        intermediate: CertifiedIssuer<'static, KeyPair>,","+        server: Identity,","+        alice: Identity,","+        bob: Identity,","+    }","+","+    fn ca_params() -> CertificateParams {","+        let mut params = CertificateParams::default();","+        params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);","+        params.key_usages = vec![KeyUsagePurpose::KeyCertSign, KeyUsagePurpose::CrlSign];","+        params","+    }","+","+    fn identity(","+        name: &str,","+        usage: ExtendedKeyUsagePurpose,","+        issuer: &rcgen::Issuer<'_, KeyPair>,","+    ) -> Identity {","+        let mut params = CertificateParams::new(vec![name.to_owned()]).unwrap();","+        params.distinguished_name.push(DnType::CommonName, name);","+        params.extended_key_usages = vec![usage];","+        params.key_usages = vec![KeyUsagePurpose::DigitalSignature];","+        let key = KeyPair::generate().unwrap();","+        let certificate = params.signed_by(&key, issuer).unwrap();","+        Identity { certificate, key }","+    }","+","+    impl Pki {","+        fn new() -> Self {","+            let mut params = ca_params();","+            params","+                .distinguished_name","+                .push(DnType::CommonName, \"test root\");","+            let ca = CertifiedIssuer::self_signed(params, KeyPair::generate().unwrap()).unwrap();","+            let mut params = ca_params();","+            params","+                .distinguished_name","+                .push(DnType::CommonName, \"test intermediate\");","+            let intermediate =","+                CertifiedIssuer::signed_by(params, KeyPair::generate().unwrap(), &ca).unwrap();","+            let server = identity(\"localhost\", ExtendedKeyUsagePurpose::ServerAuth, &ca);","+            let alice = identity(\"alice\", ExtendedKeyUsagePurpose::ClientAuth, &intermediate);","+            let bob = identity(\"bob\", ExtendedKeyUsagePurpose::ClientAuth, &intermediate);","+            Self {","+                ca,","+                intermediate,","+                server,","+                alice,","+                bob,","+            }","+        }","+","+        fn config(&self) -> RustlsConfig {","+            RustlsConfig::new(","+                Keycert::new()","+                    .cert(self.server.certificate.pem())","+                    .key(self.server.key.serialize_pem()),","+            )","+        }","+","+        fn client(&self, identity: Option<(&Identity, &Self)>, alpn: &[u8]) -> ClientConfig {","+            let mut roots = RootCertStore::empty();","+            roots.add(self.ca.der().clone()).unwrap();","+            let builder = ClientConfig::builder_with_provider(default_crypto_provider())","+                .with_safe_default_protocol_versions()","+                .unwrap()","+                .with_root_certificates(roots);","+            let mut client = match identity {","+                Some((identity, issuer)) => builder","+                    .with_client_auth_cert(","+                        vec![","+                            identity.certificate.der().clone(),","+                            issuer.intermediate.der().clone(),","+                        ],","+                        PrivatePkcs8KeyDer::from(identity.key.serialize_der()).into(),","+                    )","+                    .unwrap(),","+                None => builder.with_no_client_auth(),","+            };","+            client.alpn_protocols = vec![alpn.to_vec()];","+            client","+        }","+    }","+","+    async fn connect(","+        addr: std::net::SocketAddr,","+        client: ClientConfig,","+    ) -> Result<TlsStream<TcpStream>, std::io::Error> {","+        TlsConnector::from(Arc::new(client))","+            .connect(","+                ServerName::try_from(\"localhost\").unwrap(),","+                TcpStream::connect(addr).await?,","+            )","+            .await","+    }","+","+    fn assert_info(info: &Value, pki: &Pki, identity: Option<&Identity>, alpn: &[u8]) {","+        assert_eq!(info[\"sni\"], \"localhost\");","+        assert_eq!(info[\"alpn\"], json!(alpn));","+        let expected = identity","+            .map(|identity| {","+                vec![","+                    identity.certificate.der().to_vec(),","+                    pki.intermediate.der().to_vec(),","+                ]","+            })","+            .unwrap_or_default();","+        assert_eq!(info[\"certificates\"], json!(expected));","+    }","+","+    #[test]","+    fn optional_and_required_auth_do_not_need_a_process_default_provider() {","+        // This integration test binary never installs a provider. Its dev-dependencies","+      