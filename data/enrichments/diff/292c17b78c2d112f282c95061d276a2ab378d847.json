r link is equally fresh, so ignore the failure and run from","-    // our own prepare dir.","-    let _ = force_symlink_dir(&prepare_dir, cache_link);","     Ok(prepare_dir)"," }"," ","+fn link_prepared_cache_dir(","+    prepare_dir: &Path,","+    cache_link: &Path,","+    config: &Config,","+) -> miette::Result<()> {","+    let mut last_error = None;","+    for attempt in 1..=5_u64 {","+        match force_symlink_dir(prepare_dir, cache_link) {","+            Ok(_) => return Ok(()),","+            Err(error) => {","+                if let Some(linked_dir) =","+                    get_valid_cache_dir(cache_link, config.dlx_cache_max_age, SystemTime::now())","+                    && linked_dir.join(\"pnpm-lock.yaml\").is_file()","+                    && !direct_builds::has_pending_direct_non_registry_builds(config, &linked_dir)?","+                {","+                    return Ok(());","+                }","+                last_error = Some(error);","+                if attempt < 5 {","+                    std::thread::sleep(Duration::from_millis(attempt * 50));","+                }","+            }","+        }","+    }","+    Err(DlxError::Cache {","+        dir: cache_link.display().to_string(),","+        source: last_error.expect(\"link loop runs at least once\"),","+    }","+    .into())","+}","+"," /// Install `pkgs` into `prepare_dir` so their bins land in"," /// `<prepare_dir>/node_modules/.bin`. Anchors `config` at the cache"," /// directory (the `dir` / `lockfileDir` / `bin` overrides) and saves each","@@ -57,7 +91,7 @@ async fn install_into_cache<Reporter: self::Reporter + 'static>(","     allow_build: &[AllowBuildSelector<'_>],","     supported_architectures: &SupportedArchitecturesArgs,","     config: &'static mut Config,","-) -> miette::Result<()> {","+) -> miette::Result<&'static Config> {","     fs::create_dir_all(prepare_dir)","         .map_err(|source| DlxError::Cache { dir: prepare_dir.display().to_string(), source })?;","     let manifest_path = prepare_dir.join(\"package.json\");","@@ -65,7 +99,7 @@ async fn install_into_cache<Reporter: self::Reporter + 'static>(","         .map_err(|source| DlxError::Cache { dir: manifest_path.display().to_string(), source })?;"," ","     configure_cache_install(config, prepare_dir, pkgs, allow_build, supported_architectures)?;","-    let config: &Config = config;","+    let config: &'static Config = config;"," ","     for pkg in pkgs {","         let state = State::init(manifest_path.clone(), config, false)","@@ -84,15 +118,23 @@ async fn install_into_cache<Reporter: self::Reporter + 'static>(","         )","         .await?;","     }","+    let config = direct_builds::rebuild_direct_non_registry_packages::<Reporter>(","+        config,","+        prepare_dir,","+        &manifest_path,","+    )","+    .await?;","     crate::cli_args::approve_builds::prompt_approve_install_builds::<Reporter>(","         config,","         prepare_dir,","         crate::cli_args::approve_builds::ApprovalStore::Workspace(prepare_dir),","     )","     .await?;","-    Ok(())","+    Ok(config)"," }"," ","+mod direct_builds;","+"," /// The command's cache directory, created and canonicalized so the prepare"," /// dir carries no `..` segments. A relative `cacheDir` (e.g. `../pnpm-cache`)"," /// would otherwise let the install's workspace-root walk pass through the","@@ -230,36 +272,6 @@ pub(super) fn read_json(path: &Path) -> Result<Value, DlxError> {","         })"," }"," ","-/// Drop workspace-manifest resolution mutations (`overrides`,","-/// `packageExtensions`, `blockExoticSubdeps`) unless supplied via CLI flags or","-/// `PNPM_CONFIG_*` environment variables, then expand `catalog:` overrides.","-fn isolate_dlx_caller_settings(config: &mut Config) -> miette::Result<()> {","-    let mut env_settings =","-        pnpm_config::TrustedSettings::from_pnpm_config_env::<pnpm_config::Host>();","-    env_settings.substitute_env_trusted_lossy::<pnpm_config::Host>();","-    let cli = &config.cli.setting_values;","-    let cli_overrides = cli","-        .get(\"overrides\")","-        .and_then(|raw| serde_json::from_str(raw).ok());","-    let cli_extensions = cli","-        .get(\"package-extensions\")","-        .or_else(|| cli.get(\"packageExtensions\"))","-        .and_then(|raw| serde_json::from_str(raw).ok());","-    let cli_block_exotic = cli","-        .get(\"block-exotic-subdeps\")","-        .or_else(|| cli.get(\"blockExoticSubdeps\"))","-        .and_then(|raw| serde_json::from_str(raw).ok());","-    config.overrides = cli_overrides","-        .or(env_settings.settings.overrides)","-        .filter(|map| !map.is_empty());","-    config.package_extensions = cli_extensions","-        .or(env_settings.settings.package_extensions)","-        .filter(|map| !map.is_empty());","-    config.block_exotic_subdeps =","-        cli_block_exotic.or(env_settings.settings.block_exotic_subdeps).unwrap_or(true);","-    resolve_cache_overrides(config)","-}","-"," /// Resolve caller catalogs before the cache install severs its workspace anchor."," fn resolve_cache_overrides(config: &mut Config) -> miette::Result<()> {","     if let Some(overrides) = config.overrides.as_ref()","@@ -385,37 +397,38 @@ pub(super) async fn get_or_prepare_cache<Reporter: self::Reporter + 'static>(","     supported_architectures: &SupportedArchitecturesArgs,"," ) -> miette::Result<PathBuf> {","     let parsed_allow_build = parse_allow_build_selectors(allow_build)?;","-    isolate_dlx_caller_settings(config)?;","+    resolve_cache_overrides(config)?;","     let command_dir =","         command_cache_dir(config, pkgs, &parsed_allow_build, supported_architectures)?;","     let cache_link = command_dir.join(\"pkg\");","-    match get_valid_cache_dir(&cache_link, config.dlx_cache_max_age, SystemTime::now()) {","-        Some(cached_dir) if cached_dir.join(\"pnpm-lock.yaml\").is_file() => {","-            configure_cache_install(","-                config,","-                &cached_dir,","-                pkgs,","-                &parsed_allow_build,","-                supported_architectures,","-            )?;","+    if let Some(cached_dir) =","+        get_valid_cache_dir(&cache_link, config.dlx_cache_max_age, SystemTime::now())","+        && cached_dir.join(\"pnpm-lock.yaml\").is_file()","+    {","+        configure_cache_install(","+            config,","+            &cached_dir,","+            pkgs,","+            &parsed_allow_build,","+            supported_architectures,","+        )?;","+        if !direct_builds::has_pending_direct_non_registry_builds(config, &cached_dir)? {","             crate::cli_args::approve_builds::prompt_approve_install_builds::<Reporter>(","                 config,","                 &cached_dir,","                 crate::cli_args::approve_builds::ApprovalStore::Workspace(&cached_dir),","             )","             .await?;","-            Ok(cached_dir)","-        }","-        _ => {","-            prepare_cache_dir::<Reporter>(","-                &command_dir,","-                &cache_link,","-                pkgs,","-                &parsed_allow_build,","-                supported_architectures,","-                config,","-            )","-            .await","+            return Ok(cached_dir);","         }","     }","+    prepare_cache_dir::<Reporter>(","+        &command_dir,","+        &cache_link,","+        pkgs,","+        &parsed_allow_build,","+        supported_architectures,","+        config,","+    )","+    .await"," }"],"additions":76,"deletions":63,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dlx/cache/direct_builds.rs","lines":["@@ -0,0 +1,149 @@","+use crate::State;","+use miette::{Context as _, IntoDiagnostic as _};","+use pnpm_config::Config;","+use pnpm_lockfile::{Lockfile, ResolvedDependencyMap};","+use pnpm_modules_yaml::{Host as ModulesHost, read_modules_manifest, write_modules_manifest};","+use pnpm_package_manager::allow_build_key_from_ignored_build;","+use pnpm_reporter::Reporter;","+use std::path::Path;","+","+pub(super) fn has_pending_direct_non_registry_builds(","+    config: &Config,","+    cache_dir: &Path,","+) -> miette::Result<bool> {","+    if config.ignore_scripts {","+        return Ok(false);","+    }","+    let Some(modules) =","+        read_modules_manifest::<ModulesHost>(&cache_dir.join(\"node_modules\")).into_diagnostic()?","+    else {","+        return Ok(false);","+    };","+    let Some(ignored) = modules.ignored_builds","+        .as_ref()","+        .filter(|keys| !keys.is_empty())","+    else {","+        return Ok(false);","+    };","+    let ignored_keys: Vec<String> = ignored","+        .iter()","+        .map(|dep_path| allow_build_key_from_ignored_build(dep_path.as_str()))","+        .collect();","+    Ok(!approved_direct_build_keys(config, cache_dir, &ignored_keys)?.is_empty())","+}","+","+/// Approve and rebuild explicitly requested top-level `dlx` packages whose","+/// non-semver specifiers (`http(s):`, `file:`, `git+`, ...) have no package","+/// alias before fetching or require exact `depPath` approval.","+pub(super) async fn rebuild_direct_non_registry_packages<Reporter: self::Reporter + 'static>(","+    config: &'static Config,","+    prepare_dir: &Path,","+    manifest_path: &Path,","+) -> miette::Result<&'static Config> {","+    if config.ignore_scripts {","+        return Ok(config);","+    }","+    let scan = crate::cli_args::ignored_builds::get_automatically_ignored_builds(config)?;","+    let Some(ignored_keys) = scan.names","+        .as_deref()","+        .filter(|keys| !keys.is_empty())","+    else {","+        return Ok(config);","+    };","+    let approved_keys = approved_direct_build_keys(config, prepare_dir, ignored_keys)?;","+    if approved_keys.is_empty() {","+        return Ok(config);","+    }","+    let config = leak_config_with_approved_builds(config, &approved_keys);","+    let rebuild_state = State::init(manifest_path.to_path_buf(), config, true)","+        .wrap_err(\"initialize the dlx rebuild state\")?;","+    let selection = crate::cli_args::rebuild::RebuildSelection {","+        names: Some(approved_keys.clone()),","+        projects: Vec::new(),","+    };","+    crate::cli_args::rebuild::run_rebuild::<Reporter>(&rebuild_state, selection, None).await?;","+    persist_pruned_ignored_builds(&scan.modules_dir, &approved_keys)?;","+    Ok(config)","+}","+","+fn approved_direct_build_keys(","+    config: &Config,","+    prepare_dir: &Path,","+    ignored_keys: &[String],","+) -> miette::Result<Vec<String>> {","+    let Some(lockfile) = Lockfile::load_wanted_from_dir(prepare_dir)","+        .into_diagnostic()","+        .wrap_err(\"read the dlx cache lockfile\")?","+    else {","+        return Ok(Vec::new());","+    };","+    let Some(direct_deps) =","+        lockfile.importers.get(\".\").and_then(|importer| importer.dependencies.as_ref())","+    else {","+        return Ok(Vec::new());","+    };","+    collect_direct_build_keys(config, direct_deps, ignored_keys)","+}","+","+fn collect_direct_build_keys(","+    config: &Config,","+    direct_deps: &ResolvedDependencyMap,","+    ignored_keys: &[String],","+) -> miette::Result<Vec<String>> {","+    let policy = pnpm_deps_restorer::AllowBuildPolicy::from_config(config).into_diagnostic()?;","+    let mut approved = Vec::new();","+    for (alias, dep) in direct_deps {","+        if config.allow_builds.get(&alias.to_string()) == Some(&false) {","+            continue;","+        }","+        let Some(dep_path) = dep.version.resolved_key(alias).map(|key| key.to_string()) else {","+            continue;","+        };","+        if policy.check(&dep_path) == Some(false) {","+            continue;","+        }","+        let allow_key = allow_build_key_from_ignored_build(&dep_path);","+        let is_non_registry = allow_key == pnpm_deps_restorer::normalize_build_dep_path(&dep_path);","+        if is_non_registry && ignored_keys.contains(&allow_key) && !approved.contains(&allow_key) {","+            approved.push(allow_key);","+        }","+    }","+    approved.sort();","+    Ok(approved)","+}","+","+fn leak_config_with_approved_builds(","+    config: &Config,","+    approved_keys: &[String],","+) -> &'static mut Config {","+    let mut updated = config.clone();","+    for key in approved_keys {","+        updated.allow_builds.insert(key.clone(), true);","+    }","+    Config::leak(updated)","+}","+","+fn persist_pruned_ignored_builds(","+    modules_dir: &Path,","+    approved_keys: &[String],","+) -> miette::Result<()> {","+    let Some(mut modules) = read_modules_manifest::<ModulesHost>(modules_dir).into_diagnostic()?","+    else {","+        return Ok(());","+    };","+    let Some(ignored) = modules.ignored_builds.as_mut() else {","+        return Ok(());","+    };","+    let before = ignored.len();","+    ignored.retain(|dep_path| {","+        let key = allow_build_key_from_ignored_build(dep_path.as_str());","+        !approved_keys.contains(&key)","+    });","+    if ignored.len() == before {","+        return Ok(());","+    }","+    if ignored.is_empty() {","+        modules.ignored_builds = None;","+    }","+    write_modules_manifest::<ModulesHost>(modules_dir, modules).into_diagnostic()","+}"],"additions":149,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dlx/cache/key.rs","lines":["@@ -28,6 +28,7 @@ pub(in crate::cli_args::dlx) struct CachePolicyInputs<'a> {","     pub trust_policy: Option<TrustPolicyInput<'a>>,","     pub trust_lockfile: bool,","     pub block_exotic_subdeps: bool,","+    pub ignore_scripts: bool,"," }"," "," impl Default for CachePolicyInputs<'_> {","@@ -39,12 +40,13 @@ impl Default for CachePolicyInputs<'_> {","             trust_policy: None,","             trust_lockfile: false,","             block_exotic_subdeps: true,","+            ignore_scripts: false,","         }","     }"," }"," "," impl<'a> CachePolicyInputs<'a> {","-    pub(super) fn from_config(config: &'a Config) -> Self {","+    pub(in 