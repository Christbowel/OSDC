{"id":"292c17b78c2d112f282c95061d276a2ab378d847","axis":"silent","repo":"pnpm/pnpm","sha":"292c17b78c2d112f282c95061d276a2ab378d847","parsed":{"files":[{"path":".changeset/dlx-cache-and-direct-url-builds.md","lines":["@@ -0,0 +1,15 @@","+---","+\"@pnpm/config.reader\": patch","+\"@pnpm/exec.commands\": patch","+\"@pnpm/global.commands\": patch","+\"@pnpm/installing.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm dlx`, `pnx`, and `pnpm create` now handle local isolation, script skipping, and non-registry package specifiers consistently:","+","+- `pnpm` ignores local `.pnpmfile.cjs` hooks and project `.npmrc` proxy or TLS settings in the working directory.","+- Running with `--ignore-scripts` or `ignoreScripts: true` uses a separate `dlx` cache key, keeping cached installs that skipped build scripts separate from normal runs.","+- Relative local directory and tarball specifiers such as `./my-cli` and `./my-cli.tgz` resolve against the caller's working directory.","+- Explicitly requested tarball URL, `file:`, and git URL packages run their build scripts by default unless `--ignore-scripts` or a negated `--allow-build` selector disables them."],"additions":15,"deletions":0,"truncated":false},{"path":".changeset/dlx-isolate-local-workspace-settings.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm dlx`, `pnx`, and `pnpm create` now ignore untrusted execution, layout, and resolution settings in a local `pnpm-workspace.yaml`, including `pnpmfile`, `globalPnpmfile`, `configDependencies`, `scriptShell`, `cacheDir`, `storeDir`, and `ignoreScripts`. Settings from the user's global `config.yaml`, such as `blockExoticSubdeps`, `cacheDir`, and `storeDir`, remain active."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/importer-probe-shared-slot-skip.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/fs.indexed-pkg-importer\": patch","+\"pnpm\": patch","+---","+","+Fixed `ERR_PNPM_LINKING_FAILED` on filesystems without copy-on-write reflinks when an install reuses an existing global virtual store entry before staging a package build. Also fixed merging `node_modules` directories during staged package imports on filesystems such as Btrfs that report `EEXIST` when renaming onto a non-empty directory."],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch.rs","lines":["@@ -270,18 +270,12 @@ impl CliArgs {","                 setup,","                 anchors,","                 target_template.0,","-                take_preloaded_config(","-                    &preloaded_config,","-                    target.anchor,","-                    target.is_global,","-                    &anchors.dir,","-                ),","+                take_preloaded_config(&preloaded_config, &target, &anchors.dir),","             )","         };","         // Resolve `.npmrc` / `pnpm-workspace.yaml` from the canonicalized","         // `--dir` rather than the process cwd, matching pnpm 11 (which","         // builds its `localPrefix` from `cliOptions.dir`, not `cwd`).","-        let config = || load_config(ConfigScope::Dir);","         let config_self_update =","             || self.load_self_update_config(invocation, config_overrides, setup, anchors);","         let builtin_replaced_by_script = AtomicBool::new(false);","@@ -292,7 +286,8 @@ impl CliArgs {","             locations: CommandLocations::from(anchors),","             workspace: WorkspaceInvocation::from(&self.workspace),","             loaders: CommandLoaders {","-                config: &config,","+                config: &|| load_config(ConfigScope::Dir),","+                dlx_config: &|| load_config(ConfigScope::Dlx),","                 global_config: &|| load_config(ConfigScope::PnpmHome),","                 global_packages_config: &|| load_config(ConfigScope::GlobalPackages),","                 config_self_update: &config_self_update,"],"additions":3,"deletions":8,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/config_scope.rs","lines":["@@ -9,6 +9,7 @@ use pnpm_config::CommandTarget;"," #[derive(Clone, Copy)]"," pub(super) enum ConfigScope {","     Dir,","+    Dlx,","     PnpmHome,","     GlobalPackages,"," }","@@ -20,9 +21,10 @@ impl ConfigScope {","         store_use: StoreUse,","         warnings: ConfigWarnings,","     ) -> ConfigTarget<'_> {","-        let is_global = !matches!(self, Self::Dir);","+        let is_global = matches!(self, Self::PnpmHome | Self::GlobalPackages);","         let command_target = match self {","             Self::GlobalPackages => CommandTarget::GlobalPackages,","+            Self::Dlx => CommandTarget::Dlx,","             Self::Dir | Self::PnpmHome => CommandTarget::Project,","         };","         let anchor = if is_global { &anchors.global_config } else { &anchors.dir };"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/context.rs","lines":["@@ -63,6 +63,10 @@ pub(crate) struct WorkspaceInvocation<'a> {"," "," pub(crate) struct CommandLoaders<'a> {","     pub(crate) config: &'a (dyn Fn() -> miette::Result<&'static mut Config> + Sync),","+    /// Like [`Self::config`] but restricted to the local settings `dlx` and","+    /// `create` inherit from the caller's `.npmrc` and `pnpm-workspace.yaml`","+    /// ([`pnpm_config::CommandTarget::Dlx`]), preserving user global config.","+    pub(crate) dlx_config: &'a (dyn Fn() -> miette::Result<&'static mut Config> + Sync),","     /// Like [`Self::config`] but anchored at the pnpm home dir instead of","     /// `--dir`, so a `-g` install can't inherit the caller project's","     /// `.npmrc` network / TLS / registry settings.","@@ -154,11 +158,12 @@ impl<'a> From<&'a crate::cli_args::cli_command::CliWorkspaceArgs> for WorkspaceI"," "," pub(super) fn take_preloaded_config(","     preloaded_config: &Mutex<Option<Result<Config, ConfigLoadFailure>>>,","-    anchor: &Path,","-    is_global: bool,","+    targ