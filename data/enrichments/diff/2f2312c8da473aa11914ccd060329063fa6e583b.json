tthrow InvalidConfigurationException(","+\t\t\t    \"Secret '%s' named by '%s' does not apply to it: the path is outside the secret's scope\", secret_name,","+\t\t\t    path);","+\t\t}","+\t\tauto &type = named_secret.GetType();","+\t\tfor (idx_t i = 0; i < secret_types_len; i++) {","+\t\t\tif (StringUtil::CIEquals(type.GetIdentifierName(), secret_types[i])) {","+\t\t\t\tsecret = named_secret.Cast<KeyValueSecret>();","+\t\t\t\treturn;","+\t\t\t}","+\t\t}","+\t\tthrow InvalidConfigurationException(\"Secret '%s' named by '%s' is of type %s, which this read does not take\",","+\t\t                                    secret_name, path, type);"," \t}"," "," \tInitialize(secret_types, secret_types_len);"],"additions":30,"deletions":1,"truncated":false},{"path":"test/common/test_http_transport_manager.cpp","lines":["@@ -296,7 +296,7 @@ class MockHTTPUtil : public HTTPUtil {"," \t\tif (state->callback) {"," \t\t\tstate->callback();"," \t\t}","-\t\tstate->initialized_paths.push_back(info ? info->file_path : string());","+\t\tstate->initialized_paths.push_back(info ? info->file.path : string());"," \t\tstate->initialized_with_context.push_back(bool(FileOpener::TryGetClientContext(opener)));"," \t\tauto result = make_uniq<MockHTTPParams>(*this);"," \t\tresult->Initialize(opener);"],"additions":1,"deletions":1,"truncated":false},{"path":"test/secrets/CMakeLists.txt","lines":["@@ -1,5 +1,6 @@","-add_library_unity(test_secrets OBJECT test_custom_secret_storage.cpp","-                  test_persistent_secret_permissions.cpp)","+add_library_unity(","+  test_secrets OBJECT test_custom_secret_storage.cpp test_file_credentials.cpp","+  test_persistent_secret_permissions.cpp)"," "," set(UNITTEST_OBJECT_FILES","     ${UNITTEST_OBJECT_FILES} $<TARGET_OBJECTS:test_secrets>"],"additions":3,"deletions":2,"truncated":false},{"path":"test/secrets/test_file_credentials.cpp","lines":["@@ -0,0 +1,664 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+#include \"duckdb.hpp\"","+#include \"duckdb/common/file_opener.hpp\"","+#include \"duckdb/common/file_system.hpp\"","+#include \"duckdb/common/multi_file/multi_file_list.hpp\"","+#include \"duckdb/main/client_context_file_opener.hpp\"","+#include \"duckdb/main/config.hpp\"","+#include \"duckdb/main/database.hpp\"","+#include \"duckdb/main/database_file_opener.hpp\"","+#include \"duckdb/main/extension/extension_loader.hpp\"","+#include \"duckdb/main/extension_manager.hpp\"","+#include \"duckdb/main/secret/secret.hpp\"","+#include \"duckdb/main/secret/secret_manager.hpp\"","+","+#include <fstream>","+#include <functional>","+#include <sstream>","+#include <thread>","+","+using namespace duckdb;","+","+namespace {","+","+//! The secret type the test file system reads, and one it does not","+constexpr const char *TEST_TYPE = \"file_credentials_test\";","+constexpr const char *OTHER_TYPE = \"file_credentials_test_other\";","+//! What a read records when no secret and no setting give a key","+constexpr const char *NO_KEY = \"<none>\";","+//! The sum of column i over the two files CredentialsFixture::WriteFiles writes","+constexpr const char *SAME_FILES_SUM = \"999000\";","+","+duckdb::unique_ptr<BaseSecret> CreateTestSecret(ClientContext &context, CreateSecretInput &input) {","+\tauto secret = make_uniq<KeyValueSecret>(input.scope, input.type, input.provider, input.name);","+\tfor (auto &option : input.options) {","+\t\tsecret->secret_map[Identifier(option.first)] = Value(option.second.ToString());","+\t}","+\treturn std::move(secret);","+}","+","+//! Registers TEST_TYPE and OTHER_TYPE, each created with a KEY_ID and a REGION","+void RegisterTestSecretTypes(DatabaseInstance &instance) {","+\tExtensionInfo extension_info {};","+\tExtensionActiveLoad load_info {instance, extension_info, Identifier(\"file_credentials_test\"), Identifier()};","+\tExtensionLoader loader {load_info};","+\tfor (auto type : {TEST_TYPE, OTHER_TYPE}) {","+\t\tSecretType secret_type;","+\t\tsecret_type.name = Identifier(type);","+\t\tsecret_type.deserializer = KeyValueSecret::Deserialize<KeyValueSecret>;","+\t\tsecret_type.default_provider = \"config\";","+\t\tloader.RegisterSecretType(secret_type);","+\t\tCreateSecretFunction function = {type, \"config\", CreateTestSecret};","+\t\tfunction.named_parameters[\"key_id\"] = LogicalType::VARCHAR;","+\t\tfunction.named_parameters[\"region\"] = LogicalType::VARCHAR;","+\t\tloader.RegisterFunction(function);","+\t}","+\tauto &config = DBConfig::GetConfig(instance);","+\tconfig.AddExtensionOption(\"file_credentials_test_region\", \"region a read uses when no secret sets one\",","+\t                          LogicalType::VARCHAR);","+}","+","+//! One open, read or glob the test file system served, with the key id and region the secret reader gave it","+struct Access {","+\tstring kind;","+\tstring path;","+\tstring key_id;","+\tstring region;","+};","+","+struct MemoryFileHandle : public FileHandle {","+\tMemoryFileHandle(FileSystem &fs, const string &path, FileOpenFlags flags, string key_id_p)","+\t    : FileHandle(fs, path, flags), key_id(std::move(key_id_p)) {","+\t}","+\tvoid Close() override {","+\t}","+\tstring key_id;","+\tidx_t position = 0;","+};","+","+//! Serves files from memory under mem://, and records every open, read and glob with the key id of the secret the","+//! secret reader chose for it. A glob lists the files under the pattern's prefix, each naming the secret that","+//! `listing_secrets` gives its pattern, as a catalog lists the files of a table","+class MemoryFileSystem : public FileSystem {","+public:","+\tduckdb::map<string, string> files;","+\t//! By glob pattern; \"\" for every pattern","+\tduckdb::map<string, string> listing_secrets;","+\tduckdb::mutex lock;","+\tduckdb::vector<Access> accesses;","+","+\tduckdb::vector<Access> Accesses(const string &kind) {","+\t\tduckdb::lock_guard<duckdb::mutex> guard(lock);","+\t\tduckdb::vector<Access> result;","+\t\tfor (auto &access : accesses) {","+\t\t\tif (access.kind == kind) {","+\t\t\t\tresult.push_back(access);","+\t\t\t}","+\t\t}","+\t\treturn result;","+\t}","+\tidx_t CountKey(const string &kind, const string &key) {","+\t\tidx_t count = 0;","+\t\tfor (auto &access : Accesses(kind)) {","+\t\t\tcount += access.key_id == key;","+\t\t}","+\t\treturn count;","+\t}","+\tvoid ClearAccesses() {","+\t\tduckdb::lock_guard<duckdb::mutex> guard(lock);","+\t\taccesses.clear();","+\t}","+\tstring GetName() const override {","+\t\treturn \"MemoryFileSystem\";","+\t}","+\tusing FileSystem::OpenFile;","+\tunique_ptr<FileHandle> OpenFile(const string &path, FileOpenFlags flags,","+\t                                optional_ptr<FileOpener> opener = nullptr) override {","+\t\treturn OpenFileExtended(OpenFileInfo(path), flags, opener);","+\t}","+\tbool CanHandleFile(const string &path) override {","+\t\treturn StringUtil::StartsWith(path, \"mem://\");","+\t}","+\tbool SupportsOpenFileExtended() const override {","+\t\treturn true;","+\t}","+\tbool SupportsGlobExtended() const override {","+\t\treturn true;","+\t}","+\tvoid Read(FileHandle &handle, void *buffer, int64_t nr_bytes, idx_t location) override {","+\t\tauto &memory_handle = handle.Cast<MemoryFileHandle>();","+\t\tauto &data = files.at(handle.path);","+\t\tif (location + nr_bytes > data.size()) {","+\t\t\tthrow IOException(\"Read past the end of \\\"%s\\\"\", handle.path);","+\t\t}","+\t\tmemcpy(buffer, data.data() + location, nr_bytes);","+\t\tRecord(\"read\", handle.path, memory_handle.key_id, \"\");","+\t}","+\tint64_t Read(FileHandle &handle, void *buffer, int64_t nr_bytes) override {","+\t\tauto &memory_handle = handle.Cast<MemoryFileHandle>();","+\t\tauto &data = files.at(handle.path);","+\t\tauto count = MinValue<int64_t>(nr_bytes, data.size() - memory_handle.position);","+\t\tRead(handle, buffer, count, memory_handle.position);","+\t\tmemory_handle.position += count;","+\t\treturn count;","+\t}","+\tint64_t GetFileSize(FileHandle &handle) override {","+\t\treturn files.at(handle.path).size();","+\t}","+\ttimestamp_t GetLastModifiedTime(FileHandle &handle) override {","+\t\treturn Timestamp::FromEpochSeconds(1000);","+\t}","+\tstring GetVersionTag(FileHandle &handle) override {","+\t\treturn \"v1\";","+\t}","+\tFileType GetFileType(FileHandle &handle) override {","+\t\treturn FileType::FILE_TYPE_REGULAR;","+\t}","+\tbool CanSeek() override {","+\t\treturn true;","+\t}","+\tbool OnDiskFile(FileHandle &handle) override {","+\t\treturn false;","+\t}","+\tvoid Seek(FileHandle &handle, idx_t location) override {","+\t\thandle.Cast<MemoryFileHandle>().position = location;","+\t}","+\tidx_t SeekPosition(FileHandle &handle) override {","+\t\treturn handle.Cast<MemoryFileHandle>().position;","+\t}","+\tbool FileExists(const string &filename, optional_ptr<FileOpener> opener = nullptr) override {","+\t\treturn files.count(filename) > 0;","+\t}","+","+protected:","+\tunique_ptr<FileHandle> OpenFileExtended(const OpenFileInfo &file, FileOpenFlags flags,","+\t                                        optional_ptr<FileOpener> opener) override {","+\t\tFileOpenerInfo info(file);","+\t\tstring key_id;","+\t\tstring region;","+\t\tReadSecret(opener, info, key_id, region);","+\t\tRecord(\"open\", file.path, key_id, region);","+\t\tif (!files.count(file.path) && flags.ReturnNullIfNotExists()) {","+\t\t\treturn nullptr;","+\t\t}","+\t\tif (!files.count(file.path)) {","+\t\t\tthrow IOException(\"No file \\\"%s\\\"\", file.path);","+\t\t}","+\t\treturn make_uniq<MemoryFileHandle>(*this, file.path, flags, key_id);","+\t}","+\tunique_ptr<MultiFileList> GlobFilesExtended(const string &pattern, const FileGlobInput &input,","+\t                                            optional_ptr<FileOpener> opener) override {","+\t\tFileOpenerInfo info(pattern);","+\t\tstring key_id;","+\t\tstring region;","+\t\tReadSecret(opener, info, key_id, region);","+\t\tRecord(\"glob\", pattern, key_id, region);","+\t\tstring secret_name;","+\t\tauto listed_with = listing_secrets.find(listing_secrets.count(pattern) ? pattern : \"\");","+\t\tif (listed_with != listing_secrets.end()) {","+\t\t\tsecret_name = listed_with->second;","+\t\t}","+\t\tauto star = pattern.find('*');","+\t\tauto listed_prefix = pattern.substr(0, star);","+\t\tauto suffix = star == string::npos ? string() : pattern.substr(pattern.rfind('*') + 1);","+\t\tvector<OpenFileInfo> result;","+\t\tfor (auto &entry : files) {","+\t\t\tauto &path = entry.first;","+\t\t\tbool matches = star == string::npos","+\t\t\t                   ? path == pattern","+\t\t\t                   : StringUtil::StartsWith(path, listed_prefix) && StringUtil::EndsWith(path, suffix);","+\t\t\tif (!matches) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tOpenFileInfo listed(path);","+\t\t\tlisted.extended_info = make_shared_ptr<ExtendedOpenFileInfo>();","+\t\t\tif (!secret_name.empty()) {","+\t\t\t\tlisted.extended_info->options[ExtendedOpenFileInfo::SECRET_OPTION] = Value(secret_name);","+\t\t\t}","+\t\t\tresult.push_back(std::move(listed));","+\t\t}","+\t\treturn make_uniq<SimpleMultiFileList>(std::move(result));","+\t}","+","+private:","+\tvoid ReadSecret(optional_ptr<FileOpener> opener, FileOpenerInfo &info, string &key_id, string &region) {","+\t\tkey_id = NO_KEY;","+\t\tregion = NO_KEY;","+\t\tif (!opener) {","+\t\t\treturn;","+\t\t}","+\t\tKeyValueSecretReader reader(*opener, &info, TEST_TYPE);","+\t\tValue value;","+\t\tif (reader.TryGetSecretKeyOrSetting(\"key_id\", \"file_credentials_test_key_id\", value) && !value.IsNull()) {","+\t\t\tkey_id = value.ToString();","+\t\t}","+\t\tif (reader.TryGetSecretKeyOrSetting(\"region\", \"file_credentials_test_region\", value) && !value.IsNull()) {","+\t\t\tregion = value.ToString();","+\t\t}","+\t}","+\tvoid Record(const string &kind, const string &path, const string &key_id, const string &region) {","+\t\tduckdb::lock_guard<duckdb::mutex> guard(lock);","+\t\taccesses.push_back(Access {kind, path, key_id, region});","+\t}","+};","+","+string ReadLocalFile(const string &path) {","+\tstd::ifstream input(path, std::ios::binary);","+\tstd::stringstream buffer;","+\tbuffer << input.rdbuf();","+\treturn buffer.str();","+}","+","+//! A database with the test secret types, mem:// files, and the secret that reads of them by path use. Its scope,","+//! mem://bucket/table/, is longer than that of the secrets the tests name, so a read that loses the name of its","+//! secret reads with it, and the tests see that","+struct CredentialsFixture {","+\tCredentialsFixture() : db(nullptr), con(db) {","+\t\tRegisterTestSecretTypes(*db.instance);","+\t\tauto fs_p = make_uniq<MemoryFileSystem>();","+\t\tfs = fs_p.get();","+\t\tdb.instance->GetFileSystem().RegisterSubSystem(std::move(fs_p));","+\t\tfs->files[\"mem://bucket/table/a.bin\"] = \"abc\";","+\t\tfs->files[\"mem://bucket/table/b.bin\"] = \"def\";","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE SECRET by_path (TYPE file_credentials_test, SCOPE 'mem://bucket/table/', \"","+\t\t                          \"KEY_ID 'path-key', REGION 'path-region')\"));","+\t}","+\tClientContext &Context() {","+\t\treturn *con.context;","+\t}","+\t//! Creates the secret `name`, whose key id is its name too, for the paths under `scope`; returns the name","+\tstring NamedSecret(const string &name, const string &scope = \"mem://bucket/\", const char *type = TEST_TYPE) {","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE SECRET \\\"\" + name + \"\\\" (TYPE \" + type + \", SCOPE '\" + scope + \"', KEY_ID '\" +","+\t\t                          name + \"')\"));","+\t\treturn name;","+\t}","+\t//! `path`, naming the secret `name` in its options","+\tstatic OpenFileInfo File(const string &path, const string &name) {","+\t\tOpenFileInfo file(path);","+\t\tfile.extended_info = make_shared_ptr<ExtendedOpenFileInfo>();","+\t\tfile.extended_info->options[ExtendedOpenFileInfo::SECRET_OPTION] = Value(name);","+\t\treturn file;","+\t}","+\t//! Opens `file` through the file system of `c`, which must be in a transaction, and returns the key id the open","+\t//! used","+\tstatic string OpenKey(Connection &c, const OpenFileInfo &file) {","+\t\tauto handle = FileSystem::GetFileSystem(*c.context).OpenFile(file, FileFlags::FILE_FLAGS_READ);","+\t\treturn handle->Cast<MemoryFileHandle>().key_id;","+\t}","+\tstring OpenKey(const OpenFileInfo &file) {","+\t\treturn OpenKey(con, file);","+\t}","+\t//! Runs `scan` with every listed file naming the secret `name`; returns the row count","+\tidx_t ScanWith(const string &scan, const string &name) {","+\t\tfs->listing_secrets = {{\"\", name}};","+\t\tfs->ClearAccesses();","+\t\tauto result = con.Query(scan);","+\t\tfs->listing_secrets.clear();","+\t\tREQUIRE_NO_FAIL(*result);","+\t\treturn result->RowCount();","+\t}","+\t//! csv, and json and parquet when they are loaded","+\tduckdb::vector<string> Formats() {","+\t\tduckdb::vector<string> result {\"csv\"};","+\t\tfor (auto format : {\"json\", \"parquet\"}) {","+\t\t\tif (db.ExtensionIsLoaded(format)) {","+\t\t\t\tresult.push_back(format);","+\t\t\t}","+\t\t}","+\t\treturn result;","+\t}","+\t//! Writes mem://bucket/table/t1.<format> and t2.<format>, each with a column i of 0 to 999","+\tvoid WriteFiles(const string &format) {","+\t\tstring data = format == \"csv\" ? \"i\\n\" : \"\";","+\t\tif (format == \"parquet\") {","+\t\t\tauto local = TestCreatePath(\"file_credentials_same_files.parquet\");","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"COPY (SELECT range AS i FROM range(1000)) TO '\" + local + \"' (FORMAT parquet)\"));","+\t\t\tdata = ReadLocalFile(local);","+\t\t}","+\t\tfor (idx_t i = 0; format != \"parquet\" && i < 1000; i++) {","+\t\t\tdata += format == \"csv\" ? to_string(i) + \"\\n\" : \"{\\\"i\\\": \" + to_string(i) + \"}\\n\";","+\t\t}","+\t\tfs->files[\"mem://bucket/table/t1.\" + format] = data;","+\t\tfs->files[\"mem://bucket/table/t2.\" + format] = data;","+\t}","+\t//! mem://bucket/table/<prefix>*.<format>: with \"\" and with \"t\" it lists the files WriteFiles wrote","+\tstatic string Glob(const string &format, const string &prefix) {","+\t\treturn \"mem://bucket/table/\" + prefix + \"*.\" + format;","+\t}","+\tstatic string Scan(const string &format, const string &glob) {","+\t\treturn \"SELECT sum(i) FROM read_\" + format + \"('\" + glob + \"')\";","+\t}","+\t//! Runs the scan of `glob` on `c` `runs` times, its files naming the secret `name`; returns how often the scans","+\t//! opened and read them","+\tstd::pair<idx_t, idx_t> ScanAlone(Connection &c, const string &format, const string &glob, const string &name,","+\t                                  idx_t runs = 1) {","+\t\tfs->listing_secrets = {{glob, name}};","+\t\tfs->ClearAccesses();","+\t\tfor (idx_t run = 0; run < runs; run++) {","+\t\t\tauto result = c.Query(Scan(format, glob));","+\t\t\tREQUIRE_NO_FAIL(*result);","+\t\t\tREQUIRE(result->Collection().GetValue(0, 0).ToString() == SAME_FILES_SUM);","+\t\t}","+\t\tfs->listing_secrets.clear();","+\t\treturn {fs->CountKey(\"open\", name), fs->CountKey(\"read\", name)};","+\t}","+\t//! Requires `key_id` to have opened files `opens` times and read them `reads` times since the accesses were cleared","+\tvoid RequireUses(const string &key_id, idx_t opens, idx_t reads) {","+\t\tINFO(key_id);","+\t\tREQUIRE(fs->CountKey(\"open\", key_id) == opens);","+\t\tREQUIRE(fs->CountKey(\"read\", key_id) == reads);","+\t}","+","+\tDuckDB db;","+\tConnection con;","+\tMemoryFileSystem *fs;","+};","+","+void RequireThrowsWith(const std::function<void()> &call, const string &message) {","+\ttry {","+\t\tcall();","+\t} catch (std::exception &ex) {","+\t\tErrorData error(ex);","+\t\tINFO(error.Message());","+\t\tREQUIRE(StringUtil::Contains(error.Message(), message));","+\t\treturn;","+\t}","+\tFAIL(\"expected an error containing: \" << message);","+}","+","+} // namespace","+","+TEST_CASE(\"A file that names a secret reads with it instead of the secret matched to its path\", \"[file_credentials]\") {","+\tCredentialsFixture f;","+\tREQUIRE_NO_FAIL(f.con.Query(\"SET file_credentials_test_region = 'setting-region'\"));","+\tauto named = f.NamedSecret(\"named-key\");","+\tconst string path = \"mem://bucket/table/a.bin\";","+\tf.con.BeginTransaction();","+\tREQUIRE(f.OpenKey(OpenFileInfo(path)) == \"path-key\");","+\tREQUIRE(f.OpenKey(CredentialsFixture::File(path, named)) == \"named-key\");","+\t// the named secret sets no region: the setting fills it, as for a secret matched to the path","+\tREQUIRE(f.fs->Accesses(\"open\")[1].region == \"setting-region\");","+\tf.con.Rollback();","+\t// an opener without a client finds the secret too","+\tDatabaseFileOpener database_opener(*f.db.instance);","+\tFileOpenerInfo info(CredentialsFixture::File(path, named));","+\tKeyValueSecretReader reader(database_opener, &info, TEST_TYPE);","+\tREQUIRE(reader.GetSecretKey(\"key_id\").ToString() == \"named-key\");","+\t// the name is an option of the file, so it also travels in a file struct, and a statement can name a secret","+\tstring name;","+\tREQUIRE(OpenFileInfo::FromValue(CredentialsFixture::File(path, named).ToValue(), Identifier(\"test\"))","+\t            .extended_info->TryGetSecretName(name));","+\tREQUIRE(name == named);","+\tf.fs->files[\"mem://bucket/table/t1.csv\"] = \"i\\n1\\n\";","+\tf.fs->ClearAccesses();","+\tauto result =","+\t    f.con.Query(\"SELECT i FROM read_csv([{'filename': 'mem://bucket/table/t1.csv', 'secret': '\" + named + \"'}])\");","+\tREQUIRE(CHECK_COLUMN(result, 0, {1}));","+\tREQUIRE(f.fs->Accesses(\"open\").size() > 0);","+\tREQUIRE(f.fs->CountKey(\"open\", named) == f.fs->Accesses(\"open\").size());","+}","+","+TEST_CASE(\"A named secret of another type fails the read, and a reader of several types takes any of them\",","+          \"[file_credentials]\") {","+\tCredentialsFixture f;","+\tauto other = f.NamedSecret(\"other-key\", \"mem://bucket/\", OTHER_TYPE);","+\tf.con.BeginTransaction();","+\tRequireThrowsWith([&]() { f.OpenKey(CredentialsFixture::File(\"mem://bucket/table/a.bin\", other)); },","+\t                  \"is of type \\\"file_credentials_test_other\\\", which this read does not take\");","+\tClientContextFileOpener opener(f.Context());","+\tFileOpenerInfo info(CredentialsFixture::File(\"mem://bucket/table/a.bin\", other));","+\tconst char *with_other[] = {TEST_TYPE, \"FILE_CREDENTIALS_TEST_OTHER\"};","+\tKeyValueSecretReader reader(opener, &info, with_other, 2);","+\tREQUIRE(reader.GetSecretKey(\"key_id\").ToString() == \"other-key\");","+\tf.con.Rollback();","+}","+","+TEST_CASE(\"A file that names a secret which does not exist, or whose scope does not cover it, fails rather than \"","+          \"reading with the secret matched to its path\",","+          \"[file_credentials]\") {"],"additions":419,"deletions":0,"truncated":false}],"additions":557,"deletions":14,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-03T16:49:39.341211+00:00"}