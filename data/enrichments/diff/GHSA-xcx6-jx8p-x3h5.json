{"id":"GHSA-xcx6-jx8p-x3h5","axis":"advisories","repo":"AzureAD/microsoft-authentication-library-for-js","sha":"f550958586475dbfeb1cd44be14a2d653728850e","parsed":{"files":[{"path":"change/@azure-msal-node-reject-unsupported-cca-instance-aware.json","lines":["@@ -0,0 +1,7 @@","+{","+  \"type\": \"patch\",","+  \"comment\": \"Sanitize authorization code payloads and reject unsupported instance-aware inputs for confidential clients. [#8901](https://github.com/AzureAD/microsoft-authentication-library-for-js/pull/8901)\",","+  \"packageName\": \"@azure/msal-node\",","+  \"email\": \"rginsburg@microsoft.com\",","+  \"dependentChangeType\": \"patch\"","+}"],"additions":7,"deletions":0,"truncated":false},{"path":"docs/errors.md","lines":["@@ -72,6 +72,10 @@ This error occurs when MSAL.js surpasses the allotted storage limit when attempt"," "," -   State not found."," ","+### `unsupported_cca_instance_aware`","+","+-   ConfidentialClientApplication does not support instance-aware configuration or authorization requests.","+"," ### `nonce_mismatch`"," "," -   Nonce mismatch error."],"additions":4,"deletions":0,"truncated":false},{"path":"lib/msal-node/apiReview/msal-node.api.md","lines":["@@ -150,8 +150,10 @@ export type ClientCredentialRequest = Partial<Omit<CommonClientCredentialRequest"," export class ConfidentialClientApplication extends ClientApplication implements IConfidentialClientApplication {","     constructor(configuration: Configuration);","     acquireTokenByClientCredential(request: ClientCredentialRequest): Promise<AuthenticationResult | null>;","+    acquireTokenByCode(request: AuthorizationCodeRequest, authCodePayload?: AuthorizationCodePayload): Promise<AuthenticationResult>;","     acquireTokenByUserFederatedIdentityCredential(request: UserFederatedIdentityCredentialRequest): Promise<AuthenticationResult | null>;","     acquireTokenOnBehalfOf(request: OnBehalfOfRequest): Promise<AuthenticationResult | null>;","+    getAuthCodeUrl(request: AuthorizationUrl