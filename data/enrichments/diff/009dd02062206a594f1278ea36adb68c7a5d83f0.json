GcEffect,","+    report: &mut CacheReport,","+) -> Result<()> {","+    let ev = evict_active_cache(cache_dir, active, max_age, max_size, effect).await?;","+    report.files_evicted += ev.files_evicted;","+    report.bytes_reclaimed += ev.bytes_reclaimed;","+    let should_prune_empty_dirs = match effect {","+        CacheGcEffect::Apply => ev.files_evicted > 0,","+        CacheGcEffect::DryRun => false,","+    };","+    if should_prune_empty_dirs {","+        prune_empty_dirs(cache_dir, active).await?;","+    }","+    Ok(())","+}","+"," /// Evict cache entries on startup: cleans orphaned namespaces and enforces configured caps."," pub async fn prune_orphaned_namespaces_startup(config: &Config) -> Result<CacheReport> {","     let opts = CacheGcOptions {","@@ -147,107 +196,6 @@ pub fn spawn_periodic_cache_eviction(config: &Config) {","     });"," }"," ","-async fn prune_orphan_entry(","-    entry: &tokio::fs::DirEntry,","-    prefix: &str,","-    active: &HashSet<String>,","-    effect: CacheGcEffect,","-    report: &mut CacheReport,","-) -> Result<()> {","-    let Ok(file_type) = entry.file_type().await else {","-        return Ok(());","-    };","-    if !file_type.is_dir() || file_type.is_symlink() {","-        return Ok(());","-    }","-    let ns = format!(\"{prefix}/{}\", entry.file_name().to_string_lossy());","-    if active.contains(&ns) {","-        return Ok(());","-    }","-    let (count, bytes) = count_dir_contents(&entry.path()).await?;","-    match effect {","-        CacheGcEffect::Apply => fs::remove_dir_all(entry.path()).await?,","-        CacheGcEffect::DryRun => {}","-    }","-    report.namespaces_removed += 1;","-    report.files_evicted += count;","-    report.bytes_reclaimed += bytes;","-    Ok(())","-}","-","-async fn prune_orphan_prefix(","-    cache_dir: &Path,","-    prefix: &str,","-    active: &HashSet<String>,","-    effect: CacheGcEffect,","-    report: &mut CacheReport,","-) {","-    let parent = cache_dir.join(prefix);","-    if let O