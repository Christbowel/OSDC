g::info!(%listen, \"pnpr listening\");","     serve_until_shutdown(listener, wrap(app), metrics).await"," }","+","+#[cfg(test)]","+mod tests;"],"additions":43,"deletions":13,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/lifecycle/tests.rs","lines":["@@ -0,0 +1,122 @@","+use super::{Config, Storage, sweep_abandoned_archive_temps};","+use object_store::memory::InMemory;","+use pnpr_config::HostedStoreConfig;","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};","+use std::{","+    fs::{File, FileTimes},","+    net::{Ipv4Addr, SocketAddr, SocketAddrV4},","+    path::Path,","+    sync::Arc,","+    time::{Duration, SystemTime},","+};","+use tempfile::TempDir;","+","+fn s3_config(tmp: &TempDir) -> Config {","+    let listen = SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST, 7677));","+    let config_path = tmp.path().join(\"config.yaml\");","+    let yaml = format!(","+        r\"","+storage: {storage}","+cache: {cache}","+secret: test-secret-key-32-chars-long-12","+registries:","+  local:","+    type: hosted","+\",","+        storage = tmp.path().join(\"storage\").display(),","+        cache = tmp.path().join(\"cache\").display(),","+    );","+    std::fs::write(&config_path, yaml).unwrap();","+    let mut config = Config::from_yaml(&config_path, listen, None).unwrap();","+    config.storage.hosted_backend =","+        HostedStoreConfig::ObjectStore { store: Arc::new(InMemory::new()), prefix: String::new() };","+    config","+}","+","+fn set_age(path: &Path, age: Duration) {","+    let modified = SystemTime::now().checked_sub(age).unwrap_or(SystemTime::UNIX_EPOCH);","+    let file = File::options()","+        .write(true)","+        .open(path)","+        .unwrap();","+    file.set_times(FileTimes::new().set_modified(modified))","+        .unwrap();","+}","+","+#[tokio::test(start_paused = true)]","+async fn startup_and_periodic_sweeps_reclaim_s3_staging_files_past_request_timeout() {","+    let tmp = TempDir::new().unwrap();","+    let config = s3_config(&tmp);","+    let storage = Storage::from_config(&config.storage).unwrap();","+    let name = CanonicalPackageName::parse(\"large-pkg\", Ecosystem::Npm).unwrap();","+    let staging_base = pnpr_storage::cache_staging_tmp_base(&config.storage.cache_dir);","+    tokio::fs::create_dir_all(staging_base.parent().unwrap()).await.unwrap();","+","+    let stale_path = pnpr_storage::unique_tmp_path(&staging_base);","+    tokio::fs::write(&stale_path, b\"stale-staging-payload\").await.unwrap();","+    set_age(&stale_path, Duration::from_mins(2));","+","+    let fresh_path = pnpr_storage::unique_tmp_path(&staging_base);","+    tokio::fs::write(&fresh_path, b\"just-crashed-payload\").await.unwrap();","+","+    let active_slot = storage.reserve_hosted_blob(&name, \"large-pkg-1.0.2.tgz\").await.unwrap();","+    let active_path = active_slot.tmp_path.clone();","+    tokio::fs::write(&active_path, b\"in-flight-publish-payload\").await.unwrap();","+    set_age(&active_path, Duration::from_mins(2));","+","+    sweep_abandoned_archive_temps(&config).await.unwrap();","+    assert!(!stale_path.exists(), \"startup sweep must remove staging files past request_timeout\");","+    assert!(fresh_path.exists(), \"startup sweep must keep staging files within request_timeout\");","+    assert!(active_path.exists(), \"startup sweep must keep active in-process slots\");","+","+    tokio::task::yield_now().await;","+    set_age(&fresh_path, Duration::from_mins(2));","+    tokio::time::advance(Duration::from_mins(2)).await;","+    tokio::time::resume();","+    for _ in 0..100 {","+        if !fresh_path.exists() {","+            break;","+        }","+        tokio::time::sleep(Duration::from_millis(5)).await;","+    }","+    assert!(","+        !fresh_path.exists(),","+        \"periodic sweep must remove staging files once request_timeout elapses\",","+    );","+    assert!(active_path.exists(), \"periodic sweep must keep active in-process slots\");","+    drop(active_slot);","+    assert!