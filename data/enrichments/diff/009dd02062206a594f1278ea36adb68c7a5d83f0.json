ry)) = entries.next_entry().await {","+        if let Err(err) = prune_orphan_entry(&entry, prefix, active, effect, report).await {","+            tracing::warn!(error = %err, path = %entry.path().display(), \"orphan cache namespace cleanup failed\");","+        }","+    }","+}","+","+/// Prune any namespaces under `~upstreams/` or `~public/` not present in `active`.","+pub(super) async fn prune_orphaned_namespaces(","+    cache_dir: &Path,","+    active: &HashSet<String>,","+    effect: CacheGcEffect,","+    has_configured_secret: bool,","+) -> Result<CacheReport> {","+    let mut report = CacheReport::default();","+    if has_configured_secret {","+        prune_orphan_prefix(cache_dir, \"~upstreams\", active, effect, &mut report).await;","+    }","+    prune_orphan_prefix(cache_dir, \"~public\", active, effect, &mut report).await;","+    Ok(report)","+}","+","+async fn process_count_entry(","+    entry: &tokio::fs::DirEntry,","+    stack: &mut Vec<PathBuf>,","+    count: &mut usize,","+    bytes: &mut u64,","+) {","+    let Ok(ft) = entry.file_type().await else {","+        return;","+    };","+    if ft.is_dir() {","+        stack.push(entry.path());","+    } else if ft.is_file() {","+        *count += 1;","+        if let Ok(meta) = entry.metadata().await {","+            *bytes += meta.len();","+        }","+    }","+}","+","+/// Count regular files and total bytes in a directory tree.","+pub(super) async fn count_dir_contents(path: &Path) -> Result<(usize, u64)> {","+    let mut count = 0;","+    let mut bytes = 0;","+    let mut stack = vec![path.to_path_buf()];","+    while let Some(dir) = stack.pop() {","+        let Ok(mut entries) = fs::read_dir(&dir).await else {","+            continue;","+        };","+        while let Ok(Some(entry)) = entries.next_entry().await {","+            process_count_entry(&entry, &mut stack, &mut count, &mut bytes).await;","+        }","+    }","+    Ok((count, bytes))","+}"],"additions":102,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/cache_maintenance/tests.rs","lines":["@@ -1,4 +1,4 @@","-use super::{count_dir_contents, is_abandoned_tmp};","+use super::{is_abandoned_tmp, orphans::count_dir_contents};"," use std::{path::Path, time::Duration};"," "," #[test]"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/documents.rs","lines":["@@ -295,10 +295,5 @@ async fn write_hosted_blob(","     filename: &str,","     bytes: &[u8],"," ) -> Result<BlobSlot, RegistryError> {","-    let slot = storage.reserve_hosted_blob(key, filename).await?;","-    if let Err(err) = tokio::fs::write(&slot.tmp_path, bytes).await {","-        cleanup_tmp_slots(vec![slot]).await;","-        return Err(err.into());","-    }","-    Ok(slot)","+    storage.reserve_hosted_blob(key, filename).await?.write_bytes(bytes).await"," }"],"additions":1,"deletions":6,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/lifecycle.rs","lines":["@@ -61,26 +61,53 @@ async fn sweep_abandoned_uploads(config: &Config) -> pnpr_error::Result<()> {"," }"," "," /// Remove the archive staging files a process left behind when it stopped","-/// between writing an archive and storing it, in every hosted namespace.","-/// One older than a day belongs to no publish still running.","+/// between writing an archive and storing it, in every hosted namespace, now","+/// and periodically while the server runs."," async fn sweep_abandoned_archive_temps(config: &Config) -> pnpr_error::Result<()> {","-    let storage = Storage::from_config(&config.storage)?;","-    let mut namespaces: Vec<(&str, Ecosystem)> = config.routing.hosted","+    let max_age = crate::cache_maintenance::archive_staging_max_age(config);","+    let namespaces = hosted_archive_namespaces(config);","+    let bases = pnpr_storage::archive_temp_bases(&config.storage, &namespaces);","+    sweep_archive_temp_bases(&bases, max_age).await?;","+    let period =","+        max_age.clamp(std::time::Duration::from_secs(30), std::time::