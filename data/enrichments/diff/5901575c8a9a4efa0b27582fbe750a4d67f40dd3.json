{"id":"5901575c8a9a4efa0b27582fbe750a4d67f40dd3","axis":"silent","repo":"grafana/loki","sha":"5901575c8a9a4efa0b27582fbe750a4d67f40dd3","parsed":{"files":[{"path":"pkg/dataobj/sections/indexpointers/iter.go","lines":["@@ -39,8 +39,7 @@ func Iter(ctx context.Context, obj *dataobj.Object) result.Seq[TenantIndexPointe"," "," func IterSection(ctx context.Context, section *Section) result.Seq[IndexPointer] {"," \treturn result.Iter(func(yield func(IndexPointer) bool) error {","-\t\tcolumnarSection := section.inner","-\t\tdset, err := columnar.MakeDataset(columnarSection, columnarSection.Columns())","+\t\tdset, err := section.makeDataset()"," \t\tif err != nil {"," \t\t\treturn fmt.Errorf(\"creating columns dataset: %w\", err)"," \t\t}","@@ -86,6 +85,17 @@ func IterSection(ctx context.Context, section *Section) result.Seq[IndexPointer]"," \t})"," }"," ","+// makeDataset builds a dataset from only the recognized columns, so rows stay","+// aligned with Columns() and columns from a newer Loki are skipped, not decoded.","+func (s *Section) makeDataset() (*columnar.Dataset, error) {","+\trecognized := s.Columns()","+\tinner := make([]*columnar.Column, len(recognized))","+\tfor i, col := range recognized {","+\t\tinner[i] = col.inner","+\t}","+\treturn columnar.MakeDataset(s.inner, inner)","+}","+"," // decodeRow decodes an indexpointer from a [dataset.Row], using the provided columns to"," // determine the column type. The list of columns must match the columns used"," // to create the row."],"additions":12,"deletions":2,"truncated":false},{"path":"pkg/dataobj/sections/indexpointers/iter_forward_compat_test.go","lines":["@@ -0,0 +1,134 @@","+package indexpointers","+","+import (","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/dataset\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/metadata/datasetmd\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/internal/columnar\"","+)","+","+// TestIter_ForwardCompatUnknownColumn reproduces the panic that occurs when an","+// older reader iterates an indexpointers section written by a newer Loki that","+// added columns the reader doesn't recognize (e.g. file_size /","+// uncompressed_logs_size from PR #23331).","+//","+// The section is built with the three long-standing columns plus one extra","+// column carrying a logical type unknown to [ParseColumnType]. A reader that","+// predates the new column must skip it and still decode the known columns","+// rather than panicking with an index-out-of-range in decodeRow.","+func TestIter_ForwardCompatUnknownColumn(t *testing.T) {","+\tpointers := []IndexPointer{","+\t\t{Path: \"path1\", StartTs: unixTime(10), EndTs: unixTime(20)},","+\t\t{Path: \"path2\", StartTs: unixTime(30), EndTs: unixTime(40)},","+\t}","+","+\tobjBuilder := dataobj.NewBuilder(nil)","+\trequire.NoError(t, objBuilder.Append(&unknownColumnSectionBuilder{tenant: \"tenant-1\", pointers: pointers}))","+","+\tobj, closer, err := objBuilder.Flush()","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { _ = closer.Close() })","+","+\tsec, err := Open(t.Context(), obj.Sections()[0])","+\trequire.NoError(t, err)","+","+\t// The physical section carries the unknown column, but the typed view drops","+\t// it. This length mismatch is exactly what makes decodeRow's positional","+\t// lookup run off the end of the recognized-columns slice.","+\trequire.Len(t, sec.inner.Columns(), 4, \"physical section should carry the unknown column\")","+\trequire.Len(t, sec.Columns(), 3, \"unknown column should be dropped from the typed view\")","+","+\tvar got []IndexPointer","+\tfor res := range Iter(t.Context(), obj) {","+\t\ttip, err := res.Value()","+\t\trequire.NoError(t, err)","+\t\tgot = append(got, tip.IndexPointer)","+\t}","+","+\trequire.Len(t, got, len(pointers))","+\tfor i, want := range pointers {","+\t\trequire.Equal(t, want.Path, got[i].Path)","+\t\trequire.Equal(t, want.StartTs.UnixNano(), got[i].StartTs.UnixNano())","+\t\trequire.Equal(t, want.EndTs.UnixNano(), got[i].EndTs.UnixNano())","+\t\trequire.Zero(t, got[i].FileSize)","+\t\trequire.Zero(t, got[i].UncompressedLogsSize)","+\t}","+}","+","+// unknownColumnSectionBuilder is a test-only [dataobj.SectionBuilder] that","+// encodes an indexpointers section with the standard path/min/max columns plus","+// one extra column whose logical type is unknown to the current reader. It","+// stands in for a section written by a newer version of Loki.","+type unknownColumnSectionBuilder struct {","+\ttenant   string","+\tpointers []IndexPointer","+}","+","+func (b *unknownColumnSectionBuilder) Type() dataobj.SectionType { return sectionType }","+","+func (b *unknownColumnSectionBuilder) Reset() { b.pointers = nil }","+","+func (b *unknownColumnSectionBuilder) Flush(w dataobj.SectionWriter) (int64, error) {","+\tvar enc columnar.Encoder","+\tdefer enc.Reset()","+","+\tint64Column := func(name, logical string) (*dataset.ColumnBuilder, error) {","+\t\treturn dataset.NewColumnBuilder(name, dataset.BuilderOptions{","+\t\t\tPageMaxRowCount: 100,","+\t\t\tType:            dataset.ColumnType{Physical: datasetmd.PHYSICAL_TYPE_INT64, Logical: logical},","+\t\t\tEncoding:        datasetmd.ENCODING_TYPE_DELTA,","+\t\t\tCompression:     datasetmd.COMPRESSION_TYPE_NONE,","+\t\t})","+\t}","+","+\tpathBuilder, err := dataset.NewColumnBuilder(\"path\", dataset.BuilderOptions{","+\t\tPageMaxRowCount: 100,","+\t\tType:            dataset.ColumnType{Physical: datasetmd.PHYSICAL_TYPE_BINARY, Logical: ColumnTypePath.String()},","+\t\tEncoding:        datasetmd.ENCODING_TYPE_PLAIN,","+\t\tCompression:     datasetmd.COMPRESSION_TYPE_ZSTD,","+\t})","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tminBuilder, err := int64Column(\"min_timestamp\", ColumnTypeMinTimestamp.String())","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tmaxBuilder, err := int64Column(\"max_timestamp\", ColumnTypeMaxTimestamp.String())","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\t// A column written by a newer Loki. Its logical type is not known to","+\t// ParseColumnType, so an older reader drops it from Section.Columns().","+\tfutureBuilder, err := int64Column(\"future_field\", \"future_field\")","+\tif err != nil {","+\t\treturn 0, err","+\t}","+","+\tfor i, p := range b.pointers {","+\t\t_ = pathBuilder.Append(i, dataset.BinaryValue([]byte(p.Path)))","+\t\t_ = minBuilder.Append(i, dataset.Int64Value(p.StartTs.UnixNano()))","+\t\t_ = maxBuilder.Append(i, dataset.Int64Value(p.EndTs.UnixNano()))","+\t\t_ = futureBuilder.Append(i, dataset.Int64Value(int64(i+1)))","+\t}","+","+\t// The unknown column is encoded last so it lands at a physical index beyond","+\t// the recognized columns, reproducing \"index out of range [3] with length 3\".","+\terrs := []error{","+\t\tencodeColumn(&enc, ColumnTypePath, pathBuilder),","+\t\tencodeColumn(&enc, ColumnTypeMinTimestamp, minBuilder),","+\t\tencodeColumn(&enc, ColumnTypeMaxTimestamp, maxBuilder),","+\t\tencodeColumn(&enc, ColumnTypeInvalid, futureBuilder),","+\t}","+\tif err := errors.Join(errs...); err != nil {","+\t\treturn 0, err","+\t}","+","+\tenc.SetTenant(b.tenant)","+\treturn enc.Flush(w)","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"pkg/dataobj/sections/indexpointers/row_reader.go","lines":["@@ -9,7 +9,6 @@ import ("," \t\"github.com/grafana/loki/v3/pkg/dataobj/internal/dataset\""," \t\"github.com/grafana/loki/v3/pkg/dataobj/internal/util/slicegrow\""," \t\"github.com/grafana/loki/v3/pkg/dataobj/internal/util/symbolizer\"","-\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/internal/columnar\""," )"," "," // RowReader is a reader for index pointers in a data object.","@@ -102,7 +101,7 @@ func (r *RowReader) Read(ctx context.Context, s []IndexPointer) (int, error) {"," }"," "," func (r *RowReader) initReader(ctx context.Context) error {","-\tdset, err := columnar.MakeDataset(r.sec.inner, r.sec.inner.Columns())","+\tdset, err := r.sec.makeDataset()"," \tif err != nil {"," \t\treturn fmt.Errorf(\"creating section dataset: %w\", err)"," \t}"],"additions":1,"deletions":2,"truncated":false},{"path":"pkg/dataobj/sections/logs/dataset_forward_compat_test.go","lines":["@@ -0,0 +1,66 @@","+package logs","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/dataset\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/result\"","+)","+","+// TestMakeColumnarDataset_ForwardCompatUnknownColumn guards the sortmerge path,","+// which lives in a package that can't import the internal columnar encoder and","+// so can't build a section carrying an unknown column itself.","+//","+// It reproduces sortmerge's exact composition — MakeColumnarDataset, then a row","+// reader feeding DecodeRow against Section.Columns() — over a section written","+// by a newer Loki. Before the funnel fix, MakeColumnarDataset built from every","+// physical column, so DecodeRow's positional lookup ran off the end of the","+// recognized columns and panicked.","+func TestMakeColumnarDataset_ForwardCompatUnknownColumn(t *testing.T) {","+\tobjBuilder := dataobj.NewBuilder(nil)","+\trequire.NoError(t, objBuilder.Append(&unknownColumnSectionBuilder{}))","+","+\tobj, closer, err := objBuilder.Flush()","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { _ = closer.Close() })","+","+\tsec, err := Open(t.Context(), obj.Sections()[0])","+\trequire.NoError(t, err)","+","+\trequire.Len(t, sec.inner.Columns(), 3, \"physical section should carry the unknown column\")","+\trequire.Len(t, sec.Columns(), 2, \"unknown column should be dropped from the typed view\")","+","+\tdset, err := MakeColumnarDataset(sec)","+\trequire.NoError(t, err)","+","+\tcolumns, err := result.Collect(dset.ListColumns(t.Context()))","+\trequire.NoError(t, err)","+","+\tr := dataset.NewRowReader(dataset.RowReaderOptions{","+\t\tDataset:  dset,","+\t\tColumns:  columns,","+\t\tPrefetch: true,","+\t})","+\tdefer r.Close()","+\trequire.NoError(t, r.Open(t.Context()))","+","+\tvar got []Record","+\tseq := NewDatasetSequence(r, 128)","+\tfor seq.Next() {","+\t\trow, err := seq.At().Value()","+\t\trequire.NoError(t, err)","+","+\t\tvar record Record","+\t\trequire.NoError(t, DecodeRow(sec.Columns(), row, &record, nil))","+\t\tgot = append(got, Record{StreamID: record.StreamID, Timestamp: record.Timestamp})","+\t}","+","+\trequire.Len(t, got, 2)","+\trequire.Equal(t, int64(1), got[0].StreamID)","+\trequire.Equal(t, int64(2), got[1].StreamID)","+\trequire.Equal(t, int64(10), got[0].Timestamp.UnixNano())","+\trequire.Equal(t, int64(30), got[1].Timestamp.UnixNano())","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"pkg/dataobj/sections/logs/iter.go","lines":["@@ -41,7 +41,7 @@ func Iter(ctx context.Context, obj *dataobj.Object) result.Seq[Record] {"," "," func IterSection(ctx context.Context, section *Section) result.Seq[Record] {"," \treturn result.Iter(func(yield func(Record) bool) error {","-\t\tdset, err := MakeColumnarDataset(section)","+\t\tdset, err := section.makeDataset()"," \t\tif err != nil {"," \t\t\treturn fmt.Errorf(\"creating columnar dataset: %w\", err)"," \t\t}","@@ -85,11 +85,21 @@ func IterSection(ctx context.Context, section *Section) result.Seq[Record] {"," // ColumnarDataset is the exported type alias of the internal [columnar.Dataset]."," type ColumnarDataset = columnar.Dataset"," ","-// MakeColumnarDataset returns the dataset from a section and a set of columns.","-// It returns an error if not all columns are from the provided section.","+// makeDataset builds a dataset from only the recognized columns, so rows stay","+// aligned with Columns() and columns from a newer Loki are skipped, not decoded.","+func (s *Section) makeDataset() (*columnar.Dataset, error) {","+\trecognized := s.Columns()","+\tinner := make([]*columnar.Column, len(recognized))","+\tfor i, col := range recognized {","+\t\tinner[i] = col.inner","+\t}","+\treturn columnar.MakeDataset(s.inner, inner)","+}","+","+// MakeColumnarDataset is the exported entry point for sortmerge, the only caller","+// outside this package; internal callers use makeDataset."," func MakeColumnarDataset(section *Section) (*ColumnarDataset, error) {","-\tcolumnarSection := section.inner","-\treturn columnar.MakeDataset(columnarSection, columnarSection.Columns())","+\treturn section.makeDataset()"," }"," "," // DecodeRow decodes a record from a [dataset.Row], using the provided columns"],"additions":15,"deletions":5,"truncated":false},{"path":"pkg/dataobj/sections/logs/iter_forward_compat_test.go","lines":["@@ -0,0 +1,117 @@","+package logs","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/dataset\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/metadata/datasetmd\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/internal/columnar\"","+)","+","+// TestIter_ForwardCompatUnknownColumn ensures an older reader can iterate a","+// logs section written by a newer Loki that added a column this reader doesn't","+// recognize, instead of panicking with an index-out-of-range in DecodeRow.","+func TestIter_ForwardCompatUnknownColumn(t *testing.T) {","+\tobjBuilder := dataobj.NewBuilder(nil)","+\trequire.NoError(t, objBuilder.Append(&unknownColumnSectionBuilder{}))","+","+\tobj, closer, err := objBuilder.Flush()","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { _ = closer.Close() })","+","+\tsec, err := Open(t.Context(), obj.Sections()[0])","+\trequire.NoError(t, err)","+","+\trequire.Len(t, sec.inner.Columns(), 3, \"physical section should carry the unknown column\")","+\trequire.Len(t, sec.Columns(), 2, \"unknown column should be dropped from the typed view\")","+","+\tvar got []Record","+\tfor res := range Iter(t.Context(), obj) {","+\t\tr, err := res.Value()","+\t\trequire.NoError(t, err)","+\t\tgot = append(got, Record{StreamID: r.StreamID, Timestamp: r.Timestamp})","+\t}","+","+\trequire.Len(t, got, 2)","+\trequire.Equal(t, int64(1), got[0].StreamID)","+\trequire.Equal(t, int64(2), got[1].StreamID)","+\trequire.Equal(t, int64(10), got[0].Timestamp.UnixNano())","+\trequire.Equal(t, int64(30), got[1].Timestamp.UnixNano())","+}","+","+// unknownColumnSectionBuilder is a test-only [dataobj.SectionBuilder] that","+// encodes a logs section with stream_id/timestamp columns plus one column whose","+// logical type is unknown to the current reader, standing in for a section","+// written by a newer version of Loki.","+type unknownColumnSectionBuilder struct{}","+","+func (b *unknownColumnSectionBuilder) Type() dataobj.SectionType { return sectionType }","+","+func (b *unknownColumnSectionBuilder) Reset() {}","+","+func (b *unknownColumnSectionBuilder) Flush(w dataobj.SectionWriter) (int64, error) {","+\tvar enc columnar.Encoder","+\tdefer enc.Reset()","+","+\tstreamIDs := []int64{1, 2}","+\ttimestamps := []int64{10, 30}","+","+\tstreamIDBuilder := newInt64ColumnBuilder(\"stream_id\", ColumnTypeStreamID.String())","+\ttimestampBuilder := newInt64ColumnBuilder(\"timestamp\", ColumnTypeTimestamp.String())","+\t// A column written by a newer Loki. Its logical type is unknown to","+\t// ParseColumnType, so an older reader drops it from Section.Columns().","+\tfutureBuilder := newInt64ColumnBuilder(\"future_field\", \"future_field\")","+","+\tfor i := range streamIDs {","+\t\t_ = streamIDBuilder.Append(i, dataset.Int64Value(streamIDs[i]))","+\t\t_ = timestampBuilder.Append(i, dataset.Int64Value(timestamps[i]))","+\t\t_ = futureBuilder.Append(i, dataset.Int64Value(int64(i+1)))","+\t}","+","+\t// The unknown column is encoded last so it lands at a physical index beyond","+\t// the recognized columns, reproducing the index-out-of-range panic.","+\tif err := encodeTestColumns(&enc, streamIDBuilder, timestampBuilder, futureBuilder); err != nil {","+\t\treturn 0, err","+\t}","+","+\tenc.SetTenant(\"tenant-1\")","+\treturn enc.Flush(w)","+}","+","+func newInt64ColumnBuilder(name, logical string) *dataset.ColumnBuilder {","+\tb, err := dataset.NewColumnBuilder(name, dataset.BuilderOptions{","+\t\tPageMaxRowCount: 100,","+\t\tType:            dataset.ColumnType{Physical: datasetmd.PHYSICAL_TYPE_INT64, Logical: logical},","+\t\tEncoding:        datasetmd.ENCODING_TYPE_DELTA,","+\t\tCompression:     datasetmd.COMPRESSION_TYPE_NONE,","+\t})","+\tif err != nil {","+\t\tpanic(err)","+\t}","+\treturn b","+}","+","+func encodeTestColumns(enc *columnar.Encoder, builders ...*dataset.ColumnBuilder) error {","+\tfor _, b := range builders {","+\t\tcolumn, err := b.Flush()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tcolumnEnc, err := enc.OpenColumn(column.ColumnDesc())","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tfor _, page := range column.Pages {","+\t\t\tif err := columnEnc.AppendPage(page); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t\tif err := columnEnc.Commit(); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+\treturn nil","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"pkg/dataobj/sections/logs/row_reader.go","lines":["@@ -14,7 +14,6 @@ import ("," \t\"github.com/grafana/loki/v3/pkg/dataobj/internal/metadata/datasetmd\""," \t\"github.com/grafana/loki/v3/pkg/dataobj/internal/util/slicegrow\""," \t\"github.com/grafana/loki/v3/pkg/dataobj/internal/util/symbolizer\"","-\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/internal/columnar\""," )"," "," // RowReader reads the set of logs from an [Object].","@@ -139,7 +138,7 @@ func unsafeString(data []byte) string {"," }"," "," func (r *RowReader) initReader(ctx context.Context) error {","-\tdset, err := columnar.MakeDataset(r.sec.inner, r.sec.inner.Columns())","+\tdset, err := r.sec.makeDataset()"," \tif err != nil {"," \t\treturn fmt.Errorf(\"creating section dataset: %w\", err)"," \t}"],"additions":1,"deletions":2,"truncated":false},{"path":"pkg/dataobj/sections/pointers/iter.go","lines":["@@ -40,8 +40,7 @@ func Iter(ctx context.Context, obj *dataobj.Object) result.Seq[SectionPointer] {"," "," func IterSection(ctx context.Context, section *Section) result.Seq[SectionPointer] {"," \treturn result.Iter(func(yield func(SectionPointer) bool) error {","-\t\tcolumnarSection := section.inner","-\t\tdset, err := columnar.MakeDataset(columnarSection, columnarSection.Columns())","+\t\tdset, err := section.makeDataset()"," \t\tif err != nil {"," \t\t\treturn fmt.Errorf(\"creating columns dataset: %w\", err)"," \t\t}","@@ -87,6 +86,17 @@ func IterSection(ctx context.Context, section *Section) result.Seq[SectionPointe"," \t})"," }"," ","+// makeDataset builds a dataset from only the recognized columns, so rows stay","+// aligned with Columns() and columns from a newer Loki are skipped, not decoded.","+func (s *Section) makeDataset() (*columnar.Dataset, error) {","+\trecognized := s.Columns()","+\tinner := make([]*columnar.Column, len(recognized))","+\tfor i, col := range recognized {","+\t\tinner[i] = col.inner","+\t}","+\treturn columnar.MakeDataset(s.inner, inner)","+}","+"," // decodeRow decodes a stream from a [dataset.Row], using the provided columns to"," // determine the column type. The list of columns must match the columns used"," // to create the row."],"additions":12,"deletions":2,"truncated":false},{"path":"pkg/dataobj/sections/pointers/iter_forward_compat_test.go","lines":["@@ -0,0 +1,123 @@","+package pointers","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/dataset\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/internal/metadata/datasetmd\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/internal/columnar\"","+)","+","+// TestIter_ForwardCompatUnknownColumn ensures an older reader can iterate a","+// pointers section written by a newer Loki that added a column this reader","+// doesn't recognize, instead of panicking with an index-out-of-range in","+// decodeRow.","+func TestIter_ForwardCompatUnknownColumn(t *testing.T) {","+\tobjBuilder := dataobj.NewBuilder(nil)","+\trequire.NoError(t, objBuilder.Append(&unknownColumnSectionBuilder{}))","+","+\tobj, closer, err := objBuilder.Flush()","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { _ = closer.Close() })","+","+\tsec, err := Open(t.Context(), obj.Sections()[0])","+\trequire.NoError(t, err)","+","+\trequire.Len(t, sec.inner.Columns(), 3, \"physical section should carry the unknown column\")","+\trequire.Len(t, sec.Columns(), 2, \"unknown column should be dropped from the typed view\")","+","+\tvar got []SectionPointer","+\tfor res := range Iter(t.Context(), obj) {","+\t\tp, err := res.Value()","+\t\trequire.NoError(t, err)","+\t\tgot = append(got, p)","+\t}","+","+\trequire.Len(t, got, 2)","+\trequire.Equal(t, \"path1\", got[0].Path)","+\trequire.Equal(t, \"path2\", got[1].Path)","+\trequire.Equal(t, int64(1), got[0].StreamID)","+\trequire.Equal(t, int64(2), got[1].StreamID)","+}","+","+// unknownColumnSectionBuilder is a test-only [dataobj.SectionBuilder] that","+// encodes a pointers section with path/stream_id columns plus one column whose","+// logical type is unknown to the current reader, standing in for a section","+// written by a newer version of Loki.","+type unknownColumnSectionBuilder struct{}","+","+func (b *unknownColumnSectionBuilder) Type() dataobj.SectionType { return sectionType }","+","+func (b *unknownColumnSectionBuilder) Reset() {}","+","+func (b *unknownColumnSectionBuilder) Flush(w dataobj.SectionWriter) (int64, error) {","+\tvar enc columnar.Encoder","+\tdefer enc.Reset()","+","+\tpaths := []string{\"path1\", \"path2\"}","+\tstreamIDs := []int64{1, 2}","+","+\tpathBuilder := newColumnBuilder(\"path\", ColumnTypePath.String(), datasetmd.PHYSICAL_TYPE_BINARY)","+\tstreamIDBuilder := newColumnBuilder(\"stream_id\", ColumnTypeStreamID.String(), datasetmd.PHYSICAL_TYPE_INT64)","+\t// A column written by a newer Loki. Its logical type is unknown to","+\t// ParseColumnType, so an older reader drops it from Section.Columns().","+\tfutureBuilder := newColumnBuilder(\"future_field\", \"future_field\", datasetmd.PHYSICAL_TYPE_INT64)","+","+\tfor i := range paths {","+\t\t_ = pathBuilder.Append(i, dataset.BinaryValue([]byte(paths[i])))","+\t\t_ = streamIDBuilder.Append(i, dataset.Int64Value(streamIDs[i]))","+\t\t_ = futureBuilder.Append(i, dataset.Int64Value(int64(i+1)))","+\t}","+","+\t// The unknown column is encoded last so it lands at a physical index beyond","+\t// the recognized columns, reproducing the index-out-of-range panic.","+\tif err := encodeTestColumns(&enc, pathBuilder, streamIDBuilder, futureBuilder); err != nil {","+\t\treturn 0, err","+\t}","+","+\tenc.SetTenant(\"tenant-1\")","+\treturn enc.Flush(w)","+}","+","+func newColumnBuilder(name, logical string, physical datasetmd.PhysicalType) *dataset.ColumnBuilder {","+\t// INT64 columns require DELTA encoding; binary columns use PLAIN.","+\tencoding := datasetmd.ENCODING_TYPE_PLAIN","+\tif physical == datasetmd.PHYSICAL_TYPE_INT64 {","+\t\tencoding = datasetmd.ENCODING_TYPE_DELTA","+\t}","+\tb, err := dataset.NewColumnBuilder(name, dataset.BuilderOptions{","+\t\tPageMaxRowCount: 100,","+\t\tType:            dataset.ColumnType{Physical: physical, Logical: logical},","+\t\tEncoding:        encoding,","+\t\tCompression:     datasetmd.COMPRESSION_TYPE_NONE,","+\t})","+\tif err != nil {","+\t\tpanic(err)","+\t}","+\treturn b","+}","+","+func encodeTestColumns(enc *columnar.Encoder, builders ...*dataset.ColumnBuilder) error {","+\tfor _, b := range builders {","+\t\tcolumn, err := b.Flush()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tcolumnEnc, err := enc.OpenColumn(column.ColumnDesc())","+\t\tif err != nil {","+\t\t\treturn 