, 12, 12, 3, 12 };","+        String[] rounds = new String[]{ \"2\", \"2\", \"2\", \"2\", \"2\", \"2\", \"1\" };"," ","         for (int a = 0; a != arcs.length; a++)","         {","             for (int leaf = 1; leaf <= leafCounts[a]; leaf++)","             {","-                ASN1ObjectIdentifier algOID = arcs[a].branch(Integer.toString(leaf));","+                ASN1ObjectIdentifier legacy = arcs[a].branch(Integer.toString(leaf));"," ","-                assertTrue(\"private key under bare leaf \" + algOID + \" is not turned away as unrecognised\",","-                    isRejectedAsUnrecognised(algOID));","-","-                SubjectPublicKeyInfo keyInfo = new SubjectPublicKeyInfo(new AlgorithmIdentifier(algOID), new byte[64]);","-                try","-                {","-                    PublicKeyFactory.createKey(keyInfo.getEncoded());","-                    fail(\"no exception for public key under bare leaf \" + algOID);","-                }","-                catch (IOException e)","-                {","-                    assertTrue(\"public key under bare leaf \" + algOID + \" rejected for another reason: \" + e,","-                        e.getMessage() != null && e.getMessage().indexOf(\"not recognised\") >= 0);","-                }","+                assertEquals(legacy.branch(rounds[a]), LegacyRoundOids.getCurrent(legacy));","+                assertFalse(\"private key under legacy leaf \" + legacy + \" is not recognised\",","+                    isRejectedAsUnrecognised(legacy));","             }","+            // the leaf after the last one was never a parameter set","+            assertNull(LegacyRoundOids.getCurrent(arcs[a].branch(Integer.toString(leafCounts[a] + 1))));","+        }","+","+        SecureRandom random = new SecureRandom();","+        AsymmetricCipherKeyPairGenerator[] generators = new AsymmetricCipherKeyPairGenerator[]","+        {","+            new SnovaKeyPairGenerator(), new FaestKeyPairGenerator(), new MQOMKeyPairGenerator(),","+            new UOVKeyPairGenerator(), new QRUOVKeyPairGenerator(), new SQIsignKeyPairGenerator(),","+            new SDitHKeyPairGenerator()","+        };","+        KeyGenerationParameters[] genParams = new KeyGenerationParameters[]","+        {","+            new SnovaKeyGenerationParameters(random, SnovaParameters.SNOVA_24_5_4_SSK),","+            new FaestKeyGenerationParameters(random, FaestParameters.faest_128s),","+            new MQOMKeyGenerationParameters(random, MQOMParameters.mqom2_cat1_gf2_fast_r3),","+            new UOVKeyGenerationParameters(random, UOVParameters.uov_Is),","+            new QRUOVKeyGenerationParameters(random, QRUOVParameters.qruov_1_q127_L3_v156_m54_shake),","+            new SQIsignKeyGenerationParameters(random, SQIsignParameters.sqisign_lvl1),","+            new SDitHKeyGenerationParameters(random, SDitHParameters.sdith_hypercube_cat1_gf256)","+        };","+","+        for (int i = 0; i != generators.length; i++)","+        {","+            generators[i].init(genParams[i]);","+            AsymmetricCipherKeyPair kp = generators[i].generateKeyPair();","+","+            PrivateKeyInfo privInfo = PrivateKeyInfoFactory.createPrivateKeyInfo(kp.getPrivate());","+            SubjectPublicKeyInfo pubInfo = SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(kp.getPublic());","+            ASN1ObjectIdentifier current = privInfo.getPrivateKeyAlgorithm().getAlgorithm();","+            String id = current.getId();","+            ASN1ObjectIdentifier legacy = new ASN1ObjectIdentifier(id.substring(0, id.lastIndexOf('.')));","+","+            assertEquals(current, LegacyRoundOids.getCurrent(legacy));","+            assertEquals(current, pubInfo.getAlgorithm().getAlgorithm());","+","+            byte[] legacyPriv = withAlgorithm(privInfo, 1, legacy);","+            byte[] legacyPub = withAlgorithm(pubInfo, 0, legacy);","+","+            assertTrue(current + \": private key not written under the current OID\", Arrays.areEqual(","+                privInfo.getEncoded(),","+                PrivateKeyInfoFactory.createPrivateKeyInfo(PrivateKeyFactory.createKey(legacyPriv)).getEncoded()));","+            assertTrue(current + \": public key not written under the current OID\", Arrays.areEqual(","+                pubInfo.getEncoded(),","+                SubjectPublicKeyInfoFactory.createSubjectPublicKeyInfo(PublicKeyFactory.createKey(legacyPub))","+                    .getEncoded()));","+        }","+    }","+","+    private static byte[] withAlgorithm(ASN1Encodable keyInfo, int algIndex, ASN1ObjectIdentifier algOID)","+        throws IOException","+    {","+        ASN1Sequence seq = ASN1Sequence.getInstance(keyInfo);","+        ASN1EncodableVector v = new ASN1EncodableVector();","+        for (int i = 0; i != seq.size(); i++)","+        {","+            v.add(i == algIndex ? new AlgorithmIdentifier(algOID) : seq.getObjectAt(i));","         }","+        return new DERSequence(v).getEncoded();","     }"," ","     /**"],"additions":93,"deletions":19,"truncated":false},{"path":"docs/releasenotes.md","lines":["@@ -34,7 +34,7 @@ Date: 2026, TBD"," "," #### Additional Notes"," ","-- The Bouncy Castle OIDs of the NIST additional-signature candidates now end in the round whose version they identify. Those of SNOVA, FAEST, MQOM, UOV, QR-UOV and SQIsign, whose implementations follow round 2, have .2 appended to their parameter-set leaves, and those of SDitH, whose implementation follows round 1, have .1 appended. The previous OIDs, used by SNOVA since 1.81 and by the others since 1.85, are no longer recognised. The key encodings are unchanged, so a stored key can be carried over by replacing its algorithm identifier, but certificates and signed structures carrying the previous OIDs need to be issued again. BCObjectIdentifiers also declares the OIDs, ending in .3 or taken from Open Quantum Safe, that the round-3 implementations will use. MAYO keeps its Open Quantum Safe OIDs and HAWK, withdrawn from the process, keeps its OIDs.","+- The BC OIDs of SNOVA, FAEST, MQOM, UOV, QR-UOV and SQIsign now end in .2 and those of SDitH in .1, the round implemented; the previous OIDs are still read but no longer written."," "," <a id=\"r1rv87\"></a>"," "],"additions":1,"deletions":1,"truncated":false},{"path":"prov/src/main/java/org/bouncycastle/jce/provider/BouncyCastleProvider.java","lines":["@@ -23,6 +23,7 @@"," import org.bouncycastle.crypto.CryptoServicePurpose;"," import org.bouncycastle.crypto.CryptoServicesRegistrar;"," import org.bouncycastle.asn1.iana.IANAObjectIdentifiers;","+import org.bouncycastle.internal.asn1.bc.LegacyRoundOids;"," import org.bouncycastle.internal.asn1.isara.IsaraObjectIdentifiers;"," import org.bouncycastle.jcajce.provider.asymmetric.lms.LMSKeyFactorySpi;"," import org.bouncycastle.jcajce.provider.config.ConfigurableProvider;","@@ -659,7 +660,8 @@ private static AsymmetricKeyInfoConverter getAsymmetricKeyInfoConverter(ASN1Obje","     {","         synchronized (keyInfoConverters)","         {","-            return (AsymmetricKeyInfoConverter)keyInfoConverters.get(algorithm);","+            // keys from 1.81 to 1.87 may name their parameter set by a legacy OID","+            return (AsymmetricKeyInfoConverter)keyInfoConverters.get(LegacyRoundOids.normalise(algorithm));","         }","     }"," "],"additions":3,"deletions":1,"truncated":false},{"path":"prov/src/main/java/org/bouncycastle/pqc/jcajce/provider/BouncyCastlePQCProvider.java","lines":["@@ -13,6 +13,7 @@"," import org.bouncycastle.asn1.ASN1ObjectIdentifier;"," import org.bouncycastle.asn1.pkcs.PrivateKeyInfo;"," import org.bouncycastle.asn1.x509.SubjectPublicKeyInfo;","+import org.bouncycastle.internal.asn1.bc.LegacyRoundOids;"," import org.bouncycastle.jcajce.provider.config.ConfigurableProvider;"," import org.bouncycastle.jcajce.provider.config.ProviderConfiguration;"," import org.bouncycastle.jcajce.provider.util.AlgorithmProvider;","@@ -67,6 +68,32 @@ public Object run()","     private void