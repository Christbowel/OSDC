t.ssl.SSLContext;","+import javax.net.ssl.SSLContextSpi;","+import javax.net.ssl.SSLEngine;","+import javax.net.ssl.SSLEngineResult;","+import javax.net.ssl.SSLException;","+import javax.net.ssl.SSLParameters;","+import javax.net.ssl.SSLServerSocketFactory;","+import javax.net.ssl.SSLSession;","+import javax.net.ssl.SSLSessionContext;","+import javax.net.ssl.SSLSocketFactory;","+import javax.net.ssl.TrustManager;","+import java.nio.ByteBuffer;","+import java.security.SecureRandom;","+import java.util.List;","+import java.util.function.BiFunction;","+","+/**","+ * An {@link SSLContext} that applies TLS key exchange named groups to every engine it creates.","+ * The JDK HTTP client does not carry {@link SSLParameters#getNamedGroups()} from its configured","+ * parameters to the engines, and resets them when it applies its parameters, so the engines","+ * re-apply the groups whenever parameters without groups are set.","+ *","+ * @since 5.3.0","+ */","+@Internal","+final class KeyExchangeGroupsSslContext extends SSLContext {","+","+    KeyExchangeGroupsSslContext(SSLContext delegate, String[] groups) {","+        super(new Spi(delegate, groups), delegate.getProvider(), delegate.getProtocol());","+    }","+","+    private static final class Spi extends SSLContextSpi {","+        private final SSLContext delegate;","+        private final String[] groups;","+","+        Spi(SSLContext delegate, String[] groups) {","+            this.delegate = delegate;","+            this.groups = groups;","+        }","+","+        @Override","+        protected void engineInit(KeyManager[] km, TrustManager[] tm, SecureRandom sr) {","+            throw new UnsupportedOperationException(\"Already initialized\");","+        }","+","+        @Override","+        protected SSLSocketFactory engineGetSocketFactory() {","+            return delegate.getSocketFactory();","+        }","+","+        @Override","+        protected SSLServerSocketFactory engineGetServerSocketFactory() {","+            return delegate.getServerSocketFactory();","+        }","+","+        @Override","+        protected SSLEngine engineCreateSSLEngine() {","+            return new GroupsEngine(delegate.createSSLEngine(), groups);","+        }","+","+        @Override","+        protected SSLEngine engineCreateSSLEngine(String host, int port) {","+            return new GroupsEngine(delegate.createSSLEngine(host, port), groups);","+        }","+","+        @Override","+        protected SSLSessionContext engineGetServerSessionContext() {","+            return delegate.getServerSessionContext();","+        }","+","+        @Override","+        protected SSLSessionContext engineGetClientSessionContext() {","+            return delegate.getClientSessionContext();","+        }","+","+        @Override","+        protected SSLParameters engineGetDefaultSSLParameters() {","+            SSLParameters parameters = delegate.getDefaultSSLParameters();","+            parameters.setNamedGroups(groups);","+            return parameters;","+        }","+","+        @Override","+        protected SSLParameters engineGetSupportedSSLParameters() {","+            return delegate.getSupportedSSLParameters();","+        }","+    }","+","+    private static final class GroupsEngine extends SSLEngine {","+        private final SSLEngine delegate;","+        private final String[] groups;","+","+        GroupsEngine(SSLEngine delegate, String[] groups) {","+            super(delegate.getPeerHost(), delegate.getPeerPort());","+            this.delegate = delegate;","+            this.groups = groups;","+            SSLParameters parameters = delegate.getSSLParameters();","+            parameters.setNamedGroups(groups);","+            delegate.setSSLParameters(parameters);","+        }","+","+        @Override","+        public void setSSLParameters(SSLParameters params) {","+            if (params.getNamedGroups() == null) {","+                params.setNamedGroups(groups);","+            }","+            delegate.setSSLParameters(params);","+        }","+","+        @Override","+        public SSLParameters getSSLParameters() {","+            return delegate.getSSLParameters();","+        }","+","+        @Override","+        public SSLEngineResult wrap(ByteBuffer[] srcs, int offset, int length, ByteBuffer dst) throws SSLException {","+            return delegate.wrap(srcs, offset, length, dst);","+        }","+","+        @Override","+        public SSLEngineResult unwrap(ByteBuffer src, ByteBuffer[] dsts, int offset, int length) throws SSLException {","+            return delegate.unwrap(src, dsts, offset, length);","+        }","+","+        @Override","+        public @Nullable Runnable getDelegatedTask() {","+            return delegate.getDelegatedTask();","+        }","+","+        @Override","+        public void closeInbound() throws SSLException {","+            delegate.closeInbound();","+        }","+","+        @Override","+        public boolean isInboundDone() {","+            return delegate.isInboundDone();","+        }","+","+        @Override","+        public void closeOutbound() {","+            delegate.closeOutbound();","+        }","+","+        @Override","+        public boolean isOutboundDone() {","+            return delegate.isOutboundDone();","+        }","+","+        @Override","+        public String[] getSupportedCipherSuites() {","+            return delegate.getSupportedCipherSuites();","+        }","+","+        @Override","+        public String[] getEnabledCipherSuites() {","+            return delegate.getEnabledCipherSuites();","+        }","+","+        @Override","+        public void setEnabledCipherSuites(String[] suites) {","+            delegate.setEnabledCipherSuites(suites);","+        }","+","+        @Override","+        public String[] getSupportedProtocols() {","+            return delegate.getSupportedProtocols();","+        }","+","+        @Override","+        public String[] getEnabledProtocols() {","+            return delegate.getEnabledProtocols();","+        }","+","+        @Override","+        public void setEnabledProtocols(String[] protocols) {","+            delegate.setEnabledProtocols(protocols);","+        }","+","+        @Override","+        public SSLSession getSession() {","+            return delegate.getSession();","+        }","+","+        @Override","+        public @Nullable SSLSession getHandshakeSession() {","+            return delegate.getHandshakeSession();","+        }","+","+        @Override","+        public void beginHandshake() throws SSLException {","+            delegate.beginHandshake();","+        }","+","+        @Override","+        public SSLEngineResult.HandshakeStatus getHandshakeStatus() {","+            return delegate.getHandshakeStatus();","+        }","+","+        @Override","+        public void setUseClientMode(boolean mode) {","+            delegate.setUseClientMode(mode);","+        }","+","+        @Override","+        public boolean getUseClientMode() {","+            return delegate.getUseClientMode();","+        }","+","+        @Override","+        public void setNeedClientAuth(boolean need) {","+            delegate.setNeedClientAuth(need);","+        }","+","+        @Override","+        public boolean getNeedClientAuth() {","+            return delegate.getNeedClientAuth();","+        }","+","+        @Override","+        public void setWantClientAuth(boolean want) {","+            delegate.setWantClientAuth(want);","+        }","+","+        @Override","+        public boolean getWantClientAuth() {","+            return delegate.getWantClientAuth();","+        }","+","+        @Override","+        public void setEnableSessionCreation(boolean flag) {","+            delegate.setEnableSessionCreation(flag);","+        }","+","+        @Override","+        public boolean getEnableSessionCreation() {","+            return delegate.getEnableSessionCreation();","+        }","+","+        @Override","+        public @Nullable String getApplicationProtocol() {","+            return delegate.getApplicationProtocol();","+        }","+","+        @Override","+        public @Nullable String getHandshakeApplicationProtocol() {","+            return delegate.getHandshakeApplicationProtocol();","+        }","+","+        @Override","+        public void setHandshakeApplicationProtocolSelector(BiFunction<SSLEngine, List<String>, String> selector) {","+            delegate.setHandshakeApplicationProtocolSelector(selector);","+        }","+","+        @Override","+        public BiFunction<SSLEngine, List<String>, String> getHandshakeApplicationProtocolSelector() {","+            return delegate.getHandshakeApplicationProtocolSelector();","+        }","+    }","+}"],"additions":281,"deletions":0,"truncated":false},{"path":"http-client-jdk/src/test/groovy/io/micronaut/http/client/jdk/KeyExchangeGroupsSslContextSpec.groovy","lines":["@@ -0,0 +1,125 @@","+package io.micronaut.http.client.jdk","+","+import spock.lang.Specification","+","+import javax.net.ssl.SSLContext","+import javax.net.ssl.SSLEngine","+import javax.net.ssl.SSLEngineResult","+import javax.net.ssl.SSLParameters","+import java.nio.ByteBuffer","+","+class KeyExchangeGroupsSslContextSpec extends Specification {","+","+    private static SSLContext base() {","+        SSLContext context = SSLContext.getInstance('TLS')","+        context.init(null, null, null)","+        return context","+    }","+","+    void \"engines start with the groups and keep them when parameters without groups are set\"() {","+        given:","+        SSLContext context = new KeyExchangeGroupsSslContext(base(), ['secp384r1', 'x25519'] as String[])","+","+        when:","+        SSLEngine engine = context.createSSLEngine('example.com', 443)","+","+        then:","+        engine.SSLParameters.namedGroups == ['secp384r1', 'x25519'] as String[]","+        engine.peerHost == 'example.com'","+        engine.peerPort == 443","+","+        when: 'the client applies its own parameters, which have no groups'","+        engine.SSLParameters = new SSLParameters(protocols: ['TLSv1.3'] as String[])","+","+        then:","+        engine.SSLParameters.namedGroups == ['secp384r1', 'x25519'] as String[]","+        engine.enabledProtocols == ['TLSv1.3'] as String[]","+","+        when: 'explicit groups are kept as they are'","+        def explicit = engine.SSLParameters","+        explicit.namedGroups = ['x25519'] as String[]","+        engine.SSLParameters = explicit","+","+        then:","+        engine.SSLParameters.namedGroups == ['x25519'] as String[]","+    }","+","+    void \"the context delegates and exposes the groups in its default parameters\"() {","+        given:","+        SSLContext delegate = base()","+        SSLContext context = new KeyExchangeGroupsSslContext(delegate, ['secp384r1'] as String[])","+","+        expect:","+        context.defaultSSLParameters.namedGroups == ['secp384r1'] as String[]","+        context.supportedSSLParameters.namedGroups != null","+        context.socketFactory != null","+        context.serverSocketFactory != null","+        context.clientSessionContext != null","+        context.serverSessionContext != null","+        context.protocol == delegate.protocol","+        context.provider == delegate.provider","+        context.createSSLEngine().SSLParameters.namedGroups == ['secp384r1'] as String[]","+","+        when:","+        context.init(null, null, null)","+","+        then:","+        thrown(UnsupportedOperationException)","+    }","+","+    void \"the engine delegates the handshake and its settings\"() {","+        given:","+        SSLEngine engine = new KeyExchangeGroupsSslContext(base(), ['x25519'] as String[]).createSSLEngine()","+","+        when:","+        engine.useClientMode = true","+        engine.needClientAuth = false","+        engine.wantClientAuth = false","+        engine.enableSessionCreation = true","+        engine.enabledCipherSuites = engine.supportedCipherSuites","+        engine.enabledProtocols = ['TLSv1.3'] as String[]","+        engine.handshakeApplicationProtocolSelector = { e, protocols -> null }","+","+        then:","+        engine.useClientMode","+        !engine.needClientAuth","+        !engine.wantClientAuth","+        engine.enableSessionCreation","+        engine.enabledCipherSuites.length > 0","+        engine.supportedProtocols.contains('TLSv1.3')","+        engine.handshakeApplicationProtocolSelector != null","+        engine.applicationProtocol == null","+        engine.handshakeApplicationProtocol == null","+","+        when: 'the ClientHello is written'","+        ByteBuffer out = ByteBuffer.allocate(engine.session.packetBufferSize)","+        engine.beginHandshake()","+        SSLEngineResult result = engine.wrap([ByteBuffer.allocate(0)] as ByteBuffer[], 0, 1, out)","+","+        then:","+        result.bytesProduced() > 0","+        engine.handshakeStatus == SSLEngineResult.HandshakeStatus.NEED_UNWRAP","+        engine.handshakeSession == null || engine.handshakeSession.protocol != null","+        engine.delegatedTask == null","+","+        when: 'nothing has arrived yet'","+        SSLEngineResult read = engine.unwrap(ByteBuffer.allocate(0), [ByteBuffer.allocate(engine.session.applicationBufferSize)] as ByteBuffer[], 0, 1)","+","+        then:","+        read.status == SSLEngineResult.Status.BUFFER_UNDERFLOW","+","+        when: 'closing still has a close_notify to write'","+        engine.closeOutbound()","+","+        then:","+        !engine.outboundDone","+        engine.handshakeStatus == SSLEngineResult.HandshakeStatus.NEED_WRAP","+","+        when:","+        engine.closeInbound()","+","+        then:","+        thrown(javax.net.ssl.SSLException)","+        engine.inboundDone","+    }","+}"],"additions":125,"deletions":0,"truncated":false},{"path":"http-client/src/main/java/io/micronaut/http/client/netty/ssl/NettyClientSslBuilder.java","lines":["@@ -21,6 +21,7 @@"," import io.micr