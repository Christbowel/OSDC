natorMode, Tran"," use vllm_metrics::CustomHistogramBuckets;"," use vllm_text::backend::hf::{HfOverrides, ModelSource};"," ","+use crate::fingerprint::FingerprintMode;"," use crate::routes::openai::utils::types::ReasoningEffort;"," "," /// Default keep-alive idle timeout (seconds); also the head-read bound","@@ -390,6 +391,8 @@ pub struct Config {","     pub stream_interval: NonZeroU32,","     /// HTTP/API-server behavior switches.","     pub api_server_options: ApiServerOptions,","+    /// What `system_fingerprint` reports on chat and completion responses.","+    pub fingerprint_mode: FingerprintMode,","     /// CORS settings applied to every HTTP response.","     pub cors: CorsConfig,","     /// HTTP access log settings."],"additions":3,"deletions":0,"truncated":false},{"path":"rust/src/server/src/fingerprint.rs","lines":["@@ -0,0 +1,126 @@","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+//! The `system_fingerprint` of chat and completion responses.","+","+use serde::Serialize;","+use vllm_engine_core_client::protocol::handshake::EngineCoreReadyResponse;","+","+/// What `system_fingerprint` reports (`--fingerprint-mode`).","+///","+/// Original Python definition: `vllm/entrypoints/serve/utils/fingerprint.py`.","+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]","+pub enum FingerprintMode {","+    /// `vllm-<version>[-tpN][-ppN][-dpN][-ep]-<hash8>`: the server version,","+    /// any non-trivial parallelism, and a prefix of the engine config hash.","+    #[default]","+    Full,","+    /// `vllm-<version>-<hash8>`.","+    Hash,","+    /// A literal string (`--fingerprint-value`).","+    Custom(String),","+    /// No fingerprint.","+    None,","+}","+","+impl FingerprintMode {","+    /// Build the fingerprint from the engines' ready responses and the","+    /// deployment-wide data-parallel size, like Python's","+    /// `build_system_fingerprint`.","+    pub(crate) fn fingerprint(","+        &self,","+        engines: &[&EngineCoreReadyResponse],","+        data_parallel_size: usize,","+    ) -> Option<String> {","+        // Dense DP ranks auto-fit `max_model_len` independently; hash the","+        // engine with the smallest one, the deployment's effective limit (the","+        // value Python's frontend keeps).","+        let ready = engines","+            .iter()","+            .min_by_key(|ready| ready.max_model_len)","+            .expect(\"engine core client requires at least one engine\");","+        let hash8 = || {","+            (ready.config_hash.as_deref()).map_or(\"nohash\", |hash| hash.get(..8).unwrap_or(hash))","+        };","+        match self {","+            Self::None => None,","+            Self::Custom(value) => Some(value.clone()),","+            Self::Hash => Some(format!(\"vllm-{}-{}\", ready.vllm_version, hash8())),","+            Self::Full => {","+                let mut parts = vec![format!(\"vllm-{}\", ready.vllm_version)];","+                if ready.tensor_parallel_size > 1 {","+                    parts.push(format!(\"tp{}\", ready.tensor_parallel_size));","+                }","+                if ready.pipeline_parallel_size > 1 {","+                    parts.push(format!(\"pp{}\", ready.pipeline_parallel_size));","+                }","+                if data_parallel_size > 1 {","+                    parts.push(format!(\"dp{data_parallel_size}\"));","+                }","+                if ready.enable_expert_parallel {","+                    parts.push(\"ep\".to_string());","+                }","+                parts.push(hash8().to_string());","+                Some(parts.join(\"-\"))","+            }","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use expect_test::expect;","+    use vllm_engine_core_client::mock_engine::default_ready_response;","+","+    use super::*;","+","+    #[test]","+    fn fingerprint_follows_python_modes() {","+        let ready = EngineCoreReadyResponse {","+            vllm_version: \"0.33.0\".to_string(),","+            tensor_parallel_size: 2,","+            pipeline_parallel_size: 1,","+            enable_expert_parallel: true,","+            config_hash: Some(\"c84c7d4f7a\".to_string()),","+            ..default_ready_response()","+        };","+        let unhashed = EngineCoreReadyResponse {","+            config_hash: None,","+            ..ready.clone()","+        };","+        let rows = [","+            (FingerprintMode::Full, vec![&ready], 4),","+            (FingerprintMode::Full, vec![&ready], 1),","+            (FingerprintMode::Full, vec![&unhashed], 1),","+            (FingerprintMode::Hash, vec![&ready], 4),","+            (FingerprintMode::Custom(\"fp-1\".to_string()), vec![&ready], 4),","+            (FingerprintMode::None, vec![&ready], 4),","+        ];","+        let fingerprints = rows.map(|(mode, engines, dp)| {","+            format!(\"{mode:?} dp{dp}: {:?}\", mode.fingerprint(&engines, dp))","+        });","+        expect![[r#\"","+            Full dp4: Some(\"vllm-0.33.0-tp2-dp4-ep-c84c7d4f\")","+            Full dp1: Some(\"vllm-0.33.0-tp2-ep-c84c7d4f\")","+            Full dp1: Some(\"vllm-0.33.0-tp2-ep-nohash\")","+            Hash dp4: Some(\"vllm-0.33.0-c84c7d4f\")","+            Custom(\"fp-1\") dp4: Some(\"fp-1\")","+            None dp4: None\"#]]","+        .assert_eq(&fingerprints.join(\"\\n\"));","+    }","+","+    #[test]","+    fn fingerprint_hashes_the_engine_with_the_smallest_max_model_len() {","+        // Dense DP ranks auto-fit `max_model_len` independently; the","+        // fingerprint uses the hash of the engine with the smallest one.","+        let engine = |max_model_len, config_hash: &str| EngineCoreReadyResponse {","+            vllm_version: \"0.33.0\".to_string(),","+            max_model_len,","+            config_hash: Some(config_hash.to_string()),","+            ..default_ready_response()","+        };","+        let engines = [engine(8192, \"cf9be74a00\"), engine(4096, \"e380051600\")];","+        let fingerprint = FingerprintMode::Hash.fingerprint(&[&engines[0], &engines[1]], 2);","+        assert_eq!(fingerprint.as_deref(), Some(\"vllm-0.33.0-e3800516\"));","+    }","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"rust/src/server/src/lib.rs","lines":["@@ -5,6 +5,7 @@"," "," mod config;"," mod error;","+mod fingerprint;"," mod grpc;"," mod listener;"," mod lora;","@@ -35,6 +36,7 @@ pub use config::{","     DEFAULT_REQUEST_BODY_LIMIT_BYTES, HttpListenerMode, LoraModulePath, OutputLogConfig,","     OutputLogging, TlsConfig,"," };","+pub use fingerprint::FingerprintMode;"," use hyper::body::Incoming;"," use hyper::server::conn::http1;"," use hyper_util::rt::{TokioIo, TokioTimer};","@@ -137,6 +139,9 @@ async fn build_state(config: &Config) -> Result<Arc<AppState>> {","     .await","     .context(\"failed to connect to engine core\")?;","     let server_info = ServerInfoSnapshot::new(config, &client);","+    let system_fingerprint = config","+        .fingerprint_mode","+        .fingerprint(&client.ready_responses(), client.data_parallel_size());"," ","     let llm = EngineCoreLlm::new(client)","         .with_log_stats(config.log_stats_interval.filter(|_| !config.disable_log_stats))","@@ -163,6 +168,7 @@ async fn build_state(config: &Config) -> Result<Arc<AppState>> {","         AppState::new(served_model_names, chat)","             .with_model_path(config.model.clone())","             .with_api_server_options(config.api_server_options)","+            .with_system_fingerprint(system_fingerprint)","             .with_server_info(server_info)","             .with_api_keys(config.api_keys.clone())","             .with_cors(config.cors.clone())"],"additions":6,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes/openai/chat_completions.rs","lines":["@@ -124,6 +124,7 @@ pub async fn chat_completions(","                     prepared.request_id.clone(),","                     prepared.response_mod