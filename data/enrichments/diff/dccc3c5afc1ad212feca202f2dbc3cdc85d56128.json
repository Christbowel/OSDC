.ts","lines":["@@ -8,7 +8,7 @@ import { checkSyncRateLimitDelay } from './ratelimit';"," "," const ongoingSyncs = new WeakMap<","   DexieCloudDB,","-  { promise: Promise<void>; pull: boolean }","+  { promise: Promise<void>; pull: boolean; cancelToken?: SyncOptions['cancelToken'] }"," >();"," "," export function syncIfPossible(","@@ -19,6 +19,13 @@ export function syncIfPossible("," ) {","   const ongoing = ongoingSyncs.get(db);","   if (ongoing) {","+    if (ongoing.cancelToken?.cancelled && !options?.cancelToken?.cancelled) {","+      // Reopening may race with a stopped worker's in-flight sync. Wait for","+      // its guarded job to settle, then retry instead of adopting its error.","+      return ongoing.promise.catch(() => {}).then(() =>","+        syncIfPossible(db, cloudOptions, cloudSchema, options)","+      );","+    }","     if (ongoing.pull || options?.purpose === 'push') {","       console.debug('syncIfPossible(): returning the ongoing sync promise.');","       return ongoing.promise;","@@ -64,7 +71,11 @@ export function syncIfPossible(","   }"," ","   const promise = _syncIfPossible();","-  ongoingSyncs.set(db, { promise, pull: options?.purpose !== 'push' });","+  ongoingSyncs.set(db, {","+    promise,","+    pull: options?.purpose !== 'push',","+    cancelToken: options?.cancelToken,","+  });","   return promise;"," ","   async function _syncIfPossible() {"],"additions":13,"deletions":2,"truncated":false},{"path":"addons/dexie-cloud/src/sync/triggerSync.ts","lines":["@@ -1,11 +1,11 @@"," import { DexieCloudDB } from '../db/DexieCloudDB';"," import { registerSyncEvent } from './registerSyncEvent';"," ","-export function triggerSync(db: DexieCloudDB, purpose: 'push' | 'pull') {","+export function triggerSync(db: DexieCloudDB, purpose: 'push' | 'pull', immediate = false) {","   if (db.cloud.usingServiceWorker) {","     console.debug('registering sync event');","     registerSyncEvent(db, purpose);","   } else {","-    db.localSyncEvent.next({ purpose });","+    db.localSyncEvent.next({ purpose, immediate });","   }"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"addons/dexie-cloud/test/unit/index.ts","lines":["@@ -1,3 +1,4 @@","+import './tests-local-sync-worker';"," import './tests-github-issues';"," import './tests-migrate-to-cloud';"," import './tests-schema';"],"additions":1,"deletions":0,"truncated":false},{"path":"addons/dexie-cloud/test/unit/tests-local-sync-worker.ts","lines":["@@ -0,0 +1,277 @@","+import { module, ok, equal } from 'qunit';","+import { Subject } from 'rxjs';","+import Dexie from 'dexie';","+import { promisedTest } from '../promisedTest';","+import { LocalSyncWorker } from '../../src/sync/LocalSyncWorker';","+import { sync } from '../../src/sync/sync';","+","+module('local-sync-worker');","+","+// Keep the real zero-delay timer so promise continuations run naturally, but","+// capture the long retry timers without making the tests wait 20 seconds.","+function captureRetryTimers() {","+  const originalSet = window.setTimeout;","+  const originalClear = window.clearTimeout;","+  const timers = new Map<number, { callback: () => void; delay: number }>();","+  let nextId = 1000000;","+  (window as any).setTimeout = (callback: () => void, delay: number) => {","+    if (delay < 20000) return originalSet(callback, delay);","+    const id = nextId++;","+    timers.set(id, { callback, delay });","+    return id;","+  };","+  (window as any).clearTimeout = (id: number) => {","+    if (!timers.delete(id)) originalClear(id);","+  };","+  return {","+    timers,","+    advance() {","+      const [id, timer] = timers.entries().next().value as [number, { callback: () => void; delay: number }];","+      timers.delete(id);","+      timer.callback();","+    },","+    restore() {","+      window.setTimeout = originalSet;","+      window.clearTimeout = originalClear;","+    },","+  };","+}","+","+function makeWorker(attempt: (...args: any[]) => Promise<void>) {","+  const localSyncEvent = new Subject<{ purpose: 'push' | 'pull'; immediate?: boolean }>();","+  const db = { localSyncEvent } as any;","+  const worker = LocalSyncWorker(db, {} as any, {} as any, attempt as any);","+  worker.start();","+  return { worker, localSyncEvent };","+}","+","+function flush() {","+  return new Promise<void>((resolve) => setTimeout(resolve, 10));","+}","+","+promisedTest('issue #2350: online wakes paused retry; normal mutations retain backoff', async () => {","+  const clock = captureRetryTimers();","+  let attempts = 0;","+  const { worker, localSyncEvent } = makeWorker(() => {","+    ++attempts;","+    return attempts === 1 ? Promise.reject(new Error('offline')) : Promise.resolve();","+  });","+  try {","+    localSyncEvent.next({ purpose: 'push' });","+    await flush();","+    equal(attempts, 1, 'first attempt failed');","+    equal([...clock.timers.values()][0].delay, 20000, 'first retry in 20 seconds');","+    localSyncEvent.next({ purpose: 'push' });","+    await flush();","+    equal(attempts, 1, 'ordinary mutation does not cancel backoff');","+    localSyncEvent.next({ purpose: 'push', immediate: true });","+    await flush();","+    equal(attempts, 2, 'online signal causes an immediate new attempt');","+    equal(clock.timers.size, 0, 'old retry timer was removed');","+  } finally {","+    worker.stop();","+    clock.restore();","+  }","+});","+","+promisedTest('issue #2350: failed pull is not silently downgraded to push on reconnect', async () => {","+  const clock = captureRetryTimers();","+  const purposes: string[] = [];","+  const { worker, localSyncEvent } = makeWorker((_db, _options, _schema, options) => {","+    purposes.push(options.purpose);","+    return purposes.length === 1 ? Promise.reject(new Error('offline')) : Promise.resolve();","+  });","+  try {","+    localSyncEvent.next({ purpose: 'pull' });","+    await flush();","+    localSyncEvent.next({ purpose: 'push', immediate: true });","+    await flush();","+    equal(purposes.join(','), 'pull,pull', 'recovery preserves original pull intent');","+  } finally {","+    worker.stop();","+    clock.restore();","+  }","+});","+","+promisedTest('issue #2350: failed immediate retry backs off again without overlap', async () => {","+  const clock = captureRetryTimers();","+  let attempts = 0;","+  const { worker, localSyncEvent } = makeWorker(() => {","+    ++attempts;","+    return Promise.reject(new Error('offline'));","+  });","+  try {","+    localSyncEvent.next({ purpose: 'push' });","+    await flush();","+    localSyncEvent.next({ purpose: 'push', immediate: true });","+    localSyncEvent.next({ purpose: 'push', immediate: true });","+    await flush();","+    equal(attempts, 2, 'two online signals before the attempt do not overlap');","+    equal([...clock.timers.values()][0].delay, 20000, 'new failure starts fresh backoff');","+    clock.advance();","+    await flush();","+    equal(attempts, 3, 'next scheduled retry happens once');","+    equal([...clock.timers.values()][0].delay, 40000, 'second retry in 40 seconds');","+  } finally {","+    worker.stop();","+    clock.restore();","+  }","+});","+","+promisedTest('issue #2350: online during a failed attempt retries once', async () => {","+  const clock = captureRetryTimers();","+  let attempts = 0;","+  let failAttempt: (error: Error) => void = () => {};","+  const { worker, localSyncEvent } = makeWorker(() => {","+    ++attempts;","+    return new Promise<void>((_resolve, reject) => { failAttempt = reject; });","+  });","+  try {","+    localSyncEvent.next({ purpose: 'push' });","+    await flush();","+    localSyncEvent.next({ purpose: 'push', immediate: true });","+    localSyncEvent.next({ purpose: 'push', immediate: true });","+    equal(attempts, 1, 'no overlapping request while old attempt is in flight');","+    failAttempt(new Error('network changed'));","+    await flush();","+    equal(attempts, 2, 'one prompt attempt after the failed in-flight request');","+    failAttempt(new Error('still offline'));","+    await flush();","+    equal(attempts, 2, 'wake was consumed: no endless immediate retries');","+    equal([...clock.timers.values()][0].delay, 20000, 'failure resumes backoff');","+  } finally {","+    worker.stop();","+    clock.restore();","+  }","+});","+","+promisedTest('issue #2350: stopped worker cannot retry after reopening', async () => {","+  const clock = captureRetryTimers();","+  let attempts = 0;","+  const first = makeWorker(() => {","+    ++attempts;","+    return Promise.reject(new Error('offline'));","+  });","+  try {","+    first.localSyncEvent.next({ purpose: 'push' });","+    await flush();","+    equal(clock.timers.size, 1, 'old worker has a pending retry');","+    first.worker.stop();","+    equal(clock.timers.size, 0, 'old retry timer removed on close');","+    const second = makeWorker(() => {","+      ++attempts;","+      return Promise.resolve();","+    });","+    try {","+      second.localSyncEvent.next({ purpose: 'push' });","+      await flush();","+      equal(attempts, 2, 'only reopened worker syncs');","+    } finally {","+      second.worker.stop();","+    }","+  } finally {","+    first.worker.stop();","+    clock.restore();","+  }","+});","+","+promisedTest('issue #2350: stop after timer fires blocks zero-delay launch', async () => {","+  const clock = captureRetryTimers();","+  let attempts = 0;","+  const { worker, localSyncEvent } = makeWorker(() => {","+    ++attempts;","+    return Promise.reject(new Error('offline'));","+  });","+  try {","+    localSyncEvent.next({ purpose: 'push' });","+    await flush();","+    clock.advance(); // Retry callback has fired, but the zero-delay launch has not.","+    worker.stop();","+    await flush();","+    equal(attempts, 1, 'stopped worker did not launch another request');","+  } finally {","+    worker.stop();","+    clock.restore();","+  }","+});","+","+promisedTest('issue #2350: cancelled sync does not persist stale error', async () => {","+  let persisted = false;","+  let emitted = false;","+  const db = {","+    $syncState: { update: () => { persisted = true; return Promise.resolve(); } },","+    syncStateChangedEvent: { next: () => { emitted = true; } },","+  } as any;","+  try {","+    await sync(db, {} as any, {} as any, { cancelToken: { cancelled: true } });","+  } catch (_error) { /* Expected invalid configuration or cancellation. */ }","+  ok(!persisted && !emitted, 'stopped worker cannot overwrite status');","+});","+","+promisedTest('issue #2350: cancellation rolls back a pending IndexedDB error write', async () => {","+  const db = new Dexie('issue2350-cancelled-error-write');","+  db.version(1).stores({ $syncState: '' });","+  await db.open();","+  const state = db.table('$syncState');","+  await state.put({ error: 'before' }, 'syncState');","+  const cancelToken = { cancelled: false };","+  const originalUpdate = state.update.bind(state);","+  let writeStarted: () => void = () => {};","+  const started = new Promise<void>((resolve) => { writeStarted = resolve; });","+  let releaseWrite: () => void = () => {};","+  const hold = new Promise<void>((resolve) => { releaseWrite = resolve; });","+  let emitted = false;","+  (state as any).update = async (key: string, changes: object) => {","+    const result = await originalUpdate(key, changes);","+    writeStarted();","+    await Dexie.waitFor(hold); // Keep the transaction open until close cancels it.","+    return result;","+  };","+  try {","+    const cloudDb = {","+      transaction: db.transaction.bind(db),","+      $syncState: state,","+      syncStateChangedEvent: { next: () => { emitted = true; } },","+    } as any;","+    const attempt = sync(cloudDb, {} as any, {} as any, { cancelToken }).catch(() => {});","+    await started;","+    cancelToken.cancelled = true;","+    releaseWrite();","+    await attempt;","+    equal((await state.get('syncState')).error, 'before', 'cancelled write rolled back');","+    ok(!emitted, 'old worker did not publish stale status');","+  } finally {","+    (state as any).update = originalUpdate;","+    releaseWrite();","+    db.close();","+    await db.delete();","+  }","+});","+","+promisedTest('issue #2350: close during error write aborts stale status', async () => {","+  const cancelToken = { cancelled: false };","+  let releaseWrite: () => void = () => {};","+  let writeStarted = false;","+  let emitted = false;","+  let aborted = false;","+  const db = {","+    $syncState: {","+      update: () => {","+        writeStarted = true;","+        return new Promise<void>((resolve) => { releaseWrite = resolve; });","+      },","+    },","+    transaction: async (_mode: string, _table: unknown, work: () => Promise<void>) => {","+      try { await work(); } catch (error) { aborted = true; throw error; }","+    },","+    syncStateChangedEvent: { next: () => { emitted = true; } },","+  } as any;","+  const attempt = sync(db, {} as any, {} as any, { cancelToken }).catch(() => {});","+  await flush();","+  ok(writeStarted, 'old worker reached the persisted error write');","+  cancelToken.cancelled = true;","+  releaseWrite();","+  await attempt;","+  ok(aborted, 'cancelled error write aborts its transaction');","+  ok(!emitted, 'old worker cannot publish error after reopen');","+});",""],"additions":277,"deletions":0,"truncated":false}],"additions":355,"deletions":20,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-19T15:00:26.745408+00:00"}