turn applyOptions(asset, opts)","+}","+","+// PrivateKeyAsset returns a valid private key asset.","+func PrivateKeyAsset(opts ...Option) types.CryptoAsset {","+\tasset := PublicKeyAsset()","+\tasset.KeyType = types.CryptoKeyTypePrivate","+\tasset.FilePath = \"/etc/example-private.pem\"","+\tasset.Key.Format = types.CryptoKeyFormatPKCS8","+\treturn applyOptions(asset, opts)","+}","+","+// EncryptedPrivateKeyAsset returns a valid encrypted private key asset.","+func EncryptedPrivateKeyAsset(opts ...Option) types.CryptoAsset {","+\tasset := PrivateKeyAsset()","+\tasset.Identity.Method = types.CryptoMethodEncryptedPKCS8SHA256","+\tasset.FilePath = \"/etc/example-encrypted-private.pem\"","+\tasset.Key.Encrypted = true","+\treturn applyOptions(asset, opts)","+}","+","+// RFC1423EncryptedPrivateKeyAsset returns a valid RFC 1423 encrypted private key asset.","+func RFC1423EncryptedPrivateKeyAsset(opts ...Option) types.CryptoAsset {","+\tasset := EncryptedPrivateKeyAsset()","+\tasset.Identity.Method = types.CryptoMethodEncryptedRFC1423SHA256","+\tasset.Key.Format = types.CryptoKeyFormatPKCS1","+\treturn applyOptions(asset, opts)","+}","+","+// AlgorithmAsset returns a valid algorithm asset.","+func AlgorithmAsset(opts ...Option) types.CryptoAsset {","+\tasset := types.CryptoAsset{","+\t\tKind: types.CryptoKindAlgorithm,","+\t\tIdentity: types.CryptoIdentity{","+\t\t\tMethod: types.CryptoMethodOID,","+\t\t\tValue:  \"1.2.840.113549.1.1.1\",","+\t\t},","+\t\tName:     \"RSA\",","+\t\tFilePath: \"/etc/example-algorithm.pem\",","+\t\tAlgorithm: &types.CryptoAlgorithm{","+\t\t\tFamily:    \"RSA\",","+\t\t\tPrimitive: types.CryptoPrimitivePKE,","+\t\t},","+\t}","+\treturn applyOptions(asset, opts)","+}","+","+func applyOptions(asset types.CryptoAsset, opts []Option) types.CryptoAsset {","+\tfor _, opt := range opts {","+\t\topt(&asset)","+\t}","+\treturn asset","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"internal/cryptotest/asset_test.go","lines":["@@ -0,0 +1,83 @@","+package cryptotest_test","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/aquasecurity/trivy/internal/cryptotest\"","+\t\"github.com/aquasecurity/trivy/pkg/fanal/types\"","+)","+","+func TestAssets(t *testing.T) {","+\tt.Parallel()","+","+\ttests := []struct {","+\t\tname   string","+\t\tasset  func(...cryptotest.Option) types.CryptoAsset","+\t\tmutate func(*types.CryptoAsset)","+\t}{","+\t\t{","+\t\t\tname:  \"certificate\",","+\t\t\tasset: cryptotest.CertificateAsset,","+\t\t\tmutate: func(asset *types.CryptoAsset) {","+\t\t\t\tasset.Certificate.Subject = \"changed\"","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:  \"public key\",","+\t\t\tasset: cryptotest.PublicKeyAsset,","+\t\t\tmutate: func(asset *types.CryptoAsset) {","+\t\t\t\tasset.Key.Size = 4096","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:  \"private key\",","+\t\t\tasset: cryptotest.PrivateKeyAsset,","+\t\t\tmutate: func(asset *types.CryptoAsset) {","+\t\t\t\tasset.Key.Size = 4096","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:  \"encrypted private key\",","+\t\t\tasset: cryptotest.EncryptedPrivateKeyAsset,","+\t\t\tmutate: func(asset *types.CryptoAsset) {","+\t\t\t\tasset.Key.Size = 4096","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:  \"RFC 1423 encrypted private key\",","+\t\t\tasset: cryptotest.RFC1423EncryptedPrivateKeyAsset,","+\t\t\tmutate: func(asset *types.CryptoAsset) {","+\t\t\t\tasset.Key.Size = 4096","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:  \"algorithm\",","+\t\t\tasset: cryptotest.AlgorithmAsset,","+\t\t\tmutate: func(asset *types.CryptoAsset) {","+\t\t\t\tasset.Algorithm.Family = \"changed\"","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\tfirst := tt.asset()","+\t\t\tsecond := tt.asset()","+\t\t\trequire.NoError(t, first.Validate())","+\t\t\trequire.NoError(t, second.Validate())","+\t\t\tassert.NotEmpty(t, first.FilePath)","+\t\t\tassert.Equal(t, first, second)","+","+\t\t\tmutated := tt.asset(cryptotest.WithMutate(tt.mutate))","+\t\t\tassert.NotEqual(t, first, mutated)","+","+\t\t\ttt.mutate(&first)","+\t\t\tassert.NotEqual(t, first, second)","+\t\t})","+\t}","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"internal/cryptotest/descriptor.go","lines":["@@ -0,0 +1,39 @@","+package cryptotest","+","+import \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+","+// CertificateDescriptor returns the descriptor of CertificateAsset.","+func CertificateDescriptor() types.CryptoDescriptor {","+\tasset := CertificateAsset()","+\treturn asset.Descriptor()","+}","+","+// PublicKeyDescriptor returns the descriptor of PublicKeyAsset.","+func PublicKeyDescriptor() types.CryptoDescriptor {","+\tasset := PublicKeyAsset()","+\treturn asset.Descriptor()","+}","+","+// PrivateKeyDescriptor returns the descriptor of PrivateKeyAsset.","+func PrivateKeyDescriptor() types.CryptoDescriptor {","+\tasset := PrivateKeyAsset()","+\treturn asset.Descriptor()","+}","+","+// EncryptedPrivateKeyDescriptor returns the descriptor of EncryptedPrivateKeyAsset.","+func EncryptedPrivateKeyDescriptor() types.CryptoDescriptor {","+\tasset := EncryptedPrivateKeyAsset()","+\treturn asset.Descriptor()","+}","+","+// RFC1423EncryptedPrivateKeyDescriptor returns the descriptor of RFC1423EncryptedPrivateKeyAsset.","+func RFC1423EncryptedPrivateKeyDescriptor() types.CryptoDescriptor {","+\tasset := RFC1423EncryptedPrivateKeyAsset()","+\treturn asset.Descriptor()","+}","+","+// AlgorithmDescriptor returns the descriptor of AlgorithmAsset.","+func AlgorithmDescriptor() types.CryptoDescriptor {","+\tasset := AlgorithmAsset()","+\treturn asset.Descriptor()","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"pkg/crypto/parser/x509/parser.go","lines":["@@ -0,0 +1,346 @@","+package x509","+","+import (","+\t\"context\"","+\tstdcrypto \"crypto\"","+\t\"crypto/dsa\"","+\t\"crypto/ecdsa\"","+\t\"crypto/ed25519\"","+\t\"crypto/rsa\"","+\t\"crypto/sha256\"","+\tstdx509 \"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"encoding/asn1\"","+\t\"encoding/hex\"","+\t\"encoding/pem\"","+\t\"errors\"","+","+\tftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+\t\"github.com/aquasecurity/trivy/pkg/log\"","+)","+","+// ObjectKind identifies the kind of parsed cryptographic object.","+type ObjectKind uint8","+","+const (","+\t// ObjectCertificate identifies an X.509 certificate.","+\tObjectCertificate ObjectKind = iota + 1","+\t// ObjectPrivateKey identifies a private key projected to its public key.","+\tObjectPrivateKey","+\t// ObjectPublicKey identifies a public key.","+\tObjectPublicKey","+\t// ObjectEncryptedPrivateKey identifies an opaque encrypted private key.","+\tObjectEncryptedPrivateKey","+)","+","+// EncryptionFormat identifies the container format of an encrypted private key.","+type EncryptionFormat uint8","+","+const (","+\t// EncryptionFormatPKCS8 identifies an encrypted PKCS#8 container.","+\tEncryptionFormatPKCS8 EncryptionFormat = iota + 1","+\t// EncryptionFormatRFC1423 identifies an RFC 1423 encrypted PEM container.","+\tEncryptionFormatRFC1423","+)","+","+// Object is a safe projection of a parsed cryptographic object.","+type Object struct {","+\t// Kind identifies the parsed object kind.","+\tKind ObjectKind","+\t// Certificate contains the parsed certificate for ObjectCertificate.","+\tCertificate *stdx509.Certificate","+\t// PublicKey contains a public key or the public projection of a private key.","+\tPublicKey any","+\t// EncryptedSHA256 contains the lowercase SHA-256 digest of an encrypted private-key container.","+\tEncryptedSHA256 string","+\t// EncryptionFormat identifies the encrypted private-key container format.","+\tEncryptionFormat EncryptionFormat","+\t// Encoding identifies the source encoding.","+\tEncoding ftypes.CryptoEncoding","+\t// KeyFormat identifies the source key container format.","+\tKeyFormat ftypes.CryptoKeyFormat","+}","+","+type encryptedPrivateKeyInfo struct {","+\tAlgorithm     pkix.AlgorithmIdentifier","+\tEncryptedData []byte","+}","+","+var (","+\terrNotCryptographic  = errors.New(\"not cryptographic\")","+\terrUnsupportedCrypto = errors.New(\"unsupported cryptographic object\")","+\terrMalformedCrypto   = errors.New(\"malformed cryptographic object\")","+)","+","+// Parse sniffs content because eligible extensions such as .crt, .cer, and .key do not reliably identify PEM or DER.","+// It decodes PEM blocks first, then falls back to DER when no valid PEM block is found.","+func Parse(ctx context.Context, filePath string, content []byte) []Object {","+\tctx = log.WithContextPrefix(ctx, \"x509\")","+\tvar objects []Object","+\tvar decodedPEM, recognized bool","+\t// pem.Decode scans past malformed leading data and returns the next valid block.","+\tfor rest := content; ; {","+\t\tblock, next := pem.Decode(rest)","+\t\tif block == nil {","+\t\t\tbreak","+\t\t}","+\t\tdecodedPEM = true","+\t\trest = next","+","+\t\tobject, err := parsePEMBlock(block)","+\t\tif errors.Is(err, errNotCryptographic) {","+\t\t\tcontinue","+\t\t}","+\t\trecognized = true","+\t\tif err != nil {","+\t\t\tlogParseError(ctx, filePath, block.Type, err)","+\t\t\tcontinue","+\t\t}","+\t\tobjects = append(objects, object)","+\t}","+","+\t// A decoded PEM file is complete even when none of its blocks is supported.","+\tif decodedPEM {","+\t\tif !recognized {","+\t\t\tlog.DebugContext(ctx, \"No cryptographic object found\", log.FilePath(filePath))","+\t\t}","+\t\treturn objects","+\t}","+","+\t// No PEM block was decoded, so try the whole file as DER.","+\tobject, err := parseDERObject(content)","+\tif err != nil {","+\t\tlogParseError(ctx, filePath, \"\", err)","+\t\treturn nil","+\t}","+\tobject.Encoding = ftypes.CryptoEncodingDER","+\treturn []Object{object}","+}","+","+// parsePEMBlock parses a supported PEM block and records its source encoding.","+func parsePEMBlock(block *pem.Block) (Object, error) {","+\tif block.Headers[\"Proc-Type\"] == \"4,ENCRYPTED\" || block.Headers[\"DEK-Info\"] != \"\" {","+\t\tobject, err := parseRFC1423EncryptedPrivateKey(block)","+\t\tif err != nil {","+\t\t\treturn Object{}, err","+\t\t}","+\t\tobject.Encoding = ftypes.CryptoEncodingPEM","+\t\treturn object, nil","+\t}","+","+\tobject, err := parsePEMObject(block.Type, block.Bytes)","+\tif err != nil {","+\t\treturn Object{}, err","+\t}","+","+\tobject.Encoding = ftypes.CryptoEncodingPEM","+\treturn object, nil","+}","+","+// parseRFC1423EncryptedPrivateKey validates an encrypted PEM block and retains only its canonical digest.","+func parseRFC1423EncryptedPrivateKey(block *pem.Block) (Object, error) {","+\tif block.Headers[\"Proc-Type\"] != \"4,ENCRYPTED\" || block.Headers[\"DEK-Info\"] == \"\" || len(block.Bytes) == 0 {","+\t\treturn Object{}, errMalformedCrypto","+\t}","+","+\tvar keyFormat ftypes.CryptoKeyFormat","+\tswitch block.Type {","+\tcase \"PRIVATE KEY\":","+\t\tkeyFormat = ftypes.CryptoKeyFormatPKCS8","+\tcase \"RSA PRIVATE KEY\":","+\t\tkeyFormat = ftypes.CryptoKeyFormatPKCS1","+\tcase \"EC PRIVATE KEY\":","+\t\tkeyFormat = ftypes.CryptoKeyFormatSEC1","+\tdefault:","+\t\treturn Object{}, errUnsupportedCrypto","+\t}","+","+\t// Re-encoding normalizes header order, line endings, and Base64 wrapping.","+\tencoded := pem.EncodeToMemory(block)","+\tif encoded == nil {","+\t\treturn Object{}, errMalformedCrypto","+\t}","+\tdigest := sha256.Sum256(encoded)","+\treturn Object{","+\t\tKind:             ObjectEncryptedPrivateKey,","+\t\tEncryptedSHA256:  hex.EncodeToString(digest[:]),","+\t\tEncryptionFormat: EncryptionFormatRFC1423,","+\t\tKeyFormat:        keyFormat,","+\t}, nil","+}","+","+func parsePEMObject(label string, der []byte) (Object, error) {","+\tswitch label {","+\tcase \"CERTIFICATE\":","+\t\tcertificate, err := stdx509.ParseCertificate(der)","+\t\tif err != nil {","+\t\t\treturn Object{}, errMalformedCrypto","+\t\t}","+\t\treturn Object{","+\t\t\tKind:        ObjectCertificate,","+\t\t\tCertificate: certificate,","+\t\t}, nil","+\tcase \"PRIVATE KEY\":","+\t\tprivateKey, err := stdx509.ParsePKCS8PrivateKey(der)","+\t\tif err != nil {","+\t\t\treturn Object{}, errMalformedCrypto","+\t\t}","+\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatPKCS8)","+\tcase \"RSA PRIVATE KEY\":","+\t\tprivateKey, err := stdx509.ParsePKCS1PrivateKey(der)","+\t\tif err != nil {","+\t\t\treturn Object{}, errMalformedCrypto","+\t\t}","+\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatPKCS1)","+\tcase \"EC PRIVATE KEY\":","+\t\tprivateKey, err := stdx509.ParseECPrivateKey(der)","+\t\tif err != nil {","+\t\t\treturn Object{}, errMalformedCrypto","+\t\t}","+\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatSEC1)","+\tcase \"PUBLIC KEY\":","+\t\tpublicKey, err := stdx509.ParsePKIXPublicKey(der)","+\t\tif err != nil {","+\t\t\treturn Object{}, errMalformedCrypto","+\t\t}","+\t\treturn publicKeyToObject(publicKey)","+\tcase \"ENCRYPTED PRIVATE KEY\":","+\t\tobject, ok := parseEncryptedPKCS8(der)","+\t\tif !ok {","+\t\t\treturn Object{}, errMalformedCrypto","+\t\t}","+\t\treturn object, nil","+\tcase \"CERTIFICATE REQUEST\",","+\t\t\"NEW CERTIFICATE REQUEST\",","+\t\t\"X509 CRL\",","+\t\t\"OPENSSH PRIVATE KEY\",","+\t\t\"RSA PUBLIC KEY\",","+\t\t\"DSA PRIVATE KEY\",","+\t\t\"DSA PUBLIC KEY\",","+\t\t\"EC PARAMETERS\",","+\t\t\"DH PARAMETERS\",","+\t\t\"DSA PARAMETERS\",","+\t\t\"TRUSTED CERTIFICATE\",","+\t\t\"PKCS7\",","+\t\t\"PKCS12\":","+\t\treturn Object{}, errUnsupportedCrypto","+\tdefault:","+\t\treturn Object{}, errNotCryptographic","+\t}","+}","+","+func parseDERObject(der []byte) (Object, error) {","+\t// The target ASN.1 DER structures have no common outer discriminator, so try their schema-specific parsers in order.","+\tif certificate, err := stdx509.ParseCertificate(der); err == nil {","+\t\treturn Object{","+\t\t\tKind:        ObjectCertificate,","+\t\t\tCertificate: certificate,","+\t\t}, nil","+\t}","+","+\tif privateKey, err := stdx509.ParsePKCS1PrivateKey(der); err == nil {","+\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatPKCS1)","+\t}","+","+\tif privateKey, err := stdx509.ParsePKCS8PrivateKey(der); err == nil {","+\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatPKCS8)","+\t}","+","+\tif privateKey, err := stdx509.ParseECPrivateKey(der); err == nil {","+\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatSEC1)","+\t}","+","+\tif publicKey, err := stdx509.ParsePKIXPublicKey(der); err == nil {","+\t\treturn publicKeyToObject(publicKey)","+\t}","+","+\tif object, ok := parseEncryptedPKCS8(der); ok {","+\t\treturn object, nil","+\t}","+","+\tif _, err := stdx509.ParseCertificateRequest(der); err == nil {","+\t\treturn Object{}, errUnsupportedCrypto","+\t}","+\tif _, err := stdx509.ParseRevocationList(der); err == nil {","+\t\treturn Object{}, errUnsupportedCrypto","+\t}","+","+\tvar raw asn1.RawValue","+\trest, err := asn1.Unmarshal(der, &raw)","+\tif err == nil && len(rest) == 0 && raw.Class == asn1.ClassUniversal && raw.Tag == asn1.TagSequence && raw.IsCompound {","+\t\treturn Object{}, errUnsupportedCrypto","+\t}","+\tif len(der) > 0 && der[0] == byte(asn1.TagSequence)|0x20 {","+\t\treturn Object{}, errMalformedCrypto","+\t}","+\treturn Object{}, errNotCryptographic","+}","+","+// privateKeyToObject converts a private key to an Object containing its public projection.","+func privateKeyToObject(privateKey any, format ftypes.CryptoKeyFormat) (Object, error) {","+\tsigner, ok := privateKey.(stdcrypto.Signer)","+\tif !ok {","+\t\treturn Object{}, errUnsupportedCrypto","+\t}","+\tpublicKey := signer.Public()","+\tif !isSupportedPublicKey(publicKey) {","+\t\treturn Object{}, errUnsupportedCrypto","+\t}","+\treturn Object{","+\t\tKind:      ObjectPrivateKey,","+\t\tPublicKey: publicKey,","+\t\tKeyFormat: format,","+\t}, nil","+}","+","+func publicKeyToObject(publicKey any) (Object, error) {",