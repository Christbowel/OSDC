   ],","+)"],"additions":21,"deletions":0,"truncated":false},{"path":"bazel/rules_cc/windows_cross_def_parser.patch","lines":["@@ -0,0 +1,13 @@","+--- a/cc/common/semantics.bzl","+@@ -56,7 +56,9 @@","+     if \"__DONT_DEPEND_ON_DEF_PARSER__\" in tags or \"def_parser\" in name:","+         return None","+     else:","+-        return Label(\"@bazel_tools//tools/def_parser:def_parser\")","++        # A Windows client using Linux execution platforms still needs the","++        # native parser; the default filegroup selects no_op.bat on Linux.","++        return Label(\"@@//bazel/rules_cc:def_parser\")","+ ","+ def _get_def_parser():","+     return attr.label("],"additions":12,"deletions":0,"truncated":false},{"path":"bazel/rules_cc/windows_cross_def_parser_test.py","lines":["@@ -0,0 +1,50 @@","+\"\"\"Validate rules_cc's parser selection for a Windows Bazel client.\"\"\"","+","+import ast","+import sys","+import unittest","+from pathlib import Path","+","+SEMANTICS = next(Path(arg) for arg in sys.argv[1:] if arg.endswith(\"/semantics.bzl\"))","+sys.argv[1:] = []","+","+","+class WindowsCrossDefParserTest(unittest.TestCase):","+    def test_windows_client_uses_native_parser_for_linux_exec_platforms(self) -> None:","+        tree = ast.parse(SEMANTICS.read_text())","+        function = next(","+            node","+            for node in tree.body","+            if isinstance(node, ast.FunctionDef) and node.name == \"_def_parser_computed_default\"","+        )","+        namespace = {\"Label\": str}","+        exec(","+            compile(ast.Module(body=[function], type_ignores=[]), str(SEMANTICS), \"exec\"), namespace","+        )","+        parser = namespace[function.name]","+        self.assertEqual(parser(\"gtest\", []), \"@@//bazel/rules_cc:def_parser\")","+        self.assertIsNone(parser(\"def_parser\", []))","+        self.assertIsNone(parser(\"malloc\", [\"__DONT_DEPEND_ON_DEF_PARSER__\"]))","+","+        build = ast.parse(Path(__file__).with_name(\"BUILD.bazel\").read_text())","+        alias = next(","+            node.value","+            for node in build.body","+            if isinstance(node, ast.Expr)","+            and isinstance(node.value, ast.Call)","+            and isinstance(node.value.func, ast.Name)","+            and node.value.func.id == \"alias\"","+        )","+        actual = next(keyword.value for keyword in alias.keywords if keyword.arg == \"actual\")","+        choices = ast.literal_eval(actual.args[0])","+        self.assertEqual(","+            choices[\"//bazel/config:windows_cross_local_container_actions_enabled\"],","+            \"@bazel_tools//tools/def_parser:def_parser.exe\",","+        )","+        self.assertEqual(","+            choices[\"//conditions:default\"], \"@bazel_tools//tools/def_parser:def_parser\"","+        )","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"additions":50,"deletions":0,"truncated":false},{"path":"bazel/rules_pkg/pkg_zip_test.bzl","lines":["@@ -0,0 +1,64 @@","+load(\"@bazel_skylib//lib:unittest.bzl\", \"analysistest\", \"asserts\")","+load(\"@internal_platforms_do_not_use//host:constraints.bzl\", \"HOST_CONSTRAINTS\")","+load(\"@rules_pkg//pkg:zip.bzl\", \"pkg_zip\")","+load(\"//bazel:skylib_test.bzl\", \"skylib_test_attrs\", \"skylib_test_end\")","+","+def _source_inputs_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    actions = [action for action in analysistest.target_actions(env) if action.mnemonic == \"PackageZip\"]","+    asserts.equals(env, 1, len(actions))","+    if len(actions) != 1:","+        return skylib_test_end(env)","+","+    inputs = actions[0].inputs.to_list()","+    basenames = [file.basename for file in inputs]","+    runfiles_inputs = [file.path for file in inputs if \".venv\" in file.path or \".runfiles\" in file.path]","+    if ctx.attr.source_only:","+        for source in [\"build_zip.py\", \"build_info.py\", \"manifest.py\", \"helpers.py\"]:","+            asserts.true(env, source in basenames, \"the Linux ZIP runner needs \" + source)","+        asserts.equals(env, [], runfiles_inputs, \"the Linux ZIP runner must not stage launcher runfiles or virtualenv trees\")","+        asserts.true(env, \"build_zip.exe\" in basenames if ctx.attr.windows_launcher else \"build_zip\" in basenames, \"the launcher must remain an explicit action input\")","+    else:","+        asserts.true(env, len(runfiles_inputs) > 0, \"native execution needs the launcher runfiles tree\")","+    if ctx.attr.windows_launcher:","+        asserts.true(env, actions[0].argv[0].endswith(\"build_zip.exe\"), \"the Windows fixture must use the production Windows launcher\")","+    return skylib_test_end(env)","+","+_source_inputs_test = analysistest.make(_source_inputs_test_impl, attrs = skylib_test_attrs() | {","+    \"source_only\": attr.bool(),","+    \"windows_launcher\": attr.bool(default = False),","+})","+_source_inputs_windows_test = analysistest.make(_source_inputs_test_impl, attrs = skylib_test_attrs(windows = True) | {","+    \"source_only\": attr.bool(),","+    \"windows_launcher\": attr.bool(default = True),","+})","+","+def pkg_zip_test_suite(name):","+    for windows in [False, True]:","+        # Constrain the ZIP fixture itself, since constraints on the analysis","+        # test do not affect target_under_test's launcher/toolchain selection.","+        exec_constraints = [\"@platforms//os:windows\"] if windows else HOST_CONSTRAINTS","+        compatibility = [\"@platforms//os:windows\"] if windows else select({","+            \"@platforms//os:windows\": [\"@platforms//:incompatible\"],","+            \"//conditions:default\": [],","+        })","+        test_rule = _source_inputs_windows_test if windows else _source_inputs_test","+        for source_only in [True, False]:","+            test_name = name + (\"\" if source_only else \"_native\") + (\"_windows_test\" if windows else \"\")","+            pkg_zip(","+                name = test_name + \"_input\",","+                srcs = [Label(\"//bazel/install_rules:msi_test.wxs\")],","+                build_zip_source_only = source_only,","+                exec_compatible_with = exec_constraints,","+                target_compatible_with = compatibility,","+                testonly = True,","+                tags = [\"manual\"],","+            )","+            test_rule(","+                name = test_name,","+                target_under_test = \":\" + test_name + \"_input\",","+                source_only = source_only,","+                exec_compatible_with = exec_constraints,","+                target_compatible_with = compatibility,","+                tags = [\"mongo_unittest\"],","+            )"],"additions":64,"deletions":0,"truncated":false},{"path":"bazel/rules_pkg/pkg_zip_windows_dll_path.patch","lines":["@@ -13,6 +13,15 @@ process start and exits with STATUS_DLL_NOT_FOUND (0xC0000135) before"," main() runs. Symptom: `PackageZip dist-test-stripped.zip failed:"," (Exit -1073741515)` when Bazel packages an archive on Windows CI."," ","+The cross-action container uses the Linux Python runtime to run the rules_pkg","+source directly instead of executing the Windows launcher. Include the","+transitive Python sources in the PackageZip action inputs so `build_zip.py`","+and its `pkg.private` dependencies are present in the container execroot.","+For build_zip_source_only, pass the launcher path as a string with explicit","+launcher/source inputs so Bazel does not attach its runfiles tree or unused","+Windows virtualenv. Native execution retains the launcher runfiles. Deep","+virtualenv paths can exceed Windows sandbox symlink path limits.","+"," Fix: inject env[\"PATH\"] = ctx.toolchains[\"@rules_python//python:toolchain_type\"]","     .py3_runtime.interpreter.dirname on Windows. Overrides the shell PATH"," Bazel would otherwise provide; no-op on Linux/macOS","@@ -21,12 +30,29 @@ Bazel would otherwise provide; no-op on Linux/macOS"," Applied via `single_version_override(patches=...)` on rules_pkg in"," //MODULE.bazel. Candidate for upstreaming to bazelbuild/rules_pkg."," ","-+++ b/pkg/private/zip/zip.bzl\t2026-07-14 23:06:33","-@@ -65,18 +65,32 @@","- ","-     all_inputs = depset(direct = inputs, transitive = mapping_context.file_deps)","- ","+--- a/pkg/private/zip/zip.bzl","+@@ -15 +15,3 @@","+-","++","++load(\"@rules_python//python:py_info.bzl\", \"PyInfo\")","++","+@@ -66 +68,28 @@","+-    all_inputs = depset(direct = inputs, transitive = mapping_context.file_deps)","++    build_zip = ctx.executable._build_zip","++    source_deps = []","++    if ctx.attr.build_zip_source_only:","++        # The cross-container wrapper runs build_zip.py with Linux Python.","++        # A path string avoids implicitly attaching the Windows launcher's","++        # runfiles tree, whose unused venv can exceed sandbox path limits.","++        inputs.append(build_zip)","++        source_deps.append(ctx.attr._build_zip[PyInfo].transitive_sources)","++        build_zip = build_zip.path","++    all_inputs = depset(","++        direct = inputs,","++        transitive = mapping_context.file_deps + source_deps,","++    )","++"," +    _env = {"," +        \"LANG\": \"en_US.UTF-8\","," +        \"LC_CTYPE\": \"UTF-8\",","@@ -34,24 +60,17 @@ Applied via `single_version_override(patches=...)` on rules_pkg in"," +        \"PYTHONUTF8\": \"1\","," +    }"," +","-+    # Windows fix: rules_python 2.x py_binary launcher.exe LoadLibrary's","-+    # python313.dll at process start. use_default_shell_env below gives the","-+    # action a Bazel-curated PATH that doesn't include the Python toolchain","-+    # directory (where python313.dll lives, co-located with python.exe in","-+    # python-build-standalone). Override PATH here so the launcher finds","-+    # the DLL. No-op on Linux/macOS.","++    # Native Windows launchers need the Python toolchain directory on PATH","++    # to load python313.dll before entering main()."," +    _py = ctx.toolchains[\"@rules_python//python:toolchain_type\"]"," +    if _py and _py.py3_runtime and _py.py3_runtime.interpreter:"," +        _interp = _py.py3_runtime.interpreter"," +        if _interp.basename.endswith(\".exe\"):"," +            _env[\"PATH\"] = _interp.dirname","-+","-     ctx.actions.run(","-         mnemonic = \"PackageZip\",","-         inputs = all_inputs,","-         executable = ctx.executable._build_zip,","-         arguments = [args],","-         outputs = [output_file],","+@@ -71 +100 @@","+-        executable = ctx.executable._build_zip,","++        executable = build_zip,","+@@ -74,6 +103 @@"," -        env = {"," -            \"LANG\": \"en_US.UTF-8\","," -            \"LC_CTYPE\": \"UTF-8\",","@@ -59,14 +78,15 @@ Applied via `single_version_override(patches=...)` on rules_pkg in"," -            \"PYTHONUTF8\": \"1\","," -        },"," +        env = _env,","-         use_default_shell_env = True,","-     )","-     return [","-@@ -88,6 +102,7 @@","- ","- pkg_zip_impl = rule(","-     implementation = _pkg_zip_impl,","+@@ -89 +113,2 @@","+-pkg_zip_impl = rule(","++pkg_zip_impl = rule("," +    toolchains = [\"@rules_python//python:toolchain_type\"],","-     # @unsorted-dict-items","-     attrs = {","-         \"srcs\": attr.label_list(","+@@ -159 +184,6 @@","+-        \"private_stamp_detect\": attr.bool(default = False),","++        \"private_stamp_detect\": attr.bool(default = False),","++","++        \"build_zip_source_only\": attr.bool(","++            doc = \"Declare only the ZIP launcher and Python sources. Requires a wrapper that runs the sources directly.\",","++            default = False,","++        ),"],"additions":48,"deletions":28,"truncated":false},{"path":"bazel/skylib_test.bzl","lines":["@@ -0,0 +1,16 @@","+\"\"\"Runfiles support for Skylib tests executed through MongoDB's test launchers.\"\"\"","+","+load(\"@bazel_skylib//lib:unittest.bzl\", \"analysistest\")","+","+def skylib_test_end(env):","+    \"\"\"Stage the launcher alongside Bazel's generated analysis-test executable.\"\"\"","+    launcher = env.ctx.attr._test_launcher[DefaultInfo]","+    runfiles = env.ctx.runfiles(transitive_files = launcher.files).merge(launcher.default_runfiles)","+    return analysistest.end(env) + [DefaultInfo(runfiles = runfiles)]","+","+def skylib_test_attrs(windows = False):","+    \"\"\"Select the launcher matching the test's execution platform.\"\"\"","+    return {\"_test_launcher\": attr.label(","+        default = Label(\"//bazel:windows_test_launcher\" if windows else \"//bazel:test_wrapper\"),","+        cfg = \"exec\",","+    )}"],"additions":16,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_container_action_wrapper.py","lines":["@@ -37,11 +37,12 @@"," import re"," import shlex"," import shutil","+import stat"," import subprocess"," import sys"," import tempfile"," import uuid","-from collections.abc import Iterator, Mapping, Sequence","+from collections.abc import Callable, Iterator, Mapping, Sequence"," "," sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[4]))"," from bazel.hermetic_container import container_paths","@@ -854,6 +855,102 @@ def _is_lld_link(tool: str) -> bool:","     }"," "," ","+def _rules_pkg_repo_relative_path(tool: str) -> pathlib.PurePosixPath | None:","+    \"\"\"Returns the rules_pkg path relative to the action's execroot.\"\"\"","+    parts = pathlib.PurePosixPath(tool.replace(\"\\\\\", \"/\")).parts","+    for index, part in enumerate(parts[:-1]):","+        if part == \"external\" and parts[index + 1].lower().startswith(\"rules_pkg+\"):","+            return pathlib.PurePosixPath(\"external\", *parts[index + 1 :])","+    return None","+","+","+def _is_rules_pkg_zip(tool: str) -> bool:","+    path = _rules_pkg_repo_relative_path(tool)","+    return path is not None and path.name.lower() == \"build_zip.exe\"","+","+","+def _rules_pkg_zip_source(tool: str) -> str:","+    path = _rules_pkg_repo_relative_path(tool)","+    if path is None or path.name.lower() != \"build_zip.exe\":","+        raise ValueError(f\"not a rules_pkg build_zip launcher: {tool}\")","+    return path.with_name(\"build_zip.py\").as_posix()","+","+","+def _rules_pkg_zip_pythonpath(tool: str) -> str | None:","+    path = _rules_pkg_repo_relative_path(tool)","+    if path is None or path.name.lower() != \"build_zip.exe\":","+        return None","+    return pathlib.PurePosixPath(*path.parts[:2]).as_posix()","+","+","+def _remove_rules_pkg_zip_source(directory: pathlib.Path) -> None:","+    \"\"\"Remove staged repository files, including Windows read-only cache copies.\"\"\"","+","+    def retry_writable(operation: Callable[[str], object], path: str, error: Exception) -> None:","+        if not isinstance(error, PermissionError):","+            raise error","+        os.chmod(path, stat.S_IREAD | stat.S_IWRITE)","+        operation(path)","+","+    try:","+        shutil.rmtree(directory, onexc=retry_writable)","+    except OSError as exc:","+        print(f\"WARNING: could not remove staged ZIP sources {directory}: {exc}\", file=sys.stderr)","+","+","+def _materialize_rules_pkg_zip_source(","+    output_base: pathlib.Path,","+    scratch_root: pathlib.Path,","+    prefix: str,","+    tool: str,","+) -> tuple[str, str, pathlib.Path | None]:","+    \"\"\"Copies the rules_pkg Python sources into the writable action scratch mount.","+","+    The rules_pkg launcher is a Windows executable, while the action container is Linux. Its","+    source runfiles are usually a junction into Bazel's repository cache, and passing one bind","+    mount per repository exceeds Windows' process command-line limit. Copy the small ``pkg``","+    source tree into the already-mounted scratch directory instead. The returned directory is","+    removed after the action completes.","+    \"\"\"","+    relative_source = pathlib.PurePosixPath(_rules_pkg_zip_source(tool))","+    relative_pythonpath = pathlib.PurePosixPath(","+        _rules_pkg_zip_pythonpath(tool) or \"external/rules_pkg+\"","+    )","+    candidates = (","+        output_base.joinpath(*relative_source.parts),","+        output_base.joinpath(\"execroot\", \"_main\", *relative_source.parts),","+    )","+    source: pathlib.Path | None = None","+    for candidate in candidates:","+        try:","+            if candidate.is_file():","+                source = candidate.resolve(strict=True)","+                break","+        except OSError:","+            continue","+    if source is None:","+        return relative_source.as_posix(), relative_pythonpath.as_posix(), None","+","+    destination = scratch_root / f\"rules-pkg-source-{uuid.uuid4().hex}\"","+    try:","+        scratch_root.mkdir(parents=True, exist_ok=True)","+        repository_root = source.parents[3]","+        shutil.copytree(","+            repository_root / \"pkg\",","+            destination / \"pkg\",","+            dirs_exist_ok=True,","+            ignore=shutil.ignore_patterns(\"__pycache__\", \"*.py[cod]\"),","+        )","+        container_source = _container_path(","+            destination.joinpath(*relative_source.parts[2:]), prefix","+        ).as_posix()","+        container_pythonpath = _container_path(destination, prefix).as_posix()","+    except (OSError, ValueError):","+        _remove_rules_pkg_zip_source(destination)","+        return relative_source.as_posix(), relative_pythonpath.as_posix(), None","+    return container_source, container_pythonpath, destination","+","+"," def _run_in_container(","     config: Mapping[str, object],","     config_path: pathlib.Path,","@@ -887,9 +984,17 @@ def _run_in_container(","         *_tool_command(tool),","         *tool_args,","     ]","-    env_file = _write_env_file(environment, scratch_root)","     temporary_files: list[pathlib.Path] = []","+    staged_source = None","+    if _is_rules_pkg_zip(tool):","+        source, pythonpath, staged_source = _materialize_rules_pkg_zip_source(","+            output_base, scratch_root, prefix, tool","+        )","+        