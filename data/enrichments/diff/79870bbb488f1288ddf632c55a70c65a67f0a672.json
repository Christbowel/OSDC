{"id":"79870bbb488f1288ddf632c55a70c65a67f0a672","axis":"silent","repo":"pnpm/pnpm","sha":"79870bbb488f1288ddf632c55a70c65a67f0a672","parsed":{"files":[{"path":".changeset/libsql-metadata.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+pnpr can keep hosted package metadata in a libSQL database, such as Turso, shared by several pnpr instances. Set `metadata.url` to a `libsql://` URL. It works with an `s3:` block, so archives stay in object storage. With `metadata.replicaPath`, each instance reads package documents from a local replica that syncs every `metadata.syncInterval`. Permission checks and the reads a write depends on always read the primary."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -7104,6 +7104,7 @@ name = \"pnpr-libsql\""," version = \"0.0.1\""," dependencies = [","  \"axum 0.8.9\",","+ \"base64 0.23.1\",","  \"http 0.2.12\",","  \"hyper 0.14.32\",","  \"libsql\",","@@ -7267,6 +7268,7 @@ dependencies = [","  \"futures-util\",","  \"getrandom 0.4.3\",","  \"libc\",","+ \"libsql\",","  \"object_store\",","  \"percent-encoding\",","  \"pnpm-crypto-hash\",","@@ -7274,6 +7276,7 @@ dependencies = [","  \"pnpm-package-manifest\",","  \"pnpr-config\",","  \"pnpr-error\",","+ \"pnpr-libsql\",","  \"pnpr-package-name\",","  \"pnpr-registry\",","  \"reqwest\","],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/backend_config.rs","lines":["@@ -24,8 +24,8 @@ pub enum BackendConfig {","     Mysql(SqlBackendSettings),"," }"," ","-/// The resolved record-store settings for libsql / Turso.","-#[derive(Clone)]","+/// The resolved settings of a libsql / Turso database.","+#[derive(Clone, PartialEq, Eq)]"," pub struct LibsqlSettings {","     /// libsql/Turso database URL, e.g. `libsql://db.turso.io` or","     /// `http://127.0.0.1:8080` for a local `sqld`.","@@ -298,7 +298,7 @@ pub(super) fn build_backend_config(","     };","     let mut selected = Vec::new();","     if let Som