lidConfig {","-            reason: \"backend.libsql.maxConnections must be greater than 0\".to_string(),","+            reason: format!(\"{key}.maxConnections must be greater than 0\"),","         });","     }","     Ok(LibsqlSettings {"],"additions":9,"deletions":13,"truncated":false},{"path":"pnpr/crates/config/src/config_file.rs","lines":["@@ -410,15 +410,15 @@ pub(super) struct BackendFile {"," #[derive(Debug, Deserialize)]"," #[serde(rename_all = \"camelCase\", deny_unknown_fields)]"," pub(super) struct LibsqlFile {","-    pub(super) url: String,","+    pub(crate) url: String,","     #[serde(default)]","-    pub(super) auth_token: Option<String>,","+    pub(crate) auth_token: Option<String>,","     #[serde(default)]","-    pub(super) replica_path: Option<PathBuf>,","+    pub(crate) replica_path: Option<PathBuf>,","     #[serde(default)]","-    pub(super) sync_interval: Option<Interval>,","+    pub(crate) sync_interval: Option<Interval>,","     #[serde(default)]","-    pub(super) max_connections: Option<u32>,","+    pub(crate) max_connections: Option<u32>,"," }"," "," #[derive(Debug, Deserialize)]"],"additions":5,"deletions":5,"truncated":false},{"path":"pnpr/crates/config/src/secrets.rs","lines":["@@ -161,7 +161,7 @@ fn validate_auth_secrets<Sys: EnvVar>(val: &serde_json::Value) -> Result<(), Reg"," }"," "," fn validate_database_secrets<Sys: EnvVar>(val: &serde_json::Value) -> Result<(), RegistryError> {","-    for prefix in [\"/backend/libsql\", \"/auth/libsql\", \"/storage/database\"] {","+    for prefix in [\"/backend/libsql\", \"/auth/libsql\", \"/storage/database\", \"/metadata\"] {","         for field in [\"authToken\", \"auth_token\"] {","             let ptr = format!(\"{prefix}/{field}\");","             if let Some(token) = val.pointer(&ptr).and_then(serde_json::Value::as_str) {"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/config/src/storage_config.rs","lines":["@@ -1,9 +1,10 @@"," //! Configuration for authoritative storage and disposable proxy cache."," "," use crate::{","-    ConfigFile, Deserialize, HostedStoreConfig, RegistryError,","+    ConfigFile, Deserialize, HostedStoreConfig, LibsqlSettings, RegistryError,","+    backend_config::build_libsql_settings,","     byte_size::{ByteSize, parse_byte_size},","-    config_file::CacheFile,","+    config_file::{CacheFile, LibsqlFile},","     upstream::{Interval, parse_interval},"," };"," use std::{","@@ -47,6 +48,9 @@ pub enum MetadataBackend {","     /// An embedded `SQLite` database at this path. Single-instance only, so","     /// only with the filesystem hosted store.","     Sqlite(PathBuf),","+    /// A libSQL database, such as a Turso primary, shared by every instance","+    /// and read through an embedded replica when one is configured.","+    Libsql(LibsqlSettings),"," }"," "," /// Disk shape of the `metadata:` block.","@@ -54,10 +58,25 @@ pub enum MetadataBackend {"," #[serde(rename_all = \"camelCase\", deny_unknown_fields)]"," pub(crate) struct MetadataFile {","     /// The metadata database: `sqlite:<path>`, with a relative path resolved","-    /// against the config file's directory. Without it, a filesystem hosted","-    /// store keeps its metadata in [`default_metadata_path`].","+    /// against the config file's directory, or a libSQL database","+    /// (`libsql://`, or `http://` and `https://` for a self-hosted `sqld`).","+    /// Without it, a filesystem hosted store keeps its metadata in","+    /// [`default_metadata_path`].","     #[serde(default)]","     url: Option<String>,","+    /// The libSQL database's bearer token.","+    #[serde(default)]","+    auth_token: Option<String>,","+    /// Where the libSQL database's embedded replica lives.","+    #[serde(default)]","+    replica_path: Option<PathBuf>,","+    /// How often the embedded replica pulls from the primary, which bounds","+    /// how stale a replica read may be.","+    #[serde(default)]","+    sync_interval: Option<Interval>,","+    /// Most libSQL operations running at once.","+    #[serde(default)]","+    max_connections: Option<u32>,","     /// `documents` keeps one document per package in a filesystem hosted","     /// store, as an object-store hosted store without a URL does.","     #[serde(default)]","@@ -84,45 +103,114 @@ pub(crate) fn resolve_metadata_backend(","     base_dir: &Path,","     hosted: &HostedStoreConfig,"," ) -> Result<MetadataBackend, RegistryError> {","-    let invalid = |reason: String| RegistryError::InvalidConfig { reason };","     let on_fs = matches!(hosted, HostedStoreConfig::Fs);","-    if let Some(MetadataFile {","-        url,","-        backend: Some(DocumentsBackend::Documents),","-    }) = file","-    {","-        if url.is_some() {","-            return Err(","-                invalid(\"metadata names both a `url` and `backend: documents`\".to_string()),","-            );","+    let Some(file) = file else { return Ok(default_metadata(storage, on_fs)) };","+    match (&file.url, file.backend) {","+        (Some(_), Some(DocumentsBackend::Documents)) => {","+            Err(invalid(\"metadata names both a `url` and `backend: documents`\"))","         }","-        return Ok(MetadataBackend::Documents);","+        (None, _) if has_libsql_settings(file) => Err(invalid(LIBSQL_ONLY_SETTINGS)),","+        (None, Some(DocumentsBackend::Documents)) => Ok(MetadataBackend::Documents),","+        (None, None) => Ok(default_metadata(storage, on_fs)),","+        (Some(url), None) if is_libsql_url(url) => libsql_metadata(file, url, base_dir),","+        (Some(url), None) => sqlite_metadata(file, url, base_dir, on_fs),","     }","-    let Some(url) = file.and_then(|file| file.url.as_deref()) else {","-        return Ok(if on_fs {","-            MetadataBackend::Sqlite(default_metadata_path(storage))","-        } else {","-            MetadataBackend::Documents","-        });","-    };","+}","+","+/// The metadata of a store without a metadata URL: `SQLite` in a filesystem","+/// store, documents