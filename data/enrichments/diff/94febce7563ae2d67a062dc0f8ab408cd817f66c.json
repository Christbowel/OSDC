{"id":"94febce7563ae2d67a062dc0f8ab408cd817f66c","axis":"silent","repo":"vllm-project/vllm","sha":"94febce7563ae2d67a062dc0f8ab408cd817f66c","parsed":{"files":[{"path":"tests/kernels/moe/test_flashinfer_moe_ep.py","lines":["@@ -1,6 +1,6 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project","-\"\"\"End-to-end tests for the FlashInfer MoE-EP adapter on real Blackwell GPUs.","+\"\"\"End-to-end tests for the FlashInfer MoE-EP adapter on Hopper and Blackwell GPUs."," "," Each test spawns one process per GPU, bootstraps vLLM's expert-parallel"," groups, builds a `FlashInferMoeEp` adapter from bf16 expert weights at the","@@ -11,9 +11,12 @@"," 32). The expected output is then known in closed form and compared bit for"," bit."," ","-A test that needs no SM100 also checks the adapter's kwargs against the","-installed FlashInfer's config types, so config drift fails on any CI runner","-with FlashInfer installed.","+On Hopper the same exact forward runs the SM90 FP8 megakernel on block-FP8","+weights (power-of-two scales per 128x128 block, FP8 activations per 1x128).","+","+Tests that need no GPU also check the adapter's kwargs against the installed","+FlashInfer's config types, so config drift fails on any CI runner with","+FlashInfer installed."," \"\"\""," "," from dataclasses import dataclass","@@ -24,15 +27,18 @@"," "," import vllm.model_executor.layers.fused_moe.modular_kernel as mk"," from tests.distributed.eplb_utils import distributed_run, set_env_vars_and_device","+from tests.kernels.moe.utils import make_dummy_moe_config"," from vllm.config import VllmConfig, set_current_vllm_config"," from vllm.config.kernel import FLASHINFER_MOE_EP_CUTEDSL, FLASHINFER_MOE_EP_DEEP_GEMM"," from vllm.distributed.parallel_state import ensure_model_parallel_initialized","+from vllm.forward_context import set_forward_context"," from vllm.model_executor.layers.fused_moe import flashinfer_moe_ep as fi_ep"," from vllm.model_executor.layers.fused_moe.activation import MoEActivation"," from vllm.model_executor.layers.fused_moe.config import (","     FusedMoEConfig,","     FusedMoEParallelConfig,","     RoutingMethodType,","+    fp8_w8a8_moe_quant_config,"," )"," from vllm.model_executor.layers.fused_moe.experts.flashinfer_moe_ep import (","     FlashInferMoeEpExperts,","@@ -41,10 +47,19 @@","     FlashInferMoeEp,","     FlashInferMoeEpWeights,","     apply_topk_in_fc1,","+    sm90_fp8_block_moe_ep_weights,","+)","+from vllm.model_executor.layers.fused_moe.prepare_finalize.passthrough import (","+    PassThroughPrepareAndFinalize,","+)","+from vllm.model_executor.layers.quantization.utils.quant_utils import (","+    kFp8Dynamic128Sym,","+    kFp8Static128BlockSym,","+    kMxfp4Static,"," )","-from vllm.model_executor.layers.quantization.utils.quant_utils import kMxfp4Static"," from vllm.platforms import current_platform"," from vllm.utils.import_utils import has_deep_gemm","+from vllm.v1.worker.workspace import init_workspace_manager"," "," "," @dataclass(frozen=True)","@@ -67,6 +82,14 @@ class Geometry:","     Geometry(\"mistral-large-3\", 7168, 4096, 128, 4),"," )"," BACKENDS = (FLASHINFER_MOE_EP_CUTEDSL, FLASHINFER_MOE_EP_DEEP_GEMM)","+# Routed-expert geometries of recent MoE models (Kimi-K3 at its 3584-wide","+# latent), run with synthetic block-FP8 weights on the Hopper megakernel.","+BLOCK_FP8_GEOMETRIES = (","+    Geometry(\"glm-5.3-flash\", 4096, 2048, 288, 8),","+    Geometry(\"deepseek-v4.1-flash\", 5120, 2304, 384, 6),","+    Geometry(\"kimi-k3\", 3584, 3072, 896, 16),","+    Geometry(\"qwen3.8-flash-next\", 2560, 640, 512, 10),","+)"," "," NUM_TOKENS_PER_RANK = 4"," MAX_TOKENS_PER_RANK = 128","@@ -81,6 +104,8 @@ class Geometry:"," # it; every weight column the sentinel meets is zero."," X_SIGNAL = 2.0"," X_SENTINEL = 6.0","+# FP8 activations take absmax / 448 per 1x128 group: 448 pins that scale to 1.","+X_SENTINEL_FP8 = 448.0"," # Gate and up rows are identical, so h = silu(12) * 12 = 144 = 6 * 24"," # whichever half the kernel treats as the gate, and 144 requantizes exactly."," W13_DIAG = 6.0","@@ -128,13 +153,15 @@ def _routing(","     return topk_ids, topk_weights"," "," ","-def _hidden_states(geometry: Geometry, device: torch.device) -> torch.Tensor:","+def _hidden_states(","+    geometry: Geometry, device: torch.device, sentinel: float = X_SENTINEL","+) -> torch.Tensor:","     x = torch.zeros(","         NUM_TOKENS_PER_RANK, geometry.hidden_size, dtype=torch.bfloat16, device=device","     )","     for t in range(NUM_TOKENS_PER_RANK):","         x[t, 16 * t] = X_SIGNAL","-        x[t, 16 * t + 1] = X_SENTINEL","+        x[t, 16 * t + 1] = sentinel","     return x"," "," ","@@ -165,6 +192,30 @@ def _local_expert_weights(","     return FlashInferMoeEpWeights(w13=w13, w2=w2)"," "," ","+def _block_fp8(weight: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:","+    \"\"\"Block FP8 with power-of-two scales: exact for the grid weights.\"\"\"","+    experts, rows, cols = weight.shape","+    blocks = weight.float().view(experts, rows // 128, 128, cols // 128, 128)","+    absmax = blocks.abs().amax(dim=(2, 4))","+    scale = torch.where(","+        absmax > 0,","+        torch.exp2(torch.ceil(torch.log2(absmax / 448.0))),","+        torch.ones_like(absmax),","+    )","+    quantized = blocks / scale[:, :, None, :, None]","+    return quantized.view(experts, rows, cols).to(torch.float8_e4m3fn), scale","+","+","+def _local_block_fp8_expert_weights(","+    geometry: Geometry, rank: int, num_local_experts: int, device: torch.device","+) -> FlashInferMoeEpWeights:","+    \"\"\"The grid weights in block FP8, in the oracle's SM90 kernel layout.\"\"\"","+    weights = _local_expert_weights(geometry, rank, num_local_experts, device)","+    w13, w13_scale = sm90_fp8_block_moe_ep_weights(*_block_fp8(weights.w13))","+    w2, w2_scale = _block_fp8(weights.w2)","+    return FlashInferMoeEpWeights(w13, w2, w13_scale, w2_scale)","+","+"," def _expected_output(","     geometry: Geometry, topk_ids: torch.Tensor, topk_weights: torch.Tensor"," ) -> torch.Tensor:","@@ -219,6 +270,7 @@ def _check_expert_views_alias_kernel_memory(","     rank: int,","     num_local_experts: int,","     device: torch.device,","+    sentinel: float = X_SENTINEL,"," ) -> None:","     \"\"\"EPLB moves experts through `expert_weight_views`; the kernel must see it."," ","@@ -236,19 +288,115 @@ def _check_expert_views_alias_kernel_memory(","     slot = topk_ids % num_local_experts","     physical_ids = torch.where(slot == 0, topk_ids + 1, topk_ids)","     physical_ids = torch.where(slot == 1, topk_ids - 1, physical_ids)","-    output = adapter(_hidden_states(geometry, device), physical_ids, topk_weights)","+    with torch.inference_mode():","+        output = adapter(","+            _hidden_states(geometry, device, sentinel), physical_ids, topk_weights","+        )","     torch.accelerator.synchronize()","     assert torch.equal(output, _expected_output(geometry, topk_ids, topk_weights))"," "," ","+def _check_block_fp8_modular_kernel(","+    vllm_config: VllmConfig,","+    geometry: Geometry,","+    moe: FusedMoEConfig,","+    rank: int,","+    device: torch.device,","+) -> None:","+    \"\"\"Block FP8 through the loading hook and `FusedMoEKernel`.","+","+    Rank 1 has no tokens, but the other ranks route to its experts and it owns","+    part of the collective, so it must still enter the megakernel. A full batch","+    on every rank is then replayed from a CUDA graph. The DP-wide token counts","+    come from the forward context, as in serving, so both use the 64-token","+    workspace.","+    \"\"\"","+    init_workspace_manager(device)","+    weights = _local_block_fp8_expert_weights(","+        geometry, rank, moe.num_local_experts, device","+    )","+    layer = torch.nn.Module()","+    for name, tensor in zip(","+        (\"w13_weight\", \"w13_weight_scale\", \"w2_weight\", \"w2_weight_scale\"),","+        (weights.w13, weights.w13_scale, weights.w2, weights.w2_scale),","+    ):","+        layer.register_parameter(name, torch.nn.Parameter(tensor, requires_grad=False))","+    layer.apply_router_weight_on_input = False","+    layer.expert_map_manager = SimpleNamespace(placement_strategy=\"linear\")","+    quant_config = fp8_w8a8_moe_quant_config(","+        w1_scale=weights.w13_scale, w2_scale=weights.w2_scale, block_shape=[128, 128]","+    )","+    experts = FlashInferMoeEpExperts(moe, quant_config)","+    experts.process_weights_after_loading(layer)","+    experts.keep_constants(layer)","+    assert layer.w13_weight.dtype == torch.float8_e4m3fn","+    kernel = mk.FusedMoEKernel(PassThroughPrepareAndFinalize(), experts)","+","+    topk_ids, topk_weights = _routing(geometry, rank, device)","+    hidden_states = _hidden_states(geometry, device, X_SENTINEL_FP8)","+    expected = _expected_output(geometry, topk_ids, topk_weights)","+    world_size = vllm_config.parallel_config.data_parallel_size","+    full = [NUM_TOKENS_PER_RANK] * world_size","+    idle = [0 if r == 1 else NUM_TOKENS_PER_RANK for r in range(world_size)]","+","+    def forward(across_dp: list[int]) -> torch.Tensor:","+        tokens = across_dp[rank]","+        with (","+            torch.inference_mode(),","+            set_forward_context(","+                None,","+                vllm_config,","+                num_tokens=tokens,","+                num_tokens_across_dp=torch.tensor(across_dp, dtype=torch.int32),","+            ),","+        ):","+            return kernel.apply(","+                hidden_states[:tokens],","+                layer.w13_weight,","+                layer.w2_weight,","+                topk_weights[:tokens],","+                topk_ids[:tokens],","+                MoEActivation.SILU,","+                geometry.num_experts,","+                None,","+                False,","+            )","+","+    try:","+        for across_dp in (full, idle):","+            output = forward(across_dp)","+            torch.accelerator.synchronize()","+            assert torch.equal(output, expected[: across_dp[rank]])","+","+        graph = torch.cuda.CUDAGraph()","+        with torch.cuda.graph(graph):","+            output = forward(full)","+        with torch.inference_mode():","+            output.zero_()","+        graph.replay()","+        torch.accelerator.synchronize()","+        assert torch.equal(output, expected)","+    finally:","+        assert experts._adapter is not None","+        experts._adapter.destroy()","+","+"," def _init_warmup_forward(","-    env: dict[str, str], world_size: int, geometry: Geometry, backend: str","+    env: dict[str, str],","+    world_size: int,","+    geometry: Geometry,","+    backend: str,","+    block_fp8: bool = False,"," ) -> None:","     set_env_vars_and_device(env)","     vllm_config = VllmConfig()","     vllm_config.parallel_config.data_parallel_size = world_size","     vllm_config.parallel_config.enable_expert_parallel = True","     vllm_config.kernel_config.moe_backend = backend","+    if block_fp8:","+        # What KernelConfig binds for megakernel backends.","+        vllm_config.parallel_config.all2all_backend = \"passthrough\"","+        vllm_config.parallel_config.data_parallel_rank = int(env[\"RANK\"])"," ","     with set_current_vllm_config(vllm_config):","         ensure_model_parallel_initialized(","@@ -257,25 +405,39 @@ def _init_warmup_forward(","         rank = torch.distributed.get_rank()","         device = torch.device(f\"cuda:{rank}\")","         moe = _moe_config(vllm_config, geometry, world_size, device, backend)","+        if block_fp8:","+            weight_key, activation_key = kFp8Static128BlockSym, kFp8Dynamic128Sym","+            make_weights = _local_block_fp8_expert_weights","+            sentinel = X_SENTINEL_FP8","+        else:","+            weight_key, activation_key = kMxfp4Static, None","+            make_weights = _local_expert_weights","+            sentinel = X_SENTINEL","         supported, reason = FlashInferMoeEpExperts.is_supported_config(","             FlashInferMoeEpExperts,","             moe,","-            kMxfp4Static,","-            None,","+            weight_key,","+            activation_key,","             mk.FusedMoEActivationFormat.Standard,","         )","         assert supported, reason"," ","         adapter = FlashInferMoeEp(","             moe,","-            _local_expert_weights(geometry, rank, moe.num_local_experts, device),","+            make_weights(geometry, rank, moe.num_local_experts, device),","             apply_topk_in_fc1=apply_topk_in_fc1(moe),","+            block_fp8=block_fp8,","         )","         try:","             adapter.warmup()"," ","             topk_ids, topk_weights = _routing(geometry, rank, device)","-            output = adapter(_hidden_states(geometry, device), topk_ids, topk_weights)","+            # Serving runs the model under inference mode, where the","+            # workspace warmup also allocates the kernel's buffers.","+            with torch.inference_mode():","+                output = adapter(","+                    _hidden_states(geometry, device, sentinel), topk_ids, topk_weights","+                )","             torch.accelerator.synchronize()"," ","             expected = _expected_output(geometry, topk_ids, topk_weights)","@@ -289,11 +451,14 @@ def _init_warmup_forward("," ","             if backend == FLASHINFER_MOE_EP_CUTEDSL:","                 _check_expert_views_alias_kernel_memory(","-                    adapter, geometry, rank, moe.num_local_experts, device","+                    adapter, geometry, rank, moe.num_local_experts, device, sentinel","                 )","         finally:","             adapter.destroy()"," ","+        if block_fp8:","+            _check_block_fp8_modular_kernel(vllm_config, geometry, moe, rank, device)","+"," "," @pytest.mark.skipif(","     not current_platform.is_device_capability_family(100),","@@ -313,6 +478,26 @@ def test_init_warmup_forward_is_exact_on_grid_inputs(","     distributed_run(_init_warmup_forward, world_size, geometry, backend)"," "," ","+@pytest.mark.skipif(","+    not current_platform.is_device_capability(90),","+    reason=\"The block-FP8 FlashInfer MoE-EP megakernel requires SM90\",","+)","+@pytest.mark.parametrize(","+    \"geometry\", BLOCK_FP8_GEOMETRIES, ids=[g.name for g in BLOCK_FP8_GEOMETRIES]","+)","+@pytest.mark.parametrize(\"world_size\", [2, 4])","+def test_block_fp8_init_warmup_forward_is_exact_on_grid_inputs(","+    world_size: int, geometry: Geometry","+):","+    pytest.importorskip(\"flashinfer.moe_ep\")","+    pytest.importorskip(\"nvshmem.core\")","+    if torch.accelerator.device_count() < world_size:","+        pytest.skip(f\"Need at least {world_size} GPUs\")","+    distributed_run(","+        _init_warmup_forward, world_size, geometry, FLASHINFER_MOE_EP_CUTEDSL, True","+    )","+","+"," @pytest.mark.parametrize(\"backend\", BACKENDS, ids=(\"cutedsl\", \"deep_gemm\"))"," def test_adapter_kwargs_match_installed_flashinfer(","     monkeypatch: pytest.MonkeyPatch, backend: str","@@ -324,11 +509,215 @@ def test_adapter_kwargs_match_installed_flashinfer(","     index and the DeepGEMM import.","     \"\"\"","     moe_ep = pytest.importorskip(\"flashinfer.moe_ep\")","+    layer_args = _fake_mega_layer(monkeypatch, moe_ep)","+    moe = _adapter_moe(backend, GEOMETRIES[0])","+    weight = torch.zeros(1, dtype=torch.bfloat16)","+    FlashInferMoeEp(","+        moe,","+        FlashInferMoeEpWeights(w13=weight, w2=weight),","+        apply_topk_in_fc1=apply_topk_in_fc1(moe),","+    )","+","+    ((_, _, _, mega_config),) = layer_args","+    expected = (","+        moe_ep.Nvfp4CutedslMegaMoeConfig","+        if backend == FLASHINFER_MOE_EP_CUTEDSL","+        else moe_ep.DeepGemmMegaMoeConfig","+    )","+    assert isinstance(mega_config.megakernel, expected)","+","+","+def test_block_fp8_adapter_hands_kernel_ready_weights_to_flashinfer(","+    monkeypatch: pytest.MonkeyPatch,","+):","+    \"\"\"Block-FP8 weights build the SM90 config and skip FlashInfer's own","+    preprocessing, which would requantize them from bf16. The kernel tensors","+    bound back to the layer keep their dtypes, so a rebuild from them (e.g.","+    preprocessed-weight loading) selects the same kernel.\"\"\"","+    moe_ep = pytest.importorskip(\"flashinfer.moe_ep\")","+    workspace_capacities: list[int] = []","+    layer_args = _fake_mega_layer(monkeypatch, moe_ep, workspace_capacities)","+    moe = _adapter_moe(FLASHINFER_MOE_EP_CUTEDSL, TINY_BLOCK_FP8)","+    weights = _tiny_block_fp8_weights()","+    adapter = FlashInferMoeEp(","+        moe, weights, apply_topk_in_fc1=apply_topk_in_fc1(moe), block_fp8=True","+    )","+    w13, w13_scale, w2, w2_scale = adapter.kernel_weights()","+    FlashInferMoeEp(","+        moe,","+        FlashInferMoeEpWeights(w13=w13, w2=w2, w13_scale=w13_scale, w2_scale=w2_scale),","+        apply_topk_in_fc1=apply_topk_in_fc1(moe),","+        block_fp8=True,","+    )","+","+    assert [t.dtype for t in (w13, w13_scale, w2, w2_scale)] == [","+        torch.float8_e4m3fn,","+        torch.float32,","+        torch.float8_e4m3fn,","+        torch.float32,","+    ]","+    (_, _, weight_pack, mega_config), (_, _, _, rebuilt) = layer_args","+    assert isinstance(rebuilt.megakernel, moe_ep.Sm90PullFp8MegaMoeConfig)","+    assert _kernel_storage(rebuilt) == _kernel_storage(mega_config)","+    assert weight_pack is None and not mega_config.preprocess_weights","+    # Batches up to 64 tokens get their own workspace below the 128 maximum.","+    assert workspace_capacities == [64, 64]","+    megakernel = mega_config.megakernel","+    assert isinstance(megakernel, moe_ep.Sm90PullFp8MegaMoeConfig)","+    assert megakernel.fp8_scale_mode == \"blockwise\"","+    assert megakernel.gate_up_clamp == moe.swiglu_limit","+    (fc1, _, *_), (fc2, _, *_) = mega_config.transformed_weights","+    hidden, intermediate = TINY_BLOCK_FP8.hidden_size, TINY_BLOCK_FP8.intermediate_size","+    # (E, K, N) views over the layer's storage, K contiguous.","+    assert fc1.shape == (2, hidden, 2 * intermediate) and fc1.stride(1) == 1","+    assert fc2.shape == (2, intermediate, hidden) and fc2.stride(1) == 1","+    assert weights.w13_scale is not None and weights.w2_scale is not None","+    assert _kernel_storage(mega_config) == [","+        t.data_ptr()","+        for t in (weights.w13, weights.w13_scale, weights.w2, weights.w2_scale)","+    ]","+","+","+def test_block_fp8_workspace_follows_the_dp_wide_batch(","+    monkeypatch: pytest.MonkeyPatch,","+):","+    \"\"\"Every EP rank must launch on the same workspace, so the size comes from","+    the DP-wide token counts, and without them the default workspace is used.\"\"\"","+    moe_ep = pytest.importorskip(\"flashinfer.moe_ep\")","+    used: list[object] = []","+    _fake_mega_layer(monkeypatch, moe_ep, [], used)","+    moe = _adapter_moe(FLASHINFER_MOE_EP_CUTEDSL, TINY_BLOCK_FP8)","+    adapter = FlashInferMoeEp(","+        moe,","+        _tiny_block_fp8_weights(),","+        apply_topk_in_fc1=apply_topk_in_fc1(moe),","+        block_fp8=True,","+    )","+    hidden_states = torch.zeros(3, TINY_BLOCK_FP8.hidden_size, dtype=torch.bfloat16)","+    topk_ids = torch.zeros(3, TINY_BLOCK_FP8.top_k, dtype=torch.int32)","+    topk_weights = torch.ones(3, TINY_BLOCK_FP8.top_k)","+","+    adapter(hidden_states, topk_ids, topk_weights)","+    vllm_config = VllmConfig()","+    vllm_config.parallel_config.data_parallel_size = 2","+    for across_dp in ([3, 64], [3, 65]):","+        with set_forward_context(","+            None,","+            vllm_config,","+            num_tokens=3,","+            num_tokens_across_dp=torch.tensor(across_dp, dtype=torch.int32),","+        ):","+            adapter(hidden_states, topk_ids, topk_weights)","+","+    assert used == [None, (\"workspace\", 64), None]","+","+","+def _quantize_block_fp8(real: torch.Tensor, power_of_two: bool):","+    *lead, rows, cols = real.shape","+    blocks = real.reshape(*lead, rows // 128, 128, cols // 128, 128)","+    scale = blocks.abs().amax(dim=(-3, -1)) / 448.0","+    if power_of_two:","+        scale = torch.exp2(torch.ceil(torch.log2(scale)))","+    return (real / _per_element(scale)).to(torch.float8_e4m3fn), scale","+","+","+def _per_element(scale: torch.Tensor) -> torch.Tensor:","+    return scale.repeat_interleave(128, -2).repeat_interleave(128, -1)","+","+","+def _gate_up_interleaved(w13: torch.Tensor) -> torch.Tensor:","+    \"\"\"Rows ordered [pair, {gate, up}, 8], the SM90 megakernel's FC1 layout.\"\"\"","+    experts, rows, cols = w13.shape","+    gate, up = w13.view(experts, 2, rows // 16, 8, cols).unbind(1)","+    return torch.stack((gate, up), dim=2).reshape(experts, rows, cols)","+","+","+@pytest.mark.parametrize(\"power_of_two\", [True, False])","+def test_sm90_fp8_block_weights_keep_checkpoint_values(power_of_two: bool):","+    \"\"\"Interleaving gate and up rows puts two checkpoint blocks under one scale.","+","+    Power-of-two scales survive that up to rounding below the E4M3 normal","+    range; other scales round the rescaled half once.","+    \"\"\"","+    torch.manual_seed(0)","+    real = torch.randn(2, 512, 256) * 0.02","+    # Gate blocks 8x the up blocks, so each interleaved block mixes scales.","+    real[:, :256] *= 8.0","+    w13, scale = _quantize_block_fp8(real, power_of_two)","+","+    kernel_w13, kernel_scale = sm90_fp8_block_moe_ep_weights(w13, scale)","+","+    assert kernel_w13.dtype == w13.dtype and kernel_w13.shape == w13.shape","+    assert kernel_scale.shape == scale.shape","+    restored = kernel_w13.float() * _per_element(kernel_scale)","+    expected = _gate_up_interleaved(w13.float() * _per_element(scale))","+    error = (restored - expected).abs()","+    if power_of_two:","+        # Half the smallest E4M3 subnormal step.","+        assert torch.all(error <= 2.0**-10 * _per_element(kernel_scale))","+    else:","+        assert (error.norm() / expected.norm()).item() < 0.03","+","+","+def test_block_fp8_megakernel_rejects_input_side_router_weights():","+    \"\"\"The SM90 kernel weights the activation before fc2, which is not the same","+    as weighting the expert input (apply_router_weight_on_input).\"\"\"","+    moe = make_dummy_moe_config(","+        num_experts=8, experts_per_token=2, hidden_dim=256, intermediate_size=128","+    )","+    quant_config = fp8_w8a8_moe_quant_config(","+        w1_scale=torch.ones(8, 2, 2),","+        w2_scale=torch.ones(8, 2, 1),","+        block_shape=[128, 128],","+    )","+    layer = SimpleNamespace(","+        expert_map_manager=SimpleNamespace(placement_strategy=\"linear\"),","+        apply_router_weight_on_input=True,","+    )","+    with pytest.raises(ValueError, match=\"apply_router_weight_on_input\"):","+        FlashInferMoeEpExperts(moe, quant_config).process_weights_after_loading(layer)","+","+","+TINY_BLOCK_FP8 = Geometry(\"tiny\", 256, 128, 4, 2)","+","+","+def _tiny_block_fp8_weights() -> FlashInferMoeEpWeights:","+    hidden, intermediate = TINY_BLOCK_FP8.hidden_size, TINY_BLOCK_FP8.intermediate_size","+    return FlashInferMoeEpWeights(","+        w13=torch.zeros(2, 2 * intermediate, hidden, dtype=torch.float8_e4m3fn),","+        w2=torch.zeros(2, hidden, intermediate, dtype=torch.float8_e4m3fn),","+        w13_scale=torch.ones(2, 2 * intermediate // 128, hidden // 128),","+        w2_scale=torch.ones(2, hidden // 128, intermediate // 128),","+    )","+","+","+def _kernel_storage(mega_config) -> list[int]:","+    (fc1, fc1_scale, *_), (fc2, fc2_scale, *_) = mega_config.transformed_weights","+    return [t.data_ptr() for t in (fc1, fc1_scale, fc2, fc2_scale)]","+","+","+def _fake_mega_layer(","+    monkeypatch: pytest.MonkeyPatch,","+    moe_ep,","+    workspace_capacities: list[int] | None = None,","+    used_workspaces: list[object] | None = None,","+) -> list[tuple]:","     layer_args: list[tuple] = []"," ","     class FakeMegaLayer:","         def __init__(self, *args) -> None:","             layer_args.append(args)","+            self._transformed = args[3].transformed_weights","+","+        def create_workspace(self, max_tokens_per_rank: int) -> object:","+            assert workspace_capacities is not None","+            workspace_capacities.append(max_tokens_per_rank)","+            return (\"workspace\", max_tokens_per_rank)","+","+        def forward(self, tensors, workspace=None, return_workspace_view=False):","+            assert used_workspaces is not None","+            used_workspaces.append(workspace)","+            return torch.zeros_like(tensors.hidden_states)"," ","         def destroy(self) -> None:","             pass","@@ -341,9 +730,11 @@ def destroy(self) -> None:","         lambda: SimpleNamespace(world_size=2, rank_in_group=0, device_group=None),","     )","     monkeypatch.setattr(torch.accelerator, \"current_device_index\", lambda: 0)","+    return layer_args","+"," ","-    geometry = GEOMETRIES[0]","-    moe = SimpleNamespace(","+def _adapter_moe(backend: str, geometry: Geometry) -> SimpleNamespace:","+    return SimpleNamespace(","         moe_backend=backend,","         num_experts=geometry.num_experts,","         experts_per_token=geometry.top_k,","@@ -353,17 +744,3 @@ def destroy(self) -> None:","         swiglu_limit=10.0,","         routing_method=_routing_method(backend),","     )","-    weight = torch.zeros(1, dtype=torch.bfloat16)","-    FlashInferMoeEp(","-        moe,","-        FlashInferMoeEpWeights(w13=weight, w2=weight),","-        apply_topk_in_fc1=apply_topk_in_fc1(moe),","-    )","-","-    ((_, _, _, mega_config),) = layer_args","-    expected = (","-        moe_ep.Nvfp4CutedslMegaMoeConfig","-        if backend == FLASHINFER_MOE_EP_CUTEDSL","-        else moe_ep.DeepGemmMegaMoeConfig","-    )","-    assert isinstance(mega_config.megakernel, expected)"],"additions":407,"deletions":30,"truncated":false},{"path":"tests/models/test_deepseek_v4_fi_moe_ep.py","lines"