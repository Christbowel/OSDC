","+}"],"additions":150,"deletions":0,"truncated":false},{"path":"pnpm11/lockfile/fs/test/envLockfile.test.ts","lines":["@@ -168,6 +168,13 @@ testOnNonWindows('writeEnvLockfile preserves the lockfile mode against the umask"," // A lockfile pnpm wrote for a project with no dependencies, with its empty"," // main document and the separator before it trimmed off."," // https://github.com/pnpm/pnpm/issues/16477","+test('readEnvLockfile returns null when the env document has no content', async () => {","+  const dir = temporaryDirectory()","+  fs.writeFileSync(path.join(dir, WANTED_LOCKFILE), \"---\\n# no env lockfile\\n---\\nlockfileVersion: '9.0'\\n\")","+","+  expect(await readEnvLockfile(dir)).toBeNull()","+})","+"," test('readEnvLockfile reads an env-only lockfile and writeWantedLockfile keeps it', async () => {","   const dir = temporaryDirectory()","   const lockfilePath = path.join(dir, WANTED_LOCKFILE)"],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm11/lockfile/fs/test/lockfileV6Converters.test.ts","lines":["@@ -1,7 +1,7 @@"," import { expect, test } from '@jest/globals'"," import type { LockfileFile } from '@pnpm/lockfile.types'"," import type { DepPath, ProjectId } from '@pnpm/types'","-import yaml from 'js-yaml'","+import { load } from 'js-yaml'"," "," import { convertToLockfileFile, convertToLockfileObject } from '../lib/lockfileFormatConverters.js'"," ","@@ -218,7 +218,7 @@ test('convertToLockfileFile() with lockfile v6', () => {"," })"," "," test('convertToLockfileObject() reads a dependency named constructor', () => {","-  const lockfileFile = yaml.load(`","+  const lockfileFile = load(`"," lockfileVersion: '9.0'"," importers:","   .:","@@ -250,7 +250,7 @@ snapshots:"," })"," "," test('convertToLockfileObject() keeps __proto__ keys of a lockfile as own properties', () => {","-  const lockfileFile = yaml.load(`","+  const lockfileFile = load(`"," lockfileVersion: '9.0'"," importers:","   __proto__:"],"additions":3,"deletions":3,"truncated":fa