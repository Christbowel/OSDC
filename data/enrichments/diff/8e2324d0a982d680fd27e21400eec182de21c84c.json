riteScalar } from './yamlScalar.js'","+","+export interface YamlDumpOptions {","+  /** Nesting level from which collections are written in flow style. */","+  flowLevel?: number","+}","+","+/**","+ * Serializes a JSON-like value to YAML exactly as js-yaml 4's `dump` does with","+ * `{ lineWidth: -1, noCompatMode: true, noRefs: true }`. Lockfile formatting","+ * depends on that output, so it is pinned here instead of following js-yaml.","+ */","+export function dumpYaml (value: unknown, options?: YamlDumpOptions): string {","+  const state: DumpState = { flowLevel: options?.flowLevel ?? -1 }","+  const rendered = writeNode(state, value, { level: 0, block: true, compact: true, isKey: false })","+  return rendered == null ? '' : `${rendered}\\n`","+}","+","+const INDENT = 2","+const EXPLICIT_KEY_THRESHOLD = 1024","+","+interface DumpState {","+  flowLevel: number","+}","+","+interface NodeContext {","+  level: number","+  block: boolean","+  compact: boolean","+  isKey: boolean","+}","+","+function writeNode (state: DumpState, value: unknown, ctx: NodeContext): string | null {","+  if (value === undefined) return null","+  if (Array.isArray(value) || isPlainObject(value)) return writeCollection(state, value, ctx)","+  return writeScalarNode(state, value, ctx)","+}","+","+function writeScalarNode (state: DumpState, value: unknown, ctx: NodeContext): string {","+  if (value === null) return 'null'","+  if (typeof value === 'boolean') return String(value)","+  if (typeof value === 'number') return representNumber(value)","+  if (typeof value !== 'string') {","+    throw new Error(`Cannot serialize a value of type ${Object.prototype.toString.call(value)} to YAML`)","+  }","+  return writeScalar(value, {","+    level: ctx.level,","+    singleLineOnly: ctx.isKey || (state.flowLevel > -1 && ctx.level >= state.flowLevel),","+    inBlock: ctx.block,","+    isAmbiguous: resolvesImplicitly,","+  })","+}","+","+function writeCollection (state: DumpState, value: unknown[] | Record<string, unknown>, ctx: NodeContext): string {","+  const block = ctx.block && (state.flowLevel < 0 || state.flowLevel > ctx.level)","+  if (Array.isArray(value)) {","+    return block && value.length > 0","+      ? writeBlockSequence(state, value, ctx.level, ctx.compact)","+      : writeFlowSequence(state, value, ctx.level)","+  }","+  return block && Object.keys(value).length > 0","+    ? writeBlockMapping(state, value, ctx.level, ctx.compact)","+    : writeFlowMapping(state, value, ctx.level)","+}","+","+function writeBlockSequence (state: DumpState, sequence: unknown[], level: number, compact: boolean): string {","+  let result = ''","+  for (const item of sequence) {","+    const rendered = writeSequenceItem(state, item, { level: level + 1, block: true, compact: true, isKey: false })","+    if (!compact || result !== '') result += nextLine(level)","+    result += rendered.startsWith('\\n') ? '-' : '- '","+    result += rendered","+  }","+  return result || '[]'","+}","+","+function writeFlowSequence (state: DumpState, sequence: unknown[], level: number): string {","+  const items = Array.from(sequence, (item) => writeSequenceItem(state, item, { level, block: false, compact: false, isKey: false }))","+  return `[${items.join(', ')}]`","+}","+","+/** An `undefined` sequence item is written as `null`, as js-yaml does. */","+function writeSequenceItem (state: DumpState, item: unknown, ctx: NodeContext): string {","+  return writeNode(state, item, ctx) ?? writeNode(state, null, ctx)!","+}","+","+function writeBlockMapping (state: DumpState, mapping: Record<string, unknown>, level: number, compact: boolean): string {","+  let result = ''","+  for (const [key, value] of Object.entries(mapping)) {","+    const pair = writeBlockPair(state, [key, value], level)","+    if (pair == null) continue","+    if (!compact || result !== '') result += nextLine(level)","+    result += pair","+  }","+  return result || '{}'","+}","+","+/** A key too long for a simple key is written as an explicit `? key` / `: value` pair. */","+function writeBlockPair (state: DumpState, [key, value]: [string, unknown], level: number): string | null {","+  const renderedKey = writeNode(state, key, { level: level + 1, block: true, compact: true, isKey: true })!","+  const explicitPair = renderedKey.length > EXPLICIT_KEY_THRESHOLD","+  const renderedValue = writeNode(state, value, { level: level + 1, block: true, compact: explicitPair, isKey: false })","+  if (renderedValue == null) return null","+  const keyPart = explicitPair ? `? ${renderedKey}${nextLine(level)}` : renderedKey","+  return `${keyPart}${renderedValue.startsWith('\\n') ? ':' : ': '}${renderedValue}`","+}","+","+function writeFlowMapping (state: DumpState, mapping: Record<string, unknown>, level: number): string {","+  const pairs: string[] = []","+  for (const [key, value] of Object.entries(mapping)) {","+    const ctx: NodeContext = { level, block: false, compact: false, isKey: false }","+    const renderedKey = writeNode(state, key, ctx)!","+    const renderedValue = writeNode(state, value, ctx)","+    if (renderedValue == null) continue","+    const explicitMarker = renderedKey.length > EXPLICIT_KEY_THRESHOLD ? '? ' : ''","+    pairs.push(`${explicitMarker}${renderedKey}: ${renderedValue}`)","+  }","+  return `{${pairs.join(', ')}}`","+}","+","+function nextLine (level: number): string {","+  return `\\n${' '.repeat(INDENT * level)}`","+}","+","+function representNumber (value: number): string {","+  if (Number.isNaN(value)) return '.nan'","+  if (value === Infinity) return '.inf'","+  if (value === -Infinity) return '-.inf'","+  if (Object.is(value, -0)) return '-0.0'","+  const rendered = value.toString(10)","+  // js-yaml adds a dot to an exponent-only float so that it reads back as a float.","+  return Number.isInteger(value) || rendered.includes('.') || !rendered.includes('e') ? rendered : rendered.replace('e', '.e')","+}","+","+function isPlainObject (value: unknown): value is Record<string, unknown> {","+  return Object.prototype.toString.call(value) === '[object Object]'","+}"],"additions":138,"deletions":0,"truncated":false},{"path":"pnpm11/lockfile/fs/src/yamlImplicitTypes.ts","lines":["@@ -0,0 +1,24 @@","+// The patterns below follow js-yaml 4, so that the lockfile quotes the scalars it always has.","+// They also cover what js-yaml 5 reads as a number: a signed leading-dot float (`+.5`), and a","+// number too large to be finite (`1e999`), which js-yaml 4 kept as a string.","+const INTEGER_PATTERN = /^[-+]?(?:0b[01]+|0o[0-7]+|0x[\\dA-Fa-f]+|\\d+)$/","+const FLOAT_PATTERN = /^(?:[-+]?\\d+(?:\\.\\d*)?(?:[eE][-+]?\\d+)?|[-+]?\\.\\d+(?:[eE][-+]?\\d+)?|[-+]?\\.(?:inf|Inf|INF)|\\.(?:nan|NaN|NAN))$/","+const DATE_PATTERN = /^\\d{4}-\\d{2}-\\d{2}$/","+const TIMESTAMP_PATTERN = /^\\d{4}-\\d{1,2}-\\d{1,2}(?:[Tt]|[ \\t]+)\\d{1,2}:\\d{2}:\\d{2}(?:\\.\\d*)?(?:[ \\t]*(?:Z|[-+]\\d{1,2}(?::\\d{2})?))?$/","+","+const NULL_VALUES = new Set(['~', 'null', 'Null', 'NULL'])","+const BOOLEAN_VALUES = new Set(['true', 'True', 'TRUE', 'false', 'False', 'FALSE'])","+","+/**","+ * Whether a plain scalar would be read back as a non-string: null, boolean,","+ * integer, float, timestamp, or merge key.","+ */","+export function resolvesImplicitly (value: string): boolean {","+  return NULL_VALUES.has(value) ||","+    BOOLEAN_VALUES.has(value) ||","+    INTEGER_PATTERN.test(value) ||","+    FLOAT_PATTERN.test(value) ||","+    DATE_PATTERN.test(value) ||","+    TIMESTAMP_PATTERN.test(value) ||","+    value === '<<'","+}"],"additions":24,"deletions":0,"truncated":false},{"path":"pnpm11/lockfile/fs/src/yamlLoad.ts","lines":["@@ -0,0 +1,13 @@","+import { CORE_SCHEMA, load, loadAll, mergeTag } from 'js-yaml'","+","+/** Lockfiles may use YAML merge keys (`<<`), which js-yaml's default schema does not read. */","+const LOCKFILE_SCHEMA = CORE_SCHEMA.withTags(mergeTag)","+","+export function loadLockfileYaml (content: string): unknown {","+  return load(content, { schema: LOCKFILE_S