{"id":"29468ede23869cdafa2cc98cdb81dfafb9ba7cf0","axis":"silent","repo":"rails/rails","sha":"29468ede23869cdafa2cc98cdb81dfafb9ba7cf0","parsed":{"files":[{"path":"activestorage/CHANGELOG.md","lines":["@@ -1,3 +1,25 @@","+*   Restrict the formats ffmpeg and ffprobe will open when previewing and","+    analyzing video and audio.","+","+    Active Storage now passes `-format_whitelist` before the input at every","+    ffmpeg and ffprobe call site, limiting demuxer selection to common audio and","+    video container formats. Configure the list with","+    `config.active_storage.ffmpeg_allowed_formats`, or set it to `nil` to let","+    ffmpeg choose any demuxer it was built with.","+","+    Files in other formats, such as MXF, DV, AC3, WavPack, AU, W64, and raw","+    H.264 or MPEG-1/2 video streams, now fail to preview with","+    `ActiveStorage::PreviewError`, and their analysis stores no media metadata","+    and logs a warning. Add their demuxers to the list to keep them.","+","+    ```ruby","+    config.active_storage.ffmpeg_allowed_formats += %w[ mxf ]","+    ```","+","+    [GHSA-3f4q-8x5m-76v8]","+","+    *Mike Dalessio*","+"," *   Detect axis-swapping orientations in the Vips image analyzer from libvips' normalized","     `orientation` field instead of parsing the `exif-ifd0-Orientation` label."," "],"additions":22,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage.rb","lines":["@@ -391,6 +391,12 @@ module ActiveStorage"," ","   mattr_accessor :ffprobe_arguments, default: \"\""," ","+  mattr_accessor :ffmpeg_allowed_formats, default: %w[ mov matroska avi mpeg mpegts flv asf ogg mp3 wav flac aac aiff caf ].freeze","+","+  def self.ffmpeg_format_whitelist_arguments # :nodoc:","+    [ \"-format_whitelist\", Array(ffmpeg_allowed_formats).join(\",\") ] unless ffmpeg_allowed_formats.nil?","+  end","+","   module Transformers","     extend ActiveSupport::Autoload"," "],"additions":6,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage/analyzer/audio_analyzer.rb","lines":["@@ -66,9 +66,12 @@ def probe_from(file)","             \"-show_format\",","             \"-v\", \"error\",","             *Shellwords.split(ActiveStorage.ffprobe_arguments),","+            *ActiveStorage.ffmpeg_format_whitelist_arguments,","             file.path","           ]) do |output|","             JSON.parse(output.read, allow_duplicate_key: true)","+          end.tap do","+            logger.warn \"Audio analysis failed because ffprobe exited with status #{$?.exitstatus}. The file may be corrupt, or in a format outside config.active_storage.ffmpeg_allowed_formats.\" unless $?.success?","           end","         end","       rescue Errno::ENOENT"],"additions":3,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage/analyzer/video_analyzer.rb","lines":["@@ -146,9 +146,12 @@ def probe_from(file)","             \"-show_format\",","             \"-v\", \"error\",","             *Shellwords.split(ActiveStorage.ffprobe_arguments),","+            *ActiveStorage.ffmpeg_format_whitelist_arguments,","             file.path","           ]) do |output|","             JSON.parse(output.read, allow_duplicate_key: true)","+          end.tap do","+            logger.warn \"Video analysis failed because ffprobe exited with status #{$?.exitstatus}. The file may be corrupt, or in a format outside config.active_storage.ffmpeg_allowed_formats.\" unless $?.success?","           end","         end","       rescue Errno::ENOENT"],"additions":3,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage/engine.rb","lines":["@@ -29,6 +29,7 @@ class Engine < Rails::Engine # :nodoc:","     config.active_storage.paths = ActiveSupport::OrderedOptions.new","     config.active_storage.queues = ActiveSupport::InheritableOptions.new","     config.active_storage.precompile_assets = true","+    config.active_storage.ffmpeg_allowed_formats = ActiveStorage.ffmpeg_allowed_formats"," ","     config.active_storage.variable_content_types = %w(","       image/png","@@ -178,6 +179,7 @@ class Engine < Rails::Engine # :nodoc:","         ActiveStorage.video_preview_arguments = app.config.active_storage.video_preview_arguments || \"-y -vframes 1 -f image2\"","         ActiveStorage.video_preview_input_arguments = app.config.active_storage.video_preview_input_arguments || \"\"","         ActiveStorage.ffprobe_arguments = app.config.active_storage.ffprobe_arguments || \"\"","+        ActiveStorage.ffmpeg_allowed_formats = app.config.active_storage.ffmpeg_allowed_formats","         ActiveStorage.track_variants = app.config.active_storage.track_variants || false","         ActiveStorage.s3_public_uploads_via_acl = app.config.active_storage.s3_public_uploads_via_acl != false","         ActiveStorage.analyze = app.config.active_storage.analyze || :later"],"additions":2,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage/previewer/video_previewer.rb","lines":["@@ -32,6 +32,7 @@ def preview(**options)","       def draw_relevant_frame_from(file, &block)","         draw self.class.ffmpeg_path,","           *Shellwords.split(ActiveStorage.video_preview_input_arguments),","+          *ActiveStorage.ffmpeg_format_whitelist_arguments,","           \"-i\", file.path,","           *Shellwords.split(ActiveStorage.video_preview_arguments),","           \"-\", &block"],"additions":1,"deletions":0,"truncated":false},{"path":"activestorage/test/analyzer/audio_analyzer_test.rb","lines":["@@ -41,6 +41,36 @@ class ActiveStorage::Analyzer::AudioAnalyzerTest < ActiveSupport::TestCase","     assert_equal 128000, metadata[:bit_rate]","   end"," ","+  test \"analyzing a playlist declared as audio\" do","+    blob = create_playlist_blob(referencing: \"audio.mp3\", filename: \"audio.m3u8\", content_type: \"audio/mpeg\")","+    metadata = extract_metadata_from(blob)","+","+    assert_nil metadata[:duration]","+    assert_nil metadata[:bit_rate]","+  end","+","+  test \"analyzing a playlist declared as audio with ffprobe arguments that allow it\" do","+    blob = create_playlist_blob(referencing: \"audio.mp3\", filename: \"audio.m3u8\", content_type: \"audio/mpeg\")","+","+    ActiveStorage.with(ffprobe_arguments: \"-format_whitelist hls,mp3\") do","+      metadata = extract_metadata_from(blob)","+","+      assert_nil metadata[:duration]","+      assert_nil metadata[:bit_rate]","+    end","+  end","+","+  test \"analyzing an audio file whose format is not allowed\" do","+    blob = create_file_blob(filename: \"audio.mp3\", content_type: \"audio/mp3\")","+","+    ActiveStorage.with(ffmpeg_allowed_formats: %w[ wav ], logger: ActiveSupport::Logger.new(log = StringIO.new)) do","+      metadata = extract_metadata_from(blob)","+","+      assert_nil metadata[:duration]","+      assert_match \"Audio analysis failed because ffprobe exited with status 1\", log.string","+    end","+  end","+","   test \"instrumenting analysis\" do","     blob = create_file_blob(filename: \"audio.mp3\", content_type: \"audio/mp3\")"," "],"additions":30,"deletions":0,"truncated":false},{"path":"activestorage/test/analyzer/video_analyzer_test.rb","lines":["@@ -110,6 +110,36 @@ class ActiveStorage::Analyzer::VideoAnalyzerTest < ActiveSupport::TestCase","     assert metadata[:video]","   end"," ","+  test \"analyzing a playlist declared as a video\" do","+    blob = create_playlist_blob(referencing: \"video.mp4\", filename: \"video.m3u8\", content_type: \"video/mp4\")","+    metadata = extract_metadata_from(blob)","+","+    assert_nil metadata[:width]","+    assert_nil metadata[:duration]","+  end","+","+  test \"analyzing a playlist declared as a video with ffprobe arguments that allow it\" do","+    blob = create_playlist_blob(referencing: \"video.mp4\", filename: \"video.m3u8\", content_type: \"video/mp4\")","+","+    ActiveStorage.with(ffprobe_arguments: \"-format_whitelist hls,mov\") do","+      metadata = extract_metadata_from(blob)","+","+      assert_nil metadata[:width]","+      assert_nil metadata[:duration]","+    end","+  end","+","+  test \"analyzing a video whose format is not allowed\" do","+    blob = create_file_blob(filename: \"video.mp4\", content_type: \"video/mp4\")","+","+    ActiveStorage.with(ffmpeg_allowed_formats: %w[ matroska ], logger: ActiveSupport::Logger.new(log = StringIO.new)) do","+      metadata = extract_metadata_from(blob)","+","+      assert_nil metadata[:width]","+      assert_match \"Video analysis failed because ffprobe exited with status 1\", log.string","+    end","+  end","+","   test \"instrumenting analysis\" do","     blob = create_file_blob(filename: \"video.mp4\", content_type: \"video/mp4\")"," "],"additions":30,"deletions":0,"truncated":false},{"path":"activestorage/test/previewer/video_previewer_test.rb","lines":["@@ -26,6 +26,64 @@ class ActiveStorage::Previewer::VideoPreviewerTest < ActiveSupport::TestCase","     end","   end"," ","+  test \"previewing videos in other common formats\" do","+    { \"video.webm\" => \"video/webm\", \"rotated_hdr_video.mov\" => \"video/quicktime\", \"video_with_duplicate_tags.avi\" => \"video/x-msvideo\" }.each do |fixture, content_type|","+      blob = create_file_blob(filename: fixture, content_type: content_type)","+","+      ActiveStorage::Previewer::VideoPreviewer.new(blob).preview do |attachable|","+        assert_equal \"image/jpeg\", Marcel::Magic.by_extension(MiniMagick::Image.read(attachable[:io]).type).type, fixture","+      end","+    end","+  end","+","+  test \"previewing a playlist declared as a video\" do","+    blob = create_playlist_blob(referencing: \"video_with_duplicate_tags.avi\", filename: \"video.m3u8\", content_type: \"video/mp4\")","+","+    assert_raises ActiveStorage::PreviewError do","+      ActiveStorage::Previewer::VideoPreviewer.new(blob).preview","+    end","+  end","+","+  test \"previewing a playlist declared as a video with input arguments that allow it\" do","+    blob = create_playlist_blob(referencing: \"video_with_duplicate_tags.avi\", filename: \"video.m3u8\", content_type: \"video/mp4\")","+","+    ActiveStorage.with(video_preview_input_arguments: \"-format_whitelist hls,avi\") do","+      assert_raises ActiveStorage::PreviewError do","+        ActiveStorage::Previewer::VideoPreviewer.new(blob).preview","+      end","+    end","+  end","+","+  test \"previewing a video whose format is not allowed\" do","+    blob = create_file_blob(filename: \"video.mp4\", content_type: \"video/mp4\")","+","+    ActiveStorage.with(ffmpeg_allowed_formats: %w[ matroska ]) do","+      assert_raises ActiveStorage::PreviewError do","+        ActiveStorage::Previewer::VideoPreviewer.new(blob).preview","+      end","+    end","+  end","+","+  test \"previewing a video whose format is not allowed by a comma-separated list\" do","+    blob = create_file_blob(filename: \"video.mp4\", content_type: \"video/mp4\")","+","+    ActiveStorage.with(ffmpeg_allowed_formats: \"matroska,avi\") do","+      assert_raises ActiveStorage::PreviewError do","+        ActiveStorage::Previewer::VideoPreviewer.new(blob).preview","+      end","+    end","+  end","+","+  test \"previewing a video when no formats are allowed\" do","+    blob = create_file_blob(filename: \"video.mp4\", content_type: \"video/mp4\")","+","+    ActiveStorage.with(ffmpeg_allowed_formats: []) do","+      assert_raises ActiveStorage::PreviewError do","+        ActiveStorage::Previewer::VideoPreviewer.new(blob).preview","+      end","+    end","+  end","+","   test \"previewing a video that the input arguments exclude\" do","     blob = create_file_blob(filename: \"video.mp4\", content_type: \"video/mp4\")"," "],"additions":58,"deletions":0,"truncated":false},{"path":"activestorage/test/test_helper.rb","lines":["@@ -52,6 +52,18 @@ def create_blob_before_direct_upload(key: nil, filename: \"hello.txt\", byte_size:","       ActiveStorage::Blob.create_before_direct_upload! key: key, filename: filename, byte_size: byte_size, checksum: checksum, content_type: content_type, record: record","     end"," ","+    def create_playlist_blob(referencing:, filename:, content_type:)","+      playlist = <<~M3U8","+        #EXTM3U","+        #EXT-X-TARGETDURATION:10","+        #EXTINF:10,","+        file://#{file_fixture(referencing).realpath}","+        #EXT-X-ENDLIST","+      M3U8","+","+      create_blob(data: playlist, filename: filename, content_type: content_type, identify: false)","+    end","+","     def build_blob_after_unfurling(key: nil, data: \"Hello world!\", filename: \"hello.txt\", content_type: \"text/plain\", identify: true, record: nil)","       ActiveStorage::Blob.build_after_unfurling key: key, io: StringIO.new(data), filename: filename, content_type: content_type, identify: identify, record: record","     end"],"additions":12,"deletions":0,"truncated":false},{"path":"guides/source/configuring.md","lines":["@@ -3941,6 +3941,24 @@ The default value is `\"\"`."," See [Media Processing of File Uploads](security.html#media-processing-of-file-uploads)"," in the Security Guide."," ","+#### `config.active_storage.ffmpeg_allowed_formats`","+","+The ffmpeg demuxers that ffmpeg and ffprobe may use to open a file when","+generating video previews and analyzing videos and audio. Active Storage passes","+them as `-format_whitelist` before the input, after any","+`video_preview_input_arguments` or `ffprobe_arguments`, so a file in any other","+format fails to preview and yields no metadata. Names match `ffmpeg -demuxers`, and","+any one name admits a demuxer that registers several, so `mov` also admits","+MP4, M4A and 3GP files.","+","+Set this to `nil` to let ffmpeg choose any demuxer it was built with.","+","+The default value is","+`%w[ mov matroska avi mpeg mpegts flv asf ogg mp3 wav flac aac aiff caf ]`.","+","+See [Media Processing of File Uploads](security.html#media-processing-of-file-uploads)","+in the Security Guide.","+"," #### `config.active_storage.multiple_file_field_include_hidden`"," "," In Rails 7.1 and beyond, Active Storage `has_many_attached` relationships will"],"additions":18,"deletions":0,"truncated":false},{"path":"guides/source/security.md","lines":["@@ -693,7 +693,13 @@ WARNING: _ffmpeg and ffprobe decode untrusted media in memory-unsafe code. Restr"," "," Active Storage shells out to ffmpeg to generate video previews, and to ffprobe to extract video and audio metadata. Neither tool is shipped by Rails, and a stock ffmpeg build registers several hundred decoders and demuxers where an application needs a handful. Attachments are analyzed on upload by default, so ffprobe reads attacker-supplied bytes without any further interaction."," ","-Narrow that attack surface by naming the codecs these tools may decode. An application that accepts only H.264 video with AAC audio would configure:","+By default, Active Storage limits the demuxers both tools may use to common audio and video container formats. Narrow the list further with `config.active_storage.ffmpeg_allowed_formats`:","+","+```ruby","+config.active_storage.ffmpeg_allowed_formats = %w[ mov ]","+```","+","+Narrow the attack surface further by naming the codecs these tools may decode. An application that accepts only H.264 video with AAC audio would configure:"," "," ```ruby"," config.active_storage.video_preview_input_arguments = \"-codec_whitelist h264,aac\""],"additions":7,"deletions":1,"truncated":false},{"path":"railties/test/application/configuration_test.rb","lines":["@@ -4583,6 +4583,37 @@ class Post < ActiveRecord::Base","       assert_equal \"-codec_whitelist h264\", ActiveStorage.ffprobe_arguments","     end"," ","+    test \"ActiveStorage.ffmpeg_allowed_formats restricts ffmpeg to common media formats by default\" do","+      app \"development\"","+","+      assert_equal %w[ mov matroska avi mpeg mpegts flv asf ogg mp3 wav flac aac aiff caf ], ActiveStorage.ffmpeg_allowed_formats","+    end","+","+    test \"ActiveStorage.ffmpeg_allowed_formats can be configured\" do","+      add_to_config \"config.active_storage.ffmpeg_allowed_formats = %w[ mov ]\"","+","+      app \"development\"","+","+      assert_equal %w[ mov ], ActiveStorage.ffmpeg_allowed_formats","+    end","+","+    test \"ActiveStorage.ffmpeg_allowed_formats can be extended\" do","+      add_to_config \"config.active_storage.ffmpeg_allowed_formats += %w[ mxf ]\"","+","+      app \"development\"","+","+      assert_includes ActiveStorage.ffmpeg_allowed_formats, \"mov\"","+      assert_includes ActiveStorage.ffmpeg_allowed_formats, \"mxf\"","+    end","+","+    test \"ActiveStorage.ffmpeg_allowed_formats can be disabled\" do","+      add_to_config \"config.active_storage.ffmpeg_allowed_formats = nil\"","+","+      app \"development\"","+","+      assert_nil ActiveStorage.ffmpeg_allowed_formats","+    end","+","     test \"ActiveStorage.variant_processor uses mini_magick without Rails 7 defaults\" do","       remove_from_config '.*config\\.load_defaults.*\\n'"," ",""],"additions":31,"deletions":0,"truncated":false}],"additions":223,"deletions":1,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-04T16:06:40.936980+00:00"}