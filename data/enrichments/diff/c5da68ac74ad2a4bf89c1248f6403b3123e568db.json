ing a turn.","     - `requires_action` - The session is waiting for one or more required actions.","     - `failed` - The session failed.","+    - `budget_reached` - The session is paused because its spending limit was","+      reached.","     \"\"\""," ","     usage: Optional[TokenUsage] = None","@@ -341,7 +343,8 @@ class AgentSession(BaseModel):","     \"\"\""," ","     spend_control: Optional[SpendControl] = None","-    \"\"\"Configured spending limit and best-effort consumption, in USD cents.","+    \"\"\"Spending limit and best-effort consumption, in USD cents."," ","-    Unlimited sessions omit this object.","+    Present when spending-control visibility is enabled; limit is null without a","+    cap. Older server responses may omit this object.","     \"\"\""],"additions":10,"deletions":7,"truncated":false},{"path":"src/openai/types/beta/agent_session_budget_reached_event.py","lines":["@@ -0,0 +1,25 @@","+# File generated from our OpenAPI spec by Castiron. See CONTRIBUTING.md for details.","+","+from typing import Optional","+from typing_extensions import Literal","+","+from ..._models import BaseModel","+from .agent_session import AgentSession","+","+__all__ = [\"AgentSessionBudgetReachedEvent\"]","+","+","+class AgentSessionBudgetReachedEvent(BaseModel):","+    \"\"\"Emitted when a session pauses because its spending limit was reached.\"\"\"","+","+    event_id: str","+    \"\"\"The unique ID of the event.\"\"\"","+","+    session: AgentSession","+    \"\"\"The paused session.\"\"\"","+","+    type: Literal[\"agent.session.budget_reached\"]","+    \"\"\"The type of the object. Always `agent.session.budget_reached`.\"\"\"","+","+    obfuscation: Optional[str] = None","+    \"\"\"Random alphanumeric padding. Present when stream obfuscation is enabled.\"\"\""],"additions":25,"deletions":0,"truncated":false},{"path":"src/openai/types/beta/agent_session_event.py","lines":["@@ -11,6 +11,7 @@"," from .agent_session_in_progress_event import AgentSessionInProgressEvent"," from .agent_session_turn_failed_event import AgentSessionTurnFailedEvent"," from .agent_session_turn_created_event import AgentSessionTurnCreatedEvent","+from .agent_session_budget_reached_event import AgentSessionBudgetReachedEvent"," from .agent_session_turn_cancelled_event import AgentSessionTurnCancelledEvent"," from .agent_session_turn_completed_event import AgentSessionTurnCompletedEvent"," from .agent_session_turn_item_done_event import AgentSessionTurnItemDoneEvent","@@ -56,6 +57,7 @@","         AgentSessionTurnCancelledEvent,","         AgentSessionTurnItemAddedEvent,","         AgentSessionIdleEvent,","+        AgentSessionBudgetReachedEvent,","         AgentSessionInProgressEvent,","         AgentSessionRequiresActionEvent,","         AgentSessionFailedEvent,"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/test_agents_budget_events.py","lines":["@@ -0,0 +1,177 @@","+from __future__ import annotations","+","+from typing import Iterator","+from typing_extensions import override","+","+import pytest","+","+from openai import OpenAI, AsyncOpenAI","+from openai.types.beta import AgentSessionErrorEvent, AgentSessionBudgetReachedEvent","+from openai.lib.beta.agents import AgentTurnResultError","+from tests.lib.streaming.agents.test_results import ResultServer, collect, message, creation as creation","+from tests.lib.streaming.agents.test_streams import EventBody, sdk as sdk, session, turn_event","+","+","+@pytest.fixture","+def server() -> ResultServer:","+    return ResultServer()","+","+","+def budget(session_id: str = \"session_test\") -> dict[str, object]:","+    resource = session(\"budget_reached\")","+    resource[\"id\"] = session_id","+    return {\"type\": \"agent.session.budget_reached\", \"session\": resource}","+","+","+class NamedEventBody(EventBody):","+    @override","+    def __iter__(self) -> Iterator[bytes]:","+        for chunk, event in zip(super().__iter__(), self.events, strict=True):","+            yield f\"event: {event['type']}\\n\".encode() + chunk","+","+","+@pytest.mark.parametrize(\"creation\", [False, True])","+@pytest.mark.parametrize(\"named\", [False, True])","+@pytest.mark.parametrize(\"preceding_error\", [False, True])","+@pytest.mark.parametrize(\"limit\", [None, 731])","+async def test_typed_budget_on_agents_entrypoints(","+    sdk: OpenAI | AsyncOpenAI,","+    server: ResultServer,","+    creation: bool,","+    named: bool,","+    preceding_error: bool,","+    limit: int | None,","+) -> None:","+    error_payload = {","+        \"type\": \"budget_exceeded\",","+        \"code\": \"session_budget_reached\",","+        \"message\": \"Synthetic session spending limit reached\",","+        \"param\": \"spend_control\",","+    }","+    events: list[dict[str, object]] = []","+    if preceding_error:","+        events.append({\"type\": \"error\", \"session_id\": \"session_test\", \"error\": error_payload})","+    resource = session(\"budget_reached\")","+    resource[\"spend_control\"] = {\"limit\": limit, \"consumed\": 419}","+    events.append({\"type\": \"agent.session.budget_reached\", \"session\": resource})","+    server.body = (NamedEventBody if named else EventBody)(events)","+    if isinstance(sdk, AsyncOpenAI):","+        stream = (","+            await sdk.beta.agents.sessions.create(","+                agent={\"model\": \"test-model\"}, environment={\"type\": \"none\"}, input=\"Question\", stream=True","+            )","+            if creation","+            else await sdk.beta.agents.sessions.events.stream(\"session_test\")","+        )","+        async with stream:","+            received = [event async for event in stream]","+    else:","+        stream = (","+            sdk.beta.agents.sessions.create(","+                agent={\"model\": \"test-model\"}, environment={\"type\": \"none\"}, input=\"Question\", stream=True","+            )","+            if creation","+            else sdk.beta.agents.sessions.events.stream(\"session_test\")","+        )","+        with stream:","+            received = list(stream)","+    assert [event.type for event in received] == ([\"error\"] if preceding_error else []) + [","+        \"agent.session.budget_reached\"","+    ]","+    assert [event.event_id for event in received] == [str(index) for index in range(len(events))]","+    if preceding_error:","+        error = received[0]","+        assert isinstance(error, AgentSessionErrorEvent)","+        assert error.session_id == \"session_test\"","+        assert error.error.model_dump() == error_payload","+    assert isinstance(received[-1], AgentSessionBudgetReachedEvent)","+    assert received[-1].session.id == \"session_test\"","+    assert received[-1].session.status == \"budget_reached\"","+    spend_control = received[-1].session.spend_control","+    assert spend_control is not None","+    assert spend_control.limit == limit","+    assert \"limit\" in spend_control.model_fields_set","+    assert spend_control.consumed == 419","+    assert server.body.read_count == len(events)","+    assert server.body.closed","+","+","+@pytest.mark.parametrize(\"status\", [\"completed\", \"failed\", \"cancelled\"])","+async def test_budget_boundary_preserves_turn_outcome(","+    sdk: OpenAI | AsyncOpenAI, server: ResultServer, creation: bool, status: str","+) -> None:","+    events: list[dict[str, object]] = [turn_event(\"created\"), message(), turn_event(status), budget()]","+    if status == \"completed\":","+        events.append({\"type\": \"agent.session.failed\", \"session\": session(\"failed\")})","+    server.body = EventBody(events)","+    if status == \"completed\":","+        result = await collect(sdk, creation)","+        assert result.output_text == \"answer\"","+        assert result.turn.status == \"completed\"","+    else:","+        with pytest.raises(AgentTurnResultError) as exc:","+            await collect(sdk, creation, mode=\"iterate\")","+        assert exc.value.reason == status","+    assert server.body.read_count == 4","+    assert server.body.closed","+","+","+async def test_budget_for_other_session_does_not_end_result_collection(","+    sdk: OpenAI | AsyncOpenAI, server: ResultServer, creation: bool","+) -> None:","+    server.body = EventBody(","+        [","+            turn_event(\"created\"),","+            message(),","+            turn_event(\"completed\"),","+            budget(\"session_other\"),","+            budget(),","+            {\"type\": \"agent.session.failed\", \"session\": session(\"failed\")},","+        ]","+    )","+    result = await collect(sdk, creation)","+    assert result.output_text == \"answer\"","+    assert result.session_id == \"session_test\"","+    assert server.body.read_count == 5","+    assert server.body.closed","+","+","+async def test_budget_snapshot_before_turn_outcome_keeps_collecting(","+    sdk: OpenAI | AsyncOpenAI, server: ResultServer, creation: bool","+) -> None:","+    server.body = EventBody([turn_event(\"created\"), budget(), message(), turn_event(\"completed\"), budget()])","+    result = await collect(sdk, creation)","+    assert result.output_text == \"answer\"","+    assert result.turn.status == \"completed\"","+    assert server.body.read_count == 5","+    assert server.body.closed","+","+","+@pytest.mark.parametrize(\"session_created\", [False, True])","+async def test_budget_before_root_turn_stops_result_collection(","+    sdk: OpenAI | AsyncOpenAI, server: ResultServer, creation: bool, session_created: bool","+) -> None:","+    events: list[dict[str, object]] = []","+    if session_created:","+        events.append({\"type\": \"agent.session.created\", \"session\": session()})","+    if session_created or not creation:","+        events.append(budget(\"session_other\"))","+    events.extend(","+        [","+            {","+                \"type\": \"error\",","+                \"session_id\": \"session_test\",","+                \"error\": {\"type\": \"budget_exceeded\", \"message\": \"Budget exceeded\"},","+            },","+            budget(),","+            {\"type\": \"agent.session.failed\", \"session\": session(\"failed\")},","+        ]","+    )","+    server.body = EventBody(events)","+    with pytest.raises(AgentTurnResultError) as exc:","+        await collect(sdk, creation)","+    assert exc.value.reason == \"incomplete\"","+    assert exc.value.session_id == \"session_test\"","+    assert exc.value.turn is None","+    assert server.body.read_count == len(events) - 1","+    assert server.body.closed",""],"additions":177,"deletions":0,"truncated":false}],"additions":301,"deletions":40,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-18T16:50:47.340450+00:00"}