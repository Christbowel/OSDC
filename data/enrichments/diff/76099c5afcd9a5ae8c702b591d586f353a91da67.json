= ExpressionType::COMPARE_EQUAL &&","+\t\t\t    HasComputedJoinOperands(condition.GetLHS(), condition.GetRHS())) {","+\t\t\t\treturn true;","+\t\t\t}","+\t\t}","+\t\treturn false;","+\t}","+\tif (op.type != LogicalOperatorType::LOGICAL_FILTER ||","+\t    op.children[0]->type != LogicalOperatorType::LOGICAL_CROSS_PRODUCT) {","+\t\treturn false;","+\t}","+\tauto &cross = *op.children[0];","+\tunordered_set<TableIndex> left_bindings, right_bindings;","+\tfor (auto &expression : op.expressions) {","+\t\tif (expression->GetExpressionType() != ExpressionType::COMPARE_EQUAL) {","+\t\t\tcontinue;","+\t\t}","+\t\tauto &comparison = expression->Cast<BoundFunctionExpression>();","+\t\tauto &lhs = BoundComparisonExpression::Left(comparison);","+\t\tauto &rhs = BoundComparisonExpression::Right(comparison);","+\t\tif (!HasComputedJoinOperands(lhs, rhs)) {","+\t\t\tcontinue;","+\t\t}","+\t\tif (left_bindings.empty() && right_bindings.empty()) {","+\t\t\tLogicalJoin::GetTableReferences(*cross.children[0], left_bindings);","+\t\t\tLogicalJoin::GetTableReferences(*cross.children[1], right_bindings);","+\t\t}","+\t\tauto lhs_side = JoinSide::GetCurrentJoinSide(lhs, left_bindings, right_bindings);","+\t\tauto rhs_side = JoinSide::GetCurrentJoinSide(rhs, left_bindings, right_bindings);","+\t\tif ((lhs_side == JoinSide::LEFT && rhs_side == JoinSide::RIGHT) ||","+\t\t    (lhs_side == JoinSide::RIGHT && rhs_side == JoinSide::LEFT)) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+"," unique_ptr<LogicalOperator> FilterPullup::Rewrite(unique_ptr<LogicalOperator> op) {","+\tif (can_add_column && op->HasProjectionMap()) {","+\t\treturn FinishPullup(std::move(op));","+\t}","+\tif (!can_pullup && !can_add_column && !op->HasProjectionMap() && NeedsEarlyJoinKeys(*op)) {","+\t\t// Carry hidden keys within this join region and keep its output bindings unchanged.","+\t\tauto output = op->GetColumnBindings();","+\t\tFilterPullup join_pullup(context, false, true);","+\t\tauto rewritten = join_pullup.Rewrite(std::move(op));","+\t\tColumnBindingLayout layout(rewritten->GetColumnBindings());","+\t\tif (layout.HasSameLayout(output)) {","+\t\t\treturn rewritten;","+\t\t}","+\t\treturn LogicalJoin::PromoteJoinSide(std::move(rewritten), layout.CreateProjectionMap(output));","+\t}"," \tswitch (op->type) {"," \tcase LogicalOperatorType::LOGICAL_FILTER:"," \t\treturn PullupFilter(std::move(op));","@@ -44,6 +110,9 @@ unique_ptr<LogicalOperator> FilterPullup::PullupJoin(unique_ptr<LogicalOperator>"," \t         op->type == LogicalOperatorType::LOGICAL_ASOF_JOIN || op->type == LogicalOperatorType::LOGICAL_ANY_JOIN ||"," \t         op->type == LogicalOperatorType::LOGICAL_DELIM_JOIN);"," \tauto &join = op->Cast<LogicalJoin>();","+\tif (can_add_column && (join.join_type != JoinType::INNER || op->type == LogicalOperatorType::LOGICAL_ASOF_JOIN)) {","+\t\treturn FinishPullup(std::move(op));","+\t}"," "," \tswitch (join.join_type) {"," \tcase JoinType::INNER:"],"additions":69,"deletions":0,"truncated":false},{"path":"src/optimizer/pullup/pullup_projection.cpp","lines":["@@ -65,12 +65,19 @@ void FilterPullup::ProjectSetOperation(LogicalProjection &proj) {"," "," unique_ptr<LogicalOperator> FilterPullup::PullupProjection(unique_ptr<LogicalOperator> op) {"," \tD_ASSERT(op->type == LogicalOperatorType::LOGICAL_PROJECTION);","+\tauto &proj = op->Cast<LogicalProjection>();","+\t// Pulling filters above a projection can evaluate its expressions on additional rows.","+\tfor (auto &expr : proj.expressions) {","+\t\tif (expr->CanThrow() || expr->IsVolatile()) {","+\t\t\treturn FinishPullup(std::move(op));","+\t\t}","+\t}","+"," \top->children[0] = Rewrite(std::move(op->children[0]));"," \tif (!filters_expr_pullup.empty()) {","-\t\tauto &proj = op->Cast<LogicalProjection>();"," \t\tfor (auto &expr : filters_expr_pullup) {","-\t\t\tif (expr->CanThrow()) {","-\t\t\t\t// Keep fallible predicates and their guards below the projection.","+\t\t\tif (expr->CanThrow() || expr->IsVolatile()) {","+\t\t\t\t// Keep fallible or volatile predicates and their guards below the projection."," \t\t\t\tRevertFilterPullup(proj, filters_expr_pullup);"," \t\t\t\treturn op;"," \t\t\t}"],"additions":10,"deletions":3,"truncated":false},{"path":"src/optimizer/pushdown/pushdown_filter.cpp","lines":["@@ -10,7 +10,20 @@ unique_ptr<LogicalOperator> FilterPushdown::PushdownFilter(unique_ptr<LogicalOpe"," \tD_ASSERT(op->type == LogicalOperatorType::LOGICAL_FILTER);"," \tauto &filter = op->Cast<LogicalFilter>();"," \tif (filter.HasProjectionMap()) {","-\t\treturn FinishPushdown(std::move(op));","+\t\tif (!filter.expressions.empty()) {","+\t\t\treturn FinishPushdown(std::move(op));","+\t\t}","+\t\tvector<unique_ptr<Expression>> remain_expressions;","+\t\tfor (idx_t i = 0; i < filters.size(); i++) {","+\t\t\tif (!filters[i]->filter->CanThrow() && !filters[i]->filter->IsVolatile()) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tremain_expressions.push_back(std::move(filters[i]->filter));","+\t\t\tfilters.erase_at(i--);","+\t\t}","+\t\t// Preserve the output layout and the evaluation boundary of unsafe predicates.","+\t\tRewriteChild(*op, 0);","+\t\treturn AddLogicalFilter(std::move(op), std::move(remain_expressions));"," \t}"," \t// filter: gather the filters and remove the filter from the set of operations"," \tfor (auto &expression : filter.expressions) {"],"additions":14,"deletions":1,"truncated":false},{"path":"test/configs/verify_statement_explain_sql.json","lines":["@@ -13,7 +13,8 @@","     {","       \"reason\": \"The generated SQL is planned differently, which changes how often the volatile expressions the fixture counts are evaluated\",","       \"paths\": [","-        \"test/optimizer/join_to_semi_join_volatile.test\"","+        \"test/optimizer/join_to_semi_join_volatile.test\",","+        \"test/optimizer/pushdown/filter_projection_map.test\"","       ]","     },","     {"],"additions":2,"deletions":1,"truncated":false},{"path":"test/optimizer/filter_pullup_projection_safety.test","lines":["@@ -0,0 +1,66 @@","+# name: test/optimizer/filter_pullup_projection_safety.test","+# description: Keep fallible and volatile expressions at their original evaluation boundary during filter pullup","+# group: [optimizer]","+","+statement ok","+SET threads = 1;","+","+# Exercise filter pullup without a later pass that can restore the filter's location.","+statement ok","+SET disabled_optimizers = 'filter_pushdown';","+","+statement ok","+CREATE TABLE items(grp INTEGER, value VARCHAR);","+","+statement ok","+INSERT INTO items VALUES (1, '42'), (2, 'bad'), (NULL, 'also_bad');","+","+statement ok","+CREATE TABLE chosen AS SELECT 1 AS grp;","+","+statement ok","+CREATE TABLE singleton AS SELECT 43 AS cast_key, 2 AS sequence_key;","+","+query I","+SELECT p.value","+FROM (SELECT items.value::INTEGER AS value FROM items JOIN chosen USING (grp)) p","+JOIN singleton s ON p.value + 1 = s.cast_key;","+----","+42","+","+statement ok","+CREATE SEQUENCE probe_seq;","+","+query I","+SELECT p.seq","+FROM (SELECT nextval('probe_seq') AS seq FROM items JOIN chosen USING (grp)) p","+JOIN singleton s ON p.seq + 1 = s.sequence_key;","+----","+1","+","+query I","+SELECT currval('probe_seq');","+----","+1","+","+statement ok","+CREATE TABLE inputs AS SELECT i, 0.5::DOUBLE AS threshold, 1 AS k FROM range(4) t(i);","+","+statement ok","+CREATE TABLE copies AS SELECT i, 2 AS k FROM range(10) t(i);","+","+statement ok","+SELECT setseed(0.42);","+","+# A source row either survives the volatile filter once and yields all ten copies, or is excluded.","+query I","+SELECT count(*)","+FROM (","+    SELECT p.i","+    FROM (SELECT i, k FROM inputs WHERE random() < threshold) p","+    JOIN copies c ON p.k + 1 = c.k","+    GROUP BY p.i","+    HAVING count(*) <> 10","+);","+----","+0"],"additions":66,"deletions":0,"truncated":false},{"path":"test/optimizer/joins/implied_key_on_expression_join.test","lines":["@@ -0,0 +1,129 @@","+# name: test/optimizer/joins/implied_key_on_expression_join.test","+# description: Pulling up hidden join keys exposes transitive group equalities for rank joins","+# group: [joins]","+","+foreach group_type BIGINT VARCHAR","+","+statement ok","+CREATE OR REPLACE TABLE sales AS","+SELECT g::{group_type} AS grp, p // 12 AS year, p % 12 AS moy, (g * 7 + p * 3 + i) % 50 AS price","+FROM range(4) a(g), range(14) b(p), range(8) c(i);","+","+statement ok","+CREATE OR REPLACE VIEW monthly_total AS SELECT grp, year, moy, sum(price) AS total FROM sales GROUP BY ALL;","+","+statement ok","+CREATE OR REPLACE VIEW monthly_max AS SELECT grp, year, moy, max(price) AS max_price FROM sales GROUP BY ALL;","+","+statement ok","+CREATE OR REPLACE VIEW enriched AS","+SELECT grp, year, moy, total, max_price","+FROM sales JOIN monthly_total USING (grp, year, moy) JOIN monthly_max USING (grp, year, moy);","+","+statement ok","+CREATE OR REPLACE VIEW ranked AS","+SELECT grp, year, moy, rn","+FROM enriched JOIN (","+  SELECT *, row_number() OVER (PARTITION BY grp ORDER BY year, moy) AS rn","+  FROM (SELECT DISTINCT * FROM enriched)","+) USING (grp, year, moy, total, max_price);","+","+statement ok","+CREATE OR REPLACE VIEW ranked_neighbors AS","+SELECT count(*), sum(cur.grp::BIGINT * 100 + cur.rn), sum(lag.year * 100 + lag.moy)","+FROM ranked cur, ranked lag, ranked lead","+WHERE cur.rn = lag.rn + 1 AND cur.rn = lead.rn - 1 AND cur.grp = lag.grp AND cur.grp = lead.grp;","+","+query III","+FROM ranked_neighbors;","+----","+24576\t3870720\t135168","+","+# Both rank joins include the group key with the default optimizer pipeline.","+query II","+EXPLAIN (FORMAT JSON) FROM ranked_neighbors;","+----","+physical_plan\t<REGEX>:(.*\"Conditions\":\\s*\\[[^\\]]*(\\brn\\b[^\\]]*grp = grp|grp = grp[^\\]]*\\brn\\b)[^\\]]*\\]){2}.*","+","+statement ok","+CREATE OR REPLACE VIEW ranked_neighbors AS","+SELECT count(*), sum(cur.grp::BIGINT * 100 + cur.rn), sum(lag.year * 100 + lag.moy)","+FROM ranked cur","+JOIN ranked lag ON cur.rn = lag.rn + 1 AND cur.grp = lag.grp","+JOIN ranked lead ON cur.rn = lead.rn - 1 AND cur.grp = lead.grp;","+","+query III","+FROM ranked_neighbors;","+----","+24576\t3870720\t135168","+","+query II","+EXPLAIN (FORMAT JSON) FROM ranked_neighbors;","+----","+physical_plan\t<REGEX>:(.*\"Conditions\":\\s*\\[[^\\]]*(\\brn\\b[^\\]]*grp = grp|grp = grp[^\\]]*\\brn\\b)[^\\]]*\\]){2}.*","+","+# Group predicates above the joins must pass through the restored output projection.","+statement ok","+CREATE OR REPLACE VIEW ranked_neighbors AS","+SELECT count(*), sum(cur.grp::BIGINT * 100 + cur.rn), sum(lag.year * 100 + lag.moy)","+FROM ranked cur","+JOIN ranked lag ON cur.rn = lag.rn + 1","+JOIN ranked lead ON cur.rn = lead.rn - 1","+WHERE cur.grp = lag.grp AND cur.grp = lead.grp;","+","+query III","+FROM ranked_neighbors;","+----","+24576\t3870720\t135168","+","+query II","+EXPLAIN (FORMAT JSON) FROM ranked_neighbors;","+----","+physical_plan\t<REGEX>:(.*\"Conditions\":\\s*\\[[^\\]]*(\\brn\\b[^\\]]*grp = grp|grp = grp[^\\]]*\\brn\\b)[^\\]]*\\]){2}.*","+","+endloop","+","+statement ok","+CREATE TABLE lhs(g INTEGER, r INTEGER);","+","+statement ok","+INSERT INTO lhs VALUES (1, 2), (2, 2), (NULL, 2);","+","+statement ok","+CREATE TABLE rhs AS SELECT g, r - 1 AS r FROM lhs;","+","+statement ok","+CREATE TABLE bridge(g INTEGER);","+","+statement ok","+INSERT INTO bridge VALUES (1), (2), (2), (NULL);","+","+query I","+SELECT count(*) FROM lhs a JOIN rhs b ON a.r = b.r + 1 JOIN bridge c ON a.g = c.g AND b.g = c.g;","+----","+3","+","+query I","+SELECT count(*) FROM lhs a JOIN rhs b ON a.r = b.r + 1 JOIN bridge c ON a.g = c.g;","+----","+9","+","+query I","+SELECT count(*) FROM lhs a JOIN rhs b ON a.r = b.r + 1","+JOIN bridge c ON a.g IS NOT DISTINCT FROM c.g AND b.g IS NOT DISTINCT FROM c.g;","+----","+4","+","+query I","+SELECT count(*) FROM lhs a JOIN rhs b ON a.r = b.r + 1 LEFT JOIN bridge c ON a.g = c.g AND b.g = c.g;","+----","+10","+","+# Distinct BIGINTs can compare equal after a lossy cast.","+query I","+SELECT count(*)","+FROM (VALUES (9007199254740992::BIGINT, 2)) a(g, r)","+JOIN (VALUES (9007199254740993::BIGINT, 1)) b(g, r) ON a.r = b.r + 1","+JOIN (VALUES (9007199254740992::DOUBLE)) c(g) ON a.g::DOUBLE = c.g AND b.g::DOUBLE = c.g;","+----","+1"],"additions":129,"deletions":0,"truncated":false},{"path":"test/optimizer/pushdown/filter_projection_map.test","lines":["@@ -0,0 +1,102 @@","+# name: test/optimizer/pushdown/filter_projection_map.test","+# description: Push predicates through filters that restore the output layout after hidden-column pullup","+# group: [pushdown]","+","+statement ok","+CREATE TABLE a AS SELECT i::INTEGER AS k, i::INTEGER AS v FROM range(1000) t(i);","+","+statement ok","+CREATE TABLE b AS SELECT i::INTEGER AS k FROM range(1000) t(i);","+","+statement ok","+CREATE TABLE c AS SELECT i::INTEGER AS v FROM range(1000) t(i);","+","+statement ok","+CREATE VIEW selective_join AS","+SELECT p.v, c.v AS other","+FROM (SELECT a.v FROM a JOIN b ON a.k = b.k) p","+JOIN c ON p.v = c.v + 1","+WHERE p.v = 42;","+","+query II","+FROM selective_join;","+----","+42\t41","+","+# The selective predicate reaches the table scan despite the hidden join column.","+query II","+EXPLAIN (FORMAT JSON) FROM selective_join;","+----","+physical_plan\t<REGEX>:.*\"Table\": \"[^\"]*\\.a\"[^}]*\"Filters\": \"\\(v = 42\\)\".*","+","+# Preserve projected values, duplicate columns, NULLs, and row multiplicity.","+statement ok","+INSERT INTO a VALUES (42, 42), (42, NULL);","+","+query IIII rowsort","+SELECT p.v, p.k, p.v, c.v","+FROM (SELECT a.v, a.k FROM a JOIN b ON a.k = b.k) p","+JOIN c ON p.k = c.v + 1","+WHERE p.k = 42;","+----","+42\t42\t42\t41","+42\t42\t42\t41","+NULL\t42\tNULL\t41","+","+query II","+SELECT p.v, c.v","+FROM (SELECT a.v FROM a JOIN b ON a.k = b.k) p","+JOIN c ON p.v = c.v + 1","+WHERE p.v = 42 AND c.v = 42;","+----","+","+statement ok","+CREATE TABLE copies(k INTEGER);","+","+statement ok","+INSERT INTO copies VALUES (1), (1);","+","+statement ok","+CREATE TABLE targets(v INTEGER);","+","+statement ok","+INSERT INTO targets VALUES (0), (0);","+","+statement ok","+CREATE SEQUENCE probe_seq;","+","+# Evaluate the volatile predicate after both joins have duplicated the source row.","+query I","+SELECT count(*)","+FROM (SELECT a.v FROM a JOIN copies ON a.k = copies.k) p","+JOIN targets ON p.v = targets.v + 1","+WHERE nextval('probe_seq') <= p.v;","+----","+1","+","+query I","+SELECT currval('probe_seq');","+----","+4","+","+statement ok","+CREATE TABLE fallible(k INTEGER, value VARCHAR);","+","+statement ok","+INSERT INTO fallible VALUES (1, '42'), (2, 'bad');","+","+statement ok","+INSERT INTO targets VALUES (10);","+","+# Isolate filter pushdown from later join reordering and dynamic join filters.","+statement ok","+SET disabled_optimizers = 'join_filter_pushdown,join_order';","+","+query T rowsort","+SELECT p.value","+FROM (SELECT fallible.k, fallible.value FROM fallible JOIN b ON fallible.k = b.k) p","+JOIN targets ON p.k = targets.v + 1","+WHERE p.value::INTEGER = 42;","+----","+42","+42",""],"additions":102,"deletions":0,"truncated":false}],"additions":393,"deletions":6,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-26T18:56:51.587627+00:00"}